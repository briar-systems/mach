# the persistent object cache. every module the build emits is keyed once per
# load, after the load walk and before anything is resolved: its key covers
# the build configuration and compiler identity, the module's own source and
# embedded files, and the surface of every module it imports, transitively.
# an import's surface is its source without the bodies no importer compiles
# (see driver/surface), so an edit inside such a body keys only its own
# module. a release build inlines bodies across modules, so there an import's
# whole source is its surface. a module whose `obj/` object carries its key
# is reused: it is not lowered or compiled, and when its record stands for its
# whole source and nothing the build still compiles imports it, its front end
# is skipped: its record stands in for the instances its code asks for and for
# its front end's warnings. an instance unit is keyed by its members and the
# surfaces of the modules they read, and its object is kept in `obj/` beside
# its origin's under that key. each instance's typing is recorded in the cell's
# instance records (driver/cache/instances), keyed by the configuration, its
# symbol and the surfaces of the modules it reads, so an instance whose record
# stands is not typed. a skipped module, or an instance only records name, is
# typed only when something that must be rebuilt from its typed form needs it.
# nothing about a file but its bytes decides anything: every source text load
# read is hashed each build, and the digest memo in the cell's `.cache`
# directory (driver/cache/memo) keeps only what a text's digest names. an
# object is reused only when its bytes hash to what the build that wrote it
# recorded (driver/cache/objects)
use cache_key: mach.lang.driver.cache.key;
use mach.lang.diagnostic;
use mach.lang.driver.frontend;
use mach.lang.driver.project;
use mach.lang.driver.request;
use mach.lang.fail;
use mach.lang.fe.ast;
use mach.lang.intern;
use session_embed: mach.lang.session.embed;
use lang_source:   mach.lang.source;
use A:             std.allocator;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.OwnedString;
use std.types.string.owned_release;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use mach.lang.driver.backend;
use mach.lang.driver.cache.compiler;
use cache_instances: mach.lang.driver.cache.instances;
use cache_link:      mach.lang.driver.cache.link;
use mach.lang.driver.cache.memo;
use cache_objects: mach.lang.driver.cache.objects;
use cache_record:  mach.lang.driver.cache.record;
use mach.lang.driver.declared;
use mach.lang.driver.demand;
use mach.lang.driver.surface;
use sema_instance: mach.lang.fe.sema.instance;
use sema_product:  mach.lang.fe.sema.product;
use lower_context: mach.lang.me.lower.context;
use mach.lang.me.lower.testrunner;
use mach.lang.module;
use mach.lang.output;
use mach.lang.query;
use mach.lang.readout;

use crypto.hash.sha256;
use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.host;
use manifest_link: mach.lang.manifest.link;
use mach.lang.wire;
use mink.model.object.Object;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use fs: std.filesystem;
use std.memory;
use std.text.string.str_free;
use std.types.bool.true;
use types_path: std.types.path;

# a path as the filesystem would name it from this process: absolute and
# lexically clean, so `mach build .` and `mach build /abs/project` agree
fun canonical(scratch: *A.Allocator, cwd: str, spelled: str) res[str, fail.Fail] {
    val absolute: res[str, A.Error] = types_path.resolve(scratch, cwd, spelled);
    if (sel absolute.err) { ret res[str, fail.Fail].err{fail.refused(absolute.err)}; }
    val joined: str = absolute.ok;
    fin { str_free(scratch, joined); }
    val cleaned: res[str, A.Error] = types_path.clean(scratch, joined);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

# the key holds every path in canonical form; the spelling is added only when
# debug information is requested, because then it reaches the line tables and
# two spellings really do produce two objects
fun key_path(b: *cache_key.Builder, scratch: *A.Allocator, cwd: str, spelled: str, spelling_matters: bool) err[fail.Fail] {
    val canon: res[str, fail.Fail] = canonical(scratch, cwd, spelled);
    if (sel canon.err) { ret err[fail.Fail].err{canon.err}; }
    cache_key.text(b, canon.ok);
    str_free(scratch, canon.ok);
    if (spelling_matters) { cache_key.text(b, spelled); }
    or                    { cache_key.text(b, nil); }
    ret err[fail.Fail].ok{};
}

fun current_dir(scratch: *A.Allocator) res[OwnedString, fail.Fail] {
    val cwd_r: res[OwnedString, env.EnvError] = env.current_dir(scratch);
    if (sel cwd_r.err) { ret res[OwnedString, fail.Fail].err{fail.message("the object cache cannot read the current directory")}; }
    ret res[OwnedString, fail.Fail].ok{cwd_r.ok};
}

# what every module's key shares: the compiler identity, the configuration
# bytes the driver captured (target, platform, project identity), the request,
# the realized dependency closure and the link requirements.
# a step's output reaches a module only as a file it embeds or a source it
# loads, each keyed by its bytes, so no step is part of the configuration
pub fun configuration(scratch: *A.Allocator, p: *project.Project, config: *u8, config_len: usize,
    compiler_id: *compiler.Identity, digest: *[32]u8) err[fail.Fail] {
    if (scratch == nil || p == nil || p.s == nil || compiler_id == nil || digest == nil
        || compiler_id.len == 0 || compiler_id.len > 32) {
        ret err[fail.Fail].err{fail.message("the cache configuration requires a project and compiler identity")};
    }
    val cwd_r: res[OwnedString, fail.Fail] = current_dir(scratch);
    if (sel cwd_r.err) { ret err[fail.Fail].err{cwd_r.err}; }
    var cwd_owned: OwnedString = cwd_r.ok;
    fin { owned_release(?cwd_owned); }
    val cwd:              str               = cwd_owned.data;
    val spelling_matters: bool              = p.req.debug;
    var b:                cache_key.Builder = cache_key.begin("mach.build-configuration");
    cache_key.bytes(?b, ?compiler_id.bytes[0], compiler_id.len);
    cache_key.bytes(?b, config, config_len);
    cache_key.name(?b, ?p.s.interner, p.compiler_name);
    cache_key.name(?b, ?p.s.interner, p.compiler_ver);
    # the request names the project by its spelled root; the key names it canonically
    val canonical_root: res[str, fail.Fail] = canonical(scratch, cwd, p.req.project_root);
    if (sel canonical_root.err) { ret err[fail.Fail].err{canonical_root.err}; }
    var keyed_request: request.BuildRequest = p.req;
    keyed_request.project_root = canonical_root.ok;
    # a test build compiles the build's own objects, whatever tests it selects
    if (request.test_goal(keyed_request.goal)) {
        keyed_request.goal         = request.GOAL_ARTIFACT;
        keyed_request.include_deps = false;
    }
    var request_digest: [32]u8;
    val requested:      err[fail.Fail] = request.semantic_hash(scratch, ?keyed_request, ?request_digest[0]);
    str_free(scratch, canonical_root.ok);
    if (sel requested.err) { ret err[fail.Fail].err{requested.err}; }
    cache_key.bytes(?b, ?request_digest[0], 32);
    cache_key.name(?b, ?p.s.interner, p.config.module);
    cache_key.name(?b, ?p.s.interner, p.config.dir_src);
    val root: opt[str] = intern.get(?p.s.interner, p.config.project_root);
    if (sel root.none) { ret err[fail.Fail].err{fail.message("the cache configuration has no project root")}; }
    val root_keyed: err[fail.Fail] = key_path(?b, scratch, cwd, root.some, spelling_matters);
    if (sel root_keyed.err) { ret root_keyed; }
    cache_key.number(?b, p.roots::u64);
    cache_key.number(?b, p.config.dep_count::u64);
    var i: u32 = 0;
    for (i < p.config.dep_count) {
        val d: *project.DepEntry = ?p.config.deps[i];
        cache_key.name(?b, ?p.s.interner, d.alias);
        cache_key.name(?b, ?p.s.interner, d.project_id);
        cache_key.name(?b, ?p.s.interner, d.project_dir_src);
        val vendor: opt[str] = intern.get(?p.s.interner, d.vendor_root);
        if (sel vendor.none) { ret err[fail.Fail].err{fail.message("the cache configuration dependency has no vendor root")}; }
        val vendor_keyed: err[fail.Fail] = key_path(?b, scratch, cwd, vendor.some, spelling_matters);
        if (sel vendor_keyed.err) { ret vendor_keyed; }
        cache_key.name(?b, ?p.s.interner, d.source);
        cache_key.name(?b, ?p.s.interner, d.ref);
        cache_key.name(?b, ?p.s.interner, d.manifest.version);
        cache_key.number(?b, d.direct_count::u64);
        var n: u32 = 0;
        for (n < d.direct_count) {
            cache_key.name(?b, ?p.s.interner, d.direct[n]);
            n = n + 1;
        }
        i = i + 1;
    }
    # each object carries the unit's link requirements as its link claims
    if (p.target_entry != nil) { key_link_requirements(?b, p, p.target_entry.libs, p.target_entry.lib_count); }
    key_link_requirements(?b, p, p.config.cascade_libs, p.config.cascade_lib_count);
    ret cache_key.finish(?b, digest);
}

fun key_link_requirements(b: *cache_key.Builder, p: *project.Project, reqs: *manifest_link.LinkRequirement, count: u32) {
    cache_key.number(b, count::u64);
    var i: u32 = 0;
    for (i < count) {
        val r: *manifest_link.LinkRequirement = ?reqs[i];
        cache_key.number(b, r.source::u64);
        cache_key.name(b, ?p.s.interner, r.text);
        cache_key.name(b, ?p.s.interner, r.key);
        cache_key.number(b, r.kind::u64);
        cache_key.number(b, r.include_referenced::u64);
        cache_key.number(b, r.versions.stated::u64);
        cache_key.number(b, r.versions.current::u64);
        cache_key.number(b, r.versions.compat::u64);
        cache_key.number(b, r.symbol_count::u64);
        var k: u32 = 0;
        for (k < r.symbol_count) {
            cache_key.name(b, ?p.s.interner, r.symbols[k]);
            k = k + 1;
        }
        i = i + 1;
    }
}

# the compiler identity is a process constant: read once per project, reported
# under the readout phase ph that asked for it
fun identify(p: *project.Project, ph: readout.Phase) err[fail.Fail] {
    if (p.compiler_identity_initialized) { ret err[fail.Fail].ok{}; }
    val t_identity: readout.Instant     = readout.item_begin(p.progress);
    val identified: err[compiler.Error] = compiler.identity(p.s.backing, ?p.compiler_identity);
    if (sel identified.err) {
        val error: compiler.Error = identified.err;
        if (error.kind != host.FAULT_UNAVAILABLE) { ret err[fail.Fail].err{fail.message(error.message)}; }
        readout.item(p.progress, ph, "compiler identity unavailable", t_identity);
    }
    if (sel identified.ok) {
        p.compiler_identity_available = true;
        readout.item(p.progress, ph, "compiler identity: image digest", t_identity);
    }
    p.compiler_identity_initialized = true;
    ret err[fail.Fail].ok{};
}

fun identity_available(p: *project.Project) bool {
    ret p.compiler_identity_initialized && p.compiler_identity_available;
}

# `obj/` is the object cache when the build writes its modules there as
# relocatable objects mink lays out and reads back
fun objects_cached(p: *project.Project) bool {
    ret p.object_dir != nil && p.target.target.format != nil && p.back.target.format != nil;
}

# where the build writes module m's object: `obj/<project>/<module path>.<ext>`
fun object_path(p: *project.Project, m: *project.ModuleEntry, a: *A.Allocator) res[str, fail.Fail] {
    if (p.object_dir == nil || p.target.target.format == nil) { ret res[str, fail.Fail].err{fail.message("the build has no object directory")}; }
    val fqn: opt[str] = intern.get(?p.s.interner, m.fqn);
    if (sel fqn.none) { ret res[str, fail.Fail].err{fail.message("module FQN not interned")}; }
    val named: res[str, fail.Fail] = output.mirror_fqn(a, p.object_dir, fqn.some, backend.OBJECT_EXT);
    if (sel named.err) { ret res[str, fail.Fail].err{named.err}; }
    ret res[str, fail.Fail].ok{named.ok};
}

# where the build writes module m's test object: `obj/<project>/<module path>.test.<ext>`
pub fun test_object_path(p: *project.Project, m: *project.ModuleEntry, a: *A.Allocator) res[str, fail.Fail] {
    if (p.object_dir == nil || p.target.target.format == nil) { ret res[str, fail.Fail].err{fail.message("the build has no object directory")}; }
    val fqn: opt[str] = intern.get(?p.s.interner, m.fqn);
    if (sel fqn.none) { ret res[str, fail.Fail].err{fail.message("module FQN not interned")}; }
    val suffix: res[str, types_string.StrError] = str_join(a, "test.", backend.OBJECT_EXT);
    if (sel suffix.err) { ret res[str, fail.Fail].err{fail.str_refused(suffix.err)}; }
    fin { str_free(a, suffix.ok); }
    val named: res[str, fail.Fail] = output.mirror_fqn(a, p.object_dir, fqn.some, suffix.ok);
    if (sel named.err) { ret res[str, fail.Fail].err{named.err}; }
    ret res[str, fail.Fail].ok{named.ok};
}

# the module gets a test object in this build: a test build, and a module whose
# source declares a test or a `#[testing]` declaration
pub fun has_test_object(p: *project.Project, m: *project.ModuleEntry) bool {
    if (!request.test_goal(p.req.goal)) { ret false; }
    val syn: *ast.Ast = frontend.syntax(p, m);
    if (syn == nil) { ret false; }
    ret testrunner.declares_tests(syn);
}

# the digest memo in the cell's compiler-only state: `<out>/.cache/digests`,
# none for a build that has no such directory, whose memo lives in memory only
fun memo_path(p: *project.Project, scratch: *A.Allocator) res[opt[str], fail.Fail] {
    if (p.cache_dir == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val file: res[str, A.Error] = types_path.join(scratch, p.cache_dir, "digests");
    if (sel file.err) { ret res[opt[str], fail.Fail].err{fail.refused(file.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{file.ok}};
}

# a module whose object is cached skips lowering when nothing else needs its
# unit: the ir and asm emitters read it
pub fun early_restore_enabled(p: *project.Project) bool {
    ret p.req.object_cache && !p.req.emit_ir && !p.req.emit_asm;
}

# the module's codegen product is its cached object under the key this load
# built, whether it is still staged or a query already took it
pub fun restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret p.cache_ready && m.cache_keyed && m.cache_hit && cache_key.equal(?m.cache_under, ?m.cache_key);
}

# restored and still staged, which is what the codegen query publishes
pub fun staged_restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret m.staged != nil && restored(p, m);
}

# the module's test object is its cached object under the key this load built
pub fun test_restored(p: *project.Project, m: *project.ModuleEntry) bool {
    if (!p.cache_ready || !m.cache_keyed || !m.test.cache_hit) { ret false; }
    var current: [32]u8;
    val keyed:   err[fail.Fail] = test_object_key(p, m, ?current);
    ret sel keyed.ok && cache_key.equal(?m.test.cache_under, ?current);
}

# the test object is restored and still staged for the codegen query to publish
pub fun test_staged_restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret m.test.staged != nil && test_restored(p, m);
}

# the module is restored and nothing needs its lowered ir
pub fun skips_lowering(p: *project.Project, m: *project.ModuleEntry) bool {
    ret restored(p, m) && early_restore_enabled(p);
}

# the emitted modules the build lowers
pub fun lowered_count(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.emit_len) {
        if (!skips_lowering(p, project.module_at(p, p.topo[i]::u32))) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the emitted modules the build generates code for
pub fun generated_count(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.emit_len) {
        if (!restored(p, project.module_at(p, p.topo[i]::u32))) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the modules the front end still processes
pub fun frontend_count(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (!project.module_at(p, p.topo[i]::u32).frontend_skipped) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# every key, skip decision and record of the previous load is dropped: the next load
# keys again, and a project that is not keyed processes every module
pub fun forget(p: *project.Project) err[fail.Fail] {
    p.cache_ready = false;
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        m.cache_keyed      = false;
        m.frontend_skipped = false;
        project.recorded_drop(m);
        i = i + 1;
    }
    cache_instances.dnit(?p.instance_records);
    p.instance_records = cache_instances.init(p.alloc);
    ret publish_records(p);
}

# the object an `obj/` file holds, as mink reads it back, with the facts its record carries
rec Cached {
    object: Object;
    facts:  cache_record.Facts;
}

# where the cell keeps the digests of the objects its builds wrote: `<out>/.cache/objects`, none
# for a build without such a directory
fun objects_path(p: *project.Project, scratch: *A.Allocator) res[opt[str], fail.Fail] {
    if (p.cache_dir == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val res_join: res[str, A.Error] = types_path.join(scratch, p.cache_dir, "objects");
    if (sel res_join.err) { ret res[opt[str], fail.Fail].err{fail.refused(res_join.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{res_join.ok}};
}

# the path of `location` under `obj/`, which names its digest, borrowed from `location`; nil when
# it lies elsewhere
fun under_objects(p: *project.Project, location: str) str {
    if (p.object_dir == nil || location == nil) { ret nil; }
    var n: usize = str_len(p.object_dir);
    if (str_len(location) <= n || !memory.raw_equal(location::ptr, p.object_dir::ptr, n)) { ret nil; }
    if (n > 0 && p.object_dir[n - 1] == '/')                                              { ret (location::usize + n)::str; }
    if (location[n] != '/')                                                               { ret nil; }
    ret (location::usize + n + 1)::str;
}

# read the digests of the objects the cell's builds wrote, empty when there are none
fun read_written(p: *project.Project) err[fail.Fail] {
    cache_objects.dnit(?p.object_digests);
    p.object_digests = cache_objects.init(p.alloc);
    val res_path: res[opt[str], fail.Fail] = objects_path(p, p.s.backing);
    if (sel res_path.err)     { ret err[fail.Fail].err{res_path.err}; }
    if (sel res_path.ok.none) { ret err[fail.Fail].ok{}; }
    val res_load: res[cache_objects.Store, A.Error] = cache_objects.load(p.alloc, res_path.ok.some);
    str_free(p.s.backing, res_path.ok.some);
    if (sel res_load.err) { ret err[fail.Fail].err{fail.refused(res_load.err)}; }
    p.object_digests = res_load.ok;
    ret err[fail.Fail].ok{};
}

# the object written to `location` was the `len` bytes at `bytes`: a keyed object under `obj/`
# is remembered by its digest for the restore that reads it back
pub fun note_written(p: *project.Project, location: str, bytes: *u8, len: usize) err[fail.Fail] {
    if (!p.cache_ready) { ret err[fail.Fail].ok{}; }
    val rel: str = under_objects(p, location);
    if (rel == nil) { ret err[fail.Fail].ok{}; }
    val err_put: err[A.Error] = cache_objects.put(?p.object_digests, rel, bytes, len);
    if (sel err_put.err) { ret err[fail.Fail].err{fail.refused(err_put.err)}; }
    ret err[fail.Fail].ok{};
}

# store the digests of the objects this build wrote, once they are in place
pub fun store_written(p: *project.Project) err[fail.Fail] {
    if (!p.cache_ready) { ret err[fail.Fail].ok{}; }
    val res_path: res[opt[str], fail.Fail] = objects_path(p, p.s.backing);
    if (sel res_path.err)     { ret err[fail.Fail].err{res_path.err}; }
    if (sel res_path.ok.none) { ret err[fail.Fail].ok{}; }
    val err_store: err[fail.Fail] = cache_objects.store(?p.object_digests, p.out_dir, res_path.ok.some);
    str_free(p.s.backing, res_path.ok.some);
    ret err_store;
}

# the object at `location` when its bytes are the bytes a build wrote there and its record says
# it was built under `expected`, none on a miss: an object that is missing, unreadable, not the
# bytes written, carries no record or a damaged one, or was built under another key is rebuilt,
# never reused. err only when allocation fails
pub fun read(p: *project.Project, location: str, expected: *[32]u8) res[opt[Cached], fail.Fail] {
    val rel: str = under_objects(p, location);
    if (rel == nil) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    val opt_written: opt[[32]u8] = cache_objects.written(?p.object_digests, rel);
    if (sel opt_written.none) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    val res_read: res[collections_vector.Vector[u8], fs.FsError] = fs.read_bytes(p.s.backing, location);
    if (sel res_read.err) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    var recorded: [32]u8 = opt_written.some;
    var held:     [32]u8;
    sha256.hash(res_read.ok.data, res_read.ok.len, ?held[0]);
    if (!cache_key.equal(?held, ?recorded)) {
        var dropped: collections_vector.Vector[u8] = res_read.ok;
        collections_vector.dnit[u8](?dropped);
        ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}};
    }
    val res_object: res[Object, fail.Fail] = backend.read_object(?p.back, p.s.alloc, location, res_read.ok);
    if (sel res_object.err) {
        fail.dnit(p.s.alloc, res_object.err);
        ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}};
    }
    var object: Object = res_object.ok;
    var handed: bool   = false;
    fin {
        if (!handed) { backend.release_object(?object); }
    }
    var record_len: usize                                    = 0;
    val record:     *u8                                      = backend.section_bytes(?object, backend.RECORD_SECTION, ?record_len);
    val decoded:    res[opt[cache_record.Record], fail.Fail] = cache_record.decode(p.s.alloc, ?p.s.interner, record, record_len);
    if (sel decoded.err)     { ret res[opt[Cached], fail.Fail].err{decoded.err}; }
    if (sel decoded.ok.none) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    var found: cache_record.Record = decoded.ok.some;
    if (!cache_key.equal(?found.key, expected)) {
        cache_record.record_dnit(p.s.alloc, ?found);
        ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}};
    }
    handed = true;
    ret res[opt[Cached], fail.Fail].ok{opt[Cached].some{Cached{object: object, facts: found.facts}}};
}

# the object key of a module: its module key and its name. a module's other
# objects (a test object) key off this one
fun object_key(p: *project.Project, m: *project.ModuleEntry, out: *[32]u8) err[fail.Fail] {
    ret cache_key.object(?m.cache_key, intern.text(?p.s.interner, m.fqn), out);
}

# the key of module m's test object, from its normal object's key, which covers the module's
# whole source
fun test_object_key(p: *project.Project, m: *project.ModuleEntry, out: *[32]u8) err[fail.Fail] {
    var normal: [32]u8;
    val keyed:  err[fail.Fail] = object_key(p, m, ?normal);
    if (sel keyed.err) { ret keyed; }
    ret cache_key.test_object(?normal, out);
}

# an instance unit's key leaves out its origin's other code, so the unit is reused across an edit
# there. what its back half warned is replayed at the places the earlier source put it, so a unit
# whose record holds such a warning stands only for the source it names
fun warnings_stand(p: *project.Project, source: [32]u8, facts: *cache_record.Facts) res[bool, fail.Fail] {
    var current: [32]u8 = source;
    if (cache_key.equal(?current, ?facts.source)) { ret res[bool, fail.Fail].ok{true}; }
    val warned: res[bool, fail.Fail] = back_warned(p, facts);
    if (sel warned.err) { ret warned; }
    ret res[bool, fail.Fail].ok{!warned.ok};
}

# read module m's test object under its key, as restore reads its normal object
fun restore_test(p: *project.Project, m: *project.ModuleEntry) res[bool, fail.Fail] {
    val t:        *project.TestObject = ?m.test;
    var expected: [32]u8;
    val keyed:    err[fail.Fail]      = test_object_key(p, m, ?expected);
    if (sel keyed.err)                                                                { ret res[bool, fail.Fail].err{keyed.err}; }
    if (t.cache_checked && t.cache_hit && cache_key.equal(?t.cache_under, ?expected)) { ret res[bool, fail.Fail].ok{true}; }
    project.release_staged_test(p, m);
    t.cache_checked = true;
    t.cache_under   = expected;
    val located: res[str, fail.Fail] = test_object_path(p, m, p.s.backing);
    if (sel located.err) { ret res[bool, fail.Fail].err{located.err}; }
    val found: res[opt[Cached], fail.Fail] = read(p, located.ok, ?expected);
    str_free(p.s.backing, located.ok);
    if (sel found.err) { ret res[bool, fail.Fail].err{found.err}; }
    if (sel found.ok.none) {
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    var cached: Cached                = found.ok.some;
    val boxed:  res[*Object, A.Error] = A.allocate[Object](p.s.alloc, 1);
    if (sel boxed.err) {
        cache_record.facts_dnit(p.s.alloc, ?cached.facts);
        backend.release_object(?cached.object);
        ret res[bool, fail.Fail].err{fail.refused(boxed.err)};
    }
    @boxed.ok      = cached.object;
    t.staged       = boxed.ok;
    t.staged_facts = cached.facts;
    t.cache_hit    = true;
    p.cache_hits   = p.cache_hits + 1;
    ret res[bool, fail.Fail].ok{true};
}

# read module m's object under its key; a hit is staged for the codegen query.
# a hit under the same key stands, and a miss is read again, since the build
# that missed published the object
fun restore(p: *project.Project, m: *project.ModuleEntry) res[bool, fail.Fail] {
    if (m.cache_checked && m.cache_hit && cache_key.equal(?m.cache_under, ?m.cache_key)) { ret res[bool, fail.Fail].ok{true}; }
    project.release_staged(p, m);
    m.cache_checked = true;
    m.cache_under   = m.cache_key;
    var expected: [32]u8;
    val keyed:    err[fail.Fail] = object_key(p, m, ?expected);
    if (sel keyed.err) { ret res[bool, fail.Fail].err{keyed.err}; }
    val located: res[str, fail.Fail] = object_path(p, m, p.s.backing);
    if (sel located.err) { ret res[bool, fail.Fail].err{located.err}; }
    val found: res[opt[Cached], fail.Fail] = read(p, located.ok, ?expected);
    str_free(p.s.backing, located.ok);
    if (sel found.err) { ret res[bool, fail.Fail].err{found.err}; }
    if (sel found.ok.none) {
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    var cached: Cached = found.ok.some;
    var handed: bool   = false;
    fin {
        if (!handed) {
            cache_record.facts_dnit(p.s.alloc, ?cached.facts);
            backend.release_object(?cached.object);
        }
    }
    val boxed: res[*Object, A.Error] = A.allocate[Object](p.s.alloc, 1);
    if (sel boxed.err) { ret res[bool, fail.Fail].err{fail.refused(boxed.err)}; }
    @boxed.ok = cached.object;
    handed    = true;
    cache_record.facts_dnit(p.s.alloc, ?m.staged_facts);
    m.staged       = boxed.ok;
    m.staged_facts = cached.facts;
    m.cache_hit    = true;
    p.cache_hits   = p.cache_hits + 1;
    ret res[bool, fail.Fail].ok{true};
}

# what one load needs while it keys its modules
rec Keying {
    scratch: *A.Allocator;
    cwd:     str;
    config:  [32]u8;
    memo:    memo.Memo;
    # which surface digest an importer's key reads
    variant: u8;
    # each module's surface digest, 32 bytes at 32 times its module number
    ifaces: *u8;
    ready:  *bool;
    spans:  Vector[lang_source.Span];
}

val SURFACE_BARE:   u8 = 0;
val SURFACE_PLACED: u8 = 1;
val SURFACE_WHOLE:  u8 = 2;

fun compute_surfaces(k: *Keying, syn: *ast.Ast, text: str, out: *memo.Digests) err[fail.Fail] {
    collections_vector.clear[lang_source.Span](?k.spans);
    val found: err[fail.Fail] = surface.omitted(syn, text, ?k.spans);
    if (sel found.err) { ret found; }
    surface.digest(text, ?k.spans, false, ?out.surface);
    surface.digest(text, ?k.spans, true, ?out.placed);
    collections_vector.clear[lang_source.Span](?k.spans);
    val tested: err[fail.Fail] = surface.tests(syn, text, ?k.spans);
    if (sel tested.err) { ret tested; }
    surface.digest(text, ?k.spans, true, ?out.normal_placed);
    ret err[fail.Fail].ok{};
}

# the digests of the module's text, the text load read: its own digest, then its
# surfaces from the memo under that digest, else computed and remembered
fun source_digests(k: *Keying, syn: *ast.Ast, text: str, out: *memo.Digests) err[fail.Fail] {
    sha256.hash(text::*u8, str_len(text), ?out.content[0]);
    if (memo.lookup(?k.memo, out)) { ret err[fail.Fail].ok{}; }
    val computed: err[fail.Fail] = compute_surfaces(k, syn, text, out);
    if (sel computed.err) { ret computed; }
    val recorded: err[A.Error] = memo.record(?k.memo, out);
    if (sel recorded.err) { ret err[fail.Fail].err{fail.refused(recorded.err)}; }
    ret err[fail.Fail].ok{};
}

# the files a module embeds, by path, status, length and digest
fun key_embeds(b: *cache_key.Builder, p: *project.Project, mid: u32) err[fail.Fail] {
    var paths: Vector[str] = collections_vector.init[str](p.s.alloc);
    fin {
        var i: usize = 0;
        for (i < paths.len) {
            str_free(p.s.alloc, paths.data[i]);
            i = i + 1;
        }
        collections_vector.dnit[str](?paths);
    }
    val collected: err[fail.Fail] = declared.module_embeds(p, mid::module.ModuleId, ?paths);
    if (sel collected.err) { ret collected; }
    cache_key.number(b, paths.len::u64);
    var i: usize = 0;
    for (i < paths.len) {
        cache_key.text(b, paths.data[i]);
        val named: res[intern.StrId, A.Error] = intern.add(?p.s.interner, paths.data[i]);
        if (sel named.err) { ret err[fail.Fail].err{fail.refused(named.err)}; }
        val found: opt[*session_embed.EmbedFile] = session_embed.get(?p.s.embeds, named.ok);
        if (sel found.some) {
            val e: *session_embed.EmbedFile = found.some;
            cache_key.number(b, e.status::u64);
            cache_key.number(b, e.len::u64);
            cache_key.bytes(b, ?e.digest[0], 32);
        }
        or { cache_key.number(b, 0xFFFFFFFF); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# what names a module in both of its digests: its name, its file and the
# artifact whose comptime values it reads
fun key_module_identity(b: *cache_key.Builder, k: *Keying, p: *project.Project, mid: u32, file: str) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid);
    cache_key.name(b, ?p.s.interner, m.fqn);
    cache_key.name(b, ?p.s.interner, m.load.artifact);
    ret key_path(b, k.scratch, k.cwd, file, p.req.debug);
}

fun iface_of(k: *Keying, mid: u32) *u8 {
    ret (k.ifaces::usize + mid::usize * 32)::*u8;
}

fun key_imports(b: *cache_key.Builder, k: *Keying, p: *project.Project, m: *project.ModuleEntry) {
    cache_key.number(b, project.dep_count(m)::u64);
    var d: u32 = 0;
    for (d < project.dep_count(m)) {
        cache_key.bytes(b, iface_of(k, project.dep_at(p, m, d)::u32), 32);
        d = d + 1;
    }
}

# key module mid: its import surface for its importers, and its object key.
# a module without a current source, or one importing a module that has no
# surface yet, stays unkeyed and is always built
fun key_module(k: *Keying, p: *project.Project, mid: u32) err[fail.Fail] {
    val m:   *project.ModuleEntry = project.module_at(p, mid);
    val syn: *ast.Ast             = frontend.syntax(p, m);
    if (syn == nil || lang_source.file_is_nil(m.file_id)) { ret err[fail.Fail].ok{}; }
    val file_o: opt[*lang_source.SourceFile] = lang_source.get(p.s.sources, m.file_id);
    if (sel file_o.none) { ret err[fail.Fail].ok{}; }
    val f: *lang_source.SourceFile = file_o.some;
    if (!f.present || f.text == nil || f.path == nil) { ret err[fail.Fail].ok{}; }
    var d: u32 = 0;
    for (d < project.dep_count(m)) {
        val dep: u32 = project.dep_at(p, m, d)::u32;
        if (dep >= project.module_count(p) || !k.ready[dep]) { ret err[fail.Fail].ok{}; }
        d = d + 1;
    }
    var digests: memo.Digests;
    val known:   err[fail.Fail] = source_digests(k, syn, f.text, ?digests);
    if (sel known.err) { ret err[fail.Fail].err{fail.placed(known.err, m.file_id)}; }

    var iface: cache_key.Builder = cache_key.begin("mach.module-surface");
    val named: err[fail.Fail]    = key_module_identity(?iface, k, p, mid, f.path);
    if (sel named.err)               { ret named; }
    if (k.variant == SURFACE_WHOLE)  { cache_key.bytes(?iface, ?digests.normal_placed[0], 32); }
    or (k.variant == SURFACE_PLACED) { cache_key.bytes(?iface, ?digests.placed[0], 32); }
    or                               { cache_key.bytes(?iface, ?digests.surface[0], 32); }
    val iface_embeds: err[fail.Fail] = key_embeds(?iface, p, mid);
    if (sel iface_embeds.err) { ret iface_embeds; }
    key_imports(?iface, k, p, m);

    var own: cache_key.Builder = cache_key.begin("mach.module-object");
    cache_key.bytes(?own, ?k.config[0], 32);
    val named_own: err[fail.Fail] = key_module_identity(?own, k, p, mid, f.path);
    if (sel named_own.err) { ret named_own; }
    # the module's whole source: its record holds the places of its warnings and of the instances
    # it asks for, and its test object is keyed from it
    cache_key.bytes(?own, ?digests.content[0], 32);
    val own_embeds: err[fail.Fail] = key_embeds(?own, p, mid);
    if (sel own_embeds.err) { ret own_embeds; }
    key_imports(?own, k, p, m);

    val iface_done: err[fail.Fail] = cache_key.finish(?iface, iface_of(k, mid)::*[32]u8);
    if (sel iface_done.err) { ret iface_done; }
    m.surface_digest = @(iface_of(k, mid)::*[32]u8);
    m.placed_digest  = digests.placed;
    val own_done: err[fail.Fail] = cache_key.finish(?own, ?m.cache_key);
    if (sel own_done.err) { ret own_done; }
    m.source_digest = digests.content;
    k.ready[mid]    = true;
    m.cache_keyed   = true;
    ret err[fail.Fail].ok{};
}

fun memo_compiler(id: *compiler.Identity, out: *[32]u8) err[fail.Fail] {
    var b: cache_key.Builder = cache_key.begin("mach.digest-memo");
    cache_key.bytes(?b, ?id.bytes[0], id.len);
    ret cache_key.finish(?b, out);
}

fun key_modules(p: *project.Project, scratch: *A.Allocator, config: *u8, config_len: usize, ph: readout.Phase) err[fail.Fail] {
    val t_keys: readout.Instant             = readout.item_begin(p.progress);
    val cwd_r:  res[OwnedString, fail.Fail] = current_dir(scratch);
    if (sel cwd_r.err) { ret err[fail.Fail].err{cwd_r.err}; }
    var cwd_owned: OwnedString = cwd_r.ok;
    fin { owned_release(?cwd_owned); }
    var k: Keying = Keying{scratch: scratch, cwd: cwd_owned.data, spans: collections_vector.init[lang_source.Span](scratch)};
    fin { collections_vector.dnit[lang_source.Span](?k.spans); }
    val configured: err[fail.Fail] = configuration(scratch, p, config, config_len, ?p.compiler_identity, ?k.config);
    if (sel configured.err) { ret configured; }
    p.cache_config = k.config;
    k.variant      = SURFACE_BARE;
    if (p.req.opt == request.OPT_RELEASE) { k.variant = SURFACE_WHOLE; }
    or (p.req.debug)                      { k.variant = SURFACE_PLACED; }

    var owner: [32]u8;
    val owned: err[fail.Fail] = memo_compiler(?p.compiler_identity, ?owner);
    if (sel owned.err) { ret owned; }
    val located: res[opt[str], fail.Fail] = memo_path(p, scratch);
    if (sel located.err) { ret err[fail.Fail].err{located.err}; }
    val memo_file: opt[str] = located.ok;
    k.memo = memo.init(scratch, ?owner);
    if (sel memo_file.some) {
        val loaded: res[memo.Memo, A.Error] = memo.load(scratch, ?owner, memo_file.some);
        if (sel loaded.err) { ret err[fail.Fail].err{fail.refused(loaded.err)}; }
        memo.dnit(?k.memo);
        k.memo = loaded.ok;
    }
    fin { memo.dnit(?k.memo); }

    val n:        usize             = project.module_count(p)::usize;
    val ifaces_r: res[*u8, A.Error] = A.zallocate[u8](scratch, (n + 1) * 32);
    if (sel ifaces_r.err) { ret err[fail.Fail].err{fail.refused(ifaces_r.err)}; }
    val ready_r: res[*bool, A.Error] = A.zallocate[bool](scratch, n + 1);
    if (sel ready_r.err) { ret err[fail.Fail].err{fail.refused(ready_r.err)}; }
    k.ifaces = ifaces_r.ok;
    k.ready  = ready_r.ok;
    var i: u32 = 0;
    for (i < p.topo_len) {
        val keyed: err[fail.Fail] = key_module(?k, p, p.topo[i]::u32);
        if (sel keyed.err) { ret keyed; }
        i = i + 1;
    }
    if (sel memo_file.some) {
        val stored: err[fail.Fail] = memo.store(?k.memo, p.out_dir, memo_file.some);
        if (sel stored.err) { ret err[fail.Fail].err{stored.err}; }
    }
    readout.item(p.progress, ph, "module keys", t_keys);
    ret err[fail.Fail].ok{};
}

# a module's test object is keyed in the query database by its stable id and this bit
pub val TEST_KEY_BIT: u64 = 0x100000000;

# the key a module's reused object was built under, keyed by its stable id and the test bit
pub val OBJECT_KEY: query.Kind = query.Kind{name: "object key", role: query.INPUT, owner: query.KEY_MODULE};

# the query key of a module's test object products and its object key input
pub fun test_input_key(m: *project.ModuleEntry) u64 {
    ret module.stable_index(m.stable_id)::u64 | TEST_KEY_BIT;
}

# every key goes into the query database, so a product restored under one
# key recomputes in a session that later keys the module differently
fun publish_keys(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.cache_keyed) {
            var digest: [32]u8;
            val keyed:  err[fail.Fail] = object_key(p, m, ?digest);
            if (sel keyed.err) { ret keyed; }
            val set: err[fail.Fail] = query.set_input(?p.s.queries, ?OBJECT_KEY, module.stable_index(m.stable_id)::u64, ?digest[0], 32);
            if (sel set.err) { ret set; }
            if (has_test_object(p, m)) {
                var tested:     [32]u8;
                val test_keyed: err[fail.Fail] = test_object_key(p, m, ?tested);
                if (sel test_keyed.err) { ret test_keyed; }
                val set_test: err[fail.Fail] = query.set_input(?p.s.queries, ?OBJECT_KEY, test_input_key(m), ?tested[0], 32);
                if (sel set_test.err) { ret set_test; }
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module the build still compiles needs the typed definitions of everything
# it imports, transitively, so only a reused module nothing compiled imports
# skips the front end. its record stands in for its demand and its warnings,
# which its key, covering its whole source, holds to that source
fun mark_skipped(p: *project.Project, scratch: *A.Allocator) err[fail.Fail] {
    if (!early_restore_enabled(p)) { ret err[fail.Fail].ok{}; }
    val n:        usize               = project.module_count(p)::usize;
    val needed_r: res[*bool, A.Error] = A.zallocate[bool](scratch, n + 1);
    if (sel needed_r.err) { ret err[fail.Fail].err{fail.refused(needed_r.err)}; }
    val needed: *bool = needed_r.ok;
    fin { A.deallocate[bool](scratch, needed, n + 1); }
    var i: u32 = 0;
    for (i < p.topo_len) {
        val mid: u32                  = p.topo[i]::u32;
        val m:   *project.ModuleEntry = project.module_at(p, mid);
        if (i >= p.emit_len || !restored(p, m))            { needed[mid] = true; }
        or (has_test_object(p, m) && !test_restored(p, m)) { needed[mid] = true; }
        i = i + 1;
    }
    # the topo lists every module after its imports, so walking it backwards
    # reaches a module's importers first
    i = p.topo_len;
    for (i > 0) {
        i = i - 1;
        val mid: u32 = p.topo[i]::u32;
        if (needed[mid]) {
            val m: *project.ModuleEntry = project.module_at(p, mid);
            var d: u32                  = 0;
            for (d < project.dep_count(m)) {
                val dep: u32 = project.dep_at(p, m, d)::u32;
                if (dep < n::u32) { needed[dep] = true; }
                d = d + 1;
            }
        }
    }
    i = 0;
    for (i < p.topo_len) {
        val mid: u32                  = p.topo[i]::u32;
        val m:   *project.ModuleEntry = project.module_at(p, mid);
        m.frontend_skipped = !needed[mid];
        if (m.frontend_skipped) {
            val held: err[fail.Fail] = hold_recorded(p, m);
            if (sel held.err) { ret held; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a skipped module's front end's warnings, read from its record and held for every refresh of the
# build's diagnostics until its front end runs after all
fun hold_recorded(p: *project.Project, m: *project.ModuleEntry) err[fail.Fail] {
    project.recorded_drop(m);
    if (m.staged_facts.warnings_len == 0) { ret err[fail.Fail].ok{}; }
    m.recorded      = diagnostic.store_init(p.diags.a);
    m.recorded_held = true;
    var back_seen: bool                 = false;
    val read:      res[bool, fail.Fail] = read_warnings(p, ?m.staged_facts, PHASE_FRONT, ?m.recorded, ?back_seen);
    if (sel read.err) { ret err[fail.Fail].err{read.err}; }
    ret err[fail.Fail].ok{};
}

# the record of what the build's demand reads outside the query engine, which the demand depends
# on: whether the load is keyed, each skipped module and the key its record stands under, and each
# instance record and what the load decided of it. a load that is not keyed reads nothing
pub val DEMAND_RECORDS: query.Kind = query.Kind{name: "demand records", role: query.INPUT, owner: query.KEY_UNOWNED};

fun publish_records(p: *project.Project) err[fail.Fail] {
    var b: cache_key.Builder = cache_key.begin("mach.demand-records");
    cache_key.number(?b, p.cache_ready::u64);
    if (p.cache_ready) {
        var i: u32 = 0;
        for (i < p.topo_len) {
            val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
            if (m.frontend_skipped) {
                cache_key.number(?b, module.stable_index(m.stable_id)::u64);
                cache_key.bytes(?b, ?m.cache_key[0], 32);
                cache_key.bytes(?b, ?m.source_digest[0], 32);
            }
            i = i + 1;
        }
        val st: *cache_instances.Store = ?p.instance_records;
        var r:  usize                  = 0;
        for (r < st.records.len) {
            val rec: *cache_instances.Record = ?st.records.data[r];
            cache_key.name(?b, ?p.s.interner, rec.name);
            cache_key.number(?b, rec.current::u64);
            cache_key.number(?b, rec.positional::u64);
            cache_key.bytes(?b, ?rec.key[0], 32);
            cache_key.bytes(?b, ?rec.placed[0], 32);
            cache_key.bytes(?b, rec.diags, rec.diags_len::usize);
            r = r + 1;
        }
    }
    var digest: [32]u8;
    val done:   err[fail.Fail] = cache_key.finish(?b, ?digest);
    if (sel done.err) { ret done; }
    ret query.set_input(?p.s.queries, ?DEMAND_RECORDS, 0, ?digest[0], 32);
}

# where the cell keeps its instance records: `<out>/.cache/instances`, none for a build without
# such a directory
fun records_path(p: *project.Project, scratch: *A.Allocator) res[opt[str], fail.Fail] {
    if (p.cache_dir == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val file: res[str, A.Error] = types_path.join(scratch, p.cache_dir, "instances");
    if (sel file.err) { ret res[opt[str], fail.Fail].err{fail.refused(file.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{file.ok}};
}

# the key an instance's record stands under: the configuration, the instance's symbol, and the
# surface for importers of each module it reads, its declaring module first. a surface folds the
# surfaces of what its module imports, so the key covers every typed surface the instance's
# typing reads (frontend.instance_deps). false when a module it reads is not keyed
pub fun instance_key(p: *project.Project, name: intern.StrId, reads: *module.ModuleId, count: usize, out: *[32]u8) res[bool, fail.Fail] {
    var b: cache_key.Builder = cache_key.begin("mach.instance-typing");
    cache_key.bytes(?b, ?p.cache_config[0], 32);
    cache_key.name(?b, ?p.s.interner, name);
    cache_key.number(?b, count::u64);
    var i: usize = 0;
    for (i < count) {
        if (module.is_nil(reads[i]) || reads[i]::u32 >= project.module_count(p)) { ret res[bool, fail.Fail].ok{false}; }
        val m: *project.ModuleEntry = project.module_at(p, reads[i]::u32);
        if (!m.cache_keyed) { ret res[bool, fail.Fail].ok{false}; }
        cache_key.bytes(?b, ?m.surface_digest[0], 32);
        i = i + 1;
    }
    val done: err[fail.Fail] = cache_key.finish(?b, out);
    if (sel done.err) { ret res[bool, fail.Fail].err{done.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# the module this load loaded under the name `fqn`, nil when none
fun loaded_module(p: *project.Project, fqn: intern.StrId) module.ModuleId {
    val stable: module.StableModuleId = module.stable_module_id_lookup(?p.s.modules, fqn);
    if (module.stable_is_nil(stable)) { ret module.MODULE_NIL; }
    val mid: module.ModuleId = module.module_id_for_stable(?p.s.modules, stable);
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret module.MODULE_NIL; }
    ret mid;
}

# read the cell's instance records and judge each: it stands when this load keys it as it was
# recorded, and its places stand when its declaring module's file places what its surface keeps
# where it did then
fun read_records(p: *project.Project) err[fail.Fail] {
    val located: res[opt[str], fail.Fail] = records_path(p, p.s.backing);
    if (sel located.err)     { ret err[fail.Fail].err{located.err}; }
    if (sel located.ok.none) { ret err[fail.Fail].ok{}; }
    val loaded: res[cache_instances.Store, fail.Fail] = cache_instances.load(p.alloc, ?p.s.interner, located.ok.some);
    str_free(p.s.backing, located.ok.some);
    if (sel loaded.err) { ret err[fail.Fail].err{loaded.err}; }
    cache_instances.dnit(?p.instance_records);
    p.instance_records = loaded.ok;
    val st:    *cache_instances.Store  = ?p.instance_records;
    var reads: Vector[module.ModuleId] = collections_vector.init[module.ModuleId](p.s.alloc);
    fin { collections_vector.dnit[module.ModuleId](?reads); }
    var r: usize = 0;
    for (r < st.records.len) {
        val rec: *cache_instances.Record = ?st.records.data[r];
        collections_vector.clear[module.ModuleId](?reads);
        var k: u32 = 0;
        for (k < rec.reads_count) {
            val mid: module.ModuleId = loaded_module(p, cache_instances.read_name(st, rec, k));
            cache_instances.set_read_id(st, rec, k, mid);
            val pushed: res[usize, A.Error] = collections_vector.push[module.ModuleId](?reads, mid);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            k = k + 1;
        }
        rec.origin_id = loaded_module(p, rec.origin);
        if (!module.is_nil(rec.origin_id) && reads.len > 0 && module.same(reads.data[0], rec.origin_id)) {
            var key:   [32]u8;
            val keyed: res[bool, fail.Fail] = instance_key(p, rec.name, reads.data, reads.len, ?key);
            if (sel keyed.err) { ret err[fail.Fail].err{keyed.err}; }
            val origin: *project.ModuleEntry = project.module_at(p, rec.origin_id::u32);
            rec.current    = keyed.ok && cache_key.equal(?key, ?rec.key);
            rec.positional = rec.current && cache_key.equal(?origin.placed_digest, ?rec.placed);
            rec.file       = origin.file_id;
        }
        r = r + 1;
    }
    ret err[fail.Fail].ok{};
}

# once per load, after the load walk and the embedded inputs, before anything
# is resolved: key every module, read each emitted module's `obj/` object
# under its key, mark the modules the front end skips and read the cell's
# instance records. config is the captured configuration identity. its items
# are reported under the readout phase ph
pub fun prepare(p: *project.Project, config: *u8, config_len: usize, ph: readout.Phase) err[fail.Fail] {
    val forgot: err[fail.Fail] = forget(p);
    if (sel forgot.err)                            { ret forgot; }
    if (!p.req.object_cache || !objects_cached(p)) { ret err[fail.Fail].ok{}; }
    val identified: err[fail.Fail] = identify(p, ph);
    if (sel identified.err)     { ret identified; }
    if (!identity_available(p)) { ret err[fail.Fail].ok{}; }
    val keyed: err[fail.Fail] = key_modules(p, p.s.backing, config, config_len, ph);
    if (sel keyed.err) {
        val dropped: err[fail.Fail] = forget(p);
        ret keyed;
    }
    p.cache_ready = true;
    val published: err[fail.Fail] = publish_keys(p);
    if (sel published.err) { ret published; }
    val err_written: err[fail.Fail] = read_written(p);
    if (sel err_written.err) { ret err_written; }
    val fresh_r: res[*bool, A.Error] = A.zallocate[bool](p.s.backing, p.emit_len::usize + 1);
    if (sel fresh_r.err) { ret err[fail.Fail].err{fail.refused(fresh_r.err)}; }
    val fresh: *bool = fresh_r.ok;
    fin { A.deallocate[bool](p.s.backing, fresh, p.emit_len::usize + 1); }
    val tested_r: res[*bool, A.Error] = A.zallocate[bool](p.s.backing, p.emit_len::usize + 1);
    if (sel tested_r.err) { ret err[fail.Fail].err{fail.refused(tested_r.err)}; }
    val fresh_test: *bool = tested_r.ok;
    fin { A.deallocate[bool](p.s.backing, fresh_test, p.emit_len::usize + 1); }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.cache_keyed) {
            # a hit this project already holds reported its warnings then
            fresh[i] = !(m.cache_checked && m.cache_hit && cache_key.equal(?m.cache_under, ?m.cache_key));
            # one item per module restored, its test object's restore included
            val t_restore: readout.Instant      = readout.item_begin(p.progress);
            val found:     res[bool, fail.Fail] = restore(p, m);
            if (sel found.err) { ret err[fail.Fail].err{found.err}; }
            var restored: bool = found.ok;
            if (has_test_object(p, m)) {
                fresh_test[i] = !test_restored(p, m);
                val tested: res[bool, fail.Fail] = restore_test(p, m);
                if (sel tested.err) { ret err[fail.Fail].err{tested.err}; }
                restored = restored || tested.ok;
            }
            if (restored) { readout.item(p.progress, ph, intern.text(?p.s.interner, m.fqn), t_restore); }
        }
        or {
            project.release_staged(p, m);
            project.release_staged_test(p, m);
        }
        i = i + 1;
    }
    val marked: err[fail.Fail] = mark_skipped(p, p.s.backing);
    if (sel marked.err) { ret marked; }
    # the same source reports the same warnings whether it compiled or not: a restored object's
    # back half's here, and a skipped front end's from what mark_skipped held
    i = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (fresh[i] && restored(p, m)) {
            val replayed: err[fail.Fail] = replay_warnings(p, m, true);
            if (sel replayed.err) { ret replayed; }
        }
        if (fresh_test[i] && test_restored(p, m)) {
            val replayed_test: err[fail.Fail] = replay_facts(p, ?m.test.staged_facts, true);
            if (sel replayed_test.err) { ret replayed_test; }
        }
        i = i + 1;
    }
    val read: err[fail.Fail] = read_records(p);
    if (sel read.err) { ret read; }
    ret publish_records(p);
}

# hand the staged object to the query that publishes it; the facts stay with the module
pub fun take_staged(p: *project.Project, m: *project.ModuleEntry) *Object {
    val o: *Object = m.staged;
    m.staged = nil;
    ret o;
}

pub fun take_staged_test(p: *project.Project, m: *project.ModuleEntry) *Object {
    val o: *Object = m.test.staged;
    m.test.staged = nil;
    ret o;
}

# a module's tests, from its lowered test unit or from the facts its restored test object carries
pub fun collect_tests(p: *project.Project, m: *project.ModuleEntry, mid: u32, c: *testrunner.Collected) err[fail.Fail] {
    if (m.test.unit != nil) { ret testrunner.collect_module(p.s, c, m.test.unit, mid); }
    var i: u32 = 0;
    for (i < m.test.staged_facts.test_count) {
        val f:      *cache_record.TestFact = ?m.test.staged_facts.tests[i];
        val pushed: err[fail.Fail]         = testrunner.push(p.s, c, testrunner.Test{name: f.name, line: f.line, mod_idx: mid});
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module's warnings travel in its record as the stores its products
# reported, each prefixed with whether its back half (lowering or codegen)
# reported it and written as `diagnostic.encode` writes a store

# the session's files named by path, as a recorded store names them
pub fun source_table(p: *project.Project) diagnostic.SourceTable {
    ret diagnostic.SourceTable{ctx: p::ptr, path_of: recorded_path, file_at: recorded_file};
}

fun recorded_path(ctx: ptr, file: lang_source.FileId) str {
    val p:     *project.Project             = ctx::*project.Project;
    val found: opt[*lang_source.SourceFile] = lang_source.get(p.s.sources, file);
    if (sel found.some) { ret found.some.path; }
    ret nil;
}

fun recorded_file(ctx: ptr, path: str) res[lang_source.FileId, fail.Fail] {
    val p: *project.Project = ctx::*project.Project;
    ret res[lang_source.FileId, fail.Fail].ok{lang_source.find(p.s.sources, path)};
}

# the walk enters only the products of the object's own owner, the module or the instance unit
# its kind and key name: another module's warnings belong to its own object, and acyclic imports
# mean none of them leads back to this owner's products
fun warning_enter(raw: ptr, product: query.QueryKey) bool {
    val sink: *WarningSink = raw::*WarningSink;
    ret product.kind.owner == sink.owner && product.key == sink.key;
}

# the warnings a product kept; a product that kept no store has none
fun warning_visit(raw: ptr, product: query.QueryKey, store: *diagnostic.DiagnosticStore) {
    val sink: *WarningSink = raw::*WarningSink;
    if (store == nil) { ret; }
    put_warnings(sink.w, sink.p, store, product.kind.replay);
}

# a product store's warnings: the cache records a module only when it built,
# so its stores hold no error
fun put_warnings(w: *wire.Sink, p: *project.Project, store: *diagnostic.DiagnosticStore, back: bool) {
    if (diagnostic.len(store) == 0) { ret; }
    var phase: u8 = 0;
    if (back) { phase = 1; }
    wire.put_u8(w, phase);
    var sources: diagnostic.SourceTable = source_table(p);
    diagnostic.encode(w, store, ?sources);
}

# where a product walk records an object's warnings
rec WarningSink {
    w:     *wire.Sink;
    p:     *project.Project;
    owner: query.KeyOwner;
    key:   u64;
}

# the warnings an object's record carries: those of every product the object was built from that
# belongs to it, keyed by the object's owner under the object's own key. a test object's key carries
# the test bit, so its record leaves the front end's warnings to the normal object's
fun gather_warnings(p: *project.Project, object: query.QueryKey, scratch: *A.Allocator, facts: *cache_record.Facts) err[fail.Fail] {
    var w: wire.Sink = wire.grown(scratch);
    fin { wire.dnit(?w); }
    var sink:   WarningSink    = WarningSink{w: ?w, p: p, owner: object.kind.owner, key: object.key};
    val walked: err[fail.Fail] = query.walk_products(?p.s.queries, object, (?sink)::ptr, warning_enter, warning_visit);
    if (sel walked.err)     { ret walked; }
    if (w.failed)           { ret err[fail.Fail].err{fail.message("out of memory recording a module's warnings")}; }
    if (w.len == 0)         { ret err[fail.Fail].ok{}; }
    if (w.len > 0xFFFFFFF0) { ret err[fail.Fail].err{fail.message("a module's warnings exceed the cache record")}; }
    val len:  usize               = w.len;
    val kept: res[*u8, fail.Fail] = wire.release(?w);
    if (sel kept.err) { ret err[fail.Fail].err{kept.err}; }
    facts.warnings     = kept.ok;
    facts.warnings_len = len::u32;
    ret err[fail.Fail].ok{};
}

# report a restored module's recorded warnings again; with back_only, only
# those of its back half, since its front end ran and reported the rest
fun replay_warnings(p: *project.Project, m: *project.ModuleEntry, back_only: bool) err[fail.Fail] {
    ret replay_facts(p, ?m.staged_facts, back_only);
}

fun replay_facts(p: *project.Project, facts: *cache_record.Facts, back_only: bool) err[fail.Fail] {
    var which: u8 = PHASE_FRONT | PHASE_BACK;
    if (back_only) { which = PHASE_BACK; }
    var back_seen: bool                 = false;
    val read:      res[bool, fail.Fail] = read_warnings(p, facts, which, ?p.diags, ?back_seen);
    if (sel read.err) { ret err[fail.Fail].err{read.err}; }
    ret err[fail.Fail].ok{};
}

# a record names the source its back half's warnings are placed in, and none when it holds none,
# so a record of no such warning is the same under every source its object's key admits
fun place_warnings(p: *project.Project, facts: *cache_record.Facts) err[fail.Fail] {
    val warned: res[bool, fail.Fail] = back_warned(p, facts);
    if (sel warned.err) { ret err[fail.Fail].err{warned.err}; }
    if (!warned.ok) {
        var none: [32]u8;
        facts.source = none;
    }
    ret err[fail.Fail].ok{};
}

# the object's back half reported a warning: lowering or generating it again
# would report it where the current source puts it
fun back_warned(p: *project.Project, facts: *cache_record.Facts) res[bool, fail.Fail] {
    var back_seen: bool                 = false;
    val read:      res[bool, fail.Fail] = read_warnings(p, facts, PHASE_BACK, nil, ?back_seen);
    if (sel read.err) { ret read; }
    ret res[bool, fail.Fail].ok{back_seen};
}

# the halves of an object's build its recorded warnings come from: the front end, and the back
# half (lowering or codegen)
val PHASE_FRONT: u8 = 1;
val PHASE_BACK:  u8 = 2;

# read the recorded stores, reporting into `into` each of the halves `which` names, or none when
# `into` is nil and the read is only a scan; back_seen is set when a back-half store holds a
# warning. a malformed record ends the read where it stands
fun read_warnings(p: *project.Project, facts: *cache_record.Facts, which: u8, into: *diagnostic.DiagnosticStore, back_seen: *bool) res[bool, fail.Fail] {
    if (facts.warnings_len == 0) { ret res[bool, fail.Fail].ok{true}; }
    var r:       wire.Source            = wire.source(facts.warnings, facts.warnings_len::usize);
    var sources: diagnostic.SourceTable = source_table(p);
    for (wire.remaining(?r) > 0) {
        val back: bool = wire.take_u8(?r) != 0;
        var half: u8   = PHASE_FRONT;
        if (back) { half = PHASE_BACK; }
        var read: diagnostic.DiagnosticStore = diagnostic.store_init(p.diags.a);
        val got:  res[bool, fail.Fail]       = diagnostic.decode(?r, ?sources, ?read);
        var kept: err[fail.Fail]             = err[fail.Fail].ok{};
        if (sel got.ok && back && diagnostic.len(?read) > 0)  { @back_seen = true; }
        if (sel got.ok && into != nil && (which & half) != 0) { kept = diagnostic.replay_into(into, ?read); }
        diagnostic.store_dnit(?read);
        if (sel got.err)  { ret got; }
        if (sel kept.err) { ret res[bool, fail.Fail].err{kept.err}; }
        if (!got.ok)      { brk; }
    }
    ret res[bool, fail.Fail].ok{true};
}

fun gather_facts(scratch: *A.Allocator, u: *lower_context.Unit, facts: *cache_record.Facts) err[fail.Fail] {
    var tests: u32   = 0;
    var i:     usize = 0;
    for (i < u.fns.len) {
        if (u.fns.data[i].test) { tests = tests + 1; }
        i = i + 1;
    }
    if (tests == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*cache_record.TestFact, A.Error] = A.allocate[cache_record.TestFact](scratch, tests::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    facts.tests      = allocated.ok;
    facts.test_count = tests;
    var n: u32 = 0;
    i = 0;
    for (i < u.fns.len) {
        val f: *lower_context.FnInfo = ?u.fns.data[i];
        if (f.test) {
            facts.tests[n] = cache_record.TestFact{name: f.name, line: f.line};
            n              = n + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a generated object carries its record into `obj/`: its key, the source it was built from, its
# warnings, and what its lowering kept: the instances its code asks for and, for a module that
# declares tests, the symbols it defines, which its test object declares
pub fun publish(p: *project.Project, m: *project.ModuleEntry, o: *Object, asked: *cache_record.Asked, asked_count: u32,
    defined: *intern.StrId, defined_count: u32, object: query.QueryKey) err[fail.Fail] {
    if (!p.cache_ready || !m.cache_keyed || restored(p, m)) { ret err[fail.Fail].ok{}; }
    var digest: [32]u8;
    val keyed:  err[fail.Fail] = object_key(p, m, ?digest);
    if (sel keyed.err) { ret keyed; }
    var facts:     cache_record.Facts = cache_record.Facts{source: m.source_digest, asked: asked, asked_count: asked_count, defined: defined, defined_count: defined_count};
    val published: err[fail.Fail]     = publish_record(p, m.unit, object, ?digest, ?facts, ?m.record);
    # the instances and the symbols stay the codegen product's
    facts.asked         = nil;
    facts.asked_count   = 0;
    facts.defined       = nil;
    facts.defined_count = 0;
    cache_record.facts_dnit(p.s.backing, ?facts);
    ret published;
}

# the same for the module's test object, which records only its own back half's warnings:
# the normal object carries the front end's
pub fun publish_test(p: *project.Project, m: *project.ModuleEntry, o: *Object, object: query.QueryKey) err[fail.Fail] {
    if (!p.cache_ready || !m.cache_keyed || test_restored(p, m)) { ret err[fail.Fail].ok{}; }
    var digest: [32]u8;
    val keyed:  err[fail.Fail] = test_object_key(p, m, ?digest);
    if (sel keyed.err) { ret keyed; }
    var facts: cache_record.Facts = cache_record.Facts{source: m.source_digest};
    fin { cache_record.facts_dnit(p.s.backing, ?facts); }
    ret publish_record(p, m.test.unit, object, ?digest, ?facts, ?m.test.record);
}

# the record of an object built under `digest`: `facts` gains the tests of its lowered unit and
# the warnings building it reported, and the record waits in `into` until the object is written
fun publish_record(p: *project.Project, u: *lower_context.Unit, object: query.QueryKey, digest: *[32]u8,
    facts: *cache_record.Facts, into: *project.Record) err[fail.Fail] {
    if (u == nil) { ret err[fail.Fail].err{fail.message("cache publication requires the module's lowered unit")}; }
    val gathered: err[fail.Fail] = gather_facts(p.s.backing, u, facts);
    if (sel gathered.err) { ret gathered; }
    val warned: err[fail.Fail] = gather_warnings(p, object, p.s.backing, facts);
    if (sel warned.err) { ret warned; }
    val placed: err[fail.Fail] = place_warnings(p, facts);
    if (sel placed.err) { ret placed; }
    var bytes:   *u8            = nil;
    var len:     u32            = 0;
    val encoded: err[fail.Fail] = cache_record.encode(p.s.alloc, ?p.s.interner, digest, facts, ?bytes, ?len);
    if (sel encoded.err) { ret encoded; }
    project.record_release(p, into);
    into.bytes = bytes;
    into.len   = len;
    ret err[fail.Fail].ok{};
}

# the key an instance unit's object is built under, keyed by the unit's query key: the
# persistent key's in-process image, as OBJECT_KEY is a module's
pub val UNIT_OBJECT_KEY: query.Kind = query.Kind{name: "unit object key", role: query.INPUT, owner: query.KEY_UNIT};

# an instance unit's key as its members are added
pub rec UnitKeying {
    b:     cache_key.Builder;
    keyed: bool;
}

# begin the key of the unit named `name`: the configuration every key of this load shares and
# the unit's name. a load that keyed nothing keys no unit
pub fun unit_begin(p: *project.Project, name: intern.StrId) UnitKeying {
    var k: UnitKeying = UnitKeying{b: cache_key.begin("mach.unit-object"), keyed: p.cache_ready};
    cache_key.bytes(?k.b, ?p.cache_config[0], 32);
    cache_key.name(?k.b, ?p.s.interner, name);
    ret k;
}

# add the member named `name`, reading the modules `reads` holds, its declaring module first:
# their surfaces for importers cover what its typing and lowering read of them, transitively. a
# member reading a module this load did not key leaves the unit unkeyed
pub fun unit_member(p: *project.Project, k: *UnitKeying, name: intern.StrId, reads: *module.ModuleId, count: usize) {
    cache_key.name(?k.b, ?p.s.interner, name);
    cache_key.number(?k.b, count::u64);
    var i: usize = 0;
    for (i < count) {
        val m: *project.ModuleEntry = project.module_at(p, reads[i]::u32);
        if (!m.cache_keyed) { k.keyed = false; }
        cache_key.bytes(?k.b, ?m.surface_digest[0], 32);
        i = i + 1;
    }
}

# finish the unit's key into `u`, and publish it for the unit's codegen product
pub fun unit_finish(p: *project.Project, k: *UnitKeying, u: *project.InstanceUnit) err[fail.Fail] {
    u.keyed = false;
    if (!k.keyed) { ret err[fail.Fail].ok{}; }
    val done: err[fail.Fail] = cache_key.finish(?k.b, ?u.object_key);
    if (sel done.err) { ret done; }
    u.keyed = true;
    ret query.set_input(?p.s.queries, ?UNIT_OBJECT_KEY, u.key, ?u.object_key[0], 32);
}

# read unit u's object at `location` under its key; a hit is staged for its codegen product and
# its back half's warnings are reported again. its recorded warnings stand for the origin's
# source they were reported in, as a module's do
pub fun restore_unit(p: *project.Project, u: *project.InstanceUnit, location: str) res[bool, fail.Fail] {
    u.hit = false;
    if (!u.keyed || !early_restore_enabled(p)) { ret res[bool, fail.Fail].ok{false}; }
    val found: res[opt[Cached], fail.Fail] = read(p, location, ?u.object_key);
    if (sel found.err) { ret res[bool, fail.Fail].err{found.err}; }
    if (sel found.ok.none) {
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    var cached: Cached = found.ok.some;
    var handed: bool   = false;
    fin {
        if (!handed) {
            cache_record.facts_dnit(p.s.alloc, ?cached.facts);
            backend.release_object(?cached.object);
        }
    }
    val origin: *project.ModuleEntry = project.module_at(p, u.origin::u32);
    val stand:  res[bool, fail.Fail] = warnings_stand(p, origin.source_digest, ?cached.facts);
    if (sel stand.err) { ret stand; }
    if (!stand.ok) {
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    val replayed: err[fail.Fail] = replay_facts(p, ?cached.facts, true);
    if (sel replayed.err) { ret res[bool, fail.Fail].err{replayed.err}; }
    val boxed: res[*Object, A.Error] = A.allocate[Object](p.s.alloc, 1);
    if (sel boxed.err) { ret res[bool, fail.Fail].err{fail.refused(boxed.err)}; }
    @boxed.ok      = cached.object;
    handed         = true;
    u.staged       = boxed.ok;
    u.staged_facts = cached.facts;
    u.hit          = true;
    p.cache_hits   = p.cache_hits + 1;
    ret res[bool, fail.Fail].ok{true};
}

# hand unit u's staged object to the product that publishes it
pub fun take_staged_unit(u: *project.InstanceUnit) *Object {
    val o: *Object = u.staged;
    u.staged = nil;
    ret o;
}

# a compiled unit's object carries its record into `obj/`: its key and the warnings its own
# codegen product reported, which are its lowering's and its back end's
pub fun publish_unit(p: *project.Project, u: *project.InstanceUnit, object: query.QueryKey) err[fail.Fail] {
    if (!u.keyed || u.hit) { ret err[fail.Fail].ok{}; }
    var facts: cache_record.Facts = cache_record.Facts{source: project.module_at(p, u.origin::u32).source_digest};
    fin { cache_record.facts_dnit(p.s.backing, ?facts); }
    val warned: err[fail.Fail] = gather_warnings(p, object, p.s.backing, ?facts);
    if (sel warned.err) { ret warned; }
    val placed: err[fail.Fail] = place_warnings(p, ?facts);
    if (sel placed.err) { ret placed; }
    var bytes:   *u8            = nil;
    var len:     u32            = 0;
    val encoded: err[fail.Fail] = cache_record.encode(p.s.alloc, ?p.s.interner, ?u.object_key, ?facts, ?bytes, ?len);
    if (sel encoded.err) { ret encoded; }
    project.record_release(p, ?u.record);
    u.record.bytes = bytes;
    u.record.len   = len;
    ret err[fail.Fail].ok{};
}

# the instance units the build compiles rather than restores
pub fun units_compiled(p: *project.Project) u32 {
    var n: u32   = 0;
    var i: usize = 0;
    for (i < p.units.len) {
        if (!p.units.data[i].hit) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the cell's instance records after a demand settled: each instance of its closure keeps the
# record this build made of it, or else the one that stood in for its typing, and an instance the
# closure no longer holds drops out. a store that would hold what it holds is left as it is
pub fun store_records(p: *project.Project, d: *demand.Demand) err[fail.Fail] {
    if (!p.cache_ready) { ret err[fail.Fail].ok{}; }
    val located: res[opt[str], fail.Fail] = records_path(p, p.s.backing);
    if (sel located.err)     { ret err[fail.Fail].err{located.err}; }
    if (sel located.ok.none) { ret err[fail.Fail].ok{}; }
    val file: str = located.ok.some;
    fin { str_free(p.s.backing, file); }
    var out: cache_instances.Store = cache_instances.init(p.s.backing);
    fin { cache_instances.dnit(?out); }
    var changed: bool  = false;
    var kept:    usize = 0;
    var i:       usize = 0;
    for (i < d.entries.len) {
        val e:     *demand.Entry = ?d.entries.data[i];
        val fresh: u32           = cache_instances.find(?d.fresh, e.name);
        if (fresh != cache_instances.NONE) {
            val copied: res[u32, fail.Fail] = cache_instances.copy(?out, ?d.fresh, fresh);
            if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
            changed = true;
        }
        or (e.record != cache_instances.NONE) {
            val copied: res[u32, fail.Fail] = cache_instances.copy(?out, ?p.instance_records, e.record);
            if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
            kept = kept + 1;
        }
        i = i + 1;
    }
    if (!changed && kept == p.instance_records.records.len) { ret err[fail.Fail].ok{}; }
    ret cache_instances.store(?out, ?p.s.interner, p.out_dir, file);
}

# where the cell keeps its link records: `<out>/.cache/link`, none for a build without such a
# directory
fun link_records_path(p: *project.Project, scratch: *A.Allocator) res[opt[str], fail.Fail] {
    if (p.cache_dir == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val res_join: res[str, A.Error] = types_path.join(scratch, p.cache_dir, "link");
    if (sel res_join.err) { ret res[opt[str], fail.Fail].err{fail.refused(res_join.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{res_join.ok}};
}

# the key of the link this build runs: the configuration (the compiler's identity among it, and
# so the linker's), the link configuration the build published, and the key of every object the
# link takes, in its order: each emitted module's, its test object's when the build links tests,
# then each instance unit's. false when an object is not keyed, or the link takes an input found
# by name, whose file the key cannot cover
fun link_key(p: *project.Project, out: *[32]u8) res[bool, fail.Fail] {
    if (!p.cache_ready || !p.link_config_keyed || p.link_by_name) { ret res[bool, fail.Fail].ok{false}; }
    var b: cache_key.Builder = cache_key.begin("mach.link-image");
    cache_key.bytes(?b, ?p.cache_config[0], 32);
    cache_key.bytes(?b, ?p.link_config[0], 32);
    cache_key.number(?b, p.emit_len::u64);
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (!m.cache_keyed) { ret res[bool, fail.Fail].ok{false}; }
        var object:     [32]u8;
        val err_object: err[fail.Fail] = object_key(p, m, ?object);
        if (sel err_object.err) { ret res[bool, fail.Fail].err{err_object.err}; }
        cache_key.bytes(?b, ?object[0], 32);
        val tested: bool = has_test_object(p, m);
        cache_key.number(?b, tested::u64);
        if (tested) {
            var test:     [32]u8;
            val err_test: err[fail.Fail] = test_object_key(p, m, ?test);
            if (sel err_test.err) { ret res[bool, fail.Fail].err{err_test.err}; }
            cache_key.bytes(?b, ?test[0], 32);
        }
        i = i + 1;
    }
    cache_key.number(?b, p.units.len::u64);
    var u: usize = 0;
    for (u < p.units.len) {
        val unit: *project.InstanceUnit = ?p.units.data[u];
        if (!unit.keyed) { ret res[bool, fail.Fail].ok{false}; }
        cache_key.bytes(?b, ?unit.object_key[0], 32);
        u = u + 1;
    }
    val err_finish: err[fail.Fail] = cache_key.finish(?b, out);
    if (sel err_finish.err) { ret res[bool, fail.Fail].err{err_finish.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# every object the link takes was restored, none compiled by this build
fun compiled_nothing(p: *project.Project) bool {
    if (generated_count(p) != 0 || units_compiled(p) != 0) { ret false; }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (has_test_object(p, m) && !test_restored(p, m)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the link records of the cell and the canonical path of `artifact`, which names its record
rec LinkRecords {
    store: cache_link.Store;
    path:  str;
    file:  opt[str];
}

fun link_records(p: *project.Project, artifact: str) res[LinkRecords, fail.Fail] {
    val res_cwd: res[OwnedString, fail.Fail] = current_dir(p.s.backing);
    if (sel res_cwd.err) { ret res[LinkRecords, fail.Fail].err{res_cwd.err}; }
    var cwd: OwnedString = res_cwd.ok;
    fin { owned_release(?cwd); }
    val res_canon: res[str, fail.Fail] = canonical(p.s.backing, cwd.data, artifact);
    if (sel res_canon.err) { ret res[LinkRecords, fail.Fail].err{res_canon.err}; }
    val res_file: res[opt[str], fail.Fail] = link_records_path(p, p.s.backing);
    if (sel res_file.err) {
        str_free(p.s.backing, res_canon.ok);
        ret res[LinkRecords, fail.Fail].err{res_file.err};
    }
    var records: LinkRecords = LinkRecords{store: cache_link.init(p.s.backing), path: res_canon.ok, file: res_file.ok};
    if (sel res_file.ok.some) {
        val res_load: res[cache_link.Store, A.Error] = cache_link.load(p.s.backing, res_file.ok.some);
        if (sel res_load.err) {
            link_records_dnit(p, ?records);
            ret res[LinkRecords, fail.Fail].err{fail.refused(res_load.err)};
        }
        cache_link.dnit(?records.store);
        records.store = res_load.ok;
    }
    ret res[LinkRecords, fail.Fail].ok{records};
}

fun link_records_dnit(p: *project.Project, records: *LinkRecords) {
    cache_link.dnit(?records.store);
    str_free(p.s.backing, records.path);
    if (sel records.file.some) { str_free(p.s.backing, records.file.some); }
}

# the key of the link `key` names that read the files `files` beyond its keyed inputs: each file by
# its path and the digest of its bytes, read and hashed now. false when a file cannot be read
fun read_key(key: *[32]u8, files: *Vector[str], out: *[32]u8) res[bool, fail.Fail] {
    var b: cache_key.Builder = cache_key.begin("mach.link-read");
    cache_key.bytes(?b, key::*u8, 32);
    cache_key.number(?b, files.len::u64);
    var i: usize = 0;
    for (i < files.len) {
        var digest:     [32]u8;
        val err_digest: err[fail.Cause] = lang_fingerprint.file_sha256(files.data[i], ?digest[0]);
        if (sel err_digest.err) { ret res[bool, fail.Fail].ok{false}; }
        cache_key.text(?b, files.data[i]);
        cache_key.bytes(?b, ?digest[0], 32);
        i = i + 1;
    }
    val err_finish: err[fail.Fail] = cache_key.finish(?b, out);
    if (sel err_finish.err) { ret res[bool, fail.Fail].err{err_finish.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# the link that would write `artifact` need not run: this build compiled nothing, the link reads
# no input found by name and its last run read no file a search found, its key and the files that
# run read beyond its keyed inputs key it as the record of the artifact's path does, and the file
# there hashes to the digest that record holds. every file is read and hashed every time, never
# trusted from its metadata
pub fun link_stands(p: *project.Project, artifact: str) res[bool, fail.Fail] {
    if (!compiled_nothing(p)) { ret res[bool, fail.Fail].ok{false}; }
    var key:       [32]u8;
    val res_keyed: res[bool, fail.Fail] = link_key(p, ?key);
    if (sel res_keyed.err) { ret res_keyed; }
    if (!res_keyed.ok)     { ret res[bool, fail.Fail].ok{false}; }
    val res_records: res[LinkRecords, fail.Fail] = link_records(p, artifact);
    if (sel res_records.err) { ret res[bool, fail.Fail].err{res_records.err}; }
    var records: LinkRecords = res_records.ok;
    fin { link_records_dnit(p, ?records); }
    val opt_written: opt[cache_link.Written] = cache_link.written(?records.store, records.path);
    if (sel opt_written.none) { ret res[bool, fail.Fail].ok{false}; }
    var written: cache_link.Written = opt_written.some;
    if (written.searched) { ret res[bool, fail.Fail].ok{false}; }
    var read:     [32]u8;
    val res_read: res[bool, fail.Fail] = read_key(?key, ?written.files, ?read);
    if (sel res_read.err)                                      { ret res_read; }
    if (!res_read.ok || !cache_key.equal(?written.key, ?read)) { ret res[bool, fail.Fail].ok{false}; }
    var now:        [32]u8;
    val err_digest: err[fail.Cause] = lang_fingerprint.file_sha256(artifact, ?now[0]);
    if (sel err_digest.err) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{cache_key.equal(?now, ?written.digest)};
}

# the link that wrote `artifact` as the bytes `digest` names, having read `read`, is recorded under
# its key and the files it read, so a later build that compiles nothing, keys its link the same and
# finds those files holding the same bytes leaves the artifact as it is. a link that read a file a
# search found is recorded as one that always runs
pub fun note_link(p: *project.Project, artifact: str, digest: *[32]u8, read: *backend.LinkRead) err[fail.Fail] {
    var key:       [32]u8;
    val res_keyed: res[bool, fail.Fail] = link_key(p, ?key);
    if (sel res_keyed.err) { ret err[fail.Fail].err{res_keyed.err}; }
    if (!res_keyed.ok)     { ret err[fail.Fail].ok{}; }
    val res_records: res[LinkRecords, fail.Fail] = link_records(p, artifact);
    if (sel res_records.err) { ret err[fail.Fail].err{res_records.err}; }
    var records: LinkRecords = res_records.ok;
    fin { link_records_dnit(p, ?records); }
    if (sel records.file.none) { ret err[fail.Fail].ok{}; }
    var keyed:    [32]u8;
    val res_read: res[bool, fail.Fail] = read_key(?key, ?read.files, ?keyed);
    if (sel res_read.err) { ret err[fail.Fail].err{res_read.err}; }
    var written: cache_link.Written = cache_link.Written{key: keyed, digest: @digest, searched: read.searched || !res_read.ok, files: read.files};
    val err_put: err[A.Error]       = cache_link.put(?records.store, records.path, ?written);
    if (sel err_put.err) { ret err[fail.Fail].err{fail.refused(err_put.err)}; }
    ret cache_link.store(?records.store, p.out_dir, records.file.some);
}
