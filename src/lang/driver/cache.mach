use mach.lang.build.cache.key;
use mach.lang.build.request;
use mach.lang.driver.project;
use mach.lang.embed;
use mach.lang.fail;
use mach.lang.fe.sema;
use mach.lang.intern;
use mach.lang.source;
use A: std.allocator;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.OwnedString;
use std.types.string.owned_release;
use std.types.string.str;
use std.types.string.str_len;

# a path as the filesystem would name it from this process: absolute and
# lexically clean, so `mach build .` and `mach build /abs/project` agree
fun canonical(scratch: *A.Allocator, cwd: str, spelled: str) res[str, fail.Fail] {
    val absolute: res[str, A.Error] = path.resolve(scratch, cwd, spelled);
    if (sel absolute.err) { ret res[str, fail.Fail].err{fail.refused(absolute.err)}; }
    val joined: str = absolute.ok;
    fin { str_free(scratch, joined); }
    val cleaned: res[str, A.Error] = path.clean(scratch, joined);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

# the key holds every path in canonical form; the spelling is added only when
# debug information is requested, because then it reaches the line tables and
# two spellings really do produce two objects
fun key_path(b: *key.Builder, scratch: *A.Allocator, cwd: str, spelled: str, spelling_matters: bool) err[fail.Fail] {
    val canon: res[str, fail.Fail] = canonical(scratch, cwd, spelled);
    if (sel canon.err) { ret err[fail.Fail].err{canon.err}; }
    key.text(b, canon.ok);
    str_free(scratch, canon.ok);
    if (spelling_matters) { key.text(b, spelled); }
    or                    { key.text(b, nil); }
    ret err[fail.Fail].ok{};
}

# hash the whole active build cell because generic instantiations can cross import direction
pub fun snapshot(scratch: *A.Allocator, p: *project.Project, config: *u8, config_len: usize,
    compiler_id: *compiler.Identity, digest: *[32]u8) err[fail.Fail] {
    if (scratch == nil || p == nil || p.s == nil || compiler_id == nil || digest == nil
        || compiler_id.len == 0 || compiler_id.len > 32) {
        ret err[fail.Fail].err{fail.message("cache snapshot requires a project and compiler identity")};
    }
    val cwd_r: res[OwnedString, env.EnvError] = env.current_dir(scratch);
    if (sel cwd_r.err) { ret err[fail.Fail].err{fail.message("cache snapshot cannot read the current directory")}; }
    var cwd_owned: OwnedString = cwd_r.ok;
    fin { owned_release(?cwd_owned); }
    val cwd:              str         = cwd_owned.data;
    val spelling_matters: bool        = p.req.debug;
    var b:                key.Builder = key.begin("mach.compilation-cell");
    key.number(?b, compiler_id.source::u64);
    key.bytes(?b, ?compiler_id.bytes[0], compiler_id.len);
    key.bytes(?b, config, config_len);
    key.name(?b, ?p.s.interner, p.compiler_name);
    key.name(?b, ?p.s.interner, p.compiler_ver);
    # the request names the project by its spelled root; the key names it canonically
    val canonical_root: res[str, fail.Fail] = canonical(scratch, cwd, p.req.project_root);
    if (sel canonical_root.err) { ret err[fail.Fail].err{canonical_root.err}; }
    var keyed_request: request.BuildRequest = p.req;
    keyed_request.project_root = canonical_root.ok;
    # listing tests lowers exactly what running them lowers and stops before
    # codegen, so it reads (and never publishes) the test build's entries
    if (keyed_request.goal == request.GOAL_TEST_LIST) { keyed_request.goal = request.GOAL_TESTS; }
    var request_digest: [32]u8;
    val requested:      err[outcome.Fail] = request.semantic_hash(scratch, ?keyed_request, ?request_digest[0]);
    str_free(scratch, canonical_root.ok);
    if (sel requested.err) { ret err[fail.Fail].err{fail.message(outcome.describe(requested.err))}; }
    key.bytes(?b, ?request_digest[0], 32);
    key.number(?b, p.req.placement_policy::u64);
    key.bytes(?b, ?p.step_digest[0], 32);
    key.name(?b, ?p.s.interner, p.config.module);
    key.name(?b, ?p.s.interner, p.config.dir_src);
    val root: opt[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (sel root.none) { ret err[fail.Fail].err{fail.message("cache snapshot has no project root")}; }
    val root_keyed: err[fail.Fail] = key_path(?b, scratch, cwd, root.some, spelling_matters);
    if (sel root_keyed.err) { ret root_keyed; }
    key.number(?b, p.roots::u64);
    key.number(?b, project.module_count(p)::u64);
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m:    *project.ModuleEntry    = project.module_at(p, i);
        val file: opt[*source.SourceFile] = source.get(?p.s.sources, m.file_id);
        if (sel file.none) { ret err[fail.Fail].err{fail.message("cache snapshot module has no current source")}; }
        val f: *source.SourceFile = file.some;
        if (!f.present || f.text == nil) { ret err[fail.Fail].err{fail.message("cache snapshot source is not present")}; }
        key.name(?b, ?p.s.interner, m.fqn);
        val file_keyed: err[fail.Fail] = key_path(?b, scratch, cwd, f.path, spelling_matters);
        if (sel file_keyed.err) { ret file_keyed; }
        key.bytes(?b, f.text, str_len(f.text));
        key.number(?b, m.dep_count::u64);
        var d: u32 = 0;
        for (d < m.dep_count) {
            val dependency: u32 = m.deps[d]::u32;
            if (dependency >= project.module_count(p)) { ret err[fail.Fail].err{fail.message("cache snapshot dependency is not loaded")}; }
            key.name(?b, ?p.s.interner, project.module_at(p, dependency).fqn);
            d = d + 1;
        }
        i = i + 1;
    }
    key.number(?b, p.emit_len::u64);
    i = 0;
    for (i < p.emit_len) {
        val mid: u32 = p.topo[i]::u32;
        if (mid >= project.module_count(p)) { ret err[fail.Fail].err{fail.message("cache snapshot emission order names an absent module")}; }
        key.name(?b, ?p.s.interner, project.module_at(p, mid).fqn);
        i = i + 1;
    }
    key.number(?b, p.config.dep_count::u64);
    i = 0;
    for (i < p.config.dep_count) {
        val d: *project.DepEntry = ?p.config.deps[i];
        key.name(?b, ?p.s.interner, d.alias);
        key.name(?b, ?p.s.interner, d.project_id);
        key.name(?b, ?p.s.interner, d.project_dir_src);
        key.name(?b, ?p.s.interner, d.project_module);
        val vendor: opt[str] = intern.lookup(?p.s.interner, d.vendor_root);
        if (sel vendor.none) { ret err[fail.Fail].err{fail.message("cache snapshot dependency has no vendor root")}; }
        val vendor_keyed: err[fail.Fail] = key_path(?b, scratch, cwd, vendor.some, spelling_matters);
        if (sel vendor_keyed.err) { ret vendor_keyed; }
        key.name(?b, ?p.s.interner, d.source);
        key.name(?b, ?p.s.interner, d.ref);
        key.name(?b, ?p.s.interner, d.content);
        key.name(?b, ?p.s.interner, d.manifest.version);
        key.number(?b, d.direct_count::u64);
        var n: u32 = 0;
        for (n < d.direct_count) {
            key.name(?b, ?p.s.interner, d.direct[n]);
            n = n + 1;
        }
        i = i + 1;
    }
    key.number(?b, p.topo_len::u64);
    i = 0;
    for (i < p.topo_len) {
        val mid: u32 = p.topo[i]::u32;
        if (mid >= project.module_count(p)) { ret err[fail.Fail].err{fail.message("cache snapshot names an absent typed module")}; }
        val typed: *sema.SemaResult = project.module_at(p, mid).sema_result;
        if (typed == nil) { ret err[fail.Fail].err{fail.message("cache snapshot module has no current typed owner")}; }
        key.name(?b, ?p.s.interner, project.module_at(p, mid).fqn);
        key.number(?b, typed.embed_path_count::u64);
        var ei: u32 = 0;
        for (ei < typed.embed_path_count) {
            val found: opt[*embed.EmbedFile] = embed.get(?p.s.embeds, typed.embed_paths[ei]);
            if (sel found.none) { ret err[fail.Fail].err{fail.message("cache snapshot is missing an active embedded input")}; }
            val e: *embed.EmbedFile = found.some;
            if (e.status != embed.EMBED_OK) { ret err[fail.Fail].err{fail.message("cache snapshot contains an unavailable embedded input")}; }
            key.name(?b, ?p.s.interner, e.path);
            key.number(?b, e.len::u64);
            key.bytes(?b, ?e.digest[0], 32);
            ei = ei + 1;
        }
        i = i + 1;
    }
    key.number(?b, p.s.link_provider_len::u64);
    i = 0;
    for (i < p.s.link_provider_len) {
        key.name(?b, ?p.s.interner, p.s.link_providers[i].name);
        key.number(?b, p.s.link_providers[i].is_static::u64);
        i = i + 1;
    }
    ret key.finish(?b, digest);
}

use mach.lang.build.cache.compiler;
use cache_record: mach.lang.build.cache.record;
use mach.lang.build.outcome;
use mach.lang.me.ir;
use mach.lang.me.lower.testrunner;
use mach.lang.output;
use mach.lang.query;
use mach.lang.readout;
use mach.lang.session;
use mach.lang.target.isa;
use mach.lang.target.of;
use std.allocator.page;
use std.collections.vector;
use fs: std.filesystem;
use std.text.string.str_free;
use std.types.bool.true;
use std.types.path;

pub fun operation_active(p: *project.Project) bool {
    ret p != nil && p.s != nil && p.s.queries.operation_active
        && p.cache_operation_sequence != 0 && p.cache_operation_sequence == p.s.queries.operation_sequence;
}

# the compiler identity is a process constant: read once per project, reported
# under the readout phase ph that asked for it
pub fun identify(p: *project.Project, ph: u8) err[fail.Fail] {
    if (p.compiler_identity_initialized) { ret err[fail.Fail].ok{}; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret err[fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    val t_identity: readout.Instant     = readout.item_begin(p.events);
    val identified: err[compiler.Error] = compiler.identity(?backing, ?p.compiler_identity);
    if (sel identified.err) {
        val error: compiler.Error = identified.err;
        if (error.kind != compiler.UNAVAILABLE) { ret err[fail.Fail].err{fail.message(error.message)}; }
        readout.item(p.events, ph, "compiler identity unavailable", t_identity);
    }
    if (sel identified.ok) {
        p.compiler_identity_available = true;
        if (p.compiler_identity.source == compiler.SOURCE_BUILD_ID) {
            readout.item(p.events, ph, "compiler identity: build id", t_identity);
        }
        or { readout.item(p.events, ph, "compiler identity: image digest", t_identity); }
    }
    p.compiler_identity_initialized = true;
    ret err[fail.Fail].ok{};
}

pub fun identity_available(p: *project.Project) bool {
    ret p.compiler_identity_initialized && p.compiler_identity_available;
}

# once per query operation. snapshot is the cell digest the operation computed,
# nil when the cache is off or the compiler has no identity
pub fun prepare(p: *project.Project, snapshot: *[32]u8) err[fail.Fail] {
    if (!operation_active(p)) { ret err[fail.Fail].err{fail.message("cache preparation requires the current query operation")}; }
    if (p.cache_initialized)  { ret err[fail.Fail].ok{}; }
    p.cache_initialized = true;
    if (snapshot == nil || !p.req.object_cache) { ret err[fail.Fail].ok{}; }
    p.cache_snapshot = @snapshot;
    discard_stale(p);
    p.cache_ready = objects_cached(p);
    ret err[fail.Fail].ok{};
}

# `obj/` is the object cache when the build writes its modules there as
# relocatable objects the target's format reads back
fun objects_cached(p: *project.Project) bool {
    val vt: *of.OfVTable = p.target.of;
    ret p.object_dir != nil && vt != nil && !vt.produces_image
        && vt.emit_object != nil && vt.parse_object != nil;
}

# a module's cache verdict and staged product belong to the snapshot they were
# taken under; a new snapshot reads the object again
fun discard_stale(p: *project.Project) {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (m.cache_checked && !key.equal(?m.cache_under, ?p.cache_snapshot)) { project.release_staged(p, m); }
        i = i + 1;
    }
}

# where the build writes module m's object: `obj/<project>/<module path>.<ext>`
pub fun object_path(p: *project.Project, m: *project.ModuleEntry, a: *A.Allocator) res[str, fail.Fail] {
    if (p.object_dir == nil || p.target.of == nil) { ret res[str, fail.Fail].err{fail.message("the build has no object directory")}; }
    val fqn: opt[str] = intern.lookup(?p.s.interner, m.fqn);
    if (sel fqn.none) { ret res[str, fail.Fail].err{fail.message("module FQN not interned")}; }
    val named: res[str, outcome.Fail] = output.mirror_fqn(a, p.object_dir, fqn.some, p.target.of.object_ext);
    if (sel named.err) { ret res[str, fail.Fail].err{fail.message(outcome.describe(named.err))}; }
    ret res[str, fail.Fail].ok{named.ok};
}

# a module whose object is cached skips lowering when nothing else needs its
# ir: the ir and asm emitters read it, and a whole-module backend reads every
# referenced module's ir while generating one object
pub fun early_restore_enabled(p: *project.Project) bool {
    ret p.req.object_cache && !p.req.emit_ir && !p.req.emit_asm && !isa.emits_whole_module(p.target.isa);
}

# the module's codegen product is its cached object under the current
# snapshot, whether it is still staged or a query already took it: the module
# does not lower, and its object is already in `obj/`
pub fun restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret m.cache_hit && key.equal(?m.cache_under, ?p.cache_snapshot);
}

# restored and still staged, which is what the codegen query publishes
pub fun staged_restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret m.staged_image != nil && restored(p, m);
}

# an object read back from `obj/` with the facts its record carries
pub rec Cached {
    image: of.ObjectImage;
    facts: cache_record.Facts;
}

# the object at `location` when its record says it was built under `expected`,
# none on a miss: an object that is missing, unreadable, carries no record or
# a damaged one, or was built under another key is rebuilt, never reused.
# err only when allocation fails
pub fun read(p: *project.Project, location: str, expected: *[32]u8) res[opt[Cached], fail.Fail] {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret res[opt[Cached], fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    val loaded: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(?backing, location);
    if (sel loaded.err) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    var bytes: vector.Vector[u8] = loaded.ok;
    fin { vector.dnit[u8](?bytes); }
    var image:  of.ObjectImage = of.object_image_init(p.s.alloc, ?p.s.interner, intern.STR_NIL);
    val parsed: err[fail.Fail] = p.target.of.parse_object(p.s.alloc, ?p.s.interner, bytes.data, bytes.len, ?image);
    if (sel parsed.err) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    val decoded: res[opt[cache_record.Record], fail.Fail] = cache_record.decode(p.s.alloc, ?p.s.interner,
        image.cache_record, image.cache_record_len::usize);
    if (sel decoded.err) {
        of.object_image_dnit(?image);
        ret res[opt[Cached], fail.Fail].err{decoded.err};
    }
    if (sel decoded.ok.none) {
        of.object_image_dnit(?image);
        ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}};
    }
    var found: cache_record.Record = decoded.ok.some;
    if (!key.equal(?found.key, expected)) {
        cache_record.facts_dnit(p.s.alloc, ?found.facts);
        of.object_image_dnit(?image);
        ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}};
    }
    A.deallocate[u8](image.alloc, image.cache_record, image.cache_record_len::usize);
    image.cache_record     = nil;
    image.cache_record_len = 0;
    ret res[opt[Cached], fail.Fail].ok{opt[Cached].some{Cached{image: image, facts: found.facts}}};
}

# a hit is reported under the readout phase ph that asked for the module
pub fun restore(p: *project.Project, mid: session.ModuleId, ph: u8) res[bool, fail.Fail] {
    if (!operation_active(p)) { ret res[bool, fail.Fail].err{fail.message("cache restoration requires the current query operation")}; }
    val index: u32 = mid::u32;
    if (index >= project.module_count(p)) { ret res[bool, fail.Fail].err{fail.message("cache restore names an absent module")}; }
    val m: *project.ModuleEntry = project.module_at(p, index);
    if (!p.cache_ready || m.cache_checked) { ret res[bool, fail.Fail].ok{m.cache_hit}; }
    m.cache_checked = true;
    m.cache_under   = p.cache_snapshot;
    val t_restore: readout.Instant = readout.item_begin(p.events);
    var backing:   A.Allocator;
    val make_r:    err[A.Error]    = page.make(?backing);
    if (sel make_r.err) { ret res[bool, fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    var expected: [32]u8;
    val keyed:    err[fail.Fail] = key.object(?p.cache_snapshot, project.fqn_name(p, m.fqn), ?expected);
    if (sel keyed.err) { ret res[bool, fail.Fail].err{keyed.err}; }
    val located: res[str, fail.Fail] = object_path(p, m, ?backing);
    if (sel located.err) { ret res[bool, fail.Fail].err{located.err}; }
    val found: res[opt[Cached], fail.Fail] = read(p, located.ok, ?expected);
    str_free(?backing, located.ok);
    if (sel found.err) { ret res[bool, fail.Fail].err{found.err}; }
    if (sel found.ok.none) {
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    var cached: Cached                        = found.ok.some;
    val boxed:  res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](p.s.alloc, 1);
    if (sel boxed.err) {
        cache_record.facts_dnit(p.s.alloc, ?cached.facts);
        of.object_image_dnit(?cached.image);
        ret res[bool, fail.Fail].err{fail.refused(boxed.err)};
    }
    val box: *of.ObjectImage = boxed.ok;
    @box     = cached.image;
    box.name = m.fqn;
    cache_record.facts_dnit(p.s.alloc, ?m.staged_facts);
    m.staged_image = box;
    m.staged_facts = cached.facts;
    m.cache_hit    = true;
    p.cache_hits   = p.cache_hits + 1;
    readout.item(p.events, ph, "cached object", t_restore);
    ret res[bool, fail.Fail].ok{true};
}

# hand the staged image to the query that publishes it; the facts stay with the module
pub fun take_staged(p: *project.Project, m: *project.ModuleEntry) *of.ObjectImage {
    val image: *of.ObjectImage = m.staged_image;
    m.staged_image = nil;
    ret image;
}

# what the engine reads from lowered ir, answered from the ir when the module
# lowered and from the restored facts when it did not
pub fun scalarized(p: *project.Project, m: *project.ModuleEntry) u32 {
    if (m.ir_module != nil) { ret m.ir_module.vector_ops_scalarized; }
    ret m.staged_facts.scalarized;
}

pub fun collect_tests(p: *project.Project, m: *project.ModuleEntry, mid: u32, c: *testrunner.Collected) err[fail.Fail] {
    if (m.ir_module != nil) { ret testrunner.collect_module(p.s, c, m.ir_module, mid); }
    var i: u32 = 0;
    for (i < m.staged_facts.test_count) {
        val f:      *cache_record.TestFact = ?m.staged_facts.tests[i];
        val pushed: err[fail.Fail]         = testrunner.push(p.s, c, testrunner.Test{name: f.name, line: f.line, mod_idx: mid});
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun gather_facts(scratch: *A.Allocator, irmod: *ir.Module, facts: *cache_record.Facts) err[fail.Fail] {
    facts.scalarized = irmod.vector_ops_scalarized;
    var tests: u32 = 0;
    var i:     u32 = 0;
    for (i < irmod.function_len) {
        if ((irmod.functions[i].flags & ir.FN_FLAG_TEST) != 0) { tests = tests + 1; }
        i = i + 1;
    }
    if (tests == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*cache_record.TestFact, A.Error] = A.allocate[cache_record.TestFact](scratch, tests::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    facts.tests      = allocated.ok;
    facts.test_count = tests;
    var n: u32 = 0;
    i = 0;
    for (i < irmod.function_len) {
        val fn: *ir.Function = ?irmod.functions[i];
        if ((fn.flags & ir.FN_FLAG_TEST) != 0) {
            facts.tests[n] = cache_record.TestFact{name: fn.name, line: fn.line};
            n              = n + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a generated image carries its record into `obj/`: the key it was built
# under and the facts its lowered ir holds
pub fun publish(p: *project.Project, m: *project.ModuleEntry, image: *of.ObjectImage) err[fail.Fail] {
    if (!operation_active(p))          { ret err[fail.Fail].err{fail.message("cache publication requires the current query operation")}; }
    if (!p.cache_ready || m.cache_hit) { ret err[fail.Fail].ok{}; }
    if (m.ir_module == nil)            { ret err[fail.Fail].err{fail.message("cache publication requires the module's lowered ir")}; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret err[fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    var facts: cache_record.Facts = cache_record.Facts{};
    fin { cache_record.facts_dnit(?backing, ?facts); }
    val gathered: err[fail.Fail] = gather_facts(?backing, m.ir_module, ?facts);
    if (sel gathered.err) { ret gathered; }
    var digest: [32]u8;
    val keyed:  err[fail.Fail] = key.object(?p.cache_snapshot, project.fqn_name(p, m.fqn), ?digest);
    if (sel keyed.err) { ret keyed; }
    var bytes:   *u8            = nil;
    var len:     u32            = 0;
    val encoded: err[fail.Fail] = cache_record.encode(image.alloc, image.interner, ?digest, ?facts, ?bytes, ?len);
    if (sel encoded.err)           { ret encoded; }
    if (image.cache_record != nil) { A.deallocate[u8](image.alloc, image.cache_record, image.cache_record_len::usize); }
    image.cache_record     = bytes;
    image.cache_record_len = len;
    ret err[fail.Fail].ok{};
}

fun t_append_module(p: *project.Project, m: project.ModuleEntry) bool {
    val reserved: err[fail.Fail] = project.module_reserve(p);
    if (sel reserved.err) { ret false; }
    project.module_append(p, m);
    ret true;
}

fun t_snapshot(p: *project.Project, config: *[1]u8, compiler_id: *compiler.Identity, out: *[32]u8) bool {
    val snapshot_r: err[fail.Fail] = snapshot(p.alloc, p, config::*u8, 1, compiler_id, out);
    ret sel snapshot_r.ok;
}

test snapshot_tracks_source_compiler_configuration_steps_and_embeds {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?a);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var p: project.Project;
    project.init_project(?p, ?s);
    fin {
        p.topo             = nil;
        p.topo_len         = 0;
        p.topo_cap         = 0;
        p.config.deps      = nil;
        p.config.dep_count = 0;
        project.dnit_project(?p);
    }
    p.config.dir_src = intern.STR_NIL;
    val root_id: res[intern.StrId, A.Error] = intern.intern(?s.interner, "/project");
    if (sel root_id.err) { ret 3; }
    p.config.project_root = root_id.ok;
    p.req.project_root    = "/project";
    val f: res[source.FileId, fail.Fail] = source.add(?s.sources, "/project/main.mach", "use support.lib.answer; pub fun main() i64 { ret answer(); }");
    val n: res[intern.StrId, A.Error]    = intern.intern(?s.interner, "project.main");
    if (sel f.err) { ret 3; }
    if (sel n.err) { ret 3; }
    val transitive_file: res[source.FileId, fail.Fail] = source.add(?s.sources, "/project/dep/support/src/lib.mach", "pub fun answer() i64 { ret 7; }");
    val transitive_name: res[intern.StrId, A.Error]    = intern.intern(?s.interner, "support.lib");
    if (sel transitive_file.err) { ret 3; }
    if (sel transitive_name.err) { ret 3; }
    var modules: [2]project.ModuleEntry;
    modules[0].file_id = f.ok;
    modules[0].fqn     = n.ok;
    modules[1].file_id = transitive_file.ok;
    modules[1].fqn     = transitive_name.ok;
    var module_dependencies: [1]session.ModuleId = [1]session.ModuleId{1};
    modules[0].deps      = ?module_dependencies[0];
    modules[0].dep_count = 1;
    var topo:  [2]session.ModuleId = [2]session.ModuleId{1, 0};
    var typed: [2]sema.SemaResult;
    modules[0].sema_result = ?typed[0];
    modules[1].sema_result = ?typed[1];
    if (!t_append_module(?p, modules[0]) || !t_append_module(?p, modules[1])) { ret 3; }
    p.topo     = ?topo[0];
    p.topo_len = 2;
    p.emit_len = 2;
    val names: [9]str = [9]str{"content-1", "revision-1", "1.0.0", "support", "path", "/project/dep/support", "src", "lib", "changed"};
    var ids:   [9]intern.StrId;
    var nidx:  usize  = 0;
    for (nidx < 9) {
        val named: res[intern.StrId, A.Error] = intern.intern(?s.interner, names[nidx]);
        if (sel named.err) { ret 3; }
        ids[nidx] = named.ok;
        nidx      = nidx + 1;
    }
    var direct_aliases: [1]intern.StrId = [1]intern.StrId{ids[3]};
    var dependencies:   [1]project.DepEntry;
    dependencies[0].alias            = ids[3];
    dependencies[0].project_id       = ids[3];
    dependencies[0].source           = ids[4];
    dependencies[0].vendor_root      = ids[5];
    dependencies[0].project_dir_src  = ids[6];
    dependencies[0].project_module   = ids[7];
    dependencies[0].content          = ids[0];
    dependencies[0].ref              = ids[1];
    dependencies[0].manifest.version = ids[2];
    dependencies[0].direct           = ?direct_aliases[0];
    dependencies[0].direct_count     = 1;
    p.config.deps                    = ?dependencies[0];
    p.config.dep_count               = 1;
    var compiler_id: compiler.Identity;
    compiler.identity_clear(?compiler_id);
    compiler_id.len    = 32;
    compiler_id.source = compiler.SOURCE_DIGEST;
    var config:   [1]u8 = [1]u8{1};
    var baseline: [32]u8;
    var changed:  [32]u8;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?baseline)) { ret 4; }
    val original: request.BuildRequest = p.req;
    var axis:     u32                  = 0;
    for (axis < 17) {
        p.req = original;
        if (axis == 0)  { compiler_id.bytes[0] = 1; }
        if (axis == 15) { compiler_id.source = compiler.SOURCE_BUILD_ID; }
        if (axis == 16) { compiler_id.len = 16; }
        if (axis == 1)  { config[0] = 2; }
        if (axis == 2)  { p.req.target = "another-target"; }
        if (axis == 3)  { p.req.profile = "another-profile"; }
        if (axis == 4)  { p.req.artifact = "another-artifact"; }
        if (axis == 5)  { p.req.debug = true; }
        if (axis == 6)  { p.req.float_reassoc = !p.req.float_reassoc; }
        if (axis == 7)  { p.req.placement_policy = 17; }
        if (axis == 8)  { p.step_digest[0] = 1; }
        val get_r: opt[*source.SourceFile] = source.get(?s.sources, modules[0].file_id);
        if (sel get_r.none) { ret 99; }
        val file:  *source.SourceFile = get_r.some;
        val prior: str                = file.text;
        if (axis == 9) { file.text = "use support.lib.answer; pub fun main() i64 { ret answer() + 1; }"; }
        val get_r2: opt[*source.SourceFile] = source.get(?s.sources, modules[1].file_id);
        if (sel get_r2.none) { ret 99; }
        val transitive:       *source.SourceFile = get_r2.some;
        val transitive_prior: str                = transitive.text;
        if (axis == 10) { transitive.text = "pub fun answer() i64 { ret 99; }"; }
        if (axis == 11) { dependencies[0].content = ids[8]; }
        if (axis == 12) { dependencies[0].ref = ids[8]; }
        if (axis == 13) { dependencies[0].manifest.version = ids[8]; }
        if (axis == 14) { direct_aliases[0] = ids[8]; }
        val captured: bool = t_snapshot(?p, ?config, ?compiler_id, ?changed);
        file.text                        = prior;
        transitive.text                  = transitive_prior;
        dependencies[0].content          = ids[0];
        dependencies[0].ref              = ids[1];
        dependencies[0].manifest.version = ids[2];
        direct_aliases[0]                = ids[3];
        if (!captured || key.equal(?baseline, ?changed)) { ret (10 + axis)::i32; }
        compiler_id.bytes[0] = 0;
        compiler_id.len      = 32;
        compiler_id.source   = compiler.SOURCE_DIGEST;
        config[0]            = 1;
        p.step_digest[0]     = 0;
        axis                 = axis + 1;
    }
    p.req         = original;
    p.req.jobs    = 17;
    p.req.emit_ir = true;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?changed) || !key.equal(?baseline, ?changed)) { ret 27; }
    p.req      = original;
    p.req.goal = request.GOAL_TESTS;
    var tests_key: [32]u8;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?tests_key) || key.equal(?baseline, ?tests_key)) { ret 34; }
    p.req.goal = request.GOAL_TEST_LIST;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?changed) || !key.equal(?tests_key, ?changed)) { ret 35; }
    # another spelling of the same paths keys the same cell, unless debug
    # information is requested and the spelling reaches the line tables
    p.req              = original;
    p.req.project_root = "/project/./";
    val spelled_root: res[intern.StrId, A.Error] = intern.intern(?s.interner, "/project/./");
    if (sel spelled_root.err) { ret 30; }
    p.config.project_root = spelled_root.ok;
    val get_spelled: opt[*source.SourceFile] = source.get(?s.sources, modules[0].file_id);
    if (sel get_spelled.none) { ret 30; }
    val spelled_path: str = get_spelled.some.path;
    get_spelled.some.path = "/project/./main.mach";
    val spelled_vendor: res[intern.StrId, A.Error] = intern.intern(?s.interner, "/project/dep/../dep/support");
    if (sel spelled_vendor.err) { ret 30; }
    dependencies[0].vendor_root = spelled_vendor.ok;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?changed) || !key.equal(?baseline, ?changed)) { ret 31; }
    p.req.debug = true;
    var debug_spelled: [32]u8;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?debug_spelled)) { ret 32; }
    get_spelled.some.path       = spelled_path;
    p.config.project_root       = root_id.ok;
    p.req.project_root          = "/project";
    dependencies[0].vendor_root = ids[5];
    var debug_canonical: [32]u8;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?debug_canonical) || key.equal(?debug_spelled, ?debug_canonical)) { ret 33; }
    compiler_id.len = 0;
    if (t_snapshot(?p, ?config, ?compiler_id, ?changed)) { ret 28; }
    compiler_id.len = 32;
    p.req           = original;
    var embedded_path: intern.StrId = modules[0].fqn;
    typed[0].embed_paths      = ?embedded_path;
    typed[0].embed_path_count = 1;
    # the entries live in the session's cache: no bytes, so its dnit frees nothing
    val embedded_r: res[*embed.EmbedFile, fail.Fail] = embed.insert(?s.embeds, embed.EmbedFile{path: modules[0].fqn, status: embed.EMBED_OK, len: 1});
    if (sel embedded_r.err) { ret 25; }
    val embedded:    *embed.EmbedFile                 = embedded_r.ok;
    val with_embed:  bool                             = t_snapshot(?p, ?config, ?compiler_id, ?baseline);
    val unrelated_r: res[*embed.EmbedFile, fail.Fail] = embed.insert(?s.embeds, embed.EmbedFile{path: modules[1].fqn, status: embed.EMBED_MISSING});
    if (sel unrelated_r.err) { ret 25; }
    val ignores_unrelated: bool = t_snapshot(?p, ?config, ?compiler_id, ?changed) && key.equal(?baseline, ?changed);
    embedded.digest[0] = 1;
    val changed_embed: bool = t_snapshot(?p, ?config, ?compiler_id, ?changed);
    embedded.status = embed.EMBED_MISSING;
    var refused:        [32]u8;
    val rejects_active: bool = !t_snapshot(?p, ?config, ?compiler_id, ?refused);
    if (!with_embed || !ignores_unrelated || !changed_embed || !rejects_active || key.equal(?baseline, ?changed)) { ret 25; }
    typed[0].embed_path_count = 0;
    val register_link_provider_r: err[fail.Fail] = session.register_link_provider(?s, modules[0].fqn, false);
    if (sel register_link_provider_r.err)                  { ret 27; }
    if (!t_snapshot(?p, ?config, ?compiler_id, ?baseline)) { ret 28; }
    s.link_providers[0].is_static = true;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?changed) || key.equal(?baseline, ?changed)) { ret 29; }
    ret 0;
}

fun t_boxed_image(s: *session.Session) *of.ObjectImage {
    val allocated: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](s.alloc, 1);
    if (sel allocated.err) { ret nil; }
    val staged: *of.ObjectImage = allocated.ok;
    @staged = of.object_image_init(s.alloc, ?s.interner, intern.STR_NIL);
    ret staged;
}

fun t_emit(tgt: *of.ObjectTarget, img: *of.ObjectImage, destination: str) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("test format writes nothing")};
}

fun t_parse(a: *A.Allocator, itn: *intern.Interner, bytes: *u8, len: usize, out: *of.ObjectImage) err[fail.Fail] {
    ret err[fail.Fail].err{fail.message("test format reads nothing")};
}

test operation_reset_keeps_restored_products_under_their_snapshot_and_drops_fresh_ones {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?a);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var p: project.Project;
    project.init_project(?p, ?s);
    fin {
        project.release_all_staged(?p);
        project.dnit_project(?p);
    }
    if (!t_append_module(?p, project.ModuleEntry{}) || !t_append_module(?p, project.ModuleEntry{})) { ret 2; }
    val m0: *project.ModuleEntry = project.module_at(?p, 0);
    val m1: *project.ModuleEntry = project.module_at(?p, 1);
    # a relocatable format the cache can read back, and the cell's obj directory
    var vt: of.OfVTable = of.linker_vtable(1, "test", "o", t_emit, t_parse, nil);
    p.target.of                     = ?vt;
    p.object_dir                    = "out/obj";
    p.req.object_cache              = true;
    p.compiler_identity_initialized = true;
    p.compiler_identity_available   = false;
    p.compiler_identity.bytes[0]    = 91;
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(?p);
    if (sel begun.err) { ret 3; }
    val first: query.Operation = begun.ok;
    # no identity: the operation prepares as disabled and touches nothing
    val prepare_r: err[fail.Fail] = prepare(?p, nil);
    if (sel prepare_r.err)                     { ret 4; }
    if (!p.cache_initialized || p.cache_ready) { ret 4; }
    val finished_disabled: err[outcome.Fail] = project.finish_query_phase(?p, first, nil, 0, err[outcome.Fail].ok{});
    if (sel finished_disabled.err) { ret 4; }
    # a snapshot: the cache is ready to read `obj/`
    var snapshot_a: [32]u8;
    var snapshot_b: [32]u8;
    snapshot_a[0] = 37;
    snapshot_b[0] = 38;
    val second_r: res[query.Operation, outcome.Fail] = project.begin_query_phase(?p);
    if (sel second_r.err) { ret 5; }
    val second:   query.Operation = second_r.ok;
    val prepared: err[fail.Fail]  = prepare(?p, ?snapshot_a);
    if (sel prepared.err)                            { ret 5; }
    if (!p.cache_ready || p.cache_snapshot[0] != 37) { ret 5; }
    p.cache_hits   = 2;
    p.cache_misses = 3;
    # module 0 holds a product restored under snapshot a; module 1 a fresh image a worker staged
    m0.cache_checked = true;
    m0.cache_hit     = true;
    m0.cache_under   = snapshot_a;
    val restored: *of.ObjectImage = t_boxed_image(?s);
    if (restored == nil) { ret 6; }
    m0.staged_image = restored;
    val fresh: *of.ObjectImage = t_boxed_image(?s);
    if (fresh == nil) { ret 6; }
    m1.staged_image = fresh;
    var borrowed: of.ObjectImage = of.object_image_init(?a, ?s.interner, intern.STR_NIL);
    m0.object_image = ?borrowed;
    if (!staged_restored(?p, m0) || staged_restored(?p, m1)) { ret 6; }
    val prepare_again: err[fail.Fail] = prepare(?p, ?snapshot_b);
    if (sel prepare_again.err)                                    { ret 7; }
    if (p.cache_snapshot[0] != 37 || m0.staged_image != restored) { ret 7; }
    val finished: err[outcome.Fail] = project.finish_query_phase(?p, second, nil, 0, err[outcome.Fail].ok{});
    if (sel finished.err) { ret 8; }
    if (m0.staged_image != restored || !m0.cache_hit || !m0.cache_checked
        || m1.staged_image != nil || m0.object_image != ?borrowed
        || p.cache_ready || p.cache_initialized || p.cache_operation_sequence != 0
        || p.cache_hits != 2 || p.cache_misses != 3) { ret 9; }
    val prepare_r3: err[fail.Fail] = prepare(?p, ?snapshot_a);
    if (sel prepare_r3.ok) { ret 10; }
    val restore_r: res[bool, fail.Fail] = restore(?p, 0, readout.PH_CACHE);
    val publish_r: err[fail.Fail]       = publish(?p, m0, ?borrowed);
    if (sel restore_r.ok) { ret 10; }
    if (sel publish_r.ok) { ret 10; }
    # the next operation under the same snapshot keeps the restored product
    val third_r: res[query.Operation, outcome.Fail] = project.begin_query_phase(?p);
    if (sel third_r.err) { ret 11; }
    val third: query.Operation = third_r.ok;
    if (third.sequence == second.sequence || p.cache_snapshot[0] != 0 || p.cache_initialized
        || !p.compiler_identity_initialized || p.compiler_identity_available || p.compiler_identity.bytes[0] != 91) { ret 11; }
    val prepared_same: err[fail.Fail] = prepare(?p, ?snapshot_a);
    if (sel prepared_same.err)                                     { ret 12; }
    if (m0.staged_image != restored || !staged_restored(?p, m0))   { ret 12; }
    if (take_staged(?p, m0) != restored || m0.staged_image != nil) { ret 12; }
    of.object_image_dnit(restored);
    A.deallocate[of.ObjectImage](s.alloc, restored, 1);
    m0.staged_image = t_boxed_image(?s);
    if (m0.staged_image == nil) { ret 12; }
    val ended_third: err[outcome.Fail] = project.finish_query_phase(?p, third, nil, 0, err[outcome.Fail].ok{});
    if (sel ended_third.err)    { ret 13; }
    if (m0.staged_image == nil) { ret 13; }
    # a different snapshot discards it and forgets the verdict: the object is read again
    val fourth_r: res[query.Operation, outcome.Fail] = project.begin_query_phase(?p);
    if (sel fourth_r.err) { ret 14; }
    val fourth:         query.Operation = fourth_r.ok;
    val prepared_other: err[fail.Fail]  = prepare(?p, ?snapshot_b);
    if (sel prepared_other.err)                                     { ret 14; }
    if (m0.staged_image != nil || m0.cache_hit || m0.cache_checked) { ret 15; }
    p.req.object_cache = false;
    val ended: err[outcome.Fail] = project.finish_query_phase(?p, fourth, nil, 0, err[outcome.Fail].ok{});
    if (sel ended.err)                                        { ret 16; }
    if (m0.object_image != ?borrowed || borrowed.alloc != ?a) { ret 17; }
    ret 0;
}
