use A: std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use O: std.types.option;
use R: std.types.result;
use key: mach.lang.build.cache.key;
use mach.lang.build.request;
use mach.lang.driver.project;
use mach.lang.embed;
use mach.lang.fe.sema;
use mach.lang.intern;
use mach.lang.source;

# hash the whole active build cell because generic instantiations can cross import direction
pub fun snapshot(scratch: *A.Allocator, p: *project.Project, config: *u8, config_len: usize,
                 compiler_id: *compiler.Identity, digest: *[32]u8) R.Result[R.Void, str] {
    if (scratch == nil || p == nil || p.s == nil || compiler_id == nil || digest == nil
        || compiler_id.len == 0 || compiler_id.len > 32) {
        ret R.err[R.Void, str]("cache snapshot requires a project and compiler identity");
    }
    var b: key.Builder = key.begin("mach.compilation-cell");
    key.number(?b, compiler_id.source::u64);
    key.bytes(?b, ?compiler_id.bytes[0], compiler_id.len);
    key.bytes(?b, config, config_len);
    key.name(?b, ?p.s.interner, p.compiler_name);
    key.name(?b, ?p.s.interner, p.compiler_ver);
    var request_digest: [32]u8;
    val requested: R.Result[R.Void, str] = request.semantic_hash(scratch, ?p.req, ?request_digest[0]);
    if (R.is_err[R.Void, str](requested)) { ret requested; }
    key.bytes(?b, ?request_digest[0], 32);
    key.number(?b, p.req.placement_policy::u64);
    key.bytes(?b, ?p.step_digest[0], 32);
    key.name(?b, ?p.s.interner, p.config.module);
    key.name(?b, ?p.s.interner, p.config.dir_src);
    key.name(?b, ?p.s.interner, p.config.project_root);
    key.number(?b, p.roots::u64);
    key.number(?b, p.module_len::u64);
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        val file: O.Option[*source.SourceFile] = source.get(?p.s.sources, m.file_id);
        if (O.is_none[*source.SourceFile](file)) { ret R.err[R.Void, str]("cache snapshot module has no current source"); }
        val f: *source.SourceFile = O.unwrap[*source.SourceFile](file);
        if (!f.present || f.text == nil) { ret R.err[R.Void, str]("cache snapshot source is not present"); }
        key.name(?b, ?p.s.interner, m.fqn);
        key.text(?b, f.path);
        key.bytes(?b, f.text, str_len(f.text));
        key.number(?b, m.dep_count::u64);
        var d: u32 = 0;
        for (d < m.dep_count) {
            val dependency: u32 = m.deps[d]::u32;
            if (dependency >= p.module_len) { ret R.err[R.Void, str]("cache snapshot dependency is not loaded"); }
            key.name(?b, ?p.s.interner, p.modules[dependency].fqn);
            d = d + 1;
        }
        i = i + 1;
    }
    key.number(?b, p.emit_len::u64);
    i = 0;
    for (i < p.emit_len) {
        val mid: u32 = p.topo[i]::u32;
        if (mid >= p.module_len) { ret R.err[R.Void, str]("cache snapshot emission order names an absent module"); }
        key.name(?b, ?p.s.interner, p.modules[mid].fqn);
        i = i + 1;
    }
    key.number(?b, p.config.dep_count::u64);
    i = 0;
    for (i < p.config.dep_count) {
        val d: *project.DepEntry = ?p.config.deps[i];
        key.name(?b, ?p.s.interner, d.alias);
        key.name(?b, ?p.s.interner, d.project_id);
        key.name(?b, ?p.s.interner, d.project_dir_src);
        key.name(?b, ?p.s.interner, d.project_module);
        key.name(?b, ?p.s.interner, d.vendor_root);
        key.name(?b, ?p.s.interner, d.source);
        key.name(?b, ?p.s.interner, d.ref);
        key.name(?b, ?p.s.interner, d.content);
        key.name(?b, ?p.s.interner, d.manifest.version);
        key.number(?b, d.direct_count::u64);
        var n: u32 = 0;
        for (n < d.direct_count) { key.name(?b, ?p.s.interner, d.direct[n]); n = n + 1; }
        i = i + 1;
    }
    key.number(?b, p.topo_len::u64);
    i = 0;
    for (i < p.topo_len) {
        val mid: u32 = p.topo[i]::u32;
        if (mid >= p.module_len) { ret R.err[R.Void, str]("cache snapshot names an absent typed module"); }
        val typed: *sema.SemaResult = p.modules[mid].sema_result;
        if (typed == nil) { ret R.err[R.Void, str]("cache snapshot module has no current typed owner"); }
        key.name(?b, ?p.s.interner, p.modules[mid].fqn);
        key.number(?b, typed.embed_path_count::u64);
        var ei: u32 = 0;
        for (ei < typed.embed_path_count) {
            val found: O.Option[*embed.EmbedFile] = embed.get(?p.s.embeds, typed.embed_paths[ei]);
            if (O.is_none[*embed.EmbedFile](found)) { ret R.err[R.Void, str]("cache snapshot is missing an active embedded input"); }
            val e: *embed.EmbedFile = O.unwrap[*embed.EmbedFile](found);
            if (e.status != embed.EMBED_OK) { ret R.err[R.Void, str]("cache snapshot contains an unavailable embedded input"); }
            key.name(?b, ?p.s.interner, e.path);
            key.number(?b, e.len::u64);
            key.bytes(?b, ?e.digest[0], 32);
            ei = ei + 1;
        }
        i = i + 1;
    }
    key.number(?b, p.s.link_provider_len::u64);
    i = 0;
    for (i < p.s.link_provider_len) {
        key.name(?b, ?p.s.interner, p.s.link_providers[i].name);
        key.number(?b, p.s.link_providers[i].is_static::u64);
        i = i + 1;
    }
    ret key.finish(?b, digest);
}

use std.allocator.page;
use std.collections.vector;
use std.system.os;
use std.types.bool.true;
use std.types.path;
use std.text.string.str_free;
use txn: std.filesystem.transaction;
use codec: mach.lang.build.cache.image;
use store: mach.lang.build.cache.store;
use compiler: mach.lang.build.cache.compiler;
use mach.lang.target.of;
use mach.lang.session;
use mach.lang.readout;
use std.chrono.duration;
use ctime: std.chrono.time;
use mach.lang.query;
use mach.lang.build.outcome;

fun transaction_internal(error: txn.Error) bool {
    ret error.kind == txn.INVALID || error.kind == txn.MEMORY || error.code == os.ENOMEM;
}

pub fun operation_active(p: *project.Project) bool {
    ret p != nil && p.s != nil && p.s.queries.operation_active
        && p.cache_operation_sequence != 0 && p.cache_operation_sequence == p.s.queries.operation_sequence;
}

pub fun prepare(p: *project.Project, config: *u8, config_len: usize) R.Result[R.Void, str] {
    if (!operation_active(p)) { ret R.err[R.Void, str]("cache preparation requires the current query operation"); }
    if (p.cache_initialized) { ret R.ok_void[str](); }
    val prepared: R.Result[R.Void, str] = prepare_operation(p, config, config_len);
    if (R.is_ok[R.Void, str](prepared)) { p.cache_initialized = true; }
    ret prepared;
}

fun prepare_operation(p: *project.Project, config: *u8, config_len: usize) R.Result[R.Void, str] {
    if (!p.req.object_cache) { ret R.ok_void[str](); }
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret R.err[R.Void, str]("cache scratch allocator is unavailable"); }
    if (!p.compiler_identity_initialized) {
        val t_identity: ctime.Time = readout.item_begin(p.events);
        val identified: R.Result[R.Void, compiler.Error] = compiler.identity(?backing, ?p.compiler_identity);
        if (R.is_err[R.Void, compiler.Error](identified)) {
            val error: compiler.Error = R.unwrap_err[R.Void, compiler.Error](identified);
            if (error.kind != compiler.UNAVAILABLE) { ret R.err[R.Void, str](error.message); }
            readout.item(p.events, readout.PH_CODEGEN, "compiler identity unavailable", t_identity);
        }
        or {
            p.compiler_identity_available = true;
            if (p.compiler_identity.source == compiler.SOURCE_BUILD_ID) {
                readout.item(p.events, readout.PH_CODEGEN, "compiler identity: build id", t_identity);
            }
            or { readout.item(p.events, readout.PH_CODEGEN, "compiler identity: image digest", t_identity); }
        }
        p.compiler_identity_initialized = true;
    }
    if (!p.compiler_identity_available) { ret R.ok_void[str](); }
    val keyed: R.Result[R.Void, str] = snapshot(?backing, p, config, config_len, ?p.compiler_identity, ?p.cache_snapshot);
    if (R.is_err[R.Void, str](keyed)) { ret keyed; }
    val root: O.Option[str] = intern.lookup(?p.s.interner, p.config.project_root);
    val out: O.Option[str] = intern.lookup(?p.s.interner, p.config.project_out);
    if (O.is_none[str](root) || O.is_none[str](out)) { ret R.err[R.Void, str]("cache directory has no resolved output root"); }
    var held: txn.Root;
    val opened: O.Option[txn.Error] = txn.root_open(?held, O.unwrap[str](root), O.unwrap[str](out));
    if (O.is_some[txn.Error](opened)) {
        val error: txn.Error = O.unwrap[txn.Error](opened);
        if (transaction_internal(error)) { ret R.err[R.Void, str](txn.error_message(error)); }
        ret R.ok_void[str]();
    }
    val made: i64 = os.make_dir(txn.root_fd(?held), ".mach-cache", 0o700);
    val closed: O.Option[txn.Error] = txn.root_dnit(?held);
    if (O.is_some[txn.Error](closed)) {
        val error: txn.Error = O.unwrap[txn.Error](closed);
        if (transaction_internal(error)) { ret R.err[R.Void, str](txn.error_message(error)); }
        ret R.ok_void[str]();
    }
    if (made == os.ENOMEM) { ret R.err[R.Void, str]("out of memory creating cache directory"); }
    if (made < 0 && made != os.EEXIST) { ret R.ok_void[str](); }
    val output_path: R.Result[str, str] = path.resolve(?backing, O.unwrap[str](root), O.unwrap[str](out));
    if (R.is_err[str, str](output_path)) { ret R.err[R.Void, str](R.unwrap_err[str, str](output_path)); }
    val output: str = R.unwrap_ok[str, str](output_path);
    fin { str_free(?backing, output); }
    val directory: R.Result[str, str] = path.join(p.alloc, output, ".mach-cache");
    if (R.is_err[str, str](directory)) { ret R.err[R.Void, str](R.unwrap_err[str, str](directory)); }
    p.cache_dir = R.unwrap_ok[str, str](directory);
    p.cache_ready = true;
    ret R.ok_void[str]();
}

pub fun restore(p: *project.Project, mid: session.ModuleId) R.Result[bool, str] {
    if (!operation_active(p)) { ret R.err[bool, str]("cache restoration requires the current query operation"); }
    val index: u32 = mid::u32;
    if (index >= p.module_len) { ret R.err[bool, str]("cache restore names an absent module"); }
    val m: *project.ModuleEntry = ?p.modules[index];
    if (!p.cache_ready || m.cache_checked) { ret R.ok[bool, str](m.cache_hit); }
    m.cache_checked = true;
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret R.err[bool, str]("cache scratch allocator is unavailable"); }
    var digest: [32]u8;
    val keyed: R.Result[R.Void, str] = key.object(?p.cache_snapshot, project.fqn_name(p, m.fqn), ?digest);
    if (R.is_err[R.Void, str](keyed)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](keyed)); }
    val found: R.Result[store.Lookup, store.Error] = store.read(?backing, p.cache_dir, ?digest);
    if (R.is_err[store.Lookup, store.Error](found)) { ret R.err[bool, str](R.unwrap_err[store.Lookup, store.Error](found).message); }
    var entry: store.Lookup = R.unwrap_ok[store.Lookup, store.Error](found);
    fin { vector.dnit[u8](?entry.bytes); }
    if (entry.status.kind != store.HIT) {
        if (entry.status.kind == store.UNAVAILABLE) { p.cache_ready = false; }
        p.cache_misses = p.cache_misses + 1;
        ret R.ok[bool, str](false);
    }
    val decoded: R.Result[of.ObjectImage, codec.Error] = codec.decode(p.s.alloc, ?p.s.interner, entry.bytes.data, entry.bytes.len);
    if (R.is_err[of.ObjectImage, codec.Error](decoded)) {
        val error: codec.Error = R.unwrap_err[of.ObjectImage, codec.Error](decoded);
        if (error.kind == codec.INTERNAL) { ret R.err[bool, str](error.message); }
        p.cache_misses = p.cache_misses + 1;
        ret R.ok[bool, str](false);
    }
    var image: of.ObjectImage = R.unwrap_ok[of.ObjectImage, codec.Error](decoded);
    if (m.ir_module == nil || image.name != m.ir_module.name) {
        of.object_image_dnit(?image);
        p.cache_misses = p.cache_misses + 1;
        ret R.ok[bool, str](false);
    }
    val boxed: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](p.s.alloc, 1);
    if (R.is_err[*of.ObjectImage, str](boxed)) {
        of.object_image_dnit(?image);
        ret R.err[bool, str](R.unwrap_err[*of.ObjectImage, str](boxed));
    }
    val box: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](boxed);
    @box = image;
    m.staged_image = box;
    m.cache_hit = true;
    p.cache_hits = p.cache_hits + 1;
    readout.item_dur(p.events, readout.PH_CODEGEN, "cached object", 0::duration.Duration);
    ret R.ok[bool, str](true);
}

pub fun publish(p: *project.Project, m: *project.ModuleEntry, image: *of.ObjectImage) R.Result[R.Void, str] {
    if (!operation_active(p)) { ret R.err[R.Void, str]("cache publication requires the current query operation"); }
    if (!p.cache_ready || m.cache_hit) { ret R.ok_void[str](); }
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret R.err[R.Void, str]("cache scratch allocator is unavailable"); }
    val encoded: R.Result[vector.Vector[u8], codec.Error] = codec.encode(?backing, image);
    if (R.is_err[vector.Vector[u8], codec.Error](encoded)) {
        val error: codec.Error = R.unwrap_err[vector.Vector[u8], codec.Error](encoded);
        if (error.kind == codec.LIMIT) { ret R.ok_void[str](); }
        ret R.err[R.Void, str](error.message);
    }
    var bytes: vector.Vector[u8] = R.unwrap_ok[vector.Vector[u8], codec.Error](encoded);
    fin { vector.dnit[u8](?bytes); }
    var digest: [32]u8;
    val keyed: R.Result[R.Void, str] = key.object(?p.cache_snapshot, project.fqn_name(p, m.fqn), ?digest);
    if (R.is_err[R.Void, str](keyed)) { ret keyed; }
    val stored: R.Result[store.Status, store.Error] = store.publish(?backing, p.cache_dir, ?digest, bytes.data, bytes.len);
    if (R.is_err[store.Status, store.Error](stored)) { ret R.err[R.Void, str](R.unwrap_err[store.Status, store.Error](stored).message); }
    if (R.unwrap_ok[store.Status, store.Error](stored).kind == store.UNAVAILABLE) { p.cache_ready = false; }
    ret R.ok_void[str]();
}

fun t_snapshot(p: *project.Project, config: *[1]u8, compiler_id: *compiler.Identity, out: *[32]u8) bool {
    ret R.is_ok[R.Void, str](snapshot(p.alloc, p, config::*u8, 1, compiler_id, out));
}

test "mach.lang.driver.cache:snapshot_tracks_source_compiler_configuration_steps_and_embeds" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val initialized: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    fin { session.dnit(?s); }
    var p: project.Project;
    project.init_project(?p, ?s);
    fin {
        p.modules = nil; p.module_len = 0; p.module_cap = 0;
        p.topo = nil; p.topo_len = 0; p.topo_cap = 0;
        p.config.deps = nil; p.config.dep_count = 0;
        project.dnit_project(?p);
    }
    p.config.dir_src = intern.STR_NIL;
    p.config.project_root = intern.STR_NIL;
    val f: R.Result[source.FileId, str] = source.add(?s.sources, "/project/main.mach", "use support.lib.answer; pub fun main() i64 { ret answer(); }");
    val n: R.Result[intern.StrId, str] = intern.intern(?s.interner, "project.main");
    if (R.is_err[source.FileId, str](f) || R.is_err[intern.StrId, str](n)) { ret 3; }
    val transitive_file: R.Result[source.FileId, str] = source.add(?s.sources, "/project/dep/support/src/lib.mach", "pub fun answer() i64 { ret 7; }");
    val transitive_name: R.Result[intern.StrId, str] = intern.intern(?s.interner, "support.lib");
    if (R.is_err[source.FileId, str](transitive_file) || R.is_err[intern.StrId, str](transitive_name)) { ret 3; }
    var modules: [2]project.ModuleEntry;
    modules[0].file_id = R.unwrap_ok[source.FileId, str](f);
    modules[0].fqn = R.unwrap_ok[intern.StrId, str](n);
    modules[1].file_id = R.unwrap_ok[source.FileId, str](transitive_file);
    modules[1].fqn = R.unwrap_ok[intern.StrId, str](transitive_name);
    var module_dependencies: [1]session.ModuleId = [1]session.ModuleId{1};
    modules[0].deps = ?module_dependencies[0]; modules[0].dep_count = 1;
    var topo: [2]session.ModuleId = [2]session.ModuleId{1, 0};
    var typed: [2]sema.SemaResult;
    modules[0].sema_result = ?typed[0]; modules[1].sema_result = ?typed[1];
    p.modules = ?modules[0]; p.module_len = 2; p.topo = ?topo[0]; p.topo_len = 2; p.emit_len = 2;
    val names: [9]str = [9]str{"content-1", "revision-1", "1.0.0", "support", "path", "/project/dep/support", "src", "lib", "changed"};
    var ids: [9]intern.StrId;
    var nidx: usize = 0;
    for (nidx < 9) {
        val named: R.Result[intern.StrId, str] = intern.intern(?s.interner, names[nidx]);
        if (R.is_err[intern.StrId, str](named)) { ret 3; }
        ids[nidx] = R.unwrap_ok[intern.StrId, str](named);
        nidx = nidx + 1;
    }
    var direct_aliases: [1]intern.StrId = [1]intern.StrId{ids[3]};
    var dependencies: [1]project.DepEntry;
    dependencies[0].alias = ids[3]; dependencies[0].project_id = ids[3];
    dependencies[0].source = ids[4]; dependencies[0].vendor_root = ids[5];
    dependencies[0].project_dir_src = ids[6]; dependencies[0].project_module = ids[7];
    dependencies[0].content = ids[0]; dependencies[0].ref = ids[1]; dependencies[0].manifest.version = ids[2];
    dependencies[0].direct = ?direct_aliases[0]; dependencies[0].direct_count = 1;
    p.config.deps = ?dependencies[0]; p.config.dep_count = 1;
    var compiler_id: compiler.Identity;
    compiler.identity_clear(?compiler_id);
    compiler_id.len = 32; compiler_id.source = compiler.SOURCE_DIGEST;
    var config: [1]u8 = [1]u8{1};
    var baseline: [32]u8;
    var changed: [32]u8;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?baseline)) { ret 4; }
    val original: request.BuildRequest = p.req;
    var axis: u32 = 0;
    for (axis < 17) {
        p.req = original;
        if (axis == 0) { compiler_id.bytes[0] = 1; }
        if (axis == 15) { compiler_id.source = compiler.SOURCE_BUILD_ID; }
        if (axis == 16) { compiler_id.len = 16; }
        if (axis == 1) { config[0] = 2; }
        if (axis == 2) { p.req.target = "another-target"; }
        if (axis == 3) { p.req.profile = "another-profile"; }
        if (axis == 4) { p.req.artifact = "another-artifact"; }
        if (axis == 5) { p.req.debug = true; }
        if (axis == 6) { p.req.float_reassoc = !p.req.float_reassoc; }
        if (axis == 7) { p.req.placement_policy = 17; }
        if (axis == 8) { p.step_digest[0] = 1; }
        val file: *source.SourceFile = O.unwrap[*source.SourceFile](source.get(?s.sources, modules[0].file_id));
        val prior: str = file.text;
        if (axis == 9) { file.text = "use support.lib.answer; pub fun main() i64 { ret answer() + 1; }"; }
        val transitive: *source.SourceFile = O.unwrap[*source.SourceFile](source.get(?s.sources, modules[1].file_id));
        val transitive_prior: str = transitive.text;
        if (axis == 10) { transitive.text = "pub fun answer() i64 { ret 99; }"; }
        if (axis == 11) { dependencies[0].content = ids[8]; }
        if (axis == 12) { dependencies[0].ref = ids[8]; }
        if (axis == 13) { dependencies[0].manifest.version = ids[8]; }
        if (axis == 14) { direct_aliases[0] = ids[8]; }
        val captured: bool = t_snapshot(?p, ?config, ?compiler_id, ?changed);
        file.text = prior;
        transitive.text = transitive_prior;
        dependencies[0].content = ids[0]; dependencies[0].ref = ids[1]; dependencies[0].manifest.version = ids[2];
        direct_aliases[0] = ids[3];
        if (!captured || key.equal(?baseline, ?changed)) { ret (10 + axis)::i32; }
        compiler_id.bytes[0] = 0; compiler_id.len = 32; compiler_id.source = compiler.SOURCE_DIGEST;
        config[0] = 1; p.step_digest[0] = 0;
        axis = axis + 1;
    }
    p.req = original;
    p.req.jobs = 17;
    p.req.emit_ir = true;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?changed) || !key.equal(?baseline, ?changed)) { ret 27; }
    compiler_id.len = 0;
    if (t_snapshot(?p, ?config, ?compiler_id, ?changed)) { ret 28; }
    compiler_id.len = 32;
    p.req = original;
    var embedded: [2]embed.EmbedFile;
    embedded[0] = embed.EmbedFile{path: modules[0].fqn, status: embed.EMBED_OK, len: 1};
    embedded[1] = embed.EmbedFile{path: modules[1].fqn, status: embed.EMBED_MISSING};
    var embedded_path: intern.StrId = embedded[0].path;
    typed[0].embed_paths = ?embedded_path; typed[0].embed_path_count = 1;
    s.embeds.entries = ?embedded[0]; s.embeds.len = 1;
    val with_embed: bool = t_snapshot(?p, ?config, ?compiler_id, ?baseline);
    s.embeds.len = 2;
    val ignores_unrelated: bool = t_snapshot(?p, ?config, ?compiler_id, ?changed) && key.equal(?baseline, ?changed);
    embedded[0].digest[0] = 1;
    val changed_embed: bool = t_snapshot(?p, ?config, ?compiler_id, ?changed);
    embedded[0].status = embed.EMBED_MISSING;
    var refused: [32]u8;
    val rejects_active: bool = !t_snapshot(?p, ?config, ?compiler_id, ?refused);
    s.embeds.entries = nil; s.embeds.len = 0;
    if (!with_embed || !ignores_unrelated || !changed_embed || !rejects_active || key.equal(?baseline, ?changed)) { ret 25; }
    typed[0].embed_path_count = 0;
    if (R.is_err[R.Void, str](session.register_link_provider(?s, modules[0].fqn, false))) { ret 27; }
    if (!t_snapshot(?p, ?config, ?compiler_id, ?baseline)) { ret 28; }
    s.link_providers[0].is_static = true;
    if (!t_snapshot(?p, ?config, ?compiler_id, ?changed) || key.equal(?baseline, ?changed)) { ret 29; }
    ret 0;
}


test "mach.lang.driver.cache:operation_reset_preserves_compiler_identity_and_query_owned_images" {
    var a: A.Allocator;
    if (O.is_some[str](page.make(?a))) { ret 1; }
    val initialized: R.Result[session.Session, str] = session.init(?a);
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    fin { session.dnit(?s); }
    var p: project.Project;
    project.init_project(?p, ?s);
    var modules: [1]project.ModuleEntry;
    p.modules = ?modules[0]; p.module_len = 1;
    fin {
        if (modules[0].staged_image != nil) {
            of.object_image_dnit(modules[0].staged_image);
            A.deallocate[of.ObjectImage](s.alloc, modules[0].staged_image, 1);
            modules[0].staged_image = nil;
        }
        p.modules = nil; p.module_len = 0; p.module_cap = 0;
        project.dnit_project(?p);
    }
    p.req.object_cache = true;
    p.compiler_identity_initialized = true;
    p.compiler_identity_available = false;
    p.compiler_identity.bytes[0] = 91;
    val begun: R.Result[query.Operation, outcome.Fail] = project.begin_query_phase(?p);
    if (R.is_err[query.Operation, outcome.Fail](begun)) { ret 3; }
    val first: query.Operation = R.unwrap_ok[query.Operation, outcome.Fail](begun);
    if (R.is_err[R.Void, str](prepare(?p, nil, 0))) { ret 4; }
    p.cache_snapshot[0] = 37;
    p.cache_ready = true;
    p.cache_hits = 2; p.cache_misses = 3;
    modules[0].cache_checked = true; modules[0].cache_hit = true;
    var borrowed: of.ObjectImage = of.object_image_init(?a, ?s.interner, intern.STR_NIL);
    modules[0].object_image = ?borrowed;
    val allocated: R.Result[*of.ObjectImage, str] = A.allocate[of.ObjectImage](s.alloc, 1);
    if (R.is_err[*of.ObjectImage, str](allocated)) { ret 5; }
    val staged: *of.ObjectImage = R.unwrap_ok[*of.ObjectImage, str](allocated);
    @staged = of.object_image_init(s.alloc, ?s.interner, intern.STR_NIL);
    modules[0].staged_image = staged;
    if (R.is_err[R.Void, str](prepare(?p, nil, 0)) || modules[0].staged_image != staged
        || !modules[0].cache_hit || p.cache_snapshot[0] != 37 || p.cache_hits != 2) { ret 6; }
    val finished: R.Result[R.Void, outcome.Fail] = project.finish_query_phase(?p, first, nil, 0, R.ok_void[outcome.Fail]());
    if (R.is_err[R.Void, outcome.Fail](finished)) { ret 7; }
    if (modules[0].staged_image != nil || modules[0].object_image != ?borrowed
        || modules[0].cache_checked || modules[0].cache_hit || p.cache_ready
        || p.cache_operation_sequence != 0 || p.cache_hits != 2 || p.cache_misses != 3) { ret 8; }
    if (R.is_ok[R.Void, str](prepare(?p, nil, 0))
        || R.is_ok[bool, str](restore(?p, 0))
        || R.is_ok[R.Void, str](publish(?p, ?modules[0], ?borrowed))) { ret 9; }
    val restarted: R.Result[query.Operation, outcome.Fail] = project.begin_query_phase(?p);
    if (R.is_err[query.Operation, outcome.Fail](restarted)) { ret 10; }
    val second: query.Operation = R.unwrap_ok[query.Operation, outcome.Fail](restarted);
    if (second.sequence == first.sequence || p.cache_hits != 0 || p.cache_misses != 0
        || p.cache_snapshot[0] != 0 || p.cache_initialized
        || !p.compiler_identity_initialized || p.compiler_identity_available || p.compiler_identity.bytes[0] != 91) { ret 11; }
    p.req.object_cache = false;
    if (R.is_err[R.Void, str](prepare(?p, nil, 0)) || !p.cache_initialized || p.cache_ready) { ret 12; }
    val ended: R.Result[R.Void, outcome.Fail] = project.finish_query_phase(?p, second, nil, 0, R.ok_void[outcome.Fail]());
    if (R.is_err[R.Void, outcome.Fail](ended)) { ret 13; }
    if (modules[0].object_image != ?borrowed || borrowed.alloc != ?a) { ret 14; }
    ret 0;
}
