# the persistent object cache. every module the build emits is keyed once per
# load, after the load walk and before anything is resolved: its key covers
# the build configuration and compiler identity, the module's own source and
# embedded files, and the surface of every module it imports, transitively.
# an import's surface is its source without the bodies no importer compiles
# (see driver/surface), so an edit inside such a body keys only its own
# module. a release build inlines bodies across modules, so there an import's
# whole source is its surface. a module whose `obj/` object carries its key
# is reused, and when nothing the build still compiles imports it, it is not
# resolved, typed or lowered at all. source digests come from the per-file
# digest memo in the cell's `.cache` directory (build/cache/memo)
use mach.lang.build.cache.key;
use mach.lang.build.request;
use mach.lang.diagnostic;
use dkind: mach.lang.diagnostic.kind;
use mach.lang.driver.project;
use mach.lang.embed;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.source;
use A: std.allocator;
use std.process.env;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.OwnedString;
use std.types.string.owned_release;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use mach.lang.build.cache.compiler;
use mach.lang.build.cache.memo;
use cache_record: mach.lang.build.cache.record;
use mach.lang.build.outcome;
use mach.lang.driver.surface;
use mach.lang.driver.union;
use mach.lang.fe.token;
use mach.lang.me.ir;
use mach.lang.me.lower.testrunner;
use mach.lang.me.pipeline;
use mach.lang.output;
use mach.lang.query;
use mach.lang.readout;
use mach.lang.session;
use mach.lang.target.isa;
use mach.lang.target.of;
use mach.lang.target.of.bin;
use std.allocator.page;
use std.chrono.time;
use std.collections.map;
use std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.sha256;
use fs: std.filesystem;
use std.memory;
use std.text.string.str_free;
use std.types.bool.true;
use std.types.path;

# a path as the filesystem would name it from this process: absolute and
# lexically clean, so `mach build .` and `mach build /abs/project` agree
fun canonical(scratch: *A.Allocator, cwd: str, spelled: str) res[str, fail.Fail] {
    val absolute: res[str, A.Error] = path.resolve(scratch, cwd, spelled);
    if (sel absolute.err) { ret res[str, fail.Fail].err{fail.refused(absolute.err)}; }
    val joined: str = absolute.ok;
    fin { str_free(scratch, joined); }
    val cleaned: res[str, A.Error] = path.clean(scratch, joined);
    if (sel cleaned.err) { ret res[str, fail.Fail].err{fail.refused(cleaned.err)}; }
    ret res[str, fail.Fail].ok{cleaned.ok};
}

# the key holds every path in canonical form; the spelling is added only when
# debug information is requested, because then it reaches the line tables and
# two spellings really do produce two objects
fun key_path(b: *key.Builder, scratch: *A.Allocator, cwd: str, spelled: str, spelling_matters: bool) err[fail.Fail] {
    val canon: res[str, fail.Fail] = canonical(scratch, cwd, spelled);
    if (sel canon.err) { ret err[fail.Fail].err{canon.err}; }
    key.text(b, canon.ok);
    str_free(scratch, canon.ok);
    if (spelling_matters) { key.text(b, spelled); }
    or                    { key.text(b, nil); }
    ret err[fail.Fail].ok{};
}

fun current_dir(scratch: *A.Allocator) res[OwnedString, fail.Fail] {
    val cwd_r: res[OwnedString, env.EnvError] = env.current_dir(scratch);
    if (sel cwd_r.err) { ret res[OwnedString, fail.Fail].err{fail.message("the object cache cannot read the current directory")}; }
    ret res[OwnedString, fail.Fail].ok{cwd_r.ok};
}

# what every module's key shares: the compiler identity, the configuration
# bytes the driver captured (target, platform, project identity), the request,
# the step outputs, the realized dependency closure and the link providers
pub fun configuration(scratch: *A.Allocator, p: *project.Project, config: *u8, config_len: usize,
    compiler_id: *compiler.Identity, digest: *[32]u8) err[fail.Fail] {
    if (scratch == nil || p == nil || p.s == nil || compiler_id == nil || digest == nil
        || compiler_id.len == 0 || compiler_id.len > 32) {
        ret err[fail.Fail].err{fail.message("the cache configuration requires a project and compiler identity")};
    }
    val cwd_r: res[OwnedString, fail.Fail] = current_dir(scratch);
    if (sel cwd_r.err) { ret err[fail.Fail].err{cwd_r.err}; }
    var cwd_owned: OwnedString = cwd_r.ok;
    fin { owned_release(?cwd_owned); }
    val cwd:              str         = cwd_owned.data;
    val spelling_matters: bool        = p.req.debug;
    var b:                key.Builder = key.begin("mach.build-configuration");
    key.number(?b, compiler_id.source::u64);
    key.bytes(?b, ?compiler_id.bytes[0], compiler_id.len);
    key.bytes(?b, config, config_len);
    key.name(?b, ?p.s.interner, p.compiler_name);
    key.name(?b, ?p.s.interner, p.compiler_ver);
    # the request names the project by its spelled root; the key names it canonically
    val canonical_root: res[str, fail.Fail] = canonical(scratch, cwd, p.req.project_root);
    if (sel canonical_root.err) { ret err[fail.Fail].err{canonical_root.err}; }
    var keyed_request: request.BuildRequest = p.req;
    keyed_request.project_root = canonical_root.ok;
    # a test build compiles the build's own objects, whatever tests it selects
    if (request.test_goal(keyed_request.goal)) {
        keyed_request.goal         = request.GOAL_EXECUTE;
        keyed_request.include_deps = false;
    }
    var request_digest: [32]u8;
    val requested:      err[outcome.Fail] = request.semantic_hash(scratch, ?keyed_request, ?request_digest[0]);
    str_free(scratch, canonical_root.ok);
    if (sel requested.err) { ret err[fail.Fail].err{fail.message(outcome.describe(requested.err))}; }
    key.bytes(?b, ?request_digest[0], 32);
    key.number(?b, p.req.placement_policy::u64);
    key.bytes(?b, ?p.step_digest[0], 32);
    key.name(?b, ?p.s.interner, p.config.module);
    key.name(?b, ?p.s.interner, p.config.dir_src);
    val root: opt[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (sel root.none) { ret err[fail.Fail].err{fail.message("the cache configuration has no project root")}; }
    val root_keyed: err[fail.Fail] = key_path(?b, scratch, cwd, root.some, spelling_matters);
    if (sel root_keyed.err) { ret root_keyed; }
    key.number(?b, p.roots::u64);
    key.number(?b, p.config.dep_count::u64);
    var i: u32 = 0;
    for (i < p.config.dep_count) {
        val d: *project.DepEntry = ?p.config.deps[i];
        key.name(?b, ?p.s.interner, d.alias);
        key.name(?b, ?p.s.interner, d.project_id);
        key.name(?b, ?p.s.interner, d.project_dir_src);
        key.name(?b, ?p.s.interner, d.project_module);
        val vendor: opt[str] = intern.lookup(?p.s.interner, d.vendor_root);
        if (sel vendor.none) { ret err[fail.Fail].err{fail.message("the cache configuration dependency has no vendor root")}; }
        val vendor_keyed: err[fail.Fail] = key_path(?b, scratch, cwd, vendor.some, spelling_matters);
        if (sel vendor_keyed.err) { ret vendor_keyed; }
        key.name(?b, ?p.s.interner, d.source);
        key.name(?b, ?p.s.interner, d.ref);
        key.name(?b, ?p.s.interner, d.content);
        key.name(?b, ?p.s.interner, d.manifest.version);
        key.number(?b, d.direct_count::u64);
        var n: u32 = 0;
        for (n < d.direct_count) {
            key.name(?b, ?p.s.interner, d.direct[n]);
            n = n + 1;
        }
        i = i + 1;
    }
    key.number(?b, p.s.link_provider_len::u64);
    i = 0;
    for (i < p.s.link_provider_len) {
        key.name(?b, ?p.s.interner, p.s.link_providers[i].name);
        key.number(?b, p.s.link_providers[i].is_static::u64);
        i = i + 1;
    }
    ret key.finish(?b, digest);
}

# the compiler identity is a process constant: read once per project, reported
# under the readout phase ph that asked for it
pub fun identify(p: *project.Project, ph: u8) err[fail.Fail] {
    if (p.compiler_identity_initialized) { ret err[fail.Fail].ok{}; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret err[fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    val t_identity: readout.Instant     = readout.item_begin(p.events);
    val identified: err[compiler.Error] = compiler.identity(?backing, ?p.compiler_identity);
    if (sel identified.err) {
        val error: compiler.Error = identified.err;
        if (error.kind != compiler.UNAVAILABLE) { ret err[fail.Fail].err{fail.message(error.message)}; }
        readout.item(p.events, ph, "compiler identity unavailable", t_identity);
    }
    if (sel identified.ok) {
        p.compiler_identity_available = true;
        if (p.compiler_identity.source == compiler.SOURCE_BUILD_ID) {
            readout.item(p.events, ph, "compiler identity: build id", t_identity);
        }
        or { readout.item(p.events, ph, "compiler identity: image digest", t_identity); }
    }
    p.compiler_identity_initialized = true;
    ret err[fail.Fail].ok{};
}

pub fun identity_available(p: *project.Project) bool {
    ret p.compiler_identity_initialized && p.compiler_identity_available;
}

# `obj/` is the object cache when the build writes its modules there as
# relocatable objects the target's format reads back
fun objects_cached(p: *project.Project) bool {
    if (p.target.of == nil) { ret false; }
    val vt: *of.OfVTable = p.target.of;
    ret p.object_dir != nil && !vt.produces_image && vt.emit_object != nil && vt.parse_object != nil;
}

# where the build writes module m's object: `obj/<project>/<module path>.<ext>`
pub fun object_path(p: *project.Project, m: *project.ModuleEntry, a: *A.Allocator) res[str, fail.Fail] {
    if (p.object_dir == nil || p.target.of == nil) { ret res[str, fail.Fail].err{fail.message("the build has no object directory")}; }
    val fqn: opt[str] = intern.lookup(?p.s.interner, m.fqn);
    if (sel fqn.none) { ret res[str, fail.Fail].err{fail.message("module FQN not interned")}; }
    val named: res[str, outcome.Fail] = output.mirror_fqn(a, p.object_dir, fqn.some, p.target.of.object_ext);
    if (sel named.err) { ret res[str, fail.Fail].err{fail.message(outcome.describe(named.err))}; }
    ret res[str, fail.Fail].ok{named.ok};
}

# where the build writes module m's test object: `obj/<project>/<module path>.test.<ext>`
pub fun test_object_path(p: *project.Project, m: *project.ModuleEntry, a: *A.Allocator) res[str, fail.Fail] {
    if (p.object_dir == nil || p.target.of == nil) { ret res[str, fail.Fail].err{fail.message("the build has no object directory")}; }
    val fqn: opt[str] = intern.lookup(?p.s.interner, m.fqn);
    if (sel fqn.none) { ret res[str, fail.Fail].err{fail.message("module FQN not interned")}; }
    val suffix: res[str, string.StrError] = str_join(a, "test.", p.target.of.object_ext);
    if (sel suffix.err) { ret res[str, fail.Fail].err{fail.str_refused(suffix.err)}; }
    fin { str_free(a, suffix.ok); }
    val named: res[str, outcome.Fail] = output.mirror_fqn(a, p.object_dir, fqn.some, suffix.ok);
    if (sel named.err) { ret res[str, fail.Fail].err{fail.message(outcome.describe(named.err))}; }
    ret res[str, fail.Fail].ok{named.ok};
}

# the module gets a test object in this build: a test build, and a module whose
# source declares a test or a `#[testing]` declaration
pub fun has_test_object(p: *project.Project, m: *project.ModuleEntry) bool {
    if (!request.test_goal(p.req.goal) || m.a == nil) { ret false; }
    val file: opt[*source.SourceFile] = source.get(?p.s.sources, m.a.file_id);
    if (sel file.none) { ret false; }
    ret testrunner.declares_tests(m.a, file.some.text);
}

# the digest memo in the cell's compiler-only state: `<out>/.cache/digests`,
# none for a build that has no such directory, whose memo lives in memory only
fun memo_path(p: *project.Project, scratch: *A.Allocator) res[opt[str], fail.Fail] {
    if (p.cache_dir == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val file: res[str, A.Error] = path.join(scratch, p.cache_dir, "digests");
    if (sel file.err) { ret res[opt[str], fail.Fail].err{fail.refused(file.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{file.ok}};
}

# a module whose object is cached skips lowering when nothing else needs its
# ir: the ir and asm emitters read it, and a whole-module backend reads every
# referenced module's ir while generating one object
pub fun early_restore_enabled(p: *project.Project) bool {
    ret p.req.object_cache && !p.req.emit_ir && !p.req.emit_asm && !isa.emits_whole_module(p.target.isa);
}

# the module's codegen product is its cached object under the key this load
# built, whether it is still staged or a query already took it
pub fun restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret p.cache_ready && m.cache_keyed && m.cache_hit && key.equal(?m.cache_under, ?m.cache_key);
}

# restored and still staged, which is what the codegen query publishes
pub fun staged_restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret m.staged_image != nil && restored(p, m);
}

# the module's test object is its cached object under the key this load built
pub fun test_restored(p: *project.Project, m: *project.ModuleEntry) bool {
    if (!p.cache_ready || !m.cache_keyed || !m.test.cache_hit) { ret false; }
    var current: [32]u8;
    val keyed:   err[fail.Fail] = test_object_key(p, m, ?current);
    ret sel keyed.ok && key.equal(?m.test.cache_under, ?current);
}

# the restored object was built from the module's whole current source, not
# only its current code: its recorded warnings are this source's
fun restored_exact(p: *project.Project, m: *project.ModuleEntry) bool {
    ret restored(p, m) && key.equal(?m.staged_facts.source, ?m.source_digest);
}

# the test object is restored and still staged for the codegen query to publish
pub fun test_staged_restored(p: *project.Project, m: *project.ModuleEntry) bool {
    ret m.test.staged_image != nil && test_restored(p, m);
}

# the module is restored and nothing needs its lowered ir
pub fun skips_lowering(p: *project.Project, m: *project.ModuleEntry) bool {
    ret restored(p, m) && early_restore_enabled(p);
}

# the emitted modules the build lowers
pub fun lowered_count(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.emit_len) {
        if (!skips_lowering(p, project.module_at(p, p.topo[i]::u32))) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the emitted modules the build generates code for
pub fun generated_count(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.emit_len) {
        if (!restored(p, project.module_at(p, p.topo[i]::u32))) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the modules the front end still processes
pub fun frontend_count(p: *project.Project) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (!project.module_at(p, p.topo[i]::u32).frontend_skipped) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# every key and skip decision of the previous load is dropped: the next load
# keys again, and a project that is not keyed processes every module
pub fun forget(p: *project.Project) {
    p.cache_ready = false;
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        m.cache_keyed      = false;
        m.frontend_skipped = false;
        i                  = i + 1;
    }
}

# the image an `obj/` object's record carries, which is the image codegen
# produced, with the facts beside it
pub rec Cached {
    image: of.ObjectImage;
    facts: cache_record.Facts;
}

# the image the object at `location` records when its record says it was
# built under `expected`, none on a miss: an object that is missing,
# unreadable, carries no record or a damaged one, or was built under another
# key is rebuilt, never reused. the object is parsed only to find its record,
# since what a format spells is not always what the link reads. err only when
# allocation fails
pub fun read(p: *project.Project, location: str, expected: *[32]u8) res[opt[Cached], fail.Fail] {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret res[opt[Cached], fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    val loaded: res[vector.Vector[u8], fs.FsError] = fs.read_bytes(?backing, location);
    if (sel loaded.err) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    var bytes: vector.Vector[u8] = loaded.ok;
    fin { vector.dnit[u8](?bytes); }
    var object: of.ObjectImage = of.object_image_init(p.s.alloc, ?p.s.interner, intern.STR_NIL);
    val parsed: err[fail.Fail] = p.target.of.parse_object(p.s.alloc, ?p.s.interner, bytes.data, bytes.len, ?object);
    if (sel parsed.err) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    fin { of.object_image_dnit(?object); }
    val decoded: res[opt[cache_record.Record], fail.Fail] = cache_record.decode(p.s.alloc, ?p.s.interner,
        object.cache_record, object.cache_record_len::usize);
    if (sel decoded.err)     { ret res[opt[Cached], fail.Fail].err{decoded.err}; }
    if (sel decoded.ok.none) { ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}}; }
    var found: cache_record.Record = decoded.ok.some;
    if (!key.equal(?found.key, expected)) {
        cache_record.record_dnit(p.s.alloc, ?found);
        ret res[opt[Cached], fail.Fail].ok{opt[Cached].none{}};
    }
    ret res[opt[Cached], fail.Fail].ok{opt[Cached].some{Cached{image: found.image, facts: found.facts}}};
}

# the object key of a module: its module key and its name. a module's other
# objects (a test object) key off this one
pub fun object_key(p: *project.Project, m: *project.ModuleEntry, out: *[32]u8) err[fail.Fail] {
    ret key.object(?m.cache_key, project.fqn_name(p, m.fqn), out);
}

# the key of module m's test object: its normal object's key and its whole source
pub fun test_object_key(p: *project.Project, m: *project.ModuleEntry, out: *[32]u8) err[fail.Fail] {
    var normal: [32]u8;
    val keyed:  err[fail.Fail] = object_key(p, m, ?normal);
    if (sel keyed.err) { ret keyed; }
    ret key.test_object(?normal, ?m.source_digest, out);
}

# an object's key leaves the module's tests out, so it is reused across an edit
# to one. its front end then runs and reports its warnings anew, but what its
# back half warned is replayed at the places the old source put it, so an object
# built from other source that recorded such a warning is built again
fun warnings_stand(p: *project.Project, source: [32]u8, facts: *cache_record.Facts) res[bool, fail.Fail] {
    var current: [32]u8 = source;
    if (key.equal(?current, ?facts.source)) { ret res[bool, fail.Fail].ok{true}; }
    val warned: res[bool, fail.Fail] = back_warned(p, facts);
    if (sel warned.err) { ret warned; }
    ret res[bool, fail.Fail].ok{!warned.ok};
}

# read module m's test object under its key, as restore reads its normal object
fun restore_test(p: *project.Project, m: *project.ModuleEntry, ph: u8) res[bool, fail.Fail] {
    val t:        *project.TestObject = ?m.test;
    var expected: [32]u8;
    val keyed:    err[fail.Fail]      = test_object_key(p, m, ?expected);
    if (sel keyed.err)                                                          { ret res[bool, fail.Fail].err{keyed.err}; }
    if (t.cache_checked && t.cache_hit && key.equal(?t.cache_under, ?expected)) { ret res[bool, fail.Fail].ok{true}; }
    project.release_staged_test(p, m);
    t.cache_checked = true;
    t.cache_under   = expected;
    val t_restore: readout.Instant = readout.item_begin(p.events);
    var backing:   A.Allocator;
    val make_r:    err[A.Error]    = page.make(?backing);
    if (sel make_r.err) { ret res[bool, fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    val located: res[str, fail.Fail] = test_object_path(p, m, ?backing);
    if (sel located.err) { ret res[bool, fail.Fail].err{located.err}; }
    val found: res[opt[Cached], fail.Fail] = read(p, located.ok, ?expected);
    str_free(?backing, located.ok);
    if (sel found.err) { ret res[bool, fail.Fail].err{found.err}; }
    if (sel found.ok.none) {
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    var cached: Cached                        = found.ok.some;
    val boxed:  res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](p.s.alloc, 1);
    if (sel boxed.err) {
        cache_record.facts_dnit(p.s.alloc, ?cached.facts);
        of.object_image_dnit(?cached.image);
        ret res[bool, fail.Fail].err{fail.refused(boxed.err)};
    }
    val box: *of.ObjectImage = boxed.ok;
    @box           = cached.image;
    box.name       = m.fqn;
    t.staged_image = box;
    t.staged_facts = cached.facts;
    t.cache_hit    = true;
    p.cache_hits   = p.cache_hits + 1;
    readout.item(p.events, ph, project.fqn_name(p, m.fqn), t_restore);
    ret res[bool, fail.Fail].ok{true};
}

# read module m's object under its key; a hit is staged for the codegen query.
# a hit under the same key stands, and a miss is read again, since the build
# that missed published the object
fun restore(p: *project.Project, m: *project.ModuleEntry, ph: u8) res[bool, fail.Fail] {
    if (m.cache_checked && m.cache_hit && key.equal(?m.cache_under, ?m.cache_key)) {
        val kept: res[bool, fail.Fail] = warnings_stand(p, m.source_digest, ?m.staged_facts);
        if (sel kept.err) { ret kept; }
        if (kept.ok)      { ret res[bool, fail.Fail].ok{true}; }
    }
    project.release_staged(p, m);
    m.cache_checked = true;
    m.cache_under   = m.cache_key;
    val t_restore: readout.Instant = readout.item_begin(p.events);
    var backing:   A.Allocator;
    val make_r:    err[A.Error]    = page.make(?backing);
    if (sel make_r.err) { ret res[bool, fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    var expected: [32]u8;
    val keyed:    err[fail.Fail] = object_key(p, m, ?expected);
    if (sel keyed.err) { ret res[bool, fail.Fail].err{keyed.err}; }
    val located: res[str, fail.Fail] = object_path(p, m, ?backing);
    if (sel located.err) { ret res[bool, fail.Fail].err{located.err}; }
    val found: res[opt[Cached], fail.Fail] = read(p, located.ok, ?expected);
    str_free(?backing, located.ok);
    if (sel found.err) { ret res[bool, fail.Fail].err{found.err}; }
    if (sel found.ok.none) {
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    var cached: Cached               = found.ok.some;
    val stand:  res[bool, fail.Fail] = warnings_stand(p, m.source_digest, ?cached.facts);
    var reused: bool                 = false;
    if (sel stand.ok) { reused = stand.ok; }
    if (!reused) {
        cache_record.facts_dnit(p.s.alloc, ?cached.facts);
        of.object_image_dnit(?cached.image);
        if (sel stand.err) { ret res[bool, fail.Fail].err{stand.err}; }
        p.cache_misses = p.cache_misses + 1;
        ret res[bool, fail.Fail].ok{false};
    }
    val boxed: res[*of.ObjectImage, A.Error] = A.allocate[of.ObjectImage](p.s.alloc, 1);
    if (sel boxed.err) {
        cache_record.facts_dnit(p.s.alloc, ?cached.facts);
        of.object_image_dnit(?cached.image);
        ret res[bool, fail.Fail].err{fail.refused(boxed.err)};
    }
    val box: *of.ObjectImage = boxed.ok;
    @box     = cached.image;
    box.name = m.fqn;
    cache_record.facts_dnit(p.s.alloc, ?m.staged_facts);
    m.staged_image = box;
    m.staged_facts = cached.facts;
    m.cache_hit    = true;
    p.cache_hits   = p.cache_hits + 1;
    readout.item(p.events, ph, project.fqn_name(p, m.fqn), t_restore);
    ret res[bool, fail.Fail].ok{true};
}

# what one load needs while it keys its modules
rec Keying {
    scratch: *A.Allocator;
    cwd:     str;
    config:  [32]u8;
    memo:    memo.Memo;
    now:     opt[time.Time];
    # which surface digest an importer's key reads
    variant: u8;
    # each module's surface digest, 32 bytes at 32 times its module number
    ifaces: *u8;
    ready:  *bool;
    spans:  Vector[token.Span];
}

val SURFACE_BARE:   u8 = 0;
val SURFACE_PLACED: u8 = 1;
val SURFACE_WHOLE:  u8 = 2;

fun compute_digests(k: *Keying, m: *project.ModuleEntry, text: str, out: *memo.Digests) bool {
    sha256.hash(text::*u8, str_len(text), ?out.content[0]);
    vector.clear[token.Span](?k.spans);
    val found: err[fail.Fail] = surface.omitted(m.a, text, ?k.spans);
    if (sel found.err) { ret false; }
    surface.digest(text, ?k.spans, false, ?out.surface);
    surface.digest(text, ?k.spans, true, ?out.placed);
    vector.clear[token.Span](?k.spans);
    val tested: err[fail.Fail] = surface.tests(m.a, text, ?k.spans);
    if (sel tested.err) { ret false; }
    surface.digest(text, ?k.spans, false, ?out.normal);
    surface.digest(text, ?k.spans, true, ?out.normal_placed);
    ret true;
}

fun bytes_equal(a: *u8, a_len: usize, text: str) bool {
    if (a_len != str_len(text)) { ret false; }
    ret memory.raw_equal(a::ptr, text::ptr, a_len);
}

# the digests of the module's text: from the memo when the file still looks
# as it did when it was hashed, else hashed now and remembered when the file
# provably holds the text that was hashed
fun source_digests(k: *Keying, m: *project.ModuleEntry, file: str, text: str, out: *memo.Digests) res[bool, fail.Fail] {
    val observed: opt[memo.Stamp] = memo.stamp(file);
    if (sel observed.none) {
        ret res[bool, fail.Fail].ok{compute_digests(k, m, text, out)};
    }
    var first: memo.Stamp = observed.some;
    if (first.size == str_len(text)::u64) {
        val got: opt[memo.Digests] = memo.lookup(?k.memo, file, ?first);
        if (sel got.some) {
            @out = got.some;
            ret res[bool, fail.Fail].ok{true};
        }
    }
    if (!compute_digests(k, m, text, out)) { ret res[bool, fail.Fail].ok{false}; }
    if (sel k.now.none)                    { ret res[bool, fail.Fail].ok{true}; }
    val read: res[Vector[u8], fs.FsError] = fs.read_bytes(k.scratch, file);
    if (sel read.err) { ret res[bool, fail.Fail].ok{true}; }
    var bytes: Vector[u8] = read.ok;
    fin { vector.dnit[u8](?bytes); }
    if (!bytes_equal(bytes.data, bytes.len, text)) { ret res[bool, fail.Fail].ok{true}; }
    val again: opt[memo.Stamp] = memo.stamp(file);
    if (sel again.none) { ret res[bool, fail.Fail].ok{true}; }
    var second: memo.Stamp = again.some;
    if (first.size != second.size || first.sec != second.sec || first.nsec != second.nsec
        || !memory.raw_equal((?first.identity[0])::ptr, (?second.identity[0])::ptr, 41)) { ret res[bool, fail.Fail].ok{true}; }
    val recorded: err[A.Error] = memo.record(?k.memo, file, ?first, out, k.now.some);
    if (sel recorded.err) { ret res[bool, fail.Fail].err{fail.refused(recorded.err)}; }
    ret res[bool, fail.Fail].ok{true};
}

# the files a module embeds, by path, status, length and digest
fun key_embeds(b: *key.Builder, p: *project.Project, m: *project.ModuleEntry) err[fail.Fail] {
    var paths: Vector[str] = vector.init[str](p.s.alloc);
    fin {
        var i: usize = 0;
        for (i < paths.len) {
            str_free(p.s.alloc, paths.data[i]);
            i = i + 1;
        }
        vector.dnit[str](?paths);
    }
    val collected: err[fail.Fail] = union.module_embeds(p, m, ?paths);
    if (sel collected.err) { ret collected; }
    key.number(b, paths.len::u64);
    var i: usize = 0;
    for (i < paths.len) {
        key.text(b, paths.data[i]);
        val named: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, paths.data[i]);
        if (sel named.err) { ret err[fail.Fail].err{fail.refused(named.err)}; }
        val found: opt[*embed.EmbedFile] = embed.get(?p.s.embeds, named.ok);
        if (sel found.some) {
            val e: *embed.EmbedFile = found.some;
            key.number(b, e.status::u64);
            key.number(b, e.len::u64);
            key.bytes(b, ?e.digest[0], 32);
        }
        or { key.number(b, 0xFFFFFFFF); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# what names a module in both of its digests: its name, its module number,
# its file and the artifact whose comptime values it reads
fun key_module_identity(b: *key.Builder, k: *Keying, p: *project.Project, mid: u32, file: str) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid);
    key.name(b, ?p.s.interner, m.fqn);
    key.number(b, mid::u64);
    key.name(b, ?p.s.interner, m.artifact);
    ret key_path(b, k.scratch, k.cwd, file, p.req.debug);
}

fun iface_of(k: *Keying, mid: u32) *u8 {
    ret (k.ifaces::usize + mid::usize * 32)::*u8;
}

fun key_imports(b: *key.Builder, k: *Keying, m: *project.ModuleEntry) {
    key.number(b, m.dep_count::u64);
    var d: u32 = 0;
    for (d < m.dep_count) {
        key.bytes(b, iface_of(k, m.deps[d]::u32), 32);
        d = d + 1;
    }
}

# key module mid: its import surface for its importers, and its object key.
# a module without a current source, or one importing a module that has no
# surface yet, stays unkeyed and is always built
fun key_module(k: *Keying, p: *project.Project, mid: u32) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid);
    if (m.a == nil || m.file_id == source.FILE_NIL) { ret err[fail.Fail].ok{}; }
    val file_o: opt[*source.SourceFile] = source.get(?p.s.sources, m.file_id);
    if (sel file_o.none) { ret err[fail.Fail].ok{}; }
    val f: *source.SourceFile = file_o.some;
    if (!f.present || f.text == nil || f.path == nil) { ret err[fail.Fail].ok{}; }
    var d: u32 = 0;
    for (d < m.dep_count) {
        val dep: u32 = m.deps[d]::u32;
        if (dep >= project.module_count(p) || !k.ready[dep]) { ret err[fail.Fail].ok{}; }
        d = d + 1;
    }
    val canon: res[str, fail.Fail] = canonical(k.scratch, k.cwd, f.path);
    if (sel canon.err) { ret err[fail.Fail].err{canon.err}; }
    var digests: memo.Digests;
    val known:   res[bool, fail.Fail] = source_digests(k, m, canon.ok, f.text, ?digests);
    str_free(k.scratch, canon.ok);
    if (sel known.err) { ret err[fail.Fail].err{known.err}; }
    if (!known.ok)     { ret err[fail.Fail].ok{}; }

    var iface: key.Builder    = key.begin("mach.module-surface");
    val named: err[fail.Fail] = key_module_identity(?iface, k, p, mid, f.path);
    if (sel named.err)               { ret named; }
    if (k.variant == SURFACE_WHOLE)  { key.bytes(?iface, ?digests.normal_placed[0], 32); }
    or (k.variant == SURFACE_PLACED) { key.bytes(?iface, ?digests.placed[0], 32); }
    or                               { key.bytes(?iface, ?digests.surface[0], 32); }
    val iface_embeds: err[fail.Fail] = key_embeds(?iface, p, m);
    if (sel iface_embeds.err) { ret iface_embeds; }
    key_imports(?iface, k, m);

    var own: key.Builder = key.begin("mach.module-object");
    key.bytes(?own, ?k.config[0], 32);
    val named_own: err[fail.Fail] = key_module_identity(?own, k, p, mid, f.path);
    if (sel named_own.err) { ret named_own; }
    # the module's own code: its tests compile into its test object alone. debug
    # information names where the rest sits, so then their positions count
    if (p.req.debug) { key.bytes(?own, ?digests.normal_placed[0], 32); }
    or               { key.bytes(?own, ?digests.normal[0], 32); }
    val own_embeds: err[fail.Fail] = key_embeds(?own, p, m);
    if (sel own_embeds.err) { ret own_embeds; }
    key_imports(?own, k, m);

    val iface_done: err[fail.Fail] = key.finish(?iface, iface_of(k, mid)::*[32]u8);
    if (sel iface_done.err) { ret iface_done; }
    val own_done: err[fail.Fail] = key.finish(?own, ?m.cache_key);
    if (sel own_done.err) { ret own_done; }
    m.source_digest = digests.content;
    k.ready[mid]    = true;
    m.cache_keyed   = true;
    ret err[fail.Fail].ok{};
}

fun memo_compiler(id: *compiler.Identity, out: *[32]u8) err[fail.Fail] {
    var b: key.Builder = key.begin("mach.digest-memo");
    key.number(?b, id.source::u64);
    key.bytes(?b, ?id.bytes[0], id.len);
    ret key.finish(?b, out);
}

fun key_modules(p: *project.Project, scratch: *A.Allocator, config: *u8, config_len: usize, ph: u8) err[fail.Fail] {
    val t_keys: readout.Instant             = readout.item_begin(p.events);
    val cwd_r:  res[OwnedString, fail.Fail] = current_dir(scratch);
    if (sel cwd_r.err) { ret err[fail.Fail].err{cwd_r.err}; }
    var cwd_owned: OwnedString = cwd_r.ok;
    fin { owned_release(?cwd_owned); }
    var k: Keying = Keying{scratch: scratch, cwd: cwd_owned.data, spans: vector.init[token.Span](scratch)};
    fin { vector.dnit[token.Span](?k.spans); }
    val configured: err[fail.Fail] = configuration(scratch, p, config, config_len, ?p.compiler_identity, ?k.config);
    if (sel configured.err) { ret configured; }
    k.variant = SURFACE_BARE;
    if (p.req.opt == pipeline.OPT_RELEASE) { k.variant = SURFACE_WHOLE; }
    or (p.req.debug)                       { k.variant = SURFACE_PLACED; }
    val clock: time.Clock = time.now();
    k.now = opt[time.Time].none{};
    if (sel clock.ok) { k.now = opt[time.Time].some{clock.ok}; }

    var owner: [32]u8;
    val owned: err[fail.Fail] = memo_compiler(?p.compiler_identity, ?owner);
    if (sel owned.err) { ret owned; }
    val located: res[opt[str], fail.Fail] = memo_path(p, scratch);
    if (sel located.err) { ret err[fail.Fail].err{located.err}; }
    val memo_file: opt[str] = located.ok;
    k.memo = memo.init(scratch, ?owner);
    if (sel memo_file.some) {
        val loaded: res[memo.Memo, A.Error] = memo.load(scratch, ?owner, memo_file.some);
        if (sel loaded.err) { ret err[fail.Fail].err{fail.refused(loaded.err)}; }
        memo.dnit(?k.memo);
        k.memo = loaded.ok;
    }
    fin { memo.dnit(?k.memo); }

    val n:        usize             = project.module_count(p)::usize;
    val ifaces_r: res[*u8, A.Error] = A.zallocate[u8](scratch, (n + 1) * 32);
    if (sel ifaces_r.err) { ret err[fail.Fail].err{fail.refused(ifaces_r.err)}; }
    val ready_r: res[*bool, A.Error] = A.zallocate[bool](scratch, n + 1);
    if (sel ready_r.err) { ret err[fail.Fail].err{fail.refused(ready_r.err)}; }
    k.ifaces = ifaces_r.ok;
    k.ready  = ready_r.ok;
    var i: u32 = 0;
    for (i < p.topo_len) {
        val keyed: err[fail.Fail] = key_module(?k, p, p.topo[i]::u32);
        if (sel keyed.err) { ret keyed; }
        i = i + 1;
    }
    if (sel memo_file.some) {
        val stored: err[outcome.Fail] = memo.store(?k.memo, p.out_dir, memo_file.some);
        if (sel stored.err) { ret err[fail.Fail].err{fail.message(outcome.describe(stored.err))}; }
    }
    readout.item(p.events, ph, "module keys", t_keys);
    ret err[fail.Fail].ok{};
}

# a module's test object is keyed in the query database by its stable id and this bit
pub val TEST_KEY_BIT: u64 = 0x100000000;

# the query key of a module's test object products and its object key input
pub fun test_input_key(m: *project.ModuleEntry) u64 {
    ret m.stable_id::u64 | TEST_KEY_BIT;
}

# every key goes into the query database, so a product restored under one
# key recomputes in a session that later keys the module differently
fun publish_keys(p: *project.Project) err[fail.Fail] {
    if (!query.is_registered(?p.s.queries, query.Q_OBJECT_KEY)) {
        val registered: err[fail.Fail] = query.register_input(?p.s.queries, query.Q_OBJECT_KEY);
        if (sel registered.err) { ret registered; }
    }
    var i: u32 = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.cache_keyed) {
            var digest: [32]u8;
            val keyed:  err[fail.Fail] = object_key(p, m, ?digest);
            if (sel keyed.err) { ret keyed; }
            val set: err[fail.Fail] = query.set_input(?p.s.queries, query.Q_OBJECT_KEY, m.stable_id::u64, ?digest[0], 32);
            if (sel set.err) { ret set; }
            if (has_test_object(p, m)) {
                var tested:     [32]u8;
                val test_keyed: err[fail.Fail] = test_object_key(p, m, ?tested);
                if (sel test_keyed.err) { ret test_keyed; }
                val set_test: err[fail.Fail] = query.set_input(?p.s.queries, query.Q_OBJECT_KEY, test_input_key(m), ?tested[0], 32);
                if (sel set_test.err) { ret set_test; }
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module the build still compiles needs the typed definitions of everything
# it imports, transitively, so only a reused module nothing compiled imports
# skips the front end
fun mark_skipped(p: *project.Project, scratch: *A.Allocator) err[fail.Fail] {
    if (!early_restore_enabled(p)) { ret err[fail.Fail].ok{}; }
    val n:        usize               = project.module_count(p)::usize;
    val needed_r: res[*bool, A.Error] = A.zallocate[bool](scratch, n + 1);
    if (sel needed_r.err) { ret err[fail.Fail].err{fail.refused(needed_r.err)}; }
    val needed: *bool = needed_r.ok;
    var i:      u32   = 0;
    for (i < p.topo_len) {
        val mid: u32                  = p.topo[i]::u32;
        val m:   *project.ModuleEntry = project.module_at(p, mid);
        # an object reused across an edit to the module's tests still has the
        # front end report the warnings of its current source
        if (i >= p.emit_len || !restored_exact(p, m))      { needed[mid] = true; }
        or (has_test_object(p, m) && !test_restored(p, m)) { needed[mid] = true; }
        i = i + 1;
    }
    # the topo lists every module after its imports, so walking it backwards
    # reaches a module's importers first
    i = p.topo_len;
    for (i > 0) {
        i = i - 1;
        val mid: u32 = p.topo[i]::u32;
        if (needed[mid]) {
            val m: *project.ModuleEntry = project.module_at(p, mid);
            var d: u32                  = 0;
            for (d < m.dep_count) {
                val dep: u32 = m.deps[d]::u32;
                if (dep < n::u32) { needed[dep] = true; }
                d = d + 1;
            }
        }
    }
    i = 0;
    for (i < p.topo_len) {
        val mid: u32 = p.topo[i]::u32;
        project.module_at(p, mid).frontend_skipped = !needed[mid];
        i                                          = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# once per load, after the load walk and the embedded inputs, before anything
# is resolved: key every module, read each emitted module's `obj/` object under
# its key, and mark the modules the front end skips. config is the captured
# configuration identity. its items are reported under the readout phase ph
pub fun prepare(p: *project.Project, config: *u8, config_len: usize, ph: u8) err[fail.Fail] {
    forget(p);
    if (!p.req.object_cache || !objects_cached(p)) { ret err[fail.Fail].ok{}; }
    val identified: err[fail.Fail] = identify(p, ph);
    if (sel identified.err)     { ret identified; }
    if (!identity_available(p)) { ret err[fail.Fail].ok{}; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret err[fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    val keyed: err[fail.Fail] = key_modules(p, ?backing, config, config_len, ph);
    if (sel keyed.err) {
        forget(p);
        ret keyed;
    }
    p.cache_ready = true;
    val published: err[fail.Fail] = publish_keys(p);
    if (sel published.err) { ret published; }
    val fresh_r: res[*bool, A.Error] = A.zallocate[bool](?backing, p.emit_len::usize + 1);
    if (sel fresh_r.err) { ret err[fail.Fail].err{fail.refused(fresh_r.err)}; }
    val fresh:    *bool               = fresh_r.ok;
    val tested_r: res[*bool, A.Error] = A.zallocate[bool](?backing, p.emit_len::usize + 1);
    if (sel tested_r.err) { ret err[fail.Fail].err{fail.refused(tested_r.err)}; }
    val fresh_test: *bool = tested_r.ok;
    var i:          u32   = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (m.cache_keyed) {
            # a hit this project already holds reported its warnings then
            fresh[i] = !(m.cache_checked && m.cache_hit && key.equal(?m.cache_under, ?m.cache_key));
            val found: res[bool, fail.Fail] = restore(p, m, ph);
            if (sel found.err) { ret err[fail.Fail].err{found.err}; }
            if (has_test_object(p, m)) {
                fresh_test[i] = !test_restored(p, m);
                val tested: res[bool, fail.Fail] = restore_test(p, m, ph);
                if (sel tested.err) { ret err[fail.Fail].err{tested.err}; }
            }
        }
        or {
            project.release_staged(p, m);
            project.release_staged_test(p, m);
        }
        i = i + 1;
    }
    val marked: err[fail.Fail] = mark_skipped(p, ?backing);
    if (sel marked.err) { ret marked; }
    # the same source reports the same warnings whether it compiled or not
    i = 0;
    for (i < p.emit_len) {
        val m: *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        if (fresh[i] && restored(p, m)) {
            val replayed: err[fail.Fail] = replay_warnings(p, m, !m.frontend_skipped);
            if (sel replayed.err) { ret replayed; }
        }
        if (fresh_test[i] && test_restored(p, m)) {
            val replayed_test: err[fail.Fail] = replay_facts(p, ?m.test.staged_facts, true);
            if (sel replayed_test.err) { ret replayed_test; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# hand the staged image to the query that publishes it; the facts stay with the module
pub fun take_staged(p: *project.Project, m: *project.ModuleEntry) *of.ObjectImage {
    val image: *of.ObjectImage = m.staged_image;
    m.staged_image = nil;
    ret image;
}

pub fun take_staged_test(p: *project.Project, m: *project.ModuleEntry) *of.ObjectImage {
    val image: *of.ObjectImage = m.test.staged_image;
    m.test.staged_image = nil;
    ret image;
}

# what the engine reads from lowered ir, answered from the ir when the module
# lowered and from the restored facts when it did not
pub fun scalarized(p: *project.Project, m: *project.ModuleEntry) u32 {
    if (m.ir_module != nil) { ret m.ir_module.vector_ops_scalarized; }
    ret m.staged_facts.scalarized;
}

# a module's tests, from its lowered test ir or from the facts its restored test object carries
pub fun collect_tests(p: *project.Project, m: *project.ModuleEntry, mid: u32, c: *testrunner.Collected) err[fail.Fail] {
    if (m.test.ir_module != nil) { ret testrunner.collect_module(p.s, c, m.test.ir_module, mid); }
    var i: u32 = 0;
    for (i < m.test.staged_facts.test_count) {
        val f:      *cache_record.TestFact = ?m.test.staged_facts.tests[i];
        val pushed: err[fail.Fail]         = testrunner.push(p.s, c, testrunner.Test{name: f.name, line: f.line, mod_idx: mid});
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module's warnings travel in its record as bytes: per diagnostic whether
# its back half (lowering or codegen) reported it, its severity, kind, location and
# message, then its notes, related locations and fixes. a location is its
# file's path (absent as 0xFFFFFFFF), offset and length; a text is its length
# (absent as 0xFFFFFFFF) and bytes; every number little endian
rec Writer {
    bytes:  Vector[u8];
    failed: bool;
}

val ABSENT: u32 = 0xFFFFFFFF;

fun put(w: *Writer, data: *u8, len: usize) {
    var i: usize = 0;
    for (i < len && !w.failed) {
        val pushed: res[usize, A.Error] = vector.push[u8](?w.bytes, data[i]);
        if (sel pushed.err) { w.failed = true; }
        i = i + 1;
    }
}

fun put_u32(w: *Writer, v: u32) {
    var wire: [4]u8;
    bin.write_u32_le(?wire[0], 0, v);
    put(w, ?wire[0], 4);
}

fun put_u64(w: *Writer, v: u64) {
    var wire: [8]u8;
    bin.write_u64_le(?wire[0], 0, v);
    put(w, ?wire[0], 8);
}

fun put_text(w: *Writer, t: str) {
    if (t == nil) {
        put_u32(w, ABSENT);
        ret;
    }
    put_u32(w, str_len(t)::u32);
    put(w, t::*u8, str_len(t));
}

fun put_place(w: *Writer, p: *project.Project, loc: diagnostic.Location) {
    var file: str = nil;
    if (loc.file_id != source.FILE_NIL) {
        val found: opt[*source.SourceFile] = source.get(?p.s.sources, loc.file_id);
        if (sel found.some) { file = found.some.path; }
    }
    put_text(w, file);
    put_u64(w, loc.span.offset::u64);
    put_u64(w, loc.span.len::u64);
}

fun put_warnings(w: *Writer, p: *project.Project, store: *diagnostic.DiagnosticStore, back: bool) {
    if (store == nil) { ret; }
    var i: usize = 0;
    for (i < store.items.len) {
        val d: *diagnostic.Diagnostic = ?store.items.data[i];
        if (d.severity != diagnostic.SEVERITY_ERROR) {
            var phase: u8 = 0;
            if (back) { phase = 1; }
            put(w, ?phase, 1);
            var severity: u8 = d.severity::u8;
            put(w, ?severity, 1);
            var named: u8 = d.kind::u8;
            put(w, ?named, 1);
            put_place(w, p, d.loc);
            put_text(w, d.message);
            put_u32(w, d.children.len::u32);
            var c: usize = 0;
            for (c < d.children.len) {
                var kind: u8 = d.children.data[c].kind::u8;
                put(w, ?kind, 1);
                put_text(w, d.children.data[c].text);
                c = c + 1;
            }
            put_u32(w, d.related.len::u32);
            c = 0;
            for (c < d.related.len) {
                put_place(w, p, d.related.data[c].loc);
                put_text(w, d.related.data[c].label);
                c = c + 1;
            }
            put_u32(w, d.fixes.len::u32);
            c = 0;
            for (c < d.fixes.len) {
                val fx: *diagnostic.Fix = ?d.fixes.data[c];
                put_text(w, fx.label);
                put_u32(w, fx.edits.len::u32);
                var e: usize = 0;
                for (e < fx.edits.len) {
                    put_place(w, p, fx.edits.data[e].loc);
                    put_text(w, fx.edits.data[e].replacement);
                    e = e + 1;
                }
                c = c + 1;
            }
        }
        i = i + 1;
    }
}

# the warnings module m's products reported: its front end keyed by its
# stable id, its back half by back_key
fun gather_warnings(p: *project.Project, m: *project.ModuleEntry, front_too: bool, back_key: u64, scratch: *A.Allocator, facts: *cache_record.Facts) err[fail.Fail] {
    var w: Writer = Writer{bytes: vector.init[u8](scratch)};
    fin { vector.dnit[u8](?w.bytes); }
    val front: [4]query.QueryKind = [4]query.QueryKind{query.Q_RESOLVE, query.Q_EXPORTS, query.Q_SEMA, query.Q_TYPED_EXPORTS};
    val back:  [3]query.QueryKind = [3]query.QueryKind{query.Q_INLINE_BODIES, query.Q_LOWER, query.Q_CODEGEN};
    var i:     usize              = 0;
    for (i < 4 && front_too) {
        put_warnings(?w, p, query.product_diagnostics(?p.s.queries, front[i], m.stable_id::u64), false);
        i = i + 1;
    }
    i = 0;
    for (i < 3) {
        put_warnings(?w, p, query.product_diagnostics(?p.s.queries, back[i], back_key), true);
        i = i + 1;
    }
    if (w.failed)                 { ret err[fail.Fail].err{fail.message("out of memory recording a module's warnings")}; }
    if (w.bytes.len == 0)         { ret err[fail.Fail].ok{}; }
    if (w.bytes.len > 0xFFFFFFF0) { ret err[fail.Fail].err{fail.message("a module's warnings exceed the cache record")}; }
    val kept: res[*u8, A.Error] = A.allocate[u8](scratch, w.bytes.len);
    if (sel kept.err) { ret err[fail.Fail].err{fail.refused(kept.err)}; }
    memory.raw_copy(kept.ok::ptr, w.bytes.data::ptr, w.bytes.len);
    facts.warnings     = kept.ok;
    facts.warnings_len = w.bytes.len::u32;
    ret err[fail.Fail].ok{};
}

rec WarningReader {
    data: *u8;
    len:  usize;
    pos:  usize;
    bad:  bool;
}

fun take(r: *WarningReader, n: usize) *u8 {
    if (r.bad || r.len - r.pos < n) {
        r.bad = true;
        ret nil;
    }
    val at: *u8 = (r.data::usize + r.pos)::*u8;
    r.pos = r.pos + n;
    ret at;
}

fun take_u8(r: *WarningReader) u8 {
    val at: *u8 = take(r, 1);
    if (at == nil) { ret 0; }
    ret at[0];
}

fun take_u32(r: *WarningReader) u32 {
    val at: *u8 = take(r, 4);
    if (at == nil) { ret 0; }
    ret bin.read_u32_le(at, 0);
}

fun take_u64(r: *WarningReader) u64 {
    val at: *u8 = take(r, 8);
    if (at == nil) { ret 0; }
    ret bin.read_u64_le(at, 0);
}

# a text as a nul-terminated copy in a, nil when absent
fun take_text(r: *WarningReader, a: *A.Allocator) str {
    val len: u32 = take_u32(r);
    if (r.bad || len == ABSENT) { ret nil; }
    val at: *u8 = take(r, len::usize);
    if (at == nil) { ret nil; }
    val copied: res[*u8, A.Error] = A.allocate[u8](a, len::usize + 1);
    if (sel copied.err) {
        r.bad = true;
        ret nil;
    }
    memory.raw_copy(copied.ok::ptr, at::ptr, len::usize);
    copied.ok[len::usize] = 0;
    ret copied.ok::str;
}

rec Place {
    file: source.FileId;
    span: token.Span;
}

# a recorded location, in the file this session loaded under that path, or
# unlocated when it loaded none
fun take_place(r: *WarningReader, p: *project.Project, a: *A.Allocator) Place {
    var at:   Place = Place{file: source.FILE_NIL};
    val file: str   = take_text(r, a);
    at.span.offset = take_u64(r)::usize;
    at.span.len    = take_u64(r)::usize;
    if (file == nil) { ret at; }
    val named: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, file);
    if (sel named.err) {
        r.bad = true;
        ret at;
    }
    var id:    intern.StrId        = named.ok;
    val found: opt[*source.FileId] = map.get[intern.StrId, source.FileId](?p.s.sources.by_path, ?id);
    if (sel found.some) { at.file = @found.some; }
    ret at;
}

# read one recorded diagnostic and report it unless back_only skips it or the
# read is only a scan; back_seen is set when its back half reported it. false
# once the bytes are exhausted or malformed
fun replay_one(r: *WarningReader, p: *project.Project, scratch: *A.Allocator, back_only: bool,
    scan: bool, back_seen: *bool) res[bool, fail.Fail] {
    val back:     bool                = take_u8(r) != 0;
    val severity: diagnostic.Severity = take_u8(r)::diagnostic.Severity;
    val named:    dkind.Kind          = take_u8(r)::dkind.Kind;
    val at:       Place               = take_place(r, p, scratch);
    val message:  str                 = take_text(r, scratch);
    if (r.bad || message == nil || !diagnostic.severity_valid(severity) || severity == diagnostic.SEVERITY_ERROR) { ret res[bool, fail.Fail].ok{false}; }
    val begun: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(p.diags.a, severity, at.file, at.span, message);
    if (sel begun.err) { ret res[bool, fail.Fail].err{begun.err}; }
    var b: diagnostic.DiagnosticBuilder = begun.ok;
    fin { diagnostic.builder_dnit(?b); }
    b.kind = named;
    var built:    err[fail.Fail] = err[fail.Fail].ok{};
    val children: u32            = take_u32(r);
    var c:        u32            = 0;
    for (c < children && !r.bad) {
        val kind: u8  = take_u8(r);
        val text: str = take_text(r, scratch);
        if (text == nil)                                         { r.bad = true; }
        or (kind::diagnostic.ChildKind == diagnostic.CHILD_HELP) { built = diagnostic.attach_help(?b, text); }
        or                                                       { built = diagnostic.attach_note(?b, text); }
        if (sel built.err)                                       { ret res[bool, fail.Fail].err{built.err}; }
        c = c + 1;
    }
    val related: u32 = take_u32(r);
    c = 0;
    for (c < related && !r.bad) {
        val loc:   Place = take_place(r, p, scratch);
        val label: str   = take_text(r, scratch);
        built = diagnostic.attach_related(?b, loc.file, loc.span, label);
        if (sel built.err) { ret res[bool, fail.Fail].err{built.err}; }
        c = c + 1;
    }
    val fixes: u32 = take_u32(r);
    c = 0;
    for (c < fixes && !r.bad) {
        val label:  str              = take_text(r, scratch);
        val edits:  u32              = take_u32(r);
        var opened: bool             = false;
        var fix:    diagnostic.FixId = 0;
        var e:      u32              = 0;
        for (e < edits && !r.bad) {
            val loc:         Place = take_place(r, p, scratch);
            val replacement: str   = take_text(r, scratch);
            if (opened) {
                built = diagnostic.attach_fix_edit(?b, fix, loc.file, loc.span, replacement);
                if (sel built.err) { ret res[bool, fail.Fail].err{built.err}; }
            }
            or {
                val made: res[diagnostic.FixId, fail.Fail] = diagnostic.attach_fix(?b, label, loc.file, loc.span, replacement);
                if (sel made.err) { ret res[bool, fail.Fail].err{made.err}; }
                fix    = made.ok;
                opened = true;
            }
            e = e + 1;
        }
        c = c + 1;
    }
    if (r.bad) { ret res[bool, fail.Fail].ok{false}; }
    if (back)  { @back_seen = true; }
    if (!scan && (back || !back_only)) {
        val committed: res[opt[diagnostic.DiagnosticId], fail.Fail] = diagnostic.commit(?b, ?p.diags);
        if (sel committed.err) { ret res[bool, fail.Fail].err{committed.err}; }
    }
    ret res[bool, fail.Fail].ok{true};
}

# report a restored module's recorded warnings again; with back_only, only
# those of its back half, since its front end ran and reported the rest
fun replay_warnings(p: *project.Project, m: *project.ModuleEntry, back_only: bool) err[fail.Fail] {
    ret replay_facts(p, ?m.staged_facts, back_only);
}

fun replay_facts(p: *project.Project, facts: *cache_record.Facts, back_only: bool) err[fail.Fail] {
    var back_seen: bool                 = false;
    val read:      res[bool, fail.Fail] = read_warnings(p, facts, back_only, false, ?back_seen);
    if (sel read.err) { ret err[fail.Fail].err{read.err}; }
    ret err[fail.Fail].ok{};
}

# the object's back half reported a warning: lowering or generating it again
# would report it where the current source puts it
fun back_warned(p: *project.Project, facts: *cache_record.Facts) res[bool, fail.Fail] {
    var back_seen: bool                 = false;
    val read:      res[bool, fail.Fail] = read_warnings(p, facts, true, true, ?back_seen);
    if (sel read.err) { ret read; }
    ret res[bool, fail.Fail].ok{back_seen};
}

fun read_warnings(p: *project.Project, facts: *cache_record.Facts, back_only: bool, scan: bool, back_seen: *bool) res[bool, fail.Fail] {
    if (facts.warnings_len == 0) { ret res[bool, fail.Fail].ok{true}; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret res[bool, fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    var r: WarningReader = WarningReader{data: facts.warnings, len: facts.warnings_len::usize};
    for (r.pos < r.len && !r.bad) {
        val more: res[bool, fail.Fail] = replay_one(?r, p, ?backing, back_only, scan, back_seen);
        if (sel more.err) { ret more; }
        if (!more.ok)     { brk; }
    }
    ret res[bool, fail.Fail].ok{true};
}

fun gather_facts(scratch: *A.Allocator, irmod: *ir.Module, facts: *cache_record.Facts) err[fail.Fail] {
    facts.scalarized = irmod.vector_ops_scalarized;
    var tests: u32 = 0;
    var i:     u32 = 0;
    for (i < irmod.function_len) {
        if ((irmod.functions[i].flags & ir.FN_FLAG_TEST) != 0) { tests = tests + 1; }
        i = i + 1;
    }
    if (tests == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*cache_record.TestFact, A.Error] = A.allocate[cache_record.TestFact](scratch, tests::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    facts.tests      = allocated.ok;
    facts.test_count = tests;
    var n: u32 = 0;
    i = 0;
    for (i < irmod.function_len) {
        val fn: *ir.Function = ?irmod.functions[i];
        if ((fn.flags & ir.FN_FLAG_TEST) != 0) {
            facts.tests[n] = cache_record.TestFact{name: fn.name, line: fn.line};
            n              = n + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a generated image carries its record into `obj/`: the key it was built
# under, the facts its lowered ir holds, and the image itself
pub fun publish(p: *project.Project, m: *project.ModuleEntry, image: *of.ObjectImage, back_key: u64) err[fail.Fail] {
    if (!p.cache_ready || !m.cache_keyed || restored(p, m)) { ret err[fail.Fail].ok{}; }
    var digest: [32]u8;
    val keyed:  err[fail.Fail] = object_key(p, m, ?digest);
    if (sel keyed.err) { ret keyed; }
    ret publish_record(p, m, m.ir_module, true, back_key, ?digest, image);
}

# the same for the module's test object, which records only its own back half's
# warnings: the normal object carries the front end's
pub fun publish_test(p: *project.Project, m: *project.ModuleEntry, image: *of.ObjectImage, back_key: u64) err[fail.Fail] {
    if (!p.cache_ready || !m.cache_keyed || test_restored(p, m)) { ret err[fail.Fail].ok{}; }
    var digest: [32]u8;
    val keyed:  err[fail.Fail] = test_object_key(p, m, ?digest);
    if (sel keyed.err) { ret keyed; }
    ret publish_record(p, m, m.test.ir_module, false, back_key, ?digest, image);
}

fun publish_record(p: *project.Project, m: *project.ModuleEntry, irmod: *ir.Module, front_too: bool,
    back_key: u64, digest: *[32]u8, image: *of.ObjectImage) err[fail.Fail] {
    if (irmod == nil) { ret err[fail.Fail].err{fail.message("cache publication requires the module's lowered ir")}; }
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret err[fail.Fail].err{fail.message("cache scratch allocator is unavailable")}; }
    var facts: cache_record.Facts = cache_record.Facts{source: m.source_digest};
    fin { cache_record.facts_dnit(?backing, ?facts); }
    val gathered: err[fail.Fail] = gather_facts(?backing, irmod, ?facts);
    if (sel gathered.err) { ret gathered; }
    val warned: err[fail.Fail] = gather_warnings(p, m, front_too, back_key, ?backing, ?facts);
    if (sel warned.err) { ret warned; }
    var bytes:   *u8            = nil;
    var len:     u32            = 0;
    val encoded: err[fail.Fail] = cache_record.encode(image.alloc, image.interner, digest, ?facts, image, ?bytes, ?len);
    if (sel encoded.err)           { ret encoded; }
    if (image.cache_record != nil) { A.deallocate[u8](image.alloc, image.cache_record, image.cache_record_len::usize); }
    image.cache_record     = bytes;
    image.cache_record_len = len;
    ret err[fail.Fail].ok{};
}

#[testing]
fun t_configured(p: *project.Project, config: *[1]u8, compiler_id: *compiler.Identity, out: *[32]u8) bool {
    val configured: err[fail.Fail] = configuration(p.alloc, p, config::*u8, 1, compiler_id, out);
    ret sel configured.ok;
}

# every input the configuration names moves it, and nothing else does: the
# compiler identity, the captured configuration, each request field that
# reaches codegen, the step outputs, the dependency closure and the link
# providers
test configuration__tracks_compiler_request_steps_dependencies_and_providers {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = session.init(?a);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var p: project.Project;
    project.init_project(?p, ?s);
    fin {
        p.config.deps      = nil;
        p.config.dep_count = 0;
        project.dnit_project(?p);
    }
    p.config.dir_src = intern.STR_NIL;
    val root_id: res[intern.StrId, A.Error] = intern.intern(?s.interner, "/project");
    if (sel root_id.err) { ret 3; }
    p.config.project_root = root_id.ok;
    p.req.project_root    = "/project";
    val names: [9]str = [9]str{"content-1", "revision-1", "1.0.0", "support", "path", "/project/dep/support", "src", "lib", "changed"};
    var ids:   [9]intern.StrId;
    var nidx:  usize  = 0;
    for (nidx < 9) {
        val named: res[intern.StrId, A.Error] = intern.intern(?s.interner, names[nidx]);
        if (sel named.err) { ret 3; }
        ids[nidx] = named.ok;
        nidx      = nidx + 1;
    }
    var direct_aliases: [1]intern.StrId = [1]intern.StrId{ids[3]};
    var dependencies:   [1]project.DepEntry;
    dependencies[0].alias            = ids[3];
    dependencies[0].project_id       = ids[3];
    dependencies[0].source           = ids[4];
    dependencies[0].vendor_root      = ids[5];
    dependencies[0].project_dir_src  = ids[6];
    dependencies[0].project_module   = ids[7];
    dependencies[0].content          = ids[0];
    dependencies[0].ref              = ids[1];
    dependencies[0].manifest.version = ids[2];
    dependencies[0].direct           = ?direct_aliases[0];
    dependencies[0].direct_count     = 1;
    p.config.deps                    = ?dependencies[0];
    p.config.dep_count               = 1;
    var compiler_id: compiler.Identity;
    compiler.identity_clear(?compiler_id);
    compiler_id.len    = 32;
    compiler_id.source = compiler.SOURCE_DIGEST;
    var config:   [1]u8 = [1]u8{1};
    var baseline: [32]u8;
    var changed:  [32]u8;
    if (!t_configured(?p, ?config, ?compiler_id, ?baseline)) { ret 4; }
    val original: request.BuildRequest = p.req;
    var axis:     u32                  = 0;
    for (axis < 15) {
        p.req = original;
        if (axis == 0)  { compiler_id.bytes[0] = 1; }
        if (axis == 1)  { compiler_id.source = compiler.SOURCE_BUILD_ID; }
        if (axis == 2)  { compiler_id.len = 16; }
        if (axis == 3)  { config[0] = 2; }
        if (axis == 4)  { p.req.target = "another-target"; }
        if (axis == 5)  { p.req.profile = "another-profile"; }
        if (axis == 6)  { p.req.artifact = "another-artifact"; }
        if (axis == 7)  { p.req.debug = true; }
        if (axis == 8)  { p.req.float_reassoc = !p.req.float_reassoc; }
        if (axis == 9)  { p.req.placement_policy = 17; }
        if (axis == 10) { p.step_digest[0] = 1; }
        if (axis == 11) { dependencies[0].content = ids[8]; }
        if (axis == 12) { dependencies[0].ref = ids[8]; }
        if (axis == 13) { dependencies[0].manifest.version = ids[8]; }
        if (axis == 14) { direct_aliases[0] = ids[8]; }
        val captured: bool = t_configured(?p, ?config, ?compiler_id, ?changed);
        dependencies[0].content          = ids[0];
        dependencies[0].ref              = ids[1];
        dependencies[0].manifest.version = ids[2];
        direct_aliases[0]                = ids[3];
        compiler_id.bytes[0]             = 0;
        compiler_id.len                  = 32;
        compiler_id.source               = compiler.SOURCE_DIGEST;
        config[0]                        = 1;
        p.step_digest[0]                 = 0;
        if (!captured || key.equal(?baseline, ?changed)) { ret (10 + axis)::i32; }
        axis = axis + 1;
    }
    # what does not reach an object leaves it alone
    p.req         = original;
    p.req.jobs    = 17;
    p.req.emit_ir = true;
    if (!t_configured(?p, ?config, ?compiler_id, ?changed) || !key.equal(?baseline, ?changed)) { ret 30; }
    # a test build compiles the build's own objects, whichever tests it selects
    p.req      = original;
    p.req.goal = request.GOAL_TESTS;
    if (!t_configured(?p, ?config, ?compiler_id, ?changed) || !key.equal(?baseline, ?changed)) { ret 31; }
    p.req.goal         = request.GOAL_TEST_LIST;
    p.req.include_deps = true;
    p.req.test_filter  = "some#test";
    if (!t_configured(?p, ?config, ?compiler_id, ?changed) || !key.equal(?baseline, ?changed)) { ret 32; }
    # another spelling of the same root keys the same configuration, unless
    # debug information is requested and the spelling reaches the line tables
    p.req              = original;
    p.req.project_root = "/project/./";
    val spelled_root: res[intern.StrId, A.Error] = intern.intern(?s.interner, "/project/./");
    if (sel spelled_root.err) { ret 33; }
    p.config.project_root = spelled_root.ok;
    if (!t_configured(?p, ?config, ?compiler_id, ?changed) || !key.equal(?baseline, ?changed)) { ret 34; }
    p.req.debug = true;
    var debug_spelled: [32]u8;
    if (!t_configured(?p, ?config, ?compiler_id, ?debug_spelled)) { ret 35; }
    p.config.project_root = root_id.ok;
    p.req.project_root    = "/project";
    var debug_canonical: [32]u8;
    if (!t_configured(?p, ?config, ?compiler_id, ?debug_canonical) || key.equal(?debug_spelled, ?debug_canonical)) { ret 36; }
    p.req           = original;
    compiler_id.len = 0;
    if (t_configured(?p, ?config, ?compiler_id, ?changed)) { ret 37; }
    compiler_id.len = 32;
    val register_link_provider_r: err[fail.Fail] = session.register_link_provider(?s, ids[3], false);
    if (sel register_link_provider_r.err)                    { ret 38; }
    if (!t_configured(?p, ?config, ?compiler_id, ?baseline)) { ret 38; }
    s.link_providers[0].is_static = true;
    if (!t_configured(?p, ?config, ?compiler_id, ?changed) || key.equal(?baseline, ?changed)) { ret 39; }
    ret 0;
}
