# the extension mach names the object files of its work directory by, whatever the
# format: mink reads an object by its bytes, never its name
pub val OBJECT_EXT: str = "o";

# the target a build compiles for and the formats it reads and writes
# ---
# assembled: the target mirl assembled for the resolved target, nil before one is opened
# machine:   what lowering builds its units for, borrowing `assembled`
# format:    the object format the target writes
# formats:   mink's format registry
# prepared:  the target mirl made ready for the build, once, which every module's compile reads;
#            on the heap, since it stays put until it is closed. nil before one is opened
pub rec Back {
    assembled: *assembled.Assembled;
    machine:   lower_context.Machine;
    format:    *Format;
    formats:   registry.Registry;
    opened:    bool;
    prepared:  *mirl_compile.Prepared;
}

# a back half that compiles nothing, for a project with no target yet
pub fun none() Back {
    var b: Back;
    b.assembled = nil;
    b.format    = nil;
    b.opened    = false;
    b.prepared  = nil;
    ret b;
}

# the back half of the resolved target `t`
pub fun open(a: *A.Allocator, t: *resolved.Target) res[Back, fail.Fail] {
    var b:       Back                         = none();
    val formats: res[registry.Registry, Fail] = registry.builtin(a);
    if (sel formats.err) { ret res[Back, fail.Fail].err{refused_by_mink(a, "mink's formats did not open", formats.err)}; }
    b.formats = formats.ok;
    b.opened  = true;
    val made: res[*assembled.Assembled, fail.Fail] = assembled.assemble(a, t);
    if (sel made.err) {
        close(a, ?b);
        ret res[Back, fail.Fail].err{made.err};
    }
    b.assembled = made.ok;
    val machine: res[lower_context.Machine, fail.Fail] = lower_context.machine_of(b.assembled);
    if (sel machine.err) {
        close(a, ?b);
        ret res[Back, fail.Fail].err{machine.err};
    }
    b.machine          = machine.ok;
    b.machine.directed = directs_exports(?b.formats, t.format);
    b.format           = t.format;
    # mirl readies the target once for the build, its extensions with it; a target it cannot
    # ready is refused for the build
    val held: res[*mirl_compile.Prepared, A.Error] = A.allocate[mirl_compile.Prepared](a, 1::usize);
    if (sel held.err) {
        close(a, ?b);
        ret res[Back, fail.Fail].err{fail.refused(held.err)};
    }
    val readied: err[mirl_compile.Error] = mirl_compile.open(held.ok, a, ?b.assembled.target, assembled.added(b.assembled));
    if (sel readied.err) {
        A.deallocate[mirl_compile.Prepared](a, held.ok, 1::usize);
        close(a, ?b);
        ret res[Back, fail.Fail].err{fail.user(diagnostic_kind.TARGET_UNSUPPORTED, "mirl cannot ready the target for a build: no back end serves it, or its extensions do not open")};
    }
    b.prepared = held.ok;
    ret res[Back, fail.Fail].ok{b};
}

# whether an image of format `f` exports only what its inputs' export directives name, so a
# definition states no visibility; false for a format mink links no image of
fun directs_exports(g: *registry.Registry, f: *Format) bool {
    if (f == nil) { ret false; }
    val r: res[*Registration, Fail] = registry.by_format(g, f);
    if (sel r.err) { ret false; }
    val via: res[*Registration, Fail] = registry.links_of(g, r.ok);
    if (sel via.err) { ret false; }
    val rules: res[*Linking, Fail] = registration.linking(via.ok);
    if (sel rules.err) { ret false; }
    ret (rules.ok.caps & linking.DIRECTED_EXPORTS) != 0;
}

pub fun close(a: *A.Allocator, b: *Back) {
    if (b.prepared != nil) {
        mirl_compile.close(b.prepared);
        A.deallocate[mirl_compile.Prepared](a, b.prepared, 1::usize);
    }
    if (b.assembled != nil) { assembled.release(a, b.assembled); }
    if (b.opened)           { val released: err[Fail] = registry.release(?b.formats); }
    @b = none();
}

# the machine lowering builds for, refused for a cell no owner assembles yet
pub fun machine(b: *Back) res[*lower_context.Machine, fail.Fail] {
    if (b.assembled == nil) { ret res[*lower_context.Machine, fail.Fail].err{fail.message("no target is open, so the build has no back end")}; }
    ret res[*lower_context.Machine, fail.Fail].ok{?b.machine};
}

# mink's failure `f` as mach's, under `lead`: what mink does not do is the input's to change, and
# every other cause is the compiler's
pub fun refused_by_mink(a: *A.Allocator, lead: str, f: Fail) fail.Fail {
    var out:  Sink      = sink.make(a, LITTLE);
    val r:    err[Fail] = diag.render(f, ?out);
    var text: str       = "";
    if (sel r.ok && sink.len(?out) > 0) {
        val n:      usize             = sink.len(?out) - 1;
        val copied: res[*u8, A.Error] = A.allocate[u8](a, n + 1);
        if (sel copied.ok) {
            memory.copy[u8](copied.ok, sink.data(?out), n);
            copied.ok[n] = 0;
            text         = copied.ok::str;
        }
    }
    val freed: err[Fail] = sink.release(?out);
    if (sel f.cause.unsupported) { ret fail.user_of(diagnostic_kind.LINK_INPUT_INVALID, fail.join(a, lead, ": ", text)); }
    ret fail.message_of(fail.join(a, lead, ": ", text));
}

# the mirl module `m` compiled to mink's object at mirl's level `level`, its schedule's own checks
# run with `checked`, the linker let relax its code with `relax` and the float relaxations `floats`
# permitted, masc's listing of the object written to `listing` when there is one, and its stages
# timed and counted into `stats` when there is one. the module is the schedule's to rewrite, so
# it is spent here
pub fun compile(b: *Back, a: *A.Allocator, m: *Module, level: u8, checked: bool, relax: bool, floats: relaxation.Relaxations,
    listing: opt[*std_writer.Writer], stats: opt[*mirl_stats.Stats], name: str) res[Object, fail.Fail] {
    if (b.assembled == nil || b.prepared == nil) { ret res[Object, fail.Fail].err{fail.message("no target is open, so the build has no back end")}; }
    val o: mirl_compile.Options = mirl_compile.Options{
        output:   mirl_family.Output.object{},
        relax:    relax,
        floats:   floats,
        level:    level::mirl_pass.Level,
        checked:  checked,
        machine:  opt[*std_writer.Writer].none{},
        listing:  listing,
        warnings: opt[*std_writer.Writer].none{},
        apart:    mirl_compile.SHARED,
        stats:    stats
    };
    val made: res[Object, mirl_compile.Error] = mirl_compile.compile(b.prepared, a, m, o);
    if (sel made.ok) { ret res[Object, fail.Fail].ok{made.ok}; }
    ret res[Object, fail.Fail].err{uncompiled(a, m, name, made.err)};
}

# why mirl did not compile the module `name`. which of mirl's and masc's refusals the source can
# clear is decided here, by their own cases: such a refusal is a user failure under its row of the
# diagnostic table, at the source location mirl states for it when it states one, and every other
# refusal is the compiler's, which `fail.user_of` keeps internal for a case that names no row
fun uncompiled(a: *A.Allocator, m: *Module, name: str, e: mirl_compile.Error) fail.Fail {
    if (sel e.timing) { ret untimed(a, m, name, e.timing, "the ir's constant-time check"); }
    var why: str = "its back end refused it";
    if (sel e.back) {
        val back: mirl_family.Back = e.back;
        if (sel back.register) { ret register_refused(a, m, name, back.register); }
        if (sel back.spirv)    { ret spirv_refused(a, m, name, back.spirv); }
        if (sel back.wasm)     { ret wasm_refused(a, m, name, back.wasm); }
    }
    if (sel e.foreign)    { ret foreign_refused(a, m, name, e.foreign); }
    if (sel e.unserved)   { why = "no family of mirl serves the target"; }
    or (sel e.listing)    { why = "mirl's families do not list their owners"; }
    or (sel e.open)       { why = "mirl opened no build of the target's selection"; }
    or (sel e.schedule)   { ret schedule_refused(a, m, name, e.schedule); }
    or (sel e.introduced) { why = "mirl's schedule left an operation the target's family does not serve"; }
    or (sel e.alloc)      { ret fail.refused(e.alloc); }
    ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': ", why));
}

# the same failure at the source location `at` of the debug table of `m`, which holds a line and a
# column and no extent; a location mirl does not state leaves it pointing nowhere
fun sourced(a: *A.Allocator, m: *Module, f: fail.Fail, at: opt[mirl_debug.Location]) fail.Fail {
    if (sel at.none) { ret f; }
    val position: res[mirl_debug.Position, mirl_debug.Error] = mirl_debug.position(?m.debug, at.some);
    if (sel position.err) { ret f; }
    val path: res[View, mirl_debug.Error] = mirl_debug.path(?m.debug, position.ok.file);
    if (sel path.err) { ret f; }
    val copied: res[str, StrError] = str_copy_slice(a, path.ok.data, 0, path.ok.len);
    if (sel copied.err) { ret fail.str_refused(copied.err); }
    val start: lang_source.Position = lang_source.Position{line: position.ok.line::usize, col: position.ok.column::usize};
    ret fail.located(a, f, fail.Place{path: copied.ok, start: start, end: start});
}

# a function of the module `name` holding an operation the target's family does not serve
fun foreign_refused(a: *A.Allocator, m: *Module, name: str, e: mirl_compile.Foreign) fail.Fail {
    val fname: res[str, fail.Fail] = function_name(a, m, e.function);
    if (sel fname.err) { ret fname.err; }
    ret fail.user_of(diagnostic_kind.TARGET_UNSUPPORTED_OP, fail.join(a, "'", fname.ok, "' of '", name, "' holds the operation ", e.row.name, ", which the target's family does not serve"));
}

# what mirl's pass schedule refused of the module `name`: the pass, the function and why, as
# mirl's error states them
fun schedule_refused(a: *A.Allocator, m: *Module, name: str, e: pass_failure.Error) fail.Fail {
    if (sel e.alloc) { ret fail.refused(e.alloc); }
    if (sel e.input) { ret fail.message_of(fail.join(a, "mirl's schedule refused '", name, "' before any pass ran: ", e.input.what)); }
    if (sel e.unverified) {
        val u:    pass_failure.Unverified = e.unverified;
        var what: str                     = "the verifier ran out of storage";
        if (sel u.error.refused) { what = u.error.refused.what; }
        ret fail.message_of(fail.join(a, "mirl's verifier refused '", name, "' after the pass ", u.pass, ": ", what));
    }
    if (sel e.refused) {
        val r:     pass_failure.Refusal = e.refused;
        var where: str                  = "the module";
        if (sel r.function.some) {
            val fname: res[str, fail.Fail] = function_name(a, m, r.function.some);
            if (sel fname.err) { ret fname.err; }
            where = fname.ok;
        }
        val refused: fail.Fail = fail.user_of(pass_kind(r.why), fail.join(a, "mirl's pass ", r.pass, " refused '", where, "' of '", name, "': ", pass_why(r.why)));
        if (sel r.why.slot) { ret sourced(a, m, refused, r.why.slot.location); }
        ret refused;
    }
    if (sel e.schedule) { ret fail.message_of(fail.join(a, "mirl's schedule for '", name, "' is malformed at the pass ", e.schedule.pass)); }
    ret fail.message_of(fail.join(a, "mirl's schedule for '", name, "' was given a machine opened for another target"));
}

# the row a pass's refusal of the source is reported under, NONE for one that is the compiler's
fun pass_kind(w: pass_failure.Why) diagnostic_kind.Kind {
    if (sel w.timing)      { ret diagnostic_kind.SECRET_UNVERIFIABLE; }
    if (sel w.unheld)      { ret diagnostic_kind.TARGET_NO_FLOAT; }
    if (sel w.threaded)    { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.indexed)     { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.exported)    { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.specialized) { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    if (sel w.slot)        { ret diagnostic_kind.TARGET_UNSUPPORTED_OP; }
    ret diagnostic_kind.NONE;
}

# why a pass refused, in the words of its case
fun pass_why(w: pass_failure.Why) str {
    if (sel w.reason)      { ret w.reason; }
    if (sel w.alloc)       { ret "the allocator refused storage"; }
    if (sel w.ir)          { ret "the module or a body refused an edit or a read"; }
    if (sel w.cfg)         { ret "a graph edit or a copy was refused"; }
    if (sel w.build)       { ret "the builder stopped"; }
    if (sel w.convention)  { ret "a call, an entry or a return was not classified"; }
    if (sel w.pieces)      { ret "an assignment is not carried in pieces of the ir"; }
    if (sel w.text)        { ret "a function delivered in the text form was not read"; }
    if (sel w.timing)      { ret "a function that requires constant time would take a time that depends on a secret"; }
    if (sel w.condition)   { ret "a capability's condition was not read on the build's machine"; }
    if (sel w.unheld)      { ret "a float type the target holds no unit for"; }
    if (sel w.threaded)    { ret "a thread-local global the build's threads reach no variable of yet"; }
    if (sel w.indexed)     { ret "a thread-local global reached through the runtime's index, which no selection forms yet"; }
    if (sel w.specialized) { ret "a specialization constant, on a target that holds none"; }
    if (sel w.exported)    { ret "an exported thread-local global, on a target whose build runs one thread"; }
    ret "a pointer slot the target holds no pointer in";
}

# why mirl's emission refused the laid out functions, by its case, in masc's words where masc
# refused
fun emit_refused(a: *A.Allocator, e: handover.Error) res[str, fail.Fail] {
    val lead: str = "emission refused the laid out functions: ";
    if (sel e.builder)    { ret fail.join(a, lead, "masc refused: ", e.builder.message); }
    if (sel e.unmapped)   { ret fail.join(a, lead, "the object's format maps no relocation of a kind the object needs: ", e.unmapped.refusal.message); }
    if (sel e.alloc)      { ret fail.join(a, lead, "the allocator refused storage"); }
    if (sel e.symbol)     { ret fail.join(a, lead, "an operand names a symbol the module does not have"); }
    if (sel e.convention) { ret fail.join(a, lead, "the target's calling convention is not stated"); }
    if (sel e.abi)        { ret fail.join(a, lead, "the convention names no psABI row of mink's catalog for the architecture"); }
    if (sel e.fill)       { ret fail.join(a, lead, "the target's code fill is not one byte repeated"); }
    if (sel e.refused)    { ret fail.join(a, lead, "an instruction cannot be handed over"); }
    if (sel e.global)     { ret fail.join(a, lead, "a global cannot be placed"); }
    if (sel e.format)     { ret fail.join(a, lead, "the target's system states no object format"); }
    if (sel e.dialect)    { ret fail.join(a, lead, "masc states no assembly dialect of the format"); }
    if (sel e.listing)    { ret fail.join(a, lead, "masc refused to list the object"); }
    if (sel e.debug)      { ret fail.join(a, lead, "the dwarf producer refused the debug information"); }
    if (sel e.lines)      { ret fail.join(a, lead, "mink refused the debug line table's lowering or relocation"); }
    ret fail.join(a, lead, "the object refused to export a function or global the module marks exported");
}

# what the object's sections refuse of the module `name`, and what masc refused of an asm block as
# its operands were placed, which the source states; none for any other refusal of emission
fun emit_rejected(a: *A.Allocator, m: *Module, name: str, e: handover.Error) opt[fail.Fail] {
    if (sel e.section) {
        val fname: res[str, fail.Fail] = function_name(a, m, e.section);
        if (sel fname.err) { ret opt[fail.Fail].some{fname.err}; }
        ret opt[fail.Fail].some{fail.user_of(diagnostic_kind.LINK_SECTION_UNSUPPORTED, fail.join(a, "'", fname.ok, "' of '", name, "' names a section a global or another function names with another kind"))};
    }
    if (sel e.global) {
        val fault: handover.Fault = e.global.fault;
        if (!(sel fault.section)) { ret opt[fail.Fail].none{}; }
        val gname: res[str, fail.Fail] = global_name(a, m, e.global.global);
        if (sel gname.err) { ret opt[fail.Fail].some{gname.err}; }
        ret opt[fail.Fail].some{fail.user_of(diagnostic_kind.LINK_SECTION_UNSUPPORTED, fail.join(a, "'", gname.ok, "' of '", name, "' names a section a function or another global names with another kind"))};
    }
    if (sel e.refused) {
        val refused: handover.Refused = e.refused;
        val reason:  handover.Reason  = refused.reason;
        if (!(sel reason.inline)) { ret opt[fail.Fail].none{}; }
        val fname: res[str, fail.Fail] = function_name(a, m, refused.function);
        if (sel fname.err) { ret opt[fail.Fail].some{fname.err}; }
        val text: fail.Fail = fail.user_of(diagnostic_kind.ASM_OPERAND, fail.join(a, "an asm block of '", fname.ok, "' of '", name, "': ", reason.inline));
        ret opt[fail.Fail].some{sourced(a, m, text, refused.location)};
    }
    ret opt[fail.Fail].none{};
}

# what mirl's register back end refused of the module `name`: a constant-time walk of the encoded
# code, an asm block, a naked body and what `emit_rejected` names are the source's, and every other
# case is the compiler's, named by its case
fun register_refused(a: *A.Allocator, m: *Module, name: str, e: mirl_machine.Error) fail.Fail {
    if (sel e.alloc) { ret fail.refused(e.alloc); }
    if (sel e.timing) {
        val unmet: mct.Unmet = e.timing;
        if (sel unmet.refused)      { ret untimed(a, m, name, unmet.refused, "the walk of its encoded code"); }
        if (sel unmet.unfollowed)   { ret unfollowed(a, m, name, unmet.unfollowed); }
        if (sel unmet.unguaranteed) { ret unguaranteed(a, m, name, unmet.unguaranteed); }
        if (sel unmet.stale)        { ret stale(a, m, name, unmet.stale); }
    }
    if (sel e.emit) {
        val emitted: handover.Error = e.emit;
        if (sel emitted.listing) { ret unlisted(a, m, name, emitted.listing); }
        val source: opt[fail.Fail] = emit_rejected(a, m, name, emitted);
        if (sel source.some) { ret source.some; }
        val said: res[str, fail.Fail] = emit_refused(a, emitted);
        if (sel said.err) { ret said.err; }
        ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': ", said.ok));
    }
    var why: str = "the register back end refused it";
    if (sel e.foreign)   { why = "the build was opened for another target"; }
    or (sel e.uncarried) { why = "masc's registry carries no record of the build's instruction set"; }
    or (sel e.locations) { why = "the target's register and memory locations were refused"; }
    or (sel e.table)     { why = "the selection table was refused for the target"; }
    or (sel e.moves)     { why = "the instruction set's moves were refused for the target"; }
    or (sel e.code)      { why = "the frame code was not bound to the target's selection"; }
    or (sel e.machine)   { why = "the machine form text was not printed"; }
    or (sel e.write)     { why = "the listing was not written"; }
    or (sel e.function)  { ret function_refused(a, m, name, e.function); }
    ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': ", why));
}

# what refused a function of the module `name` at a stage of the register back end, at the source
# location of the instruction it names
fun function_refused(a: *A.Allocator, m: *Module, name: str, failed: mirl_machine.Failed) fail.Fail {
    val fname: res[str, fail.Fail] = function_name(a, m, failed.function);
    if (sel fname.err) { ret fname.err; }
    val stage: mirl_machine.Stage = failed.stage;
    if (sel stage.timing) {
        val found: fail.Fail = fail.user_of(timing_kind(?stage.timing.refusal), fail.join(a, "'", fname.ok, "' of '", name, "' requires constant time, which the machine form's check refused at an instruction of it: ", masc_ct.message(?stage.timing.refusal)));
        ret sourced(a, m, found, failed.location);
    }
    if (sel stage.select) {
        val selection: mirl_engine.Error = stage.select;
        if (sel selection.assembly) { ret sourced(a, m, block_refused(a, fname.ok, selection.assembly.refusal), failed.location); }
        if (sel selection.naked) {
            ret sourced(a, m, fail.user_of(diagnostic_kind.NAKED_BODY, fail.join(a, "'", fname.ok, "' of '", name, "' is naked, and holds an instruction other than an asm block that binds nothing")), failed.location);
        }
    }
    var step: str = "before its steps";
    if (sel failed.step.some) { step = failed.step.some; }
    ret fail.message_of(fail.join(a, "mirl did not compile '", fname.ok, "' of '", name, "': ", stage_refusal(stage), " (", step, ")", selection_lead(stage), selection_named(stage)));
}

# what selection could not select, as a clause after its stage, "" for any other stage
fun selection_lead(s: mirl_machine.Stage) str {
    if (!(sel s.select)) { ret ""; }
    val e: mirl_engine.Error = s.select;
    if (sel e.unmatched) {
        val op: mirl_engine.Operation = e.unmatched.operation;
        if (sel op.opcode) { ret ": no rule selects "; }
        ret ": no rule materialises a constant";
    }
    if (sel e.unheld)    { ret ": no register class holds a value of its type"; }
    if (sel e.ambiguous) { ret ": two register classes hold a value of its type"; }
    if (sel e.aggregate) { ret ": a value of an aggregate type, which no register holds"; }
    if (sel e.unplaced)  { ret ": an entry whose parameters the abi legalisation did not place"; }
    if (sel e.placed)    { ret ": a piece at a place selection does not carry"; }
    if (sel e.unchecked) { ret ": a division without the checked mark"; }
    if (sel e.switched)  { ret ": a timing switch the set states no way to place"; }
    ret "";
}

# the opcode selection found no rule for, "" when it refused anything else
fun selection_named(s: mirl_machine.Stage) str {
    if (!(sel s.select)) { ret ""; }
    val e: mirl_engine.Error = s.select;
    if (!(sel e.unmatched)) { ret ""; }
    val op: mirl_engine.Operation = e.unmatched.operation;
    if (!(sel op.opcode)) { ret ""; }
    val row: opt[*opcode_row.Row] = opcode_table.at(op.opcode);
    if (sel row.some) { ret row.some.name; }
    ret "";
}

# what refused a function at a stage of the register back end, by the stage's case
fun stage_refusal(s: mirl_machine.Stage) str {
    if (sel s.select)     { ret "selection refused an operation"; }
    if (sel s.timing)     { ret "a timing check refused it"; }
    if (sel s.alloc)      { ret "the allocator refused storage"; }
    if (sel s.pointer)    { ret "the frame pointer was refused"; }
    if (sel s.allowed)    { ret "a register the function may not use was asked for"; }
    if (sel s.allocate)   { ret "register allocation refused it"; }
    if (sel s.frame)      { ret "the frame was not finished"; }
    if (sel s.copies)     { ret "its copies were not lowered"; }
    if (sel s.configure)  { ret "the configuration step refused it"; }
    if (sel s.loops)      { ret "a loop was not expanded"; }
    if (sel s.layout)     { ret "its layout was refused"; }
    if (sel s.ranges)     { ret "a branch range was refused"; }
    if (sel s.verify)     { ret "the machine verifier refused it"; }
    if (sel s.watched)    { ret "a watched step refused it"; }
    if (sel s.misplaced)  { ret "an instruction was misplaced"; }
    if (sel s.unfinished) { ret "it was left unfinished"; }
    ret "its calling convention was refused";
}

# what mirl's spir-v back end refused of the module `name`, at the source location of the
# instruction it names
fun spirv_refused(a: *A.Allocator, m: *Module, name: str, q: mirl_spirv.Error) fail.Fail {
    if (sel q.alloc)    { ret fail.refused(q.alloc); }
    if (sel q.unmet)    { ret fail.user_of(diagnostic_kind.SPIRV_CAPABILITY, fail.join(a, "mirl did not compile '", name, "': it needs ", q.unmet.name, ", which the target's selection does not hold")); }
    if (sel q.encoding) { ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': masc refused an instruction: ", q.encoding.message)); }
    if (sel q.builder)  { ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': masc's builder refused the module: ", q.builder.message)); }
    ret sourced(a, m, fail.user_of(spirv_kind(q), fail.join(a, "mirl did not compile '", name, "': ", spirv_refusal(q))), spirv_at(q));
}

# the row a spir-v refusal of the source is reported under, NONE for one that is the compiler's:
# logical addressing and the shape of an entry are the source's to change
fun spirv_kind(q: mirl_spirv.Error) diagnostic_kind.Kind {
    if (sel q.unstructured) { ret diagnostic_kind.SPIRV_CONTROL_FLOW; }
    if (sel q.entry)        { ret diagnostic_kind.SPIRV_STAGE_SIGNATURE; }
    if (sel q.workgroup)    { ret diagnostic_kind.SPIRV_STAGE_SIGNATURE; }
    if (sel q.imported)     { ret diagnostic_kind.SPIRV_INTERFACE; }
    if (sel q.unselected || sel q.untyped || sel q.unpointed || sel q.reinterpreted || sel q.variable || sel q.storage || sel q.slot) {
        ret diagnostic_kind.SPIRV_UNSUPPORTED;
    }
    ret diagnostic_kind.NONE;
}

# the source location of the instruction a spir-v refusal names, none for any other
fun spirv_at(q: mirl_spirv.Error) opt[mirl_debug.Location] {
    if (sel q.unselected)    { ret q.unselected.location; }
    if (sel q.unpointed)     { ret q.unpointed.location; }
    if (sel q.reinterpreted) { ret q.reinterpreted.location; }
    if (sel q.variable)      { ret q.variable.location; }
    if (sel q.slot)          { ret q.slot.location; }
    ret opt[mirl_debug.Location].none{};
}

# what mirl's spir-v back end refused of a module, in the words of its error's cases
fun spirv_refusal(e: mirl_spirv.Error) str {
    if (sel e.ir)            { ret "the spir-v back end could not read the module"; }
    if (sel e.layout)        { ret "the spir-v data layout gave a type no extent"; }
    if (sel e.basis)         { ret "the selection a spir-v unit is read under was not opened"; }
    if (sel e.analysis)      { ret "a function's structure was not read"; }
    if (sel e.unselected)    { ret "an instruction spir-v has no form of yet"; }
    if (sel e.untyped)       { ret "a type spir-v has no form of here"; }
    if (sel e.unpointed)     { ret "a pointer whose pointee no definition or use states"; }
    if (sel e.reinterpreted) { ret "an access through a pointer at a type other than what it points to"; }
    if (sel e.variable)      { ret "a pointer chosen at run time, which logical addressing reaches only through variable pointers"; }
    if (sel e.storage)       { ret "a global whose address is used in another storage class than its own"; }
    if (sel e.slot)          { ret "a stack slot whose pointer is not into the Function class"; }
    if (sel e.entry)         { ret "an entry point that takes or returns a value"; }
    if (sel e.workgroup)     { ret "an entry point whose workgroup names a dimension by a specialization constant the module has no 32-bit integer of"; }
    if (sel e.imported)      { ret "an image that imports a function or a global"; }
    if (sel e.unmet)         { ret "a capability, extension or version the module needs that the selection does not hold"; }
    if (sel e.unstructured)  { ret "a function whose region tree the emitter cannot follow"; }
    if (sel e.encoding)      { ret "masc refused an instruction"; }
    if (sel e.builder)       { ret "masc's builder refused the module"; }
    if (sel e.container)     { ret "mink's object refused the module"; }
    ret "the spir-v back end refused it";
}

# what mirl's webassembly back end refused of the module `name`: the constant-time refusals read
# as the register back end's, what wasm has no form of is the source's at the instruction it
# names, and every other case is the compiler's
fun wasm_refused(a: *A.Allocator, m: *Module, name: str, q: mirl_wasm.Error) fail.Fail {
    if (sel q.alloc)        { ret fail.refused(q.alloc); }
    if (sel q.timing)       { ret untimed(a, m, name, q.timing, "the walk of its encoded code"); }
    if (sel q.unfollowed)   { ret unfollowed(a, m, name, q.unfollowed); }
    if (sel q.stale)        { ret stale(a, m, name, q.stale); }
    if (sel q.unguaranteed) { ret unguaranteed(a, m, name, q.unguaranteed); }
    if (sel q.encoding)     { ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': masc refused an instruction or a definition: ", q.encoding.message)); }
    if (sel q.unselected)   { ret sourced(a, m, fail.user_of(diagnostic_kind.TARGET_UNSUPPORTED_OP, fail.join(a, "mirl did not compile '", name, "': an instruction wasm has no form of")), q.unselected.location); }
    if (sel q.threads)      { ret sourced(a, m, fail.user_of(diagnostic_kind.TARGET_UNSUPPORTED_OP, fail.join(a, "mirl did not compile '", name, "': an atomic access or a fence on a build that runs threads")), q.threads.location); }
    ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': ", wasm_refusal(q)));
}

# what mirl's webassembly back end refused of a module, in the words of its error's cases
fun wasm_refusal(q: mirl_wasm.Error) str {
    if (sel q.ir)           { ret "the wasm back end could not read the module"; }
    if (sel q.layout)       { ret "the wasm data layout gave a type no extent"; }
    if (sel q.analysis)     { ret "a function's structure or liveness was not read"; }
    if (sel q.placement)    { ret "a signature was not placed"; }
    if (sel q.unvalued)     { ret "a value of a type no value type of wasm holds"; }
    if (sel q.invariant)    { ret "an instruction in a shape no verified module brings to the back end"; }
    if (sel q.undefined)    { ret "a global another module defines, which a final module has no import of"; }
    if (sel q.offset)       { ret "an address of a function at an offset, which a table slot has none"; }
    if (sel q.width)        { ret "an address in a global's initial value of a width no relocation of an object writes"; }
    if (sel q.unstructured) { ret "a function whose graph lays out in no regions its code can follow"; }
    if (sel q.image)        { ret "a global's initial value was not laid out"; }
    if (sel q.container)    { ret "mink's container refused the module"; }
    ret "the wasm back end refused it";
}

# a function of the module `name` that requires constant time, refused as mirl words it: a
# set that classifies no timing is the target's, and a secret where the code may hold none is
# the source's
fun untimed(a: *A.Allocator, m: *Module, name: str, r: mct.Refused, by: str) fail.Fail {
    val fname: res[str, fail.Fail] = function_name(a, m, r.function);
    if (sel fname.err) { ret fname.err; }
    var at: str = "the function as a whole";
    if (sel r.at.instruction) { at = "an instruction of it"; }
    or (sel r.at.offset)      { at = "a byte of its encoded code"; }
    val kind:    diagnostic_kind.Kind = timing_kind(?r.refusal);
    var refused: fail.Fail            = fail.user_of(kind, fail.join(a, "'", fname.ok, "' of '", name, "' requires constant time, which ", by, " refused at ", at, ": ", masc_ct.message(?r.refusal)));
    if (sel r.callee.some) {
        val callee: res[str, fail.Fail] = function_name(a, m, r.callee.some);
        if (sel callee.err) { ret callee.err; }
        refused = fail.user_of(kind, fail.join(a, "'", fname.ok, "' of '", name, "' requires constant time, which ", by, " refused at ", at, ": ", masc_ct.message(?r.refusal), ", '", callee.ok, "'"));
    }
    ret sourced(a, m, refused, r.location);
}

# the row masc's constant-time refusal is reported under: a set that classifies no timing is the
# target's, and anything else the source's
fun timing_kind(r: *masc_ct.Refusal) diagnostic_kind.Kind {
    if (r.reason == masc_ct.UNCLASSIFIED) { ret diagnostic_kind.SECRET_TARGET_UNVERIFIABLE; }
    ret diagnostic_kind.SECRET_UNVERIFIABLE;
}

# a constant-time function of the module `name` whose encoded code mirl could not follow
fun unfollowed(a: *A.Allocator, m: *Module, name: str, u: mct.Unfollowed) fail.Fail {
    val fname: res[str, fail.Fail] = function_name(a, m, u.function);
    if (sel fname.err) { ret fname.err; }
    ret sourced(a, m, fail.user_of(diagnostic_kind.SECRET_UNVERIFIABLE, fail.join(a, "'", fname.ok, "' of '", name, "' requires constant time, and mirl could not follow its encoded code: ", u.unread.message)), u.location);
}

# a constant-time function of the module `name` whose frame reads a slot no store reaches first
fun stale(a: *A.Allocator, m: *Module, name: str, s: mct.Stale) fail.Fail {
    val fname: res[str, fail.Fail] = function_name(a, m, s.function);
    if (sel fname.err) { ret fname.err; }
    ret sourced(a, m, fail.user_of(diagnostic_kind.SECRET_UNVERIFIABLE, fail.join(a, "'", fname.ok, "' of '", name, "' requires constant time, and its frame reads a slot no store of it reaches first, which may hold a secret an earlier frame left")), s.location);
}

# a hard constant-time function of the module `name` whose code holds only under timing modes the
# build does not guarantee, named by the features a target selects to guarantee them
fun unguaranteed(a: *A.Allocator, m: *Module, name: str, u: mct.Unguaranteed) fail.Fail {
    val fname: res[str, fail.Fail] = function_name(a, m, u.function);
    if (sel fname.err) { ret fname.err; }
    if (u.needs == mct.NO_NEEDS) {
        ret fail.user_of(diagnostic_kind.SECRET_TARGET_UNVERIFIABLE, fail.join(a, "'", fname.ok, "' of '", name,
            "' requires hard constant time, and the target's instruction set guarantees no instruction's timing"));
    }
    var features: vector.Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?features); }
    val spelled: err[A.Error] = mct.missing(u.set, u.needs, ?features);
    if (sel spelled.err) { ret fail.refused(spelled.err); }
    val nul: res[usize, A.Error] = vector.push[u8](?features, 0);
    if (sel nul.err) { ret fail.refused(nul.err); }
    ret fail.user_of(diagnostic_kind.SECRET_TARGET_UNVERIFIABLE, fail.join(a, "'", fname.ok, "' of '", name,
        "' requires hard constant time, and its code runs in constant time only under ", features.data::str,
        ", which the build's target does not guarantee; select it in the target's `isa` or `ext`, or mark the function soft"));
}

# masc's refusal to list the object, naming the function or global it is about when it names one
fun unlisted(a: *A.Allocator, m: *Module, name: str, u: handover.Unlisted) fail.Fail {
    if (sel u.symbol.none) { ret fail.message_of(fail.join(a, "masc did not list the object of '", name, "': ", u.refusal.message)); }
    val sym:   id.Symbol           = u.symbol.some;
    var sname: res[str, fail.Fail] = res[str, fail.Fail].err{fail.message("mirl refused a global its module does not hold")};
    if (sel sym.function) { sname = function_name(a, m, sym.function); }
    or (sel sym.global)   { sname = global_name(a, m, sym.global); }
    if (sel sname.err)    { ret sname.err; }
    ret fail.message_of(fail.join(a, "masc did not list '", sname.ok, "' of '", name, "': ", u.refusal.message));
}

# the name a function of `m` is declared by, copied
fun function_name(a: *A.Allocator, m: *Module, f: Function) res[str, fail.Fail] {
    if (f.index::usize >= m.functions.len) { ret res[str, fail.Fail].err{fail.message("mirl refused a function its module does not hold")}; }
    val v:      View               = m.functions.data[f.index::usize].data.name;
    val copied: res[str, StrError] = str_copy_slice(a, v.data, 0, v.len);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.str_refused(copied.err)}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

# the name a global of `m` is declared by, copied
fun global_name(a: *A.Allocator, m: *Module, g: id.Global) res[str, fail.Fail] {
    if (g.index::usize >= m.globals.len) { ret res[str, fail.Fail].err{fail.message("mirl refused a global its module does not hold")}; }
    val v:      View               = m.globals.data[g.index::usize].data.name;
    val copied: res[str, StrError] = str_copy_slice(a, v.data, 0, v.len);
    if (sel copied.err) { ret res[str, fail.Fail].err{fail.str_refused(copied.err)}; }
    ret res[str, fail.Fail].ok{copied.ok};
}

# why mirl compiles no asm block of the module `name` as it is written
fun block_refused(a: *A.Allocator, name: str, r: mirl_inline.Refusal) fail.Fail {
    if (sel r.alloc)  { ret fail.refused(r.alloc); }
    if (sel r.parsed) { ret fail.user_of(diagnostic_kind.ASM_SYNTAX, fail.join(a, "an asm block of '", name, "': ", r.parsed)); }
    if (sel r.returns) {
        ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, fail.join(a, "an asm block of '", name, "' may return from its function, which would skip the epilogue that restores the caller's frame; return from a `#[naked]` function's body instead"));
    }
    if (sel r.operands) { ret fail.user_of(diagnostic_kind.ASM_OPERAND, fail.join(a, "an asm block of '", name, "' binds more names than one block may")); }
    if (sel r.class)    { ret fail.user_of(diagnostic_kind.ASM_OPERAND, fail.join(a, "an asm block of '", name, "' binds a name in another register class than its operand takes")); }
    ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, fail.join(a, "an asm block of '", name, "' binds an address as an immediate, which mirl carries no relocation for yet"));
}

# the bytes of `o` laid out in the target's object format, given back with sink.release
pub fun object_bytes(b: *Back, a: *A.Allocator, o: *Object) res[Sink, fail.Fail] {
    if (b.format == nil) { ret res[Sink, fail.Fail].err{fail.message("the target's system states no object format mink lays out")}; }
    val built: res[contract.Model, Fail] = registry.from_neutral(?b.formats, b.format, a, o);
    if (sel built.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not lay the object out", built.err)}; }
    var model: contract.Model = built.ok;
    fin { val dropped: err[Fail] = contract.release(?model); }
    val laid: res[Sink, Fail] = contract.write(?model);
    if (sel laid.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not write the object", laid.err)}; }
    ret res[Sink, fail.Fail].ok{laid.ok};
}

# the object the bytes of the file `file` hold, none when mink reads no object from them
pub fun read_object(b: *Back, a: *A.Allocator, file: str, data: *u8, len: usize) opt[Object] {
    var input: contract.Input            = contract.Input{file: file, data: data, len: len};
    val read:  res[contract.Model, Fail] = registry.read(?b.formats, a, ?input);
    if (sel read.err) { ret opt[Object].none{}; }
    var model: contract.Model = read.ok;
    fin { val dropped: err[Fail] = contract.release(?model); }
    var o:         Object    = object.make(a, nil, nil);
    val converted: err[Fail] = contract.to_neutral(?model, ?b.formats.relocs, ?o);
    if (sel converted.err) {
        val released: err[Fail] = object.release(?o);
        ret opt[Object].none{};
    }
    ret opt[Object].some{o};
}

# whether the file at `path` is one a link binds against when the image loads, a kind
# of file mink states a link may bind against: a shared library or a stub
pub fun binds_at_load(b: *Back, a: *A.Allocator, path: str) res[bool, fail.Fail] {
    val loaded: res[registry.Loaded, Fail] = registry.load(?b.formats, a, path);
    if (sel loaded.err) { ret res[bool, fail.Fail].err{refused_by_mink(a, "mink did not read the link input", loaded.err)}; }
    var held: registry.Loaded = loaded.ok;
    fin { val dropped: err[Fail] = registry.unload(?held); }
    val kind: res[*mink_kind.Kind, Fail] = contract.kind(?held.model);
    if (sel kind.err) { ret res[bool, fail.Fail].err{refused_by_mink(a, "mink did not name the link input's kind", kind.err)}; }
    ret res[bool, fail.Fail].ok{mink_kind.has(kind.ok, mink_kind.BINDS)};
}

# the section an object carries mach's cache record in. mink states no flag a link drops a
# section by (mink#538), so the section is unreferenced and the link's collection leaves it out
pub val RECORD_SECTION: str = ".mach.cache";

# the bytes of `o` with the section `name` holding the `len` bytes at `data` added, laid out in
# the target's format; `o` is left as it was
pub fun object_bytes_with(b: *Back, a: *A.Allocator, o: *Object, name: str, data: *u8, len: usize) res[Sink, fail.Fail] {
    val copied: res[Object, Fail] = object.copy(a, o);
    if (sel copied.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not copy the object", copied.err)}; }
    var c: Object = copied.ok;
    fin { release_object(?c); }
    val named: res[Id[Name], Fail] = object.name_str(?c, name);
    if (sel named.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not name the section", named.err)}; }
    val held: res[object.Contents, Fail] = object.own(?c, data, len);
    if (sel held.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not hold the section", held.err)}; }
    val added: res[Id[object.Section], Fail] = object.add_section(?c, object.Section{
        name:        opt[Id[Name]].some{named.ok},
        kind:        ?section.METADATA,
        flags:       0,
        align:       1,
        entsize:     0,
        contents:    held.ok,
        owner:       opt[Id[object.Section]].none{},
        group:       opt[Id[object.Group]].none{},
        disposition: ?section.WHOLE,
        priority:    opt[u32].none{}
    });
    if (sel added.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not add the section", added.err)}; }
    ret object_bytes(b, a, ?c);
}

# the section an image no loader maps holds its main stack in, whose top std's entry reads
# through mink's bound name `__run_stop_.stack`
pub val STACK_SECTION: str = ".stack";

# the alignment the laid stack keeps its base and size at, the strictest any target's psABI
# asks of its stack pointer
pub val STACK_ALIGN: u64 = 16;

# whether an image of `t` holds its main stack as a section of its own: an ELF or flat image
# no loader maps, so no loader gives it a stack and no header records one
pub fun lays_stack(t: *resolved.Target) bool {
    if (t.sys == nil || t.sys.mapped) { ret false; }
    ret t.format == ?mink_format.ELF || t.format == ?mink_format.FLAT;
}

# an object holding the image's stack, `size` zero-filled bytes in STACK_SECTION, kept by the
# link whether referenced or not, so a stated stack is always laid out
pub fun stack_object(b: *Back, a: *A.Allocator, size: u64) res[Object, fail.Fail] {
    if (b.assembled == nil) { ret res[Object, fail.Fail].err{fail.message("no target is open, so the build lays no stack")}; }
    var o:     Object              = object.make(a, b.assembled.target.arch, ?mink_kind.RELOCATABLE);
    val named: res[Id[Name], Fail] = object.name_str(?o, STACK_SECTION);
    if (sel named.err) {
        release_object(?o);
        ret res[Object, fail.Fail].err{refused_by_mink(a, "mink did not name the stack's section", named.err)};
    }
    val added: res[Id[object.Section], Fail] = object.add_section(?o, object.Section{
        name:        opt[Id[Name]].some{named.ok},
        kind:        ?section.BSS,
        flags:       section.BSS.flags | section.RETAIN,
        align:       STACK_ALIGN,
        entsize:     0,
        contents:    object.Contents.zero{size},
        owner:       opt[Id[object.Section]].none{},
        group:       opt[Id[object.Group]].none{},
        disposition: ?section.WHOLE,
        priority:    opt[u32].none{}
    });
    if (sel added.err) {
        release_object(?o);
        ret res[Object, fail.Fail].err{refused_by_mink(a, "mink did not add the stack's section", added.err)};
    }
    ret res[Object, fail.Fail].ok{o};
}

# whether `o` refers to the symbol `name` and leaves its definition to another object
pub fun refers(o: *Object, name: str) bool {
    val n: usize = table.count[object.Symbol](?o.symbols);
    var i: usize = 0;
    for (i < n) {
        val y: *object.Symbol = ?table.items[object.Symbol](?o.symbols)[i];
        i = i + 1;
        if (sel y.def.undefined && view_eq_str(object.name_of(o, y.name), name)) { ret true; }
    }
    ret false;
}

# the bytes of the first section of `o` named `name`, nil and zero for none
pub fun section_bytes(o: *Object, name: str, len: *usize) *u8 {
    @len = 0;
    val n: usize = table.count[object.Section](?o.sections);
    var i: usize = 0;
    for (i < n) {
        val sec: *object.Section = ?table.items[object.Section](?o.sections)[i];
        if (sel sec.name.some) {
            val spelled: View = object.name_of(o, sec.name.some);
            if (view_eq_str(spelled, name)) {
                val held: Bytes = object.bytes(o, ?sec.contents);
                @len = held.len;
                ret held.data;
            }
        }
        i = i + 1;
    }
    ret nil;
}

# the names of the sections of `o` its producer named, borrowed from the object
pub fun section_names(o: *Object, out: *Vector[View]) err[fail.Fail] {
    val n: usize = table.count[object.Section](?o.sections);
    var i: usize = 0;
    for (i < n) {
        val sec: *object.Section = ?table.items[object.Section](?o.sections)[i];
        if (sel sec.name.some) {
            val pushed: res[usize, A.Error] = vector.push[View](out, object.name_of(o, sec.name.some));
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# how the target's link names the output section each input section is laid into, by mink's
# own layout rules, so a layout the artifact states is held to the sections the link lays out
# ---
# rules: the layout rules of the format the target's images link as
# arch:  the architecture the link is for
# names: the output section names, owned
pub rec Laying {
    rules: *layout.Rules;
    arch:  *mink_arch.Arch;
    names: Interner;
}

# the laying of the target's link, refused for a format mink lays out no image of
pub fun laying(b: *Back, a: *A.Allocator) res[Laying, fail.Fail] {
    if (b.format == nil || b.assembled == nil || !b.opened) { ret res[Laying, fail.Fail].err{fail.message("no target is open, so the build lays out no image")}; }
    val r: res[*Registration, Fail] = registry.by_format(?b.formats, b.format);
    if (sel r.err) { ret res[Laying, fail.Fail].err{refused_by_mink(a, "the target's format is not registered", r.err)}; }
    val via: res[*Registration, Fail] = registry.links_of(?b.formats, r.ok);
    if (sel via.err) { ret res[Laying, fail.Fail].err{refused_by_mink(a, "the format the target's images link as is not registered", via.err)}; }
    val rules: res[*Linking, Fail] = registration.linking(via.ok);
    if (sel rules.err) { ret res[Laying, fail.Fail].err{refused_by_mink(a, "the target's format links no image", rules.err)}; }
    val laid: opt[*layout.Rules] = rules.ok.layout;
    if (sel laid.none) { ret res[Laying, fail.Fail].err{fail.message("the target's format lays out no sections")}; }
    ret res[Laying, fail.Fail].ok{Laying{rules: laid.some, arch: b.assembled.target.arch, names: mink_intern.make(a)}};
}

pub fun laying_release(l: *Laying) {
    val released: err[Fail] = mink_intern.release(?l.names);
}

# the name of the output section the link lays section `i` of `o` into, valid until the
# laying names another
pub fun laid_name(a: *A.Allocator, l: *Laying, o: *Object, i: usize) res[View, fail.Fail] {
    val sec:   *object.Section         = ?table.items[object.Section](?o.sections)[i];
    val named: res[layout.Named, Fail] = layout.named(?l.names, l.rules, l.arch, o, sec);
    if (sel named.err) { ret res[View, fail.Fail].err{refused_by_mink(a, "mink names no output section of an object's section", named.err)}; }
    ret res[View, fail.Fail].ok{mink_intern.bytes_of(?l.names, named.ok.name)};
}

# how many sections `o` holds
pub fun section_count(o: *Object) usize {
    ret table.count[object.Section](?o.sections);
}

# the names of the symbols `o` places in its sections named `name`, borrowed from the object
pub fun symbols_in(o: *Object, name: View, out: *Vector[View]) err[fail.Fail] {
    val n: usize = table.count[object.Symbol](?o.symbols);
    var i: usize = 0;
    for (i < n) {
        val y: *object.Symbol = object.symbol_at(o, Id[object.Symbol]{index: i::u32});
        i = i + 1;
        if (!sel y.def.placed) { cnt; }
        val sec: *object.Section = object.section_at(o, y.def.placed.section);
        if (sel sec.name.none) { cnt; }
        val held: View = object.name_of(o, sec.name.some);
        if (held.len != name.len || !memory.equal[u8](held.data::*u8, name.data::*u8, name.len)) { cnt; }
        val pushed: res[usize, A.Error] = vector.push[View](out, object.name_of(o, y.name));
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

pub fun release_object(o: *Object) {
    val released: err[Fail] = object.release(o);
}

# how many symbols `o` holds
pub fun symbol_count(o: *Object) usize {
    ret table.count[object.Symbol](?o.symbols);
}

# whether symbol `i` of `o` is one the object defines and links outside it
pub fun exported(o: *Object, i: usize) bool {
    val s: *object.Symbol = ?table.items[object.Symbol](?o.symbols)[i];
    if (s.binding == ?symbol.LOCAL) { ret false; }
    ret sel s.def.placed || sel s.def.absolute || sel s.def.common;
}

# a copy of `o` in which its definition of `name`, when it has a global one, yields to
# another as a weak definition; none when `o` defines no such symbol
pub fun weakened(a: *A.Allocator, o: *Object, name: str) res[opt[Object], fail.Fail] {
    var at: usize = symbol_count(o);
    var i:  usize = 0;
    for (i < symbol_count(o)) {
        val s: *object.Symbol = ?table.items[object.Symbol](?o.symbols)[i];
        if (s.binding == ?symbol.GLOBAL && sel s.def.placed && view_eq_str(symbol_name(o, i), name)) {
            at = i;
            brk;
        }
        i = i + 1;
    }
    if (at == symbol_count(o)) { ret res[opt[Object], fail.Fail].ok{opt[Object].none{}}; }
    val copied: res[Object, Fail] = object.copy(a, o);
    if (sel copied.err) { ret res[opt[Object], fail.Fail].err{refused_by_mink(a, "mink did not copy the object", copied.err)}; }
    var c: Object = copied.ok;
    table.items[object.Symbol](?c.symbols)[at].binding = ?symbol.WEAKLY;
    ret res[opt[Object], fail.Fail].ok{opt[Object].some{c}};
}

# the variant mink writes a static library of the target's objects in, as its
# registry states it of the target's format
pub fun archive_variant(b: *Back, a: *A.Allocator) res[*Variant, fail.Fail] {
    if (b.format == nil || !b.opened) { ret res[*Variant, fail.Fail].err{fail.message("no target is open, so the build archives no objects")}; }
    val v: res[*Variant, Fail] = registry.archive(?b.formats, b.format);
    if (sel v.err) { ret res[*Variant, fail.Fail].err{refused_by_mink(a, "the target's objects are archived in no variant", v.err)}; }
    ret res[*Variant, fail.Fail].ok{v.ok};
}

# the prefix the target's format gives a C symbol's name on its architecture, empty
# for none, as mink's registry states it
pub fun c_prefix(b: *Back, a: *A.Allocator) res[str, fail.Fail] {
    if (b.format == nil || b.assembled == nil) { ret res[str, fail.Fail].err{fail.message("no target is open, so no C symbol is named")}; }
    val p: res[str, Fail] = registry.c_prefix(?b.formats, b.format, b.assembled.target.arch);
    if (sel p.err) { ret res[str, fail.Fail].err{refused_by_mink(a, "the target's format states no C symbol prefix", p.err)}; }
    ret res[str, fail.Fail].ok{p.ok};
}

# the name of symbol `i` of `o`
pub fun symbol_name(o: *Object, i: usize) View {
    ret object.name_of(o, table.items[object.Symbol](?o.symbols)[i].name);
}

# the layout an artifact states its image, which mink lays out as a linker script would
# ---
# sections: the output sections placed ahead of the rest, in order
# regions:  the memory regions
# runs:     the output sections that run in a region
# loads:    the output sections whose bytes load in a region other than the one they run in
# offsets:  the output sections placed at an offset, one per `#[at]` offset
# size:     the most bytes the image loads from its base, none for no ceiling
pub rec Plan {
    keep:          *str;
    keep_count:    usize;
    sections:      *str;
    section_count: usize;
    regions:       *Area;
    region_count:  usize;
    runs:          *Within;
    run_count:     usize;
    loads:         *Within;
    load_count:    usize;
    offsets:       *Offset;
    offset_count:  usize;
    size:          opt[u64];
}

# what the build states of the image it links, beyond its kind and format
# ---
# base:          the address the image is laid out from, none for the host's
# subsystem:     the PE subsystem the image states, none for the host's
# libdirs:       the directories a library named by name is searched in ahead of the system's
# libdir_count:  how many
# stack_reserve: the main stack's reserve, none for the format's default
# stack_commit:  the main stack's commit, none for the format's default
# plan:          the layout the artifact states, nil where it states none
pub rec Image {
    base:          opt[u64];
    subsystem:     opt[*mink_subsystem.Subsystem];
    libdirs:       *str;
    libdir_count:  usize;
    stack_reserve: opt[u64];
    stack_commit:  opt[u64];
    plan:          *Plan;
}

# the image of `kind` in `format` mink links from the `count` requests at `requests`, a library
# named by name found by mink's search, named `output` where its format records a name, its
# unreferenced sections left out with `gc`, laid out as `image` states. mink's notes go to `diags`:
# a refused link's are notes of the refusal, which is reported there, and a finished link's are
# warnings
pub fun link(b: *Back, a: *A.Allocator, diags: *diagnostic.DiagnosticStore, kind: *output.Kind, format: *Format, requests: *Request, count: usize, output_path: str, gc: bool, image: *Image) res[Sink, fail.Fail] {
    if (format == nil)      { ret res[Sink, fail.Fail].err{fail.message("the target's system states no image format mink links")}; }
    if (b.assembled == nil) { ret res[Sink, fail.Fail].err{fail.message("no target is open, so the build has no back end")}; }
    # the image runs on the system the cell's target names, which its objects do not state
    val t:      *mirl_record.Target = ?b.assembled.target;
    val target: mink_target.Target  = mink_target.Target{
        arch:      t.arch,
        sys:       opt[*mink_os.System].some{t.sys},
        env:       t.env,
        version:   opt[mink_os.Version].none{},
        sdk:       opt[mink_os.Version].none{},
        subsystem: image.subsystem
    };
    var o: Options = Options{
        kind:             kind,
        format:           format,
        target:           target,
        entry:            nil,
        keep:             nil,
        keep_count:       0,
        base:             image.base,
        gc_sections:      opt[bool].some{gc},
        keep_temporaries: opt[bool].none{},
        tail_merge:       opt[bool].none{},
        output:           output_path,
        sign:             opt[bool].none{},
        libdirs:          image.libdirs,
        libdir_count:     image.libdir_count,
        stack_reserve:    image.stack_reserve,
        stack_commit:     image.stack_commit
    };
    if (image.plan != nil) {
        val plan: *Plan = image.plan;
        o.keep          = plan.keep;
        o.keep_count    = plan.keep_count;
        o.sections      = plan.sections;
        o.section_count = plan.section_count;
        o.regions       = plan.regions;
        o.region_count  = plan.region_count;
        o.runs          = plan.runs;
        o.run_count     = plan.run_count;
        o.loads         = plan.loads;
        o.load_count    = plan.load_count;
        o.offsets       = plan.offsets;
        o.offset_count  = plan.offset_count;
        o.size          = plan.size;
    }
    var notes: Sink = sink.make(a, LITTLE);
    fin { val freed: err[Fail] = sink.release(?notes); }
    # what the search loaded backs the names a refusal carries, so it goes once the refusal is told
    var found: search.Found = search.make(a);
    fin { val released: err[Fail] = search.release(?found); }
    var linked: res[Written, mink_fail.Detached] = search.link(?found, ?b.formats, o, requests, count, ?notes);
    if (sel linked.err) { ret res[Sink, fail.Fail].err{link_refused(a, diags, fail.as_user(diagnostic_kind.LINK_INPUT_INVALID, refused_by_mink(a, "the link failed", mink_fail.view(?linked.err))), ?notes)}; }
    var made: Written = linked.ok;
    # mach writes the image alone, so an interface file the format makes goes
    if (sel made.interface.some) {
        val dropped: err[Fail] = sink.release(?made.interface.some);
        if (sel dropped.err) {
            val freed: err[Fail] = sink.release(?made.image);
            ret res[Sink, fail.Fail].err{refused_by_mink(a, "the link's interface file could not be released", dropped.err)};
        }
    }
    val told: err[fail.Fail] = link_told(diags, ?notes);
    if (sel told.err) {
        val freed: err[Fail] = sink.release(?made.image);
        ret res[Sink, fail.Fail].err{told.err};
    }
    ret res[Sink, fail.Fail].ok{made.image};
}

# a line of mink's notes, named without its prefix and its newline
# ---
# text: the line, in the notes' own bytes
# next: where the next line starts
rec NoteLine {
    text: str;
    next: usize;
}

# the line of `notes` starting at `at`, its newline overwritten to end it, as every note ends in one
fun note_line(notes: *Sink, at: usize) NoteLine {
    val bytes: *u8   = sink.data(notes);
    var end:   usize = at;
    for (end + 1 < sink.len(notes) && bytes[end] != '\n') { end = end + 1; }
    bytes[end] = 0;
    val prefix: str   = diag.PREFIX::str;
    var start:  usize = at;
    if (end - at >= str_len(prefix) && view_eq_str(View{data: ?bytes[at], len: str_len(prefix)}, prefix)) { start = at + str_len(prefix); }
    ret NoteLine{text: (?bytes[start])::str, next: end + 1};
}

# the refusal `refused` reported to `diags` under its own kind, located at no source, each line of
# mink's `notes` a note of it, so the link answers `reported`
fun link_refused(a: *A.Allocator, diags: *diagnostic.DiagnosticStore, refused: fail.Fail, notes: *Sink) fail.Fail {
    val text: opt[str] = fail.text(refused);
    if (sel text.none) { ret refused; }
    val made: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(diags.a, fail.kind_of(refused), lang_source.FILE_NIL, lang_source.span(0, 0), text.some);
    if (sel made.err) { ret made.err; }
    var built: diagnostic.DiagnosticBuilder = made.ok;
    var at:    usize                        = 0;
    for (at < sink.len(notes)) {
        val line:     NoteLine       = note_line(notes, at);
        val attached: err[fail.Fail] = diagnostic.attach_note(?built, line.text);
        if (sel attached.err) {
            diagnostic.builder_dnit(?built);
            ret attached.err;
        }
        at = line.next;
    }
    val committed: err[fail.Fail] = diagnostic.commit(?built, diags);
    if (sel committed.err) { ret committed.err; }
    fail.dnit(a, refused);
    ret fail.reported();
}

# each line of mink's `notes` on a link that finished, a warning about the build as a whole
fun link_told(diags: *diagnostic.DiagnosticStore, notes: *Sink) err[fail.Fail] {
    var at: usize = 0;
    for (at < sink.len(notes)) {
        val line:     NoteLine       = note_line(notes, at);
        val reported: err[fail.Fail] = diagnostic.report(diags, diagnostic_kind.LINK_REPORT, lang_source.FILE_NIL, lang_source.span(0, 0), line.text);
        if (sel reported.err) { ret reported; }
        at = line.next;
    }
    ret err[fail.Fail].ok{};
}
