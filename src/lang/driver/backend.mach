# the back half a build hands its lowered modules to: mirl compiles a unit to mink's object
# in memory, mink lays an object out in the target's format or reads one back, and mink links
# objects into an image. nothing here starts a process or writes a file between the stages
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view_eq_str;

use A:          std.allocator;
use std_writer: std.io.writer;
use std.memory;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use lower_context: mach.lang.me.lower.context;
use target_owner:  mach.lang.target.owner;
use mach.lang.target.resolved;

use mirl_machine: mirl.machine.compile;
use mirl_inline:  mirl.machine.inline;
use mirl_engine:  mirl.machine.select.engine;
use mirl_pass:    mirl.pass.schedule;
use mirl_compile: mirl.target.compile;
use mirl_family:  mirl.target.family;
use mirl_record:  mirl.target.record;

use mink.base.diag;
use mink_fail: mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.format.Format;
use mink_os: mink.catalog.os;
use mink.catalog.output;
use mink_subsystem: mink.catalog.subsystem;
use mink.format.contract;
use mink.format.registry;
use mink.link.input.Source;
use mink.link.options.Options;
use mink.link.state;
use mink.model.object;
use mink.model.object.Object;
use mink.model.section;
use mink.model.symbol;
use mink_target: mink.model.target;

# the target a build compiles for and the formats it reads and writes
# ---
# assembled: the target the owners assemble for the cell, nil for a cell none assembles yet
# machine:   what lowering builds its units for, borrowing `assembled`
# format:    the object format of the target's system
# formats:   mink's format registry
pub rec Back {
    assembled: *target_owner.Assembled;
    machine:   lower_context.Machine;
    format:    *Format;
    formats:   registry.Registry;
    opened:    bool;
}

# a back half that compiles nothing, for a project with no target yet
pub fun none() Back {
    var b: Back;
    b.assembled = nil;
    b.format    = nil;
    b.opened    = false;
    ret b;
}

# the back half of the resolved cell `t`, none assembled where no owner assembles the cell
pub fun open(a: *A.Allocator, t: *resolved.Target) res[Back, fail.Fail] {
    var b:       Back                         = none();
    val formats: res[registry.Registry, Fail] = registry.builtin(a);
    if (sel formats.err) { ret res[Back, fail.Fail].err{refused_by_mink(a, "mink's formats did not open", formats.err)}; }
    b.formats = formats.ok;
    b.opened  = true;
    val made: res[opt[*target_owner.Assembled], fail.Fail] = target_owner.assemble_resolved(a, t);
    if (sel made.err) {
        close(a, ?b);
        ret res[Back, fail.Fail].err{made.err};
    }
    if (sel made.ok.none) { ret res[Back, fail.Fail].ok{b}; }
    b.assembled = made.ok.some;
    b.machine   = lower_context.machine_of(b.assembled);
    val f: res[*Format, mirl_record.Error] = mirl_record.format(?b.assembled.target);
    if (sel f.ok) { b.format = f.ok; }
    ret res[Back, fail.Fail].ok{b};
}

pub fun close(a: *A.Allocator, b: *Back) {
    if (b.assembled != nil) { target_owner.release(a, b.assembled); }
    if (b.opened)           { val released: err[Fail] = registry.release(?b.formats); }
    @b = none();
}

# the machine lowering builds for, refused for a cell no owner assembles yet
pub fun machine(b: *Back) res[*lower_context.Machine, fail.Fail] {
    if (b.assembled == nil) { ret res[*lower_context.Machine, fail.Fail].err{fail.message("no owner assembles a mirl target for this cell yet, so it has no back end")}; }
    ret res[*lower_context.Machine, fail.Fail].ok{?b.machine};
}

# mink's failure `f` as mach's, under `lead`
pub fun refused_by_mink(a: *A.Allocator, lead: str, f: Fail) fail.Fail {
    var out:  Sink      = sink.make(a, LITTLE);
    val r:    err[Fail] = diag.render(f, ?out);
    var text: str       = "";
    if (sel r.ok && sink.len(?out) > 0) {
        val n:      usize             = sink.len(?out) - 1;
        val copied: res[*u8, A.Error] = A.allocate[u8](a, n + 1);
        if (sel copied.ok) {
            memory.copy[u8](copied.ok, sink.data(?out), n);
            copied.ok[n] = 0;
            text         = copied.ok::str;
        }
    }
    val freed: err[Fail] = sink.release(?out);
    ret fail.message_of(fail.join(a, lead, ": ", text));
}

# the unit `u` compiled to mink's object at mirl's level `level`, its schedule's own checks run
# with `checked`. the unit's module is the schedule's to rewrite, so it is spent here
pub fun compile(b: *Back, a: *A.Allocator, u: *lower_context.Unit, level: u8, checked: bool, relax: bool, name: str) res[Object, fail.Fail] {
    if (b.assembled == nil) { ret res[Object, fail.Fail].err{fail.message("no owner assembles a mirl target for this cell yet, so it has no back end")}; }
    val o: mirl_compile.Options = mirl_compile.Options{
        output:   mirl_family.Output.object{},
        relax:    relax,
        level:    level::mirl_pass.Level,
        checked:  checked,
        added:    target_owner.added(b.assembled),
        machine:  opt[*std_writer.Writer].none{},
        listing:  opt[*std_writer.Writer].none{},
        warnings: opt[*std_writer.Writer].none{}
    };
    val made: res[Object, mirl_compile.Error] = mirl_compile.compile(a, ?u.m, ?b.assembled.target, o);
    if (sel made.ok) { ret res[Object, fail.Fail].ok{made.ok}; }
    ret res[Object, fail.Fail].err{uncompiled(a, name, made.err)};
}

# why mirl did not compile the module `name`: a constant-time function the target cannot
# time is the source's to change, and every other refusal is the compiler's
fun uncompiled(a: *A.Allocator, name: str, e: mirl_compile.Error) fail.Fail {
    if (sel e.timing) {
        ret fail.user_of(diagnostic_kind.SECRET_TARGET_UNVERIFIABLE, fail.join(a, "'", name, "' requires constant time, which mirl cannot hold on this target: its instruction set classifies no timing for the operations the function performs"));
    }
    val block: opt[fail.Fail] = assembly_refused(a, name, e);
    if (sel block.some) { ret block.some; }
    var why: str = "its back end refused it";
    if (sel e.unserved)   { why = "no family of mirl serves the target"; }
    or (sel e.listing)    { why = "mirl's families do not list their owners"; }
    or (sel e.foreign)    { why = "it holds an operation the target's family does not serve"; }
    or (sel e.open)       { why = "mirl opened no build of the target's selection"; }
    or (sel e.schedule)   { why = "a pass of mirl's schedule refused it"; }
    or (sel e.introduced) { why = "mirl's schedule left an operation the target's family does not serve"; }
    or (sel e.alloc)      { ret fail.refused(e.alloc); }
    ret fail.message_of(fail.join(a, "mirl did not compile '", name, "': ", why));
}

# an asm block of the module `name` that selection refused, which the source states,
# none for any other refusal
fun assembly_refused(a: *A.Allocator, name: str, e: mirl_compile.Error) opt[fail.Fail] {
    if (sel e.back) {
        val back: mirl_family.Back = e.back;
        if (sel back.register) {
            val machine: mirl_machine.Error = back.register;
            if (sel machine.function) {
                val stage: mirl_machine.Stage = machine.function.stage;
                if (sel stage.select) {
                    val selection: mirl_engine.Error = stage.select;
                    if (sel selection.assembly) { ret opt[fail.Fail].some{block_refused(a, name, selection.assembly.refusal)}; }
                }
            }
        }
    }
    ret opt[fail.Fail].none{};
}

# why mirl compiles no asm block of the module `name` as it is written
fun block_refused(a: *A.Allocator, name: str, r: mirl_inline.Refusal) fail.Fail {
    if (sel r.alloc)  { ret fail.refused(r.alloc); }
    if (sel r.parsed) { ret fail.user_of(diagnostic_kind.ASM_SYNTAX, fail.join(a, "an asm block of '", name, "': ", r.parsed)); }
    if (sel r.leaves) {
        ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, fail.join(a, "an asm block of '", name, "' transfers control out of itself other than by a call, as a system call does, which mirl compiles no block for"));
    }
    if (sel r.operands) { ret fail.user_of(diagnostic_kind.ASM_OPERAND, fail.join(a, "an asm block of '", name, "' binds more names than one block may")); }
    if (sel r.class)    { ret fail.user_of(diagnostic_kind.ASM_OPERAND, fail.join(a, "an asm block of '", name, "' binds a name in another register class than its operand takes")); }
    ret fail.user_of(diagnostic_kind.ASM_UNSUPPORTED, fail.join(a, "an asm block of '", name, "' binds an address as an immediate, which mirl carries no relocation for yet"));
}

# the bytes of `o` laid out in the target's object format, given back with sink.release
pub fun object_bytes(b: *Back, a: *A.Allocator, o: *Object) res[Sink, fail.Fail] {
    if (b.format == nil) { ret res[Sink, fail.Fail].err{fail.message("the target's system states no object format mink lays out")}; }
    val built: res[contract.Model, Fail] = registry.from_neutral(?b.formats, b.format, a, o);
    if (sel built.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not lay the object out", built.err)}; }
    var model: contract.Model = built.ok;
    fin { val dropped: err[Fail] = contract.release(?model); }
    val laid: res[Sink, Fail] = contract.write(?model);
    if (sel laid.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not write the object", laid.err)}; }
    ret res[Sink, fail.Fail].ok{laid.ok};
}

# the object the bytes of the file `file` hold, none when mink reads no object from them
pub fun read_object(b: *Back, a: *A.Allocator, file: str, data: *u8, len: usize) opt[Object] {
    var input: contract.Input            = contract.Input{file: file, data: data, len: len};
    val read:  res[contract.Model, Fail] = registry.read(?b.formats, a, ?input);
    if (sel read.err) { ret opt[Object].none{}; }
    var model: contract.Model = read.ok;
    fin { val dropped: err[Fail] = contract.release(?model); }
    var o:         Object    = object.make(a, nil, nil);
    val converted: err[Fail] = contract.to_neutral(?model, ?b.formats.relocs, ?o);
    if (sel converted.err) {
        val released: err[Fail] = object.release(?o);
        ret opt[Object].none{};
    }
    ret opt[Object].some{o};
}

# the section an object carries mach's cache record in. mink states no flag a link drops a
# section by (mink#538), so the section is unreferenced and the link's collection leaves it out
pub val RECORD_SECTION: str = ".mach.cache";

# the bytes of `o` with the section `name` holding the `len` bytes at `data` added, laid out in
# the target's format; `o` is left as it was
pub fun object_bytes_with(b: *Back, a: *A.Allocator, o: *Object, name: str, data: *u8, len: usize) res[Sink, fail.Fail] {
    val copied: res[Object, Fail] = object.copy(a, o);
    if (sel copied.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not copy the object", copied.err)}; }
    var c: Object = copied.ok;
    fin { release_object(?c); }
    val named: res[Id[Name], Fail] = object.name_str(?c, name);
    if (sel named.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not name the section", named.err)}; }
    val held: res[object.Contents, Fail] = object.own(?c, data, len);
    if (sel held.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not hold the section", held.err)}; }
    val added: res[Id[object.Section], Fail] = object.add_section(?c, object.Section{
        name:        opt[Id[Name]].some{named.ok},
        kind:        ?section.METADATA,
        flags:       0,
        align:       1,
        entsize:     0,
        contents:    held.ok,
        owner:       opt[Id[object.Section]].none{},
        group:       opt[Id[object.Group]].none{},
        disposition: ?section.WHOLE,
        priority:    opt[u32].none{}
    });
    if (sel added.err) { ret res[Sink, fail.Fail].err{refused_by_mink(a, "mink did not add the section", added.err)}; }
    ret object_bytes(b, a, ?c);
}

# the bytes of the first section of `o` named `name`, nil and zero for none
pub fun section_bytes(o: *Object, name: str, len: *usize) *u8 {
    @len = 0;
    val n: usize = table.count[object.Section](?o.sections);
    var i: usize = 0;
    for (i < n) {
        val sec: *object.Section = ?table.items[object.Section](?o.sections)[i];
        if (sel sec.name.some) {
            val spelled: View = object.name_of(o, sec.name.some);
            if (view_eq_str(spelled, name)) {
                val held: Bytes = object.bytes(o, ?sec.contents);
                @len = held.len;
                ret held.data;
            }
        }
        i = i + 1;
    }
    ret nil;
}

pub fun release_object(o: *Object) {
    val released: err[Fail] = object.release(o);
}

# how many symbols `o` holds
pub fun symbol_count(o: *Object) usize {
    ret table.count[object.Symbol](?o.symbols);
}

# whether symbol `i` of `o` is one the object defines and links outside it
pub fun exported(o: *Object, i: usize) bool {
    val s: *object.Symbol = ?table.items[object.Symbol](?o.symbols)[i];
    if (s.binding == ?symbol.LOCAL) { ret false; }
    ret sel s.def.placed || sel s.def.absolute || sel s.def.common;
}

# a copy of `o` in which its definition of `name`, when it has a global one, yields to
# another as a weak definition; none when `o` defines no such symbol
pub fun weakened(a: *A.Allocator, o: *Object, name: str) res[opt[Object], fail.Fail] {
    var at: usize = symbol_count(o);
    var i:  usize = 0;
    for (i < symbol_count(o)) {
        val s: *object.Symbol = ?table.items[object.Symbol](?o.symbols)[i];
        if (s.binding == ?symbol.GLOBAL && sel s.def.placed && view_eq_str(symbol_name(o, i), name)) {
            at = i;
            brk;
        }
        i = i + 1;
    }
    if (at == symbol_count(o)) { ret res[opt[Object], fail.Fail].ok{opt[Object].none{}}; }
    val copied: res[Object, Fail] = object.copy(a, o);
    if (sel copied.err) { ret res[opt[Object], fail.Fail].err{refused_by_mink(a, "mink did not copy the object", copied.err)}; }
    var c: Object = copied.ok;
    table.items[object.Symbol](?c.symbols)[at].binding = ?symbol.WEAKLY;
    ret res[opt[Object], fail.Fail].ok{opt[Object].some{c}};
}

# the name of symbol `i` of `o`
pub fun symbol_name(o: *Object, i: usize) View {
    ret object.name_of(o, table.items[object.Symbol](?o.symbols)[i].name);
}

# the image of `kind` in `format` mink links from the `count` sources at `sources`, named `output` where
# its format records a name, its unreferenced sections left out with `gc`
pub fun link(b: *Back, a: *A.Allocator, kind: *output.Kind, format: *Format, sources: *Source, count: usize, output_path: str, gc: bool) res[Sink, fail.Fail] {
    if (format == nil)      { ret res[Sink, fail.Fail].err{fail.message("the target's system states no image format mink links")}; }
    if (b.assembled == nil) { ret res[Sink, fail.Fail].err{fail.message("no owner assembles a mirl target for this cell yet, so it has no back end")}; }
    # the image runs on the system the cell's target names, which its objects do not state
    val t:      *mirl_record.Target = ?b.assembled.target;
    val target: mink_target.Target  = mink_target.Target{
        arch:      t.arch,
        system:    opt[*mink_os.System].some{t.system},
        env:       t.env,
        version:   opt[mink_os.Version].none{},
        sdk:       opt[mink_os.Version].none{},
        subsystem: opt[*mink_subsystem.Subsystem].none{}
    };
    val o: Options = Options{
        kind:             kind,
        format:           format,
        target:           target,
        entry:            nil,
        keep:             nil,
        keep_count:       0,
        gc_sections:      opt[bool].some{gc},
        keep_temporaries: opt[bool].none{},
        tail_merge:       opt[bool].none{},
        output:           output_path,
        sign:             opt[bool].none{},
        state:            nil
    };
    var notes: Sink = sink.make(a, LITTLE);
    fin { val freed: err[Fail] = sink.release(?notes); }
    val linked: res[Sink, Fail] = state.link(a, ?b.formats, o, sources, count, ?notes);
    if (sel linked.err) { ret res[Sink, fail.Fail].err{fail.as_user(diagnostic_kind.LINK_INPUT_INVALID, refused_by_mink(a, "the link failed", linked.err))}; }
    ret res[Sink, fail.Fail].ok{linked.ok};
}
