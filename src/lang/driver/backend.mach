# the back half a build hands its lowered modules to: the target mirl readies once for the
# build, on which driver/backend/compile has mirl compile each unit to mink's object in memory,
# mink laying an object out in the target's format or reading one back, and mink linking objects
# into an image. nothing here starts a process or writes a file between the stages
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view_eq_str;

use A: std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;
use std.memory;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use lower_context: mach.lang.me.lower.context;
use lang_source:   mach.lang.source;
use mach.lang.target.assembled;
use target_facts: mach.lang.target.facts;
use mach.lang.target.resolved;
use mach.lang.type.query.extent;

use mirl_compile: mirl.target.compile;

use mink.base.diag;
use mink_fail: mink.base.fail;
use mink.base.fail.Fail;
use mink_intern: mink.base.intern;
use mink.base.intern.Interner;
use mink.base.intern.Name;
use mink.base.store.Bytes;
use mink.base.table;
use mink.base.table.Id;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink_arch:   mink.catalog.arch;
use mink_format: mink.catalog.format;
use mink.catalog.format.Format;
use mink_kind: mink.catalog.kind;
use mink_os:   mink.catalog.os;
use mink.catalog.output;
use mink_subsystem: mink.catalog.subsystem;
use mink_target:    mink.catalog.target;
use mink.format.ar.write.Variant;
use mink.format.contract;
use mink.format.registration;
use mink.format.registration.Registration;
use mink.format.registry;
use mink.link.layout;
use mink.link.linking;
use mink.link.linking.Linking;
use mink.link.options.Area;
use mink.link.options.Offset;
use mink.link.options.Options;
use mink.link.options.Within;
