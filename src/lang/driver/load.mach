pub val MACH_VERSION: str = version.MACH_VERSION;

pub val INITIAL_MODULE_CAP: u32 = 16;

val INITIAL_PUB_CAP: u32 = 4;

val INITIAL_DEP_CAP: u32 = 4;

pub fun entry_module_fqn(p: *project.Project, t: *project.TargetEntry) res[intern.StrId, fail.Fail] {
    val ep_opt: opt[str] = intern.lookup(?p.s.interner, t.entrypoint);
    if (sel ep_opt.none) { ret res[intern.StrId, fail.Fail].err{fail.message("entrypoint StrId not interned")}; }
    val ep_text: str = ep_opt.some;

    val id_opt: opt[str] = intern.lookup(?p.s.interner, p.config.id);
    if (sel id_opt.none) { ret res[intern.StrId, fail.Fail].err{fail.message("project id StrId not interned")}; }

    ret compose_module_fqn(p.alloc, ?p.s.interner, id_opt.some, ep_text);
}

pub fun compose_module_fqn(alloc: *A.Allocator, itn: *intern.Interner, id_text: str, rel_text: str) res[intern.StrId, fail.Fail] {
    val rel_stripped: View = strip_mach_suffix(rel_text);

    val id_len: usize             = str_len(id_text);
    val total:  usize             = id_len + 1 + rel_stripped.len;
    val r_buf:  res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r_buf.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_buf.err)}; }
    val buf: *u8 = r_buf.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < id_len) {
        buf[k] = id_text[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = '.';
    k      = k + 1;
    j      = 0;
    for (j < rel_stripped.len) {
        val c: u8 = rel_stripped.data[j];
        if (c == '/' || c == '\\') { buf[k] = '.'; }
        or                         { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }

    val r: res[intern.StrId, A.Error] = intern.intern_bytes(itn, buf::str, k);
    A.deallocate[u8](alloc, buf, total);
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r.ok};
}

fun strip_mach_suffix(s: str) View {
    val suffix: str   = ".mach";
    val s_len:  usize = str_len(s);
    if (!str_ends_with(s, suffix)) { ret view(s::*char, s_len); }
    ret view(s::*char, s_len - str_len(suffix));
}

# the head segment of a module path names the project that owns the module, and
# the loader is where that ownership is decided: it is what picks the source
# root a module is read from
pub fun fqn_in_root_project(p: *project.Project, fqn: intern.StrId) bool {
    val fqn_opt: opt[str] = intern.lookup(?p.s.interner, fqn);
    if (sel fqn_opt.none) { ret false; }
    val fqn_text: str = fqn_opt.some;

    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') {
        head_end = head_end + 1;
    }

    val pid_opt: opt[str] = intern.lookup(?p.s.interner, p.config.id);
    if (sel pid_opt.none) { ret false; }
    ret view_eq_str(view(fqn_text::*char, head_end), pid_opt.some);
}

fun fqn_to_file_path(p: *project.Project, fqn: intern.StrId) res[str, fail.Fail] {
    val fqn_opt: opt[str] = intern.lookup(?p.s.interner, fqn);
    if (sel fqn_opt.none) { ret res[str, fail.Fail].err{fail.message("module FQN StrId not interned")}; }
    val fqn_text: str = fqn_opt.some;

    val fqn_len:  usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') {
        head_end = head_end + 1;
    }
    val head: View = view(fqn_text::*char, head_end);

    var tail_start: usize = head_end;
    if (tail_start < fqn_len && fqn_text[tail_start] == '.') {
        tail_start = tail_start + 1;
    }
    var tail: View = view(nil, 0);
    if (fqn_len - tail_start > 0) { tail = view(?fqn_text[tail_start], fqn_len - tail_start); }

    val pr_opt: opt[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (sel pr_opt.none) { ret res[str, fail.Fail].err{fail.message("project_root StrId not interned")}; }
    val project_root_text: str = pr_opt.some;

    if (fqn_in_root_project(p, fqn)) {
        val sd_opt: opt[str] = intern.lookup(?p.s.interner, p.config.dir_src);
        if (sel sd_opt.none) { ret res[str, fail.Fail].err{fail.message("dir_src StrId not interned")}; }
        val src_dir_text: str = sd_opt.some;
        ret build_module_path(p.alloc, project_root_text, src_dir_text, tail);
    }

    var k: u32 = 0;
    for (k < p.config.dep_count) {
        val dep: *project.DepEntry = ?p.config.deps[k];

        val di_opt: opt[str] = intern.lookup(?p.s.interner, dep.project_id);
        if (sel di_opt.none) { ret res[str, fail.Fail].err{fail.message("dep project_id StrId not interned")}; }
        val dep_id_text: str = di_opt.some;

        if (view_eq_str(head, dep_id_text)) {
            val dr_opt: opt[str] = intern.lookup(?p.s.interner, dep.vendor_root);
            if (sel dr_opt.none) { ret res[str, fail.Fail].err{fail.message("dep vendor_root StrId not interned")}; }
            val dep_root_text: str = dr_opt.some;

            val ds_opt: opt[str] = intern.lookup(?p.s.interner, dep.project_dir_src);
            if (sel ds_opt.none) { ret res[str, fail.Fail].err{fail.message("dep project_dir_src StrId not interned")}; }
            val dep_src_text: str = ds_opt.some;

            ret build_module_path(p.alloc, dep_root_text, dep_src_text, tail);
        }
        k = k + 1;
    }

    ret res[str, fail.Fail].err{fail.message("no project or dep matches the head segment of the module path")};
}

fun build_module_path(alloc: *A.Allocator, root: str, src_dir: str, dotted_tail: View) res[str, fail.Fail] {
    val root_len: usize             = str_len(root);
    val src_len:  usize             = str_len(src_dir);
    val total:    usize             = root_len + 1 + src_len + 1 + dotted_tail.len + 5 + 1;
    val r_buf:    res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r_buf.err) { ret res[str, fail.Fail].err{fail.refused(r_buf.err)}; }
    val buf: *u8 = r_buf.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < root_len) {
        buf[k] = root[j];
        k      = k + 1;
        j      = j + 1;
    }
    if (k > 0 && buf[k - 1] != '/') {
        buf[k] = '/';
        k      = k + 1;
    }
    j = 0;
    for (j < src_len) {
        buf[k] = src_dir[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = '/';
    k      = k + 1;
    j      = 0;
    for (j < dotted_tail.len) {
        val c: u8 = dotted_tail.data[j];
        if (c == '.') { buf[k] = '/'; }
        or            { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }
    buf[k]     = '.';
    buf[k + 1] = 'm';
    buf[k + 2] = 'a';
    buf[k + 3] = 'c';
    buf[k + 4] = 'h';
    k          = k + 5;
    buf[k]     = 0;

    val cr: res[path.Path, A.Error] = path.clean(alloc, buf::str);
    A.deallocate[u8](alloc, buf, total);
    if (sel cr.err) { ret res[str, fail.Fail].err{fail.refused(cr.err)}; }
    ret res[str, fail.Fail].ok{cr.ok};
}

pub fun diag_join3(s: *session.Session, a: str, b: str, c: str, fallback: str) str {
    val res_msg: res[str, format.FormatError] = format.sprint(s.alloc, "{}{}{}", a, b, c);
    if (sel res_msg.err) { ret fallback; }
    val buf: str = res_msg.ok;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf);
    str_free(s.alloc, buf);
    if (sel ir.err) { ret fallback; }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret fallback;
}

pub fun diag_join_named(s: *session.Session, prefix: str, name_id: intern.StrId, suffix: str, fallback: str) str {
    val no: opt[str] = intern.lookup(?s.interner, name_id);
    if (sel no.none) { ret fallback; }
    ret diag_join3(s, prefix, no.some, suffix, fallback);
}

pub fun join_path(alloc: *A.Allocator, a: str, b: str) res[str, fail.Fail] {
    val join_r: res[path.Path, A.Error] = path.join(alloc, a, b);
    if (sel join_r.err) { ret res[str, fail.Fail].err{fail.refused(join_r.err)}; }
    ret res[str, fail.Fail].ok{join_r.ok};
}

fun ensure_load_status_capacity(p: *project.Project, needed: u32) err[fail.Fail] {
    if (p.load_cap >= needed) { ret err[fail.Fail].ok{}; }
    var new_cap: u32 = p.load_cap;
    if (new_cap == 0) { new_cap = INITIAL_MODULE_CAP; }
    for (new_cap < needed) { new_cap = new_cap * 2; }

    if (p.load_status == nil) {
        val r: res[*project.LoadStatus, A.Error] = A.allocate[project.LoadStatus](p.alloc, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        p.load_status = r.ok;
    }
    or {
        val r: res[*project.LoadStatus, A.Error] = A.reallocate[project.LoadStatus](p.alloc, p.load_status, p.load_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        p.load_status = r.ok;
    }
    var i: u32 = p.load_cap;
    for (i < new_cap) {
        p.load_status[i] = project.LOAD_NEW;
        i                = i + 1;
    }
    p.load_cap = new_cap;
    ret err[fail.Fail].ok{};
}

# mark a module reached under the tuples the union walk is under, and say which of them are new
# to it: nil when none is, else a filter over the tuples the caller releases
fun mark_tuple_reachable(p: *project.Project, mid: session.ModuleId) res[*bool, fail.Fail] {
    if (!p.union || p.union_tuple_count == 0) { ret res[*bool, fail.Fail].ok{nil}; }
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (m.tuple_reachable == nil) {
        val ar: res[*bool, A.Error] = A.allocate[bool](p.alloc, p.union_tuple_count::usize);
        if (sel ar.err) { ret res[*bool, fail.Fail].err{fail.refused(ar.err)}; }
        m.tuple_reachable   = ar.ok;
        m.tuple_reach_count = p.union_tuple_count;
        var z: u32 = 0;
        for (z < m.tuple_reach_count) {
            m.tuple_reachable[z] = false;
            z                    = z + 1;
        }
    }
    var gained: *bool = nil;
    var ti:     u32   = 0;
    for (ti < m.tuple_reach_count) {
        if ((p.union_tuple_filter == nil || p.union_tuple_filter[ti]) && !m.tuple_reachable[ti]) {
            if (gained == nil) {
                val gr: res[*bool, A.Error] = A.allocate[bool](p.alloc, m.tuple_reach_count::usize);
                if (sel gr.err) { ret res[*bool, fail.Fail].err{fail.refused(gr.err)}; }
                gained = gr.ok;
                var z: u32 = 0;
                for (z < m.tuple_reach_count) {
                    gained[z] = false;
                    z         = z + 1;
                }
            }
            m.tuple_reachable[ti] = true;
            gained[ti]            = true;
        }
        ti = ti + 1;
    }
    ret res[*bool, fail.Fail].ok{gained};
}

# a loaded module a union walk reaches under tuples new to it is walked again under those tuples
# alone, so the arms they select load what they import; that can give it dependencies the topo
# already placed after it, so the load rebuilds the topo once it is done
fun rewalk_under_tuples(p: *project.Project, mid: session.ModuleId, gained: *bool) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (m.target_gated) { ret err[fail.Fail].ok{}; }
    val saved_filter:   *bool        = p.union_tuple_filter;
    val saved_gated:    bool         = p.in_gated_decl_walk;
    val saved_artifact: intern.StrId = p.loading_artifact;
    val saved_frame:    u32          = m.frame;
    p.union_tuple_filter = gained;
    p.in_gated_decl_walk = false;
    p.loading_artifact   = m.artifact;
    m.frame              = project.FRAME_BUILD;
    val wr: res[comptime.GateOutcome, fail.Fail] = walk_module_for_load(p, mid);
    m.frame              = saved_frame;
    p.loading_artifact   = saved_artifact;
    p.in_gated_decl_walk = saved_gated;
    p.union_tuple_filter = saved_filter;
    if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
    m.load_outcome = wr.ok;
    p.topo_dirty   = true;
    ret err[fail.Fail].ok{};
}

pub fun parse_root(p: *project.Project, fqn: intern.StrId) res[session.ModuleId, fail.Fail] {
    val existing: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?fqn);
    if (sel existing.some) { ret res[session.ModuleId, fail.Fail].ok{@existing.some}; }
    val registered: res[session.ModuleId, fail.Fail] = register_module_slot(p, fqn);
    if (sel registered.err) { ret registered; }
    val mid:    session.ModuleId = registered.ok;
    val parsed: err[fail.Fail]   = parse_module(p, mid, fqn);
    if (sel parsed.err) { ret res[session.ModuleId, fail.Fail].err{parsed.err}; }
    p.load_status[mid::u32] = project.LOAD_DONE;
    ret res[session.ModuleId, fail.Fail].ok{mid};
}

pub fun dfs_load(p: *project.Project, fqn: intern.StrId) res[session.ModuleId, fail.Fail] {
    val existing_r: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?fqn);
    if (sel existing_r.some) {
        val mid:      session.ModuleId      = @existing_r.some;
        val gained_r: res[*bool, fail.Fail] = mark_tuple_reachable(p, mid);
        if (sel gained_r.err) { ret res[session.ModuleId, fail.Fail].err{gained_r.err}; }
        val gained: *bool = gained_r.ok;
        fin {
            if (gained != nil) { A.deallocate[bool](p.alloc, gained, p.union_tuple_count::usize); }
        }
        if (p.load_status[mid::u32] == project.LOAD_LOADING) {
            ret res[session.ModuleId, fail.Fail].err{fail.message(diag_join_named(p.s, "circular module dependency: '", fqn, "' is already being loaded", "circular module dependency"))};
        }
        if (gained != nil) {
            val rewalked: err[fail.Fail] = rewalk_under_tuples(p, mid, gained);
            if (sel rewalked.err) { ret res[session.ModuleId, fail.Fail].err{rewalked.err}; }
        }
        ret res[session.ModuleId, fail.Fail].ok{mid};
    }

    val mid_r: res[session.ModuleId, fail.Fail] = register_module_slot(p, fqn);
    if (sel mid_r.err) { ret mid_r; }
    val mid: session.ModuleId     = mid_r.ok;
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);

    val marked_r: res[*bool, fail.Fail] = mark_tuple_reachable(p, mid);
    if (sel marked_r.err)   { ret res[session.ModuleId, fail.Fail].err{marked_r.err}; }
    if (marked_r.ok != nil) { A.deallocate[bool](p.alloc, marked_r.ok, p.union_tuple_count::usize); }

    val t_load:  readout.Instant = readout.item_begin(p.events);
    val parse_r: err[fail.Fail]  = parse_module(p, mid, fqn);
    if (sel parse_r.err) {
        ret res[session.ModuleId, fail.Fail].err{parse_r.err};
    }
    readout.item(p.events, readout.PH_LOAD, project.fqn_name(p, fqn), t_load);
    val gates: err[fail.Fail] = comptime.prepare_gates(?m.ctx, m.a.expr_len::u32, m.a.decl_len::u32);
    if (sel gates.err) { ret res[session.ModuleId, fail.Fail].err{gates.err}; }

    val saved_gated: bool = p.in_gated_decl_walk;
    p.in_gated_decl_walk = false;
    val walk_r: res[comptime.GateOutcome, fail.Fail] = walk_module_for_load(p, mid);
    p.in_gated_decl_walk = saved_gated;
    if (sel walk_r.err) {
        ret res[session.ModuleId, fail.Fail].err{walk_r.err};
    }
    m.load_outcome = walk_r.ok;

    p.load_status[mid::u32] = project.LOAD_DONE;

    if (m.target_gated) {
        ret res[session.ModuleId, fail.Fail].ok{mid};
    }

    val topo_r: err[fail.Fail] = topo_push(p, mid);
    if (sel topo_r.err) { ret res[session.ModuleId, fail.Fail].err{topo_r.err}; }

    ret res[session.ModuleId, fail.Fail].ok{mid};
}

# reparse and re-walk one loaded module in place, after its text changed, and say
# whether its load surface survived: the modules it reaches, the public constants it
# declares to importers' gates, its own gate outcome and its target gating. a surface
# that survived leaves the project's module set, topo and every other entry as they
# are, so the caller can rerun the query phases over the kept project; one that did
# not needs a full load. the entry's walk state is rebuilt from a fresh comptime
# context, since gate states and load marks are keyed by the old syntax tree's ids
# ---
# p:   the loaded project
# mid: the module whose text changed
# ret: ok(true) when the surface is unchanged; ok(false) when the caller must reload;
#      or the parse or walk failure
pub fun reload_module(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);

    val old_modules:   u32                  = project.module_count(p);
    val old_outcome:   comptime.GateOutcome = m.load_outcome;
    val old_gated:     bool                 = m.target_gated;
    val old_deps:      *session.ModuleId    = m.deps;
    val old_dep_n:     u32                  = m.dep_count;
    val old_dep_cap:   u32                  = m.dep_cap;
    val old_consts:    *project.PubConst    = m.pub_consts;
    val old_const_n:   u32                  = m.pub_const_count;
    val old_const_cap: u32                  = m.pub_const_cap;
    fin {
        if (old_deps != nil)   { A.deallocate[session.ModuleId](p.alloc, old_deps, old_dep_cap::usize); }
        if (old_consts != nil) { A.deallocate[project.PubConst](p.alloc, old_consts, old_const_cap::usize); }
    }

    val ctx_r: res[comptime.ComptimeCtx, fail.Fail] = module_context(p, ?p.req, m.artifact);
    if (sel ctx_r.err) { ret res[bool, fail.Fail].err{ctx_r.err}; }
    comptime.dnit(?m.ctx);
    project.drop_tuple_frames(p, m);
    m.ctx                   = ctx_r.ok;
    m.frame                 = project.FRAME_BUILD;
    m.deps                  = nil;
    m.dep_count             = 0;
    m.dep_cap               = 0;
    m.pub_consts            = nil;
    m.pub_const_count       = 0;
    m.pub_const_cap         = 0;
    m.mod_ref_count         = 0;
    m.const_import_count    = 0;
    m.resolve_result        = nil;
    m.resolved              = false;
    m.sema_result           = nil;
    m.ir_module             = nil;
    m.object_image          = nil;
    m.staged_image          = nil;
    m.cache_checked         = false;
    m.cache_hit             = false;
    m.parse_status          = fail.accepted();
    m.load_status           = fail.accepted();
    m.load_outcome          = comptime.GATE_ACTIVE;
    p.load_status[mid::u32] = project.LOAD_LOADING;

    val parse_r: err[fail.Fail] = parse_module(p, mid, m.fqn);
    if (sel parse_r.err) {
        p.load_status[mid::u32] = project.LOAD_DONE;
        ret res[bool, fail.Fail].err{parse_r.err};
    }
    val gates: err[fail.Fail] = comptime.prepare_gates(?m.ctx, m.a.expr_len::u32, m.a.decl_len::u32);
    if (sel gates.err) {
        p.load_status[mid::u32] = project.LOAD_DONE;
        ret res[bool, fail.Fail].err{gates.err};
    }
    val saved_gated: bool = p.in_gated_decl_walk;
    p.in_gated_decl_walk = false;
    val saved_artifact: intern.StrId = p.loading_artifact;
    p.loading_artifact = m.artifact;
    val walk_r: res[comptime.GateOutcome, fail.Fail] = walk_module_for_load(p, mid);
    p.loading_artifact      = saved_artifact;
    p.in_gated_decl_walk    = saved_gated;
    p.load_status[mid::u32] = project.LOAD_DONE;
    if (sel walk_r.err) { ret res[bool, fail.Fail].err{walk_r.err}; }
    m.load_outcome = walk_r.ok;

    if (project.module_count(p) != old_modules)                                     { ret res[bool, fail.Fail].ok{false}; }
    if (m.load_outcome != old_outcome)                                              { ret res[bool, fail.Fail].ok{false}; }
    if (m.target_gated != old_gated)                                                { ret res[bool, fail.Fail].ok{false}; }
    if (!same_dep_set(old_deps, old_dep_n, m.deps, m.dep_count))                    { ret res[bool, fail.Fail].ok{false}; }
    if (!same_pub_consts(old_consts, old_const_n, m.pub_consts, m.pub_const_count)) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{true};
}

fun same_dep_set(a: *session.ModuleId, an: u32, b: *session.ModuleId, bn: u32) bool {
    if (an != bn) { ret false; }
    var i: u32 = 0;
    for (i < an) {
        var found: bool = false;
        var j:     u32  = 0;
        for (j < bn) {
            if (b[j] == a[i]) { found = true; }
            j = j + 1;
        }
        if (!found) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_ct_value(a: *comptime.CTValue, b: *comptime.CTValue) bool {
    if (a.kind != b.kind || a.int_unsigned != b.int_unsigned || a.int_width != b.int_width || a.float_width != b.float_width) { ret false; }
    if (a.kind == comptime.CT_KIND_INT)                                                                                       { ret a.data.w.lo == b.data.w.lo && a.data.w.hi == b.data.w.hi; }
    if (a.kind == comptime.CT_KIND_FLOAT)                                                                                     { ret a.data.f == b.data.f; }
    if (a.kind == comptime.CT_KIND_STR)                                                                                       { ret a.data.s == b.data.s; }
    if (a.kind == comptime.CT_KIND_NON_INTEGER)                                                                               { ret a.data.s == b.data.s; }
    if (a.kind == comptime.CT_KIND_TYPE)                                                                                      { ret a.data.t == b.data.t; }
    if (a.kind == comptime.CT_KIND_FIELD || a.kind == comptime.CT_KIND_CASE)                                                  { ret a.data.fld.owner == b.data.fld.owner && a.data.fld.index == b.data.fld.index; }
    if (a.kind == comptime.CT_KIND_PACK_ELEM)                                                                                 { ret a.data.pelem.index == b.data.pelem.index && a.data.pelem.ty == b.data.pelem.ty; }
    if (a.kind == comptime.CT_KIND_CONST_ELEM)                                                                                { ret a.data.celem.elem == b.data.celem.elem && a.data.celem.ty == b.data.celem.ty; }
    ret false;
}

fun same_pub_consts(a: *project.PubConst, an: u32, b: *project.PubConst, bn: u32) bool {
    if (an != bn) { ret false; }
    var i: u32 = 0;
    for (i < an) {
        if (a[i].name != b[i].name || a[i].gated != b[i].gated || !same_ct_value(?a[i].value, ?b[i].value)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the comptime context a module's gates and bodies evaluate in; `artifact` is the one the
# module is attributed to, what `$bin.name` reads
fun module_context(p: *project.Project, req: *request.BuildRequest, artifact: intern.StrId) res[comptime.ComptimeCtx, fail.Fail] {
    if (p == nil || req == nil || p.target_entry == nil) {
        ret res[comptime.ComptimeCtx, fail.Fail].err{fail.message("driver: module context requires an opened project and request")};
    }

    var build_mode_id: u32 = comptime.MODE_DEBUG;
    if (request.release(req)) { build_mode_id = comptime.MODE_RELEASE; }
    var build_pie: u32 = 0;
    if (req.pie) { build_pie = 1; }

    var ctx: comptime.ComptimeCtx = comptime.init(
        p.alloc,
        p.target.os_id,
        p.target.arch_id,
        p.target.abi_id,
        build_mode_id,
        build_pie,
        p.target.isa.pointer_width,
        p.target.model.vector_bits,
        p.target.model.has_float,
        p.compiler_name,
        p.compiler_ver);
    comptime.set_target_defs(?ctx, p.target.isa.defs);
    comptime.set_va_list(?ctx, p.target.va_list_size, p.target.va_list_align);
    comptime.set_ct_mul(?ctx, target.ct_mul_admitted(?p.target));
    comptime.set_extensions(?ctx, isa.extension_view(?p.target.model));
    comptime.set_union_build(?ctx, p.union);
    comptime.set_build_context(?ctx,
        p.config.id, p.config.version,
        p.target_entry.os_name, p.target_entry.isa_name, p.target_entry.abi_name,
        p.target_entry.platform_name,
        artifact);
    ret res[comptime.ComptimeCtx, fail.Fail].ok{ctx};
}

fun register_module_slot(p: *project.Project, fqn: intern.StrId) res[session.ModuleId, fail.Fail] {
    val mid: session.ModuleId = project.module_count(p);

    val slot_r: err[fail.Fail] = project.module_reserve(p);
    if (sel slot_r.err) { ret res[session.ModuleId, fail.Fail].err{slot_r.err}; }

    val cap_r: err[fail.Fail] = ensure_load_status_capacity(p, mid::u32 + 1);
    if (sel cap_r.err) { ret res[session.ModuleId, fail.Fail].err{cap_r.err}; }

    val sid_r: res[session.StableModuleId, fail.Fail] = session.stable_module_id(p.s, fqn);
    if (sel sid_r.err) { ret res[session.ModuleId, fail.Fail].err{sid_r.err}; }

    val ctx_r: res[comptime.ComptimeCtx, fail.Fail] = module_context(p, ?p.req, p.loading_artifact);
    if (sel ctx_r.err) {
        ret res[session.ModuleId, fail.Fail].err{ctx_r.err};
    }

    var m: project.ModuleEntry;
    m.fqn                = fqn;
    m.file_id            = 0;
    m.stable_id          = sid_r.ok;
    m.a                  = nil;
    m.parse_status       = fail.accepted();
    m.load_status        = fail.accepted();
    m.ctx                = ctx_r.ok;
    m.pub_consts         = nil;
    m.pub_const_count    = 0;
    m.pub_const_cap      = 0;
    m.mod_refs           = nil;
    m.mod_ref_count      = 0;
    m.mod_ref_cap        = 0;
    m.const_imports      = nil;
    m.const_import_count = 0;
    m.const_import_cap   = 0;
    m.deps               = nil;
    m.dep_count          = 0;
    m.dep_cap            = 0;
    m.resolve_result     = nil;
    m.resolved           = false;
    m.resolve_elapsed    = 0;
    m.frame              = project.FRAME_BUILD;
    m.tuple_frames       = nil;
    m.tuple_frame_count  = 0;
    m.typed_surface      = nil;
    m.typed_surface_rev  = 0;
    m.tuple_reachable    = nil;
    m.tuple_reach_count  = 0;
    m.sema_result        = nil;
    m.ir_module          = nil;
    m.object_image       = nil;
    m.staged_image       = nil;
    m.staged_facts       = codec.Facts{};
    m.cache_checked      = false;
    m.cache_hit          = false;
    var cache_byte: usize = 0;
    for (cache_byte < 32) {
        m.cache_under[cache_byte] = 0;
        cache_byte                = cache_byte + 1;
    }
    # a module first reached from an artifact this target does not build belongs to that
    # artifact's target, not this one
    m.target_gated = p.loading_foreign;
    m.artifact     = p.loading_artifact;
    m.load_outcome = comptime.GATE_ACTIVE;

    val ins_r: res[bool, A.Error] = map.insert[intern.StrId, session.ModuleId](?p.by_fqn, fqn, mid);
    if (sel ins_r.err) {
        comptime.dnit(?m.ctx);
        ret res[session.ModuleId, fail.Fail].err{fail.refused(ins_r.err)};
    }

    val root_r: err[fail.Fail] = session.register_module_root_project(p.s, mid, fqn_in_root_project(p, fqn));
    if (sel root_r.err) {
        comptime.dnit(?m.ctx);
        ret res[session.ModuleId, fail.Fail].err{root_r.err};
    }

    project.module_append(p, m);
    p.load_status[mid::u32] = project.LOAD_LOADING;
    ret res[session.ModuleId, fail.Fail].ok{mid};
}

fun parse_module(p: *project.Project, mid: session.ModuleId, fqn: intern.StrId) err[fail.Fail] {
    val path_r: res[str, fail.Fail] = fqn_to_file_path(p, fqn);
    if (sel path_r.err) { ret err[fail.Fail].err{path_r.err}; }
    val file_path: str = path_r.ok;

    var text:       str      = nil;
    var text_owned: bool     = false;
    val ov:         opt[str] = session.overlay_get(p.s, file_path);
    if (sel ov.some) {
        text = ov.some;
    }
    if (sel ov.none) {
        val text_r: res[str, fs.FsError] = fs.read_string(p.alloc, file_path);
        if (sel text_r.err) {
            str_free(p.alloc, file_path);
            ret err[fail.Fail].err{fail.fs_refused(text_r.err)};
        }
        text       = text_r.ok;
        text_owned = true;
    }

    val fid_r: res[src.FileId, fail.Fail] = session.load_source(p.s, file_path, text);
    str_free(p.alloc, file_path);
    if (text_owned)    { str_free(p.alloc, text); }
    if (sel fid_r.err) { ret err[fail.Fail].err{fid_r.err}; }
    val file_id: src.FileId = fid_r.ok;

    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    m.file_id = file_id;

    ret acquire_load_view(p, mid, 0);
}

fun acquire_parse_view(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m:        *project.ModuleEntry            = project.module_at(p, mid::u32);
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_PARSE, m.file_id::u64);
    if (sel acquired.err) {
        val failure: fail.Fail = acquired.err;
        if (sel failure.reported) { fail.reject(?m.parse_status); }
        or                        { fail.internal(?m.parse_status, fail.describe(failure)); }
        ret err[fail.Fail].err{failure};
    }
    val owner: query.QueryView = acquired.ok;
    val a:     *ast.Ast        = ast_handle_decode(owner);
    if (a == nil) { ret err[fail.Fail].err{fail.message("Q_PARSE produced no AST handle")}; }
    m.a            = a;
    m.parse_status = (owner.value::ptr::*ParsedModule).status;
    ret err[fail.Fail].ok{};
}

fun acquire_load_view(p: *project.Project, mid: session.ModuleId, incarnation: u64) err[fail.Fail] {
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(p);
    if (sel begun.err) { ret err[fail.Fail].err{fail.message(outcome.describe(begun.err))}; }
    val operation: query.Operation   = begun.ok;
    var result:    err[outcome.Fail] = err[outcome.Fail].ok{};
    val acquired:  err[fail.Fail]    = acquire_parse_view(p, mid);
    if (sel acquired.err) { result = err[outcome.Fail].err{outcome.from_fail(acquired.err)}; }
    or (incarnation != 0 && project.module_at(p, mid::u32).a.incarnation != incarnation) {
        result = err[outcome.Fail].err{outcome.internal("module syntax changed during dependency discovery")};
    }
    var root:  query.QueryKey = query.QueryKey{kind: query.Q_PARSE, key: project.module_at(p, mid::u32).file_id::u64};
    var count: usize          = 0;
    if (sel result.err) { count = 1; }
    val finished: err[outcome.Fail] = project.finish_query_phase(p, operation, ?root, count, result);
    if (sel finished.err) { ret err[fail.Fail].err{fail.message(outcome.describe(finished.err))}; }
    ret err[fail.Fail].ok{};
}

pub fun parsed_definition(ctx: ptr, mid: session.ModuleId) res[resolve.ParsedDefinition, fail.Fail] {
    val p: *project.Project = ctx::*project.Project;
    if (p == nil || mid == session.MODULE_NIL || mid::u32 >= project.module_count(p)) {
        ret res[resolve.ParsedDefinition, fail.Fail].err{fail.message("parsed definition module is not in the active project")};
    }
    val m:        *project.ModuleEntry            = project.module_at(p, mid::u32);
    val file_id:  src.FileId                      = m.file_id;
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_PARSE, file_id::u64);
    if (sel acquired.err) { ret res[resolve.ParsedDefinition, fail.Fail].err{acquired.err}; }
    val owner: query.QueryView = acquired.ok;
    val a:     *ast.Ast        = ast_handle_decode(owner);
    if (a == nil) { ret res[resolve.ParsedDefinition, fail.Fail].err{fail.message("parsed definition query produced no AST owner")}; }
    val status: fail.PhaseStatus = (owner.value::ptr::*ParsedModule).status;
    m.a            = a;
    m.parse_status = status;
    ret res[resolve.ParsedDefinition, fail.Fail].ok{resolve.ParsedDefinition{a: a, status: status, owner: resolve.type_owner(p.s, mid, file_id), incarnation: a.incarnation}};
}

pub fun q_parse_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db:      *query.QueryDb   = ?p.s.queries;
    val s:       *session.Session = p.s;
    val file_id: src.FileId       = key::u32;

    val rd: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_FILE_TEXT, key);
    if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }

    val file_opt: opt[*src.SourceFile] = src.get(?s.sources, file_id);
    if (sel file_opt.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_PARSE: FileId not registered with the session")}; }
    val file: *src.SourceFile = file_opt.some;

    val tok_r: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(file.text, alloc, file_id);
    if (sel tok_r.err) { ret res[query.QueryOutput, fail.Fail].err{tok_r.err}; }
    var stream: lexer.TokenStream = tok_r.ok;

    val ar: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](alloc, 1::usize);
    if (sel ar.err) {
        lexer.dnit(?stream, alloc);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(ar.err)};
    }
    val a: *ast.Ast = ar.ok;
    a[0] = ast.init(alloc, file_id);
    val incarnation: res[u64, fail.Fail] = session.next_parse_incarnation(s);
    if (sel incarnation.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1);
        lexer.dnit(?stream, alloc);
        ret res[query.QueryOutput, fail.Fail].err{incarnation.err};
    }
    a.incarnation = incarnation.ok;

    val le_r: err[fail.Fail] = lexer.emit_diagnostics(?stream, diags);
    if (sel le_r.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        lexer.dnit(?stream, alloc);
        ret res[query.QueryOutput, fail.Fail].err{le_r.err};
    }
    val parse_r: res[fail.PhaseStatus, state.ParseFail] = parser.parse(?stream, a, diags);
    lexer.dnit(?stream, alloc);
    if (sel parse_r.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        val f: state.ParseFail = parse_r.err;
        ret res[query.QueryOutput, fail.Fail].err{state.failure(f)};
    }

    ret ast_handle_encode(alloc, a, parse_r.ok);
}

rec ParsedModule {
    a:      *ast.Ast;
    status: fail.PhaseStatus;
}

pub fun q_parse_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ParsedModule)) { ret; }
    val a: *ast.Ast = (value::ptr::*ParsedModule).a;
    if (a == nil) { ret; }
    ast.dnit(a);
    A.deallocate[ast.Ast](alloc, a, 1::usize);
}

fun ast_handle_encode(alloc: *A.Allocator, a: *ast.Ast, status: fail.PhaseStatus) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ParsedModule)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8           = rb.ok;
    val slot: *ParsedModule = buf::ptr::*ParsedModule;
    slot.a      = a;
    slot.status = status;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun ast_handle_decode(e: query.QueryView) *ast.Ast {
    if (e.value == nil || e.value_len::usize < $size_of(ParsedModule)) { ret nil; }
    ret (e.value::ptr::*ParsedModule).a;
}

pub fun q_exports_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, key);
    if (sel e_r.err) { ret res[query.QueryOutput, fail.Fail].err{e_r.err}; }
    val rr: *resolve.ResolveResult = dq.resolve_handle_decode(e_r.ok);
    if (rr == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_EXPORTS: module has no resolve result")}; }

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    var definition_revision: query.Revision = 0;
    var i:                   u32            = 0;
    for (i < rr.public_constant_count) {
        if (rr.public_constants[i].present && rr.public_constants[i].value.kind == comptime.CT_KIND_CONST_ELEM) {
            val mid: session.ModuleId = session.module_id_for_stable(p.s, key::u32::session.StableModuleId);
            if (mid == session.MODULE_NIL) {
                dq.fp_free(?fb);
                ret res[query.QueryOutput, fail.Fail].err{fail.message("constant definition is not loaded")};
            }
            val observed: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p,
                query.Q_PARSE, project.module_at(p, mid::u32).file_id::u64);
            if (sel observed.err) {
                dq.fp_free(?fb);
                ret res[query.QueryOutput, fail.Fail].err{observed.err};
            }
            definition_revision = observed.ok;
            brk;
        }
        i = i + 1;
    }
    val wr: err[fail.Fail] = dq.fp_public_surface(?fb, rr, key::u32::session.StableModuleId, definition_revision);
    if (sel wr.err) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](alloc, fb.buf, fb.cap::usize); }
        ret res[query.QueryOutput, fail.Fail].err{wr.err};
    }

    ret dq.fp_take(?fb);
}

fun walk_module_for_load(p: *project.Project, mid: session.ModuleId) res[comptime.GateOutcome, fail.Fail] {
    val acquired: err[fail.Fail] = acquire_load_view(p, mid, 0);
    if (sel acquired.err) { ret res[comptime.GateOutcome, fail.Fail].err{acquired.err}; }
    val m:     *project.ModuleEntry = project.module_at(p, mid::u32);
    val m_opt: opt[*module.Module]  = ast.get_module(m.a, m.a.root_module);
    if (sel m_opt.none) { ret res[comptime.GateOutcome, fail.Fail].err{fail.message("module root not set on Ast")}; }
    val mod_node: *module.Module = m_opt.some;
    ret walk_decl_list_for_load(p, mid, mod_node.decls_start, mod_node.decls_len);
}

fun walk_decl_list_for_load(p: *project.Project, mid: session.ModuleId, start: u32, len: u32) res[comptime.GateOutcome, fail.Fail] {
    val refreshed: err[fail.Fail] = acquire_load_view(p, mid, 0);
    if (sel refreshed.err) { ret res[comptime.GateOutcome, fail.Fail].err{refreshed.err}; }
    val a:           *ast.Ast = project.module_at(p, mid::u32).a;
    val incarnation: u64      = a.incarnation;
    if (start::usize > a.decl_id_len || len::usize > a.decl_id_len - start::usize) {
        ret res[comptime.GateOutcome, fail.Fail].err{fail.message("load declaration list exceeds its parsed owner")};
    }
    var work: vector.Vector[id.DeclId] = vector.init[id.DeclId](p.alloc);
    fin { vector.dnit[id.DeclId](?work); }
    var wi: u32 = 0;
    for (wi < len) {
        val saved: res[usize, A.Error] = vector.push[id.DeclId](?work, a.decl_ids[start + wi]);
        if (sel saved.err) { ret res[comptime.GateOutcome, fail.Fail].err{fail.refused(saved.err)}; }
        wi = wi + 1;
    }
    var sequence: u64 = p.s.queries.operation_sequence;
    var i:        u32 = 0;
    for (i < len) {
        if (p.s.queries.operation_sequence != sequence) {
            val current: err[fail.Fail] = acquire_load_view(p, mid, incarnation);
            if (sel current.err) { ret res[comptime.GateOutcome, fail.Fail].err{current.err}; }
            sequence = p.s.queries.operation_sequence;
        }
        val r: res[comptime.GateOutcome, fail.Fail] = walk_one_decl_for_load(p, mid, work.data[i]);
        if (sel r.err)                    { ret r; }
        if (r.ok != comptime.GATE_ACTIVE) { ret r; }
        i = i + 1;
    }
    ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
}

fun walk_one_decl_for_load(p: *project.Project, mid: session.ModuleId, did: id.DeclId) res[comptime.GateOutcome, fail.Fail] {
    val m:     *project.ModuleEntry = project.module_at(p, mid::u32);
    val d_opt: opt[*decl.Decl]      = ast.get_decl(m.a, did);
    if (sel d_opt.none) { ret res[comptime.GateOutcome, fail.Fail].err{fail.message("DeclId out of range during walk")}; }
    var copied: decl.Decl  = @d_opt.some;
    val d:      *decl.Decl = ?copied;

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret walk_comptime_if_for_load(p, mid, did, ?d.data.comptime_if);
    }
    if (comptime.load_walked(frame_ctx(m), did)
        && !(p.union && (d.kind == decl.DECL_KIND_USE || d.kind == decl.DECL_KIND_FWD))) {
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
    }
    if (d.kind == decl.DECL_KIND_USE) {
        val r: err[fail.Fail] = walk_use_for_load(p, mid, did, ?d.data.use_);
        ret finish_decl_walk(p, mid, did, r);
    }
    if (d.kind == decl.DECL_KIND_FWD) {
        val r: err[fail.Fail] = walk_fwd_for_load(p, mid, ?d.data.fwd_);
        ret finish_decl_walk(p, mid, did, r);
    }
    if (d.kind == decl.DECL_KIND_VAL) {
        # a verdict matters only to a gate that demanded the constant; the walk goes on
        val r: res[Verdict, fail.Fail] = walk_val(p, mid, did);
        if (sel r.err) { ret res[comptime.GateOutcome, fail.Fail].err{r.err}; }
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
    }
    comptime.mark_load_walked(frame_ctx(m), did);
    ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
}

fun finish_decl_walk(p: *project.Project, mid: session.ModuleId, did: id.DeclId, r: err[fail.Fail]) res[comptime.GateOutcome, fail.Fail] {
    if (sel r.err) {
        ret res[comptime.GateOutcome, fail.Fail].err{r.err};
    }
    comptime.mark_load_walked(frame_ctx(project.module_at(p, mid::u32)), did);
    ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
}

fun walk_comptime_if_for_load(p: *project.Project, mid: session.ModuleId, did: id.DeclId, ci: *decl.DeclComptimeIf) res[comptime.GateOutcome, fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (!p.union && comptime.load_walked(frame_ctx(m), did)) { ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE}; }
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[comptime.GateOutcome, fail.Fail].err{source_r.err}; }
    val source: str = source_r.ok;

    # a chain whose every arm declares nothing selects no declaration, so type checking decides it
    if (comptime.comptime_if_declares_nothing(m.a, ci.branches_start, ci.branches_len)) {
        comptime.mark_load_walked(frame_ctx(m), did);
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
    }

    if (p.union) { ret walk_comptime_if_union(p, mid, did, ci, source); }

    val choice_r: res[ChainChoice, fail.Fail] = decide_chain(p, mid, ci, source);
    if (sel choice_r.err) { ret res[comptime.GateOutcome, fail.Fail].err{choice_r.err}; }
    val choice: ChainChoice = choice_r.ok;
    if (choice.outcome == comptime.GATE_REJECTED || choice.outcome == comptime.GATE_FAILED) {
        comptime.mark_load_walked(frame_ctx(m), did);
        ret res[comptime.GateOutcome, fail.Fail].ok{choice.outcome};
    }
    if (choice.branch < ci.branches_len) {
        val br:          *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + choice.branch];
        val saved_gated: bool                 = p.in_gated_decl_walk;
        p.in_gated_decl_walk = true;
        val wr: res[comptime.GateOutcome, fail.Fail] = walk_decl_list_for_load(p, mid, br.body_start, br.body_len);
        p.in_gated_decl_walk = saved_gated;
        if (sel wr.err) { ret wr; }
        comptime.mark_load_walked(frame_ctx(m), did);
        ret wr;
    }
    comptime.mark_load_walked(frame_ctx(m), did);
    ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
}

# a union walk decides each chain in the frame of every tuple it is under, and in the build
# target's, which resolve reads, when the walk is in it. each arm taken is walked once under the
# tuples that took it, in a frame that selects it: the build target's when it does, else the
# first of those tuples'. so a frame binds only what its own arms declare, and a tuple frame
# binds the rest of what its gates read on demand
fun walk_comptime_if_union(p: *project.Project, mid: session.ModuleId, did: id.DeclId, ci: *decl.DeclComptimeIf, source: str) res[comptime.GateOutcome, fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    val n: u32                  = ci.branches_len;
    if (n == 0) {
        comptime.mark_load_walked(frame_ctx(m), did);
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
    }

    # the build target decides a chain only in a walk its own arms led to
    var built_arm: u32 = n;
    if (m.frame == project.FRAME_BUILD) {
        val built: res[ChainChoice, fail.Fail] = decide_in_frame(p, mid, project.FRAME_BUILD, ci, source);
        if (sel built.err)                            { ret res[comptime.GateOutcome, fail.Fail].err{built.err}; }
        if (built.ok.outcome == comptime.GATE_ACTIVE) { built_arm = built.ok.branch; }
    }

    val tk_r: res[*bool, A.Error] = A.allocate[bool](p.alloc, n::usize);
    if (sel tk_r.err) { ret res[comptime.GateOutcome, fail.Fail].err{fail.refused(tk_r.err)}; }
    val taken: *bool = tk_r.ok;
    fin { A.deallocate[bool](p.alloc, taken, n::usize); }
    var z: u32 = 0;
    for (z < n) {
        taken[z] = false;
        z        = z + 1;
    }

    val branch_count: usize = n::usize;
    val tuple_count:  usize = p.union_tuple_count::usize;
    val usize_max:    usize = ~(0::usize);
    if (tuple_count != 0 && branch_count > usize_max / tuple_count) {
        ret res[comptime.GateOutcome, fail.Fail].err{fail.message("union gate coverage size overflow")};
    }
    val coverage_len: usize               = branch_count * tuple_count;
    val cr:           res[*bool, A.Error] = A.allocate[bool](p.alloc, coverage_len);
    if (sel cr.err) { ret res[comptime.GateOutcome, fail.Fail].err{fail.refused(cr.err)}; }
    val coverage: *bool = cr.ok;
    fin { A.deallocate[bool](p.alloc, coverage, coverage_len); }
    var zi: usize = 0;
    for (zi < coverage_len) {
        coverage[zi] = false;
        zi           = zi + 1;
    }

    # every tuple decides the chain, so each one's refusal is reported, and a refusal ends the walk
    var refused: comptime.GateOutcome = comptime.GATE_ACTIVE;
    var ti:      u32                  = 0;
    for (ti < p.union_tuple_count) {
        if (p.union_tuple_filter != nil && !p.union_tuple_filter[ti]) {
            ti = ti + 1;
            cnt;
        }
        val framed: err[fail.Fail] = ensure_tuple_frames(p, m);
        if (sel framed.err) { ret res[comptime.GateOutcome, fail.Fail].err{framed.err}; }
        val decided: res[ChainChoice, fail.Fail] = decide_in_frame(p, mid, ti, ci, source);
        if (sel decided.err) { ret res[comptime.GateOutcome, fail.Fail].err{decided.err}; }
        val choice: ChainChoice = decided.ok;
        if (choice.outcome == comptime.GATE_REJECTED || choice.outcome == comptime.GATE_FAILED) {
            if (refused == comptime.GATE_ACTIVE) { refused = choice.outcome; }
        }
        or (choice.branch < n) {
            taken[choice.branch]                                     = true;
            coverage[choice.branch::usize * tuple_count + ti::usize] = true;
        }
        ti = ti + 1;
    }
    if (refused != comptime.GATE_ACTIVE) {
        comptime.mark_load_walked(frame_ctx(m), did);
        ret res[comptime.GateOutcome, fail.Fail].ok{refused};
    }

    val incarnation: u64 = m.a.incarnation;
    var sequence:    u64 = p.s.queries.operation_sequence;
    var bi:          u32 = 0;
    for (bi < n) {
        if (taken[bi] || bi == built_arm) {
            if (p.s.queries.operation_sequence != sequence) {
                val current: err[fail.Fail] = acquire_load_view(p, mid, incarnation);
                if (sel current.err) { ret res[comptime.GateOutcome, fail.Fail].err{current.err}; }
                sequence = p.s.queries.operation_sequence;
            }
            var frame: u32 = project.FRAME_BUILD;
            if (bi != built_arm) { frame = first_tuple_of(?coverage[bi::usize * tuple_count], p.union_tuple_count); }
            val br:           *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
            val saved_filter: *bool                = p.union_tuple_filter;
            val saved_frame:  u32                  = m.frame;
            p.union_tuple_filter = ?coverage[bi::usize * tuple_count];
            m.frame              = frame;
            val saved_gated: bool = p.in_gated_decl_walk;
            p.in_gated_decl_walk = true;
            val w: res[comptime.GateOutcome, fail.Fail] = walk_decl_list_for_load(p, mid, br.body_start, br.body_len);
            p.in_gated_decl_walk = saved_gated;
            m.frame              = saved_frame;
            p.union_tuple_filter = saved_filter;
            if (sel w.err) { ret w; }
            if (w.ok != comptime.GATE_ACTIVE) {
                comptime.mark_load_walked(frame_ctx(m), did);
                ret w;
            }
        }
        bi = bi + 1;
    }
    comptime.mark_load_walked(frame_ctx(m), did);
    ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_ACTIVE};
}

# the first tuple a filter admits; a filter an arm is walked under admits at least one
fun first_tuple_of(filter: *bool, count: u32) u32 {
    var ti: u32 = 0;
    for (ti < count) {
        if (filter[ti]) { ret ti; }
        ti = ti + 1;
    }
    ret project.FRAME_BUILD;
}

# decide a chain in one frame of a union build: the build target's, where a module a demand
# reaches is reached under no tuple, or one tuple's, where it is reached under that tuple
fun decide_in_frame(p: *project.Project, mid: session.ModuleId, frame: u32, ci: *decl.DeclComptimeIf, source: str) res[ChainChoice, fail.Fail] {
    val m:  *project.ModuleEntry = project.module_at(p, mid::u32);
    val fr: res[*bool, A.Error]  = A.allocate[bool](p.alloc, p.union_tuple_count::usize + 1);
    if (sel fr.err) { ret res[ChainChoice, fail.Fail].err{fail.refused(fr.err)}; }
    val filter: *bool = fr.ok;
    fin { A.deallocate[bool](p.alloc, filter, p.union_tuple_count::usize + 1); }
    var i: u32 = 0;
    for (i < p.union_tuple_count) {
        filter[i] = i == frame;
        i         = i + 1;
    }
    val saved_frame:  u32   = m.frame;
    val saved_filter: *bool = p.union_tuple_filter;
    m.frame              = frame;
    p.union_tuple_filter = filter;
    val r: res[ChainChoice, fail.Fail] = decide_chain(p, mid, ci, source);
    p.union_tuple_filter = saved_filter;
    m.frame              = saved_frame;
    ret r;
}

# the arm a chain selects, decided in the module's current frame
# ---
# outcome: GATE_ACTIVE when an arm is selected, GATE_INACTIVE when none is, or the refusal
# branch:  the selected arm, or the arm count when none is
# verdict: a refusal the chain passes down to the demand that owns it, VERDICT_ABSENT otherwise
rec ChainChoice {
    outcome: comptime.GateOutcome;
    branch:  u32;
    verdict: Verdict;
}

fun chain_choice(outcome: comptime.GateOutcome, branch: u32, verdict: Verdict) ChainChoice {
    ret ChainChoice{outcome: outcome, branch: branch, verdict: verdict};
}

fun decide_chain(p: *project.Project, mid: session.ModuleId, ci: *decl.DeclComptimeIf, source: str) res[ChainChoice, fail.Fail] {
    val n:  u32 = ci.branches_len;
    var bi: u32 = 0;
    for (bi < n) {
        val br: *decl.ComptimeBranch = ?project.module_at(p, mid::u32).a.comptime_branches[ci.branches_start + bi];
        if (br.cond == id.EXPR_NIL) { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime.GATE_ACTIVE, bi, verdict(VERDICT_ABSENT))}; }
        val decided: res[GateChoice, fail.Fail] = decide_gate(p, mid, br.cond, source);
        if (sel decided.err) { ret res[ChainChoice, fail.Fail].err{decided.err}; }
        val g: GateChoice = decided.ok;
        if (g.verdict.kind == VERDICT_REFUSED)   { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime.GATE_FAILED, n, g.verdict)}; }
        if (g.outcome == comptime.GATE_ACTIVE)   { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime.GATE_ACTIVE, bi, g.verdict)}; }
        if (g.outcome != comptime.GATE_INACTIVE) { ret res[ChainChoice, fail.Fail].ok{chain_choice(g.outcome, n, g.verdict)}; }
        bi = bi + 1;
    }
    ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime.GATE_INACTIVE, n, verdict(VERDICT_ABSENT))};
}

rec GateChoice {
    outcome: comptime.GateOutcome;
    verdict: Verdict;
}

fun gate_choice(outcome: comptime.GateOutcome) GateChoice {
    ret GateChoice{outcome: outcome, verdict: verdict(VERDICT_ABSENT)};
}

# decide one declaring gate in the module's current frame. every constant it names is demanded
# first, so it reads a constant declared later in its module as readily as one declared before
# it; a gate that asks a type question, directly or through a constant it reads, or that its
# own constants lead back to, is refused here
fun decide_gate(p: *project.Project, mid: session.ModuleId, cond: id.ExprId, source: str) res[GateChoice, fail.Fail] {
    val m:     *project.ModuleEntry  = project.module_at(p, mid::u32);
    val ctx:   *comptime.ComptimeCtx = frame_ctx(m);
    val known: comptime.GateState    = comptime.gate_state(ctx, cond);
    if (known == comptime.GATE_STATE_TRUE)     { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime.GATE_ACTIVE)}; }
    if (known == comptime.GATE_STATE_FALSE)    { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime.GATE_INACTIVE)}; }
    if (known == comptime.GATE_STATE_REJECTED) { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime.GATE_REJECTED)}; }

    val open: opt[u32] = demand_find(p, mid, m.frame, id.DECL_NIL, cond);
    if (sel open.some) {
        val cycle: res[Verdict, fail.Fail] = cycle_verdict(p, open.some);
        if (sel cycle.err) { ret res[GateChoice, fail.Fail].err{cycle.err}; }
        ret res[GateChoice, fail.Fail].ok{GateChoice{outcome: comptime.GATE_FAILED, verdict: cycle.ok}};
    }

    val question: res[id.ExprId, fail.Fail] = comptime.type_question(m.a, source, cond);
    if (sel question.err) { ret res[GateChoice, fail.Fail].err{question.err}; }
    if (question.ok != id.EXPR_NIL) {
        val text: res[intern.StrId, fail.Fail] = type_question_message(p, mid, question.ok, p.demands.len::u32, p.demands.len::u32);
        if (sel text.err) { ret res[GateChoice, fail.Fail].err{text.err}; }
        ret refuse_gate(p, mid, cond, text.ok);
    }

    val index: res[u32, fail.Fail] = demand_push(p, mid, id.DECL_NIL, cond, intern.STR_NIL);
    if (sel index.err) { ret res[GateChoice, fail.Fail].err{index.err}; }
    val demanded: res[Verdict, fail.Fail] = demand_names(p, mid, cond, true);
    demand_pop(p);
    if (sel demanded.err) { ret res[GateChoice, fail.Fail].err{demanded.err}; }
    if (demanded.ok.kind == VERDICT_REFUSED) {
        if (demanded.ok.head >= index.ok) { ret refuse_gate(p, mid, cond, demanded.ok.message); }
        ret res[GateChoice, fail.Fail].ok{GateChoice{outcome: comptime.GATE_FAILED, verdict: demanded.ok}};
    }

    var lc: LoadMemberCtx;
    lc.p   = p;
    lc.mid = mid;
    val caps_r: res[comptime.PhaseCapabilities[LoadMemberCtx], fail.Fail] = comptime.loading_capabilities[LoadMemberCtx](resolve_module_member_const_load, load_cast);
    if (sel caps_r.err) { ret res[GateChoice, fail.Fail].err{caps_r.err}; }
    val vr: res[comptime.GateVerdict, fail.Fail] = comptime.evaluate_gate[LoadMemberCtx](
        ctx, ?lc, caps_r.ok, m.a, source, cond, ?p.s.interner, comptime.GATE_SCOPE_DECL, true);
    if (sel vr.err) { ret res[GateChoice, fail.Fail].err{vr.err}; }
    val v:       comptime.GateVerdict = vr.ok;
    val reports: bool                 = frame_reports(p, m);

    if (v.outcome == comptime.GATE_ACTIVE || v.outcome == comptime.GATE_INACTIVE) {
        ret res[GateChoice, fail.Fail].ok{gate_choice(v.outcome)};
    }
    if (v.outcome == comptime.GATE_REJECTED) {
        if (reports && str_len(v.message) > 0) {
            fail.reject(?m.load_status);
            val committed_r: res[bool, fail.Fail] = diagnostic.gate_error(?p.diags, ?p.s.interner, m.file_id, v.span, v.message);
            if (sel committed_r.err) { ret res[GateChoice, fail.Fail].err{committed_r.err}; }
        }
        or (reports) { fail.reject(?m.load_status); }
        ret res[GateChoice, fail.Fail].ok{gate_choice(comptime.GATE_REJECTED)};
    }
    # a gate the load cannot decide is refused here, so no later phase decides it again; an unbound
    # name is the one it waits on, any other failure says what it cannot evaluate
    if (v.outcome == comptime.GATE_FAILED) {
        comptime.set_gate_state(ctx, cond, comptime.GATE_STATE_REJECTED);
        if (reports) {
            fail.reject(?m.load_status);
            var committed_r: res[bool, fail.Fail];
            if (v.depends != intern.STR_NIL && v.fail == comptime.EVAL_FAIL_UNBOUND) {
                committed_r = diagnostic.gate_error_named(?p.diags, ?p.s.interner, m.file_id, v.span, v.depends, v.message);
            }
            or                       { committed_r = diagnostic.gate_error(?p.diags, ?p.s.interner, m.file_id, v.span, v.message); }
            if (sel committed_r.err) { ret res[GateChoice, fail.Fail].err{committed_r.err}; }
        }
        ret res[GateChoice, fail.Fail].ok{gate_choice(comptime.GATE_FAILED)};
    }
    # what the load cannot evaluate, a comptime cast among them, no later phase decides either:
    # the declarations this gate selects are fixed before any type exists
    val reason: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, v.message);
    if (sel reason.err) { ret res[GateChoice, fail.Fail].err{fail.refused(reason.err)}; }
    ret refuse_gate(p, mid, cond, reason.ok);
}

# the frame a union build's resolve reads is decided without a word, since each tuple's
# frame reports the same gate in its own terms
fun frame_reports(p: *project.Project, m: *project.ModuleEntry) bool {
    ret !(p.union && m.frame == project.FRAME_BUILD);
}

fun refuse_gate(p: *project.Project, mid: session.ModuleId, cond: id.ExprId, message: intern.StrId) res[GateChoice, fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    comptime.set_gate_state(frame_ctx(m), cond, comptime.GATE_STATE_REJECTED);
    if (!frame_reports(p, m)) { ret res[GateChoice, fail.Fail].ok{gate_choice(comptime.GATE_FAILED)}; }
    val e_opt: opt[*expr.Expr] = ast.get_expr(m.a, cond);
    if (sel e_opt.none) { ret res[GateChoice, fail.Fail].err{fail.message("gate condition is out of range")}; }
    val text: opt[str] = intern.lookup(?p.s.interner, message);
    if (sel text.none) { ret res[GateChoice, fail.Fail].err{fail.message("gate refusal is not interned")}; }
    fail.reject(?m.load_status);
    val committed_r: res[bool, fail.Fail] = diagnostic.gate_error(?p.diags, ?p.s.interner, m.file_id, e_opt.some.span, text.some);
    if (sel committed_r.err) { ret res[GateChoice, fail.Fail].err{committed_r.err}; }
    ret res[GateChoice, fail.Fail].ok{gate_choice(comptime.GATE_FAILED)};
}

# what a demand for a constant found
# ---
# VERDICT_BOUND:   the constant is bound in the frame
# VERDICT_ABSENT:  it is not, for a reason the gate reading it reports itself
# VERDICT_REFUSED: it is not because it asks a type question or depends on itself; the gate
#                  at or below `head` on the demand stack is refused with `message`
def VerdictKind: u8;

val VERDICT_BOUND:   VerdictKind = 0;
val VERDICT_ABSENT:  VerdictKind = 1;
val VERDICT_REFUSED: VerdictKind = 2;

rec Verdict {
    kind:    VerdictKind;
    head:    u32;
    message: intern.StrId;
}

fun verdict(kind: VerdictKind) Verdict {
    ret Verdict{kind: kind, head: 0, message: intern.STR_NIL};
}

fun demand_push(p: *project.Project, mid: session.ModuleId, did: id.DeclId, cond: id.ExprId, name: intern.StrId) res[u32, fail.Fail] {
    val index:  u32                 = p.demands.len::u32;
    val pushed: res[usize, A.Error] = vector.push[project.LoadDemand](?p.demands, project.LoadDemand{
        module: mid, frame: project.module_at(p, mid::u32).frame, decl: did, cond: cond, name: name
    });
    if (sel pushed.err) { ret res[u32, fail.Fail].err{fail.refused(pushed.err)}; }
    ret res[u32, fail.Fail].ok{index};
}

fun demand_pop(p: *project.Project) {
    if (p.demands.len > 0) { p.demands.len = p.demands.len - 1; }
}

fun demand_find(p: *project.Project, mid: session.ModuleId, frame: u32, did: id.DeclId, cond: id.ExprId) opt[u32] {
    var i: usize = 0;
    for (i < p.demands.len) {
        val d: *project.LoadDemand = ?p.demands.data[i];
        if (d.module == mid && d.frame == frame && d.decl == did && d.cond == cond) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the innermost gate at or below a stack position, which is the one a refusal there belongs to
fun demand_gate_at_or_below(p: *project.Project, index: u32) opt[u32] {
    var i: u32 = index + 1;
    if (i::usize > p.demands.len) { i = p.demands.len::u32; }
    for (i > 0) {
        i = i - 1;
        if (p.demands.data[i].cond != id.EXPR_NIL) { ret opt[u32].some{i}; }
    }
    ret opt[u32].none{};
}

# a demand reached an entry already open on the stack at `head`: the entries from there up lead
# back to it. only a gate can be refused for it, so without one below it the constants involved
# are left unbound as any other unreadable constant is. the gate that owns the refusal reports
# the cycle, and every other gate on it is refused without a word of its own
fun cycle_verdict(p: *project.Project, head: u32) res[Verdict, fail.Fail] {
    val owner: opt[u32] = demand_gate_at_or_below(p, head);
    if (sel owner.none) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    var gi: u32 = head + 1;
    for (gi::usize < p.demands.len) {
        val d: project.LoadDemand = p.demands.data[gi];
        if (d.cond != id.EXPR_NIL) {
            comptime.set_gate_state(frame_ctx_at(project.module_at(p, d.module::u32), d.frame), d.cond, comptime.GATE_STATE_REJECTED);
        }
        gi = gi + 1;
    }
    var chain: str = nil;
    var i:     u32 = head;
    for (i::usize <= p.demands.len) {
        var at: u32 = i;
        if (i::usize == p.demands.len) { at = head; }
        val step: res[str, fail.Fail] = demand_step_text(p, ?p.demands.data[at]);
        if (sel step.err) {
            if (chain != nil) { str_free(p.s.alloc, chain); }
            ret res[Verdict, fail.Fail].err{step.err};
        }
        var next_r: res[str, format.FormatError];
        if (chain == nil) { next_r = format.sprint(p.s.alloc, "{}", step.ok); }
        or                { next_r = format.sprint(p.s.alloc, "{} -> {}", chain, step.ok); }
        str_free(p.s.alloc, step.ok);
        if (chain != nil)   { str_free(p.s.alloc, chain); }
        if (sel next_r.err) { ret res[Verdict, fail.Fail].err{fail.format_refused(next_r.err)}; }
        chain = next_r.ok;
        i     = i + 1;
    }
    val msg_r: res[str, format.FormatError] = format.sprint(p.s.alloc,
        "the declaring gates and constants this gate reads depend on each other, so no order decides them: {}", chain);
    str_free(p.s.alloc, chain);
    if (sel msg_r.err) { ret res[Verdict, fail.Fail].err{fail.format_refused(msg_r.err)}; }
    val interned: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, msg_r.ok);
    str_free(p.s.alloc, msg_r.ok);
    if (sel interned.err) { ret res[Verdict, fail.Fail].err{fail.refused(interned.err)}; }
    ret res[Verdict, fail.Fail].ok{Verdict{kind: VERDICT_REFUSED, head: head, message: interned.ok}};
}

# source text as the interner holds it, so a message can format it
fun span_text(p: *project.Project, source: str, span: token.Span) res[str, fail.Fail] {
    val id_r: res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source, span);
    if (sel id_r.err) { ret res[str, fail.Fail].err{fail.refused(id_r.err)}; }
    val text: opt[str] = intern.lookup(?p.s.interner, id_r.ok);
    if (sel text.none) { ret res[str, fail.Fail].err{fail.message("interned source text is absent")}; }
    ret res[str, fail.Fail].ok{text.some};
}

# a stack entry as a cycle names it: a gate by its condition, a constant by its name
fun demand_step_text(p: *project.Project, d: *project.LoadDemand) res[str, fail.Fail] {
    if (d.cond == id.EXPR_NIL) {
        val name: opt[str] = intern.lookup(?p.s.interner, d.name);
        if (sel name.none) { ret res[str, fail.Fail].err{fail.message("demanded constant name is not interned")}; }
        val r: res[str, format.FormatError] = format.sprint(p.s.alloc, "`{}`", name.some);
        if (sel r.err) { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
        ret res[str, fail.Fail].ok{r.ok};
    }
    val source_r: res[str, fail.Fail] = module_source(p, d.module);
    if (sel source_r.err) { ret res[str, fail.Fail].err{source_r.err}; }
    val e_opt: opt[*expr.Expr] = ast.get_expr(project.module_at(p, d.module::u32).a, d.cond);
    if (sel e_opt.none) { ret res[str, fail.Fail].err{fail.message("demanded gate condition is out of range")}; }
    val text: res[str, fail.Fail] = span_text(p, source_r.ok, e_opt.some.span);
    if (sel text.err) { ret text; }
    val r: res[str, format.FormatError] = format.sprint(p.s.alloc, "`$if ({})`", text.ok);
    if (sel r.err) { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

# the constants on the demand stack from `from` up to `top` are the ones a type question is
# reached through
fun type_question_message(p: *project.Project, mid: session.ModuleId, call: id.ExprId, from: u32, top: u32) res[intern.StrId, fail.Fail] {
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[intern.StrId, fail.Fail].err{source_r.err}; }
    var via: str = nil;
    var i:   u32 = from;
    for (i < top) {
        val name: opt[str] = intern.lookup(?p.s.interner, p.demands.data[i].name);
        if (sel name.none) {
            if (via != nil) { str_free(p.s.alloc, via); }
            ret res[intern.StrId, fail.Fail].err{fail.message("demanded constant name is not interned")};
        }
        var next_r: res[str, format.FormatError];
        if (via == nil)     { next_r = format.sprint(p.s.alloc, " through `{}`", name.some); }
        or                  { next_r = format.sprint(p.s.alloc, "{} -> `{}`", via, name.some); }
        if (via != nil)     { str_free(p.s.alloc, via); }
        if (sel next_r.err) { ret res[intern.StrId, fail.Fail].err{fail.format_refused(next_r.err)}; }
        via = next_r.ok;
        i   = i + 1;
    }
    var through: str = "";
    if (via != nil) { through = via; }
    val r: res[intern.StrId, fail.Fail] = comptime.type_question_message(?p.s.interner, project.module_at(p, mid::u32).a, source_r.ok, call, through);
    if (via != nil) { str_free(p.s.alloc, via); }
    ret r;
}

# a constant an expression names: `name` alone, or `member` of the module `name` imports
rec NameRef {
    name:   intern.StrId;
    member: intern.StrId;
}

rec NameWalk {
    p:       *project.Project;
    source:  str;
    a:       *ast.Ast;
    out:     *vector.Vector[NameRef];
    failure: err[fail.Fail];
}

fun name_walk_node(w: *NameWalk, eid: id.ExprId, e: *expr.Expr) comptime.GateNodeVerdict {
    val failed: bool = sel w.failure.err;
    if (failed) { ret comptime.GATE_NODE_PRUNE; }
    var head:   token.Span = e.span;
    var member: token.Span = e.span;
    member.len = 0;
    if (e.kind == expr.EXPR_KIND_IDENT) { head = e.data.ident.tok; }
    or (e.kind == expr.EXPR_KIND_MEMBER) {
        val o_opt: opt[*expr.Expr] = ast.get_expr(w.a, e.data.member.object);
        if (sel o_opt.none)                          { ret comptime.GATE_NODE_NO; }
        if (o_opt.some.kind != expr.EXPR_KIND_IDENT) { ret comptime.GATE_NODE_NO; }
        head   = o_opt.some.data.ident.tok;
        member = e.data.member.name;
    }
    or { ret comptime.GATE_NODE_NO; }
    val name_r: res[intern.StrId, A.Error] = intern.intern_span(?w.p.s.interner, w.source, head);
    if (sel name_r.err) {
        w.failure = err[fail.Fail].err{fail.refused(name_r.err)};
        ret comptime.GATE_NODE_PRUNE;
    }
    var r: NameRef = NameRef{name: name_r.ok, member: intern.STR_NIL};
    if (member.len > 0) {
        val member_r: res[intern.StrId, A.Error] = intern.intern_span(?w.p.s.interner, w.source, member);
        if (sel member_r.err) {
            w.failure = err[fail.Fail].err{fail.refused(member_r.err)};
            ret comptime.GATE_NODE_PRUNE;
        }
        r.member = member_r.ok;
    }
    val pushed: res[usize, A.Error] = vector.push[NameRef](w.out, r);
    if (sel pushed.err) {
        w.failure = err[fail.Fail].err{fail.refused(pushed.err)};
        ret comptime.GATE_NODE_PRUNE;
    }
    if (e.kind == expr.EXPR_KIND_MEMBER) { ret comptime.GATE_NODE_PRUNE; }
    ret comptime.GATE_NODE_NO;
}

fun name_walk_expression(w: *NameWalk, a: *ast.Ast, eid: id.ExprId) res[expr.Expr, comptime.EvalFail] {
    val found: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (sel found.none) { ret res[expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "load: expression identity is out of range")}; }
    ret res[expr.Expr, comptime.EvalFail].ok{@found.some};
}

# demand every constant an expression names that its module's frame does not bind yet.
# `walk` says whether the module is still loading, so a demand may walk its declarations;
# a loaded module only explains why a constant it never bound is unreadable
fun demand_names(p: *project.Project, mid: session.ModuleId, eid: id.ExprId, walk: bool) res[Verdict, fail.Fail] {
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[Verdict, fail.Fail].err{source_r.err}; }
    var names: vector.Vector[NameRef] = vector.init[NameRef](p.alloc);
    fin { vector.dnit[NameRef](?names); }
    var w:      NameWalk             = NameWalk{p: p, source: source_r.ok, a: project.module_at(p, mid::u32).a, out: ?names, failure: err[fail.Fail].ok{}};
    val walked: res[bool, fail.Fail] = comptime.gate_walk[NameWalk](w.a, w.source, ?w, name_walk_node, name_walk_expression, eid);
    if (sel walked.err)    { ret res[Verdict, fail.Fail].err{walked.err}; }
    if (sel w.failure.err) { ret res[Verdict, fail.Fail].err{w.failure.err}; }
    var i: usize = 0;
    for (i < names.len) {
        val r: NameRef              = names.data[i];
        val m: *project.ModuleEntry = project.module_at(p, mid::u32);
        i = i + 1;
        var v:     Verdict                  = verdict(VERDICT_BOUND);
        val bound: opt[comptime.NamedConst] = comptime.lookup(frame_ctx(m), r.name);
        if (r.member == intern.STR_NIL) {
            if (sel bound.some) { cnt; }
            val dr: res[Verdict, fail.Fail] = demand_name(p, mid, r.name, walk);
            if (sel dr.err) { ret dr; }
            v = dr.ok;
        }
        or {
            if (sel bound.none) {
                val dr: res[Verdict, fail.Fail] = demand_name(p, mid, r.name, walk);
                if (sel dr.err) { ret dr; }
                v = dr.ok;
            }
            val dep_r: res[opt[session.ModuleId], fail.Fail] = frame_mod_ref(p, mid, r.name);
            if (sel dep_r.err) { ret res[Verdict, fail.Fail].err{dep_r.err}; }
            val dep: opt[session.ModuleId] = dep_r.ok;
            if (v.kind != VERDICT_REFUSED) {
                if (sel dep.some) {
                    val exported: opt[*project.PubConst] = pub_const_lookup(project.module_at(p, dep.some::u32), r.member);
                    if (sel exported.none) {
                        val pr: res[Verdict, fail.Fail] = demand_public(p, dep.some, r.member);
                        if (sel pr.err) { ret pr; }
                        v = pr.ok;
                    }
                }
            }
        }
        if (v.kind == VERDICT_REFUSED) { ret res[Verdict, fail.Fail].ok{v}; }
    }
    ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)};
}

# find what binds `name` at module scope in the module's current frame and bring it in: a `val`
# is walked, a `use` loads its module and binds the import, and a chain with an arm that binds it
# is decided first so the demand goes on in the arm it selects
fun demand_name(p: *project.Project, mid: session.ModuleId, name: intern.StrId, walk: bool) res[Verdict, fail.Fail] {
    val m:     *project.ModuleEntry = project.module_at(p, mid::u32);
    val m_opt: opt[*module.Module]  = ast.get_module(m.a, m.a.root_module);
    if (sel m_opt.none) { ret res[Verdict, fail.Fail].err{fail.message("module root not set on Ast")}; }
    val saved_gated: bool = p.in_gated_decl_walk;
    p.in_gated_decl_walk = false;
    val r: res[Verdict, fail.Fail] = demand_in_list(p, mid, m_opt.some.decls_start, m_opt.some.decls_len, name, walk);
    p.in_gated_decl_walk = saved_gated;
    ret r;
}

# why a loaded module never bound a public constant an importer's gate reads
fun demand_public(p: *project.Project, dep: session.ModuleId, name: intern.StrId) res[Verdict, fail.Fail] {
    val m:           *project.ModuleEntry = project.module_at(p, dep::u32);
    val saved_frame: u32                  = m.frame;
    m.frame = project.FRAME_BUILD;
    val r: res[Verdict, fail.Fail] = demand_name(p, dep, name, false);
    m.frame = saved_frame;
    ret r;
}

fun demand_in_list(p: *project.Project, mid: session.ModuleId, start: u32, len: u32, name: intern.StrId, walk: bool) res[Verdict, fail.Fail] {
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[Verdict, fail.Fail].err{source_r.err}; }
    val source: str      = source_r.ok;
    val text:   opt[str] = intern.lookup(?p.s.interner, name);
    if (sel text.none) { ret res[Verdict, fail.Fail].err{fail.message("demanded constant name is not interned")}; }
    var i: u32 = 0;
    for (i < len) {
        val a:     *ast.Ast        = project.module_at(p, mid::u32).a;
        val did:   id.DeclId       = a.decl_ids[start + i];
        val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
        if (sel d_opt.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
        var copied: decl.Decl = @d_opt.some;
        i = i + 1;
        if (copied.kind == decl.DECL_KIND_VAL && spells(source, copied.data.bind.name, text.some)) {
            ret demand_val(p, mid, did, walk);
        }
        if (copied.kind == decl.DECL_KIND_USE && use_binds(source, ?copied.data.use_, text.some)) {
            if (!walk) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
            ret demand_use(p, mid, did, name);
        }
        if (copied.kind == decl.DECL_KIND_COMPTIME_IF
            && !comptime.comptime_if_declares_nothing(a, copied.data.comptime_if.branches_start, copied.data.comptime_if.branches_len)
            && chain_binds(a, source, ?copied.data.comptime_if, text.some)) {
            val arm_r: res[ChainChoice, fail.Fail] = demand_arm(p, mid, ?copied.data.comptime_if, source, walk);
            if (sel arm_r.err) { ret res[Verdict, fail.Fail].err{arm_r.err}; }
            val arm: ChainChoice = arm_r.ok;
            if (arm.verdict.kind == VERDICT_REFUSED) { ret res[Verdict, fail.Fail].ok{arm.verdict}; }
            if (arm.branch < copied.data.comptime_if.branches_len) {
                val br:          decl.ComptimeBranch = a.comptime_branches[copied.data.comptime_if.branches_start + arm.branch];
                val saved_gated: bool                = p.in_gated_decl_walk;
                p.in_gated_decl_walk = true;
                val found: res[Verdict, fail.Fail] = demand_in_list(p, mid, br.body_start, br.body_len, name, walk);
                p.in_gated_decl_walk = saved_gated;
                if (sel found.err)                   { ret found; }
                if (found.ok.kind != VERDICT_ABSENT) { ret found; }
            }
        }
    }
    ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)};
}

# the arm a chain selects for a demand: decided now in a module still loading, or read from the
# states its walk left in a loaded one
fun demand_arm(p: *project.Project, mid: session.ModuleId, ci: *decl.DeclComptimeIf, source: str, walk: bool) res[ChainChoice, fail.Fail] {
    if (walk) { ret decide_chain(p, mid, ci, source); }
    val m:  *project.ModuleEntry = project.module_at(p, mid::u32);
    val n:  u32                  = ci.branches_len;
    var bi: u32                  = 0;
    for (bi < n) {
        val cond: id.ExprId = m.a.comptime_branches[ci.branches_start + bi].cond;
        if (cond == id.EXPR_NIL) { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime.GATE_ACTIVE, bi, verdict(VERDICT_ABSENT))}; }
        val state: comptime.GateState = comptime.gate_state(frame_ctx(m), cond);
        if (state == comptime.GATE_STATE_TRUE)  { ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime.GATE_ACTIVE, bi, verdict(VERDICT_ABSENT))}; }
        if (state != comptime.GATE_STATE_FALSE) { brk; }
        bi = bi + 1;
    }
    ret res[ChainChoice, fail.Fail].ok{chain_choice(comptime.GATE_INACTIVE, n, verdict(VERDICT_ABSENT))};
}

fun use_binds(source: str, du: *decl.DeclUse, text: str) bool {
    if (du.path.len == 0) { ret false; }
    var bound: token.Span = du.alias;
    if (bound.len == 0) { bound = np.leaf(source, du.path); }
    ret spells(source, bound, text);
}

# whether any arm of a chain, at any depth, declares `text` as a constant or imports it
fun chain_binds(a: *ast.Ast, source: str, ci: *decl.DeclComptimeIf, text: str) bool {
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?a.comptime_branches[ci.branches_start + bi];
        if (list_binds(a, source, br.body_start, br.body_len, text)) { ret true; }
        bi = bi + 1;
    }
    ret false;
}

fun list_binds(a: *ast.Ast, source: str, start: u32, len: u32, text: str) bool {
    var i: u32 = 0;
    for (i < len) {
        val d_opt: opt[*decl.Decl] = ast.get_decl(a, a.decl_ids[start + i]);
        if (sel d_opt.some) {
            val d: *decl.Decl = d_opt.some;
            if (d.kind == decl.DECL_KIND_VAL && spells(source, d.data.bind.name, text))                    { ret true; }
            if (d.kind == decl.DECL_KIND_USE && use_binds(source, ?d.data.use_, text))                     { ret true; }
            if (d.kind == decl.DECL_KIND_COMPTIME_IF && chain_binds(a, source, ?d.data.comptime_if, text)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun demand_val(p: *project.Project, mid: session.ModuleId, did: id.DeclId, walk: bool) res[Verdict, fail.Fail] {
    val m:     *project.ModuleEntry = project.module_at(p, mid::u32);
    val d_opt: opt[*decl.Decl]      = ast.get_decl(m.a, did);
    if (sel d_opt.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
    val name_span: token.Span          = d_opt.some.data.bind.name;
    val source_r:  res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[Verdict, fail.Fail].err{source_r.err}; }
    val name_r: res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source_r.ok, name_span);
    if (sel name_r.err) { ret res[Verdict, fail.Fail].err{fail.refused(name_r.err)}; }
    val bound: opt[comptime.NamedConst] = comptime.lookup(frame_ctx(m), name_r.ok);
    if (sel bound.some) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)}; }
    val open: opt[u32] = demand_find(p, mid, m.frame, did, id.EXPR_NIL);
    if (sel open.some)                           { ret cycle_verdict(p, open.some); }
    if (comptime.load_walked(frame_ctx(m), did)) { ret val_reason(p, mid, did); }
    if (!walk)                                   { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    ret walk_val(p, mid, did);
}

fun demand_use(p: *project.Project, mid: session.ModuleId, did: id.DeclId, name: intern.StrId) res[Verdict, fail.Fail] {
    val m:      *project.ModuleEntry                 = project.module_at(p, mid::u32);
    val walked: res[comptime.GateOutcome, fail.Fail] = walk_one_decl_for_load(p, mid, did);
    if (sel walked.err) { ret res[Verdict, fail.Fail].err{walked.err}; }
    val bound: opt[comptime.NamedConst] = comptime.lookup(frame_ctx(m), name);
    if (sel bound.some) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)}; }
    # a module name is no constant; an import that bound none lets its module say why
    var k: u32 = 0;
    for (k < m.mod_ref_count) {
        if (m.mod_refs[k].decl == did) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
        k = k + 1;
    }
    val d_opt: opt[*decl.Decl] = ast.get_decl(m.a, did);
    if (sel d_opt.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
    val path:     token.Span          = d_opt.some.data.use_.path;
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[Verdict, fail.Fail].err{source_r.err}; }
    val tgt_r: res[UseTarget, outcome.Fail] = resolve_use_target(p, source_r.ok, path);
    if (sel tgt_r.err)         { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    if (tgt_r.ok.binds_module) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    val entry_r: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?tgt_r.ok.module_fqn);
    if (sel entry_r.none) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    ret demand_public(p, @entry_r.some, tgt_r.ok.leaf);
}

# why a constant the walk reached is unbound: a constant it reads is refused, or its own value
# asks a type question
fun val_reason(p: *project.Project, mid: session.ModuleId, did: id.DeclId) res[Verdict, fail.Fail] {
    val m:     *project.ModuleEntry = project.module_at(p, mid::u32);
    val d_opt: opt[*decl.Decl]      = ast.get_decl(m.a, did);
    if (sel d_opt.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during a demand")}; }
    var copied: decl.Decl = @d_opt.some;
    if (copied.data.bind.name.len == 0 || copied.data.bind.init == id.EXPR_NIL) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[Verdict, fail.Fail].err{source_r.err}; }
    val name_r: res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source_r.ok, copied.data.bind.name);
    if (sel name_r.err) { ret res[Verdict, fail.Fail].err{fail.refused(name_r.err)}; }
    val index: res[u32, fail.Fail] = demand_push(p, mid, did, id.EXPR_NIL, name_r.ok);
    if (sel index.err) { ret res[Verdict, fail.Fail].err{index.err}; }
    val r: res[Verdict, fail.Fail] = unbound_reason(p, mid, ?copied, name_r.ok, false);
    demand_pop(p);
    ret r;
}

# the reason a constant on top of the demand stack is unbound, which only a gate below it reports:
# a constant it reads is refused, its value asks a type question, or its type is no integer
fun unbound_reason(p: *project.Project, mid: session.ModuleId, d: *decl.Decl, name: intern.StrId, demanded: bool) res[Verdict, fail.Fail] {
    val init:  id.ExprId = d.data.bind.init;
    val owner: opt[u32]  = demand_gate_at_or_below(p, p.demands.len::u32 - 1);
    if (sel owner.none) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
    if (!demanded) {
        val deps: res[Verdict, fail.Fail] = demand_names(p, mid, init, false);
        if (sel deps.err)                    { ret deps; }
        if (deps.ok.kind == VERDICT_REFUSED) { ret deps; }
    }
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[Verdict, fail.Fail].err{source_r.err}; }
    val question: res[id.ExprId, fail.Fail] = comptime.type_question(project.module_at(p, mid::u32).a, source_r.ok, init);
    if (sel question.err) { ret res[Verdict, fail.Fail].err{question.err}; }
    if (question.ok == id.EXPR_NIL) {
        if (d.data.bind.ty == id.TYPE_NIL) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
        var w: DeclaredWalk;
        w.p     = p;
        w.steps = vector.init[intern.StrId](p.alloc);
        fin { vector.dnit[intern.StrId](?w.steps); }
        val declared: res[DeclaredInt, fail.Fail] = declared_type(?w, mid, d.data.bind.ty, 0);
        if (sel declared.err)                      { ret res[Verdict, fail.Fail].err{declared.err}; }
        if (declared.ok.class != DECLARED_NON_INT) { ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)}; }
        val refusal: res[intern.StrId, fail.Fail] = non_integer_message(p, name, ?w.steps);
        if (sel refusal.err) { ret res[Verdict, fail.Fail].err{refusal.err}; }
        ret res[Verdict, fail.Fail].ok{Verdict{kind: VERDICT_REFUSED, head: p.demands.len::u32 - 1, message: refusal.ok}};
    }
    val top:  u32                          = p.demands.len::u32;
    val text: res[intern.StrId, fail.Fail] = type_question_message(p, mid, question.ok, owner.some + 1, top);
    if (sel text.err) { ret res[Verdict, fail.Fail].err{text.err}; }
    ret res[Verdict, fail.Fail].ok{Verdict{kind: VERDICT_REFUSED, head: top - 1, message: text.ok}};
}

# walk a module-scope constant in the module's current frame: every constant its value names is
# demanded first, then it is evaluated and bound, and a public one in the build target's frame is
# exported to the gates of its importers
fun walk_val(p: *project.Project, mid: session.ModuleId, did: id.DeclId) res[Verdict, fail.Fail] {
    val m:     *project.ModuleEntry = project.module_at(p, mid::u32);
    val d_opt: opt[*decl.Decl]      = ast.get_decl(m.a, did);
    if (sel d_opt.none) { ret res[Verdict, fail.Fail].err{fail.message("DeclId out of range during walk")}; }
    var copied: decl.Decl = @d_opt.some;
    if (copied.data.bind.name.len == 0 || copied.data.bind.init == id.EXPR_NIL) {
        comptime.mark_load_walked(frame_ctx(m), did);
        ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)};
    }
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[Verdict, fail.Fail].err{source_r.err}; }
    val name_r: res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source_r.ok, copied.data.bind.name);
    if (sel name_r.err) { ret res[Verdict, fail.Fail].err{fail.refused(name_r.err)}; }
    val index: res[u32, fail.Fail] = demand_push(p, mid, did, id.EXPR_NIL, name_r.ok);
    if (sel index.err) { ret res[Verdict, fail.Fail].err{index.err}; }
    val r: res[Verdict, fail.Fail] = bind_val(p, mid, ?copied, source_r.ok, name_r.ok);
    demand_pop(p);
    comptime.mark_load_walked(frame_ctx(project.module_at(p, mid::u32)), did);
    ret r;
}

fun bind_val(p: *project.Project, mid: session.ModuleId, d: *decl.Decl, source: str, name: intern.StrId) res[Verdict, fail.Fail] {
    val deps: res[Verdict, fail.Fail] = demand_names(p, mid, d.data.bind.init, true);
    if (sel deps.err)                    { ret deps; }
    if (deps.ok.kind == VERDICT_REFUSED) { ret deps; }
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    # a constant tag is bound as its own literal, which a gate's `sel` reads; it points into this
    # module's syntax, so no importer reads it
    val tag_r: res[bool, fail.Fail] = constant_tag(p, mid, d.data.bind.init, source);
    if (sel tag_r.err) { ret res[Verdict, fail.Fail].err{tag_r.err}; }
    if (tag_r.ok) {
        val tagged: err[fail.Fail] = comptime.bind_gated(frame_ctx(m), name, comptime.const_elem_untyped(d.data.bind.init::u32), p.in_gated_decl_walk);
        if (sel tagged.err) { ret res[Verdict, fail.Fail].err{tagged.err}; }
        ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)};
    }
    val fw:    float.FloatWidth                         = comptime.declared_float_width(m.a, source, d.data.bind.ty);
    val r_val: res[comptime.CTValue, comptime.EvalFail] = eval_for_load(p, mid, source, d.data.bind.init, fw);
    if (sel r_val.err) { ret unbound_reason(p, mid, d, name, true); }
    val typed_r: res[comptime.CTValue, fail.Fail] = declared_value(p, mid, name, d.data.bind.ty, r_val.ok);
    if (sel typed_r.err) { ret res[Verdict, fail.Fail].err{typed_r.err}; }
    val v: comptime.CTValue = typed_r.ok;

    if (comptime.float_width_unread(v)) {
        val deferred: err[fail.Fail] = comptime.defer_float_width(frame_ctx(m), name);
        if (sel deferred.err) { ret res[Verdict, fail.Fail].err{deferred.err}; }
        ret res[Verdict, fail.Fail].ok{verdict(VERDICT_ABSENT)};
    }

    val rr: err[fail.Fail] = comptime.bind_gated(frame_ctx(m), name, v, p.in_gated_decl_walk);
    if (sel rr.err) { ret res[Verdict, fail.Fail].err{rr.err}; }

    if ((d.flags & decl.DECL_FLAG_PUB) != 0 && m.frame == project.FRAME_BUILD) {
        val added: err[fail.Fail] = add_pub_const(p, m, name, v);
        if (sel added.err) { ret res[Verdict, fail.Fail].err{added.err}; }
    }
    ret res[Verdict, fail.Fail].ok{verdict(VERDICT_BOUND)};
}

# whether a constant's value is a case literal of a type declared in its own module, `T.c{...}`:
# the head is split into type and case as name resolution splits it, so a gate reads the case now
fun constant_tag(p: *project.Project, mid: session.ModuleId, init: id.ExprId, source: str) res[bool, fail.Fail] {
    val a:     *ast.Ast        = project.module_at(p, mid::u32).a;
    val e_opt: opt[*expr.Expr] = ast.get_expr(a, init);
    if (sel e_opt.none) { ret res[bool, fail.Fail].ok{false}; }
    val e:   *expr.Expr = e_opt.some;
    var tid: id.TypeId  = id.TYPE_NIL;
    if (e.kind == expr.EXPR_KIND_STRUCT_LIT) { tid = e.data.struct_lit.ty; }
    if (e.kind == expr.EXPR_KIND_VECTOR_LIT) { tid = e.data.vector_lit.ty; }
    if (tid == id.TYPE_NIL)                  { ret res[bool, fail.Fail].ok{false}; }
    val t_opt: opt[*atype.Type] = ast.get_type(a, tid);
    if (sel t_opt.none) { ret res[bool, fail.Fail].ok{false}; }
    val t: *atype.Type = t_opt.some;
    if (t.kind != atype.TYPE_KIND_NAMED)                                          { ret res[bool, fail.Fail].ok{false}; }
    if (t.data.named.case_desc != id.EXPR_NIL || t.data.named.case_name.len != 0) { ret res[bool, fail.Fail].ok{comptime.is_case_literal(a, init)}; }
    val path: token.Span = t.data.named.name;
    val pre:  token.Span = np.prefix(source, path);
    if (pre.len == 0 || pre.len >= path.len || np.prefix(source, pre).len != 0) { ret res[bool, fail.Fail].ok{false}; }
    val leaf: token.Span = np.leaf(source, path);
    if (leaf.len == 0) { ret res[bool, fail.Fail].ok{false}; }
    val pre_r: res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source, pre);
    if (sel pre_r.err) { ret res[bool, fail.Fail].err{fail.refused(pre_r.err)}; }
    val b_r: res[Binding, fail.Fail] = module_binding(p, mid, pre_r.ok, true);
    if (sel b_r.err)                                                  { ret res[bool, fail.Fail].err{b_r.err}; }
    if (b_r.ok.kind != BINDING_NOMINAL && b_r.ok.kind != BINDING_DEF) { ret res[bool, fail.Fail].ok{false}; }
    t.data.named.name      = pre;
    t.data.named.case_name = leaf;
    ret res[bool, fail.Fail].ok{true};
}

# a cast the load can evaluate: to the integer primitive its destination names, directly or through
# a def chain; any other waits for a type the load does not have
fun load_cast(lc: *LoadMemberCtx, eid: id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val m:     *project.ModuleEntry = project.module_at(lc.p, lc.mid::u32);
    val e_opt: opt[*expr.Expr]      = ast.get_expr(m.a, eid);
    if (sel e_opt.none) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "load cast names no expression")}; }
    val node: *expr.Expr = e_opt.some;
    if (node.kind != expr.EXPR_KIND_CAST) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "load cast capability requires a cast expression")}; }
    val untyped: comptime.EvalFail = comptime.eval_error(comptime.EVAL_FAIL_NEEDS_TYPES, "a comptime cast requires its resolved source and destination types");
    if (node.data.cast.reinterpret) { ret res[comptime.CTValue, comptime.EvalFail].err{untyped}; }
    var w: DeclaredWalk;
    w.p     = lc.p;
    w.steps = vector.init[intern.StrId](lc.p.alloc);
    fin { vector.dnit[intern.StrId](?w.steps); }
    val declared: res[DeclaredInt, fail.Fail] = declared_type(?w, lc.mid, node.data.cast.ty, 0);
    if (sel declared.err)                  { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.describe(declared.err))}; }
    if (declared.ok.class != DECLARED_INT) { ret res[comptime.CTValue, comptime.EvalFail].err{untyped}; }
    ret comptime.cast_to_int(value, declared.ok.width::u32, !declared.ok.unsigned);
}

# the context the load walk reads and binds in for a module: its build target's, or the union
# tuple frame the walk is deciding a chain in
fun frame_ctx(m: *project.ModuleEntry) *comptime.ComptimeCtx {
    ret frame_ctx_at(m, m.frame);
}

fun frame_ctx_at(m: *project.ModuleEntry, frame: u32) *comptime.ComptimeCtx {
    if (frame == project.FRAME_BUILD) { ret ?m.ctx; }
    ret ?m.tuple_frames[frame];
}

# a module's union tuple frames, made on first use: its context under each tuple's target, with
# nothing bound and nothing decided
fun ensure_tuple_frames(p: *project.Project, m: *project.ModuleEntry) err[fail.Fail] {
    if (m.tuple_frames != nil || p.union_tuple_count == 0) { ret err[fail.Fail].ok{}; }
    val ar: res[*comptime.ComptimeCtx, A.Error] = A.allocate[comptime.ComptimeCtx](p.alloc, p.union_tuple_count::usize);
    if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
    val frames: *comptime.ComptimeCtx = ar.ok;
    var made:   u32                   = 0;
    for (made < p.union_tuple_count) {
        val ctx_r: res[comptime.ComptimeCtx, fail.Fail] = module_context(p, ?p.req, m.artifact);
        if (sel ctx_r.err) {
            var ri: u32 = 0;
            for (ri < made) {
                comptime.dnit(?frames[ri]);
                ri = ri + 1;
            }
            A.deallocate[comptime.ComptimeCtx](p.alloc, frames, p.union_tuple_count::usize);
            ret err[fail.Fail].err{ctx_r.err};
        }
        frames[made] = ctx_r.ok;
        apply_tuple_target(?frames[made], ?p.union_tuples[made]);
        made = made + 1;
    }
    m.tuple_frames      = frames;
    m.tuple_frame_count = p.union_tuple_count;
    var ti: u32 = 0;
    for (ti < m.tuple_frame_count) {
        val prepared: err[fail.Fail] = comptime.prepare_gates(?m.tuple_frames[ti], m.a.expr_len::u32, m.a.decl_len::u32);
        if (sel prepared.err) { ret prepared; }
        ti = ti + 1;
    }
    ret err[fail.Fail].ok{};
}

fun apply_tuple_target(c: *comptime.ComptimeCtx, t: *project.TargetTuple) {
    c.env.target_os_id    = t.os_id;
    c.env.target_arch_id  = t.arch_id;
    c.env.target_abi_id   = t.abi_id;
    c.env.pointer_width   = t.pointer_width;
    c.env.vector_bits     = t.vector_bits;
    c.env.has_float       = t.has_float;
    c.env.target_defs     = t.target_defs;
    c.env.va_list_size    = t.va_list_size;
    c.env.va_list_align   = t.va_list_align;
    c.env.target_os       = t.os_name;
    c.env.target_isa      = t.isa_name;
    c.env.target_abi      = t.abi_name;
    c.env.target_platform = t.platform_name;
    c.env.ct_mul          = t.ct_mul;
    c.env.extensions      = t.extensions;
}

# a `use` whose path names no module is reported here, with the dependency
# remedy the loader alone knows, and binds nothing: the module's load is
# rejected, the walk goes on so the rest of the module still resolves, and
# the mark tells resolve to say nothing more about it
fun walk_use_for_load(p: *project.Project, mid: session.ModuleId, did: id.DeclId, du: *decl.DeclUse) err[fail.Fail] {
    if (du.path.len == 0) { ret err[fail.Fail].ok{}; }
    val m:       *project.ModuleEntry = project.module_at(p, mid::u32);
    val src_opt: opt[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (sel src_opt.none) { ret err[fail.Fail].err{fail.message("module file_id not found in SourceMap")}; }
    val source: str = src_opt.some.text;

    val tgt_r: res[UseTarget, outcome.Fail] = resolve_use_target(p, source, du.path);
    if (sel tgt_r.err) {
        val error: outcome.Fail = tgt_r.err;
        if (sel error.user) {
            val reported: res[bool, fail.Fail] = diagnostic.gate_error(?p.diags, ?p.s.interner, m.file_id, du.path, outcome.describe(error));
            if (sel reported.err) {
                val message: str = fail.describe(reported.err);
                fail.internal(?m.load_status, message);
                ret err[fail.Fail].err{fail.message(message)};
            }
            fail.reject(?m.load_status);
            comptime.mark_use_unbound(frame_ctx(m), did);
            ret err[fail.Fail].ok{};
        }
        fail.internal(?m.load_status, outcome.describe(error));
        ret err[fail.Fail].err{fail.message(outcome.describe(error))};
    }
    val ut:    UseTarget    = tgt_r.ok;
    var bound: intern.StrId = intern.STR_NIL;
    if (ut.binds_module) {
        val name: res[intern.StrId, fail.Fail] = use_bound_name(p, source, du, ut);
        if (sel name.err) { ret err[fail.Fail].err{name.err}; }
        bound = name.ok;
    }
    val alias: bool       = du.alias.len > 0;
    val span:  token.Span = du.path;

    val dep_r: res[session.ModuleId, fail.Fail] = dfs_load(p, ut.module_fqn);
    if (sel dep_r.err) { ret err[fail.Fail].err{dep_r.err}; }
    val dep_mid: session.ModuleId = dep_r.ok;

    val record_r: err[fail.Fail] = record_dep(p, mid, dep_mid);
    if (sel record_r.err) { ret record_r; }

    if (ut.binds_module) { ret record_mod_ref(p, mid, bound, dep_mid, did); }
    if (alias)           { ret err[fail.Fail].ok{}; }
    val rec_r: err[fail.Fail] = record_const_import(p, mid, ut.leaf, dep_mid, span, did);
    if (sel rec_r.err) { ret rec_r; }
    ret merge_pub_consts(p, mid, dep_mid, ut.leaf, span);
}

fun record_const_import(p: *project.Project, mid: session.ModuleId, name: intern.StrId, dep_mid: session.ModuleId, span: token.Span, did: id.DeclId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: u32                  = 0;
    for (i < m.const_import_count) {
        if (m.const_imports[i].name == name && m.const_imports[i].module == dep_mid) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    if (m.const_imports == nil) {
        val r: res[*project.ModRef, A.Error] = A.allocate[project.ModRef](p.alloc, INITIAL_DEP_CAP::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        m.const_imports    = r.ok;
        m.const_import_cap = INITIAL_DEP_CAP;
    }
    or (m.const_import_count == m.const_import_cap) {
        val new_cap: u32                           = m.const_import_cap * 2;
        val r:       res[*project.ModRef, A.Error] = A.reallocate[project.ModRef](p.alloc, m.const_imports, m.const_import_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        m.const_imports    = r.ok;
        m.const_import_cap = new_cap;
    }
    var ci: project.ModRef;
    ci.name                               = name;
    ci.module                             = dep_mid;
    ci.span                               = span;
    ci.decl                               = did;
    m.const_imports[m.const_import_count] = ci;
    m.const_import_count                  = m.const_import_count + 1;
    ret err[fail.Fail].ok{};
}

fun use_bound_name(p: *project.Project, source: str, du: *decl.DeclUse, ut: UseTarget) res[intern.StrId, fail.Fail] {
    if (du.alias.len == 0) { ret res[intern.StrId, fail.Fail].ok{ut.leaf}; }
    val intern_span_r: res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source, du.alias);
    if (sel intern_span_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(intern_span_r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{intern_span_r.ok};
}

# each `use` binding a module name is recorded once; arms a union walk takes under different
# tuples may bind one name to different modules
fun record_mod_ref(p: *project.Project, mid: session.ModuleId, name: intern.StrId, dep_mid: session.ModuleId, did: id.DeclId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var k: u32                  = 0;
    for (k < m.mod_ref_count) {
        if (m.mod_refs[k].decl == did) { ret err[fail.Fail].ok{}; }
        k = k + 1;
    }
    if (m.mod_refs == nil) {
        val r: res[*project.ModRef, A.Error] = A.allocate[project.ModRef](p.alloc, INITIAL_DEP_CAP::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        m.mod_refs    = r.ok;
        m.mod_ref_cap = INITIAL_DEP_CAP;
    }
    or (m.mod_ref_count == m.mod_ref_cap) {
        val new_cap: u32                           = m.mod_ref_cap * 2;
        val r:       res[*project.ModRef, A.Error] = A.reallocate[project.ModRef](p.alloc, m.mod_refs, m.mod_ref_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        m.mod_refs    = r.ok;
        m.mod_ref_cap = new_cap;
    }
    var zero_span: token.Span;
    zero_span.offset = 0;
    zero_span.len    = 0;
    var mr: project.ModRef;
    mr.name                     = name;
    mr.module                   = dep_mid;
    mr.span                     = zero_span;
    mr.decl                     = did;
    m.mod_refs[m.mod_ref_count] = mr;
    m.mod_ref_count             = m.mod_ref_count + 1;
    ret err[fail.Fail].ok{};
}

fun walk_fwd_for_load(p: *project.Project, mid: session.ModuleId, df: *decl.DeclFwd) err[fail.Fail] {
    if (df.path.len == 0) { ret err[fail.Fail].ok{}; }
    val m:       *project.ModuleEntry = project.module_at(p, mid::u32);
    val src_opt: opt[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (sel src_opt.none) { ret err[fail.Fail].err{fail.message("module file_id not found in SourceMap")}; }
    val source: str = src_opt.some.text;

    val tgt_r: res[UseTarget, outcome.Fail] = resolve_use_target(p, source, df.path);
    if (sel tgt_r.err) {
        val error: outcome.Fail = tgt_r.err;
        if (sel error.user) { ret err[fail.Fail].ok{}; }
        fail.internal(?m.load_status, outcome.describe(error));
        ret err[fail.Fail].err{fail.message(outcome.describe(error))};
    }
    val ut: UseTarget = tgt_r.ok;

    val dep_r: res[session.ModuleId, fail.Fail] = dfs_load(p, ut.module_fqn);
    if (sel dep_r.err) { ret err[fail.Fail].err{dep_r.err}; }
    val dep_mid: session.ModuleId = dep_r.ok;

    val record_r: err[fail.Fail] = record_dep(p, mid, dep_mid);
    if (sel record_r.err) { ret record_r; }

    ret err[fail.Fail].ok{};
}

pub rec UseTarget {
    module_fqn:   intern.StrId;
    leaf:         intern.StrId;
    binds_module: bool;
}

fun project_module_lookup(p: *project.Project, id: intern.StrId, out_found: *bool, out_module: *intern.StrId) {
    @out_found  = false;
    @out_module = intern.STR_NIL;
    if (id == p.config.id) {
        @out_found  = true;
        @out_module = p.config.module;
        ret;
    }
    var k: u32 = 0;
    for (k < p.config.dep_count) {
        if (p.config.deps[k].project_id == id) {
            @out_found  = true;
            @out_module = p.config.deps[k].project_module;
            ret;
        }
        k = k + 1;
    }
}

# whether the dependency with this id declares no `[artifact.*]` at all
fun dep_declares_no_artifact(p: *project.Project, id: intern.StrId) bool {
    var k: u32 = 0;
    for (k < p.config.dep_count) {
        if (p.config.deps[k].project_id == id) { ret p.config.deps[k].manifest.artifact_count == 0; }
        k = k + 1;
    }
    ret false;
}

fun resolve_use_target(p: *project.Project, source: str, path: token.Span) res[UseTarget, outcome.Fail] {
    val full_r: res[intern.StrId, A.Error] = np.intern_path(?p.s.interner, source, path);
    if (sel full_r.err) { ret res[UseTarget, outcome.Fail].err{outcome.refused(full_r.err)}; }
    val full_id: intern.StrId = full_r.ok;

    val leaf_r: res[intern.StrId, fail.Fail] = leaf_name(?p.s.interner, source, path);
    if (sel leaf_r.err) { ret res[UseTarget, outcome.Fail].err{outcome.from_fail(leaf_r.err)}; }
    val leaf: intern.StrId = leaf_r.ok;

    if (np.prefix(source, path).len == 0) {
        var found:  bool         = false;
        var mod_id: intern.StrId = intern.STR_NIL;
        project_module_lookup(p, full_id, ?found, ?mod_id);
        if (found) {
            if (mod_id == intern.STR_NIL) {
                if (dep_declares_no_artifact(p, full_id)) {
                    ret res[UseTarget, outcome.Fail].err{outcome.user(diag_join_named(p.s, "project '", full_id, "' declares no artifact, so it has no public module: import a full path, or declare a static or shared [artifact.*] table marked default = true in its manifest", "project declares no artifact, so it has no public module: import a full path, or declare a static or shared [artifact.*] table marked default = true in its manifest"))};
                }
                ret res[UseTarget, outcome.Fail].err{outcome.user(diag_join_named(p.s, "project '", full_id, "' has no public module: a bare import binds the entry shared by its library artifacts marked `default = true`; import a full path, or mark one static or shared [artifact.*] table (or several sharing one entry) default = true in its manifest", "project has no public module: a bare import binds the entry shared by its library artifacts marked `default = true`; import a full path, or mark one static or shared [artifact.*] table (or several sharing one entry) default = true in its manifest"))};
            }
            val id_opt:  opt[str] = intern.lookup(?p.s.interner, full_id);
            val mod_opt: opt[str] = intern.lookup(?p.s.interner, mod_id);
            if (sel id_opt.none)  { ret res[UseTarget, outcome.Fail].err{outcome.internal("internal: project id/module not interned")}; }
            if (sel mod_opt.none) { ret res[UseTarget, outcome.Fail].err{outcome.internal("internal: project id/module not interned")}; }
            val fqn_r: res[intern.StrId, fail.Fail] = compose_module_fqn(p.alloc, ?p.s.interner, id_opt.some, mod_opt.some);
            if (sel fqn_r.err) { ret res[UseTarget, outcome.Fail].err{outcome.from_fail(fqn_r.err)}; }
            var ut: UseTarget;
            ut.module_fqn   = fqn_r.ok;
            ut.leaf         = leaf;
            ut.binds_module = true;
            ret res[UseTarget, outcome.Fail].ok{ut};
        }
    }

    if (fqn_names_file(p, full_id)) {
        var ut: UseTarget;
        ut.module_fqn   = full_id;
        ut.leaf         = leaf;
        ut.binds_module = true;
        ret res[UseTarget, outcome.Fail].ok{ut};
    }

    var prefix: token.Span = np.prefix(source, path);
    for (prefix.len != 0) {
        val pid_r: res[intern.StrId, A.Error] = np.intern_path(?p.s.interner, source, prefix);
        if (sel pid_r.err) { ret res[UseTarget, outcome.Fail].err{outcome.refused(pid_r.err)}; }
        val pid: intern.StrId = pid_r.ok;
        if (fqn_names_file(p, pid)) {
            var ut: UseTarget;
            ut.module_fqn   = pid;
            ut.leaf         = leaf;
            ut.binds_module = false;
            ret res[UseTarget, outcome.Fail].ok{ut};
        }
        prefix = np.prefix(source, prefix);
    }
    ret res[UseTarget, outcome.Fail].err{outcome.user(unresolvable_use_msg(p, source, path, full_id))};
}

fun unresolvable_use_msg(p: *project.Project, source: str, path: token.Span, full_id: intern.StrId) str {
    val generic: str = diag_join_named(p.s, "use path '", full_id, "' does not name a module", "use path does not name a module");

    if (np.prefix(source, path).len == 0) { ret generic; }
    var cursor:    usize                      = path.offset;
    val root_span: token.Span                 = np.next(source, path, ?cursor);
    val root_r:    res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source, root_span);
    if (sel root_r.err) { ret generic; }
    val root_id: intern.StrId = root_r.ok;

    var found:  bool         = false;
    var mod_id: intern.StrId = intern.STR_NIL;
    project_module_lookup(p, root_id, ?found, ?mod_id);
    if (found) { ret generic; }

    ret diag_undeclared_root(p.s, full_id, root_id);
}

fun diag_undeclared_root(s: *session.Session, full_id: intern.StrId, root_id: intern.StrId) str {
    val fallback: str      = "use path names an undeclared module root";
    val fo:       opt[str] = intern.lookup(?s.interner, full_id);
    val ro:       opt[str] = intern.lookup(?s.interner, root_id);
    if (sel fo.none) { ret fallback; }
    if (sel ro.none) { ret fallback; }

    val res_msg: res[str, format.FormatError] = format.sprint(s.alloc,
        "use path '{}': module root '{}' is not this project or a declared dependency; declare it in mach.toml",
        fo.some, ro.some);
    if (sel res_msg.err) { ret fallback; }
    val buf: str = res_msg.ok;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf);
    str_free(s.alloc, buf);
    if (sel ir.err) { ret fallback; }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret fallback;
}

fun fqn_names_file(p: *project.Project, fqn: intern.StrId) bool {
    val path_r: res[str, fail.Fail] = fqn_to_file_path(p, fqn);
    if (sel path_r.err) { ret false; }
    val file_path: str                       = path_r.ok;
    val is_file_r: res[bool, io_error.Error] = fs.is_file(file_path);
    val ok_:       bool                      = (sel is_file_r.ok && is_file_r.ok);
    str_free(p.alloc, file_path);
    ret ok_;
}

fun leaf_name(i: *intern.Interner, source: str, path: token.Span) res[intern.StrId, fail.Fail] {
    val intern_span_r: res[intern.StrId, A.Error] = intern.intern_span(i, source, np.leaf(source, path));
    if (sel intern_span_r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(intern_span_r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{intern_span_r.ok};
}

fun record_dep(p: *project.Project, mid: session.ModuleId, dep_mid: session.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: u32                  = 0;
    for (i < m.dep_count) {
        if (m.deps[i] == dep_mid) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    if (m.deps == nil) {
        val r: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.alloc, INITIAL_DEP_CAP::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        m.deps    = r.ok;
        m.dep_cap = INITIAL_DEP_CAP;
    }
    or (m.dep_count == m.dep_cap) {
        val new_cap: u32                             = m.dep_cap * 2;
        val r:       res[*session.ModuleId, A.Error] = A.reallocate[session.ModuleId](p.alloc, m.deps, m.dep_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        m.deps    = r.ok;
        m.dep_cap = new_cap;
    }
    m.deps[m.dep_count] = dep_mid;
    m.dep_count         = m.dep_count + 1;
    ret err[fail.Fail].ok{};
}

fun gated_const_message(s: *session.Session, status: *fail.PhaseStatus, name: intern.StrId, dep_fqn: intern.StrId) str {
    val fallback: str      = "tuple-dependent public constants are not yet supported in union builds";
    val no:       opt[str] = intern.lookup(?s.interner, name);
    val fo:       opt[str] = intern.lookup(?s.interner, dep_fqn);
    if (sel no.none) { ret fallback; }
    if (sel fo.none) { ret fallback; }

    val res_msg: res[str, format.FormatError] = format.sprint(s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        no.some, fo.some);
    if (sel res_msg.err) {
        fail.internal(status, outcome.format_text(res_msg.err));
        ret fallback;
    }
    val buf: str = res_msg.ok;

    val ir: res[intern.StrId, A.Error] = intern.intern(?s.interner, buf);
    str_free(s.alloc, buf);
    if (sel ir.err) {
        fail.internal(status, outcome.alloc_text(ir.err));
        ret fallback;
    }

    val nm: opt[str] = intern.lookup(?s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret fallback;
}

pub fun check_gated_const_imports(p: *project.Project) err[fail.Fail] {
    if (!p.union) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        var j: u32                  = 0;
        for (j < m.const_import_count) {
            val ci:  *project.ModRef        = ?m.const_imports[j];
            val dep: *project.ModuleEntry   = project.module_at(p, ci.module::u32);
            val v:   opt[*project.PubConst] = pub_const_lookup(dep, ci.name);
            if (sel v.none) {
                j = j + 1;
                cnt;
            }
            val pc: *project.PubConst = v.some;
            if (pc.gated) {
                val msg: str = gated_const_message(p.s, ?m.load_status, ci.name, dep.fqn);
                fail.reject(?m.load_status);
                val committed_r: res[bool, fail.Fail] = diagnostic.gate_error(?p.diags, ?p.s.interner, m.file_id, ci.span, msg);
                if (sel committed_r.err) { ret err[fail.Fail].err{committed_r.err}; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun merge_pub_consts(p: *project.Project, mid: session.ModuleId, dep_mid: session.ModuleId, leaf: intern.StrId, span: token.Span) err[fail.Fail] {
    val m:   *project.ModuleEntry   = project.module_at(p, mid::u32);
    val dep: *project.ModuleEntry   = project.module_at(p, dep_mid::u32);
    val v:   opt[*project.PubConst] = pub_const_lookup(dep, leaf);
    if (sel v.none) { ret err[fail.Fail].ok{}; }
    val pc: *project.PubConst = v.some;
    if (pc.gated && p.union) {
        val msg: str = gated_const_message(p.s, ?m.load_status, leaf, dep.fqn);
        fail.reject(?m.load_status);
        val gated: res[bool, fail.Fail] = diagnostic.gate_error(?p.diags, ?p.s.interner, m.file_id, span, msg);
        if (sel gated.err) { ret err[fail.Fail].err{gated.err}; }
        ret err[fail.Fail].ok{};
    }
    ret comptime.bind(frame_ctx(m), leaf, pc.value);
}

fun pub_const_lookup(dep: *project.ModuleEntry, name: intern.StrId) opt[*project.PubConst] {
    var i: u32 = 0;
    for (i < dep.pub_const_count) {
        val pc: *project.PubConst = ?dep.pub_consts[i];
        if (pc.name == name) { ret opt[*project.PubConst].some{pc}; }
        i = i + 1;
    }
    ret opt[*project.PubConst].none{};
}

# the module `name` names in the module's current frame: the one the `use` binding it names, read
# in the arm each enclosing chain selects there; none when that `use` has not been walked
fun frame_mod_ref(p: *project.Project, mid: session.ModuleId, name: intern.StrId) res[opt[session.ModuleId], fail.Fail] {
    val m:     *project.ModuleEntry = project.module_at(p, mid::u32);
    val m_opt: opt[*module.Module]  = ast.get_module(m.a, m.a.root_module);
    if (sel m_opt.none) { ret res[opt[session.ModuleId], fail.Fail].err{fail.message("module root not set on Ast")}; }
    val source_r: res[str, fail.Fail] = module_source(p, mid);
    if (sel source_r.err) { ret res[opt[session.ModuleId], fail.Fail].err{source_r.err}; }
    val text: opt[str] = intern.lookup(?p.s.interner, name);
    if (sel text.none) { ret res[opt[session.ModuleId], fail.Fail].err{fail.message("module name is not interned")}; }
    ret mod_ref_in_list(p, mid, m_opt.some.decls_start, m_opt.some.decls_len, source_r.ok, text.some);
}

fun mod_ref_in_list(p: *project.Project, mid: session.ModuleId, start: u32, len: u32, source: str, text: str) res[opt[session.ModuleId], fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    val a: *ast.Ast             = m.a;
    var i: u32                  = 0;
    for (i < len) {
        val did:   id.DeclId       = a.decl_ids[start + i];
        val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
        if (sel d_opt.none) { ret res[opt[session.ModuleId], fail.Fail].err{fail.message("DeclId out of range during a module lookup")}; }
        var copied: decl.Decl = @d_opt.some;
        i = i + 1;
        if (copied.kind == decl.DECL_KIND_USE && use_binds(source, ?copied.data.use_, text)) {
            var k: u32 = 0;
            for (k < m.mod_ref_count) {
                if (m.mod_refs[k].decl == did) { ret res[opt[session.ModuleId], fail.Fail].ok{opt[session.ModuleId].some{m.mod_refs[k].module}}; }
                k = k + 1;
            }
            ret res[opt[session.ModuleId], fail.Fail].ok{opt[session.ModuleId].none{}};
        }
        if (copied.kind == decl.DECL_KIND_COMPTIME_IF
            && !comptime.comptime_if_declares_nothing(a, copied.data.comptime_if.branches_start, copied.data.comptime_if.branches_len)
            && chain_binds(a, source, ?copied.data.comptime_if, text)) {
            val arm_r: res[ChainChoice, fail.Fail] = demand_arm(p, mid, ?copied.data.comptime_if, source, false);
            if (sel arm_r.err) { ret res[opt[session.ModuleId], fail.Fail].err{arm_r.err}; }
            if (arm_r.ok.branch < copied.data.comptime_if.branches_len) {
                val br:    decl.ComptimeBranch                   = a.comptime_branches[copied.data.comptime_if.branches_start + arm_r.ok.branch];
                val found: res[opt[session.ModuleId], fail.Fail] = mod_ref_in_list(p, mid, br.body_start, br.body_len, source, text);
                if (sel found.err)     { ret found; }
                if (sel found.ok.some) { ret found; }
            }
        }
    }
    ret res[opt[session.ModuleId], fail.Fail].ok{opt[session.ModuleId].none{}};
}

rec LoadMemberCtx {
    p:   *project.Project;
    mid: session.ModuleId;
}

fun resolve_module_member_const_load(lc: *LoadMemberCtx, eid: id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val m: *project.ModuleEntry = project.module_at(lc.p, lc.mid::u32);
    if (m.a == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }

    val e_opt: opt[*expr.Expr] = ast.get_expr(m.a, eid);
    if (sel e_opt.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val node: *expr.Expr = e_opt.some;
    if (node.kind != expr.EXPR_KIND_MEMBER) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }

    val o_opt: opt[*expr.Expr] = ast.get_expr(m.a, node.data.member.object);
    if (sel o_opt.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val obj: *expr.Expr = o_opt.some;
    if (obj.kind != expr.EXPR_KIND_IDENT) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }

    val src_opt: opt[*src.SourceFile] = src.get(?lc.p.s.sources, m.file_id);
    if (sel src_opt.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val source: str = src_opt.some.text;

    val obj_r: res[intern.StrId, A.Error] = intern.intern_span(?lc.p.s.interner, source, obj.data.ident.tok);
    if (sel obj_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, outcome.alloc_text(obj_r.err))}; }
    val dep_r: res[opt[session.ModuleId], fail.Fail] = frame_mod_ref(lc.p, lc.mid, obj_r.ok);
    if (sel dep_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.describe(dep_r.err))}; }
    val dep_opt: opt[session.ModuleId] = dep_r.ok;
    if (sel dep_opt.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }

    val name_r: res[intern.StrId, A.Error] = intern.intern_span(?lc.p.s.interner, source, node.data.member.name);
    if (sel name_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, outcome.alloc_text(name_r.err))}; }

    val dep:  *project.ModuleEntry   = project.module_at(lc.p, (dep_opt.some)::u32);
    val name: intern.StrId           = name_r.ok;
    val v:    opt[*project.PubConst] = pub_const_lookup(dep, name);
    if (sel v.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val pc: *project.PubConst = v.some;
    if (pc.gated && lc.p.union) {
        val msg: str = gated_const_message(lc.p.s, ?m.load_status, name, dep.fqn);
        fail.reject(?m.load_status);
        val committed_r: res[bool, fail.Fail] = diagnostic.gate_error(?lc.p.diags, ?lc.p.s.interner, m.file_id, node.data.member.name, msg);
        if (sel committed_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.describe(committed_r.err))}; }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{pc.value}};
}

pub fun eval_for_load(
    p: *project.Project,
    mid: session.ModuleId,
    source: str,
    e: id.ExprId,
    fw: float.FloatWidth) res[comptime.CTValue, comptime.EvalFail] {
    val m:  *project.ModuleEntry = project.module_at(p, mid::u32);
    var lc: LoadMemberCtx;
    lc.p   = p;
    lc.mid = mid;
    val lcp:    *LoadMemberCtx                                            = ?lc;
    val caps_r: res[comptime.PhaseCapabilities[LoadMemberCtx], fail.Fail] = comptime.loading_capabilities[LoadMemberCtx](resolve_module_member_const_load, load_cast);
    if (sel caps_r.err) {
        var f: comptime.EvalFail;
        f.kind    = comptime.EVAL_FAIL_INTERNAL;
        f.message = fail.describe(caps_r.err);
        fail.internal(?m.load_status, f.message);
        ret res[comptime.CTValue, comptime.EvalFail].err{f};
    }
    val caps: comptime.PhaseCapabilities[LoadMemberCtx] =
        caps_r.ok;
    val r: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[LoadMemberCtx](frame_ctx(m), lcp, caps, m.a, source, e, ?p.s.interner, fw);
    if (sel r.err) {
        val f: comptime.EvalFail = r.err;
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?m.load_status, f.message); }
        ret res[comptime.CTValue, comptime.EvalFail].err{f};
    }
    ret res[comptime.CTValue, comptime.EvalFail].ok{r.ok};
}

# what a constant's declared type makes of its integer value: a primitive
# spelling types it directly, and a name is followed through `def`s across
# `use` and `fwd` to the primitive the chain ends at, so a gate reading the
# constant computes with the width and sign the program declared
def DeclaredClass: u8;

# not readable from syntax (a computed type, or a name the loaded modules do not
# bind yet): the value stays untyped and type checking decides it
val DECLARED_UNTYPED: DeclaredClass = 0;
val DECLARED_INT:     DeclaredClass = 1;
# the chain ends at a record, pointer, float or other non-integer type
val DECLARED_NON_INT: DeclaredClass = 2;

# a chain longer than this is a cycle, which type checking reports
val DECLARED_CHAIN_LIMIT: u32 = 64;

rec DeclaredInt {
    class:    DeclaredClass;
    unsigned: bool;
    width:    u8;
}

fun declared_int(class: DeclaredClass) DeclaredInt {
    var r: DeclaredInt;
    r.class    = class;
    r.unsigned = false;
    r.width    = 0;
    ret r;
}

rec DeclaredWalk {
    p: *project.Project;
    # the type spellings the chain passes through, for the refusal that names it
    steps: vector.Vector[intern.StrId];
}

def BindingKind: u8;

val BINDING_NONE:    BindingKind = 0;
val BINDING_DEF:     BindingKind = 1;
val BINDING_NOMINAL: BindingKind = 2;
val BINDING_MODULE:  BindingKind = 3;
val BINDING_SYMBOL:  BindingKind = 4;

# what one module-scope name binds, as far as a def chain needs to know
rec Binding {
    kind:   BindingKind;
    ty:     id.TypeId;
    module: session.ModuleId;
    leaf:   intern.StrId;
}

fun binding(kind: BindingKind) Binding {
    var b: Binding;
    b.kind   = kind;
    b.ty     = id.TYPE_NIL;
    b.module = session.MODULE_NIL;
    b.leaf   = intern.STR_NIL;
    ret b;
}

fun module_source(p: *project.Project, mid: session.ModuleId) res[str, fail.Fail] {
    val src_opt: opt[*src.SourceFile] = src.get(?p.s.sources, project.module_at(p, mid::u32).file_id);
    if (sel src_opt.none) { ret res[str, fail.Fail].err{fail.message("module file_id not found in SourceMap")}; }
    ret res[str, fail.Fail].ok{src_opt.some.text};
}

fun declared_value(p: *project.Project, mid: session.ModuleId, name: intern.StrId, ty: id.TypeId, value: comptime.CTValue) res[comptime.CTValue, fail.Fail] {
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val source_r: res[str, fail.Fail]  = module_source(p, mid);
    if (sel source_r.err) { ret res[comptime.CTValue, fail.Fail].err{source_r.err}; }
    val source: str = source_r.ok;
    if (value.kind != comptime.CT_KIND_INT || !names_def_chain(m.a, source, ty)) {
        ret res[comptime.CTValue, fail.Fail].ok{comptime.apply_declared_int_type(m.a, source, ty, value)};
    }

    var w: DeclaredWalk;
    w.p     = p;
    w.steps = vector.init[intern.StrId](p.alloc);
    fin { vector.dnit[intern.StrId](?w.steps); }
    val r: res[DeclaredInt, fail.Fail] = declared_type(?w, mid, ty, 0);
    if (sel r.err) { ret res[comptime.CTValue, fail.Fail].err{r.err}; }
    val d: DeclaredInt = r.ok;
    if (d.class == DECLARED_INT) { ret res[comptime.CTValue, fail.Fail].ok{comptime.typed_int(value, d.unsigned, d.width)}; }
    if (d.class == DECLARED_UNTYPED) {
        ret res[comptime.CTValue, fail.Fail].ok{comptime.typed_int(value, value.int_unsigned, 0)};
    }
    val message_r: res[intern.StrId, fail.Fail] = non_integer_message(p, name, ?w.steps);
    if (sel message_r.err) { ret res[comptime.CTValue, fail.Fail].err{message_r.err}; }
    ret res[comptime.CTValue, fail.Fail].ok{comptime.non_integer(message_r.ok)};
}

# a declared type that is a name no primitive spells, so only its def chain types the value
fun names_def_chain(a: *ast.Ast, source: str, ty: id.TypeId) bool {
    if (ty == id.TYPE_NIL) { ret false; }
    val found: opt[*atype.Type] = ast.get_type(a, ty);
    if (sel found.none) { ret false; }
    val t: *atype.Type = found.some;
    if (t.kind == atype.TYPE_KIND_SECRET)                              { ret names_def_chain(a, source, t.data.secret.inner); }
    if (t.kind != atype.TYPE_KIND_NAMED || t.data.named.args_len != 0) { ret false; }
    val prim: opt[type.TypeKind] = type.prim_from_view(view(?source[t.data.named.name.offset], t.data.named.name.len));
    ret sel prim.none;
}

fun declared_type(w: *DeclaredWalk, mid: session.ModuleId, ty: id.TypeId, depth: u32) res[DeclaredInt, fail.Fail] {
    if (depth > DECLARED_CHAIN_LIMIT || ty == id.TYPE_NIL) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    val m:        *project.ModuleEntry = project.module_at(w.p, mid::u32);
    val source_r: res[str, fail.Fail]  = module_source(w.p, mid);
    if (sel source_r.err) { ret res[DeclaredInt, fail.Fail].err{source_r.err}; }
    val source: str              = source_r.ok;
    val found:  opt[*atype.Type] = ast.get_type(m.a, ty);
    if (sel found.none) { ret res[DeclaredInt, fail.Fail].err{fail.message("declared TypeId out of range")}; }
    var copied: atype.Type  = @found.some;
    val t:      *atype.Type = ?copied;
    if (t.kind == atype.TYPE_KIND_SECRET) { ret declared_type(w, mid, t.data.secret.inner, depth); }

    val step_r: res[intern.StrId, A.Error] = intern.intern_span(?w.p.s.interner, source, t.span);
    if (sel step_r.err) { ret res[DeclaredInt, fail.Fail].err{fail.refused(step_r.err)}; }
    val pushed: res[usize, A.Error] = vector.push[intern.StrId](?w.steps, step_r.ok);
    if (sel pushed.err) { ret res[DeclaredInt, fail.Fail].err{fail.refused(pushed.err)}; }

    if (t.kind == atype.TYPE_KIND_PTR || t.kind == atype.TYPE_KIND_ARRAY || t.kind == atype.TYPE_KIND_FUN
        || t.kind == atype.TYPE_KIND_REC || t.kind == atype.TYPE_KIND_UNI) {
        ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)};
    }
    if (t.kind != atype.TYPE_KIND_NAMED) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    # a def is never generic, so a name taking arguments is a record, union or tag
    if (t.data.named.args_len != 0) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }

    val path: token.Span = t.data.named.name;
    if (np.prefix(source, path).len == 0) {
        # a vector spelling names a type as a primitive does, and no vector is an integer
        val spelled: opt[str] = intern.lookup(?w.p.s.interner, step_r.ok);
        if (sel spelled.some) {
            if (type.is_vector_spelling(spelled.some)) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }
        }
        val prim: opt[type.TypeKind] = type.prim_from_view(view(?source[path.offset], path.len));
        if (sel prim.some) {
            val pd: type.PrimDesc = type.prim_desc(prim.some);
            if (pd.class != type.PRIM_CLASS_INT) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }
            var r: DeclaredInt = declared_int(DECLARED_INT);
            r.unsigned = !pd.signed;
            r.width    = pd.bits::u8;
            ret res[DeclaredInt, fail.Fail].ok{r};
        }
    }
    val owner_r: res[opt[session.ModuleId], fail.Fail] = qualifier_module(w.p, mid, source, np.prefix(source, path));
    if (sel owner_r.err)     { ret res[DeclaredInt, fail.Fail].err{owner_r.err}; }
    if (sel owner_r.ok.none) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    val leaf_r: res[intern.StrId, A.Error] = intern.intern_span(?w.p.s.interner, source, np.leaf(source, path));
    if (sel leaf_r.err) { ret res[DeclaredInt, fail.Fail].err{fail.refused(leaf_r.err)}; }
    val local: bool = np.prefix(source, path).len == 0;
    ret declared_name(w, owner_r.ok.some, leaf_r.ok, local, depth);
}

# the type a name binds in a module: its own scope when `local`, else its public surface
fun declared_name(w: *DeclaredWalk, mid: session.ModuleId, name: intern.StrId, local: bool, depth: u32) res[DeclaredInt, fail.Fail] {
    if (depth > DECLARED_CHAIN_LIMIT) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)}; }
    val b_r: res[Binding, fail.Fail] = module_binding(w.p, mid, name, local);
    if (sel b_r.err) { ret res[DeclaredInt, fail.Fail].err{b_r.err}; }
    val b: Binding = b_r.ok;
    if (b.kind == BINDING_DEF)     { ret declared_type(w, mid, b.ty, depth + 1); }
    if (b.kind == BINDING_NOMINAL) { ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_NON_INT)}; }
    if (b.kind == BINDING_SYMBOL)  { ret declared_name(w, b.module, b.leaf, false, depth + 1); }
    ret res[DeclaredInt, fail.Fail].ok{declared_int(DECLARED_UNTYPED)};
}

# the module a qualified type's prefix names: its first segment is a module this
# one imports, and each further segment a module the previous one forwards
fun qualifier_module(p: *project.Project, mid: session.ModuleId, source: str, prefix: token.Span) res[opt[session.ModuleId], fail.Fail] {
    if (prefix.len == 0) { ret res[opt[session.ModuleId], fail.Fail].ok{opt[session.ModuleId].some{mid}}; }
    var owner:  session.ModuleId = mid;
    var local:  bool             = true;
    var cursor: usize            = prefix.offset;
    for (cursor < prefix.offset + prefix.len) {
        val segment: token.Span = np.next(source, prefix, ?cursor);
        if (segment.len == 0) { brk; }
        val seg_r: res[intern.StrId, A.Error] = intern.intern_span(?p.s.interner, source, segment);
        if (sel seg_r.err) { ret res[opt[session.ModuleId], fail.Fail].err{fail.refused(seg_r.err)}; }
        val b_r: res[Binding, fail.Fail] = module_binding(p, owner, seg_r.ok, local);
        if (sel b_r.err)                   { ret res[opt[session.ModuleId], fail.Fail].err{b_r.err}; }
        if (b_r.ok.kind != BINDING_MODULE) { ret res[opt[session.ModuleId], fail.Fail].ok{opt[session.ModuleId].none{}}; }
        owner = b_r.ok.module;
        local = false;
    }
    ret res[opt[session.ModuleId], fail.Fail].ok{opt[session.ModuleId].some{owner}};
}

# what `name` binds at module scope in `mid`, read from its syntax so the answer does not depend
# on how far the walk has reached; a `use` binds only locally. a name declared under `$if` is
# read in the arm its chain selects: decided now in the module being walked (`local`), or from
# the states its walk left in a module already loaded, where an undecided chain binds nothing
fun module_binding(p: *project.Project, mid: session.ModuleId, name: intern.StrId, local: bool) res[Binding, fail.Fail] {
    val acquired: err[fail.Fail] = acquire_load_view(p, mid, 0);
    if (sel acquired.err) { ret res[Binding, fail.Fail].err{acquired.err}; }
    val m:        *project.ModuleEntry = project.module_at(p, mid::u32);
    val source_r: res[str, fail.Fail]  = module_source(p, mid);
    if (sel source_r.err) { ret res[Binding, fail.Fail].err{source_r.err}; }
    val text: opt[str] = intern.lookup(?p.s.interner, name);
    if (sel text.none) { ret res[Binding, fail.Fail].err{fail.message("def chain name is not interned")}; }
    val m_opt: opt[*module.Module] = ast.get_module(m.a, m.a.root_module);
    if (sel m_opt.none) { ret res[Binding, fail.Fail].err{fail.message("module root not set on Ast")}; }
    val saved_frame: u32 = m.frame;
    if (!local) { m.frame = project.FRAME_BUILD; }
    val r: res[Binding, fail.Fail] = binding_in_list(p, mid, m_opt.some.decls_start, m_opt.some.decls_len, source_r.ok, text.some, local);
    m.frame = saved_frame;
    ret r;
}

fun binding_in_list(p: *project.Project, mid: session.ModuleId, start: u32, len: u32, source: str, text: str, local: bool) res[Binding, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val a:     *ast.Ast        = project.module_at(p, mid::u32).a;
        val d_opt: opt[*decl.Decl] = ast.get_decl(a, a.decl_ids[start + i]);
        if (sel d_opt.none) { ret res[Binding, fail.Fail].err{fail.message("DeclId out of range during def chain lookup")}; }
        var copied: decl.Decl  = @d_opt.some;
        val d:      *decl.Decl = ?copied;
        i = i + 1;
        if (d.kind == decl.DECL_KIND_DEF && spells(source, d.data.def_.name, text)) {
            var b: Binding = binding(BINDING_DEF);
            b.ty = d.data.def_.ty;
            ret res[Binding, fail.Fail].ok{b};
        }
        if (declares_nominal(source, d, text)) { ret res[Binding, fail.Fail].ok{binding(BINDING_NOMINAL)}; }
        if ((d.kind == decl.DECL_KIND_USE && local) || d.kind == decl.DECL_KIND_FWD) {
            var alias: token.Span = d.data.use_.alias;
            var path:  token.Span = d.data.use_.path;
            if (d.kind == decl.DECL_KIND_FWD) {
                alias = d.data.fwd_.alias;
                path  = d.data.fwd_.path;
            }
            var bound: token.Span = alias;
            if (bound.len == 0)                               { bound = np.leaf(source, path); }
            if (path.len != 0 && spells(source, bound, text)) { ret import_binding(p, source, path); }
        }
        if (d.kind == decl.DECL_KIND_COMPTIME_IF
            && !comptime.comptime_if_declares_nothing(a, d.data.comptime_if.branches_start, d.data.comptime_if.branches_len)
            && chain_names_type(a, source, ?d.data.comptime_if, text, local)) {
            val arm_r: res[ChainChoice, fail.Fail] = demand_arm(p, mid, ?d.data.comptime_if, source, local);
            if (sel arm_r.err) { ret res[Binding, fail.Fail].err{arm_r.err}; }
            if (arm_r.ok.verdict.kind != VERDICT_REFUSED && arm_r.ok.branch < d.data.comptime_if.branches_len) {
                val br:    decl.ComptimeBranch     = a.comptime_branches[d.data.comptime_if.branches_start + arm_r.ok.branch];
                val found: res[Binding, fail.Fail] = binding_in_list(p, mid, br.body_start, br.body_len, source, text, local);
                if (sel found.err)                 { ret found; }
                if (found.ok.kind != BINDING_NONE) { ret found; }
            }
        }
    }
    ret res[Binding, fail.Fail].ok{binding(BINDING_NONE)};
}

fun declares_nominal(source: str, d: *decl.Decl, text: str) bool {
    ret (d.kind == decl.DECL_KIND_REC && spells(source, d.data.rec_.name, text))
        || (d.kind == decl.DECL_KIND_UNI && spells(source, d.data.uni_.name, text))
        || (d.kind == decl.DECL_KIND_TAG && spells(source, d.data.tag_.name, text))
        || (d.kind == decl.DECL_KIND_FUN && spells(source, d.data.fun_.name, text));
}

# whether any arm of a chain, at any depth, binds `text` as a def chain can read it
fun chain_names_type(a: *ast.Ast, source: str, ci: *decl.DeclComptimeIf, text: str, local: bool) bool {
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?a.comptime_branches[ci.branches_start + bi];
        var i:  u32                  = 0;
        for (i < br.body_len) {
            val d_opt: opt[*decl.Decl] = ast.get_decl(a, a.decl_ids[br.body_start + i]);
            if (sel d_opt.some) {
                val d: *decl.Decl = d_opt.some;
                if (d.kind == decl.DECL_KIND_DEF && spells(source, d.data.def_.name, text))         { ret true; }
                if (declares_nominal(source, d, text))                                              { ret true; }
                if (d.kind == decl.DECL_KIND_USE && local && use_binds(source, ?d.data.use_, text)) { ret true; }
                if (d.kind == decl.DECL_KIND_FWD && d.data.fwd_.path.len != 0) {
                    var bound: token.Span = d.data.fwd_.alias;
                    if (bound.len == 0)              { bound = np.leaf(source, d.data.fwd_.path); }
                    if (spells(source, bound, text)) { ret true; }
                }
                if (d.kind == decl.DECL_KIND_COMPTIME_IF && chain_names_type(a, source, ?d.data.comptime_if, text, local)) { ret true; }
            }
            i = i + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun import_binding(p: *project.Project, source: str, path: token.Span) res[Binding, fail.Fail] {
    # an unresolvable import is reported where the walk reaches it
    val tgt_r: res[UseTarget, outcome.Fail] = resolve_use_target(p, source, path);
    if (sel tgt_r.err) {
        val error: outcome.Fail = tgt_r.err;
        if (sel error.user) { ret res[Binding, fail.Fail].ok{binding(BINDING_NONE)}; }
        ret res[Binding, fail.Fail].err{fail.message(outcome.describe(error))};
    }
    val ut:      UseTarget              = tgt_r.ok;
    val entry_r: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?ut.module_fqn);
    if (sel entry_r.none) { ret res[Binding, fail.Fail].ok{binding(BINDING_NONE)}; }
    val target: session.ModuleId = @entry_r.some;
    if (p.load_status[target::u32] == project.LOAD_NEW) { ret res[Binding, fail.Fail].ok{binding(BINDING_NONE)}; }
    var b: Binding = binding(BINDING_SYMBOL);
    if (ut.binds_module) { b.kind = BINDING_MODULE; }
    b.module = target;
    b.leaf   = ut.leaf;
    ret res[Binding, fail.Fail].ok{b};
}

fun spells(source: str, span: token.Span, text: str) bool {
    ret span.len != 0 && view_eq_str(view(?source[span.offset], span.len), text);
}

fun non_integer_message(p: *project.Project, name: intern.StrId, steps: *vector.Vector[intern.StrId]) res[intern.StrId, fail.Fail] {
    val name_text: opt[str] = intern.lookup(?p.s.interner, name);
    if (sel name_text.none) { ret res[intern.StrId, fail.Fail].err{fail.message("constant name is not interned")}; }
    var chain: str = nil;
    var i:     u32 = 0;
    for (i::usize < steps.len) {
        val step: opt[str] = intern.lookup(?p.s.interner, steps.data[i]);
        if (sel step.none) { ret res[intern.StrId, fail.Fail].err{fail.message("def chain step is not interned")}; }
        var next_r: res[str, format.FormatError];
        if (chain == nil)   { next_r = format.sprint(p.s.alloc, "`{}`", step.some); }
        or                  { next_r = format.sprint(p.s.alloc, "{} -> `{}`", chain, step.some); }
        if (chain != nil)   { str_free(p.s.alloc, chain); }
        if (sel next_r.err) { ret res[intern.StrId, fail.Fail].err{fail.format_refused(next_r.err)}; }
        chain = next_r.ok;
        i     = i + 1;
    }
    var msg_r: res[str, format.FormatError];
    if (steps.len == 1) {
        msg_r = format.sprint(p.s.alloc, "`{}` is not an integer constant, so no gate can read it: its type {} is not an integer primitive",
            name_text.some, chain);
    }
    or {
        msg_r = format.sprint(p.s.alloc,
            "`{}` is not an integer constant, so no gate can read it: its type follows the def chain {}, which ends outside the integer primitives",
            name_text.some, chain);
    }
    if (chain != nil)  { str_free(p.s.alloc, chain); }
    if (sel msg_r.err) { ret res[intern.StrId, fail.Fail].err{fail.format_refused(msg_r.err)}; }
    val interned: res[intern.StrId, A.Error] = intern.intern(?p.s.interner, msg_r.ok);
    str_free(p.s.alloc, msg_r.ok);
    if (sel interned.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(interned.err)}; }
    ret res[intern.StrId, fail.Fail].ok{interned.ok};
}

fun add_pub_const(p: *project.Project, m: *project.ModuleEntry, name: intern.StrId, value: comptime.CTValue) err[fail.Fail] {
    if (m.pub_consts == nil) {
        val r: res[*project.PubConst, A.Error] = A.allocate[project.PubConst](p.alloc, INITIAL_PUB_CAP::usize);
        if (sel r.err) {
            ret err[fail.Fail].err{fail.refused(r.err)};
        }
        m.pub_consts    = r.ok;
        m.pub_const_cap = INITIAL_PUB_CAP;
    }
    or (m.pub_const_count == m.pub_const_cap) {
        val new_cap: u32                             = m.pub_const_cap * 2;
        val r:       res[*project.PubConst, A.Error] = A.reallocate[project.PubConst](p.alloc, m.pub_consts, m.pub_const_cap::usize, new_cap::usize);
        if (sel r.err) {
            ret err[fail.Fail].err{fail.refused(r.err)};
        }
        m.pub_consts    = r.ok;
        m.pub_const_cap = new_cap;
    }
    var pc: project.PubConst;
    pc.name                         = name;
    pc.value                        = value;
    pc.gated                        = p.in_gated_decl_walk;
    m.pub_consts[m.pub_const_count] = pc;
    m.pub_const_count               = m.pub_const_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun rebuild_topo(p: *project.Project, emit_roots: *session.ModuleId, emit_root_count: u32) err[fail.Fail] {
    if (project.module_count(p) == 0) {
        p.topo_len = 0;
        ret err[fail.Fail].ok{};
    }
    val ir: res[*bool, A.Error] = A.allocate[bool](p.alloc, project.module_count(p)::usize);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    val included: *bool             = ir.ok;
    val sr:       res[*u8, A.Error] = A.allocate[u8](p.alloc, project.module_count(p)::usize);
    if (sel sr.err) {
        A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val state: *u8                 = sr.ok;
    val er:    res[*bool, A.Error] = A.allocate[bool](p.alloc, project.module_count(p)::usize);
    if (sel er.err) {
        A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
        A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
        ret err[fail.Fail].err{fail.refused(er.err)};
    }
    val emitted: *bool = er.ok;
    var i:       u32   = 0;
    for (i < project.module_count(p)) {
        included[i] = false;
        emitted[i]  = false;
        state[i]    = 0;
        i           = i + 1;
    }
    i = 0;
    for (i < p.topo_len) {
        included[p.topo[i]::u32] = true;
        i                        = i + 1;
    }
    i = 0;
    for (i < emit_root_count) {
        mark_emitted_deps(p, emit_roots[i], emitted);
        i = i + 1;
    }

    val tr: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.alloc, project.module_count(p)::usize);
    if (sel tr.err) {
        A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
        A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
        A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
        ret err[fail.Fail].err{fail.refused(tr.err)};
    }
    val ordered:     *session.ModuleId = tr.ok;
    var ordered_len: u32               = 0;
    i = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (!emitted[mid::u32]) {
            i = i + 1;
            cnt;
        }
        val vr: err[fail.Fail] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (sel vr.err) {
            A.deallocate[session.ModuleId](p.alloc, ordered, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
            A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
            ret vr;
        }
        i = i + 1;
    }
    i = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (emitted[mid::u32]) {
            i = i + 1;
            cnt;
        }
        val vr: err[fail.Fail] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (sel vr.err) {
            A.deallocate[session.ModuleId](p.alloc, ordered, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
            A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
            ret vr;
        }
        i = i + 1;
    }

    if (p.topo != nil && p.topo_cap > 0) {
        A.deallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize);
    }
    p.topo     = ordered;
    p.topo_len = ordered_len;
    p.topo_cap = project.module_count(p);
    p.emit_len = 0;
    for (p.emit_len < p.topo_len && emitted[p.topo[p.emit_len]::u32]) {
        p.emit_len = p.emit_len + 1;
    }
    A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
    A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
    A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
    ret err[fail.Fail].ok{};
}

fun mark_emitted_deps(p: *project.Project, mid: session.ModuleId, emitted: *bool) {
    if (mid::u32 >= project.module_count(p) || emitted[mid::u32]) { ret; }
    emitted[mid::u32] = true;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: u32                  = 0;
    for (i < m.dep_count) {
        mark_emitted_deps(p, m.deps[i], emitted);
        i = i + 1;
    }
}

fun topo_visit(p: *project.Project, mid: session.ModuleId, included: *bool, state: *u8,
    ordered: *session.ModuleId, ordered_len: *u32) err[fail.Fail] {
    if (mid::u32 >= project.module_count(p) || !included[mid::u32]) { ret err[fail.Fail].ok{}; }
    if (state[mid::u32] == 2)                                       { ret err[fail.Fail].ok{}; }
    if (state[mid::u32] == 1)                                       { ret err[fail.Fail].err{fail.message("circular module dependency through a module a union target tuple reached late")}; }
    state[mid::u32] = 1;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: u32                  = 0;
    for (i < m.dep_count) {
        val vr: err[fail.Fail] = topo_visit(p, m.deps[i], included, state, ordered, ordered_len);
        if (sel vr.err) { ret vr; }
        i = i + 1;
    }
    state[mid::u32]       = 2;
    ordered[@ordered_len] = mid;
    @ordered_len          = @ordered_len + 1;
    ret err[fail.Fail].ok{};
}

fun topo_push(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    if (p.topo == nil) {
        val r: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.alloc, INITIAL_MODULE_CAP::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        p.topo     = r.ok;
        p.topo_cap = INITIAL_MODULE_CAP;
    }
    or (p.topo_len == p.topo_cap) {
        val new_cap: u32                             = p.topo_cap * 2;
        val r:       res[*session.ModuleId, A.Error] = A.reallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize, new_cap::usize);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        p.topo     = r.ok;
        p.topo_cap = new_cap;
    }
    p.topo[p.topo_len] = mid;
    p.topo_len         = p.topo_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun register_module_asts(p: *project.Project) err[fail.Fail] {
    var roots: vector.Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (m.file_id == src.FILE_NIL) {
            i = i + 1;
            cnt;
        }
        var num: u32            = i;
        val rn:  err[fail.Fail] = query.set_input(?p.s.queries, query.Q_MODULE_NUMBER, m.stable_id::u64, (?num)::*u8, 4);
        if (sel rn.err) { ret rn; }
        val saved: res[usize, A.Error] = vector.push[query.QueryKey](?roots, query.QueryKey{kind: query.Q_PARSE, key: m.file_id::u64});
        if (sel saved.err) { ret err[fail.Fail].err{fail.refused(saved.err)}; }
        i = i + 1;
    }
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(p);
    if (sel begun.err) { ret err[fail.Fail].err{fail.message(outcome.describe(begun.err))}; }
    val operation: query.Operation   = begun.ok;
    var result:    err[outcome.Fail] = err[outcome.Fail].ok{};
    i = 0;
    for (i < project.module_count(p)) {
        if (project.module_at(p, i).file_id == src.FILE_NIL) {
            i = i + 1;
            cnt;
        }
        val acquired: err[fail.Fail] = acquire_parse_view(p, i::session.ModuleId);
        if (sel acquired.err) {
            result = err[outcome.Fail].err{outcome.from_fail(acquired.err)};
            brk;
        }
        val m:          *project.ModuleEntry = project.module_at(p, i);
        val registered: err[fail.Fail]       = session.register_module_identity(p.s, i, m.a, m.fqn, m.stable_id);
        if (sel registered.err) {
            result = err[outcome.Fail].err{outcome.from_fail(registered.err)};
            brk;
        }
        i = i + 1;
    }
    val finished: err[outcome.Fail] = project.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel finished.err) {
        var j: u32 = 0;
        for (j < i) {
            session.unregister_module_identity(p.s, j, project.module_at(p, j).stable_id);
            j = j + 1;
        }
        ret err[fail.Fail].err{fail.message(outcome.describe(finished.err))};
    }
    ret err[fail.Fail].ok{};
}

pub fun acquire_loaded_parses(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        if (project.module_at(p, i).file_id != src.FILE_NIL) {
            val acquired: err[fail.Fail] = acquire_parse_view(p, i::session.ModuleId);
            if (sel acquired.err) { ret acquired; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun collect_loaded_parses(p: *project.Project, primary: err[outcome.Fail]) err[outcome.Fail] {
    var roots: vector.Vector[query.QueryKey] = vector.init[query.QueryKey](p.alloc);
    fin { vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val file: src.FileId = project.module_at(p, i).file_id;
        if (file != src.FILE_NIL) {
            val added: res[usize, A.Error] = vector.push[query.QueryKey](?roots, query.QueryKey{kind: query.Q_PARSE, key: file::u64});
            if (sel added.err) {
                diagnostic.note_lost(?p.s.diags);
                if (sel primary.err) { ret primary; }
                ret err[outcome.Fail].err{outcome.refused(added.err)};
            }
        }
        i = i + 1;
    }
    val begun: res[query.Operation, outcome.Fail] = project.begin_query_phase(p);
    if (sel begun.err) {
        if (sel primary.err) { ret primary; }
        ret err[outcome.Fail].err{begun.err};
    }
    val operation: query.Operation   = begun.ok;
    var result:    err[outcome.Fail] = primary;
    i = 0;
    for (i < project.module_count(p)) {
        if (project.module_at(p, i).file_id != src.FILE_NIL) {
            val acquired: err[fail.Fail] = acquire_parse_view(p, i::session.ModuleId);
            if (sel acquired.err) {
                val result_ok: bool = sel result.ok;
                if (result_ok) { result = err[outcome.Fail].err{outcome.from_fail(acquired.err)}; }
                brk;
            }
        }
        i = i + 1;
    }
    ret project.finish_query_phase(p, operation, roots.data, roots.len, result);
}
