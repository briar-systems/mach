use mach.lang.target.resolved;

pub fun entry_module_fqn(p: *project.Project, t: *project.TargetEntry) res[intern.StrId, fail.Fail] {
    val ep_opt: opt[str] = intern.get(?p.s.interner, t.entrypoint);
    if (sel ep_opt.none) { ret res[intern.StrId, fail.Fail].err{fail.message("entrypoint StrId not interned")}; }
    val ep_text: str = ep_opt.some;

    val id_opt: opt[str] = intern.get(?p.s.interner, p.config.id);
    if (sel id_opt.none) { ret res[intern.StrId, fail.Fail].err{fail.message("project id StrId not interned")}; }

    ret module.compose_fqn(p.alloc, ?p.s.interner, id_opt.some, ep_text);
}

pub fun join_path(alloc: *A.Allocator, a: str, b: str) res[str, fail.Fail] {
    val join_r: res[types_path.Path, A.Error] = types_path.join(alloc, a, b);
    if (sel join_r.err) { ret res[str, fail.Fail].err{fail.refused(join_r.err)}; }
    ret res[str, fail.Fail].ok{join_r.ok};
}

# the comptime context of a build for `t` under `req`, whose back end states `facts`: every
# fact comptime reads from the target and the build options, and nothing of a project, so
# the build and the editor fold the same program the same way
pub fun target_context(alloc: *A.Allocator, t: *resolved.Target, facts: target_facts.Facts, req: *request.BuildRequest,
    compiler_name: intern.StrId, compiler_ver: intern.StrId) comptime_scope.ComptimeCtx {
    var build_mode_id: u32 = comptime_path.MODE_DEBUG;
    if (request.is_release(req)) { build_mode_id = comptime_path.MODE_RELEASE; }
    # a build is position independent exactly when the executable it links is
    var build_pie: u32 = 0;
    if (resolved.pie(t)) { build_pie = 1; }
    ret comptime_scope.init(alloc, facts, comptime_scope.build_facts(build_mode_id, build_pie, compiler_name, compiler_ver));
}

# the comptime context a module of `artifact` evaluates in under the cell's target, what
# `$bin.name` reads; the load adds what the module's own source says
fun artifact_context(p: *project.Project, artifact: intern.StrId) res[comptime_scope.ComptimeCtx, fail.Fail] {
    if (p == nil || p.target_entry == nil) {
        ret res[comptime_scope.ComptimeCtx, fail.Fail].err{fail.message("driver: module context requires an opened project and request")};
    }
    var ctx: comptime_scope.ComptimeCtx = target_context(p.alloc, ?p.target, p.back.facts, ?p.req, p.compiler_name, p.compiler_ver);
    ctx.env.laying              = p.back.laying;
    ctx.env.build.union_build   = p.loader.union;
    ctx.env.build.project_id    = p.config.id;
    ctx.env.build.project_ver   = p.config.version;
    ctx.env.build.os_name       = p.target_entry.os_name;
    ctx.env.build.isa_name      = p.target_entry.isa_name;
    ctx.env.build.abi_name      = p.target_entry.abi_name;
    ctx.env.build.platform_name = p.target_entry.platform_name;
    ctx.env.build.bin_name      = artifact;
    ret res[comptime_scope.ComptimeCtx, fail.Fail].ok{ctx};
}

# the packages the cell compiles, as the disk provider reads them: the root project first, then
# each dependency of the closure
fun packages_set(p: *project.Project) err[fail.Fail] {
    disk.packages_clear(?p.disk);
    val root: err[fail.Fail] = disk.package_add(?p.disk, disk.Package{
        id: p.config.id, version: p.config.version, dir: p.config.project_root, src: p.config.dir_src, root: true
    });
    if (sel root.err) { ret root; }
    var k: u32 = 0;
    for (k < p.config.dep_count) {
        val dep:   *project.DepEntry = ?p.config.deps[k];
        val added: err[fail.Fail]    = disk.package_add(?p.disk, disk.Package{
            id: dep.project_id, version: dep.manifest.version, dir: dep.vendor_root, src: dep.project_dir_src, root: false
        });
        if (sel added.err) { ret added; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# one entry of the load, run in one query operation, which the walk's parses and every syntax it
# reads belong to; a parse that fails in it is the root whose diagnostics the entry presents
# ---
# p:         the project
# operation: the operation the entry runs in
# failed:    the parse of each module whose parse failed in the entry
rec Walk {
    p:         *project.Project;
    operation: query.Operation;
    failed:    collections_vector.Vector[query.QueryKey];
}

fun walk_init(p: *project.Project) Walk {
    ret Walk{p: p, operation: query.Operation{}, failed: collections_vector.init[query.QueryKey](p.alloc)};
}

fun walk_dnit(w: *Walk) {
    collections_vector.dnit[query.QueryKey](?w.failed);
}

# the project's loader, pointed at the project where it is now and run for `w`: the project is a
# value its callers move, so what the loader holds of it is bound again before each use
fun loader_of(w: *Walk) res[*fe_load.Loader, fail.Fail] {
    val p: *project.Project = w.p;
    if (p.disk.packages.len == 0) {
        val placed: err[fail.Fail] = packages_set(p);
        if (sel placed.err) { ret res[*fe_load.Loader, fail.Fail].err{placed.err}; }
    }
    p.overlay = overlay.init(disk.provider_of(?p.disk), ?p.s.overlays);
    val host: fe_load.Host = fe_load.Host{
        ctx:     w::ptr, add: host_add, row: host_row, syntax: host_syntax, parse: host_parse,
        context: host_context, done: host_done
    };
    fe_load.bind(?p.loader, host, overlay.provider_of(?p.overlay), ?p.diags);
    ret res[*fe_load.Loader, fail.Fail].ok{?p.loader};
}

# open the operation an entry runs in, with the loader bound to it
fun walk_begin(w: *Walk) res[*fe_load.Loader, fail.Fail] {
    val l: res[*fe_load.Loader, fail.Fail] = loader_of(w);
    if (sel l.err) { ret l; }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(w.p);
    if (sel begun.err) { ret res[*fe_load.Loader, fail.Fail].err{begun.err}; }
    w.operation = begun.ok;
    ret l;
}

# close an entry's operation and show what it collected
fun walk_end(w: *Walk, result: err[fail.Fail]) err[fail.Fail] {
    ret frontend.finish_query_phase(w.p, w.operation, w.failed.data, w.failed.len, result);
}

fun host_add(ctx: ptr, fqn: intern.StrId, sid: module.StableModuleId) res[module.ModuleId, fail.Fail] {
    val p:    *project.Project = (ctx::*Walk).p;
    val slot: err[fail.Fail]   = project.module_reserve(p);
    if (sel slot.err) { ret res[module.ModuleId, fail.Fail].err{slot.err}; }
    var m: project.ModuleEntry;
    m.fqn              = fqn;
    m.file_id          = lang_source.FILE_NIL;
    m.stable_id        = sid;
    m.unit             = nil;
    m.object           = nil;
    m.ir_output        = "";
    m.asm_output       = "";
    m.staged           = nil;
    m.record           = project.Record{};
    m.staged_facts     = cache_record.Facts{};
    m.cache_checked    = false;
    m.cache_hit        = false;
    m.cache_keyed      = false;
    m.frontend_skipped = false;
    m.test             = project.TestObject{};
    m.load             = fe_load.Module{};
    m.lower_scoped     = false;
    m.expects          = expect.Index{};
    m.released         = false;
    var cache_byte: usize = 0;
    for (cache_byte < 32) {
        m.cache_under[cache_byte] = 0;
        cache_byte                = cache_byte + 1;
    }
    ret res[module.ModuleId, fail.Fail].ok{project.module_append(p, m)};
}

fun host_row(ctx: ptr, mid: module.ModuleId) fe_load.Row {
    val m: *project.ModuleEntry = project.module_at((ctx::*Walk).p, mid::u32);
    ret fe_load.Row{name: m.fqn, stable: m.stable_id, file: m.file_id, load: ?m.load};
}

fun host_syntax(ctx: ptr, mid: module.ModuleId) *ast.Ast {
    val p: *project.Project = (ctx::*Walk).p;
    ret frontend.syntax(p, project.module_at(p, mid::u32));
}

# a module's parse in the entry's operation; a failed one is kept as a root the entry presents
fun host_parse(ctx: ptr, mid: module.ModuleId, file: lang_source.FileId, reported: bool) err[fail.Fail] {
    val w:      *Walk                = ctx::*Walk;
    val p:      *project.Project     = w.p;
    val t_load: readout.Instant      = readout.item_begin(p.progress);
    val m:      *project.ModuleEntry = project.module_at(p, mid::u32);
    m.file_id = file;
    val acquired: res[frontend.ParsedModule, fail.Fail] = acquire_parse_view(p, mid);
    if (sel acquired.err) {
        val kept: res[usize, A.Error] = collections_vector.push[query.QueryKey](?w.failed, query.QueryKey{kind: ?frontend.PARSE, key: lang_source.file_index(file)::u64});
        if (sel kept.err) {
            diagnostic.note_lost(?p.diags);
            diagnostic.note_lost(?p.s.diags);
        }
        ret err[fail.Fail].err{acquired.err};
    }
    if (reported) { readout.item(p.progress, readout.LOAD, intern.text(?p.s.interner, m.fqn), t_load); }
    ret err[fail.Fail].ok{};
}

fun host_context(ctx: ptr, artifact: intern.StrId) res[comptime_scope.ComptimeCtx, fail.Fail] {
    ret artifact_context((ctx::*Walk).p, artifact);
}

fun host_done(ctx: ptr, mid: module.ModuleId) err[fail.Fail] {
    ret topo_push((ctx::*Walk).p, mid);
}

# load the module `fqn` names and everything it reaches
pub fun module_load(p: *project.Project, fqn: intern.StrId) res[module.ModuleId, fail.Fail] {
    var w: Walk = walk_init(p);
    fin { walk_dnit(?w); }
    val l: res[*fe_load.Loader, fail.Fail] = walk_begin(?w);
    if (sel l.err) { ret res[module.ModuleId, fail.Fail].err{l.err}; }
    val loaded: res[module.ModuleId, fail.Fail] = fe_load.module_load(l.ok, fqn);
    var result: err[fail.Fail]                  = err[fail.Fail].ok{};
    if (sel loaded.err) { result = err[fail.Fail].err{loaded.err}; }
    val shown: err[fail.Fail] = walk_end(?w, result);
    if (sel shown.err) { ret res[module.ModuleId, fail.Fail].err{shown.err}; }
    ret loaded;
}

# parse the module `fqn` names as a root, without walking it
pub fun module_open(p: *project.Project, fqn: intern.StrId) res[module.ModuleId, fail.Fail] {
    var w: Walk = walk_init(p);
    fin { walk_dnit(?w); }
    val l: res[*fe_load.Loader, fail.Fail] = walk_begin(?w);
    if (sel l.err) { ret res[module.ModuleId, fail.Fail].err{l.err}; }
    val opened: res[module.ModuleId, fail.Fail] = fe_load.module_open(l.ok, fqn);
    var result: err[fail.Fail]                  = err[fail.Fail].ok{};
    if (sel opened.err) { result = err[fail.Fail].err{opened.err}; }
    val shown: err[fail.Fail] = walk_end(?w, result);
    if (sel shown.err) { ret res[module.ModuleId, fail.Fail].err{shown.err}; }
    ret opened;
}

# whether the load reached the module `fqn` names and never read its file
pub fun module_unread(p: *project.Project, fqn: intern.StrId) bool {
    val mid: opt[module.ModuleId] = fe_load.module_find(?p.loader, fqn);
    if (sel mid.none) { ret false; }
    ret lang_source.file_is_nil(project.module_at(p, mid.some::u32).file_id);
}

# reparse and re-walk one loaded module after its text changed, and say whether its load surface
# survived, so the project's other modules stand as they are; every product the project holds of
# the module is dropped, since each is keyed by the old syntax tree
pub fun module_reload(p: *project.Project, mid: module.ModuleId) res[bool, fail.Fail] {
    var w: Walk = walk_init(p);
    fin { walk_dnit(?w); }
    val l: res[*fe_load.Loader, fail.Fail] = walk_begin(?w);
    if (sel l.err) { ret res[bool, fail.Fail].err{l.err}; }
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    project.lower_scope_drop(m);
    project.recorded_drop(m);
    m.unit               = nil;
    m.object             = nil;
    m.ir_output          = "";
    m.asm_output         = "";
    m.staged             = nil;
    m.cache_checked      = false;
    m.cache_hit          = false;
    m.cache_keyed        = false;
    m.frontend_skipped   = false;
    m.test.unit          = nil;
    m.test.object        = nil;
    m.test.staged        = nil;
    m.test.cache_checked = false;
    m.test.cache_hit     = false;
    val kept:   res[bool, fail.Fail] = fe_load.module_reload(l.ok, mid);
    var result: err[fail.Fail]       = err[fail.Fail].ok{};
    if (sel kept.err) { result = err[fail.Fail].err{kept.err}; }
    val shown: err[fail.Fail] = walk_end(?w, result);
    if (sel shown.err) { ret res[bool, fail.Fail].err{shown.err}; }
    ret kept;
}

# record the strings a module's decorator arguments evaluate to, from the syntax the project's
# operations last published
pub fun decorators_record(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    var w: Walk = walk_init(p);
    fin { walk_dnit(?w); }
    val l: res[*fe_load.Loader, fail.Fail] = loader_of(?w);
    if (sel l.err) { ret err[fail.Fail].err{l.err}; }
    ret fe_load.decorators_record(l.ok, mid);
}

# a module's parse in the open operation; a parse that published nothing is the load's
# failure for the module
fun acquire_parse_view(p: *project.Project, mid: module.ModuleId) res[frontend.ParsedModule, fail.Fail] {
    val m:        *project.ModuleEntry                  = project.module_at(p, mid::u32);
    val acquired: res[frontend.ParsedModule, fail.Fail] = frontend.parse(p, m);
    if (sel acquired.err) {
        val failure: fail.Fail = acquired.err;
        if (sel failure.reported) { lang_phase.reject(?m.load.status); }
        or                        { lang_phase.internal(?m.load.status, failure); }
    }
    ret acquired;
}

pub fun rebuild_topo(p: *project.Project, emit_roots: *module.ModuleId, emit_root_count: u32) err[fail.Fail] {
    if (project.module_count(p) == 0) {
        p.topo_len = 0;
        ret err[fail.Fail].ok{};
    }
    val ir: res[*bool, A.Error] = A.allocate[bool](p.alloc, project.module_count(p)::usize);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    val included: *bool = ir.ok;
    fin { A.deallocate[bool](p.alloc, included, project.module_count(p)::usize); }
    val sr: res[*u8, A.Error] = A.allocate[u8](p.alloc, project.module_count(p)::usize);
    if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    fin { A.deallocate[u8](p.alloc, state, project.module_count(p)::usize); }
    val er: res[*bool, A.Error] = A.allocate[bool](p.alloc, project.module_count(p)::usize);
    if (sel er.err) { ret err[fail.Fail].err{fail.refused(er.err)}; }
    val emitted: *bool = er.ok;
    fin { A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        included[i] = false;
        emitted[i]  = false;
        state[i]    = 0;
        i           = i + 1;
    }
    i = 0;
    for (i < p.topo_len) {
        included[p.topo[i]::u32] = true;
        i                        = i + 1;
    }
    i = 0;
    for (i < emit_root_count) {
        mark_emitted_deps(p, emit_roots[i], emitted);
        i = i + 1;
    }

    val tr: res[*module.ModuleId, A.Error] = A.allocate[module.ModuleId](p.alloc, project.module_count(p)::usize);
    if (sel tr.err) { ret err[fail.Fail].err{fail.refused(tr.err)}; }
    val ordered:     *module.ModuleId = tr.ok;
    var ordered_len: u32              = 0;
    var handed:      bool             = false;
    fin {
        if (!handed) { A.deallocate[module.ModuleId](p.alloc, ordered, project.module_count(p)::usize); }
    }
    i = 0;
    for (i < p.topo_len) {
        val mid: module.ModuleId = p.topo[i];
        if (!emitted[mid::u32]) {
            i = i + 1;
            cnt;
        }
        val vr: err[fail.Fail] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (sel vr.err) { ret vr; }
        i = i + 1;
    }
    i = 0;
    for (i < p.topo_len) {
        val mid: module.ModuleId = p.topo[i];
        if (emitted[mid::u32]) {
            i = i + 1;
            cnt;
        }
        val vr: err[fail.Fail] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (sel vr.err) { ret vr; }
        i = i + 1;
    }

    if (p.topo != nil && p.topo_cap > 0) {
        A.deallocate[module.ModuleId](p.alloc, p.topo, p.topo_cap::usize);
    }
    p.topo     = ordered;
    handed     = true;
    p.topo_len = ordered_len;
    p.topo_cap = project.module_count(p);
    p.emit_len = 0;
    for (p.emit_len < p.topo_len && emitted[p.topo[p.emit_len]::u32]) {
        p.emit_len = p.emit_len + 1;
    }
    ret err[fail.Fail].ok{};
}

fun mark_emitted_deps(p: *project.Project, mid: module.ModuleId, emitted: *bool) {
    if (mid::u32 >= project.module_count(p) || emitted[mid::u32]) { ret; }
    emitted[mid::u32] = true;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: usize                = 0;
    for (i < m.load.deps.len) {
        mark_emitted_deps(p, fe_load.module_of(?p.loader, m.load.deps.data[i]), emitted);
        i = i + 1;
    }
}

fun topo_visit(p: *project.Project, mid: module.ModuleId, included: *bool, state: *u8,
    ordered: *module.ModuleId, ordered_len: *u32) err[fail.Fail] {
    if (mid::u32 >= project.module_count(p) || !included[mid::u32]) { ret err[fail.Fail].ok{}; }
    if (state[mid::u32] == 2)                                       { ret err[fail.Fail].ok{}; }
    if (state[mid::u32] == 1)                                       { ret err[fail.Fail].err{fail.message("circular module dependency through a module a union target tuple reached late")}; }
    state[mid::u32] = 1;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: usize                = 0;
    for (i < m.load.deps.len) {
        val vr: err[fail.Fail] = topo_visit(p, fe_load.module_of(?p.loader, m.load.deps.data[i]), included, state, ordered, ordered_len);
        if (sel vr.err) { ret vr; }
        i = i + 1;
    }
    state[mid::u32]       = 2;
    ordered[@ordered_len] = mid;
    @ordered_len          = @ordered_len + 1;
    ret err[fail.Fail].ok{};
}

fun topo_push(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[module.ModuleId](p.alloc, ?p.topo, ?p.topo_cap, p.topo_len::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    p.topo[p.topo_len] = mid;
    p.topo_len         = p.topo_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun register_module_asts(p: *project.Project) err[fail.Fail] {
    var roots: collections_vector.Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (lang_source.file_is_nil(m.file_id)) {
            i = i + 1;
            cnt;
        }
        var num: u32            = i;
        val rn:  err[fail.Fail] = query.set_input(?p.s.queries, ?frontend.MODULE_NUMBER, module.stable_index(m.stable_id)::u64, (?num)::*u8, 4);
        if (sel rn.err) { ret rn; }
        val saved: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots, query.QueryKey{kind: ?frontend.PARSE, key: lang_source.file_index(m.file_id)::u64});
        if (sel saved.err) { ret err[fail.Fail].err{fail.refused(saved.err)}; }
        i = i + 1;
    }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) { ret err[fail.Fail].err{begun.err}; }
    val operation: query.Operation = begun.ok;
    var result:    err[fail.Fail]  = err[fail.Fail].ok{};
    i = 0;
    for (i < project.module_count(p)) {
        if (lang_source.file_is_nil(project.module_at(p, i).file_id)) {
            i = i + 1;
            cnt;
        }
        val acquired: res[frontend.ParsedModule, fail.Fail] = acquire_parse_view(p, i::module.ModuleId);
        if (sel acquired.err) {
            result = err[fail.Fail].err{acquired.err};
            brk;
        }
        val m: *project.ModuleEntry = project.module_at(p, i);
        session.expire_views(p.s);
        val registered: err[fail.Fail] = module.register_module_identity(?p.s.modules, module.id(i), m.fqn, m.stable_id);
        if (sel registered.err) {
            result = err[fail.Fail].err{registered.err};
            brk;
        }
        i = i + 1;
    }
    val finished: err[fail.Fail] = frontend.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel finished.err) {
        var j: u32 = 0;
        for (j < i) {
            module.unregister_module_identity(?p.s.modules, module.id(j), project.module_at(p, j).stable_id);
            j = j + 1;
        }
        ret err[fail.Fail].err{finished.err};
    }
    ret err[fail.Fail].ok{};
}

pub fun acquire_loaded_parses(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        if (!lang_source.file_is_nil(project.module_at(p, i).file_id)) {
            val acquired: res[frontend.ParsedModule, fail.Fail] = acquire_parse_view(p, i::module.ModuleId);
            if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun collect_loaded_parses(p: *project.Project, primary: err[fail.Fail]) err[fail.Fail] {
    var roots: collections_vector.Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val file: lang_source.FileId = project.module_at(p, i).file_id;
        if (!lang_source.file_is_nil(file)) {
            val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots, query.QueryKey{kind: ?frontend.PARSE, key: lang_source.file_index(file)::u64});
            if (sel added.err) {
                diagnostic.note_lost(?p.diags);
                diagnostic.note_lost(?p.s.diags);
                if (sel primary.err) { ret primary; }
                ret err[fail.Fail].err{fail.refused(added.err)};
            }
        }
        i = i + 1;
    }
    val begun: res[query.Operation, fail.Fail] = frontend.begin_query_phase(p);
    if (sel begun.err) {
        if (sel primary.err) { ret primary; }
        ret err[fail.Fail].err{begun.err};
    }
    val operation: query.Operation = begun.ok;
    var result:    err[fail.Fail]  = primary;
    i = 0;
    for (i < project.module_count(p)) {
        if (!lang_source.file_is_nil(project.module_at(p, i).file_id)) {
            val acquired: res[frontend.ParsedModule, fail.Fail] = acquire_parse_view(p, i::module.ModuleId);
            if (sel acquired.err) {
                val result_ok: bool = sel result.ok;
                if (result_ok) { result = err[fail.Fail].err{acquired.err}; }
                brk;
            }
        }
        i = i + 1;
    }
    ret frontend.finish_query_phase(p, operation, roots.data, roots.len, result);
}
