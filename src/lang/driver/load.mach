pub val MACH_VERSION: str = version.MACH_VERSION;

pub val INITIAL_MODULE_CAP: u32 = 16;

val INITIAL_PUB_CAP:    u32 = 4;

val INITIAL_DEP_CAP:    u32 = 4;

pub fun entry_module_fqn(p: *project.Project, t: *project.TargetEntry) R.Result[intern.StrId, str] {
    val ep_opt: O.Option[str] = intern.lookup(?p.s.interner, t.entrypoint);
    if (O.is_none[str](ep_opt)) { ret R.err[intern.StrId, str]("entrypoint StrId not interned"); }
    val ep_text: str = O.unwrap[str](ep_opt);

    val id_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.id);
    if (O.is_none[str](id_opt)) { ret R.err[intern.StrId, str]("project id StrId not interned"); }

    ret compose_module_fqn(p.alloc, ?p.s.interner, O.unwrap[str](id_opt), ep_text);
}

pub fun compose_module_fqn(alloc: *A.Allocator, itn: *intern.Interner, id_text: str, rel_text: str) R.Result[intern.StrId, str] {
    val rel_stripped: View = strip_mach_suffix(rel_text);

    val id_len: usize = str_len(id_text);
    val total:  usize = id_len + 1 + rel_stripped.len;
    val r_buf: R.Result[*u8, str] = A.allocate[u8](alloc, total);
    if (R.is_err[*u8, str](r_buf)) { ret R.err[intern.StrId, str](R.unwrap_err[*u8, str](r_buf)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](r_buf);

    var k: usize = 0;
    var j: usize = 0;
    for (j < id_len) { buf[k] = id_text[j]; k = k + 1; j = j + 1; }
    buf[k] = '.';
    k = k + 1;
    j = 0;
    for (j < rel_stripped.len) {
        val c: u8 = rel_stripped.data[j];
        if (c == '/' || c == '\\') { buf[k] = '.'; }
        or                          { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }

    val r: R.Result[intern.StrId, str] = intern.intern_bytes(itn, buf::str, k);
    A.deallocate[u8](alloc, buf, total);
    ret r;
}

fun strip_mach_suffix(s: str) View {
    val suffix: str = ".mach";
    val s_len: usize = str_len(s);
    if (!str_ends_with(s, suffix)) { ret view(s::*char, s_len); }
    ret view(s::*char, s_len - str_len(suffix));
}

fun fqn_to_file_path(p: *project.Project, fqn: intern.StrId) R.Result[str, str] {
    val fqn_opt: O.Option[str] = intern.lookup(?p.s.interner, fqn);
    if (O.is_none[str](fqn_opt)) { ret R.err[str, str]("module FQN StrId not interned"); }
    val fqn_text: str = O.unwrap[str](fqn_opt);

    val fqn_len: usize = str_len(fqn_text);
    var head_end: usize = 0;
    for (head_end < fqn_len && fqn_text[head_end] != '.') {
        head_end = head_end + 1;
    }
    val head: View = view(fqn_text::*char, head_end);

    var tail_start: usize = head_end;
    if (tail_start < fqn_len && fqn_text[tail_start] == '.') {
        tail_start = tail_start + 1;
    }
    var tail: View = view(nil, 0);
    if (fqn_len - tail_start > 0) { tail = view(?fqn_text[tail_start], fqn_len - tail_start); }

    val pid_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.id);
    if (O.is_none[str](pid_opt)) { ret R.err[str, str]("project id StrId not interned"); }
    val proj_id_text: str = O.unwrap[str](pid_opt);

    val pr_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.project_root);
    if (O.is_none[str](pr_opt)) { ret R.err[str, str]("project_root StrId not interned"); }
    val project_root_text: str = O.unwrap[str](pr_opt);

    if (view_eq_str(head, proj_id_text)) {
        val sd_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.dir_src);
        if (O.is_none[str](sd_opt)) { ret R.err[str, str]("dir_src StrId not interned"); }
        val src_dir_text: str = O.unwrap[str](sd_opt);
        ret build_module_path(p.alloc, project_root_text, src_dir_text, tail);
    }

    var k: u32 = 0;
    for (k < p.config.dep_count) {
        val dep: *project.DepEntry = ?p.config.deps[k];

        val di_opt: O.Option[str] = intern.lookup(?p.s.interner, dep.project_id);
        if (O.is_none[str](di_opt)) { ret R.err[str, str]("dep project_id StrId not interned"); }
        val dep_id_text: str = O.unwrap[str](di_opt);

        if (view_eq_str(head, dep_id_text)) {
            val dr_opt: O.Option[str] = intern.lookup(?p.s.interner, dep.vendor_root);
            if (O.is_none[str](dr_opt)) { ret R.err[str, str]("dep vendor_root StrId not interned"); }
            val dep_root_text: str = O.unwrap[str](dr_opt);

            val ds_opt: O.Option[str] = intern.lookup(?p.s.interner, dep.project_dir_src);
            if (O.is_none[str](ds_opt)) { ret R.err[str, str]("dep project_dir_src StrId not interned"); }
            val dep_src_text: str = O.unwrap[str](ds_opt);

            ret build_module_path(p.alloc, dep_root_text, dep_src_text, tail);
        }
        k = k + 1;
    }

    ret R.err[str, str]("no project or dep matches the head segment of the module path");
}

fun build_module_path(alloc: *A.Allocator, root: str, src_dir: str, dotted_tail: View) R.Result[str, str] {
    val root_len: usize = str_len(root);
    val src_len:  usize = str_len(src_dir);
    val total: usize = root_len + 1 + src_len + 1 + dotted_tail.len + 5 + 1;
    val r_buf: R.Result[*u8, str] = A.allocate[u8](alloc, total);
    if (R.is_err[*u8, str](r_buf)) { ret R.err[str, str](R.unwrap_err[*u8, str](r_buf)); }
    val buf: *u8 = R.unwrap_ok[*u8, str](r_buf);

    var k: usize = 0;
    var j: usize = 0;
    for (j < root_len) { buf[k] = root[j]; k = k + 1; j = j + 1; }
    if (k > 0 && buf[k - 1] != '/') { buf[k] = '/'; k = k + 1; }
    j = 0;
    for (j < src_len) { buf[k] = src_dir[j]; k = k + 1; j = j + 1; }
    buf[k] = '/'; k = k + 1;
    j = 0;
    for (j < dotted_tail.len) {
        val c: u8 = dotted_tail.data[j];
        if (c == '.') { buf[k] = '/'; }
        or            { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }
    buf[k]     = '.';
    buf[k + 1] = 'm';
    buf[k + 2] = 'a';
    buf[k + 3] = 'c';
    buf[k + 4] = 'h';
    k = k + 5;
    buf[k] = 0;

    val cr: R.Result[path.Path, str] = path.clean(alloc, buf::str);
    A.deallocate[u8](alloc, buf, total);
    if (R.is_err[path.Path, str](cr)) { ret R.err[str, str](R.unwrap_err[path.Path, str](cr)); }
    ret R.ok[str, str](R.unwrap_ok[path.Path, str](cr));
}

pub fun diag_join3(s: *session.Session, a: str, b: str, c: str, fallback: str) str {
    val res_msg: R.Result[str, str] = format.sprint(s.alloc, "{}{}{}", a, b, c);
    if (R.is_err[str, str](res_msg)) { ret fallback; }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    val ir: R.Result[intern.StrId, str] = intern.intern(?s.interner, buf);
    str_free(s.alloc, buf);
    if (R.is_err[intern.StrId, str](ir)) { ret fallback; }

    val nm: O.Option[str] = intern.lookup(?s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret fallback;
}

pub fun diag_join_named(s: *session.Session, prefix: str, name_id: intern.StrId, suffix: str, fallback: str) str {
    val no: O.Option[str] = intern.lookup(?s.interner, name_id);
    if (O.is_none[str](no)) { ret fallback; }
    ret diag_join3(s, prefix, O.unwrap[str](no), suffix, fallback);
}

pub fun join_path(alloc: *A.Allocator, a: str, b: str) R.Result[str, str] {
    ret path.join(alloc, a, b);
}

fun ensure_load_status_capacity(p: *project.Project, needed: u32) R.Result[R.Void, str] {
    if (p.load_cap >= needed) { ret R.ok_void[str](); }
    var new_cap: u32 = p.load_cap;
    if (new_cap == 0) { new_cap = INITIAL_MODULE_CAP; }
    for (new_cap < needed) { new_cap = new_cap * 2; }

    if (p.load_status == nil) {
        val r: R.Result[*project.LoadStatus, str] = A.allocate[project.LoadStatus](p.alloc, new_cap::usize);
        if (R.is_err[*project.LoadStatus, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*project.LoadStatus, str](r)); }
        p.load_status = R.unwrap_ok[*project.LoadStatus, str](r);
    }
    or {
        val r: R.Result[*project.LoadStatus, str] = A.reallocate[project.LoadStatus](p.alloc, p.load_status, p.load_cap::usize, new_cap::usize);
        if (R.is_err[*project.LoadStatus, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*project.LoadStatus, str](r)); }
        p.load_status = R.unwrap_ok[*project.LoadStatus, str](r);
    }
    var i: u32 = p.load_cap;
    for (i < new_cap) { p.load_status[i] = project.LOAD_NEW; i = i + 1; }
    p.load_cap = new_cap;
    ret R.ok_void[str]();
}

fun mark_tuple_reachable(p: *project.Project, mid: session.ModuleId) R.Result[bool, str] {
    if (!p.union || p.union_tuple_count == 0) { ret R.ok[bool, str](false); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    if (m.tuple_reachable == nil) {
        val ar: R.Result[*bool, str] = A.allocate[bool](p.alloc, p.union_tuple_count::usize);
        if (R.is_err[*bool, str](ar)) { ret R.err[bool, str](R.unwrap_err[*bool, str](ar)); }
        m.tuple_reachable = R.unwrap_ok[*bool, str](ar);
        m.tuple_reach_count = p.union_tuple_count;
        var z: u32 = 0;
        for (z < m.tuple_reach_count) { m.tuple_reachable[z] = false; z = z + 1; }
    }
    var changed: bool = false;
    var ti: u32 = 0;
    for (ti < m.tuple_reach_count) {
        if ((p.union_tuple_filter == nil || p.union_tuple_filter[ti]) && !m.tuple_reachable[ti]) {
            m.tuple_reachable[ti] = true;
            changed = true;
        }
        ti = ti + 1;
    }
    ret R.ok[bool, str](changed);
}

pub fun dfs_load(p: *project.Project, fqn: intern.StrId) R.Result[session.ModuleId, str] {
    val existing_r: R.Result[*session.ModuleId, str] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?fqn);
    if (R.is_ok[*session.ModuleId, str](existing_r)) {
        val mid: session.ModuleId = @R.unwrap_ok[*session.ModuleId, str](existing_r);
        val changed_r: R.Result[bool, str] = mark_tuple_reachable(p, mid);
        if (R.is_err[bool, str](changed_r)) { ret R.err[session.ModuleId, str](R.unwrap_err[bool, str](changed_r)); }
        if (p.load_status[mid::u32] == project.LOAD_LOADING) {
            ret R.err[session.ModuleId, str](diag_join_named(p.s, "circular module dependency: '", fqn, "' is already being loaded", "circular module dependency"));
        }
        if (R.unwrap_ok[bool, str](changed_r)) { p.modules[mid::u32].load_outcome = comptime.GATE_DEFERRED; }
        ret R.ok[session.ModuleId, str](mid);
    }

    val mid_r: R.Result[session.ModuleId, str] = register_module_slot(p, fqn);
    if (R.is_err[session.ModuleId, str](mid_r)) { ret mid_r; }
    val mid: session.ModuleId = R.unwrap_ok[session.ModuleId, str](mid_r);

    val changed_r: R.Result[bool, str] = mark_tuple_reachable(p, mid);
    if (R.is_err[bool, str](changed_r)) { ret R.err[session.ModuleId, str](R.unwrap_err[bool, str](changed_r)); }

    val t_load: ctime.Time = readout.item_begin(p.events);
    val parse_r: R.Result[R.Void, str] = parse_module(p, mid, fqn);
    if (R.is_err[R.Void, str](parse_r)) {
        ret R.err[session.ModuleId, str](R.unwrap_err[R.Void, str](parse_r));
    }
    readout.item(p.events, readout.PH_LOAD, project.fqn_name(p, fqn), t_load);

    val saved_gated: bool = p.in_gated_decl_walk;
    p.in_gated_decl_walk = false;
    val walk_r: R.Result[comptime.GateOutcome, str] = walk_module_for_load(p, mid);
    p.in_gated_decl_walk = saved_gated;
    if (R.is_err[comptime.GateOutcome, str](walk_r)) {
        ret R.err[session.ModuleId, str](R.unwrap_err[comptime.GateOutcome, str](walk_r));
    }
    (?p.modules[mid::u32]).load_outcome = R.unwrap_ok[comptime.GateOutcome, str](walk_r);

    p.load_status[mid::u32] = project.LOAD_DONE;

    if ((?p.modules[mid::u32]).target_gated) {
        ret R.ok[session.ModuleId, str](mid);
    }

    val topo_r: R.Result[R.Void, str] = topo_push(p, mid);
    if (R.is_err[R.Void, str](topo_r)) { ret R.err[session.ModuleId, str](R.unwrap_err[R.Void, str](topo_r)); }

    ret R.ok[session.ModuleId, str](mid);
}

fun module_context(p: *project.Project, req: *request.BuildRequest) R.Result[comptime.ComptimeCtx, str] {
    if (p == nil || req == nil || p.target_entry == nil) {
        ret R.err[comptime.ComptimeCtx, str]("driver: module context requires an opened project and request");
    }

    var build_mode_id: u32 = comptime.MODE_DEBUG;
    if (request.release(req)) { build_mode_id = comptime.MODE_RELEASE; }
    var build_pie: u32 = 0;
    if (req.pie) { build_pie = 1; }

    var ctx: comptime.ComptimeCtx = comptime.init(
        p.alloc,
        p.target.os_id,
        p.target.arch_id,
        p.target.abi_id,
        build_mode_id,
        build_pie,
        p.target.isa.pointer_width,
        p.target.model.vector_bits,
        p.target.model.has_float,
        p.compiler_name,
        p.compiler_ver
    );
    comptime.set_diagnostics(?ctx, ?p.s.diags);
    comptime.set_target_defs(?ctx, p.target.isa.defs);
    comptime.set_va_list(?ctx, p.target.va_list_size, p.target.va_list_align);
    comptime.set_union_build(?ctx, p.union);
    comptime.set_build_context(?ctx,
        p.config.id, p.config.version, p.config.name, p.config.description,
        p.target_entry.os_name, p.target_entry.isa_name, p.target_entry.abi_name,
        p.target_entry.platform_name,
        p.config.bin_name);

    val bd_r: R.Result[R.Void, str] = bind_defines(p, ?ctx);
    if (R.is_err[R.Void, str](bd_r)) {
        val message: str = R.unwrap_err[R.Void, str](bd_r);
        comptime.dnit(?ctx);
        ret R.err[comptime.ComptimeCtx, str](message);
    }
    ret R.ok[comptime.ComptimeCtx, str](ctx);
}

fun register_module_slot(p: *project.Project, fqn: intern.StrId) R.Result[session.ModuleId, str] {
    val mid: session.ModuleId = p.module_len;

    if (p.module_len == p.module_cap) {
        var new_cap: u32 = p.module_cap;
        if (new_cap == 0) { new_cap = INITIAL_MODULE_CAP; }
        or                { new_cap = new_cap * 2; }
        if (p.modules == nil) {
            val r: R.Result[*project.ModuleEntry, str] = A.allocate[project.ModuleEntry](p.alloc, new_cap::usize);
            if (R.is_err[*project.ModuleEntry, str](r)) { ret R.err[session.ModuleId, str](R.unwrap_err[*project.ModuleEntry, str](r)); }
            p.modules = R.unwrap_ok[*project.ModuleEntry, str](r);
        }
        or {
            val r: R.Result[*project.ModuleEntry, str] = A.reallocate[project.ModuleEntry](p.alloc, p.modules, p.module_cap::usize, new_cap::usize);
            if (R.is_err[*project.ModuleEntry, str](r)) { ret R.err[session.ModuleId, str](R.unwrap_err[*project.ModuleEntry, str](r)); }
            p.modules = R.unwrap_ok[*project.ModuleEntry, str](r);
        }
        p.module_cap = new_cap;
    }

    val cap_r: R.Result[R.Void, str] = ensure_load_status_capacity(p, mid::u32 + 1);
    if (R.is_err[R.Void, str](cap_r)) { ret R.err[session.ModuleId, str](R.unwrap_err[R.Void, str](cap_r)); }

    val sid_r: R.Result[session.StableModuleId, str] = session.stable_module_id(p.s, fqn);
    if (R.is_err[session.StableModuleId, str](sid_r)) { ret R.err[session.ModuleId, str](R.unwrap_err[session.StableModuleId, str](sid_r)); }

    val ctx_r: R.Result[comptime.ComptimeCtx, str] = module_context(p, ?p.req);
    if (R.is_err[comptime.ComptimeCtx, str](ctx_r)) {
        ret R.err[session.ModuleId, str](R.unwrap_err[comptime.ComptimeCtx, str](ctx_r));
    }

    var m: project.ModuleEntry;
    m.fqn               = fqn;
    m.file_id           = 0;
    m.stable_id         = R.unwrap_ok[session.StableModuleId, str](sid_r);
    m.a                 = nil;
    m.parse_status      = fail.accepted();
    m.load_status       = fail.accepted();
    m.gate_status       = fail.accepted();
    m.ctx               = R.unwrap_ok[comptime.ComptimeCtx, str](ctx_r);
    m.pub_consts        = nil;
    m.pub_const_count   = 0;
    m.pub_const_cap     = 0;
    m.mod_refs          = nil;
    m.mod_ref_count     = 0;
    m.mod_ref_cap       = 0;
    m.const_imports     = nil;
    m.const_import_count = 0;
    m.const_import_cap   = 0;
    m.deps              = nil;
    m.dep_count         = 0;
    m.dep_cap           = 0;
    m.resolve_result    = nil;
    m.resolved          = false;
    m.gate_result       = nil;
    m.tuple_gates       = nil;
    m.tuple_gate_count  = 0;
    m.tuple_reachable   = nil;
    m.tuple_reach_count = 0;
    m.sema_result       = nil;
    m.ir_module         = nil;
    m.object_image      = nil;
    m.staged_ir         = nil;
    m.staged_home       = nil;
    m.staged_image      = nil;
    m.target_gated      = false;
    m.load_outcome      = comptime.GATE_ACTIVE;
    m.load_walk_count   = 0;

    val ins_r: R.Result[bool, str] = map.insert[intern.StrId, session.ModuleId](?p.by_fqn, fqn, mid);
    if (R.is_err[bool, str](ins_r)) {
        comptime.dnit(?m.ctx);
        ret R.err[session.ModuleId, str](R.unwrap_err[bool, str](ins_r));
    }

    p.modules[mid::u32] = m;
    p.module_len = p.module_len + 1;
    p.load_status[mid::u32] = project.LOAD_LOADING;
    ret R.ok[session.ModuleId, str](mid);
}

fun bind_defines(p: *project.Project, ctx: *comptime.ComptimeCtx) R.Result[R.Void, str] {
    if (p.config.define_count == 0) { ret R.ok_void[str](); }
    var i: u32 = 0;
    for (i < p.config.define_count) {
        val s_opt: O.Option[str] = intern.lookup(?p.s.interner, p.config.defines[i]);
        if (O.is_none[str](s_opt)) { ret R.err[R.Void, str]("define StrId not interned"); }
        val r: R.Result[R.Void, str] = bind_one_define(p, ctx, O.unwrap[str](s_opt));
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun bind_one_define(p: *project.Project, ctx: *comptime.ComptimeCtx, s: str) R.Result[R.Void, str] {
    val n: usize = str_len(s);
    var eq: usize = n;
    var k: usize = 0;
    for (k < n) {
        if (s[k] == '=') { eq = k; brk; }
        k = k + 1;
    }
    if (eq == 0) { ret R.err[R.Void, str](diag_join3(p.s, "mach.toml: define '", s, "' has an empty name", "mach.toml: a define has an empty name")); }

    val name_r: R.Result[intern.StrId, str] = intern.intern_bytes(?p.s.interner, s, eq);
    if (R.is_err[intern.StrId, str](name_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](name_r)); }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](name_r);

    var v: comptime.CTValue;
    v.int_unsigned = false;
    v.int_width    = 0;

    if (eq == n) {
        v = comptime.ct_u8(1);
    }
    or {
        val vstart: usize = eq + 1;
        val vlen:   usize = n - vstart;
        var iv: i64 = 0;
        if (parse_define_int(s, vstart, vlen, ?iv)) {
            if (iv == 0 || iv == 1) { v = comptime.ct_u8(iv::u8); }
            or { v.kind = comptime.CT_KIND_INT; v.data.i = iv; }
        }
        or {
            val vr: R.Result[intern.StrId, str] = intern.intern_bytes(?p.s.interner, (s::usize + vstart)::str, vlen);
            if (R.is_err[intern.StrId, str](vr)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](vr)); }
            v.kind = comptime.CT_KIND_STR; v.data.s = R.unwrap_ok[intern.StrId, str](vr);
        }
    }

    ret comptime.bind_define(ctx, name_id, v);
}

fun parse_define_int(s: str, start: usize, len: usize, out: *i64) bool {
    if (len == 0) { ret false; }
    var i: usize = 0;
    var neg: bool = false;
    if (s[start] == '-') {
        if (len == 1) { ret false; }
        neg = true;
        i = 1;
    }
    var base: u64 = 10;
    if (len - i >= 2 && s[start + i] == '0') {
        val c1: u8 = s[start + i + 1];
        if (c1 == 'x') { base = 16; i = i + 2; }
        or (c1 == 'b') { base = 2;  i = i + 2; }
        or (c1 == 'o') { base = 8;  i = i + 2; }
    }

    var value:     u64 = 0;
    var saw_digit: bool = false;
    val u64_max:   u64 = 0xFFFFFFFFFFFFFFFF;
    for (i < len) {
        val c: u8 = s[start + i];
        if (c == '_') { i = i + 1; cnt; }
        var digit: i64 = 0 - 1;
        if      (c >= '0' && c <= '9')       { digit = (c - '0')::i64; }
        or      (c >= 'a' && c <= 'f')       { digit = (c - 'a')::i64 + 10; }
        or      (c >= 'A' && c <= 'F')       { digit = (c - 'A')::i64 + 10; }
        if (digit < 0 || digit::u64 >= base) { ret false; }
        val d: u64 = digit::u64;
        if (value > (u64_max - d) / base) { ret false; }
        value = value * base + d;
        saw_digit = true;
        i = i + 1;
    }
    if (!saw_digit) { ret false; }

    val signed_max: u64 = 0x7FFFFFFFFFFFFFFF;
    if (neg) {
        if (value > signed_max + 1) { ret false; }
        @out = 0 - value::i64;
        ret true;
    }
    if (value > signed_max) { ret false; }
    @out = value::i64;
    ret true;
}

fun parse_module(p: *project.Project, mid: session.ModuleId, fqn: intern.StrId) R.Result[R.Void, str] {
    val path_r: R.Result[str, str] = fqn_to_file_path(p, fqn);
    if (R.is_err[str, str](path_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](path_r)); }
    val file_path: str = R.unwrap_ok[str, str](path_r);

    var text: str = nil;
    var text_owned: bool = false;
    val ov: O.Option[str] = session.overlay_get(p.s, file_path);
    if (O.is_some[str](ov)) {
        text = O.unwrap[str](ov);
    }
    or {
        val text_r: R.Result[str, str] = fs.read_string(p.alloc, file_path);
        if (R.is_err[str, str](text_r)) {
            str_free(p.alloc, file_path);
            ret R.err[R.Void, str](R.unwrap_err[str, str](text_r));
        }
        text = R.unwrap_ok[str, str](text_r);
        text_owned = true;
    }

    val fid_r: R.Result[src.FileId, str] = session.load_source(p.s, file_path, text);
    str_free(p.alloc, file_path);
    if (text_owned) { str_free(p.alloc, text); }
    if (R.is_err[src.FileId, str](fid_r)) { ret R.err[R.Void, str](R.unwrap_err[src.FileId, str](fid_r)); }
    val file_id: src.FileId = R.unwrap_ok[src.FileId, str](fid_r);

    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    m.file_id = file_id;

    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_PARSE, file_id::u64);
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) {
        val f: fail.Fail = R.unwrap_err[*query.QueryEntry, fail.Fail](e_r);
        if (f.kind == fail.REPORTED) { fail.reject(?m.parse_status); }
        or { fail.internal(?m.parse_status, f.message); }
        ret R.err[R.Void, str](f.message);
    }
    val a: *ast.Ast = ast_handle_decode(R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r));
    if (a == nil) { ret R.err[R.Void, str]("Q_PARSE produced no AST handle"); }
    m.a = a;
    m.parse_status = (R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r).value::ptr::*ParsedModule).status;
    ret comptime.prepare_gates(?m.ctx, a.expr_len::u32, a.decl_len::u32);
}

pub fun q_parse_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val db: *query.QueryDb = ?p.s.queries;
    val s: *session.Session = p.s;
    val file_id: src.FileId = key::u32;

    val rd: R.Result[R.Void, str] = query.record_dep(db, query.Q_PARSE, key, query.Q_FILE_TEXT, key);
    if (R.is_err[R.Void, str](rd)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rd))); }

    val file_opt: O.Option[*src.SourceFile] = src.get(?s.sources, file_id);
    if (O.is_none[*src.SourceFile](file_opt)) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_PARSE: FileId not registered with the session")); }
    val file: *src.SourceFile = O.unwrap[*src.SourceFile](file_opt);

    val tok_r: R.Result[lexer.TokenStream, str] = lexer.tokenize(file.text, alloc, file_id);
    if (R.is_err[lexer.TokenStream, str](tok_r)) { ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[lexer.TokenStream, str](tok_r))); }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tok_r);

    val ar: R.Result[*ast.Ast, str] = A.allocate[ast.Ast](alloc, 1::usize);
    if (R.is_err[*ast.Ast, str](ar)) {
        lexer.dnit(?stream, alloc);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[*ast.Ast, str](ar)));
    }
    val a: *ast.Ast = R.unwrap_ok[*ast.Ast, str](ar);
    a[0] = ast.init(alloc, file_id);

    val le_r: R.Result[R.Void, str] = lexer.emit_diagnostics(?stream, ?s.diags);
    if (R.is_err[R.Void, str](le_r)) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        lexer.dnit(?stream, alloc);
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](le_r)));
    }
    val parse_r: R.Result[fail.PhaseStatus, state.ParseFail] = parser.parse(?stream, a, ?s.diags);
    lexer.dnit(?stream, alloc);
    if (R.is_err[fail.PhaseStatus, state.ParseFail](parse_r)) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        val f: state.ParseFail = R.unwrap_err[fail.PhaseStatus, state.ParseFail](parse_r);
        ret R.err[query.QueryOutput, fail.Fail](state.failure(f));
    }

    ret fail.lift[query.QueryOutput](ast_handle_encode(alloc, a, R.unwrap_ok[fail.PhaseStatus, state.ParseFail](parse_r)));
}

rec ParsedModule {
    a: *ast.Ast;
    status: fail.PhaseStatus;
}

pub fun q_parse_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ParsedModule)) { ret; }
    val a: *ast.Ast = (value::ptr::*ParsedModule).a;
    if (a == nil) { ret; }
    ast.dnit(a);
    A.deallocate[ast.Ast](alloc, a, 1::usize);
}

fun ast_handle_encode(alloc: *A.Allocator, a: *ast.Ast, status: fail.PhaseStatus) R.Result[query.QueryOutput, str] {
    val n: u32 = $size_of(ParsedModule)::u32;
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, n::usize);
    if (R.is_err[*u8, str](rb)) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        ret R.err[query.QueryOutput, str](R.unwrap_err[*u8, str](rb));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    val slot: *ParsedModule = buf::ptr::*ParsedModule;
    slot.a = a;
    slot.status = status;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret R.ok[query.QueryOutput, str](out);
}

fun ast_handle_decode(e: *query.QueryEntry) *ast.Ast {
    if (e.value == nil || e.value_len::usize < $size_of(ParsedModule)) { ret nil; }
    ret (e.value::ptr::*ParsedModule).a;
}

pub fun q_exports_compute(p: *project.Project, key: u64, alloc: *A.Allocator) R.Result[query.QueryOutput, fail.Fail] {
    val e_r: R.Result[*query.QueryEntry, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, key);
    if (R.is_err[*query.QueryEntry, fail.Fail](e_r)) { ret R.err[query.QueryOutput, fail.Fail](R.unwrap_err[*query.QueryEntry, fail.Fail](e_r)); }
    val rr: *resolve.ResolveResult = dq.resolve_handle_decode(R.unwrap_ok[*query.QueryEntry, fail.Fail](e_r));
    if (rr == nil) { ret R.err[query.QueryOutput, fail.Fail](fail.message("Q_EXPORTS: module has no resolve result")); }

    var fb: dq.FpBuf;
    fb.alloc = alloc;
    fb.buf   = nil;
    fb.len   = 0;
    fb.cap   = 0;

    val wr: R.Result[R.Void, str] = fp_pub_surface(?fb, rr);
    if (R.is_err[R.Void, str](wr)) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](alloc, fb.buf, fb.cap::usize); }
        ret R.err[query.QueryOutput, fail.Fail](fail.message(R.unwrap_err[R.Void, str](wr)));
    }

    ret fail.lift[query.QueryOutput](dq.fp_take(?fb));
}

fun fp_pub_surface(fb: *dq.FpBuf, rr: *resolve.ResolveResult) R.Result[R.Void, str] {
    val pc: R.Result[R.Void, str] = dq.fp_u32(fb, rr.pub_count);
    if (R.is_err[R.Void, str](pc)) { ret pc; }
    if (rr.symbols == nil)       { ret R.ok_void[str](); }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val sym: *resolve.Symbol = ?rr.symbols[i];
        val rk: R.Result[R.Void, str] = dq.fp_u8(fb, sym.kind::u8);             if (R.is_err[R.Void, str](rk)) { ret rk; }
        val rn: R.Result[R.Void, str] = dq.fp_u32(fb, sym.name::u32);          if (R.is_err[R.Void, str](rn)) { ret rn; }
        val rdl: R.Result[R.Void, str] = dq.fp_u32(fb, sym.decl::u32);         if (R.is_err[R.Void, str](rdl)) { ret rdl; }
        val ro: R.Result[R.Void, str] = dq.fp_u32(fb, sym.origin_stable::u32); if (R.is_err[R.Void, str](ro)) { ret ro; }
        var slot_fp: u32 = sym.slot;
        if (sym.kind == resolve.SYM_USE) { slot_fp = sym.slot_stable::u32; }
        val rs: R.Result[R.Void, str] = dq.fp_u32(fb, slot_fp);                if (R.is_err[R.Void, str](rs)) { ret rs; }
        i = i + 1;
    }

    val rl: R.Result[R.Void, str] = dq.fp_u32(fb, rr.pub_const_fp_len);
    if (R.is_err[R.Void, str](rl)) { ret rl; }
    var b: u32 = 0;
    for (b < rr.pub_const_fp_len) {
        val rb: R.Result[R.Void, str] = dq.fp_u8(fb, rr.pub_const_fp[b]);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        b = b + 1;
    }
    ret R.ok_void[str]();
}

fun walk_module_for_load(p: *project.Project, mid: session.ModuleId) R.Result[comptime.GateOutcome, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val m_opt: O.Option[*module.Module] = ast.get_module(m.a, m.a.root_module);
    if (O.is_none[*module.Module](m_opt)) { ret R.err[comptime.GateOutcome, str]("module root not set on Ast"); }
    val mod_node: *module.Module = O.unwrap[*module.Module](m_opt);
    val r: R.Result[comptime.GateOutcome, str] = walk_decl_list_for_load(p, mid, mod_node.decls_start, mod_node.decls_len);
    (?p.modules[mid::u32]).load_walk_count = (?p.modules[mid::u32]).load_walk_count + 1;
    ret r;
}

pub fun resume_deferred_gates(p: *project.Project) R.Result[bool, str] {
    var changed: bool = false;
    var i: u32 = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        var m: *project.ModuleEntry = ?p.modules[mid::u32];
        if (m.load_outcome == comptime.GATE_DEFERRED) {
            val before_modules: u32 = p.module_len;
            val saved_filter: *bool = p.union_tuple_filter;
            if (p.union) { p.union_tuple_filter = m.tuple_reachable; }
            val saved_gated: bool = p.in_gated_decl_walk;
            p.in_gated_decl_walk = false;
            val wr: R.Result[comptime.GateOutcome, str] = walk_module_for_load(p, mid);
            p.in_gated_decl_walk = saved_gated;
            p.union_tuple_filter = saved_filter;
            if (R.is_err[comptime.GateOutcome, str](wr)) {
                ret R.err[bool, str](R.unwrap_err[comptime.GateOutcome, str](wr));
            }
            val outcome: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](wr);
            m = ?p.modules[mid::u32];
            m.load_outcome = outcome;
            if (outcome != comptime.GATE_DEFERRED || p.module_len != before_modules) { changed = true; }
        }
        i = i + 1;
    }
    ret R.ok[bool, str](changed);
}

pub fun deferred_gate_count(p: *project.Project) u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    for (i < p.topo_len) {
        if (p.modules[p.topo[i]::u32].load_outcome == comptime.GATE_DEFERRED) {
            count = count + 1;
        }
        i = i + 1;
    }
    ret count;
}

fun walk_decl_list_for_load(p: *project.Project, mid: session.ModuleId, start: u32, len: u32) R.Result[comptime.GateOutcome, str] {
    var deferred: bool = false;
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = (?p.modules[mid::u32]).a.decl_ids[start + i];
        val r: R.Result[comptime.GateOutcome, str] = walk_one_decl_for_load(p, mid, did);
        if (R.is_err[comptime.GateOutcome, str](r)) { ret r; }
        val outcome: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](r);
        if (outcome == comptime.GATE_DEFERRED) { deferred = true; }
        or (outcome != comptime.GATE_ACTIVE)   { ret r; }
        i = i + 1;
    }
    if (deferred) { ret R.ok[comptime.GateOutcome, str](comptime.GATE_DEFERRED); }
    ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
}

fun walk_one_decl_for_load(p: *project.Project, mid: session.ModuleId, did: id.DeclId) R.Result[comptime.GateOutcome, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(m.a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret R.err[comptime.GateOutcome, str]("DeclId out of range during walk"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret walk_comptime_if_for_load(p, mid, did, ?d.data.comptime_if);
    }
    if (comptime.load_walked(?m.ctx, did)
        && !(p.union && (d.kind == decl.DECL_KIND_USE || d.kind == decl.DECL_KIND_FWD))) {
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
    }
    if (d.kind == decl.DECL_KIND_USE) {
        val r: R.Result[R.Void, str] = walk_use_for_load(p, mid, ?d.data.use_);
        ret finish_decl_walk(p, mid, did, r);
    }
    if (d.kind == decl.DECL_KIND_FWD) {
        val r: R.Result[R.Void, str] = walk_fwd_for_load(p, mid, ?d.data.fwd_);
        ret finish_decl_walk(p, mid, did, r);
    }
    if (d.kind == decl.DECL_KIND_VAL) {
        val r: R.Result[R.Void, str] = register_val_for_load(p, mid, d, did);
        ret finish_decl_walk(p, mid, did, r);
    }
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) {
        val r: R.Result[R.Void, str] = walk_comptime_attr_for_load(p, mid, ?d.data.comptime_attr);
        ret finish_decl_walk(p, mid, did, r);
    }
    comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
    ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
}

fun finish_decl_walk(p: *project.Project, mid: session.ModuleId, did: id.DeclId, r: R.Result[R.Void, str]) R.Result[comptime.GateOutcome, str] {
    if (R.is_err[R.Void, str](r)) {
        ret R.err[comptime.GateOutcome, str](R.unwrap_err[R.Void, str](r));
    }
    comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
    ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
}

fun walk_comptime_attr_for_load(p: *project.Project, mid: session.ModuleId, ca: *decl.DeclComptimeAttr) R.Result[R.Void, str] {
    if (!p.loading_orphans)       { ret R.ok_void[str](); }
    if (ca.target == id.EXPR_NIL) { ret R.ok_void[str](); }

    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.err[R.Void, str]("module file_id not found in SourceMap"); }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    if (comptime.is_error_call(m.a, source, ca.target)) {
        m.target_gated = true;
    }
    ret R.ok_void[str]();
}

fun propagate_target_gate(p: *project.Project, mid: session.ModuleId, dep_mid: session.ModuleId) bool {
    if (!p.loading_orphans)                       { ret false; }
    if (!(?p.modules[dep_mid::u32]).target_gated) { ret false; }
    (?p.modules[mid::u32]).target_gated = true;
    ret true;
}

fun walk_comptime_if_for_load(p: *project.Project, mid: session.ModuleId, did: id.DeclId, ci: *decl.DeclComptimeIf) R.Result[comptime.GateOutcome, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    if (!p.union && comptime.load_walked(?m.ctx, did)) { ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE); }
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.err[comptime.GateOutcome, str]("module file_id not found in SourceMap"); }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    val emit_diag: bool = !comptime.comptime_if_declares_nothing(m.a, ci.branches_start, ci.branches_len);

    if (!emit_diag && !p.loading_orphans) {
        comptime.mark_load_walked(?m.ctx, did);
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
    }

    if (p.union) { ret walk_comptime_if_union(p, mid, did, ci, source, emit_diag); }

    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
        val take_r: R.Result[comptime.GateOutcome, str] = comptime_branch_active_load(p, mid, br, source, emit_diag, true);
        if (R.is_err[comptime.GateOutcome, str](take_r)) { ret take_r; }
        val outcome: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](take_r);
        if (outcome == comptime.GATE_DEFERRED) { ret take_r; }
        if (outcome == comptime.GATE_REJECTED || outcome == comptime.GATE_FAILED
         || outcome == comptime.GATE_AWAITING_LAYOUT) {
            comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
            ret take_r;
        }
        if (outcome == comptime.GATE_ACTIVE) {
            val saved_gated: bool = p.in_gated_decl_walk;
            p.in_gated_decl_walk = true;
            val wr: R.Result[comptime.GateOutcome, str] = walk_decl_list_for_load(p, mid, br.body_start, br.body_len);
            p.in_gated_decl_walk = saved_gated;
            if (R.is_err[comptime.GateOutcome, str](wr)) { ret wr; }
            val child: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](wr);
            if (child == comptime.GATE_DEFERRED) { ret wr; }
            comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
            ret wr;
        }
        bi = bi + 1;
    }
    comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
    ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
}

fun comptime_branch_active_load(p: *project.Project, mid: session.ModuleId, br: *decl.ComptimeBranch, source: str, emit_diag: bool, use_build_state: bool) R.Result[comptime.GateOutcome, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var terminal: bool = false;
    if (!(p.union && !use_build_state) && m.load_walk_count > 0) {
        val pending_r: R.Result[bool, str] = has_deferred_dependency(p, mid);
        if (R.is_err[bool, str](pending_r)) {
            ret R.err[comptime.GateOutcome, str](R.unwrap_err[bool, str](pending_r));
        }
        terminal = !R.unwrap_ok[bool, str](pending_r);
    }

    var lc: LoadMemberCtx;
    lc.p   = p;
    lc.mid = mid;
    val caps_r: R.Result[comptime.PhaseCapabilities[LoadMemberCtx], str] =
        comptime.loading_capabilities[LoadMemberCtx](resolve_module_member_const_load);
    if (R.is_err[comptime.PhaseCapabilities[LoadMemberCtx], str](caps_r)) {
        ret R.err[comptime.GateOutcome, str](R.unwrap_err[comptime.PhaseCapabilities[LoadMemberCtx], str](caps_r));
    }
    val vr: R.Result[comptime.GateVerdict, str] = comptime.evaluate_gate[LoadMemberCtx](
        ?m.ctx, ?lc, R.unwrap_ok[comptime.PhaseCapabilities[LoadMemberCtx], str](caps_r),
        m.a, source, br.cond, ?p.s.interner,
        comptime.GATE_SCOPE_DECL, use_build_state, terminal);
    if (R.is_err[comptime.GateVerdict, str](vr)) {
        ret R.err[comptime.GateOutcome, str](R.unwrap_err[comptime.GateVerdict, str](vr));
    }
    val v: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](vr);

    if (v.outcome == comptime.GATE_ACTIVE || v.outcome == comptime.GATE_INACTIVE) {
        ret R.ok[comptime.GateOutcome, str](v.outcome);
    }
    if (v.outcome == comptime.GATE_AWAITING_LAYOUT) {
        if (!emit_diag) { ret R.ok[comptime.GateOutcome, str](comptime.GATE_AWAITING_LAYOUT); }
        fail.reject(?m.load_status);
        val committed_r: R.Result[bool, str] = diagnostic.gate_error(?p.s.gate_diags, ?p.s.diags, ?p.s.interner, m.file_id, v.span, v.message);
        if (R.is_err[bool, str](committed_r)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[bool, str](committed_r)); }
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_FAILED);
    }
    if (v.outcome == comptime.GATE_REJECTED) {
        if (emit_diag) { fail.reject(?m.load_status); }
        if (emit_diag && str_len(v.message) > 0) {
            fail.reject(?m.load_status);
            val committed_r: R.Result[bool, str] = diagnostic.gate_error(?p.s.gate_diags, ?p.s.diags, ?p.s.interner, m.file_id, v.span, v.message);
            if (R.is_err[bool, str](committed_r)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[bool, str](committed_r)); }
        }
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_REJECTED);
    }
    if (v.outcome == comptime.GATE_FAILED) {
        if (emit_diag && v.depends != intern.STR_NIL) {
            fail.reject(?m.load_status);
            val committed_r: R.Result[bool, str] = diagnostic.gate_error_named(?p.s.gate_diags, ?p.s.diags, ?p.s.interner, m.file_id, v.span, v.depends, v.message);
            if (R.is_err[bool, str](committed_r)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[bool, str](committed_r)); }
        }
        or (emit_diag) {
            fail.reject(?m.load_status);
            val committed_r: R.Result[bool, str] = diagnostic.gate_error(?p.s.gate_diags, ?p.s.diags, ?p.s.interner, m.file_id, v.span, v.message);
            if (R.is_err[bool, str](committed_r)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[bool, str](committed_r)); }
        }
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_FAILED);
    }
    ret R.ok[comptime.GateOutcome, str](comptime.GATE_DEFERRED);
}

fun has_deferred_dependency(p: *project.Project, mid: session.ModuleId) R.Result[bool, str] {
    if (p.module_len == 0) { ret R.ok[bool, str](false); }
    val vr: R.Result[*bool, str] = A.allocate[bool](p.alloc, p.module_len::usize);
    if (R.is_err[*bool, str](vr)) { ret R.err[bool, str](R.unwrap_err[*bool, str](vr)); }
    val visited: *bool = R.unwrap_ok[*bool, str](vr);
    var i: u32 = 0;
    for (i < p.module_len) { visited[i] = false; i = i + 1; }
    val pending: bool = deferred_dependency_visit(p, mid, visited);
    A.deallocate[bool](p.alloc, visited, p.module_len::usize);
    ret R.ok[bool, str](pending);
}

fun deferred_dependency_visit(p: *project.Project, mid: session.ModuleId, visited: *bool) bool {
    if (mid::u32 >= p.module_len || visited[mid::u32]) { ret false; }
    visited[mid::u32] = true;
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < m.dep_count) {
        val dep: session.ModuleId = m.deps[i];
        if (dep::u32 < p.module_len && p.modules[dep::u32].load_outcome == comptime.GATE_DEFERRED) { ret true; }
        if (deferred_dependency_visit(p, dep, visited)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun first_active_branch(p: *project.Project, mid: session.ModuleId, ci: *decl.DeclComptimeIf, source: str, emit_diag: bool, use_build_state: bool) R.Result[comptime.GateSelection, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
        val a_r: R.Result[comptime.GateOutcome, str] = comptime_branch_active_load(p, mid, br, source, emit_diag, use_build_state);
        if (R.is_err[comptime.GateOutcome, str](a_r)) { ret R.err[comptime.GateSelection, str](R.unwrap_err[comptime.GateOutcome, str](a_r)); }
        val outcome: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](a_r);
        if (outcome != comptime.GATE_INACTIVE) {
            ret R.ok[comptime.GateSelection, str](comptime.gate_selection(outcome, bi));
        }
        bi = bi + 1;
    }
    ret R.ok[comptime.GateSelection, str](comptime.gate_selection(comptime.GATE_INACTIVE, ci.branches_len));
}

fun walk_comptime_if_union(p: *project.Project, mid: session.ModuleId, did: id.DeclId, ci: *decl.DeclComptimeIf, source: str, emit_diag: bool) R.Result[comptime.GateOutcome, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val n: u32 = ci.branches_len;
    if (n == 0) {
        comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
    }

    val tk_r: R.Result[*bool, str] = A.allocate[bool](p.alloc, n::usize);
    if (R.is_err[*bool, str](tk_r)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[*bool, str](tk_r)); }
    val taken: *bool = R.unwrap_ok[*bool, str](tk_r);
    var z: u32 = 0;
    for (z < n) { taken[z] = false; z = z + 1; }

    val branch_count: usize = n::usize;
    val tuple_count: usize = p.union_tuple_count::usize;
    val usize_max: usize = ~(0::usize);
    if (tuple_count != 0 && branch_count > usize_max / tuple_count) {
        A.deallocate[bool](p.alloc, taken, n::usize);
        ret R.err[comptime.GateOutcome, str]("union gate coverage size overflow");
    }
    val coverage_len: usize = branch_count * tuple_count;
    val cr: R.Result[*bool, str] = A.allocate[bool](p.alloc, coverage_len);
    if (R.is_err[*bool, str](cr)) {
        A.deallocate[bool](p.alloc, taken, n::usize);
        ret R.err[comptime.GateOutcome, str](R.unwrap_err[*bool, str](cr));
    }
    val coverage: *bool = R.unwrap_ok[*bool, str](cr);
    var zi: usize = 0;
    for (zi < coverage_len) { coverage[zi] = false; zi = zi + 1; }

    val s_os_id: u32 = m.ctx.env.target_os_id;
    val s_arch:  u32 = m.ctx.env.target_arch_id;
    val s_abi_id: u32 = m.ctx.env.target_abi_id;
    val s_pw:    u32 = m.ctx.env.pointer_width;
    val s_vb:    u32 = m.ctx.env.vector_bits;
    val s_has_float: bool = m.ctx.env.has_float;
    val s_defs: *isa.TargetDefs = m.ctx.env.target_defs;
    val s_va_size: u32 = m.ctx.env.va_list_size;
    val s_va_align: u32 = m.ctx.env.va_list_align;
    val s_os:  intern.StrId = m.ctx.env.target_os;
    val s_isa: intern.StrId = m.ctx.env.target_isa;
    val s_abi: intern.StrId = m.ctx.env.target_abi;
    val s_platform: intern.StrId = m.ctx.env.target_platform;
    var ti: u32 = 0;
    for (ti < p.union_tuple_count) {
        if (p.union_tuple_filter != nil && !p.union_tuple_filter[ti]) { ti = ti + 1; cnt; }
        m.ctx.env.target_os_id   = p.union_tuples[ti].os_id;
        m.ctx.env.target_arch_id = p.union_tuples[ti].arch_id;
        m.ctx.env.target_abi_id  = p.union_tuples[ti].abi_id;
        m.ctx.env.pointer_width  = p.union_tuples[ti].pointer_width;
        m.ctx.env.vector_bits    = p.union_tuples[ti].vector_bits;
        m.ctx.env.has_float      = p.union_tuples[ti].has_float;
        m.ctx.env.target_defs    = p.union_tuples[ti].target_defs;
        m.ctx.env.va_list_size   = p.union_tuples[ti].va_list_size;
        m.ctx.env.va_list_align  = p.union_tuples[ti].va_list_align;
        m.ctx.env.target_os      = p.union_tuples[ti].os_name;
        m.ctx.env.target_isa     = p.union_tuples[ti].isa_name;
        m.ctx.env.target_abi     = p.union_tuples[ti].abi_name;
        m.ctx.env.target_platform = p.union_tuples[ti].platform_name;
        val a_r: R.Result[comptime.GateSelection, str] = first_active_tuple_branch(p, mid, ti, ci, source, emit_diag);
        m.ctx.env.target_os_id   = s_os_id;
        m.ctx.env.target_arch_id = s_arch;
        m.ctx.env.target_abi_id  = s_abi_id;
        m.ctx.env.pointer_width  = s_pw;
        m.ctx.env.vector_bits    = s_vb;
        m.ctx.env.has_float      = s_has_float;
        m.ctx.env.target_defs    = s_defs;
        m.ctx.env.va_list_size   = s_va_size;
        m.ctx.env.va_list_align  = s_va_align;
        m.ctx.env.target_os      = s_os;
        m.ctx.env.target_isa     = s_isa;
        m.ctx.env.target_abi     = s_abi;
        m.ctx.env.target_platform = s_platform;
        if (R.is_err[comptime.GateSelection, str](a_r)) {
            A.deallocate[bool](p.alloc, coverage, coverage_len);
            A.deallocate[bool](p.alloc, taken, n::usize);
            ret R.err[comptime.GateOutcome, str](R.unwrap_err[comptime.GateSelection, str](a_r));
        }
        val selection: comptime.GateSelection = R.unwrap_ok[comptime.GateSelection, str](a_r);
        if (selection.outcome == comptime.GATE_DEFERRED) {
            A.deallocate[bool](p.alloc, coverage, coverage_len);
            A.deallocate[bool](p.alloc, taken, n::usize);
            ret R.ok[comptime.GateOutcome, str](comptime.GATE_DEFERRED);
        }
        if (selection.outcome == comptime.GATE_REJECTED || selection.outcome == comptime.GATE_FAILED
         || selection.outcome == comptime.GATE_AWAITING_LAYOUT) {
            A.deallocate[bool](p.alloc, coverage, coverage_len);
            A.deallocate[bool](p.alloc, taken, n::usize);
            comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
            ret R.ok[comptime.GateOutcome, str](selection.outcome);
        }
        if (selection.outcome == comptime.GATE_ACTIVE && selection.branch < n) {
            taken[selection.branch] = true;
            coverage[selection.branch::usize * tuple_count + ti::usize] = true;
        }
        ti = ti + 1;
    }

    var bi: u32 = 0;
    for (bi < n) {
        if (taken[bi]) {
            val br: *decl.ComptimeBranch = ?(?p.modules[mid::u32]).a.comptime_branches[ci.branches_start + bi];
            val saved_filter: *bool = p.union_tuple_filter;
            p.union_tuple_filter = ?coverage[bi::usize * tuple_count];
            val saved_gated: bool = p.in_gated_decl_walk;
            p.in_gated_decl_walk = true;
            val w: R.Result[comptime.GateOutcome, str] = walk_decl_list_for_load(p, mid, br.body_start, br.body_len);
            p.in_gated_decl_walk = saved_gated;
            p.union_tuple_filter = saved_filter;
            if (R.is_err[comptime.GateOutcome, str](w)) {
                A.deallocate[bool](p.alloc, coverage, coverage_len);
                A.deallocate[bool](p.alloc, taken, n::usize);
                ret w;
            }
            val child: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](w);
            if (child != comptime.GATE_ACTIVE) {
                if (child != comptime.GATE_DEFERRED) { comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did); }
                A.deallocate[bool](p.alloc, coverage, coverage_len);
                A.deallocate[bool](p.alloc, taken, n::usize);
                ret w;
            }
        }
        bi = bi + 1;
    }
    A.deallocate[bool](p.alloc, coverage, coverage_len);
    A.deallocate[bool](p.alloc, taken, n::usize);
    comptime.mark_load_walked(?(?p.modules[mid::u32]).ctx, did);
    ret R.ok[comptime.GateOutcome, str](comptime.GATE_ACTIVE);
}

fun first_active_tuple_branch(p: *project.Project, mid: session.ModuleId, ti: u32, ci: *decl.DeclComptimeIf, source: str, emit_diag: bool) R.Result[comptime.GateSelection, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val typed: bool = m.tuple_gates != nil && ti < m.tuple_gate_count;
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?m.a.comptime_branches[ci.branches_start + bi];
        if (br.cond == id.EXPR_NIL) {
            ret R.ok[comptime.GateSelection, str](comptime.gate_selection(comptime.GATE_ACTIVE, bi));
        }
        if (typed) {
            val tg: *project.TupleGateResult = ?m.tuple_gates[ti];
            if (br.cond >= tg.state_count) { ret R.err[comptime.GateSelection, str]("union tuple gate ExprId out of range"); }
            val state: comptime.GateState = tg.states[br.cond];
            if (state == comptime.GATE_STATE_TRUE) {
                ret R.ok[comptime.GateSelection, str](comptime.gate_selection(comptime.GATE_ACTIVE, bi));
            }
            if (state == comptime.GATE_STATE_REJECTED) {
                ret R.ok[comptime.GateSelection, str](comptime.gate_selection(comptime.GATE_REJECTED, bi));
            }
            if (state == comptime.GATE_STATE_UNKNOWN) {
                ret R.ok[comptime.GateSelection, str](comptime.gate_selection(comptime.GATE_DEFERRED, bi));
            }
        }
        or {
            val nts: R.Result[bool, str] = comptime.gate_needs_typed_selection(m.a, source, br.cond);
            if (R.is_err[bool, str](nts)) {
                ret R.err[comptime.GateSelection, str](R.unwrap_err[bool, str](nts));
            }
            if (R.unwrap_ok[bool, str](nts)) {
                ret R.ok[comptime.GateSelection, str](comptime.gate_selection(comptime.GATE_DEFERRED, bi));
            }
            val ar: R.Result[comptime.GateOutcome, str] = comptime_branch_active_load(p, mid, br, source, emit_diag, false);
            if (R.is_err[comptime.GateOutcome, str](ar)) {
                ret R.err[comptime.GateSelection, str](R.unwrap_err[comptime.GateOutcome, str](ar));
            }
            val outcome: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](ar);
            if (outcome != comptime.GATE_INACTIVE) {
                ret R.ok[comptime.GateSelection, str](comptime.gate_selection(outcome, bi));
            }
        }
        bi = bi + 1;
    }
    ret R.ok[comptime.GateSelection, str](comptime.gate_selection(comptime.GATE_INACTIVE, ci.branches_len));
}

fun walk_use_for_load(p: *project.Project, mid: session.ModuleId, du: *decl.DeclUse) R.Result[R.Void, str] {
    if (du.path.len == 0) { ret R.ok_void[str](); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.err[R.Void, str]("module file_id not found in SourceMap"); }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    val tgt_r: R.Result[UseTarget, str] = resolve_use_target(p, source, du.path);
    if (R.is_err[UseTarget, str](tgt_r)) { ret R.err[R.Void, str](R.unwrap_err[UseTarget, str](tgt_r)); }
    val ut: UseTarget = R.unwrap_ok[UseTarget, str](tgt_r);

    val dep_r: R.Result[session.ModuleId, str] = dfs_load(p, ut.module_fqn);
    if (R.is_err[session.ModuleId, str](dep_r)) { ret R.err[R.Void, str](R.unwrap_err[session.ModuleId, str](dep_r)); }
    val dep_mid: session.ModuleId = R.unwrap_ok[session.ModuleId, str](dep_r);

    val record_r: R.Result[R.Void, str] = record_dep(p, mid, dep_mid);
    if (R.is_err[R.Void, str](record_r)) { ret record_r; }

    if (propagate_target_gate(p, mid, dep_mid)) { ret R.ok_void[str](); }

    if (ut.binds_module) {
        val name_r: R.Result[intern.StrId, str] = use_bound_name(p, source, du, ut);
        if (R.is_err[intern.StrId, str](name_r)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](name_r)); }
        ret record_mod_ref(p, mid, R.unwrap_ok[intern.StrId, str](name_r), dep_mid);
    }

    if (du.alias.len > 0) {
        ret R.ok_void[str]();
    }

    val rec_r: R.Result[R.Void, str] = record_const_import(p, mid, ut.leaf, dep_mid, du.path);
    if (R.is_err[R.Void, str](rec_r)) { ret rec_r; }
    ret merge_pub_consts(p, mid, dep_mid, ut.leaf, du.path);
}

fun record_const_import(p: *project.Project, mid: session.ModuleId, name: intern.StrId, dep_mid: session.ModuleId, span: token.Span) R.Result[R.Void, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < m.const_import_count) {
        if (m.const_imports[i].name == name && m.const_imports[i].module == dep_mid) { ret R.ok_void[str](); }
        i = i + 1;
    }
    if (m.const_imports == nil) {
        val r: R.Result[*project.ModRef, str] = A.allocate[project.ModRef](p.alloc, INITIAL_DEP_CAP::usize);
        if (R.is_err[*project.ModRef, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*project.ModRef, str](r)); }
        m.const_imports    = R.unwrap_ok[*project.ModRef, str](r);
        m.const_import_cap = INITIAL_DEP_CAP;
    }
    or (m.const_import_count == m.const_import_cap) {
        val new_cap: u32 = m.const_import_cap * 2;
        val r: R.Result[*project.ModRef, str] = A.reallocate[project.ModRef](p.alloc, m.const_imports, m.const_import_cap::usize, new_cap::usize);
        if (R.is_err[*project.ModRef, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*project.ModRef, str](r)); }
        m.const_imports    = R.unwrap_ok[*project.ModRef, str](r);
        m.const_import_cap = new_cap;
    }
    var ci: project.ModRef;
    ci.name   = name;
    ci.module = dep_mid;
    ci.span   = span;
    m.const_imports[m.const_import_count] = ci;
    m.const_import_count = m.const_import_count + 1;
    ret R.ok_void[str]();
}

fun use_bound_name(p: *project.Project, source: str, du: *decl.DeclUse, ut: UseTarget) R.Result[intern.StrId, str] {
    if (du.alias.len == 0) { ret R.ok[intern.StrId, str](ut.leaf); }
    ret intern.intern_span(?p.s.interner, source, du.alias);
}

fun record_mod_ref(p: *project.Project, mid: session.ModuleId, name: intern.StrId, dep_mid: session.ModuleId) R.Result[R.Void, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    if (O.is_some[session.ModuleId](mod_ref_lookup(m, name))) { ret R.ok_void[str](); }
    if (m.mod_refs == nil) {
        val r: R.Result[*project.ModRef, str] = A.allocate[project.ModRef](p.alloc, INITIAL_DEP_CAP::usize);
        if (R.is_err[*project.ModRef, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*project.ModRef, str](r)); }
        m.mod_refs    = R.unwrap_ok[*project.ModRef, str](r);
        m.mod_ref_cap = INITIAL_DEP_CAP;
    }
    or (m.mod_ref_count == m.mod_ref_cap) {
        val new_cap: u32 = m.mod_ref_cap * 2;
        val r: R.Result[*project.ModRef, str] = A.reallocate[project.ModRef](p.alloc, m.mod_refs, m.mod_ref_cap::usize, new_cap::usize);
        if (R.is_err[*project.ModRef, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*project.ModRef, str](r)); }
        m.mod_refs    = R.unwrap_ok[*project.ModRef, str](r);
        m.mod_ref_cap = new_cap;
    }
    var zero_span: token.Span;
    zero_span.offset = 0;
    zero_span.len    = 0;
    var mr: project.ModRef;
    mr.name   = name;
    mr.module = dep_mid;
    mr.span   = zero_span;
    m.mod_refs[m.mod_ref_count] = mr;
    m.mod_ref_count = m.mod_ref_count + 1;
    ret R.ok_void[str]();
}

fun walk_fwd_for_load(p: *project.Project, mid: session.ModuleId, df: *decl.DeclFwd) R.Result[R.Void, str] {
    if (df.path.len == 0) { ret R.ok_void[str](); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.err[R.Void, str]("module file_id not found in SourceMap"); }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    val tgt_r: R.Result[UseTarget, str] = resolve_use_target(p, source, df.path);
    if (R.is_err[UseTarget, str](tgt_r)) { ret R.ok_void[str](); }
    val ut: UseTarget = R.unwrap_ok[UseTarget, str](tgt_r);

    val dep_r: R.Result[session.ModuleId, str] = dfs_load(p, ut.module_fqn);
    if (R.is_err[session.ModuleId, str](dep_r)) { ret R.err[R.Void, str](R.unwrap_err[session.ModuleId, str](dep_r)); }
    val dep_mid: session.ModuleId = R.unwrap_ok[session.ModuleId, str](dep_r);

    val record_r: R.Result[R.Void, str] = record_dep(p, mid, dep_mid);
    if (R.is_err[R.Void, str](record_r)) { ret record_r; }

    propagate_target_gate(p, mid, dep_mid);
    ret R.ok_void[str]();
}

pub rec UseTarget {
    module_fqn:   intern.StrId;
    leaf:         intern.StrId;
    binds_module: bool;
}

fun span_single_segment(source: str, path: token.Span) bool {
    var k: usize = path.offset;
    val end: usize = path.offset + path.len;
    for (k < end) {
        if (source[k] == '.') { ret false; }
        k = k + 1;
    }
    ret true;
}

fun project_module_lookup(p: *project.Project, id: intern.StrId, out_found: *bool, out_module: *intern.StrId) {
    @out_found  = false;
    @out_module = intern.STR_NIL;
    if (id == p.config.id) {
        @out_found  = true;
        @out_module = p.config.module;
        ret;
    }
    var k: u32 = 0;
    for (k < p.config.dep_count) {
        if (p.config.deps[k].project_id == id) {
            @out_found  = true;
            @out_module = p.config.deps[k].project_module;
            ret;
        }
        k = k + 1;
    }
}

fun resolve_use_target(p: *project.Project, source: str, path: token.Span) R.Result[UseTarget, str] {
    val full_r: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, source, path);
    if (R.is_err[intern.StrId, str](full_r)) { ret R.err[UseTarget, str](R.unwrap_err[intern.StrId, str](full_r)); }
    val full_id: intern.StrId = R.unwrap_ok[intern.StrId, str](full_r);

    val leaf_r: R.Result[intern.StrId, str] = leaf_name(?p.s.interner, source, path);
    if (R.is_err[intern.StrId, str](leaf_r)) { ret R.err[UseTarget, str](R.unwrap_err[intern.StrId, str](leaf_r)); }
    val leaf: intern.StrId = R.unwrap_ok[intern.StrId, str](leaf_r);

    if (span_single_segment(source, path)) {
        var found:  bool = false;
        var mod_id: intern.StrId = intern.STR_NIL;
        project_module_lookup(p, full_id, ?found, ?mod_id);
        if (found) {
            if (mod_id == intern.STR_NIL) {
                ret R.err[UseTarget, str](diag_join_named(p.s, "project '", full_id, "' has no public module because its artifacts name different entries; import a full path, or give every [artifact.*] table in its manifest the same entry", "project has no public module because its artifacts name different entries; import a full path, or give every [artifact.*] table in its manifest the same entry"));
            }
            val id_opt:  O.Option[str] = intern.lookup(?p.s.interner, full_id);
            val mod_opt: O.Option[str] = intern.lookup(?p.s.interner, mod_id);
            if (O.is_none[str](id_opt) || O.is_none[str](mod_opt)) { ret R.err[UseTarget, str]("internal: project id/module not interned"); }
            val fqn_r: R.Result[intern.StrId, str] = compose_module_fqn(p.alloc, ?p.s.interner, O.unwrap[str](id_opt), O.unwrap[str](mod_opt));
            if (R.is_err[intern.StrId, str](fqn_r)) { ret R.err[UseTarget, str](R.unwrap_err[intern.StrId, str](fqn_r)); }
            var ut: UseTarget;
            ut.module_fqn   = R.unwrap_ok[intern.StrId, str](fqn_r);
            ut.leaf         = leaf;
            ut.binds_module = true;
            ret R.ok[UseTarget, str](ut);
        }
    }

    if (fqn_names_file(p, full_id)) {
        var ut: UseTarget;
        ut.module_fqn   = full_id;
        ut.leaf         = leaf;
        ut.binds_module = true;
        ret R.ok[UseTarget, str](ut);
    }

    val end: usize = path.offset + path.len;
    var seg_end: usize = end;
    for (seg_end > path.offset) {
        var dot: usize = seg_end;
        for (dot > path.offset && source[dot - 1] != '.') { dot = dot - 1; }
        if (dot == path.offset) { ret R.err[UseTarget, str](unresolvable_use_msg(p, source, path, full_id)); }
        var prefix: token.Span;
        prefix.offset = path.offset;
        prefix.len    = (dot - 1) - path.offset;
        val pid_r: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, source, prefix);
        if (R.is_err[intern.StrId, str](pid_r)) { ret R.err[UseTarget, str](R.unwrap_err[intern.StrId, str](pid_r)); }
        val pid: intern.StrId = R.unwrap_ok[intern.StrId, str](pid_r);
        if (fqn_names_file(p, pid)) {
            var ut: UseTarget;
            ut.module_fqn   = pid;
            ut.leaf         = leaf;
            ut.binds_module = false;
            ret R.ok[UseTarget, str](ut);
        }
        seg_end = dot - 1;
    }
    ret R.err[UseTarget, str](unresolvable_use_msg(p, source, path, full_id));
}

fun unresolvable_use_msg(p: *project.Project, source: str, path: token.Span, full_id: intern.StrId) str {
    val generic: str = diag_join_named(p.s, "use path '", full_id, "' does not name a module", "use path does not name a module");

    var root_end: usize = path.offset;
    val end: usize = path.offset + path.len;
    for (root_end < end && source[root_end] != '.') { root_end = root_end + 1; }
    if (root_end >= end) { ret generic; }

    var root_span: token.Span;
    root_span.offset = path.offset;
    root_span.len    = root_end - path.offset;
    val root_r: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, source, root_span);
    if (R.is_err[intern.StrId, str](root_r)) { ret generic; }
    val root_id: intern.StrId = R.unwrap_ok[intern.StrId, str](root_r);

    var found:  bool = false;
    var mod_id: intern.StrId = intern.STR_NIL;
    project_module_lookup(p, root_id, ?found, ?mod_id);
    if (found) { ret generic; }

    ret diag_undeclared_root(p.s, full_id, root_id);
}

fun diag_undeclared_root(s: *session.Session, full_id: intern.StrId, root_id: intern.StrId) str {
    val fallback: str = "use path names an undeclared module root";
    val fo: O.Option[str] = intern.lookup(?s.interner, full_id);
    val ro: O.Option[str] = intern.lookup(?s.interner, root_id);
    if (O.is_none[str](fo) || O.is_none[str](ro)) { ret fallback; }

    val res_msg: R.Result[str, str] = format.sprint(s.alloc,
        "use path '{}': module root '{}' is not this project or a declared dependency; declare it in mach.toml",
        O.unwrap[str](fo), O.unwrap[str](ro));
    if (R.is_err[str, str](res_msg)) { ret fallback; }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    val ir: R.Result[intern.StrId, str] = intern.intern(?s.interner, buf);
    str_free(s.alloc, buf);
    if (R.is_err[intern.StrId, str](ir)) { ret fallback; }

    val nm: O.Option[str] = intern.lookup(?s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret fallback;
}

fun fqn_names_file(p: *project.Project, fqn: intern.StrId) bool {
    val path_r: R.Result[str, str] = fqn_to_file_path(p, fqn);
    if (R.is_err[str, str](path_r)) { ret false; }
    val file_path: str = R.unwrap_ok[str, str](path_r);
    val ok_: bool = fs.is_file(file_path);
    str_free(p.alloc, file_path);
    ret ok_;
}

fun leaf_name(i: *intern.Interner, source: str, path: token.Span) R.Result[intern.StrId, str] {
    var seg_start: usize = path.offset;
    var k: usize = path.offset;
    val end: usize = path.offset + path.len;
    for (k < end) {
        if (source[k] == '.') { seg_start = k + 1; }
        k = k + 1;
    }
    var leaf_span: token.Span;
    leaf_span.offset = seg_start;
    leaf_span.len    = end - seg_start;
    ret intern.intern_span(i, source, leaf_span);
}

fun record_dep(p: *project.Project, mid: session.ModuleId, dep_mid: session.ModuleId) R.Result[R.Void, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < m.dep_count) {
        if (m.deps[i] == dep_mid) { ret R.ok_void[str](); }
        i = i + 1;
    }
    if (m.deps == nil) {
        val r: R.Result[*session.ModuleId, str] = A.allocate[session.ModuleId](p.alloc, INITIAL_DEP_CAP::usize);
        if (R.is_err[*session.ModuleId, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*session.ModuleId, str](r)); }
        m.deps    = R.unwrap_ok[*session.ModuleId, str](r);
        m.dep_cap = INITIAL_DEP_CAP;
    }
    or (m.dep_count == m.dep_cap) {
        val new_cap: u32 = m.dep_cap * 2;
        val r: R.Result[*session.ModuleId, str] = A.reallocate[session.ModuleId](p.alloc, m.deps, m.dep_cap::usize, new_cap::usize);
        if (R.is_err[*session.ModuleId, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*session.ModuleId, str](r)); }
        m.deps    = R.unwrap_ok[*session.ModuleId, str](r);
        m.dep_cap = new_cap;
    }
    m.deps[m.dep_count] = dep_mid;
    m.dep_count = m.dep_count + 1;
    ret R.ok_void[str]();
}

fun gated_const_message(s: *session.Session, name: intern.StrId, dep_fqn: intern.StrId) str {
    val fallback: str = "tuple-dependent public constants are not yet supported in union builds";
    val no: O.Option[str] = intern.lookup(?s.interner, name);
    val fo: O.Option[str] = intern.lookup(?s.interner, dep_fqn);
    if (O.is_none[str](no) || O.is_none[str](fo)) { ret fallback; }

    val res_msg: R.Result[str, str] = format.sprint(s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        O.unwrap[str](no), O.unwrap[str](fo));
    if (R.is_err[str, str](res_msg)) { ret fallback; }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    val ir: R.Result[intern.StrId, str] = intern.intern(?s.interner, buf);
    str_free(s.alloc, buf);
    if (R.is_err[intern.StrId, str](ir)) { ret fallback; }

    val nm: O.Option[str] = intern.lookup(?s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret fallback;
}

pub fun check_gated_const_imports(p: *project.Project) R.Result[R.Void, str] {
    if (!p.union) { ret R.ok_void[str](); }
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        var j: u32 = 0;
        for (j < m.const_import_count) {
            val ci: *project.ModRef = ?m.const_imports[j];
            val dep: *project.ModuleEntry = ?p.modules[ci.module::u32];
            val v: O.Option[*project.PubConst] = pub_const_lookup(dep, ci.name);
            if (O.is_none[*project.PubConst](v)) { j = j + 1; cnt; }
            val pc: *project.PubConst = O.unwrap[*project.PubConst](v);
            if (pc.gated) {
                val msg: str = gated_const_message(p.s, ci.name, dep.fqn);
                fail.reject(?m.load_status);
                val committed_r: R.Result[bool, str] = diagnostic.gate_error(?p.s.gate_diags, ?p.s.diags, ?p.s.interner, m.file_id, ci.span, msg);
                if (R.is_err[bool, str](committed_r)) { ret R.void_of[bool, str](committed_r); }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun merge_pub_consts(p: *project.Project, mid: session.ModuleId, dep_mid: session.ModuleId, leaf: intern.StrId, span: token.Span) R.Result[R.Void, str] {
    val m:   *project.ModuleEntry = ?p.modules[mid::u32];
    val dep: *project.ModuleEntry = ?p.modules[dep_mid::u32];
    val v: O.Option[*project.PubConst] = pub_const_lookup(dep, leaf);
    if (O.is_none[*project.PubConst](v)) { ret R.ok_void[str](); }
    val pc: *project.PubConst = O.unwrap[*project.PubConst](v);
    if (pc.gated && p.union) {
        val msg: str = gated_const_message(p.s, leaf, dep.fqn);
        fail.reject(?m.load_status);
        ret R.void_of[bool, str](diagnostic.gate_error(?p.s.gate_diags, ?p.s.diags, ?p.s.interner, m.file_id, span, msg));
    }
    ret comptime.bind(?m.ctx, leaf, pc.value);
}

pub fun remerge_tuple_pub_consts(p: *project.Project, mid: session.ModuleId, ti: u32) R.Result[bool, str] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var bound: u32 = 0;
    var i: u32 = 0;
    for (i < m.const_import_count) {
        val ci: *project.ModRef = ?m.const_imports[i];
        if (O.is_some[comptime.NamedConst](comptime.lookup(?m.ctx, ci.name))) {
            bound = bound + 1;
            i = i + 1;
            cnt;
        }
        val dep: *project.ModuleEntry = ?p.modules[ci.module::u32];
        val v: O.Option[*project.PubConst] = pub_const_lookup(dep, ci.name);
        if (O.is_none[*project.PubConst](v)) { i = i + 1; cnt; }
        val pc: *project.PubConst = O.unwrap[*project.PubConst](v);
        if (pc.gated && p.union) {
            val msg: str = gated_const_message(p.s, ci.name, dep.fqn);
            fail.reject(?m.load_status);
            val committed_r: R.Result[bool, str] = diagnostic.gate_error(?p.s.gate_diags, ?p.s.diags, ?p.s.interner, m.file_id, ci.span, msg);
            if (R.is_err[bool, str](committed_r)) { ret R.err[bool, str](R.unwrap_err[bool, str](committed_r)); }
            bound = bound + 1;
            i = i + 1;
            cnt;
        }
        val br: R.Result[R.Void, str] = comptime.bind(?m.ctx, ci.name, pc.value);
        if (R.is_err[R.Void, str](br)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](br)); }
        bound = bound + 1;
        i = i + 1;
    }
    var changed: bool = false;
    if (m.tuple_gates != nil && ti < m.tuple_gate_count) {
        val tg: *project.TupleGateResult = ?m.tuple_gates[ti];
        if (bound > tg.merged_const_count) {
            tg.merged_const_count = bound;
            changed = true;
        }
    }
    ret R.ok[bool, str](changed);
}

fun pub_const_lookup(dep: *project.ModuleEntry, name: intern.StrId) O.Option[*project.PubConst] {
    var i: u32 = 0;
    for (i < dep.pub_const_count) {
        val pc: *project.PubConst = ?dep.pub_consts[i];
        if (pc.name == name) { ret O.some[*project.PubConst](pc); }
        i = i + 1;
    }
    ret O.none[*project.PubConst]();
}

fun mod_ref_lookup(m: *project.ModuleEntry, name: intern.StrId) O.Option[session.ModuleId] {
    var i: u32 = 0;
    for (i < m.mod_ref_count) {
        val mr: *project.ModRef = ?m.mod_refs[i];
        if (mr.name == name) { ret O.some[session.ModuleId](mr.module); }
        i = i + 1;
    }
    ret O.none[session.ModuleId]();
}

rec LoadMemberCtx {
    p:   *project.Project;
    mid: session.ModuleId;
}

fun resolve_module_member_const_load(lc: *LoadMemberCtx, eid: id.ExprId) R.Result[O.Option[comptime.CTValue], str] {
    if (lc == nil) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }
    val m: *project.ModuleEntry = ?lc.p.modules[lc.mid::u32];
    if (m.a == nil) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }

    val e_opt: O.Option[*expr.Expr] = ast.get_expr(m.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }
    val node: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (node.kind != expr.EXPR_KIND_MEMBER) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }

    val o_opt: O.Option[*expr.Expr] = ast.get_expr(m.a, node.data.member.object);
    if (O.is_none[*expr.Expr](o_opt)) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }
    val obj: *expr.Expr = O.unwrap[*expr.Expr](o_opt);
    if (obj.kind != expr.EXPR_KIND_IDENT) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }

    val src_opt: O.Option[*src.SourceFile] = src.get(?lc.p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    val obj_r: R.Result[intern.StrId, str] = intern.intern_span(?lc.p.s.interner, source, obj.span);
    if (R.is_err[intern.StrId, str](obj_r)) { ret R.err[O.Option[comptime.CTValue], str](R.unwrap_err[intern.StrId, str](obj_r)); }
    val dep_opt: O.Option[session.ModuleId] = mod_ref_lookup(m, R.unwrap_ok[intern.StrId, str](obj_r));
    if (O.is_none[session.ModuleId](dep_opt)) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }

    val name_r: R.Result[intern.StrId, str] = intern.intern_span(?lc.p.s.interner, source, node.data.member.name);
    if (R.is_err[intern.StrId, str](name_r)) { ret R.err[O.Option[comptime.CTValue], str](R.unwrap_err[intern.StrId, str](name_r)); }

    val dep: *project.ModuleEntry = ?lc.p.modules[(O.unwrap[session.ModuleId](dep_opt))::u32];
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](name_r);
    val v: O.Option[*project.PubConst] = pub_const_lookup(dep, name);
    if (O.is_none[*project.PubConst](v)) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }
    val pc: *project.PubConst = O.unwrap[*project.PubConst](v);
    if (pc.gated && lc.p.union) {
        val msg: str = gated_const_message(lc.p.s, name, dep.fqn);
        fail.reject(?m.load_status);
        val committed_r: R.Result[bool, str] = diagnostic.gate_error(?lc.p.s.gate_diags, ?lc.p.s.diags, ?lc.p.s.interner, m.file_id, node.data.member.name, msg);
        if (R.is_err[bool, str](committed_r)) { ret R.err[O.Option[comptime.CTValue], str](R.unwrap_err[bool, str](committed_r)); }
        ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]());
    }
    ret R.ok[O.Option[comptime.CTValue], str](O.some[comptime.CTValue](pc.value));
}

pub fun eval_for_load(
    p:      *project.Project,
    mid:    session.ModuleId,
    source: str,
    e:      id.ExprId,
    fw:     float.FloatWidth
) R.Result[comptime.CTValue, comptime.EvalFail] {
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var lc: LoadMemberCtx;
    lc.p   = p;
    lc.mid = mid;
    val lcp: *LoadMemberCtx = ?lc;
    val caps_r: R.Result[comptime.PhaseCapabilities[LoadMemberCtx], str] =
        comptime.loading_capabilities[LoadMemberCtx](resolve_module_member_const_load);
    if (R.is_err[comptime.PhaseCapabilities[LoadMemberCtx], str](caps_r)) {
        var f: comptime.EvalFail;
        f.kind    = comptime.EVAL_FAIL_REJECTED;
        f.message = R.unwrap_err[comptime.PhaseCapabilities[LoadMemberCtx], str](caps_r);
        ret R.err[comptime.CTValue, comptime.EvalFail](f);
    }
    val caps: comptime.PhaseCapabilities[LoadMemberCtx] =
        R.unwrap_ok[comptime.PhaseCapabilities[LoadMemberCtx], str](caps_r);
    ret comptime.evaluate_at_float_width[LoadMemberCtx](?m.ctx, lcp, caps, m.a, source, e, ?p.s.interner, fw);
}

fun register_val_for_load(p: *project.Project, mid: session.ModuleId, d: *decl.Decl, _did: id.DeclId) R.Result[R.Void, str] {
    if (d.data.bind.name.len == 0)       { ret R.ok_void[str](); }
    if (d.data.bind.init == id.EXPR_NIL) { ret R.ok_void[str](); }
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    val src_opt: O.Option[*src.SourceFile] = src.get(?p.s.sources, m.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) { ret R.err[R.Void, str]("module file_id not found in SourceMap"); }
    val source: str = O.unwrap[*src.SourceFile](src_opt).text;

    val r_id: R.Result[intern.StrId, str] = intern.intern_span(?p.s.interner, source, d.data.bind.name);
    if (R.is_err[intern.StrId, str](r_id)) {
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_id));
    }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_id);

    val fw: float.FloatWidth = comptime.declared_float_width(m.a, source, d.data.bind.ty);
    val r_val: R.Result[comptime.CTValue, comptime.EvalFail] =
        eval_for_load(p, mid, source, d.data.bind.init, fw);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](r_val)) { ret R.ok_void[str](); }
    val v: comptime.CTValue = comptime.apply_declared_int_type(m.a, source, d.data.bind.ty,
        R.unwrap_ok[comptime.CTValue, comptime.EvalFail](r_val));

    if (comptime.float_width_unread(v)) {
        ret comptime.defer_float_width(?m.ctx, name_id);
    }

    val rr: R.Result[R.Void, str] = comptime.bind_gated(?m.ctx, name_id, v, p.in_gated_decl_walk);
    if (R.is_err[R.Void, str](rr)) { ret rr; }

    val is_pub: bool = (d.flags & decl.DECL_FLAG_PUB) != 0;
    if (is_pub) { ret add_pub_const(p, m, name_id, v); }
    ret R.ok_void[str]();
}

fun add_pub_const(p: *project.Project, m: *project.ModuleEntry, name: intern.StrId, value: comptime.CTValue) R.Result[R.Void, str] {
    if (m.pub_consts == nil) {
        val r: R.Result[*project.PubConst, str] = A.allocate[project.PubConst](p.alloc, INITIAL_PUB_CAP::usize);
        if (R.is_err[*project.PubConst, str](r)) {
            ret R.err[R.Void, str](R.unwrap_err[*project.PubConst, str](r));
        }
        m.pub_consts   = R.unwrap_ok[*project.PubConst, str](r);
        m.pub_const_cap = INITIAL_PUB_CAP;
    }
    or (m.pub_const_count == m.pub_const_cap) {
        val new_cap: u32 = m.pub_const_cap * 2;
        val r: R.Result[*project.PubConst, str] = A.reallocate[project.PubConst](p.alloc, m.pub_consts, m.pub_const_cap::usize, new_cap::usize);
        if (R.is_err[*project.PubConst, str](r)) {
            ret R.err[R.Void, str](R.unwrap_err[*project.PubConst, str](r));
        }
        m.pub_consts   = R.unwrap_ok[*project.PubConst, str](r);
        m.pub_const_cap = new_cap;
    }
    var pc: project.PubConst;
    pc.name  = name;
    pc.value = value;
    pc.gated = p.in_gated_decl_walk;
    m.pub_consts[m.pub_const_count] = pc;
    m.pub_const_count = m.pub_const_count + 1;
    ret R.ok_void[str]();
}

pub fun rebuild_topo(p: *project.Project, emit_roots: *session.ModuleId, emit_root_count: u32) R.Result[R.Void, str] {
    if (p.module_len == 0) { p.topo_len = 0; ret R.ok_void[str](); }
    val ir: R.Result[*bool, str] = A.allocate[bool](p.alloc, p.module_len::usize);
    if (R.is_err[*bool, str](ir)) { ret R.err[R.Void, str](R.unwrap_err[*bool, str](ir)); }
    val included: *bool = R.unwrap_ok[*bool, str](ir);
    val sr: R.Result[*u8, str] = A.allocate[u8](p.alloc, p.module_len::usize);
    if (R.is_err[*u8, str](sr)) {
        A.deallocate[bool](p.alloc, included, p.module_len::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u8, str](sr));
    }
    val state: *u8 = R.unwrap_ok[*u8, str](sr);
    val er: R.Result[*bool, str] = A.allocate[bool](p.alloc, p.module_len::usize);
    if (R.is_err[*bool, str](er)) {
        A.deallocate[u8](p.alloc, state, p.module_len::usize);
        A.deallocate[bool](p.alloc, included, p.module_len::usize);
        ret R.err[R.Void, str](R.unwrap_err[*bool, str](er));
    }
    val emitted: *bool = R.unwrap_ok[*bool, str](er);
    var i: u32 = 0;
    for (i < p.module_len) { included[i] = false; emitted[i] = false; state[i] = 0; i = i + 1; }
    i = 0;
    for (i < p.topo_len) { included[p.topo[i]::u32] = true; i = i + 1; }
    i = 0;
    for (i < emit_root_count) {
        mark_emitted_deps(p, emit_roots[i], emitted);
        i = i + 1;
    }

    val tr: R.Result[*session.ModuleId, str] = A.allocate[session.ModuleId](p.alloc, p.module_len::usize);
    if (R.is_err[*session.ModuleId, str](tr)) {
        A.deallocate[bool](p.alloc, emitted, p.module_len::usize);
        A.deallocate[u8](p.alloc, state, p.module_len::usize);
        A.deallocate[bool](p.alloc, included, p.module_len::usize);
        ret R.err[R.Void, str](R.unwrap_err[*session.ModuleId, str](tr));
    }
    val ordered: *session.ModuleId = R.unwrap_ok[*session.ModuleId, str](tr);
    var ordered_len: u32 = 0;
    i = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (!emitted[mid::u32]) { i = i + 1; cnt; }
        val vr: R.Result[R.Void, str] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (R.is_err[R.Void, str](vr)) {
            A.deallocate[session.ModuleId](p.alloc, ordered, p.module_len::usize);
            A.deallocate[bool](p.alloc, emitted, p.module_len::usize);
            A.deallocate[u8](p.alloc, state, p.module_len::usize);
            A.deallocate[bool](p.alloc, included, p.module_len::usize);
            ret vr;
        }
        i = i + 1;
    }
    i = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (emitted[mid::u32]) { i = i + 1; cnt; }
        val vr: R.Result[R.Void, str] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (R.is_err[R.Void, str](vr)) {
            A.deallocate[session.ModuleId](p.alloc, ordered, p.module_len::usize);
            A.deallocate[bool](p.alloc, emitted, p.module_len::usize);
            A.deallocate[u8](p.alloc, state, p.module_len::usize);
            A.deallocate[bool](p.alloc, included, p.module_len::usize);
            ret vr;
        }
        i = i + 1;
    }

    if (p.topo != nil && p.topo_cap > 0) {
        A.deallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize);
    }
    p.topo = ordered;
    p.topo_len = ordered_len;
    p.topo_cap = p.module_len;
    p.emit_len = 0;
    for (p.emit_len < p.topo_len && emitted[p.topo[p.emit_len]::u32]) {
        p.emit_len = p.emit_len + 1;
    }
    A.deallocate[bool](p.alloc, emitted, p.module_len::usize);
    A.deallocate[u8](p.alloc, state, p.module_len::usize);
    A.deallocate[bool](p.alloc, included, p.module_len::usize);
    ret R.ok_void[str]();
}

fun mark_emitted_deps(p: *project.Project, mid: session.ModuleId, emitted: *bool) {
    if (mid::u32 >= p.module_len || emitted[mid::u32]) { ret; }
    emitted[mid::u32] = true;
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < m.dep_count) {
        mark_emitted_deps(p, m.deps[i], emitted);
        i = i + 1;
    }
}

fun topo_visit(p: *project.Project, mid: session.ModuleId, included: *bool, state: *u8,
               ordered: *session.ModuleId, ordered_len: *u32) R.Result[R.Void, str] {
    if (mid::u32 >= p.module_len || !included[mid::u32]) { ret R.ok_void[str](); }
    if (state[mid::u32] == 2) { ret R.ok_void[str](); }
    if (state[mid::u32] == 1) { ret R.err[R.Void, str]("circular module dependency through a deferred comptime gate"); }
    state[mid::u32] = 1;
    val m: *project.ModuleEntry = ?p.modules[mid::u32];
    var i: u32 = 0;
    for (i < m.dep_count) {
        val vr: R.Result[R.Void, str] = topo_visit(p, m.deps[i], included, state, ordered, ordered_len);
        if (R.is_err[R.Void, str](vr)) { ret vr; }
        i = i + 1;
    }
    state[mid::u32] = 2;
    ordered[@ordered_len] = mid;
    @ordered_len = @ordered_len + 1;
    ret R.ok_void[str]();
}

fun topo_push(p: *project.Project, mid: session.ModuleId) R.Result[R.Void, str] {
    if (p.topo == nil) {
        val r: R.Result[*session.ModuleId, str] = A.allocate[session.ModuleId](p.alloc, INITIAL_MODULE_CAP::usize);
        if (R.is_err[*session.ModuleId, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*session.ModuleId, str](r)); }
        p.topo     = R.unwrap_ok[*session.ModuleId, str](r);
        p.topo_cap = INITIAL_MODULE_CAP;
    }
    or (p.topo_len == p.topo_cap) {
        val new_cap: u32 = p.topo_cap * 2;
        val r: R.Result[*session.ModuleId, str] = A.reallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize, new_cap::usize);
        if (R.is_err[*session.ModuleId, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*session.ModuleId, str](r)); }
        p.topo     = R.unwrap_ok[*session.ModuleId, str](r);
        p.topo_cap = new_cap;
    }
    p.topo[p.topo_len] = mid;
    p.topo_len = p.topo_len + 1;
    ret R.ok_void[str]();
}

pub fun register_module_asts(p: *project.Project) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < p.module_len) {
        val m: *project.ModuleEntry = ?p.modules[i];
        val r: R.Result[R.Void, str] = session.register_module_identity(p.s, i, m.a, m.fqn, m.stable_id);
        if (R.is_err[R.Void, str](r)) { unpublish_modules(p, i); ret r; }

        var num: u32 = i::u32;
        val rn: R.Result[R.Void, str] = query.set_input(?p.s.queries, query.Q_MODULE_NUMBER, m.stable_id::u64, (?num)::*u8, 4);
        if (R.is_err[R.Void, str](rn)) {
            session.unregister_module_identity(p.s, i, m.stable_id);
            unpublish_modules(p, i);
            ret rn;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun unpublish_modules(p: *project.Project, published: u32) {
    var j: u32 = 0;
    for (j < published) {
        val m: *project.ModuleEntry = ?p.modules[j];
        session.unregister_module_identity(p.s, j, m.stable_id);
        query.invalidate(?p.s.queries, query.Q_MODULE_NUMBER, m.stable_id::u64);
        j = j + 1;
    }
}
