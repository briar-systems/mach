pub val MACH_VERSION: str = lang_version.MACH_VERSION;

pub fun entry_module_fqn(p: *project.Project, t: *project.TargetEntry) res[intern.StrId, fail.Fail] {
    val ep_opt: opt[str] = intern.get(?p.s.interner, t.entrypoint);
    if (sel ep_opt.none) { ret res[intern.StrId, fail.Fail].err{fail.message("entrypoint StrId not interned")}; }
    val ep_text: str = ep_opt.some;

    val id_opt: opt[str] = intern.get(?p.s.interner, p.config.id);
    if (sel id_opt.none) { ret res[intern.StrId, fail.Fail].err{fail.message("project id StrId not interned")}; }

    ret compose_module_fqn(p.alloc, ?p.s.interner, id_opt.some, ep_text);
}

pub fun compose_module_fqn(alloc: *A.Allocator, itn: *intern.Interner, id_text: str, rel_text: str) res[intern.StrId, fail.Fail] {
    val rel_stripped: View = strip_mach_suffix(rel_text);

    val id_len: usize             = str_len(id_text);
    val total:  usize             = id_len + 1 + rel_stripped.len;
    val r_buf:  res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r_buf.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_buf.err)}; }
    val buf: *u8 = r_buf.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < id_len) {
        buf[k] = id_text[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = '.';
    k      = k + 1;
    j      = 0;
    for (j < rel_stripped.len) {
        val c: u8 = rel_stripped.data[j];
        if (c == '/' || c == '\\') { buf[k] = '.'; }
        or                         { buf[k] = c; }
        k = k + 1;
        j = j + 1;
    }

    val r: res[intern.StrId, A.Error] = intern.bytes_add(itn, buf::str, k);
    A.deallocate[u8](alloc, buf, total);
    if (sel r.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r.ok};
}

fun strip_mach_suffix(s: str) View {
    val suffix: str   = ".mach";
    val s_len:  usize = str_len(s);
    if (!str_ends_with(s, suffix)) { ret view(s::*char, s_len); }
    ret view(s::*char, s_len - str_len(suffix));
}

# `prefix`, the text of `name_id`, then `suffix`, interned
pub fun diag_join_named(s: *session.Session, prefix: str, name_id: intern.StrId, suffix: str) res[str, fail.Fail] {
    ret fail.format_intern(?s.interner, s.alloc, "{}{}{}", prefix, intern.text(?s.interner, name_id), suffix);
}

pub fun join_path(alloc: *A.Allocator, a: str, b: str) res[str, fail.Fail] {
    val join_r: res[types_path.Path, A.Error] = types_path.join(alloc, a, b);
    if (sel join_r.err) { ret res[str, fail.Fail].err{fail.refused(join_r.err)}; }
    ret res[str, fail.Fail].ok{join_r.ok};
}

# the comptime context of a build for `t` under `req`: every fact comptime reads from
# the target and the build options, and nothing of a project, so the build and the
# editor fold the same program the same way
pub fun target_context(alloc: *A.Allocator, t: *lang_target.Binding, req: *request.BuildRequest,
    compiler_name: intern.StrId, compiler_ver: intern.StrId) comptime.ComptimeCtx {
    var build_mode_id: u32 = comptime_path.MODE_DEBUG;
    if (request.release(req)) { build_mode_id = comptime_path.MODE_RELEASE; }
    var build_pie: u32 = 0;
    if (req.pie) { build_pie = 1; }
    ret comptime.init(alloc, resolved.facts(?t.target), comptime.build_facts(build_mode_id, build_pie, compiler_name, compiler_ver));
}

# the comptime context a module of `artifact` evaluates in under the cell's target, what
# `$bin.name` reads; the load adds what the module's own source says
fun artifact_context(p: *project.Project, artifact: intern.StrId) res[comptime.ComptimeCtx, fail.Fail] {
    if (p == nil || p.target_entry == nil) {
        ret res[comptime.ComptimeCtx, fail.Fail].err{fail.message("driver: module context requires an opened project and request")};
    }
    var ctx: comptime.ComptimeCtx = target_context(p.alloc, ?p.target, ?p.req, p.compiler_name, p.compiler_ver);
    ctx.env.build.union_build   = p.loader.union;
    ctx.env.build.project_id    = p.config.id;
    ctx.env.build.project_ver   = p.config.version;
    ctx.env.build.os_name       = p.target_entry.os_name;
    ctx.env.build.isa_name      = p.target_entry.isa_name;
    ctx.env.build.abi_name      = p.target_entry.abi_name;
    ctx.env.build.platform_name = p.target_entry.platform_name;
    ctx.env.build.bin_name      = artifact;
    ret res[comptime.ComptimeCtx, fail.Fail].ok{ctx};
}

# the packages the cell compiles, as the disk provider reads them: the root project first, then
# each dependency of the closure
fun packages_set(p: *project.Project) err[fail.Fail] {
    disk.packages_clear(?p.disk);
    val root_module: res[intern.StrId, fail.Fail] = public_module(p, p.config.id, p.config.module);
    if (sel root_module.err) { ret err[fail.Fail].err{root_module.err}; }
    val root: err[fail.Fail] = disk.package_add(?p.disk, disk.Package{
        id:  p.config.id, version: p.config.version, module: root_module.ok,
        dir: p.config.project_root, src: p.config.dir_src, artifactless: false, root: true
    });
    if (sel root.err) { ret root; }
    var k: u32 = 0;
    for (k < p.config.dep_count) {
        val dep:    *project.DepEntry            = ?p.config.deps[k];
        val public: res[intern.StrId, fail.Fail] = public_module(p, dep.project_id, dep.project_module);
        if (sel public.err) { ret err[fail.Fail].err{public.err}; }
        val added: err[fail.Fail] = disk.package_add(?p.disk, disk.Package{
            id:  dep.project_id, version: dep.manifest.version, module: public.ok,
            dir: dep.vendor_root, src: dep.project_dir_src, artifactless: dep.manifest.artifact_count == 0, root: false
        });
        if (sel added.err) { ret added; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# the fqn of a package's public module from its entry path, STR_NIL when it has none
fun public_module(p: *project.Project, id: intern.StrId, entry: intern.StrId) res[intern.StrId, fail.Fail] {
    if (intern.str_is_nil(entry)) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    ret compose_module_fqn(p.alloc, ?p.s.interner, intern.text(?p.s.interner, id), intern.text(?p.s.interner, entry));
}

# the project's loader, pointed at the project where it is now: the project is a value its
# callers move, so what the loader holds of it is bound again before each use
fun loader_of(p: *project.Project) res[*fe_load.Loader, fail.Fail] {
    if (p.disk.packages.len == 0) {
        val placed: err[fail.Fail] = packages_set(p);
        if (sel placed.err) { ret res[*fe_load.Loader, fail.Fail].err{placed.err}; }
    }
    p.overlay = overlay.init(disk.provider_of(?p.disk), p.s);
    val host: fe_load.Host = fe_load.Host{
        ctx:   p::ptr, add: host_add, row: host_row, parse: host_parse, refresh: host_refresh,
        epoch: host_epoch, context: host_context, done: host_done
    };
    fe_load.bind(?p.loader, host, overlay.provider_of(?p.overlay), ?p.diags);
    ret res[*fe_load.Loader, fail.Fail].ok{?p.loader};
}

fun host_add(ctx: ptr, fqn: intern.StrId, sid: session.StableModuleId) res[session.ModuleId, fail.Fail] {
    val p:    *project.Project = ctx::*project.Project;
    val slot: err[fail.Fail]   = project.module_reserve(p);
    if (sel slot.err) { ret res[session.ModuleId, fail.Fail].err{slot.err}; }
    var m: project.ModuleEntry;
    m.fqn               = fqn;
    m.file_id           = lang_source.FILE_NIL;
    m.stable_id         = sid;
    m.a                 = nil;
    m.parse_status      = fail.accepted();
    m.resolve_result    = nil;
    m.resolved          = false;
    m.typed_surface     = nil;
    m.typed_surface_rev = 0;
    m.sema_result       = nil;
    m.ir_module         = nil;
    m.object_image      = nil;
    m.staged_image      = nil;
    m.staged_facts      = cache_record.Facts{};
    m.cache_checked     = false;
    m.cache_hit         = false;
    m.cache_keyed       = false;
    m.frontend_skipped  = false;
    m.test              = project.TestObject{};
    m.load              = fe_load.Module{};
    m.lower_scoped      = false;
    var cache_byte: usize = 0;
    for (cache_byte < 32) {
        m.cache_under[cache_byte] = 0;
        cache_byte                = cache_byte + 1;
    }
    ret res[session.ModuleId, fail.Fail].ok{project.module_append(p, m)};
}

fun host_row(ctx: ptr, mid: session.ModuleId) fe_load.Row {
    val m: *project.ModuleEntry = project.module_at(ctx::*project.Project, mid::u32);
    ret fe_load.Row{name: m.fqn, stable: m.stable_id, file: m.file_id, syntax: m.a, load: ?m.load};
}

fun host_parse(ctx: ptr, mid: session.ModuleId, file: lang_source.FileId, reported: bool) err[fail.Fail] {
    val p:      *project.Project     = ctx::*project.Project;
    val t_load: readout.Instant      = readout.item_begin(p.progress);
    val m:      *project.ModuleEntry = project.module_at(p, mid::u32);
    m.file_id = file;
    val acquired: err[fail.Fail] = acquire_load_view(p, mid, 0);
    if (sel acquired.err) { ret acquired; }
    if (reported)         { readout.item(p.progress, readout.LOAD, intern.text(?p.s.interner, m.fqn), t_load); }
    ret err[fail.Fail].ok{};
}

fun host_refresh(ctx: ptr, mid: session.ModuleId, incarnation: u64) err[fail.Fail] {
    ret acquire_load_view(ctx::*project.Project, mid, incarnation);
}

fun host_epoch(ctx: ptr) u64 {
    ret (ctx::*project.Project).s.queries.operation_sequence;
}

fun host_context(ctx: ptr, artifact: intern.StrId) res[comptime.ComptimeCtx, fail.Fail] {
    ret artifact_context(ctx::*project.Project, artifact);
}

fun host_done(ctx: ptr, mid: session.ModuleId) err[fail.Fail] {
    ret topo_push(ctx::*project.Project, mid);
}

# load the module `fqn` names and everything it reaches
pub fun module_load(p: *project.Project, fqn: intern.StrId) res[session.ModuleId, fail.Fail] {
    val l: res[*fe_load.Loader, fail.Fail] = loader_of(p);
    if (sel l.err) { ret res[session.ModuleId, fail.Fail].err{l.err}; }
    ret fe_load.module_load(l.ok, fqn);
}

# parse the module `fqn` names as a root, without walking it
pub fun module_open(p: *project.Project, fqn: intern.StrId) res[session.ModuleId, fail.Fail] {
    val l: res[*fe_load.Loader, fail.Fail] = loader_of(p);
    if (sel l.err) { ret res[session.ModuleId, fail.Fail].err{l.err}; }
    ret fe_load.module_open(l.ok, fqn);
}

# reparse and re-walk one loaded module after its text changed, and say whether its load surface
# survived, so the project's other modules stand as they are; every product the project holds of
# the module is dropped, since each is keyed by the old syntax tree
pub fun module_reload(p: *project.Project, mid: session.ModuleId) res[bool, fail.Fail] {
    val l: res[*fe_load.Loader, fail.Fail] = loader_of(p);
    if (sel l.err) { ret res[bool, fail.Fail].err{l.err}; }
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    project.lower_scope_drop(m);
    m.resolve_result     = nil;
    m.resolved           = false;
    m.sema_result        = nil;
    m.ir_module          = nil;
    m.object_image       = nil;
    m.staged_image       = nil;
    m.cache_checked      = false;
    m.cache_hit          = false;
    m.cache_keyed        = false;
    m.frontend_skipped   = false;
    m.test.ir_module     = nil;
    m.test.object_image  = nil;
    m.test.staged_image  = nil;
    m.test.cache_checked = false;
    m.test.cache_hit     = false;
    m.parse_status       = fail.accepted();
    ret fe_load.module_reload(l.ok, mid);
}

# record the strings a module's decorator arguments evaluate to
pub fun decorators_record(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val l: res[*fe_load.Loader, fail.Fail] = loader_of(p);
    if (sel l.err) { ret err[fail.Fail].err{l.err}; }
    ret fe_load.decorators_record(l.ok, mid);
}

fun acquire_parse_view(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val m:        *project.ModuleEntry            = project.module_at(p, mid::u32);
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_PARSE, lang_source.file_index(m.file_id)::u64);
    if (sel acquired.err) {
        val failure: fail.Fail = acquired.err;
        if (sel failure.reported) { fail.reject(?m.parse_status); }
        or                        { fail.internal(?m.parse_status, fail.describe(failure)); }
        ret err[fail.Fail].err{failure};
    }
    val owner: query.QueryView = acquired.ok;
    val a:     *ast.Ast        = ast_handle_decode(owner);
    if (a == nil) { ret err[fail.Fail].err{fail.message("Q_PARSE produced no AST handle")}; }
    m.a            = a;
    m.parse_status = (owner.value::ptr::*ParsedModule).status;
    ret err[fail.Fail].ok{};
}

fun acquire_load_view(p: *project.Project, mid: session.ModuleId, incarnation: u64) err[fail.Fail] {
    val begun: res[query.Operation, fail.Fail] = project.begin_query_phase(p);
    if (sel begun.err) { ret err[fail.Fail].err{begun.err}; }
    val operation: query.Operation = begun.ok;
    var result:    err[fail.Fail]  = err[fail.Fail].ok{};
    val acquired:  err[fail.Fail]  = acquire_parse_view(p, mid);
    if (sel acquired.err) { result = err[fail.Fail].err{acquired.err}; }
    or (incarnation != 0 && project.module_at(p, mid::u32).a.incarnation != incarnation) {
        result = err[fail.Fail].err{fail.message("module syntax changed during dependency discovery")};
    }
    var root:  query.QueryKey = query.QueryKey{kind: query.Q_PARSE, key: lang_source.file_index(project.module_at(p, mid::u32).file_id)::u64};
    var count: usize          = 0;
    if (sel result.err) { count = 1; }
    val finished: err[fail.Fail] = project.finish_query_phase(p, operation, ?root, count, result);
    if (sel finished.err) { ret err[fail.Fail].err{finished.err}; }
    ret err[fail.Fail].ok{};
}

pub fun parsed_definition(ctx: ptr, mid: session.ModuleId) res[resolve.ParsedDefinition, fail.Fail] {
    val p: *project.Project = ctx::*project.Project;
    if (p == nil || module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[resolve.ParsedDefinition, fail.Fail].err{fail.message("parsed definition module is not in the active project")};
    }
    val m:        *project.ModuleEntry            = project.module_at(p, mid::u32);
    val file_id:  lang_source.FileId              = m.file_id;
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_PARSE, lang_source.file_index(file_id)::u64);
    if (sel acquired.err) { ret res[resolve.ParsedDefinition, fail.Fail].err{acquired.err}; }
    val owner: query.QueryView = acquired.ok;
    val a:     *ast.Ast        = ast_handle_decode(owner);
    if (a == nil) { ret res[resolve.ParsedDefinition, fail.Fail].err{fail.message("parsed definition query produced no AST owner")}; }
    val status: fail.PhaseStatus = (owner.value::ptr::*ParsedModule).status;
    m.a            = a;
    m.parse_status = status;
    ret res[resolve.ParsedDefinition, fail.Fail].ok{resolve.ParsedDefinition{a: a, status: status, owner: resolve.type_owner(p.s, mid, file_id), incarnation: a.incarnation}};
}

pub fun q_parse_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val db:      *query.QueryDb     = ?p.s.queries;
    val s:       *session.Session   = p.s;
    val file_id: lang_source.FileId = lang_source.file_id(key::u32);

    val rd: err[fail.Fail] = query.depend[project.Project](?p.queries, p, query.Q_FILE_TEXT, key);
    if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }

    val file_opt: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, file_id);
    if (sel file_opt.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_PARSE: FileId not registered with the session")}; }
    val file: *lang_source.SourceFile = file_opt.some;

    val tok_r: res[fe_lexer.TokenStream, fail.Fail] = fe_lexer.tokenize(file.text, alloc, file_id);
    if (sel tok_r.err) { ret res[query.QueryOutput, fail.Fail].err{tok_r.err}; }
    var stream: fe_lexer.TokenStream = tok_r.ok;

    val ar: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](alloc, 1::usize);
    if (sel ar.err) {
        fe_lexer.dnit(?stream, alloc);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(ar.err)};
    }
    val a: *ast.Ast = ar.ok;
    a[0] = ast.init(alloc, file_id);
    val incarnation: res[u64, fail.Fail] = session.next_parse_incarnation(s);
    if (sel incarnation.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1);
        fe_lexer.dnit(?stream, alloc);
        ret res[query.QueryOutput, fail.Fail].err{incarnation.err};
    }
    a.incarnation = incarnation.ok;

    val le_r: err[fail.Fail] = fe_lexer.emit_diagnostics(?stream, diags);
    if (sel le_r.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        fe_lexer.dnit(?stream, alloc);
        ret res[query.QueryOutput, fail.Fail].err{le_r.err};
    }
    val parse_r: res[fail.PhaseStatus, state.ParseFail] = fe_parser.parse(?stream, a, diags);
    fe_lexer.dnit(?stream, alloc);
    if (sel parse_r.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        val f: state.ParseFail = parse_r.err;
        ret res[query.QueryOutput, fail.Fail].err{state.failure(f)};
    }

    ret ast_handle_encode(alloc, a, parse_r.ok);
}

rec ParsedModule {
    a:      *ast.Ast;
    status: fail.PhaseStatus;
}

pub fun q_parse_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    if (value == nil || value_len::usize < $size_of(ParsedModule)) { ret; }
    val a: *ast.Ast = (value::ptr::*ParsedModule).a;
    if (a == nil) { ret; }
    ast.dnit(a);
    A.deallocate[ast.Ast](alloc, a, 1::usize);
}

fun ast_handle_encode(alloc: *A.Allocator, a: *ast.Ast, status: fail.PhaseStatus) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ParsedModule)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8           = rb.ok;
    val slot: *ParsedModule = buf::ptr::*ParsedModule;
    slot.a      = a;
    slot.status = status;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun ast_handle_decode(e: query.QueryView) *ast.Ast {
    if (e.value == nil || e.value_len::usize < $size_of(ParsedModule)) { ret nil; }
    ret (e.value::ptr::*ParsedModule).a;
}

pub fun q_exports_compute(p: *project.Project, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, query.Q_RESOLVE, key);
    if (sel e_r.err) { ret res[query.QueryOutput, fail.Fail].err{e_r.err}; }
    val rr: *resolve.ResolveResult = driver_query.resolve_handle_decode(e_r.ok);
    if (rr == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("Q_EXPORTS: module has no resolve result")}; }

    var definition_revision: query.Revision = 0;
    var i:                   u32            = 0;
    for (i < rr.public_constant_count) {
        if (rr.public_constants[i].present && rr.public_constants[i].value.kind == comptime.CT_KIND_CONST_ELEM) {
            val mid: session.ModuleId = session.module_id_for_stable(p.s, key::u32::session.StableModuleId);
            if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("constant definition is not loaded")}; }
            val observed: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p,
                query.Q_PARSE, lang_source.file_index(project.module_at(p, mid::u32).file_id)::u64);
            if (sel observed.err) { ret res[query.QueryOutput, fail.Fail].err{observed.err}; }
            definition_revision = observed.ok;
            brk;
        }
        i = i + 1;
    }
    var fb: wire.Sink = wire.grown(alloc);
    fin { wire.dnit(?fb); }
    val wr: err[fail.Fail] = driver_query.public_surface_encode(?fb, rr, key::u32::session.StableModuleId, definition_revision);
    if (sel wr.err) { ret res[query.QueryOutput, fail.Fail].err{wr.err}; }
    ret driver_query.output(?fb);
}

pub fun rebuild_topo(p: *project.Project, emit_roots: *session.ModuleId, emit_root_count: u32) err[fail.Fail] {
    if (project.module_count(p) == 0) {
        p.topo_len = 0;
        ret err[fail.Fail].ok{};
    }
    val ir: res[*bool, A.Error] = A.allocate[bool](p.alloc, project.module_count(p)::usize);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    val included: *bool             = ir.ok;
    val sr:       res[*u8, A.Error] = A.allocate[u8](p.alloc, project.module_count(p)::usize);
    if (sel sr.err) {
        A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
        ret err[fail.Fail].err{fail.refused(sr.err)};
    }
    val state: *u8                 = sr.ok;
    val er:    res[*bool, A.Error] = A.allocate[bool](p.alloc, project.module_count(p)::usize);
    if (sel er.err) {
        A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
        A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
        ret err[fail.Fail].err{fail.refused(er.err)};
    }
    val emitted: *bool = er.ok;
    var i:       u32   = 0;
    for (i < project.module_count(p)) {
        included[i] = false;
        emitted[i]  = false;
        state[i]    = 0;
        i           = i + 1;
    }
    i = 0;
    for (i < p.topo_len) {
        included[p.topo[i]::u32] = true;
        i                        = i + 1;
    }
    i = 0;
    for (i < emit_root_count) {
        mark_emitted_deps(p, emit_roots[i], emitted);
        i = i + 1;
    }

    val tr: res[*session.ModuleId, A.Error] = A.allocate[session.ModuleId](p.alloc, project.module_count(p)::usize);
    if (sel tr.err) {
        A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
        A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
        A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
        ret err[fail.Fail].err{fail.refused(tr.err)};
    }
    val ordered:     *session.ModuleId = tr.ok;
    var ordered_len: u32               = 0;
    i = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (!emitted[mid::u32]) {
            i = i + 1;
            cnt;
        }
        val vr: err[fail.Fail] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (sel vr.err) {
            A.deallocate[session.ModuleId](p.alloc, ordered, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
            A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
            ret vr;
        }
        i = i + 1;
    }
    i = 0;
    for (i < p.topo_len) {
        val mid: session.ModuleId = p.topo[i];
        if (emitted[mid::u32]) {
            i = i + 1;
            cnt;
        }
        val vr: err[fail.Fail] = topo_visit(p, mid, included, state, ordered, ?ordered_len);
        if (sel vr.err) {
            A.deallocate[session.ModuleId](p.alloc, ordered, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
            A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
            A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
            ret vr;
        }
        i = i + 1;
    }

    if (p.topo != nil && p.topo_cap > 0) {
        A.deallocate[session.ModuleId](p.alloc, p.topo, p.topo_cap::usize);
    }
    p.topo     = ordered;
    p.topo_len = ordered_len;
    p.topo_cap = project.module_count(p);
    p.emit_len = 0;
    for (p.emit_len < p.topo_len && emitted[p.topo[p.emit_len]::u32]) {
        p.emit_len = p.emit_len + 1;
    }
    A.deallocate[bool](p.alloc, emitted, project.module_count(p)::usize);
    A.deallocate[u8](p.alloc, state, project.module_count(p)::usize);
    A.deallocate[bool](p.alloc, included, project.module_count(p)::usize);
    ret err[fail.Fail].ok{};
}

fun mark_emitted_deps(p: *project.Project, mid: session.ModuleId, emitted: *bool) {
    if (mid::u32 >= project.module_count(p) || emitted[mid::u32]) { ret; }
    emitted[mid::u32] = true;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: usize                = 0;
    for (i < m.load.deps.len) {
        mark_emitted_deps(p, fe_load.module_of(?p.loader, m.load.deps.data[i]), emitted);
        i = i + 1;
    }
}

fun topo_visit(p: *project.Project, mid: session.ModuleId, included: *bool, state: *u8,
    ordered: *session.ModuleId, ordered_len: *u32) err[fail.Fail] {
    if (mid::u32 >= project.module_count(p) || !included[mid::u32]) { ret err[fail.Fail].ok{}; }
    if (state[mid::u32] == 2)                                       { ret err[fail.Fail].ok{}; }
    if (state[mid::u32] == 1)                                       { ret err[fail.Fail].err{fail.message("circular module dependency through a module a union target tuple reached late")}; }
    state[mid::u32] = 1;
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    var i: usize                = 0;
    for (i < m.load.deps.len) {
        val vr: err[fail.Fail] = topo_visit(p, fe_load.module_of(?p.loader, m.load.deps.data[i]), included, state, ordered, ordered_len);
        if (sel vr.err) { ret vr; }
        i = i + 1;
    }
    state[mid::u32]       = 2;
    ordered[@ordered_len] = mid;
    @ordered_len          = @ordered_len + 1;
    ret err[fail.Fail].ok{};
}

fun topo_push(p: *project.Project, mid: session.ModuleId) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[session.ModuleId](p.alloc, ?p.topo, ?p.topo_cap, p.topo_len::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    p.topo[p.topo_len] = mid;
    p.topo_len         = p.topo_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun register_module_asts(p: *project.Project) err[fail.Fail] {
    var roots: collections_vector.Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        if (lang_source.file_is_nil(m.file_id)) {
            i = i + 1;
            cnt;
        }
        var num: u32            = i;
        val rn:  err[fail.Fail] = query.set_input(?p.s.queries, query.Q_MODULE_NUMBER, module.stable_index(m.stable_id)::u64, (?num)::*u8, 4);
        if (sel rn.err) { ret rn; }
        val saved: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots, query.QueryKey{kind: query.Q_PARSE, key: lang_source.file_index(m.file_id)::u64});
        if (sel saved.err) { ret err[fail.Fail].err{fail.refused(saved.err)}; }
        i = i + 1;
    }
    val begun: res[query.Operation, fail.Fail] = project.begin_query_phase(p);
    if (sel begun.err) { ret err[fail.Fail].err{begun.err}; }
    val operation: query.Operation = begun.ok;
    var result:    err[fail.Fail]  = err[fail.Fail].ok{};
    i = 0;
    for (i < project.module_count(p)) {
        if (lang_source.file_is_nil(project.module_at(p, i).file_id)) {
            i = i + 1;
            cnt;
        }
        val acquired: err[fail.Fail] = acquire_parse_view(p, i::session.ModuleId);
        if (sel acquired.err) {
            result = err[fail.Fail].err{acquired.err};
            brk;
        }
        val m:          *project.ModuleEntry = project.module_at(p, i);
        val registered: err[fail.Fail]       = session.register_module_identity(p.s, module.id(i), m.a, m.fqn, m.stable_id);
        if (sel registered.err) {
            result = err[fail.Fail].err{registered.err};
            brk;
        }
        i = i + 1;
    }
    val finished: err[fail.Fail] = project.finish_query_phase(p, operation, roots.data, roots.len, result);
    if (sel finished.err) {
        var j: u32 = 0;
        for (j < i) {
            session.unregister_module_identity(p.s, module.id(j), project.module_at(p, j).stable_id);
            j = j + 1;
        }
        ret err[fail.Fail].err{finished.err};
    }
    ret err[fail.Fail].ok{};
}

pub fun acquire_loaded_parses(p: *project.Project) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        if (!lang_source.file_is_nil(project.module_at(p, i).file_id)) {
            val acquired: err[fail.Fail] = acquire_parse_view(p, i::session.ModuleId);
            if (sel acquired.err) { ret acquired; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun collect_loaded_parses(p: *project.Project, primary: err[fail.Fail]) err[fail.Fail] {
    var roots: collections_vector.Vector[query.QueryKey] = collections_vector.init[query.QueryKey](p.alloc);
    fin { collections_vector.dnit[query.QueryKey](?roots); }
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val file: lang_source.FileId = project.module_at(p, i).file_id;
        if (!lang_source.file_is_nil(file)) {
            val added: res[usize, A.Error] = collections_vector.push[query.QueryKey](?roots, query.QueryKey{kind: query.Q_PARSE, key: lang_source.file_index(file)::u64});
            if (sel added.err) {
                diagnostic.note_lost(?p.diags);
                diagnostic.note_lost(?p.s.diags);
                if (sel primary.err) { ret primary; }
                ret err[fail.Fail].err{fail.refused(added.err)};
            }
        }
        i = i + 1;
    }
    val begun: res[query.Operation, fail.Fail] = project.begin_query_phase(p);
    if (sel begun.err) {
        if (sel primary.err) { ret primary; }
        ret err[fail.Fail].err{begun.err};
    }
    val operation: query.Operation = begun.ok;
    var result:    err[fail.Fail]  = primary;
    i = 0;
    for (i < project.module_count(p)) {
        if (!lang_source.file_is_nil(project.module_at(p, i).file_id)) {
            val acquired: err[fail.Fail] = acquire_parse_view(p, i::session.ModuleId);
            if (sel acquired.err) {
                val result_ok: bool = sel result.ok;
                if (result_ok) { result = err[fail.Fail].err{acquired.err}; }
                brk;
            }
        }
        i = i + 1;
    }
    ret project.finish_query_phase(p, operation, roots.data, roots.len, result);
}
