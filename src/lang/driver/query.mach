use std.types.canonical.opt;
use std.types.canonical.res;
use std.types.canonical.err;
use outcome: mach.lang.build.outcome;
use std.crypto.hash.sha256;
use std.memory;
use vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use page: std.allocator.page;
use binary: std.encoding.binary;

use A: std.allocator;

use mach.lang.build.fingerprint;
use mach.lang.deprecation;
use mach.lang.fail;
use mach.lang.fe.resolve;
use scx: mach.lang.fe.sema.context;
use mach.lang.fe.sema.fields;
use mach.lang.type;
use mach.lang.fe.comptime;
use mach.lang.fe.ast.id;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.source;
use mach.lang.query;
use mach.lang.target.of;

pub rec FpBuf {
    alloc: *A.Allocator;
    buf:   *u8;
    len:   usize;
    cap:   usize;
}

fun fp_next_capacity(cap: usize, required: usize) res[usize, fail.Fail] {
    if (required <= cap) { ret res[usize, fail.Fail].ok{cap}; }
    var new_cap: usize = cap;
    if (new_cap == 0) { new_cap = 64; }
    for (required > new_cap) {
        if (new_cap > ~(0::usize) / 2) { new_cap = required; }
        or { new_cap = new_cap * 2; }
    }
    ret res[usize, fail.Fail].ok{new_cap};
}

fun fp_reserve(b: *FpBuf, extra: usize) err[fail.Fail] {
    if (extra > ~(0::usize) - b.len) {
        ret err[fail.Fail].err{fail.message("fingerprint buffer length overflow")};
    }
    val required: usize = b.len + extra;
    if (required <= b.cap) { ret err[fail.Fail].ok{}; }
    val nc: res[usize, fail.Fail] = fp_next_capacity(b.cap, required);
    if (sel nc.err) { ret err[fail.Fail].err{nc.err}; }
    val new_cap: usize = nc.ok;
    if (b.buf == nil) {
        val r: res[*u8, A.Error] = A.allocate[u8](b.alloc, new_cap);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        b.buf = r.ok;
    } or {
        val r: res[*u8, A.Error] = A.reallocate[u8](b.alloc, b.buf, b.cap, new_cap);
        if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
        b.buf = r.ok;
    }
    b.cap = new_cap;
    ret err[fail.Fail].ok{};
}

pub fun fp_u8(b: *FpBuf, v: u8) err[fail.Fail] {
    val r: err[fail.Fail] = fp_reserve(b, 1);
    if (sel r.err) { ret r; }
    b.buf[b.len] = v;
    b.len = b.len + 1;
    ret err[fail.Fail].ok{};
}

pub fun fp_u32(b: *FpBuf, v: u32) err[fail.Fail] {
    val r: err[fail.Fail] = fp_reserve(b, 4);
    if (sel r.err) { ret r; }
    b.buf[b.len]     = (v & 0xFF)::u8;
    b.buf[b.len + 1] = ((v >> 8) & 0xFF)::u8;
    b.buf[b.len + 2] = ((v >> 16) & 0xFF)::u8;
    b.buf[b.len + 3] = ((v >> 24) & 0xFF)::u8;
    b.len = b.len + 4;
    ret err[fail.Fail].ok{};
}

pub fun fp_u16(b: *FpBuf, v: u16) err[fail.Fail] {
    val r: err[fail.Fail] = fp_reserve(b, 2);
    if (sel r.err) { ret r; }
    b.buf[b.len]     = (v & 0xFF)::u8;
    b.buf[b.len + 1] = ((v >> 8) & 0xFF)::u8;
    b.len = b.len + 2;
    ret err[fail.Fail].ok{};
}

pub fun fp_domain_u8(b: *FpBuf, domain: fingerprint.Domain, schema_version: u8, value: u8) err[fail.Fail] {
    val rd: err[fail.Fail] = fp_u16(b, domain);
    if (sel rd.err) { ret rd; }
    val rs: err[fail.Fail] = fp_u8(b, schema_version);
    if (sel rs.err) { ret rs; }
    ret fp_u8(b, value);
}

pub fun fp_bytes(b: *FpBuf, p: *u8, len: u32) err[fail.Fail] {
    if (len == 0) { ret err[fail.Fail].ok{}; }
    val r: err[fail.Fail] = fp_reserve(b, len::usize);
    if (sel r.err) { ret r; }
    memory.raw_copy((?b.buf[b.len])::ptr, p::ptr, len::usize);
    b.len = b.len + len::usize;
    ret err[fail.Fail].ok{};
}

pub fun resolve_handle_encode(alloc: *A.Allocator, r: *resolve.ResolveResult) res[query.QueryOutput, fail.Fail] {
    val n: u32 = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        resolve.dnit_result(r);
        A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf: *u8 = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

pub fun resolve_handle_decode(e: query.QueryView) *resolve.ResolveResult {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*resolve.ResolveResult;
}

pub fun fp_file_content(fb: *FpBuf, path: *u8) err[fail.Fail] {
    if (path == nil) { ret fp_u32(fb, 0); }
    var digest: [32]u8;
    val rr: err[outcome.Fail] = fingerprint.file_sha256(path::str, ?digest[0]);
    if (sel rr.err) { ret err[fail.Fail].err{fail.message(outcome.describe(rr.err))}; }

    val rl: err[fail.Fail] = fp_u32(fb, sha256.DIGEST_SIZE::u32);
    if (sel rl.err) { ret rl; }
    var i: u32 = 0;
    for (i < sha256.DIGEST_SIZE::u32) {
        val rb: err[fail.Fail] = fp_u8(fb, digest[i]);
        if (sel rb.err) { ret rb; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun fp_content(fb: *FpBuf, bytes: *u8, len: usize) err[fail.Fail] {
    if (bytes == nil) { ret fp_u32(fb, 0); }
    var digest: [32]u8;
    sha256.hash(bytes, len, ?digest[0]);
    val rl: err[fail.Fail] = fp_u32(fb, sha256.DIGEST_SIZE::u32);
    if (sel rl.err) { ret rl; }
    var i: u32 = 0;
    for (i < sha256.DIGEST_SIZE::u32) {
        val rb: err[fail.Fail] = fp_u8(fb, digest[i]);
        if (sel rb.err) { ret rb; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun fp_u64(b: *FpBuf, v: u64) err[fail.Fail] {
    val lo: err[fail.Fail] = fp_u32(b, (v & 0xFFFFFFFF)::u32);
    if (sel lo.err) { ret lo; }
    ret fp_u32(b, (v >> 32)::u32);
}

pub fun fp_cstr(b: *FpBuf, s: *u8) err[fail.Fail] {
    if (s == nil) { ret fp_u32(b, 0); }
    val len: usize = str_len(s::str);
    if (len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.message("fingerprint string exceeds 32-bit length")}; }
    val n: u32 = len::u32;
    val rl: err[fail.Fail] = fp_u32(b, n);
    if (sel rl.err) { ret rl; }
    var i: u32 = 0;
    for (i < n) {
        val rb: err[fail.Fail] = fp_u8(b, s[i]);
        if (sel rb.err) { ret rb; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun fp_name(b: *FpBuf, itn: *intern.Interner, name: intern.StrId) err[fail.Fail] {
    if (name == intern.STR_NIL) { ret fp_u8(b, 0); }
    val text: opt[str] = intern.lookup(itn, name);
    if (sel text.none) { ret err[fail.Fail].err{fail.message("fingerprint name is absent from its interner")}; }
    val present: err[fail.Fail] = fp_u8(b, 1);
    if (sel present.err) { ret present; }
    ret fp_cstr(b, text.some);
}

pub fun fp_free(fb: *FpBuf) {
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](fb.alloc, fb.buf, fb.cap); }
    fb.buf = nil;
    fb.len = 0;
    fb.cap = 0;
}

pub fun fp_input_len(fb: *FpBuf) res[u32, fail.Fail] {
    if (fb.len > 0xFFFFFFFF::usize) {
        ret res[u32, fail.Fail].err{fail.message("fingerprint exceeds 32-bit query input length")};
    }
    ret res[u32, fail.Fail].ok{fb.len::u32};
}

pub fun fp_take(fb: *FpBuf) res[query.QueryOutput, fail.Fail] {
    var out: query.QueryOutput;
    out.bytes = nil;
    out.len   = 0;

    val lr: res[u32, fail.Fail] = fp_input_len(fb);
    if (sel lr.err) {
        fp_free(fb);
        ret res[query.QueryOutput, fail.Fail].err{lr.err};
    }

    if (fb.buf == nil || fb.len == 0) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](fb.alloc, fb.buf, fb.cap); }
        fb.buf = nil;
        fb.len = 0;
        fb.cap = 0;
        ret res[query.QueryOutput, fail.Fail].ok{out};
    }

    if (fb.len < fb.cap) {
        val r: res[*u8, A.Error] = A.reallocate[u8](fb.alloc, fb.buf, fb.cap, fb.len);
        if (sel r.err) {
            A.deallocate[u8](fb.alloc, fb.buf, fb.cap);
            fb.buf = nil;
            fb.len = 0;
            fb.cap = 0;
            ret res[query.QueryOutput, fail.Fail].err{fail.refused(r.err)};
        }
        fb.buf = r.ok;
        fb.cap = fb.len;
    }

    out.bytes = fb.buf;
    out.len   = lr.ok;
    fb.buf = nil;
    fb.cap = 0;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

test "mach.lang.driver.query:fingerprint_capacity_checks_boundaries" {
    val grown: res[usize, fail.Fail] = fp_next_capacity((~(0::usize) / 2) + 1, ~(0::usize));
    if (sel grown.err) { ret 1; }
    if (grown.ok != ~(0::usize)) { ret 1; }

    var fb: FpBuf;
    fb.alloc = nil;
    fb.buf = nil;
    fb.len = ~(0::usize);
    fb.cap = ~(0::usize);
    val overflow: err[fail.Fail] = fp_u8(?fb, 0);
    if (sel overflow.ok) { ret 1; }
    ret 0;
}

test "mach.lang.driver.query:fingerprint_query_length_is_explicit" {
    var fb: FpBuf;
    fb.alloc = nil;
    fb.buf = nil;
    fb.len = 0x100000000::usize;
    fb.cap = 0;
    val too_large: res[query.QueryOutput, fail.Fail] = fp_take(?fb);
    if (sel too_large.ok) { ret 1; }
    if (fb.buf != nil || fb.len != 0 || fb.cap != 0) { ret 1; }

    fb.len = 0xFFFFFFFF::usize;
    val boundary: res[u32, fail.Fail] = fp_input_len(?fb);
    if (sel boundary.err) { ret 1; }
    if (boundary.ok != 0xFFFFFFFF) { ret 1; }
    ret 0;
}

fun fp_bytes_eq(a: *u8, b: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver.query:fp_domain_u8_deterministic" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var fb_a: FpBuf;
    fb_a.alloc = ?alloc; fb_a.buf = nil; fb_a.len = 0; fb_a.cap = 0;
    var fb_b: FpBuf;
    fb_b.alloc = ?alloc; fb_b.buf = nil; fb_b.len = 0; fb_b.cap = 0;

    val fp_domain_u8_r: err[fail.Fail] = fp_domain_u8(?fb_a, fingerprint.DOMAIN_SUBSYSTEM, 1, 2);
    if (sel fp_domain_u8_r.err) { ret 1; }
    val fp_domain_u8_r2: err[fail.Fail] = fp_domain_u8(?fb_b, fingerprint.DOMAIN_SUBSYSTEM, 1, 2);
    if (sel fp_domain_u8_r2.err) { ret 1; }

    if (fb_a.len != fb_b.len)                      { ret 1; }
    if (!fp_bytes_eq(fb_a.buf, fb_b.buf, fb_a.len)) { ret 1; }

    if (fb_a.buf != nil && fb_a.cap > 0) { A.deallocate[u8](?alloc, fb_a.buf, fb_a.cap); }
    if (fb_b.buf != nil && fb_b.cap > 0) { A.deallocate[u8](?alloc, fb_b.buf, fb_b.cap); }
    ret 0;
}

test "mach.lang.driver.query:fp_domain_u8_domain_separated" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var fb_a: FpBuf;
    fb_a.alloc = ?alloc; fb_a.buf = nil; fb_a.len = 0; fb_a.cap = 0;
    var fb_b: FpBuf;
    fb_b.alloc = ?alloc; fb_b.buf = nil; fb_b.len = 0; fb_b.cap = 0;

    val fp_domain_u8_r: err[fail.Fail] = fp_domain_u8(?fb_a, 1, 1, 5);
    if (sel fp_domain_u8_r.err) { ret 1; }
    val fp_domain_u8_r2: err[fail.Fail] = fp_domain_u8(?fb_b, 2, 1, 5);
    if (sel fp_domain_u8_r2.err) { ret 1; }

    if (fb_a.len != fb_b.len)                          { ret 1; }
    if (fp_bytes_eq(fb_a.buf, fb_b.buf, fb_a.len))      { ret 1; }

    if (fb_a.buf != nil && fb_a.cap > 0) { A.deallocate[u8](?alloc, fb_a.buf, fb_a.cap); }
    if (fb_b.buf != nil && fb_b.cap > 0) { A.deallocate[u8](?alloc, fb_b.buf, fb_b.cap); }
    ret 0;
}

test "mach.lang.driver.query:fp_domain_u8_schema_and_value_separated" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    var fb_a: FpBuf;
    fb_a.alloc = ?alloc; fb_a.buf = nil; fb_a.len = 0; fb_a.cap = 0;
    var fb_b: FpBuf;
    fb_b.alloc = ?alloc; fb_b.buf = nil; fb_b.len = 0; fb_b.cap = 0;
    var fb_c: FpBuf;
    fb_c.alloc = ?alloc; fb_c.buf = nil; fb_c.len = 0; fb_c.cap = 0;

    val fp_domain_u8_r: err[fail.Fail] = fp_domain_u8(?fb_a, 1, 1, 5);
    if (sel fp_domain_u8_r.err) { ret 1; }
    val fp_domain_u8_r2: err[fail.Fail] = fp_domain_u8(?fb_b, 1, 2, 5);
    if (sel fp_domain_u8_r2.err) { ret 1; }
    val fp_domain_u8_r3: err[fail.Fail] = fp_domain_u8(?fb_c, 1, 1, 6);
    if (sel fp_domain_u8_r3.err) { ret 1; }

    if (fb_a.len != fb_b.len || fb_a.len != fb_c.len)   { ret 1; }
    if (fp_bytes_eq(fb_a.buf, fb_b.buf, fb_a.len))       { ret 1; }
    if (fp_bytes_eq(fb_a.buf, fb_c.buf, fb_a.len))       { ret 1; }

    if (fb_a.buf != nil && fb_a.cap > 0) { A.deallocate[u8](?alloc, fb_a.buf, fb_a.cap); }
    if (fb_b.buf != nil && fb_b.cap > 0) { A.deallocate[u8](?alloc, fb_b.buf, fb_b.cap); }
    if (fb_c.buf != nil && fb_c.cap > 0) { A.deallocate[u8](?alloc, fb_c.buf, fb_c.cap); }
    ret 0;
}

test "mach.lang.driver.query:fp_domain_u8_matches_fingerprint_encoder_framing" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }

    val tag: u8 = of.subsystem_fingerprint_tag(of.SUBSYSTEM_GUI);

    var e: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint.write_domain_u8(?e, fingerprint.DOMAIN_SUBSYSTEM, of.SUBSYSTEM_CATALOG_VERSION, tag)) { ret 1; }

    var fb: FpBuf;
    fb.alloc = ?alloc; fb.buf = nil; fb.len = 0; fb.cap = 0;
    val fp_domain_u8_r: err[fail.Fail] = fp_domain_u8(?fb, fingerprint.DOMAIN_SUBSYSTEM, of.SUBSYSTEM_CATALOG_VERSION, tag);
    if (sel fp_domain_u8_r.err) { ret 1; }

    if (e.len != fb.len)                       { ret 1; }
    if (!fp_bytes_eq(e.data, fb.buf, e.len))    { ret 1; }

    binary.encoder_dnit(?e);
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](?alloc, fb.buf, fb.cap); }
    ret 0;
}

pub fun fp_constant(fb: *FpBuf, item: *resolve.ExportConstant, origin: session.StableModuleId,
                    definition_revision: query.Revision) err[fail.Fail] {
    val name: err[fail.Fail] = fp_u32(fb, item.name::u32);
    if (sel name.err) { ret name; }
    var present: u8 = 0;
    if (item.present) { present = 1; }
    val presence: err[fail.Fail] = fp_u8(fb, present);
    if (sel presence.err) { ret presence; }
    if (!item.present) { ret presence; }
    var gated: u8 = 0;
    if (item.gated) { gated = 1; }
    val gate: err[fail.Fail] = fp_u8(fb, gated);
    if (sel gate.err) { ret gate; }
    val value: *comptime.CTValue = ?item.value;
    val kind: err[fail.Fail] = fp_u8(fb, value.kind);
    if (sel kind.err) { ret kind; }
    var low: u64 = 0;
    var high: u64 = 0;
    var width: u8 = 0;
    var unsigned: u8 = 0;
    if (value.kind == comptime.CT_KIND_INT) {
        low = value.data.i::u64;
        width = value.int_width;
        if (value.int_unsigned) { unsigned = 1; }
    } or (value.kind == comptime.CT_KIND_FLOAT) {
        low = float.f64_bits(value.data.f);
        width = value.float_width;
    } or (value.kind == comptime.CT_KIND_STR) {
        low = value.data.s::u64;
    } or (value.kind == comptime.CT_KIND_TYPE) {
        low = value.data.t::u64;
    } or (value.kind == comptime.CT_KIND_FIELD || value.kind == comptime.CT_KIND_CASE) {
        low = value.data.fld.owner::u64;
        high = value.data.fld.index::u64;
    } or (value.kind == comptime.CT_KIND_PACK_ELEM) {
        low = value.data.pelem.index::u64;
        high = value.data.pelem.ty::u64;
    } or (value.kind == comptime.CT_KIND_CONST_ELEM) {
        low = value.data.celem.elem::u64;
        high = value.data.celem.ty::u64;
        if (definition_revision == 0 || origin == session.STABLE_MODULE_NIL) {
            ret err[fail.Fail].err{fail.message("constant element surface requires its current definition revision")};
        }
    } or { ret err[fail.Fail].err{fail.message("constant surface has an unknown CTKind")}; }
    val signedness: err[fail.Fail] = fp_u8(fb, unsigned);
    if (sel signedness.err) { ret signedness; }
    val bits: err[fail.Fail] = fp_u8(fb, width);
    if (sel bits.err) { ret bits; }
    val lo: err[fail.Fail] = fp_u64(fb, low);
    if (sel lo.err) { ret lo; }
    val hi: err[fail.Fail] = fp_u64(fb, high);
    if (sel hi.err) { ret hi; }
    if (value.kind == comptime.CT_KIND_CONST_ELEM) {
        val module: err[fail.Fail] = fp_u32(fb, origin::u32);
        if (sel module.err) { ret module; }
        ret fp_u64(fb, definition_revision);
    }
    ret err[fail.Fail].ok{};
}

pub fun fp_public_surface(fb: *FpBuf, rr: *resolve.ResolveResult, origin: session.StableModuleId,
                          definition_revision: query.Revision) err[fail.Fail] {
    val count: err[fail.Fail] = fp_u32(fb, rr.pub_count);
    if (sel count.err) { ret count; }
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val symbol: *resolve.Symbol = ?rr.symbols[i];
        val kind: err[fail.Fail] = fp_u8(fb, symbol.definition_kind);
        if (sel kind.err) { ret kind; }
        val name: err[fail.Fail] = fp_u32(fb, symbol.name::u32);
        if (sel name.err) { ret name; }
        val canon: err[fail.Fail] = fp_u32(fb, symbol.canon::u32);
        if (sel canon.err) { ret canon; }
        val file: err[fail.Fail] = fp_u32(fb, symbol.definition_file::u32);
        if (sel file.err) { ret file; }
        val arity: err[fail.Fail] = fp_u32(fb, symbol.generic_arity);
        if (sel arity.err) { ret arity; }
        val comptime: err[fail.Fail] = fp_u8(fb, symbol.has_comptime_params::u8);
        if (sel comptime.err) { ret comptime; }
        val pack: err[fail.Fail] = fp_u8(fb, symbol.has_pack_param::u8);
        if (sel pack.err) { ret pack; }
        val notice: err[fail.Fail] = fp_deprecation(fb, symbol.deprecation);
        if (sel notice.err) { ret notice; }
        var slot: u32 = symbol.slot;
        if (symbol.definition_kind == resolve.SYM_USE) { slot = symbol.slot_stable::u32; }
        val slot_r: err[fail.Fail] = fp_u32(fb, slot);
        if (sel slot_r.err) { ret slot_r; }
        val module: err[fail.Fail] = fp_u32(fb, symbol.origin_stable::u32);
        if (sel module.err) { ret module; }
        i = i + 1;
    }
    val constants: err[fail.Fail] = fp_u32(fb, rr.public_constant_count);
    if (sel constants.err) { ret constants; }
    i = 0;
    for (i < rr.public_constant_count) {
        val item: err[fail.Fail] = fp_constant(fb, ?rr.public_constants[i], origin, definition_revision);
        if (sel item.err) { ret item; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun fp_deprecation(fb: *FpBuf, notice: deprecation.Deprecation) err[fail.Fail] {
    val present: err[fail.Fail] = fp_u8(fb, notice.present::u8);
    if (sel present.err) { ret present; }
    val owner: err[fail.Fail] = fp_u32(fb, notice.owner::u32);
    if (sel owner.err) { ret owner; }
    ret fp_u32(fb, notice.message::u32);
}

fun deprecation_decode(decoder: *binary.Decoder) res[deprecation.Deprecation, fail.Fail] {
    val present: res[u8, binary.DecodeError] = binary.read_u8(decoder);
    val owner: res[u32, binary.DecodeError] = binary.read_u32(decoder);
    val message: res[u32, binary.DecodeError] = binary.read_u32(decoder);
    if (sel present.err) {
        ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice is truncated")};
    }
    if (sel owner.err) {
        ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice is truncated")};
    }
    if (sel message.err) {
        ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice is truncated")};
    }
    if (present.ok > 1) { ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice flag is invalid")}; }
    ret res[deprecation.Deprecation, fail.Fail].ok{deprecation.Deprecation{ present: present.ok != 0,
        owner: owner.ok::source.FileId, message: message.ok::intern.StrId }};
}

pub fun public_symbols_decode(a: *A.Allocator, s: *session.Session, bytes: *u8, len: u32,
                              path: intern.StrId, module: session.ModuleId) res[resolve.ModuleExports, fail.Fail] {
    if (len < 8) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
    var decoder: binary.Decoder = binary.decoder(bytes, len::usize, binary.LITTLE);
    val count: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
    if (sel count.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message(outcome.decode_text(count.err))}; }
    val n: u32 = count.ok;
    if (n > (len - 8) / 36) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
    var out: resolve.ModuleExports = resolve.ModuleExports{ path: path, module: module };
    if (n == 0) { ret res[resolve.ModuleExports, fail.Fail].ok{out}; }
    val allocated: res[*resolve.PublicSymbol, A.Error] = A.allocate[resolve.PublicSymbol](a, n::usize);
    if (sel allocated.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.refused(allocated.err)}; }
    val symbols: *resolve.PublicSymbol = allocated.ok;
    var transferred: bool = false;
    fin { if (!transferred) { A.deallocate[resolve.PublicSymbol](a, symbols, n::usize); } }
    var i: u32 = 0;
    for (i < n) {
        val kind: res[u8, binary.DecodeError] = binary.read_u8(?decoder);
        val name: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val canon: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val file: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val arity: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val comptime: res[u8, binary.DecodeError] = binary.read_u8(?decoder);
        val pack: res[u8, binary.DecodeError] = binary.read_u8(?decoder);
        val notice: res[deprecation.Deprecation, fail.Fail] = deprecation_decode(?decoder);
        val slot: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val origin: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        if (sel kind.err) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")};
        }
        if (sel name.err) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")};
        }
        if (sel canon.err) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")};
        }
        if (sel file.err) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")};
        }
        if (sel arity.err) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")};
        }
        if (sel slot.err) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")};
        }
        if (sel origin.err) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")};
        }
        if (sel comptime.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
        if (sel pack.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
        if (sel notice.err) { ret res[resolve.ModuleExports, fail.Fail].err{notice.err}; }
        var symbol: resolve.PublicSymbol = resolve.PublicSymbol{};
        symbol.kind = kind.ok;
        if (!resolve.sym_kind_valid(symbol.kind)) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message(fail.catalog_message(?s.interner, a, fail.malformed_member("SymKind", symbol.kind::u32)))};
        }
        symbol.name = name.ok::intern.StrId;
        symbol.canon = canon.ok::intern.StrId;
        symbol.file = file.ok::source.FileId;
        symbol.generic_arity = arity.ok;
        if (comptime.ok > 1 || pack.ok > 1) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol call shape is invalid")}; }
        symbol.has_comptime_params = comptime.ok != 0;
        symbol.has_pack_param = pack.ok != 0;
        symbol.deprecation = notice.ok;
        symbol.slot = slot.ok;
        val stable: session.StableModuleId = origin.ok::session.StableModuleId;
        symbol.origin = session.module_id_for_stable(s, stable);
        if (stable != session.STABLE_MODULE_NIL && symbol.origin == session.MODULE_NIL) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol origin is not loaded")};
        }
        if (symbol.kind == resolve.SYM_USE) {
            val slot_stable: session.StableModuleId = symbol.slot::session.StableModuleId;
            symbol.slot = session.module_id_for_stable(s, slot_stable)::u32;
            if (slot_stable != session.STABLE_MODULE_NIL && symbol.slot == session.MODULE_NIL::u32) {
                ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public module slot is not loaded")};
            }
        }
        symbols[i] = symbol;
        i = i + 1;
    }
    out.symbols = symbols;
    out.count = n;
    transferred = true;
    ret res[resolve.ModuleExports, fail.Fail].ok{out};
}

test "mach.lang.driver.query.public_surface:canonical_name_is_owned_and_module_slots_are_remapped" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 1; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val register_stable_mid_r: err[fail.Fail] = session.register_stable_mid(?s, 17, 2);
    if (sel register_stable_mid_r.err) { ret 2; }
    val register_stable_mid_r2: err[fail.Fail] = session.register_stable_mid(?s, 18, 3);
    if (sel register_stable_mid_r2.err) { ret 3; }
    var symbol: resolve.Symbol = resolve.Symbol{ kind: resolve.SYM_USE, definition_kind: resolve.SYM_USE, name: 5, canon: 6,
        decl: 7, slot: 1, origin: 0, origin_stable: 17, slot_stable: 18 };
    var result: resolve.ResolveResult = resolve.ResolveResult{ symbols: ?symbol, pub_count: 1 };
    var before: FpBuf = FpBuf{ alloc: ?alloc };
    fin { fp_free(?before); }
    var after: FpBuf = FpBuf{ alloc: ?alloc };
    fin { fp_free(?after); }
    val fp_public_surface_r: err[fail.Fail] = fp_public_surface(?before, ?result, 17, 0);
    if (sel fp_public_surface_r.err) { ret 4; }
    symbol.canon = 0x78563412;
    val fp_public_surface_r2: err[fail.Fail] = fp_public_surface(?after, ?result, 17, 0);
    if (sel fp_public_surface_r2.err) { ret 5; }
    if (before.len != 44 || after.len != 44 || fp_bytes_eq(before.buf, after.buf, before.len)) { ret 6; }
    if (after.buf[9] != 0x12 || after.buf[10] != 0x34 || after.buf[11] != 0x56 || after.buf[12] != 0x78) { ret 7; }
    symbol.canon = 99;
    symbol.slot_stable = session.STABLE_MODULE_NIL;
    val decoded: res[resolve.ModuleExports, fail.Fail] = public_symbols_decode(?alloc, ?s, after.buf, after.len::u32, 4, 2);
    if (sel decoded.err) { ret 8; }
    val exports: resolve.ModuleExports = decoded.ok;
    fin { A.deallocate[resolve.PublicSymbol](?alloc, exports.symbols, exports.count::usize); }
    if (exports.count != 1 || exports.symbols[0].canon != 0x78563412) { ret 9; }
    if (exports.symbols[0].origin != 2 || exports.symbols[0].slot != 3) { ret 10; }
    ret 0;
}

test "mach.lang.driver.query.constant_surface:float_width_and_definition_revisions_are_observable" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var item: resolve.ExportConstant = resolve.ExportConstant{ name: 1, present: true };
    item.value.kind = comptime.CT_KIND_FLOAT;
    item.value.float_width = float.FLOAT_W_32;
    item.value.data.f = 1.5;
    var narrow: FpBuf = FpBuf{ alloc: ?alloc };
    fin { fp_free(?narrow); }
    var wide: FpBuf = FpBuf{ alloc: ?alloc };
    fin { fp_free(?wide); }
    val fp_constant_r: err[fail.Fail] = fp_constant(?narrow, ?item, 2, 0);
    if (sel fp_constant_r.err) { ret 1; }
    item.value.float_width = float.FLOAT_W_64;
    val fp_constant_r2: err[fail.Fail] = fp_constant(?wide, ?item, 2, 0);
    if (sel fp_constant_r2.err) { ret 2; }
    if (narrow.len != 25 || wide.len != 25 || narrow.buf[8] != 32 || wide.buf[8] != 64) { ret 3; }
    if (fp_bytes_eq(narrow.buf, wide.buf, narrow.len)) { ret 4; }
    fp_free(?narrow);
    fp_free(?wide);
    item.value = comptime.const_elem_value(7, 9);
    val fp_constant_r3: err[fail.Fail] = fp_constant(?narrow, ?item, 2, 100);
    if (sel fp_constant_r3.err) { ret 5; }
    val fp_constant_r4: err[fail.Fail] = fp_constant(?wide, ?item, 2, 101);
    if (sel fp_constant_r4.err) { ret 6; }
    if (narrow.len != 37 || wide.len != 37 || fp_bytes_eq(narrow.buf, wide.buf, narrow.len)) { ret 7; }
    fp_free(?wide);
    val fp_constant_r5: err[fail.Fail] = fp_constant(?wide, ?item, 2, 0);
    if (sel fp_constant_r5.ok) { ret 8; }
    ret 0;
}

test "mach.lang.driver.query.public_surface:definition_kind_changes_without_a_spelling_change" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var symbol: resolve.Symbol = resolve.Symbol{ kind: resolve.SYM_IMPORTED,
        definition_kind: resolve.SYM_FUN, name: 11, canon: 12, decl: 3,
        origin: 0, origin_stable: 4, slot_stable: session.STABLE_MODULE_NIL };
    var result: resolve.ResolveResult = resolve.ResolveResult{ symbols: ?symbol, pub_count: 1 };
    var function: FpBuf = FpBuf{ alloc: ?alloc };
    fin { fp_free(?function); }
    var value: FpBuf = FpBuf{ alloc: ?alloc };
    fin { fp_free(?value); }
    val fp_public_surface_r: err[fail.Fail] = fp_public_surface(?function, ?result, 4, 1);
    if (sel fp_public_surface_r.err) { ret 2; }
    symbol.definition_kind = resolve.SYM_VAL;
    val fp_public_surface_r2: err[fail.Fail] = fp_public_surface(?value, ?result, 4, 1);
    if (sel fp_public_surface_r2.err) { ret 3; }
    if (function.len != value.len || function.len != 44) { ret 4; }
    if (fp_bytes_eq(function.buf, value.buf, function.len)) { ret 5; }
    if (function.buf[4] != resolve.SYM_FUN || value.buf[4] != resolve.SYM_VAL) { ret 6; }
    ret 0;
}

# `itn` and `a` own a catalog rejection's text; a caller without them (a test
# fixture) still refuses the member with a static text naming the catalog
fun constant_decode(itn: *intern.Interner, a: *A.Allocator, decoder: *binary.Decoder, origin: session.StableModuleId,
                    incarnation: *u64) res[resolve.ExportConstant, fail.Fail] {
    var item: resolve.ExportConstant = resolve.ExportConstant{};
    @incarnation = 0;
    val name: res[u32, binary.DecodeError] = binary.read_u32(decoder);
    val present: res[u8, binary.DecodeError] = binary.read_u8(decoder);
    if (sel name.err) { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")}; }
    if (sel present.err) { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")}; }
    item.name = name.ok::intern.StrId;
    val presence: u8 = present.ok;
    if (presence > 1) { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant presence is invalid")}; }
    if (presence == 0) { ret res[resolve.ExportConstant, fail.Fail].ok{item}; }
    item.present = true;
    val gated: res[u8, binary.DecodeError] = binary.read_u8(decoder);
    val kind: res[u8, binary.DecodeError] = binary.read_u8(decoder);
    val unsigned: res[u8, binary.DecodeError] = binary.read_u8(decoder);
    val width: res[u8, binary.DecodeError] = binary.read_u8(decoder);
    val low: res[u64, binary.DecodeError] = binary.read_u64(decoder);
    val high: res[u64, binary.DecodeError] = binary.read_u64(decoder);
    if (sel gated.err) {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")};
    }
    if (sel kind.err) {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")};
    }
    if (sel unsigned.err) {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")};
    }
    if (sel width.err) {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")};
    }
    if (sel low.err) {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")};
    }
    if (sel high.err) {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")};
    }
    if (gated.ok > 1 || unsigned.ok > 1) {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant flags are invalid")};
    }
    item.gated = gated.ok != 0;
    item.value.kind = kind.ok;
    val lo: u64 = low.ok;
    val hi: u64 = high.ok;
    val bits: u8 = width.ok;
    if (item.value.kind == comptime.CT_KIND_INT) {
        item.value.data.i = lo::i64;
        item.value.int_unsigned = unsigned.ok != 0;
        item.value.int_width = bits;
    } or (item.value.kind == comptime.CT_KIND_FLOAT) {
        item.value.data.f = float.bits_f64(lo);
        item.value.float_width = bits;
    } or (item.value.kind == comptime.CT_KIND_STR) {
        item.value.data.s = lo::intern.StrId;
    } or (item.value.kind == comptime.CT_KIND_TYPE) {
        item.value.data.t = lo::u32;
    } or (item.value.kind == comptime.CT_KIND_FIELD || item.value.kind == comptime.CT_KIND_CASE) {
        item.value.data.fld.owner = lo::u32;
        item.value.data.fld.index = hi::u32;
    } or (item.value.kind == comptime.CT_KIND_PACK_ELEM) {
        item.value.data.pelem.index = lo::u32;
        item.value.data.pelem.ty = hi::u32;
    } or (item.value.kind == comptime.CT_KIND_CONST_ELEM) {
        item.value.data.celem.elem = lo::u32;
        item.value.data.celem.ty = hi::u32;
        val module: res[u32, binary.DecodeError] = binary.read_u32(decoder);
        val revision: res[u64, binary.DecodeError] = binary.read_u64(decoder);
        if (sel module.err) {
            ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant element has no matching parsed definition")};
        }
        if (sel revision.err) {
            ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant element has no matching parsed definition")};
        }
        if (module.ok != origin::u32 || revision.ok == 0) {
            ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant element has no matching parsed definition")};
        }
        @incarnation = revision.ok;
    } or {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message(fail.catalog_message_or(itn, a, fail.malformed_member("CTKind", item.value.kind::u32),
            "constant surface has an unknown CTKind"))};
    }
    ret res[resolve.ExportConstant, fail.Fail].ok{item};
}

pub fun typed_surface_encode(fb: *FpBuf, surface: *scx.ModuleSema) err[fail.Fail] {
    if (surface.exports.len > 0xFFFFFFFF::usize || surface.graph.nodes.len > 0xFFFFFFFF::usize) {
        ret err[fail.Fail].err{fail.message("typed surface exceeds its row count extent")};
    }
    val count: err[fail.Fail] = fp_u32(fb, surface.exports.len::u32);
    if (sel count.err) { ret count; }
    var i: usize = 0;
    for (i < surface.exports.len) {
        val row: *scx.TypeExport = ?surface.exports.data[i];
        val origin: err[fail.Fail] = fp_u32(fb, row.origin::u32);
        if (sel origin.err) { ret origin; }
        val canon: err[fail.Fail] = fp_u32(fb, row.canon::u32);
        if (sel canon.err) { ret canon; }
        val ty: err[fail.Fail] = fp_u32(fb, row.ty::u32);
        if (sel ty.err) { ret ty; }
        val constant: err[fail.Fail] = fp_constant(fb, ?row.constant, row.origin, row.definition_incarnation);
        if (sel constant.err) { ret constant; }
        i = i + 1;
    }
    val nodes: err[fail.Fail] = fp_u32(fb, surface.graph.nodes.len::u32);
    if (sel nodes.err) { ret nodes; }
    i = 0;
    for (i < surface.graph.nodes.len) {
        val node: *fields.Node = ?surface.graph.nodes.data[i];
        if (node.entries.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.message("typed field recipe exceeds its field count extent")}; }
        val ty: err[fail.Fail] = fp_u32(fb, node.ty::u32);
        if (sel ty.err) { ret ty; }
        var flags: u8 = 0;
        if (node.has_align) { flags = flags | 1; }
        if (node.packed) { flags = flags | 2; }
        if (node.volatile_) { flags = flags | 4; }
        val attributes: err[fail.Fail] = fp_u8(fb, flags);
        if (sel attributes.err) { ret attributes; }
        val align: err[fail.Fail] = fp_u32(fb, node.align);
        if (sel align.err) { ret align; }
        val disc: err[fail.Fail] = fp_u32(fb, node.disc::u32);
        if (sel disc.err) { ret disc; }
        val count: err[fail.Fail] = fp_u32(fb, node.entries.len::u32);
        if (sel count.err) { ret count; }
        var j: usize = 0;
        for (j < node.entries.len) {
            val field: type.FieldEntry = node.entries.data[j];
            val name: err[fail.Fail] = fp_u32(fb, field.name::u32);
            if (sel name.err) { ret name; }
            val field_type: err[fail.Fail] = fp_u32(fb, field.ty::u32);
            if (sel field_type.err) { ret field_type; }
            val notice: err[fail.Fail] = fp_deprecation(fb, field.deprecation);
            if (sel notice.err) { ret notice; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun typed_surface_decode(itn: *intern.Interner, a: *A.Allocator, bytes: *u8, len: u32,
                            path: intern.StrId, mid: session.ModuleId) res[scx.ModuleSema, fail.Fail] {
    var surface: scx.ModuleSema = scx.module_sema_init(a, path, mid);
    var transferred: bool = false;
    fin { if (!transferred) { scx.module_sema_dnit(?surface); } }
    var decoder: binary.Decoder = binary.decoder(bytes, len::usize, binary.LITTLE);
    val count: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
    if (sel count.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed surface is truncated")}; }
    val rows: u32 = count.ok;
    if (rows::usize > binary.remaining(?decoder) / 17) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed symbol rows are truncated")}; }
    var i: u32 = 0;
    for (i < rows) {
        val origin: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val canon: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val ty: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        if (sel origin.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed symbol row is truncated")};
        }
        if (sel canon.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed symbol row is truncated")};
        }
        if (sel ty.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed symbol row is truncated")};
        }
        var row: scx.TypeExport = scx.TypeExport{
            origin: origin.ok::session.StableModuleId,
            canon: canon.ok::intern.StrId,
            ty: ty.ok::type.TypeId
        };
        val constant: res[resolve.ExportConstant, fail.Fail] = constant_decode(itn, a, ?decoder, row.origin, ?row.definition_incarnation);
        if (sel constant.err) { ret res[scx.ModuleSema, fail.Fail].err{constant.err}; }
        row.constant = constant.ok;
        val appended: res[usize, A.Error] = vector.push[scx.TypeExport](?surface.exports, row);
        if (sel appended.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.refused(appended.err)}; }
        i = i + 1;
    }
    val node_count: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
    if (sel node_count.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipe count is truncated")}; }
    val nodes: u32 = node_count.ok;
    if (nodes::usize > binary.remaining(?decoder) / 17) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipes are truncated")}; }
    i = 0;
    for (i < nodes) {
        val ty: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val flags: res[u8, binary.DecodeError] = binary.read_u8(?decoder);
        val align: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val disc: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        val count: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
        if (sel ty.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipe is truncated")};
        }
        if (sel flags.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipe is truncated")};
        }
        if (sel align.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipe is truncated")};
        }
        if (sel disc.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipe is truncated")};
        }
        if (sel count.err) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipe is truncated")};
        }
        val attributes: u8 = flags.ok;
        val field_count: u32 = count.ok;
        if (attributes > 7 || field_count::usize > binary.remaining(?decoder) / 17) {
            ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed recipe attributes or field extent are invalid")};
        }
        var node: fields.Node = fields.Node{
            ty: ty.ok::type.TypeId,
            entries: vector.init[type.FieldEntry](a), has_align: (attributes & 1) != 0,
            align: align.ok, packed: (attributes & 2) != 0, volatile_: (attributes & 4) != 0,
            disc: disc.ok::type.TypeId
        };
        var node_transferred: bool = false;
        fin { if (!node_transferred) { vector.dnit[type.FieldEntry](?node.entries); } }
        var j: u32 = 0;
        for (j < field_count) {
            val name: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
            val field_type: res[u32, binary.DecodeError] = binary.read_u32(?decoder);
            if (sel name.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed field is truncated")}; }
            if (sel field_type.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed field is truncated")}; }
            val notice: res[deprecation.Deprecation, fail.Fail] = deprecation_decode(?decoder);
            if (sel notice.err) { ret res[scx.ModuleSema, fail.Fail].err{notice.err}; }
            val field: type.FieldEntry = type.FieldEntry{ name: name.ok::intern.StrId, ty: field_type.ok::type.TypeId,
                deprecation: notice.ok };
            val added: res[usize, A.Error] = vector.push[type.FieldEntry](?node.entries, field);
            if (sel added.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.refused(added.err)}; }
            j = j + 1;
        }
        val added: res[usize, A.Error] = vector.push[fields.Node](?surface.graph.nodes, node);
        if (sel added.err) { ret res[scx.ModuleSema, fail.Fail].err{fail.refused(added.err)}; }
        node_transferred = true;
        i = i + 1;
    }
    if (binary.remaining(?decoder) != 0) { ret res[scx.ModuleSema, fail.Fail].err{fail.message("typed surface has trailing bytes")}; }
    transferred = true;
    ret res[scx.ModuleSema, fail.Fail].ok{surface};
}

test "mach.lang.driver.query.public_surface:deprecation_owner_and_message_are_observable" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 1; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val register_stable_mid_r: err[fail.Fail] = session.register_stable_mid(?s, 17, 2);
    if (sel register_stable_mid_r.err) { ret 2; }
    var symbol: resolve.Symbol = resolve.Symbol{definition_kind: resolve.SYM_FUN, name: 5, canon: 6,
        definition_file: 8, origin_stable: 17};
    symbol.deprecation = deprecation.Deprecation{present: true, owner: 9, message: 10};
    var result: resolve.ResolveResult = resolve.ResolveResult{symbols: ?symbol, pub_count: 1};
    var original: FpBuf = FpBuf{alloc: ?alloc};
    var changed: FpBuf = FpBuf{alloc: ?alloc};
    var moved: FpBuf = FpBuf{alloc: ?alloc};
    fin { fp_free(?original); fp_free(?changed); fp_free(?moved); }
    val fp_public_surface_r: err[fail.Fail] = fp_public_surface(?original, ?result, 17, 1);
    if (sel fp_public_surface_r.err) { ret 3; }
    symbol.deprecation.message = 11;
    val fp_public_surface_r2: err[fail.Fail] = fp_public_surface(?changed, ?result, 17, 1);
    if (sel fp_public_surface_r2.err) { ret 4; }
    symbol.deprecation.message = 10;
    symbol.deprecation.owner = 12;
    val fp_public_surface_r3: err[fail.Fail] = fp_public_surface(?moved, ?result, 17, 1);
    if (sel fp_public_surface_r3.err) { ret 5; }
    if (original.len != 44 || changed.len != 44 || moved.len != 44) { ret 6; }
    if (fp_bytes_eq(original.buf, changed.buf, original.len) || fp_bytes_eq(original.buf, moved.buf, original.len)) { ret 7; }
    val decoded: res[resolve.ModuleExports, fail.Fail] = public_symbols_decode(?alloc, ?s, original.buf, original.len::u32, 1, 2);
    if (sel decoded.err) { ret 8; }
    val exports: resolve.ModuleExports = decoded.ok;
    fin { A.deallocate[resolve.PublicSymbol](?alloc, exports.symbols, exports.count::usize); }
    if (exports.count != 1 || exports.symbols[0].file != 8 || exports.symbols[0].origin != 2
        || !exports.symbols[0].deprecation.present || exports.symbols[0].deprecation.owner != 9
        || exports.symbols[0].deprecation.message != 10) { ret 9; }
    ret 0;
}

fun t_typed_surface_bytes(fb: *FpBuf, a: *A.Allocator, disc: u32, notice: deprecation.Deprecation) err[fail.Fail] {
    var surface: scx.ModuleSema = scx.module_sema_init(a, 3, 1);
    fin { scx.module_sema_dnit(?surface); }
    var node: fields.Node = fields.Node{ ty: 40, entries: vector.init[type.FieldEntry](a), disc: disc::type.TypeId };
    val pushed: res[usize, A.Error] = vector.push[type.FieldEntry](?node.entries,
        type.FieldEntry{ name: 21, ty: 22, deprecation: notice });
    if (sel pushed.err) { vector.dnit[type.FieldEntry](?node.entries); ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    val added: res[usize, A.Error] = vector.push[fields.Node](?surface.graph.nodes, node);
    if (sel added.err) { vector.dnit[type.FieldEntry](?node.entries); ret err[fail.Fail].err{fail.refused(added.err)}; }
    ret typed_surface_encode(fb, ?surface);
}

test "mach.lang.driver.query.typed_surface:discriminator_and_case_notices_round_trip_and_move_the_bytes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val notice: deprecation.Deprecation = deprecation.Deprecation{ present: true, owner: 4, message: 31 };
    var base: FpBuf = FpBuf{alloc: ?alloc};
    var widened: FpBuf = FpBuf{alloc: ?alloc};
    var renoticed: FpBuf = FpBuf{alloc: ?alloc};
    var clean: FpBuf = FpBuf{alloc: ?alloc};
    fin { fp_free(?base); fp_free(?widened); fp_free(?renoticed); fp_free(?clean); }
    val t_typed_surface_bytes_r: err[fail.Fail] = t_typed_surface_bytes(?base, ?alloc, 7, notice);
    if (sel t_typed_surface_bytes_r.err) { ret 1; }
    val t_typed_surface_bytes_r2: err[fail.Fail] = t_typed_surface_bytes(?widened, ?alloc, 8, notice);
    if (sel t_typed_surface_bytes_r2.err) { ret 2; }
    val t_typed_surface_bytes_r3: err[fail.Fail] = t_typed_surface_bytes(?renoticed, ?alloc, 7, deprecation.Deprecation{ present: true, owner: 4, message: 32 });
    if (sel t_typed_surface_bytes_r3.err) { ret 3; }
    val t_typed_surface_bytes_r4: err[fail.Fail] = t_typed_surface_bytes(?clean, ?alloc, 7, deprecation.none());
    if (sel t_typed_surface_bytes_r4.err) { ret 4; }
    if (base.len != widened.len || base.len != renoticed.len || base.len != clean.len) { ret 5; }
    if (fp_bytes_eq(base.buf, widened.buf, base.len) || fp_bytes_eq(base.buf, renoticed.buf, base.len) || fp_bytes_eq(base.buf, clean.buf, base.len)) { ret 6; }
    val decoded: res[scx.ModuleSema, fail.Fail] = typed_surface_decode(nil, ?alloc, base.buf, base.len::u32, 3, 1);
    if (sel decoded.err) { ret 7; }
    var surface: scx.ModuleSema = decoded.ok;
    fin { scx.module_sema_dnit(?surface); }
    if (surface.graph.nodes.len != 1 || surface.graph.nodes.data[0].ty != 40 || surface.graph.nodes.data[0].disc != 7) { ret 8; }
    val entry: type.FieldEntry = surface.graph.nodes.data[0].entries.data[0];
    if (surface.graph.nodes.data[0].entries.len != 1 || entry.name != 21 || entry.ty != 22 || !deprecation.equal(entry.deprecation, notice)) { ret 9; }
    ret 0;
}

fun t_fp_equal(a: *FpBuf, b: *FpBuf) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.buf[i] != b.buf[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver.query:fp_name_uses_spelling_across_independent_interners" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var left: intern.Interner = intern.init(?a);
    var right: intern.Interner = intern.init(?a);
    fin { intern.dnit(?left); intern.dnit(?right); }
    val l: res[intern.StrId, A.Error] = intern.intern(?left, "debug");
    val unrelated: res[intern.StrId, A.Error] = intern.intern(?right, "release");
    val r: res[intern.StrId, A.Error] = intern.intern(?right, "debug");
    if (sel l.err) { ret 2; }
    if (sel unrelated.err) { ret 2; }
    if (sel r.err) { ret 2; }
    val lid: intern.StrId = l.ok;
    val rid: intern.StrId = r.ok;
    val other: intern.StrId = unrelated.ok;
    if (lid == rid || lid != other) { ret 3; }
    var lf: FpBuf = FpBuf{alloc: ?a};
    var rf: FpBuf = FpBuf{alloc: ?a};
    var of: FpBuf = FpBuf{alloc: ?a};
    var absent: FpBuf = FpBuf{alloc: ?a};
    var empty: FpBuf = FpBuf{alloc: ?a};
    fin { fp_free(?lf); fp_free(?rf); fp_free(?of); fp_free(?absent); fp_free(?empty); }
    val fp_name_r: err[fail.Fail] = fp_name(?lf, ?left, lid);
    if (sel fp_name_r.err) { ret 4; }
    val fp_name_r2: err[fail.Fail] = fp_name(?rf, ?right, rid);
    if (sel fp_name_r2.err) { ret 5; }
    val fp_name_r3: err[fail.Fail] = fp_name(?of, ?right, other);
    if (sel fp_name_r3.err) { ret 6; }
    if (!t_fp_equal(?lf, ?rf) || t_fp_equal(?lf, ?of)) { ret 7; }
    val empty_id: res[intern.StrId, A.Error] = intern.intern(?right, "");
    if (sel empty_id.err) { ret 8; }
    val fp_name_r4: err[fail.Fail] = fp_name(?absent, ?right, intern.STR_NIL);
    if (sel fp_name_r4.err) { ret 9; }
    val fp_name_r5: err[fail.Fail] = fp_name(?empty, ?right, empty_id.ok);
    if (sel fp_name_r5.err) { ret 10; }
    if (t_fp_equal(?absent, ?empty)) { ret 11; }
    val fp_name_r6: err[fail.Fail] = fp_name(?empty, ?right, 1000);
    if (sel fp_name_r6.ok) { ret 12; }
    ret 0;
}
