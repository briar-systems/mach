use collections_vector: std.collections.vector;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator.page;

use A: std.allocator;

use mach.lang.deprecation;
use mach.lang.fail;
use ast_id: mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.fe.resolve;
use fe_sema: mach.lang.fe.sema;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.query;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.type;
use mach.lang.wide;
use mach.lang.wire;

pub fun resolve_handle_encode(alloc: *A.Allocator, r: *resolve.ResolveResult) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        resolve.result_dnit(r);
        A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

pub fun resolve_handle_decode(e: query.QueryView) *resolve.ResolveResult {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*resolve.ResolveResult;
}

# a grown fingerprint sink's bytes as a query output owned by the caller; the
# sink is left empty
pub fun output(s: *wire.Sink) res[query.QueryOutput, fail.Fail] {
    var out: query.QueryOutput;
    out.bytes = nil;
    out.len   = 0;
    if (!s.failed && s.len > 0xFFFFFFFF::usize) {
        wire.dnit(s);
        ret res[query.QueryOutput, fail.Fail].err{fail.message("fingerprint exceeds 32-bit query input length")};
    }
    val n:     u32                 = s.len::u32;
    val bytes: res[*u8, fail.Fail] = wire.release(s);
    if (sel bytes.err) { ret res[query.QueryOutput, fail.Fail].err{bytes.err}; }
    out.bytes = bytes.ok;
    if (bytes.ok != nil) { out.len = n; }
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun constant_encode(s: *wire.Sink, item: *resolve.ExportConstant, origin: session.StableModuleId,
    definition_revision: query.Revision) err[fail.Fail] {
    wire.put_u32(s, item.name::u32);
    var present: u8 = 0;
    if (item.present) { present = 1; }
    wire.put_u8(s, present);
    if (!item.present) { ret err[fail.Fail].ok{}; }
    var gated: u8 = 0;
    if (item.gated) { gated = 1; }
    wire.put_u8(s, gated);
    ret ct_value_encode(s, ?item.value, origin, definition_revision);
}

# a CONST_ELEM value names an element of its origin's definition, so it folds that definition's revision
pub fun ct_value_encode(s: *wire.Sink, value: *comptime.CTValue, origin: session.StableModuleId,
    definition_revision: query.Revision) err[fail.Fail] {
    wire.put_u8(s, value.kind);
    var low:      u64 = 0;
    var high:     u64 = 0;
    var width:    u8  = 0;
    var unsigned: u8  = 0;
    if (value.kind == comptime.CT_KIND_INT) {
        low   = value.data.w.lo;
        high  = value.data.w.hi;
        width = value.int_width;
        if (value.int_unsigned) { unsigned = 1; }
    }
    or (value.kind == comptime.CT_KIND_FLOAT) {
        low   = float.f64_bits(value.data.f);
        width = value.float_width;
    }
    or (value.kind == comptime.CT_KIND_STR || value.kind == comptime.CT_KIND_NON_INTEGER) {
        low = intern.str_index(value.data.s)::u64;
    }
    or (value.kind == comptime.CT_KIND_TYPE) {
        low = value.data.t::u64;
    }
    or (value.kind == comptime.CT_KIND_FIELD || value.kind == comptime.CT_KIND_CASE) {
        low  = value.data.fld.owner::u64;
        high = value.data.fld.index::u64;
    }
    or (value.kind == comptime.CT_KIND_PACK_ELEM) {
        low  = value.data.pelem.index::u64;
        high = value.data.pelem.ty::u64;
    }
    or (value.kind == comptime.CT_KIND_CONST_ELEM) {
        low  = value.data.celem.elem::u64;
        high = value.data.celem.ty::u64;
        if (definition_revision == 0 || module.stable_is_nil(origin)) {
            ret err[fail.Fail].err{fail.message("constant element surface requires its current definition revision")};
        }
    }
    or { ret err[fail.Fail].err{fail.message("constant surface has an unknown CTKind")}; }
    wire.put_u8(s, unsigned);
    wire.put_u8(s, width);
    wire.put_u64(s, low);
    wire.put_u64(s, high);
    if (value.kind == comptime.CT_KIND_CONST_ELEM) {
        wire.put_u32(s, origin::u32);
        wire.put_u64(s, definition_revision);
    }
    ret err[fail.Fail].ok{};
}

pub fun public_surface_encode(s: *wire.Sink, rr: *resolve.ResolveResult, origin: session.StableModuleId,
    definition_revision: query.Revision) err[fail.Fail] {
    wire.put_u32(s, rr.pub_count);
    var i: u32 = 0;
    for (i < rr.pub_count) {
        val symbol: *resolve.Symbol = ?rr.symbols[i];
        wire.put_u8(s, symbol.definition_kind);
        wire.put_u32(s, symbol.name::u32);
        wire.put_u32(s, symbol.canon::u32);
        wire.put_u32(s, symbol.definition_file::u32);
        wire.put_u32(s, symbol.generic_arity);
        wire.put_u8(s, symbol.has_comptime_params::u8);
        wire.put_u8(s, symbol.has_pack_param::u8);
        deprecation_encode(s, symbol.deprecation);
        wire.put_u8(s, symbol.testing::u8);
        var slot: u32 = symbol.slot;
        if (symbol.definition_kind == resolve.SYM_USE) { slot = symbol.slot_stable::u32; }
        wire.put_u32(s, slot);
        wire.put_u32(s, symbol.origin_stable::u32);
        i = i + 1;
    }
    wire.put_u32(s, rr.public_constant_count);
    i = 0;
    for (i < rr.public_constant_count) {
        val item: err[fail.Fail] = constant_encode(s, ?rr.public_constants[i], origin, definition_revision);
        if (sel item.err) { ret item; }
        i = i + 1;
    }
    # a refusal changes what an importer reports about a missing name
    wire.put_u8(s, rr.refused::u8);
    ret err[fail.Fail].ok{};
}

fun deprecation_encode(s: *wire.Sink, notice: deprecation.Deprecation) {
    wire.put_u8(s, notice.present::u8);
    wire.put_u32(s, notice.owner::u32);
    wire.put_u32(s, notice.message::u32);
}

fun deprecation_decode(r: *wire.Source) res[deprecation.Deprecation, fail.Fail] {
    val present: u8  = wire.take_u8(r);
    val owner:   u32 = wire.take_u32(r);
    val message: u32 = wire.take_u32(r);
    if (r.bad)       { ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice is truncated")}; }
    if (present > 1) { ret res[deprecation.Deprecation, fail.Fail].err{fail.message("deprecation notice flag is invalid")}; }
    ret res[deprecation.Deprecation, fail.Fail].ok{deprecation.Deprecation{present: present != 0,
        owner: owner::lang_source.FileId, message: message::intern.StrId}};
}

#[testing]
fun public_symbols_decode(a: *A.Allocator, s: *session.Session, bytes: *u8, len: u32,
    path: intern.StrId, mid: session.ModuleId) res[resolve.ModuleExports, fail.Fail] {
    if (len < 8) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
    var r: wire.Source = wire.source(bytes, len::usize);
    val n: u32         = wire.take_u32(?r);
    if (n > (len - 8) / 36) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
    var out: resolve.ModuleExports = resolve.ModuleExports{path: path, module: mid};
    if (n == 0) { ret res[resolve.ModuleExports, fail.Fail].ok{out}; }
    val allocated: res[*resolve.PublicSymbol, A.Error] = A.allocate[resolve.PublicSymbol](a, n::usize);
    if (sel allocated.err) { ret res[resolve.ModuleExports, fail.Fail].err{fail.refused(allocated.err)}; }
    val symbols:     *resolve.PublicSymbol = allocated.ok;
    var transferred: bool                  = false;
    fin {
        if (!transferred) { A.deallocate[resolve.PublicSymbol](a, symbols, n::usize); }
    }
    var i: u32 = 0;
    for (i < n) {
        val kind:     u8                                      = wire.take_u8(?r);
        val name:     u32                                     = wire.take_u32(?r);
        val canon:    u32                                     = wire.take_u32(?r);
        val file:     u32                                     = wire.take_u32(?r);
        val arity:    u32                                     = wire.take_u32(?r);
        val comptime: u8                                      = wire.take_u8(?r);
        val pack:     u8                                      = wire.take_u8(?r);
        val notice:   res[deprecation.Deprecation, fail.Fail] = deprecation_decode(?r);
        val testing:  u8                                      = wire.take_u8(?r);
        val slot:     u32                                     = wire.take_u32(?r);
        val origin:   u32                                     = wire.take_u32(?r);
        if (r.bad)          { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol surface is truncated")}; }
        if (sel notice.err) { ret res[resolve.ModuleExports, fail.Fail].err{notice.err}; }
        var symbol: resolve.PublicSymbol = resolve.PublicSymbol{};
        symbol.kind = kind;
        if (!resolve.sym_kind_valid(symbol.kind)) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message_of(fail.catalog_interned(?s.interner, a, fail.malformed_member("SymKind", symbol.kind::u32)))};
        }
        symbol.name          = name::intern.StrId;
        symbol.canon         = canon::intern.StrId;
        symbol.file          = file::lang_source.FileId;
        symbol.generic_arity = arity;
        if (comptime > 1 || pack > 1) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol call shape is invalid")}; }
        symbol.has_comptime_params = comptime != 0;
        symbol.has_pack_param      = pack != 0;
        symbol.deprecation         = notice.ok;
        if (testing > 1) { ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol testing flag is invalid")}; }
        symbol.testing = testing != 0;
        symbol.slot    = slot;
        val stable: session.StableModuleId = origin::session.StableModuleId;
        symbol.origin = session.module_id_for_stable(s, stable);
        if (!module.stable_is_nil(stable) && module.is_nil(symbol.origin)) {
            ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public symbol origin is not loaded")};
        }
        if (symbol.kind == resolve.SYM_USE) {
            val slot_stable: session.StableModuleId = symbol.slot::session.StableModuleId;
            symbol.slot = session.module_id_for_stable(s, slot_stable)::u32;
            if (!module.stable_is_nil(slot_stable) && symbol.slot == session.MODULE_NIL::u32) {
                ret res[resolve.ModuleExports, fail.Fail].err{fail.message("public module slot is not loaded")};
            }
        }
        symbols[i] = symbol;
        i          = i + 1;
    }
    out.symbols = symbols;
    out.count   = n;
    transferred = true;
    ret res[resolve.ModuleExports, fail.Fail].ok{out};
}

test public_surface__canonical_name_is_owned_and_module_slots_are_remapped {
    var alloc: A.Allocator;
    page.make(?alloc);
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 1; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val register_stable_mid_r: err[fail.Fail] = session.register_stable_mid(?s, module.stable_id(17), module.id(2));
    if (sel register_stable_mid_r.err) { ret 2; }
    val register_stable_mid_r2: err[fail.Fail] = session.register_stable_mid(?s, module.stable_id(18), module.id(3));
    if (sel register_stable_mid_r2.err) { ret 3; }
    var symbol: resolve.Symbol = resolve.Symbol{kind: resolve.SYM_USE, definition_kind: resolve.SYM_USE, name: intern.str_id(5), canon: intern.str_id(6),
        decl: ast_id.decl(7), slot: 1, origin: module.id(0), origin_stable: module.stable_id(17), slot_stable: module.stable_id(18)};
    var result: resolve.ResolveResult = resolve.ResolveResult{symbols: ?symbol, pub_count: 1};
    var before: wire.Sink             = wire.grown(?alloc);
    fin { wire.dnit(?before); }
    var after: wire.Sink = wire.grown(?alloc);
    fin { wire.dnit(?after); }
    val encoded: err[fail.Fail] = public_surface_encode(?before, ?result, module.stable_id(17), 0);
    if (sel encoded.err) { ret 4; }
    symbol.canon = intern.str_id(0x78563412);
    val encoded2: err[fail.Fail] = public_surface_encode(?after, ?result, module.stable_id(17), 0);
    if (sel encoded2.err)                                                                                                                    { ret 5; }
    if (before.len != 46 || after.len != 46 || t_same_bytes(?before, ?after))                                                                { ret 6; }
    if (wire.bytes(?after)[9] != 0x12 || wire.bytes(?after)[10] != 0x34 || wire.bytes(?after)[11] != 0x56 || wire.bytes(?after)[12] != 0x78) { ret 7; }
    symbol.canon       = intern.str_id(99);
    symbol.slot_stable = session.STABLE_MODULE_NIL;
    val decoded: res[resolve.ModuleExports, fail.Fail] = public_symbols_decode(?alloc, ?s, wire.bytes(?after), after.len::u32, intern.str_id(4), module.id(2));
    if (sel decoded.err) { ret 8; }
    val exports: resolve.ModuleExports = decoded.ok;
    fin { A.deallocate[resolve.PublicSymbol](?alloc, exports.symbols, exports.count::usize); }
    if (exports.count != 1 || !intern.str_same(exports.symbols[0].canon, intern.str_id(0x78563412))) { ret 9; }
    if (!module.same(exports.symbols[0].origin, module.id(2)) || exports.symbols[0].slot != 3)       { ret 10; }
    ret 0;
}

test constant_surface__float_width_and_definition_revisions_are_observable {
    var alloc: A.Allocator;
    page.make(?alloc);
    var item: resolve.ExportConstant = resolve.ExportConstant{name: intern.str_id(1), present: true};
    item.value.kind        = comptime.CT_KIND_FLOAT;
    item.value.float_width = float.FLOAT_W_32;
    item.value.data.f      = 1.5;
    var narrow: wire.Sink = wire.grown(?alloc);
    fin { wire.dnit(?narrow); }
    var wide: wire.Sink = wire.grown(?alloc);
    fin { wire.dnit(?wide); }
    val encoded: err[fail.Fail] = constant_encode(?narrow, ?item, module.stable_id(2), 0);
    if (sel encoded.err) { ret 1; }
    item.value.float_width = float.FLOAT_W_64;
    val encoded2: err[fail.Fail] = constant_encode(?wide, ?item, module.stable_id(2), 0);
    if (sel encoded2.err)                                                                                 { ret 2; }
    if (narrow.len != 25 || wide.len != 25 || wire.bytes(?narrow)[8] != 32 || wire.bytes(?wide)[8] != 64) { ret 3; }
    if (t_same_bytes(?narrow, ?wide))                                                                     { ret 4; }
    wire.dnit(?narrow);
    wire.dnit(?wide);
    item.value = comptime.const_elem_value(7, 9);
    val encoded3: err[fail.Fail] = constant_encode(?narrow, ?item, module.stable_id(2), 100);
    if (sel encoded3.err) { ret 5; }
    val encoded4: err[fail.Fail] = constant_encode(?wide, ?item, module.stable_id(2), 101);
    if (sel encoded4.err)                                                   { ret 6; }
    if (narrow.len != 37 || wide.len != 37 || t_same_bytes(?narrow, ?wide)) { ret 7; }
    wire.dnit(?wide);
    val encoded5: err[fail.Fail] = constant_encode(?wide, ?item, module.stable_id(2), 0);
    if (sel encoded5.ok) { ret 8; }
    ret 0;
}

test public_surface__definition_kind_changes_without_a_spelling_change {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var symbol: resolve.Symbol = resolve.Symbol{kind: resolve.SYM_IMPORTED,
        definition_kind: resolve.SYM_FUN, name: intern.str_id(11), canon: intern.str_id(12), decl: ast_id.decl(3),
        origin:          module.id(0), origin_stable: module.stable_id(4), slot_stable: session.STABLE_MODULE_NIL};
    var result:   resolve.ResolveResult = resolve.ResolveResult{symbols: ?symbol, pub_count: 1};
    var function: wire.Sink             = wire.grown(?alloc);
    fin { wire.dnit(?function); }
    var value: wire.Sink = wire.grown(?alloc);
    fin { wire.dnit(?value); }
    val encoded: err[fail.Fail] = public_surface_encode(?function, ?result, module.stable_id(4), 1);
    if (sel encoded.err) { ret 2; }
    symbol.definition_kind = resolve.SYM_VAL;
    val encoded2: err[fail.Fail] = public_surface_encode(?value, ?result, module.stable_id(4), 1);
    if (sel encoded2.err)                                                                        { ret 3; }
    if (function.len != value.len || function.len != 46)                                         { ret 4; }
    if (t_same_bytes(?function, ?value))                                                         { ret 5; }
    if (wire.bytes(?function)[4] != resolve.SYM_FUN || wire.bytes(?value)[4] != resolve.SYM_VAL) { ret 6; }
    ret 0;
}

test public_surface__a_refusal_is_observable {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var result:  resolve.ResolveResult = resolve.ResolveResult{};
    var clean:   wire.Sink             = wire.grown(?alloc);
    var refused: wire.Sink             = wire.grown(?alloc);
    fin {
        wire.dnit(?clean);
        wire.dnit(?refused);
    }
    val clean_r: err[fail.Fail] = public_surface_encode(?clean, ?result, module.stable_id(4), 1);
    if (sel clean_r.err) { ret 2; }
    result.refused = true;
    val refused_r: err[fail.Fail] = public_surface_encode(?refused, ?result, module.stable_id(4), 1);
    if (sel refused_r.err)                                                                    { ret 3; }
    if (clean.len != refused.len)                                                             { ret 4; }
    if (t_same_bytes(?clean, ?refused))                                                       { ret 5; }
    if (wire.bytes(?clean)[clean.len - 1] != 0 || wire.bytes(?refused)[refused.len - 1] != 1) { ret 6; }
    ret 0;
}

# `itn` and `a` own a catalog rejection's text; a caller without them (a test
# fixture) still refuses the member with a static text naming the catalog
fun constant_decode(itn: *intern.Interner, a: *A.Allocator, r: *wire.Source, origin: session.StableModuleId,
    incarnation: *u64) res[resolve.ExportConstant, fail.Fail] {
    var item: resolve.ExportConstant = resolve.ExportConstant{};
    @incarnation = 0;
    val name:     u32 = wire.take_u32(r);
    val presence: u8  = wire.take_u8(r);
    if (r.bad) { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")}; }
    item.name = name::intern.StrId;
    if (presence > 1)  { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant presence is invalid")}; }
    if (presence == 0) { ret res[resolve.ExportConstant, fail.Fail].ok{item}; }
    item.present = true;
    val gated:    u8  = wire.take_u8(r);
    val kind:     u8  = wire.take_u8(r);
    val unsigned: u8  = wire.take_u8(r);
    val bits:     u8  = wire.take_u8(r);
    val lo:       u64 = wire.take_u64(r);
    val hi:       u64 = wire.take_u64(r);
    if (r.bad)                     { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant surface is truncated")}; }
    if (gated > 1 || unsigned > 1) { ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant flags are invalid")}; }
    item.gated      = gated != 0;
    item.value.kind = kind;
    if (item.value.kind == comptime.CT_KIND_INT) {
        item.value.data.w       = wide.make(lo, hi);
        item.value.int_unsigned = unsigned != 0;
        item.value.int_width    = bits;
    }
    or (item.value.kind == comptime.CT_KIND_FLOAT) {
        item.value.data.f      = float.bits_f64(lo);
        item.value.float_width = bits;
    }
    or (item.value.kind == comptime.CT_KIND_STR || item.value.kind == comptime.CT_KIND_NON_INTEGER) {
        item.value.data.s = intern.str_id(lo::u32);
    }
    or (item.value.kind == comptime.CT_KIND_TYPE) {
        item.value.data.t = lo::u32;
    }
    or (item.value.kind == comptime.CT_KIND_FIELD || item.value.kind == comptime.CT_KIND_CASE) {
        item.value.data.fld.owner = lo::u32;
        item.value.data.fld.index = hi::u32;
    }
    or (item.value.kind == comptime.CT_KIND_PACK_ELEM) {
        item.value.data.pelem.index = lo::u32;
        item.value.data.pelem.ty    = hi::u32;
    }
    or (item.value.kind == comptime.CT_KIND_CONST_ELEM) {
        item.value.data.celem.elem = lo::u32;
        item.value.data.celem.ty   = hi::u32;
        val module:   u32 = wire.take_u32(r);
        val revision: u64 = wire.take_u64(r);
        if (r.bad || module != origin::u32 || revision == 0) {
            ret res[resolve.ExportConstant, fail.Fail].err{fail.message("constant element has no matching parsed definition")};
        }
        @incarnation = revision;
    }
    or {
        ret res[resolve.ExportConstant, fail.Fail].err{fail.message_of(fail.catalog_interned(itn, a, fail.malformed_member("CTKind", item.value.kind::u32)))};
    }
    ret res[resolve.ExportConstant, fail.Fail].ok{item};
}

# a field recipe's fixed header (type, flags, align, disc, field count) and one field (name, type, deprecation)
val RECIPE_HEAD:  usize = 17;
val RECIPE_FIELD: usize = 17;

pub fun typed_surface_encode(s: *wire.Sink, surface: *fe_sema.ModuleSema) err[fail.Fail] {
    if (surface.exports.len > 0xFFFFFFFF::usize || surface.graph.nodes.len > 0xFFFFFFFF::usize) {
        ret err[fail.Fail].err{fail.message("typed surface exceeds its row count extent")};
    }
    wire.put_u32(s, surface.exports.len::u32);
    var i: usize = 0;
    for (i < surface.exports.len) {
        val row: *fe_sema.TypeExport = ?surface.exports.data[i];
        wire.put_u32(s, row.origin::u32);
        wire.put_u32(s, row.canon::u32);
        wire.put_u32(s, row.ty::u32);
        val constant: err[fail.Fail] = constant_encode(s, ?row.constant, row.origin, row.definition_incarnation);
        if (sel constant.err) { ret constant; }
        i = i + 1;
    }
    wire.put_u32(s, surface.graph.nodes.len::u32);
    i = 0;
    for (i < surface.graph.nodes.len) {
        val node: *fe_sema.fields.Node = ?surface.graph.nodes.data[i];
        if (node.entries.len > (0xFFFFFFFF::usize - RECIPE_HEAD) / RECIPE_FIELD) {
            ret err[fail.Fail].err{fail.message("typed field recipe exceeds its field count extent")};
        }
        var flags: u8 = 0;
        if (node.has_align) { flags = flags | 1; }
        if (node.packed)    { flags = flags | 2; }
        if (node.volatile_) { flags = flags | 4; }
        wire.put_u32(s, node.ty::u32);
        wire.put_u8(s, flags);
        wire.put_u32(s, node.align);
        wire.put_u32(s, node.disc::u32);
        wire.put_u32(s, node.entries.len::u32);
        var j: usize = 0;
        for (j < node.entries.len) {
            val field: *type.FieldEntry = ?node.entries.data[j];
            wire.put_u32(s, field.name::u32);
            wire.put_u32(s, field.ty::u32);
            deprecation_encode(s, field.deprecation);
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun typed_surface_decode(itn: *intern.Interner, a: *A.Allocator, bytes: *u8, len: u32,
    path: intern.StrId, mid: session.ModuleId) res[fe_sema.ModuleSema, fail.Fail] {
    var surface:     fe_sema.ModuleSema = fe_sema.module_sema_init(a, path, mid);
    var transferred: bool               = false;
    fin {
        if (!transferred) { fe_sema.module_sema_dnit(?surface); }
    }
    var r:    wire.Source = wire.source(bytes, len::usize);
    val rows: u32         = wire.take_u32(?r);
    if (r.bad)                                 { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed surface is truncated")}; }
    if (rows::usize > wire.remaining(?r) / 17) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed symbol rows are truncated")}; }
    val rows_reserved: res[usize, A.Error] = collections_vector.reserve[fe_sema.TypeExport](?surface.exports, rows::usize);
    if (sel rows_reserved.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.refused(rows_reserved.err)}; }
    var i: u32 = 0;
    for (i < rows) {
        val origin: u32 = wire.take_u32(?r);
        val canon:  u32 = wire.take_u32(?r);
        val ty:     u32 = wire.take_u32(?r);
        if (r.bad) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed symbol row is truncated")}; }
        var row: fe_sema.TypeExport = fe_sema.TypeExport{
            origin: origin::session.StableModuleId,
            canon:  canon::intern.StrId,
            ty:     ty::type.TypeId
        };
        val constant: res[resolve.ExportConstant, fail.Fail] = constant_decode(itn, a, ?r, row.origin, ?row.definition_incarnation);
        if (sel constant.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{constant.err}; }
        row.constant = constant.ok;
        val appended: res[usize, A.Error] = collections_vector.push[fe_sema.TypeExport](?surface.exports, row);
        if (sel appended.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.refused(appended.err)}; }
        i = i + 1;
    }
    val nodes: u32 = wire.take_u32(?r);
    if (r.bad)                                           { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed recipe count is truncated")}; }
    if (nodes::usize > wire.remaining(?r) / RECIPE_HEAD) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed recipes are truncated")}; }
    val nodes_reserved: res[usize, A.Error] = collections_vector.reserve[fe_sema.fields.Node](?surface.graph.nodes, nodes::usize);
    if (sel nodes_reserved.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.refused(nodes_reserved.err)}; }
    i = 0;
    for (i < nodes) {
        val head: *u8 = wire.take_bytes(?r, RECIPE_HEAD);
        if (head == nil) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed recipe is truncated")}; }
        var h:           wire.Source = wire.source(head, RECIPE_HEAD);
        val node_ty:     u32         = wire.take_u32(?h);
        val attributes:  u8          = wire.take_u8(?h);
        val node_align:  u32         = wire.take_u32(?h);
        val node_disc:   u32         = wire.take_u32(?h);
        val field_count: u32         = wire.take_u32(?h);
        if (attributes > 7 || field_count::usize > wire.remaining(?r) / RECIPE_FIELD) {
            ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed recipe attributes or field extent are invalid")};
        }
        var node: fe_sema.fields.Node = fe_sema.fields.Node{
            ty:      node_ty::type.TypeId,
            entries: collections_vector.init[type.FieldEntry](a), has_align: (attributes & 1) != 0,
            align:   node_align, packed: (attributes & 2) != 0, volatile_: (attributes & 4) != 0,
            disc:    node_disc::type.TypeId
        };
        var node_transferred: bool = false;
        fin {
            if (!node_transferred) { collections_vector.dnit[type.FieldEntry](?node.entries); }
        }
        if (field_count > 0) {
            val body: *u8 = wire.take_bytes(?r, field_count::usize * RECIPE_FIELD);
            if (body == nil) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed field is truncated")}; }
            val entries_reserved: res[usize, A.Error] = collections_vector.reserve[type.FieldEntry](?node.entries, field_count::usize);
            if (sel entries_reserved.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.refused(entries_reserved.err)}; }
            var f: wire.Source = wire.source(body, field_count::usize * RECIPE_FIELD);
            var j: u32         = 0;
            for (j < field_count) {
                val field_name: u32                                     = wire.take_u32(?f);
                val field_ty:   u32                                     = wire.take_u32(?f);
                val notice:     res[deprecation.Deprecation, fail.Fail] = deprecation_decode(?f);
                if (sel notice.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{notice.err}; }
                node.entries.data[j::usize] = type.FieldEntry{name: field_name::intern.StrId, ty: field_ty::type.TypeId,
                    deprecation: notice.ok};
                j = j + 1;
            }
            node.entries.len = field_count::usize;
        }
        val added: res[usize, A.Error] = collections_vector.push[fe_sema.fields.Node](?surface.graph.nodes, node);
        if (sel added.err) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.refused(added.err)}; }
        node_transferred = true;
        i                = i + 1;
    }
    if (!wire.done(?r)) { ret res[fe_sema.ModuleSema, fail.Fail].err{fail.message("typed surface has trailing bytes")}; }
    transferred = true;
    ret res[fe_sema.ModuleSema, fail.Fail].ok{surface};
}

test public_surface__testing_flag_is_observable_and_round_trips {
    var alloc: A.Allocator;
    page.make(?alloc);
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 1; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val registered: err[fail.Fail] = session.register_stable_mid(?s, module.stable_id(17), module.id(2));
    if (sel registered.err) { ret 2; }
    var symbol: resolve.Symbol = resolve.Symbol{definition_kind: resolve.SYM_FUN, name: intern.str_id(5), canon: intern.str_id(6),
        definition_file: lang_source.file_id(8), origin_stable: module.stable_id(17)};
    var result: resolve.ResolveResult = resolve.ResolveResult{symbols: ?symbol, pub_count: 1};
    var clean:  wire.Sink             = wire.grown(?alloc);
    var marked: wire.Sink             = wire.grown(?alloc);
    fin {
        wire.dnit(?clean);
        wire.dnit(?marked);
    }
    val clean_r: err[fail.Fail] = public_surface_encode(?clean, ?result, module.stable_id(17), 1);
    if (sel clean_r.err) { ret 3; }
    symbol.testing = true;
    val marked_r: err[fail.Fail] = public_surface_encode(?marked, ?result, module.stable_id(17), 1);
    if (sel marked_r.err)                                         { ret 4; }
    if (clean.len != marked.len || t_same_bytes(?clean, ?marked)) { ret 5; }
    val decoded: res[resolve.ModuleExports, fail.Fail] = public_symbols_decode(?alloc, ?s, wire.bytes(?marked), marked.len::u32, intern.str_id(1), module.id(2));
    if (sel decoded.err) { ret 6; }
    val exports: resolve.ModuleExports = decoded.ok;
    fin { A.deallocate[resolve.PublicSymbol](?alloc, exports.symbols, exports.count::usize); }
    if (exports.count != 1 || !exports.symbols[0].testing) { ret 7; }
    val plain: res[resolve.ModuleExports, fail.Fail] = public_symbols_decode(?alloc, ?s, wire.bytes(?clean), clean.len::u32, intern.str_id(1), module.id(2));
    if (sel plain.err) { ret 8; }
    val plain_exports: resolve.ModuleExports = plain.ok;
    fin { A.deallocate[resolve.PublicSymbol](?alloc, plain_exports.symbols, plain_exports.count::usize); }
    if (plain_exports.symbols[0].testing) { ret 9; }
    ret 0;
}

test public_surface__deprecation_owner_and_message_are_observable {
    var alloc: A.Allocator;
    page.make(?alloc);
    val initialized: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel initialized.err) { ret 1; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val register_stable_mid_r: err[fail.Fail] = session.register_stable_mid(?s, module.stable_id(17), module.id(2));
    if (sel register_stable_mid_r.err) { ret 2; }
    var symbol: resolve.Symbol = resolve.Symbol{definition_kind: resolve.SYM_FUN, name: intern.str_id(5), canon: intern.str_id(6),
        definition_file: lang_source.file_id(8), origin_stable: module.stable_id(17)};
    symbol.deprecation = deprecation.Deprecation{present: true, owner: lang_source.file_id(9), message: intern.str_id(10)};
    var result:   resolve.ResolveResult = resolve.ResolveResult{symbols: ?symbol, pub_count: 1};
    var original: wire.Sink             = wire.grown(?alloc);
    var changed:  wire.Sink             = wire.grown(?alloc);
    var moved:    wire.Sink             = wire.grown(?alloc);
    fin {
        wire.dnit(?original);
        wire.dnit(?changed);
        wire.dnit(?moved);
    }
    val encoded: err[fail.Fail] = public_surface_encode(?original, ?result, module.stable_id(17), 1);
    if (sel encoded.err) { ret 3; }
    symbol.deprecation.message = intern.str_id(11);
    val encoded2: err[fail.Fail] = public_surface_encode(?changed, ?result, module.stable_id(17), 1);
    if (sel encoded2.err) { ret 4; }
    symbol.deprecation.message = intern.str_id(10);
    symbol.deprecation.owner   = lang_source.file_id(12);
    val encoded3: err[fail.Fail] = public_surface_encode(?moved, ?result, module.stable_id(17), 1);
    if (sel encoded3.err)                                                     { ret 5; }
    if (original.len != 46 || changed.len != 46 || moved.len != 46)           { ret 6; }
    if (t_same_bytes(?original, ?changed) || t_same_bytes(?original, ?moved)) { ret 7; }
    val decoded: res[resolve.ModuleExports, fail.Fail] = public_symbols_decode(?alloc, ?s, wire.bytes(?original), original.len::u32, intern.str_id(1), module.id(2));
    if (sel decoded.err) { ret 8; }
    val exports: resolve.ModuleExports = decoded.ok;
    fin { A.deallocate[resolve.PublicSymbol](?alloc, exports.symbols, exports.count::usize); }
    if (exports.count != 1 || !lang_source.file_same(exports.symbols[0].file, lang_source.file_id(8)) || !module.same(exports.symbols[0].origin, module.id(2))
        || !exports.symbols[0].deprecation.present || !lang_source.file_same(exports.symbols[0].deprecation.owner, lang_source.file_id(9))
        || !intern.str_same(exports.symbols[0].deprecation.message, intern.str_id(10))) { ret 9; }
    ret 0;
}

#[testing]
fun t_typed_surface_bytes(fb: *wire.Sink, a: *A.Allocator, disc: u32, notice: deprecation.Deprecation) err[fail.Fail] {
    var surface: fe_sema.ModuleSema = fe_sema.module_sema_init(a, intern.str_id(3), module.id(1));
    fin { fe_sema.module_sema_dnit(?surface); }
    var node:   fe_sema.fields.Node = fe_sema.fields.Node{ty: type.id(40), entries: collections_vector.init[type.FieldEntry](a), disc: type.id(disc)};
    val pushed: res[usize, A.Error] = collections_vector.push[type.FieldEntry](?node.entries,
        type.FieldEntry{name: intern.str_id(21), ty: type.id(22), deprecation: notice});
    if (sel pushed.err) {
        collections_vector.dnit[type.FieldEntry](?node.entries);
        ret err[fail.Fail].err{fail.refused(pushed.err)};
    }
    val added: res[usize, A.Error] = collections_vector.push[fe_sema.fields.Node](?surface.graph.nodes, node);
    if (sel added.err) {
        collections_vector.dnit[type.FieldEntry](?node.entries);
        ret err[fail.Fail].err{fail.refused(added.err)};
    }
    ret typed_surface_encode(fb, ?surface);
}

test typed_surface__discriminator_and_case_notices_round_trip_and_move_the_bytes {
    var alloc: A.Allocator;
    page.make(?alloc);
    val notice:    deprecation.Deprecation = deprecation.Deprecation{present: true, owner: lang_source.file_id(4), message: intern.str_id(31)};
    var base:      wire.Sink               = wire.grown(?alloc);
    var widened:   wire.Sink               = wire.grown(?alloc);
    var renoticed: wire.Sink               = wire.grown(?alloc);
    var clean:     wire.Sink               = wire.grown(?alloc);
    fin {
        wire.dnit(?base);
        wire.dnit(?widened);
        wire.dnit(?renoticed);
        wire.dnit(?clean);
    }
    val t_typed_surface_bytes_r: err[fail.Fail] = t_typed_surface_bytes(?base, ?alloc, 7, notice);
    if (sel t_typed_surface_bytes_r.err) { ret 1; }
    val t_typed_surface_bytes_r2: err[fail.Fail] = t_typed_surface_bytes(?widened, ?alloc, 8, notice);
    if (sel t_typed_surface_bytes_r2.err) { ret 2; }
    val t_typed_surface_bytes_r3: err[fail.Fail] = t_typed_surface_bytes(?renoticed, ?alloc, 7, deprecation.Deprecation{present: true, owner: lang_source.file_id(4), message: intern.str_id(32)});
    if (sel t_typed_surface_bytes_r3.err) { ret 3; }
    val t_typed_surface_bytes_r4: err[fail.Fail] = t_typed_surface_bytes(?clean, ?alloc, 7, deprecation.none());
    if (sel t_typed_surface_bytes_r4.err)                                                                { ret 4; }
    if (base.len != widened.len || base.len != renoticed.len || base.len != clean.len)                   { ret 5; }
    if (t_same_bytes(?base, ?widened) || t_same_bytes(?base, ?renoticed) || t_same_bytes(?base, ?clean)) { ret 6; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    val decoded: res[fe_sema.ModuleSema, fail.Fail] = typed_surface_decode(?itn, ?alloc, wire.bytes(?base), base.len::u32, intern.str_id(3), module.id(1));
    if (sel decoded.err) { ret 7; }
    var surface: fe_sema.ModuleSema = decoded.ok;
    fin { fe_sema.module_sema_dnit(?surface); }
    if (surface.graph.nodes.len != 1 || !type.same(surface.graph.nodes.data[0].ty, type.id(40)) || !type.same(surface.graph.nodes.data[0].disc, type.id(7))) { ret 8; }
    val entry: type.FieldEntry = surface.graph.nodes.data[0].entries.data[0];
    if (surface.graph.nodes.data[0].entries.len != 1 || !intern.str_same(entry.name, intern.str_id(21)) || !type.same(entry.ty, type.id(22)) || !deprecation.equal(entry.deprecation, notice)) { ret 9; }
    ret 0;
}

#[testing]
fun t_recipe_node(surface: *fe_sema.ModuleSema, a: *A.Allocator, ty: u32, flags: u8, fields_len: u32) err[fail.Fail] {
    var node: fe_sema.fields.Node = fe_sema.fields.Node{
        ty:     ty::type.TypeId, entries: collections_vector.init[type.FieldEntry](a), has_align: (flags & 1) != 0, align: ty + 1,
        packed: (flags & 2) != 0, volatile_: (flags & 4) != 0, disc: (ty + 2)::type.TypeId
    };
    var j: u32 = 0;
    for (j < fields_len) {
        val notice: deprecation.Deprecation = deprecation.Deprecation{present: (j & 1) != 0,
            owner: (ty * 10 + j)::lang_source.FileId, message: (ty * 100 + j)::intern.StrId};
        val pushed: res[usize, A.Error] = collections_vector.push[type.FieldEntry](?node.entries,
            type.FieldEntry{name: (ty * 1000 + j)::intern.StrId, ty: (ty * 10000 + j)::type.TypeId, deprecation: notice});
        if (sel pushed.err) {
            collections_vector.dnit[type.FieldEntry](?node.entries);
            ret err[fail.Fail].err{fail.refused(pushed.err)};
        }
        j = j + 1;
    }
    val added: res[usize, A.Error] = collections_vector.push[fe_sema.fields.Node](?surface.graph.nodes, node);
    if (sel added.err) {
        collections_vector.dnit[type.FieldEntry](?node.entries);
        ret err[fail.Fail].err{fail.refused(added.err)};
    }
    ret err[fail.Fail].ok{};
}

# the recipe layout written one value at a time, the reference the writer and reader must agree with
#[testing]
fun t_recipe_reference(s: *wire.Sink, surface: *fe_sema.ModuleSema) {
    wire.put_u32(s, 0);
    wire.put_u32(s, surface.graph.nodes.len::u32);
    var i: usize = 0;
    for (i < surface.graph.nodes.len) {
        val node:  *fe_sema.fields.Node = ?surface.graph.nodes.data[i];
        var flags: u8                   = 0;
        if (node.has_align) { flags = flags | 1; }
        if (node.packed)    { flags = flags | 2; }
        if (node.volatile_) { flags = flags | 4; }
        wire.put_u32(s, node.ty::u32);
        wire.put_u8(s, flags);
        wire.put_u32(s, node.align);
        wire.put_u32(s, node.disc::u32);
        wire.put_u32(s, node.entries.len::u32);
        var j: usize = 0;
        for (j < node.entries.len) {
            wire.put_u32(s, node.entries.data[j].name::u32);
            wire.put_u32(s, node.entries.data[j].ty::u32);
            wire.put_u8(s, node.entries.data[j].deprecation.present::u8);
            wire.put_u32(s, node.entries.data[j].deprecation.owner::u32);
            wire.put_u32(s, node.entries.data[j].deprecation.message::u32);
            j = j + 1;
        }
        i = i + 1;
    }
}

#[testing]
fun t_same_bytes(a: *wire.Sink, b: *wire.Sink) bool {
    ret a.len == b.len && memory.raw_equal(wire.bytes(a)::ptr, wire.bytes(b)::ptr, a.len);
}

#[testing]
fun t_same_recipes(left: *fe_sema.ModuleSema, right: *fe_sema.ModuleSema) bool {
    if (left.graph.nodes.len != right.graph.nodes.len) { ret false; }
    var i: usize = 0;
    for (i < left.graph.nodes.len) {
        val l: *fe_sema.fields.Node = ?left.graph.nodes.data[i];
        val r: *fe_sema.fields.Node = ?right.graph.nodes.data[i];
        if (!type.same(l.ty, r.ty) || l.has_align != r.has_align || l.align != r.align || l.packed != r.packed
            || l.volatile_ != r.volatile_ || !type.same(l.disc, r.disc) || l.entries.len != r.entries.len) { ret false; }
        var j: usize = 0;
        for (j < l.entries.len) {
            val le: type.FieldEntry = l.entries.data[j];
            val re: type.FieldEntry = r.entries.data[j];
            if (!intern.str_same(le.name, re.name) || !type.same(le.ty, re.ty) || !deprecation.equal(le.deprecation, re.deprecation)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

test typed_surface__recipes_keep_the_layout_and_refuse_every_truncation {
    var alloc: A.Allocator;
    page.make(?alloc);
    var surface: fe_sema.ModuleSema = fe_sema.module_sema_init(?alloc, intern.str_id(3), module.id(1));
    fin { fe_sema.module_sema_dnit(?surface); }
    val first: err[fail.Fail] = t_recipe_node(?surface, ?alloc, 5, 7, 11);
    if (sel first.err) { ret 1; }
    val empty: err[fail.Fail] = t_recipe_node(?surface, ?alloc, 6, 0, 0);
    if (sel empty.err) { ret 2; }
    val last: err[fail.Fail] = t_recipe_node(?surface, ?alloc, 7, 2, 3);
    if (sel last.err) { ret 3; }
    var batched:   wire.Sink = wire.grown(?alloc);
    var reference: wire.Sink = wire.grown(?alloc);
    fin {
        wire.dnit(?batched);
        wire.dnit(?reference);
    }
    val written: err[fail.Fail] = typed_surface_encode(?batched, ?surface);
    if (sel written.err || batched.failed) { ret 4; }
    t_recipe_reference(?reference, ?surface);
    if (!t_same_bytes(?batched, ?reference)) { ret 6; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    val decoded: res[fe_sema.ModuleSema, fail.Fail] = typed_surface_decode(?itn, ?alloc, wire.bytes(?batched), batched.len::u32, intern.str_id(3), module.id(1));
    if (sel decoded.err) { ret 7; }
    var round: fe_sema.ModuleSema = decoded.ok;
    fin { fe_sema.module_sema_dnit(?round); }
    if (!t_same_recipes(?surface, ?round)) { ret 8; }
    var cut: usize = 0;
    for (cut < batched.len) {
        val short: res[fe_sema.ModuleSema, fail.Fail] = typed_surface_decode(?itn, ?alloc, wire.bytes(?batched), cut::u32, intern.str_id(3), module.id(1));
        if (sel short.ok) {
            var kept: fe_sema.ModuleSema = short.ok;
            fe_sema.module_sema_dnit(?kept);
            ret 9;
        }
        cut = cut + 1;
    }
    # the first field's notice flag sits after the count, the node header and the field's name and type
    val flag_at: usize = 8 + 17 + 8;
    val bytes:   *u8   = wire.bytes(?batched);
    if (bytes[flag_at] != 0) { ret 10; }
    bytes[flag_at] = 2;
    val flagged: res[fe_sema.ModuleSema, fail.Fail] = typed_surface_decode(?itn, ?alloc, bytes, batched.len::u32, intern.str_id(3), module.id(1));
    bytes[flag_at] = 0;
    if (sel flagged.ok) {
        var kept: fe_sema.ModuleSema = flagged.ok;
        fe_sema.module_sema_dnit(?kept);
        ret 11;
    }
    # node attributes above the three known bits are refused
    bytes[12] = 8;
    val attributed: res[fe_sema.ModuleSema, fail.Fail] = typed_surface_decode(?itn, ?alloc, bytes, batched.len::u32, intern.str_id(3), module.id(1));
    if (sel attributed.ok) {
        var kept: fe_sema.ModuleSema = attributed.ok;
        fe_sema.module_sema_dnit(?kept);
        ret 12;
    }
    ret 0;
}
