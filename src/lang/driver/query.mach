use std.crypto.hash.sha256;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator.page;
use std.encoding.binary;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.build.fingerprint;
use mach.lang.fe.resolve;
use mach.lang.query;
use mach.lang.target.of;

pub rec FpBuf {
    alloc: *A.Allocator;
    buf:   *u8;
    len:   usize;
    cap:   usize;
}

fun fp_next_capacity(cap: usize, required: usize) R.Result[usize, str] {
    if (required <= cap) { ret R.ok[usize, str](cap); }
    var new_cap: usize = cap;
    if (new_cap == 0) { new_cap = 64; }
    for (required > new_cap) {
        if (new_cap > ~(0::usize) / 2) { new_cap = required; }
        or { new_cap = new_cap * 2; }
    }
    ret R.ok[usize, str](new_cap);
}

fun fp_reserve(b: *FpBuf, extra: usize) R.Result[R.Void, str] {
    if (extra > ~(0::usize) - b.len) {
        ret R.err[R.Void, str]("fingerprint buffer length overflow");
    }
    val required: usize = b.len + extra;
    if (required <= b.cap) { ret R.ok_void[str](); }
    val nc: R.Result[usize, str] = fp_next_capacity(b.cap, required);
    if (R.is_err[usize, str](nc)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](nc)); }
    val new_cap: usize = R.unwrap_ok[usize, str](nc);
    if (b.buf == nil) {
        val r: R.Result[*u8, str] = A.allocate[u8](b.alloc, new_cap);
        if (R.is_err[*u8, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](r)); }
        b.buf = R.unwrap_ok[*u8, str](r);
    } or {
        val r: R.Result[*u8, str] = A.reallocate[u8](b.alloc, b.buf, b.cap, new_cap);
        if (R.is_err[*u8, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*u8, str](r)); }
        b.buf = R.unwrap_ok[*u8, str](r);
    }
    b.cap = new_cap;
    ret R.ok_void[str]();
}

pub fun fp_u8(b: *FpBuf, v: u8) R.Result[R.Void, str] {
    val r: R.Result[R.Void, str] = fp_reserve(b, 1);
    if (R.is_err[R.Void, str](r)) { ret r; }
    b.buf[b.len] = v;
    b.len = b.len + 1;
    ret R.ok_void[str]();
}

pub fun fp_u32(b: *FpBuf, v: u32) R.Result[R.Void, str] {
    val r: R.Result[R.Void, str] = fp_reserve(b, 4);
    if (R.is_err[R.Void, str](r)) { ret r; }
    b.buf[b.len]     = (v & 0xFF)::u8;
    b.buf[b.len + 1] = ((v >> 8) & 0xFF)::u8;
    b.buf[b.len + 2] = ((v >> 16) & 0xFF)::u8;
    b.buf[b.len + 3] = ((v >> 24) & 0xFF)::u8;
    b.len = b.len + 4;
    ret R.ok_void[str]();
}

pub fun fp_u16(b: *FpBuf, v: u16) R.Result[R.Void, str] {
    val r: R.Result[R.Void, str] = fp_reserve(b, 2);
    if (R.is_err[R.Void, str](r)) { ret r; }
    b.buf[b.len]     = (v & 0xFF)::u8;
    b.buf[b.len + 1] = ((v >> 8) & 0xFF)::u8;
    b.len = b.len + 2;
    ret R.ok_void[str]();
}

pub fun fp_domain_u8(b: *FpBuf, domain: fingerprint.Domain, schema_version: u8, value: u8) R.Result[R.Void, str] {
    val rd: R.Result[R.Void, str] = fp_u16(b, domain);
    if (R.is_err[R.Void, str](rd)) { ret rd; }
    val rs: R.Result[R.Void, str] = fp_u8(b, schema_version);
    if (R.is_err[R.Void, str](rs)) { ret rs; }
    ret fp_u8(b, value);
}

pub fun fp_bytes(b: *FpBuf, p: *u8, len: u32) R.Result[R.Void, str] {
    if (len == 0) { ret R.ok_void[str](); }
    val r: R.Result[R.Void, str] = fp_reserve(b, len::usize);
    if (R.is_err[R.Void, str](r)) { ret r; }
    memory.raw_copy((?b.buf[b.len])::ptr, p::ptr, len::usize);
    b.len = b.len + len::usize;
    ret R.ok_void[str]();
}

pub fun resolve_handle_encode(alloc: *A.Allocator, r: *resolve.ResolveResult) R.Result[query.QueryOutput, str] {
    val n: u32 = $size_of(ptr)::u32;
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, n::usize);
    if (R.is_err[*u8, str](rb)) {
        resolve.dnit_result(r);
        A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
        ret R.err[query.QueryOutput, str](R.unwrap_err[*u8, str](rb));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret R.ok[query.QueryOutput, str](out);
}

pub fun resolve_handle_decode(e: *query.QueryEntry) *resolve.ResolveResult {
    if (e.value == nil || e.value_len::usize < $size_of(ptr)) { ret nil; }
    val slot: *ptr = e.value::ptr::*ptr;
    ret slot[0]::*resolve.ResolveResult;
}

pub fun fp_file_content(fb: *FpBuf, path: *u8) R.Result[R.Void, str] {
    if (path == nil) { ret fp_u32(fb, 0); }
    var digest: [32]u8;
    val rr: R.Result[R.Void, str] = fingerprint.file_sha256(path::str, ?digest[0]);
    if (R.is_err[R.Void, str](rr)) { ret rr; }

    val rl: R.Result[R.Void, str] = fp_u32(fb, sha256.DIGEST_SIZE::u32);
    if (R.is_err[R.Void, str](rl)) { ret rl; }
    var i: u32 = 0;
    for (i < sha256.DIGEST_SIZE::u32) {
        val rb: R.Result[R.Void, str] = fp_u8(fb, digest[i]);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun fp_content(fb: *FpBuf, bytes: *u8, len: usize) R.Result[R.Void, str] {
    if (bytes == nil) { ret fp_u32(fb, 0); }
    var digest: [32]u8;
    sha256.hash(bytes, len, ?digest[0]);
    val rl: R.Result[R.Void, str] = fp_u32(fb, sha256.DIGEST_SIZE::u32);
    if (R.is_err[R.Void, str](rl)) { ret rl; }
    var i: u32 = 0;
    for (i < sha256.DIGEST_SIZE::u32) {
        val rb: R.Result[R.Void, str] = fp_u8(fb, digest[i]);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun fp_u64(b: *FpBuf, v: u64) R.Result[R.Void, str] {
    val lo: R.Result[R.Void, str] = fp_u32(b, (v & 0xFFFFFFFF)::u32);
    if (R.is_err[R.Void, str](lo)) { ret lo; }
    ret fp_u32(b, (v >> 32)::u32);
}

pub fun fp_cstr(b: *FpBuf, s: *u8) R.Result[R.Void, str] {
    if (s == nil) { ret fp_u32(b, 0); }
    val len: usize = str_len(s::str);
    if (len > 0xFFFFFFFF::usize) { ret R.err[R.Void, str]("fingerprint string exceeds 32-bit length"); }
    val n: u32 = len::u32;
    val rl: R.Result[R.Void, str] = fp_u32(b, n);
    if (R.is_err[R.Void, str](rl)) { ret rl; }
    var i: u32 = 0;
    for (i < n) {
        val rb: R.Result[R.Void, str] = fp_u8(b, s[i]);
        if (R.is_err[R.Void, str](rb)) { ret rb; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun fp_free(fb: *FpBuf) {
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](fb.alloc, fb.buf, fb.cap); }
    fb.buf = nil;
    fb.len = 0;
    fb.cap = 0;
}

pub fun fp_input_len(fb: *FpBuf) R.Result[u32, str] {
    if (fb.len > 0xFFFFFFFF::usize) {
        ret R.err[u32, str]("fingerprint exceeds 32-bit query input length");
    }
    ret R.ok[u32, str](fb.len::u32);
}

pub fun fp_take(fb: *FpBuf) R.Result[query.QueryOutput, str] {
    var out: query.QueryOutput;
    out.bytes = nil;
    out.len   = 0;

    val lr: R.Result[u32, str] = fp_input_len(fb);
    if (R.is_err[u32, str](lr)) {
        fp_free(fb);
        ret R.err[query.QueryOutput, str](R.unwrap_err[u32, str](lr));
    }

    if (fb.buf == nil || fb.len == 0) {
        if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](fb.alloc, fb.buf, fb.cap); }
        fb.buf = nil;
        fb.len = 0;
        fb.cap = 0;
        ret R.ok[query.QueryOutput, str](out);
    }

    if (fb.len < fb.cap) {
        val r: R.Result[*u8, str] = A.reallocate[u8](fb.alloc, fb.buf, fb.cap, fb.len);
        if (R.is_err[*u8, str](r)) {
            A.deallocate[u8](fb.alloc, fb.buf, fb.cap);
            fb.buf = nil;
            fb.len = 0;
            fb.cap = 0;
            ret R.err[query.QueryOutput, str](R.unwrap_err[*u8, str](r));
        }
        fb.buf = R.unwrap_ok[*u8, str](r);
        fb.cap = fb.len;
    }

    out.bytes = fb.buf;
    out.len   = R.unwrap_ok[u32, str](lr);
    fb.buf = nil;
    fb.cap = 0;
    ret R.ok[query.QueryOutput, str](out);
}

test "mach.lang.driver.query:fingerprint_capacity_checks_boundaries" {
    val grown: R.Result[usize, str] = fp_next_capacity((~(0::usize) / 2) + 1, ~(0::usize));
    if (R.is_err[usize, str](grown) || R.unwrap_ok[usize, str](grown) != ~(0::usize)) { ret 1; }

    var fb: FpBuf;
    fb.alloc = nil;
    fb.buf = nil;
    fb.len = ~(0::usize);
    fb.cap = ~(0::usize);
    val overflow: R.Result[R.Void, str] = fp_u8(?fb, 0);
    if (R.is_ok[R.Void, str](overflow)) { ret 1; }
    ret 0;
}

test "mach.lang.driver.query:fingerprint_query_length_is_explicit" {
    var fb: FpBuf;
    fb.alloc = nil;
    fb.buf = nil;
    fb.len = 0x100000000::usize;
    fb.cap = 0;
    val too_large: R.Result[query.QueryOutput, str] = fp_take(?fb);
    if (R.is_ok[query.QueryOutput, str](too_large)) { ret 1; }
    if (fb.buf != nil || fb.len != 0 || fb.cap != 0) { ret 1; }

    fb.len = 0xFFFFFFFF::usize;
    val boundary: R.Result[u32, str] = fp_input_len(?fb);
    if (R.is_err[u32, str](boundary) || R.unwrap_ok[u32, str](boundary) != 0xFFFFFFFF) { ret 1; }
    ret 0;
}

fun fp_bytes_eq(a: *u8, b: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "mach.lang.driver.query:fp_domain_u8_deterministic" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var fb_a: FpBuf;
    fb_a.alloc = ?alloc; fb_a.buf = nil; fb_a.len = 0; fb_a.cap = 0;
    var fb_b: FpBuf;
    fb_b.alloc = ?alloc; fb_b.buf = nil; fb_b.len = 0; fb_b.cap = 0;

    if (R.is_err[R.Void, str](fp_domain_u8(?fb_a, fingerprint.DOMAIN_SUBSYSTEM, 1, 2))) { ret 1; }
    if (R.is_err[R.Void, str](fp_domain_u8(?fb_b, fingerprint.DOMAIN_SUBSYSTEM, 1, 2))) { ret 1; }

    if (fb_a.len != fb_b.len)                      { ret 1; }
    if (!fp_bytes_eq(fb_a.buf, fb_b.buf, fb_a.len)) { ret 1; }

    if (fb_a.buf != nil && fb_a.cap > 0) { A.deallocate[u8](?alloc, fb_a.buf, fb_a.cap); }
    if (fb_b.buf != nil && fb_b.cap > 0) { A.deallocate[u8](?alloc, fb_b.buf, fb_b.cap); }
    ret 0;
}

test "mach.lang.driver.query:fp_domain_u8_domain_separated" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var fb_a: FpBuf;
    fb_a.alloc = ?alloc; fb_a.buf = nil; fb_a.len = 0; fb_a.cap = 0;
    var fb_b: FpBuf;
    fb_b.alloc = ?alloc; fb_b.buf = nil; fb_b.len = 0; fb_b.cap = 0;

    if (R.is_err[R.Void, str](fp_domain_u8(?fb_a, 1, 1, 5))) { ret 1; }
    if (R.is_err[R.Void, str](fp_domain_u8(?fb_b, 2, 1, 5))) { ret 1; }

    if (fb_a.len != fb_b.len)                          { ret 1; }
    if (fp_bytes_eq(fb_a.buf, fb_b.buf, fb_a.len))      { ret 1; }

    if (fb_a.buf != nil && fb_a.cap > 0) { A.deallocate[u8](?alloc, fb_a.buf, fb_a.cap); }
    if (fb_b.buf != nil && fb_b.cap > 0) { A.deallocate[u8](?alloc, fb_b.buf, fb_b.cap); }
    ret 0;
}

test "mach.lang.driver.query:fp_domain_u8_schema_and_value_separated" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    var fb_a: FpBuf;
    fb_a.alloc = ?alloc; fb_a.buf = nil; fb_a.len = 0; fb_a.cap = 0;
    var fb_b: FpBuf;
    fb_b.alloc = ?alloc; fb_b.buf = nil; fb_b.len = 0; fb_b.cap = 0;
    var fb_c: FpBuf;
    fb_c.alloc = ?alloc; fb_c.buf = nil; fb_c.len = 0; fb_c.cap = 0;

    if (R.is_err[R.Void, str](fp_domain_u8(?fb_a, 1, 1, 5))) { ret 1; }
    if (R.is_err[R.Void, str](fp_domain_u8(?fb_b, 1, 2, 5))) { ret 1; }
    if (R.is_err[R.Void, str](fp_domain_u8(?fb_c, 1, 1, 6))) { ret 1; }

    if (fb_a.len != fb_b.len || fb_a.len != fb_c.len)   { ret 1; }
    if (fp_bytes_eq(fb_a.buf, fb_b.buf, fb_a.len))       { ret 1; }
    if (fp_bytes_eq(fb_a.buf, fb_c.buf, fb_a.len))       { ret 1; }

    if (fb_a.buf != nil && fb_a.cap > 0) { A.deallocate[u8](?alloc, fb_a.buf, fb_a.cap); }
    if (fb_b.buf != nil && fb_b.cap > 0) { A.deallocate[u8](?alloc, fb_b.buf, fb_b.cap); }
    if (fb_c.buf != nil && fb_c.cap > 0) { A.deallocate[u8](?alloc, fb_c.buf, fb_c.cap); }
    ret 0;
}

test "mach.lang.driver.query:fp_domain_u8_matches_fingerprint_encoder_framing" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }

    val tag: u8 = of.subsystem_fingerprint_tag(of.SUBSYSTEM_GUI);

    var e: binary.Encoder = binary.encoder(?alloc, binary.LITTLE);
    if (!fingerprint.write_domain_u8(?e, fingerprint.DOMAIN_SUBSYSTEM, of.SUBSYSTEM_CATALOG_VERSION, tag)) { ret 1; }

    var fb: FpBuf;
    fb.alloc = ?alloc; fb.buf = nil; fb.len = 0; fb.cap = 0;
    if (R.is_err[R.Void, str](fp_domain_u8(?fb, fingerprint.DOMAIN_SUBSYSTEM, of.SUBSYSTEM_CATALOG_VERSION, tag))) { ret 1; }

    if (e.len != fb.len)                       { ret 1; }
    if (!fp_bytes_eq(e.data, fb.buf, e.len))    { ret 1; }

    binary.encoder_dnit(?e);
    if (fb.buf != nil && fb.cap > 0) { A.deallocate[u8](?alloc, fb.buf, fb.cap); }
    ret 0;
}
