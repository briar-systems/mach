# the front end's products: a module's parse, its resolution and the surface it exports, its
# types and the typed surface importers read, each a kind declared here beside its computation.
# a computation reads what it depends on through the query engine, and a host reads a product
# through the readers here: inside an operation by acquiring it, between operations as this
# project's operations last published it
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.memory;

use mach.lang.deprecation;
use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_id: mach.lang.fe.ast.id;
use mach.lang.fe.expect;
use fe_lexer:  mach.lang.fe.lexer;
use fe_load:   mach.lang.fe.load;
use fe_parser: mach.lang.fe.parser;
use mach.lang.fe.parser.state;
use mach.lang.fe.resolve;
use lang_fingerprint: mach.lang.fingerprint;
use mach.lang.float;
use mach.lang.growth;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.query;
use mach.lang.readout;
use mach.lang.session;
use session_embed: mach.lang.session.embed;
use lang_source:   mach.lang.source;
use mach.lang.wire;

use mach.lang.driver.codec;
use mach.lang.driver.context;
use mach.lang.driver.project;
use comptime_scope: mach.lang.fe.comptime.scope;
use comptime_value: mach.lang.fe.comptime.value;
use sema_fields:    mach.lang.fe.sema.fields;
use sema_module:    mach.lang.fe.sema.module;
use sema_product:   mach.lang.fe.sema.product;
use sema_surface:   mach.lang.fe.sema.surface;
use lang_phase:     mach.lang.phase;
use type_field:     mach.lang.type.field;

# a file's parse: the syntax tree and how the parse stood, keyed by the file
pub val PARSE: query.Kind = query.Kind{
    name: "parse", role: query.DERIVED, owner: query.KEY_FILE, origin: diagnostic.ORIGIN_LOAD, compute: parse_compute, finalize: parse_finalize
};
# the digest of what the load walk decided for a module, keyed by its stable id
pub val LOAD_VIEW: query.Kind = query.Kind{name: "load view", role: query.INPUT, owner: query.KEY_MODULE};
# the module id this build numbers a module with, keyed by its stable id
pub val MODULE_NUMBER: query.Kind = query.Kind{name: "module number", role: query.INPUT, owner: query.KEY_MODULE};
# a module's resolution, keyed by its stable id
pub val RESOLVE: query.Kind = query.Kind{
    name: "resolve", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_RESOLVE, compute: resolve_compute, finalize: resolve_finalize
};
# what a module's resolution exports to an importer, keyed by its stable id
pub val EXPORTS: query.Kind = query.Kind{
    name:     "exports", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_RESOLVE, compute: exports_compute,
    finalize: exports_finalize, equal: exports_equal
};
# a module's types, keyed by its stable id
pub val SEMA: query.Kind = query.Kind{
    name: "sema", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_SEMA, compute: sema_compute, finalize: sema_finalize
};
# the typed surface a module exports to its importers, shared by every one, keyed by its stable id
pub val TYPED_EXPORTS: query.Kind = query.Kind{
    name:     "typed exports", role: query.DERIVED, owner: query.KEY_MODULE, origin: diagnostic.ORIGIN_SEMA, compute: typed_exports_compute,
    finalize: surface_finalize, equal: surface_equal
};

# a module's parse in the open operation
pub fun parse(p: *project.Project, m: *project.ModuleEntry) res[ParsedModule, fail.Fail] {
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?PARSE, lang_source.file_index(m.file_id)::u64);
    if (sel acquired.err) { ret res[ParsedModule, fail.Fail].err{acquired.err}; }
    val view: query.QueryView = acquired.ok;
    if (view.value == nil || view.value_len::usize < $size_of(ParsedModule)) { ret res[ParsedModule, fail.Fail].err{fail.message("parse query produced no syntax tree")}; }
    val parsed: ParsedModule = @(view.value::ptr::*ParsedModule);
    if (parsed.a == nil) { ret res[ParsedModule, fail.Fail].err{fail.message("parse query produced no syntax tree")}; }
    ret res[ParsedModule, fail.Fail].ok{parsed};
}

# a module's resolution in the open operation
pub fun resolution(p: *project.Project, m: *project.ModuleEntry) res[*resolve.ResolveResult, fail.Fail] {
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?RESOLVE, module.stable_index(m.stable_id)::u64);
    if (sel acquired.err) { ret res[*resolve.ResolveResult, fail.Fail].err{acquired.err}; }
    val rr: *resolve.ResolveResult = codec.resolve_handle_decode(acquired.ok);
    if (rr == nil) { ret res[*resolve.ResolveResult, fail.Fail].err{fail.message("resolve query produced no result")}; }
    ret res[*resolve.ResolveResult, fail.Fail].ok{rr};
}

# a module's syntax tree: inside an operation the parse it acquires, which a computation reading
# it depends on, and between operations the one this project's operations last published. nil
# when the module has none, and inside an operation when the parse could not be acquired: the
# operation keeps that failure and ends with it, so nothing built on the nil is published
pub fun syntax(p: *project.Project, m: *project.ModuleEntry) *ast.Ast {
    if (lang_source.file_is_nil(m.file_id)) { ret nil; }
    if (p.s.queries.operation_active) {
        val acquired: res[ParsedModule, fail.Fail] = parse(p, m);
        if (sel acquired.err) { ret nil; }
        ret acquired.ok.a;
    }
    val shown: opt[ParsedModule] = parsed(p, m);
    if (sel shown.none) { ret nil; }
    ret shown.some.a;
}

# a module's parse as this project's operations last published it
pub fun parsed(p: *project.Project, m: *project.ModuleEntry) opt[ParsedModule] {
    if (lang_source.file_is_nil(m.file_id)) { ret opt[ParsedModule].none{}; }
    val shown: opt[query.QueryView] = query.published(?p.s.queries, ?PARSE, lang_source.file_index(m.file_id)::u64, p.since);
    if (sel shown.none) { ret opt[ParsedModule].none{}; }
    val view: query.QueryView = shown.some;
    ret opt[ParsedModule].some{@(codec.handle_bytes(view.value, view.value_len, $size_of(ParsedModule))::ptr::*ParsedModule)};
}

# a module's resolution as this project's operations last published it, nil when none did or its
# front end was skipped
pub fun resolved(p: *project.Project, m: *project.ModuleEntry) *resolve.ResolveResult {
    if (m.frontend_skipped) { ret nil; }
    val shown: opt[query.QueryView] = query.published(?p.s.queries, ?RESOLVE, module.stable_index(m.stable_id)::u64, p.since);
    if (sel shown.none) { ret nil; }
    ret codec.resolve_handle_decode(shown.some);
}

# a module's types as this project's operations last published them, nil when none did or its
# front end was skipped
pub fun typed(p: *project.Project, m: *project.ModuleEntry) *sema_product.SemaResult {
    if (m.frontend_skipped) { ret nil; }
    val shown: opt[query.QueryView] = query.published(?p.s.queries, ?SEMA, module.stable_index(m.stable_id)::u64, p.since);
    if (sel shown.none) { ret nil; }
    ret sema_handle_decode(shown.some);
}

# the standing of the load walk alone, over every module it reached
pub fun load_status(p: *project.Project) lang_phase.PhaseStatus {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var i:      u32                    = 0;
    for (i < project.module_count(p)) {
        lang_phase.merge(?status, project.module_at(p, i).load.status);
        i = i + 1;
    }
    ret status;
}

# the standing of one module: its load's and that of each product this project's operations
# published for it
pub fun module_status(p: *project.Project, m: *project.ModuleEntry) lang_phase.PhaseStatus {
    var status: lang_phase.PhaseStatus = m.load.status;
    val shown:  opt[ParsedModule]      = parsed(p, m);
    if (sel shown.some) { lang_phase.merge(?status, shown.some.status); }
    val rr: *resolve.ResolveResult   = resolved(p, m);
    val sr: *sema_product.SemaResult = typed(p, m);
    if (rr != nil) { lang_phase.merge(?status, rr.status); }
    if (sr != nil) { lang_phase.merge(?status, sr.status); }
    ret status;
}

# the standing of the front end over every module
pub fun frontend_status(p: *project.Project) lang_phase.PhaseStatus {
    var status: lang_phase.PhaseStatus = lang_phase.accepted();
    var i:      u32                    = 0;
    for (i < project.module_count(p)) {
        lang_phase.merge(?status, module_status(p, project.module_at(p, i)));
        i = i + 1;
    }
    ret status;
}

# a parse product: the syntax tree it owns and how the parse stood
pub rec ParsedModule {
    a:      *ast.Ast;
    status: lang_phase.PhaseStatus;
}

fun parsed_definition(ctx: ptr, mid: module.ModuleId) res[resolve.ParsedDefinition, fail.Fail] {
    val p: *project.Project = ctx::*project.Project;
    if (p == nil || module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[resolve.ParsedDefinition, fail.Fail].err{fail.message("parsed definition module is not in the active project")};
    }
    val m:        *project.ModuleEntry         = project.module_at(p, mid::u32);
    val file_id:  lang_source.FileId           = m.file_id;
    val acquired: res[ParsedModule, fail.Fail] = parse(p, m);
    if (sel acquired.err) { ret res[resolve.ParsedDefinition, fail.Fail].err{acquired.err}; }
    val a:      *ast.Ast               = acquired.ok.a;
    val status: lang_phase.PhaseStatus = acquired.ok.status;
    ret res[resolve.ParsedDefinition, fail.Fail].ok{resolve.ParsedDefinition{a: a, status: status, owner: resolve.type_owner(p.s, mid, file_id), incarnation: a.incarnation}};
}

fun parse_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:       *project.Project   = raw::*project.Project;
    val s:       *session.Session   = p.s;
    val file_id: lang_source.FileId = lang_source.file_id(key::u32);

    val rd: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?session.FILE_TEXT, key);
    if (sel rd.err) { ret res[query.QueryOutput, fail.Fail].err{rd.err}; }

    val file_opt: opt[*lang_source.SourceFile] = lang_source.get(s.sources, file_id);
    if (sel file_opt.none) { ret res[query.QueryOutput, fail.Fail].err{fail.message("parse: the file is not registered with the session")}; }
    val file: *lang_source.SourceFile = file_opt.some;

    val tok_r: res[fe_lexer.TokenStream, fail.Fail] = fe_lexer.tokenize(file.text, alloc, file_id);
    if (sel tok_r.err) { ret res[query.QueryOutput, fail.Fail].err{tok_r.err}; }
    var stream: fe_lexer.TokenStream = tok_r.ok;
    fin { fe_lexer.dnit(?stream, alloc); }

    val ar: res[*ast.Ast, A.Error] = A.allocate[ast.Ast](alloc, 1::usize);
    if (sel ar.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(ar.err)}; }
    val a: *ast.Ast = ar.ok;
    a[0] = ast.init(alloc, file_id);
    var handed: bool = false;
    fin {
        if (!handed) {
            ast.dnit(a);
            A.deallocate[ast.Ast](alloc, a, 1::usize);
        }
    }
    val incarnation: res[u64, fail.Fail] = session.next_parse_incarnation(s);
    if (sel incarnation.err) { ret res[query.QueryOutput, fail.Fail].err{incarnation.err}; }
    a.incarnation = incarnation.ok;

    val le_r: err[fail.Fail] = fe_lexer.emit_diagnostics(?stream, diags);
    if (sel le_r.err) { ret res[query.QueryOutput, fail.Fail].err{le_r.err}; }
    val parse_r: res[lang_phase.PhaseStatus, state.ParseFail] = fe_parser.parse(?stream, a, ?s.interner, diags);
    if (sel parse_r.err) {
        val f: state.ParseFail = parse_r.err;
        ret res[query.QueryOutput, fail.Fail].err{state.failure(f)};
    }

    handed = true;
    ret ast_handle_encode(alloc, a, parse_r.ok);
}

fun parse_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    val a: *ast.Ast = (codec.handle_bytes(value, value_len, $size_of(ParsedModule))::ptr::*ParsedModule).a;
    ast.dnit(a);
    A.deallocate[ast.Ast](alloc, a, 1::usize);
}

fun ast_handle_encode(alloc: *A.Allocator, a: *ast.Ast, status: lang_phase.PhaseStatus) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ParsedModule)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        ast.dnit(a);
        A.deallocate[ast.Ast](alloc, a, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8           = rb.ok;
    val slot: *ParsedModule = buf::ptr::*ParsedModule;
    slot.a      = a;
    slot.status = status;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun ast_handle_decode(e: query.QueryView) *ast.Ast {
    ret (codec.handle_bytes(e.value, e.value_len, $size_of(ParsedModule))::ptr::*ParsedModule).a;
}

# what a module's resolution exports: the symbols and refusal an importer's resolution reads, and
# the constants the module publishes, a change of which is a change of its interface
# ---
# symbols:    the importer's view, its path and module named by the reader
# constants:  the published constants, each a plain value
# definition: the revision of the module's parse when a constant names an element of it, else 0
rec Exports {
    symbols:        resolve.ModuleExports;
    constants:      *resolve.ExportConstant;
    constant_count: u32;
    definition:     query.Revision;
}

fun exports_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p:   *project.Project                = raw::*project.Project;
    val e_r: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?RESOLVE, key);
    if (sel e_r.err) { ret res[query.QueryOutput, fail.Fail].err{e_r.err}; }
    val rr: *resolve.ResolveResult = codec.resolve_handle_decode(e_r.ok);
    if (rr == nil) { ret res[query.QueryOutput, fail.Fail].err{fail.message("exports: the module has no resolve result")}; }

    var definition_revision: query.Revision = 0;
    var i:                   u32            = 0;
    for (i < rr.public_constant_count) {
        if (rr.public_constants[i].present && rr.public_constants[i].value.kind == comptime_value.CT_KIND_CONST_ELEM) {
            val mid: module.ModuleId = module.module_id_for_stable(?p.s.modules, key::u32::module.StableModuleId);
            if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("constant definition is not loaded")}; }
            val observed: res[query.Revision, fail.Fail] = query.revision[project.Project](?p.queries, p,
                ?PARSE, lang_source.file_index(project.module_at(p, mid::u32).file_id)::u64);
            if (sel observed.err) { ret res[query.QueryOutput, fail.Fail].err{observed.err}; }
            definition_revision = observed.ok;
            brk;
        }
        i = i + 1;
    }
    i = 0;
    for (i < rr.public_constant_count) {
        val refused: opt[str] = constant_refusal(?rr.public_constants[i], definition_revision);
        if (sel refused.some) { ret res[query.QueryOutput, fail.Fail].err{fail.message(refused.some)}; }
        i = i + 1;
    }
    val boxed: res[*Exports, A.Error] = A.allocate[Exports](alloc, 1);
    if (sel boxed.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)}; }
    val ex: *Exports = boxed.ok;
    @ex = Exports{definition: definition_revision};
    var handed: bool = false;
    fin {
        if (!handed) { exports_release(ex, alloc); }
    }
    val symbols: res[resolve.ModuleExports, fail.Fail] = resolve.result_exports(alloc, rr, intern.STR_NIL, key::u32::module.StableModuleId);
    if (sel symbols.err) { ret res[query.QueryOutput, fail.Fail].err{symbols.err}; }
    ex.symbols = symbols.ok;
    if (rr.public_constant_count != 0) {
        val constants: res[*resolve.ExportConstant, A.Error] = A.allocate[resolve.ExportConstant](alloc, rr.public_constant_count::usize);
        if (sel constants.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(constants.err)}; }
        memory.raw_copy(constants.ok::ptr, rr.public_constants::ptr, rr.public_constant_count::usize * $size_of(resolve.ExportConstant));
        ex.constants      = constants.ok;
        ex.constant_count = rr.public_constant_count;
    }
    val out: res[query.QueryOutput, fail.Fail] = pointer_output(alloc, ex::ptr);
    if (sel out.ok) { handed = true; }
    ret out;
}

fun exports_of(value: *u8, value_len: u32) *Exports {
    ret (codec.handle_bytes(value, value_len, $size_of(ptr))::ptr::*ptr)[0]::*Exports;
}

fun exports_release(ex: *Exports, alloc: *A.Allocator) {
    resolve.exports_dnit(alloc, ?ex.symbols);
    if (ex.constant_count != 0) { A.deallocate[resolve.ExportConstant](alloc, ex.constants, ex.constant_count::usize); }
    A.deallocate[Exports](alloc, ex, 1);
}

fun exports_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    exports_release(exports_of(value, value_len), alloc);
}

# two exports are the same when an importer reads the same symbols and refusal and the module
# publishes the same constants
fun exports_equal(left: *u8, left_len: u32, right: *u8, right_len: u32) bool {
    val l: *Exports = exports_of(left, left_len);
    val r: *Exports = exports_of(right, right_len);
    if (l.symbols.count != r.symbols.count || l.symbols.refused != r.symbols.refused) { ret false; }
    if (l.constant_count != r.constant_count || l.definition != r.definition)         { ret false; }
    var i: u32 = 0;
    for (i < l.symbols.count) {
        if (!symbol_same(?l.symbols.symbols[i], ?r.symbols.symbols[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < l.constant_count) {
        if (!constant_same(?l.constants[i], ?r.constants[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun symbol_same(l: *resolve.PublicSymbol, r: *resolve.PublicSymbol) bool {
    ret l.kind == r.kind && l.name::u32 == r.name::u32 && l.canon::u32 == r.canon::u32 && l.file::u32 == r.file::u32
        && l.generic_arity == r.generic_arity && l.has_comptime_params == r.has_comptime_params
        && l.has_pack_param == r.has_pack_param && deprecation_same(l.deprecation, r.deprecation)
        && l.testing == r.testing && l.slot == r.slot && l.origin::u32 == r.origin::u32;
}

fun deprecation_same(l: deprecation.Deprecation, r: deprecation.Deprecation) bool {
    ret l.present == r.present && l.owner::u32 == r.owner::u32 && l.message::u32 == r.message::u32;
}

fun constant_same(l: *resolve.ExportConstant, r: *resolve.ExportConstant) bool {
    if (l.name::u32 != r.name::u32 || l.present != r.present) { ret false; }
    ret !l.present || value_same(?l.value, ?r.value);
}

# two published constant values are the same when they hold the same value of the same kind;
# a constant element is the same element of the same revision of its definition, which the
# owner compares beside it
fun value_same(l: *comptime_value.CTValue, r: *comptime_value.CTValue) bool {
    if (l.kind != r.kind) { ret false; }
    val k: comptime_value.CTKind = l.kind;
    if (k == comptime_value.CT_KIND_INT) {
        ret l.data.w.lo == r.data.w.lo && l.data.w.hi == r.data.w.hi && l.int_width == r.int_width && l.int_unsigned == r.int_unsigned;
    }
    if (k == comptime_value.CT_KIND_FLOAT)                                          { ret float.f64_bits(l.data.f) == float.f64_bits(r.data.f) && l.float_width == r.float_width; }
    if (k == comptime_value.CT_KIND_STR || k == comptime_value.CT_KIND_NON_INTEGER) { ret l.data.s::u32 == r.data.s::u32; }
    if (k == comptime_value.CT_KIND_TYPE)                                           { ret l.data.t == r.data.t; }
    if (k == comptime_value.CT_KIND_FIELD || k == comptime_value.CT_KIND_CASE) {
        ret l.data.fld.owner == r.data.fld.owner && l.data.fld.index == r.data.fld.index;
    }
    if (k == comptime_value.CT_KIND_PACK_ELEM) { ret l.data.pelem.index == r.data.pelem.index && l.data.pelem.ty == r.data.pelem.ty; }
    if (k == comptime_value.CT_KIND_NODE) {
        ret l.data.node.module == r.data.node.module && l.data.node.node == r.data.node.node && l.data.node.ty == r.data.node.ty;
    }
    if (k == comptime_value.CT_KIND_CONST_ELEM) { ret l.data.celem.elem == r.data.celem.elem && l.data.celem.ty == r.data.celem.ty; }
    ret false;
}

# why a constant cannot be published, none when it can: its value is of a kind an interface
# holds, and a constant element names a definition whose revision is known
fun constant_refusal(item: *resolve.ExportConstant, definition: query.Revision) opt[str] {
    if (!item.present) { ret opt[str].none{}; }
    val k: comptime_value.CTKind = item.value.kind;
    if (k == comptime_value.CT_KIND_CONST_ELEM) {
        if (definition == 0) { ret opt[str].some{"constant element surface requires its current definition revision"}; }
        ret opt[str].none{};
    }
    if (k == comptime_value.CT_KIND_INT || k == comptime_value.CT_KIND_FLOAT || k == comptime_value.CT_KIND_STR
        || k == comptime_value.CT_KIND_NON_INTEGER || k == comptime_value.CT_KIND_TYPE || k == comptime_value.CT_KIND_FIELD
        || k == comptime_value.CT_KIND_CASE || k == comptime_value.CT_KIND_PACK_ELEM || k == comptime_value.CT_KIND_NODE) {
        ret opt[str].none{};
    }
    ret opt[str].some{"constant surface has an unknown CTKind"};
}

# a product whose bytes are one pointer to what it owns
fun pointer_output(alloc: *A.Allocator, owned: ptr) res[query.QueryOutput, fail.Fail] {
    val bytes: res[*u8, A.Error] = A.allocate[u8](alloc, $size_of(ptr));
    if (sel bytes.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(bytes.err)}; }
    val slot: *ptr = bytes.ok::ptr::*ptr;
    slot[0] = owned;
    ret res[query.QueryOutput, fail.Fail].ok{query.QueryOutput{bytes: bytes.ok, len: $size_of(ptr)::u32}};
}

rec LowerClosure {
    list:  *module.ModuleId;
    count: u32;
    cap:   u32;
}

# a module's definition as far as a phase reads it, through the products of this operation
pub fun read_definition(raw: ptr, mid: module.ModuleId, phase: sema_product.DefinitionPhase) res[sema_product.Definition, fail.Fail] {
    val p:      *project.Project                         = raw::*project.Project;
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = parsed_definition(raw, mid);
    if (sel parsed.err) { ret res[sema_product.Definition, fail.Fail].err{parsed.err}; }
    var result: sema_product.Definition = sema_product.Definition{
        parsed: parsed.ok, origin: mid, decorators: ?project.module_at(p, mid::u32).load.ctx
    };
    if (phase >= sema_product.DEFINITION_RESOLVED) {
        val viewed: err[fail.Fail] = depend_load_view(p, project.module_at(p, mid::u32));
        if (sel viewed.err) { ret res[sema_product.Definition, fail.Fail].err{viewed.err}; }
        val acquired: res[*resolve.ResolveResult, fail.Fail] = resolution(p, project.module_at(p, mid::u32));
        if (sel acquired.err) { ret res[sema_product.Definition, fail.Fail].err{acquired.err}; }
        result.rr = acquired.ok;
    }
    if (phase == sema_product.DEFINITION_TYPED) {
        val acquired: res[*sema_product.SemaResult, fail.Fail] = acquire_sema(p, mid);
        if (sel acquired.err) { ret res[sema_product.Definition, fail.Fail].err{acquired.err}; }
        result.sr = acquired.ok;
        val scoped: res[*comptime_scope.ComptimeCtx, fail.Fail] = lower_scope_for(p, project.module_at(p, mid::u32), parsed.ok.a, result.rr, result.sr);
        if (sel scoped.err) { ret res[sema_product.Definition, fail.Fail].err{scoped.err}; }
        result.ctx = scoped.ok;
    }
    ret res[sema_product.Definition, fail.Fail].ok{result};
}

# the lowering scope of a module as a definition read sees it, made or brought up to date
fun lower_scope_for(p: *project.Project, m: *project.ModuleEntry, a: *ast.Ast, rr: *resolve.ResolveResult,
    sr: *sema_product.SemaResult) res[*comptime_scope.ComptimeCtx, fail.Fail] {
    val prepared: err[fail.Fail] = lower_scope_prepare(m, a, rr, sr);
    if (sel prepared.err) { ret res[*comptime_scope.ComptimeCtx, fail.Fail].err{prepared.err}; }
    ret res[*comptime_scope.ComptimeCtx, fail.Fail].ok{?m.lower_scope};
}

# the scope lowering binds a module's constants in, over what the load, resolve and sema bound
# over it, made on the first call and kept for as long as the module's syntax stands; each call
# sets the layers to the products given, the module's current ones, so it runs only where
# nothing else reads them
fun lower_scope_prepare(m: *project.ModuleEntry, a: *ast.Ast, rr: *resolve.ResolveResult, sr: *sema_product.SemaResult) err[fail.Fail] {
    var exprs:    u32                      = 0;
    var resolved: *comptime_scope.Bindings = nil;
    var typed:    *comptime_scope.Bindings = nil;
    if (a != nil)  { exprs = a.exprs.len::u32; }
    if (rr != nil) { resolved = ?rr.constants; }
    if (sr != nil) { typed = ?sr.constants; }
    ret comptime_scope.lowering_prepare(?m.lower_scope, ?m.lower_scoped, ?m.load.ctx, exprs, resolved, typed);
}

# the lowering scope `lower_scope_prepare` made, read without writing it: a scope that was never
# made, or whose layers are not the products given, is a defect of the caller
fun lower_scope_of(m: *project.ModuleEntry, rr: *resolve.ResolveResult, sr: *sema_product.SemaResult) res[*comptime_scope.ComptimeCtx, fail.Fail] {
    if (!m.lower_scoped) { ret res[*comptime_scope.ComptimeCtx, fail.Fail].err{fail.message("lower: a module's lowering scope was read before it was prepared")}; }
    var current: bool = comptime_scope.layer_at(?m.lower_scope, comptime_scope.STAGE_LOAD) == ?m.load.ctx.own;
    if (rr != nil) { current = current && comptime_scope.layer_at(?m.lower_scope, comptime_scope.STAGE_RESOLVE) == ?rr.constants; }
    if (sr != nil) { current = current && comptime_scope.layer_at(?m.lower_scope, comptime_scope.STAGE_SEMA) == ?sr.constants; }
    if (!current)  { ret res[*comptime_scope.ComptimeCtx, fail.Fail].err{fail.message("lower: a module's lowering scope does not read its current products")}; }
    ret res[*comptime_scope.ComptimeCtx, fail.Fail].ok{?m.lower_scope};
}

fun resolve_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p: *project.Project = raw::*project.Project;
    val s: *session.Session = p.s;

    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("resolve: the stable id is not loaded this build")}; }
    val m:      *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = parsed_definition(p::ptr, mid);
    if (sel parsed.err) { ret res[query.QueryOutput, fail.Fail].err{parsed.err}; }
    val a:  *ast.Ast       = parsed.ok.a;
    val rt: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rv: err[fail.Fail] = depend_load_view(p, m);
    if (sel rv.err) { ret res[query.QueryOutput, fail.Fail].err{rv.err}; }

    val deps_r: res[resolve.ResolveDeps, fail.Fail] = build_resolve_deps_owned(p, m);
    if (sel deps_r.err) { ret res[query.QueryOutput, fail.Fail].err{deps_r.err}; }
    var deps: resolve.ResolveDeps = deps_r.ok;
    fin { resolve.deps_dnit(s.alloc, ?deps); }
    deps.bindings      = m.load.bindings.data;
    deps.binding_count = m.load.bindings.len::u32;

    val rr_r: res[resolve.ResolveResult, fail.Fail] = resolve.resolve(s, a, ?deps, ?m.load.ctx, mid, m.stable_id, diags);
    if (sel rr_r.err) { ret res[query.QueryOutput, fail.Fail].err{rr_r.err}; }
    var result: resolve.ResolveResult = rr_r.ok;

    val br: res[*resolve.ResolveResult, A.Error] = A.allocate[resolve.ResolveResult](alloc, 1::usize);
    if (sel br.err) {
        resolve.result_dnit(?result);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)};
    }
    val box: *resolve.ResolveResult = br.ok;
    box[0] = result;
    ret codec.resolve_handle_encode(alloc, box);
}

fun resolve_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    val r: *resolve.ResolveResult = codec.resolve_handle_decode(query.QueryView{value: value, value_len: value_len});
    resolve.result_dnit(r);
    A.deallocate[resolve.ResolveResult](alloc, r, 1::usize);
}

# what a module exports to an importer, read from its exports product so the importer's
# resolution depends on that surface and nothing else of the module
fun exporter_exports(raw: ptr, mid: module.ModuleId, a: *A.Allocator) res[resolve.ModuleExports, fail.Fail] {
    val p:       *project.Project                = raw::*project.Project;
    val m:       *project.ModuleEntry            = project.module_at(p, mid::u32);
    val surface: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel surface.err) { ret res[resolve.ModuleExports, fail.Fail].err{surface.err}; }
    val ex: *Exports = exports_of(surface.ok.value, surface.ok.value_len);
    ret resolve.exports_copy(a, ?ex.symbols, m.fqn, m.stable_id);
}

fun exporter_path(raw: ptr, mid: module.ModuleId) intern.StrId {
    ret project.module_at(raw::*project.Project, mid::u32).fqn;
}

fun build_resolve_deps_owned(p: *project.Project, m: *project.ModuleEntry) res[resolve.ResolveDeps, fail.Fail] {
    var from: resolve.Exporters = resolve.Exporters{
        ctx: p::ptr, count: project.module_count(p), exports: exporter_exports, path: exporter_path
    };
    ret resolve.deps_of(p.s.alloc, p.s, ?p.loader, ?m.load, ?from);
}

# a module's sema product in the open operation, its field graph installed in the projection
pub fun acquire_sema(p: *project.Project, mid: module.ModuleId) res[*sema_product.SemaResult, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) {
        ret res[*sema_product.SemaResult, fail.Fail].err{fail.message("semantic definition module is not in the active project")};
    }
    val stable:   module.StableModuleId           = project.module_at(p, mid::u32).stable_id;
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?SEMA, module.stable_index(stable)::u64);
    if (sel acquired.err) { ret res[*sema_product.SemaResult, fail.Fail].err{acquired.err}; }
    val result: *sema_product.SemaResult = sema_handle_decode(acquired.ok);
    if (result == nil) { ret res[*sema_product.SemaResult, fail.Fail].err{fail.message("semantic query produced no result owner")}; }
    val installed: err[fail.Fail] = sema_fields.install(p.s, ?result.field_graph);
    if (sel installed.err) { ret res[*sema_product.SemaResult, fail.Fail].err{installed.err}; }
    ret res[*sema_product.SemaResult, fail.Fail].ok{result};
}

fun sema_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p: *project.Project = raw::*project.Project;
    val s: *session.Session = p.s;

    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("sema: the stable id is not loaded this build")}; }
    val m:      *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val parsed: res[resolve.ParsedDefinition, fail.Fail] = parsed_definition(p::ptr, mid);
    if (sel parsed.err) { ret res[query.QueryOutput, fail.Fail].err{parsed.err}; }
    val definition: resolve.ParsedDefinition = parsed.ok;
    if (sel definition.status.kind.internal) { ret res[query.QueryOutput, fail.Fail].err{lang_phase.phase_failure(definition.status)}; }
    val a:      *ast.Ast       = definition.a;
    val viewed: err[fail.Fail] = depend_load_view(p, m);
    if (sel viewed.err) { ret res[query.QueryOutput, fail.Fail].err{viewed.err}; }
    val resolved: res[*resolve.ResolveResult, fail.Fail] = resolution(p, m);
    if (sel resolved.err) { ret res[query.QueryOutput, fail.Fail].err{resolved.err}; }
    val rr: *resolve.ResolveResult = resolved.ok;
    val rt: err[fail.Fail]         = query.depend[project.Project](?p.queries, p, ?context.TARGET, 0);
    if (sel rt.err) { ret res[query.QueryOutput, fail.Fail].err{rt.err}; }
    val rn: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?MODULE_NUMBER, key);
    if (sel rn.err) { ret res[query.QueryOutput, fail.Fail].err{rn.err}; }

    val sdeps_r: res[sema_product.SemaDeps, fail.Fail] = build_sema_deps_query(p, m);
    if (sel sdeps_r.err) { ret res[query.QueryOutput, fail.Fail].err{sdeps_r.err}; }
    var sdeps: sema_product.SemaDeps = sdeps_r.ok;
    sdeps.watch = sema_product.GrowthWatch{ctx: p::ptr, expanded: growth_expanded};

    val sem_r: res[sema_product.SemaResult, fail.Fail] = sema_module.sema(s, a, rr, ?sdeps, ?m.load.ctx, mid, diags);
    free_sema_deps_query(s.alloc, ?sdeps);
    if (sel sem_r.err) { ret res[query.QueryOutput, fail.Fail].err{sem_r.err}; }
    var result: sema_product.SemaResult = sem_r.ok;
    var handed: bool                    = false;
    fin {
        if (!handed) { sema_product.result_dnit(?result); }
    }
    # a rejected parse still types, as the recovered tree is for, and the
    # product carries the parse rejection so the module stays rejected
    lang_phase.merge(?result.status, definition.status);

    var ei: u32 = 0;
    for (ei < result.embed_path_count) {
        val re: err[fail.Fail] = query.depend[project.Project](?p.queries, p, ?session_embed.EMBED_FILE, intern.str_index(result.embed_paths[ei])::u64);
        if (sel re.err) { ret res[query.QueryOutput, fail.Fail].err{re.err}; }
        ei = ei + 1;
    }

    val br: res[*sema_product.SemaResult, A.Error] = A.allocate[sema_product.SemaResult](alloc, 1::usize);
    if (sel br.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(br.err)}; }
    val box: *sema_product.SemaResult = br.ok;
    box[0] = result;
    handed = true;
    ret sema_handle_encode(alloc, box);
}

fun sema_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    val r: *sema_product.SemaResult = sema_handle_decode(query.QueryView{value: value, value_len: value_len});
    sema_product.result_dnit(r);
    A.deallocate[sema_product.SemaResult](alloc, r, 1::usize);
}

fun sema_handle_encode(alloc: *A.Allocator, r: *sema_product.SemaResult) res[query.QueryOutput, fail.Fail] {
    val n:  u32               = $size_of(ptr)::u32;
    val rb: res[*u8, A.Error] = A.allocate[u8](alloc, n::usize);
    if (sel rb.err) {
        sema_product.result_dnit(r);
        A.deallocate[sema_product.SemaResult](alloc, r, 1::usize);
        ret res[query.QueryOutput, fail.Fail].err{fail.refused(rb.err)};
    }
    val buf:  *u8  = rb.ok;
    val slot: *ptr = buf::ptr::*ptr;
    slot[0] = r::ptr;
    var out: query.QueryOutput;
    out.bytes = buf;
    out.len   = n;
    ret res[query.QueryOutput, fail.Fail].ok{out};
}

fun sema_handle_decode(e: query.QueryView) *sema_product.SemaResult {
    val slot: *ptr = codec.handle_bytes(e.value, e.value_len, $size_of(ptr))::ptr::*ptr;
    ret slot[0]::*sema_product.SemaResult;
}

# a growing cycle's expansion, shown under the phase readout as it runs; a run with no readout
# shows none
fun growth_expanded(raw: ptr, module: intern.StrId, members: intern.StrId, instances: u32) {
    val p: *project.Project = raw::*project.Project;
    if (p.progress == nil) { ret; }
    readout.growth(p.progress.sink, intern.text(?p.s.interner, module), intern.text(?p.s.interner, members), instances);
}

fun build_sema_deps_query(p: *project.Project, m: *project.ModuleEntry) res[sema_product.SemaDeps, fail.Fail] {
    var deps: sema_product.SemaDeps = sema_product.SemaDeps{};
    deps.definitions = sema_product.reader_init(p::ptr, read_definition, p.s.alloc);
    val closure: res[LowerClosure, fail.Fail] = collect_lower_closure(p, m);
    if (sel closure.err) { ret res[sema_product.SemaDeps, fail.Fail].err{closure.err}; }
    var imports: LowerClosure = closure.ok;
    fin { free_lower_closure(p.s.alloc, ?imports); }
    if (imports.count == 0) { ret res[sema_product.SemaDeps, fail.Fail].ok{deps}; }
    val allocated: res[**sema_product.ModuleSema, A.Error] = A.allocate[*sema_product.ModuleSema](p.s.alloc, imports.count::usize);
    if (sel allocated.err) { ret res[sema_product.SemaDeps, fail.Fail].err{fail.refused(allocated.err)}; }
    deps.entries = allocated.ok;
    deps.count   = imports.count;
    var i: u32 = 0;
    for (i < imports.count) {
        val shared: res[*sema_product.ModuleSema, fail.Fail] = typed_surface_of(p, imports.list[i]);
        if (sel shared.err) {
            free_sema_deps_query(p.s.alloc, ?deps);
            ret res[sema_product.SemaDeps, fail.Fail].err{shared.err};
        }
        deps.entries[i] = shared.ok;
        i               = i + 1;
    }
    ret res[sema_product.SemaDeps, fail.Fail].ok{deps};
}

# the surfaces are the project's, so only the borrowing array is released
fun free_sema_deps_query(alloc: *A.Allocator, deps: *sema_product.SemaDeps) {
    sema_product.reader_dnit(?deps.definitions);
    if (deps.entries != nil) { A.deallocate[*sema_product.ModuleSema](alloc, deps.entries, deps.count::usize); }
    deps.entries = nil;
    deps.count   = 0;
}

# a module's typed surface, shared by every importer, its field graph installed in the projection
# on each read
fun typed_surface_of(p: *project.Project, mid: module.ModuleId) res[*sema_product.ModuleSema, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret res[*sema_product.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val m:        *project.ModuleEntry            = project.module_at(p, mid::u32);
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p, ?TYPED_EXPORTS, module.stable_index(m.stable_id)::u64);
    if (sel acquired.err) { ret res[*sema_product.ModuleSema, fail.Fail].err{acquired.err}; }
    val surface:   *sema_product.ModuleSema = surface_handle_decode(acquired.ok);
    val installed: err[fail.Fail]           = sema_fields.install(p.s, ?surface.graph);
    if (sel installed.err) { ret res[*sema_product.ModuleSema, fail.Fail].err{installed.err}; }
    ret res[*sema_product.ModuleSema, fail.Fail].ok{surface};
}

fun surface_handle_decode(e: query.QueryView) *sema_product.ModuleSema {
    ret (codec.handle_bytes(e.value, e.value_len, $size_of(ptr))::ptr::*ptr)[0]::*sema_product.ModuleSema;
}

fun surface_release(surface: *sema_product.ModuleSema, alloc: *A.Allocator) {
    sema_product.module_sema_dnit(surface);
    A.deallocate[sema_product.ModuleSema](alloc, surface, 1::usize);
}

fun surface_finalize(value: *u8, value_len: u32, alloc: *A.Allocator) {
    surface_release(surface_handle_decode(query.QueryView{value: value, value_len: value_len}), alloc);
}

# two typed surfaces are the same when they export the same rows and reach the same field recipes;
# the index a reader builds and where the graph was installed are not part of either
fun surface_equal(left: *u8, left_len: u32, right: *u8, right_len: u32) bool {
    val l: *sema_product.ModuleSema = surface_handle_decode(query.QueryView{value: left, value_len: left_len});
    val r: *sema_product.ModuleSema = surface_handle_decode(query.QueryView{value: right, value_len: right_len});
    if (l.exports.len != r.exports.len || l.graph.nodes.len != r.graph.nodes.len) { ret false; }
    var i: usize = 0;
    for (i < l.exports.len) {
        val lr: *sema_product.TypeExport = ?l.exports.data[i];
        val rr: *sema_product.TypeExport = ?r.exports.data[i];
        if (lr.origin::u32 != rr.origin::u32 || lr.canon::u32 != rr.canon::u32 || lr.ty::u32 != rr.ty::u32) { ret false; }
        if (!constant_same(?lr.constant, ?rr.constant))                                                     { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < l.graph.nodes.len) {
        val ln: *sema_fields.Node = ?l.graph.nodes.data[i];
        val rn: *sema_fields.Node = ?r.graph.nodes.data[i];
        if (ln.ty::u32 != rn.ty::u32 || ln.disc::u32 != rn.disc::u32 || ln.entries.len != rn.entries.len) { ret false; }
        if (ln.decoration.align != rn.decoration.align || ln.decoration.packed != rn.decoration.packed
            || ln.decoration.volatile_ != rn.decoration.volatile_) { ret false; }
        var j: usize = 0;
        for (j < ln.entries.len) {
            val le: *type_field.Entry = ?ln.entries.data[j];
            val re: *type_field.Entry = ?rn.entries.data[j];
            if (le.name::u32 != re.name::u32 || le.ty::u32 != re.ty::u32 || !deprecation_same(le.deprecation, re.deprecation)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# a module's typed surface copied for a reader that owns it, under the id this build numbers the
# module with, its field graph installed in the projection
fun read_typed_surface(p: *project.Project, mid: module.ModuleId, a: *A.Allocator) res[sema_product.ModuleSema, fail.Fail] {
    if (module.is_nil(mid) || mid::u32 >= project.module_count(p)) { ret res[sema_product.ModuleSema, fail.Fail].err{fail.message("typed surface module is not loaded")}; }
    val acquired: res[query.QueryView, fail.Fail] = query.get[project.Project](?p.queries, p,
        ?TYPED_EXPORTS, module.stable_index(project.module_at(p, mid::u32).stable_id)::u64);
    if (sel acquired.err) { ret res[sema_product.ModuleSema, fail.Fail].err{acquired.err}; }
    var owned:  sema_product.ModuleSema = sema_product.module_sema_init(a, project.module_at(p, mid::u32).fqn, mid);
    val copied: err[fail.Fail]          = surface_copy(surface_handle_decode(acquired.ok), ?owned);
    if (sel copied.err) {
        sema_product.module_sema_dnit(?owned);
        ret res[sema_product.ModuleSema, fail.Fail].err{copied.err};
    }
    val installed: err[fail.Fail] = sema_fields.install(p.s, ?owned.graph);
    if (sel installed.err) {
        sema_product.module_sema_dnit(?owned);
        ret res[sema_product.ModuleSema, fail.Fail].err{installed.err};
    }
    ret res[sema_product.ModuleSema, fail.Fail].ok{owned};
}

# the rows and field recipes of `from` appended to `into`, from `into`'s allocator
fun surface_copy(from: *sema_product.ModuleSema, into: *sema_product.ModuleSema) err[fail.Fail] {
    val rows: res[usize, A.Error] = collections_vector.reserve[sema_product.TypeExport](?into.exports, from.exports.len);
    if (sel rows.err) { ret err[fail.Fail].err{fail.refused(rows.err)}; }
    var i: usize = 0;
    for (i < from.exports.len) {
        collections_vector.push[sema_product.TypeExport](?into.exports, from.exports.data[i]);
        i = i + 1;
    }
    val nodes: res[usize, A.Error] = collections_vector.reserve[sema_fields.Node](?into.graph.nodes, from.graph.nodes.len);
    if (sel nodes.err) { ret err[fail.Fail].err{fail.refused(nodes.err)}; }
    i = 0;
    for (i < from.graph.nodes.len) {
        val source: *sema_fields.Node = ?from.graph.nodes.data[i];
        var node:   sema_fields.Node  = sema_fields.Node{
            ty: source.ty, entries: collections_vector.init[type_field.Entry](into.exports.a), decoration: source.decoration, disc: source.disc
        };
        val entries: res[usize, A.Error] = collections_vector.reserve[type_field.Entry](?node.entries, source.entries.len);
        if (sel entries.err) { ret err[fail.Fail].err{fail.refused(entries.err)}; }
        var j: usize = 0;
        for (j < source.entries.len) {
            collections_vector.push[type_field.Entry](?node.entries, source.entries.data[j]);
            j = j + 1;
        }
        collections_vector.push[sema_fields.Node](?into.graph.nodes, node);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# resolve reads the dep list, the gate states and the bound constants from the load walk, not through a
# query. they are one digest per module, its load view, an input every product that reads them depends
# on. a dependent folds a dep's stable id, not its view, so an edit inside the dep reaches the dependent
# only through the dep's products
fun bool_byte(b: bool) u8 {
    if (b) { ret 1; }
    ret 0;
}

fun parse_revision(p: *project.Project, m: *project.ModuleEntry) query.Revision {
    ret query.peek_revision(?p.s.queries, ?PARSE, lang_source.file_index(m.file_id)::u64);
}

fun fold_bound_const(p: *project.Project, m: *project.ModuleEntry, entry: *comptime_scope.NamedConst, fb: *wire.Sink) err[fail.Fail] {
    wire.put_u32(fb, entry.name::u32);
    wire.put_u8(fb, bool_byte(entry.gated));
    ret codec.ct_value_encode(fb, ?entry.value, m.stable_id, parse_revision(p, m));
}

# a bound element may name an element of the exporter's definition, so its revision is folded then
fun fold_const_import(p: *project.Project, exporter: *project.ModuleEntry, elements: bool, fb: *wire.Sink) {
    wire.put_u32(fb, exporter.stable_id::u32);
    if (elements) { wire.put_u64(fb, parse_revision(p, exporter)); }
}

# everything resolve reads from the load walk rather than through a query
fun fold_load_view(p: *project.Project, m: *project.ModuleEntry, fb: *wire.Sink) err[fail.Fail] {
    # the artifact the walk attributed the module to is what its gates and bodies read as
    # `$bin.name`, so a module another artifact reaches first is typed again
    lang_fingerprint.put_name(fb, ?p.s.interner, m.load.artifact);
    wire.put_u32(fb, project.dep_count(m));
    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        wire.put_u32(fb, module.stable_index(m.load.deps.data[i::usize]));
        i = i + 1;
    }
    val made: *comptime_scope.Bindings = ?m.load.ctx.own;
    wire.put_u32(fb, made.gate_count);
    i = 0;
    for (i < made.gate_count) {
        wire.put_u8(fb, made.gate_states[i]::u8);
        i = i + 1;
    }
    var elements: bool = false;
    wire.put_u32(fb, made.entries_len);
    i = 0;
    for (i < made.entries_len) {
        if (made.entries[i].value.kind == comptime_value.CT_KIND_CONST_ELEM) { elements = true; }
        val bound: err[fail.Fail] = fold_bound_const(p, m, ?made.entries[i], fb);
        if (sel bound.err) { ret bound; }
        i = i + 1;
    }
    wire.put_u32(fb, made.deferred_len);
    i = 0;
    for (i < made.deferred_len) {
        wire.put_u32(fb, made.deferred[i]::u32);
        i = i + 1;
    }
    wire.put_u32(fb, m.load.bindings.len::u32);
    i = 0;
    for (i::usize < m.load.bindings.len) {
        val b: *fe_load.Binding = ?m.load.bindings.data[i::usize];
        wire.put_u32(fb, ast_id.decl_index(b.decl));
        wire.put_u8(fb, b.kind::u8);
        wire.put_u32(fb, intern.str_index(b.name));
        if (b.constant) { fold_const_import(p, project.module_at(p, fe_load.module_of(?p.loader, b.module)::u32), elements, fb); }
        or              { wire.put_u32(fb, module.stable_index(b.module)); }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# set each module's load view from what the walk left it; an unchanged view is no change
pub fun record_load_views(p: *project.Project) err[fail.Fail] {
    var digest: [32]u8;
    var i:      u32 = 0;
    for (i < p.topo_len) {
        val m:      *project.ModuleEntry = project.module_at(p, p.topo[i]::u32);
        var fb:     wire.Sink            = wire.digest();
        val folded: err[fail.Fail]       = fold_load_view(p, m, ?fb);
        if (sel folded.err) { ret folded; }
        val failed: opt[fail.Fail] = wire.failure(?fb);
        if (sel failed.some) { ret err[fail.Fail].err{failed.some}; }
        wire.digest_final(?fb, ?digest);
        val stored: err[fail.Fail] = query.set_input(?p.s.queries, ?LOAD_VIEW, module.stable_index(m.stable_id)::u64, ?digest[0], 32);
        if (sel stored.err) { ret stored; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a product that reads the load walk's state depends on the module's view, so a view change reaches it
fun depend_load_view(p: *project.Project, m: *project.ModuleEntry) err[fail.Fail] {
    ret query.depend[project.Project](?p.queries, p, ?LOAD_VIEW, module.stable_index(m.stable_id)::u64);
}

fun typed_exports_compute(raw: ptr, kind: *query.Kind, key: u64, alloc: *A.Allocator, diags: *diagnostic.DiagnosticStore) res[query.QueryOutput, fail.Fail] {
    val p: *project.Project = raw::*project.Project;
    val s: *session.Session = p.s;

    val stable: module.StableModuleId = key::u32::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(mid)) { ret res[query.QueryOutput, fail.Fail].err{fail.message("typed exports: the stable id is not loaded this build")}; }
    val m:        *project.ModuleEntry                     = project.module_at(p, mid::u32);
    val acquired: res[*sema_product.SemaResult, fail.Fail] = acquire_sema(p, mid);
    if (sel acquired.err) { ret res[query.QueryOutput, fail.Fail].err{acquired.err}; }
    val sr:     *sema_product.SemaResult = acquired.ok;
    val viewed: err[fail.Fail]           = depend_load_view(p, m);
    if (sel viewed.err) { ret res[query.QueryOutput, fail.Fail].err{viewed.err}; }
    val resolved: res[*resolve.ResolveResult, fail.Fail] = resolution(p, m);
    if (sel resolved.err) { ret res[query.QueryOutput, fail.Fail].err{resolved.err}; }
    val rr: *resolve.ResolveResult = resolved.ok;
    if (!sel rr.status.kind.accepted) { ret res[query.QueryOutput, fail.Fail].err{lang_phase.phase_failure(rr.status)}; }
    if (!sel sr.status.kind.accepted) { ret res[query.QueryOutput, fail.Fail].err{lang_phase.phase_failure(sr.status)}; }

    var owner:    sema_surface.Owner                      = surface_owner(p, mid);
    var origins:  sema_surface.Origins                    = sema_surface.Origins{ctx: p::ptr, read: origin_read};
    val captured: res[sema_product.ModuleSema, fail.Fail] = sema_surface.exports(s, ?owner, rr, sr, ?origins, alloc);
    if (sel captured.err) { ret res[query.QueryOutput, fail.Fail].err{captured.err}; }
    var surface: sema_product.ModuleSema = captured.ok;
    var handed:  bool                    = false;
    fin {
        if (!handed) { sema_product.module_sema_dnit(?surface); }
    }
    var j: usize = 0;
    for (j < surface.exports.len) {
        val refused: opt[str] = constant_refusal(?surface.exports.data[j].constant, 0);
        if (sel refused.some) { ret res[query.QueryOutput, fail.Fail].err{fail.message(refused.some)}; }
        j = j + 1;
    }
    val graph: res[sema_fields.Graph, fail.Fail] = sema_surface.graph(s, ?owner, ?surface);
    if (sel graph.err) { ret res[query.QueryOutput, fail.Fail].err{graph.err}; }
    surface.graph = graph.ok;
    # a shared surface outlives the build that numbered the modules, so it names its module by path alone
    surface.module = module.MODULE_NIL;
    val boxed: res[*sema_product.ModuleSema, A.Error] = A.allocate[sema_product.ModuleSema](alloc, 1::usize);
    if (sel boxed.err) { ret res[query.QueryOutput, fail.Fail].err{fail.refused(boxed.err)}; }
    boxed.ok[0] = surface;
    handed      = true;
    val out: res[query.QueryOutput, fail.Fail] = pointer_output(alloc, boxed.ok::ptr);
    if (sel out.err) { surface_release(boxed.ok, alloc); }
    ret out;
}

fun lower_visit_reserve(p: *project.Project, needed: u32) err[fail.Fail] {
    val old:   u32          = p.lower_visit_cap;
    val grown: err[A.Error] = growth.reserve[u32](p.s.alloc, ?p.lower_visit_gen, ?p.lower_visit_cap, needed::usize);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    var i: u32 = old;
    for (i < p.lower_visit_cap) {
        p.lower_visit_gen[i] = 0;
        i                    = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun collect_lower_closure(p: *project.Project, m: *project.ModuleEntry) res[LowerClosure, fail.Fail] {
    var cl: LowerClosure;
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
    if (project.dep_count(m) == 0 || project.module_count(p) == 0) { ret res[LowerClosure, fail.Fail].ok{cl}; }

    val cr: err[fail.Fail] = lower_visit_reserve(p, project.module_count(p));
    if (sel cr.err) { ret res[LowerClosure, fail.Fail].err{cr.err}; }
    p.lower_visit_epoch = p.lower_visit_epoch + 1;
    val epoch: u32  = p.lower_visit_epoch;
    val gen:   *u32 = p.lower_visit_gen;

    val lr: res[*module.ModuleId, A.Error] = A.allocate[module.ModuleId](p.s.alloc, project.module_count(p)::usize);
    if (sel lr.err) { ret res[LowerClosure, fail.Fail].err{fail.refused(lr.err)}; }
    val list:     *module.ModuleId = lr.ok;
    var list_len: u32              = 0;

    var i: u32 = 0;
    for (i < project.dep_count(m)) {
        val d: module.ModuleId = project.dep_at(p, m, i);
        if (d::u32 < project.module_count(p) && gen[d::u32] != epoch) {
            gen[d::u32]    = epoch;
            list[list_len] = d;
            list_len       = list_len + 1;
        }
        i = i + 1;
    }

    var head: u32 = 0;
    for (head < list_len) {
        val cur: module.ModuleId      = list[head];
        val cm:  *project.ModuleEntry = project.module_at(p, cur::u32);
        var j:   u32                  = 0;
        for (j < project.dep_count(cm)) {
            val d: module.ModuleId = project.dep_at(p, cm, j);
            if (d::u32 < project.module_count(p) && gen[d::u32] != epoch) {
                gen[d::u32]    = epoch;
                list[list_len] = d;
                list_len       = list_len + 1;
            }
            j = j + 1;
        }
        head = head + 1;
    }

    cl.list  = list;
    cl.count = list_len;
    cl.cap   = project.module_count(p);
    ret res[LowerClosure, fail.Fail].ok{cl};
}

# release a lowering closure; an empty one owns no list
fun free_lower_closure(alloc: *A.Allocator, cl: *LowerClosure) {
    if (cl.list == nil || cl.cap == 0) { ret; }
    A.deallocate[module.ModuleId](alloc, cl.list, cl.cap::usize);
    cl.list  = nil;
    cl.count = 0;
    cl.cap   = 0;
}

# the module whose typed surface the project builds, as the front end names it
fun surface_owner(p: *project.Project, mid: module.ModuleId) sema_surface.Owner {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    ret sema_surface.Owner{module: mid, stable: m.stable_id, path: m.fqn, ctx: ?m.load.ctx};
}

fun origin_read(raw: ptr, mid: module.ModuleId, a: *A.Allocator) res[sema_product.ModuleSema, fail.Fail] {
    ret read_typed_surface(raw::*project.Project, mid, a);
}

# open a query operation over the project: the build context must be as it was frozen, and the
# type projections the last operation installed are reset
pub fun begin_query_phase(p: *project.Project) res[query.Operation, fail.Fail] {
    val unchanged: err[fail.Fail] = context.unchanged(p);
    if (sel unchanged.err) { ret res[query.Operation, fail.Fail].err{unchanged.err}; }
    val reset: err[fail.Fail] = session.reset_type_projection(p.s);
    if (sel reset.err) {
        ret res[query.Operation, fail.Fail].err{reset.err};
    }
    val begun: res[query.Operation, fail.Fail] = query.begin(?p.s.queries);
    if (sel begun.err) {
        ret res[query.Operation, fail.Fail].err{begun.err};
    }
    project.release_fresh_staged(p);
    ret res[query.Operation, fail.Fail].ok{begun.ok};
}

# the session's store is rebuilt from the project's and the query presentation's,
# dropping the warnings a declaration's `#[expect]` acknowledges and the ones the
# profile's `allow` silences, then reporting each judged expectation nothing
# fulfilled. a warning replayed from the cache passes through here as a fresh one does
pub fun refresh_diagnostics(p: *project.Project) err[fail.Fail] {
    var staged: diagnostic.DiagnosticStore = diagnostic.store_init(p.s.alloc);
    var handed: bool                       = false;
    fin {
        if (!handed) { diagnostic.store_dnit(?staged); }
    }
    diagnostic.silence(?staged, p.req.allow);
    var expects:  collections_vector.Vector[diagnostic.Expectation] = collections_vector.init[diagnostic.Expectation](p.s.alloc);
    val gathered: err[fail.Fail]                                    = gather_expectations(p, ?expects);
    val indexed:  err[fail.Fail]                                    = diagnostic.expect(?staged, expects);
    if (sel gathered.err) { ret err[fail.Fail].err{gathered.err}; }
    if (sel indexed.err)  { ret err[fail.Fail].err{indexed.err}; }
    var copied:    err[fail.Fail] = diagnostic.replay_into(?staged, ?p.diags);
    val copied_ok: bool           = sel copied.ok && p.s.queries.presentation != nil;
    if (copied_ok) {
        copied = diagnostic.replay_into(?staged, ?p.s.queries.presentation.diags);
    }
    if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
    diagnostic.report_unfulfilled(?staged);
    diagnostic.set_origin(?staged, p.s.diags.origin);
    diagnostic.store_dnit(?p.s.diags);
    p.s.diags = staged;
    handed    = true;
    ret err[fail.Fail].ok{};
}

# every loaded module's `#[expect]` keys. a module's are judged once its
# warnings are all in: it was type checked this build, or its front end was
# skipped and its recorded warnings replayed. where each module's keys stand is
# read once per parse of it, so a refresh walks no module's declarations
fun gather_expectations(p: *project.Project, out: *collections_vector.Vector[diagnostic.Expectation]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < project.module_count(p)) {
        val m: *project.ModuleEntry = project.module_at(p, i);
        i = i + 1;
        if (m.released) {
            val held: err[fail.Fail] = expectations_append(out, ?m.held_expects);
            if (sel held.err) { ret held; }
            cnt;
        }
        val a: *ast.Ast = syntax(p, m);
        if (a == nil) { cnt; }
        val indexed: err[fail.Fail] = expect.index(p.s, a, ?m.expects);
        if (sel indexed.err)                    { ret indexed; }
        if (expect.site_count(?m.expects) == 0) { cnt; }
        val checked:   bool                       = typed(p, m) != nil || m.frontend_skipped;
        var scope:     comptime_scope.ComptimeCtx = typed_scope(p, m);
        val collected: err[fail.Fail]             = expect.collect(p.s, a, ?m.expects, ?scope, checked, out);
        comptime_scope.dnit(?scope);
        if (sel collected.err) { ret collected; }
    }
    ret err[fail.Fail].ok{};
}

fun expectations_append(out: *collections_vector.Vector[diagnostic.Expectation], from: *collections_vector.Vector[diagnostic.Expectation]) err[fail.Fail] {
    var i: usize = 0;
    for (i < from.len) {
        val pushed: res[usize, A.Error] = collections_vector.push[diagnostic.Expectation](out, from.data[i]);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# give back a lowered module's front-end products, which nothing the build runs after its
# lowering reads: its syntax tree, its resolution, its lowering scope and what its typing holds
# beyond the interface its importers' lowerings read. its expectations are collected first and
# held, so a later refresh judges them as it would have. called inside the operation that
# lowered it, once its own products and every reader of them are done
pub fun release_lowered(p: *project.Project, mid: module.ModuleId) err[fail.Fail] {
    val m: *project.ModuleEntry = project.module_at(p, mid::u32);
    if (m.released || m.frontend_skipped || lang_source.file_is_nil(m.file_id)) { ret err[fail.Fail].ok{}; }
    var held: collections_vector.Vector[diagnostic.Expectation] = collections_vector.init[diagnostic.Expectation](p.s.alloc);
    var kept: bool                                              = false;
    fin {
        if (!kept) { collections_vector.dnit[diagnostic.Expectation](?held); }
    }
    val parsed_r: res[ParsedModule, fail.Fail] = parse(p, m);
    if (sel parsed_r.err) { ret err[fail.Fail].err{parsed_r.err}; }
    val a:       *ast.Ast       = parsed_r.ok.a;
    val indexed: err[fail.Fail] = expect.index(p.s, a, ?m.expects);
    if (sel indexed.err) { ret indexed; }
    val rr_r: res[*resolve.ResolveResult, fail.Fail] = resolution(p, m);
    if (sel rr_r.err) { ret err[fail.Fail].err{rr_r.err}; }
    val sema_r: res[*sema_product.SemaResult, fail.Fail] = acquire_sema(p, mid);
    if (sel sema_r.err) { ret err[fail.Fail].err{sema_r.err}; }
    if (expect.site_count(?m.expects) != 0) {
        var scope:     comptime_scope.ComptimeCtx = typed_scope_of(m, rr_r.ok, sema_r.ok);
        val collected: err[fail.Fail]             = expect.collect(p.s, a, ?m.expects, ?scope, true, ?held);
        comptime_scope.dnit(?scope);
        if (sel collected.err) { ret collected; }
    }
    project.lower_scope_drop(m);
    sema_product.result_shed(sema_r.ok);
    val stable:  u64            = module.stable_index(m.stable_id)::u64;
    val resolve: err[fail.Fail] = query.release_value(?p.s.queries, ?RESOLVE, stable);
    if (sel resolve.err) { ret resolve; }
    val syntax_r: err[fail.Fail] = query.release_value(?p.s.queries, ?PARSE, lang_source.file_index(m.file_id)::u64);
    if (sel syntax_r.err) { ret syntax_r; }
    m.held_expects = held;
    m.released     = true;
    kept           = true;
    ret err[fail.Fail].ok{};
}

# close a query operation over the project and show it: end it, hold its failure where the
# session presents it, collect the diagnostics of every product the roots reach into the
# session's presentation and refresh the session's store from it
# ---
# p:         the project
# operation: the operation begin_query_phase opened
# roots:     the products whose diagnostics the phase presents
# count:     how many roots
# result:    the phase's own result; an operation failure that is a message displaces it; given
#            back unless it is ok and the refresh fails
pub fun finish_query_phase(p: *project.Project, operation: query.Operation,
    roots: *query.QueryKey, count: usize,
    result: err[fail.Fail]) err[fail.Fail] {
    val db:    *query.QueryDb = ?p.s.queries;
    val ended: err[fail.Fail] = query.end(db, operation);
    if (!db.operation_active) { project.release_fresh_staged(p); }
    var final_result:      err[fail.Fail] = result;
    var operation_failure: bool           = false;
    var lost:              bool           = false;
    if (sel ended.err) {
        val failure:   fail.Fail = ended.err;
        var displaces: bool      = sel result.ok;
        if (sel result.err) {
            if (sel failure.message && !fail.is_message(result.err)) { displaces = true; }
        }
        if (displaces) {
            final_result      = err[fail.Fail].err{failure};
            operation_failure = true;
        }
    }
    # the phase's own failure is held before the collect below releases what its text may read
    if (!operation_failure) {
        if (sel result.err) { final_result = err[fail.Fail].err{query.hold_failure(?p.s.queries, result.err, ?lost)}; }
        or                  { query.drop_failure(?p.s.queries); }
    }
    val collected: res[*query.Presentation, fail.Fail] = query.collect(db, operation, roots, count, p.s.alloc);
    if (sel collected.err) {
        # the operation's own text goes to the session's slot, since no presentation holds it
        val taken: res[str, fail.Fail] = query.take_failure_message(db, operation);
        if (operation_failure) { query.drop_failure(?p.s.queries); }
        if (sel taken.ok) {
            if (taken.ok != nil) {
                if (operation_failure) { query.adopt_failure_text(?p.s.queries, taken.ok); }
                or                     { str_free(db.a, taken.ok); }
            }
        }
        if (sel taken.err) { lost = true; }
        val discarded: err[fail.Fail] = query.discard(db, operation);
        if (sel discarded.err) { lost = true; }
        val no_result: bool = sel final_result.ok;
        if (no_result) { final_result = err[fail.Fail].err{collected.err}; }
        lost = true;
    }
    if (sel collected.ok) {
        val presentation: *query.Presentation = collected.ok;
        if (p.s.queries.presentation != nil) { query.presentation_dnit(p.s.queries.presentation); }
        p.s.queries.presentation = presentation;
        if (operation_failure) { query.drop_failure(?p.s.queries); }
    }
    if (lost) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
    }
    if (sel collected.err) { ret final_result; }
    val refreshed: err[fail.Fail] = refresh_diagnostics(p);
    if (sel refreshed.err) {
        diagnostic.note_lost(?p.diags);
        diagnostic.note_lost(?p.s.diags);
        val result_ok: bool = sel final_result.ok;
        if (result_ok) { ret refreshed; }
    }
    ret final_result;
}

# what the front end bound over a module, to read: the load's bindings, and resolve's and sema's
# where this project's operations ran them
fun typed_scope(p: *project.Project, m: *project.ModuleEntry) comptime_scope.ComptimeCtx {
    ret typed_scope_of(m, resolved(p, m), typed(p, m));
}

fun typed_scope_of(m: *project.ModuleEntry, rr: *resolve.ResolveResult, sr: *sema_product.SemaResult) comptime_scope.ComptimeCtx {
    var scope: comptime_scope.ComptimeCtx = comptime_scope.stage_init(?m.load.ctx, comptime_scope.STAGE_LOWER, m.load.ctx.own.alloc);
    if (rr != nil) { comptime_scope.layer_set(?scope, comptime_scope.STAGE_RESOLVE, ?rr.constants); }
    if (sr != nil) { comptime_scope.layer_set(?scope, comptime_scope.STAGE_SEMA, ?sr.constants); }
    ret scope;
}
