use mach.lang.fail;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_mir:    mach.lang.mir;
use mir_structure: mach.lang.mir.structure;
use mach.lang.intern;
use me_ir: mach.lang.me.ir;

pub rec UnitModule {
    ir:  *me_ir.Module;
    mir: *lang_mir.MirModule;
    # the control-flow structure of each MIR function, in function order, on a
    # target that declares structured_control_flow, nil on any other
    shapes: *mir_structure.Structure;
}

pub val UNIT_NONE: u32 = 0xFFFFFFFF;

pub rec Unit {
    mods: *UnitModule;
    len:  u32;
    root: u32;
}

pub rec IrSet {
    mods: **me_ir.Module;
    len:  u32;
}

pub fun ir_set_empty() IrSet {
    var s: IrSet;
    s.mods = nil;
    s.len  = 0;
    ret s;
}

pub fun root_ir(u: *Unit) *me_ir.Module {
    ret u.mods[u.root].ir;
}

pub fun root_mir(u: *Unit) *lang_mir.MirModule {
    ret u.mods[u.root].mir;
}

pub fun defined_index(m: *me_ir.Module, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *me_ir.Function = ?m.functions[i];
        if (intern.str_same(fn.name, name) && (fn.flags & me_ir.FN_FLAG_EXTERN) == 0) { ret i; }
        i = i + 1;
    }
    ret UNIT_NONE;
}

pub fun defined_global_index(m: *me_ir.Module, name: intern.StrId) u32 {
    var i: u32 = 0;
    for (i < m.global_len) {
        val g: *me_ir.Global = ?m.globals[i];
        if (intern.str_same(g.name, name) && !g.is_extern) { ret i; }
        i = i + 1;
    }
    ret UNIT_NONE;
}

pub fun mir_index(u: *Unit, mi: u32, name: intern.StrId) u32 {
    val mm: *lang_mir.MirModule = u.mods[mi].mir;
    if (mm == nil) { ret UNIT_NONE; }
    var i: u32 = 0;
    for (i < mm.function_len) {
        if (intern.str_same(mm.functions[i].name, name)) { ret i; }
        i = i + 1;
    }
    ret UNIT_NONE;
}

pub fun init(a: *A.Allocator, n: u32, u: *Unit) err[fail.Fail] {
    u.mods = nil;
    u.len  = 0;
    u.root = 0;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val r: res[*UnitModule, A.Error] = A.allocate[UnitModule](a, n::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    u.mods = r.ok;
    u.len  = n;
    var i: u32 = 0;
    for (i < n) {
        u.mods[i].ir     = nil;
        u.mods[i].mir    = nil;
        u.mods[i].shapes = nil;
        i                = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun dnit(a: *A.Allocator, u: *Unit) {
    if (u.mods != nil && u.len > 0) { A.deallocate[UnitModule](a, u.mods, u.len::usize); }
    u.mods = nil;
    u.len  = 0;
}
