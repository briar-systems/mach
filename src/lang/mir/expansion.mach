use mach.lang.fail;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use lang_mir: mach.lang.mir;

# the state one expansion writes through: pieces replace `source` in `dst` from
# `cursor`, and no more than `limit` of them may be written
pub rec ExpansionBuilder {
    allocator: *A.Allocator;
    function:  *lang_mir.MirFunction;
    source:    *lang_mir.MirInstr;
    dst:       *lang_mir.MirInstr;
    cursor:    u32;
    emitted:   u32;
    limit:     u32;
}

# writes one piece with its own copy of the operands. the piece takes the
# source's location, inline site, secrecy and memory flags
pub fun emit(builder: *ExpansionBuilder, opcode: lang_mir.MirOpcode, operands: *lang_mir.MirOperand, operand_count: u32,
    width: u8, src_width: u8) res[*lang_mir.MirInstr, fail.Fail] {
    if (builder.emitted >= builder.limit) {
        ret res[*lang_mir.MirInstr, fail.Fail].err{fail.message("expansion emitted more pieces than its declared length")};
    }

    var ops: *lang_mir.MirOperand = nil;
    if (operand_count > 0) {
        val res_ops: res[*lang_mir.MirOperand, A.Error] = A.allocate[lang_mir.MirOperand](builder.allocator, operand_count::usize);
        if (sel res_ops.err) {
            ret res[*lang_mir.MirInstr, fail.Fail].err{fail.refused(res_ops.err)};
        }
        ops = res_ops.ok;
        var i: u32 = 0;
        for (i < operand_count) {
            ops[i] = operands[i];
            i      = i + 1;
        }
    }

    val source: *lang_mir.MirInstr = builder.source;
    builder.dst[builder.cursor] = lang_mir.instr(opcode, ops, operand_count, width, src_width);
    val piece: *lang_mir.MirInstr = ?builder.dst[builder.cursor];
    piece.loc           = source.loc;
    piece.inline_site   = source.inline_site;
    piece.writes_secret = source.writes_secret;
    piece.memory_flags  = source.memory_flags;

    builder.cursor  = builder.cursor + 1;
    builder.emitted = builder.emitted + 1;
    ret res[*lang_mir.MirInstr, fail.Fail].ok{piece};
}
