# the one selection model: the selection a command's `-a`, `-t` and `-p` options
# and `--all` describe, resolved against a manifest into the (artifact, target,
# profile) cells it covers, which the build plan takes. each axis takes exact
# names and globs (`*` any run, `?` any one byte); an axis given no pattern is
# `*` under `--all` and otherwise the manifest's default, which the
# `ArtifactDefault` modes, `resolve_target` and `resolve_profile` decide. no cell
# is chosen by table order
use lang_alloc: mach.lang.alloc;
use mach.lang.fail;
use std.allocator.arena;
use std.allocator.page;
use T:                  std.allocator.testing;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use lang_target:      mach.lang.target;
use catalog_artifact: mach.lang.target.catalog.artifact;

use mach.lang.manifest.artifact.artifact_supports_target;
use mach.lang.manifest.model.ArtifactDef;
use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.NameList;
use mach.lang.manifest.model.ProfileDef;
use mach.lang.manifest.model.SimdMode;
use mach.lang.manifest.model.TargetDef;
use mach.lang.manifest.need.glob_matches;
use mach.lang.manifest.need.is_glob;
use mach.lang.manifest.refusal.Sites;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.sfmt;
use mach.lang.manifest.refusal.sites_add;
use mach.lang.manifest.refusal.sites_fail;
use mach.lang.manifest.refusal.sites_init;
use mach.lang.manifest.target.find_target_by_name;
use mach.lang.manifest.target.host_tuple;
use mach.lang.manifest.target.resolve_declared;
use mach.lang.manifest.target.target_is_hosted;
use mach.lang.manifest.target.target_matches_host;
use mach.lang.manifest.target.tuple_of;

# how an artifact axis given no pattern is filled when `--all` does not fill it
pub def ArtifactDefault: u8;
# every artifact the default selection holds for the target: build and check
pub val ARTIFACT_DEFAULT_SET: ArtifactDefault = 0;
# the one artifact the default selection holds, refused when it holds several: test and doc
pub val ARTIFACT_DEFAULT_ONE: ArtifactDefault = 1;
# the one `bin` the default selection holds, else the sole declared artifact: run
pub val ARTIFACT_DEFAULT_EXECUTABLE: ArtifactDefault = 2;

# every `bin` the default selection holds is a candidate, and a library never is
fun executables_only(mode: ArtifactDefault) bool {
    ret mode == ARTIFACT_DEFAULT_EXECUTABLE;
}

# the selector axes as a command gave them
# ---
# artifacts: `-a` patterns in the order given
# targets:   `-t` patterns in the order given
# profiles:  `-p` patterns in the order given
# all:       `--all`: every axis given no pattern is `*`
pub rec Selectors {
    artifacts: Vector[str];
    targets:   Vector[str];
    profiles:  Vector[str];
    all:       bool;
}

# one resolved cell of a selection
# ---
# artifact:    the declared artifact name
# target:      the target the cell is planned with: the declared name, or "" when
#              the target axis took the manifest's default, so planning resolves it
#              (and warns about a fallback) exactly as an unselected build does
# target_name: the declared target the cell resolves to
# profile:     the declared profile name
# native:      the target's `os` and `isa` are the host's, so its programs run here
pub rec Cell {
    artifact:    str;
    target:      str;
    target_name: str;
    profile:     str;
    native:      bool;
}

# a cell named outright, for a caller that already holds exact names: a
# dependency's requirement, or a cell carried from an earlier plan
# ---
# artifact: the declared artifact name
# target:   the declared target name, or "" for the artifact's default target
# profile:  the declared profile name, or "" for the default profile
pub fun cell_of(artifact: str, target: str, profile: str) Cell {
    ret Cell{artifact: artifact, target: target, target_name: target, profile: profile, native: false};
}

# the outcome of target resolution for a selection
# ---
# target: the chosen target; points into the manifest unless synthesized for a
#         manifest with no `[target.*]`, in which case it is allocated and never freed by `dnit`
# target borrows its manifest-owned declaration until manifest destruction
pub rec ResolvedTarget {
    target: *TargetDef;
}

# the profile a selection resolves to, copied out of its `ProfileDef`
# ---
# name:         the profile's name
# optimize:     as `ProfileDef`
# pass:         as `ProfileDef`, borrowed from the manifest
# skip:         as `ProfileDef`, borrowed from the manifest
# relax:        as `ProfileDef`, borrowed from the manifest
# linker_relax: as `ProfileDef`
# debug:        as `ProfileDef`
# simd:         as `ProfileDef`
# allow:        as `ProfileDef`
pub rec ResolvedProfile {
    name:         intern.StrId;
    optimize:     bool;
    pass:         NameList;
    skip:         NameList;
    relax:        NameList;
    linker_relax: bool;
    debug:        bool;
    simd:         SimdMode;
    allow:        diagnostic_kind.KindSet;
}

fun artifact_pinned_target(itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) *TargetDef {
    val host_os:   u32 = lang_target.host_os_id();
    val host_arch: u32 = lang_target.host_arch_id();

    var only:       *TargetDef = nil;
    var count:      u32        = 0;
    var host_first: *TargetDef = nil;
    var host_count: u32        = 0;
    var i:          u32        = 0;
    for (i < m.target_count) {
        if (artifact_supports_target(itn, a, m.targets[i].name)) {
            if (count == 0) { only = ?m.targets[i]; }
            count = count + 1;
            if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) {
                if (host_count == 0) { host_first = ?m.targets[i]; }
                host_count = host_count + 1;
            }
        }
        i = i + 1;
    }
    if (count == 1)      { ret only; }
    if (host_count == 1) { ret host_first; }
    ret nil;
}

# the target a selector names: a declared name, `native` for the declared
# target matching the host, or "" for the artifact's pinned target and
# otherwise `native`
pub fun resolve_target(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, selector: str,
    art: *ArtifactDef) res[ResolvedTarget, fail.Fail] {
    val host_os:   u32 = lang_target.host_os_id();
    val host_arch: u32 = lang_target.host_arch_id();

    if (str_empty(selector) && art != nil) {
        val pinned: *TargetDef = artifact_pinned_target(itn, m, art);
        if (pinned != nil) {
            # a sole hosted target the host cannot run is the fallback `native` refuses
            if (target_is_hosted(itn, pinned) && !target_matches_host(itn, pinned, host_os, host_arch)) {
                ret res[ResolvedTarget, fail.Fail].err{artifact_no_host_target(alloc, itn, art, pinned)};
            }
            ret res[ResolvedTarget, fail.Fail].ok{ResolvedTarget{target: pinned}};
        }
    }

    if (!str_empty(selector) && !str_equals(selector, "native")) {
        val d: *TargetDef = find_target_by_name(itn, m, selector);
        if (d == nil) { ret res[ResolvedTarget, fail.Fail].err{refuse(alloc, diagnostic_kind.SELECTION_UNKNOWN, "mach.toml: no target named '{}'", selector)}; }
        ret res[ResolvedTarget, fail.Fail].ok{ResolvedTarget{target: d}};
    }

    var first_match: *TargetDef = nil;
    var match_count: u32        = 0;
    var i:           u32        = 0;
    for (i < m.target_count) {
        if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) {
            if (first_match == nil) { first_match = ?m.targets[i]; }
            match_count = match_count + 1;
        }
        i = i + 1;
    }

    if (match_count > 1) {
        var names: str = "";
        i = 0;
        for (i < m.target_count) {
            if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) {
                var sep: str = "";
                if (!str_empty(names)) { sep = ", "; }
                val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}{}", names, sep, intern.text(itn, m.targets[i].name));
                if (sel longer.err) { ret res[ResolvedTarget, fail.Fail].err{longer.err}; }
                names = longer.ok;
            }
            i = i + 1;
        }
        var matching: Sites = sites_init(alloc);
        i = 0;
        for (i < m.target_count) {
            if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) { sites_add(?matching, m.targets[i].at); }
            i = i + 1;
        }
        ret res[ResolvedTarget, fail.Fail].err{sites_fail(alloc, ?matching,
            refuse(alloc, diagnostic_kind.SELECTION_AMBIGUOUS, "mach.toml: 'native' matches multiple targets for the host ({})", names))};
    }
    if (match_count == 1) { ret res[ResolvedTarget, fail.Fail].ok{ResolvedTarget{target: first_match}}; }
    if (m.target_count == 0) {
        if (m.native_target == nil) { ret res[ResolvedTarget, fail.Fail].err{fail.message("internal: manifest has no native target owner")}; }
        ret res[ResolvedTarget, fail.Fail].ok{ResolvedTarget{target: m.native_target}};
    }
    var declared: Sites = sites_init(alloc);
    i = 0;
    for (i < m.target_count) {
        sites_add(?declared, m.targets[i].at);
        i = i + 1;
    }
    ret res[ResolvedTarget, fail.Fail].err{sites_fail(alloc, ?declared, no_host_target(alloc, itn, m))};
}

# the refusal of an artifact whose only target is a hosted one the host cannot run,
# located at the artifact
fun artifact_no_host_target(alloc: *A.Allocator, itn: *intern.Interner, art: *ArtifactDef, only: *TargetDef) fail.Fail {
    val host: res[str, fail.Fail] = host_tuple(alloc);
    if (sel host.err) { ret host.err; }
    val tuple: res[str, fail.Fail] = tuple_of(alloc, intern.text(itn, only.sys), intern.text(itn, only.arch));
    if (sel tuple.err) { ret tuple.err; }
    var at: Sites = sites_init(alloc);
    sites_add(?at, art.at);
    ret sites_fail(alloc, ?at, refuse(alloc, diagnostic_kind.SELECTION_NO_HOST_TARGET,
        "mach.toml: artifact '{}' matches no declared target for the host: the host is {} and its only target is {} ({}); declare a [target.<name>] for the host in its targets or select one with -t",
        intern.text(itn, art.name), host.ok, intern.text(itn, only.name), tuple.ok));
}

# the refusal of `native` when no declared target matches the host: the host tuple,
# every declared target with its own tuple, and the two ways out
fun no_host_target(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) fail.Fail {
    var declared: str = "";
    var i:        u32 = 0;
    for (i < m.target_count) {
        val t:     *TargetDef          = ?m.targets[i];
        val tuple: res[str, fail.Fail] = tuple_of(alloc, intern.text(itn, t.sys), intern.text(itn, t.arch));
        if (sel tuple.err) { ret tuple.err; }
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}{} ({})", declared, sep, intern.text(itn, t.name), tuple.ok);
        if (sel longer.err) { ret longer.err; }
        declared = longer.ok;
        i        = i + 1;
    }
    val host: res[str, fail.Fail] = host_tuple(alloc);
    if (sel host.err) { ret host.err; }
    ret refuse(alloc, diagnostic_kind.SELECTION_NO_HOST_TARGET,
        "mach.toml: 'native' matches no declared target: the host is {} and the declared targets are {}; declare a [target.<name>] for the host or select one with -t",
        host.ok, declared);
}

fun profile_resolved(pf: *ProfileDef) ResolvedProfile {
    var rp: ResolvedProfile;
    rp.name         = pf.name;
    rp.optimize     = pf.optimize;
    rp.pass         = pf.pass;
    rp.skip         = pf.skip;
    rp.relax        = pf.relax;
    rp.linker_relax = pf.linker_relax;
    rp.debug        = pf.debug;
    rp.simd         = pf.simd;
    rp.allow        = pf.allow;
    ret rp;
}

# choose the profile a selection names. a named profile must be declared. an
# empty name takes the sole declared profile, else the one with `default = true`,
# of which parse admits at most one. several declared profiles with none marked
# default are refused: no profile is ever selected by table order
# ---
# alloc: owns error text
# itn:   resolves the names
# m:     the manifest
# pick:  the profile name, or "" for the default
# ret:   the profile; err "mach.toml: no profile named '<pick>'" or, with an empty
#        name, an error when several profiles are declared and none is the default
pub fun resolve_profile(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, pick: str) res[ResolvedProfile, fail.Fail] {
    var i: u32 = 0;
    if (!str_empty(pick)) {
        for (i < m.profile_count) {
            if (str_equals(intern.text(itn, m.profiles[i].name), pick)) { ret res[ResolvedProfile, fail.Fail].ok{profile_resolved(?m.profiles[i])}; }
            i = i + 1;
        }
        ret res[ResolvedProfile, fail.Fail].err{refuse(alloc, diagnostic_kind.SELECTION_UNKNOWN, "mach.toml: no profile named '{}'", pick)};
    }

    if (m.profile_count == 1) {
        ret res[ResolvedProfile, fail.Fail].ok{profile_resolved(?m.profiles[0])};
    }
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { ret res[ResolvedProfile, fail.Fail].ok{profile_resolved(?m.profiles[i])}; }
        i = i + 1;
    }
    var declared: Sites = sites_init(alloc);
    i = 0;
    for (i < m.profile_count) {
        sites_add(?declared, m.profiles[i].at);
        i = i + 1;
    }
    ret res[ResolvedProfile, fail.Fail].err{sites_fail(alloc, ?declared, fail.user(diagnostic_kind.SELECTION_AMBIGUOUS, AMBIGUOUS_PROFILE_MSG))};
}

# a selection several candidates could satisfy is refused where a command
# must pick one; table order carries no meaning
val AMBIGUOUS_PROFILE_MSG:  str = "mach.toml: several profiles are declared and none is marked `default = true`; no profile is selected by table order: mark exactly one [profile.<name>] with `default = true` or select one with -p";
val AMBIGUOUS_ARTIFACT_MSG: str = "mach.toml: several artifacts support the selected target and none is marked `default = true`; no artifact is selected by table order: mark exactly one [artifact.<name>] with `default = true` or select one with -a";

# the default selection: what a command takes for a target when no `-a`
# names an artifact. of the artifacts the target builds, those marked
# `default = true` when any is, otherwise every one. build and check take the whole
# selection, and a command that needs one artifact takes it only when it holds one
# ---
# itn:              resolves names
# m:                the manifest
# a:                the artifact asked about
# target:           the resolved target's name
# executables_only: consider `bin` artifacts only, so a library beside them is never taken
# ret:              true when the default selection holds `a`
fun default_selection_includes(itn: *intern.Interner, m: *Manifest, a: *ArtifactDef,
    target: intern.StrId, executables_only: bool) bool {
    if (!selection_scope_holds(itn, a, target, executables_only)) { ret false; }
    if (a.is_default)                                             { ret true; }
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val other: *ArtifactDef = ?m.artifacts[i];
        if (other.is_default && selection_scope_holds(itn, other, target, executables_only)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun selection_scope_holds(itn: *intern.Interner, a: *ArtifactDef, target: intern.StrId, executables_only: bool) bool {
    if (executables_only && catalog_artifact.is_library(a.kind)) { ret false; }
    ret artifact_supports_target(itn, a, target);
}

# every declared artifact as `bin <name>` or `lib <name>`, comma separated
fun artifact_candidates(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) res[str, fail.Fail] {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.artifact_count) {
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        var kind: str = "bin";
        if (catalog_artifact.is_library(m.artifacts[i].kind)) { kind = "lib"; }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}{} {}", s, sep, kind, intern.text(itn, m.artifacts[i].name));
        if (sel longer.err) { ret longer; }
        s = longer.ok;
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

# empty selectors: every axis takes the manifest's default
# ---
# alloc: backs the three pattern vectors
pub fun selectors_init(alloc: *A.Allocator) Selectors {
    ret Selectors{
        artifacts: collections_vector.init[str](alloc), targets: collections_vector.init[str](alloc),
        profiles:  collections_vector.init[str](alloc), all: false
    };
}

# release the pattern vectors of selectors; the patterns themselves are borrowed
pub fun selectors_dnit(s: *Selectors) {
    collections_vector.dnit[str](?s.artifacts);
    collections_vector.dnit[str](?s.targets);
    collections_vector.dnit[str](?s.profiles);
}

# selectors naming at most one pattern per axis: each non-empty value is its
# axis's one pattern, and an empty value leaves the axis to the manifest's default
# ---
# alloc:    backs the three pattern vectors
# artifact: the `-a` pattern, or empty
# target:   the `-t` pattern, or empty
# profile:  the `-p` pattern, or empty
# ret:      the selectors; err when a vector cannot grow
pub fun selectors_of(alloc: *A.Allocator, artifact: str, target: str, profile: str) res[Selectors, fail.Fail] {
    var s: Selectors      = selectors_init(alloc);
    val a: err[fail.Fail] = value_add(?s.artifacts, artifact);
    if (sel a.err) { ret res[Selectors, fail.Fail].err{a.err}; }
    val t: err[fail.Fail] = value_add(?s.targets, target);
    if (sel t.err) { ret res[Selectors, fail.Fail].err{t.err}; }
    val p: err[fail.Fail] = value_add(?s.profiles, profile);
    if (sel p.err) { ret res[Selectors, fail.Fail].err{p.err}; }
    ret res[Selectors, fail.Fail].ok{s};
}

# add `value` to `values` unless it is empty
fun value_add(values: *Vector[str], value: str) err[fail.Fail] {
    if (str_empty(value)) { ret err[fail.Fail].ok{}; }
    val pushed: res[usize, A.Error] = collections_vector.push[str](values, value);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# every cell as a person names it, `<artifact> on <target> (<profile>)`, comma
# separated, for a refusal that names the selection
fun cell_labels(alloc: *A.Allocator, cells: *Vector[Cell]) res[str, fail.Fail] {
    var s: str   = "";
    var i: usize = 0;
    for (i < cells.len) {
        val c:   *Cell = ?cells.data[i];
        var sep: str   = "";
        if (i > 0) { sep = ", "; }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}{} on {} ({})", s, sep, c.artifact, c.target_name, c.profile);
        if (sel longer.err) { ret longer; }
        s = longer.ok;
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

# the refusal of an option or command that needs one (artifact, target, profile)
# when the selection resolved to several, naming each
# ---
# alloc: owns the message
# k:     the kind the refusal is reported as
# what:  what needs one, such as "-o names one output"
# cells: the resolved cells
pub fun single_selection_fail(alloc: *A.Allocator, k: diagnostic_kind.Kind, what: str, cells: *Vector[Cell]) fail.Fail {
    val labels: res[str, fail.Fail] = cell_labels(alloc, cells);
    if (sel labels.err) { ret labels.err; }
    ret refuse(alloc, k, "{} but the selection resolves to {} (artifact, target, profile) combinations ({}); narrow it with -a, -t and -p",
        what, cells.len::i64, labels.ok);
}

# one entry an axis selected, and whether an exact name selected it rather than a glob
rec Pick {
    index: u32;
    exact: bool;
}

# the names one axis selects from, in declaration order
rec Axis {
    flag:  str;
    noun:  str;
    names: Vector[str];
}

fun axis_listing(alloc: *A.Allocator, ax: *Axis) res[str, fail.Fail] {
    if (ax.names.len == 0) { ret res[str, fail.Fail].ok{"none declared"}; }
    var s: str   = "declared: ";
    var i: usize = 0;
    for (i < ax.names.len) {
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}{}", s, sep, ax.names.data[i]);
        if (sel longer.err) { ret longer; }
        s = longer.ok;
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

# an exact value that names nothing on its axis
fun unknown_name(alloc: *A.Allocator, ax: *Axis, value: str) fail.Fail {
    val listing: res[str, fail.Fail] = axis_listing(alloc, ax);
    if (sel listing.err) { ret listing.err; }
    ret refuse(alloc, diagnostic_kind.SELECTION_UNKNOWN, "mach.toml: no {} named '{}' ({})", ax.noun, value, listing.ok);
}

# the entries an axis's patterns select, in declaration order; every exact
# name must be declared and every glob must match at least one entry
fun pick_axis(alloc: *A.Allocator, ax: *Axis, patterns: *Vector[str], out: *Vector[Pick]) err[fail.Fail] {
    var pi: usize = 0;
    for (pi < patterns.len) {
        val pattern: str   = patterns.data[pi];
        var hit:     bool  = false;
        var ni:      usize = 0;
        for (ni < ax.names.len) {
            if (glob_matches(pattern, ax.names.data[ni])) { hit = true; }
            ni = ni + 1;
        }
        if (!hit) {
            if (!is_glob(pattern)) { ret err[fail.Fail].err{unknown_name(alloc, ax, pattern)}; }
            val listing: res[str, fail.Fail] = axis_listing(alloc, ax);
            if (sel listing.err) { ret err[fail.Fail].err{listing.err}; }
            ret err[fail.Fail].err{refuse(alloc, diagnostic_kind.SELECTION_UNKNOWN, "{} '{}' matches no {} ({})", ax.flag, pattern, ax.noun, listing.ok)};
        }
        pi = pi + 1;
    }
    var ni: usize = 0;
    for (ni < ax.names.len) {
        var matched: bool  = false;
        var exact:   bool  = false;
        var qi:      usize = 0;
        for (qi < patterns.len) {
            if (glob_matches(patterns.data[qi], ax.names.data[ni])) {
                matched = true;
                if (!is_glob(patterns.data[qi])) { exact = true; }
            }
            qi = qi + 1;
        }
        if (matched) {
            val pushed: res[usize, A.Error] = collections_vector.push[Pick](out, Pick{index: ni::u32, exact: exact});
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
        ni = ni + 1;
    }
    ret err[fail.Fail].ok{};
}

fun axis_init(alloc: *A.Allocator, flag: str, noun: str) Axis {
    ret Axis{flag: flag, noun: noun, names: collections_vector.init[str](alloc)};
}

fun axis_add(ax: *Axis, itn: *intern.Interner, id: intern.StrId) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[str](?ax.names, intern.text(itn, id));
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the patterns an axis is resolved with: the given ones, `*` under `--all`, none otherwise
fun axis_patterns(alloc: *A.Allocator, given: *Vector[str], all: bool) res[Vector[str], fail.Fail] {
    if (given.len > 0 || !all) { ret res[Vector[str], fail.Fail].ok{@given}; }
    var star:  Vector[str]    = collections_vector.init[str](alloc);
    val added: err[fail.Fail] = value_add(?star, "*");
    if (sel added.err) { ret res[Vector[str], fail.Fail].err{added.err}; }
    ret res[Vector[str], fail.Fail].ok{star};
}

# target patterns with `native`, the reserved name no target may take, replaced by
# the name of the declared target `resolve_target` takes for it
fun native_named(alloc: *A.Allocator, tmp: *A.Allocator, itn: *intern.Interner, m: *Manifest, patterns: Vector[str]) res[Vector[str], fail.Fail] {
    var named: Vector[str] = collections_vector.init[str](tmp);
    var i:     usize       = 0;
    for (i < patterns.len) {
        var p: str = patterns.data[i];
        if (str_equals(p, "native")) {
            val rt: res[ResolvedTarget, fail.Fail] = resolve_target(alloc, itn, m, p, nil);
            if (sel rt.err) { ret res[Vector[str], fail.Fail].err{rt.err}; }
            p = intern.text(itn, rt.ok.target.name);
        }
        val added: err[fail.Fail] = value_add(?named, p);
        if (sel added.err) { ret res[Vector[str], fail.Fail].err{added.err}; }
        i = i + 1;
    }
    ret res[Vector[str], fail.Fail].ok{named};
}

# the targets the target axis chooses among: the declared ones, or the host
# target synthesized for a manifest that declares none
fun target_def_at(m: *Manifest, i: u32) *TargetDef {
    if (m.target_count == 0) { ret m.native_target; }
    ret ?m.targets[i];
}

fun target_candidates(m: *Manifest) u32 {
    if (m.target_count == 0 && m.native_target != nil) { ret 1; }
    ret m.target_count;
}

# one (artifact, target) pair of the selection before profiles cross it
rec Pair {
    artifact: *ArtifactDef;
    target:   str;
    def:      *TargetDef;
}

fun push_pair(pairs: *Vector[Pair], a: *ArtifactDef, target: str, def: *TargetDef) err[fail.Fail] {
    var i: usize = 0;
    for (i < pairs.len) {
        if (pairs.data[i].artifact == a && pairs.data[i].def == def) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    val pushed: res[usize, A.Error] = collections_vector.push[Pair](pairs, Pair{artifact: a, target: target, def: def});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun supporting_count(itn: *intern.Interner, m: *Manifest, def: *TargetDef, executables_only: bool) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if (!(executables_only && catalog_artifact.is_library(a.kind)) && artifact_supports_target(itn, a, def.name)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun no_artifact_for(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, def: *TargetDef) fail.Fail {
    var names: str = "";
    var i:     u32 = 0;
    for (i < m.artifact_count) {
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}{}", names, sep, intern.text(itn, m.artifacts[i].name));
        if (sel longer.err) { ret longer.err; }
        names = longer.ok;
        i     = i + 1;
    }
    var sites: Sites = sites_init(alloc);
    i = 0;
    for (i < m.artifact_count) {
        sites_add(?sites, m.artifacts[i].targets_at);
        i = i + 1;
    }
    ret sites_fail(alloc, ?sites, refuse(alloc, diagnostic_kind.TARGET_NO_ARTIFACTS, "mach.toml: no artifact declares target '{}'; declared artifacts: {}", intern.text(itn, def.name), names));
}

# the one artifact the default selection holds for a target, under `mode`.
# `ARTIFACT_DEFAULT_ONE` refuses a selection of several, naming the duplicate
# defaults or every candidate; `ARTIFACT_DEFAULT_EXECUTABLE` considers `bin`
# artifacts only and refuses when it does not hold exactly one
fun default_one(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, mode: ArtifactDefault,
    def: *TargetDef) res[*ArtifactDef, fail.Fail] {
    val only:   bool         = executables_only(mode);
    var count:  u32          = 0;
    var marked: u32          = 0;
    var sole:   *ArtifactDef = nil;
    var i:      u32          = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if (a.is_default && selection_scope_holds(itn, a, def.name, only)) { marked = marked + 1; }
        if (default_selection_includes(itn, m, a, def.name, only)) {
            sole  = a;
            count = count + 1;
        }
        i = i + 1;
    }
    if (count == 1) { ret res[*ArtifactDef, fail.Fail].ok{sole}; }
    if (only) {
        ret res[*ArtifactDef, fail.Fail].err{refuse(alloc, diagnostic_kind.SELECTION_AMBIGUOUS,
            "mach.toml: target '{}' has no sole default bin artifact; select one with -a", intern.text(itn, def.name))};
    }
    var sites: Sites = sites_init(alloc);
    i = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if (marked > 1) {
            if (a.is_default && selection_scope_holds(itn, a, def.name, false)) { sites_add(?sites, a.default_at); }
        }
        or (default_selection_includes(itn, m, a, def.name, false)) { sites_add(?sites, a.at); }
        i = i + 1;
    }
    if (marked > 1) {
        ret res[*ArtifactDef, fail.Fail].err{sites_fail(alloc, ?sites, fail.user(diagnostic_kind.SELECTION_DUPLICATE_DEFAULT,
            "mach.toml: multiple artifacts supporting the selected target have 'default = true'; exactly one is allowed"))};
    }
    val listed: res[str, fail.Fail] = artifact_candidates(alloc, itn, m);
    if (sel listed.err) { ret res[*ArtifactDef, fail.Fail].err{listed.err}; }
    ret res[*ArtifactDef, fail.Fail].err{sites_fail(alloc, ?sites, refuse(alloc, diagnostic_kind.SELECTION_AMBIGUOUS, "{} ({})", AMBIGUOUS_ARTIFACT_MSG, listed.ok))};
}

# the artifacts the default selection holds for one target, by `mode`. an
# exact target the default selection is empty for is refused; a globbed one is
# skipped, as its other targets may well hold artifacts
fun default_pairs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, mode: ArtifactDefault,
    target: str, def: *TargetDef, exact: bool, pairs: *Vector[Pair]) err[fail.Fail] {
    if (m.artifact_count == 0) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.ARTIFACT_NONE_DECLARED, "mach.toml: no [artifact.*] artifacts declared")};
    }
    if (supporting_count(itn, m, def, false) == 0) {
        if (exact) { ret err[fail.Fail].err{no_artifact_for(alloc, itn, m, def)}; }
        ret err[fail.Fail].ok{};
    }
    if (mode == ARTIFACT_DEFAULT_SET) {
        var i: u32 = 0;
        for (i < m.artifact_count) {
            val a: *ArtifactDef = ?m.artifacts[i];
            if (default_selection_includes(itn, m, a, def.name, false)) {
                val pushed: err[fail.Fail] = push_pair(pairs, a, target, def);
                if (sel pushed.err) { ret pushed; }
            }
            i = i + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var a: *ArtifactDef = nil;
    if (m.artifact_count == 1) { a = ?m.artifacts[0]; }
    or {
        val chosen: res[*ArtifactDef, fail.Fail] = default_one(alloc, itn, m, mode, def);
        if (sel chosen.err) { ret err[fail.Fail].err{chosen.err}; }
        a = chosen.ok;
    }
    if (!artifact_supports_target(itn, a, def.name)) {
        if (exact) { ret err[fail.Fail].err{no_artifact_for(alloc, itn, m, def)}; }
        ret err[fail.Fail].ok{};
    }
    ret push_pair(pairs, a, target, def);
}

fun unsupported(alloc: *A.Allocator, itn: *intern.Interner, a: *ArtifactDef, def: *TargetDef) fail.Fail {
    ret fail.at(alloc, refuse(alloc, diagnostic_kind.SELECTION_UNSUPPORTED_TARGET,
        "mach.toml: artifact '{}' does not support target '{}'", intern.text(itn, a.name), intern.text(itn, def.name)), a.targets_at);
}

# resolve selectors against a manifest into the cells they cover, profiles
# outermost, then targets, then artifacts, each in declaration order. an
# artifact is paired only with the targets its `targets` list supports: an
# exact artifact with an exact target it does not support is refused, any
# other unsupported pair is left out. an empty selection is refused
# ---
# alloc: owns the cells and every message
# itn:   resolves names
# m:     the root manifest
# s:     the selectors
# mode:  how an artifact axis given no pattern is filled without `--all`
# ret:   the cells, never empty; err for an unknown name, a glob matching
#        nothing, an unsupported exact pair, an ambiguous default or an empty selection
pub fun resolve_cells(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, s: *Selectors,
    mode: ArtifactDefault) res[Vector[Cell], fail.Fail] {
    # every working vector lives in a scratch arena; only the cells and a refusal outlive the call
    var ar:    arena.Arena;
    val ar_ok: err[A.Error] = arena.init(?ar, alloc, 0);
    if (sel ar_ok.err) { ret res[Vector[Cell], fail.Fail].err{fail.refused(ar_ok.err)}; }
    fin { arena.dnit(?ar); }
    var tmp:    A.Allocator;
    val tmp_ok: err[A.Error] = arena.make(?tmp, ?ar);
    if (sel tmp_ok.err) { ret res[Vector[Cell], fail.Fail].err{fail.refused(tmp_ok.err)}; }
    var profiles:           Vector[str]                 = collections_vector.init[str](?tmp);
    val profile_patterns_r: res[Vector[str], fail.Fail] = axis_patterns(?tmp, ?s.profiles, s.all);
    if (sel profile_patterns_r.err) { ret res[Vector[Cell], fail.Fail].err{profile_patterns_r.err}; }
    val profile_patterns: Vector[str] = profile_patterns_r.ok;
    if (profile_patterns.len > 0) {
        var ax: Axis = axis_init(?tmp, "-p", "profile");
        var i:  u32  = 0;
        for (i < m.profile_count) {
            val added: err[fail.Fail] = axis_add(?ax, itn, m.profiles[i].name);
            if (sel added.err) { ret res[Vector[Cell], fail.Fail].err{added.err}; }
            i = i + 1;
        }
        var picks:  Vector[Pick]   = collections_vector.init[Pick](?tmp);
        val picked: err[fail.Fail] = pick_axis(alloc, ?ax, ?profile_patterns, ?picks);
        if (sel picked.err) { ret res[Vector[Cell], fail.Fail].err{picked.err}; }
        var k: usize = 0;
        for (k < picks.len) {
            val added: err[fail.Fail] = value_add(?profiles, ax.names.data[picks.data[k].index]);
            if (sel added.err) { ret res[Vector[Cell], fail.Fail].err{added.err}; }
            k = k + 1;
        }
    }
    or {
        val rp: res[ResolvedProfile, fail.Fail] = resolve_profile(alloc, itn, m, "");
        if (sel rp.err) { ret res[Vector[Cell], fail.Fail].err{rp.err}; }
        val added: err[fail.Fail] = value_add(?profiles, intern.text(itn, rp.ok.name));
        if (sel added.err) { ret res[Vector[Cell], fail.Fail].err{added.err}; }
    }

    var artifacts:           Vector[Pick]                = collections_vector.init[Pick](?tmp);
    val artifact_patterns_r: res[Vector[str], fail.Fail] = axis_patterns(?tmp, ?s.artifacts, s.all);
    if (sel artifact_patterns_r.err) { ret res[Vector[Cell], fail.Fail].err{artifact_patterns_r.err}; }
    val artifact_patterns: Vector[str] = artifact_patterns_r.ok;
    val artifacts_given:   bool        = artifact_patterns.len > 0;
    if (artifacts_given) {
        var ax: Axis = axis_init(?tmp, "-a", "artifact");
        var i:  u32  = 0;
        for (i < m.artifact_count) {
            val added: err[fail.Fail] = axis_add(?ax, itn, m.artifacts[i].name);
            if (sel added.err) { ret res[Vector[Cell], fail.Fail].err{added.err}; }
            i = i + 1;
        }
        val picked: err[fail.Fail] = pick_axis(alloc, ?ax, ?artifact_patterns, ?artifacts);
        if (sel picked.err) { ret res[Vector[Cell], fail.Fail].err{picked.err}; }
    }

    var pairs:             Vector[Pair]                = collections_vector.init[Pair](?tmp);
    var skipped:           bool                        = false;
    var skipped_fail:      fail.Fail;
    val target_patterns_r: res[Vector[str], fail.Fail] = axis_patterns(?tmp, ?s.targets, s.all);
    if (sel target_patterns_r.err) { ret res[Vector[Cell], fail.Fail].err{target_patterns_r.err}; }
    val named_r: res[Vector[str], fail.Fail] = native_named(alloc, ?tmp, itn, m, target_patterns_r.ok);
    if (sel named_r.err) { ret res[Vector[Cell], fail.Fail].err{named_r.err}; }
    val target_patterns: Vector[str] = named_r.ok;
    if (target_patterns.len > 0) {
        var ax: Axis = axis_init(?tmp, "-t", "target");
        val n:  u32  = target_candidates(m);
        var i:  u32  = 0;
        for (i < n) {
            val added: err[fail.Fail] = axis_add(?ax, itn, target_def_at(m, i).name);
            if (sel added.err) { ret res[Vector[Cell], fail.Fail].err{added.err}; }
            i = i + 1;
        }
        var targets: Vector[Pick]   = collections_vector.init[Pick](?tmp);
        val picked:  err[fail.Fail] = pick_axis(alloc, ?ax, ?target_patterns, ?targets);
        if (sel picked.err) { ret res[Vector[Cell], fail.Fail].err{picked.err}; }
        var ti: usize = 0;
        for (ti < targets.len) {
            val tp:    Pick       = targets.data[ti];
            val def:   *TargetDef = target_def_at(m, tp.index);
            val tname: str        = ax.names.data[tp.index];
            if (artifacts_given) {
                var ai: usize = 0;
                for (ai < artifacts.len) {
                    val ap: Pick         = artifacts.data[ai];
                    val a:  *ArtifactDef = ?m.artifacts[ap.index];
                    if (artifact_supports_target(itn, a, def.name)) {
                        val pushed: err[fail.Fail] = push_pair(?pairs, a, tname, def);
                        if (sel pushed.err) { ret res[Vector[Cell], fail.Fail].err{pushed.err}; }
                    }
                    or (ap.exact && tp.exact) { ret res[Vector[Cell], fail.Fail].err{unsupported(alloc, itn, a, def)}; }
                    ai = ai + 1;
                }
            }
            or {
                val filled: err[fail.Fail] = default_pairs(alloc, itn, m, mode, tname, def, tp.exact, ?pairs);
                if (sel filled.err) { ret res[Vector[Cell], fail.Fail].err{filled.err}; }
            }
            ti = ti + 1;
        }
    }
    or (artifacts_given) {
        var ai: usize = 0;
        for (ai < artifacts.len) {
            val ap: Pick                           = artifacts.data[ai];
            val a:  *ArtifactDef                   = ?m.artifacts[ap.index];
            val rt: res[ResolvedTarget, fail.Fail] = resolve_target(alloc, itn, m, "", a);
            # a globbed artifact with no default target is left out; its refusal
            # stands only when nothing else was selected
            if (sel rt.err) {
                if (ap.exact) { ret res[Vector[Cell], fail.Fail].err{rt.err}; }
                if (!skipped) {
                    skipped      = true;
                    skipped_fail = rt.err;
                }
                ai = ai + 1;
                cnt;
            }
            val def: *TargetDef = rt.ok.target;
            if (artifact_supports_target(itn, a, def.name)) {
                val pushed: err[fail.Fail] = push_pair(?pairs, a, "", def);
                if (sel pushed.err) { ret res[Vector[Cell], fail.Fail].err{pushed.err}; }
            }
            or (ap.exact) {
                ret res[Vector[Cell], fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.SELECTION_UNSUPPORTED_TARGET,
                    "mach.toml: artifact '{}' does not support the default target '{}'; select one of its targets with -t",
                    intern.text(itn, a.name), intern.text(itn, def.name)), a.targets_at)};
            }
            ai = ai + 1;
        }
    }
    or {
        val rt: res[ResolvedTarget, fail.Fail] = resolve_target(alloc, itn, m, "", nil);
        if (sel rt.err) { ret res[Vector[Cell], fail.Fail].err{rt.err}; }
        val filled: err[fail.Fail] = default_pairs(alloc, itn, m, mode, "", rt.ok.target, true, ?pairs);
        if (sel filled.err) { ret res[Vector[Cell], fail.Fail].err{filled.err}; }
    }

    if (pairs.len == 0) {
        if (skipped) { ret res[Vector[Cell], fail.Fail].err{skipped_fail}; }
        ret res[Vector[Cell], fail.Fail].err{fail.user(diagnostic_kind.TARGET_NO_ARTIFACTS,
            "mach.toml: the selection holds no artifact on a target it supports; widen -a or -t")};
    }

    val host_os:   u32          = lang_target.host_os_id();
    val host_arch: u32          = lang_target.host_arch_id();
    var cells:     Vector[Cell] = collections_vector.init[Cell](alloc);
    var pi:        usize        = 0;
    for (pi < profiles.len) {
        var qi: usize = 0;
        for (qi < pairs.len) {
            val p: Pair = pairs.data[qi];
            val c: Cell = Cell{
                artifact: intern.text(itn, p.artifact.name), target: p.target, target_name: intern.text(itn, p.def.name),
                profile:  profiles.data[pi], native: target_matches_host(itn, p.def, host_os, host_arch)
            };
            val pushed: res[usize, A.Error] = collections_vector.push[Cell](?cells, c);
            if (sel pushed.err) { ret res[Vector[Cell], fail.Fail].err{fail.refused(pushed.err)}; }
            qi = qi + 1;
        }
        pi = pi + 1;
    }
    ret res[Vector[Cell], fail.Fail].ok{cells};
}

# resolve selectors a command needs one cell of: `resolve_cells`, refused as
# `single_selection_fail` refuses when the selection holds several
# ---
# what: what needs one cell, such as "mach doc renders one artifact"
# ret:  the cell; the `resolve_cells` errors, or the refusal of several cells
pub fun resolve_cell(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, s: *Selectors,
    mode: ArtifactDefault, what: str) res[Cell, fail.Fail] {
    val resolved: res[Vector[Cell], fail.Fail] = resolve_cells(alloc, itn, m, s, mode);
    if (sel resolved.err) { ret res[Cell, fail.Fail].err{resolved.err}; }
    var cells: Vector[Cell] = resolved.ok;
    fin { collections_vector.dnit[Cell](?cells); }
    if (cells.len != 1) {
        val refused: fail.Fail = single_selection_fail(alloc, diagnostic_kind.SELECTION_AMBIGUOUS, what, ?cells);
        ret res[Cell, fail.Fail].err{refused};
    }
    val c: Cell = cells.data[0];
    ret res[Cell, fail.Fail].ok{c};
}

# refuse a target's stack size on an object format whose image headers carry
# none; a target the registry cannot resolve is left to the build that selects it
# ---
# alloc: owns a refusal's text
# itn:   holds the manifest's names
# reg:   the registry the targets resolve against
# m:     the manifest
pub fun check_stack_keys(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, m: *Manifest) err[fail.Fail] {
    var i: u32 = 0;
    for (i < m.target_count) {
        val td: *TargetDef = ?m.targets[i];
        i = i + 1;
        if (td.stack_reserve == 0 && td.stack_commit == 0) { cnt; }
        val tr: res[lang_target.Binding, fail.Fail] = resolve_declared(alloc, itn, reg, td);
        if (sel tr.err) { cnt; }
        val t: lang_target.Binding = tr.ok;
        if (t.of.carries_stack_size) { cnt; }
        var key: str = "stack_reserve";
        if (td.stack_reserve == 0) { key = "stack_commit"; }
        ret err[fail.Fail].err{fail.formatted_user(alloc, diagnostic_kind.TARGET_STACK_SIZE,
            "mach.toml: [target.{}].{} is not expressible on the `{}` object format, which carries no stack size in its image headers",
            intern.text(itn, td.name), key, t.of.name)};
    }
    ret err[fail.Fail].ok{};
}
