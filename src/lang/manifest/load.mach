    TManifestCase{want: "", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789ABCDEF0123456789ABCDEF01234567\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"branch/main\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789abcdef0123456789abcdef01234567\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "dependency name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.\"../escape\"]\npath=\"../lib\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "target name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[target.\"../escape\"]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "artifact name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[artifact.\"../escape\"]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\n"},
    TManifestCase{want: "profile name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.\"../escape\"]\n"},
    TManifestCase{want: "link name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[link.\"../escape\"]\nsource=\"local\"\npath=\"obj/a.o\"\n"},
    TManifestCase{want: "mach.toml: [project].src contains a '\\\\'; manifest paths use '/'", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"a\\\\b\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "must not contain '.' or '..'", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"../src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "must be relative to the project root", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"/tmp/out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "empty path component", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src//lib\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "absolute drive path", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"C:/out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "opt must be 0, 1, or 2", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\nopt = 9\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n"},
    TManifestCase{want: "debug must be a boolean", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\nopt = 0\ndebug = 9\nvectorize = true\nfloat_reassoc = false\n"},
    TManifestCase{want: "", also: nil,
        src: "[project]\nid=\"a/b\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nid=\"a-b_2\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[step.s]\nargv=[\"cc\"]\nin=[\"a.c\"]\nout=[\"{project.out}/*.o\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "non-canonical value 'windoze'", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[link.l]\nsource=\"system\"\nname=\"c\"\nos=\"windoze\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[artifact.a]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/a\"\ntargets=[\"*\"]\nlink=[\"c\"]\nneed=[]\n[link.c]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"},
    TManifestCase{want: "mach.toml: [link.bad].os must be a string or array of strings", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=1\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "mach.toml: [link.bad].library must be a non-empty string", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[link.bad]\nsource=\"system\"\nname=\"a\"\nlibrary=\"\"\n"},
    TManifestCase{want: "mach.toml: [link.bad].library must be a non-empty string", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[link.bad]\nsource=\"system\"\nname=\"a\"\nlibrary=1\n"},
    TManifestCase{want: "mach.toml: [link.bad].os is empty; use a canonical value, \"*\", or []", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=\"\"\nisa=\"*\"\nabi=\"*\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
};

test parse__accepts_or_refuses_each_manifest_as_its_case_states {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    var i: usize = 0;
    for (i < 61) {
        val c:   *TManifestCase           = ?T_MANIFEST_CASES[i];
        val r:   res[Manifest, fail.Fail] = tparse(?alloc, ?itn, c.src);
        var bad: bool                     = sel r.ok;
        var msg: str                      = "parsed";
        if (sel r.err)     { msg = fail.describe(r.err); }
        if (c.want == nil) { bad = sel r.err; }
        or (sel r.err)     { bad = (!str_equals(c.want, "") && !str_contains(msg, c.want)) || (c.also != nil && !str_contains(msg, c.also)); }
        if (bad) {
            print.eprintlnf("manifest case {}: {}", i, msg);
            ret 2;
        }
        i = i + 1;
    }
    ret 0;
}

# [project].mach is a version range (#3499): a valid one is kept, a bare version (the form the
# key once took) and a non-string are refused with the range grammar's reason
test parse__project_mach_is_a_checked_version_range {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32                      = 0;
    val head: str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val tail: str                      = "[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val good: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}mach=\">=5.2, <7\"\n{}", head, tail));
    if (sel good.err) { code = 2; }
    if (sel good.ok) {
        var m:    Manifest = good.ok;
        val text: opt[str] = intern.lookup(?itn, m.mach);
        if (sel text.none) { code = 3; }
        if (sel text.some) {
            if (!str_equals(text.some, ">=5.2, <7")) { code = 4; }
        }
        dnit(?m, ?alloc);
    }
    val absent: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, tail));
    if (sel absent.ok) {
        var m: Manifest = absent.ok;
        if (m.mach != intern.STR_NIL) { code = 5; }
        dnit(?m, ?alloc);
    }
    if (sel absent.err) { code = 6; }
    val bare: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}mach=\"4.14.0\"\n{}", head, tail));
    if (sel bare.ok) { code = 7; }
    if (sel bare.err) {
        if (!str_equals(fail.describe(bare.err), "mach.toml: [project].mach = \"4.14.0\": a clause needs an operator, such as ^1.2 or >=1.2 (clause 1)")) { code = 8; }
    }
    val number: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}mach=5\n{}", head, tail));
    if (sel number.ok) { code = 9; }
    if (sel number.err) {
        if (!str_equals(fail.describe(number.err), "mach.toml: [project].mach must be a non-empty string")) { code = 10; }
    }
    arena.dnit(?ar);
    ret code;
}

#[testing]
pub fun need_head() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

#[testing]
pub fun need_artifact(alloc: *A.Allocator, name: str, out: str, need: str) str {
    ret sfmt(alloc, "[artifact.{}]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/{}.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[{}]\n", name, out, need);
}

#[testing]
pub fun need_err(alloc: *A.Allocator, itn: *intern.Interner, src: str, needle: str) bool {
    val r: res[Manifest, fail.Fail] = tparse(alloc, itn, src);
    if (sel r.ok) { ret false; }
    ret str_contains(fail.describe(r.err), needle);
}

test parse__step_argv_and_env_contract {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val valid: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['\"quoted\"',\"'single'\",'semi;$|&<>*?[]','{\"x\":1}',\"{\\\"escaped\\\":true}\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE='literal;$|&<>*?[]'\nJSON=\"{\\\"x\\\":1}\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        var m: Manifest = valid.ok;
        if (m.step_count != 1 || m.steps[0].argv_count != 5 || m.steps[0].env_count != 2) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, m.steps[0].argv[0]), "\"quoted\""))                                                                           { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[1]), "'single'"))                                                                             { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[2]), "semi;$|&<>*?[]"))                                                                       { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[3]), "{\"x\":1}"))                                                                            { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[4]), "{\"escaped\":true}"))                                                                   { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[0]), "JSON") || !str_equals(idstr(?itn, m.steps[0].env_values[0]), "{\"x\":1}"))          { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[1]), "VALUE") || !str_equals(idstr(?itn, m.steps[0].env_values[1]), "literal;$|&<>*?[]")) { code = 1; }
        }
    }

    val empty: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty.err && str_contains(fail.describe(empty.err), ".argv must be nonempty"))) { code = 1; }

    val empty_program: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty_program.err && str_contains(fail.describe(empty_program.err), "argv[0] must name an executable"))) { code = 1; }

    val cmd: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\ncmd=\"true\"\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel cmd.err && str_contains(fail.describe(cmd.err), "uses removed key 'cmd'"))) { code = 1; }

    val shell: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nshell=true\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel shell.err && str_contains(fail.describe(shell.err), "uses removed key 'shell'"))) { code = 1; }

    val env_type: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={VALUE=1}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_type.err && str_contains(fail.describe(env_type.err), ".env.VALUE must be a string"))) { code = 1; }

    val env_ambiguous: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={PATH=\"a\",Path=\"b\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_ambiguous.err && str_contains(fail.describe(env_ambiguous.err), "ambiguous keys"))) { code = 1; }

    val env_order_a: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={z=\"last\",B=\"middle\",a=\"first\"}\nin=[]\nout=[]\nneed=[]\n"));
    val env_order_b: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={a=\"first\",z=\"last\",B=\"middle\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (sel env_order_a.ok) {
        if (sel env_order_b.ok) {
            val ma: Manifest = env_order_a.ok;
            val mb: Manifest = env_order_b.ok;
            var ei: u32      = 0;
            for (ei < ma.steps[0].env_count && ei < mb.steps[0].env_count) {
                if (ma.steps[0].env_keys[ei] != mb.steps[0].env_keys[ei])     { code = 1; }
                if (ma.steps[0].env_values[ei] != mb.steps[0].env_values[ei]) { code = 1; }
                ei = ei + 1;
            }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[0]), "a"))        { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[0]), "first"))  { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[1]), "B"))        { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[1]), "middle")) { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[2]), "z"))        { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[2]), "last"))   { code = 1; }
        }
        if (sel env_order_b.err) { code = 1; }
    }
    if (sel env_order_a.err) { code = 1; }

    val argv_nul: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"pre\\u0000post\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel argv_nul.err && str_contains(fail.describe(argv_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_key_nul: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"A\\u0000B\"=\"x\"\n"));
    if (!(sel env_key_nul.err && str_contains(fail.describe(env_key_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_value_nul: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE=\"pre\\U00000000post\"\n"));
    if (!(sel env_value_nul.err && str_contains(fail.describe(env_value_nul.err), "cannot contain NUL"))) { code = 1; }

    val literal_escape: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['pre\\u0000post']\nin=[]\nout=[]\nneed=[]\n"));
    if (sel literal_escape.err) { code = 1; }

    val timeout: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\ntimeout=\"5m\"\n"));
    if (sel timeout.err) { code = 1; }
    if (sel timeout.ok) {
        val mt: Manifest = timeout.ok;
        if (mt.steps[0].timeout != chrono_duration.MINUTE * 5) { code = 1; }
    }

    val timeout_bare: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\ntimeout=30\n"));
    if (!(sel timeout_bare.err && str_contains(fail.describe(timeout_bare.err), ".timeout must be a non-empty string"))) { code = 1; }

    val timeout_seconds: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\ntimeout_seconds=30\n"));
    if (!(sel timeout_seconds.err && str_contains(fail.describe(timeout_seconds.err), "unknown key 'timeout_seconds'"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

# a manifest refused after arrays of an earlier entry were built releases every one of them
test parse__a_late_error_releases_the_owned_arrays {
    var srcs: [3]str = [3]str{
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\",\"arg\"]\nenv={A=\"one\",B=\"two\"}\nin=[\"src\"]\nout=[\"../escape\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n",
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.a]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/a\"\ntargets=[\"t1\",\"t2\"]\nlink=[\"l1\"]\nneed=[]\n[artifact.b]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/b\"\ntargets=[\"t1\"]\nlink=[\"l1\",\"l2\"]\nneed=[\"artifact.a\"]\nicon=\"icon.ico\"\n[artifact.c]\nkind=\"bin\"\nentry=\"c.mach\"\nout=\"bin/c\"\ntargets=[\"t1\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n",
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.a]\nsource=\"system\"\nname=\"foo\"\nsymbols=[\"sym1\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[link.b]\nsource=\"system\"\nname=\"bar\"\nsymbols=[\"sym2\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.c]\nsource=\"system\"\nname=\"baz\"\nsymbols=[\"sym3\",\"sym3\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"
    };
    var wants: [3]str = [3]str{"must not contain '.' or '..' path components", "icon and .manifest apply only to kind = \"bin\"", "lists 'sym3' twice"};
    var i:     usize  = 0;
    for (i < 3) {
        var probe: StepParseLive;
        var alloc: A.Allocator;
        if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
        var itn: intern.Interner          = intern.init(?alloc);
        val r:   res[Manifest, fail.Fail] = tparse(?alloc, ?itn, srcs[i]);
        if (sel r.ok) {
            intern.dnit(?itn);
            ret 2;
        }
        val named: bool = str_contains(fail.describe(r.err), wants[i]);
        fail.dnit(?alloc, r.err);
        intern.dnit(?itn);
        if (!named)          { ret 3; }
        if (probe.live != 0) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

