test "mach.lang.manifest.parse:operational_paths_are_project_relative" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:   i32 = 0;
    val prefix: str = "[project]\nid=\"x\"\nversion=\"1\"\n";
    val suffix: str = "\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val parent: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"../src\"\nout=\"out\"{}", prefix, suffix));
    if (!(sel parent.err && str_contains(outcome.describe(parent.err), "must not contain '.' or '..'"))) { code = 1; }

    val absolute: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"src\"\nout=\"/tmp/out\"{}", prefix, suffix));
    if (!(sel absolute.err && str_contains(outcome.describe(absolute.err), "must be relative to the project root"))) { code = 1; }

    val repeated: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"src//lib\"\nout=\"out\"{}", prefix, suffix));
    if (!(sel repeated.err && str_contains(outcome.describe(repeated.err), "empty path component"))) { code = 1; }

    val drive: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}src=\"src\"\nout=\"C:/out\"{}", prefix, suffix));
    if (!(sel drive.err && str_contains(outcome.describe(drive.err), "absolute drive path"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:platform_and_base" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.bmos]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\nplatform=\"bmos\"\nbase=0xFFFF800000000000\n[target.plain]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest   = res_manifest.ok;
        val tb: *TargetDef = find_target_by_name(?itn, ?m, "bmos");
        val tp: *TargetDef = find_target_by_name(?itn, ?m, "plain");
        if (tb == nil || tp == nil) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, tb.platform), "bmos")) { code = 1; }
            if (tb.base != 0xFFFF800000000000)                 { code = 1; }
            if (tp.platform != intern.STR_NIL)                 { code = 1; }
            if (tp.base != 0)                                  { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

