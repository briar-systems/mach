test "mach.lang.manifest.parse:link_library_requires_nonempty_string" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val prefix:    str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[link.bad]\nsource=\"system\"\nname=\"a\"\nlibrary=";
    val empty_src: str                         = sfmt(?alloc, "{}\"\"\n", prefix);
    val typed_src: str                         = sfmt(?alloc, "{}1\n", prefix);
    val empty:     res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, empty_src);
    val typed:     res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, typed_src);
    val want:      str                         = "mach.toml: [link.bad].library must be a non-empty string";
    if (!(sel empty.err && str_equals(outcome.describe(empty.err), want))) { code = 1; }
    if (!(sel typed.err && str_equals(outcome.describe(typed.err), want))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_symbols_claim" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val none: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel none.err) { code = 1; }
    if (sel none.ok) {
        val m: Manifest = none.ok;
        if (m.links[0].symbol_count != 0 || m.links[0].symbols != nil) { code = 1; }
    }

    val two: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"ExitProcess\"]\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel two.err) { code = 1; }
    if (sel two.ok) {
        val m: Manifest = two.ok;
        if (m.links[0].symbol_count != 2) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, m.links[0].symbols[0]), "Sleep"))       { code = 1; }
            if (!str_equals(idstr(?itn, m.links[0].symbols[1]), "ExitProcess")) { code = 1; }
        }
    }

    val scalar: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=\"Sleep\"\n"));
    if (!(sel scalar.err && str_equals(outcome.describe(scalar.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val typed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",1]\n"));
    if (!(sel typed.err && str_equals(outcome.describe(typed.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val blank: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"\"]\n"));
    if (!(sel blank.err && str_equals(outcome.describe(blank.err), "mach.toml: [link.k].symbols has an empty symbol name"))) { code = 1; }

    val dup: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"Sleep\"]\n"));
    if (!(sel dup.err && str_equals(outcome.describe(dup.err), "mach.toml: [link.k].symbols lists 'Sleep' twice"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_include_values" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val default_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel default_r.err) { code = 1; }
    if (sel default_r.ok) {
        val m: Manifest = default_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val always_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"always\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel always_r.err) { code = 1; }
    if (sel always_r.ok) {
        val m: Manifest = always_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val referenced_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"referenced\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel referenced_r.err) { code = 1; }
    if (sel referenced_r.ok) {
        val m: Manifest = referenced_r.ok;
        if (!m.links[0].include_referenced) { code = 1; }
    }

    val bad_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"sometimes\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel bad_r.err && str_equals(outcome.describe(bad_r.err), "mach.toml: [link.k].include must be \"always\" or \"referenced\""))) { code = 1; }

    val typed_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=1\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel typed_r.err && str_equals(outcome.describe(typed_r.err), "mach.toml: [link.k].include must be \"always\" or \"referenced\""))) { code = 1; }

    val dep_r: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"libdemo\"\nlibrary=\"libdemo\"\ninclude=\"referenced\"\nexport=true\n"));
    if (sel dep_r.err) { code = 1; }
    if (sel dep_r.ok) {
        val m: Manifest = dep_r.ok;
        if (!m.links[0].include_referenced || !m.links[0].export) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_filter_empty_string_error" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=\"\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: [link.bad].os is empty; use a canonical value, \"*\", or [], or omit it"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_filter_empty_array_matches_nothing" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.arm]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[link.none]\nsource=\"system\"\nname=\"a\"\nos=[]\n[link.absent]\nsource=\"system\"\nname=\"b\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest   = res_manifest.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        val ta: *TargetDef = find_target_by_name(?itn, ?m, "arm");
        if (tl == nil || tw == nil || ta == nil) { code = 1; }
        or {
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), tl))    { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), tw))    { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), ta))    { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "absent"), tl)) { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "absent"), tw)) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:several_targets_or_profiles_marked_default_are_refused_naming_each_table" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n";
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val lx:   str = "[target.lx]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\ndefault=true\n";
    val mac:  str = "[target.mac]\nisa=\"x86_64\"\nos=\"darwin\"\nabi=\"sysv64\"\ndefault=true\n";
    val win:  str = "[target.win]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n";

    val two: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, win, mac, art));
    if (sel two.ok) { code = 1; }
    if (sel two.err) {
        val msg: str = outcome.describe(two.err);
        if (!str_contains(msg, "2 targets declare `default = true` ([target.lx], [target.mac])")
            || str_contains(msg, "[target.win]") || !str_contains(msg, "exactly one is allowed")) { code = 1; }
    }

    val one: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, lx, win, art));
    if (sel one.err) { code = 1; }
    if (sel one.ok) {
        var m: Manifest = one.ok;
        if (m.target_count != 2 || !m.targets[0].is_default || m.targets[1].is_default) { code = 1; }
    }

    val lenient: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, win, mac, art));
    if (sel lenient.err) { code = 1; }

    val pa:       str                         = "[profile.fast]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val pb:       str                         = "[profile.slow]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val profiles: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, art, pa, pb));
    if (sel profiles.ok) { code = 1; }
    if (sel profiles.err) {
        val msg: str = outcome.describe(profiles.err);
        if (!str_contains(msg, "2 profiles declare `default = true` ([profile.fast], [profile.slow])")
            || !str_contains(msg, "exactly one is allowed")) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:unknown_top_level_table_or_key_is_rejected" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32                         = 0;
    val head: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val a:    res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[bogus_top_level_table]\nk = 1\n"));
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: unknown table or key 'bogus_top_level_table' at the document root"))) { code = 1; }
    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", "stray = true\n", head));
    if (!(sel b.err && str_equals(outcome.describe(b.err), "mach.toml: unknown table or key 'stray' at the document root"))) { code = 1; }
    val c: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, head);
    if (sel c.err) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:env_is_a_target_key_carried_verbatim" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32                         = 0;
    val head: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:  str                         = "[artifact.k]\nkind=\"bin\"\nentry=\"k.mach\"\nout=\"k.spv\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val gpu:  str                         = "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=\"vulkan1.2\"\n";
    val r:    res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, gpu, art));
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        val m: Manifest = r.ok;
        if (m.target_count != 1 || !str_equals(idstr(?itn, m.targets[0].env), "vulkan1.2")) { code = 1; }
    }
    val plain: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\n", art));
    if (!(sel plain.ok && plain.ok.targets[0].env == intern.STR_NIL)) { code = 1; }
    val bad: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=3\n", art));
    if (!(sel bad.err && str_contains(outcome.describe(bad.err), "env must be a non-empty string"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:the_isa_spellings_mach_info_targets_prints_resolve_as_written" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val head: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:  str                         = "[artifact.k]\nkind=\"bin\"\nentry=\"k.mach\"\nout=\"k\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val rows: str                         = "[target.wide]\nisa=\"rv64gc\"\nos=\"linux\"\nabi=\"lp64d\"\n[target.narrow]\nisa=\"rv32imac\"\nos=\"freestanding\"\nabi=\"ilp32\"\n";
    val r:    res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, rows, art));
    if (sel r.err) { ret 2; }
    val m: Manifest = r.ok;
    if (m.target_count != 2) { ret 3; }

    var reg: tgt.TargetRegistry = tgt.registry_init();
    fin { tgt.registry_dnit(?reg); }
    val ready: err[fail.Fail] = tgt.register_all(?reg, target_testing.debug_descriptor);
    if (sel ready.err) { ret 4; }
    var i: u32 = 0;
    for (i < 2) {
        val d:        *TargetDef                 = ?m.targets[i];
        val isa_name: str                        = idstr(?itn, d.isa);
        val t_r:      res[tgt.Target, fail.Fail] = tgt.select(?reg, isa_name, idstr(?itn, d.os), idstr(?itn, d.abi));
        if (sel t_r.err) { ret 5; }
        var buf: [32]u8;
        if (!str_equals(tgt.selection_spelling(t_r.ok.isa, ?t_r.ok.model, ?buf[0], 32), isa_name)) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.manifest.parse: Windows Unicode environment names cannot alias" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val source: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"MACH_ÄΩ\"=\"first\"\n\"mach_äω\"=\"second\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val parsed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, source);
    $if ($mach.build.os == $mach.os.windows) {
        if (sel parsed.ok)                                                 { ret 2; }
        if (!str_contains(outcome.describe(parsed.err), "ambiguous keys")) { ret 3; }
    }
    $or {
        if (sel parsed.err) { ret 4; }
        val manifest: Manifest = parsed.ok;
        if (manifest.step_count != 1 || manifest.steps[0].env_count != 2) { ret 5; }
    }
    ret 0;
}

test "mach.lang.manifest.native_owner:unknown_key_rejection_owns_only_its_message" {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?backing);
    fin { intern.dnit(?itn); }
    val table_r: res[toml.Table, toml.TomlError] = toml.parse(?backing, "[project]\nid=\"p\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nname=\"unused\"\n");
    if (sel table_r.err) { ret 2; }
    var table: toml.Table = table_r.ok;
    fin { toml.dnit(?backing, ?table); }
    var tracking: alloc_test.Testing;
    val make_r2:  err[A.Error] = alloc_test.make(?tracking);
    if (sel make_r2.err) { ret 3; }
    fin { alloc_test.dnit(?tracking); }
    val parsed: res[Manifest, outcome.Fail] = parse(?tracking.a, ?itn, ?table, true);
    if (sel parsed.ok) {
        var unexpected: Manifest = parsed.ok;
        dnit(?unexpected, ?tracking.a);
        ret 4;
    }
    if (!str_contains(outcome.describe(parsed.err), "unknown key 'name' in [project]")) { ret 5; }
    outcome.release_text(?tracking.a, parsed.err);
    if (tracking.total < 1 || tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 6; }
    ret 0;
}
