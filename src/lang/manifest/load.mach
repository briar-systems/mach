test parse__an_env_intern_failure_aborts_the_step {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var base:     intern.Interner          = intern.init(?alloc);
    val head:     str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val seeded_r: res[Manifest, fail.Fail] = tparse(?alloc, ?base, head);
    if (sel seeded_r.err) {
        intern.dnit(?base);
        ret 1;
    }
    var seeded: Manifest = seeded_r.ok;
    dnit(?seeded, ?alloc);

    val source: str                 = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nUNSEEDED=\"value\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val doc_r:  res[Doc, fail.Fail] = doc_parse(?alloc, "mach.toml", source);
    if (sel doc_r.err) {
        intern.dnit(?base);
        ret 1;
    }
    var doc: Doc = doc_r.ok;

    var fail_alloc: A.Allocator;
    fail_alloc.ctx           = nil;
    fail_alloc.fn_allocate   = step_intern_fail_allocate;
    fail_alloc.fn_reallocate = step_intern_fail_reallocate;
    fail_alloc.fn_deallocate = step_intern_fail_deallocate;
    var child:  intern.Interner          = intern.make_child(?base, ?fail_alloc);
    val parsed: res[Manifest, fail.Fail] = parse(?alloc, ?child, ?doc);
    doc_dnit(?alloc, ?doc);
    val bad: bool = sel parsed.ok || child.len != 0;
    intern.dnit(?child);
    intern.dnit(?base);
    if (bad) { ret 1; }
    ret 0;
}

test parse__artifact_subsystem_defaults_to_console {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val a: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, art));
    if (sel a.err) { code = 1; }
    if (sel a.ok) {
        if (a.ok.artifacts[0].subsystem != target_of.SUBSYSTEM_CONSOLE || a.ok.artifacts[0].subsystem_declared) { code = 1; }
    }

    val b: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"gui\"\n"));
    if (sel b.err) { code = 1; }
    if (sel b.ok) {
        if (b.ok.artifacts[0].subsystem != target_of.SUBSYSTEM_GUI || !b.ok.artifacts[0].subsystem_declared) { code = 1; }
    }

    val c: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"console\"\n"));
    if (sel c.err) { code = 1; }
    if (sel c.ok) {
        if (c.ok.artifacts[0].subsystem != target_of.SUBSYSTEM_CONSOLE) { code = 1; }
    }

    val d: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"windows\"\n"));
    if (!(sel d.err && str_contains(fail.describe(d.err), "subsystem must be \"console\" or \"gui\""))) { code = 1; }

    val e: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=2\n"));
    if (!(sel e.err && str_contains(fail.describe(e.err), "subsystem must be a non-empty string"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test parse__artifact_icon_and_manifest_keys {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val bin:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val absent: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, bin));
    if (sel absent.err) { code = 1; }
    if (sel absent.ok) {
        val a: ArtifactDef = absent.ok.artifacts[0];
        if (a.icon != intern.STR_NIL || a.app_manifest != intern.STR_NIL) { code = 1; }
    }

    val valid: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets/app.ico\"\nmanifest=\"assets/app.manifest\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        val a:  ArtifactDef = valid.ok.artifacts[0];
        val io: opt[str]    = intern.lookup(?itn, a.icon);
        val mo: opt[str]    = intern.lookup(?itn, a.app_manifest);
        if (!(sel io.some && str_equals(io.some, "assets/app.ico")))      { code = 1; }
        if (!(sel mo.some && str_equals(mo.some, "assets/app.manifest"))) { code = 1; }
    }

    val empty_icon: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"\"\n"));
    if (!(sel empty_icon.err && str_contains(fail.describe(empty_icon.err), ".icon must be a non-empty string"))) { code = 1; }

    val wrong_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "manifest=42\n"));
    if (!(sel wrong_manifest.err && str_contains(fail.describe(wrong_manifest.err), ".manifest must be a non-empty string"))) { code = 1; }

    val backslash: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets\\\\app.ico\"\n"));
    if (!(sel backslash.err && str_contains(fail.describe(backslash.err), "manifest paths use '/'"))) { code = 1; }

    val static_art: str                      = "[artifact.lib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/x.a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\nicon=\"assets/app.ico\"\n";
    val irrelevant: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, static_art));
    if (!(sel irrelevant.err && str_contains(fail.describe(irrelevant.err), "apply only to kind = \"bin\" artifacts"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test parse__target_platform_and_base {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.bmos]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\nplatform=\"bmos\"\nbase=0xFFFF800000000000\n[target.plain]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest   = res_manifest.ok;
        val tb: *TargetDef = find_target_by_name(?itn, ?m, "bmos");
        val tp: *TargetDef = find_target_by_name(?itn, ?m, "plain");
        if (tb == nil || tp == nil) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, tb.platform), "bmos")) { code = 1; }
            if (tb.base != 0xFFFF800000000000)                 { code = 1; }
            if (tp.platform != intern.STR_NIL)                 { code = 1; }
            if (tp.base != 0)                                  { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test link_matches_target__string_array_star_and_empty_filters {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.arm]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[link.os_str]\nsource=\"system\"\nname=\"a\"\nos=\"linux\"\nisa=\"*\"\nabi=\"*\"\n[link.os_arr]\nsource=\"system\"\nname=\"b\"\nos=[\"linux\"]\nisa=\"*\"\nabi=\"*\"\n[link.os_star]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\nisa=\"*\"\nabi=\"*\"\n[link.isa_str]\nsource=\"system\"\nname=\"e\"\nos=\"*\"\nisa=\"x86_64\"\nabi=\"*\"\n[link.abi_str]\nsource=\"system\"\nname=\"f\"\nos=\"*\"\nisa=\"*\"\nabi=\"sysv64\"\n[link.none]\nsource=\"system\"\nname=\"g\"\nos=[]\nisa=\"*\"\nabi=\"*\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;

        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        val ta: *TargetDef = find_target_by_name(?itn, ?m, "arm");
        if (tl == nil || tw == nil || ta == nil) { code = 1; }
        or {
            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "os_str"), tw))  { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_arr"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "os_arr"), tw))  { code = 1; }

            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_star"), tw)) { code = 1; }

            if (!link_matches_target(?itn, find_link(?itn, ?m, "isa_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "isa_str"), ta))  { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "abi_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "abi_str"), tw))  { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), tl))     { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), ta))     { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

# one rule per key holds in every manifest: a required key is refused when it is
# missing, and a key whose absence means it does not apply may be left out
test parse__every_manifest_declares_its_required_keys_and_may_omit_the_rest {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:               i32 = 0;
    val bare:               str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val head:               str = sfmt(?alloc, "{}{}", bare, "[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    val no_profile_message: str = "mach.toml: missing [profile] table; a build needs an explicit [profile.<name>] declaring opt, debug, simd, vectorize and float_reassoc";

    val no_profile: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, bare);
    if (!(sel no_profile.err && str_equals(fail.describe(no_profile.err), no_profile_message))) { code = 2; }
    val empty_profile: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", bare, "[profile]\n"));
    if (!(sel empty_profile.err && str_equals(fail.describe(empty_profile.err), no_profile_message))) { code = 3; }

    var keys: [5]str;
    keys[0] = "opt";
    keys[1] = "debug";
    keys[2] = "simd";
    keys[3] = "vectorize";
    keys[4] = "float_reassoc";
    var partial: [5]str;
    partial[0] = "[profile.p]\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    partial[1] = "[profile.p]\nopt=0\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    partial[2] = "[profile.p]\nopt=0\ndebug=false\nvectorize=true\nfloat_reassoc=false\n";
    partial[3] = "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=false\n";
    partial[4] = "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\n";
    var ki: usize = 0;
    for (ki < 5) {
        val r:    res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", bare, partial[ki]));
        val want: str                      = sfmt(?alloc, "mach.toml: [profile.p] is missing required key '{}'; a profile declares opt, debug, simd, vectorize and float_reassoc", keys[ki]);
        if (!(sel r.err && str_equals(fail.describe(r.err), want))) { code = 4; }
        ki = ki + 1;
    }
    val p_simd_bad: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", bare, "[profile.p]\nopt=0\ndebug=false\nsimd=\"bogus\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel p_simd_bad.err && str_contains(fail.describe(p_simd_bad.err), "simd must be \"scalarize\" or \"require\""))) { code = 5; }

    val l_os: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\n"));
    if (!(sel l_os.err && str_contains(fail.describe(l_os.err), "missing required key 'os'"))) { code = 6; }
    val l_isa: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\n"));
    if (!(sel l_isa.err && str_contains(fail.describe(l_isa.err), "missing required key 'isa'"))) { code = 7; }
    val l_abi: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\nisa=[\"*\"]\n"));
    if (!(sel l_abi.err && str_contains(fail.describe(l_abi.err), "missing required key 'abi'"))) { code = 8; }
    val d_ref: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[dep.d]\ngit=\"u\"\n"));
    if (!(sel d_ref.err && str_contains(fail.describe(d_ref.err), "missing required key 'ref' or 'version' for git source"))) { code = 9; }

    # an artifact with no link or need, a link with no export and a step with no need
    val optional: str                      = "[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[artifact.a]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/a\"\ntargets=[\"*\"]\n[link.l]\nsource=\"system\"\nname=\"c\"\nos=[\"windows\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[step.s]\nargv=[\"c\"]\nin=[\"i\"]\nout=[\"o\"]\n";
    val omitted:  res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, optional));
    if (sel omitted.err) { code = 10; }
    if (sel omitted.ok) {
        var m:  Manifest   = omitted.ok;
        val l:  *LinkDef   = find_link(?itn, ?m, "l");
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        if (m.artifact_count != 1 || m.artifacts[0].link_count != 0 || m.artifacts[0].need_count != 0) { code = 11; }
        if (m.step_count != 1 || m.steps[0].need_count != 0)                                           { code = 12; }
        if (l == nil || tl == nil || tw == nil)                                                        { code = 13; }
        or {
            if (l.export)                          { code = 14; }
            if (!link_matches_target(?itn, l, tw)) { code = 15; }
            if (link_matches_target(?itn, l, tl))  { code = 16; }
        }
    }

    arena.dnit(?ar);
    ret code;
}

test parse__link_symbols {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val none: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel none.err) { code = 1; }
    if (sel none.ok) {
        val m: Manifest = none.ok;
        if (m.links[0].symbol_count != 0 || m.links[0].symbols != nil) { code = 1; }
    }

    val two: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"ExitProcess\"]\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel two.err) { code = 1; }
    if (sel two.ok) {
        val m: Manifest = two.ok;
        if (m.links[0].symbol_count != 2) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, m.links[0].symbols[0]), "Sleep"))       { code = 1; }
            if (!str_equals(idstr(?itn, m.links[0].symbols[1]), "ExitProcess")) { code = 1; }
        }
    }

    val scalar: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=\"Sleep\"\n"));
    if (!(sel scalar.err && str_equals(fail.describe(scalar.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val typed: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",1]\n"));
    if (!(sel typed.err && str_equals(fail.describe(typed.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val blank: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"\"]\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\n"));
    if (!(sel blank.err && str_equals(fail.describe(blank.err), "mach.toml: [link.k].symbols has an empty symbol name"))) { code = 1; }

    val dup: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"Sleep\"]\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\n"));
    if (!(sel dup.err && str_equals(fail.describe(dup.err), "mach.toml: [link.k].symbols lists 'Sleep' twice"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test parse__link_include {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val default_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel default_r.err) { code = 1; }
    if (sel default_r.ok) {
        val m: Manifest = default_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val always_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"always\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel always_r.err) { code = 1; }
    if (sel always_r.ok) {
        val m: Manifest = always_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val referenced_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"referenced\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel referenced_r.err) { code = 1; }
    if (sel referenced_r.ok) {
        val m: Manifest = referenced_r.ok;
        if (!m.links[0].include_referenced) { code = 1; }
    }

    val bad_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"sometimes\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel bad_r.err && str_equals(fail.describe(bad_r.err), "mach.toml: [link.k].include must be \"always\" or \"referenced\""))) { code = 1; }

    val typed_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=1\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel typed_r.err && str_equals(fail.describe(typed_r.err), "mach.toml: [link.k].include must be a non-empty string"))) { code = 1; }

    val dep_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"libdemo\"\nlibrary=\"libdemo\"\ninclude=\"referenced\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n"));
    if (sel dep_r.err) { code = 1; }
    if (sel dep_r.ok) {
        val m: Manifest = dep_r.ok;
        if (!m.links[0].include_referenced || !m.links[0].export) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test parse__several_profile_defaults_are_refused_and_target_defaults_are_ignored {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n";
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val lx:   str = "[target.lx]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\ndefault=true\n";
    val mac:  str = "[target.mac]\nisa=\"x86_64\"\nos=\"darwin\"\nabi=\"sysv64\"\ndefault=true\n";
    val win:  str = "[target.win]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n";

    # `default = true` on a target is deprecated: it parses, however many carry it
    val two: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, win, mac, art));
    if (sel two.err) { code = 1; }
    if (sel two.ok) {
        var m: Manifest = two.ok;
        if (m.target_count != 3 || !m.targets[0].is_default || m.targets[1].is_default || !m.targets[2].is_default) { code = 1; }
    }

    val pa:       str                      = "[profile.fast]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val pb:       str                      = "[profile.slow]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val profiles: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}{}", head, lx, art, pa, pb));
    if (sel profiles.ok) { code = 1; }
    if (sel profiles.err) {
        val msg: str = fail.describe(profiles.err);
        if (!str_contains(msg, "2 profiles declare `default = true` ([profile.fast], [profile.slow])")
            || !str_contains(msg, "exactly one is allowed")) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test parse__target_env_is_carried_verbatim {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32                      = 0;
    val head: str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:  str                      = "[artifact.k]\nkind=\"bin\"\nentry=\"k.mach\"\nout=\"k.spv\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val gpu:  str                      = "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=\"vulkan1.2\"\n";
    val r:    res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, gpu, art));
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        val m: Manifest = r.ok;
        if (m.target_count != 1 || !str_equals(idstr(?itn, m.targets[0].env), "vulkan1.2")) { code = 1; }
    }
    val plain: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\n", art));
    if (!(sel plain.ok && plain.ok.targets[0].env == intern.STR_NIL)) { code = 1; }
    val bad: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=3\n", art));
    if (!(sel bad.err && str_contains(fail.describe(bad.err), "env must be a non-empty string"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test parse__isa_spellings_resolve_as_written {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val head: str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:  str                      = "[artifact.k]\nkind=\"bin\"\nentry=\"k.mach\"\nout=\"k\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val rows: str                      = "[target.wide]\nisa=\"rv64gc\"\nos=\"linux\"\nabi=\"lp64d\"\n[target.narrow]\nisa=\"rv32imac\"\nos=\"freestanding\"\nabi=\"ilp32\"\n";
    val r:    res[Manifest, fail.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, rows, art));
    if (sel r.err) { ret 2; }
    val m: Manifest = r.ok;
    if (m.target_count != 2) { ret 3; }

    var reg: lang_target.TargetRegistry = lang_target.registry_init();
    fin { lang_target.registry_dnit(?reg); }
    val ready: err[fail.Fail] = lang_target.register_all(?reg, target_testing.debug_descriptor);
    if (sel ready.err) { ret 4; }
    var i: u32 = 0;
    for (i < 2) {
        val d:        *TargetDef                         = ?m.targets[i];
        val isa_name: str                                = idstr(?itn, d.isa);
        val t_r:      res[lang_target.Target, fail.Fail] = lang_target.select(?reg, isa_name, idstr(?itn, d.os), idstr(?itn, d.abi));
        if (sel t_r.err) { ret 5; }
        var buf: [32]u8;
        if (!str_equals(lang_target.selection_spelling(t_r.ok.isa, ?t_r.ok.model, ?buf[0], 32), isa_name)) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test parse__windows_env_names_cannot_alias_across_case {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val source: str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"MACH_ÄΩ\"=\"first\"\n\"mach_äω\"=\"second\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val parsed: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, source);
    $if ($mach.build.os == $mach.os.windows) {
        if (sel parsed.ok)                                              { ret 2; }
        if (!str_contains(fail.describe(parsed.err), "ambiguous keys")) { ret 3; }
    }
    $or {
        if (sel parsed.err) { ret 4; }
        val manifest: Manifest = parsed.ok;
        if (manifest.step_count != 1 || manifest.steps[0].env_count != 2) { ret 5; }
    }
    ret 0;
}

test parse__an_unknown_key_rejection_owns_only_its_message {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?backing);
    fin { intern.dnit(?itn); }
    val doc_r: res[Doc, fail.Fail] = doc_parse(?backing, "mach.toml", "[project]\nid=\"p\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nname=\"unused\"\n");
    if (sel doc_r.err) { ret 2; }
    var doc: Doc = doc_r.ok;
    fin { doc_dnit(?backing, ?doc); }
    var tracking: T.Testing;
    val make_r2:  err[A.Error] = T.make(?tracking);
    if (sel make_r2.err) { ret 3; }
    fin { T.dnit(?tracking); }
    val parsed: res[Manifest, fail.Fail] = parse(?tracking.a, ?itn, ?doc);
    if (sel parsed.ok) {
        var unexpected: Manifest = parsed.ok;
        dnit(?unexpected, ?tracking.a);
        ret 4;
    }
    if (!str_contains(fail.describe(parsed.err), "unknown key 'name' in [project]")) { ret 5; }
    fail.dnit(?tracking.a, parsed.err);
    if (tracking.total < 1 || tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 6; }
    ret 0;
}
