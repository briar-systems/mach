# build a `Manifest` from a parsed TOML document, in three stages. the schema
# check holds the document to the rows of `mach.lang.manifest.schema`: a key no
# row names, a value of the wrong shape, a missing required key and a removed key
# are refused where they are written. decoding then reads each table into the
# model and refuses a value its key does not accept. validation last checks the
# rules that span entries and values: `need` entries and their cycles, `link`
# names, at most one `default = true` profile, and every template against what
# its place admits. one rule holds for every key whoever reads the manifest, so
# a dependency's manifest is held to exactly the rules of the project being
# built. on any error every array allocated so far is freed
# ---
# alloc: owns the manifest's arrays
# itn:   receives every string of the manifest
# doc:   the manifest's text and its TOML document
# ret:   the manifest, or the first error as a "mach.toml: ..." message pointing at
#        the key or value in `doc` it concerns. the manifest records where each
#        field a later refusal names is written, resolved in `doc`
pub fun parse(alloc: *A.Allocator, itn: *intern.Interner, doc: *Doc) res[Manifest, fail.Fail] {
    val r: res[Manifest, fail.Fail] = parse_table(alloc, itn, ?doc.table);
    if (sel r.err) { ret res[Manifest, fail.Fail].err{fail.placed(alloc, r.err, doc.path, doc.text)}; }
    var m:      Manifest = r.ok;
    var handed: bool     = false;
    fin {
        if (!handed) { dnit(?m, alloc); }
    }
    val path: res[intern.StrId, fail.Fail] = id_of(itn, doc.path);
    if (sel path.err) { ret res[Manifest, fail.Fail].err{path.err}; }
    val lines_r: res[lang_source.Lines, A.Error] = lang_source.lines_init(alloc, doc.text::*u8, str_len(doc.text));
    if (sel lines_r.err) { ret res[Manifest, fail.Fail].err{fail.refused(lines_r.err)}; }
    var lines: SiteFile = SiteFile{path: intern.text(itn, path.ok), lines: lines_r.ok};
    resolve_sites(?lines, ?m);
    lang_source.lines_dnit(alloc, ?lines.lines);
    handed = true;
    ret res[Manifest, fail.Fail].ok{m};
}

# the file the model's places are resolved in: its path and its line index
rec SiteFile {
    path:  str;
    lines: lang_source.Lines;
}

# resolve every place the model recorded while parsing in the file `lines` indexes
fun resolve_sites(lines: *SiteFile, m: *Manifest) {
    m.project_at = resolved(lines, m.project_at);
    m.mach_at    = resolved(lines, m.mach_at);
    m.work_at    = resolved(lines, m.work_at);
    var i: u32 = 0;
    for (i < m.target_count) {
        m.targets[i].at = resolved(lines, m.targets[i].at);
        i               = i + 1;
    }
    i = 0;
    for (i < m.profile_count) {
        m.profiles[i].at         = resolved(lines, m.profiles[i].at);
        m.profiles[i].default_at = resolved(lines, m.profiles[i].default_at);
        resolve_all(lines, m.profiles[i].pass.sites, m.profiles[i].pass.count);
        resolve_all(lines, m.profiles[i].skip.sites, m.profiles[i].skip.count);
        resolve_all(lines, m.profiles[i].relax.sites, m.profiles[i].relax.count);
        i = i + 1;
    }
    i = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        a.at         = resolved(lines, a.at);
        a.default_at = resolved(lines, a.default_at);
        a.export_at  = resolved(lines, a.export_at);
        a.entry_at   = resolved(lines, a.entry_at);
        a.out_at     = resolved(lines, a.out_at);
        a.targets_at = resolved(lines, a.targets_at);
        resolve_all(lines, a.link_at, a.link_count);
        resolve_all(lines, a.need_at, a.need_count);
        i = i + 1;
    }
    i = 0;
    for (i < m.link_count) {
        m.links[i].at      = resolved(lines, m.links[i].at);
        m.links[i].path_at = resolved(lines, m.links[i].path_at);
        i                  = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s: *StepDef = ?m.steps[i];
        s.at = resolved(lines, s.at);
        resolve_all(lines, s.argv_at, s.argv_count);
        resolve_all(lines, s.env_at, s.env_count);
        resolve_all(lines, s.in_at, s.in_count);
        resolve_all(lines, s.out_at, s.out_count);
        resolve_all(lines, s.need_at, s.need_count);
        i = i + 1;
    }
}

fun resolved(lines: *SiteFile, at: fail.Place) fail.Place {
    if (!at.spanned || at.path != nil) { ret at; }
    ret fail.place(lines.path, ?lines.lines, at.span);
}

fun resolve_all(lines: *SiteFile, sites: *fail.Place, count: u32) {
    if (sites == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        sites[i] = resolved(lines, sites[i]);
        i        = i + 1;
    }
}

# the `[project]` table of a parsed TOML document alone, held to its rows as
# `parse` holds it, for a reader such as `mach fmt` that needs nothing else
# ---
# alloc: owns the refusal's text
# itn:   receives the table's strings
# t:     the document root
# m:     receives the project fields
# ret:   ok, or the first refusal
pub fun project_parse(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val shaped: err[fail.Fail] = schema.section_check(alloc, t, "project");
    if (sel shaped.err) { ret shaped; }
    ret parse_project(alloc, itn, t, m);
}

# a manifest's text, the file it was read from, and its TOML tree, all owned
# through the allocator that made it and released with `doc_dnit`. a failure
# that names a key points into `text` at `path`
pub rec Doc {
    path:  str;
    text:  str;
    table: toml.Table;
}

# `text`, the manifest at `path`, as a doc: bytes a manifest refuses and a
# document that is not TOML are failures pointing at the byte refused. the doc
# keeps its own copies of both
pub fun doc_parse(alloc: *A.Allocator, path: str, text: str) res[Doc, fail.Fail] {
    ret doc_parse_bytes(alloc, path, text::*u8, str_len(text));
}

# `doc_parse` over the `n` bytes at `data`, which need not end in a NUL and may
# hold one, which is refused where it is written
pub fun doc_parse_bytes(alloc: *A.Allocator, path: str, data: *u8, n: usize) res[Doc, fail.Fail] {
    val table_r: res[toml.Table, toml.TomlError] = toml.parse_bytes(alloc, data, n);
    if (sel table_r.err) { ret res[Doc, fail.Fail].err{fail.placed_bytes(alloc, fail.toml_refused(table_r.err), path, data, n)}; }
    var table:  toml.Table = table_r.ok;
    var handed: bool       = false;
    fin {
        if (!handed) { toml.dnit(alloc, ?table); }
    }
    val v7: err[A.Error] = v7_read(alloc, ?table);
    if (sel v7.err) { ret res[Doc, fail.Fail].err{fail.refused(v7.err)}; }
    val path_r: res[str, A.Error] = str_dup(alloc, path);
    if (sel path_r.err) { ret res[Doc, fail.Fail].err{fail.refused(path_r.err)}; }
    val path_copy: str = path_r.ok;
    fin {
        if (!handed) { str_free(alloc, path_copy); }
    }
    val text_r: res[str, A.Error] = str_dup_range(alloc, data::str, 0, n);
    if (sel text_r.err) { ret res[Doc, fail.Fail].err{fail.refused(text_r.err)}; }
    handed = true;
    ret res[Doc, fail.Fail].ok{Doc{path: path_r.ok, text: text_r.ok, table: table}};
}

# a v7 manifest's target and link keys, read as the v6 keys this compiler
# decodes, so the bootstrap step that builds the v7 compiler reads both. a table
# is v7 when it writes `arch` or `sys` and no key only v6 writes, and its keys
# are renamed together, so a v7 `isa` becomes `baseline` as `arch` becomes `isa`
val V7_TARGET_FROM: [4]str = [4]str{"isa", "arch", "sys", "ext"};
val V7_TARGET_TO:   [4]str = [4]str{"baseline", "isa", "os", "extensions"};
val V6_TARGET_ONLY: [3]str = [3]str{"os", "baseline", "extensions"};
val V7_LINK_FROM:   [2]str = [2]str{"arch", "sys"};
val V7_LINK_TO:     [2]str = [2]str{"isa", "os"};
val V6_LINK_ONLY:   [2]str = [2]str{"isa", "os"};

fun v7_read(alloc: *A.Allocator, t: *toml.Table) err[A.Error] {
    val targets: err[A.Error] = v7_entries(alloc, t, "target", ?V7_TARGET_FROM[0], ?V7_TARGET_TO[0], 4, ?V6_TARGET_ONLY[0], 3);
    if (sel targets.err) { ret targets; }
    ret v7_entries(alloc, t, "link", ?V7_LINK_FROM[0], ?V7_LINK_TO[0], 2, ?V6_LINK_ONLY[0], 2);
}

fun v7_entries(alloc: *A.Allocator, t: *toml.Table, section: str, from: *str, to: *str, n: usize, only: *str, m: usize) err[A.Error] {
    val tab: opt[*toml.Table] = toml.get_table(t, section);
    if (sel tab.none) { ret err[A.Error].ok{}; }
    var i: usize = 0;
    for (i < toml.table_len(tab.some)) {
        val v: opt[*toml.Value] = toml.table_value(tab.some, i);
        i = i + 1;
        if (sel v.none)                             { cnt; }
        if (v.some.tag != toml.TYPE_TABLE)          { cnt; }
        if (!v7_table(?v.some.data.table, only, m)) { cnt; }
        val renamed: err[A.Error] = v7_rename(alloc, ?v.some.data.table, from, to, n);
        if (sel renamed.err) { ret renamed; }
    }
    ret err[A.Error].ok{};
}

fun v7_table(sub: *toml.Table, only: *str, m: usize) bool {
    val arch: opt[*toml.Value] = toml.get(sub, "arch");
    val sys:  opt[*toml.Value] = toml.get(sub, "sys");
    if ((sel arch.none) && (sel sys.none)) { ret false; }
    var j: usize = 0;
    for (j < m) {
        val v6: opt[*toml.Value] = toml.get(sub, only[j]);
        if (sel v6.some) { ret false; }
        j = j + 1;
    }
    ret true;
}

fun v7_rename(alloc: *A.Allocator, sub: *toml.Table, from: *str, to: *str, n: usize) err[A.Error] {
    val keys: *str  = sub.keys::*str;
    var i:    usize = 0;
    for (i < sub.len) {
        var j: usize = 0;
        for (j < n && !str_equals(keys[i], from[j])) { j = j + 1; }
        if (j < n) {
            val named: res[str, A.Error] = str_dup(alloc, to[j]);
            if (sel named.err) { ret err[A.Error].err{named.err}; }
            str_free(alloc, keys[i]);
            keys[i] = named.ok;
        }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# the manifest file at `path` read and parsed as `doc_parse` parses it; a file
# that cannot be read is the environment's
pub fun doc_read(alloc: *A.Allocator, path: str) res[Doc, fail.Fail] {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) {
        val said: res[str, fail.Fail] = sfmt(alloc, "cannot read '{}': {}", path, fail.fs_text(rb.err));
        if (sel said.err) { ret res[Doc, fail.Fail].err{said.err}; }
        ret res[Doc, fail.Fail].err{fail.owning(fail.environment(diagnostic_kind.FS_READ, said.ok))};
    }
    var bytes: Vector[u8] = rb.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    ret doc_parse_bytes(alloc, path, bytes.data, bytes.len);
}

# the file name of a project manifest, looked up in a project root
pub val MANIFEST_FILE: str = "mach.toml";

# the manifest `text`, read from `path`, parsed and checked
# ---
# alloc: owns the manifest, released with `dnit`, and a refusal's text
# itn:   interns its names
# ret:   the manifest; err as the text does not parse or fails a check
pub fun parse_text(alloc: *A.Allocator, itn: *intern.Interner, path: str, text: str) res[Manifest, fail.Fail] {
    val doc_r: res[Doc, fail.Fail] = doc_parse(alloc, path, text);
    if (sel doc_r.err) { ret res[Manifest, fail.Fail].err{doc_r.err}; }
    var doc: Doc = doc_r.ok;
    fin { doc_dnit(alloc, ?doc); }
    ret parse(alloc, itn, ?doc);
}

# the manifest of the project rooted at `dir`, read off disk and parsed
# ---
# alloc: owns the manifest, released with `dnit`, and a refusal's text
# itn:   interns its names
# dir:   the project root, which holds MANIFEST_FILE
# ret:   the manifest; err from the environment when it cannot be read, else as
#        it does not parse or fails a check
pub fun read_at(alloc: *A.Allocator, itn: *intern.Interner, dir: str) res[Manifest, fail.Fail] {
    val path_r: res[str, A.Error] = types_path.join(alloc, dir, MANIFEST_FILE);
    if (sel path_r.err) { ret res[Manifest, fail.Fail].err{fail.refused(path_r.err)}; }
    val path: str = path_r.ok;
    fin { str_free(alloc, path); }
    val doc_r: res[Doc, fail.Fail] = doc_read(alloc, path);
    if (sel doc_r.err) { ret res[Manifest, fail.Fail].err{doc_r.err}; }
    var doc: Doc = doc_r.ok;
    fin { doc_dnit(alloc, ?doc); }
    ret parse(alloc, itn, ?doc);
}

# release a doc and everything it owns
pub fun doc_dnit(alloc: *A.Allocator, d: *Doc) {
    toml.dnit(alloc, ?d.table);
    if (d.text != nil) { str_free(alloc, d.text); }
    if (d.path != nil) { str_free(alloc, d.path); }
    d.text = nil;
    d.path = nil;
}

fun parse_table(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table) res[Manifest, fail.Fail] {
    val shaped: err[fail.Fail] = schema.check(alloc, t);
    if (sel shaped.err) { ret res[Manifest, fail.Fail].err{shaped.err}; }

    var m:           Manifest = empty();
    var transferred: bool     = false;
    fin {
        if (!transferred) { dnit(?m, alloc); }
    }

    val res_project: err[fail.Fail] = parse_project(alloc, itn, t, ?m);
    if (sel res_project.err) { ret res[Manifest, fail.Fail].err{res_project.err}; }

    val res_targets: err[fail.Fail] = parse_targets(alloc, itn, t, ?m);
    if (sel res_targets.err) { ret res[Manifest, fail.Fail].err{res_targets.err}; }

    val res_artifacts: err[fail.Fail] = parse_artifacts(alloc, itn, t, ?m);
    if (sel res_artifacts.err) { ret res[Manifest, fail.Fail].err{res_artifacts.err}; }

    val res_profiles: err[fail.Fail] = profile.parse_profiles(alloc, itn, t, ?m);
    if (sel res_profiles.err) { ret res[Manifest, fail.Fail].err{res_profiles.err}; }

    val res_deps: err[fail.Fail] = parse_deps(alloc, itn, t, ?m);
    if (sel res_deps.err) { ret res[Manifest, fail.Fail].err{res_deps.err}; }

    val res_links: err[fail.Fail] = parse_links(alloc, itn, t, ?m);
    if (sel res_links.err) { ret res[Manifest, fail.Fail].err{res_links.err}; }

    val res_steps: err[fail.Fail] = parse_steps(alloc, itn, t, ?m);
    if (sel res_steps.err) { ret res[Manifest, fail.Fail].err{res_steps.err}; }

    val res_valid: err[fail.Fail] = validate(alloc, itn, t, ?m);
    if (sel res_valid.err) { ret res[Manifest, fail.Fail].err{res_valid.err}; }

    if (m.target_count == 0) {
        val native: res[*TargetDef, fail.Fail] = make_native_target(alloc, itn);
        if (sel native.err) { ret res[Manifest, fail.Fail].err{native.err}; }
        m.native_target = native.ok;
    }
    transferred = true;
    ret res[Manifest, fail.Fail].ok{m};
}

# the rules that span entries and values of a decoded manifest: every `need`
# entry names a declaration and no `need` chain cycles, every artifact `link`
# names a declared `[link.*]`, at most one profile is the default, at most one
# artifact is exported, and every template names only what its place admits
fun validate(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val needs: err[fail.Fail] = need.validate(alloc, itn, m);
    if (sel needs.err) { ret needs; }
    val links: err[fail.Fail] = link_refs_validate(alloc, itn, m);
    if (sel links.err) { ret links; }
    val profiles: err[fail.Fail] = profile.default_validate(alloc, itn, m);
    if (sel profiles.err) { ret profiles; }
    val exports: err[fail.Fail] = export_validate(alloc, itn, m);
    if (sel exports.err) { ret exports; }
    ret templates_validate(alloc, itn, m);
}

fun link_refs_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var li: u32          = 0;
        for (li < a.link_count) {
            if (find_link_by_name(m, a.link[li]) == nil) {
                val known: res[str, fail.Fail] = link_table_names(alloc, itn, m);
                if (sel known.err) { ret err[fail.Fail].err{known.err}; }
                ret err[fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.LINK_UNKNOWN_TABLE, "mach.toml: [artifact.{}].link names no [link.*] table: '{}' ({})",
                    intern.text(itn, a.name), intern.text(itn, a.link[li]), known.ok), site_of(a.link_at, li))};
            }
            li = li + 1;
        }
        ai = ai + 1;
    }
    ret err[fail.Fail].ok{};
}

# the declared `[link.*]` tables, as an unknown link's refusal lists them
fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) res[str, fail.Fail] {
    if (m.link_count == 0) { ret res[str, fail.Fail].ok{"no [link.*] table is declared"}; }
    var s: str = "declared: ";
    var i: u32 = 0;
    for (i < m.link_count) {
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}[link.{}]", s, sep, intern.text(itn, m.links[i].name));
        if (sel longer.err) { ret longer; }
        s = longer.ok;
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

# every template the manifest writes, checked against the variables its place
# admits; a refusal points at the template
fun templates_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    val work: err[fail.Fail] = template_validate(alloc, itn, m.work_tmpl, template.CONTEXT_PROJECT_WORK, m.work_at);
    if (sel work.err) { ret work; }
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a:       *ArtifactDef   = ?m.artifacts[i];
        val checked: err[fail.Fail] = template_validate(alloc, itn, a.out, template.CONTEXT_ARTIFACT_OUT, a.out_at);
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    i = 0;
    for (i < m.link_count) {
        val l: *LinkDef = ?m.links[i];
        if (l.source == LINK_LOCAL) {
            val checked: err[fail.Fail] = template_validate(alloc, itn, l.path, template.CONTEXT_PATH, l.path_at);
            if (sel checked.err) { ret checked; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.target_count) {
        val t:       *TargetDef     = ?m.targets[i];
        val checked: err[fail.Fail] = templates_validate_each(alloc, itn, t.runner, t.runner_at, t.runner_count, template.CONTEXT_RUNNER);
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s:    *StepDef       = ?m.steps[i];
        val argv: err[fail.Fail] = templates_validate_each(alloc, itn, s.argv, s.argv_at, s.argv_count, template.CONTEXT_STEP_VALUE);
        if (sel argv.err) { ret argv; }
        val envs: err[fail.Fail] = templates_validate_each(alloc, itn, s.env_values, s.env_at, s.env_count, template.CONTEXT_STEP_VALUE);
        if (sel envs.err) { ret envs; }
        val ins: err[fail.Fail] = templates_validate_each(alloc, itn, s.in, s.in_at, s.in_count, template.CONTEXT_PATH);
        if (sel ins.err) { ret ins; }
        val outs: err[fail.Fail] = templates_validate_each(alloc, itn, s.out, s.out_at, s.out_count, template.CONTEXT_PATH);
        if (sel outs.err) { ret outs; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun templates_validate_each(alloc: *A.Allocator, itn: *intern.Interner, ids: *intern.StrId, sites: *fail.Place, count: u32,
    ctx: template.Context) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val checked: err[fail.Fail] = template_validate(alloc, itn, ids[i], ctx, site_of(sites, i));
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun template_validate(alloc: *A.Allocator, itn: *intern.Interner, id: intern.StrId, ctx: template.Context, at: fail.Place) err[fail.Fail] {
    val checked: err[fail.Fail] = template.check(alloc, intern.text(itn, id), ctx);
    if (sel checked.err) { ret err[fail.Fail].err{fail.at(alloc, checked.err, at)}; }
    ret checked;
}
