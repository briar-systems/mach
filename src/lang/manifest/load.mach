# build a `Manifest` from a parsed TOML document, in three stages. the schema
# check holds the document to the rows of `mach.lang.manifest.schema`: a key no
# row names, a value of the wrong shape, a missing required key and a removed key
# are refused where they are written. decoding then reads each table into the
# model and refuses a value its key does not accept. validation last checks the
# rules that span entries and values: `need` entries and their cycles, `link`
# names, at most one `default = true` profile, and every template against what
# its place admits. one rule holds for every key whoever reads the manifest, so
# a dependency's manifest is held to exactly the rules of the project being
# built. on any error every array allocated so far is freed
# ---
# alloc: owns the manifest's arrays
# itn:   receives every string of the manifest
# doc:   the manifest's text and its TOML document
# ret:   the manifest, or the first error as a "mach.toml: ..." message pointing at
#        the key or value in `doc` it concerns. the manifest records where each
#        field a later refusal names is written, resolved in `doc`
pub fun parse(alloc: *A.Allocator, itn: *intern.Interner, doc: *Doc) res[Manifest, fail.Fail] {
    val r: res[Manifest, fail.Fail] = parse_table(alloc, itn, ?doc.table);
    if (sel r.err) { ret res[Manifest, fail.Fail].err{fail.placed(alloc, r.err, doc.path, doc.text)}; }
    var m:    Manifest                     = r.ok;
    val path: res[intern.StrId, fail.Fail] = id_of(itn, doc.path);
    if (sel path.err) {
        dnit(?m, alloc);
        ret res[Manifest, fail.Fail].err{path.err};
    }
    val lines_r: res[lang_source.Lines, A.Error] = lang_source.lines_init(alloc, doc.text::*u8, str_len(doc.text));
    if (sel lines_r.err) {
        dnit(?m, alloc);
        ret res[Manifest, fail.Fail].err{fail.refused(lines_r.err)};
    }
    var lines: SiteFile = SiteFile{path: intern.text(itn, path.ok), lines: lines_r.ok};
    resolve_sites(?lines, ?m);
    lang_source.lines_dnit(alloc, ?lines.lines);
    ret res[Manifest, fail.Fail].ok{m};
}

# the file the model's places are resolved in: its path and its line index
rec SiteFile {
    path:  str;
    lines: lang_source.Lines;
}

# resolve every place the model recorded while parsing in the file `lines` indexes
fun resolve_sites(lines: *SiteFile, m: *Manifest) {
    m.project_at = resolved(lines, m.project_at);
    m.mach_at    = resolved(lines, m.mach_at);
    m.out_at     = resolved(lines, m.out_at);
    var i: u32 = 0;
    for (i < m.target_count) {
        m.targets[i].at = resolved(lines, m.targets[i].at);
        i               = i + 1;
    }
    i = 0;
    for (i < m.profile_count) {
        m.profiles[i].at         = resolved(lines, m.profiles[i].at);
        m.profiles[i].default_at = resolved(lines, m.profiles[i].default_at);
        i                        = i + 1;
    }
    i = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        a.at         = resolved(lines, a.at);
        a.default_at = resolved(lines, a.default_at);
        a.export_at  = resolved(lines, a.export_at);
        a.out_at     = resolved(lines, a.out_at);
        a.targets_at = resolved(lines, a.targets_at);
        resolve_all(lines, a.link_at, a.link_count);
        resolve_all(lines, a.need_at, a.need_count);
        i = i + 1;
    }
    i = 0;
    for (i < m.link_count) {
        m.links[i].at      = resolved(lines, m.links[i].at);
        m.links[i].path_at = resolved(lines, m.links[i].path_at);
        i                  = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s: *StepDef = ?m.steps[i];
        s.at = resolved(lines, s.at);
        resolve_all(lines, s.argv_at, s.argv_count);
        resolve_all(lines, s.env_at, s.env_count);
        resolve_all(lines, s.in_at, s.in_count);
        resolve_all(lines, s.out_at, s.out_count);
        resolve_all(lines, s.need_at, s.need_count);
        i = i + 1;
    }
}

fun resolved(lines: *SiteFile, at: fail.Place) fail.Place {
    if (!at.spanned || at.path != nil) { ret at; }
    ret fail.place(lines.path, ?lines.lines, at.span);
}

fun resolve_all(lines: *SiteFile, sites: *fail.Place, count: u32) {
    if (sites == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        sites[i] = resolved(lines, sites[i]);
        i        = i + 1;
    }
}

# the `[project]` table of a parsed TOML document alone, held to its rows as
# `parse` holds it, for a reader such as `mach fmt` that needs nothing else
# ---
# alloc: owns the refusal's text
# itn:   receives the table's strings
# t:     the document root
# m:     receives the project fields
# ret:   ok, or the first refusal
pub fun project_parse(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val shaped: err[fail.Fail] = schema.section_check(alloc, t, "project");
    if (sel shaped.err) { ret shaped; }
    ret parse_project(alloc, itn, t, m);
}

# a manifest's text, the file it was read from, and its TOML tree, all owned
# through the allocator that made it and released with `doc_dnit`. a failure
# that names a key points into `text` at `path`
pub rec Doc {
    path:  str;
    text:  str;
    table: toml.Table;
}

# `text`, the manifest at `path`, as a doc: bytes a manifest refuses and a
# document that is not TOML are failures pointing at the byte refused. the doc
# keeps its own copies of both
pub fun doc_parse(alloc: *A.Allocator, path: str, text: str) res[Doc, fail.Fail] {
    ret doc_parse_bytes(alloc, path, text::*u8, str_len(text));
}

# `doc_parse` over the `n` bytes at `data`, which need not end in a NUL and may
# hold one, which is refused where it is written
pub fun doc_parse_bytes(alloc: *A.Allocator, path: str, data: *u8, n: usize) res[Doc, fail.Fail] {
    val table_r: res[toml.Table, toml.TomlError] = toml.parse_bytes(alloc, data, n);
    if (sel table_r.err) { ret res[Doc, fail.Fail].err{fail.placed_bytes(alloc, fail.toml_refused(table_r.err), path, data, n)}; }
    var table:  toml.Table        = table_r.ok;
    val path_r: res[str, A.Error] = str_dup(alloc, path);
    if (sel path_r.err) {
        toml.dnit(alloc, ?table);
        ret res[Doc, fail.Fail].err{fail.refused(path_r.err)};
    }
    val text_r: res[str, A.Error] = str_dup_range(alloc, data::str, 0, n);
    if (sel text_r.err) {
        str_free(alloc, path_r.ok);
        toml.dnit(alloc, ?table);
        ret res[Doc, fail.Fail].err{fail.refused(text_r.err)};
    }
    ret res[Doc, fail.Fail].ok{Doc{path: path_r.ok, text: text_r.ok, table: table}};
}

# the manifest file at `path` read and parsed as `doc_parse` parses it; a file
# that cannot be read is the environment's
pub fun doc_read(alloc: *A.Allocator, path: str) res[Doc, fail.Fail] {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) {
        val said: res[str, fail.Fail] = sfmt(alloc, "cannot read '{}': {}", path, fail.fs_text(rb.err));
        if (sel said.err) { ret res[Doc, fail.Fail].err{said.err}; }
        ret res[Doc, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, said.ok)};
    }
    var bytes: Vector[u8] = rb.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    ret doc_parse_bytes(alloc, path, bytes.data, bytes.len);
}

# release a doc and everything it owns
pub fun doc_dnit(alloc: *A.Allocator, d: *Doc) {
    toml.dnit(alloc, ?d.table);
    if (d.text != nil) { str_free(alloc, d.text); }
    if (d.path != nil) { str_free(alloc, d.path); }
    d.text = nil;
    d.path = nil;
}

fun parse_table(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table) res[Manifest, fail.Fail] {
    val shaped: err[fail.Fail] = schema.check(alloc, t);
    if (sel shaped.err) { ret res[Manifest, fail.Fail].err{shaped.err}; }

    var m:           Manifest = empty();
    var transferred: bool     = false;
    fin {
        if (!transferred) { dnit(?m, alloc); }
    }

    val res_project: err[fail.Fail] = parse_project(alloc, itn, t, ?m);
    if (sel res_project.err) { ret res[Manifest, fail.Fail].err{res_project.err}; }

    val res_targets: err[fail.Fail] = parse_targets(alloc, itn, t, ?m);
    if (sel res_targets.err) { ret res[Manifest, fail.Fail].err{res_targets.err}; }

    val res_artifacts: err[fail.Fail] = parse_artifacts(alloc, itn, t, ?m);
    if (sel res_artifacts.err) { ret res[Manifest, fail.Fail].err{res_artifacts.err}; }

    val res_profiles: err[fail.Fail] = profile.parse_profiles(alloc, itn, t, ?m);
    if (sel res_profiles.err) { ret res[Manifest, fail.Fail].err{res_profiles.err}; }

    val res_deps: err[fail.Fail] = parse_deps(alloc, itn, t, ?m);
    if (sel res_deps.err) { ret res[Manifest, fail.Fail].err{res_deps.err}; }

    val res_links: err[fail.Fail] = parse_links(alloc, itn, t, ?m);
    if (sel res_links.err) { ret res[Manifest, fail.Fail].err{res_links.err}; }

    val res_steps: err[fail.Fail] = parse_steps(alloc, itn, t, ?m);
    if (sel res_steps.err) { ret res[Manifest, fail.Fail].err{res_steps.err}; }

    val res_valid: err[fail.Fail] = validate(alloc, itn, t, ?m);
    if (sel res_valid.err) { ret res[Manifest, fail.Fail].err{res_valid.err}; }

    if (m.target_count == 0) {
        val native: res[*TargetDef, fail.Fail] = make_native_target(alloc, itn);
        if (sel native.err) { ret res[Manifest, fail.Fail].err{native.err}; }
        m.native_target = native.ok;
    }
    transferred = true;
    ret res[Manifest, fail.Fail].ok{m};
}

# the rules that span entries and values of a decoded manifest: every `need`
# entry names a declaration and no `need` chain cycles, every artifact `link`
# names a declared `[link.*]`, at most one profile is the default, at most one
# artifact is exported, and every template names only what its place admits
fun validate(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val needs: err[fail.Fail] = need.validate(alloc, itn, m);
    if (sel needs.err) { ret needs; }
    val links: err[fail.Fail] = link_refs_validate(alloc, itn, m);
    if (sel links.err) { ret links; }
    val profiles: err[fail.Fail] = profile.default_validate(alloc, itn, m);
    if (sel profiles.err) { ret profiles; }
    val exports: err[fail.Fail] = export_validate(alloc, itn, m);
    if (sel exports.err) { ret exports; }
    ret templates_validate(alloc, itn, m);
}

fun link_refs_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var li: u32          = 0;
        for (li < a.link_count) {
            if (find_link_by_name(m, a.link[li]) == nil) {
                val known: res[str, fail.Fail] = link_table_names(alloc, itn, m);
                if (sel known.err) { ret err[fail.Fail].err{known.err}; }
                ret err[fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.LINK_UNKNOWN_TABLE, "mach.toml: [artifact.{}].link names no [link.*] table: '{}' ({})",
                    intern.text(itn, a.name), intern.text(itn, a.link[li]), known.ok), site_of(a.link_at, li))};
            }
            li = li + 1;
        }
        ai = ai + 1;
    }
    ret err[fail.Fail].ok{};
}

# the declared `[link.*]` tables, as an unknown link's refusal lists them
fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) res[str, fail.Fail] {
    if (m.link_count == 0) { ret res[str, fail.Fail].ok{"no [link.*] table is declared"}; }
    var s: str = "declared: ";
    var i: u32 = 0;
    for (i < m.link_count) {
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}[link.{}]", s, sep, intern.text(itn, m.links[i].name));
        if (sel longer.err) { ret longer; }
        s = longer.ok;
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

# every template the manifest writes, checked against the variables its place
# admits; a refusal points at the template
fun templates_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    val out: err[fail.Fail] = template_validate(alloc, itn, m.out_tmpl, template.CONTEXT_PROJECT_OUT, m.out_at);
    if (sel out.err) { ret out; }
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a:       *ArtifactDef   = ?m.artifacts[i];
        val checked: err[fail.Fail] = template_validate(alloc, itn, a.out, template.CONTEXT_ARTIFACT_OUT, a.out_at);
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    i = 0;
    for (i < m.link_count) {
        val l: *LinkDef = ?m.links[i];
        if (l.source == LINK_LOCAL) {
            val checked: err[fail.Fail] = template_validate(alloc, itn, l.path, template.CONTEXT_PATH, l.path_at);
            if (sel checked.err) { ret checked; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s:    *StepDef       = ?m.steps[i];
        val argv: err[fail.Fail] = templates_validate_each(alloc, itn, s.argv, s.argv_at, s.argv_count, template.CONTEXT_STEP_VALUE);
        if (sel argv.err) { ret argv; }
        val envs: err[fail.Fail] = templates_validate_each(alloc, itn, s.env_values, s.env_at, s.env_count, template.CONTEXT_STEP_VALUE);
        if (sel envs.err) { ret envs; }
        val ins: err[fail.Fail] = templates_validate_each(alloc, itn, s.in, s.in_at, s.in_count, template.CONTEXT_PATH);
        if (sel ins.err) { ret ins; }
        val outs: err[fail.Fail] = templates_validate_each(alloc, itn, s.out, s.out_at, s.out_count, template.CONTEXT_PATH);
        if (sel outs.err) { ret outs; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun templates_validate_each(alloc: *A.Allocator, itn: *intern.Interner, ids: *intern.StrId, sites: *fail.Place, count: u32,
    ctx: template.Context) err[fail.Fail] {
    var i: u32 = 0;
    for (i < count) {
        val checked: err[fail.Fail] = template_validate(alloc, itn, ids[i], ctx, site_of(sites, i));
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun template_validate(alloc: *A.Allocator, itn: *intern.Interner, id: intern.StrId, ctx: template.Context, at: fail.Place) err[fail.Fail] {
    val checked: err[fail.Fail] = template.check(alloc, intern.text(itn, id), ctx);
    if (sel checked.err) { ret err[fail.Fail].err{fail.at(alloc, checked.err, at)}; }
    ret checked;
}

#[testing]
pub fun demo_src() str {
    ret "[project]\nmach=\">=5\"\nid = \"demo\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.ls]\nkind = \"bin\"\nentry = \"bin/ls.mach\"\nout = \"{project.out}/bin/ls\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.cat]\nkind = \"bin\"\nentry = \"bin/cat.mach\"\nout = \"{project.out}/bin/cat\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[dep.std]\ngit = \"https://github.com/briar-systems/mach-std\"\nref = \"tag/v0.4.0\"\n";
}

#[testing]
pub fun tparse(alloc: *A.Allocator, itn: *intern.Interner, src: str) res[Manifest, fail.Fail] {
    val doc_r: res[Doc, fail.Fail] = doc_parse(alloc, "mach.toml", src);
    if (sel doc_r.err) { ret res[Manifest, fail.Fail].err{doc_r.err}; }
    var doc: Doc                      = doc_r.ok;
    val m:   res[Manifest, fail.Fail] = parse(alloc, itn, ?doc);
    doc_dnit(alloc, ?doc);
    ret m;
}

# one manifest text through the parse: a nil `want` parses, any other is refused
# with a message containing `want` and `also`
#[testing]
rec TManifestCase {
    want: str;
    also: str;
    src:  str;
}

# the debug and release profiles a fixture declares when it is not about profiles
#[testing]
pub fun t_profiles() str {
    ret "[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

# a fixture manifest: `pre`, the profiles of `t_profiles`, then `post`; a refusal
# ends the test
#[testing]
pub fun t_profiled(pre: str, post: str) str {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { panic("a test fixture has no allocator\n"); }
    ret t_fmt(?a, "{}{}{}", pre, t_profiles(), post);
}

# each case writes only the tables it is about, and a case declaring no profile is
# given those of `t_profiles`
#[testing]
val T_MANIFEST_CASES: [62]TManifestCase = [62]TManifestCase{
    TManifestCase{want: "same id as this project", also: "shader.<module>",
        src: "[project]\nmach=\">=5\"\nid=\"shader\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[artifact.a]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"{project.out}/lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[dep.shader]\npath=\"../shader\"\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"app\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[artifact.a]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"{project.out}/lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[dep.shader]\npath=\"../shader\"\n"},
    TManifestCase{want: "mach.toml: [project] is missing required key 'id'", also: nil,
        src: "[project]\nversion=\"1\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "mach.toml: [project] is missing required key 'version'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "mach.toml: unknown key 'name' in [project]", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nname=\"App\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "mach.toml: unknown key 'description' in [project]", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\ndescription=\"d\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "mach.toml: unknown key 'emit_ir' in [profile.debug]", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\nemit_ir=true\n"},
    TManifestCase{want: "mach.toml: unknown key 'emit_asm' in [profile.debug]", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\nemit_asm=true\n"},
    TManifestCase{want: "mach.toml: [artifact.app].link names no [link.*] table: 'nope' (declared: [link.m], [link.z])", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.m]\nsource=\"system\"\nname=\"m\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.z]\nsource=\"system\"\nname=\"z\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"nope\"]\nneed=[]\n"},
    TManifestCase{want: "no [link.*] table is declared", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"nope\"]\nneed=[]\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.m]\nsource=\"system\"\nname=\"m\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.z]\nsource=\"system\"\nname=\"z\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"z\"]\nneed=[]\n"},
    TManifestCase{want: "mach.toml: unknown key 'bogus' in [project]", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nbogus=\"y\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "mach.toml: unknown key 'wat' in [target.l]", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\nwat=\"z\"\n"},
    TManifestCase{want: "mach.toml: unknown table or key 'bogus_top_level_table' at the document root", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[bogus_top_level_table]\nk = 1\n"},
    TManifestCase{want: "mach.toml: unknown table or key 'stray' at the document root", also: nil,
        src: "stray = true\n[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "must use 'step.<name>' or 'artifact.<name>'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.twin]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/twin.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[]\n[step.twin]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"twin\"]\n"},
    TManifestCase{want: "need entry 'artifact.nothing-*' matches no declaration in its category", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/a.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[]\n[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.nothing-*\"]\n"},
    TManifestCase{want: "need entry 'artifact.ghost' matches no declaration in its category", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.ghost\"]\n"},
    TManifestCase{want: "[artifact.app].need requires itself", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.app\"]\n"},
    TManifestCase{want: "must use 'step.<name>' or 'artifact.<name>'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"../step\"]\n"},
    TManifestCase{want: "need entry 'artifact.a*' matches no declaration in its category", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.a*\"]\n"},
    TManifestCase{want: "mach.toml: 'need' cycle: artifact.a -> artifact.b -> artifact.a", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/a.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.b\"]\n[artifact.b]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/b.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.a\"]\n"},
    TManifestCase{want: "mach.toml: 'need' cycle: artifact.a -> artifact.b -> artifact.c -> artifact.a", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/a.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.b\"]\n[artifact.b]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/b.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.c\"]\n[artifact.c]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/c.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.a\"]\n"},
    TManifestCase{want: "mach.toml: 'need' cycle: artifact.pack-a -> artifact.pack-b -> artifact.pack-a", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.pack-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/pa.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.pack-b\"]\n[artifact.pack-b]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/pb.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.pack-*\"]\n"},
    TManifestCase{want: "mach.toml: 'need' cycle: step.a -> step.b -> step.a", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"step.a\"]\n[step.a]\nargv=[\"x\"]\nin=[\"i\"]\nout=[\"{project.out}/a.o\"]\nneed=[\"step.b\"]\n[step.b]\nargv=[\"y\"]\nin=[\"i\"]\nout=[\"{project.out}/b.o\"]\nneed=[\"step.a\"]\n"},
    TManifestCase{want: "mach.toml: [target.native] is reserved; 'native' resolves to a declared target", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.native]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "mach.toml: [dep.std].version = \"1.0\": a clause needs an operator, such as ^1.2 or >=1.2 (clause 1)", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.std]\ngit=\"u\"\nversion=\"1.0\"\n"},
    TManifestCase{want: "names both 'ref' and 'version'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"tag/v1\"\nversion=\"^1\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n"},
    TManifestCase{want: "a path dependency has none", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\npath=\"../std\"\nversion=\"^1\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nversion=\"^1.2, <1.9\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n"},
    TManifestCase{want: "mach.toml: [dep.std] needs exactly one source key: 'git' or 'path'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.std]\ngit=\"u\"\npath=\"p\"\n"},
    TManifestCase{want: "missing required key 'ref'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\n"},
    TManifestCase{want: "not allowed for path sources", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\npath=\"../std\"\nref=\"branch/main\"\n"},
    TManifestCase{want: "branch/<name>", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"main\"\n"},
    TManifestCase{want: "full-object-id", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/01234567\"\n"},
    TManifestCase{want: "", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"branch/.hidden\"\n"},
    TManifestCase{want: "", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"tag/release.lock\"\n"},
    TManifestCase{want: "", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789ABCDEF0123456789ABCDEF01234567\"\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"branch/main\"\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[dep.std]\ngit=\"u\"\nref=\"commit/0123456789abcdef0123456789abcdef01234567\"\n"},
    TManifestCase{want: "dependency name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[dep.\"../escape\"]\npath=\"../lib\"\n"},
    TManifestCase{want: "target name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.\"../escape\"]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "artifact name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.\"../escape\"]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\n"},
    TManifestCase{want: "profile name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.\"../escape\"]\n"},
    TManifestCase{want: "link name '../escape' must be a portable identifier", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.\"../escape\"]\nsource=\"local\"\npath=\"obj/a.o\"\n"},
    TManifestCase{want: "mach.toml: [project].src contains a '\\\\'; manifest paths use '/'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"a\\\\b\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "must not contain '.' or '..'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"../src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "must be relative to the project root", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"/tmp/out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "empty path component", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src//lib\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "absolute drive path", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"C:/out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "opt must be 0, 1, or 2", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\nopt = 9\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n"},
    TManifestCase{want: "debug must be a boolean", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\nopt = 0\ndebug = 9\nvectorize = true\nfloat_reassoc = false\n"},
    TManifestCase{want: "", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"a/b\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"a-b_2\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n"},
    TManifestCase{want: "", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[step.s]\nargv=[\"cc\"]\nin=[\"a.c\"]\nout=[\"{project.out}/*.o\"]\nneed=[]\n"},
    TManifestCase{want: "non-canonical value 'windoze'", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.l]\nsource=\"system\"\nname=\"c\"\nos=[\"windoze\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.a]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/a\"\ntargets=[\"*\"]\nlink=[\"c\"]\nneed=[]\n[link.c]\nsource=\"system\"\nname=\"c\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"},
    TManifestCase{want: "mach.toml: [link.bad].os must be an array of strings", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=1\n"},
    TManifestCase{want: "mach.toml: [link.bad] uses removed key 'library'; the table key is the library's identity, and #[library] names the entry by that key", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nlibrary=\"\"\n"},
    TManifestCase{want: "mach.toml: [link.bad] uses removed key 'library'; the table key is the library's identity, and #[library] names the entry by that key", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nlibrary=\"a\"\n"},
    TManifestCase{want: "mach.toml: [link.bad].os must be an array of strings", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=\"linux\"\nisa=[\"*\"]\nabi=[\"*\"]\n"},
    TManifestCase{want: "mach.toml: [link.bad].os has non-canonical value ''; use a canonical value or \"*\"", also: nil,
        src: "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=[\"\"]\nisa=[\"*\"]\nabi=[\"*\"]\n"},
};

test parse__accepts_or_refuses_each_manifest_as_its_case_states {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    var i: usize = 0;
    for (i < 62) {
        val c:   *TManifestCase = ?T_MANIFEST_CASES[i];
        var src: str            = c.src;
        if (!str_contains(src, "[profile")) { src = t_profiled(src, ""); }
        val r:   res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
        var bad: bool                     = sel r.ok;
        var msg: str                      = "parsed";
        if (sel r.err)     { msg = fail.describe(r.err); }
        if (c.want == nil) { bad = sel r.err; }
        or (sel r.err)     { bad = (!str_equals(c.want, "") && !str_contains(msg, c.want)) || (c.also != nil && !str_contains(msg, c.also)); }
        if (bad) {
            print.eprintlnf("manifest case {}: {}", i, msg);
            ret 2;
        }
        i = i + 1;
    }
    ret 0;
}

# [project].mach is a required version range: a valid one is kept, an absent one, a bare
# version (the form the key once took) and a non-string are refused with the reason
test parse__project_mach_is_a_checked_version_range {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32                      = 0;
    val head: str                      = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val tail: str                      = "[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val good: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}mach=\">=5.2, <7\"\n{}", head, tail));
    if (sel good.err) { code = 2; }
    if (sel good.ok) {
        var m:    Manifest = good.ok;
        val text: opt[str] = intern.get(?itn, m.mach);
        if (sel text.none) { code = 3; }
        if (sel text.some) {
            if (!str_equals(text.some, ">=5.2, <7")) { code = 4; }
        }
        dnit(?m, ?alloc);
    }
    val absent: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, tail));
    if (sel absent.ok) { code = 5; }
    if (sel absent.err) {
        if (!str_equals(fail.describe(absent.err), "mach.toml: [project] is missing required key 'mach'")) { code = 6; }
    }
    val bare: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}mach=\"4.14.0\"\n{}", head, tail));
    if (sel bare.ok) { code = 7; }
    if (sel bare.err) {
        if (!str_equals(fail.describe(bare.err), "mach.toml: [project].mach = \"4.14.0\": a clause needs an operator, such as ^1.2 or >=1.2 (clause 1)")) { code = 8; }
    }
    val number: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}mach=5\n{}", head, tail));
    if (sel number.ok) { code = 9; }
    if (sel number.err) {
        if (!str_equals(fail.describe(number.err), "mach.toml: [project].mach must be a non-empty string")) { code = 10; }
    }
    arena.dnit(?ar);
    ret code;
}

#[testing]
pub fun need_head() str {
    ret t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n", "");
}

#[testing]
pub fun need_artifact(alloc: *A.Allocator, name: str, out: str, needs: str) str {
    ret t_fmt(alloc, "[artifact.{}]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{{project.out}}/lib/{}.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[{}]\n", name, out, needs);
}

#[testing]
pub fun need_err(alloc: *A.Allocator, itn: *intern.Interner, src: str, needle: str) bool {
    val r: res[Manifest, fail.Fail] = tparse(alloc, itn, src);
    if (sel r.ok) { ret false; }
    ret str_contains(fail.describe(r.err), needle);
}

test parse__step_argv_and_env_contract {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");

    val valid: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=['\"quoted\"',\"'single'\",'semi;$|&<>*?[]','{\"x\":1}',\"{\\\"escaped\\\":true}\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE='literal;$|&<>*?[]'\nJSON=\"{\\\"x\\\":1}\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        var m: Manifest = valid.ok;
        if (m.step_count != 1 || m.steps[0].argv_count != 5 || m.steps[0].env_count != 2) { code = 1; }
        or {
            if (!str_equals(intern.text(?itn, m.steps[0].argv[0]), "\"quoted\""))                                                                                 { code = 1; }
            if (!str_equals(intern.text(?itn, m.steps[0].argv[1]), "'single'"))                                                                                   { code = 1; }
            if (!str_equals(intern.text(?itn, m.steps[0].argv[2]), "semi;$|&<>*?[]"))                                                                             { code = 1; }
            if (!str_equals(intern.text(?itn, m.steps[0].argv[3]), "{\"x\":1}"))                                                                                  { code = 1; }
            if (!str_equals(intern.text(?itn, m.steps[0].argv[4]), "{\"escaped\":true}"))                                                                         { code = 1; }
            if (!str_equals(intern.text(?itn, m.steps[0].env_keys[0]), "JSON") || !str_equals(intern.text(?itn, m.steps[0].env_values[0]), "{\"x\":1}"))          { code = 1; }
            if (!str_equals(intern.text(?itn, m.steps[0].env_keys[1]), "VALUE") || !str_equals(intern.text(?itn, m.steps[0].env_values[1]), "literal;$|&<>*?[]")) { code = 1; }
        }
    }

    val empty: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty.err && str_contains(fail.describe(empty.err), ".argv must be nonempty"))) { code = 1; }

    val empty_program: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty_program.err && str_contains(fail.describe(empty_program.err), "argv[0] must name an executable"))) { code = 1; }

    val cmd: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\ncmd=\"true\"\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel cmd.err && str_contains(fail.describe(cmd.err), "uses removed key 'cmd'"))) { code = 1; }

    val shell: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nshell=true\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel shell.err && str_contains(fail.describe(shell.err), "uses removed key 'shell'"))) { code = 1; }

    val env_type: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={VALUE=1}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_type.err && str_contains(fail.describe(env_type.err), ".env.VALUE must be a string"))) { code = 1; }

    val env_equals: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={\"A=B\"=\"x\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_equals.err && str_contains(fail.describe(env_equals.err), "env key 'A=B' must be nonempty and cannot contain '='"))) { code = 1; }

    val env_ambiguous: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={PATH=\"a\",Path=\"b\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_ambiguous.err && str_contains(fail.describe(env_ambiguous.err), "ambiguous keys"))) { code = 1; }

    val env_order_a: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={z=\"last\",B=\"middle\",a=\"first\"}\nin=[]\nout=[]\nneed=[]\n"));
    val env_order_b: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={a=\"first\",z=\"last\",B=\"middle\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (sel env_order_a.ok) {
        if (sel env_order_b.ok) {
            val ma: Manifest = env_order_a.ok;
            val mb: Manifest = env_order_b.ok;
            var ei: u32      = 0;
            for (ei < ma.steps[0].env_count && ei < mb.steps[0].env_count) {
                if (!intern.str_same(ma.steps[0].env_keys[ei], mb.steps[0].env_keys[ei]))     { code = 1; }
                if (!intern.str_same(ma.steps[0].env_values[ei], mb.steps[0].env_values[ei])) { code = 1; }
                ei = ei + 1;
            }
            if (!str_equals(intern.text(?itn, ma.steps[0].env_keys[0]), "a"))        { code = 1; }
            if (!str_equals(intern.text(?itn, ma.steps[0].env_values[0]), "first"))  { code = 1; }
            if (!str_equals(intern.text(?itn, ma.steps[0].env_keys[1]), "B"))        { code = 1; }
            if (!str_equals(intern.text(?itn, ma.steps[0].env_values[1]), "middle")) { code = 1; }
            if (!str_equals(intern.text(?itn, ma.steps[0].env_keys[2]), "z"))        { code = 1; }
            if (!str_equals(intern.text(?itn, ma.steps[0].env_values[2]), "last"))   { code = 1; }
        }
        if (sel env_order_b.err) { code = 1; }
    }
    if (sel env_order_a.err) { code = 1; }

    val argv_nul: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"pre\\u0000post\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel argv_nul.err && str_contains(fail.describe(argv_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_key_nul: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"A\\u0000B\"=\"x\"\n"));
    if (!(sel env_key_nul.err && str_contains(fail.describe(env_key_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_value_nul: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE=\"pre\\U00000000post\"\n"));
    if (!(sel env_value_nul.err && str_contains(fail.describe(env_value_nul.err), "cannot contain NUL"))) { code = 1; }

    val literal_escape: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=['pre\\u0000post']\nin=[]\nout=[]\nneed=[]\n"));
    if (sel literal_escape.err) { code = 1; }

    val timeout: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\ntimeout=\"5m\"\n"));
    if (sel timeout.err) { code = 1; }
    if (sel timeout.ok) {
        val mt: Manifest = timeout.ok;
        if (mt.steps[0].timeout != chrono_duration.MINUTE * 5) { code = 1; }
    }

    val timeout_bare: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\ntimeout=30\n"));
    if (!(sel timeout_bare.err && str_contains(fail.describe(timeout_bare.err), ".timeout must be a non-empty string"))) { code = 1; }

    val timeout_seconds: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\ntimeout_seconds=30\n"));
    if (!(sel timeout_seconds.err && str_contains(fail.describe(timeout_seconds.err), "unknown key 'timeout_seconds'"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

# a manifest refused after arrays of an earlier entry were built releases every one of them
# a refused allocation anywhere in a parse is the parse's failure: never a
# manifest holding a nil id or an empty name, and nothing is stranded
test parse__every_refused_allocation_fails_the_parse {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val src:      str   = demo_src();
    var attempts: usize = 0;
    var ordinal:  usize = 0;
    for (ordinal <= attempts) {
        val before: usize = T.attempt_count(?t);
        if (ordinal > 0) { T.fail_at_ordinal(?t, before + ordinal); }
        var itn: intern.Interner          = intern.init(T.allocator_of(?t));
        val r:   res[Manifest, fail.Fail] = tparse(T.allocator_of(?t), ?itn, src);
        if (ordinal == 0) {
            if (sel r.err) { ret 2; }
            attempts = T.attempt_count(?t) - before;
        }
        or (sel r.ok) { ret 3; }
        if (sel r.err) {
            if (ordinal > 0 && !str_equals(fail.describe(r.err), "out of memory")) { ret 4; }
        }
        if (sel r.ok) {
            var m: Manifest = r.ok;
            dnit(?m, T.allocator_of(?t));
        }
        intern.dnit(?itn);
        T.fail_at_ordinal(?t, 0);
        if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 5; }
        ordinal = ordinal + 1;
    }
    if (attempts < 10) { ret 6; }
    ret 0;
}

test parse__a_late_error_releases_the_owned_arrays {
    var srcs: [3]str = [3]str{
        t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\",\"arg\"]\nenv={A=\"one\",B=\"two\"}\nin=[\"src\"]\nout=[\"../escape\"]\nneed=[]\n", ""),
        t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.a]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/a\"\ntargets=[\"t1\",\"t2\"]\nlink=[\"l1\"]\nneed=[]\n[artifact.b]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"{project.out}/lib/b\"\ntargets=[\"t1\"]\nlink=[\"l1\",\"l2\"]\nneed=[\"artifact.a\"]\nicon=\"icon.ico\"\n[artifact.c]\nkind=\"bin\"\nentry=\"c.mach\"\nout=\"{project.out}/bin/c\"\ntargets=[\"t1\"]\nlink=[]\nneed=[]\n", ""),
        t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.a]\nsource=\"system\"\nname=\"foo\"\nsymbols=[\"sym1\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[link.b]\nsource=\"system\"\nname=\"bar\"\nsymbols=[\"sym2\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.c]\nsource=\"system\"\nname=\"baz\"\nsymbols=[\"sym3\",\"sym3\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n", "")
    };
    var wants: [3]str = [3]str{"must not contain '.' or '..' path components", "icon and .manifest apply only to kind = \"bin\"", "lists 'sym3' twice"};
    var i:     usize  = 0;
    for (i < 3) {
        var t:    T.Testing;
        val made: err[A.Error] = T.make(?t);
        if (sel made.err) { ret 1; }
        val alloc: *A.Allocator             = T.allocator_of(?t);
        var itn:   intern.Interner          = intern.init(alloc);
        val r:     res[Manifest, fail.Fail] = tparse(alloc, ?itn, srcs[i]);
        if (sel r.ok) {
            intern.dnit(?itn);
            T.dnit(?t);
            ret 2;
        }
        val named: bool = str_contains(fail.describe(r.err), wants[i]);
        fail.dnit(alloc, r.err);
        intern.dnit(?itn);
        val released: bool = T.clean(?t);
        T.dnit(?t);
        if (!named)    { ret 3; }
        if (!released) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test parse__an_env_intern_failure_aborts_the_step {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var base:     intern.Interner          = intern.init(?alloc);
    val head:     str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n", "");
    val seeded_r: res[Manifest, fail.Fail] = tparse(?alloc, ?base, head);
    if (sel seeded_r.err) {
        intern.dnit(?base);
        ret 1;
    }
    var seeded: Manifest = seeded_r.ok;
    dnit(?seeded, ?alloc);

    val source: str                 = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nUNSEEDED=\"value\"\n", "");
    val doc_r:  res[Doc, fail.Fail] = doc_parse(?alloc, "mach.toml", source);
    if (sel doc_r.err) {
        intern.dnit(?base);
        ret 1;
    }
    var doc: Doc = doc_r.ok;

    var refusing: T.Testing;
    val made:     err[A.Error] = T.make(?refusing);
    if (sel made.err) {
        doc_dnit(?alloc, ?doc);
        intern.dnit(?base);
        ret 1;
    }
    T.fail_from_ordinal(?refusing, 1);
    var child:  intern.Interner          = intern.child_init(?base, T.allocator_of(?refusing));
    val parsed: res[Manifest, fail.Fail] = parse(?alloc, ?child, ?doc);
    doc_dnit(?alloc, ?doc);
    val bad: bool = sel parsed.ok || child.len != 0;
    intern.dnit(?child);
    intern.dnit(?base);
    T.dnit(?refusing);
    if (bad) { ret 1; }
    ret 0;
}

test parse__artifact_subsystem_defaults_to_console {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val a: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, art));
    if (sel a.err) { code = 1; }
    if (sel a.ok) {
        if (a.ok.artifacts[0].subsystem != catalog_subsystem.CONSOLE || a.ok.artifacts[0].subsystem_declared) { code = 1; }
    }

    val b: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, art, "subsystem=\"gui\"\n"));
    if (sel b.err) { code = 1; }
    if (sel b.ok) {
        if (b.ok.artifacts[0].subsystem != catalog_subsystem.GUI || !b.ok.artifacts[0].subsystem_declared) { code = 1; }
    }

    val c: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, art, "subsystem=\"console\"\n"));
    if (sel c.err) { code = 1; }
    if (sel c.ok) {
        if (c.ok.artifacts[0].subsystem != catalog_subsystem.CONSOLE) { code = 1; }
    }

    val d: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, art, "subsystem=\"windows\"\n"));
    if (!(sel d.err && str_contains(fail.describe(d.err), "subsystem must be \"console\" or \"gui\""))) { code = 1; }

    val e: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, art, "subsystem=2\n"));
    if (!(sel e.err && str_contains(fail.describe(e.err), "subsystem must be a non-empty string"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test parse__artifact_icon_and_manifest_keys {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");
    val bin:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val absent: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, bin));
    if (sel absent.err) { code = 1; }
    if (sel absent.ok) {
        val a: ArtifactDef = absent.ok.artifacts[0];
        if (!intern.str_is_nil(a.icon) || !intern.str_is_nil(a.app_manifest)) { code = 1; }
    }

    val valid: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        t_fmt(?alloc, "{}{}{}", head, bin, "icon=\"assets/app.ico\"\nmanifest=\"assets/app.manifest\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        val a:  ArtifactDef = valid.ok.artifacts[0];
        val io: opt[str]    = intern.get(?itn, a.icon);
        val mo: opt[str]    = intern.get(?itn, a.app_manifest);
        if (!(sel io.some && str_equals(io.some, "assets/app.ico")))      { code = 1; }
        if (!(sel mo.some && str_equals(mo.some, "assets/app.manifest"))) { code = 1; }
    }

    val empty_icon: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        t_fmt(?alloc, "{}{}{}", head, bin, "icon=\"\"\n"));
    if (!(sel empty_icon.err && str_contains(fail.describe(empty_icon.err), ".icon must be a non-empty string"))) { code = 1; }

    val wrong_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        t_fmt(?alloc, "{}{}{}", head, bin, "manifest=42\n"));
    if (!(sel wrong_manifest.err && str_contains(fail.describe(wrong_manifest.err), ".manifest must be a non-empty string"))) { code = 1; }

    val backslash: res[Manifest, fail.Fail] = tparse(?alloc, ?itn,
        t_fmt(?alloc, "{}{}{}", head, bin, "icon=\"assets\\\\app.ico\"\n"));
    if (!(sel backslash.err && str_contains(fail.describe(backslash.err), "manifest paths use '/'"))) { code = 1; }

    val static_art: str                      = "[artifact.lib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"{project.out}/lib/x.a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\nicon=\"assets/app.ico\"\n";
    val irrelevant: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, static_art));
    if (!(sel irrelevant.err && str_contains(fail.describe(irrelevant.err), "apply only to kind = \"bin\" artifacts"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test parse__target_platform_and_base {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.bmos]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\nplatform=\"bmos\"\nbase=0xFFFF800000000000\n[target.plain]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n", "");
    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest   = res_manifest.ok;
        val tb: *TargetDef = find_target_by_name(?itn, ?m, "bmos");
        val tp: *TargetDef = find_target_by_name(?itn, ?m, "plain");
        if (tb == nil || tp == nil) { code = 1; }
        or {
            if (!str_equals(intern.text(?itn, tb.platform), "bmos")) { code = 1; }
            if (tb.base != 0xFFFF800000000000)                       { code = 1; }
            if (!intern.str_is_nil(tp.platform))                     { code = 1; }
            if (tp.base != 0)                                        { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test link_matches_target__string_array_star_and_empty_filters {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.arm]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[link.os_str]\nsource=\"system\"\nname=\"a\"\nos=[\"linux\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.os_arr]\nsource=\"system\"\nname=\"b\"\nos=[\"linux\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.os_star]\nsource=\"system\"\nname=\"c\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.isa_str]\nsource=\"system\"\nname=\"e\"\nos=[\"*\"]\nisa=[\"x86_64\"]\nabi=[\"*\"]\n[link.abi_str]\nsource=\"system\"\nname=\"f\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"sysv64\"]\n[link.none]\nsource=\"system\"\nname=\"g\"\nos=[]\nisa=[\"*\"]\nabi=[\"*\"]\n", "");
    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;

        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        val ta: *TargetDef = find_target_by_name(?itn, ?m, "arm");
        if (tl == nil || tw == nil || ta == nil) { code = 1; }
        or {
            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "os_str"), tw))  { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_arr"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "os_arr"), tw))  { code = 1; }

            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_star"), tw)) { code = 1; }

            if (!link_matches_target(?itn, find_link(?itn, ?m, "isa_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "isa_str"), ta))  { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "abi_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "abi_str"), tw))  { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), tl))     { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), ta))     { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

# one rule per key holds in every manifest: a required key is refused when it is
# missing, and a key whose absence means it does not apply may be left out
test parse__every_manifest_declares_its_required_keys_and_may_omit_the_rest {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:               i32 = 0;
    val bare:               str = "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val head:               str = t_profiled(bare, "");
    val no_profile_message: str = "mach.toml: missing [profile] table; a build needs an explicit [profile.<name>] declaring opt, debug, simd, vectorize and float_reassoc";

    val no_profile: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, bare);
    if (!(sel no_profile.err && str_equals(fail.describe(no_profile.err), no_profile_message))) { code = 2; }
    val empty_profile: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", bare, "[profile]\n"));
    if (!(sel empty_profile.err && str_equals(fail.describe(empty_profile.err), no_profile_message))) { code = 3; }

    var keys: [5]str;
    keys[0] = "opt";
    keys[1] = "debug";
    keys[2] = "simd";
    keys[3] = "vectorize";
    keys[4] = "float_reassoc";
    var partial: [5]str;
    partial[0] = "[profile.p]\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    partial[1] = "[profile.p]\nopt=0\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    partial[2] = "[profile.p]\nopt=0\ndebug=false\nvectorize=true\nfloat_reassoc=false\n";
    partial[3] = "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=false\n";
    partial[4] = "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\n";
    var ki: usize = 0;
    for (ki < 5) {
        val r:    res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", bare, partial[ki]));
        val want: str                      = t_fmt(?alloc, "mach.toml: [profile.p] is missing required key '{}'; a profile declares opt, debug, simd, vectorize and float_reassoc", keys[ki]);
        if (!(sel r.err && str_equals(fail.describe(r.err), want))) { code = 4; }
        ki = ki + 1;
    }
    val p_simd_bad: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", bare, "[profile.p]\nopt=0\ndebug=false\nsimd=\"bogus\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel p_simd_bad.err && str_contains(fail.describe(p_simd_bad.err), "simd must be \"scalarize\" or \"require\""))) { code = 5; }

    val l_os: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\n"));
    if (!(sel l_os.err && str_contains(fail.describe(l_os.err), "missing required key 'os'"))) { code = 6; }
    val l_isa: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=[\"*\"]\n"));
    if (!(sel l_isa.err && str_contains(fail.describe(l_isa.err), "missing required key 'isa'"))) { code = 7; }
    val l_abi: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=[\"*\"]\nisa=[\"*\"]\n"));
    if (!(sel l_abi.err && str_contains(fail.describe(l_abi.err), "missing required key 'abi'"))) { code = 8; }
    val d_ref: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, "[dep.d]\ngit=\"u\"\n"));
    if (!(sel d_ref.err && str_contains(fail.describe(d_ref.err), "missing required key 'ref' or 'version' for git source"))) { code = 9; }

    # an artifact with no link or need, a link with no export and a step with no need
    val optional: str                      = "[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[artifact.a]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/a\"\ntargets=[\"*\"]\n[link.l]\nsource=\"system\"\nname=\"c\"\nos=[\"windows\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[step.s]\nargv=[\"c\"]\nin=[\"i\"]\nout=[\"o\"]\n";
    val omitted:  res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head, optional));
    if (sel omitted.err) { code = 10; }
    if (sel omitted.ok) {
        var m:  Manifest   = omitted.ok;
        val l:  *LinkDef   = find_link(?itn, ?m, "l");
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        if (m.artifact_count != 1 || m.artifacts[0].link_count != 0 || m.artifacts[0].need_count != 0) { code = 11; }
        if (m.step_count != 1 || m.steps[0].need_count != 0)                                           { code = 12; }
        if (l == nil || tl == nil || tw == nil)                                                        { code = 13; }
        or {
            if (l.export)                          { code = 14; }
            if (!link_matches_target(?itn, l, tw)) { code = 15; }
            if (link_matches_target(?itn, l, tl))  { code = 16; }
        }
    }

    arena.dnit(?ar);
    ret code;
}

test parse__link_symbols {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");

    val none: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel none.err) { code = 1; }
    if (sel none.ok) {
        val m: Manifest = none.ok;
        if (m.links[0].symbol_count != 0 || m.links[0].symbols != nil) { code = 1; }
    }

    val two: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"ExitProcess\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel two.err) { code = 1; }
    if (sel two.ok) {
        val m: Manifest = two.ok;
        if (m.links[0].symbol_count != 2) { code = 1; }
        or {
            if (!str_equals(intern.text(?itn, m.links[0].symbols[0]), "Sleep"))       { code = 1; }
            if (!str_equals(intern.text(?itn, m.links[0].symbols[1]), "ExitProcess")) { code = 1; }
        }
    }

    val scalar: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=\"Sleep\"\n"));
    if (!(sel scalar.err && str_equals(fail.describe(scalar.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val typed: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",1]\n"));
    if (!(sel typed.err && str_equals(fail.describe(typed.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val blank: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n"));
    if (!(sel blank.err && str_equals(fail.describe(blank.err), "mach.toml: [link.k].symbols has an empty symbol name"))) { code = 1; }

    val dup: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"Sleep\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n"));
    if (!(sel dup.err && str_equals(fail.describe(dup.err), "mach.toml: [link.k].symbols lists 'Sleep' twice"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test parse__link_include {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");

    val default_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel default_r.err) { code = 1; }
    if (sel default_r.ok) {
        val m: Manifest = default_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val always_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"always\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel always_r.err) { code = 1; }
    if (sel always_r.ok) {
        val m: Manifest = always_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val referenced_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"referenced\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel referenced_r.err) { code = 1; }
    if (sel referenced_r.ok) {
        val m: Manifest = referenced_r.ok;
        if (!m.links[0].include_referenced) { code = 1; }
    }

    val bad_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"sometimes\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel bad_r.err && str_equals(fail.describe(bad_r.err), "mach.toml: [link.k].include must be \"always\" or \"referenced\""))) { code = 1; }

    val typed_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=1\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel typed_r.err && str_equals(fail.describe(typed_r.err), "mach.toml: [link.k].include must be a non-empty string"))) { code = 1; }

    val dep_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"libdemo\"\ninclude=\"referenced\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n"));
    if (sel dep_r.err) { code = 1; }
    if (sel dep_r.ok) {
        val m: Manifest = dep_r.ok;
        if (!m.links[0].include_referenced || !m.links[0].export) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test parse__several_profile_defaults_and_a_target_default_are_refused {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head: str = "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n";
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val lx:   str = "[target.lx]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n";
    val mac:  str = "[target.mac]\nisa=\"x86_64\"\nos=\"darwin\"\nabi=\"sysv64\"\ndefault=true\n";

    # a target has no default: with no -t a command takes the target matching the host
    val marked: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}{}", head, lx, mac, art));
    if (sel marked.ok) { code = 1; }
    if (sel marked.err) {
        if (fail.kind_of(marked.err) != diagnostic_kind.MANIFEST_REMOVED_KEY
            || !str_contains(fail.describe(marked.err), "[target.mac] uses removed key 'default'")) { code = 1; }
    }

    val pa:       str                      = "[profile.fast]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val pb:       str                      = "[profile.slow]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val profiles: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}{}{}", head, lx, art, pa, pb));
    if (sel profiles.ok) { code = 1; }
    if (sel profiles.err) {
        val msg: str = fail.describe(profiles.err);
        if (!str_contains(msg, "2 profiles declare `default = true` ([profile.fast], [profile.slow])")
            || !str_contains(msg, "exactly one is allowed")) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test parse__target_env_is_carried_verbatim {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32                      = 0;
    val head: str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");
    val art:  str                      = "[artifact.k]\nkind=\"bin\"\nentry=\"k.mach\"\nout=\"{project.out}/k.spv\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val gpu:  str                      = "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=\"vulkan1.2\"\n";
    val r:    res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, gpu, art));
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        val m: Manifest = r.ok;
        if (m.target_count != 1 || !str_equals(intern.text(?itn, m.targets[0].env), "vulkan1.2")) { code = 1; }
    }
    val plain: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\n", art));
    if (!(sel plain.ok && intern.str_is_nil(plain.ok.targets[0].env))) { code = 1; }
    val bad: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, "[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\nenv=3\n", art));
    if (!(sel bad.err && str_contains(fail.describe(bad.err), "env must be a non-empty string"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test parse__isa_spellings_resolve_as_written {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val head: str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");
    val art:  str                      = "[artifact.k]\nkind=\"bin\"\nentry=\"k.mach\"\nout=\"{project.out}/k\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val rows: str                      = "[target.wide]\nisa=\"rv64gc\"\nos=\"linux\"\nabi=\"lp64d\"\n[target.narrow]\nisa=\"rv32imac\"\nos=\"freestanding\"\nabi=\"ilp32\"\n";
    val r:    res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", head, rows, art));
    if (sel r.err) { ret 2; }
    val m: Manifest = r.ok;
    if (m.target_count != 2) { ret 3; }

    var i: u32 = 0;
    for (i < 2) {
        val d:        *TargetDef                          = ?m.targets[i];
        val isa_name: str                                 = intern.text(?itn, d.isa);
        val t_r:      res[lang_target.Binding, fail.Fail] = lang_target.t_select(isa_name, intern.text(?itn, d.os), intern.text(?itn, d.abi));
        if (sel t_r.err) { ret 5; }
        var buf: [32]u8;
        if (!str_equals(lang_target.selection_spelling(t_r.ok.isa, ?t_r.ok.target.model, ?buf[0], 32), isa_name)) { ret 6; }
        i = i + 1;
    }
    ret 0;
}

test parse__windows_env_names_cannot_alias_across_case {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val source: str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"MACH_ÄΩ\"=\"first\"\n\"mach_äω\"=\"second\"\n", "");
    val parsed: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, source);
    $if ($mach.build.os == $mach.os.windows) {
        if (sel parsed.ok)                                              { ret 2; }
        if (!str_contains(fail.describe(parsed.err), "ambiguous keys")) { ret 3; }
    }
    $or {
        if (sel parsed.err) { ret 4; }
        val manifest: Manifest = parsed.ok;
        if (manifest.step_count != 1 || manifest.steps[0].env_count != 2) { ret 5; }
    }
    ret 0;
}

test parse__an_unknown_key_rejection_owns_only_its_message {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?backing);
    fin { intern.dnit(?itn); }
    val doc_r: res[Doc, fail.Fail] = doc_parse(?backing, "mach.toml", "[project]\nmach=\">=5\"\nid=\"p\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nname=\"unused\"\n");
    if (sel doc_r.err) { ret 2; }
    var doc: Doc = doc_r.ok;
    fin { doc_dnit(?backing, ?doc); }
    var tracking: T.Testing;
    val make_r2:  err[A.Error] = T.make(?tracking);
    if (sel make_r2.err) { ret 3; }
    fin { T.dnit(?tracking); }
    val parsed: res[Manifest, fail.Fail] = parse(?tracking.a, ?itn, ?doc);
    if (sel parsed.ok) {
        var unexpected: Manifest = parsed.ok;
        dnit(?unexpected, ?tracking.a);
        ret 4;
    }
    if (!str_contains(fail.describe(parsed.err), "unknown key 'name' in [project]")) { ret 5; }
    fail.dnit(?tracking.a, parsed.err);
    if (tracking.total < 1 || tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 6; }
    ret 0;
}
