# build a `Manifest` from a parsed TOML document, in three stages. the schema
# check holds the document to the rows of `mach.lang.manifest.schema`: a key no
# row names, a value of the wrong shape, a missing required key and a removed key
# are refused where they are written. decoding then reads each table into the
# model and refuses a value its key does not accept. validation last checks the
# rules that span entries: `need` entries and their cycles, `link` names, and at
# most one `default = true` profile. one rule holds for every key whoever reads
# the manifest, so a dependency's manifest is held to exactly the rules of the
# project being built. on any error every array allocated so far is freed
# ---
# alloc: owns the manifest's arrays
# itn:   receives every string of the manifest
# doc:   the manifest's text and its TOML document
# ret:   the manifest, or the first error as a "mach.toml: ..." message pointing at
#        the key or value in `doc` it concerns. the manifest records where each
#        field a later refusal names is written, resolved in `doc`
pub fun parse(alloc: *A.Allocator, itn: *intern.Interner, doc: *Doc) res[Manifest, fail.Fail] {
    val r: res[Manifest, fail.Fail] = parse_table(alloc, itn, ?doc.table);
    if (sel r.err) { ret res[Manifest, fail.Fail].err{fail.placed(alloc, r.err, doc.path, doc.text)}; }
    var m:    Manifest = r.ok;
    val path: opt[str] = intern.lookup(itn, intern_unwrap(itn, doc.path));
    if (sel path.none) {
        dnit(?m, alloc);
        ret res[Manifest, fail.Fail].err{fail.message("internal: manifest path not interned")};
    }
    val lines_r: res[fail.Lines, A.Error] = fail.lines_init(alloc, path.some, doc.text::*u8, str_len(doc.text));
    if (sel lines_r.err) {
        dnit(?m, alloc);
        ret res[Manifest, fail.Fail].err{fail.refused(lines_r.err)};
    }
    var lines: fail.Lines = lines_r.ok;
    resolve_sites(?lines, ?m);
    fail.lines_dnit(?lines);
    ret res[Manifest, fail.Fail].ok{m};
}

# resolve every place the model recorded while parsing in the file `lines` indexes
fun resolve_sites(lines: *fail.Lines, m: *Manifest) {
    m.project_at = resolved(lines, m.project_at);
    m.mach_at    = resolved(lines, m.mach_at);
    m.out_at     = resolved(lines, m.out_at);
    var i: u32 = 0;
    for (i < m.target_count) {
        m.targets[i].at         = resolved(lines, m.targets[i].at);
        m.targets[i].default_at = resolved(lines, m.targets[i].default_at);
        i                       = i + 1;
    }
    i = 0;
    for (i < m.profile_count) {
        m.profiles[i].at         = resolved(lines, m.profiles[i].at);
        m.profiles[i].default_at = resolved(lines, m.profiles[i].default_at);
        i                        = i + 1;
    }
    i = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        a.at         = resolved(lines, a.at);
        a.default_at = resolved(lines, a.default_at);
        a.out_at     = resolved(lines, a.out_at);
        a.targets_at = resolved(lines, a.targets_at);
        resolve_all(lines, a.need_at, a.need_count);
        i = i + 1;
    }
    i = 0;
    for (i < m.link_count) {
        m.links[i].at      = resolved(lines, m.links[i].at);
        m.links[i].path_at = resolved(lines, m.links[i].path_at);
        i                  = i + 1;
    }
    i = 0;
    for (i < m.step_count) {
        val s: *StepDef = ?m.steps[i];
        s.at = resolved(lines, s.at);
        resolve_all(lines, s.argv_at, s.argv_count);
        resolve_all(lines, s.env_at, s.env_count);
        resolve_all(lines, s.in_at, s.in_count);
        resolve_all(lines, s.out_at, s.out_count);
        resolve_all(lines, s.need_at, s.need_count);
        i = i + 1;
    }
}

fun resolved(lines: *fail.Lines, at: fail.Place) fail.Place {
    if (!at.spanned || at.path != nil) { ret at; }
    ret fail.lines_place(lines, at.start, at.end);
}

fun resolve_all(lines: *fail.Lines, sites: *fail.Place, count: u32) {
    if (sites == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        sites[i] = resolved(lines, sites[i]);
        i        = i + 1;
    }
}

# the `[project]` table of a parsed TOML document alone, held to its rows as
# `parse` holds it, for a reader such as `mach fmt` that needs nothing else
# ---
# alloc: owns the refusal's text
# itn:   receives the table's strings
# t:     the document root
# m:     receives the project fields
# ret:   ok, or the first refusal
pub fun project_parse(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val shaped: err[fail.Fail] = schema.section_check(alloc, t, "project");
    if (sel shaped.err) { ret shaped; }
    ret parse_project(alloc, itn, t, m);
}

# a manifest's text, the file it was read from, and its TOML tree, all owned
# through the allocator that made it and released with `doc_dnit`. a failure
# that names a key points into `text` at `path`
pub rec Doc {
    path:  str;
    text:  str;
    table: toml.Table;
}

# `text`, the manifest at `path`, as a doc: bytes a manifest refuses and a
# document that is not TOML are failures pointing at the byte refused. the doc
# keeps its own copies of both
pub fun doc_parse(alloc: *A.Allocator, path: str, text: str) res[Doc, fail.Fail] {
    val clean: err[fail.Fail] = validate_source_bytes(text::*u8, str_len(text));
    if (sel clean.err) { ret res[Doc, fail.Fail].err{fail.placed(alloc, clean.err, path, text)}; }
    val path_r: res[str, A.Error] = str_dup(alloc, path);
    if (sel path_r.err) { ret res[Doc, fail.Fail].err{fail.refused(path_r.err)}; }
    val text_r: res[str, A.Error] = str_dup(alloc, text);
    if (sel text_r.err) {
        str_free(alloc, path_r.ok);
        ret res[Doc, fail.Fail].err{fail.refused(text_r.err)};
    }
    val table_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, text_r.ok);
    if (sel table_r.err) {
        str_free(alloc, text_r.ok);
        str_free(alloc, path_r.ok);
        ret res[Doc, fail.Fail].err{fail.placed(alloc, fail.toml_refused(table_r.err), path, text)};
    }
    ret res[Doc, fail.Fail].ok{Doc{path: path_r.ok, text: text_r.ok, table: table_r.ok}};
}

# the manifest file at `path` read and parsed as `doc_parse` parses it; a file
# that cannot be read is the environment's
pub fun doc_read(alloc: *A.Allocator, path: str) res[Doc, fail.Fail] {
    val rb: res[Vector[u8], fs.FsError] = fs.read_bytes(alloc, path);
    if (sel rb.err) {
        ret res[Doc, fail.Fail].err{fail.environment(diagnostic_kind.FS_READ, sfmt(alloc, "cannot read '{}': {}", path, fail.fs_text(rb.err)))};
    }
    var bytes: Vector[u8] = rb.ok;
    fin { collections_vector.dnit[u8](?bytes); }
    val clean: err[fail.Fail] = validate_source_bytes(bytes.data, bytes.len);
    if (sel clean.err) { ret res[Doc, fail.Fail].err{fail.placed_bytes(alloc, clean.err, path, bytes.data, bytes.len)}; }
    val reserved: res[usize, A.Error] = collections_vector.reserve[u8](?bytes, 1);
    if (sel reserved.err) { ret res[Doc, fail.Fail].err{fail.refused(reserved.err)}; }
    bytes.data[bytes.len] = 0;
    ret doc_parse(alloc, path, bytes.data::str);
}

# release a doc and everything it owns
pub fun doc_dnit(alloc: *A.Allocator, d: *Doc) {
    toml.dnit(alloc, ?d.table);
    if (d.text != nil) { str_free(alloc, d.text); }
    if (d.path != nil) { str_free(alloc, d.path); }
    d.text = nil;
    d.path = nil;
}

fun parse_table(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table) res[Manifest, fail.Fail] {
    val shaped: err[fail.Fail] = schema.check(alloc, t);
    if (sel shaped.err) { ret res[Manifest, fail.Fail].err{shaped.err}; }

    var m:           Manifest = empty();
    var transferred: bool     = false;
    fin {
        if (!transferred) { dnit(?m, alloc); }
    }

    val res_project: err[fail.Fail] = parse_project(alloc, itn, t, ?m);
    if (sel res_project.err) { ret res[Manifest, fail.Fail].err{res_project.err}; }
    m.default_target = intern_unwrap(itn, "native");

    val res_targets: err[fail.Fail] = parse_targets(alloc, itn, t, ?m);
    if (sel res_targets.err) { ret res[Manifest, fail.Fail].err{res_targets.err}; }

    val res_artifacts: err[fail.Fail] = parse_artifacts(alloc, itn, t, ?m);
    if (sel res_artifacts.err) { ret res[Manifest, fail.Fail].err{res_artifacts.err}; }

    val res_profiles: err[fail.Fail] = parse_profiles(alloc, itn, t, ?m);
    if (sel res_profiles.err) { ret res[Manifest, fail.Fail].err{res_profiles.err}; }

    val res_deps: err[fail.Fail] = parse_deps(alloc, itn, t, ?m);
    if (sel res_deps.err) { ret res[Manifest, fail.Fail].err{res_deps.err}; }

    val res_links: err[fail.Fail] = parse_links(alloc, itn, t, ?m);
    if (sel res_links.err) { ret res[Manifest, fail.Fail].err{res_links.err}; }

    val res_steps: err[fail.Fail] = parse_steps(alloc, itn, t, ?m);
    if (sel res_steps.err) { ret res[Manifest, fail.Fail].err{res_steps.err}; }

    val res_valid: err[fail.Fail] = validate(alloc, itn, t, ?m);
    if (sel res_valid.err) { ret res[Manifest, fail.Fail].err{res_valid.err}; }

    if (m.target_count == 0) {
        val native: res[*TargetDef, fail.Fail] = make_native_target(alloc, itn);
        if (sel native.err) { ret res[Manifest, fail.Fail].err{native.err}; }
        m.native_target  = native.ok;
        m.default_target = m.native_target.name;
    }
    transferred = true;
    ret res[Manifest, fail.Fail].ok{m};
}

# the rules that span entries of a decoded manifest: every `need` entry names a
# declaration and no `need` chain cycles, every artifact `link` names a declared
# `[link.*]`, and at most one profile is the default
fun validate(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val needs: err[fail.Fail] = validate_needs(alloc, itn, t, m);
    if (sel needs.err) { ret needs; }
    val links: err[fail.Fail] = validate_link_refs(alloc, itn, t, m);
    if (sel links.err) { ret links; }
    ret profile_default_validate(alloc, itn, m);
}

# more than one `default = true` profile is refused, pointing at the first and
# naming the others
fun profile_default_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { count = count + 1; }
        i = i + 1;
    }
    if (count <= 1) { ret err[fail.Fail].ok{}; }
    var names: str = "";
    i = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) {
            if (str_len(names) == 0) { names = sfmt(alloc, "[profile.{}]", idstr(itn, m.profiles[i].name)); }
            or                       { names = sfmt(alloc, "{}, [profile.{}]", names, idstr(itn, m.profiles[i].name)); }
        }
        i = i + 1;
    }
    ret err[fail.Fail].err{duplicate_profiles(alloc, m, sfmt(alloc, "mach.toml: {} profiles declare `default = true` ({}); exactly one is allowed", count, names))};
}

# where entry `i` of `[<owner>.<name>].<key>` is written; the zero span when it is not
fun entry_span(t: *toml.Table, owner: str, name: str, key: str, i: usize) toml.Span {
    var none:    toml.Span;
    val section: opt[*toml.Table] = toml.get_table(t, owner);
    if (sel section.none) { ret none; }
    val table: opt[*toml.Table] = toml.get_table(section.some, name);
    if (sel table.none) { ret none; }
    val list: opt[*toml.Array] = toml.get_array(table.some, key);
    if (sel list.none) { ret none; }
    val e: opt[*toml.Value] = toml.array_get(list.some, i);
    if (sel e.none) { ret none; }
    ret e.some.span;
}

fun validate_need_entry(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    owner: str, name: str, entry: str, where: toml.Span) err[fail.Fail] {
    val step_pattern:     str = need_pattern(entry, "step");
    val artifact_pattern: str = need_pattern(entry, "artifact");
    if (step_pattern == nil && (artifact_pattern == nil || str_equals(owner, "step"))) {
        ret fail_at(fail.user(diagnostic_kind.NEED_FORM, sfmt(alloc,
            "mach.toml: [{}.{}].need entry '{}' must use 'step.<name>' or 'artifact.<name>' with optional '*' wildcards; steps may require only steps",
            owner, name, entry)), where);
    }
    var hits: u32 = 0;
    var i:    u32 = 0;
    if (step_pattern != nil) {
        for (i < m.step_count) {
            val other: str = idstr(itn, m.steps[i].name);
            if (glob_matches(step_pattern, other)) {
                if (str_equals(owner, "step") && str_equals(name, other)) {
                    if (!is_glob(step_pattern)) { ret fail_at(fail.user(diagnostic_kind.NEED_SELF, sfmt(alloc, "mach.toml: [{}.{}].need requires itself", owner, name)), where); }
                }
                or { hits = hits + 1; }
            }
            i = i + 1;
        }
    }
    or {
        for (i < m.artifact_count) {
            val other: str = idstr(itn, m.artifacts[i].name);
            if (glob_matches(artifact_pattern, other)) {
                if (str_equals(name, other)) {
                    if (!is_glob(artifact_pattern)) { ret fail_at(fail.user(diagnostic_kind.NEED_SELF, sfmt(alloc, "mach.toml: [artifact.{}].need requires itself", name)), where); }
                }
                or { hits = hits + 1; }
            }
            i = i + 1;
        }
    }
    if (hits == 0) {
        ret fail_at(fail.user(diagnostic_kind.NEED_NO_MATCH, sfmt(alloc, "mach.toml: [{}.{}].need entry '{}' matches no declaration in its category", owner, name, entry)), where);
    }
    ret err[fail.Fail].ok{};
}

fun validate_needs(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var ni: u32          = 0;
        for (ni < a.need_count) {
            val checked: err[fail.Fail] = validate_need_entry(alloc, itn, m,
                "artifact", idstr(itn, a.name), idstr(itn, a.need[ni]), entry_span(t, "artifact", idstr(itn, a.name), "need", ni::usize));
            if (sel checked.err) { ret checked; }
            ni = ni + 1;
        }
        ai = ai + 1;
    }
    var si: u32 = 0;
    for (si < m.step_count) {
        val s:  *StepDef = ?m.steps[si];
        var ni: u32      = 0;
        for (ni < s.need_count) {
            val checked: err[fail.Fail] = validate_need_entry(alloc, itn, m,
                "step", idstr(itn, s.name), idstr(itn, s.need[ni]), entry_span(t, "step", idstr(itn, s.name), "need", ni::usize));
            if (sel checked.err) { ret checked; }
            ni = ni + 1;
        }
        si = si + 1;
    }
    val artifacts: err[fail.Fail] = validate_need_cycles(alloc, itn, m);
    if (sel artifacts.err) { ret artifacts; }
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }
    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, m.step_count::usize);
    if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    fin { A.deallocate[u8](alloc, state, m.step_count::usize); }
    val order_r: res[*u32, A.Error] = A.allocate[u32](alloc, m.step_count::usize);
    if (sel order_r.err) { ret err[fail.Fail].err{fail.refused(order_r.err)}; }
    val order: *u32 = order_r.ok;
    fin { A.deallocate[u32](alloc, order, m.step_count::usize); }
    si = 0;
    for (si < m.step_count) {
        state[si] = 0;
        si        = si + 1;
    }
    var count: u32 = 0;
    si = 0;
    for (si < m.step_count) {
        val checked: err[fail.Fail] = plan_visit(alloc, itn, m, si, state, order, ?count);
        if (sel checked.err) { ret checked; }
        si = si + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_link_refs(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var li: u32          = 0;
        for (li < a.link_count) {
            if (find_link_by_name(m, a.link[li]) == nil) {
                var known: str = "no [link.*] table is declared";
                if (m.link_count > 0) { known = sfmt(alloc, "declared: {}", link_table_names(alloc, itn, m)); }
                ret fail_at(fail.user(diagnostic_kind.LINK_UNKNOWN_TABLE, sfmt(alloc, "mach.toml: [artifact.{}].link names no [link.*] table: '{}' ({})",
                    idstr(itn, a.name), idstr(itn, a.link[li]), known)), entry_span(t, "artifact", idstr(itn, a.name), "link", li::usize));
            }
            li = li + 1;
        }
        ai = ai + 1;
    }
    ret err[fail.Fail].ok{};
}

fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.link_count) {
        if (i > 0) { s = sfmt(alloc, "{}, ", s); }
        s = sfmt(alloc, "{}[link.{}]", s, idstr(itn, m.links[i].name));
        i = i + 1;
    }
    ret s;
}

#[testing]
pub fun demo_src() str {
    ret "[project]\nid = \"demo\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.ls]\nkind = \"bin\"\nentry = \"bin/ls.mach\"\nout = \"bin/ls\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.cat]\nkind = \"bin\"\nentry = \"bin/cat.mach\"\nout = \"bin/cat\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[dep.std]\ngit = \"https://github.com/briar-systems/mach-std\"\nref = \"tag/v0.4.0\"\n";
}

#[testing]
rec StepParseLive {
    backing: A.Allocator;
    live:    i64;
}

#[testing]
fun step_parse_live_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: opt[ptr]       = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live = p.live + size::i64;
        memory.raw_fill(r.some, 0xAA, size);
    }
    ret r;
}

#[testing]
fun step_parse_live_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: opt[ptr]       = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

#[testing]
fun step_parse_live_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *StepParseLive = ctx::*StepParseLive;
    p.live = p.live - size::i64;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

#[testing]
fun step_parse_live_make(p: *StepParseLive, alloc: *A.Allocator) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live = 0;
    val probe: *StepParseLive = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = step_parse_live_allocate;
    alloc.fn_reallocate = step_parse_live_reallocate;
    alloc.fn_deallocate = step_parse_live_deallocate;
    ret true;
}

#[testing]
pub fun tparse(alloc: *A.Allocator, itn: *intern.Interner, src: str) res[Manifest, fail.Fail] {
    val doc_r: res[Doc, fail.Fail] = doc_parse(alloc, "mach.toml", src);
    if (sel doc_r.err) { ret res[Manifest, fail.Fail].err{doc_r.err}; }
    var doc: Doc                      = doc_r.ok;
    val m:   res[Manifest, fail.Fail] = parse(alloc, itn, ?doc);
    doc_dnit(alloc, ?doc);
    ret m;
}

# one manifest text through the parse: a nil `want` parses, any other is refused
# with a message containing `want` and `also`
#[testing]
rec TManifestCase {
    want: str;
    also: str;
    src:  str;
}

#[testing]
val T_MANIFEST_CASES: [61]TManifestCase = [61]TManifestCase{
    TManifestCase{want: "same id as this project", also: "shader.<module>",
        src: "[project]\nid=\"shader\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[artifact.a]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[dep.shader]\npath=\"../shader\"\n"},
    TManifestCase{want: nil, also: nil,
        src: "[project]\nid=\"app\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[artifact.a]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[dep.shader]\npath=\"../shader\"\n"},
    TManifestCase{want: "mach.toml: [project] is missing required key 'id'", also: nil,
        src: "[project]\nversion=\"1\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n"},
    TManifestCase{want: "mach.toml: [project] is missing required key 'version'", also: nil,
        src: "[project]\nid=\"x\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "mach.toml: unknown key 'name' in [project]", also: nil,
        src: "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nname=\"App\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"},
    TManifestCase{want: "mach.toml: unknown key 'description' in [project]", also: nil,
