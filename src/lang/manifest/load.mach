fun root_key_known(k: str) bool {
    ret str_equals(k, "project") || str_equals(k, "target") || str_equals(k, "artifact")
        || str_equals(k, "profile") || str_equals(k, "dep") || str_equals(k, "link") || str_equals(k, "step");
}

fun check_root_keys(alloc: *A.Allocator, t: *toml.Table) err[outcome.Fail] {
    val n: usize = toml.table_len(t);
    var i: usize = 0;
    for (i < n) {
        val k_o: opt[str] = toml.table_key(t, i);
        if (sel k_o.none) { brk; }
        val k: str = k_o.some;
        if (!root_key_known(k)) {
            ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: unknown table or key '{}' at the document root", k))};
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

# build a `Manifest` from a parsed TOML document. accepted root tables are
# `[project]`, `[target.*]`, `[artifact.*]`, `[profile.*]`, `[dep.*]`,
# `[link.*]` and `[step.*]`; any other root key, and any key a table does not
# define, is an error naming it. on any error every array allocated so far is
# freed before returning
# ---
# alloc:   owns the manifest's arrays
# itn:     receives every string of the manifest
# t:       the TOML document
# as_root: true for the project being built, false for a dependency's manifest.
#          the root form requires at least one `[profile.*]` table, `[artifact].link`
#          and `need`, `[link].os`, `isa`, `abi` and `export`, `[step].need`, requires
#          link filter values to be canonical or "*", and rejects more than one
#          `default = true` profile. the dependency form treats each of those keys as
#          optional. a declared `[profile.*]` table requires `opt`, `debug`, `simd`,
#          `vectorize` and `float_reassoc` in both forms. the key set is closed for
#          both forms: a key is read or refused as unknown
# ret:     the manifest, or the first error as a "mach.toml: ..." message. the
#          `[project]` table and its `id`, `version`, `src` and `out` are always
#          required; `src`, `out`, artifact `entry` and `out`, local link `path` and
#          step `in` and `out` entries must satisfy `is_project_path`; every table name
#          must satisfy `is_valid_id`; `[target.native]` and `[dep.<x>].version` are
#          reserved; a `[step]` with `cmd` or `shell` is rejected by name; `need`
#          entries are checked by `validate_needs`. `[profile.*]` absent or empty is
#          an error at the root and synthesizes `debug` and `release` in a dependency
pub fun parse(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, as_root: bool) res[Manifest, outcome.Fail] {
    var m:           Manifest = empty();
    var transferred: bool     = false;
    fin {
        if (!transferred) { dnit(?m, alloc); }
    }

    val res_root_keys: err[outcome.Fail] = check_root_keys(alloc, t);
    if (sel res_root_keys.err) { ret res[Manifest, outcome.Fail].err{res_root_keys.err}; }

    val res_project: err[outcome.Fail] = parse_project(alloc, itn, t, ?m);
    if (sel res_project.err) { ret res[Manifest, outcome.Fail].err{res_project.err}; }
    m.default_target = intern_unwrap(itn, "native");

    val res_targets: err[outcome.Fail] = parse_targets(alloc, itn, t, ?m, as_root);
    if (sel res_targets.err) { ret res[Manifest, outcome.Fail].err{res_targets.err}; }

    val res_artifacts: err[outcome.Fail] = parse_artifacts(alloc, itn, t, ?m, as_root);
    if (sel res_artifacts.err) { ret res[Manifest, outcome.Fail].err{res_artifacts.err}; }

    val res_profiles: err[outcome.Fail] = parse_profiles(alloc, itn, t, ?m, as_root);
    if (sel res_profiles.err) { ret res[Manifest, outcome.Fail].err{res_profiles.err}; }

    val res_deps: err[outcome.Fail] = parse_deps(alloc, itn, t, ?m, as_root);
    if (sel res_deps.err) { ret res[Manifest, outcome.Fail].err{res_deps.err}; }

    val res_links: err[outcome.Fail] = parse_links(alloc, itn, t, ?m, as_root);
    if (sel res_links.err) { ret res[Manifest, outcome.Fail].err{res_links.err}; }

    val res_steps: err[outcome.Fail] = parse_steps(alloc, itn, t, ?m, as_root);
    if (sel res_steps.err) { ret res[Manifest, outcome.Fail].err{res_steps.err}; }

    val res_needs: err[outcome.Fail] = validate_needs(alloc, itn, ?m);
    if (sel res_needs.err) { ret res[Manifest, outcome.Fail].err{res_needs.err}; }

    val res_link_refs: err[outcome.Fail] = validate_link_refs(alloc, itn, ?m);
    if (sel res_link_refs.err) { ret res[Manifest, outcome.Fail].err{res_link_refs.err}; }

    if (m.target_count == 0) {
        val native: res[*TargetDef, outcome.Fail] = make_native_target(alloc, itn);
        if (sel native.err) { ret res[Manifest, outcome.Fail].err{native.err}; }
        m.native_target  = native.ok;
        m.default_target = m.native_target.name;
    }
    transferred = true;
    ret res[Manifest, outcome.Fail].ok{m};
}

fun validate_need_entry(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    owner: str, name: str, entry: str) err[outcome.Fail] {
    val step_pattern:     str = need_pattern(entry, "step");
    val artifact_pattern: str = need_pattern(entry, "artifact");
    if (step_pattern == nil && (artifact_pattern == nil || str_equals(owner, "step"))) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc,
            "mach.toml: [{}.{}].need entry '{}' must use 'step.<name>' or 'artifact.<name>' with optional '*' wildcards; steps may require only steps",
            owner, name, entry))};
    }
    var hits: u32 = 0;
    var i:    u32 = 0;
    if (step_pattern != nil) {
        for (i < m.step_count) {
            val other: str = idstr(itn, m.steps[i].name);
            if (glob_matches(step_pattern, other)) {
                if (str_equals(owner, "step") && str_equals(name, other)) {
                    if (!is_glob(step_pattern)) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: [{}.{}].need requires itself", owner, name))}; }
                }
                or { hits = hits + 1; }
            }
            i = i + 1;
        }
    }
    or {
        for (i < m.artifact_count) {
            val other: str = idstr(itn, m.artifacts[i].name);
            if (glob_matches(artifact_pattern, other)) {
                if (str_equals(name, other)) {
                    if (!is_glob(artifact_pattern)) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: [artifact.{}].need requires itself", name))}; }
                }
                or { hits = hits + 1; }
            }
            i = i + 1;
        }
    }
    if (hits == 0) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: [{}.{}].need entry '{}' matches no declaration in its category", owner, name, entry))};
    }
    ret err[outcome.Fail].ok{};
}

fun validate_needs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[outcome.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var ni: u32          = 0;
        for (ni < a.need_count) {
            val checked: err[outcome.Fail] = validate_need_entry(alloc, itn, m,
                "artifact", idstr(itn, a.name), idstr(itn, a.need[ni]));
            if (sel checked.err) { ret checked; }
            ni = ni + 1;
        }
        ai = ai + 1;
    }
    var si: u32 = 0;
    for (si < m.step_count) {
        val s:  *StepDef = ?m.steps[si];
        var ni: u32      = 0;
        for (ni < s.need_count) {
            val checked: err[outcome.Fail] = validate_need_entry(alloc, itn, m,
                "step", idstr(itn, s.name), idstr(itn, s.need[ni]));
            if (sel checked.err) { ret checked; }
            ni = ni + 1;
        }
        si = si + 1;
    }
    val artifacts: err[outcome.Fail] = validate_need_cycles(alloc, itn, m);
    if (sel artifacts.err) { ret artifacts; }
    if (m.step_count == 0) { ret err[outcome.Fail].ok{}; }
    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, m.step_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    fin { A.deallocate[u8](alloc, state, m.step_count::usize); }
    val order_r: res[*u32, A.Error] = A.allocate[u32](alloc, m.step_count::usize);
    if (sel order_r.err) { ret err[outcome.Fail].err{outcome.refused(order_r.err)}; }
    val order: *u32 = order_r.ok;
    fin { A.deallocate[u32](alloc, order, m.step_count::usize); }
    si = 0;
    for (si < m.step_count) {
        state[si] = 0;
        si        = si + 1;
    }
    var count: u32 = 0;
    si = 0;
    for (si < m.step_count) {
        val checked: err[outcome.Fail] = plan_visit(alloc, itn, m, si, state, order, ?count);
        if (sel checked.err) { ret checked; }
        si = si + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun validate_link_refs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[outcome.Fail] {
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a:  *ArtifactDef = ?m.artifacts[ai];
        var li: u32          = 0;
        for (li < a.link_count) {
            if (find_link_by_name(m, a.link[li]) == nil) {
                var known: str = "no [link.*] table is declared";
                if (m.link_count > 0) { known = sfmt(alloc, "declared: {}", link_table_names(alloc, itn, m)); }
                ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: [artifact.{}].link names no [link.*] table: '{}' ({})",
                    idstr(itn, a.name), idstr(itn, a.link[li]), known))};
            }
            li = li + 1;
        }
        ai = ai + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.link_count) {
        if (i > 0) { s = sfmt(alloc, "{}, ", s); }
        s = sfmt(alloc, "{}[link.{}]", s, idstr(itn, m.links[i].name));
        i = i + 1;
    }
    ret s;
}

pub fun demo_src() str {
    ret "[project]\nid = \"demo\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\ndefault = true\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.ls]\nkind = \"bin\"\nentry = \"bin/ls.mach\"\nout = \"bin/ls\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.cat]\nkind = \"bin\"\nentry = \"bin/cat.mach\"\nout = \"bin/cat\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[dep.std]\ngit = \"https://github.com/briar-systems/mach-std\"\nref = \"tag/v0.4.0\"\n";
}

rec StepParseLive {
    backing: A.Allocator;
    live:    i64;
}

fun step_parse_live_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: opt[ptr]       = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live = p.live + size::i64;
        memory.raw_fill(r.some, 0xAA, size);
    }
    ret r;
}

fun step_parse_live_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: opt[ptr]       = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun step_parse_live_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *StepParseLive = ctx::*StepParseLive;
    p.live = p.live - size::i64;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun step_parse_live_make(p: *StepParseLive, alloc: *A.Allocator) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live = 0;
    val probe: *StepParseLive = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = step_parse_live_allocate;
    alloc.fn_reallocate = step_parse_live_reallocate;
    alloc.fn_deallocate = step_parse_live_deallocate;
    ret true;
}

pub fun tparse(alloc: *A.Allocator, itn: *intern.Interner, src: str) res[Manifest, outcome.Fail] {
    val source_r: err[outcome.Fail] = validate_source_text(src);
    if (sel source_r.err) { ret res[Manifest, outcome.Fail].err{source_r.err}; }
    val tbl_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, src);
    if (sel tbl_r.err) { ret res[Manifest, outcome.Fail].err{outcome.user(outcome.toml_text(tbl_r.err))}; }
    var tbl: toml.Table                  = tbl_r.ok;
    val m:   res[Manifest, outcome.Fail] = parse(alloc, itn, ?tbl, true);
    toml.dnit(alloc, ?tbl);
    ret m;
}

pub fun tparse_lenient(alloc: *A.Allocator, itn: *intern.Interner, src: str) res[Manifest, outcome.Fail] {
    val source_r: err[outcome.Fail] = validate_source_text(src);
    if (sel source_r.err) { ret res[Manifest, outcome.Fail].err{source_r.err}; }
    val tbl_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, src);
    if (sel tbl_r.err) { ret res[Manifest, outcome.Fail].err{outcome.user(outcome.toml_text(tbl_r.err))}; }
    var tbl: toml.Table                  = tbl_r.ok;
    val m:   res[Manifest, outcome.Fail] = parse(alloc, itn, ?tbl, false);
    toml.dnit(alloc, ?tbl);
    ret m;
}

test "mach.lang.manifest.parse:demo_src_ok" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, demo_src());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (!str_equals(idstr(?itn, m.id), "demo"))                                   { code = 1; }
        if (!str_equals(idstr(?itn, m.version), "0.1.0"))                             { code = 1; }
        if (!str_equals(idstr(?itn, m.src), "src"))                                   { code = 1; }
        if (!str_equals(idstr(?itn, m.out_tmpl), "out/{target.name}/{profile.name}")) { code = 1; }
        if (m.target_count != 2)                                                      { code = 1; }
        if (m.artifact_count != 2)                                                    { code = 1; }
        if (m.profile_count != 2)                                                     { code = 1; }
        if (m.dep_count != 1)                                                         { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

# a module path's first segment names one project, so a dependency that shares the
# project's id is refused where it is declared rather than at a `use` that cannot
# resolve (#3430)
test "mach.lang.manifest.parse:a_dependency_id_equal_to_the_project_id_is_refused" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val clash: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"shader\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[artifact.a]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[dep.shader]\npath=\"../shader\"\n");
    if (!sel clash.err) { code = 1; }
    if (sel clash.err) {
        val text: str = outcome.describe(clash.err);
        if (!str_contains(text, "[dep.shader]"))            { code = 1; }
        if (!str_contains(text, "same id as this project")) { code = 1; }
        if (!str_contains(text, "shader.<module>"))         { code = 1; }
    }

    val distinct: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"app\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[artifact.a]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[dep.shader]\npath=\"../shader\"\n");
    if (sel distinct.err) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:missing_required_keys" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nversion=\"1\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: [project] is missing required key 'id'"))) { code = 1; }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel b.err && str_equals(outcome.describe(b.err), "mach.toml: [project] is missing required key 'version'"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

# [project] name/description and [profile.*] emit_ir/emit_asm are no keys:
# each is refused as unknown in both the strict and the lenient parse
test "mach.lang.manifest.parse:the_four_unread_keys_are_refused_as_unknown_in_both_forms" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:  i32 = 0;
    val head:  str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val tail:  str = "[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    var texts: [4]str;
    texts[0] = sfmt(?alloc, "{}name=\"App\"\n{}", head, tail);
    texts[1] = sfmt(?alloc, "{}description=\"d\"\n{}", head, tail);
    texts[2] = sfmt(?alloc, "{}{}emit_ir=true\n", head, tail);
    texts[3] = sfmt(?alloc, "{}{}emit_asm=true\n", head, tail);
    var wants: [4]str;
    wants[0] = "mach.toml: unknown key 'name' in [project]";
    wants[1] = "mach.toml: unknown key 'description' in [project]";
    wants[2] = "mach.toml: unknown key 'emit_ir' in [profile.debug]";
    wants[3] = "mach.toml: unknown key 'emit_asm' in [profile.debug]";
    var k: usize = 0;
    for (k < 4) {
        var form: u32 = 0;
        for (form < 2) {
            var r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, texts[k]);
            if (form == 1) { r = tparse_lenient(?alloc, ?itn, texts[k]); }
            if (sel r.ok) {
                var m: Manifest = r.ok;
                dnit(?m, ?alloc);
                code = 2;
            }
            if (sel r.err) {
                if (!str_equals(outcome.describe(r.err), wants[k])) { code = 3; }
            }
            form = form + 1;
        }
        k = k + 1;
    }
    val clean_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, tail));
    if (sel clean_r.err) { code = 4; }
    if (sel clean_r.ok) {
        var m: Manifest = clean_r.ok;
        dnit(?m, ?alloc);
    }
    arena.dnit(?ar);
    ret code;
}

# [project].mach is a version range (#3499): a valid one is kept, a bare version (the form the
# key once took) and a non-string are refused with the range grammar's reason
test "mach.lang.manifest.parse:project_mach_is_a_checked_version_range" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32                         = 0;
    val head: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val tail: str                         = "[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val good: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}mach=\">=5.2, <7\"\n{}", head, tail));
    if (sel good.err) { code = 2; }
    if (sel good.ok) {
        var m:    Manifest = good.ok;
        val text: opt[str] = intern.lookup(?itn, m.mach);
        if (sel text.none) { code = 3; }
        if (sel text.some) {
            if (!str_equals(text.some, ">=5.2, <7")) { code = 4; }
        }
        dnit(?m, ?alloc);
    }
    val absent: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, tail));
    if (sel absent.ok) {
        var m: Manifest = absent.ok;
        if (m.mach != intern.STR_NIL) { code = 5; }
        dnit(?m, ?alloc);
    }
    if (sel absent.err) { code = 6; }
    var form: u32 = 0;
    for (form < 2) {
        var bare: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}mach=\"4.14.0\"\n{}", head, tail));
        if (form == 1)   { bare = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}mach=\"4.14.0\"\n{}", head, tail)); }
        if (sel bare.ok) { code = 7; }
        if (sel bare.err) {
            if (!str_equals(outcome.describe(bare.err), "mach.toml: [project].mach = \"4.14.0\": a clause needs an operator, such as ^1.2 or >=1.2 (clause 1)")) { code = 8; }
        }
        form = form + 1;
    }
    val number: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}mach=5\n{}", head, tail));
    if (sel number.ok) { code = 9; }
    if (sel number.err) {
        if (!str_equals(outcome.describe(number.err), "mach.toml: [project].mach must be a version range string, such as \"^5.2\"")) { code = 10; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:an_artifact_link_naming_no_link_table_is_refused_naming_the_artifact_and_the_tables" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:     i32 = 0;
    val head:     str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val links:    str = "[link.m]\nsource=\"system\"\nname=\"m\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.z]\nsource=\"system\"\nname=\"z\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n";
    val bad_art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"nope\"]\nneed=[]\n";
    val good_art: str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"z\"]\nneed=[]\n";

    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, bad_art));
    if (sel r.ok) { code = 1; }
    if (sel r.err) {
        val msg: str = outcome.describe(r.err);
        if (!str_equals(msg, "mach.toml: [artifact.app].link names no [link.*] table: 'nope' (declared: [link.m], [link.z])")) { code = 2; }
    }
    val none: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, bad_art));
    if (!(sel none.err && str_contains(outcome.describe(none.err), "no [link.*] table is declared"))) { code = 3; }
    val dep: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, bad_art));
    if (sel dep.ok) { code = 4; }
    val ok: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, good_art));
    if (sel ok.err) { code = 5; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:unknown_keys" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nbogus=\"y\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: unknown key 'bogus' in [project]"))) { code = 1; }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\nwat=\"z\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel b.err && str_equals(outcome.describe(b.err), "mach.toml: unknown key 'wat' in [target.l]"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

pub fun need_head() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

pub fun need_artifact(alloc: *A.Allocator, name: str, out: str, need: str) str {
    ret sfmt(alloc, "[artifact.{}]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/{}.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[{}]\n", name, out, need);
}

pub fun need_err(alloc: *A.Allocator, itn: *intern.Interner, src: str, needle: str) bool {
    val r: res[Manifest, outcome.Fail] = tparse(alloc, itn, src);
    if (sel r.ok) { ret false; }
    ret str_contains(outcome.describe(r.err), needle);
}

test "mach.lang.manifest.validate_needs:rejects_unqualified_names_even_when_they_exist" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "twin", "twin", ""),
        "[step.twin]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"twin\"]\n");
    if (!need_err(?alloc, ?itn, src, "must use 'step.<name>' or 'artifact.<name>'")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_an_empty_glob_an_unknown_id_and_self" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val empty_glob: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "shader-a", "a", ""),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.nothing-*\"]\n");
    if (!need_err(?alloc, ?itn, empty_glob, "need entry 'artifact.nothing-*' matches no declaration in its category")) { code = 1; }

    val unknown: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.ghost\"]\n");
    if (!need_err(?alloc, ?itn, unknown, "need entry 'artifact.ghost' matches no declaration in its category")) { code = 1; }

    val itself: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.app\"]\n");
    if (!need_err(?alloc, ?itn, itself, "[artifact.app].need requires itself")) { code = 1; }

    val bad_char: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"../step\"]\n");
    if (!need_err(?alloc, ?itn, bad_char, "must use 'step.<name>' or 'artifact.<name>'")) { code = 1; }

    val self_glob: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.a*\"]\n");
    if (!need_err(?alloc, ?itn, self_glob, "need entry 'artifact.a*' matches no declaration in its category")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_a_cycle_naming_the_chain" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val two: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "a", "a", "\"artifact.b\""),
        need_artifact(?alloc, "b", "b", "\"artifact.a\""));
    if (!need_err(?alloc, ?itn, two, "artifact 'need' cycle: a -> b -> a")) { code = 1; }

    val three: str = sfmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "a", "a", "\"artifact.b\""),
        need_artifact(?alloc, "b", "b", "\"artifact.c\""),
        need_artifact(?alloc, "c", "c", "\"artifact.a\""));
    if (!need_err(?alloc, ?itn, three, "artifact 'need' cycle: a -> b -> c -> a")) { code = 1; }

    val glob_cycle: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "pack-a", "pa", "\"artifact.pack-b\""),
        need_artifact(?alloc, "pack-b", "pb", "\"artifact.pack-*\""));
    if (!need_err(?alloc, ?itn, glob_cycle, "artifact 'need' cycle: pack-a -> pack-b -> pack-a")) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:argv_step_contract" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val valid: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['\"quoted\"',\"'single'\",'semi;$|&<>*?[]','{\"x\":1}',\"{\\\"escaped\\\":true}\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE='literal;$|&<>*?[]'\nJSON=\"{\\\"x\\\":1}\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        var m: Manifest = valid.ok;
        if (m.step_count != 1 || m.steps[0].argv_count != 5 || m.steps[0].env_count != 2) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, m.steps[0].argv[0]), "\"quoted\""))                                                                           { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[1]), "'single'"))                                                                             { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[2]), "semi;$|&<>*?[]"))                                                                       { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[3]), "{\"x\":1}"))                                                                            { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].argv[4]), "{\"escaped\":true}"))                                                                   { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[0]), "JSON") || !str_equals(idstr(?itn, m.steps[0].env_values[0]), "{\"x\":1}"))          { code = 1; }
            if (!str_equals(idstr(?itn, m.steps[0].env_keys[1]), "VALUE") || !str_equals(idstr(?itn, m.steps[0].env_values[1]), "literal;$|&<>*?[]")) { code = 1; }
        }
    }

    val empty: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty.err && str_contains(outcome.describe(empty.err), ".argv must be nonempty"))) { code = 1; }

    val empty_program: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel empty_program.err && str_contains(outcome.describe(empty_program.err), "argv[0] must name an executable"))) { code = 1; }

    val cmd: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\ncmd=\"true\"\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel cmd.err && str_contains(outcome.describe(cmd.err), "uses removed key 'cmd'"))) { code = 1; }

    val shell: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nshell=true\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel shell.err && str_contains(outcome.describe(shell.err), "uses removed key 'shell'"))) { code = 1; }

    val env_type: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={VALUE=1}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_type.err && str_contains(outcome.describe(env_type.err), ".env.VALUE must be a string"))) { code = 1; }

    val env_ambiguous: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={PATH=\"a\",Path=\"b\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel env_ambiguous.err && str_contains(outcome.describe(env_ambiguous.err), "ambiguous keys"))) { code = 1; }

    val env_order_a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={z=\"last\",B=\"middle\",a=\"first\"}\nin=[]\nout=[]\nneed=[]\n"));
    val env_order_b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nenv={a=\"first\",z=\"last\",B=\"middle\"}\nin=[]\nout=[]\nneed=[]\n"));
    if (sel env_order_a.ok) {
        if (sel env_order_b.ok) {
            val ma: Manifest = env_order_a.ok;
            val mb: Manifest = env_order_b.ok;
            var ei: u32      = 0;
            for (ei < ma.steps[0].env_count && ei < mb.steps[0].env_count) {
                if (ma.steps[0].env_keys[ei] != mb.steps[0].env_keys[ei])     { code = 1; }
                if (ma.steps[0].env_values[ei] != mb.steps[0].env_values[ei]) { code = 1; }
                ei = ei + 1;
            }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[0]), "a"))        { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[0]), "first"))  { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[1]), "B"))        { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[1]), "middle")) { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_keys[2]), "z"))        { code = 1; }
            if (!str_equals(idstr(?itn, ma.steps[0].env_values[2]), "last"))   { code = 1; }
        }
        if (sel env_order_b.err) { code = 1; }
    }
    if (sel env_order_a.err) { code = 1; }

    val argv_nul: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"pre\\u0000post\"]\nin=[]\nout=[]\nneed=[]\n"));
    if (!(sel argv_nul.err && str_contains(outcome.describe(argv_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_key_nul: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\n\"A\\u0000B\"=\"x\"\n"));
    if (!(sel env_key_nul.err && str_contains(outcome.describe(env_key_nul.err), "cannot contain NUL"))) { code = 1; }

    val env_value_nul: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nVALUE=\"pre\\U00000000post\"\n"));
    if (!(sel env_value_nul.err && str_contains(outcome.describe(env_value_nul.err), "cannot contain NUL"))) { code = 1; }

    val literal_escape: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=['pre\\u0000post']\nin=[]\nout=[]\nneed=[]\n"));
    if (sel literal_escape.err) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:late_step_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner             = intern.init(?alloc);
    val r:   res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\",\"arg\"]\nenv={A=\"one\",B=\"two\"}\nin=[\"src\"]\nout=[\"../escape\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel r.ok) {
        intern.dnit(?itn);
        ret 1;
    }
    str_free(?alloc, outcome.describe(r.err));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:artifact_middle_entry_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner             = intern.init(?alloc);
    val r:   res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.a]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/a\"\ntargets=[\"t1\",\"t2\"]\nlink=[\"l1\"]\nneed=[]\n[artifact.b]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/b\"\ntargets=[\"t1\"]\nlink=[\"l1\",\"l2\"]\nneed=[\"artifact.a\"]\nicon=\"icon.ico\"\n[artifact.c]\nkind=\"bin\"\nentry=\"c.mach\"\nout=\"bin/c\"\ntargets=[\"t1\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel r.ok) {
        intern.dnit(?itn);
        ret 1;
    }
    if (!str_contains(outcome.describe(r.err), "icon and .manifest apply only to kind = \"bin\"")) {
        str_free(?alloc, outcome.describe(r.err));
        intern.dnit(?itn);
        ret 1;
    }
    str_free(?alloc, outcome.describe(r.err));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:link_middle_entry_error_releases_owned_arrays" {
    var probe: StepParseLive;
    var alloc: A.Allocator;
    if (!step_parse_live_make(?probe, ?alloc)) { ret 1; }
    var itn: intern.Interner             = intern.init(?alloc);
    val r:   res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.a]\nsource=\"system\"\nname=\"foo\"\nsymbols=[\"sym1\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[link.b]\nsource=\"system\"\nname=\"bar\"\nsymbols=[\"sym2\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.c]\nsource=\"system\"\nname=\"baz\"\nsymbols=[\"sym3\"]\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel r.ok) {
        intern.dnit(?itn);
        ret 1;
    }
    if (!str_contains(outcome.describe(r.err), "is missing required key 'export'")) {
        str_free(?alloc, outcome.describe(r.err));
        intern.dnit(?itn);
        ret 1;
    }
    str_free(?alloc, outcome.describe(r.err));
    intern.dnit(?itn);
    if (probe.live != 0) { ret 1; }
    ret 0;
}

fun step_intern_fail_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun step_intern_fail_reallocate(ctx: ptr, item: ptr, old_size: usize,
    new_size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun step_intern_fail_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.manifest.parse:env_intern_failure_aborts_step" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var base:     intern.Interner             = intern.init(?alloc);
    val head:     str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val seeded_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?base, head);
    if (sel seeded_r.err) {
        intern.dnit(?base);
        ret 1;
    }
    var seeded: Manifest = seeded_r.ok;
    dnit(?seeded, ?alloc);

    val source:  str                             = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[step.s]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.s.env]\nUNSEEDED=\"value\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val table_r: res[toml.Table, toml.TomlError] = toml.parse(?alloc, source);
    if (sel table_r.err) {
        intern.dnit(?base);
        ret 1;
    }
    var table: toml.Table = table_r.ok;

    var fail_alloc: A.Allocator;
    fail_alloc.ctx           = nil;
    fail_alloc.fn_allocate   = step_intern_fail_allocate;
    fail_alloc.fn_reallocate = step_intern_fail_reallocate;
    fail_alloc.fn_deallocate = step_intern_fail_deallocate;
    var child:  intern.Interner             = intern.make_child(?base, ?fail_alloc);
    val parsed: res[Manifest, outcome.Fail] = parse(?alloc, ?child, ?table, true);
    toml.dnit(?alloc, ?table);
    val bad: bool = sel parsed.ok || child.len != 0;
    intern.dnit(?child);
    intern.dnit(?base);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:subsystem_optional_and_console" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, art));
    if (sel a.err) { code = 1; }
    if (sel a.ok) {
        if (a.ok.artifacts[0].subsystem != of.SUBSYSTEM_CONSOLE || a.ok.artifacts[0].subsystem_declared) { code = 1; }
    }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"gui\"\n"));
    if (sel b.err) { code = 1; }
    if (sel b.ok) {
        if (b.ok.artifacts[0].subsystem != of.SUBSYSTEM_GUI || !b.ok.artifacts[0].subsystem_declared) { code = 1; }
    }

    val c: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"console\"\n"));
    if (sel c.err) { code = 1; }
    if (sel c.ok) {
        if (c.ok.artifacts[0].subsystem != of.SUBSYSTEM_CONSOLE) { code = 1; }
    }

    val d: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=\"windows\"\n"));
    if (!(sel d.err && str_contains(outcome.describe(d.err), "subsystem must be \"console\" or \"gui\""))) { code = 1; }

    val e: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, art, "subsystem=2\n"));
    if (!(sel e.err && str_contains(outcome.describe(e.err), "subsystem must be \"console\" or \"gui\""))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:artifact_resource_keys_validated" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val bin:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app.exe\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val absent: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, bin));
    if (sel absent.err) { code = 1; }
    if (sel absent.ok) {
        val a: ArtifactDef = absent.ok.artifacts[0];
        if (a.icon != intern.STR_NIL || a.app_manifest != intern.STR_NIL) { code = 1; }
    }

    val valid: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets/app.ico\"\nmanifest=\"assets/app.manifest\"\n"));
    if (sel valid.err) { code = 1; }
    if (sel valid.ok) {
        val a:  ArtifactDef = valid.ok.artifacts[0];
        val io: opt[str]    = intern.lookup(?itn, a.icon);
        val mo: opt[str]    = intern.lookup(?itn, a.app_manifest);
        if (!(sel io.some && str_equals(io.some, "assets/app.ico")))      { code = 1; }
        if (!(sel mo.some && str_equals(mo.some, "assets/app.manifest"))) { code = 1; }
    }

    val empty_icon: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"\"\n"));
    if (!(sel empty_icon.err && str_contains(outcome.describe(empty_icon.err), ".icon must not be empty"))) { code = 1; }

    val wrong_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "manifest=42\n"));
    if (!(sel wrong_manifest.err && str_contains(outcome.describe(wrong_manifest.err), ".manifest must be a non-empty path string"))) { code = 1; }

    val backslash: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn,
        sfmt(?alloc, "{}{}{}", head, bin, "icon=\"assets\\\\app.ico\"\n"));
    if (!(sel backslash.err && str_contains(outcome.describe(backslash.err), "manifest paths use '/'"))) { code = 1; }

    val static_art: str                         = "[artifact.lib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/x.a\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\nicon=\"assets/app.ico\"\n";
    val irrelevant: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, static_art));
    if (!(sel irrelevant.err && str_contains(outcome.describe(irrelevant.err), "apply only to kind = \"bin\" artifacts"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

