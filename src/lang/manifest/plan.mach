pub rec Selection {
    target:       str;
    profile:      str;
    artifact:     str;
    want_lib:     bool;
    has_artifact: bool;
}

pub rec BuildUnit {
    target:        *TargetDef;
    artifact:      *ArtifactDef;
    target_name:   intern.StrId;
    profile_name:  intern.StrId;
    entry:         intern.StrId;
    bin_path:      intern.StrId;
    obj_root:      intern.StrId;
    ir_root:       intern.StrId;
    asm_root:      intern.StrId;
    test_root:     intern.StrId;
    opt:           MOpt;
    debug:         bool;
    simd:          SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
    is_lib:        bool;
    kind:          LibKind;
    libs:          *LinkRequirement;
    lib_count:     u32;
    warned:        bool;
}

rec ArtifactCandidates {
    count:         u32;
    sole:          *ArtifactDef;
    first:         *ArtifactDef;
    default_count: u32;
    chosen:        *ArtifactDef;
}

pub fun resolve_target(alloc: *A.Allocator, itn: *intern.Interner,
    targets: *TargetDef, target_count: u32,
    native_target: *TargetDef, default_target: intern.StrId,
    selector: str, art: *ArtifactDef) res[ResolvedTarget, outcome.Fail] {
    val host_os:   u32 = tgt.host_os_id();
    val host_arch: u32 = tgt.host_arch_id();

    if (str_empty(selector) && art != nil) {
        val pinned: *TargetDef = artifact_pinned_target(itn, targets, target_count, art);
        if (pinned != nil) {
            var rt: ResolvedTarget;
            rt.target = pinned;
            rt.warned = false;
            ret res[ResolvedTarget, outcome.Fail].ok{rt};
        }
    }

    var name: str = selector;
    if (str_empty(name)) {
        val opt_target: opt[str] = intern.lookup(itn, default_target);
        if (sel opt_target.none) { ret res[ResolvedTarget, outcome.Fail].err{outcome.user("internal: default target not interned")}; }
        name = opt_target.some;
    }

    if (!str_equals(name, "native")) {
        val d: *TargetDef = find_target_by_name(itn, targets, target_count, name);
        if (d == nil) { ret res[ResolvedTarget, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: no target named '{}'", name))}; }
        var rt: ResolvedTarget;
        rt.target = d;
        rt.warned = false;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }

    var first_match: *TargetDef = nil;
    var match_count: u32        = 0;
    var names:       str        = "";
    var i:           u32        = 0;
    for (i < target_count) {
        if (target_matches_host(itn, ?targets[i], host_os, host_arch)) {
            if (first_match == nil) { first_match = ?targets[i]; }
            if (match_count > 0)    { names = sfmt(alloc, "{}, ", names); }
            val opt_name: opt[str] = intern.lookup(itn, targets[i].name);
            if (sel opt_name.some) { names = sfmt(alloc, "{}{}", names, opt_name.some); }
            match_count = match_count + 1;
        }
        i = i + 1;
    }

    if (match_count > 1) {
        ret res[ResolvedTarget, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: 'native' matches multiple targets for the host ({})", names))};
    }
    var rt: ResolvedTarget;
    if (match_count == 1) {
        rt.target = first_match;
        rt.warned = false;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }
    if (target_count > 1) {
        var chosen:        *TargetDef = nil;
        var default_count: u32        = 0;
        i = 0;
        for (i < target_count) {
            if (targets[i].is_default) {
                default_count = default_count + 1;
                chosen        = ?targets[i];
            }
            i = i + 1;
        }
        if (default_count > 1) {
            ret res[ResolvedTarget, outcome.Fail].err{outcome.user("mach.toml: multiple declared targets have 'default = true'; exactly one is allowed")};
        }
        if (chosen == nil) {
            ret res[ResolvedTarget, outcome.Fail].err{outcome.user(AMBIGUOUS_TARGET_MSG)};
        }
        rt.target = chosen;
        rt.warned = true;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }
    if (target_count == 0) {
        if (native_target == nil) { ret res[ResolvedTarget, outcome.Fail].err{outcome.user("internal: manifest has no native target owner")}; }
        rt.target = native_target;
        rt.warned = false;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }
    rt.target = ?targets[0];
    rt.warned = true;
    ret res[ResolvedTarget, outcome.Fail].ok{rt};
}

pub fun cell_supported(alloc: *A.Allocator, itn: *intern.Interner,
    targets: *TargetDef, target_count: u32,
    native_target: *TargetDef, default_target: intern.StrId,
    artifacts: *ArtifactDef, artifact_count: u32,
    pick: Selection) res[bool, outcome.Fail] {
    val res_target: res[ResolvedTarget, outcome.Fail] = resolve_target(alloc, itn, targets, target_count, native_target, default_target, pick.target, nil);
    if (sel res_target.err) { ret res[bool, outcome.Fail].err{res_target.err}; }
    val rt: ResolvedTarget = res_target.ok;

    val a: *ArtifactDef = resolve_artifact(itn, artifacts, artifact_count, pick.has_artifact, pick.artifact, pick.want_lib);
    if (a == nil) { ret res[bool, outcome.Fail].err{outcome.user(artifact_err(alloc, itn, artifacts, artifact_count, pick))}; }

    ret res[bool, outcome.Fail].ok{artifact_supports_target(itn, a, rt.target.name)};
}

fun set_selected_artifact(itn: *intern.Interner, a: *ArtifactDef,
    pick: *Selection) err[outcome.Fail] {
    val name_opt: opt[str] = intern.lookup(itn, a.name);
    if (sel name_opt.none) {
        ret err[outcome.Fail].err{outcome.user("selected artifact name not interned")};
    }
    pick.artifact     = name_opt.some;
    pick.want_lib     = a.is_lib;
    pick.has_artifact = true;
    ret err[outcome.Fail].ok{};
}

fun artifact_candidates_for(alloc: *A.Allocator, itn: *intern.Interner,
    targets: *TargetDef, target_count: u32,
    native_target: *TargetDef, default_target: intern.StrId,
    artifacts: *ArtifactDef, artifact_count: u32,
    pick: *Selection, executables_only: bool) res[ArtifactCandidates, outcome.Fail] {
    var c: ArtifactCandidates;
    c.count         = 0;
    c.sole          = nil;
    c.first         = nil;
    c.default_count = 0;
    c.chosen        = nil;
    val tr: res[ResolvedTarget, outcome.Fail] = resolve_target(alloc, itn, targets, target_count, native_target, default_target, pick.target, nil);
    if (sel tr.err) { ret res[ArtifactCandidates, outcome.Fail].err{tr.err}; }
    val rt: ResolvedTarget = tr.ok;

    var i: u32 = 0;
    for (i < artifact_count) {
        val a: *ArtifactDef = ?artifacts[i];
        if ((!executables_only || !a.is_lib) && artifact_supports_target(itn, a, rt.target.name)) {
            c.sole = a;
            if (c.first == nil) { c.first = a; }
            c.count = c.count + 1;
            if (a.is_default) {
                c.chosen        = a;
                c.default_count = c.default_count + 1;
            }
        }
        i = i + 1;
    }
    if (c.count != 1)         { c.sole = nil; }
    if (c.default_count != 1) { c.chosen = nil; }
    ret res[ArtifactCandidates, outcome.Fail].ok{c};
}

pub fun select_primary_artifact(alloc: *A.Allocator, itn: *intern.Interner,
    targets: *TargetDef, target_count: u32,
    native_target: *TargetDef, default_target: intern.StrId,
    artifacts: *ArtifactDef, artifact_count: u32,
    pick: *Selection) err[outcome.Fail] {
    if (pick.has_artifact || artifact_count < 2) { ret err[outcome.Fail].ok{}; }

    val cr: res[ArtifactCandidates, outcome.Fail] = artifact_candidates_for(alloc, itn, targets, target_count, native_target, default_target, artifacts, artifact_count, pick, false);
    if (sel cr.err) { ret err[outcome.Fail].err{cr.err}; }
    val c: ArtifactCandidates = cr.ok;
    if (c.sole != nil)   { ret set_selected_artifact(itn, c.sole, pick); }
    if (c.chosen != nil) { ret set_selected_artifact(itn, c.chosen, pick); }
    if (c.count == 0) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: no artifact supports the selected target ({})", artifact_candidates(alloc, itn, artifacts, artifact_count)))};
    }
    if (c.default_count > 1) {
        ret err[outcome.Fail].err{outcome.user("mach.toml: multiple artifacts supporting the selected target have 'default = true'; exactly one is allowed")};
    }
    ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} ({})", AMBIGUOUS_ARTIFACT_MSG, artifact_candidates(alloc, itn, artifacts, artifact_count)))};
}

pub fun select_sole_target_artifact(alloc: *A.Allocator, itn: *intern.Interner,
    targets: *TargetDef, target_count: u32,
    native_target: *TargetDef, default_target: intern.StrId,
    artifacts: *ArtifactDef, artifact_count: u32,
    pick: *Selection) err[outcome.Fail] {
    if (pick.has_artifact || artifact_count < 2) { ret err[outcome.Fail].ok{}; }

    val cr: res[ArtifactCandidates, outcome.Fail] = artifact_candidates_for(alloc, itn, targets, target_count, native_target, default_target, artifacts, artifact_count, pick, false);
    if (sel cr.err) { ret err[outcome.Fail].ok{}; }
    val c: ArtifactCandidates = cr.ok;
    if (c.sole != nil)   { ret set_selected_artifact(itn, c.sole, pick); }
    if (c.chosen != nil) { ret set_selected_artifact(itn, c.chosen, pick); }
    ret err[outcome.Fail].ok{};
}

pub fun select_sole_executable_artifact(alloc: *A.Allocator, itn: *intern.Interner,
    targets: *TargetDef, target_count: u32,
    native_target: *TargetDef, default_target: intern.StrId,
    artifacts: *ArtifactDef, artifact_count: u32,
    pick: *Selection) err[outcome.Fail] {
    if (pick.has_artifact || artifact_count < 2) { ret err[outcome.Fail].ok{}; }

    val cr: res[ArtifactCandidates, outcome.Fail] = artifact_candidates_for(alloc, itn, targets, target_count, native_target, default_target, artifacts, artifact_count, pick, true);
    if (sel cr.err) { ret err[outcome.Fail].ok{}; }
    val c: ArtifactCandidates = cr.ok;
    if (c.sole != nil)   { ret set_selected_artifact(itn, c.sole, pick); }
    if (c.chosen != nil) { ret set_selected_artifact(itn, c.chosen, pick); }
    ret err[outcome.Fail].ok{};
}

pub fun artifact_err(alloc: *A.Allocator, itn: *intern.Interner, artifacts: *ArtifactDef, artifact_count: u32, pick: Selection) str {
    if (artifact_count == 0) { ret "mach.toml: no [artifact.*] artifacts declared"; }
    if (pick.has_artifact) {
        if (pick.want_lib) { ret sfmt(alloc, "mach.toml: no lib named '{}'", pick.artifact); }
        ret sfmt(alloc, "mach.toml: no bin named '{}'", pick.artifact);
    }
    ret sfmt(alloc, "mach.toml: multiple artifacts declared; select one with --bin/--lib ({})",
        artifact_candidates(alloc, itn, artifacts, artifact_count));
}

pub fun artifact_candidates(alloc: *A.Allocator, itn: *intern.Interner, artifacts: *ArtifactDef, artifact_count: u32) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < artifact_count) {
        if (i > 0) { s = sfmt(alloc, "{}, ", s); }
        var label: str = "bin ";
        if (artifacts[i].is_lib) { label = "lib "; }
        var name:     str      = "?";
        val opt_name: opt[str] = intern.lookup(itn, artifacts[i].name);
        if (sel opt_name.some) { name = opt_name.some; }
        s = sfmt(alloc, "{}{}{}", s, label, name);
        i = i + 1;
    }
    ret s;
}

pub fun resolve_build_unit(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry,
    targets: *TargetDef, target_count: u32,
    native_target: *TargetDef, default_target: intern.StrId,
    profiles: *ProfileDef, profile_count: u32,
    artifacts: *ArtifactDef, artifact_count: u32,
    links: *LinkDef, link_count: u32,
    out_tmpl: intern.StrId,
    pick: Selection) res[BuildUnit, outcome.Fail] {
    var pin: *ArtifactDef = nil;
    if (str_empty(pick.target)) { pin = resolve_artifact(itn, artifacts, artifact_count, pick.has_artifact, pick.artifact, pick.want_lib); }

    val res_target: res[ResolvedTarget, outcome.Fail] = resolve_target(alloc, itn, targets, target_count, native_target, default_target, pick.target, pin);
    if (sel res_target.err) { ret res[BuildUnit, outcome.Fail].err{res_target.err}; }
    val rt: ResolvedTarget = res_target.ok;

    val res_profile: res[ResolvedProfile, outcome.Fail] = resolve_profile(alloc, itn, profiles, profile_count, pick.profile);
    if (sel res_profile.err) { ret res[BuildUnit, outcome.Fail].err{res_profile.err}; }
    val rp: ResolvedProfile = res_profile.ok;

    val a: *ArtifactDef = resolve_artifact(itn, artifacts, artifact_count, pick.has_artifact, pick.artifact, pick.want_lib);
    if (a == nil) { ret res[BuildUnit, outcome.Fail].err{outcome.user(artifact_err(alloc, itn, artifacts, artifact_count, pick))}; }

    if (!artifact_supports_target(itn, a, rt.target.name)) {
        val art_name: str = idstr(itn, a.name);
        val tgt_name: str = idstr(itn, rt.target.name);
        if (str_empty(pick.target)) {
            ret res[BuildUnit, outcome.Fail].err{outcome.user(sfmt(alloc,
                "mach.toml: artifact '{}' declares no target for this host; select one with --target ({})",
                art_name, artifact_target_names(alloc, itn, targets, target_count, a)))};
        }
        ret res[BuildUnit, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: artifact '{}' does not support target '{}'", art_name, tgt_name))};
    }

    var u: BuildUnit;
    u.target        = rt.target;
    u.artifact      = a;
    u.target_name   = rt.target.name;
    u.profile_name  = rp.name;
    u.opt           = rp.opt;
    u.debug         = rp.debug;
    u.simd          = rp.simd;
    u.vectorize     = rp.vectorize;
    u.float_reassoc = rp.float_reassoc;
    u.is_lib        = a.is_lib;
    u.kind          = LIBKIND_STATIC;
    val kind_str: str = idstr(itn, a.kind);
    if (str_equals(kind_str, "shared")) {
        u.kind = LIBKIND_SHARED;
    }
    u.warned = rt.warned;
    u.entry  = a.entry;

    val res_profile_name: res[str, outcome.Fail] = must_lookup(itn, rp.name);
    if (sel res_profile_name.err) { ret res[BuildUnit, outcome.Fail].err{res_profile_name.err}; }
    val pn: str      = res_profile_name.ok;
    var v:  TmplVars = tmpl_vars_of(itn, rt.target, pn);

    val must_lookup_r: res[str, outcome.Fail] = must_lookup(itn, out_tmpl);
    if (sel must_lookup_r.err) { ret res[BuildUnit, outcome.Fail].err{must_lookup_r.err}; }
    val res_project_out: res[str, outcome.Fail] = expand_project_path(alloc, must_lookup_r.ok, "", ?v, "[project].out");
    if (sel res_project_out.err) { ret res[BuildUnit, outcome.Fail].err{res_project_out.err}; }
    val proj_out: str = res_project_out.ok;

    var match_count:   u32              = 0;
    var matched_items: *LinkRequirement = nil;
    if (a.link_count > 0) {
        val res_match_arr: res[*LinkRequirement, A.Error] = A.allocate[LinkRequirement](alloc, a.link_count::usize);
        if (sel res_match_arr.err) {
            str_free(alloc, proj_out);
            ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_match_arr.err)};
        }
        matched_items = res_match_arr.ok;

        var li: u32 = 0;
        for (li < a.link_count) {
            val link_name: intern.StrId = a.link[li];
            var found_l:   *LinkDef     = nil;
            var lidx:      u32          = 0;
            for (lidx < link_count) {
                if (links[lidx].name == link_name) {
                    found_l = ?links[lidx];
                }
                lidx = lidx + 1;
            }
            if (found_l != nil) {
                if (link_matches_target(itn, found_l, rt.target)) {
                    val req_r: res[LinkRequirement, outcome.Fail] = link_requirement(alloc, itn, found_l, proj_out, ?v);
                    if (sel req_r.err) {
                        free_link_claims(alloc, matched_items, match_count);
                        A.deallocate[LinkRequirement](alloc, matched_items, a.link_count::usize);
                        str_free(alloc, proj_out);
                        ret res[BuildUnit, outcome.Fail].err{req_r.err};
                    }
                    matched_items[match_count] = req_r.ok;
                    match_count                = match_count + 1;
                }
            }
            li = li + 1;
        }

        var exact_items: *LinkRequirement  = nil;
        var exact_count: u32               = 0;
        val fr:          err[outcome.Fail] = finish_link_requirements(alloc, matched_items,
            a.link_count, match_count, ?exact_items, ?exact_count);
        if (sel fr.err) {
            str_free(alloc, proj_out);
            ret res[BuildUnit, outcome.Fail].err{fr.err};
        }
        matched_items = exact_items;
        match_count   = exact_count;
    }
    u.libs      = matched_items;
    u.lib_count = match_count;

    val obj_str:  str = sfmt(alloc, "{}/obj", proj_out);
    val ir_str:   str = sfmt(alloc, "{}/ir", proj_out);
    val asm_str:  str = sfmt(alloc, "{}/asm", proj_out);
    val test_str: str = sfmt(alloc, "{}/test/{{name}}", proj_out);

    val res_obj:  res[intern.StrId, A.Error] = intern.intern(itn, obj_str);
    val res_ir:   res[intern.StrId, A.Error] = intern.intern(itn, ir_str);
    val res_asm:  res[intern.StrId, A.Error] = intern.intern(itn, asm_str);
    val res_test: res[intern.StrId, A.Error] = intern.intern(itn, test_str);
    str_free(alloc, obj_str);
    str_free(alloc, ir_str);
    str_free(alloc, asm_str);
    str_free(alloc, test_str);

    if (sel res_obj.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_obj.err)};
    }
    u.obj_root = res_obj.ok;
    if (sel res_ir.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_ir.err)};
    }
    u.ir_root = res_ir.ok;
    if (sel res_asm.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_asm.err)};
    }
    u.asm_root = res_asm.ok;
    if (sel res_test.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_test.err)};
    }
    u.test_root = res_test.ok;

    val res_art_out: res[str, outcome.Fail] = expand_artifact_output(alloc, itn, reg, a, proj_out, ?v);
    if (sel res_art_out.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{res_art_out.err};
    }
    val art_out_rel: str = res_art_out.ok;

    val final_bin_path: str                        = join_path_canonical(alloc, proj_out, art_out_rel);
    val res_bin:        res[intern.StrId, A.Error] = intern.intern(itn, final_bin_path);
    str_free(alloc, final_bin_path);
    str_free(alloc, art_out_rel);
    str_free(alloc, proj_out);
    if (sel res_bin.err) { ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_bin.err)}; }
    u.bin_path = res_bin.ok;

    ret res[BuildUnit, outcome.Fail].ok{u};
}

fun requirement_index(buf: *LinkRequirement, count: u32, req: *LinkRequirement) i64 {
    var i: u32 = 0;
    for (i < count) {
        if (buf[i].source == req.source && buf[i].text == req.text
            && buf[i].library == req.library) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

pub fun resolve_test_libs(alloc: *A.Allocator, itn: *intern.Interner,
    artifacts: *ArtifactDef, artifact_count: u32,
    links: *LinkDef, link_count: u32,
    t: *TargetDef, proj_out: str, v: *TmplVars,
    out_items: **LinkRequirement, out_count: *u32) err[outcome.Fail] {
    @out_items = nil;
    @out_count = 0;

    var max: u32 = 0;
    var ai:  u32 = 0;
    for (ai < artifact_count) {
        max = max + artifacts[ai].link_count;
        ai  = ai + 1;
    }
    if (max == 0) { ret err[outcome.Fail].ok{}; }

    val br: res[*LinkRequirement, A.Error] = A.allocate[LinkRequirement](alloc, max::usize);
    if (sel br.err) { ret err[outcome.Fail].err{outcome.refused(br.err)}; }
    val buf: *LinkRequirement = br.ok;
    var w:   u32              = 0;

    ai = 0;
    for (ai < artifact_count) {
        val a:  *ArtifactDef = ?artifacts[ai];
        var li: u32          = 0;
        for (li < a.link_count) {
            val link_name: intern.StrId = a.link[li];
            var found_l:   *LinkDef     = nil;
            var lidx:      u32          = 0;
            for (lidx < link_count) {
                if (links[lidx].name == link_name) { found_l = ?links[lidx]; }
                lidx = lidx + 1;
            }
            if (found_l != nil) {
                if (link_matches_target(itn, found_l, t)) {
                    val req_r: res[LinkRequirement, outcome.Fail] = link_requirement(alloc, itn, found_l, proj_out, v);
                    if (sel req_r.err) {
                        free_link_claims(alloc, buf, w);
                        A.deallocate[LinkRequirement](alloc, buf, max::usize);
                        ret err[outcome.Fail].err{req_r.err};
                    }
                    var req:       LinkRequirement = req_r.ok;
                    val duplicate: i64             = requirement_index(buf, w, ?req);
                    if (duplicate < 0) {
                        buf[w] = req;
                        w      = w + 1;
                    }
                    or {
                        val mr: err[outcome.Fail] = merge_link_claims(alloc, ?buf[duplicate::u32], ?req);
                        if (sel mr.err) {
                            free_link_claims(alloc, ?req, 1);
                            free_link_claims(alloc, buf, w);
                            A.deallocate[LinkRequirement](alloc, buf, max::usize);
                            ret mr;
                        }
                        free_link_claims(alloc, ?req, 1);
                    }
                }
            }
            li = li + 1;
        }
        ai = ai + 1;
    }

    ret finish_link_requirements(alloc, buf, max, w, out_items, out_count);
}

pub fun free_path_strings(alloc: *A.Allocator, paths: *str, count: u32) {
    if (paths == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (paths[i] != nil) { str_free(alloc, paths[i]); }
        i = i + 1;
    }
}

pub fun check_collisions(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry,
    artifacts: *ArtifactDef, artifact_count: u32,
    out_tmpl: intern.StrId,
    v: *TmplVars) err[outcome.Fail] {
    if (artifact_count < 2) { ret err[outcome.Fail].ok{}; }
    val target_id: res[intern.StrId, A.Error] = intern.intern(itn, v.target);
    if (sel target_id.err) { ret err[outcome.Fail].err{outcome.refused(target_id.err)}; }

    val res_paths: res[*str, A.Error] = A.allocate[str](alloc, artifact_count::usize);
    if (sel res_paths.err) { ret err[outcome.Fail].err{outcome.refused(res_paths.err)}; }
    val paths: *str = res_paths.ok;

    val must_lookup_r: res[str, outcome.Fail] = must_lookup(itn, out_tmpl);
    if (sel must_lookup_r.err) {
        A.deallocate[str](alloc, paths, artifact_count::usize);
        ret err[outcome.Fail].err{must_lookup_r.err};
    }
    val res_project_out: res[str, outcome.Fail] = expand_project_path(alloc, must_lookup_r.ok, "", v, "[project].out");
    if (sel res_project_out.err) {
        A.deallocate[str](alloc, paths, artifact_count::usize);
        ret err[outcome.Fail].err{res_project_out.err};
    }
    val proj_out: str = res_project_out.ok;

    var i: u32 = 0;
    for (i < artifact_count) {
        val a: *ArtifactDef = ?artifacts[i];
        paths[i] = nil;
        if (!artifact_supports_target(itn, a, target_id.ok)) {
            i = i + 1;
            cnt;
        }
        val res_art_out: res[str, outcome.Fail] = expand_artifact_output(alloc, itn, reg, a, proj_out, v);
        if (sel res_art_out.err) {
            free_path_strings(alloc, paths, i);
            A.deallocate[str](alloc, paths, artifact_count::usize);
            str_free(alloc, proj_out);
            ret err[outcome.Fail].err{res_art_out.err};
        }
        val art_out_rel: str = res_art_out.ok;
        paths[i] = join_path_canonical(alloc, proj_out, art_out_rel);
        str_free(alloc, art_out_rel);
        i = i + 1;
    }

    var code: bool = true;
    var msg:  str  = "";
    i = 0;
    for (i < artifact_count && code) {
        var j: u32 = i + 1;
        for (j < artifact_count && code) {
            if (paths[i] != nil && paths[j] != nil && str_equals(paths[i], paths[j])) {
                val an0: opt[str] = intern.lookup(itn, artifacts[i].name);
                val an1: opt[str] = intern.lookup(itn, artifacts[j].name);
                if (sel an0.some) {
                    if (sel an1.some) {
                        msg = sfmt(alloc, "mach.toml: artifacts '{}' and '{}' collide on output path '{}'", an0.some, an1.some, paths[i]);
                    }
                }
                code = false;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    free_path_strings(alloc, paths, artifact_count);
    A.deallocate[str](alloc, paths, artifact_count::usize);
    str_free(alloc, proj_out);
    if (!code) { ret err[outcome.Fail].err{outcome.user(msg)}; }
    ret err[outcome.Fail].ok{};
}

pub fun plan_visit(alloc: *A.Allocator, itn: *intern.Interner,
    steps: *StepDef, step_count: u32,
    idx: u32, state: *u8, order: *u32, order_len: *u32) err[outcome.Fail] {
    if (state[idx] == 2) { ret err[outcome.Fail].ok{}; }
    if (state[idx] == 1) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: build step '{}' is part of a 'need' cycle", idstr(itn, steps[idx].name)))}; }
    state[idx] = 1;
    val s:  *StepDef = ?steps[idx];
    var ni: u32      = 0;
    for (ni < s.need_count) {
        var j: u32 = 0;
        for (j < step_count) {
            if (j != idx && need_matches(idstr(itn, s.need[ni]), "step", idstr(itn, steps[j].name))) {
                val vr: err[outcome.Fail] = plan_visit(alloc, itn, steps, step_count, j, state, order, order_len);
                if (sel vr.err) { ret vr; }
            }
            j = j + 1;
        }
        ni = ni + 1;
    }
    state[idx]        = 2;
    order[@order_len] = idx;
    @order_len        = @order_len + 1;
    ret err[outcome.Fail].ok{};
}

pub fun plan_steps(alloc: *A.Allocator, itn: *intern.Interner,
    steps: *StepDef, step_count: u32,
    artifacts: *ArtifactDef, artifact_count: u32,
    links: *LinkDef, link_count: u32,
    art_names: *intern.StrId, art_count: u32, t: *TargetDef,
    proj_out: str, v: *TmplVars,
    out_order: **u32, out_count: *u32) err[outcome.Fail] {
    @out_order = nil;
    @out_count = 0;
    if (step_count == 0) { ret err[outcome.Fail].ok{}; }

    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, step_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    var i:     u32 = 0;
    for (i < step_count) {
        state[i] = 0;
        i        = i + 1;
    }

    val or_: res[*u32, A.Error] = A.allocate[u32](alloc, step_count::usize);
    if (sel or_.err) {
        A.deallocate[u8](alloc, state, step_count::usize);
        ret err[outcome.Fail].err{outcome.refused(or_.err)};
    }
    val order:     *u32 = or_.ok;
    var order_len: u32  = 0;

    var ai: u32 = 0;
    for (ai < art_count) {
        val a: *ArtifactDef = find_artifact_by_name(artifacts, artifact_count, art_names[ai]);
        if (a != nil) {
            var li: u32 = 0;
            for (li < a.link_count) {
                val l: *LinkDef = find_link_by_name(links, link_count, a.link[li]);
                if (l != nil && l.source == LINK_LOCAL && link_matches_target(itn, l, t)) {
                    val exp_r: res[str, outcome.Fail] = expand_project_path(alloc, idstr(itn, l.path), proj_out, v, "a local link path");
                    if (sel exp_r.err) {
                        plan_free(alloc, state, order, step_count);
                        ret err[outcome.Fail].err{exp_r.err};
                    }
                    val exp:  str = exp_r.ok;
                    val sidx: i64 = step_producing_out(alloc, itn, steps, step_count, exp, proj_out, v);
                    str_free(alloc, exp);
                    if (sidx >= 0) {
                        val vr: err[outcome.Fail] = plan_visit(alloc, itn, steps, step_count, sidx::u32, state, order, ?order_len);
                        if (sel vr.err) {
                            plan_free(alloc, state, order, step_count);
                            ret vr;
                        }
                    }
                }
                li = li + 1;
            }
            var ni: u32 = 0;
            for (ni < a.need_count) {
                var si: u32 = 0;
                for (si < step_count) {
                    if (need_matches(idstr(itn, a.need[ni]), "step", idstr(itn, steps[si].name))) {
                        val vr: err[outcome.Fail] = plan_visit(alloc, itn, steps, step_count, si, state, order, ?order_len);
                        if (sel vr.err) {
                            plan_free(alloc, state, order, step_count);
                            ret vr;
                        }
                    }
                    si = si + 1;
                }
                ni = ni + 1;
            }
        }
        ai = ai + 1;
    }

    ret plan_finish(alloc, state, order, step_count, order_len, out_order, out_count);
}

pub fun plan_free(alloc: *A.Allocator, state: *u8, order: *u32, n: u32) {
    A.deallocate[u8](alloc, state, n::usize);
    A.deallocate[u32](alloc, order, n::usize);
}

pub fun plan_finish(alloc: *A.Allocator, state: *u8, order: *u32, capacity: u32,
    order_len: u32, out_order: **u32, out_count: *u32) err[outcome.Fail] {
    A.deallocate[u8](alloc, state, capacity::usize);
    if (order_len == 0) {
        A.deallocate[u32](alloc, order, capacity::usize);
        ret err[outcome.Fail].ok{};
    }
    if (order_len == capacity) {
        @out_order = order;
        @out_count = order_len;
        ret err[outcome.Fail].ok{};
    }
    val compact_r: res[*u32, A.Error] = A.allocate[u32](alloc, order_len::usize);
    if (sel compact_r.err) {
        A.deallocate[u32](alloc, order, capacity::usize);
        ret err[outcome.Fail].err{outcome.refused(compact_r.err)};
    }
    val compact: *u32 = compact_r.ok;
    var i:       u32  = 0;
    for (i < order_len) {
        compact[i] = order[i];
        i          = i + 1;
    }
    A.deallocate[u32](alloc, order, capacity::usize);
    @out_order = compact;
    @out_count = order_len;
    ret err[outcome.Fail].ok{};
}

pub fun plan_export_steps(alloc: *A.Allocator, itn: *intern.Interner,
    steps: *StepDef, step_count: u32,
    links: *LinkDef, link_count: u32,
    t: *TargetDef, proj_out: str, v: *TmplVars,
    out_order: **u32, out_count: *u32) err[outcome.Fail] {
    @out_order = nil;
    @out_count = 0;
    if (step_count == 0) { ret err[outcome.Fail].ok{}; }

    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, step_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    var i:     u32 = 0;
    for (i < step_count) {
        state[i] = 0;
        i        = i + 1;
    }

    val or_: res[*u32, A.Error] = A.allocate[u32](alloc, step_count::usize);
    if (sel or_.err) {
        A.deallocate[u8](alloc, state, step_count::usize);
        ret err[outcome.Fail].err{outcome.refused(or_.err)};
    }
    val order:     *u32 = or_.ok;
    var order_len: u32  = 0;

    var li: u32 = 0;
    for (li < link_count) {
        val l: *LinkDef = ?links[li];
        if (l.export && l.source == LINK_LOCAL && link_matches_target(itn, l, t)) {
            val exp_r: res[str, outcome.Fail] = expand_project_path(alloc, idstr(itn, l.path), proj_out, v, "a local link path");
            if (sel exp_r.err) {
                plan_free(alloc, state, order, step_count);
                ret err[outcome.Fail].err{exp_r.err};
            }
            val exp:  str = exp_r.ok;
            val sidx: i64 = step_producing_out(alloc, itn, steps, step_count, exp, proj_out, v);
            str_free(alloc, exp);
            if (sidx >= 0) {
                val vr: err[outcome.Fail] = plan_visit(alloc, itn, steps, step_count, sidx::u32, state, order, ?order_len);
                if (sel vr.err) {
                    plan_free(alloc, state, order, step_count);
                    ret vr;
                }
            }
        }
        li = li + 1;
    }

    ret plan_finish(alloc, state, order, step_count, order_len, out_order, out_count);
}
