}

test "mach.lang.manifest.parse:float_reassoc_is_read_and_validated" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel a.err) { code = 1; }
    if (sel a.ok) {
        var ma: Manifest = a.ok;
        if (ma.profiles[0].float_reassoc) { code = 1; }
        val ra: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?ma, "p");
        if (sel ra.err) { code = 1; }
        if (sel ra.ok) {
            if (ra.ok.float_reassoc) { code = 1; }
        }
    }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=true\nvectorize=true\n"));
    if (sel b.err) { code = 1; }
    if (sel b.ok) {
        var mb: Manifest = b.ok;
        if (!mb.profiles[0].float_reassoc) { code = 1; }
        val rb: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?mb, "p");
        if (sel rb.err) { code = 1; }
        if (sel rb.ok) {
            if (!rb.ok.float_reassoc) { code = 1; }
        }
    }

    val c: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=false\nvectorize=true\n"));
    if (sel c.err) { code = 1; }
    if (sel c.ok) {
        if (c.ok.profiles[0].float_reassoc) { code = 1; }
    }

    val d: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[profile.p]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=\"yes\"\nvectorize=true\n"));
    if (!(sel d.err && str_contains(outcome.describe(d.err), "float_reassoc must be a boolean"))) { code = 1; }

    val e: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, head);
    if (sel e.err) { code = 1; }
    if (sel e.ok) {
        var me: Manifest                           = e.ok;
        val re: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?me, "");
        if (sel re.err) { code = 1; }
        if (sel re.ok) {
            if (re.ok.float_reassoc) { code = 1; }
        }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:profile_selection_contract" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n";

    val root_builtins: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, head);
    if (!(sel root_builtins.err && str_equals(outcome.describe(root_builtins.err), MISSING_PROFILE_MESSAGE))) { code = 1; }

    val builtins: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, head);
    if (sel builtins.err) { code = 1; }
    if (sel builtins.ok) {
        var m: Manifest = builtins.ok;
        if (m.profile_count != 2) { code = 1; }
        or {
            val debug:   *ProfileDef = ?m.profiles[0];
            val release: *ProfileDef = ?m.profiles[1];
            if (!str_equals(idstr(?itn, debug.name), "debug") || !debug.is_default
                || debug.opt != MOPT_DEBUG
                || !debug.debug || debug.simd != SIMD_SCALARIZE || debug.vectorize
                || debug.float_reassoc) { code = 1; }
            if (!str_equals(idstr(?itn, release.name), "release") || release.is_default
                || release.opt != MOPT_RELEASE
                || release.debug || release.simd != SIMD_SCALARIZE || !release.vectorize
                || release.float_reassoc) { code = 1; }

            val omitted:  res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
            val explicit: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "release");
            if (sel omitted.ok) {
                if (sel explicit.ok) {
                    if (!str_equals(idstr(?itn, omitted.ok.name), "debug"))    { code = 1; }
                    if (!str_equals(idstr(?itn, explicit.ok.name), "release")) { code = 1; }
                }
                if (sel explicit.err) { code = 1; }
            }
            if (sel omitted.err) { code = 1; }
        }
    }

    val sole: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.ship]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel sole.err) { code = 1; }
    if (sel sole.ok) {
        var m: Manifest = sole.ok;
        if (m.profile_count != 1 || m.profiles[0].is_default) { code = 1; }
        val omitted: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
        val builtin: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "debug");
        if (!(sel omitted.ok && str_equals(idstr(?itn, omitted.ok.name), "ship"))) { code = 1; }
        if (sel builtin.ok)                                                        { code = 1; }
    }

    val selected: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.first]\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.chosen]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel selected.err) { code = 1; }
    if (sel selected.ok) {
        var m:        Manifest                           = selected.ok;
        val omitted:  res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
        val explicit: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "first");
        if (sel omitted.ok) {
            if (sel explicit.ok) {
                if (!str_equals(idstr(?itn, omitted.ok.name), "chosen")) { code = 1; }
                if (!str_equals(idstr(?itn, explicit.ok.name), "first")) { code = 1; }
            }
            if (sel explicit.err) { code = 1; }
        }
        if (sel omitted.err) { code = 1; }
    }

    val missing: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.b]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (sel missing.err) { code = 1; }
    if (sel missing.ok) {
        var mm:          Manifest                           = missing.ok;
        val omitted_sel: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?mm, "");
        if (!(sel omitted_sel.err && str_contains(outcome.describe(omitted_sel.err), "several profiles are declared and none is marked `default = true`"))) { code = 1; }
        val explicit_sel: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?mm, "a");
        if (sel explicit_sel.err) { code = 1; }
        if (sel explicit_sel.ok) {
            if (!str_equals(idstr(?itn, explicit_sel.ok.name), "a")) { code = 1; }
        }
    }

    val repeated: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.b]\ndefault=true\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel repeated.err && str_contains(outcome.describe(repeated.err), "exactly one is allowed"))) { code = 1; }

    val typed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\ndefault=\"yes\"\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel typed.err && str_contains(outcome.describe(typed.err), "default must be a boolean"))) { code = 1; }

    val source: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[profile.a]\nopt=0\nvectorize=true\nfloat_reassoc=false\n[profile.b]\nopt=2\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel source.err && str_contains(outcome.describe(source.err), "[profile.a] is missing required key 'debug'"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:default_profile" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var s1: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink = []\nneed = []\n[profile.debug]\nopt=0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    s1 = sfmt(?alloc, "{}{}", s1, host_target_stanza(?alloc, "h"));
    val r1: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, s1);
    if (sel r1.err) { code = 1; }
    if (sel r1.ok) {
        var m1: Manifest                     = r1.ok;
        val u1: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m1, mk_sel("native", "", "app", false, true));
        if (sel u1.err) { code = 1; }
        if (sel u1.ok) {
            if (!str_equals(idstr(?itn, u1.ok.profile_name), "debug")) { code = 1; }
        }
    }

    var s2: str = "[project]\nid=\"y\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    s2 = sfmt(?alloc, "{}{}", s2, host_target_stanza(?alloc, "h"));
    val r2: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, s2);
    if (sel r2.err) { code = 1; }
    if (sel r2.ok) {
        var m2: Manifest                     = r2.ok;
        val u2: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m2, mk_sel("native", "", "app", false, true));
        if (sel u2.err) { code = 1; }
        if (sel u2.ok) {
            if (!str_equals(idstr(?itn, u2.ok.profile_name), "debug")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:simd_posture" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink = []\nneed = []\n";

    var req: str = sfmt(?alloc, "{}{}", "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n", art);
    req = sfmt(?alloc, "{}{}", req, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"require\"\nvectorize=true\nfloat_reassoc=false\n");
    req = sfmt(?alloc, "{}{}", req, host_target_stanza(?alloc, "h"));
    val rr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, req);
    if (sel rr.err) { code = 1; }
    if (sel rr.ok) {
        var m: Manifest                     = rr.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_REQUIRE) { code = 1; }
        }
    }

    var scl: str = sfmt(?alloc, "{}{}", "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n", art);
    scl = sfmt(?alloc, "{}{}", scl, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    scl = sfmt(?alloc, "{}{}", scl, host_target_stanza(?alloc, "h"));
    val rs: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, scl);
    if (sel rs.err) { code = 1; }
    if (sel rs.ok) {
        var m: Manifest                     = rs.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_SCALARIZE) { code = 1; }
        }
    }

    var non: str = sfmt(?alloc, "{}{}", "[project]\nid=\"y\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n", art);
    non = sfmt(?alloc, "{}{}", non, host_target_stanza(?alloc, "h"));
    val rn: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, non);
    if (sel rn.err) { code = 1; }
    if (sel rn.ok) {
        var m: Manifest                     = rn.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_SCALARIZE) { code = 1; }
        }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:native_resolution_multi_match" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var src: str = "[project]\nid = \"x\"\nversion = \"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    src = sfmt(?alloc, "{}{}", src, host_target_stanza(?alloc, "alpha"));
    src = sfmt(?alloc, "{}{}", src, host_target_stanza(?alloc, "beta"));

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest                     = res_manifest.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (!(sel u.err && str_contains(outcome.describe(u.err), "matches multiple targets"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:native_resolution_exact" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var src: str = "[project]\nid = \"x\"\nversion = \"1\"\nsrc=\"src\"\nout=\"out\"\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    src = sfmt(?alloc, "{}{}", src, "[target.foreign]\nisa = \"nonesuch\"\nos = \"nonesuch\"\nabi = \"x\"\n");
    src = sfmt(?alloc, "{}{}", src, host_target_stanza(?alloc, "host"));

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest                     = res_manifest.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            val bu: BuildUnit = u.ok;
            if (bu.warned)                                        { code = 1; }
            if (!str_equals(idstr(?itn, bu.target_name), "host")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:native_resolution_zero_target" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid = \"x\"\nversion = \"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (m.target_count != 0) { code = 1; }

        val ue: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "app", false, true));
        if (sel ue.err) { code = 1; }

        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            val bu: BuildUnit = u.ok;
            if (bu.warned)                                                                    { code = 1; }
            if (!str_equals(idstr(?itn, bu.target_name), "native"))                           { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.isa), host_isa_name()))                     { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.os), host_os_name()))                       { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.abi), abi.abi_name_for(tgt.host_abi_id()))) { code = 1; }
            if (!str_equals(idstr(?itn, bu.obj_root), "out/native/obj"))                      { code = 1; }
        }

        val uf: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("foreign", "", "app", false, true));
        if (!(sel uf.err && str_contains(outcome.describe(uf.err), "no target named"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:collision_detection" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"bin/app\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.a]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.b]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest          = res_manifest.ok;
        var v:  TmplVars          = tmpl_vars_of(?itn, ?m.targets[0], "debug");
        val cr: err[outcome.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (!(sel cr.err && str_equals(outcome.describe(cr.err), "mach.toml: artifacts 'a' and 'b' collide on output path 'bin/app/app'"))) { code = 1; }
    }

    val res_clean: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app1\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.tool]\nkind=\"bin\"\nentry=\"tool.mach\"\nout=\"bin/app2\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel res_clean.err) { code = 1; }
    if (sel res_clean.ok) {
        var m:  Manifest          = res_clean.ok;
        var v:  TmplVars          = tmpl_vars_of(?itn, ?m.targets[0], "debug");
        val cr: err[outcome.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (sel cr.err) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:ambiguous_artifact" {
