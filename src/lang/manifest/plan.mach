test local_path_demanded_by_step__matches_only_a_step_output {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[step.shim]\nargv=[\"cc\",\"-c\",\"shim.c\"]\nin=[\"shim.c\"]\nout=[\"{project.out}/obj/shim.o\"]\nneed=[]\n", "");
    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:    Manifest             = res_manifest.ok;
        var v:    template.Values      = template.t_values("linux", "x86_64", "linux", "sysv64", "debug");
        val shim: res[bool, fail.Fail] = local_path_demanded_by_step(?alloc, ?itn, ?m, "out/linux/obj/shim.o", "out/linux", ?v);
        val nope: res[bool, fail.Fail] = local_path_demanded_by_step(?alloc, ?itn, ?m, "out/linux/obj/nope.o", "out/linux", ?v);
        if (sel shim.ok) {
            if (!shim.ok) { code = 1; }
        }
        or { code = 1; }
        if (sel nope.ok) {
            if (nope.ok) { code = 1; }
        }
        or { code = 1; }
        val at:   res[i64, fail.Fail] = step_producing_out(?alloc, ?itn, ?m, "out/linux/obj/shim.o", "out/linux", ?v);
        val none: res[i64, fail.Fail] = step_producing_out(?alloc, ?itn, ?m, "out/linux/obj/nope.o", "out/linux", ?v);
        if (sel at.ok) {
            if (at.ok != 0) { code = 1; }
        }
        or { code = 1; }
        if (sel none.ok) {
            if (none.ok != -1) { code = 1; }
        }
        or { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test plan_steps__orders_needs_and_skips_links_off_target {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.obj]\nsource=\"local\"\npath=\"{project.out}/o/a.o\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=[\"windows\"]\nisa=[\"*\"]\nabi=[\"*\"]\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[\"obj\",\"win\"]\nneed=[\"step.gen\"]\n[step.compile]\nargv=[\"cc\"]\nin=[\"a.c\"]\nout=[\"{project.out}/o/a.o\"]\n[step.winc]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n[step.gen]\nargv=[\"g\"]\nin=[\"g.in\"]\nout=[\"{project.out}/g.h\"]\nneed=[\"step.dep*\"]\n[step.dep]\nargv=[\"d\"]\nin=[\"d.in\"]\nout=[\"{project.out}/d.o\"]\n", "");
    val rm:  res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel rm.err) { code = 1; }
    if (sel rm.ok) {
        var m:  Manifest   = rm.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var names: [1]intern.StrId;
            names[0] = t_id(?itn, "app");
            var order: *u32            = nil;
            var count: u32             = 0;
            var v:     template.Values = template.values_of(?itn, tl, "debug");
            val r:     err[fail.Fail]  = plan_steps(?alloc, ?itn, ?m, ?names[0], 1, tl, "out/linux", ?v, ?order, ?count);
            if (sel r.err) { code = 1; }
            if (sel r.ok) {
                var has_compile: bool = false;
                var has_gen:     bool = false;
                var has_dep:     bool = false;
                var has_winc:    bool = false;
                var gen_pos:     i64  = -1;
                var dep_pos:     i64  = -1;
                var k:           u32  = 0;
                for (k < count) {
                    val nm: str = intern.text(?itn, m.steps[order[k]].name);
                    if (str_equals(nm, "compile")) { has_compile = true; }
                    if (str_equals(nm, "gen")) {
                        has_gen = true;
                        gen_pos = k::i64;
                    }
                    if (str_equals(nm, "dep")) {
                        has_dep = true;
                        dep_pos = k::i64;
                    }
                    if (str_equals(nm, "winc")) { has_winc = true; }
                    k = k + 1;
                }
                if (count != 3)                                      { code = 1; }
                if (!has_compile || !has_gen || !has_dep)            { code = 1; }
                if (has_winc)                                        { code = 1; }
                if (dep_pos < 0 || gen_pos < 0 || dep_pos > gen_pos) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test plan_export_steps__plans_only_exported_links_on_target {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/o/m.o\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[link.noexp]\nsource=\"local\"\npath=\"{project.out}/o/n.o\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=[\"windows\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[step.mk]\nargv=[\"cc\"]\nin=[\"m.c\"]\nout=[\"{project.out}/o/m.o\"]\n[step.no]\nargv=[\"cc\"]\nin=[\"n.c\"]\nout=[\"{project.out}/o/n.o\"]\n[step.winmk]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n", "");
    val rm:  res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel rm.err) { code = 1; }
    if (sel rm.ok) {
        var m:  Manifest   = rm.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var order: *u32            = nil;
            var count: u32             = 0;
            var v:     template.Values = template.values_of(?itn, tl, "debug");
            val r:     err[fail.Fail]  = plan_export_steps(?alloc, ?itn, ?m, tl, "out/linux", ?v, ?order, ?count);
            if (sel r.err) { code = 1; }
            if (sel r.ok) {
                if (count != 1) { code = 1; }
                or {
                    if (!str_equals(intern.text(?itn, m.steps[order[0]].name), "mk")) { code = 1; }
                }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test step_plans__exact_subset_extent_and_allocation_failure {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    val src:      str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/pick.o\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=true\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"step.pick\"]\n[step.pick]\nargv=[\"pick\"]\nin=[]\nout=[\"{project.out}/pick.o\"]\nneed=[]\n[step.extra_a]\nargv=[\"a\"]\nin=[]\nout=[\"{project.out}/a.o\"]\nneed=[]\n[step.extra_b]\nargv=[\"b\"]\nin=[]\nout=[\"{project.out}/b.o\"]\nneed=[]\n[step.extra_c]\nargv=[\"c\"]\nin=[]\nout=[\"{project.out}/c.o\"]\nneed=[]\n", "");
    val parsed_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel parsed_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var m:      Manifest   = parsed_r.ok;
    val target: *TargetDef = find_target_by_name(?itn, ?m, "linux");
    if (target == nil) {
        arena.dnit(?ar);
        ret 1;
    }
    var v:     template.Values = template.values_of(?itn, target, "debug");
    var names: [1]intern.StrId;
    names[0] = t_id(?itn, "app");
    var bad: bool = false;

    var order: *u32         = nil;
    var count: u32          = 0;
    var t:     T.Testing;
    val made:  err[A.Error] = T.make(?t);
    if (sel made.err) {
        arena.dnit(?ar);
        ret 1;
    }
    T.refuse_reallocates(?t, true);
    val planned: err[fail.Fail] = plan_steps(T.allocator_of(?t), ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
    if (sel planned.err || count != 1 || order == nil) { bad = true; }
    if (order != nil)                                  { A.deallocate[u32](T.allocator_of(?t), order, count::usize); }
    if (T.leaked(?t) || T.double_free_count(?t) != 0)  { bad = true; }
    # the subset plan holds a fixed handful of blocks whatever the other steps, and never reallocates
    if (T.reallocate_count(?t) != 0 || T.peak_live_count(?t) > 5) { bad = true; }
    val attempts: usize = T.attempt_count(?t);

    order = nil;
    count = 0;
    val exported: err[fail.Fail] = plan_export_steps(T.allocator_of(?t), ?itn, ?m, target, "out/linux", ?v, ?order, ?count);
    if (sel exported.err || count != 1 || order == nil) { bad = true; }
    if (order != nil)                                   { A.deallocate[u32](T.allocator_of(?t), order, count::usize); }
    if (T.leaked(?t) || T.double_free_count(?t) != 0)   { bad = true; }
    T.refuse_reallocates(?t, false);

    # every allocation the plan makes, refused in turn, fails the plan and strands nothing
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        T.fail_at_ordinal(?t, T.attempt_count(?t) + ordinal);
        order = nil;
        count = 0;
        val failed: err[fail.Fail] = plan_steps(T.allocator_of(?t), ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
        if (sel failed.ok || order != nil || count != 0)                              { bad = true; }
        if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { bad = true; }
        ordinal = ordinal + 1;
    }
    T.fail_at_ordinal(?t, 0);
    T.dnit(?t);
    arena.dnit(?ar);
    if (bad) { ret 1; }
    ret 0;
}

#[testing]
fun ut_pin_manifest() str {
    ret t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.linux-arm64]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.linux-riscv64]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n[target.darwin-x86_64]\nisa=\"x86_64\"\nos=\"darwin\"\nabi=\"sysv64\"\n[target.darwin-arm64]\nisa=\"aarch64\"\nos=\"darwin\"\nabi=\"aapcs64\"\n[target.kernel]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\n[target.kernel-arm]\nisa=\"aarch64\"\nos=\"freestanding\"\nabi=\"aapcs64\"\n[artifact.kernel]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/kernel\"\ntargets=[\"kernel\"]\nlink=[]\nneed=[]\n[artifact.both]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/both\"\ntargets=[\"kernel\",\"kernel-arm\"]\nlink=[]\nneed=[]\n[artifact.tool]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/tool\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n", "");
}

test resolve_build_unit__sole_target_artifact_pins_it {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, ut_pin_manifest());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;

        val uk: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "kernel", "", "");
        if (sel uk.err) { code = 1; }
        if (sel uk.ok) {
            val u: BuildUnit = uk.ok;
            if (!str_equals(intern.text(?itn, u.target_name), "kernel")) { code = 1; }
        }

        val ut: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "tool", "", "");
        if (sel ut.err) { code = 1; }
        if (sel ut.ok) {
            val u: BuildUnit = ut.ok;
            if (str_equals(intern.text(?itn, u.target_name), "kernel")) { code = 1; }
        }

        val ux: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "kernel", "linux", "");
        if (!(sel ux.err && str_contains(fail.describe(ux.err), "does not support target"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test resolve_build_unit__no_hostable_target_lists_the_candidates {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, ut_pin_manifest());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest                  = res_manifest.ok;
        val ub: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "both", "", "");
        if (sel ub.ok) { code = 1; }
        if (sel ub.err) {
            val e: str = fail.describe(ub.err);
            if (!str_contains(e, "declares no target for this host")) { code = 1; }
            if (!str_contains(e, "kernel-arm"))                       { code = 1; }
            if (!str_contains(e, "with -t"))                          { code = 1; }
        }

        val uk: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "both", "kernel-arm", "");
        if (sel uk.err) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test resolve_target__native_without_a_host_match_is_refused_and_a_declared_target_is_still_selectable {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head:        str = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n", "");
    val art:         str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    var foreign_os:  str = "windows";
    var foreign_abi: str = "win64";
    $if ($mach.build.os == $mach.os.windows) {
        foreign_os  = "linux";
        foreign_abi = "sysv64";
    }
    val w1:     str  = t_fmt(?alloc, "[target.w1]\nisa=\"x86_64\"\nos=\"{}\"\nabi=\"{}\"\n", foreign_os, foreign_abi);
    val w2:     str  = t_fmt(?alloc, "[target.w2]\nisa=\"x86_64\"\nos=\"{}\"\nabi=\"{}\"\n", foreign_os, foreign_abi);
    val native: Cell = cell_of("app", "native", "");

    # a sole foreign target, or several, is refused however they are marked: the host is named
    # with every declared target and the two ways out
    val sole_text: str    = t_fmt(?alloc, "{}{}{}", head, w1, art);
    val several:   str    = t_fmt(?alloc, "{}{}{}{}", head, w1, w2, art);
    val texts:     [2]str = [2]str{sole_text, several};
    var k:         usize  = 0;
    for (k < 2) {
        val nr: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, texts[k]);
        if (sel nr.err) { code = 1; }
        if (sel nr.ok) {
            var m: Manifest                  = nr.ok;
            val u: res[BuildUnit, fail.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, ?native);
            if (sel u.err) {
                val text: str                 = fail.describe(u.err);
                val host: res[str, fail.Fail] = host_tuple(?alloc);
                if (sel host.ok) {
                    if (!str_contains(text, t_fmt(?alloc, "the host is {} ", host.ok))) { code = 1; }
                }
                or                                                                    { code = 1; }
                if (!str_contains(text, t_fmt(?alloc, "w1 ({}-x86_64)", foreign_os))) { code = 1; }
                if (!str_contains(text, "with -t"))                                   { code = 1; }
            }
            or { code = 1; }
            val e: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "w1", "");
            if (!(sel e.ok && str_equals(intern.text(?itn, e.ok.target_name), "w1"))) { code = 1; }
        }
        k = k + 1;
    }

    arena.dnit(?ar);
    ret code;
}

#[testing]
fun t_unit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, artifact: str, target: str,
    profile: str) res[BuildUnit, fail.Fail] {
    var c: Cell = cell_of(artifact, target, profile);
    ret t_resolve_build_unit(alloc, itn, m, ?c);
}

#[testing]
fun t_resolve_build_unit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    selection: *Cell) res[BuildUnit, fail.Fail] {
    var reg:   lang_target.TargetRegistry = lang_target.registry_init();
    val ready: err[fail.Fail]             = lang_target.register_all(?reg, ?target_testing.DEBUG);
    if (sel ready.err) { ret res[BuildUnit, fail.Fail].err{ready.err}; }
    ret resolve_build_unit(alloc, itn, ?reg, m, selection);
}

#[testing]
fun t_check_collisions(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    vars: *template.Values) err[fail.Fail] {
    var reg:   lang_target.TargetRegistry = lang_target.registry_init();
    val ready: err[fail.Fail]             = lang_target.register_all(?reg, ?target_testing.DEBUG);
    if (sel ready.err) { ret err[fail.Fail].err{ready.err}; }
    ret check_collisions(alloc, itn, ?reg, m, vars);
}

#[testing]
fun t_resolve_artifact_reqs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    consumer: *ArtifactDef, consumer_target: *TargetDef, profile: str,
    whole_project: bool, out_items: **template.Requirement, out_count: *u32) err[fail.Fail] {
    var reg:   lang_target.TargetRegistry = lang_target.registry_init();
    val ready: err[fail.Fail]             = lang_target.register_all(?reg, ?target_testing.DEBUG);
    if (sel ready.err) { ret err[fail.Fail].err{ready.err}; }
    var s: Scope = root_scope(m);
    ret resolve_artifact_reqs(alloc, itn, ?reg, ?s, consumer, consumer_target.name, profile,
        whole_project, out_items, out_count);
}

test resolve_build_unit__artifact_suffix_preserves_identity_and_literal_paths {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val src: str = t_fmt(?alloc, "{}{}", need_head(),
        "[target.win]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.literal]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/literal\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n");
    val parsed: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel parsed.err) { ret 2; }
    var m:       Manifest                  = parsed.ok;
    val linux:   res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "host", "debug");
    val windows: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "win", "debug");
    val literal: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "literal", "win", "debug");
    if (sel linux.err)   { ret 3; }
    if (sel windows.err) { ret 3; }
    if (sel literal.err) { ret 3; }
    val lu: BuildUnit = linux.ok;
    val wu: BuildUnit = windows.ok;
    if (!intern.str_same(lu.artifact.name, wu.artifact.name) || !str_equals(intern.text(?itn, wu.artifact.name), "app")) { ret 4; }
    if (!str_equals(intern.text(?itn, lu.bin_path), "out/host/bin/app"))                                                 { ret 5; }
    if (!str_equals(intern.text(?itn, wu.bin_path), "out/win/bin/app.exe"))                                              { ret 6; }
    if (!str_equals(intern.text(?itn, literal.ok.bin_path), "out/win/bin/literal"))                                      { ret 7; }
    var v:           template.Values     = template.values_of(?itn, wu.target, "debug");
    val unavailable: res[str, fail.Fail] = template.expand(?alloc, "{artifact.suffix}", template.CONTEXT_PATH, "out", ?v);
    if (sel unavailable.ok) { ret 8; }
    val alias: res[intern.StrId, A.Error] = intern.add(?itn, "{project.out}/bin/app.exe");
    if (sel alias.err) { ret 9; }
    val other: *ArtifactDef = find_artifact(?itn, ?m, "literal");
    other.out = alias.ok;
    val t_check_collisions_r: err[fail.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
    if (sel t_check_collisions_r.ok) { ret 10; }
    ret 0;
}

test validate_needs__steps_require_only_steps_and_qualified_globs_skip_the_declarer {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val steps: str = "[step.gen-a]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.gen-b]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"step.gen-*\"]\n";
    val app:   str = "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"step.gen-b\"]\n";

    val glob_skips_self: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", need_head(), steps, app));
    if (sel glob_skips_self.err) { ret 2; }
    var m:       Manifest        = glob_skips_self.ok;
    var order:   *u32            = nil;
    var count:   u32             = 0;
    var vars:    template.Values = template.values_of(?itn, ?m.targets[0], "debug");
    val a:       *ArtifactDef    = find_artifact(?itn, ?m, "app");
    val planned: err[fail.Fail]  = plan_steps(?alloc, ?itn, ?m, ?a.name, 1, ?m.targets[0], "out/host", ?vars, ?order, ?count);
    if (sel planned.err)                                                                                                                    { ret 3; }
    if (count != 2)                                                                                                                         { ret 3; }
    if (!str_equals(intern.text(?itn, m.steps[order[0]].name), "gen-a") || !str_equals(intern.text(?itn, m.steps[order[1]].name), "gen-b")) { ret 4; }

    val step_needs_artifact: str = t_fmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "support", "support", ""),
        "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"artifact.support\"]\n");
    if (!need_err(?alloc, ?itn, step_needs_artifact, "[step.gen].need entry 'artifact.support' must use 'step.<name>' or 'artifact.<name>' with optional '*' wildcards; steps may require only steps")) { ret 5; }

    val step_self: str = t_fmt(?alloc, "{}{}", need_head(), "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"step.gen\"]\n");
    if (!need_err(?alloc, ?itn, step_self, "[step.gen].need requires itself")) { ret 6; }

    val step_only_self_glob: str = t_fmt(?alloc, "{}{}", need_head(), "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"step.g*\"]\n");
    if (!need_err(?alloc, ?itn, step_only_self_glob, "[step.gen].need entry 'step.g*' matches no declaration in its category")) { ret 7; }

    val same_name_both: str = t_fmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "twin", "twin", ""),
        "[step.twin]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"step.twin\",\"artifact.twin\"]\n");
    val both: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, same_name_both);
    if (sel both.err) { ret 8; }
    var mb:       Manifest     = both.ok;
    val consumer: *ArtifactDef = find_artifact(?itn, ?mb, "app");
    val twin:     *ArtifactDef = find_artifact(?itn, ?mb, "twin");
    if (!artifact_needs_artifact(?itn, consumer, twin)) { ret 9; }
    var border:   *u32            = nil;
    var bcount:   u32             = 0;
    var bvars:    template.Values = template.values_of(?itn, ?mb.targets[0], "debug");
    val bplanned: err[fail.Fail]  = plan_steps(?alloc, ?itn, ?mb, ?consumer.name, 1, ?mb.targets[0], "out/host", ?bvars, ?border, ?bcount);
    if (sel bplanned.err)                                                 { ret 10; }
    if (bcount != 1)                                                      { ret 10; }
    if (!str_equals(intern.text(?itn, mb.steps[border[0]].name), "twin")) { ret 10; }
    ret 0;
}

#[testing]
fun t_suffix_unit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, target: str, artifact: str) res[BuildUnit, fail.Fail] {
    ret t_unit(alloc, itn, m, artifact, target, "debug");
}

test resolve_build_unit__artifact_suffix_maps_every_kind_on_every_object_format {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val targets:   str                      = "[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.win]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.mac]\nisa=\"aarch64\"\nos=\"darwin\"\nabi=\"aapcs64\"\n[target.raw]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\n[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\n";
    val artifacts: str                      = "[artifact.tool]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/tool{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.archive]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"{project.out}/lib/libarchive{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.dyn]\nkind=\"shared\"\nentry=\"lib.mach\"\nout=\"{project.out}/lib/libdyn{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val parsed:    res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_fmt(?alloc, "{}{}{}", need_head(), targets, artifacts));
    if (sel parsed.err) { ret 2; }
    var m: Manifest = parsed.ok;

    var names: [15]str;
    var kinds: [15]str;
    var wants: [15]str;
    var tn:    [5]str;
    tn[0] = "linux";
    tn[1] = "win";
    tn[2] = "mac";
    tn[3] = "raw";
    tn[4] = "gpu";
    var exe: [5]str;
    exe[0] = "out/linux/bin/tool";
    exe[1] = "out/win/bin/tool.exe";
    exe[2] = "out/mac/bin/tool";
    exe[3] = "out/raw/bin/tool";
    exe[4] = "out/gpu/bin/tool.spv";
    var sta: [5]str;
    sta[0] = "out/linux/lib/libarchive.a";
    sta[1] = "out/win/lib/libarchive.lib";
    sta[2] = "out/mac/lib/libarchive.a";
    sta[3] = "";
    sta[4] = "";
    var shd: [5]str;
    shd[0] = "out/linux/lib/libdyn.so";
    shd[1] = "out/win/lib/libdyn.dll";
    shd[2] = "out/mac/lib/libdyn.dylib";
    shd[3] = "";
    shd[4] = "";
    var i: usize = 0;
    for (i < 5) {
        names[i * 3]     = tn[i];
        kinds[i * 3]     = "tool";
        wants[i * 3]     = exe[i];
        names[i * 3 + 1] = tn[i];
        kinds[i * 3 + 1] = "archive";
        wants[i * 3 + 1] = sta[i];
        names[i * 3 + 2] = tn[i];
        kinds[i * 3 + 2] = "dyn";
        wants[i * 3 + 2] = shd[i];
        i                = i + 1;
    }
    i = 0;
    for (i < 15) {
        val u: res[BuildUnit, fail.Fail] = t_suffix_unit(?alloc, ?itn, ?m, names[i], kinds[i]);
        if (str_empty(wants[i])) {
            if (sel u.ok)                                                                          { ret 10 + i::i32; }
            if (!str_contains(fail.describe(u.err), "artifact naming: this object format has no")) { ret 10 + i::i32; }
        }
        or {
            if (sel u.err)                                               { ret 30 + i::i32; }
            if (!str_equals(intern.text(?itn, u.ok.bin_path), wants[i])) { ret 50 + i::i32; }
        }
        i = i + 1;
    }
    ret 0;
}

# `{artifact.suffix}` names the output of the artifact whose own `out` it is
# written in; anywhere else the manifest is refused when it is read
test parse__artifact_suffix_is_refused_outside_an_artifact_output {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val project_out: str = t_fmt(?alloc, "{}{}", "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{artifact.suffix}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n");
    val step_out: str = t_fmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"step.gen\"]\n[step.gen]\nargv=[\"true\"]\nin=[]\nout=[\"{project.out}/gen{artifact.suffix}\"]\nneed=[]\n");
    var srcs: [2]str = [2]str{project_out, step_out};
    var i:    usize  = 0;
    for (i < 2) {
        val parsed: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, srcs[i]);
        if (sel parsed.ok)                                                                       { ret 2; }
        if (fail.kind_of(parsed.err) != diagnostic_kind.TEMPLATE_UNAVAILABLE)                    { ret 3; }
        if (!str_contains(fail.describe(parsed.err), "available only in an artifact's own out")) { ret 4; }
        i = i + 1;
    }
    ret 0;
}
