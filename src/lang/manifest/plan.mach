# the library shape of a build unit, decoded from `[artifact.<name>].kind`
pub def LibKind: u8;

# `kind = "static"`; also the value a `bin` unit carries, so check `is_lib` first
pub val LIBKIND_STATIC: LibKind = 0;
# `kind = "shared"`
pub val LIBKIND_SHARED: LibKind = 1;

# what the caller asked to build: a target, a profile, and optionally an
# artifact. empty strings mean "not selected"
# ---
# target:       a declared target name, or "" to resolve `native` (or the artifact's pinned target)
# profile:      a declared profile name, or "" for the default profile
# artifact:     an artifact name, read only when `has_artifact`
# want_lib:     with `has_artifact`, whether the named artifact must be a library
#               (true) or a `bin` (false); a name with the wrong shape does not match
# has_artifact: whether `artifact` and `want_lib` are set
pub rec Selection {
    target:       str;
    profile:      str;
    artifact:     str;
    want_lib:     bool;
    has_artifact: bool;
}

# one resolved build cell: a target, a profile, and an artifact with every path
# expanded. produced by `resolve_build_unit`; `libs` is owned by the unit
# ---
# target:        the resolved target; points into the manifest, except for the host
#                target synthesized when the manifest declares no targets
# artifact:      the resolved artifact, pointing into the manifest
# target_name:   `target.name`
# profile_name:  the resolved profile's name
# entry:         the artifact's `entry`
# bin_path:      the artifact's output: the expanded `[project].out` joined with the
#                expanded artifact `out`
# obj_root:      `<expanded project out>/obj`
# ir_root:       `<expanded project out>/ir`
# asm_root:      `<expanded project out>/asm`
# test_root:     `<expanded project out>/test/{name}`, with `{name}` left literal for
#                the test runner to fill
# cache_root:    `<expanded project out>/.cache`, the compiler-only state
# stage_root:    `<expanded project out>/.stage`, the build step scratch space
# opt:           from the resolved profile
# debug:         from the resolved profile
# simd:          from the resolved profile
# vectorize:     from the resolved profile
# float_reassoc: from the resolved profile
# is_lib:        the artifact's `is_lib`
# kind:          LIBKIND_SHARED for `kind = "shared"`, LIBKIND_STATIC otherwise, including for a `bin`
# libs:          the artifact's `link` entries that match the target, resolved in `link`
#                order and sized exactly; a `link` name matching no `[link.*]` table is skipped
# lib_count:     length of `libs`
# warned:        `native` matched no declared target for the host and a declared target
#                was chosen anyway; the driver prints the warning
pub rec BuildUnit {
    target:        *TargetDef;
    artifact:      *ArtifactDef;
    target_name:   intern.StrId;
    profile_name:  intern.StrId;
    entry:         intern.StrId;
    bin_path:      intern.StrId;
    obj_root:      intern.StrId;
    ir_root:       intern.StrId;
    asm_root:      intern.StrId;
    test_root:     intern.StrId;
    cache_root:    intern.StrId;
    stage_root:    intern.StrId;
    opt:           MOpt;
    debug:         bool;
    simd:          SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
    is_lib:        bool;
    kind:          LibKind;
    libs:          *LinkRequirement;
    lib_count:     u32;
    warned:        bool;
}

# the manifest that declares a build cell, and the root project the cell is built
# for. a root cell has `owner == root`. a dependency's cell is one of the
# requirements its default library artifacts carry: it resolves its artifact,
# targets and links in `owner`, its profile in `root`, expands the root's
# `[project].out`, and homes its artifact outputs under `dep/<owner id>` of that
# out, so identically named artifacts of two dependencies never share a path
# ---
# root:  the manifest of the project being built
# owner: the manifest declaring the cell's artifact; `root` for the root's own
pub rec Scope {
    root:  *Manifest;
    owner: *Manifest;
}

# the directory under the expanded root `[project].out` that holds a dependency's
# artifact outputs, one subdirectory per dependency id
pub val DEPENDENCY_ARTIFACT_DIR: str = "dep";

# the directory under the expanded `[project].out` that holds compiler-only state:
# nothing but the compiler reads or writes it, and a step output may not name it
pub val CACHE_DIR: str = ".cache";

# the directory under `CACHE_DIR` that holds one fingerprint stamp per build step
pub val STEP_STAMP_DIR: str = ".cache/steps";

# the directory under the expanded `[project].out` that holds build step scratch
# space, one subdirectory per step, reset before the step runs
pub val STAGE_DIR: str = ".stage";

pub fun root_scope(m: *Manifest) Scope {
    ret Scope{root: m, owner: m};
}

pub fun dependency_scope(root: *Manifest, owner: *Manifest) Scope {
    ret Scope{root: root, owner: owner};
}

pub fun scope_is_dependency(s: *Scope) bool {
    ret s.owner != s.root;
}

# the directory a scope's artifact outputs are rooted in
# ---
# alloc:    owns the returned path
# itn:      resolves the owner id
# s:        the scope
# proj_out: the expanded root `[project].out`
# ret:      `proj_out` for the root, `<proj_out>/dep/<owner id>` for a dependency
fun scope_artifact_root(alloc: *A.Allocator, itn: *intern.Interner, s: *Scope, proj_out: str) str {
    if (!scope_is_dependency(s)) { ret seg_dup(alloc, proj_out, 0, str_len(proj_out)); }
    val home:  str = join_path_canonical(alloc, proj_out, DEPENDENCY_ARTIFACT_DIR);
    val owned: str = join_path_canonical(alloc, home, idstr(itn, s.owner.id));
    str_free(alloc, home);
    ret owned;
}

# the outcome of target resolution for a selection
# ---
# target: the chosen target; points into the manifest unless synthesized for a
#         manifest with no `[target.*]`, in which case it is allocated and never freed by `dnit`
# warned: `native` matched no host target and a declared target was chosen anyway
# target borrows its manifest-owned declaration until manifest destruction
pub rec ResolvedTarget {
    target: *TargetDef;
    warned: bool;
}

# the profile a selection resolves to, copied out of its `ProfileDef`
# ---
# name:          the profile's name
# opt:           as `ProfileDef`
# debug:         as `ProfileDef`
# simd:          as `ProfileDef`
# vectorize:     as `ProfileDef`
# float_reassoc: as `ProfileDef`
pub rec ResolvedProfile {
    name:          intern.StrId;
    opt:           MOpt;
    debug:         bool;
    simd:          SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
}

fun free_path_strings(alloc: *A.Allocator, paths: *str, count: u32) {
    if (paths == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (paths[i] != nil) { str_free(alloc, paths[i]); }
        i = i + 1;
    }
}

fun seg_dup(alloc: *A.Allocator, tmpl: str, start: usize, end: usize) str {
    val n:       usize             = end - start;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](alloc, n + 1);
    if (sel res_buf.err) { ret ""; }
    val buf: *u8   = res_buf.ok;
    var i:   usize = 0;
    for (i < n) {
        buf[i] = tmpl[start + i];
        i      = i + 1;
    }
    buf[n] = 0;
    ret buf::str;
}

fun artifact_pinned_target(itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) *TargetDef {
    val host_os:   u32 = tgt.host_os_id();
    val host_arch: u32 = tgt.host_arch_id();

    var only:       *TargetDef = nil;
    var count:      u32        = 0;
    var host_first: *TargetDef = nil;
    var host_count: u32        = 0;
    var i:          u32        = 0;
    for (i < m.target_count) {
        if (artifact_supports_target(itn, a, m.targets[i].name)) {
            if (count == 0) { only = ?m.targets[i]; }
            count = count + 1;
            if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) {
                if (host_count == 0) { host_first = ?m.targets[i]; }
                host_count = host_count + 1;
            }
        }
        i = i + 1;
    }
    if (count == 1)      { ret only; }
    if (host_count == 1) { ret host_first; }
    ret nil;
}

fun artifact_target_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.target_count) {
        if (artifact_supports_target(itn, a, m.targets[i].name)) {
            if (!str_empty(s)) { s = sfmt(alloc, "{}, ", s); }
            val opt_name: opt[str] = intern.lookup(itn, m.targets[i].name);
            if (sel opt_name.some) { s = sfmt(alloc, "{}{}", s, opt_name.some); }
        }
        i = i + 1;
    }
    ret s;
}

fun resolve_target(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, selector: str,
    art: *ArtifactDef) res[ResolvedTarget, outcome.Fail] {
    val host_os:   u32 = tgt.host_os_id();
    val host_arch: u32 = tgt.host_arch_id();

    if (str_empty(selector) && art != nil) {
        val pinned: *TargetDef = artifact_pinned_target(itn, m, art);
        if (pinned != nil) {
            var rt: ResolvedTarget;
            rt.target = pinned;
            rt.warned = false;
            ret res[ResolvedTarget, outcome.Fail].ok{rt};
        }
    }

    var name: str = selector;
    if (str_empty(name)) {
        val opt_target: opt[str] = intern.lookup(itn, m.default_target);
        if (sel opt_target.none) { ret res[ResolvedTarget, outcome.Fail].err{outcome.user("internal: default target not interned")}; }
        name = opt_target.some;
    }

    if (!str_equals(name, "native")) {
        val d: *TargetDef = find_target_by_name(itn, m, name);
        if (d == nil) { ret res[ResolvedTarget, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: no target named '{}'", name))}; }
        var rt: ResolvedTarget;
        rt.target = d;
        rt.warned = false;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }

    var first_match: *TargetDef = nil;
    var match_count: u32        = 0;
    var names:       str        = "";
    var i:           u32        = 0;
    for (i < m.target_count) {
        if (target_matches_host(itn, ?m.targets[i], host_os, host_arch)) {
            if (first_match == nil) { first_match = ?m.targets[i]; }
            if (match_count > 0)    { names = sfmt(alloc, "{}, ", names); }
            val opt_name: opt[str] = intern.lookup(itn, m.targets[i].name);
            if (sel opt_name.some) { names = sfmt(alloc, "{}{}", names, opt_name.some); }
            match_count = match_count + 1;
        }
        i = i + 1;
    }

    if (match_count > 1) {
        ret res[ResolvedTarget, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: 'native' matches multiple targets for the host ({})", names))};
    }
    var rt: ResolvedTarget;
    if (match_count == 1) {
        rt.target = first_match;
        rt.warned = false;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }
    if (m.target_count > 1) {
        var chosen:        *TargetDef = nil;
        var default_count: u32        = 0;
        i = 0;
        for (i < m.target_count) {
            if (m.targets[i].is_default) {
                default_count = default_count + 1;
                chosen        = ?m.targets[i];
            }
            i = i + 1;
        }
        if (default_count > 1) {
            ret res[ResolvedTarget, outcome.Fail].err{outcome.user("mach.toml: multiple declared targets have 'default = true'; exactly one is allowed")};
        }
        if (chosen == nil) {
            ret res[ResolvedTarget, outcome.Fail].err{outcome.user(AMBIGUOUS_TARGET_MSG)};
        }
        rt.target = chosen;
        rt.warned = true;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }
    if (m.target_count == 0) {
        if (m.native_target == nil) { ret res[ResolvedTarget, outcome.Fail].err{outcome.user("internal: manifest has no native target owner")}; }
        rt.target = m.native_target;
        rt.warned = false;
        ret res[ResolvedTarget, outcome.Fail].ok{rt};
    }
    rt.target = ?m.targets[0];
    rt.warned = true;
    ret res[ResolvedTarget, outcome.Fail].ok{rt};
}

fun profile_resolved(pf: *ProfileDef) ResolvedProfile {
    var rp: ResolvedProfile;
    rp.name          = pf.name;
    rp.opt           = pf.opt;
    rp.debug         = pf.debug;
    rp.simd          = pf.simd;
    rp.vectorize     = pf.vectorize;
    rp.float_reassoc = pf.float_reassoc;
    ret rp;
}

# choose the profile a selection names. a named profile must be declared, except
# that a dependency manifest with no profiles at all answers "debug" and
# "release" with the synthesized ones. an empty name takes the sole declared
# profile, else the one with `default = true`, else the synthesized debug
# profile of a dependency manifest. several declared profiles with none marked
# default are refused: no profile is ever selected by table order
# ---
# alloc: owns error text
# itn:   interns the name
# m:     the manifest
# pick:  the profile name, or "" for the default
# ret:   the profile; err "mach.toml: no profile named '<pick>'" or, with an empty
#        name, an error when more than one profile is marked default
pub fun resolve_profile(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, pick: str) res[ResolvedProfile, outcome.Fail] {
    if (!str_empty(pick)) {
        val res_id: res[intern.StrId, A.Error] = intern.intern(itn, pick);
        if (sel res_id.err) { ret res[ResolvedProfile, outcome.Fail].err{outcome.refused(res_id.err)}; }
        val id: intern.StrId = res_id.ok;
        var i:  u32          = 0;
        for (i < m.profile_count) {
            if (m.profiles[i].name == id) { ret res[ResolvedProfile, outcome.Fail].ok{profile_resolved(?m.profiles[i])}; }
            i = i + 1;
        }
        if (m.profile_count == 0 && str_equals(pick, "debug")) {
            var debug: ProfileDef = builtin_profile(itn, "debug", MOPT_DEBUG, true, false, true);
            ret res[ResolvedProfile, outcome.Fail].ok{profile_resolved(?debug)};
        }
        if (m.profile_count == 0 && str_equals(pick, "release")) {
            var release: ProfileDef = builtin_profile(itn, "release", MOPT_RELEASE, false, true, false);
            ret res[ResolvedProfile, outcome.Fail].ok{profile_resolved(?release)};
        }
        ret res[ResolvedProfile, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: no profile named '{}'", pick))};
    }

    if (m.profile_count == 1) {
        ret res[ResolvedProfile, outcome.Fail].ok{profile_resolved(?m.profiles[0])};
    }

    if (m.profile_count > 1) {
        var i:     u32         = 0;
        var found: *ProfileDef = nil;
        for (i < m.profile_count) {
            if (m.profiles[i].is_default) {
                if (found != nil) {
                    ret res[ResolvedProfile, outcome.Fail].err{outcome.user("mach.toml: multiple declared profiles have 'default = true'; exactly one is allowed")};
                }
                found = ?m.profiles[i];
            }
            i = i + 1;
        }
        if (found == nil) {
            ret res[ResolvedProfile, outcome.Fail].err{outcome.user(AMBIGUOUS_PROFILE_MSG)};
        }
        ret res[ResolvedProfile, outcome.Fail].ok{profile_resolved(found)};
    }

    var debug: ProfileDef = builtin_profile(itn, "debug", MOPT_DEBUG, true, false, true);
    ret res[ResolvedProfile, outcome.Fail].ok{profile_resolved(?debug)};
}

# the artifact a selection names: with `has_artifact`, the one whose name and
# `is_lib` both match `pick`; otherwise the sole declared artifact
# ---
# itn:  interns the name
# m:    the manifest
# pick: the selection
# ret:  the artifact, or nil when none is declared, the name has no match of
#       the requested shape, or several artifacts are declared and none was named
pub fun resolve_artifact(itn: *intern.Interner, m: *Manifest, pick: Selection) *ArtifactDef {
    if (m.artifact_count == 0) { ret nil; }

    if (pick.has_artifact) {
        val res_id: res[intern.StrId, A.Error] = intern.intern(itn, pick.artifact);
        if (sel res_id.err) { ret nil; }
        val id: intern.StrId = res_id.ok;
        var i:  u32          = 0;
        for (i < m.artifact_count) {
            if (m.artifacts[i].name == id && m.artifacts[i].is_lib == pick.want_lib) { ret ?m.artifacts[i]; }
            i = i + 1;
        }
        ret nil;
    }

    if (m.artifact_count == 1) { ret ?m.artifacts[0]; }
    ret nil;
}

fun join_path_canonical(alloc: *A.Allocator, a: str, b: str) str {
    if (str_empty(a)) { ret seg_dup(alloc, b, 0, str_len(b)); }
    if (str_empty(b)) { ret seg_dup(alloc, a, 0, str_len(a)); }
    val al:    usize = str_len(a);
    var end_a: usize = al;
    if (a[al - 1] == '/') { end_a = al - 1; }
    var start_b: usize = 0;
    if (b[0] == '/') { start_b = 1; }

    val a_sub:  str = seg_dup(alloc, a, 0, end_a);
    val b_sub:  str = seg_dup(alloc, b, start_b, str_len(b));
    val joined: str = sfmt(alloc, "{}/{}", a_sub, b_sub);
    str_free(alloc, a_sub);
    str_free(alloc, b_sub);
    ret joined;
}

# find the build step whose expanded `out` list contains a path
# ---
# alloc:         owns temporary expansions
# itn:           resolves step strings
# m:             the manifest
# expanded_path: the path to match, already expanded
# proj_out:      the expanded `[project].out`
# v:             the template values
# ret:           the index into `m.steps` of the first producing step, or -1. a step
#                output that fails to expand is skipped
fun step_producing_out(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    expanded_path: str, proj_out: str, v: *TmplVars) i64 {
    var si: u32 = 0;
    for (si < m.step_count) {
        val s:  *StepDef = ?m.steps[si];
        var oi: u32      = 0;
        for (oi < s.out_count) {
            val raw_out: str                    = idstr(itn, s.out[oi]);
            val exp_r:   res[str, outcome.Fail] = expand_project_path(alloc, raw_out, proj_out, v, "a build step output");
            if (sel exp_r.ok) {
                val exp: str  = exp_r.ok;
                val eq:  bool = str_equals(exp, expanded_path);
                str_free(alloc, exp);
                if (eq) { ret si::i64; }
            }
            oi = oi + 1;
        }
        si = si + 1;
    }
    ret -1;
}

# whether some build step produces a path; `step_producing_out` as a bool
# ---
# alloc:         owns temporary expansions
# itn:           resolves step strings
# m:             the manifest
# expanded_path: the path to match, already expanded
# proj_out:      the expanded `[project].out`
# v:             the template values
# ret:           true when a step lists the path in `out`
pub fun local_path_demanded_by_step(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    expanded_path: str, proj_out: str, v: *TmplVars) bool {
    ret step_producing_out(alloc, itn, m, expanded_path, proj_out, v) >= 0;
}

# whether a required artifact is built for a target when its consumer builds for
# `consumer_target`: only that target when `req` supports it, otherwise every
# target `req` supports
# ---
# itn:             interns "*"
# req:             the required artifact
# consumer_target: the consumer's target name, or STR_NIL for a consumer outside
#                  `req`'s manifest, which admits every target `req` supports
# t:               the target asked about
# ret:             true when `req` is built for `t` on behalf of that consumer
pub fun required_artifact_uses_target(itn: *intern.Interner, req: *ArtifactDef,
    consumer_target: intern.StrId, t: *TargetDef) bool {
    if (consumer_target != intern.STR_NIL && artifact_supports_target(itn, req, consumer_target)) {
        ret t.name == consumer_target;
    }
    ret artifact_supports_target(itn, req, t.name);
}

# how many declared targets `required_artifact_uses_target` admits for a requirement
# ---
# itn:             interns "*"
# m:               the manifest
# req:             the required artifact
# consumer_target: the consumer's target name
# ret:             the count; 1 means `{artifact.<id>.out}` has a single answer
fun required_artifact_target_count(itn: *intern.Interner, m: *Manifest, req: *ArtifactDef,
    consumer_target: intern.StrId) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < m.target_count) {
        if (required_artifact_uses_target(itn, req, consumer_target, ?m.targets[i])) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun artifact_out_for_target(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry, s: *Scope,
    a: *ArtifactDef, t: *TargetDef, profile: str) res[str, outcome.Fail] {
    var v: TmplVars = tmpl_vars_of(itn, t, profile);

    val out_tmpl_r: res[str, outcome.Fail] = must_lookup(itn, s.root.out_tmpl);
    if (sel out_tmpl_r.err) { ret out_tmpl_r; }
    val proj_out_r: res[str, outcome.Fail] = expand_project_path(alloc, out_tmpl_r.ok, "", ?v, "[project].out");
    if (sel proj_out_r.err) { ret proj_out_r; }
    val proj_out: str = proj_out_r.ok;

    val art_out_r: res[str, outcome.Fail] = expand_artifact_output(alloc, itn, reg, a, proj_out, ?v);
    if (sel art_out_r.err) {
        str_free(alloc, proj_out);
        ret art_out_r;
    }
    val art_out:  str = art_out_r.ok;
    val art_root: str = scope_artifact_root(alloc, itn, s, proj_out);

    val joined: str = join_path_canonical(alloc, art_root, art_out);
    str_free(alloc, art_root);
    str_free(alloc, art_out);
    str_free(alloc, proj_out);
    ret res[str, outcome.Fail].ok{joined};
}

# whether any artifact's `need` selects `ra`
# ---
# itn: resolves the names
# m:   the manifest
# ra:  the candidate requirement
# ret: true when some other artifact needs it
pub fun artifact_required_by_any(itn: *intern.Interner, m: *Manifest, ra: *ArtifactDef) bool {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (artifact_needs_artifact(itn, ?m.artifacts[i], ra)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a library artifact marked `default = true` selects `ra` in its `need`:
# the requirements a dependency's default library carries to every consumer
# ---
# itn: resolves the names
# m:   the manifest
# ra:  the candidate requirement
# ret: true when a default library artifact needs it
pub fun default_library_requires(itn: *intern.Interner, m: *Manifest, ra: *ArtifactDef) bool {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if (a.is_lib && a.is_default && artifact_needs_artifact(itn, a, ra)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# which artifacts a requirement list names
def ReqSource: u8;

# the artifacts one consumer artifact needs
val REQS_OF_CONSUMER: ReqSource = 0;
# every artifact some artifact needs; the editor's union of every artifact
val REQS_OF_PROJECT: ReqSource = 1;
# the artifacts the default library artifacts need; a dependency's export surface
val REQS_OF_DEFAULT_LIBRARY: ReqSource = 2;

fun req_selected(itn: *intern.Interner, m: *Manifest, consumer: *ArtifactDef,
    ra: *ArtifactDef, source: ReqSource) bool {
    if (source == REQS_OF_PROJECT)         { ret artifact_required_by_any(itn, m, ra); }
    if (source == REQS_OF_DEFAULT_LIBRARY) { ret default_library_requires(itn, m, ra); }
    if (consumer == nil)                   { ret false; }
    ret artifact_needs_artifact(itn, consumer, ra);
}

# list the artifacts a consumer requires, each with its output path when that
# path is unique, for `{artifact.<id>.out}` expansion
# ---
# alloc:           owns the returned array and each non-empty `out` string
# itn:             resolves names
# s:               the scope; the requirements are declared by `s.owner`
# consumer:        the requiring artifact; nil with `whole_project` false yields nothing
# consumer_target: the consumer's target name
# profile:         the profile name the outputs expand with
# whole_project:   select every artifact some artifact needs instead of `consumer`'s
# out_items:       receives the array, or nil when nothing is required
# out_count:       receives its length
# ret:             ok; err from the output path expansion, with the array freed
pub fun resolve_artifact_reqs(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry, s: *Scope,
    consumer: *ArtifactDef, consumer_target: intern.StrId, profile: str,
    whole_project: bool,
    out_items: **ArtifactReq, out_count: *u32) err[outcome.Fail] {
    @out_items = nil;
    @out_count = 0;
    if (consumer == nil && !whole_project) { ret err[outcome.Fail].ok{}; }
    var source: ReqSource = REQS_OF_CONSUMER;
    if (whole_project) { source = REQS_OF_PROJECT; }
    ret collect_artifact_reqs(alloc, itn, reg, s, consumer, consumer_target, profile, source, out_items, out_count);
}

# list the artifacts a dependency's default library artifacts require, the scope
# `{artifact.<id>.out}` resolves in for that dependency's modules. each requirement
# builds for every target it names in the dependency's manifest
# ---
# alloc:     owns the returned array and each non-empty `out` string
# itn:       resolves names
# s:         a dependency scope
# profile:   the root's profile name the outputs expand with
# out_items: receives the array, or nil when nothing is required
# out_count: receives its length
# ret:       ok; err from the output path expansion, with the array freed
pub fun resolve_default_library_reqs(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry,
    s: *Scope, profile: str, out_items: **ArtifactReq, out_count: *u32) err[outcome.Fail] {
    @out_items = nil;
    @out_count = 0;
    ret collect_artifact_reqs(alloc, itn, reg, s, nil, intern.STR_NIL, profile, REQS_OF_DEFAULT_LIBRARY,
        out_items, out_count);
}

fun collect_artifact_reqs(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry, s: *Scope,
    consumer: *ArtifactDef, consumer_target: intern.StrId, profile: str, source: ReqSource,
    out_items: **ArtifactReq, out_count: *u32) err[outcome.Fail] {
    val m: *Manifest = s.owner;
    if (m.artifact_count == 0) { ret err[outcome.Fail].ok{}; }

    var n: u32 = 0;
    var j: u32 = 0;
    for (j < m.artifact_count) {
        if (req_selected(itn, m, consumer, ?m.artifacts[j], source)) { n = n + 1; }
        j = j + 1;
    }
    if (n == 0) { ret err[outcome.Fail].ok{}; }

    val ir: res[*ArtifactReq, A.Error] = A.allocate[ArtifactReq](alloc, n::usize);
    if (sel ir.err) { ret err[outcome.Fail].err{outcome.refused(ir.err)}; }
    val items: *ArtifactReq = ir.ok;

    var w: u32 = 0;
    j = 0;
    for (j < m.artifact_count) {
        val ra: *ArtifactDef = ?m.artifacts[j];
        if (req_selected(itn, m, consumer, ra, source)) {
            var item: ArtifactReq;
            item.name = idstr(itn, ra.name);
            item.out  = "";
            if (required_artifact_target_count(itn, m, ra, consumer_target) == 1) {
                var ti: u32 = 0;
                for (ti < m.target_count) {
                    if (required_artifact_uses_target(itn, ra, consumer_target, ?m.targets[ti])) {
                        val pr: res[str, outcome.Fail] = artifact_out_for_target(alloc, itn, reg, s, ra, ?m.targets[ti], profile);
                        if (sel pr.err) {
                            var prior: u32 = 0;
                            for (prior < w) {
                                if (!str_empty(items[prior].out)) { str_free(alloc, items[prior].out); }
                                prior = prior + 1;
                            }
                            A.deallocate[ArtifactReq](alloc, items, n::usize);
                            ret err[outcome.Fail].err{pr.err};
                        }
                        item.out = pr.ok;
                        brk;
                    }
                    ti = ti + 1;
                }
            }
            items[w] = item;
            w        = w + 1;
        }
        j = j + 1;
    }
    @out_items = items;
    @out_count = w;
    ret err[outcome.Fail].ok{};
}

# order the build steps the named artifacts demand: a step producing a local
# link path that matches the target, every step a `need` names (globs match
# step names), and transitively each step's own `need`, dependencies first
# ---
# alloc:     owns the returned order
# itn:       resolves names
# m:         the manifest
# art_names: the artifacts to plan for; unknown names are skipped
# art_count: length of `art_names`
# t:         the target
# proj_out:  the expanded `[project].out`
# v:         the template values
# out_order: receives the step indices in run order, sized exactly; nil when none
# out_count: receives the length
# ret:       ok; err on a step `need` cycle, a step `need` naming an unknown step, or
#            a local link path that fails to expand
pub fun plan_steps(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    art_names: *intern.StrId, art_count: u32, t: *TargetDef,
    proj_out: str, v: *TmplVars,
    out_order: **u32, out_count: *u32) err[outcome.Fail] {
    @out_order = nil;
    @out_count = 0;
    if (m.step_count == 0) { ret err[outcome.Fail].ok{}; }

    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, m.step_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    var i:     u32 = 0;
    for (i < m.step_count) {
        state[i] = 0;
        i        = i + 1;
    }

    val or_: res[*u32, A.Error] = A.allocate[u32](alloc, m.step_count::usize);
    if (sel or_.err) {
        A.deallocate[u8](alloc, state, m.step_count::usize);
        ret err[outcome.Fail].err{outcome.refused(or_.err)};
    }
    val order:     *u32 = or_.ok;
    var order_len: u32  = 0;

    var ai: u32 = 0;
    for (ai < art_count) {
        val a: *ArtifactDef = find_artifact_by_name(m, art_names[ai]);
        if (a != nil) {
            var li: u32 = 0;
            for (li < a.link_count) {
                val l: *LinkDef = find_link_by_name(m, a.link[li]);
                if (l != nil && l.source == LINK_LOCAL && link_matches_target(itn, l, t)) {
                    val exp_r: res[str, outcome.Fail] = expand_project_path(alloc, idstr(itn, l.path), proj_out, v, "a local link path");
                    if (sel exp_r.err) {
                        plan_free(alloc, state, order, m.step_count);
                        ret err[outcome.Fail].err{exp_r.err};
                    }
                    val exp:  str = exp_r.ok;
                    val sidx: i64 = step_producing_out(alloc, itn, m, exp, proj_out, v);
                    str_free(alloc, exp);
                    if (sidx >= 0) {
                        val vr: err[outcome.Fail] = plan_visit(alloc, itn, m, sidx::u32, state, order, ?order_len);
                        if (sel vr.err) {
                            plan_free(alloc, state, order, m.step_count);
                            ret vr;
                        }
                    }
                }
                li = li + 1;
            }
            var ni: u32 = 0;
            for (ni < a.need_count) {
                var si: u32 = 0;
                for (si < m.step_count) {
                    if (need_matches(idstr(itn, a.need[ni]), "step", idstr(itn, m.steps[si].name))) {
                        val vr: err[outcome.Fail] = plan_visit(alloc, itn, m, si, state, order, ?order_len);
                        if (sel vr.err) {
                            plan_free(alloc, state, order, m.step_count);
                            ret vr;
                        }
                    }
                    si = si + 1;
                }
                ni = ni + 1;
            }
        }
        ai = ai + 1;
    }

    ret plan_finish(alloc, state, order, m.step_count, order_len, out_order, out_count);
}

fun plan_free(alloc: *A.Allocator, state: *u8, order: *u32, n: u32) {
    A.deallocate[u8](alloc, state, n::usize);
    A.deallocate[u32](alloc, order, n::usize);
}

fun plan_finish(alloc: *A.Allocator, state: *u8, order: *u32, capacity: u32,
    order_len: u32, out_order: **u32, out_count: *u32) err[outcome.Fail] {
    A.deallocate[u8](alloc, state, capacity::usize);
    if (order_len == 0) {
        A.deallocate[u32](alloc, order, capacity::usize);
        ret err[outcome.Fail].ok{};
    }
    if (order_len == capacity) {
        @out_order = order;
        @out_count = order_len;
        ret err[outcome.Fail].ok{};
    }
    val compact_r: res[*u32, A.Error] = A.allocate[u32](alloc, order_len::usize);
    if (sel compact_r.err) {
        A.deallocate[u32](alloc, order, capacity::usize);
        ret err[outcome.Fail].err{outcome.refused(compact_r.err)};
    }
    val compact: *u32 = compact_r.ok;
    var i:       u32  = 0;
    for (i < order_len) {
        compact[i] = order[i];
        i          = i + 1;
    }
    A.deallocate[u32](alloc, order, capacity::usize);
    @out_order = compact;
    @out_count = order_len;
    ret err[outcome.Fail].ok{};
}

# order the build steps that produce an exported local link path matching the
# target and the steps a default library artifact's `need` names, with their
# transitive step `need`s; the steps a consumer of this manifest must run
# ---
# alloc:     owns the returned order
# itn:       resolves names
# m:         the manifest
# t:         the target
# proj_out:  the expanded `[project].out`
# v:         the template values
# out_order: receives the step indices in run order, sized exactly; nil when none
# out_count: receives the length
# ret:       ok; the `plan_steps` errors
pub fun plan_export_steps(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    t: *TargetDef, proj_out: str, v: *TmplVars,
    out_order: **u32, out_count: *u32) err[outcome.Fail] {
    @out_order = nil;
    @out_count = 0;
    if (m.step_count == 0) { ret err[outcome.Fail].ok{}; }

    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, m.step_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8 = sr.ok;
    var i:     u32 = 0;
    for (i < m.step_count) {
        state[i] = 0;
        i        = i + 1;
    }

    val or_: res[*u32, A.Error] = A.allocate[u32](alloc, m.step_count::usize);
    if (sel or_.err) {
        A.deallocate[u8](alloc, state, m.step_count::usize);
        ret err[outcome.Fail].err{outcome.refused(or_.err)};
    }
    val order:     *u32 = or_.ok;
    var order_len: u32  = 0;

    var li: u32 = 0;
    for (li < m.link_count) {
        val l: *LinkDef = ?m.links[li];
        if (l.export && l.source == LINK_LOCAL && link_matches_target(itn, l, t)) {
            val exp_r: res[str, outcome.Fail] = expand_project_path(alloc, idstr(itn, l.path), proj_out, v, "a local link path");
            if (sel exp_r.err) {
                plan_free(alloc, state, order, m.step_count);
                ret err[outcome.Fail].err{exp_r.err};
            }
            val exp:  str = exp_r.ok;
            val sidx: i64 = step_producing_out(alloc, itn, m, exp, proj_out, v);
            str_free(alloc, exp);
            if (sidx >= 0) {
                val vr: err[outcome.Fail] = plan_visit(alloc, itn, m, sidx::u32, state, order, ?order_len);
                if (sel vr.err) {
                    plan_free(alloc, state, order, m.step_count);
                    ret vr;
                }
            }
        }
        li = li + 1;
    }

    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[ai];
        if (a.is_lib && a.is_default) {
            var ni: u32 = 0;
            for (ni < a.need_count) {
                var si: u32 = 0;
                for (si < m.step_count) {
                    if (need_matches(idstr(itn, a.need[ni]), "step", idstr(itn, m.steps[si].name))) {
                        val vr: err[outcome.Fail] = plan_visit(alloc, itn, m, si, state, order, ?order_len);
                        if (sel vr.err) {
                            plan_free(alloc, state, order, m.step_count);
                            ret vr;
                        }
                    }
                    si = si + 1;
                }
                ni = ni + 1;
            }
        }
        ai = ai + 1;
    }

    ret plan_finish(alloc, state, order, m.step_count, order_len, out_order, out_count);
}

# whether the selection's artifact builds for the selection's target. the target
# is resolved as `native` would be, never pinned by the artifact
# ---
# alloc: owns error text
# itn:   resolves names
# m:     the manifest
# pick:  the selection
# ret:   the support bit; err from target resolution, or when `resolve_artifact`
#        finds nothing
pub fun cell_supported(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, pick: Selection) res[bool, outcome.Fail] {
    val res_target: res[ResolvedTarget, outcome.Fail] = resolve_target(alloc, itn, m, pick.target, nil);
    if (sel res_target.err) { ret res[bool, outcome.Fail].err{res_target.err}; }
    val rt: ResolvedTarget = res_target.ok;

    val a: *ArtifactDef = resolve_artifact(itn, m, pick);
    if (a == nil) { ret res[bool, outcome.Fail].err{outcome.user(artifact_err(alloc, itn, m, pick))}; }

    ret res[bool, outcome.Fail].ok{artifact_supports_target(itn, a, rt.target.name)};
}

fun set_selected_artifact(itn: *intern.Interner, a: *ArtifactDef,
    pick: *Selection) err[outcome.Fail] {
    val name_opt: opt[str] = intern.lookup(itn, a.name);
    if (sel name_opt.none) {
        ret err[outcome.Fail].err{outcome.user("selected artifact name not interned")};
    }
    pick.artifact     = name_opt.some;
    pick.want_lib     = a.is_lib;
    pick.has_artifact = true;
    ret err[outcome.Fail].ok{};
}

# a selection several candidates could satisfy is refused where a command
# must pick one; table order carries no meaning (#3222, #3226)
pub val AMBIGUOUS_TARGET_MSG:   str = "mach.toml: several targets are declared, none matches the host and none is marked `default = true`; no target is selected by table order: mark exactly one [target.<name>] with `default = true` or select one with --target";
pub val AMBIGUOUS_PROFILE_MSG:  str = "mach.toml: several profiles are declared and none is marked `default = true`; no profile is selected by table order: mark exactly one [profile.<name>] with `default = true` or select one with --profile";
pub val AMBIGUOUS_ARTIFACT_MSG: str = "mach.toml: several artifacts support the selected target and none is marked `default = true`; no artifact is selected by table order: mark exactly one [artifact.<name>] with `default = true` or select one with --bin/--lib";

# the default selection: what a command takes for a target when no `--bin`/`--lib`
# names an artifact. of the artifacts the target builds, those marked
# `default = true` when any is, otherwise every one. build and check take the whole
# selection, and a command that needs one artifact takes it only when it holds one
# ---
# itn:              resolves names
# m:                the manifest
# a:                the artifact asked about
# target:           the resolved target's name
# executables_only: consider `bin` artifacts only, so a library beside them is never taken
# ret:              true when the default selection holds `a`
pub fun default_selection_includes(itn: *intern.Interner, m: *Manifest, a: *ArtifactDef,
    target: intern.StrId, executables_only: bool) bool {
    if (!selection_scope_holds(itn, a, target, executables_only)) { ret false; }
    if (a.is_default)                                             { ret true; }
    var i: u32 = 0;
    for (i < m.artifact_count) {
        val other: *ArtifactDef = ?m.artifacts[i];
        if (other.is_default && selection_scope_holds(itn, other, target, executables_only)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# `default_selection_includes` for a target selector not yet resolved
# ---
# alloc:  owns error text
# itn:    resolves names
# m:      the manifest
# target: the target selector, "" for the default target
# a:      the artifact asked about
# ret:    whether the default selection holds `a`; err from target resolution
pub fun default_selection_takes(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    target: str, a: *ArtifactDef) res[bool, outcome.Fail] {
    val tr: res[ResolvedTarget, outcome.Fail] = resolve_target(alloc, itn, m, target, nil);
    if (sel tr.err) { ret res[bool, outcome.Fail].err{tr.err}; }
    ret res[bool, outcome.Fail].ok{default_selection_includes(itn, m, a, tr.ok.target.name, false)};
}

fun selection_scope_holds(itn: *intern.Interner, a: *ArtifactDef, target: intern.StrId, executables_only: bool) bool {
    if (executables_only && a.is_lib) { ret false; }
    ret artifact_supports_target(itn, a, target);
}

# the default selection for a target: how many artifacts it holds, the one when it
# holds exactly one, and how many of the target's artifacts are marked default
rec ArtifactCandidates {
    count:  u32;
    sole:   *ArtifactDef;
    marked: u32;
}

fun artifact_candidates_for(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    pick: *Selection, executables_only: bool) res[ArtifactCandidates, outcome.Fail] {
    var c: ArtifactCandidates;
    c.count  = 0;
    c.sole   = nil;
    c.marked = 0;
    val tr: res[ResolvedTarget, outcome.Fail] = resolve_target(alloc, itn, m, pick.target, nil);
    if (sel tr.err) { ret res[ArtifactCandidates, outcome.Fail].err{tr.err}; }
    val rt: ResolvedTarget = tr.ok;

    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        if (a.is_default && selection_scope_holds(itn, a, rt.target.name, executables_only)) { c.marked = c.marked + 1; }
        if (default_selection_includes(itn, m, a, rt.target.name, executables_only)) {
            c.sole  = a;
            c.count = c.count + 1;
        }
        i = i + 1;
    }
    if (c.count != 1) { c.sole = nil; }
    ret res[ArtifactCandidates, outcome.Fail].ok{c};
}

# fill in `pick.artifact` when none was named and several artifacts are declared:
# the default selection when it holds one artifact, the sole artifact supporting
# the selected target or the one marked `default = true`; a selection of several
# is refused, never narrowed by table order
# ---
# alloc: owns error text
# itn:   resolves names
# m:     the manifest
# pick:  updated in place; untouched when it already names an artifact or fewer
#        than two are declared
# ret:   ok; err from target resolution, when no artifact supports the target,
#        when more than one candidate is marked default, or when several are and none is
pub fun select_primary_artifact(alloc: *A.Allocator, itn: *intern.Interner,
    m: *Manifest, pick: *Selection) err[outcome.Fail] {
    if (pick.has_artifact || m.artifact_count < 2) { ret err[outcome.Fail].ok{}; }

    val cr: res[ArtifactCandidates, outcome.Fail] = artifact_candidates_for(alloc, itn, m, pick, false);
    if (sel cr.err) { ret err[outcome.Fail].err{cr.err}; }
    val c: ArtifactCandidates = cr.ok;
    if (c.sole != nil) { ret set_selected_artifact(itn, c.sole, pick); }
    if (c.count == 0) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: no artifact supports the selected target ({})", artifact_candidates(alloc, itn, m)))};
    }
    if (c.marked > 1) {
        ret err[outcome.Fail].err{outcome.user("mach.toml: multiple artifacts supporting the selected target have 'default = true'; exactly one is allowed")};
    }
    ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "{} ({})", AMBIGUOUS_ARTIFACT_MSG, artifact_candidates(alloc, itn, m)))};
}

# `select_primary_artifact` without the refusal: fill in `pick.artifact` only
# when the default selection holds one artifact, and stay silent otherwise
# ---
# alloc: owns error text
# itn:   resolves names
# m:     the manifest
# pick:  updated in place when a choice is clear
# ret:   ok unless the artifact name cannot be looked up
pub fun select_sole_target_artifact(alloc: *A.Allocator, itn: *intern.Interner,
    m: *Manifest, pick: *Selection) err[outcome.Fail] {
    if (pick.has_artifact || m.artifact_count < 2) { ret err[outcome.Fail].ok{}; }

    val cr: res[ArtifactCandidates, outcome.Fail] = artifact_candidates_for(alloc, itn, m, pick, false);
    if (sel cr.err) { ret err[outcome.Fail].ok{}; }
    val c: ArtifactCandidates = cr.ok;
    if (c.sole != nil) { ret set_selected_artifact(itn, c.sole, pick); }
    ret err[outcome.Fail].ok{};
}

# `select_sole_target_artifact` over `bin` artifacts only, so a bin beside a
# library is chosen for `run` and `test`
# ---
# alloc: owns error text
# itn:   resolves names
# m:     the manifest
# pick:  updated in place when a choice is clear
# ret:   ok unless the artifact name cannot be looked up
pub fun select_sole_executable_artifact(alloc: *A.Allocator, itn: *intern.Interner,
    m: *Manifest, pick: *Selection) err[outcome.Fail] {
    if (pick.has_artifact || m.artifact_count < 2) { ret err[outcome.Fail].ok{}; }

    val cr: res[ArtifactCandidates, outcome.Fail] = artifact_candidates_for(alloc, itn, m, pick, true);
    if (sel cr.err) { ret err[outcome.Fail].ok{}; }
    val c: ArtifactCandidates = cr.ok;
    if (c.sole != nil) { ret set_selected_artifact(itn, c.sole, pick); }
    ret err[outcome.Fail].ok{};
}

# resolve a selection into one `BuildUnit`. with no target named, an artifact
# that supports exactly one declared target, or exactly one host-matching
# target, pins it; otherwise `native` resolution applies. the profile comes
# from `resolve_profile`, the artifact from `resolve_artifact`, and every path
# is expanded with `expand_project_path`
# ---
# alloc: owns `libs` and temporary strings
# itn:   interns the expanded paths
# m:     the manifest
# pick:  the selection
# ret:   the unit; err from target, profile or artifact resolution, when the
#        artifact does not support the target (naming the artifact's targets when
#        none was selected), or from path expansion
pub fun resolve_build_unit(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry, m: *Manifest, pick: Selection) res[BuildUnit, outcome.Fail] {
    var s: Scope = root_scope(m);
    ret resolve_scoped_build_unit(alloc, itn, reg, ?s, pick);
}

# `resolve_build_unit` for a cell of `s`: target, artifact and links resolve in
# `s.owner`, the profile and `[project].out` in `s.root`, and the artifact output
# is homed under the scope's artifact root
# ---
# alloc: owns `libs` and temporary strings
# itn:   interns the expanded paths
# s:     the scope
# pick:  the selection, naming targets and artifacts of `s.owner` and a profile of `s.root`
# ret:   as `resolve_build_unit`
pub fun resolve_scoped_build_unit(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry, s: *Scope, pick: Selection) res[BuildUnit, outcome.Fail] {
    val m:   *Manifest    = s.owner;
    var pin: *ArtifactDef = nil;
    if (str_empty(pick.target)) { pin = resolve_artifact(itn, m, pick); }

    val res_target: res[ResolvedTarget, outcome.Fail] = resolve_target(alloc, itn, m, pick.target, pin);
    if (sel res_target.err) { ret res[BuildUnit, outcome.Fail].err{res_target.err}; }
    val rt: ResolvedTarget = res_target.ok;

    val res_profile: res[ResolvedProfile, outcome.Fail] = resolve_profile(alloc, itn, s.root, pick.profile);
    if (sel res_profile.err) { ret res[BuildUnit, outcome.Fail].err{res_profile.err}; }
    val rp: ResolvedProfile = res_profile.ok;

    val a: *ArtifactDef = resolve_artifact(itn, m, pick);
    if (a == nil) { ret res[BuildUnit, outcome.Fail].err{outcome.user(artifact_err(alloc, itn, m, pick))}; }

    if (!artifact_supports_target(itn, a, rt.target.name)) {
        val art_name: str = idstr(itn, a.name);
        val tgt_name: str = idstr(itn, rt.target.name);
        if (str_empty(pick.target)) {
            ret res[BuildUnit, outcome.Fail].err{outcome.user(sfmt(alloc,
                "mach.toml: artifact '{}' declares no target for this host; select one with --target ({})",
                art_name, artifact_target_names(alloc, itn, m, a)))};
        }
        ret res[BuildUnit, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: artifact '{}' does not support target '{}'", art_name, tgt_name))};
    }

    var u: BuildUnit;
    u.target        = rt.target;
    u.artifact      = a;
    u.target_name   = rt.target.name;
    u.profile_name  = rp.name;
    u.opt           = rp.opt;
    u.debug         = rp.debug;
    u.simd          = rp.simd;
    u.vectorize     = rp.vectorize;
    u.float_reassoc = rp.float_reassoc;
    u.is_lib        = a.is_lib;
    u.kind          = LIBKIND_STATIC;
    val kind_str: str = idstr(itn, a.kind);
    if (str_equals(kind_str, "shared")) {
        u.kind = LIBKIND_SHARED;
    }
    u.warned = rt.warned;
    u.entry  = a.entry;

    val res_profile_name: res[str, outcome.Fail] = must_lookup(itn, rp.name);
    if (sel res_profile_name.err) { ret res[BuildUnit, outcome.Fail].err{res_profile_name.err}; }
    val pn: str      = res_profile_name.ok;
    var v:  TmplVars = tmpl_vars_of(itn, rt.target, pn);

    val must_lookup_r: res[str, outcome.Fail] = must_lookup(itn, s.root.out_tmpl);
    if (sel must_lookup_r.err) { ret res[BuildUnit, outcome.Fail].err{must_lookup_r.err}; }
    val res_project_out: res[str, outcome.Fail] = expand_project_path(alloc, must_lookup_r.ok, "", ?v, "[project].out");
    if (sel res_project_out.err) { ret res[BuildUnit, outcome.Fail].err{res_project_out.err}; }
    val proj_out: str = res_project_out.ok;

    var match_count:   u32              = 0;
    var matched_items: *LinkRequirement = nil;
    if (a.link_count > 0) {
        val res_match_arr: res[*LinkRequirement, A.Error] = A.allocate[LinkRequirement](alloc, a.link_count::usize);
        if (sel res_match_arr.err) {
            str_free(alloc, proj_out);
            ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_match_arr.err)};
        }
        matched_items = res_match_arr.ok;

        var li: u32 = 0;
        for (li < a.link_count) {
            val link_name: intern.StrId = a.link[li];
            var found_l:   *LinkDef     = nil;
            var lidx:      u32          = 0;
            for (lidx < m.link_count) {
                if (m.links[lidx].name == link_name) {
                    found_l = ?m.links[lidx];
                }
                lidx = lidx + 1;
            }
            if (found_l != nil) {
                if (link_matches_target(itn, found_l, rt.target)) {
                    val req_r: res[LinkRequirement, outcome.Fail] = link_requirement(alloc, itn, found_l, proj_out, ?v);
                    if (sel req_r.err) {
                        free_link_claims(alloc, matched_items, match_count);
                        A.deallocate[LinkRequirement](alloc, matched_items, a.link_count::usize);
                        str_free(alloc, proj_out);
                        ret res[BuildUnit, outcome.Fail].err{req_r.err};
                    }
                    matched_items[match_count] = req_r.ok;
                    match_count                = match_count + 1;
                }
            }
            li = li + 1;
        }

        var exact_items: *LinkRequirement  = nil;
        var exact_count: u32               = 0;
        val fr:          err[outcome.Fail] = finish_link_requirements(alloc, matched_items,
            a.link_count, match_count, ?exact_items, ?exact_count);
        if (sel fr.err) {
            str_free(alloc, proj_out);
            ret res[BuildUnit, outcome.Fail].err{fr.err};
        }
        matched_items = exact_items;
        match_count   = exact_count;
    }
    u.libs      = matched_items;
    u.lib_count = match_count;

    val obj_str:   str = sfmt(alloc, "{}/obj", proj_out);
    val ir_str:    str = sfmt(alloc, "{}/ir", proj_out);
    val asm_str:   str = sfmt(alloc, "{}/asm", proj_out);
    val test_str:  str = sfmt(alloc, "{}/test/{{name}}", proj_out);
    val cache_str: str = sfmt(alloc, "{}/{}", proj_out, CACHE_DIR);
    val stage_str: str = sfmt(alloc, "{}/{}", proj_out, STAGE_DIR);

    val res_obj:   res[intern.StrId, A.Error] = intern.intern(itn, obj_str);
    val res_ir:    res[intern.StrId, A.Error] = intern.intern(itn, ir_str);
    val res_asm:   res[intern.StrId, A.Error] = intern.intern(itn, asm_str);
    val res_test:  res[intern.StrId, A.Error] = intern.intern(itn, test_str);
    val res_cache: res[intern.StrId, A.Error] = intern.intern(itn, cache_str);
    val res_stage: res[intern.StrId, A.Error] = intern.intern(itn, stage_str);
    str_free(alloc, obj_str);
    str_free(alloc, ir_str);
    str_free(alloc, asm_str);
    str_free(alloc, test_str);
    str_free(alloc, cache_str);
    str_free(alloc, stage_str);

    if (sel res_obj.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_obj.err)};
    }
    u.obj_root = res_obj.ok;
    if (sel res_ir.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_ir.err)};
    }
    u.ir_root = res_ir.ok;
    if (sel res_asm.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_asm.err)};
    }
    u.asm_root = res_asm.ok;
    if (sel res_test.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_test.err)};
    }
    u.test_root = res_test.ok;
    if (sel res_cache.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_cache.err)};
    }
    u.cache_root = res_cache.ok;
    if (sel res_stage.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_stage.err)};
    }
    u.stage_root = res_stage.ok;

    val res_art_out: res[str, outcome.Fail] = expand_artifact_output(alloc, itn, reg, a, proj_out, ?v);
    if (sel res_art_out.err) {
        str_free(alloc, proj_out);
        ret res[BuildUnit, outcome.Fail].err{res_art_out.err};
    }
    val art_out_rel: str = res_art_out.ok;
    val art_root:    str = scope_artifact_root(alloc, itn, s, proj_out);

    val final_bin_path: str                        = join_path_canonical(alloc, art_root, art_out_rel);
    val res_bin:        res[intern.StrId, A.Error] = intern.intern(itn, final_bin_path);
    str_free(alloc, final_bin_path);
    str_free(alloc, art_root);
    str_free(alloc, art_out_rel);
    str_free(alloc, proj_out);
    if (sel res_bin.err) { ret res[BuildUnit, outcome.Fail].err{outcome.refused(res_bin.err)}; }
    u.bin_path = res_bin.ok;

    ret res[BuildUnit, outcome.Fail].ok{u};
}

fun artifact_err(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, pick: Selection) str {
    if (m.artifact_count == 0) { ret "mach.toml: no [artifact.*] artifacts declared"; }
    if (pick.has_artifact) {
        if (pick.want_lib) { ret sfmt(alloc, "mach.toml: no lib named '{}'", pick.artifact); }
        ret sfmt(alloc, "mach.toml: no bin named '{}'", pick.artifact);
    }
    ret sfmt(alloc, "mach.toml: multiple artifacts declared; select one with --bin/--lib ({})",
        artifact_candidates(alloc, itn, m));
}

fun artifact_candidates(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (i > 0) { s = sfmt(alloc, "{}, ", s); }
        var label: str = "bin ";
        if (m.artifacts[i].is_lib) { label = "lib "; }
        var name:     str      = "?";
        val opt_name: opt[str] = intern.lookup(itn, m.artifacts[i].name);
        if (sel opt_name.some) { name = opt_name.some; }
        s = sfmt(alloc, "{}{}{}", s, label, name);
        i = i + 1;
    }
    ret s;
}

# reject two artifacts whose `out` expands to the same path under one set of
# template values
# ---
# alloc: owns temporary strings
# itn:   resolves names
# m:     the manifest; fewer than two artifacts always pass
# v:     the template values
# ret:   ok; err "mach.toml: artifacts 'a' and 'b' collide on output path '<p>'",
#        or an expansion error
pub fun check_collisions(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry, m: *Manifest,
    v: *TmplVars) err[outcome.Fail] {
    if (m.artifact_count < 2) { ret err[outcome.Fail].ok{}; }
    val target_id: res[intern.StrId, A.Error] = intern.intern(itn, v.target);
    if (sel target_id.err) { ret err[outcome.Fail].err{outcome.refused(target_id.err)}; }

    val res_paths: res[*str, A.Error] = A.allocate[str](alloc, m.artifact_count::usize);
    if (sel res_paths.err) { ret err[outcome.Fail].err{outcome.refused(res_paths.err)}; }
    val paths: *str = res_paths.ok;

    val must_lookup_r: res[str, outcome.Fail] = must_lookup(itn, m.out_tmpl);
    if (sel must_lookup_r.err) {
        A.deallocate[str](alloc, paths, m.artifact_count::usize);
        ret err[outcome.Fail].err{must_lookup_r.err};
    }
    val res_project_out: res[str, outcome.Fail] = expand_project_path(alloc, must_lookup_r.ok, "", v, "[project].out");
    if (sel res_project_out.err) {
        A.deallocate[str](alloc, paths, m.artifact_count::usize);
        ret err[outcome.Fail].err{res_project_out.err};
    }
    val proj_out: str = res_project_out.ok;

    var i: u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        paths[i] = nil;
        if (!artifact_supports_target(itn, a, target_id.ok)) {
            i = i + 1;
            cnt;
        }
        val res_art_out: res[str, outcome.Fail] = expand_artifact_output(alloc, itn, reg, a, proj_out, v);
        if (sel res_art_out.err) {
            free_path_strings(alloc, paths, i);
            A.deallocate[str](alloc, paths, m.artifact_count::usize);
            str_free(alloc, proj_out);
            ret err[outcome.Fail].err{res_art_out.err};
        }
        val art_out_rel: str = res_art_out.ok;
        paths[i] = join_path_canonical(alloc, proj_out, art_out_rel);
        str_free(alloc, art_out_rel);
        i = i + 1;
    }

    var code: bool = true;
    var msg:  str  = "";
    i = 0;
    for (i < m.artifact_count && code) {
        var j: u32 = i + 1;
        for (j < m.artifact_count && code) {
            if (paths[i] != nil && paths[j] != nil && str_equals(paths[i], paths[j])) {
                val an0: opt[str] = intern.lookup(itn, m.artifacts[i].name);
                val an1: opt[str] = intern.lookup(itn, m.artifacts[j].name);
                if (sel an0.some) {
                    if (sel an1.some) {
                        msg = sfmt(alloc, "mach.toml: artifacts '{}' and '{}' collide on output path '{}'", an0.some, an1.some, paths[i]);
                    }
                }
                code = false;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    free_path_strings(alloc, paths, m.artifact_count);
    A.deallocate[str](alloc, paths, m.artifact_count::usize);
    str_free(alloc, proj_out);
    if (!code) { ret err[outcome.Fail].err{outcome.user(msg)}; }
    ret err[outcome.Fail].ok{};
}

fun host_target_stanza(alloc: *A.Allocator, name: str) str {
    ret sfmt(alloc, "[target.{}]\nisa = \"{}\"\nos = \"{}\"\nabi = \"{}\"\n", name, host_isa_name(), host_os_name(), abi.abi_name_for(tgt.host_abi_id()));
}

fun requirement_has(itn: *intern.Interner, items: *LinkRequirement, count: u32, lit: str) bool {
    var i: u32 = 0;
    for (i < count) {
        if (str_equals(idstr(itn, items[i].text), lit)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun mk_sel(target: str, profile: str, artifact: str, want_lib: bool, has_artifact: bool) Selection {
    var s: Selection;
    s.target       = target;
    s.profile      = profile;
    s.artifact     = artifact;
    s.want_lib     = want_lib;
    s.has_artifact = has_artifact;
    ret s;
}

test "mach.lang.manifest.validate_needs:accepts_artifact_ids_globs_and_step_ids" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}{}{}", need_head(),
        need_artifact(?alloc, "shader-a", "a", ""),
        need_artifact(?alloc, "shader-b", "b", ""),
        "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.shader-a]\nargv=[\"never\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-*\",\"step.gen\",\"artifact.shader-b\"]\n");
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m:   Manifest     = r.ok;
        val app: *ArtifactDef = find_artifact_by_name(?m, intern_unwrap(?itn, "app"));
        val sa:  *ArtifactDef = find_artifact_by_name(?m, intern_unwrap(?itn, "shader-a"));
        if (app == nil || sa == nil) { code = 1; }
        or {
            if (!artifact_needs_artifact(?itn, app, sa)) { code = 1; }
            if (artifact_needs_artifact(?itn, sa, app))  { code = 1; }
            if (artifact_needs_artifact(?itn, app, app)) { code = 1; }
            var order:   *u32              = nil;
            var count:   u32               = 0;
            var vars:    TmplVars          = tmpl_vars_of(?itn, ?m.targets[0], "debug");
            val planned: err[outcome.Fail] = plan_steps(?alloc, ?itn, ?m, ?app.name, 1,
                ?m.targets[0], "out/host", ?vars, ?order, ?count);
            if (sel planned.err || count != 1)                           { code = 1; }
            or (!str_equals(idstr(?itn, m.steps[order[0]].name), "gen")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

fun need_two_target_head() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.alt]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.alt2]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

test "mach.lang.manifest.resolve_artifact_reqs:resolves_the_required_output_on_its_own_target" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-*\"]\n");
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m:     Manifest          = r.ok;
        val app:   *ArtifactDef      = find_artifact(?itn, ?m, "app");
        val host:  *TargetDef        = find_target_by_name(?itn, ?m, "host");
        var items: *ArtifactReq      = nil;
        var count: u32               = 0;
        val rr:    err[outcome.Fail] = t_resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (sel rr.err) { code = 1; }
        or {
            if (count != 1) { code = 1; }
            or {
                if (!str_equals(items[0].name, "shader-a"))                    { code = 1; }
                if (!str_equals(items[0].out, "out/alt/debug/lib/shader-a.a")) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

fun dependency_manifest() str {
    ret "[project]\nid=\"shlib\"\nversion=\"1\"\nsrc=\"src\"\nout=\"dep-out\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.alt]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[artifact.shlib]\nkind=\"static\"\ndefault=true\nentry=\"lib.mach\"\nout=\"lib/shlib.a\"\ntargets=[\"host\"]\nneed=[\"artifact.shader-a\"]\n[artifact.shader-a]\nkind=\"bin\"\nentry=\"s.mach\"\nout=\"spv/shader-a.spv\"\ntargets=[\"alt\"]\nneed=[]\n[artifact.tool]\nkind=\"bin\"\nentry=\"t.mach\"\nout=\"bin/tool\"\ntargets=[\"host\"]\nneed=[\"artifact.support\"]\n[artifact.support]\nkind=\"static\"\nentry=\"u.mach\"\nout=\"lib/support.a\"\ntargets=[\"host\"]\nneed=[]\n";
}

test "mach.lang.manifest.resolve_default_library_reqs:a_dependency_requirement_is_homed_under_its_id_in_the_root_out" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    var code: i32 = 0;

    val root_src: str = sfmt(?alloc, "{}{}", need_two_target_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[]\n");
    val root_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, root_src);
    val dep_r:  res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, dependency_manifest());
    if (sel root_r.err) { ret 2; }
    if (sel dep_r.err)  { ret 2; }
    var root:  Manifest = root_r.ok;
    var dep:   Manifest = dep_r.ok;
    var scope: Scope    = dependency_scope(?root, ?dep);

    # only the default library artifact's requirements travel, and each names a
    # path in the root's out tree under the dependency id
    var items: *ArtifactReq      = nil;
    var count: u32               = 0;
    val rr:    err[outcome.Fail] = t_default_library_reqs(?alloc, ?itn, ?scope, "debug", ?items, ?count);
    if (sel rr.err) { code = 1; }
    or {
        if (count != 1) { code = 1; }
        or {
            if (!str_equals(items[0].name, "shader-a"))                                { code = 1; }
            if (!str_equals(items[0].out, "out/alt/debug/dep/shlib/spv/shader-a.spv")) { code = 1; }
        }
    }
    val support: *ArtifactDef = find_artifact(?itn, ?dep, "support");
    if (default_library_requires(?itn, ?dep, support))                                { code = 1; }
    if (!default_library_requires(?itn, ?dep, find_artifact(?itn, ?dep, "shader-a"))) { code = 1; }

    # the cell resolves the dependency's target and artifact, the root's profile and
    # out template, and writes where the requirement names
    val unit: res[BuildUnit, outcome.Fail] = t_scoped_build_unit(?alloc, ?itn, ?scope,
        mk_sel("alt", "debug", "shader-a", false, true));
    if (sel unit.err) { code = 1; }
    if (sel unit.ok) {
        val u: BuildUnit = unit.ok;
        if (!str_equals(idstr(?itn, u.bin_path), "out/alt/debug/dep/shlib/spv/shader-a.spv")) { code = 1; }
        if (!str_equals(idstr(?itn, u.obj_root), "out/alt/debug/obj"))                        { code = 1; }
        if (!str_equals(idstr(?itn, u.profile_name), "debug"))                                { code = 1; }
    }

    # the root keeps its own scope: its artifacts are not homed under a dependency
    var rs:  Scope                        = root_scope(?root);
    val own: res[BuildUnit, outcome.Fail] = t_scoped_build_unit(?alloc, ?itn, ?rs,
        mk_sel("host", "debug", "app", false, true));
    if (sel own.err) { code = 1; }
    if (sel own.ok) {
        val o: BuildUnit = own.ok;
        if (!str_equals(idstr(?itn, o.bin_path), "out/host/debug/bin/app")) { code = 1; }
    }
    ret code;
}

fun t_default_library_reqs(alloc: *A.Allocator, itn: *intern.Interner, s: *Scope, profile: str,
    out_items: **ArtifactReq, out_count: *u32) err[outcome.Fail] {
    var reg: tgt.TargetRegistry = tgt.registry_init();
    fin { tgt.registry_dnit(?reg); }
    val ready: err[fail.Fail] = tgt.register_all(?reg, target_testing.debug_descriptor);
    if (sel ready.err) { ret err[outcome.Fail].err{outcome.from_fail(ready.err)}; }
    ret resolve_default_library_reqs(alloc, itn, ?reg, s, profile, out_items, out_count);
}

fun t_scoped_build_unit(alloc: *A.Allocator, itn: *intern.Interner, s: *Scope,
    selection: Selection) res[BuildUnit, outcome.Fail] {
    var reg: tgt.TargetRegistry = tgt.registry_init();
    fin { tgt.registry_dnit(?reg); }
    val ready: err[fail.Fail] = tgt.register_all(?reg, target_testing.debug_descriptor);
    if (sel ready.err) { ret res[BuildUnit, outcome.Fail].err{outcome.from_fail(ready.err)}; }
    ret resolve_scoped_build_unit(alloc, itn, ?reg, s, selection);
}

test "mach.lang.manifest.resolve_artifact_reqs:a_requirement_with_two_targets_has_no_single_output" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/shader-a.a\"\ntargets=[\"alt\",\"alt2\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-a\"]\n");
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m:     Manifest          = r.ok;
        val app:   *ArtifactDef      = find_artifact(?itn, ?m, "app");
        val host:  *TargetDef        = find_target_by_name(?itn, ?m, "host");
        var items: *ArtifactReq      = nil;
        var count: u32               = 0;
        val rr:    err[outcome.Fail] = t_resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (sel rr.err) { code = 1; }
        or {
            if (count != 1) { code = 1; }
            or {
                if (!str_empty(items[0].out)) { code = 1; }
                var v:  TmplVars               = tmpl_vars_of_reqs(items, count);
                val er: res[str, outcome.Fail] = expand(?alloc, "{artifact.shader-a.out}", "", ?v);
                if (!(sel er.err && str_contains(outcome.describe(er.err), "is ambiguous"))) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

