test "mach.lang.manifest.local_path_demanded_by_step" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[step.shim]\nargv=[\"cc\",\"-c\",\"shim.c\"]\nin=[\"shim.c\"]\nout=[\"{project.out}/obj/shim.o\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        var v: TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "debug");
        if (!local_path_demanded_by_step(?alloc, ?itn, ?m, "out/linux/obj/shim.o", "out/linux", ?v)) { code = 1; }
        if (local_path_demanded_by_step(?alloc, ?itn, ?m, "out/linux/obj/nope.o", "out/linux", ?v))  { code = 1; }
        if (step_producing_out(?alloc, ?itn, ?m, "out/linux/obj/shim.o", "out/linux", ?v) != 0)      { code = 1; }
        if (step_producing_out(?alloc, ?itn, ?m, "out/linux/obj/nope.o", "out/linux", ?v) != -1)     { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_steps" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.obj]\nsource=\"local\"\npath=\"{project.out}/o/a.o\"\nos=\"*\"\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=\"windows\"\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"obj\",\"win\"]\nneed=[\"step.gen\"]\n[step.compile]\nargv=[\"cc\"]\nin=[\"a.c\"]\nout=[\"{project.out}/o/a.o\"]\n[step.winc]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n[step.gen]\nargv=[\"g\"]\nin=[\"g.in\"]\nout=[\"{project.out}/g.h\"]\nneed=[\"step.dep*\"]\n[step.dep]\nargv=[\"d\"]\nin=[\"d.in\"]\nout=[\"{project.out}/d.o\"]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val rm:  res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel rm.err) { code = 1; }
    if (sel rm.ok) {
        var m:  Manifest   = rm.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var names: [1]intern.StrId;
            names[0] = intern_unwrap(?itn, "app");
            var order: *u32              = nil;
            var count: u32               = 0;
            var v:     TmplVars          = tmpl_vars_of(?itn, tl, "debug");
            val r:     err[outcome.Fail] = plan_steps(?alloc, ?itn, ?m, ?names[0], 1, tl, "out/linux", ?v, ?order, ?count);
            if (sel r.err) { code = 1; }
            if (sel r.ok) {
                var has_compile: bool = false;
                var has_gen:     bool = false;
                var has_dep:     bool = false;
                var has_winc:    bool = false;
                var gen_pos:     i64  = -1;
                var dep_pos:     i64  = -1;
                var k:           u32  = 0;
                for (k < count) {
                    val nm: str = idstr(?itn, m.steps[order[k]].name);
                    if (str_equals(nm, "compile")) { has_compile = true; }
                    if (str_equals(nm, "gen")) {
                        has_gen = true;
                        gen_pos = k::i64;
                    }
                    if (str_equals(nm, "dep")) {
                        has_dep = true;
                        dep_pos = k::i64;
                    }
                    if (str_equals(nm, "winc")) { has_winc = true; }
                    k = k + 1;
                }
                if (count != 3)                                      { code = 1; }
                if (!has_compile || !has_gen || !has_dep)            { code = 1; }
                if (has_winc)                                        { code = 1; }
                if (dep_pos < 0 || gen_pos < 0 || dep_pos > gen_pos) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_export_steps" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/o/m.o\"\nos=\"*\"\nexport=true\n[link.noexp]\nsource=\"local\"\npath=\"{project.out}/o/n.o\"\nos=\"*\"\nexport=false\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=\"windows\"\nexport=true\n[step.mk]\nargv=[\"cc\"]\nin=[\"m.c\"]\nout=[\"{project.out}/o/m.o\"]\n[step.no]\nargv=[\"cc\"]\nin=[\"n.c\"]\nout=[\"{project.out}/o/n.o\"]\n[step.winmk]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val rm:  res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel rm.err) { code = 1; }
    if (sel rm.ok) {
        var m:  Manifest   = rm.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var order: *u32              = nil;
            var count: u32               = 0;
            var v:     TmplVars          = tmpl_vars_of(?itn, tl, "debug");
            val r:     err[outcome.Fail] = plan_export_steps(?alloc, ?itn, ?m, tl, "out/linux", ?v, ?order, ?count);
            if (sel r.err) { code = 1; }
            if (sel r.ok) {
                if (count != 1) { code = 1; }
                or {
                    if (!str_equals(idstr(?itn, m.steps[order[0]].name), "mk")) { code = 1; }
                }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.step_plans:exact_subset_extent_and_allocation_failure" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    val src:      str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/pick.o\"\nos=\"*\"\nexport=true\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"step.pick\"]\n[step.pick]\nargv=[\"pick\"]\nin=[]\nout=[\"{project.out}/pick.o\"]\nneed=[]\n[step.extra_a]\nargv=[\"a\"]\nin=[]\nout=[\"{project.out}/a.o\"]\nneed=[]\n[step.extra_b]\nargv=[\"b\"]\nin=[]\nout=[\"{project.out}/b.o\"]\nneed=[]\n[step.extra_c]\nargv=[\"c\"]\nin=[]\nout=[\"{project.out}/c.o\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val parsed_r: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel parsed_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var m:      Manifest   = parsed_r.ok;
    val target: *TargetDef = find_target_by_name(?itn, ?m, "linux");
    if (target == nil) {
        arena.dnit(?ar);
        ret 1;
    }
    var v:     TmplVars = tmpl_vars_of(?itn, target, "debug");
    var names: [1]intern.StrId;
    names[0] = intern_unwrap(?itn, "app");
    var bad: bool = false;

    var success_probe: PlanAllocProbe;
    var success_alloc: A.Allocator;
    if (!plan_probe_make(?success_probe, ?success_alloc, 0)) {
        arena.dnit(?ar);
        ret 1;
    }
    var order:   *u32              = nil;
    var count:   u32               = 0;
    val planned: err[outcome.Fail] = plan_steps(?success_alloc, ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
    if (sel planned.err || count != 1 || order == nil)     { bad = true; }
    if (order != nil)                                      { A.deallocate[u32](?success_alloc, order, count::usize); }
    if (success_probe.live != 0 || success_probe.mismatch) { bad = true; }

    var export_probe: PlanAllocProbe;
    var export_alloc: A.Allocator;
    if (!plan_probe_make(?export_probe, ?export_alloc, 0)) {
        arena.dnit(?ar);
        ret 1;
    }
    order = nil;
    count = 0;
    val exported: err[outcome.Fail] = plan_export_steps(?export_alloc, ?itn, ?m, target, "out/linux", ?v, ?order, ?count);
    if (sel exported.err || count != 1 || order == nil)  { bad = true; }
    if (order != nil)                                    { A.deallocate[u32](?export_alloc, order, count::usize); }
    if (export_probe.live != 0 || export_probe.mismatch) { bad = true; }

    var fail_at: u32 = 1;
    for (fail_at <= 3) {
        var fail_probe: PlanAllocProbe;
        var fail_alloc: A.Allocator;
        if (!plan_probe_make(?fail_probe, ?fail_alloc, fail_at)) {
            arena.dnit(?ar);
            ret 1;
        }
        order = nil;
        count = 0;
        val failed: err[outcome.Fail] = plan_steps(?fail_alloc, ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
        if (sel failed.ok || order != nil || count != 0 || fail_probe.live != 0 || fail_probe.mismatch) { bad = true; }
        fail_at = fail_at + 1;
    }
    arena.dnit(?ar);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.select_primary_artifact:first_target_compatible" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n[artifact.app-windows]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app.exe\"\ntargets=[\"windows\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val mr:  res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel mr.err) { code = 1; }
    if (sel mr.ok) {
        var m: Manifest = mr.ok;

        var windows: Selection         = mk_sel("windows", "", "", false, false);
        val wr:      err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?windows);
        if (sel wr.err || !windows.has_artifact
            || !str_equals(windows.artifact, "app-windows")) { code = 1; }
        or {
            val wu: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, windows);
            if (sel wu.err) { code = 1; }
            if (sel wu.ok) {
                val unit: BuildUnit = wu.ok;
                if (!str_equals(idstr(?itn, unit.bin_path), "out/bin/app.exe")) { code = 1; }
            }
        }

        var linux: Selection         = mk_sel("linux", "", "", false, false);
        val lr:    err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?linux);
        if (sel lr.err || !linux.has_artifact
            || !str_equals(linux.artifact, "app")) { code = 1; }

        var runnable: Selection         = mk_sel("windows", "", "", false, false);
        val rr:       err[outcome.Fail] = select_sole_target_artifact(
            ?alloc, ?itn, ?m, ?runnable);
        if (sel rr.err || !runnable.has_artifact
            || !str_equals(runnable.artifact, "app-windows")) { code = 1; }

        var explicit: Selection                    = mk_sel("windows", "", "app", false, true);
        val er:       err[outcome.Fail]            = select_primary_artifact(?alloc, ?itn, ?m, ?explicit);
        val eu:       res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, explicit);
        if (sel er.err || !str_equals(explicit.artifact, "app")
            || sel eu.ok) { code = 1; }
    }

    val ambiguous_src: str = sfmt(?alloc, "{}{}", src,
        "[artifact.tool-windows]\nkind=\"bin\"\nentry=\"tool.mach\"\nout=\"bin/tool.exe\"\ntargets=[\"windows\"]\nlink=[]\nneed=[]\n");
    val amr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, ambiguous_src);
    if (sel amr.err) { code = 1; }
    if (sel amr.ok) {
        var am:        Manifest          = amr.ok;
        var ambiguous: Selection         = mk_sel("windows", "", "", false, false);
        val ar_:       err[outcome.Fail] = select_sole_target_artifact(
            ?alloc, ?itn, ?am, ?ambiguous);
        if (sel ar_.err || ambiguous.has_artifact) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.select_sole_executable_artifact:picks_the_bin_over_a_co_declared_lib" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n[artifact.applib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/applib.a\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val mr:  res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel mr.err) { ret 1; }
    var m: Manifest = mr.ok;

    var picked: Selection         = mk_sel("linux", "", "", false, false);
    val pr:     err[outcome.Fail] = select_sole_executable_artifact(?alloc, ?itn, ?m, ?picked);
    if (sel pr.err || !picked.has_artifact
        || picked.want_lib || !str_equals(picked.artifact, "app")) { code = 1; }

    var stale: Selection         = mk_sel("linux", "", "", false, false);
    val sr:    err[outcome.Fail] = select_sole_target_artifact(?alloc, ?itn, ?m, ?stale);
    if (sel sr.err || stale.has_artifact) { code = 1; }

    val two_bin_src: str = sfmt(?alloc, "{}{}", src,
        "[artifact.app2]\nkind=\"bin\"\nentry=\"main2.mach\"\nout=\"bin/app2\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n");
    val tmr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, two_bin_src);
    if (sel tmr.err) { code = 1; }
    if (sel tmr.ok) {
        var tm:        Manifest          = tmr.ok;
        var ambiguous: Selection         = mk_sel("linux", "", "", false, false);
        val ar_:       err[outcome.Fail] = select_sole_executable_artifact(?alloc, ?itn, ?tm, ?ambiguous);
        if (sel ar_.err || ambiguous.has_artifact) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

fun ut_pin_manifest() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.linux-arm64]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.darwin-x86_64]\nisa=\"x86_64\"\nos=\"darwin\"\nabi=\"sysv64\"\n[target.darwin-arm64]\nisa=\"aarch64\"\nos=\"darwin\"\nabi=\"aapcs64\"\n[target.kernel]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\n[target.kernel-arm]\nisa=\"aarch64\"\nos=\"freestanding\"\nabi=\"aapcs64\"\n[artifact.kernel]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/kernel\"\ntargets=[\"kernel\"]\nlink=[]\nneed=[]\n[artifact.both]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/both\"\ntargets=[\"kernel\",\"kernel-arm\"]\nlink=[]\nneed=[]\n[artifact.tool]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/tool\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

test "mach.lang.manifest.resolve_build_unit:sole_target_artifact_pins_it" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, ut_pin_manifest());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;

        val uk: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "kernel", false, true));
        if (sel uk.err) { code = 1; }
        if (sel uk.ok) {
            val u: BuildUnit = uk.ok;
            if (!str_equals(idstr(?itn, u.target_name), "kernel")) { code = 1; }
        }

        val ut: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "tool", false, true));
        if (sel ut.err) { code = 1; }
        if (sel ut.ok) {
            val u: BuildUnit = ut.ok;
            if (str_equals(idstr(?itn, u.target_name), "kernel")) { code = 1; }
        }

        val ux: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("linux", "", "kernel", false, true));
        if (!(sel ux.err && str_contains(outcome.describe(ux.err), "does not support target"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:no_hostable_target_lists_the_candidates" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, ut_pin_manifest());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest                     = res_manifest.ok;
        val ub: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "both", false, true));
        if (sel ub.ok) { code = 1; }
        if (sel ub.err) {
            val e: str = outcome.describe(ub.err);
            if (!str_contains(e, "declares no target for this host")) { code = 1; }
            if (!str_contains(e, "kernel-arm"))                       { code = 1; }
            if (!str_contains(e, "--target"))                         { code = 1; }
        }

        val uk: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("kernel-arm", "", "both", false, true));
        if (sel uk.err) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.cell_supported:enumerated_axis_is_not_pinned_by_the_artifact" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, ut_pin_manifest());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest                = res_manifest.ok;
        val ck: res[bool, outcome.Fail] = cell_supported(?alloc, ?itn, ?m, mk_sel("", "", "kernel", false, true));
        if (sel ck.err) { code = 1; }
        if (sel ck.ok) {
            if (ck.ok) { code = 1; }
        }
        val ct: res[bool, outcome.Fail] = cell_supported(?alloc, ?itn, ?m, mk_sel("", "", "tool", false, true));
        if (sel ct.err) { code = 1; }
        if (sel ct.ok) {
            if (!ct.ok) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.select_primary_artifact:several_candidates_need_exactly_one_default_and_order_is_meaningless" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head:           str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val first:          str = "[artifact.first]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/first\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n";
    val second_default: str = "[artifact.second]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"bin/second\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\ndefault=true\n";
    val second_plain:   str = "[artifact.second]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"bin/second\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n";
    val first_default:  str = "[artifact.first]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/first\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\ndefault=true\n";

    val dr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, first, second_default));
    if (sel dr.err) { code = 1; }
    if (sel dr.ok) {
        var m:                         Manifest          = dr.ok;
        var primary:                   Selection         = mk_sel("linux", "", "", false, false);
        val select_primary_artifact_r: err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?primary);
        if (sel select_primary_artifact_r.err
            || !primary.has_artifact || !str_equals(primary.artifact, "second")) { code = 1; }
        var sole:                          Selection         = mk_sel("linux", "", "", false, false);
        val select_sole_target_artifact_r: err[outcome.Fail] = select_sole_target_artifact(?alloc, ?itn, ?m, ?sole);
        if (sel select_sole_target_artifact_r.err
            || !sole.has_artifact || !str_equals(sole.artifact, "second")) { code = 1; }
        var exe:                               Selection         = mk_sel("linux", "", "", false, false);
        val select_sole_executable_artifact_r: err[outcome.Fail] = select_sole_executable_artifact(?alloc, ?itn, ?m, ?exe);
        if (sel select_sole_executable_artifact_r.err
            || !exe.has_artifact || !str_equals(exe.artifact, "second")) { code = 1; }
        var explicit:                   Selection         = mk_sel("linux", "", "first", false, true);
        val select_primary_artifact_r2: err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?explicit);
        if (sel select_primary_artifact_r2.err
            || !str_equals(explicit.artifact, "first")) { code = 1; }
    }

    val nr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, first, second_plain));
    if (sel nr.err) { code = 1; }
    if (sel nr.ok) {
        var m:       Manifest          = nr.ok;
        var primary: Selection         = mk_sel("linux", "", "", false, false);
        val pr:      err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?primary);
        if (primary.has_artifact) { code = 1; }
        if (sel pr.err) {
            val text: str = outcome.describe(pr.err);
            if (!str_contains(text, "several artifacts support the selected target and none is marked `default = true`")) { code = 1; }
            if (!str_contains(text, "first") || !str_contains(text, "second"))                                            { code = 1; }
        }
        or { code = 1; }
        var sole:                           Selection         = mk_sel("linux", "", "", false, false);
        val select_sole_target_artifact_r2: err[outcome.Fail] = select_sole_target_artifact(?alloc, ?itn, ?m, ?sole);
        if (sel select_sole_target_artifact_r2.err || sole.has_artifact) { code = 1; }
    }

    val tr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, first_default, second_default));
    if (sel tr.err) { code = 1; }
    if (sel tr.ok) {
        var m:       Manifest          = tr.ok;
        var primary: Selection         = mk_sel("linux", "", "", false, false);
        val pr:      err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?primary);
        if (!(sel pr.err && (!(primary.has_artifact) && str_contains(outcome.describe(pr.err), "exactly one")))) { code = 1; }
    }

    val br: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[artifact.bad]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/bad\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\ndefault=\"yes\"\n"));
    if (!(sel br.err && str_contains(outcome.describe(br.err), "default must be a boolean"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.select_primary_artifact:a_target_that_does_not_resolve_is_reported_as_a_target_failure" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head: str = "[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val arts: str = "[artifact.first]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/first\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.second]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"bin/second\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    var foreign_os:  str = "windows";
    var foreign_abi: str = "win64";
    $if ($mach.build.os == $mach.os.windows) {
        foreign_os  = "linux";
        foreign_abi = "sysv64";
    }
    val f1: str = sfmt(?alloc, "[target.f1]\nisa=\"x86_64\"\nos=\"{}\"\nabi=\"{}\"\n", foreign_os, foreign_abi);

    val named: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, f1, arts));
    if (sel named.err) { code = 1; }
    if (sel named.ok) {
        var m:       Manifest          = named.ok;
        var missing: Selection         = mk_sel("nope", "", "", false, false);
        val pr:      err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?missing);
        if (!(sel pr.err && (!(missing.has_artifact) && str_contains(outcome.describe(pr.err), "no target named 'nope'")))) { code = 1; }

        var sole:                          Selection         = mk_sel("nope", "", "", false, false);
        val select_sole_target_artifact_r: err[outcome.Fail] = select_sole_target_artifact(?alloc, ?itn, ?m, ?sole);
        if (sel select_sole_target_artifact_r.err || sole.has_artifact) { code = 1; }
        var exe:                               Selection         = mk_sel("nope", "", "", false, false);
        val select_sole_executable_artifact_r: err[outcome.Fail] = select_sole_executable_artifact(?alloc, ?itn, ?m, ?exe);
        if (sel select_sole_executable_artifact_r.err || exe.has_artifact) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_target:native_without_a_host_match_uses_the_sole_or_default_declaration_never_table_order" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val head:        str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val art:         str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    var foreign_os:  str = "windows";
    var foreign_abi: str = "win64";
    $if ($mach.build.os == $mach.os.windows) {
        foreign_os  = "linux";
        foreign_abi = "sysv64";
    }
    val w1:         str       = sfmt(?alloc, "[target.w1]\nisa=\"x86_64\"\nos=\"{}\"\nabi=\"{}\"\n", foreign_os, foreign_abi);
    val w2:         str       = sfmt(?alloc, "[target.w2]\nisa=\"x86_64\"\nos=\"{}\"\nabi=\"{}\"\n", foreign_os, foreign_abi);
    val w2_default: str       = sfmt(?alloc, "{}default=true\n", w2);
    val w1_default: str       = sfmt(?alloc, "{}default=true\n", w1);
    val native:     Selection = mk_sel("native", "", "", false, false);

    val sr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, w1, art));
    if (sel sr.err) { code = 1; }
    if (sel sr.ok) {
        var m: Manifest                     = sr.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, native);
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            val bu: BuildUnit = u.ok;
            if (!bu.warned || !str_equals(idstr(?itn, bu.target_name), "w1")) { code = 1; }
        }
    }

    # intentional removal (#3226, #3112): two foreign targets and no default is refused
    val nr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, w1, w2, art));
    if (sel nr.err) { code = 1; }
    if (sel nr.ok) {
        var m: Manifest                     = nr.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, native);
        if (sel u.err) {
            val text: str = outcome.describe(u.err);
            if (!str_contains(text, "several targets are declared, none matches the host and none is marked `default = true`")) { code = 1; }
            if (!str_contains(text, "--target"))                                                                                { code = 1; }
        }
        or { code = 1; }
    }

    val dr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, w1, w2_default, art));
    if (sel dr.err) { code = 1; }
    if (sel dr.ok) {
        var m: Manifest                     = dr.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, native);
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            val bu: BuildUnit = u.ok;
            if (!bu.warned || !str_equals(idstr(?itn, bu.target_name), "w2")) { code = 1; }
        }
        val e: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("w1", "", "", false, false));
        if (!(sel e.ok && str_equals(idstr(?itn, e.ok.target_name), "w1"))) { code = 1; }
    }

    val tr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}{}", head, w1_default, w2_default, art));
    if (!(sel tr.err && str_contains(outcome.describe(tr.err), "exactly one"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

# intentional removal test (#3226, #3112): no profile is selected by table order
test "mach.lang.manifest.resolve_profile:several_profiles_without_a_default_are_refused_naming_the_default_key" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:        i32                         = 0;
    val head:        str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val two:         str                         = "[profile.fast]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.slow]\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val two_default: str                         = "[profile.fast]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.slow]\nopt=0\ndebug=true\nsimd=\"scalarize\"\ndefault=true\nvectorize=true\nfloat_reassoc=false\n";
    val lr:          res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, two));
    if (sel lr.err) { code = 1; }
    if (sel lr.ok) {
        var m:  Manifest                           = lr.ok;
        val pr: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
        if (!(sel pr.err && str_equals(outcome.describe(pr.err), AMBIGUOUS_PROFILE_MSG))) { code = 1; }
        val ex: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "slow");
        if (!(sel ex.ok && str_equals(idstr(?itn, ex.ok.name), "slow"))) { code = 1; }
    }
    val dr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, two_default));
    if (sel dr.err) { code = 1; }
    if (sel dr.ok) {
        var m:  Manifest                           = dr.ok;
        val pr: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
        if (sel pr.err) { code = 1; }
        if (sel pr.ok) {
            val rp: ResolvedProfile = pr.ok;
            if (!str_equals(idstr(?itn, rp.name), "slow")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.native_owner:repeated_resolution_borrows_one_manifest_definition" {
    # the dependency form: a root manifest must declare a profile, and this test owns only the native target
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?backing);
    fin { intern.dnit(?itn); }
    val table_r: res[toml.Table, toml.TomlError] = toml.parse(?backing,
        "[project]\nid=\"owner\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n");
    if (sel table_r.err) { ret 2; }
    var table: toml.Table = table_r.ok;
    fin { toml.dnit(?backing, ?table); }
    var tracking: alloc_test.Testing;
    val make_r2:  err[A.Error] = alloc_test.make(?tracking);
    if (sel make_r2.err) { ret 3; }
    fin { alloc_test.dnit(?tracking); }
    val parsed: res[Manifest, outcome.Fail] = parse(?tracking.a, ?itn, ?table, false);
    if (sel parsed.err) { ret 4; }
    var m: Manifest = parsed.ok;
    fin { dnit(?m, ?tracking.a); }
    if (m.native_target == nil || m.targets != nil || m.target_count != 0) { ret 5; }
    val attempts: usize = tracking.attempts;
    tracking.fail_at = attempts + 1;
    var i: usize = 0;
    for (i < 32) {
        val resolved: res[ResolvedTarget, outcome.Fail] = resolve_target(?tracking.a, ?itn, ?m, "native", nil);
        if (sel resolved.err) { ret 6; }
        val rt: ResolvedTarget = resolved.ok;
        if (rt.target != m.native_target || rt.warned)                                   { ret 7; }
        if (!target_matches_host(?itn, rt.target, tgt.host_os_id(), tgt.host_arch_id())) { ret 8; }
        i = i + 1;
    }
    if (tracking.attempts != attempts) { ret 9; }
    dnit(?m, ?tracking.a);
    dnit(?m, ?tracking.a);
    if (tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 10; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        tracking.attempts = 0;
        tracking.fail_at  = ordinal;
        val failed: res[Manifest, outcome.Fail] = parse(?tracking.a, ?itn, ?table, false);
        if (sel failed.ok) {
            var unexpected: Manifest = failed.ok;
            dnit(?unexpected, ?tracking.a);
            ret 11;
        }
        if (tracking.live != 0 || tracking.double_frees != 0 || tracking.exhausted != 0) { ret 12; }
        ordinal = ordinal + 1;
    }
    ret 0;
}

fun t_resolve_build_unit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    selection: Selection) res[BuildUnit, outcome.Fail] {
    var reg: tgt.TargetRegistry = tgt.registry_init();
    fin { tgt.registry_dnit(?reg); }
    val ready: err[fail.Fail] = tgt.register_all(?reg, target_testing.debug_descriptor);
    if (sel ready.err) { ret res[BuildUnit, outcome.Fail].err{outcome.from_fail(ready.err)}; }
    ret resolve_build_unit(alloc, itn, ?reg, m, selection);
}

fun t_check_collisions(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    vars: *TmplVars) err[outcome.Fail] {
    var reg: tgt.TargetRegistry = tgt.registry_init();
    fin { tgt.registry_dnit(?reg); }
    val ready: err[fail.Fail] = tgt.register_all(?reg, target_testing.debug_descriptor);
    if (sel ready.err) { ret err[outcome.Fail].err{outcome.from_fail(ready.err)}; }
    ret check_collisions(alloc, itn, ?reg, m, vars);
}

fun t_resolve_artifact_reqs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    consumer: *ArtifactDef, consumer_target: *TargetDef, profile: str,
    whole_project: bool, out_items: **ArtifactReq, out_count: *u32) err[outcome.Fail] {
    var reg: tgt.TargetRegistry = tgt.registry_init();
    fin { tgt.registry_dnit(?reg); }
    val ready: err[fail.Fail] = tgt.register_all(?reg, target_testing.debug_descriptor);
    if (sel ready.err) { ret err[outcome.Fail].err{outcome.from_fail(ready.err)}; }
    var s: Scope = root_scope(m);
    ret resolve_artifact_reqs(alloc, itn, ?reg, ?s, consumer, consumer_target.name, profile,
        whole_project, out_items, out_count);
}

test "mach.lang.manifest.resolve_build_unit:artifact_suffix_preserves_identity_and_literal_paths" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val src: str = sfmt(?alloc, "{}{}", need_head(),
        "[target.win]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.literal]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/literal\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n");
    val parsed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel parsed.err) { ret 2; }
    var m:       Manifest                     = parsed.ok;
    val linux:   res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("host", "debug", "app", false, true));
    val windows: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("win", "debug", "app", false, true));
    val literal: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("win", "debug", "literal", false, true));
    if (sel linux.err)   { ret 3; }
    if (sel windows.err) { ret 3; }
    if (sel literal.err) { ret 3; }
    val lu: BuildUnit = linux.ok;
    val wu: BuildUnit = windows.ok;
    if (lu.artifact.name != wu.artifact.name || !str_equals(idstr(?itn, wu.artifact.name), "app")) { ret 4; }
    if (!str_equals(idstr(?itn, lu.bin_path), "out/host/bin/app"))                                 { ret 5; }
    if (!str_equals(idstr(?itn, wu.bin_path), "out/win/bin/app.exe"))                              { ret 6; }
    if (!str_equals(idstr(?itn, literal.ok.bin_path), "out/win/bin/literal"))                      { ret 7; }
    var v:           TmplVars               = tmpl_vars_of(?itn, wu.target, "debug");
    val unavailable: res[str, outcome.Fail] = expand(?alloc, "{artifact.suffix}", "out", ?v);
    if (sel unavailable.ok) { ret 8; }
    val alias: res[intern.StrId, A.Error] = intern.intern(?itn, "bin/app.exe");
    if (sel alias.err) { ret 9; }
    val other: *ArtifactDef = find_artifact(?itn, ?m, "literal");
    other.out = alias.ok;
    val t_check_collisions_r: err[outcome.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
    if (sel t_check_collisions_r.ok) { ret 10; }
    ret 0;
}

test "mach.lang.manifest.validate_needs:steps_require_only_steps_and_qualified_globs_skip_the_declarer" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val steps: str = "[step.gen-a]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.gen-b]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"step.gen-*\"]\n";
    val app:   str = "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"step.gen-b\"]\n";

    val glob_skips_self: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", need_head(), steps, app));
    if (sel glob_skips_self.err) { ret 2; }
    var m:       Manifest          = glob_skips_self.ok;
    var order:   *u32              = nil;
    var count:   u32               = 0;
    var vars:    TmplVars          = tmpl_vars_of(?itn, ?m.targets[0], "debug");
    val a:       *ArtifactDef      = find_artifact(?itn, ?m, "app");
    val planned: err[outcome.Fail] = plan_steps(?alloc, ?itn, ?m, ?a.name, 1, ?m.targets[0], "out/host", ?vars, ?order, ?count);
    if (sel planned.err)                                                                                                        { ret 3; }
    if (count != 2)                                                                                                             { ret 3; }
    if (!str_equals(idstr(?itn, m.steps[order[0]].name), "gen-a") || !str_equals(idstr(?itn, m.steps[order[1]].name), "gen-b")) { ret 4; }

    val step_needs_artifact: str = sfmt(?alloc, "{}{}{}", need_head(),
        need_artifact(?alloc, "support", "support", ""),
        "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"artifact.support\"]\n");
    if (!need_err(?alloc, ?itn, step_needs_artifact, "[step.gen].need entry 'artifact.support' must use 'step.<name>' or 'artifact.<name>' with optional '*' wildcards; steps may require only steps")) { ret 5; }

    val step_self: str = sfmt(?alloc, "{}{}", need_head(), "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"step.gen\"]\n");
    if (!need_err(?alloc, ?itn, step_self, "[step.gen].need requires itself")) { ret 6; }

    val step_only_self_glob: str = sfmt(?alloc, "{}{}", need_head(), "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[\"step.g*\"]\n");
    if (!need_err(?alloc, ?itn, step_only_self_glob, "[step.gen].need entry 'step.g*' matches no declaration in its category")) { ret 7; }

    val same_name_both: str = sfmt(?alloc, "{}{}{}{}", need_head(),
        need_artifact(?alloc, "twin", "twin", ""),
        "[step.twin]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"step.twin\",\"artifact.twin\"]\n");
    val both: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, same_name_both);
    if (sel both.err) { ret 8; }
    var mb:       Manifest     = both.ok;
    val consumer: *ArtifactDef = find_artifact(?itn, ?mb, "app");
    val twin:     *ArtifactDef = find_artifact(?itn, ?mb, "twin");
    if (!artifact_needs_artifact(?itn, consumer, twin)) { ret 9; }
    var border:   *u32              = nil;
    var bcount:   u32               = 0;
    var bvars:    TmplVars          = tmpl_vars_of(?itn, ?mb.targets[0], "debug");
    val bplanned: err[outcome.Fail] = plan_steps(?alloc, ?itn, ?mb, ?consumer.name, 1, ?mb.targets[0], "out/host", ?bvars, ?border, ?bcount);
    if (sel bplanned.err)                                           { ret 10; }
    if (bcount != 1)                                                { ret 10; }
    if (!str_equals(idstr(?itn, mb.steps[border[0]].name), "twin")) { ret 10; }
    ret 0;
}

fun t_suffix_unit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, target: str, artifact: str, want_lib: bool) res[BuildUnit, outcome.Fail] {
    ret t_resolve_build_unit(alloc, itn, m, mk_sel(target, "debug", artifact, want_lib, true));
}

test "mach.lang.manifest.resolve_build_unit:artifact_suffix_maps_every_kind_on_every_object_format" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val targets:   str                         = "[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.win]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.mac]\nisa=\"aarch64\"\nos=\"darwin\"\nabi=\"aapcs64\"\n[target.raw]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\n[target.gpu]\nisa=\"spirv\"\nos=\"freestanding\"\nabi=\"spirv\"\n";
    val artifacts: str                         = "[artifact.tool]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/tool{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.archive]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/libarchive{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[artifact.dyn]\nkind=\"shared\"\nentry=\"lib.mach\"\nout=\"lib/libdyn{artifact.suffix}\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";
    val parsed:    res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", need_head(), targets, artifacts));
    if (sel parsed.err) { ret 2; }
    var m: Manifest = parsed.ok;

    var names: [15]str;
    var kinds: [15]str;
    var libs:  [15]bool;
    var wants: [15]str;
    var tn:    [5]str;
    tn[0] = "linux";
    tn[1] = "win";
    tn[2] = "mac";
    tn[3] = "raw";
    tn[4] = "gpu";
    var exe: [5]str;
    exe[0] = "out/linux/bin/tool";
    exe[1] = "out/win/bin/tool.exe";
    exe[2] = "out/mac/bin/tool";
    exe[3] = "out/raw/bin/tool";
    exe[4] = "out/gpu/bin/tool.spv";
    var sta: [5]str;
    sta[0] = "out/linux/lib/libarchive.a";
    sta[1] = "out/win/lib/libarchive.lib";
    sta[2] = "out/mac/lib/libarchive.a";
    sta[3] = "";
    sta[4] = "";
    var shd: [5]str;
    shd[0] = "out/linux/lib/libdyn.so";
    shd[1] = "out/win/lib/libdyn.dll";
    shd[2] = "out/mac/lib/libdyn.dylib";
    shd[3] = "";
    shd[4] = "";
    var i: usize = 0;
    for (i < 5) {
        names[i * 3]     = tn[i];
        kinds[i * 3]     = "tool";
        libs[i * 3]      = false;
        wants[i * 3]     = exe[i];
        names[i * 3 + 1] = tn[i];
        kinds[i * 3 + 1] = "archive";
        libs[i * 3 + 1]  = true;
        wants[i * 3 + 1] = sta[i];
        names[i * 3 + 2] = tn[i];
        kinds[i * 3 + 2] = "dyn";
        libs[i * 3 + 2]  = true;
        wants[i * 3 + 2] = shd[i];
        i                = i + 1;
    }
    i = 0;
    for (i < 15) {
        val u: res[BuildUnit, outcome.Fail] = t_suffix_unit(?alloc, ?itn, ?m, names[i], kinds[i], libs[i]);
        if (str_empty(wants[i])) {
            if (sel u.ok)                                                                             { ret 10 + i::i32; }
            if (!str_contains(outcome.describe(u.err), "artifact naming: this object format has no")) { ret 10 + i::i32; }
        }
        or {
            if (sel u.err)                                         { ret 30 + i::i32; }
            if (!str_equals(idstr(?itn, u.ok.bin_path), wants[i])) { ret 50 + i::i32; }
        }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.manifest.expand:artifact_suffix_is_refused_outside_an_artifact_output" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val project_out: str = sfmt(?alloc, "{}{}", "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{artifact.suffix}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n");
    val parsed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, project_out);
    if (sel parsed.err) { ret 2; }
    var m: Manifest                     = parsed.ok;
    val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("host", "debug", "app", false, true));
    if (sel u.ok)                                                                                              { ret 3; }
    if (!str_contains(outcome.describe(u.err), "'{artifact.suffix}' is available only in an artifact output")) { ret 3; }

    val step_out: str = sfmt(?alloc, "{}{}", need_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"step.gen\"]\n[step.gen]\nargv=[\"true\"]\nin=[]\nout=[\"{project.out}/gen{artifact.suffix}\"]\nneed=[]\n");
    val sp: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, step_out);
    if (sel sp.err) { ret 4; }
    var ms:       Manifest               = sp.ok;
    var v:        TmplVars               = tmpl_vars_of(?itn, ?ms.targets[0], "debug");
    val expanded: res[str, outcome.Fail] = expand(?alloc, idstr(?itn, ms.steps[0].out[0]), "out/host", ?v);
    if (sel expanded.ok)                                                                                              { ret 5; }
    if (!str_contains(outcome.describe(expanded.err), "'{artifact.suffix}' is available only in an artifact output")) { ret 5; }
    ret 0;
}
