test resolve_build_unit__native_resolution_zero_target {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nmach=\">=5\"\nid = \"x\"\nversion = \"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (m.target_count != 0) { code = 1; }

        val ue: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "", "");
        if (sel ue.err) { code = 1; }

        val u: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "native", "");
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            val bu: BuildUnit = u.ok;
            if (!str_equals(intern.text(?itn, bu.target_name), "native"))                                       { code = 1; }
            if (!str_equals(intern.text(?itn, bu.target.isa), host_isa_name()))                                 { code = 1; }
            if (!str_equals(intern.text(?itn, bu.target.os), host_os_name()))                                   { code = 1; }
            if (!str_equals(intern.text(?itn, bu.target.abi), catalog_abi.name_for(lang_target.host_abi_id()))) { code = 1; }
            if (!str_equals(intern.text(?itn, bu.obj_root), "out/native/obj"))                                  { code = 1; }
        }

        val uf: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "foreign", "");
        if (!(sel uf.err && str_contains(fail.describe(uf.err), "no target named"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test resolve_build_unit__collision_detection {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"bin/app\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.a]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"{project.out}/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.b]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"{project.out}/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n", ""));
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest        = res_manifest.ok;
        var v:  template.Values = template.values_of(?itn, ?m.targets[0], "debug");
        val cr: err[fail.Fail]  = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (!(sel cr.err && str_equals(fail.describe(cr.err), "mach.toml: artifacts 'a' and 'b' collide on output path 'bin/app/app'"))) { code = 1; }
    }

    val res_clean: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app1\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.tool]\nkind=\"bin\"\nentry=\"tool.mach\"\nout=\"{project.out}/bin/app2\"\ntargets = [\"*\"]\nlink = []\nneed = []\n", ""));
    if (sel res_clean.err) { code = 1; }
    if (sel res_clean.ok) {
        var m:  Manifest        = res_clean.ok;
        var v:  template.Values = template.values_of(?itn, ?m.targets[0], "debug");
        val cr: err[fail.Fail]  = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (sel cr.err) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test resolve_build_unit__links {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                      = t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[link.sys]\nsource=\"system\"\nname=\"c\"\nos=[\"linux\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.local_lib]\nsource=\"local\"\npath=\"lib/mylib.a\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app\"\ntargets = [\"*\"]\nlink = [\"sys\", \"local_lib\"]\nneed = []\n", "");
    val res_manifest: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (m.link_count != 2) { code = 1; }

        val ul: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "linux", "");
        if (sel ul.err) { code = 1; }
        if (sel ul.ok) {
            val bu: BuildUnit = ul.ok;
            if (bu.lib_count != 2)                                                   { code = 1; }
            if (!requirement_has(?itn, bu.libs, bu.lib_count, "c"))                  { code = 1; }
            if (!requirement_has(?itn, bu.libs, bu.lib_count, "lib/mylib.a"))        { code = 1; }
            if (bu.libs[0].source != LINK_SYSTEM || bu.libs[1].source != LINK_LOCAL) { code = 1; }
            if (!str_equals(intern.text(?itn, bu.libs[0].key), "sys"))               { code = 1; }
            if (!str_equals(intern.text(?itn, bu.libs[1].key), "local_lib"))         { code = 1; }
        }

        val uw: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "windows", "");
        if (sel uw.err) { code = 1; }
        if (sel uw.ok) {
            val bu: BuildUnit = uw.ok;
            if (bu.lib_count != 1)                                            { code = 1; }
            if (!requirement_has(?itn, bu.libs, bu.lib_count, "lib/mylib.a")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

