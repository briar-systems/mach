# one resolved build cell: a target, a profile, and an artifact with every path
# expanded. produced by `resolve_build_unit`; `libs` is owned by the unit
# ---
# target:        the resolved target; points into the manifest, except for the host
#                target synthesized when the manifest declares no targets
# artifact:      the resolved artifact, pointing into the manifest
# target_name:   `target.name`
# profile_name:  the resolved profile's name
# entry:         the artifact's `entry`
# bin_path:      the artifact's output: the expanded `[project].out` joined with the
#                expanded artifact `out`
# out_root:      `<expanded project out>`, whose layout beneath it the build owns
# obj_root:      `<expanded project out>/obj`
# ir_root:       `<expanded project out>/ir`
# asm_root:      `<expanded project out>/asm`
# test_root:     `<expanded project out>/test/{name}`, with `{name}` left literal for
#                the test runner to fill
# cache_root:    `<expanded project out>/.cache`, the compiler-only state
# stage_root:    `<expanded project out>/.stage`, the build step scratch space
# opt:           from the resolved profile
# debug:         from the resolved profile
# simd:          from the resolved profile
# vectorize:     from the resolved profile
# float_reassoc: from the resolved profile
# libs:          the artifact's `link` entries that match the target, resolved in `link`
#                order and sized exactly; a `link` name matching no `[link.*]` table is skipped
# lib_count:     length of `libs`
pub rec BuildUnit {
    target:        *TargetDef;
    artifact:      *ArtifactDef;
    target_name:   intern.StrId;
    profile_name:  intern.StrId;
    entry:         intern.StrId;
    bin_path:      intern.StrId;
    out_root:      intern.StrId;
    obj_root:      intern.StrId;
    ir_root:       intern.StrId;
    asm_root:      intern.StrId;
    test_root:     intern.StrId;
    cache_root:    intern.StrId;
    stage_root:    intern.StrId;
    opt:           MOpt;
    debug:         bool;
    simd:          SimdMode;
    vectorize:     bool;
    float_reassoc: bool;
    libs:          *LinkRequirement;
    lib_count:     u32;
}

# the manifest that declares a build cell, and the root project the cell is built
# for. a root cell has `owner == root`. a dependency's cell is one of the
# requirements its export library carries: it resolves its artifact, targets and
# links in `owner`, its profile in `root`, expands the root's `[project].out`, and
# reads `{project.out}` in its artifact outputs as `dep/<owner id>` of that out,
# so identically named artifacts of two dependencies never share a path
# ---
# root:  the manifest of the project being built
# owner: the manifest declaring the cell's artifact; `root` for the root's own
pub rec Scope {
    root:  *Manifest;
    owner: *Manifest;
}

# the directory under the expanded root `[project].out` that holds a dependency's
# artifact outputs, one subdirectory per dependency id
pub val DEPENDENCY_ARTIFACT_DIR: str = "dep";

# the directory under the expanded `[project].out` that holds compiler-only state:
# nothing but the compiler reads or writes it, and a step output may not name it
pub val CACHE_DIR: str = ".cache";

# the directory under `CACHE_DIR` that holds one fingerprint stamp per build step
pub val STEP_STAMP_DIR: str = ".cache/steps";

# the directory under the expanded `[project].out` that holds build step scratch
# space, one subdirectory per step, reset before the step runs
pub val STAGE_DIR: str = ".stage";

pub fun root_scope(m: *Manifest) Scope {
    ret Scope{root: m, owner: m};
}

pub fun dependency_scope(root: *Manifest, owner: *Manifest) Scope {
    ret Scope{root: root, owner: owner};
}

pub fun scope_is_dependency(s: *Scope) bool {
    ret s.owner != s.root;
}

# the value `{project.out}` takes in an artifact output of the scope
# ---
# alloc:    owns the returned path
# itn:      resolves the owner id
# s:        the scope
# proj_out: the expanded root `[project].out`
# ret:      `proj_out` for the root, `<proj_out>/dep/<owner id>` for a dependency
fun scope_artifact_root(alloc: *A.Allocator, itn: *intern.Interner, s: *Scope, proj_out: str) res[str, fail.Fail] {
    if (!scope_is_dependency(s)) { ret path_dup(alloc, proj_out, 0, str_len(proj_out)); }
    val home: res[str, fail.Fail] = path_join(alloc, proj_out, DEPENDENCY_ARTIFACT_DIR);
    if (sel home.err) { ret home; }
    val owned: res[str, fail.Fail] = path_join(alloc, home.ok, intern.text(itn, s.owner.id));
    str_free(alloc, home.ok);
    ret owned;
}

fun free_path_strings(alloc: *A.Allocator, paths: *str, count: u32) {
    if (paths == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        if (paths[i] != nil) { str_free(alloc, paths[i]); }
        i = i + 1;
    }
}

# the bytes [start, end) of `text` as a string `alloc` owns
fun path_dup(alloc: *A.Allocator, text: str, start: usize, end: usize) res[str, fail.Fail] {
    val r: res[str, A.Error] = str_dup_range(alloc, text, start, end - start);
    if (sel r.err) { ret res[str, fail.Fail].err{fail.refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

# `a` and `b` joined by one '/', whatever separators they end and start with
fun path_join(alloc: *A.Allocator, a: str, b: str) res[str, fail.Fail] {
    if (str_empty(a)) { ret path_dup(alloc, b, 0, str_len(b)); }
    if (str_empty(b)) { ret path_dup(alloc, a, 0, str_len(a)); }
    var end_a: usize = str_len(a);
    if (a[end_a - 1] == '/') { end_a = end_a - 1; }
    var start_b: usize = 0;
    if (b[0] == '/') { start_b = 1; }
    val a_sub: res[str, fail.Fail] = path_dup(alloc, a, 0, end_a);
    if (sel a_sub.err) { ret a_sub; }
    fin { str_free(alloc, a_sub.ok); }
    val b_sub: res[str, fail.Fail] = path_dup(alloc, b, start_b, str_len(b));
    if (sel b_sub.err) { ret b_sub; }
    fin { str_free(alloc, b_sub.ok); }
    ret sfmt(alloc, "{}/{}", a_sub.ok, b_sub.ok);
}

# the names of the targets `a` supports, comma separated
fun artifact_target_names(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, a: *ArtifactDef) res[str, fail.Fail] {
    var s: str = "";
    var i: u32 = 0;
    for (i < m.target_count) {
        if (artifact_supports_target(itn, a, m.targets[i].name)) {
            var sep: str = "";
            if (!str_empty(s)) { sep = ", "; }
            val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}{}", s, sep, intern.text(itn, m.targets[i].name));
            if (sel longer.err) { ret longer; }
            s = longer.ok;
        }
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

# the build step whose expanded `out` list holds a path
# ---
# alloc:         owns temporary expansions
# itn:           resolves step strings
# m:             the manifest
# expanded_path: the path to match, already expanded
# proj_out:      the expanded `[project].out`
# v:             the template values
# ret:           the index into `m.steps` of the first producing step, or -1; err
#                when a step output does not expand
fun step_producing_out(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    expanded_path: str, proj_out: str, v: *template.Values) res[i64, fail.Fail] {
    var si: u32 = 0;
    for (si < m.step_count) {
        val s:  *StepDef = ?m.steps[si];
        var oi: u32      = 0;
        for (oi < s.out_count) {
            val exp_r: res[str, fail.Fail] = template.path_expand(alloc, intern.text(itn, s.out[oi]), template.CONTEXT_PATH, proj_out, v, "a build step output");
            if (sel exp_r.err) { ret res[i64, fail.Fail].err{exp_r.err}; }
            val eq: bool = str_equals(exp_r.ok, expanded_path);
            str_free(alloc, exp_r.ok);
            if (eq) { ret res[i64, fail.Fail].ok{si::i64}; }
            oi = oi + 1;
        }
        si = si + 1;
    }
    ret res[i64, fail.Fail].ok{-1};
}

# whether some build step produces a path; `step_producing_out` as a bool
pub fun local_path_demanded_by_step(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    expanded_path: str, proj_out: str, v: *template.Values) res[bool, fail.Fail] {
    val r: res[i64, fail.Fail] = step_producing_out(alloc, itn, m, expanded_path, proj_out, v);
    if (sel r.err) { ret res[bool, fail.Fail].err{r.err}; }
    ret res[bool, fail.Fail].ok{r.ok >= 0};
}

# whether a required artifact is built for a target when its consumer builds for
# `consumer_target`: only that target when `req` supports it, otherwise every
# target `req` supports
# ---
# itn:             resolves the names
# req:             the required artifact
# consumer_target: the consumer's target name, or STR_NIL for a consumer outside
#                  `req`'s manifest, which admits every target `req` supports
# t:               the target asked about
# ret:             true when `req` is built for `t` on behalf of that consumer
pub fun required_artifact_uses_target(itn: *intern.Interner, req: *ArtifactDef,
    consumer_target: intern.StrId, t: *TargetDef) bool {
    if (!intern.str_is_nil(consumer_target) && artifact_supports_target(itn, req, consumer_target)) {
        ret intern.str_same(t.name, consumer_target);
    }
    ret artifact_supports_target(itn, req, t.name);
}

# how many declared targets `required_artifact_uses_target` admits for a requirement
fun required_artifact_target_count(itn: *intern.Interner, m: *Manifest, req: *ArtifactDef,
    consumer_target: intern.StrId) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < m.target_count) {
        if (required_artifact_uses_target(itn, req, consumer_target, ?m.targets[i])) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun artifact_out_for_target(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, s: *Scope,
    a: *ArtifactDef, t: *TargetDef, profile: str) res[str, fail.Fail] {
    var v: template.Values = template.values_of(itn, t, profile);

    val proj_out_r: res[str, fail.Fail] = expand_project_out(alloc, itn, s.root, ?v);
    if (sel proj_out_r.err) { ret proj_out_r; }
    val proj_out: str = proj_out_r.ok;
    fin { str_free(alloc, proj_out); }

    ret scoped_artifact_output(alloc, itn, reg, s, a, proj_out, ?v);
}

# whether any artifact's `need` selects `ra`
# ---
# itn: resolves the names
# m:   the manifest
# ra:  the candidate requirement
# ret: true when some other artifact needs it
fun artifact_required_by_any(itn: *intern.Interner, m: *Manifest, ra: *ArtifactDef) bool {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (artifact_needs_artifact(itn, ?m.artifacts[i], ra)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the export library selects `ra` in its `need`: the requirements a
# dependency's export library carries to every consumer
# ---
# itn: resolves the names
# m:   the manifest
# ra:  the candidate requirement
# ret: true when the artifact marked `export = true` needs it
pub fun export_requires(itn: *intern.Interner, m: *Manifest, ra: *ArtifactDef) bool {
    val a: *ArtifactDef = export_artifact(m);
    ret a != nil && artifact_needs_artifact(itn, a, ra);
}

# which artifacts a requirement list names
def ReqSource: u8;

# the artifacts one consumer artifact needs
val REQS_OF_CONSUMER: ReqSource = 0;
# every artifact some artifact needs; the editor's union of every artifact
val REQS_OF_PROJECT: ReqSource = 1;
# the artifacts the export library needs; a dependency's export surface
val REQS_OF_EXPORT: ReqSource = 2;

fun req_selected(itn: *intern.Interner, m: *Manifest, consumer: *ArtifactDef,
    ra: *ArtifactDef, source: ReqSource) bool {
    if (source == REQS_OF_PROJECT) { ret artifact_required_by_any(itn, m, ra); }
    if (source == REQS_OF_EXPORT)  { ret export_requires(itn, m, ra); }
    if (consumer == nil)           { ret false; }
    ret artifact_needs_artifact(itn, consumer, ra);
}

# list the artifacts a consumer requires, each with its output path when that
# path is unique, for `{artifact.<id>.out}` expansion
# ---
# alloc:           owns the returned array and each non-empty `out` string
# itn:             resolves names
# s:               the scope; the requirements are declared by `s.owner`
# consumer:        the requiring artifact; nil with `whole_project` false yields nothing
# consumer_target: the consumer's target name
# profile:         the profile name the outputs expand with
# whole_project:   select every artifact some artifact needs instead of `consumer`'s
# out_items:       receives the array, or nil when nothing is required
# out_count:       receives its length
# ret:             ok; err from the output path expansion, with the array freed
pub fun resolve_artifact_reqs(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, s: *Scope,
    consumer: *ArtifactDef, consumer_target: intern.StrId, profile: str,
    whole_project: bool,
    out_items: **template.Requirement, out_count: *u32) err[fail.Fail] {
    @out_items = nil;
    @out_count = 0;
    if (consumer == nil && !whole_project) { ret err[fail.Fail].ok{}; }
    var source: ReqSource = REQS_OF_CONSUMER;
    if (whole_project) { source = REQS_OF_PROJECT; }
    ret collect_artifact_reqs(alloc, itn, reg, s, consumer, consumer_target, profile, source, out_items, out_count);
}

# list the artifacts a dependency's export library requires, the scope
# `{artifact.<id>.out}` resolves in for that dependency's modules. each requirement
# builds for every target it names in the dependency's manifest
# ---
# alloc:     owns the returned array and each non-empty `out` string
# itn:       resolves names
# s:         a dependency scope
# profile:   the root's profile name the outputs expand with
# out_items: receives the array, or nil when nothing is required
# out_count: receives its length
# ret:       ok; err from the output path expansion, with the array freed
pub fun resolve_export_reqs(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry,
    s: *Scope, profile: str, out_items: **template.Requirement, out_count: *u32) err[fail.Fail] {
    @out_items = nil;
    @out_count = 0;
    ret collect_artifact_reqs(alloc, itn, reg, s, nil, intern.STR_NIL, profile, REQS_OF_EXPORT,
        out_items, out_count);
}

fun collect_artifact_reqs(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, s: *Scope,
    consumer: *ArtifactDef, consumer_target: intern.StrId, profile: str, source: ReqSource,
    out_items: **template.Requirement, out_count: *u32) err[fail.Fail] {
    val m: *Manifest = s.owner;
    if (m.artifact_count == 0) { ret err[fail.Fail].ok{}; }

    var n: u32 = 0;
    var j: u32 = 0;
    for (j < m.artifact_count) {
        if (req_selected(itn, m, consumer, ?m.artifacts[j], source)) { n = n + 1; }
        j = j + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val ir: res[*template.Requirement, A.Error] = A.allocate[template.Requirement](alloc, n::usize);
    if (sel ir.err) { ret err[fail.Fail].err{fail.refused(ir.err)}; }
    val items: *template.Requirement = ir.ok;

    var w: u32 = 0;
    j = 0;
    for (j < m.artifact_count) {
        val ra: *ArtifactDef = ?m.artifacts[j];
        if (req_selected(itn, m, consumer, ra, source)) {
            var item: template.Requirement;
            item.name = intern.text(itn, ra.name);
            item.out  = "";
            if (required_artifact_target_count(itn, m, ra, consumer_target) == 1) {
                var ti: u32 = 0;
                for (ti < m.target_count) {
                    if (required_artifact_uses_target(itn, ra, consumer_target, ?m.targets[ti])) {
                        val pr: res[str, fail.Fail] = artifact_out_for_target(alloc, itn, reg, s, ra, ?m.targets[ti], profile);
                        if (sel pr.err) {
                            var prior: u32 = 0;
                            for (prior < w) {
                                if (!str_empty(items[prior].out)) { str_free(alloc, items[prior].out); }
                                prior = prior + 1;
                            }
                            A.deallocate[template.Requirement](alloc, items, n::usize);
                            ret err[fail.Fail].err{pr.err};
                        }
                        item.out = pr.ok;
                        brk;
                    }
                    ti = ti + 1;
                }
            }
            items[w] = item;
            w        = w + 1;
        }
        j = j + 1;
    }
    @out_items = items;
    @out_count = w;
    ret err[fail.Fail].ok{};
}

# order the build steps the named artifacts demand: a step producing a local
# link path that matches the target, every step a `need` names (globs match
# step names), and transitively each step's own `need`, dependencies first
# ---
# alloc:     owns the returned order
# itn:       resolves names
# m:         the manifest
# art_names: the artifacts to plan for; unknown names are skipped
# art_count: length of `art_names`
# t:         the target
# proj_out:  the expanded `[project].out`
# v:         the template values
# out_order: receives the step indices in run order, sized exactly; nil when none
# out_count: receives the length
# ret:       ok; err on a step `need` cycle or a local link path that fails to expand
pub fun plan_steps(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    art_names: *intern.StrId, art_count: u32, t: *TargetDef,
    proj_out: str, v: *template.Values,
    out_order: **u32, out_count: *u32) err[fail.Fail] {
    var seeds: Vector[Seed] = collections_vector.init[Seed](alloc);
    fin { collections_vector.dnit[Seed](?seeds); }
    var ai: u32 = 0;
    for (ai < art_count) {
        val a: *ArtifactDef = find_artifact_by_name(m, art_names[ai]);
        ai = ai + 1;
        if (a == nil) { cnt; }
        var li: u32 = 0;
        for (li < a.link_count) {
            val l: *LinkDef = find_link_by_name(m, a.link[li]);
            if (l != nil) {
                val added: err[fail.Fail] = seed_add(?seeds, Seed{link: l, artifact: nil});
                if (sel added.err) { ret added; }
            }
            li = li + 1;
        }
        val added: err[fail.Fail] = seed_add(?seeds, Seed{link: nil, artifact: a});
        if (sel added.err) { ret added; }
    }
    ret steps_from(alloc, itn, m, ?seeds, t, proj_out, v, out_order, out_count);
}

# order the build steps that produce an exported local link path matching the
# target and the steps the export library's `need` names, with their
# transitive step `need`s; the steps a consumer of this manifest must run
# ---
# alloc:     owns the returned order
# itn:       resolves names
# m:         the manifest
# t:         the target
# proj_out:  the expanded `[project].out`
# v:         the template values
# out_order: receives the step indices in run order, sized exactly; nil when none
# out_count: receives the length
# ret:       ok; the `plan_steps` errors
pub fun plan_export_steps(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    t: *TargetDef, proj_out: str, v: *template.Values,
    out_order: **u32, out_count: *u32) err[fail.Fail] {
    var seeds: Vector[Seed] = collections_vector.init[Seed](alloc);
    fin { collections_vector.dnit[Seed](?seeds); }
    var li: u32 = 0;
    for (li < m.link_count) {
        if (m.links[li].export) {
            val added: err[fail.Fail] = seed_add(?seeds, Seed{link: ?m.links[li], artifact: nil});
            if (sel added.err) { ret added; }
        }
        li = li + 1;
    }
    var ai: u32 = 0;
    for (ai < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[ai];
        if (a.is_export) {
            val added: err[fail.Fail] = seed_add(?seeds, Seed{link: nil, artifact: a});
            if (sel added.err) { ret added; }
        }
        ai = ai + 1;
    }
    ret steps_from(alloc, itn, m, ?seeds, t, proj_out, v, out_order, out_count);
}

# where a step plan starts: a link whose local path a step may produce, or an
# artifact whose `need` names steps; exactly one is set
rec Seed {
    link:     *LinkDef;
    artifact: *ArtifactDef;
}

fun seed_add(seeds: *Vector[Seed], seed: Seed) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[Seed](seeds, seed);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the one step planner: walk the need graph from the step producing each seed
# link's local path for the target and from each step a seed artifact's `need`
# names, and order the steps reached, each after the steps it needs
fun steps_from(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, seeds: *Vector[Seed],
    t: *TargetDef, proj_out: str, v: *template.Values,
    out_order: **u32, out_count: *u32) err[fail.Fail] {
    @out_order = nil;
    @out_count = 0;
    if (m.step_count == 0) { ret err[fail.Fail].ok{}; }
    val wr: res[need.Walk, fail.Fail] = need.walk_init(alloc, itn, m);
    if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
    var w: need.Walk = wr.ok;
    fin { need.walk_dnit(?w); }

    var i: usize = 0;
    for (i < seeds.len) {
        val seed:    Seed           = seeds.data[i];
        var visited: err[fail.Fail] = err[fail.Fail].ok{};
        if (seed.link != nil) { visited = link_seed_visit(alloc, itn, m, ?w, seed.link, t, proj_out, v); }
        or                    { visited = artifact_seed_visit(itn, m, ?w, seed.artifact); }
        if (sel visited.err)  { ret visited; }
        i = i + 1;
    }

    if (w.order.len == 0) { ret err[fail.Fail].ok{}; }
    val or_: res[*u32, A.Error] = A.allocate[u32](alloc, w.order.len);
    if (sel or_.err) { ret err[fail.Fail].err{fail.refused(or_.err)}; }
    var k: usize = 0;
    for (k < w.order.len) {
        or_.ok[k] = w.order.data[k].index;
        k         = k + 1;
    }
    @out_order = or_.ok;
    @out_count = w.order.len::u32;
    ret err[fail.Fail].ok{};
}

# visit the step producing `l`'s local path for `t`, when one does
fun link_seed_visit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, w: *need.Walk, l: *LinkDef,
    t: *TargetDef, proj_out: str, v: *template.Values) err[fail.Fail] {
    if (l.source != LINK_LOCAL || !link_matches_target(itn, l, t)) { ret err[fail.Fail].ok{}; }
    val exp_r: res[str, fail.Fail] = expand_local_path(alloc, itn, l, proj_out, v);
    if (sel exp_r.err) { ret err[fail.Fail].err{exp_r.err}; }
    val sidx: res[i64, fail.Fail] = step_producing_out(alloc, itn, m, exp_r.ok, proj_out, v);
    str_free(alloc, exp_r.ok);
    if (sel sidx.err) { ret err[fail.Fail].err{sidx.err}; }
    if (sidx.ok < 0)  { ret err[fail.Fail].ok{}; }
    ret need.visit(w, need.step_node(sidx.ok::u32));
}

# visit every step a `need` entry of `a` selects
fun artifact_seed_visit(itn: *intern.Interner, m: *Manifest, w: *need.Walk, a: *ArtifactDef) err[fail.Fail] {
    var ni: u32 = 0;
    for (ni < a.need_count) {
        var si: u32 = 0;
        for (si < m.step_count) {
            if (need.selects(itn, a.need[ni], need.CATEGORY_STEP, m.steps[si].name)) {
                val visited: err[fail.Fail] = need.visit(w, need.step_node(si));
                if (sel visited.err) { ret visited; }
            }
            si = si + 1;
        }
        ni = ni + 1;
    }
    ret err[fail.Fail].ok{};
}

# resolve one cell into a `BuildUnit`. the cell names its artifact; with no
# target named, an artifact that supports exactly one declared target, or exactly
# one host-matching target, pins it, except that a sole hosted target the host
# cannot run is refused as `native` refuses it; otherwise `native` resolution
# applies. the profile comes from `resolve_profile`, and every path is expanded
# through the template engine
# ---
# alloc: owns `libs` and temporary strings
# itn:   interns the expanded paths
# m:     the manifest
# c:     the cell, as `resolve_cells` resolves it or as `cell_of` names it
# ret:   the unit; err from target or profile resolution, for an artifact the
#        manifest does not declare, when the artifact does not support the target
#        (naming the artifact's targets when none was selected), or from path expansion
pub fun resolve_build_unit(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, m: *Manifest, c: *Cell) res[BuildUnit, fail.Fail] {
    var s: Scope = root_scope(m);
    ret resolve_scoped_build_unit(alloc, itn, reg, ?s, c);
}

# `resolve_build_unit` for a cell of `s`: target, artifact and links resolve in
# `s.owner`, the profile and `[project].out` in `s.root`, and `{project.out}` in
# the artifact output names the scope's artifact root
# ---
# alloc: owns `libs` and temporary strings
# itn:   interns the expanded paths
# s:     the scope
# c:     the cell, naming a target and an artifact of `s.owner` and a profile of `s.root`
# ret:   as `resolve_build_unit`
pub fun resolve_scoped_build_unit(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, s: *Scope, c: *Cell) res[BuildUnit, fail.Fail] {
    val m: *Manifest    = s.owner;
    val a: *ArtifactDef = find_artifact(itn, m, c.artifact);
    if (a == nil) {
        ret res[BuildUnit, fail.Fail].err{refuse(alloc, diagnostic_kind.SELECTION_UNKNOWN, "mach.toml: no artifact named '{}'", c.artifact)};
    }

    val res_target: res[ResolvedTarget, fail.Fail] = resolve_target(alloc, itn, m, c.target, a);
    if (sel res_target.err) { ret res[BuildUnit, fail.Fail].err{res_target.err}; }
    val rt: ResolvedTarget = res_target.ok;

    val res_profile: res[ResolvedProfile, fail.Fail] = resolve_profile(alloc, itn, s.root, c.profile);
    if (sel res_profile.err) { ret res[BuildUnit, fail.Fail].err{res_profile.err}; }
    val rp: ResolvedProfile = res_profile.ok;

    if (!artifact_supports_target(itn, a, rt.target.name)) {
        val art_name: str = intern.text(itn, a.name);
        if (str_empty(c.target)) {
            val names: res[str, fail.Fail] = artifact_target_names(alloc, itn, m, a);
            if (sel names.err) { ret res[BuildUnit, fail.Fail].err{names.err}; }
            ret res[BuildUnit, fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.SELECTION_UNSUPPORTED_TARGET,
                "mach.toml: artifact '{}' declares no target for this host; select one with -t ({})", art_name, names.ok), a.targets_at)};
        }
        ret res[BuildUnit, fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.SELECTION_UNSUPPORTED_TARGET,
            "mach.toml: artifact '{}' does not support target '{}'", art_name, intern.text(itn, rt.target.name)), a.targets_at)};
    }

    var u: BuildUnit;
    u.target        = rt.target;
    u.artifact      = a;
    u.target_name   = rt.target.name;
    u.profile_name  = rp.name;
    u.opt           = rp.opt;
    u.debug         = rp.debug;
    u.simd          = rp.simd;
    u.vectorize     = rp.vectorize;
    u.float_reassoc = rp.float_reassoc;
    u.entry         = a.entry;

    var v: template.Values = template.values_of(itn, rt.target, intern.text(itn, rp.name));

    val res_project_out: res[str, fail.Fail] = expand_project_out(alloc, itn, s.root, ?v);
    if (sel res_project_out.err) { ret res[BuildUnit, fail.Fail].err{res_project_out.err}; }
    val proj_out: str = res_project_out.ok;
    fin { str_free(alloc, proj_out); }

    val libs: err[fail.Fail] = unit_libs(alloc, itn, m, a, rt.target, proj_out, ?v, ?u);
    if (sel libs.err) { ret res[BuildUnit, fail.Fail].err{libs.err}; }

    var roots: [7]intern.StrId;
    var under: [7]str = [7]str{"", "obj", "ir", "asm", "test/{name}", CACHE_DIR, STAGE_DIR};
    var k:     usize  = 0;
    for (k < 7) {
        var root: res[str, fail.Fail];
        if (k == 0) { root = path_dup(alloc, proj_out, 0, str_len(proj_out)); }
        or          { root = sfmt(alloc, "{}/{}", proj_out, under[k]); }
        if (sel root.err) {
            free_link_claims(alloc, u.libs, u.lib_count);
            ret res[BuildUnit, fail.Fail].err{root.err};
        }
        val id: res[intern.StrId, fail.Fail] = id_of(itn, root.ok);
        str_free(alloc, root.ok);
        if (sel id.err) {
            free_link_claims(alloc, u.libs, u.lib_count);
            ret res[BuildUnit, fail.Fail].err{id.err};
        }
        roots[k] = id.ok;
        k        = k + 1;
    }
    u.out_root   = roots[0];
    u.obj_root   = roots[1];
    u.ir_root    = roots[2];
    u.asm_root   = roots[3];
    u.test_root  = roots[4];
    u.cache_root = roots[5];
    u.stage_root = roots[6];

    val bin: res[str, fail.Fail] = scoped_artifact_output(alloc, itn, reg, s, a, proj_out, ?v);
    if (sel bin.err) {
        free_link_claims(alloc, u.libs, u.lib_count);
        ret res[BuildUnit, fail.Fail].err{bin.err};
    }
    val res_bin: res[intern.StrId, fail.Fail] = id_of(itn, bin.ok);
    str_free(alloc, bin.ok);
    if (sel res_bin.err) {
        free_link_claims(alloc, u.libs, u.lib_count);
        ret res[BuildUnit, fail.Fail].err{res_bin.err};
    }
    u.bin_path = res_bin.ok;
    ret res[BuildUnit, fail.Fail].ok{u};
}

# the artifact's `link` entries that match the target, resolved in order into
# `u.libs`, sized exactly; a name no `[link.*]` declares is skipped
fun unit_libs(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, a: *ArtifactDef, t: *TargetDef,
    proj_out: str, v: *template.Values, u: *BuildUnit) err[fail.Fail] {
    u.libs      = nil;
    u.lib_count = 0;
    if (a.link_count == 0) { ret err[fail.Fail].ok{}; }
    val res_match_arr: res[*LinkRequirement, A.Error] = A.allocate[LinkRequirement](alloc, a.link_count::usize);
    if (sel res_match_arr.err) { ret err[fail.Fail].err{fail.refused(res_match_arr.err)}; }
    val matched: *LinkRequirement = res_match_arr.ok;
    var count:   u32              = 0;
    var li:      u32              = 0;
    for (li < a.link_count) {
        val l: *LinkDef = find_link_by_name(m, a.link[li]);
        li = li + 1;
        if (l == nil || !link_matches_target(itn, l, t)) { cnt; }
        val req_r: res[LinkRequirement, fail.Fail] = link_requirement(alloc, itn, l, proj_out, v);
        if (sel req_r.err) {
            free_link_claims(alloc, matched, count);
            A.deallocate[LinkRequirement](alloc, matched, a.link_count::usize);
            ret err[fail.Fail].err{req_r.err};
        }
        matched[count] = req_r.ok;
        count          = count + 1;
    }
    ret finish_link_requirements(alloc, matched, a.link_count, count, ?u.libs, ?u.lib_count);
}

# an artifact's output: its expanded `out`, with `{project.out}` naming the
# scope's artifact root. a dependency's output must lie under that root: a path
# beside it would write into the consuming project's own tree
fun scoped_artifact_output(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, s: *Scope,
    a: *ArtifactDef, proj_out: str, v: *template.Values) res[str, fail.Fail] {
    val art_root: res[str, fail.Fail] = scope_artifact_root(alloc, itn, s, proj_out);
    if (sel art_root.err) { ret art_root; }
    fin { str_free(alloc, art_root.ok); }
    val out: res[str, fail.Fail] = expand_artifact_output(alloc, itn, reg, a, art_root.ok, v);
    if (sel out.err)             { ret out; }
    if (!scope_is_dependency(s)) { ret out; }
    val path: str   = out.ok;
    val n:    usize = str_len(art_root.ok);
    if (str_len(path) > n && str_starts_with(path, art_root.ok) && path[n] == '/') { ret out; }
    val refused: fail.Fail = fail.at(alloc, refuse(alloc, diagnostic_kind.MANIFEST_PATH,
        "mach.toml: artifact '{}' of dependency '{}' writes '{}' outside its build output; a dependency's artifact out begins with {{project.out}}",
        intern.text(itn, a.name), intern.text(itn, s.owner.id), path), a.out_at);
    str_free(alloc, path);
    ret res[str, fail.Fail].err{refused};
}

# reject two artifacts whose `out` expands to the same path under one set of
# template values
# ---
# alloc: owns temporary strings
# itn:   resolves names
# m:     the manifest; fewer than two artifacts always pass
# v:     the template values
# ret:   ok; err "mach.toml: artifacts 'a' and 'b' collide on output path '<p>'",
#        or an expansion error
pub fun check_collisions(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, m: *Manifest,
    v: *template.Values) err[fail.Fail] {
    if (m.artifact_count < 2) { ret err[fail.Fail].ok{}; }
    val target_id: res[intern.StrId, fail.Fail] = id_of(itn, v.target);
    if (sel target_id.err) { ret err[fail.Fail].err{target_id.err}; }

    val res_paths: res[*str, A.Error] = A.allocate[str](alloc, m.artifact_count::usize);
    if (sel res_paths.err) { ret err[fail.Fail].err{fail.refused(res_paths.err)}; }
    val paths: *str = res_paths.ok;
    var i:     u32  = 0;
    for (i < m.artifact_count) {
        paths[i] = nil;
        i        = i + 1;
    }
    fin {
        free_path_strings(alloc, paths, m.artifact_count);
        A.deallocate[str](alloc, paths, m.artifact_count::usize);
    }

    val res_project_out: res[str, fail.Fail] = expand_project_out(alloc, itn, m, v);
    if (sel res_project_out.err) { ret err[fail.Fail].err{res_project_out.err}; }
    val proj_out: str = res_project_out.ok;
    fin { str_free(alloc, proj_out); }

    i = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        i = i + 1;
        if (!artifact_supports_target(itn, a, target_id.ok)) { cnt; }
        val res_art_out: res[str, fail.Fail] = expand_artifact_output(alloc, itn, reg, a, proj_out, v);
        if (sel res_art_out.err) { ret err[fail.Fail].err{res_art_out.err}; }
        paths[i - 1] = res_art_out.ok;
    }

    i = 0;
    for (i < m.artifact_count) {
        var j: u32 = i + 1;
        for (j < m.artifact_count) {
            if (paths[i] != nil && paths[j] != nil && str_equals(paths[i], paths[j])) {
                var claims: Sites = sites_init(alloc);
                sites_add(?claims, m.artifacts[i].out_at);
                sites_add(?claims, m.artifacts[j].out_at);
                ret err[fail.Fail].err{sites_fail(alloc, ?claims, refuse(alloc, diagnostic_kind.OUTPUT_COLLISION,
                    "mach.toml: artifacts '{}' and '{}' collide on output path '{}'", intern.text(itn, m.artifacts[i].name), intern.text(itn, m.artifacts[j].name), paths[i]))};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
fun requirement_has(itn: *intern.Interner, items: *LinkRequirement, count: u32, lit: str) bool {
    var i: u32 = 0;
    for (i < count) {
        if (str_equals(intern.text(itn, items[i].text), lit)) { ret true; }
        i = i + 1;
    }
    ret false;
}

test validate_needs__accepts_artifact_ids_globs_and_step_ids {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = t_fmt(?alloc, "{}{}{}{}{}", need_head(),
        need_artifact(?alloc, "shader-a", "a", ""),
        need_artifact(?alloc, "shader-b", "b", ""),
        "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.shader-a]\nargv=[\"never\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-*\",\"step.gen\",\"artifact.shader-b\"]\n");
    val r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m:   Manifest     = r.ok;
        val app: *ArtifactDef = find_artifact_by_name(?m, t_id(?itn, "app"));
        val sa:  *ArtifactDef = find_artifact_by_name(?m, t_id(?itn, "shader-a"));
        if (app == nil || sa == nil) { code = 1; }
        or {
            if (!artifact_needs_artifact(?itn, app, sa)) { code = 1; }
            if (artifact_needs_artifact(?itn, sa, app))  { code = 1; }
            if (artifact_needs_artifact(?itn, app, app)) { code = 1; }
            var order:   *u32            = nil;
            var count:   u32             = 0;
            var vars:    template.Values = template.values_of(?itn, ?m.targets[0], "debug");
            val planned: err[fail.Fail]  = plan_steps(?alloc, ?itn, ?m, ?app.name, 1,
                ?m.targets[0], "out/host", ?vars, ?order, ?count);
            if (sel planned.err || count != 1)                                 { code = 1; }
            or (!str_equals(intern.text(?itn, m.steps[order[0]].name), "gen")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

#[testing]
fun need_two_target_head() str {
    ret t_profiled("[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.alt]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.alt2]\nisa=\"riscv64\"\nos=\"linux\"\nabi=\"lp64d\"\n", "");
}

test resolve_artifact_reqs__resolves_the_required_output_on_its_own_target {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = t_fmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/shader-a.a\"\ntargets=[\"alt\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-*\"]\n");
    val r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m:     Manifest              = r.ok;
        val app:   *ArtifactDef          = find_artifact(?itn, ?m, "app");
        val host:  *TargetDef            = find_target_by_name(?itn, ?m, "host");
        var items: *template.Requirement = nil;
        var count: u32                   = 0;
        val rr:    err[fail.Fail]        = t_resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (sel rr.err) { code = 1; }
        or {
            if (count != 1) { code = 1; }
            or {
                if (!str_equals(items[0].name, "shader-a"))                    { code = 1; }
                if (!str_equals(items[0].out, "out/alt/debug/lib/shader-a.a")) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

#[testing]
fun dependency_manifest() str {
    ret "[project]\nmach=\">=5\"\nid=\"shlib\"\nversion=\"1\"\nsrc=\"src\"\nout=\"dep-out\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.alt]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[artifact.shlib]\nkind=\"static\"\nexport=true\nentry=\"lib.mach\"\nout=\"{project.out}/lib/shlib.a\"\ntargets=[\"host\"]\nneed=[\"artifact.shader-a\"]\n[artifact.shader-a]\nkind=\"bin\"\nentry=\"s.mach\"\nout=\"{project.out}/spv/shader-a.spv\"\ntargets=[\"alt\"]\nneed=[]\n[artifact.tool]\nkind=\"bin\"\nentry=\"t.mach\"\nout=\"{project.out}/bin/tool\"\ntargets=[\"host\"]\nneed=[\"artifact.support\"]\n[artifact.support]\nkind=\"static\"\nentry=\"u.mach\"\nout=\"lib/support.a\"\ntargets=[\"host\"]\nneed=[]\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n";
}

test resolve_export_reqs__a_dependency_requirement_is_homed_under_its_id_in_the_root_out {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    var code: i32 = 0;

    val root_src: str = t_fmt(?alloc, "{}{}", need_two_target_head(),
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[]\n");
    val root_r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, root_src);
    val dep_r:  res[Manifest, fail.Fail] = tparse(?alloc, ?itn, dependency_manifest());
    if (sel root_r.err) { ret 2; }
    if (sel dep_r.err)  { ret 2; }
    var root:  Manifest = root_r.ok;
    var dep:   Manifest = dep_r.ok;
    var scope: Scope    = dependency_scope(?root, ?dep);

    # only the default library artifact's requirements travel, and each names a
    # path in the root's out tree under the dependency id
    var items: *template.Requirement = nil;
    var count: u32                   = 0;
    val rr:    err[fail.Fail]        = t_export_reqs(?alloc, ?itn, ?scope, "debug", ?items, ?count);
    if (sel rr.err) { code = 1; }
    or {
        if (count != 1) { code = 1; }
        or {
            if (!str_equals(items[0].name, "shader-a"))                                { code = 1; }
            if (!str_equals(items[0].out, "out/alt/debug/dep/shlib/spv/shader-a.spv")) { code = 1; }
        }
    }
    val support: *ArtifactDef = find_artifact(?itn, ?dep, "support");
    if (export_requires(?itn, ?dep, support))                                { code = 1; }
    if (!export_requires(?itn, ?dep, find_artifact(?itn, ?dep, "shader-a"))) { code = 1; }

    # the cell resolves the dependency's target and artifact, the root's profile and
    # out template, and writes where the requirement names
    val unit: res[BuildUnit, fail.Fail] = t_scoped_build_unit(?alloc, ?itn, ?scope, "shader-a", "alt", "debug");
    if (sel unit.err) { code = 1; }
    if (sel unit.ok) {
        val u: BuildUnit = unit.ok;
        if (!str_equals(intern.text(?itn, u.bin_path), "out/alt/debug/dep/shlib/spv/shader-a.spv")) { code = 1; }
        if (!str_equals(intern.text(?itn, u.obj_root), "out/alt/debug/obj"))                        { code = 1; }
        if (!str_equals(intern.text(?itn, u.profile_name), "debug"))                                { code = 1; }
    }

    # a dependency's artifact placed outside its home would write into the consumer's tree
    val support_unit: res[BuildUnit, fail.Fail] = t_scoped_build_unit(?alloc, ?itn, ?scope, "support", "host", "debug");
    if (!(sel support_unit.err && str_contains(fail.describe(support_unit.err), "artifact 'support' of dependency 'shlib' writes 'lib/support.a' outside its build output"))) { code = 3; }

    # the root keeps its own scope: its artifacts are not homed under a dependency
    var rs:  Scope                     = root_scope(?root);
    val own: res[BuildUnit, fail.Fail] = t_scoped_build_unit(?alloc, ?itn, ?rs, "app", "host", "debug");
    if (sel own.err) { code = 1; }
    if (sel own.ok) {
        val o: BuildUnit = own.ok;
        if (!str_equals(intern.text(?itn, o.bin_path), "out/host/debug/bin/app")) { code = 1; }
    }
    ret code;
}

#[testing]
fun t_export_reqs(alloc: *A.Allocator, itn: *intern.Interner, s: *Scope, profile: str,
    out_items: **template.Requirement, out_count: *u32) err[fail.Fail] {
    var reg:   lang_target.TargetRegistry = lang_target.registry_init();
    val ready: err[fail.Fail]             = lang_target.register_all(?reg, ?target_testing.DEBUG);
    if (sel ready.err) { ret err[fail.Fail].err{ready.err}; }
    ret resolve_export_reqs(alloc, itn, ?reg, s, profile, out_items, out_count);
}

#[testing]
fun t_scoped_build_unit(alloc: *A.Allocator, itn: *intern.Interner, s: *Scope,
    artifact: str, target: str, profile: str) res[BuildUnit, fail.Fail] {
    var c:     Cell                       = cell_of(artifact, target, profile);
    var reg:   lang_target.TargetRegistry = lang_target.registry_init();
    val ready: err[fail.Fail]             = lang_target.register_all(?reg, ?target_testing.DEBUG);
    if (sel ready.err) { ret res[BuildUnit, fail.Fail].err{ready.err}; }
    ret resolve_scoped_build_unit(alloc, itn, ?reg, s, ?c);
}

test resolve_artifact_reqs__a_requirement_with_two_targets_has_no_single_output {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = t_fmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/shader-a.a\"\ntargets=[\"alt\",\"alt2\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-a\"]\n");
    val r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m:     Manifest              = r.ok;
        val app:   *ArtifactDef          = find_artifact(?itn, ?m, "app");
        val host:  *TargetDef            = find_target_by_name(?itn, ?m, "host");
        var items: *template.Requirement = nil;
        var count: u32                   = 0;
        val rr:    err[fail.Fail]        = t_resolve_artifact_reqs(?alloc, ?itn, ?m, app, host, "debug", false, ?items, ?count);
        if (sel rr.err) { code = 1; }
        or {
            if (count != 1) { code = 1; }
            or {
                if (!str_empty(items[0].out)) { code = 1; }
                var v:  template.Values     = template.embed_values(items, count, "");
                val er: res[str, fail.Fail] = template.expand(?alloc, "{artifact.shader-a.out}", template.CONTEXT_PATH, "", ?v);
                if (!(sel er.err && str_contains(fail.describe(er.err), "is ambiguous"))) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

# an artifact's own `out` cannot name another artifact's output, even one it
# needs: the manifest is refused when it is read, saying why, at the template
test parse__an_artifact_out_template_cannot_name_another_artifact {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    fin { arena.dnit(?ar); }
    val src: str = t_fmt(?alloc, "{}{}{}", need_two_target_head(),
        "[artifact.shader-a]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"{project.out}/lib/shader-a.a\"\ntargets=[\"alt\"]\nlink=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"{project.out}/bin/{artifact.shader-a.out}\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-a\"]\n");
    val r: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.ok)                                                                                                   { ret 2; }
    if (fail.kind_of(r.err) != diagnostic_kind.TEMPLATE_UNAVAILABLE)                                                { ret 3; }
    if (!str_contains(fail.describe(r.err), "'{artifact.shader-a.out}' is not available in an artifact's own out")) { ret 4; }
    ret 0;
}

# `allow` names warning keys and families from the diagnostic kind table: the
# kinds they cover reach the resolved profile, and an unknown key, a partial
# component, an error key, a repeat and a non-array are each refused
test resolve_build_unit__simd_posture {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"{project.out}/bin/app\"\ntargets=[\"*\"]\nlink = []\nneed = []\n";

    var req: str = t_fmt(?alloc, "{}{}", "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n", art);
    req = t_fmt(?alloc, "{}{}", req, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"require\"\nvectorize=true\nfloat_reassoc=false\n");
    req = t_fmt(?alloc, "{}{}", req, host_target_table(?alloc, "h"));
    val rr: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, req);
    if (sel rr.err) { code = 1; }
    if (sel rr.ok) {
        var m: Manifest                  = rr.ok;
        val u: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "native", "");
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_REQUIRE) { code = 1; }
        }
    }

    var scl: str = t_fmt(?alloc, "{}{}", "[project]\nmach=\">=5\"\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n", art);
    scl = t_fmt(?alloc, "{}{}", scl, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    scl = t_fmt(?alloc, "{}{}", scl, host_target_table(?alloc, "h"));
    val rs: res[Manifest, fail.Fail] = tparse(?alloc, ?itn, scl);
    if (sel rs.err) { code = 1; }
    if (sel rs.ok) {
        var m: Manifest                  = rs.ok;
        val u: res[BuildUnit, fail.Fail] = t_unit(?alloc, ?itn, ?m, "app", "native", "");
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_SCALARIZE) { code = 1; }
        }
    }

    arena.dnit(?ar);
    ret code;
}

