use mach.lang.build.outcome;
use std.data.toml;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.target.abi;
use mach.lang.target.isa;
use mach.lang.target.os;

use mach.lang.manifest.artifact.TmplVars;
use mach.lang.manifest.artifact.expand_project_path;
use mach.lang.manifest.parse;
use mach.lang.manifest.parse.StrArr;
use mach.lang.manifest.parse.TK_LINK;
use mach.lang.manifest.parse.check_keys;
use mach.lang.manifest.parse.check_path;
use mach.lang.manifest.parse.free_strarr;
use mach.lang.manifest.parse.idstr;
use mach.lang.manifest.parse.intern_unwrap;
use mach.lang.manifest.parse.is_valid_id;
use mach.lang.manifest.parse.key_text;
use mach.lang.manifest.parse.parse_str_array;
use mach.lang.manifest.parse.sfmt;
use mach.lang.manifest.project.TargetDef;

pub def LinkSource: u8;
pub val LINK_LOCAL:     LinkSource = 0;
pub val LINK_SYSTEM:    LinkSource = 1;
pub val LINK_FRAMEWORK: LinkSource = 2;

pub rec LinkDef {
    name:               intern.StrId;
    source:             LinkSource;
    library:            intern.StrId;
    lib_name:           intern.StrId;
    path:               intern.StrId;
    symbols:            *intern.StrId;
    symbol_count:       u32;
    os:                 *intern.StrId;
    os_count:           u32;
    os_present:         bool;
    isa:                *intern.StrId;
    isa_count:          u32;
    isa_present:        bool;
    abi:                *intern.StrId;
    abi_count:          u32;
    abi_present:        bool;
    export:             bool;
    include_referenced: bool;
}

pub rec LinkRequirement {
    source:  LinkSource;
    text:    intern.StrId;
    library: intern.StrId;

    symbols:            *intern.StrId;
    symbol_count:       u32;
    include_referenced: bool;
}

pub fun canonical_axis_value(key: str, value: str) bool {
    if (str_equals(value, "*")) { ret true; }
    if (str_equals(key, "os"))  { ret os.os_id_for(value) != os.OS_UNKNOWN; }
    if (str_equals(key, "isa")) { ret isa.arch_id_for(value) != isa.ARCH_UNKNOWN; }
    if (str_equals(key, "abi")) { ret abi.abi_id_for(value) != abi.ABI_UNKNOWN; }
    ret false;
}

pub fun parse_filter_axis(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, key: str, label: str, as_root: bool) res[StrArr, outcome.Fail] {
    var out: StrArr;
    out.items   = nil;
    out.count   = 0;
    out.present = false;
    val v_o: opt[*toml.Value] = toml.get(sub, key);
    if (sel v_o.none) { ret res[StrArr, outcome.Fail].ok{out}; }
    val v: *toml.Value = v_o.some;
    out.present = true;

    if (v.tag == toml.TYPE_STRING) {
        if (str_empty(v.data.string)) {
            ret res[StrArr, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.{} is empty; use a canonical value, \"*\", or [], or omit it", label, key))};
        }
        val res_items: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, 1::usize);
        if (sel res_items.err) { ret res[StrArr, outcome.Fail].err{outcome.refused(res_items.err)}; }
        out.items = res_items.ok;
        val res_elem: res[intern.StrId, A.Error] = intern.intern(itn, v.data.string);
        if (sel res_elem.err) {
            A.deallocate[intern.StrId](alloc, out.items, 1::usize);
            ret res[StrArr, outcome.Fail].err{outcome.refused(res_elem.err)};
        }
        out.items[0] = res_elem.ok;
        out.count    = 1;
    }
    or (v.tag == toml.TYPE_ARRAY) {
        val res_arr: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, ?v.data.array, label, key, true);
        if (sel res_arr.err) { ret res_arr; }
        val arr_v: StrArr = res_arr.ok;
        out.items = arr_v.items;
        out.count = arr_v.count;
    }
    or {
        ret res[StrArr, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.{} must be a string or array of strings", label, key))};
    }

    if (as_root) {
        var vi: u32 = 0;
        for (vi < out.count) {
            val vs: str = idstr(itn, out.items[vi]);
            if (!canonical_axis_value(key, vs)) {
                ret res[StrArr, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.{} has non-canonical value '{}'; use a canonical value or \"*\"", label, key, vs))};
            }
            vi = vi + 1;
        }
    }
    ret res[StrArr, outcome.Fail].ok{out};
}

pub fun parse_links(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, as_root: bool,
    out_links: **LinkDef, out_count: *u32) err[outcome.Fail] {
    @out_links = nil;
    @out_count = 0;
    val tab_o: opt[*toml.Table] = toml.get_table(t, "link");
    if (sel tab_o.none) { ret err[outcome.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[outcome.Fail].ok{}; }

    val res_links: res[*LinkDef, A.Error] = A.allocate[LinkDef](alloc, n);
    if (sel res_links.err) { ret err[outcome.Fail].err{outcome.refused(res_links.err)}; }
    val links: *LinkDef = res_links.ok;
    @out_links = links;
    @out_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *LinkDef = ?links[initialized];
        slot.symbols      = nil;
        slot.symbol_count = 0;
        slot.os           = nil;
        slot.os_count     = 0;
        slot.isa          = nil;
        slot.isa_count    = 0;
        slot.abi          = nil;
        slot.abi_count    = 0;
        initialized       = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str] = toml.table_key(tab, i);
        if (sel name_o.none) { brk; }
        val name: str              = name_o.some;
        val v_o:  opt[*toml.Value] = toml.table_value(tab, i);
        if (sel v_o.none) { brk; }
        val v:     *toml.Value = v_o.some;
        val label: str         = sfmt(alloc, "[link.{}]", name);
        if (!is_valid_id(name)) {
            val name_msg: str = sfmt(alloc, "mach.toml: link name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(name_msg)};
        }
        if (v.tag != toml.TYPE_TABLE) {
            val lbl_msg12: str = sfmt(alloc, "mach.toml: {} must be a table", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg12)};
        }
        val sub: *toml.Table = ?v.data.table;

        val res_keys: err[outcome.Fail] = check_keys(alloc, sub, label, TK_LINK, as_root);
        if (sel res_keys.err) { ret res_keys; }

        val d: *LinkDef = ?links[i];
        d.name = intern_unwrap(itn, name);

        val source_s: str = key_text(sub, "source");
        if (str_empty(source_s)) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} is missing required key 'source'", label))}; }
        if (!str_equals(source_s, "system") && !str_equals(source_s, "framework") && !str_equals(source_s, "local")) {
            val lbl_msg13: str = sfmt(alloc, "mach.toml: {}.source must be \"system\", \"framework\", or \"local\"", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg13)};
        }
        d.source = LINK_LOCAL;
        if (str_equals(source_s, "system"))    { d.source = LINK_SYSTEM; }
        if (str_equals(source_s, "framework")) { d.source = LINK_FRAMEWORK; }
        d.library = d.name;
        val library_v_o: opt[*toml.Value] = toml.get(sub, "library");
        if (sel library_v_o.some) {
            val library_v: *toml.Value = library_v_o.some;
            if (library_v.tag != toml.TYPE_STRING) {
                val lbl_msg14: str = sfmt(alloc, "mach.toml: {}.library must be a non-empty string", label);
                str_free(alloc, label);
                ret err[outcome.Fail].err{outcome.user(lbl_msg14)};
            }
            val library_s: str = library_v.data.string;
            if (str_empty(library_s)) {
                val lbl_msg15: str = sfmt(alloc, "mach.toml: {}.library must be a non-empty string", label);
                str_free(alloc, label);
                ret err[outcome.Fail].err{outcome.user(lbl_msg15)};
            }
            d.library = intern_unwrap(itn, library_s);
        }

        d.symbols      = nil;
        d.symbol_count = 0;
        val symbols_v_o: opt[*toml.Value] = toml.get(sub, "symbols");
        if (sel symbols_v_o.some) {
            val symbols_v: *toml.Value = symbols_v_o.some;
            if (symbols_v.tag != toml.TYPE_ARRAY) {
                val lbl_msg16: str = sfmt(alloc, "mach.toml: {}.symbols must be an array of strings", label);
                str_free(alloc, label);
                ret err[outcome.Fail].err{outcome.user(lbl_msg16)};
            }
            val res_syms: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, ?symbols_v.data.array, label, "symbols", false);
            if (sel res_syms.err) { ret err[outcome.Fail].err{res_syms.err}; }
            val syms: StrArr = res_syms.ok;
            var si:   u32    = 0;
            for (si < syms.count) {
                if (str_empty(idstr(itn, syms.items[si]))) {
                    val lbl_msg17: str = sfmt(alloc, "mach.toml: {}.symbols has an empty symbol name", label);
                    str_free(alloc, label);
                    ret err[outcome.Fail].err{outcome.user(lbl_msg17)};
                }
                var sj: u32 = 0;
                for (sj < si) {
                    if (syms.items[sj] == syms.items[si]) {
                        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.symbols lists '{}' twice",
                            label, idstr(itn, syms.items[si])))};
                    }
                    sj = sj + 1;
                }
                si = si + 1;
            }
            d.symbols      = syms.items;
            d.symbol_count = syms.count;
        }

        val name_val: str = key_text(sub, "name");
        val path_val: str = key_text(sub, "path");

        if (str_equals(source_s, "local")) {
            if (!str_empty(name_val)) {
                val lbl_msg18: str = sfmt(alloc, "mach.toml: {}.name is not allowed for local sources", label);
                str_free(alloc, label);
                ret err[outcome.Fail].err{outcome.user(lbl_msg18)};
            }
            if (str_empty(path_val)) {
                val lbl_msg19: str = sfmt(alloc, "mach.toml: {} is missing required key 'path' for local source", label);
                str_free(alloc, label);
                ret err[outcome.Fail].err{outcome.user(lbl_msg19)};
            }
            val path_field:     str               = sfmt(alloc, "{}.path", label);
            val res_check_path: err[outcome.Fail] = check_path(alloc, path_val, path_field);
            str_free(alloc, path_field);
            if (sel res_check_path.err) { ret res_check_path; }
            d.path     = intern_unwrap(itn, path_val);
            d.lib_name = intern.STR_NIL;
        }
        or {
            if (!str_empty(path_val)) {
                val lbl_msg20: str = sfmt(alloc, "mach.toml: {}.path is not allowed for non-local sources", label);
                str_free(alloc, label);
                ret err[outcome.Fail].err{outcome.user(lbl_msg20)};
            }
            if (str_empty(name_val)) {
                val lbl_msg21: str = sfmt(alloc, "mach.toml: {} is missing required key 'name' for non-local source", label);
                str_free(alloc, label);
                ret err[outcome.Fail].err{outcome.user(lbl_msg21)};
            }
            d.lib_name = intern_unwrap(itn, name_val);
            d.path     = intern.STR_NIL;
        }

        val res_os: res[StrArr, outcome.Fail] = parse_filter_axis(alloc, itn, sub, "os", label, as_root);
        if (sel res_os.err) { ret err[outcome.Fail].err{res_os.err}; }
        val os_v: StrArr = res_os.ok;
        if (!os_v.present && as_root) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} is missing required key 'os' (use \"*\" for any)", label))}; }
        d.os         = os_v.items;
        d.os_count   = os_v.count;
        d.os_present = os_v.present;

        val res_isa: res[StrArr, outcome.Fail] = parse_filter_axis(alloc, itn, sub, "isa", label, as_root);
        if (sel res_isa.err) { ret err[outcome.Fail].err{res_isa.err}; }
        val isa_v: StrArr = res_isa.ok;
        if (!isa_v.present && as_root) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} is missing required key 'isa' (use \"*\" for any)", label))}; }
        d.isa         = isa_v.items;
        d.isa_count   = isa_v.count;
        d.isa_present = isa_v.present;

        val res_abi: res[StrArr, outcome.Fail] = parse_filter_axis(alloc, itn, sub, "abi", label, as_root);
        if (sel res_abi.err) { ret err[outcome.Fail].err{res_abi.err}; }
        val abi_v: StrArr = res_abi.ok;
        if (!abi_v.present && as_root) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} is missing required key 'abi' (use \"*\" for any)", label))}; }
        d.abi         = abi_v.items;
        d.abi_count   = abi_v.count;
        d.abi_present = abi_v.present;

        val export_v_o: opt[*toml.Value] = toml.get(sub, "export");
        if (sel export_v_o.none && as_root) {
            val lbl_msg_export: str = sfmt(alloc, "mach.toml: {} is missing required key 'export'", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg_export)};
        }
        if (sel export_v_o.some) {
            if (export_v_o.some.tag != toml.TYPE_BOOL) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.export must be a boolean", label))}; }
            d.export = export_v_o.some.data.boolean;
        }
        if (sel export_v_o.none) { d.export = false; }

        val include_v_o: opt[*toml.Value] = toml.get(sub, "include");
        if (sel include_v_o.some) {
            val include_v: *toml.Value = include_v_o.some;
            if (include_v.tag != toml.TYPE_STRING) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.include must be \"always\" or \"referenced\"", label))}; }
            val include_s: str = include_v.data.string;
            if (str_equals(include_s, "always"))     { d.include_referenced = false; }
            or (str_equals(include_s, "referenced")) { d.include_referenced = true; }
            or                                       { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.include must be \"always\" or \"referenced\"", label))}; }
        }
        if (sel include_v_o.none) { d.include_referenced = false; }

        str_free(alloc, label);
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun free_link_claims(alloc: *A.Allocator, items: *LinkRequirement, count: u32) {
    if (items == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        free_strarr(alloc, items[i].symbols, items[i].symbol_count);
        items[i].symbols      = nil;
        items[i].symbol_count = 0;
        i                     = i + 1;
    }
}

pub fun finish_link_requirements(alloc: *A.Allocator, items: *LinkRequirement,
    capacity: u32, count: u32,
    out_items: **LinkRequirement,
    out_count: *u32) err[outcome.Fail] {
    @out_items = nil;
    @out_count = 0;
    if (count == 0) {
        A.deallocate[LinkRequirement](alloc, items, capacity::usize);
        ret err[outcome.Fail].ok{};
    }
    if (count < capacity) {
        val sr: res[*LinkRequirement, A.Error] = A.reallocate[LinkRequirement](alloc, items, capacity::usize, count::usize);
        if (sel sr.err) {
            free_link_claims(alloc, items, count);
            A.deallocate[LinkRequirement](alloc, items, capacity::usize);
            ret err[outcome.Fail].err{outcome.refused(sr.err)};
        }
        items = sr.ok;
    }
    @out_items = items;
    @out_count = count;
    ret err[outcome.Fail].ok{};
}

pub fun merge_link_claims(alloc: *A.Allocator, dst: *LinkRequirement,
    src: *LinkRequirement) err[outcome.Fail] {
    var added: u32 = 0;
    var i:     u32 = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j:       u32  = 0;
        for (j < dst.symbol_count) {
            if (dst.symbols[j] == src.symbols[i]) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        j = 0;
        for (!present && j < i) {
            if (src.symbols[j] == src.symbols[i]) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        if (!present) { added = added + 1; }
        i = i + 1;
    }
    if (added == 0) { ret err[outcome.Fail].ok{}; }
    if (dst.symbol_count > 0xFFFFFFFF - added) {
        ret err[outcome.Fail].err{outcome.user("too many merged link symbol claims")};
    }

    val total: u32                         = dst.symbol_count + added;
    val ar:    res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, total::usize);
    if (sel ar.err) {
        ret err[outcome.Fail].err{outcome.refused(ar.err)};
    }
    val merged:  *intern.StrId = ar.ok;
    var written: u32           = 0;
    for (written < dst.symbol_count) {
        merged[written] = dst.symbols[written];
        written         = written + 1;
    }
    i = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j:       u32  = 0;
        for (j < written) {
            if (merged[j] == src.symbols[i]) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        if (!present) {
            merged[written] = src.symbols[i];
            written         = written + 1;
        }
        i = i + 1;
    }

    if (dst.symbols != nil && dst.symbol_count > 0) {
        A.deallocate[intern.StrId](alloc, dst.symbols, dst.symbol_count::usize);
    }
    dst.symbols      = merged;
    dst.symbol_count = total;
    ret err[outcome.Fail].ok{};
}

pub fun filter_matches(itn: *intern.Interner, items: *intern.StrId, count: u32, present: bool, target: intern.StrId) bool {
    if (!present)   { ret true; }
    if (count == 0) { ret false; }
    val star: intern.StrId = intern_unwrap(itn, "*");
    var i:    u32          = 0;
    for (i < count) {
        if (items[i] == star) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        if (items[i] == target) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun link_matches_target(itn: *intern.Interner, l: *LinkDef, t: *TargetDef) bool {
    if (!filter_matches(itn, l.os, l.os_count, l.os_present, t.os))     { ret false; }
    if (!filter_matches(itn, l.isa, l.isa_count, l.isa_present, t.isa)) { ret false; }
    if (!filter_matches(itn, l.abi, l.abi_count, l.abi_present, t.abi)) { ret false; }
    ret true;
}

pub fun link_requirement(alloc: *A.Allocator, itn: *intern.Interner, l: *LinkDef,
    proj_out: str, v: *TmplVars) res[LinkRequirement, outcome.Fail] {
    var req: LinkRequirement;
    req.source             = l.source;
    req.library            = l.library;
    req.include_referenced = l.include_referenced;
    req.symbols            = nil;
    req.symbol_count       = 0;
    if (l.symbol_count > 0) {
        val cr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, l.symbol_count::usize);
        if (sel cr.err) { ret res[LinkRequirement, outcome.Fail].err{outcome.refused(cr.err)}; }
        req.symbols = cr.ok;
        var si: u32 = 0;
        for (si < l.symbol_count) {
            req.symbols[si] = l.symbols[si];
            si              = si + 1;
        }
        req.symbol_count = l.symbol_count;
    }
    if (l.source == LINK_LOCAL) {
        val raw_path:   str                    = idstr(itn, l.path);
        val expanded_r: res[str, outcome.Fail] = expand_project_path(alloc, raw_path, proj_out, v, "a local link path");
        if (sel expanded_r.err) {
            free_strarr(alloc, req.symbols, req.symbol_count);
            ret res[LinkRequirement, outcome.Fail].err{expanded_r.err};
        }
        val expanded: str                        = expanded_r.ok;
        val res_int:  res[intern.StrId, A.Error] = intern.intern(itn, expanded);
        str_free(alloc, expanded);
        if (sel res_int.err) {
            free_strarr(alloc, req.symbols, req.symbol_count);
            ret res[LinkRequirement, outcome.Fail].err{outcome.refused(res_int.err)};
        }
        req.text = res_int.ok;
        ret res[LinkRequirement, outcome.Fail].ok{req};
    }
    req.text = l.lib_name;
    ret res[LinkRequirement, outcome.Fail].ok{req};
}

pub fun find_link_by_name(links: *LinkDef, link_count: u32, name: intern.StrId) *LinkDef {
    var i: u32 = 0;
    for (i < link_count) {
        if (links[i].name == name) { ret ?links[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun find_link(itn: *intern.Interner, links: *LinkDef, link_count: u32, name: str) *LinkDef {
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, name);
    if (sel res_id.err) { ret nil; }
    ret find_link_by_name(links, link_count, res_id.ok);
}

pub fun link_table_names(alloc: *A.Allocator, itn: *intern.Interner, links: *LinkDef, link_count: u32) str {
    var s: str = "";
    var i: u32 = 0;
    for (i < link_count) {
        if (i > 0) { s = sfmt(alloc, "{}, ", s); }
        s = sfmt(alloc, "{}[link.{}]", s, idstr(itn, links[i].name));
        i = i + 1;
    }
    ret s;
}
