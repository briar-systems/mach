use mach.lang.fail;
use mach.lang.growth;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use mach.lang.target.input;
use target_tags: mach.lang.target.tags;

use mach.lang.manifest.model.LINK_FRAMEWORK;
use mach.lang.manifest.model.LINK_LOCAL;
use mach.lang.manifest.model.LINK_SYSTEM;
use mach.lang.manifest.model.LinkDef;
use mach.lang.manifest.model.LinkSource;
use mach.lang.manifest.model.LinkVersions;
use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.TargetDef;
use mach.lang.manifest.model.free_strarr;
use mach.lang.manifest.model.id_of;
use mach.lang.manifest.model.link_def;
use mach.lang.manifest.refusal.point_at;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.sfmt;
use mach.lang.manifest.refusal.span_site;
use mach.lang.manifest.schema.StrArr;
use mach.lang.manifest.schema.check_path;
use mach.lang.manifest.schema.element_span;
use mach.lang.manifest.schema.flag;
use mach.lang.manifest.schema.ids_of;
use mach.lang.manifest.schema.key_text;
use mach.lang.manifest.schema.value_span;
use mach.lang.manifest.schema.written_value;
use mach.lang.manifest.template;

# a `[link.<name>]` entry resolved for one target, as the linker consumes it.
# the symbol array is owned; release it with `free_link_claims`
# ---
# source:             copied from the link
# text:               for a local source, the `path` expanded and interned; otherwise the link's `name`
# key:                the link's table key, its identity
# symbols:            an owned copy of the link's `symbols`, or nil when it has none
# symbol_count:       length of `symbols`
# include_referenced: copied from the link
# kind:               copied from the link
# versions:           copied from the link
pub rec LinkRequirement {
    source: LinkSource;
    text:   intern.StrId;
    key:    intern.StrId;

    symbols:            *intern.StrId;
    symbol_count:       u32;
    include_referenced: bool;
    kind:               input.Kind;
    versions:           LinkVersions;
}

fun canonical_axis_value(key: str, value: str) bool {
    if (str_equals(value, "*"))  { ret true; }
    if (str_equals(key, "sys"))  { ret target_tags.sys_named(value) != target_tags.NONE; }
    if (str_equals(key, "arch")) { ret target_tags.arch_named(value) != target_tags.NONE; }
    if (str_equals(key, "abi"))  { ret target_tags.abi_named(value) != target_tags.NONE; }
    ret false;
}

# a link's `sys`, `arch` or `abi` filter: an array of values, each a canonical
# name or "*"
fun parse_filter_axis(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, key: str, label: str) res[StrArr, fail.Fail] {
    val arr_o: opt[*toml_value.Array] = toml_lookup.get_array(sub, key);
    if (sel arr_o.none) { ret res[StrArr, fail.Fail].err{fail.message("internal: a link passed its schema check without a filter axis")}; }
    val res_arr: res[StrArr, fail.Fail] = ids_of(alloc, itn, arr_o.some, label, key);
    if (sel res_arr.err) { ret res_arr; }
    var out: StrArr = res_arr.ok;
    out.present = true;

    var vi: u32 = 0;
    for (vi < out.count) {
        val vs: str = intern.text(itn, out.items[vi]);
        if (!canonical_axis_value(key, vs)) {
            free_strarr(alloc, out.items, out.count);
            ret res[StrArr, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.{} has non-canonical value '{}'; use a canonical value or \"*\"", label, key, vs), element_span(arr_o.some, vi::usize))};
        }
        vi = vi + 1;
    }
    ret res[StrArr, fail.Fail].ok{out};
}

pub fun parse_links(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml_value.Table] = toml_lookup.get_table(t, "link");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml_value.Table = tab_o.some;
    val n:   usize             = toml_lookup.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val res_links: res[*LinkDef, A.Error] = A.allocate[LinkDef](alloc, n);
    if (sel res_links.err) { ret err[fail.Fail].err{fail.refused(res_links.err)}; }
    m.links      = res_links.ok;
    m.link_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        m.links[initialized] = link_def();
        initialized          = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]               = toml_lookup.table_key(tab, i);
        val v_o:    opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val label: res[str, fail.Fail] = sfmt(alloc, "[link.{}]", name_o.some);
        if (sel label.err) { ret err[fail.Fail].err{label.err}; }
        val r: err[fail.Fail] = link_decode(alloc, itn, name_o.some, label.ok, v_o.some, ?m.links[i]);
        str_free(alloc, label.ok);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun link_decode(alloc: *A.Allocator, itn: *intern.Interner, name: str, label: str, v: *toml_value.Value, d: *LinkDef) err[fail.Fail] {
    val sub:     *toml_value.Table            = ?v.data.table;
    val name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel name_id.err) { ret err[fail.Fail].err{name_id.err}; }
    d.name    = name_id.ok;
    d.at      = span_site(v.key);
    d.path_at = span_site(value_span(sub, "path"));

    val source_s: str = key_text(sub, "source");
    if (!str_equals(source_s, "system") && !str_equals(source_s, "framework") && !str_equals(source_s, "local")) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.source must be \"system\", \"framework\", or \"local\"", label), value_span(sub, "source"))};
    }
    d.source = LINK_LOCAL;
    if (str_equals(source_s, "system"))    { d.source = LINK_SYSTEM; }
    if (str_equals(source_s, "framework")) { d.source = LINK_FRAMEWORK; }

    val symbols_v: *toml_value.Value = written_value(sub, "symbols");
    if (symbols_v != nil) {
        val res_syms: res[StrArr, fail.Fail] = ids_of(alloc, itn, ?symbols_v.data.array, label, "symbols");
        if (sel res_syms.err) { ret err[fail.Fail].err{res_syms.err}; }
        val syms: StrArr = res_syms.ok;
        d.symbols      = syms.items;
        d.symbol_count = syms.count;
        var si: u32 = 0;
        for (si < syms.count) {
            if (str_empty(intern.text(itn, syms.items[si]))) {
                ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.symbols has an empty symbol name", label), element_span(?symbols_v.data.array, si::usize))};
            }
            var sj: u32 = 0;
            for (sj < si) {
                if (intern.str_same(syms.items[sj], syms.items[si])) {
                    ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_DUPLICATE_ENTRY, "mach.toml: {}.symbols lists '{}' twice",
                        label, intern.text(itn, syms.items[si])), element_span(?symbols_v.data.array, si::usize))};
                }
                sj = sj + 1;
            }
            si = si + 1;
        }
    }

    val name_val: str = key_text(sub, "name");
    val path_val: str = key_text(sub, "path");
    if (d.source == LINK_LOCAL) {
        if (!str_empty(name_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.name is not allowed for local sources", label), value_span(sub, "name"))};
        }
        if (str_empty(path_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: {} is missing required key 'path' for local source", label), v.span)};
        }
        val path_field: res[str, fail.Fail] = sfmt(alloc, "{}.path", label);
        if (sel path_field.err) { ret err[fail.Fail].err{path_field.err}; }
        val res_check_path: err[fail.Fail] = check_path(alloc, path_val, path_field.ok, value_span(sub, "path"));
        str_free(alloc, path_field.ok);
        if (sel res_check_path.err) { ret res_check_path; }
        val path_id: res[intern.StrId, fail.Fail] = id_of(itn, path_val);
        if (sel path_id.err) { ret err[fail.Fail].err{path_id.err}; }
        d.path     = path_id.ok;
        d.lib_name = intern.STR_NIL;
    }
    or {
        if (!str_empty(path_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.path is not allowed for non-local sources", label), value_span(sub, "path"))};
        }
        if (str_empty(name_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: {} is missing required key 'name' for non-local source", label), v.span)};
        }
        val lib_id: res[intern.StrId, fail.Fail] = id_of(itn, name_val);
        if (sel lib_id.err) { ret err[fail.Fail].err{lib_id.err}; }
        d.lib_name = lib_id.ok;
        d.path     = intern.STR_NIL;
    }

    val res_os: res[StrArr, fail.Fail] = parse_filter_axis(alloc, itn, sub, "sys", label);
    if (sel res_os.err) { ret err[fail.Fail].err{res_os.err}; }
    d.sys       = res_os.ok.items;
    d.sys_count = res_os.ok.count;

    val res_isa: res[StrArr, fail.Fail] = parse_filter_axis(alloc, itn, sub, "arch", label);
    if (sel res_isa.err) { ret err[fail.Fail].err{res_isa.err}; }
    d.arch       = res_isa.ok.items;
    d.arch_count = res_isa.ok.count;

    val res_abi: res[StrArr, fail.Fail] = parse_filter_axis(alloc, itn, sub, "abi", label);
    if (sel res_abi.err) { ret err[fail.Fail].err{res_abi.err}; }
    d.abi       = res_abi.ok.items;
    d.abi_count = res_abi.ok.count;

    d.export = flag(sub, "export");
    val include_v: *toml_value.Value = written_value(sub, "include");
    if (include_v != nil) {
        val include_s: str = include_v.data.string;
        if (str_equals(include_s, "referenced")) { d.include_referenced = true; }
        or (!str_equals(include_s, "always")) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.include must be \"always\" or \"referenced\"", label), include_v.span)};
        }
    }
    val kinded: err[fail.Fail] = link_decode_kind(alloc, itn, label, sub, d);
    if (sel kinded.err) { ret kinded; }
    ret link_decode_versions(alloc, label, sub, d);
}

# the `current_version` and `compatibility_version` keys, which only a system source of the
# shared kind takes, written together: what a shared library's load command names where its
# image records them
fun link_decode_versions(alloc: *A.Allocator, label: str, sub: *toml_value.Table, d: *LinkDef) err[fail.Fail] {
    val current_v: *toml_value.Value = written_value(sub, "current_version");
    val compat_v:  *toml_value.Value = written_value(sub, "compatibility_version");
    if (current_v == nil && compat_v == nil) { ret err[fail.Fail].ok{}; }
    var first: *toml_value.Value = current_v;
    if (first == nil) { first = compat_v; }
    if (d.source != LINK_SYSTEM || d.kind != input.SHARED) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} states versions, which only a system source of the shared kind takes", label), first.span)};
    }
    if (current_v == nil || compat_v == nil) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: {} states one of current_version and compatibility_version; write both", label), first.span)};
    }
    val current: res[u32, fail.Fail] = version_encoded(alloc, label, "current_version", current_v);
    if (sel current.err) { ret err[fail.Fail].err{current.err}; }
    val compat: res[u32, fail.Fail] = version_encoded(alloc, label, "compatibility_version", compat_v);
    if (sel compat.err) { ret err[fail.Fail].err{compat.err}; }
    d.versions = LinkVersions{stated: true, current: current.ok, compat: compat.ok};
    ret err[fail.Fail].ok{};
}

# a version written `X[.Y[.Z]]` as a load command holds it: X below 65536 in the high 16
# bits, Y and Z below 256 in 8 bits each, a component left out being zero
fun version_encoded(alloc: *A.Allocator, label: str, key: str, v: *toml_value.Value) res[u32, fail.Fail] {
    val text:   str    = v.data.string;
    var parts:  [3]u64 = [3]u64{0, 0, 0};
    var limit:  [3]u64 = [3]u64{0xffff, 0xff, 0xff};
    var at:     usize  = 0;
    var part:   usize  = 0;
    var digits: usize  = 0;
    var bad:    bool   = str_empty(text);
    for (!bad && text[at] != 0) {
        val ch: u8 = text[at];
        at = at + 1;
        if (ch == '.') {
            if (digits == 0 || part == 2) { bad = true; }
            part   = part + 1;
            digits = 0;
            cnt;
        }
        if (ch < '0' || ch > '9') {
            bad = true;
            cnt;
        }
        parts[part] = parts[part] * 10 + (ch - '0')::u64;
        digits      = digits + 1;
        if (parts[part] > limit[part]) { bad = true; }
    }
    if (digits == 0) { bad = true; }
    if (bad) {
        ret res[u32, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.{} must be written X[.Y[.Z]], X below 65536 and Y and Z below 256", label, key), v.span)};
    }
    ret res[u32, fail.Fail].ok{((parts[0] << 16) | (parts[1] << 8) | parts[2])::u32};
}

# the `kind` key, which only a system source naming a library by a bare name
# takes: a file states its own kind, and a framework is its bundle
fun link_decode_kind(alloc: *A.Allocator, itn: *intern.Interner, label: str, sub: *toml_value.Table, d: *LinkDef) err[fail.Fail] {
    val kind_v: *toml_value.Value = written_value(sub, "kind");
    if (kind_v == nil) { ret err[fail.Fail].ok{}; }
    if (d.source != LINK_SYSTEM) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.kind is not allowed for non-system sources", label), kind_v.span)};
    }
    val kind_s: str = kind_v.data.string;
    if (str_equals(kind_s, "static")) { d.kind = input.STATIC; }
    or (!str_equals(kind_s, "shared")) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.kind must be \"shared\" or \"static\"", label), kind_v.span)};
    }
    val lib_name: str = intern.text(itn, d.lib_name);
    if (input.names_file(lib_name::*u8)) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.kind is not allowed with name '{}': it names a file, whose contents state its kind", label, lib_name), kind_v.span)};
    }
    ret err[fail.Fail].ok{};
}

# free the symbol arrays of `count` requirements and nil them. the `items` array
# itself is not freed
# ---
# alloc: the allocator the claims were made from
# items: the requirements; nil is accepted
# count: how many entries to release
pub fun free_link_claims(alloc: *A.Allocator, items: *LinkRequirement, count: u32) {
    if (items == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        free_strarr(alloc, items[i].symbols, items[i].symbol_count);
        items[i].symbols      = nil;
        items[i].symbol_count = 0;
        i                     = i + 1;
    }
}

# turn a partially filled requirement buffer into an exactly sized result, taking
# ownership of the buffer
# ---
# alloc:     the buffer's allocator
# items:     a buffer of `capacity` entries with the first `count` filled
# capacity:  the buffer's allocated extent
# count:     the filled prefix
# out_items: receives the exact array, or nil when `count` is 0 or on error
# out_count: receives `count`, or 0 when it is 0 or on error
# ret:       ok; when `count` is 0 the buffer is freed. on a failed shrink the filled
#            claims and the whole buffer are freed and the allocator's error is returned
pub fun finish_link_requirements(alloc: *A.Allocator, items: *LinkRequirement,
    capacity: u32, count: u32,
    out_items: **LinkRequirement,
    out_count: *u32) err[fail.Fail] {
    @out_items = nil;
    @out_count = 0;
    var kept:   *LinkRequirement = items;
    var cap:    u32              = capacity;
    val fitted: err[A.Error]     = growth.resize[LinkRequirement](alloc, ?kept, ?cap, count::usize);
    if (sel fitted.err) {
        free_link_claims(alloc, items, count);
        A.deallocate[LinkRequirement](alloc, items, capacity::usize);
        ret err[fail.Fail].err{fail.refused(fitted.err)};
    }
    @out_items = kept;
    @out_count = count;
    ret err[fail.Fail].ok{};
}

# add every symbol of `src` that `dst` lacks to `dst`, keeping `dst` order first
# and the new entries in `src` order. `src` is not modified
# ---
# alloc: the allocator of `dst.symbols`; the old array is freed and replaced
# dst:   the requirement that grows
# src:   the requirement whose symbols are added
# ret:   ok, without allocating, when nothing is new; err on a symbol count
#        overflow or allocation failure, leaving `dst` unchanged
pub fun merge_link_claims(alloc: *A.Allocator, dst: *LinkRequirement,
    src: *LinkRequirement) err[fail.Fail] {
    var added: u32 = 0;
    var i:     u32 = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j:       u32  = 0;
        for (j < dst.symbol_count) {
            if (intern.str_same(dst.symbols[j], src.symbols[i])) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        j = 0;
        for (!present && j < i) {
            if (intern.str_same(src.symbols[j], src.symbols[i])) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        if (!present) { added = added + 1; }
        i = i + 1;
    }
    if (added == 0) { ret err[fail.Fail].ok{}; }
    if (dst.symbol_count > 0xFFFFFFFF - added) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "too many merged link symbol claims")};
    }

    val total: u32                         = dst.symbol_count + added;
    val ar:    res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, total::usize);
    if (sel ar.err) {
        ret err[fail.Fail].err{fail.refused(ar.err)};
    }
    val merged:  *intern.StrId = ar.ok;
    var written: u32           = 0;
    for (written < dst.symbol_count) {
        merged[written] = dst.symbols[written];
        written         = written + 1;
    }
    i = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j:       u32  = 0;
        for (j < written) {
            if (intern.str_same(merged[j], src.symbols[i])) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        if (!present) {
            merged[written] = src.symbols[i];
            written         = written + 1;
        }
        i = i + 1;
    }

    if (dst.symbols != nil && dst.symbol_count > 0) {
        A.deallocate[intern.StrId](alloc, dst.symbols, dst.symbol_count::usize);
    }
    dst.symbols      = merged;
    dst.symbol_count = total;
    ret err[fail.Fail].ok{};
}

fun filter_matches(itn: *intern.Interner, items: *intern.StrId, count: u32, target: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (intern.str_same(items[i], target) || str_equals(intern.text(itn, items[i]), "*")) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a link's `sys`, `arch` and `abi` filters all admit a target. an empty
# axis admits nothing, "*" everything
# ---
# itn: resolves the filter values
# l:   the link
# t:   the target
# ret: true when all three axes admit `t`
pub fun link_matches_target(itn: *intern.Interner, l: *LinkDef, t: *TargetDef) bool {
    if (!filter_matches(itn, l.sys, l.sys_count, t.sys))    { ret false; }
    if (!filter_matches(itn, l.arch, l.arch_count, t.arch)) { ret false; }
    if (!filter_matches(itn, l.abi, l.abi_count, t.abi))    { ret false; }
    ret true;
}

# resolve a link entry for one target into a `LinkRequirement`. a local `path`
# is expanded with `expand_project_path` and interned; the symbols are copied
# into an owned array
# ---
# alloc:    owns the symbol copy
# itn:      interns the expanded path
# l:        the link
# proj_out: the expanded `[project].work`
# v:        the template values
# ret:      the requirement; on error nothing is left allocated
pub fun link_requirement(alloc: *A.Allocator, itn: *intern.Interner, l: *LinkDef,
    proj_out: str, v: *template.Values) res[LinkRequirement, fail.Fail] {
    var req: LinkRequirement;
    req.source             = l.source;
    req.key                = l.name;
    req.include_referenced = l.include_referenced;
    req.kind               = l.kind;
    req.versions           = l.versions;
    req.symbols            = nil;
    req.symbol_count       = 0;
    var handed: bool = false;
    fin {
        if (!handed) { free_strarr(alloc, req.symbols, req.symbol_count); }
    }
    if (l.symbol_count > 0) {
        val cr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, l.symbol_count::usize);
        if (sel cr.err) { ret res[LinkRequirement, fail.Fail].err{fail.refused(cr.err)}; }
        req.symbols = cr.ok;
        var si: u32 = 0;
        for (si < l.symbol_count) {
            req.symbols[si] = l.symbols[si];
            si              = si + 1;
        }
        req.symbol_count = l.symbol_count;
    }
    if (l.source == LINK_LOCAL) {
        val expanded_r: res[str, fail.Fail] = expand_local_path(alloc, itn, l, proj_out, v);
        if (sel expanded_r.err) { ret res[LinkRequirement, fail.Fail].err{expanded_r.err}; }
        val expanded: str                          = expanded_r.ok;
        val res_int:  res[intern.StrId, fail.Fail] = id_of(itn, expanded);
        str_free(alloc, expanded);
        if (sel res_int.err) { ret res[LinkRequirement, fail.Fail].err{res_int.err}; }
        req.text = res_int.ok;
        handed   = true;
        ret res[LinkRequirement, fail.Fail].ok{req};
    }
    req.text = l.lib_name;
    handed   = true;
    ret res[LinkRequirement, fail.Fail].ok{req};
}

# expand a local link's `path` with `v`; a refusal points at the `path` value
pub fun expand_local_path(alloc: *A.Allocator, itn: *intern.Interner, l: *LinkDef,
    proj_out: str, v: *template.Values) res[str, fail.Fail] {
    val r: res[str, fail.Fail] = template.path_expand(alloc, intern.text(itn, l.path), template.CONTEXT_PATH, proj_out, v, "a local link path");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.at(r.err, l.path_at)}; }
    ret r;
}

pub fun find_link_by_name(m: *Manifest, name: intern.StrId) *LinkDef {
    var i: u32 = 0;
    for (i < m.link_count) {
        if (intern.str_same(m.links[i].name, name)) { ret ?m.links[i]; }
        i = i + 1;
    }
    ret nil;
}
