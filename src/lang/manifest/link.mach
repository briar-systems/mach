# a `[link.<name>]` entry resolved for one target, as the linker consumes it.
# the symbol array is owned; release it with `free_link_claims`
# ---
# source:             copied from the link
# text:               for a local source, the `path` expanded and interned; otherwise the link's `name`
# library:            the link's logical `library` name
# symbols:            an owned copy of the link's `symbols`, or nil when it has none
# symbol_count:       length of `symbols`
# include_referenced: copied from the link
pub rec LinkRequirement {
    source:  LinkSource;
    text:    intern.StrId;
    library: intern.StrId;

    symbols:            *intern.StrId;
    symbol_count:       u32;
    include_referenced: bool;
}

fun canonical_axis_value(key: str, value: str) bool {
    if (str_equals(value, "*")) { ret true; }
    if (str_equals(key, "os"))  { ret lang_target_os.os_id_for(value) != lang_target_os.OS_UNKNOWN; }
    if (str_equals(key, "isa")) { ret isa.arch_id_for(value) != isa.ARCH_UNKNOWN; }
    if (str_equals(key, "abi")) { ret abi.abi_id_for(value) != abi.ABI_UNKNOWN; }
    ret false;
}

# a link's `os`, `isa` or `abi` filter: one value or a list of them, each a
# canonical name or "*"
fun parse_filter_axis(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, key: str, label: str) res[StrArr, fail.Fail] {
    var out: StrArr;
    out.items   = nil;
    out.count   = 0;
    out.present = true;
    val v: *toml.Value = written_value(sub, key);
    if (v == nil) { ret res[StrArr, fail.Fail].err{fail.message("internal: a link passed its schema check without a filter axis")}; }

    if (v.tag == toml.TYPE_STRING) {
        if (str_empty(v.data.string)) {
            ret res[StrArr, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.{} is empty; use a canonical value, \"*\", or []", label, key), v.span)};
        }
        val res_elem: res[intern.StrId, fail.Fail] = id_of(itn, v.data.string);
        if (sel res_elem.err) { ret res[StrArr, fail.Fail].err{res_elem.err}; }
        val res_items: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, 1::usize);
        if (sel res_items.err) { ret res[StrArr, fail.Fail].err{fail.refused(res_items.err)}; }
        out.items    = res_items.ok;
        out.items[0] = res_elem.ok;
        out.count    = 1;
    }
    or {
        val res_arr: res[StrArr, fail.Fail] = ids_of(alloc, itn, ?v.data.array, label, key);
        if (sel res_arr.err) { ret res_arr; }
        out.items = res_arr.ok.items;
        out.count = res_arr.ok.count;
    }

    var vi: u32 = 0;
    for (vi < out.count) {
        val vs: str = text_of(itn, out.items[vi]);
        if (!canonical_axis_value(key, vs)) {
            free_strarr(alloc, out.items, out.count);
            ret res[StrArr, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.{} has non-canonical value '{}'; use a canonical value or \"*\"", label, key, vs), filter_span(v, vi::usize))};
        }
        vi = vi + 1;
    }
    ret res[StrArr, fail.Fail].ok{out};
}

# where entry `i` of a string-or-array value is written: the element of an
# array, otherwise the value itself
fun filter_span(v: *toml.Value, i: usize) toml.Span {
    if (v.tag == toml.TYPE_ARRAY) { ret element_span(?v.data.array, i); }
    ret v.span;
}

pub fun parse_links(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "link");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val res_links: res[*LinkDef, A.Error] = A.allocate[LinkDef](alloc, n);
    if (sel res_links.err) { ret err[fail.Fail].err{fail.refused(res_links.err)}; }
    m.links      = res_links.ok;
    m.link_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *LinkDef = ?m.links[initialized];
        slot.symbols      = nil;
        slot.symbol_count = 0;
        slot.os           = nil;
        slot.os_count     = 0;
        slot.isa          = nil;
        slot.isa_count    = 0;
        slot.abi          = nil;
        slot.abi_count    = 0;
        initialized       = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val label: res[str, fail.Fail] = sfmt(alloc, "[link.{}]", name_o.some);
        if (sel label.err) { ret err[fail.Fail].err{label.err}; }
        val r: err[fail.Fail] = link_decode(alloc, itn, name_o.some, label.ok, v_o.some, ?m.links[i]);
        str_free(alloc, label.ok);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun link_decode(alloc: *A.Allocator, itn: *intern.Interner, name: str, label: str, v: *toml.Value, d: *LinkDef) err[fail.Fail] {
    val sub:     *toml.Table                  = ?v.data.table;
    val name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel name_id.err) { ret err[fail.Fail].err{name_id.err}; }
    d.name    = name_id.ok;
    d.at      = span_site(v.key);
    d.path_at = span_site(value_span(sub, "path"));

    val source_s: str = key_text(sub, "source");
    if (!str_equals(source_s, "system") && !str_equals(source_s, "framework") && !str_equals(source_s, "local")) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.source must be \"system\", \"framework\", or \"local\"", label), value_span(sub, "source"))};
    }
    d.source = LINK_LOCAL;
    if (str_equals(source_s, "system"))    { d.source = LINK_SYSTEM; }
    if (str_equals(source_s, "framework")) { d.source = LINK_FRAMEWORK; }
    d.library = d.name;
    val library_s: str = key_text(sub, "library");
    if (!str_empty(library_s)) {
        val library_id: res[intern.StrId, fail.Fail] = id_of(itn, library_s);
        if (sel library_id.err) { ret err[fail.Fail].err{library_id.err}; }
        d.library = library_id.ok;
    }

    d.symbols      = nil;
    d.symbol_count = 0;
    val symbols_v: *toml.Value = written_value(sub, "symbols");
    if (symbols_v != nil) {
        val res_syms: res[StrArr, fail.Fail] = ids_of(alloc, itn, ?symbols_v.data.array, label, "symbols");
        if (sel res_syms.err) { ret err[fail.Fail].err{res_syms.err}; }
        val syms: StrArr = res_syms.ok;
        d.symbols      = syms.items;
        d.symbol_count = syms.count;
        var si: u32 = 0;
        for (si < syms.count) {
            if (str_empty(text_of(itn, syms.items[si]))) {
                ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.symbols has an empty symbol name", label), element_span(?symbols_v.data.array, si::usize))};
            }
            var sj: u32 = 0;
            for (sj < si) {
                if (syms.items[sj] == syms.items[si]) {
                    ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_DUPLICATE_ENTRY, "mach.toml: {}.symbols lists '{}' twice",
                        label, text_of(itn, syms.items[si])), element_span(?symbols_v.data.array, si::usize))};
                }
                sj = sj + 1;
            }
            si = si + 1;
        }
    }

    val name_val: str = key_text(sub, "name");
    val path_val: str = key_text(sub, "path");
    if (d.source == LINK_LOCAL) {
        if (!str_empty(name_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.name is not allowed for local sources", label), value_span(sub, "name"))};
        }
        if (str_empty(path_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: {} is missing required key 'path' for local source", label), v.span)};
        }
        val path_field: res[str, fail.Fail] = sfmt(alloc, "{}.path", label);
        if (sel path_field.err) { ret err[fail.Fail].err{path_field.err}; }
        val res_check_path: err[fail.Fail] = check_path(alloc, path_val, path_field.ok, value_span(sub, "path"));
        str_free(alloc, path_field.ok);
        if (sel res_check_path.err) { ret res_check_path; }
        val path_id: res[intern.StrId, fail.Fail] = id_of(itn, path_val);
        if (sel path_id.err) { ret err[fail.Fail].err{path_id.err}; }
        d.path     = path_id.ok;
        d.lib_name = intern.STR_NIL;
    }
    or {
        if (!str_empty(path_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.path is not allowed for non-local sources", label), value_span(sub, "path"))};
        }
        if (str_empty(name_val)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: {} is missing required key 'name' for non-local source", label), v.span)};
        }
        val lib_id: res[intern.StrId, fail.Fail] = id_of(itn, name_val);
        if (sel lib_id.err) { ret err[fail.Fail].err{lib_id.err}; }
        d.lib_name = lib_id.ok;
        d.path     = intern.STR_NIL;
    }

    val res_os: res[StrArr, fail.Fail] = parse_filter_axis(alloc, itn, sub, "os", label);
    if (sel res_os.err) { ret err[fail.Fail].err{res_os.err}; }
    d.os       = res_os.ok.items;
    d.os_count = res_os.ok.count;

    val res_isa: res[StrArr, fail.Fail] = parse_filter_axis(alloc, itn, sub, "isa", label);
    if (sel res_isa.err) { ret err[fail.Fail].err{res_isa.err}; }
    d.isa       = res_isa.ok.items;
    d.isa_count = res_isa.ok.count;

    val res_abi: res[StrArr, fail.Fail] = parse_filter_axis(alloc, itn, sub, "abi", label);
    if (sel res_abi.err) { ret err[fail.Fail].err{res_abi.err}; }
    d.abi       = res_abi.ok.items;
    d.abi_count = res_abi.ok.count;

    d.export             = flag(sub, "export");
    d.include_referenced = false;
    val include_v: *toml.Value = written_value(sub, "include");
    if (include_v != nil) {
        val include_s: str = include_v.data.string;
        if (str_equals(include_s, "referenced")) { d.include_referenced = true; }
        or (!str_equals(include_s, "always")) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.include must be \"always\" or \"referenced\"", label), include_v.span)};
        }
    }
    ret err[fail.Fail].ok{};
}

# free the symbol arrays of `count` requirements and nil them. the `items` array
# itself is not freed
# ---
# alloc: the allocator the claims were made from
# items: the requirements; nil is accepted
# count: how many entries to release
pub fun free_link_claims(alloc: *A.Allocator, items: *LinkRequirement, count: u32) {
    if (items == nil) { ret; }
    var i: u32 = 0;
    for (i < count) {
        free_strarr(alloc, items[i].symbols, items[i].symbol_count);
        items[i].symbols      = nil;
        items[i].symbol_count = 0;
        i                     = i + 1;
    }
}

# turn a partially filled requirement buffer into an exactly sized result, taking
# ownership of the buffer
# ---
# alloc:     the buffer's allocator
# items:     a buffer of `capacity` entries with the first `count` filled
# capacity:  the buffer's allocated extent
# count:     the filled prefix
# out_items: receives the exact array, or nil when `count` is 0 or on error
# out_count: receives `count`, or 0 when it is 0 or on error
# ret:       ok; when `count` is 0 the buffer is freed. on a failed shrink the filled
#            claims and the whole buffer are freed and the allocator's error is returned
pub fun finish_link_requirements(alloc: *A.Allocator, items: *LinkRequirement,
    capacity: u32, count: u32,
    out_items: **LinkRequirement,
    out_count: *u32) err[fail.Fail] {
    @out_items = nil;
    @out_count = 0;
    if (count == 0) {
        A.deallocate[LinkRequirement](alloc, items, capacity::usize);
        ret err[fail.Fail].ok{};
    }
    if (count < capacity) {
        val sr: res[*LinkRequirement, A.Error] = A.reallocate[LinkRequirement](alloc, items, capacity::usize, count::usize);
        if (sel sr.err) {
            free_link_claims(alloc, items, count);
            A.deallocate[LinkRequirement](alloc, items, capacity::usize);
            ret err[fail.Fail].err{fail.refused(sr.err)};
        }
        items = sr.ok;
    }
    @out_items = items;
    @out_count = count;
    ret err[fail.Fail].ok{};
}

# add every symbol of `src` that `dst` lacks to `dst`, keeping `dst` order first
# and the new entries in `src` order. `src` is not modified
# ---
# alloc: the allocator of `dst.symbols`; the old array is freed and replaced
# dst:   the requirement that grows
# src:   the requirement whose symbols are added
# ret:   ok, without allocating, when nothing is new; err on a symbol count
#        overflow or allocation failure, leaving `dst` unchanged
pub fun merge_link_claims(alloc: *A.Allocator, dst: *LinkRequirement,
    src: *LinkRequirement) err[fail.Fail] {
    var added: u32 = 0;
    var i:     u32 = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j:       u32  = 0;
        for (j < dst.symbol_count) {
            if (dst.symbols[j] == src.symbols[i]) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        j = 0;
        for (!present && j < i) {
            if (src.symbols[j] == src.symbols[i]) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        if (!present) { added = added + 1; }
        i = i + 1;
    }
    if (added == 0) { ret err[fail.Fail].ok{}; }
    if (dst.symbol_count > 0xFFFFFFFF - added) {
        ret err[fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "too many merged link symbol claims")};
    }

    val total: u32                         = dst.symbol_count + added;
    val ar:    res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, total::usize);
    if (sel ar.err) {
        ret err[fail.Fail].err{fail.refused(ar.err)};
    }
    val merged:  *intern.StrId = ar.ok;
    var written: u32           = 0;
    for (written < dst.symbol_count) {
        merged[written] = dst.symbols[written];
        written         = written + 1;
    }
    i = 0;
    for (i < src.symbol_count) {
        var present: bool = false;
        var j:       u32  = 0;
        for (j < written) {
            if (merged[j] == src.symbols[i]) {
                present = true;
                brk;
            }
            j = j + 1;
        }
        if (!present) {
            merged[written] = src.symbols[i];
            written         = written + 1;
        }
        i = i + 1;
    }

    if (dst.symbols != nil && dst.symbol_count > 0) {
        A.deallocate[intern.StrId](alloc, dst.symbols, dst.symbol_count::usize);
    }
    dst.symbols      = merged;
    dst.symbol_count = total;
    ret err[fail.Fail].ok{};
}

fun filter_matches(itn: *intern.Interner, items: *intern.StrId, count: u32, target: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (items[i] == target || str_equals(text_of(itn, items[i]), "*")) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a link's `os`, `isa` and `abi` filters all admit a target. an empty
# axis admits nothing, "*" everything
# ---
# itn: resolves the filter values
# l:   the link
# t:   the target
# ret: true when all three axes admit `t`
pub fun link_matches_target(itn: *intern.Interner, l: *LinkDef, t: *TargetDef) bool {
    if (!filter_matches(itn, l.os, l.os_count, t.os))    { ret false; }
    if (!filter_matches(itn, l.isa, l.isa_count, t.isa)) { ret false; }
    if (!filter_matches(itn, l.abi, l.abi_count, t.abi)) { ret false; }
    ret true;
}

# resolve a link entry for one target into a `LinkRequirement`. a local `path`
# is expanded with `expand_project_path` and interned; the symbols are copied
# into an owned array
# ---
# alloc:    owns the symbol copy
# itn:      interns the expanded path
# l:        the link
# proj_out: the expanded `[project].out`
# v:        the template values
# ret:      the requirement; on error nothing is left allocated
pub fun link_requirement(alloc: *A.Allocator, itn: *intern.Interner, l: *LinkDef,
    proj_out: str, v: *template.Values) res[LinkRequirement, fail.Fail] {
    var req: LinkRequirement;
    req.source             = l.source;
    req.library            = l.library;
    req.include_referenced = l.include_referenced;
    req.symbols            = nil;
    req.symbol_count       = 0;
    if (l.symbol_count > 0) {
        val cr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, l.symbol_count::usize);
        if (sel cr.err) { ret res[LinkRequirement, fail.Fail].err{fail.refused(cr.err)}; }
        req.symbols = cr.ok;
        var si: u32 = 0;
        for (si < l.symbol_count) {
            req.symbols[si] = l.symbols[si];
            si              = si + 1;
        }
        req.symbol_count = l.symbol_count;
    }
    if (l.source == LINK_LOCAL) {
        val expanded_r: res[str, fail.Fail] = expand_local_path(alloc, itn, l, proj_out, v);
        if (sel expanded_r.err) {
            free_strarr(alloc, req.symbols, req.symbol_count);
            ret res[LinkRequirement, fail.Fail].err{expanded_r.err};
        }
        val expanded: str                          = expanded_r.ok;
        val res_int:  res[intern.StrId, fail.Fail] = id_of(itn, expanded);
        str_free(alloc, expanded);
        if (sel res_int.err) {
            free_strarr(alloc, req.symbols, req.symbol_count);
            ret res[LinkRequirement, fail.Fail].err{res_int.err};
        }
        req.text = res_int.ok;
        ret res[LinkRequirement, fail.Fail].ok{req};
    }
    req.text = l.lib_name;
    ret res[LinkRequirement, fail.Fail].ok{req};
}

# expand a local link's `path` with `v`; a refusal points at the `path` value
pub fun expand_local_path(alloc: *A.Allocator, itn: *intern.Interner, l: *LinkDef,
    proj_out: str, v: *template.Values) res[str, fail.Fail] {
    val r: res[str, fail.Fail] = template.path_expand(alloc, text_of(itn, l.path), template.CONTEXT_PATH, proj_out, v, "a local link path");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.at(alloc, r.err, l.path_at)}; }
    ret r;
}

pub fun find_link_by_name(m: *Manifest, name: intern.StrId) *LinkDef {
    var i: u32 = 0;
    for (i < m.link_count) {
        if (m.links[i].name == name) { ret ?m.links[i]; }
        i = i + 1;
    }
    ret nil;
}

#[testing]
pub fun find_link(itn: *intern.Interner, m: *Manifest, name: str) *LinkDef {
    var i: u32 = 0;
    for (i < m.link_count) {
        if (str_equals(text_of(itn, m.links[i].name), name)) { ret ?m.links[i]; }
        i = i + 1;
    }
    ret nil;
}

#[testing]
rec LinkFinishAllocProbe {
    backing:       A.Allocator;
    items:         ptr;
    items_size:    usize;
    claims:        ptr;
    claims_size:   usize;
    realloc_count: u32;
    items_freed:   bool;
    claims_freed:  bool;
    mismatch:      bool;
}

#[testing]
fun link_finish_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    ret p.backing.fn_allocate(p.backing.ctx, size, align);
}

#[testing]
fun link_finish_probe_reallocate(ctx: ptr, item: ptr, old_size: usize,
    new_size: usize, align: usize) opt[ptr] {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    p.realloc_count = p.realloc_count + 1;
    if (item != p.items || old_size != p.items_size
        || new_size != $size_of(LinkRequirement)) { p.mismatch = true; }
    ret opt[ptr].none{};
}

#[testing]
fun link_finish_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    if (item == p.items) {
        p.items_freed = true;
        if (size != p.items_size) { p.mismatch = true; }
    }
    if (item == p.claims) {
        p.claims_freed = true;
        if (size != p.claims_size) { p.mismatch = true; }
    }
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

test link_requirement__owns_its_claim_array {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val sleep_r: res[intern.StrId, A.Error] = intern.intern(?itn, "Sleep");
    val k32_r:   res[intern.StrId, A.Error] = intern.intern(?itn, "kernel32");
    if (sel sleep_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel k32_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    val sleep: intern.StrId = sleep_r.ok;

    val owned_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 1::usize);
    if (sel owned_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var l: LinkDef;
    l.source       = LINK_SYSTEM;
    l.name         = k32_r.ok;
    l.library      = k32_r.ok;
    l.lib_name     = k32_r.ok;
    l.path         = intern.STR_NIL;
    l.symbols      = owned_r.ok;
    l.symbol_count = 1;
    l.symbols[0]   = sleep;

    var v:     template.Values;
    val req_r: res[LinkRequirement, fail.Fail] = link_requirement(?alloc, ?itn, ?l, "", ?v);
    if (sel req_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var req: LinkRequirement = req_r.ok;

    if (req.symbols == l.symbols)                         { code = 1; }
    if (req.symbol_count != 1 || req.symbols[0] != sleep) { code = 1; }

    free_strarr(?alloc, l.symbols, l.symbol_count);
    l.symbols[0] = intern.STR_NIL;
    if (req.symbols[0] != sleep) { code = 1; }

    free_link_claims(?alloc, ?req, 1);
    if (req.symbols != nil || req.symbol_count != 0) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test merge_link_claims__stable_owned_union {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a_r: res[intern.StrId, A.Error] = intern.intern(?itn, "A");
    val b_r: res[intern.StrId, A.Error] = intern.intern(?itn, "B");
    val c_r: res[intern.StrId, A.Error] = intern.intern(?itn, "C");
    if (sel a_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel b_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel c_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    val a: intern.StrId = a_r.ok;
    val b: intern.StrId = b_r.ok;
    val c: intern.StrId = c_r.ok;

    val dst_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 2::usize);
    val src_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 3::usize);
    if (sel dst_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel src_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var dst: LinkRequirement;
    dst.symbols      = dst_r.ok;
    dst.symbol_count = 2;
    dst.symbols[0]   = a;
    dst.symbols[1]   = b;
    var src: LinkRequirement;
    src.symbols      = src_r.ok;
    src.symbol_count = 3;
    src.symbols[0]   = b;
    src.symbols[1]   = c;
    src.symbols[2]   = c;
    val src_symbols: *intern.StrId = src.symbols;

    val merged: err[fail.Fail] = merge_link_claims(?alloc, ?dst, ?src);
    if (sel merged.err) { code = 1; }
    if (sel merged.ok) {
        if (dst.symbol_count != 3 || dst.symbols[0] != a
            || dst.symbols[1] != b || dst.symbols[2] != c) { code = 1; }
        if (dst.symbols == src_symbols) { code = 1; }
        if (src.symbols != src_symbols || src.symbol_count != 3
            || src.symbols[0] != b || src.symbols[1] != c
            || src.symbols[2] != c) { code = 1; }

        free_link_claims(?alloc, ?src, 1);
        if (dst.symbol_count != 3 || dst.symbols[0] != a
            || dst.symbols[1] != b || dst.symbols[2] != c) { code = 1; }
    }
    free_link_claims(?alloc, ?dst, 1);

    arena.dnit(?ar);
    ret code;
}

test finish_link_requirements__shrink_failure_frees_full_extent {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    var probe: LinkFinishAllocProbe;
    probe.backing       = backing;
    probe.items         = nil;
    probe.items_size    = 0;
    probe.claims        = nil;
    probe.claims_size   = 0;
    probe.realloc_count = 0;
    probe.items_freed   = false;
    probe.claims_freed  = false;
    probe.mismatch      = false;

    var alloc:     A.Allocator;
    var probe_ptr: *LinkFinishAllocProbe = ?probe;
    alloc.ctx           = probe_ptr::ptr;
    alloc.fn_allocate   = link_finish_probe_allocate;
    alloc.fn_reallocate = link_finish_probe_reallocate;
    alloc.fn_deallocate = link_finish_probe_deallocate;

    val br: res[*LinkRequirement, A.Error] = A.allocate[LinkRequirement](?alloc, 2::usize);
    if (sel br.err) { ret 1; }
    val items: *LinkRequirement = br.ok;
    probe.items      = items::ptr;
    probe.items_size = $size_of(LinkRequirement) * 2;

    val cr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 1::usize);
    if (sel cr.err) {
        A.deallocate[LinkRequirement](?alloc, items, 2::usize);
        ret 1;
    }
    items[0].symbols      = cr.ok;
    items[0].symbol_count = 1;
    items[0].symbols[0]   = intern.STR_NIL;
    probe.claims          = items[0].symbols::ptr;
    probe.claims_size     = $size_of(intern.StrId);

    var out_items: *LinkRequirement = items;
    var out_count: u32              = 0xFFFFFFFF;
    val fr:        err[fail.Fail]   = finish_link_requirements(?alloc, items, 2, 1, ?out_items, ?out_count);

    if (sel fr.ok)                                           { ret 1; }
    if (!str_equals(fail.describe(fr.err), "out of memory")) { ret 1; }
    if (out_items != nil || out_count != 0)                  { ret 1; }
    if (probe.realloc_count != 1 || probe.mismatch)          { ret 1; }
    if (!probe.claims_freed || !probe.items_freed)           { ret 1; }
    ret 0;
}
