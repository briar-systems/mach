test "mach.lang.manifest.resolve_build_unit:native_resolution_zero_target" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid = \"x\"\nversion = \"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[artifact.app]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (m.target_count != 0) { code = 1; }

        val ue: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "app", false, true));
        if (sel ue.err) { code = 1; }

        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            val bu: BuildUnit = u.ok;
            if (bu.warned)                                                                    { code = 1; }
            if (!str_equals(idstr(?itn, bu.target_name), "native"))                           { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.isa), host_isa_name()))                     { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.os), host_os_name()))                       { code = 1; }
            if (!str_equals(idstr(?itn, bu.target.abi), abi.abi_name_for(tgt.host_abi_id()))) { code = 1; }
            if (!str_equals(idstr(?itn, bu.obj_root), "out/native/obj"))                      { code = 1; }
        }

        val uf: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("foreign", "", "app", false, true));
        if (!(sel uf.err && str_contains(outcome.describe(uf.err), "no target named"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:collision_detection" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"bin/app\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.a]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.b]\nkind=\"bin\"\nentry=\"b.mach\"\nout=\"app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest          = res_manifest.ok;
        var v:  TmplVars          = tmpl_vars_of(?itn, ?m.targets[0], "debug");
        val cr: err[outcome.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (!(sel cr.err && str_equals(outcome.describe(cr.err), "mach.toml: artifacts 'a' and 'b' collide on output path 'bin/app/app'"))) { code = 1; }
    }

    val res_clean: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"0.1.0\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app1\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[artifact.tool]\nkind=\"bin\"\nentry=\"tool.mach\"\nout=\"bin/app2\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel res_clean.err) { code = 1; }
    if (sel res_clean.ok) {
        var m:  Manifest          = res_clean.ok;
        var v:  TmplVars          = tmpl_vars_of(?itn, ?m.targets[0], "debug");
        val cr: err[outcome.Fail] = t_check_collisions(?alloc, ?itn, ?m, ?v);
        if (sel cr.err) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:profile_debug_strict" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\nopt = 9\ndebug = false\nvectorize = true\nfloat_reassoc = false\n");
    if (!(sel a.err && str_contains(outcome.describe(a.err), "opt must be 0, 1, or 2"))) { code = 1; }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\nopt = 0\ndebug = 9\nvectorize = true\nfloat_reassoc = false\n");
    if (!(sel b.err && str_contains(outcome.describe(b.err), "debug must be a boolean"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:ambiguous_artifact" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, demo_src());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest                     = res_manifest.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "", false, false));
        if (sel u.ok) { code = 1; }
        if (sel u.err) {
            val msg: str = outcome.describe(u.err);
            if (!str_contains(msg, "bin ls"))  { code = 1; }
            if (!str_contains(msg, "bin cat")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:links" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[link.sys]\nsource=\"system\"\nname=\"c\"\nlibrary=\"c-runtime\"\nos=[\"linux\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.local_lib]\nsource=\"local\"\npath=\"lib/mylib.a\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets = [\"*\"]\nlink = [\"sys\", \"local_lib\"]\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (m.link_count != 2) { code = 1; }

        val ul: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("linux", "", "app", false, true));
        if (sel ul.err) { code = 1; }
        if (sel ul.ok) {
            val bu: BuildUnit = ul.ok;
            if (bu.lib_count != 2)                                                   { code = 1; }
            if (!requirement_has(?itn, bu.libs, bu.lib_count, "c"))                  { code = 1; }
            if (!requirement_has(?itn, bu.libs, bu.lib_count, "lib/mylib.a"))        { code = 1; }
            if (bu.libs[0].source != LINK_SYSTEM || bu.libs[1].source != LINK_LOCAL) { code = 1; }
            if (!str_equals(idstr(?itn, bu.libs[0].library), "c-runtime"))           { code = 1; }
            if (!str_equals(idstr(?itn, bu.libs[1].library), "local_lib"))           { code = 1; }
        }

        val uw: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("windows", "", "app", false, true));
        if (sel uw.err) { code = 1; }
        if (sel uw.ok) {
            val bu: BuildUnit = uw.ok;
            if (bu.lib_count != 1)                                            { code = 1; }
            if (!requirement_has(?itn, bu.libs, bu.lib_count, "lib/mylib.a")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_filter_string_form" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.arm]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[link.os_str]\nsource=\"system\"\nname=\"a\"\nos=\"linux\"\n[link.os_arr]\nsource=\"system\"\nname=\"b\"\nos=[\"linux\"]\n[link.os_star]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\n[link.os_absent]\nsource=\"system\"\nname=\"d\"\n[link.isa_str]\nsource=\"system\"\nname=\"e\"\nisa=\"x86_64\"\n[link.abi_str]\nsource=\"system\"\nname=\"f\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;

        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        val ta: *TargetDef = find_target_by_name(?itn, ?m, "arm");
        if (tl == nil || tw == nil || ta == nil) { code = 1; }
        or {
            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "os_str"), tw))  { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_arr"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "os_arr"), tw))  { code = 1; }

            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_star"), tw))   { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "os_absent"), tw)) { code = 1; }

            if (!link_matches_target(?itn, find_link(?itn, ?m, "isa_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "isa_str"), ta))  { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "abi_str"), tl)) { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "abi_str"), tw))  { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.expand:project_out" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    val r1: res[str, outcome.Fail] = expand(?alloc, "{project.out}/obj/x.o", "out/linux/release", ?v);
    if (!(sel r1.ok && str_equals(r1.ok, "out/linux/release/obj/x.o"))) { code = 1; }

    val r2: res[str, outcome.Fail] = expand(?alloc, "{project.out}/x", "", ?v);
    if (!(sel r2.err && str_contains(outcome.describe(r2.err), "not available in [project].out"))) { code = 1; }

    val r3: res[str, outcome.Fail] = expand(?alloc, "{bogus}", "o", ?v);
    if (!(sel r3.err && str_contains(outcome.describe(r3.err), "unknown template variable"))) { code = 1; }

    val r4: res[str, outcome.Fail] = expand(?alloc, "{target.isa}-{target.os}-{target.abi}", "o", ?v);
    if (!(sel r4.ok && str_equals(r4.ok, "x86_64-linux-sysv64"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.expand_step_value:argv_env_bytes" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    val argv_json: res[str, outcome.Fail] = expand_step_value(?alloc, "{\"x\":1}", "out/linux/release", ?v);
    if (!(sel argv_json.ok && str_equals(argv_json.ok, "{\"x\":1}"))) { code = 1; }

    val argv_adjacent: res[str, outcome.Fail] = expand_step_value(?alloc, "pre{target.name}{\"profile\":\"{profile.name}\"}post", "out/linux/release", ?v);
    if (!(sel argv_adjacent.ok && str_equals(argv_adjacent.ok, "prelinux{\"profile\":\"release\"}post"))) { code = 1; }

    val env_value: res[str, outcome.Fail] = expand_step_value(?alloc, "json={\"x\":1};out={project.out};literal={name};open={;close=}", "out/linux/release", ?v);
    if (!(sel env_value.ok && str_equals(env_value.ok, "json={\"x\":1};out=out/linux/release;literal={name};open={;close=}"))) { code = 1; }

    val target_typo: res[str, outcome.Fail] = expand_step_value(?alloc, "{target.nam}", "out", ?v);
    if (!(sel target_typo.err && str_contains(outcome.describe(target_typo.err), "unknown reserved"))) { code = 1; }
    val profile_unclosed: res[str, outcome.Fail] = expand_step_value(?alloc, "{profile.name", "out", ?v);
    if (!(sel profile_unclosed.err && str_contains(outcome.describe(profile_unclosed.err), "unterminated reserved"))) { code = 1; }
    val project_root: res[str, outcome.Fail] = expand_step_value(?alloc, "{project}", "out", ?v);
    if (!(sel project_root.err && str_contains(outcome.describe(project_root.err), "unknown reserved"))) { code = 1; }
    val target_extra: res[str, outcome.Fail] = expand_step_value(?alloc, "{target.name.extra}", "out", ?v);
    if (!(sel target_extra.err && str_contains(outcome.describe(target_extra.err), "unknown reserved"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.expand_project_path:rejects_unsafe_substitutions" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    v.target = "/tmp";
    val absolute: res[str, outcome.Fail] = expand_project_path(?alloc, "{target.name}/app", "out", ?v, "test path");
    if (!(sel absolute.err && str_contains(outcome.describe(absolute.err), "strict descendant"))) { code = 1; }

    v.target = "../escape";
    val parent: res[str, outcome.Fail] = expand_project_path(?alloc, "out/{target.name}/app", "out", ?v, "test path");
    if (!(sel parent.err && str_contains(outcome.describe(parent.err), "strict descendant"))) { code = 1; }

    v.target = "linux//debug";
    val repeated: res[str, outcome.Fail] = expand_project_path(?alloc, "out/{target.name}/app", "out", ?v, "test path");
    if (!(sel repeated.err && str_contains(outcome.describe(repeated.err), "strict descendant"))) { code = 1; }

    v.target = "linux/./debug";
    val dot: res[str, outcome.Fail] = expand_project_path(?alloc, "out/{target.name}/app", "out", ?v, "test path");
    if (!(sel dot.err && str_contains(outcome.describe(dot.err), "strict descendant"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:local_project_out" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.obj]\nsource=\"local\"\npath=\"{project.out}/obj/shim.o\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets = [\"*\"]\nlink = [\"obj\"]\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest                     = res_manifest.ok;
        val ul: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("linux", "", "app", false, true));
        if (sel ul.err) { code = 1; }
        if (sel ul.ok) {
            val bu: BuildUnit = ul.ok;
            if (bu.lib_count != 1)                                                     { code = 1; }
            if (!requirement_has(?itn, bu.libs, bu.lib_count, "out/linux/obj/shim.o")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.local_path_demanded_by_step" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[step.shim]\nargv=[\"cc\",\"-c\",\"shim.c\"]\nin=[\"shim.c\"]\nout=[\"{project.out}/obj/shim.o\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        var v: TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "debug");
        if (!local_path_demanded_by_step(?alloc, ?itn, ?m, "out/linux/obj/shim.o", "out/linux", ?v)) { code = 1; }
        if (local_path_demanded_by_step(?alloc, ?itn, ?m, "out/linux/obj/nope.o", "out/linux", ?v))  { code = 1; }
        if (step_producing_out(?alloc, ?itn, ?m, "out/linux/obj/shim.o", "out/linux", ?v) != 0)      { code = 1; }
        if (step_producing_out(?alloc, ?itn, ?m, "out/linux/obj/nope.o", "out/linux", ?v) != -1)     { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_steps" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.obj]\nsource=\"local\"\npath=\"{project.out}/o/a.o\"\nos=\"*\"\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=\"windows\"\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"obj\",\"win\"]\nneed=[\"step.gen\"]\n[step.compile]\nargv=[\"cc\"]\nin=[\"a.c\"]\nout=[\"{project.out}/o/a.o\"]\n[step.winc]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n[step.gen]\nargv=[\"g\"]\nin=[\"g.in\"]\nout=[\"{project.out}/g.h\"]\nneed=[\"step.dep*\"]\n[step.dep]\nargv=[\"d\"]\nin=[\"d.in\"]\nout=[\"{project.out}/d.o\"]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val rm:  res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel rm.err) { code = 1; }
    if (sel rm.ok) {
        var m:  Manifest   = rm.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var names: [1]intern.StrId;
            names[0] = intern_unwrap(?itn, "app");
            var order: *u32              = nil;
            var count: u32               = 0;
            var v:     TmplVars          = tmpl_vars_of(?itn, tl, "debug");
            val r:     err[outcome.Fail] = plan_steps(?alloc, ?itn, ?m, ?names[0], 1, tl, "out/linux", ?v, ?order, ?count);
            if (sel r.err) { code = 1; }
            if (sel r.ok) {
                var has_compile: bool = false;
                var has_gen:     bool = false;
                var has_dep:     bool = false;
                var has_winc:    bool = false;
                var gen_pos:     i64  = -1;
                var dep_pos:     i64  = -1;
                var k:           u32  = 0;
                for (k < count) {
                    val nm: str = idstr(?itn, m.steps[order[k]].name);
                    if (str_equals(nm, "compile")) { has_compile = true; }
                    if (str_equals(nm, "gen")) {
                        has_gen = true;
                        gen_pos = k::i64;
                    }
                    if (str_equals(nm, "dep")) {
                        has_dep = true;
                        dep_pos = k::i64;
                    }
                    if (str_equals(nm, "winc")) { has_winc = true; }
                    k = k + 1;
                }
                if (count != 3)                                      { code = 1; }
                if (!has_compile || !has_gen || !has_dep)            { code = 1; }
                if (has_winc)                                        { code = 1; }
                if (dep_pos < 0 || gen_pos < 0 || dep_pos > gen_pos) { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_steps:cycle" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"step.a\"]\n[step.a]\nargv=[\"x\"]\nin=[\"i\"]\nout=[\"{project.out}/a.o\"]\nneed=[\"step.b\"]\n[step.b]\nargv=[\"y\"]\nin=[\"i\"]\nout=[\"{project.out}/b.o\"]\nneed=[\"step.a\"]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    if (!need_err(?alloc, ?itn, src, "build step 'a' is part of a 'need' cycle")) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.plan_export_steps" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/o/m.o\"\nos=\"*\"\nexport=true\n[link.noexp]\nsource=\"local\"\npath=\"{project.out}/o/n.o\"\nos=\"*\"\nexport=false\n[link.win]\nsource=\"local\"\npath=\"{project.out}/o/w.o\"\nos=\"windows\"\nexport=true\n[step.mk]\nargv=[\"cc\"]\nin=[\"m.c\"]\nout=[\"{project.out}/o/m.o\"]\n[step.no]\nargv=[\"cc\"]\nin=[\"n.c\"]\nout=[\"{project.out}/o/n.o\"]\n[step.winmk]\nargv=[\"cc\"]\nin=[\"w.c\"]\nout=[\"{project.out}/o/w.o\"]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val rm:  res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel rm.err) { code = 1; }
    if (sel rm.ok) {
        var m:  Manifest   = rm.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var order: *u32              = nil;
            var count: u32               = 0;
            var v:     TmplVars          = tmpl_vars_of(?itn, tl, "debug");
            val r:     err[outcome.Fail] = plan_export_steps(?alloc, ?itn, ?m, tl, "out/linux", ?v, ?order, ?count);
            if (sel r.err) { code = 1; }
            if (sel r.ok) {
                if (count != 1) { code = 1; }
                or {
                    if (!str_equals(idstr(?itn, m.steps[order[0]].name), "mk")) { code = 1; }
                }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.step_plans:exact_subset_extent_and_allocation_failure" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    val src:      str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.exp]\nsource=\"local\"\npath=\"{project.out}/pick.o\"\nos=\"*\"\nexport=true\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[]\nneed=[\"step.pick\"]\n[step.pick]\nargv=[\"pick\"]\nin=[]\nout=[\"{project.out}/pick.o\"]\nneed=[]\n[step.extra_a]\nargv=[\"a\"]\nin=[]\nout=[\"{project.out}/a.o\"]\nneed=[]\n[step.extra_b]\nargv=[\"b\"]\nin=[]\nout=[\"{project.out}/b.o\"]\nneed=[]\n[step.extra_c]\nargv=[\"c\"]\nin=[]\nout=[\"{project.out}/c.o\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val parsed_r: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel parsed_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var m:      Manifest   = parsed_r.ok;
    val target: *TargetDef = find_target_by_name(?itn, ?m, "linux");
    if (target == nil) {
        arena.dnit(?ar);
        ret 1;
    }
    var v:     TmplVars = tmpl_vars_of(?itn, target, "debug");
    var names: [1]intern.StrId;
    names[0] = intern_unwrap(?itn, "app");
    var bad: bool = false;

    var success_probe: PlanAllocProbe;
    var success_alloc: A.Allocator;
    if (!plan_probe_make(?success_probe, ?success_alloc, 0)) {
        arena.dnit(?ar);
        ret 1;
    }
    var order:   *u32              = nil;
    var count:   u32               = 0;
    val planned: err[outcome.Fail] = plan_steps(?success_alloc, ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
    if (sel planned.err || count != 1 || order == nil)     { bad = true; }
    if (order != nil)                                      { A.deallocate[u32](?success_alloc, order, count::usize); }
    if (success_probe.live != 0 || success_probe.mismatch) { bad = true; }

    var export_probe: PlanAllocProbe;
    var export_alloc: A.Allocator;
    if (!plan_probe_make(?export_probe, ?export_alloc, 0)) {
        arena.dnit(?ar);
        ret 1;
    }
    order = nil;
    count = 0;
    val exported: err[outcome.Fail] = plan_export_steps(?export_alloc, ?itn, ?m, target, "out/linux", ?v, ?order, ?count);
    if (sel exported.err || count != 1 || order == nil)  { bad = true; }
    if (order != nil)                                    { A.deallocate[u32](?export_alloc, order, count::usize); }
    if (export_probe.live != 0 || export_probe.mismatch) { bad = true; }

    var fail_at: u32 = 1;
    for (fail_at <= 3) {
        var fail_probe: PlanAllocProbe;
        var fail_alloc: A.Allocator;
        if (!plan_probe_make(?fail_probe, ?fail_alloc, fail_at)) {
            arena.dnit(?ar);
            ret 1;
        }
        order = nil;
        count = 0;
        val failed: err[outcome.Fail] = plan_steps(?fail_alloc, ?itn, ?m, ?names[0], 1, target, "out/linux", ?v, ?order, ?count);
        if (sel failed.ok || order != nil || count != 0 || fail_probe.live != 0 || fail_probe.mismatch) { bad = true; }
        fail_at = fail_at + 1;
    }
    arena.dnit(?ar);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:id_and_out_validation" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val bad_id: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"a/b\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel bad_id.ok) { code = 1; }
    val ok_id: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"a-b_2\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel ok_id.err) { code = 1; }
    val bad_out: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[step.s]\nargv=[\"cc\"]\nin=[\"a.c\"]\nout=[\"{project.out}/*.o\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (sel bad_out.ok) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:strict_totality" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val bare: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val head: str = sfmt(?alloc, "{}{}", bare, "[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");

    val no_profile: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, bare);
    if (!(sel no_profile.err && str_equals(outcome.describe(no_profile.err), MISSING_PROFILE_MESSAGE))) { code = 1; }
    val empty_profile: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", bare, "[profile]\n"));
    if (!(sel empty_profile.err && str_equals(outcome.describe(empty_profile.err), MISSING_PROFILE_MESSAGE))) { code = 1; }
    val dep_no_profile: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, bare);
    if (!(sel dep_no_profile.ok && dep_no_profile.ok.profile_count == 2)) { code = 1; }

    var form: u32 = 0;
    for (form < 2) {
        var keys: [5]str;
        keys[0] = "opt";
        keys[1] = "debug";
        keys[2] = "simd";
        keys[3] = "vectorize";
        keys[4] = "float_reassoc";
        var partial: [5]str;
        partial[0] = "[profile.p]\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
        partial[1] = "[profile.p]\nopt=0\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
        partial[2] = "[profile.p]\nopt=0\ndebug=false\nvectorize=true\nfloat_reassoc=false\n";
        partial[3] = "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nfloat_reassoc=false\n";
        partial[4] = "[profile.p]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\n";
        var ki: usize = 0;
        for (ki < 5) {
            var r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", bare, partial[ki]));
            if (form == 1) { r = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", bare, partial[ki])); }
            val want: str = sfmt(?alloc, "mach.toml: [profile.p] is missing required key '{}'; a profile declares opt, debug, simd, vectorize and float_reassoc", keys[ki]);
            if (!(sel r.err && str_equals(outcome.describe(r.err), want))) { code = 1; }
            ki = ki + 1;
        }
        form = form + 1;
    }
    val p_simd_bad: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", bare, "[profile.p]\nopt=0\ndebug=false\nsimd=\"bogus\"\nvectorize=true\nfloat_reassoc=false\n"));
    if (!(sel p_simd_bad.err && str_contains(outcome.describe(p_simd_bad.err), "simd must be \"scalarize\" or \"require\""))) { code = 1; }

    val a_link: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[artifact.a]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/a\"\ntargets=[\"*\"]\n"));
    if (!(sel a_link.err && str_contains(outcome.describe(a_link.err), "missing required key 'link'"))) { code = 1; }
    val a_need: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[artifact.a]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/a\"\ntargets=[\"*\"]\nlink=[]\n"));
    if (!(sel a_need.err && str_contains(outcome.describe(a_need.err), "missing required key 'need'"))) { code = 1; }

    val l_os: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\n"));
    if (!(sel l_os.err && str_contains(outcome.describe(l_os.err), "missing required key 'os'"))) { code = 1; }
    val l_isa: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\n"));
    if (!(sel l_isa.err && str_contains(outcome.describe(l_isa.err), "missing required key 'isa'"))) { code = 1; }
    val l_abi: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\nisa=[\"*\"]\n"));
    if (!(sel l_abi.err && str_contains(outcome.describe(l_abi.err), "missing required key 'abi'"))) { code = 1; }
    val l_exp: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\n"));
    if (!(sel l_exp.err && str_contains(outcome.describe(l_exp.err), "missing required key 'export'"))) { code = 1; }

    val s_need: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[step.s]\nargv=[\"c\"]\nin=[\"i\"]\nout=[\"o\"]\n"));
    if (!(sel s_need.err && str_contains(outcome.describe(s_need.err), "missing required key 'need'"))) { code = 1; }
    val d_ref: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[dep.d]\ngit=\"u\"\n"));
    if (!(sel d_ref.err && str_contains(outcome.describe(d_ref.err), "missing required key 'ref' for git source"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:canonical_and_star" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val bad: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[link.l]\nsource=\"system\"\nname=\"c\"\nos=\"windoze\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel bad.err && str_contains(outcome.describe(bad.err), "non-canonical value 'windoze'"))) { code = 1; }

    val ok: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, "[artifact.a]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/a\"\ntargets=[\"*\"]\nlink=[\"c\"]\nneed=[]\n[link.c]\nsource=\"system\"\nname=\"c\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel ok.err) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:root_reject_dep_consume" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val nontotal: str = "[project]\nid=\"std\"\nversion=\"0.18.0\"\nsrc=\"src\"\nout=\"out/{target.name}/{profile.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[artifact.std]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/std\"\ntargets=[\"*\"]\nlink=[\"kernel32\"]\n[link.kernel32]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=[\"windows\"]\nexport=true\n";

    val as_root: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, nontotal);
    if (sel as_root.ok) { code = 1; }

    val as_dep: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, nontotal);
    if (sel as_dep.err) { code = 1; }
    if (sel as_dep.ok) {
        var m:  Manifest   = as_dep.ok;
        val k:  *LinkDef   = find_link(?itn, ?m, "kernel32");
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        if (k == nil || tl == nil || tw == nil) { code = 1; }
        or {
            if (!k.export)                         { code = 1; }
            if (!link_matches_target(?itn, k, tw)) { code = 1; }
            if (link_matches_target(?itn, k, tl))  { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:simd_consumer_overrides_library" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"lib\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.lib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/lib\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n";

    val dep_req:          str                         = sfmt(?alloc, "{}{}", head, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"require\"\nvectorize=true\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"require\"\nvectorize=true\nfloat_reassoc=false\n");
    val tparse_lenient_r: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, dep_req);
    if (sel tparse_lenient_r.err) { code = 1; }

    val dep_bare: str                         = sfmt(?alloc, "{}{}", head, "[profile.debug]\nopt=0\ndebug=false\nvectorize=true\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nvectorize=true\nfloat_reassoc=false\n");
    val bare_dep: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, dep_bare);
    if (!(sel bare_dep.err && str_contains(outcome.describe(bare_dep.err), "is missing required key 'simd'"))) { code = 1; }

    val bare_root: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, dep_bare);
    if (!(sel bare_root.err && str_contains(outcome.describe(bare_root.err), "is missing required key 'simd'"))) { code = 1; }

    val dep_none: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, head);
    if (sel dep_none.err) { code = 1; }
    if (sel dep_none.ok) {
        var m:  Manifest                           = dep_none.ok;
        val rp: res[ResolvedProfile, outcome.Fail] = resolve_profile(?alloc, ?itn, ?m, "");
        if (m.profile_count != 2 || !(sel rp.ok && rp.ok.simd == SIMD_SCALARIZE)) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.expand:closed_set" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    val ext: res[str, outcome.Fail] = expand(?alloc, "bin/app{ext}", "out", ?v);
    if (!(sel ext.err && str_contains(outcome.describe(ext.err), "unknown template variable"))) { code = 1; }
    val nm: res[str, outcome.Fail] = expand(?alloc, "test/{name}", "out", ?v);
    if (!(sel nm.err && str_contains(outcome.describe(nm.err), "unknown template variable"))) { code = 1; }
    val good: res[str, outcome.Fail] = expand(?alloc, "{project.out}/{target.name}/{profile.name}", "o", ?v);
    if (!(sel good.ok && str_equals(good.ok, "o/linux/release"))) { code = 1; }
    val tup: res[str, outcome.Fail] = expand(?alloc, "{target.isa}/{target.os}/{target.abi}", "o", ?v);
    if (!(sel tup.ok && str_equals(tup.ok, "x86_64/linux/sysv64"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_test_libs:union" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[link.a]\nsource=\"system\"\nname=\"liba\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.b]\nsource=\"system\"\nname=\"libb\"\nos=\"linux\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.c]\nsource=\"system\"\nname=\"libdemo\"\nos=\"windows\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.shared]\nsource=\"system\"\nname=\"libshared\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"a\",\"shared\"]\nneed=[]\n[artifact.tool]\nkind=\"bin\"\nentry=\"t.mach\"\nout=\"bin/tool\"\ntargets=[\"*\"]\nlink=[\"b\",\"shared\",\"c\"]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest   = res_manifest.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        if (tl == nil) { code = 1; }
        or {
            var items: *LinkRequirement  = nil;
            var count: u32               = 0;
            var v:     TmplVars          = tmpl_vars_of(?itn, tl, "debug");
            val r:     err[outcome.Fail] = resolve_test_libs(?alloc, ?itn, ?m, tl, "out/linux", ?v, ?items, ?count);
            if (sel r.err) { code = 1; }
            if (sel r.ok) {
                if (count != 3)                                        { code = 1; }
                if (!requirement_has(?itn, items, count, "liba"))      { code = 1; }
                if (!requirement_has(?itn, items, count, "libb"))      { code = 1; }
                if (!requirement_has(?itn, items, count, "libshared")) { code = 1; }
                if (requirement_has(?itn, items, count, "libdemo"))    { code = 1; }
            }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_filter_bad_type" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=1\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: [link.bad].os must be a string or array of strings"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_library_requires_nonempty_string" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val prefix:    str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n[link.bad]\nsource=\"system\"\nname=\"a\"\nlibrary=";
    val empty_src: str                         = sfmt(?alloc, "{}\"\"\n", prefix);
    val typed_src: str                         = sfmt(?alloc, "{}1\n", prefix);
    val empty:     res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, empty_src);
    val typed:     res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, typed_src);
    val want:      str                         = "mach.toml: [link.bad].library must be a non-empty string";
    if (!(sel empty.err && str_equals(outcome.describe(empty.err), want))) { code = 1; }
    if (!(sel typed.err && str_equals(outcome.describe(typed.err), want))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_symbols_claim" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val none: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel none.err) { code = 1; }
    if (sel none.ok) {
        val m: Manifest = none.ok;
        if (m.links[0].symbol_count != 0 || m.links[0].symbols != nil) { code = 1; }
    }

    val two: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"ExitProcess\"]\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel two.err) { code = 1; }
    if (sel two.ok) {
        val m: Manifest = two.ok;
        if (m.links[0].symbol_count != 2) { code = 1; }
        or {
            if (!str_equals(idstr(?itn, m.links[0].symbols[0]), "Sleep"))       { code = 1; }
            if (!str_equals(idstr(?itn, m.links[0].symbols[1]), "ExitProcess")) { code = 1; }
        }
    }

    val scalar: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=\"Sleep\"\n"));
    if (!(sel scalar.err && str_equals(outcome.describe(scalar.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val typed: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",1]\n"));
    if (!(sel typed.err && str_equals(outcome.describe(typed.err), "mach.toml: [link.k].symbols must be an array of strings"))) { code = 1; }

    val blank: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"\"]\n"));
    if (!(sel blank.err && str_equals(outcome.describe(blank.err), "mach.toml: [link.k].symbols has an empty symbol name"))) { code = 1; }

    val dup: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nsymbols=[\"Sleep\",\"Sleep\"]\n"));
    if (!(sel dup.err && str_equals(outcome.describe(dup.err), "mach.toml: [link.k].symbols lists 'Sleep' twice"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_include_values" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val head: str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";

    val default_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel default_r.err) { code = 1; }
    if (sel default_r.ok) {
        val m: Manifest = default_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val always_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"always\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel always_r.err) { code = 1; }
    if (sel always_r.ok) {
        val m: Manifest = always_r.ok;
        if (m.links[0].include_referenced) { code = 1; }
    }

    val referenced_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"referenced\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (sel referenced_r.err) { code = 1; }
    if (sel referenced_r.ok) {
        val m: Manifest = referenced_r.ok;
        if (!m.links[0].include_referenced) { code = 1; }
    }

    val bad_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=\"sometimes\"\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel bad_r.err && str_equals(outcome.describe(bad_r.err), "mach.toml: [link.k].include must be \"always\" or \"referenced\""))) { code = 1; }

    val typed_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"kernel32.dll\"\ninclude=1\nos=\"*\"\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n"));
    if (!(sel typed_r.err && str_equals(outcome.describe(typed_r.err), "mach.toml: [link.k].include must be \"always\" or \"referenced\""))) { code = 1; }

    val dep_r: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}", head,
        "[link.k]\nsource=\"system\"\nname=\"libdemo\"\nlibrary=\"libdemo\"\ninclude=\"referenced\"\nexport=true\n"));
    if (sel dep_r.err) { code = 1; }
    if (sel dep_r.ok) {
        val m: Manifest = dep_r.ok;
        if (!m.links[0].include_referenced || !m.links[0].export) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.link_requirement:carries_include_referenced" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val k32_r: res[intern.StrId, A.Error] = intern.intern(?itn, "kernel32");
    if (sel k32_r.err) {
        arena.dnit(?ar);
        ret 1;
    }

    var l: LinkDef;
    l.source             = LINK_SYSTEM;
    l.name               = k32_r.ok;
    l.library            = k32_r.ok;
    l.lib_name           = k32_r.ok;
    l.path               = intern.STR_NIL;
    l.symbols            = nil;
    l.symbol_count       = 0;
    l.include_referenced = true;

    var v:     TmplVars;
    val req_r: res[LinkRequirement, outcome.Fail] = link_requirement(?alloc, ?itn, ?l, "", ?v);
    if (sel req_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    val req: LinkRequirement = req_r.ok;
    if (!req.include_referenced) { code = 1; }

    l.include_referenced = false;
    val req2_r: res[LinkRequirement, outcome.Fail] = link_requirement(?alloc, ?itn, ?l, "", ?v);
    if (sel req2_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    val req2: LinkRequirement = req2_r.ok;
    if (req2.include_referenced) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.link_requirement:owns_its_claim_array" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val sleep_r: res[intern.StrId, A.Error] = intern.intern(?itn, "Sleep");
    val k32_r:   res[intern.StrId, A.Error] = intern.intern(?itn, "kernel32");
    if (sel sleep_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel k32_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    val sleep: intern.StrId = sleep_r.ok;

    val owned_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 1::usize);
    if (sel owned_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var l: LinkDef;
    l.source       = LINK_SYSTEM;
    l.name         = k32_r.ok;
    l.library      = k32_r.ok;
    l.lib_name     = k32_r.ok;
    l.path         = intern.STR_NIL;
    l.symbols      = owned_r.ok;
    l.symbol_count = 1;
    l.symbols[0]   = sleep;

    var v:     TmplVars;
    val req_r: res[LinkRequirement, outcome.Fail] = link_requirement(?alloc, ?itn, ?l, "", ?v);
    if (sel req_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var req: LinkRequirement = req_r.ok;

    if (req.symbols == l.symbols)                         { code = 1; }
    if (req.symbol_count != 1 || req.symbols[0] != sleep) { code = 1; }

    free_strarr(?alloc, l.symbols, l.symbol_count);
    l.symbols[0] = intern.STR_NIL;
    if (req.symbols[0] != sleep) { code = 1; }

    free_link_claims(?alloc, ?req, 1);
    if (req.symbols != nil || req.symbol_count != 0) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.merge_link_claims:stable_owned_union" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a_r: res[intern.StrId, A.Error] = intern.intern(?itn, "A");
    val b_r: res[intern.StrId, A.Error] = intern.intern(?itn, "B");
    val c_r: res[intern.StrId, A.Error] = intern.intern(?itn, "C");
    if (sel a_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel b_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel c_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    val a: intern.StrId = a_r.ok;
    val b: intern.StrId = b_r.ok;
    val c: intern.StrId = c_r.ok;

    val dst_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 2::usize);
    val src_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 3::usize);
    if (sel dst_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    if (sel src_r.err) {
        arena.dnit(?ar);
        ret 1;
    }
    var dst: LinkRequirement;
    dst.symbols      = dst_r.ok;
    dst.symbol_count = 2;
    dst.symbols[0]   = a;
    dst.symbols[1]   = b;
    var src: LinkRequirement;
    src.symbols      = src_r.ok;
    src.symbol_count = 3;
    src.symbols[0]   = b;
    src.symbols[1]   = c;
    src.symbols[2]   = c;
    val src_symbols: *intern.StrId = src.symbols;

    val merged: err[outcome.Fail] = merge_link_claims(?alloc, ?dst, ?src);
    if (sel merged.err) { code = 1; }
    if (sel merged.ok) {
        if (dst.symbol_count != 3 || dst.symbols[0] != a
            || dst.symbols[1] != b || dst.symbols[2] != c) { code = 1; }
        if (dst.symbols == src_symbols) { code = 1; }
        if (src.symbols != src_symbols || src.symbol_count != 3
            || src.symbols[0] != b || src.symbols[1] != c
            || src.symbols[2] != c) { code = 1; }

        free_link_claims(?alloc, ?src, 1);
        if (dst.symbol_count != 3 || dst.symbols[0] != a
            || dst.symbols[1] != b || dst.symbols[2] != c) { code = 1; }
    }
    free_link_claims(?alloc, ?dst, 1);

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.finish_link_requirements:shrink_failure_frees_full_extent" {
    var backing: A.Allocator;
    val make_r:  err[A.Error] = page.make(?backing);
    if (sel make_r.err) { ret 1; }

    var probe: LinkFinishAllocProbe;
    probe.backing       = backing;
    probe.items         = nil;
    probe.items_size    = 0;
    probe.claims        = nil;
    probe.claims_size   = 0;
    probe.realloc_count = 0;
    probe.items_freed   = false;
    probe.claims_freed  = false;
    probe.mismatch      = false;

    var alloc:     A.Allocator;
    var probe_ptr: *LinkFinishAllocProbe = ?probe;
    alloc.ctx           = probe_ptr::ptr;
    alloc.fn_allocate   = link_finish_probe_allocate;
    alloc.fn_reallocate = link_finish_probe_reallocate;
    alloc.fn_deallocate = link_finish_probe_deallocate;

    val br: res[*LinkRequirement, A.Error] = A.allocate[LinkRequirement](?alloc, 2::usize);
    if (sel br.err) { ret 1; }
    val items: *LinkRequirement = br.ok;
    probe.items      = items::ptr;
    probe.items_size = $size_of(LinkRequirement) * 2;

    val cr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](?alloc, 1::usize);
    if (sel cr.err) {
        A.deallocate[LinkRequirement](?alloc, items, 2::usize);
        ret 1;
    }
    items[0].symbols      = cr.ok;
    items[0].symbol_count = 1;
    items[0].symbols[0]   = intern.STR_NIL;
    probe.claims          = items[0].symbols::ptr;
    probe.claims_size     = $size_of(intern.StrId);

    var out_items: *LinkRequirement  = items;
    var out_count: u32               = 0xFFFFFFFF;
    val fr:        err[outcome.Fail] = finish_link_requirements(?alloc, items, 2, 1, ?out_items, ?out_count);

    if (sel fr.ok)                                              { ret 1; }
    if (!str_equals(outcome.describe(fr.err), "out of memory")) { ret 1; }
    if (out_items != nil || out_count != 0)                     { ret 1; }
    if (probe.realloc_count != 1 || probe.mismatch)             { ret 1; }
    if (!probe.claims_freed || !probe.items_freed)              { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:link_filter_empty_string_error" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[link.bad]\nsource=\"system\"\nname=\"a\"\nos=\"\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: [link.bad].os is empty; use a canonical value, \"*\", or [], or omit it"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:link_filter_empty_array_matches_nothing" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.arm]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[link.none]\nsource=\"system\"\nname=\"a\"\nos=[]\n[link.absent]\nsource=\"system\"\nname=\"b\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest   = res_manifest.ok;
        val tl: *TargetDef = find_target_by_name(?itn, ?m, "linux");
        val tw: *TargetDef = find_target_by_name(?itn, ?m, "windows");
        val ta: *TargetDef = find_target_by_name(?itn, ?m, "arm");
        if (tl == nil || tw == nil || ta == nil) { code = 1; }
        or {
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), tl))    { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), tw))    { code = 1; }
            if (link_matches_target(?itn, find_link(?itn, ?m, "none"), ta))    { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "absent"), tl)) { code = 1; }
            if (!link_matches_target(?itn, find_link(?itn, ?m, "absent"), tw)) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:artifact_target_filter" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src:          str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets = [\"linux\"]\nlink = []\nneed = []\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest                     = res_manifest.ok;
        val ul: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("linux", "", "app", false, true));
        if (sel ul.err) { code = 1; }

        val uw: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("windows", "", "app", false, true));
        if (!(sel uw.err && str_contains(outcome.describe(uw.err), "does not support target"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.select_primary_artifact:first_target_compatible" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n[artifact.app-windows]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app.exe\"\ntargets=[\"windows\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val mr:  res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel mr.err) { code = 1; }
    if (sel mr.ok) {
        var m: Manifest = mr.ok;

        var windows: Selection         = mk_sel("windows", "", "", false, false);
        val wr:      err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?windows);
        if (sel wr.err || !windows.has_artifact
            || !str_equals(windows.artifact, "app-windows")) { code = 1; }
        or {
            val wu: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, windows);
            if (sel wu.err) { code = 1; }
            if (sel wu.ok) {
                val unit: BuildUnit = wu.ok;
                if (!str_equals(idstr(?itn, unit.bin_path), "out/bin/app.exe")) { code = 1; }
            }
        }

        var linux: Selection         = mk_sel("linux", "", "", false, false);
        val lr:    err[outcome.Fail] = select_primary_artifact(?alloc, ?itn, ?m, ?linux);
        if (sel lr.err || !linux.has_artifact
            || !str_equals(linux.artifact, "app")) { code = 1; }

        var runnable: Selection         = mk_sel("windows", "", "", false, false);
        val rr:       err[outcome.Fail] = select_sole_target_artifact(
            ?alloc, ?itn, ?m, ?runnable);
        if (sel rr.err || !runnable.has_artifact
            || !str_equals(runnable.artifact, "app-windows")) { code = 1; }

        var explicit: Selection                    = mk_sel("windows", "", "app", false, true);
        val er:       err[outcome.Fail]            = select_primary_artifact(?alloc, ?itn, ?m, ?explicit);
        val eu:       res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, explicit);
        if (sel er.err || !str_equals(explicit.artifact, "app")
            || sel eu.ok) { code = 1; }
    }

    val ambiguous_src: str = sfmt(?alloc, "{}{}", src,
        "[artifact.tool-windows]\nkind=\"bin\"\nentry=\"tool.mach\"\nout=\"bin/tool.exe\"\ntargets=[\"windows\"]\nlink=[]\nneed=[]\n");
    val amr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, ambiguous_src);
    if (sel amr.err) { code = 1; }
    if (sel amr.ok) {
        var am:        Manifest          = amr.ok;
        var ambiguous: Selection         = mk_sel("windows", "", "", false, false);
        val ar_:       err[outcome.Fail] = select_sole_target_artifact(
            ?alloc, ?itn, ?am, ?ambiguous);
        if (sel ar_.err || ambiguous.has_artifact) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.select_sole_executable_artifact:picks_the_bin_over_a_co_declared_lib" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str                         = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n[artifact.applib]\nkind=\"static\"\nentry=\"lib.mach\"\nout=\"lib/applib.a\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val mr:  res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel mr.err) { ret 1; }
    var m: Manifest = mr.ok;

    var picked: Selection         = mk_sel("linux", "", "", false, false);
    val pr:     err[outcome.Fail] = select_sole_executable_artifact(?alloc, ?itn, ?m, ?picked);
    if (sel pr.err || !picked.has_artifact
        || picked.want_lib || !str_equals(picked.artifact, "app")) { code = 1; }

    var stale: Selection         = mk_sel("linux", "", "", false, false);
    val sr:    err[outcome.Fail] = select_sole_target_artifact(?alloc, ?itn, ?m, ?stale);
    if (sel sr.err || stale.has_artifact) { code = 1; }

    val two_bin_src: str = sfmt(?alloc, "{}{}", src,
        "[artifact.app2]\nkind=\"bin\"\nentry=\"main2.mach\"\nout=\"bin/app2\"\ntargets=[\"linux\"]\nlink=[]\nneed=[]\n");
    val tmr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, two_bin_src);
    if (sel tmr.err) { code = 1; }
    if (sel tmr.ok) {
        var tm:        Manifest          = tmr.ok;
        var ambiguous: Selection         = mk_sel("linux", "", "", false, false);
        val ar_:       err[outcome.Fail] = select_sole_executable_artifact(?alloc, ?itn, ?tm, ?ambiguous);
        if (sel ar_.err || ambiguous.has_artifact) { code = 1; }
    }

    arena.dnit(?ar);
    ret code;
}

fun ut_pin_manifest() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.linux]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[target.windows]\nisa=\"x86_64\"\nos=\"windows\"\nabi=\"win64\"\n[target.linux-arm64]\nisa=\"aarch64\"\nos=\"linux\"\nabi=\"aapcs64\"\n[target.darwin-x86_64]\nisa=\"x86_64\"\nos=\"darwin\"\nabi=\"sysv64\"\n[target.darwin-arm64]\nisa=\"aarch64\"\nos=\"darwin\"\nabi=\"aapcs64\"\n[target.kernel]\nisa=\"x86_64\"\nos=\"freestanding\"\nabi=\"sysv64\"\n[target.kernel-arm]\nisa=\"aarch64\"\nos=\"freestanding\"\nabi=\"aapcs64\"\n[artifact.kernel]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/kernel\"\ntargets=[\"kernel\"]\nlink=[]\nneed=[]\n[artifact.both]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/both\"\ntargets=[\"kernel\",\"kernel-arm\"]\nlink=[]\nneed=[]\n[artifact.tool]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/tool\"\ntargets=[\"*\"]\nlink=[]\nneed=[]\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

test "mach.lang.manifest.resolve_build_unit:sole_target_artifact_pins_it" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, ut_pin_manifest());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;

        val uk: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "kernel", false, true));
        if (sel uk.err) { code = 1; }
        if (sel uk.ok) {
            val u: BuildUnit = uk.ok;
            if (!str_equals(idstr(?itn, u.target_name), "kernel")) { code = 1; }
        }

        val ut: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "tool", false, true));
        if (sel ut.err) { code = 1; }
        if (sel ut.ok) {
            val u: BuildUnit = ut.ok;
            if (str_equals(idstr(?itn, u.target_name), "kernel")) { code = 1; }
        }

        val ux: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("linux", "", "kernel", false, true));
        if (!(sel ux.err && str_contains(outcome.describe(ux.err), "does not support target"))) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.resolve_build_unit:no_hostable_target_lists_the_candidates" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, ut_pin_manifest());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m:  Manifest                     = res_manifest.ok;
        val ub: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("", "", "both", false, true));
        if (sel ub.ok) { code = 1; }
        if (sel ub.err) {
            val e: str = outcome.describe(ub.err);
            if (!str_contains(e, "declares no target for this host")) { code = 1; }
            if (!str_contains(e, "kernel-arm"))                       { code = 1; }
            if (!str_contains(e, "--target"))                         { code = 1; }
        }

        val uk: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("kernel-arm", "", "both", false, true));
        if (sel uk.err) { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.cell_supported:enumerated_axis_is_not_pinned_by_the_artifact" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
