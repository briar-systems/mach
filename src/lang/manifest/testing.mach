fun demo_src() str {
    ret "[project]\nid = \"demo\"\nversion = \"0.1.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\ndefault = true\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\n\n[artifact.ls]\nkind = \"bin\"\nentry = \"bin/ls.mach\"\nout = \"bin/ls\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[artifact.cat]\nkind = \"bin\"\nentry = \"bin/cat.mach\"\nout = \"bin/cat\"\ntargets = [\"*\"]\nlink = []\nneed = []\n\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[dep.std]\ngit = \"https://github.com/briar-systems/mach-std\"\nref = \"tag/v0.4.0\"\n";
}

fun host_target_stanza(alloc: *A.Allocator, name: str) str {
    ret sfmt(alloc, "[target.{}]\nisa = \"{}\"\nos = \"{}\"\nabi = \"{}\"\n", name, host_isa_name(), host_os_name(), abi.abi_name_for(tgt.host_abi_id()));
}

fun requirement_has(itn: *intern.Interner, items: *LinkRequirement, count: u32, lit: str) bool {
    var i: u32 = 0;
    for (i < count) {
        if (str_equals(idstr(itn, items[i].text), lit)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun idstr(itn: *intern.Interner, id: intern.StrId) str {
    val found: opt[str] = intern.lookup(itn, id);
    if (sel found.some) { ret found.some; }
    ret "?";
}

fun source_uses_crlf(source: str) bool {
    var i: usize = 0;
    val n: usize = str_len(source);
    for (i < n) {
        if (source[i] == '\n'::u8) {
            if (i > 0 && source[i - 1] == '\r'::u8) { ret true; }
            ret false;
        }
        i = i + 1;
    }
    ret false;
}

fun if_crlf(source: str) str {
    if (source_uses_crlf(source)) { ret "\r\n"; }
    ret "\n";
}

fun mk_sel(target: str, profile: str, artifact: str, want_lib: bool, has_artifact: bool) Selection {
    var s: Selection;
    s.target       = target;
    s.profile      = profile;
    s.artifact     = artifact;
    s.want_lib     = want_lib;
    s.has_artifact = has_artifact;
    ret s;
}

fun mk_tv(target: str, isa: str, os: str, abi: str, profile: str) TmplVars {
    var v: TmplVars;
    v.target    = target;
    v.isa       = isa;
    v.os        = os;
    v.abi       = abi;
    v.profile   = profile;
    v.reqs      = nil;
    v.req_count = 0;
    ret v;
}

fun tinit(backing: *A.Allocator, ar: *arena.Arena, alloc: *A.Allocator, itn: *intern.Interner) bool {
    val make_r: err[A.Error] = page.make(backing);
    if (sel make_r.err) { ret false; }
    val init_r: err[A.Error] = arena.init(ar, backing, 0);
    if (sel init_r.err) { ret false; }
    val make_r2: err[A.Error] = arena.make(alloc, ar);
    if (sel make_r2.err) { ret false; }
    @itn = intern.init(alloc);
    ret true;
}

rec LinkFinishAllocProbe {
    backing:       A.Allocator;
    items:         ptr;
    items_size:    usize;
    claims:        ptr;
    claims_size:   usize;
    realloc_count: u32;
    items_freed:   bool;
    claims_freed:  bool;
    mismatch:      bool;
}

fun link_finish_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    ret p.backing.fn_allocate(p.backing.ctx, size, align);
}

fun link_finish_probe_reallocate(ctx: ptr, item: ptr, old_size: usize,
    new_size: usize, align: usize) opt[ptr] {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    p.realloc_count = p.realloc_count + 1;
    if (item != p.items || old_size != p.items_size
        || new_size != $size_of(LinkRequirement)) { p.mismatch = true; }
    ret opt[ptr].none{};
}

fun link_finish_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *LinkFinishAllocProbe = ctx::*LinkFinishAllocProbe;
    if (item == p.items) {
        p.items_freed = true;
        if (size != p.items_size) { p.mismatch = true; }
    }
    if (item == p.claims) {
        p.claims_freed = true;
        if (size != p.claims_size) { p.mismatch = true; }
    }
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

rec StepParseLive {
    backing: A.Allocator;
    live:    i64;
}

fun step_parse_live_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: opt[ptr]       = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live = p.live + size::i64;
        memory.raw_fill(r.some, 0xAA, size);
    }
    ret r;
}

fun step_parse_live_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *StepParseLive = ctx::*StepParseLive;
    val r: opt[ptr]       = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun step_parse_live_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *StepParseLive = ctx::*StepParseLive;
    p.live = p.live - size::i64;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun step_parse_live_make(p: *StepParseLive, alloc: *A.Allocator) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live = 0;
    val probe: *StepParseLive = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = step_parse_live_allocate;
    alloc.fn_reallocate = step_parse_live_reallocate;
    alloc.fn_deallocate = step_parse_live_deallocate;
    ret true;
}

rec PlanAllocProbe {
    backing:  A.Allocator;
    live:     i64;
    calls:    u32;
    fail_at:  u32;
    ptrs:     [4]ptr;
    sizes:    [4]usize;
    mismatch: bool;
}

fun plan_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val allocated: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel allocated.none) { ret allocated; }
    val item: ptr   = allocated.some;
    var i:    usize = 0;
    for (i < 4 && p.ptrs[i] != nil) { i = i + 1; }
    if (i == 4) { p.mismatch = true; }
    or {
        p.ptrs[i]  = item;
        p.sizes[i] = size;
    }
    p.live = p.live + size::i64;
    ret allocated;
}

fun plan_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    p.mismatch = true;
    ret opt[ptr].none{};
}

fun plan_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    var i: usize           = 0;
    for (i < 4 && p.ptrs[i] != item) { i = i + 1; }
    if (i == 4) {
        p.mismatch = true;
        ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
    }
    if (p.sizes[i] != size) { p.mismatch = true; }
    p.live     = p.live - p.sizes[i]::i64;
    p.ptrs[i]  = nil;
    p.sizes[i] = 0;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun plan_probe_make(p: *PlanAllocProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live     = 0;
    p.calls    = 0;
    p.fail_at  = fail_at;
    p.mismatch = false;
    var i: usize = 0;
    for (i < 4) {
        p.ptrs[i]  = nil;
        p.sizes[i] = 0;
        i          = i + 1;
    }
    val probe: *PlanAllocProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = plan_probe_allocate;
    alloc.fn_reallocate = plan_probe_reallocate;
    alloc.fn_deallocate = plan_probe_deallocate;
    ret true;
}

fun tparse(alloc: *A.Allocator, itn: *intern.Interner, src: str) res[Manifest, outcome.Fail] {
    val source_r: err[outcome.Fail] = validate_source_text(src);
    if (sel source_r.err) { ret res[Manifest, outcome.Fail].err{source_r.err}; }
    val tbl_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, src);
    if (sel tbl_r.err) { ret res[Manifest, outcome.Fail].err{outcome.user(outcome.toml_text(tbl_r.err))}; }
    var tbl: toml.Table                  = tbl_r.ok;
    val m:   res[Manifest, outcome.Fail] = manifest.parse(alloc, itn, ?tbl, true);
    toml.dnit(alloc, ?tbl);
    ret m;
}

fun tparse_lenient(alloc: *A.Allocator, itn: *intern.Interner, src: str) res[Manifest, outcome.Fail] {
    val source_r: err[outcome.Fail] = validate_source_text(src);
    if (sel source_r.err) { ret res[Manifest, outcome.Fail].err{source_r.err}; }
    val tbl_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, src);
    if (sel tbl_r.err) { ret res[Manifest, outcome.Fail].err{outcome.user(outcome.toml_text(tbl_r.err))}; }
    var tbl: toml.Table                  = tbl_r.ok;
    val m:   res[Manifest, outcome.Fail] = manifest.parse(alloc, itn, ?tbl, false);
    toml.dnit(alloc, ?tbl);
    ret m;
}

test "mach.lang.manifest.is_valid_id" {
    var code: i32 = 0;
    if (!is_valid_id("foo"))    { code = 1; }
    if (!is_valid_id("my_app")) { code = 1; }
    if (!is_valid_id("my-app")) { code = 1; }
    if (!is_valid_id("Proj2"))  { code = 1; }
    if (!is_valid_id("9"))      { code = 1; }
    if (is_valid_id(""))        { code = 1; }
    if (is_valid_id("."))       { code = 1; }
    if (is_valid_id(".."))      { code = 1; }
    if (is_valid_id("foo/bar")) { code = 1; }
    if (is_valid_id("foo.bar")) { code = 1; }
    if (is_valid_id("a b"))     { code = 1; }
    ret code;
}

test "mach.lang.manifest.validate_source_bytes:raw_nul_in_comment" {
    var src: [12]u8;
    src[0]  = '#';
    src[1]  = ' ';
    src[2]  = 'n';
    src[3]  = 'o';
    src[4]  = 't';
    src[5]  = 'e';
    src[6]  = 0;
    src[7]  = '\n';
    src[8]  = 'x';
    src[9]  = '=';
    src[10] = '1';
    src[11] = '\n';
    val r: err[outcome.Fail] = validate_source_bytes(?src[0], 12);
    if (sel r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.validate_source_bytes:multiline_four_quote_terminator" {
    val safe: err[outcome.Fail] = validate_source_text("value = \"\"\"safe\"\"\"\"\nnext = \"text\"\n");
    if (sel safe.err) { ret 1; }
    val nul: err[outcome.Fail] = validate_source_text("value = \"\"\"safe\"\"\"\"\nnext = \"pre\\u0000post\"\n");
    if (sel nul.ok)                                      { ret 1; }
    if (!str_contains(outcome.describe(nul.err), "NUL")) { ret 1; }
    val long_nul: err[outcome.Fail] = validate_source_text("value = '''safe''''\nnext = \"pre\\U00000000post\"\n");
    if (sel long_nul.ok)                                      { ret 1; }
    if (!str_contains(outcome.describe(long_nul.err), "NUL")) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.parse:demo_src_ok" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val res_manifest: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, demo_src());
    if (sel res_manifest.err) { code = 1; }
    if (sel res_manifest.ok) {
        var m: Manifest = res_manifest.ok;
        if (!str_equals(idstr(?itn, m.id), "demo"))                                   { code = 1; }
        if (!str_equals(idstr(?itn, m.version), "0.1.0"))                             { code = 1; }
        if (!str_equals(idstr(?itn, m.src), "src"))                                   { code = 1; }
        if (!str_equals(idstr(?itn, m.out_tmpl), "out/{target.name}/{profile.name}")) { code = 1; }
        if (m.target_count != 2)                                                      { code = 1; }
        if (m.artifact_count != 2)                                                    { code = 1; }
        if (m.profile_count != 2)                                                     { code = 1; }
        if (m.dep_count != 1)                                                         { code = 1; }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:missing_required_keys" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nversion=\"1\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: [project] is missing required key 'id'"))) { code = 1; }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel b.err && str_equals(outcome.describe(b.err), "mach.toml: [project] is missing required key 'version'"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

# [project] name/description/mach and [profile.*] emit_ir/emit_asm are no keys:
# each is refused as unknown in both the strict and the lenient parse
test "mach.lang.manifest.parse:the_five_unread_keys_are_refused_as_unknown_in_both_forms" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:  i32 = 0;
    val head:  str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n";
    val tail:  str = "[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    var texts: [5]str;
    texts[0] = sfmt(?alloc, "{}name=\"App\"\n{}", head, tail);
    texts[1] = sfmt(?alloc, "{}description=\"d\"\n{}", head, tail);
    texts[2] = sfmt(?alloc, "{}mach=\"4.14.0\"\n{}", head, tail);
    texts[3] = sfmt(?alloc, "{}{}emit_ir=true\n", head, tail);
    texts[4] = sfmt(?alloc, "{}{}emit_asm=true\n", head, tail);
    var wants: [5]str;
    wants[0] = "mach.toml: unknown key 'name' in [project]";
    wants[1] = "mach.toml: unknown key 'description' in [project]";
    wants[2] = "mach.toml: unknown key 'mach' in [project]";
    wants[3] = "mach.toml: unknown key 'emit_ir' in [profile.debug]";
    wants[4] = "mach.toml: unknown key 'emit_asm' in [profile.debug]";
    var k: usize = 0;
    for (k < 5) {
        var form: u32 = 0;
        for (form < 2) {
            var r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, texts[k]);
            if (form == 1) { r = tparse_lenient(?alloc, ?itn, texts[k]); }
            if (sel r.ok) {
                var m: Manifest = r.ok;
                dnit(?m, ?alloc);
                code = 2;
            }
            if (sel r.err) {
                if (!str_equals(outcome.describe(r.err), wants[k])) { code = 3; }
            }
            form = form + 1;
        }
        k = k + 1;
    }
    val clean_r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, tail));
    if (sel clean_r.err) { code = 4; }
    if (sel clean_r.ok) {
        var m: Manifest = clean_r.ok;
        dnit(?m, ?alloc);
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:an_artifact_link_naming_no_link_table_is_refused_naming_the_artifact_and_the_tables" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code:     i32 = 0;
    val head:     str = "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
    val links:    str = "[link.m]\nsource=\"system\"\nname=\"m\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n[link.z]\nsource=\"system\"\nname=\"z\"\nos=[\"*\"]\nisa=[\"*\"]\nabi=[\"*\"]\nexport=false\n";
    val bad_art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"nope\"]\nneed=[]\n";
    val good_art: str = "[artifact.app]\nkind=\"bin\"\nentry=\"a.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink=[\"m\", \"z\"]\nneed=[]\n";

    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, bad_art));
    if (sel r.ok) { code = 1; }
    if (sel r.err) {
        val msg: str = outcome.describe(r.err);
        if (!str_equals(msg, "mach.toml: [artifact.app].link names no [link.*] table: 'nope' (declared: [link.m], [link.z])")) { code = 2; }
    }
    val none: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}", head, bad_art));
    if (!(sel none.err && str_contains(outcome.describe(none.err), "no [link.*] table is declared"))) { code = 3; }
    val dep: res[Manifest, outcome.Fail] = tparse_lenient(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, bad_art));
    if (sel dep.ok) { code = 4; }
    val ok: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, sfmt(?alloc, "{}{}{}", head, links, good_art));
    if (sel ok.err) { code = 5; }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.parse:unknown_keys" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val a: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\nbogus=\"y\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel a.err && str_equals(outcome.describe(a.err), "mach.toml: unknown key 'bogus' in [project]"))) { code = 1; }

    val b: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out\"\n[target.l]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\nwat=\"z\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    if (!(sel b.err && str_equals(outcome.describe(b.err), "mach.toml: unknown key 'wat' in [target.l]"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

fun need_head() str {
    ret "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{target.name}\"\n[target.host]\nisa=\"x86_64\"\nos=\"linux\"\nabi=\"sysv64\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n";
}

fun need_artifact(alloc: *A.Allocator, name: str, out: str, need: str) str {
    ret sfmt(alloc, "[artifact.{}]\nkind=\"static\"\nentry=\"s.mach\"\nout=\"lib/{}.a\"\ntargets=[\"host\"]\nlink=[]\nneed=[{}]\n", name, out, need);
}

fun need_err(alloc: *A.Allocator, itn: *intern.Interner, src: str, needle: str) bool {
    val r: res[Manifest, outcome.Fail] = tparse(alloc, itn, src);
    if (sel r.ok) { ret false; }
    ret str_contains(outcome.describe(r.err), needle);
}

test "mach.lang.manifest.glob_matches:wildcards_anchor_at_both_ends" {
    var code: i32 = 0;
    if (!glob_matches("shader-*", "shader-blur")) { code = 1; }
    if (!glob_matches("shader-*", "shader-"))     { code = 1; }
    if (glob_matches("shader-*", "shade"))        { code = 1; }
    if (glob_matches("shader-*", "xshader-blur")) { code = 1; }
    if (!glob_matches("*", "anything"))           { code = 1; }
    if (!glob_matches("*-spv", "blur-spv"))       { code = 1; }
    if (glob_matches("*-spv", "blur-spvx"))       { code = 1; }
    if (!glob_matches("a*b*c", "axxbyyc"))        { code = 1; }
    if (glob_matches("a*b*c", "axxbyy"))          { code = 1; }
    if (!glob_matches("exact", "exact"))          { code = 1; }
    if (glob_matches("exact", "exacts"))          { code = 1; }
    ret code;
}

test "mach.lang.manifest.validate_needs:accepts_artifact_ids_globs_and_step_ids" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val src: str = sfmt(?alloc, "{}{}{}{}{}", need_head(),
        need_artifact(?alloc, "shader-a", "a", ""),
        need_artifact(?alloc, "shader-b", "b", ""),
        "[step.gen]\nargv=[\"true\"]\nin=[]\nout=[]\nneed=[]\n[step.shader-a]\nargv=[\"never\"]\nin=[]\nout=[]\nneed=[]\n",
        "[artifact.app]\nkind=\"bin\"\nentry=\"m.mach\"\nout=\"bin/app\"\ntargets=[\"host\"]\nlink=[]\nneed=[\"artifact.shader-*\",\"step.gen\",\"artifact.shader-b\"]\n");
    val r: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, src);
    if (sel r.err) { code = 1; }
    if (sel r.ok) {
        var m:   Manifest     = r.ok;
        val app: *ArtifactDef = find_artifact_by_name(?m, intern_unwrap(?itn, "app"));
        val sa:  *ArtifactDef = find_artifact_by_name(?m, intern_unwrap(?itn, "shader-a"));
        if (app == nil || sa == nil) { code = 1; }
        or {
            if (!artifact_needs_artifact(?itn, app, sa)) { code = 1; }
            if (artifact_needs_artifact(?itn, sa, app))  { code = 1; }
            if (artifact_needs_artifact(?itn, app, app)) { code = 1; }
            var order:   *u32              = nil;
            var count:   u32               = 0;
            var vars:    TmplVars          = tmpl_vars_of(?itn, ?m.targets[0], "debug");
            val planned: err[outcome.Fail] = plan_steps(?alloc, ?itn, ?m, ?app.name, 1,
                ?m.targets[0], "out/host", ?vars, ?order, ?count);
            if (sel planned.err || count != 1)                           { code = 1; }
            or (!str_equals(idstr(?itn, m.steps[order[0]].name), "gen")) { code = 1; }
        }
    }
    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.validate_needs:rejects_unqualified_names_even_when_they_exist" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
