test "mach.lang.manifest.resolve_build_unit:simd_posture" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;
    val art:  str = "[artifact.app]\nkind=\"bin\"\nentry=\"main.mach\"\nout=\"bin/app\"\ntargets=[\"*\"]\nlink = []\nneed = []\n";

    var req: str = sfmt(?alloc, "{}{}", "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n", art);
    req = sfmt(?alloc, "{}{}", req, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"require\"\nvectorize=true\nfloat_reassoc=false\n");
    req = sfmt(?alloc, "{}{}", req, host_target_stanza(?alloc, "h"));
    val rr: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, req);
    if (sel rr.err) { code = 1; }
    if (sel rr.ok) {
        var m: Manifest                     = rr.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_REQUIRE) { code = 1; }
        }
    }

    var scl: str = sfmt(?alloc, "{}{}", "[project]\nid=\"x\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n", art);
    scl = sfmt(?alloc, "{}{}", scl, "[profile.debug]\nopt=0\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n");
    scl = sfmt(?alloc, "{}{}", scl, host_target_stanza(?alloc, "h"));
    val rs: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, scl);
    if (sel rs.err) { code = 1; }
    if (sel rs.ok) {
        var m: Manifest                     = rs.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_SCALARIZE) { code = 1; }
        }
    }

    var non: str = sfmt(?alloc, "{}{}", "[project]\nid=\"y\"\nversion=\"1\"\nsrc=\"src\"\nout=\"out/{profile.name}\"\n[profile.debug]\ndefault=true\nopt=0\ndebug=true\nsimd=\"scalarize\"\nvectorize=false\nfloat_reassoc=false\n[profile.release]\nopt=2\ndebug=false\nsimd=\"scalarize\"\nvectorize=true\nfloat_reassoc=false\n", art);
    non = sfmt(?alloc, "{}{}", non, host_target_stanza(?alloc, "h"));
    val rn: res[Manifest, outcome.Fail] = tparse(?alloc, ?itn, non);
    if (sel rn.err) { code = 1; }
    if (sel rn.ok) {
        var m: Manifest                     = rn.ok;
        val u: res[BuildUnit, outcome.Fail] = t_resolve_build_unit(?alloc, ?itn, ?m, mk_sel("native", "", "app", false, true));
        if (sel u.err) { code = 1; }
        if (sel u.ok) {
            if (u.ok.simd != SIMD_SCALARIZE) { code = 1; }
        }
    }

    arena.dnit(?ar);
    ret code;
}

