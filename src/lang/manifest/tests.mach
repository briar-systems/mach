# target selection from a manifest, checked through a project build
use A: std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use mach.lang.driver;
use mach.lang.driver.project;
use mach.lang.fail;
use mach.lang.manifest;
use mach.lang.session;
use mach.lang.target.of.bin;
use mach.lang.toolchain;

use mach.lang.driver.tests.testing.ut_scaffold_m;
use mach.lang.driver.tests.testing.ut_str_contains;
use mach.lang.driver.tests.testing.ut_target_sel;

#[testing]
fun t_manifest_notargets() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

test manifest__empty_target_table_synthesizes_native {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, t_manifest_notargets(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    if (sel pr.err) {
        bad = 1;
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}

# two declared targets that no supported host matches
#[testing]
fun t_manifest_foreign_only() str {
    ret "[project]\nmach = \">=5\"\nid = \"foreign\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.bare]\nisa = \"aarch64\"\nos = \"freestanding\"\nabi = \"aapcs64\"\nof = \"elf\"\n\n[target.spare]\nisa = \"riscv64\"\nos = \"freestanding\"\nabi = \"lp64d\"\nof = \"elf\"\n\n[artifact.foreign]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/foreign\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n";
}

# `native` with no declared host target is refused before any step runs, and `-t` still selects it
test native__without_a_host_target_is_refused_naming_the_way_out {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "#[symbol(\"_start\")]\nfun start() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, t_manifest_foreign_only(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad:    i32                             = 0;
    var native: manifest.Selectors              = ut_target_sel("");
    val nr:     res[project.Project, fail.Fail] = driver.build_project(?s, root, ?native);
    if (sel nr.ok) {
        var p: project.Project = nr.ok;
        project.dnit_project(?p);
        bad = 2;
    }
    if (sel nr.err) {
        val text: str = fail.describe(nr.err);
        if (!ut_str_contains(text, "matches no declared target") || !ut_str_contains(text, "bare (freestanding-aarch64)")
            || !ut_str_contains(text, "with -t")) { bad = 3; }
    }

    var named: manifest.Selectors              = ut_target_sel("bare");
    val er:    res[project.Project, fail.Fail] = driver.build_project(?s, root, ?named);
    if (sel er.err) { bad = 4; }
    if (sel er.ok) {
        var p: project.Project = er.ok;
        project.dnit_project(?p);
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    ret bad;
}
