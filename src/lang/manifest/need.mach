# the need graph. every step and artifact is a node, and each `need` entry is
# an edge from its declaration to every other declaration of a category it may
# need whose name the entry selects. one walker follows the edges: it refuses a
# cycle wherever it meets one, and orders what it visits after what each needs,
# for validation and planning alike
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains_char;
use std.types.string.str_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;

use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.site_of;
use mach.lang.manifest.refusal.Sites;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.sfmt;
use mach.lang.manifest.refusal.sites_add;
use mach.lang.manifest.refusal.sites_fail;
use mach.lang.manifest.refusal.sites_init;

# a kind of declaration the graph holds
pub def Category: u8;

# a `[step.<name>]`
pub val CATEGORY_STEP: Category = 0;
# an `[artifact.<name>]`
pub val CATEGORY_ARTIFACT: Category = 1;

val CATEGORY_COUNT: usize = 2;

# what a category is called and what its `need` may select
# ---
# name:  the table it is declared under, which is also the prefix an entry
#        selects it by, as in `step.<name>`
# needs: the categories its `need` may select, one bit per category
rec CategoryRow {
    name:  str;
    needs: u8;
}

# steps need only steps; artifacts need steps and artifacts
val CATEGORIES: [2]CategoryRow = [2]CategoryRow{
    CategoryRow{name: "step", needs: 1},
    CategoryRow{name: "artifact", needs: 3},
};

# one declaration of the graph: entry `index` of its category's tables
pub rec Node {
    category: Category;
    index:    u32;
}

pub fun step_node(index: u32) Node {
    ret Node{category: CATEGORY_STEP, index: index};
}

pub fun artifact_node(index: u32) Node {
    ret Node{category: CATEGORY_ARTIFACT, index: index};
}

fun may_need(from: Category, to: Category) bool {
    ret ((CATEGORIES[from::usize].needs >> to) & 1) != 0;
}

# how many declarations of `c` the manifest holds
fun node_count(m: *Manifest, c: Category) u32 {
    if (c == CATEGORY_STEP) { ret m.step_count; }
    ret m.artifact_count;
}

fun node_name(m: *Manifest, n: Node) intern.StrId {
    if (n.category == CATEGORY_STEP) { ret m.steps[n.index].name; }
    ret m.artifacts[n.index].name;
}

fun need_count(m: *Manifest, n: Node) u32 {
    if (n.category == CATEGORY_STEP) { ret m.steps[n.index].need_count; }
    ret m.artifacts[n.index].need_count;
}

fun need_entry(m: *Manifest, n: Node, i: u32) intern.StrId {
    if (n.category == CATEGORY_STEP) { ret m.steps[n.index].need[i]; }
    ret m.artifacts[n.index].need[i];
}

fun need_site(m: *Manifest, n: Node, i: u32) fail.Place {
    if (n.category == CATEGORY_STEP) { ret site_of(m.steps[n.index].need_at, i); }
    ret site_of(m.artifacts[n.index].need_at, i);
}

fun flat(m: *Manifest, n: Node) usize {
    if (n.category == CATEGORY_STEP) { ret n.index::usize; }
    ret m.step_count::usize + n.index::usize;
}

# whether a pattern holds a wildcard: `*` matches any run of bytes, `?` any one byte
pub fun is_glob(s: str) bool {
    ret str_contains_char(s, '*') || str_contains_char(s, '?');
}

# whether `pat` matches all of `name`, `*` matching any run of bytes and `?` any one
pub fun glob_matches(pat: str, name: str) bool {
    val pn:   usize = str_len(pat);
    val nn:   usize = str_len(name);
    var pi:   usize = 0;
    var ni:   usize = 0;
    var star: usize = pn;
    var mark: usize = 0;
    for (ni < nn) {
        if (pi < pn && pat[pi] == '*') {
            star = pi;
            mark = ni;
            pi   = pi + 1;
            cnt;
        }
        if (pi < pn && (pat[pi] == '?' || pat[pi] == name[ni])) {
            pi = pi + 1;
            ni = ni + 1;
            cnt;
        }
        if (star < pn) {
            mark = mark + 1;
            ni   = mark;
            pi   = star + 1;
            cnt;
        }
        ret false;
    }
    for (pi < pn && pat[pi] == '*') { pi = pi + 1; }
    ret pi == pn;
}

fun pattern_valid(s: str) bool {
    if (str_empty(s)) { ret false; }
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (!((c >= 'A' && c <= 'Z')
            || (c >= 'a' && c <= 'z')
            || (c >= '0' && c <= '9')
            || c == '_' || c == '-' || c == '*')) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the name pattern of `entry` when it selects category `c`, as in `step.gen-*`;
# nil when it names another category or is not a valid pattern
fun pattern_of(entry: str, c: Category) str {
    val prefix: str   = CATEGORIES[c::usize].name;
    val n:      usize = str_len(prefix);
    if (!str_starts_with(entry, prefix) || entry[n] != '.') { ret nil; }
    val pattern: str = ?entry[n + 1];
    if (!pattern_valid(pattern)) { ret nil; }
    ret pattern;
}

# whether the `need` entry `entry` selects the declaration of category `c` named `name`
pub fun selects(itn: *intern.Interner, entry: intern.StrId, c: Category, name: intern.StrId) bool {
    val pattern: str = pattern_of(intern.text(itn, entry), c);
    ret pattern != nil && glob_matches(pattern, intern.text(itn, name));
}

# whether entry `i` of `from`'s `need` selects `to`, another declaration of a
# category `from` may need
fun edge(itn: *intern.Interner, m: *Manifest, from: Node, i: u32, to: Node) bool {
    if (from.category == to.category && from.index == to.index) { ret false; }
    if (!may_need(from.category, to.category))                  { ret false; }
    ret selects(itn, need_entry(m, from, i), to.category, node_name(m, to));
}

# one edge the walk is following: entry `entry` of `from`'s `need`
rec Edge {
    from:  Node;
    entry: u32;
}

# a walk of the need graph of one manifest
# ---
# state: per node, 0 unvisited, 1 open on the walk, 2 done
# trail: the edges from the walk's start to the node it is at
# depth: how many of `trail` are followed
# order: the nodes done, each after every node it needs
pub rec Walk {
    alloc: *A.Allocator;
    itn:   *intern.Interner;
    m:     *Manifest;
    state: *u8;
    trail: *Edge;
    total: usize;
    depth: u32;
    order: Vector[Node];
}

pub fun walk_init(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) res[Walk, fail.Fail] {
    var w: Walk = Walk{alloc: alloc, itn: itn, m: m, state: nil, trail: nil,
        total: m.step_count::usize + m.artifact_count::usize, depth: 0, order: collections_vector.init[Node](alloc)};
    if (w.total == 0) { ret res[Walk, fail.Fail].ok{w}; }
    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, w.total);
    if (sel sr.err) { ret res[Walk, fail.Fail].err{fail.refused(sr.err)}; }
    val tr: res[*Edge, A.Error] = A.allocate[Edge](alloc, w.total);
    if (sel tr.err) {
        A.deallocate[u8](alloc, sr.ok, w.total);
        ret res[Walk, fail.Fail].err{fail.refused(tr.err)};
    }
    w.state = sr.ok;
    w.trail = tr.ok;
    var i: usize = 0;
    for (i < w.total) {
        w.state[i] = 0;
        i          = i + 1;
    }
    ret res[Walk, fail.Fail].ok{w};
}

pub fun walk_dnit(w: *Walk) {
    if (w.total > 0) {
        A.deallocate[u8](w.alloc, w.state, w.total);
        A.deallocate[Edge](w.alloc, w.trail, w.total);
    }
    collections_vector.dnit[Node](?w.order);
    w.state = nil;
    w.trail = nil;
    w.total = 0;
}

# visit `n` and every declaration its `need` reaches, adding each to `order`
# after what it needs; reaching a declaration again while its own visit is open
# is a cycle, refused at the first edge of the cycle with the others related
pub fun visit(w: *Walk, n: Node) err[fail.Fail] {
    val at: usize = flat(w.m, n);
    if (w.state[at] == 2) { ret err[fail.Fail].ok{}; }
    if (w.state[at] == 1) { ret err[fail.Fail].err{cycle(w, n)}; }
    w.state[at] = 1;
    var i: u32 = 0;
    for (i < need_count(w.m, n)) {
        val entered: err[fail.Fail] = entry_visit(w, n, i);
        if (sel entered.err) { ret entered; }
        i = i + 1;
    }
    w.state[at] = 2;
    val pushed: res[usize, A.Error] = collections_vector.push[Node](?w.order, n);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# visit every declaration entry `i` of `from`'s `need` selects
pub fun entry_visit(w: *Walk, from: Node, i: u32) err[fail.Fail] {
    var c: usize = 0;
    for (c < CATEGORY_COUNT) {
        val category: Category = c::Category;
        var j:        u32      = 0;
        for (j < node_count(w.m, category)) {
            val to: Node = Node{category: category, index: j};
            if (edge(w.itn, w.m, from, i, to)) {
                w.trail[w.depth] = Edge{from: from, entry: i};
                w.depth          = w.depth + 1;
                val visited: err[fail.Fail] = visit(w, to);
                w.depth = w.depth - 1;
                if (sel visited.err) { ret visited; }
            }
            j = j + 1;
        }
        c = c + 1;
    }
    ret err[fail.Fail].ok{};
}

# `step.a` or `artifact.b`, as a cycle refusal spells a declaration
fun qualified(w: *Walk, n: Node) res[str, fail.Fail] {
    ret sfmt(w.alloc, "{}.{}", CATEGORIES[n.category::usize].name, intern.text(w.itn, node_name(w.m, n)));
}

# the cycle through `back`, reached again along the trail: the edges from
# `back`'s own on, spelled as the chain they form
fun cycle(w: *Walk, back: Node) fail.Fail {
    var first: u32 = 0;
    for (first < w.depth && flat(w.m, w.trail[first].from) != flat(w.m, back)) { first = first + 1; }
    var chain: str   = "";
    var sites: Sites = sites_init(w.alloc);
    var k:     u32   = first;
    for (k < w.depth) {
        val name: res[str, fail.Fail] = qualified(w, w.trail[k].from);
        if (sel name.err) { ret name.err; }
        val longer: res[str, fail.Fail] = sfmt(w.alloc, "{}{} -> ", chain, name.ok);
        if (sel longer.err) { ret longer.err; }
        chain = longer.ok;
        sites_add(?sites, need_site(w.m, w.trail[k].from, w.trail[k].entry));
        k = k + 1;
    }
    val last: res[str, fail.Fail] = qualified(w, back);
    if (sel last.err) { ret last.err; }
    ret sites_fail(w.alloc, ?sites, refuse(w.alloc, diagnostic_kind.NEED_CYCLE, "mach.toml: 'need' cycle: {}{}", chain, last.ok));
}

# the rules every `need` entry holds to: it selects a category its declaration
# may need, by name or pattern; it selects at least one other declaration; it
# does not name its own declaration exactly; and no chain of entries cycles.
# artifacts are checked before steps, and each refusal points at its entry
pub fun validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var c: usize = CATEGORY_COUNT;
    for (c > 0) {
        c = c - 1;
        val category: Category = c::Category;
        var j:        u32      = 0;
        for (j < node_count(m, category)) {
            val n: Node = Node{category: category, index: j};
            var i: u32  = 0;
            for (i < need_count(m, n)) {
                val checked: err[fail.Fail] = entry_check(alloc, itn, m, n, i);
                if (sel checked.err) { ret checked; }
                i = i + 1;
            }
            j = j + 1;
        }
    }
    val wr: res[Walk, fail.Fail] = walk_init(alloc, itn, m);
    if (sel wr.err) { ret err[fail.Fail].err{wr.err}; }
    var w: Walk = wr.ok;
    fin { walk_dnit(?w); }
    c = CATEGORY_COUNT;
    for (c > 0) {
        c = c - 1;
        var j: u32 = 0;
        for (j < node_count(m, c::Category)) {
            val visited: err[fail.Fail] = visit(?w, Node{category: c::Category, index: j});
            if (sel visited.err) { ret visited; }
            j = j + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun entry_check(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, n: Node, i: u32) err[fail.Fail] {
    val owner: str        = CATEGORIES[n.category::usize].name;
    val name:  str        = intern.text(itn, node_name(m, n));
    val entry: str        = intern.text(itn, need_entry(m, n, i));
    val at:    fail.Place = need_site(m, n, i);
    var hits:  u32        = 0;
    var typed: bool       = false;
    var c:     usize      = 0;
    for (c < CATEGORY_COUNT) {
        val category: Category = c::Category;
        val pattern:  str      = pattern_of(entry, category);
        c = c + 1;
        if (pattern == nil || !may_need(n.category, category)) { cnt; }
        typed = true;
        var j: u32 = 0;
        for (j < node_count(m, category)) {
            val to: Node = Node{category: category, index: j};
            j = j + 1;
            if (!glob_matches(pattern, intern.text(itn, node_name(m, to)))) { cnt; }
            if (to.category != n.category || to.index != n.index) {
                hits = hits + 1;
                cnt;
            }
            if (!is_glob(pattern)) {
                ret err[fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.NEED_SELF, "mach.toml: [{}.{}].need requires itself", owner, name), at)};
            }
        }
    }
    if (!typed) {
        ret err[fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.NEED_FORM,
            "mach.toml: [{}.{}].need entry '{}' must use 'step.<name>' or 'artifact.<name>' with optional '*' wildcards; steps may require only steps",
            owner, name, entry), at)};
    }
    if (hits == 0) {
        ret err[fail.Fail].err{fail.at(alloc, refuse(alloc, diagnostic_kind.NEED_NO_MATCH,
            "mach.toml: [{}.{}].need entry '{}' matches no declaration in its category", owner, name, entry), at)};
    }
    ret err[fail.Fail].ok{};
}

test glob_matches__wildcards_anchor_at_both_ends {
    var code: i32 = 0;
    if (!glob_matches("shader-*", "shader-blur"))      { code = 1; }
    if (!glob_matches("shader-*", "shader-"))          { code = 1; }
    if (glob_matches("shader-*", "shade"))             { code = 1; }
    if (glob_matches("shader-*", "xshader-blur"))      { code = 1; }
    if (!glob_matches("*", "anything"))                { code = 1; }
    if (!glob_matches("*-spv", "blur-spv"))            { code = 1; }
    if (glob_matches("*-spv", "blur-spvx"))            { code = 1; }
    if (!glob_matches("a*b*c", "axxbyyc"))             { code = 1; }
    if (glob_matches("a*b*c", "axxbyy"))               { code = 1; }
    if (!glob_matches("exact", "exact"))               { code = 1; }
    if (glob_matches("exact", "exacts"))               { code = 1; }
    if (!glob_matches("linux-?86_64", "linux-x86_64")) { code = 1; }
    if (glob_matches("a?c", "ac"))                     { code = 1; }
    if (!glob_matches("*-?", "win-x"))                 { code = 1; }
    ret code;
}
