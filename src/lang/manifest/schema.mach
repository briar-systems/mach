    KeyRow{key: "dep", shape: SHAPE_ENTRIES, rule: RULE_OPTIONAL, note: "no dependencies"},
    KeyRow{key: "link", shape: SHAPE_ENTRIES, rule: RULE_OPTIONAL, note: "no libraries to link"},
    KeyRow{key: "step", shape: SHAPE_ENTRIES, rule: RULE_OPTIONAL, note: "no build steps"},
