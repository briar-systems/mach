# the rows of the document root
pub fun root_rows() Rows {
    ret Rows{rows: ?ROOT_KEYS[0], count: ROOT_KEY_COUNT, noun: ""};
}

# the rows of the table a root key names, the empty set for any other key
# ---
# key: a key of the document root
pub fun rows_of(key: str) Rows {
    if (str_equals(key, "project"))  { ret Rows{rows: ?PROJECT_KEYS[0], count: PROJECT_KEY_COUNT, noun: "project"}; }
    if (str_equals(key, "target"))   { ret Rows{rows: ?TARGET_KEYS[0], count: TARGET_KEY_COUNT, noun: "target"}; }
    if (str_equals(key, "profile"))  { ret Rows{rows: ?PROFILE_KEYS[0], count: PROFILE_KEY_COUNT, noun: "profile"}; }
    if (str_equals(key, "artifact")) { ret Rows{rows: ?ARTIFACT_KEYS[0], count: ARTIFACT_KEY_COUNT, noun: "artifact"}; }
    if (str_equals(key, "dep"))      { ret Rows{rows: ?DEP_KEYS[0], count: DEP_KEY_COUNT, noun: "dependency"}; }
    if (str_equals(key, "link"))     { ret Rows{rows: ?LINK_KEYS[0], count: LINK_KEY_COUNT, noun: "link"}; }
    if (str_equals(key, "step"))     { ret Rows{rows: ?STEP_KEYS[0], count: STEP_KEY_COUNT, noun: "step"}; }
    ret Rows{rows: nil, count: 0, noun: ""};
}

# the row of `key` among `rows`, nil when no row names it
pub fun row_of(rows: Rows, key: str) *KeyRow {
    var i: usize = 0;
    for (i < rows.count) {
        if (str_equals(rows.rows[i].key, key)) { ret ?rows.rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# check a parsed manifest document against the schema: every key it writes is a
# row of its table, every value has its row's shape, every required key is
# written and no removed one is. one rule holds for every key whoever reads the
# manifest. the first violation is refused, pointing at the key or value it
# concerns, or at the table a missing key belongs to
# ---
# alloc: owns the refusal's text
# doc:   the document root
# ret:   ok when the document has the schema's shape
pub fun check(alloc: *A.Allocator, doc: *toml.Table) err[fail.Fail] {
    var none: toml.Span;
    ret table_check(alloc, doc, TableName{section: "", name: ""}, root_rows(), none);
}

# which table a refusal names, spelled only when one is made, so a manifest that
# passes allocates nothing
# ---
# section: the root key the table is under, "" for the document root
# name:    the entry's name under a `SHAPE_ENTRIES` section, "" for a section itself
rec TableName {
    section: str;
    name:    str;
}

# check one section of the document root, as `check` holds it, for a reader
# that needs only that section
# ---
# alloc: owns the refusal's text
# doc:   the document root
# key:   a key of the document root, such as "project"
# ret:   ok when the section has the schema's shape
pub fun section_check(alloc: *A.Allocator, doc: *toml.Table, key: str) err[fail.Fail] {
    val row: *KeyRow = row_of(root_rows(), key);
    if (row == nil) { ret err[fail.Fail].err{fail.message("internal: no row of the document root is named for the section")}; }
    val v: opt[*toml.Value] = toml.get(doc, key);
    if (sel v.none) {
        var none: toml.Span;
        if (row.rule == RULE_REQUIRED) { ret fail_at(missing(alloc, TableName{section: "", name: ""}, row), none); }
        ret err[fail.Fail].ok{};
    }
    ret value_check(alloc, TableName{section: "", name: ""}, row, v.some);
}

# check `tab`, the table at `at`, against `rows`; `where` is the table's own
# span, where the refusal of a missing key points
fun table_check(alloc: *A.Allocator, tab: *toml.Table, at: TableName, rows: Rows, where: toml.Span) err[fail.Fail] {
    val n: usize = toml.table_len(tab);
    var i: usize = 0;
    for (i < n) {
        val k_o: opt[str]         = toml.table_key(tab, i);
        val v_o: opt[*toml.Value] = toml.table_value(tab, i);
        if (sel k_o.none) { brk; }
        if (sel v_o.none) { brk; }
        val k:   str         = k_o.some;
        val v:   *toml.Value = v_o.some;
        val row: *KeyRow     = row_of(rows, k);
        if (row == nil)               { ret fail_at(unknown(alloc, at, k), v.key); }
        if (row.rule == RULE_REMOVED) { ret fail_at(removed(alloc, at, k, row.note), v.key); }
        val shaped: err[fail.Fail] = value_check(alloc, at, row, v);
        if (sel shaped.err) { ret shaped; }
        i = i + 1;
    }
    i = 0;
    for (i < rows.count) {
        val row: *KeyRow = ?rows.rows[i];
        i = i + 1;
        if (row.rule != RULE_REQUIRED) { cnt; }
        val v_o: opt[*toml.Value] = toml.get(tab, row.key);
        if (sel v_o.none) { ret fail_at(missing(alloc, at, row), where); }
        if (row.shape == SHAPE_ENTRIES && toml.table_len(?v_o.some.data.table) == 0) {
            ret fail_at(missing(alloc, at, row), v_o.some.span);
        }
    }
    ret err[fail.Fail].ok{};
}

# check one value against its row, and a table it holds against its own rows
fun value_check(alloc: *A.Allocator, at: TableName, row: *KeyRow, v: *toml.Value) err[fail.Fail] {
    val shape: Shape = row.shape;
    if (shape == SHAPE_STRING) {
        if (v.tag != toml.TYPE_STRING) { ret shape_refused(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, at, row, v.span); }
        if (str_empty(v.data.string))  { ret shape_refused(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, at, row, v.span); }
        ret err[fail.Fail].ok{};
    }
    if (shape == SHAPE_INTEGER) {
        if (v.tag != toml.TYPE_INTEGER) { ret shape_refused(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, at, row, v.span); }
        ret err[fail.Fail].ok{};
    }
    if (shape == SHAPE_BOOL) {
        if (v.tag != toml.TYPE_BOOL) { ret shape_refused(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, at, row, v.span); }
        ret err[fail.Fail].ok{};
    }
    if (shape == SHAPE_STRINGS || shape == SHAPE_FILTER) {
        if (shape == SHAPE_FILTER && v.tag == toml.TYPE_STRING) { ret err[fail.Fail].ok{}; }
        if (v.tag != toml.TYPE_ARRAY)                           { ret shape_refused(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, at, row, v.span); }
        val arr: *toml.Array = ?v.data.array;
        var i:   usize       = 0;
        for (i < toml.array_len(arr)) {
            val e: opt[*toml.Value] = toml.array_get(arr, i);
            if (sel e.some) {
                if (e.some.tag != toml.TYPE_STRING) { ret shape_refused(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, at, row, e.some.span); }
            }
            i = i + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (v.tag != toml.TYPE_TABLE) { ret shape_refused(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, at, row, v.span); }
    if (shape == SHAPE_TABLE)     { ret err[fail.Fail].ok{}; }
    val inner: Rows = rows_of(row.key);
    if (shape == SHAPE_SECTION) { ret table_check(alloc, ?v.data.table, TableName{section: row.key, name: ""}, inner, v.span); }
    ret entries_check(alloc, ?v.data.table, row.key, inner);
}

# check every entry of a `SHAPE_ENTRIES` table: a portable name holding a table
# that has the shape of `rows`
fun entries_check(alloc: *A.Allocator, tab: *toml.Table, key: str, rows: Rows) err[fail.Fail] {
    val n: usize = toml.table_len(tab);
    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val name: str         = name_o.some;
        val v:    *toml.Value = v_o.some;
        if (!is_valid_id(name)) {
            ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_NAME, "mach.toml: {} name '{}' must be a portable identifier (letters, digits, '_', '-')", rows.noun, name), v.key);
        }
        val at: TableName = TableName{section: key, name: name};
        if (v.tag != toml.TYPE_TABLE) { ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, "mach.toml: [{}.{}] must be a table", key, name), v.span); }
        val checked: err[fail.Fail] = table_check(alloc, ?v.data.table, at, rows, v.span);
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun shape_refused(alloc: *A.Allocator, kind: diagnostic_kind.Kind, at: TableName, row: *KeyRow, sp: toml.Span) err[fail.Fail] {
    val shape: str = shape_text(row.shape);
    if (str_empty(at.section)) { ret fail_at(refuse(alloc, kind, "mach.toml: [{}] must be {}", row.key, shape), sp); }
    if (str_empty(at.name))    { ret fail_at(refuse(alloc, kind, "mach.toml: [{}].{} must be {}", at.section, row.key, shape), sp); }
    ret fail_at(refuse(alloc, kind, "mach.toml: [{}.{}].{} must be {}", at.section, at.name, row.key, shape), sp);
}

# what a value of `shape` is, as a refusal names it
pub fun shape_text(shape: Shape) str {
    if (shape == SHAPE_STRING)  { ret "a non-empty string"; }
    if (shape == SHAPE_INTEGER) { ret "an integer"; }
    if (shape == SHAPE_BOOL)    { ret "a boolean"; }
    if (shape == SHAPE_STRINGS) { ret "an array of strings"; }
    if (shape == SHAPE_FILTER)  { ret "a string or array of strings"; }
    ret "a table";
}

fun unknown(alloc: *A.Allocator, at: TableName, key: str) fail.Fail {
    val k: diagnostic_kind.Kind = diagnostic_kind.MANIFEST_UNKNOWN_KEY;
    if (str_empty(at.section)) { ret refuse(alloc, k, "mach.toml: unknown table or key '{}' at the document root", key); }
    if (str_empty(at.name))    { ret refuse(alloc, k, "mach.toml: unknown key '{}' in [{}]", key, at.section); }
    ret refuse(alloc, k, "mach.toml: unknown key '{}' in [{}.{}]", key, at.section, at.name);
}

fun removed(alloc: *A.Allocator, at: TableName, key: str, note: str) fail.Fail {
    val k: diagnostic_kind.Kind = diagnostic_kind.MANIFEST_REMOVED_KEY;
    if (str_empty(at.name)) { ret refuse(alloc, k, "mach.toml: [{}] uses removed key '{}'; {}", at.section, key, note); }
    ret refuse(alloc, k, "mach.toml: [{}.{}] uses removed key '{}'; {}", at.section, at.name, key, note);
}

fun missing(alloc: *A.Allocator, at: TableName, row: *KeyRow) fail.Fail {
    val k: diagnostic_kind.Kind = diagnostic_kind.MANIFEST_MISSING_REQUIRED;
    if (str_empty(at.section)) {
        if (str_empty(row.note)) { ret refuse(alloc, k, "mach.toml: missing [{}] table", row.key); }
        ret refuse(alloc, k, "mach.toml: missing [{}] table; {}", row.key, row.note);
    }
    if (!str_empty(at.name)) {
        if (str_empty(row.note)) { ret refuse(alloc, k, "mach.toml: [{}.{}] is missing required key '{}'", at.section, at.name, row.key); }
        ret refuse(alloc, k, "mach.toml: [{}.{}] is missing required key '{}'; {}", at.section, at.name, row.key, row.note);
    }
    if (str_empty(row.note)) { ret refuse(alloc, k, "mach.toml: [{}] is missing required key '{}'", at.section, row.key); }
    ret refuse(alloc, k, "mach.toml: [{}] is missing required key '{}'; {}", at.section, row.key, row.note);
}

# a string key as the manifest reads it: absent and empty are the same err
# (`is missing required key`), so both read as the empty string
pub fun key_text(t: *toml.Table, key: str) str {
    val s: opt[str] = toml.get_str(t, key);
    if (sel s.some) { ret s.some; }
    ret "";
}

# a boolean key's value, false when it is not written; the schema check has
# refused any other shape
pub fun flag(t: *toml.Table, key: str) bool {
    val v: opt[bool] = toml.get_bool(t, key);
    if (sel v.some) { ret v.some; }
    ret false;
}

# the value of a key the schema check has seen written with its row's shape, nil
# when it is not written
pub fun written_value(t: *toml.Table, key: str) *toml.Value {
    val v: opt[*toml.Value] = toml.get(t, key);
    if (sel v.none) { ret nil; }
    ret v.some;
}

# the key token of a table's entry `i` as written; the zero span when absent
pub fun key_span(tab: *toml.Table, i: usize) toml.Span {
    val v: opt[*toml.Value] = toml.table_value(tab, i);
    if (sel v.some) { ret v.some.key; }
    var none: toml.Span;
    ret none;
}

# the literal of an array's element `i`; the zero span when absent
pub fun element_span(arr: *toml.Array, i: usize) toml.Span {
    val e: opt[*toml.Value] = toml.array_get(arr, i);
    if (sel e.some) { ret e.some.span; }
    var none: toml.Span;
    ret none;
}

# the literal of the value `key` names in a table; the zero span when absent
pub fun value_span(tab: *toml.Table, key: str) toml.Span {
    val v: opt[*toml.Value] = toml.get(tab, key);
    if (sel v.some) { ret v.some.span; }
    var none: toml.Span;
    ret none;
}

# a scalar value as a refusal quotes it; a refused allocation is the failure
pub fun value_text(alloc: *A.Allocator, v: *toml.Value) res[str, fail.Fail] {
    if (v.tag == toml.TYPE_INTEGER) {
        val r: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}", v.data.integer);
        if (sel r.err) { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
        ret res[str, fail.Fail].ok{r.ok};
    }
    if (v.tag == toml.TYPE_STRING) {
        val r: res[str, std_format.FormatError] = std_format.sprint(alloc, "\"{}\"", v.data.string);
        if (sel r.err) { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
        ret res[str, fail.Fail].ok{r.ok};
    }
    if (v.tag == toml.TYPE_BOOL) {
        if (v.data.boolean) { ret res[str, fail.Fail].ok{"true"}; }
        ret res[str, fail.Fail].ok{"false"};
    }
    if (v.tag == toml.TYPE_FLOAT) { ret res[str, fail.Fail].ok{"a float"}; }
    if (v.tag == toml.TYPE_ARRAY) { ret res[str, fail.Fail].ok{"an array"}; }
    if (v.tag == toml.TYPE_TABLE) { ret res[str, fail.Fail].ok{"a table"}; }
    ret res[str, fail.Fail].ok{"a value"};
}

# whether `s` is a portable identifier: non-empty, only ASCII letters, digits,
# '_' and '-'. the rule for project, target, artifact, profile, dependency,
# link and step names
# ---
# s:   the candidate
# ret: true when every byte is allowed
pub fun is_valid_id(s: str) bool {
    if (str_empty(s)) { ret false; }
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (!((c >= 'A' && c <= 'Z')
            || (c >= 'a' && c <= 'z')
            || (c >= '0' && c <= '9')
            || c == '_' || c == '-')) { ret false; }
        i = i + 1;
    }
    ret true;
}

def PathViolation: u8;
val PATH_CANONICAL: PathViolation = 0;
val PATH_EMPTY:     PathViolation = 1;
val PATH_BACKSLASH: PathViolation = 2;
val PATH_ABSOLUTE:  PathViolation = 3;
val PATH_DRIVE:     PathViolation = 4;
val PATH_COMPONENT: PathViolation = 5;
val PATH_DOT:       PathViolation = 6;

fun path_violation(value: str) PathViolation {
    if (str_contains_char(value, '\\')) { ret PATH_BACKSLASH; }
    val n: usize = str_len(value);
    if (n == 0)          { ret PATH_EMPTY; }
    if (value[0] == '/') { ret PATH_ABSOLUTE; }
    if (n >= 2 && ((value[0] >= 'A' && value[0] <= 'Z') || (value[0] >= 'a' && value[0] <= 'z')) && value[1] == ':') {
        ret PATH_DRIVE;
    }
    var start: usize = 0;
    var i:     usize = 0;
    for (i <= n) {
        if (i == n || value[i] == '/') {
            val len: usize = i - start;
            if (len == 0) { ret PATH_COMPONENT; }
            if ((len == 1 && value[start] == '.')
                || (len == 2 && value[start] == '.' && value[start + 1] == '.')) {
                ret PATH_DOT;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    ret PATH_CANONICAL;
}

# whether `value` is a canonical strict descendant of the project root: non-empty,
# '/'-separated, no '\', not absolute, no drive letter, no empty component, no
# '.' or '..' component
# ---
# value: the candidate path
# ret:   true when every rule holds
pub fun is_project_path(value: str) bool {
    ret path_violation(value) == PATH_CANONICAL;
}

# refuse a path that `is_project_path` does not admit, naming it as `field`
# and pointing at `sp`, the value as written
pub fun check_path(alloc: *A.Allocator, value: str, field: str, sp: toml.Span) err[fail.Fail] {
    val k:         diagnostic_kind.Kind = diagnostic_kind.MANIFEST_PATH;
    val violation: PathViolation        = path_violation(value);
    if (violation == PATH_BACKSLASH) { ret fail_at(refuse(alloc, k, "mach.toml: {} contains a '\\\\'; manifest paths use '/'", field), sp); }
    if (violation == PATH_EMPTY)     { ret fail_at(refuse(alloc, k, "mach.toml: {} must be a non-empty project-relative path", field), sp); }
    if (violation == PATH_ABSOLUTE)  { ret fail_at(refuse(alloc, k, "mach.toml: {} must be relative to the project root", field), sp); }
    if (violation == PATH_DRIVE)     { ret fail_at(refuse(alloc, k, "mach.toml: {} must not use an absolute drive path", field), sp); }
    if (violation == PATH_COMPONENT) { ret fail_at(refuse(alloc, k, "mach.toml: {} contains an empty path component", field), sp); }
    if (violation == PATH_DOT)       { ret fail_at(refuse(alloc, k, "mach.toml: {} must not contain '.' or '..' path components", field), sp); }
    ret err[fail.Fail].ok{};
}

# a decoded array of strings, each interned
# ---
# items:   the ids, nil when the array is absent or empty
# count:   how many
# present: the key is written
pub rec StrArr {
    items:   *intern.StrId;
    count:   u32;
    present: bool;
}

# intern every element of an array of strings the schema check has admitted
# ---
# alloc: owns the id array, freed with `model.free_strarr`
# itn:   receives the strings
# arr:   the array, nil when the key is absent
# label: the table, as a refusal names it
# key:   the key the array is written under
# ret:   the ids; err for an array too long to count, or a refused allocation
pub fun ids_of(alloc: *A.Allocator, itn: *intern.Interner, arr: *toml.Array, label: str, key: str) res[StrArr, fail.Fail] {
    var out: StrArr;
    out.items   = nil;
    out.count   = 0;
    out.present = arr != nil;
    if (arr == nil) { ret res[StrArr, fail.Fail].ok{out}; }

    val n: usize = toml.array_len(arr);
    if (n == 0) { ret res[StrArr, fail.Fail].ok{out}; }
    if (n > 0xFFFFFFFF::usize) {
        ret res[StrArr, fail.Fail].err{refuse(alloc, diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "mach.toml: {}.{} has too many entries", label, key)};
    }

    val res_items: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, n);
    if (sel res_items.err) { ret res[StrArr, fail.Fail].err{fail.refused(res_items.err)}; }
    out.items = res_items.ok;
    out.count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val v_o:  opt[*toml.Value] = toml.array_get(arr, i);
        var text: str              = nil;
        if (sel v_o.some) {
            if (v_o.some.tag == toml.TYPE_STRING) { text = v_o.some.data.string; }
        }
        if (text == nil) {
            A.deallocate[intern.StrId](alloc, out.items, n);
            ret res[StrArr, fail.Fail].err{fail.message("internal: an array passed its schema check with an element that is not a string")};
        }
        val id: res[intern.StrId, fail.Fail] = id_of(itn, text);
        if (sel id.err) {
            A.deallocate[intern.StrId](alloc, out.items, n);
            ret res[StrArr, fail.Fail].err{id.err};
        }
        out.items[i] = id.ok;
        i            = i + 1;
    }
    ret res[StrArr, fail.Fail].ok{out};
}
