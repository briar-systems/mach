# how the manifest refuses: the text of a refusal, made through the caller's
# allocator, where in the file it points, and the other places it names. a
# refused allocation while a refusal is made is the failure instead, never an
# empty or placeholder text
use mach.lang.fail;
use std_format: std.format;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use diagnostic_kind: mach.lang.diagnostic.kind;
use lang_source:     mach.lang.source;

# `fmt` formatted with `va` into `alloc`, which owns the text
# ---
# ret: the text; err when the allocator refused it
pub fun sfmt(alloc: *A.Allocator, fmt: str, va: ...) res[str, fail.Fail] {
    val r: res[str, std_format.FormatError] = std_format.sprint(alloc, fmt, va...);
    if (sel r.err) { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

# the input is refused under `k` with the text `fmt` formats from `va`, owned
# by `alloc`; a refused allocation is the failure instead
pub fun refuse(alloc: *A.Allocator, k: diagnostic_kind.Kind, fmt: str, va: ...) fail.Fail {
    val r: res[str, std_format.FormatError] = std_format.sprint(alloc, fmt, va...);
    if (sel r.err) { ret fail.format_refused(r.err); }
    ret fail.owning(fail.user(k, r.ok));
}

# the same failure pointing at `sp` in the manifest being parsed; the zero span
# of a value the parser did not write points nowhere
pub fun point_at(f: fail.Fail, sp: toml_value.Span) fail.Fail {
    if (sp.at == 0 && sp.len == 0) { ret f; }
    ret fail.spanned(f, lang_source.span(sp.at, sp.len));
}

# the same failure pointing at the manifest being parsed as a whole, at its start, for what is
# missing from the file itself
pub fun point_at_file(f: fail.Fail) fail.Fail {
    ret fail.at(f, lang_source.location(lang_source.FILE_PENDING, lang_source.span(0, 0)));
}

# a failure pointing at `sp`, as `point_at` places it
pub fun fail_at(f: fail.Fail, sp: toml_value.Span) err[fail.Fail] {
    ret err[fail.Fail].err{point_at(f, sp)};
}

# where `sp` is written in the manifest being parsed, as a range whose file
# `parse` names once the manifest parses; the zero place for a value the
# parser did not write
pub fun span_site(sp: toml_value.Span) lang_source.Location {
    if (sp.at == 0 && sp.len == 0) { ret lang_source.location_nil(); }
    ret lang_source.location(lang_source.FILE_PENDING, lang_source.span(sp.at, sp.len));
}

# where each element of `arr` is written, in order, as `span_site` places it;
# nil for an empty array. freed with `model.free_sites`
pub fun element_sites(alloc: *A.Allocator, arr: *toml_value.Array) res[*lang_source.Location, fail.Fail] {
    val n: usize = toml_lookup.array_len(arr);
    if (n == 0) { ret res[*lang_source.Location, fail.Fail].ok{nil}; }
    val sites_r: res[*lang_source.Location, A.Error] = A.allocate[lang_source.Location](alloc, n);
    if (sel sites_r.err) { ret res[*lang_source.Location, fail.Fail].err{fail.refused(sites_r.err)}; }
    var i: usize = 0;
    for (i < n) {
        var none: toml_value.Span;
        val e_o:  opt[*toml_value.Value] = toml_lookup.array_get(arr, i);
        if (sel e_o.some) { sites_r.ok[i] = span_site(e_o.some.span); }
        or                { sites_r.ok[i] = span_site(none); }
        i = i + 1;
    }
    ret res[*lang_source.Location, fail.Fail].ok{sites_r.ok};
}

# the places a refusal names, gathered in order: it points at the first and
# names the rest as related
# ---
# list:    the places, an unspanned one skipped
# refused: the allocator refused to hold one, which the refusal becomes
pub rec Sites {
    list:    Vector[lang_source.Location];
    refused: opt[A.Error];
}

pub fun sites_init(alloc: *A.Allocator) Sites {
    ret Sites{list: collections_vector.init[lang_source.Location](alloc), refused: opt[A.Error].none{}};
}

pub fun sites_add(s: *Sites, p: lang_source.Location) {
    if (lang_source.location_is_nil(p) || sel s.refused.some) { ret; }
    val pushed: res[usize, A.Error] = collections_vector.push[lang_source.Location](?s.list, p);
    if (sel pushed.err) { s.refused = opt[A.Error].some{pushed.err}; }
}

# `f` pointing at the first place gathered, naming the others as related; the
# gathered places are released
pub fun sites_fail(alloc: *A.Allocator, s: *Sites, f: fail.Fail) fail.Fail {
    fin { collections_vector.dnit[lang_source.Location](?s.list); }
    if (sel s.refused.some) { ret fail.refused(s.refused.some); }
    ret at_sites(alloc, f, s.list.data, s.list.len);
}

# `f` pointing at the first spanned place of the `n` at `sites`, naming the
# spanned ones after it as related
pub fun at_sites(alloc: *A.Allocator, f: fail.Fail, sites: *lang_source.Location, n: usize) fail.Fail {
    var i: usize = 0;
    for (i < n && lang_source.location_is_nil(sites[i])) { i = i + 1; }
    if (i == n) { ret f; }
    val pointed: fail.Fail = fail.at(f, sites[i]);
    if (i + 1 == n) { ret pointed; }
    ret fail.with_related(alloc, pointed, ?sites[i + 1], n - i - 1);
}
