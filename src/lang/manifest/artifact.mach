# every key `--set` writes over an artifact that the table `sub` holds, decoded over `d` with
# where it was written; a key `sub` does not hold leaves `d` as it is
# ---
# alloc: owns a refusal's text
# itn:   holds the name a refusal of the value leads with
# lead:  the artifact table's label in mach.toml, nil for a `--set` value
# sub:   the table
# d:     the artifact
# ret:   ok, or the refusal of a value the key does not accept
pub fun artifact_set(alloc: *A.Allocator, itn: *intern.Interner, lead: str, sub: *toml.Table, d: *ArtifactDef) err[fail.Fail] {
    val v: *toml.Value = written_value(sub, "subsystem");
    if (v == nil) { ret err[fail.Fail].ok{}; }
    val from: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, "subsystem");
    if (sel from.err) { ret err[fail.Fail].err{from.err}; }
    val parsed: res[*mink_subsystem.Subsystem, str] = subsystem_named(alloc, v.data.string);
    if (sel parsed.err) { ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "{}: {}", from.ok.named, parsed.err), v.span)}; }
    d.subsystem          = parsed.ok;
    d.subsystem_declared = true;
    d.subsystem_from     = from.ok;
    ret err[fail.Fail].ok{};
}

# the PE subsystem mink spells `name`, or why it names none: the spelling a previous major took
# for the graphical subsystem is refused naming mink's, and any other unknown name is refused
# listing mink's
# ---
# a:   owns the refusal's text
# ret: mink's row, or the refusal's text
pub fun subsystem_named(a: *A.Allocator, name: str) res[*mink_subsystem.Subsystem, str] {
    val found: res[*mink_subsystem.Subsystem, mink_fail.Fail] = mink_subsystem.by_name(name);
    if (sel found.ok) { ret res[*mink_subsystem.Subsystem, str].ok{found.ok}; }
    if (str_equals(name, "gui")) {
        ret res[*mink_subsystem.Subsystem, str].err{"\"gui\" is spelled \"windows\" since v7, as mink spells the PE subsystem (mach migrate rewrites it)"};
    }
    var names: str   = "";
    var i:     usize = 0;
    for (i < mink_subsystem.count()) {
        val row:    *mink_subsystem.Subsystem = mink_subsystem.at(i);
        var joined: res[str, fail.Fail]       = sfmt(a, "{}, \"{}\"", names, row.name);
        if (i == 0)         { joined = sfmt(a, "\"{}\"", row.name); }
        if (sel joined.err) { ret res[*mink_subsystem.Subsystem, str].err{"names no PE subsystem mink states"}; }
        names = joined.ok;
        i     = i + 1;
    }
    val text: res[str, fail.Fail] = sfmt(a, "\"{}\" names no PE subsystem mink states; write one of {}", name, names);
    if (sel text.err) { ret res[*mink_subsystem.Subsystem, str].err{"names no PE subsystem mink states"}; }
    ret res[*mink_subsystem.Subsystem, str].err{text.ok};
}

fun parse_resource_path(alloc: *A.Allocator, itn: *intern.Interner, label: str,
    sub: *toml.Table, key: str) res[intern.StrId, fail.Fail] {
    val v: *toml.Value = written_value(sub, key);
    if (v == nil) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    val field: res[str, fail.Fail] = sfmt(alloc, "{}.{}", label, key);
    if (sel field.err) { ret res[intern.StrId, fail.Fail].err{field.err}; }
    val checked: err[fail.Fail] = check_path(alloc, v.data.string, field.ok, v.span);
    str_free(alloc, field.ok);
    if (sel checked.err) { ret res[intern.StrId, fail.Fail].err{checked.err}; }
    ret id_of(itn, v.data.string);
}

pub fun parse_artifacts(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val arts_o: opt[*toml.Table] = toml.get_table(t, "artifact");
    if (sel arts_o.none) { ret err[fail.Fail].ok{}; }
    val arts: *toml.Table = arts_o.some;
    val n:    usize       = toml.table_len(arts);
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val res_artifacts: res[*ArtifactDef, A.Error] = A.allocate[ArtifactDef](alloc, n);
    if (sel res_artifacts.err) { ret err[fail.Fail].err{fail.refused(res_artifacts.err)}; }
    m.artifacts      = res_artifacts.ok;
    m.artifact_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *ArtifactDef = ?m.artifacts[initialized];
        slot.targets       = nil;
        slot.target_count  = 0;
        slot.link          = nil;
        slot.link_count    = 0;
        slot.link_at       = nil;
        slot.need          = nil;
        slot.need_count    = 0;
        slot.need_at       = nil;
        slot.sections      = nil;
        slot.section_count = 0;
        slot.size          = opt[u64].none{};
        slot.regions       = nil;
        slot.region_count  = 0;
        initialized        = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val res_artifact: err[fail.Fail] = parse_one_artifact(alloc, itn, arts, i, ?m.artifacts[i]);
        if (sel res_artifact.err) { ret res_artifact; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun parse_one_artifact(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml.Table, k: usize, d: *ArtifactDef) err[fail.Fail] {
    val name_o: opt[str]         = toml.table_key(tab, k);
    val v_o:    opt[*toml.Value] = toml.table_value(tab, k);
    if (sel name_o.none) { ret err[fail.Fail].err{fail.message("internal: an [artifact] entry index is outside its table")}; }
    if (sel v_o.none)    { ret err[fail.Fail].err{fail.message("internal: an [artifact] entry index is outside its table")}; }
    val label: res[str, fail.Fail] = sfmt(alloc, "[artifact.{}]", name_o.some);
    if (sel label.err) { ret err[fail.Fail].err{label.err}; }
    fin { str_free(alloc, label.ok); }
    ret artifact_decode(alloc, itn, name_o.some, label.ok, v_o.some, ?v_o.some.data.table, d);
}

# the ids of the string array `key` of `sub` and where each is written, into
# `items`, `count` and `sites`; nothing when the key is not written
fun entries_decode(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, label: str, key: str,
    items: **intern.StrId, count: *u32, sites: **fail.Place) err[fail.Fail] {
    val arr_o: opt[*toml.Array] = toml.get_array(sub, key);
    if (sel arr_o.none) { ret err[fail.Fail].ok{}; }
    val decoded: res[StrArr, fail.Fail] = ids_of(alloc, itn, arr_o.some, label, key);
    if (sel decoded.err) { ret err[fail.Fail].err{decoded.err}; }
    @items = decoded.ok.items;
    @count = decoded.ok.count;
    val placed: res[*fail.Place, fail.Fail] = element_sites(alloc, arr_o.some);
    if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
    @sites = placed.ok;
    ret err[fail.Fail].ok{};
}

# every kind a manifest can declare, quoted and joined as a list: `"a", "b", or "c"`
fun kind_choices(alloc: *A.Allocator) res[str, fail.Fail] {
    val n: usize = catalog_artifact.declarable_count();
    var s: str   = "";
    var i: usize = 0;
    for (i < n) {
        var sep: str = "";
        if (i > 0) { sep = ", "; }
        if (i > 0 && i + 1 == n) {
            sep = " or ";
            if (n > 2) { sep = ", or "; }
        }
        val longer: res[str, fail.Fail] = sfmt(alloc, "{}{}\"{}\"", s, sep, catalog_artifact.declarable_at(i));
        if (i > 0)          { str_free(alloc, s); }
        if (sel longer.err) { ret longer; }
        s = longer.ok;
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{s};
}

fun artifact_decode(alloc: *A.Allocator, itn: *intern.Interner, name: str, label: str, v: *toml.Value,
    sub: *toml.Table, d: *ArtifactDef) err[fail.Fail] {
    d.icon         = intern.STR_NIL;
    d.app_manifest = intern.STR_NIL;
    val name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel name_id.err) { ret err[fail.Fail].err{name_id.err}; }
    d.name       = name_id.ok;
    d.at         = span_site(v.key);
    d.default_at = span_site(value_span(sub, "default"));
    d.is_default = flag(sub, "default");
    d.export_at  = span_site(value_span(sub, "export"));
    d.is_export  = flag(sub, "export");

    val kind_o: opt[catalog_artifact.Kind] = catalog_artifact.from_name(key_text(sub, "kind"));
    if (sel kind_o.none) {
        val choices: res[str, fail.Fail] = kind_choices(alloc);
        if (sel choices.err) { ret err[fail.Fail].err{choices.err}; }
        val refused: fail.Fail = refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.kind must be {}", label, choices.ok);
        str_free(alloc, choices.ok);
        ret fail_at(refused, value_span(sub, "kind"));
    }
    d.kind = kind_o.some;

    val entry_s:     str                 = key_text(sub, "entry");
    val entry_field: res[str, fail.Fail] = sfmt(alloc, "{}.entry", label);
    if (sel entry_field.err) { ret err[fail.Fail].err{entry_field.err}; }
    val res_check_entry: err[fail.Fail] = check_path(alloc, entry_s, entry_field.ok, value_span(sub, "entry"));
    str_free(alloc, entry_field.ok);
    if (sel res_check_entry.err) { ret res_check_entry; }
    val entry_id: res[intern.StrId, fail.Fail] = id_of(itn, entry_s);
    if (sel entry_id.err) { ret err[fail.Fail].err{entry_id.err}; }
    d.entry    = entry_id.ok;
    d.entry_at = span_site(value_span(sub, "entry"));

    val out_s:     str                 = key_text(sub, "out");
    val out_field: res[str, fail.Fail] = sfmt(alloc, "{}.out", label);
    if (sel out_field.err) { ret err[fail.Fail].err{out_field.err}; }
    val res_check_out: err[fail.Fail] = check_path(alloc, out_s, out_field.ok, value_span(sub, "out"));
    str_free(alloc, out_field.ok);
    if (sel res_check_out.err) { ret res_check_out; }
    val out_id: res[intern.StrId, fail.Fail] = id_of(itn, out_s);
    if (sel out_id.err) { ret err[fail.Fail].err{out_id.err}; }
    d.out    = out_id.ok;
    d.out_at = span_site(value_span(sub, "out"));

    d.targets_at = span_site(value_span(sub, "targets"));
    val targets_o: opt[*toml.Array] = toml.get_array(sub, "targets");
    if (sel targets_o.none) { ret err[fail.Fail].err{fail.message("internal: an artifact passed its schema check without targets")}; }
    val res_targets: res[StrArr, fail.Fail] = ids_of(alloc, itn, targets_o.some, label, "targets");
    if (sel res_targets.err) { ret err[fail.Fail].err{res_targets.err}; }
    d.targets      = res_targets.ok.items;
    d.target_count = res_targets.ok.count;

    val links: err[fail.Fail] = entries_decode(alloc, itn, sub, label, "link", ?d.link, ?d.link_count, ?d.link_at);
    if (sel links.err) { ret links; }
    val needs: err[fail.Fail] = entries_decode(alloc, itn, sub, label, "need", ?d.need, ?d.need_count, ?d.need_at);
    if (sel needs.err) { ret needs; }

    d.subsystem          = ?mink_subsystem.CONSOLE;
    d.subsystem_declared = false;
    val set: err[fail.Fail] = artifact_set(alloc, itn, label, sub, d);
    if (sel set.err) { ret set; }

    val res_icon: res[intern.StrId, fail.Fail] = parse_resource_path(alloc, itn, label, sub, "icon");
    if (sel res_icon.err) { ret err[fail.Fail].err{res_icon.err}; }
    d.icon = res_icon.ok;

    val res_manifest: res[intern.StrId, fail.Fail] = parse_resource_path(alloc, itn, label, sub, "manifest");
    if (sel res_manifest.err) { ret err[fail.Fail].err{res_manifest.err}; }
    d.app_manifest = res_manifest.ok;

    val placed: err[fail.Fail] = layout_decode(alloc, itn, label, sub, d);
    if (sel placed.err) { ret placed; }

    if (d.is_export && !catalog_artifact.is_library(d.kind)) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.export marks the library a bare `use` binds, and a kind = \"bin\" artifact is no library", label), value_span(sub, "export"));
    }

    if (catalog_artifact.is_library(d.kind) && (!intern.str_is_nil(d.icon) || !intern.str_is_nil(d.app_manifest))) {
        var conflict: toml.Span = value_span(sub, "icon");
        if (intern.str_is_nil(d.icon)) { conflict = value_span(sub, "manifest"); }
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.icon and .manifest apply only to kind = \"bin\" artifacts", label), conflict);
    }
    ret err[fail.Fail].ok{};
}

# the layout an artifact states its link: the section order, the size ceiling and the
# memory regions, each section running in at most one region and loading in at most one
# other, which mink lays out as a linker script's MEMORY and AT> do
fun layout_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, sub: *toml.Table, d: *ArtifactDef) err[fail.Fail] {
    var order_at: *fail.Place    = nil;
    val ordered:  err[fail.Fail] = entries_decode(alloc, itn, sub, label, "sections", ?d.sections, ?d.section_count, ?order_at);
    if (order_at != nil && d.section_count > 0) { A.deallocate[fail.Place](alloc, order_at, d.section_count::usize); }
    if (sel ordered.err)                        { ret ordered; }
    val size: opt[i64] = toml.get_int(sub, "size");
    if (sel size.some) {
        if (size.some <= 0) { ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.size must be a positive byte count", label), value_span(sub, "size")); }
        d.size = opt[u64].some{size.some::u64};
    }
    val regions_o: opt[*toml.Table] = toml.get_table(sub, "region");
    if (sel regions_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = regions_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val made: res[*RegionDef, A.Error] = A.allocate[RegionDef](alloc, n);
    if (sel made.err) { ret err[fail.Fail].err{fail.refused(made.err)}; }
    d.regions      = made.ok;
    d.region_count = n::u32;
    var i: usize = 0;
    for (i < n) {
        d.regions[i].run        = nil;
        d.regions[i].run_count  = 0;
        d.regions[i].load       = nil;
        d.regions[i].load_count = 0;
        i                       = i + 1;
    }
    i = 0;
    for (i < n) {
        val decoded: err[fail.Fail] = region_decode(alloc, itn, label, tab, i, ?d.regions[i]);
        if (sel decoded.err) { ret decoded; }
        i = i + 1;
    }
    ret regions_check(alloc, itn, label, sub, d);
}

fun region_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, tab: *toml.Table, i: usize, r: *RegionDef) err[fail.Fail] {
    val name_o: opt[str]         = toml.table_key(tab, i);
    val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
    if (sel name_o.none) { ret err[fail.Fail].err{fail.message("internal: a region entry index is outside its table")}; }
    if (sel v_o.none)    { ret err[fail.Fail].err{fail.message("internal: a region entry index is outside its table")}; }
    val sub:  *toml.Table                  = ?v_o.some.data.table;
    val name: res[intern.StrId, fail.Fail] = id_of(itn, name_o.some);
    if (sel name.err) { ret err[fail.Fail].err{name.err}; }
    r.name   = name.ok;
    r.at     = span_site(v_o.some.key);
    r.origin = written_integer(sub, "origin");
    r.length = written_integer(sub, "length");
    val access: str   = key_text(sub, "access");
    var bits:   u8    = 0;
    var k:      usize = 0;
    for (access[k] != 0) {
        var bit: u8 = 0;
        if (access[k] == 'r') { bit = mink_layout.READABLE; }
        or (access[k] == 'w') { bit = mink_layout.WRITABLE; }
        or (access[k] == 'x') { bit = mink_layout.EXECUTABLE; }
        if (bit == 0 || (bits & bit) != 0) {
            ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.region.{}.access is the letters r, w and x, each at most once (got \"{}\")", label, name_o.some, access), value_span(sub, "access"));
        }
        bits = bits | bit;
        k    = k + 1;
    }
    r.access = bits;
    var run_at: *fail.Place    = nil;
    val runs:   err[fail.Fail] = entries_decode(alloc, itn, sub, label, "run", ?r.run, ?r.run_count, ?run_at);
    if (run_at != nil && r.run_count > 0) { A.deallocate[fail.Place](alloc, run_at, r.run_count::usize); }
    if (sel runs.err)                     { ret runs; }
    var load_at: *fail.Place    = nil;
    val loads:   err[fail.Fail] = entries_decode(alloc, itn, sub, label, "load", ?r.load, ?r.load_count, ?load_at);
    if (load_at != nil && r.load_count > 0) { A.deallocate[fail.Place](alloc, load_at, r.load_count::usize); }
    ret loads;
}

# the integer the schema check admitted under `key`, 0 when it is not written
fun written_integer(sub: *toml.Table, key: str) u64 {
    val v: opt[i64] = toml.get_int(sub, key);
    if (sel v.some) { ret v.some::u64; }
    ret 0;
}

# each section runs in at most one region and loads in at most one, and a section that
# loads in a region runs in another
fun regions_check(alloc: *A.Allocator, itn: *intern.Interner, label: str, sub: *toml.Table, d: *ArtifactDef) err[fail.Fail] {
    val at: toml.Span = value_span(sub, "region");
    var i:  u32       = 0;
    for (i < d.region_count) {
        val r: *RegionDef = ?d.regions[i];
        var k: u32        = 0;
        for (k < r.run_count) {
            if (regions_holding(d, r.run[k], true) > 1) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} runs section '{}' in more than one region", label, intern.text(itn, r.run[k])), at);
            }
            k = k + 1;
        }
        k = 0;
        for (k < r.load_count) {
            if (regions_holding(d, r.load[k], false) > 1) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} loads section '{}' in more than one region", label, intern.text(itn, r.load[k])), at);
            }
            if (regions_holding(d, r.load[k], true) == 0) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} loads section '{}' in region '{}' and runs it in none: a section loads apart only from the region it runs in", label, intern.text(itn, r.load[k]), intern.text(itn, r.name)), at);
            }
            if (holds(r.run, r.run_count, r.load[k])) {
                ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} loads section '{}' in region '{}', which it runs in: a section loads apart only from the region it runs in", label, intern.text(itn, r.load[k]), intern.text(itn, r.name)), at);
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# how many regions of `d` run, or with `run` false load, the section `s`
fun regions_holding(d: *ArtifactDef, s: intern.StrId, run: bool) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < d.region_count) {
        val r: *RegionDef = ?d.regions[i];
        if (run && holds(r.run, r.run_count, s))    { n = n + 1; }
        if (!run && holds(r.load, r.load_count, s)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun holds(items: *intern.StrId, count: u32, s: intern.StrId) bool {
    var i: u32 = 0;
    for (i < count) {
        if (intern.str_same(items[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# more than one `export = true` artifact is refused, pointing at each `export` value
pub fun export_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var names: str = "";
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < m.artifact_count) {
        val a: *ArtifactDef = ?m.artifacts[i];
        i = i + 1;
        if (!a.is_export) { cnt; }
        var longer: res[str, fail.Fail];
        if (count == 0)     { longer = sfmt(alloc, "[artifact.{}]", intern.text(itn, a.name)); }
        or                  { longer = sfmt(alloc, "{}, [artifact.{}]", names, intern.text(itn, a.name)); }
        if (sel longer.err) { ret err[fail.Fail].err{longer.err}; }
        names = longer.ok;
        count = count + 1;
    }
    if (count <= 1) { ret err[fail.Fail].ok{}; }
    var sites: Sites = sites_init(alloc);
    i = 0;
    for (i < m.artifact_count) {
        if (m.artifacts[i].is_export) { sites_add(?sites, m.artifacts[i].export_at); }
        i = i + 1;
    }
    ret err[fail.Fail].err{sites_fail(alloc, ?sites, refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT,
        "mach.toml: {} artifacts declare `export = true` ({}); a project exports at most one library", count, names))};
}

# the export library: the one artifact marked `export = true`, nil when none is
pub fun export_artifact(m: *Manifest) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (m.artifacts[i].is_export) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

# the artifact `m` declares under `name`, nil when none is
pub fun find_artifact(itn: *intern.Interner, m: *Manifest, name: str) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (str_equals(intern.text(itn, m.artifacts[i].name), name)) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun find_artifact_by_name(m: *Manifest, name: intern.StrId) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (intern.str_same(m.artifacts[i].name, name)) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether a `need` entry of `a` selects `other`, a different artifact
pub fun artifact_needs_artifact(itn: *intern.Interner, a: *ArtifactDef, other: *ArtifactDef) bool {
    if (a == other) { ret false; }
    var i: u32 = 0;
    for (i < a.need_count) {
        if (need.selects(itn, a.need[i], need.CATEGORY_ARTIFACT, other.name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# expand an artifact's `out` for the target `vars` names; a refusal points at the `out` value
pub fun expand_artifact_output(alloc: *A.Allocator, itn: *intern.Interner, a: *ArtifactDef, project_work: str, vars: *template.Values) res[str, fail.Fail] {
    val r: res[str, fail.Fail] = artifact_output(alloc, itn, a, project_work, vars);
    if (sel r.err) { ret res[str, fail.Fail].err{fail.at(alloc, r.err, a.out_at)}; }
    ret r;
}

fun artifact_output(alloc: *A.Allocator, itn: *intern.Interner, a: *ArtifactDef, project_work: str, vars: *template.Values) res[str, fail.Fail] {
    val tmpl: str             = intern.text(itn, a.out);
    var v:    template.Values = @vars;
    if (str_contains(tmpl, "{artifact.suffix}")) {
        if (v.declared == nil) { ret res[str, fail.Fail].err{fail.message("{artifact.suffix} expanded with no target")}; }
        val selected: res[resolved.Target, fail.Fail] = resolve_declared(alloc, itn, v.declared);
        if (sel selected.err) { ret res[str, fail.Fail].err{fail.as_user(diagnostic_kind.TARGET_UNSUPPORTED, selected.err)}; }
        var target: resolved.Target                          = selected.ok;
        val named:  res[lang_target.ArtifactName, fail.Fail] = lang_target.artifact_naming(alloc, ?target, a.kind);
        if (sel named.err) { ret res[str, fail.Fail].err{fail.as_user(diagnostic_kind.ARTIFACT_KIND_UNSUPPORTED, named.err)}; }
        v.artifact_suffix = named.ok.suffix;
    }
    ret template.path_expand(alloc, tmpl, template.CONTEXT_ARTIFACT_OUT, project_work, ?v, "an artifact output");
}

# whether an artifact's `targets` lists a target name or "*"
# ---
# itn:   resolves the names
# a:     the artifact
# tname: the target name
# ret:   true when listed
pub fun artifact_supports_target(itn: *intern.Interner, a: *ArtifactDef, tname: intern.StrId) bool {
    var i: u32 = 0;
    for (i < a.target_count) {
        if (intern.str_same(a.targets[i], tname) || str_equals(intern.text(itn, a.targets[i]), "*")) { ret true; }
        i = i + 1;
    }
    ret false;
}
