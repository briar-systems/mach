# the values a path template expands with; see `expand`
# ---
# target:          `{target.name}`
# isa:             `{target.isa}`
# os:              `{target.os}`
# abi:             `{target.abi}`
# profile:         `{profile.name}`
# format:          the target's explicit `of` override, "" when the format is derived
# artifact_suffix: `{artifact.suffix}`, set by `expand_artifact_output` for the
#                  artifact being named; nil everywhere else, where the variable is refused
# reqs:            the artifacts this expansion may name as `{artifact.<id>.out}`; nil when none
# req_count:       length of `reqs`
pub rec TmplVars {
    target:          str;
    isa:             str;
    os:              str;
    abi:             str;
    profile:         str;
    format:          str;
    artifact_suffix: str;
    reqs:            *ArtifactReq;
    req_count:       u32;
}

# one artifact another artifact requires, as `{artifact.<id>.out}` resolves it
# ---
# name: the required artifact's name
# out:  its final output path when it builds for exactly one target here, or ""
#       when it builds for several, which makes `{artifact.<id>.out}` an error
pub rec ArtifactReq {
    name: str;
    out:  str;
}

# the artifacts the modules of one project may name as `{artifact.<id>.out}`
# ---
# owner:      the id of the project whose modules resolve in this scope
# dependency: the requirements are a dependency's default library artifacts',
#             not the requirements of the artifact being built
# reqs:       the requirements; nil when none
# req_count:  length of `reqs`
pub rec RequirementScope {
    owner:      intern.StrId;
    dependency: bool;
    reqs:       *ArtifactReq;
    req_count:  u32;
}

# the declared subsystem, absent when the key is omitted
fun parse_subsystem(alloc: *A.Allocator, label: str, sub: *toml.Table) res[opt[of.Subsystem], outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "subsystem");
    if (sel v_o.none) { ret res[opt[of.Subsystem], outcome.Fail].ok{opt[of.Subsystem].none{}}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_STRING) { ret res[opt[of.Subsystem], outcome.Fail].err{outcome.user(subsystem_err(alloc, label, v))}; }
    val parsed: opt[of.Subsystem] = of.subsystem_from_name(v.data.string);
    if (sel parsed.some) { ret res[opt[of.Subsystem], outcome.Fail].ok{parsed}; }
    ret res[opt[of.Subsystem], outcome.Fail].err{outcome.user(subsystem_err(alloc, label, v))};
}

fun subsystem_err(alloc: *A.Allocator, label: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: {}.subsystem must be \"console\" or \"gui\" (got {})",
        label, opt_value_text(alloc, v));
}

fun parse_resource_path(alloc: *A.Allocator, itn: *intern.Interner, label: str,
    sub: *toml.Table, key: str) res[intern.StrId, outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, key);
    if (sel v_o.none) { ret res[intern.StrId, outcome.Fail].ok{intern.STR_NIL}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_STRING) {
        ret res[intern.StrId, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.{} must be a non-empty path string", label, key))};
    }
    if (str_empty(v.data.string)) {
        ret res[intern.StrId, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.{} must not be empty; omit it when unused", label, key))};
    }
    val field:   str               = sfmt(alloc, "{}.{}", label, key);
    val checked: err[outcome.Fail] = check_path(alloc, v.data.string, field);
    str_free(alloc, field);
    if (sel checked.err) {
        ret res[intern.StrId, outcome.Fail].err{checked.err};
    }
    val interned: res[intern.StrId, A.Error] = intern.intern(itn, v.data.string);
    if (sel interned.err) { ret res[intern.StrId, outcome.Fail].err{outcome.refused(interned.err)}; }
    ret res[intern.StrId, outcome.Fail].ok{interned.ok};
}

fun artifact_key_known(k: str) bool {
    ret str_equals(k, "kind") || str_equals(k, "entry") || str_equals(k, "out")
        || str_equals(k, "targets") || str_equals(k, "link") || str_equals(k, "need")
        || str_equals(k, "default") || str_equals(k, "subsystem")
        || str_equals(k, "icon") || str_equals(k, "manifest");
}

pub fun parse_artifacts(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) err[outcome.Fail] {
    val arts_o: opt[*toml.Table] = toml.get_table(t, "artifact");
    if (sel arts_o.none) { ret err[outcome.Fail].ok{}; }
    val arts: *toml.Table = arts_o.some;
    val n:    usize       = toml.table_len(arts);
    if (n == 0) { ret err[outcome.Fail].ok{}; }

    val res_artifacts: res[*ArtifactDef, A.Error] = A.allocate[ArtifactDef](alloc, n);
    if (sel res_artifacts.err) { ret err[outcome.Fail].err{outcome.refused(res_artifacts.err)}; }
    m.artifacts      = res_artifacts.ok;
    m.artifact_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *ArtifactDef = ?m.artifacts[initialized];
        slot.targets      = nil;
        slot.target_count = 0;
        slot.link         = nil;
        slot.link_count   = 0;
        slot.need         = nil;
        slot.need_count   = 0;
        initialized       = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val res_artifact: err[outcome.Fail] = parse_one_artifact(alloc, itn, arts, i, as_root, ?m.artifacts[i]);
        if (sel res_artifact.err) { ret res_artifact; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun parse_one_artifact(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml.Table, k: usize, as_root: bool, d: *ArtifactDef) err[outcome.Fail] {
    val name_o: opt[str] = toml.table_key(tab, k);
    if (sel name_o.none) { ret err[outcome.Fail].err{outcome.internal("mach.toml: [artifact] entry index is outside its table")}; }
    val name: str              = name_o.some;
    val v_o:  opt[*toml.Value] = toml.table_value(tab, k);
    if (sel v_o.none) { ret err[outcome.Fail].err{outcome.internal("mach.toml: [artifact] entry index is outside its table")}; }
    val v:     *toml.Value = v_o.some;
    val label: str         = sfmt(alloc, "[artifact.{}]", name);
    if (!is_valid_id(name)) {
        val name_msg: str = sfmt(alloc, "mach.toml: artifact name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
        str_free(alloc, label);
        ret err[outcome.Fail].err{outcome.user(name_msg)};
    }
    if (v.tag != toml.TYPE_TABLE) {
        val lbl_msg1: str = sfmt(alloc, "mach.toml: {} must be a table", label);
        str_free(alloc, label);
        ret err[outcome.Fail].err{outcome.user(lbl_msg1)};
    }
    val sub: *toml.Table = ?v.data.table;

    val res_keys: err[outcome.Fail] = check_keys(alloc, sub, label, artifact_key_known);
    if (sel res_keys.err) { ret res_keys; }

    d.icon         = intern.STR_NIL;
    d.app_manifest = intern.STR_NIL;
    d.name         = intern_unwrap(itn, name);
    val default_r: res[bool, outcome.Fail] = parse_default_flag(alloc, "artifact", name, sub);
    if (sel default_r.err) {
        str_free(alloc, label);
        ret err[outcome.Fail].err{default_r.err};
    }
    d.is_default = default_r.ok;

    val kind_s: str = key_text(sub, "kind");
    if (str_empty(kind_s) || !(str_equals(kind_s, "bin") || str_equals(kind_s, "static") || str_equals(kind_s, "shared"))) {
        val lbl_msg2: str = sfmt(alloc, "mach.toml: {}.kind must be \"bin\", \"static\", or \"shared\"", label);
        str_free(alloc, label);
        ret err[outcome.Fail].err{outcome.user(lbl_msg2)};
    }
    d.kind   = intern_unwrap(itn, kind_s);
    d.is_lib = !str_equals(kind_s, "bin");

    val entry_s: str = key_text(sub, "entry");
    if (str_empty(entry_s)) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} is missing required key 'entry'", label))}; }
    val entry_field:     str               = sfmt(alloc, "{}.entry", label);
    val res_check_entry: err[outcome.Fail] = check_path(alloc, entry_s, entry_field);
    str_free(alloc, entry_field);
    if (sel res_check_entry.err) { ret res_check_entry; }
    d.entry = intern_unwrap(itn, entry_s);

    val out_s: str = key_text(sub, "out");
    if (str_empty(out_s)) { ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} is missing required key 'out'", label))}; }
    val out_field:     str               = sfmt(alloc, "{}.out", label);
    val res_check_out: err[outcome.Fail] = check_path(alloc, out_s, out_field);
    str_free(alloc, out_field);
    if (sel res_check_out.err) { ret res_check_out; }
    d.out = intern_unwrap(itn, out_s);

    val targets_arr_o: opt[*toml.Array] = toml.get_array(sub, "targets");
    if (sel targets_arr_o.none) {
        val lbl_msg3: str = sfmt(alloc, "mach.toml: {} is missing required key 'targets'", label);
        str_free(alloc, label);
        ret err[outcome.Fail].err{outcome.user(lbl_msg3)};
    }
    val targets_arr: *toml.Array               = targets_arr_o.some;
    val res_targets: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, targets_arr, label, "targets", false);
    if (sel res_targets.err) { ret err[outcome.Fail].err{res_targets.err}; }
    val targets_val: StrArr = res_targets.ok;
    d.targets      = targets_val.items;
    d.target_count = targets_val.count;

    val link_arr_o: opt[*toml.Array] = toml.get_array(sub, "link");
    if (sel link_arr_o.none && as_root) {
        val lbl_msg4: str = sfmt(alloc, "mach.toml: {} is missing required key 'link' (use [] for none)", label);
        str_free(alloc, label);
        ret err[outcome.Fail].err{outcome.user(lbl_msg4)};
    }
    if (sel link_arr_o.some) {
        val link_arr: *toml.Array               = link_arr_o.some;
        val res_link: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, link_arr, label, "link", false);
        if (sel res_link.err) { ret err[outcome.Fail].err{res_link.err}; }
        val link_val: StrArr = res_link.ok;
        d.link       = link_val.items;
        d.link_count = link_val.count;
    }

    val need_arr_o: opt[*toml.Array] = toml.get_array(sub, "need");
    if (sel need_arr_o.none && as_root) {
        val lbl_msg5: str = sfmt(alloc, "mach.toml: {} is missing required key 'need' (use [] for none)", label);
        str_free(alloc, label);
        ret err[outcome.Fail].err{outcome.user(lbl_msg5)};
    }
    if (sel need_arr_o.some) {
        val need_arr: *toml.Array               = need_arr_o.some;
        val res_need: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, need_arr, label, "need", false);
        if (sel res_need.err) { ret err[outcome.Fail].err{res_need.err}; }
        val need_val: StrArr = res_need.ok;
        d.need       = need_val.items;
        d.need_count = need_val.count;
    }

    val res_subsystem: res[opt[of.Subsystem], outcome.Fail] = parse_subsystem(alloc, label, sub);
    if (sel res_subsystem.err) { ret err[outcome.Fail].err{res_subsystem.err}; }
    d.subsystem          = of.SUBSYSTEM_CONSOLE;
    d.subsystem_declared = false;
    if (sel res_subsystem.ok.some) {
        d.subsystem          = res_subsystem.ok.some;
        d.subsystem_declared = true;
    }

    val res_icon: res[intern.StrId, outcome.Fail] = parse_resource_path(alloc, itn, label, sub, "icon");
    if (sel res_icon.err) {
        str_free(alloc, label);
        ret err[outcome.Fail].err{res_icon.err};
    }
    d.icon = res_icon.ok;

    val res_manifest: res[intern.StrId, outcome.Fail] = parse_resource_path(alloc, itn, label, sub, "manifest");
    if (sel res_manifest.err) {
        str_free(alloc, label);
        ret err[outcome.Fail].err{res_manifest.err};
    }
    d.app_manifest = res_manifest.ok;

    if (d.is_lib && (d.icon != intern.STR_NIL || d.app_manifest != intern.STR_NIL)) {
        val lbl_msg_icon: str = sfmt(alloc,
            "mach.toml: {}.icon and .manifest apply only to kind = \"bin\" artifacts", label);
        str_free(alloc, label);
        ret err[outcome.Fail].err{outcome.user(lbl_msg_icon)};
    }

    str_free(alloc, label);
    ret err[outcome.Fail].ok{};
}

fun seg_eq(tmpl: str, start: usize, end: usize, lit: str) bool {
    val ll: usize = str_len(lit);
    if (end - start != ll) { ret false; }
    var i: usize = 0;
    for (i < ll) {
        if (tmpl[start + i] != lit[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

val TMPL_ARTIFACT_PREFIX: str = "artifact.";
val TMPL_ARTIFACT_SUFFIX: str = ".out";

fun region_eq_str(tmpl: str, start: usize, end: usize, s: str) bool {
    val n: usize = end - start;
    if (str_len(s) != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (tmpl[start + i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun tmpl_artifact_id(tmpl: str, start: usize, end: usize, id_start: *usize, id_end: *usize) bool {
    val pl: usize = str_len(TMPL_ARTIFACT_PREFIX);
    val sl: usize = str_len(TMPL_ARTIFACT_SUFFIX);
    if (end <= start || end - start <= pl + sl) { ret false; }
    var i: usize = 0;
    for (i < pl) {
        if (tmpl[start + i] != TMPL_ARTIFACT_PREFIX[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < sl) {
        if (tmpl[end - sl + i] != TMPL_ARTIFACT_SUFFIX[i]) { ret false; }
        i = i + 1;
    }
    @id_start = start + pl;
    @id_end   = end - sl;
    ret true;
}

# the artifact id the first `{artifact.<id>.out}` group in `tmpl` names, allocated
# in `alloc`; none when the template holds no such group. a diagnostic uses this to
# say whose output a resolved path is, which the path alone no longer shows
# ---
# alloc: owns the returned id
# tmpl:  the unexpanded template
pub fun artifact_template_id(alloc: *A.Allocator, tmpl: str) opt[str] {
    val n: usize = str_len(tmpl);
    var i: usize = 0;
    for (i < n) {
        if (tmpl[i] != '{') {
            i = i + 1;
            cnt;
        }
        var ii: usize = i + 1;
        for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
        if (ii >= n) { ret opt[str].none{}; }
        var id_start: usize = 0;
        var id_end:   usize = 0;
        if (tmpl_artifact_id(tmpl, i + 1, ii, ?id_start, ?id_end)) {
            val dup: res[str, A.Error] = str_dup_range(alloc, tmpl, id_start, id_end - id_start);
            if (sel dup.err) { ret opt[str].none{}; }
            ret opt[str].some{dup.ok};
        }
        i = ii + 1;
    }
    ret opt[str].none{};
}

fun tmpl_is_artifact_out(tmpl: str, start: usize, end: usize) bool {
    var s: usize = 0;
    var e: usize = 0;
    ret tmpl_artifact_id(tmpl, start, end, ?s, ?e);
}

fun tmpl_artifact_value(alloc: *A.Allocator, tmpl: str, id_start: usize, id_end: usize,
    v: *TmplVars) res[str, outcome.Fail] {
    var i: u32 = 0;
    for (i < v.req_count) {
        if (region_eq_str(tmpl, id_start, id_end, v.reqs[i].name)) {
            if (str_empty(v.reqs[i].out)) {
                val message: res[str, format.FormatError] = format.sprint(alloc,
                    "mach.toml: '{{artifact.{}.out}}' is ambiguous: artifact '{}' builds for more than one target here",
                    v.reqs[i].name, v.reqs[i].name);
                if (sel message.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(message.err))}; }
                ret res[str, outcome.Fail].err{outcome.user(message.ok)};
            }
            ret res[str, outcome.Fail].ok{v.reqs[i].out};
        }
        i = i + 1;
    }
    val copied: res[str, string.StrError] = str_copy_slice(alloc, tmpl, id_start, id_end - id_start);
    if (sel copied.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(copied.err))}; }
    val id: str = copied.ok;
    fin { str_free(alloc, id); }
    val message: res[str, format.FormatError] = format.sprint(alloc,
        "mach.toml: '{{artifact.{}.out}}' names an artifact this artifact does not require; add 'artifact.{}' to its 'need'",
        id, id);
    if (sel message.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(message.err))}; }
    ret res[str, outcome.Fail].err{outcome.user(message.ok)};
}

fun tmpl_value(alloc: *A.Allocator, tmpl: str, start: usize, end: usize, project_out: str,
    v: *TmplVars) res[str, outcome.Fail] {
    if (seg_eq(tmpl, start, end, "project.out")) {
        if (str_empty(project_out)) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: '{project.out}' is not available in [project].out")}; }
        ret res[str, outcome.Fail].ok{project_out};
    }
    if (seg_eq(tmpl, start, end, "target.name"))  { ret res[str, outcome.Fail].ok{v.target}; }
    if (seg_eq(tmpl, start, end, "target.isa"))   { ret res[str, outcome.Fail].ok{v.isa}; }
    if (seg_eq(tmpl, start, end, "target.os"))    { ret res[str, outcome.Fail].ok{v.os}; }
    if (seg_eq(tmpl, start, end, "target.abi"))   { ret res[str, outcome.Fail].ok{v.abi}; }
    if (seg_eq(tmpl, start, end, "profile.name")) { ret res[str, outcome.Fail].ok{v.profile}; }
    if (seg_eq(tmpl, start, end, "artifact.suffix")) {
        if (v.artifact_suffix == nil) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: '{artifact.suffix}' is available only in an artifact output")}; }
        ret res[str, outcome.Fail].ok{v.artifact_suffix};
    }
    var id_start: usize = 0;
    var id_end:   usize = 0;
    if (tmpl_artifact_id(tmpl, start, end, ?id_start, ?id_end)) {
        ret tmpl_artifact_value(alloc, tmpl, id_start, id_end, v);
    }
    val copied: res[str, string.StrError] = str_copy_slice(alloc, tmpl, start, end - start);
    if (sel copied.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(copied.err))}; }
    val name: str = copied.ok;
    fin { str_free(alloc, name); }
    val message: res[str, format.FormatError] = format.sprint(alloc, "mach.toml: unknown template variable '{{{}}}'", name);
    if (sel message.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(message.err))}; }
    ret res[str, outcome.Fail].err{outcome.user(message.ok)};
}

fun tmpl_known(tmpl: str, start: usize, end: usize) bool {
    ret seg_eq(tmpl, start, end, "project.out")
        || seg_eq(tmpl, start, end, "target.name")
        || seg_eq(tmpl, start, end, "target.isa")
        || seg_eq(tmpl, start, end, "target.os")
        || seg_eq(tmpl, start, end, "target.abi")
        || seg_eq(tmpl, start, end, "profile.name")
        || seg_eq(tmpl, start, end, "artifact.suffix")
        || tmpl_is_artifact_out(tmpl, start, end);
}

fun tmpl_namespace(tmpl: str, start: usize, end: usize, namespace: str) bool {
    val nn: usize = str_len(namespace);
    if (end - start < nn) { ret false; }
    var i: usize = 0;
    for (i < nn) {
        if (tmpl[start + i] != namespace[i]) { ret false; }
        i = i + 1;
    }
    ret end - start == nn || tmpl[start + nn] == '.';
}

fun tmpl_reserved(tmpl: str, start: usize, end: usize) bool {
    ret tmpl_namespace(tmpl, start, end, "project")
        || tmpl_namespace(tmpl, start, end, "target")
        || tmpl_namespace(tmpl, start, end, "profile")
        || tmpl_namespace(tmpl, start, end, "artifact");
}

# template variables for one target and profile, with no artifact requirements
# ---
# itn: resolves the target's interned strings
# t:   the target
# pn:  the profile name
# ret: the variables; `reqs` is nil
pub fun tmpl_vars_of(itn: *intern.Interner, t: *TargetDef, pn: str) TmplVars {
    var v: TmplVars;
    v.target  = idstr(itn, t.name);
    v.isa     = idstr(itn, t.isa);
    v.os      = idstr(itn, t.os);
    v.abi     = idstr(itn, t.abi);
    v.profile = pn;
    v.format  = "";
    if (t.of != intern.STR_NIL) { v.format = idstr(itn, t.of); }
    v.artifact_suffix = nil;
    v.reqs            = nil;
    v.req_count       = 0;
    ret v;
}

pub fun tmpl_vars_of_reqs(reqs: *ArtifactReq, req_count: u32) TmplVars {
    var v: TmplVars;
    v.target    = "";
    v.isa       = "";
    v.os        = "";
    v.abi       = "";
    v.profile   = "";
    v.reqs      = reqs;
    v.req_count = req_count;
    ret v;
}

# a template that could not be expanded: rejected names the template's own
# fault in a message the caller's allocator owns (released by
# template_error_dnit); internal carries the compiler's static text
pub tag TemplateError: u8 {
    internal: str;
    rejected: str;
}

pub fun template_internal(message: str) TemplateError {
    ret TemplateError.internal{message};
}

pub fun template_error_dnit(alloc: *A.Allocator, e: TemplateError) {
    if (sel e.rejected) { str_free(alloc, e.rejected); }
}

pub fun template_rejection(alloc: *A.Allocator, field: str, tmpl: str, reason: str) TemplateError {
    val r: res[str, format.FormatError] = format.sprint(alloc, "{}: {}: '{}'", field, reason, tmpl);
    if (sel r.err) { ret template_internal(outcome.format_text(r.err)); }
    ret TemplateError.rejected{r.ok};
}

# the message either case carries
pub fun template_text(e: TemplateError) str {
    if (sel e.internal) { ret e.internal; }
    ret e.rejected;
}

fun artifact_path_value(alloc: *A.Allocator, tmpl: str, start: usize, end: usize,
    reqs: *ArtifactReq, req_count: u32, dependency: str, field: str) res[str, TemplateError] {
    var id_start: usize = 0;
    var id_end:   usize = 0;
    if (!tmpl_artifact_id(tmpl, start, end, ?id_start, ?id_end)) {
        ret res[str, TemplateError].err{template_rejection(alloc, field, tmpl,
            "only '{artifact.<id>.out}' may appear in this path")};
    }
    var i: u32 = 0;
    for (i < req_count) {
        if (region_eq_str(tmpl, id_start, id_end, reqs[i].name)) {
            if (str_empty(reqs[i].out)) {
                ret res[str, TemplateError].err{template_rejection(alloc, field, tmpl,
                    "artifact output is ambiguous: the artifact builds for more than one target here")};
            }
            ret res[str, TemplateError].ok{reqs[i].out};
        }
        i = i + 1;
    }
    if (!str_empty(dependency)) {
        val reason: res[str, format.FormatError] = format.sprint(alloc,
            "names an artifact no default library artifact of dependency '{}' requires; add it to that artifact's 'need'",
            dependency);
        if (sel reason.err) { ret res[str, TemplateError].err{template_internal(outcome.format_text(reason.err))}; }
        fin { str_free(alloc, reason.ok); }
        ret res[str, TemplateError].err{template_rejection(alloc, field, tmpl, reason.ok)};
    }
    ret res[str, TemplateError].err{template_rejection(alloc, field, tmpl,
        "names an artifact this artifact does not require; add it to its 'need'")};
}

# expand an `{artifact.<id>.out}` path, the one template vocabulary a source path
# accepts
# ---
# alloc:      owns the returned path and a rejection's text
# tmpl:       the template
# reqs:       the requirements the template may name
# req_count:  length of `reqs`
# dependency: the id of the dependency whose default library requirements `reqs`
#             are, or "" for the artifact being built; names the scope a rejection
#             points at
# field:      what the template is, for the rejection
# ret:        the expanded path; err rejected for a name outside `reqs`, an ambiguous
#             output or any other template, internal for allocation
pub fun expand_artifact_path(alloc: *A.Allocator, tmpl: str, reqs: *ArtifactReq, req_count: u32,
    dependency: str, field: str) res[str, TemplateError] {
    val n:     usize = str_len(tmpl);
    var total: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        var len: usize = 1;
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii >= n) {
                ret res[str, TemplateError].err{template_rejection(alloc, field, tmpl,
                    "unterminated '{' in a path template")};
            }
            val vr: res[str, TemplateError] = artifact_path_value(alloc, tmpl, i + 1, ii,
                reqs, req_count, dependency, field);
            if (sel vr.err) { ret vr; }
            len = str_len(vr.ok);
            i   = ii + 1;
        }
        or { i = i + 1; }
        if (len >= 0xffffffffffffffff::usize - total) {
            ret res[str, TemplateError].err{template_internal("artifact path expansion is too large")};
        }
        total = total + len;
    }
    val br: res[*u8, A.Error] = A.allocate[u8](alloc, total + 1);
    if (sel br.err) {
        ret res[str, TemplateError].err{template_internal(outcome.alloc_text(br.err))};
    }
    val buf: *u8   = br.ok;
    var w:   usize = 0;
    i = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            val vr: res[str, TemplateError] = artifact_path_value(alloc, tmpl, i + 1, ii,
                reqs, req_count, dependency, field);
            if (sel vr.err) {
                A.deallocate[u8](alloc, buf, total + 1);
                ret vr;
            }
            val value: str   = vr.ok;
            var j:     usize = 0;
            for (j < str_len(value)) {
                buf[w] = value[j];
                w      = w + 1;
                j      = j + 1;
            }
            i = ii + 1;
        }
        or {
            buf[w] = tmpl[i];
            w      = w + 1;
            i      = i + 1;
        }
    }
    buf[w] = 0;
    ret res[str, TemplateError].ok{buf::str};
}

# `tmpl_vars_of` with artifact requirements attached
# ---
# itn:       resolves the target's interned strings
# t:         the target
# pn:        the profile name
# reqs:      the requirements `{artifact.<id>.out}` may name
# req_count: length of `reqs`
# ret:       the variables
pub fun tmpl_vars_with_reqs(itn: *intern.Interner, t: *TargetDef, pn: str,
    reqs: *ArtifactReq, req_count: u32) TmplVars {
    var v: TmplVars = tmpl_vars_of(itn, t, pn);
    v.reqs      = reqs;
    v.req_count = req_count;
    ret v;
}

# expand a path template. the placeholders are `{project.out}`, `{target.name}`,
# `{target.isa}`, `{target.os}`, `{target.abi}`, `{profile.name}` and
# `{artifact.<id>.out}`; nothing else is accepted
# ---
# alloc:       owns the returned string
# tmpl:        the template
# project_out: the expanded `[project].out`, or "" when expanding `[project].out`
#              itself, in which case `{project.out}` is an error
# v:           the values
# ret:         the expanded string; err on an unterminated '{', an unknown placeholder,
#              an artifact not in `v.reqs`, or an artifact whose output is ambiguous
pub fun expand(alloc: *A.Allocator, tmpl: str, project_out: str,
    v: *TmplVars) res[str, outcome.Fail] {
    val n:     usize = str_len(tmpl);
    var total: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii >= n) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: unterminated '{' in a path template")}; }
            val res_value: res[str, outcome.Fail] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
            if (sel res_value.err) { ret res[str, outcome.Fail].err{res_value.err}; }
            total = total + str_len(res_value.ok);
            i     = ii + 1;
        }
        or {
            total = total + 1;
            i     = i + 1;
        }
    }

    val res_buf: res[*u8, A.Error] = A.allocate[u8](alloc, total + 1);
    if (sel res_buf.err) { ret res[str, outcome.Fail].err{outcome.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;

    var w: usize = 0;
    i = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            val res_value: res[str, outcome.Fail] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
            if (sel res_value.err) {
                A.deallocate[u8](alloc, buf, total + 1);
                ret res[str, outcome.Fail].err{res_value.err};
            }
            val value: str   = res_value.ok;
            val vl:    usize = str_len(value);
            var iii:   usize = 0;
            for (iii < vl) {
                buf[w] = value[iii];
                w      = w + 1;
                iii    = iii + 1;
            }
            i = ii + 1;
        }
        or {
            buf[w] = tmpl[i];
            w      = w + 1;
            i      = i + 1;
        }
    }
    buf[w] = 0;
    ret res[str, outcome.Fail].ok{buf::str};
}

# expand a build step `argv` or `env` value. known placeholders expand as in
# `expand`; a brace pair that is not a placeholder is copied verbatim, unless it
# starts with `project`, `target`, `profile` or `artifact`, which is an error
# ---
# alloc:       owns the returned string
# tmpl:        the value
# project_out: the expanded `[project].out`
# v:           the values
# ret:         the expanded string; err for an unknown or unterminated reserved
#              placeholder, the `expand` errors, or a result too large to size
pub fun expand_step_value(alloc: *A.Allocator, tmpl: str, project_out: str,
    v: *TmplVars) res[str, outcome.Fail] {
    val n:     usize = str_len(tmpl);
    var total: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii < n && tmpl_known(tmpl, i + 1, ii)) {
                val value_r: res[str, outcome.Fail] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
                if (sel value_r.err) { ret res[str, outcome.Fail].err{value_r.err}; }
                val vl: usize = str_len(value_r.ok);
                if (vl > ~(0::usize) - total) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: expanded build step value is too large")}; }
                total = total + vl;
                i     = ii + 1;
            }
            or {
                if (tmpl_reserved(tmpl, i + 1, ii)) {
                    if (ii >= n) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: unterminated reserved build step template")}; }
                    ret res[str, outcome.Fail].err{outcome.user("mach.toml: unknown reserved build step template")};
                }
                or {
                    if (total == ~(0::usize)) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: expanded build step value is too large")}; }
                    total = total + 1;
                    i     = i + 1;
                }
            }
        }
        or {
            if (total == ~(0::usize)) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: expanded build step value is too large")}; }
            total = total + 1;
            i     = i + 1;
        }
    }
    if (total == ~(0::usize)) { ret res[str, outcome.Fail].err{outcome.user("mach.toml: expanded build step value is too large")}; }

    val buf_r: res[*u8, A.Error] = A.allocate[u8](alloc, total + 1);
    if (sel buf_r.err) { ret res[str, outcome.Fail].err{outcome.refused(buf_r.err)}; }
    val buf: *u8 = buf_r.ok;

    var w: usize = 0;
    i = 0;
    for (i < n) {
        if (tmpl[i] == '{') {
            var ii: usize = i + 1;
            for (ii < n && tmpl[ii] != '}') { ii = ii + 1; }
            if (ii < n && tmpl_known(tmpl, i + 1, ii)) {
                val value_r: res[str, outcome.Fail] = tmpl_value(alloc, tmpl, i + 1, ii, project_out, v);
                if (sel value_r.err) {
                    A.deallocate[u8](alloc, buf, total + 1);
                    ret res[str, outcome.Fail].err{value_r.err};
                }
                val value: str   = value_r.ok;
                val vl:    usize = str_len(value);
                var iii:   usize = 0;
                for (iii < vl) {
                    buf[w] = value[iii];
                    w      = w + 1;
                    iii    = iii + 1;
                }
                i = ii + 1;
            }
            or {
                buf[w] = tmpl[i];
                w      = w + 1;
                i      = i + 1;
            }
        }
        or {
            buf[w] = tmpl[i];
            w      = w + 1;
            i      = i + 1;
        }
    }
    buf[w] = 0;
    ret res[str, outcome.Fail].ok{buf::str};
}

# `expand`, then require the result to satisfy `is_project_path`
# ---
# alloc:       owns the returned string
# tmpl:        the template
# project_out: as `expand`
# v:           the values
# field:       what the template is, for the error text
# ret:         the expanded path; the `expand` errors, or err naming `field` when the
#              result escapes the project root
pub fun expand_project_path(alloc: *A.Allocator, tmpl: str, project_out: str,
    v: *TmplVars, field: str) res[str, outcome.Fail] {
    val res_expanded: res[str, outcome.Fail] = expand(alloc, tmpl, project_out, v);
    if (sel res_expanded.err) { ret res_expanded; }
    val expanded: str = res_expanded.ok;
    if (!is_project_path(expanded)) {
        val msg: str = sfmt(alloc, "mach.toml: {} expands to a path that is not a canonical strict descendant of the project root", field);
        str_free(alloc, expanded);
        ret res[str, outcome.Fail].err{outcome.user(msg)};
    }
    ret res[str, outcome.Fail].ok{expanded};
}

# look an artifact up by name
# ---
# itn:  interns the name
# m:    the manifest
# name: the artifact name
# ret:  the artifact, or nil
pub fun find_artifact(itn: *intern.Interner, m: *Manifest, name: str) *ArtifactDef {
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, name);
    if (sel res_id.err) { ret nil; }
    ret find_artifact_by_name(m, res_id.ok);
}

pub fun find_artifact_by_name(m: *Manifest, name: intern.StrId) *ArtifactDef {
    var i: u32 = 0;
    for (i < m.artifact_count) {
        if (m.artifacts[i].name == name) { ret ?m.artifacts[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun artifact_needs_artifact(itn: *intern.Interner, a: *ArtifactDef, other: *ArtifactDef) bool {
    if (a == other) { ret false; }
    var i: u32 = 0;
    for (i < a.need_count) {
        if (need_matches(idstr(itn, a.need[i]), "artifact", idstr(itn, other.name))) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun expand_artifact_output(alloc: *A.Allocator, itn: *intern.Interner, reg: *tgt.TargetRegistry,
    a: *ArtifactDef, project_out: str, vars: *TmplVars) res[str, outcome.Fail] {
    val text: res[str, outcome.Fail] = must_lookup(itn, a.out);
    if (sel text.err) { ret text; }
    val tmpl: str      = text.ok;
    var v:    TmplVars = @vars;
    if (str_contains(tmpl, "{artifact.suffix}")) {
        val selected: res[tgt.Target, fail.Fail] = tgt.select_of(reg, v.isa, v.os, v.abi, v.format);
        if (sel selected.err) { ret res[str, outcome.Fail].err{outcome.user_fail(selected.err)}; }
        var target: tgt.Target            = selected.ok;
        var kind:   of.ArtifactOutputKind = of.ARTIFACT_EXECUTABLE;
        if (str_equals(idstr(itn, a.kind), "static")) { kind = of.ARTIFACT_STATIC_LIB; }
        or (str_equals(idstr(itn, a.kind), "shared")) { kind = of.ARTIFACT_SHARED_LIB; }
        val named: res[of.ArtifactName, fail.Fail] = tgt.artifact_naming(?target, kind);
        if (sel named.err) { ret res[str, outcome.Fail].err{outcome.user_fail(named.err)}; }
        v.artifact_suffix = named.ok.suffix;
    }
    ret expand_project_path(alloc, tmpl, project_out, ?v, "an artifact output");
}

fun need_cycle_chain(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest,
    stack: *u32, depth: u32, from: u32, target: u32) str {
    var s: str = "";
    var i: u32 = from;
    for (i < depth) {
        if (str_empty(s)) { s = sfmt(alloc, "{}", idstr(itn, m.artifacts[stack[i]].name)); }
        or                { s = sfmt(alloc, "{} -> {}", s, idstr(itn, m.artifacts[stack[i]].name)); }
        i = i + 1;
    }
    ret sfmt(alloc, "{} -> {}", s, idstr(itn, m.artifacts[target].name));
}

fun need_cycle_visit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, idx: u32,
    state: *u8, stack: *u32, depth: u32) err[outcome.Fail] {
    if (state[idx] == 2) { ret err[outcome.Fail].ok{}; }
    state[idx]   = 1;
    stack[depth] = idx;

    val a: *ArtifactDef = ?m.artifacts[idx];
    var j: u32          = 0;
    for (j < m.artifact_count) {
        if (artifact_needs_artifact(itn, a, ?m.artifacts[j])) {
            if (state[j] == 1) {
                var from: u32 = 0;
                for (from <= depth) {
                    if (stack[from] == j) { brk; }
                    from = from + 1;
                }
                if (from > depth) { from = 0; }
                ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: artifact 'need' cycle: {}",
                    need_cycle_chain(alloc, itn, m, stack, depth + 1, from, j)))};
            }
            val vr: err[outcome.Fail] = need_cycle_visit(alloc, itn, m, j, state, stack, depth + 1);
            if (sel vr.err) { ret vr; }
        }
        j = j + 1;
    }
    state[idx] = 2;
    ret err[outcome.Fail].ok{};
}

pub fun validate_need_cycles(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[outcome.Fail] {
    if (m.artifact_count == 0) { ret err[outcome.Fail].ok{}; }

    val sr: res[*u8, A.Error] = A.allocate[u8](alloc, m.artifact_count::usize);
    if (sel sr.err) { ret err[outcome.Fail].err{outcome.refused(sr.err)}; }
    val state: *u8                = sr.ok;
    val kr:    res[*u32, A.Error] = A.allocate[u32](alloc, m.artifact_count::usize);
    if (sel kr.err) {
        A.deallocate[u8](alloc, state, m.artifact_count::usize);
        ret err[outcome.Fail].err{outcome.refused(kr.err)};
    }
    val stack: *u32 = kr.ok;

    var i: u32 = 0;
    for (i < m.artifact_count) {
        state[i] = 0;
        i        = i + 1;
    }

    var result: err[outcome.Fail] = err[outcome.Fail].ok{};
    i = 0;
    for (i < m.artifact_count) {
        result = need_cycle_visit(alloc, itn, m, i, state, stack, 0);
        if (sel result.err) { brk; }
        i = i + 1;
    }
    A.deallocate[u8](alloc, state, m.artifact_count::usize);
    A.deallocate[u32](alloc, stack, m.artifact_count::usize);
    ret result;
}

# whether an artifact's `targets` lists a target name or "*"
# ---
# itn:   interns "*"
# a:     the artifact
# tname: the target name
# ret:   true when listed
pub fun artifact_supports_target(itn: *intern.Interner, a: *ArtifactDef, tname: intern.StrId) bool {
    val star: intern.StrId = intern_unwrap(itn, "*");
    var i:    u32          = 0;
    for (i < a.target_count) {
        if (a.targets[i] == star || a.targets[i] == tname) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun mk_tv(target: str, isa: str, os: str, abi: str, profile: str) TmplVars {
    var v: TmplVars;
    v.target    = target;
    v.isa       = isa;
    v.os        = os;
    v.abi       = abi;
    v.profile   = profile;
    v.reqs      = nil;
    v.req_count = 0;
    ret v;
}

test expand_artifact_path__substitutes_only_the_artifact_vocabulary {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var items: [1]ArtifactReq;
    items[0].name = "shader-a";
    items[0].out  = "out/alt/debug/lib/shader-a.a";

    val ok: res[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.shader-a.out}", ?items[0], 1, "", "an `embed` path");
    if (!(sel ok.ok && str_equals(ok.ok, "out/alt/debug/lib/shader-a.a"))) { code = 1; }

    val plain: res[str, TemplateError] = expand_artifact_path(?alloc, "assets/logo.png", ?items[0], 1, "", "an `embed` path");
    if (!(sel plain.ok && str_equals(plain.ok, "assets/logo.png"))) { code = 1; }

    val other: res[str, TemplateError] = expand_artifact_path(?alloc, "{target.name}/x", ?items[0], 1, "", "an `embed` path");
    if (!(sel other.err && str_contains(template_text(other.err), "only '{artifact.<id>.out}' may appear"))) { code = 1; }

    val missing: res[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.ghost.out}", ?items[0], 1, "", "an `embed` path");
    if (!(sel missing.err && str_contains(template_text(missing.err), "does not require"))) { code = 1; }

    val none_declared: res[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.shader-a.out}", nil, 0, "", "an `embed` path");
    if (!(sel none_declared.err && str_contains(template_text(none_declared.err), "does not require"))) { code = 1; }

    val dependency: res[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.ghost.out}", ?items[0], 1, "shlib", "an `embed` path");
    if (!(sel dependency.err && str_contains(template_text(dependency.err), "no default library artifact of dependency 'shlib' requires"))) { code = 1; }

    val unterminated: res[str, TemplateError] = expand_artifact_path(?alloc, "{artifact.shader-a.out", ?items[0], 1, "", "an `embed` path");
    if (sel unterminated.ok) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test artifact_template_id__names_the_artifact_a_template_resolves_through {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val named: opt[str] = artifact_template_id(?alloc, "{artifact.shader-a.out}");
    if (!(sel named.some && str_equals(named.some, "shader-a"))) { code = 1; }

    val embedded: opt[str] = artifact_template_id(?alloc, "prefix/{artifact.shader-b.out}");
    if (!(sel embedded.some && str_equals(embedded.some, "shader-b"))) { code = 1; }

    val literal: opt[str] = artifact_template_id(?alloc, "assets/logo.png");
    if (sel literal.some) { code = 1; }

    val other: opt[str] = artifact_template_id(?alloc, "{target.name}/x");
    if (sel other.some) { code = 1; }

    val unterminated: opt[str] = artifact_template_id(?alloc, "{artifact.shader-a.out");
    if (sel unterminated.some) { code = 1; }

    val empty_id: opt[str] = artifact_template_id(?alloc, "{artifact..out}");
    if (sel empty_id.some) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test expand__project_out {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    val r1: res[str, outcome.Fail] = expand(?alloc, "{project.out}/obj/x.o", "out/linux/release", ?v);
    if (!(sel r1.ok && str_equals(r1.ok, "out/linux/release/obj/x.o"))) { code = 1; }

    val r2: res[str, outcome.Fail] = expand(?alloc, "{project.out}/x", "", ?v);
    if (!(sel r2.err && str_contains(outcome.describe(r2.err), "not available in [project].out"))) { code = 1; }

    val r3: res[str, outcome.Fail] = expand(?alloc, "{bogus}", "o", ?v);
    if (!(sel r3.err && str_contains(outcome.describe(r3.err), "unknown template variable"))) { code = 1; }

    val r4: res[str, outcome.Fail] = expand(?alloc, "{target.isa}-{target.os}-{target.abi}", "o", ?v);
    if (!(sel r4.ok && str_equals(r4.ok, "x86_64-linux-sysv64"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test expand_step_value__argv_env_bytes {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    val argv_json: res[str, outcome.Fail] = expand_step_value(?alloc, "{\"x\":1}", "out/linux/release", ?v);
    if (!(sel argv_json.ok && str_equals(argv_json.ok, "{\"x\":1}"))) { code = 1; }

    val argv_adjacent: res[str, outcome.Fail] = expand_step_value(?alloc, "pre{target.name}{\"profile\":\"{profile.name}\"}post", "out/linux/release", ?v);
    if (!(sel argv_adjacent.ok && str_equals(argv_adjacent.ok, "prelinux{\"profile\":\"release\"}post"))) { code = 1; }

    val env_value: res[str, outcome.Fail] = expand_step_value(?alloc, "json={\"x\":1};out={project.out};literal={name};open={;close=}", "out/linux/release", ?v);
    if (!(sel env_value.ok && str_equals(env_value.ok, "json={\"x\":1};out=out/linux/release;literal={name};open={;close=}"))) { code = 1; }

    val target_typo: res[str, outcome.Fail] = expand_step_value(?alloc, "{target.nam}", "out", ?v);
    if (!(sel target_typo.err && str_contains(outcome.describe(target_typo.err), "unknown reserved"))) { code = 1; }
    val profile_unclosed: res[str, outcome.Fail] = expand_step_value(?alloc, "{profile.name", "out", ?v);
    if (!(sel profile_unclosed.err && str_contains(outcome.describe(profile_unclosed.err), "unterminated reserved"))) { code = 1; }
    val project_root: res[str, outcome.Fail] = expand_step_value(?alloc, "{project}", "out", ?v);
    if (!(sel project_root.err && str_contains(outcome.describe(project_root.err), "unknown reserved"))) { code = 1; }
    val target_extra: res[str, outcome.Fail] = expand_step_value(?alloc, "{target.name.extra}", "out", ?v);
    if (!(sel target_extra.err && str_contains(outcome.describe(target_extra.err), "unknown reserved"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test expand_project_path__rejects_unsafe_substitutions {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    v.target = "/tmp";
    val absolute: res[str, outcome.Fail] = expand_project_path(?alloc, "{target.name}/app", "out", ?v, "test path");
    if (!(sel absolute.err && str_contains(outcome.describe(absolute.err), "strict descendant"))) { code = 1; }

    v.target = "../escape";
    val parent: res[str, outcome.Fail] = expand_project_path(?alloc, "out/{target.name}/app", "out", ?v, "test path");
    if (!(sel parent.err && str_contains(outcome.describe(parent.err), "strict descendant"))) { code = 1; }

    v.target = "linux//debug";
    val repeated: res[str, outcome.Fail] = expand_project_path(?alloc, "out/{target.name}/app", "out", ?v, "test path");
    if (!(sel repeated.err && str_contains(outcome.describe(repeated.err), "strict descendant"))) { code = 1; }

    v.target = "linux/./debug";
    val dot: res[str, outcome.Fail] = expand_project_path(?alloc, "out/{target.name}/app", "out", ?v, "test path");
    if (!(sel dot.err && str_contains(outcome.describe(dot.err), "strict descendant"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test expand__closed_set {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32      = 0;
    var v:    TmplVars = mk_tv("linux", "x86_64", "linux", "sysv64", "release");

    val ext: res[str, outcome.Fail] = expand(?alloc, "bin/app{ext}", "out", ?v);
    if (!(sel ext.err && str_contains(outcome.describe(ext.err), "unknown template variable"))) { code = 1; }
    val nm: res[str, outcome.Fail] = expand(?alloc, "test/{name}", "out", ?v);
    if (!(sel nm.err && str_contains(outcome.describe(nm.err), "unknown template variable"))) { code = 1; }
    val good: res[str, outcome.Fail] = expand(?alloc, "{project.out}/{target.name}/{profile.name}", "o", ?v);
    if (!(sel good.ok && str_equals(good.ok, "o/linux/release"))) { code = 1; }
    val tup: res[str, outcome.Fail] = expand(?alloc, "{target.isa}/{target.os}/{target.abi}", "o", ?v);
    if (!(sel tup.ok && str_equals(tup.ok, "x86_64/linux/sysv64"))) { code = 1; }
    arena.dnit(?ar);
    ret code;
}

test expand_artifact_path__allocation_failure_is_internal_and_rejection_is_owned {
    var t:      alloc_test.Testing;
    val make_r: err[A.Error] = alloc_test.make(?t);
    if (sel make_r.err) { ret 1; }
    fin { alloc_test.dnit(?t); }
    val alloc: *A.Allocator = alloc_test.allocator_of(?t);
    var items: [1]ArtifactReq;
    items[0].name = "payload";
    items[0].out  = "out/payload.bin";
    alloc_test.fail_at_ordinal(?t, alloc_test.attempt_count(?t) + 1);
    val valid: res[str, TemplateError] = expand_artifact_path(alloc,
        "{artifact.payload.out}", ?items[0], 1, "", "embed");
    if (sel valid.ok) {
        str_free(alloc, valid.ok);
        ret 2;
    }
    val valid_error: TemplateError = valid.err;
    if (!sel valid_error.internal) {
        template_error_dnit(alloc, valid_error);
        ret 3;
    }
    alloc_test.fail_at_ordinal(?t, alloc_test.attempt_count(?t) + 1);
    val refused: res[str, TemplateError] = expand_artifact_path(alloc,
        "{artifact.absent.out}", ?items[0], 1, "", "embed");
    if (sel refused.ok) {
        str_free(alloc, refused.ok);
        ret 4;
    }
    val refused_error: TemplateError = refused.err;
    if (!sel refused_error.internal) {
        template_error_dnit(alloc, refused_error);
        ret 5;
    }
    alloc_test.fail_at_ordinal(?t, 0);
    val rejected: res[str, TemplateError] = expand_artifact_path(alloc,
        "{artifact.absent.out}", ?items[0], 1, "", "embed");
    if (sel rejected.ok) {
        str_free(alloc, rejected.ok);
        ret 6;
    }
    val rejected_error: TemplateError = rejected.err;
    val was_rejected:   bool          = sel rejected_error.rejected;
    template_error_dnit(alloc, rejected_error);
    if (!was_rejected)                                                  { ret 7; }
    if (alloc_test.leaked(?t) || alloc_test.double_free_count(?t) != 0) { ret 8; }
    ret 0;
}

fun t_planner_template_owner(refuse: bool) i32 {
    var t:      alloc_test.Testing;
    val make_r: err[A.Error] = alloc_test.make(?t);
    if (sel make_r.err) { ret 1; }
    fin { alloc_test.dnit(?t); }
    val alloc: *A.Allocator = alloc_test.allocator_of(?t);
    var reqs:  [1]ArtifactReq;
    reqs[0].name = "payload";
    reqs[0].out  = "out/payload.bin";
    var vars: TmplVars = tmpl_vars_of_reqs(?reqs[0], 1);
    var i:    u32      = 0;
    for (i < 2) {
        val before: usize = alloc_test.attempt_count(?t);
        if (refuse) { alloc_test.fail_at_ordinal(?t, before + 1); }
        var result: res[str, outcome.Fail];
        if (i == 0) { result = expand(alloc, "{artifact.payload.out}", "", ?vars); }
        or          { result = expand_step_value(alloc, "{artifact.payload.out}", "", ?vars); }
        if (refuse) {
            if (sel result.ok) {
                str_free(alloc, result.ok);
                ret 2;
            }
            if (!str_equals(outcome.describe(result.err), "out of memory")) { ret 3; }
        }
        or {
            if (sel result.err) { ret 4; }
            val text:    str   = result.ok;
            val correct: bool  = str_equals(text, reqs[0].out);
            val live:    usize = alloc_test.live_count(?t);
            str_free(alloc, text);
            if (!correct)  { ret 5; }
            if (live != 1) { ret 6; }
        }
        if (alloc_test.attempt_count(?t) != before + 1)                                                          { ret 7; }
        if (alloc_test.leaked(?t) || alloc_test.double_free_count(?t) != 0 || alloc_test.tracking_exhausted(?t)) { ret 8; }
        i = i + 1;
    }
    ret 0;
}

test template_lookup__successful_expansion_owns_only_its_output {
    ret t_planner_template_owner(false);
}

test template_lookup__output_allocation_refusal_is_not_overwritten {
    ret t_planner_template_owner(true);
}

test template_lookup__diagnostics_release_temporary_identifiers {
    var t:      alloc_test.Testing;
    val make_r: err[A.Error] = alloc_test.make(?t);
    if (sel make_r.err) { ret 1; }
    fin { alloc_test.dnit(?t); }
    val alloc: *A.Allocator = alloc_test.allocator_of(?t);
    var reqs:  [1]ArtifactReq;
    reqs[0].name = "payload";
    reqs[0].out  = "";
    var vars:      TmplVars = tmpl_vars_of_reqs(?reqs[0], 1);
    var templates: [3]str;
    templates[0] = "{artifact.payload.out}";
    templates[1] = "{artifact.absent.out}";
    templates[2] = "{absent}";
    var i: u32 = 0;
    for (i < 3) {
        val before: usize                  = alloc_test.attempt_count(?t);
        val result: res[str, outcome.Fail] = expand(alloc, templates[i], "", ?vars);
        if (sel result.ok) {
            str_free(alloc, result.ok);
            ret 2;
        }
        val message:     str   = outcome.describe(result.err);
        val names_input: bool  = str_contains(message, templates[i]);
        val live:        usize = alloc_test.live_count(?t);
        str_free(alloc, message);
        if (!names_input || live != 1 || alloc_test.leaked(?t)) { ret 3; }
        val attempts: usize = alloc_test.attempt_count(?t) - before;
        var ordinal:  usize = 1;
        for (ordinal <= attempts) {
            alloc_test.fail_at_ordinal(?t, alloc_test.attempt_count(?t) + ordinal);
            val refused: res[str, outcome.Fail] = expand(alloc, templates[i], "", ?vars);
            if (sel refused.ok) {
                str_free(alloc, refused.ok);
                ret 4;
            }
            val reason: str = outcome.describe(refused.err);
            if (!str_equals(reason, "out of memory")) {
                str_free(alloc, reason);
                ret 5;
            }
            if (alloc_test.leaked(?t) || alloc_test.double_free_count(?t) != 0 || alloc_test.tracking_exhausted(?t)) { ret 6; }
            ordinal = ordinal + 1;
        }
        alloc_test.fail_at_ordinal(?t, 0);
        i = i + 1;
    }
    ret 0;
}
