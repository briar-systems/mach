use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char_is_digit;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

# the version contract a manifest states: semver versions, and ranges
# written as an intersection of clauses that each name their operator. a parsed value
# borrows its pre-release text from the string it was parsed from

pub rec Version {
    major:   u64;
    minor:   u64;
    patch:   u64;
    pre:     *u8;
    pre_len: usize;
}

val MAX_RANGE_CLAUSES: u32 = 16;

# one closed or open end of the interval a range denotes
rec Bound {
    set:       bool;
    at:        Version;
    inclusive: bool;
}

# every clause narrows one interval, so a range is an interval plus the
# releases whose pre-releases it names
pub rec Range {
    lower:     Bound;
    upper:     Bound;
    empty:     bool;
    pre_named: [MAX_RANGE_CLAUSES]Version;
    pre_count: u32;
}

pub rec RangeError {
    reason: str;
    clause: u32;
}

def ClauseOp: u8;
val OP_CARET: ClauseOp = 0;
val OP_TILDE: ClauseOp = 1;
val OP_GE:    ClauseOp = 2;
val OP_GT:    ClauseOp = 3;
val OP_LE:    ClauseOp = 4;
val OP_LT:    ClauseOp = 5;
val OP_EQ:    ClauseOp = 6;

rec Cursor {
    text: str;
    len:  usize;
    at:   usize;
}

fun peek(c: *Cursor) u8 {
    if (c.at >= c.len) { ret 0; }
    ret c.text[c.at];
}

fun is_ident_byte(b: u8) bool {
    ret char_is_digit(b) || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '-';
}

fun skip_spaces(c: *Cursor) {
    for (peek(c) == ' ') { c.at = c.at + 1; }
}

# "0" or a digit run without a leading zero, within u64
fun number(c: *Cursor, out: *u64) opt[str] {
    if (!char_is_digit(peek(c))) { ret opt[str].some{"expected a number"}; }
    val start: usize = c.at;
    var value: u64   = 0;
    for (char_is_digit(peek(c))) {
        val d: u64 = (peek(c) - '0')::u64;
        if (value > (0xFFFFFFFFFFFFFFFF - d) / 10) { ret opt[str].some{"a version component does not fit in 64 bits"}; }
        value = value * 10 + d;
        c.at  = c.at + 1;
    }
    if (c.text[start] == '0' && c.at - start > 1) { ret opt[str].some{"a version component has a leading zero"}; }
    @out = value;
    ret opt[str].none{};
}

# dot-separated identifiers of [0-9A-Za-z-], none empty, numeric ones without a leading zero
fun pre_release(c: *Cursor, v: *Version) opt[str] {
    val start: usize = c.at;
    for (true) {
        val id_start: usize = c.at;
        var numeric:  bool  = true;
        for (is_ident_byte(peek(c))) {
            if (!char_is_digit(peek(c))) { numeric = false; }
            c.at = c.at + 1;
        }
        if (c.at == id_start)                                          { ret opt[str].some{"a pre-release identifier is empty"}; }
        if (numeric && c.text[id_start] == '0' && c.at - id_start > 1) { ret opt[str].some{"a numeric pre-release identifier has a leading zero"}; }
        if (peek(c) != '.')                                            { brk; }
        c.at = c.at + 1;
    }
    v.pre     = ?c.text[start];
    v.pre_len = c.at - start;
    ret opt[str].none{};
}

# dot-separated identifiers of [0-9A-Za-z-], none empty; precedence never reads them
fun build_metadata(c: *Cursor) opt[str] {
    for (true) {
        val id_start: usize = c.at;
        for (is_ident_byte(peek(c))) { c.at = c.at + 1; }
        if (c.at == id_start) { ret opt[str].some{"a build metadata identifier is empty"}; }
        if (peek(c) != '.')   { brk; }
        c.at = c.at + 1;
    }
    ret opt[str].none{};
}

# major[.minor[.patch[-pre]]]; parts is how many numeric components were written
fun partial(c: *Cursor, v: *Version, parts: *u32) opt[str] {
    v.major   = 0;
    v.minor   = 0;
    v.patch   = 0;
    v.pre     = nil;
    v.pre_len = 0;
    val opt_major_refused: opt[str] = number(c, ?v.major);
    if (sel opt_major_refused.some) { ret opt_major_refused; }
    @parts = 1;
    if (peek(c) == '.') {
        c.at = c.at + 1;
        val opt_minor_refused: opt[str] = number(c, ?v.minor);
        if (sel opt_minor_refused.some) { ret opt_minor_refused; }
        @parts = 2;
        if (peek(c) == '.') {
            c.at = c.at + 1;
            val opt_patch_refused: opt[str] = number(c, ?v.patch);
            if (sel opt_patch_refused.some) { ret opt_patch_refused; }
            @parts = 3;
            if (peek(c) == '-') {
                c.at = c.at + 1;
                val opt_pre_release_refused: opt[str] = pre_release(c, v);
                if (sel opt_pre_release_refused.some) { ret opt_pre_release_refused; }
            }
        }
    }
    if (peek(c) == '+') { ret opt[str].some{"build metadata is not allowed in a range"}; }
    if (peek(c) == '-') { ret opt[str].some{"a pre-release needs all three version components"}; }
    ret opt[str].none{};
}

# a full version, as a tag or a manifest names one; build metadata is ignored
pub fun parse_version(text: str) res[Version, str] {
    var c:                 Cursor   = Cursor{text: text, len: str_len(text), at: 0};
    var v:                 Version;
    var parts:             u32      = 0;
    val opt_major_refused: opt[str] = number(?c, ?v.major);
    if (sel opt_major_refused.some) { ret res[Version, str].err{opt_major_refused.some}; }
    if (peek(?c) != '.')            { ret res[Version, str].err{"a version needs major.minor.patch"}; }
    c.at = c.at + 1;
    val opt_minor_refused: opt[str] = number(?c, ?v.minor);
    if (sel opt_minor_refused.some) { ret res[Version, str].err{opt_minor_refused.some}; }
    if (peek(?c) != '.')            { ret res[Version, str].err{"a version needs major.minor.patch"}; }
    c.at = c.at + 1;
    val opt_patch_refused: opt[str] = number(?c, ?v.patch);
    if (sel opt_patch_refused.some) { ret res[Version, str].err{opt_patch_refused.some}; }
    v.pre     = nil;
    v.pre_len = 0;
    if (peek(?c) == '-') {
        c.at = c.at + 1;
        val opt_pre_release_refused: opt[str] = pre_release(?c, ?v);
        if (sel opt_pre_release_refused.some) { ret res[Version, str].err{opt_pre_release_refused.some}; }
    }
    if (peek(?c) == '+') {
        c.at = c.at + 1;
        val opt_build_metadata_refused: opt[str] = build_metadata(?c);
        if (sel opt_build_metadata_refused.some) { ret res[Version, str].err{opt_build_metadata_refused.some}; }
    }
    if (c.at != c.len) { ret res[Version, str].err{"unexpected text after the version"}; }
    ret res[Version, str].ok{v};
}

fun cmp_u64(a: u64, b: u64) i32 {
    if (a < b) { ret -1; }
    if (a > b) { ret 1; }
    ret 0;
}

fun ident_len(p: *u8, n: usize, from: usize) usize {
    var i: usize = from;
    for (i < n && p[i] != '.') { i = i + 1; }
    ret i - from;
}

fun all_digits(p: *u8, from: usize, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (!char_is_digit(p[from + i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# semver 2.0.0 precedence: a pre-release sorts below its release, identifiers
# compare numerically when both are numeric, numeric ones sort below the rest, and
# a longer list wins a shared prefix
fun cmp_pre(a: *Version, b: *Version) i32 {
    if (a.pre_len == 0 && b.pre_len == 0) { ret 0; }
    if (a.pre_len == 0)                   { ret 1; }
    if (b.pre_len == 0)                   { ret -1; }
    var ia: usize = 0;
    var ib: usize = 0;
    for (ia < a.pre_len && ib < b.pre_len) {
        val la: usize = ident_len(a.pre, a.pre_len, ia);
        val lb: usize = ident_len(b.pre, b.pre_len, ib);
        val na: bool  = all_digits(a.pre, ia, la);
        val nb: bool  = all_digits(b.pre, ib, lb);
        if (na && nb) {
            if (la != lb) {
                if (la < lb) { ret -1; }
                ret 1;
            }
        }
        or (na) { ret -1; }
        or (nb) { ret 1; }
        var k: usize = 0;
        for (k < la && k < lb) {
            val ca: u8 = a.pre[ia + k];
            val cb: u8 = b.pre[ib + k];
            if (ca != cb) {
                if (ca < cb) { ret -1; }
                ret 1;
            }
            k = k + 1;
        }
        if (la != lb) {
            if (la < lb) { ret -1; }
            ret 1;
        }
        ia = ia + la + 1;
        ib = ib + lb + 1;
    }
    if (ia >= a.pre_len && ib >= b.pre_len) { ret 0; }
    if (ia >= a.pre_len)                    { ret -1; }
    ret 1;
}

pub fun compare(a: *Version, b: *Version) i32 {
    val m: i32 = cmp_u64(a.major, b.major);
    if (m != 0) { ret m; }
    val n: i32 = cmp_u64(a.minor, b.minor);
    if (n != 0) { ret n; }
    val p: i32 = cmp_u64(a.patch, b.patch);
    if (p != 0) { ret p; }
    ret cmp_pre(a, b);
}

fun release(major: u64, minor: u64, patch: u64) Version {
    ret Version{major: major, minor: minor, patch: patch, pre: nil, pre_len: 0};
}

fun tighten_lower(r: *Range, at: Version, inclusive: bool) {
    if (r.lower.set) {
        var cur: Version = r.lower.at;
        var nxt: Version = at;
        val c:   i32     = compare(?nxt, ?cur);
        if (c < 0)                                       { ret; }
        if (c == 0 && (inclusive || !r.lower.inclusive)) { ret; }
    }
    r.lower = Bound{set: true, at: at, inclusive: inclusive};
}

fun tighten_upper(r: *Range, at: Version, inclusive: bool) {
    if (r.upper.set) {
        var cur: Version = r.upper.at;
        var nxt: Version = at;
        val c:   i32     = compare(?nxt, ?cur);
        if (c > 0)                                       { ret; }
        if (c == 0 && (inclusive || !r.upper.inclusive)) { ret; }
    }
    r.upper = Bound{set: true, at: at, inclusive: inclusive};
}

val U64_MAX: u64 = 0xFFFFFFFFFFFFFFFF;

# the exclusive end past a caret or tilde; none when the component is already the largest,
# so the range has no upper end
fun caret_upper(v: *Version, parts: u32) opt[Version] {
    if (v.major > 0 || parts == 1) {
        if (v.major == U64_MAX) { ret opt[Version].none{}; }
        ret opt[Version].some{release(v.major + 1, 0, 0)};
    }
    if (v.minor > 0 || parts == 2) {
        if (v.minor == U64_MAX) { ret opt[Version].some{release(1, 0, 0)}; }
        ret opt[Version].some{release(0, v.minor + 1, 0)};
    }
    if (v.patch == U64_MAX) { ret opt[Version].some{release(0, 1, 0)}; }
    ret opt[Version].some{release(0, 0, v.patch + 1)};
}

fun tilde_upper(v: *Version, parts: u32) opt[Version] {
    if (parts == 1 || v.minor == U64_MAX) {
        if (v.major == U64_MAX) { ret opt[Version].none{}; }
        ret opt[Version].some{release(v.major + 1, 0, 0)};
    }
    ret opt[Version].some{release(v.major, v.minor + 1, 0)};
}

fun operator(c: *Cursor, op: *ClauseOp) bool {
    val b: u8 = peek(c);
    if (b == '^') {
        @op  = OP_CARET;
        c.at = c.at + 1;
        ret true;
    }
    if (b == '~') {
        @op  = OP_TILDE;
        c.at = c.at + 1;
        ret true;
    }
    if (b == '=') {
        @op  = OP_EQ;
        c.at = c.at + 1;
        ret true;
    }
    if (b == '>' || b == '<') {
        c.at = c.at + 1;
        var or_equal: bool = false;
        if (peek(c) == '=') {
            or_equal = true;
            c.at     = c.at + 1;
        }
        if (b == '>') {
            if (or_equal) { @op = OP_GE; }
            or            { @op = OP_GT; }
        }
        or {
            if (or_equal) { @op = OP_LE; }
            or            { @op = OP_LT; }
        }
        ret true;
    }
    ret false;
}

fun range_error(reason: str, clause: u32) res[Range, RangeError] {
    ret res[Range, RangeError].err{RangeError{reason: reason, clause: clause}};
}

# clause is 1-based in an error; a missing component of a partial version is 0
pub fun parse_range(text: str) res[Range, RangeError] {
    var r: Range;
    r.lower.set = false;
    r.upper.set = false;
    r.empty     = false;
    r.pre_count = 0;
    var c:      Cursor = Cursor{text: text, len: str_len(text), at: 0};
    var clause: u32    = 0;
    if (c.len == 0) { ret range_error("a range is empty", 1); }
    for (true) {
        clause = clause + 1;
        if (clause > MAX_RANGE_CLAUSES) { ret range_error("a range has more than 16 clauses", clause); }
        var op: ClauseOp = OP_CARET;
        if (!operator(?c, ?op)) {
            if (char_is_digit(peek(?c))) { ret range_error("a clause needs an operator, such as ^1.2 or >=1.2", clause); }
            if (peek(?c) == '*')         { ret range_error("`*` is not a range", clause); }
            if (peek(?c) == '|')         { ret range_error("`||` is not supported; a range is the intersection of its clauses", clause); }
            ret range_error("a clause starts with one of ^ ~ >= > <= < =", clause);
        }
        skip_spaces(?c);
        var v:       Version;
        var parts:   u32      = 0;
        val opt_bad: opt[str] = partial(?c, ?v, ?parts);
        if (sel opt_bad.some)          { ret range_error(opt_bad.some, clause); }
        if (op == OP_EQ && parts != 3) { ret range_error("`=` needs major.minor.patch", clause); }
        if (v.pre_len > 0) {
            r.pre_named[r.pre_count] = release(v.major, v.minor, v.patch);
            r.pre_count              = r.pre_count + 1;
        }
        if (op == OP_CARET) {
            tighten_lower(?r, v, true);
            val opt_caret_upper: opt[Version] = caret_upper(?v, parts);
            if (sel opt_caret_upper.some) { tighten_upper(?r, opt_caret_upper.some, false); }
        }
        or (op == OP_TILDE) {
            tighten_lower(?r, v, true);
            val opt_tilde_upper: opt[Version] = tilde_upper(?v, parts);
            if (sel opt_tilde_upper.some) { tighten_upper(?r, opt_tilde_upper.some, false); }
        }
        or (op == OP_GE) { tighten_lower(?r, v, true); }
        or (op == OP_GT) { tighten_lower(?r, v, false); }
        or (op == OP_LE) { tighten_upper(?r, v, true); }
        or (op == OP_LT) { tighten_upper(?r, v, false); }
        or {
            tighten_lower(?r, v, true);
            tighten_upper(?r, v, true);
        }
        skip_spaces(?c);
        if (c.at == c.len)   { brk; }
        if (peek(?c) == '|') { ret range_error("`||` is not supported; a range is the intersection of its clauses", clause); }
        if (peek(?c) != ',') { ret range_error("clauses are separated by `,`", clause); }
        c.at = c.at + 1;
        skip_spaces(?c);
        if (c.at == c.len) { ret range_error("a range ends with `,`", clause + 1); }
    }
    if (c.text[0] == ' ' || c.text[c.len - 1] == ' ') { ret range_error("a range has leading or trailing spaces", 1); }
    if (r.lower.set && r.upper.set) {
        val order: i32 = compare(?r.lower.at, ?r.upper.at);
        if (order > 0 || (order == 0 && !(r.lower.inclusive && r.upper.inclusive))) { r.empty = true; }
    }
    ret res[Range, RangeError].ok{r};
}

fun names_pre_of(r: *Range, v: *Version) bool {
    var i: u32 = 0;
    for (i < r.pre_count) {
        val b: *Version = ?r.pre_named[i];
        if (b.major == v.major && b.minor == v.minor && b.patch == v.patch) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a pre-release satisfies a range only when a clause names a pre-release of that release
pub fun satisfies(r: *Range, v: *Version) bool {
    if (r.empty)                              { ret false; }
    if (v.pre_len > 0 && !names_pre_of(r, v)) { ret false; }
    if (r.lower.set) {
        val c: i32 = compare(v, ?r.lower.at);
        if (c < 0 || (c == 0 && !r.lower.inclusive)) { ret false; }
    }
    if (r.upper.set) {
        val c: i32 = compare(v, ?r.upper.at);
        if (c > 0 || (c == 0 && !r.upper.inclusive)) { ret false; }
    }
    ret true;
}
