use mach.lang.build.outcome;
use std.allocator.arena;
use std.allocator.page;
use std.data.toml;
use std.format;
use std.system.panic.panic;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_contains_char;
use std.types.string.str_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use mach.lang.intern;

fun nul_escape_at(src: *u8, i: usize, n: usize) bool {
    if (i + 5 < n && src[i] == '\\' && src[i + 1] == 'u') {
        ret src[i + 2] == '0' && src[i + 3] == '0' && src[i + 4] == '0' && src[i + 5] == '0';
    }
    if (i + 9 < n && src[i] == '\\' && src[i + 1] == 'U') {
        var j: usize = i + 2;
        for (j < i + 10) {
            if (src[j] != '0') { ret false; }
            j = j + 1;
        }
        ret true;
    }
    ret false;
}

# reject manifest text that would carry a NUL byte into the TOML parser
# ---
# src: manifest bytes, not required to be NUL-terminated
# n:   number of bytes to scan
# ret: ok when clean; err "mach.toml: source cannot contain NUL bytes" for a raw
#      0 byte anywhere, or "mach.toml: strings cannot contain NUL bytes" for a
#      `\u0000` or `\U00000000` escape inside a basic (double-quoted) string,
#      single-line or multi-line. comments and literal (single-quoted) strings are
#      skipped without escape checks
pub fun validate_source_bytes(src: *u8, n: usize) err[outcome.Fail] {
    var i: usize = 0;
    for (i < n) {
        if (src[i] == 0) { ret err[outcome.Fail].err{outcome.user("mach.toml: source cannot contain NUL bytes")}; }
        i = i + 1;
    }
    i = 0;
    var mode:      u8   = 0;
    var multiline: bool = false;
    for (i < n) {
        val c: u8 = src[i];
        if (mode == 0) {
            if (c == '#') {
                for (i < n && src[i] != '\n') { i = i + 1; }
                cnt;
            }
            if (c == '"') {
                mode      = 1;
                multiline = i + 2 < n && src[i + 1] == '"' && src[i + 2] == '"';
                if (multiline) { i = i + 3; }
                or             { i = i + 1; }
                cnt;
            }
            if (c == '\'') {
                mode      = 2;
                multiline = i + 2 < n && src[i + 1] == '\'' && src[i + 2] == '\'';
                if (multiline) { i = i + 3; }
                or             { i = i + 1; }
                cnt;
            }
            i = i + 1;
            cnt;
        }
        if (mode == 1) {
            if (c == '\\') {
                if (nul_escape_at(src, i, n)) { ret err[outcome.Fail].err{outcome.user("mach.toml: strings cannot contain NUL bytes")}; }
                i = i + 2;
                cnt;
            }
            if (c == '"') {
                var quote_end: usize = i;
                for (multiline && quote_end < n && src[quote_end] == '"') { quote_end = quote_end + 1; }
                if (multiline && quote_end - i >= 3) {
                    mode      = 0;
                    multiline = false;
                    i         = quote_end;
                    cnt;
                }
                if (!multiline) {
                    mode = 0;
                    i    = i + 1;
                    cnt;
                }
            }
            i = i + 1;
            cnt;
        }
        if (c == '\'' && multiline) {
            var quote_end: usize = i;
            for (quote_end < n && src[quote_end] == '\'') { quote_end = quote_end + 1; }
            if (quote_end - i >= 3) {
                mode      = 0;
                multiline = false;
                i         = quote_end;
                cnt;
            }
        }
        if (c == '\'' && !multiline) {
            mode = 0;
            i    = i + 1;
            cnt;
        }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

# `validate_source_bytes` over a NUL-terminated string
# ---
# src: manifest text
# ret: as `validate_source_bytes`
pub fun validate_source_text(src: str) err[outcome.Fail] {
    ret validate_source_bytes(src::*u8, str_len(src));
}

pub rec StrArr {
    items:   *intern.StrId;
    count:   u32;
    present: bool;
}

# an sfmt result is owned and freed by its receiver; a formatting oom has nothing owned to hand back
pub fun sfmt(alloc: *A.Allocator, fmt: str, va: ...) str {
    val r: res[str, format.FormatError] = format.sprint(alloc, fmt, va...);
    if (sel r.ok) { ret r.ok; }
    panic("mach.toml: out of memory while formatting a diagnostic\n");
    ret "";
}

# whether `s` is a portable identifier: non-empty, only ASCII letters, digits,
# '_' and '-'. the rule for project, target, artifact, profile, dependency,
# link and step names
# ---
# s:   the candidate
# ret: true when every byte is allowed
pub fun is_valid_id(s: str) bool {
    if (str_empty(s)) { ret false; }
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (!((c >= 'A' && c <= 'Z')
            || (c >= 'a' && c <= 'z')
            || (c >= '0' && c <= '9')
            || c == '_' || c == '-')) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a string key as the manifest reads it: absent and empty are the same err
# (`is missing required key`), so both read as the empty string
pub fun key_text(t: *toml.Table, key: str) str {
    val s: opt[str] = toml.get_str(t, key);
    if (sel s.some) { ret s.some; }
    ret "";
}

pub fun intern_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, text);
    if (sel res_id.err) { ret intern.STR_NIL; }
    ret res_id.ok;
}

pub fun intern_opt_unwrap(itn: *intern.Interner, text: str) intern.StrId {
    if (str_empty(text)) { ret intern.STR_NIL; }
    ret intern_unwrap(itn, text);
}

pub fun parse_str_array(alloc: *A.Allocator, itn: *intern.Interner, arr: *toml.Array,
    label: str, key: str, allow_scalar: bool) res[StrArr, outcome.Fail] {
    var out: StrArr;
    out.items   = nil;
    out.count   = 0;
    out.present = arr != nil;
    if (arr == nil) { ret res[StrArr, outcome.Fail].ok{out}; }

    val n: usize = toml.array_len(arr);
    if (n == 0) { ret res[StrArr, outcome.Fail].ok{out}; }
    if (n > 0xFFFFFFFF::usize) {
        ret res[StrArr, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {}.{} has too many entries", label, key))};
    }

    val res_items: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, n);
    if (sel res_items.err) { ret res[StrArr, outcome.Fail].err{outcome.refused(res_items.err)}; }
    out.items = res_items.ok;
    out.count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val v_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel v_o.none) { brk; }
        val v: *toml.Value = v_o.some;
        if (v.tag != toml.TYPE_STRING) {
            A.deallocate[intern.StrId](alloc, out.items, n);
            if (allow_scalar) {
                ret res[StrArr, outcome.Fail].err{outcome.user(sfmt(alloc,
                    "mach.toml: {}.{} must be a string or array of strings", label, key))};
            }
            ret res[StrArr, outcome.Fail].err{outcome.user(sfmt(alloc,
                "mach.toml: {}.{} must be an array of strings", label, key))};
        }
        val res_elem: res[intern.StrId, A.Error] = intern.intern(itn, v.data.string);
        if (sel res_elem.err) {
            A.deallocate[intern.StrId](alloc, out.items, n);
            ret res[StrArr, outcome.Fail].err{outcome.refused(res_elem.err)};
        }
        out.items[i] = res_elem.ok;
        i            = i + 1;
    }
    ret res[StrArr, outcome.Fail].ok{out};
}

pub fun opt_value_text(alloc: *A.Allocator, v: *toml.Value) str {
    if (v.tag == toml.TYPE_INTEGER) { ret int_to_str(alloc, v.data.integer); }
    if (v.tag == toml.TYPE_STRING)  { ret sfmt(alloc, "\"{}\"", v.data.string); }
    if (v.tag == toml.TYPE_BOOL) {
        if (v.data.boolean) { ret "true"; }
        ret "false";
    }
    if (v.tag == toml.TYPE_FLOAT) { ret "a float"; }
    if (v.tag == toml.TYPE_ARRAY) { ret "an array"; }
    if (v.tag == toml.TYPE_TABLE) { ret "a table"; }
    ret "a value";
}

pub fun parse_default_flag(alloc: *A.Allocator, table: str, name: str, sub: *toml.Table) res[bool, outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "default");
    if (sel v_o.none) { ret res[bool, outcome.Fail].ok{false}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_BOOL) { ret res[bool, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} '{}': default must be a boolean (got {})", table, name, opt_value_text(alloc, v)))}; }
    ret res[bool, outcome.Fail].ok{v.data.boolean};
}

pub rec DefaultTables {
    count: usize;
    names: str;
}

pub fun default_tables_init() DefaultTables {
    var d: DefaultTables;
    d.count = 0;
    d.names = "";
    ret d;
}

pub fun default_tables_note(alloc: *A.Allocator, d: *DefaultTables, label: str) {
    if (d.count == 0) { d.names = sfmt(alloc, "{}", label); }
    or {
        val joined: str = sfmt(alloc, "{}, {}", d.names, label);
        str_free(alloc, d.names);
        d.names = joined;
    }
    d.count = d.count + 1;
}

pub fun default_tables_dnit(alloc: *A.Allocator, d: *DefaultTables) {
    if (d.count != 0) { str_free(alloc, d.names); }
    d.count = 0;
    d.names = "";
}

pub fun duplicate_default_err(alloc: *A.Allocator, kind: str, d: *DefaultTables) str {
    ret sfmt(alloc, "mach.toml: {} {}s declare `default = true` ({}); exactly one is allowed",
        d.count, kind, d.names);
}

fun int_to_str(alloc: *A.Allocator, n: i64) str {
    if (n == 0) { ret "0"; }
    var neg: bool = false;
    var u:   u64  = n::u64;
    if (n < 0) {
        neg = true;
        u   = (0 - n)::u64;
    }

    var digits: [24]char;
    var len:    usize = 0;
    for (u > 0) {
        digits[len] = (u % 10)::char + '0';
        u           = u / 10;
        len         = len + 1;
    }

    var total: usize = len;
    if (neg) { total = total + 1; }
    val res_buf: res[*u8, A.Error] = A.allocate[u8](alloc, total + 1);
    if (sel res_buf.err) { ret "?"; }
    val buf: *u8   = res_buf.ok;
    var w:   usize = 0;
    if (neg) {
        buf[0] = '-';
        w      = 1;
    }
    var i: usize = len;
    for (i > 0) {
        i      = i - 1;
        buf[w] = digits[i]::u8;
        w      = w + 1;
    }
    buf[w] = 0;
    ret buf::str;
}

fun unknown_key_msg(alloc: *A.Allocator, key: str, label: str) str {
    ret sfmt(alloc, "mach.toml: unknown key '{}' in {}", key, label);
}

# refuse the first key of a table that its section's `known` predicate does not admit
pub fun check_keys(alloc: *A.Allocator, tab: *toml.Table, label: str, known: fun(str) bool) err[outcome.Fail] {
    val n: usize = toml.table_len(tab);
    var i: usize = 0;
    for (i < n) {
        val k_o: opt[str] = toml.table_key(tab, i);
        if (sel k_o.none) { brk; }
        val k: str = k_o.some;
        if (!known(k)) { ret err[outcome.Fail].err{outcome.user(unknown_key_msg(alloc, k, label))}; }
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

def ProjectPathViolation: u8;
val PPV_NONE:      ProjectPathViolation = 0;
val PPV_EMPTY:     ProjectPathViolation = 1;
val PPV_BACKSLASH: ProjectPathViolation = 2;
val PPV_ABSOLUTE:  ProjectPathViolation = 3;
val PPV_DRIVE:     ProjectPathViolation = 4;
val PPV_COMPONENT: ProjectPathViolation = 5;
val PPV_DOT:       ProjectPathViolation = 6;

fun project_path_violation(value: str) ProjectPathViolation {
    if (str_contains_char(value, '\\')) { ret PPV_BACKSLASH; }
    val n: usize = str_len(value);
    if (n == 0)          { ret PPV_EMPTY; }
    if (value[0] == '/') { ret PPV_ABSOLUTE; }
    if (n >= 2 && ((value[0] >= 'A' && value[0] <= 'Z') || (value[0] >= 'a' && value[0] <= 'z')) && value[1] == ':') {
        ret PPV_DRIVE;
    }
    var start: usize = 0;
    var i:     usize = 0;
    for (i <= n) {
        if (i == n || value[i] == '/') {
            val len: usize = i - start;
            if (len == 0) { ret PPV_COMPONENT; }
            if ((len == 1 && value[start] == '.')
                || (len == 2 && value[start] == '.' && value[start + 1] == '.')) {
                ret PPV_DOT;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    ret PPV_NONE;
}

# whether `value` is a canonical strict descendant of the project root: non-empty,
# '/'-separated, no '\', not absolute, no drive letter, no empty component, no
# '.' or '..' component
# ---
# value: the candidate path
# ret:   true when every rule holds
pub fun is_project_path(value: str) bool {
    ret project_path_violation(value) == PPV_NONE;
}

pub fun check_path(alloc: *A.Allocator, value: str, field: str) err[outcome.Fail] {
    val violation: ProjectPathViolation = project_path_violation(value);
    if (violation == PPV_BACKSLASH) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} contains a '\\\\'; manifest paths use '/'", field))};
    }
    if (violation == PPV_EMPTY) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} must be a non-empty project-relative path", field))};
    }
    if (violation == PPV_ABSOLUTE) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} must be relative to the project root", field))};
    }
    if (violation == PPV_DRIVE) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} must not use an absolute drive path", field))};
    }
    if (violation == PPV_COMPONENT) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} contains an empty path component", field))};
    }
    if (violation == PPV_DOT) {
        ret err[outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml: {} must not contain '.' or '..' path components", field))};
    }
    ret err[outcome.Fail].ok{};
}

pub fun free_strarr(alloc: *A.Allocator, items: *intern.StrId, count: u32) {
    if (items != nil && count > 0) {
        A.deallocate[intern.StrId](alloc, items, count::usize);
    }
}

pub fun must_lookup(itn: *intern.Interner, id: intern.StrId) res[str, outcome.Fail] {
    val opt_str: opt[str] = intern.lookup(itn, id);
    if (sel opt_str.none) { ret res[str, outcome.Fail].err{outcome.user("internal: manifest StrId not interned")}; }
    ret res[str, outcome.Fail].ok{opt_str.some};
}

pub fun is_glob(s: str) bool {
    ret str_contains_char(s, '*');
}

pub fun glob_matches(pat: str, name: str) bool {
    val pn:   usize = str_len(pat);
    val nn:   usize = str_len(name);
    var pi:   usize = 0;
    var ni:   usize = 0;
    var star: usize = pn;
    var mark: usize = 0;
    for (ni < nn) {
        if (pi < pn && pat[pi] == '*') {
            star = pi;
            mark = ni;
            pi   = pi + 1;
            cnt;
        }
        if (pi < pn && pat[pi] == name[ni]) {
            pi = pi + 1;
            ni = ni + 1;
            cnt;
        }
        if (star < pn) {
            mark = mark + 1;
            ni   = mark;
            pi   = star + 1;
            cnt;
        }
        ret false;
    }
    for (pi < pn && pat[pi] == '*') { pi = pi + 1; }
    ret pi == pn;
}

fun need_pattern_valid(s: str) bool {
    if (str_empty(s)) { ret false; }
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (!((c >= 'A' && c <= 'Z')
            || (c >= 'a' && c <= 'z')
            || (c >= '0' && c <= '9')
            || c == '_' || c == '-' || c == '*')) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun need_pattern(entry: str, category: str) str {
    val n: usize = str_len(category);
    if (!str_starts_with(entry, category) || entry[n] != '.') { ret nil; }
    val pattern: str = ?entry[n + 1];
    if (!need_pattern_valid(pattern)) { ret nil; }
    ret pattern;
}

pub fun need_matches(entry: str, category: str, name: str) bool {
    val pattern: str = need_pattern(entry, category);
    ret pattern != nil && glob_matches(pattern, name);
}

pub fun idstr(itn: *intern.Interner, id: intern.StrId) str {
    val found: opt[str] = intern.lookup(itn, id);
    if (sel found.some) { ret found.some; }
    ret "?";
}

pub fun tinit(backing: *A.Allocator, ar: *arena.Arena, alloc: *A.Allocator, itn: *intern.Interner) bool {
    val make_r: err[A.Error] = page.make(backing);
    if (sel make_r.err) { ret false; }
    val init_r: err[A.Error] = arena.init(ar, backing, 0);
    if (sel init_r.err) { ret false; }
    val make_r2: err[A.Error] = arena.make(alloc, ar);
    if (sel make_r2.err) { ret false; }
    @itn = intern.init(alloc);
    ret true;
}

pub rec PlanAllocProbe {
    backing:  A.Allocator;
    live:     i64;
    calls:    u32;
    fail_at:  u32;
    ptrs:     [4]ptr;
    sizes:    [4]usize;
    mismatch: bool;
}

fun plan_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val allocated: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel allocated.none) { ret allocated; }
    val item: ptr   = allocated.some;
    var i:    usize = 0;
    for (i < 4 && p.ptrs[i] != nil) { i = i + 1; }
    if (i == 4) { p.mismatch = true; }
    or {
        p.ptrs[i]  = item;
        p.sizes[i] = size;
    }
    p.live = p.live + size::i64;
    ret allocated;
}

fun plan_probe_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    p.mismatch = true;
    ret opt[ptr].none{};
}

fun plan_probe_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *PlanAllocProbe = ctx::*PlanAllocProbe;
    var i: usize           = 0;
    for (i < 4 && p.ptrs[i] != item) { i = i + 1; }
    if (i == 4) {
        p.mismatch = true;
        ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
    }
    if (p.sizes[i] != size) { p.mismatch = true; }
    p.live     = p.live - p.sizes[i]::i64;
    p.ptrs[i]  = nil;
    p.sizes[i] = 0;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

pub fun plan_probe_make(p: *PlanAllocProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val make_r: err[A.Error] = page.make(?p.backing);
    if (sel make_r.err) { ret false; }
    p.live     = 0;
    p.calls    = 0;
    p.fail_at  = fail_at;
    p.mismatch = false;
    var i: usize = 0;
    for (i < 4) {
        p.ptrs[i]  = nil;
        p.sizes[i] = 0;
        i          = i + 1;
    }
    val probe: *PlanAllocProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = plan_probe_allocate;
    alloc.fn_reallocate = plan_probe_reallocate;
    alloc.fn_deallocate = plan_probe_deallocate;
    ret true;
}

test "mach.lang.manifest.is_valid_id" {
    var code: i32 = 0;
    if (!is_valid_id("foo"))    { code = 1; }
    if (!is_valid_id("my_app")) { code = 1; }
    if (!is_valid_id("my-app")) { code = 1; }
    if (!is_valid_id("Proj2"))  { code = 1; }
    if (!is_valid_id("9"))      { code = 1; }
    if (is_valid_id(""))        { code = 1; }
    if (is_valid_id("."))       { code = 1; }
    if (is_valid_id(".."))      { code = 1; }
    if (is_valid_id("foo/bar")) { code = 1; }
    if (is_valid_id("foo.bar")) { code = 1; }
    if (is_valid_id("a b"))     { code = 1; }
    ret code;
}

test "mach.lang.manifest.validate_source_bytes:raw_nul_in_comment" {
    var src: [12]u8;
    src[0]  = '#';
    src[1]  = ' ';
    src[2]  = 'n';
    src[3]  = 'o';
    src[4]  = 't';
    src[5]  = 'e';
    src[6]  = 0;
    src[7]  = '\n';
    src[8]  = 'x';
    src[9]  = '=';
    src[10] = '1';
    src[11] = '\n';
    val r: err[outcome.Fail] = validate_source_bytes(?src[0], 12);
    if (sel r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.validate_source_bytes:multiline_four_quote_terminator" {
    val safe: err[outcome.Fail] = validate_source_text("value = \"\"\"safe\"\"\"\"\nnext = \"text\"\n");
    if (sel safe.err) { ret 1; }
    val nul: err[outcome.Fail] = validate_source_text("value = \"\"\"safe\"\"\"\"\nnext = \"pre\\u0000post\"\n");
    if (sel nul.ok)                                      { ret 1; }
    if (!str_contains(outcome.describe(nul.err), "NUL")) { ret 1; }
    val long_nul: err[outcome.Fail] = validate_source_text("value = '''safe''''\nnext = \"pre\\U00000000post\"\n");
    if (sel long_nul.ok)                                      { ret 1; }
    if (!str_contains(outcome.describe(long_nul.err), "NUL")) { ret 1; }
    ret 0;
}

test "mach.lang.manifest.glob_matches:wildcards_anchor_at_both_ends" {
    var code: i32 = 0;
    if (!glob_matches("shader-*", "shader-blur")) { code = 1; }
    if (!glob_matches("shader-*", "shader-"))     { code = 1; }
    if (glob_matches("shader-*", "shade"))        { code = 1; }
    if (glob_matches("shader-*", "xshader-blur")) { code = 1; }
    if (!glob_matches("*", "anything"))           { code = 1; }
    if (!glob_matches("*-spv", "blur-spv"))       { code = 1; }
    if (glob_matches("*-spv", "blur-spvx"))       { code = 1; }
    if (!glob_matches("a*b*c", "axxbyyc"))        { code = 1; }
    if (glob_matches("a*b*c", "axxbyy"))          { code = 1; }
    if (!glob_matches("exact", "exact"))          { code = 1; }
    if (glob_matches("exact", "exacts"))          { code = 1; }
    ret code;
}
