use mach.lang.fail;
use std.data.toml;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use manifest_version: mach.lang.manifest.version;

use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.id_of;
use mach.lang.manifest.refusal.fail_at;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.span_site;
use mach.lang.manifest.schema.check_path;
use mach.lang.manifest.schema.is_valid_id;
use mach.lang.manifest.schema.key_text;
use mach.lang.manifest.schema.value_span;
use mach.lang.manifest.schema.written_value;
use mach.lang.manifest.template;

pub fun parse_project(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val proj_v: *toml.Value = written_value(t, "project");
    if (proj_v == nil) { ret err[fail.Fail].err{fail.message("internal: a manifest passed its schema check without [project]")}; }
    m.project_at = span_site(proj_v.span);
    val proj: *toml.Table = ?proj_v.data.table;

    val id_str:  str = key_text(proj, "id");
    val ver_str: str = key_text(proj, "version");
    val src_str: str = key_text(proj, "src");
    val out_str: str = key_text(proj, "out");

    val res_check_src: err[fail.Fail] = check_path(alloc, src_str, "[project].src", value_span(proj, "src"));
    if (sel res_check_src.err) { ret res_check_src; }
    val res_check_out: err[fail.Fail] = check_path(alloc, out_str, "[project].out", value_span(proj, "out"));
    if (sel res_check_out.err) { ret res_check_out; }

    if (!is_valid_id(id_str)) { ret fail_at(fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "mach.toml: [project].id must be an identifier (letters, digits, '_', '-')"), value_span(proj, "id")); }
    m.mach = intern.STR_NIL;
    val mach_v: opt[*toml.Value] = toml.get(proj, "mach");
    if (sel mach_v.some) {
        val written: toml.Span                                                = mach_v.some.span;
        val text:    str                                                      = mach_v.some.data.string;
        val parsed:  res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(text);
        if (sel parsed.err) {
            ret fail_at(refuse(alloc, diagnostic_kind.VERSION_INVALID_RANGE, "mach.toml: [project].mach = \"{}\": {} (clause {})", text, parsed.err.reason, parsed.err.clause), written);
        }
        val mach_id: res[intern.StrId, fail.Fail] = id_of(itn, text);
        if (sel mach_id.err) { ret err[fail.Fail].err{mach_id.err}; }
        m.mach    = mach_id.ok;
        m.mach_at = span_site(written);
    }
    val id: res[intern.StrId, fail.Fail] = id_of(itn, id_str);
    if (sel id.err) { ret err[fail.Fail].err{id.err}; }
    val version: res[intern.StrId, fail.Fail] = id_of(itn, ver_str);
    if (sel version.err) { ret err[fail.Fail].err{version.err}; }
    val src: res[intern.StrId, fail.Fail] = id_of(itn, src_str);
    if (sel src.err) { ret err[fail.Fail].err{src.err}; }
    val out: res[intern.StrId, fail.Fail] = id_of(itn, out_str);
    if (sel out.err) { ret err[fail.Fail].err{out.err}; }
    m.id       = id.ok;
    m.version  = version.ok;
    m.src      = src.ok;
    m.out_tmpl = out.ok;
    m.out_at   = span_site(value_span(proj, "out"));
    ret err[fail.Fail].ok{};
}

# expand `m`'s `[project].out` with `v`; a refusal points at the `out` value
pub fun expand_project_out(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, v: *template.Values) res[str, fail.Fail] {
    val r: res[str, fail.Fail] = template.path_expand(alloc, intern.text(itn, m.out_tmpl), template.CONTEXT_PROJECT_OUT, "", v, "[project].out");
    if (sel r.err) { ret res[str, fail.Fail].err{fail.at(alloc, r.err, m.out_at)}; }
    ret r;
}
