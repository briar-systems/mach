pub fun host_isa_name() str {
    ret isa.arch_name_for(lang_target.host_arch_id());
}

pub fun host_os_name() str {
    ret lang_target_os.os_name_for(lang_target.host_os_id());
}

# the host as `mach info` names it, by `tuple_of`
# ---
# alloc: owns the returned string
# ret:   the formatted tuple
pub fun host_tuple(alloc: *A.Allocator) str {
    ret tuple_of(alloc, host_os_name(), host_isa_name());
}

# the one spelling of an (os, isa) pair, "<os>-<isa>", e.g. "linux-x86_64"
# ---
# alloc:    owns the returned string
# os_name:  the os name
# isa_name: the isa name
# ret:      the formatted tuple
pub fun tuple_of(alloc: *A.Allocator, os_name: str, isa_name: str) str {
    ret sfmt(alloc, "{}-{}", os_name, isa_name);
}

fun parse_opt_level(alloc: *A.Allocator, name: str, sub: *toml.Table) res[MOpt, fail.Fail] {
    val v: *toml.Value = written_value(sub, "opt");
    val n: i64         = v.data.integer;
    if (n == 0)           { ret res[MOpt, fail.Fail].ok{MOPT_DEBUG}; }
    if (n == 1 || n == 2) { ret res[MOpt, fail.Fail].ok{MOPT_RELEASE}; }
    ret res[MOpt, fail.Fail].err{point_at(fail.user(diagnostic_kind.MANIFEST_INVALID_VALUE, sfmt(alloc, "mach.toml: profile '{}': opt must be 0, 1, or 2 (got {})", name, opt_value_text(alloc, v))), v.span)};
}

fun parse_simd_mode(alloc: *A.Allocator, name: str, sub: *toml.Table) res[SimdMode, fail.Fail] {
    val v: *toml.Value = written_value(sub, "simd");
    if (str_equals(v.data.string, "scalarize")) { ret res[SimdMode, fail.Fail].ok{SIMD_SCALARIZE}; }
    if (str_equals(v.data.string, "require"))   { ret res[SimdMode, fail.Fail].ok{SIMD_REQUIRE}; }
    ret res[SimdMode, fail.Fail].err{point_at(fail.user(diagnostic_kind.MANIFEST_INVALID_VALUE, sfmt(alloc, "mach.toml: profile '{}': simd must be \"scalarize\" or \"require\" (got {})", name, opt_value_text(alloc, v))), v.span)};
}

# `[profile.X].allow`: the warning kinds the profile silences, each entry a key
# or a family of keys from the diagnostic kind table, named once. an unknown
# entry is refused, and so is one that covers only errors, since only a warning
# can be silenced
fun parse_allow(alloc: *A.Allocator, name: str, sub: *toml.Table) res[diagnostic_kind.KindSet, fail.Fail] {
    var set: diagnostic_kind.KindSet = diagnostic_kind.set_empty();
    val v_o: opt[*toml.Value]        = toml.get(sub, "allow");
    if (sel v_o.none) { ret res[diagnostic_kind.KindSet, fail.Fail].ok{set}; }
    val arr: *toml.Array = ?v_o.some.data.array;
    val n:   usize       = toml.array_len(arr);
    var i:   usize       = 0;
    for (i < n) {
        val e_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e:      *toml.Value               = e_o.some;
        val entry:  str                       = e.data.string;
        var picked: diagnostic_kind.Selection = diagnostic_kind.select(entry);
        if (diagnostic_kind.selection_unknown(?picked)) {
            ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(fail.user(diagnostic_kind.ALLOW_UNKNOWN_KEY, sfmt(alloc, "mach.toml: [profile.{}].allow entry \"{}\" is not a warning key; the warning keys are {}", name, entry, warning_keys(alloc))), e.span)};
        }
        if (diagnostic_kind.selection_empty(?picked)) {
            ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(fail.user(diagnostic_kind.ALLOW_ERROR_KEY, sfmt(alloc, "mach.toml: [profile.{}].allow entry \"{}\" names an error; only a warning can be silenced", name, entry)), e.span)};
        }
        var j: usize = 0;
        for (j < i) {
            val prior: opt[*toml.Value] = toml.array_get(arr, j);
            if (sel prior.some) {
                val pv: *toml.Value = prior.some;
                if (pv.tag == toml.TYPE_STRING && str_equals(pv.data.string, entry)) {
                    ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(fail.user(diagnostic_kind.ALLOW_DUPLICATE_KEY, sfmt(alloc, "mach.toml: [profile.{}].allow lists \"{}\" twice", name, entry)), e.span)};
                }
            }
            j = j + 1;
        }
        diagnostic_kind.set_union(?set, ?picked.warnings);
        i = i + 1;
    }
    ret res[diagnostic_kind.KindSet, fail.Fail].ok{set};
}

# the warning rows' keys, quoted and comma separated
fun warning_keys(alloc: *A.Allocator) str {
    var names: str   = "";
    var i:     usize = 0;
    for (i < diagnostic_kind.COUNT) {
        val row: *diagnostic_kind.Spec = diagnostic_kind.at(i);
        if (row.level == diagnostic_kind.LEVEL_WARNING) {
            if (str_empty(names)) { names = sfmt(alloc, "\"{}\"", row.key); }
            or {
                val longer: str = sfmt(alloc, "{}, \"{}\"", names, row.key);
                str_free(alloc, names);
                names = longer;
            }
        }
        i = i + 1;
    }
    ret names;
}

pub fun parse_project(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val proj_v: *toml.Value = written_value(t, "project");
    if (proj_v == nil) { ret err[fail.Fail].err{fail.message("internal: a manifest passed its schema check without [project]")}; }
    m.project_at = span_site(proj_v.span);
    val proj: *toml.Table = ?proj_v.data.table;

    val id_str:  str = key_text(proj, "id");
    val ver_str: str = key_text(proj, "version");
    val src_str: str = key_text(proj, "src");
    val out_str: str = key_text(proj, "out");

    val res_check_src: err[fail.Fail] = check_path(alloc, src_str, "[project].src", value_span(proj, "src"));
    if (sel res_check_src.err) { ret res_check_src; }
    val res_check_out: err[fail.Fail] = check_path(alloc, out_str, "[project].out", value_span(proj, "out"));
    if (sel res_check_out.err) { ret res_check_out; }

    if (!is_valid_id(id_str)) { ret fail_at(fail.user(diagnostic_kind.MANIFEST_INVALID_NAME, "mach.toml: [project].id must be an identifier (letters, digits, '_', '-')"), value_span(proj, "id")); }
    m.mach = intern.STR_NIL;
    val mach_v: opt[*toml.Value] = toml.get(proj, "mach");
    if (sel mach_v.some) {
        val written: toml.Span                                                = mach_v.some.span;
        val text:    str                                                      = mach_v.some.data.string;
        val parsed:  res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(text);
        if (sel parsed.err) {
            ret fail_at(fail.user(diagnostic_kind.VERSION_INVALID_RANGE, sfmt(alloc, "mach.toml: [project].mach = \"{}\": {} (clause {})", text, parsed.err.reason, parsed.err.clause)), written);
        }
        m.mach    = intern_unwrap(itn, text);
        m.mach_at = span_site(written);
    }
    m.id       = intern_unwrap(itn, id_str);
    m.version  = intern_unwrap(itn, ver_str);
    m.src      = intern_unwrap(itn, src_str);
    m.out_tmpl = intern_unwrap(itn, out_str);
    m.out_at   = span_site(value_span(proj, "out"));
    ret err[fail.Fail].ok{};
}

# `[target.X].extensions`: an array of extension names, each an identifier and
# listed once. the names are checked against the isa's vocabulary when the
# target resolves, since only the registry holds it
fun parse_target_extensions(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, label: str,
    d: *TargetDef) err[fail.Fail] {
    d.extension_count = 0;
    val v_o: opt[*toml.Value] = toml.get(sub, "extensions");
    if (sel v_o.none) { ret err[fail.Fail].ok{}; }
    val v:   *toml.Value = v_o.some;
    val arr: *toml.Array = ?v.data.array;
    val n:   usize       = toml.array_len(arr);
    if (n > extension.MAX_SELECTED::usize) {
        ret fail_at(fail.user(diagnostic_kind.EXTENSION_TOO_MANY, sfmt(alloc, "mach.toml: {}.extensions names more than {} extensions", label, extension.MAX_SELECTED)), v.span);
    }
    var i: usize = 0;
    for (i < n) {
        val e_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e:    *toml.Value = e_o.some;
        val name: str         = e.data.string;
        if (!extension.is_spelling(name, str_len(name))) {
            ret fail_at(fail.user(diagnostic_kind.EXTENSION_INVALID_NAME, sfmt(alloc, "mach.toml: {}.extensions entry \"{}\" is not an extension name or level; names are identifiers, such as \"sse41\", and levels are hyphenated, such as \"x86-64-v2\"", label, name)), e.span);
        }
        val id: intern.StrId = intern_unwrap(itn, name);
        var j:  u32          = 0;
        for (j < d.extension_count) {
            if (d.extensions[j] == id) {
                ret fail_at(fail.user(diagnostic_kind.EXTENSION_DUPLICATE, sfmt(alloc, "mach.toml: {}.extensions lists \"{}\" twice", label, name)), e.span);
            }
            j = j + 1;
        }
        d.extensions[d.extension_count] = id;
        d.extension_count               = d.extension_count + 1;
        i                               = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun parse_targets(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "target");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_targets: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, n);
    if (sel res_targets.err) { ret err[fail.Fail].err{fail.refused(res_targets.err)}; }
    m.targets      = res_targets.ok;
    m.target_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val name: str = name_o.some;
        if (str_equals(name, "native")) {
            ret fail_at(fail.user(diagnostic_kind.TARGET_RESERVED_NAME, "mach.toml: [target.native] is reserved; 'native' resolves to a declared target"), key_span(tab, i));
        }
        val sub:   *toml.Table = ?v_o.some.data.table;
        val label: str         = sfmt(alloc, "[target.{}]", name);

        var d: TargetDef;
        d.name          = intern_unwrap(itn, name);
        d.at            = span_site(key_span(tab, i));
        d.default_at    = span_site(value_span(sub, "default"));
        d.is_default    = flag(sub, "default");
        d.isa           = intern_unwrap(itn, key_text(sub, "isa"));
        d.os            = intern_unwrap(itn, key_text(sub, "os"));
        d.abi           = intern_unwrap(itn, key_text(sub, "abi"));
        d.of            = intern_opt_unwrap(itn, key_text(sub, "of"));
        d.platform      = intern_opt_unwrap(itn, key_text(sub, "platform"));
        d.env           = intern_opt_unwrap(itn, key_text(sub, "env"));
        d.base          = integer_or_zero(sub, "base");
        d.stack_reserve = integer_or_zero(sub, "stack_reserve");
        d.stack_commit  = integer_or_zero(sub, "stack_commit");

        val exts_r: err[fail.Fail] = parse_target_extensions(alloc, itn, sub, label, ?d);
        str_free(alloc, label);
        if (sel exts_r.err) { ret exts_r; }

        m.targets[i] = d;
        i            = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# an optional integer key's value, 0 when it is not written
fun integer_or_zero(sub: *toml.Table, key: str) u64 {
    val v: opt[i64] = toml.get_int(sub, key);
    if (sel v.some) { ret v.some::u64; }
    ret 0;
}

# a refusal of more than one `default = true` profile, pointing at the first
# `default` value and naming the others as related
pub fun duplicate_profiles(alloc: *A.Allocator, m: *Manifest, message: str) fail.Fail {
    var sites: Sites = sites_init(alloc);
    var i:     u32   = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { sites_add(?sites, m.profiles[i].default_at); }
        i = i + 1;
    }
    ret sites_fail(alloc, ?sites, fail.user(diagnostic_kind.SELECTION_DUPLICATE_DEFAULT, message));
}

# the `[profile.*]` tables; the schema check admits no manifest without one
pub fun parse_profiles(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "profile");
    if (sel tab_o.none) { ret err[fail.Fail].err{fail.message("internal: a manifest passed its schema check without [profile.*]")}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].err{fail.message("internal: a manifest passed its schema check without [profile.*]")}; }

    val res_profiles: res[*ProfileDef, A.Error] = A.allocate[ProfileDef](alloc, n);
    if (sel res_profiles.err) { ret err[fail.Fail].err{fail.refused(res_profiles.err)}; }
    m.profiles      = res_profiles.ok;
    m.profile_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val name: str         = name_o.some;
        val v:    *toml.Value = v_o.some;
        val sub:  *toml.Table = ?v.data.table;

        var pf: ProfileDef;
        pf.name          = intern_unwrap(itn, name);
        pf.at            = span_site(v.key);
        pf.default_at    = span_site(value_span(sub, "default"));
        pf.is_default    = flag(sub, "default");
        pf.debug         = flag(sub, "debug");
        pf.vectorize     = flag(sub, "vectorize");
        pf.float_reassoc = flag(sub, "float_reassoc");
        val res_opt: res[MOpt, fail.Fail] = parse_opt_level(alloc, name, sub);
        if (sel res_opt.err) { ret err[fail.Fail].err{res_opt.err}; }
        pf.opt = res_opt.ok;
        val res_simd: res[SimdMode, fail.Fail] = parse_simd_mode(alloc, name, sub);
        if (sel res_simd.err) { ret err[fail.Fail].err{res_simd.err}; }
        pf.simd = res_simd.ok;
        val allow_r: res[diagnostic_kind.KindSet, fail.Fail] = parse_allow(alloc, name, sub);
        if (sel allow_r.err) { ret err[fail.Fail].err{allow_r.err}; }
        pf.allow = allow_r.ok;

        m.profiles[i] = pf;
        i             = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun find_target_by_name(itn: *intern.Interner, m: *Manifest, name: str) *TargetDef {
    val res_id: res[intern.StrId, A.Error] = intern.intern(itn, name);
    if (sel res_id.err) { ret nil; }
    val id: intern.StrId = res_id.ok;
    var i:  u32          = 0;
    for (i < m.target_count) {
        if (m.targets[i].name == id) { ret ?m.targets[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether a target's `os` and `isa` name the given host ids. the abi is not compared
# ---
# itn:       resolves the target's strings
# d:         the target
# host_os:   an os id from `mach.lang.target.os`
# host_arch: an arch id from `mach.lang.target.isa`
# ret:       true when both ids match; false when either string is unknown to `itn`
pub fun target_matches_host(itn: *intern.Interner, d: *TargetDef, host_os: u32, host_arch: u32) bool {
    val opt_os:  opt[str] = intern.lookup(itn, d.os);
    val opt_isa: opt[str] = intern.lookup(itn, d.isa);
    if (sel opt_os.none)  { ret false; }
    if (sel opt_isa.none) { ret false; }
    val os_id:   u32 = lang_target_os.os_id_for(opt_os.some);
    val arch_id: u32 = isa.arch_id_for(opt_isa.some);
    ret (os_id == host_os && arch_id == host_arch);
}

# a `[target.<name>]` table for the host's own tuple, for a fixture that means the host
#[testing]
pub fun host_target_table(alloc: *A.Allocator, name: str) str {
    ret sfmt(alloc, "[target.{}]\nisa = \"{}\"\nos = \"{}\"\nabi = \"{}\"\n", name, host_isa_name(), host_os_name(), abi.abi_name_for(lang_target.host_abi_id()));
}

# `text` with each x86_64-linux target tuple respelled as the host's, for a fixture
# written against x86_64-linux that means the host; a failed allocation leaves it as is
#[testing]
pub fun on_host(text: str) str {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret text; }
    val tuple: str                             = "isa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"";
    val host:  str                             = sfmt(?a, "isa = \"{}\"\nos = \"{}\"\nabi = \"{}\"", host_isa_name(), host_os_name(), abi.abi_name_for(lang_target.host_abi_id()));
    val r:     res[str, types_string.StrError] = types_string.str_replace(?a, text, tuple, host);
    if (sel r.err) { ret text; }
    ret r.ok;
}

# whether `native` could ever name the target: its os is one a build host runs. a
# target of any other os (freestanding, or a finished-module target such as spirv)
# is only ever selected by name
pub fun target_is_hosted(itn: *intern.Interner, d: *TargetDef) bool {
    val opt_os: opt[str] = intern.lookup(itn, d.os);
    if (sel opt_os.none) { ret false; }
    ret lang_target_os.os_is_hosted(lang_target_os.os_id_for(opt_os.some));
}

pub fun make_native_target(alloc: *A.Allocator, itn: *intern.Interner) res[*TargetDef, fail.Fail] {
    var host: TargetDef;
    val name: res[intern.StrId, A.Error] = intern.intern(itn, "native");
    if (sel name.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(name.err)}; }
    host.name = name.ok;
    val isa_name: res[intern.StrId, A.Error] = intern.intern(itn, host_isa_name());
    if (sel isa_name.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(isa_name.err)}; }
    host.isa = isa_name.ok;
    val os_name: res[intern.StrId, A.Error] = intern.intern(itn, host_os_name());
    if (sel os_name.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(os_name.err)}; }
    host.os = os_name.ok;
    val abi_name: res[intern.StrId, A.Error] = intern.intern(itn, abi.abi_name_for(lang_target.host_abi_id()));
    if (sel abi_name.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(abi_name.err)}; }
    host.abi             = abi_name.ok;
    host.is_default      = false;
    host.env             = intern.STR_NIL;
    host.of              = intern.STR_NIL;
    host.platform        = intern.STR_NIL;
    host.base            = 0;
    host.stack_reserve   = 0;
    host.stack_commit    = 0;
    host.extension_count = 0;
    val owned: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, 1);
    if (sel owned.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(owned.err)}; }
    @owned.ok = host;
    ret res[*TargetDef, fail.Fail].ok{owned.ok};
}

test make_native_target__interning_failure_never_publishes_a_partial_target {
    var ordinal:  usize = 0;
    var attempts: usize = 0;
    for (ordinal <= attempts) {
        var tracking: T.Testing;
        val make_r:   err[A.Error] = T.make(?tracking);
        if (sel make_r.err) { ret 1; }
        var itn: intern.Interner = intern.init(?tracking.a);
        tracking.fail_at = ordinal;
        val result: res[*TargetDef, fail.Fail] = make_native_target(?tracking.a, ?itn);
        var valid:  bool                       = ordinal == 0 && sel result.ok;
        if (ordinal == 0) { attempts = tracking.attempts; }
        or                { valid = sel result.err; }
        if (sel result.ok) {
            A.deallocate[TargetDef](?tracking.a, result.ok, 1);
        }
        intern.dnit(?itn);
        val clean: bool = tracking.live == 0 && tracking.double_frees == 0 && tracking.exhausted == 0;
        T.dnit(?tracking);
        if (!valid) { ret 2; }
        if (!clean) { ret 3; }
        ordinal = ordinal + 1;
    }
    if (attempts < 5) { ret 4; }
    ret 0;
}
