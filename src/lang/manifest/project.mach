pub fun host_isa_name() str {
    ret isa.arch_name_for(lang_target.host_arch_id());
}

pub fun host_os_name() str {
    ret lang_target_os.os_name_for(lang_target.host_os_id());
}

# the host as "<isa>-<os>", e.g. "x86_64-linux"
# ---
# alloc: owns the returned string
# ret:   the formatted tuple; on allocation failure the literal "out of memory",
#        which must not be freed
pub fun host_tuple(alloc: *std_allocator.Allocator) str {
    ret sfmt(alloc, "{}-{}", host_isa_name(), host_os_name());
}

fun parse_opt_level(alloc: *std_allocator.Allocator, name: str, sub: *toml.Table, where: toml.Span) res[MOpt, outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "opt");
    if (sel v_o.none) { ret res[MOpt, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, missing_profile_key(alloc, name, "opt")), where)}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_INTEGER) { ret res[MOpt, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_VALUE, opt_err(alloc, name, v)), v.span)}; }
    val n: i64 = v.data.integer;
    if (n == 0)           { ret res[MOpt, outcome.Fail].ok{MOPT_DEBUG}; }
    if (n == 1 || n == 2) { ret res[MOpt, outcome.Fail].ok{MOPT_RELEASE}; }
    ret res[MOpt, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_VALUE, opt_err(alloc, name, v)), v.span)};
}

fun opt_err(alloc: *std_allocator.Allocator, name: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: profile '{}': opt must be 0, 1, or 2 (got {})",
        name, opt_value_text(alloc, v));
}

fun missing_profile_key(alloc: *std_allocator.Allocator, name: str, key: str) str {
    ret sfmt(alloc, "mach.toml: [profile.{}] is missing required key '{}'; a profile declares opt, debug, simd, vectorize and float_reassoc", name, key);
}

fun parse_debug_flag(alloc: *std_allocator.Allocator, name: str, sub: *toml.Table, where: toml.Span) res[bool, outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "debug");
    if (sel v_o.none) { ret res[bool, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, missing_profile_key(alloc, name, "debug")), where)}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_BOOL) { ret res[bool, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, debug_err(alloc, name, v)), v.span)}; }
    ret res[bool, outcome.Fail].ok{v.data.boolean};
}

fun debug_err(alloc: *std_allocator.Allocator, name: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: profile '{}': debug must be a boolean (got {})",
        name, opt_value_text(alloc, v));
}

fun parse_vectorize_flag(alloc: *std_allocator.Allocator, name: str, sub: *toml.Table, where: toml.Span) res[bool, outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "vectorize");
    if (sel v_o.none) { ret res[bool, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, missing_profile_key(alloc, name, "vectorize")), where)}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_BOOL) { ret res[bool, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, sfmt(alloc, "mach.toml: profile '{}': vectorize must be a boolean (got {})", name, opt_value_text(alloc, v))), v.span)}; }
    ret res[bool, outcome.Fail].ok{v.data.boolean};
}

fun parse_float_reassoc_flag(alloc: *std_allocator.Allocator, name: str, sub: *toml.Table, where: toml.Span) res[bool, outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "float_reassoc");
    if (sel v_o.none) { ret res[bool, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, missing_profile_key(alloc, name, "float_reassoc")), where)}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_BOOL) { ret res[bool, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, sfmt(alloc, "mach.toml: profile '{}': float_reassoc must be a boolean (got {})", name, opt_value_text(alloc, v))), v.span)}; }
    ret res[bool, outcome.Fail].ok{v.data.boolean};
}

fun parse_simd_mode(alloc: *std_allocator.Allocator, name: str, sub: *toml.Table, where: toml.Span) res[SimdMode, outcome.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "simd");
    if (sel v_o.none) { ret res[SimdMode, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, missing_profile_key(alloc, name, "simd")), where)}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_STRING)              { ret res[SimdMode, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_VALUE, simd_err(alloc, name, v)), v.span)}; }
    if (str_equals(v.data.string, "scalarize")) { ret res[SimdMode, outcome.Fail].ok{SIMD_SCALARIZE}; }
    if (str_equals(v.data.string, "require"))   { ret res[SimdMode, outcome.Fail].ok{SIMD_REQUIRE}; }
    ret res[SimdMode, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_VALUE, simd_err(alloc, name, v)), v.span)};
}

fun simd_err(alloc: *std_allocator.Allocator, name: str, v: *toml.Value) str {
    ret sfmt(alloc, "mach.toml: profile '{}': simd must be \"scalarize\" or \"require\" (got {})",
        name, opt_value_text(alloc, v));
}

# `[profile.X].allow`: the warning kinds the profile silences, each entry a key
# or a family of keys from the diagnostic kind table, named once. an unknown
# entry is refused, and so is one that covers only errors, since only a warning
# can be silenced
fun parse_allow(alloc: *std_allocator.Allocator, name: str, sub: *toml.Table) res[diagnostic_kind.KindSet, outcome.Fail] {
    var set: diagnostic_kind.KindSet = diagnostic_kind.set_empty();
    val v_o: opt[*toml.Value]        = toml.get(sub, "allow");
    if (sel v_o.none) { ret res[diagnostic_kind.KindSet, outcome.Fail].ok{set}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_ARRAY) { ret res[diagnostic_kind.KindSet, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, allow_shape_err(alloc, name)), v.span)}; }
    val arr: *toml.Array = ?v.data.array;
    val n:   usize       = toml.array_len(arr);
    var i:   usize       = 0;
    for (i < n) {
        val e_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e: *toml.Value = e_o.some;
        if (e.tag != toml.TYPE_STRING) { ret res[diagnostic_kind.KindSet, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, allow_shape_err(alloc, name)), e.span)}; }
        val entry:  str                       = e.data.string;
        var picked: diagnostic_kind.Selection = diagnostic_kind.select(entry);
        if (diagnostic_kind.selection_unknown(?picked)) {
            ret res[diagnostic_kind.KindSet, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.ALLOW_UNKNOWN_KEY, sfmt(alloc, "mach.toml: [profile.{}].allow entry \"{}\" is not a warning key; the warning keys are {}", name, entry, warning_keys(alloc))), e.span)};
        }
        if (diagnostic_kind.selection_empty(?picked)) {
            ret res[diagnostic_kind.KindSet, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.ALLOW_ERROR_KEY, sfmt(alloc, "mach.toml: [profile.{}].allow entry \"{}\" names an error; only a warning can be silenced", name, entry)), e.span)};
        }
        var j: usize = 0;
        for (j < i) {
            val prior: opt[*toml.Value] = toml.array_get(arr, j);
            if (sel prior.some) {
                val pv: *toml.Value = prior.some;
                if (pv.tag == toml.TYPE_STRING && str_equals(pv.data.string, entry)) {
                    ret res[diagnostic_kind.KindSet, outcome.Fail].err{point_at(outcome.user(diagnostic_kind.ALLOW_DUPLICATE_KEY, sfmt(alloc, "mach.toml: [profile.{}].allow lists \"{}\" twice", name, entry)), e.span)};
                }
            }
            j = j + 1;
        }
        diagnostic_kind.set_union(?set, ?picked.warnings);
        i = i + 1;
    }
    ret res[diagnostic_kind.KindSet, outcome.Fail].ok{set};
}

fun allow_shape_err(alloc: *std_allocator.Allocator, name: str) str {
    ret sfmt(alloc, "mach.toml: [profile.{}].allow must be an array of warning keys, such as [\"import.unused\"] or the family [\"vector\"]", name);
}

# the warning rows' keys, quoted and comma separated
fun warning_keys(alloc: *std_allocator.Allocator) str {
    var names: str   = "";
    var i:     usize = 0;
    for (i < diagnostic_kind.COUNT) {
        val row: *diagnostic_kind.Spec = diagnostic_kind.at(i);
        if (row.level == diagnostic_kind.LEVEL_WARNING) {
            if (str_empty(names)) { names = sfmt(alloc, "\"{}\"", row.key); }
            or {
                val longer: str = sfmt(alloc, "{}, \"{}\"", names, row.key);
                str_free(alloc, names);
                names = longer;
            }
        }
        i = i + 1;
    }
    ret names;
}

fun project_key_known(k: str) bool {
    ret str_equals(k, "id") || str_equals(k, "version") || str_equals(k, "src") || str_equals(k, "out")
        || str_equals(k, "mach");
}

pub fun parse_project(alloc: *std_allocator.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[outcome.Fail] {
    val proj_v: opt[*toml.Value] = toml.get(t, "project");
    if (sel proj_v.none) { ret err[outcome.Fail].err{outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: missing [project] table")}; }
    val header: toml.Span = proj_v.some.span;
    if (proj_v.some.tag != toml.TYPE_TABLE) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: missing [project] table"), header); }
    m.project_at = span_site(header);
    val proj:             *toml.Table       = ?proj_v.some.data.table;
    val res_project_keys: err[outcome.Fail] = check_keys(alloc, proj, "[project]", project_key_known);
    if (sel res_project_keys.err) { ret res_project_keys; }

    val id_str: str = key_text(proj, "id");
    if (str_empty(id_str)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: [project] is missing required key 'id'"), required_span(proj, "id", header)); }
    val ver_str: str = key_text(proj, "version");
    if (str_empty(ver_str)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: [project] is missing required key 'version'"), required_span(proj, "version", header)); }
    val src_str: str = key_text(proj, "src");
    if (str_empty(src_str)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: [project] is missing required key 'src'"), required_span(proj, "src", header)); }
    val out_str: str = key_text(proj, "out");
    if (str_empty(out_str)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: [project] is missing required key 'out'"), required_span(proj, "out", header)); }

    val res_check_src: err[outcome.Fail] = check_path(alloc, src_str, "[project].src", value_span(proj, "src"));
    if (sel res_check_src.err) { ret res_check_src; }
    val res_check_out: err[outcome.Fail] = check_path(alloc, out_str, "[project].out", value_span(proj, "out"));
    if (sel res_check_out.err) { ret res_check_out; }

    if (!is_valid_id(id_str)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_NAME, "mach.toml: [project].id must be an identifier (letters, digits, '_', '-')"), value_span(proj, "id")); }
    m.mach = intern.STR_NIL;
    val mach_v: opt[*toml.Value] = toml.get(proj, "mach");
    if (sel mach_v.some) {
        val written: toml.Span = mach_v.some.span;
        if (mach_v.some.tag != toml.TYPE_STRING) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, "mach.toml: [project].mach must be a version range string, such as \"^5.2\""), written); }
        val text:   str                                                      = mach_v.some.data.string;
        val parsed: res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(text);
        if (sel parsed.err) {
            ret fail_at(outcome.user(diagnostic_kind.VERSION_INVALID_RANGE, sfmt(alloc, "mach.toml: [project].mach = \"{}\": {} (clause {})", text, parsed.err.reason, parsed.err.clause)), written);
        }
        m.mach    = intern_unwrap(itn, text);
        m.mach_at = span_site(written);
    }
    m.id       = intern_unwrap(itn, id_str);
    m.version  = intern_unwrap(itn, ver_str);
    m.src      = intern_unwrap(itn, src_str);
    m.out_tmpl = intern_unwrap(itn, out_str);
    m.out_at   = span_site(value_span(proj, "out"));
    ret err[outcome.Fail].ok{};
}

fun target_key_known(k: str) bool {
    ret str_equals(k, "isa") || str_equals(k, "os") || str_equals(k, "abi") || str_equals(k, "of")
        || str_equals(k, "platform") || str_equals(k, "base")
        || str_equals(k, "stack_reserve") || str_equals(k, "stack_commit")
        || str_equals(k, "default") || str_equals(k, "env") || str_equals(k, "extensions");
}

# `[target.X].extensions`: an array of extension names, each an identifier and
# listed once. the names are checked against the isa's vocabulary when the
# target resolves, since only the registry holds it
fun parse_target_extensions(alloc: *std_allocator.Allocator, itn: *intern.Interner, sub: *toml.Table, label: str,
    d: *TargetDef) err[outcome.Fail] {
    d.extension_count = 0;
    val v_o: opt[*toml.Value] = toml.get(sub, "extensions");
    if (sel v_o.none) { ret err[outcome.Fail].ok{}; }
    val v: *toml.Value = v_o.some;
    if (v.tag != toml.TYPE_ARRAY) {
        ret fail_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, sfmt(alloc, "mach.toml: {}.extensions must be an array of extension names, such as [\"sha\"]", label)), v.span);
    }
    val arr: *toml.Array = ?v.data.array;
    val n:   usize       = toml.array_len(arr);
    if (n > extension.MAX_SELECTED::usize) {
        ret fail_at(outcome.user(diagnostic_kind.EXTENSION_TOO_MANY, sfmt(alloc, "mach.toml: {}.extensions names more than {} extensions", label, extension.MAX_SELECTED)), v.span);
    }
    var i: usize = 0;
    for (i < n) {
        val e_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e: *toml.Value = e_o.some;
        if (e.tag != toml.TYPE_STRING) {
            ret fail_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, sfmt(alloc, "mach.toml: {}.extensions must be an array of extension names, such as [\"sha\"]", label)), e.span);
        }
        val name: str = e.data.string;
        if (!extension.is_spelling(name, str_len(name))) {
            ret fail_at(outcome.user(diagnostic_kind.EXTENSION_INVALID_NAME, sfmt(alloc, "mach.toml: {}.extensions entry \"{}\" is not an extension name or level; names are identifiers, such as \"sse41\", and levels are hyphenated, such as \"x86-64-v2\"", label, name)), e.span);
        }
        val id: intern.StrId = intern_unwrap(itn, name);
        var j:  u32          = 0;
        for (j < d.extension_count) {
            if (d.extensions[j] == id) {
                ret fail_at(outcome.user(diagnostic_kind.EXTENSION_DUPLICATE, sfmt(alloc, "mach.toml: {}.extensions lists \"{}\" twice", label, name)), e.span);
            }
            j = j + 1;
        }
        d.extensions[d.extension_count] = id;
        d.extension_count               = d.extension_count + 1;
        i                               = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun parse_targets(alloc: *std_allocator.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[outcome.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "target");
    if (sel tab_o.none) { ret err[outcome.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[outcome.Fail].ok{}; }
    val res_targets: res[*TargetDef, std_allocator.Error] = std_allocator.allocate[TargetDef](alloc, n);
    if (sel res_targets.err) { ret err[outcome.Fail].err{outcome.refused(res_targets.err)}; }
    m.targets      = res_targets.ok;
    m.target_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str] = toml.table_key(tab, i);
        if (sel name_o.none) { brk; }
        val name: str = name_o.some;
        if (!is_valid_id(name)) {
            ret fail_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_NAME, sfmt(alloc, "mach.toml: target name '{}' must be a portable identifier (letters, digits, '_', '-')", name)), key_span(tab, i));
        }
        if (str_equals(name, "native")) {
            ret fail_at(outcome.user(diagnostic_kind.TARGET_RESERVED_NAME, "mach.toml: [target.native] is reserved; 'native' resolves to a declared target"), key_span(tab, i));
        }
        val v_o: opt[*toml.Value] = toml.table_value(tab, i);
        if (sel v_o.none) { brk; }
        val v: *toml.Value = v_o.some;
        if (v.tag != toml.TYPE_TABLE) {
            ret fail_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, sfmt(alloc, "mach.toml: [target.{}] must be a table", name)), v.span);
        }
        val sub:      *toml.Table       = ?v.data.table;
        val label:    str               = sfmt(alloc, "[target.{}]", name);
        val res_keys: err[outcome.Fail] = check_keys(alloc, sub, label, target_key_known);
        if (sel res_keys.err) { ret res_keys; }

        var d: TargetDef;
        d.name       = intern_unwrap(itn, name);
        d.at         = span_site(key_span(tab, i));
        d.default_at = span_site(value_span(sub, "default"));
        val default_r: res[bool, outcome.Fail] = parse_default_flag(alloc, "target", name, sub);
        if (sel default_r.err) {
            str_free(alloc, label);
            ret err[outcome.Fail].err{default_r.err};
        }
        d.is_default = default_r.ok;

        val isa_s: str = key_text(sub, "isa");
        if (str_empty(isa_s)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, sfmt(alloc, "mach.toml: {} is missing required key 'isa'", label)), required_span(sub, "isa", v.span)); }
        val os_s: str = key_text(sub, "os");
        if (str_empty(os_s)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, sfmt(alloc, "mach.toml: {} is missing required key 'os'", label)), required_span(sub, "os", v.span)); }
        val abi_s: str = key_text(sub, "abi");
        if (str_empty(abi_s)) { ret fail_at(outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, sfmt(alloc, "mach.toml: {} is missing required key 'abi'", label)), required_span(sub, "abi", v.span)); }
        d.isa = intern_unwrap(itn, isa_s);
        d.os  = intern_unwrap(itn, os_s);
        d.abi = intern_unwrap(itn, abi_s);
        d.of  = intern_opt_unwrap(itn, key_text(sub, "of"));

        d.platform = intern_opt_unwrap(itn, key_text(sub, "platform"));
        val env_v_o: opt[*toml.Value] = toml.get(sub, "env");
        d.env = intern.STR_NIL;
        if (sel env_v_o.some) {
            val env_v: *toml.Value = env_v_o.some;
            if (env_v.tag != toml.TYPE_STRING || str_empty(key_text(sub, "env"))) {
                val env_msg: str = sfmt(alloc, "mach.toml: {} env must be a non-empty string naming an environment the target's isa defines", label);
                str_free(alloc, label);
                ret fail_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_VALUE, env_msg), env_v.span);
            }
            d.env = intern_unwrap(itn, key_text(sub, "env"));
        }
        d.base = 0;
        val base_opt: opt[i64] = toml.get_int(sub, "base");
        if (sel base_opt.some) { d.base = base_opt.some::u64; }

        d.stack_reserve = 0;
        d.stack_commit  = 0;
        val sres_opt: opt[i64] = toml.get_int(sub, "stack_reserve");
        if (sel sres_opt.some) { d.stack_reserve = sres_opt.some::u64; }
        val scom_opt: opt[i64] = toml.get_int(sub, "stack_commit");
        if (sel scom_opt.some) { d.stack_commit = scom_opt.some::u64; }

        val exts_r: err[outcome.Fail] = parse_target_extensions(alloc, itn, sub, label, ?d);
        if (sel exts_r.err) {
            str_free(alloc, label);
            ret exts_r;
        }

        m.targets[i] = d;
        str_free(alloc, label);
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

# a refusal of more than one `default = true` profile, pointing at the first
# `default` value and naming the others as related
pub fun duplicate_profiles(alloc: *std_allocator.Allocator, m: *Manifest, message: str) outcome.Fail {
    var sites: Sites = sites_init(alloc);
    var i:     u32   = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { sites_add(?sites, m.profiles[i].default_at); }
        i = i + 1;
    }
    ret sites_fail(alloc, ?sites, outcome.user(diagnostic_kind.SELECTION_DUPLICATE_DEFAULT, message));
}

pub val MISSING_PROFILE_MESSAGE: str = "mach.toml: no [profile.<name>] table is declared; a build needs an explicit profile declaring opt, debug, simd, vectorize and float_reassoc";

fun profile_key_known(k: str) bool {
    ret str_equals(k, "default") || str_equals(k, "opt") || str_equals(k, "debug") || str_equals(k, "simd")
        || str_equals(k, "vectorize") || str_equals(k, "float_reassoc") || str_equals(k, "allow");
}

# the `[profile.*]` tables. a root manifest declares at least one; a dependency
# manifest that declares none gets the two synthesized ones, since its profiles
# are never read to build the consumer
pub fun parse_profiles(alloc: *std_allocator.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest, as_root: bool) err[outcome.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "profile");
    var n:     usize            = 0;
    if (sel tab_o.some) { n = toml.table_len(tab_o.some); }
    if (n == 0) {
        if (as_root) { ret err[outcome.Fail].err{outcome.user(diagnostic_kind.MANIFEST_MISSING_REQUIRED, MISSING_PROFILE_MESSAGE)}; }
        ret synthesize_profiles(alloc, itn, m);
    }

    val res_profiles: res[*ProfileDef, std_allocator.Error] = std_allocator.allocate[ProfileDef](alloc, n);
    if (sel res_profiles.err) { ret err[outcome.Fail].err{outcome.refused(res_profiles.err)}; }
    m.profiles      = res_profiles.ok;
    m.profile_count = n::u32;

    var i:        usize         = 0;
    var defaults: DefaultTables = default_tables_init();
    fin { default_tables_dnit(alloc, ?defaults); }
    if (sel tab_o.none) { ret err[outcome.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    for (i < n) {
        val name_o: opt[str] = toml.table_key(tab, i);
        if (sel name_o.none) { brk; }
        val name: str              = name_o.some;
        val v_o:  opt[*toml.Value] = toml.table_value(tab, i);
        if (sel v_o.none) { brk; }
        val v:     *toml.Value = v_o.some;
        val label: str         = sfmt(alloc, "[profile.{}]", name);
        if (!is_valid_id(name)) {
            val name_msg: str = sfmt(alloc, "mach.toml: profile name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
            str_free(alloc, label);
            ret fail_at(outcome.user(diagnostic_kind.MANIFEST_INVALID_NAME, name_msg), v.key);
        }
        if (v.tag != toml.TYPE_TABLE) {
            val lbl_msg6: str = sfmt(alloc, "mach.toml: {} must be a table", label);
            str_free(alloc, label);
            ret fail_at(outcome.user(diagnostic_kind.MANIFEST_VALUE_TYPE, lbl_msg6), v.span);
        }
        val sub:      *toml.Table       = ?v.data.table;
        val res_keys: err[outcome.Fail] = check_keys(alloc, sub, label, profile_key_known);
        if (sel res_keys.err) { ret res_keys; }

        var pf: ProfileDef;
        pf.name       = intern_unwrap(itn, name);
        pf.at         = span_site(v.key);
        pf.default_at = span_site(value_span(sub, "default"));
        val default_r: res[bool, outcome.Fail] = parse_default_flag(alloc, "profile", name, sub);
        if (sel default_r.err) { ret err[outcome.Fail].err{default_r.err}; }
        pf.is_default = default_r.ok;
        if (pf.is_default) { default_tables_note(alloc, ?defaults, label); }
        val res_opt: res[MOpt, outcome.Fail] = parse_opt_level(alloc, name, sub, v.span);
        if (sel res_opt.err) { ret err[outcome.Fail].err{res_opt.err}; }
        pf.opt = res_opt.ok;
        val debug_r: res[bool, outcome.Fail] = parse_debug_flag(alloc, name, sub, v.span);
        if (sel debug_r.err) { ret err[outcome.Fail].err{debug_r.err}; }
        pf.debug = debug_r.ok;
        val res_simd: res[SimdMode, outcome.Fail] = parse_simd_mode(alloc, name, sub, v.span);
        if (sel res_simd.err) { ret err[outcome.Fail].err{res_simd.err}; }
        pf.simd = res_simd.ok;
        val vectorize_r: res[bool, outcome.Fail] = parse_vectorize_flag(alloc, name, sub, v.span);
        if (sel vectorize_r.err) { ret err[outcome.Fail].err{vectorize_r.err}; }
        pf.vectorize = vectorize_r.ok;
        val float_reassoc_r: res[bool, outcome.Fail] = parse_float_reassoc_flag(alloc, name, sub, v.span);
        if (sel float_reassoc_r.err) { ret err[outcome.Fail].err{float_reassoc_r.err}; }
        pf.float_reassoc = float_reassoc_r.ok;
        val allow_r: res[diagnostic_kind.KindSet, outcome.Fail] = parse_allow(alloc, name, sub);
        if (sel allow_r.err) { ret err[outcome.Fail].err{allow_r.err}; }
        pf.allow = allow_r.ok;

        m.profiles[i] = pf;
        str_free(alloc, label);
        i = i + 1;
    }
    if (as_root && n > 1 && defaults.count > 1) {
        ret err[outcome.Fail].err{duplicate_profiles(alloc, m, duplicate_default_err(alloc, "profile", ?defaults))};
    }
    ret err[outcome.Fail].ok{};
}

pub fun builtin_profile(itn: *intern.Interner, name: str, found: MOpt, debug: bool,
    vectorize: bool, is_default: bool) ProfileDef {
    var pf: ProfileDef;
    pf.name          = intern_unwrap(itn, name);
    pf.is_default    = is_default;
    pf.opt           = found;
    pf.debug         = debug;
    pf.simd          = SIMD_SCALARIZE;
    pf.vectorize     = vectorize;
    pf.float_reassoc = false;
    pf.allow         = diagnostic_kind.set_empty();
    ret pf;
}

fun synthesize_profiles(alloc: *std_allocator.Allocator, itn: *intern.Interner,
    m: *Manifest) err[outcome.Fail] {
    val res_profiles: res[*ProfileDef, std_allocator.Error] = std_allocator.allocate[ProfileDef](alloc, 2);
    if (sel res_profiles.err) { ret err[outcome.Fail].err{outcome.refused(res_profiles.err)}; }
    m.profiles      = res_profiles.ok;
    m.profile_count = 2;
    m.profiles[0]   = builtin_profile(itn, "debug", MOPT_DEBUG, true, false, true);
    m.profiles[1]   = builtin_profile(itn, "release", MOPT_RELEASE, false, true, false);
    ret err[outcome.Fail].ok{};
}

pub fun find_target_by_name(itn: *intern.Interner, m: *Manifest, name: str) *TargetDef {
    val res_id: res[intern.StrId, std_allocator.Error] = intern.intern(itn, name);
    if (sel res_id.err) { ret nil; }
    val id: intern.StrId = res_id.ok;
    var i:  u32          = 0;
    for (i < m.target_count) {
        if (m.targets[i].name == id) { ret ?m.targets[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether a target's `os` and `isa` name the given host ids. the abi is not compared
# ---
# itn:       resolves the target's strings
# d:         the target
# host_os:   an os id from `mach.lang.target.os`
# host_arch: an arch id from `mach.lang.target.isa`
# ret:       true when both ids match; false when either string is unknown to `itn`
pub fun target_matches_host(itn: *intern.Interner, d: *TargetDef, host_os: u32, host_arch: u32) bool {
    val opt_os:  opt[str] = intern.lookup(itn, d.os);
    val opt_isa: opt[str] = intern.lookup(itn, d.isa);
    if (sel opt_os.none)  { ret false; }
    if (sel opt_isa.none) { ret false; }
    val os_id:   u32 = lang_target_os.os_id_for(opt_os.some);
    val arch_id: u32 = isa.arch_id_for(opt_isa.some);
    ret (os_id == host_os && arch_id == host_arch);
}

# a `[target.<name>]` table for the host's own tuple, for a fixture that means the host
#[testing]
pub fun host_target_table(alloc: *std_allocator.Allocator, name: str) str {
    ret sfmt(alloc, "[target.{}]\nisa = \"{}\"\nos = \"{}\"\nabi = \"{}\"\n", name, host_isa_name(), host_os_name(), abi.abi_name_for(lang_target.host_abi_id()));
}

# `text` with each x86_64-linux target tuple respelled as the host's, for a fixture
# written against x86_64-linux that means the host; a failed allocation leaves it as is
#[testing]
pub fun on_host(text: str) str {
    var a:    std_allocator.Allocator;
    val made: err[std_allocator.Error] = page.make(?a);
    if (sel made.err) { ret text; }
    val tuple: str                             = "isa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"";
    val host:  str                             = sfmt(?a, "isa = \"{}\"\nos = \"{}\"\nabi = \"{}\"", host_isa_name(), host_os_name(), abi.abi_name_for(lang_target.host_abi_id()));
    val r:     res[str, types_string.StrError] = types_string.str_replace(?a, text, tuple, host);
    if (sel r.err) { ret text; }
    ret r.ok;
}

# whether `native` could ever name the target: its os is one a build host runs. a
# target of any other os (freestanding, or a finished-module target such as spirv)
# is only ever selected by name
pub fun target_is_hosted(itn: *intern.Interner, d: *TargetDef) bool {
    val opt_os: opt[str] = intern.lookup(itn, d.os);
    if (sel opt_os.none) { ret false; }
    ret lang_target_os.os_is_hosted(lang_target_os.os_id_for(opt_os.some));
}

pub fun make_native_target(alloc: *std_allocator.Allocator, itn: *intern.Interner) res[*TargetDef, outcome.Fail] {
    var host: TargetDef;
    val name: res[intern.StrId, std_allocator.Error] = intern.intern(itn, "native");
    if (sel name.err) { ret res[*TargetDef, outcome.Fail].err{outcome.refused(name.err)}; }
    host.name = name.ok;
    val isa_name: res[intern.StrId, std_allocator.Error] = intern.intern(itn, host_isa_name());
    if (sel isa_name.err) { ret res[*TargetDef, outcome.Fail].err{outcome.refused(isa_name.err)}; }
    host.isa = isa_name.ok;
    val os_name: res[intern.StrId, std_allocator.Error] = intern.intern(itn, host_os_name());
    if (sel os_name.err) { ret res[*TargetDef, outcome.Fail].err{outcome.refused(os_name.err)}; }
    host.os = os_name.ok;
    val abi_name: res[intern.StrId, std_allocator.Error] = intern.intern(itn, abi.abi_name_for(lang_target.host_abi_id()));
    if (sel abi_name.err) { ret res[*TargetDef, outcome.Fail].err{outcome.refused(abi_name.err)}; }
    host.abi             = abi_name.ok;
    host.is_default      = false;
    host.env             = intern.STR_NIL;
    host.of              = intern.STR_NIL;
    host.platform        = intern.STR_NIL;
    host.base            = 0;
    host.stack_reserve   = 0;
    host.stack_commit    = 0;
    host.extension_count = 0;
    val owned: res[*TargetDef, std_allocator.Error] = std_allocator.allocate[TargetDef](alloc, 1);
    if (sel owned.err) { ret res[*TargetDef, outcome.Fail].err{outcome.refused(owned.err)}; }
    @owned.ok = host;
    ret res[*TargetDef, outcome.Fail].ok{owned.ok};
}

test make_native_target__interning_failure_never_publishes_a_partial_target {
    var ordinal:  usize = 0;
    var attempts: usize = 0;
    for (ordinal <= attempts) {
        var tracking: allocator_testing.Testing;
        val make_r:   err[std_allocator.Error] = allocator_testing.make(?tracking);
        if (sel make_r.err) { ret 1; }
        var itn: intern.Interner = intern.init(?tracking.a);
        tracking.fail_at = ordinal;
        val result: res[*TargetDef, outcome.Fail] = make_native_target(?tracking.a, ?itn);
        var valid:  bool                          = ordinal == 0 && sel result.ok;
        if (ordinal == 0) { attempts = tracking.attempts; }
        or                { valid = sel result.err; }
        if (sel result.ok) {
            std_allocator.deallocate[TargetDef](?tracking.a, result.ok, 1);
        }
        intern.dnit(?itn);
        val clean: bool = tracking.live == 0 && tracking.double_frees == 0 && tracking.exhausted == 0;
        allocator_testing.dnit(?tracking);
        if (!valid) { ret 2; }
        if (!clean) { ret 3; }
        ordinal = ordinal + 1;
    }
    if (attempts < 5) { ret 4; }
    ret 0;
}
