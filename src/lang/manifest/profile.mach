use mach.lang.fail;
use std.data.toml;
use std.text.string.str_free;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_equals;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;

use mach.lang.manifest.model.MOPT_DEBUG;
use mach.lang.manifest.model.MOPT_RELEASE;
use mach.lang.manifest.model.MOpt;
use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.ProfileDef;
use mach.lang.manifest.model.SIMD_REQUIRE;
use mach.lang.manifest.model.SIMD_SCALARIZE;
use mach.lang.manifest.model.SimdMode;
use mach.lang.manifest.model.id_of;
use mach.lang.manifest.model.text_of;
use mach.lang.manifest.refusal.Sites;
use mach.lang.manifest.refusal.point_at;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.sfmt;
use mach.lang.manifest.refusal.sites_add;
use mach.lang.manifest.refusal.sites_fail;
use mach.lang.manifest.refusal.sites_init;
use mach.lang.manifest.refusal.span_site;
use mach.lang.manifest.schema.flag;
use mach.lang.manifest.schema.value_span;
use mach.lang.manifest.schema.value_text;
use mach.lang.manifest.schema.written_value;

fun parse_opt_level(alloc: *A.Allocator, name: str, sub: *toml.Table) res[MOpt, fail.Fail] {
    val v: *toml.Value = written_value(sub, "opt");
    val n: i64         = v.data.integer;
    if (n == 0)           { ret res[MOpt, fail.Fail].ok{MOPT_DEBUG}; }
    if (n == 1 || n == 2) { ret res[MOpt, fail.Fail].ok{MOPT_RELEASE}; }
    val got: res[str, fail.Fail] = value_text(alloc, v);
    if (sel got.err) { ret res[MOpt, fail.Fail].err{got.err}; }
    ret res[MOpt, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: profile '{}': opt must be 0, 1, or 2 (got {})", name, got.ok), v.span)};
}

fun parse_simd_mode(alloc: *A.Allocator, name: str, sub: *toml.Table) res[SimdMode, fail.Fail] {
    val v: *toml.Value = written_value(sub, "simd");
    if (str_equals(v.data.string, "scalarize")) { ret res[SimdMode, fail.Fail].ok{SIMD_SCALARIZE}; }
    if (str_equals(v.data.string, "require"))   { ret res[SimdMode, fail.Fail].ok{SIMD_REQUIRE}; }
    val got: res[str, fail.Fail] = value_text(alloc, v);
    if (sel got.err) { ret res[SimdMode, fail.Fail].err{got.err}; }
    ret res[SimdMode, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: profile '{}': simd must be \"scalarize\" or \"require\" (got {})", name, got.ok), v.span)};
}

# `[profile.X].allow`: the warning kinds the profile silences, each entry a key
# or a family of keys from the diagnostic kind table, named once. an unknown
# entry is refused, and so is one that covers only errors, since only a warning
# can be silenced
fun parse_allow(alloc: *A.Allocator, name: str, sub: *toml.Table) res[diagnostic_kind.KindSet, fail.Fail] {
    var set: diagnostic_kind.KindSet = diagnostic_kind.set_empty();
    val v_o: opt[*toml.Value]        = toml.get(sub, "allow");
    if (sel v_o.none) { ret res[diagnostic_kind.KindSet, fail.Fail].ok{set}; }
    val arr: *toml.Array = ?v_o.some.data.array;
    val n:   usize       = toml.array_len(arr);
    var i:   usize       = 0;
    for (i < n) {
        val e_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e:      *toml.Value               = e_o.some;
        val entry:  str                       = e.data.string;
        var picked: diagnostic_kind.Selection = diagnostic_kind.select(entry);
        if (diagnostic_kind.selection_unknown(?picked)) {
            val keys: res[str, fail.Fail] = warning_keys(alloc);
            if (sel keys.err) { ret res[diagnostic_kind.KindSet, fail.Fail].err{keys.err}; }
            ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.ALLOW_UNKNOWN_KEY, "mach.toml: [profile.{}].allow entry \"{}\" is not a warning key; the warning keys are {}", name, entry, keys.ok), e.span)};
        }
        if (diagnostic_kind.selection_empty(?picked)) {
            ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.ALLOW_ERROR_KEY, "mach.toml: [profile.{}].allow entry \"{}\" names an error; only a warning can be silenced", name, entry), e.span)};
        }
        var j: usize = 0;
        for (j < i) {
            val prior: opt[*toml.Value] = toml.array_get(arr, j);
            if (sel prior.some) {
                val pv: *toml.Value = prior.some;
                if (pv.tag == toml.TYPE_STRING && str_equals(pv.data.string, entry)) {
                    ret res[diagnostic_kind.KindSet, fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.ALLOW_DUPLICATE_KEY, "mach.toml: [profile.{}].allow lists \"{}\" twice", name, entry), e.span)};
                }
            }
            j = j + 1;
        }
        diagnostic_kind.set_union(?set, ?picked.warnings);
        i = i + 1;
    }
    ret res[diagnostic_kind.KindSet, fail.Fail].ok{set};
}

# the warning rows' keys, quoted and comma separated
fun warning_keys(alloc: *A.Allocator) res[str, fail.Fail] {
    var names: str   = "";
    var i:     usize = 0;
    for (i < diagnostic_kind.COUNT) {
        val row: *diagnostic_kind.Spec = diagnostic_kind.at(i);
        i = i + 1;
        if (row.level != diagnostic_kind.LEVEL_WARNING) { cnt; }
        var longer: res[str, fail.Fail];
        if (str_empty(names))  { longer = sfmt(alloc, "\"{}\"", row.key); }
        or                     { longer = sfmt(alloc, "{}, \"{}\"", names, row.key); }
        if (!str_empty(names)) { str_free(alloc, names); }
        if (sel longer.err)    { ret longer; }
        names = longer.ok;
    }
    ret res[str, fail.Fail].ok{names};
}

# more than one `default = true` profile is refused, pointing at the first
# `default` value and naming the others as related
pub fun default_validate(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest) err[fail.Fail] {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { count = count + 1; }
        i = i + 1;
    }
    if (count <= 1) { ret err[fail.Fail].ok{}; }
    var names: str = "";
    i = 0;
    for (i < m.profile_count) {
        val pf: *ProfileDef = ?m.profiles[i];
        i = i + 1;
        if (!pf.is_default) { cnt; }
        var longer: res[str, fail.Fail];
        if (str_empty(names)) { longer = sfmt(alloc, "[profile.{}]", text_of(itn, pf.name)); }
        or                    { longer = sfmt(alloc, "{}, [profile.{}]", names, text_of(itn, pf.name)); }
        if (sel longer.err)   { ret err[fail.Fail].err{longer.err}; }
        names = longer.ok;
    }
    var sites: Sites = sites_init(alloc);
    i = 0;
    for (i < m.profile_count) {
        if (m.profiles[i].is_default) { sites_add(?sites, m.profiles[i].default_at); }
        i = i + 1;
    }
    ret err[fail.Fail].err{sites_fail(alloc, ?sites, refuse(alloc, diagnostic_kind.SELECTION_DUPLICATE_DEFAULT,
        "mach.toml: {} profiles declare `default = true` ({}); exactly one is allowed", count, names))};
}

# the `[profile.*]` tables; the schema check admits no manifest without one
pub fun parse_profiles(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "profile");
    if (sel tab_o.none) { ret err[fail.Fail].err{fail.message("internal: a manifest passed its schema check without [profile.*]")}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].err{fail.message("internal: a manifest passed its schema check without [profile.*]")}; }

    val res_profiles: res[*ProfileDef, A.Error] = A.allocate[ProfileDef](alloc, n);
    if (sel res_profiles.err) { ret err[fail.Fail].err{fail.refused(res_profiles.err)}; }
    m.profiles      = res_profiles.ok;
    m.profile_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val name: str         = name_o.some;
        val v:    *toml.Value = v_o.some;
        val sub:  *toml.Table = ?v.data.table;

        val name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
        if (sel name_id.err) { ret err[fail.Fail].err{name_id.err}; }
        var pf: ProfileDef;
        pf.name          = name_id.ok;
        pf.at            = span_site(v.key);
        pf.default_at    = span_site(value_span(sub, "default"));
        pf.is_default    = flag(sub, "default");
        pf.debug         = flag(sub, "debug");
        pf.vectorize     = flag(sub, "vectorize");
        pf.float_reassoc = flag(sub, "float_reassoc");
        val res_opt: res[MOpt, fail.Fail] = parse_opt_level(alloc, name, sub);
        if (sel res_opt.err) { ret err[fail.Fail].err{res_opt.err}; }
        pf.opt = res_opt.ok;
        val res_simd: res[SimdMode, fail.Fail] = parse_simd_mode(alloc, name, sub);
        if (sel res_simd.err) { ret err[fail.Fail].err{res_simd.err}; }
        pf.simd = res_simd.ok;
        val allow_r: res[diagnostic_kind.KindSet, fail.Fail] = parse_allow(alloc, name, sub);
        if (sel allow_r.err) { ret err[fail.Fail].err{allow_r.err}; }
        pf.allow = allow_r.ok;

        m.profiles[i] = pf;
        i             = i + 1;
    }
    ret err[fail.Fail].ok{};
}
