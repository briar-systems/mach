use mach.lang.fail;
use lang_source: mach.lang.source;
use std.process.env;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.char.char_to_lower;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_contains_char;
use std.types.string.str_equals;
use std.types.string.str_is_empty;
use std.types.string.str_len;
use toml_lookup: toml.lookup;
use toml_value:  toml.value;

use A:               std.allocator;
use chrono_duration: std.chrono.duration;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.duration;
use mach.lang.intern;

use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.StepDef;
use mach.lang.manifest.model.id_of;
use mach.lang.manifest.refusal.element_sites;
use mach.lang.manifest.refusal.point_at;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.sfmt;
use mach.lang.manifest.refusal.span_site;
use mach.lang.manifest.schema.StrArr;
use mach.lang.manifest.schema.check_path;
use mach.lang.manifest.schema.element_span;
use mach.lang.manifest.schema.ids_of;
use mach.lang.manifest.schema.key_span;
use mach.lang.manifest.schema.written_value;

fun env_key_compare(a: str, b: str) i64 {
    val an: usize = str_len(a);
    val bn: usize = str_len(b);
    var n:  usize = an;
    if (bn < n) { n = bn; }
    var i: usize = 0;
    for (i < n) {
        val ac: char = char_to_lower(a[i]::char);
        val bc: char = char_to_lower(b[i]::char);
        if (ac < bc) { ret -1; }
        if (ac > bc) { ret 1; }
        i = i + 1;
    }
    if (an < bn) { ret -1; }
    if (an > bn) { ret 1; }
    ret str_compare(a, b);
}

fun env_keys_ambiguous(a: *A.Allocator, left: str, right: str) res[bool, fail.Fail] {
    val length: usize = str_len(left);
    if (length == str_len(right)) {
        var i: usize = 0;
        for (i < length && char_to_lower(left[i]::char) == char_to_lower(right[i]::char)) { i = i + 1; }
        if (i == length) { ret res[bool, fail.Fail].ok{true}; }
    }
    # the host's own name order decides the rest: windows folds case beyond ascii, posix compares bytes
    val res_order: res[i32, env.EnvError] = env.compare_names(left, right);
    if (sel res_order.err) {
        val op: fail.Op = fail.Op{verb: "compare", role: "the environment variable names", path: left, link: "and", other: right, given: true};
        ret res[bool, fail.Fail].err{fail.refusal(a, diagnostic_kind.ENV_NAME_COMPARE, op, fail.Cause.env{res_order.err})};
    }
    ret res[bool, fail.Fail].ok{res_order.ok == 0};
}

pub fun parse_steps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val opt_tab: opt[*toml_value.Table] = toml_lookup.get_table(t, "step");
    if (sel opt_tab.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml_value.Table = opt_tab.some;
    val n:   usize             = toml_lookup.table_len(tab);
    if (n == 0)                { ret err[fail.Fail].ok{}; }
    if (n > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "mach.toml: too many build steps")}; }

    val res_steps: res[*StepDef, A.Error] = A.allocate[StepDef](alloc, n);
    if (sel res_steps.err) { ret err[fail.Fail].err{fail.refused(res_steps.err)}; }
    m.steps      = res_steps.ok;
    m.step_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *StepDef = ?m.steps[initialized];
        slot.argv         = nil;
        slot.argv_count   = 0;
        slot.env_keys     = nil;
        slot.env_values   = nil;
        slot.env_count    = 0;
        slot.env_in       = nil;
        slot.env_in_count = 0;
        slot.in           = nil;
        slot.in_count     = 0;
        slot.out          = nil;
        slot.out_count    = 0;
        slot.need         = nil;
        slot.need_count   = 0;
        slot.timeout      = 0;
        slot.argv_at      = nil;
        slot.env_at       = nil;
        slot.env_in_at    = nil;
        slot.in_at        = nil;
        slot.out_at       = nil;
        slot.need_at      = nil;
        initialized       = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val opt_name:        opt[str]               = toml_lookup.table_key(tab, i);
        val opt_table_value: opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
        if (sel opt_name.none)        { brk; }
        if (sel opt_table_value.none) { brk; }
        val res_label: res[str, fail.Fail] = sfmt(alloc, "[step.{}]", opt_name.some);
        if (sel res_label.err) { ret err[fail.Fail].err{res_label.err}; }
        val err_decoded: err[fail.Fail] = step_decode(alloc, itn, opt_name.some, res_label.ok, opt_table_value.some, ?m.steps[i]);
        str_free(alloc, res_label.ok);
        if (sel err_decoded.err) { ret err_decoded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the string array `key` of a step, interned into `items` and `count` with the
# place of each entry in `sites`
fun strings_decode(alloc: *A.Allocator, itn: *intern.Interner, arr: *toml_value.Array, label: str, key: str,
    items: **intern.StrId, count: *u32, sites: **lang_source.Location) err[fail.Fail] {
    val res_decoded: res[StrArr, fail.Fail] = ids_of(alloc, itn, arr, label, key);
    if (sel res_decoded.err) { ret err[fail.Fail].err{res_decoded.err}; }
    @items = res_decoded.ok.items;
    @count = res_decoded.ok.count;
    val res_placed: res[*lang_source.Location, fail.Fail] = element_sites(alloc, arr);
    if (sel res_placed.err) { ret err[fail.Fail].err{res_placed.err}; }
    @sites = res_placed.ok;
    ret err[fail.Fail].ok{};
}

# a step's `in` or `out` paths: each a canonical project path, and for `out` a
# concrete one, which holds no glob
fun paths_decode(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, label: str, key: str,
    items: **intern.StrId, count: *u32, sites: **lang_source.Location) err[fail.Fail] {
    val opt_arr: opt[*toml_value.Array] = toml_lookup.get_array(sub, key);
    if (sel opt_arr.none) { ret err[fail.Fail].err{fail.message("internal: a step passed its schema check without in or out")}; }
    val arr:         *toml_value.Array = opt_arr.some;
    val err_decoded: err[fail.Fail]    = strings_decode(alloc, itn, arr, label, key, items, count, sites);
    if (sel err_decoded.err) { ret err_decoded; }
    val res_field: res[str, fail.Fail] = sfmt(alloc, "{}.{}", label, key);
    if (sel res_field.err) { ret err[fail.Fail].err{res_field.err}; }
    fin { str_free(alloc, res_field.ok); }
    var i: u32 = 0;
    for (i < @count) {
        val p: str = intern.text(itn, (@items)[i]);
        if (str_equals(key, "out") && str_contains_char(p, '*')) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_PATH, "mach.toml: {}.out cannot contain a glob '*'; outputs must be concrete paths", label), element_span(arr, i::usize))};
        }
        val err_checked: err[fail.Fail] = check_path(alloc, p, res_field.ok, element_span(arr, i::usize));
        if (sel err_checked.err) { ret err_checked; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_decode(alloc: *A.Allocator, itn: *intern.Interner, name: str, label: str, v: *toml_value.Value, d: *StepDef) err[fail.Fail] {
    val sub:         *toml_value.Table            = ?v.data.table;
    val res_name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel res_name_id.err) { ret err[fail.Fail].err{res_name_id.err}; }
    d.name = res_name_id.ok;
    d.at   = span_site(v.key);

    val argv_v: *toml_value.Value = written_value(sub, "argv");
    if (argv_v == nil) { ret err[fail.Fail].err{fail.message("internal: a step passed its schema check without argv")}; }
    val err_argv: err[fail.Fail] = strings_decode(alloc, itn, ?argv_v.data.array, label, "argv", ?d.argv, ?d.argv_count, ?d.argv_at);
    if (sel err_argv.err)                          { ret err_argv; }
    if (d.argv_count == 0)                         { ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.argv must be nonempty", label), argv_v.span)}; }
    if (str_is_empty(intern.text(itn, d.argv[0]))) { ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.argv[0] must name an executable", label), element_span(?argv_v.data.array, 0))}; }

    val opt_env_v: opt[*toml_value.Value] = toml_lookup.get(sub, "env");
    if (sel opt_env_v.some) {
        val err_envs: err[fail.Fail] = env_decode(alloc, itn, label, ?opt_env_v.some.data.table, d);
        if (sel err_envs.err) { ret err_envs; }
    }

    val opt_env_in_arr: opt[*toml_value.Array] = toml_lookup.get_array(sub, "env_in");
    if (sel opt_env_in_arr.some) {
        val err_names: err[fail.Fail] = env_in_decode(alloc, itn, label, opt_env_in_arr.some, d);
        if (sel err_names.err) { ret err_names; }
    }

    val err_ins: err[fail.Fail] = paths_decode(alloc, itn, sub, label, "in", ?d.in, ?d.in_count, ?d.in_at);
    if (sel err_ins.err) { ret err_ins; }
    val err_outs: err[fail.Fail] = paths_decode(alloc, itn, sub, label, "out", ?d.out, ?d.out_count, ?d.out_at);
    if (sel err_outs.err) { ret err_outs; }

    val opt_need_arr: opt[*toml_value.Array] = toml_lookup.get_array(sub, "need");
    if (sel opt_need_arr.some) {
        val err_needs: err[fail.Fail] = strings_decode(alloc, itn, opt_need_arr.some, label, "need", ?d.need, ?d.need_count, ?d.need_at);
        if (sel err_needs.err) { ret err_needs; }
    }

    val opt_timeout_v: opt[*toml_value.Value] = toml_lookup.get(sub, "timeout");
    if (sel opt_timeout_v.some) {
        val timeout_v:   *toml_value.Value             = opt_timeout_v.some;
        val opt_timeout: opt[chrono_duration.Duration] = duration.parse(timeout_v.data.string::*u8);
        if (sel opt_timeout.none) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.timeout must be a duration string: {}; omit the key for an unbounded step", label, duration.FORMS), timeout_v.span)};
        }
        d.timeout = opt_timeout.some;
    }
    ret err[fail.Fail].ok{};
}

# a step's `env_in` names: each nonempty, free of '=', and distinct from every
# other however the platform compares names
fun env_in_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, arr: *toml_value.Array, d: *StepDef) err[fail.Fail] {
    val err_decoded: err[fail.Fail] = strings_decode(alloc, itn, arr, label, "env_in", ?d.env_in, ?d.env_in_count, ?d.env_in_at);
    if (sel err_decoded.err) { ret err_decoded; }
    var i: u32 = 0;
    for (i < d.env_in_count) {
        val name: str = intern.text(itn, d.env_in[i]);
        if (str_is_empty(name) || str_contains_char(name, '=')) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.env_in name '{}' must be nonempty and cannot contain '='", label, name), element_span(arr, i::usize))};
        }
        var j: u32 = 0;
        for (j < i) {
            val prior:         str                  = intern.text(itn, d.env_in[j]);
            val res_ambiguous: res[bool, fail.Fail] = env_keys_ambiguous(alloc, prior, name);
            if (sel res_ambiguous.err) { ret err[fail.Fail].err{res_ambiguous.err}; }
            if (res_ambiguous.ok) {
                ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_DUPLICATE_ENTRY, "mach.toml: {}.env_in has ambiguous names '{}' and '{}'", label, prior, name), element_span(arr, i::usize))};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a step's `env` table: each key nonempty, free of '=', and distinct from every
# other however the platform compares names, each value a string; the entries
# are kept sorted by key
fun env_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, env_t: *toml_value.Table, d: *StepDef) err[fail.Fail] {
    val env_n: usize = toml_lookup.table_len(env_t);
    if (env_n > 0xFFFFFFFF::usize) {
        ret err[fail.Fail].err{refuse(alloc, diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "mach.toml: {}.env has too many entries", label)};
    }
    if (env_n == 0) { ret err[fail.Fail].ok{}; }
    var staged: bool = true;

    val res_env_keys: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
    if (sel res_env_keys.err) { ret err[fail.Fail].err{fail.refused(res_env_keys.err)}; }
    val env_keys: *intern.StrId = res_env_keys.ok;
    fin {
        if (staged) { A.deallocate[intern.StrId](alloc, env_keys, env_n); }
    }
    val res_env_values: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
    if (sel res_env_values.err) { ret err[fail.Fail].err{fail.refused(res_env_values.err)}; }
    val env_values: *intern.StrId = res_env_values.ok;
    fin {
        if (staged) { A.deallocate[intern.StrId](alloc, env_values, env_n); }
    }
    val res_env_at: res[*lang_source.Location, A.Error] = A.allocate[lang_source.Location](alloc, env_n);
    if (sel res_env_at.err) { ret err[fail.Fail].err{fail.refused(res_env_at.err)}; }
    d.env_keys   = env_keys;
    d.env_values = env_values;
    d.env_at     = res_env_at.ok;
    d.env_count  = env_n::u32;
    staged       = false;
    var ei: usize = 0;
    for (ei < env_n) {
        val opt_env_key: opt[str] = toml_lookup.table_key(env_t, ei);
        if (sel opt_env_key.none) { brk; }
        val env_key: str = opt_env_key.some;
        if (str_is_empty(env_key) || str_contains_char(env_key, '=')) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.env key '{}' must be nonempty and cannot contain '='", label, env_key), key_span(env_t, ei))};
        }
        var ej: usize = 0;
        for (ej < ei) {
            val prior:         str                  = intern.text(itn, d.env_keys[ej]);
            val res_ambiguous: res[bool, fail.Fail] = env_keys_ambiguous(alloc, prior, env_key);
            if (sel res_ambiguous.err) { ret err[fail.Fail].err{res_ambiguous.err}; }
            if (res_ambiguous.ok) {
                ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_DUPLICATE_ENTRY, "mach.toml: {}.env has ambiguous keys '{}' and '{}'", label, prior, env_key), key_span(env_t, ei))};
            }
            ej = ej + 1;
        }
        val opt_env_value: opt[*toml_value.Value] = toml_lookup.table_value(env_t, ei);
        if (sel opt_env_value.none) { brk; }
        val env_value: *toml_value.Value = opt_env_value.some;
        if (env_value.tag != toml_value.TYPE_STRING) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, "mach.toml: {}.env.{} must be a string", label, env_key), key_span(env_t, ei))};
        }
        val res_key_id: res[intern.StrId, fail.Fail] = id_of(itn, env_key);
        if (sel res_key_id.err) { ret err[fail.Fail].err{res_key_id.err}; }
        val res_value_id: res[intern.StrId, fail.Fail] = id_of(itn, env_value.data.string);
        if (sel res_value_id.err) { ret err[fail.Fail].err{res_value_id.err}; }
        d.env_keys[ei]   = res_key_id.ok;
        d.env_values[ei] = res_value_id.ok;
        d.env_at[ei]     = span_site(env_value.span);
        ei               = ei + 1;
    }
    ei = 1;
    for (ei < env_n) {
        val key:   intern.StrId         = d.env_keys[ei];
        val value: intern.StrId         = d.env_values[ei];
        val site:  lang_source.Location = d.env_at[ei];
        var ej:    usize                = ei;
        for (ej > 0 && env_key_compare(intern.text(itn, key), intern.text(itn, d.env_keys[ej - 1])) < 0) {
            d.env_keys[ej]   = d.env_keys[ej - 1];
            d.env_values[ej] = d.env_values[ej - 1];
            d.env_at[ej]     = d.env_at[ej - 1];
            ej               = ej - 1;
        }
        d.env_keys[ej]   = key;
        d.env_values[ej] = value;
        d.env_at[ej]     = site;
        ei               = ei + 1;
    }
    ret err[fail.Fail].ok{};
}
