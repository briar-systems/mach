use mach.lang.fail;
use std.data.toml;
use std.process.env;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.char.char;
use std.types.char.char_to_lower;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_contains_char;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;

use A:               std.allocator;
use chrono_duration: std.chrono.duration;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.duration;
use mach.lang.intern;

use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.StepDef;
use mach.lang.manifest.model.id_of;
use mach.lang.manifest.refusal.element_sites;
use mach.lang.manifest.refusal.point_at;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.sfmt;
use mach.lang.manifest.refusal.span_site;
use mach.lang.manifest.schema.StrArr;
use mach.lang.manifest.schema.check_path;
use mach.lang.manifest.schema.element_span;
use mach.lang.manifest.schema.ids_of;
use mach.lang.manifest.schema.key_span;
use mach.lang.manifest.schema.written_value;

fun env_key_compare(a: str, b: str) i64 {
    val an: usize = str_len(a);
    val bn: usize = str_len(b);
    var n:  usize = an;
    if (bn < n) { n = bn; }
    var i: usize = 0;
    for (i < n) {
        val ac: char = char_to_lower(a[i]::char);
        val bc: char = char_to_lower(b[i]::char);
        if (ac < bc) { ret -1; }
        if (ac > bc) { ret 1; }
        i = i + 1;
    }
    if (an < bn) { ret -1; }
    if (an > bn) { ret 1; }
    ret str_compare(a, b);
}

fun env_keys_ambiguous(left: str, right: str) res[bool, fail.Fail] {
    val length: usize = str_len(left);
    if (length == str_len(right)) {
        var i: usize = 0;
        for (i < length && char_to_lower(left[i]::char) == char_to_lower(right[i]::char)) { i = i + 1; }
        if (i == length) { ret res[bool, fail.Fail].ok{true}; }
    }
    # the host's own name order decides the rest: windows folds case beyond ascii, posix compares bytes
    val order: res[i32, env.EnvError] = env.compare_names(left, right);
    if (sel order.err) { ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.ENV_NAME_COMPARE, fail.env_text(order.err))}; }
    ret res[bool, fail.Fail].ok{order.ok == 0};
}

pub fun parse_steps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "step");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0)                { ret err[fail.Fail].ok{}; }
    if (n > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "mach.toml: too many build steps")}; }

    val res_steps: res[*StepDef, A.Error] = A.allocate[StepDef](alloc, n);
    if (sel res_steps.err) { ret err[fail.Fail].err{fail.refused(res_steps.err)}; }
    m.steps      = res_steps.ok;
    m.step_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *StepDef = ?m.steps[initialized];
        slot.argv       = nil;
        slot.argv_count = 0;
        slot.env_keys   = nil;
        slot.env_values = nil;
        slot.env_count  = 0;
        slot.in         = nil;
        slot.in_count   = 0;
        slot.out        = nil;
        slot.out_count  = 0;
        slot.need       = nil;
        slot.need_count = 0;
        slot.timeout    = 0;
        slot.argv_at    = nil;
        slot.env_at     = nil;
        slot.in_at      = nil;
        slot.out_at     = nil;
        slot.need_at    = nil;
        initialized     = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val label: res[str, fail.Fail] = sfmt(alloc, "[step.{}]", name_o.some);
        if (sel label.err) { ret err[fail.Fail].err{label.err}; }
        val decoded: err[fail.Fail] = step_decode(alloc, itn, name_o.some, label.ok, v_o.some, ?m.steps[i]);
        str_free(alloc, label.ok);
        if (sel decoded.err) { ret decoded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the string array `key` of a step, interned into `items` and `count` with the
# place of each entry in `sites`
fun strings_decode(alloc: *A.Allocator, itn: *intern.Interner, arr: *toml.Array, label: str, key: str,
    items: **intern.StrId, count: *u32, sites: **fail.Place) err[fail.Fail] {
    val decoded: res[StrArr, fail.Fail] = ids_of(alloc, itn, arr, label, key);
    if (sel decoded.err) { ret err[fail.Fail].err{decoded.err}; }
    @items = decoded.ok.items;
    @count = decoded.ok.count;
    val placed: res[*fail.Place, fail.Fail] = element_sites(alloc, arr);
    if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
    @sites = placed.ok;
    ret err[fail.Fail].ok{};
}

# a step's `in` or `out` paths: each a canonical project path, and for `out` a
# concrete one, which holds no glob
fun paths_decode(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, label: str, key: str,
    items: **intern.StrId, count: *u32, sites: **fail.Place) err[fail.Fail] {
    val arr_o: opt[*toml.Array] = toml.get_array(sub, key);
    if (sel arr_o.none) { ret err[fail.Fail].err{fail.message("internal: a step passed its schema check without in or out")}; }
    val arr:     *toml.Array    = arr_o.some;
    val decoded: err[fail.Fail] = strings_decode(alloc, itn, arr, label, key, items, count, sites);
    if (sel decoded.err) { ret decoded; }
    val field: res[str, fail.Fail] = sfmt(alloc, "{}.{}", label, key);
    if (sel field.err) { ret err[fail.Fail].err{field.err}; }
    fin { str_free(alloc, field.ok); }
    var i: u32 = 0;
    for (i < @count) {
        val p: str = intern.text(itn, (@items)[i]);
        if (str_equals(key, "out") && str_contains_char(p, '*')) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_PATH, "mach.toml: {}.out cannot contain a glob '*'; outputs must be concrete paths", label), element_span(arr, i::usize))};
        }
        val checked: err[fail.Fail] = check_path(alloc, p, field.ok, element_span(arr, i::usize));
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun step_decode(alloc: *A.Allocator, itn: *intern.Interner, name: str, label: str, v: *toml.Value, d: *StepDef) err[fail.Fail] {
    val sub:     *toml.Table                  = ?v.data.table;
    val name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel name_id.err) { ret err[fail.Fail].err{name_id.err}; }
    d.name = name_id.ok;
    d.at   = span_site(v.key);

    val argv_v: *toml.Value = written_value(sub, "argv");
    if (argv_v == nil) { ret err[fail.Fail].err{fail.message("internal: a step passed its schema check without argv")}; }
    val argv: err[fail.Fail] = strings_decode(alloc, itn, ?argv_v.data.array, label, "argv", ?d.argv, ?d.argv_count, ?d.argv_at);
    if (sel argv.err)                           { ret argv; }
    if (d.argv_count == 0)                      { ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.argv must be nonempty", label), argv_v.span)}; }
    if (str_empty(intern.text(itn, d.argv[0]))) { ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.argv[0] must name an executable", label), element_span(?argv_v.data.array, 0))}; }

    val env_v_o: opt[*toml.Value] = toml.get(sub, "env");
    if (sel env_v_o.some) {
        val envs: err[fail.Fail] = env_decode(alloc, itn, label, ?env_v_o.some.data.table, d);
        if (sel envs.err) { ret envs; }
    }

    val ins: err[fail.Fail] = paths_decode(alloc, itn, sub, label, "in", ?d.in, ?d.in_count, ?d.in_at);
    if (sel ins.err) { ret ins; }
    val outs: err[fail.Fail] = paths_decode(alloc, itn, sub, label, "out", ?d.out, ?d.out_count, ?d.out_at);
    if (sel outs.err) { ret outs; }

    val need_arr_o: opt[*toml.Array] = toml.get_array(sub, "need");
    if (sel need_arr_o.some) {
        val needs: err[fail.Fail] = strings_decode(alloc, itn, need_arr_o.some, label, "need", ?d.need, ?d.need_count, ?d.need_at);
        if (sel needs.err) { ret needs; }
    }

    val timeout_v_o: opt[*toml.Value] = toml.get(sub, "timeout");
    if (sel timeout_v_o.some) {
        val timeout_v: *toml.Value                   = timeout_v_o.some;
        val timeout_d: opt[chrono_duration.Duration] = duration.parse(timeout_v.data.string::*u8);
        if (sel timeout_d.none) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.timeout must be a duration string: {}; omit the key for an unbounded step", label, duration.FORMS), timeout_v.span)};
        }
        d.timeout = timeout_d.some;
    }
    ret err[fail.Fail].ok{};
}

# a step's `env` table: each key nonempty, free of '=', and distinct from every
# other however the platform compares names, each value a string; the entries
# are kept sorted by key
fun env_decode(alloc: *A.Allocator, itn: *intern.Interner, label: str, env_t: *toml.Table, d: *StepDef) err[fail.Fail] {
    val env_n: usize = toml.table_len(env_t);
    if (env_n > 0xFFFFFFFF::usize) {
        ret err[fail.Fail].err{refuse(alloc, diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "mach.toml: {}.env has too many entries", label)};
    }
    if (env_n == 0) { ret err[fail.Fail].ok{}; }
    val env_keys_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
    if (sel env_keys_r.err) { ret err[fail.Fail].err{fail.refused(env_keys_r.err)}; }
    val env_values_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
    if (sel env_values_r.err) {
        A.deallocate[intern.StrId](alloc, env_keys_r.ok, env_n);
        ret err[fail.Fail].err{fail.refused(env_values_r.err)};
    }
    val env_at_r: res[*fail.Place, A.Error] = A.allocate[fail.Place](alloc, env_n);
    if (sel env_at_r.err) {
        A.deallocate[intern.StrId](alloc, env_values_r.ok, env_n);
        A.deallocate[intern.StrId](alloc, env_keys_r.ok, env_n);
        ret err[fail.Fail].err{fail.refused(env_at_r.err)};
    }
    d.env_keys   = env_keys_r.ok;
    d.env_values = env_values_r.ok;
    d.env_at     = env_at_r.ok;
    d.env_count  = env_n::u32;
    var ei: usize = 0;
    for (ei < env_n) {
        val env_key_o: opt[str] = toml.table_key(env_t, ei);
        if (sel env_key_o.none) { brk; }
        val env_key: str = env_key_o.some;
        if (str_empty(env_key) || str_contains_char(env_key, '=')) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.env key '{}' must be nonempty and cannot contain '='", label, env_key), key_span(env_t, ei))};
        }
        var ej: usize = 0;
        for (ej < ei) {
            val prior:     str                  = intern.text(itn, d.env_keys[ej]);
            val ambiguous: res[bool, fail.Fail] = env_keys_ambiguous(prior, env_key);
            if (sel ambiguous.err) { ret err[fail.Fail].err{ambiguous.err}; }
            if (ambiguous.ok) {
                ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_DUPLICATE_ENTRY, "mach.toml: {}.env has ambiguous keys '{}' and '{}'", label, prior, env_key), key_span(env_t, ei))};
            }
            ej = ej + 1;
        }
        val env_value_o: opt[*toml.Value] = toml.table_value(env_t, ei);
        if (sel env_value_o.none) { brk; }
        val env_value: *toml.Value = env_value_o.some;
        if (env_value.tag != toml.TYPE_STRING) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_VALUE_TYPE, "mach.toml: {}.env.{} must be a string", label, env_key), key_span(env_t, ei))};
        }
        val key_id: res[intern.StrId, fail.Fail] = id_of(itn, env_key);
        if (sel key_id.err) { ret err[fail.Fail].err{key_id.err}; }
        val value_id: res[intern.StrId, fail.Fail] = id_of(itn, env_value.data.string);
        if (sel value_id.err) { ret err[fail.Fail].err{value_id.err}; }
        d.env_keys[ei]   = key_id.ok;
        d.env_values[ei] = value_id.ok;
        d.env_at[ei]     = span_site(env_value.span);
        ei               = ei + 1;
    }
    ei = 1;
    for (ei < env_n) {
        val key:   intern.StrId = d.env_keys[ei];
        val value: intern.StrId = d.env_values[ei];
        val site:  fail.Place   = d.env_at[ei];
        var ej:    usize        = ei;
        for (ej > 0 && env_key_compare(intern.text(itn, key), intern.text(itn, d.env_keys[ej - 1])) < 0) {
            d.env_keys[ej]   = d.env_keys[ej - 1];
            d.env_values[ej] = d.env_values[ej - 1];
            d.env_at[ej]     = d.env_at[ej - 1];
            ej               = ej - 1;
        }
        d.env_keys[ej]   = key;
        d.env_values[ej] = value;
        d.env_at[ej]     = site;
        ei               = ei + 1;
    }
    ret err[fail.Fail].ok{};
}
