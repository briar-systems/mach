use mach.lang.fail;
use std.data.toml;
use std.process.env;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.char.char_to_lower;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_contains_char;
use std.types.string.str_empty;
use std.types.string.str_len;

use A:               std.allocator;
use chrono_duration: std.chrono.duration;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.duration;
use mach.lang.intern;

use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.StepDef;
use mach.lang.manifest.parse.Sites;
use mach.lang.manifest.parse.StrArr;
use mach.lang.manifest.parse.check_path;
use mach.lang.manifest.parse.element_sites;
use mach.lang.manifest.parse.idstr;
use mach.lang.manifest.parse.key_span;
use mach.lang.manifest.parse.need_matches;
use mach.lang.manifest.parse.parse_str_array;
use mach.lang.manifest.parse.point_at;
use mach.lang.manifest.parse.sfmt;
use mach.lang.manifest.parse.sites_add;
use mach.lang.manifest.parse.sites_fail;
use mach.lang.manifest.parse.sites_init;
use mach.lang.manifest.parse.span_site;
use mach.lang.manifest.parse.written_value;

fun step_parse_fail(alloc: *A.Allocator, label: str, f: fail.Fail) err[fail.Fail] {
    str_free(alloc, label);
    ret err[fail.Fail].err{f};
}

# the literal of an array's element `i`; the zero span when absent
fun element_span(arr: *toml.Array, i: usize) toml.Span {
    val e: opt[*toml.Value] = toml.array_get(arr, i);
    if (sel e.some) { ret e.some.span; }
    var none: toml.Span;
    ret none;
}

fun env_key_compare(a: str, b: str) i64 {
    val an: usize = str_len(a);
    val bn: usize = str_len(b);
    var n:  usize = an;
    if (bn < n) { n = bn; }
    var i: usize = 0;
    for (i < n) {
        val ac: char = char_to_lower(a[i]::char);
        val bc: char = char_to_lower(b[i]::char);
        if (ac < bc) { ret -1; }
        if (ac > bc) { ret 1; }
        i = i + 1;
    }
    if (an < bn) { ret -1; }
    if (an > bn) { ret 1; }
    ret str_compare(a, b);
}

fun env_keys_ambiguous(left: str, right: str) res[bool, fail.Fail] {
    val length: usize = str_len(left);
    if (length == str_len(right)) {
        var i: usize = 0;
        for (i < length && char_to_lower(left[i]::char) == char_to_lower(right[i]::char)) { i = i + 1; }
        if (i == length) { ret res[bool, fail.Fail].ok{true}; }
    }
    $if ($mach.build.os == $mach.os.windows) {
        val order: res[i32, env.EnvError] = env.compare_names(left, right);
        if (sel order.err) { ret res[bool, fail.Fail].err{fail.user(diagnostic_kind.ENV_NAME_COMPARE, fail.env_text(order.err))}; }
        ret res[bool, fail.Fail].ok{order.ok == 0};
    }
    $or { ret res[bool, fail.Fail].ok{false}; }
}

pub fun parse_steps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "step");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0)                { ret err[fail.Fail].ok{}; }
    if (n > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.user(diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, "mach.toml: too many build steps")}; }

    val res_steps: res[*StepDef, A.Error] = A.allocate[StepDef](alloc, n);
    if (sel res_steps.err) { ret err[fail.Fail].err{fail.refused(res_steps.err)}; }
    m.steps      = res_steps.ok;
    m.step_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *StepDef = ?m.steps[initialized];
        slot.argv       = nil;
        slot.argv_count = 0;
        slot.env_keys   = nil;
        slot.env_values = nil;
        slot.env_count  = 0;
        slot.in         = nil;
        slot.in_count   = 0;
        slot.out        = nil;
        slot.out_count  = 0;
        slot.need       = nil;
        slot.need_count = 0;
        slot.timeout    = 0;
        slot.argv_at    = nil;
        slot.env_at     = nil;
        slot.in_at      = nil;
        slot.out_at     = nil;
        slot.need_at    = nil;
        initialized     = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str] = toml.table_key(tab, i);
        if (sel name_o.none) { brk; }
        val name: str              = name_o.some;
        val v_o:  opt[*toml.Value] = toml.table_value(tab, i);
        if (sel v_o.none) { brk; }
        val v:     *toml.Value = v_o.some;
        val label: str         = sfmt(alloc, "[step.{}]", name);
        val sub:   *toml.Table = ?v.data.table;

        val d:      *StepDef                   = ?m.steps[i];
        val name_r: res[intern.StrId, A.Error] = intern.add(itn, name);
        if (sel name_r.err) {
            ret step_parse_fail(alloc, label, fail.refused(name_r.err));
        }
        d.name = name_r.ok;
        d.at   = span_site(v.key);

        val argv_v: *toml.Value = written_value(sub, "argv");
        if (argv_v == nil) { ret step_parse_fail(alloc, label, fail.message("internal: a step passed its schema check without argv")); }
        val res_argv: res[StrArr, fail.Fail] = parse_str_array(alloc, itn, ?argv_v.data.array, label, "argv", false);
        if (sel res_argv.err) { ret step_parse_fail(alloc, label, res_argv.err); }
        val argv_val: StrArr = res_argv.ok;
        d.argv       = argv_val.items;
        d.argv_count = argv_val.count;
        val argv_sites: res[*fail.Place, fail.Fail] = element_sites(alloc, ?argv_v.data.array);
        if (sel argv_sites.err) { ret step_parse_fail(alloc, label, argv_sites.err); }
        d.argv_at = argv_sites.ok;
        if (argv_val.count == 0)                      { ret step_parse_fail(alloc, label, point_at(fail.user(diagnostic_kind.MANIFEST_INVALID_VALUE, sfmt(alloc, "mach.toml: {}.argv must be nonempty", label)), argv_v.span)); }
        if (str_empty(idstr(itn, argv_val.items[0]))) { ret step_parse_fail(alloc, label, point_at(fail.user(diagnostic_kind.MANIFEST_INVALID_VALUE, sfmt(alloc, "mach.toml: {}.argv[0] must name an executable", label)), element_span(?argv_v.data.array, 0))); }

        val env_v_o: opt[*toml.Value] = toml.get(sub, "env");
        if (sel env_v_o.some) {
            val env_t: *toml.Table = ?env_v_o.some.data.table;
            val env_n: usize       = toml.table_len(env_t);
            if (env_n > 0xFFFFFFFF::usize) {
                ret step_parse_fail(alloc, label, fail.user(diagnostic_kind.MANIFEST_TOO_MANY_ENTRIES, sfmt(alloc, "mach.toml: {}.env has too many entries", label)));
            }
            if (env_n > 0) {
                val env_keys_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
                if (sel env_keys_r.err) { ret step_parse_fail(alloc, label, fail.refused(env_keys_r.err)); }
                val env_values_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
                if (sel env_values_r.err) {
                    A.deallocate[intern.StrId](alloc, env_keys_r.ok, env_n);
                    ret step_parse_fail(alloc, label, fail.refused(env_values_r.err));
                }
                val env_at_r: res[*fail.Place, A.Error] = A.allocate[fail.Place](alloc, env_n);
                if (sel env_at_r.err) {
                    A.deallocate[intern.StrId](alloc, env_values_r.ok, env_n);
                    A.deallocate[intern.StrId](alloc, env_keys_r.ok, env_n);
                    ret step_parse_fail(alloc, label, fail.refused(env_at_r.err));
                }
                d.env_keys   = env_keys_r.ok;
                d.env_values = env_values_r.ok;
                d.env_at     = env_at_r.ok;
                d.env_count  = env_n::u32;
                var ei: usize = 0;
                for (ei < env_n) {
                    val env_key_o: opt[str] = toml.table_key(env_t, ei);
                    if (sel env_key_o.none) { brk; }
                    val env_key: str = env_key_o.some;
                    if (str_empty(env_key) || str_contains_char(env_key, '=')) {
                        ret step_parse_fail(alloc, label, point_at(fail.user(diagnostic_kind.MANIFEST_INVALID_VALUE, sfmt(alloc, "mach.toml: {}.env key '{}' must be nonempty and cannot contain '='", label, env_key)), key_span(env_t, ei)));
                    }
                    var ej: usize = 0;
                    for (ej < ei) {
                        val prior:     str                  = idstr(itn, d.env_keys[ej]);
                        val ambiguous: res[bool, fail.Fail] = env_keys_ambiguous(prior, env_key);
                        if (sel ambiguous.err) { ret step_parse_fail(alloc, label, ambiguous.err); }
                        if (ambiguous.ok) {
                            ret step_parse_fail(alloc, label, point_at(fail.user(diagnostic_kind.MANIFEST_DUPLICATE_ENTRY, sfmt(alloc, "mach.toml: {}.env has ambiguous keys '{}' and '{}'", label, prior, env_key)), key_span(env_t, ei)));
                        }
                        ej = ej + 1;
                    }
                    val env_value_o: opt[*toml.Value] = toml.table_value(env_t, ei);
                    if (sel env_value_o.none) { brk; }
                    val env_value: *toml.Value = env_value_o.some;
                    if (env_value == nil || env_value.tag != toml.TYPE_STRING) {
                        ret step_parse_fail(alloc, label, point_at(fail.user(diagnostic_kind.MANIFEST_VALUE_TYPE, sfmt(alloc, "mach.toml: {}.env.{} must be a string", label, env_key)), key_span(env_t, ei)));
                    }
                    val env_key_r: res[intern.StrId, A.Error] = intern.add(itn, env_key);
                    if (sel env_key_r.err) {
                        ret step_parse_fail(alloc, label, fail.refused(env_key_r.err));
                    }
                    val env_value_r: res[intern.StrId, A.Error] = intern.add(itn, env_value.data.string);
                    if (sel env_value_r.err) {
                        ret step_parse_fail(alloc, label, fail.refused(env_value_r.err));
                    }
                    d.env_keys[ei]   = env_key_r.ok;
                    d.env_values[ei] = env_value_r.ok;
                    d.env_at[ei]     = span_site(env_value.span);
                    ei               = ei + 1;
                }
                ei = 1;
                for (ei < env_n) {
                    val key:   intern.StrId = d.env_keys[ei];
                    val value: intern.StrId = d.env_values[ei];
                    val site:  fail.Place   = d.env_at[ei];
                    var ej:    usize        = ei;
                    for (ej > 0 && env_key_compare(idstr(itn, key), idstr(itn, d.env_keys[ej - 1])) < 0) {
                        d.env_keys[ej]   = d.env_keys[ej - 1];
                        d.env_values[ej] = d.env_values[ej - 1];
                        d.env_at[ej]     = d.env_at[ej - 1];
                        ej               = ej - 1;
                    }
                    d.env_keys[ej]   = key;
                    d.env_values[ej] = value;
                    d.env_at[ej]     = site;
                    ei               = ei + 1;
                }
            }
        }

        val in_arr_o: opt[*toml.Array] = toml.get_array(sub, "in");
        if (sel in_arr_o.none) { ret step_parse_fail(alloc, label, fail.message("internal: a step passed its schema check without in")); }
        val in_arr: *toml.Array            = in_arr_o.some;
        val res_in: res[StrArr, fail.Fail] = parse_str_array(alloc, itn, in_arr, label, "in", false);
        if (sel res_in.err) { ret step_parse_fail(alloc, label, res_in.err); }
        val in_val: StrArr = res_in.ok;
        d.in       = in_val.items;
        d.in_count = in_val.count;
        val in_sites: res[*fail.Place, fail.Fail] = element_sites(alloc, in_arr);
        if (sel in_sites.err) { ret step_parse_fail(alloc, label, in_sites.err); }
        d.in_at = in_sites.ok;
        var ii: u32 = 0;
        for (ii < d.in_count) {
            val p:         str            = idstr(itn, d.in[ii]);
            val in_field:  str            = sfmt(alloc, "{}.in", label);
            val res_check: err[fail.Fail] = check_path(alloc, p, in_field, element_span(in_arr, ii::usize));
            str_free(alloc, in_field);
            if (sel res_check.err) { ret step_parse_fail(alloc, label, res_check.err); }
            ii = ii + 1;
        }

        val out_arr_o: opt[*toml.Array] = toml.get_array(sub, "out");
        if (sel out_arr_o.none) { ret step_parse_fail(alloc, label, fail.message("internal: a step passed its schema check without out")); }
        val out_arr: *toml.Array            = out_arr_o.some;
        val res_out: res[StrArr, fail.Fail] = parse_str_array(alloc, itn, out_arr, label, "out", false);
        if (sel res_out.err) { ret step_parse_fail(alloc, label, res_out.err); }
        val out_val: StrArr = res_out.ok;
        d.out       = out_val.items;
        d.out_count = out_val.count;
        val out_sites: res[*fail.Place, fail.Fail] = element_sites(alloc, out_arr);
        if (sel out_sites.err) { ret step_parse_fail(alloc, label, out_sites.err); }
        d.out_at = out_sites.ok;
        ii       = 0;
        for (ii < d.out_count) {
            val p: str = idstr(itn, d.out[ii]);
            if (str_contains_char(p, '*')) { ret step_parse_fail(alloc, label, point_at(fail.user(diagnostic_kind.MANIFEST_PATH, sfmt(alloc, "mach.toml: {}.out cannot contain a glob '*'; outputs must be concrete paths", label)), element_span(out_arr, ii::usize))); }
            val out_path_field: str            = sfmt(alloc, "{}.out", label);
            val res_check:      err[fail.Fail] = check_path(alloc, p, out_path_field, element_span(out_arr, ii::usize));
            str_free(alloc, out_path_field);
            if (sel res_check.err) { ret step_parse_fail(alloc, label, res_check.err); }
            ii = ii + 1;
        }

        val need_arr_o: opt[*toml.Array] = toml.get_array(sub, "need");
        if (sel need_arr_o.some) {
            val need_arr: *toml.Array            = need_arr_o.some;
            val res_need: res[StrArr, fail.Fail] = parse_str_array(alloc, itn, need_arr, label, "need", false);
            if (sel res_need.err) { ret step_parse_fail(alloc, label, res_need.err); }
            val need_val: StrArr = res_need.ok;
            d.need       = need_val.items;
            d.need_count = need_val.count;
            val need_sites: res[*fail.Place, fail.Fail] = element_sites(alloc, need_arr);
            if (sel need_sites.err) { ret step_parse_fail(alloc, label, need_sites.err); }
            d.need_at = need_sites.ok;
        }

        val timeout_v_o: opt[*toml.Value] = toml.get(sub, "timeout");
        if (sel timeout_v_o.some) {
            val timeout_v: *toml.Value                   = timeout_v_o.some;
            val timeout_d: opt[chrono_duration.Duration] = duration.parse(timeout_v.data.string::*u8);
            if (sel timeout_d.none) {
                ret step_parse_fail(alloc, label, point_at(fail.user(diagnostic_kind.MANIFEST_INVALID_VALUE, sfmt(alloc, "mach.toml: {}.timeout must be a duration string: {}; omit the key for an unbounded step", label, duration.FORMS)), timeout_v.span));
            }
            d.timeout = timeout_d.some;
        }

        str_free(alloc, label);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# visit step `idx` and every step its `need` reaches, appending each to `order`
# after the steps it needs; a step reached again while its own visit is open is
# a `need` cycle, refused at its first edge's `need` entry with the others related
pub fun plan_visit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, idx: u32, state: *u8, order: *u32, order_len: *u32) err[fail.Fail] {
    if (state[idx] == 2) { ret err[fail.Fail].ok{}; }
    val trail_r: res[*NeedEdge, A.Error] = A.allocate[NeedEdge](alloc, m.step_count::usize);
    if (sel trail_r.err) { ret err[fail.Fail].err{fail.refused(trail_r.err)}; }
    fin { A.deallocate[NeedEdge](alloc, trail_r.ok, m.step_count::usize); }
    ret visit(alloc, itn, m, idx, state, order, order_len, trail_r.ok, 0);
}

# one `need` edge of a visit: entry `need` of step `from`
rec NeedEdge {
    from: u32;
    need: u32;
}

fun visit(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, idx: u32, state: *u8, order: *u32, order_len: *u32,
    trail: *NeedEdge, depth: u32) err[fail.Fail] {
    if (state[idx] == 2) { ret err[fail.Fail].ok{}; }
    if (state[idx] == 1) { ret err[fail.Fail].err{need_cycle(alloc, itn, m, idx, trail, depth)}; }
    state[idx] = 1;
    val s:  *StepDef = ?m.steps[idx];
    var ni: u32      = 0;
    for (ni < s.need_count) {
        var j: u32 = 0;
        for (j < m.step_count) {
            if (j != idx && need_matches(idstr(itn, s.need[ni]), "step", idstr(itn, m.steps[j].name))) {
                trail[depth] = NeedEdge{from: idx, need: ni};
                val vr: err[fail.Fail] = visit(alloc, itn, m, j, state, order, order_len, trail, depth + 1);
                if (sel vr.err) { ret vr; }
            }
            j = j + 1;
        }
        ni = ni + 1;
    }
    state[idx]        = 2;
    order[@order_len] = idx;
    @order_len        = @order_len + 1;
    ret err[fail.Fail].ok{};
}

# the cycle through step `back`, reached again along the `depth` edges of `trail`:
# its edges are the ones from `back`'s own edge on
fun need_cycle(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, back: u32, trail: *NeedEdge, depth: u32) fail.Fail {
    val f:     fail.Fail = fail.user(diagnostic_kind.NEED_CYCLE, sfmt(alloc, "mach.toml: build step '{}' is part of a 'need' cycle", idstr(itn, m.steps[back].name)));
    var first: u32       = 0;
    for (first < depth && trail[first].from != back) { first = first + 1; }
    var sites: Sites = sites_init(alloc);
    var k:     u32   = first;
    for (k < depth) {
        val from: *StepDef = ?m.steps[trail[k].from];
        if (from.need_at != nil) { sites_add(?sites, from.need_at[trail[k].need]); }
        k = k + 1;
    }
    ret sites_fail(alloc, ?sites, f);
}
