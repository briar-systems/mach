use mach.lang.build.outcome;
use std.data.toml;
use process_env: std.process.env;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.char.char_to_lower;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_contains_char;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.manifest.artifact.TmplVars;
use mach.lang.manifest.artifact.expand_project_path;
use mach.lang.manifest.parse;
use mach.lang.manifest.parse.StrArr;
use mach.lang.manifest.parse.TK_STEP;
use mach.lang.manifest.parse.check_keys;
use mach.lang.manifest.parse.check_path;
use mach.lang.manifest.parse.idstr;
use mach.lang.manifest.parse.is_valid_id;
use mach.lang.manifest.parse.parse_str_array;
use mach.lang.manifest.parse.sfmt;

pub rec StepDef {
    name:            intern.StrId;
    argv:            *intern.StrId;
    argv_count:      u32;
    env_keys:        *intern.StrId;
    env_values:      *intern.StrId;
    env_count:       u32;
    in:              *intern.StrId;
    in_count:        u32;
    out:             *intern.StrId;
    out_count:       u32;
    need:            *intern.StrId;
    need_count:      u32;
    timeout_seconds: i64;
}

pub fun step_parse_error(alloc: *A.Allocator, label: str, msg: str) err[outcome.Fail] {
    str_free(alloc, label);
    ret err[outcome.Fail].err{outcome.user(msg)};
}

pub fun step_parse_fail(alloc: *A.Allocator, label: str, f: outcome.Fail) err[outcome.Fail] {
    str_free(alloc, label);
    ret err[outcome.Fail].err{f};
}

pub fun env_key_compare(a: str, b: str) i64 {
    val an: usize = str_len(a);
    val bn: usize = str_len(b);
    var n:  usize = an;
    if (bn < n) { n = bn; }
    var i: usize = 0;
    for (i < n) {
        val ac: char = char_to_lower(a[i]::char);
        val bc: char = char_to_lower(b[i]::char);
        if (ac < bc) { ret -1; }
        if (ac > bc) { ret 1; }
        i = i + 1;
    }
    if (an < bn) { ret -1; }
    if (an > bn) { ret 1; }
    ret str_compare(a, b);
}

pub fun env_keys_ambiguous(left: str, right: str) res[bool, outcome.Fail] {
    val length: usize = str_len(left);
    if (length == str_len(right)) {
        var i: usize = 0;
        for (i < length && char_to_lower(left[i]::char) == char_to_lower(right[i]::char)) { i = i + 1; }
        if (i == length) { ret res[bool, outcome.Fail].ok{true}; }
    }
    $if ($mach.build.os == $mach.os.windows) {
        val order: res[i32, process_env.EnvError] = process_env.compare_names(left, right);
        if (sel order.err) { ret res[bool, outcome.Fail].err{outcome.user(outcome.env_text(order.err))}; }
        ret res[bool, outcome.Fail].ok{order.ok == 0};
    }
    $or { ret res[bool, outcome.Fail].ok{false}; }
}

pub fun parse_steps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, as_root: bool,
    out_steps: **StepDef, out_count: *u32) err[outcome.Fail] {
    @out_steps = nil;
    @out_count = 0;
    val tab_o: opt[*toml.Table] = toml.get_table(t, "step");
    if (sel tab_o.none) { ret err[outcome.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0)                { ret err[outcome.Fail].ok{}; }
    if (n > 0xFFFFFFFF::usize) { ret err[outcome.Fail].err{outcome.user("mach.toml: too many build steps")}; }

    val res_steps: res[*StepDef, A.Error] = A.allocate[StepDef](alloc, n);
    if (sel res_steps.err) { ret err[outcome.Fail].err{outcome.refused(res_steps.err)}; }
    val steps: *StepDef = res_steps.ok;
    @out_steps = steps;
    @out_count = n::u32;

    var initialized: usize = 0;
    for (initialized < n) {
        val slot: *StepDef = ?steps[initialized];
        slot.argv            = nil;
        slot.argv_count      = 0;
        slot.env_keys        = nil;
        slot.env_values      = nil;
        slot.env_count       = 0;
        slot.in              = nil;
        slot.in_count        = 0;
        slot.out             = nil;
        slot.out_count       = 0;
        slot.need            = nil;
        slot.need_count      = 0;
        slot.timeout_seconds = 0;
        initialized          = initialized + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str] = toml.table_key(tab, i);
        if (sel name_o.none) { brk; }
        val name: str              = name_o.some;
        val v_o:  opt[*toml.Value] = toml.table_value(tab, i);
        if (sel v_o.none) { brk; }
        val v:     *toml.Value = v_o.some;
        val label: str         = sfmt(alloc, "[step.{}]", name);
        if (v.tag != toml.TYPE_TABLE) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} must be a table", label));
        }
        val sub: *toml.Table = ?v.data.table;

        val cmd_o: opt[*toml.Value] = toml.get(sub, "cmd");
        if (sel cmd_o.some) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} uses removed key 'cmd'; use a nonempty 'argv' array", label));
        }
        val shell_o: opt[*toml.Value] = toml.get(sub, "shell");
        if (sel shell_o.some) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} uses removed key 'shell'; put the shell executable and its arguments in 'argv'", label));
        }

        val res_keys: err[outcome.Fail] = check_keys(alloc, sub, label, TK_STEP, as_root);
        if (sel res_keys.err) { ret step_parse_fail(alloc, label, res_keys.err); }

        val d: *StepDef = ?steps[i];
        if (!is_valid_id(name)) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} name must be an identifier (letters, digits, '_', '-')", label)); }
        val name_r: res[intern.StrId, A.Error] = intern.intern(itn, name);
        if (sel name_r.err) {
            ret step_parse_error(alloc, label, outcome.alloc_text(name_r.err));
        }
        d.name = name_r.ok;

        val argv_v_o: opt[*toml.Value] = toml.get(sub, "argv");
        if (sel argv_v_o.none) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'argv'", label)); }
        val argv_v: *toml.Value = argv_v_o.some;
        if (argv_v.tag != toml.TYPE_ARRAY) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.argv must be an array of strings", label)); }
        val res_argv: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, ?argv_v.data.array, label, "argv", false);
        if (sel res_argv.err) { ret step_parse_fail(alloc, label, res_argv.err); }
        val argv_val: StrArr = res_argv.ok;
        d.argv       = argv_val.items;
        d.argv_count = argv_val.count;
        if (argv_val.count == 0)                      { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.argv must be nonempty", label)); }
        if (str_empty(idstr(itn, argv_val.items[0]))) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.argv[0] must name an executable", label)); }

        val env_v_o: opt[*toml.Value] = toml.get(sub, "env");
        if (sel env_v_o.some) {
            val env_v: *toml.Value = env_v_o.some;
            if (env_v.tag != toml.TYPE_TABLE) {
                ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env must be a table", label));
            }
            val env_t: *toml.Table = ?env_v.data.table;
            val env_n: usize       = toml.table_len(env_t);
            if (env_n > 0xFFFFFFFF::usize) {
                ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env has too many entries", label));
            }
            if (env_n > 0) {
                val env_keys_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
                if (sel env_keys_r.err) { ret step_parse_fail(alloc, label, outcome.refused(env_keys_r.err)); }
                val env_values_r: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](alloc, env_n);
                if (sel env_values_r.err) {
                    A.deallocate[intern.StrId](alloc, env_keys_r.ok, env_n);
                    ret step_parse_fail(alloc, label, outcome.refused(env_values_r.err));
                }
                d.env_keys   = env_keys_r.ok;
                d.env_values = env_values_r.ok;
                d.env_count  = env_n::u32;
                var ei: usize = 0;
                for (ei < env_n) {
                    val env_key_o: opt[str] = toml.table_key(env_t, ei);
                    if (sel env_key_o.none) { brk; }
                    val env_key: str = env_key_o.some;
                    if (str_empty(env_key) || str_contains_char(env_key, '=')) {
                        ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env key '{}' must be nonempty and cannot contain '='", label, env_key));
                    }
                    var ej: usize = 0;
                    for (ej < ei) {
                        val prior:     str                     = idstr(itn, d.env_keys[ej]);
                        val ambiguous: res[bool, outcome.Fail] = env_keys_ambiguous(prior, env_key);
                        if (sel ambiguous.err) { ret step_parse_fail(alloc, label, ambiguous.err); }
                        if (ambiguous.ok) {
                            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env has ambiguous keys '{}' and '{}'", label, prior, env_key));
                        }
                        ej = ej + 1;
                    }
                    val env_value_o: opt[*toml.Value] = toml.table_value(env_t, ei);
                    if (sel env_value_o.none) { brk; }
                    val env_value: *toml.Value = env_value_o.some;
                    if (env_value == nil || env_value.tag != toml.TYPE_STRING) {
                        ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.env.{} must be a string", label, env_key));
                    }
                    val env_key_r: res[intern.StrId, A.Error] = intern.intern(itn, env_key);
                    if (sel env_key_r.err) {
                        ret step_parse_error(alloc, label, outcome.alloc_text(env_key_r.err));
                    }
                    val env_value_r: res[intern.StrId, A.Error] = intern.intern(itn, env_value.data.string);
                    if (sel env_value_r.err) {
                        ret step_parse_error(alloc, label, outcome.alloc_text(env_value_r.err));
                    }
                    d.env_keys[ei]   = env_key_r.ok;
                    d.env_values[ei] = env_value_r.ok;
                    ei               = ei + 1;
                }
                ei = 1;
                for (ei < env_n) {
                    val key:   intern.StrId = d.env_keys[ei];
                    val value: intern.StrId = d.env_values[ei];
                    var ej:    usize        = ei;
                    for (ej > 0 && env_key_compare(idstr(itn, key), idstr(itn, d.env_keys[ej - 1])) < 0) {
                        d.env_keys[ej]   = d.env_keys[ej - 1];
                        d.env_values[ej] = d.env_values[ej - 1];
                        ej               = ej - 1;
                    }
                    d.env_keys[ej]   = key;
                    d.env_values[ej] = value;
                    ei               = ei + 1;
                }
            }
        }

        val in_arr_o: opt[*toml.Array] = toml.get_array(sub, "in");
        if (sel in_arr_o.none) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'in'", label)); }
        val in_arr: *toml.Array               = in_arr_o.some;
        val res_in: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, in_arr, label, "in", false);
        if (sel res_in.err) { ret step_parse_fail(alloc, label, res_in.err); }
        val in_val: StrArr = res_in.ok;
        d.in       = in_val.items;
        d.in_count = in_val.count;
        var ii: u32 = 0;
        for (ii < d.in_count) {
            val p:         str               = idstr(itn, d.in[ii]);
            val in_field:  str               = sfmt(alloc, "{}.in", label);
            val res_check: err[outcome.Fail] = check_path(alloc, p, in_field);
            str_free(alloc, in_field);
            if (sel res_check.err) { ret step_parse_fail(alloc, label, res_check.err); }
            ii = ii + 1;
        }

        val out_arr_o: opt[*toml.Array] = toml.get_array(sub, "out");
        if (sel out_arr_o.none) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'out'", label)); }
        val out_arr: *toml.Array               = out_arr_o.some;
        val res_out: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, out_arr, label, "out", false);
        if (sel res_out.err) { ret step_parse_fail(alloc, label, res_out.err); }
        val out_val: StrArr = res_out.ok;
        d.out       = out_val.items;
        d.out_count = out_val.count;
        ii          = 0;
        for (ii < d.out_count) {
            val p: str = idstr(itn, d.out[ii]);
            if (str_contains_char(p, '*')) { ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.out cannot contain a glob '*'; outputs must be concrete paths", label)); }
            val out_path_field: str               = sfmt(alloc, "{}.out", label);
            val res_check:      err[outcome.Fail] = check_path(alloc, p, out_path_field);
            str_free(alloc, out_path_field);
            if (sel res_check.err) { ret step_parse_fail(alloc, label, res_check.err); }
            ii = ii + 1;
        }

        val need_arr_o: opt[*toml.Array] = toml.get_array(sub, "need");
        if (sel need_arr_o.none && as_root) {
            ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {} is missing required key 'need' (use [] for none)", label));
        }
        if (sel need_arr_o.some) {
            val need_arr: *toml.Array               = need_arr_o.some;
            val res_need: res[StrArr, outcome.Fail] = parse_str_array(alloc, itn, need_arr, label, "need", false);
            if (sel res_need.err) { ret step_parse_fail(alloc, label, res_need.err); }
            val need_val: StrArr = res_need.ok;
            d.need       = need_val.items;
            d.need_count = need_val.count;
        }

        val timeout_v_o: opt[*toml.Value] = toml.get(sub, "timeout_seconds");
        if (sel timeout_v_o.some) {
            val timeout_v: *toml.Value = timeout_v_o.some;
            if (timeout_v.tag != toml.TYPE_INTEGER) {
                ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.timeout_seconds must be an integer number of seconds", label));
            }
            val timeout_n: i64 = timeout_v.data.integer;
            if (timeout_n < 1) {
                ret step_parse_error(alloc, label, sfmt(alloc, "mach.toml: {}.timeout_seconds must be at least 1; omit the key for an unbounded step", label));
            }
            d.timeout_seconds = timeout_n;
        }

        str_free(alloc, label);
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

pub fun find_step_index(steps: *StepDef, step_count: u32, name: intern.StrId) i64 {
    var i: u32 = 0;
    for (i < step_count) {
        if (steps[i].name == name) { ret i::i64; }
        i = i + 1;
    }
    ret -1;
}

pub fun step_producing_out(alloc: *A.Allocator, itn: *intern.Interner, steps: *StepDef, step_count: u32,
    expanded_path: str, proj_out: str, v: *TmplVars) i64 {
    var si: u32 = 0;
    for (si < step_count) {
        val s:  *StepDef = ?steps[si];
        var oi: u32      = 0;
        for (oi < s.out_count) {
            val raw_out: str                    = idstr(itn, s.out[oi]);
            val exp_r:   res[str, outcome.Fail] = expand_project_path(alloc, raw_out, proj_out, v, "a build step output");
            if (sel exp_r.ok) {
                val exp: str  = exp_r.ok;
                val eq:  bool = str_equals(exp, expanded_path);
                str_free(alloc, exp);
                if (eq) { ret si::i64; }
            }
            oi = oi + 1;
        }
        si = si + 1;
    }
    ret -1;
}

pub fun local_path_demanded_by_step(alloc: *A.Allocator, itn: *intern.Interner, steps: *StepDef, step_count: u32,
    expanded_path: str, proj_out: str, v: *TmplVars) bool {
    ret step_producing_out(alloc, itn, steps, step_count, expanded_path, proj_out, v) >= 0;
}
