# `--set`: a manifest key written over every table of its section for one invocation. the key
# and its value are read by the rows and decoders that read the key in a manifest, so a value
# `--set` gives is held to every rule the key keeps in mach.toml
use mach.lang.fail;
use std.data.toml;
use std.text.string.str_free;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.manifest.artifact.artifact_set;
use mach.lang.manifest.model.ArtifactDef;
use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.Origin;
use mach.lang.manifest.model.TargetDef;
use mach.lang.manifest.schema;
use mach.lang.manifest.target.target_set;
use lang_source: mach.lang.source;

# one `--set <key>=<value>`, split at its first `=`
# ---
# key:   the manifest key, as mach.toml writes it
# value: the value, as written
pub rec Assignment {
    key:   str;
    value: str;
}

# write each assignment over every table of its key's section in `m`, in order, so a later
# assignment of a key wins
# ---
# alloc: owns a refusal's text
# itn:   receives the strings
# m:     the manifest, its native target included
# list:  the assignments
# n:     length of `list`
# ret:   ok, or the refusal of the first key `--set` does not write or value its key does not accept
pub fun apply(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, list: *Assignment, n: usize) err[fail.Fail] {
    var i: usize = 0;
    for (i < n) {
        val read: res[schema.Setting, fail.Fail] = schema.setting(alloc, list[i].key, list[i].value);
        if (sel read.err) { ret err[fail.Fail].err{read.err}; }
        var s:       schema.Setting = read.ok;
        val written: err[fail.Fail] = written_resolved(alloc, itn, m, ?s);
        toml.dnit(alloc, ?s.doc);
        if (sel written.err) {
            val placed: fail.Fail = fail.placed(alloc, written.err, schema.SET_PATH, s.text);
            str_free(alloc, s.text);
            ret err[fail.Fail].err{placed};
        }
        str_free(alloc, s.text);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# write one setting over `m`, then resolve where it wrote each value
fun written_resolved(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, s: *schema.Setting) err[fail.Fail] {
    val written: err[fail.Fail] = write(alloc, itn, m, s);
    if (sel written.err) { ret written; }
    ret resolve(alloc, m, s.text);
}

# resolve in the `--set` text every place a value it wrote records, so a later refusal of the
# value points at the `--set` that wrote it. a place mach.toml wrote is resolved already
fun resolve(alloc: *A.Allocator, m: *Manifest, text: str) err[fail.Fail] {
    val lines_r: res[lang_source.Lines, A.Error] = lang_source.lines_init(alloc, text::*u8, str_len(text));
    if (sel lines_r.err) { ret err[fail.Fail].err{fail.refused(lines_r.err)}; }
    var lines: lang_source.Lines = lines_r.ok;
    var t:     u32               = 0;
    for (t < m.target_count) {
        target_resolve(?lines, ?m.targets[t]);
        t = t + 1;
    }
    if (m.native_target != nil) { target_resolve(?lines, m.native_target); }
    var k: u32 = 0;
    for (k < m.artifact_count) {
        resolved(?lines, ?m.artifacts[k].subsystem_from);
        k = k + 1;
    }
    lang_source.lines_dnit(alloc, ?lines);
    ret err[fail.Fail].ok{};
}

fun target_resolve(lines: *lang_source.Lines, d: *TargetDef) {
    resolved(lines, ?d.platform_from);
    resolved(lines, ?d.base_from);
    resolved(lines, ?d.stack_reserve_from);
    resolved(lines, ?d.stack_commit_from);
}

fun resolved(lines: *lang_source.Lines, o: *Origin) {
    if (o.at.spanned && o.at.path == nil) { o.at = fail.place(schema.SET_PATH, lines, o.at.span); }
}

fun write(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, s: *schema.Setting) err[fail.Fail] {
    if (str_equals(s.section, "target")) {
        var t: u32 = 0;
        for (t < m.target_count) {
            val set: err[fail.Fail] = target_set(alloc, itn, ?s.doc, nil, ?m.targets[t]);
            if (sel set.err) { ret set; }
            t = t + 1;
        }
        if (m.native_target != nil) { ret target_set(alloc, itn, ?s.doc, nil, m.native_target); }
        ret err[fail.Fail].ok{};
    }
    if (str_equals(s.section, "artifact")) {
        # the value is refused in a project that declares no artifact as in one that does
        var probe: ArtifactDef;
        val read:  err[fail.Fail] = artifact_set(alloc, itn, nil, ?s.doc, ?probe);
        if (sel read.err) { ret read; }
        var k: u32 = 0;
        for (k < m.artifact_count) {
            val set: err[fail.Fail] = artifact_set(alloc, itn, nil, ?s.doc, ?m.artifacts[k]);
            if (sel set.err) { ret set; }
            k = k + 1;
        }
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("internal: a key the schema marks for --set belongs to a section --set does not write")};
}
