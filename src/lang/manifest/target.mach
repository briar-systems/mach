# the host as `mach info` names it, by `tuple_of`
# ---
# alloc: owns the returned string
# ret:   the formatted tuple; err when the allocator refused it
pub fun host_tuple(alloc: *A.Allocator) res[str, fail.Fail] {
    ret tuple_of(alloc, lang_target.host_sys_name(), lang_target.host_arch_name());
}

# the one spelling of a (sys, arch) pair, "<sys>-<arch>", e.g. "linux-x86_64"
# ---
# alloc:    owns the returned string
# os_name:  the system's name
# isa_name: the architecture's name
# ret:      the formatted tuple; err when the allocator refused it
pub fun tuple_of(alloc: *A.Allocator, os_name: str, isa_name: str) res[str, fail.Fail] {
    ret sfmt(alloc, "{}-{}", os_name, isa_name);
}

# `[target.X].ext`: an array of names of masc's extension catalog, each listed
# once. the names are checked against masc's catalog of the architecture when
# the target resolves
fun parse_target_extensions(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, label: str,
    d: *TargetDef) err[fail.Fail] {
    val v_o: opt[*toml_value.Value] = toml_lookup.get(sub, "ext");
    if (sel v_o.none) { ret err[fail.Fail].ok{}; }
    val v:   *toml_value.Value = v_o.some;
    val arr: *toml_value.Array = ?v.data.array;
    val n:   usize             = toml_lookup.array_len(arr);
    if (n > resolved.MAX_ADDED::usize) {
        ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_TOO_MANY, "mach.toml: {}.ext names more than {} extensions", label, resolved.MAX_ADDED), v.span);
    }
    var i: usize = 0;
    for (i < n) {
        val e_o: opt[*toml_value.Value] = toml_lookup.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e:    *toml_value.Value = e_o.some;
        val name: str               = e.data.string;
        if (str_len(name) == 0) {
            ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_INVALID_NAME, "mach.toml: {}.ext entry \"\" names no extension", label), e.span);
        }
        val id_r: res[intern.StrId, fail.Fail] = id_of(itn, name);
        if (sel id_r.err) { ret err[fail.Fail].err{id_r.err}; }
        val id: intern.StrId = id_r.ok;
        var j:  u32          = 0;
        for (j < d.ext_count) {
            if (intern.str_same(d.ext[j], id)) {
                ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_DUPLICATE, "mach.toml: {}.ext lists \"{}\" twice", label, name), e.span);
            }
            j = j + 1;
        }
        d.ext[d.ext_count] = id;
        d.ext_count        = d.ext_count + 1;
        i                  = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun parse_targets(alloc: *A.Allocator, itn: *intern.Interner, t: *toml_value.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml_value.Table] = toml_lookup.get_table(t, "target");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml_value.Table = tab_o.some;
    val n:   usize             = toml_lookup.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_targets: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, n);
    if (sel res_targets.err) { ret err[fail.Fail].err{fail.refused(res_targets.err)}; }
    m.targets      = res_targets.ok;
    m.target_count = n::u32;
    var cleared: usize = 0;
    for (cleared < n) {
        m.targets[cleared] = target_def();
        cleared            = cleared + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]               = toml_lookup.table_key(tab, i);
        val v_o:    opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val name: str = name_o.some;
        if (str_equals(name, "native")) {
            ret fail_at(fail.user(diagnostic_kind.TARGET_RESERVED_NAME, "mach.toml: [target.native] is reserved; 'native' resolves to a declared target"), key_span(tab, i));
        }
        val label: res[str, fail.Fail] = sfmt(alloc, "[target.{}]", name);
        if (sel label.err) { ret err[fail.Fail].err{label.err}; }
        val decoded: err[fail.Fail] = target_decode(alloc, itn, tab, i, label.ok, ?m.targets[i]);
        str_free(alloc, label.ok);
        if (sel decoded.err) { ret decoded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a spelling a target key no longer takes, and mink's name for the row it meant
# ---
# key:  the target key
# was:  the key's previous name, which a manifest of the previous major writes it under; "" for none
# old:  the retired spelling
# new:  the spelling that replaces it, mink's name for the row
# arch: the architecture the spelling is retired under, "" under every one
rec Retired {
    key:  str;
    was:  str;
    old:  str;
    new:  str;
    arch: str;
}

# raw and spv were mach's own names for mink's flat and spirv formats, and a spir-v
# module's system is vulkan, never freestanding, under the shader convention v6 named spirv
val RETIRED_COUNT: usize                  = 4;
val RETIRED:       [RETIRED_COUNT]Retired = [RETIRED_COUNT]Retired{
    Retired{key: "of", was: "", old: "raw", new: "flat", arch: ""},
    Retired{key: "of", was: "", old: "spv", new: "spirv", arch: ""},
    Retired{key: "sys", was: "os", old: "freestanding", new: "vulkan", arch: "spirv"},
    Retired{key: "abi", was: "", old: "spirv", new: "shader", arch: "spirv"},
};

# the architecture the target table `sub` names: its `arch`, or where it writes none, the
# previous major's `isa` when that names an architecture; "" for none
fun arch_written(sub: *toml_value.Table) str {
    val arch: opt[*toml_value.Value] = toml_lookup.get(sub, "arch");
    if (sel arch.some) { ret key_text(sub, "arch"); }
    val isa: str = key_text(sub, "isa");
    if (target_tags.arch_named(isa) != target_tags.NONE) { ret isa; }
    ret "";
}

# the value of the retired spelling `r` the target table `sub` writes, under the key or its
# previous name; nil when it writes none
fun retired_value(sub: *toml_value.Table, r: *Retired) *toml_value.Value {
    var v: opt[*toml_value.Value] = toml_lookup.get(sub, r.key);
    if (sel v.none && str_len(r.was) != 0)                              { v = toml_lookup.get(sub, r.was); }
    if (sel v.none)                                                     { ret nil; }
    if (v.some.tag != toml_value.TYPE_STRING)                           { ret nil; }
    if (!str_equals(v.some.data.string, r.old))                         { ret nil; }
    if (str_len(r.arch) != 0 && !str_equals(arch_written(sub), r.arch)) { ret nil; }
    ret v.some;
}

# the refusal of a retired spelling the target table `sub` writes, carrying the
# rewrite to the new one
fun refuse_retired(alloc: *A.Allocator, sub: *toml_value.Table, label: str) err[fail.Fail] {
    var i: usize = 0;
    for (i < RETIRED_COUNT) {
        val r: *Retired          = ?RETIRED[i];
        val v: *toml_value.Value = retired_value(sub, r);
        i = i + 1;
        if (v == nil) { cnt; }
        val f: fail.Fail = refuse(alloc, diagnostic_kind.TARGET_RETIRED_SPELLING,
            "mach.toml: {}.{} = \"{}\" is a retired spelling; write \"{}\", mink's name for it", label, r.key, r.old, r.new);
        val fix: res[str, fail.Fail] = sfmt(alloc, "\"{}\"", r.new);
        if (sel fix.err) { ret err[fail.Fail].err{fix.err}; }
        val what: res[str, fail.Fail] = sfmt(alloc, "write `{} = \"{}\"`", r.key, r.new);
        if (sel what.err) { ret err[fail.Fail].err{what.err}; }
        val at: lang_source.Span = lang_source.span(v.span.at, v.span.len);
        ret fail_at(fail.with_fix(alloc, f, what.ok, opt[lang_source.Span].some{at}, fix.ok), v.span);
    }
    ret err[fail.Fail].ok{};
}

# mink's architecture that enters the instruction set `written` spells, nil when `written` names
# an architecture itself or none enters it
fun entering(alloc: *A.Allocator, written: str) *mink_arch.Arch {
    if (target_tags.arch_named(written) != target_tags.NONE) { ret nil; }
    ret target_baseline.entered_by(alloc, written);
}

# what replaces the value of an `arch` written as the instruction set `written`, which `arch`
# enters: the architecture, and the instruction set as `isa` when the table writes none
fun selection_fix(alloc: *A.Allocator, sub: *toml_value.Table, written: str, arch: *mink_arch.Arch) res[str, fail.Fail] {
    val stated: opt[*toml_value.Value] = toml_lookup.get(sub, "isa");
    if (sel stated.some) { ret sfmt(alloc, "\"{}\"", arch.name); }
    ret sfmt(alloc, "\"{}\"\nisa = \"{}\"", arch.name, written);
}

# the refusal of an `arch` the target table `sub` writes as an instruction set,
# as `rv32imc`: the architecture is mink's name for the one that enters the
# instruction set, which is the target's `isa`, so the fix rewrites the one key
# into the two
fun refuse_arch_selection(alloc: *A.Allocator, sub: *toml_value.Table, label: str) err[fail.Fail] {
    val v: opt[*toml_value.Value] = toml_lookup.get(sub, "arch");
    if (sel v.none) { ret err[fail.Fail].ok{}; }
    val written: str             = key_text(sub, "arch");
    val arch:    *mink_arch.Arch = entering(alloc, written);
    if (arch == nil) { ret err[fail.Fail].ok{}; }
    val name: str       = arch.name;
    var f:    fail.Fail = refuse(alloc, diagnostic_kind.TARGET_RETIRED_SPELLING,
        "mach.toml: {}.arch = \"{}\" names an instruction set; write `arch = \"{}\"`, mink's name for the architecture, and `isa = \"{}\"`", label, written, name, written);
    var what:   res[str, fail.Fail]    = sfmt(alloc, "write `arch = \"{}\"` and `isa = \"{}\"`", name, written);
    val stated: opt[*toml_value.Value] = toml_lookup.get(sub, "isa");
    if (sel stated.some) {
        f = refuse(alloc, diagnostic_kind.TARGET_RETIRED_SPELLING,
            "mach.toml: {}.arch = \"{}\" names an instruction set; write `arch = \"{}\"`, mink's name for the architecture", label, written, name);
        what = sfmt(alloc, "write `arch = \"{}\"`", name);
    }
    val fix: res[str, fail.Fail] = selection_fix(alloc, sub, written, arch);
    if (sel fix.err)  { ret err[fail.Fail].err{fix.err}; }
    if (sel what.err) { ret err[fail.Fail].err{what.err}; }
    val at: lang_source.Span = lang_source.span(v.some.span.at, v.some.span.len);
    ret fail_at(fail.with_fix(alloc, f, what.ok, opt[lang_source.Span].some{at}, fix.ok), v.some.span);
}

# every rewrite of a target spelling the previous major wrote, as fixes of the manifest's text,
# which `mach migrate` applies: each retired spelling and each `arch` written as an instruction
# set, as the refusals above fix them, and the previous major's `isa` written as an instruction
# set where the table writes no `arch`, which names the architecture that enters it beside it
# ---
# alloc: owns the fixes' text and storage
# doc:   the document root, a manifest of either major
# out:   receives the fixes, in no order
# ret:   ok, or the refusal of an allocation
pub fun rewrites(alloc: *A.Allocator, doc: *toml_value.Table, out: *Vector[Fix]) err[fail.Fail] {
    val targets: opt[*toml_value.Table] = toml_lookup.get_table(doc, "target");
    if (sel targets.none) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < toml_lookup.table_len(targets.some)) {
        val entry: opt[*toml_value.Value] = toml_lookup.table_value(targets.some, i);
        i = i + 1;
        if (sel entry.none)                          { cnt; }
        if (entry.some.tag != toml_value.TYPE_TABLE) { cnt; }
        val sub: *toml_value.Table = ?entry.some.data.table;
        var r:   usize             = 0;
        for (r < RETIRED_COUNT) {
            val row: *Retired          = ?RETIRED[r];
            val v:   *toml_value.Value = retired_value(sub, row);
            r = r + 1;
            if (v == nil) { cnt; }
            val text: res[str, fail.Fail] = sfmt(alloc, "\"{}\"", row.new);
            if (sel text.err) { ret err[fail.Fail].err{text.err}; }
            val pushed: err[fail.Fail] = fix_push(out, Fix{at: v.span.at, len: v.span.len, text: text.ok, pad: 0});
            if (sel pushed.err) { ret pushed; }
        }
        val arch: opt[*toml_value.Value] = toml_lookup.get(sub, "arch");
        if (sel arch.some) {
            if (arch.some.tag != toml_value.TYPE_STRING) { cnt; }
            val entered: *mink_arch.Arch = entering(alloc, arch.some.data.string);
            if (entered == nil) { cnt; }
            val text: res[str, fail.Fail] = selection_fix(alloc, sub, arch.some.data.string, entered);
            if (sel text.err) { ret err[fail.Fail].err{text.err}; }
            val pushed: err[fail.Fail] = fix_push(out, Fix{at: arch.some.span.at, len: arch.some.span.len, text: text.ok, pad: 0});
            if (sel pushed.err) { ret pushed; }
            cnt;
        }
        val isa: opt[*toml_value.Value] = toml_lookup.get(sub, "isa");
        if (sel isa.none)                           { cnt; }
        if (isa.some.tag != toml_value.TYPE_STRING) { cnt; }
        val entered: *mink_arch.Arch = entering(alloc, isa.some.data.string);
        if (entered == nil) { cnt; }
        val text: res[str, fail.Fail] = sfmt(alloc, "arch = \"{}\"\nisa", entered.name);
        if (sel text.err) { ret err[fail.Fail].err{text.err}; }
        val pushed: err[fail.Fail] = fix_push(out, Fix{at: isa.some.key.at, len: isa.some.key.len, text: text.ok, pad: 0});
        if (sel pushed.err) { ret pushed; }
    }
    ret err[fail.Fail].ok{};
}

fun fix_push(out: *Vector[Fix], fix: Fix) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[Fix](out, fix);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the target table at entry `i` of `[target]`, labelled `label`
fun target_decode(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml_value.Table, i: usize, label: str, d: *TargetDef) err[fail.Fail] {
    val v_o: opt[*toml_value.Value] = toml_lookup.table_value(tab, i);
    val k_o: opt[str]               = toml_lookup.table_key(tab, i);
    if (sel v_o.none) { ret err[fail.Fail].err{fail.message("internal: a [target] entry index is outside its table")}; }
    if (sel k_o.none) { ret err[fail.Fail].err{fail.message("internal: a [target] entry index is outside its table")}; }
    val sub:     *toml_value.Table = ?v_o.some.data.table;
    val retired: err[fail.Fail]    = refuse_retired(alloc, sub, label);
    if (sel retired.err) { ret retired; }
    val selection: err[fail.Fail] = refuse_arch_selection(alloc, sub, label);
    if (sel selection.err) { ret selection; }
    var ids:   [8]intern.StrId;
    var texts: [8]str = [8]str{k_o.some, key_text(sub, "arch"), key_text(sub, "sys"), key_text(sub, "abi"), key_text(sub, "of"), key_text(sub, "env"), key_text(sub, "isa"), key_text(sub, "code_model")};
    var k:     usize  = 0;
    for (k < 8) {
        var r: res[intern.StrId, fail.Fail];
        if (k < 4)     { r = id_of(itn, texts[k]); }
        or             { r = optional_id_of(itn, texts[k]); }
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        ids[k] = r.ok;
        k      = k + 1;
    }
    d.name       = ids[0];
    d.at         = span_site(key_span(tab, i));
    d.arch       = ids[1];
    d.sys        = ids[2];
    d.abi        = ids[3];
    d.of         = ids[4];
    d.env        = ids[5];
    d.isa        = ids[6];
    d.code_model = ids[7];
    val set: err[fail.Fail] = target_set(alloc, itn, sub, label, d);
    if (sel set.err) { ret set; }
    val extended: err[fail.Fail] = parse_target_extensions(alloc, itn, sub, label, d);
    if (sel extended.err) { ret extended; }
    ret parse_target_runner(alloc, itn, sub, label, d);
}

# every key `--set` writes over a target that the table `sub` holds, decoded over `d` with where
# it was written; a key `sub` does not hold leaves `d` as it is
# ---
# alloc: owns a refusal's text
# itn:   receives the strings
# sub:   the table
# lead:  the table's label in mach.toml, nil for a `--set` value
# d:     the target
# ret:   ok, or the refusal of a value its key does not take, or a refused allocation
pub fun target_set(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, lead: str, d: *TargetDef) err[fail.Fail] {
    val platform: opt[str] = toml_lookup.get_str(sub, "platform");
    if (sel platform.some) {
        val id: res[intern.StrId, fail.Fail] = optional_id_of(itn, platform.some);
        if (sel id.err) { ret err[fail.Fail].err{id.err}; }
        val from: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, "platform");
        if (sel from.err) { ret err[fail.Fail].err{from.err}; }
        d.platform      = id.ok;
        d.platform_from = from.ok;
    }
    val base: err[fail.Fail] = size_set(alloc, itn, sub, lead, "base", ?d.base, ?d.base_from);
    if (sel base.err) { ret base; }
    val reserve: err[fail.Fail] = size_set(alloc, itn, sub, lead, "stack_reserve", ?d.stack_reserve, ?d.stack_reserve_from);
    if (sel reserve.err) { ret reserve; }
    ret size_set(alloc, itn, sub, lead, "stack_commit", ?d.stack_commit, ?d.stack_commit_from);
}

# an optional address or byte count over `into` and where it was written over `from`, both left
# as they are when the key is not written. a negative value is refused, since it names no address
# and no size
fun size_set(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, lead: str, key: str, into: *u64, from: *Origin) err[fail.Fail] {
    val v: opt[i64] = toml_lookup.get_int(sub, key);
    if (sel v.none) { ret err[fail.Fail].ok{}; }
    val written: res[Origin, fail.Fail] = origin(alloc, itn, sub, lead, key);
    if (sel written.err) { ret err[fail.Fail].err{written.err}; }
    if (v.some < 0) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "{}: must not be negative, as it is an address or a size in bytes", written.ok.named), value_span(sub, key));
    }
    @into = v.some::u64;
    @from = written.ok;
    ret err[fail.Fail].ok{};
}

# `[target.X].runner`: the argv templates the target's programs are launched
# through, nonempty with an executable first. the templates are checked when the
# manifest loads, with every other template
fun parse_target_runner(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml_value.Table, label: str, d: *TargetDef) err[fail.Fail] {
    val v_o: opt[*toml_value.Value] = toml_lookup.get(sub, "runner");
    if (sel v_o.none) { ret err[fail.Fail].ok{}; }
    val arr:     *toml_value.Array      = ?v_o.some.data.array;
    val decoded: res[StrArr, fail.Fail] = ids_of(alloc, itn, arr, label, "runner");
    if (sel decoded.err) { ret err[fail.Fail].err{decoded.err}; }
    d.runner       = decoded.ok.items;
    d.runner_count = decoded.ok.count;
    val placed: res[*lang_source.Location, fail.Fail] = element_sites(alloc, arr);
    if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
    d.runner_at = placed.ok;
    if (d.runner_count == 0) { ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.runner must be nonempty", label), v_o.some.span); }
    if (str_len(intern.text(itn, d.runner[0])) == 0) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.runner[0] must name an executable", label), element_span(arr, 0));
    }
    ret err[fail.Fail].ok{};
}

# the target `m` declares under `name`, nil when none is
pub fun find_target_by_name(itn: *intern.Interner, m: *Manifest, name: str) *TargetDef {
    var i: u32 = 0;
    for (i < m.target_count) {
        if (str_equals(intern.text(itn, m.targets[i].name), name)) { ret ?m.targets[i]; }
        i = i + 1;
    }
    ret nil;
}

# resolve a declared target with every key it states: the one place a `[target.<name>]`
# table becomes mink's spelling and narrowing
# ---
# alloc:        owns a refusal's text
# itn:          resolves the target's strings
# d:            the target
# linkage:      the name of the linkage of the executable under build, nil for the host's
#               default, which mink resolves against the host
# linkage_from: where `linkage` was written, which a refusal of it names and points at;
#               nil where it was written nowhere
# ret:          the target; err the owners' refusal, naming the target
pub fun resolve_declared(alloc: *A.Allocator, itn: *intern.Interner, d: *TargetDef, linkage: intern.StrId, linkage_from: *Origin) res[resolved.Target, fail.Fail] {
    # a target the manifest does not name is labelled by its arch
    var label: str = intern.text(itn, d.arch);
    if (!intern.str_is_nil(d.name) && str_len(intern.text(itn, d.name)) != 0) { label = intern.text(itn, d.name); }
    val spec: res[mink_target.Spec, fail.Fail] = resolved.spec_of(alloc, diagnostic_kind.TARGET_UNSUPPORTED, intern.text(itn, d.sys), intern.text(itn, d.arch));
    if (sel spec.err) { ret res[resolved.Target, fail.Fail].err{declared_refusal(alloc, label, spec.err)}; }
    var n: mink_target.Narrowing = mink_target.UNNARROWED;
    n.env        = stated(itn, d.env);
    n.abi        = stated(itn, d.abi);
    n.isa        = stated(itn, d.isa);
    n.code_model = stated(itn, d.code_model);
    n.format     = stated(itn, d.of);
    n.linkage    = stated(itn, linkage);
    var ext_names: [resolved.MAX_ADDED]str;
    var ei:        u32 = 0;
    for (ei < d.ext_count) {
        ext_names[ei] = intern.text(itn, d.ext[ei]);
        ei            = ei + 1;
    }
    n.ext       = ?ext_names[0];
    n.ext_count = d.ext_count::usize;
    val image: resolved.Image                         = resolved.Image{base: d.base, stack_reserve: d.stack_reserve, stack_commit: d.stack_commit};
    val t:     res[resolved.Target, resolved.Refused] = resolved.resolve(alloc, spec.ok, ?n, image);
    if (sel t.ok) { ret res[resolved.Target, fail.Fail].ok{t.ok}; }
    if (t.err.part != nil && str_equals(t.err.part, mink_target.part_name(mink_target.Part.linkage{})) && linkage_from != nil) {
        val said: res[str, fail.Fail] = sfmt(alloc, "{}: {}", linkage_from.named, fail.describe(t.err.why));
        if (sel said.err) { ret res[resolved.Target, fail.Fail].err{said.err}; }
        ret res[resolved.Target, fail.Fail].err{fail.at(fail.user(diagnostic_kind.MANIFEST_INVALID_VALUE, said.ok), linkage_from.at)};
    }
    ret res[resolved.Target, fail.Fail].err{declared_refusal(alloc, label, t.err.why)};
}

# the text a key states, nil where it states none
fun stated(itn: *intern.Interner, id: intern.StrId) str {
    if (intern.str_is_nil(id)) { ret nil; }
    val text: str = intern.text(itn, id);
    if (str_len(text) == 0) { ret nil; }
    ret text;
}

# `why` said of the target table `label`, of its own kind
fun declared_refusal(alloc: *A.Allocator, label: str, why: fail.Fail) fail.Fail {
    val said: res[str, fail.Fail] = sfmt(alloc, "mach.toml: [target.{}]: {}", label, fail.describe(why));
    if (sel said.err) { ret said.err; }
    ret fail.user(fail.kind_of(why), said.ok);
}

# whether a target's `sys` and `arch` name the host the compiler runs on. the abi is not compared
# ---
# itn: resolves the target's strings
# d:   the target
# ret: true when both names are the host's
pub fun target_matches_host(itn: *intern.Interner, d: *TargetDef) bool {
    ret str_equals(intern.text(itn, d.sys), lang_target.host_sys_name()) && str_equals(intern.text(itn, d.arch), lang_target.host_arch_name());
}

# whether `native` could ever name the target: its system has a host row whose
# environment and architecture the target states, so a build could run on one. a
# freestanding or vulkan target is only ever selected by name
pub fun target_is_hosted(itn: *intern.Interner, d: *TargetDef) bool {
    val sys: res[*mink_os.System, mink_fail.Fail] = mink_os_list.by_name(intern.text(itn, d.sys));
    if (sel sys.err) { ret false; }
    ret sys.ok.mapped;
}

pub fun make_native_target(alloc: *A.Allocator, itn: *intern.Interner) res[*TargetDef, fail.Fail] {
    var host: TargetDef                    = target_def();
    val name: res[intern.StrId, fail.Fail] = id_of(itn, "native");
    if (sel name.err) { ret res[*TargetDef, fail.Fail].err{name.err}; }
    host.name = name.ok;
    val isa_name: res[intern.StrId, fail.Fail] = id_of(itn, lang_target.host_arch_name());
    if (sel isa_name.err) { ret res[*TargetDef, fail.Fail].err{isa_name.err}; }
    host.arch = isa_name.ok;
    val os_name: res[intern.StrId, fail.Fail] = id_of(itn, lang_target.host_sys_name());
    if (sel os_name.err) { ret res[*TargetDef, fail.Fail].err{os_name.err}; }
    host.sys = os_name.ok;
    val abi_name: res[intern.StrId, fail.Fail] = id_of(itn, lang_target.host_abi_name());
    if (sel abi_name.err) { ret res[*TargetDef, fail.Fail].err{abi_name.err}; }
    host.abi = abi_name.ok;
    val owned: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, 1);
    if (sel owned.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(owned.err)}; }
    @owned.ok = host;
    ret res[*TargetDef, fail.Fail].ok{owned.ok};
}
