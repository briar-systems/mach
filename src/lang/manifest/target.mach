pub fun host_isa_name() str {
    ret isa.arch_name_for(lang_target.host_arch_id());
}

pub fun host_os_name() str {
    ret lang_target_os.os_name_for(lang_target.host_os_id());
}

# the host as `mach info` names it, by `tuple_of`
# ---
# alloc: owns the returned string
# ret:   the formatted tuple; err when the allocator refused it
pub fun host_tuple(alloc: *A.Allocator) res[str, fail.Fail] {
    ret tuple_of(alloc, host_os_name(), host_isa_name());
}

# the one spelling of an (os, isa) pair, "<os>-<isa>", e.g. "linux-x86_64"
# ---
# alloc:    owns the returned string
# os_name:  the os name
# isa_name: the isa name
# ret:      the formatted tuple; err when the allocator refused it
pub fun tuple_of(alloc: *A.Allocator, os_name: str, isa_name: str) res[str, fail.Fail] {
    ret sfmt(alloc, "{}-{}", os_name, isa_name);
}

# `[target.X].extensions`: an array of extension names, each an identifier and
# listed once. the names are checked against the isa's vocabulary when the
# target resolves, since only the registry holds it
fun parse_target_extensions(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, label: str,
    d: *TargetDef) err[fail.Fail] {
    d.extension_count = 0;
    val v_o: opt[*toml.Value] = toml.get(sub, "extensions");
    if (sel v_o.none) { ret err[fail.Fail].ok{}; }
    val v:   *toml.Value = v_o.some;
    val arr: *toml.Array = ?v.data.array;
    val n:   usize       = toml.array_len(arr);
    if (n > extension.MAX_SELECTED::usize) {
        ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_TOO_MANY, "mach.toml: {}.extensions names more than {} extensions", label, extension.MAX_SELECTED), v.span);
    }
    var i: usize = 0;
    for (i < n) {
        val e_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e:    *toml.Value = e_o.some;
        val name: str         = e.data.string;
        if (!extension.is_spelling(name, str_len(name))) {
            ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_INVALID_NAME, "mach.toml: {}.extensions entry \"{}\" is not an extension name or level; names are identifiers, such as \"sse41\", and levels are hyphenated, such as \"x86-64-v2\"", label, name), e.span);
        }
        val id_r: res[intern.StrId, fail.Fail] = id_of(itn, name);
        if (sel id_r.err) { ret err[fail.Fail].err{id_r.err}; }
        val id: intern.StrId = id_r.ok;
        var j:  u32          = 0;
        for (j < d.extension_count) {
            if (d.extensions[j] == id) {
                ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_DUPLICATE, "mach.toml: {}.extensions lists \"{}\" twice", label, name), e.span);
            }
            j = j + 1;
        }
        d.extensions[d.extension_count] = id;
        d.extension_count               = d.extension_count + 1;
        i                               = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun parse_targets(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "target");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_targets: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, n);
    if (sel res_targets.err) { ret err[fail.Fail].err{fail.refused(res_targets.err)}; }
    m.targets      = res_targets.ok;
    m.target_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val name: str = name_o.some;
        if (str_equals(name, "native")) {
            ret fail_at(fail.user(diagnostic_kind.TARGET_RESERVED_NAME, "mach.toml: [target.native] is reserved; 'native' resolves to a declared target"), key_span(tab, i));
        }
        val label: res[str, fail.Fail] = sfmt(alloc, "[target.{}]", name);
        if (sel label.err) { ret err[fail.Fail].err{label.err}; }
        var d:       TargetDef;
        val decoded: err[fail.Fail] = target_decode(alloc, itn, tab, i, label.ok, ?d);
        str_free(alloc, label.ok);
        if (sel decoded.err) { ret decoded; }
        m.targets[i] = d;
        i            = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the target table at entry `i` of `[target]`, labelled `label`
fun target_decode(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml.Table, i: usize, label: str, d: *TargetDef) err[fail.Fail] {
    val v_o: opt[*toml.Value] = toml.table_value(tab, i);
    val k_o: opt[str]         = toml.table_key(tab, i);
    if (sel v_o.none) { ret err[fail.Fail].err{fail.message("internal: a [target] entry index is outside its table")}; }
    if (sel k_o.none) { ret err[fail.Fail].err{fail.message("internal: a [target] entry index is outside its table")}; }
    val sub:   *toml.Table = ?v_o.some.data.table;
    var ids:   [7]intern.StrId;
    var texts: [7]str      = [7]str{k_o.some, key_text(sub, "isa"), key_text(sub, "os"), key_text(sub, "abi"), key_text(sub, "of"), key_text(sub, "platform"), key_text(sub, "env")};
    var k:     usize       = 0;
    for (k < 7) {
        var r: res[intern.StrId, fail.Fail];
        if (k < 4)     { r = id_of(itn, texts[k]); }
        or             { r = optional_id_of(itn, texts[k]); }
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        ids[k] = r.ok;
        k      = k + 1;
    }
    d.name          = ids[0];
    d.at            = span_site(key_span(tab, i));
    d.default_at    = span_site(value_span(sub, "default"));
    d.is_default    = flag(sub, "default");
    d.isa           = ids[1];
    d.os            = ids[2];
    d.abi           = ids[3];
    d.of            = ids[4];
    d.platform      = ids[5];
    d.env           = ids[6];
    d.base          = integer_or_zero(sub, "base");
    d.stack_reserve = integer_or_zero(sub, "stack_reserve");
    d.stack_commit  = integer_or_zero(sub, "stack_commit");
    ret parse_target_extensions(alloc, itn, sub, label, d);
}

# an optional integer key's value, 0 when it is not written
fun integer_or_zero(sub: *toml.Table, key: str) u64 {
    val v: opt[i64] = toml.get_int(sub, key);
    if (sel v.some) { ret v.some::u64; }
    ret 0;
}

# the target `m` declares under `name`, nil when none is
pub fun find_target_by_name(itn: *intern.Interner, m: *Manifest, name: str) *TargetDef {
    var i: u32 = 0;
    for (i < m.target_count) {
        if (str_equals(text_of(itn, m.targets[i].name), name)) { ret ?m.targets[i]; }
        i = i + 1;
    }
    ret nil;
}

# whether a target's `os` and `isa` name the given host ids. the abi is not compared
# ---
# itn:       resolves the target's strings
# d:         the target
# host_os:   an os id from `mach.lang.target.os`
# host_arch: an arch id from `mach.lang.target.isa`
# ret:       true when both ids match
pub fun target_matches_host(itn: *intern.Interner, d: *TargetDef, host_os: u32, host_arch: u32) bool {
    ret lang_target_os.os_id_for(text_of(itn, d.os)) == host_os && isa.arch_id_for(text_of(itn, d.isa)) == host_arch;
}

# a `[target.<name>]` table for the host's own tuple, for a fixture that means the host
#[testing]
pub fun host_target_table(alloc: *A.Allocator, name: str) str {
    ret t_fmt(alloc, "[target.{}]\nisa = \"{}\"\nos = \"{}\"\nabi = \"{}\"\n", name, host_isa_name(), host_os_name(), abi.abi_name_for(lang_target.host_abi_id()));
}

# `text` with each x86_64-linux target tuple respelled as the host's, for a fixture
# written against x86_64-linux that means the host; a failed allocation leaves it as is
#[testing]
pub fun on_host(text: str) str {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret text; }
    val tuple: str                             = "isa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"";
    val host:  str                             = t_fmt(?a, "isa = \"{}\"\nos = \"{}\"\nabi = \"{}\"", host_isa_name(), host_os_name(), abi.abi_name_for(lang_target.host_abi_id()));
    val r:     res[str, types_string.StrError] = types_string.str_replace(?a, text, tuple, host);
    if (sel r.err) { ret text; }
    ret r.ok;
}

# whether `native` could ever name the target: its os is one a build host runs. a
# target of any other os (freestanding, or a finished-module target such as spirv)
# is only ever selected by name
pub fun target_is_hosted(itn: *intern.Interner, d: *TargetDef) bool {
    ret lang_target_os.os_is_hosted(lang_target_os.os_id_for(text_of(itn, d.os)));
}

pub fun make_native_target(alloc: *A.Allocator, itn: *intern.Interner) res[*TargetDef, fail.Fail] {
    var host: TargetDef;
    val name: res[intern.StrId, fail.Fail] = id_of(itn, "native");
    if (sel name.err) { ret res[*TargetDef, fail.Fail].err{name.err}; }
    host.name = name.ok;
    val isa_name: res[intern.StrId, fail.Fail] = id_of(itn, host_isa_name());
    if (sel isa_name.err) { ret res[*TargetDef, fail.Fail].err{isa_name.err}; }
    host.isa = isa_name.ok;
    val os_name: res[intern.StrId, fail.Fail] = id_of(itn, host_os_name());
    if (sel os_name.err) { ret res[*TargetDef, fail.Fail].err{os_name.err}; }
    host.os = os_name.ok;
    val abi_name: res[intern.StrId, fail.Fail] = id_of(itn, abi.abi_name_for(lang_target.host_abi_id()));
    if (sel abi_name.err) { ret res[*TargetDef, fail.Fail].err{abi_name.err}; }
    host.abi             = abi_name.ok;
    host.is_default      = false;
    host.env             = intern.STR_NIL;
    host.of              = intern.STR_NIL;
    host.platform        = intern.STR_NIL;
    host.base            = 0;
    host.stack_reserve   = 0;
    host.stack_commit    = 0;
    host.extension_count = 0;
    val owned: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, 1);
    if (sel owned.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(owned.err)}; }
    @owned.ok = host;
    ret res[*TargetDef, fail.Fail].ok{owned.ok};
}

test make_native_target__interning_failure_never_publishes_a_partial_target {
    var ordinal:  usize = 0;
    var attempts: usize = 0;
    for (ordinal <= attempts) {
        var tracking: T.Testing;
        val make_r:   err[A.Error] = T.make(?tracking);
        if (sel make_r.err) { ret 1; }
        var itn: intern.Interner = intern.init(?tracking.a);
        tracking.fail_at = ordinal;
        val result: res[*TargetDef, fail.Fail] = make_native_target(?tracking.a, ?itn);
        var valid:  bool                       = ordinal == 0 && sel result.ok;
        if (ordinal == 0) { attempts = tracking.attempts; }
        or                { valid = sel result.err; }
        if (sel result.ok) {
            A.deallocate[TargetDef](?tracking.a, result.ok, 1);
        }
        intern.dnit(?itn);
        val clean: bool = tracking.live == 0 && tracking.double_frees == 0 && tracking.exhausted == 0;
        T.dnit(?tracking);
        if (!valid) { ret 2; }
        if (!clean) { ret 3; }
        ordinal = ordinal + 1;
    }
    if (attempts < 5) { ret 4; }
    ret 0;
}
