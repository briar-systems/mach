pub fun host_isa_name() str {
    ret catalog_arch.name_for(lang_target.host_arch_id());
}

pub fun host_os_name() str {
    ret catalog_os.name_for(lang_target.host_os_id());
}

# the host as `mach info` names it, by `tuple_of`
# ---
# alloc: owns the returned string
# ret:   the formatted tuple; err when the allocator refused it
pub fun host_tuple(alloc: *A.Allocator) res[str, fail.Fail] {
    ret tuple_of(alloc, host_os_name(), host_isa_name());
}

# the one spelling of an (os, isa) pair, "<os>-<isa>", e.g. "linux-x86_64"
# ---
# alloc:    owns the returned string
# os_name:  the os name
# isa_name: the isa name
# ret:      the formatted tuple; err when the allocator refused it
pub fun tuple_of(alloc: *A.Allocator, os_name: str, isa_name: str) res[str, fail.Fail] {
    ret sfmt(alloc, "{}-{}", os_name, isa_name);
}

# `[target.X].extensions`: an array of extension names, each an identifier and
# listed once. the names are checked against the isa's vocabulary when the
# target resolves, since only the registry holds it
fun parse_target_extensions(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, label: str,
    d: *TargetDef) err[fail.Fail] {
    d.extension_count = 0;
    val v_o: opt[*toml.Value] = toml.get(sub, "extensions");
    if (sel v_o.none) { ret err[fail.Fail].ok{}; }
    val v:   *toml.Value = v_o.some;
    val arr: *toml.Array = ?v.data.array;
    val n:   usize       = toml.array_len(arr);
    if (n > extension.MAX_SELECTED::usize) {
        ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_TOO_MANY, "mach.toml: {}.extensions names more than {} extensions", label, extension.MAX_SELECTED), v.span);
    }
    var i: usize = 0;
    for (i < n) {
        val e_o: opt[*toml.Value] = toml.array_get(arr, i);
        if (sel e_o.none) { brk; }
        val e:    *toml.Value = e_o.some;
        val name: str         = e.data.string;
        if (!extension.is_spelling(name, str_len(name))) {
            ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_INVALID_NAME, "mach.toml: {}.extensions entry \"{}\" is not an extension name or level; names are identifiers, such as \"sse41\", and levels are hyphenated, such as \"x86-64-v2\"", label, name), e.span);
        }
        val id_r: res[intern.StrId, fail.Fail] = id_of(itn, name);
        if (sel id_r.err) { ret err[fail.Fail].err{id_r.err}; }
        val id: intern.StrId = id_r.ok;
        var j:  u32          = 0;
        for (j < d.extension_count) {
            if (intern.str_same(d.extensions[j], id)) {
                ret fail_at(refuse(alloc, diagnostic_kind.EXTENSION_DUPLICATE, "mach.toml: {}.extensions lists \"{}\" twice", label, name), e.span);
            }
            j = j + 1;
        }
        d.extensions[d.extension_count] = id;
        d.extension_count               = d.extension_count + 1;
        i                               = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun parse_targets(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "target");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_targets: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, n);
    if (sel res_targets.err) { ret err[fail.Fail].err{fail.refused(res_targets.err)}; }
    m.targets      = res_targets.ok;
    m.target_count = n::u32;
    var cleared: usize = 0;
    for (cleared < n) {
        m.targets[cleared].runner       = nil;
        m.targets[cleared].runner_count = 0;
        m.targets[cleared].runner_at    = nil;
        cleared                         = cleared + 1;
    }

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val name: str = name_o.some;
        if (str_equals(name, "native")) {
            ret fail_at(fail.user(diagnostic_kind.TARGET_RESERVED_NAME, "mach.toml: [target.native] is reserved; 'native' resolves to a declared target"), key_span(tab, i));
        }
        val label: res[str, fail.Fail] = sfmt(alloc, "[target.{}]", name);
        if (sel label.err) { ret err[fail.Fail].err{label.err}; }
        val decoded: err[fail.Fail] = target_decode(alloc, itn, tab, i, label.ok, ?m.targets[i]);
        str_free(alloc, label.ok);
        if (sel decoded.err) { ret decoded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a spelling a target key no longer takes, and mink's name for the row it meant
# ---
# key: the target key
# old: the retired spelling
# new: the spelling that replaces it, mink's name for the row
# isa: the isa the spelling is retired under, "" under every isa
rec Retired {
    key: str;
    old: str;
    new: str;
    isa: str;
}

# raw and spv were mach's own names for mink's flat and spirv formats, and a spir-v
# module's system is vulkan, never freestanding
val RETIRED_COUNT: usize                  = 3;
val RETIRED:       [RETIRED_COUNT]Retired = [RETIRED_COUNT]Retired{
    Retired{key: "of", old: "raw", new: "flat", isa: ""},
    Retired{key: "of", old: "spv", new: "spirv", isa: ""},
    Retired{key: "os", old: "freestanding", new: "vulkan", isa: "spirv"},
};

# the refusal of a retired spelling the target table `sub` writes, carrying the
# rewrite to the new one
fun refuse_retired(alloc: *A.Allocator, sub: *toml.Table, label: str) err[fail.Fail] {
    var i: usize = 0;
    for (i < RETIRED_COUNT) {
        val r: *Retired         = ?RETIRED[i];
        val v: opt[*toml.Value] = toml.get(sub, r.key);
        if (sel v.some) {
            val written: str = key_text(sub, r.key);
            if (str_equals(written, r.old) && (str_len(r.isa) == 0 || str_equals(key_text(sub, "isa"), r.isa))) {
                val f: fail.Fail = refuse(alloc, diagnostic_kind.TARGET_RETIRED_SPELLING,
                    "mach.toml: {}.{} = \"{}\" is a retired spelling; write \"{}\", mink's name for it", label, r.key, r.old, r.new);
                val fix: res[str, fail.Fail] = sfmt(alloc, "\"{}\"", r.new);
                if (sel fix.err) { ret err[fail.Fail].err{fix.err}; }
                val what: res[str, fail.Fail] = sfmt(alloc, "write `{} = \"{}\"`", r.key, r.new);
                if (sel what.err) { ret err[fail.Fail].err{what.err}; }
                val at: lang_source.Span = lang_source.span(v.some.span.at, v.some.span.len);
                ret fail_at(fail.with_fix(f, what.ok, opt[lang_source.Span].some{at}, fix.ok), v.some.span);
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the refusal of an `isa` the target table `sub` writes as the selection it meant,
# as `rv32imc` was once written: the isa is mink's name for the architecture that
# enters the selection and the selection is the target's `baseline`, so the fix
# rewrites the one key into the two
fun refuse_isa_selection(alloc: *A.Allocator, sub: *toml.Table, label: str) err[fail.Fail] {
    val v: opt[*toml.Value] = toml.get(sub, "isa");
    if (sel v.none) { ret err[fail.Fail].ok{}; }
    val written: str = key_text(sub, "isa");
    if (catalog_arch.id_for(written) != catalog_arch.UNKNOWN) { ret err[fail.Fail].ok{}; }
    val arch: u32 = target_baseline.entered_by(alloc, written);
    if (arch == catalog_arch.UNKNOWN) { ret err[fail.Fail].ok{}; }
    val name: str       = catalog_arch.name_for(arch);
    var f:    fail.Fail = refuse(alloc, diagnostic_kind.TARGET_RETIRED_SPELLING,
        "mach.toml: {}.isa = \"{}\" is a retired spelling; write `isa = \"{}\"`, mink's name for the architecture, and `baseline = \"{}\"`", label, written, name, written);
    var fix:    res[str, fail.Fail] = sfmt(alloc, "\"{}\"\nbaseline = \"{}\"", name, written);
    var what:   res[str, fail.Fail] = sfmt(alloc, "write `isa = \"{}\"` and `baseline = \"{}\"`", name, written);
    val stated: opt[*toml.Value]    = toml.get(sub, "baseline");
    if (sel stated.some) {
        f = refuse(alloc, diagnostic_kind.TARGET_RETIRED_SPELLING,
            "mach.toml: {}.isa = \"{}\" is a retired spelling; write `isa = \"{}\"`, mink's name for the architecture", label, written, name);
        fix  = sfmt(alloc, "\"{}\"", name);
        what = sfmt(alloc, "write `isa = \"{}\"`", name);
    }
    if (sel fix.err)  { ret err[fail.Fail].err{fix.err}; }
    if (sel what.err) { ret err[fail.Fail].err{what.err}; }
    val at: lang_source.Span = lang_source.span(v.some.span.at, v.some.span.len);
    ret fail_at(fail.with_fix(f, what.ok, opt[lang_source.Span].some{at}, fix.ok), v.some.span);
}

# the target table at entry `i` of `[target]`, labelled `label`
fun target_decode(alloc: *A.Allocator, itn: *intern.Interner, tab: *toml.Table, i: usize, label: str, d: *TargetDef) err[fail.Fail] {
    val v_o: opt[*toml.Value] = toml.table_value(tab, i);
    val k_o: opt[str]         = toml.table_key(tab, i);
    if (sel v_o.none) { ret err[fail.Fail].err{fail.message("internal: a [target] entry index is outside its table")}; }
    if (sel k_o.none) { ret err[fail.Fail].err{fail.message("internal: a [target] entry index is outside its table")}; }
    val sub:     *toml.Table    = ?v_o.some.data.table;
    val retired: err[fail.Fail] = refuse_retired(alloc, sub, label);
    if (sel retired.err) { ret retired; }
    val selection: err[fail.Fail] = refuse_isa_selection(alloc, sub, label);
    if (sel selection.err) { ret selection; }
    var ids:   [8]intern.StrId;
    var texts: [8]str = [8]str{k_o.some, key_text(sub, "isa"), key_text(sub, "os"), key_text(sub, "abi"), key_text(sub, "of"), key_text(sub, "platform"), key_text(sub, "env"), key_text(sub, "baseline")};
    var k:     usize  = 0;
    for (k < 8) {
        var r: res[intern.StrId, fail.Fail];
        if (k < 4)     { r = id_of(itn, texts[k]); }
        or             { r = optional_id_of(itn, texts[k]); }
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        ids[k] = r.ok;
        k      = k + 1;
    }
    d.name          = ids[0];
    d.at            = span_site(key_span(tab, i));
    d.isa           = ids[1];
    d.os            = ids[2];
    d.abi           = ids[3];
    d.of            = ids[4];
    d.platform      = ids[5];
    d.env           = ids[6];
    d.baseline      = ids[7];
    d.base          = integer_or_zero(sub, "base");
    d.stack_reserve = integer_or_zero(sub, "stack_reserve");
    d.stack_commit  = integer_or_zero(sub, "stack_commit");
    val extended: err[fail.Fail] = parse_target_extensions(alloc, itn, sub, label, d);
    if (sel extended.err) { ret extended; }
    ret parse_target_runner(alloc, itn, sub, label, d);
}

# `[target.X].runner`: the argv templates the target's programs are launched
# through, nonempty with an executable first. the templates are checked when the
# manifest loads, with every other template
fun parse_target_runner(alloc: *A.Allocator, itn: *intern.Interner, sub: *toml.Table, label: str, d: *TargetDef) err[fail.Fail] {
    val v_o: opt[*toml.Value] = toml.get(sub, "runner");
    if (sel v_o.none) { ret err[fail.Fail].ok{}; }
    val arr:     *toml.Array            = ?v_o.some.data.array;
    val decoded: res[StrArr, fail.Fail] = ids_of(alloc, itn, arr, label, "runner");
    if (sel decoded.err) { ret err[fail.Fail].err{decoded.err}; }
    d.runner       = decoded.ok.items;
    d.runner_count = decoded.ok.count;
    val placed: res[*fail.Place, fail.Fail] = element_sites(alloc, arr);
    if (sel placed.err) { ret err[fail.Fail].err{placed.err}; }
    d.runner_at = placed.ok;
    if (d.runner_count == 0) { ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.runner must be nonempty", label), v_o.some.span); }
    if (str_len(intern.text(itn, d.runner[0])) == 0) {
        ret fail_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.runner[0] must name an executable", label), element_span(arr, 0));
    }
    ret err[fail.Fail].ok{};
}

# an optional integer key's value, 0 when it is not written
fun integer_or_zero(sub: *toml.Table, key: str) u64 {
    val v: opt[i64] = toml.get_int(sub, key);
    if (sel v.some) { ret v.some::u64; }
    ret 0;
}

# the target `m` declares under `name`, nil when none is
pub fun find_target_by_name(itn: *intern.Interner, m: *Manifest, name: str) *TargetDef {
    var i: u32 = 0;
    for (i < m.target_count) {
        if (str_equals(intern.text(itn, m.targets[i].name), name)) { ret ?m.targets[i]; }
        i = i + 1;
    }
    ret nil;
}

# resolve a declared target with every key it states: the one place a
# `[target.<name>]` table becomes a target request
# ---
# alloc: owns the `env` origin a refusal names
# itn:   resolves the target's strings and holds that origin
# reg:   the registry the target resolves against
# d:     the target
# ret:   the binding; err the registry's refusal of the request
pub fun resolve_declared(alloc: *A.Allocator, itn: *intern.Interner, reg: *lang_target.TargetRegistry, d: *TargetDef) res[lang_target.Binding, fail.Fail] {
    val isa_name: str                       = intern.text(itn, d.isa);
    var req:      lang_target.TargetRequest = lang_target.target_request(isa_name, intern.text(itn, d.os), intern.text(itn, d.abi));
    if (!intern.str_is_nil(d.of)) { lang_target.with_of(?req, intern.text(itn, d.of)); }
    lang_target.with_image(?req, d.base, d.stack_reserve, d.stack_commit);
    if (!intern.str_is_nil(d.baseline)) { lang_target.with_baseline(?req, intern.text(itn, d.baseline)); }
    if (!intern.str_is_nil(d.env) && str_len(intern.text(itn, d.env)) != 0) {
        val env_name: str = intern.text(itn, d.env);
        # a target the manifest does not name is labelled by its isa
        var label: str = isa_name;
        if (!intern.str_is_nil(d.name) && str_len(intern.text(itn, d.name)) != 0) { label = intern.text(itn, d.name); }
        val origin: res[str, fail.Fail] = fail.format_intern(itn, alloc, "mach.toml: [target.{}] env = \"{}\"", label, env_name);
        if (sel origin.err) { ret res[lang_target.Binding, fail.Fail].err{origin.err}; }
        lang_target.with_env(?req, env_name, origin.ok);
    }
    var ext_names: [extension.MAX_SELECTED]str;
    var ei:        u32 = 0;
    for (ei < d.extension_count) {
        ext_names[ei] = intern.text(itn, d.extensions[ei]);
        ei            = ei + 1;
    }
    lang_target.with_extensions(?req, ?ext_names[0], d.extension_count);
    ret lang_target.resolve(reg, ?req);
}

# whether a target's `os` and `isa` name the given host ids. the abi is not compared
# ---
# itn:       resolves the target's strings
# d:         the target
# host_os:   an os id from `mach.lang.target.os`
# host_arch: an arch id from `mach.lang.target.isa`
# ret:       true when both ids match
pub fun target_matches_host(itn: *intern.Interner, d: *TargetDef, host_os: u32, host_arch: u32) bool {
    ret catalog_os.id_for(intern.text(itn, d.os)) == host_os && catalog_arch.id_for(intern.text(itn, d.isa)) == host_arch;
}

# whether `native` could ever name the target: its os is one a build host runs. a
# target of any other os (freestanding, or a finished-module target such as spirv)
# is only ever selected by name
pub fun target_is_hosted(itn: *intern.Interner, d: *TargetDef) bool {
    ret catalog_os.is_hosted(catalog_os.id_for(intern.text(itn, d.os)));
}

pub fun make_native_target(alloc: *A.Allocator, itn: *intern.Interner) res[*TargetDef, fail.Fail] {
    var host: TargetDef;
    val name: res[intern.StrId, fail.Fail] = id_of(itn, "native");
    if (sel name.err) { ret res[*TargetDef, fail.Fail].err{name.err}; }
    host.name = name.ok;
    val isa_name: res[intern.StrId, fail.Fail] = id_of(itn, host_isa_name());
    if (sel isa_name.err) { ret res[*TargetDef, fail.Fail].err{isa_name.err}; }
    host.isa = isa_name.ok;
    val os_name: res[intern.StrId, fail.Fail] = id_of(itn, host_os_name());
    if (sel os_name.err) { ret res[*TargetDef, fail.Fail].err{os_name.err}; }
    host.os = os_name.ok;
    val abi_name: res[intern.StrId, fail.Fail] = id_of(itn, catalog_abi.name_for(lang_target.host_abi_id()));
    if (sel abi_name.err) { ret res[*TargetDef, fail.Fail].err{abi_name.err}; }
    host.abi             = abi_name.ok;
    host.env             = intern.STR_NIL;
    host.baseline        = intern.STR_NIL;
    host.of              = intern.STR_NIL;
    host.platform        = intern.STR_NIL;
    host.base            = 0;
    host.stack_reserve   = 0;
    host.stack_commit    = 0;
    host.extension_count = 0;
    host.runner          = nil;
    host.runner_count    = 0;
    host.runner_at       = nil;
    val owned: res[*TargetDef, A.Error] = A.allocate[TargetDef](alloc, 1);
    if (sel owned.err) { ret res[*TargetDef, fail.Fail].err{fail.refused(owned.err)}; }
    @owned.ok = host;
    ret res[*TargetDef, fail.Fail].ok{owned.ok};
}
