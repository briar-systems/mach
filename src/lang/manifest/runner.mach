# the command a target's programs are launched through. a target may declare a
# `runner`, argv templates the launch expands, and `--runner <cmd>` replaces it
# for one invocation with `<cmd> <program>`. mach knows no runner by name: the
# command is the manifest's, and its exit status is the program's
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.host;
use mach.lang.intern;
use mach.lang.manifest.model.TargetDef;
use mach.lang.manifest.template;

# how one (target, profile)'s programs are launched
# ---
# program: the resolved `--runner` program, which launches `<program> <out>`; nil
#          when the declared templates apply
# words:   the target's `runner` templates, owned; nil when it declares none
# count:   length of `words`
# target:  the target's name, for a refusal
# work:    `{project.work}`, joined to the project root
# values:  the target's and profile's template values, owned
pub rec Runner {
    program: *u8;
    words:   *str;
    count:   u32;
    target:  str;
    work:    str;
    values:  template.Values;
}

# a launch command: `argv` is nil-terminated, its first `lead` entries the
# runner's and the program's, the rest the run's own arguments
pub rec Command {
    argv: **u8;
    len:  usize;
    lead: usize;
}

# no runner: the program runs itself
pub fun none() Runner {
    var r: Runner;
    r.program = nil;
    r.words   = nil;
    r.count   = 0;
    r.target  = "";
    r.work    = "";
    r.values  = template.values_empty();
    ret r;
}

# whether `r` launches through a command rather than running the program itself
pub fun given(r: *Runner) bool {
    ret r.program != nil || r.count > 0;
}

# the runner `--runner` names for one invocation, replacing the declared one
# ---
# program: the resolved program
# target:  the target's name
pub fun overriding(program: *u8, target: str) Runner {
    var r: Runner = none();
    r.program = program;
    r.target  = target;
    ret r;
}

# the runner `t` declares for `profile`, copied out of `itn` into `a`; no runner
# when it declares none
# ---
# work: `{project.work}` for the cell, joined to the project root
pub fun declared(a: *A.Allocator, itn: *intern.Interner, t: *TargetDef, profile: str, work: str) res[Runner, fail.Fail] {
    var r: Runner = none();
    if (t == nil) { ret res[Runner, fail.Fail].ok{r}; }
    val name: res[str, fail.Fail] = dup(a, intern.text(itn, t.name));
    if (sel name.err) { ret res[Runner, fail.Fail].err{name.err}; }
    r.target = name.ok;
    if (t.runner_count == 0) { ret res[Runner, fail.Fail].ok{r}; }

    val wr: res[*str, A.Error] = A.allocate[str](a, t.runner_count::usize);
    if (sel wr.err) { ret res[Runner, fail.Fail].err{fail.refused(wr.err)}; }
    var i: u32 = 0;
    for (i < t.runner_count) {
        val w: res[str, fail.Fail] = dup(a, intern.text(itn, t.runner[i]));
        if (sel w.err) { ret res[Runner, fail.Fail].err{w.err}; }
        wr.ok[i] = w.ok;
        i        = i + 1;
    }
    r.words = wr.ok;
    r.count = t.runner_count;

    val v:            template.Values     = template.values_of(itn, t, profile);
    val target:       res[str, fail.Fail] = dup(a, v.target);
    val arch:         res[str, fail.Fail] = dup(a, v.arch);
    val sys:          res[str, fail.Fail] = dup(a, v.sys);
    val abi:          res[str, fail.Fail] = dup(a, v.abi);
    val profile_name: res[str, fail.Fail] = dup(a, v.profile);
    if (sel target.err)       { ret res[Runner, fail.Fail].err{target.err}; }
    if (sel arch.err)         { ret res[Runner, fail.Fail].err{arch.err}; }
    if (sel sys.err)          { ret res[Runner, fail.Fail].err{sys.err}; }
    if (sel abi.err)          { ret res[Runner, fail.Fail].err{abi.err}; }
    if (sel profile_name.err) { ret res[Runner, fail.Fail].err{profile_name.err}; }
    r.values         = template.values_empty();
    r.values.target  = target.ok;
    r.values.arch    = arch.ok;
    r.values.sys     = sys.ok;
    r.values.abi     = abi.ok;
    r.values.profile = profile_name.ok;
    val wd: res[str, fail.Fail] = dup(a, work);
    if (sel wd.err) { ret res[Runner, fail.Fail].err{wd.err}; }
    r.work = wd.ok;
    ret res[Runner, fail.Fail].ok{r};
}

# the command launching `out` through `r` with the `n` arguments at `args`: the
# override's program then `out`, or each declared template expanded with
# `{artifact.out}` as `out` and its first word resolved as a program
# ---
# a:   owns the command, released with `command_free`
# ret: the command; err when a template does not expand or the first word names no
#      program
pub fun command(a: *A.Allocator, r: *Runner, out: str, args: **u8, n: usize) res[Command, fail.Fail] {
    var lead: usize = r.count::usize;
    if (r.program != nil) { lead = 2; }
    val ar: res[**u8, A.Error] = A.allocate[*u8](a, lead + n + 1);
    if (sel ar.err) { ret res[Command, fail.Fail].err{fail.refused(ar.err)}; }
    var c: Command = Command{argv: ar.ok, len: lead + n, lead: lead};
    var i: usize   = 0;
    for (i <= c.len) {
        c.argv[i] = nil;
        i         = i + 1;
    }
    if (r.program != nil) {
        val p: res[str, fail.Fail] = dup(a, r.program::str);
        if (sel p.err) { ret failed(a, ?c, p.err); }
        c.argv[0] = p.ok::*u8;
        val o: res[str, fail.Fail] = dup(a, out);
        if (sel o.err) { ret failed(a, ?c, o.err); }
        c.argv[1] = o.ok::*u8;
    }
    or {
        var v: template.Values = r.values;
        v.run_out = out;
        i         = 0;
        for (i < lead) {
            val e: res[str, fail.Fail] = template.expand(a, r.words[i], template.CONTEXT_RUNNER, r.work, ?v);
            if (sel e.err) { ret failed(a, ?c, e.err); }
            c.argv[i] = e.ok::*u8;
            i         = i + 1;
        }
        val found: res[str, fail.Fail] = host.program_resolve(a, c.argv[0]::str);
        if (sel found.err) {
            val said: res[str, fail.Fail] = fail.format(a, "the runner of target '{}' names '{}': {}", r.target, c.argv[0]::str, fail.describe(found.err));
            if (sel said.err) { ret failed(a, ?c, said.err); }
            ret failed(a, ?c, fail.owning(fail.with_text(found.err, said.ok)));
        }
        str_free(a, c.argv[0]::str);
        c.argv[0] = found.ok::*u8;
    }
    i = 0;
    for (i < n) {
        c.argv[lead + i] = args[i];
        i                = i + 1;
    }
    ret res[Command, fail.Fail].ok{c};
}

# the command's leading words joined by spaces, as a person would retype them
# before the run's own arguments
pub fun line(a: *A.Allocator, c: *Command) res[str, fail.Fail] {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < c.lead) {
        total = total + str_len(c.argv[i]::str) + 1;
        i     = i + 1;
    }
    val br: res[*u8, A.Error] = A.allocate[u8](a, total + 1);
    if (sel br.err) { ret res[str, fail.Fail].err{fail.refused(br.err)}; }
    var at: usize = 0;
    i = 0;
    for (i < c.lead) {
        if (i > 0) {
            br.ok[at] = ' ';
            at        = at + 1;
        }
        val w: str   = c.argv[i]::str;
        val l: usize = str_len(w);
        var k: usize = 0;
        for (k < l) {
            br.ok[at + k] = w[k];
            k             = k + 1;
        }
        at = at + l;
        i  = i + 1;
    }
    br.ok[at] = 0;
    ret res[str, fail.Fail].ok{br.ok::str};
}

# release the words a command owns; the run's own arguments are the caller's
pub fun command_free(a: *A.Allocator, c: *Command) {
    if (c.argv == nil) { ret; }
    var i: usize = 0;
    for (i < c.lead) {
        if (c.argv[i] != nil) { str_free(a, c.argv[i]::str); }
        i = i + 1;
    }
    A.deallocate[*u8](a, c.argv, c.len + 1);
    c.argv = nil;
}

fun failed(a: *A.Allocator, c: *Command, f: fail.Fail) res[Command, fail.Fail] {
    command_free(a, c);
    ret res[Command, fail.Fail].err{f};
}

fun dup(a: *A.Allocator, s: str) res[str, fail.Fail] {
    val d: res[str, A.Error] = str_dup(a, s);
    if (sel d.err) { ret res[str, fail.Fail].err{fail.refused(d.err)}; }
    ret res[str, fail.Fail].ok{d.ok};
}
