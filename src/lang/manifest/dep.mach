test "mach.lang.manifest.manifest_remove_dep_table:refuses_a_quoted_header_the_scanner_cannot_locate" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val quoted: str                    = "[dep.\"foo\"]\ngit = \"https://example.com/a.git\"\n";
    val r:      res[str, outcome.Fail] = manifest_remove_dep_table(?alloc, quoted, "foo");
    if (!(sel r.err && str_contains(outcome.describe(r.err), "was found by the parser but not by exact-header scan"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

# parse one `[dep.*]` document through `parse_deps` in the given form; "" on success
fun t_deps_refusal(alloc: *A.Allocator, itn: *intern.Interner, text: str, as_root: bool) str {
    val t_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, text);
    if (sel t_r.err) { ret "fixture is not valid TOML"; }
    var t: toml.Table = t_r.ok;
    var m: Manifest   = model.empty();
    m.id = intern_unwrap(itn, "x");
    val r:   err[outcome.Fail] = parse_deps(alloc, itn, ?t, ?m, as_root);
    var out: str               = "";
    if (sel r.err) { out = outcome.describe(r.err); }
    model.dnit(?m, alloc);
    toml.dnit(alloc, ?t);
    ret out;
}

$if ($mach.build.os == $mach.os.windows) {
    val T_ABS_TREE: str = "C:/opt/mach/std";
}
$or {
    val T_ABS_TREE: str = "/opt/mach/std";
}

val T_DIGEST: str = "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";

fun t_in_place_table(alloc: *A.Allocator, extra: str) str {
    ret sfmt(alloc, "[dep.std]\nin_place = \"{}\"\n{}", T_ABS_TREE, extra);
}

# `in_place` takes no other source or selector key (Q3): each of `git`, `version`, `ref` and
# `path` beside it is refused by name
test "mach.lang.manifest.parse_deps:in_place_refuses_git_version_ref_and_path_beside_it" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val with_git: str = t_deps_refusal(?alloc, ?itn, t_in_place_table(?alloc, "git = \"https://example.com/std.git\"\n"), true);
    if (!str_contains(with_git, "[dep.std].in_place cannot be combined with 'git'")) { code = 1; }
    val with_version: str = t_deps_refusal(?alloc, ?itn, t_in_place_table(?alloc, "version = \"^1\"\n"), true);
    if (!str_contains(with_version, "[dep.std].in_place cannot be combined with 'version'")) { code = 2; }
    val with_ref: str = t_deps_refusal(?alloc, ?itn, t_in_place_table(?alloc, "ref = \"tag/v1\"\n"), true);
    if (!str_contains(with_ref, "[dep.std].in_place cannot be combined with 'ref'")) { code = 3; }
    val with_path: str = t_deps_refusal(?alloc, ?itn, t_in_place_table(?alloc, "path = \"../std\"\n"), true);
    if (!str_contains(with_path, "[dep.std].in_place cannot be combined with 'path'")) { code = 4; }
    val digest_alone: str = t_deps_refusal(?alloc, ?itn, sfmt(?alloc, "[dep.std]\npath = \"../std\"\ndigest = \"{}\"\n", T_DIGEST), true);
    if (!str_contains(digest_alone, "[dep.std].digest applies only to an in-place dependency")) { code = 5; }

    arena.dnit(?ar);
    ret code;
}

# a relative `in_place` would resolve against the project, which is what `path` realizes into dep/
test "mach.lang.manifest.parse_deps:in_place_refuses_a_relative_path" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val relative: str = t_deps_refusal(?alloc, ?itn, sfmt(?alloc, "[dep.std]\nin_place = \"../std\"\ndigest = \"{}\"\n", T_DIGEST), true);
    if (!str_contains(relative, "[dep.std].in_place = \"../std\" must be an absolute path")) { code = 1; }
    val typed: str = t_deps_refusal(?alloc, ?itn, "[dep.std]\nin_place = true\n", true);
    if (!str_contains(typed, "[dep.std].in_place must be an absolute path string")) { code = 2; }

    arena.dnit(?ar);
    ret code;
}

# only the root may point a build at a tree outside the project (Q7)
test "mach.lang.manifest.parse_deps:in_place_refuses_a_non_root_declaration" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val table:    str = t_in_place_table(?alloc, sfmt(?alloc, "digest = \"{}\"\n", T_DIGEST));
    val non_root: str = t_deps_refusal(?alloc, ?itn, table, false);
    if (!str_contains(non_root, "[dep.std].in_place is allowed only in the root project's manifest")) { code = 1; }
    if (!str_empty(t_deps_refusal(?alloc, ?itn, table, true)))                                        { code = 2; }

    arena.dnit(?ar);
    ret code;
}

# a root declaration parses with its digest, with the digest absent (resolution refuses that,
# so `mach dep pull` can record it), and never with a malformed one
test "mach.lang.manifest.parse_deps:in_place_records_the_digest_and_validates_its_form" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    val t_r: res[toml.Table, toml.TomlError] = toml.parse(?alloc, t_in_place_table(?alloc, sfmt(?alloc, "digest = \"{}\"\n", T_DIGEST)));
    if (sel t_r.err) { ret 2; }
    var t: toml.Table = t_r.ok;
    var m: Manifest   = model.empty();
    m.id = intern_unwrap(?itn, "x");
    val r: err[outcome.Fail] = parse_deps(?alloc, ?itn, ?t, ?m, true);
    if (sel r.err) { code = 3; }
    if (sel r.ok) {
        if (m.dep_count != 1)                                          { code = 4; }
        or (m.deps[0].in_place == intern.STR_NIL)                      { code = 5; }
        or (!str_equals(key_text(?t, "dep.std.in_place"), T_ABS_TREE)) { code = 6; }
        or (m.deps[0].digest == intern.STR_NIL)                        { code = 7; }
        or (m.deps[0].git != intern.STR_NIL || m.deps[0].path != intern.STR_NIL
            || m.deps[0].ref != intern.STR_NIL || m.deps[0].version != intern.STR_NIL) { code = 8; }
    }
    model.dnit(?m, ?alloc);
    toml.dnit(?alloc, ?t);

    val no_digest: res[toml.Table, toml.TomlError] = toml.parse(?alloc, t_in_place_table(?alloc, ""));
    if (sel no_digest.err) { ret 9; }
    var t2: toml.Table = no_digest.ok;
    var m2: Manifest   = model.empty();
    m2.id = intern_unwrap(?itn, "x");
    val r2: err[outcome.Fail] = parse_deps(?alloc, ?itn, ?t2, ?m2, true);
    if (sel r2.err)                                       { code = 10; }
    if (sel r2.ok && m2.deps[0].digest != intern.STR_NIL) { code = 11; }
    model.dnit(?m2, ?alloc);
    toml.dnit(?alloc, ?t2);

    val malformed: str = t_deps_refusal(?alloc, ?itn, t_in_place_table(?alloc, "digest = \"sha256:abc\"\n"), true);
    if (!str_contains(malformed, "[dep.std].digest must be \"sha256:<64 lowercase hex digits>\"")) { code = 12; }
    val md5: str = t_deps_refusal(?alloc, ?itn, t_in_place_table(?alloc, "digest = \"md5:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"\n"), true);
    if (!str_contains(md5, "[dep.std].digest must be")) { code = 13; }

    arena.dnit(?ar);
    ret code;
}

# the writer records `in_place` and `digest` as one table, and the digest setter replaces a
# `digest` line in place or adds one after the table's last line, in either case reparsing
test "mach.lang.manifest.manifest_set_dep_digest:adds_or_replaces_the_digest_line" {
    var backing: A.Allocator;
    var ar:      arena.Arena;
    var alloc:   A.Allocator;
    var itn:     intern.Interner;
    if (!tinit(?backing, ?ar, ?alloc, ?itn)) { ret 1; }
    var code: i32 = 0;

    var spec: DepTableSpec;
    spec.name    = "std";
    spec.source  = DEP_SOURCE_IN_PLACE;
    spec.value   = T_ABS_TREE;
    spec.ref     = "";
    spec.version = "";
    spec.digest  = T_DIGEST;
    val added: res[str, outcome.Fail] = manifest_add_dep_table(?alloc, ut_messy_manifest(), ?spec);
    if (sel added.err) { ret 2; }
    val with_table: str = added.ok;
    if (!str_contains(with_table, "[dep.std]"))                               { code = 3; }
    if (!str_contains(with_table, sfmt(?alloc, "digest = \"{}\"", T_DIGEST))) { code = 4; }
    spec.digest = "";
    val undigested: res[str, outcome.Fail] = manifest_add_dep_table(?alloc, ut_messy_manifest(), ?spec);
    if (sel undigested.ok) { code = 5; }

    val second:   str                    = "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff";
    val replaced: res[str, outcome.Fail] = manifest_set_dep_digest(?alloc, with_table, "std", second);
    if (sel replaced.err)                                                                                           { ret 6; }
    if (str_contains(replaced.ok, T_DIGEST) || !str_contains(replaced.ok, sfmt(?alloc, "digest = \"{}\"", second))) { code = 7; }
    if (!str_starts_with(replaced.ok, ut_messy_manifest()))                                                         { code = 8; }

    # a hand-written table with no digest, followed by another table: the line lands inside the right one
    val hand:     str                    = sfmt(?alloc, "[dep.std]\nin_place = \"{}\"\n\n# trailing comment\n[dep.other]\ngit = \"https://example.com/other.git\"\nref = \"branch/main\"\n", T_ABS_TREE);
    val inserted: res[str, outcome.Fail] = manifest_set_dep_digest(?alloc, hand, "std", second);
    if (sel inserted.err) { ret 9; }
    val expected: str = sfmt(?alloc, "[dep.std]\nin_place = \"{}\"\ndigest = \"{}\"\n\n# trailing comment\n[dep.other]\ngit = \"https://example.com/other.git\"\nref = \"branch/main\"\n", T_ABS_TREE, second);
    if (!str_equals(inserted.ok, expected)) { code = 10; }

    # a header at the end of the file without a newline still gets its line
    val bare:     str                    = sfmt(?alloc, "[dep.std]\nin_place = \"{}\"", T_ABS_TREE);
    val bare_set: res[str, outcome.Fail] = manifest_set_dep_digest(?alloc, bare, "std", second);
    if (sel bare_set.err)                                                                                              { ret 11; }
    if (!str_equals(bare_set.ok, sfmt(?alloc, "[dep.std]\nin_place = \"{}\"\ndigest = \"{}\"\n", T_ABS_TREE, second))) { code = 12; }

    val absent: res[str, outcome.Fail] = manifest_set_dep_digest(?alloc, hand, "nosuch", second);
    if (!(sel absent.err && str_contains(outcome.describe(absent.err), "not declared"))) { code = 13; }
    val bad: res[str, outcome.Fail] = manifest_set_dep_digest(?alloc, hand, "std", "sha256:short");
    if (sel bad.ok) { code = 14; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest: escaped TOML strings retain exact allocation ownership" {
    var large: [1025]u8;
    var i:     usize = 0;
    for (i < 1024) {
        large[i] = 'x';
        i        = i + 1;
    }
    large[1024] = 0;
    var control: [3]u8;
    control[0] = 1;
    control[1] = 127;
    control[2] = 0;
    var inputs:   [6]str;
    var expected: [6]str;
    inputs[0]   = "";
    expected[0] = "";
    inputs[1]   = "x";
    expected[1] = "x";
    inputs[2]   = "\\\"\n\r\t\x08\x0c";
    expected[2] = "\\\\\\\"\\n\\r\\t\\b\\f";
    inputs[3]   = (?control[0])::str;
    expected[3] = "\\u0001\\u007f";
    inputs[4]   = "ÄΩ";
    expected[4] = "ÄΩ";
    inputs[5]   = (?large[0])::str;
    expected[5] = (?large[0])::str;
    i           = 0;
    for (i < 6) {
        var probe: PlanAllocProbe;
        var alloc: A.Allocator;
        if (!plan_probe_make(?probe, ?alloc, 0)) { ret 1; }
        val escaped: res[str, outcome.Fail] = toml_escape_value(?alloc, inputs[i]);
        if (sel escaped.err) { ret 2; }
        val text:    str  = escaped.ok;
        val correct: bool = str_equals(text, expected[i]);
        str_free(?alloc, text);
        if (!correct || probe.live != 0 || probe.mismatch || probe.calls != 1) { ret 3; }
        if (!plan_probe_make(?probe, ?alloc, 1))                               { ret 4; }
        val refused: res[str, outcome.Fail] = toml_escape_value(?alloc, inputs[i]);
        if (sel refused.ok) {
            str_free(?alloc, refused.ok);
            ret 5;
        }
        if (probe.live != 0 || probe.mismatch || probe.calls != 1) { ret 6; }
        i = i + 1;
    }
    ret 0;
}
