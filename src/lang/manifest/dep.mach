use mach.lang.build.outcome;
use std.data.toml;
use std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string;
use std.types.string.str;
use std.types.string.str_copy_slice;
use std.types.string.str_empty;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;
use std.types.string.str_starts_with;

use A: std.allocator;

use mach.lang.intern;

use mach.lang.manifest.parse;
use mach.lang.manifest.parse.TK_DEP;
use mach.lang.manifest.parse.check_keys;
use mach.lang.manifest.parse.intern_opt_unwrap;
use mach.lang.manifest.parse.intern_unwrap;
use mach.lang.manifest.parse.is_valid_id;
use mach.lang.manifest.parse.key_text;
use mach.lang.manifest.parse.sfmt;

pub def DepSource: u8;
pub val DEP_SOURCE_GIT:  DepSource = 1;
pub val DEP_SOURCE_PATH: DepSource = 2;

pub rec DepDef {
    name: intern.StrId;
    git:  intern.StrId;
    path: intern.StrId;
    ref:  intern.StrId;
}

pub rec DepTableSpec {
    name:   str;
    source: DepSource;
    value:  str;
    ref:    str;
}

pub rec HeaderSpan {
    found:     bool;
    ambiguous: bool;
    start:     usize;
    body_end:  usize;
}

val DEP_LOOKUP_ABSENT:    u8 = 0;
val DEP_LOOKUP_TABLE:     u8 = 1;
val DEP_LOOKUP_NON_TABLE: u8 = 2;

fun dep_ref_hex(ref: str, start: usize) bool {
    val n:     usize = str_len(ref);
    val width: usize = n - start;
    if (width != 40 && width != 64) { ret false; }
    var i: usize = start;
    for (i < n) {
        val c: u8 = ref[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun dep_ref_component(ref: str, start: usize, end: usize) bool {
    if (start >= end || ref[start] == '.') { ret false; }
    if (end - start >= 5 && ref[end - 5] == '.' && ref[end - 4] == 'l'
        && ref[end - 3] == 'o' && ref[end - 2] == 'c' && ref[end - 1] == 'k') { ret false; }
    ret true;
}

fun dep_ref_name(ref: str, start: usize) bool {
    val n: usize = str_len(ref);
    if (start >= n || ref[start] == '/' || ref[n - 1] == '/' || ref[n - 1] == '.') { ret false; }
    var component_start: usize = start;
    var i:               usize = start;
    for (i < n) {
        val c: u8 = ref[i];
        if (c <= ' ' || c == 127 || c == '\\' || c == '~' || c == '^' || c == ':'
            || c == '?' || c == '*' || c == '[') { ret false; }
        if (c == '.' && i + 1 < n && ref[i + 1] == '.') { ret false; }
        if (c == '/' && i + 1 < n && ref[i + 1] == '/') { ret false; }
        if (c == '@' && i + 1 < n && ref[i + 1] == '{') { ret false; }
        if (c == '/') {
            if (!dep_ref_component(ref, component_start, i)) { ret false; }
            component_start = i + 1;
        }
        i = i + 1;
    }
    ret dep_ref_component(ref, component_start, n);
}

pub fun dep_ref_valid(ref: str) bool {
    if (str_starts_with(ref, "branch/")) { ret dep_ref_name(ref, 7); }
    if (str_starts_with(ref, "tag/"))    { ret dep_ref_name(ref, 4); }
    if (str_starts_with(ref, "commit/")) { ret dep_ref_hex(ref, 7); }
    ret false;
}

pub fun parse_deps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, as_root: bool,
    out_deps: **DepDef, out_count: *u32) err[outcome.Fail] {
    @out_deps  = nil;
    @out_count = 0;
    val tab_o: opt[*toml.Table] = toml.get_table(t, "dep");
    if (sel tab_o.none) { ret err[outcome.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[outcome.Fail].ok{}; }

    val res_deps: res[*DepDef, A.Error] = A.allocate[DepDef](alloc, n);
    if (sel res_deps.err) { ret err[outcome.Fail].err{outcome.refused(res_deps.err)}; }
    val deps: *DepDef = res_deps.ok;
    @out_deps  = deps;
    @out_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str] = toml.table_key(tab, i);
        if (sel name_o.none) { brk; }
        val name: str              = name_o.some;
        val v_o:  opt[*toml.Value] = toml.table_value(tab, i);
        if (sel v_o.none) { brk; }
        val v:     *toml.Value = v_o.some;
        val label: str         = sfmt(alloc, "[dep.{}]", name);
        if (!is_valid_id(name)) {
            val name_msg: str = sfmt(alloc, "mach.toml: dependency name '{}' must be a portable identifier (letters, digits, '_', '-')", name);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(name_msg)};
        }
        if (v.tag != toml.TYPE_TABLE) {
            val lbl_msg7: str = sfmt(alloc, "mach.toml: {} must be a table", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg7)};
        }
        val sub: *toml.Table = ?v.data.table;

        val version_o: opt[*toml.Value] = toml.get(sub, "version");
        if (sel version_o.some) {
            val lbl_msg8: str = sfmt(alloc, "mach.toml: {}.version is reserved for the registry era", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg8)};
        }
        val res_keys: err[outcome.Fail] = check_keys(alloc, sub, label, TK_DEP, as_root);
        if (sel res_keys.err) { ret res_keys; }

        var d: DepDef;
        d.name = intern_unwrap(itn, name);
        val git_s:    str  = key_text(sub, "git");
        val path_s:   str  = key_text(sub, "path");
        val has_git:  bool = !str_empty(git_s);
        val has_path: bool = !str_empty(path_s);
        if (has_git == has_path) {
            val lbl_msg9: str = sfmt(alloc, "mach.toml: {} needs exactly one source key: 'git' or 'path'", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg9)};
        }
        val ref_s: str = key_text(sub, "ref");
        if (has_git && str_empty(ref_s)) {
            val lbl_msg10: str = sfmt(alloc, "mach.toml: {} is missing required key 'ref' for git source", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg10)};
        }
        if (has_path && !str_empty(ref_s)) {
            val lbl_msg11: str = sfmt(alloc, "mach.toml: {}.ref is not allowed for path sources", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg11)};
        }
        if (has_git && !dep_ref_valid(ref_s)) {
            val lbl_msg12: str = sfmt(alloc, "mach.toml: {}.ref must be branch/<name>, tag/<name>, or commit/<full-object-id>", label);
            str_free(alloc, label);
            ret err[outcome.Fail].err{outcome.user(lbl_msg12)};
        }
        d.git  = intern_opt_unwrap(itn, git_s);
        d.path = intern_opt_unwrap(itn, path_s);
        d.ref  = intern_opt_unwrap(itn, ref_s);

        deps[i] = d;
        str_free(alloc, label);
        i = i + 1;
    }
    ret err[outcome.Fail].ok{};
}

fun hex_digit(v: u8) u8 {
    if (v < 10) { ret '0'::u8 + v; }
    ret 'a'::u8 + (v - 10);
}

pub fun toml_escape_value(alloc: *A.Allocator, s: str) res[str, outcome.Fail] {
    val n:      usize = str_len(s);
    var cap:    usize = 1;
    var offset: usize = 0;
    for (offset < n) {
        val c:     u8    = s[offset];
        var width: usize = 1;
        if (c == '\\'::u8 || c == '"'::u8 || c == '\n'::u8 || c == '\r'::u8
            || c == '\t'::u8 || c == 8::u8 || c == 12::u8) { width = 2; }
        or (c < 32::u8 || c == 127::u8)              { width = 6; }
        if (cap > 0xffffffffffffffff::usize - width) { ret res[str, outcome.Fail].err{outcome.user("escaped TOML value is too long")}; }
        cap    = cap + width;
        offset = offset + 1;
    }
    val r: res[*u8, A.Error] = A.allocate[u8](alloc, cap);
    if (sel r.err) { ret res[str, outcome.Fail].err{outcome.refused(r.err)}; }
    val buf: *u8   = r.ok;
    var k:   usize = 0;
    var i:   usize = 0;
    for (i < n) {
        val c: u8 = s[i];
        if (c == '\\'::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = '\\'::u8;
            k      = k + 1;
        }
        or (c == '"'::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = '"'::u8;
            k      = k + 1;
        }
        or (c == '\n'::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = 'n'::u8;
            k      = k + 1;
        }
        or (c == '\r'::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = 'r'::u8;
            k      = k + 1;
        }
        or (c == '\t'::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = 't'::u8;
            k      = k + 1;
        }
        or (c == 8::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = 'b'::u8;
            k      = k + 1;
        }
        or (c == 12::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = 'f'::u8;
            k      = k + 1;
        }
        or (c < 32::u8 || c == 127::u8) {
            buf[k] = '\\'::u8;
            k      = k + 1;
            buf[k] = 'u'::u8;
            k      = k + 1;
            buf[k] = '0'::u8;
            k      = k + 1;
            buf[k] = '0'::u8;
            k      = k + 1;
            buf[k] = hex_digit(c / 16::u8);
            k      = k + 1;
            buf[k] = hex_digit(c % 16::u8);
            k      = k + 1;
        }
        or {
            buf[k] = c;
            k      = k + 1;
        }
        i = i + 1;
    }
    buf[k] = 0;
    ret res[str, outcome.Fail].ok{buf::str};
}

fun source_uses_crlf(source: str) bool {
    val n: usize = str_len(source);
    var i: usize = 0;
    for (i < n) {
        if (source[i] == '\n'::u8) { ret i > 0 && source[i - 1] == '\r'::u8; }
        i = i + 1;
    }
    ret false;
}

fun source_ends_with_newline(source: str) bool {
    val n: usize = str_len(source);
    ret n > 0 && source[n - 1] == '\n'::u8;
}

fun if_crlf(source: str) str {
    if (source_uses_crlf(source)) { ret "\r\n"; }
    ret "\n";
}

fun dep_entry_kind(alloc: *A.Allocator, source_text: str, name: str) res[u8, outcome.Fail] {
    val parse_r: res[toml.Table, toml.TomlError] = toml.parse(alloc, source_text);
    if (sel parse_r.err) { ret res[u8, outcome.Fail].err{outcome.user(outcome.toml_text(parse_r.err))}; }
    var tbl:    toml.Table       = parse_r.ok;
    val deps_o: opt[*toml.Table] = toml.get_table(?tbl, "dep");
    var kind:   u8               = DEP_LOOKUP_ABSENT;
    if (sel deps_o.some) {
        val deps: *toml.Table = deps_o.some;
        val len:  usize       = toml.table_len(deps);
        var i:    usize       = 0;
        for (i < len) {
            val key_o: opt[str] = toml.table_key(deps, i);
            if (sel key_o.none) { brk; }
            if (str_equals(key_o.some, name)) {
                val v_o: opt[*toml.Value] = toml.table_value(deps, i);
                if (sel v_o.none)                    { brk; }
                if (v_o.some.tag == toml.TYPE_TABLE) { kind = DEP_LOOKUP_TABLE; }
                or                                   { kind = DEP_LOOKUP_NON_TABLE; }
            }
            i = i + 1;
        }
    }
    toml.dnit(alloc, ?tbl);
    ret res[u8, outcome.Fail].ok{kind};
}

pub fun find_top_level_table(source: str, header: str) HeaderSpan {
    var hs:            HeaderSpan;
    val n:             usize = str_len(source);
    var pending_start: usize = 0;
    var in_target:     bool  = false;
    var i:             usize = 0;
    for (i <= n) {
        val at_end: bool = i == n;
        val at_nl:  bool = !at_end && source[i] == '\n'::u8;
        if (at_end || at_nl) {
            val line_start: usize = pending_start;
            var line_end:   usize = i;
            if (line_end > line_start && source[line_end - 1] == '\r'::u8) { line_end = line_end - 1; }
            val is_header: bool = line_end > line_start && source[line_start] == '['::u8;
            if (is_header) {
                val matches: bool = str_region_equals(source, line_start, line_end - line_start, header);
                if (in_target) {
                    hs.body_end = line_start;
                    in_target   = false;
                }
                if (matches) {
                    if (hs.found) { hs.ambiguous = true; }
                    hs.found  = true;
                    hs.start  = line_start;
                    in_target = true;
                }
            }
            pending_start = i + 1;
        }
        i = i + 1;
    }
    if (in_target) { hs.body_end = n; }
    ret hs;
}

fun dep_key_name(source: DepSource) opt[str] {
    if (source == DEP_SOURCE_GIT)  { ret opt[str].some{"git"}; }
    if (source == DEP_SOURCE_PATH) { ret opt[str].some{"path"}; }
    ret opt[str].none{};
}

fun build_dep_block(alloc: *A.Allocator, nl: str, spec: *DepTableSpec) res[str, outcome.Fail] {
    val esc_value_r: res[str, outcome.Fail] = toml_escape_value(alloc, spec.value);
    if (sel esc_value_r.err) { ret esc_value_r; }
    val esc_value: str = esc_value_r.ok;

    val has_ref: bool = spec.source == DEP_SOURCE_GIT && !str_empty(spec.ref);
    var esc_ref: str  = "";
    if (has_ref) {
        val esc_ref_r: res[str, outcome.Fail] = toml_escape_value(alloc, spec.ref);
        if (sel esc_ref_r.err) {
            str_free(alloc, esc_value);
            ret esc_ref_r;
        }
        esc_ref = esc_ref_r.ok;
    }

    val key_o: opt[str] = dep_key_name(spec.source);
    if (sel key_o.none) {
        str_free(alloc, esc_value);
        if (has_ref) { str_free(alloc, esc_ref); }
        ret res[str, outcome.Fail].err{outcome.unknown_catalog(alloc, "DepSource", spec.source::u32)};
    }
    val key:     str = key_o.some;
    var block_r: res[str, format.FormatError];
    if (has_ref) {
        block_r = format.sprint(alloc, "[dep.{}]{}{} = \"{}\"{}ref = \"{}\"{}", spec.name, nl, key, esc_value, nl, esc_ref, nl);
    }
    or {
        block_r = format.sprint(alloc, "[dep.{}]{}{} = \"{}\"{}", spec.name, nl, key, esc_value, nl);
    }
    str_free(alloc, esc_value);
    if (has_ref)         { str_free(alloc, esc_ref); }
    if (sel block_r.err) { ret res[str, outcome.Fail].err{outcome.internal(outcome.format_text(block_r.err))}; }
    ret res[str, outcome.Fail].ok{block_r.ok};
}

pub fun manifest_add_dep_table(alloc: *A.Allocator, source_text: str, spec: *DepTableSpec) res[str, outcome.Fail] {
    if (!is_valid_id(spec.name))                                         { ret res[str, outcome.Fail].err{outcome.user("dependency name must be a portable identifier (letters, digits, '_', '-')")}; }
    if (spec.source != DEP_SOURCE_GIT && spec.source != DEP_SOURCE_PATH) { ret res[str, outcome.Fail].err{outcome.user("unrecognized dependency source")}; }

    val kind_r: res[u8, outcome.Fail] = dep_entry_kind(alloc, source_text, spec.name);
    if (sel kind_r.err) { ret res[str, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml is not valid TOML: {}", outcome.describe(kind_r.err)))}; }
    if (kind_r.ok != DEP_LOOKUP_ABSENT) {
        ret res[str, outcome.Fail].err{outcome.user(sfmt(alloc, "dependency '{}' is already declared in mach.toml", spec.name))};
    }

    val nl:      str                    = if_crlf(source_text);
    val block_r: res[str, outcome.Fail] = build_dep_block(alloc, nl, spec);
    if (sel block_r.err) { ret block_r; }
    val block: str = block_r.ok;

    var sep: str = nl;
    if (!source_ends_with_newline(source_text)) { sep = sfmt(alloc, "{}{}", nl, nl); }

    val candidate_r: res[str, format.FormatError] = format.sprint(alloc, "{}{}{}", source_text, sep, block);
    str_free(alloc, block);
    if (sel candidate_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(candidate_r.err))}; }
    val candidate: str = candidate_r.ok;

    val verify_r: res[u8, outcome.Fail] = dep_entry_kind(alloc, candidate, spec.name);
    if (sel verify_r.err) {
        str_free(alloc, candidate);
        ret res[str, outcome.Fail].err{outcome.user("internal: added dependency table did not verify after reparse")};
    }
    if (verify_r.ok != DEP_LOOKUP_TABLE) {
        str_free(alloc, candidate);
        ret res[str, outcome.Fail].err{outcome.user("internal: added dependency table did not verify after reparse")};
    }
    ret res[str, outcome.Fail].ok{candidate};
}

pub fun manifest_remove_dep_table(alloc: *A.Allocator, source_text: str, name: str) res[str, outcome.Fail] {
    if (!is_valid_id(name)) { ret res[str, outcome.Fail].err{outcome.user("dependency name must be a portable identifier (letters, digits, '_', '-')")}; }

    val kind_r: res[u8, outcome.Fail] = dep_entry_kind(alloc, source_text, name);
    if (sel kind_r.err) { ret res[str, outcome.Fail].err{outcome.user(sfmt(alloc, "mach.toml is not valid TOML: {}", outcome.describe(kind_r.err)))}; }
    val kind: u8 = kind_r.ok;
    if (kind == DEP_LOOKUP_ABSENT)    { ret res[str, outcome.Fail].err{outcome.user(sfmt(alloc, "dependency '{}' is not declared in mach.toml", name))}; }
    if (kind == DEP_LOOKUP_NON_TABLE) { ret res[str, outcome.Fail].err{outcome.user(sfmt(alloc, "dependency '{}' exists in mach.toml but is not a table; edit it by hand", name))}; }

    val header: str        = sfmt(alloc, "[dep.{}]", name);
    val hs:     HeaderSpan = find_top_level_table(source_text, header);
    str_free(alloc, header);
    if (hs.ambiguous) { ret res[str, outcome.Fail].err{outcome.user(sfmt(alloc, "dependency '{}' is declared more than once in mach.toml; edit it by hand", name))}; }
    if (!hs.found)    { ret res[str, outcome.Fail].err{outcome.user(sfmt(alloc, "'[dep.{}]' was found by the parser but not by exact-header scan; edit it by hand", name))}; }

    val before_r: res[str, string.StrError] = str_copy_slice(alloc, source_text, 0, hs.start);
    if (sel before_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(before_r.err))}; }
    val before:  str                       = before_r.ok;
    val after_r: res[str, string.StrError] = str_copy_slice(alloc, source_text, hs.body_end, str_len(source_text) - hs.body_end);
    if (sel after_r.err) {
        str_free(alloc, before);
        ret res[str, outcome.Fail].err{outcome.user(outcome.str_text(after_r.err))};
    }
    val after: str = after_r.ok;

    val candidate_r: res[str, format.FormatError] = format.sprint(alloc, "{}{}", before, after);
    str_free(alloc, before);
    str_free(alloc, after);
    if (sel candidate_r.err) { ret res[str, outcome.Fail].err{outcome.user(outcome.format_text(candidate_r.err))}; }
    val candidate: str = candidate_r.ok;

    val verify_r: res[u8, outcome.Fail] = dep_entry_kind(alloc, candidate, name);
    if (sel verify_r.err) {
        str_free(alloc, candidate);
        ret res[str, outcome.Fail].err{outcome.user("internal: removed dependency table still verifies after reparse")};
    }
    if (verify_r.ok != DEP_LOOKUP_ABSENT) {
        str_free(alloc, candidate);
        ret res[str, outcome.Fail].err{outcome.user("internal: removed dependency table still verifies after reparse")};
    }
    ret res[str, outcome.Fail].ok{candidate};
}
