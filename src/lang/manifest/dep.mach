    val r:       res[str, outcome.Fail] = manifest_remove_dep_table(?alloc, doubled, "foo");
    if (!(sel r.err && str_contains(outcome.describe(r.err), "more than once"))) { code = 1; }

    arena.dnit(?ar);
    ret code;
}

test "mach.lang.manifest.manifest_remove_dep_table:refuses_when_not_a_table" {
