use mach.lang.fail;
use std.data.toml;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_len;
use std.types.string.str_starts_with;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use manifest_version: mach.lang.manifest.version;

use mach.lang.manifest.model.DepDef;
use mach.lang.manifest.model.Manifest;
use mach.lang.manifest.model.id_of;
use mach.lang.manifest.model.optional_id_of;
use mach.lang.manifest.refusal.point_at;
use mach.lang.manifest.refusal.refuse;
use mach.lang.manifest.refusal.sfmt;
use mach.lang.manifest.schema.key_text;
use mach.lang.manifest.schema.value_span;

fun dep_ref_hex(ref: str, start: usize) bool {
    val n:     usize = str_len(ref);
    val width: usize = n - start;
    if (width != 40 && width != 64) { ret false; }
    var i: usize = start;
    for (i < n) {
        val c: u8 = ref[i];
        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun dep_ref_component(ref: str, start: usize, end: usize) bool {
    if (start >= end || ref[start] == '.') { ret false; }
    if (end - start >= 5 && ref[end - 5] == '.' && ref[end - 4] == 'l'
        && ref[end - 3] == 'o' && ref[end - 2] == 'c' && ref[end - 1] == 'k') { ret false; }
    ret true;
}

fun dep_ref_name(ref: str, start: usize) bool {
    val n: usize = str_len(ref);
    if (start >= n || ref[start] == '/' || ref[n - 1] == '/' || ref[n - 1] == '.') { ret false; }
    var component_start: usize = start;
    var i:               usize = start;
    for (i < n) {
        val c: u8 = ref[i];
        if (c <= ' ' || c == 127 || c == '\\' || c == '~' || c == '^' || c == ':'
            || c == '?' || c == '*' || c == '[') { ret false; }
        if (c == '.' && i + 1 < n && ref[i + 1] == '.') { ret false; }
        if (c == '/' && i + 1 < n && ref[i + 1] == '/') { ret false; }
        if (c == '@' && i + 1 < n && ref[i + 1] == '{') { ret false; }
        if (c == '/') {
            if (!dep_ref_component(ref, component_start, i)) { ret false; }
            component_start = i + 1;
        }
        i = i + 1;
    }
    ret dep_ref_component(ref, component_start, n);
}

fun dep_ref_valid(ref: str) bool {
    if (str_starts_with(ref, "branch/")) { ret dep_ref_name(ref, 7); }
    if (str_starts_with(ref, "tag/"))    { ret dep_ref_name(ref, 4); }
    if (str_starts_with(ref, "commit/")) { ret dep_ref_hex(ref, 7); }
    ret false;
}

pub fun parse_deps(alloc: *A.Allocator, itn: *intern.Interner, t: *toml.Table, m: *Manifest) err[fail.Fail] {
    val tab_o: opt[*toml.Table] = toml.get_table(t, "dep");
    if (sel tab_o.none) { ret err[fail.Fail].ok{}; }
    val tab: *toml.Table = tab_o.some;
    val n:   usize       = toml.table_len(tab);
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val res_deps: res[*DepDef, A.Error] = A.allocate[DepDef](alloc, n);
    if (sel res_deps.err) { ret err[fail.Fail].err{fail.refused(res_deps.err)}; }
    m.deps      = res_deps.ok;
    m.dep_count = n::u32;

    var i: usize = 0;
    for (i < n) {
        val name_o: opt[str]         = toml.table_key(tab, i);
        val v_o:    opt[*toml.Value] = toml.table_value(tab, i);
        if (sel name_o.none) { brk; }
        if (sel v_o.none)    { brk; }
        val label: res[str, fail.Fail] = sfmt(alloc, "[dep.{}]", name_o.some);
        if (sel label.err) { ret err[fail.Fail].err{label.err}; }
        val decoded: err[fail.Fail] = dep_decode(alloc, itn, m, name_o.some, label.ok, v_o.some, ?m.deps[i]);
        str_free(alloc, label.ok);
        if (sel decoded.err) { ret decoded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun dep_decode(alloc: *A.Allocator, itn: *intern.Interner, m: *Manifest, name: str, label: str, v: *toml.Value, d: *DepDef) err[fail.Fail] {
    val sub:     *toml.Table                  = ?v.data.table;
    val name_id: res[intern.StrId, fail.Fail] = id_of(itn, name);
    if (sel name_id.err) { ret err[fail.Fail].err{name_id.err}; }
    d.name = name_id.ok;
    val git_s:    str  = key_text(sub, "git");
    val path_s:   str  = key_text(sub, "path");
    val has_git:  bool = !str_empty(git_s);
    val has_path: bool = !str_empty(path_s);
    if (has_git == has_path) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} needs exactly one source key: 'git' or 'path'", label), v.span)};
    }
    val ref_s:     str              = key_text(sub, "ref");
    val version_o: opt[*toml.Value] = toml.get(sub, "version");
    var version_s: str              = "";
    if (sel version_o.some) {
        version_s = version_o.some.data.string;
        val parsed: res[manifest_version.Range, manifest_version.RangeError] = manifest_version.parse_range(version_s);
        if (sel parsed.err) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.VERSION_INVALID_RANGE, "mach.toml: {}.version = \"{}\": {} (clause {})", label, version_s, parsed.err.reason, parsed.err.clause), version_o.some.span)};
        }
        if (!has_git) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.version selects releases of a git dependency; a path dependency has none", label), version_o.some.span)};
        }
        if (!str_empty(ref_s)) {
            ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {} names both 'ref' and 'version'; keep one: 'version' selects a release range, 'ref' one exact or branch selector", label), version_o.some.span)};
        }
    }
    if (has_git && str_empty(ref_s) && sel version_o.none) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_MISSING_REQUIRED, "mach.toml: {} is missing required key 'ref' or 'version' for git source", label), v.span)};
    }
    if (has_path && !str_empty(ref_s)) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_KEY_CONFLICT, "mach.toml: {}.ref is not allowed for path sources", label), value_span(sub, "ref"))};
    }
    if (has_git && !str_empty(ref_s) && !dep_ref_valid(ref_s)) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.MANIFEST_INVALID_VALUE, "mach.toml: {}.ref must be branch/<name>, tag/<name>, or commit/<full-object-id>", label), value_span(sub, "ref"))};
    }
    if (d.name == m.id) {
        ret err[fail.Fail].err{point_at(refuse(alloc, diagnostic_kind.DEP_SHADOWS_PROJECT, "mach.toml: {} has the same id as this project ('{}'), and a module path's first segment names one project, so `{}.<module>` cannot name both; rename the project or the dependency", label, name, name), v.key)};
    }
    var texts: [4]str = [4]str{git_s, path_s, ref_s, version_s};
    var ids:   [4]intern.StrId;
    var k:     usize  = 0;
    for (k < 4) {
        val r: res[intern.StrId, fail.Fail] = optional_id_of(itn, texts[k]);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        ids[k] = r.ok;
        k      = k + 1;
    }
    d.git     = ids[0];
    d.path    = ids[1];
    d.ref     = ids[2];
    d.version = ids[3];
    ret err[fail.Fail].ok{};
}
