use std.allocator.page;
use std.collections.map;
use std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.source;
use mach.lang.validation;

pub def Severity: u8;

pub val SEVERITY_ERROR:   Severity = 0;
pub val SEVERITY_WARNING: Severity = 1;
pub val SEVERITY_INFO:    Severity = 2;
pub val SEVERITY_HELP:    Severity = 3;

pub fun severity_valid(s: Severity) bool {
    ret s == SEVERITY_ERROR || s == SEVERITY_WARNING || s == SEVERITY_INFO || s == SEVERITY_HELP;
}

pub def ChildKind: u8;

pub val CHILD_NOTE: ChildKind = 0;
pub val CHILD_HELP: ChildKind = 1;

pub rec Location {
    file_id: source.FileId;
    span:    token.Span;
}

pub rec Child {
    kind: ChildKind;
    text: str;
}

pub rec Related {
    loc:   Location;
    label: str;
}

pub rec Edit {
    loc:         Location;
    replacement: str;
}

pub rec Fix {
    label: str;
    edits: Vector[Edit];
}

pub def FixId: usize;

pub rec Diagnostic {
    seq:      u64;
    severity: Severity;
    loc:      Location;
    message:  str;
    children: Vector[Child];
    related:  Vector[Related];
    fixes:    Vector[Fix];
}

pub rec DiagnosticId {
    index: usize;
    seq:   u64;
}

pub rec DiagMark {
    len:   usize;
    epoch: u64;
}

pub rec DiagnosticStore {
    a:           *A.Allocator;
    items:       Vector[Diagnostic];
    error_count: usize;
    lost:        usize;
    next_seq:    u64;
    epoch:       u64;
}

pub rec DiagnosticBuilder {
    a:        *A.Allocator;
    live:     bool;
    severity: Severity;
    loc:      Location;
    message:  str;
    children: Vector[Child];
    related:  Vector[Related];
    fixes:    Vector[Fix];
}

pub fun store_init(a: *A.Allocator) DiagnosticStore {
    var store: DiagnosticStore;
    store.a           = a;
    store.items       = vector.init[Diagnostic](a);
    store.error_count = 0;
    store.lost        = 0;
    store.next_seq     = 0;
    store.epoch        = 0;
    ret store;
}

fun free_related(a: *A.Allocator, r: *Related) {
    if (r.label != nil) { str_free(a, r.label); }
}

fun free_edit(a: *A.Allocator, e: *Edit) {
    if (e.replacement != nil) { str_free(a, e.replacement); }
}

fun free_fix(a: *A.Allocator, fx: *Fix) {
    if (fx.label != nil) { str_free(a, fx.label); }
    var e: usize = 0;
    for (e < fx.edits.len) {
        free_edit(a, ?fx.edits.data[e]);
        e = e + 1;
    }
    vector.dnit[Edit](?fx.edits);
}

fun free_child(a: *A.Allocator, c: *Child) {
    if (c.text != nil) { str_free(a, c.text); }
}

fun free_diagnostic(a: *A.Allocator, d: *Diagnostic) {
    if (d.message != nil) { str_free(a, d.message); }

    var c: usize = 0;
    for (c < d.children.len) {
        free_child(a, ?d.children.data[c]);
        c = c + 1;
    }
    vector.dnit[Child](?d.children);

    var r: usize = 0;
    for (r < d.related.len) {
        free_related(a, ?d.related.data[r]);
        r = r + 1;
    }
    vector.dnit[Related](?d.related);

    var f: usize = 0;
    for (f < d.fixes.len) {
        free_fix(a, ?d.fixes.data[f]);
        f = f + 1;
    }
    vector.dnit[Fix](?d.fixes);
}

pub fun mark(store: *DiagnosticStore) DiagMark {
    var m: DiagMark;
    m.len   = store.items.len;
    m.epoch = store.epoch;
    ret m;
}

pub fun truncate(store: *DiagnosticStore, m: DiagMark) R.Result[R.Void, str] {
    if (store == nil) { ret R.err[R.Void, str]("diagnostic store is nil"); }
    if (m.epoch != store.epoch) { ret R.err[R.Void, str]("diagnostic mark predates an unrelated truncate"); }
    if (m.len > store.items.len) { ret R.err[R.Void, str]("diagnostic mark exceeds current store length"); }
    if (m.len == store.items.len) { ret R.ok_void[str](); }

    var i: usize = m.len;
    for (i < store.items.len) {
        val d: *Diagnostic = ?store.items.data[i];
        if (d.severity == SEVERITY_ERROR) { store.error_count = store.error_count - 1; }
        free_diagnostic(store.a, d);
        i = i + 1;
    }
    store.items.len = m.len;
    store.epoch      = store.epoch + 1;
    ret R.ok_void[str]();
}

pub fun store_dnit(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    var zero: DiagMark;
    zero.len   = 0;
    zero.epoch = store.epoch;
    truncate(store, zero);
    vector.dnit[Diagnostic](?store.items);
    store.error_count = 0;
    store.lost        = 0;
}

pub fun len(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.items.len;
}

pub fun get(store: *DiagnosticStore, index: usize) R.Result[*Diagnostic, str] {
    if (store == nil) { ret R.err[*Diagnostic, str]("diagnostic store is nil"); }
    if (index >= store.items.len) { ret R.err[*Diagnostic, str]("diagnostic index out of bounds"); }
    ret R.ok[*Diagnostic, str](?store.items.data[index]);
}

pub fun has_errors(store: *DiagnosticStore) bool {
    ret store != nil && store.error_count > 0;
}

pub fun error_count(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.error_count;
}

pub fun note_error(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    store.error_count = store.error_count + 1;
}

pub fun builder_init(a: *A.Allocator, severity: Severity, file_id: source.FileId, span: token.Span, message: str) R.Result[DiagnosticBuilder, str] {
    if (!severity_valid(severity)) { ret R.err[DiagnosticBuilder, str]("invalid diagnostic severity"); }

    val dup_r: R.Result[str, str] = str_dup(a, message);
    if (R.is_err[str, str](dup_r)) { ret R.err[DiagnosticBuilder, str](R.unwrap_err[str, str](dup_r)); }

    var b: DiagnosticBuilder;
    b.a        = a;
    b.live     = true;
    b.severity = severity;
    b.loc.file_id = file_id;
    b.loc.span    = span;
    b.message  = R.unwrap_ok[str, str](dup_r);
    b.children = vector.init[Child](a);
    b.related  = vector.init[Related](a);
    b.fixes    = vector.init[Fix](a);
    ret R.ok[DiagnosticBuilder, str](b);
}

pub fun builder_dnit(b: *DiagnosticBuilder) {
    if (b == nil || !b.live) { ret; }

    if (b.message != nil) { str_free(b.a, b.message); }

    var c: usize = 0;
    for (c < b.children.len) {
        free_child(b.a, ?b.children.data[c]);
        c = c + 1;
    }
    vector.dnit[Child](?b.children);

    var r: usize = 0;
    for (r < b.related.len) {
        free_related(b.a, ?b.related.data[r]);
        r = r + 1;
    }
    vector.dnit[Related](?b.related);

    var f: usize = 0;
    for (f < b.fixes.len) {
        free_fix(b.a, ?b.fixes.data[f]);
        f = f + 1;
    }
    vector.dnit[Fix](?b.fixes);

    b.message = nil;
    b.live    = false;
}

fun push_child(a: *A.Allocator, children: *Vector[Child], kind: ChildKind, text: str) R.Result[R.Void, str] {
    val dup_r: R.Result[str, str] = str_dup(a, text);
    if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }

    var c: Child;
    c.kind = kind;
    c.text = R.unwrap_ok[str, str](dup_r);

    val push_r: R.Result[usize, str] = vector.push[Child](children, c);
    if (R.is_err[usize, str](push_r)) {
        str_free(a, c.text);
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun attach_note(b: *DiagnosticBuilder, text: str) R.Result[R.Void, str] {
    if (b == nil || !b.live) { ret R.err[R.Void, str]("diagnostic builder is not live"); }
    ret push_child(b.a, ?b.children, CHILD_NOTE, text);
}

pub fun attach_help(b: *DiagnosticBuilder, text: str) R.Result[R.Void, str] {
    if (b == nil || !b.live) { ret R.err[R.Void, str]("diagnostic builder is not live"); }
    ret push_child(b.a, ?b.children, CHILD_HELP, text);
}

pub fun attach_note_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) R.Result[R.Void, str] {
    val r: R.Result[*Diagnostic, str] = resolve(store, id);
    if (R.is_err[*Diagnostic, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*Diagnostic, str](r)); }
    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](r);
    ret push_child(store.a, ?d.children, CHILD_NOTE, text);
}

pub fun attach_help_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) R.Result[R.Void, str] {
    val r: R.Result[*Diagnostic, str] = resolve(store, id);
    if (R.is_err[*Diagnostic, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*Diagnostic, str](r)); }
    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](r);
    ret push_child(store.a, ?d.children, CHILD_HELP, text);
}

fun push_related(a: *A.Allocator, related: *Vector[Related], file_id: source.FileId, span: token.Span, label: str) R.Result[R.Void, str] {
    var r: Related;
    r.loc.file_id = file_id;
    r.loc.span    = span;
    r.label       = nil;

    if (label != nil && str_len(label) > 0) {
        val dup_r: R.Result[str, str] = str_dup(a, label);
        if (R.is_err[str, str](dup_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](dup_r)); }
        r.label = R.unwrap_ok[str, str](dup_r);
    }

    val push_r: R.Result[usize, str] = vector.push[Related](related, r);
    if (R.is_err[usize, str](push_r)) {
        if (r.label != nil) { str_free(a, r.label); }
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun attach_related(b: *DiagnosticBuilder, file_id: source.FileId, span: token.Span, label: str) R.Result[R.Void, str] {
    if (b == nil || !b.live) { ret R.err[R.Void, str]("diagnostic builder is not live"); }
    ret push_related(b.a, ?b.related, file_id, span, label);
}

pub fun attach_related_committed(store: *DiagnosticStore, id: DiagnosticId, file_id: source.FileId, span: token.Span, label: str) R.Result[R.Void, str] {
    val r: R.Result[*Diagnostic, str] = resolve(store, id);
    if (R.is_err[*Diagnostic, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*Diagnostic, str](r)); }
    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](r);
    ret push_related(store.a, ?d.related, file_id, span, label);
}

fun edits_overlap(a: *Edit, b: *Edit) bool {
    if (a.loc.file_id != b.loc.file_id) { ret false; }
    val a_start: usize = a.loc.span.offset;
    val a_end:   usize = a.loc.span.offset + a.loc.span.len;
    val b_start: usize = b.loc.span.offset;
    val b_end:   usize = b.loc.span.offset + b.loc.span.len;
    ret a_start < b_end && b_start < a_end;
}

fun fix_edit_overlaps_existing(fx: *Fix, candidate: *Edit) bool {
    var i: usize = 0;
    for (i < fx.edits.len) {
        if (edits_overlap(?fx.edits.data[i], candidate)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun push_fix(a: *A.Allocator, fixes: *Vector[Fix], label: str, file_id: source.FileId, span: token.Span, replacement: str) R.Result[FixId, str] {
    if (label == nil || str_len(label) == 0) { ret R.err[FixId, str]("fix label is required"); }

    val label_r: R.Result[str, str] = str_dup(a, label);
    if (R.is_err[str, str](label_r)) { ret R.err[FixId, str](R.unwrap_err[str, str](label_r)); }
    val label_owned: str = R.unwrap_ok[str, str](label_r);

    var text: str = replacement;
    if (text == nil) { text = ""; }
    val rep_r: R.Result[str, str] = str_dup(a, text);
    if (R.is_err[str, str](rep_r)) {
        str_free(a, label_owned);
        ret R.err[FixId, str](R.unwrap_err[str, str](rep_r));
    }

    var e: Edit;
    e.loc.file_id  = file_id;
    e.loc.span     = span;
    e.replacement  = R.unwrap_ok[str, str](rep_r);

    var fx: Fix;
    fx.label = label_owned;
    fx.edits = vector.init[Edit](a);

    val edit_push_r: R.Result[usize, str] = vector.push[Edit](?fx.edits, e);
    if (R.is_err[usize, str](edit_push_r)) {
        str_free(a, e.replacement);
        str_free(a, label_owned);
        vector.dnit[Edit](?fx.edits);
        ret R.err[FixId, str](R.unwrap_err[usize, str](edit_push_r));
    }

    val fix_push_r: R.Result[usize, str] = vector.push[Fix](fixes, fx);
    if (R.is_err[usize, str](fix_push_r)) {
        free_fix(a, ?fx);
        ret R.err[FixId, str](R.unwrap_err[usize, str](fix_push_r));
    }

    ret R.ok[FixId, str]((fixes.len - 1)::FixId);
}

fun push_fix_edit(a: *A.Allocator, fixes: *Vector[Fix], fix: FixId, file_id: source.FileId, span: token.Span, replacement: str) R.Result[R.Void, str] {
    if (fix::usize >= fixes.len) { ret R.err[R.Void, str]("fix id out of bounds"); }
    val fx: *Fix = ?fixes.data[fix::usize];

    var e: Edit;
    e.loc.file_id = file_id;
    e.loc.span    = span;
    e.replacement = nil;

    if (fix_edit_overlaps_existing(fx, ?e)) { ret R.err[R.Void, str]("fix edit overlaps an existing edit"); }

    var text: str = replacement;
    if (text == nil) { text = ""; }
    val rep_r: R.Result[str, str] = str_dup(a, text);
    if (R.is_err[str, str](rep_r)) { ret R.err[R.Void, str](R.unwrap_err[str, str](rep_r)); }
    e.replacement = R.unwrap_ok[str, str](rep_r);

    val push_r: R.Result[usize, str] = vector.push[Edit](?fx.edits, e);
    if (R.is_err[usize, str](push_r)) {
        str_free(a, e.replacement);
        ret R.err[R.Void, str](R.unwrap_err[usize, str](push_r));
    }
    ret R.ok_void[str]();
}

pub fun attach_fix(b: *DiagnosticBuilder, label: str, file_id: source.FileId, span: token.Span, replacement: str) R.Result[FixId, str] {
    if (b == nil || !b.live) { ret R.err[FixId, str]("diagnostic builder is not live"); }
    ret push_fix(b.a, ?b.fixes, label, file_id, span, replacement);
}

pub fun attach_fix_edit(b: *DiagnosticBuilder, fix: FixId, file_id: source.FileId, span: token.Span, replacement: str) R.Result[R.Void, str] {
    if (b == nil || !b.live) { ret R.err[R.Void, str]("diagnostic builder is not live"); }
    ret push_fix_edit(b.a, ?b.fixes, fix, file_id, span, replacement);
}

pub fun last_id(store: *DiagnosticStore) R.Result[DiagnosticId, str] {
    if (store == nil || store.items.len == 0) { ret R.err[DiagnosticId, str]("diagnostic store is empty"); }
    val d: *Diagnostic = ?store.items.data[store.items.len - 1];
    var id: DiagnosticId;
    id.index = store.items.len - 1;
    id.seq   = d.seq;
    ret R.ok[DiagnosticId, str](id);
}

pub fun attach_fix_committed(store: *DiagnosticStore, id: DiagnosticId, label: str, file_id: source.FileId, span: token.Span, replacement: str) R.Result[FixId, str] {
    val r: R.Result[*Diagnostic, str] = resolve(store, id);
    if (R.is_err[*Diagnostic, str](r)) { ret R.err[FixId, str](R.unwrap_err[*Diagnostic, str](r)); }
    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](r);
    ret push_fix(store.a, ?d.fixes, label, file_id, span, replacement);
}

pub fun attach_fix_edit_committed(store: *DiagnosticStore, id: DiagnosticId, fix: FixId, file_id: source.FileId, span: token.Span, replacement: str) R.Result[R.Void, str] {
    val r: R.Result[*Diagnostic, str] = resolve(store, id);
    if (R.is_err[*Diagnostic, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*Diagnostic, str](r)); }
    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](r);
    ret push_fix_edit(store.a, ?d.fixes, fix, file_id, span, replacement);
}

pub fun remove_fix_committed(store: *DiagnosticStore, id: DiagnosticId, fix: FixId) R.Result[R.Void, str] {
    val r: R.Result[*Diagnostic, str] = resolve(store, id);
    if (R.is_err[*Diagnostic, str](r)) { ret R.err[R.Void, str](R.unwrap_err[*Diagnostic, str](r)); }
    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](r);
    if (d.fixes.len == 0 || fix::usize != d.fixes.len - 1) {
        ret R.err[R.Void, str]("remove_fix_committed: fix is not the most recently attached fix on this diagnostic");
    }
    val pop_r: R.Result[Fix, str] = vector.pop[Fix](?d.fixes);
    if (R.is_err[Fix, str](pop_r)) { ret R.err[R.Void, str](R.unwrap_err[Fix, str](pop_r)); }
    var fx: Fix = R.unwrap_ok[Fix, str](pop_r);
    free_fix(store.a, ?fx);
    ret R.ok_void[str]();
}

pub fun fix_valid(fx: *Fix) bool {
    if (fx == nil || fx.label == nil || fx.edits.len == 0) { ret false; }
    var i: usize = 0;
    for (i < fx.edits.len) {
        var j: usize = i + 1;
        for (j < fx.edits.len) {
            if (edits_overlap(?fx.edits.data[i], ?fx.edits.data[j])) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun commit(b: *DiagnosticBuilder, store: *DiagnosticStore) R.Result[DiagnosticId, str] {
    if (b == nil || !b.live) { ret R.err[DiagnosticId, str]("diagnostic builder is not live"); }
    if (store == nil) { ret R.err[DiagnosticId, str]("diagnostic store is nil"); }
    if (b.a != store.a) { ret R.err[DiagnosticId, str]("diagnostic builder allocator does not match store allocator"); }

    if (b.severity == SEVERITY_ERROR) { note_error(store); }

    var d: Diagnostic;
    d.seq      = store.next_seq;
    d.severity = b.severity;
    d.loc      = b.loc;
    d.message  = b.message;
    d.children = b.children;
    d.related  = b.related;
    d.fixes    = b.fixes;

    val push_r: R.Result[usize, str] = vector.push[Diagnostic](?store.items, d);
    if (R.is_err[usize, str](push_r)) { ret R.err[DiagnosticId, str](R.unwrap_err[usize, str](push_r)); }

    var id: DiagnosticId;
    id.index = store.items.len - 1;
    id.seq   = d.seq;

    store.next_seq = store.next_seq + 1;

    b.message = nil;
    var empty_children: Vector[Child] = vector.init[Child](b.a);
    var empty_related:  Vector[Related] = vector.init[Related](b.a);
    var empty_fixes:    Vector[Fix] = vector.init[Fix](b.a);
    b.children = empty_children;
    b.related  = empty_related;
    b.fixes    = empty_fixes;
    b.live     = false;

    ret R.ok[DiagnosticId, str](id);
}

pub fun resolve(store: *DiagnosticStore, id: DiagnosticId) R.Result[*Diagnostic, str] {
    if (store == nil) { ret R.err[*Diagnostic, str]("diagnostic store is nil"); }
    if (id.index >= store.items.len) { ret R.err[*Diagnostic, str]("stale diagnostic id"); }
    val d: *Diagnostic = ?store.items.data[id.index];
    if (d.seq != id.seq) { ret R.err[*Diagnostic, str]("stale diagnostic id"); }
    ret R.ok[*Diagnostic, str](d);
}

fun emit(store: *DiagnosticStore, severity: Severity, file_id: source.FileId, span: token.Span, message: str) R.Result[R.Void, str] {
    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(store.a, severity, file_id, span, message);
    if (R.is_err[DiagnosticBuilder, str](b_r)) {
        if (severity == SEVERITY_ERROR) { note_error(store); }
        ret R.err[R.Void, str](R.unwrap_err[DiagnosticBuilder, str](b_r));
    }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);

    val commit_r: R.Result[DiagnosticId, str] = commit(?b, store);
    if (R.is_err[DiagnosticId, str](commit_r)) {
        builder_dnit(?b);
        ret R.err[R.Void, str](R.unwrap_err[DiagnosticId, str](commit_r));
    }
    ret R.ok_void[str]();
}

pub fun error(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) R.Result[R.Void, str] {
    ret emit(store, SEVERITY_ERROR, file_id, span, message);
}

pub fun warning(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) R.Result[R.Void, str] {
    ret emit(store, SEVERITY_WARNING, file_id, span, message);
}

pub fun info(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) R.Result[R.Void, str] {
    ret emit(store, SEVERITY_INFO, file_id, span, message);
}

pub fun help(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) R.Result[R.Void, str] {
    ret emit(store, SEVERITY_HELP, file_id, span, message);
}

pub fun record_error(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) {
    record(store, emit(store, SEVERITY_ERROR, file_id, span, message));
}

pub fun record_warning(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) {
    record(store, emit(store, SEVERITY_WARNING, file_id, span, message));
}

pub fun record_note_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) {
    record(store, attach_note_committed(store, id, text));
}

pub fun record_help_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) {
    record(store, attach_help_committed(store, id, text));
}

pub fun record_related_committed(store: *DiagnosticStore, id: DiagnosticId, file_id: source.FileId, span: token.Span, label: str) {
    record(store, attach_related_committed(store, id, file_id, span, label));
}

pub fun record_fix_committed(store: *DiagnosticStore, id: DiagnosticId, label: str, file_id: source.FileId, span: token.Span, replacement: str) {
    val r: R.Result[FixId, str] = attach_fix_committed(store, id, label, file_id, span, replacement);
    if (R.is_err[FixId, str](r)) { note_lost(store); }
}

pub fun record_gate_error(l: *GateDiagLedger, store: *DiagnosticStore, itn: *intern.Interner,
                          file_id: source.FileId, span: token.Span, message: str) {
    record(store, R.void_of[bool, str](gate_error(l, store, itn, file_id, span, message)));
}

pub fun record_gate_commit(l: *GateDiagLedger, store: *DiagnosticStore, itn: *intern.Interner,
                           b: *DiagnosticBuilder) {
    record(store, R.void_of[bool, str](gate_commit(l, store, itn, b)));
}

fun record(store: *DiagnosticStore, r: R.Result[R.Void, str]) {
    if (R.is_err[R.Void, str](r)) { note_lost(store); }
}

pub fun note_lost(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    store.lost = store.lost + 1;
    note_error(store);
}

pub fun lost_count(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.lost;
}

pub val GATE_NEVER_DECIDED_PREFIX: str =
    "this `$if` gate is never decided: `";

pub val GATE_NEVER_DECIDED_SUFFIX: str =
    "` is not a compile-time constant anywhere this module can see";

pub fun gate_error_named(
    l:       *GateDiagLedger,
    store:   *DiagnosticStore,
    itn:     *intern.Interner,
    file_id: source.FileId,
    span:    token.Span,
    name_id: intern.StrId,
    fallback: str
) R.Result[bool, str] {
    val no: O.Option[str] = intern.lookup(itn, name_id);
    if (O.is_none[str](no)) {
        ret gate_error(l, store, itn, file_id, span, fallback);
    }
    val joined: R.Result[str, str] =
        str_join(store.a, GATE_NEVER_DECIDED_PREFIX, O.unwrap[str](no), GATE_NEVER_DECIDED_SUFFIX);
    if (R.is_err[str, str](joined)) {
        ret gate_error(l, store, itn, file_id, span, fallback);
    }
    val msg: str = R.unwrap_ok[str, str](joined);
    val committed_r: R.Result[bool, str] = gate_error(l, store, itn, file_id, span, msg);
    str_free(store.a, msg);
    ret committed_r;
}

pub fun suggestion_build(a: *A.Allocator, name: str) R.Result[str, str] {
    ret str_join(a, "did you mean `", name, "`?");
}

pub fun fix_label_replace(a: *A.Allocator, name: str) R.Result[str, str] {
    ret str_join(a, "replace with `", name, "`");
}

fun copy_diagnostic_into(dst: *DiagnosticStore, d: *Diagnostic) R.Result[R.Void, str] {
    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(dst.a, d.severity, d.loc.file_id, d.loc.span, d.message);
    if (R.is_err[DiagnosticBuilder, str](b_r)) { ret R.err[R.Void, str](R.unwrap_err[DiagnosticBuilder, str](b_r)); }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *Child = ?d.children.data[c];
        val r: R.Result[R.Void, str] = push_child(b.a, ?b.children, child.kind, child.text);
        if (R.is_err[R.Void, str](r)) { builder_dnit(?b); ret r; }
        c = c + 1;
    }

    var r_i: usize = 0;
    for (r_i < d.related.len) {
        val rel: *Related = ?d.related.data[r_i];
        val r: R.Result[R.Void, str] = attach_related(?b, rel.loc.file_id, rel.loc.span, rel.label);
        if (R.is_err[R.Void, str](r)) { builder_dnit(?b); ret r; }
        r_i = r_i + 1;
    }

    var f: usize = 0;
    for (f < d.fixes.len) {
        val fx: *Fix = ?d.fixes.data[f];
        if (fx.edits.len == 0) { f = f + 1; cnt; }
        val first: *Edit = ?fx.edits.data[0];
        val fix_r: R.Result[FixId, str] = attach_fix(?b, fx.label, first.loc.file_id, first.loc.span, first.replacement);
        if (R.is_err[FixId, str](fix_r)) { builder_dnit(?b); ret R.err[R.Void, str](R.unwrap_err[FixId, str](fix_r)); }
        val fid: FixId = R.unwrap_ok[FixId, str](fix_r);

        var e: usize = 1;
        for (e < fx.edits.len) {
            val ed: *Edit = ?fx.edits.data[e];
            val er: R.Result[R.Void, str] = attach_fix_edit(?b, fid, ed.loc.file_id, ed.loc.span, ed.replacement);
            if (R.is_err[R.Void, str](er)) { builder_dnit(?b); ret er; }
            e = e + 1;
        }
        f = f + 1;
    }

    val commit_r: R.Result[DiagnosticId, str] = commit(?b, dst);
    if (R.is_err[DiagnosticId, str](commit_r)) {
        builder_dnit(?b);
        ret R.err[R.Void, str](R.unwrap_err[DiagnosticId, str](commit_r));
    }
    ret R.ok_void[str]();
}

pub fun snapshot_from(src: *DiagnosticStore, from: usize, a: *A.Allocator) R.Result[*DiagnosticStore, str] {
    val alloc_r: R.Result[*DiagnosticStore, str] = A.allocate[DiagnosticStore](a, 1);
    if (R.is_err[*DiagnosticStore, str](alloc_r)) { ret alloc_r; }
    val snap: *DiagnosticStore = R.unwrap_ok[*DiagnosticStore, str](alloc_r);
    @snap = store_init(a);

    if (from >= src.items.len) { ret R.ok[*DiagnosticStore, str](snap); }

    var i: usize = from;
    for (i < src.items.len) {
        val r: R.Result[R.Void, str] = copy_diagnostic_into(snap, ?src.items.data[i]);
        if (R.is_err[R.Void, str](r)) {
            store_dnit(snap);
            A.deallocate[DiagnosticStore](a, snap, 1);
            ret R.err[*DiagnosticStore, str](R.unwrap_err[R.Void, str](r));
        }
        i = i + 1;
    }
    ret R.ok[*DiagnosticStore, str](snap);
}

pub fun replay_into(dst: *DiagnosticStore, src: *DiagnosticStore) R.Result[R.Void, str] {
    if (dst == nil || src == nil) { ret R.err[R.Void, str]("diagnostic store is nil"); }
    if (dst == src) { ret R.err[R.Void, str]("cannot replay a diagnostic store into itself"); }

    val original_len: usize = dst.items.len;
    var i: usize = 0;
    for (i < src.items.len) {
        val r: R.Result[R.Void, str] = copy_diagnostic_into(dst, ?src.items.data[i]);
        if (R.is_err[R.Void, str](r)) {
            var m: DiagMark;
            m.len   = original_len;
            m.epoch = dst.epoch;
            val rollback_r: R.Result[R.Void, str] = truncate(dst, m);
            if (R.is_err[R.Void, str](rollback_r)) {
                ret R.err[R.Void, str]("replay_into: copy failed and rollback truncate also failed, diagnostic store may be poisoned");
            }
            ret r;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub rec GateDiagKey {
    file_id:    source.FileId;
    span_start: usize;
    span_end:   usize;
    severity:   Severity;
    msg:        intern.StrId;
}

fun gate_diag_key_hash(p: ptr) u64 {
    val k: *GateDiagKey = p::*GateDiagKey;
    var x: u64 = k.file_id::u64;
    x = x ^ ((k.span_start::u64) * 0x9e3779b97f4a7c15 + 1);
    x = x ^ ((k.span_end::u64)   * 0x9e3779b97f4a7c15 + 2);
    x = x ^ ((k.severity::u64)   * 0x9e3779b97f4a7c15 + 3);
    x = x ^ ((k.msg::u64)        * 0x9e3779b97f4a7c15 + 4);
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    ret x;
}

fun gate_diag_key_eq(pa: ptr, pb: ptr) bool {
    val a: *GateDiagKey = pa::*GateDiagKey;
    val b: *GateDiagKey = pb::*GateDiagKey;
    ret a.file_id == b.file_id
     && a.span_start == b.span_start
     && a.span_end == b.span_end
     && a.severity == b.severity
     && a.msg == b.msg;
}

pub rec GateDiagLedger {
    entries: map.Map[GateDiagKey, bool];
}

pub fun ledger_init(a: *A.Allocator) GateDiagLedger {
    var l: GateDiagLedger;
    l.entries = map.init[GateDiagKey, bool](a, gate_diag_key_hash, gate_diag_key_eq);
    ret l;
}

pub fun ledger_dnit(l: *GateDiagLedger) {
    if (l == nil) { ret; }
    map.dnit[GateDiagKey, bool](?l.entries);
}

pub fun gate_commit(
    l:     *GateDiagLedger,
    store: *DiagnosticStore,
    itn:   *intern.Interner,
    b:     *DiagnosticBuilder
) R.Result[bool, str] {
    if (b == nil || !b.live) { ret R.err[bool, str]("diagnostic builder is not live"); }

    val mid_r: R.Result[intern.StrId, str] = intern.intern(itn, b.message);
    if (R.is_err[intern.StrId, str](mid_r)) {
        if (b.severity == SEVERITY_ERROR) { note_error(store); }
        builder_dnit(b);
        ret R.err[bool, str](R.unwrap_err[intern.StrId, str](mid_r));
    }
    val mid: intern.StrId = R.unwrap_ok[intern.StrId, str](mid_r);

    var key: GateDiagKey;
    key.file_id    = b.loc.file_id;
    key.span_start = b.loc.span.offset;
    key.span_end   = b.loc.span.offset + b.loc.span.len;
    key.severity   = b.severity;
    key.msg        = mid;

    if (map.contains[GateDiagKey, bool](?l.entries, ?key)) {
        builder_dnit(b);
        ret R.ok[bool, str](false);
    }

    val cr: R.Result[DiagnosticId, str] = commit(b, store);
    if (R.is_err[DiagnosticId, str](cr)) {
        # a refused commit leaves the builder live and still owning its message,
        # children, related and fixes; every other exit here hands them back
        builder_dnit(b);
        ret R.err[bool, str](R.unwrap_err[DiagnosticId, str](cr));
    }

    val insert_r: R.Result[bool, str] = map.insert[GateDiagKey, bool](?l.entries, key, true);
    if (R.is_err[bool, str](insert_r)) { ret insert_r; }

    ret R.ok[bool, str](true);
}

pub fun gate_error(
    l:       *GateDiagLedger,
    store:   *DiagnosticStore,
    itn:     *intern.Interner,
    file_id: source.FileId,
    span:    token.Span,
    message: str
) R.Result[bool, str] {
    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(store.a, SEVERITY_ERROR, file_id, span, message);
    if (R.is_err[DiagnosticBuilder, str](b_r)) {
        note_error(store);
        ret R.err[bool, str](R.unwrap_err[DiagnosticBuilder, str](b_r));
    }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);
    ret gate_commit(l, store, itn, ?b);
}

fun test_span(offset: usize, len: usize) token.Span {
    var sp: token.Span;
    sp.offset = offset;
    sp.len    = len;
    ret sp;
}

test "mach.lang.diagnostic.len:nil_store_matches_other_accessors" {
    if (len(nil::*DiagnosticStore) != 0)       { ret 1; }
    if (has_errors(nil::*DiagnosticStore))     { ret 2; }
    if (error_count(nil::*DiagnosticStore) != 0) { ret 3; }
    ret 0;
}

test "mach.lang.diagnostic.emit:records_and_flags_errors" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);

    val sp: token.Span = test_span(0, 1);

    val res_warn: R.Result[R.Void, str] = warning(?store, 0::source.FileId, sp, "a warning");
    if (R.is_err[R.Void, str](res_warn)) { store_dnit(?store); ret 1; }
    if (has_errors(?store))            { store_dnit(?store); ret 1; }

    val res_err: R.Result[R.Void, str] = error(?store, 0::source.FileId, sp, "an error");
    if (R.is_err[R.Void, str](res_err)) { store_dnit(?store); ret 1; }
    if (!has_errors(?store))          { store_dnit(?store); ret 1; }
    if (error_count(?store) != 1)     { store_dnit(?store); ret 1; }

    if (len(?store) != 2)                                        { store_dnit(?store); ret 1; }
    if (R.unwrap_ok[*Diagnostic, str](get(?store, 0)).severity != SEVERITY_WARNING) { store_dnit(?store); ret 1; }
    if (R.unwrap_ok[*Diagnostic, str](get(?store, 1)).severity != SEVERITY_ERROR)   { store_dnit(?store); ret 1; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.builder:preserves_every_note_and_help_in_order" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(0, 1);

    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(?a, SEVERITY_ERROR, 0::source.FileId, sp, "an error");
    if (R.is_err[DiagnosticBuilder, str](b_r)) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);

    if (R.is_err[R.Void, str](attach_note(?b, "first note")))  { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (R.is_err[R.Void, str](attach_note(?b, "second note"))) { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (R.is_err[R.Void, str](attach_help(?b, "first help")))  { builder_dnit(?b); store_dnit(?store); ret 1; }

    val commit_r: R.Result[DiagnosticId, str] = commit(?b, ?store);
    if (R.is_err[DiagnosticId, str](commit_r)) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](get(?store, 0));
    var bad: i32 = 0;
    if (d.children.len != 3)                                     { bad = 1; }
    or (d.children.data[0].kind != CHILD_NOTE)                   { bad = 1; }
    or (!str_equals(d.children.data[0].text, "first note"))      { bad = 1; }
    or (d.children.data[1].kind != CHILD_NOTE)                   { bad = 1; }
    or (!str_equals(d.children.data[1].text, "second note"))     { bad = 1; }
    or (d.children.data[2].kind != CHILD_HELP)                   { bad = 1; }
    or (!str_equals(d.children.data[2].text, "first help"))      { bad = 1; }

    store_dnit(?store);
    ret bad;
}

test "mach.lang.diagnostic.attach_related:distinguishes_label_from_no_label" {
    var a: A.Allocator;
    page.make(?a);
    val sp: token.Span = test_span(10, 3);

    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(?a, SEVERITY_ERROR, 0::source.FileId, sp, "an error");
    if (R.is_err[DiagnosticBuilder, str](b_r)) { ret 1; }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);

    val rel: token.Span = test_span(42, 5);
    if (R.is_err[R.Void, str](attach_related(?b, 7::source.FileId, rel, "previous definition here"))) { builder_dnit(?b); ret 1; }
    if (R.is_err[R.Void, str](attach_related(?b, 9::source.FileId, sp, nil)))                          { builder_dnit(?b); ret 1; }
    if (R.is_err[R.Void, str](attach_related(?b, 9::source.FileId, sp, "")))                           { builder_dnit(?b); ret 1; }

    var bad: i32 = 0;
    if (b.related.len != 3)                                              { bad = 1; }
    or (b.related.data[0].label == nil)                                  { bad = 1; }
    or (!str_equals(b.related.data[0].label, "previous definition here")) { bad = 1; }
    or (b.related.data[1].label != nil)                                  { bad = 1; }
    or (b.related.data[2].label != nil)                                  { bad = 1; }

    builder_dnit(?b);
    ret bad;
}

test "mach.lang.diagnostic.attach_fix:accumulates_edits_and_validates" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(4, 5);

    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(?a, SEVERITY_ERROR, 1::source.FileId, sp, "unresolved identifier `helpr`");
    if (R.is_err[DiagnosticBuilder, str](b_r)) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);

    if (R.is_err[R.Void, str](attach_help(?b, "did you mean `helper`?"))) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val fix1_r: R.Result[FixId, str] = attach_fix(?b, "replace with `helper`", 1::source.FileId, sp, "helper");
    if (R.is_err[FixId, str](fix1_r)) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val head: token.Span = test_span(4, 0);
    val tail: token.Span = test_span(9, 0);
    val fix2_r: R.Result[FixId, str] = attach_fix(?b, "cast the value to `i64`", 1::source.FileId, head, "(");
    if (R.is_err[FixId, str](fix2_r)) { builder_dnit(?b); store_dnit(?store); ret 1; }
    val fix2: FixId = R.unwrap_ok[FixId, str](fix2_r);
    if (R.is_err[R.Void, str](attach_fix_edit(?b, fix2, 1::source.FileId, tail, ")::i64"))) { builder_dnit(?b); store_dnit(?store); ret 1; }

    if (b.fixes.len != 2)                       { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (b.fixes.data[0].edits.len != 1)         { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (b.fixes.data[1].edits.len != 2)         { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (!fix_valid(?b.fixes.data[0]))           { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (!fix_valid(?b.fixes.data[1]))           { builder_dnit(?b); store_dnit(?store); ret 1; }

    val commit_r: R.Result[DiagnosticId, str] = commit(?b, ?store);
    if (R.is_err[DiagnosticId, str](commit_r)) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](get(?store, 0));
    var bad: i32 = 0;
    if (!str_equals(d.fixes.data[0].label, "replace with `helper`"))        { bad = 1; }
    or (!str_equals(d.fixes.data[0].edits.data[0].replacement, "helper"))   { bad = 1; }
    or (!str_equals(d.fixes.data[1].edits.data[1].replacement, ")::i64"))   { bad = 1; }

    store_dnit(?store);
    ret bad;
}

test "mach.lang.diagnostic.attach_fix_edit:rejects_overlap_and_missing_fix" {
    var a: A.Allocator;
    page.make(?a);
    val sp: token.Span = test_span(4, 5);

    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(?a, SEVERITY_ERROR, 1::source.FileId, sp, "first");
    if (R.is_err[DiagnosticBuilder, str](b_r)) { ret 1; }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);

    val fix_r: R.Result[FixId, str] = attach_fix(?b, "fix it", 1::source.FileId, sp, "x");
    if (R.is_err[FixId, str](fix_r)) { builder_dnit(?b); ret 1; }
    val fix: FixId = R.unwrap_ok[FixId, str](fix_r);

    if (R.is_ok[R.Void, str](attach_fix_edit(?b, fix, 1::source.FileId, test_span(6, 1), "y"))) { builder_dnit(?b); ret 1; }
    if (R.is_ok[R.Void, str](attach_fix_edit(?b, 99::FixId, 1::source.FileId, test_span(20, 1), "z"))) { builder_dnit(?b); ret 1; }
    if (R.is_ok[FixId, str](attach_fix(?b, nil, 1::source.FileId, sp, "y")))    { builder_dnit(?b); ret 1; }
    if (R.is_ok[FixId, str](attach_fix(?b, "", 1::source.FileId, sp, "y")))     { builder_dnit(?b); ret 1; }
    if (b.fixes.len != 1 || b.fixes.data[0].edits.len != 1) { builder_dnit(?b); ret 1; }

    builder_dnit(?b);
    ret 0;
}

test "mach.lang.diagnostic.remove_fix_committed:rejects_a_fix_that_is_not_the_last_one" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(4, 5);

    if (R.is_err[R.Void, str](error(?store, 1::source.FileId, sp, "first"))) { store_dnit(?store); ret 1; }
    val id: DiagnosticId = R.unwrap_ok[DiagnosticId, str](last_id(?store));

    val fix1_r: R.Result[FixId, str] = attach_fix_committed(?store, id, "first fix", 1::source.FileId, sp, "a");
    if (R.is_err[FixId, str](fix1_r)) { store_dnit(?store); ret 1; }
    val fix1: FixId = R.unwrap_ok[FixId, str](fix1_r);
    val fix2_r: R.Result[FixId, str] = attach_fix_committed(?store, id, "second fix", 1::source.FileId, sp, "b");
    if (R.is_err[FixId, str](fix2_r)) { store_dnit(?store); ret 1; }

    if (R.is_ok[R.Void, str](remove_fix_committed(?store, id, fix1))) { store_dnit(?store); ret 2; }

    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](get(?store, 0));
    if (d.fixes.len != 2) { store_dnit(?store); ret 3; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.attach_fix_committed:atomic_multi_edit_rolls_back_on_second_edit_failure" {
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 64 && !found) {
        var backing: A.Allocator;
        page.make(?backing);
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var store: DiagnosticStore = store_init(T.allocator_of(?failing));
        val sp: token.Span = test_span(4, 5);
        val head: token.Span = test_span(4, 0);
        val tail: token.Span = test_span(9, 0);

        val err_r: R.Result[R.Void, str] = error(?store, 1::source.FileId, sp, "cast is required");
        if (R.is_ok[R.Void, str](err_r)) {
            val id: DiagnosticId = R.unwrap_ok[DiagnosticId, str](last_id(?store));
            val fix_r: R.Result[FixId, str] = attach_fix_committed(?store, id, "cast the value to `i64`", 1::source.FileId, head, "(");
            if (R.is_ok[FixId, str](fix_r)) {
                val fid: FixId = R.unwrap_ok[FixId, str](fix_r);
                val edit_r: R.Result[R.Void, str] = attach_fix_edit_committed(?store, id, fid, 1::source.FileId, tail, ")::i64");
                if (R.is_err[R.Void, str](edit_r)) {
                    if (R.is_err[R.Void, str](remove_fix_committed(?store, id, fid))) { store_dnit(?store); ret 1; }
                    val d: *Diagnostic = R.unwrap_ok[*Diagnostic, str](get(?store, 0));
                    if (d.fixes.len == 0) { found = true; }
                }
            }
        }

        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test "mach.lang.diagnostic.mark_truncate:discards_owned_tail_and_rejects_stale_marks" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(1, 2);

    if (R.is_err[R.Void, str](warning(?store, 0, sp, "kept"))) { store_dnit(?store); ret 1; }
    val mark_after_kept: DiagMark = mark(?store);

    if (R.is_err[R.Void, str](error(?store, 0, sp, "discarded")))    { store_dnit(?store); ret 2; }
    val mark_after_discarded: DiagMark = mark(?store);

    if (R.is_err[R.Void, str](truncate(?store, mark_after_kept)))    { store_dnit(?store); ret 3; }
    if (len(?store) != 1 || !str_equals(R.unwrap_ok[*Diagnostic, str](get(?store, 0)).message, "kept")) { store_dnit(?store); ret 4; }
    if (has_errors(?store))                                        { store_dnit(?store); ret 5; }

    if (R.is_ok[R.Void, str](truncate(?store, mark_after_discarded))) { store_dnit(?store); ret 6; }

    if (R.is_err[R.Void, str](error(?store, 0, sp, "replacement tail"))) { store_dnit(?store); ret 7; }
    if (len(?store) != 2 || !str_equals(R.unwrap_ok[*Diagnostic, str](get(?store, 1)).message, "replacement tail")) { store_dnit(?store); ret 8; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.snapshot_replay:round_trips_notes_related_and_fixes" {
    var a: A.Allocator;
    page.make(?a);
    var src: DiagnosticStore = store_init(?a);

    if (R.is_err[R.Void, str](warning(?src, 0::source.FileId, test_span(4, 2), "leading warning"))) { store_dnit(?src); ret 1; }
    val from: usize = len(?src);

    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(?a, SEVERITY_ERROR, 5::source.FileId, test_span(10, 3), "the error");
    if (R.is_err[DiagnosticBuilder, str](b_r)) { store_dnit(?src); ret 1; }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);
    attach_help(?b, "try this");
    attach_related(?b, 6::source.FileId, test_span(20, 1), "previous here");
    val fix_r: R.Result[FixId, str] = attach_fix(?b, "apply", 5::source.FileId, test_span(10, 3), "fixed");
    if (R.is_err[FixId, str](fix_r)) { builder_dnit(?b); store_dnit(?src); ret 1; }
    if (R.is_err[DiagnosticId, str](commit(?b, ?src))) { builder_dnit(?b); store_dnit(?src); ret 1; }

    val snap_r: R.Result[*DiagnosticStore, str] = snapshot_from(?src, from, ?a);
    if (R.is_err[*DiagnosticStore, str](snap_r)) { store_dnit(?src); ret 1; }
    val snap: *DiagnosticStore = R.unwrap_ok[*DiagnosticStore, str](snap_r);

    var dst: DiagnosticStore = store_init(?a);
    if (R.is_err[R.Void, str](replay_into(?dst, snap))) { store_dnit(?src); store_dnit(snap); A.deallocate[DiagnosticStore](?a, snap, 1); store_dnit(?dst); ret 1; }

    store_dnit(?src);

    var bad: i32 = 0;
    if (len(snap) != 1)                                                                          { bad = 1; }
    or (R.unwrap_ok[*Diagnostic, str](get(snap, 0)).severity != SEVERITY_ERROR)                   { bad = 1; }
    or (!str_equals(R.unwrap_ok[*Diagnostic, str](get(snap, 0)).message, "the error"))            { bad = 1; }
    or (R.unwrap_ok[*Diagnostic, str](get(snap, 0)).children.len != 1)                            { bad = 1; }
    or (!str_equals(R.unwrap_ok[*Diagnostic, str](get(snap, 0)).children.data[0].text, "try this")) { bad = 1; }
    or (R.unwrap_ok[*Diagnostic, str](get(snap, 0)).related.len != 1)                             { bad = 1; }
    or (!str_equals(R.unwrap_ok[*Diagnostic, str](get(snap, 0)).related.data[0].label, "previous here")) { bad = 1; }
    or (R.unwrap_ok[*Diagnostic, str](get(snap, 0)).fixes.len != 1)                               { bad = 1; }

    if (len(?dst) != 1)                                                                { bad = 1; }
    or (!str_equals(R.unwrap_ok[*Diagnostic, str](get(?dst, 0)).message, "the error")) { bad = 1; }
    or (R.unwrap_ok[*Diagnostic, str](get(?dst, 0)).fixes.len != 1)                    { bad = 1; }

    store_dnit(?dst);
    store_dnit(snap);
    A.deallocate[DiagnosticStore](?a, snap, 1);
    ret bad;
}

test "mach.lang.diagnostic.replay_into:rejects_self_and_rolls_back_on_failure" {
    var a: A.Allocator;
    page.make(?a);

    var store: DiagnosticStore = store_init(?a);
    if (R.is_err[R.Void, str](error(?store, 0, test_span(0, 1), "self"))) { store_dnit(?store); ret 1; }
    if (R.is_ok[R.Void, str](replay_into(?store, ?store))) { store_dnit(?store); ret 1; }
    store_dnit(?store);

    var src: DiagnosticStore = store_init(?a);
    if (R.is_err[R.Void, str](error(?src, 0, test_span(0, 1), "first"))) { store_dnit(?src); ret 1; }
    if (R.is_err[R.Void, str](error(?src, 0, test_span(1, 1), "second"))) { store_dnit(?src); ret 1; }

    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    if (O.is_some[str](T.make(?failing))) { store_dnit(?src); ret 1; }
    T.fail_at_ordinal(?failing, 3::usize);
    var dst: DiagnosticStore = store_init(T.allocator_of(?failing));
    if (R.is_err[R.Void, str](error(?dst, 0, test_span(0, 1), "already there"))) { store_dnit(?src); store_dnit(?dst); ret 1; }

    if (R.is_ok[R.Void, str](replay_into(?dst, ?src))) { store_dnit(?src); store_dnit(?dst); ret 1; }
    if (len(?dst) != 1) { store_dnit(?src); store_dnit(?dst); ret 1; }
    if (!str_equals(R.unwrap_ok[*Diagnostic, str](get(?dst, 0)).message, "already there")) { store_dnit(?src); store_dnit(?dst); ret 1; }

    store_dnit(?src);
    store_dnit(?dst);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.diagnostic.commit:fails_closed_when_allocator_is_exhausted" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    if (O.is_some[str](T.make(?failing))) { ret 1; }
    T.fail_at_ordinal(?failing, 1::usize);

    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(T.allocator_of(?failing), SEVERITY_ERROR, 0, test_span(0, 1), "an error");
    if (R.is_ok[DiagnosticBuilder, str](b_r)) {
        var built: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);
        builder_dnit(?built);
        ret 1;
    }
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.diagnostic.commit:builder_survives_a_failed_push_for_retry_or_teardown" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    if (O.is_some[str](T.make(?failing))) { ret 1; }
    T.fail_at_ordinal(?failing, 2::usize);

    var store: DiagnosticStore = store_init(T.allocator_of(?failing));
    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(T.allocator_of(?failing), SEVERITY_ERROR, 0, test_span(0, 1), "an error");
    if (R.is_err[DiagnosticBuilder, str](b_r)) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);

    val commit_r: R.Result[DiagnosticId, str] = commit(?b, ?store);
    if (R.is_ok[DiagnosticId, str](commit_r)) { store_dnit(?store); ret 1; }
    if (!b.live) { store_dnit(?store); ret 1; }
    if (len(?store) != 0) { builder_dnit(?b); store_dnit(?store); ret 1; }

    builder_dnit(?b);
    store_dnit(?store);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.diagnostic.resolve:rejects_a_diagnostic_id_invalidated_by_truncate" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);

    val b_r: R.Result[DiagnosticBuilder, str] = builder_init(?a, SEVERITY_ERROR, 0, test_span(0, 1), "first");
    if (R.is_err[DiagnosticBuilder, str](b_r)) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = R.unwrap_ok[DiagnosticBuilder, str](b_r);
    val commit_r: R.Result[DiagnosticId, str] = commit(?b, ?store);
    if (R.is_err[DiagnosticId, str](commit_r)) { builder_dnit(?b); store_dnit(?store); ret 1; }
    val id: DiagnosticId = R.unwrap_ok[DiagnosticId, str](commit_r);

    if (R.is_err[*Diagnostic, str](resolve(?store, id))) { store_dnit(?store); ret 1; }

    var zero: DiagMark;
    zero.len   = 0;
    zero.epoch = store.epoch;
    if (R.is_err[R.Void, str](truncate(?store, zero))) { store_dnit(?store); ret 1; }
    if (R.is_ok[*Diagnostic, str](resolve(?store, id))) { store_dnit(?store); ret 2; }

    if (R.is_err[R.Void, str](error(?store, 0, test_span(0, 1), "second"))) { store_dnit(?store); ret 1; }
    if (R.is_ok[*Diagnostic, str](resolve(?store, id))) { store_dnit(?store); ret 3; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.gate_error:dedups_by_key_and_lets_distinct_facets_through" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    var itn: intern.Interner = intern.init(?a);
    var ledger: GateDiagLedger = ledger_init(?a);
    val sp: token.Span = test_span(0, 4);

    val r1: R.Result[bool, str] = gate_error(?ledger, ?store, ?itn, 1::source.FileId, sp, "must have type u8");
    if (R.is_err[bool, str](r1) || !R.unwrap_ok[bool, str](r1)) { ledger_dnit(?ledger); intern.dnit(?itn); store_dnit(?store); ret 1; }

    val r2: R.Result[bool, str] = gate_error(?ledger, ?store, ?itn, 1::source.FileId, sp, "must have type u8");
    if (R.is_err[bool, str](r2) || R.unwrap_ok[bool, str](r2)) { ledger_dnit(?ledger); intern.dnit(?itn); store_dnit(?store); ret 2; }

    val r3: R.Result[bool, str] = gate_error(?ledger, ?store, ?itn, 1::source.FileId, sp, "a different message");
    if (R.is_err[bool, str](r3) || !R.unwrap_ok[bool, str](r3)) { ledger_dnit(?ledger); intern.dnit(?itn); store_dnit(?store); ret 3; }

    val r4: R.Result[bool, str] = gate_error(?ledger, ?store, ?itn, 2::source.FileId, sp, "must have type u8");
    if (R.is_err[bool, str](r4) || !R.unwrap_ok[bool, str](r4)) { ledger_dnit(?ledger); intern.dnit(?itn); store_dnit(?store); ret 4; }

    if (len(?store) != 3) { ledger_dnit(?ledger); intern.dnit(?itn); store_dnit(?store); ret 5; }

    ledger_dnit(?ledger);
    intern.dnit(?itn);
    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.gate_error:surfaces_ledger_insert_failure" {
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 64 && !found) {
        var backing: A.Allocator;
        page.make(?backing);
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var store: DiagnosticStore = store_init(T.allocator_of(?failing));
        var itn: intern.Interner = intern.init(T.allocator_of(?failing));
        var ledger: GateDiagLedger = ledger_init(T.allocator_of(?failing));
        val sp: token.Span = test_span(0, 4);

        val r: R.Result[bool, str] = gate_error(?ledger, ?store, ?itn, 1::source.FileId, sp, "x");
        if (R.is_err[bool, str](r) && len(?store) == 1) { found = true; }

        ledger_dnit(?ledger);
        intern.dnit(?itn);
        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test "mach.lang.diagnostic.record:a_lost_append_is_a_durable_rejection" {
    var backing: A.Allocator;
    page.make(?backing);

    val sp: token.Span = test_span(0, 1);

    var ordinal: u64 = 1;
    for (ordinal <= 4) {
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);
        var store: DiagnosticStore = store_init(T.allocator_of(?failing));

        record_warning(?store, 0::source.FileId, sp, "a warning");
        if (len(?store) == 0) {
            if (lost_count(?store) == 0)  { store_dnit(?store); ret 1; }
            if (!has_errors(?store))      { store_dnit(?store); ret 1; }
        }

        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }

    var clean: DiagnosticStore = store_init(?backing);
    record_warning(?clean, 0::source.FileId, sp, "a warning");
    if (len(?clean) != 1)         { store_dnit(?clean); ret 1; }
    if (lost_count(?clean) != 0)  { store_dnit(?clean); ret 1; }
    if (has_errors(?clean))       { store_dnit(?clean); ret 1; }

    record_error(?clean, 0::source.FileId, sp, "an error");
    if (len(?clean) != 2)         { store_dnit(?clean); ret 1; }
    if (!has_errors(?clean))      { store_dnit(?clean); ret 1; }
    if (lost_count(?clean) != 0)  { store_dnit(?clean); ret 1; }

    store_dnit(?clean);
    ret 0;
}
