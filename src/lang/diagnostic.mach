use mach.lang.fail;
use mach.lang.wire;
use std.allocator.page;
use std.collections.map;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.crypto.hash.fnv1a;
use std.memory;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use diagnostic_kind: mach.lang.diagnostic.kind;
use lang_source:     mach.lang.source;

# the phase or command that produced a diagnostic. ORIGIN_NONE is a store
# nothing has attributed yet; every other member has a stable name that the
# machine-readable rendering carries
pub def Origin: u8;

pub val ORIGIN_NONE:    Origin = 0;
pub val ORIGIN_BUILD:   Origin = 1;
pub val ORIGIN_LOAD:    Origin = 2;
pub val ORIGIN_RESOLVE: Origin = 3;
pub val ORIGIN_SEMA:    Origin = 4;
pub val ORIGIN_LOWER:   Origin = 5;
pub val ORIGIN_CODEGEN: Origin = 6;
pub val ORIGIN_LINK:    Origin = 7;
pub val ORIGIN_TEST:    Origin = 8;

val ORIGIN_N: usize = 9;

val ORIGIN_NAMES: [ORIGIN_N]str = [ORIGIN_N]str{nil, "build", "load", "resolve", "sema", "lower", "codegen", "link", "test"};

# the stable name of an origin
# ---
# o:   the origin
# ret: its name, or none for ORIGIN_NONE and a tag outside the catalog
pub fun origin_name(o: Origin) opt[str] {
    if (o::usize >= ORIGIN_N || ORIGIN_NAMES[o::usize] == nil) { ret opt[str].none{}; }
    ret opt[str].some{ORIGIN_NAMES[o::usize]};
}

pub def ChildKind: u8;

pub val CHILD_NOTE: ChildKind = 0;
pub val CHILD_HELP: ChildKind = 1;

pub rec Child {
    kind: ChildKind;
    text: str;
}

pub rec Related {
    loc:   lang_source.Location;
    label: str;
}

pub rec Edit {
    loc:         lang_source.Location;
    replacement: str;
}

pub rec Fix {
    label: str;
    edits: Vector[Edit];
}

pub def FixId: usize;

# one diagnostic; its severity is its kind's, read with `is_error`
pub rec Diagnostic {
    kind:     diagnostic_kind.Kind;
    origin:   Origin;
    loc:      lang_source.Location;
    message:  str;
    children: Vector[Child];
    related:  Vector[Related];
    fixes:    Vector[Fix];
}

rec DiagMark {
    len:   usize;
    epoch: u64;
}

# the diagnostics of a build, in the order they were committed. a store never
# holds the same report twice: a commit equal to one it holds, in everything but
# its origin, is dropped
pub rec DiagnosticStore {
    a:     *A.Allocator;
    items: Vector[Diagnostic];
    # the digest of each held report, to the first item that carries it
    reports:     map.Map[u64, usize];
    error_count: usize;
    lost:        usize;
    epoch:       u64;
    # the origin a diagnostic committed here takes when its builder names none
    origin: Origin;
    # warnings of these kinds are dropped as they reach the store
    silenced: diagnostic_kind.KindSet;
    # the `#[expect]` acknowledgements a warning is matched against before it
    # is silenced or kept
    expects: Vector[Expectation];
}

# one key of a declaration's `#[expect]`: a warning of a kind it selects,
# located in the declaration's own file between `start` and `end`, is
# acknowledged there and dropped
#
# file_id:   the declaration's file
# start:     the offset the declaration begins at, its doc comment included
# end:       the offset just past the declaration
# key:       where the key is spelled, which an unfulfilled report points at
# text:      the key as written, owned by the interner it was decoded into
# kinds:     the warning kinds the key selects
# judged:    the key selects a kind the source alone decides and the
#            declaration was checked this build, so fulfilment is reported
# fulfilled: a warning matched it
pub rec Expectation {
    file_id:   lang_source.FileId;
    start:     usize;
    end:       usize;
    key:       lang_source.Span;
    text:      str;
    kinds:     diagnostic_kind.KindSet;
    judged:    bool;
    fulfilled: bool;
}

# a diagnostic being assembled: notes, help, related places and fixes attach
# here, and `commit` hands the whole to a store
pub rec DiagnosticBuilder {
    a:    *A.Allocator;
    live: bool;
    kind: diagnostic_kind.Kind;
    # ORIGIN_NONE takes the store's origin at commit
    origin:   Origin;
    loc:      lang_source.Location;
    message:  str;
    children: Vector[Child];
    related:  Vector[Related];
    fixes:    Vector[Fix];
}

pub fun store_init(a: *A.Allocator) DiagnosticStore {
    var store: DiagnosticStore;
    store.a           = a;
    store.items       = collections_vector.init[Diagnostic](a);
    store.reports     = map.init[u64, usize](a);
    store.error_count = 0;
    store.lost        = 0;
    store.epoch       = 0;
    store.origin      = ORIGIN_NONE;
    store.silenced    = diagnostic_kind.set_empty();
    store.expects     = collections_vector.init[Expectation](a);
    ret store;
}

# the diagnostic is an error: its kind's row declares it one
pub fun is_error(d: *Diagnostic) bool {
    ret diagnostic_kind.is_error(d.kind);
}

# attribute every diagnostic committed to the store from now on whose builder
# names no origin to `o`; a diagnostic already committed keeps its own
pub fun set_origin(store: *DiagnosticStore, o: Origin) {
    store.origin = o;
}

# drop every warning of a kind in `set` that reaches the store from now on
pub fun silence(store: *DiagnosticStore, set: diagnostic_kind.KindSet) {
    store.silenced = set;
}

fun is_silenced(store: *DiagnosticStore, k: diagnostic_kind.Kind) bool {
    ret !diagnostic_kind.is_error(k) && diagnostic_kind.set_has(?store.silenced, k);
}

# acknowledge every warning an expectation in `list` covers as it reaches the
# store; the store takes the list
pub fun expect(store: *DiagnosticStore, list: Vector[Expectation]) {
    collections_vector.dnit[Expectation](?store.expects);
    store.expects = list;
}

# a warning at `loc` of kind `k` is acknowledged by every expectation around it
# that selects `k`, and each of those is fulfilled
fun is_expected(store: *DiagnosticStore, k: diagnostic_kind.Kind, loc: lang_source.Location) bool {
    if (diagnostic_kind.is_error(k) || k == diagnostic_kind.EXPECT_UNFULFILLED) { ret false; }
    var hit: bool  = false;
    var i:   usize = 0;
    for (i < store.expects.len) {
        val e: *Expectation = ?store.expects.data[i];
        if (e.file_id == loc.file && loc.span.offset >= e.start && loc.span.offset < e.end
            && diagnostic_kind.set_has(?e.kinds, k)) {
            e.fulfilled = true;
            hit         = true;
        }
        i = i + 1;
    }
    ret hit;
}

# an expectation nothing fulfilled is itself a warning, where it is judged: a
# build with errors judges none, since a pass it stopped may have been the one
# to raise the warning. the judgement is type checking's, whatever the store
# stamps otherwise
pub fun report_unfulfilled(store: *DiagnosticStore) {
    if (store == nil || store.error_count > 0) { ret; }
    val stamped: Origin = store.origin;
    store.origin = ORIGIN_SEMA;
    fin { store.origin = stamped; }
    var i: usize = 0;
    for (i < store.expects.len) {
        val e: *Expectation = ?store.expects.data[i];
        if (e.judged && !e.fulfilled) {
            val text: res[str, types_string.StrError] = str_join(store.a, "`#[expect]` names `", e.text,
                "`, but no such warning is raised inside this declaration");
            if (sel text.err) { note_lost(store); }
            or (sel text.ok) {
                record(store, diagnostic_kind.EXPECT_UNFULFILLED, e.file_id, e.key, text.ok);
                str_free(store.a, text.ok);
            }
        }
        i = i + 1;
    }
}

fun free_related(a: *A.Allocator, r: *Related) {
    if (r.label != nil) { str_free(a, r.label); }
}

fun free_edit(a: *A.Allocator, e: *Edit) {
    if (e.replacement != nil) { str_free(a, e.replacement); }
}

fun free_fix(a: *A.Allocator, fx: *Fix) {
    if (fx.label != nil) { str_free(a, fx.label); }
    var e: usize = 0;
    for (e < fx.edits.len) {
        free_edit(a, ?fx.edits.data[e]);
        e = e + 1;
    }
    collections_vector.dnit[Edit](?fx.edits);
}

fun free_child(a: *A.Allocator, c: *Child) {
    if (c.text != nil) { str_free(a, c.text); }
}

fun free_diagnostic(a: *A.Allocator, d: *Diagnostic) {
    if (d.message != nil) { str_free(a, d.message); }

    var c: usize = 0;
    for (c < d.children.len) {
        free_child(a, ?d.children.data[c]);
        c = c + 1;
    }
    collections_vector.dnit[Child](?d.children);

    var r: usize = 0;
    for (r < d.related.len) {
        free_related(a, ?d.related.data[r]);
        r = r + 1;
    }
    collections_vector.dnit[Related](?d.related);

    var f: usize = 0;
    for (f < d.fixes.len) {
        free_fix(a, ?d.fixes.data[f]);
        f = f + 1;
    }
    collections_vector.dnit[Fix](?d.fixes);
}

#[testing]
pub fun mark(store: *DiagnosticStore) DiagMark {
    var m: DiagMark;
    m.len   = store.items.len;
    m.epoch = store.epoch;
    ret m;
}

# the item at `index` leaves the store: its error is no longer counted and the
# report it carried is no longer held
fun forget(store: *DiagnosticStore, index: usize) {
    val d: *Diagnostic = ?store.items.data[index];
    if (is_error(d)) { store.error_count = store.error_count - 1; }
    var key: u64         = digest(d);
    val at:  opt[*usize] = map.get[u64, usize](?store.reports, ?key);
    if (sel at.some && @at.some == index) { map.remove[u64, usize](?store.reports, ?key); }
    free_diagnostic(store.a, d);
}

fun truncate(store: *DiagnosticStore, m: DiagMark) err[fail.Fail] {
    if (store == nil)             { ret err[fail.Fail].err{fail.message("diagnostic store is nil")}; }
    if (m.epoch != store.epoch)   { ret err[fail.Fail].err{fail.message("diagnostic mark predates an unrelated truncate")}; }
    if (m.len > store.items.len)  { ret err[fail.Fail].err{fail.message("diagnostic mark exceeds current store length")}; }
    if (m.len == store.items.len) { ret err[fail.Fail].ok{}; }

    var i: usize = m.len;
    for (i < store.items.len) {
        forget(store, i);
        i = i + 1;
    }
    store.items.len = m.len;
    store.epoch     = store.epoch + 1;
    ret err[fail.Fail].ok{};
}

# drop every diagnostic located in one file, keeping the rest in order. a module refreshed
# in place re-reports its own load diagnostics, so the old ones go; a mark taken before the
# drop is stale afterwards, as after a truncate
# ---
# store:   the store
# file_id: the file whose diagnostics go
pub fun drop_file(store: *DiagnosticStore, file_id: lang_source.FileId) {
    var kept: usize = 0;
    var i:    usize = 0;
    for (i < store.items.len) {
        val d: *Diagnostic = ?store.items.data[i];
        if (d.loc.file == file_id) { forget(store, i); }
        or {
            if (kept != i) {
                var key: u64         = digest(d);
                val at:  opt[*usize] = map.get[u64, usize](?store.reports, ?key);
                if (sel at.some) {
                    if (@at.some == i) { @at.some = kept; }
                }
                store.items.data[kept] = @d;
            }
            kept = kept + 1;
        }
        i = i + 1;
    }
    if (kept != store.items.len) {
        store.items.len = kept;
        store.epoch     = store.epoch + 1;
    }
}

pub fun store_dnit(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    var zero: DiagMark;
    zero.len   = 0;
    zero.epoch = store.epoch;
    truncate(store, zero);
    collections_vector.dnit[Diagnostic](?store.items);
    collections_vector.dnit[Expectation](?store.expects);
    map.dnit[u64, usize](?store.reports);
    store.error_count = 0;
    store.lost        = 0;
}

pub fun len(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.items.len;
}

#[testing]
pub fun get(store: *DiagnosticStore, index: usize) opt[*Diagnostic] {
    if (store == nil)             { ret opt[*Diagnostic].none{}; }
    if (index >= store.items.len) { ret opt[*Diagnostic].none{}; }
    ret opt[*Diagnostic].some{?store.items.data[index]};
}

#[testing]
pub fun has_errors(store: *DiagnosticStore) bool {
    ret store != nil && store.error_count > 0;
}

pub fun error_count(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.error_count;
}

val UNKEYED_TEXT: str = "a diagnostic names no live kind of the registry";

# a builder for a diagnostic of kind `k`
pub fun builder_init(a: *A.Allocator, k: diagnostic_kind.Kind, file_id: lang_source.FileId, span: lang_source.Span, message: str) res[DiagnosticBuilder, fail.Fail] {
    # every diagnostic names a live row of the registry: one that names none,
    # or a retired one, is a compiler defect and never reaches the store
    if (!diagnostic_kind.live(k)) { ret res[DiagnosticBuilder, fail.Fail].err{fail.message(UNKEYED_TEXT)}; }

    val dup_r: res[str, A.Error] = str_dup(a, message);
    if (sel dup_r.err) { ret res[DiagnosticBuilder, fail.Fail].err{fail.refused(dup_r.err)}; }

    var b: DiagnosticBuilder;
    b.a        = a;
    b.live     = true;
    b.kind     = k;
    b.origin   = ORIGIN_NONE;
    b.loc.file = file_id;
    b.loc.span = span;
    b.message  = dup_r.ok;
    b.children = collections_vector.init[Child](a);
    b.related  = collections_vector.init[Related](a);
    b.fixes    = collections_vector.init[Fix](a);
    ret res[DiagnosticBuilder, fail.Fail].ok{b};
}

pub fun builder_dnit(b: *DiagnosticBuilder) {
    if (b == nil || !b.live) { ret; }

    if (b.message != nil) { str_free(b.a, b.message); }

    var c: usize = 0;
    for (c < b.children.len) {
        free_child(b.a, ?b.children.data[c]);
        c = c + 1;
    }
    collections_vector.dnit[Child](?b.children);

    var r: usize = 0;
    for (r < b.related.len) {
        free_related(b.a, ?b.related.data[r]);
        r = r + 1;
    }
    collections_vector.dnit[Related](?b.related);

    var f: usize = 0;
    for (f < b.fixes.len) {
        free_fix(b.a, ?b.fixes.data[f]);
        f = f + 1;
    }
    collections_vector.dnit[Fix](?b.fixes);

    b.message = nil;
    b.live    = false;
}

fun push_child(b: *DiagnosticBuilder, kind: ChildKind, text: str) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    val dup_r: res[str, A.Error] = str_dup(b.a, text);
    if (sel dup_r.err) { ret err[fail.Fail].err{fail.refused(dup_r.err)}; }

    var c: Child;
    c.kind = kind;
    c.text = dup_r.ok;

    val push_r: res[usize, A.Error] = collections_vector.push[Child](?b.children, c);
    if (sel push_r.err) {
        str_free(b.a, c.text);
        ret err[fail.Fail].err{fail.refused(push_r.err)};
    }
    ret err[fail.Fail].ok{};
}

pub fun attach_note(b: *DiagnosticBuilder, text: str) err[fail.Fail] {
    ret push_child(b, CHILD_NOTE, text);
}

pub fun attach_help(b: *DiagnosticBuilder, text: str) err[fail.Fail] {
    ret push_child(b, CHILD_HELP, text);
}

# a related place; a nil or empty label shows the place without one
pub fun attach_related(b: *DiagnosticBuilder, file_id: lang_source.FileId, span: lang_source.Span, label: str) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    var r: Related;
    r.loc.file = file_id;
    r.loc.span = span;
    r.label    = nil;

    if (label != nil && str_len(label) > 0) {
        val dup_r: res[str, A.Error] = str_dup(b.a, label);
        if (sel dup_r.err) { ret err[fail.Fail].err{fail.refused(dup_r.err)}; }
        r.label = dup_r.ok;
    }

    val push_r: res[usize, A.Error] = collections_vector.push[Related](?b.related, r);
    if (sel push_r.err) {
        if (r.label != nil) { str_free(b.a, r.label); }
        ret err[fail.Fail].err{fail.refused(push_r.err)};
    }
    ret err[fail.Fail].ok{};
}

fun edits_overlap(a: *Edit, b: *Edit) bool {
    if (a.loc.file != b.loc.file) { ret false; }
    val a_start: usize = a.loc.span.offset;
    val a_end:   usize = a.loc.span.offset + a.loc.span.len;
    val b_start: usize = b.loc.span.offset;
    val b_end:   usize = b.loc.span.offset + b.loc.span.len;
    ret a_start < b_end && b_start < a_end;
}

fun fix_edit_overlaps_existing(fx: *Fix, candidate: *Edit) bool {
    var i: usize = 0;
    for (i < fx.edits.len) {
        if (edits_overlap(?fx.edits.data[i], candidate)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a fix of one edit, which `attach_fix_edit` extends
pub fun attach_fix(b: *DiagnosticBuilder, label: str, file_id: lang_source.FileId, span: lang_source.Span, replacement: str) res[FixId, fail.Fail] {
    if (b == nil || !b.live)                 { ret res[FixId, fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    if (label == nil || str_len(label) == 0) { ret res[FixId, fail.Fail].err{fail.message("fix label is required")}; }
    val a: *A.Allocator = b.a;

    val label_r: res[str, A.Error] = str_dup(a, label);
    if (sel label_r.err) { ret res[FixId, fail.Fail].err{fail.refused(label_r.err)}; }
    val label_owned: str = label_r.ok;

    var text: str = replacement;
    if (text == nil) { text = ""; }
    val rep_r: res[str, A.Error] = str_dup(a, text);
    if (sel rep_r.err) {
        str_free(a, label_owned);
        ret res[FixId, fail.Fail].err{fail.refused(rep_r.err)};
    }

    var e: Edit;
    e.loc.file    = file_id;
    e.loc.span    = span;
    e.replacement = rep_r.ok;

    var fx: Fix;
    fx.label = label_owned;
    fx.edits = collections_vector.init[Edit](a);

    val edit_push_r: res[usize, A.Error] = collections_vector.push[Edit](?fx.edits, e);
    if (sel edit_push_r.err) {
        str_free(a, e.replacement);
        str_free(a, label_owned);
        collections_vector.dnit[Edit](?fx.edits);
        ret res[FixId, fail.Fail].err{fail.refused(edit_push_r.err)};
    }

    val fix_push_r: res[usize, A.Error] = collections_vector.push[Fix](?b.fixes, fx);
    if (sel fix_push_r.err) {
        free_fix(a, ?fx);
        ret res[FixId, fail.Fail].err{fail.refused(fix_push_r.err)};
    }

    ret res[FixId, fail.Fail].ok{(b.fixes.len - 1)::FixId};
}

# a further edit of fix `fix`, which may not overlap one it already makes
pub fun attach_fix_edit(b: *DiagnosticBuilder, fix: FixId, file_id: lang_source.FileId, span: lang_source.Span, replacement: str) err[fail.Fail] {
    if (b == nil || !b.live)       { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    if (fix::usize >= b.fixes.len) { ret err[fail.Fail].err{fail.message("fix id out of bounds")}; }
    val fx: *Fix = ?b.fixes.data[fix::usize];

    var e: Edit;
    e.loc.file    = file_id;
    e.loc.span    = span;
    e.replacement = nil;

    if (fix_edit_overlaps_existing(fx, ?e)) { ret err[fail.Fail].err{fail.message("fix edit overlaps an existing edit")}; }

    var text: str = replacement;
    if (text == nil) { text = ""; }
    val rep_r: res[str, A.Error] = str_dup(b.a, text);
    if (sel rep_r.err) { ret err[fail.Fail].err{fail.refused(rep_r.err)}; }
    e.replacement = rep_r.ok;

    val push_r: res[usize, A.Error] = collections_vector.push[Edit](?fx.edits, e);
    if (sel push_r.err) {
        str_free(b.a, e.replacement);
        ret err[fail.Fail].err{fail.refused(push_r.err)};
    }
    ret err[fail.Fail].ok{};
}

# drop the most recently attached fix, as a fix whose later edit could not be
# attached is withdrawn whole
pub fun withdraw_fix(b: *DiagnosticBuilder, fix: FixId) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    if (b.fixes.len == 0 || fix::usize != b.fixes.len - 1) {
        ret err[fail.Fail].err{fail.message("only the most recently attached fix can be withdrawn")};
    }
    val pop_r: opt[Fix] = collections_vector.pop[Fix](?b.fixes);
    if (sel pop_r.none) { ret err[fail.Fail].err{fail.message("the fix list is empty")}; }
    var fx: Fix = pop_r.some;
    free_fix(b.a, ?fx);
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun fix_valid(fx: *Fix) bool {
    if (fx == nil || fx.label == nil || fx.edits.len == 0) { ret false; }
    var i: usize = 0;
    for (i < fx.edits.len) {
        var j: usize = i + 1;
        for (j < fx.edits.len) {
            if (edits_overlap(?fx.edits.data[i], ?fx.edits.data[j])) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun step_u64(h: u64, v: u64) u64 {
    ret fnv1a.step_u32(fnv1a.step_u32(h, (v & 0xFFFFFFFF)::u32), (v >> 32)::u32);
}

fun step_location(h: u64, loc: lang_source.Location) u64 {
    var x: u64 = fnv1a.step_u32(h, loc.file::u32);
    x = step_u64(x, loc.span.offset::u64);
    ret step_u64(x, loc.span.len::u64);
}

# a text and its length, so adjacent texts cannot run together; nil apart from empty
fun step_text(h: u64, t: str) u64 {
    if (t == nil) { ret fnv1a.step_u8(h, 0xFF); }
    val n: usize = str_len(t);
    ret fnv1a.step_bytes(step_u64(fnv1a.step_u8(h, 0), n::u64), t::*u8, n);
}

# the digest of what a diagnostic reports: everything but its origin
fun digest(d: *Diagnostic) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u32(h, d.kind::u32);
    h = step_location(h, d.loc);
    h = step_text(h, d.message);
    var i: usize = 0;
    for (i < d.children.len) {
        h = fnv1a.step_u8(h, d.children.data[i].kind::u8);
        h = step_text(h, d.children.data[i].text);
        i = i + 1;
    }
    h = step_u64(h, d.related.len::u64);
    i = 0;
    for (i < d.related.len) {
        h = step_location(h, d.related.data[i].loc);
        h = step_text(h, d.related.data[i].label);
        i = i + 1;
    }
    h = step_u64(h, d.fixes.len::u64);
    i = 0;
    for (i < d.fixes.len) {
        val fx: *Fix = ?d.fixes.data[i];
        h = step_text(h, fx.label);
        var e: usize = 0;
        for (e < fx.edits.len) {
            h = step_location(h, fx.edits.data[e].loc);
            h = step_text(h, fx.edits.data[e].replacement);
            e = e + 1;
        }
        i = i + 1;
    }
    ret h;
}

# hand the builder's diagnostic to the store; the builder is consumed whatever
# the outcome. a warning the store silences or an expectation acknowledges is
# dropped, and so is a report the store already holds
pub fun commit(b: *DiagnosticBuilder, store: *DiagnosticStore) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    fin { builder_dnit(b); }
    if (store == nil)   { ret err[fail.Fail].err{fail.message("diagnostic store is nil")}; }
    if (b.a != store.a) { ret err[fail.Fail].err{fail.message("diagnostic builder allocator does not match store allocator")}; }
    # an expected warning is acknowledged even where `allow` silences it too
    val expected: bool = is_expected(store, b.kind, b.loc);
    if (expected || is_silenced(store, b.kind)) { ret err[fail.Fail].ok{}; }

    var d: Diagnostic;
    d.kind   = b.kind;
    d.origin = b.origin;
    if (d.origin == ORIGIN_NONE) { d.origin = store.origin; }
    d.loc      = b.loc;
    d.message  = b.message;
    d.children = b.children;
    d.related  = b.related;
    d.fixes    = b.fixes;

    var key:  u64         = digest(?d);
    val held: opt[*usize] = map.get[u64, usize](?store.reports, ?key);
    if (sel held.some && same_report(?store.items.data[@held.some], ?d)) { ret err[fail.Fail].ok{}; }

    val push_r: res[usize, A.Error] = collections_vector.push[Diagnostic](?store.items, d);
    if (sel push_r.err) { ret err[fail.Fail].err{fail.refused(push_r.err)}; }
    # the store owns the diagnostic now; the builder keeps nothing to free
    b.message  = nil;
    b.children = collections_vector.init[Child](b.a);
    b.related  = collections_vector.init[Related](b.a);
    b.fixes    = collections_vector.init[Fix](b.a);
    if (is_error(?d)) { store.error_count = store.error_count + 1; }

    # a digest an unequal report already holds keeps pointing at that one
    if (sel held.none) {
        val noted: res[bool, A.Error] = map.insert[u64, usize](?store.reports, key, store.items.len - 1);
        if (sel noted.err) { ret err[fail.Fail].err{fail.refused(noted.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# a diagnostic of kind `k` with no attachments
pub fun report(store: *DiagnosticStore, k: diagnostic_kind.Kind, file_id: lang_source.FileId, span: lang_source.Span, message: str) err[fail.Fail] {
    if (store == nil) { ret err[fail.Fail].err{fail.message("diagnostic store is nil")}; }
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(store.a, k, file_id, span, message);
    if (sel b_r.err) { ret err[fail.Fail].err{b_r.err}; }
    var b: DiagnosticBuilder = b_r.ok;
    ret commit(?b, store);
}

# a diagnostic of kind `k` reported where the reporter has no failure to
# return: one the store cannot take is counted lost, which fails the build
pub fun record(store: *DiagnosticStore, k: diagnostic_kind.Kind, file_id: lang_source.FileId, span: lang_source.Span, message: str) {
    if (store == nil) { ret; }
    val r: err[fail.Fail] = report(store, k, file_id, span, message);
    if (sel r.err) { note_lost(store); }
}

# a diagnostic about the build as a whole, located at no source
pub fun record_unlocated(store: *DiagnosticStore, k: diagnostic_kind.Kind, message: str) {
    record(store, k, lang_source.FILE_NIL, lang_source.span(0, 0), message);
}

# a pass past the front end rejects the program: the refusal is an error
# located at `loc` on the store and the pass answers `reported`, exactly as a
# front-end pass does, so rendering, the tally and the exit status derive from
# one list. an append the store refuses is an internal failure; a store wired
# as nil is a compiler defect, and the text then stands as an internal failure
# rather than vanishing
pub fun reject(store: *DiagnosticStore, k: diagnostic_kind.Kind, loc: lang_source.Location, text: str) fail.Fail {
    if (store == nil) { ret fail.message(text); }
    val appended: err[fail.Fail] = report(store, k, loc.file, loc.span, text);
    if (sel appended.err) { ret appended.err; }
    ret fail.reported();
}

pub fun note_lost(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    store.lost        = store.lost + 1;
    store.error_count = store.error_count + 1;
}

pub fun lost_count(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.lost;
}

pub fun suggestion_build(a: *A.Allocator, name: str) res[str, fail.Fail] {
    val str_join_r: res[str, types_string.StrError] = str_join(a, "did you mean `", name, "`?");
    if (sel str_join_r.err) { ret res[str, fail.Fail].err{fail.str_refused(str_join_r.err)}; }
    ret res[str, fail.Fail].ok{str_join_r.ok};
}

pub fun fix_label_replace(a: *A.Allocator, name: str) res[str, fail.Fail] {
    val str_join_r: res[str, types_string.StrError] = str_join(a, "replace with `", name, "`");
    if (sel str_join_r.err) { ret res[str, fail.Fail].err{fail.str_refused(str_join_r.err)}; }
    ret res[str, fail.Fail].ok{str_join_r.ok};
}

fun copy_diagnostic_into(dst: *DiagnosticStore, d: *Diagnostic) err[fail.Fail] {
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(dst.a, d.kind, d.loc.file, d.loc.span, d.message);
    if (sel b_r.err) { ret err[fail.Fail].err{b_r.err}; }
    var b: DiagnosticBuilder = b_r.ok;
    fin { builder_dnit(?b); }
    b.origin = d.origin;

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *Child         = ?d.children.data[c];
        val r:     err[fail.Fail] = push_child(?b, child.kind, child.text);
        if (sel r.err) { ret r; }
        c = c + 1;
    }

    var r_i: usize = 0;
    for (r_i < d.related.len) {
        val rel: *Related       = ?d.related.data[r_i];
        val r:   err[fail.Fail] = attach_related(?b, rel.loc.file, rel.loc.span, rel.label);
        if (sel r.err) { ret r; }
        r_i = r_i + 1;
    }

    var f: usize = 0;
    for (f < d.fixes.len) {
        val fx: *Fix = ?d.fixes.data[f];
        if (fx.edits.len == 0) {
            f = f + 1;
            cnt;
        }
        val first: *Edit                 = ?fx.edits.data[0];
        val fix_r: res[FixId, fail.Fail] = attach_fix(?b, fx.label, first.loc.file, first.loc.span, first.replacement);
        if (sel fix_r.err) { ret err[fail.Fail].err{fix_r.err}; }
        val fid: FixId = fix_r.ok;

        var e: usize = 1;
        for (e < fx.edits.len) {
            val ed: *Edit          = ?fx.edits.data[e];
            val er: err[fail.Fail] = attach_fix_edit(?b, fid, ed.loc.file, ed.loc.span, ed.replacement);
            if (sel er.err) { ret er; }
            e = e + 1;
        }
        f = f + 1;
    }

    ret commit(?b, dst);
}

# the two report the same thing: equal in everything but their origin
fun same_report(left: *Diagnostic, right: *Diagnostic) bool {
    if (left.kind != right.kind || !lang_source.location_equals(left.loc, right.loc)
        || !str_equals(left.message, right.message) || left.children.len != right.children.len
        || left.related.len != right.related.len || left.fixes.len != right.fixes.len) { ret false; }
    var i: usize = 0;
    for (i < left.children.len) {
        val l: *Child = ?left.children.data[i];
        val r: *Child = ?right.children.data[i];
        if (l.kind != r.kind || !str_equals(l.text, r.text)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < left.related.len) {
        val l: *Related = ?left.related.data[i];
        val r: *Related = ?right.related.data[i];
        if (!lang_source.location_equals(l.loc, r.loc) || !str_equals(l.label, r.label)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < left.fixes.len) {
        val l: *Fix = ?left.fixes.data[i];
        val r: *Fix = ?right.fixes.data[i];
        if (!str_equals(l.label, r.label) || l.edits.len != r.edits.len) { ret false; }
        var j: usize = 0;
        for (j < l.edits.len) {
            val le: *Edit = ?l.edits.data[j];
            val re: *Edit = ?r.edits.data[j];
            if (!lang_source.location_equals(le.loc, re.loc) || !str_equals(le.replacement, re.replacement)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# compare observable diagnostic content without allocation or store identity
pub fun content_equal(left: *DiagnosticStore, right: *DiagnosticStore) res[bool, fail.Fail] {
    if ((left != nil && left.lost != 0) || (right != nil && right.lost != 0)) {
        ret res[bool, fail.Fail].err{fail.message("cannot compare diagnostics after an allocation failure")};
    }
    var ln: usize = 0;
    var rn: usize = 0;
    if (left != nil)  { ln = left.items.len; }
    if (right != nil) { rn = right.items.len; }
    if (ln != rn)     { ret res[bool, fail.Fail].ok{false}; }
    var i: usize = 0;
    for (i < ln) {
        val l: *Diagnostic = ?left.items.data[i];
        val r: *Diagnostic = ?right.items.data[i];
        if (l.origin != r.origin || !same_report(l, r)) { ret res[bool, fail.Fail].ok{false}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

pub fun snapshot_from(src: *DiagnosticStore, from: usize, a: *A.Allocator) res[*DiagnosticStore, fail.Fail] {
    val alloc_r: res[*DiagnosticStore, A.Error] = A.allocate[DiagnosticStore](a, 1);
    if (sel alloc_r.err) { ret res[*DiagnosticStore, fail.Fail].err{fail.refused(alloc_r.err)}; }
    val snap: *DiagnosticStore = alloc_r.ok;
    @snap = store_init(a);

    snap.lost        = src.lost;
    snap.error_count = src.lost;
    if (from >= src.items.len) { ret res[*DiagnosticStore, fail.Fail].ok{snap}; }

    var i: usize = from;
    for (i < src.items.len) {
        val r: err[fail.Fail] = copy_diagnostic_into(snap, ?src.items.data[i]);
        if (sel r.err) {
            store_dnit(snap);
            A.deallocate[DiagnosticStore](a, snap, 1);
            ret res[*DiagnosticStore, fail.Fail].err{r.err};
        }
        i = i + 1;
    }
    ret res[*DiagnosticStore, fail.Fail].ok{snap};
}

pub fun replay_into(dst: *DiagnosticStore, src: *DiagnosticStore) err[fail.Fail] {
    if (dst == nil || src == nil) { ret err[fail.Fail].err{fail.message("diagnostic store is nil")}; }
    if (dst == src)               { ret err[fail.Fail].err{fail.message("cannot replay a diagnostic store into itself")}; }

    val original_len: usize = dst.items.len;
    var i:            usize = 0;
    for (i < src.items.len) {
        val r: err[fail.Fail] = copy_diagnostic_into(dst, ?src.items.data[i]);
        if (sel r.err) {
            var m: DiagMark;
            m.len   = original_len;
            m.epoch = dst.epoch;
            val rollback_r: err[fail.Fail] = truncate(dst, m);
            if (sel rollback_r.err) {
                ret err[fail.Fail].err{fail.message("replay_into: copy failed and rollback truncate also failed, diagnostic store may be poisoned")};
            }
            ret r;
        }
        i = i + 1;
    }
    dst.lost        = dst.lost + src.lost;
    dst.error_count = dst.error_count + src.lost;
    ret err[fail.Fail].ok{};
}

# how an encoded store names its files: by path, which outlives the file ids
# of the session that encoded it
#
# ctx:     the table's own state, passed back to each function
# path_of: the path a file was loaded from, nil for one the table does not hold
# file_at: the file the reading session loaded from `path`, FILE_NIL when it
#          loaded none; a refusal when the lookup cannot be made
pub rec SourceTable {
    ctx:     ptr;
    path_of: fun(ptr, lang_source.FileId) str;
    file_at: fun(ptr, str) res[lang_source.FileId, fail.Fail];
}

val ABSENT: u32 = 0xFFFFFFFF;

fun put_text(w: *wire.Sink, t: str) {
    if (t == nil) {
        wire.put_u32(w, ABSENT);
        ret;
    }
    wire.put_sized(w, t::*u8, str_len(t));
}

fun put_place(w: *wire.Sink, sources: *SourceTable, loc: lang_source.Location) {
    var path: str = nil;
    if (loc.file != lang_source.FILE_NIL) { path = sources.path_of(sources.ctx, loc.file); }
    put_text(w, path);
    wire.put_u64(w, loc.span.offset::u64);
    wire.put_u64(w, loc.span.len::u64);
}

# write the store's diagnostics as bytes: their count, then per diagnostic its
# origin, its kind's key, location and message, then its notes, related places
# and fixes. a location is its file's path (absent as 0xFFFFFFFF), offset and
# length; a text is its length (absent as 0xFFFFFFFF) and bytes; every number
# little endian. a kind travels by its key, which never changes meaning
pub fun encode(w: *wire.Sink, store: *DiagnosticStore, sources: *SourceTable) {
    wire.put_u32(w, len(store)::u32);
    var i: usize = 0;
    for (i < len(store)) {
        val d: *Diagnostic = ?store.items.data[i];
        wire.put_u8(w, d.origin::u8);
        put_text(w, diagnostic_kind.key_of(d.kind));
        put_place(w, sources, d.loc);
        put_text(w, d.message);
        wire.put_u32(w, d.children.len::u32);
        var c: usize = 0;
        for (c < d.children.len) {
            wire.put_u8(w, d.children.data[c].kind::u8);
            put_text(w, d.children.data[c].text);
            c = c + 1;
        }
        wire.put_u32(w, d.related.len::u32);
        c = 0;
        for (c < d.related.len) {
            put_place(w, sources, d.related.data[c].loc);
            put_text(w, d.related.data[c].label);
            c = c + 1;
        }
        wire.put_u32(w, d.fixes.len::u32);
        c = 0;
        for (c < d.fixes.len) {
            val fx: *Fix = ?d.fixes.data[c];
            put_text(w, fx.label);
            wire.put_u32(w, fx.edits.len::u32);
            var e: usize = 0;
            for (e < fx.edits.len) {
                put_place(w, sources, fx.edits.data[e].loc);
                put_text(w, fx.edits.data[e].replacement);
                e = e + 1;
            }
            c = c + 1;
        }
        i = i + 1;
    }
}

# a text as a nul-terminated copy in a, nil when absent; the caller frees it
fun take_text(r: *wire.Source, a: *A.Allocator) str {
    val n: u32 = wire.take_u32(r);
    if (r.bad || n == ABSENT) { ret nil; }
    val at: *u8 = wire.take_bytes(r, n::usize);
    if (at == nil) { ret nil; }
    val copied: res[*u8, A.Error] = A.allocate[u8](a, n::usize + 1);
    if (sel copied.err) {
        wire.reject(r);
        ret nil;
    }
    memory.raw_copy(copied.ok::ptr, at::ptr, n::usize);
    copied.ok[n::usize] = 0;
    ret copied.ok::str;
}

fun drop_text(a: *A.Allocator, t: str) {
    if (t != nil) { str_free(a, t); }
}

# a recorded location, in the file the reading session loaded under its path,
# or unlocated when it loaded none
fun take_place(r: *wire.Source, sources: *SourceTable, a: *A.Allocator) res[lang_source.Location, fail.Fail] {
    var at:   lang_source.Location = lang_source.location_nil();
    val path: str                  = take_text(r, a);
    at.span.offset = wire.take_u64(r)::usize;
    at.span.len    = wire.take_u64(r)::usize;
    if (path == nil) { ret res[lang_source.Location, fail.Fail].ok{at}; }
    val found: res[lang_source.FileId, fail.Fail] = sources.file_at(sources.ctx, path);
    str_free(a, path);
    if (sel found.err) { ret res[lang_source.Location, fail.Fail].err{found.err}; }
    at.file = found.ok;
    ret res[lang_source.Location, fail.Fail].ok{at};
}

# read one encoded diagnostic into a builder; none when the bytes are malformed
# or name a kind this compiler does not raise, which ends the read
fun decode_one(r: *wire.Source, sources: *SourceTable, a: *A.Allocator) res[opt[DiagnosticBuilder], fail.Fail] {
    val origin: Origin = wire.take_u8(r)::Origin;
    val key:    str    = take_text(r, a);
    fin { drop_text(a, key); }
    val at: res[lang_source.Location, fail.Fail] = take_place(r, sources, a);
    if (sel at.err) { ret res[opt[DiagnosticBuilder], fail.Fail].err{at.err}; }
    val message: str = take_text(r, a);
    fin { drop_text(a, message); }
    if (r.bad || key == nil || message == nil) { ret res[opt[DiagnosticBuilder], fail.Fail].ok{opt[DiagnosticBuilder].none{}}; }
    val named: opt[diagnostic_kind.Kind] = diagnostic_kind.named(key);
    var k:     diagnostic_kind.Kind      = diagnostic_kind.NONE;
    if (sel named.some)           { k = named.some; }
    if (!diagnostic_kind.live(k)) { ret res[opt[DiagnosticBuilder], fail.Fail].ok{opt[DiagnosticBuilder].none{}}; }
    val begun: res[DiagnosticBuilder, fail.Fail] = builder_init(a, k, at.ok.file, at.ok.span, message);
    if (sel begun.err) { ret res[opt[DiagnosticBuilder], fail.Fail].err{begun.err}; }
    var b: DiagnosticBuilder = begun.ok;
    b.origin = origin;
    val built: err[fail.Fail] = decode_attachments(r, sources, ?b);
    if (sel built.err) {
        builder_dnit(?b);
        ret res[opt[DiagnosticBuilder], fail.Fail].err{built.err};
    }
    if (r.bad) {
        builder_dnit(?b);
        ret res[opt[DiagnosticBuilder], fail.Fail].ok{opt[DiagnosticBuilder].none{}};
    }
    ret res[opt[DiagnosticBuilder], fail.Fail].ok{opt[DiagnosticBuilder].some{b}};
}

fun decode_attachments(r: *wire.Source, sources: *SourceTable, b: *DiagnosticBuilder) err[fail.Fail] {
    val a:        *A.Allocator = b.a;
    val children: u32          = wire.take_u32(r);
    var c:        u32          = 0;
    for (c < children && !r.bad) {
        val kind: ChildKind = wire.take_u8(r)::ChildKind;
        val text: str       = take_text(r, a);
        if (text == nil) {
            wire.reject(r);
            ret err[fail.Fail].ok{};
        }
        val built: err[fail.Fail] = push_child(b, kind, text);
        str_free(a, text);
        if (sel built.err) { ret built; }
        c = c + 1;
    }
    val related: u32 = wire.take_u32(r);
    c = 0;
    for (c < related && !r.bad) {
        val loc: res[lang_source.Location, fail.Fail] = take_place(r, sources, a);
        if (sel loc.err) { ret err[fail.Fail].err{loc.err}; }
        val label: str            = take_text(r, a);
        val built: err[fail.Fail] = attach_related(b, loc.ok.file, loc.ok.span, label);
        drop_text(a, label);
        if (sel built.err) { ret built; }
        c = c + 1;
    }
    val fixes: u32 = wire.take_u32(r);
    c = 0;
    for (c < fixes && !r.bad) {
        val label: str            = take_text(r, a);
        val built: err[fail.Fail] = decode_fix(r, sources, b, label);
        drop_text(a, label);
        if (sel built.err) { ret built; }
        c = c + 1;
    }
    ret err[fail.Fail].ok{};
}

fun decode_fix(r: *wire.Source, sources: *SourceTable, b: *DiagnosticBuilder, label: str) err[fail.Fail] {
    val a:      *A.Allocator = b.a;
    val edits:  u32          = wire.take_u32(r);
    var opened: bool         = false;
    var fix:    FixId        = 0;
    var e:      u32          = 0;
    for (e < edits && !r.bad) {
        val loc: res[lang_source.Location, fail.Fail] = take_place(r, sources, a);
        if (sel loc.err) { ret err[fail.Fail].err{loc.err}; }
        val replacement: str            = take_text(r, a);
        var built:       err[fail.Fail] = err[fail.Fail].ok{};
        if (opened) { built = attach_fix_edit(b, fix, loc.ok.file, loc.ok.span, replacement); }
        or {
            val made: res[FixId, fail.Fail] = attach_fix(b, label, loc.ok.file, loc.ok.span, replacement);
            if (sel made.err) { built = err[fail.Fail].err{made.err}; }
            or (sel made.ok) {
                fix    = made.ok;
                opened = true;
            }
        }
        drop_text(a, replacement);
        if (sel built.err) { ret built; }
        e = e + 1;
    }
    ret err[fail.Fail].ok{};
}

# read one store `encode` wrote and commit its diagnostics to `into`: false
# when the bytes are malformed or name a kind this compiler does not raise,
# which ends the read where it stands
pub fun decode(r: *wire.Source, sources: *SourceTable, into: *DiagnosticStore) res[bool, fail.Fail] {
    val count: u32 = wire.take_u32(r);
    var i:     u32 = 0;
    for (i < count && !r.bad) {
        val one: res[opt[DiagnosticBuilder], fail.Fail] = decode_one(r, sources, into.a);
        if (sel one.err)     { ret res[bool, fail.Fail].err{one.err}; }
        if (sel one.ok.none) { ret res[bool, fail.Fail].ok{false}; }
        var b:         DiagnosticBuilder = one.ok.some;
        val committed: err[fail.Fail]    = commit(?b, into);
        if (sel committed.err) { ret res[bool, fail.Fail].err{committed.err}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{!r.bad};
}

test builder__preserves_every_note_and_help_in_order {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore  = store_init(?a);
    val sp:    lang_source.Span = lang_source.span(0, 1);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0::lang_source.FileId, sp, "an error");
    if (sel b_r.err) {
        store_dnit(?store);
        ret 1;
    }
    var b: DiagnosticBuilder = b_r.ok;

    val attach_note_r: err[fail.Fail] = attach_note(?b, "first note");
    if (sel attach_note_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }
    val attach_note_r2: err[fail.Fail] = attach_note(?b, "second note");
    if (sel attach_note_r2.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }
    val attach_help_r: err[fail.Fail] = attach_help(?b, "first help");
    if (sel attach_help_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }

    val commit_r: err[fail.Fail] = commit(?b, ?store);
    if (sel commit_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }

    val get_r: opt[*Diagnostic] = get(?store, 0);
    if (sel get_r.none) {
        store_dnit(?store);
        ret 99;
    }
    val d:   *Diagnostic = get_r.some;
    var bad: i32         = 0;
    if (d.children.len != 3)                                 { bad = 1; }
    or (d.children.data[0].kind != CHILD_NOTE)               { bad = 1; }
    or (!str_equals(d.children.data[0].text, "first note"))  { bad = 1; }
    or (d.children.data[1].kind != CHILD_NOTE)               { bad = 1; }
    or (!str_equals(d.children.data[1].text, "second note")) { bad = 1; }
    or (d.children.data[2].kind != CHILD_HELP)               { bad = 1; }
    or (!str_equals(d.children.data[2].text, "first help"))  { bad = 1; }

    store_dnit(?store);
    ret bad;
}

test attach_related__distinguishes_label_from_no_label {
    var a: A.Allocator;
    page.make(?a);
    val sp: lang_source.Span = lang_source.span(10, 3);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0::lang_source.FileId, sp, "an error");
    if (sel b_r.err) { ret 1; }
    var b: DiagnosticBuilder = b_r.ok;

    val rel:              lang_source.Span = lang_source.span(42, 5);
    val attach_related_r: err[fail.Fail]   = attach_related(?b, 7::lang_source.FileId, rel, "previous definition here");
    if (sel attach_related_r.err) {
        builder_dnit(?b);
        ret 1;
    }
    val attach_related_r2: err[fail.Fail] = attach_related(?b, 9::lang_source.FileId, sp, nil);
    if (sel attach_related_r2.err) {
        builder_dnit(?b);
        ret 1;
    }
    val attach_related_r3: err[fail.Fail] = attach_related(?b, 9::lang_source.FileId, sp, "");
    if (sel attach_related_r3.err) {
        builder_dnit(?b);
        ret 1;
    }

    var bad: i32 = 0;
    if (b.related.len != 3)                                               { bad = 1; }
    or (b.related.data[0].label == nil)                                   { bad = 1; }
    or (!str_equals(b.related.data[0].label, "previous definition here")) { bad = 1; }
    or (b.related.data[1].label != nil)                                   { bad = 1; }
    or (b.related.data[2].label != nil)                                   { bad = 1; }

    builder_dnit(?b);
    ret bad;
}

test attach_fix__accumulates_edits_and_validates {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore  = store_init(?a);
    val sp:    lang_source.Span = lang_source.span(4, 5);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1::lang_source.FileId, sp, "unresolved identifier `helpr`");
    if (sel b_r.err) {
        store_dnit(?store);
        ret 1;
    }
    var b: DiagnosticBuilder = b_r.ok;

    val attach_help_r: err[fail.Fail] = attach_help(?b, "did you mean `helper`?");
    if (sel attach_help_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }

    val fix1_r: res[FixId, fail.Fail] = attach_fix(?b, "replace with `helper`", 1::lang_source.FileId, sp, "helper");
    if (sel fix1_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }

    val head:   lang_source.Span      = lang_source.span(4, 0);
    val tail:   lang_source.Span      = lang_source.span(9, 0);
    val fix2_r: res[FixId, fail.Fail] = attach_fix(?b, "cast the value to `i64`", 1::lang_source.FileId, head, "(");
    if (sel fix2_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }
    val fix2:              FixId          = fix2_r.ok;
    val attach_fix_edit_r: err[fail.Fail] = attach_fix_edit(?b, fix2, 1::lang_source.FileId, tail, ")::i64");
    if (sel attach_fix_edit_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }

    if (b.fixes.len != 2) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }
    if (b.fixes.data[0].edits.len != 1) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }
    if (b.fixes.data[1].edits.len != 2) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }
    if (!fix_valid(?b.fixes.data[0])) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }
    if (!fix_valid(?b.fixes.data[1])) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }

    val commit_r: err[fail.Fail] = commit(?b, ?store);
    if (sel commit_r.err) {
        builder_dnit(?b);
        store_dnit(?store);
        ret 1;
    }

    val get_r: opt[*Diagnostic] = get(?store, 0);
    if (sel get_r.none) {
        store_dnit(?store);
        ret 99;
    }
    val d:   *Diagnostic = get_r.some;
    var bad: i32         = 0;
    if (!str_equals(d.fixes.data[0].label, "replace with `helper`"))      { bad = 1; }
    or (!str_equals(d.fixes.data[0].edits.data[0].replacement, "helper")) { bad = 1; }
    or (!str_equals(d.fixes.data[1].edits.data[1].replacement, ")::i64")) { bad = 1; }

    store_dnit(?store);
    ret bad;
}

test attach_fix_edit__rejects_overlap_and_missing_fix {
    var a: A.Allocator;
    page.make(?a);
    val sp: lang_source.Span = lang_source.span(4, 5);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1::lang_source.FileId, sp, "first");
    if (sel b_r.err) { ret 1; }
    var b: DiagnosticBuilder = b_r.ok;

    val fix_r: res[FixId, fail.Fail] = attach_fix(?b, "fix it", 1::lang_source.FileId, sp, "x");
    if (sel fix_r.err) {
        builder_dnit(?b);
        ret 1;
    }
    val fix: FixId = fix_r.ok;

    val attach_fix_edit_r: err[fail.Fail] = attach_fix_edit(?b, fix, 1::lang_source.FileId, lang_source.span(6, 1), "y");
    if (sel attach_fix_edit_r.ok) {
        builder_dnit(?b);
        ret 1;
    }
    val attach_fix_edit_r2: err[fail.Fail] = attach_fix_edit(?b, 99::FixId, 1::lang_source.FileId, lang_source.span(20, 1), "z");
    if (sel attach_fix_edit_r2.ok) {
        builder_dnit(?b);
        ret 1;
    }
    val attach_fix_r: res[FixId, fail.Fail] = attach_fix(?b, nil, 1::lang_source.FileId, sp, "y");
    if (sel attach_fix_r.ok) {
        builder_dnit(?b);
        ret 1;
    }
    val attach_fix_r2: res[FixId, fail.Fail] = attach_fix(?b, "", 1::lang_source.FileId, sp, "y");
    if (sel attach_fix_r2.ok) {
        builder_dnit(?b);
        ret 1;
    }
    if (b.fixes.len != 1 || b.fixes.data[0].edits.len != 1) {
        builder_dnit(?b);
        ret 1;
    }

    builder_dnit(?b);
    ret 0;
}

test withdraw_fix__rejects_a_fix_that_is_not_the_last_one {
    var a: A.Allocator;
    page.make(?a);
    val sp: lang_source.Span = lang_source.span(4, 5);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1::lang_source.FileId, sp, "first");
    if (sel b_r.err) { ret 1; }
    var b: DiagnosticBuilder = b_r.ok;
    fin { builder_dnit(?b); }

    val fix1_r: res[FixId, fail.Fail] = attach_fix(?b, "first fix", 1::lang_source.FileId, sp, "a");
    if (sel fix1_r.err) { ret 1; }
    val fix2_r: res[FixId, fail.Fail] = attach_fix(?b, "second fix", 1::lang_source.FileId, sp, "b");
    if (sel fix2_r.err) { ret 1; }

    val early: err[fail.Fail] = withdraw_fix(?b, fix1_r.ok);
    if (sel early.ok)     { ret 2; }
    if (b.fixes.len != 2) { ret 3; }
    val last: err[fail.Fail] = withdraw_fix(?b, fix2_r.ok);
    if (sel last.err)     { ret 4; }
    if (b.fixes.len != 1) { ret 5; }
    ret 0;
}

# a fix whose second edit cannot be attached is withdrawn whole, and the
# diagnostic commits without it
test withdraw_fix__a_fix_whose_second_edit_fails_leaves_none_behind {
    var found:   bool = false;
    var ordinal: u64  = 1;
    for (ordinal <= 64 && !found) {
        var failing: T.Testing;
        val make_r:  err[A.Error] = T.make(?failing);
        if (sel make_r.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var store: DiagnosticStore  = store_init(T.allocator_of(?failing));
        val sp:    lang_source.Span = lang_source.span(4, 5);
        val head:  lang_source.Span = lang_source.span(4, 0);
        val tail:  lang_source.Span = lang_source.span(9, 0);

        val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(T.allocator_of(?failing), diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1::lang_source.FileId, sp, "cast is required");
        if (sel b_r.ok) {
            var b:     DiagnosticBuilder     = b_r.ok;
            val fix_r: res[FixId, fail.Fail] = attach_fix(?b, "cast the value to `i64`", 1::lang_source.FileId, head, "(");
            if (sel fix_r.ok) {
                val edit_r: err[fail.Fail] = attach_fix_edit(?b, fix_r.ok, 1::lang_source.FileId, tail, ")::i64");
                if (sel edit_r.err) {
                    val withdrawn: err[fail.Fail] = withdraw_fix(?b, fix_r.ok);
                    if (sel withdrawn.err) {
                        builder_dnit(?b);
                        store_dnit(?store);
                        ret 1;
                    }
                    if (b.fixes.len == 0) { found = true; }
                }
            }
            commit(?b, ?store);
        }

        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test mark_truncate__discards_owned_tail_and_rejects_stale_marks {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    fin { store_dnit(?store); }
    val sp: lang_source.Span = lang_source.span(1, 2);

    val warned: err[fail.Fail] = report(?store, diagnostic_kind.IMPORT_UNUSED, 0, sp, "kept");
    if (sel warned.err) { ret 1; }
    val mark_after_kept: DiagMark = mark(?store);

    val refused: err[fail.Fail] = report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, sp, "discarded");
    if (sel refused.err) { ret 2; }
    val mark_after_discarded: DiagMark = mark(?store);

    val truncate_r: err[fail.Fail] = truncate(?store, mark_after_kept);
    if (sel truncate_r.err) { ret 3; }
    val kept: opt[*Diagnostic] = get(?store, 0);
    if (sel kept.none)                                              { ret 4; }
    if (len(?store) != 1 || !str_equals(kept.some.message, "kept")) { ret 4; }
    if (has_errors(?store))                                         { ret 5; }

    val stale: err[fail.Fail] = truncate(?store, mark_after_discarded);
    if (sel stale.ok) { ret 6; }

    val again: err[fail.Fail] = report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, sp, "replacement tail");
    if (sel again.err) { ret 7; }
    val tail: opt[*Diagnostic] = get(?store, 1);
    if (sel tail.none)                                                          { ret 8; }
    if (len(?store) != 2 || !str_equals(tail.some.message, "replacement tail")) { ret 8; }
    ret 0;
}

test snapshot_replay__round_trips_notes_related_and_fixes {
    var a: A.Allocator;
    page.make(?a);
    var src: DiagnosticStore = store_init(?a);

    val warning_r: err[fail.Fail] = report(?src, diagnostic_kind.IMPORT_UNUSED, 0::lang_source.FileId, lang_source.span(4, 2), "leading warning");
    if (sel warning_r.err) {
        store_dnit(?src);
        ret 1;
    }
    val from: usize = len(?src);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 5::lang_source.FileId, lang_source.span(10, 3), "the error");
    if (sel b_r.err) {
        store_dnit(?src);
        ret 1;
    }
    var b: DiagnosticBuilder = b_r.ok;
    attach_help(?b, "try this");
    attach_related(?b, 6::lang_source.FileId, lang_source.span(20, 1), "previous here");
    val fix_r: res[FixId, fail.Fail] = attach_fix(?b, "apply", 5::lang_source.FileId, lang_source.span(10, 3), "fixed");
    if (sel fix_r.err) {
        builder_dnit(?b);
        store_dnit(?src);
        ret 1;
    }
    val commit_r: err[fail.Fail] = commit(?b, ?src);
    if (sel commit_r.err) {
        store_dnit(?src);
        ret 1;
    }

    val snap_r: res[*DiagnosticStore, fail.Fail] = snapshot_from(?src, from, ?a);
    if (sel snap_r.err) {
        store_dnit(?src);
        ret 1;
    }
    val snap: *DiagnosticStore = snap_r.ok;

    var dst:           DiagnosticStore = store_init(?a);
    val replay_into_r: err[fail.Fail]  = replay_into(?dst, snap);
    if (sel replay_into_r.err) {
        store_dnit(?src);
        store_dnit(snap);
        A.deallocate[DiagnosticStore](?a, snap, 1);
        store_dnit(?dst);
        ret 1;
    }

    store_dnit(?src);

    var bad:     i32              = 0;
    val snapped: opt[*Diagnostic] = get(snap, 0);
    if (len(snap) != 1)   { bad = 1; }
    if (sel snapped.none) { bad = 1; }
    or (sel snapped.some) {
        val d: *Diagnostic = snapped.some;
        if (!is_error(d))                                          { bad = 1; }
        or (!str_equals(d.message, "the error"))                   { bad = 1; }
        or (d.children.len != 1)                                   { bad = 1; }
        or (!str_equals(d.children.data[0].text, "try this"))      { bad = 1; }
        or (d.related.len != 1)                                    { bad = 1; }
        or (!str_equals(d.related.data[0].label, "previous here")) { bad = 1; }
        or (d.fixes.len != 1)                                      { bad = 1; }
    }

    val replayed: opt[*Diagnostic] = get(?dst, 0);
    if (len(?dst) != 1)    { bad = 1; }
    if (sel replayed.none) { bad = 1; }
    or (sel replayed.some) {
        val d: *Diagnostic = replayed.some;
        if (!str_equals(d.message, "the error")) { bad = 1; }
        or (d.fixes.len != 1)                    { bad = 1; }
    }

    store_dnit(?dst);
    store_dnit(snap);
    A.deallocate[DiagnosticStore](?a, snap, 1);
    ret bad;
}

test replay_into__rejects_self_and_rolls_back_on_failure {
    var a: A.Allocator;
    page.make(?a);

    var store:   DiagnosticStore = store_init(?a);
    val error_r: err[fail.Fail]  = report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, lang_source.span(0, 1), "self");
    if (sel error_r.err) {
        store_dnit(?store);
        ret 1;
    }
    val replay_into_r: err[fail.Fail] = replay_into(?store, ?store);
    if (sel replay_into_r.ok) {
        store_dnit(?store);
        ret 1;
    }
    store_dnit(?store);

    var src:      DiagnosticStore = store_init(?a);
    val error_r2: err[fail.Fail]  = report(?src, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, lang_source.span(0, 1), "first");
    if (sel error_r2.err) {
        store_dnit(?src);
        ret 1;
    }
    val error_r3: err[fail.Fail] = report(?src, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, lang_source.span(1, 1), "second");
    if (sel error_r3.err) {
        store_dnit(?src);
        ret 1;
    }

    # the first refused allocation past the existing report lands in the replay,
    # which leaves the destination as it was
    var found:   bool = false;
    var ordinal: u64  = 1;
    for (ordinal <= 64 && !found) {
        var failing: T.Testing;
        val make_r:  err[A.Error] = T.make(?failing);
        if (sel make_r.err) {
            store_dnit(?src);
            ret 1;
        }
        T.fail_at_ordinal(?failing, ordinal::usize);
        var dst:   DiagnosticStore = store_init(T.allocator_of(?failing));
        var bad:   i32             = 0;
        val there: err[fail.Fail]  = report(?dst, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, lang_source.span(0, 1), "already there");
        if (sel there.ok) {
            val replayed: err[fail.Fail] = replay_into(?dst, ?src);
            if (sel replayed.err) {
                found = true;
                if (len(?dst) != 1)         { bad = 3; }
                or (error_count(?dst) != 1) { bad = 4; }
                or {
                    val present: opt[*Diagnostic] = get(?dst, 0);
                    if (sel present.none) { bad = 5; }
                    or (sel present.some) {
                        if (!str_equals(present.some.message, "already there")) { bad = 6; }
                    }
                }
            }
        }
        store_dnit(?dst);
        if (T.tracking_exhausted(?failing) || T.leaked(?failing) || T.double_free_count(?failing) != 0) { bad = 7; }
        T.dnit(?failing);
        if (bad != 0) {
            store_dnit(?src);
            ret bad;
        }
        ordinal = ordinal + 1;
    }
    store_dnit(?src);
    if (!found) { ret 2; }
    ret 0;
}

# a site cannot raise a diagnostic without naming its registry row: the
# builder refuses it, and so does every emission entry point built on it
test builder_init__refuses_a_diagnostic_without_a_kind {
    var a:    A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.NONE, 0, lang_source.span(0, 1), "unkeyed");
    if (sel b_r.ok) { ret 2; }
    val past: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, (diagnostic_kind.COUNT + 1)::diagnostic_kind.Kind, 0, lang_source.span(0, 1), "undeclared");
    if (sel past.ok) { ret 3; }
    var store: DiagnosticStore = store_init(?a);
    fin { store_dnit(?store); }
    val e_r: err[fail.Fail] = report(?store, diagnostic_kind.NONE, 0, lang_source.span(0, 1), "unkeyed");
    if (sel e_r.ok || len(?store) != 0) { ret 4; }
    ret 0;
}

test builder_init__fails_closed_when_the_allocator_is_exhausted {
    var failing: T.Testing;
    val make_r:  err[A.Error] = T.make(?failing);
    if (sel make_r.err) { ret 1; }
    T.fail_at_ordinal(?failing, 1::usize);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(T.allocator_of(?failing), diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, lang_source.span(0, 1), "an error");
    if (sel b_r.ok) {
        var built: DiagnosticBuilder = b_r.ok;
        builder_dnit(?built);
        ret 1;
    }
    if (T.tracking_exhausted(?failing)) {
        T.dnit(?failing);
        ret 1;
    }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
        T.dnit(?failing);
        ret 1;
    }
    T.dnit(?failing);
    ret 0;
}

# a commit the store cannot take still consumes the builder, so a refusal
# leaks nothing and leaves the store as it was
test commit__consumes_the_builder_when_the_store_refuses_it {
    var failing: T.Testing;
    val make_r:  err[A.Error] = T.make(?failing);
    if (sel make_r.err) { ret 1; }
    T.fail_at_ordinal(?failing, 2::usize);

    var store: DiagnosticStore                   = store_init(T.allocator_of(?failing));
    val b_r:   res[DiagnosticBuilder, fail.Fail] = builder_init(T.allocator_of(?failing), diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0, lang_source.span(0, 1), "an error");
    if (sel b_r.err) {
        store_dnit(?store);
        ret 1;
    }
    var b:   DiagnosticBuilder = b_r.ok;
    var bad: i32               = 0;

    val commit_r: err[fail.Fail] = commit(?b, ?store);
    if (sel commit_r.ok)          { bad = 2; }
    or (b.live)                   { bad = 3; }
    or (len(?store) != 0)         { bad = 4; }
    or (error_count(?store) != 0) { bad = 5; }

    store_dnit(?store);
    if (T.tracking_exhausted(?failing)) {
        T.dnit(?failing);
        ret 1;
    }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
        T.dnit(?failing);
        ret 1;
    }
    T.dnit(?failing);
    ret bad;
}

# a store keeps one copy of a report: the same kind, place, message and
# attachments again is dropped, whatever phase raised it, and a report that
# differs in any of them is kept
test commit__drops_a_report_the_store_already_holds {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    fin { store_dnit(?store); }
    val sp: lang_source.Span = lang_source.span(0, 4);

    if (!t_ok(report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "must have type u8"))) { ret 1; }
    set_origin(?store, ORIGIN_LOWER);
    if (!t_ok(report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "must have type u8"))) { ret 2; }
    if (len(?store) != 1 || error_count(?store) != 1)                                            { ret 3; }

    if (!t_ok(report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "a different message"))) { ret 4; }
    if (!t_ok(report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 2, sp, "must have type u8")))   { ret 5; }
    if (!t_ok(report(?store, diagnostic_kind.SECRET_BRANCH, 1, sp, "must have type u8")))          { ret 6; }
    if (len(?store) != 4)                                                                          { ret 7; }

    var r: i32 = 1;
    for (r <= 2) {
        val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "must have type u8");
        if (sel b_r.err) { ret 8; }
        var b: DiagnosticBuilder = b_r.ok;
        if (!t_ok(attach_related(?b, 1, lang_source.span(r::usize * 10, 1), "in this generic body"))) {
            builder_dnit(?b);
            ret 8;
        }
        if (!t_ok(commit(?b, ?store))) { ret 8; }
        r = r + 1;
    }
    if (len(?store) != 6 || error_count(?store) != 6) { ret 9; }
    ret 0;
}

test commit__surfaces_a_failed_report_ledger_insert {
    var found:   bool = false;
    var ordinal: u64  = 1;
    for (ordinal <= 64 && !found) {
        var failing: T.Testing;
        val make_r:  err[A.Error] = T.make(?failing);
        if (sel make_r.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var store: DiagnosticStore = store_init(T.allocator_of(?failing));
        val r:     err[fail.Fail]  = report(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1::lang_source.FileId, lang_source.span(0, 4), "x");
        if (sel r.err && len(?store) == 1) { found = true; }

        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

# a refusal past the front end and a warning located the same way point at
# the whole span of their location, not its first byte
test reject__points_at_the_whole_span {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    fin { store_dnit(?store); }
    val at: lang_source.Location = lang_source.location(3, lang_source.span(10, 7));
    val f:  fail.Fail            = reject(?store, diagnostic_kind.SECRET_NOT_OBLIVIOUS, at, "refused");
    if (!fail.is_reported(f)) { ret 1; }
    record(?store, diagnostic_kind.IMPORT_UNUSED, at.file, at.span, "warned");
    if (len(?store) != 2) { ret 2; }
    var i: usize = 0;
    for (i < 2) {
        if (!lang_source.location_equals(store.items.data[i].loc, at)) { ret 3; }
        i = i + 1;
    }
    ret 0;
}

test record__a_lost_append_is_a_durable_rejection {
    var backing: A.Allocator;
    page.make(?backing);

    val sp: lang_source.Span = lang_source.span(0, 1);

    var ordinal: u64 = 1;
    for (ordinal <= 4) {
        var failing: T.Testing;
        val make_r:  err[A.Error] = T.make(?failing);
        if (sel make_r.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);
        var store: DiagnosticStore = store_init(T.allocator_of(?failing));

        record(?store, diagnostic_kind.IMPORT_UNUSED, 0::lang_source.FileId, sp, "a warning");
        if (len(?store) == 0) {
            if (lost_count(?store) == 0) {
                store_dnit(?store);
                ret 1;
            }
            if (!has_errors(?store)) {
                store_dnit(?store);
                ret 1;
            }
        }

        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }

    var clean: DiagnosticStore = store_init(?backing);
    fin { store_dnit(?clean); }
    record(?clean, diagnostic_kind.IMPORT_UNUSED, 0::lang_source.FileId, sp, "a warning");
    if (len(?clean) != 1 || lost_count(?clean) != 0 || has_errors(?clean)) { ret 2; }
    record(?clean, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 0::lang_source.FileId, sp, "an error");
    if (len(?clean) != 2 || !has_errors(?clean) || lost_count(?clean) != 0) { ret 3; }
    ret 0;
}

# a report the store no longer holds, cut by a truncate or a dropped file, can
# be reported again, and one it still holds cannot, though the drop moved it
test commit__dedup_follows_truncation_and_dropped_files {
    var a: A.Allocator;
    page.make(?a);
    var first: DiagnosticStore = store_init(?a);
    fin { store_dnit(?first); }
    var second: DiagnosticStore = store_init(?a);
    fin { store_dnit(?second); }
    val sp: lang_source.Span = lang_source.span(3, 2);
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "kept"))) { ret 1; }
    val before_tail: DiagMark = mark(?first);
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "removed"))) { ret 2; }
    if (!t_ok(truncate(?first, before_tail)))                                          { ret 3; }
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "kept")))    { ret 4; }
    if (len(?first) != 1)                                                              { ret 4; }
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "removed"))) { ret 5; }
    if (!t_ok(report(?second, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "kept")))   { ret 6; }
    if (len(?first) != 2 || len(?second) != 1)                                         { ret 7; }

    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 2, sp, "moved"))) { ret 8; }
    drop_file(?first, 1);
    if (len(?first) != 1 || error_count(?first) != 1) { ret 9; }
    # the slots the drop freed are taken again before the moved report repeats
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 2, sp, "second"))) { ret 10; }
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 2, sp, "third")))  { ret 10; }
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 2, sp, "moved")))  { ret 11; }
    if (!t_ok(report(?first, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, sp, "kept")))   { ret 12; }
    if (len(?first) != 4)                                                             { ret 13; }
    ret 0;
}

test snapshot_replay__keeps_one_copy_and_truncates_cleanly {
    var a:      A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var src: DiagnosticStore = store_init(?a);
    fin { store_dnit(?src); }
    var dst: DiagnosticStore = store_init(?a);
    fin { store_dnit(?dst); }
    val span: lang_source.Span = lang_source.span(3, 1);
    if (!t_ok(report(?src, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, span, "invalid gate"))) { ret 2; }
    val snapshot_r: res[*DiagnosticStore, fail.Fail] = snapshot_from(?src, 0, ?a);
    if (sel snapshot_r.err) { ret 3; }
    val snapshot: *DiagnosticStore = snapshot_r.ok;
    fin {
        store_dnit(snapshot);
        A.deallocate[DiagnosticStore](?a, snapshot, 1);
    }
    val before: DiagMark = mark(?dst);
    if (!t_ok(replay_into(?dst, snapshot)))                                                 { ret 4; }
    if (!t_ok(replay_into(?dst, ?src)))                                                     { ret 5; }
    if (!t_ok(report(?dst, diagnostic_kind.SECRET_NOT_OBLIVIOUS, 1, span, "invalid gate"))) { ret 6; }
    if (len(?dst) != 1)                                                                     { ret 6; }
    if (!t_ok(truncate(?dst, before)))                                                      { ret 7; }
    if (!t_ok(replay_into(?dst, snapshot)))                                                 { ret 8; }
    if (len(?dst) != 1 || error_count(?dst) != 1)                                           { ret 9; }
    ret 0;
}

#[testing]
fun t_ok(r: err[fail.Fail]) bool {
    ret sel r.ok;
}

#[testing]
fun t_path_of(ctx: ptr, file: lang_source.FileId) str {
    if (file == 4) { ret "src/main.mach"; }
    ret nil;
}

#[testing]
fun t_file_at(ctx: ptr, path: str) res[lang_source.FileId, fail.Fail] {
    if (str_equals(path, "src/main.mach")) { ret res[lang_source.FileId, fail.Fail].ok{9}; }
    ret res[lang_source.FileId, fail.Fail].ok{lang_source.FILE_NIL};
}

# a store survives encoding: every diagnostic comes back with its kind,
# origin, message and attachments, its places in the reading session's files
test encode__round_trips_a_store_through_the_source_table {
    var a: A.Allocator;
    page.make(?a);
    var sources: SourceTable     = SourceTable{ctx: nil, path_of: t_path_of, file_at: t_file_at};
    var src:     DiagnosticStore = store_init(?a);
    fin { store_dnit(?src); }
    set_origin(?src, ORIGIN_SEMA);
    if (!t_ok(report(?src, diagnostic_kind.IMPORT_UNUSED, 4, lang_source.span(2, 3), "unused"))) { ret 1; }
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, diagnostic_kind.FLOAT_INEXACT, 4, lang_source.span(8, 1), "inexact");
    if (sel b_r.err) { ret 1; }
    var b: DiagnosticBuilder = b_r.ok;
    attach_note(?b, "a note");
    attach_help(?b, "a help");
    attach_related(?b, 5, lang_source.span(1, 1), "elsewhere");
    val fix_r: res[FixId, fail.Fail] = attach_fix(?b, "widen", 4, lang_source.span(8, 0), "(");
    if (sel fix_r.err) {
        builder_dnit(?b);
        ret 1;
    }
    attach_fix_edit(?b, fix_r.ok, 4, lang_source.span(9, 0), ")::f64");
    if (!t_ok(commit(?b, ?src))) { ret 1; }

    var w: wire.Sink = wire.grown(?a);
    fin { wire.dnit(?w); }
    encode(?w, ?src, ?sources);
    if (w.failed) { ret 2; }

    var dst: DiagnosticStore = store_init(?a);
    fin { store_dnit(?dst); }
    var r:   wire.Source          = wire.source(wire.bytes(?w), w.len);
    val got: res[bool, fail.Fail] = decode(?r, ?sources, ?dst);
    if (sel got.err)               { ret 3; }
    if (!got.ok || !wire.done(?r)) { ret 3; }
    if (len(?dst) != 2)            { ret 4; }
    val d: *Diagnostic = ?dst.items.data[1];
    if (d.kind != diagnostic_kind.FLOAT_INEXACT || d.origin != ORIGIN_SEMA)             { ret 5; }
    if (d.loc.file != 9 || d.loc.span.offset != 8 || !str_equals(d.message, "inexact")) { ret 6; }
    if (d.children.len != 2 || d.children.data[1].kind != CHILD_HELP)                   { ret 7; }
    if (d.related.len != 1 || d.related.data[0].loc.file != lang_source.FILE_NIL)       { ret 8; }
    if (d.fixes.len != 1 || d.fixes.data[0].edits.len != 2)                             { ret 9; }
    if (!str_equals(d.fixes.data[0].edits.data[1].replacement, ")::f64"))               { ret 10; }

    var cut:  wire.Source     = wire.source(wire.bytes(?w), w.len - 1);
    var lost: DiagnosticStore = store_init(?a);
    fin { store_dnit(?lost); }
    val short: res[bool, fail.Fail] = decode(?cut, ?sources, ?lost);
    if (sel short.err) { ret 11; }
    if (short.ok)      { ret 12; }
    ret 0;
}
