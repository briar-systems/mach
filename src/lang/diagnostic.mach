use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use string: std.types.string;
use page: std.allocator.page;
use map: std.collections.map;
use vector: std.collections.vector;
use std.collections.vector.Vector;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.source;
use mach.lang.validation;

pub def Severity: u8;

pub val SEVERITY_ERROR:   Severity = 0;
pub val SEVERITY_WARNING: Severity = 1;
pub val SEVERITY_INFO:    Severity = 2;
pub val SEVERITY_HELP:    Severity = 3;

pub fun severity_valid(s: Severity) bool {
    ret s == SEVERITY_ERROR || s == SEVERITY_WARNING || s == SEVERITY_INFO || s == SEVERITY_HELP;
}

pub def ChildKind: u8;

pub val CHILD_NOTE: ChildKind = 0;
pub val CHILD_HELP: ChildKind = 1;

pub rec Location {
    file_id: source.FileId;
    span:    token.Span;
}

pub rec Child {
    kind: ChildKind;
    text: str;
}

pub rec Related {
    loc:   Location;
    label: str;
}

pub rec Edit {
    loc:         Location;
    replacement: str;
}

pub rec Fix {
    label: str;
    edits: Vector[Edit];
}

pub def FixId: usize;

pub rec Diagnostic {
    seq:      u64;
    gate_key: GateDiagKey;
    severity: Severity;
    loc:      Location;
    message:  str;
    children: Vector[Child];
    related:  Vector[Related];
    fixes:    Vector[Fix];
}

pub rec DiagnosticId {
    index: usize;
    seq:   u64;
}

pub rec DiagMark {
    len:   usize;
    epoch: u64;
}

pub rec DiagnosticStore {
    a:           *A.Allocator;
    items:       Vector[Diagnostic];
    gates:       map.Map[GateDiagKey, bool];
    error_count: usize;
    lost:        usize;
    next_seq:    u64;
    epoch:       u64;
}

pub rec DiagnosticBuilder {
    a:        *A.Allocator;
    live:     bool;
    severity: Severity;
    loc:      Location;
    message:  str;
    children: Vector[Child];
    related:  Vector[Related];
    fixes:    Vector[Fix];
}

pub fun store_init(a: *A.Allocator) DiagnosticStore {
    var store: DiagnosticStore;
    store.a           = a;
    store.items       = vector.init[Diagnostic](a);
    store.gates       = map.init[GateDiagKey, bool](a, gate_diag_key_hash, gate_diag_key_eq);
    store.error_count = 0;
    store.lost        = 0;
    store.next_seq     = 0;
    store.epoch        = 0;
    ret store;
}

fun free_related(a: *A.Allocator, r: *Related) {
    if (r.label != nil) { str_free(a, r.label); }
}

fun free_edit(a: *A.Allocator, e: *Edit) {
    if (e.replacement != nil) { str_free(a, e.replacement); }
}

fun free_fix(a: *A.Allocator, fx: *Fix) {
    if (fx.label != nil) { str_free(a, fx.label); }
    var e: usize = 0;
    for (e < fx.edits.len) {
        free_edit(a, ?fx.edits.data[e]);
        e = e + 1;
    }
    vector.dnit[Edit](?fx.edits);
}

fun free_child(a: *A.Allocator, c: *Child) {
    if (c.text != nil) { str_free(a, c.text); }
}

fun free_diagnostic(a: *A.Allocator, d: *Diagnostic) {
    if (d.message != nil) { str_free(a, d.message); }

    var c: usize = 0;
    for (c < d.children.len) {
        free_child(a, ?d.children.data[c]);
        c = c + 1;
    }
    vector.dnit[Child](?d.children);

    var r: usize = 0;
    for (r < d.related.len) {
        free_related(a, ?d.related.data[r]);
        r = r + 1;
    }
    vector.dnit[Related](?d.related);

    var f: usize = 0;
    for (f < d.fixes.len) {
        free_fix(a, ?d.fixes.data[f]);
        f = f + 1;
    }
    vector.dnit[Fix](?d.fixes);
}

pub fun mark(store: *DiagnosticStore) DiagMark {
    var m: DiagMark;
    m.len   = store.items.len;
    m.epoch = store.epoch;
    ret m;
}

pub fun truncate(store: *DiagnosticStore, m: DiagMark) err[fail.Fail] {
    if (store == nil) { ret err[fail.Fail].err{fail.message("diagnostic store is nil")}; }
    if (m.epoch != store.epoch) { ret err[fail.Fail].err{fail.message("diagnostic mark predates an unrelated truncate")}; }
    if (m.len > store.items.len) { ret err[fail.Fail].err{fail.message("diagnostic mark exceeds current store length")}; }
    if (m.len == store.items.len) { ret err[fail.Fail].ok{}; }

    var i: usize = m.len;
    for (i < store.items.len) {
        val d: *Diagnostic = ?store.items.data[i];
        if (d.severity == SEVERITY_ERROR) { store.error_count = store.error_count - 1; }
        if (d.gate_key.msg != intern.STR_NIL) {
            map.remove[GateDiagKey, bool](?store.gates, ?d.gate_key);
        }
        free_diagnostic(store.a, d);
        i = i + 1;
    }
    store.items.len = m.len;
    store.epoch      = store.epoch + 1;
    ret err[fail.Fail].ok{};
}

pub fun store_dnit(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    var zero: DiagMark;
    zero.len   = 0;
    zero.epoch = store.epoch;
    truncate(store, zero);
    vector.dnit[Diagnostic](?store.items);
    map.dnit[GateDiagKey, bool](?store.gates);
    store.error_count = 0;
    store.lost        = 0;
}

pub fun len(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.items.len;
}

pub fun get(store: *DiagnosticStore, index: usize) opt[*Diagnostic] {
    if (store == nil) { ret opt[*Diagnostic].none{}; }
    if (index >= store.items.len) { ret opt[*Diagnostic].none{}; }
    ret opt[*Diagnostic].some{?store.items.data[index]};
}

pub fun has_errors(store: *DiagnosticStore) bool {
    ret store != nil && store.error_count > 0;
}

pub fun error_count(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.error_count;
}

pub fun note_error(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    store.error_count = store.error_count + 1;
}

pub fun builder_init(a: *A.Allocator, severity: Severity, file_id: source.FileId, span: token.Span, message: str) res[DiagnosticBuilder, fail.Fail] {
    if (!severity_valid(severity)) { ret res[DiagnosticBuilder, fail.Fail].err{fail.message("invalid diagnostic severity")}; }

    val dup_r: res[str, A.Error] = str_dup(a, message);
    if (sel dup_r.err) { ret res[DiagnosticBuilder, fail.Fail].err{fail.refused(dup_r.err)}; }

    var b: DiagnosticBuilder;
    b.a        = a;
    b.live     = true;
    b.severity = severity;
    b.loc.file_id = file_id;
    b.loc.span    = span;
    b.message  = dup_r.ok;
    b.children = vector.init[Child](a);
    b.related  = vector.init[Related](a);
    b.fixes    = vector.init[Fix](a);
    ret res[DiagnosticBuilder, fail.Fail].ok{b};
}

pub fun builder_dnit(b: *DiagnosticBuilder) {
    if (b == nil || !b.live) { ret; }

    if (b.message != nil) { str_free(b.a, b.message); }

    var c: usize = 0;
    for (c < b.children.len) {
        free_child(b.a, ?b.children.data[c]);
        c = c + 1;
    }
    vector.dnit[Child](?b.children);

    var r: usize = 0;
    for (r < b.related.len) {
        free_related(b.a, ?b.related.data[r]);
        r = r + 1;
    }
    vector.dnit[Related](?b.related);

    var f: usize = 0;
    for (f < b.fixes.len) {
        free_fix(b.a, ?b.fixes.data[f]);
        f = f + 1;
    }
    vector.dnit[Fix](?b.fixes);

    b.message = nil;
    b.live    = false;
}

fun push_child(a: *A.Allocator, children: *Vector[Child], kind: ChildKind, text: str) err[fail.Fail] {
    val dup_r: res[str, A.Error] = str_dup(a, text);
    if (sel dup_r.err) { ret err[fail.Fail].err{fail.refused(dup_r.err)}; }

    var c: Child;
    c.kind = kind;
    c.text = dup_r.ok;

    val push_r: res[usize, A.Error] = vector.push[Child](children, c);
    if (sel push_r.err) {
        str_free(a, c.text);
        ret err[fail.Fail].err{fail.refused(push_r.err)};
    }
    ret err[fail.Fail].ok{};
}

pub fun attach_note(b: *DiagnosticBuilder, text: str) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    val push_child_r: err[fail.Fail] = push_child(b.a, ?b.children, CHILD_NOTE, text);
    if (sel push_child_r.err) { ret err[fail.Fail].err{push_child_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun attach_help(b: *DiagnosticBuilder, text: str) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    val push_child_r: err[fail.Fail] = push_child(b.a, ?b.children, CHILD_HELP, text);
    if (sel push_child_r.err) { ret err[fail.Fail].err{push_child_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun attach_note_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) err[fail.Fail] {
    val r: opt[*Diagnostic] = resolve(store, id);
    if (sel r.none) { ret err[fail.Fail].err{fail.message(STALE_ID_TEXT)}; }
    val d: *Diagnostic = r.some;
    val push_child_r: err[fail.Fail] = push_child(store.a, ?d.children, CHILD_NOTE, text);
    if (sel push_child_r.err) { ret err[fail.Fail].err{push_child_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun attach_help_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) err[fail.Fail] {
    val r: opt[*Diagnostic] = resolve(store, id);
    if (sel r.none) { ret err[fail.Fail].err{fail.message(STALE_ID_TEXT)}; }
    val d: *Diagnostic = r.some;
    val push_child_r: err[fail.Fail] = push_child(store.a, ?d.children, CHILD_HELP, text);
    if (sel push_child_r.err) { ret err[fail.Fail].err{push_child_r.err}; }
    ret err[fail.Fail].ok{};
}

fun push_related(a: *A.Allocator, related: *Vector[Related], file_id: source.FileId, span: token.Span, label: str) err[fail.Fail] {
    var r: Related;
    r.loc.file_id = file_id;
    r.loc.span    = span;
    r.label       = nil;

    if (label != nil && str_len(label) > 0) {
        val dup_r: res[str, A.Error] = str_dup(a, label);
        if (sel dup_r.err) { ret err[fail.Fail].err{fail.refused(dup_r.err)}; }
        r.label = dup_r.ok;
    }

    val push_r: res[usize, A.Error] = vector.push[Related](related, r);
    if (sel push_r.err) {
        if (r.label != nil) { str_free(a, r.label); }
        ret err[fail.Fail].err{fail.refused(push_r.err)};
    }
    ret err[fail.Fail].ok{};
}

pub fun attach_related(b: *DiagnosticBuilder, file_id: source.FileId, span: token.Span, label: str) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    val push_related_r: err[fail.Fail] = push_related(b.a, ?b.related, file_id, span, label);
    if (sel push_related_r.err) { ret err[fail.Fail].err{push_related_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun attach_related_committed(store: *DiagnosticStore, id: DiagnosticId, file_id: source.FileId, span: token.Span, label: str) err[fail.Fail] {
    val r: opt[*Diagnostic] = resolve(store, id);
    if (sel r.none) { ret err[fail.Fail].err{fail.message(STALE_ID_TEXT)}; }
    val d: *Diagnostic = r.some;
    val push_related_r: err[fail.Fail] = push_related(store.a, ?d.related, file_id, span, label);
    if (sel push_related_r.err) { ret err[fail.Fail].err{push_related_r.err}; }
    ret err[fail.Fail].ok{};
}

fun edits_overlap(a: *Edit, b: *Edit) bool {
    if (a.loc.file_id != b.loc.file_id) { ret false; }
    val a_start: usize = a.loc.span.offset;
    val a_end:   usize = a.loc.span.offset + a.loc.span.len;
    val b_start: usize = b.loc.span.offset;
    val b_end:   usize = b.loc.span.offset + b.loc.span.len;
    ret a_start < b_end && b_start < a_end;
}

fun fix_edit_overlaps_existing(fx: *Fix, candidate: *Edit) bool {
    var i: usize = 0;
    for (i < fx.edits.len) {
        if (edits_overlap(?fx.edits.data[i], candidate)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun push_fix(a: *A.Allocator, fixes: *Vector[Fix], label: str, file_id: source.FileId, span: token.Span, replacement: str) res[FixId, fail.Fail] {
    if (label == nil || str_len(label) == 0) { ret res[FixId, fail.Fail].err{fail.message("fix label is required")}; }

    val label_r: res[str, A.Error] = str_dup(a, label);
    if (sel label_r.err) { ret res[FixId, fail.Fail].err{fail.refused(label_r.err)}; }
    val label_owned: str = label_r.ok;

    var text: str = replacement;
    if (text == nil) { text = ""; }
    val rep_r: res[str, A.Error] = str_dup(a, text);
    if (sel rep_r.err) {
        str_free(a, label_owned);
        ret res[FixId, fail.Fail].err{fail.refused(rep_r.err)};
    }

    var e: Edit;
    e.loc.file_id  = file_id;
    e.loc.span     = span;
    e.replacement  = rep_r.ok;

    var fx: Fix;
    fx.label = label_owned;
    fx.edits = vector.init[Edit](a);

    val edit_push_r: res[usize, A.Error] = vector.push[Edit](?fx.edits, e);
    if (sel edit_push_r.err) {
        str_free(a, e.replacement);
        str_free(a, label_owned);
        vector.dnit[Edit](?fx.edits);
        ret res[FixId, fail.Fail].err{fail.refused(edit_push_r.err)};
    }

    val fix_push_r: res[usize, A.Error] = vector.push[Fix](fixes, fx);
    if (sel fix_push_r.err) {
        free_fix(a, ?fx);
        ret res[FixId, fail.Fail].err{fail.refused(fix_push_r.err)};
    }

    ret res[FixId, fail.Fail].ok{(fixes.len - 1)::FixId};
}

fun push_fix_edit(a: *A.Allocator, fixes: *Vector[Fix], fix: FixId, file_id: source.FileId, span: token.Span, replacement: str) err[fail.Fail] {
    if (fix::usize >= fixes.len) { ret err[fail.Fail].err{fail.message("fix id out of bounds")}; }
    val fx: *Fix = ?fixes.data[fix::usize];

    var e: Edit;
    e.loc.file_id = file_id;
    e.loc.span    = span;
    e.replacement = nil;

    if (fix_edit_overlaps_existing(fx, ?e)) { ret err[fail.Fail].err{fail.message("fix edit overlaps an existing edit")}; }

    var text: str = replacement;
    if (text == nil) { text = ""; }
    val rep_r: res[str, A.Error] = str_dup(a, text);
    if (sel rep_r.err) { ret err[fail.Fail].err{fail.refused(rep_r.err)}; }
    e.replacement = rep_r.ok;

    val push_r: res[usize, A.Error] = vector.push[Edit](?fx.edits, e);
    if (sel push_r.err) {
        str_free(a, e.replacement);
        ret err[fail.Fail].err{fail.refused(push_r.err)};
    }
    ret err[fail.Fail].ok{};
}

pub fun attach_fix(b: *DiagnosticBuilder, label: str, file_id: source.FileId, span: token.Span, replacement: str) res[FixId, fail.Fail] {
    if (b == nil || !b.live) { ret res[FixId, fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    val push_fix_r: res[FixId, fail.Fail] = push_fix(b.a, ?b.fixes, label, file_id, span, replacement);
    if (sel push_fix_r.err) { ret res[FixId, fail.Fail].err{push_fix_r.err}; }
    ret res[FixId, fail.Fail].ok{push_fix_r.ok};
}

pub fun attach_fix_edit(b: *DiagnosticBuilder, fix: FixId, file_id: source.FileId, span: token.Span, replacement: str) err[fail.Fail] {
    if (b == nil || !b.live) { ret err[fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    val push_fix_edit_r: err[fail.Fail] = push_fix_edit(b.a, ?b.fixes, fix, file_id, span, replacement);
    if (sel push_fix_edit_r.err) { ret err[fail.Fail].err{push_fix_edit_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun last_id(store: *DiagnosticStore) opt[DiagnosticId] {
    if (store == nil || store.items.len == 0) { ret opt[DiagnosticId].none{}; }
    val d: *Diagnostic = ?store.items.data[store.items.len - 1];
    var id: DiagnosticId;
    id.index = store.items.len - 1;
    id.seq   = d.seq;
    ret opt[DiagnosticId].some{id};
}

pub fun attach_fix_committed(store: *DiagnosticStore, id: DiagnosticId, label: str, file_id: source.FileId, span: token.Span, replacement: str) res[FixId, fail.Fail] {
    val r: opt[*Diagnostic] = resolve(store, id);
    if (sel r.none) { ret res[FixId, fail.Fail].err{fail.message(STALE_ID_TEXT)}; }
    val d: *Diagnostic = r.some;
    val push_fix_r: res[FixId, fail.Fail] = push_fix(store.a, ?d.fixes, label, file_id, span, replacement);
    if (sel push_fix_r.err) { ret res[FixId, fail.Fail].err{push_fix_r.err}; }
    ret res[FixId, fail.Fail].ok{push_fix_r.ok};
}

pub fun attach_fix_edit_committed(store: *DiagnosticStore, id: DiagnosticId, fix: FixId, file_id: source.FileId, span: token.Span, replacement: str) err[fail.Fail] {
    val r: opt[*Diagnostic] = resolve(store, id);
    if (sel r.none) { ret err[fail.Fail].err{fail.message(STALE_ID_TEXT)}; }
    val d: *Diagnostic = r.some;
    val push_fix_edit_r: err[fail.Fail] = push_fix_edit(store.a, ?d.fixes, fix, file_id, span, replacement);
    if (sel push_fix_edit_r.err) { ret err[fail.Fail].err{push_fix_edit_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun remove_fix_committed(store: *DiagnosticStore, id: DiagnosticId, fix: FixId) err[fail.Fail] {
    val r: opt[*Diagnostic] = resolve(store, id);
    if (sel r.none) { ret err[fail.Fail].err{fail.message(STALE_ID_TEXT)}; }
    val d: *Diagnostic = r.some;
    if (d.fixes.len == 0 || fix::usize != d.fixes.len - 1) {
        ret err[fail.Fail].err{fail.message("remove_fix_committed: fix is not the most recently attached fix on this diagnostic")};
    }
    val pop_r: opt[Fix] = vector.pop[Fix](?d.fixes);
    if (sel pop_r.none) { ret err[fail.Fail].err{fail.message("remove_fix_committed: the fix vector is empty")}; }
    var fx: Fix = pop_r.some;
    free_fix(store.a, ?fx);
    ret err[fail.Fail].ok{};
}

pub fun fix_valid(fx: *Fix) bool {
    if (fx == nil || fx.label == nil || fx.edits.len == 0) { ret false; }
    var i: usize = 0;
    for (i < fx.edits.len) {
        var j: usize = i + 1;
        for (j < fx.edits.len) {
            if (edits_overlap(?fx.edits.data[i], ?fx.edits.data[j])) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

pub fun commit(b: *DiagnosticBuilder, store: *DiagnosticStore) res[DiagnosticId, fail.Fail] {
    if (b == nil || !b.live) { ret res[DiagnosticId, fail.Fail].err{fail.message("diagnostic builder is not live")}; }
    if (store == nil) { ret res[DiagnosticId, fail.Fail].err{fail.message("diagnostic store is nil")}; }
    if (b.a != store.a) { ret res[DiagnosticId, fail.Fail].err{fail.message("diagnostic builder allocator does not match store allocator")}; }

    if (b.severity == SEVERITY_ERROR) { note_error(store); }

    var d: Diagnostic;
    d.seq      = store.next_seq;
    d.gate_key = GateDiagKey{ msg: intern.STR_NIL };
    d.severity = b.severity;
    d.loc      = b.loc;
    d.message  = b.message;
    d.children = b.children;
    d.related  = b.related;
    d.fixes    = b.fixes;

    val push_r: res[usize, A.Error] = vector.push[Diagnostic](?store.items, d);
    if (sel push_r.err) { ret res[DiagnosticId, fail.Fail].err{fail.refused(push_r.err)}; }

    var id: DiagnosticId;
    id.index = store.items.len - 1;
    id.seq   = d.seq;

    store.next_seq = store.next_seq + 1;

    b.message = nil;
    var empty_children: Vector[Child] = vector.init[Child](b.a);
    var empty_related:  Vector[Related] = vector.init[Related](b.a);
    var empty_fixes:    Vector[Fix] = vector.init[Fix](b.a);
    b.children = empty_children;
    b.related  = empty_related;
    b.fixes    = empty_fixes;
    b.live     = false;

    ret res[DiagnosticId, fail.Fail].ok{id};
}

# absent when the store is nil or the id no longer names a live diagnostic
pub fun resolve(store: *DiagnosticStore, id: DiagnosticId) opt[*Diagnostic] {
    if (store == nil) { ret opt[*Diagnostic].none{}; }
    if (id.index >= store.items.len) { ret opt[*Diagnostic].none{}; }
    val d: *Diagnostic = ?store.items.data[id.index];
    if (d.seq != id.seq) { ret opt[*Diagnostic].none{}; }
    ret opt[*Diagnostic].some{d};
}

pub val STALE_ID_TEXT: str = "stale diagnostic id";

fun emit(store: *DiagnosticStore, severity: Severity, file_id: source.FileId, span: token.Span, message: str) err[fail.Fail] {
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(store.a, severity, file_id, span, message);
    if (sel b_r.err) {
        if (severity == SEVERITY_ERROR) { note_error(store); }
        ret err[fail.Fail].err{b_r.err};
    }
    var b: DiagnosticBuilder = b_r.ok;

    val commit_r: res[DiagnosticId, fail.Fail] = commit(?b, store);
    if (sel commit_r.err) {
        builder_dnit(?b);
        ret err[fail.Fail].err{commit_r.err};
    }
    ret err[fail.Fail].ok{};
}

pub fun error(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) err[fail.Fail] {
    val emit_r: err[fail.Fail] = emit(store, SEVERITY_ERROR, file_id, span, message);
    if (sel emit_r.err) { ret err[fail.Fail].err{emit_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun warning(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) err[fail.Fail] {
    val emit_r: err[fail.Fail] = emit(store, SEVERITY_WARNING, file_id, span, message);
    if (sel emit_r.err) { ret err[fail.Fail].err{emit_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun info(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) err[fail.Fail] {
    val emit_r: err[fail.Fail] = emit(store, SEVERITY_INFO, file_id, span, message);
    if (sel emit_r.err) { ret err[fail.Fail].err{emit_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun help(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) err[fail.Fail] {
    val emit_r: err[fail.Fail] = emit(store, SEVERITY_HELP, file_id, span, message);
    if (sel emit_r.err) { ret err[fail.Fail].err{emit_r.err}; }
    ret err[fail.Fail].ok{};
}

pub fun record_error(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) {
    record(store, emit(store, SEVERITY_ERROR, file_id, span, message));
}

pub fun record_warning(store: *DiagnosticStore, file_id: source.FileId, span: token.Span, message: str) {
    record(store, emit(store, SEVERITY_WARNING, file_id, span, message));
}

pub fun record_note_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) {
    record(store, attach_note_committed(store, id, text));
}

pub fun record_help_committed(store: *DiagnosticStore, id: DiagnosticId, text: str) {
    record(store, attach_help_committed(store, id, text));
}

pub fun record_related_committed(store: *DiagnosticStore, id: DiagnosticId, file_id: source.FileId, span: token.Span, label: str) {
    record(store, attach_related_committed(store, id, file_id, span, label));
}

pub fun record_fix_committed(store: *DiagnosticStore, id: DiagnosticId, label: str, file_id: source.FileId, span: token.Span, replacement: str) {
    val r: res[FixId, fail.Fail] = attach_fix_committed(store, id, label, file_id, span, replacement);
    if (sel r.err) { note_lost(store); }
}

pub fun record_gate_error(store: *DiagnosticStore, itn: *intern.Interner,
                          file_id: source.FileId, span: token.Span, message: str) {
    val gated: res[bool, fail.Fail] = gate_error(store, itn, file_id, span, message);
    if (sel gated.err) { note_lost(store); }
}

pub fun record_gate_commit(store: *DiagnosticStore, itn: *intern.Interner,
                           b: *DiagnosticBuilder) {
    val committed: res[bool, fail.Fail] = gate_commit(store, itn, b);
    if (sel committed.err) { note_lost(store); }
}

fun record(store: *DiagnosticStore, r: err[fail.Fail]) {
    if (sel r.err) { note_lost(store); }
}

pub fun note_lost(store: *DiagnosticStore) {
    if (store == nil) { ret; }
    store.lost = store.lost + 1;
    note_error(store);
}

pub fun lost_count(store: *DiagnosticStore) usize {
    if (store == nil) { ret 0; }
    ret store.lost;
}

pub val GATE_NEVER_DECIDED_PREFIX: str =
    "this `$if` gate is never decided: `";

pub val GATE_NEVER_DECIDED_SUFFIX: str =
    "` is not a compile-time constant anywhere this module can see";

pub fun gate_error_named(
    store:   *DiagnosticStore,
    itn:     *intern.Interner,
    file_id: source.FileId,
    span:    token.Span,
    name_id: intern.StrId,
    fallback: str
) res[bool, fail.Fail] {
    val no: opt[str] = intern.lookup(itn, name_id);
    if (sel no.none) {
        val gate_error_r: res[bool, fail.Fail] = gate_error(store, itn, file_id, span, fallback);
        if (sel gate_error_r.err) { ret res[bool, fail.Fail].err{gate_error_r.err}; }
        ret res[bool, fail.Fail].ok{gate_error_r.ok};
    }
    val joined: res[str, string.StrError] = str_join(store.a, GATE_NEVER_DECIDED_PREFIX, no.some, GATE_NEVER_DECIDED_SUFFIX);
    if (sel joined.err) {
        val gate_error_r2: res[bool, fail.Fail] = gate_error(store, itn, file_id, span, fallback);
        if (sel gate_error_r2.err) { ret res[bool, fail.Fail].err{gate_error_r2.err}; }
        ret res[bool, fail.Fail].ok{gate_error_r2.ok};
    }
    val msg: str = joined.ok;
    val committed_r: res[bool, fail.Fail] = gate_error(store, itn, file_id, span, msg);
    str_free(store.a, msg);
    if (sel committed_r.err) { ret res[bool, fail.Fail].err{committed_r.err}; }
    ret res[bool, fail.Fail].ok{committed_r.ok};
}

pub fun suggestion_build(a: *A.Allocator, name: str) res[str, fail.Fail] {
    val str_join_r: res[str, string.StrError] = str_join(a, "did you mean `", name, "`?");
    if (sel str_join_r.err) { ret res[str, fail.Fail].err{fail.str_refused(str_join_r.err)}; }
    ret res[str, fail.Fail].ok{str_join_r.ok};
}

pub fun fix_label_replace(a: *A.Allocator, name: str) res[str, fail.Fail] {
    val str_join_r: res[str, string.StrError] = str_join(a, "replace with `", name, "`");
    if (sel str_join_r.err) { ret res[str, fail.Fail].err{fail.str_refused(str_join_r.err)}; }
    ret res[str, fail.Fail].ok{str_join_r.ok};
}

fun copy_diagnostic_into(dst: *DiagnosticStore, d: *Diagnostic) err[fail.Fail] {
    if (d.gate_key.msg != intern.STR_NIL && map.contains[GateDiagKey, bool](?dst.gates, ?d.gate_key)) {
        ret err[fail.Fail].ok{};
    }
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(dst.a, d.severity, d.loc.file_id, d.loc.span, d.message);
    if (sel b_r.err) { ret err[fail.Fail].err{b_r.err}; }
    var b: DiagnosticBuilder = b_r.ok;

    var c: usize = 0;
    for (c < d.children.len) {
        val child: *Child = ?d.children.data[c];
        val r: err[fail.Fail] = push_child(b.a, ?b.children, child.kind, child.text);
        if (sel r.err) { builder_dnit(?b); ret r; }
        c = c + 1;
    }

    var r_i: usize = 0;
    for (r_i < d.related.len) {
        val rel: *Related = ?d.related.data[r_i];
        val r: err[fail.Fail] = attach_related(?b, rel.loc.file_id, rel.loc.span, rel.label);
        if (sel r.err) { builder_dnit(?b); ret r; }
        r_i = r_i + 1;
    }

    var f: usize = 0;
    for (f < d.fixes.len) {
        val fx: *Fix = ?d.fixes.data[f];
        if (fx.edits.len == 0) { f = f + 1; cnt; }
        val first: *Edit = ?fx.edits.data[0];
        val fix_r: res[FixId, fail.Fail] = attach_fix(?b, fx.label, first.loc.file_id, first.loc.span, first.replacement);
        if (sel fix_r.err) { builder_dnit(?b); ret err[fail.Fail].err{fix_r.err}; }
        val fid: FixId = fix_r.ok;

        var e: usize = 1;
        for (e < fx.edits.len) {
            val ed: *Edit = ?fx.edits.data[e];
            val er: err[fail.Fail] = attach_fix_edit(?b, fid, ed.loc.file_id, ed.loc.span, ed.replacement);
            if (sel er.err) { builder_dnit(?b); ret er; }
            e = e + 1;
        }
        f = f + 1;
    }

    val commit_r: res[DiagnosticId, fail.Fail] = commit(?b, dst);
    if (sel commit_r.err) {
        builder_dnit(?b);
        ret err[fail.Fail].err{commit_r.err};
    }
    if (d.gate_key.msg != intern.STR_NIL) {
        val inserted: res[bool, A.Error] = map.insert[GateDiagKey, bool](?dst.gates, d.gate_key, true);
        if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
        dst.items.data[commit_r.ok.index].gate_key = d.gate_key;
    }
    ret err[fail.Fail].ok{};
}

fun location_equal(left: Location, right: Location) bool {
    ret left.file_id == right.file_id && left.span.offset == right.span.offset && left.span.len == right.span.len;
}

fun diagnostic_equal(left: *Diagnostic, right: *Diagnostic) bool {
    if (left.severity != right.severity || !location_equal(left.loc, right.loc)
        || !str_equals(left.message, right.message) || left.children.len != right.children.len
        || left.related.len != right.related.len || left.fixes.len != right.fixes.len) { ret false; }
    var i: usize = 0;
    for (i < left.children.len) {
        val l: *Child = ?left.children.data[i];
        val r: *Child = ?right.children.data[i];
        if (l.kind != r.kind || !str_equals(l.text, r.text)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < left.related.len) {
        val l: *Related = ?left.related.data[i];
        val r: *Related = ?right.related.data[i];
        if (!location_equal(l.loc, r.loc) || !str_equals(l.label, r.label)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < left.fixes.len) {
        val l: *Fix = ?left.fixes.data[i];
        val r: *Fix = ?right.fixes.data[i];
        if (!str_equals(l.label, r.label) || l.edits.len != r.edits.len) { ret false; }
        var j: usize = 0;
        for (j < l.edits.len) {
            val le: *Edit = ?l.edits.data[j];
            val re: *Edit = ?r.edits.data[j];
            if (!location_equal(le.loc, re.loc) || !str_equals(le.replacement, re.replacement)) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret true;
}

# compare observable diagnostic content without allocation or store identity
pub fun content_equal(left: *DiagnosticStore, right: *DiagnosticStore) res[bool, fail.Fail] {
    if ((left != nil && left.lost != 0) || (right != nil && right.lost != 0)) {
        ret res[bool, fail.Fail].err{fail.message("cannot compare diagnostics after an allocation failure")};
    }
    var ln: usize = 0;
    var rn: usize = 0;
    if (left != nil) { ln = left.items.len; }
    if (right != nil) { rn = right.items.len; }
    if (ln != rn) { ret res[bool, fail.Fail].ok{false}; }
    var i: usize = 0;
    for (i < ln) {
        if (!diagnostic_equal(?left.items.data[i], ?right.items.data[i])) { ret res[bool, fail.Fail].ok{false}; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

pub fun snapshot_from(src: *DiagnosticStore, from: usize, a: *A.Allocator) res[*DiagnosticStore, fail.Fail] {
    val alloc_r: res[*DiagnosticStore, A.Error] = A.allocate[DiagnosticStore](a, 1);
    if (sel alloc_r.err) { ret res[*DiagnosticStore, fail.Fail].err{fail.refused(alloc_r.err)}; }
    val snap: *DiagnosticStore = alloc_r.ok;
    @snap = store_init(a);

    snap.lost = src.lost;
    snap.error_count = src.lost;
    if (from >= src.items.len) { ret res[*DiagnosticStore, fail.Fail].ok{snap}; }

    var i: usize = from;
    for (i < src.items.len) {
        val r: err[fail.Fail] = copy_diagnostic_into(snap, ?src.items.data[i]);
        if (sel r.err) {
            store_dnit(snap);
            A.deallocate[DiagnosticStore](a, snap, 1);
            ret res[*DiagnosticStore, fail.Fail].err{r.err};
        }
        i = i + 1;
    }
    ret res[*DiagnosticStore, fail.Fail].ok{snap};
}

pub fun replay_into(dst: *DiagnosticStore, src: *DiagnosticStore) err[fail.Fail] {
    if (dst == nil || src == nil) { ret err[fail.Fail].err{fail.message("diagnostic store is nil")}; }
    if (dst == src) { ret err[fail.Fail].err{fail.message("cannot replay a diagnostic store into itself")}; }

    val original_len: usize = dst.items.len;
    var i: usize = 0;
    for (i < src.items.len) {
        val r: err[fail.Fail] = copy_diagnostic_into(dst, ?src.items.data[i]);
        if (sel r.err) {
            var m: DiagMark;
            m.len   = original_len;
            m.epoch = dst.epoch;
            val rollback_r: err[fail.Fail] = truncate(dst, m);
            if (sel rollback_r.err) {
                ret err[fail.Fail].err{fail.message("replay_into: copy failed and rollback truncate also failed, diagnostic store may be poisoned")};
            }
            if (sel r.err) { ret err[fail.Fail].err{r.err}; }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    dst.lost = dst.lost + src.lost;
    dst.error_count = dst.error_count + src.lost;
    ret err[fail.Fail].ok{};
}

pub rec GateDiagKey {
    file_id:    source.FileId;
    span_start: usize;
    span_end:   usize;
    severity:   Severity;
    msg:        intern.StrId;
}

fun gate_diag_key_hash(p: ptr) u64 {
    val k: *GateDiagKey = p::*GateDiagKey;
    var x: u64 = k.file_id::u64;
    x = x ^ ((k.span_start::u64) * 0x9e3779b97f4a7c15 + 1);
    x = x ^ ((k.span_end::u64)   * 0x9e3779b97f4a7c15 + 2);
    x = x ^ ((k.severity::u64)   * 0x9e3779b97f4a7c15 + 3);
    x = x ^ ((k.msg::u64)        * 0x9e3779b97f4a7c15 + 4);
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    ret x;
}

fun gate_diag_key_eq(pa: ptr, pb: ptr) bool {
    val a: *GateDiagKey = pa::*GateDiagKey;
    val b: *GateDiagKey = pb::*GateDiagKey;
    ret a.file_id == b.file_id
     && a.span_start == b.span_start
     && a.span_end == b.span_end
     && a.severity == b.severity
     && a.msg == b.msg;
}

pub fun gate_commit(
    store: *DiagnosticStore,
    itn:   *intern.Interner,
    b:     *DiagnosticBuilder
) res[bool, fail.Fail] {
    if (b == nil || !b.live) { ret res[bool, fail.Fail].err{fail.message("diagnostic builder is not live")}; }

    val mid_r: res[intern.StrId, A.Error] = intern.intern(itn, b.message);
    if (sel mid_r.err) {
        if (b.severity == SEVERITY_ERROR) { note_error(store); }
        builder_dnit(b);
        ret res[bool, fail.Fail].err{fail.refused(mid_r.err)};
    }
    val mid: intern.StrId = mid_r.ok;

    var key: GateDiagKey;
    key.file_id    = b.loc.file_id;
    key.span_start = b.loc.span.offset;
    key.span_end   = b.loc.span.offset + b.loc.span.len;
    key.severity   = b.severity;
    key.msg        = mid;

    if (map.contains[GateDiagKey, bool](?store.gates, ?key)) {
        builder_dnit(b);
        ret res[bool, fail.Fail].ok{false};
    }

    val cr: res[DiagnosticId, fail.Fail] = commit(b, store);
    if (sel cr.err) {
        # a refused commit leaves the builder live and still owning its message,
        # children, related and fixes; every other exit here hands them back
        builder_dnit(b);
        ret res[bool, fail.Fail].err{cr.err};
    }

    val committed: DiagnosticId = cr.ok;
    val insert_r: res[bool, A.Error] = map.insert[GateDiagKey, bool](?store.gates, key, true);
    if (sel insert_r.err) { ret res[bool, fail.Fail].err{fail.refused(insert_r.err)}; }
    store.items.data[committed.index].gate_key = key;

    ret res[bool, fail.Fail].ok{true};
}

pub fun gate_error(
    store:   *DiagnosticStore,
    itn:     *intern.Interner,
    file_id: source.FileId,
    span:    token.Span,
    message: str
) res[bool, fail.Fail] {
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(store.a, SEVERITY_ERROR, file_id, span, message);
    if (sel b_r.err) {
        note_error(store);
        ret res[bool, fail.Fail].err{b_r.err};
    }
    var b: DiagnosticBuilder = b_r.ok;
    val gate_commit_r: res[bool, fail.Fail] = gate_commit(store, itn, ?b);
    if (sel gate_commit_r.err) { ret res[bool, fail.Fail].err{gate_commit_r.err}; }
    ret res[bool, fail.Fail].ok{gate_commit_r.ok};
}

fun test_span(offset: usize, len: usize) token.Span {
    var sp: token.Span;
    sp.offset = offset;
    sp.len    = len;
    ret sp;
}

test "mach.lang.diagnostic.len:nil_store_matches_other_accessors" {
    if (len(nil::*DiagnosticStore) != 0)       { ret 1; }
    if (has_errors(nil::*DiagnosticStore))     { ret 2; }
    if (error_count(nil::*DiagnosticStore) != 0) { ret 3; }
    ret 0;
}

test "mach.lang.diagnostic.emit:records_and_flags_errors" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);

    val sp: token.Span = test_span(0, 1);

    val res_warn: err[fail.Fail] = warning(?store, 0::source.FileId, sp, "a warning");
    if (sel res_warn.err) { store_dnit(?store); ret 1; }
    if (has_errors(?store))            { store_dnit(?store); ret 1; }

    val res_err: err[fail.Fail] = error(?store, 0::source.FileId, sp, "an error");
    if (sel res_err.err) { store_dnit(?store); ret 1; }
    if (!has_errors(?store))          { store_dnit(?store); ret 1; }
    if (error_count(?store) != 1)     { store_dnit(?store); ret 1; }

    if (len(?store) != 2)                                        { store_dnit(?store); ret 1; }
    val first: opt[*Diagnostic] = get(?store, 0);
    if (sel first.none) { store_dnit(?store); ret 1; }
    if (first.some.severity != SEVERITY_WARNING) { store_dnit(?store); ret 1; }
    val second: opt[*Diagnostic] = get(?store, 1);
    if (sel second.none) { store_dnit(?store); ret 1; }
    if (second.some.severity != SEVERITY_ERROR)   { store_dnit(?store); ret 1; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.builder:preserves_every_note_and_help_in_order" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(0, 1);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, SEVERITY_ERROR, 0::source.FileId, sp, "an error");
    if (sel b_r.err) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = b_r.ok;

    val attach_note_r: err[fail.Fail] = attach_note(?b, "first note");
    if (sel attach_note_r.err)  { builder_dnit(?b); store_dnit(?store); ret 1; }
    val attach_note_r2: err[fail.Fail] = attach_note(?b, "second note");
    if (sel attach_note_r2.err) { builder_dnit(?b); store_dnit(?store); ret 1; }
    val attach_help_r: err[fail.Fail] = attach_help(?b, "first help");
    if (sel attach_help_r.err)  { builder_dnit(?b); store_dnit(?store); ret 1; }

    val commit_r: res[DiagnosticId, fail.Fail] = commit(?b, ?store);
    if (sel commit_r.err) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val get_r: opt[*Diagnostic] = get(?store, 0);
    if (sel get_r.none) { store_dnit(?store); ret 99; }
    val d: *Diagnostic = get_r.some;
    var bad: i32 = 0;
    if (d.children.len != 3)                                     { bad = 1; }
    or (d.children.data[0].kind != CHILD_NOTE)                   { bad = 1; }
    or (!str_equals(d.children.data[0].text, "first note"))      { bad = 1; }
    or (d.children.data[1].kind != CHILD_NOTE)                   { bad = 1; }
    or (!str_equals(d.children.data[1].text, "second note"))     { bad = 1; }
    or (d.children.data[2].kind != CHILD_HELP)                   { bad = 1; }
    or (!str_equals(d.children.data[2].text, "first help"))      { bad = 1; }

    store_dnit(?store);
    ret bad;
}

test "mach.lang.diagnostic.attach_related:distinguishes_label_from_no_label" {
    var a: A.Allocator;
    page.make(?a);
    val sp: token.Span = test_span(10, 3);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, SEVERITY_ERROR, 0::source.FileId, sp, "an error");
    if (sel b_r.err) { ret 1; }
    var b: DiagnosticBuilder = b_r.ok;

    val rel: token.Span = test_span(42, 5);
    val attach_related_r: err[fail.Fail] = attach_related(?b, 7::source.FileId, rel, "previous definition here");
    if (sel attach_related_r.err) { builder_dnit(?b); ret 1; }
    val attach_related_r2: err[fail.Fail] = attach_related(?b, 9::source.FileId, sp, nil);
    if (sel attach_related_r2.err)                          { builder_dnit(?b); ret 1; }
    val attach_related_r3: err[fail.Fail] = attach_related(?b, 9::source.FileId, sp, "");
    if (sel attach_related_r3.err)                           { builder_dnit(?b); ret 1; }

    var bad: i32 = 0;
    if (b.related.len != 3)                                              { bad = 1; }
    or (b.related.data[0].label == nil)                                  { bad = 1; }
    or (!str_equals(b.related.data[0].label, "previous definition here")) { bad = 1; }
    or (b.related.data[1].label != nil)                                  { bad = 1; }
    or (b.related.data[2].label != nil)                                  { bad = 1; }

    builder_dnit(?b);
    ret bad;
}

test "mach.lang.diagnostic.attach_fix:accumulates_edits_and_validates" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(4, 5);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, SEVERITY_ERROR, 1::source.FileId, sp, "unresolved identifier `helpr`");
    if (sel b_r.err) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = b_r.ok;

    val attach_help_r: err[fail.Fail] = attach_help(?b, "did you mean `helper`?");
    if (sel attach_help_r.err) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val fix1_r: res[FixId, fail.Fail] = attach_fix(?b, "replace with `helper`", 1::source.FileId, sp, "helper");
    if (sel fix1_r.err) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val head: token.Span = test_span(4, 0);
    val tail: token.Span = test_span(9, 0);
    val fix2_r: res[FixId, fail.Fail] = attach_fix(?b, "cast the value to `i64`", 1::source.FileId, head, "(");
    if (sel fix2_r.err) { builder_dnit(?b); store_dnit(?store); ret 1; }
    val fix2: FixId = fix2_r.ok;
    val attach_fix_edit_r: err[fail.Fail] = attach_fix_edit(?b, fix2, 1::source.FileId, tail, ")::i64");
    if (sel attach_fix_edit_r.err) { builder_dnit(?b); store_dnit(?store); ret 1; }

    if (b.fixes.len != 2)                       { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (b.fixes.data[0].edits.len != 1)         { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (b.fixes.data[1].edits.len != 2)         { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (!fix_valid(?b.fixes.data[0]))           { builder_dnit(?b); store_dnit(?store); ret 1; }
    if (!fix_valid(?b.fixes.data[1]))           { builder_dnit(?b); store_dnit(?store); ret 1; }

    val commit_r: res[DiagnosticId, fail.Fail] = commit(?b, ?store);
    if (sel commit_r.err) { builder_dnit(?b); store_dnit(?store); ret 1; }

    val get_r: opt[*Diagnostic] = get(?store, 0);
    if (sel get_r.none) { store_dnit(?store); ret 99; }
    val d: *Diagnostic = get_r.some;
    var bad: i32 = 0;
    if (!str_equals(d.fixes.data[0].label, "replace with `helper`"))        { bad = 1; }
    or (!str_equals(d.fixes.data[0].edits.data[0].replacement, "helper"))   { bad = 1; }
    or (!str_equals(d.fixes.data[1].edits.data[1].replacement, ")::i64"))   { bad = 1; }

    store_dnit(?store);
    ret bad;
}

test "mach.lang.diagnostic.attach_fix_edit:rejects_overlap_and_missing_fix" {
    var a: A.Allocator;
    page.make(?a);
    val sp: token.Span = test_span(4, 5);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, SEVERITY_ERROR, 1::source.FileId, sp, "first");
    if (sel b_r.err) { ret 1; }
    var b: DiagnosticBuilder = b_r.ok;

    val fix_r: res[FixId, fail.Fail] = attach_fix(?b, "fix it", 1::source.FileId, sp, "x");
    if (sel fix_r.err) { builder_dnit(?b); ret 1; }
    val fix: FixId = fix_r.ok;

    val attach_fix_edit_r: err[fail.Fail] = attach_fix_edit(?b, fix, 1::source.FileId, test_span(6, 1), "y");
    if (sel attach_fix_edit_r.ok) { builder_dnit(?b); ret 1; }
    val attach_fix_edit_r2: err[fail.Fail] = attach_fix_edit(?b, 99::FixId, 1::source.FileId, test_span(20, 1), "z");
    if (sel attach_fix_edit_r2.ok) { builder_dnit(?b); ret 1; }
    val attach_fix_r: res[FixId, fail.Fail] = attach_fix(?b, nil, 1::source.FileId, sp, "y");
    if (sel attach_fix_r.ok)    { builder_dnit(?b); ret 1; }
    val attach_fix_r2: res[FixId, fail.Fail] = attach_fix(?b, "", 1::source.FileId, sp, "y");
    if (sel attach_fix_r2.ok)     { builder_dnit(?b); ret 1; }
    if (b.fixes.len != 1 || b.fixes.data[0].edits.len != 1) { builder_dnit(?b); ret 1; }

    builder_dnit(?b);
    ret 0;
}

test "mach.lang.diagnostic.remove_fix_committed:rejects_a_fix_that_is_not_the_last_one" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(4, 5);

    val error_r: err[fail.Fail] = error(?store, 1::source.FileId, sp, "first");
    if (sel error_r.err) { store_dnit(?store); ret 1; }
    val last_id_r: opt[DiagnosticId] = last_id(?store);
    if (sel last_id_r.none) { store_dnit(?store); ret 99; }
    val id: DiagnosticId = last_id_r.some;

    val fix1_r: res[FixId, fail.Fail] = attach_fix_committed(?store, id, "first fix", 1::source.FileId, sp, "a");
    if (sel fix1_r.err) { store_dnit(?store); ret 1; }
    val fix1: FixId = fix1_r.ok;
    val fix2_r: res[FixId, fail.Fail] = attach_fix_committed(?store, id, "second fix", 1::source.FileId, sp, "b");
    if (sel fix2_r.err) { store_dnit(?store); ret 1; }

    val remove_fix_committed_r: err[fail.Fail] = remove_fix_committed(?store, id, fix1);
    if (sel remove_fix_committed_r.ok) { store_dnit(?store); ret 2; }

    val get_r: opt[*Diagnostic] = get(?store, 0);
    if (sel get_r.none) { store_dnit(?store); ret 99; }
    val d: *Diagnostic = get_r.some;
    if (d.fixes.len != 2) { store_dnit(?store); ret 3; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.attach_fix_committed:atomic_multi_edit_rolls_back_on_second_edit_failure" {
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 64 && !found) {
        var backing: A.Allocator;
        page.make(?backing);
        var failing: T.Testing;
        val make_r: err[A.Error] = T.make(?failing);
        if (sel make_r.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var store: DiagnosticStore = store_init(T.allocator_of(?failing));
        val sp: token.Span = test_span(4, 5);
        val head: token.Span = test_span(4, 0);
        val tail: token.Span = test_span(9, 0);

        val err_r: err[fail.Fail] = error(?store, 1::source.FileId, sp, "cast is required");
        if (sel err_r.ok) {
            val last_id_r: opt[DiagnosticId] = last_id(?store);
            if (sel last_id_r.none) { store_dnit(?store); ret 99; }
            val id: DiagnosticId = last_id_r.some;
            val fix_r: res[FixId, fail.Fail] = attach_fix_committed(?store, id, "cast the value to `i64`", 1::source.FileId, head, "(");
            if (sel fix_r.ok) {
                val fid: FixId = fix_r.ok;
                val edit_r: err[fail.Fail] = attach_fix_edit_committed(?store, id, fid, 1::source.FileId, tail, ")::i64");
                if (sel edit_r.err) {
                    val remove_fix_committed_r: err[fail.Fail] = remove_fix_committed(?store, id, fid);
                    if (sel remove_fix_committed_r.err) { store_dnit(?store); ret 1; }
                    val get_r: opt[*Diagnostic] = get(?store, 0);
                    if (sel get_r.none) { store_dnit(?store); ret 99; }
                    val d: *Diagnostic = get_r.some;
                    if (d.fixes.len == 0) { found = true; }
                }
            }
        }

        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test "mach.lang.diagnostic.mark_truncate:discards_owned_tail_and_rejects_stale_marks" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    val sp: token.Span = test_span(1, 2);

    val warning_r: err[fail.Fail] = warning(?store, 0, sp, "kept");
    if (sel warning_r.err) { store_dnit(?store); ret 1; }
    val mark_after_kept: DiagMark = mark(?store);

    val error_r: err[fail.Fail] = error(?store, 0, sp, "discarded");
    if (sel error_r.err)    { store_dnit(?store); ret 2; }
    val mark_after_discarded: DiagMark = mark(?store);

    val truncate_r: err[fail.Fail] = truncate(?store, mark_after_kept);
    if (sel truncate_r.err)    { store_dnit(?store); ret 3; }
    val kept: opt[*Diagnostic] = get(?store, 0);
    if (sel kept.none) { store_dnit(?store); ret 4; }
    if (len(?store) != 1 || !str_equals(kept.some.message, "kept")) { store_dnit(?store); ret 4; }
    if (has_errors(?store))                                        { store_dnit(?store); ret 5; }

    val truncate_r2: err[fail.Fail] = truncate(?store, mark_after_discarded);
    if (sel truncate_r2.ok) { store_dnit(?store); ret 6; }

    val error_r2: err[fail.Fail] = error(?store, 0, sp, "replacement tail");
    if (sel error_r2.err) { store_dnit(?store); ret 7; }
    val tail: opt[*Diagnostic] = get(?store, 1);
    if (sel tail.none) { store_dnit(?store); ret 8; }
    if (len(?store) != 2 || !str_equals(tail.some.message, "replacement tail")) { store_dnit(?store); ret 8; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.snapshot_replay:round_trips_notes_related_and_fixes" {
    var a: A.Allocator;
    page.make(?a);
    var src: DiagnosticStore = store_init(?a);

    val warning_r: err[fail.Fail] = warning(?src, 0::source.FileId, test_span(4, 2), "leading warning");
    if (sel warning_r.err) { store_dnit(?src); ret 1; }
    val from: usize = len(?src);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, SEVERITY_ERROR, 5::source.FileId, test_span(10, 3), "the error");
    if (sel b_r.err) { store_dnit(?src); ret 1; }
    var b: DiagnosticBuilder = b_r.ok;
    attach_help(?b, "try this");
    attach_related(?b, 6::source.FileId, test_span(20, 1), "previous here");
    val fix_r: res[FixId, fail.Fail] = attach_fix(?b, "apply", 5::source.FileId, test_span(10, 3), "fixed");
    if (sel fix_r.err) { builder_dnit(?b); store_dnit(?src); ret 1; }
    val commit_r: res[DiagnosticId, fail.Fail] = commit(?b, ?src);
    if (sel commit_r.err) { builder_dnit(?b); store_dnit(?src); ret 1; }

    val snap_r: res[*DiagnosticStore, fail.Fail] = snapshot_from(?src, from, ?a);
    if (sel snap_r.err) { store_dnit(?src); ret 1; }
    val snap: *DiagnosticStore = snap_r.ok;

    var dst: DiagnosticStore = store_init(?a);
    val replay_into_r: err[fail.Fail] = replay_into(?dst, snap);
    if (sel replay_into_r.err) { store_dnit(?src); store_dnit(snap); A.deallocate[DiagnosticStore](?a, snap, 1); store_dnit(?dst); ret 1; }

    store_dnit(?src);

    var bad: i32 = 0;
    val snapped: opt[*Diagnostic] = get(snap, 0);
    if (len(snap) != 1) { bad = 1; }
    if (sel snapped.none) { bad = 1; }
    or (sel snapped.some) {
        val d: *Diagnostic = snapped.some;
        if (d.severity != SEVERITY_ERROR)                                  { bad = 1; }
        or (!str_equals(d.message, "the error"))                           { bad = 1; }
        or (d.children.len != 1)                                           { bad = 1; }
        or (!str_equals(d.children.data[0].text, "try this"))              { bad = 1; }
        or (d.related.len != 1)                                            { bad = 1; }
        or (!str_equals(d.related.data[0].label, "previous here"))         { bad = 1; }
        or (d.fixes.len != 1)                                              { bad = 1; }
    }

    val replayed: opt[*Diagnostic] = get(?dst, 0);
    if (len(?dst) != 1) { bad = 1; }
    if (sel replayed.none) { bad = 1; }
    or (sel replayed.some) {
        val d: *Diagnostic = replayed.some;
        if (!str_equals(d.message, "the error")) { bad = 1; }
        or (d.fixes.len != 1)                    { bad = 1; }
    }

    store_dnit(?dst);
    store_dnit(snap);
    A.deallocate[DiagnosticStore](?a, snap, 1);
    ret bad;
}

test "mach.lang.diagnostic.replay_into:rejects_self_and_rolls_back_on_failure" {
    var a: A.Allocator;
    page.make(?a);

    var store: DiagnosticStore = store_init(?a);
    val error_r: err[fail.Fail] = error(?store, 0, test_span(0, 1), "self");
    if (sel error_r.err) { store_dnit(?store); ret 1; }
    val replay_into_r: err[fail.Fail] = replay_into(?store, ?store);
    if (sel replay_into_r.ok) { store_dnit(?store); ret 1; }
    store_dnit(?store);

    var src: DiagnosticStore = store_init(?a);
    val error_r2: err[fail.Fail] = error(?src, 0, test_span(0, 1), "first");
    if (sel error_r2.err) { store_dnit(?src); ret 1; }
    val error_r3: err[fail.Fail] = error(?src, 0, test_span(1, 1), "second");
    if (sel error_r3.err) { store_dnit(?src); ret 1; }

    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    val make_r: err[A.Error] = T.make(?failing);
    if (sel make_r.err) { store_dnit(?src); ret 1; }
    T.fail_at_ordinal(?failing, 3::usize);
    var dst: DiagnosticStore = store_init(T.allocator_of(?failing));
    val error_r4: err[fail.Fail] = error(?dst, 0, test_span(0, 1), "already there");
    if (sel error_r4.err) { store_dnit(?src); store_dnit(?dst); ret 1; }

    val replay_into_r2: err[fail.Fail] = replay_into(?dst, ?src);
    if (sel replay_into_r2.ok) { store_dnit(?src); store_dnit(?dst); ret 1; }
    if (len(?dst) != 1) { store_dnit(?src); store_dnit(?dst); ret 1; }
    val present: opt[*Diagnostic] = get(?dst, 0);
    if (sel present.none) { store_dnit(?src); store_dnit(?dst); ret 1; }
    if (!str_equals(present.some.message, "already there")) { store_dnit(?src); store_dnit(?dst); ret 1; }

    store_dnit(?src);
    store_dnit(?dst);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.diagnostic.commit:fails_closed_when_allocator_is_exhausted" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    val make_r: err[A.Error] = T.make(?failing);
    if (sel make_r.err) { ret 1; }
    T.fail_at_ordinal(?failing, 1::usize);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(T.allocator_of(?failing), SEVERITY_ERROR, 0, test_span(0, 1), "an error");
    if (sel b_r.ok) {
        var built: DiagnosticBuilder = b_r.ok;
        builder_dnit(?built);
        ret 1;
    }
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.diagnostic.commit:builder_survives_a_failed_push_for_retry_or_teardown" {
    var backing: A.Allocator;
    page.make(?backing);
    var failing: T.Testing;
    val make_r: err[A.Error] = T.make(?failing);
    if (sel make_r.err) { ret 1; }
    T.fail_at_ordinal(?failing, 2::usize);

    var store: DiagnosticStore = store_init(T.allocator_of(?failing));
    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(T.allocator_of(?failing), SEVERITY_ERROR, 0, test_span(0, 1), "an error");
    if (sel b_r.err) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = b_r.ok;

    val commit_r: res[DiagnosticId, fail.Fail] = commit(?b, ?store);
    if (sel commit_r.ok) { store_dnit(?store); ret 1; }
    if (!b.live) { store_dnit(?store); ret 1; }
    if (len(?store) != 0) { builder_dnit(?b); store_dnit(?store); ret 1; }

    builder_dnit(?b);
    store_dnit(?store);
    if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
    if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    T.dnit(?failing);
    ret 0;
}

test "mach.lang.diagnostic.resolve:rejects_a_diagnostic_id_invalidated_by_truncate" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);

    val b_r: res[DiagnosticBuilder, fail.Fail] = builder_init(?a, SEVERITY_ERROR, 0, test_span(0, 1), "first");
    if (sel b_r.err) { store_dnit(?store); ret 1; }
    var b: DiagnosticBuilder = b_r.ok;
    val commit_r: res[DiagnosticId, fail.Fail] = commit(?b, ?store);
    if (sel commit_r.err) { builder_dnit(?b); store_dnit(?store); ret 1; }
    val id: DiagnosticId = commit_r.ok;

    val resolve_r: opt[*Diagnostic] = resolve(?store, id);
    if (sel resolve_r.none) { store_dnit(?store); ret 1; }

    var zero: DiagMark;
    zero.len   = 0;
    zero.epoch = store.epoch;
    val truncate_r: err[fail.Fail] = truncate(?store, zero);
    if (sel truncate_r.err) { store_dnit(?store); ret 1; }
    val resolve_r2: opt[*Diagnostic] = resolve(?store, id);
    if (sel resolve_r2.some) { store_dnit(?store); ret 2; }

    val error_r: err[fail.Fail] = error(?store, 0, test_span(0, 1), "second");
    if (sel error_r.err) { store_dnit(?store); ret 1; }
    val resolve_r3: opt[*Diagnostic] = resolve(?store, id);
    if (sel resolve_r3.some) { store_dnit(?store); ret 3; }

    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.gate_error:dedups_by_key_and_lets_distinct_facets_through" {
    var a: A.Allocator;
    page.make(?a);
    var store: DiagnosticStore = store_init(?a);
    var itn: intern.Interner = intern.init(?a);

    val sp: token.Span = test_span(0, 4);

    val r1: res[bool, fail.Fail] = gate_error(?store, ?itn, 1::source.FileId, sp, "must have type u8");
    if (sel r1.err) { intern.dnit(?itn); store_dnit(?store); ret 1; }
    if (!r1.ok) { intern.dnit(?itn); store_dnit(?store); ret 1; }

    val r2: res[bool, fail.Fail] = gate_error(?store, ?itn, 1::source.FileId, sp, "must have type u8");
    if (sel r2.err) { intern.dnit(?itn); store_dnit(?store); ret 2; }
    if (r2.ok) { intern.dnit(?itn); store_dnit(?store); ret 2; }

    val r3: res[bool, fail.Fail] = gate_error(?store, ?itn, 1::source.FileId, sp, "a different message");
    if (sel r3.err) { intern.dnit(?itn); store_dnit(?store); ret 3; }
    if (!r3.ok) { intern.dnit(?itn); store_dnit(?store); ret 3; }

    val r4: res[bool, fail.Fail] = gate_error(?store, ?itn, 2::source.FileId, sp, "must have type u8");
    if (sel r4.err) { intern.dnit(?itn); store_dnit(?store); ret 4; }
    if (!r4.ok) { intern.dnit(?itn); store_dnit(?store); ret 4; }

    if (len(?store) != 3) { intern.dnit(?itn); store_dnit(?store); ret 5; }

    intern.dnit(?itn);
    store_dnit(?store);
    ret 0;
}

test "mach.lang.diagnostic.gate_error:surfaces_ledger_insert_failure" {
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 64 && !found) {
        var backing: A.Allocator;
        page.make(?backing);
        var failing: T.Testing;
        val make_r: err[A.Error] = T.make(?failing);
        if (sel make_r.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        var store: DiagnosticStore = store_init(T.allocator_of(?failing));
        var itn: intern.Interner = intern.init(T.allocator_of(?failing));

        val sp: token.Span = test_span(0, 4);

        val r: res[bool, fail.Fail] = gate_error(?store, ?itn, 1::source.FileId, sp, "x");
        if (sel r.err && len(?store) == 1) { found = true; }

        intern.dnit(?itn);
        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

test "mach.lang.diagnostic.record:a_lost_append_is_a_durable_rejection" {
    var backing: A.Allocator;
    page.make(?backing);

    val sp: token.Span = test_span(0, 1);

    var ordinal: u64 = 1;
    for (ordinal <= 4) {
        var failing: T.Testing;
        val make_r: err[A.Error] = T.make(?failing);
        if (sel make_r.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);
        var store: DiagnosticStore = store_init(T.allocator_of(?failing));

        record_warning(?store, 0::source.FileId, sp, "a warning");
        if (len(?store) == 0) {
            if (lost_count(?store) == 0)  { store_dnit(?store); ret 1; }
            if (!has_errors(?store))      { store_dnit(?store); ret 1; }
        }

        store_dnit(?store);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }

    var clean: DiagnosticStore = store_init(?backing);
    record_warning(?clean, 0::source.FileId, sp, "a warning");
    if (len(?clean) != 1)         { store_dnit(?clean); ret 1; }
    if (lost_count(?clean) != 0)  { store_dnit(?clean); ret 1; }
    if (has_errors(?clean))       { store_dnit(?clean); ret 1; }

    record_error(?clean, 0::source.FileId, sp, "an error");
    if (len(?clean) != 2)         { store_dnit(?clean); ret 1; }
    if (!has_errors(?clean))      { store_dnit(?clean); ret 1; }
    if (lost_count(?clean) != 0)  { store_dnit(?clean); ret 1; }

    store_dnit(?clean);
    ret 0;
}

test "mach.lang.diagnostic.gate_error:dedup_follows_the_sink_and_retained_diagnostics" {
    var a: A.Allocator;
    page.make(?a);
    var itn: intern.Interner = intern.init(?a);
    fin { intern.dnit(?itn); }
    var first: DiagnosticStore = store_init(?a);
    fin { store_dnit(?first); }
    var second: DiagnosticStore = store_init(?a);
    fin { store_dnit(?second); }
    val sp: token.Span = test_span(3, 2);
    val initial: res[bool, fail.Fail] = gate_error(?first, ?itn, 1, sp, "kept");
    if (sel initial.err) { ret 1; }
    if (!initial.ok) { ret 1; }
    val before_tail: DiagMark = mark(?first);
    val tail: res[bool, fail.Fail] = gate_error(?first, ?itn, 1, sp, "removed");
    if (sel tail.err) { ret 2; }
    if (!tail.ok) { ret 2; }
    val truncate_r: err[fail.Fail] = truncate(?first, before_tail);
    if (sel truncate_r.err) { ret 3; }
    val retained: res[bool, fail.Fail] = gate_error(?first, ?itn, 1, sp, "kept");
    if (sel retained.err) { ret 4; }
    if (retained.ok) { ret 4; }
    val replaced: res[bool, fail.Fail] = gate_error(?first, ?itn, 1, sp, "removed");
    if (sel replaced.err) { ret 5; }
    if (!replaced.ok) { ret 5; }
    val independent: res[bool, fail.Fail] = gate_error(?second, ?itn, 1, sp, "kept");
    if (sel independent.err) { ret 6; }
    if (!independent.ok) { ret 6; }
    if (len(?first) != 2 || len(?second) != 1) { ret 7; }
    ret 0;
}

test "mach.lang.diagnostic.gate_error:snapshots_preserve_replay_and_truncation_identity" {
    var a: A.Allocator;
    val make_r: err[A.Error] = page.make(?a);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?a);
    fin { intern.dnit(?itn); }
    var src: DiagnosticStore = store_init(?a);
    fin { store_dnit(?src); }
    var dst: DiagnosticStore = store_init(?a);
    fin { store_dnit(?dst); }
    var span: token.Span;
    span.offset = 3;
    span.len = 1;
    val original: res[bool, fail.Fail] = gate_error(?src, ?itn, 1, span, "invalid gate");
    if (sel original.err) { ret 2; }
    val snapshot_r: res[*DiagnosticStore, fail.Fail] = snapshot_from(?src, 0, ?a);
    if (sel snapshot_r.err) { ret 3; }
    val snapshot: *DiagnosticStore = snapshot_r.ok;
    fin { store_dnit(snapshot); A.deallocate[DiagnosticStore](?a, snapshot, 1); }
    val before: DiagMark = mark(?dst);
    val replay_into_r: err[fail.Fail] = replay_into(?dst, snapshot);
    if (sel replay_into_r.err) { ret 4; }
    val replay_into_r2: err[fail.Fail] = replay_into(?dst, ?src);
    if (sel replay_into_r2.err) { ret 5; }
    val repeated: res[bool, fail.Fail] = gate_error(?dst, ?itn, 1, span, "invalid gate");
    if (sel repeated.err) { ret 6; }
    if (repeated.ok) { ret 6; }
    if (len(?dst) != 1) { ret 6; }
    val truncate_r: err[fail.Fail] = truncate(?dst, before);
    if (sel truncate_r.err) { ret 7; }
    val replay_into_r3: err[fail.Fail] = replay_into(?dst, snapshot);
    if (sel replay_into_r3.err) { ret 8; }
    if (len(?dst) != 1 || error_count(?dst) != 1) { ret 9; }
    ret 0;
}
