# strongly connected components of a directed graph over numbered nodes
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;

# a node not yet reached by the search
val UNSEEN: u32 = 0xFFFFFFFF;

pub rec Arc {
    from: u32;
    to:   u32;
}

# Tarjan's strongly connected components over `n` nodes and `e` arcs, iteratively; `comp`
# gets each node's component and the result is the component count
pub fun components(alloc: *A.Allocator, n: u32, arcs: *Arc, e: u32, comp: *u32) res[u32, fail.Fail] {
    var start: collections_vector.Vector[u32]  = collections_vector.init[u32](alloc);
    var adj:   collections_vector.Vector[u32]  = collections_vector.init[u32](alloc);
    var order: collections_vector.Vector[u32]  = collections_vector.init[u32](alloc);
    var low:   collections_vector.Vector[u32]  = collections_vector.init[u32](alloc);
    var stack: collections_vector.Vector[u32]  = collections_vector.init[u32](alloc);
    var calls: collections_vector.Vector[u32]  = collections_vector.init[u32](alloc);
    var curs:  collections_vector.Vector[u32]  = collections_vector.init[u32](alloc);
    var on:    collections_vector.Vector[bool] = collections_vector.init[bool](alloc);
    fin {
        collections_vector.dnit[u32](?start);
        collections_vector.dnit[u32](?adj);
        collections_vector.dnit[u32](?order);
        collections_vector.dnit[u32](?low);
        collections_vector.dnit[u32](?stack);
        collections_vector.dnit[u32](?calls);
        collections_vector.dnit[u32](?curs);
        collections_vector.dnit[bool](?on);
    }
    val reserved: err[fail.Fail] = components_reserve(n, e, ?start, ?adj, ?order, ?low, ?curs, ?on);
    if (sel reserved.err) { ret res[u32, fail.Fail].err{reserved.err}; }

    var i: u32 = 0;
    for (i < e) {
        start.data[arcs[i].from + 1] = start.data[arcs[i].from + 1] + 1;
        i                            = i + 1;
    }
    i = 0;
    for (i < n) {
        start.data[i + 1] = start.data[i + 1] + start.data[i];
        comp[i]           = UNSEEN;
        i                 = i + 1;
    }
    i = 0;
    for (i < e) {
        val from: u32 = arcs[i].from;
        adj.data[start.data[from] + curs.data[from]] = arcs[i].to;
        curs.data[from]                              = curs.data[from] + 1;
        i                                            = i + 1;
    }

    var counter: u32 = 0;
    var comps:   u32 = 0;
    var root:    u32 = 0;
    for (root < n) {
        if (order.data[root] != UNSEEN) {
            root = root + 1;
            cnt;
        }
        order.data[root] = counter;
        low.data[root]   = counter;
        counter          = counter + 1;
        curs.data[root]  = start.data[root];
        on.data[root]    = true;
        val p_root: res[usize, A.Error] = collections_vector.push[u32](?stack, root);
        if (sel p_root.err) { ret res[u32, fail.Fail].err{fail.refused(p_root.err)}; }
        val c_root: res[usize, A.Error] = collections_vector.push[u32](?calls, root);
        if (sel c_root.err) { ret res[u32, fail.Fail].err{fail.refused(c_root.err)}; }

        for (calls.len > 0) {
            val v: u32 = calls.data[calls.len - 1];
            if (curs.data[v] < start.data[v + 1]) {
                val t: u32 = adj.data[curs.data[v]];
                curs.data[v] = curs.data[v] + 1;
                if (order.data[t] == UNSEEN) {
                    order.data[t] = counter;
                    low.data[t]   = counter;
                    counter       = counter + 1;
                    curs.data[t]  = start.data[t];
                    on.data[t]    = true;
                    val p_t: res[usize, A.Error] = collections_vector.push[u32](?stack, t);
                    if (sel p_t.err) { ret res[u32, fail.Fail].err{fail.refused(p_t.err)}; }
                    val c_t: res[usize, A.Error] = collections_vector.push[u32](?calls, t);
                    if (sel c_t.err) { ret res[u32, fail.Fail].err{fail.refused(c_t.err)}; }
                }
                or (on.data[t] && order.data[t] < low.data[v]) {
                    low.data[v] = order.data[t];
                }
                cnt;
            }
            calls.len = calls.len - 1;
            if (calls.len > 0) {
                val p: u32 = calls.data[calls.len - 1];
                if (low.data[v] < low.data[p]) { low.data[p] = low.data[v]; }
            }
            if (low.data[v] == order.data[v]) {
                for (true) {
                    stack.len = stack.len - 1;
                    val m: u32 = stack.data[stack.len];
                    on.data[m] = false;
                    comp[m]    = comps;
                    if (m == v) { brk; }
                }
                comps = comps + 1;
            }
        }
        root = root + 1;
    }
    ret res[u32, fail.Fail].ok{comps};
}

fun components_reserve(n: u32, e: u32, start: *collections_vector.Vector[u32], adj: *collections_vector.Vector[u32],
    order: *collections_vector.Vector[u32], low: *collections_vector.Vector[u32], curs: *collections_vector.Vector[u32],
    on: *collections_vector.Vector[bool]) err[fail.Fail] {
    var i: u32 = 0;
    for (i <= n) {
        val pushed: res[usize, A.Error] = collections_vector.push[u32](start, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    i = 0;
    for (i < e) {
        val pushed: res[usize, A.Error] = collections_vector.push[u32](adj, 0);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        val po: res[usize, A.Error] = collections_vector.push[u32](order, UNSEEN);
        if (sel po.err) { ret err[fail.Fail].err{fail.refused(po.err)}; }
        val pl: res[usize, A.Error] = collections_vector.push[u32](low, 0);
        if (sel pl.err) { ret err[fail.Fail].err{fail.refused(pl.err)}; }
        val pc: res[usize, A.Error] = collections_vector.push[u32](curs, 0);
        if (sel pc.err) { ret err[fail.Fail].err{fail.refused(pc.err)}; }
        val pn: res[usize, A.Error] = collections_vector.push[bool](on, false);
        if (sel pn.err) { ret err[fail.Fail].err{fail.refused(pn.err)}; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
