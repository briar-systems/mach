use std.allocator.page;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.lang.alloc;
use mach.lang.layout;

# the builder's failure: the allocator refused, a length or capacity left
# usize, or the builder was used after an earlier failure
pub tag Error: u8 {
    alloc: A.Error;
    overflow;
    failed;
}

pub fun text(e: Error) str {
    if (sel e.alloc)    { ret alloc.text(e.alloc); }
    or (sel e.overflow) { ret "text builder: length overflow"; }
    ret "text builder: used after a prior failure";
}

pub rec TextBuilder {
    alloc:  *A.Allocator;
    data:   *u8;
    len:    usize;
    cap:    usize;
    failed: bool;
}

pub fun tb_init(a: *A.Allocator) TextBuilder {
    var b: TextBuilder;
    b.alloc  = a;
    b.data   = nil;
    b.len    = 0;
    b.cap    = 0;
    b.failed = false;
    ret b;
}

fun tb_grow(b: *TextBuilder, need: usize) err[Error] {
    if (need <= b.cap) { ret err[Error].ok{}; }
    var new_cap: usize = b.cap;
    if (new_cap == 0) { new_cap = 32; }
    for (new_cap < need) {
        val doubled: res[usize, layout.CheckCause] = layout.usize_mul(new_cap, 2);
        if (sel doubled.err) {
            b.failed = true;
            ret err[Error].err{Error.overflow{}};
        }
        new_cap = doubled.ok;
    }
    val grown: res[*u8, A.Error] = A.reallocate[u8](b.alloc, b.data, b.cap, new_cap);
    if (sel grown.err) {
        b.failed = true;
        ret err[Error].err{Error.alloc{grown.err}};
    }
    b.data = grown.ok;
    b.cap  = new_cap;
    ret err[Error].ok{};
}

pub fun tb_append(b: *TextBuilder, text: str) err[Error] {
    if (b.failed) { ret err[Error].err{Error.failed{}}; }
    val n: usize = str_len(text);
    if (n == 0) { ret err[Error].ok{}; }
    val need_r: res[usize, layout.CheckCause] = layout.usize_add(b.len, n);
    if (sel need_r.err) {
        b.failed = true;
        ret err[Error].err{Error.overflow{}};
    }
    val need: usize      = need_r.ok;
    val gr:   err[Error] = tb_grow(b, need);
    if (sel gr.err) { ret gr; }
    memory.raw_copy((b.data::usize + b.len)::ptr, text::ptr, n);
    b.len = need;
    ret err[Error].ok{};
}

#[testing]
pub fun tb_append_all(b: *TextBuilder, parts: *str, count: usize) err[Error] {
    var i: usize = 0;
    for (i < count) {
        val r: err[Error] = tb_append(b, parts[i]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

pub fun tb_failed(b: *TextBuilder) bool {
    ret b.failed;
}

pub fun tb_len(b: *TextBuilder) usize {
    ret b.len;
}

pub fun tb_finish(b: *TextBuilder) res[str, Error] {
    if (b.failed) { ret res[str, Error].err{Error.failed{}}; }
    val out_r: res[*u8, A.Error] = A.reallocate[u8](b.alloc, b.data, b.cap, b.len + 1);
    if (sel out_r.err) {
        b.failed = true;
        ret res[str, Error].err{Error.alloc{out_r.err}};
    }
    val out: *u8 = out_r.ok;
    out[b.len] = 0;
    b.data     = nil;
    b.cap      = 0;
    ret res[str, Error].ok{out::str};
}

pub fun tb_dnit(b: *TextBuilder) {
    if (b.data != nil) {
        A.deallocate[u8](b.alloc, b.data, b.cap);
    }
    b.data = nil;
    b.cap  = 0;
    b.len  = 0;
}

#[testing]
fun tb_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

#[testing]
fun tb_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

#[testing]
fun tb_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test tb_append__accumulates_grows_and_finishes_exact_bytes {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var empty: TextBuilder = tb_init(?alloc);
    val none:  err[Error]  = tb_append(?empty, "");
    if (sel none.err || tb_len(?empty) != 0) { ret 2; }
    val bare: res[str, Error] = tb_finish(?empty);
    if (sel bare.err)             { ret 3; }
    if (!str_equals(bare.ok, "")) { ret 3; }
    var b:     TextBuilder = tb_init(?alloc);
    var parts: [3]str      = [3]str{"hello", ", ", "world"};
    val first: err[Error]  = tb_append_all(?b, ?parts[0], 3);
    if (sel first.err) { ret 4; }
    var i: usize = 0;
    for (i < 500) {
        val grown: err[Error] = tb_append(?b, "ab");
        if (sel grown.err) { ret 5; }
        i = i + 1;
    }
    if (tb_len(?b) != 1012) { ret 6; }
    val fin: res[str, Error] = tb_finish(?b);
    if (sel fin.err) { ret 7; }
    val out: str = fin.ok;
    if (str_len(out) != 1012 || !str_region_equals(out, 0, 12, "hello, world") || out[12] != 'a' || out[1011] != 'b') { ret 8; }
    # the result is the caller's: the builder keeps no buffer to leak or free twice
    if (b.data != nil || b.cap != 0) { ret 9; }
    tb_dnit(?b);
    ret 0;
}

test tb_append__a_failed_reserve_poisons_the_builder_even_if_the_result_is_ignored {
    var alloc: A.Allocator;
    alloc.ctx           = nil;
    alloc.fn_allocate   = tb_probe_allocate;
    alloc.fn_reallocate = tb_probe_reallocate;
    alloc.fn_deallocate = tb_probe_deallocate;

    var b: TextBuilder = tb_init(?alloc);
    tb_append(?b, "this will not fit");
    if (!tb_failed(?b)) { ret 1; }
    val more: err[Error] = tb_append(?b, "more");
    if (sel more.ok) { ret 1; }
    val fin: res[str, Error] = tb_finish(?b);
    if (sel fin.ok) { ret 1; }
    ret 0;
}

test tb_grow__refuses_capacity_overflow_instead_of_spinning {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var b:       TextBuilder = tb_init(?alloc);
    val maximum: usize       = ~(0::usize);
    b.cap = maximum / 2 + 1;
    val r: err[Error] = tb_grow(?b, maximum);
    if (sel r.ok)       { ret 1; }
    if (!tb_failed(?b)) { ret 1; }
    ret 0;
}
