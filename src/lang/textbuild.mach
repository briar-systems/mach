use std.types.option.opt;
use std.types.result.res;
use std.types.error.err;
use page: std.allocator.page;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.alloc;
use mach.lang.layout;

# the builder's failure: the allocator refused, a length or capacity left
# usize, or the builder was used after an earlier failure
pub tag Error: u8 {
    alloc:    A.Error;
    overflow;
    failed;
}

pub fun text(e: Error) str {
    if (sel e.alloc)    { ret alloc.text(e.alloc); }
    or (sel e.overflow) { ret "text builder: length overflow"; }
    ret "text builder: used after a prior failure";
}

pub rec TextBuilder {
    alloc:  *A.Allocator;
    data:   *u8;
    len:    usize;
    cap:    usize;
    failed: bool;
}

pub fun tb_init(a: *A.Allocator) TextBuilder {
    var b: TextBuilder;
    b.alloc  = a;
    b.data   = nil;
    b.len    = 0;
    b.cap    = 0;
    b.failed = false;
    ret b;
}

fun tb_grow(b: *TextBuilder, need: usize) err[Error] {
    if (need <= b.cap) { ret err[Error].ok{}; }
    var new_cap: usize = b.cap;
    if (new_cap == 0) { new_cap = 32; }
    for (new_cap < need) {
        val doubled: res[usize, layout.CheckCause] = layout.usize_mul(new_cap, 2);
        if (sel doubled.err) {
            b.failed = true;
            ret err[Error].err{Error.overflow{}};
        }
        new_cap = doubled.ok;
    }
    val grown: res[*u8, A.Error] = A.reallocate[u8](b.alloc, b.data, b.cap, new_cap);
    if (sel grown.err) {
        b.failed = true;
        ret err[Error].err{Error.alloc{grown.err}};
    }
    b.data = grown.ok;
    b.cap  = new_cap;
    ret err[Error].ok{};
}

pub fun tb_append(b: *TextBuilder, text: str) err[Error] {
    if (b.failed) { ret err[Error].err{Error.failed{}}; }
    val n: usize = str_len(text);
    if (n == 0) { ret err[Error].ok{}; }
    val need_r: res[usize, layout.CheckCause] = layout.usize_add(b.len, n);
    if (sel need_r.err) {
        b.failed = true;
        ret err[Error].err{Error.overflow{}};
    }
    val need: usize = need_r.ok;
    val gr: err[Error] = tb_grow(b, need);
    if (sel gr.err) { ret gr; }
    memory.raw_copy((b.data::usize + b.len)::ptr, text::ptr, n);
    b.len = need;
    ret err[Error].ok{};
}

pub fun tb_append_all(b: *TextBuilder, parts: *str, count: usize) err[Error] {
    var i: usize = 0;
    for (i < count) {
        val r: err[Error] = tb_append(b, parts[i]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

pub fun tb_failed(b: *TextBuilder) bool { ret b.failed; }

pub fun tb_len(b: *TextBuilder) usize { ret b.len; }

pub fun tb_finish(b: *TextBuilder) res[str, Error] {
    if (b.failed) { ret res[str, Error].err{Error.failed{}}; }
    val out_r: res[*u8, A.Error] = A.reallocate[u8](b.alloc, b.data, b.cap, b.len + 1);
    if (sel out_r.err) {
        b.failed = true;
        ret res[str, Error].err{Error.alloc{out_r.err}};
    }
    val out: *u8 = out_r.ok;
    out[b.len] = 0;
    b.data = nil;
    b.cap  = 0;
    ret res[str, Error].ok{out::str};
}

pub fun tb_dnit(b: *TextBuilder) {
    if (b.data != nil) {
        A.deallocate[u8](b.alloc, b.data, b.cap);
    }
    b.data = nil;
    b.cap  = 0;
    b.len  = 0;
}

fun tb_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun tb_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun tb_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.textbuild.tb_append:accumulates_and_finishes_exact_bytes" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    val tb_append_r: err[Error] = tb_append(?b, "hello");
    if (sel tb_append_r.err) { ret 1; }
    val tb_append_r2: err[Error] = tb_append(?b, ", ");
    if (sel tb_append_r2.err) { ret 1; }
    val tb_append_r3: err[Error] = tb_append(?b, "world");
    if (sel tb_append_r3.err) { ret 1; }
    if (tb_len(?b) != 12) { ret 1; }
    val fin: res[str, Error] = tb_finish(?b);
    if (sel fin.err) { ret 1; }
    val out: str = fin.ok;
    if (!str_equals(out, "hello, world")) { ret 1; }
    tb_dnit(?b);
    ret 0;
}

test "mach.lang.textbuild.tb_append:empty_appends_are_free" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    val tb_append_r: err[Error] = tb_append(?b, "");
    if (sel tb_append_r.err) { ret 1; }
    if (tb_len(?b) != 0) { ret 1; }
    val fin: res[str, Error] = tb_finish(?b);
    if (sel fin.err) { ret 1; }
    if (!str_equals(fin.ok, "")) { ret 1; }
    tb_dnit(?b);
    ret 0;
}

test "mach.lang.textbuild.tb_append:grows_past_many_small_appends" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    var i: usize = 0;
    for (i < 500) {
        val tb_append_r: err[Error] = tb_append(?b, "ab");
        if (sel tb_append_r.err) { ret 1; }
        i = i + 1;
    }
    if (tb_len(?b) != 1000) { ret 1; }
    val fin: res[str, Error] = tb_finish(?b);
    if (sel fin.err) { ret 1; }
    val out: str = fin.ok;
    if (str_len(out) != 1000) { ret 1; }
    if (out[0] != 'a' || out[1] != 'b' || out[998] != 'a' || out[999] != 'b') { ret 1; }
    tb_dnit(?b);
    ret 0;
}

test "mach.lang.textbuild.tb_append:a_failed_reserve_poisons_the_builder_even_if_the_result_is_ignored" {
    var alloc: A.Allocator;
    alloc.ctx           = nil;
    alloc.fn_allocate   = tb_probe_allocate;
    alloc.fn_reallocate = tb_probe_reallocate;
    alloc.fn_deallocate = tb_probe_deallocate;

    var b: TextBuilder = tb_init(?alloc);
    tb_append(?b, "this will not fit");
    if (!tb_failed(?b)) { ret 1; }
    val more: err[Error] = tb_append(?b, "more");
    if (sel more.ok) { ret 1; }
    val fin: res[str, Error] = tb_finish(?b);
    if (sel fin.ok) { ret 1; }
    ret 0;
}

test "mach.lang.textbuild.tb_grow:refuses_capacity_overflow_instead_of_spinning" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    val maximum: usize = ~(0::usize);
    b.cap = maximum / 2 + 1;
    val r: err[Error] = tb_grow(?b, maximum);
    if (sel r.ok) { ret 1; }
    if (!tb_failed(?b)) { ret 1; }
    ret 0;
}

test "mach.lang.textbuild.tb_finish:transfers_ownership_and_leaves_no_internal_buffer_to_leak_or_double_free" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    val tb_append_r: err[Error] = tb_append(?b, "owned");
    if (sel tb_append_r.err) { ret 1; }
    val fin: res[str, Error] = tb_finish(?b);
    if (sel fin.err) { ret 1; }
    if (b.data != nil) { ret 1; }
    if (b.cap != 0)    { ret 1; }
    tb_dnit(?b);
    if (!str_equals(fin.ok, "owned")) { ret 1; }
    ret 0;
}
