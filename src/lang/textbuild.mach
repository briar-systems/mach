use std.allocator.page;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.layout;

pub rec TextBuilder {
    alloc:  *A.Allocator;
    data:   *u8;
    len:    usize;
    cap:    usize;
    failed: bool;
}

pub fun tb_init(a: *A.Allocator) TextBuilder {
    var b: TextBuilder;
    b.alloc  = a;
    b.data   = nil;
    b.len    = 0;
    b.cap    = 0;
    b.failed = false;
    ret b;
}

fun tb_grow(b: *TextBuilder, need: usize) R.Result[R.Void, str] {
    if (need <= b.cap) { ret R.ok_void[str](); }
    var new_cap: usize = b.cap;
    if (new_cap == 0) { new_cap = 32; }
    for (new_cap < need) {
        val doubled: R.Result[usize, layout.CheckCause] = layout.usize_mul(new_cap, 2);
        if (R.is_err[usize, layout.CheckCause](doubled)) {
            b.failed = true;
            ret R.err[R.Void, str]("text builder: capacity overflow");
        }
        new_cap = R.unwrap_ok[usize, layout.CheckCause](doubled);
    }
    val res: R.Result[*u8, str] = A.reallocate[u8](b.alloc, b.data, b.cap, new_cap);
    if (R.is_err[*u8, str](res)) {
        b.failed = true;
        ret R.err[R.Void, str](R.unwrap_err[*u8, str](res));
    }
    b.data = R.unwrap_ok[*u8, str](res);
    b.cap  = new_cap;
    ret R.ok_void[str]();
}

pub fun tb_append(b: *TextBuilder, text: str) R.Result[R.Void, str] {
    if (b.failed) { ret R.err[R.Void, str]("text builder: appended after a prior failure"); }
    val n: usize = str_len(text);
    if (n == 0) { ret R.ok_void[str](); }
    val need_r: R.Result[usize, layout.CheckCause] = layout.usize_add(b.len, n);
    if (R.is_err[usize, layout.CheckCause](need_r)) {
        b.failed = true;
        ret R.err[R.Void, str]("text builder: length overflow");
    }
    val need: usize = R.unwrap_ok[usize, layout.CheckCause](need_r);
    val gr: R.Result[R.Void, str] = tb_grow(b, need);
    if (R.is_err[R.Void, str](gr)) { ret gr; }
    memory.raw_copy((b.data::usize + b.len)::ptr, text::ptr, n);
    b.len = need;
    ret R.ok_void[str]();
}

pub fun tb_append_all(b: *TextBuilder, parts: *str, count: usize) R.Result[R.Void, str] {
    var i: usize = 0;
    for (i < count) {
        val r: R.Result[R.Void, str] = tb_append(b, parts[i]);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun tb_failed(b: *TextBuilder) bool { ret b.failed; }

pub fun tb_len(b: *TextBuilder) usize { ret b.len; }

pub fun tb_finish(b: *TextBuilder) R.Result[str, str] {
    if (b.failed) { ret R.err[str, str]("text builder: failed mid-construction"); }
    val out_r: R.Result[*u8, str] = A.reallocate[u8](b.alloc, b.data, b.cap, b.len + 1);
    if (R.is_err[*u8, str](out_r)) {
        b.failed = true;
        ret R.err[str, str](R.unwrap_err[*u8, str](out_r));
    }
    val out: *u8 = R.unwrap_ok[*u8, str](out_r);
    out[b.len] = 0;
    b.data = nil;
    b.cap  = 0;
    ret R.ok[str, str](out::str);
}

pub fun tb_dnit(b: *TextBuilder) {
    if (b.data != nil) {
        A.deallocate[u8](b.alloc, b.data, b.cap);
    }
    b.data = nil;
    b.cap  = 0;
    b.len  = 0;
}

fun tb_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun tb_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun tb_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.textbuild.tb_append:accumulates_and_finishes_exact_bytes" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    if (R.is_err[R.Void, str](tb_append(?b, "hello"))) { ret 1; }
    if (R.is_err[R.Void, str](tb_append(?b, ", "))) { ret 1; }
    if (R.is_err[R.Void, str](tb_append(?b, "world"))) { ret 1; }
    if (tb_len(?b) != 12) { ret 1; }
    val fin: R.Result[str, str] = tb_finish(?b);
    if (R.is_err[str, str](fin)) { ret 1; }
    val out: str = R.unwrap_ok[str, str](fin);
    if (!str_equals(out, "hello, world")) { ret 1; }
    tb_dnit(?b);
    ret 0;
}

test "mach.lang.textbuild.tb_append:empty_appends_are_free" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    if (R.is_err[R.Void, str](tb_append(?b, ""))) { ret 1; }
    if (tb_len(?b) != 0) { ret 1; }
    val fin: R.Result[str, str] = tb_finish(?b);
    if (R.is_err[str, str](fin)) { ret 1; }
    if (!str_equals(R.unwrap_ok[str, str](fin), "")) { ret 1; }
    tb_dnit(?b);
    ret 0;
}

test "mach.lang.textbuild.tb_append:grows_past_many_small_appends" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    var i: usize = 0;
    for (i < 500) {
        if (R.is_err[R.Void, str](tb_append(?b, "ab"))) { ret 1; }
        i = i + 1;
    }
    if (tb_len(?b) != 1000) { ret 1; }
    val fin: R.Result[str, str] = tb_finish(?b);
    if (R.is_err[str, str](fin)) { ret 1; }
    val out: str = R.unwrap_ok[str, str](fin);
    if (str_len(out) != 1000) { ret 1; }
    if (out[0] != 'a' || out[1] != 'b' || out[998] != 'a' || out[999] != 'b') { ret 1; }
    tb_dnit(?b);
    ret 0;
}

test "mach.lang.textbuild.tb_append:a_failed_reserve_poisons_the_builder_even_if_the_result_is_ignored" {
    var alloc: A.Allocator;
    alloc.ctx           = nil;
    alloc.fn_allocate   = tb_probe_allocate;
    alloc.fn_reallocate = tb_probe_reallocate;
    alloc.fn_deallocate = tb_probe_deallocate;

    var b: TextBuilder = tb_init(?alloc);
    tb_append(?b, "this will not fit");
    if (!tb_failed(?b)) { ret 1; }
    val more: R.Result[R.Void, str] = tb_append(?b, "more");
    if (R.is_ok[R.Void, str](more)) { ret 1; }
    val fin: R.Result[str, str] = tb_finish(?b);
    if (R.is_ok[str, str](fin)) { ret 1; }
    ret 0;
}

test "mach.lang.textbuild.tb_grow:refuses_capacity_overflow_instead_of_spinning" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    val maximum: usize = ~(0::usize);
    b.cap = maximum / 2 + 1;
    val r: R.Result[R.Void, str] = tb_grow(?b, maximum);
    if (R.is_ok[R.Void, str](r)) { ret 1; }
    if (!tb_failed(?b)) { ret 1; }
    ret 0;
}

test "mach.lang.textbuild.tb_finish:transfers_ownership_and_leaves_no_internal_buffer_to_leak_or_double_free" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var b: TextBuilder = tb_init(?alloc);
    if (R.is_err[R.Void, str](tb_append(?b, "owned"))) { ret 1; }
    val fin: R.Result[str, str] = tb_finish(?b);
    if (R.is_err[str, str](fin)) { ret 1; }
    if (b.data != nil) { ret 1; }
    if (b.cap != 0)    { ret 1; }
    tb_dnit(?b);
    if (!str_equals(R.unwrap_ok[str, str](fin), "owned")) { ret 1; }
    ret 0;
}
