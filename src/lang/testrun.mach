use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.text.string.str_dup;
use std.text.string.str_free;

use collections_vector: std.collections.vector;
use std.collections.vector.Vector;

use A: std.allocator;

# a collected test and how it ran: the test a dispatcher runs, each run's
# result, and the tally over a run's results

# a collected test: its qualified name, where it is declared, the test object
# that holds it, the dispatcher that runs it as `<exe> <idx>`, and the target and
# profile that dispatcher was built for
pub rec TestArtifact {
    module:  *u8;
    name:    *u8;
    file:    *u8;
    line:    u32;
    object:  *u8;
    exe:     *u8;
    idx:     u32;
    target:  *u8;
    profile: *u8;
}

# the exit status a test reports a skip with: 0 is a pass, this is a skip, and
# any other status is a failure
pub val EXIT_SKIP: i32 = 77;

# how a test ran: passed, skipped, disagreed with what it checks, or could not be judged
pub def GateResultKind: u8;

pub val RESULT_PASS:                   GateResultKind = 0;
pub val RESULT_SEMANTIC_MISMATCH:      GateResultKind = 1;
val     RESULT_UNSUPPORTED_INPUT:      GateResultKind = 2;
pub val RESULT_TOOL_UNAVAILABLE:       GateResultKind = 3;
pub val RESULT_INFRASTRUCTURE_FAILURE: GateResultKind = 4;
pub val RESULT_RESOURCE_EXHAUSTION:    GateResultKind = 5;
val     RESULT_INVALID_INJECTION:      GateResultKind = 6;
pub val RESULT_SKIP:                   GateResultKind = 7;

# what decided a result's kind
pub def GateCause: u8;

pub val CAUSE_PASS:                 GateCause = 0;
pub val CAUSE_ORACLE_TIMEOUT:       GateCause = 4;
pub val CAUSE_ORACLE_SPAWN_FAILURE: GateCause = 6;
pub val CAUSE_ORACLE_CAPTURE:       GateCause = 7;
pub val CAUSE_ORACLE_SIGNAL:        GateCause = 8;
pub val CAUSE_ORACLE_EXIT:          GateCause = 9;
pub val CAUSE_INVALID_TERMINAL:     GateCause = 10;
pub val CAUSE_SKIP:                 GateCause = 11;

# one test's result; the tally owns a recorded result's detail
pub rec GateResult {
    kind:            GateResultKind;
    cause:           GateCause;
    detail_identity: str;
}

pub fun gate_result(kind: GateResultKind, cause: GateCause, detail_identity: str) GateResult {
    ret GateResult{kind: kind, cause: cause, detail_identity: detail_identity};
}

pub rec GateTally {
    pass:                   u32;
    semantic_mismatch:      u32;
    unsupported_input:      u32;
    tool_unavailable:       u32;
    infrastructure_failure: u32;
    resource_exhaustion:    u32;
    invalid_injection:      u32;
    skip:                   u32;
    results:                Vector[GateResult];
}

pub fun gate_tally_init(a: *A.Allocator) GateTally {
    var gt: GateTally;
    gt.pass                   = 0;
    gt.semantic_mismatch      = 0;
    gt.unsupported_input      = 0;
    gt.tool_unavailable       = 0;
    gt.infrastructure_failure = 0;
    gt.resource_exhaustion    = 0;
    gt.invalid_injection      = 0;
    gt.skip                   = 0;
    gt.results                = collections_vector.init[GateResult](a);
    ret gt;
}

pub fun record_gate(gt: *GateTally, a: *A.Allocator, r: GateResult) err[A.Error] {
    var stored: GateResult = r;
    if (r.detail_identity != nil) {
        val dup_r: res[str, A.Error] = str_dup(a, r.detail_identity);
        if (sel dup_r.err) { ret err[A.Error].err{dup_r.err}; }
        stored.detail_identity = dup_r.ok;
    }

    val push_r: res[usize, A.Error] = collections_vector.push[GateResult](?gt.results, stored);
    if (sel push_r.err) {
        if (stored.detail_identity != nil) { str_free(a, stored.detail_identity); }
        ret err[A.Error].err{push_r.err};
    }

    if (r.kind == RESULT_PASS)                   { gt.pass = gt.pass + 1; }
    or (r.kind == RESULT_SEMANTIC_MISMATCH)      { gt.semantic_mismatch = gt.semantic_mismatch + 1; }
    or (r.kind == RESULT_UNSUPPORTED_INPUT)      { gt.unsupported_input = gt.unsupported_input + 1; }
    or (r.kind == RESULT_TOOL_UNAVAILABLE)       { gt.tool_unavailable = gt.tool_unavailable + 1; }
    or (r.kind == RESULT_INFRASTRUCTURE_FAILURE) { gt.infrastructure_failure = gt.infrastructure_failure + 1; }
    or (r.kind == RESULT_RESOURCE_EXHAUSTION)    { gt.resource_exhaustion = gt.resource_exhaustion + 1; }
    or (r.kind == RESULT_INVALID_INJECTION)      { gt.invalid_injection = gt.invalid_injection + 1; }
    or (r.kind == RESULT_SKIP)                   { gt.skip = gt.skip + 1; }
    ret err[A.Error].ok{};
}
