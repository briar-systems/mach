# the decorator registry: one row per decorator the language knows, which every
# phase reads by id
#
# the parser decodes each `#[name(...)]` once into the id its name spells, and no
# later phase reads the name again. type checking holds each decorator to its row:
# the count and kind of its arguments, the declarations it stands on, whether it
# may repeat, and whether it is a shader interface role; a rule no row expresses
# is the decorator's own check, keyed by its id. a new decorator is a row here and
# its consumer
#
# a string argument is a constant expression evaluated in its module's comptime
# context: a literal, a `val`, a gated `val`, or an imported constant. the load
# evaluates each once, after its walk has bound every constant, and records the
# string in its own bindings; every later stage reads it there, so resolution,
# type checking, lowering and the link all read one value
use std.types.bool.bool;
use std.text.string.str_free;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use std.allocator.page;
use std.collections.vector.Vector;
use std.print;

use A:                  std.allocator;
use collections_vector: std.collections.vector;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use mach.lang.fe.comptime;
use mach.lang.intern;
use mach.lang.reference;
use lang_source: mach.lang.source;
use mach.lang.textbuild;

pub def Id: u8;

pub val NONE:       Id = 0;
pub val DEPRECATED: Id = 1;
pub val SYMBOL:     Id = 2;
pub val SECTION:    Id = 3;
pub val INLINE:     Id = 4;
pub val NOINLINE:   Id = 5;
pub val ALIGN:      Id = 6;
pub val PACKED:     Id = 7;
pub val VOLATILE:   Id = 8;
pub val LIBRARY:    Id = 9;
pub val OBLIVIOUS:  Id = 10;
pub val SCALAR:     Id = 11;
pub val NAKED:      Id = 12;
pub val EXTENSIONS: Id = 13;
pub val EMBED:      Id = 14;
pub val STAGE:      Id = 15;
pub val WORKGROUP:  Id = 16;
pub val INPUT:      Id = 17;
pub val OUTPUT:     Id = 18;
pub val BUILTIN:    Id = 19;
pub val UNIFORM:    Id = 20;
pub val STORAGE:    Id = 21;
pub val SAMPLER:    Id = 22;
pub val PUSH:       Id = 23;
pub val SPEC:       Id = 24;
pub val SHARED:     Id = 25;
pub val OP:         Id = 26;
pub val HANDLE:     Id = 27;
pub val ABI_TYPE:   Id = 28;
pub val TESTING:    Id = 29;
pub val EXPECT:     Id = 30;

# where a decorator may stand: one bit per declaration kind, one for an `ext`
# import, one for a tag case, and one for every declaration no decorator names.
# PLACES_ANY is every declaration; a tag case admits only a row that names it
pub def Places: u32;

pub val PLACE_USE:   Places = 0x1;
pub val PLACE_FWD:   Places = 0x2;
pub val PLACE_FUN:   Places = 0x4;
pub val PLACE_REC:   Places = 0x8;
pub val PLACE_UNI:   Places = 0x10;
pub val PLACE_TAG:   Places = 0x20;
pub val PLACE_DEF:   Places = 0x40;
pub val PLACE_VAL:   Places = 0x80;
pub val PLACE_VAR:   Places = 0x100;
pub val PLACE_TEST:  Places = 0x200;
pub val PLACE_EXT:   Places = 0x400;
pub val PLACE_CASE:  Places = 0x800;
pub val PLACE_OTHER: Places = 0x1000;
pub val PLACES_ANY:  Places = 0x17FF;

val PLACES_GLOBAL:       Places = PLACE_VAL | PLACE_VAR;
val PLACES_FUN_OR_DATA:  Places = PLACE_FUN | PLACE_VAL | PLACE_VAR;
val PLACES_TYPE:         Places = PLACE_REC | PLACE_UNI | PLACE_TAG;
val PLACES_DECLARATIONS: Places = PLACE_USE | PLACE_FWD | PLACE_FUN | PLACE_REC | PLACE_UNI | PLACE_TAG | PLACE_DEF | PLACE_VAL | PLACE_VAR;

# what a row asks of its decorator beyond its arguments and places
# ---
# FLAG_ONCE:              it stands at most once on a declaration
# FLAG_ROLE:              it gives a module binding a shader interface role, and a binding has one
# FLAG_TESTING_EXCLUSIVE: it names a consumer outside Mach source, which `#[testing]` cannot confine
# FLAG_WORDS:             its arguments are bare names that bind to nothing, never expressions
# FLAG_STRINGS_CHECKED:   its string arguments are checked by the row, not by the decorator's own rule
# FLAG_PLACE_CHECKED:     the decorator refuses a misplacement itself, in a diagnostic of its own kind
pub def Flags: u32;

pub val FLAG_ONCE:              Flags = 0x1;
pub val FLAG_ROLE:              Flags = 0x2;
pub val FLAG_TESTING_EXCLUSIVE: Flags = 0x4;
pub val FLAG_WORDS:             Flags = 0x8;
pub val FLAG_STRINGS_CHECKED:   Flags = 0x10;
pub val FLAG_PLACE_CHECKED:     Flags = 0x20;

# an argument count with no upper bound, and string arguments that run to the last
pub val ARGS_ANY:     u32 = 0xFFFFFFFF;
pub val STRINGS_REST: u32 = 0xFFFFFFFF;

# one decorator
# ---
# places: where it stands, `misplaced` the refusal of anywhere else
# args_min, args_max:           the argument count it takes, `arity` the refusal of any other
# strings_first, strings_count: the arguments that are strings the load records, none when the count is 0
# integers:  one bit per argument the row checks as an integer constant, `argument`
#            the refusal of a string or integer argument of the wrong kind
# duplicate: the refusal of a second one where FLAG_ONCE holds
pub rec Row {
    id:            Id;
    name:          str;
    places:        Places;
    args_min:      u32;
    args_max:      u32;
    strings_first: u32;
    strings_count: u32;
    integers:      u32;
    flags:         Flags;
    arity:         str;
    argument:      str;
    misplaced:     str;
    duplicate:     str;
}

val COUNT: usize      = 30;
val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{id: DEPRECATED, name: "deprecated", places: PLACES_DECLARATIONS | PLACE_CASE, args_min: 0, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_ONCE | FLAG_STRINGS_CHECKED,
        arity:         "`deprecated` takes zero or one string argument", argument: "`deprecated` message must be a string",
        misplaced:     "`deprecated` applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations and tag cases",
        duplicate:     "`deprecated` may appear only once on a declaration"},
    Row{id: SYMBOL, name: "symbol", places: PLACES_FUN_OR_DATA, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`symbol` decorator takes one string argument", argument: "`symbol` decorator argument must be a string",
        misplaced:     "`symbol` decorator applies only to functions and globals", duplicate: nil},
    Row{id: SECTION, name: "section", places: PLACES_FUN_OR_DATA, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`section` decorator takes one string argument", argument: "`section` decorator argument must be a string",
        misplaced:     "`section` decorator applies only to functions and globals", duplicate: nil},
    Row{id: INLINE, name: "inline", places: PLACE_FUN, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`inline` decorator takes no arguments", argument: nil,
        misplaced:     "`inline` decorator applies only to functions", duplicate: nil},
    Row{id: NOINLINE, name: "noinline", places: PLACE_FUN, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`noinline` decorator takes no arguments", argument: nil,
        misplaced:     "`noinline` decorator applies only to functions", duplicate: nil},
    Row{id: ALIGN, name: "align", places: PLACES_FUN_OR_DATA | PLACES_TYPE, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`align` decorator takes one argument", argument: nil,
        misplaced:     "`align` decorator applies only to records, unions, globals, and functions", duplicate: nil},
    Row{id: PACKED, name: "packed", places: PLACES_TYPE, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`packed` decorator takes no arguments", argument: nil,
        misplaced:     "`packed` decorator applies only to records, unions, and tags", duplicate: nil},
    Row{id: VOLATILE, name: "volatile", places: PLACES_TYPE, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`volatile` decorator takes no arguments", argument: nil,
        misplaced:     "`volatile` decorator applies only to records, unions, and tags", duplicate: nil},
    Row{id: LIBRARY, name: "library", places: PLACE_EXT, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_STRINGS_CHECKED,
        arity:         "`library` decorator takes one string argument", argument: "`library` decorator argument must be a string",
        misplaced:     "`library` decorator applies only to ext imports", duplicate: nil},
    Row{id: OBLIVIOUS, name: "oblivious", places: PLACE_FUN, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`oblivious` decorator takes no arguments", argument: nil,
        misplaced:     "`oblivious` decorator applies only to functions", duplicate: nil},
    Row{id: SCALAR, name: "scalar", places: PLACE_FUN, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`scalar` decorator takes no arguments", argument: nil,
        misplaced:     "`scalar` decorator applies only to functions", duplicate: nil},
    Row{id: NAKED, name: "naked", places: PLACE_FUN, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`naked` decorator takes no arguments", argument: nil,
        misplaced:     "`naked` decorator applies only to functions", duplicate: nil},
    Row{id: EXTENSIONS, name: "extensions", places: PLACE_FUN, args_min: 1, args_max: ARGS_ANY,
        strings_first: 0, strings_count: 0, integers: 0, flags: FLAG_WORDS,
        arity:         "`extensions` decorator names at least one extension, as in `#[extensions(sha)]`", argument: nil,
        misplaced:     "`extensions` decorator applies only to functions", duplicate: nil},
    Row{id: EMBED, name: "embed", places: PLACE_VAL, args_min: 0, args_max: ARGS_ANY,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_PLACE_CHECKED,
        arity:         nil, argument: nil, misplaced: nil, duplicate: nil},
    Row{id: STAGE, name: "stage", places: PLACE_FUN, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`stage` decorator takes one string argument", argument: "`stage` decorator argument must be a string",
        misplaced:     "`stage` decorator applies only to functions", duplicate: nil},
    Row{id: WORKGROUP, name: "workgroup", places: PLACE_FUN, args_min: 3, args_max: 3,
        strings_first: 0, strings_count: 0, integers: 0, flags: 0,
        arity:         "`workgroup` decorator takes three arguments: the x, y, and z workgroup dimensions", argument: nil,
        misplaced:     "`workgroup` decorator applies only to functions", duplicate: nil},
    Row{id: INPUT, name: "input", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0x1, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`input` decorator takes one argument: the interface location",
        argument:      "`input` location must be an integer comptime expression",
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: OUTPUT, name: "output", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0x1, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`output` decorator takes one argument: the interface location",
        argument:      "`output` location must be an integer comptime expression",
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: BUILTIN, name: "builtin", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`builtin` decorator takes one string argument", argument: "`builtin` decorator argument must be a string",
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: UNIFORM, name: "uniform", places: PLACES_GLOBAL, args_min: 2, args_max: 2,
        strings_first: 0, strings_count: 0, integers: 0x3, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`uniform` decorator takes two arguments: the descriptor set and the binding",
        argument:      "`uniform` descriptor set and binding must be integer comptime expressions",
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: STORAGE, name: "storage", places: PLACES_GLOBAL, args_min: 2, args_max: ARGS_ANY,
        strings_first: 2, strings_count: STRINGS_REST, integers: 0x3, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`storage` decorator takes the descriptor set and the binding, then its access qualifiers as strings",
        argument:      "`storage` descriptor set and binding must be integer comptime expressions",
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: SAMPLER, name: "sampler", places: PLACES_GLOBAL, args_min: 2, args_max: 2,
        strings_first: 0, strings_count: 0, integers: 0x3, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`sampler` decorator takes two arguments: the descriptor set and the binding",
        argument:      "`sampler` descriptor set and binding must be integer comptime expressions",
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: PUSH, name: "push", places: PLACES_GLOBAL, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`push` decorator takes no arguments: a push-constant block has no descriptor set or binding, the host supplies it with the command that records the dispatch or draw",
        argument:      nil, misplaced: "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: SPEC, name: "spec", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0x1, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`spec` decorator takes one argument: the specialization constant id",
        argument:      "`spec` constant id must be an integer comptime expression",
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: SHARED, name: "shared", places: PLACES_GLOBAL, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: FLAG_ROLE,
        arity:         "`shared` decorator takes no arguments", argument: nil,
        misplaced:     "shader interface decorators apply only to module-level `val` / `var` bindings", duplicate: nil},
    Row{id: OP, name: "op", places: PLACE_FUN, args_min: 3, args_max: 3,
        strings_first: 0, strings_count: 3, integers: 0, flags: FLAG_STRINGS_CHECKED,
        arity:         "`op` decorator takes three string arguments: the target, the instruction set, and the instruction name",
        argument:      "`op` decorator arguments must be strings: the target, the instruction set, and the instruction name",
        misplaced:     "`op` decorator applies only to functions", duplicate: nil},
    Row{id: HANDLE, name: "handle", places: PLACE_DEF, args_min: 0, args_max: ARGS_ANY,
        strings_first: 0, strings_count: 2, integers: 0, flags: FLAG_PLACE_CHECKED,
        arity:         nil, argument: nil, misplaced: nil, duplicate: nil},
    Row{id: ABI_TYPE, name: "abi_type", places: PLACE_DEF, args_min: 0, args_max: ARGS_ANY,
        strings_first: 0, strings_count: 1, integers: 0, flags: FLAG_PLACE_CHECKED,
        arity:         nil, argument: nil, misplaced: nil, duplicate: nil},
    Row{id: TESTING, name: "testing", places: PLACES_DECLARATIONS, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, flags: FLAG_ONCE,
        arity:         "`testing` decorator takes no arguments", argument: nil,
        misplaced:     "`testing` applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations",
        duplicate:     "`testing` may appear only once on a declaration"},
    Row{id: EXPECT, name: "expect", places: PLACE_FUN | PLACES_TYPE | PLACES_GLOBAL | PLACE_TEST, args_min: 1, args_max: ARGS_ANY,
        strings_first: 0, strings_count: STRINGS_REST, integers: 0, flags: FLAG_ONCE,
        arity:         "`expect` names one or more warning keys, such as `#[expect(\"vector.scalarize\")]`", argument: nil,
        misplaced:     "`expect` applies only to fun, rec, uni, tag, val, var and test declarations; a whole module's warnings are silenced by a profile's `allow`",
        duplicate:     "`expect` may appear only once on a declaration; name every key in the one `#[expect(...)]`"},
};

# the row of `id`; nil for NONE and any id no row declares
pub fun row(id: Id) *Row {
    if (id == NONE || id::usize > COUNT) { ret nil; }
    ret ?ROWS[id::usize - 1];
}

# the decorator the name at `name` in `source` spells; NONE when it spells none
pub fun id_of(source: str, name: lang_source.Span) Id {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        if (str_region_equals(source, name.offset, name.len, r.name)) { ret r.id; }
        i = i + 1;
    }
    ret NONE;
}

# the name of `id`; nil for NONE
pub fun name_of(id: Id) str {
    val r: *Row = row(id);
    if (r == nil) { ret nil; }
    ret r.name;
}

# where the declaration `d` stands, for a row's `places`
pub fun places_of(d: *ast_decl.Decl) Places {
    var p: Places = PLACE_OTHER;
    if (d.kind == ast_decl.DECL_KIND_USE)        { p = PLACE_USE; }
    or (d.kind == ast_decl.DECL_KIND_FWD)        { p = PLACE_FWD; }
    or (d.kind == ast_decl.DECL_KIND_FUN)        { p = PLACE_FUN; }
    or (d.kind == ast_decl.DECL_KIND_REC)        { p = PLACE_REC; }
    or (d.kind == ast_decl.DECL_KIND_UNI)        { p = PLACE_UNI; }
    or (d.kind == ast_decl.DECL_KIND_TAG)        { p = PLACE_TAG; }
    or (d.kind == ast_decl.DECL_KIND_DEF)        { p = PLACE_DEF; }
    or (d.kind == ast_decl.DECL_KIND_VAL)        { p = PLACE_VAL; }
    or (d.kind == ast_decl.DECL_KIND_VAR)        { p = PLACE_VAR; }
    or (d.kind == ast_decl.DECL_KIND_TEST)       { p = PLACE_TEST; }
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) { p = p | PLACE_EXT; }
    ret p;
}

# whether `id` may stand on the declaration `d`
pub fun admits(id: Id, d: *ast_decl.Decl) bool {
    val r: *Row = row(id);
    ret r != nil && (r.places & places_of(d)) != 0;
}

# whether `id`'s row carries every one of `flags`
pub fun flagged(id: Id, flags: Flags) bool {
    val r: *Row = row(id);
    ret r != nil && (r.flags & flags) == flags;
}

# the first decorator `id` among the `len` decorators from `start`
pub fun list_get(a: *ast.Ast, start: u32, len: u32, id: Id) opt[*ast_decl.Decorator] {
    var i: u32 = 0;
    for (i < len) {
        val dec: *ast_decl.Decorator = ?a.decorators.data[start + i];
        if (dec.id == id) { ret opt[*ast_decl.Decorator].some{dec}; }
        i = i + 1;
    }
    ret opt[*ast_decl.Decorator].none{};
}

# whether the decorator `id` is among the `len` decorators from `start`
pub fun list_has(a: *ast.Ast, start: u32, len: u32, id: Id) bool {
    val found: opt[*ast_decl.Decorator] = list_get(a, start, len, id);
    ret sel found.some;
}

# the declaration's decorator `id`, the first when it repeats
pub fun get(a: *ast.Ast, d: *ast_decl.Decl, id: Id) opt[*ast_decl.Decorator] {
    ret list_get(a, d.decorators_start, d.decorators_len, id);
}

# whether the declaration carries the decorator `id`
pub fun has(a: *ast.Ast, d: *ast_decl.Decl, id: Id) bool {
    ret list_has(a, d.decorators_start, d.decorators_len, id);
}

# how many of the declaration's decorators carry every one of `flags`
pub fun count_flagged(a: *ast.Ast, d: *ast_decl.Decl, flags: Flags) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < d.decorators_len) {
        if (flagged(a.decorators.data[d.decorators_start + i].id, flags)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# appends the names of the rows that carry every one of `flags` and stand somewhere
# in `places`, `, `-separated in row order. with a `conjunction` each name is quoted
# in backticks and the conjunction precedes the last, as in "`a`, `b`, and `c`"
pub fun names_append(b: *textbuild.TextBuilder, flags: Flags, places: Places, conjunction: str) err[textbuild.Error] {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < COUNT) {
        if (listed(?ROWS[i], flags, places)) { total = total + 1; }
        i = i + 1;
    }
    var n: usize = 0;
    i = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        i = i + 1;
        if (!listed(r, flags, places)) { cnt; }
        var sep: str = "";
        if (n > 0) {
            sep = ", ";
            if (conjunction != nil && total == 2) { sep = " "; }
        }
        val rs: err[textbuild.Error] = textbuild.tb_append(b, sep);
        if (sel rs.err) { ret rs; }
        if (conjunction == nil) {
            val rn: err[textbuild.Error] = textbuild.tb_append(b, r.name);
            if (sel rn.err) { ret rn; }
            n = n + 1;
            cnt;
        }
        if (n > 0 && n + 1 == total) {
            val rc: err[textbuild.Error] = textbuild.tb_append(b, conjunction);
            if (sel rc.err) { ret rc; }
            val rt: err[textbuild.Error] = textbuild.tb_append(b, " ");
            if (sel rt.err) { ret rt; }
        }
        val ro: err[textbuild.Error] = textbuild.tb_append(b, "`");
        if (sel ro.err) { ret ro; }
        val rn: err[textbuild.Error] = textbuild.tb_append(b, r.name);
        if (sel rn.err) { ret rn; }
        val rq: err[textbuild.Error] = textbuild.tb_append(b, "`");
        if (sel rq.err) { ret rq; }
        n = n + 1;
    }
    ret err[textbuild.Error].ok{};
}

fun listed(r: *Row, flags: Flags, places: Places) bool {
    ret (r.flags & flags) == flags && (r.places & places) != 0;
}

# whether argument `ord` of `dec` is a string the load records
pub fun takes_string(dec: *ast_decl.Decorator, ord: u32) bool {
    if (ord >= dec.args_len) { ret false; }
    val r: *Row = row(dec.id);
    if (r == nil || r.strings_count == 0 || ord < r.strings_first) { ret false; }
    ret r.strings_count == STRINGS_REST || ord - r.strings_first < r.strings_count;
}

# the string argument `ord` of `dec` evaluated to in the scope `c`; STR_NIL when it is not a constant string
pub fun string_id(c: *comptime.ComptimeCtx, a: *ast.Ast, dec: *ast_decl.Decorator, ord: u32) intern.StrId {
    if (ord >= dec.args_len) { ret intern.STR_NIL; }
    ret comptime.decorator_string_at(c, a.expr_ids.data[dec.args_start + ord]);
}

# the text of `string_id`
pub fun string_of(itn: *intern.Interner, c: *comptime.ComptimeCtx, a: *ast.Ast, dec: *ast_decl.Decorator, ord: u32) opt[str] {
    val sid: intern.StrId = string_id(c, a, dec, ord);
    if (intern.str_is_nil(sid)) { ret opt[str].none{}; }
    ret intern.get(itn, sid);
}

# records into `into` the string every string argument of a module's decorators evaluates to, with
# the phase's own evaluator over the scope `c`. an argument that is not a constant string is left
# out, and so is a declaration `reached` does not mark, where it marks any
pub fun strings_record[T](itn: *intern.Interner, into: *comptime.ComptimeCtx, a: *ast.Ast, source: str,
    c: *comptime.ComptimeCtx, cap_ctx: *T, caps: comptime.PhaseCapabilities[T], reached: *bool) err[fail.Fail] {
    val root: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel root.none) { ret err[fail.Fail].ok{}; }
    var w: Recorder[T] = Recorder[T]{itn: itn, into: into, a: a, source: source, c: c, cap_ctx: cap_ctx, caps: caps, reached: reached};
    ret record_list[T](?w, root.some.decls_start, root.some.decls_len);
}

rec Recorder[T] {
    itn:     *intern.Interner;
    into:    *comptime.ComptimeCtx;
    a:       *ast.Ast;
    source:  str;
    c:       *comptime.ComptimeCtx;
    cap_ctx: *T;
    caps:    comptime.PhaseCapabilities[T];
    reached: *bool;
}

fun record_list[T](w: *Recorder[T], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: ast_id.DeclId = w.a.decl_ids.data[start + i];
        i = i + 1;
        if (w.reached != nil && !w.reached[ast_id.decl_index(did)]) { cnt; }
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(w.a, did);
        if (sel d_opt.none) { cnt; }
        val d: *ast_decl.Decl = d_opt.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br: *ast_decl.ComptimeBranch = ?w.a.comptime_branches.data[d.data.comptime_if.branches_start + b];
                val r:  err[fail.Fail]           = record_list[T](w, br.body_start, br.body_len);
                if (sel r.err) { ret r; }
                b = b + 1;
            }
            cnt;
        }
        val r: err[fail.Fail] = record_decorators[T](w, d.decorators_start, d.decorators_len);
        if (sel r.err) { ret r; }
        if (d.kind == ast_decl.DECL_KIND_TAG) {
            var k: u32 = 0;
            for (k < d.data.tag_.cases_len) {
                val tc: *ast_decl.TagCase = ?w.a.tag_cases.data[d.data.tag_.cases_start + k];
                val rc: err[fail.Fail]    = record_decorators[T](w, tc.decorators_start, tc.decorators_len);
                if (sel rc.err) { ret rc; }
                k = k + 1;
            }
        }
    }
    ret err[fail.Fail].ok{};
}

fun record_decorators[T](w: *Recorder[T], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val dec: *ast_decl.Decorator = ?w.a.decorators.data[start + i];
        var k:   u32                 = 0;
        for (k < dec.args_len) {
            if (takes_string(dec, k)) {
                val eid: ast_id.ExprId                            = w.a.expr_ids.data[dec.args_start + k];
                val v:   res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[T](w.c, w.cap_ctx, w.caps, w.a, w.source, eid, w.itn);
                if (sel v.err) {
                    if (v.err.kind == comptime.EVAL_FAIL_INTERNAL) { ret err[fail.Fail].err{fail.message(v.err.message)}; }
                    k = k + 1;
                    cnt;
                }
                if (v.ok.kind == comptime.CT_KIND_STR) {
                    val rr: err[fail.Fail] = comptime.decorator_string_set(w.into, eid, v.ok.data.s);
                    if (sel rr.err) { ret rr; }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# every row sits at its id, spells a distinct name the lookup finds, and carries
# the refusal of each check it can fail
test rows__sit_at_their_ids_with_their_refusals {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        if (r.id::usize != i + 1 || row(r.id) != r) { ret 1; }
        val span: lang_source.Span = lang_source.Span{offset: 0, len: str_len(r.name)};
        if (id_of(r.name, span) != r.id) { ret 2; }
        var j: usize = 0;
        for (j < i) {
            if (str_equals(ROWS[j].name, r.name)) { ret 3; }
            j = j + 1;
        }
        if ((r.args_min > 0 || r.args_max != ARGS_ANY) && r.arity == nil)                    { ret 4; }
        if ((r.misplaced == nil) != ((r.flags & FLAG_PLACE_CHECKED) != 0))                   { ret 5; }
        if ((r.flags & FLAG_ONCE) != 0 && r.duplicate == nil)                                { ret 6; }
        if ((r.integers != 0 || (r.flags & FLAG_STRINGS_CHECKED) != 0) && r.argument == nil) { ret 7; }
        if ((r.flags & FLAG_STRINGS_CHECKED) != 0 && r.strings_count == 0)                   { ret 8; }
        i = i + 1;
    }
    if (row(NONE) != nil || row((COUNT + 1)::Id) != nil)                 { ret 9; }
    if (id_of("inlined", lang_source.Span{offset: 0, len: 7}) != NONE)   { ret 10; }
    if (id_of("inlined", lang_source.Span{offset: 0, len: 6}) != INLINE) { ret 11; }
    ret 0;
}

# the string arguments the load records follow each row
test takes_string__follows_the_row {
    var dec: ast_decl.Decorator;
    dec.args_len = 4;
    dec.id       = STORAGE;
    if (takes_string(?dec, 1) || !takes_string(?dec, 2) || !takes_string(?dec, 3)) { ret 1; }
    dec.id = OP;
    if (!takes_string(?dec, 2) || takes_string(?dec, 3)) { ret 2; }
    dec.id = INLINE;
    if (takes_string(?dec, 0)) { ret 3; }
    dec.id = NONE;
    if (takes_string(?dec, 0)) { ret 4; }
    ret 0;
}

# a listing is drawn from the rows, plain or quoted with a conjunction
test names_append__lists_the_rows {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err)                                                                                                                                    { ret 1; }
    if (!t_listing(?alloc, 0, PLACE_CASE, "or", "`deprecated`"))                                                                                         { ret 2; }
    if (!t_listing(?alloc, FLAG_ONCE, PLACE_DEF, "or", "`deprecated` or `testing`"))                                                                     { ret 3; }
    if (!t_listing(?alloc, FLAG_ROLE, PLACES_ANY, "and", "`input`, `output`, `builtin`, `uniform`, `storage`, `sampler`, `push`, `spec`, and `shared`")) { ret 4; }
    if (!t_listing(?alloc, FLAG_ONCE, PLACES_ANY, nil, "deprecated, testing, expect"))                                                                   { ret 5; }
    ret 0;
}

#[testing]
fun t_listing(alloc: *A.Allocator, flags: Flags, places: Places, conjunction: str, want: str) bool {
    var b: textbuild.TextBuilder = textbuild.tb_init(alloc);
    val r: err[textbuild.Error]  = names_append(?b, flags, places, conjunction);
    if (sel r.err) {
        textbuild.tb_dnit(?b);
        ret false;
    }
    val got: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    textbuild.tb_dnit(?b);
    if (sel got.err) { ret false; }
    val same: bool = str_equals(got.ok, want);
    str_free(alloc, got.ok);
    ret same;
}

# the place a word of the applicability table names: a declaration by its keyword,
# `ext` for an `ext` import and `case` for a tag case; 0 for any other word
#[testing]
fun place_named(text: str, w: lang_source.Span) Places {
    if (reference.spells(text, w, "use"))  { ret PLACE_USE; }
    if (reference.spells(text, w, "fwd"))  { ret PLACE_FWD; }
    if (reference.spells(text, w, "fun"))  { ret PLACE_FUN; }
    if (reference.spells(text, w, "rec"))  { ret PLACE_REC; }
    if (reference.spells(text, w, "uni"))  { ret PLACE_UNI; }
    if (reference.spells(text, w, "tag"))  { ret PLACE_TAG; }
    if (reference.spells(text, w, "def"))  { ret PLACE_DEF; }
    if (reference.spells(text, w, "val"))  { ret PLACE_VAL; }
    if (reference.spells(text, w, "var"))  { ret PLACE_VAR; }
    if (reference.spells(text, w, "test")) { ret PLACE_TEST; }
    if (reference.spells(text, w, "ext"))  { ret PLACE_EXT; }
    if (reference.spells(text, w, "case")) { ret PLACE_CASE; }
    ret 0;
}

# the name of the first `#[<name>` in `text` that names no decorator
#[testing]
fun stray(text: str) opt[lang_source.Span] {
    val n:  usize = str_len(text);
    var at: usize = reference.find(text, 0, "#[");
    for (at < n) {
        var e: usize = at + 2;
        for ((text[e] >= 'a' && text[e] <= 'z') || text[e] == '_') { e = e + 1; }
        val name: lang_source.Span = lang_source.Span{offset: at + 2, len: e - at - 2};
        if (name.len > 0 && id_of(text, name) == NONE) { ret opt[lang_source.Span].some{name}; }
        at = reference.find(text, e, "#[");
    }
    ret opt[lang_source.Span].none{};
}

# decorators.md is the registry: its applicability table has a row per decorator
# naming where its row admits it, its grammar block writes every decorator, and
# no page writes a decorator the registry does not hold
test reference__decorators_are_the_registry {
    # one bit per decorator id
    if (COUNT >= 64) { ret 13; }
    var alloc: A.Allocator;
    page.make(?alloc);
    val text: opt[str] = reference.page_or_report(?alloc, "doc/language/decorators.md");
    if (sel text.none) { ret 1; }
    val applicability: opt[lang_source.Span] = reference.section(text.some, "## Applicability");
    if (sel applicability.none) { ret 2; }
    val rows: opt[lang_source.Span] = reference.table(text.some, applicability.some.offset, "| Decorator |");
    if (sel rows.none) { ret 2; }
    var tabled: u64   = 0;
    var at:     usize = rows.some.offset;
    var line:   lang_source.Span;
    for (reference.row_next(text.some, ?at, rows.some.offset + rows.some.len, ?line)) {
        val first: opt[lang_source.Span] = reference.cell(text.some, line, 0);
        if (sel first.none) { ret 3; }
        var c:    usize = first.some.offset;
        var name: lang_source.Span;
        if (!reference.code_next(text.some, ?c, first.some.offset + first.some.len, ?name)) { ret 3; }
        val id: Id = id_of(text.some, name);
        if (id == NONE || (tabled & (1::u64 << id::u64)) != 0) {
            print.eprintlnf("decorators.md applicability: `{}` names no decorator, or is listed twice", reference.spelled(?alloc, text.some, name));
            ret 4;
        }
        tabled = tabled | (1::u64 << id::u64);
        val stands: opt[lang_source.Span] = reference.cell(text.some, line, 1);
        if (sel stands.none) { ret 3; }
        var places: Places = 0;
        var w:      usize  = stands.some.offset;
        var word:   lang_source.Span;
        for (reference.code_next(text.some, ?w, stands.some.offset + stands.some.len, ?word)) {
            val p: Places = place_named(text.some, word);
            if (p == 0) {
                print.eprintlnf("decorators.md applicability: `{}` names no declaration", reference.spelled(?alloc, text.some, word));
                ret 5;
            }
            places = places | p;
        }
        val r:      *Row = row(id);
        val agrees: bool = places == r.places;
        if (!agrees) {
            print.eprintlnf("decorators.md applicability: `{}` does not stand where its registry row admits it", r.name);
            ret 6;
        }
    }

    # the grammar block writes every decorator, and only decorators
    val grammar: opt[lang_source.Span] = reference.section(text.some, "## Grammar");
    if (sel grammar.none) { ret 7; }
    var written: u64   = 0;
    var g:       usize = grammar.some.offset;
    for (g < grammar.some.offset + grammar.some.len) {
        if (str_region_equals(text.some, g, 2, "#[")) {
            var e: usize = g + 2;
            for ((text.some[e] >= 'a' && text.some[e] <= 'z') || text.some[e] == '_') { e = e + 1; }
            val id: Id = id_of(text.some, lang_source.Span{offset: g + 2, len: e - g - 2});
            if (id == NONE) { ret 8; }
            written = written | (1::u64 << id::u64);
        }
        g = reference.line_next(text.some, g);
    }
    var i: usize = 0;
    for (i < COUNT) {
        val bit: u64 = 1::u64 << ROWS[i].id::u64;
        if ((tabled & bit) == 0) {
            print.eprintlnf("decorators.md applicability: `{}` is in the registry and has no row", ROWS[i].name);
            ret 9;
        }
        if ((written & bit) == 0) {
            print.eprintlnf("decorators.md grammar: `{}` is in the registry and not written", ROWS[i].name);
            ret 10;
        }
        i = i + 1;
    }

    val listed: opt[Vector[str]] = reference.pages(?alloc);
    if (sel listed.none) {
        print.eprintln("reference: cannot list the pages");
        ret 11;
    }
    var paths: Vector[str] = listed.some;
    i = 0;
    for (i < paths.len) {
        val path: opt[*str] = collections_vector.get[str](?paths, i);
        i = i + 1;
        if (sel path.none) { ret 11; }
        val page_text: opt[str] = reference.page_or_report(?alloc, @path.some);
        if (sel page_text.none) { ret 11; }
        val bad: opt[lang_source.Span] = stray(page_text.some);
        if (sel bad.some) {
            print.eprintlnf("{}: `#[{}` names no decorator", @path.some, reference.spelled(?alloc, page_text.some, bad.some));
            ret 12;
        }
    }
    ret 0;
}
