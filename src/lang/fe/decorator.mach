# the decorator registry: one row per decorator the language knows, which every
# phase reads by id
#
# the parser decodes each `#[name(...)]` once into the id its name spells, and no
# later phase reads the name again. type checking holds each decorator to its row:
# the count and kind of its arguments, the declarations it stands on, whether it
# may repeat, and whether it is a shader interface role; a rule no row expresses
# is the decorator's own check, keyed by its id. a new decorator is a row here and
# its consumer
#
# a name is lowercase, `snake_case` where it is several words, and dotted only in
# the `gpu.` set, whose generic words apply only to shader stages. every argument
# is a constant expression: a number is an integer, and every name, mode or path
# is a string, so no decorator takes a bare word. a mode is a string argument of
# one decorator, never a sibling decorator, and its row lists the modes it takes
#
# a string argument is a constant expression evaluated in its module's comptime
# context: a literal, a `val`, a gated `val`, or an imported constant. the load
# evaluates each once, after its walk has bound every constant, and records the
# string in its own bindings; every later stage reads it there, so resolution,
# type checking, lowering and the link all read one value
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use mach.lang.fe.comptime;
use mach.lang.intern;
use lang_source: mach.lang.source;
use mach.lang.textbuild;

pub def Id: u8;

pub val NONE:          Id = 0;
pub val DEPRECATED:    Id = 1;
pub val SYMBOL:        Id = 2;
pub val SECTION:       Id = 3;
pub val INLINE:        Id = 4;
pub val EXPORT:        Id = 5;
pub val ALIGN:         Id = 6;
pub val PACKED:        Id = 7;
pub val VOLATILE:      Id = 8;
pub val LIBRARY:       Id = 9;
pub val CONSTANT_TIME: Id = 10;
pub val VECTORIZE:     Id = 11;
pub val NAKED:         Id = 12;
pub val EXTENSION:     Id = 13;
pub val EMBED:         Id = 14;
pub val GPU_STAGE:     Id = 15;
pub val GPU_WORKGROUP: Id = 16;
pub val GPU_INPUT:     Id = 17;
pub val GPU_OUTPUT:    Id = 18;
pub val GPU_BUILTIN:   Id = 19;
pub val GPU_UNIFORM:   Id = 20;
pub val GPU_STORAGE:   Id = 21;
pub val GPU_SAMPLER:   Id = 22;
pub val GPU_PUSH:      Id = 23;
pub val GPU_SPEC:      Id = 24;
pub val GPU_SHARED:    Id = 25;
pub val INTRINSIC:     Id = 26;
pub val HANDLE:        Id = 27;
pub val ABI_TYPE:      Id = 28;
pub val TESTING:       Id = 29;
pub val EXPECT:        Id = 30;
pub val THREAD:        Id = 31;
pub val AT:            Id = 32;
pub val WEAK:          Id = 33;

# where a decorator may stand: one bit per declaration kind, one for an `ext`
# import, one for a tag case, and one for every declaration no decorator names.
# PLACES_ANY is every declaration; a tag case admits only a row that names it
pub def Places: u32;

val     PLACE_USE:   Places = 0x1;
val     PLACE_FWD:   Places = 0x2;
val     PLACE_FUN:   Places = 0x4;
val     PLACE_REC:   Places = 0x8;
val     PLACE_UNI:   Places = 0x10;
val     PLACE_TAG:   Places = 0x20;
val     PLACE_DEF:   Places = 0x40;
val     PLACE_VAL:   Places = 0x80;
val     PLACE_VAR:   Places = 0x100;
val     PLACE_TEST:  Places = 0x200;
val     PLACE_EXT:   Places = 0x400;
pub val PLACE_CASE:  Places = 0x800;
val     PLACE_OTHER: Places = 0x1000;
pub val PLACES_ANY:  Places = 0x17FF;

val PLACES_GLOBAL:       Places = PLACE_VAL | PLACE_VAR;
val PLACES_FUN_OR_DATA:  Places = PLACE_FUN | PLACE_VAL | PLACE_VAR;
val PLACES_TYPE:         Places = PLACE_REC | PLACE_UNI | PLACE_TAG;
val PLACES_DECLARATIONS: Places = PLACE_USE | PLACE_FWD | PLACE_FUN | PLACE_REC | PLACE_UNI | PLACE_TAG | PLACE_DEF | PLACE_VAL | PLACE_VAR;

# what a row asks of its decorator beyond its arguments and places
# ---
# FLAG_ONCE:              it stands at most once on a declaration
# FLAG_ROLE:              it gives a module binding a shader interface role, and a binding has one
# FLAG_TESTING_EXCLUSIVE: it names a consumer outside Mach source, which `#[testing]` cannot confine
# FLAG_STRINGS_CHECKED:   its string arguments are checked by the row, not by the decorator's own rule
# FLAG_PLACE_CHECKED:     the decorator refuses a misplacement itself, in a diagnostic of its own kind
# FLAG_DEFINES:           it supplies the type of a `def` that states none
pub def Flags: u32;

pub val FLAG_ONCE:              Flags = 0x1;
pub val FLAG_ROLE:              Flags = 0x2;
pub val FLAG_TESTING_EXCLUSIVE: Flags = 0x4;
pub val FLAG_STRINGS_CHECKED:   Flags = 0x10;
pub val FLAG_PLACE_CHECKED:     Flags = 0x20;
pub val FLAG_DEFINES:           Flags = 0x40;

# an argument count with no upper bound, and string arguments that run to the last
val ARGS_ANY:     u32 = 0xFFFFFFFF;
val STRINGS_REST: u32 = 0xFFFFFFFF;

# one decorator
# ---
# places: where it stands, `misplaced` the refusal of anywhere else
# args_min, args_max:           the argument count it takes, `arity` the refusal of any other
# strings_first, strings_count: the arguments that are strings the load records, none when the count is 0
# integers:  one bit per argument the row checks as an integer constant, `argument`
#            the refusal of a string or integer argument of the wrong kind
# modes:     the values its first argument may take, `|`-separated, nil when any string is
#            its own; `argument` is the refusal of any other value too
# duplicate: the refusal of a second one where FLAG_ONCE holds
pub rec Row {
    id:            Id;
    name:          str;
    places:        Places;
    args_min:      u32;
    args_max:      u32;
    strings_first: u32;
    strings_count: u32;
    integers:      u32;
    modes:         str;
    flags:         Flags;
    arity:         str;
    argument:      str;
    misplaced:     str;
    duplicate:     str;
}

val SHADER_MISPLACED: str = "shader interface decorators apply only to module-level `val` / `var` bindings";
val BUILTINS:         str = "position|vertex_index|instance_index|frag_coord|point_size|global_invocation|local_invocation|workgroup_id|num_workgroups|local_invocation_index|subgroup_size|subgroup_invocation|subgroup_id|num_subgroups";

val COUNT: usize      = 33;
val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{id: DEPRECATED, name: "deprecated", places: PLACES_DECLARATIONS | PLACE_CASE, args_min: 0, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: nil, flags: FLAG_ONCE | FLAG_STRINGS_CHECKED,
        arity:         "`deprecated` takes zero or one string argument", argument: "`deprecated` message must be a string",
        misplaced:     "`deprecated` applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations and tag cases",
        duplicate:     "`deprecated` may appear only once on a declaration"},
    Row{id: SYMBOL, name: "symbol", places: PLACES_FUN_OR_DATA, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: nil, flags: FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`symbol` decorator takes one string argument", argument: "`symbol` decorator argument must be a string",
        misplaced:     "`symbol` decorator applies only to functions and globals", duplicate: nil},
    Row{id: SECTION, name: "section", places: PLACES_FUN_OR_DATA, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: nil, flags: FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`section` decorator takes one string argument", argument: "`section` decorator argument must be a string",
        misplaced:     "`section` decorator applies only to functions and globals", duplicate: nil},
    Row{id: INLINE, name: "inline", places: PLACE_FUN, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: "always|never", flags: FLAG_ONCE | FLAG_STRINGS_CHECKED,
        arity:         "`inline` takes one string argument, \"always\" or \"never\"; v6's bare `#[inline]` is `#[inline(\"always\")]`",
        argument:      "`inline` takes \"always\" or \"never\"",
        misplaced:     "`inline` decorator applies only to functions",
        duplicate:     "`inline` may appear only once on a function"},
    Row{id: EXPORT, name: "export", places: PLACES_FUN_OR_DATA, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: FLAG_ONCE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`export` takes no arguments", argument: nil,
        misplaced:     "`export` applies only to `pub` functions and globals",
        duplicate:     "`export` may appear only once on a declaration"},
    Row{id: ALIGN, name: "align", places: PLACES_FUN_OR_DATA | PLACES_TYPE, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: 0,
        arity:         "`align` decorator takes one argument", argument: nil,
        misplaced:     "`align` decorator applies only to records, unions, globals, and functions", duplicate: nil},
    Row{id: PACKED, name: "packed", places: PLACES_TYPE, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: 0,
        arity:         "`packed` decorator takes no arguments", argument: nil,
        misplaced:     "`packed` decorator applies only to records, unions, and tags", duplicate: nil},
    Row{id: VOLATILE, name: "volatile", places: PLACES_TYPE, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: 0,
        arity:         "`volatile` decorator takes no arguments", argument: nil,
        misplaced:     "`volatile` decorator applies only to records, unions, and tags", duplicate: nil},
    Row{id: LIBRARY, name: "library", places: PLACE_EXT, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: nil, flags: FLAG_STRINGS_CHECKED,
        arity:         "`library` decorator takes one string argument", argument: "`library` decorator argument must be a string",
        misplaced:     "`library` decorator applies only to ext imports", duplicate: nil},
    Row{id: CONSTANT_TIME, name: "constant_time", places: PLACE_FUN, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: "soft|hard", flags: FLAG_ONCE | FLAG_STRINGS_CHECKED,
        arity:         "`constant_time` takes one string argument, \"soft\" or \"hard\"",
        argument:      "`constant_time` takes \"soft\" or \"hard\"",
        misplaced:     "`constant_time` applies only to functions",
        duplicate:     "`constant_time` may appear only once on a function"},
    Row{id: VECTORIZE, name: "vectorize", places: PLACE_FUN, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: "never", flags: FLAG_ONCE | FLAG_STRINGS_CHECKED,
        arity:         "`vectorize` takes one string argument, \"never\"",
        argument:      "`vectorize` takes \"never\"",
        misplaced:     "`vectorize` applies only to functions",
        duplicate:     "`vectorize` may appear only once on a function"},
    Row{id: NAKED, name: "naked", places: PLACE_FUN, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: 0,
        arity:         "`naked` decorator takes no arguments", argument: nil,
        misplaced:     "`naked` decorator applies only to functions", duplicate: nil},
    Row{id: EXTENSION, name: "extension", places: PLACE_FUN, args_min: 1, args_max: ARGS_ANY,
        strings_first: 0, strings_count: STRINGS_REST, integers: 0, modes: nil, flags: FLAG_ONCE | FLAG_STRINGS_CHECKED,
        arity:         "`extension` names at least one extension, as in `#[extension(\"sha\")]`",
        argument:      "`extension` names each extension as a string, as in `#[extension(\"sha\", \"ssse3\")]`",
        misplaced:     "`extension` applies only to functions",
        duplicate:     "`extension` may appear only once on a function; name every extension in the one `#[extension(...)]`"},
    Row{id: EMBED, name: "embed", places: PLACE_VAL, args_min: 0, args_max: ARGS_ANY,
        strings_first: 0, strings_count: 1, integers: 0, modes: nil, flags: FLAG_PLACE_CHECKED,
        arity:         nil, argument: nil, misplaced: nil, duplicate: nil},
    Row{id: GPU_STAGE, name: "gpu.stage", places: PLACE_FUN, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: "vertex|fragment|compute", flags: FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`gpu.stage` decorator takes one string argument",
        argument:      "`gpu.stage` takes \"vertex\", \"fragment\", or \"compute\"",
        misplaced:     "`gpu.stage` decorator applies only to functions", duplicate: nil},
    Row{id: GPU_WORKGROUP, name: "gpu.workgroup", places: PLACE_FUN, args_min: 3, args_max: 3,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: 0,
        arity:         "`gpu.workgroup` decorator takes three arguments: the x, y, and z workgroup dimensions", argument: nil,
        misplaced:     "`gpu.workgroup` decorator applies only to functions", duplicate: nil},
    Row{id: GPU_INPUT, name: "gpu.input", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0x1, modes: nil, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`gpu.input` decorator takes one argument: the interface location",
        argument:      "`gpu.input` location must be an integer comptime expression",
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_OUTPUT, name: "gpu.output", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0x1, modes: nil, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`gpu.output` decorator takes one argument: the interface location",
        argument:      "`gpu.output` location must be an integer comptime expression",
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_BUILTIN, name: "gpu.builtin", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: BUILTINS, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`gpu.builtin` decorator takes one string argument",
        argument:      "unknown built-in; `gpu.builtin` takes \"position\", \"vertex_index\", \"instance_index\", \"frag_coord\", \"point_size\", \"global_invocation\", \"local_invocation\", \"workgroup_id\", \"num_workgroups\", \"local_invocation_index\", \"subgroup_size\", \"subgroup_invocation\", \"subgroup_id\", or \"num_subgroups\"",
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_UNIFORM, name: "gpu.uniform", places: PLACES_GLOBAL, args_min: 2, args_max: 2,
        strings_first: 0, strings_count: 0, integers: 0x3, modes: nil, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`gpu.uniform` decorator takes two arguments: the descriptor set and the binding",
        argument:      "`gpu.uniform` descriptor set and binding must be integer comptime expressions",
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_STORAGE, name: "gpu.storage", places: PLACES_GLOBAL, args_min: 2, args_max: ARGS_ANY,
        strings_first: 2, strings_count: STRINGS_REST, integers: 0x3, modes: nil, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`gpu.storage` decorator takes the descriptor set and the binding, then its access qualifiers as strings",
        argument:      "`gpu.storage` descriptor set and binding must be integer comptime expressions",
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_SAMPLER, name: "gpu.sampler", places: PLACES_GLOBAL, args_min: 2, args_max: 2,
        strings_first: 0, strings_count: 0, integers: 0x3, modes: nil, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`gpu.sampler` decorator takes two arguments: the descriptor set and the binding",
        argument:      "`gpu.sampler` descriptor set and binding must be integer comptime expressions",
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_PUSH, name: "gpu.push", places: PLACES_GLOBAL, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`gpu.push` decorator takes no arguments: a push-constant block has no descriptor set or binding, the host supplies it with the command that records the dispatch or draw",
        argument:      nil, misplaced: SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_SPEC, name: "gpu.spec", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0x1, modes: nil, flags: FLAG_ROLE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`gpu.spec` decorator takes one argument: the specialization constant id",
        argument:      "`gpu.spec` constant id must be an integer comptime expression",
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: GPU_SHARED, name: "gpu.shared", places: PLACES_GLOBAL, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: FLAG_ROLE,
        arity:         "`gpu.shared` decorator takes no arguments", argument: nil,
        misplaced:     SHADER_MISPLACED, duplicate: nil},
    Row{id: INTRINSIC, name: "intrinsic", places: PLACE_FUN, args_min: 3, args_max: 3,
        strings_first: 0, strings_count: 3, integers: 0, modes: nil, flags: FLAG_STRINGS_CHECKED,
        arity:         "`intrinsic` decorator takes three string arguments: the target, the instruction set, and the instruction name",
        argument:      "`intrinsic` decorator arguments must be strings: the target, the instruction set, and the instruction name",
        misplaced:     "`intrinsic` decorator applies only to functions", duplicate: nil},
    Row{id: HANDLE, name: "handle", places: PLACE_DEF, args_min: 0, args_max: ARGS_ANY,
        strings_first: 0, strings_count: 2, integers: 0, modes: nil, flags: FLAG_PLACE_CHECKED | FLAG_DEFINES,
        arity:         nil, argument: nil, misplaced: nil, duplicate: nil},
    Row{id: ABI_TYPE, name: "abi_type", places: PLACE_DEF, args_min: 0, args_max: ARGS_ANY,
        strings_first: 0, strings_count: 1, integers: 0, modes: nil, flags: FLAG_PLACE_CHECKED | FLAG_DEFINES,
        arity:         nil, argument: nil, misplaced: nil, duplicate: nil},
    Row{id: TESTING, name: "testing", places: PLACES_DECLARATIONS, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: FLAG_ONCE,
        arity:         "`testing` decorator takes no arguments", argument: nil,
        misplaced:     "`testing` applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations",
        duplicate:     "`testing` may appear only once on a declaration"},
    Row{id: EXPECT, name: "expect", places: PLACE_FUN | PLACES_TYPE | PLACES_GLOBAL | PLACE_TEST, args_min: 1, args_max: ARGS_ANY,
        strings_first: 0, strings_count: STRINGS_REST, integers: 0, modes: nil, flags: FLAG_ONCE,
        arity:         "`expect` names one or more warning keys, such as `#[expect(\"vector.scalarize\")]`", argument: nil,
        misplaced:     "`expect` applies only to fun, rec, uni, tag, val, var and test declarations; a whole module's warnings are silenced by a profile's `allow`",
        duplicate:     "`expect` may appear only once on a declaration; name every key in the one `#[expect(...)]`"},
    Row{id: THREAD, name: "thread", places: PLACE_VAR, args_min: 0, args_max: 0,
        strings_first: 0, strings_count: 0, integers: 0, modes: nil, flags: FLAG_ONCE,
        arity:         "`thread` takes no arguments", argument: nil,
        misplaced:     "`thread` applies only to a module-level `var`: each thread holds its own copy, which a `val` would never need",
        duplicate:     "`thread` may appear only once on a declaration"},
    Row{id: AT, name: "at", places: PLACES_GLOBAL, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 0, integers: 0x1, modes: nil, flags: FLAG_ONCE | FLAG_TESTING_EXCLUSIVE,
        arity:         "`at` takes one argument: the offset in the image", argument: "`at` offset must be an integer comptime expression",
        misplaced:     "`at` applies only to module globals",
        duplicate:     "`at` may appear only once on a declaration"},
    Row{id: WEAK, name: "weak", places: PLACE_FUN, args_min: 1, args_max: 1,
        strings_first: 0, strings_count: 1, integers: 0, modes: nil, flags: FLAG_ONCE | FLAG_TESTING_EXCLUSIVE | FLAG_STRINGS_CHECKED,
        arity:         "`weak` takes one string argument: the symbol it defines as a link-time default", argument: "`weak` decorator argument must be a string",
        misplaced:     "`weak` applies only to functions",
        duplicate:     "`weak` may appear only once on a function"},
};

# the row of `id`; nil for NONE and any id no row declares
pub fun row(id: Id) *Row {
    if (id == NONE || id::usize > COUNT) { ret nil; }
    ret ?ROWS[id::usize - 1];
}

# the decorator the name at `name` in `source` spells, this major's or a previous one's;
# NONE when it spells none
pub fun id_of(source: str, name: lang_source.Span) Id {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        if (str_region_equals(source, name.offset, name.len, r.name)) { ret r.id; }
        i = i + 1;
    }
    val previous: *Renamed = renamed_row(source, name, 1);
    if (previous != nil) { ret previous.id; }
    ret NONE;
}

# how a decorator is written: as this major spells it, or in a previous major's spelling,
# which is read with a `decorator.renamed` warning naming its replacement until the
# family's sources use this major's (#4894 makes it a refusal)
# ---
# FORM_V7:    this major's name and arguments
# FORM_SAME:  a previous name with this major's arguments
# FORM_BARE:  a previous flag with no arguments, standing for its row's mode
# FORM_WORDS: a previous name whose arguments are bare names, which bind to nothing
pub def Form: u8;

pub val FORM_V7:    Form = 0;
pub val FORM_SAME:  Form = 1;
pub val FORM_BARE:  Form = 2;
pub val FORM_WORDS: Form = 3;

# a decorator a previous major named, and the name this one gives it
# ---
# from: the name the previous major wrote
# to:   the name that replaces it where the rename is the name alone, which
#       `mach migrate` writes; nil where the arguments change with it
# id:   the decorator it stands for
# form: how its arguments read
# mode: the mode a FORM_BARE spelling stands for, nil for any other
# bare: it is the previous spelling only when written with no arguments
# note: the warning on the previous spelling, which names its replacement
rec Renamed {
    from: str;
    to:   str;
    id:   Id;
    form: Form;
    mode: str;
    bare: bool;
    note: str;
}

val RENAMED_COUNT: usize                  = 18;
val RENAMED:       [RENAMED_COUNT]Renamed = [RENAMED_COUNT]Renamed{
    Renamed{from: "ext", to: nil, id: EXTENSION, form: FORM_WORDS, mode: nil, bare: false, note: "`#[ext(name, ...)]` is `#[extension(\"name\", ...)]` since v7: every argument is a string"},
    Renamed{from: "extensions", to: nil, id: EXTENSION, form: FORM_WORDS, mode: nil, bare: false, note: "`#[extensions(name, ...)]` is `#[extension(\"name\", ...)]` since v7: every argument is a string"},
    Renamed{from: "inline", to: nil, id: INLINE, form: FORM_BARE, mode: "always", bare: true, note: "a bare `#[inline]` is `#[inline(\"always\")]` since v7: a mode is an argument of its decorator"},
    Renamed{from: "noinline", to: nil, id: INLINE, form: FORM_BARE, mode: "never", bare: false, note: "`#[noinline]` is `#[inline(\"never\")]` since v7: a mode is an argument of one decorator"},
    Renamed{from: "scalar", to: nil, id: VECTORIZE, form: FORM_BARE, mode: "never", bare: false, note: "`#[scalar]` is `#[vectorize(\"never\")]` since v7"},
    Renamed{from: "oblivious", to: nil, id: CONSTANT_TIME, form: FORM_BARE, mode: "soft", bare: false, note: "`#[oblivious]` is `#[constant_time(\"soft\")]` or `#[constant_time(\"hard\")]` since v7"},
    Renamed{from: "op", to: "intrinsic", id: INTRINSIC, form: FORM_SAME, mode: nil, bare: false, note: "`#[op(...)]` is `#[intrinsic(...)]` since v7, which `mach migrate` writes"},
    Renamed{from: "stage", to: "gpu.stage", id: GPU_STAGE, form: FORM_SAME, mode: nil, bare: false, note: "`#[stage]` is `#[gpu.stage]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "workgroup", to: "gpu.workgroup", id: GPU_WORKGROUP, form: FORM_SAME, mode: nil, bare: false, note: "`#[workgroup]` is `#[gpu.workgroup]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "input", to: "gpu.input", id: GPU_INPUT, form: FORM_SAME, mode: nil, bare: false, note: "`#[input]` is `#[gpu.input]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "output", to: "gpu.output", id: GPU_OUTPUT, form: FORM_SAME, mode: nil, bare: false, note: "`#[output]` is `#[gpu.output]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "builtin", to: "gpu.builtin", id: GPU_BUILTIN, form: FORM_SAME, mode: nil, bare: false, note: "`#[builtin]` is `#[gpu.builtin]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "uniform", to: "gpu.uniform", id: GPU_UNIFORM, form: FORM_SAME, mode: nil, bare: false, note: "`#[uniform]` is `#[gpu.uniform]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "storage", to: "gpu.storage", id: GPU_STORAGE, form: FORM_SAME, mode: nil, bare: false, note: "`#[storage]` is `#[gpu.storage]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "sampler", to: "gpu.sampler", id: GPU_SAMPLER, form: FORM_SAME, mode: nil, bare: false, note: "`#[sampler]` is `#[gpu.sampler]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "push", to: "gpu.push", id: GPU_PUSH, form: FORM_SAME, mode: nil, bare: false, note: "`#[push]` is `#[gpu.push]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "spec", to: "gpu.spec", id: GPU_SPEC, form: FORM_SAME, mode: nil, bare: false, note: "`#[spec]` is `#[gpu.spec]` since v7, with the same arguments, which `mach migrate` writes"},
    Renamed{from: "shared", to: "gpu.shared", id: GPU_SHARED, form: FORM_SAME, mode: nil, bare: false, note: "`#[shared]` is `#[gpu.shared]` since v7, with the same arguments, which `mach migrate` writes"},
};

# the previous spelling the name at `name` in `source` writes with `args` arguments, nil for none
fun renamed_row(source: str, name: lang_source.Span, args: u32) *Renamed {
    var i: usize = 0;
    for (i < RENAMED_COUNT) {
        val r: *Renamed = ?RENAMED[i];
        i = i + 1;
        if (r.bare && args != 0)                                      { cnt; }
        if (str_region_equals(source, name.offset, name.len, r.from)) { ret r; }
    }
    ret nil;
}

# the name this major gives the decorator the name at `name` in `source`
# spells, nil when no previous major named one so or the rename changes its arguments too
pub fun renamed(source: str, name: lang_source.Span) str {
    val r: *Renamed = renamed_row(source, name, 1);
    if (r == nil) { ret nil; }
    ret r.to;
}

# what `mach migrate` writes for the previous spelling at `name` in `source`
# ---
# name:  the name this major gives it
# mode:  the argument a previous flag stood for, nil for none
# words: its arguments were bare names, which this major writes as strings
pub rec Rewrite {
    name:  str;
    mode:  str;
    words: bool;
}

# the rewrite of the decorator named at `name` in `source` with `args` arguments, nil name
# when it is written as this major spells it
pub fun rewrite_of(source: str, name: lang_source.Span, args: u32) Rewrite {
    val r: *Renamed = renamed_row(source, name, args);
    if (r == nil)    { ret Rewrite{name: nil, mode: nil, words: false}; }
    if (r.to != nil) { ret Rewrite{name: r.to, mode: nil, words: false}; }
    ret Rewrite{name: row(r.id).name, mode: r.mode, words: r.form == FORM_WORDS};
}

# how the decorator named at `name` in `source` with `args` arguments is written
pub fun form_of(source: str, name: lang_source.Span, args: u32) Form {
    val r: *Renamed = renamed_row(source, name, args);
    if (r == nil) { ret FORM_V7; }
    ret r.form;
}

# the warning on the previous spelling `dec` is written in, nil when it is written as
# this major spells it
pub fun renamed_note(source: str, dec: *ast_decl.Decorator) str {
    if (dec.form == FORM_V7) { ret nil; }
    val r: *Renamed = renamed_row(source, dec.name, dec.args_len);
    if (r == nil) { ret nil; }
    ret r.note;
}

# the mode `dec` states: its first argument, or the mode a previous flag stands for
pub fun mode_of(itn: *intern.Interner, c: *comptime.ComptimeCtx, a: *ast.Ast, source: str, dec: *ast_decl.Decorator) opt[str] {
    if (dec.form == FORM_BARE) {
        val r: *Renamed = renamed_row(source, dec.name, dec.args_len);
        if (r == nil || r.mode == nil) { ret opt[str].none{}; }
        ret opt[str].some{r.mode};
    }
    ret string_of(itn, c, a, dec, 0);
}

# the constant-time mode `d` declares, "soft" or "hard", none when it declares none. a previous
# major's bare `#[oblivious]` is "soft". every reader of the mode asks here, so none disagree
pub fun constant_time_mode(itn: *intern.Interner, c: *comptime.ComptimeCtx, a: *ast.Ast, source: str, d: *ast_decl.Decl) opt[str] {
    val dec: opt[*ast_decl.Decorator] = get(a, d, CONSTANT_TIME);
    if (sel dec.none) { ret opt[str].none{}; }
    ret mode_of(itn, c, a, source, dec.some);
}

# the name of `id`; nil for NONE
pub fun name_of(id: Id) str {
    val r: *Row = row(id);
    if (r == nil) { ret nil; }
    ret r.name;
}

# where the declaration `d` stands, for a row's `places`
pub fun places_of(d: *ast_decl.Decl) Places {
    var p: Places = PLACE_OTHER;
    if (d.kind == ast_decl.DECL_KIND_USE)        { p = PLACE_USE; }
    or (d.kind == ast_decl.DECL_KIND_FWD)        { p = PLACE_FWD; }
    or (d.kind == ast_decl.DECL_KIND_FUN)        { p = PLACE_FUN; }
    or (d.kind == ast_decl.DECL_KIND_REC)        { p = PLACE_REC; }
    or (d.kind == ast_decl.DECL_KIND_UNI)        { p = PLACE_UNI; }
    or (d.kind == ast_decl.DECL_KIND_TAG)        { p = PLACE_TAG; }
    or (d.kind == ast_decl.DECL_KIND_DEF)        { p = PLACE_DEF; }
    or (d.kind == ast_decl.DECL_KIND_VAL)        { p = PLACE_VAL; }
    or (d.kind == ast_decl.DECL_KIND_VAR)        { p = PLACE_VAR; }
    or (d.kind == ast_decl.DECL_KIND_TEST)       { p = PLACE_TEST; }
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) { p = p | PLACE_EXT; }
    ret p;
}

# whether `id` may stand on the declaration `d`
pub fun admits(id: Id, d: *ast_decl.Decl) bool {
    val r: *Row = row(id);
    ret r != nil && (r.places & places_of(d)) != 0;
}

# whether `id`'s row carries every one of `flags`
pub fun flagged(id: Id, flags: Flags) bool {
    val r: *Row = row(id);
    ret r != nil && (r.flags & flags) == flags;
}

# whether `value` is one of the `|`-separated `modes`
pub fun mode_admits(modes: str, value: str) bool {
    var start: usize = 0;
    var i:     usize = 0;
    for {
        if (modes[i] == '|' || modes[i] == 0) {
            if (str_region_equals(modes, start, i - start, value)) { ret true; }
            if (modes[i] == 0)                                     { ret false; }
            start = i + 1;
        }
        i = i + 1;
    }
    ret false;
}

# the first decorator `id` among the `len` decorators from `start`
pub fun list_get(a: *ast.Ast, start: u32, len: u32, id: Id) opt[*ast_decl.Decorator] {
    var i: u32 = 0;
    for (i < len) {
        val dec: *ast_decl.Decorator = ?a.decorators.data[start + i];
        if (dec.id == id) { ret opt[*ast_decl.Decorator].some{dec}; }
        i = i + 1;
    }
    ret opt[*ast_decl.Decorator].none{};
}

# whether the decorator `id` is among the `len` decorators from `start`
pub fun list_has(a: *ast.Ast, start: u32, len: u32, id: Id) bool {
    val found: opt[*ast_decl.Decorator] = list_get(a, start, len, id);
    ret sel found.some;
}

# the declaration's decorator `id`, the first when it repeats
pub fun get(a: *ast.Ast, d: *ast_decl.Decl, id: Id) opt[*ast_decl.Decorator] {
    ret list_get(a, d.decorators_start, d.decorators_len, id);
}

# whether the declaration carries the decorator `id`
pub fun has(a: *ast.Ast, d: *ast_decl.Decl, id: Id) bool {
    ret list_has(a, d.decorators_start, d.decorators_len, id);
}

# how many of the declaration's decorators carry every one of `flags`
pub fun count_flagged(a: *ast.Ast, d: *ast_decl.Decl, flags: Flags) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < d.decorators_len) {
        if (flagged(a.decorators.data[d.decorators_start + i].id, flags)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# appends the names of the rows that carry every one of `flags` and stand somewhere
# in `places`, `, `-separated in row order. with a `conjunction` each name is quoted
# in backticks and the conjunction precedes the last, as in "`a`, `b`, and `c`"
pub fun names_append(b: *textbuild.TextBuilder, flags: Flags, places: Places, conjunction: str) err[textbuild.Error] {
    var total: usize = 0;
    var i:     usize = 0;
    for (i < COUNT) {
        if (listed(?ROWS[i], flags, places)) { total = total + 1; }
        i = i + 1;
    }
    var n: usize = 0;
    i = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        i = i + 1;
        if (!listed(r, flags, places)) { cnt; }
        var sep: str = "";
        if (n > 0) {
            sep = ", ";
            if (conjunction != nil && total == 2) { sep = " "; }
        }
        val rs: err[textbuild.Error] = textbuild.tb_append(b, sep);
        if (sel rs.err) { ret rs; }
        if (conjunction == nil) {
            val rn: err[textbuild.Error] = textbuild.tb_append(b, r.name);
            if (sel rn.err) { ret rn; }
            n = n + 1;
            cnt;
        }
        if (n > 0 && n + 1 == total) {
            val rc: err[textbuild.Error] = textbuild.tb_append(b, conjunction);
            if (sel rc.err) { ret rc; }
            val rt: err[textbuild.Error] = textbuild.tb_append(b, " ");
            if (sel rt.err) { ret rt; }
        }
        val ro: err[textbuild.Error] = textbuild.tb_append(b, "`");
        if (sel ro.err) { ret ro; }
        val rn: err[textbuild.Error] = textbuild.tb_append(b, r.name);
        if (sel rn.err) { ret rn; }
        val rq: err[textbuild.Error] = textbuild.tb_append(b, "`");
        if (sel rq.err) { ret rq; }
        n = n + 1;
    }
    ret err[textbuild.Error].ok{};
}

fun listed(r: *Row, flags: Flags, places: Places) bool {
    ret (r.flags & flags) == flags && (r.places & places) != 0;
}

# whether argument `ord` of `dec` is a string the load records
pub fun takes_string(dec: *ast_decl.Decorator, ord: u32) bool {
    if (ord >= dec.args_len || dec.form == FORM_WORDS) { ret false; }
    val r: *Row = row(dec.id);
    if (r == nil || r.strings_count == 0 || ord < r.strings_first) { ret false; }
    ret r.strings_count == STRINGS_REST || ord - r.strings_first < r.strings_count;
}

# the string argument `ord` of `dec` evaluated to in the scope `c`; STR_NIL when it is not a constant string
pub fun string_id(c: *comptime.ComptimeCtx, a: *ast.Ast, dec: *ast_decl.Decorator, ord: u32) intern.StrId {
    if (ord >= dec.args_len) { ret intern.STR_NIL; }
    ret comptime.decorator_string_at(c, a.expr_ids.data[dec.args_start + ord]);
}

# the text of `string_id`
pub fun string_of(itn: *intern.Interner, c: *comptime.ComptimeCtx, a: *ast.Ast, dec: *ast_decl.Decorator, ord: u32) opt[str] {
    val sid: intern.StrId = string_id(c, a, dec, ord);
    if (intern.str_is_nil(sid)) { ret opt[str].none{}; }
    ret intern.get(itn, sid);
}

# records into `into` the string every string argument of a module's decorators evaluates to, with
# the phase's own evaluator over the scope `c`. an argument that is not a constant string is left
# out, and so is a declaration `reached` does not mark, where it marks any
pub fun strings_record[T](itn: *intern.Interner, into: *comptime.ComptimeCtx, a: *ast.Ast, source: str,
    c: *comptime.ComptimeCtx, cap_ctx: *T, caps: comptime.PhaseCapabilities[T], reached: *bool) err[fail.Fail] {
    val root: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel root.none) { ret err[fail.Fail].ok{}; }
    var w: Recorder[T] = Recorder[T]{itn: itn, into: into, a: a, source: source, c: c, cap_ctx: cap_ctx, caps: caps, reached: reached};
    ret record_list[T](?w, root.some.decls_start, root.some.decls_len);
}

rec Recorder[T] {
    itn:     *intern.Interner;
    into:    *comptime.ComptimeCtx;
    a:       *ast.Ast;
    source:  str;
    c:       *comptime.ComptimeCtx;
    cap_ctx: *T;
    caps:    comptime.PhaseCapabilities[T];
    reached: *bool;
}

fun record_list[T](w: *Recorder[T], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: ast_id.DeclId = w.a.decl_ids.data[start + i];
        i = i + 1;
        if (w.reached != nil && !w.reached[ast_id.decl_index(did)]) { cnt; }
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(w.a, did);
        if (sel d_opt.none) { cnt; }
        val d: *ast_decl.Decl = d_opt.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br: *ast_decl.ComptimeBranch = ?w.a.comptime_branches.data[d.data.comptime_if.branches_start + b];
                val r:  err[fail.Fail]           = record_list[T](w, br.body_start, br.body_len);
                if (sel r.err) { ret r; }
                b = b + 1;
            }
            cnt;
        }
        val r: err[fail.Fail] = record_decorators[T](w, d.decorators_start, d.decorators_len);
        if (sel r.err) { ret r; }
        if (d.kind == ast_decl.DECL_KIND_TAG) {
            var k: u32 = 0;
            for (k < d.data.tag_.cases_len) {
                val tc: *ast_decl.TagCase = ?w.a.tag_cases.data[d.data.tag_.cases_start + k];
                val rc: err[fail.Fail]    = record_decorators[T](w, tc.decorators_start, tc.decorators_len);
                if (sel rc.err) { ret rc; }
                k = k + 1;
            }
        }
    }
    ret err[fail.Fail].ok{};
}

fun record_decorators[T](w: *Recorder[T], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val dec: *ast_decl.Decorator = ?w.a.decorators.data[start + i];
        var k:   u32                 = 0;
        for (k < dec.args_len) {
            if (takes_string(dec, k)) {
                val eid: ast_id.ExprId                            = w.a.expr_ids.data[dec.args_start + k];
                val v:   res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[T](w.c, w.cap_ctx, w.caps, w.a, w.source, eid, w.itn);
                if (sel v.err) {
                    if (v.err.kind == comptime.EVAL_FAIL_INTERNAL) { ret err[fail.Fail].err{fail.message(v.err.message)}; }
                    k = k + 1;
                    cnt;
                }
                if (v.ok.kind == comptime.CT_KIND_STR) {
                    val rr: err[fail.Fail] = comptime.decorator_string_set(w.into, eid, v.ok.data.s);
                    if (sel rr.err) { ret rr; }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
