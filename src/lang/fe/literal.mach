# scanning and decoding a literal's spelling: the value an integer, float, character or
# string literal names and the suffix it carries, or why it does not scan
use encoding_hex:    std.encoding.hex;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use ast_expr: mach.lang.fe.ast.expr;
use mach.lang.float;
use lang_source: mach.lang.source;
use mach.lang.type;
use mach.lang.wide;
use std.math.bignum;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view;

pub rec Int {
    value:    wide.Wide;
    suffix:   type.TypeKind;
    in_range: bool;
}

pub rec Float {
    value:  f64;
    suffix: type.TypeKind;
}

# why a literal does not scan: the diagnostic it reports and what it says
pub rec Refusal {
    diag:    diagnostic_kind.Kind;
    message: str;
}

val SUFFIX_INT_MSG: str =
    "unknown integer literal suffix: an integer literal takes `u8`, `u16`, `u32`, `u64`, `u128`, `i8`, `i16`, `i32`, `i64`, or `i128`; a float literal carries a fractional part or an exponent (`1.0f32`)";

val SUFFIX_FLOAT_MSG: str =
    "unknown float literal suffix: a float literal takes `f16`, `f32` or `f64`";

pub val SUFFIX_RANGE_MSG: str =
    "integer literal is out of range for the type its suffix declares";

# a literal the scanner refuses, keyed by why
fun refused(diag: diagnostic_kind.Kind, message: str) Refusal {
    ret Refusal{diag: diag, message: message};
}

fun suffix_scan(text: View, start: usize, want: type.PrimClass, unknown: str) res[type.TypeKind, Refusal] {
    if (start >= text.len) { ret res[type.TypeKind, Refusal].ok{ast_expr.LIT_SUFFIX_NONE}; }
    val k_opt: opt[type.TypeKind] = type.prim_from_view(view(?text.data[start], text.len - start));
    if (!sel k_opt.some) { ret res[type.TypeKind, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, unknown)}; }
    val k: type.TypeKind = k_opt.some;
    if (type.prim_desc(k).class != want) { ret res[type.TypeKind, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, unknown)}; }
    ret res[type.TypeKind, Refusal].ok{k};
}

pub fun int_scan(source: str, span: lang_source.Span) res[Int, Refusal] {
    val text: View = lang_source.span_view(source, span);
    if (text.len == 0) { ret res[Int, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "empty integer literal")}; }

    var i:    usize = 0;
    var base: i64   = 10;

    if (text.len >= 2 && text.data[0] == '0') {
        if (text.data[1] == 'x') {
            base = 16;
            i    = 2;
        }
        or (text.data[1] == 'b') {
            base = 2;
            i    = 2;
        }
        or (text.data[1] == 'o') {
            base = 8;
            i    = 2;
        }
    }

    val base_u:    u64       = base:~u64;
    var value:     wide.Wide = wide.zero();
    var saw_digit: bool      = false;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == '_') {
            i = i + 1;
            cnt;
        }

        var digit: i64 = 0 - 1;
        if (c >= '0' && c <= '9') { digit = (c - '0')::i64; }
        or (c >= 'a' && c <= 'f') { digit = (c - 'a')::i64 + 10; }
        or (c >= 'A' && c <= 'F') { digit = (c - 'A')::i64 + 10; }

        if (digit >= 0 && digit < base) {
            var overflow: bool = false;
            value = wide.mul_add_small(value, base_u, digit:~u64, ?overflow);
            if (overflow) {
                ret res[Int, Refusal].err{refused(diagnostic_kind.LITERAL_OUT_OF_RANGE, "integer literal out of range")};
            }
            saw_digit = true;
            i         = i + 1;
        }
        or (c == 'u' || c == 'i' || c == 'f') {
            brk;
        }
        or {
            if (base == 16) { ret res[Int, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "invalid digit in hexadecimal literal (expected 0-9, a-f, A-F)")}; }
            if (base == 2)  { ret res[Int, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "invalid digit in binary literal (expected 0 or 1)")}; }
            if (base == 8)  { ret res[Int, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "invalid digit in octal literal (expected 0-7)")}; }
            ret res[Int, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "invalid digit in decimal literal (expected 0-9)")};
        }
    }

    if (!saw_digit) { ret res[Int, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "integer literal has no digits")}; }

    val sfx_r: res[type.TypeKind, Refusal] = suffix_scan(text, i, type.PRIM_CLASS_INT, SUFFIX_INT_MSG);
    if (sel sfx_r.err) { ret res[Int, Refusal].err{sfx_r.err}; }
    val sfx: type.TypeKind = sfx_r.ok;

    var lit: Int;
    lit.value    = value;
    lit.suffix   = sfx;
    lit.in_range = sfx == ast_expr.LIT_SUFFIX_NONE || type.int_fits_either_sign(value, sfx);
    ret res[Int, Refusal].ok{lit};
}

# a float literal's decimal: its significant digits as an integer, the exponent of the last,
# whether a nonzero digit past MAX_SIG_DIGITS was dropped, and its suffix
rec Decimal {
    mant:   bignum.Big;
    exp10:  i64;
    trunc:  bool;
    suffix: type.TypeKind;
}

fun decimal_scan(source: str, span: lang_source.Span, out: *Decimal) err[Refusal] {
    val text: View = lang_source.span_view(source, span);
    if (text.len == 0) { ret err[Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "empty float literal")}; }

    bignum.from_u64(?out.mant, 0);
    var dexp:           i64  = 0;
    var sig:            i64  = 0;
    var trunc:          bool = false;
    var saw_digit:      bool = false;
    val MAX_SIG_DIGITS: i64  = 768;

    var i: usize = 0;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == '_') {
            i = i + 1;
            cnt;
        }
        if (c == '.')             { brk; }
        if (c == 'e' || c == 'E') { brk; }
        if (c == 'f')             { brk; }
        if (c < '0' || c > '9')   { ret err[Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "invalid character in float literal")}; }
        saw_digit = true;
        if (sig < MAX_SIG_DIGITS) {
            bignum.mul_small(?out.mant, 10);
            bignum.add_small(?out.mant, (c - '0')::u32);
            if (!bignum.is_zero(?out.mant)) { sig = sig + 1; }
        }
        or {
            dexp = dexp + 1;
            if (c != '0') { trunc = true; }
        }
        i = i + 1;
    }

    if (i < text.len && text.data[i] == '.') {
        i = i + 1;
        for (i < text.len) {
            val c: u8 = text.data[i];
            if (c == '_') {
                i = i + 1;
                cnt;
            }
            if (c == 'e' || c == 'E') { brk; }
            if (c == 'f')             { brk; }
            if (c < '0' || c > '9')   { ret err[Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "invalid character in float literal")}; }
            saw_digit = true;
            if (sig < MAX_SIG_DIGITS) {
                bignum.mul_small(?out.mant, 10);
                bignum.add_small(?out.mant, (c - '0')::u32);
                if (!bignum.is_zero(?out.mant)) { sig = sig + 1; }
                dexp = dexp - 1;
            }
            or {
                if (c != '0') { trunc = true; }
            }
            i = i + 1;
        }
    }

    var exp: i64 = 0;
    if (i < text.len && (text.data[i] == 'e' || text.data[i] == 'E')) {
        i = i + 1;
        var neg: bool = false;
        if (i < text.len && text.data[i] == '-') {
            neg = true;
            i   = i + 1;
        }
        or (i < text.len && text.data[i] == '+') { i = i + 1; }

        var saw_exp_digit: bool = false;
        for (i < text.len) {
            val c: u8 = text.data[i];
            if (c == 'f') { brk; }
            if (c == '_') {
                i = i + 1;
                cnt;
            }
            if (c < '0' || c > '9') { ret err[Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "invalid character in float exponent")}; }
            if (exp < 1000000)      { exp = exp * 10 + (c - '0')::i64; }
            saw_exp_digit = true;
            i             = i + 1;
        }
        if (!saw_exp_digit) { ret err[Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "missing digits in float exponent")}; }
        if (neg)            { exp = 0 - exp; }
    }

    if (!saw_digit) { ret err[Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "float literal has no digits")}; }

    val sfx_r: res[type.TypeKind, Refusal] = suffix_scan(text, i, type.PRIM_CLASS_FLOAT, SUFFIX_FLOAT_MSG);
    if (sel sfx_r.err) { ret err[Refusal].err{sfx_r.err}; }

    out.exp10  = dexp + exp;
    out.trunc  = trunc;
    out.suffix = sfx_r.ok;
    ret err[Refusal].ok{};
}

# a literal's value at the width its suffix names, binary64 when it has none
pub fun float_scan(source: str, span: lang_source.Span) res[Float, Refusal] {
    var d:       Decimal;
    val scanned: err[Refusal] = decimal_scan(source, span, ?d);
    if (sel scanned.err) { ret res[Float, Refusal].err{scanned.err}; }
    var lit: Float;
    lit.value  = float.round_decimal(?d.mant, d.exp10, d.trunc, type.float_width_of(d.suffix)).value;
    lit.suffix = d.suffix;
    ret res[Float, Refusal].ok{lit};
}

# a literal rounded once its type is known: at its suffix's width when it has one, else at
# `w`, the width its context gives it. every consumer of a literal's value, the parser, the
# comptime evaluator, lowering, and the rule sema applies, reads it from here
# ---
# source: the text the span indexes
# span:   the literal's token
# w:      the width of the literal's type
# ret:    the rounded value and how it fit, or the scan's refusal
pub fun float_at(source: str, span: lang_source.Span, w: float.FloatWidth) res[float.Rounded, fail.Fail] {
    var d:       Decimal;
    val scanned: err[Refusal] = decimal_scan(source, span, ?d);
    if (sel scanned.err) { ret res[float.Rounded, fail.Fail].err{fail.message(scanned.err.message)}; }
    var at: float.FloatWidth = w;
    if (d.suffix != ast_expr.LIT_SUFFIX_NONE) { at = type.float_width_of(d.suffix); }
    ret res[float.Rounded, fail.Fail].ok{float.round_decimal(?d.mant, d.exp10, d.trunc, at)};
}

# true when the literal's significant digits, leading and trailing zeros and exponent
# spelling aside, are exactly the shortest decimal that rounds back to `s`
pub fun float_spells(source: str, span: lang_source.Span, s: *float.Shortest) bool {
    val text:       View  = lang_source.span_view(source, span);
    var int_digits: i64   = 0;
    var seen_point: bool  = false;
    var first:      i64   = -1;
    var last:       i64   = -1;
    var n:          i64   = 0;
    var i:          usize = 0;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == 'e' || c == 'E' || c == 'f') { brk; }
        if (c == '.')                         { seen_point = true; }
        or (c >= '0' && c <= '9') {
            if (c != '0') {
                if (first < 0) { first = n; }
                last = n;
            }
            if (!seen_point) { int_digits = int_digits + 1; }
            n = n + 1;
        }
        i = i + 1;
    }
    if (first < 0) { ret false; }
    var exp: i64  = 0;
    var neg: bool = false;
    if (i < text.len && (text.data[i] == 'e' || text.data[i] == 'E')) {
        i = i + 1;
        if (i < text.len && text.data[i] == '-') {
            neg = true;
            i   = i + 1;
        }
        or (i < text.len && text.data[i] == '+') { i = i + 1; }
        for (i < text.len && text.data[i] != 'f') {
            val c: u8 = text.data[i];
            if (c >= '0' && c <= '9' && exp < 1000000) { exp = exp * 10 + (c - '0')::i64; }
            i = i + 1;
        }
        if (neg) { exp = 0 - exp; }
    }
    if (last - first + 1 != s.len::i64)      { ret false; }
    if (int_digits - first + exp != s.exp10) { ret false; }
    var k: i64 = 0;
    i = 0;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == 'e' || c == 'E' || c == 'f') { brk; }
        if (c >= '0' && c <= '9') {
            if (k >= first && k <= last && (c - '0') != s.digits[(k - first)::usize]) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

# the byte a character literal names
pub fun char_scan(source: str, span: lang_source.Span) res[u8, Refusal] {
    val text: View = lang_source.span_view(source, span);
    if (text.len < 3) { ret res[u8, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "malformed character literal")}; }
    if (text.data[0] != '\'' || text.data[text.len - 1] != '\'') {
        ret res[u8, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "character literal not delimited by single quotes")};
    }
    val r: res[u8, fail.Fail] = char_decode(view(?text.data[1], text.len - 2));
    if (sel r.err) { ret res[u8, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, fail.describe(r.err))}; }
    ret res[u8, Refusal].ok{r.ok};
}

# the bytes a string literal names, its escapes decoded, written to `out`
# ---
# source: the text the span indexes
# span:   the literal's token
# out:    room for at least span.len bytes
# ret:    how many bytes were written, or why the literal does not scan
pub fun str_scan(source: str, span: lang_source.Span, out: *u8) res[usize, Refusal] {
    val text: View = lang_source.span_view(source, span);
    if (text.len < 2 || text.data[0] != '"' || text.data[text.len - 1] != '"') {
        ret res[usize, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, "string literal not delimited by double quotes")};
    }
    val inner: View  = view(?text.data[1], text.len - 2);
    var read:  usize = 0;
    var write: usize = 0;
    for (read < inner.len) {
        val c: u8 = inner.data[read];
        if (c != '\\') {
            out[write] = c;
            read       = read + 1;
            write      = write + 1;
            cnt;
        }
        var consumed: usize              = 0;
        val r:        res[u8, fail.Fail] = escape_decode((?inner.data[read])::*u8, inner.len - read, ?consumed);
        if (sel r.err) { ret res[usize, Refusal].err{refused(diagnostic_kind.LITERAL_MALFORMED, fail.describe(r.err))}; }
        out[write] = r.ok;
        read       = read + consumed;
        write      = write + 1;
    }
    ret res[usize, Refusal].ok{write};
}

fun char_decode(inner: View) res[u8, fail.Fail] {
    if (inner.len == 0) { ret res[u8, fail.Fail].err{fail.message("empty character literal; must contain exactly one character or escape")}; }
    if (inner.data[0] != '\\') {
        if (inner.len != 1) { ret res[u8, fail.Fail].err{fail.message("character literal must contain exactly one character")}; }
        ret res[u8, fail.Fail].ok{inner.data[0]};
    }
    var consumed: usize              = 0;
    val r:        res[u8, fail.Fail] = escape_decode(inner.data::*u8, inner.len, ?consumed);
    if (sel r.err) { ret r; }
    if (consumed != inner.len) {
        ret res[u8, fail.Fail].err{fail.message("character literal must contain exactly one escape sequence")};
    }
    ret r;
}

fun escape_decode(p: *u8, len: usize, out_consumed: *usize) res[u8, fail.Fail] {
    if (len < 2) { ret res[u8, fail.Fail].err{fail.message("incomplete escape sequence")}; }
    val c: u8 = p[1];

    if (c == 'n') {
        @out_consumed = 2;
        ret res[u8, fail.Fail].ok{10};
    }
    if (c == 't') {
        @out_consumed = 2;
        ret res[u8, fail.Fail].ok{9};
    }
    if (c == 'r') {
        @out_consumed = 2;
        ret res[u8, fail.Fail].ok{13};
    }
    if (c == '\\') {
        @out_consumed = 2;
        ret res[u8, fail.Fail].ok{92};
    }
    if (c == '\'') {
        @out_consumed = 2;
        ret res[u8, fail.Fail].ok{39};
    }
    if (c == '"') {
        @out_consumed = 2;
        ret res[u8, fail.Fail].ok{34};
    }
    if (c == '0') {
        @out_consumed = 2;
        ret res[u8, fail.Fail].ok{0};
    }
    if (c == 'x') {
        if (len < 4) { ret res[u8, fail.Fail].err{fail.message("incomplete \\x escape")}; }
        var byte: u8 = 0;
        if (encoding_hex.decode(?p[2], 2, ?byte, 1) != 1) { ret res[u8, fail.Fail].err{fail.message("invalid \\x escape")}; }
        @out_consumed = 4;
        ret res[u8, fail.Fail].ok{byte};
    }
    ret res[u8, fail.Fail].err{fail.message("unknown escape sequence (valid: \\n \\t \\r \\\\ \\' \\\" \\0 \\xHH)")};
}

# 0 when the literal fails to scan, 1 when its suffix range holds it, 2 otherwise
#[testing]
fun t_lit_range(text: str) u8 {
    val r: res[Int, Refusal] = t_scan_int(text);
    if (sel r.err)     { ret 0; }
    if (r.ok.in_range) { ret 1; }
    ret 2;
}

test scan_lit_int__in_range_uses_the_128_bit_catalog_width {
    if (t_lit_range("0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFu128") != 1) { ret 1; }
    if (t_lit_range("0x80000000000000000000000000000000i128") != 1) { ret 2; }
    if (t_lit_range("0x80000000000000000000000000000001i128") != 2) { ret 3; }
    if (t_lit_range("18446744073709551616u64") != 2)                { ret 4; }
    if (t_lit_range("18446744073709551616i128") != 1)               { ret 5; }
    ret 0;
}

#[testing]
pub fun t_scan_int(s: str) res[Int, Refusal] {
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret int_scan(s, span);
}

#[testing]
fun t_suffix_of(s: str) type.TypeKind {
    val r: res[Int, Refusal] = t_scan_int(s);
    if (sel r.err) { ret ast_expr.LIT_SUFFIX_NONE; }
    ret r.ok.suffix;
}

test scan_lit_int__suffix_names_a_primitive_type {
    if (t_suffix_of("7u8") != type.TYPE_U8)              { ret 1; }
    if (t_suffix_of("7i64") != type.TYPE_I64)            { ret 8; }
    if (t_suffix_of("7") != ast_expr.LIT_SUFFIX_NONE)    { ret 9; }
    if (t_suffix_of("0xFFu8") != type.TYPE_U8)           { ret 10; }
    if (t_suffix_of("0b1010u16") != type.TYPE_U16)       { ret 11; }
    if (t_suffix_of("0o755u32") != type.TYPE_U32)        { ret 12; }
    if (t_suffix_of("0xFF") != ast_expr.LIT_SUFFIX_NONE) { ret 13; }

    val r: res[Int, Refusal] = t_scan_int("255u8");
    if (sel r.err)                                { ret 14; }
    if (!wide.eq(r.ok.value, wide.from_u64(255))) { ret 15; }
    if (!r.ok.in_range)                           { ret 16; }
    ret 0;
}

test scan_lit_int__unknown_suffix_rejected {
    val t_scan_int_1: res[Int, Refusal] = t_scan_int("7u7");
    if (sel t_scan_int_1.ok) { ret 1; }
    val t_scan_int_2: res[Int, Refusal] = t_scan_int("7u");
    if (sel t_scan_int_2.ok) { ret 2; }
    val t_scan_int_4: res[Int, Refusal] = t_scan_int("1f32");
    if (sel t_scan_int_4.ok) { ret 4; }
    val t_scan_int_5: res[Int, Refusal] = t_scan_int("7u128");
    if (sel t_scan_int_5.err)                     { ret 5; }
    if (t_scan_int_5.ok.suffix != type.TYPE_U128) { ret 5; }
    val t_scan_int_6: res[Int, Refusal] = t_scan_int("7i128");
    if (sel t_scan_int_6.err)                     { ret 6; }
    if (t_scan_int_6.ok.suffix != type.TYPE_I128) { ret 6; }
    ret 0;
}

# every integer spelling in the catalog is named by the suffix refusal, so a new
# width cannot be accepted by the scanner and missing from the message
test lit_suffix_int_msg__names_every_catalog_integer {
    var buf: [8]u8;
    var k:   u32 = 0;
    for (k < type.PRIM_COUNT) {
        val kind: type.TypeKind = type.prim_kind_at(k);
        if (type.prim_desc(kind).class == type.PRIM_CLASS_INT) {
            val name: str   = type.prim_name(kind);
            val n:    usize = str_len(name);
            buf[0] = '`';
            var i: usize = 0;
            for (i < n) {
                buf[1 + i] = name[i];
                i          = i + 1;
            }
            buf[1 + n] = '`';
            buf[2 + n] = 0;
            if (!str_contains(SUFFIX_INT_MSG, (?buf[0])::str)) { ret 1; }
        }
        k = k + 1;
    }
    ret 0;
}

#[testing]
pub fun t_scan_float(s: str) res[Float, Refusal] {
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret float_scan(s, span);
}

test scan_lit_float__suffix_names_the_float_width {
    val t_scan_float_1: res[Float, Refusal] = t_scan_float("1.5f32");
    if (!sel t_scan_float_1.ok) { ret 1; }
    val a: Float = t_scan_float_1.ok;
    if (a.suffix != type.TYPE_F32) { ret 1; }
    val t_scan_float_2: res[Float, Refusal] = t_scan_float("1.5f64");
    if (!sel t_scan_float_2.ok) { ret 1; }
    val b: Float = t_scan_float_2.ok;
    if (b.suffix != type.TYPE_F64) { ret 2; }
    val t_scan_float_3: res[Float, Refusal] = t_scan_float("1.5");
    if (!sel t_scan_float_3.ok) { ret 1; }
    val c: Float = t_scan_float_3.ok;
    if (c.suffix != ast_expr.LIT_SUFFIX_NONE) { ret 3; }

    val t_scan_float_4: res[Float, Refusal] = t_scan_float("1.5f8");
    if (sel t_scan_float_4.ok) { ret 4; }
    val t_scan_float_7: res[Float, Refusal] = t_scan_float("0.1f16");
    if (!sel t_scan_float_7.ok)                                        { ret 7; }
    if (t_scan_float_7.ok.suffix != type.TYPE_F16)                     { ret 7; }
    if (float.f64_bits(t_scan_float_7.ok.value) != 0x3FB9980000000000) { ret 8; }
    val t_scan_float_5: res[Float, Refusal] = t_scan_float("1.5f");
    if (sel t_scan_float_5.ok) { ret 5; }
    val t_scan_float_6: res[Float, Refusal] = t_scan_float("1.5u32");
    if (sel t_scan_float_6.ok) { ret 6; }
    ret 0;
}

#[testing]
fun t_at(s: str, w: float.FloatWidth) float.Rounded {
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = str_len(s);
    val r: res[float.Rounded, fail.Fail] = float_at(s, span, w);
    if (sel r.err) { ret float.Rounded{value: 0.0, fit: 255}; }
    ret r.ok;
}

#[testing]
fun t_spells(s: str, w: float.FloatWidth, text: str) bool {
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = str_len(s);
    var sh:  float.Shortest = float.shortest(t_at(s, w).value, w);
    var buf: [float.SHORTEST_TEXT_CAP]u8;
    if (!str_equals(float.shortest_text(?sh, ?buf[0]), text)) { ret false; }
    ret float_spells(s, span, ?sh);
}

test lit_float_at__rounds_once_and_classifies_the_fit {
    # through binary64 this lands on a binary32 tie and rounds to even; rounded once it rounds up
    val once: float.Rounded = t_at("1.000000059604644775390625000001", float.FLOAT_W_32);
    if (float.f64_to_f32_bits(float.f64_bits(once.value)) != 0x3F800001 || once.fit != float.FIT_INEXACT) { ret 1; }
    if (t_at("0.0", float.FLOAT_W_32).fit != float.FIT_EXACT)                                             { ret 2; }
    if (t_at("2147483648.0", float.FLOAT_W_32).fit != float.FIT_EXACT)                                    { ret 3; }
    if (t_at("0.1", float.FLOAT_W_32).fit != float.FIT_INEXACT)                                           { ret 4; }
    if (t_at("1.0e39", float.FLOAT_W_32).fit != float.FIT_OVERFLOW)                                       { ret 5; }
    if (t_at("1.0e39", float.FLOAT_W_64).fit != float.FIT_INEXACT)                                        { ret 6; }
    if (t_at("340282356779733661637539395458142568448.0", float.FLOAT_W_32).fit != float.FIT_OVERFLOW)    { ret 7; }
    if (t_at("340282356779733661637539395458142568447.0", float.FLOAT_W_32).fit != float.FIT_INEXACT)     { ret 8; }
    if (t_at("1.0e-46", float.FLOAT_W_32).fit != float.FIT_UNDERFLOW)                                     { ret 9; }
    if (t_at("1.0e-45", float.FLOAT_W_32).fit != float.FIT_INEXACT)                                       { ret 10; }
    if (t_at("1.0e309", float.FLOAT_W_64).fit != float.FIT_OVERFLOW)                                      { ret 11; }
    if (t_at("1.0e-330", float.FLOAT_W_64).fit != float.FIT_UNDERFLOW)                                    { ret 12; }
    if (t_at("1.0e-46f64", float.FLOAT_W_32).fit != float.FIT_INEXACT)                                    { ret 13; }
    ret 0;
}

test lit_float_spells__compares_with_the_shortest_round_trip {
    if (!t_spells("0.1", float.FLOAT_W_32, "0.1"))                           { ret 1; }
    if (!t_spells("1.0e-1", float.FLOAT_W_32, "0.1"))                        { ret 2; }
    if (!t_spells("0.100_000", float.FLOAT_W_32, "0.1"))                     { ret 3; }
    if (t_spells("3.14159265358979", float.FLOAT_W_32, "3.1415927"))         { ret 4; }
    if (!t_spells("3.1415927", float.FLOAT_W_32, "3.1415927"))               { ret 5; }
    if (t_spells("2147483648.0", float.FLOAT_W_32, "2147483600.0"))          { ret 6; }
    if (!t_spells("3.14159265358979", float.FLOAT_W_64, "3.14159265358979")) { ret 7; }
    if (!t_spells("1.0e-45", float.FLOAT_W_32, "1.0e-45"))                   { ret 8; }
    if (!t_spells("5.0e-324", float.FLOAT_W_64, "5.0e-324"))                 { ret 9; }
    ret 0;
}

#[testing]
fun t_char(s: str) res[u8, Refusal] {
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret char_scan(s, span);
}

test char_scan__escapes_and_malformed {
    val nl: res[u8, Refusal] = t_char("'\\n'");
    if (sel nl.err)  { ret 1; }
    if (nl.ok != 10) { ret 1; }
    val bs: res[u8, Refusal] = t_char("'\\\\'");
    if (sel bs.err)  { ret 2; }
    if (bs.ok != 92) { ret 2; }
    val nul: res[u8, Refusal] = t_char("'\\0'");
    if (sel nul.err) { ret 3; }
    if (nul.ok != 0) { ret 3; }
    val quote: res[u8, Refusal] = t_char("'\\''");
    if (sel quote.err)  { ret 4; }
    if (quote.ok != 39) { ret 4; }
    val two: res[u8, Refusal] = t_char("'ab'");
    if (sel two.ok) { ret 5; }
    val empty: res[u8, Refusal] = t_char("''");
    if (sel empty.ok) { ret 6; }
    val open: res[u8, Refusal] = t_char("'a");
    if (sel open.ok) { ret 7; }
    ret 0;
}
