# the forms of the previous major this one still reads, until the family's sources are
# migrated
#
# std and the libraries on it are spelled for 6.x and the seed compiles them, so this
# compiler reads both spellings: each form below is a warning, and the form this major
# spells works beside it. a row's `refused` is the whole of the flip once the seed rolls:
# set it and the form is refused at the same places, naming the same replacement
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use diagnostic_kind: mach.lang.diagnostic.kind;
use lang_source: mach.lang.source;

pub def Form: u8;

# a condition, or an operand of `!`, `&&` or `||`, of type u8
pub val CONDITION_U8: Form = 0;
# a u1 value read as a u8: stored in one, mixed with one, or under arithmetic
pub val U1_AS_U8: Form = 1;
# a u8 constant holding 0 or 1 where a u1 is expected, as std's `true` and `false`
pub val U8_CONSTANT: Form = 2;
# an `asm` block headed by a previous major's identifier
pub val ASM_HEAD: Form = 3;

# one form
# ---
# form:    the form
# warning: the kind it is warned with while it is read
# refusal: the kind it is refused with once the row is `refused`
# refused: the form is refused, the flip
# warned:  it warns at all. a form every std `bool` reaches states nothing a project can
#          act on until std is migrated
# every:   it warns at each place, not once per module. a form as common as `bool` is
#          warned once in each module of the root project
# message: what the diagnostic says
# note:    the replacement it names
pub rec Row {
    form:    Form;
    warning: diagnostic_kind.Kind;
    refusal: diagnostic_kind.Kind;
    refused: bool;
    warned:  bool;
    every:   bool;
    message: str;
    note:    str;
}

val COUNT: usize      = 4;
val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{form: CONDITION_U8, warning: diagnostic_kind.CONDITION_U8, refusal: diagnostic_kind.CONDITION_TYPE, refused: false, warned: true, every: false,
        message: "a condition of type u8 is a previous major's: a condition has type u1",
        note: "compare the value, as `x != 0`, or hold it in a `u1`; `mach migrate` makes std's `bool` an alias of `u1`"},
    Row{form: U1_AS_U8, warning: diagnostic_kind.U1_AS_U8, refusal: diagnostic_kind.TYPE_MISMATCH, refused: false, warned: true, every: false,
        message: "a u1 read as a u8 is a previous major's: comparisons and logical operators produce u1",
        note: "cast it, as `value::u8`, or declare the destination `u1`"},
    Row{form: U8_CONSTANT, warning: diagnostic_kind.U1_AS_U8, refusal: diagnostic_kind.TYPE_MISMATCH, refused: false, warned: false, every: false,
        message: "a u8 constant is not a u1",
        note: "cast it, as `value::u1`, or declare the constant `u1`"},
    Row{form: ASM_HEAD, warning: diagnostic_kind.ASM_HEAD_RENAMED, refusal: diagnostic_kind.ASM_HEAD, refused: false, warned: true, every: true,
        message: "an `asm` head names a selection of masc's since v7, not an architecture",
        note: "`mach migrate` writes the selection; `$if` chooses a block per target"},
};

# the row of `form`
pub fun row(form: Form) *Row {
    ret ?ROWS[form::usize];
}

# a head a previous major wrote and the selection of masc's that stands for it: the
# architecture's first level, which adds nothing to a target of it
pub rec Head {
    from: str;
    to:   str;
}

val HEAD_COUNT: usize           = 4;
val HEADS:      [HEAD_COUNT]Head = [HEAD_COUNT]Head{
    Head{from: "x86_64", to: "x86-64"},
    Head{from: "aarch64", to: "armv8-a"},
    Head{from: "riscv64", to: "rv64i"},
    Head{from: "riscv32", to: "rv32i"},
};

# the row of the head `span` of `source` writes, nil when no previous major wrote it
pub fun head_of(source: str, span: lang_source.Span) *Head {
    var i: usize = 0;
    for (i < HEAD_COUNT) {
        if (str_region_equals(source, span.offset, span.len, HEADS[i].from)) { ret ?HEADS[i]; }
        i = i + 1;
    }
    ret nil;
}

# a `def` a previous major spelled over a width this major has a truth value for
pub rec Alias {
    name: str;
    from: str;
    to:   str;
}

val ALIAS_COUNT: usize              = 1;
val ALIASES:     [ALIAS_COUNT]Alias = [ALIAS_COUNT]Alias{
    Alias{name: "bool", from: "u8", to: "u1"},
};

# the row of a `def` of the name at `name` over the type at `over`, nil for any other
pub fun alias_of(source: str, name: lang_source.Span, over: lang_source.Span) *Alias {
    var i: usize = 0;
    for (i < ALIAS_COUNT) {
        val a: *Alias = ?ALIASES[i];
        if (str_region_equals(source, name.offset, name.len, a.name) && str_region_equals(source, over.offset, over.len, a.from)) { ret a; }
        i = i + 1;
    }
    ret nil;
}
