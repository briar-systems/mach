pub fun seed_builtins(sc: *sema_context.SemaContext) err[fail.Fail] {
    ret err[fail.Fail].ok{};
}

# the declared discriminator is the tag's storage contract; a too-narrow one is rejected here
# the discriminator is part of the tag's layout: it is recorded with the case table by every
# path that readies the layout, so a type query never sees a table without its width
fun record_tag_discriminator(sc: *sema_context.SemaContext, ty: type.TypeId, t: *ast_decl.DeclTag) {
    if (ast_id.type_is_nil(t.disc)) { ret; }
    var disc: type.TypeId = sema_context.resolved_type_of(sc, t.disc);
    if (type.is_nil(disc) && sc.instance.subst == nil) { disc = resolve_type_ref(sc, t.disc); }
    if (type.is_error(disc) || type.is_nil(disc))      { ret; }
    val k: type.TypeKind = type.shape_kind(?sc.s.types, disc);
    if (!type.is_valid_discriminator_kind(k) || type.is_secret(?sc.s.types, disc)) {
        check.report_typed(sc, diagnostic_kind.TAG_DISCRIMINATOR_TYPE, t.name, "a tag discriminator must be `u8`, `u16`, `u32` or `u64`, but this declares `", disc, "`");
        ret;
    }
    val bits: u32 = type.prim_desc(k).bits;
    if (bits < 64 && t.cases_len::u64 > (1::u64 << bits::u64)) {
        check.report_typed(sc, diagnostic_kind.TAG_DISCRIMINATOR_NARROW, t.name, "this tag has more cases than `", disc,
            "` can number: the discriminator type is too narrow for the case count");
        ret;
    }
    val recorded: err[fail.Fail] = type.set_tag_discriminator(?sc.s.types, ty, disc);
    if (sel recorded.err) { fail.internal(?sc.status, fail.describe(recorded.err)); }
}

pub fun infer_fun_sig(sc: *sema_context.SemaContext, f: *ast_decl.DeclFun) type.TypeId {
    val ret_type: type.TypeId = sema_context.resolved_type_of(sc, f.return_type);

    var runtime_count: u32 = 0;
    var i:             u32 = 0;
    for (i < f.params_len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[f.params_start + i];
        if (!tn.comptime) { runtime_count = runtime_count + 1; }
        i = i + 1;
    }

    if (runtime_count == 0) {
        val r: res[type.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, nil, 0, f.c_variadic);
        if (sel r.err) {
            fail.internal(?sc.status, fail.describe(r.err));
            ret type.TYPE_ERROR;
        }
        ret r.ok;
    }

    val pr: res[*type.TypeId, fail.Fail] = allocate_params(sc, runtime_count);
    if (sel pr.err) {
        fail.internal(?sc.status, fail.describe(pr.err));
        ret type.TYPE_ERROR;
    }
    val params: *type.TypeId = pr.ok;

    var w: u32 = 0;
    i = 0;
    for (i < f.params_len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[f.params_start + i];
        if (!tn.comptime) {
            params[w] = sema_context.resolved_type_of(sc, tn.ty);
            w         = w + 1;
        }
        i = i + 1;
    }

    val r: res[type.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, params, runtime_count, f.c_variadic);
    free_params(sc, params, runtime_count);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

pub fun infer_nominal(sc: *sema_context.SemaContext, did: ast_id.DeclId, name_span: lang_source.Span, r: *ast_decl.DeclRec, kind: type.TypeKind) type.TypeId {
    val name_id: intern.StrId                = intern_span_or_nil(sc, name_span);
    val tr:      res[type.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, name_id, resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), kind);
    if (sel tr.err) {
        fail.internal(?sc.status, fail.describe(tr.err));
        ret type.TYPE_ERROR;
    }
    val ty: type.TypeId = tr.ok;

    elaborate_nominal(sc, did, ty, r.fields_start, r.fields_len);
    ret ty;
}

pub fun infer_nominal_uni(sc: *sema_context.SemaContext, did: ast_id.DeclId, name_span: lang_source.Span, u: *ast_decl.DeclUni, kind: type.TypeKind) type.TypeId {
    val name_id: intern.StrId                = intern_span_or_nil(sc, name_span);
    val tr:      res[type.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, name_id, resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), kind);
    if (sel tr.err) {
        fail.internal(?sc.status, fail.describe(tr.err));
        ret type.TYPE_ERROR;
    }
    val ty: type.TypeId = tr.ok;

    elaborate_nominal(sc, did, ty, u.fields_start, u.fields_len);
    ret ty;
}

pub fun elaborate_nominal(sc: *sema_context.SemaContext, did: ast_id.DeclId, ty: type.TypeId,
    fields_start: u32, fields_len: u32) intern.StrId {
    val st: u8 = layout_state_of(sc, did);
    if (st == sema_context.LAYOUT_READY)  { ret intern.STR_NIL; }
    if (st == sema_context.LAYOUT_FAILED) { ret intern.STR_NIL; }
    if (st == sema_context.LAYOUT_ACTIVE) { ret nominal_name_id(sc, did); }

    layout_state_set(sc, did, sema_context.LAYOUT_ACTIVE);
    val declared: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (sel declared.some) {
        if (declared.some.kind == ast_decl.DECL_KIND_TAG) {
            record_tag_discriminator(sc, ty, ?declared.some.data.tag_);
        }
    }
    val fields: err[fail.Fail] = build_field_table(sc, ty, fields_start, fields_len);
    if (sel fields.err) {
        layout_state_set(sc, did, sema_context.LAYOUT_FAILED);
        fail.internal(?sc.status, fail.describe(fields.err));
        ret intern.STR_NIL;
    }
    record_decoration(sc, did, ty, fields_start, fields_len);
    layout_state_set(sc, did, sema_context.LAYOUT_READY);
    ret intern.STR_NIL;
}

fun layout_state_of(sc: *sema_context.SemaContext, did: ast_id.DeclId) u8 {
    if (sc.view.layout_state == nil)                        { ret sema_context.LAYOUT_READY; }
    if (ast_id.decl_index(did) >= sc.view.a.decls.len::u32) { ret sema_context.LAYOUT_READY; }
    ret sc.view.layout_state[ast_id.decl_index(did)];
}

fun layout_state_set(sc: *sema_context.SemaContext, did: ast_id.DeclId, st: u8) {
    if (sc.view.layout_state == nil)                        { ret; }
    if (ast_id.decl_index(did) >= sc.view.a.decls.len::u32) { ret; }
    sc.view.layout_state[ast_id.decl_index(did)] = st;
}

fun nominal_name_id(sc: *sema_context.SemaContext, did: ast_id.DeclId) intern.StrId {
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel d_opt.some) { ret intern.STR_NIL; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind == ast_decl.DECL_KIND_UNI) { ret intern_span_or_nil(sc, d.data.uni_.name); }
    if (d.kind == ast_decl.DECL_KIND_REC) { ret intern_span_or_nil(sc, d.data.rec_.name); }
    if (d.kind == ast_decl.DECL_KIND_TAG) { ret intern_span_or_nil(sc, d.data.tag_.name); }
    ret intern.STR_NIL;
}

# elaborates every nominal `tid` holds by value, each once; the name of a nominal whose
# layout is still being decided when it is reached again, nil otherwise
pub fun ensure_layout_ready(sc: *sema_context.SemaContext, tid: type.TypeId) intern.StrId {
    var scan:   type.TypeScan;
    val opened: err[fail.Fail] = type.type_scan_begin(?sc.s.types, ?scan);
    if (sel opened.err) {
        fail.internal(?sc.status, fail.describe(opened.err));
        ret intern.STR_NIL;
    }
    fin { type.type_scan_end(?sc.s.types, ?scan); }
    ret ensure_layout_walk(sc, ?scan, tid);
}

fun ensure_layout_walk(sc: *sema_context.SemaContext, scan: *type.TypeScan, tid: type.TypeId) intern.StrId {
    if (type.is_nil(tid) || type.is_error(tid)) { ret intern.STR_NIL; }
    # the measurement that follows meets the same nesting and refuses it
    if (stack.exhausted()) { ret intern.STR_NIL; }

    val base: type.TypeId                    = type.strip_secret(?sc.s.types, tid);
    val mark: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?sc.s.types, scan, base);
    if (sel mark.err) {
        fail.internal(?sc.status, fail.describe(mark.err));
        ret intern.STR_NIL;
    }
    if (mark.ok != type.VISIT_FRESH) { ret intern.STR_NIL; }
    val t_opt: opt[*type.Type] = type.get(?sc.s.types, base);
    if (!sel t_opt.some) { ret intern.STR_NIL; }
    val t: *type.Type = t_opt.some;

    if (t.kind == type.TYPE_ARRAY) { ret ensure_layout_walk(sc, scan, t.data.array.base); }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        val owner: type.TypeOwner = resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id);
        if (!module.stable_same(t.data.nominal.owner.module, owner.module) || !lang_source.file_same(t.data.nominal.owner.file, owner.file)
            || t.data.nominal.incarnation != 0) { ret intern.STR_NIL; }
        val selected: res[ast_id.DeclId, fail.Fail] = sema_context.own_nominal_declaration(sc, t);
        if (sel selected.err) {
            fail.internal(?sc.status, fail.describe(selected.err));
            ret intern.STR_NIL;
        }
        val did:   ast_id.DeclId       = selected.ok;
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
        if (!sel d_opt.some) { ret intern.STR_NIL; }
        val d: *ast_decl.Decl = d_opt.some;

        var fstart: u32 = d.data.rec_.fields_start;
        var flen:   u32 = d.data.rec_.fields_len;
        if (d.kind == ast_decl.DECL_KIND_UNI) {
            fstart = d.data.uni_.fields_start;
            flen   = d.data.uni_.fields_len;
        }
        or (d.kind == ast_decl.DECL_KIND_TAG) {
            fstart = d.data.tag_.cases_start;
            flen   = d.data.tag_.cases_len;
        }
        or (d.kind != ast_decl.DECL_KIND_REC) { ret intern.STR_NIL; }

        val cyc: intern.StrId = elaborate_nominal(sc, did, base, fstart, flen);
        if (!intern.str_is_nil(cyc)) { ret cyc; }
        ret ensure_layout_fields(sc, scan, base);
    }

    if (t.kind == type.TYPE_INSTANCE) {
        val cyc: intern.StrId = ensure_layout_walk(sc, scan, t.data.instance.nominal);
        if (!intern.str_is_nil(cyc)) { ret cyc; }
        sema_context.record_result(sc, subst.ensure_fields(sc.s, base));
        ret ensure_layout_fields(sc, scan, base);
    }

    ret intern.STR_NIL;
}

pub fun prepare_nominal_recipe(sc: *sema_context.SemaContext, ty: type.TypeId) err[fail.Fail] {
    val table_1: opt[*type.FieldTable] = type.field_table_for(?sc.s.types, ty);
    if (sel table_1.some) { ret err[fail.Fail].ok{}; }
    val selected: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (!sel selected.some) { ret err[fail.Fail].err{fail.message("nominal recipe has no semantic type")}; }
    val nominal:    *type.Type                    = selected.some;
    val definition: res[ast_id.DeclId, fail.Fail] = sema_context.own_nominal_declaration(sc, nominal);
    if (sel definition.err) { ret err[fail.Fail].err{definition.err}; }
    val did:   ast_id.DeclId  = definition.ok;
    val d:     *ast_decl.Decl = ?sc.view.a.decls.data[ast_id.decl_index(did)];
    var start: u32            = 0;
    var len:   u32            = 0;
    if (d.kind == ast_decl.DECL_KIND_REC) {
        start = d.data.rec_.fields_start;
        len   = d.data.rec_.fields_len;
    }
    or (d.kind == ast_decl.DECL_KIND_UNI) {
        start = d.data.uni_.fields_start;
        len   = d.data.uni_.fields_len;
    }
    or (d.kind == ast_decl.DECL_KIND_TAG) {
        start = d.data.tag_.cases_start;
        len   = d.data.tag_.cases_len;
    }
    or { ret err[fail.Fail].err{fail.message("nominal recipe definition has the wrong kind")}; }
    val cycle: intern.StrId = elaborate_nominal(sc, did, ty, start, len);
    if (!sel sc.status.kind.accepted) { ret err[fail.Fail].err{fail.phase_failure(sc.status)}; }
    val table_2: opt[*type.FieldTable] = type.field_table_for(?sc.s.types, ty);
    if (!intern.str_is_nil(cycle)) {
        ret err[fail.Fail].err{fail.message("nominal recipe preparation did not produce a complete table")};
    }
    if (!sel table_2.some) {
        ret err[fail.Fail].err{fail.message("nominal recipe preparation did not produce a complete table")};
    }
    ret err[fail.Fail].ok{};
}

fun ensure_layout_fields(sc: *sema_context.SemaContext, scan: *type.TypeScan, ty: type.TypeId) intern.StrId {
    val n: u32 = type.field_count(?sc.s.types, ty);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*type.FieldEntry] = type.field_at(?sc.s.types, ty, i);
        if (sel fe.some) {
            val cyc: intern.StrId = ensure_layout_walk(sc, scan, fe.some.ty);
            if (!intern.str_is_nil(cyc)) { ret cyc; }
        }
        i = i + 1;
    }
    ret intern.STR_NIL;
}

pub fun resolve_type_query(sc: *sema_context.SemaContext, tid: u32, which: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    ret answer_type_query(sc.s, tid, which);
}

pub fun answer_type_query(s: *session.Session, tid: u32, which: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    val t: type.TypeId = tid::type.TypeId;
    if (type.is_nil(t) || type.is_error(t)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }

    if (which == comptime.TYPE_QUERY_IS_SECRET) {
        if (type.is_secret(?s.types, t)) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(1)}};
        }
        if (type.shape_kind(?s.types, t) == type.TYPE_GENERIC_PARAM) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(0)}};
    }

    # one implementation: the same deep walk the raw-pointer cast check refuses on
    if (which == comptime.TYPE_QUERY_HOLDS_SECRET) {
        val reached: res[bool, fail.Fail] = deep.contains_secret(s, t);
        if (sel reached.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(reached.err))}; }
        if (reached.ok) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(1)}};
        }
        if (type.mentions_generic_param(?s.types, t)) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(0)}};
    }

    if (type.is_secret(?s.types, t) && which != comptime.TYPE_QUERY_NAME) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(0)}};
    }

    if (type.shape_kind(?s.types, t) == type.TYPE_GENERIC_PARAM) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }

    if (which == comptime.TYPE_QUERY_NAME) {
        val r: res[str, fail.Fail] = typename.type_to_str(s, t);
        if (sel r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(r.err))}; }
        val text: str                        = r.ok;
        val ir_r: res[intern.StrId, A.Error] = intern.add(?s.interner, text);
        A.deallocate[char](s.alloc, text, str_len(text) + 1);
        if (sel ir_r.err) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, lang_alloc.text(ir_r.err))};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_str(ir_r.ok)}};
    }

    val k:      type.TypeKind = type.shape_kind(?s.types, t);
    var answer: bool          = false;
    if (which == comptime.TYPE_QUERY_IS_RECORD)  { answer = k == type.TYPE_REC; }
    if (which == comptime.TYPE_QUERY_IS_UNION)   { answer = k == type.TYPE_UNI; }
    if (which == comptime.TYPE_QUERY_IS_TAG)     { answer = k == type.TYPE_TAG; }
    if (which == comptime.TYPE_QUERY_IS_POINTER) { answer = k == type.TYPE_POINTER || k == type.TYPE_PTR; }
    if (which == comptime.TYPE_QUERY_IS_INTEGER) { answer = type.prim_desc(k).class == type.PRIM_CLASS_INT; }
    if (which == comptime.TYPE_QUERY_IS_FLOAT)   { answer = type.prim_desc(k).class == type.PRIM_CLASS_FLOAT; }
    var bit: u8 = 0;
    if (answer) { bit = 1; }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(bit)}};
}

fun fold_layout_intrinsic(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) opt[opt[comptime.CTValue]] {
    val is_size:   bool = intrinsic.is_size_of_call(sc.view.a, sc.view.source, eid);
    val is_align:  bool = intrinsic.is_align_of_call(sc.view.a, sc.view.source, eid);
    val is_len:    bool = intrinsic.is_length_of_call(sc.view.a, sc.view.source, eid);
    val is_offset: bool = intrinsic.is_offset_of_call(sc.view.a, sc.view.source, eid);
    val is_id:     bool = intrinsic.is_type_id_call(sc.view.a, sc.view.source, eid);
    if (!is_size && !is_align && !is_len && !is_offset && !is_id) { ret opt[opt[comptime.CTValue]].none{}; }

    val arg: ast_id.ExprId = intrinsic.layout_intrinsic_type_arg(sc.view.a, eid);
    if (ast_id.expr_is_nil(arg)) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "a layout intrinsic takes one type argument");
        ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}};
    }

    val tid: type.TypeId = intrinsic_operand_type(sc, arg, span);
    if (type.is_error(tid)) { ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}}; }

    if (is_id) { ret opt[opt[comptime.CTValue]].some{fold_type_id(sc, tid, span)}; }

    if (is_len) {
        val n_opt: opt[u32] = type.element_count(?sc.s.types, tid);
        if (!sel n_opt.some) {
            check.report_typed(sc, diagnostic_kind.COMPTIME_LENGTH_OF, span, "`$length_of` has no answer for `", tid,
                "`: only a fixed array and a vector carry a statically known element count");
            ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}};
        }
        ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].some{comptime.ct_uint(n_opt.some::u64)}};
    }

    val cyc: intern.StrId = ensure_layout_ready(sc, tid);
    if (!intern.str_is_nil(cyc)) {
        check.report_named(sc, diagnostic_kind.LAYOUT_CYCLE, span, "layout cycle: measuring `", cyc,
            "` here needs a layout this measurement is itself deciding. break the cycle with a literal alignment or length");
        ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}};
    }

    if (is_offset) {
        val c_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
        if (sel c_opt.err)                            { ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}}; }
        if (c_opt.ok.kind != ast_expr.EXPR_KIND_CALL) { ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}}; }
        var call_value: ast_expr.Expr = c_opt.ok;
        val member:     opt[u32]      = offset_of_member_index(sc, ?call_value.data.call, tid, span, true);
        if (!sel member.some) { ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}}; }
        val off: layout.Extent = sema_context.recover[layout.Extent](sc, extent.field_offset(sc.s, sema_context.machine_of(sc), tid, member.some), layout.unknown_extent(layout.EXTENT_UNKNOWN_NODE));
        if (!off.ok) {
            report_layout_failure(sc, span, off.cause);
            ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}};
        }
        ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].some{comptime.ct_uint(off.size::u64)}};
    }

    val ext: layout.Extent = sema_context.recover[layout.Extent](sc, extent.of(sc.s, sema_context.machine_of(sc), tid), layout.unknown_extent(layout.EXTENT_UNKNOWN_NODE));
    if (!ext.ok) {
        report_layout_failure(sc, span, ext.cause);
        ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].none{}};
    }

    var n: u32 = ext.size;
    if (is_align) { n = ext.align; }
    ret opt[opt[comptime.CTValue]].some{opt[comptime.CTValue].some{comptime.ct_uint(n::u64)}};
}

# `$type_id` needs no layout, and `^T` keeps its qualifier: a secret is a different type
fun fold_type_id(sc: *sema_context.SemaContext, tid: type.TypeId, span: lang_source.Span) opt[comptime.CTValue] {
    if (type.mentions_generic_param(?sc.s.types, tid)) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_TYPE_ID, span, "`$type_id` of `", tid, "` is answered per instantiation, and this position has none");
        ret opt[comptime.CTValue].none{};
    }
    val r: res[u64, fail.Fail] = recipe.identity(sc.s, sc.view.ctx.env.target.defs, tid);
    if (sel r.err) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_TYPE_ID, span, "`$type_id` has no identity for `", tid, "`");
        ret opt[comptime.CTValue].none{};
    }
    ret opt[comptime.CTValue].some{comptime.ct_uint(r.ok)};
}

# the member named by `$offset_of(T, m)`: a record field, or a tag case that owns a payload
pub fun offset_of_member_index(sc: *sema_context.SemaContext, c: *ast_expr.ExprCall, owner: type.TypeId, span: lang_source.Span, silent: bool) opt[u32] {
    if (c.args_len < 2) { ret opt[u32].none{}; }
    val m_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, sc.view.a.expr_ids.data[c.args_start + 1]);
    if (sel m_opt.err) { ret opt[u32].none{}; }
    val m: ast_expr.Expr = m_opt.ok;
    if (m.kind != ast_expr.EXPR_KIND_IDENT) {
        if (!silent) { sema_context.report(sc, diagnostic_kind.COMPTIME_OFFSET_OF, m.span, "`$offset_of` names its member by a bare identifier"); }
        ret opt[u32].none{};
    }
    val name: intern.StrId = intern_span_or_nil(sc, m.data.ident.tok);
    val base: type.TypeId  = type.strip_secret(?sc.s.types, owner);
    sema_context.record_result(sc, subst.ensure_fields(sc.s, base));
    val n: u32 = type.field_count(?sc.s.types, base);
    var i: u32 = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(?sc.s.types, base, i);
        if (sel fa.some) {
            if (intern.str_same(fa.some.name, name)) {
                if (type.is_tag(?sc.s.types, base) && type.is_nil(fa.some.ty)) {
                    if (!silent) { check.report_named(sc, diagnostic_kind.COMPTIME_OFFSET_OF, m.span, "`$offset_of`: case `", name, "` has no payload, so it has no offset"); }
                    ret opt[u32].none{};
                }
                ret opt[u32].some{i};
            }
        }
        i = i + 1;
    }
    if (!silent) {
        if (type.is_tag(?sc.s.types, base)) { check.report_named(sc, diagnostic_kind.TAG_UNKNOWN_CASE, m.span, "unknown tag case `", name, "`"); }
        or                                  { check.report_no_field(sc, m.span, name, base); }
    }
    ret opt[u32].none{};
}

# a field descriptor's offset, from the checked type layout
pub fun field_offset(sc: *sema_context.SemaContext, owner: u32, index: u32) res[opt[comptime.CTValue], comptime.EvalFail] {
    val owner_ty: type.TypeId           = owner::type.TypeId;
    val entry:    opt[*type.FieldEntry] = type.field_at(?sc.s.types, owner_ty, index);
    if (!sel entry.some) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val off_r: res[layout.Extent, fail.Fail] = extent.field_offset(sc.s, sema_context.machine_of(sc), owner_ty, index);
    if (sel off_r.err) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(off_r.err))};
    }
    val off: layout.Extent = off_r.ok;
    if (!off.ok) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.LAYOUT_UNAVAILABLE, comptime.COMPTIME_DESCRIPTOR_LAYOUT_MSG)};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(off.size::u64)}};
}

fun report_layout_failure(sc: *sema_context.SemaContext, span: lang_source.Span, cause: layout.ExtentCause) {
    val cause_text: opt[str] = layout.cause_name(cause);
    if (sel cause_text.none) {
        fail.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "ExtentCause", cause::u32)));
        ret;
    }
    sema_context.reportf(sc, diagnostic_kind.LAYOUT_UNAVAILABLE, span, "the layout of the type named by this intrinsic could not be determined: {}", cause_text.some);
}

pub fun resolve_layout_intrinsic(sc: *sema_context.SemaContext, eid: u32) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val e:     ast_id.ExprId                 = eid::ast_id.ExprId;
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, e);
    if (sel e_opt.err) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val span: lang_source.Span = e_opt.ok.span;

    val lay: opt[opt[comptime.CTValue]] = fold_layout_intrinsic(sc, e, span);
    if (sel sc.status.kind.internal) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, sc.status.kind.internal)};
    }
    if (!sel lay.some) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val inner: opt[comptime.CTValue] = lay.some;
    if (!sel inner.some) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.LAYOUT_UNAVAILABLE, LAYOUT_REPORTED_MSG)};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{inner.some}};
}

val LAYOUT_REPORTED_MSG: str = "this layout intrinsic could not be measured; see the diagnostic reported against it";

val REACHES_MAX_DEPTH: u32 = 1024;

val REACHES_DEPTH_MSG: str = "this type nests deeper than the recursive-type checker can walk, so it cannot be proven to have a finite size; break the nesting with a pointer (`*T`)";

fun reaches_nominal(s: *session.Session, seen: *u32, cap: u32, stamp: u32,
    target: type.TypeId, ty: type.TypeId, depth: u32) res[bool, fail.Fail] {
    if (depth >= REACHES_MAX_DEPTH || stack.exhausted()) { ret res[bool, fail.Fail].err{fail.message(REACHES_DEPTH_MSG)}; }

    val base:  type.TypeId     = type.strip_secret(?s.types, ty);
    val found: opt[*type.Type] = type.get(?s.types, base);
    if (!sel found.some) { ret res[bool, fail.Fail].ok{false}; }
    val t: *type.Type = found.some;

    if (t.kind == type.TYPE_ARRAY) {
        ret reaches_nominal(s, seen, cap, stamp, target, t.data.array.base, depth + 1);
    }

    if (t.kind != type.TYPE_REC && t.kind != type.TYPE_UNI && t.kind != type.TYPE_TAG && t.kind != type.TYPE_INSTANCE) {
        ret res[bool, fail.Fail].ok{false};
    }

    val nom: type.TypeId = type.aggregate_nominal(?s.types, base);
    if (type.is_error(nom))      { ret res[bool, fail.Fail].ok{false}; }
    if (type.same(nom, target))  { ret res[bool, fail.Fail].ok{true}; }
    if (nom::u32 >= cap)         { ret res[bool, fail.Fail].ok{false}; }
    if (seen[nom::u32] == stamp) { ret res[bool, fail.Fail].ok{false}; }
    seen[nom::u32] = stamp;

    val n: u32 = type.field_count(?s.types, nom);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*type.FieldEntry] = type.field_at(?s.types, nom, i);
        if (sel fe.some) {
            val reaches_r: res[bool, fail.Fail] = reaches_nominal(s, seen, cap, stamp, target,
                fe.some.ty, depth + 1);
            if (sel reaches_r.err) { ret reaches_r; }
            if (reaches_r.ok)      { ret res[bool, fail.Fail].ok{true}; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

val REACHES_NO:        u8 = 0;
val REACHES_YES:       u8 = 1;
val REACHES_EXHAUSTED: u8 = 2;

fun reaches_checked(sc: *sema_context.SemaContext, seen: *u32, cap: u32, stamp: u32,
    target: type.TypeId, ty: type.TypeId, at: lang_source.Span) u8 {
    val reaches_r: res[bool, fail.Fail] = reaches_nominal(sc.s, seen, cap, stamp, target, ty, 0);
    if (sel reaches_r.err) {
        sema_context.report(sc, diagnostic_kind.TYPE_RECURSIVE, at, fail.describe(reaches_r.err));
        ret REACHES_EXHAUSTED;
    }
    if (reaches_r.ok) { ret REACHES_YES; }
    ret REACHES_NO;
}

fun check_occurs(sc: *sema_context.SemaContext, nom: type.TypeId, fields_start: u32, fields_len: u32,
    seen: *u32, cap: u32, stamp: u32) u32 {
    var next: u32 = stamp;
    var i:    u32 = 0;
    for (i < fields_len) {
        var member: ast_decl.TypedName  = nominal_member(sc, fields_start, i, type.is_tag(?sc.s.types, nom));
        val tn:     *ast_decl.TypedName = ?member;
        val ty:     type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
        if (reaches_checked(sc, seen, cap, next, nom, ty, tn.name) == REACHES_YES) {
            sema_context.report(sc, diagnostic_kind.TYPE_RECURSIVE, tn.name, "recursive type has infinite size: this field contains the type being declared by value, so the type would have to contain itself; store it behind a pointer (`*T`) to break the cycle");
        }
        next = next + 1;
        i    = i + 1;
    }
    ret next;
}

fun check_uni_secrecy(sc: *sema_context.SemaContext, nom: type.TypeId, fields_start: u32, fields_len: u32,
    seen: *u32, cap: u32, stamp: u32) u32 {
    var next: u32 = stamp;
    if (fields_len < 2) { ret next; }

    val outcome: res[*bool, A.Error] = A.allocate[bool](sc.s.alloc, fields_len::usize);
    if (sel outcome.err) {
        fail.internal(?sc.status, lang_alloc.text(outcome.err));
        ret next;
    }
    # a variant that reaches the union by value is the recursion error's, not this check's
    val sized: *bool = outcome.ok;
    var b:     u32   = 0;
    for (b < fields_len) {
        val btn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[fields_start + b];
        val bty: type.TypeId         = sema_context.resolved_type_of(sc, btn.ty);
        val br:  u8                  = reaches_checked(sc, seen, cap, next, nom, bty, btn.name);
        next = next + 1;
        if (br == REACHES_EXHAUSTED) {
            A.deallocate[bool](sc.s.alloc, sized, fields_len::usize);
            ret next;
        }
        sized[b] = br == REACHES_NO;
        b        = b + 1;
    }

    # agreement is pairwise over the bytes each pair shares, so no variant stands in for the rest
    var i: u32 = 1;
    for (i < fields_len) {
        if (sized[i]) {
            val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[fields_start + i];
            val ty: type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
            var j:  u32                 = 0;
            for (j < i) {
                if (sized[j]) {
                    val jtn:   *ast_decl.TypedName = ?sc.view.a.typed_names.data[fields_start + j];
                    val jty:   type.TypeId         = sema_context.resolved_type_of(sc, jtn.ty);
                    val agree: secrecy.Agreement   = sema_context.recover[secrecy.Agreement](sc, secrecy.overlay_agrees(sc.s, sema_context.machine_of(sc), jty, ty), secrecy.DISAGREE);
                    if (sel sc.status.kind.internal) {
                        A.deallocate[bool](sc.s.alloc, sized, fields_len::usize);
                        ret next;
                    }
                    if (agree == secrecy.UNDECIDABLE) {
                        sema_context.report(sc, diagnostic_kind.SECRET_VARIANT_UNPROVABLE, tn.name, secrecy.UNBOUNDED_VARIANTS_MSG);
                        brk;
                    }
                    if (agree != secrecy.AGREE) {
                        sema_context.report(sc, diagnostic_kind.SECRET_VARIANT_MISMATCH, tn.name, "union variants must agree on secrecy: overlapping fields are part secret `^` and part public, which would alias the same storage at two classifications");
                        brk;
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    A.deallocate[bool](sc.s.alloc, sized, fields_len::usize);
    ret next;
}

pub fun check_occurs_all(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.decl_type == nil) { ret err[fail.Fail].ok{}; }

    val cap: u32 = type.type_count(?sc.s.types);
    if (cap == 0) { ret err[fail.Fail].ok{}; }

    val outcome: res[*u32, A.Error] = A.allocate[u32](sc.s.alloc, cap::usize);
    if (sel outcome.err) {
        fail.internal(?sc.status, lang_alloc.text(outcome.err));
        ret err[fail.Fail].err{fail.message(RECURSIVE_SCRATCH_MSG)};
    }
    val seen: *u32 = outcome.ok;

    var z: u32 = 0;
    for (z < cap) {
        seen[z] = 0;
        z       = z + 1;
    }
    var stamp: u32 = 1;

    var d: u32 = 0;
    for (d < sc.view.a.decls.len::u32) {
        if (!type.is_nil(sc.view.decl_type[d])) {
            val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, ast_id.decl(d));
            if (sel d_opt.some) {
                val dd: *ast_decl.Decl = d_opt.some;
                if (dd.kind == ast_decl.DECL_KIND_TAG) {
                    stamp = check_occurs(sc, sc.view.decl_type[d], dd.data.tag_.cases_start,
                        dd.data.tag_.cases_len, seen, cap, stamp);
                }
                if (dd.kind == ast_decl.DECL_KIND_REC) {
                    stamp = check_occurs(sc, sc.view.decl_type[d], dd.data.rec_.fields_start,
                        dd.data.rec_.fields_len, seen, cap, stamp);
                }
                if (dd.kind == ast_decl.DECL_KIND_UNI) {
                    stamp = check_occurs(sc, sc.view.decl_type[d], dd.data.uni_.fields_start,
                        dd.data.uni_.fields_len, seen, cap, stamp);
                }
            }
        }
        d = d + 1;
    }

    A.deallocate[u32](sc.s.alloc, seen, cap::usize);
    ret err[fail.Fail].ok{};
}

val RECURSIVE_SCRATCH_MSG: str = "internal: out of memory allocating the recursive-type checker's scratch table; the check cannot be skipped, because a type that contains itself by value would reach layout with no finite size";

pub fun check_uni_secrecy_all(sc: *sema_context.SemaContext) err[fail.Fail] {
    val cap: u32 = type.type_count(?sc.s.types);
    if (cap == 0) { ret err[fail.Fail].ok{}; }

    val outcome: res[*u32, A.Error] = A.allocate[u32](sc.s.alloc, cap::usize);
    if (sel outcome.err) {
        fail.internal(?sc.status, lang_alloc.text(outcome.err));
        ret err[fail.Fail].err{fail.message(RECURSIVE_SCRATCH_MSG)};
    }
    val seen: *u32 = outcome.ok;
    var z:    u32  = 0;
    for (z < cap) {
        seen[z] = 0;
        z       = z + 1;
    }

    var stamp: u32 = 1;

    if (sc.view.decl_type != nil) {
        var d: u32 = 0;
        for (d < sc.view.a.decls.len::u32) {
            if (!type.is_nil(sc.view.decl_type[d])) {
                val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, ast_id.decl(d));
                if (sel d_opt.some) {
                    val dd: *ast_decl.Decl = d_opt.some;
                    if (dd.kind == ast_decl.DECL_KIND_UNI) {
                        stamp = check_uni_secrecy(sc, sc.view.decl_type[d], dd.data.uni_.fields_start,
                            dd.data.uni_.fields_len, seen, cap, stamp);
                    }
                }
            }
            d = d + 1;
        }
    }

    var i: u32 = 0;
    for (i < sc.view.a.types.len::u32) {
        val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, ast_id.type(i));
        if (sel t_opt.some) {
            val t: *ast_type.Type = t_opt.some;
            if (t.kind == ast_type.TYPE_KIND_UNI) {
                stamp = check_uni_secrecy(sc, sc.view.type_resolved_ty[i], t.data.uni_.fields_start,
                    t.data.uni_.fields_len, seen, cap, stamp);
            }
        }
        i = i + 1;
    }

    A.deallocate[u32](sc.s.alloc, seen, cap::usize);
    ret err[fail.Fail].ok{};
}

# the layout decorations `did` declares on nominal `ty`, published beside its field table
fun record_decoration(sc: *sema_context.SemaContext, did: ast_id.DeclId, ty: type.TypeId, fields_start: u32, fields_len: u32) {
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel d_opt.some) { ret; }
    val d: *ast_decl.Decl = d_opt.some;

    val dec: type.Decoration = type.Decoration{
        align: declared_align(sc, d), packed: decorator.has(sc.view.a, d, decorator.PACKED), volatile_: decorator.has(sc.view.a, d, decorator.VOLATILE)
    };
    if (dec.packed)                                      { check_packed_no_vector_members(sc, fields_start, fields_len, type.is_tag(?sc.s.types, ty)); }
    if (dec.align == 0 && !dec.packed && !dec.volatile_) { ret; }
    val set: err[fail.Fail] = type.decoration_set(?sc.s.types, ty, dec);
    if (sel set.err) { fail.internal(?sc.status, fail.describe(set.err)); }
}

# the alignment `d` declares, zero when it declares none or a refused one, which is
# reported here for a type, a function and a global alike
pub fun declared_align(sc: *sema_context.SemaContext, d: *ast_decl.Decl) u32 {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        if (dec.id == decorator.ALIGN) {
            if (dec.args_len != 1) { ret 0; }
            val arg: ast_id.ExprId              = sc.view.a.expr_ids.data[dec.args_start];
            var cv:  comptime.CTValue;
            val lay: opt[opt[comptime.CTValue]] = fold_layout_intrinsic(sc, arg, dec.name);
            if (sel lay.some) {
                val got: opt[comptime.CTValue] = lay.some;
                if (!sel got.some) { ret 0; }
                cv = got.some;
            }
            if (sel lay.none) {
                val ev: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, arg, ?sc.s.interner);
                sema_context.record_eval_result(sc, ev);
                if (sel ev.err) {
                    sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be a compile-time constant");
                    ret 0;
                }
                cv = ev.ok;
            }
            if (cv.kind != comptime.CT_KIND_INT) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be an integer");
                ret 0;
            }
            if (comptime.ct_is_negative(cv)) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be a non-zero power of two");
                ret 0;
            }
            if (!wide.is_pow2(cv.data.w)) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value must be a non-zero power of two");
                ret 0;
            }
            val n_o: opt[u64] = comptime.ct_int_u64(cv);
            var n:   u64      = 0;
            if (sel n_o.some) { n = n_o.some; }
            if (!sel n_o.some || n > 0xFFFFFFFF) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ALIGN, dec.name, "`align` value exceeds the maximum alignment");
                ret 0;
            }
            ret n::u32;
        }
        i = i + 1;
    }
    ret 0;
}

fun check_packed_no_vector_members(sc: *sema_context.SemaContext, fields_start: u32, fields_len: u32, tagged: bool) {
    var i: u32 = 0;
    for (i < fields_len) {
        var member: ast_decl.TypedName  = nominal_member(sc, fields_start, i, tagged);
        val tn:     *ast_decl.TypedName = ?member;
        val fty:    type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
        ensure_layout_ready(sc, fty);
        var q: type_query.Query = sema_context.query_of(sc);
        if (reach.vector(?q, fty)) {
            sema_context.report(sc, diagnostic_kind.VECTOR_PACKED_FIELD, tn.name, "a vector field is not allowed in a `#[packed]` record: packing places it at an offset nothing guarantees is a multiple of its width. store the lanes as scalar fields, or drop `#[packed]` from this record");
            ret;
        }
        i = i + 1;
    }
}

fun nominal_member(sc: *sema_context.SemaContext, start: u32, index: u32, tagged: bool) ast_decl.TypedName {
    if (!tagged) { ret sc.view.a.typed_names.data[start + index]; }
    val c: *ast_decl.TagCase = ?sc.view.a.tag_cases.data[start + index];
    ret ast_decl.TypedName{name: c.name, ty: c.payload};
}

fun build_field_table(sc: *sema_context.SemaContext, ty: type.TypeId, fields_start: u32, fields_len: u32) err[fail.Fail] {
    val table: opt[*sema_context.FieldTable] = sema_context.field_table_for(sc, ty);
    if (sel table.some) { ret err[fail.Fail].ok{}; }

    var fields: *type.FieldEntry = nil;
    if (fields_len != 0) {
        val allocated: res[*type.FieldEntry, A.Error] = A.allocate[type.FieldEntry](sc.s.alloc, fields_len::usize);
        if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
        fields = allocated.ok;
    }
    fin {
        if (fields != nil) { A.deallocate[type.FieldEntry](sc.s.alloc, fields, fields_len::usize); }
    }

    var i: u32 = 0;
    for (i < fields_len) {
        var member: ast_decl.TypedName  = nominal_member(sc, fields_start, i, type.is_tag(?sc.s.types, ty));
        val tn:     *ast_decl.TypedName = ?member;
        val fname:  intern.StrId        = intern_span_or_nil(sc, tn.name);
        var fty:    type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
        if (type.is_nil(fty) && sc.instance.subst == nil && !ast_id.type_is_nil(tn.ty)) {
            fty = resolve_type_ref(sc, tn.ty);
        }
        if (sel sc.status.kind.internal) { ret err[fail.Fail].err{fail.message(sc.status.kind.internal)}; }
        if (type.is_tag(?sc.s.types, ty)) {
            var previous: u32 = 0;
            for (previous < i) {
                if (intern.str_same(fields[previous].name, fname)) {
                    sema_context.report(sc, diagnostic_kind.TAG_DUPLICATE_CASE, tn.name, "duplicate tag case name");
                    brk;
                }
                previous = previous + 1;
            }
        }
        var notice: deprecation.Deprecation = deprecation.none();
        if (type.is_tag(?sc.s.types, ty)) {
            val c:     *ast_decl.TagCase                       = ?sc.view.a.tag_cases.data[fields_start + i];
            val noted: res[deprecation.Deprecation, fail.Fail] = resolve.decorators_deprecation(sc.view.ctx, sc.view.a, c.decorators_start, c.decorators_len);
            if (sel noted.err) { ret err[fail.Fail].err{noted.err}; }
            notice = noted.ok;
        }
        fields[i] = type.FieldEntry{name: fname, ty: fty, deprecation: notice};
        i         = i + 1;
    }

    val start_r: res[u32, fail.Fail] = sema_context.field_table_stage(sc, fields_len);
    if (sel start_r.err) { ret err[fail.Fail].err{start_r.err}; }
    val start: u32 = start_r.ok;
    i = 0;
    for (i < fields_len) {
        val push_r: err[fail.Fail] = sema_context.field_table_stage_push_entry(sc, fields[i]);
        if (sel push_r.err) { ret push_r; }
        i = i + 1;
    }

    ret sema_context.field_table_publish(sc, ty, start, fields_len);
}

pub fun intrinsic_operand_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) type.TypeId {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);

    if (sel e_opt.ok) {
        if (intrinsic.is_field_type_member(sc.view.a, sc.view.source, eid)) {
            val fv: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
            sema_context.record_eval_result(sc, fv);
            if (sel fv.err) {
                sema_context.report(sc, fv.err.diag, span, fv.err.message);
                ret type.TYPE_ERROR;
            }
            val v: comptime.CTValue = fv.ok;
            if (v.kind != comptime.CT_KIND_TYPE) {
                sema_context.report(sc, diagnostic_kind.COMPTIME_TYPE_ARGUMENT, span, "a comptime intrinsic's type argument did not resolve to a type");
                ret type.TYPE_ERROR;
            }
            ret v.data.t::type.TypeId;
        }
    }

    if (sel e_opt.err) {
        sema_context.report_internal(sc, span, "internal: a comptime intrinsic argument was not parsed as a type");
        ret type.TYPE_ERROR;
    }
    if (e_opt.ok.kind != ast_expr.EXPR_KIND_TYPE_REF) {
        sema_context.report_internal(sc, span, "internal: a comptime intrinsic argument was not parsed as a type");
        ret type.TYPE_ERROR;
    }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;

    # type errors include deferred generic operands, and allocation errors carry their own status.
    ret resolve_type_ref(sc, e.data.type_ref.ty);
}

fun interned(sc: *sema_context.SemaContext, text: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, text);
    if (sel r.err) {
        fail.internal(?sc.status, lang_alloc.text(r.err));
        ret intern.STR_NIL;
    }
    ret r.ok;
}

pub fun resolve_type_ref(sc: *sema_context.SemaContext, tid: ast_id.TypeId) type.TypeId {
    sema_context.report_deferred_type(sc, tid);
    if (type_is_per_iteration(sc, tid)) {
        val resolved: type.TypeId = resolve_type_ref_raw(sc, tid);
        check_type_node_float_capability(sc, tid, resolved);
        ret resolved;
    }

    if (memo_state(sc, tid) != sema_context.TYPE_MEMO_NONE) { ret sc.view.type_resolved_ty[ast_id.type_index(tid)]; }

    val resolved: type.TypeId = resolve_type_ref_raw(sc, tid);
    check_type_node_float_capability(sc, tid, resolved);
    memo_record(sc, tid, resolved);
    ret resolved;
}

fun check_type_node_float_capability(sc: *sema_context.SemaContext, tid: ast_id.TypeId, resolved: type.TypeId) {
    if (type.is_error(resolved) || type.is_nil(resolved)) { ret; }
    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (!sel t_opt.some) { ret; }
    check.check_float_capability(sc, resolved, t_opt.some.span);
}

fun type_is_per_iteration(sc: *sema_context.SemaContext, tid: ast_id.TypeId) bool {
    if (ast_id.type_is_nil(tid)) { ret false; }
    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (!sel t_opt.some) { ret false; }
    val t: *ast_type.Type = t_opt.some;
    if (t.kind == ast_type.TYPE_KIND_FIELD_TYPE)      { ret true; }
    if (t.kind == ast_type.TYPE_KIND_POINTEE_OF)      { ret type_is_per_iteration(sc, t.data.pointee_of.inner); }
    if (t.kind == ast_type.TYPE_KIND_DISCRIMINANT_OF) { ret type_is_per_iteration(sc, t.data.discriminant_of.inner); }
    if (t.kind == ast_type.TYPE_KIND_PTR)             { ret type_is_per_iteration(sc, t.data.ptr.pointee); }
    if (t.kind == ast_type.TYPE_KIND_SECRET)          { ret type_is_per_iteration(sc, t.data.secret.inner); }
    if (t.kind == ast_type.TYPE_KIND_ARRAY)           { ret type_is_per_iteration(sc, t.data.array.element); }
    if (t.kind == ast_type.TYPE_KIND_NAMED) {
        var i: u32 = 0;
        for (i < t.data.named.args_len) {
            if (type_is_per_iteration(sc, sc.view.a.type_ids.data[t.data.named.args_start + i])) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

fun memo_state(sc: *sema_context.SemaContext, tid: ast_id.TypeId) u8 {
    if (sc.view.type_resolved_memo == nil)                  { ret sema_context.TYPE_MEMO_NONE; }
    if (sc.view.type_resolved_ty == nil)                    { ret sema_context.TYPE_MEMO_NONE; }
    if (ast_id.type_index(tid) >= sc.view.a.types.len::u32) { ret sema_context.TYPE_MEMO_NONE; }
    ret sc.view.type_resolved_memo[ast_id.type_index(tid)];
}

fun memo_record(sc: *sema_context.SemaContext, tid: ast_id.TypeId, resolved: type.TypeId) {
    if (sc.view.type_resolved_memo == nil)                  { ret; }
    if (sc.view.type_resolved_ty == nil)                    { ret; }
    if (ast_id.type_index(tid) >= sc.view.a.types.len::u32) { ret; }
    sc.view.type_resolved_ty[ast_id.type_index(tid)]   = resolved;
    sc.view.type_resolved_memo[ast_id.type_index(tid)] = sema_context.TYPE_MEMO_RESOLVED;
}

fun resolve_type_ref_raw(sc: *sema_context.SemaContext, tid: ast_id.TypeId) type.TypeId {
    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (!sel t_opt.some) { ret type.TYPE_ERROR; }
    val t: *ast_type.Type = t_opt.some;

    if (t.kind == ast_type.TYPE_KIND_NAMED)           { ret resolve_type_named(sc, tid, ?t.data.named, t.span); }
    if (t.kind == ast_type.TYPE_KIND_PTR)             { ret resolve_type_ptr(sc, ?t.data.ptr); }
    if (t.kind == ast_type.TYPE_KIND_SECRET)          { ret resolve_type_secret(sc, ?t.data.secret); }
    if (t.kind == ast_type.TYPE_KIND_FIELD_TYPE)      { ret resolve_type_field_type(sc, ?t.data.field_type, t.span); }
    if (t.kind == ast_type.TYPE_KIND_POINTEE_OF)      { ret resolve_type_pointee_of(sc, ?t.data.pointee_of, t.span); }
    if (t.kind == ast_type.TYPE_KIND_DISCRIMINANT_OF) { ret resolve_type_discriminant_of(sc, ?t.data.discriminant_of, t.span); }
    if (t.kind == ast_type.TYPE_KIND_ARRAY)           { ret resolve_type_array(sc, tid, ?t.data.array, t.span); }
    if (t.kind == ast_type.TYPE_KIND_FUN)             { ret resolve_type_fun(sc, ?t.data.fun_); }
    if (t.kind == ast_type.TYPE_KIND_REC)             { ret resolve_type_anon(sc, tid, t.data.rec_.fields_start, t.data.rec_.fields_len, type.TYPE_REC); }
    if (t.kind == ast_type.TYPE_KIND_UNI)             { ret resolve_type_anon(sc, tid, t.data.uni_.fields_start, t.data.uni_.fields_len, type.TYPE_UNI); }
    if (t.kind == ast_type.TYPE_KIND_PACK) {
        val r: res[type.TypeId, fail.Fail] = type.intern_pack(?sc.s.types);
        if (sel r.err) {
            fail.internal(?sc.status, fail.describe(r.err));
            ret type.TYPE_ERROR;
        }
        ret r.ok;
    }
    if (t.kind != ast_type.TYPE_KIND_ERROR) {
        fail.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "AstTypeKind", t.kind::u32)));
    }
    ret type.TYPE_ERROR;
}

fun resolve_type_field_type(sc: *sema_context.SemaContext, ft: *ast_type.TypeFieldType, span: lang_source.Span) type.TypeId {
    val r: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, ft.var_name.offset, ft.var_name.len);
    if (sel r.err) {
        fail.internal(?sc.status, lang_alloc.text(r.err));
        ret type.TYPE_ERROR;
    }
    val gr: res[opt[u32], comptime.EvalFail] = comptime.field_type_of_binding[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, r.ok);
    if (sel gr.err) {
        val f: comptime.EvalFail = gr.err;
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?sc.status, f.message); }
        or (f.kind == comptime.EVAL_FAIL_REJECTED) { sema_context.report(sc, f.diag, span, f.message); }
        ret type.TYPE_ERROR;
    }
    val got: opt[u32] = gr.ok;
    if (sel got.none) { ret type.TYPE_ERROR; }
    ret got.some::type.TypeId;
}

fun resolve_type_discriminant_of(sc: *sema_context.SemaContext, dof: *ast_type.TypeDiscriminantOf, span: lang_source.Span) type.TypeId {
    val inner: type.TypeId = resolve_type_ref(sc, dof.inner);
    if (type.is_error(inner) || type.is_nil(inner)) { ret type.TYPE_ERROR; }
    val base: type.TypeId = type.strip_secret(?sc.s.types, inner);
    if (!type.is_tag(?sc.s.types, base)) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_DISCRIMINANT_OF, span, "`$discriminant_of` expects a tag, but this names `", inner, "`");
        ret type.TYPE_ERROR;
    }
    ensure_layout_ready(sc, base);
    val disc: type.TypeId = type.tag_discriminator(?sc.s.types, base);
    if (type.is_nil(disc) || type.is_error(disc)) { ret type.TYPE_ERROR; }
    ret disc;
}

fun resolve_type_pointee_of(sc: *sema_context.SemaContext, po: *ast_type.TypePointeeOf, span: lang_source.Span) type.TypeId {
    val inner: type.TypeId = resolve_type_ref(sc, po.inner);
    if (type.is_error(inner) || type.is_nil(inner)) { ret type.TYPE_ERROR; }

    val k: type.TypeKind = type.shape_kind(?sc.s.types, inner);
    if (k == type.TYPE_GENERIC_PARAM) { ret type.TYPE_ERROR; }

    if (type.is_secret(?sc.s.types, inner)) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_POINTEE_OF, span, "`$pointee_of` refuses `", inner,
            "`: a `^` secret is not a reference, and `$is_pointer` answers false for it");
        ret type.TYPE_ERROR;
    }

    val t_opt: opt[*type.Type] = type.get(?sc.s.types, inner);
    if (sel t_opt.some) {
        if (t_opt.some.kind == type.TYPE_POINTER) {
            ret t_opt.some.data.pointer.base;
        }
    }

    if (k == type.TYPE_PTR) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_POINTEE_OF, span, "`$pointee_of(ptr)` has no answer: the raw `ptr` is untyped and carries no pointee type");
        ret type.TYPE_ERROR;
    }

    check.report_typed(sc, diagnostic_kind.COMPTIME_POINTEE_OF, span, "`$pointee_of` expects a typed reference `*U`, but this names `", inner, "`");
    ret type.TYPE_ERROR;
}

fun resolve_type_named(sc: *sema_context.SemaContext, tid: ast_id.TypeId, named: *ast_type.TypeNamed, span: lang_source.Span) type.TypeId {
    val sym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_type(sc, tid);
    if (!sel sym_opt.some) {
        ret type.TYPE_ERROR;
    }
    val sym: *resolve.Symbol = sym_opt.some;

    if (named.args_len > 0) {
        ret instantiate_named(sc, sym, named, span);
    }

    if (named.operand && is_value_binding(sym)) { ret binding_type_for(sc, sym, span); }

    ret type_for_symbol(sc, sym, span);
}

fun is_value_binding(sym: *resolve.Symbol) bool {
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) != 0) { ret false; }
    if (ast_id.decl_is_nil(sym.decl))                 { ret false; }
    if (sym.kind == resolve.SYM_VAL)                  { ret true; }
    if (sym.kind == resolve.SYM_VAR)                  { ret true; }
    if (sym.kind == resolve.SYM_PARAM)                { ret true; }
    ret false;
}

fun binding_type_for(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: lang_source.Span) type.TypeId {
    if (sym.kind == resolve.SYM_PARAM || !module.same(sym.origin, sc.view.own_module)) {
        val t: type.TypeId = sema_context.decl_type_for(sc, sym);
        if (type.is_nil(t) || type.is_error(t)) {
            check.report_named(sc, diagnostic_kind.COMPTIME_UNMEASURABLE, span, "`", sym.name, "` has no type a comptime intrinsic can measure here");
            ret type.TYPE_ERROR;
        }
        ret t;
    }

    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
    if (!sel d_opt.some) { ret type.TYPE_ERROR; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) { ret type.TYPE_ERROR; }
    if (ast_id.type_is_nil(d.data.bind.ty))                                   { ret type.TYPE_ERROR; }
    ret resolve_type_ref(sc, d.data.bind.ty);
}

pub fun type_for_symbol(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: lang_source.Span) type.TypeId {
    if (sym.kind == resolve.SYM_REC || sym.kind == resolve.SYM_UNI || sym.kind == resolve.SYM_TAG || sym.kind == resolve.SYM_IMPORTED) {
        val arity: u32 = sym.generic_arity;
        if (arity > 0) {
            check.report_missing_type_args(sc, span, sym.name, arity);
            ret type.TYPE_ERROR;
        }
    }

    if (sym.kind == resolve.SYM_PRIM) {
        ret prim_or_error(sc, sym.slot::type.TypeKind);
    }
    if (sym.kind == resolve.SYM_VECTOR) {
        ret sym.slot::type.TypeId;
    }
    if (sym.kind == resolve.SYM_GENERIC) { ret sema_context.generic_param_type_for(sc, sym); }
    if (sym.kind == resolve.SYM_REC || sym.kind == resolve.SYM_UNI || sym.kind == resolve.SYM_TAG) {
        var kind: type.TypeKind = type.TYPE_REC;
        if (sym.kind == resolve.SYM_UNI) { kind = type.TYPE_UNI; }
        if (sym.kind == resolve.SYM_TAG) { kind = type.TYPE_TAG; }
        if (lang_source.file_is_nil(sym.definition_file)) {
            fail.internal(?sc.status, "nominal symbol has no defining source identity");
            ret type.TYPE_ERROR;
        }
        val r: res[type.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, sym.canon, resolve.type_owner(sc.s, sym.origin, sym.definition_file), kind);
        if (sel r.err) {
            fail.internal(?sc.status, fail.describe(r.err));
            ret type.TYPE_ERROR;
        }
        ret r.ok;
    }
    if (sym.kind == resolve.SYM_DEF) {
        ret def_underlying(sc, sym, span);
    }
    if (sym.kind == resolve.SYM_IMPORTED) {
        val imported: type.TypeId = sema_context.decl_type_for(sc, sym);
        if (type.is_nil(imported) || type.is_error(imported)) {
            check.report_named(sc, diagnostic_kind.NAME_NOT_TYPE, span, "imported `", sym.name, "` does not resolve to a type");
            ret type.TYPE_ERROR;
        }
        ret imported;
    }
    check.report_named(sc, diagnostic_kind.NAME_NOT_TYPE, span, "`", sym.name, "` does not name a type");
    ret type.TYPE_ERROR;
}

pub fun def_underlying(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: lang_source.Span) type.TypeId {
    if (module.same(sym.origin, sc.view.own_module)) {
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
        if (!sel d_opt.some) { ret type.TYPE_ERROR; }
        val d: *ast_decl.Decl = d_opt.some;
        if (d.kind != ast_decl.DECL_KIND_DEF) { ret type.TYPE_ERROR; }
        if (ast_id.type_is_nil(d.data.def_.ty) && abitype.declares_abi_type(sc, d)) {
            ret abitype.type_of(sc, d);
        }
        if (ast_id.type_is_nil(d.data.def_.ty)) { ret sema_handle.type_of(sc, sym.decl, d); }
        ret resolve_type_ref(sc, d.data.def_.ty);
    }
    ret sema_context.decl_type_for(sc, sym);
}

fun instantiate_named(sc: *sema_context.SemaContext, sym: *resolve.Symbol, named: *ast_type.TypeNamed, span: lang_source.Span) type.TypeId {
    val pr: res[*type.TypeId, fail.Fail] = allocate_params(sc, named.args_len);
    if (sel pr.err) {
        fail.internal(?sc.status, fail.describe(pr.err));
        ret type.TYPE_ERROR;
    }
    val args: *type.TypeId = pr.ok;

    val hits_before: u32 = sc.walk.deferred_hits;
    var i:           u32 = 0;
    for (i < named.args_len) {
        val arg_tid: ast_id.TypeId = sc.view.a.type_ids.data[named.args_start + i];
        args[i] = resolve_type_ref(sc, arg_tid);
        i       = i + 1;
    }
    # an argument naming what resolve left for its arm is reported as that name, if the arm is selected
    if (sc.walk.deferred_hits != hits_before) {
        free_params(sc, args, named.args_len);
        ret type.TYPE_ERROR;
    }

    val r: res[type.TypeId, fail.Fail] = generics.instantiate(sc, sym, args, named.args_len, span);
    free_params(sc, args, named.args_len);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

fun resolve_type_ptr(sc: *sema_context.SemaContext, p: *ast_type.TypePtr) type.TypeId {
    val base: type.TypeId = resolve_type_ref(sc, p.pointee);
    ret ptr_to(sc, base);
}

fun resolve_type_secret(sc: *sema_context.SemaContext, s: *ast_type.TypeSecret) type.TypeId {
    val inner: type.TypeId = resolve_type_ref(sc, s.inner);
    if (type.is_error(inner)) { ret type.TYPE_ERROR; }
    val r: res[type.TypeId, fail.Fail] = type.intern_secret(?sc.s.types, inner);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

fun resolve_type_array(sc: *sema_context.SemaContext, tid: ast_id.TypeId, ar: *ast_type.TypeArray, span: lang_source.Span) type.TypeId {
    val elem: type.TypeId = resolve_type_ref(sc, ar.element);
    if (type.is_error(elem)) { ret type.TYPE_ERROR; }

    val inferred_len: u64 = sema_context.inferred_len_of(sc, tid);
    if (ast_id.expr_is_nil(ar.length)) {
        if (inferred_len == sema_product.INFERRED_LEN_FAILED) { ret type.TYPE_ERROR; }
        if (inferred_len == sema_product.INFERRED_LEN_NEEDS_LITERAL) {
            sema_context.report(sc, diagnostic_kind.ARRAY_INFERRED_LENGTH, span, "an inferred array length `[_]` needs an array literal initializer: `val x: [_]T = [_]T{...}`");
            ret type.TYPE_ERROR;
        }
        if (inferred_len == sema_product.INFERRED_LEN_NONE) {
            sema_context.report(sc, diagnostic_kind.ARRAY_INFERRED_LENGTH, span, "an inferred array length `[_]` is only valid as the type of an array literal `[_]T{...}`, of a `val` or `var` initialized by one, or of an `#[embed(...)]` declaration, and not nested in another type");
            ret type.TYPE_ERROR;
        }
        val re: res[type.TypeId, fail.Fail] = type.intern_array(?sc.s.types, elem, inferred_len::u32);
        if (sel re.err) {
            fail.internal(?sc.status, fail.describe(re.err));
            ret type.TYPE_ERROR;
        }
        ret re.ok;
    }

    var cv:  comptime.CTValue;
    val lay: opt[opt[comptime.CTValue]] = fold_layout_intrinsic(sc, ar.length, span);
    if (sel lay.some) {
        val got: opt[comptime.CTValue] = lay.some;
        if (!sel got.some) { ret type.TYPE_ERROR; }
        cv = got.some;
    }
    if (sel lay.none) {
        val len_r: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, ar.length, ?sc.s.interner);
        sema_context.record_eval_result(sc, len_r);
        if (sel len_r.err) {
            sema_context.reportf(sc, diagnostic_kind.ARRAY_LENGTH_NOT_CONST, span, "cannot infer type: array length is not a comptime constant: {}", len_r.err.message);
            ret type.TYPE_ERROR;
        }
        cv = len_r.ok;
    }
    if (cv.kind != comptime.CT_KIND_INT) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LENGTH_VALUE, span, "type mismatch: array length must be an integer");
        ret type.TYPE_ERROR;
    }
    if (comptime.ct_is_negative(cv)) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LENGTH_VALUE, span, "type mismatch: array length must be non-negative");
        ret type.TYPE_ERROR;
    }
    val len_u_o: opt[u64] = comptime.ct_int_u64(cv);
    var len_u:   u64      = 0;
    if (sel len_u_o.some) { len_u = len_u_o.some; }
    if (!sel len_u_o.some || len_u > 4294967295) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LENGTH_VALUE, span, "type mismatch: array length exceeds the maximum of 4294967295 elements");
        ret type.TYPE_ERROR;
    }

    if (inferred_len == sema_product.INFERRED_LEN_FAILED) { ret type.TYPE_ERROR; }
    if (inferred_len != sema_product.INFERRED_LEN_NONE && len_u != inferred_len) {
        report_embed_size(sc, span, len_u, inferred_len);
        ret type.TYPE_ERROR;
    }

    val r: res[type.TypeId, fail.Fail] = type.intern_array(?sc.s.types, elem, len_u::u32);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

fun report_embed_size(sc: *sema_context.SemaContext, span: lang_source.Span, declared: u64, actual: u64) {
    sema_context.reportf(sc, diagnostic_kind.EMBED_SIZE, span, "`embed` declares {} bytes but the file holds {}", declared, actual);
}

fun resolve_type_fun(sc: *sema_context.SemaContext, fn: *ast_type.TypeFun) type.TypeId {
    var ret_type: type.TypeId = type.TYPE_NIL;
    if (!ast_id.type_is_nil(fn.ret_type)) { ret_type = resolve_type_ref(sc, fn.ret_type); }

    if (fn.params_len == 0) {
        val r: res[type.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, nil, 0, fn.c_variadic);
        if (sel r.err) {
            fail.internal(?sc.status, fail.describe(r.err));
            ret type.TYPE_ERROR;
        }
        ret r.ok;
    }

    val pr: res[*type.TypeId, fail.Fail] = allocate_params(sc, fn.params_len);
    if (sel pr.err) {
        fail.internal(?sc.status, fail.describe(pr.err));
        ret type.TYPE_ERROR;
    }
    val params: *type.TypeId = pr.ok;

    var i: u32 = 0;
    for (i < fn.params_len) {
        val pt: ast_id.TypeId = sc.view.a.type_ids.data[fn.params_start + i];
        params[i] = resolve_type_ref(sc, pt);
        i         = i + 1;
    }

    val r: res[type.TypeId, fail.Fail] = type.intern_function(?sc.s.types, ret_type, params, fn.params_len, fn.c_variadic);
    free_params(sc, params, fn.params_len);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

pub fun resolve_type_anon(sc: *sema_context.SemaContext, tid: ast_id.TypeId, fields_start: u32, fields_len: u32, kind: type.TypeKind) type.TypeId {
    val name_id: intern.StrId = synth_anon_name(sc, kind);

    val key: intern.StrId = anon_struct_key(sc, fields_start, fields_len, kind);
    if (intern.str_is_nil(key)) { ret type.TYPE_ERROR; }

    val r: res[type.TypeId, fail.Fail] = type.intern_anonymous(?sc.s.types, name_id, resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), sc.view.a.incarnation, key, kind);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    val ty: type.TypeId = r.ok;

    val fields: err[fail.Fail] = build_field_table(sc, ty, fields_start, fields_len);
    if (sel fields.err) {
        fail.internal(?sc.status, fail.describe(fields.err));
        ret type.TYPE_ERROR;
    }
    ret ty;
}

fun anon_struct_key(sc: *sema_context.SemaContext, fields_start: u32, fields_len: u32, kind: type.TypeKind) intern.StrId {
    val allocated: res[*type.FieldEntry, A.Error] = A.allocate[type.FieldEntry](sc.s.alloc, fields_len::usize);
    if (sel allocated.err) {
        fail.internal(?sc.status, lang_alloc.text(allocated.err));
        ret intern.STR_NIL;
    }
    val entries: *type.FieldEntry = allocated.ok;
    fin { A.deallocate[type.FieldEntry](sc.s.alloc, entries, fields_len::usize); }
    var i: u32 = 0;
    for (i < fields_len) {
        val tn: ast_decl.TypedName = sc.view.a.typed_names.data[fields_start + i];
        entries[i] = type.FieldEntry{name: intern_span_or_nil(sc, tn.name), ty: sema_context.resolved_type_of(sc, tn.ty), deprecation: deprecation.none()};
        if (!sel sc.status.kind.accepted) { ret intern.STR_NIL; }
        if (type.is_error(entries[i].ty)) { ret intern.STR_NIL; }
        i = i + 1;
    }
    val encoded: res[intern.StrId, fail.Fail] = recipe.anonymous(sc.s, sc.view.ctx.env.target.defs, kind, entries, fields_len);
    if (sel encoded.err) {
        fail.internal(?sc.status, fail.describe(encoded.err));
        ret intern.STR_NIL;
    }
    ret encoded.ok;
}

fun synth_anon_name(sc: *sema_context.SemaContext, kind: type.TypeKind) intern.StrId {
    var label: str = "__anon_rec";
    if (kind == type.TYPE_UNI) { label = "__anon_uni"; }
    ret interned(sc, label);
}

pub fun ptr_to(sc: *sema_context.SemaContext, base: type.TypeId) type.TypeId {
    if (type.is_error(base)) { ret type.TYPE_ERROR; }
    val r: res[type.TypeId, fail.Fail] = type.intern_pointer(?sc.s.types, base);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

pub fun prim_or_error(sc: *sema_context.SemaContext, kind: type.TypeKind) type.TypeId {
    val p: opt[type.TypeId] = type.prim(?sc.s.types, kind);
    if (!sel p.some) { ret type.TYPE_ERROR; }
    ret p.some;
}

pub fun intern_span_or_nil(sc: *sema_context.SemaContext, span: lang_source.Span) intern.StrId {
    if (span.len == 0) { ret intern.STR_NIL; }
    val r: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, span.offset, span.len);
    if (sel r.err) {
        fail.internal(?sc.status, lang_alloc.text(r.err));
        ret intern.STR_NIL;
    }
    ret r.ok;
}

pub fun allocate_params(sc: *sema_context.SemaContext, count: u32) res[*type.TypeId, fail.Fail] {
    val allocated: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](sc.s.alloc, count::usize);
    if (sel allocated.err) { ret res[*type.TypeId, fail.Fail].err{fail.refused(allocated.err)}; }
    ret res[*type.TypeId, fail.Fail].ok{allocated.ok};
}

pub fun free_params(sc: *sema_context.SemaContext, params: *type.TypeId, count: u32) {
    A.deallocate[type.TypeId](sc.s.alloc, params, count::usize);
}
