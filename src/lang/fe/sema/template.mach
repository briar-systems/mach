# the template part of a module's interface: what an importer's lowering reads to emit an
# instance of one of the module's generic, comptime-parameter or pack functions. it holds an
# owned copy of the module's syntax, its resolution, its typing and the constants each stage
# bound, every node at the id it has in the module, so an importer's instance typing, keyed by
# those ids, reads against it. a module with no such function holds none
use std.types.bool.bool;
use std.collections.map;
use std.text.string.str_free;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_copy;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.fe.ast;
use mach.lang.fe.comptime;
use mach.lang.fe.resolve;
use lang_source: mach.lang.source;
use mach.lang.type;

# the module's own typing of its syntax, by node id
pub rec Typing {
    expr_type:        *type.TypeId;
    type_resolved_ty: *type.TypeId;
    decl_type:        *type.TypeId;
    expr_count:       u32;
    type_count:       u32;
    decl_count:       u32;
}

# load, resolved, typed: the constants and decisions the load, resolve and sema stages bound
# env: the build and module the module's comptime reads
pub rec Template {
    alloc:    *A.Allocator;
    present:  bool;
    a:        ast.Ast;
    source:   str;
    rr:       resolve.ResolveResult;
    typing:   Typing;
    load:     comptime.Bindings;
    resolved: comptime.Bindings;
    typed:    comptime.Bindings;
    env:      comptime.ComptimeEnv;
}

pub fun none(alloc: *A.Allocator) Template {
    var t: Template = Template{alloc: alloc, present: false, source: nil};
    t.a        = ast.init(alloc, lang_source.FILE_NIL);
    t.rr       = resolve.ResolveResult{alloc: alloc, param_index: map.init[u64, resolve.SymbolId](alloc), constants: comptime.bindings_init(alloc)};
    t.load     = comptime.bindings_init(alloc);
    t.resolved = comptime.bindings_init(alloc);
    t.typed    = comptime.bindings_init(alloc);
    ret t;
}

pub fun dnit(t: *Template) {
    if (t == nil || t.alloc == nil) { ret; }
    ast.dnit(?t.a);
    resolve.result_dnit(?t.rr);
    typing_free(t.alloc, ?t.typing);
    comptime.bindings_dnit(?t.load);
    comptime.bindings_dnit(?t.resolved);
    comptime.bindings_dnit(?t.typed);
    if (t.source != nil) { str_free(t.alloc, t.source); }
    t.source  = nil;
    t.present = false;
    t.alloc   = nil;
}

fun typing_free(alloc: *A.Allocator, ty: *Typing) {
    if (ty.expr_type != nil)        { A.deallocate[type.TypeId](alloc, ty.expr_type, ty.expr_count::usize); }
    if (ty.type_resolved_ty != nil) { A.deallocate[type.TypeId](alloc, ty.type_resolved_ty, ty.type_count::usize); }
    if (ty.decl_type != nil)        { A.deallocate[type.TypeId](alloc, ty.decl_type, ty.decl_count::usize); }
    ty.expr_type        = nil;
    ty.type_resolved_ty = nil;
    ty.decl_type        = nil;
}

# what a template is captured from, all of which it copies
pub rec Captured {
    a:        *ast.Ast;
    source:   str;
    rr:       *resolve.ResolveResult;
    typing:   Typing;
    load:     *comptime.Bindings;
    resolved: *comptime.Bindings;
    typed:    *comptime.Bindings;
    env:      comptime.ComptimeEnv;
}

# an owned copy of everything `from` names, from `alloc`
pub fun capture(alloc: *A.Allocator, from: Captured) res[Template, fail.Fail] {
    var t:    Template = none(alloc);
    var done: bool     = false;
    fin {
        if (!done) { dnit(?t); }
    }
    t.env = from.env;
    val copied: res[ast.Ast, fail.Fail] = ast.copy(from.a, alloc);
    if (sel copied.err) { ret res[Template, fail.Fail].err{copied.err}; }
    ast.dnit(?t.a);
    t.a = copied.ok;
    val text: res[str, types_string.StrError] = str_copy(alloc, from.source);
    if (sel text.err) { ret res[Template, fail.Fail].err{fail.str_refused(text.err)}; }
    t.source = text.ok;
    val rr: res[resolve.ResolveResult, fail.Fail] = resolve.result_copy(from.rr, alloc);
    if (sel rr.err) { ret res[Template, fail.Fail].err{rr.err}; }
    t.rr = rr.ok;
    val typing: err[fail.Fail] = typing_copy(alloc, ?t.typing, ?from.typing);
    if (sel typing.err) { ret res[Template, fail.Fail].err{typing.err}; }
    val load: err[fail.Fail] = bindings_take(alloc, ?t.load, from.load);
    if (sel load.err) { ret res[Template, fail.Fail].err{load.err}; }
    val resolved: err[fail.Fail] = bindings_take(alloc, ?t.resolved, from.resolved);
    if (sel resolved.err) { ret res[Template, fail.Fail].err{resolved.err}; }
    val typed: err[fail.Fail] = bindings_take(alloc, ?t.typed, from.typed);
    if (sel typed.err) { ret res[Template, fail.Fail].err{typed.err}; }
    t.present = true;
    done      = true;
    ret res[Template, fail.Fail].ok{t};
}

fun bindings_take(alloc: *A.Allocator, dst: *comptime.Bindings, src: *comptime.Bindings) err[fail.Fail] {
    if (src == nil) { ret err[fail.Fail].ok{}; }
    val copied: res[comptime.Bindings, fail.Fail] = comptime.bindings_copy(src, alloc);
    if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
    comptime.bindings_dnit(dst);
    @dst = copied.ok;
    ret err[fail.Fail].ok{};
}

fun typing_copy(alloc: *A.Allocator, dst: *Typing, src: *Typing) err[fail.Fail] {
    dst.expr_count = src.expr_count;
    dst.type_count = src.type_count;
    dst.decl_count = src.decl_count;
    val exprs: res[*type.TypeId, fail.Fail] = types_copy(alloc, src.expr_type, src.expr_count);
    if (sel exprs.err) { ret err[fail.Fail].err{exprs.err}; }
    dst.expr_type = exprs.ok;
    val types: res[*type.TypeId, fail.Fail] = types_copy(alloc, src.type_resolved_ty, src.type_count);
    if (sel types.err) { ret err[fail.Fail].err{types.err}; }
    dst.type_resolved_ty = types.ok;
    val decls: res[*type.TypeId, fail.Fail] = types_copy(alloc, src.decl_type, src.decl_count);
    if (sel decls.err) { ret err[fail.Fail].err{decls.err}; }
    dst.decl_type = decls.ok;
    ret err[fail.Fail].ok{};
}

fun types_copy(alloc: *A.Allocator, src: *type.TypeId, n: u32) res[*type.TypeId, fail.Fail] {
    if (src == nil || n == 0) { ret res[*type.TypeId, fail.Fail].ok{nil}; }
    val made: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](alloc, n::usize);
    if (sel made.err) { ret res[*type.TypeId, fail.Fail].err{fail.refused(made.err)}; }
    var i: u32 = 0;
    for (i < n) {
        made.ok[i] = src[i];
        i          = i + 1;
    }
    ret res[*type.TypeId, fail.Fail].ok{made.ok};
}
