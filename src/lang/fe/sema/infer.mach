# typing expressions: each expression's type, the checks on its operands, and the instances
# its calls ask for
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.ct;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use ast_type: mach.lang.fe.ast.type;
use mach.lang.fe.comptime;
use comptime_capability: mach.lang.fe.comptime.capability;
use comptime_failure:    mach.lang.fe.comptime.failure;
use mach.lang.fe.comptime.intrinsic;
use comptime_scope: mach.lang.fe.comptime.scope;
use comptime_value: mach.lang.fe.comptime.value;
use mach.lang.fe.decorator;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.abitype;
use mach.lang.fe.sema.check;
use mach.lang.fe.sema.coerce;
use sema_context:  mach.lang.fe.sema.context;
use sema_declared: mach.lang.fe.sema.declared;
use mach.lang.fe.sema.generics;
use mach.lang.fe.sema.guard;
use sema_handle:   mach.lang.fe.sema.handle;
use sema_instance: mach.lang.fe.sema.instance;
use sema_product:  mach.lang.fe.sema.product;
use mach.lang.fe.sema.typename;
use sema_variadic: mach.lang.fe.sema.variadic;
use mach.lang.fe.transition;
use mach.lang.intern;
use mach.lang.module;
use lang_phase:  mach.lang.phase;
use lang_source: mach.lang.source;
use mach.lang.stack;
use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_prim:  mach.lang.type.prim;
use mach.lang.type.query.subst;
use A: std.allocator;
use T: std.allocator.testing;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_region_equals;

pub fun infer_decl(sc: *sema_context.SemaContext, did: ast_id.DeclId) type_kind.TypeId {
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel d_opt.some) { ret type_kind.TYPE_ERROR; }
    val d: *ast_decl.Decl = d_opt.some;

    if (d.kind == ast_decl.DECL_KIND_FUN) { ret sema_declared.infer_fun_sig(sc, ?d.data.fun_); }
    if (d.kind == ast_decl.DECL_KIND_REC) { ret sema_declared.infer_nominal(sc, did, d.data.rec_.name, ?d.data.rec_, type_kind.TYPE_REC); }
    if (d.kind == ast_decl.DECL_KIND_UNI) { ret sema_declared.infer_nominal_uni(sc, did, d.data.uni_.name, ?d.data.uni_, type_kind.TYPE_UNI); }
    if (d.kind == ast_decl.DECL_KIND_TAG) {
        val t:       *ast_decl.DeclTag                = ?d.data.tag_;
        val created: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, sema_declared.intern_span_or_nil(sc, t.name),
            resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), type_kind.TYPE_TAG);
        if (sel created.err) {
            lang_phase.internal(?sc.status, fail.describe(created.err));
            ret type_kind.TYPE_ERROR;
        }
        val ty: type_kind.TypeId = created.ok;
        if (t.cases_len == 0) { sema_context.report(sc, diagnostic_kind.TAG_NO_CASES, t.name, "a tag requires at least one case"); }
        sema_declared.elaborate_nominal(sc, did, ty, t.cases_start, t.cases_len);
        ret ty;
    }
    if (d.kind == ast_decl.DECL_KIND_DEF) {
        if (ast_id.type_is_nil(d.data.def_.ty) && abitype.declares_abi_type(sc, d)) {
            ret abitype.type_of(sc, d);
        }
        if (ast_id.type_is_nil(d.data.def_.ty)) { ret sema_handle.type_of(sc, did, d); }
        ret sema_context.resolved_type_of(sc, d.data.def_.ty);
    }
    if (d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) {
        ret infer_binding(sc, ?d.data.bind);
    }
    if (d.kind == ast_decl.DECL_KIND_USE || d.kind == ast_decl.DECL_KIND_FWD || d.kind == ast_decl.DECL_KIND_TEST
        || d.kind == ast_decl.DECL_KIND_COMPTIME_IF || d.kind == ast_decl.DECL_KIND_COMPTIME_DIRECTIVE || d.kind == ast_decl.DECL_KIND_ERROR) { ret type_kind.TYPE_NIL; }
    lang_phase.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "DeclKind", d.kind::u32)));
    ret type_kind.TYPE_ERROR;
}

fun infer_binding(sc: *sema_context.SemaContext, b: *ast_decl.DeclBind) type_kind.TypeId {
    if (!ast_id.type_is_nil(b.ty)) {
        ret sema_context.resolved_type_of(sc, b.ty);
    }
    if (!ast_id.expr_is_nil(b.init)) {
        ret infer_expr(sc, b.init);
    }
    ret type_kind.TYPE_ERROR;
}

pub fun infer_expr(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    if (ast_id.expr_is_nil(eid)) { ret type_kind.TYPE_ERROR; }
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret type_kind.TYPE_ERROR; }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, e.span);
        ret type_kind.TYPE_ERROR;
    }

    var t: type_kind.TypeId = type_kind.TYPE_ERROR;

    if (e.kind == ast_expr.EXPR_KIND_LIT_INT) {
        t = lit_int_type(sc, e);
        check_lit_int_range(sc, e, t, false, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_LIT_FLOAT) {
        if (e.data.lit_float.suffix != ast_expr.LIT_SUFFIX_NONE) { t = sema_declared.prim_or_error(sc, e.data.lit_float.suffix); }
        or                                                       { t = sema_declared.prim_or_error(sc, type_kind.TYPE_F64); }
    }
    or (e.kind == ast_expr.EXPR_KIND_LIT_CHAR) {
        t = sema_declared.prim_or_error(sc, type_kind.TYPE_U8);
    }
    or (e.kind == ast_expr.EXPR_KIND_LIT_STR) {
        t = sema_declared.ptr_to(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U8));
    }
    or (e.kind == ast_expr.EXPR_KIND_LIT_NIL) {
        t = sema_declared.ptr_to(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U8));
    }
    or (e.kind == ast_expr.EXPR_KIND_IDENT) {
        t = infer_ident(sc, eid);
        check_writeonly_read(sc, eid, t, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_COMPTIME_IDENT) {
        val ev: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
        sema_context.record_eval_result(sc, ev);
        if (sel ev.err) {
            sema_context.report(sc, ev.err.diag, e.span, ev.err.message);
        }
        t = type_kind.TYPE_ERROR;
    }
    or (e.kind == ast_expr.EXPR_KIND_BINARY) {
        t = infer_binary(sc, eid, ?e.data.binary, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_UNARY) {
        t = infer_unary(sc, ?e.data.unary, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_CALL && intrinsic.is_path_call(sc.view.a, eid)) {
        t = infer_comptime_path(sc, eid, e.span);
        if (type_kind.is_nil(t)) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_PATH_UNEVALUABLE, e.span, "this comptime path call cannot be evaluated here");
            t = type_kind.TYPE_ERROR;
        }
    }
    or (e.kind == ast_expr.EXPR_KIND_CALL) {
        t = infer_call(sc, eid, ?e.data.call, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        t = infer_generic_instance(sc, eid, ?e.data.call, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_INDEX) {
        t = infer_index(sc, ?e.data.index, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        t = infer_member(sc, eid, ?e.data.member, e.span);
        check_writeonly_read(sc, eid, t, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_SEL) {
        t = infer_sel(sc, ?e.data.sel, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_PROJECT) {
        t = infer_project(sc, ?e.data.project, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_SPREAD) {
        t = infer_spread(sc, ?e.data.spread, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_CAST) {
        t = infer_cast(sc, ?e.data.cast, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_STRIP) {
        t = infer_strip(sc, ?e.data.strip, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_ARRAY_LIT) {
        t = infer_array_lit(sc, ?e.data.array_lit, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT) {
        t = infer_struct_lit(sc, ?e.data.struct_lit, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_VECTOR_LIT) {
        t = infer_vector_lit(sc, ?e.data.vector_lit, e.span);
    }
    or (e.kind == ast_expr.EXPR_KIND_TYPE_REF) {
        sema_context.report(sc, diagnostic_kind.NAME_NOT_VALUE, e.span, "a type name is not a value; this position takes a value expression");
        t = type_kind.TYPE_ERROR;
    }
    or (e.kind != ast_expr.EXPR_KIND_ERROR) {
        lang_phase.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "ExprKind", e.kind::u32)));
    }

    sema_context.expr_type_set(sc, eid, t);
    ret t;
}

fun infer_ident(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    val sym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel sym_opt.some) { ret report_unbound_ident(sc, eid); }
    val sym: *resolve.Symbol = sym_opt.some;

    val pe: type_kind.TypeId = pack_elem_loop_var_type(sc, sym);
    if (!type_kind.is_nil(pe)) { ret pe; }

    val ae: type_kind.TypeId = array_elem_loop_var_type(sc, sym);
    if (!type_kind.is_nil(ae)) { ret ae; }

    val never: res[bool, fail.Fail] = report_never_value(sc, eid, sym);
    if (sel never.err) { ret type_kind.TYPE_ERROR; }
    if (never.ok)      { ret type_kind.TYPE_ERROR; }

    if (!ast_id.expr_same(eid, sc.walk.callee_eid) && ident_is_comptime_param_fn(sc, sym)) {
        ret report_comptime_param_fn_ref(sc, eid);
    }

    val declared: type_kind.TypeId = sema_context.decl_type_for(sc, sym);
    # a declaration of this module not yet typed, read by an annotation resolved before the
    # declarations are, as an array length is, is typed where it is read
    if (type_kind.is_nil(declared) && !ast_id.decl_is_nil(sym.decl) && module.same(resolve.origin_of(sc.s, sym), sc.view.own_module)) { ret infer_decl(sc, sym.decl); }
    ret declared;
}

fun report_unbound_ident(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    # gate support probes can visit identifiers before their declarations are active.
    if (sc.walk.silent) { ret type_kind.TYPE_ERROR; }
    if (sc.view.rr != nil && sc.view.rr.expr_resolved != nil && ast_id.expr_index(eid) < sc.view.rr.expr_count
        && resolve.symbol_is_rejected(sc.view.rr.expr_resolved[ast_id.expr_index(eid)])) {
        lang_phase.reject(?sc.status);
        ret type_kind.TYPE_ERROR;
    }
    # a name resolve left for this arm: this walk is what selected it, so it is reported now
    if (sc.view.rr != nil && sc.view.rr.expr_resolved != nil && ast_id.expr_index(eid) < sc.view.rr.expr_count
        && resolve.symbol_deferred(sc.view.rr.expr_resolved[ast_id.expr_index(eid)])) {
        val d_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
        if (sel d_opt.ok) {
            var prefix: str = "unresolved identifier `";
            if (resolve.symbol_same(sc.view.rr.expr_resolved[ast_id.expr_index(eid)], resolve.SYMBOL_DEFERRED_TYPE)) { prefix = "unresolved type name `"; }
            var at: lang_source.Span = d_opt.ok.span;
            if (d_opt.ok.kind == ast_expr.EXPR_KIND_IDENT) { at = d_opt.ok.data.ident.tok; }
            if (d_opt.ok.kind == ast_expr.EXPR_KIND_MEMBER) {
                at     = d_opt.ok.data.member.name;
                prefix = "unresolved module member `";
            }
            sema_context.report_deferred_name(sc, diagnostic_kind.NAME_UNRESOLVED, at, prefix);
        }
        ret type_kind.TYPE_ERROR;
    }
    # a resolution that refused the module may have stopped short of this name, and said so
    if (sc.view.rr != nil && sel sc.view.rr.status.kind.rejected) { ret type_kind.TYPE_ERROR; }
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.ok) {
        sema_context.report_internal(sc, e_opt.ok.span, "internal: this identifier reached type inference unbound; the name resolver neither bound it nor reported it");
    }
    ret type_kind.TYPE_ERROR;
}

fun pack_elem_loop_var_type(sc: *sema_context.SemaContext, sym: *resolve.Symbol) type_kind.TypeId {
    if (sym.kind != resolve.SYM_VAL)                  { ret type_kind.TYPE_NIL; }
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret type_kind.TYPE_NIL; }
    if (!ast_id.decl_is_nil(sym.decl))                { ret type_kind.TYPE_NIL; }
    val nc: opt[comptime_scope.NamedConst] = comptime_scope.lookup(sc.view.ctx, sym.name);
    if (!sel nc.some) { ret type_kind.TYPE_NIL; }
    val cv: comptime_value.CTValue = nc.some.value;
    if (cv.kind != comptime_value.CT_KIND_PACK_ELEM) { ret type_kind.TYPE_NIL; }
    ret cv.data.pelem.ty::type_kind.TypeId;
}

# a `$each` loop variable over a constant array names an element at the array's element type
fun array_elem_loop_var_type(sc: *sema_context.SemaContext, sym: *resolve.Symbol) type_kind.TypeId {
    if (sym.kind != resolve.SYM_VAL)                  { ret type_kind.TYPE_NIL; }
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret type_kind.TYPE_NIL; }
    if (!ast_id.decl_is_nil(sym.decl))                { ret type_kind.TYPE_NIL; }
    val nc: opt[comptime_scope.NamedConst] = comptime_scope.lookup(sc.view.ctx, sym.name);
    if (!sel nc.some) { ret type_kind.TYPE_NIL; }
    val cv: comptime_value.CTValue = nc.some.value;
    if (cv.kind != comptime_value.CT_KIND_NODE) { ret type_kind.TYPE_NIL; }
    ret cv.data.node.ty::type_kind.TypeId;
}

fun int_prim_kind_for(bits: u8, unsigned: bool) opt[type_kind.TypeKind] {
    if (bits == 0) { ret opt[type_kind.TypeKind].none{}; }
    ret type_prim.int_kind_for(bits::u32, !unsigned);
}

fun ident_is_comptime_param_fn(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)  { ret false; }
    if (sym.kind != resolve.SYM_IMPORTED && ast_id.decl_is_nil(sym.decl)) { ret false; }
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    val a:       *ast.Ast                   = current.definition.parsed.a;
    val d_opt:   opt[*ast_decl.Decl]        = ast.get_decl(a, current.symbol.decl);
    if (!sel d_opt.some) { ret false; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret false; }
    val f: *ast_decl.DeclFun = ?d.data.fun_;
    var i: u32               = 0;
    for (i < f.params_len) {
        if (a.typed_names.data[f.params_start + i].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun report_never_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId, sym: *resolve.Symbol) res[bool, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[bool, fail.Fail].err{e_opt.err}; }
    val span: lang_source.Span = e_opt.ok.span;

    if (sym.kind == resolve.SYM_USE) {
        sema_context.report(sc, diagnostic_kind.NAME_NOT_VALUE, span, "a module alias is not a value; name one of the module's members");
        ret res[bool, fail.Fail].ok{true};
    }
    if (sym.kind == resolve.SYM_GENERIC) {
        check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a generic type parameter, not a value; use it in type position or a comptime intrinsic like `$size_of(T)`");
        ret res[bool, fail.Fail].ok{true};
    }
    if (sym.kind == resolve.SYM_PRIM) {
        check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a primitive type, not a value; write a literal of that type");
        ret res[bool, fail.Fail].ok{true};
    }
    if (sym.kind == resolve.SYM_VECTOR) {
        check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a vector type, not a value; write a literal of that type");
        ret res[bool, fail.Fail].ok{true};
    }

    var dk: ast_decl.DeclKind = ast_decl.DECL_KIND_ERROR;
    if (sym.kind == resolve.SYM_REC)      { dk = ast_decl.DECL_KIND_REC; }
    or (sym.kind == resolve.SYM_UNI)      { dk = ast_decl.DECL_KIND_UNI; }
    or (sym.kind == resolve.SYM_TAG)      { dk = ast_decl.DECL_KIND_TAG; }
    or (sym.kind == resolve.SYM_DEF)      { dk = ast_decl.DECL_KIND_DEF; }
    or (sym.kind == resolve.SYM_IMPORTED) { dk = symbol_decl_kind(sc, sym); }

    if (dk == ast_decl.DECL_KIND_REC) {
        check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a record type, not a value; construct an instance with `Type{ ... }`");
        ret res[bool, fail.Fail].ok{true};
    }
    if (dk == ast_decl.DECL_KIND_UNI) {
        check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a union type, not a value; construct an instance with `Type{ ... }`");
        ret res[bool, fail.Fail].ok{true};
    }
    if (dk == ast_decl.DECL_KIND_TAG) {
        check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a tag type. select a case with `Type{case}`");
        ret res[bool, fail.Fail].ok{true};
    }
    if (dk == ast_decl.DECL_KIND_DEF) {
        if (type.is_handle(?sc.s.types, sema_context.decl_type_for(sc, sym))) {
            check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a handle type, not a value; a handle has no literal because the program does not own its representation - declare a binding of it and hand that to an operation");
            ret res[bool, fail.Fail].ok{true};
        }
        check.report_named(sc, diagnostic_kind.NAME_NOT_VALUE, span, "`", sym.name, "` is a type alias, not a value; use a value of the aliased type");
        ret res[bool, fail.Fail].ok{true};
    }
    ret res[bool, fail.Fail].ok{false};
}

fun symbol_decl_kind(sc: *sema_context.SemaContext, sym: *resolve.Symbol) ast_decl.DeclKind {
    var kind: resolve.SymKind = sym.kind;
    if (kind == resolve.SYM_IMPORTED) { kind = sym.definition_kind; }
    if (kind == resolve.SYM_FUN)      { ret ast_decl.DECL_KIND_FUN; }
    if (kind == resolve.SYM_VAL)      { ret ast_decl.DECL_KIND_VAL; }
    if (kind == resolve.SYM_VAR)      { ret ast_decl.DECL_KIND_VAR; }
    if (kind == resolve.SYM_REC)      { ret ast_decl.DECL_KIND_REC; }
    if (kind == resolve.SYM_UNI)      { ret ast_decl.DECL_KIND_UNI; }
    if (kind == resolve.SYM_TAG)      { ret ast_decl.DECL_KIND_TAG; }
    if (kind == resolve.SYM_DEF)      { ret ast_decl.DECL_KIND_DEF; }
    ret ast_decl.DECL_KIND_ERROR;
}

fun report_comptime_param_fn_ref(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.ok) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_PARAM_FN_VALUE, e_opt.ok.span, "cannot reference a comptime-parameter function as a value");
    }
    ret type_kind.TYPE_ERROR;
}

fun infer_binary(sc: *sema_context.SemaContext, eid: ast_id.ExprId, b: *ast_expr.ExprBinary, span: lang_source.Span) type_kind.TypeId {
    if (b.op > ast_expr.BIN_ASSIGN) {
        lang_phase.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "BinOp", b.op::u32)));
        ret type_kind.TYPE_ERROR;
    }
    if (b.op == ast_expr.BIN_ASSIGN) { ret infer_assign(sc, b, span); }

    val lhs_field: res[bool, fail.Fail] = is_field_type_operand(sc, b.lhs);
    if (sel lhs_field.err) { ret type_kind.TYPE_ERROR; }
    val rhs_field: res[bool, fail.Fail] = is_field_type_operand(sc, b.rhs);
    if (sel rhs_field.err) { ret type_kind.TYPE_ERROR; }
    if (intrinsic.is_type_comparison_binary(sc.view.a, sc.view.source, b, lhs_field.ok, rhs_field.ok)) {
        ret infer_type_comparison(sc, b, span);
    }

    var lt: type_kind.TypeId = infer_expr(sc, b.lhs);
    # `&&` short-circuits, so a `sel P.c` left operand guards the right operand and nothing else
    var and_guard: sema_context.Guard;
    var opened:    bool = false;
    if (b.op == ast_expr.BIN_AND) {
        val sel_r: res[bool, fail.Fail] = guard.open_sel(sc, b.lhs, ?and_guard);
        if (sel sel_r.err) { ret type_kind.TYPE_ERROR; }
        opened = sel_r.ok;
    }
    var rt: type_kind.TypeId = infer_expr(sc, b.rhs);
    if (opened)                                           { guard.close(sc, ?and_guard); }
    if (type_kind.is_error(lt) || type_kind.is_error(rt)) { ret type_kind.TYPE_ERROR; }

    val lhs_is_sel: bool = type.is_case_selector(?sc.s.types, lt);
    val rhs_is_sel: bool = type.is_case_selector(?sc.s.types, rt);

    if (lhs_is_sel) {
        sema_context.report(sc, diagnostic_kind.NAME_NOT_VALUE, span, "a case selector is not a value; test a case with `sel place.case`");
        ret type_kind.TYPE_ERROR;
    }
    if (rhs_is_sel) {
        sema_context.report(sc, diagnostic_kind.NAME_NOT_VALUE, span, "a case selector is not a value; test a case with `sel place.case`");
        ret type_kind.TYPE_ERROR;
    }

    val lhs_secret:    bool = type.is_secret(?sc.s.types, lt);
    val either_secret: bool = lhs_secret || type.is_secret(?sc.s.types, rt);

    if (sema_context.awaits_instance(sc, lt) || sema_context.awaits_instance(sc, rt)) {
        ret deferred_binary(sc, b, lt, rt, either_secret);
    }

    if (type.is_vector(?sc.s.types, lt) || type.is_vector(?sc.s.types, rt)) {
        if (b.op == ast_expr.BIN_SHL || b.op == ast_expr.BIN_SHR) { ret infer_vector_shift(sc, b, lt, rt, either_secret, span); }
        ret infer_vector_binary(sc, b.op, lt, rt, either_secret, span);
    }

    gate_ct_always(sc, scalar_binop_ct_op(b.op, type.is_float(?sc.s.types, lt) || type.is_float(?sc.s.types, rt)), either_secret, span);

    val u1t: type_kind.TypeId = sema_declared.prim_or_error(sc, type_kind.TYPE_U1);
    if (b.op == ast_expr.BIN_AND || b.op == ast_expr.BIN_OR) {
        if (!type.is_u1(?sc.s.types, lt) || !type.is_u1(?sc.s.types, rt)) {
            var msg: str = "type mismatch: logical operands must have type u1";
            if (sc.walk.in_comptime_gate) { msg = "logical operator requires u1 operands"; }
            sema_context.report(sc, diagnostic_kind.OPERATOR_OPERAND_TYPE, span, msg);
            ret type_kind.TYPE_ERROR;
        }
        if (lhs_secret) {
            sema_context.report(sc, diagnostic_kind.SECRET_BRANCH, span, "secret value used as the left operand of a short-circuiting `&&` / `||`; the branch it controls leaks through control flow");
        }
        ret join_secret(sc, u1t, either_secret);
    }

    if (u1_unanswered(sc, b, lt, rt)) {
        check.refuse_form(sc, transition.U1_AS_U8, span);
        ret type_kind.TYPE_ERROR;
    }

    val co: opt[type_kind.TypeId] = unify_literals(sc, b.lhs, lt, b.rhs, rt);
    if (sel co.some) {
        lt = co.some;
        if (type_kind.is_error(lt)) { ret type_kind.TYPE_ERROR; }
        rt = lt;
    }

    val both_int:    bool = type.is_integer(?sc.s.types, lt) && type.is_integer(?sc.s.types, rt);
    val operands_ok: bool = type_kind.same(lt, rt) || both_int;
    val same_repr:   bool = type_kind.same(type.strip_secret(?sc.s.types, lt), type.strip_secret(?sc.s.types, rt));

    val both_float:    bool = type.is_float(?sc.s.types, lt) && type.is_float(?sc.s.types, rt);
    val int_float_mix: bool = (type.is_integer(?sc.s.types, lt) && type.is_float(?sc.s.types, rt))
        || (type.is_float(?sc.s.types, lt) && type.is_integer(?sc.s.types, rt));

    if (b.op == ast_expr.BIN_EQ || b.op == ast_expr.BIN_NEQ) {
        if (is_aggregate(sc, lt) || is_aggregate(sc, rt)) {
            report_aggregate_eq(sc, span, lt, rt);
            ret type_kind.TYPE_ERROR;
        }
        if (int_float_mix) {
            report_int_float_cmp(sc, span);
            ret type_kind.TYPE_ERROR;
        }
        val addr_ok: bool = type.is_pointer_like(?sc.s.types, lt) && type.is_pointer_like(?sc.s.types, rt);
        if (!operands_ok && !both_float && !addr_ok) {
            type_mismatch(sc, span, lt, rt);
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, u1t, either_secret);
    }
    if (b.op == ast_expr.BIN_LT || b.op == ast_expr.BIN_LEQ || b.op == ast_expr.BIN_GT || b.op == ast_expr.BIN_GEQ) {
        if (int_float_mix) {
            report_int_float_cmp(sc, span);
            ret type_kind.TYPE_ERROR;
        }
        # an address is public whatever its pointee's secrecy, and ordering
        # yields only a bool, so it reveals no more than the permitted `==`
        val order_ok: bool = type.is_pointer_like(?sc.s.types, lt) && type.is_pointer_like(?sc.s.types, rt);
        if (!both_int && !both_float && !order_ok) {
            refuse_operator(sc, span, lt, rt, ORDERING_SUFFIX, "type has no ordering");
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, u1t, either_secret);
    }
    if (b.op == ast_expr.BIN_SHL || b.op == ast_expr.BIN_SHR) {
        if (!both_int) {
            refuse_operator(sc, span, lt, rt, SHIFT_SUFFIX, "type cannot be shifted");
            ret type_kind.TYPE_ERROR;
        }
        # a literal's count is checked at the type its context gives it, once that is final
        val untyped: res[bool, fail.Fail] = coerce.is_untyped_int_literal(sc, eid);
        if (sel untyped.err)                                              { ret type_kind.TYPE_ERROR; }
        if (!untyped.ok && !check.check_shift_count(sc, span, lt, b.rhs)) { ret type_kind.TYPE_ERROR; }
        ret join_secret(sc, lt, either_secret);
    }
    if (b.op == ast_expr.BIN_BIT_AND || b.op == ast_expr.BIN_BIT_OR || b.op == ast_expr.BIN_BIT_XOR) {
        if (!both_int) {
            refuse_operator(sc, span, lt, rt, BITWISE_SUFFIX, "type has no bitwise operators");
            ret type_kind.TYPE_ERROR;
        }
        if (!same_repr) {
            report_operand_width(sc, span, lt, rt);
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, lt, either_secret);
    }
    if (!operands_ok || !type.is_numeric(?sc.s.types, lt)) {
        refuse_operator(sc, span, lt, rt, ARITHMETIC_SUFFIX, "type has no arithmetic");
        ret type_kind.TYPE_ERROR;
    }
    if (!same_repr) {
        report_operand_width(sc, span, lt, rt);
        ret type_kind.TYPE_ERROR;
    }
    ret join_secret(sc, lt, either_secret);
}

# a u1 operand of an operator that has no u1 answer: arithmetic and a shift have none, and
# a bitwise operator has none beside anything but a u1 or a literal a u1 holds
fun u1_unanswered(sc: *sema_context.SemaContext, b: *ast_expr.ExprBinary, lt: type_kind.TypeId, rt: type_kind.TypeId) bool {
    val left:  bool = type.is_u1(?sc.s.types, lt);
    val right: bool = type.is_u1(?sc.s.types, rt);
    if (!left && !right) { ret false; }
    if (b.op == ast_expr.BIN_EQ || b.op == ast_expr.BIN_NEQ || b.op == ast_expr.BIN_LT || b.op == ast_expr.BIN_LEQ
        || b.op == ast_expr.BIN_GT || b.op == ast_expr.BIN_GEQ) { ret false; }
    if (b.op != ast_expr.BIN_BIT_AND && b.op != ast_expr.BIN_BIT_OR && b.op != ast_expr.BIN_BIT_XOR) { ret true; }
    if (left && right)                                                                               { ret false; }
    var other: ast_id.ExprId    = b.lhs;
    var truth: type_kind.TypeId = rt;
    if (left) {
        other = b.rhs;
        truth = lt;
    }
    val untyped: res[bool, fail.Fail] = coerce.is_untyped_int_literal(sc, other);
    if (sel untyped.err) { ret true; }
    if (!untyped.ok)     { ret true; }
    val fits: res[coerce.CoerceResult, fail.Fail] = coerce.probe_literal_range(sc, other, truth);
    if (sel fits.err) { ret true; }
    ret fits.ok.kind == coerce.COERCE_OUT_OF_RANGE;
}

val ORDERING_SUFFIX:   str = "` has no ordering: `<`, `<=`, `>` and `>=` order integers and floats";
val ARITHMETIC_SUFFIX: str = "` has no arithmetic: `+`, `-`, `*`, `/` and `%` apply to integers and floats";
val BITWISE_SUFFIX:    str = "` has no bitwise operators: `&`, `|` and `^` apply to integers";
val SHIFT_SUFFIX:      str = "` cannot be shifted: `<<` and `>>` apply to integers";

# operands that agree leave the type as the only thing refusing the operator, which is what
# an instantiation refused at its type argument reads as; a genuine pair still reads as one
fun refuse_operator(sc: *sema_context.SemaContext, span: lang_source.Span, lt: type_kind.TypeId, rt: type_kind.TypeId, suffix: str, fallback: str) {
    if (!type_kind.same(lt, rt)) {
        type_mismatch(sc, span, lt, rt);
        ret;
    }
    check.report_typed(sc, diagnostic_kind.OPERATOR_OPERAND_TYPE, span, "`", lt, suffix);
}

# an operand typed by a type parameter answers no operand predicate, so the operator is
# decided at the instantiation and the template only carries the result's shape forward:
# a comparison is u1 either way, and every other operator has its operands' type
fun deferred_binary(sc: *sema_context.SemaContext, b: *ast_expr.ExprBinary, lt: type_kind.TypeId, rt: type_kind.TypeId, either_secret: bool) type_kind.TypeId {
    coerce_operand_to_parameter(sc, b.lhs, lt, b.rhs, rt);
    coerce_operand_to_parameter(sc, b.rhs, rt, b.lhs, lt);

    val op: ast_expr.BinOp = b.op;
    if (op == ast_expr.BIN_EQ || op == ast_expr.BIN_NEQ || op == ast_expr.BIN_LT || op == ast_expr.BIN_LEQ
        || op == ast_expr.BIN_GT || op == ast_expr.BIN_GEQ || op == ast_expr.BIN_AND || op == ast_expr.BIN_OR) {
        ret join_secret(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U1), either_secret);
    }
    if (sema_context.awaits_instance(sc, lt)) { ret join_secret(sc, lt, either_secret); }
    ret join_secret(sc, rt, either_secret);
}

# a literal beside a parameter-typed operand takes that parameter, so the two agree once
# the instance substitutes and the literal is not left at its own default width
fun coerce_operand_to_parameter(sc: *sema_context.SemaContext, eid: ast_id.ExprId, ty: type_kind.TypeId, other: ast_id.ExprId, other_ty: type_kind.TypeId) {
    if (sema_context.awaits_instance(sc, ty))        { ret; }
    if (!sema_context.awaits_instance(sc, other_ty)) { ret; }
    val coerced: res[coerce.CoerceResult, fail.Fail] = coerce.try_coerce_literal(sc, eid, other_ty);
    if (sel coerced.err) { ret; }
}

fun infer_vector_binary(sc: *sema_context.SemaContext, op: ast_expr.BinOp, lt: type_kind.TypeId, rt: type_kind.TypeId, either_secret: bool, span: lang_source.Span) type_kind.TypeId {
    val lbase: type_kind.TypeId = type.strip_secret(?sc.s.types, lt);
    val rbase: type_kind.TypeId = type.strip_secret(?sc.s.types, rt);

    if (!type.is_vector(?sc.s.types, lt) || !type.is_vector(?sc.s.types, rt) || !type_kind.same(lbase, rbase)) {
        type_mismatch(sc, span, lt, rt);
        ret type_kind.TYPE_ERROR;
    }

    val d:          type_prim.PrimDesc = type_prim.prim_desc(type.vector_element(?sc.s.types, lbase));
    val float_lane: bool               = d.class == type_prim.PRIM_CLASS_FLOAT;
    val int_lane:   bool               = d.class == type_prim.PRIM_CLASS_INT;

    if (float_lane) {
        gate_ct_always(sc, ct.CT_OP_FLOAT, either_secret, span);
    }

    if (op == ast_expr.BIN_EQ || op == ast_expr.BIN_NEQ || op == ast_expr.BIN_LT
        || op == ast_expr.BIN_LEQ || op == ast_expr.BIN_GT || op == ast_expr.BIN_GEQ) {
        val mr: res[type_kind.TypeId, fail.Fail] = type.vector_mask(?sc.s.types, lbase);
        if (sel mr.err) {
            lang_phase.internal(?sc.status, fail.describe(mr.err));
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, mr.ok, either_secret);
    }

    if (op == ast_expr.BIN_BIT_AND || op == ast_expr.BIN_BIT_OR || op == ast_expr.BIN_BIT_XOR) {
        if (!int_lane) {
            sema_context.report(sc, diagnostic_kind.VECTOR_OPERAND_TYPE, span, "type mismatch: bitwise vector operands must have integer lanes");
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, lbase, either_secret);
    }

    if (op == ast_expr.BIN_MOD) {
        sema_context.report(sc, diagnostic_kind.VECTOR_OPERATOR_UNSUPPORTED, span, "vector `%` is not supported");
        ret type_kind.TYPE_ERROR;
    }

    if (op == ast_expr.BIN_DIV) {
        if (int_lane) { gate_ct_always(sc, ct.CT_OP_INT_DIVMOD, either_secret, span); }
        ret join_secret(sc, lbase, either_secret);
    }

    if (op == ast_expr.BIN_MUL) {
        if (float_lane || int_lane) { ret join_secret(sc, lbase, either_secret); }
        type_mismatch(sc, span, lt, rt);
        ret type_kind.TYPE_ERROR;
    }

    if (op == ast_expr.BIN_ADD || op == ast_expr.BIN_SUB) {
        if (float_lane || int_lane) { ret join_secret(sc, lbase, either_secret); }
        type_mismatch(sc, span, lt, rt);
        ret type_kind.TYPE_ERROR;
    }

    if (op == ast_expr.BIN_AND || op == ast_expr.BIN_OR || op == ast_expr.BIN_ASSIGN) {
        sema_context.report(sc, diagnostic_kind.VECTOR_OPERATOR_UNSUPPORTED, span, "operator not supported on vector operands");
        ret type_kind.TYPE_ERROR;
    }

    ret unknown_binop(sc, op);
}

# `vec << vec` and `vec >> vec` shift each lane of the left operand by the
# lane of the count at the same position, both the same integer vector type
#. there is no vector-by-scalar form: a uniform count is the same
# count in every lane of a literal, which keeps the operators' shape rule and
# is what lowers to the one-count shift. each lane follows the scalar shift,
# so a lane count that is a constant at or above the lane width is refused
fun infer_vector_shift(sc: *sema_context.SemaContext, b: *ast_expr.ExprBinary, lt: type_kind.TypeId, rt: type_kind.TypeId, either_secret: bool, span: lang_source.Span) type_kind.TypeId {
    val lvec: bool = type.is_vector(?sc.s.types, lt);
    val rvec: bool = type.is_vector(?sc.s.types, rt);
    if (!lvec || !rvec) {
        var vty: type_kind.TypeId = type.strip_secret(?sc.s.types, lt);
        if (!lvec) { vty = type.strip_secret(?sc.s.types, rt); }
        check.report_typed(sc, diagnostic_kind.VECTOR_SHIFT_COUNT, span, "a vector shift count is a vector of the shifted type, never a scalar: write `", vty, "{c, c, ...}` with the count in every lane for a uniform shift");
        ret type_kind.TYPE_ERROR;
    }
    val lbase: type_kind.TypeId = type.strip_secret(?sc.s.types, lt);
    val rbase: type_kind.TypeId = type.strip_secret(?sc.s.types, rt);
    if (!type_kind.same(lbase, rbase)) {
        type_mismatch(sc, span, lt, rt);
        ret type_kind.TYPE_ERROR;
    }
    val lane: type_kind.TypeId = sema_declared.prim_or_error(sc, type.vector_element(?sc.s.types, lbase));
    if (type_kind.is_error(lane)) { ret type_kind.TYPE_ERROR; }
    if (!type.is_integer(?sc.s.types, lane)) {
        check.report_typed(sc, diagnostic_kind.VECTOR_OPERAND_TYPE, span, "`", lbase, "` cannot be shifted: `<<` and `>>` apply to integer lanes");
        ret type_kind.TYPE_ERROR;
    }
    if (!check_lane_counts(sc, span, lane, b.rhs)) { ret type_kind.TYPE_ERROR; }
    gate_ct_always(sc, ct.CT_OP_VAR_SHIFT, either_secret, span);
    ret join_secret(sc, lbase, either_secret);
}

# every lane of a literal count is held to the scalar shift's constant rule
fun check_lane_counts(sc: *sema_context.SemaContext, span: lang_source.Span, lane: type_kind.TypeId, count: ast_id.ExprId) bool {
    val ce: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, count);
    if (sel ce.err) { ret false; }
    var start: u32 = 0;
    var len:   u32 = 0;
    if (ce.ok.kind == ast_expr.EXPR_KIND_VECTOR_LIT) {
        start = ce.ok.data.vector_lit.elems_start;
        len   = ce.ok.data.vector_lit.elems_len;
    }
    or (ce.ok.kind == ast_expr.EXPR_KIND_STRUCT_LIT) {
        start = ce.ok.data.struct_lit.elems_start;
        len   = ce.ok.data.struct_lit.elems_len;
    }
    var i: u32 = 0;
    for (i < len) {
        val ix: u32 = start + i;
        if (ix::usize >= sc.view.a.expr_ids.len)                                   { ret true; }
        if (!check.check_shift_count(sc, span, lane, sc.view.a.expr_ids.data[ix])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a binary operator no arm of the vector dispatch names: a defect, since the
# caller already refused a tag past the catalog
fun unknown_binop(sc: *sema_context.SemaContext, op: ast_expr.BinOp) type_kind.TypeId {
    lang_phase.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "BinOp", op::u32)));
    ret type_kind.TYPE_ERROR;
}

# the constant-time operation class of a scalar operator; CT_OP_NONE for every
# other operator, which is constant-time on every target (a partition,
# enumerated by its test)
fun scalar_binop_ct_op(op: ast_expr.BinOp, is_float: bool) ct.CtOp {
    if (is_float)                                         { ret ct.CT_OP_FLOAT; }
    if (op == ast_expr.BIN_DIV || op == ast_expr.BIN_MOD) { ret ct.CT_OP_INT_DIVMOD; }
    if (op == ast_expr.BIN_MUL)                           { ret ct.CT_OP_INT_MUL; }
    if (op == ast_expr.BIN_SHL || op == ast_expr.BIN_SHR) { ret ct.CT_OP_VAR_SHIFT; }
    ret ct.CT_OP_NONE;
}

fun gate_ct_always(sc: *sema_context.SemaContext, cop: ct.CtOp, either_secret: bool, span: lang_source.Span) {
    if (!either_secret) { ret; }
    val declared: opt[ct.CtCap] = ct.ct_cap(cop);
    if (sel declared.none) {
        lang_phase.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "CtOp", cop::u32)));
        ret;
    }
    if (!ct.cap_at_sema(declared.some)) { ret; }
    if (cop == ct.CT_OP_FLOAT) {
        sema_context.report(sc, diagnostic_kind.SECRET_VARIABLE_LATENCY, span, "secret value used as an operand of a variable-latency floating-point operation; the FP unit's timing can depend on the secret operand");
        ret;
    }
    sema_context.report(sc, diagnostic_kind.SECRET_VARIABLE_LATENCY, span, "secret value used as an operand of a variable-latency `/` or `%`; a secret divisor or dividend leaks through timing");
}

fun join_secret(sc: *sema_context.SemaContext, base: type_kind.TypeId, secret: bool) type_kind.TypeId {
    val pub: type_kind.TypeId = type.strip_secret(?sc.s.types, base);
    if (!secret) { ret pub; }
    val r: res[type_kind.TypeId, fail.Fail] = type.intern_secret(?sc.s.types, pub);
    if (sel r.err) {
        lang_phase.internal(?sc.status, fail.describe(r.err));
        ret type_kind.TYPE_ERROR;
    }
    ret r.ok;
}

fun infer_type_comparison(sc: *sema_context.SemaContext, b: *ast_expr.ExprBinary, span: lang_source.Span) type_kind.TypeId {
    if (!sc.walk.in_comptime_gate) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_GATE_ONLY, span, "a `$type_of` type comparison is comptime-only; it is valid only as a `$if` gate condition");
        ret type_kind.TYPE_ERROR;
    }
    val lt: type_kind.TypeId = infer_type_operand(sc, b.lhs, span);
    val rt: type_kind.TypeId = infer_type_operand(sc, b.rhs, span);
    if (type_kind.is_error(lt) || type_kind.is_error(rt)) { ret type_kind.TYPE_ERROR; }
    ret sema_declared.prim_or_error(sc, type_kind.TYPE_U1);
}

fun infer_type_operand(sc: *sema_context.SemaContext, operand: ast_id.ExprId, span: lang_source.Span) type_kind.TypeId {
    if (intrinsic.is_type_of_call(sc.view.a, sc.view.source, operand)) {
        val arg: ast_id.ExprId = intrinsic.type_of_arg(sc.view.a, operand);
        if (ast_id.expr_is_nil(arg)) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "$type_of: expected one argument");
            ret type_kind.TYPE_ERROR;
        }
        ret infer_expr(sc, arg);
    }
    val field: res[bool, fail.Fail] = is_field_type_operand(sc, operand);
    if (sel field.err) { ret type_kind.TYPE_ERROR; }
    if (field.ok)      { ret field_type_operand_type(sc, operand); }
    val op_ty: type_kind.TypeId = type_name_expr_type(sc, operand, span);
    sema_context.expr_type_set(sc, operand, op_ty);
    ret op_ty;
}

fun type_name_expr_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) type_kind.TypeId {
    val sym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel sym_opt.some) {
        ret type_kind.TYPE_ERROR;
    }
    ret sema_declared.type_for_symbol(sc, sym_opt.some, span);
}

pub fun is_field_type_operand(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    if (!intrinsic.is_field_type_member(sc.view.a, sc.view.source, eid)) { ret res[bool, fail.Fail].ok{false}; }
    val n_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel n_opt.err) { ret res[bool, fail.Fail].err{n_opt.err}; }
    val obj: ast_id.ExprId                                          = n_opt.ok.data.member.object;
    val r:   res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, obj, ?sc.s.interner);
    sema_context.record_eval_result(sc, r);
    if (sel r.err) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{comptime_value.is_descriptor(r.ok)};
}

fun field_type_operand_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    val n_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel n_opt.err) { ret type_kind.TYPE_ERROR; }
    val obj: ast_id.ExprId                                          = n_opt.ok.data.member.object;
    val r:   res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, obj, ?sc.s.interner);
    sema_context.record_eval_result(sc, r);
    if (sel r.err) { ret type_kind.TYPE_ERROR; }
    val fv: comptime_value.CTValue = r.ok;
    if (!comptime_value.is_descriptor(fv)) { ret type_kind.TYPE_ERROR; }
    val fa: opt[*type_field.Entry] = type.field_at(?sc.s.types, fv.data.fld.owner::type_kind.TypeId, fv.data.fld.index);
    if (!sel fa.some) { ret type_kind.TYPE_ERROR; }
    if (fv.kind == comptime_value.CT_KIND_CASE && type_kind.is_nil(fa.some.ty)) {
        val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
        if (sel e_opt.ok) { sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_NO_PAYLOAD, e_opt.ok.span, comptime_capability.COMPTIME_CASE_NO_PAYLOAD_MSG); }
        ret type_kind.TYPE_ERROR;
    }
    ret fa.some.ty;
}

fun infer_assign(sc: *sema_context.SemaContext, b: *ast_expr.ExprBinary, span: lang_source.Span) type_kind.TypeId {
    val lt: type_kind.TypeId = infer_place(sc, b.lhs);
    val rt: type_kind.TypeId = infer_expr(sc, b.rhs);
    if (type_kind.is_error(lt) || type_kind.is_error(rt)) { ret type_kind.TYPE_ERROR; }

    val assignable: res[bool, fail.Fail] = is_assignable_place(sc, b.lhs, lt);
    if (sel assignable.err) { ret type_kind.TYPE_ERROR; }
    if (!assignable.ok) {
        sema_context.report(sc, diagnostic_kind.ASSIGN_NOT_PLACE, span, "left side of `=` is not a place: expected a variable, field, index, or dereference expression");
        ret lt;
    }

    if (type.is_handle(?sc.s.types, type.strip_secret(?sc.s.types, lt))) {
        sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, span, "a handle cannot be assigned: a handle is read from its descriptor binding and its representation is not the program's, so nothing may be written into a binding, a parameter or a pointee of handle type. pass the handle the operation should use straight to it instead");
        ret lt;
    }

    check_assign_mutable(sc, b.lhs, span);
    check_readonly_binding(sc, b.lhs, span);
    check_writeonly_lane_write(sc, b.lhs, span);
    guard.check_assign(sc, b.lhs, span);
    check.check_coercible(sc, lt, b.rhs, rt, span);
    ret lt;
}

fun is_assignable_place(sc: *sema_context.SemaContext, eid: ast_id.ExprId, ty: type_kind.TypeId) res[bool, fail.Fail] {
    if (ast_id.expr_is_nil(eid)) { ret res[bool, fail.Fail].ok{false}; }
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[bool, fail.Fail].err{e_opt.err}; }
    var e_value:    ast_expr.Expr     = e_opt.ok;
    val e:          *ast_expr.Expr    = ?e_value;
    val place_kind: ast_expr.ExprKind = ast.expr_place_kind(e);
    if (stack.exhausted())                     { ret res[bool, fail.Fail].err{refused(sc, e.span)}; }
    if (place_kind == ast_expr.EXPR_KIND_CALL) { ret res[bool, fail.Fail].ok{is_aggregate(sc, ty)}; }
    if (place_kind == ast_expr.EXPR_KIND_IDENT || place_kind == ast_expr.EXPR_KIND_MEMBER) {
        val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
        if (sel so.some) {
            val sym: *resolve.Symbol = so.some;
            if (sym.kind == resolve.SYM_VAR || sym.kind == resolve.SYM_PARAM)                            { ret res[bool, fail.Fail].ok{true}; }
            if (symbol_is_val_binding(sc, sym))                                                          { ret res[bool, fail.Fail].ok{true}; }
            if (sym.kind == resolve.SYM_IMPORTED && symbol_decl_kind(sc, sym) == ast_decl.DECL_KIND_VAR) { ret res[bool, fail.Fail].ok{true}; }
            ret res[bool, fail.Fail].ok{false};
        }
    }
    if (place_kind == ast_expr.EXPR_KIND_MEMBER)  { ret is_assignable_place_base(sc, e.data.member.object); }
    if (place_kind == ast_expr.EXPR_KIND_PROJECT) { ret is_assignable_place_base(sc, e.data.project.object); }
    if (place_kind == ast_expr.EXPR_KIND_INDEX)   { ret is_assignable_place_base(sc, e.data.index.object); }
    ret res[bool, fail.Fail].ok{place_kind != ast_expr.EXPR_KIND_ERROR};
}

fun is_assignable_place_base(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    # a range is a value, not a view: writing into it writes nothing
    val range: res[bool, fail.Fail] = is_range_expr(sc, eid);
    if (sel range.err) { ret range; }
    if (range.ok)      { ret res[bool, fail.Fail].ok{false}; }
    val ty: type_kind.TypeId = target_expr_type(sc, eid);
    if (type.is_pointer_like(?sc.s.types, type.strip_secret(?sc.s.types, ty))) { ret res[bool, fail.Fail].ok{true}; }
    ret is_assignable_place(sc, eid, ty);
}

fun is_range_expr(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[bool, fail.Fail].err{e_opt.err}; }
    var e: ast_expr.Expr = e_opt.ok;
    ret res[bool, fail.Fail].ok{e.kind == ast_expr.EXPR_KIND_INDEX && ast_expr.is_range(?e.data.index)};
}

fun check_assign_mutable(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) {
    val found: res[opt[*resolve.Symbol], fail.Fail] = immutable_binding_for_target(sc, eid);
    if (sel found.err) { ret; }
    val so: opt[*resolve.Symbol] = found.ok;
    if (!sel so.some) { ret; }
    val sym: *resolve.Symbol = so.some;

    val direct: bool = symbol_at_expr_is(sc, eid, sym);
    var prefix: str  = "cannot assign into `";
    if (direct) { prefix = "cannot assign to `"; }

    report_immutable_assign(sc, span, prefix, sym.name);
}

fun immutable_binding_for_target(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[opt[*resolve.Symbol], fail.Fail] {
    if (ast_id.expr_is_nil(eid)) { ret res[opt[*resolve.Symbol], fail.Fail].ok{opt[*resolve.Symbol].none{}}; }

    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (sel so.some) {
        val sym: *resolve.Symbol = so.some;
        if (symbol_is_val_binding(sc, sym))                               { ret res[opt[*resolve.Symbol], fail.Fail].ok{opt[*resolve.Symbol].some{sym}}; }
        if (sym.kind == resolve.SYM_VAR || sym.kind == resolve.SYM_PARAM) { ret res[opt[*resolve.Symbol], fail.Fail].ok{opt[*resolve.Symbol].none{}}; }
    }

    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[opt[*resolve.Symbol], fail.Fail].err{e_opt.err}; }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;

    if (e.kind == ast_expr.EXPR_KIND_MEMBER) { ret binding_through_object(sc, e.data.member.object); }
    if (e.kind == ast_expr.EXPR_KIND_INDEX)  { ret binding_through_object(sc, e.data.index.object); }

    ret res[opt[*resolve.Symbol], fail.Fail].ok{opt[*resolve.Symbol].none{}};
}

fun binding_through_object(sc: *sema_context.SemaContext, obj: ast_id.ExprId) res[opt[*resolve.Symbol], fail.Fail] {
    if (type.is_pointer_like(?sc.s.types, type.strip_secret(?sc.s.types, target_expr_type(sc, obj)))) {
        ret res[opt[*resolve.Symbol], fail.Fail].ok{opt[*resolve.Symbol].none{}};
    }
    ret immutable_binding_for_target(sc, obj);
}

fun symbol_is_val_binding(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    ret sym.kind == resolve.SYM_VAL
        || (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_VAL);
}

fun symbol_at_expr_is(sc: *sema_context.SemaContext, eid: ast_id.ExprId, sym: *resolve.Symbol) bool {
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel so.some) { ret false; }
    ret so.some == sym;
}

fun target_expr_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    if (sc.view.expr_type == nil || ast_id.expr_is_nil(eid) || !sema_context.expr_in_view(sc, eid)) { ret type_kind.TYPE_ERROR; }
    ret sc.view.expr_type[ast_id.expr_index(eid)];
}

fun report_immutable_assign(sc: *sema_context.SemaContext, span: lang_source.Span, prefix: str, name: intern.StrId) {
    val msg: opt[str] = sema_context.text(sc, "{}{}`: a `val` is immutable", prefix, typename.name_str(sc.s, name));
    if (sel msg.none) { ret; }
    fin { sema_context.text_free(sc, msg.some); }
    sema_context.report_note(sc, diagnostic_kind.ASSIGN_IMMUTABLE, span, msg.some,
        "a `val` binds its value once, at its declaration; declare it `var` if it must be assigned. a module-level `val` is emitted in read-only storage, so the store would fault at runtime");
}

# a store is judged by the storage it writes: a field or an element of a binding is the
# binding's, and one reached through a pointer read out of a binding is the pointer target's
fun check_readonly_binding(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) {
    var cur: ast_id.ExprId = eid;
    for (!ast_id.expr_is_nil(cur)) {
        if (expr_names_binding(sc, cur, decorator.GPU_SPEC, nil)) {
            sema_context.report(sc, diagnostic_kind.ASSIGN_READONLY_STORAGE, span, "cannot store to a `#[gpu.spec(id)]` var: a specialization constant is supplied by the host at pipeline creation and is a constant from then on. copy the value into a local to change it");
            ret;
        }
        if (expr_names_binding(sc, cur, decorator.GPU_PUSH, nil)) {
            sema_context.report(sc, diagnostic_kind.ASSIGN_READONLY_STORAGE, span, "cannot store through a `#[gpu.push]` block: a push-constant block is written by the host with the command that records the dispatch or draw, and a shader only reads it. copy the value into a local to change it");
            ret;
        }
        if (expr_names_binding(sc, cur, decorator.GPU_STORAGE, "readonly")) {
            sema_context.report(sc, diagnostic_kind.ASSIGN_READONLY_STORAGE, span, "cannot store through a `#[gpu.storage(set, binding, \"readonly\")]` binding: the qualifier declares that no stage writes it, which is what lets the emitter mark it `NonWritable` and a vertex stage read it without `vertexPipelineStoresAndAtomics`. drop the `\"readonly\"` qualifier to write it");
            ret;
        }
        val obj: res[ast_id.ExprId, fail.Fail] = place_object(sc, cur);
        if (sel obj.err) { ret; }
        cur = obj.ok;
    }
}

# the object whose own storage holds the field or element `eid` names; nil for any other
# expression, and for an object that is a pointer, since what it points at is not the
# storage the pointer was read from
fun place_object(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[ast_id.ExprId, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[ast_id.ExprId, fail.Fail].err{e_opt.err}; }
    var obj: ast_id.ExprId = ast_id.EXPR_NIL;
    if (e_opt.ok.kind == ast_expr.EXPR_KIND_MEMBER)                                                   { obj = e_opt.ok.data.member.object; }
    or (e_opt.ok.kind == ast_expr.EXPR_KIND_INDEX)                                                    { obj = e_opt.ok.data.index.object; }
    if (ast_id.expr_is_nil(obj))                                                                      { ret res[ast_id.ExprId, fail.Fail].ok{obj}; }
    if (type.is_pointer_like(?sc.s.types, type.strip_secret(?sc.s.types, target_expr_type(sc, obj)))) { ret res[ast_id.ExprId, fail.Fail].ok{ast_id.EXPR_NIL}; }
    ret res[ast_id.ExprId, fail.Fail].ok{obj};
}

# a read of a `"writeonly"` binding's memory: a place a store writes, and an address taken, read none
fun check_writeonly_read(sc: *sema_context.SemaContext, eid: ast_id.ExprId, ty: type_kind.TypeId, span: lang_source.Span) {
    if (type_kind.is_error(ty)) { ret; }
    # a handle's texels are read by an operation, not by naming the binding
    if (type.is_handle(?sc.s.types, ty))                                  { ret; }
    if (!expr_names_binding(sc, eid, decorator.GPU_STORAGE, "writeonly")) { ret; }
    val written: res[bool, fail.Fail] = on_place_chain(sc, sc.walk.write_place, eid);
    if (sel written.err) { ret; }
    if (written.ok)      { ret; }
    sema_context.report(sc, diagnostic_kind.READ_WRITEONLY_STORAGE, span, "cannot read a `#[gpu.storage(set, binding, \"writeonly\")]` binding: the qualifier declares that no stage reads it, which is what lets the emitter mark it `NonReadable`. drop the `\"writeonly\"` qualifier to read it");
}

# a lane write loads the whole vector and stores it back, so into a `"writeonly"` binding it is a read
fun check_writeonly_lane_write(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err)                             { ret; }
    if (e_opt.ok.kind != ast_expr.EXPR_KIND_INDEX) { ret; }
    val vec: ast_id.ExprId = e_opt.ok.data.index.object;
    if (!type.is_vector(?sc.s.types, target_expr_type(sc, vec))) { ret; }
    var cur: ast_id.ExprId = vec;
    for (!ast_id.expr_is_nil(cur)) {
        if (expr_names_binding(sc, cur, decorator.GPU_STORAGE, "writeonly")) {
            sema_context.report(sc, diagnostic_kind.READ_WRITEONLY_STORAGE, span, "cannot write one lane of a vector in a `#[gpu.storage(set, binding, \"writeonly\")]` binding: a lane write loads the whole vector and stores it back, and the qualifier declares that no stage reads the binding. store the whole vector instead");
            ret;
        }
        val obj: res[ast_id.ExprId, fail.Fail] = place_object(sc, cur);
        if (sel obj.err) { ret; }
        cur = obj.ok;
    }
}

# `eid` is `place` or an object it takes a field or an element of
fun on_place_chain(sc: *sema_context.SemaContext, place: ast_id.ExprId, eid: ast_id.ExprId) res[bool, fail.Fail] {
    var cur: ast_id.ExprId = place;
    for (!ast_id.expr_is_nil(cur)) {
        if (ast_id.expr_same(cur, eid)) { ret res[bool, fail.Fail].ok{true}; }
        val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, cur);
        if (sel e_opt.err) { ret res[bool, fail.Fail].err{e_opt.err}; }
        val k: ast_expr.ExprKind = e_opt.ok.kind;
        if (k == ast_expr.EXPR_KIND_MEMBER) { cur = e_opt.ok.data.member.object; }
        or (k == ast_expr.EXPR_KIND_INDEX)  { cur = e_opt.ok.data.index.object; }
        or                                  { ret res[bool, fail.Fail].ok{false}; }
    }
    ret res[bool, fail.Fail].ok{false};
}

# infers a place that is written or addressed rather than read
fun infer_place(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    val outer: sema_context.Walk = sema_context.walk_open(sc);
    sc.walk.write_place = eid;
    val t: type_kind.TypeId = infer_expr(sc, eid);
    sema_context.walk_close(sc, outer);
    check_reads_behind_pointer(sc, eid);
    ret t;
}

# the place is typed as written all the way down, before its objects have types; below the
# first object that is a pointer, the place is the pointer's target and the pointer itself
# is read, so the bindings it was read out of are checked as read once the types are known
fun check_reads_behind_pointer(sc: *sema_context.SemaContext, place: ast_id.ExprId) {
    var cur: ast_id.ExprId = place;
    var cut: bool          = false;
    for (!ast_id.expr_is_nil(cur)) {
        val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, cur);
        if (sel e_opt.err) { ret; }
        val k: ast_expr.ExprKind = e_opt.ok.kind;
        if (cut && (k == ast_expr.EXPR_KIND_IDENT || k == ast_expr.EXPR_KIND_MEMBER)) {
            check_writeonly_read(sc, cur, target_expr_type(sc, cur), e_opt.ok.span);
        }
        var obj: ast_id.ExprId = ast_id.EXPR_NIL;
        if (k == ast_expr.EXPR_KIND_MEMBER)                                                                       { obj = e_opt.ok.data.member.object; }
        or (k == ast_expr.EXPR_KIND_INDEX)                                                                        { obj = e_opt.ok.data.index.object; }
        if (ast_id.expr_is_nil(obj))                                                                              { ret; }
        if (!cut && type.is_pointer_like(?sc.s.types, type.strip_secret(?sc.s.types, target_expr_type(sc, obj)))) { cut = true; }
        cur = obj;
    }
}

# `eid` names a module binding carrying the decorator `id`, with the qualifier `want` among its string arguments unless `want` is nil
fun expr_names_binding(sc: *sema_context.SemaContext, eid: ast_id.ExprId, id: decorator.Id, want: str) bool {
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel so.some) { ret false; }
    val sym: *resolve.Symbol = so.some;
    if (sym.kind == resolve.SYM_IMPORTED) {
        if (sym.definition_kind != resolve.SYM_VAR && sym.definition_kind != resolve.SYM_VAL) { ret false; }
    }
    or (sym.kind != resolve.SYM_VAR && sym.kind != resolve.SYM_VAL)                 { ret false; }
    or ((sym.flags & resolve.SYM_FLAG_MODULE) == 0 || ast_id.decl_is_nil(sym.decl)) { ret false; }
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    val a:       *ast.Ast                   = current.definition.parsed.a;
    val d_opt:   opt[*ast_decl.Decl]        = ast.get_decl(a, current.symbol.decl);
    if (!sel d_opt.some) { ret false; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) { ret false; }

    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?a.decorators.data[d.decorators_start + i];
        if (dec.id != id) {
            i = i + 1;
            cnt;
        }
        if (want == nil) { ret true; }
        var q: u32 = 2;
        for (q < dec.args_len) {
            val qual: opt[str] = decorator.string_of(?sc.s.interner, current.definition.decorators, a, dec, q);
            if (sel qual.some && str_equals(qual.some, want)) { ret true; }
            q = q + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun lit_int_type(sc: *sema_context.SemaContext, e: *ast_expr.Expr) type_kind.TypeId {
    if (e.data.lit_int.suffix == ast_expr.LIT_SUFFIX_NONE) { ret sema_declared.prim_or_error(sc, type_kind.TYPE_I64); }
    ret sema_declared.prim_or_error(sc, e.data.lit_int.suffix);
}

fun check_lit_int_range(sc: *sema_context.SemaContext, e: *ast_expr.Expr, t: type_kind.TypeId, negated: bool, span: lang_source.Span) {
    if (e.data.lit_int.suffix == ast_expr.LIT_SUFFIX_NONE) { ret; }
    val opt_bounds: opt[type_prim.IntRange] = coerce.int_bounds_of(sc, t);
    if (!sel opt_bounds.some) { ret; }
    val bounds: type_prim.IntRange = opt_bounds.some;
    if (type_prim.int_fits(e.data.lit_int.value, negated, bounds)) { ret; }
    check.report_out_of_range(sc, span, coerce.out_of_range(t, e.data.lit_int.value, negated, bounds, true));
}

fun infer_negated_int_literal(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) res[opt[type_kind.TypeId], fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[opt[type_kind.TypeId], fail.Fail].err{e_opt.err}; }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (e.kind != ast_expr.EXPR_KIND_LIT_INT)              { ret res[opt[type_kind.TypeId], fail.Fail].ok{opt[type_kind.TypeId].none{}}; }
    if (e.data.lit_int.suffix == ast_expr.LIT_SUFFIX_NONE) { ret res[opt[type_kind.TypeId], fail.Fail].ok{opt[type_kind.TypeId].none{}}; }

    val t: type_kind.TypeId = lit_int_type(sc, e);
    check_lit_int_range(sc, e, t, true, span);
    sema_context.expr_type_set(sc, eid, t);
    ret res[opt[type_kind.TypeId], fail.Fail].ok{opt[type_kind.TypeId].some{t}};
}

fun infer_unary(sc: *sema_context.SemaContext, u: *ast_expr.ExprUnary, span: lang_source.Span) type_kind.TypeId {
    if (u.op > ast_expr.UN_DEREF) {
        lang_phase.internal(?sc.status, fail.describe(resolve.unknown_catalog(sc.s, "UnOp", u.op::u32)));
        ret type_kind.TYPE_ERROR;
    }
    if (u.op == ast_expr.UN_NEG) {
        val neg_r: res[opt[type_kind.TypeId], fail.Fail] = infer_negated_int_literal(sc, u.operand, span);
        if (sel neg_r.err) { ret type_kind.TYPE_ERROR; }
        val neg: opt[type_kind.TypeId] = neg_r.ok;
        if (sel neg.some) { ret neg.some; }
    }
    var ot: type_kind.TypeId = type_kind.TYPE_ERROR;
    if (u.op == ast_expr.UN_ADDR) { ot = infer_place(sc, u.operand); }
    or                            { ot = infer_expr(sc, u.operand); }
    if (type_kind.is_error(ot))   { ret type_kind.TYPE_ERROR; }

    val ot_secret: bool = type.is_secret(?sc.s.types, ot);

    # an operand typed by a type parameter answers no operand predicate; the instance decides
    if (sema_context.awaits_instance(sc, ot) && u.op != ast_expr.UN_ADDR && u.op != ast_expr.UN_DEREF) {
        if (u.op == ast_expr.UN_NOT) { ret join_secret(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U1), ot_secret); }
        ret join_secret(sc, ot, ot_secret);
    }

    if ((u.op == ast_expr.UN_NEG || u.op == ast_expr.UN_BIT_NOT) && type.is_u1(?sc.s.types, ot)) {
        check.refuse_form(sc, transition.U1_AS_U8, span);
        ret type_kind.TYPE_ERROR;
    }

    if (u.op == ast_expr.UN_NEG) {
        if (!type.is_numeric(?sc.s.types, ot)) {
            sema_context.report(sc, diagnostic_kind.OPERATOR_OPERAND_TYPE, span, "type mismatch: unary - requires a numeric operand");
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, ot, ot_secret);
    }
    if (u.op == ast_expr.UN_NOT) {
        if (!type.is_u1(?sc.s.types, ot)) {
            sema_context.report(sc, diagnostic_kind.OPERATOR_OPERAND_TYPE, span, "type mismatch: unary ! requires a u1 operand");
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U1), ot_secret);
    }
    if (u.op == ast_expr.UN_BIT_NOT) {
        if (type.is_vector(?sc.s.types, ot)) {
            val base: type_kind.TypeId = type.strip_secret(?sc.s.types, ot);
            if (type_prim.prim_desc(type.vector_element(?sc.s.types, base)).class != type_prim.PRIM_CLASS_INT) {
                sema_context.report(sc, diagnostic_kind.OPERATOR_OPERAND_TYPE, span, "type mismatch: unary ~ requires integer lanes");
                ret type_kind.TYPE_ERROR;
            }
            ret join_secret(sc, base, ot_secret);
        }
        if (!type.is_integer(?sc.s.types, ot)) {
            sema_context.report(sc, diagnostic_kind.OPERATOR_OPERAND_TYPE, span, "type mismatch: unary ~ requires an integer operand");
            ret type_kind.TYPE_ERROR;
        }
        ret join_secret(sc, ot, ot_secret);
    }
    if (u.op == ast_expr.UN_ADDR) {
        val rvalue: res[str, fail.Fail] = address_operand_rvalue(sc, u.operand);
        if (sel rvalue.err) { ret type_kind.TYPE_ERROR; }
        if (rvalue.ok != nil) {
            report_address_of_rvalue(sc, span, rvalue.ok);
            ret type_kind.TYPE_ERROR;
        }
        val comptime_param: res[bool, fail.Fail] = operand_is_comptime_param(sc, u.operand);
        if (sel comptime_param.err) { ret type_kind.TYPE_ERROR; }
        if (comptime_param.ok) {
            sema_context.report(sc, diagnostic_kind.ADDRESS_COMPTIME_PARAM, span, "cannot take the address of a comptime parameter");
            ret type_kind.TYPE_ERROR;
        }
        val generic: res[bool, fail.Fail] = operand_is_uninstantiated_generic(sc, u.operand);
        if (sel generic.err) { ret type_kind.TYPE_ERROR; }
        if (generic.ok) {
            sema_context.report(sc, diagnostic_kind.ADDRESS_GENERIC_FUNCTION, span, "cannot take the address of an uninstantiated generic function: a generic is a template, not code, so it has no address until its type arguments are supplied. name the instance (`?f[i64]`), call it with them (`f[i64](x)`), or take the address of a non-generic function");
            ret type_kind.TYPE_ERROR;
        }
        if (type.is_handle(?sc.s.types, type.strip_secret(?sc.s.types, ot))) {
            val bound: res[bool, fail.Fail] = handle_place_is_bound(sc, u.operand);
            if (sel bound.err) { ret type_kind.TYPE_ERROR; }
            if (!bound.ok) {
                sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, span, "cannot take the address of a handle that is not its descriptor binding: a handle's address is the binding it is read from, and a parameter is a copy with none, so addressing it would need storage the program owns, which no handle may live in. take the parameter as a pointer (`img: *Image`) and pass the binding's address from the caller (`f(?binding)`)");
                ret type_kind.TYPE_ERROR;
            }
        }
        val packed_r: res[type_kind.TypeId, fail.Fail] = operand_packed_nominal(sc, u.operand);
        if (sel packed_r.err) { ret type_kind.TYPE_ERROR; }
        val packed_nominal: type_kind.TypeId = packed_r.ok;
        if (!type_kind.is_nil(packed_nominal)) {
            if (type.is_tag(?sc.s.types, packed_nominal)) {
                sema_context.report(sc, diagnostic_kind.ADDRESS_PACKED_MEMBER, span, "cannot take the address of a payload of a `#[packed]` tag: the payload sits at an offset its own type does not guarantee, so the resulting pointer would claim an alignment the storage does not have. copy the payload into a local and take that address, or take the address of the whole tag (`?t`), whose pointer type is honest about being align 1");
            }
            or {
                sema_context.report(sc, diagnostic_kind.ADDRESS_PACKED_MEMBER, span, "cannot take the address of a field of a `#[packed]` record: the field sits at an offset its own type does not guarantee, so the resulting pointer would claim an alignment the storage does not have. copy the field into a local and take that address, or take the address of the whole record (`?r`), whose pointer type is honest about being align 1");
            }
            ret type_kind.TYPE_ERROR;
        }
        ret sema_declared.ptr_to(sc, ot);
    }
    if (u.op == ast_expr.UN_DEREF) {
        check.check_secret_address(sc, ot, span);
        ret pointee_of(sc, ot, span);
    }
    ret type_kind.TYPE_ERROR;
}

fun report_address_of_rvalue(sc: *sema_context.SemaContext, span: lang_source.Span, rvalue: str) {
    var op_span: lang_source.Span;
    op_span.offset = span.offset;
    op_span.len    = 1;
    sema_context.reportf(sc, diagnostic_kind.ADDRESS_TEMPORARY, op_span,
        "cannot take the address of {}: `?` applies to a place (a binding, a field, an element, or a dereference)", rvalue);
}

# nil when the operand is a place; otherwise what kind of rvalue it is
fun address_operand_rvalue(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[str, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[str, fail.Fail].err{e_opt.err}; }
    var e_value: ast_expr.Expr     = e_opt.ok;
    val e:       *ast_expr.Expr    = ?e_value;
    val k:       ast_expr.ExprKind = ast.expr_place_kind(e);
    if (stack.exhausted())                                                 { ret res[str, fail.Fail].err{refused(sc, e.span)}; }
    if (k == ast_expr.EXPR_KIND_IDENT && names_each_element(sc, eid))      { ret res[str, fail.Fail].ok{"a `$each` element"}; }
    if (k == ast_expr.EXPR_KIND_IDENT || k == ast_expr.EXPR_KIND_UNARY)    { ret res[str, fail.Fail].ok{nil}; }
    if (e.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE)                     { ret res[str, fail.Fail].ok{nil}; }
    if (k == ast_expr.EXPR_KIND_MEMBER)                                    { ret address_base_rvalue(sc, e.data.member.object, "a field of "); }
    if (k == ast_expr.EXPR_KIND_PROJECT)                                   { ret address_base_rvalue(sc, e.data.project.object, "a projection of "); }
    if (k == ast_expr.EXPR_KIND_INDEX && ast_expr.is_range(?e.data.index)) { ret res[str, fail.Fail].ok{"a range"}; }
    if (k == ast_expr.EXPR_KIND_INDEX)                                     { ret address_base_rvalue(sc, e.data.index.object, "an element of "); }
    if (k == ast_expr.EXPR_KIND_CALL)                                      { ret res[str, fail.Fail].ok{"a call result"}; }
    val ek: ast_expr.ExprKind = e.kind;
    if (ek == ast_expr.EXPR_KIND_LIT_INT || ek == ast_expr.EXPR_KIND_LIT_FLOAT || ek == ast_expr.EXPR_KIND_LIT_CHAR
        || ek == ast_expr.EXPR_KIND_LIT_STR || ek == ast_expr.EXPR_KIND_LIT_NIL) { ret res[str, fail.Fail].ok{"a literal"}; }
    if (ek == ast_expr.EXPR_KIND_BINARY || ek == ast_expr.EXPR_KIND_UNARY) { ret res[str, fail.Fail].ok{"an operator result"}; }
    if (ek == ast_expr.EXPR_KIND_CAST)                                     { ret res[str, fail.Fail].ok{"a cast result"}; }
    if (ek == ast_expr.EXPR_KIND_ARRAY_LIT)                                { ret res[str, fail.Fail].ok{"an array literal"}; }
    if (ek == ast_expr.EXPR_KIND_STRUCT_LIT)                               { ret res[str, fail.Fail].ok{"a record literal"}; }
    if (ek == ast_expr.EXPR_KIND_VECTOR_LIT)                               { ret res[str, fail.Fail].ok{"a vector literal"}; }
    if (ek == ast_expr.EXPR_KIND_SPREAD)                                   { ret res[str, fail.Fail].ok{"a spread"}; }
    if (ek == ast_expr.EXPR_KIND_STRIP)                                    { ret res[str, fail.Fail].ok{"a declassified value"}; }
    if (ek == ast_expr.EXPR_KIND_TYPE_REF)                                 { ret res[str, fail.Fail].ok{"a type"}; }
    if (ek == ast_expr.EXPR_KIND_COMPTIME_IDENT)                           { ret res[str, fail.Fail].ok{"a comptime value"}; }
    ret res[str, fail.Fail].ok{"a temporary"};
}

# a field, element, or projection is a place when its base is one or is reached through a pointer
fun address_base_rvalue(sc: *sema_context.SemaContext, base: ast_id.ExprId, prefix: str) res[str, fail.Fail] {
    val ty: type_kind.TypeId = target_expr_type(sc, base);
    if (type.is_pointer_like(?sc.s.types, type.strip_secret(?sc.s.types, ty))) { ret res[str, fail.Fail].ok{nil}; }
    val inner_r: res[str, fail.Fail] = address_operand_rvalue(sc, base);
    if (sel inner_r.err) { ret inner_r; }
    val inner: str = inner_r.ok;
    if (inner == nil)                         { ret res[str, fail.Fail].ok{nil}; }
    if (str_equals(prefix, "a field of "))    { ret res[str, fail.Fail].ok{address_base_label(inner, "a field of a call result", "a field of a `$each` element", "a field of a temporary")}; }
    if (str_equals(prefix, "an element of ")) { ret res[str, fail.Fail].ok{address_base_label(inner, "an element of a call result", "an element of a `$each` element", "an element of a temporary")}; }
    ret res[str, fail.Fail].ok{address_base_label(inner, "a projection of a call result", "a projection of a `$each` element", "a projection of a temporary")};
}

# a `$each` loop variable over a constant array names a constant, so it and every place rooted
# in it have no storage
fun names_each_element(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel so.some) { ret false; }
    ret !type_kind.is_nil(array_elem_loop_var_type(sc, so.some));
}

# the nesting refusal a place walk returns, already reported against the node it stands on
fun refused(sc: *sema_context.SemaContext, span: lang_source.Span) fail.Fail {
    sema_context.refuse_nesting(sc, span);
    ret fail.reported();
}

fun address_base_label(inner: str, call_label: str, each_label: str, other_label: str) str {
    if (str_equals(inner, "a call result"))      { ret call_label; }
    if (str_ends_with(inner, "`$each` element")) { ret each_label; }
    ret other_label;
}

fun operand_is_comptime_param(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err)                             { ret res[bool, fail.Fail].err{e_opt.err}; }
    if (e_opt.ok.kind != ast_expr.EXPR_KIND_IDENT) { ret res[bool, fail.Fail].ok{false}; }
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel so.some) { ret res[bool, fail.Fail].ok{false}; }
    val sym: *resolve.Symbol = so.some;
    ret res[bool, fail.Fail].ok{sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0};
}

# a handle place that is its descriptor binding: a module binding, or the pointee of a pointer to one
fun handle_place_is_bound(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[bool, fail.Fail].err{e_opt.err}; }
    val k: ast_expr.ExprKind = e_opt.ok.kind;
    if (k == ast_expr.EXPR_KIND_UNARY && e_opt.ok.data.unary.op == ast_expr.UN_DEREF) { ret res[bool, fail.Fail].ok{true}; }
    if (k != ast_expr.EXPR_KIND_IDENT && k != ast_expr.EXPR_KIND_MEMBER)              { ret res[bool, fail.Fail].ok{false}; }
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel so.some) { ret res[bool, fail.Fail].ok{false}; }
    val sym: *resolve.Symbol = so.some;
    if (sym.kind == resolve.SYM_IMPORTED) { ret res[bool, fail.Fail].ok{sym.definition_kind == resolve.SYM_VAR || sym.definition_kind == resolve.SYM_VAL}; }
    ret res[bool, fail.Fail].ok{(sym.kind == resolve.SYM_VAR || sym.kind == resolve.SYM_VAL) && (sym.flags & resolve.SYM_FLAG_MODULE) != 0};
}

fun operand_is_uninstantiated_generic(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[bool, fail.Fail].err{e_opt.err}; }
    val k: ast_expr.ExprKind = e_opt.ok.kind;
    if (k != ast_expr.EXPR_KIND_IDENT && k != ast_expr.EXPR_KIND_MEMBER) { ret res[bool, fail.Fail].ok{false}; }

    val cf: opt[*ast_decl.DeclFun] = callee_fun_decl(sc, eid);
    if (!sel cf.some) { ret res[bool, fail.Fail].ok{false}; }
    ret res[bool, fail.Fail].ok{cf.some.generics_len > 0};
}

# the innermost `#[packed]` record or tag a field or payload place is reached through, or TYPE_NIL
fun operand_packed_nominal(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[type_kind.TypeId, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[type_kind.TypeId, fail.Fail].err{e_opt.err}; }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (stack.exhausted()) { ret res[type_kind.TypeId, fail.Fail].err{refused(sc, e.span)}; }

    if (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        val nom: type_kind.TypeId = expr_packed_nominal(sc, e.data.member.object);
        if (!type_kind.is_nil(nom)) { ret res[type_kind.TypeId, fail.Fail].ok{nom}; }
        ret operand_packed_nominal(sc, e.data.member.object);
    }
    if (e.kind == ast_expr.EXPR_KIND_PROJECT) {
        val nom: type_kind.TypeId = expr_packed_nominal(sc, e.data.project.object);
        if (!type_kind.is_nil(nom)) { ret res[type_kind.TypeId, fail.Fail].ok{nom}; }
        ret operand_packed_nominal(sc, e.data.project.object);
    }
    if (e.kind == ast_expr.EXPR_KIND_INDEX) {
        ret operand_packed_nominal(sc, e.data.index.object);
    }
    ret res[type_kind.TypeId, fail.Fail].ok{type_kind.TYPE_NIL};
}

fun expr_packed_nominal(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type_kind.TypeId {
    if (sc.view.expr_type == nil || ast_id.expr_is_nil(eid) || !sema_context.expr_in_view(sc, eid)) { ret type_kind.TYPE_NIL; }

    ret type_packed_nominal(sc, sc.view.expr_type[ast_id.expr_index(eid)]);
}

fun type_packed_nominal(sc: *sema_context.SemaContext, t: type_kind.TypeId) type_kind.TypeId {
    var base: type_kind.TypeId = t;
    for {
        if (type_kind.is_nil(base) || type_kind.is_error(base)) { ret type_kind.TYPE_NIL; }
        base = type.strip_secret(?sc.s.types, base);
        val bt: opt[*type.Type] = type.get(?sc.s.types, base);
        if (!sel bt.some)                           { ret type_kind.TYPE_NIL; }
        if (bt.some.kind != type_kind.TYPE_POINTER) { brk; }
        base = bt.some.data.pointer.base;
    }

    val nom: type_kind.TypeId = type.aggregate_nominal(?sc.s.types, base);
    if (type_kind.is_error(nom))                      { ret type_kind.TYPE_NIL; }
    if (!type.decoration_of(?sc.s.types, nom).packed) { ret type_kind.TYPE_NIL; }
    ret nom;
}

# `$zeroize(p, count)`: every byte of `count` values of the pointee of `p` written zero by
# stores no pass removes. it reads nothing, so `p` may point at public, secret or mixed
# bytes with no cast, and the length rests on the size of the target alone
fun infer_zeroize(sc: *sema_context.SemaContext, c: *ast_expr.ExprCall, span: lang_source.Span) type_kind.TypeId {
    val r: *intrinsic.Row = intrinsic.row(intrinsic.ZEROIZE);
    if (c.args_len != r.args) {
        sema_context.reportf(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "${}: expected {} argument(s)", r.name, r.args::usize);
        ret type_kind.TYPE_ERROR;
    }
    val target: ast_id.ExprId    = sc.view.a.expr_ids.data[c.args_start];
    val count:  ast_id.ExprId    = sc.view.a.expr_ids.data[c.args_start + 1];
    val pt:     type_kind.TypeId = infer_expr(sc, target);
    val nt:     type_kind.TypeId = infer_expr(sc, count);
    if (type_kind.is_error(pt) || type_kind.is_error(nt)) { ret type_kind.TYPE_ERROR; }
    if (!sema_context.awaits_instance(sc, pt) && !type.is_pointer(?sc.s.types, pt)) {
        check.report_typed(sc, diagnostic_kind.TYPE_MISMATCH, span, "`$zeroize` wipes through a typed pointer, but its target has type `", pt, "`");
        ret type_kind.TYPE_ERROR;
    }
    if (type.is_secret(?sc.s.types, nt)) {
        sema_context.report(sc, diagnostic_kind.SECRET_VARIABLE_LATENCY, span, "`$zeroize` takes a public count: its length and timing rest on the size of its target alone");
        ret type_kind.TYPE_ERROR;
    }
    if (!sema_context.awaits_instance(sc, nt) && !type.is_integer(?sc.s.types, nt)) {
        check.report_typed(sc, diagnostic_kind.TYPE_MISMATCH, span, "`$zeroize` counts values with an integer, but its count has type `", nt, "`");
        ret type_kind.TYPE_ERROR;
    }
    ret type_kind.TYPE_NIL;
}

fun infer_call(sc: *sema_context.SemaContext, eid: ast_id.ExprId, c: *ast_expr.ExprCall, span: lang_source.Span) type_kind.TypeId {
    if (intrinsic.call_intrinsic(sc.view.a, sc.view.source, eid) == intrinsic.ZEROIZE) { ret infer_zeroize(sc, c, span); }
    val intr: type_kind.TypeId = infer_comptime_intrinsic(sc, c, span);
    if (!type_kind.is_nil(intr)) { ret intr; }

    val outer: sema_context.Walk = sema_context.walk_open(sc);
    sc.walk.callee_eid = c.callee;
    val ct: type_kind.TypeId = infer_expr(sc, c.callee);
    sema_context.walk_close(sc, outer);

    var i: u32 = 0;
    for (i < c.args_len) {
        infer_expr(sc, sc.view.a.expr_ids.data[c.args_start + i]);
        i = i + 1;
    }

    val cf_opt: opt[*ast_decl.DeclFun] = callee_fun_decl(sc, c.callee);

    if (sel cf_opt.some) {
        val cf: *ast_decl.DeclFun = cf_opt.some;
        if (cf.generics_len > 0 && decl_has_comptime_param(sc, c.callee, cf)) {
            sema_context.report(sc, diagnostic_kind.GENERIC_COMPTIME_VALUE_PARAM, span, "comptime value parameters on a generic function are not yet supported");
            ret type_kind.TYPE_ERROR;
        }
    }

    if (c.type_args_len > 0) {
        ret infer_generic_call(sc, eid, c, ct, span);
    }

    if (type_kind.is_error(ct)) { ret type_kind.TYPE_ERROR; }

    val fn_opt: opt[*type.Type] = type.get(?sc.s.types, ct);
    if (!sel fn_opt.some) { ret type_kind.TYPE_ERROR; }
    val fn: *type.Type = fn_opt.some;
    if (fn.kind != type_kind.TYPE_FUN) {
        check.report_typed(sc, diagnostic_kind.CALL_NOT_CALLABLE, span, "not callable: `", ct, "` is not a function");
        ret type_kind.TYPE_ERROR;
    }

    val ret_type: type_kind.TypeId = fn.data.fn.ret_type;

    if (sel cf_opt.some) {
        val cf: *ast_decl.DeclFun = cf_opt.some;
        if (decl_has_comptime_param(sc, c.callee, cf)) {
            check.check_comptime_call(sc, eid, ct, c.callee, cf, c.args_start, c.args_len, span);
            ret ret_type;
        }
    }

    if (check.check_call(sc, ct, c.args_start, c.args_len, span, callee_packs_to_c_tail(sc, c.callee))) {
        record_pack_call(sc, eid, c, nil, 0, ct, span);
    }
    ret ret_type;
}

fun callee_packs_to_c_tail(sc: *sema_context.SemaContext, callee: ast_id.ExprId) bool {
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel so.some) { ret false; }
    val sym: *resolve.Symbol = so.some;
    if (sym.kind != resolve.SYM_FUN && !(sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_FUN)) { ret false; }
    if (!sym.has_pack_param)                                                                                          { ret false; }
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    ret sema_variadic.decl_body_spreads_pack_to_c_variadic(sc, resolve.origin_of(sc.s, ?current.symbol), current.symbol.decl);
}

# a call to a declared function whose last parameter is a pack
fun callee_has_pack(sc: *sema_context.SemaContext, callee: ast_id.ExprId) bool {
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel so.some) { ret false; }
    val sym: *resolve.Symbol = so.some;
    if (sym.kind != resolve.SYM_FUN && !(sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_FUN)) { ret false; }
    ret sym.has_pack_param;
}

# a call to a function with a pack names the instance at its arguments' types: those of the
# arguments past its fixed parameters, or the enclosing instance's own pack where the call
# spreads it. a template's spread forwards a pack nothing has bound yet, so it names none
fun record_pack_call(sc: *sema_context.SemaContext, eid: ast_id.ExprId, c: *ast_expr.ExprCall, args: *type_kind.TypeId, arg_len: u32,
    sig: type_kind.TypeId, span: lang_source.Span) bool {
    if (!callee_has_pack(sc, c.callee)) { ret true; }
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, c.callee);
    if (!sel so.some) { ret true; }
    val sym:      *resolve.Symbol                            = so.some;
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    val d_opt:   opt[*ast_decl.Decl]        = ast.get_decl(current.definition.parsed.a, current.symbol.decl);
    if (!sel d_opt.some)                                                                   { ret true; }
    if (d_opt.some.kind != ast_decl.DECL_KIND_FUN || d_opt.some.data.fun_.params_len == 0) { ret true; }
    val fixed: u32 = d_opt.some.data.fun_.params_len - 1;

    var item: sema_instance.Instance;
    item.kind    = sema_instance.KIND_PACK;
    item.origin  = resolve.origin_of(sc.s, sym);
    item.decl    = current.symbol.decl;
    item.args    = args;
    item.arg_len = arg_len;
    item.bare    = sym.name;
    item.canon   = sym.canon;
    item.sig     = sig;
    item.site    = span;

    var spread: bool = false;
    var i:      u32  = fixed;
    for (i < c.args_len) {
        val opt_e: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, sc.view.a.expr_ids.data[c.args_start + i]);
        if (sel opt_e.ok) {
            if (opt_e.ok.kind == ast_expr.EXPR_KIND_SPREAD) { spread = true; }
        }
        i = i + 1;
    }
    if (spread) {
        if (!sema_context.walk_binds_pack(sc)) { ret true; }
        item.pack     = sc.instance.pack_types;
        item.pack_len = sc.instance.pack_len;
        ret queue_instance(sc, eid, item, sym, span);
    }
    if (c.args_len < fixed) { ret true; }
    val n: u32 = c.args_len - fixed;
    item.pack     = nil;
    item.pack_len = n;
    if (n == 0) { ret queue_instance(sc, eid, item, sym, span); }
    val tr: res[*type_kind.TypeId, A.Error] = A.allocate[type_kind.TypeId](sc.s.alloc, n::usize);
    if (sel tr.err) {
        lang_phase.internal(?sc.status, "out of memory holding a pack's element types");
        ret false;
    }
    i = 0;
    for (i < n) {
        val arg: ast_id.ExprId = sc.view.a.expr_ids.data[c.args_start + fixed + i];
        tr.ok[i] = sema_context.apply_subst(sc, sc.view.expr_type[ast_id.expr_index(arg)]);
        i        = i + 1;
    }
    item.pack = tr.ok;
    val queued: bool = queue_instance(sc, eid, item, sym, span);
    A.deallocate[type_kind.TypeId](sc.s.alloc, tr.ok, n::usize);
    ret queued;
}

fun callee_fun_decl(sc: *sema_context.SemaContext, callee: ast_id.ExprId) opt[*ast_decl.DeclFun] {
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel so.some) { ret opt[*ast_decl.DeclFun].none{}; }
    val sym: *resolve.Symbol = so.some;
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)  { ret opt[*ast_decl.DeclFun].none{}; }
    if (sym.kind != resolve.SYM_IMPORTED && ast_id.decl_is_nil(sym.decl)) { ret opt[*ast_decl.DeclFun].none{}; }
    if (sym.generic_arity == 0 && !sym.has_comptime_params)               { ret opt[*ast_decl.DeclFun].none{}; }
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret opt[*ast_decl.DeclFun].none{}; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    val a:       *ast.Ast                   = current.definition.parsed.a;
    val d_opt:   opt[*ast_decl.Decl]        = ast.get_decl(a, current.symbol.decl);
    if (!sel d_opt.some) { ret opt[*ast_decl.DeclFun].none{}; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret opt[*ast_decl.DeclFun].none{}; }
    ret opt[*ast_decl.DeclFun].some{?d.data.fun_};
}

fun decl_has_comptime_param(sc: *sema_context.SemaContext, callee: ast_id.ExprId, f: *ast_decl.DeclFun) bool {
    val so: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel so.some) { ret false; }
    val sym: *resolve.Symbol = so.some;

    ret sym.has_comptime_params;
}

fun infer_comptime_intrinsic(sc: *sema_context.SemaContext, c: *ast_expr.ExprCall, span: lang_source.Span) type_kind.TypeId {
    val ce_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, c.callee);
    if (sel ce_opt.err) { ret type_kind.TYPE_ERROR; }
    var ce_value: ast_expr.Expr  = ce_opt.ok;
    val ce:       *ast_expr.Expr = ?ce_value;
    if (ce.kind != ast_expr.EXPR_KIND_COMPTIME_IDENT) { ret type_kind.TYPE_NIL; }

    val id: intrinsic.Id = intrinsic.ident_intrinsic(sc.view.source, ce.data.comptime_ident.tok);
    if (id == intrinsic.TYPE_OF) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_GATE_ONLY, span, "`$type_of` yields a comptime type, not a value; use it as a type-comparison operand inside a `$if` gate");
        ret type_kind.TYPE_ERROR;
    }

    if (id == intrinsic.POINTEE_OF) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_TYPE_NOT_VALUE, span, "`$pointee_of` names a type, not a value; write it where a type is expected");
        ret type_kind.TYPE_ERROR;
    }

    if (intrinsic.in_class(id, intrinsic.CLASS_QUERY)) {
        if (c.args_len != 1) {
            sema_context.reportf(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "a comptime type query: expected {} argument(s)", 1::usize);
            ret type_kind.TYPE_ERROR;
        }
        val qarg: ast_id.ExprId    = sc.view.a.expr_ids.data[c.args_start];
        val qty:  type_kind.TypeId = sema_declared.intrinsic_operand_type(sc, qarg, span);
        sema_context.expr_type_set(sc, qarg, qty);
        if (type_kind.is_error(qty)) { ret type_kind.TYPE_ERROR; }

        if (id == intrinsic.TYPE_NAME) { ret sema_declared.ptr_to(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U8)); }

        if (!sc.walk.in_comptime_gate) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_GATE_ONLY, span, "a comptime type predicate is comptime-only; it is valid only as a `$if` gate condition");
            ret type_kind.TYPE_ERROR;
        }
        ret sema_declared.prim_or_error(sc, type_kind.TYPE_U1);
    }

    if (!intrinsic.in_class(id, intrinsic.CLASS_LAYOUT)) { ret type_kind.TYPE_NIL; }

    val row: *intrinsic.Row = intrinsic.row(id);
    if (c.args_len != row.args) {
        sema_context.reportf(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "${}: expected {} argument(s)", row.name, row.args::usize);
        ret type_kind.TYPE_ERROR;
    }

    val arg0:  ast_id.ExprId    = sc.view.a.expr_ids.data[c.args_start];
    val op_ty: type_kind.TypeId = sema_declared.intrinsic_operand_type(sc, arg0, span);
    sema_context.expr_type_set(sc, arg0, op_ty);
    if (type_kind.is_error(op_ty)) { ret type_kind.TYPE_ERROR; }

    if (id == intrinsic.LENGTH_OF) {
        val elements: opt[u32] = type.element_count(?sc.s.types, op_ty);
        if (!sel elements.some) {
            check.report_typed(sc, diagnostic_kind.COMPTIME_LENGTH_OF, span, "`$length_of` has no answer for `", op_ty,
                "`: only a fixed array and a vector carry a statically known element count");
            ret type_kind.TYPE_ERROR;
        }
    }
    if (id == intrinsic.OFFSET_OF && !type_is_generic_param(sc, op_ty)) {
        val member: res[opt[u32], fail.Fail] = sema_declared.offset_of_member_index(sc, c, op_ty, span, false);
        if (sel member.err)      { ret type_kind.TYPE_ERROR; }
        if (!sel member.ok.some) { ret type_kind.TYPE_ERROR; }
    }
    ret sema_declared.prim_or_error(sc, type_kind.TYPE_U64);
}

pub fun field_seq_owner(sc: *sema_context.SemaContext, seq_eid: ast_id.ExprId, span: lang_source.Span) type_kind.TypeId {
    val targ: ast_id.ExprId = intrinsic.fields_type_arg(sc.view.a, seq_eid);
    if (ast_id.expr_is_nil(targ)) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "$fields: expected one type argument `$fields(T)`");
        ret type_kind.TYPE_ERROR;
    }
    val owner: type_kind.TypeId = sema_declared.intrinsic_operand_type(sc, targ, span);
    sema_context.expr_type_set(sc, targ, owner);
    if (type_kind.is_error(owner))        { ret type_kind.TYPE_ERROR; }
    if (type_is_generic_param(sc, owner)) { ret owner; }
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, owner));
    if (!type_is_record(sc, owner)) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_FIELDS_NOT_RECORD, span, "$fields requires a record type");
        ret type_kind.TYPE_ERROR;
    }
    val table_1: opt[*type_field.Table] = sema_context.field_table_for(sc, owner);
    if (!sel table_1.some) {
        sema_context.report_internal(sc, span, "internal: could not materialize the field table for this `$fields` type argument");
        ret type_kind.TYPE_ERROR;
    }
    ret owner;
}

# `$cases(T)` enumerates the cases of one public tag; a secret shape is refused because outer
# secrecy protects the active case, and a generic parameter defers to its instantiation
pub fun case_seq_owner(sc: *sema_context.SemaContext, seq_eid: ast_id.ExprId, span: lang_source.Span) type_kind.TypeId {
    val targ: ast_id.ExprId = intrinsic.fields_type_arg(sc.view.a, seq_eid);
    if (ast_id.expr_is_nil(targ)) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, span, "$cases: expected one type argument `$cases(T)`");
        ret type_kind.TYPE_ERROR;
    }
    val owner: type_kind.TypeId = sema_declared.intrinsic_operand_type(sc, targ, span);
    sema_context.expr_type_set(sc, targ, owner);
    if (type_kind.is_error(owner))        { ret type_kind.TYPE_ERROR; }
    if (type_is_generic_param(sc, owner)) { ret owner; }
    if (type.is_secret(?sc.s.types, owner)) {
        check.report_typed(sc, diagnostic_kind.SECRET_TAG_CASE, span, "`$cases` refuses `", owner,
            "`: outer `^` secrecy protects the active case, so its cases cannot be enumerated");
        ret type_kind.TYPE_ERROR;
    }
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, owner));
    if (!type.is_tag(?sc.s.types, owner)) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_CASES_NOT_TAG, span, "`$cases` requires a tag type, but this names `", owner, "`");
        ret type_kind.TYPE_ERROR;
    }
    val table_1: opt[*type_field.Table] = sema_context.field_table_for(sc, owner);
    if (!sel table_1.some) {
        sema_context.report_internal(sc, span, "internal: could not materialize the case table for this `$cases` type argument");
        ret type_kind.TYPE_ERROR;
    }
    sema_declared.ensure_layout_ready(sc, owner);
    ret owner;
}

fun infer_field_member(sc: *sema_context.SemaContext, m: *ast_expr.ExprMember, span: lang_source.Span) type_kind.TypeId {
    val obj_r: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, m.object, ?sc.s.interner);
    sema_context.record_eval_result(sc, obj_r);
    if (sel obj_r.err) { ret type_kind.TYPE_NIL; }
    val desc: comptime_value.CTValue = obj_r.ok;
    if (!comptime_value.is_descriptor(desc)) { ret type_kind.TYPE_NIL; }
    val is_case: bool = desc.kind == comptime_value.CT_KIND_CASE;

    if (str_region_equals(sc.view.source, m.name.offset, m.name.len, "name")) {
        ret sema_declared.ptr_to(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U8));
    }
    if (str_region_equals(sc.view.source, m.name.offset, m.name.len, "offset")) {
        if (is_case && !case_descriptor_has_payload(sc, desc)) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_NO_PAYLOAD, span, comptime_capability.COMPTIME_CASE_NO_PAYLOAD_MSG);
            ret type_kind.TYPE_ERROR;
        }
        ret sema_declared.prim_or_error(sc, type_kind.TYPE_U64);
    }
    if (str_region_equals(sc.view.source, m.name.offset, m.name.len, "type")) {
        if (is_case && !case_descriptor_has_payload(sc, desc)) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_NO_PAYLOAD, span, comptime_capability.COMPTIME_CASE_NO_PAYLOAD_MSG);
            ret type_kind.TYPE_ERROR;
        }
        sema_context.report(sc, diagnostic_kind.COMPTIME_GATE_ONLY, span, "`f.type` is a comptime type, not a value; use it as a type-comparison operand inside a `$if` gate");
        ret type_kind.TYPE_ERROR;
    }
    if (is_case && str_region_equals(sc.view.source, m.name.offset, m.name.len, "code")) {
        ret sema_declared.prim_or_error(sc, type_kind.TYPE_U64);
    }
    if (is_case && str_region_equals(sc.view.source, m.name.offset, m.name.len, "has_payload")) {
        if (!sc.walk.in_comptime_gate) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_GATE_ONLY, span, "`case.has_payload` is a comptime predicate; it is valid only as a `$if` gate condition");
            ret type_kind.TYPE_ERROR;
        }
        ret sema_declared.prim_or_error(sc, type_kind.TYPE_U1);
    }
    if (is_case) { sema_context.report(sc, diagnostic_kind.COMPTIME_DESCRIPTOR_MEMBER, span, comptime.COMPTIME_CASE_UNKNOWN_MEMBER_MSG); }
    or           { sema_context.report(sc, diagnostic_kind.COMPTIME_DESCRIPTOR_MEMBER, span, comptime.COMPTIME_FIELD_UNKNOWN_MEMBER_MSG); }
    ret type_kind.TYPE_ERROR;
}

fun case_descriptor_has_payload(sc: *sema_context.SemaContext, desc: comptime_value.CTValue) bool {
    val fa: opt[*type_field.Entry] = type.field_at(?sc.s.types, desc.data.fld.owner::type_kind.TypeId, desc.data.fld.index);
    if (!sel fa.some) { ret false; }
    ret !type_kind.is_nil(fa.some.ty);
}

# a descriptor bound by `$each` names one case of one tag; `desc` must be a case descriptor and its
# owner must be exactly the tag the use site names, so a descriptor from another nominal type or
# another generic instantiation is refused
fun case_descriptor_name(sc: *sema_context.SemaContext, desc_eid: ast_id.ExprId, tag_ty: type_kind.TypeId, what: str, span: lang_source.Span) intern.StrId {
    val r: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, desc_eid, ?sc.s.interner);
    sema_context.record_eval_result(sc, r);
    if (sel r.err) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_DESCRIPTOR, span, "a bracketed case must be a comptime case descriptor bound by an enclosing `$each` over `$cases(T)`");
        ret intern.STR_NIL;
    }
    if (r.ok.kind != comptime_value.CT_KIND_CASE) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_DESCRIPTOR, span, "a bracketed case must be a comptime case descriptor bound by an enclosing `$each` over `$cases(T)`");
        ret intern.STR_NIL;
    }
    val desc:  comptime_value.CTValue = r.ok;
    val owner: type_kind.TypeId       = desc.data.fld.owner::type_kind.TypeId;
    if (!type_kind.same(owner, type.strip_secret(?sc.s.types, tag_ty))) {
        check.report_typed(sc, diagnostic_kind.COMPTIME_CASE_DESCRIPTOR, span, what, owner, "`, not the tag this place or literal names");
        ret intern.STR_NIL;
    }
    val fa: opt[*type_field.Entry] = type.field_at(?sc.s.types, owner, desc.data.fld.index);
    if (!sel fa.some) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_DESCRIPTOR, span, "case descriptor ordinal out of range");
        ret intern.STR_NIL;
    }
    ret fa.some.name;
}

fun project_receiver_matches(sc: *sema_context.SemaContext, obj_ty_raw: type_kind.TypeId, owner: type_kind.TypeId) bool {
    val obj_ty: type_kind.TypeId = type.strip_secret(?sc.s.types, obj_ty_raw);
    if (type_kind.same(obj_ty, owner)) { ret true; }
    val to: opt[*type.Type] = type.get(?sc.s.types, obj_ty);
    if (!sel to.some) { ret false; }
    val t: *type.Type = to.some;
    if (t.kind == type_kind.TYPE_GENERIC_PARAM) { ret true; }
    if (t.kind != type_kind.TYPE_POINTER)       { ret false; }
    val base: type_kind.TypeId = t.data.pointer.base;
    if (type_kind.same(base, owner)) { ret true; }
    val bo: opt[*type.Type] = type.get(?sc.s.types, base);
    if (!sel bo.some) { ret false; }
    ret bo.some.kind == type_kind.TYPE_GENERIC_PARAM;
}

fun type_is_pack(sc: *sema_context.SemaContext, ty: type_kind.TypeId) bool {
    val to: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (!sel to.some) { ret false; }
    ret to.some.kind == type_kind.TYPE_PACK;
}

pub fun type_is_generic_param(sc: *sema_context.SemaContext, ty: type_kind.TypeId) bool {
    val to: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (!sel to.some) { ret false; }
    ret to.some.kind == type_kind.TYPE_GENERIC_PARAM;
}

fun infer_spread(sc: *sema_context.SemaContext, sp: *ast_expr.ExprSpread, span: lang_source.Span) type_kind.TypeId {
    val it: type_kind.TypeId = infer_expr(sc, sp.inner);
    if (type_kind.is_error(it)) { ret type_kind.TYPE_ERROR; }
    if (!type_is_pack(sc, it)) {
        sema_context.report(sc, diagnostic_kind.PACK_SPREAD, span, "`...` may only spread a variadic pack");
        ret type_kind.TYPE_ERROR;
    }
    ret it;
}

fun type_is_record(sc: *sema_context.SemaContext, ty: type_kind.TypeId) bool {
    ret type.is_record(?sc.s.types, ty);
}

fun infer_project(sc: *sema_context.SemaContext, p: *ast_expr.ExprProject, span: lang_source.Span) type_kind.TypeId {
    val obj_ty: type_kind.TypeId                                       = infer_expr(sc, p.object);
    val fr:     res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, p.field, ?sc.s.interner);
    sema_context.record_eval_result(sc, fr);
    if (sel fr.err) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_FIELD_DESCRIPTOR, span, "`v.[f]` requires a comptime field descriptor bound by an enclosing `$each`");
        ret type_kind.TYPE_ERROR;
    }
    val fv: comptime_value.CTValue = fr.ok;
    if (!comptime_value.is_descriptor(fv)) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_FIELD_DESCRIPTOR, span, "`v.[f]` requires a comptime field descriptor bound by an enclosing `$each`");
        ret type_kind.TYPE_ERROR;
    }
    if (type_kind.is_error(obj_ty)) { ret type_kind.TYPE_ERROR; }
    val owner: type_kind.TypeId = fv.data.fld.owner::type_kind.TypeId;
    if (fv.kind == comptime_value.CT_KIND_CASE) {
        # `v.[case]` is a payload place under the same guard rule as `v.case`
        if (!project_receiver_matches(sc, obj_ty, owner)) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_DESCRIPTOR, span, "`v.[case]`: the instance type does not match the case descriptor's owning tag");
            ret type_kind.TYPE_ERROR;
        }
        val ca: opt[*type_field.Entry] = type.field_at(?sc.s.types, owner, fv.data.fld.index);
        if (!sel ca.some) {
            sema_context.report(sc, diagnostic_kind.COMPTIME_CASE_DESCRIPTOR, span, "`v.[case]`: case ordinal out of range");
            ret type_kind.TYPE_ERROR;
        }
        val case_name: intern.StrId         = ca.some.name;
        val in_guard:  res[bool, fail.Fail] = guard.guarded(sc, p.object, case_name);
        if (sel in_guard.err) { ret type_kind.TYPE_ERROR; }
        val r: opt[type_kind.TypeId] = check.check_member(sc, obj_ty, case_name, in_guard.ok, span);
        if (!sel r.some) { ret type_kind.TYPE_ERROR; }
        ret r.some;
    }
    if (!project_receiver_matches(sc, obj_ty, owner)) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_FIELD_DESCRIPTOR, span, "`v.[f]`: the instance type does not match the field descriptor's owning record");
        ret type_kind.TYPE_ERROR;
    }
    val fa: opt[*type_field.Entry] = type.field_at(?sc.s.types, owner, fv.data.fld.index);
    if (!sel fa.some) {
        sema_context.report(sc, diagnostic_kind.COMPTIME_FIELD_DESCRIPTOR, span, "`v.[f]`: field ordinal out of range");
        ret type_kind.TYPE_ERROR;
    }
    ret fa.some.ty;
}

fun compute_generic_signature(sc: *sema_context.SemaContext, c: *ast_expr.ExprCall, ct: type_kind.TypeId, span: lang_source.Span,
    out_sym: **resolve.Symbol, out_args: **type_kind.TypeId) type_kind.TypeId {
    val sym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, c.callee);
    if (!sel sym_opt.some) { ret type_kind.TYPE_ERROR; }
    val sym: *resolve.Symbol = sym_opt.some;

    val pr: res[*type_kind.TypeId, fail.Fail] = sema_declared.allocate_params(sc, c.type_args_len);
    if (sel pr.err) {
        lang_phase.internal(?sc.status, fail.describe(pr.err));
        sema_context.report_internal(sc, span, "internal: out of memory allocating generic type arguments");
        ret type_kind.TYPE_ERROR;
    }
    val args:   *type_kind.TypeId = pr.ok;
    var handed: bool              = false;
    fin {
        if (!handed) { sema_declared.free_params(sc, args, c.type_args_len); }
    }

    var i: u32 = 0;
    for (i < c.type_args_len) {
        val arg_tid: ast_id.TypeId = sc.view.a.type_ids.data[c.type_args_start + i];
        args[i] = sema_declared.resolve_type_ref(sc, arg_tid);
        i       = i + 1;
    }

    if (!generics.check_arity(sc, sym, c.type_args_len, span)) {
        ret type_kind.TYPE_ERROR;
    }

    if (type_kind.is_error(ct)) {
        ret type_kind.TYPE_ERROR;
    }
    val fn_opt: opt[*type.Type] = type.get(?sc.s.types, ct);
    if (!sel fn_opt.some) {
        ret type_kind.TYPE_ERROR;
    }
    if (fn_opt.some.kind != type_kind.TYPE_FUN) {
        check.report_typed(sc, diagnostic_kind.CALL_NOT_CALLABLE, span, "not callable: `", ct, "` is not a function");
        ret type_kind.TYPE_ERROR;
    }

    val defined_r: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel defined_r.err) {
        ret type_kind.TYPE_ERROR;
    }
    val defined: sema_product.DefinedSymbol        = defined_r.ok;
    val who_r:   res[type.GenericOwner, fail.Fail] = sema_context.generic_owner_of_decl(sc.s, defined.definition.parsed.a,
        resolve.origin_of(sc.s, sym), defined.symbol.decl);
    if (sel who_r.err) {
        lang_phase.internal(?sc.status, fail.describe(who_r.err));
        ret type_kind.TYPE_ERROR;
    }
    var who: type.GenericOwner = who_r.ok;
    val sig: type_kind.TypeId  = sema_context.recover_at[type_kind.TypeId](sc, span, subst.substitute(sc.s, ct, ?who, args, c.type_args_len), type_kind.TYPE_ERROR);
    if (type_kind.is_error(sig)) {
        sema_context.report_internal(sc, span, "internal: generic substitution failed");
        ret type_kind.TYPE_ERROR;
    }

    val sfn_opt: opt[*type.Type] = type.get(?sc.s.types, sig);
    if (!sel sfn_opt.some) {
        ret type_kind.TYPE_ERROR;
    }
    if (sfn_opt.some.kind != type_kind.TYPE_FUN) {
        ret type_kind.TYPE_ERROR;
    }

    handed    = true;
    @out_sym  = sym;
    @out_args = args;
    ret sig;
}

fun queue_generic_instance(sc: *sema_context.SemaContext, eid: ast_id.ExprId, sym: *resolve.Symbol, args: *type_kind.TypeId, arg_len: u32, sig: type_kind.TypeId, span: lang_source.Span) bool {
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    var item:    sema_instance.Instance;
    item.kind    = sema_instance.KIND_TYPE;
    item.origin  = resolve.origin_of(sc.s, sym);
    item.decl    = current.symbol.decl;
    item.args    = args;
    item.arg_len = arg_len;
    item.bare    = sym.name;
    item.canon   = sym.canon;
    item.sig     = sig;
    item.site    = span;
    ret queue_instance(sc, eid, item, sym, span);
}

fun queue_instance(sc: *sema_context.SemaContext, eid: ast_id.ExprId, item: sema_instance.Instance, sym: *resolve.Symbol, span: lang_source.Span) bool {
    val recorded: err[fail.Fail] = sema_context.record_instance(sc, item, eid);
    if (sel recorded.err) {
        sema_context.report(sc, diagnostic_kind.COMPILER_INTERNAL, span, fail.describe(recorded.err));
        ret false;
    }
    ret true;
}

fun infer_generic_call(sc: *sema_context.SemaContext, eid: ast_id.ExprId, c: *ast_expr.ExprCall, ct: type_kind.TypeId, span: lang_source.Span) type_kind.TypeId {
    var sym:  *resolve.Symbol   = nil;
    var args: *type_kind.TypeId = nil;
    val sig:  type_kind.TypeId  = compute_generic_signature(sc, c, ct, span, ?sym, ?args);
    if (type_kind.is_error(sig)) { ret type_kind.TYPE_ERROR; }
    fin { sema_declared.free_params(sc, args, c.type_args_len); }

    val sfn_opt: opt[*type.Type] = type.get(?sc.s.types, sig);
    if (!sel sfn_opt.some) {
        ret type_kind.TYPE_ERROR;
    }
    val ret_type: type_kind.TypeId = sfn_opt.some.data.fn.ret_type;

    if (!check.check_call(sc, sig, c.args_start, c.args_len, span, callee_packs_to_c_tail(sc, c.callee))) {
        ret type_kind.TYPE_ERROR;
    }

    # a generic with a pack is checked once under its type arguments, as any generic is, and
    # emitted at its pack's element types too
    var queued: bool = queue_generic_instance(sc, ast_id.EXPR_NIL, sym, args, c.type_args_len, sig, span);
    if (queued && callee_has_pack(sc, c.callee)) { queued = record_pack_call(sc, eid, c, args, c.type_args_len, sig, span); }
    or (queued)                                  { queued = queue_generic_instance(sc, eid, sym, args, c.type_args_len, sig, span); }
    if (!queued)                                 { ret type_kind.TYPE_ERROR; }
    ret ret_type;
}

fun infer_generic_instance(sc: *sema_context.SemaContext, eid: ast_id.ExprId, c: *ast_expr.ExprCall, span: lang_source.Span) type_kind.TypeId {
    val ct: type_kind.TypeId = infer_expr(sc, c.callee);

    val cf_opt: opt[*ast_decl.DeclFun] = callee_fun_decl(sc, c.callee);
    if (!sel cf_opt.some) {
        check.report_typed(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "not a generic function: `", ct, "` cannot take type arguments");
        ret type_kind.TYPE_ERROR;
    }
    val cf: *ast_decl.DeclFun = cf_opt.some;
    if (cf.generics_len > 0 && decl_has_comptime_param(sc, c.callee, cf)) {
        sema_context.report(sc, diagnostic_kind.GENERIC_COMPTIME_VALUE_PARAM, span, "comptime value parameters on a generic function are not yet supported");
        ret type_kind.TYPE_ERROR;
    }

    var sym:  *resolve.Symbol   = nil;
    var args: *type_kind.TypeId = nil;
    val sig:  type_kind.TypeId  = compute_generic_signature(sc, c, ct, span, ?sym, ?args);
    if (type_kind.is_error(sig)) { ret type_kind.TYPE_ERROR; }

    val queued: bool = queue_generic_instance(sc, eid, sym, args, c.type_args_len, sig, span);
    sema_declared.free_params(sc, args, c.type_args_len);
    if (!queued) { ret type_kind.TYPE_ERROR; }
    ret sig;
}

fun infer_index(sc: *sema_context.SemaContext, ix: *ast_expr.ExprIndex, span: lang_source.Span) type_kind.TypeId {
    val ot: type_kind.TypeId = infer_expr(sc, ix.object);
    val it: type_kind.TypeId = infer_expr(sc, ix.index);
    if (ast_expr.is_range(ix))                            { ret infer_range(sc, ix, ot, it, span); }
    if (type_kind.is_error(ot) || type_kind.is_error(it)) { ret type_kind.TYPE_ERROR; }

    if (!check.check_const_index(sc, ot, ix.index, span)) { ret type_kind.TYPE_ERROR; }

    if (type.is_vector(?sc.s.types, ot)) {
        ret infer_vector_lane(sc, ix, ot, span);
    }

    val r: opt[type_kind.TypeId] = check.check_index(sc, ot, it, span);
    if (!sel r.some) { ret type_kind.TYPE_ERROR; }
    ret r.some;
}

# `x[start, count]`, checked here and typed by type.intern_window, which the constant path
# shares
fun infer_range(sc: *sema_context.SemaContext, ix: *ast_expr.ExprIndex, ot: type_kind.TypeId, it: type_kind.TypeId, span: lang_source.Span) type_kind.TypeId {
    val ct: type_kind.TypeId = infer_expr(sc, ix.count);
    if (type_kind.is_error(ot) || type_kind.is_error(it) || type_kind.is_error(ct)) { ret type_kind.TYPE_ERROR; }

    val count_opt: opt[u32] = check.check_range_count(sc, ix.count);
    if (!sel count_opt.some) { ret type_kind.TYPE_ERROR; }
    val count: u32 = count_opt.some;

    if (!check.check_const_range(sc, ot, ix.index, count, span)) { ret type_kind.TYPE_ERROR; }

    if (type.is_vector(?sc.s.types, ot)) {
        val start: opt[comptime_value.CTValue] = check.const_index_value(sc, ix.index);
        if (!sel start.some) {
            sema_context.report(sc, diagnostic_kind.VECTOR_LANE_INDEX_DYNAMIC, span, "dynamic lane index not supported: a vector range's start must be a comptime constant");
            ret type_kind.TYPE_ERROR;
        }
        if (count < 2) {
            sema_context.report_note(sc, diagnostic_kind.VECTOR_RANGE_WIDTH, span, "a vector range needs at least 2 lanes",
                "a single lane is the lane itself: write `v[i]`");
            ret type_kind.TYPE_ERROR;
        }
    }
    or {
        val elem: opt[type_kind.TypeId] = check.check_index(sc, ot, it, span);
        if (!sel elem.some)                { ret type_kind.TYPE_ERROR; }
        if (type_kind.is_error(elem.some)) { ret type_kind.TYPE_ERROR; }
    }

    val window: res[type_kind.TypeId, fail.Fail] = type.intern_window(?sc.s.types, ot, count);
    if (sel window.err) {
        lang_phase.internal(?sc.status, fail.describe(window.err));
        ret type_kind.TYPE_ERROR;
    }
    ret window.ok;
}

fun infer_vector_lane(sc: *sema_context.SemaContext, ix: *ast_expr.ExprIndex, ot: type_kind.TypeId, span: lang_source.Span) type_kind.TypeId {
    val base:      type_kind.TypeId   = type.strip_secret(?sc.s.types, ot);
    val lane_kind: type_kind.TypeKind = type.vector_element(?sc.s.types, base);
    val lane_ty:   type_kind.TypeId   = sema_declared.prim_or_error(sc, lane_kind);

    val cv_opt: opt[comptime_value.CTValue] = check.const_index_value(sc, ix.index);
    if (!sel cv_opt.some) {
        sema_context.report(sc, diagnostic_kind.VECTOR_LANE_INDEX_DYNAMIC, span, "dynamic lane index not supported: a vector lane index must be a comptime constant");
        ret type_kind.TYPE_ERROR;
    }

    ret join_secret(sc, lane_ty, type.is_secret(?sc.s.types, ot));
}

fun try_infer_case_selector(sc: *sema_context.SemaContext, m: *ast_expr.ExprMember, span: lang_source.Span) type_kind.TypeId {
    val obj_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, m.object);
    if (sel obj_opt.err) {
        lang_phase.internal(?sc.status, fail.describe(obj_opt.err));
        ret type_kind.TYPE_ERROR;
    }
    var obj_ev: ast_expr.Expr  = obj_opt.ok;
    val obj_e:  *ast_expr.Expr = ?obj_ev;

    var tag_type: type_kind.TypeId = type_kind.TYPE_NIL;

    if (obj_e.kind == ast_expr.EXPR_KIND_IDENT || obj_e.kind == ast_expr.EXPR_KIND_MEMBER) {
        val sym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, m.object);
        if (sel sym_opt.some) {
            val sym:        *resolve.Symbol = sym_opt.some;
            var is_tag_sym: bool            = false;
            if (sym.kind == resolve.SYM_TAG) {
                is_tag_sym = true;
            }
            or (sym.kind == resolve.SYM_DEF) {
                val under: type_kind.TypeId = sema_declared.def_underlying(sc, sym, obj_e.span);
                if (type.is_tag(?sc.s.types, under)) {
                    tag_type = under;
                }
            }
            or (sym.kind == resolve.SYM_IMPORTED
                && (sym.definition_kind == resolve.SYM_TAG || sym.definition_kind == resolve.SYM_DEF)) {
                if (sym.generic_arity > 0) {
                    check.report_missing_type_args(sc, span, sym.name, sym.generic_arity);
                    ret type_kind.TYPE_ERROR;
                }
                val imp_ty: type_kind.TypeId = sema_context.decl_type_for(sc, sym);
                if (type.is_tag(?sc.s.types, imp_ty)) {
                    tag_type = imp_ty;
                }
            }
            if (is_tag_sym) {
                if (sym.generic_arity > 0) {
                    check.report_missing_type_args(sc, span, sym.name, sym.generic_arity);
                    ret type_kind.TYPE_ERROR;
                }
                tag_type = sema_declared.type_for_symbol(sc, sym, obj_e.span);
            }
        }
    }
    or (obj_e.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        val c:        *ast_expr.ExprCall   = ?obj_e.data.call;
        val csym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, c.callee);
        if (sel csym_opt.some) {
            val csym: *resolve.Symbol = csym_opt.some;
            if (csym.kind == resolve.SYM_TAG || (csym.kind == resolve.SYM_IMPORTED && csym.definition_kind == resolve.SYM_TAG)) {
                val pr: res[*type_kind.TypeId, fail.Fail] = sema_declared.allocate_params(sc, c.type_args_len);
                if (sel pr.err) {
                    lang_phase.internal(?sc.status, fail.describe(pr.err));
                    ret type_kind.TYPE_ERROR;
                }
                val args: *type_kind.TypeId = pr.ok;
                var i:    u32               = 0;
                for (i < c.type_args_len) {
                    val arg_tid: ast_id.TypeId = sc.view.a.type_ids.data[c.type_args_start + i];
                    args[i] = sema_declared.resolve_type_ref(sc, arg_tid);
                    i       = i + 1;
                }
                val inst_r: res[type_kind.TypeId, fail.Fail] = generics.instantiate(sc, csym, args, c.type_args_len, span);
                sema_declared.free_params(sc, args, c.type_args_len);
                if (sel inst_r.err) {
                    lang_phase.internal(?sc.status, fail.describe(inst_r.err));
                    ret type_kind.TYPE_ERROR;
                }
                tag_type = inst_r.ok;
            }
        }
    }

    if (type_kind.is_nil(tag_type) || type_kind.is_error(tag_type)) {
        ret tag_type;
    }

    val base_tag: type_kind.TypeId = type.strip_secret(?sc.s.types, tag_type);
    if (!type.is_tag(?sc.s.types, base_tag)) {
        ret type_kind.TYPE_NIL;
    }

    sema_declared.ensure_layout_ready(sc, base_tag);
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, base_tag));

    val name_id: intern.StrId           = sema_declared.intern_span_or_nil(sc, m.name);
    val ft_opt:  opt[*type_field.Table] = sema_context.field_table_for(sc, base_tag);
    if (!sel ft_opt.some) {
        check.report_no_field(sc, span, name_id, base_tag);
        ret type_kind.TYPE_ERROR;
    }
    val ft:       *type_field.Table = ft_opt.some;
    var case_idx: u32               = 0;
    var found:    bool              = false;
    for (case_idx < ft.fields_len) {
        val fe: *type_field.Entry = type.field_entry_at(?sc.s.types, ft, case_idx);
        if (intern.str_same(fe.name, name_id)) {
            found = true;
            brk;
        }
        case_idx = case_idx + 1;
    }
    if (!found) {
        check.report_named(sc, diagnostic_kind.TAG_UNKNOWN_CASE, span, "unknown tag case `", name_id, "`");
        ret type_kind.TYPE_ERROR;
    }

    val sel_r: res[type_kind.TypeId, fail.Fail] = type.intern_case_selector(?sc.s.types, base_tag, name_id, case_idx);
    if (sel sel_r.err) {
        lang_phase.internal(?sc.status, fail.describe(sel_r.err));
        ret type_kind.TYPE_ERROR;
    }
    ret sel_r.ok;
}

# `sel place.case` reads only the discriminator, so its operand must be a place of a public tag
fun infer_sel(sc: *sema_context.SemaContext, s: *ast_expr.ExprSel, span: lang_source.Span) type_kind.TypeId {
    val u1t:      type_kind.TypeId = sema_declared.prim_or_error(sc, type_kind.TYPE_U1);
    val place_ty: type_kind.TypeId = infer_expr(sc, s.place);
    if (type_kind.is_error(place_ty)) { ret type_kind.TYPE_ERROR; }

    val is_place: res[bool, fail.Fail] = is_sel_place(sc, s.place);
    if (sel is_place.err) { ret type_kind.TYPE_ERROR; }
    if (!is_place.ok) {
        sema_context.report(sc, diagnostic_kind.SEL_NOT_PLACE, span, "`sel` tests a place: a binding, field, index or dereference, never a call or other temporary");
        ret type_kind.TYPE_ERROR;
    }

    # a pointer place tests its pointee, as a payload place through a pointer already reads it
    var tested: type_kind.TypeId = place_ty;
    if (type.is_pointer(?sc.s.types, place_ty)) { tested = type.deref_one(?sc.s.types, place_ty); }

    if (type.is_secret(?sc.s.types, tested)) {
        check.report_typed(sc, diagnostic_kind.SECRET_TAG_CASE, span, "`sel` cannot test `", tested,
            "`: outer `^` secrecy protects the selected case as well as the payload");
        ret type_kind.TYPE_ERROR;
    }

    val base: type_kind.TypeId = type.strip_secret(?sc.s.types, tested);
    if (!type.is_tag(?sc.s.types, base)) {
        check.report_typed(sc, diagnostic_kind.SEL_NOT_TAG, span, "`sel` expects a tag, but this place has type `", place_ty, "`");
        ret type_kind.TYPE_ERROR;
    }

    if (!guard.check_stable(sc, s.place, span)) { ret type_kind.TYPE_ERROR; }

    sema_declared.ensure_layout_ready(sc, base);
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, base));
    if (!ast_id.expr_is_nil(s.case_desc)) {
        val dname: intern.StrId = case_descriptor_name(sc, s.case_desc, base, "`sel place.[case]`: this case descriptor belongs to `", span);
        if (intern.str_is_nil(dname)) { ret type_kind.TYPE_ERROR; }
        ret u1t;
    }
    val name:    intern.StrId          = sema_declared.intern_span_or_nil(sc, s.case_name);
    val field_1: opt[type_kind.TypeId] = sema_context.field_lookup(sc, base, name);
    if (!sel field_1.some) {
        check.report_named(sc, diagnostic_kind.TAG_UNKNOWN_CASE, s.case_name, "unknown tag case `", name, "`");
        ret type_kind.TYPE_ERROR;
    }
    ret u1t;
}

fun is_sel_place(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    if (ast_id.expr_is_nil(eid)) { ret res[bool, fail.Fail].ok{false}; }
    val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel e_opt.err) { ret res[bool, fail.Fail].err{e_opt.err}; }
    var e_value: ast_expr.Expr     = e_opt.ok;
    val k:       ast_expr.ExprKind = ast.expr_place_kind(?e_value);
    ret res[bool, fail.Fail].ok{k != ast_expr.EXPR_KIND_CALL && k != ast_expr.EXPR_KIND_ERROR};
}

fun infer_member(sc: *sema_context.SemaContext, eid: ast_id.ExprId, m: *ast_expr.ExprMember, span: lang_source.Span) type_kind.TypeId {
    val sel_t: type_kind.TypeId = try_infer_case_selector(sc, m, span);
    if (!type_kind.is_nil(sel_t)) { ret sel_t; }

    val qsym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (sel qsym_opt.some) {
        val qsym:  *resolve.Symbol      = qsym_opt.some;
        val never: res[bool, fail.Fail] = report_never_value(sc, eid, qsym);
        if (sel never.err) { ret type_kind.TYPE_ERROR; }
        if (never.ok)      { ret type_kind.TYPE_ERROR; }
        ret sema_context.decl_type_for(sc, qsym);
    }

    val osym_opt: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, m.object);
    if (sel osym_opt.some) {
        if (osym_opt.some.kind == resolve.SYM_USE) {
            ret type_kind.TYPE_ERROR;
        }
    }

    val ctp: type_kind.TypeId = infer_comptime_path(sc, eid, span);
    if (!type_kind.is_nil(ctp)) { ret ctp; }

    val fdm: type_kind.TypeId = infer_field_member(sc, m, span);
    if (!type_kind.is_nil(fdm)) { ret fdm; }

    val ot: type_kind.TypeId = infer_expr(sc, m.object);
    if (type_kind.is_error(ot)) { ret type_kind.TYPE_ERROR; }

    if (type_is_pack(sc, ot)) {
        if (str_region_equals(sc.view.source, m.name.offset, m.name.len, "len")) {
            ret sema_declared.prim_or_error(sc, type_kind.TYPE_U64);
        }
        sema_context.report(sc, diagnostic_kind.PACK_MEMBER, span, "a variadic pack has only `.len`; iterate its elements with `$each`");
        ret type_kind.TYPE_ERROR;
    }

    if (type_kind.is_nil(ot)) {
        sema_context.report(sc, diagnostic_kind.FIELD_VOID_RECEIVER, span, "a call that returns nothing has no members; a member access requires a record or union value");
        ret type_kind.TYPE_ERROR;
    }

    ensure_record_fields(sc, ot, span);

    val name_id:  intern.StrId         = sema_declared.intern_span_or_nil(sc, m.name);
    val in_guard: res[bool, fail.Fail] = guard.guarded(sc, m.object, name_id);
    if (sel in_guard.err) { ret type_kind.TYPE_ERROR; }
    val r: opt[type_kind.TypeId] = check.check_member(sc, ot, name_id, in_guard.ok, span);
    if (!sel r.some) { ret type_kind.TYPE_ERROR; }
    ret r.some;
}

# a rooted comptime path (`$mach.*`, `$project.*`, `$bin.*`) or a call on one:
# its folded int or str type, TYPE_ERROR with the path's own rejection
# reported at the member, or TYPE_NIL when the expression is not a path the
# evaluator can settle here
fun infer_comptime_path(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) type_kind.TypeId {
    if (!intrinsic.is_comptime_value(sc.view.a, eid)) { ret type_kind.TYPE_NIL; }
    val ev: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
    sema_context.record_eval_result(sc, ev);
    if (sel ev.err) {
        if (ev.err.kind == comptime_failure.EVAL_FAIL_REJECTED) {
            sema_context.report(sc, ev.err.diag, span, ev.err.message);
            ret type_kind.TYPE_ERROR;
        }
        ret type_kind.TYPE_NIL;
    }
    val cv: comptime_value.CTValue = ev.ok;
    if (cv.kind == comptime_value.CT_KIND_STR) { ret sema_declared.ptr_to(sc, sema_declared.prim_or_error(sc, type_kind.TYPE_U8)); }
    if (cv.kind != comptime_value.CT_KIND_INT) { ret type_kind.TYPE_NIL; }
    val typed: opt[type_kind.TypeKind] = int_prim_kind_for(cv.int_width, cv.int_unsigned);
    if (sel typed.some) { ret sema_declared.prim_or_error(sc, typed.some); }
    ret sema_declared.prim_or_error(sc, type_kind.TYPE_I64);
}

fun ensure_record_fields(sc: *sema_context.SemaContext, tid: type_kind.TypeId, span: lang_source.Span) {
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, tid));
    val t_opt: opt[*type.Type] = type.get(?sc.s.types, tid);
    if (!sel t_opt.some) { ret; }
    val t:    *type.Type       = t_opt.some;
    var base: type_kind.TypeId = tid;
    if (t.kind == type_kind.TYPE_POINTER) {
        base = t.data.pointer.base;
        sema_context.record_at(sc, span, subst.ensure_fields(sc.s, base));
    }
    # a record read before the declarations are typed, as an array length reads a constant's
    # field, is elaborated where it is read
    val table: opt[*type_field.Table] = type.field_table_for(?sc.s.types, base);
    if (sel table.none) { sema_declared.ensure_layout_ready(sc, base); }
}

fun infer_cast(sc: *sema_context.SemaContext, c: *ast_expr.ExprCast, span: lang_source.Span) type_kind.TypeId {
    val ft: type_kind.TypeId = infer_expr(sc, c.value);
    val tt: type_kind.TypeId = sema_context.resolved_type_of(sc, c.ty);
    if (type_kind.is_error(ft) || type_kind.is_error(tt)) { ret type_kind.TYPE_ERROR; }

    var from:    type_kind.TypeId        = ft;
    var r:       opt[type_kind.TypeId]   = opt[type_kind.TypeId].none{};
    val to_int:  opt[type_prim.IntRange] = coerce.int_bounds_of(sc, tt);
    var untyped: bool                    = false;
    if (!c.reinterpret && sel to_int.some) {
        val untyped_r: res[bool, fail.Fail] = coerce.is_untyped_int_literal(sc, c.value);
        if (sel untyped_r.err) { ret type_kind.TYPE_ERROR; }
        untyped = untyped_r.ok;
    }
    if (untyped) {
        val exact: opt[type_kind.TypeId] = type_exact_literal(sc, c.value, span);
        if (!sel exact.some) { ret type_kind.TYPE_ERROR; }
        from = exact.some;
    }
    if (c.reinterpret) {
        r = check.check_reinterpret(sc, from, tt, span);
    }
    or {
        r = check.check_cast(sc, from, tt, span);
    }
    if (!sel r.some) { ret type_kind.TYPE_ERROR; }
    ret r.some;
}

# an untyped literal under `::` to an integer type takes the first of i64, u64, i128
# and u128 that holds its exact value and is wide enough for each shift in it, and
# the cast then extends or truncates that value as it would any value of that type;
# none holding it is the literal range refusal, and u128 takes a shift no type is
# wide enough for, to be refused there
fun type_exact_literal(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) opt[type_kind.TypeId] {
    val kinds:   [4]type_kind.TypeKind = [4]type_kind.TypeKind{type_kind.TYPE_I64, type_kind.TYPE_U64, type_kind.TYPE_I128, type_kind.TYPE_U128};
    var refused: coerce.CoerceResult;
    var i:       usize                 = 0;
    for (i < 4) {
        val ty:   type_kind.TypeId                    = sema_declared.prim_or_error(sc, kinds[i]);
        val cr_r: res[coerce.CoerceResult, fail.Fail] = coerce.probe_literal_range(sc, eid, ty);
        if (sel cr_r.err) { ret opt[type_kind.TypeId].none{}; }
        val cr:   coerce.CoerceResult = cr_r.ok;
        var fits: bool                = false;
        if (cr.kind == coerce.COERCE_COERCED) {
            fits = i == 3;
            if (!fits) {
                val shifts: res[bool, fail.Fail] = literal_shifts_fit(sc, eid, ty);
                if (sel shifts.err) { ret opt[type_kind.TypeId].none{}; }
                fits = shifts.ok;
            }
        }
        if (fits) {
            val coerced: res[coerce.CoerceResult, fail.Fail] = coerce.try_coerce_literal(sc, eid, ty);
            if (sel coerced.err) { ret opt[type_kind.TypeId].none{}; }
            ret opt[type_kind.TypeId].some{ty};
        }
        # a negative value names the signed range it missed, a positive one the unsigned
        if (cr.kind == coerce.COERCE_OUT_OF_RANGE && (kinds[i] == type_kind.TYPE_I128) == cr.negated) { refused = cr; }
        i = i + 1;
    }
    check.report_out_of_range(sc, span, refused);
    ret opt[type_kind.TypeId].none{};
}

# whether every shift in a literal tree has a constant count below the width of `ty`
fun literal_shifts_fit(sc: *sema_context.SemaContext, eid: ast_id.ExprId, ty: type_kind.TypeId) res[bool, fail.Fail] {
    val opt_e: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel opt_e.err) { ret res[bool, fail.Fail].err{opt_e.err}; }
    val e: ast_expr.Expr = opt_e.ok;
    if (e.kind == ast_expr.EXPR_KIND_UNARY)  { ret literal_shifts_fit(sc, e.data.unary.operand, ty); }
    if (e.kind != ast_expr.EXPR_KIND_BINARY) { ret res[bool, fail.Fail].ok{true}; }
    val lhs: res[bool, fail.Fail] = literal_shifts_fit(sc, e.data.binary.lhs, ty);
    if (sel lhs.err) { ret lhs; }
    if (!lhs.ok)     { ret lhs; }
    val rhs: res[bool, fail.Fail] = literal_shifts_fit(sc, e.data.binary.rhs, ty);
    if (sel rhs.err)                                                                  { ret rhs; }
    if (!rhs.ok)                                                                      { ret rhs; }
    if (e.data.binary.op != ast_expr.BIN_SHL && e.data.binary.op != ast_expr.BIN_SHR) { ret res[bool, fail.Fail].ok{true}; }
    val cv_opt: opt[comptime_value.CTValue] = check.const_index_value(sc, e.data.binary.rhs);
    if (!sel cv_opt.some) { ret res[bool, fail.Fail].ok{true}; }
    val count_o: opt[u64] = comptime_value.ct_int_u64(cv_opt.some);
    var count:   u64      = 0;
    if (sel count_o.some) { count = count_o.some; }
    ret res[bool, fail.Fail].ok{sel count_o.some && count < (check.byte_size(sc, ty, e.span) * 8)::u64};
}

fun infer_strip(sc: *sema_context.SemaContext, st: *ast_expr.ExprStrip, span: lang_source.Span) type_kind.TypeId {
    val vt: type_kind.TypeId = infer_expr(sc, st.value);
    if (type_kind.is_error(vt)) { ret type_kind.TYPE_ERROR; }

    val stripped: type_kind.TypeId = type.strip_secret(?sc.s.types, vt);

    if (ast_id.type_is_nil(st.ty)) { ret stripped; }

    val tt: type_kind.TypeId = sema_context.resolved_type_of(sc, st.ty);
    if (type_kind.is_error(tt)) { ret type_kind.TYPE_ERROR; }
    if (type.is_secret(?sc.s.types, tt)) {
        sema_context.report(sc, diagnostic_kind.SECRET_STRIP_TARGET, span, "secret strip: a `:>T` target type must be public; a strip only removes the `^` qualifier");
        ret type_kind.TYPE_ERROR;
    }
    # a template cannot decide the equality for an operand typed by a generic
    # parameter; each instance is re-checked under its concrete arguments
    if (!type_kind.same(tt, stripped) && !sema_context.awaits_instance(sc, stripped)) {
        sema_context.report(sc, diagnostic_kind.SECRET_STRIP_TARGET, span, "secret strip: a `:>T` target must name the operand's stripped (public) type; a strip does not convert the value");
        ret type_kind.TYPE_ERROR;
    }
    ret tt;
}

fun infer_array_lit(sc: *sema_context.SemaContext, al: *ast_expr.ExprArrayLit, span: lang_source.Span) type_kind.TypeId {
    val arr_ty:  type_kind.TypeId = sema_context.resolved_type_of(sc, al.ty);
    var elem_ty: type_kind.TypeId = type_kind.TYPE_ERROR;
    sema_context.check_handle_in_array(sc, arr_ty, span);
    var has_count:  bool            = false;
    var decl_count: u32             = 0;
    val at_opt:     opt[*type.Type] = type.get(?sc.s.types, arr_ty);
    if (sel at_opt.some) {
        val at: *type.Type = at_opt.some;
        if (at.kind == type_kind.TYPE_ARRAY) {
            elem_ty    = at.data.array.base;
            decl_count = at.data.array.count;
            has_count  = true;
        }
    }

    var i: u32 = 0;
    for (i < al.elems_len) {
        val ee: ast_id.ExprId    = sc.view.a.expr_ids.data[al.elems_start + i];
        val et: type_kind.TypeId = infer_expr(sc, ee);
        if (!type_kind.is_error(elem_ty) && !type_kind.is_error(et)) {
            check.check_coercible(sc, elem_ty, ee, et, span);
        }
        i = i + 1;
    }

    if (has_count && al.elems_len > decl_count) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LITERAL_LENGTH, span, "array literal: too many elements for declared length");
    }
    or (has_count && al.elems_len < decl_count) {
        sema_context.report(sc, diagnostic_kind.ARRAY_LITERAL_LENGTH, span, "array literal: too few elements for declared length");
    }
    ret arr_ty;
}

fun infer_vector_lit(sc: *sema_context.SemaContext, vl: *ast_expr.ExprVectorLit, span: lang_source.Span) type_kind.TypeId {
    val vec_ty: type_kind.TypeId = sema_context.resolved_type_of(sc, vl.ty);
    val is_vec: bool             = type.is_vector(?sc.s.types, vec_ty);

    var lane_ty: type_kind.TypeId = type_kind.TYPE_ERROR;
    var lanes:   u32              = 0;
    if (is_vec) {
        lanes   = type.vector_lanes(?sc.s.types, vec_ty);
        lane_ty = sema_declared.prim_or_error(sc, type.vector_element(?sc.s.types, vec_ty));
    }

    var i: u32 = 0;
    for (i < vl.elems_len) {
        val ee:     ast_id.ExprId        = sc.view.a.expr_ids.data[vl.elems_start + i];
        val parsed: opt[*ast_expr.Expr]  = ast.get_expr(sc.view.a, ee);
        val symbol: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, ee);
        if (sel parsed.some) {
            if (parsed.some.kind == ast_expr.EXPR_KIND_IDENT && !sel symbol.some) {
                val name: lang_source.Span = parsed.some.data.ident.tok;
                check.report_named(sc, diagnostic_kind.NAME_UNRESOLVED, name, "unresolved identifier `", sema_declared.intern_span_or_nil(sc, name), "`");
                i = i + 1;
                cnt;
            }
        }
        val et: type_kind.TypeId = infer_expr(sc, ee);
        if (is_vec && !type_kind.is_error(lane_ty) && !type_kind.is_error(et)) {
            check.check_coercible(sc, lane_ty, ee, et, span);
        }
        i = i + 1;
    }

    if (!is_vec) {
        if (!type_kind.is_error(vec_ty)) {
            check.report_typed(sc, diagnostic_kind.VECTOR_LITERAL_TYPE, span, "positional-brace literal requires a vector type; `", vec_ty, "` is not a vector (a record uses named fields, an array a `[N]T` prefix)");
        }
        ret type_kind.TYPE_ERROR;
    }

    if (vl.elems_len > lanes) {
        sema_context.report(sc, diagnostic_kind.VECTOR_LITERAL_LENGTH, span, "vector literal: too many elements for the lane count");
    }
    or (vl.elems_len < lanes) {
        sema_context.report(sc, diagnostic_kind.VECTOR_LITERAL_LENGTH, span, "vector literal: too few elements for the lane count");
    }
    ret vec_ty;
}

# `Type.case{payload}` and `Type.case{}` are the only construction forms; `Type.[case]{...}` names
# the case through a descriptor and then constructs by the same rule
fun infer_tag_case_lit(sc: *sema_context.SemaContext, literal: *ast_expr.ExprStructLit, ty: type_kind.TypeId,
    case_span: lang_source.Span, case_desc: ast_id.ExprId, span: lang_source.Span) type_kind.TypeId {
    val base: type_kind.TypeId = type.strip_secret(?sc.s.types, ty);
    sema_declared.ensure_layout_ready(sc, base);
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, base));

    var named_seen: bool = false;
    var i:          u32  = 0;
    for (i < literal.fields_len) {
        val init: *ast_expr.FieldInit = ?sc.view.a.field_inits.data[literal.fields_start + i];
        if (init.form == ast_expr.INIT_NAMED) { named_seen = true; }
        i = i + 1;
    }
    if (named_seen) {
        sema_context.report(sc, diagnostic_kind.TAG_PAYLOAD_NAMED, span, "a tag payload is positional: write `Type.case{value}`, not a field name");
    }

    var payload_ty:  type_kind.TypeId = type_kind.TYPE_ERROR;
    var payload_len: u32              = literal.elems_len;
    if (payload_len > 0) {
        payload_ty = infer_expr(sc, sc.view.a.expr_ids.data[literal.elems_start]);
        var j: u32 = 1;
        for (j < payload_len) {
            infer_expr(sc, sc.view.a.expr_ids.data[literal.elems_start + j]);
            j = j + 1;
        }
    }

    if (!type.is_tag(?sc.s.types, base)) {
        check.report_typed(sc, diagnostic_kind.TAG_NOT_TAG, span, "`", ty, "` is not a tag, so it has no cases to construct");
        ret type_kind.TYPE_ERROR;
    }

    var name: intern.StrId = intern.STR_NIL;
    if (!ast_id.expr_is_nil(case_desc)) {
        name = case_descriptor_name(sc, case_desc, base, "`Type.[case]{...}`: this case descriptor belongs to `", span);
        if (intern.str_is_nil(name)) { ret type_kind.TYPE_ERROR; }
    }
    or { name = sema_declared.intern_span_or_nil(sc, case_span); }
    val declared: opt[type_kind.TypeId] = sema_context.field_lookup(sc, base, name);
    if (!sel declared.some) {
        check.report_named(sc, diagnostic_kind.TAG_UNKNOWN_CASE, case_span, "unknown tag case `", name, "`");
        ret type_kind.TYPE_ERROR;
    }
    val expected: type_kind.TypeId = declared.some;

    if (type_kind.is_nil(expected)) {
        if (payload_len != 0) { sema_context.report(sc, diagnostic_kind.TAG_PAYLOAD_UNEXPECTED, span, "this tag case takes no payload; write `{}`"); }
        ret ty;
    }
    if (payload_len == 0) {
        sema_context.report(sc, diagnostic_kind.TAG_PAYLOAD_MISSING, span, "this tag case requires a payload; write `{value}`");
        ret ty;
    }
    if (payload_len > 1) {
        sema_context.report(sc, diagnostic_kind.TAG_PAYLOAD_COUNT, span, "a tag case carries exactly one payload; group several values in a record");
        ret ty;
    }
    if (!type_kind.is_error(payload_ty)) {
        check.check_coercible(sc, expected, sc.view.a.expr_ids.data[literal.elems_start], payload_ty, span);
    }
    ret ty;
}

# the kind a literal of type `ty` builds, through outer secrecy and an instance to its nominal;
# none for a type the store does not hold
fun literal_kind(sc: *sema_context.SemaContext, ty: type_kind.TypeId) opt[type_kind.TypeKind] {
    val found: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (sel found.none)                             { ret opt[type_kind.TypeKind].none{}; }
    if (found.some.kind != type_kind.TYPE_INSTANCE) { ret opt[type_kind.TypeKind].some{found.some.kind}; }
    val nominal: opt[*type.Type] = type.get(?sc.s.types, found.some.data.instance.nominal);
    if (sel nominal.none) { ret opt[type_kind.TypeKind].none{}; }
    ret opt[type_kind.TypeKind].some{nominal.some.kind};
}

fun infer_struct_lit(sc: *sema_context.SemaContext, sl: *ast_expr.ExprStructLit, span: lang_source.Span) type_kind.TypeId {
    var case_span: lang_source.Span   = lang_source.span(0, 0);
    var case_desc: ast_id.ExprId      = ast_id.EXPR_NIL;
    val head:      opt[ast_type.Type] = sema_context.type_node(sc, sl.ty);
    if (sel head.some) {
        if (head.some.kind == ast_type.TYPE_KIND_NAMED) {
            case_span = head.some.data.named.case_name;
            case_desc = head.some.data.named.case_desc;
        }
    }
    val rec_ty: type_kind.TypeId = sema_context.resolved_type_of(sc, sl.ty);
    if (type_is_generic_param(sc, rec_ty)) {
        var i: u32 = 0;
        for (i < sl.fields_len) {
            val field: *ast_expr.FieldInit = ?sc.view.a.field_inits.data[sl.fields_start + i];
            if (field.form != ast_expr.INIT_BARE) { infer_expr(sc, field.value); }
            i = i + 1;
        }
        ret rec_ty;
    }
    if (case_span.len != 0 || !ast_id.expr_is_nil(case_desc)) {
        ret infer_tag_case_lit(sc, sl, rec_ty, case_span, case_desc, span);
    }
    # a type the store does not hold builds neither a record nor a union
    var kind:  type_kind.TypeKind      = type_kind.TYPE_GENERIC_PARAM;
    val known: opt[type_kind.TypeKind] = literal_kind(sc, type.strip_secret(?sc.s.types, rec_ty));
    if (sel known.some) { kind = known.some; }
    if (kind == type_kind.TYPE_TAG) {
        check.report_typed(sc, diagnostic_kind.TAG_CONSTRUCTOR_FORM, span, "a tag value is constructed as `Type.case{payload}`; `", rec_ty,
            "{...}` names no case");
        ret type_kind.TYPE_ERROR;
    }
    if (kind == type_kind.TYPE_VECTOR) {
        var i: u32 = 0;
        for (i < sl.fields_len) {
            val field: *ast_expr.FieldInit = ?sc.view.a.field_inits.data[sl.fields_start + i];
            if (field.form == ast_expr.INIT_NAMED) { sema_context.report(sc, diagnostic_kind.VECTOR_LITERAL_NAMED, field.name, "a vector literal requires positional elements"); }
            i = i + 1;
        }
        var vector: ast_expr.ExprVectorLit = ast_expr.ExprVectorLit{ty: sl.ty, elems_start: sl.elems_start, elems_len: sl.elems_len};
        ret infer_vector_lit(sc, ?vector, span);
    }
    if (!type_kind.is_error(rec_ty) && kind != type_kind.TYPE_REC && kind != type_kind.TYPE_UNI) {
        check.report_typed(sc, diagnostic_kind.TYPE_MISMATCH, span, "a `Type{...}` literal builds a record or a union, and `", rec_ty, "` is neither");
    }
    sema_context.record_at(sc, span, subst.ensure_fields(sc.s, rec_ty));
    val table: opt[*type_field.Table] = sema_context.field_table_for(sc, rec_ty);

    val is_union_lit: bool             = !type_kind.is_error(rec_ty) && kind == type_kind.TYPE_UNI;
    if (is_union_lit && sl.fields_len != 1) {
        sema_context.report(sc, diagnostic_kind.UNI_LITERAL_FIELDS, span, "union literal must initialize exactly one field");
    }

    var next: u32 = 0;
    var i:    u32 = 0;
    for (i < sl.fields_len) {
        val fi: *ast_expr.FieldInit = ?sc.view.a.field_inits.data[sl.fields_start + i];
        if (fi.form != ast_expr.INIT_NAMED) {
            sema_context.report(sc, diagnostic_kind.FIELD_MISSING_VALUE, fi.name, "a record or union initializer requires a field value");
            i = i + 1;
            cnt;
        }
        val vt:    type_kind.TypeId = infer_expr(sc, fi.value);
        val fname: intern.StrId     = sema_declared.intern_span_or_nil(sc, fi.name);

        if (!type_kind.is_error(rec_ty)) {
            var j: u32 = 0;
            for (j < i) {
                val fj: *ast_expr.FieldInit = ?sc.view.a.field_inits.data[sl.fields_start + j];
                if (fj.name.len == fi.name.len && memory.raw_equal(?sc.view.source[fj.name.offset], ?sc.view.source[fi.name.offset], fi.name.len)) {
                    check.report_named(sc, diagnostic_kind.FIELD_DUPLICATE_INIT, fi.name, "duplicate field `", fname, "` in initializer");
                }
                j = j + 1;
            }
        }

        if (sel table.some) {
            if (!type_kind.is_error(rec_ty) && !type_kind.is_error(vt)) {
                val at: opt[u32] = sema_context.field_index(sc, table.some, fname, next);
                if (!sel at.some) {
                    check.report_no_field(sc, fi.name, fname, rec_ty);
                }
                or (sel at.some) {
                    next = at.some + 1;
                    check.check_coercible(sc, type.field_entry_at(?sc.s.types, table.some, at.some).ty, fi.value, vt, span);
                }
            }
        }
        i = i + 1;
    }
    ret rec_ty;
}

fun pointee_of(sc: *sema_context.SemaContext, ty: type_kind.TypeId, span: lang_source.Span) type_kind.TypeId {
    val base:  type_kind.TypeId = type.strip_secret(?sc.s.types, ty);
    val t_opt: opt[*type.Type]  = type.get(?sc.s.types, base);
    if (!sel t_opt.some) { ret type_kind.TYPE_ERROR; }
    val t: *type.Type = t_opt.some;
    if (t.kind != type_kind.TYPE_POINTER) {
        sema_context.report(sc, diagnostic_kind.PTR_DEREF_NON_POINTER, span, "type mismatch: dereference of non-pointer type");
        ret type_kind.TYPE_ERROR;
    }
    ret t.data.pointer.base;
}

fun is_aggregate(sc: *sema_context.SemaContext, ty: type_kind.TypeId) bool {
    val base:  type_kind.TypeId = type.strip_secret(?sc.s.types, ty);
    val found: opt[*type.Type]  = type.get(?sc.s.types, base);
    if (!sel found.some) { ret false; }
    val t: *type.Type = found.some;
    if (t.kind == type_kind.TYPE_REC || t.kind == type_kind.TYPE_UNI || t.kind == type_kind.TYPE_TAG || t.kind == type_kind.TYPE_ARRAY) { ret true; }
    if (t.kind == type_kind.TYPE_INSTANCE) {
        val nominal: opt[*type.Type] = type.get(?sc.s.types, t.data.instance.nominal);
        if (!sel nominal.some) {
            lang_phase.internal(?sc.status, "generic instance has no nominal type");
            ret false;
        }
        val kind: type_kind.TypeKind = nominal.some.kind;
        ret kind == type_kind.TYPE_REC || kind == type_kind.TYPE_UNI || kind == type_kind.TYPE_TAG;
    }
    ret false;
}

fun unify_literals(sc: *sema_context.SemaContext, lhs: ast_id.ExprId, lt: type_kind.TypeId, rhs: ast_id.ExprId, rt: type_kind.TypeId) opt[type_kind.TypeId] {
    if (type_kind.same(lt, rt)) { ret opt[type_kind.TypeId].none{}; }
    val cr_r: res[coerce.CoerceResult, fail.Fail] = coerce.try_coerce_literal(sc, rhs, lt);
    if (sel cr_r.err) { ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR}; }
    val cr: coerce.CoerceResult = cr_r.ok;
    if (cr.kind == coerce.COERCE_COERCED) { ret opt[type_kind.TypeId].some{lt}; }
    if (cr.kind == coerce.COERCE_OUT_OF_RANGE) {
        val at: res[lang_source.Span, fail.Fail] = check.expr_span_of(sc, rhs);
        if (sel at.err) { ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR}; }
        check.report_out_of_range(sc, at.ok, cr);
        ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR};
    }
    val cl_r: res[coerce.CoerceResult, fail.Fail] = coerce.try_coerce_literal(sc, lhs, rt);
    if (sel cl_r.err) { ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR}; }
    val cl: coerce.CoerceResult = cl_r.ok;
    if (cl.kind == coerce.COERCE_COERCED) { ret opt[type_kind.TypeId].some{rt}; }
    if (cl.kind == coerce.COERCE_OUT_OF_RANGE) {
        val at: res[lang_source.Span, fail.Fail] = check.expr_span_of(sc, lhs);
        if (sel at.err) { ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR}; }
        check.report_out_of_range(sc, at.ok, cl);
        ret opt[type_kind.TypeId].some{type_kind.TYPE_ERROR};
    }
    ret opt[type_kind.TypeId].none{};
}

fun type_mismatch(sc: *sema_context.SemaContext, span: lang_source.Span, lt: type_kind.TypeId, rt: type_kind.TypeId) {
    check.report_typed2(sc, diagnostic_kind.OPERATOR_OPERAND_MISMATCH, span, "type mismatch: incompatible operand types `", lt, "` and `", rt, "`");
}

fun report_operand_width(sc: *sema_context.SemaContext, span: lang_source.Span, lt: type_kind.TypeId, rt: type_kind.TypeId) {
    check.report_typed2(sc, diagnostic_kind.OPERATOR_OPERAND_MISMATCH, span, "type mismatch: `", lt, "` and `", rt, "` are different types, and mach inserts no implicit conversion between them; cast one operand explicitly (`::`) so both operands and the result have one type");
}

fun report_int_float_cmp(sc: *sema_context.SemaContext, span: lang_source.Span) {
    sema_context.report(sc, diagnostic_kind.OPERATOR_OPERAND_MISMATCH, span, "type mismatch: cannot compare an integer and a float; cast one operand explicitly (`::`)");
}

fun report_aggregate_eq(sc: *sema_context.SemaContext, span: lang_source.Span, lt: type_kind.TypeId, rt: type_kind.TypeId) {
    var ty: type_kind.TypeId = lt;
    if (!is_aggregate(sc, lt)) { ty = rt; }
    check.report_typed(sc, diagnostic_kind.OPERATOR_AGGREGATE_EQUALITY, span, "cannot compare `", ty, "` values with `==` / `!=`: aggregate equality is not structural. compare fields or elements individually, or use `std.derive.eq` for a derived structural comparison");
}
