pub fun seed_builtins(sc: *context.SemaContext) R.Result[R.Void, str] {
    ret R.ok_void[str]();
}

pub fun infer_decl(sc: *context.SemaContext, did: id.DeclId) type.TypeId {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret type.TYPE_ERROR; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    if (d.kind == decl.DECL_KIND_FUN) { ret infer_fun_sig(sc, ?d.data.fun_); }
    if (d.kind == decl.DECL_KIND_REC) { ret infer_nominal(sc, did, d.data.rec_.name, ?d.data.rec_, type.TYPE_REC); }
    if (d.kind == decl.DECL_KIND_UNI) { ret infer_nominal_uni(sc, did, d.data.uni_.name, ?d.data.uni_, type.TYPE_UNI); }
    if (d.kind == decl.DECL_KIND_DEF) {
        if (d.data.def_.ty == id.TYPE_NIL && abitype.declares_abi_type(sc, d)) {
            ret abitype.type_of(sc, d);
        }
        if (d.data.def_.ty == id.TYPE_NIL) { ret handle.type_of(sc, did, d); }
        ret context.resolved_type_of(sc, d.data.def_.ty);
    }
    if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
        ret infer_binding(sc, ?d.data.bind);
    }
    ret type.TYPE_NIL;
}

fun infer_fun_sig(sc: *context.SemaContext, f: *decl.DeclFun) type.TypeId {
    val ret_type: type.TypeId = context.resolved_type_of(sc, f.return_type);

    var runtime_count: u32 = 0;
    var i: u32 = 0;
    for (i < f.params_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[f.params_start + i];
        if (!tn.comptime) { runtime_count = runtime_count + 1; }
        i = i + 1;
    }

    if (runtime_count == 0) {
        val r: R.Result[type.TypeId, str] = type.intern_function(?sc.s.types, ret_type, nil, 0, f.c_variadic);
        if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
        ret R.unwrap_ok[type.TypeId, str](r);
    }

    val pr: R.Result[*type.TypeId, str] = allocate_params(sc, runtime_count);
    if (R.is_err[*type.TypeId, str](pr)) { fail.internal(?sc.status, R.unwrap_err[*type.TypeId, str](pr)); ret type.TYPE_ERROR; }
    val params: *type.TypeId = R.unwrap_ok[*type.TypeId, str](pr);

    var w: u32 = 0;
    i = 0;
    for (i < f.params_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[f.params_start + i];
        if (!tn.comptime) {
            params[w] = context.resolved_type_of(sc, tn.ty);
            w = w + 1;
        }
        i = i + 1;
    }

    val r: R.Result[type.TypeId, str] = type.intern_function(?sc.s.types, ret_type, params, runtime_count, f.c_variadic);
    free_params(sc, params, runtime_count);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun infer_nominal(sc: *context.SemaContext, did: id.DeclId, name_span: token.Span, r: *decl.DeclRec, kind: type.TypeKind) type.TypeId {
    val name_id: intern.StrId = intern_span_or_nil(sc, name_span);
    val tr: R.Result[type.TypeId, str] = type.intern_nominal(?sc.s.types, name_id, sc.own_module, did, kind);
    if (R.is_err[type.TypeId, str](tr)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](tr)); ret type.TYPE_ERROR; }
    val ty: type.TypeId = R.unwrap_ok[type.TypeId, str](tr);

    elaborate_nominal(sc, did, ty, r.fields_start, r.fields_len);
    ret ty;
}

fun infer_nominal_uni(sc: *context.SemaContext, did: id.DeclId, name_span: token.Span, u: *decl.DeclUni, kind: type.TypeKind) type.TypeId {
    val name_id: intern.StrId = intern_span_or_nil(sc, name_span);
    val tr: R.Result[type.TypeId, str] = type.intern_nominal(?sc.s.types, name_id, sc.own_module, did, kind);
    if (R.is_err[type.TypeId, str](tr)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](tr)); ret type.TYPE_ERROR; }
    val ty: type.TypeId = R.unwrap_ok[type.TypeId, str](tr);

    elaborate_nominal(sc, did, ty, u.fields_start, u.fields_len);
    ret ty;
}

fun elaborate_nominal(sc: *context.SemaContext, did: id.DeclId, ty: type.TypeId,
                      fields_start: u32, fields_len: u32) O.Option[intern.StrId] {
    val st: u8 = layout_state_of(sc, did);
    if (st == context.LAYOUT_READY)  { ret O.none[intern.StrId](); }
    if (st == context.LAYOUT_FAILED) { ret O.none[intern.StrId](); }
    if (st == context.LAYOUT_ACTIVE) { ret O.some[intern.StrId](nominal_name_id(sc, did)); }

    layout_state_set(sc, did, context.LAYOUT_ACTIVE);
    if (!build_field_table(sc, ty, fields_start, fields_len)) {
        layout_state_set(sc, did, context.LAYOUT_FAILED);
        context.report(sc, decl_name_span(sc, did), FIELD_TABLE_FAILED_MSG);
        ret O.none[intern.StrId]();
    }
    record_type_align(sc, did, ty);
    record_type_packed(sc, did, ty, fields_start, fields_len);
    record_type_volatile(sc, did, ty);
    layout_state_set(sc, did, context.LAYOUT_READY);
    ret O.none[intern.StrId]();
}

pub val FIELD_TABLE_FAILED_MSG: str = "internal: out of memory recording this type's fields; the type is published as failed rather than with the fields that fit, because a partial field table would place every later field at the wrong offset";

fun decl_name_span(sc: *context.SemaContext, did: id.DeclId) token.Span {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](d_opt)) {
        var empty: token.Span;
        empty.offset = 0;
        empty.len    = 0;
        ret empty;
    }
    ret O.unwrap[*decl.Decl](d_opt).span;
}

fun layout_state_of(sc: *context.SemaContext, did: id.DeclId) u8 {
    if (sc.layout_state == nil)     { ret context.LAYOUT_READY; }
    if (did >= sc.a.decl_len::u32)  { ret context.LAYOUT_READY; }
    ret sc.layout_state[did];
}

fun layout_state_set(sc: *context.SemaContext, did: id.DeclId, st: u8) {
    if (sc.layout_state == nil)    { ret; }
    if (did >= sc.a.decl_len::u32) { ret; }
    sc.layout_state[did] = st;
}

fun nominal_name_id(sc: *context.SemaContext, did: id.DeclId) intern.StrId {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret intern.STR_NIL; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind == decl.DECL_KIND_UNI) { ret intern_span_or_nil(sc, d.data.uni_.name); }
    if (d.kind == decl.DECL_KIND_REC) { ret intern_span_or_nil(sc, d.data.rec_.name); }
    ret intern.STR_NIL;
}

fun ensure_layout_ready(sc: *context.SemaContext, tid: type.TypeId) O.Option[intern.StrId] {
    ret ensure_layout_walk(sc, tid, 0);
}

fun ensure_layout_walk(sc: *context.SemaContext, tid: type.TypeId, depth: u32) O.Option[intern.StrId] {
    if (depth > LAYOUT_FORCE_MAX_DEPTH) { ret O.none[intern.StrId](); }
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret O.none[intern.StrId](); }

    val base: type.TypeId = type.strip_secret(?sc.s.types, tid);
    val t_opt: O.Option[*type.Type] = type.get(?sc.s.types, base);
    if (O.is_none[*type.Type](t_opt)) { ret O.none[intern.StrId](); }
    val t: *type.Type = O.unwrap[*type.Type](t_opt);

    if (t.kind == type.TYPE_ARRAY) { ret ensure_layout_walk(sc, t.data.array.base, depth + 1); }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI) {
        if (t.data.nominal.origin != sc.own_module) { ret O.none[intern.StrId](); }
        val did: id.DeclId = t.data.nominal.decl;
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
        if (O.is_none[*decl.Decl](d_opt)) { ret O.none[intern.StrId](); }
        val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

        var fstart: u32 = d.data.rec_.fields_start;
        var flen:   u32 = d.data.rec_.fields_len;
        if (d.kind == decl.DECL_KIND_UNI) {
            fstart = d.data.uni_.fields_start;
            flen   = d.data.uni_.fields_len;
        }
        or (d.kind != decl.DECL_KIND_REC) { ret O.none[intern.StrId](); }

        val cyc: O.Option[intern.StrId] = elaborate_nominal(sc, did, base, fstart, flen);
        if (O.is_some[intern.StrId](cyc)) { ret cyc; }
        ret ensure_layout_fields(sc, base, depth);
    }

    if (t.kind == type.TYPE_INSTANCE) {
        val cyc: O.Option[intern.StrId] = ensure_layout_walk(sc, t.data.instance.nominal, depth + 1);
        if (O.is_some[intern.StrId](cyc)) { ret cyc; }
        context.record_result(sc, generics.ensure_fields(sc.s, base));
        ret ensure_layout_fields(sc, base, depth);
    }

    ret O.none[intern.StrId]();
}

fun ensure_layout_fields(sc: *context.SemaContext, ty: type.TypeId, depth: u32) O.Option[intern.StrId] {
    val n: u32 = type.field_count(?sc.s.types, ty);
    var i: u32 = 0;
    for (i < n) {
        val fe: O.Option[*type.FieldEntry] = type.field_at(?sc.s.types, ty, i);
        if (O.is_some[*type.FieldEntry](fe)) {
            val cyc: O.Option[intern.StrId] = ensure_layout_walk(sc, O.unwrap[*type.FieldEntry](fe).ty, depth + 1);
            if (O.is_some[intern.StrId](cyc)) { ret cyc; }
        }
        i = i + 1;
    }
    ret O.none[intern.StrId]();
}

pub fun resolve_type_query(sc: *context.SemaContext, tid: u32, which: u8) R.Result[O.Option[comptime.CTValue], str] {
    if (sc == nil) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }
    ret answer_type_query(sc.s, tid, which);
}

pub fun answer_type_query(s: *session.Session, tid: u32, which: u8) R.Result[O.Option[comptime.CTValue], str] {
    val t: type.TypeId = tid::type.TypeId;
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) {
        ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]());
    }

    if (which == comptime.TYPE_QUERY_IS_SECRET) {
        if (type.is_secret(?s.types, t)) {
            ret R.ok[O.Option[comptime.CTValue], str](O.some[comptime.CTValue](comptime.ct_u8(1)));
        }
        if (type.shape_kind(?s.types, t) == type.TYPE_GENERIC_PARAM) {
            ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]());
        }
        ret R.ok[O.Option[comptime.CTValue], str](O.some[comptime.CTValue](comptime.ct_u8(0)));
    }

    if (type.is_secret(?s.types, t) && which != comptime.TYPE_QUERY_NAME) {
        ret R.ok[O.Option[comptime.CTValue], str](O.some[comptime.CTValue](comptime.ct_u8(0)));
    }

    if (type.shape_kind(?s.types, t) == type.TYPE_GENERIC_PARAM) {
        ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]());
    }

    if (which == comptime.TYPE_QUERY_NAME) {
        val r: R.Result[str, str] = typename.type_to_str(s, t);
        if (R.is_err[str, str](r)) { ret R.err[O.Option[comptime.CTValue], str](R.unwrap_err[str, str](r)); }
        val text: str = R.unwrap_ok[str, str](r);
        val ir_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, text);
        A.deallocate[char](s.alloc, text, str_len(text) + 1);
        if (R.is_err[intern.StrId, str](ir_r)) {
            ret R.err[O.Option[comptime.CTValue], str](R.unwrap_err[intern.StrId, str](ir_r));
        }
        ret R.ok[O.Option[comptime.CTValue], str](
            O.some[comptime.CTValue](comptime.ct_str(R.unwrap_ok[intern.StrId, str](ir_r))));
    }

    val k: type.TypeKind = type.shape_kind(?s.types, t);
    var answer: bool = false;
    if (which == comptime.TYPE_QUERY_IS_RECORD)  { answer = k == type.TYPE_REC; }
    if (which == comptime.TYPE_QUERY_IS_UNION)   { answer = k == type.TYPE_UNI; }
    if (which == comptime.TYPE_QUERY_IS_POINTER) { answer = k == type.TYPE_POINTER || k == type.TYPE_PTR; }
    var bit: u8 = 0;
    if (answer) { bit = 1; }
    ret R.ok[O.Option[comptime.CTValue], str](O.some[comptime.CTValue](comptime.ct_u8(bit)));
}

fun fold_layout_intrinsic(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) O.Option[O.Option[comptime.CTValue]] {
    val is_size:  bool = comptime.is_size_of_call(sc.a, sc.source, eid);
    val is_align: bool = comptime.is_align_of_call(sc.a, sc.source, eid);
    val is_len:   bool = comptime.is_length_of_call(sc.a, sc.source, eid);
    if (!is_size && !is_align && !is_len) { ret O.none[O.Option[comptime.CTValue]](); }

    val arg: id.ExprId = comptime.layout_intrinsic_type_arg(sc.a, eid);
    if (arg == id.EXPR_NIL) {
        context.report(sc, span, "a layout intrinsic takes one type argument");
        ret O.some[O.Option[comptime.CTValue]](O.none[comptime.CTValue]());
    }

    val tid: type.TypeId = intrinsic_operand_type(sc, arg, span);
    if (tid == type.TYPE_ERROR) { ret O.some[O.Option[comptime.CTValue]](O.none[comptime.CTValue]()); }

    if (is_len) {
        val n_opt: O.Option[u32] = type.element_count(?sc.s.types, tid);
        if (O.is_none[u32](n_opt)) {
            check.report_typed(sc, span, "`$length_of` has no answer for `", tid,
                "`: only a fixed array and a vector carry a statically known element count",
                "`$length_of` expects a fixed array or a vector");
            ret O.some[O.Option[comptime.CTValue]](O.none[comptime.CTValue]());
        }
        ret O.some[O.Option[comptime.CTValue]](
            O.some[comptime.CTValue](comptime.ct_uint(O.unwrap[u32](n_opt)::u64)));
    }

    val cyc: O.Option[intern.StrId] = ensure_layout_ready(sc, tid);
    if (O.is_some[intern.StrId](cyc)) {
        check.report_named(sc, span, "layout cycle: measuring `", O.unwrap[intern.StrId](cyc),
                           "` here needs a layout this measurement is itself deciding. break the cycle with a literal alignment or length",
                           "layout cycle: this measurement's answer is one of its own inputs");
        ret O.some[O.Option[comptime.CTValue]](O.none[comptime.CTValue]());
    }

    val ext: layout.Extent = context.recover[layout.Extent](sc, generics.type_extent(sc.s, context.machine_of(sc), tid), layout.unknown_extent(layout.EXTENT_UNKNOWN_NODE));
    if (!ext.ok) {
        context.report(sc, span, "the layout of the type named by this intrinsic could not be determined");
        ret O.some[O.Option[comptime.CTValue]](O.none[comptime.CTValue]());
    }

    var n: u32 = ext.size;
    if (is_align) { n = ext.align; }
    ret O.some[O.Option[comptime.CTValue]](O.some[comptime.CTValue](comptime.ct_uint(n::u64)));
}

pub fun resolve_layout_intrinsic(sc: *context.SemaContext, eid: u32) R.Result[O.Option[comptime.CTValue], str] {
    if (sc == nil) { ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]()); }
    val e: id.ExprId = eid::id.ExprId;
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, e);
    if (O.is_none[*expr.Expr](e_opt)) {
        ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]());
    }
    val span: token.Span = O.unwrap[*expr.Expr](e_opt).span;

    val lay: O.Option[O.Option[comptime.CTValue]] = fold_layout_intrinsic(sc, e, span);
    if (O.is_none[O.Option[comptime.CTValue]](lay)) {
        ret R.ok[O.Option[comptime.CTValue], str](O.none[comptime.CTValue]());
    }
    val inner: O.Option[comptime.CTValue] = O.unwrap[O.Option[comptime.CTValue]](lay);
    if (O.is_none[comptime.CTValue](inner)) {
        ret R.err[O.Option[comptime.CTValue], str](LAYOUT_REPORTED_MSG);
    }
    ret R.ok[O.Option[comptime.CTValue], str](
        O.some[comptime.CTValue](O.unwrap[comptime.CTValue](inner)));
}

pub val LAYOUT_REPORTED_MSG: str = "this layout intrinsic could not be measured; see the diagnostic reported against it";

val LAYOUT_FORCE_MAX_DEPTH: u32 = 64;

val REACHES_MAX_DEPTH: u32 = 1024;

pub val REACHES_DEPTH_MSG: str = "this type nests deeper than the recursive-type checker can walk, so it cannot be proven to have a finite size; break the nesting with a pointer (`*T`)";

fun reaches_nominal(s: *session.Session, seen: *u32, cap: u32, stamp: u32,
                    target: type.TypeId, ty: type.TypeId, depth: u32) R.Result[bool, str] {
    if (depth >= REACHES_MAX_DEPTH) { ret R.err[bool, str](REACHES_DEPTH_MSG); }

    val base: type.TypeId = type.strip_secret(?s.types, ty);
    val opt: O.Option[*type.Type] = type.get(?s.types, base);
    if (O.is_none[*type.Type](opt)) { ret R.ok[bool, str](false); }
    val t: *type.Type = O.unwrap[*type.Type](opt);

    if (t.kind == type.TYPE_ARRAY) {
        ret reaches_nominal(s, seen, cap, stamp, target, t.data.array.base, depth + 1);
    }

    if (t.kind != type.TYPE_REC && t.kind != type.TYPE_UNI && t.kind != type.TYPE_INSTANCE) {
        ret R.ok[bool, str](false);
    }

    val nom: type.TypeId = type.aggregate_nominal(?s.types, base);
    if (nom == type.TYPE_ERROR)  { ret R.ok[bool, str](false); }
    if (nom == target)           { ret R.ok[bool, str](true); }
    if (nom::u32 >= cap)         { ret R.ok[bool, str](false); }
    if (seen[nom::u32] == stamp) { ret R.ok[bool, str](false); }
    seen[nom::u32] = stamp;

    val n: u32 = type.field_count(?s.types, nom);
    var i: u32 = 0;
    for (i < n) {
        val fe: O.Option[*type.FieldEntry] = type.field_at(?s.types, nom, i);
        if (O.is_some[*type.FieldEntry](fe)) {
            val reaches_r: R.Result[bool, str] = reaches_nominal(s, seen, cap, stamp, target,
                                                                 O.unwrap[*type.FieldEntry](fe).ty, depth + 1);
            if (R.is_err[bool, str](reaches_r))    { ret reaches_r; }
            if (R.unwrap_ok[bool, str](reaches_r)) { ret R.ok[bool, str](true); }
        }
        i = i + 1;
    }
    ret R.ok[bool, str](false);
}

val REACHES_NO:        u8 = 0;
val REACHES_YES:       u8 = 1;
val REACHES_EXHAUSTED: u8 = 2;

fun reaches_checked(sc: *context.SemaContext, seen: *u32, cap: u32, stamp: u32,
                    target: type.TypeId, ty: type.TypeId, at: token.Span) u8 {
    val reaches_r: R.Result[bool, str] = reaches_nominal(sc.s, seen, cap, stamp, target, ty, 0);
    if (R.is_err[bool, str](reaches_r)) {
        context.report(sc, at, R.unwrap_err[bool, str](reaches_r));
        ret REACHES_EXHAUSTED;
    }
    if (R.unwrap_ok[bool, str](reaches_r)) { ret REACHES_YES; }
    ret REACHES_NO;
}

fun check_occurs(sc: *context.SemaContext, nom: type.TypeId, fields_start: u32, fields_len: u32,
                 seen: *u32, cap: u32, stamp: u32) u32 {
    var next: u32 = stamp;
    var i:    u32 = 0;
    for (i < fields_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[fields_start + i];
        val ty: type.TypeId     = context.resolved_type_of(sc, tn.ty);
        if (reaches_checked(sc, seen, cap, next, nom, ty, tn.name) == REACHES_YES) {
            context.report(sc, tn.name, "recursive type has infinite size: this field contains the type being declared by value, so the type would have to contain itself; store it behind a pointer (`*T`) to break the cycle");
        }
        next = next + 1;
        i = i + 1;
    }
    ret next;
}

fun check_uni_secrecy(sc: *context.SemaContext, nom: type.TypeId, fields_start: u32, fields_len: u32,
                      seen: *u32, cap: u32, stamp: u32) u32 {
    var next: u32 = stamp;
    if (fields_len < 2) { ret next; }

    var first_ty: type.TypeId = type.TYPE_NIL;
    var b:        u32         = 0;
    for (b < fields_len) {
        val btn: *decl.TypedName = ?sc.a.typed_names[fields_start + b];
        val bty: type.TypeId     = context.resolved_type_of(sc, btn.ty);
        val br:  u8              = reaches_checked(sc, seen, cap, next, nom, bty, btn.name);
        if (br == REACHES_EXHAUSTED) { ret next + 1; }
        if (br == REACHES_NO) {
            first_ty = bty;
            next = next + 1;
            b = b + 1;
            brk;
        }
        next = next + 1;
        b = b + 1;
    }
    if (first_ty == type.TYPE_NIL) { ret next; }

    var i: u32 = b;
    for (i < fields_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[fields_start + i];
        val ty: type.TypeId     = context.resolved_type_of(sc, tn.ty);
        val cr: u8              = reaches_checked(sc, seen, cap, next, nom, ty, tn.name);
        next = next + 1;
        if (cr == REACHES_EXHAUSTED) { ret next; }
        if (cr == REACHES_NO) {
            val verdict: generics.SecrecyVerdict = context.recover[generics.SecrecyVerdict](sc, generics.secrecy_structure_equal_deep(sc.s, context.machine_of(sc), first_ty, ty), generics.SECRECY_UNRECORDABLE);
            if (verdict == generics.SECRECY_UNRECORDABLE) {
                context.report(sc, tn.name, "cannot prove that this union's variants agree on secrecy: the checker ran out of room to record the comparison, so the variants are rejected without having been compared");
            }
            if (verdict == generics.SECRECY_DIFFERS) {
                context.report(sc, tn.name, "union variants must agree on secrecy: overlapping fields are part secret `^` and part public, which would alias the same storage at two classifications");
            }
        }
        i = i + 1;
    }
    ret next;
}

pub fun check_occurs_all(sc: *context.SemaContext) R.Result[R.Void, str] {
    if (sc.decl_type == nil) { ret R.ok_void[str](); }

    val cap: u32 = type.type_count(?sc.s.types);
    if (cap == 0) { ret R.ok_void[str](); }

    val res: R.Result[*u32, str] = A.allocate[u32](sc.s.alloc, cap::usize);
    if (R.is_err[*u32, str](res)) { fail.internal(?sc.status, R.unwrap_err[*u32, str](res)); ret R.err[R.Void, str](RECURSIVE_SCRATCH_MSG); }
    val seen: *u32 = R.unwrap_ok[*u32, str](res);

    var z: u32 = 0;
    for (z < cap) { seen[z] = 0; z = z + 1; }
    var stamp: u32 = 1;

    var d: u32 = 0;
    for (d < sc.a.decl_len::u32) {
        if (sc.decl_type[d] != type.TYPE_NIL) {
            val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, d);
            if (O.is_some[*decl.Decl](d_opt)) {
                val dd: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
                if (dd.kind == decl.DECL_KIND_REC) {
                    stamp = check_occurs(sc, sc.decl_type[d], dd.data.rec_.fields_start,
                                         dd.data.rec_.fields_len, seen, cap, stamp);
                }
                if (dd.kind == decl.DECL_KIND_UNI) {
                    stamp = check_occurs(sc, sc.decl_type[d], dd.data.uni_.fields_start,
                                         dd.data.uni_.fields_len, seen, cap, stamp);
                }
            }
        }
        d = d + 1;
    }

    A.deallocate[u32](sc.s.alloc, seen, cap::usize);
    ret R.ok_void[str]();
}

pub val RECURSIVE_SCRATCH_MSG: str = "internal: out of memory allocating the recursive-type checker's scratch table; the check cannot be skipped, because a type that contains itself by value would reach layout with no finite size";

pub fun check_uni_secrecy_all(sc: *context.SemaContext) R.Result[R.Void, str] {
    val cap: u32 = type.type_count(?sc.s.types);
    if (cap == 0) { ret R.ok_void[str](); }

    val res: R.Result[*u32, str] = A.allocate[u32](sc.s.alloc, cap::usize);
    if (R.is_err[*u32, str](res)) { fail.internal(?sc.status, R.unwrap_err[*u32, str](res)); ret R.err[R.Void, str](RECURSIVE_SCRATCH_MSG); }
    val seen: *u32 = R.unwrap_ok[*u32, str](res);
    var z: u32 = 0;
    for (z < cap) { seen[z] = 0; z = z + 1; }

    var stamp: u32 = 1;

    if (sc.decl_type != nil) {
        var d: u32 = 0;
        for (d < sc.a.decl_len::u32) {
            if (sc.decl_type[d] != type.TYPE_NIL) {
                val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, d);
                if (O.is_some[*decl.Decl](d_opt)) {
                    val dd: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
                    if (dd.kind == decl.DECL_KIND_UNI) {
                        stamp = check_uni_secrecy(sc, sc.decl_type[d], dd.data.uni_.fields_start,
                                                  dd.data.uni_.fields_len, seen, cap, stamp);
                    }
                }
            }
            d = d + 1;
        }
    }

    var i: u32 = 0;
    for (i < sc.a.type_len::u32) {
        val t_opt: O.Option[*atype.Type] = ast.get_type(sc.a, i);
        if (O.is_some[*atype.Type](t_opt)) {
            val t: *atype.Type = O.unwrap[*atype.Type](t_opt);
            if (t.kind == atype.TYPE_KIND_UNI) {
                stamp = check_uni_secrecy(sc, sc.type_resolved_ty[i], t.data.uni_.fields_start,
                                          t.data.uni_.fields_len, seen, cap, stamp);
            }
        }
        i = i + 1;
    }

    A.deallocate[u32](sc.s.alloc, seen, cap::usize);
    ret R.ok_void[str]();
}

fun record_type_packed(sc: *context.SemaContext, did: id.DeclId, ty: type.TypeId,
                       fields_start: u32, fields_len: u32) {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (str_region_equals(sc.source, dec.name.offset, dec.name.len, "packed")) {
            val rr: R.Result[R.Void, str] = session.register_type_packed(sc.s, ty::u32);
            if (R.is_err[R.Void, str](rr)) {
                context.report_internal(sc, dec.name, "internal: out of memory registering this type as `#[packed]`; every access would silently compile against the ordinary, unpacked layout");
                ret;
            }
            check_packed_no_vector_fields(sc, fields_start, fields_len);
            ret;
        }
        i = i + 1;
    }
}

fun record_type_volatile(sc: *context.SemaContext, did: id.DeclId, ty: type.TypeId) {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (str_region_equals(sc.source, dec.name.offset, dec.name.len, "volatile")) {
            val rr: R.Result[R.Void, str] = session.register_type_volatile(sc.s, ty::u32);
            if (R.is_err[R.Void, str](rr)) {
                context.report_internal(sc, dec.name, "internal: out of memory registering this type as `volatile`; every access would silently compile as an ordinary, non-volatile access");
                ret;
            }
            ret;
        }
        i = i + 1;
    }
}

fun check_packed_no_vector_fields(sc: *context.SemaContext, fields_start: u32, fields_len: u32) {
    var i: u32 = 0;
    for (i < fields_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[fields_start + i];
        val fty: type.TypeId = context.resolved_type_of(sc, tn.ty);
        ensure_layout_ready(sc, fty);
        if (type_contains_vector(sc, fty, 0)) {
            context.report(sc, tn.name, "a vector field is not allowed in a `#[packed]` record: packing places it at an offset nothing guarantees is a multiple of its width. the unaligned vector access itself is now measured on hardware and correct on every native leg (the codegen corpus's vec/vec_mem case, #2728); what remains is #2687's aggregate-layout half. this is a sequencing refusal and is expected to be lifted, not a permanent rule. until then, store the lanes as scalar fields, or drop `#[packed]` from this record");
            ret;
        }
        i = i + 1;
    }
}

fun type_contains_vector(sc: *context.SemaContext, t: type.TypeId, depth: u32) bool {
    if (depth > LAYOUT_FORCE_MAX_DEPTH) { ret false; }
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }

    val base: type.TypeId = type.strip_secret(?sc.s.types, t);
    if (type.is_vector(?sc.s.types, base)) { ret true; }

    val bt: O.Option[*type.Type] = type.get(?sc.s.types, base);
    if (O.is_none[*type.Type](bt)) { ret false; }
    val ty: *type.Type = O.unwrap[*type.Type](bt);

    if (ty.kind == type.TYPE_ARRAY) { ret type_contains_vector(sc, ty.data.array.base, depth + 1); }
    if (ty.kind != type.TYPE_REC && ty.kind != type.TYPE_UNI && ty.kind != type.TYPE_INSTANCE) { ret false; }

    val n: u32 = type.field_count(?sc.s.types, base);
    var i: u32 = 0;
    for (i < n) {
        val fe: O.Option[*type.FieldEntry] = type.field_at(?sc.s.types, base, i);
        if (O.is_some[*type.FieldEntry](fe)) {
            if (type_contains_vector(sc, O.unwrap[*type.FieldEntry](fe).ty, depth + 1)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun record_type_align(sc: *context.SemaContext, did: id.DeclId, ty: type.TypeId) {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (str_region_equals(sc.source, dec.name.offset, dec.name.len, "align")) {
            if (dec.args_len != 1) { ret; }
            val arg: id.ExprId = sc.a.expr_ids[dec.args_start];
            var cv: comptime.CTValue;
            val lay: O.Option[O.Option[comptime.CTValue]] = fold_layout_intrinsic(sc, arg, dec.name);
            if (O.is_some[O.Option[comptime.CTValue]](lay)) {
                val got: O.Option[comptime.CTValue] = O.unwrap[O.Option[comptime.CTValue]](lay);
                if (O.is_none[comptime.CTValue](got)) { ret; }
                cv = O.unwrap[comptime.CTValue](got);
            }
            or {
                val ev: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, arg, ?sc.s.interner);
                context.record_eval_result(sc, ev);
                if (R.is_err[comptime.CTValue, comptime.EvalFail](ev)) {
                    context.report(sc, dec.name, "`align` on a type must be a compile-time constant");
                    ret;
                }
                cv = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](ev);
            }
            if (cv.kind != comptime.CT_KIND_INT) {
                context.report(sc, dec.name, "`align` value must be an integer");
                ret;
            }
            if (comptime.ct_is_negative(cv)) {
                context.report(sc, dec.name, "`align` value must be a non-zero power of two");
                ret;
            }
            val n: u64 = cv.data.i:~u64;
            if (n == 0 || (n & (n - 1)) != 0) {
                context.report(sc, dec.name, "`align` value must be a non-zero power of two");
                ret;
            }
            if (n > 0xFFFFFFFF) {
                context.report(sc, dec.name, "`align` value exceeds the maximum alignment");
                ret;
            }
            val rr: R.Result[R.Void, str] = session.register_type_align(sc.s, ty::u32, n::u32);
            if (R.is_err[R.Void, str](rr)) {
                context.report_internal(sc, dec.name, "internal: out of memory registering this type's `align` value; layout would silently fall back to the natural alignment");
                ret;
            }
            ret;
        }
        i = i + 1;
    }
}

fun build_field_table(sc: *context.SemaContext, ty: type.TypeId, fields_start: u32, fields_len: u32) bool {
    if (O.is_some[*context.FieldTable](context.field_table_for(sc, ty))) { ret true; }

    val start_r: R.Result[u32, str] = context.field_table_stage(sc, fields_len);
    if (R.is_err[u32, str](start_r)) { ret false; }
    val start: u32 = R.unwrap_ok[u32, str](start_r);

    var i: u32 = 0;
    for (i < fields_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[fields_start + i];
        val fname: intern.StrId = intern_span_or_nil(sc, tn.name);
        var fty: type.TypeId = context.resolved_type_of(sc, tn.ty);
        if (fty == type.TYPE_NIL && sc.subst == nil && tn.ty != id.TYPE_NIL) {
            fty = resolve_type_ref(sc, tn.ty);
        }
        val push_r: R.Result[R.Void, str] = context.field_table_stage_push(sc, fname, fty);
        if (R.is_err[R.Void, str](push_r)) { ret false; }
        i = i + 1;
    }

    ret R.is_ok[R.Void, str](context.field_table_publish(sc, ty, start, fields_len));
}

fun infer_binding(sc: *context.SemaContext, b: *decl.DeclBind) type.TypeId {
    if (b.ty != id.TYPE_NIL) {
        ret context.resolved_type_of(sc, b.ty);
    }
    if (b.init != id.EXPR_NIL) {
        ret infer_expr(sc, b.init);
    }
    ret type.TYPE_ERROR;
}

pub fun infer_expr(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL) { ret type.TYPE_ERROR; }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret type.TYPE_ERROR; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    var t: type.TypeId = type.TYPE_ERROR;

    if (e.kind == expr.EXPR_KIND_LIT_INT) {
        t = lit_int_type(sc, e);
        check_lit_int_range(sc, e, t, false, e.span);
    }
    or (e.kind == expr.EXPR_KIND_LIT_FLOAT) {
        if (e.data.lit_float.suffix != expr.LIT_SUFFIX_NONE) { t = prim_or_error(sc, e.data.lit_float.suffix); }
        or { t = prim_or_error(sc, type.TYPE_F64); }
    }
    or (e.kind == expr.EXPR_KIND_LIT_CHAR) {
        t = prim_or_error(sc, type.TYPE_U8);
    }
    or (e.kind == expr.EXPR_KIND_LIT_STR) {
        t = ptr_to(sc, prim_or_error(sc, type.TYPE_U8));
    }
    or (e.kind == expr.EXPR_KIND_LIT_NIL) {
        t = ptr_to(sc, prim_or_error(sc, type.TYPE_U8));
    }
    or (e.kind == expr.EXPR_KIND_IDENT) {
        t = infer_ident(sc, eid);
    }
    or (e.kind == expr.EXPR_KIND_COMPTIME_IDENT) {
        val ev: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
        context.record_eval_result(sc, ev);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](ev)) {
            context.report(sc, e.span, R.unwrap_err[comptime.CTValue, comptime.EvalFail](ev).message);
        }
        t = type.TYPE_ERROR;
    }
    or (e.kind == expr.EXPR_KIND_BINARY) {
        t = infer_binary(sc, eid, ?e.data.binary, e.span);
    }
    or (e.kind == expr.EXPR_KIND_UNARY) {
        t = infer_unary(sc, ?e.data.unary, e.span);
    }
    or (e.kind == expr.EXPR_KIND_CALL) {
        t = infer_call(sc, ?e.data.call, e.span);
    }
    or (e.kind == expr.EXPR_KIND_GENERIC_INSTANCE) {
        t = infer_generic_instance(sc, ?e.data.call, e.span);
    }
    or (e.kind == expr.EXPR_KIND_INDEX) {
        t = infer_index(sc, ?e.data.index, e.span);
    }
    or (e.kind == expr.EXPR_KIND_MEMBER) {
        t = infer_member(sc, eid, ?e.data.member, e.span);
    }
    or (e.kind == expr.EXPR_KIND_PROJECT) {
        t = infer_project(sc, ?e.data.project, e.span);
    }
    or (e.kind == expr.EXPR_KIND_SPREAD) {
        t = infer_spread(sc, ?e.data.spread, e.span);
    }
    or (e.kind == expr.EXPR_KIND_CAST) {
        t = infer_cast(sc, ?e.data.cast, e.span);
    }
    or (e.kind == expr.EXPR_KIND_STRIP) {
        t = infer_strip(sc, ?e.data.strip, e.span);
    }
    or (e.kind == expr.EXPR_KIND_ARRAY_LIT) {
        t = infer_array_lit(sc, ?e.data.array_lit, e.span);
    }
    or (e.kind == expr.EXPR_KIND_STRUCT_LIT) {
        t = infer_struct_lit(sc, ?e.data.struct_lit, e.span);
    }
    or (e.kind == expr.EXPR_KIND_VECTOR_LIT) {
        t = infer_vector_lit(sc, ?e.data.vector_lit, e.span);
    }
    or (e.kind == expr.EXPR_KIND_TYPE_REF) {
        context.report(sc, e.span, "a type name is not a value; this position takes a value expression");
        t = type.TYPE_ERROR;
    }
    or {
        t = type.TYPE_ERROR;
    }

    if (sc.expr_type != nil && eid < sc.a.expr_len::u32) {
        sc.expr_type[eid] = t;
    }
    ret t;
}

fun infer_ident(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    val sym_opt: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](sym_opt)) { ret report_unbound_ident(sc, eid); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](sym_opt);

    val pe: type.TypeId = pack_elem_loop_var_type(sc, sym);
    if (pe != type.TYPE_NIL) { ret pe; }

    val ce: type.TypeId = const_elem_loop_var_type(sc, sym);
    if (ce != type.TYPE_NIL) { ret ce; }

    val de: type.TypeId = direct_elem_loop_var_type(sc, sym);
    if (de != type.TYPE_NIL) { ret de; }

    if (report_never_value(sc, eid, sym)) { ret type.TYPE_ERROR; }

    if (eid != sc.callee_eid && ident_is_comptime_param_fn(sc, sym)) {
        ret report_comptime_param_fn_ref(sc, eid);
    }

    ret context.decl_type_for(sc, sym);
}

fun report_unbound_ident(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_some[*expr.Expr](e_opt)) {
        context.report_internal(sc, O.unwrap[*expr.Expr](e_opt).span, "internal: this identifier reached type inference unbound; the name resolver neither bound it nor reported it");
    }
    ret type.TYPE_ERROR;
}

fun pack_elem_loop_var_type(sc: *context.SemaContext, sym: *resolve.Symbol) type.TypeId {
    if (sym.kind != resolve.SYM_VAL)                  { ret type.TYPE_NIL; }
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret type.TYPE_NIL; }
    if (sym.decl != id.DECL_NIL)                      { ret type.TYPE_NIL; }
    val nc: O.Option[comptime.NamedConst] = comptime.lookup(sc.ctx, sym.name);
    if (O.is_none[comptime.NamedConst](nc)) { ret type.TYPE_NIL; }
    val cv: comptime.CTValue = O.unwrap[comptime.NamedConst](nc).value;
    if (cv.kind != comptime.CT_KIND_PACK_ELEM) { ret type.TYPE_NIL; }
    ret cv.data.pelem.ty::type.TypeId;
}

fun const_elem_loop_var_type(sc: *context.SemaContext, sym: *resolve.Symbol) type.TypeId {
    if (sym.kind != resolve.SYM_VAL)                  { ret type.TYPE_NIL; }
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret type.TYPE_NIL; }
    if (sym.decl != id.DECL_NIL)                      { ret type.TYPE_NIL; }
    val nc: O.Option[comptime.NamedConst] = comptime.lookup(sc.ctx, sym.name);
    if (O.is_none[comptime.NamedConst](nc)) { ret type.TYPE_NIL; }
    val cv: comptime.CTValue = O.unwrap[comptime.NamedConst](nc).value;
    if (cv.kind != comptime.CT_KIND_CONST_ELEM) { ret type.TYPE_NIL; }
    ret cv.data.celem.ty::type.TypeId;
}

fun int_prim_kind_for(bits: u8, unsigned: bool) O.Option[type.TypeKind] {
    if (unsigned && bits == 8)  { ret O.some[type.TypeKind](type.TYPE_U8); }
    if (unsigned && bits == 16) { ret O.some[type.TypeKind](type.TYPE_U16); }
    if (unsigned && bits == 32) { ret O.some[type.TypeKind](type.TYPE_U32); }
    if (unsigned && bits == 64) { ret O.some[type.TypeKind](type.TYPE_U64); }
    if (!unsigned && bits == 8)  { ret O.some[type.TypeKind](type.TYPE_I8); }
    if (!unsigned && bits == 16) { ret O.some[type.TypeKind](type.TYPE_I16); }
    if (!unsigned && bits == 32) { ret O.some[type.TypeKind](type.TYPE_I32); }
    if (!unsigned && bits == 64) { ret O.some[type.TypeKind](type.TYPE_I64); }
    ret O.none[type.TypeKind]();
}

fun direct_elem_loop_var_type(sc: *context.SemaContext, sym: *resolve.Symbol) type.TypeId {
    if (sym.kind != resolve.SYM_VAL)                  { ret type.TYPE_NIL; }
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret type.TYPE_NIL; }
    if (sym.decl != id.DECL_NIL)                      { ret type.TYPE_NIL; }
    val nc: O.Option[comptime.NamedConst] = comptime.lookup(sc.ctx, sym.name);
    if (O.is_none[comptime.NamedConst](nc)) { ret type.TYPE_NIL; }
    val cv: comptime.CTValue = O.unwrap[comptime.NamedConst](nc).value;
    if (cv.kind == comptime.CT_KIND_CONST_ELEM) { ret type.TYPE_NIL; }
    if (cv.kind == comptime.CT_KIND_PACK_ELEM)  { ret type.TYPE_NIL; }
    if (cv.kind == comptime.CT_KIND_INT) {
        val k_opt: O.Option[type.TypeKind] = int_prim_kind_for(cv.int_width, cv.int_unsigned);
        if (O.is_none[type.TypeKind](k_opt)) { ret type.TYPE_NIL; }
        val id_opt: O.Option[type.TypeId] = type.prim(?sc.s.types, O.unwrap[type.TypeKind](k_opt));
        if (O.is_none[type.TypeId](id_opt)) { ret type.TYPE_NIL; }
        ret O.unwrap[type.TypeId](id_opt);
    }
    if (cv.kind == comptime.CT_KIND_FLOAT) {
        var k: type.TypeKind = type.TYPE_F64;
        if (cv.float_width == float.FLOAT_W_32) { k = type.TYPE_F32; }
        val id_opt: O.Option[type.TypeId] = type.prim(?sc.s.types, k);
        if (O.is_none[type.TypeId](id_opt)) { ret type.TYPE_NIL; }
        ret O.unwrap[type.TypeId](id_opt);
    }
    ret type.TYPE_NIL;
}

fun ident_is_comptime_param_fn(sc: *context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED) { ret false; }
    if (sym.decl == id.DECL_NIL)                                         { ret false; }
    val a: *ast.Ast = symbol_ast(sc, sym);
    if (a == nil) { ret false; }
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, sym.decl);
    if (O.is_none[*decl.Decl](d_opt)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_FUN) { ret false; }
    val f: *decl.DeclFun = ?d.data.fun_;
    var i: u32 = 0;
    for (i < f.params_len) {
        if (a.typed_names[f.params_start + i].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun report_never_value(sc: *context.SemaContext, eid: id.ExprId, sym: *resolve.Symbol) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val span: token.Span = O.unwrap[*expr.Expr](e_opt).span;

    if (sym.kind == resolve.SYM_USE) {
        context.report(sc, span, "a module alias is not a value; name one of the module's members");
        ret true;
    }
    if (sym.kind == resolve.SYM_GENERIC) {
        check.report_named(sc, span, "`", sym.name, "` is a generic type parameter, not a value; use it in type position or a comptime intrinsic like `$size_of(T)`", "a generic type parameter is not a value");
        ret true;
    }
    if (sym.kind == resolve.SYM_PRIM) {
        check.report_named(sc, span, "`", sym.name, "` is a primitive type, not a value; write a literal of that type", "a primitive type is not a value");
        ret true;
    }
    if (sym.kind == resolve.SYM_VECTOR) {
        check.report_named(sc, span, "`", sym.name, "` is a vector type, not a value; write a literal of that type", "a vector type is not a value");
        ret true;
    }

    var dk: decl.DeclKind = decl.DECL_KIND_ERROR;
    if (sym.kind == resolve.SYM_REC)      { dk = decl.DECL_KIND_REC; }
    or (sym.kind == resolve.SYM_UNI)      { dk = decl.DECL_KIND_UNI; }
    or (sym.kind == resolve.SYM_DEF)      { dk = decl.DECL_KIND_DEF; }
    or (sym.kind == resolve.SYM_IMPORTED) { dk = symbol_decl_kind(sc, sym); }

    if (dk == decl.DECL_KIND_REC) {
        check.report_named(sc, span, "`", sym.name, "` is a record type, not a value; construct an instance with `Type{ ... }`", "a record type is not a value");
        ret true;
    }
    if (dk == decl.DECL_KIND_UNI) {
        check.report_named(sc, span, "`", sym.name, "` is a union type, not a value; construct an instance with `Type{ ... }`", "a union type is not a value");
        ret true;
    }
    if (dk == decl.DECL_KIND_DEF) {
        if (type.is_handle(?sc.s.types, context.decl_type_for(sc, sym))) {
            check.report_named(sc, span, "`", sym.name, "` is a handle type, not a value; a handle has no literal because the program does not own its representation - declare a binding of it and hand that to an operation", "a handle type is not a value");
            ret true;
        }
        check.report_named(sc, span, "`", sym.name, "` is a type alias, not a value; use a value of the aliased type", "a type alias is not a value");
        ret true;
    }
    ret false;
}

fun symbol_decl_kind(sc: *context.SemaContext, sym: *resolve.Symbol) decl.DeclKind {
    if (sym.decl == id.DECL_NIL) { ret decl.DECL_KIND_ERROR; }
    val a: *ast.Ast = symbol_ast(sc, sym);
    if (a == nil) { ret decl.DECL_KIND_ERROR; }
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, sym.decl);
    if (O.is_none[*decl.Decl](d_opt)) { ret decl.DECL_KIND_ERROR; }
    ret O.unwrap[*decl.Decl](d_opt).kind;
}

fun report_comptime_param_fn_ref(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_some[*expr.Expr](e_opt)) {
        context.report(sc, O.unwrap[*expr.Expr](e_opt).span, "cannot reference a comptime-parameter function as a value");
    }
    ret type.TYPE_ERROR;
}

fun infer_binary(sc: *context.SemaContext, eid: id.ExprId, b: *expr.ExprBinary, span: token.Span) type.TypeId {
    if (b.op == expr.BIN_ASSIGN) { ret infer_assign(sc, b, span); }

    if (comptime.is_type_comparison_binary(sc.a, sc.source, b,
            is_field_type_operand(sc, b.lhs), is_field_type_operand(sc, b.rhs))) {
        ret infer_type_comparison(sc, b, span);
    }

    var lt: type.TypeId = infer_expr(sc, b.lhs);
    var rt: type.TypeId = infer_expr(sc, b.rhs);
    if (lt == type.TYPE_ERROR || rt == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    val lhs_secret:    bool = type.is_secret(?sc.s.types, lt);
    val either_secret: bool = lhs_secret || type.is_secret(?sc.s.types, rt);

    if (type.is_vector(?sc.s.types, lt) || type.is_vector(?sc.s.types, rt)) {
        ret infer_vector_binary(sc, b.op, lt, rt, either_secret, span);
    }

    gate_ct_always(sc, scalar_binop_ct_op(b.op, is_float(sc, lt) || is_float(sc, rt)), either_secret, span);

    val u8t: type.TypeId = prim_or_error(sc, type.TYPE_U8);
    if (b.op == expr.BIN_AND || b.op == expr.BIN_OR) {
        if (!type.is_u8(?sc.s.types, lt) || !type.is_u8(?sc.s.types, rt)) {
            var msg: str = "type mismatch: logical operands must have type u8";
            if (sc.in_comptime_gate) { msg = "logical operator requires u8 operands"; }
            context.report(sc, span, msg);
            ret type.TYPE_ERROR;
        }
        if (lhs_secret) {
            context.report(sc, span, "secret value used as the left operand of a short-circuiting `&&` / `||`; the branch it controls leaks through control flow");
        }
        ret join_secret(sc, u8t, either_secret);
    }

    val co: O.Option[type.TypeId] = unify_literals(sc, b.lhs, lt, b.rhs, rt, span);
    if (O.is_some[type.TypeId](co)) {
        lt = O.unwrap[type.TypeId](co);
        if (lt == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
        rt = lt;
    }

    val both_int:    bool = is_integer(sc, lt) && is_integer(sc, rt);
    val operands_ok: bool = lt == rt || both_int;
    val same_repr:   bool = type.strip_secret(?sc.s.types, lt) == type.strip_secret(?sc.s.types, rt);

    val both_float:    bool = is_float(sc, lt) && is_float(sc, rt);
    val int_float_mix: bool = (is_integer(sc, lt) && is_float(sc, rt))
                           || (is_float(sc, lt) && is_integer(sc, rt));

    if (b.op == expr.BIN_EQ || b.op == expr.BIN_NEQ) {
        if (is_aggregate(sc, lt) || is_aggregate(sc, rt)) {
            report_aggregate_eq(sc, span, lt, rt);
            ret type.TYPE_ERROR;
        }
        if (int_float_mix) { report_int_float_cmp(sc, span); ret type.TYPE_ERROR; }
        val addr_ok: bool = is_pointer_like(sc, lt) && is_pointer_like(sc, rt);
        if (!operands_ok && !both_float && !addr_ok) { type_mismatch(sc, span, lt, rt); ret type.TYPE_ERROR; }
        ret join_secret(sc, u8t, either_secret);
    }
    if (b.op == expr.BIN_LT || b.op == expr.BIN_LEQ || b.op == expr.BIN_GT || b.op == expr.BIN_GEQ) {
        if (int_float_mix)            { report_int_float_cmp(sc, span); ret type.TYPE_ERROR; }
        if (!both_int && !both_float) { type_mismatch(sc, span, lt, rt); ret type.TYPE_ERROR; }
        ret join_secret(sc, u8t, either_secret);
    }
    if (b.op == expr.BIN_SHL || b.op == expr.BIN_SHR) {
        if (!both_int) { type_mismatch(sc, span, lt, rt); ret type.TYPE_ERROR; }
        ret join_secret(sc, lt, either_secret);
    }
    if (b.op == expr.BIN_BIT_AND || b.op == expr.BIN_BIT_OR || b.op == expr.BIN_BIT_XOR) {
        if (!both_int)  { type_mismatch(sc, span, lt, rt); ret type.TYPE_ERROR; }
        if (!same_repr) { report_operand_width(sc, span, lt, rt); ret type.TYPE_ERROR; }
        ret join_secret(sc, lt, either_secret);
    }
    if (!operands_ok || !is_numeric(sc, lt)) { type_mismatch(sc, span, lt, rt); ret type.TYPE_ERROR; }
    if (!same_repr) { report_operand_width(sc, span, lt, rt); ret type.TYPE_ERROR; }
    ret join_secret(sc, lt, either_secret);
}

fun infer_vector_binary(sc: *context.SemaContext, op: expr.BinOp, lt: type.TypeId, rt: type.TypeId, either_secret: bool, span: token.Span) type.TypeId {
    val lbase: type.TypeId = type.strip_secret(?sc.s.types, lt);
    val rbase: type.TypeId = type.strip_secret(?sc.s.types, rt);

    if (!type.is_vector(?sc.s.types, lt) || !type.is_vector(?sc.s.types, rt) || lbase != rbase) {
        type_mismatch(sc, span, lt, rt);
        ret type.TYPE_ERROR;
    }

    val d: type.PrimDesc = type.prim_desc(type.vector_element(?sc.s.types, lbase));
    val float_lane: bool = d.class == type.PRIM_CLASS_FLOAT;
    val int_lane:   bool = d.class == type.PRIM_CLASS_INT;

    if (float_lane) {
        gate_ct_always(sc, ct.CT_OP_FLOAT, either_secret, span);
    }

    if (op == expr.BIN_EQ || op == expr.BIN_NEQ || op == expr.BIN_LT
        || op == expr.BIN_LEQ || op == expr.BIN_GT || op == expr.BIN_GEQ) {
        val mr: R.Result[type.TypeId, str] = type.vector_mask(?sc.s.types, lbase);
        if (R.is_err[type.TypeId, str](mr)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](mr)); ret type.TYPE_ERROR; }
        ret join_secret(sc, R.unwrap_ok[type.TypeId, str](mr), either_secret);
    }

    if (op == expr.BIN_SHL || op == expr.BIN_SHR) {
        check.report_typed(sc, span, "vector shift `<<` / `>>` is not in the increment-1 operator table (`", lbase, "`); a per-lane variable shift is not 1:1 on the SSE2 baseline (AVX2-only, no 8-bit packed form), so shifts are deferred to a later increment", "vector shift is not in the increment-1 operator table");
        ret type.TYPE_ERROR;
    }

    if (op == expr.BIN_BIT_AND || op == expr.BIN_BIT_OR || op == expr.BIN_BIT_XOR) {
        if (!int_lane) {
            context.report(sc, span, "type mismatch: bitwise vector operands must have integer lanes");
            ret type.TYPE_ERROR;
        }
        ret join_secret(sc, lbase, either_secret);
    }

    if (op == expr.BIN_MOD) {
        context.report(sc, span, "vector `%` is not supported");
        ret type.TYPE_ERROR;
    }

    if (op == expr.BIN_DIV) {
        if (!float_lane) {
            context.report(sc, span, "integer vector `/` is not supported");
            ret type.TYPE_ERROR;
        }
        ret join_secret(sc, lbase, either_secret);
    }

    if (op == expr.BIN_MUL) {
        if (float_lane || int_lane) { ret join_secret(sc, lbase, either_secret); }
        type_mismatch(sc, span, lt, rt);
        ret type.TYPE_ERROR;
    }

    if (op == expr.BIN_ADD || op == expr.BIN_SUB) {
        if (float_lane || int_lane) { ret join_secret(sc, lbase, either_secret); }
        type_mismatch(sc, span, lt, rt);
        ret type.TYPE_ERROR;
    }

    context.report(sc, span, "operator not supported on vector operands");
    ret type.TYPE_ERROR;
}

fun scalar_binop_ct_op(op: expr.BinOp, is_float: bool) ct.CtOp {
    if (is_float)                                 { ret ct.CT_OP_FLOAT; }
    if (op == expr.BIN_DIV || op == expr.BIN_MOD) { ret ct.CT_OP_INT_DIVMOD; }
    if (op == expr.BIN_MUL)                       { ret ct.CT_OP_INT_MUL; }
    if (op == expr.BIN_SHL || op == expr.BIN_SHR) { ret ct.CT_OP_VAR_SHIFT; }
    ret ct.CT_OP_NONE;
}

fun gate_ct_always(sc: *context.SemaContext, cop: ct.CtOp, either_secret: bool, span: token.Span) {
    if (!either_secret)                  { ret; }
    if (!ct.cap_at_sema(ct.ct_cap(cop))) { ret; }
    if (cop == ct.CT_OP_FLOAT) {
        context.report(sc, span, "secret value used as an operand of a variable-latency floating-point operation; the FP unit's timing can depend on the secret operand");
        ret;
    }
    context.report(sc, span, "secret value used as an operand of a variable-latency `/` or `%`; a secret divisor or dividend leaks through timing");
}

fun join_secret(sc: *context.SemaContext, base: type.TypeId, secret: bool) type.TypeId {
    val pub: type.TypeId = type.strip_secret(?sc.s.types, base);
    if (!secret) { ret pub; }
    val r: R.Result[type.TypeId, str] = type.intern_secret(?sc.s.types, pub);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun infer_type_comparison(sc: *context.SemaContext, b: *expr.ExprBinary, span: token.Span) type.TypeId {
    if (!sc.in_comptime_gate) {
        context.report(sc, span, "a `$type_of` type comparison is comptime-only; it is valid only as a `$if` gate condition");
        ret type.TYPE_ERROR;
    }
    val lt: type.TypeId = infer_type_operand(sc, b.lhs, span);
    val rt: type.TypeId = infer_type_operand(sc, b.rhs, span);
    if (lt == type.TYPE_ERROR || rt == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
    ret prim_or_error(sc, type.TYPE_U8);
}

fun infer_type_operand(sc: *context.SemaContext, operand: id.ExprId, span: token.Span) type.TypeId {
    if (comptime.is_type_of_call(sc.a, sc.source, operand)) {
        val arg: id.ExprId = comptime.type_of_arg(sc.a, operand);
        if (arg == id.EXPR_NIL) {
            context.report(sc, span, "$type_of: expected one argument");
            ret type.TYPE_ERROR;
        }
        ret infer_expr(sc, arg);
    }
    if (is_field_type_operand(sc, operand)) {
        ret field_type_operand_type(sc, operand);
    }
    val op_ty: type.TypeId = type_name_expr_type(sc, operand, span);
    set_expr_type(sc, operand, op_ty);
    ret op_ty;
}

fun type_name_expr_type(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) type.TypeId {
    val sym_opt: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](sym_opt)) {
        ret type.TYPE_ERROR;
    }
    ret type_for_symbol(sc, O.unwrap[*resolve.Symbol](sym_opt), span);
}

pub fun is_field_type_operand(sc: *context.SemaContext, eid: id.ExprId) bool {
    if (!comptime.is_field_type_member(sc.a, sc.source, eid)) { ret false; }
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret false; }
    val obj: id.ExprId = O.unwrap[*expr.Expr](n_opt).data.member.object;
    val r: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, obj, ?sc.s.interner);
    context.record_eval_result(sc, r);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](r)) { ret false; }
    ret R.unwrap_ok[comptime.CTValue, comptime.EvalFail](r).kind == comptime.CT_KIND_FIELD;
}

fun field_type_operand_type(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret type.TYPE_ERROR; }
    val obj: id.ExprId = O.unwrap[*expr.Expr](n_opt).data.member.object;
    val r: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, obj, ?sc.s.interner);
    context.record_eval_result(sc, r);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](r)) { ret type.TYPE_ERROR; }
    val fv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](r);
    if (fv.kind != comptime.CT_KIND_FIELD) { ret type.TYPE_ERROR; }
    val fa: O.Option[*type.FieldEntry] = type.field_at(?sc.s.types, fv.data.fld.owner::type.TypeId, fv.data.fld.index);
    if (O.is_none[*type.FieldEntry](fa)) { ret type.TYPE_ERROR; }
    ret O.unwrap[*type.FieldEntry](fa).ty;
}

fun infer_assign(sc: *context.SemaContext, b: *expr.ExprBinary, span: token.Span) type.TypeId {
    val lt: type.TypeId = infer_expr(sc, b.lhs);
    val rt: type.TypeId = infer_expr(sc, b.rhs);
    if (lt == type.TYPE_ERROR || rt == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    if (!is_assignable_place(sc, b.lhs, lt)) {
        context.report(sc, span, "left side of `=` is not a place: expected a variable, field, index, or dereference expression");
        ret lt;
    }

    check_assign_mutable(sc, b.lhs, span);
    check_readonly_storage(sc, b.lhs, span);
    check.check_coercible(sc, lt, b.rhs, rt, span);
    ret lt;
}

fun is_assignable_place(sc: *context.SemaContext, eid: id.ExprId, ty: type.TypeId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    val place_kind: expr.ExprKind = ast.expr_place_kind(e);
    if (place_kind == expr.EXPR_KIND_CALL) { ret is_aggregate(sc, ty); }
    if (place_kind == expr.EXPR_KIND_IDENT || place_kind == expr.EXPR_KIND_MEMBER) {
        val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
        if (O.is_some[*resolve.Symbol](so)) {
            val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);
            if (sym.kind == resolve.SYM_VAR || sym.kind == resolve.SYM_PARAM) { ret true; }
            if (symbol_is_val_binding(sc, sym)) { ret true; }
            if (sym.kind == resolve.SYM_IMPORTED && symbol_decl_kind(sc, sym) == decl.DECL_KIND_VAR) { ret true; }
            ret false;
        }
    }
    if (place_kind == expr.EXPR_KIND_MEMBER)  { ret is_assignable_place_base(sc, e.data.member.object); }
    if (place_kind == expr.EXPR_KIND_PROJECT) { ret is_assignable_place_base(sc, e.data.project.object); }
    if (place_kind == expr.EXPR_KIND_INDEX)   { ret is_assignable_place_base(sc, e.data.index.object); }
    ret place_kind != expr.EXPR_KIND_ERROR;
}

fun is_assignable_place_base(sc: *context.SemaContext, eid: id.ExprId) bool {
    val ty: type.TypeId = target_expr_type(sc, eid);
    if (is_pointer_like(sc, type.strip_secret(?sc.s.types, ty))) { ret true; }
    ret is_assignable_place(sc, eid, ty);
}

fun check_assign_mutable(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) {
    val so: O.Option[*resolve.Symbol] = immutable_binding_for_target(sc, eid);
    if (O.is_none[*resolve.Symbol](so)) { ret; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);

    val direct: bool = symbol_at_expr_is(sc, eid, sym);
    var prefix: str = "cannot assign into `";
    if (direct) { prefix = "cannot assign to `"; }

    report_immutable_assign(sc, span, prefix, sym.name);
}

fun immutable_binding_for_target(sc: *context.SemaContext, eid: id.ExprId) O.Option[*resolve.Symbol] {
    if (eid == id.EXPR_NIL) { ret O.none[*resolve.Symbol](); }

    val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_some[*resolve.Symbol](so)) {
        val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);
        if (symbol_is_val_binding(sc, sym))                              { ret O.some[*resolve.Symbol](sym); }
        if (sym.kind == resolve.SYM_VAR || sym.kind == resolve.SYM_PARAM) { ret O.none[*resolve.Symbol](); }
    }

    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret O.none[*resolve.Symbol](); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    if (e.kind == expr.EXPR_KIND_MEMBER) { ret binding_through_object(sc, e.data.member.object); }
    if (e.kind == expr.EXPR_KIND_INDEX)  { ret binding_through_object(sc, e.data.index.object); }

    ret O.none[*resolve.Symbol]();
}

fun binding_through_object(sc: *context.SemaContext, obj: id.ExprId) O.Option[*resolve.Symbol] {
    if (is_pointer_like(sc, type.strip_secret(?sc.s.types, target_expr_type(sc, obj)))) {
        ret O.none[*resolve.Symbol]();
    }
    ret immutable_binding_for_target(sc, obj);
}

fun symbol_is_val_binding(sc: *context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind == resolve.SYM_VAL)      { ret true; }
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    if (sym.decl == id.DECL_NIL)          { ret false; }

    val a: *ast.Ast = symbol_ast(sc, sym);
    if (a == nil) { ret false; }
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, sym.decl);
    if (O.is_none[*decl.Decl](d_opt)) { ret false; }
    ret O.unwrap[*decl.Decl](d_opt).kind == decl.DECL_KIND_VAL;
}

fun symbol_at_expr_is(sc: *context.SemaContext, eid: id.ExprId, sym: *resolve.Symbol) bool {
    val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](so)) { ret false; }
    ret O.unwrap[*resolve.Symbol](so) == sym;
}

fun target_expr_type(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (sc.expr_type == nil)                             { ret type.TYPE_ERROR; }
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret type.TYPE_ERROR; }
    ret sc.expr_type[eid];
}

fun report_immutable_assign(sc: *context.SemaContext, span: token.Span, prefix: str, name: intern.StrId) {
    val note: str = "a `val` binds its value once, at its declaration; declare it `var` if it must be assigned. a module-level `val` is emitted in read-only storage, so the store would fault at runtime";
    val res: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}`: a `val` is immutable", prefix, typename.name_str(sc.s, name));
    if (R.is_err[str, str](res)) { fail.internal(?sc.status, R.unwrap_err[str, str](res));
        context.report_note(sc, span, "cannot assign to a `val`: a `val` is immutable", note);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res);
    context.report_note(sc, span, msg, note);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

fun check_readonly_storage(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) {
    if (eid == id.EXPR_NIL) { ret; }
    if (expr_names_readonly_storage(sc, eid)) {
        context.report(sc, span, "cannot store through a `#[storage(set, binding, \"readonly\")]` binding: the qualifier declares that no stage writes it, which is what lets the emitter mark it `NonWritable` and a vertex stage read it without `vertexPipelineStoresAndAtomics`. drop the `\"readonly\"` qualifier to write it");
        ret;
    }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (e.kind == expr.EXPR_KIND_MEMBER) { check_readonly_storage(sc, e.data.member.object, span); ret; }
    if (e.kind == expr.EXPR_KIND_INDEX)  { check_readonly_storage(sc, e.data.index.object, span); ret; }
    if (e.kind == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_DEREF) {
        check_readonly_storage(sc, e.data.unary.operand, span);
    }
}

fun expr_names_readonly_storage(sc: *context.SemaContext, eid: id.ExprId) bool {
    val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](so)) { ret false; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);
    if (sym.kind != resolve.SYM_VAR && sym.kind != resolve.SYM_VAL
        && sym.kind != resolve.SYM_IMPORTED) { ret false; }
    if (sym.decl == id.DECL_NIL) { ret false; }

    val a: *ast.Ast = symbol_ast(sc, sym);
    if (a == nil) { ret false; }
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, sym.decl);
    if (O.is_none[*decl.Decl](d_opt)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) { ret false; }

    val src: str = ast_source(sc, a);
    if (src == nil) { ret false; }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?a.decorators[d.decorators_start + i];
        if (!str_region_equals(src, dec.name.offset, dec.name.len, "storage")) { i = i + 1; cnt; }
        var q: u32 = 2;
        for (q < dec.args_len) {
            val q_opt: O.Option[*expr.Expr] = ast.get_expr(a, a.expr_ids[dec.args_start + q]);
            if (O.is_some[*expr.Expr](q_opt)) {
                val qa: *expr.Expr = O.unwrap[*expr.Expr](q_opt);
                if (qa.kind == expr.EXPR_KIND_LIT_STR && qa.span.len >= 2::usize
                    && str_region_equals(src, qa.span.offset + 1::usize, qa.span.len - 2::usize, "readonly")) {
                    ret true;
                }
            }
            q = q + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun ast_source(sc: *context.SemaContext, a: *ast.Ast) str {
    if (a == sc.a) { ret sc.source; }
    val opt_file: O.Option[*source.SourceFile] = source.get(?sc.s.sources, a.file_id);
    if (O.is_none[*source.SourceFile](opt_file)) { ret nil; }
    ret O.unwrap[*source.SourceFile](opt_file).text;
}

fun lit_int_type(sc: *context.SemaContext, e: *expr.Expr) type.TypeId {
    if (e.data.lit_int.suffix == expr.LIT_SUFFIX_NONE) { ret prim_or_error(sc, type.TYPE_I64); }
    ret prim_or_error(sc, e.data.lit_int.suffix);
}

fun check_lit_int_range(sc: *context.SemaContext, e: *expr.Expr, t: type.TypeId, negated: bool, span: token.Span) {
    if (e.data.lit_int.suffix == expr.LIT_SUFFIX_NONE) { ret; }
    val opt_bounds: O.Option[type.IntRange] = coerce.int_bounds_of(sc, t);
    if (O.is_none[type.IntRange](opt_bounds)) { ret; }
    val bounds: type.IntRange = O.unwrap[type.IntRange](opt_bounds);
    if (type.int_fits(e.data.lit_int.value, negated, bounds)) { ret; }
    check.report_out_of_range(sc, span, coerce.out_of_range(t, e.data.lit_int.value, negated, bounds, true));
}

fun infer_negated_int_literal(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) O.Option[type.TypeId] {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret O.none[type.TypeId](); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (e.kind != expr.EXPR_KIND_LIT_INT)              { ret O.none[type.TypeId](); }
    if (e.data.lit_int.suffix == expr.LIT_SUFFIX_NONE) { ret O.none[type.TypeId](); }

    val t: type.TypeId = lit_int_type(sc, e);
    check_lit_int_range(sc, e, t, true, span);
    if (sc.expr_type != nil && eid < sc.a.expr_len::u32) { sc.expr_type[eid] = t; }
    ret O.some[type.TypeId](t);
}

fun infer_unary(sc: *context.SemaContext, u: *expr.ExprUnary, span: token.Span) type.TypeId {
    if (u.op == expr.UN_NEG) {
        val neg: O.Option[type.TypeId] = infer_negated_int_literal(sc, u.operand, span);
        if (O.is_some[type.TypeId](neg)) { ret O.unwrap[type.TypeId](neg); }
    }
    val ot: type.TypeId = infer_expr(sc, u.operand);
    if (ot == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    val ot_secret: bool = type.is_secret(?sc.s.types, ot);

    if (u.op == expr.UN_NEG) {
        if (!is_numeric(sc, ot)) { context.report(sc, span, "type mismatch: unary - requires a numeric operand"); ret type.TYPE_ERROR; }
        ret join_secret(sc, ot, ot_secret);
    }
    if (u.op == expr.UN_NOT) {
        if (!type.is_u8(?sc.s.types, ot)) { context.report(sc, span, "type mismatch: unary ! requires a u8 operand"); ret type.TYPE_ERROR; }
        ret join_secret(sc, prim_or_error(sc, type.TYPE_U8), ot_secret);
    }
    if (u.op == expr.UN_BIT_NOT) {
        if (type.is_vector(?sc.s.types, ot)) {
            val base: type.TypeId = type.strip_secret(?sc.s.types, ot);
            if (type.prim_desc(type.vector_element(?sc.s.types, base)).class != type.PRIM_CLASS_INT) {
                context.report(sc, span, "type mismatch: unary ~ requires integer lanes");
                ret type.TYPE_ERROR;
            }
            ret join_secret(sc, base, ot_secret);
        }
        if (!is_integer(sc, ot)) { context.report(sc, span, "type mismatch: unary ~ requires an integer operand"); ret type.TYPE_ERROR; }
        ret join_secret(sc, ot, ot_secret);
    }
    if (u.op == expr.UN_ADDR) {
        val rvalue: str = address_operand_rvalue(sc, u.operand);
        if (rvalue != nil) {
            report_address_of_rvalue(sc, span, rvalue);
            ret type.TYPE_ERROR;
        }
        if (operand_is_comptime_param(sc, u.operand)) {
            context.report(sc, span, "cannot take the address of a comptime parameter");
            ret type.TYPE_ERROR;
        }
        if (operand_is_uninstantiated_generic(sc, u.operand)) {
            context.report(sc, span, "cannot take the address of an uninstantiated generic function: a generic is a template, not code, so it has no address until its type arguments are supplied. name the instance (`?f[i64]`), call it with them (`f[i64](x)`), or take the address of a non-generic function");
            ret type.TYPE_ERROR;
        }
        if (operand_is_packed_field(sc, u.operand)) {
            context.report(sc, span, "cannot take the address of a field of a `#[packed]` record: the field sits at an offset its own type does not guarantee, so the resulting pointer would claim an alignment the storage does not have. copy the field into a local and take that address, or take the address of the whole record (`?r`), whose pointer type is honest about being align 1");
            ret type.TYPE_ERROR;
        }
        ret ptr_to(sc, ot);
    }
    if (u.op == expr.UN_DEREF) {
        check.check_secret_address(sc, ot, span);
        ret pointee_of(sc, ot, span);
    }
    ret type.TYPE_ERROR;
}

fun report_address_of_rvalue(sc: *context.SemaContext, span: token.Span, rvalue: str) {
    var op_span: token.Span;
    op_span.offset = span.offset;
    op_span.len    = 1;
    val res: R.Result[str, str] = format.sprint(sc.s.alloc,
        "cannot take the address of {}: `?` applies to a place (a binding, a field, an element, or a dereference)", rvalue);
    if (R.is_err[str, str](res)) { fail.internal(?sc.status, R.unwrap_err[str, str](res));
        context.report(sc, op_span, "cannot take the address of a temporary: `?` applies to a place (a binding, a field, an element, or a dereference)");
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res);
    context.report(sc, op_span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

# nil when the operand is a place; otherwise what kind of rvalue it is
fun address_operand_rvalue(sc: *context.SemaContext, eid: id.ExprId) str {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret nil; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    val k: expr.ExprKind = ast.expr_place_kind(e);
    if (k == expr.EXPR_KIND_IDENT || k == expr.EXPR_KIND_UNARY) { ret nil; }
    if (e.kind == expr.EXPR_KIND_GENERIC_INSTANCE) { ret nil; }
    if (k == expr.EXPR_KIND_MEMBER)  { ret address_base_rvalue(sc, e.data.member.object, "a field of "); }
    if (k == expr.EXPR_KIND_PROJECT) { ret address_base_rvalue(sc, e.data.project.object, "a projection of "); }
    if (k == expr.EXPR_KIND_INDEX)   { ret address_base_rvalue(sc, e.data.index.object, "an element of "); }
    if (k == expr.EXPR_KIND_CALL)    { ret "a call result"; }
    val ek: expr.ExprKind = e.kind;
    if (ek == expr.EXPR_KIND_LIT_INT || ek == expr.EXPR_KIND_LIT_FLOAT || ek == expr.EXPR_KIND_LIT_CHAR
        || ek == expr.EXPR_KIND_LIT_STR || ek == expr.EXPR_KIND_LIT_NIL) { ret "a literal"; }
    if (ek == expr.EXPR_KIND_BINARY || ek == expr.EXPR_KIND_UNARY) { ret "an operator result"; }
    if (ek == expr.EXPR_KIND_CAST)           { ret "a cast result"; }
    if (ek == expr.EXPR_KIND_ARRAY_LIT)      { ret "an array literal"; }
    if (ek == expr.EXPR_KIND_STRUCT_LIT)     { ret "a record literal"; }
    if (ek == expr.EXPR_KIND_VECTOR_LIT)     { ret "a vector literal"; }
    if (ek == expr.EXPR_KIND_SPREAD)         { ret "a spread"; }
    if (ek == expr.EXPR_KIND_STRIP)          { ret "a declassified value"; }
    if (ek == expr.EXPR_KIND_TYPE_REF)       { ret "a type"; }
    if (ek == expr.EXPR_KIND_COMPTIME_IDENT) { ret "a comptime value"; }
    ret "a temporary";
}

# a field, element, or projection is a place when its base is one or is reached through a pointer
fun address_base_rvalue(sc: *context.SemaContext, base: id.ExprId, prefix: str) str {
    val ty: type.TypeId = target_expr_type(sc, base);
    if (is_pointer_like(sc, type.strip_secret(?sc.s.types, ty))) { ret nil; }
    val inner: str = address_operand_rvalue(sc, base);
    if (inner == nil) { ret nil; }
    if (str_equals(prefix, "a field of "))      { ret address_base_label(inner, "a field of a call result", "a field of a temporary"); }
    if (str_equals(prefix, "an element of "))   { ret address_base_label(inner, "an element of a call result", "an element of a temporary"); }
    ret address_base_label(inner, "a projection of a call result", "a projection of a temporary");
}

fun address_base_label(inner: str, call_label: str, other_label: str) str {
    if (str_equals(inner, "a call result")) { ret call_label; }
    ret other_label;
}

fun operand_is_comptime_param(sc: *context.SemaContext, eid: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt))                             { ret false; }
    if (O.unwrap[*expr.Expr](e_opt).kind != expr.EXPR_KIND_IDENT) { ret false; }
    val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](so)) { ret false; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun operand_is_uninstantiated_generic(sc: *context.SemaContext, eid: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val k: expr.ExprKind = O.unwrap[*expr.Expr](e_opt).kind;
    if (k != expr.EXPR_KIND_IDENT && k != expr.EXPR_KIND_MEMBER) { ret false; }

    val cf: O.Option[*decl.DeclFun] = callee_fun_decl(sc, eid);
    if (O.is_none[*decl.DeclFun](cf)) { ret false; }
    ret O.unwrap[*decl.DeclFun](cf).generics_len > 0;
}

fun operand_is_packed_field(sc: *context.SemaContext, eid: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    if (e.kind == expr.EXPR_KIND_MEMBER) {
        if (expr_type_is_packed(sc, e.data.member.object)) { ret true; }
        ret operand_is_packed_field(sc, e.data.member.object);
    }
    if (e.kind == expr.EXPR_KIND_INDEX) {
        ret operand_is_packed_field(sc, e.data.index.object);
    }
    ret false;
}

fun expr_type_is_packed(sc: *context.SemaContext, eid: id.ExprId) bool {
    if (sc.expr_type == nil) { ret false; }
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret false; }

    ret type_is_packed_nominal(sc, sc.expr_type[eid]);
}

fun type_is_packed_nominal(sc: *context.SemaContext, t: type.TypeId) bool {
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }
    val base: type.TypeId = type.strip_secret(?sc.s.types, t);
    val bt: O.Option[*type.Type] = type.get(?sc.s.types, base);
    if (O.is_none[*type.Type](bt)) { ret false; }
    val ty: *type.Type = O.unwrap[*type.Type](bt);
    if (ty.kind == type.TYPE_POINTER) { ret type_is_packed_nominal(sc, ty.data.pointer.base); }

    val nom: type.TypeId = type.aggregate_nominal(?sc.s.types, base);
    if (nom == type.TYPE_ERROR) { ret false; }
    ret session.type_is_packed(sc.s, nom::u32);
}

fun infer_call(sc: *context.SemaContext, c: *expr.ExprCall, span: token.Span) type.TypeId {
    val intr: type.TypeId = infer_comptime_intrinsic(sc, c, span);
    if (intr != type.TYPE_NIL) { ret intr; }

    val saved_callee: id.ExprId = sc.callee_eid;
    sc.callee_eid = c.callee;
    val ct: type.TypeId = infer_expr(sc, c.callee);
    sc.callee_eid = saved_callee;

    var i: u32 = 0;
    for (i < c.args_len) {
        infer_expr(sc, sc.a.expr_ids[c.args_start + i]);
        i = i + 1;
    }

    val cf_opt: O.Option[*decl.DeclFun] = callee_fun_decl(sc, c.callee);

    if (O.is_some[*decl.DeclFun](cf_opt)) {
        val cf: *decl.DeclFun = O.unwrap[*decl.DeclFun](cf_opt);
        if (cf.generics_len > 0 && decl_has_comptime_param(sc, c.callee, cf)) {
            context.report(sc, span, "comptime value parameters on a generic function are not yet supported");
            ret type.TYPE_ERROR;
        }
    }

    if (c.type_args_len > 0) {
        ret infer_generic_call(sc, c, ct, span);
    }

    if (ct == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    val fn_opt: O.Option[*type.Type] = type.get(?sc.s.types, ct);
    if (O.is_none[*type.Type](fn_opt)) { ret type.TYPE_ERROR; }
    val fn: *type.Type = O.unwrap[*type.Type](fn_opt);
    if (fn.kind != type.TYPE_FUN) {
        check.report_typed(sc, span, "not callable: `", ct, "` is not a function", "not callable: target is not a function");
        ret type.TYPE_ERROR;
    }

    val ret_type: type.TypeId = fn.data.fn.ret_type;

    if (O.is_some[*decl.DeclFun](cf_opt)) {
        val cf: *decl.DeclFun = O.unwrap[*decl.DeclFun](cf_opt);
        if (decl_has_comptime_param(sc, c.callee, cf)) {
            check.check_comptime_call(sc, ct, c.callee, cf, c.args_start, c.args_len, span);
            ret ret_type;
        }
    }

    check.check_call(sc, ct, c.args_start, c.args_len, span, callee_packs_to_c_tail(sc, c.callee));
    ret ret_type;
}

fun callee_packs_to_c_tail(sc: *context.SemaContext, callee: id.ExprId) bool {
    val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, callee);
    if (O.is_none[*resolve.Symbol](so)) { ret false; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);
    if (sym.decl == id.DECL_NIL) { ret false; }
    ret context.decl_body_spreads_pack_to_c_variadic(sc, sym.origin, sym.decl);
}

fun callee_fun_decl(sc: *context.SemaContext, callee: id.ExprId) O.Option[*decl.DeclFun] {
    val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, callee);
    if (O.is_none[*resolve.Symbol](so)) { ret O.none[*decl.DeclFun](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED) { ret O.none[*decl.DeclFun](); }
    if (sym.decl == id.DECL_NIL)                                         { ret O.none[*decl.DeclFun](); }

    val a: *ast.Ast = symbol_ast(sc, sym);
    if (a == nil) { ret O.none[*decl.DeclFun](); }
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, sym.decl);
    if (O.is_none[*decl.Decl](d_opt)) { ret O.none[*decl.DeclFun](); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_FUN) { ret O.none[*decl.DeclFun](); }
    ret O.some[*decl.DeclFun](?d.data.fun_);
}

fun decl_has_comptime_param(sc: *context.SemaContext, callee: id.ExprId, f: *decl.DeclFun) bool {
    val so: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, callee);
    if (O.is_none[*resolve.Symbol](so)) { ret false; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](so);

    val a: *ast.Ast = symbol_ast(sc, sym);
    if (a == nil) { ret false; }
    var i: u32 = 0;
    for (i < f.params_len) {
        if (a.typed_names[f.params_start + i].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun infer_comptime_intrinsic(sc: *context.SemaContext, c: *expr.ExprCall, span: token.Span) type.TypeId {
    val ce_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, c.callee);
    if (O.is_none[*expr.Expr](ce_opt)) { ret type.TYPE_NIL; }
    val ce: *expr.Expr = O.unwrap[*expr.Expr](ce_opt);
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret type.TYPE_NIL; }

    val name: intern.StrId = comptime_ident_name(sc, ce.span);
    if (name == intern.STR_NIL) { ret type.TYPE_NIL; }

    if (name == interned(sc, "type_of")) {
        context.report(sc, span, "`$type_of` yields a comptime type, not a value; use it as a type-comparison operand inside a `$if` gate");
        ret type.TYPE_ERROR;
    }

    if (name == interned(sc, "pointee_of")) {
        context.report(sc, span, "`$pointee_of` names a type, not a value; write it where a type is expected");
        ret type.TYPE_ERROR;
    }

    val is_rec_q:  bool = name == interned(sc, "is_record");
    val is_uni_q:  bool = name == interned(sc, "is_union");
    val is_ptr_q:  bool = name == interned(sc, "is_pointer");
    val is_sec_q:  bool = name == interned(sc, "is_secret");
    val is_name_q: bool = name == interned(sc, "type_name");
    if (is_rec_q || is_uni_q || is_ptr_q || is_sec_q || is_name_q) {
        if (c.args_len != 1) {
            context.report_numbered(sc, span, "a comptime type query: expected ", 1::usize, " argument(s)", "comptime type query: wrong number of arguments");
            ret type.TYPE_ERROR;
        }
        val qarg: id.ExprId   = sc.a.expr_ids[c.args_start];
        val qty:  type.TypeId = intrinsic_operand_type(sc, qarg, span);
        set_expr_type(sc, qarg, qty);
        if (qty == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

        if (is_name_q) { ret ptr_to(sc, prim_or_error(sc, type.TYPE_U8)); }

        if (!sc.in_comptime_gate) {
            context.report(sc, span, "a comptime type predicate is comptime-only; it is valid only as a `$if` gate condition");
            ret type.TYPE_ERROR;
        }
        ret prim_or_error(sc, type.TYPE_U8);
    }

    val is_size:   bool = name == interned(sc, "size_of");
    val is_align:  bool = name == interned(sc, "align_of");
    val is_offset: bool = name == interned(sc, "offset_of");
    val is_len:    bool = name == interned(sc, "length_of");
    if (!is_size && !is_align && !is_offset && !is_len) { ret type.TYPE_NIL; }

    var need: u32 = 1;
    if (is_offset) { need = 2; }
    if (c.args_len != need) {
        var iname: str = "$size_of: expected ";
        if (is_align)  { iname = "$align_of: expected "; }
        if (is_offset) { iname = "$offset_of: expected "; }
        if (is_len)    { iname = "$length_of: expected "; }
        context.report_numbered(sc, span, iname, need::usize, " argument(s)", "comptime intrinsic: wrong number of arguments");
        ret type.TYPE_ERROR;
    }

    val arg0: id.ExprId = sc.a.expr_ids[c.args_start];
    val op_ty: type.TypeId = intrinsic_operand_type(sc, arg0, span);
    set_expr_type(sc, arg0, op_ty);
    if (op_ty == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    if (is_len && O.is_none[u32](type.element_count(?sc.s.types, op_ty))) {
        check.report_typed(sc, span, "`$length_of` has no answer for `", op_ty,
            "`: only a fixed array and a vector carry a statically known element count",
            "`$length_of` expects a fixed array or a vector");
        ret type.TYPE_ERROR;
    }
    ret prim_or_error(sc, type.TYPE_U64);
}

fun intrinsic_operand_type(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) type.TypeId {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);

    if (O.is_some[*expr.Expr](e_opt) && comptime.is_field_type_member(sc.a, sc.source, eid)) {
        val fv: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
        context.record_eval_result(sc, fv);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](fv)) {
            context.report(sc, span, R.unwrap_err[comptime.CTValue, comptime.EvalFail](fv).message);
            ret type.TYPE_ERROR;
        }
        val v: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](fv);
        if (v.kind != comptime.CT_KIND_TYPE) {
            context.report(sc, span, "a comptime intrinsic's type argument did not resolve to a type");
            ret type.TYPE_ERROR;
        }
        ret v.data.t::type.TypeId;
    }

    if (O.is_none[*expr.Expr](e_opt) || O.unwrap[*expr.Expr](e_opt).kind != expr.EXPR_KIND_TYPE_REF) {
        context.report_internal(sc, span, "internal: a comptime intrinsic argument was not parsed as a type");
        ret type.TYPE_ERROR;
    }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    val mark: u64 = context.diag_mark(sc);
    val ty:   type.TypeId = resolve_type_ref(sc, e.data.type_ref.ty);
    if (ty == type.TYPE_ERROR && !resolve_reported(sc, e.data.type_ref.ty, mark)) {
        context.report_internal(sc, e.span, "internal: could not intern the type named by this comptime intrinsic argument");
    }
    ret ty;
}

fun set_expr_type(sc: *context.SemaContext, eid: id.ExprId, ty: type.TypeId) {
    if (sc.expr_type == nil)       { ret; }
    if (eid >= sc.a.expr_len::u32) { ret; }
    sc.expr_type[eid] = ty;
}

pub fun field_seq_owner(sc: *context.SemaContext, seq_eid: id.ExprId, span: token.Span) type.TypeId {
    val targ: id.ExprId = comptime.fields_type_arg(sc.a, seq_eid);
    if (targ == id.EXPR_NIL) {
        context.report(sc, span, "$fields: expected one type argument `$fields(T)`");
        ret type.TYPE_ERROR;
    }
    val owner: type.TypeId = intrinsic_operand_type(sc, targ, span);
    set_expr_type(sc, targ, owner);
    if (owner == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
    if (type_is_generic_param(sc, owner)) { ret owner; }
    context.record_result(sc, generics.ensure_fields(sc.s, owner));
    if (!type_is_record(sc, owner)) {
        context.report(sc, span, "$fields requires a record type");
        ret type.TYPE_ERROR;
    }
    if (O.is_none[*context.FieldTable](context.field_table_for(sc, owner))) {
        context.report_internal(sc, span, "internal: could not materialize the field table for this `$fields` type argument");
        ret type.TYPE_ERROR;
    }
    ret owner;
}

fun infer_field_member(sc: *context.SemaContext, m: *expr.ExprMember, span: token.Span) type.TypeId {
    val obj_r: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, m.object, ?sc.s.interner);
    context.record_eval_result(sc, obj_r);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](obj_r))                                   { ret type.TYPE_NIL; }
    if (R.unwrap_ok[comptime.CTValue, comptime.EvalFail](obj_r).kind != comptime.CT_KIND_FIELD) { ret type.TYPE_NIL; }

    if (str_region_equals(sc.source, m.name.offset, m.name.len, "name")) {
        ret ptr_to(sc, prim_or_error(sc, type.TYPE_U8));
    }
    if (str_region_equals(sc.source, m.name.offset, m.name.len, "offset")) {
        ret prim_or_error(sc, type.TYPE_U64);
    }
    if (str_region_equals(sc.source, m.name.offset, m.name.len, "type")) {
        context.report(sc, span, "`f.type` is a comptime type, not a value; use it as a type-comparison operand inside a `$if` gate");
        ret type.TYPE_ERROR;
    }
    context.report(sc, span, "a field descriptor has only `.name`, `.type`, and `.offset`");
    ret type.TYPE_ERROR;
}

fun project_receiver_matches(sc: *context.SemaContext, obj_ty: type.TypeId, owner: type.TypeId) bool {
    if (obj_ty == owner) { ret true; }
    val to: O.Option[*type.Type] = type.get(?sc.s.types, obj_ty);
    if (O.is_none[*type.Type](to)) { ret false; }
    val t: *type.Type = O.unwrap[*type.Type](to);
    if (t.kind == type.TYPE_GENERIC_PARAM) { ret true; }
    if (t.kind != type.TYPE_POINTER)       { ret false; }
    val base: type.TypeId = t.data.pointer.base;
    if (base == owner) { ret true; }
    val bo: O.Option[*type.Type] = type.get(?sc.s.types, base);
    if (O.is_none[*type.Type](bo)) { ret false; }
    ret O.unwrap[*type.Type](bo).kind == type.TYPE_GENERIC_PARAM;
}

fun type_is_pack(sc: *context.SemaContext, ty: type.TypeId) bool {
    val to: O.Option[*type.Type] = type.get(?sc.s.types, ty);
    if (O.is_none[*type.Type](to)) { ret false; }
    ret O.unwrap[*type.Type](to).kind == type.TYPE_PACK;
}

pub fun type_is_generic_param(sc: *context.SemaContext, ty: type.TypeId) bool {
    val to: O.Option[*type.Type] = type.get(?sc.s.types, ty);
    if (O.is_none[*type.Type](to)) { ret false; }
    ret O.unwrap[*type.Type](to).kind == type.TYPE_GENERIC_PARAM;
}

fun infer_spread(sc: *context.SemaContext, sp: *expr.ExprSpread, span: token.Span) type.TypeId {
    val it: type.TypeId = infer_expr(sc, sp.inner);
    if (it == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
    if (!type_is_pack(sc, it)) {
        context.report(sc, span, "`...` may only spread a variadic pack");
        ret type.TYPE_ERROR;
    }
    ret it;
}

fun type_is_record(sc: *context.SemaContext, ty: type.TypeId) bool {
    ret type.is_record(?sc.s.types, ty);
}

fun infer_project(sc: *context.SemaContext, p: *expr.ExprProject, span: token.Span) type.TypeId {
    val obj_ty: type.TypeId = infer_expr(sc, p.object);
    val fr: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, p.field, ?sc.s.interner);
    context.record_eval_result(sc, fr);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](fr)) {
        context.report(sc, span, "`v.[f]` requires a comptime field descriptor bound by an enclosing `$each`");
        ret type.TYPE_ERROR;
    }
    val fv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](fr);
    if (fv.kind != comptime.CT_KIND_FIELD) {
        context.report(sc, span, "`v.[f]` requires a comptime field descriptor bound by an enclosing `$each`");
        ret type.TYPE_ERROR;
    }
    if (obj_ty == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
    val owner: type.TypeId = fv.data.fld.owner::type.TypeId;
    if (!project_receiver_matches(sc, obj_ty, owner)) {
        context.report(sc, span, "`v.[f]`: the instance type does not match the field descriptor's owning record");
        ret type.TYPE_ERROR;
    }
    val fa: O.Option[*type.FieldEntry] = type.field_at(?sc.s.types, owner, fv.data.fld.index);
    if (O.is_none[*type.FieldEntry](fa)) {
        context.report(sc, span, "`v.[f]`: field ordinal out of range");
        ret type.TYPE_ERROR;
    }
    ret O.unwrap[*type.FieldEntry](fa).ty;
}

fun comptime_ident_name(sc: *context.SemaContext, full: token.Span) intern.StrId {
    val s: token.Span = comptime.comptime_ident_name(full);
    if (s.len == 0) { ret intern.STR_NIL; }
    ret intern_span_or_nil(sc, s);
}

fun interned(sc: *context.SemaContext, text: str) intern.StrId {
    val r: R.Result[intern.StrId, str] = intern.intern(?sc.s.interner, text);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?sc.status, R.unwrap_err[intern.StrId, str](r)); ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun compute_generic_signature(sc: *context.SemaContext, c: *expr.ExprCall, ct: type.TypeId, span: token.Span,
                              out_sym: **resolve.Symbol, out_args: **type.TypeId) type.TypeId {
    val sym_opt: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, c.callee);
    if (O.is_none[*resolve.Symbol](sym_opt)) { ret type.TYPE_ERROR; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](sym_opt);

    val pr: R.Result[*type.TypeId, str] = allocate_params(sc, c.type_args_len);
    if (R.is_err[*type.TypeId, str](pr)) { fail.internal(?sc.status, R.unwrap_err[*type.TypeId, str](pr));
        context.report_internal(sc, span, "internal: out of memory allocating generic type arguments");
        ret type.TYPE_ERROR;
    }
    val args: *type.TypeId = R.unwrap_ok[*type.TypeId, str](pr);

    var i: u32 = 0;
    for (i < c.type_args_len) {
        val arg_tid: id.TypeId = sc.a.type_ids[c.type_args_start + i];
        args[i] = resolve_type_ref(sc, arg_tid);
        i = i + 1;
    }

    if (!generics.check_arity(sc, sym.decl, sym.origin, c.type_args_len, span)) {
        free_params(sc, args, c.type_args_len);
        ret type.TYPE_ERROR;
    }

    if (ct == type.TYPE_ERROR) {
        free_params(sc, args, c.type_args_len);
        ret type.TYPE_ERROR;
    }
    val fn_opt: O.Option[*type.Type] = type.get(?sc.s.types, ct);
    if (O.is_none[*type.Type](fn_opt)) {
        free_params(sc, args, c.type_args_len);
        ret type.TYPE_ERROR;
    }
    if (O.unwrap[*type.Type](fn_opt).kind != type.TYPE_FUN) {
        check.report_typed(sc, span, "not callable: `", ct, "` is not a function", "not callable: target is not a function");
        free_params(sc, args, c.type_args_len);
        ret type.TYPE_ERROR;
    }

    val sig: type.TypeId = context.recover[type.TypeId](sc, generics.substitute(sc.s, ct, args, c.type_args_len), type.TYPE_ERROR);
    if (sig == type.TYPE_ERROR) {
        free_params(sc, args, c.type_args_len);
        context.report_internal(sc, span, "internal: generic substitution failed");
        ret type.TYPE_ERROR;
    }

    val sfn_opt: O.Option[*type.Type] = type.get(?sc.s.types, sig);
    if (O.is_none[*type.Type](sfn_opt) || O.unwrap[*type.Type](sfn_opt).kind != type.TYPE_FUN) {
        free_params(sc, args, c.type_args_len);
        ret type.TYPE_ERROR;
    }

    @out_sym  = sym;
    @out_args = args;
    ret sig;
}

fun queue_generic_instance(sc: *context.SemaContext, sym: *resolve.Symbol, args: *type.TypeId, arg_len: u32, sig: type.TypeId, span: token.Span) bool {
    val rr: R.Result[u8, str] = context.record_instance(sc, sym.origin, sym.decl, args, arg_len, sig, sym.name, span);
    if (R.is_err[u8, str](rr)) {
        context.report(sc, span, R.unwrap_err[u8, str](rr));
        ret false;
    }
    val outcome: u8 = R.unwrap_ok[u8, str](rr);
    if (outcome != context.RECORD_OK) {
        check.report_instantiation_limit(sc, span, outcome, sym.name, args, arg_len);
        ret false;
    }
    ret true;
}

fun infer_generic_call(sc: *context.SemaContext, c: *expr.ExprCall, ct: type.TypeId, span: token.Span) type.TypeId {
    var sym: *resolve.Symbol = nil;
    var args: *type.TypeId = nil;
    val sig: type.TypeId = compute_generic_signature(sc, c, ct, span, ?sym, ?args);
    if (sig == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    val sfn_opt: O.Option[*type.Type] = type.get(?sc.s.types, sig);
    if (O.is_none[*type.Type](sfn_opt)) { free_params(sc, args, c.type_args_len); ret type.TYPE_ERROR; }
    val ret_type: type.TypeId = O.unwrap[*type.Type](sfn_opt).data.fn.ret_type;

    if (!check.check_call(sc, sig, c.args_start, c.args_len, span, callee_packs_to_c_tail(sc, c.callee))) {
        free_params(sc, args, c.type_args_len);
        ret type.TYPE_ERROR;
    }

    val queued: bool = queue_generic_instance(sc, sym, args, c.type_args_len, sig, span);
    free_params(sc, args, c.type_args_len);
    if (!queued) { ret type.TYPE_ERROR; }
    ret ret_type;
}

fun infer_generic_instance(sc: *context.SemaContext, c: *expr.ExprCall, span: token.Span) type.TypeId {
    val ct: type.TypeId = infer_expr(sc, c.callee);

    val cf_opt: O.Option[*decl.DeclFun] = callee_fun_decl(sc, c.callee);
    if (O.is_none[*decl.DeclFun](cf_opt)) {
        check.report_typed(sc, span, "not a generic function: `", ct, "` cannot take type arguments", "not a generic function: this cannot take type arguments");
        ret type.TYPE_ERROR;
    }
    val cf: *decl.DeclFun = O.unwrap[*decl.DeclFun](cf_opt);
    if (cf.generics_len > 0 && decl_has_comptime_param(sc, c.callee, cf)) {
        context.report(sc, span, "comptime value parameters on a generic function are not yet supported");
        ret type.TYPE_ERROR;
    }

    var sym: *resolve.Symbol = nil;
    var args: *type.TypeId = nil;
    val sig: type.TypeId = compute_generic_signature(sc, c, ct, span, ?sym, ?args);
    if (sig == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    val queued: bool = queue_generic_instance(sc, sym, args, c.type_args_len, sig, span);
    free_params(sc, args, c.type_args_len);
    if (!queued) { ret type.TYPE_ERROR; }
    ret sig;
}

fun infer_index(sc: *context.SemaContext, ix: *expr.ExprIndex, span: token.Span) type.TypeId {
    val ot: type.TypeId = infer_expr(sc, ix.object);
    val it: type.TypeId = infer_expr(sc, ix.index);
    if (ot == type.TYPE_ERROR || it == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    if (!check.check_const_index(sc, ot, ix.index, span)) { ret type.TYPE_ERROR; }

    if (type.is_vector(?sc.s.types, ot)) {
        ret infer_vector_lane(sc, ix, ot, span);
    }

    val r: O.Option[type.TypeId] = check.check_index(sc, ot, it, span);
    if (O.is_none[type.TypeId](r)) { ret type.TYPE_ERROR; }
    ret O.unwrap[type.TypeId](r);
}

fun infer_vector_lane(sc: *context.SemaContext, ix: *expr.ExprIndex, ot: type.TypeId, span: token.Span) type.TypeId {
    val base:      type.TypeId   = type.strip_secret(?sc.s.types, ot);
    val lane_kind: type.TypeKind = type.vector_element(?sc.s.types, base);
    val lane_ty:   type.TypeId   = prim_or_error(sc, lane_kind);

    val cv_opt: O.Option[comptime.CTValue] = check.const_index_value(sc, ix.index);
    if (O.is_none[comptime.CTValue](cv_opt)) {
        context.report(sc, span, "dynamic lane index not supported: a vector lane index must be a comptime constant");
        ret type.TYPE_ERROR;
    }

    ret join_secret(sc, lane_ty, type.is_secret(?sc.s.types, ot));
}

fun infer_member(sc: *context.SemaContext, eid: id.ExprId, m: *expr.ExprMember, span: token.Span) type.TypeId {
    val qsym_opt: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_some[*resolve.Symbol](qsym_opt)) {
        val qsym: *resolve.Symbol = O.unwrap[*resolve.Symbol](qsym_opt);
        if (report_never_value(sc, eid, qsym)) { ret type.TYPE_ERROR; }
        ret context.decl_type_for(sc, qsym);
    }

    val osym_opt: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, m.object);
    if (O.is_some[*resolve.Symbol](osym_opt) && O.unwrap[*resolve.Symbol](osym_opt).kind == resolve.SYM_USE) {
        ret type.TYPE_ERROR;
    }

    val cti: type.TypeId = infer_comptime_int_path(sc, eid);
    if (cti != type.TYPE_NIL) { ret cti; }
    val cts: type.TypeId = infer_comptime_str_path(sc, eid);
    if (cts != type.TYPE_NIL) { ret cts; }

    val fdm: type.TypeId = infer_field_member(sc, m, span);
    if (fdm != type.TYPE_NIL) { ret fdm; }

    val ot: type.TypeId = infer_expr(sc, m.object);
    if (ot == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    if (type_is_pack(sc, ot)) {
        if (str_region_equals(sc.source, m.name.offset, m.name.len, "len")) {
            ret prim_or_error(sc, type.TYPE_U64);
        }
        context.report(sc, span, "a variadic pack has only `.len`; iterate its elements with `$each`");
        ret type.TYPE_ERROR;
    }

    if (ot == type.TYPE_NIL) {
        context.report(sc, span, "a call that returns nothing has no members; a member access requires a record or union value");
        ret type.TYPE_ERROR;
    }

    ensure_record_fields(sc, ot);

    val name_id: intern.StrId = intern_span_or_nil(sc, m.name);
    val r: O.Option[type.TypeId] = check.check_member(sc, ot, name_id, span);
    if (O.is_none[type.TypeId](r)) { ret type.TYPE_ERROR; }
    ret O.unwrap[type.TypeId](r);
}

fun infer_comptime_int_path(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (!comptime.is_comptime_path(sc.a, eid)) { ret type.TYPE_NIL; }
    val ev: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
    context.record_eval_result(sc, ev);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](ev)) { ret type.TYPE_NIL; }
    val cv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](ev);
    if (cv.kind != comptime.CT_KIND_INT) { ret type.TYPE_NIL; }
    if (cv.int_unsigned) {
        if (cv.int_width == 8)  { ret prim_or_error(sc, type.TYPE_U8); }
        if (cv.int_width == 16) { ret prim_or_error(sc, type.TYPE_U16); }
        if (cv.int_width == 32) { ret prim_or_error(sc, type.TYPE_U32); }
        if (cv.int_width == 64) { ret prim_or_error(sc, type.TYPE_U64); }
    }
    or {
        if (cv.int_width == 8)  { ret prim_or_error(sc, type.TYPE_I8); }
        if (cv.int_width == 16) { ret prim_or_error(sc, type.TYPE_I16); }
        if (cv.int_width == 32) { ret prim_or_error(sc, type.TYPE_I32); }
        if (cv.int_width == 64) { ret prim_or_error(sc, type.TYPE_I64); }
    }
    ret prim_or_error(sc, type.TYPE_I64);
}

fun infer_comptime_str_path(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (!comptime.is_comptime_path(sc.a, eid)) { ret type.TYPE_NIL; }
    val ev: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
    context.record_eval_result(sc, ev);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](ev)) { ret type.TYPE_NIL; }
    val cv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](ev);
    if (cv.kind != comptime.CT_KIND_STR) { ret type.TYPE_NIL; }
    ret ptr_to(sc, prim_or_error(sc, type.TYPE_U8));
}

fun ensure_record_fields(sc: *context.SemaContext, tid: type.TypeId) {
    context.record_result(sc, generics.ensure_fields(sc.s, tid));
    val t_opt: O.Option[*type.Type] = type.get(?sc.s.types, tid);
    if (O.is_none[*type.Type](t_opt)) { ret; }
    val t: *type.Type = O.unwrap[*type.Type](t_opt);
    if (t.kind == type.TYPE_POINTER) {
        context.record_result(sc, generics.ensure_fields(sc.s, t.data.pointer.base));
    }
}

fun infer_cast(sc: *context.SemaContext, c: *expr.ExprCast, span: token.Span) type.TypeId {
    val ft: type.TypeId = infer_expr(sc, c.value);
    val tt: type.TypeId = context.resolved_type_of(sc, c.ty);
    if (ft == type.TYPE_ERROR || tt == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    var r: O.Option[type.TypeId] = O.none[type.TypeId]();
    if (c.reinterpret) {
        r = check.check_reinterpret(sc, ft, tt, span);
    }
    or {
        r = check.check_cast(sc, ft, tt, span);
    }
    if (O.is_none[type.TypeId](r)) { ret type.TYPE_ERROR; }
    ret O.unwrap[type.TypeId](r);
}

fun infer_strip(sc: *context.SemaContext, st: *expr.ExprStrip, span: token.Span) type.TypeId {
    val vt: type.TypeId = infer_expr(sc, st.value);
    if (vt == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    val stripped: type.TypeId = type.strip_secret(?sc.s.types, vt);

    if (st.ty == id.TYPE_NIL) { ret stripped; }

    val tt: type.TypeId = context.resolved_type_of(sc, st.ty);
    if (tt == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
    if (type.is_secret(?sc.s.types, tt)) {
        context.report(sc, span, "secret strip: a `:>T` target type must be public; a strip only removes the `^` qualifier");
        ret type.TYPE_ERROR;
    }
    if (tt != stripped) {
        context.report(sc, span, "secret strip: a `:>T` target must name the operand's stripped (public) type; a strip does not convert the value");
        ret type.TYPE_ERROR;
    }
    ret tt;
}

fun infer_array_lit(sc: *context.SemaContext, al: *expr.ExprArrayLit, span: token.Span) type.TypeId {
    val arr_ty: type.TypeId = context.resolved_type_of(sc, al.ty);
    var elem_ty:    type.TypeId = type.TYPE_ERROR;
    var has_count:  bool        = false;
    var decl_count: u32         = 0;
    val at_opt: O.Option[*type.Type] = type.get(?sc.s.types, arr_ty);
    if (O.is_some[*type.Type](at_opt)) {
        val at: *type.Type = O.unwrap[*type.Type](at_opt);
        if (at.kind == type.TYPE_ARRAY) {
            elem_ty    = at.data.array.base;
            decl_count = at.data.array.count;
            has_count  = true;
        }
    }

    var i: u32 = 0;
    for (i < al.elems_len) {
        val ee: id.ExprId = sc.a.expr_ids[al.elems_start + i];
        val et: type.TypeId = infer_expr(sc, ee);
        if (elem_ty != type.TYPE_ERROR && et != type.TYPE_ERROR) {
            check.check_coercible(sc, elem_ty, ee, et, span);
        }
        i = i + 1;
    }

    if (has_count && al.elems_len > decl_count) {
        context.report(sc, span, "array literal: too many elements for declared length");
    }
    or (has_count && al.elems_len < decl_count) {
        context.report(sc, span, "array literal: too few elements for declared length");
    }
    ret arr_ty;
}

fun infer_vector_lit(sc: *context.SemaContext, vl: *expr.ExprVectorLit, span: token.Span) type.TypeId {
    val vec_ty: type.TypeId = context.resolved_type_of(sc, vl.ty);
    val is_vec: bool        = type.is_vector(?sc.s.types, vec_ty);

    var lane_ty: type.TypeId = type.TYPE_ERROR;
    var lanes:   u32         = 0;
    if (is_vec) {
        lanes   = type.vector_lanes(?sc.s.types, vec_ty);
        lane_ty = prim_or_error(sc, type.vector_element(?sc.s.types, vec_ty));
    }

    var i: u32 = 0;
    for (i < vl.elems_len) {
        val ee: id.ExprId   = sc.a.expr_ids[vl.elems_start + i];
        val et: type.TypeId = infer_expr(sc, ee);
        if (is_vec && lane_ty != type.TYPE_ERROR && et != type.TYPE_ERROR) {
            check.check_coercible(sc, lane_ty, ee, et, span);
        }
        i = i + 1;
    }

    if (!is_vec) {
        if (vec_ty != type.TYPE_ERROR) {
            check.report_typed(sc, span, "positional-brace literal requires a vector type; `", vec_ty, "` is not a vector (a record uses named fields, an array a `[N]T` prefix)", "positional-brace literal requires a vector type");
        }
        ret type.TYPE_ERROR;
    }

    if (vl.elems_len > lanes) {
        context.report(sc, span, "vector literal: too many elements for the lane count");
    }
    or (vl.elems_len < lanes) {
        context.report(sc, span, "vector literal: too few elements for the lane count");
    }
    ret vec_ty;
}

fun infer_struct_lit(sc: *context.SemaContext, sl: *expr.ExprStructLit, span: token.Span) type.TypeId {
    val rec_ty: type.TypeId = context.resolved_type_of(sc, sl.ty);
    context.record_result(sc, generics.ensure_fields(sc.s, rec_ty));
    val have_table: bool = O.is_some[*context.FieldTable](context.field_table_for(sc, rec_ty));

    val base_ty: type.TypeId = type.strip_secret(?sc.s.types, rec_ty);
    val is_union_lit: bool = rec_ty != type.TYPE_ERROR && type.is_union(?sc.s.types, base_ty);
    if (is_union_lit && sl.fields_len != 1) {
        context.report(sc, span, "union literal must initialize exactly one field");
    }

    var i: u32 = 0;
    for (i < sl.fields_len) {
        val fi: *expr.FieldInit = ?sc.a.field_inits[sl.fields_start + i];
        val vt: type.TypeId = infer_expr(sc, fi.value);
        val fname: intern.StrId = intern_span_or_nil(sc, fi.name);

        if (rec_ty != type.TYPE_ERROR) {
            var j: u32 = 0;
            for (j < i) {
                val fj: *expr.FieldInit = ?sc.a.field_inits[sl.fields_start + j];
                if (intern_span_or_nil(sc, fj.name) == fname) {
                    check.report_named(sc, fi.name, "duplicate field `", fname, "` in initializer", "duplicate field in initializer");
                }
                j = j + 1;
            }
        }

        if (rec_ty != type.TYPE_ERROR && vt != type.TYPE_ERROR && have_table) {
            val ft_opt: O.Option[type.TypeId] = context.field_lookup(sc, rec_ty, fname);
            if (O.is_none[type.TypeId](ft_opt)) {
                check.report_no_field(sc, fi.name, fname, rec_ty);
            }
            or {
                val ft: type.TypeId = O.unwrap[type.TypeId](ft_opt);
                check.check_coercible(sc, ft, fi.value, vt, span);
            }
        }
        i = i + 1;
    }
    ret rec_ty;
}

pub fun resolve_type_ref(sc: *context.SemaContext, tid: id.TypeId) type.TypeId {
    if (type_is_per_iteration(sc, tid)) {
        val resolved: type.TypeId = resolve_type_ref_raw(sc, tid);
        check_type_node_float_capability(sc, tid, resolved);
        ret resolved;
    }

    if (memo_state(sc, tid) != context.TYPE_MEMO_NONE) { ret sc.type_resolved_ty[tid]; }

    val mark:     u64 = context.diag_mark(sc);
    val resolved: type.TypeId = resolve_type_ref_raw(sc, tid);
    check_type_node_float_capability(sc, tid, resolved);
    memo_record(sc, tid, resolved, context.reported_since(sc, mark));
    ret resolved;
}

fun check_type_node_float_capability(sc: *context.SemaContext, tid: id.TypeId, resolved: type.TypeId) {
    if (resolved == type.TYPE_ERROR || resolved == type.TYPE_NIL) { ret; }
    val t_opt: O.Option[*atype.Type] = ast.get_type(sc.a, tid);
    if (O.is_none[*atype.Type](t_opt)) { ret; }
    check.check_float_capability(sc, resolved, O.unwrap[*atype.Type](t_opt).span);
}

fun is_field_type_node(sc: *context.SemaContext, tid: id.TypeId) bool {
    val t_opt: O.Option[*atype.Type] = ast.get_type(sc.a, tid);
    if (O.is_none[*atype.Type](t_opt)) { ret false; }
    ret O.unwrap[*atype.Type](t_opt).kind == atype.TYPE_KIND_FIELD_TYPE;
}

pub fun type_is_per_iteration(sc: *context.SemaContext, tid: id.TypeId) bool {
    if (tid == id.TYPE_NIL) { ret false; }
    val t_opt: O.Option[*atype.Type] = ast.get_type(sc.a, tid);
    if (O.is_none[*atype.Type](t_opt)) { ret false; }
    val t: *atype.Type = O.unwrap[*atype.Type](t_opt);
    if (t.kind == atype.TYPE_KIND_FIELD_TYPE) { ret true; }
    if (t.kind == atype.TYPE_KIND_POINTEE_OF) { ret type_is_per_iteration(sc, t.data.pointee_of.inner); }
    if (t.kind == atype.TYPE_KIND_PTR)        { ret type_is_per_iteration(sc, t.data.ptr.pointee); }
    if (t.kind == atype.TYPE_KIND_SECRET)     { ret type_is_per_iteration(sc, t.data.secret.inner); }
    if (t.kind == atype.TYPE_KIND_ARRAY)      { ret type_is_per_iteration(sc, t.data.array.element); }
    if (t.kind == atype.TYPE_KIND_NAMED) {
        var i: u32 = 0;
        for (i < t.data.named.args_len) {
            if (type_is_per_iteration(sc, sc.a.type_ids[t.data.named.args_start + i])) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

fun memo_state(sc: *context.SemaContext, tid: id.TypeId) u8 {
    if (sc.type_resolved_memo == nil) { ret context.TYPE_MEMO_NONE; }
    if (sc.type_resolved_ty == nil)   { ret context.TYPE_MEMO_NONE; }
    if (tid >= sc.a.type_len::u32)    { ret context.TYPE_MEMO_NONE; }
    ret sc.type_resolved_memo[tid];
}

fun memo_record(sc: *context.SemaContext, tid: id.TypeId, resolved: type.TypeId, reported: bool) {
    if (sc.type_resolved_memo == nil) { ret; }
    if (sc.type_resolved_ty == nil)   { ret; }
    if (tid >= sc.a.type_len::u32)    { ret; }
    sc.type_resolved_ty[tid] = resolved;
    if (reported) {
        sc.type_resolved_memo[tid] = context.TYPE_MEMO_REPORTED;
        ret;
    }
    sc.type_resolved_memo[tid] = context.TYPE_MEMO_QUIET;
}

fun resolve_reported(sc: *context.SemaContext, tid: id.TypeId, mark: u64) bool {
    val state: u8 = memo_state(sc, tid);
    if (state != context.TYPE_MEMO_NONE) { ret state == context.TYPE_MEMO_REPORTED; }
    ret context.reported_since(sc, mark);
}

fun resolve_type_ref_raw(sc: *context.SemaContext, tid: id.TypeId) type.TypeId {
    val t_opt: O.Option[*atype.Type] = ast.get_type(sc.a, tid);
    if (O.is_none[*atype.Type](t_opt)) { ret type.TYPE_ERROR; }
    val t: *atype.Type = O.unwrap[*atype.Type](t_opt);

    if (t.kind == atype.TYPE_KIND_NAMED)  { ret resolve_type_named(sc, tid, ?t.data.named, t.span); }
    if (t.kind == atype.TYPE_KIND_PTR)    { ret resolve_type_ptr(sc, ?t.data.ptr); }
    if (t.kind == atype.TYPE_KIND_SECRET) { ret resolve_type_secret(sc, ?t.data.secret); }
    if (t.kind == atype.TYPE_KIND_FIELD_TYPE) { ret resolve_type_field_type(sc, ?t.data.field_type, t.span); }
    if (t.kind == atype.TYPE_KIND_POINTEE_OF) { ret resolve_type_pointee_of(sc, ?t.data.pointee_of, t.span); }
    if (t.kind == atype.TYPE_KIND_ARRAY)  { ret resolve_type_array(sc, tid, ?t.data.array, t.span); }
    if (t.kind == atype.TYPE_KIND_FUN)   { ret resolve_type_fun(sc, ?t.data.fun_); }
    if (t.kind == atype.TYPE_KIND_REC)   { ret resolve_type_anon(sc, tid, t.data.rec_.fields_start, t.data.rec_.fields_len, type.TYPE_REC); }
    if (t.kind == atype.TYPE_KIND_UNI)   { ret resolve_type_anon(sc, tid, t.data.uni_.fields_start, t.data.uni_.fields_len, type.TYPE_UNI); }
    if (t.kind == atype.TYPE_KIND_PACK) {
        val r: R.Result[type.TypeId, str] = type.intern_pack(?sc.s.types);
        if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
        ret R.unwrap_ok[type.TypeId, str](r);
    }
    ret type.TYPE_ERROR;
}

fun resolve_type_field_type(sc: *context.SemaContext, ft: *atype.TypeFieldType, span: token.Span) type.TypeId {
    val r: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, ft.var_name);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?sc.status, R.unwrap_err[intern.StrId, str](r)); ret type.TYPE_ERROR; }
    val got: O.Option[u32] = comptime.field_type_of_binding[context.SemaContext](sc.ctx, sc, sc.caps, R.unwrap_ok[intern.StrId, str](r));
    if (O.is_none[u32](got)) { ret type.TYPE_ERROR; }
    ret O.unwrap[u32](got)::type.TypeId;
}

fun resolve_type_pointee_of(sc: *context.SemaContext, po: *atype.TypePointeeOf, span: token.Span) type.TypeId {
    val inner: type.TypeId = resolve_type_ref(sc, po.inner);
    if (inner == type.TYPE_ERROR || inner == type.TYPE_NIL) { ret type.TYPE_ERROR; }

    val k: type.TypeKind = type.shape_kind(?sc.s.types, inner);
    if (k == type.TYPE_GENERIC_PARAM) { ret type.TYPE_ERROR; }

    if (type.is_secret(?sc.s.types, inner)) {
        check.report_typed(sc, span, "`$pointee_of` refuses `", inner,
            "`: a `^` secret is not a reference, and `$is_pointer` answers false for it",
            "`$pointee_of` refuses a `^` secret operand");
        ret type.TYPE_ERROR;
    }

    val t_opt: O.Option[*type.Type] = type.get(?sc.s.types, inner);
    if (O.is_some[*type.Type](t_opt) && O.unwrap[*type.Type](t_opt).kind == type.TYPE_POINTER) {
        ret O.unwrap[*type.Type](t_opt).data.pointer.base;
    }

    if (k == type.TYPE_PTR) {
        context.report(sc, span, "`$pointee_of(ptr)` has no answer: the raw `ptr` is untyped and carries no pointee type");
        ret type.TYPE_ERROR;
    }

    check.report_typed(sc, span, "`$pointee_of` expects a typed reference `*U`, but this names `", inner, "`",
        "`$pointee_of` expects a typed reference `*U`");
    ret type.TYPE_ERROR;
}

fun resolve_type_named(sc: *context.SemaContext, tid: id.TypeId, named: *atype.TypeNamed, span: token.Span) type.TypeId {
    val sym_opt: O.Option[*resolve.Symbol] = context.symbol_for_type(sc, tid);
    if (O.is_none[*resolve.Symbol](sym_opt)) {
        ret type.TYPE_ERROR;
    }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](sym_opt);

    if (named.args_len > 0) {
        ret instantiate_named(sc, sym, named, span);
    }

    if (named.operand && is_value_binding(sym)) { ret binding_type_for(sc, sym, span); }

    ret type_for_symbol(sc, sym, span);
}

fun is_value_binding(sym: *resolve.Symbol) bool {
    if ((sym.flags & resolve.SYM_FLAG_COMPTIME) != 0) { ret false; }
    if (sym.decl == id.DECL_NIL)                      { ret false; }
    if (sym.kind == resolve.SYM_VAL)   { ret true; }
    if (sym.kind == resolve.SYM_VAR)   { ret true; }
    if (sym.kind == resolve.SYM_PARAM) { ret true; }
    ret false;
}

fun binding_type_for(sc: *context.SemaContext, sym: *resolve.Symbol, span: token.Span) type.TypeId {
    if (sym.kind == resolve.SYM_PARAM || sym.origin != sc.own_module) {
        val t: type.TypeId = context.decl_type_for(sc, sym);
        if (t == type.TYPE_NIL || t == type.TYPE_ERROR) {
            check.report_named(sc, span, "`", sym.name, "` has no type a comptime intrinsic can measure here",
                "binding has no type a comptime intrinsic can measure here");
            ret type.TYPE_ERROR;
        }
        ret t;
    }

    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, sym.decl);
    if (O.is_none[*decl.Decl](d_opt)) { ret type.TYPE_ERROR; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) { ret type.TYPE_ERROR; }
    if (d.data.bind.ty == id.TYPE_NIL) { ret type.TYPE_ERROR; }
    ret resolve_type_ref(sc, d.data.bind.ty);
}

fun type_for_symbol(sc: *context.SemaContext, sym: *resolve.Symbol, span: token.Span) type.TypeId {
    if (sym.kind == resolve.SYM_REC || sym.kind == resolve.SYM_UNI || sym.kind == resolve.SYM_IMPORTED) {
        val arity: u32 = generics.declared_arity(sc, sym.decl, sym.origin);
        if (arity > 0) {
            check.report_missing_type_args(sc, span, sym.name, arity);
            ret type.TYPE_ERROR;
        }
    }

    if (sym.kind == resolve.SYM_PRIM) {
        ret prim_or_error(sc, sym.slot::type.TypeKind);
    }
    if (sym.kind == resolve.SYM_VECTOR) {
        ret sym.slot::type.TypeId;
    }
    if (sym.kind == resolve.SYM_GENERIC) { ret context.generic_param_type_for(sc, sym); }
    if (sym.kind == resolve.SYM_REC || sym.kind == resolve.SYM_UNI) {
        var kind: type.TypeKind = type.TYPE_REC;
        if (sym.kind == resolve.SYM_UNI) { kind = type.TYPE_UNI; }
        val r: R.Result[type.TypeId, str] = type.intern_nominal(?sc.s.types, sym.name, sym.origin, sym.decl, kind);
        if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
        ret R.unwrap_ok[type.TypeId, str](r);
    }
    if (sym.kind == resolve.SYM_DEF) {
        ret def_underlying(sc, sym, span);
    }
    if (sym.kind == resolve.SYM_IMPORTED) {
        val imported: type.TypeId = context.decl_type_for(sc, sym);
        if (imported == type.TYPE_NIL || imported == type.TYPE_ERROR) {
            check.report_named(sc, span, "imported `", sym.name, "` does not resolve to a type", "imported name does not resolve to a type");
            ret type.TYPE_ERROR;
        }
        ret imported;
    }
    check.report_named(sc, span, "`", sym.name, "` does not name a type", "name does not denote a type");
    ret type.TYPE_ERROR;
}

fun def_underlying(sc: *context.SemaContext, sym: *resolve.Symbol, span: token.Span) type.TypeId {
    if (sym.origin == sc.own_module) {
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, sym.decl);
        if (O.is_none[*decl.Decl](d_opt)) { ret type.TYPE_ERROR; }
        val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
        if (d.kind != decl.DECL_KIND_DEF) { ret type.TYPE_ERROR; }
        if (d.data.def_.ty == id.TYPE_NIL && abitype.declares_abi_type(sc, d)) {
            ret abitype.type_of(sc, d);
        }
        if (d.data.def_.ty == id.TYPE_NIL) { ret handle.type_of(sc, sym.decl, d); }
        ret resolve_type_ref(sc, d.data.def_.ty);
    }
    ret context.decl_type_for(sc, sym);
}

fun instantiate_named(sc: *context.SemaContext, sym: *resolve.Symbol, named: *atype.TypeNamed, span: token.Span) type.TypeId {
    val pr: R.Result[*type.TypeId, str] = allocate_params(sc, named.args_len);
    if (R.is_err[*type.TypeId, str](pr)) { fail.internal(?sc.status, R.unwrap_err[*type.TypeId, str](pr)); ret type.TYPE_ERROR; }
    val args: *type.TypeId = R.unwrap_ok[*type.TypeId, str](pr);

    var i: u32 = 0;
    for (i < named.args_len) {
        val arg_tid: id.TypeId = sc.a.type_ids[named.args_start + i];
        args[i] = resolve_type_ref(sc, arg_tid);
        i = i + 1;
    }

    val r: R.Result[type.TypeId, str] = generics.instantiate(sc, sym.decl, sym.origin, args, named.args_len, span);
    free_params(sc, args, named.args_len);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun resolve_type_ptr(sc: *context.SemaContext, p: *atype.TypePtr) type.TypeId {
    val base: type.TypeId = resolve_type_ref(sc, p.pointee);
    ret ptr_to(sc, base);
}

fun resolve_type_secret(sc: *context.SemaContext, s: *atype.TypeSecret) type.TypeId {
    val inner: type.TypeId = resolve_type_ref(sc, s.inner);
    if (inner == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
    val r: R.Result[type.TypeId, str] = type.intern_secret(?sc.s.types, inner);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun resolve_type_array(sc: *context.SemaContext, tid: id.TypeId, ar: *atype.TypeArray, span: token.Span) type.TypeId {
    val elem: type.TypeId = resolve_type_ref(sc, ar.element);
    if (elem == type.TYPE_ERROR) { ret type.TYPE_ERROR; }

    val embed_len: u64 = context.embed_len_of(sc, tid);
    if (ar.length == id.EXPR_NIL) {
        if (embed_len == context.EMBED_LEN_FAILED) { ret type.TYPE_ERROR; }
        if (embed_len == context.EMBED_LEN_NONE) {
            context.report(sc, span, "an inferred array length `[_]` is only valid on an `#[embed(...)]` declaration");
            ret type.TYPE_ERROR;
        }
        val re: R.Result[type.TypeId, str] = type.intern_array(?sc.s.types, elem, embed_len::u32);
        if (R.is_err[type.TypeId, str](re)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](re)); ret type.TYPE_ERROR; }
        ret R.unwrap_ok[type.TypeId, str](re);
    }

    var cv: comptime.CTValue;
    val lay: O.Option[O.Option[comptime.CTValue]] = fold_layout_intrinsic(sc, ar.length, span);
    if (O.is_some[O.Option[comptime.CTValue]](lay)) {
        val got: O.Option[comptime.CTValue] = O.unwrap[O.Option[comptime.CTValue]](lay);
        if (O.is_none[comptime.CTValue](got)) { ret type.TYPE_ERROR; }
        cv = O.unwrap[comptime.CTValue](got);
    }
    or {
        val len_r: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, ar.length, ?sc.s.interner);
        context.record_eval_result(sc, len_r);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](len_r)) {
            context.report(sc, span, "cannot infer type: array length is not a comptime constant");
            ret type.TYPE_ERROR;
        }
        cv = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](len_r);
    }
    if (cv.kind != comptime.CT_KIND_INT) {
        context.report(sc, span, "type mismatch: array length must be an integer");
        ret type.TYPE_ERROR;
    }
    if (comptime.ct_is_negative(cv)) {
        context.report(sc, span, "type mismatch: array length must be non-negative");
        ret type.TYPE_ERROR;
    }
    val len_u: u64 = cv.data.i:~u64;
    if (len_u > 4294967295) {
        context.report(sc, span, "type mismatch: array length exceeds the maximum of 4294967295 elements");
        ret type.TYPE_ERROR;
    }

    if (embed_len == context.EMBED_LEN_FAILED) { ret type.TYPE_ERROR; }
    if (embed_len != context.EMBED_LEN_NONE && len_u != embed_len) {
        report_embed_size(sc, span, len_u, embed_len);
        ret type.TYPE_ERROR;
    }

    val r: R.Result[type.TypeId, str] = type.intern_array(?sc.s.types, elem, len_u::u32);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun report_embed_size(sc: *context.SemaContext, span: token.Span, declared: u64, actual: u64) {
    val r: R.Result[str, str] = format.sprint(sc.s.alloc,
        "`embed` declares {} bytes but the file holds {}", declared, actual);
    if (R.is_err[str, str](r)) { fail.internal(?sc.status, R.unwrap_err[str, str](r));
        context.report(sc, span, "`embed` declares a length the file does not have");
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](r);
    context.report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

fun resolve_type_fun(sc: *context.SemaContext, fn: *atype.TypeFun) type.TypeId {
    var ret_type: type.TypeId = type.TYPE_NIL;
    if (fn.ret_type != id.TYPE_NIL) { ret_type = resolve_type_ref(sc, fn.ret_type); }

    if (fn.params_len == 0) {
        val r: R.Result[type.TypeId, str] = type.intern_function(?sc.s.types, ret_type, nil, 0, fn.c_variadic);
        if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
        ret R.unwrap_ok[type.TypeId, str](r);
    }

    val pr: R.Result[*type.TypeId, str] = allocate_params(sc, fn.params_len);
    if (R.is_err[*type.TypeId, str](pr)) { fail.internal(?sc.status, R.unwrap_err[*type.TypeId, str](pr)); ret type.TYPE_ERROR; }
    val params: *type.TypeId = R.unwrap_ok[*type.TypeId, str](pr);

    var i: u32 = 0;
    for (i < fn.params_len) {
        val pt: id.TypeId = sc.a.type_ids[fn.params_start + i];
        params[i] = resolve_type_ref(sc, pt);
        i = i + 1;
    }

    val r: R.Result[type.TypeId, str] = type.intern_function(?sc.s.types, ret_type, params, fn.params_len, fn.c_variadic);
    free_params(sc, params, fn.params_len);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun resolve_type_anon(sc: *context.SemaContext, tid: id.TypeId, fields_start: u32, fields_len: u32, kind: type.TypeKind) type.TypeId {
    val name_id: intern.StrId = synth_anon_name(sc, kind);

    val key: intern.StrId = anon_struct_key(sc, fields_start, fields_len, kind);
    if (key == intern.STR_NIL) { ret type.TYPE_ERROR; }

    val r: R.Result[type.TypeId, str] = type.intern_nominal(?sc.s.types, name_id, session.MODULE_NIL, key::id.DeclId, kind);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    val ty: type.TypeId = R.unwrap_ok[type.TypeId, str](r);

    build_field_table(sc, ty, fields_start, fields_len);
    ret ty;
}

fun anon_struct_key(sc: *context.SemaContext, fields_start: u32, fields_len: u32, kind: type.TypeKind) intern.StrId {
    val cap: usize = (2 + fields_len::usize * 2) * 8;
    val br: R.Result[*u8, str] = A.allocate[u8](sc.s.alloc, cap);
    if (R.is_err[*u8, str](br)) { fail.internal(?sc.status, R.unwrap_err[*u8, str](br)); ret intern.STR_NIL; }
    val buf: *u8 = R.unwrap_ok[*u8, str](br);

    var len: usize = 0;
    len = put_hex_u32(buf, len, cap, kind::u32);
    len = put_hex_u32(buf, len, cap, fields_len);

    var i: u32 = 0;
    for (i < fields_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[fields_start + i];
        val fname: intern.StrId = intern_span_or_nil(sc, tn.name);
        val fty: type.TypeId = context.resolved_type_of(sc, tn.ty);
        len = put_hex_u32(buf, len, cap, fname::u32);
        len = put_hex_u32(buf, len, cap, fty::u32);
        i = i + 1;
    }

    val r: R.Result[intern.StrId, str] = intern.intern_bytes(?sc.s.interner, buf::str, len);
    A.deallocate[u8](sc.s.alloc, buf, cap);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?sc.status, R.unwrap_err[intern.StrId, str](r)); ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun put_hex_u32(buf: *u8, off: usize, cap: usize, v: u32) usize {
    var pos: usize = off;
    var i: u32 = 0;
    for (i < 8) {
        if (pos >= cap) { ret pos; }
        val shift: u32 = (7 - i) * 4;
        val nib: u32 = (v >> shift) & 0xF;
        var c: u8 = nib::u8 + 0x30;
        if (nib > 9) { c = nib::u8 - 10 + 0x61; }
        buf[pos] = c;
        pos = pos + 1;
        i = i + 1;
    }
    ret pos;
}

fun synth_anon_name(sc: *context.SemaContext, kind: type.TypeKind) intern.StrId {
    var label: str = "__anon_rec";
    if (kind == type.TYPE_UNI) { label = "__anon_uni"; }
    ret interned(sc, label);
}

fun ptr_to(sc: *context.SemaContext, base: type.TypeId) type.TypeId {
    if (base == type.TYPE_ERROR) { ret type.TYPE_ERROR; }
    val r: R.Result[type.TypeId, str] = type.intern_pointer(?sc.s.types, base);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun pointee_of(sc: *context.SemaContext, ty: type.TypeId, span: token.Span) type.TypeId {
    val base: type.TypeId = type.strip_secret(?sc.s.types, ty);
    val t_opt: O.Option[*type.Type] = type.get(?sc.s.types, base);
    if (O.is_none[*type.Type](t_opt)) { ret type.TYPE_ERROR; }
    val t: *type.Type = O.unwrap[*type.Type](t_opt);
    if (t.kind != type.TYPE_POINTER) {
        context.report(sc, span, "type mismatch: dereference of non-pointer type");
        ret type.TYPE_ERROR;
    }
    ret t.data.pointer.base;
}

fun prim_or_error(sc: *context.SemaContext, kind: type.TypeKind) type.TypeId {
    val p: O.Option[type.TypeId] = type.prim(?sc.s.types, kind);
    if (O.is_none[type.TypeId](p)) { ret type.TYPE_ERROR; }
    ret O.unwrap[type.TypeId](p);
}

fun is_numeric(sc: *context.SemaContext, ty: type.TypeId) bool {
    ret type.is_numeric(?sc.s.types, ty);
}

fun is_integer(sc: *context.SemaContext, ty: type.TypeId) bool {
    ret type.is_integer(?sc.s.types, ty);
}

fun is_float(sc: *context.SemaContext, ty: type.TypeId) bool {
    ret type.is_float(?sc.s.types, ty);
}

fun is_pointer_like(sc: *context.SemaContext, ty: type.TypeId) bool {
    ret type.is_pointer_like(?sc.s.types, ty);
}

fun is_aggregate(sc: *context.SemaContext, ty: type.TypeId) bool {
    val base: type.TypeId = type.strip_secret(?sc.s.types, ty);
    val opt:  O.Option[*type.Type] = type.get(?sc.s.types, base);
    if (O.is_none[*type.Type](opt)) { ret false; }
    val t: *type.Type = O.unwrap[*type.Type](opt);
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_ARRAY) { ret true; }
    if (t.kind == type.TYPE_INSTANCE) {
        ret instance_is_aggregate(sc, t.data.instance.target_origin, t.data.instance.target_decl);
    }
    ret false;
}

fun instance_is_aggregate(sc: *context.SemaContext, origin: session.ModuleId, dcl: id.DeclId) bool {
    val ga: *ast.Ast = session.module_ast(sc.s, origin);
    if (ga == nil) { ret false; }
    val od: O.Option[*decl.Decl] = ast.get_decl(ga, dcl);
    if (O.is_none[*decl.Decl](od)) { ret false; }
    val dk: decl.DeclKind = O.unwrap[*decl.Decl](od).kind;
    ret dk == decl.DECL_KIND_REC || dk == decl.DECL_KIND_UNI;
}

fun symbol_ast(sc: *context.SemaContext, sym: *resolve.Symbol) *ast.Ast {
    if (sym.origin == sc.own_module) { ret sc.a; }
    ret session.module_ast(sc.s, sym.origin);
}

fun unify_literals(sc: *context.SemaContext, lhs: id.ExprId, lt: type.TypeId, rhs: id.ExprId, rt: type.TypeId, span: token.Span) O.Option[type.TypeId] {
    if (lt == rt) { ret O.none[type.TypeId](); }
    val cr: coerce.CoerceResult = coerce.try_coerce_literal(sc, rhs, lt);
    if (cr.kind == coerce.COERCE_COERCED) { ret O.some[type.TypeId](lt); }
    if (cr.kind == coerce.COERCE_OUT_OF_RANGE) {
        check.report_out_of_range(sc, span, cr);
        ret O.some[type.TypeId](type.TYPE_ERROR);
    }
    val cl: coerce.CoerceResult = coerce.try_coerce_literal(sc, lhs, rt);
    if (cl.kind == coerce.COERCE_COERCED) { ret O.some[type.TypeId](rt); }
    if (cl.kind == coerce.COERCE_OUT_OF_RANGE) {
        check.report_out_of_range(sc, span, cl);
        ret O.some[type.TypeId](type.TYPE_ERROR);
    }
    ret O.none[type.TypeId]();
}

fun type_mismatch(sc: *context.SemaContext, span: token.Span, lt: type.TypeId, rt: type.TypeId) {
    check.report_typed2(sc, span, "type mismatch: incompatible operand types `", lt, "` and `", rt, "`", "type mismatch: incompatible operand types");
}

fun report_operand_width(sc: *context.SemaContext, span: token.Span, lt: type.TypeId, rt: type.TypeId) {
    check.report_typed2(sc, span, "type mismatch: `", lt, "` and `", rt, "` are different types, and mach inserts no implicit conversion between them; cast one operand explicitly (`::`) so both operands and the result have one type", "type mismatch: arithmetic and bitwise operands must have the same type; cast one operand explicitly (`::`)");
}

fun report_int_float_cmp(sc: *context.SemaContext, span: token.Span) {
    context.report(sc, span, "type mismatch: cannot compare an integer and a float; cast one operand explicitly (`::`)");
}

fun report_aggregate_eq(sc: *context.SemaContext, span: token.Span, lt: type.TypeId, rt: type.TypeId) {
    var ty: type.TypeId = lt;
    if (!is_aggregate(sc, lt)) { ty = rt; }
    check.report_typed(sc, span, "cannot compare `", ty, "` values with `==` / `!=`: aggregate equality is not structural. compare fields or elements individually, or use `std.derive.eq` for a derived structural comparison", "cannot compare aggregate values with `==` / `!=`: aggregate equality is not structural; compare fields or elements individually, or use `std.derive.eq` for a derived structural comparison");
}

fun intern_span_or_nil(sc: *context.SemaContext, span: token.Span) intern.StrId {
    if (span.len == 0) { ret intern.STR_NIL; }
    val r: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?sc.status, R.unwrap_err[intern.StrId, str](r)); ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun allocate_params(sc: *context.SemaContext, count: u32) R.Result[*type.TypeId, str] {
    ret A.allocate[type.TypeId](sc.s.alloc, count::usize);
}

fun free_params(sc: *context.SemaContext, params: *type.TypeId, count: u32) {
    A.deallocate[type.TypeId](sc.s.alloc, params, count::usize);
}
