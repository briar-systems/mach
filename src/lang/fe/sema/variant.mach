# the generic unions an annotation instantiates must have variants agreeing on secrecy
# under their arguments, which no check of the generic declaration can answer
use diagnostic_kind: mach.lang.diagnostic.kind;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_id:       mach.lang.fe.ast.id;
use ast_type:     mach.lang.fe.ast.type;
use sema_context: mach.lang.fe.sema.context;
use lang_source:  mach.lang.source;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.deep;
use mach.lang.type.query.expansive;
use mach.lang.type.query.mention;
use mach.lang.type.query.reach;
use mach.lang.type.query.secrecy;
use mach.lang.type.query.subst;
use mach.lang.type.visit;

# opens the walk the checks of one scope's annotations share, which stays closed when the
# module holds no secret, so its checks have nothing to find
pub fun walk_open(sc: *sema_context.SemaContext, w: *sema_context.SecrecyWalk) {
    w.open   = false;
    w.visits = 0;
    if (!sc.typing.has_secret) { ret; }
    val nominals: err[fail.Fail] = type.type_scan_begin(?sc.s.types, ?w.nominals);
    if (sel nominals.err) {
        fail.internal(?sc.status, fail.describe(nominals.err));
        ret;
    }
    val walked: err[fail.Fail] = type.pair_scan_begin(?sc.s.types, ?w.walked);
    if (sel walked.err) {
        type.type_scan_end(?sc.s.types, ?w.nominals);
        fail.internal(?sc.status, fail.describe(walked.err));
        ret;
    }
    w.open = true;
}

pub fun walk_close(sc: *sema_context.SemaContext, w: *sema_context.SecrecyWalk) {
    if (!w.open) { ret; }
    type.pair_scan_end(?sc.s.types, ?w.walked);
    type.type_scan_end(?sc.s.types, ?w.nominals);
    w.open = false;
}

pub fun check_annotation_uni_secrecy(sc: *sema_context.SemaContext, w: *sema_context.SecrecyWalk, ast_tid: ast_id.TypeId) {
    if (w == nil || !w.open)                                    { ret; }
    if (sc.view.type_resolved_ty == nil)                        { ret; }
    if (ast_id.type_index(ast_tid) >= sc.view.a.types.len::u32) { ret; }

    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, ast_tid);
    if (!sel t_opt.some) { ret; }

    check_type(sc, w, sc.view.type_resolved_ty[ast_id.type_index(ast_tid)], t_opt.some.span);
}

# one annotation's check over the shared walk, whose reports land at the annotation
rec Check {
    sc:   *sema_context.SemaContext;
    q:    *type_query.Query;
    w:    *sema_context.SecrecyWalk;
    span: lang_source.Span;
}

# a walk over one type under the arguments its parameters stand for. `ctx` names the
# substitution: the nominal instantiation whose arguments these are, or nil for the scope's
# own, so a type is walked once under each
rec Under {
    c:       *Check;
    who:     *type.GenericOwner;
    args:    *type.TypeId;
    arg_len: u32;
    ctx:     type.TypeId;
}

# the check of `tid`, an annotation's type at `span`, under the scope's own substitution
pub fun check_type(sc: *sema_context.SemaContext, w: *sema_context.SecrecyWalk, tid: type.TypeId, span: lang_source.Span) {
    if (type.is_nil(tid) || type.is_error(tid)) { ret; }

    var q: type_query.Query = sema_context.query_of(sc);
    var c: Check            = Check{sc: sc, q: ?q, w: w, span: span};
    walk_under(?c, tid, ?sc.instance.subst_owner, sc.instance.subst, sc.instance.subst_len, type.TYPE_NIL);
    sema_context.query_settle(sc, ?q, span);
}

fun walk_under(c: *Check, tid: type.TypeId, who: *type.GenericOwner, args: *type.TypeId, arg_len: u32,
    ctx: type.TypeId) {
    var u: Under             = Under{c: c, who: who, args: args, arg_len: arg_len, ctx: ctx};
    var w: visit.Walk[Under] = visit.Walk[Under]{types: c.q.types, status: c.q.status, scan: nil,
        edges: visit.EDGE_BASE | visit.EDGE_POINTEE | visit.EDGE_ELEMENT | visit.EDGE_SIGNATURE, ctx: ?u,
        leaf:  under_leaf};
    visit.reaches[Under](?w, tid);
}

# whether the walk meets `tid` under `ctx` for the first time; a mark that cannot be
# recorded is a failure and reads as already walked
fun fresh(u: *Under, tid: type.TypeId) bool {
    val mark: res[type.VisitMark, fail.Fail] = type.pair_scan_mark(u.c.q.types, ?u.c.w.walked, tid, u.ctx);
    if (sel mark.err) {
        type_query.failed(u.c.q, mark.err);
        ret false;
    }
    if (mark.ok != type.VISIT_FRESH) { ret false; }
    u.c.w.visits = u.c.w.visits + 1;
    ret true;
}

fun under_leaf(u: *Under, tid: type.TypeId, t: *type.Type) visit.Verdict {
    if (!fresh(u, tid)) { ret visit.PRUNE; }
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_INSTANCE) {
        walk_instance(u, tid, t);
        ret visit.PRUNE;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) {
        walk_nominal(u.c, tid, u.args, u.arg_len);
        ret visit.PRUNE;
    }
    if (k == type.TYPE_SECRET || k == type.TYPE_POINTER || k == type.TYPE_ARRAY || k == type.TYPE_FUN) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

fun walk_instance(u: *Under, tid: type.TypeId, t: *type.Type) {
    val c:          *Check            = u.c;
    val q:          *type_query.Query = c.q;
    val gnom:       type.TypeId       = t.data.instance.nominal;
    val args_start: u32               = t.data.instance.args_start;
    val args_len:   u32               = t.data.instance.args_len;
    if (args_len == 0) { ret; }

    val res_raw: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](q.types.a, args_len::usize);
    if (sel res_raw.err) {
        type_query.refused(q, res_raw.err);
        ret;
    }
    val raw: *type.TypeId = res_raw.ok;
    fin { A.deallocate[type.TypeId](q.types.a, raw, args_len::usize); }

    var i: u32 = 0;
    for (i < args_len) {
        val a_opt: opt[type.TypeId] = type.get_param(q.types, args_start + i);
        if (!sel a_opt.some) { ret; }
        raw[i] = a_opt.some;
        i      = i + 1;
    }

    i = 0;
    for (i < args_len) {
        walk_under(c, raw[i], u.who, u.args, u.arg_len, u.ctx);
        i = i + 1;
    }

    # an expansive generic's instances are unbounded, so the walk cannot visit them all;
    # it needs to only when a secret and a generic union lie below
    if (!type.is_error(gnom) && expansive.nominal(q, gnom)) {
        if (deep.secret(q, tid) && reach.generic_union(q, gnom)) { report_unbounded(c, tid); }
        ret;
    }

    if (type.is_error(gnom)) {
        sema_context.report_internal(c.sc, c.span, "internal: union-secrecy instance walk: generic instance target declaration unavailable (pristine-type invariant violated)");
        ret;
    }

    val res_conc: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](q.types.a, args_len::usize);
    if (sel res_conc.err) {
        type_query.refused(q, res_conc.err);
        ret;
    }
    val conc: *type.TypeId = res_conc.ok;
    fin { A.deallocate[type.TypeId](q.types.a, conc, args_len::usize); }

    i = 0;
    for (i < args_len) {
        conc[i] = subst.apply_or_self(q, raw[i], u.who, u.args, u.arg_len);
        i       = i + 1;
    }
    if (q.nested) { ret; }

    walk_nominal(c, gnom, conc, args_len);
}

fun walk_nominal(c: *Check, nom: type.TypeId, args: *type.TypeId, arg_len: u32) {
    val q:       *type_query.Query = c.q;
    val opt_nom: opt[*type.Type]   = type.get(q.types, nom);
    if (!sel opt_nom.some) {
        report_unprovable(c, nom);
        ret;
    }
    val nom_kind: type.TypeKind         = opt_nom.some.kind;
    val opt_tab:  opt[*type.FieldTable] = type.field_table_for(q.types, nom);
    if (!sel opt_tab.some) {
        report_unprovable(c, nom);
        ret;
    }
    val fields_len: u32 = opt_tab.some.fields_len;

    var a:       *type.TypeId = args;
    var n:       u32          = arg_len;
    val generic: bool         = mention.has_param(q, nom);
    if (!generic) {
        a = nil;
        n = 0;
    }

    val key: type.TypeId = visit_key(q, nom, a, n);
    if (!type_query.scan_fresh(q, ?c.w.nominals, key)) { ret; }

    # a non-generic nominal walks its fields with no arguments, under no owner
    var who: type.GenericOwner;
    if (generic) {
        val who_opt: opt[type.GenericOwner] = mention.owner(q, nom);
        if (!sel who_opt.some) {
            report_unprovable(c, key);
            ret;
        }
        who = who_opt.some;
    }

    if (generic && nom_kind == type.TYPE_UNI) { check_variants(c, nom, ?who, a, n, key); }

    var f: u32 = 0;
    for (f < fields_len) {
        val e_opt: opt[*type.FieldEntry] = type.field_at(q.types, nom, f);
        if (!sel e_opt.some) {
            report_unprovable(c, key);
            ret;
        }
        walk_under(c, e_opt.some.ty, ?who, a, n, key);
        f = f + 1;
    }
}

# the one report a type draws, at the first annotation that reaches it
fun report_unbounded(c: *Check, tid: type.TypeId) {
    if (!sema_context.uni_report_mark(c.sc.typing.uni_reports, tid)) { ret; }
    sema_context.report(c.sc, diagnostic_kind.SECRET_VARIANT_UNPROVABLE, c.span, "cannot prove that every generic union this type reaches has variants agreeing on secrecy - it reaches them through a generic whose argument grows through a pointer, so the unions are instantiated unboundedly many ways");
}

fun report_unprovable(c: *Check, key: type.TypeId) {
    if (!sema_context.uni_report_mark(c.sc.typing.uni_reports, key)) { ret; }
    sema_context.report(c.sc, diagnostic_kind.SECRET_VARIANT_UNPROVABLE, c.span, "cannot prove that every generic union this type reaches has variants agreeing on secrecy - its field layout is unavailable or its type graph is too large");
}

fun check_variants(c: *Check, nom: type.TypeId, who: *type.GenericOwner, args: *type.TypeId, arg_len: u32,
    key: type.TypeId) {
    val sc: *sema_context.SemaContext = c.sc;
    val q:  *type_query.Query         = c.q;

    val opt_tab: opt[*type.FieldTable] = type.field_table_for(q.types, nom);
    if (!sel opt_tab.some) {
        report_unprovable(c, key);
        ret;
    }
    val fields_len: u32 = opt_tab.some.fields_len;
    if (fields_len < 2) { ret; }

    var i: u32 = 0;
    for (i < fields_len) {
        val vi: opt[type.TypeId] = variant_at(q, nom, i, who, args, arg_len);
        if (q.nested) { ret; }
        if (!sel vi.some) {
            report_unprovable(c, key);
            ret;
        }
        if (mention.mentioned(q, vi.some)) { ret; }
        i = i + 1;
    }

    # agreement is pairwise over the bytes each pair shares, so no variant stands in for the rest
    i = 1;
    for (i < fields_len) {
        val vi: opt[type.TypeId] = variant_at(q, nom, i, who, args, arg_len);
        var j:  u32              = 0;
        for (j < i) {
            val vj: opt[type.TypeId] = variant_at(q, nom, j, who, args, arg_len);
            if (sel vi.some) {
                if (sel vj.some) {
                    val agreement: res[secrecy.Agreement, fail.Fail] = secrecy.overlay_agrees(sc.s, sema_context.machine_of(sc), vj.some, vi.some);
                    if (sel agreement.err) {
                        type_query.inherit(q, agreement.err);
                        ret;
                    }
                    if (agreement.ok == secrecy.UNDECIDABLE) {
                        if (sema_context.uni_report_mark(sc.typing.uni_reports, key)) {
                            sema_context.report(sc, diagnostic_kind.SECRET_VARIANT_UNPROVABLE, c.span, secrecy.UNBOUNDED_VARIANTS_MSG);
                        }
                        ret;
                    }
                    if (agreement.ok == secrecy.DISAGREE) {
                        if (sema_context.uni_report_mark(sc.typing.uni_reports, key)) {
                            sema_context.report(sc, diagnostic_kind.SECRET_VARIANT_MISMATCH, c.span, "union variants must agree on secrecy: this instantiation makes overlapping fields part secret `^` and part public, which would alias the same storage at two classifications");
                        }
                        ret;
                    }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fun variant_at(q: *type_query.Query, nom: type.TypeId, i: u32, who: *type.GenericOwner, args: *type.TypeId,
    arg_len: u32) opt[type.TypeId] {
    val e_opt: opt[*type.FieldEntry] = type.field_at(q.types, nom, i);
    if (!sel e_opt.some) { ret opt[type.TypeId].none{}; }
    val ty: type.TypeId = subst.apply_or_self(q, e_opt.some.ty, who, args, arg_len);
    if (q.nested) { ret opt[type.TypeId].none{}; }
    ret opt[type.TypeId].some{ty};
}

fun visit_key(q: *type_query.Query, nom: type.TypeId, args: *type.TypeId, arg_len: u32) type.TypeId {
    if (args == nil || arg_len == 0) { ret nom; }

    val opt_nom: opt[*type.Type] = type.get(q.types, nom);
    if (!sel opt_nom.some) { ret nom; }
    val t: *type.Type = opt_nom.some;
    if (t.kind != type.TYPE_REC && t.kind != type.TYPE_UNI && t.kind != type.TYPE_TAG) { ret nom; }

    val r: res[type.TypeId, fail.Fail] = type.intern_instance(q.types, nom, args, arg_len);
    if (sel r.err) {
        type_query.failed(q, r.err);
        ret nom;
    }
    ret r.ok;
}
