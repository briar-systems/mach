use lang_alloc: mach.lang.alloc;
use A:          std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_region_equals;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use mach.lang.fe.attr;
use sema_context: mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.type;

pub val DIRECTIVE: str = "abi_type";
val     ARG_COUNT: u32 = 1;

pub def ReadStatus: u8;
pub val READ_OK:      ReadStatus = 0;
val     READ_REFUSED: ReadStatus = 1;

rec Read {
    status: ReadStatus;
    tag:    u32;
    size:   u32;
    align:  u32;
}

fun decorator_is(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, name: str) bool {
    ret str_region_equals(sc.source, dec.name.offset, dec.name.len, name);
}

fun decorator_of(sc: *sema_context.SemaContext, d: *ast_decl.Decl) *ast_decl.Decorator {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (decorator_is(sc, dec, DIRECTIVE)) { ret dec; }
        i = i + 1;
    }
    ret nil;
}

pub fun declares_abi_type(sc: *sema_context.SemaContext, d: *ast_decl.Decl) bool {
    if (d.kind != ast_decl.DECL_KIND_DEF)  { ret false; }
    if (d.data.def_.ty != ast_id.TYPE_NIL) { ret false; }
    ret decorator_of(sc, d) != nil;
}

fun arg_expr(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, index: u32) *ast_expr.Expr {
    if (index >= dec.args_len) { ret nil; }
    val opt_e: opt[*ast_expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start + index]);
    if (!sel opt_e.some) { ret nil; }
    ret opt_e.some;
}

pub fun read(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator, report: bool) Read {
    var out: Read;
    out.status = READ_REFUSED;
    out.tag    = 0;
    out.size   = 0;
    out.align  = 0;

    if (d.kind != ast_decl.DECL_KIND_DEF) {
        if (report) { sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`abi_type` decorator applies only to a `def` declaration: `def` is the form that means a name denotes a type and promises no fields and no storage, which is exactly what an ABI type is"); }
        ret out;
    }
    if (d.data.def_.ty != ast_id.TYPE_NIL) {
        if (report) { sema_context.report(sc, diagnostic_kind.ABI_TYPE_HAS_BODY, dec.name, "an `abi_type` declaration has no body: the selected target supplies the layout, so `def Name;` declares it and `def Name: T;` is an ordinary alias"); }
        ret out;
    }
    if (dec.args_len != ARG_COUNT) {
        if (report) { sema_context.report(sc, diagnostic_kind.DECORATOR_ARITY, dec.name, "`abi_type` decorator takes exactly one string argument: the name of the C type whose layout the target declares"); }
        ret out;
    }

    val name_e: *ast_expr.Expr = arg_expr(sc, dec, 0);
    if (name_e == nil) { ret out; }
    var name: opt[str] = attr.string_of(sc.s, sc.own_module, sc.a, dec, 0);
    if (report) {
        name = sema_context.attr_string_arg(sc, dec, 0, diagnostic_kind.DECORATOR_ARGUMENT,
            "the `abi_type` decorator's argument must be a string: it is matched against the C types the target declares");
    }
    if (sel name.none) { ret out; }

    if (!str_equals(name.some, "va_list")) {
        if (report) { sema_context.report(sc, diagnostic_kind.ABI_TYPE_UNKNOWN, name_e.span, "no such ABI type; `va_list` is the only C type whose layout a target declares"); }
        ret out;
    }

    if (sc.ctx.env.va_list_size == 0) {
        if (report) { sema_context.report(sc, diagnostic_kind.ABI_TYPE_UNAVAILABLE, name_e.span, "the selected target declares no `va_list` layout: `va_list` is part of a platform's C ABI and this platform has none, so there is nothing to bind. a target that runs C declares the size and alignment its psABI gives the type"); }
        ret out;
    }

    out.status = READ_OK;
    out.tag    = type.ABI_TYPE_VA_LIST;
    out.size   = sc.ctx.env.va_list_size;
    out.align  = sc.ctx.env.va_list_align;
    ret out;
}

pub fun validate(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    read(sc, d, dec, true);
}

pub fun type_of(sc: *sema_context.SemaContext, d: *ast_decl.Decl) type.TypeId {
    val dec: *ast_decl.Decorator = decorator_of(sc, d);
    if (dec == nil) { ret type.TYPE_ERROR; }

    val r: Read = read(sc, d, dec, false);
    if (r.status == READ_REFUSED) { ret type.TYPE_ERROR; }

    val outcome: res[type.TypeId, fail.Fail] =
        type.intern_abi_type(?sc.s.types, intern_name(sc, d.data.def_.name), r.tag, r.size, r.align);
    if (sel outcome.err) {
        fail.internal(?sc.status, fail.describe(outcome.err));
        ret type.TYPE_ERROR;
    }
    ret outcome.ok;
}

fun intern_name(sc: *sema_context.SemaContext, span: token.Span) intern.StrId {
    if (span.len == 0) { ret intern.STR_NIL; }
    val r: res[intern.StrId, A.Error] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (sel r.err) {
        fail.internal(?sc.status, lang_alloc.text(r.err));
        ret intern.STR_NIL;
    }
    ret r.ok;
}

pub fun exclusion_message() str {
    ret "a `va_list` cannot be read, constructed, or stored in mach: it is an opaque token a C caller hands over and mach hands on, and reading one needs `va_arg`, which mach does not have and cannot have without runtime variadics. receive it as a parameter and pass it to the C function that consumes it";
}
