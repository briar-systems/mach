# checking each decorator against its declaration: its places, arguments and rule
use lang_alloc:      mach.lang.alloc;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use ast_stmt: mach.lang.fe.ast.stmt;
use mach.lang.fe.decorator;
use mach.lang.fe.expect;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.abitype;
use sema_context:  mach.lang.fe.sema.context;
use sema_declared: mach.lang.fe.sema.declared;
use mach.lang.fe.sema.guard;
use sema_handle: mach.lang.fe.sema.handle;
use mach.lang.fe.sema.infer;
use sema_op: mach.lang.fe.sema.op;
use mach.lang.module;
use lang_source: mach.lang.source;
use mach.lang.stack;
use mach.lang.target.extension;
use target_model: mach.lang.target.model;
use mach.lang.textbuild;
use mach.lang.type;
use A: std.allocator;
use std.text.string.str_dup_range;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub fun infer_decorator_args(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        var ii:  u32                 = 0;
        for (ii < dec.args_len && !decorator.flagged(dec.id, decorator.FLAG_WORDS)) {
            if (!sema_handle.arg_is_type(sc, dec, ii)) {
                infer.infer_expr(sc, sc.view.a.expr_ids.data[dec.args_start + ii]);
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

pub fun validate_decorators(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    val places: decorator.Places = decorator.places_of(d);
    var i:      u32              = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        if (validate_decorator_row(sc, dec, places, d.decorators_start, i)) { validate_decorator_rule(sc, d, dec); }
        i = i + 1;
    }
    validate_no_inline_conflict(sc, d);
    if (d.kind == ast_decl.DECL_KIND_TAG) { validate_case_decorators(sc, ?d.data.tag_); }
}

# a tag case's decorators answer to their rows alone: every rule a decorator adds
# shapes a symbol or a whole type
fun validate_case_decorators(sc: *sema_context.SemaContext, t: *ast_decl.DeclTag) {
    var i: u32 = 0;
    for (i < t.cases_len) {
        val c: *ast_decl.TagCase = ?sc.view.a.tag_cases.data[t.cases_start + i];
        var j: u32               = 0;
        for (j < c.decorators_len) {
            validate_decorator_row(sc, ?sc.view.a.decorators.data[c.decorators_start + j], decorator.PLACE_CASE, c.decorators_start, j);
            j = j + 1;
        }
        i = i + 1;
    }
}

# holds `dec` to its registry row: the count and kind of its arguments, whether it
# stands somewhere in `places`, and whether it repeats among the `index` decorators
# before it from `start`. true when it stands where its row admits it, once
fun validate_decorator_row(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, places: decorator.Places, start: u32, index: u32) bool {
    val row: *decorator.Row = decorator.row(dec.id);
    if (row == nil) {
        report_decorator_listing(sc, diagnostic_kind.DECORATOR_UNKNOWN, dec.name, "unknown decorator; valid decorators are ", 0, decorator.PLACES_ANY, nil, "");
        ret false;
    }
    if (dec.args_len < row.args_min || dec.args_len > row.args_max) { sema_context.report(sc, diagnostic_kind.DECORATOR_ARITY, dec.name, row.arity); }
    or                                                              { validate_decorator_args(sc, dec, row); }
    # a decorator that refuses its own misplacement still refuses a tag case here
    val self_placed: bool = (row.flags & decorator.FLAG_PLACE_CHECKED) != 0 && places != decorator.PLACE_CASE;
    if ((row.places & places) == 0 && !self_placed) {
        if (places == decorator.PLACE_CASE) {
            report_decorator_listing(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "a tag case takes only the ", 0, decorator.PLACE_CASE, "or", " decorator");
        }
        or { sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, row.misplaced); }
        ret false;
    }
    if ((row.flags & decorator.FLAG_ONCE) != 0) {
        val prior: opt[*ast_decl.Decorator] = decorator.list_get(sc.view.a, start, index, dec.id);
        if (sel prior.some) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_DUPLICATE, dec.name, row.duplicate);
            ret false;
        }
    }
    ret true;
}

# the arguments its row checks: each string it records where the row checks them,
# and each integer, stopping at the first that is not one
fun validate_decorator_args(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, row: *decorator.Row) {
    var ord: u32 = 0;
    for (ord < dec.args_len) {
        if ((row.flags & decorator.FLAG_STRINGS_CHECKED) != 0 && decorator.takes_string(dec, ord)) {
            sema_context.decorator_string_arg(sc, dec, ord, diagnostic_kind.DECORATOR_ARGUMENT, row.argument);
        }
        ord = ord + 1;
    }
    ord = 0;
    for (ord < dec.args_len && ord < 32) {
        if (((row.integers >> ord) & 1) != 0 && !require_integer_arg(sc, dec, ord, row.argument)) { brk; }
        ord = ord + 1;
    }
}

# reports `prefix`, the names of the rows carrying `flags` that stand in `places`
# as `decorator.names_append` lists them, then `suffix`
fun report_decorator_listing(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, at: lang_source.Span, prefix: str,
    flags: decorator.Flags, places: decorator.Places, conjunction: str, suffix: str) {
    var b: textbuild.TextBuilder = textbuild.tb_init(sc.s.alloc);
    fin { textbuild.tb_dnit(?b); }
    val head:   err[textbuild.Error] = textbuild.tb_append(?b, prefix);
    var failed: bool                 = sel head.err;
    if (!failed) {
        val names: err[textbuild.Error] = decorator.names_append(?b, flags, places, conjunction);
        failed = sel names.err;
    }
    if (!failed) {
        val tail: err[textbuild.Error] = textbuild.tb_append(?b, suffix);
        failed = sel tail.err;
    }
    if (failed) {
        fail.internal(?sc.status, "a decorator listing could not be built");
        ret;
    }
    val text: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    if (sel text.err) {
        fail.internal(?sc.status, textbuild.text(text.err));
        ret;
    }
    sema_context.report(sc, k, at, text.ok);
    str_free(sc.s.alloc, text.ok);
}

fun validate_no_inline_conflict(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    var has_inline:    bool = false;
    var has_noinline:  bool = false;
    var noinline_span: lang_source.Span;
    var i:             u32  = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        if (dec.id == decorator.INLINE) { has_inline = true; }
        if (dec.id == decorator.NOINLINE) {
            has_noinline  = true;
            noinline_span = dec.name;
        }
        i = i + 1;
    }
    if (has_inline && has_noinline) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, noinline_span, "`inline` and `noinline` decorators cannot both apply to the same function");
    }
}

# an integer argument: of an integer type and a constant expression
fun require_integer_arg(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32, kind_msg: str) bool {
    val eid: ast_id.ExprId = sc.view.a.expr_ids.data[dec.args_start + ord];
    if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, eid))) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, dec.name, kind_msg);
        ret false;
    }
    sema_context.require_constant_arg(sc, dec, ord);
    ret true;
}

# a workgroup dimension is an integer constant or names a `#[spec]` var, whose value the
# host supplies at pipeline creation. a var another module declares is held to that by
# the back end, which sees its role
fun validate_workgroup_dim(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32) bool {
    val eid:     ast_id.ExprId        = sc.view.a.expr_ids.data[dec.args_start + ord];
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (sel opt_sym.some) {
        val sym:    *resolve.Symbol = opt_sym.some;
        val own:    bool            = sym.kind == resolve.SYM_VAR;
        val import: bool            = sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_VAR;
        if (own || import) {
            if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, eid))) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, dec.name, "`workgroup` decorator dimensions must be integers");
                ret false;
            }
            if (own && module.same(sym.origin, sc.view.own_module)) {
                val opt_d: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
                if (sel opt_d.some && !decorator.has(sc.view.a, opt_d.some, decorator.SPEC)) {
                    sema_context.report(sc, diagnostic_kind.DECORATOR_NOT_CONSTANT, sema_context.decorator_arg_span(sc, eid, dec.name), "a `workgroup` dimension that is not a constant must name a `#[spec(id)]` var, whose value the host supplies at pipeline creation; any other variable has no value when the pipeline is built");
                    ret false;
                }
            }
            ret true;
        }
    }
    ret require_integer_arg(sc, dec, ord, "`workgroup` decorator dimensions must be integer comptime expressions or `#[spec]` vars");
}

# a shader interface binding carries one role, and its initializer follows that role
fun validate_iface_role(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.count_flagged(sc.view.a, d, decorator.FLAG_ROLE) > 1) {
        report_decorator_listing(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "a shader interface variable carries exactly one role; ",
            decorator.FLAG_ROLE, decorator.PLACES_ANY, "and", " are mutually exclusive");
    }
    validate_iface_init(sc, d, dec);
}

# the one rule for an initializer on an interface binding, per role: a `#[spec]` var's is
# the default it requires, an output's is the value it starts at, and every other role's
# value is supplied by the host, the pipeline or the stage, so an initializer is refused
fun validate_iface_init(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val has: bool = !ast_id.expr_is_nil(d.data.bind.init);
    if (dec.id == decorator.SPEC) {
        if (!has) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "a `#[spec(id)]` var needs an initializer: it is the default the pipeline keeps when the host supplies no value for the id");
        }
        ret;
    }
    if (!has) { ret; }
    var why: str = nil;
    if (dec.id == decorator.INPUT) {
        why = "an `#[input]` variable cannot have an initializer: the previous stage or the vertex input supplies its value, so the written one would never be what the shader reads";
    }
    or (dec.id == decorator.BUILTIN && !builtin_is_output(sc, dec)) {
        why = "an input `#[builtin]` cannot have an initializer: the pipeline supplies its value, so the written one would never be what the shader reads";
    }
    or (dec.id == decorator.UNIFORM || dec.id == decorator.STORAGE || dec.id == decorator.SAMPLER) {
        why = "a descriptor-bound `#[uniform]` / `#[storage]` / `#[sampler]` variable cannot have an initializer: the host binds its memory, so the written value would never be what the shader sees";
    }
    or (dec.id == decorator.PUSH) {
        why = "a `#[push]` block cannot have an initializer: the host supplies it with the command that records the dispatch or draw, so the written value would never be what the shader sees";
    }
    or (dec.id == decorator.SHARED) {
        why = "a `#[shared]` variable cannot have an initializer: workgroup memory is zero when a compute stage starts, and no one invocation owns it to write any other value first. assign it inside the stage";
    }
    if (why != nil) { sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, why); }
}

# the built-ins a stage writes rather than reads; an unknown or unreadable one is left to
# the built-in check
fun builtin_is_output(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) bool {
    if (dec.args_len != 1) { ret true; }
    val v: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    if (sel v.none) { ret true; }
    ret str_equals(v.some, "position") || str_equals(v.some, "point_size");
}

fun validate_builtin_value(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, value: opt[str]) {
    if (sel value.none) { ret; }
    val v: str = value.some;
    if (str_equals(v, "position"))               { ret; }
    if (str_equals(v, "vertex_index"))           { ret; }
    if (str_equals(v, "instance_index"))         { ret; }
    if (str_equals(v, "frag_coord"))             { ret; }
    if (str_equals(v, "point_size"))             { ret; }
    if (str_equals(v, "global_invocation"))      { ret; }
    if (str_equals(v, "local_invocation"))       { ret; }
    if (str_equals(v, "workgroup_id"))           { ret; }
    if (str_equals(v, "num_workgroups"))         { ret; }
    if (str_equals(v, "local_invocation_index")) { ret; }
    if (str_equals(v, "subgroup_size"))          { ret; }
    if (str_equals(v, "subgroup_invocation"))    { ret; }
    if (str_equals(v, "subgroup_id"))            { ret; }
    if (str_equals(v, "num_subgroups"))          { ret; }
    sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start], dec.name), "unknown built-in; `builtin` accepts \"position\", \"vertex_index\", \"instance_index\", \"frag_coord\", \"point_size\", \"global_invocation\", \"local_invocation\", \"workgroup_id\", \"num_workgroups\", \"local_invocation_index\", \"subgroup_size\", \"subgroup_invocation\", \"subgroup_id\", or \"num_subgroups\"");
}

fun validate_stage_value(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, value: opt[str]) {
    if (sel value.none) { ret; }
    val v: str = value.some;
    if (str_equals(v, "vertex"))   { ret; }
    if (str_equals(v, "fragment")) { ret; }
    if (str_equals(v, "compute"))  { ret; }
    sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start], dec.name), "unknown pipeline stage; `stage` accepts \"vertex\", \"fragment\", or \"compute\"");
}

fun validate_storage_quals(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) {
    var readonly:  bool = false;
    var writeonly: bool = false;
    var i:         u32  = 2;
    for (i < dec.args_len) {
        val qual: opt[str] = sema_context.decorator_string_arg(sc, dec, i, diagnostic_kind.DECORATOR_ARGUMENT,
            "a `storage` memory qualifier must be a string; `storage` takes the descriptor set and binding followed by qualifiers, as in `#[storage(0, 3, \"readonly\")]`");
        if (sel qual.none) {
            i = i + 1;
            cnt;
        }
        val at: lang_source.Span = expect.arg_span(sc.view.a, sc.view.a.expr_ids.data[dec.args_start + i], dec.name);
        if (str_equals(qual.some, "readonly"))  { readonly = true; }
        or (str_equals(qual.some, "writeonly")) { writeonly = true; }
        or (!str_equals(qual.some, "coherent")) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, at,
                "unknown `storage` memory qualifier; `storage` accepts \"readonly\", \"writeonly\", or \"coherent\"");
        }
        if (readonly && writeonly) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, at,
                "`\"readonly\"` and `\"writeonly\"` together declare a binding that no stage reads or writes; keep the one that says how the binding is used");
            readonly  = false;
            writeonly = false;
        }
        i = i + 1;
    }
}

fun decorator_arg_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type.TypeId {
    if (ast_id.expr_is_nil(eid))                              { ret type.TYPE_ERROR; }
    if (ast_id.expr_index(eid)::usize >= sc.view.a.exprs.len) { ret type.TYPE_ERROR; }
    ret sc.view.expr_type[ast_id.expr_index(eid)];
}

# the rule a decorator adds to its row, keyed by its id; a decorator its row holds
# entirely adds none
fun validate_decorator_rule(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val id: decorator.Id = dec.id;
    if (id == decorator.SPEC && d.kind == ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`spec` decorator applies only to a module-level `var`: the host supplies a specialization constant's value at pipeline creation, so it is no compile-time constant and a `val` would promise one");
        ret;
    }
    if (id == decorator.SHARED && d.kind == ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`#[shared]` applies to a `var`: workgroup memory is written by the stage, and a `val` of it would only ever read zero");
        ret;
    }
    if (decorator.flagged(id, decorator.FLAG_ROLE)) { validate_iface_role(sc, d, dec); }
    if (id == decorator.TESTING)                    { validate_testing(sc, d, dec); }
    or (id == decorator.EXPECT)                     { validate_expect(sc, dec); }
    or (id == decorator.ALIGN)                      { validate_align(sc, d, dec); }
    or (id == decorator.STAGE)                      { validate_stage_value(sc, dec, decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0)); }
    or (id == decorator.WORKGROUP)                  { validate_workgroup(sc, d, dec); }
    or (id == decorator.BUILTIN)                    { validate_builtin_value(sc, dec, decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0)); }
    or (id == decorator.STORAGE)                    { validate_storage_quals(sc, dec); }
    or (id == decorator.PACKED)                     { validate_packed(sc, d, dec); }
    or (id == decorator.NAKED)                      { validate_naked(sc, d, dec); }
    or (id == decorator.EXTENSIONS)                 { validate_extensions(sc, d, dec); }
    or (id == decorator.OP)                         { sema_op.validate_op(sc, d, dec); }
    or (id == decorator.HANDLE)                     { sema_handle.validate(sc, d, dec); }
    or (id == decorator.ABI_TYPE)                   { abitype.validate(sc, d, dec); }
}

# an `align` on a function or a global is decided here; a type's is decided with its layout
fun validate_align(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (dec.args_len == 1 && sema_context.is_fun_or_global(d.kind)) { sema_declared.declared_align(sc, d); }
}

# a workgroup sizes a compute stage, each dimension an integer or a `#[spec]` var
fun validate_workgroup(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    var wi: u32 = 0;
    for (dec.args_len == 3 && wi < 3) {
        if (!validate_workgroup_dim(sc, dec, wi)) { brk; }
        wi = wi + 1;
    }
    if (!decorator.has(sc.view.a, d, decorator.STAGE)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "`workgroup` decorator requires a `#[stage(\"compute\")]` on the same function; it sizes a compute stage's workgroup and means nothing without one");
    }
}

fun validate_packed(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.has(sc.view.a, d, decorator.UNIFORM) || decorator.has(sc.view.a, d, decorator.STORAGE) || decorator.has(sc.view.a, d, decorator.PUSH)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name,
            "`packed` cannot apply to a `uniform` / `storage` / `push` interface block: its member offsets are fixed by the std140 / std430 layout rules and emitted as explicit Offset decorations, which packing would contradict");
    }
}

# `#[testing]` confines references to test code, which neither an `ext` declaration
# nor a decorator naming a consumer outside Mach source lets it follow
fun validate_testing(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`testing` cannot apply to an `ext` declaration: its definition and callers live outside Mach source, where test-only confinement cannot follow them");
    }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val other: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        i = i + 1;
        if (!decorator.flagged(other.id, decorator.FLAG_TESTING_EXCLUSIVE)) { cnt; }
        sema_context.reportf(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name,
            "`testing` cannot combine with `{}`: it names a consumer outside Mach source, where test-only confinement cannot follow it", decorator.name_of(other.id));
    }
}

# `#[expect("<key>", ...)]`: each argument names a warning key or family, as a
# string named once. an unknown key is refused, and so is one that covers only
# errors, since an error is never acknowledged
fun validate_expect(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) {
    var i: u32 = 0;
    for (i < dec.args_len) {
        val eid: ast_id.ExprId = sc.view.a.expr_ids.data[dec.args_start + i];
        val key: opt[str]      = sema_context.decorator_string_arg(sc, dec, i, diagnostic_kind.DECORATOR_ARGUMENT, "`expect` key must be a string");
        if (sel key.some) {
            val at:     lang_source.Span          = expect.arg_span(sc.view.a, eid, dec.name);
            var picked: diagnostic_kind.Selection = diagnostic_kind.select(key.some);
            var dup:    bool                      = false;
            var j:      u32                       = 0;
            for (!dup && j < i) {
                val prior: opt[str] = expect.key_of(sc.s, sc.view.ctx, sc.view.a.expr_ids.data[dec.args_start + j]);
                if (sel prior.some && str_equals(prior.some, key.some)) { dup = true; }
                j = j + 1;
            }
            if (diagnostic_kind.selection_unknown(?picked)) {
                sema_context.reportf(sc, diagnostic_kind.EXPECT_UNKNOWN_KEY, at,
                    "`{}` is not a warning key: `expect` names a key or a family of keys from the diagnostic kind table, such as `vector.scalarize` or `vector`", key.some);
            }
            or (diagnostic_kind.selection_empty(?picked)) {
                sema_context.reportf(sc, diagnostic_kind.EXPECT_ERROR_KEY, at, "`{}` names an error, and an error is never acknowledged", key.some);
            }
            or (dup) {
                sema_context.reportf(sc, diagnostic_kind.EXPECT_DUPLICATE_KEY, at, "`expect` names `{}` twice", key.some);
            }
        }
        i = i + 1;
    }
}

# `#[extensions(name, ...)]`: a function whose body may use extensions the target
# does not select. each argument is a bare extension name some isa declares,
# listed once, and never one only a target selects; the caller's run-time
# check is its own contract, never enforced
fun validate_extensions(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (ast_id.stmt_is_nil(d.data.fun_.body) || (d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`extensions` decorator applies only to a function with a body");
        ret;
    }
    val vocabulary: *extension.Vocabulary = ?sc.view.ctx.env.target.vocabulary;
    var i:          u32                   = 0;
    for (i < dec.args_len) {
        val eid:   ast_id.ExprId       = sc.view.a.expr_ids.data[dec.args_start + i];
        val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
        if (!sel e_opt.some) { ret; }
        val e: *ast_expr.Expr = e_opt.some;
        if (e.kind != ast_expr.EXPR_KIND_IDENT) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, e.span, "`extensions` decorator arguments are bare extension names, as in `#[extensions(sha, ssse3)]`");
            ret;
        }
        val tok:  lang_source.Span = e.data.ident.tok;
        val name: str              = (sc.view.source::usize + tok.offset::usize)::str;
        var j:    u32              = 0;
        for (j < i) {
            val prior: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, sc.view.a.expr_ids.data[dec.args_start + j]);
            if (sel prior.some) {
                val pe: *ast_expr.Expr = prior.some;
                if (pe.kind == ast_expr.EXPR_KIND_IDENT && guard.span_text_equal(sc, pe.data.ident.tok, tok)) {
                    sema_context.report(sc, diagnostic_kind.EXTENSION_DUPLICATE, e.span, "`extensions` decorator names this extension twice");
                    ret;
                }
            }
            j = j + 1;
        }
        if (vocabulary.len > 0) {
            val found: target_model.DecoratorExtension = target_model.decorator_extension(vocabulary, sc.view.ctx.env.target.extensions, name, tok.len::usize);
            if (!found.known) {
                report_unknown_extension(sc, e.span, vocabulary, name, tok.len::usize);
                ret;
            }
            if (found.target_only != nil) {
                report_target_only_extension(sc, e.span, name, tok.len::usize, found.target_only);
                ret;
            }
        }
        i = i + 1;
    }
}

# the extension name the decorator spells, `len` bytes at `name`, as an owned text; a
# refusal fails the phase as an internal failure and gives none
fun extension_spelled(sc: *sema_context.SemaContext, name: str, len: usize) opt[str] {
    val copied: res[str, A.Error] = str_dup_range(sc.s.alloc, name, 0, len);
    if (sel copied.err) {
        fail.internal(?sc.status, lang_alloc.text(copied.err));
        ret opt[str].none{};
    }
    ret opt[str].some{copied.ok};
}

fun report_target_only_extension(sc: *sema_context.SemaContext, at: lang_source.Span, name: str, len: usize, why: str) {
    val spelled: opt[str] = extension_spelled(sc, name, len);
    if (sel spelled.none) { ret; }
    fin { str_free(sc.s.alloc, spelled.some); }
    sema_context.reportf(sc, diagnostic_kind.EXTENSION_TARGET_ONLY, at,
        "`extensions` decorator: `{}` is not a function's to admit, {}; select it with the target's `extensions` or isa string",
        spelled.some, why);
}

fun report_unknown_extension(sc: *sema_context.SemaContext, at: lang_source.Span, vocabulary: *extension.Vocabulary, name: str, len: usize) {
    val known: res[str, fail.Fail] = target_model.vocabulary_names(sc.s.alloc, vocabulary);
    if (sel known.err) {
        fail.internal(?sc.status, fail.describe(known.err));
        ret;
    }
    fin { str_free(sc.s.alloc, known.ok); }
    val spelled: opt[str] = extension_spelled(sc, name, len);
    if (sel spelled.none) { ret; }
    fin { str_free(sc.s.alloc, spelled.some); }
    sema_context.reportf(sc, diagnostic_kind.EXTENSION_UNKNOWN, at,
        "`extensions` decorator: no instruction set declares an extension `{}`; the known extensions are: {}",
        spelled.some, known.ok);
}

fun validate_naked(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.has(sc.view.a, d, decorator.INLINE)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`naked` and `inline` decorators are mutually exclusive; a naked function cannot be inlined");
    }
    if (decorator.has(sc.view.a, d, decorator.OBLIVIOUS)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`naked` and `oblivious` decorators are mutually exclusive; a naked body is inline asm, which `oblivious` forbids");
    }
    if (ast_id.stmt_is_nil(d.data.fun_.body)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`naked` decorator applies only to a function with a body");
        ret;
    }
    check_naked_body(sc, d.data.fun_.body);
}

fun check_naked_body(sc: *sema_context.SemaContext, sid: ast_id.StmtId) {
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (!sel opt_stmt.some) { ret; }
    val s: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted()) {
        sema_context.refuse_nesting(sc, s.span);
        ret;
    }

    if (s.kind == ast_stmt.STMT_KIND_ASM) { ret; }

    if (s.kind == ast_stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            check_naked_body(sc, sc.view.a.stmt_ids.data[s.data.block.stmts_start + i]);
            i = i + 1;
        }
        ret;
    }

    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches.data[s.data.comptime_if.branches_start + b];
            var i:  u32                      = 0;
            for (i < br.body_len) {
                check_naked_body(sc, sc.view.a.stmt_ids.data[br.body_start + i]);
                i = i + 1;
            }
            b = b + 1;
        }
        ret;
    }

    sema_context.report(sc, diagnostic_kind.NAKED_BODY, s.span, "a `naked` function's body may contain only inline `asm` statements");
}
