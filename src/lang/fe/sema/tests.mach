}

fun ut_sema_error_free(src: str) bool {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret false; }
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret false; }
    val root: str = R.unwrap_ok[str, str](root_r);
    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret false; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) { driver.dnit_project(?p); session.dnit(?s); ret false; }
    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;
    val r: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (R.is_ok[context.SemaResult, fail.Fail](r)) {
        var res: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r);
        sema.dnit_result(?res);
    }
    var clean: bool = true;
    var di: usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        val d_r: R.Result[*diagnostic.Diagnostic, str] = diagnostic.get(?s.diags, di);
        if (R.is_ok[*diagnostic.Diagnostic, str](d_r) && R.unwrap_ok[*diagnostic.Diagnostic, str](d_r).severity == diagnostic.SEVERITY_ERROR) { clean = false; }
        di = di + 1;
    }
    driver.dnit_project(?p);
    session.dnit(?s);
    ret clean;
}

test "mach.lang.fe.sema.infer:address_of_refuses_every_rvalue_kind_and_names_it" {
    var bad: i32 = 0;
    val head: str = "rec P { x: i64; }\nfun f() i64 { ret 1; }\nfun g() P { var p: P; p.x = 1; ret p; }\nfun h() [2]i64 { var a: [2]i64; ret a; }\n";
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *i64 = ?f(); ret 0; }\n"), "cannot take the address of a call result")) { bad = 1; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *i64 = ?1; ret 0; }\n"), "cannot take the address of a literal")) { bad = 2; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *str = ?\"s\"; ret 0; }\n"), "cannot take the address of a literal")) { bad = 3; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val x: i32 = 1; val p: *i64 = ?(x::i64); ret 0; }\n"), "cannot take the address of a cast result")) { bad = 4; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val x: i64 = 1; val p: *i64 = ?(x + 1); ret 0; }\n"), "cannot take the address of an operator result")) { bad = 5; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *[2]i64 = ?[2]i64{1, 2}; ret 0; }\n"), "cannot take the address of an array literal")) { bad = 6; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *P = ?P{ x: 1 }; ret 0; }\n"), "cannot take the address of a record literal")) { bad = 7; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *i64 = ?g().x; ret 0; }\n"), "cannot take the address of a field of a call result")) { bad = 8; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *i64 = ?h()[0]; ret 0; }\n"), "cannot take the address of an element of a call result")) { bad = 9; }
    if (!ut_sema_diag_has(ut_cc3_static(head, "fun main() i64 { val p: *i64 = ?f(); ret 0; }\n"), "`?` applies to a place")) { bad = 10; }
    ret bad;
}

test "mach.lang.fe.sema.infer:address_of_accepts_bindings_fields_elements_dereferences_and_pointer_bases" {
    var bad: i32 = 0;
    val head: str = "rec P { x: i64; }\nfun pp(q: *P) *P { ret q; }\n";
    if (!ut_sema_error_free(ut_cc3_static(head, "fun main() i64 { var x: i64 = 1; val p: *i64 = ?x; ret @p; }\n"))) { bad = 1; }
    if (!ut_sema_error_free(ut_cc3_static(head, "fun main() i64 { var r: P; val p: *i64 = ?r.x; ret @p; }\n"))) { bad = 2; }
    if (!ut_sema_error_free(ut_cc3_static(head, "fun main() i64 { var a: [2]i64; val p: *i64 = ?a[0]; ret @p; }\n"))) { bad = 3; }
    if (!ut_sema_error_free(ut_cc3_static(head, "fun main() i64 { var r: P; val q: *P = ?r; val p: *i64 = ?q.x; ret @p; }\n"))) { bad = 4; }
    if (!ut_sema_error_free(ut_cc3_static(head, "fun main() i64 { var r: P; val q: *P = ?r; val p: *P = ?@q; ret 0; }\n"))) { bad = 5; }
    if (!ut_sema_error_free(ut_cc3_static(head, "fun main() i64 { var r: P; val p: *i64 = ?pp(?r).x; ret @p; }\n"))) { bad = 6; }
    ret bad;
}

fun t_substitution_internal_after_rejection(reject_first: bool, silent: bool) i32 {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?backing);
    if (R.is_err[session.Session, str](sr)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    val gp: R.Result[type.TypeId, str] = type.intern_generic_param(?s.types, intern.STR_NIL,
        type.TypeOwner{ module: 0, file: 1 }, 0::intern.StrId, type.TYPE_FUN, 0);
    if (R.is_err[type.TypeId, str](gp)) { ret 3; }
    var params: [1]type.TypeId;
    params[0] = R.unwrap_ok[type.TypeId, str](gp);
    val signature: R.Result[type.TypeId, str] = type.intern_function(?s.types, params[0], ?params[0], 1, false);
    if (R.is_err[type.TypeId, str](signature)) { ret 4; }
    val concrete: O.Option[type.TypeId] = type.prim(?s.types, type.TYPE_U32);
    if (O.is_none[type.TypeId](concrete)) { ret 5; }
    var args: [1]type.TypeId;
    args[0] = O.unwrap[type.TypeId](concrete);
    var a: ast.Ast = ast.init(?backing, 0);
    fin { ast.dnit(?a); }
    var sc: context.SemaContext;
    sc.s = ?s;
    sc.diags = ?s.diags;
    sc.a = ?a;
    sc.status = fail.accepted();
    sc.silent = false;
    sc.in_comptime_gate = false;
    sc.subst = ?args[0];
    sc.subst_len = 1;
    sc.subst_fn = generics.substitute;
    if (reject_first) {
        var span: token.Span;
        span.offset = 0;
        span.len = 1;
        context.report(?sc, span, "invalid user expression before substitution");
        if (!sel sc.status.kind.rejected) { ret 6; }
    }
    var refusing: T.Testing;
    if (O.is_some[str](T.make(?refusing))) { ret 7; }
    fin { T.dnit(?refusing); }
    T.fail_at_ordinal(?refusing, 1);
    sc.silent = silent;
    s.alloc = T.allocator_of(?refusing);
    val substituted: type.TypeId = context.apply_subst(?sc, R.unwrap_ok[type.TypeId, str](signature));
    s.alloc = ?backing;
    if (substituted != type.TYPE_ERROR) { ret 8; }
    if (!sel sc.status.kind.internal) { ret 9; }
    if (!outcome.is_internal(outcome.from_fail(fail.phase_failure(sc.status)))) { ret 10; }
    if (T.leaked(?refusing) || T.double_free_count(?refusing) != 0) { ret 11; }
    if (!str_equals(fail.status_text(sc.status), "out of memory")) { ret 12; }
    if (T.attempt_count(?refusing) != 1) { ret 13; }
    ret 0;
}

test "mach.lang.fe.sema:substitution_allocation_failure_dominates_user_rejection" {
    ret t_substitution_internal_after_rejection(true, false);
}

test "mach.lang.fe.sema:substitution_allocation_failure_without_diagnostic_is_internal" {
    ret t_substitution_internal_after_rejection(false, false);
}


test "mach.lang.fe.sema:primitive_type_scan_allocation_failure_is_internal" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?backing);
    if (R.is_err[session.Session, str](sr)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    val p: O.Option[type.TypeId] = type.prim(?s.types, type.TYPE_U32);
    if (O.is_none[type.TypeId](p) || s.types.visits_cap != 0) { ret 3; }
    var t: T.Testing;
    if (O.is_some[str](T.make(?t))) { ret 4; }
    fin { T.dnit(?t); }
    T.fail_at_ordinal(?t, 1);
    val original: *A.Allocator = s.types.a;
    s.types.a = T.allocator_of(?t);
    val r: R.Result[bool, str] = generics.contains_secret_deep(?s, O.unwrap[type.TypeId](p));
    s.types.a = original;
    if (R.is_ok[bool, str](r)) { ret 5; }
    if (!str_equals(R.unwrap_err[bool, str](r), "out of memory")) { ret 6; }
    if (T.attempt_count(?t) != 1 || T.leaked(?t) || T.double_free_count(?t) != 0) { ret 7; }
    ret 0;
}


test "mach.lang.fe.sema:substitution_allocation_failure_during_silent_probe_is_internal" {
    ret t_substitution_internal_after_rejection(false, true);
}

fun t_binding_outcome(mode: u8) i32 {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { val live: i64 = 1; ret missing + live; }\n";
    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 2; }
    val root: str = R.unwrap_ok[str, str](root_r);
    fin { fs.remove_all(?backing, root); }
    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fin { session.dnit(?s); }
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret 3; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    fin { driver.dnit_project(?p); }
    val m: *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || m.resolve_result == nil) { ret 4; }
    val rr: *resolve.ResolveResult = m.resolve_result;
    if (!sel rr.status.kind.rejected) { ret 5; }
    var rejected: id.ExprId = id.EXPR_NIL;
    var bound: id.ExprId = id.EXPR_NIL;
    var i: u32 = 0;
    for (i < rr.expr_count) {
        val eo: O.Option[*expr.Expr] = ast.get_expr(m.a, i::id.ExprId);
        if (O.is_some[*expr.Expr](eo) && O.unwrap[*expr.Expr](eo).kind == expr.EXPR_KIND_IDENT) {
            if (rr.expr_resolved[i] == resolve.SYMBOL_REJECTED) { rejected = i::id.ExprId; }
            or (rr.expr_resolved[i] < rr.symbol_count) { bound = i::id.ExprId; }
        }
        i = i + 1;
    }
    if (rejected == id.EXPR_NIL || bound == id.EXPR_NIL) { ret 6; }
    var sc: context.SemaContext;
    sc.s = ?s;
    sc.diags = ?s.diags;
    sc.a = m.a;
    sc.rr = rr;
    sc.expr_type = nil;
    sc.status = fail.accepted();
    sc.silent = mode == 2;
    sc.in_comptime_gate = false;
    var selected: id.ExprId = rejected;
    if (mode != 0) {
        rr.expr_resolved[bound] = resolve.SYMBOL_NIL;
        selected = bound;
        if (mode == 1) { fail.reject(?sc.status); }
    }
    if (infer.infer_expr(?sc, selected) != type.TYPE_ERROR) { ret 7; }
    if (mode == 0 && !sel sc.status.kind.rejected) { ret 8; }
    if (mode == 1 && (!sel sc.status.kind.internal
        || !str_equals(fail.status_text(sc.status), "internal: this identifier reached type inference unbound; the name resolver neither bound it nor reported it"))) { ret 9; }
    if (mode == 2 && !sel sc.status.kind.accepted) { ret 10; }
    ret 0;
}

test "mach.lang.fe.sema:resolver_rejected_identifier_keeps_its_source_outcome" {
    ret t_binding_outcome(0);
}

test "mach.lang.fe.sema:unvisited_identifier_after_unrelated_rejection_is_internal" {
    ret t_binding_outcome(1);
}

test "mach.lang.fe.sema:unvisited_identifier_during_gate_probe_is_deferred" {
    ret t_binding_outcome(2);
}
