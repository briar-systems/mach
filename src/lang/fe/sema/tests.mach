fun ut_cc3(alloc: *A.Allocator, a: str, b: str, c: str) str {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    val lc: usize = str_len(c);
    val r: R.Result[*u8, str] = A.allocate[u8](alloc, la + lb + lc + 1);
    if (R.is_err[*u8, str](r)) { ret a; }
    val buf: *u8 = R.unwrap_ok[*u8, str](r);
    var k: usize = 0;
    var j: usize = 0;
    for (j < la) { buf[k] = a[j]; k = k + 1; j = j + 1; }
    j = 0;
    for (j < lb) { buf[k] = b[j]; k = k + 1; j = j + 1; }
    j = 0;
    for (j < lc) { buf[k] = c[j]; k = k + 1; j = j + 1; }
    buf[k] = 0;
    ret buf::str;
}

fun ut_cc3_static(a: str, b: str) str {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret a; }
    ret ut_cc3(?backing, a, b, "");
}

fun ut_manifest() str {
    ret "[project]\nid = \"semaharness\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.semaharness]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/semaharness\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

fun ut_scaffold(alloc: *A.Allocator, names: *str, texts: *str, n: u32) R.Result[str, str] {
    val tf_r: R.Result[fs.TempFile, str] = fs.temp_create(alloc, "mach_sema_test");
    if (R.is_err[fs.TempFile, str](tf_r)) { ret R.err[str, str](R.unwrap_err[fs.TempFile, str](tf_r)); }
    var tf: fs.TempFile = R.unwrap_ok[fs.TempFile, str](tf_r);
    val dup_r: R.Result[str, str] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (R.is_err[str, str](dup_r)) { ret dup_r; }
    val root: str = R.unwrap_ok[str, str](dup_r);

    val d1: O.Option[str] = fs.create_dir_all(alloc, root, 493);
    if (O.is_some[str](d1)) { ret R.err[str, str](O.unwrap[str](d1)); }
    val src_dir: str = ut_cc3(alloc, root, "/", "src");
    val d2: O.Option[str] = fs.create_dir_all(alloc, src_dir, 493);
    if (O.is_some[str](d2)) { ret R.err[str, str](O.unwrap[str](d2)); }

    val mf: str = ut_cc3(alloc, root, "/", manifest.MANIFEST_FILE);
    val text: str = ut_manifest();
    val w0: O.Option[str] = fs.write_bytes(mf, text, str_len(text), 420);
    if (O.is_some[str](w0)) { ret R.err[str, str](O.unwrap[str](w0)); }

    var i: u32 = 0;
    for (i < n) {
        val fp: str = ut_cc3(alloc, src_dir, "/", names[i]);
        val w: O.Option[str] = fs.write_bytes(fp, texts[i], str_len(texts[i]), 420);
        if (O.is_some[str](w)) { ret R.err[str, str](O.unwrap[str](w)); }
        i = i + 1;
    }
    ret R.ok[str, str](root);
}

fun ut_build(alloc: *A.Allocator, root: str, s: *session.Session) R.Result[project.Project, outcome.Fail] {
    val sr: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](sr)) {
        ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[session.Session, str](sr)));
    }
    @s = R.unwrap_ok[session.Session, str](sr);
    val rr: R.Result[R.Void, str] = driver.setup_registry(?s.registry);
    if (R.is_err[R.Void, str](rr)) {
        session.dnit(s);
        ret R.err[project.Project, outcome.Fail](outcome.user(R.unwrap_err[R.Void, str](rr)));
    }

    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    ret driver.build_project_test(s, root, ?pick);
}

fun ut_mid(p: *project.Project, s: *session.Session, fqn: str) session.ModuleId {
    val idr: R.Result[intern.StrId, str] = intern.intern(?s.interner, fqn);
    if (R.is_err[intern.StrId, str](idr)) { ret session.MODULE_NIL; }
    var id: intern.StrId = R.unwrap_ok[intern.StrId, str](idr);
    val mr: R.Result[*session.ModuleId, str] = map.get[intern.StrId, session.ModuleId](?p.by_fqn, ?id);
    if (R.is_err[*session.ModuleId, str](mr)) { ret session.MODULE_NIL; }
    ret @R.unwrap_ok[*session.ModuleId, str](mr);
}

fun ut_module(p: *project.Project, s: *session.Session, fqn: str) *project.ModuleEntry {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret ?p.modules[mid::u32];
}

rec FailProbe {
    backing:          A.Allocator;
    live:             i64;
    live_count:       i64;
    calls:            u32;
    fail_at:          u32;
    backing_failures: u32;
}

fun fp_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(r.some, 0xAA, size);
    }
    or {
        p.backing_failures = p.backing_failures + 1;
    }
    ret r;
}

fun fp_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.none) { p.backing_failures = p.backing_failures + 1; }
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

fun fp_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *FailProbe = ctx::*FailProbe;
    p.live = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

fun fp_make(p: *FailProbe, alloc: *A.Allocator, fail_at: u32) bool {
    if (O.is_some[str](page.make(?p.backing))) { ret false; }
    p.live             = 0;
    p.live_count       = 0;
    p.calls            = 0;
    p.fail_at          = fail_at;
    p.backing_failures = 0;
    val probe: *FailProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate    = fp_allocate;
    alloc.fn_reallocate = fp_reallocate;
    alloc.fn_deallocate = fp_deallocate;
    ret true;
}

test "mach.lang.fe.sema:sema_survives_allocation_failure_at_every_point" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 {\n    var x: i32 = 5;\n    var z: i32 = 3;\n    val y: i64 = x + z;\n    ret y;\n}\n";

    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val mid: session.ModuleId = ut_mid(?p, ?s, "semaharness.main");
    val m: *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val real_alloc: *A.Allocator = s.alloc;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) { s.alloc = real_alloc; driver.dnit_project(?p); session.dnit(?s); ret 1; }
    s.alloc = ?alloc0;
    val r0: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (R.is_ok[context.SemaResult, fail.Fail](r0)) {
        var res0: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r0);
        sema.dnit_result(?res0);
    }
    s.alloc = real_alloc;
    if (probe0.live != 0 || probe0.live_count != 0) { driver.dnit_project(?p); session.dnit(?s); ret 1; }
    val total: u32 = probe0.calls;
    if (total == 0) { driver.dnit_project(?p); session.dnit(?s); ret 1; }
    if (!diagnostic.has_errors(?s.diags)) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var bad: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            val pre_len: usize = diagnostic.len(?s.diags);
            s.alloc = ?alloc;
            val r: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
            if (R.is_ok[context.SemaResult, fail.Fail](r)) {
                var res: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r);
                sema.dnit_result(?res);
            }
            s.alloc = real_alloc;
            if (probe.live != 0 || probe.live_count != 0) {
                bad = true;
                print.print("LEAK at fail_at=");
                print.u64(fail_at::u64);
                print.print(" live=");
                print.u64(probe.live::u64);
                print.print(" live_count=");
                print.u64(probe.live_count::u64);
                print.print("\n");
            }
            val post_len: usize = diagnostic.len(?s.diags);
            var di: usize = pre_len;
            for (di < post_len) {
                val d_r: R.Result[*diagnostic.Diagnostic, str] = diagnostic.get(?s.diags, di);
                if (R.is_ok[*diagnostic.Diagnostic, str](d_r)) {
                    val d: *diagnostic.Diagnostic = R.unwrap_ok[*diagnostic.Diagnostic, str](d_r);
                    if (d.fixes.len > 1) { bad = true; }
                    if (d.fixes.len == 1 && !diagnostic.fix_valid(?d.fixes.data[0])) {
                        bad = true;
                        print.print("HALF-COMMITTED FIX at fail_at=");
                        print.u64(fail_at::u64);
                        print.print("\n");
                    }
                }
                di = di + 1;
            }
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.fe.sema.context:report_marks_rejected_under_diagnostic_allocation_failure" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { ret 0; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val m: *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    if (diagnostic.has_errors(?s.diags)) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var sc: context.SemaContext;
    sc.status          = fail.accepted();
    sc.s               = ?s;
    sc.diags = ?s.diags;
    sc.a                = m.a;
    sc.silent           = false;
    sc.in_comptime_gate = false;

    var span: token.Span;
    span.offset = 0;
    span.len    = 0;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) { driver.dnit_project(?p); session.dnit(?s); ret 1; }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?alloc0);
    context.report(?sc, span, "probe: allocator-starved diagnostic");
    val total: u32 = probe0.calls;
    diagnostic.store_dnit(?s.diags);
    if (total == 0) { s.diags = diagnostic.store_init(?backing); driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var bad: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            s.diags = diagnostic.store_init(?alloc);
            sc.status = fail.accepted();
            context.report(?sc, span, "probe: allocator-starved diagnostic");
            if (!sel sc.status.kind.internal) { bad = true; }
            diagnostic.store_dnit(?s.diags);
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    s.diags = diagnostic.store_init(?backing);
    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test "mach.lang.fe.sema.context:real_semantic_error_still_rejects_module_under_diagnostic_allocation_failure" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { ret \"not an integer\"; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val mid: session.ModuleId = ut_mid(?p, ?s, "semaharness.main");
    val m: *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) { driver.dnit_project(?p); session.dnit(?s); ret 1; }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?alloc0);
    val r0: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (R.is_ok[context.SemaResult, fail.Fail](r0)) {
        var res0: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r0);
        sema.dnit_result(?res0);
    }
    if (!diagnostic.has_errors(?s.diags)) { s.diags = diagnostic.store_init(?backing); driver.dnit_project(?p); session.dnit(?s); ret 1; }
    val total: u32 = probe0.calls;
    diagnostic.store_dnit(?s.diags);
    if (total == 0) { s.diags = diagnostic.store_init(?backing); driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var bad: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            s.diags = diagnostic.store_init(?alloc);
            val r: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
            if (R.is_ok[context.SemaResult, fail.Fail](r)) {
                var res: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r);
                if (sel res.status.kind.accepted || probe.calls >= fail_at) { bad = true; }
                sema.dnit_result(?res);
            } or {
                if (!fail.is_message(R.unwrap_err[context.SemaResult, fail.Fail](r))) { bad = true; }
            }
            diagnostic.store_dnit(?s.diags);
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    s.diags = diagnostic.store_init(?backing);
    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

fun ut_sweep_registration_failure(s: *session.Session, m: *project.ModuleEntry, mid: session.ModuleId,
                                  target: *map.Map[u32, u32], backing: *A.Allocator) bool {
    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    map.dnit[u32, u32](target);
    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) { ret false; }
    @target = map.init[u32, u32](?alloc0, map.hash_u32, map.eq_u32);
    val r0: R.Result[context.SemaResult, fail.Fail] = sema.sema(s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (R.is_ok[context.SemaResult, fail.Fail](r0)) {
        var res0: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r0);
        sema.dnit_result(?res0);
    }
    val total: u32 = probe0.calls;
    if (total == 0) { ret false; }
    if (diagnostic.has_errors(?s.diags)) { ret false; }

    var bad: bool = false;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            diagnostic.store_dnit(?s.diags);
            s.diags = diagnostic.store_init(backing);
            map.dnit[u32, u32](target);
            @target = map.init[u32, u32](?alloc, map.hash_u32, map.eq_u32);
            val r: R.Result[context.SemaResult, fail.Fail] = sema.sema(s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
            if (R.is_ok[context.SemaResult, fail.Fail](r)) {
                var res: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r);
                if (sel res.status.kind.accepted || probe.calls >= fail_at) { bad = true; }
                sema.dnit_result(?res);
            }
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    map.dnit[u32, u32](target);
    @target = map.init[u32, u32](backing, map.hash_u32, map.eq_u32);
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(backing);
    ret !bad;
}

test "mach.lang.fe.sema:volatile_registration_failure_rejects_module_at_every_ordinal" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "#[volatile]\nrec V { reg: u32; }\nfun main() i64 {\n    var v: V;\n    ret v.reg::i64;\n}\n";

    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val mid: session.ModuleId = ut_mid(?p, ?s, "semaharness.main");
    val m: *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    val ok: bool = ut_sweep_registration_failure(?s, m, mid, ?s.type_volatile, ?backing);

    driver.dnit_project(?p);
    session.dnit(?s);
    if (!ok) { ret 1; }
    ret 0;
}

