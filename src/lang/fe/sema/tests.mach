test reflection__projection_keeps_secrecy {
    var bad: i32 = 0;

    if (ut_vec_diag("rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    if (!ut_sema_rejects("rec I { s: ^u32; }\nrec O { i: I; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f].s; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var o: O; leak[O](o); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("uni U { s: ^u32; }\nrec P { u: U; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f].s; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { a: [4]^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f][2]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n")) { bad = 1; }

    if (ut_vec_diag("rec Box[T] { v: T; }\nfun leak[T](b: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = b.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box[^u32]; leak[Box[^u32]](b); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: *T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](?p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: *T) u32 { var acc: u32 = 0; $each f in $fields(T) { val q: *u32 = ?v.[f]; acc = @q; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](?p); ret 0; }\n")) { bad = 1; }

    val br: str = "rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { if (v.[f] == 7) { acc = 1; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n";
    if (ut_vec_diag(br, "secret value used as a branch condition") != 0) { bad = 1; }
    val ix: str = "rec P { x: ^u32; }\nvar t: [8]u32;\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = t[v.[f]]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n";
    if (ut_vec_diag(ix, "secret value used as a memory index") != 0) { bad = 1; }
    val dv: str = "rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = 9 / v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n";
    if (ut_vec_diag(dv, "variable-latency") != 0) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]:~u32; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n"))                               { bad = 1; }
    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun leak[T](v: *T) u32 { var acc: u32 = 0; $each f in $fields(T) { val r: ptr = (?v.[f])::ptr; acc = @(r::*u32); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](?p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun sink(va: ...) u32 { ret 0; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = sink(v.[f]); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; leak[P](p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("rec P { x: u32; }\nfun leak[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: ^P; leak[^P](p); ret 0; }\n")) { bad = 1; }

    if (!ut_sema_clean("rec P { x: u32; y: u32; }\nfun total[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = acc + v.[f]; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; total[P](p); ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec P { x: ^u32; }\nfun ok[T](v: T) u32 { var acc: u32 = 0; $each f in $fields(T) { acc = v.[f]:>u32; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; ok[P](p); ret 0; }\n"))               { bad = 1; }

    ret bad;
}

# a `*^T` is a public address to secret storage, so ordering two pointers is a
# comparison of public addresses whatever the pointee's secrecy. the result is
# `u8` (`bool` is the stdlib alias) and no address comes back out of it
test pointer_ordering__compiles_across_pointee_secrecy {
    var bad: i32 = 0;

    if (!ut_sema_clean("fun f(a: *^u8, b: *^u8) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))  { bad = 1; }
    if (!ut_sema_clean("fun f(a: *^u8, b: *^u8) u8 { ret a >= b; }\nfun main() i32 { ret 0; }\n")) { bad = 4; }

    if (!ut_sema_clean("fun f(a: *^u8, b: *u8) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))  { bad = 5; }
    if (!ut_sema_clean("fun f(a: *u8, b: *^u8) u8 { ret a >= b; }\nfun main() i32 { ret 0; }\n")) { bad = 6; }

    # a differing pointee type and `nil` order like any other address, the same
    # pairs `==` already accepts
    if (!ut_sema_clean("fun f(a: *^u8, b: *u32) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n"))       { bad = 8; }
    if (!ut_sema_clean("fun f(a: *^u8) u8 { ret a > nil; }\nfun main() i32 { ret 0; }\n"))              { bad = 9; }
    if (!ut_sema_clean("fun f(a: *^[4]u8, b: *^[4]u8) u8 { ret a < b; }\nfun main() i32 { ret 0; }\n")) { bad = 10; }

    # the overlap check the downstream consumer writes
    if (!ut_sema_clean("fun overlap(first: *^u8, first_len: u64, second: *^u8, second_len: u64) u8 {\n    ret first <= ?second[second_len - 1] && second <= ?first[first_len - 1];\n}\nfun main() i32 { ret 0; }\n")) { bad = 11; }

    # the result is public even where both pointees are secret: it feeds a
    # branch and a short-circuiting `&&`, neither of which admits a secret
    if (!ut_sema_clean("#[oblivious]\nfun f(a: *^u8, b: *^u8) u8 { if (a < b) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n")) { bad = 12; }
    if (!ut_sema_clean("fun f(a: *^u8, b: *^u8, c: *^u8) u8 { ret (a < b) && (b < c); }\nfun main() i32 { ret 0; }\n"))           { bad = 13; }

    # a secret *pointer* is a secret value, so the order of two of them is
    # secret and still cannot steer control flow
    if (!ut_sema_rejects_with("fun f(a: ^*u8, b: ^*u8) u8 { if (a < b) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n",
        "secret value used as a branch condition")) { bad = 14; }

    ret bad;
}

# widening the relational operators must open no route from a `*^T` to an
# integer, a `ptr` or a public pointer: a laundered address comes back as a
# `*T` and reads the secret storage
test pointer_ordering__opens_no_secret_conversion {
    var bad: i32 = 0;

    if (!ut_sema_rejects_with("fun f(a: *^u8) u64 { ret a::u64; }\nfun main() i32 { ret 0; }\n",
        "cannot add or drop the secret qualifier")) { bad = 1; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n",
        "cannot add or drop the secret qualifier")) { bad = 2; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) *u8 { ret a:>*u8; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target must name the operand's stripped (public) type")) { bad = 3; }
    if (!ut_sema_rejects_with("fun f(slot: *^u8) *u64 { ret @((?slot):~*u64); }\nfun main() i32 { ret 0; }\n",
        "cannot add or drop the secret qualifier")) { bad = 4; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) i64 { val e: ptr = a; ret 0; }\nfun main() i32 { ret 0; }\n",
        "expected ptr, found *^u8")) { bad = 5; }

    # ordering relates two addresses and nothing else: an integer operand is
    # still a mismatch, so no address arrives in an integer through it
    if (!ut_sema_rejects_with("fun f(a: *^u8, n: u64) u8 { ret a < n; }\nfun main() i32 { ret 0; }\n",
        "incompatible operand types")) { bad = 6; }
    if (!ut_sema_rejects_with("fun f(a: *^u8) u8 { ret a < 0; }\nfun main() i32 { ret 0; }\n",
        "incompatible operand types")) { bad = 7; }

    # the result is a `u8`, not an address
    if (!ut_sema_rejects_with("fun f(a: *^u8, b: *^u8) *^u8 { ret a < b; }\nfun main() i32 { ret 0; }\n",
        "expected *^u8, found u8")) { bad = 8; }
    if (!ut_sema_rejects_with("fun f(a: *^u8, b: *^u8) i32 { ret a < b; }\nfun main() i32 { ret 0; }\n",
        "expected i32, found u8")) { bad = 9; }

    ret bad;
}

test declassify__aggregate_leaves_welded_fields_secret {
    var bad: i32 = 0;

    val welded: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { val p: M = a:>M; ret @p.q; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(welded)) { bad = bad + 1; }

    val plain: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { val p: M = a:>M; ret @p.p; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_clean(plain)) { bad = bad + 2; }

    val unstripped: str = "rec M { p: *u8; q: ^*u8; }\nfun f(a: ^M) u8 { ret @a.p; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects(unstripped)) { bad = bad + 4; }

    ret bad;
}

test declassify__diagnostics_name_colon_gt {
    var bad: i32 = 0;

    if (ut_vec_note("fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n",
        "declassify with `:>T` first") != 0) { bad = bad + 1; }

    if (ut_vec_note("ext fun printf(fmt: *u8, ...) i32;\nfun f(a: ^u32) i32 { ret printf(\"%u\"::*u8, a); }\nfun main() i32 { ret 0; }\n",
        "declassify with `:>T` first") != 0) { bad = bad + 2; }

    if (ut_vec_note("fun f(p: ^*u8) u8 { ret @p; }\nfun main() i32 { ret 0; }\n",
        "`:>T`-declassify the pointer when disclosure is intended") != 0) { bad = bad + 4; }

    if (!ut_sema_rejects_with("fun f(a: ^u32) u32 { ret a:>^u32; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target type must be public")) { bad = bad + 8; }

    if (!ut_sema_rejects_with("fun f(a: ^u32) u64 { ret a:>u64; }\nfun main() i32 { ret 0; }\n",
        "a `:>T` target must name the operand's stripped (public) type")) { bad = bad + 16; }

    ret bad;
}

test secret_variadic__refused_through_every_container {
    var bad: i32 = 0;

    val sec: str = "fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(sec, "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nfun f(a: ^u32) u32 { ret logf(a:>u32); }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nfun f(a: u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                          { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec P { x: ^u32; }\nfun f(a: P) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                      { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec I { s: ^u32; }\nrec O { inner: I; }\nfun f(a: O) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nuni U { s: ^u32; t: ^u32; }\nfun f(a: U) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nfun f(a: [4]^u32) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                    { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nfun f(a: *^u8) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                       { bad = 1; }

    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec Q { x: u32; y: u32; }\nfun f(a: Q) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }

    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun mk[T](x: T) Box[T] { var b: Box[T]; b.v = x; ret b; }\nfun f(s: ^u32) u32 { ret logf(mk[^u32](s)); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun f(s: ^u32) u32 { var b: Box[^u32]; ret logf(b); }\nfun main() i32 { ret 0; }\n"))                                                    { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun f(s: ^u32) u32 { var b: Box[Box[^u32]]; ret logf(b); }\nfun main() i32 { ret 0; }\n"))                                               { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec Box[T] { v: T; }\nfun mk[T](x: T) Box[T] { var b: Box[T]; b.v = x; ret b; }\nfun f() u32 { ret logf(mk[u32](5)); }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("fun logf(va: ...) u32 { ret 0; }\nrec N { next: *N; s: ^u32; }\nfun f(a: N) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                                                 { bad = 1; }
    if (!ut_sema_clean("fun logf(va: ...) u32 { ret 0; }\nrec N { next: *N; v: u32; }\nfun f(a: N) u32 { ret logf(a); }\nfun main() i32 { ret 0; }\n"))                                                                    { bad = 1; }

    if (!ut_sema_clean("fun takes(a: ^u32) u32 { ret a:>u32; }\nfun f(a: ^u32) u32 { ret takes(a); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    ret bad;
}

# whether sema refuses `text` with `needle` at `offset`/`len` and reports no secret.variadic
#[testing]
fun t_variadic_refusal(text: str, needle: str, offset: usize, len: usize) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var names: [1]str                          = [1]str{"main.mach"};
    var texts: [1]str                          = [1]str{text};
    val pr:    res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) { ret false; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && fail.is_reported(se.err))) { ret false; }
    var located: bool  = false;
    var i:       usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (ut_str_contains(d.message, "secret value cannot be passed")) { ret false; }
        if (diagnostic_kind.is_error(d.kind) && ut_str_contains(d.message, needle)
            && d.loc.span.offset == offset && d.loc.span.len == len) { located = true; }
        i = i + 1;
    }
    ret located;
}

test secret_variadic__non_values_get_their_own_refusal {
    var bad: i32 = 0;

    if (!t_variadic_refusal("tag R: u8 { empty; value: u64; }\nfun cnt(va: ...) u32 { ret 0; }\nfun f() u32 { ret cnt(R.value); }\nfun main() i32 { ret 0; }\n", "a case selector is not a value", 87, 7))             { bad = bad + 1; }
    if (!t_variadic_refusal("fun inner(va: ...) u32 { ret 0; }\nfun outer(va: ...) u32 { ret inner(va); }\nfun g() u32 { ret outer(1::u32); }\nfun main() i32 { ret 0; }\n", "forward the pack with a spread", 69, 2)) { bad = bad + 2; }

    ret bad;
}

test secret_welding__pointer_casts_and_unions {
    var bad: i32 = 0;

    val erase: str = "rec P { x: ^u32; }\nfun e(p: *P) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(erase, "secret-welded pointer cannot be erased") != 0)                                               { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nfun e(p: *Box[^u32]) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("rec R { x: u32; }\nfun e(p: *R) ptr { ret p::ptr; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nrec Q { x: u32; }\nfun f(p: *P) *Q { ret p:~*Q; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("rec P { x: ^u32; }\nrec Q { x: u32; }\nfun f(p: *P) *Q { ret p::*Q; }\nfun main() i32 { ret 0; }\n"))           { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nrec Q { x: u32; }\nfun f(p: *Box[^u32]) *Q { ret p:~*Q; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: ^u32) ^i32 { ret a:~^i32; }\nfun main() i32 { ret 0; }\n"))                                              { bad = 1; }
    if (!ut_sema_clean("rec A { x: u32; }\nrec B { y: u32; }\nfun f(p: *A) *B { ret p:~*B; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }

    val pun: str = "rec P { x: ^u32; }\nrec Q { x: u32; }\nuni U { a: P; b: Q; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(pun, "union variants must agree on secrecy") != 0)                                                           { bad = 1; }
    if (!ut_sema_rejects("rec Box[T] { v: T; }\nrec Q { x: u32; }\nuni U { a: Box[^u32]; b: Q; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("uni U { a: ^u32; b: u32; }\nfun main() i32 { ret 0; }\n"))                                             { bad = 1; }
    if (!ut_sema_clean("uni U { a: ^u32; b: ^u32; }\nfun main() i32 { ret 0; }\n"))                                              { bad = 1; }
    if (!ut_sema_clean("rec A { x: u32; }\nrec B { y: u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))              { bad = 1; }
    if (!ut_sema_clean("rec A { x: ^u32; }\nrec B { x: ^u32; y: ^u32; }\nuni U { a: A; b: B; }\nfun main() i32 { ret 0; }\n"))   { bad = 1; }

    if (!ut_sema_rejects("rec P { x: ^u32; }\nfun f(a: *P) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_clean("fun f(a: *u32) u64 { ret a:~u64; }\nfun main() i32 { ret 0; }\n"))                     { bad = 1; }
    if (!ut_sema_clean("fun f(a: *^u32) *^i32 { ret a:~*^i32; }\nfun main() i32 { ret 0; }\n"))                { bad = 1; }

    # a type holding no value has zero extent and no class, so it narrows from anything and widens to nothing
    if (!ut_sema_clean("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^u8) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n"))                                                  { bad = 2; }
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^E) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 3; }
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^Z) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 4; }
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *E) *R { ret p::*R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier"))    { bad = 5; }
    if (!ut_sema_clean("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^u8) *^E { ret p::*^E; }\nfun main() i32 { ret 0; }\n"))                                                  { bad = 6; }
    if (!ut_sema_clean("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^u8) *^P { ret p::*^P; }\nfun main() i32 { ret 0; }\n"))                                                  { bad = 7; }
    if (!ut_sema_rejects_with("rec E {}\nrec Z { e: E; n: [0]u64; }\nrec R { a: ^u64; b: ^u64; }\nrec P { a: u64; }\nfun f(p: *^E) *^P { ret p::*^P; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier")) { bad = 8; }
    if (!ut_sema_rejects_with("rec R { a: ^u64; b: ^u64; }\nfun f(p: *^rec{}) *^R { ret p::*^R; }\nfun main() i32 { ret 0; }\n", "cannot add or drop the secret qualifier"))                                                      { bad = 9; }
    if (!ut_sema_clean("fun f(p: *^u8) *^rec{} { ret p::*^rec{}; }\nfun main() i32 { ret 0; }\n"))                                                                                                                                { bad = 10; }

    if (!ut_sema_rejects("fun id(x: u32) u32 { ret x; }\nfun f() fun(^u32) u32 { ret id :~ fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_rejects("fun id(x: u32) u32 { ret x; }\nfun f() fun(^u32) u32 { ret id :: fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))                 { bad = 1; }
    if (!ut_sema_rejects("fun sr(x: u32) ^u32 { var y: ^u32 = x; ret y; }\nfun f() fun(u32) u32 { ret sr :~ fun(u32) u32; }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    if (!ut_sema_rejects("fun id(x: ^u32) u32 { ret x:>u32; }\nfun f() u64 { ret id :~ u64; }\nfun main() i32 { ret 0; }\n"))                               { bad = 1; }
    if (!ut_sema_clean("fun id(x: ^u32) u32 { ret x:>u32; }\nfun f() fun(^u32) u32 { ret id :~ fun(^u32) u32; }\nfun main() i32 { ret 0; }\n"))             { bad = 1; }
    if (!ut_sema_clean("fun id(x: u32) u32 { ret x; }\nfun f() fun(u32) u32 { ret id :~ fun(u32) u32; }\nfun main() i32 { ret 0; }\n"))                     { bad = 1; }

    ret bad;
}

#[testing]
val DEFERRED_LIB: str = "pub val ON: u8 = 1;\npub val OFF: u8 = 0;\n";

# every unresolved name in the arm sema selects is reported exactly once, whatever position
# it sits in, and none of them as the unbound-identifier internal error; a discarded
# arm reports nothing, nested gates report only the selected path, and a statement gate binds
# beside a declaration gate the load decides on the same constant
test deferred_gate__reports_only_the_selected_path {
    val main:    str = "use lib: uniontest.lib;\nrec Box[T] { v: T; }\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        var a: NoA = 0;\n        val b: u64 = k::NoB;\n        var c: Box[NoC];\n        {\n            var d: [2]NoD;\n        }\n        ret nope_e;\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64; }\n";
    var needles: [7]str;
    needles[0] = "unresolved type name `NoA`";
    needles[1] = "unresolved type name `NoB`";
    needles[2] = "unresolved type name `NoC`";
    needles[3] = "unresolved type name `NoD`";
    needles[4] = "unresolved identifier `nope_e`";
    needles[5] = "internal";
    needles[6] = "unresolved";
    var counts: [7]u32;
    if (!t_refusal_counts(DEFERRED_LIB, main, ?needles[0], ?counts[0], 7)) { ret 1; }
    var i: u32 = 0;
    for (i < 5) {
        if (counts[i] != 1) { ret 10 + i::i32; }
        i = i + 1;
    }
    if (counts[5] != 0) { ret 20; }
    if (counts[6] != 5) { ret 21; }

    val discarded: str = "use lib: uniontest.lib;\nrec Box[T] { v: T; }\nfun f(k: u64) u64 {\n    $if (lib.OFF) {\n        var a: NoA = nope;\n        var c: Box[NoC];\n        ret lib.missing;\n    }\n    $or {\n        ret k;\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64; }\n";
    if (!ut_sema_clean2(discarded, DEFERRED_LIB)) { ret 30; }
    # outer selected, inner discarded
    if (!ut_sema_clean2("use lib: uniontest.lib;\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        $if (lib.OFF) { ret nope; }\n        $or { ret k; }\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64; }\n", DEFERRED_LIB)) { ret 31; }
    # outer discarded, inner selected
    if (!ut_sema_clean2("use lib: uniontest.lib;\nfun f(k: u64) u64 {\n    $if (lib.OFF) {\n        $if (lib.ON) { ret nope; }\n    }\n    ret k;\n}\nfun main() i64 { ret f(1)::i64; }\n", DEFERRED_LIB)) { ret 32; }
    # both selected
    needles[0] = "unresolved identifier `nope`";
    needles[1] = "internal";
    if (!t_refusal_counts(DEFERRED_LIB, "use lib: uniontest.lib;\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        $if (lib.ON) { ret nope; }\n    }\n    ret k;\n}\nfun main() i64 { ret f(1)::i64; }\n", ?needles[0], ?counts[0], 2)) { ret 33; }
    if (counts[0] != 1 || counts[1] != 0)                                                                                                                                                                                               { ret 34; }

    val flag_lib: str = "pub def flag: u8;\npub val ON: flag = 1;\n";
    val beside:   str = "use lib: uniontest.lib;\n$if (lib.ON) { fun selected() i64 { ret 1; } }\nfun f(k: u64) u64 {\n    $if (lib.ON) {\n        var r: u64 = k;\n        ret r;\n    }\n    ret 0;\n}\nfun main() i64 { ret f(1)::i64 + selected(); }\n";
    if (!ut_sema_clean2(beside, flag_lib)) { ret 35; }
    ret 0;
}

test deferred_gate__in_a_generic_reports_once_across_instances {
    val main:    str = "use lib: uniontest.lib;\nfun g[T](x: T) T {\n    $if (lib.ON) {\n        ret nope_g;\n    }\n    ret x;\n}\nfun main() i64 {\n    val a: u64 = g[u64](1);\n    val b: i64 = g[i64](2);\n    ret b;\n}\n";
    var needles: [2]str;
    needles[0] = "unresolved identifier `nope_g`";
    needles[1] = "internal";
    var counts: [2]u32;
    if (!t_refusal_counts(DEFERRED_LIB, main, ?needles[0], ?counts[0], 2)) { ret 1; }
    if (counts[0] != 1)                                                    { ret 2; }
    if (counts[1] != 0)                                                    { ret 3; }
    val clean: str = "use lib: uniontest.lib;\nfun g[T](x: T) T {\n    $if (lib.ON) {\n        ret x;\n    }\n    ret x;\n}\nfun main() i64 {\n    val a: u64 = g[u64](1);\n    ret g[i64](2);\n}\n";
    if (!ut_sema_clean2(clean, DEFERRED_LIB)) { ret 4; }
    ret 0;
}

# runs sema over a scaffolded project and counts the `#[testing]` refusals; each must sit on a
# bare name, and any other error fails the fixture so a refusal cannot hide behind one
#[testing]
pub fun t_testing_refusals(names: *str, texts: *str, count: u32, expected: u32) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    val built: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, names, texts, count);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val checked: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err && !fail.is_reported(checked.err)) { ret 4; }
    if (sel checked.ok && expected != 0)                   { ret 5; }
    var refusals: u32   = 0;
    var i:        usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        i = i + 1;
        if (!diagnostic_kind.is_error(d.kind))                            { cnt; }
        if (!ut_str_contains(d.message, "is a `#[testing]` declaration")) { ret 6; }
        val file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, d.loc.file);
        if (sel file.none) { ret 7; }
        val text: str              = file.some.text;
        val span: lang_source.Span = d.loc.span;
        if (span.len == 0 || span.offset + span.len > str_len(text)) { ret 8; }
        var j: usize = 0;
        for (j < span.len) {
            val c: u8 = text[span.offset + j];
            if (c == '[' || c == '(' || c == '{' || c == ' ' || c == ';') { ret 9; }
            j = j + 1;
        }
        refusals = refusals + 1;
    }
    if (refusals != expected) { ret 10; }
    ret 0;
}

#[testing]
fun t_testing_refusals1(text: str, expected: u32) i32 {
    var names: [1]str = [1]str{"main.mach"};
    var texts: [1]str = [1]str{text};
    ret t_testing_refusals(?names[0], ?texts[0], 1, expected);
}

#[testing]
rec TestingCase {
    text:     str;
    expected: u32;
}

# every way production code can name a testing declaration: a call, a value, an address,
# a field, parameter and return type, a generic instance, a generic argument, comptime
# evaluation and a decorator argument
#[testing]
val TESTING_REFERENCES: [8]TestingCase = [8]TestingCase{
    TestingCase{text: "#[testing]\nfun helper() i32 { ret 1; }\nfun prod() i32 { ret helper(); }\n", expected: 1},
    TestingCase{text: "#[testing]\nval FIXTURE: i32 = 3;\nfun prod() i32 { ret FIXTURE; }\n", expected: 1},
    TestingCase{text: "#[testing]\nvar slot: i32 = 0;\nfun prod() *i32 { ret ?slot; }\n", expected: 1},
    TestingCase{text: "#[testing]\nrec Fixture { n: i32; }\nrec Prod { f: Fixture; }\nfun take(x: *Fixture) {}\nfun give() *Fixture { ret nil; }\n", expected: 3},
    TestingCase{text: "#[testing]\nfun make[T](x: T) T { ret x; }\nfun prod() i32 { ret make[i32](1); }\n", expected: 1},
    TestingCase{text: "#[testing]\nrec Fixture { n: i32; }\nrec Box[T] { v: T; }\nfun id[T](x: T) T { ret x; }\nfun prod() i32 { var b: Box[i32]; var f: Fixture; ret id[Box[i32]](b).v; }\n", expected: 1},
    TestingCase{text: "#[testing]\nval N: i32 = 4;\nval M: i32 = N + 1;\n$if (N == 4) {\n    fun prod() i32 { ret M; }\n}\nfun size() u64 { ret $size_of([N]u8)::u64; }\n", expected: 3},
    TestingCase{text: "#[testing]\nval WIDTH: u32 = 16;\n#[align(WIDTH)]\nvar g: i32 = 0;\n", expected: 1}
};

test testing_mark__refuses_every_production_reference {
    var i: usize = 0;
    for (i < 8) {
        val code: i32 = t_testing_refusals1(TESTING_REFERENCES[i].text, TESTING_REFERENCES[i].expected);
        if (code != 0) { ret (i::i32 + 1) * 100 + code; }
        i = i + 1;
    }
    ret 0;
}

# an off-by-one region boundary would let a production declaration that abuts a testing one
# borrow its exemption, so neither side has a blank line or decorator between them
test testing_mark__region_ends_exactly_at_an_abutting_declaration {
    if (t_testing_refusals1("#[testing] val V: i32 = 1;val W: i32 = V;", 1) != 0)                                                    { ret 1; }
    if (t_testing_refusals1("val W: i32 = V;#[testing] val V: i32 = 1;", 1) != 0)                                                    { ret 2; }
    if (t_testing_refusals1("test t { ret V; }val W: i32 = V;#[testing] val V: i32 = 1;", 1) != 0)                                   { ret 3; }
    if (t_testing_refusals1("#[testing] fun a() i32 { ret 1; }fun b() i32 { ret a(); }#[testing] fun c() i32 { ret a(); }", 1) != 0) { ret 4; }
    ret 0;
}

# the mark follows imports: a module path and a plain `use` carry it, a `#[testing] use`
# confines even an ordinary target, and an unmarked `fwd` of a testing declaration is refused
test testing_mark__follows_imports {
    var names: [2]str = [2]str{"main.mach", "api.mach"};
    var texts: [2]str;
    texts[0] = "use uniontest.api;\nuse uniontest.api.helper;\nfun prod() i32 { ret api.helper() + helper(); }\n";
    texts[1] = "#[testing]\npub fun helper() i32 { ret 1; }\n";
    val through: i32 = t_testing_refusals(?names[0], ?texts[0], 2, 2);
    if (through != 0) { ret 10 + through; }

    texts[0] = "#[testing]\nuse fixture: uniontest.api.plain;\nuse uniontest.api.plain;\nfun prod() i32 { ret fixture() + plain(); }\n";
    texts[1] = "pub fun plain() i32 { ret 1; }\n";
    val alias: i32 = t_testing_refusals(?names[0], ?texts[0], 2, 1);
    if (alias != 0) { ret 20 + alias; }

    var fnames: [3]str = [3]str{"main.mach", "api.mach", "mid.mach"};
    var ftexts: [3]str;
    ftexts[0] = "use uniontest.mid;\nfun main() i32 { ret 0; }\n";
    ftexts[1] = "#[testing]\npub fun helper() i32 { ret 1; }\n";
    ftexts[2] = "fwd uniontest.api.helper;\n";
    val fwd: i32 = t_testing_refusals(?fnames[0], ?ftexts[0], 3, 1);
    if (fwd != 0) { ret 30 + fwd; }
    ret 0;
}

test testing_mark__accepts_references_from_tests_and_testing_declarations {
    var names: [4]str = [4]str{"main.mach", "api.mach", "mid.mach", "bridge.mach"};
    var texts: [4]str;
    texts[0] = "use uniontest.api;\nuse uniontest.api.helper;\nuse uniontest.mid;\n#[testing]\nuse fixture: uniontest.api.plain;\n#[testing]\nval N: i32 = 4;\n#[testing]\nval WIDTH: u32 = 16;\n#[testing]\nvar slot: i32 = 0;\n#[testing]\nrec Fixture { n: i32; }\nrec Box[T] { v: T; }\n#[testing]\nfun make[T](x: T) T { ret x; }\n#[testing]\n#[align(WIDTH)]\nvar aligned: i32 = 0;\n#[testing]\nrec Holder { f: Fixture; }\n#[testing]\nfun give(x: *Fixture) *Fixture { ret x; }\n#[testing]\nfun uses() i32 { var b: Box[Fixture]; val p: *i32 = ?slot; ret api.helper() + helper() + mid.helper() + fixture() + make[i32](N) + $size_of([N]u8)::i32 + b.v.n + @p; }\ntest uses { var b: Box[Fixture]; val p: *i32 = ?slot; var h: Holder; ret api.helper() + helper() + mid.helper() + fixture() + make[i32](N) + $size_of([N]u8)::i32 + b.v.n + @p + uses() + give(?h.f).n; }\nfun main() i32 { ret api.plain(); }\n";
    texts[1] = "#[testing]\npub fun helper() i32 { ret 1; }\npub fun plain() i32 { ret 1; }\n";
    texts[2] = "#[testing]\nfwd uniontest.api.helper;\n";
    texts[3] = "#[testing]\nfwd uniontest.mid.helper;\n";
    ret t_testing_refusals(?names[0], ?texts[0], 4, 0);
}

test testing_mark__declaration_is_type_checked_in_every_build {
    if (!ut_sema_rejects_with("#[testing]\nval i: i32 = 0;\n#[testing]\nfun bad() { i = 2; }\nfun main() i32 { ret 0; }\n",
        "cannot assign to `i`: a `val` is immutable")) { ret 1; }
    ret 0;
}

# scaffolds a consumer whose path dependency `leaf` exposes a `pub #[testing]` helper, and
# builds it through the planned engine for `goal` in a fresh session
#[testing]
pub fun t_testing_dep_build(alloc: *A.Allocator, root: str, goal: request.BuildGoal, tests: *outcome.BuildOutcome, refused: *bool) i32 {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val mr: res[manifest.Manifest, fail.Fail] = driver.load_manifest(?s, root);
    if (sel mr.err) { ret 3; }
    var m:  manifest.Manifest    = mr.ok;
    var rq: request.BuildRequest = request.defaults();
    rq.project_root = root;
    rq.target       = "linux";
    rq.goal         = goal;
    rq.artifact     = "uniontest";
    rq.object_cache = true;
    val pr: res[build_plan.BuildPlan, fail.Fail] = build_plan.plan(alloc, ?s.interner, toolchain.t_registry(), ?m, rq);
    if (sel pr.err) { ret 4; }
    var bp: build_plan.BuildPlan                 = pr.ok;
    val r:  res[outcome.BuildOutcome, fail.Fail] = engine.execute_warm(?bp, 0, ?s, alloc, nil);
    if (sel r.err) { ret 5; }
    @tests   = r.ok;
    @refused = ut_diag_has(?s.diags, "is a `#[testing]` declaration");
    ret 0;
}

#[testing]
pub fun t_testing_dep_scaffold(alloc: *A.Allocator, main_text: str) res[str, fail.Fail] {
    var names:    [1]str              = [1]str{"main.mach"};
    var texts:    [1]str              = [1]str{ut_cc3(alloc, main_text, ut_dispatcher_start_stub(), "")};
    val consumer: str                 = ut_cc3(alloc, ut_manifest(), "\n[dep.leaf]\npath = \"dep/leaf\"\n", "");
    val scaffold: res[str, fail.Fail] = ut_scaffold_m(alloc, consumer, ?names[0], ?texts[0], 1);
    if (sel scaffold.err) { ret scaffold; }
    val root:    str             = scaffold.ok;
    val dep_src: str             = ut_cc3(alloc, root, "/", "dep/leaf/src");
    val made:    err[fs.FsError] = fs.create_dir_all(alloc, dep_src, 493);
    if (sel made.err) { ret res[str, fail.Fail].err{fail.fs_refused(made.err)}; }
    val dep_manifest: str             = ut_lib_manifest(alloc, "leaf");
    val mf:           str             = ut_cc3(alloc, root, "/dep/leaf/", manifest.MANIFEST_FILE);
    val w0:           err[fs.FsError] = fs.write_bytes(mf, dep_manifest, str_len(dep_manifest), 420);
    if (sel w0.err) { ret res[str, fail.Fail].err{fail.fs_refused(w0.err)}; }
    val lib_text: str             = "use leaf.shape;\nval BASE: u64 = 4 * $size_of(shape.Pair);\n#[testing]\nval END: u64 = BASE - 22;\n#[testing]\npub fun helper() i32 { ret END::i32; }\npub fun plain() i32 { ret (BASE - 64)::i32; }\n";
    val w1:       err[fs.FsError] = fs.write_bytes(ut_cc3(alloc, dep_src, "/", "lib.mach"), lib_text, str_len(lib_text), 420);
    if (sel w1.err) { ret res[str, fail.Fail].err{fail.fs_refused(w1.err)}; }
    val shape_text: str             = "pub rec Pair {\n    a: u64;\n    b: u64;\n}\n";
    val w2:         err[fs.FsError] = fs.write_bytes(ut_cc3(alloc, dep_src, "/", "shape.mach"), shape_text, str_len(shape_text), 420);
    if (sel w2.err) { ret res[str, fail.Fail].err{fail.fs_refused(w2.err)}; }
    ret res[str, fail.Fail].ok{root};
}

test testing_mark__dependency_helper_is_refused_to_consumer_production {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val scaffold: res[str, fail.Fail] = t_testing_dep_scaffold(?alloc, "use leaf.lib;\npub fun main() i32 { ret lib.helper(); }\n");
    if (sel scaffold.err) { ret 2; }
    val root: str = scaffold.ok;
    fin { fs.remove_all(?alloc, root); }
    var built:   outcome.BuildOutcome;
    var refused: bool = false;
    val status:  i32  = t_testing_dep_build(?alloc, root, request.GOAL_OBJECTS, ?built, ?refused);
    if (status != 0) { ret 10 + status; }
    fin { outcome.outcome_dnit(?built); }
    if (built.severity == outcome.BUILD_OK || !refused) { ret 3; }
    ret 0;
}

# the mark refuses an `ext` declaration, a directive naming an outside consumer (the first
# and last of the exclusive table), a test, a comptime directive, a local, arguments and a
# second mark
test testing_mark__refuses_misplaced_or_malformed {
    val only: str = "`testing` applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations";
    if (!ut_sema_rejects_with("#[testing]\next fun outside() i32;\nfun main() i32 { ret 0; }\n", "`testing` cannot apply to an `ext` declaration"))       { ret 1; }
    if (!ut_sema_rejects_with("#[testing]\n#[symbol(\"exported\")]\nfun f() {}\nfun main() i32 { ret 0; }\n", "`testing` cannot combine with `symbol`"))  { ret 2; }
    if (!ut_sema_rejects_with("#[testing]\n#[sampler(0, 1)]\nvar f: f32 = 0.0;\nfun main() i32 { ret 0; }\n", "`testing` cannot combine with `sampler`")) { ret 3; }
    if (!ut_sema_rejects_with("#[testing]\ntest already_test_only { ret 0; }\nfun main() i32 { ret 0; }\n", only))                                        { ret 4; }
    if (!ut_sema_rejects_with("#[testing]\n$if ($mach.build.pointer_width == 8) {\n    fun f() {}\n}\nfun main() i32 { ret 0; }\n", only))                { ret 5; }
    # a local binding takes no decorator at all, so the grammar refuses the mark before sema sees it
    if (!ut_sema_rejects_with("fun main() i32 {\n    #[testing]\n    val n: i32 = 0;\n    ret n;\n}\n", "`#[testing]` applies only to module-level declarations")) { ret 6; }
    if (!ut_sema_rejects_with("#[testing(1)]\nfun f() {}\nfun main() i32 { ret 0; }\n", "`testing` decorator takes no arguments"))                                 { ret 7; }
    if (!ut_sema_rejects_with("#[testing]\n#[testing]\nfun f() {}\nfun main() i32 { ret 0; }\n", "`testing` may appear only once on a declaration"))               { ret 8; }
    ret 0;
}
