test "mach.lang.fe.sema.context:generic_param_type_for_respects_declaring_module" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var names: [2]str = [2]str{ "main.mach", "lib.mach" };
    var texts: [2]str = [2]str{
        "use semaharness.lib;\nfun same[T](x: T) T { ret x; }\nfun main() i32 { ret 0; }\n",
        "pub fun same[T](x: T) T { ret x; }\n"
    };
    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 2);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);
    fin { fs.remove_all(?backing, root); }
    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fin { session.dnit(?s); }
    if (R.is_err[project.Project, outcome.Fail](pr)) { ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);
    fin { project.dnit_project(?p); }
    val name_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, "T");
    if (R.is_err[intern.StrId, str](name_r)) { ret 1; }
    var owners: [2]str = [2]str{ "semaharness.main", "semaharness.lib" };
    var types: [2]type.TypeId;
    var i: u32 = 0;
    for (i < 2) {
        val mid: session.ModuleId = ut_mid(?p, ?s, owners[i]);
        val m: *project.ModuleEntry = ut_module(?p, ?s, owners[i]);
        if (m == nil || mid == session.MODULE_NIL) { ret 1; }
        var sc: context.SemaContext;
        sc.s = ?s;
        sc.diags = ?s.diags;
        sc.a = m.a;
        sc.own_module = mid;
        sc.status = fail.accepted();
        var sym: resolve.Symbol;
        sym.name = R.unwrap_ok[intern.StrId, str](name_r);
        sym.origin = mid;
        sym.slot = 0;
        sym.decl = id.DECL_NIL;
        var di: usize = 0;
        for (di < m.a.decl_len) {
            if (m.a.decls[di].kind == decl.DECL_KIND_FUN && m.a.decls[di].data.fun_.generics_len == 1) {
                sym.decl = di::id.DeclId;
            }
            di = di + 1;
        }
        if (sym.decl == id.DECL_NIL) { ret 1; }
        types[i] = context.generic_param_type_for(?sc, ?sym);
        if (types[i] == type.TYPE_ERROR || !sel sc.status.kind.accepted) { ret 1; }
        if (context.generic_param_type_for(?sc, ?sym) != types[i]) { ret 1; }
        i = i + 1;
    }
    if (types[0] == types[1]) { ret 1; }
    ret 0;
}

fun ut_sweep_never_skips(src: str) i32 { ret ut_sweep(src, ""); }

fun ut_sweep(src: str, forbidden: str) i32 {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val mid: session.ModuleId   = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val real_alloc: *A.Allocator = s.alloc;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) { driver.dnit_project(?p); session.dnit(?s); ret 1; }
    s.alloc = ?alloc0;
    val pre0: usize = diagnostic.len(?s.diags);
    val r0: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (R.is_ok[context.SemaResult, fail.Fail](r0)) {
        var res0: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r0);
        sema.dnit_result(?res0);
    }
    s.alloc = real_alloc;
    val total: u32 = probe0.calls;
    if (probe0.backing_failures != 0) {
        print.print("APPARATUS: the backing allocator failed during the baseline run; the sweep cannot tell a real failure from the injected one\n");
        driver.dnit_project(?p); session.dnit(?s); ret 1;
    }
    if (total == 0) {
        print.print("APPARATUS: the baseline run made no allocations\n");
        driver.dnit_project(?p); session.dnit(?s); ret 1;
    }
    if (diagnostic.len(?s.diags) == pre0) {
        print.print("APPARATUS: the baseline run reported nothing, so the fixture proves nothing\n");
        driver.dnit_project(?p); session.dnit(?s); ret 1;
    }

    var bad: i32 = 0;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (!fp_make(?probe, ?alloc, fail_at)) { driver.dnit_project(?p); session.dnit(?s); ret 1; }
        val pre: usize = diagnostic.len(?s.diags);
        s.alloc = ?alloc;
        val r: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
        val accepted: bool = R.is_ok[context.SemaResult, fail.Fail](r);
        if (accepted) {
            var res: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r);
            sema.dnit_result(?res);
        }
        s.alloc = real_alloc;
        if (probe.backing_failures != 0) {
            bad = 1;
            print.print("APPARATUS: the backing allocator failed at fail_at=");
            print.u64(fail_at::u64);
            print.print("; this is memory pressure, not a skipped check\n");
        }
        or (accepted && diagnostic.len(?s.diags) == pre) {
            bad = 1;
            print.print("SKIPPED CHECK at fail_at=");
            print.u64(fail_at::u64);
            print.print("\n");
        }
        if (str_len(forbidden) > 0) {
            var di: usize = pre;
            for (di < diagnostic.len(?s.diags)) {
                val d_r: R.Result[*diagnostic.Diagnostic, str] = diagnostic.get(?s.diags, di);
                if (R.is_ok[*diagnostic.Diagnostic, str](d_r)) {
                    if (ut_contains(R.unwrap_ok[*diagnostic.Diagnostic, str](d_r).message, forbidden)) {
                        bad = 1;
                        print.print("FORBIDDEN DIAGNOSTIC at fail_at=");
                        print.u64(fail_at::u64);
                        print.print("\n");
                    }
                }
                di = di + 1;
            }
        }
        fail_at = fail_at + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test "mach.lang.fe.sema:recursive_type_check_never_skipped_under_allocation_failure" {
    ret ut_sweep_never_skips("rec N { self: N; }\nfun main() i64 { ret 0; }\n");
}

test "mach.lang.fe.sema:uni_secrecy_check_never_skipped_under_allocation_failure" {
    ret ut_sweep_never_skips("uni U { a: ^u32; b: u32; }\nfun main() i64 { ret 0; }\n");
}

fun ut_nested_array_src(alloc: *A.Allocator, n: u32) str {
    val head: str = "rec K { f: ";
    val tail: str = "u8; }\nfun main() i64 { ret 0; }\n";
    val hl:   usize = str_len(head);
    val tl:   usize = str_len(tail);
    val total: usize = hl + (n::usize * 3) + tl + 1;

    val r: R.Result[*u8, str] = A.allocate[u8](alloc, total);
    if (R.is_err[*u8, str](r)) { ret ""; }
    val buf: *u8 = R.unwrap_ok[*u8, str](r);

    var k: usize = 0;
    var j: usize = 0;
    for (j < hl) { buf[k] = head[j]; k = k + 1; j = j + 1; }
    var i: u32 = 0;
    for (i < n) {
        buf[k] = '[';     k = k + 1;
        buf[k] = '1';     k = k + 1;
        buf[k] = ']';     k = k + 1;
        i = i + 1;
    }
    j = 0;
    for (j < tl) { buf[k] = tail[j]; k = k + 1; j = j + 1; }
    buf[k] = 0;
    ret buf::str;
}

fun ut_sema_diag_has(src: str, needle: str) bool {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret false; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret false; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret false; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) { driver.dnit_project(?p); session.dnit(?s); ret false; }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val r: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (R.is_ok[context.SemaResult, fail.Fail](r)) {
        var res: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r);
        sema.dnit_result(?res);
    }

    var hit: bool = false;
    var di:  usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        val d_r: R.Result[*diagnostic.Diagnostic, str] = diagnostic.get(?s.diags, di);
        if (R.is_ok[*diagnostic.Diagnostic, str](d_r)) {
            if (ut_contains(R.unwrap_ok[*diagnostic.Diagnostic, str](d_r).message, needle)) { hit = true; }
        }
        di = di + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret hit;
}

fun ut_contains(hay: str, needle: str) bool {
    val hl: usize = str_len(hay);
    val nl: usize = str_len(needle);
    if (nl == 0)  { ret true; }
    if (nl > hl)  { ret false; }
    var i: usize = 0;
    for (i + nl <= hl) {
        var j: usize = 0;
        for (j < nl) {
            if (hay[i + j] != needle[j]) { brk; }
            j = j + 1;
        }
        if (j == nl) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.fe.sema:recursive_type_walk_is_depth_bounded" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var bad: i32 = 0;

    val deep: str = ut_nested_array_src(?alloc, 1100);
    if (str_len(deep) == 0)                                     { ret 1; }
    if (!ut_sema_diag_has(deep, "nests deeper than"))           { bad = 1; }

    val shallow: str = ut_nested_array_src(?alloc, 1000);
    if (str_len(shallow) == 0)                                  { ret 1; }
    if (ut_sema_diag_has(shallow, "nests deeper than"))         { bad = 1; }

    ret bad;
}

test "mach.lang.fe.sema:uni_secrecy_scratch_failure_never_degrades_the_walk" {
    ret ut_sweep("rec V { u: U; }\nuni U { x: V; y: ^u32; }\nfun main() i64 { ret 0; }\n",
                 "union variants must agree on secrecy");
}

test "mach.lang.fe.sema:uni_secrecy_walk_memoizes_mutual_cycles" {
    val src: str = "rec A { b: B; }\nrec B { a: A; }\nuni U { x: A; y: u32; }\nfun main() i64 { ret 0; }\n";
    if (ut_sema_diag_has(src, "nests deeper than")) { ret 1; }
    if (!ut_sema_diag_has(src, "recursive type has infinite size")) { ret 1; }
    ret 0;
}

test "mach.lang.fe.sema:diagnostic_allocation_failure_is_internal_without_count_inference" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "rec N { self: N; }\nfun main() i64 { ret 0; }\n";

    val root_r: R.Result[str, str] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (R.is_err[str, str](root_r)) { ret 1; }
    val root: str = R.unwrap_ok[str, str](root_r);

    var s: session.Session;
    val pr: R.Result[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (R.is_err[project.Project, outcome.Fail](pr)) { session.dnit(?s); ret 1; }
    var p: project.Project = R.unwrap_ok[project.Project, outcome.Fail](pr);

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) { driver.dnit_project(?p); session.dnit(?s); ret 1; }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    var bad: i32 = 0;
    var saw_internal: bool = false;

    var ordinal: u64 = 1;
    for (ordinal <= 6) {
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) {
            driver.dnit_project(?p); session.dnit(?s); ret 1;
        }
        T.fail_at_ordinal(?failing, ordinal::usize);

        diagnostic.store_dnit(?s.diags);
        s.diags = diagnostic.store_init(T.allocator_of(?failing));

        val r: R.Result[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
        if (R.is_ok[context.SemaResult, fail.Fail](r)) {
            var res: context.SemaResult = R.unwrap_ok[context.SemaResult, fail.Fail](r);
            sema.dnit_result(?res);
        }

        if (R.is_err[context.SemaResult, fail.Fail](r)) {
            saw_internal = true;
            val f: fail.Fail = R.unwrap_err[context.SemaResult, fail.Fail](r);
            if (!sel f.message) { bad = 3; }
            if (!outcome.is_internal(outcome.from_fail(f))) { bad = 2; }
        }
        or (T.attempt_count(?failing) >= ordinal::usize) { bad = 100 + ordinal::i32; }

        diagnostic.store_dnit(?s.diags);
        s.diags = diagnostic.store_init(?backing);
        if (T.tracking_exhausted(?failing)) { bad = 5; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { bad = 6; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }

    if (!saw_internal) { bad = 4; }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

