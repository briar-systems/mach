#[testing]
fun ut_cc3_static(a: str, b: str) str {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret a; }
    ret ut_cc3(?backing, a, b, "");
}

#[testing]
fun ut_manifest() str {
    ret "[project]\nmach = \">=5\"\nid = \"semaharness\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.semaharness]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/semaharness\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
}

#[testing]
fun ut_scaffold(alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    val tf_r: res[fs.TempFile, fs.FsError] = fs.temp_create(alloc, "mach_sema_test");
    if (sel tf_r.err) { ret res[str, fail.Fail].err{fail.message("scaffold: temporary root could not be created")}; }
    var tf:    fs.TempFile       = tf_r.ok;
    val dup_r: res[str, A.Error] = str_dup(alloc, fs.temp_path(?tf));
    fs.temp_close_and_remove(?tf);
    if (sel dup_r.err) { ret res[str, fail.Fail].err{fail.refused(dup_r.err)}; }
    val root: str = dup_r.ok;

    val d1: err[fs.FsError] = fs.create_dir_all(alloc, root, 493);
    if (sel d1.err) { ret res[str, fail.Fail].err{fail.message("scaffold: project root could not be created")}; }
    val src_dir: str             = ut_cc3(alloc, root, "/", "src");
    val d2:      err[fs.FsError] = fs.create_dir_all(alloc, src_dir, 493);
    if (sel d2.err) { ret res[str, fail.Fail].err{fail.message("scaffold: source directory could not be created")}; }

    val mf:   str             = ut_cc3(alloc, root, "/", manifest.MANIFEST_FILE);
    val text: str             = ut_manifest();
    val w0:   err[fs.FsError] = fs.write_bytes(mf, text, str_len(text), 420);
    if (sel w0.err) { ret res[str, fail.Fail].err{fail.message("scaffold: manifest could not be written")}; }

    var i: u32 = 0;
    for (i < n) {
        val fp: str             = ut_cc3(alloc, src_dir, "/", names[i]);
        val w:  err[fs.FsError] = fs.write_bytes(fp, texts[i], str_len(texts[i]), 420);
        if (sel w.err) { ret res[str, fail.Fail].err{fail.message("scaffold: source file could not be written")}; }
        i = i + 1;
    }
    ret res[str, fail.Fail].ok{root};
}

#[testing]
fun ut_build(alloc: *A.Allocator, root: str, s: *session.Session) res[project.Project, outcome.Fail] {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) {
        ret res[project.Project, outcome.Fail].err{outcome.from_fail(sr.err)};
    }
    @s = sr.ok;
    val rr: err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        session.dnit(s);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }

    var pick: manifest.Selection;
    pick.target       = "";
    pick.profile      = "";
    pick.artifact     = "";
    pick.want_lib     = false;
    pick.has_artifact = false;
    val built: res[project.Project, outcome.Fail] = driver.build_project_sel(s, root, ?pick);
    if (sel built.err) { ret res[project.Project, outcome.Fail].err{built.err}; }
    ret res[project.Project, outcome.Fail].ok{built.ok};
}

#[testing]
fun ut_module(p: *project.Project, s: *session.Session, fqn: str) *project.ModuleEntry {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (mid == session.MODULE_NIL) { ret nil; }
    ret project.module_at(p, mid::u32);
}

#[testing]
rec FailProbe {
    backing:          A.Allocator;
    live:             i64;
    live_count:       i64;
    calls:            u32;
    fail_at:          u32;
    backing_failures: u32;
}

#[testing]
fun fp_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_allocate(p.backing.ctx, size, align);
    if (sel r.some) {
        p.live       = p.live + size::i64;
        p.live_count = p.live_count + 1;
        memory.raw_fill(r.some, 0xAA, size);
    }
    if (sel r.none) {
        p.backing_failures = p.backing_failures + 1;
    }
    ret r;
}

#[testing]
fun fp_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *FailProbe = ctx::*FailProbe;
    p.calls = p.calls + 1;
    if (p.fail_at != 0 && p.calls == p.fail_at) { ret opt[ptr].none{}; }
    val r: opt[ptr] = p.backing.fn_reallocate(p.backing.ctx, item, old_size, new_size, align);
    if (sel r.none) { p.backing_failures = p.backing_failures + 1; }
    if (sel r.some) {
        p.live = p.live - old_size::i64 + new_size::i64;
        if (new_size > old_size) {
            val grown: ptr = r.some;
            memory.raw_fill((grown::usize + old_size)::ptr, 0xAA, new_size - old_size);
        }
    }
    ret r;
}

#[testing]
fun fp_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *FailProbe = ctx::*FailProbe;
    p.live       = p.live - size::i64;
    p.live_count = p.live_count - 1;
    ret p.backing.fn_deallocate(p.backing.ctx, item, size, align);
}

#[testing]
fun fp_make(p: *FailProbe, alloc: *A.Allocator, fail_at: u32) bool {
    val made: err[A.Error] = page.make(?p.backing);
    if (sel made.err) { ret false; }
    p.live             = 0;
    p.live_count       = 0;
    p.calls            = 0;
    p.fail_at          = fail_at;
    p.backing_failures = 0;
    val probe: *FailProbe = p;
    alloc.ctx           = probe::ptr;
    alloc.fn_allocate   = fp_allocate;
    alloc.fn_reallocate = fp_reallocate;
    alloc.fn_deallocate = fp_deallocate;
    ret true;
}

test alloc_failure__sema_neither_leaks_nor_half_commits_a_fix {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 {\n    var x: i32 = 5;\n    var z: i32 = 3;\n    val y: i64 = x + z;\n    ret y;\n}\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val real_alloc: *A.Allocator = s.alloc;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) {
        s.alloc = real_alloc;
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    s.alloc = ?alloc0;
    val r0: res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: context.SemaResult = r0.ok;
        sema.dnit_result(?res0);
    }
    s.alloc = real_alloc;
    if (probe0.live != 0 || probe0.live_count != 0) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val total: u32 = probe0.calls;
    if (total == 0) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (!diagnostic.has_errors(?s.diags)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            val pre_len: usize = diagnostic.len(?s.diags);
            s.alloc = ?alloc;
            val r: res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
            if (sel r.ok) {
                var sema_result: context.SemaResult = r.ok;
                sema.dnit_result(?sema_result);
            }
            s.alloc = real_alloc;
            if (probe.live != 0 || probe.live_count != 0) {
                bad = true;
                print.print("LEAK at fail_at=");
                print.u64(fail_at::u64);
                print.print(" live=");
                print.u64(probe.live::u64);
                print.print(" live_count=");
                print.u64(probe.live_count::u64);
                print.print("\n");
            }
            val post_len: usize = diagnostic.len(?s.diags);
            var di:       usize = pre_len;
            for (di < post_len) {
                val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, di);
                if (sel d_r.some) {
                    val d: *diagnostic.Diagnostic = d_r.some;
                    if (d.fixes.len > 1) { bad = true; }
                    if (d.fixes.len == 1 && !diagnostic.fix_valid(?d.fixes.data[0])) {
                        bad = true;
                        print.print("HALF-COMMITTED FIX at fail_at=");
                        print.u64(fail_at::u64);
                        print.print("\n");
                    }
                }
                di = di + 1;
            }
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test alloc_failure__report_marks_the_status_internal {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val m: *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    if (diagnostic.has_errors(?s.diags)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var sc: context.SemaContext;
    sc.status           = fail.accepted();
    sc.s                = ?s;
    sc.diags            = ?s.diags;
    sc.a                = m.a;
    sc.silent           = false;
    sc.in_comptime_gate = false;

    var span: token.Span;
    span.offset = 0;
    span.len    = 0;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?alloc0);
    context.report(?sc, span, "probe: allocator-starved diagnostic");
    val total: u32 = probe0.calls;
    diagnostic.store_dnit(?s.diags);
    if (total == 0) {
        s.diags = diagnostic.store_init(?backing);
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            s.diags   = diagnostic.store_init(?alloc);
            sc.status = fail.accepted();
            context.report(?sc, span, "probe: allocator-starved diagnostic");
            if (!sel sc.status.kind.internal) { bad = true; }
            diagnostic.store_dnit(?s.diags);
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    s.diags = diagnostic.store_init(?backing);
    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test alloc_failure__real_error_still_rejects_the_module {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { ret \"not an integer\"; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?alloc0);
    val r0: res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: context.SemaResult = r0.ok;
        sema.dnit_result(?res0);
    }
    if (!diagnostic.has_errors(?s.diags)) {
        s.diags = diagnostic.store_init(?backing);
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val total: u32 = probe0.calls;
    diagnostic.store_dnit(?s.diags);
    if (total == 0) {
        s.diags = diagnostic.store_init(?backing);
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            s.diags = diagnostic.store_init(?alloc);
            val r: res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
            if (sel r.ok) {
                var sema_result: context.SemaResult = r.ok;
                if (sel sema_result.status.kind.accepted || probe.calls >= fail_at) { bad = true; }
                sema.dnit_result(?sema_result);
            }
            or (sel r.err) {
                if (!fail.is_message(r.err)) { bad = true; }
            }
            diagnostic.store_dnit(?s.diags);
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    s.diags = diagnostic.store_init(?backing);
    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

#[testing]
fun ut_sweep_registration_failure(s: *session.Session, m: *project.ModuleEntry, mid: session.ModuleId,
    target: *map.Map[u32, u32], backing: *A.Allocator) bool {
    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    map.dnit[u32, u32](target);
    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) { ret false; }
    @target = map.init[u32, u32](?alloc0);
    val r0: res[context.SemaResult, fail.Fail] = sema.sema(s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: context.SemaResult = r0.ok;
        sema.dnit_result(?res0);
    }
    val total: u32 = probe0.calls;
    if (total == 0)                      { ret false; }
    if (diagnostic.has_errors(?s.diags)) { ret false; }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (fp_make(?probe, ?alloc, fail_at)) {
            diagnostic.store_dnit(?s.diags);
            s.diags = diagnostic.store_init(backing);
            map.dnit[u32, u32](target);
            @target = map.init[u32, u32](?alloc);
            val r: res[context.SemaResult, fail.Fail] = sema.sema(s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
            if (sel r.ok) {
                var outcome: context.SemaResult = r.ok;
                if (sel outcome.status.kind.accepted || probe.calls >= fail_at) { bad = true; }
                sema.dnit_result(?outcome);
            }
        }
        or {
            bad = true;
        }
        fail_at = fail_at + 1;
    }

    map.dnit[u32, u32](target);
    @target = map.init[u32, u32](backing);
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(backing);
    ret !bad;
}

#[testing]
fun ut_registration_sweep(src: str, which: u8) i32 {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var target: *map.Map[u32, u32] = ?s.type_volatile;
    if (which == 1) { target = ?s.type_packed; }
    or (which == 2) { target = ?s.type_aligns; }
    val ok: bool = ut_sweep_registration_failure(?s, m, mid, target, ?backing);

    driver.dnit_project(?p);
    session.dnit(?s);
    if (!ok) { ret 1; }
    ret 0;
}

test alloc_failure__layout_registration_rejects_the_module {
    if (ut_registration_sweep("#[volatile]\nrec V { reg: u32; }\nfun main() i64 {\n    var v: V;\n    ret v.reg::i64;\n}\n", 0) != 0)  { ret 1; }
    if (ut_registration_sweep("#[packed]\nrec P { a: u8; b: u32; }\nfun main() i64 {\n    var p: P;\n    ret p.b::i64;\n}\n", 1) != 0) { ret 2; }
    if (ut_registration_sweep("#[align(16)]\nrec Q { x: u32; }\nfun main() i64 {\n    var q: Q;\n    ret q.x::i64;\n}\n", 2) != 0)     { ret 3; }
    ret 0;
}

test generic_param_type_for__respects_the_declaring_module {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    var names: [2]str = [2]str{"main.mach", "lib.mach"};
    var texts: [2]str = [2]str{
        "use semaharness.lib;\nfun same[T](x: T) T { ret x; }\nfun main() i32 { ret 0; }\n",
        "pub fun same[T](x: T) T { ret x; }\n"
    };
    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?backing, root); }
    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fin { session.dnit(?s); }
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val name_r: res[intern.StrId, A.Error] = intern.intern(?s.interner, "T");
    if (sel name_r.err) { ret 1; }
    var owners: [2]str = [2]str{"semaharness.main", "semaharness.lib"};
    var types:  [2]type.TypeId;
    var i:      u32    = 0;
    for (i < 2) {
        val mid: session.ModuleId     = ut_mid(?p, ?s, owners[i]);
        val m:   *project.ModuleEntry = ut_module(?p, ?s, owners[i]);
        if (m == nil || mid == session.MODULE_NIL) { ret 1; }
        var sc: context.SemaContext;
        sc.s          = ?s;
        sc.diags      = ?s.diags;
        sc.a          = m.a;
        sc.own_module = mid;
        sc.status     = fail.accepted();
        var sym: resolve.Symbol;
        sym.name   = name_r.ok;
        sym.origin = mid;
        sym.slot   = 0;
        sym.decl   = id.DECL_NIL;
        var di: usize = 0;
        for (di < m.a.decl_len) {
            if (m.a.decls[di].kind == decl.DECL_KIND_FUN && m.a.decls[di].data.fun_.generics_len == 1) {
                sym.decl = di::id.DeclId;
            }
            di = di + 1;
        }
        if (sym.decl == id.DECL_NIL) { ret 1; }
        types[i] = context.generic_param_type_for(?sc, ?sym);
        if (types[i] == type.TYPE_ERROR)                           { ret 1; }
        if (!sel sc.status.kind.accepted)                          { ret 1; }
        if (context.generic_param_type_for(?sc, ?sym) != types[i]) { ret 1; }
        i = i + 1;
    }
    if (types[0] == types[1]) { ret 1; }
    ret 0;
}

#[testing]
fun ut_sweep(src: str, forbidden: str) i32 {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val real_alloc: *A.Allocator = s.alloc;

    var probe0: FailProbe;
    var alloc0: A.Allocator;
    if (!fp_make(?probe0, ?alloc0, 0)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    s.alloc = ?alloc0;
    val pre0: usize                              = diagnostic.len(?s.diags);
    val r0:   res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: context.SemaResult = r0.ok;
        sema.dnit_result(?res0);
    }
    s.alloc = real_alloc;
    val total: u32 = probe0.calls;
    if (probe0.backing_failures != 0) {
        print.print("APPARATUS: the backing allocator failed during the baseline run; the sweep cannot tell a real failure from the injected one\n");
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (total == 0) {
        print.print("APPARATUS: the baseline run made no allocations\n");
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (diagnostic.len(?s.diags) == pre0) {
        print.print("APPARATUS: the baseline run reported nothing, so the fixture proves nothing\n");
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     i32 = 0;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        var probe: FailProbe;
        var alloc: A.Allocator;
        if (!fp_make(?probe, ?alloc, fail_at)) {
            driver.dnit_project(?p);
            session.dnit(?s);
            ret 1;
        }
        val pre: usize = diagnostic.len(?s.diags);
        s.alloc = ?alloc;
        val r:        res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
        val accepted: bool                               = sel r.ok;
        if (sel r.ok) {
            var sema_result: context.SemaResult = r.ok;
            sema.dnit_result(?sema_result);
        }
        s.alloc = real_alloc;
        if (probe.backing_failures != 0) {
            bad = 1;
            print.print("APPARATUS: the backing allocator failed at fail_at=");
            print.u64(fail_at::u64);
            print.print("; this is memory pressure, not a skipped check\n");
        }
        or (accepted && diagnostic.len(?s.diags) == pre) {
            bad = 1;
            print.print("SKIPPED CHECK at fail_at=");
            print.u64(fail_at::u64);
            print.print("\n");
        }
        if (str_len(forbidden) > 0) {
            var di: usize = pre;
            for (di < diagnostic.len(?s.diags)) {
                val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, di);
                if (sel d_r.some) {
                    if (ut_contains(d_r.some.message, forbidden)) {
                        bad = 1;
                        print.print("FORBIDDEN DIAGNOSTIC at fail_at=");
                        print.u64(fail_at::u64);
                        print.print("\n");
                    }
                }
                di = di + 1;
            }
        }
        fail_at = fail_at + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test alloc_failure__never_skips_a_type_check {
    if (ut_sweep("rec N { self: N; }\nfun main() i64 { ret 0; }\n", "") != 0)         { ret 1; }
    if (ut_sweep("uni U { a: ^u32; b: u32; }\nfun main() i64 { ret 0; }\n", "") != 0) { ret 2; }
    ret 0;
}

#[testing]
fun ut_nested_array_src(alloc: *A.Allocator, n: u32) str {
    val head:  str   = "rec K { f: ";
    val tail:  str   = "u8; }\nfun main() i64 { ret 0; }\n";
    val hl:    usize = str_len(head);
    val tl:    usize = str_len(tail);
    val total: usize = hl + (n::usize * 3) + tl + 1;

    val r: res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r.err) { ret ""; }
    val buf: *u8 = r.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < hl) {
        buf[k] = head[j];
        k      = k + 1;
        j      = j + 1;
    }
    var i: u32 = 0;
    for (i < n) {
        buf[k] = '[';
        k      = k + 1;
        buf[k] = '1';
        k      = k + 1;
        buf[k] = ']';
        k      = k + 1;
        i      = i + 1;
    }
    j = 0;
    for (j < tl) {
        buf[k] = tail[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = 0;
    ret buf::str;
}

#[testing]
fun ut_sema_diag_has(src: str, needle: str) bool {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret false; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val r: res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
    if (sel r.ok) {
        var sema_result: context.SemaResult = r.ok;
        sema.dnit_result(?sema_result);
    }

    var hit: bool  = false;
    var di:  usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, di);
        if (sel d_r.none) { ret false; }
        if (sel d_r.some) {
            if (ut_contains(d_r.some.message, needle)) { hit = true; }
        }
        di = di + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret hit;
}

#[testing]
fun ut_contains(hay: str, needle: str) bool {
    val hl: usize = str_len(hay);
    val nl: usize = str_len(needle);
    if (nl == 0) { ret true; }
    if (nl > hl) { ret false; }
    var i: usize = 0;
    for (i + nl <= hl) {
        var j: usize = 0;
        for (j < nl) {
            if (hay[i + j] != needle[j]) { brk; }
            j = j + 1;
        }
        if (j == nl) { ret true; }
        i = i + 1;
    }
    ret false;
}

test recursive_type__walk_is_depth_bounded {
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var bad: i32 = 0;

    val deep: str = ut_nested_array_src(?alloc, 1100);
    if (str_len(deep) == 0)                           { ret 1; }
    if (!ut_sema_diag_has(deep, "nests deeper than")) { bad = 1; }

    val shallow: str = ut_nested_array_src(?alloc, 1000);
    if (str_len(shallow) == 0)                          { ret 1; }
    if (ut_sema_diag_has(shallow, "nests deeper than")) { bad = 1; }

    ret bad;
}

test alloc_failure__uni_secrecy_scratch_never_degrades_the_walk {
    ret ut_sweep("rec V { u: U; }\nuni U { x: V; y: ^u32; }\nfun main() i64 { ret 0; }\n",
        "union variants must agree on secrecy");
}

test recursive_type__uni_secrecy_walk_memoizes_mutual_cycles {
    val src: str = "rec A { b: B; }\nrec B { a: A; }\nuni U { x: A; y: u32; }\nfun main() i64 { ret 0; }\n";
    if (ut_sema_diag_has(src, "nests deeper than"))                 { ret 1; }
    if (!ut_sema_diag_has(src, "recursive type has infinite size")) { ret 1; }
    ret 0;
}

test alloc_failure__diagnostic_store_is_internal {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "rec N { self: N; }\nfun main() i64 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = ut_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, outcome.Fail] = ut_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = ut_module(?p, ?s, "semaharness.main");
    if (m == nil || mid == session.MODULE_NIL) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: sema.SemaDeps = sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    var bad:          i32  = 0;
    var saw_internal: bool = false;

    var ordinal: u64 = 1;
    for (ordinal <= 6) {
        var failing: T.Testing;
        val make_2:  err[A.Error] = T.make(?failing);
        if (sel make_2.err) {
            driver.dnit_project(?p);
            session.dnit(?s);
            ret 1;
        }
        T.fail_at_ordinal(?failing, ordinal::usize);

        diagnostic.store_dnit(?s.diags);
        s.diags = diagnostic.store_init(T.allocator_of(?failing));

        val r: res[context.SemaResult, fail.Fail] = sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.ctx, mid, ?s.diags);
        if (sel r.ok) {
            var sema_result: context.SemaResult = r.ok;
            sema.dnit_result(?sema_result);
        }

        if (sel r.err) {
            saw_internal = true;
            val f: fail.Fail = r.err;
            if (!sel f.message)                             { bad = 3; }
            if (!outcome.is_internal(outcome.from_fail(f))) { bad = 2; }
        }
        or (T.attempt_count(?failing) >= ordinal::usize) { bad = 100 + ordinal::i32; }

        diagnostic.store_dnit(?s.diags);
        s.diags = diagnostic.store_init(?backing);
        if (T.tracking_exhausted(?failing))                           { bad = 5; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { bad = 6; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }

    if (!saw_internal) { bad = 4; }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

