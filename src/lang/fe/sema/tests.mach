    ret t_tag_corpus_range(29, 3);
}

test case_descriptor__enumeration {
    # `$cases(T)` walks declaration order; a descriptor answers name, has_payload, type, offset and code, and refuses storage questions about a payloadless case
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) u64 { $each c in $cases(Reply) { if (sel v.[c]) { ret c.code; } } ret 99; }"))                                                                                                                            { ret 1; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(Reply) { $if (c.has_payload) { n = n + c.offset; } $or { n = n + 1; } } ret n; }"))                                                                                       { ret 2; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { $if (c.has_payload) { $if (c.type == i64) {} $or { $error(\"type\"); } } } ret 0; }"))                                                                                           { ret 4; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { $if (c.has_payload) { $if (c.code == 1) {} $or { $error(\"code\"); } } $or { $if (c.code == 0) {} $or { $error(\"code0\"); } } } ret 0; }"))                                     { ret 5; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Box[Reply]) { $if (c.has_payload) { $if (c.type == Reply) {} $or { $error(\"specialized\"); } $if (c.offset == 8) {} $or { $error(\"offset\"); } } } ret 0; }"))                          { ret 7; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\ndef R: Box[u32];\nfun f() u64 { $each c in $cases(R) { $if (c.has_payload) { $if (c.type == u32) {} $or { $error(\"alias\"); } } } ret 0; }"))                                                                            { ret 8; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(p: *u8) u64 { var n: u64 = 0; $each c in $cases(Reply) { val s: *u8 = c.name; if (s[0] != 0) { n = n + 1; } } ret n; }"))                                                                                           { ret 9; }
    if (!ut_sema_clean("tag Secretive: u8 { failed: i32; value: ^u64; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(Secretive) { $if (c.has_payload) { $if ($is_secret(c.type)) { n = n + 1; } $or (c.type == i32) { n = n + 1; } $or { $error(\"qualifier\"); } } } ret n; }"))                                                                            { ret 10; }
    if (!ut_sema_clean("tag Secretive: u8 { failed: i32; value: ^u64; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(Secretive) { $if (c.has_payload) { $if (c.type == u64) { $error(\"stripped\"); } $or { n = n + 1; } } } ret n; }"))                                                                                                                     { ret 17; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\nfun take[T](v: T) u64 { ret 1; }\nfun f(v: Reply) u64 { $each c in $cases(Reply) { if (sel v.[c]) { ret take[c.type](0); } } ret 0; }", "this case has no payload, so it has no `.type` or `.offset`"))                                                                                     { ret 18; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun count[T]() u64 { var n: u64 = 0; $each c in $cases(T) { n = n + 1; } ret n; }\nfun g() u64 { ret count[Reply]() + count[Box[u8]](); }"))                                                                              { ret 11; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Holder { r: Reply; n: u8; }\nfun f(h: Holder) i64 { $each f in $fields(Holder) { $if ($is_tag(f.type)) { $each c in $cases(f.type) { $if (c.has_payload) { if (sel h.[f].[c]) { ret h.[f].[c]; } } } } } ret -1; }")) { ret 12; }
    if (!ut_sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun f() u64 { $each c in $cases(res[i64, u32]) { $if (c.has_payload) { $if (c.type == i64) { $if (c.code == 1) {} $or { $error(\"ok code\"); } } } } ret 0; }"))                                                                  { ret 13; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($is_tag(Reply)) {} $or { $error(\"tag\"); }\n$if ($is_tag(^Reply)) { $error(\"secret shape\"); }"))                                                                                                                  { ret 16; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(^Reply) { n = n + 1; } ret n; }", "`$cases` refuses `^Reply`"))                                                                                                    { ret 17; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f() u64 { var n: u64 = 0; $each c in $cases(P) { n = n + 1; } ret n; }", "`$cases` requires a tag type"))                                                                                    { ret 18; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { var n: u64 = 0; $each c in $fields(Reply) { n = n + 1; } ret n; }", "$fields requires a record type"))                                                                                               { ret 19; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { ret c.offset; } ret 0; }", "this case has no payload, so it has no `.type` or `.offset`"))                                                                                { ret 21; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { $each c in $cases(Reply) { ret c.size; } ret 0; }", "a case descriptor has only `.name`, `.has_payload`, `.type`, `.offset`, and `.code`"))                                                          { ret 23; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u8 { $each c in $cases(Reply) { ret c.has_payload; } ret 0; }", "`case.has_payload` is a comptime predicate"))                                                                                             { ret 24; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f() u64 { $each f in $fields(P) { ret f.code; } ret 0; }", "a field descriptor has only `.name`, `.type`, and `.offset`"))                                                                   { ret 25; }
    ret 0;
}

test case_descriptor__projection_obeys_guard_rules {
    # `sel v.[c]` opens the same guard as `sel v.c`, and `v.[c]` is the same payload place
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c]) { ret v.[c]; } } } ret -1; }"))                                                                                                                      { ret 1; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c] && v.[c] > 3) { ret 1; } } } ret -1; }"))                                                                                                             { ret 2; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (!sel v.[c]) { ret -1; } ret v.[c]; } } ret -2; }"))                                                                                                             { ret 3; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { if (sel v.[c]) { $if (c.has_payload) { ret v.[c]; } } } ret -1; }"))                                                                                                                      { ret 4; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: *Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel (@v).[c]) { (@v).[c] = 2; val q: *i64 = ?(@v).[c]; ret @q; } } } ret -1; }"))                                                                              { ret 5; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\ntag Outer: u8 { none; inner: Reply; }\nfun f(o: Outer) i64 { $each c in $cases(Outer) { $if (c.has_payload) { if (sel o.[c]) { if (sel o.[c].value) { ret o.[c].value; } } } } ret -1; }"))                                                { ret 6; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c]) { if (sel v.value) { ret v.value + v.[c]; } } } } ret -1; }"))                                                                                       { ret 7; }
    if (!ut_sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun f(r: res[i64, u32]) i64 { $each c in $cases(res[i64, u32]) { $if (c.has_payload) { $if (c.type == i64) { if (sel r.[c]) { ret r.[c]; } } } } ret -1; }"))                                                                                      { ret 9; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { ret v.[c]; } } ret 0; }", "a tag payload requires a `sel` guard for its case"))                                                                              { ret 10; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { if (sel v.[c]) { ret v.[c]; } } ret 0; }", "this tag case takes no payload"))                                                                                                      { ret 11; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c] && v.[c] > 3) { ret v.[c]; } } } ret 0; }", "a tag payload requires a `sel` guard for its case"))                                              { ret 12; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.[c] || v.[c] > 3) { ret 1; } } } ret 0; }", "a tag payload requires a `sel` guard for its case"))                                                  { ret 13; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Reply) i64 { $each c in $cases(Reply) { if (sel v.[c]) { v = Reply.empty{}; } } ret 0; }", "cannot assign to this place inside a guard"))                                                                                  { ret 14; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: ^Reply) u8 { $each c in $cases(Reply) { if (sel v.[c]) { ret 1; } } ret 0; }", "`sel` cannot test `^Reply`"))                                                                                                              { ret 15; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n#[packed] tag Pk: u8 { a; b: u32; }\nfun f(v: Pk) u32 { $each c in $cases(Pk) { $if (c.has_payload) { if (sel v.[c]) { val q: *u32 = ?v.[c]; ret @q; } } } ret 0; }", "cannot take the address of a payload of a `#[packed]` tag")) { ret 16; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() i64 { $each c in $cases(Reply) { if (sel make().[c]) { ret 1; } } ret 0; }\nfun make() Reply { ret Reply.empty{}; }", "`sel` tests a place"))                                                                               { ret 17; }
    ret 0;
}

test case_descriptor__construction_and_foreign_owners {
    # `T.[c]{...}` constructs through the single-case rule; a descriptor from another nominal type or generic instantiation is refused in every position
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{1}; } } ret Reply.empty{}; }"))                                                                                     { ret 1; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) {} $or { ret Reply.[c]{}; } } ret Reply.empty{}; }"))                                                                               { ret 2; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun build[T](x: T) Box[T] { $each c in $cases(Box[T]) { $if (c.has_payload) { ret Box[T].[c]{x}; } } ret Box[T].none{}; }\nfun g() Box[u32] { ret build[u32](7); }"))                              { ret 3; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\ndef R: Box[u32];\nfun f() R { $each c in $cases(R) { $if (c.has_payload) { ret R.[c]{7}; } } ret R.none{}; }"))                                                                                    { ret 4; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nval g: Reply = Reply.value{42};\nfun f() i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel g.[c]) { ret g.[c]; } } } ret 0; }"))                                                      { ret 6; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { ret Reply.[c]{1}; } ret Reply.empty{}; }", "this tag case takes no payload"))                                                                    { ret 7; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{}; } } ret Reply.empty{}; }", "this tag case requires a payload"))                                           { ret 8; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{1, 2}; } } ret Reply.empty{}; }", "a tag case carries exactly one payload"))                                 { ret 9; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Reply { $each c in $cases(Reply) { $if (c.has_payload) { ret Reply.[c]{1u32}; } } ret Reply.empty{}; }", "type mismatch"))                                                          { ret 10; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Other { $each c in $cases(Reply) { $if (c.has_payload) { ret Other.[c]{1}; } } ret Other.empty{}; }", "this case descriptor belongs to `Reply`"))                                   { ret 11; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() Box[u64] { $each c in $cases(Box[u32]) { $if (c.has_payload) { ret Box[u64].[c]{1}; } } ret Box[u64].none{}; }", "this case descriptor belongs to `Box[u32]`"))                     { ret 12; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Other) i64 { $each c in $cases(Reply) { if (sel v.[c]) { ret 1; } } ret 0; }", "this case descriptor belongs to `Reply`"))                                                         { ret 13; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Box[u64]) u64 { $each c in $cases(Box[u32]) { if (sel v.[c]) { ret 1; } } ret 0; }", "this case descriptor belongs to `Box[u32]`"))                                                { ret 14; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f(v: Other) i64 { $each c in $cases(Reply) { $if (c.has_payload) { if (sel v.value) { ret v.[c]; } } } ret 0; }", "the instance type does not match the case descriptor's owning tag")) { ret 15; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f(v: Reply) u8 { $each c in $fields(P) { if (sel v.[c]) { ret 1; } } ret 0; }", "must be a comptime case descriptor"))                                                { ret 16; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f() Reply { $each c in $fields(P) { ret Reply.[c]{1}; } ret Reply.empty{}; }", "must be a comptime case descriptor"))                                                 { ret 17; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec P { a: u8; }\nfun f(p: P) u8 { $each c in $cases(Reply) { $if (c.has_payload) { ret p.[c]; } } ret 0; }", "the instance type does not match the case descriptor's owning tag"))         { ret 18; }
    ret 0;
}

test offset_of__folds_from_the_checked_layout {
    # `$offset_of(T, payload_case)` and record offsets fold in gates and type positions from the one checked layout
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($offset_of(Reply, value) == 8) {} $or { $error(\"offset\"); }"))                                                                                                                    { ret 1; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n#[packed] tag Pk: u8 { a; b: u32; }\n$if ($offset_of(Pk, b) == 1) {} $or { $error(\"packed\"); }"))                                                                                      { ret 2; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($offset_of(Box[u8], some) == 1) {} $or { $error(\"generic\"); }\n$if ($offset_of(Box[u64], some) == 8) {} $or { $error(\"generic\"); }"))                                           { ret 3; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Pair { a: u8; b: u64; }\n$if ($offset_of(Pair, b) == 8) {} $or { $error(\"record\"); }"))                                                                                            { ret 4; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Holder { buf: [$offset_of(Reply, value)]u8; }\n$if ($size_of(Holder) == 8) {} $or { $error(\"type position\"); }"))                                                                  { ret 6; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($size_of(Reply) == 16) {} $or { $error(\"size\"); }\n$if ($align_of(Reply) == 8) {} $or { $error(\"align\"); }\n$if ($size_of(^Reply) == 16) {} $or { $error(\"secret size\"); }")) { ret 7; }
    if (!ut_sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\n$if ($offset_of(res[i64, u32], ok) == 8) {} $or { $error(\"res\"); }\n$if ($offset_of(opt[u8], some) == 1) {} $or { $error(\"opt\"); }"))                                                        { ret 8; }
    if (!ut_sema_clean("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun of[T]() u64 { ret $offset_of(Box[T], some); }\nfun g() u64 { ret of[u64](); }"))                                                                                                     { ret 9; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { ret $offset_of(Reply, empty); }", "has no payload, so it has no offset"))                                                                                           { ret 10; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\n$if ($offset_of(Reply, empty) == 0) {}", "has no payload, so it has no offset"))                                                                                                  { ret 11; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { ret $offset_of(Reply, nope); }", "unknown tag case `nope`"))                                                                                                        { ret 12; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nrec Pair { a: u8; }\nfun f() u64 { ret $offset_of(Pair, nope); }", "no such field `nope`"))                                                                                       { ret 13; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\nfun f() u64 { ret $offset_of(Reply, 1); }", "`$offset_of` names its member by a bare identifier"))                                                                                { ret 14; }
    ret 0;
}

