#[testing]
fun t_cc3_static(a: str, b: str) str {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret a; }
    ret ut_cc3(?backing, a, b, "");
}

#[testing]
fun t_manifest() str {
    ret on_host("[project]\nmach = \">=5\"\nid = \"semaharness\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[artifact.semaharness]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/semaharness\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n");
}

#[testing]
fun t_scaffold(alloc: *A.Allocator, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    ret t_scaffold_with(alloc, t_manifest(), names, texts, n);
}

# a project of the `n` sources under the manifest `text`
#[testing]
fun t_scaffold_with(alloc: *A.Allocator, text: str, names: *str, texts: *str, n: u32) res[str, fail.Fail] {
    ret driver.scaffold(alloc, text, names, texts, n);
}

#[testing]
fun t_build(alloc: *A.Allocator, root: str, s: *session.Session) res[project.Project, fail.Fail] {
    ret t_build_for(alloc, root, s, "");
}

# the project at `root` built for the target named `target`, the default one when empty
#[testing]
fun t_build_for(alloc: *A.Allocator, root: str, s: *session.Session, target: str) res[project.Project, fail.Fail] {
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(alloc);
    if (sel sr.err) {
        ret res[project.Project, fail.Fail].err{sr.err};
    }
    @s = sr.ok;

    var pick:  manifest.Selectors              = manifest.t_selectors("", target, "");
    val built: res[project.Project, fail.Fail] = step.project_build(s, root, ?pick);
    if (sel built.err) { ret res[project.Project, fail.Fail].err{built.err}; }
    ret res[project.Project, fail.Fail].ok{built.ok};
}

#[testing]
fun t_module(p: *project.Project, s: *session.Session, fqn: str) *project.ModuleEntry {
    val mid: session.ModuleId = ut_mid(p, s, fqn);
    if (module.is_nil(mid)) { ret nil; }
    ret project.module_at(p, mid::u32);
}

# refuse the `n`th request from now
# ---
# ret: the attempt count the ordinal counts from
#[testing]
fun refuse_after(t: *T.Testing, n: u32) usize {
    val start: usize = T.attempt_count(t);
    T.fail_at_ordinal(t, start + n::usize);
    ret start;
}

# requests the backing itself refused: neither injected nor served
#[testing]
fun backing_refusals(t: *T.Testing) usize {
    ret T.attempt_count(t) - T.refused_count(t) - T.total_count(t);
}

test alloc_failure__sema_neither_leaks_nor_half_commits_a_fix {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 {\n    var x: i32 = 5;\n    var z: i32 = 3;\n    val y: i64 = x + z;\n    ret y;\n}\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || module.is_nil(mid)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val real_alloc: *A.Allocator = s.alloc;

    var t:      T.Testing;
    val made_t: err[A.Error] = T.make(?t);
    if (sel made_t.err) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    fin { T.dnit(?t); }
    s.alloc = T.allocator_of(?t);
    val r0: res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: sema_product.SemaResult = r0.ok;
        fe_sema.result_dnit(?res0);
    }
    s.alloc = real_alloc;
    if (!T.clean(?t)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val total: u32 = T.attempt_count(?t)::u32;
    if (total == 0) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (!diagnostic.has_errors(?s.diags)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        refuse_after(?t, fail_at);
        val pre_len: usize = diagnostic.len(?s.diags);
        s.alloc = T.allocator_of(?t);
        val r: res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
        if (sel r.ok) {
            var sema_result: sema_product.SemaResult = r.ok;
            fe_sema.result_dnit(?sema_result);
        }
        s.alloc = real_alloc;
        T.clear_failure(?t);
        if (!T.clean(?t)) {
            bad = true;
            print.print("LEAK at fail_at=");
            print.u64(fail_at::u64);
            print.print(" live_count=");
            print.u64(T.live_count(?t)::u64);
            print.print("\n");
        }
        val post_len: usize = diagnostic.len(?s.diags);
        var di:       usize = pre_len;
        for (di < post_len) {
            val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, di);
            if (sel d_r.some) {
                val d: *diagnostic.Diagnostic = d_r.some;
                if (d.fixes.len > 1) { bad = true; }
                if (d.fixes.len == 1 && !diagnostic.fix_valid(?d.fixes.data[0])) {
                    bad = true;
                    print.print("HALF-COMMITTED FIX at fail_at=");
                    print.u64(fail_at::u64);
                    print.print("\n");
                }
            }
            di = di + 1;
        }
        fail_at = fail_at + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test alloc_failure__report_marks_the_status_internal {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val m: *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    if (diagnostic.has_errors(?s.diags)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var view: sema_context.ModuleView = sema_context.ModuleView{};
    view.a = m.a;
    var sc: sema_context.SemaContext = sema_context.init(?s, ?s.diags, sema_context.Typing{}, view, sema_context.instance_none());

    var span: lang_source.Span;
    span.offset = 0;
    span.len    = 0;

    var t:      T.Testing;
    val made_t: err[A.Error] = T.make(?t);
    if (sel made_t.err) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    fin { T.dnit(?t); }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(T.allocator_of(?t));
    val base: usize = T.attempt_count(?t);
    sema_context.report(?sc, diagnostic_kind.SECRET_NOT_OBLIVIOUS, span, "probe: allocator-starved diagnostic");
    val total: u32 = (T.attempt_count(?t) - base)::u32;
    diagnostic.store_dnit(?s.diags);
    if (total == 0) {
        s.diags = diagnostic.store_init(?backing);
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        s.diags = diagnostic.store_init(T.allocator_of(?t));
        refuse_after(?t, fail_at);
        sc.status = fail.accepted();
        sema_context.report(?sc, diagnostic_kind.SECRET_NOT_OBLIVIOUS, span, "probe: allocator-starved diagnostic");
        T.clear_failure(?t);
        if (!sel sc.status.kind.internal) { bad = true; }
        diagnostic.store_dnit(?s.diags);
        fail_at = fail_at + 1;
    }

    s.diags = diagnostic.store_init(?backing);
    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

test alloc_failure__real_error_still_rejects_the_module {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { ret \"not an integer\"; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || module.is_nil(mid)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    var t:      T.Testing;
    val made_t: err[A.Error] = T.make(?t);
    if (sel made_t.err) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    fin { T.dnit(?t); }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(T.allocator_of(?t));
    val base: usize                                   = T.attempt_count(?t);
    val r0:   res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: sema_product.SemaResult = r0.ok;
        fe_sema.result_dnit(?res0);
    }
    if (!diagnostic.has_errors(?s.diags)) {
        s.diags = diagnostic.store_init(?backing);
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    val total: u32 = (T.attempt_count(?t) - base)::u32;
    diagnostic.store_dnit(?s.diags);
    if (total == 0) {
        s.diags = diagnostic.store_init(?backing);
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        s.diags = diagnostic.store_init(T.allocator_of(?t));
        val start: usize                                   = refuse_after(?t, fail_at);
        val r:     res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
        T.clear_failure(?t);
        if (sel r.ok) {
            var sema_result: sema_product.SemaResult = r.ok;
            if (sel sema_result.status.kind.accepted || T.attempt_count(?t) - start >= fail_at::usize) { bad = true; }
            fe_sema.result_dnit(?sema_result);
        }
        or (sel r.err) {
            if (!fail.is_message(r.err)) { bad = true; }
        }
        diagnostic.store_dnit(?s.diags);
        fail_at = fail_at + 1;
    }

    s.diags = diagnostic.store_init(?backing);
    driver.dnit_project(?p);
    session.dnit(?s);
    if (bad) { ret 1; }
    ret 0;
}

#[testing]
fun t_sweep_registration_failure(s: *session.Session, m: *project.ModuleEntry, mid: session.ModuleId,
    target: *map.Map[u32, u32], backing: *A.Allocator) bool {
    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    map.dnit[u32, u32](target);
    var t:      T.Testing;
    val made_t: err[A.Error] = T.make(?t);
    if (sel made_t.err) {
        @target = map.init[u32, u32](backing);
        ret false;
    }
    fin { T.dnit(?t); }
    @target = map.init[u32, u32](T.allocator_of(?t));
    val base: usize                                   = T.attempt_count(?t);
    val r0:   res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: sema_product.SemaResult = r0.ok;
        fe_sema.result_dnit(?res0);
    }
    val total: u32 = (T.attempt_count(?t) - base)::u32;
    if (total == 0 || diagnostic.has_errors(?s.diags)) {
        map.dnit[u32, u32](target);
        @target = map.init[u32, u32](backing);
        ret false;
    }

    var bad:     bool = false;
    var fail_at: u32  = 1;
    for (fail_at <= total) {
        diagnostic.store_dnit(?s.diags);
        s.diags = diagnostic.store_init(backing);
        map.dnit[u32, u32](target);
        @target = map.init[u32, u32](T.allocator_of(?t));
        val start: usize                                   = refuse_after(?t, fail_at);
        val r:     res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
        T.clear_failure(?t);
        if (sel r.ok) {
            var outcome: sema_product.SemaResult = r.ok;
            if (sel outcome.status.kind.accepted || T.attempt_count(?t) - start >= fail_at::usize) { bad = true; }
            fe_sema.result_dnit(?outcome);
        }
        fail_at = fail_at + 1;
    }

    map.dnit[u32, u32](target);
    @target = map.init[u32, u32](backing);
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(backing);
    ret !bad;
}

#[testing]
fun t_registration_sweep(src: str, which: u8) i32 {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || module.is_nil(mid)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var target: *map.Map[u32, u32] = ?s.type_volatile;
    if (which == 1) { target = ?s.type_packed; }
    or (which == 2) { target = ?s.type_aligns; }
    val ok: bool = t_sweep_registration_failure(?s, m, mid, target, ?backing);

    driver.dnit_project(?p);
    session.dnit(?s);
    if (!ok) { ret 1; }
    ret 0;
}

test alloc_failure__layout_registration_rejects_the_module {
    if (t_registration_sweep("#[volatile]\nrec V { reg: u32; }\nfun main() i64 {\n    var v: V;\n    ret v.reg::i64;\n}\n", 0) != 0)  { ret 1; }
    if (t_registration_sweep("#[packed]\nrec P { a: u8; b: u32; }\nfun main() i64 {\n    var p: P;\n    ret p.b::i64;\n}\n", 1) != 0) { ret 2; }
    if (t_registration_sweep("#[align(16)]\nrec Q { x: u32; }\nfun main() i64 {\n    var q: Q;\n    ret q.x::i64;\n}\n", 2) != 0)     { ret 3; }
    ret 0;
}

test generic_param_type_for__respects_the_declaring_module {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    var names: [2]str = [2]str{"main.mach", "lib.mach"};
    var texts: [2]str = [2]str{
        "use semaharness.lib;\nfun same[T](x: T) T { ret x; }\nfun main() i32 { ret 0; }\n",
        "pub fun same[T](x: T) T { ret x; }\n"
    };
    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?backing, root); }
    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fin { session.dnit(?s); }
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val name_r: res[intern.StrId, A.Error] = intern.add(?s.interner, "T");
    if (sel name_r.err) { ret 1; }
    var owners: [2]str = [2]str{"semaharness.main", "semaharness.lib"};
    var types:  [2]type.TypeId;
    var i:      u32    = 0;
    for (i < 2) {
        val mid: session.ModuleId     = ut_mid(?p, ?s, owners[i]);
        val m:   *project.ModuleEntry = t_module(?p, ?s, owners[i]);
        if (m == nil || module.is_nil(mid)) { ret 1; }
        var view: sema_context.ModuleView = sema_context.ModuleView{};
        view.a          = m.a;
        view.own_module = mid;
        var sc:  sema_context.SemaContext = sema_context.init(?s, ?s.diags, sema_context.Typing{}, view, sema_context.instance_none());
        var sym: resolve.Symbol;
        sym.name   = name_r.ok;
        sym.origin = mid;
        sym.slot   = 0;
        sym.decl   = ast_id.DECL_NIL;
        var di: usize = 0;
        for (di < m.a.decl_len) {
            if (m.a.decls[di].kind == ast_decl.DECL_KIND_FUN && m.a.decls[di].data.fun_.generics_len == 1) {
                sym.decl = ast_id.decl(di::u32);
            }
            di = di + 1;
        }
        if (ast_id.decl_is_nil(sym.decl)) { ret 1; }
        types[i] = sema_context.generic_param_type_for(?sc, ?sym);
        if (type.is_error(types[i]))                                              { ret 1; }
        if (!sel sc.status.kind.accepted)                                         { ret 1; }
        if (!type.same(sema_context.generic_param_type_for(?sc, ?sym), types[i])) { ret 1; }
        i = i + 1;
    }
    if (type.same(types[0], types[1])) { ret 1; }
    ret 0;
}

#[testing]
fun t_sweep(src: str, forbidden: str) i32 {
    ret t_sweep_for(t_manifest(), "", src, forbidden);
}

# the sweep over a project of manifest `text`, built for `target`
#[testing]
fun t_sweep_for(text: str, target: str, src: str, forbidden: str) i32 {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: res[str, fail.Fail] = t_scaffold_with(?backing, text, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build_for(?backing, root, ?s, target);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || module.is_nil(mid)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val real_alloc: *A.Allocator = s.alloc;

    var t:      T.Testing;
    val made_t: err[A.Error] = T.make(?t);
    if (sel made_t.err) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    fin { T.dnit(?t); }
    s.alloc = T.allocator_of(?t);
    val pre0: usize                                   = diagnostic.len(?s.diags);
    val r0:   res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
    if (sel r0.ok) {
        var res0: sema_product.SemaResult = r0.ok;
        fe_sema.result_dnit(?res0);
    }
    s.alloc = real_alloc;
    val total: u32 = T.attempt_count(?t)::u32;
    if (backing_refusals(?t) != 0) {
        print.print("APPARATUS: the backing allocator failed during the baseline run; the sweep cannot tell a real failure from the injected one\n");
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (total == 0) {
        print.print("APPARATUS: the baseline run made no allocations\n");
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }
    if (diagnostic.len(?s.diags) == pre0) {
        print.print("APPARATUS: the baseline run reported nothing, so the fixture proves nothing\n");
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var bad:     i32 = 0;
    var fail_at: u32 = 1;
    for (fail_at <= total) {
        refuse_after(?t, fail_at);
        # each run reports into its own store: the session's store keeps one copy
        # of a report, so a repeat run would add nothing to it
        var run: diagnostic.DiagnosticStore = diagnostic.store_init(real_alloc);
        s.alloc = T.allocator_of(?t);
        val r:        res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?run);
        val accepted: bool                                    = sel r.ok;
        if (sel r.ok) {
            var sema_result: sema_product.SemaResult = r.ok;
            fe_sema.result_dnit(?sema_result);
        }
        s.alloc = real_alloc;
        T.clear_failure(?t);
        if (backing_refusals(?t) != 0) {
            bad = 1;
            print.print("APPARATUS: the backing allocator failed at fail_at=");
            print.u64(fail_at::u64);
            print.print("; this is memory pressure, not a skipped check\n");
        }
        or (accepted && diagnostic.len(?run) == 0) {
            bad = 1;
            print.print("SKIPPED CHECK at fail_at=");
            print.u64(fail_at::u64);
            print.print("\n");
        }
        if (str_len(forbidden) > 0) {
            var di: usize = 0;
            for (di < diagnostic.len(?run)) {
                val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?run, di);
                if (sel d_r.some) {
                    if (t_contains(d_r.some.message, forbidden)) {
                        bad = 1;
                        print.print("FORBIDDEN DIAGNOSTIC at fail_at=");
                        print.u64(fail_at::u64);
                        print.print("\n");
                    }
                }
                di = di + 1;
            }
        }
        diagnostic.store_dnit(?run);
        fail_at = fail_at + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test alloc_failure__never_skips_a_type_check {
    if (t_sweep("rec N { self: N; }\nfun main() i64 { ret 0; }\n", "") != 0)         { ret 1; }
    if (t_sweep("uni U { a: ^u32; b: u32; }\nfun main() i64 { ret 0; }\n", "") != 0) { ret 2; }
    ret 0;
}

#[testing]
val UT_SPIRV_MANIFEST: str = "[project]\nmach = \">=5\"\nid = \"semaharness\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.spirv]\nisa = \"spirv\"\nos = \"freestanding\"\nabi = \"spirv\"\n\n[artifact.semaharness]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/semaharness\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = false\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n";

# an `op` declaration's refusals survive an allocation failure while the message is
# built: the operand-relation, the texel-count and the data-type refusal each either
# report or fail the phase, never accept the declaration
test alloc_failure__op_refusals_never_accept {
    if (t_sweep_for(UT_SPIRV_MANIFEST, "spirv", "#[handle(\"spirv\", \"image\", 2, 1, 0, 0, 0, 2, 33)]\npub def UImage2D;\n#[op(\"spirv\", \"core\", \"OpImageWrite\")] fun bad(img: UImage2D, at: i32x2, texel: f32x4);\n", "") != 0) { ret 1; }
    if (t_sweep_for(UT_SPIRV_MANIFEST, "spirv", "#[handle(\"spirv\", \"image\", 2, 1, 0, 0, 0, 2, 33)]\npub def UImage2D;\n#[op(\"spirv\", \"core\", \"OpImageRead\")] fun bad(img: UImage2D, at: i32x2) u32x2;\n", "") != 0)          { ret 2; }
    if (t_sweep_for(UT_SPIRV_MANIFEST, "spirv", "#[op(\"spirv\", \"core\", \"OpAtomicIAdd\")] fun bad(p: *f32, scope: u32, sem: u32, v: f32) f32;\n", "") != 0)                                                                        { ret 3; }
    ret 0;
}

#[testing]
fun t_nested_array_src(alloc: *A.Allocator, n: u32) str {
    val head:  str   = "rec K { f: ";
    val tail:  str   = "u8; }\nfun main() i64 { ret 0; }\n";
    val hl:    usize = str_len(head);
    val tl:    usize = str_len(tail);
    val total: usize = hl + (n::usize * 3) + tl + 1;

    val r: res[*u8, A.Error] = A.allocate[u8](alloc, total);
    if (sel r.err) { ret ""; }
    val buf: *u8 = r.ok;

    var k: usize = 0;
    var j: usize = 0;
    for (j < hl) {
        buf[k] = head[j];
        k      = k + 1;
        j      = j + 1;
    }
    var i: u32 = 0;
    for (i < n) {
        buf[k] = '[';
        k      = k + 1;
        buf[k] = '1';
        k      = k + 1;
        buf[k] = ']';
        k      = k + 1;
        i      = i + 1;
    }
    j = 0;
    for (j < tl) {
        buf[k] = tail[j];
        k      = k + 1;
        j      = j + 1;
    }
    buf[k] = 0;
    ret buf::str;
}

#[testing]
fun t_sema_diag_has(src: str, needle: str) bool {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret false; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;

    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || module.is_nil(mid)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }

    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    val r: res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
    if (sel r.ok) {
        var sema_result: sema_product.SemaResult = r.ok;
        fe_sema.result_dnit(?sema_result);
    }

    var hit: bool  = false;
    var di:  usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, di);
        if (sel d_r.none) { ret false; }
        if (sel d_r.some) {
            if (t_contains(d_r.some.message, needle)) { hit = true; }
        }
        di = di + 1;
    }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret hit;
}

#[testing]
fun t_contains(hay: str, needle: str) bool {
    val hl: usize = str_len(hay);
    val nl: usize = str_len(needle);
    if (nl == 0) { ret true; }
    if (nl > hl) { ret false; }
    var i: usize = 0;
    for (i + nl <= hl) {
        var j: usize = 0;
        for (j < nl) {
            if (hay[i + j] != needle[j]) { brk; }
            j = j + 1;
        }
        if (j == nl) { ret true; }
        i = i + 1;
    }
    ret false;
}

test recursive_type__walk_is_depth_bounded {
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var bad: i32 = 0;

    val deep: str = t_nested_array_src(?alloc, 1100);
    if (str_len(deep) == 0)                          { ret 1; }
    if (!t_sema_diag_has(deep, "nests deeper than")) { bad = 1; }

    val shallow: str = t_nested_array_src(?alloc, 1000);
    if (str_len(shallow) == 0)                         { ret 1; }
    if (t_sema_diag_has(shallow, "nests deeper than")) { bad = 1; }

    ret bad;
}

test alloc_failure__uni_secrecy_scratch_never_degrades_the_walk {
    ret t_sweep("rec V { u: U; }\nuni U { x: V; y: ^u32; }\nfun main() i64 { ret 0; }\n",
        "union variants must agree on secrecy");
}

test recursive_type__uni_secrecy_walk_memoizes_mutual_cycles {
    val src: str = "rec A { b: B; }\nrec B { a: A; }\nuni U { x: A; y: u32; }\nfun main() i64 { ret 0; }\n";
    if (t_sema_diag_has(src, "nests deeper than"))                 { ret 1; }
    if (!t_sema_diag_has(src, "recursive type has infinite size")) { ret 1; }
    ret 0;
}

test alloc_failure__diagnostic_store_is_internal {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }

    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "rec N { self: N; }\nfun main() i64 { ret 0; }\n";

    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;

    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || module.is_nil(mid)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret 1;
    }

    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;

    var bad:          i32  = 0;
    var saw_internal: bool = false;

    var ordinal: u64 = 1;
    for (ordinal <= 6) {
        var failing: T.Testing;
        val make_2:  err[A.Error] = T.make(?failing);
        if (sel make_2.err) {
            driver.dnit_project(?p);
            session.dnit(?s);
            ret 1;
        }
        T.fail_at_ordinal(?failing, ordinal::usize);

        diagnostic.store_dnit(?s.diags);
        s.diags = diagnostic.store_init(T.allocator_of(?failing));

        val r: res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
        if (sel r.ok) {
            var sema_result: sema_product.SemaResult = r.ok;
            fe_sema.result_dnit(?sema_result);
        }

        if (sel r.err) {
            saw_internal = true;
            val f: fail.Fail = r.err;
            if (!sel f.message)      { bad = 3; }
            if (!fail.is_message(f)) { bad = 2; }
        }
        or (T.attempt_count(?failing) >= ordinal::usize) { bad = 100 + ordinal::i32; }

        diagnostic.store_dnit(?s.diags);
        s.diags = diagnostic.store_init(?backing);
        if (T.tracking_exhausted(?failing))                           { bad = 5; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { bad = 6; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }

    if (!saw_internal) { bad = 4; }

    driver.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test literal_range__secret_target_is_checked {
    if (!t_sema_diag_has("pub val x: ^u8 = 300;\n", "out of range")) { ret 1; }
    if (t_sema_diag_has("pub val y: ^u8 = 200;\n", "out of range"))  { ret 1; }
    ret 0;
}

#[testing]
fun t_sema_error_free(src: str) bool {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret false; }
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = src;
    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret false; }
    val root: str                             = root_r.ok;
    var s:    session.Session;
    val pr:   res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fs.remove_all(?backing, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret false;
    }
    var p:   project.Project      = pr.ok;
    val mid: session.ModuleId     = ut_mid(?p, ?s, "semaharness.main");
    val m:   *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || module.is_nil(mid)) {
        driver.dnit_project(?p);
        session.dnit(?s);
        ret false;
    }
    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{};
    deps.entries = nil;
    deps.count   = 0;
    val r: res[sema_product.SemaResult, fail.Fail] = fe_sema.sema(?s, m.a, m.resolve_result, ?deps, ?m.load.ctx, mid, ?s.diags);
    if (sel r.ok) {
        var sema_result: sema_product.SemaResult = r.ok;
        fe_sema.result_dnit(?sema_result);
    }
    var clean: bool  = true;
    var di:    usize = 0;
    for (di < diagnostic.len(?s.diags)) {
        val d_r: opt[*diagnostic.Diagnostic] = diagnostic.get(?s.diags, di);
        if (sel d_r.none)                                            { ret false; }
        if (sel d_r.some && diagnostic_kind.is_error(d_r.some.kind)) { clean = false; }
        di = di + 1;
    }
    driver.dnit_project(?p);
    session.dnit(?s);
    ret clean;
}

test address_of__refuses_each_rvalue_kind_by_name {
    var bad:  i32 = 0;
    val head: str = "rec P { x: i64; }\nfun f() i64 { ret 1; }\nfun g() P { var p: P; p.x = 1; ret p; }\nfun h() [2]i64 { var a: [2]i64; ret a; }\n";
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val p: *i64 = ?f(); ret 0; }\n"), "cannot take the address of a call result"))                          { bad = 1; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val p: *i64 = ?1; ret 0; }\n"), "cannot take the address of a literal"))                                { bad = 2; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val x: i32 = 1; val p: *i64 = ?(x::i64); ret 0; }\n"), "cannot take the address of a cast result"))     { bad = 4; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val x: i64 = 1; val p: *i64 = ?(x + 1); ret 0; }\n"), "cannot take the address of an operator result")) { bad = 5; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val p: *[2]i64 = ?[2]i64{1, 2}; ret 0; }\n"), "cannot take the address of an array literal"))           { bad = 6; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val p: *P = ?P{ x: 1 }; ret 0; }\n"), "cannot take the address of a record literal"))                   { bad = 7; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val p: *i64 = ?g().x; ret 0; }\n"), "cannot take the address of a field of a call result"))             { bad = 8; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val p: *i64 = ?h()[0]; ret 0; }\n"), "cannot take the address of an element of a call result"))         { bad = 9; }
    if (!t_sema_diag_has(t_cc3_static(head, "fun main() i64 { val p: *i64 = ?f(); ret 0; }\n"), "`?` applies to a place"))                                            { bad = 10; }
    ret bad;
}

test address_of__accepts_every_place_kind {
    var bad:  i32 = 0;
    val head: str = "rec P { x: i64; }\nfun pp(q: *P) *P { ret q; }\n";
    if (!t_sema_error_free(t_cc3_static(head, "fun main() i64 { var x: i64 = 1; val p: *i64 = ?x; ret @p; }\n")))             { bad = 1; }
    if (!t_sema_error_free(t_cc3_static(head, "fun main() i64 { var r: P; val p: *i64 = ?r.x; ret @p; }\n")))                 { bad = 2; }
    if (!t_sema_error_free(t_cc3_static(head, "fun main() i64 { var a: [2]i64; val p: *i64 = ?a[0]; ret @p; }\n")))           { bad = 3; }
    if (!t_sema_error_free(t_cc3_static(head, "fun main() i64 { var r: P; val q: *P = ?r; val p: *i64 = ?q.x; ret @p; }\n"))) { bad = 4; }
    if (!t_sema_error_free(t_cc3_static(head, "fun main() i64 { var r: P; val q: *P = ?r; val p: *P = ?@q; ret 0; }\n")))     { bad = 5; }
    if (!t_sema_error_free(t_cc3_static(head, "fun main() i64 { var r: P; val p: *i64 = ?pp(?r).x; ret @p; }\n")))            { bad = 6; }
    ret bad;
}

#[testing]
fun t_substitution_internal_after_rejection(reject_first: bool, silent: bool) i32 {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?backing);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val gp: res[type.TypeId, fail.Fail] = type.intern_generic_param(?s.types, intern.STR_NIL,
        type.TypeOwner{module: module.stable_id(0), file: lang_source.file_id(1)}, intern.str_id(0), type.TYPE_FUN, 0);
    if (sel gp.err) { ret 3; }
    var params: [1]type.TypeId;
    params[0] = gp.ok;
    val signature: res[type.TypeId, fail.Fail] = type.intern_function(?s.types, params[0], ?params[0], 1, false);
    if (sel signature.err) { ret 4; }
    val concrete: opt[type.TypeId] = type.prim(?s.types, type.TYPE_U32);
    if (!sel concrete.some) { ret 5; }
    var args: [1]type.TypeId;
    args[0] = concrete.some;
    var a: ast.Ast = ast.init(?backing, lang_source.FILE_NIL);
    fin { ast.dnit(?a); }
    var view: sema_context.ModuleView = sema_context.ModuleView{};
    view.a = ?a;
    var typing: sema_context.Typing = sema_context.Typing{};
    typing.subst_fn = generics.substitute;
    var instance: sema_context.Instance = sema_context.instance_none();
    instance.subst       = ?args[0];
    instance.subst_len   = 1;
    instance.subst_owner = type.GenericOwner{owner: type.TypeOwner{module: module.stable_id(0), file: lang_source.file_id(1)}, name: intern.str_id(0), kind: type.TYPE_FUN};
    var sc: sema_context.SemaContext = sema_context.init(?s, ?s.diags, typing, view, instance);
    if (reject_first) {
        var span: lang_source.Span;
        span.offset = 0;
        span.len    = 1;
        sema_context.report(?sc, diagnostic_kind.SECRET_NOT_OBLIVIOUS, span, "invalid user expression before substitution");
        if (!sel sc.status.kind.rejected) { ret 6; }
    }
    var refusing: T.Testing;
    val make_2:   err[A.Error] = T.make(?refusing);
    if (sel make_2.err) { ret 7; }
    fin { T.dnit(?refusing); }
    T.fail_at_ordinal(?refusing, 1);
    sc.walk.silent = silent;
    s.alloc        = T.allocator_of(?refusing);
    val substituted: type.TypeId = sema_context.apply_subst(?sc, signature.ok);
    s.alloc = ?backing;
    if (!type.is_error(substituted))                                { ret 8; }
    if (!sel sc.status.kind.internal)                               { ret 9; }
    if (!fail.is_message(fail.phase_failure(sc.status)))            { ret 10; }
    if (T.leaked(?refusing) || T.double_free_count(?refusing) != 0) { ret 11; }
    if (!str_equals(fail.status_text(sc.status), "out of memory"))  { ret 12; }
    if (T.attempt_count(?refusing) != 1)                            { ret 13; }
    ret 0;
}

test alloc_failure__substitution_is_internal {
    if (t_substitution_internal_after_rejection(true, false) != 0)  { ret 1; }
    if (t_substitution_internal_after_rejection(false, false) != 0) { ret 2; }
    if (t_substitution_internal_after_rejection(false, true) != 0)  { ret 3; }
    ret 0;
}

test alloc_failure__primitive_type_scan_is_internal {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?backing);
    if (sel sr.err) { ret 2; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val p: opt[type.TypeId] = type.prim(?s.types, type.TYPE_U32);
    if (!sel p.some)                   { ret 3; }
    if (s.types.scans.visits_cap != 0) { ret 3; }
    var t:      T.Testing;
    val make_2: err[A.Error] = T.make(?t);
    if (sel make_2.err) { ret 4; }
    fin { T.dnit(?t); }
    T.fail_at_ordinal(?t, 1);
    val original: *A.Allocator = s.types.a;
    s.types.a = T.allocator_of(?t);
    val r: res[bool, fail.Fail] = generics.contains_secret_deep(?s, p.some);
    s.types.a = original;
    if (sel r.ok)                                                                 { ret 5; }
    if (!str_equals(fail.describe(r.err), "out of memory"))                       { ret 6; }
    if (T.attempt_count(?t) != 1 || T.leaked(?t) || T.double_free_count(?t) != 0) { ret 7; }
    ret 0;
}

#[testing]
fun t_binding_outcome(mode: u8) i32 {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    var names: [1]str;
    var texts: [1]str;
    names[0] = "main.mach";
    texts[0] = "fun main() i64 { val live: i64 = 1; ret missing + live; }\n";
    val root_r: res[str, fail.Fail] = t_scaffold(?backing, ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?backing, root); }
    var s:  session.Session;
    val pr: res[project.Project, fail.Fail] = t_build(?backing, root, ?s);
    fin { session.dnit(?s); }
    if (sel pr.err) { ret 3; }
    var p: project.Project = pr.ok;
    fin { driver.dnit_project(?p); }
    val m: *project.ModuleEntry = t_module(?p, ?s, "semaharness.main");
    if (m == nil || m.resolve_result == nil) { ret 4; }
    val rr: *resolve.ResolveResult = m.resolve_result;
    if (!sel rr.status.kind.rejected) { ret 5; }
    var rejected: ast_id.ExprId = ast_id.EXPR_NIL;
    var bound:    ast_id.ExprId = ast_id.EXPR_NIL;
    var i:        u32           = 0;
    for (i < rr.expr_count) {
        val eo: opt[*ast_expr.Expr] = ast.get_expr(m.a, i::ast_id.ExprId);
        if (sel eo.some) {
            if (eo.some.kind == ast_expr.EXPR_KIND_IDENT) {
                if (resolve.symbol_is_rejected(rr.expr_resolved[i]))             { rejected = i::ast_id.ExprId; }
                or (resolve.symbol_index(rr.expr_resolved[i]) < rr.symbol_count) { bound = i::ast_id.ExprId; }
            }
        }
        i = i + 1;
    }
    if (ast_id.expr_is_nil(rejected) || ast_id.expr_is_nil(bound)) { ret 6; }
    var view: sema_context.ModuleView = sema_context.ModuleView{};
    view.a  = m.a;
    view.rr = rr;
    var sc: sema_context.SemaContext = sema_context.init(?s, ?s.diags, sema_context.Typing{}, view, sema_context.instance_none());
    sc.walk.silent = mode == 2;
    var selected: ast_id.ExprId = rejected;
    if (mode != 0) {
        rr.expr_resolved[ast_id.expr_index(bound)] = resolve.SYMBOL_NIL;
        selected                                   = bound;
        if (mode == 1) { fail.reject(?sc.status); }
    }
    if (!type.is_error(infer.infer_expr(?sc, selected))) { ret 7; }
    if (mode == 0 && !sel sc.status.kind.rejected)       { ret 8; }
    if (mode == 1 && (!sel sc.status.kind.internal
        || !str_equals(fail.status_text(sc.status), "internal: this identifier reached type inference unbound; the name resolver neither bound it nor reported it"))) { ret 9; }
    if (mode == 2 && !sel sc.status.kind.accepted) { ret 10; }
    ret 0;
}

# a resolver-rejected identifier keeps its source outcome, an unvisited one is
# internal after an unrelated rejection and deferred during a gate probe
test unbound_identifier__outcome_by_cause {
    if (t_binding_outcome(0) != 0) { ret 1; }
    if (t_binding_outcome(1) != 0) { ret 2; }
    if (t_binding_outcome(2) != 0) { ret 3; }
    ret 0;
}

# a literal no context types takes the i64 default and is range-checked there,
# once; one its context types is refused at that type alone
test literal_range__i64_default_is_checked {
    if (!t_sema_diag_has("pub val a: f64 = 10000000000000000000::f64;\n",
        "literal 10000000000000000000 is out of range for i64 (-9223372036854775808..9223372036854775807)")) { ret 1; }
    if (!t_sema_diag_has("fun f() u8 { if (10000000000000000000 == 0) { ret 1; } ret 0; }\n",
        "literal 10000000000000000000 is out of range for i64")) { ret 2; }
    if (!t_sema_error_free("pub val b: f64 = 9223372036854775807::f64;\npub val c: i64 = -9223372036854775808;\n")) { ret 3; }
    if (t_sema_diag_has("pub val d: u8 = 10000000000000000000;\n", "out of range for i64"))                         { ret 4; }
    ret 0;
}

# an untyped literal coerces to u128/i128 when it fits and is refused, quoting
# all of its digits and the 128-bit bounds, when it does not
test literal_range__128_bit_bounds {
    if (!t_sema_error_free("pub val a: u128 = 340282366920938463463374607431768211455;\n"))   { ret 1; }
    if (!t_sema_error_free("pub val b: i128 = 170141183460469231731687303715884105727;\n"))   { ret 2; }
    if (!t_sema_error_free("pub val c: i128 = -170141183460469231731687303715884105728;\n"))  { ret 3; }
    if (!t_sema_error_free("pub val d: u128 = 0xFFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF_FFFF;\n")) { ret 4; }
    if (!t_sema_diag_has("pub val f: i128 = 170141183460469231731687303715884105728;\n",
        "literal 170141183460469231731687303715884105728 is out of range for i128 (-170141183460469231731687303715884105728..170141183460469231731687303715884105727)")) { ret 6; }
    if (!t_sema_diag_has("pub val g: i128 = -170141183460469231731687303715884105729;\n",
        "literal -170141183460469231731687303715884105729 is out of range for i128")) { ret 7; }
    if (!t_sema_diag_has("pub val i: u128 = -1;\n", "out of range for u128 (0..340282366920938463463374607431768211455)"))           { ret 9; }
    if (!t_sema_diag_has("pub val j: u8 = 18446744073709551616;\n", "literal 18446744073709551616 is out of range for u8 (0..255)")) { ret 10; }
    # under `::` the exact value is refused only when no integer type holds it
    if (!t_sema_error_free("pub val k: u8 = 18446744073709551616::u8;\n")) { ret 11; }
    if (!t_sema_diag_has("pub val l: i128 = (-170141183460469231731687303715884105729)::i128;\n",
        "literal -170141183460469231731687303715884105729 is out of range for i128")) { ret 12; }
    ret 0;
}

# a constant shift count at or above the operand's width is refused with the
# count and the width, at every width, through a literal, a `val` and an
# expression of them; one below the width and a runtime count are accepted
test shift_count__constant_at_or_above_the_width_is_refused {
    if (!t_sema_diag_has("fun f(x: u8) u8 { ret x << 8; }\n", "shift count 8 is at least the width of `u8` (8 bits)"))                   { ret 1; }
    if (!t_sema_diag_has("fun f(x: u32) u32 { ret x >> 40; }\n", "shift count 40 is at least the width of `u32` (32 bits)"))             { ret 4; }
    if (!t_sema_diag_has("fun f(x: u128) u128 { ret x << 128; }\n", "shift count 128 is at least the width of `u128` (128 bits)"))       { ret 6; }
    if (!t_sema_diag_has("val N: u8 = 32;\nfun f(x: u32) u32 { ret x << N; }\n", "shift count 32 is at least the width of `u32`"))       { ret 8; }
    if (!t_sema_diag_has("val N: u8 = 30;\nfun f(x: u32) u32 { ret x << (N + 2); }\n", "shift count 32 is at least the width of `u32`")) { ret 9; }
    if (!t_sema_diag_has("val N: i8 = -1;\nfun f(x: u32) u32 { ret x << N; }\n", "shift count -1 is negative"))                          { ret 10; }
    if (!t_sema_error_free("fun f(x: u8) u8 { ret x << 7; }\n"))                                                                         { ret 11; }
    if (!t_sema_error_free("val N: u8 = 31;\nfun f(x: u32) u32 { ret x << N; }\n"))                                                      { ret 16; }
    if (!t_sema_error_free("fun f(x: u32, n: u8) u32 { ret x << n; }\n"))                                                                { ret 17; }
    # a literal's shift is checked at the type its context gives it, not the i64 default
    if (!t_sema_error_free("pub val a: u128 = 1 << 100;\npub val b: u128 = (1 << 100)::u128;\n"))                           { ret 18; }
    if (!t_sema_diag_has("pub val c: u64 = (1 << 70) >> 10;\n", "shift count 70 is at least the width of `u64` (64 bits)")) { ret 19; }
    if (!t_sema_diag_has("pub val d: u8 = 1 << 8;\n", "shift count 8 is at least the width of `u8` (8 bits)"))              { ret 20; }
    ret 0;
}

# a `u8`-discriminated tag with `count` cases, to probe the width check
#[testing]
fun t_tag_with_cases(alloc: *A.Allocator, count: u32) str {
    val header: str               = "tag Wide: u8 { ";
    val bytes:  usize             = str_len(header) + (count::usize * 8::usize) + 3::usize;
    val r:      res[*u8, A.Error] = A.allocate[u8](alloc, bytes);
    if (sel r.err) { ret header; }
    val buf: *u8   = r.ok;
    var w:   usize = 0;
    var h:   usize = 0;
    for (h < str_len(header)) {
        buf[w] = header[h];
        w      = w + 1;
        h      = h + 1;
    }
    var i: u32 = 0;
    for (i < count) {
        buf[w] = 'c';
        w      = w + 1;
        var digits: u32 = i;
        var scale:  u32 = 100;
        for (scale > 0) {
            buf[w] = (48 + ((digits / scale) % 10))::u8;
            w      = w + 1;
            scale  = scale / 10;
        }
        buf[w] = ';';
        w      = w + 1;
        i      = i + 1;
    }
    buf[w] = '}';
    w      = w + 1;
    buf[w] = 0;
    ret buf::str;
}

test layout_intrinsic__adopts_the_binding_width {
    var bad: i32 = 0;
    val pre: str = "rec P { x: i64; y: i64; }\n";

    if (!ut_sema_clean(ut_cc_src(pre, "val A: u8  = $size_of(P);\n"))) { bad = 1; }
    if (!ut_sema_clean(ut_cc_src(pre, "val A: i32 = $size_of(P);\n"))) { bad = 5; }

    if (!ut_sema_clean(ut_cc_src(pre, "val A: u8  = $align_of(P);\n")))      { bad = 7; }
    if (!ut_sema_clean(ut_cc_src("", "val A: u16 = $length_of([4]i32);\n"))) { bad = 8; }

    if (!ut_sema_clean(ut_cc_src(pre, "val N: u32 = 3;\nval A: u32 = N * $size_of(P);\n"))) { bad = 9; }

    if (!ut_sema_clean(ut_cc_src(pre,
        "fun sz[T]() u32 { var n: u32 = $size_of(T); ret n; }\nfun use_it() u32 { ret sz[P](); }\n"))) { bad = 10; }
    ret bad;
}

test layout_intrinsic__refuses_a_binding_it_does_not_fit {
    var bad: i32 = 0;
    if (ut_vec_diag("rec Huge { a: [300]u8; }\nval A: u8 = $size_of(Huge);\nfun main() i32 { ret 0; }\n",
        "value 300 is out of range for u8") != 0) { bad = 1; }
    if (ut_vec_diag("rec Big { a: [200]u8; }\nval A: i8 = $size_of(Big);\nfun main() i32 { ret 0; }\n",
        "is out of range for i8") != 0) { bad = 2; }
    if (ut_vec_diag("rec P { x: i64; }\nval A: f64 = $size_of(P);\nfun main() i32 { ret 0; }\n",
        "type mismatch") != 0) { bad = 3; }
    # the offset folds during type checking from the checked layout, so the width check is the same one `$size_of` meets
    if (!ut_sema_rejects_with("rec Wide { pad: [300]u8; tail: i32; }\nval A: u8 = $offset_of(Wide, tail);\nfun main() i32 { ret 0; }\n",
        "value 300 is out of range for u8")) { bad = 4; }
    if (!ut_sema_clean("rec Wide { pad: [300]u8; tail: i32; }\nval A: u32 = $offset_of(Wide, tail);\nfun main() i32 { ret 0; }\n")) { bad = 5; }
    ret bad;
}

test literal_range__operand_order_does_not_matter {
    var bad: i32 = 0;
    if (ut_vec_diag("fun f(x: u8) u8 { ret x + 300; }\nfun main() i32 { ret 0; }\n",
        "literal 300 is out of range for u8") != 0) { bad = 1; }
    if (ut_vec_diag("fun f(x: u8) u8 { ret 300 + x; }\nfun main() i32 { ret 0; }\n",
        "literal 300 is out of range for u8") != 0) { bad = 2; }
    if (!ut_sema_clean("fun f(x: u8) u8 { ret x + 5; }\nfun g(x: u8) u8 { ret 5 + x; }\nfun main() i32 { ret 0; }\n")) { bad = 3; }
    # the refusal points at the literal operand, not the whole expression
    if (!ut_sema_rejects_at("fun f(x: u8) u8 { ret x + 300; }\nfun main() i32 { ret 0; }\n", "out of range for u8", 26, 3))                   { bad = 4; }
    if (!ut_sema_rejects_at("fun f(x: u8) u8 { ret 300 + x; }\nfun main() i32 { ret 0; }\n", "out of range for u8", 22, 3))                   { bad = 5; }
    if (!ut_sema_rejects_at("fun f(x: u8) u8 { if (x == -1) { ret 1; } ret 0; }\nfun main() i32 { ret 0; }\n", "out of range for u8", 27, 2)) { bad = 6; }
    ret bad;
}

test pack__refused_on_a_body_less_fun {
    var bad: i32 = 0;

    if (ut_vec_diag("#[library(\"raylib\")]\next fun TextFormat(text: *u8, va: ...) *u8;\nfun main() i32 { ret 0; }\n",
        "cannot appear on a body-less `fun`") != 0) { bad = 1; }

    if (ut_vec_note("#[library(\"raylib\")]\next fun TextFormat(text: *u8, va: ...) *u8;\nfun main() i32 { ret 0; }\n",
        "ext fun f(a: T, ...)") != 0) { bad = 2; }

    if (!ut_sema_clean("ext fun printf(fmt: *u8, ...) i32;\nfun main() i32 { ret 0; }\n"))       { bad = 4; }
    if (!ut_sema_clean("fun fold(h: u64, va: ...) u64 { ret h; }\nfun main() i32 { ret 0; }\n")) { bad = 5; }
    ret bad;
}

test pack__forwards_into_a_c_variadic_tail {
    val decls: str = "ext fun printf(fmt: *u8, ...) i32;\npub fun logf(fmt: *u8, va: ...) i32 { ret printf(fmt, va...); }\n";
    var bad:   i32 = 0;

    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret logf(\"%d %f\\n\", 1::i32, 2.5); }\n"))) { bad = 1; }
    if (!ut_sema_clean(ut_cc_src(decls, "fun use_it() i32 { ret logf(\"hi\\n\"); }\n")))                 { bad = 2; }

    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { var c: u8 = 65; ret logf(\"%d\\n\", c); }\n"),
        "is promoted to a 32-bit integer in a C-variadic argument") != 0) { bad = 3; }
    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { ret logf(\"%f\\n\", 1.5::f32); }\n"),
        "is promoted to `f64` in a C-variadic argument") != 0) { bad = 4; }

    if (!ut_sema_clean("fun plain(h: u64, va: ...) u64 { ret h; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var c: u8 = 65; plain(1, c); ret 0; }\n")) { bad = 6; }

    if (ut_vec_diag("fun fixed(a: i32) i32 { ret a; }\nfun fwd(va: ...) i32 { ret fixed(va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { fwd(1::i32); ret 0; }\n",
        "cannot spread `...` into fixed parameters") != 0) { bad = 7; }

    if (ut_vec_diag(ut_cc_src(decls, "fun use_it() i32 { var s: ^i32 = 1; ret logf(\"%d\\n\", s); }\n"),
        "secret value cannot be passed to a") != 0) { bad = 8; }
    ret bad;
}

#[testing]
fun t_tag_corpus_range(first: usize, count: usize) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret -1; }
    var i: usize = 0;
    for (i < count) {
        val f:        TagFixture     = TAG_CORPUS[first + i];
        val text_opt: err[fail.Fail] = ut_std_tags(?alloc, f.text);
        if (sel text_opt.ok) { ret -1; }
        val text: str  = fail.describe(text_opt.err);
        var ok:   bool = true;
        if (f.accept)               { ok = ut_sema_clean(text); }
        or (str_len(f.needle) == 0) { ok = ut_sema_rejects(text); }
        or                          { ok = ut_sema_rejects_with(text, f.needle); }
        ut_std_tags_free(?alloc, text);
        if (!ok) { ret f.code; }
        i = i + 1;
    }
    ret 0;
}

test tag__payload_layouts {
    if (ut_sema_extent_is("tag Reply: u8 { empty; value: u64; }", "Reply", 16, 8) != 0)                         { ret 1; }
    if (ut_sema_extent_is("tag Reply: u8 { empty; }", "Reply", 1, 1) != 0)                                      { ret 2; }
    if (ut_sema_extent_is("#[packed] tag Reply: u8 { empty; value: u64; }", "Reply", 9, 1) != 0)                { ret 3; }
    if (ut_sema_extent_is("#[packed] #[align(16)] tag Reply: u8 { empty; value: u64; }", "Reply", 16, 16) != 0) { ret 4; }
    if (ut_sema_extent_is("tag Reply[T]: u8 { empty; value: T; } var reply: Reply[u64];", "Reply", 16, 8) != 0) { ret 5; }
    if (!ut_sema_clean("tag Reply[T]: u8 { next: *Reply[T]; value: T; } var reply: Reply[u64];"))               { ret 6; }
    if (!ut_sema_clean("tag Reply: u8 { secret: ^u64; public: u64; }"))                                         { ret 7; }
    ret 0;
}

test tag_discriminator__declared_and_checked {
    if (ut_sema_extent_is("tag Reply: u32 { empty; }", "Reply", 4, 4) != 0)                                                                                                       { ret 2; }
    if (ut_sema_extent_is("tag Reply: u64 { empty; value: u16; }", "Reply", 16, 8) != 0)                                                                                          { ret 3; }
    if (ut_sema_extent_is("#[packed] tag Reply: u32 { empty; value: u64; }", "Reply", 12, 1) != 0)                                                                                { ret 4; }
    if (!ut_sema_clean("tag Reply: u32 { empty; value: i64; } fun f() $discriminant_of(Reply) { ret 1u32; }"))                                                                    { ret 6; }
    if (!ut_sema_clean("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun f() $discriminant_of(opt[i64]) { ret 1u8; }")) { ret 7; }
    if (!ut_sema_rejects_with("tag Reply: u32 { empty; } fun f() u8 { ret 1u8::$discriminant_of(Reply); }", "type mismatch"))                                                     { ret 8; }
    ret 0;
}

test tag_discriminator__rejected_when_unusable {
    if (!ut_sema_rejects_with("tag Reply { empty; value: i64; }", "requires a discriminator type"))                     { ret 1; }
    if (!ut_sema_rejects_with("tag Reply: i8 { empty; }", "must be `u8`, `u16`, `u32` or `u64`"))                       { ret 2; }
    if (!ut_sema_rejects_with("rec Word { a: u8; } tag Reply: Word { empty; }", "must be `u8`, `u16`, `u32` or `u64`")) { ret 10; }
    if (!ut_sema_rejects_with("tag Reply: ^u8 { empty; }", "must be `u8`, `u16`, `u32` or `u64`"))                      { ret 4; }
    if (!ut_sema_rejects_with("tag Reply: *u8 { empty; }", "must be `u8`, `u16`, `u32` or `u64`"))                      { ret 5; }
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 6; }
    val wide:   str  = t_tag_with_cases(?alloc, 257);
    val narrow: bool = ut_sema_rejects_with(wide, "too narrow for the case count");
    val exact:  str  = t_tag_with_cases(?alloc, 256);
    val fits:   bool = ut_sema_clean(exact);
    if (!narrow)                                                                                                                             { ret 6; }
    if (!fits)                                                                                                                               { ret 9; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; } fun f() $discriminant_of(i64) { ret 1u8; }", "`$discriminant_of` expects a tag"))    { ret 7; }
    if (!ut_sema_rejects_with("rec Reply { value: u64; } fun f() $discriminant_of(Reply) { ret 1u8; }", "`$discriminant_of` expects a tag")) { ret 8; }
    ret 0;
}

