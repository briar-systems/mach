        "pub rec Pair { a: u64; b: u64; }\n") != 0) { bad = 1; }

    ret bad;
}

test packed_tag__payload_address_is_refused {
    var bad:  i32 = 0;
    val need: str = "cannot take the address of a payload of a `#[packed]` tag";

    if (!ut_sema_rejects_with("#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\nrec Pair { a: u32; b: u64; }\ntag N: u8 { empty; value: u64; }\nfun main() i64 { var p: P = P.value{1u64}; if (sel p.value) { val q: *u64 = ?p.value; ret (@q)::i64; } ret 0; }\n", need))                       { bad = 1; }
    if (!ut_sema_rejects_with("#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\nrec Pair { a: u32; b: u64; }\ntag N: u8 { empty; value: u64; }\nfun main() i64 { var p: P = P.pair{Pair{a: 1u32, b: 2u64}}; if (sel p.pair) { val q: *u64 = ?p.pair.b; ret (@q)::i64; } ret 0; }\n", need))      { bad = 2; }
    if (!ut_sema_rejects_with("#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\nrec Pair { a: u32; b: u64; }\ntag N: u8 { empty; value: u64; }\nfun main() i64 { var p: P = P.value{1u64}; val h: *P = ?p; if (sel (@h).value) { val q: *u64 = ?(@h).value; ret (@q)::i64; } ret 0; }\n", need)) { bad = 3; }
    if (!ut_sema_rejects_with("#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\nrec Pair { a: u32; b: u64; }\ntag N: u8 { empty; value: u64; }\nfun main() i64 { var a: [2]P; a[1] = P.value{1u64}; if (sel a[1].value) { val q: *u64 = ?a[1].value; ret (@q)::i64; } ret 0; }\n", need))        { bad = 4; }

    if (!ut_sema_clean("#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\nrec Pair { a: u32; b: u64; }\ntag N: u8 { empty; value: u64; }\nfun main() i64 { var p: P = P.value{1u64}; val q: *P = ?p; ret q::i64; }\n"))                                             { bad = 5; }
    if (!ut_sema_clean("#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\nrec Pair { a: u32; b: u64; }\ntag N: u8 { empty; value: u64; }\nfun main() i64 { var p: P = P.value{1u64}; if (sel p.value) { p.value = p.value + 1u64; ret p.value::i64; } ret 0; }\n")) { bad = 6; }
    if (!ut_sema_clean("#[packed]\ntag P: u8 { empty; value: u64; pair: Pair; }\nrec Pair { a: u32; b: u64; }\ntag N: u8 { empty; value: u64; }\nfun main() i64 { var n: N = N.value{1u64}; if (sel n.value) { val q: *u64 = ?n.value; ret (@q)::i64; } ret 0; }\n"))      { bad = 7; }
    ret bad;
}

# a dependency constant whose value differs per tuple is refused once, never read as either arm,
# whether imported by name or read as a member of its module
#[testing]
fun t_tuple_dependent_const(main: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [2]str              = [2]str{"main.mach", "dep.mach"};
    var texts:  [2]str              = [2]str{main, "$if ($mach.build.os == $mach.os.linux) { pub val X: u8 = 1; } $or { pub val X: u8 = 0; }\n"};
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel pr.err) {
        val f: fail.Fail = pr.err;
        if (fail.describe(f) == nil || !ut_str_contains(fail.describe(f), "tuple-dependent public constants are not yet supported")) { ret 2; }
        ret 0;
    }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val se: err[fail.Fail] = driver.run_sema_pass(?p);
    if (!(sel se.err && fail.is_reported(se.err)))                                                { ret 3; }
    if (ut_diag_count(?p.s.diags, "tuple-dependent public constants are not yet supported") != 1) { ret 4; }
    if (ut_diag_has(?p.s.diags, "XTRUE"))                                                         { ret 5; }
    if (ut_diag_has(?p.s.diags, "XFALSE"))                                                        { ret 6; }
    ret 0;
}

test union_gate__tuple_dependent_dependency_const_fails_closed {
    val named: i32 = t_tuple_dependent_const("use uniontest.dep.X;\n$if (X) { $error(\"XTRUE\"); } $or { $error(\"XFALSE\"); }\nfun main() i32 { ret 0; }\n");
    if (named != 0) { ret 10 + named; }
    val member: i32 = t_tuple_dependent_const("use uniontest.dep;\n$if (dep.X) { $error(\"XTRUE\"); } $or { $error(\"XFALSE\"); }\nfun main() i32 { ret 0; }\n");
    if (member != 0) { ret 20 + member; }
    ret 0;
}

test secret_vector_division__refuses_either_secret_operand {
    if (!ut_sema_clean("fun signed(a: i32x4, b: i32x4) i32x4 { ret a / b; }\nfun unsigned(a: u64x2, b: u64x2) u64x2 { ret a / b; }\nfun main() i32 { ret 0; }\n")) { ret 1; }
    if (ut_vec_diag("#[oblivious]\nfun f(a: ^i32x4, b: i32x4) ^i32x4 { ret a / b; }\nfun main() i32 { ret 0; }\n",
        "secret divisor or dividend leaks through timing") != 0) { ret 2; }
    if (ut_vec_diag("#[oblivious]\nfun f(a: u64x2, b: ^u64x2) ^u64x2 { ret a / b; }\nfun main() i32 { ret 0; }\n",
        "secret divisor or dividend leaks through timing") != 0) { ret 3; }
    ret 0;
}

test is_secret__answers_the_outer_qualifier {
    var bad: i32 = 0;

    if (ut_arm("fun main() i32 { $if ($is_secret(^u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                  { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_secret(^P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret(^*u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                  { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret(^^u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                 { bad = 1; }

    if (ut_arm("fun main() i32 { $if ($is_secret(u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                  { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_secret(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }

    if (ut_arm("fun main() i32 { $if ($is_secret(*^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                                                 { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret($pointee_of(*^u8))) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                                    { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_secret([4]^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                                               { bad = 1; }
    if (ut_arm("rec S { k: ^u64; n: u64; }\nfun main() i32 { $if ($is_secret(S)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                        { bad = 1; }
    if (ut_arm("rec S { k: ^u64; }\nfun main() i32 { $each f in $fields(S) { $if ($is_secret(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("rec S { n: u64; }\nfun main() i32 { $each f in $fields(S) { $if ($is_secret(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "N", "Y") != 0)  { bad = 1; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($is_secret(Box[^u64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                      { bad = 1; }

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(^P)) { $error(\"REC\"); } $or { $if ($is_secret(^P)) { $error(\"SEC\"); } $or { $error(\"NEITHER\"); } } ret 0; }\n", "SEC", "NEITHER") != 0) { bad = 1; }

    if (ut_vec_diag("fun probe[T]() i32 { $if ($is_secret(T)) { $error(\"SEC\"); } $or { $error(\"PUB\"); } ret 0; }\nfun main() i32 { ret probe[^u64]() + probe[u64](); }\n", "SEC") != 0) { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { $if ($is_secret(T)) { $error(\"SEC\"); } $or { $error(\"PUB\"); } ret 0; }\nfun main() i32 { ret probe[^u64]() + probe[u64](); }\n", "PUB") != 0) { bad = 1; }

    if (ut_vec_diag("fun main() i32 { val b: u8 = $is_secret(^u64); ret 0; }\n",
        "comptime type predicate is comptime-only") != 0) { bad = 1; }
    if (ut_vec_diag("fun main() i32 { $if ($is_secret()) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n",
        "expected 1 argument") != 0) { bad = 1; }

    ret bad;
}

# `$holds_secret` is the deep question, answered by the walk the raw-pointer cast check uses
test holds_secret__answers_any_secret_byte {
    var bad: i32 = 0;

    if (ut_arm("fun main() i32 { $if ($holds_secret(^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                                 { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($holds_secret([32]^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                             { bad = 1; }
    if (ut_arm("rec S { id: u64; key: ^[32]u8; }\nfun main() i32 { $if ($holds_secret(S)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($holds_secret(Box[^u64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)     { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($holds_secret(*^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                                { bad = 1; }

    if (ut_arm("fun main() i32 { $if ($holds_secret(u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                            { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($holds_secret([32]u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                         { bad = 1; }
    if (ut_arm("rec P { a: u64; b: *u8; }\nfun main() i32 { $if ($holds_secret(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)   { bad = 1; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($holds_secret(Box[u64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0) { bad = 1; }

    # the byte-class dispatch a memory primitive writes, answered per instance
    if (ut_vec_diag("fun probe[T]() i32 { $if (!$holds_secret(T)) { $error(\"RAW\"); } $or ($is_secret(T)) { $error(\"CT\"); } $or { $error(\"TYPED\"); } ret 0; }\nfun main() i32 { ret probe[u64](); }\n", "RAW") != 0)      { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { $if (!$holds_secret(T)) { $error(\"RAW\"); } $or ($is_secret(T)) { $error(\"CT\"); } $or { $error(\"TYPED\"); } ret 0; }\nfun main() i32 { ret probe[^u64](); }\n", "CT") != 0)      { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { $if (!$holds_secret(T)) { $error(\"RAW\"); } $or ($is_secret(T)) { $error(\"CT\"); } $or { $error(\"TYPED\"); } ret 0; }\nfun main() i32 { ret probe[[4]^u8](); }\n", "TYPED") != 0) { bad = 1; }

    if (ut_vec_diag("fun main() i32 { val b: u8 = $holds_secret(^u64); ret 0; }\n",
        "comptime type predicate is comptime-only") != 0) { bad = 1; }

    ret bad;
}

test secrecy__join_coerce_and_strip_are_clean {
    val src: str = "rec Key { d: ^[32]u8; }\nuni Both { a: ^u32; b: ^u32; }\nfun join(a: ^u32, b: ^u32) ^u32 { ret a + b; }\nfun join_pub(a: ^u32) ^u32 { ret a * 2; }\nfun up(p: u32) ^u32 { ret p; }\nfun down(a: ^u32) u32 { ret a:>u32; }\nfun down_typed(a: ^u32) u32 { ret a:>u32; }\nfun store_ok(p: *^u8, v: u8) { @p = v; }\nfun field_read(k: Key) ^u8 { ret k.d[0]; }\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_clean(src)) { ret 1; }
    ret 0;
}

