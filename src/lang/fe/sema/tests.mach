test tag_construction__distinct_from_vector_literals {
    if (!ut_sema_clean("tag Reply: u8 { empty; } def Alias: Reply; val r: Alias = Alias.empty{};"))                                            { ret 1; }
    if (!ut_sema_clean("tag Reply: u8 { empty; } fun make[T]() T { ret T.empty{}; } fun f() Reply { ret make[Reply](); }"))                    { ret 2; }
    if (!ut_sema_clean("def V: u32x4; fun f(x: u32) V { ret V{x, 2u32, x, 4u32}; }"))                                                          { ret 3; }
    if (!ut_sema_rejects_with("def V: u32x4; fun f() V { ret V{missing, 2u32, 3u32, 4u32}; }", "unresolved identifier"))                       { ret 4; }
    if (!ut_sema_rejects_with("tag Reply: u8 { empty; } fun f(a: Reply, b: Reply) u8 { ret a == b; }", "aggregate"))                           { ret 5; }
    if (ut_layout_ok("def V: u32x4; fun f(x: u32) V { ret V{x, 2u32, x, 4u32}; } fun main() i32 { val v: V = f(1u32); ret v[0]::i32; }") != 0) { ret 6; }
    ret 0;
}

