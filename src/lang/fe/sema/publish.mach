# builds a module's interface once sema has typed it: every module-level function and
# binding as its declaration says, every module constant evaluated to its deep value, and the
# public surface its resolution published
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_id:   mach.lang.fe.ast.id;
use ast_type: mach.lang.fe.ast.type;
use mach.lang.fe.comptime;
use comptime_deep: mach.lang.fe.comptime.deep;
use mach.lang.fe.decorator;
use mach.lang.fe.resolve;
use sema_constant: mach.lang.fe.sema.constant;
use sema_context:  mach.lang.fe.sema.context;
use mach.lang.fe.sema.interface;
use sema_template: mach.lang.fe.sema.template;
use mach.lang.intern;
use mach.lang.module;

# the interface takes over the module's store of constant values, which its typing built in
pub fun interface_of(sc: *sema_context.SemaContext) res[interface.Interface, fail.Fail] {
    var iface: interface.Interface = interface.init(sc.s.alloc);
    val outer: sema_context.Walk   = sema_context.walk_open(sc);
    sc.walk.silent = true;
    val built: err[fail.Fail] = interface_fill(sc, ?iface);
    sema_context.walk_close(sc, outer);
    if (sel built.err) {
        interface.dnit(?iface);
        ret res[interface.Interface, fail.Fail].err{built.err};
    }
    comptime_deep.dnit(?iface.values);
    iface.values      = @sc.typing.values;
    @sc.typing.values = comptime_deep.init(sc.s.alloc);
    ret res[interface.Interface, fail.Fail].ok{iface};
}

fun interface_fill(sc: *sema_context.SemaContext, iface: *interface.Interface) err[fail.Fail] {
    val rr: *resolve.ResolveResult = sc.view.rr;
    if (rr == nil || rr.symbols == nil) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < rr.symbol_count) {
        val sym: *resolve.Symbol = ?rr.symbols[i];
        if (declares(sc, sym)) {
            val added: err[fail.Fail] = declaration_add(sc, iface, sym);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    val captured: err[fail.Fail] = template_capture(sc, iface);
    if (sel captured.err) { ret captured; }
    i = 0;
    for (i < rr.pub_count) {
        val sym:   *resolve.Symbol = ?rr.symbols[i];
        val added: err[fail.Fail]  = interface.exported_add(iface, interface.Exported{
            kind:          sym.kind, name: sym.name, canon: sym.canon, origin: sym.origin_stable, module: sym.slot_stable,
            generic_arity: sym.generic_arity, has_comptime_params: sym.has_comptime_params, has_pack_param: sym.has_pack_param
        });
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module with a generic, comptime-parameter or pack function publishes the template its
# instances are emitted from
fun template_capture(sc: *sema_context.SemaContext, iface: *interface.Interface) err[fail.Fail] {
    var instanced: bool  = false;
    var i:         usize = 0;
    for (i < iface.declarations.len) {
        if (interface.declaration_has_instances(iface, ?iface.declarations.data[i])) { instanced = true; }
        i = i + 1;
    }
    if (!instanced) { ret err[fail.Fail].ok{}; }
    val a:      *ast.Ast                               = sc.view.a;
    val copied: res[sema_template.Template, fail.Fail] = sema_template.capture(sc.s.alloc, sema_template.Captured{
        a:      a, source: sc.view.source, rr: sc.view.rr,
        typing: sema_template.Typing{expr_type: sc.view.expr_type, type_resolved_ty: sc.view.type_resolved_ty, decl_type: sc.view.decl_type,
            expr_count: a.exprs.len::u32, type_count: a.types.len::u32, decl_count: a.decls.len::u32},
        load:  comptime.layer_at(sc.view.ctx, comptime.STAGE_LOAD), resolved: comptime.layer_at(sc.view.ctx, comptime.STAGE_RESOLVE),
        typed: ?sc.view.ctx.own, env: comptime.environment(sc.view.ctx)
    });
    if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
    sema_template.dnit(?iface.template);
    iface.template = copied.ok;
    ret err[fail.Fail].ok{};
}

# a module-level function, `val` or `var` the module itself declares
fun declares(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (!module.same(sym.origin, sc.view.own_module) || ast_id.decl_is_nil(sym.decl)) { ret false; }
    if (ast_id.decl_index(sym.decl) >= sc.view.a.decls.len::u32)                      { ret false; }
    if (sym.kind == resolve.SYM_FUN)                                                  { ret true; }
    ret (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_VAR) && (sym.flags & resolve.SYM_FLAG_MODULE) != 0;
}

fun declaration_add(sc: *sema_context.SemaContext, iface: *interface.Interface, sym: *resolve.Symbol) err[fail.Fail] {
    val found: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
    if (sel found.none) { ret err[fail.Fail].err{fail.message("interface: a declared symbol has no declaration")}; }
    val d: *ast_decl.Decl = found.some;

    var out: interface.Declaration = interface.Declaration{
        kind: sym.kind, canon: sym.canon, decl: sym.decl, value: interface.NONE, op_set: intern.STR_NIL, op_name: intern.STR_NIL
    };
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) { out.flags = out.flags | interface.DECLARATION_EXT; }
    if (sym.kind != resolve.SYM_FUN || d.kind != ast_decl.DECL_KIND_FUN) {
        if (sym.kind == resolve.SYM_VAL) {
            val bound: err[fail.Fail] = constant_bind(sc, sym, d, ?out);
            if (sel bound.err) { ret bound; }
        }
        or (sym.kind == resolve.SYM_VAR) {
            val initial: err[fail.Fail] = initial_bind(sc, d, ?out);
            if (sel initial.err) { ret initial; }
        }
        ret interface.declaration_add(iface, out, nil, 0);
    }

    val f: *ast_decl.DeclFun = ?d.data.fun_;
    out.generics = f.generics_len;
    if (!ast_id.stmt_is_nil(f.body)) { out.flags = out.flags | interface.DECLARATION_BODY; }
    if (f.params_len > 0) {
        val last: opt[*ast_type.Type] = ast.get_type(sc.view.a, sc.view.a.typed_names.data[f.params_start + f.params_len - 1].ty);
        if (sel last.some && last.some.kind == ast_type.TYPE_KIND_PACK) { out.flags = out.flags | interface.DECLARATION_PACK; }
    }
    val op: err[fail.Fail] = op_read(sc, d, ?out);
    if (sel op.err) { ret op; }

    var params: *interface.Param = nil;
    if (f.params_len > 0) {
        val allocated: res[*interface.Param, A.Error] = A.allocate[interface.Param](sc.s.alloc, f.params_len::usize);
        if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
        params = allocated.ok;
    }
    fin {
        if (params != nil) { A.deallocate[interface.Param](sc.s.alloc, params, f.params_len::usize); }
    }
    var i: u32 = 0;
    for (i < f.params_len) {
        params[i] = interface.Param{comptime: sc.view.a.typed_names.data[f.params_start + i].comptime};
        i         = i + 1;
    }
    ret interface.declaration_add(iface, out, params, f.params_len);
}

# the instruction an `#[op]` makes the function: its set and operation, read once so no reader
# decodes the decorator again
fun op_read(sc: *sema_context.SemaContext, d: *ast_decl.Decl, out: *interface.Declaration) err[fail.Fail] {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        if (dec.id == decorator.OP) {
            if (dec.args_len != 3) { ret err[fail.Fail].ok{}; }
            val set_s: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 1);
            val nam_s: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 2);
            if (sel set_s.none) { ret err[fail.Fail].ok{}; }
            if (sel nam_s.none) { ret err[fail.Fail].ok{}; }
            val set_id: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, set_s.some);
            if (sel set_id.err) { ret err[fail.Fail].err{fail.refused(set_id.err)}; }
            val nam_id: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, nam_s.some);
            if (sel nam_id.err) { ret err[fail.Fail].err{fail.refused(nam_id.err)}; }
            out.op_set  = set_id.ok;
            out.op_name = nam_id.ok;
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a constant sema bound is its value; an array, record or case literal no scalar holds is
# evaluated member by member; any other initializer is no constant
fun constant_bind(sc: *sema_context.SemaContext, sym: *resolve.Symbol, d: *ast_decl.Decl, out: *interface.Declaration) err[fail.Fail] {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.expr_is_nil(d.data.bind.init) || decorator.has(sc.view.a, d, decorator.EMBED)) {
        ret err[fail.Fail].ok{};
    }
    out.gated = (d.flags & ast_decl.DECL_FLAG_GATED) != 0;
    val built: res[u32, fail.Fail] = sema_constant.own_value(sc, sym);
    if (sel built.err) { ret err[fail.Fail].err{built.err}; }
    out.value = built.ok;
    ret err[fail.Fail].ok{};
}

# the value a `var`'s initializer gives it, evaluated member by member: the data the var starts
# with, and the value a `#[spec]` var holds until the host supplies another
fun initial_bind(sc: *sema_context.SemaContext, d: *ast_decl.Decl, out: *interface.Declaration) err[fail.Fail] {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.expr_is_nil(d.data.bind.init) || decorator.has(sc.view.a, d, decorator.EMBED)) {
        ret err[fail.Fail].ok{};
    }
    val built: res[u32, fail.Fail] = sema_constant.node_build(sc, d.data.bind.init);
    if (sel built.err) { ret err[fail.Fail].err{built.err}; }
    out.value = built.ok;
    ret err[fail.Fail].ok{};
}
