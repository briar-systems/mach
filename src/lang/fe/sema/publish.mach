# builds a module's interface once sema has typed it: every module-level function and
# binding as its declaration says, every module constant evaluated to its deep value, and the
# public surface its resolution published
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use ast_type: mach.lang.fe.ast.type;
use mach.lang.fe.comptime;
use mach.lang.fe.decorator;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.constant;
use sema_context: mach.lang.fe.sema.context;
use mach.lang.fe.sema.interface;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.type;

pub fun interface_of(sc: *sema_context.SemaContext) res[interface.Interface, fail.Fail] {
    var iface: interface.Interface = interface.init(sc.s.alloc);
    val outer: sema_context.Walk   = sema_context.walk_open(sc);
    sc.walk.silent = true;
    val built: err[fail.Fail] = interface_fill(sc, ?iface);
    sema_context.walk_close(sc, outer);
    if (sel built.err) {
        interface.dnit(?iface);
        ret res[interface.Interface, fail.Fail].err{built.err};
    }
    ret res[interface.Interface, fail.Fail].ok{iface};
}

fun interface_fill(sc: *sema_context.SemaContext, iface: *interface.Interface) err[fail.Fail] {
    val rr: *resolve.ResolveResult = sc.view.rr;
    if (rr == nil || rr.symbols == nil) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < rr.symbol_count) {
        val sym: *resolve.Symbol = ?rr.symbols[i];
        if (declares(sc, sym)) {
            val added: err[fail.Fail] = declaration_add(sc, iface, sym);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < rr.pub_count) {
        val sym:   *resolve.Symbol = ?rr.symbols[i];
        val added: err[fail.Fail]  = interface.exported_add(iface, interface.Exported{
            kind:          sym.kind, name: sym.name, canon: sym.canon, origin: sym.origin_stable, module: sym.slot_stable,
            generic_arity: sym.generic_arity, has_comptime_params: sym.has_comptime_params, has_pack_param: sym.has_pack_param
        });
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module-level function, `val` or `var` the module itself declares
fun declares(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (!module.same(sym.origin, sc.view.own_module) || ast_id.decl_is_nil(sym.decl)) { ret false; }
    if (ast_id.decl_index(sym.decl) >= sc.view.a.decls.len::u32)                      { ret false; }
    if (sym.kind == resolve.SYM_FUN)                                                  { ret true; }
    ret (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_VAR) && (sym.flags & resolve.SYM_FLAG_MODULE) != 0;
}

fun declaration_add(sc: *sema_context.SemaContext, iface: *interface.Interface, sym: *resolve.Symbol) err[fail.Fail] {
    val found: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
    if (sel found.none) { ret err[fail.Fail].err{fail.message("interface: a declared symbol has no declaration")}; }
    val d: *ast_decl.Decl = found.some;

    var out: interface.Declaration = interface.Declaration{
        kind: sym.kind, canon: sym.canon, decl: sym.decl, value: interface.NONE, op_set: intern.STR_NIL, op_name: intern.STR_NIL
    };
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) { out.flags = out.flags | interface.DECLARATION_EXT; }
    if (sym.kind != resolve.SYM_FUN || d.kind != ast_decl.DECL_KIND_FUN) {
        if (sym.kind == resolve.SYM_VAL) {
            val bound: err[fail.Fail] = constant_bind(sc, iface, sym, d, ?out);
            if (sel bound.err) { ret bound; }
        }
        or (sym.kind == resolve.SYM_VAR) {
            val initial: err[fail.Fail] = initial_bind(sc, iface, d, ?out);
            if (sel initial.err) { ret initial; }
        }
        ret interface.declaration_add(iface, out, nil, 0);
    }

    val f: *ast_decl.DeclFun = ?d.data.fun_;
    out.generics = f.generics_len;
    if (!ast_id.stmt_is_nil(f.body)) { out.flags = out.flags | interface.DECLARATION_BODY; }
    if (f.params_len > 0) {
        val last: opt[*ast_type.Type] = ast.get_type(sc.view.a, sc.view.a.typed_names.data[f.params_start + f.params_len - 1].ty);
        if (sel last.some && last.some.kind == ast_type.TYPE_KIND_PACK) { out.flags = out.flags | interface.DECLARATION_PACK; }
    }
    val op: err[fail.Fail] = op_read(sc, d, ?out);
    if (sel op.err) { ret op; }

    var params: *interface.Param = nil;
    if (f.params_len > 0) {
        val allocated: res[*interface.Param, A.Error] = A.allocate[interface.Param](sc.s.alloc, f.params_len::usize);
        if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
        params = allocated.ok;
    }
    fin {
        if (params != nil) { A.deallocate[interface.Param](sc.s.alloc, params, f.params_len::usize); }
    }
    var i: u32 = 0;
    for (i < f.params_len) {
        params[i] = interface.Param{comptime: sc.view.a.typed_names.data[f.params_start + i].comptime};
        i         = i + 1;
    }
    ret interface.declaration_add(iface, out, params, f.params_len);
}

# the instruction an `#[op]` makes the function: its set and operation, read once so no reader
# decodes the decorator again
fun op_read(sc: *sema_context.SemaContext, d: *ast_decl.Decl, out: *interface.Declaration) err[fail.Fail] {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators.data[d.decorators_start + i];
        if (dec.id == decorator.OP) {
            if (dec.args_len != 3) { ret err[fail.Fail].ok{}; }
            val set_s: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 1);
            val nam_s: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 2);
            if (sel set_s.none) { ret err[fail.Fail].ok{}; }
            if (sel nam_s.none) { ret err[fail.Fail].ok{}; }
            val set_id: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, set_s.some);
            if (sel set_id.err) { ret err[fail.Fail].err{fail.refused(set_id.err)}; }
            val nam_id: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, nam_s.some);
            if (sel nam_id.err) { ret err[fail.Fail].err{fail.refused(nam_id.err)}; }
            out.op_set  = set_id.ok;
            out.op_name = nam_id.ok;
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a constant sema bound is its value; an array, record or case literal no scalar holds is
# evaluated member by member; any other initializer is no constant
fun constant_bind(sc: *sema_context.SemaContext, iface: *interface.Interface, sym: *resolve.Symbol, d: *ast_decl.Decl,
    out: *interface.Declaration) err[fail.Fail] {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.expr_is_nil(d.data.bind.init) || decorator.has(sc.view.a, d, decorator.EMBED)) {
        ret err[fail.Fail].ok{};
    }
    var ty: type.TypeId = type.TYPE_NIL;
    if (sc.view.decl_type != nil) { ty = sc.view.decl_type[ast_id.decl_index(sym.decl)]; }
    out.gated = !constant.declared_at_top(sc, sym.decl);
    val bound: opt[comptime.NamedConst] = comptime.lookup(sc.view.ctx, sym.name);
    if (sel bound.some) {
        out.gated = bound.some.gated;
        if (bound.some.value.kind != comptime.CT_KIND_CONST_ELEM) {
            val node: res[u32, fail.Fail] = interface.node_add(iface, interface.Node{kind: interface.NODE_SCALAR, ty: ty, value: bound.some.value});
            if (sel node.err) { ret err[fail.Fail].err{node.err}; }
            out.value = node.ok;
            ret err[fail.Fail].ok{};
        }
    }
    if (!is_aggregate(sc, d.data.bind.init)) { ret err[fail.Fail].ok{}; }
    val node: res[u32, fail.Fail] = node_build(sc, iface, d.data.bind.init);
    if (sel node.err) { ret err[fail.Fail].err{node.err}; }
    out.value = node.ok;
    ret err[fail.Fail].ok{};
}

# the compile-time value a `var`'s scalar initializer gives it, which a `#[spec]` var holds until
# the host supplies another; none for any other initializer
fun initial_bind(sc: *sema_context.SemaContext, iface: *interface.Interface, d: *ast_decl.Decl, out: *interface.Declaration) err[fail.Fail] {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.expr_is_nil(d.data.bind.init) || is_aggregate(sc, d.data.bind.init)) {
        ret err[fail.Fail].ok{};
    }
    val evaluated: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc,
        sc.typing.type_caps, sc.view.a, sc.view.source, d.data.bind.init, ?sc.s.interner);
    if (sel evaluated.err) {
        if (evaluated.err.kind == comptime.EVAL_FAIL_INTERNAL) { ret err[fail.Fail].err{fail.message(evaluated.err.message)}; }
        ret err[fail.Fail].ok{};
    }
    val node: res[u32, fail.Fail] = interface.node_add(iface, interface.Node{kind: interface.NODE_SCALAR,
        ty: expr_type_at(sc, d.data.bind.init), value: evaluated.ok});
    if (sel node.err) { ret err[fail.Fail].err{node.err}; }
    out.value = node.ok;
    ret err[fail.Fail].ok{};
}

# an array literal, or a record or case literal spelled with its head type
fun is_aggregate(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret false; }
    val e: *ast_expr.Expr = e_opt.some;
    if (e.kind == ast_expr.EXPR_KIND_ARRAY_LIT)  { ret true; }
    if (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT) { ret !ast_id.type_is_nil(e.data.struct_lit.ty); }
    if (e.kind == ast_expr.EXPR_KIND_VECTOR_LIT) { ret !ast_id.type_is_nil(e.data.vector_lit.ty); }
    ret false;
}

fun expr_type_at(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type.TypeId {
    if (sc.view.expr_type == nil || ast_id.expr_index(eid)::usize >= sc.view.a.exprs.len) { ret type.TYPE_NIL; }
    ret sc.view.expr_type[ast_id.expr_index(eid)];
}

# the node of the expression `eid`: an aggregate literal member by member, anything else as
# the evaluator answers it
fun node_build(sc: *sema_context.SemaContext, iface: *interface.Interface, eid: ast_id.ExprId) res[u32, fail.Fail] {
    val ty: type.TypeId = expr_type_at(sc, eid);
    if (!is_aggregate(sc, eid)) {
        val evaluated: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc,
            sc.typing.type_caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
        if (sel evaluated.ok) { ret interface.node_add(iface, interface.Node{kind: interface.NODE_SCALAR, ty: ty, value: evaluated.ok}); }
        ret refused_add(sc, iface, ty, evaluated.err);
    }
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret res[u32, fail.Fail].err{fail.message("interface: a constant names no expression")}; }
    val e: *ast_expr.Expr = e_opt.some;

    var head:      intern.StrId       = intern.STR_NIL;
    var named:     u32                = 0;
    var elems:     u32                = 0;
    var elems_at:  u32                = 0;
    var fields_at: u32                = 0;
    var kind:      interface.NodeKind = interface.NODE_ARRAY;
    if (e.kind == ast_expr.EXPR_KIND_ARRAY_LIT) {
        elems    = e.data.array_lit.elems_len;
        elems_at = e.data.array_lit.elems_start;
    }
    or {
        kind = interface.NODE_LITERAL;
        val case_r: res[intern.StrId, comptime.EvalFail] = comptime.literal_case[sema_context.SemaContext](sc.view.ctx, sc,
            sc.typing.type_caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
        if (sel case_r.err) { ret refused_add(sc, iface, ty, case_r.err); }
        head = case_r.ok;
        if (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT) {
            named     = e.data.struct_lit.fields_len;
            fields_at = e.data.struct_lit.fields_start;
            elems     = e.data.struct_lit.elems_len;
            elems_at  = e.data.struct_lit.elems_start;
        }
        or {
            elems    = e.data.vector_lit.elems_len;
            elems_at = e.data.vector_lit.elems_start;
        }
    }

    val node: res[u32, fail.Fail] = interface.node_add(iface, interface.Node{kind: kind, ty: ty, head: head});
    if (sel node.err) { ret node; }
    val total: u32 = named + elems;
    if (total == 0) { ret node; }
    val allocated: res[*interface.Member, A.Error] = A.allocate[interface.Member](sc.s.alloc, total::usize);
    if (sel allocated.err) { ret res[u32, fail.Fail].err{fail.refused(allocated.err)}; }
    val members: *interface.Member = allocated.ok;
    fin { A.deallocate[interface.Member](sc.s.alloc, members, total::usize); }

    var i: u32 = 0;
    for (i < named) {
        val fi:   *ast_expr.FieldInit        = ?sc.view.a.field_inits.data[fields_at + i];
        val name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, fi.name.offset, fi.name.len);
        if (sel name.err) { ret res[u32, fail.Fail].err{fail.refused(name.err)}; }
        val child: res[u32, fail.Fail] = node_build(sc, iface, fi.value);
        if (sel child.err) { ret child; }
        members[i] = interface.Member{name: name.ok, node: child.ok};
        i          = i + 1;
    }
    i = 0;
    for (i < elems) {
        val child: res[u32, fail.Fail] = node_build(sc, iface, sc.view.a.expr_ids.data[elems_at + i]);
        if (sel child.err) { ret child; }
        members[named + i] = interface.Member{name: intern.STR_NIL, node: child.ok};
        i                  = i + 1;
    }
    val linked: err[fail.Fail] = interface.members_add(iface, node.ok, members, total);
    if (sel linked.err) { ret res[u32, fail.Fail].err{linked.err}; }
    ret node;
}

# a leaf with no compile-time value keeps the refusal reading it gives; an internal failure is
# the build's own
fun refused_add(sc: *sema_context.SemaContext, iface: *interface.Interface, ty: type.TypeId, why: comptime.EvalFail) res[u32, fail.Fail] {
    if (why.kind == comptime.EVAL_FAIL_INTERNAL) { ret res[u32, fail.Fail].err{fail.message(why.message)}; }
    val message: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, why.message);
    if (sel message.err) { ret res[u32, fail.Fail].err{fail.refused(message.err)}; }
    ret interface.node_add(iface, interface.Node{kind: interface.NODE_REFUSED, ty: ty,
        refusal: interface.Refusal{kind: why.kind, diag: why.diag, message: message.ok}});
}
