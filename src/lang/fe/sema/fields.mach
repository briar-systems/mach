use T: std.allocator.testing;
use std.collections.sort;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.deprecation;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.type;

pub rec Node {
    ty:         type.TypeId;
    entries:    collections_vector.Vector[type.FieldEntry];
    decoration: type.Decoration;
    # the declared discriminator of a tag nominal; TYPE_NIL on every other node
    disc: type.TypeId;
}

pub rec Roots {
    data: *type.TypeId;
    len:  usize;
}

def CaptureMode: u8;

pub val RECIPES:      CaptureMode = 0;
pub val MATERIALIZED: CaptureMode = 1;

pub rec Graph {
    nodes:                collections_vector.Vector[Node];
    installed:            bool;
    installed_generation: u64;
}

pub fun init(a: *A.Allocator) Graph {
    ret Graph{nodes: collections_vector.init[Node](a), installed: false, installed_generation: 0};
}

pub fun dnit(graph: *Graph) {
    var i: usize = 0;
    for (i < graph.nodes.len) {
        collections_vector.dnit[type.FieldEntry](?graph.nodes.data[i].entries);
        i = i + 1;
    }
    collections_vector.dnit[Node](?graph.nodes);
}

fun node_compare(left: *Node, right: *Node) i64 {
    if (type.index(left.ty) < type.index(right.ty)) { ret -1; }
    if (type.index(left.ty) > type.index(right.ty)) { ret 1; }
    ret 0;
}

fun enqueue(ti: *type.TypeInterner, scan: *type.TypeScan, pending: *collections_vector.Vector[type.TypeId],
    ty: type.TypeId) err[fail.Fail] {
    if (type.is_nil(ty) || type.is_error(ty)) { ret err[fail.Fail].ok{}; }
    val found: opt[*type.Type] = type.get(ti, ty);
    if (!sel found.some) { ret err[fail.Fail].err{fail.message("field graph contains an invalid type identity")}; }
    val marked: res[type.VisitMark, fail.Fail] = type.type_scan_mark(ti, scan, ty);
    if (sel marked.err)               { ret err[fail.Fail].err{marked.err}; }
    if (marked.ok == type.VISIT_SEEN) { ret err[fail.Fail].ok{}; }
    val queued: res[usize, A.Error] = collections_vector.push[type.TypeId](pending, ty);
    if (sel queued.err) { ret err[fail.Fail].err{fail.refused(queued.err)}; }
    ret err[fail.Fail].ok{};
}

fun enqueue_parameters(ti: *type.TypeInterner, scan: *type.TypeScan, pending: *collections_vector.Vector[type.TypeId],
    start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val parameter: opt[type.TypeId] = type.get_param(ti, start + i);
        if (!sel parameter.some) { ret err[fail.Fail].err{fail.message("field graph contains an invalid type parameter run")}; }
        val added: err[fail.Fail] = enqueue(ti, scan, pending, parameter.some);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a handle's operands are its declaration's site where no target mints it, else the
# words and types of the kind it is minted as, whose types the graph reaches
fun enqueue_handle(ti: *type.TypeInterner, scan: *type.TypeScan, pending: *collections_vector.Vector[type.TypeId],
    handle: type.TypeHandle) err[fail.Fail] {
    if (handle.ctor == type.NO_HANDLE_CTOR) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i + 1 < handle.ops_len) {
        val part: u32 = ti.handle_ops[handle.ops_start + i];
        val held: u32 = ti.handle_ops[handle.ops_start + i + 1];
        i = i + 2;
        if (part != type.HANDLE_PART_TYPE) { cnt; }
        val added: err[fail.Fail] = enqueue(ti, scan, pending, type.id(held));
        if (sel added.err) { ret added; }
    }
    ret err[fail.Fail].ok{};
}

fun capture_node(s: *session.Session, graph: *Graph, scan: *type.TypeScan,
    pending: *collections_vector.Vector[type.TypeId], ty: type.TypeId) err[fail.Fail] {
    var node: Node;
    node.ty         = ty;
    node.entries    = collections_vector.init[type.FieldEntry](graph.nodes.a);
    node.decoration = type.decoration_of(?s.types, ty);
    node.disc       = type.tag_discriminator(?s.types, ty);
    var transferred: bool = false;
    fin {
        if (!transferred) { collections_vector.dnit[type.FieldEntry](?node.entries); }
    }
    val table: opt[*type.FieldTable] = type.field_table_for(?s.types, ty);
    if (!sel table.some) { ret err[fail.Fail].err{fail.message("prepared nominal field recipe is unavailable")}; }
    {
        val current: *type.FieldTable = table.some;
        var i:       u32              = 0;
        for (i < current.fields_len) {
            val field: *type.FieldEntry = type.field_entry_at(?s.types, current, i);
            if (field == nil) { ret err[fail.Fail].err{fail.message("field graph contains an invalid field run")}; }
            val copied: res[usize, A.Error] = collections_vector.push[type.FieldEntry](?node.entries, @field);
            if (sel copied.err) { ret err[fail.Fail].err{fail.refused(copied.err)}; }
            val added: err[fail.Fail] = enqueue(?s.types, scan, pending, field.ty);
            if (sel added.err) { ret added; }
            i = i + 1;
        }
    }
    val appended: res[usize, A.Error] = collections_vector.push[Node](?graph.nodes, node);
    if (sel appended.err) { ret err[fail.Fail].err{fail.refused(appended.err)}; }
    transferred = true;
    ret err[fail.Fail].ok{};
}

pub fun capture[T](s: *session.Session, a: *A.Allocator, roots: *Roots, count: usize, mode: CaptureMode, ctx: *T,
    prepare: fun(*T, type.TypeId) err[fail.Fail]) res[Graph, fail.Fail] {
    if (mode != RECIPES && mode != MATERIALIZED) { ret res[Graph, fail.Fail].err{fail.message("invalid field graph capture mode")}; }
    if (roots == nil && count != 0)              { ret res[Graph, fail.Fail].err{fail.message("field graph roots are nil")}; }
    if (ctx == nil || prepare == nil)            { ret res[Graph, fail.Fail].err{fail.message("field graph capture requires an active preparation capability")}; }
    var graph:    Graph = init(a);
    var complete: bool  = false;
    fin {
        if (!complete) { dnit(?graph); }
    }
    var scan:     type.TypeScan;
    val scanning: err[fail.Fail] = type.type_scan_begin(?s.types, ?scan);
    if (sel scanning.err) { ret res[Graph, fail.Fail].err{scanning.err}; }
    fin { type.type_scan_end(?s.types, ?scan); }
    var pending: collections_vector.Vector[type.TypeId] = collections_vector.init[type.TypeId](a);
    fin { collections_vector.dnit[type.TypeId](?pending); }
    var i: usize = 0;
    for (i < count) {
        val group: Roots = roots[i];
        if (group.data == nil && group.len != 0) { ret res[Graph, fail.Fail].err{fail.message("field graph root group is nil")}; }
        var j: usize = 0;
        for (j < group.len) {
            val added: err[fail.Fail] = enqueue(?s.types, ?scan, ?pending, group.data[j]);
            if (sel added.err) { ret res[Graph, fail.Fail].err{added.err}; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < pending.len) {
        val ty:      type.TypeId     = pending.data[i];
        val initial: opt[*type.Type] = type.get(?s.types, ty);
        if (sel initial.none) { ret res[Graph, fail.Fail].err{fail.message("field graph contains an invalid type identity")}; }
        val kind: type.TypeKind = initial.some.kind;
        if (kind == type.TYPE_REC || kind == type.TYPE_UNI || kind == type.TYPE_TAG) {
            val prepared: err[fail.Fail] = prepare(ctx, ty);
            if (sel prepared.err) { ret res[Graph, fail.Fail].err{prepared.err}; }
        }
        val info: opt[*type.Type] = type.get(?s.types, ty);
        if (sel info.none) { ret res[Graph, fail.Fail].err{fail.message("field graph type disappeared during capture")}; }
        val node:  *type.Type  = info.some;
        var child: type.TypeId = type.TYPE_NIL;
        if (node.kind == type.TYPE_POINTER) { child = node.data.pointer.base; }
        or (node.kind == type.TYPE_ARRAY)   { child = node.data.array.base; }
        or (node.kind == type.TYPE_SECRET)  { child = node.data.secret.base; }
        or (node.kind == type.TYPE_FUN) {
            child = node.data.fn.ret_type;
            val parameters: err[fail.Fail] = enqueue_parameters(?s.types, ?scan, ?pending,
                node.data.fn.params_start, node.data.fn.params_len);
            if (sel parameters.err) { ret res[Graph, fail.Fail].err{parameters.err}; }
        }
        or (node.kind == type.TYPE_INSTANCE) {
            child = node.data.instance.nominal;
            val parameters: err[fail.Fail] = enqueue_parameters(?s.types, ?scan, ?pending,
                node.data.instance.args_start, node.data.instance.args_len);
            if (sel parameters.err) { ret res[Graph, fail.Fail].err{parameters.err}; }
        }
        or (node.kind == type.TYPE_HANDLE) {
            val operands: err[fail.Fail] = enqueue_handle(?s.types, ?scan, ?pending, node.data.handle);
            if (sel operands.err) { ret res[Graph, fail.Fail].err{operands.err}; }
        }
        val added: err[fail.Fail] = enqueue(?s.types, ?scan, ?pending, child);
        if (sel added.err) { ret res[Graph, fail.Fail].err{added.err}; }
        val table: opt[*type.FieldTable] = type.field_table_for(?s.types, ty);
        if (node.kind == type.TYPE_REC || node.kind == type.TYPE_UNI || node.kind == type.TYPE_TAG
            || (mode == MATERIALIZED && node.kind == type.TYPE_INSTANCE && sel table.some)) {
            val copied: err[fail.Fail] = capture_node(s, ?graph, ?scan, ?pending, ty);
            if (sel copied.err) { ret res[Graph, fail.Fail].err{copied.err}; }
        }
        i = i + 1;
    }
    sort.sort_by[Node](graph.nodes.data, graph.nodes.len, node_compare);
    complete = true;
    ret res[Graph, fail.Fail].ok{graph};
}

fun same_fields(s: *session.Session, table: *type.FieldTable, node: *Node) bool {
    if (table.fields_len::usize != node.entries.len) { ret false; }
    var i: u32 = 0;
    for (i < table.fields_len) {
        val entry: *type.FieldEntry = type.field_entry_at(?s.types, table, i);
        if (entry == nil || !intern.str_same(entry.name, node.entries.data[i].name) || !type.same(entry.ty, node.entries.data[i].ty)
            || !deprecation.equal(entry.deprecation, node.entries.data[i].deprecation)) { ret false; }
        i = i + 1;
    }
    if (!type.same(type.tag_discriminator(?s.types, node.ty), node.disc)) { ret false; }
    val dec: type.Decoration = type.decoration_of(?s.types, node.ty);
    ret dec.align == node.decoration.align && dec.packed == node.decoration.packed && dec.volatile_ == node.decoration.volatile_;
}

pub fun install(s: *session.Session, graph: *Graph) err[fail.Fail] {
    # published tables only change through a projection reset, so a graph installed
    # under this projection verifies identically on every later acquisition
    val generation: u64 = s.types.projection_generation;
    if (graph.installed && graph.installed_generation == generation) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < graph.nodes.len) {
        val node:     *Node                 = ?graph.nodes.data[i];
        val existing: opt[*type.FieldTable] = type.field_table_for(?s.types, node.ty);
        if (sel existing.some) {
            if (!same_fields(s, existing.some, node)) {
                ret err[fail.Fail].err{fail.message("field projection disagrees with an acquired definition")};
            }
            i = i + 1;
            cnt;
        }
        if (node.entries.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.message("field projection exceeds the field count limit")}; }
        val staged: res[u32, fail.Fail] = type.field_table_stage(?s.types, node.entries.len::u32);
        if (sel staged.err) { ret err[fail.Fail].err{staged.err}; }
        var j: usize = 0;
        for (j < node.entries.len) {
            val copied: err[fail.Fail] = type.field_table_stage_push_entry(?s.types, node.entries.data[j]);
            if (sel copied.err) { ret copied; }
            j = j + 1;
        }
        if (!type.is_nil(node.disc)) {
            val disc: err[fail.Fail] = type.set_tag_discriminator(?s.types, node.ty, node.disc);
            if (sel disc.err) { ret disc; }
        }
        val dec: type.Decoration = node.decoration;
        if (dec.align != 0 || dec.packed || dec.volatile_) {
            val decorated: err[fail.Fail] = type.decoration_set(?s.types, node.ty, dec);
            if (sel decorated.err) { ret decorated; }
        }
        val published: err[fail.Fail] = type.field_table_publish(?s.types, node.ty,
            staged.ok, node.entries.len::u32);
        if (sel published.err) { ret published; }
        i = i + 1;
    }
    graph.installed            = true;
    graph.installed_generation = generation;
    ret err[fail.Fail].ok{};
}
