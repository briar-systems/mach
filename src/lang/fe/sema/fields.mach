use T: std.allocator.testing;
use std.collections.sort;
use vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.deprecation;
use mach.lang.fe.ast.id;
use mach.lang.intern;
use mach.lang.fail;
use mach.lang.session;
use mach.lang.target.isa;
use mach.lang.type;

pub rec Node {
    ty: type.TypeId;
    entries: vector.Vector[type.FieldEntry];
    has_align: bool;
    align: u32;
    packed: bool;
    volatile_: bool;
    # the declared discriminator of a tag nominal; TYPE_NIL on every other node
    disc: type.TypeId;
}

pub rec Roots {
    data: *type.TypeId;
    len: usize;
}

pub def CaptureMode: u8;

pub val RECIPES: CaptureMode = 0;
pub val MATERIALIZED: CaptureMode = 1;

pub rec Graph {
    nodes: vector.Vector[Node];
    installed: bool;
    installed_generation: u64;
}

pub fun init(a: *A.Allocator) Graph {
    ret Graph{ nodes: vector.init[Node](a), installed: false, installed_generation: 0 };
}

pub fun dnit(graph: *Graph) {
    var i: usize = 0;
    for (i < graph.nodes.len) {
        vector.dnit[type.FieldEntry](?graph.nodes.data[i].entries);
        i = i + 1;
    }
    vector.dnit[Node](?graph.nodes);
}

fun node_compare(left: *Node, right: *Node) i64 {
    if (left.ty < right.ty) { ret -1; }
    if (left.ty > right.ty) { ret 1; }
    ret 0;
}

fun enqueue(ti: *type.TypeInterner, scan: *type.TypeScan, pending: *vector.Vector[type.TypeId],
            ty: type.TypeId) err[fail.Fail] {
    if (ty == type.TYPE_NIL || ty == type.TYPE_ERROR) { ret err[fail.Fail].ok{}; }
    val found: opt[*type.Type] = type.get_typed(ti, ty);
    if (!sel found.some) { ret err[fail.Fail].err{fail.message("field graph contains an invalid type identity")}; }
    val marked: res[type.VisitMark, fail.Fail] = type.type_scan_mark(ti, scan, ty);
    if (sel marked.err) { ret err[fail.Fail].err{marked.err}; }
    if (marked.ok == type.VISIT_SEEN) { ret err[fail.Fail].ok{}; }
    val queued: res[usize, A.Error] = vector.push[type.TypeId](pending, ty);
    if (sel queued.err) { ret err[fail.Fail].err{fail.refused(queued.err)}; }
    ret err[fail.Fail].ok{};
}

fun enqueue_parameters(ti: *type.TypeInterner, scan: *type.TypeScan, pending: *vector.Vector[type.TypeId],
                       start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val parameter: opt[type.TypeId] = type.get_param_typed(ti, start + i);
        if (!sel parameter.some) { ret err[fail.Fail].err{fail.message("field graph contains an invalid type parameter run")}; }
        val added: err[fail.Fail] = enqueue(ti, scan, pending, parameter.some);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun enqueue_handle(ti: *type.TypeInterner, scan: *type.TypeScan, pending: *vector.Vector[type.TypeId],
                   handle: type.TypeHandle, defs: *isa.TargetDefs) err[fail.Fail] {
    if (handle.ctor == isa.NO_TYPE_CTOR) { ret err[fail.Fail].ok{}; }
    if (defs == nil) { ret err[fail.Fail].err{fail.message("field graph handle has no acquired constructor schema")}; }
    val schema: *isa.TypeDef = isa.type_def_by_tag(defs, handle.ctor);
    if (schema == nil || schema.arity != handle.ops_len || (schema.arity != 0 && schema.operands == nil)) {
        ret err[fail.Fail].err{fail.message("field graph handle disagrees with its constructor schema")};
    }
    if (handle.ops_start > ti.handle_ops_len || handle.ops_len > ti.handle_ops_len - handle.ops_start) {
        ret err[fail.Fail].err{fail.message("field graph handle has an invalid operand run")};
    }
    var i: u32 = 0;
    for (i < schema.arity) {
        if (schema.operands[i] != isa.TYPE_OPERAND_WORD) {
            val child: type.TypeId = ti.handle_ops[handle.ops_start + i]::type.TypeId;
            val info: opt[*type.Type] = type.get_typed(ti, child);
            if (!sel info.some) {
                ret err[fail.Fail].err{fail.message("field graph handle operand does not match its required constructor")};
            }
            if (info.some.kind != type.TYPE_HANDLE || info.some.data.handle.ctor != schema.operands[i]) {
                ret err[fail.Fail].err{fail.message("field graph handle operand does not match its required constructor")};
            }
            val added: err[fail.Fail] = enqueue(ti, scan, pending, child);
            if (sel added.err) { ret added; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun capture_node(s: *session.Session, graph: *Graph, scan: *type.TypeScan,
                 pending: *vector.Vector[type.TypeId], ty: type.TypeId) err[fail.Fail] {
    var node: Node;
    node.ty = ty;
    node.entries = vector.init[type.FieldEntry](graph.nodes.a);
    node.has_align = false;
    node.align = 0;
    node.packed = session.type_is_packed(s, ty::u32);
    node.volatile_ = session.type_is_volatile(s, ty::u32);
    node.disc = type.tag_discriminator(?s.types, ty);
    val alignment: O.Option[u32] = session.type_align(s, ty::u32);
    if (O.is_some[u32](alignment)) { node.has_align = true; node.align = O.unwrap[u32](alignment); }
    var transferred: bool = false;
    fin { if (!transferred) { vector.dnit[type.FieldEntry](?node.entries); } }
    val table: opt[*type.FieldTable] = type.field_table_for_typed(?s.types, ty);
    if (!sel table.some) { ret err[fail.Fail].err{fail.message("prepared nominal field recipe is unavailable")}; }
    {
        val current: *type.FieldTable = table.some;
        var i: u32 = 0;
        for (i < current.fields_len) {
            val field: *type.FieldEntry = type.field_entry_at(?s.types, current, i);
            if (field == nil) { ret err[fail.Fail].err{fail.message("field graph contains an invalid field run")}; }
            val copied: res[usize, A.Error] = vector.push[type.FieldEntry](?node.entries, @field);
            if (sel copied.err) { ret err[fail.Fail].err{fail.refused(copied.err)}; }
            val added: err[fail.Fail] = enqueue(?s.types, scan, pending, field.ty);
            if (sel added.err) { ret added; }
            i = i + 1;
        }
    }
    val appended: res[usize, A.Error] = vector.push[Node](?graph.nodes, node);
    if (sel appended.err) { ret err[fail.Fail].err{fail.refused(appended.err)}; }
    transferred = true;
    ret err[fail.Fail].ok{};
}

# the typed reading of a capture, which keeps its 1.x carrier for the driver
pub fun captured_of(r: R.Result[Graph, fail.Fail]) res[Graph, fail.Fail] {
    if (R.is_err[Graph, fail.Fail](r)) { ret res[Graph, fail.Fail].err{R.unwrap_err[Graph, fail.Fail](r)}; }
    ret res[Graph, fail.Fail].ok{R.unwrap_ok[Graph, fail.Fail](r)};
}

# the preparation callback and the graph outcome are a driver-boundary
# contract (driver.passes implements the callback), so capture keeps the 1.x
# carrier on both until the flip (#3226)
pub fun capture[T](s: *session.Session, a: *A.Allocator, roots: *Roots, count: usize, mode: CaptureMode, defs: *isa.TargetDefs, ctx: *T,
                   prepare: fun(*T, type.TypeId) R.Result[R.Void, fail.Fail]) R.Result[Graph, fail.Fail] {
    if (mode != RECIPES && mode != MATERIALIZED) { ret R.err[Graph, fail.Fail](fail.message("invalid field graph capture mode")); }
    if (roots == nil && count != 0) { ret R.err[Graph, fail.Fail](fail.message("field graph roots are nil")); }
    if (ctx == nil || prepare == nil) { ret R.err[Graph, fail.Fail](fail.message("field graph capture requires an active preparation capability")); }
    var graph: Graph = init(a);
    var complete: bool = false;
    fin { if (!complete) { dnit(?graph); } }
    var scan: type.TypeScan;
    val scanning: err[fail.Fail] = type.type_scan_begin(?s.types, ?scan);
    if (sel scanning.err) { ret R.err[Graph, fail.Fail](scanning.err); }
    fin { type.type_scan_end(?s.types, ?scan); }
    var pending: vector.Vector[type.TypeId] = vector.init[type.TypeId](a);
    fin { vector.dnit[type.TypeId](?pending); }
    var i: usize = 0;
    for (i < count) {
        val group: Roots = roots[i];
        if (group.data == nil && group.len != 0) { ret R.err[Graph, fail.Fail](fail.message("field graph root group is nil")); }
        var j: usize = 0;
        for (j < group.len) {
            val added: err[fail.Fail] = enqueue(?s.types, ?scan, ?pending, group.data[j]);
            if (sel added.err) { ret R.err[Graph, fail.Fail](added.err); }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < pending.len) {
        val ty: type.TypeId = pending.data[i];
        val initial: opt[*type.Type] = type.get_typed(?s.types, ty);
        if (!sel initial.some) { ret R.err[Graph, fail.Fail](fail.message("field graph contains an invalid type identity")); }
        val kind: type.TypeKind = initial.some.kind;
        if (kind == type.TYPE_REC || kind == type.TYPE_UNI || kind == type.TYPE_TAG) {
            val prepared: R.Result[R.Void, fail.Fail] = prepare(ctx, ty);
            if (R.is_err[R.Void, fail.Fail](prepared)) { ret R.err[Graph, fail.Fail](R.unwrap_err[R.Void, fail.Fail](prepared)); }
        }
        val info: opt[*type.Type] = type.get_typed(?s.types, ty);
        if (!sel info.some) { ret R.err[Graph, fail.Fail](fail.message("field graph type disappeared during capture")); }
        val node: *type.Type = info.some;
        var child: type.TypeId = type.TYPE_NIL;
        if (node.kind == type.TYPE_POINTER) { child = node.data.pointer.base; }
        or (node.kind == type.TYPE_ARRAY) { child = node.data.array.base; }
        or (node.kind == type.TYPE_SECRET) { child = node.data.secret.base; }
        or (node.kind == type.TYPE_FUN) {
            child = node.data.fn.ret_type;
            val parameters: err[fail.Fail] = enqueue_parameters(?s.types, ?scan, ?pending,
                node.data.fn.params_start, node.data.fn.params_len);
            if (sel parameters.err) { ret R.err[Graph, fail.Fail](parameters.err); }
        }
        or (node.kind == type.TYPE_INSTANCE) {
            child = node.data.instance.nominal;
            val parameters: err[fail.Fail] = enqueue_parameters(?s.types, ?scan, ?pending,
                node.data.instance.args_start, node.data.instance.args_len);
            if (sel parameters.err) { ret R.err[Graph, fail.Fail](parameters.err); }
        }
        or (node.kind == type.TYPE_HANDLE) {
            val operands: err[fail.Fail] = enqueue_handle(?s.types, ?scan, ?pending, node.data.handle, defs);
            if (sel operands.err) { ret R.err[Graph, fail.Fail](operands.err); }
        }
        val added: err[fail.Fail] = enqueue(?s.types, ?scan, ?pending, child);
        if (sel added.err) { ret R.err[Graph, fail.Fail](added.err); }
        val table: opt[*type.FieldTable] = type.field_table_for_typed(?s.types, ty);
        if (node.kind == type.TYPE_REC || node.kind == type.TYPE_UNI || node.kind == type.TYPE_TAG
            || (mode == MATERIALIZED && node.kind == type.TYPE_INSTANCE && sel table.some)) {
            val copied: err[fail.Fail] = capture_node(s, ?graph, ?scan, ?pending, ty);
            if (sel copied.err) { ret R.err[Graph, fail.Fail](copied.err); }
        }
        i = i + 1;
    }
    sort.sort[Node](graph.nodes.data, graph.nodes.len, node_compare);
    complete = true;
    ret R.ok[Graph, fail.Fail](graph);
}

fun same_fields(s: *session.Session, table: *type.FieldTable, node: *Node) bool {
    if (table.fields_len::usize != node.entries.len) { ret false; }
    var i: u32 = 0;
    for (i < table.fields_len) {
        val entry: *type.FieldEntry = type.field_entry_at(?s.types, table, i);
        if (entry == nil || entry.name != node.entries.data[i].name || entry.ty != node.entries.data[i].ty
            || !deprecation.equal(entry.deprecation, node.entries.data[i].deprecation)) { ret false; }
        i = i + 1;
    }
    if (type.tag_discriminator(?s.types, node.ty) != node.disc) { ret false; }
    val alignment: O.Option[u32] = session.type_align(s, node.ty::u32);
    if (O.is_some[u32](alignment) != node.has_align) { ret false; }
    if (node.has_align && O.unwrap[u32](alignment) != node.align) { ret false; }
    ret session.type_is_packed(s, node.ty::u32) == node.packed
        && session.type_is_volatile(s, node.ty::u32) == node.volatile_;
}

# translation shim (#3226): the legacy carrier the unmigrated driver still
# reads. deleted by the boundary flip, when the `_typed` core takes the name
pub fun install(s: *session.Session, graph: *Graph) R.Result[R.Void, str] {
    val r: err[fail.Fail] = install_typed(s, graph);
    if (sel r.err) { ret R.err[R.Void, str](fail.describe(r.err)); }
    ret R.ok_void[str]();
}

pub fun install_typed(s: *session.Session, graph: *Graph) err[fail.Fail] {
    # published tables only change through a projection reset, so a graph installed
    # under this projection verifies identically on every later acquisition
    val generation: u64 = s.types.projection_generation;
    if (graph.installed && graph.installed_generation == generation) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < graph.nodes.len) {
        val node: *Node = ?graph.nodes.data[i];
        val existing: opt[*type.FieldTable] = type.field_table_for_typed(?s.types, node.ty);
        if (sel existing.some) {
            if (!same_fields(s, existing.some, node)) {
                ret err[fail.Fail].err{fail.message("field projection disagrees with an acquired definition")};
            }
            i = i + 1;
            cnt;
        }
        if (node.entries.len > 0xFFFFFFFF::usize) { ret err[fail.Fail].err{fail.message("field projection exceeds the field count limit")}; }
        val staged: res[u32, fail.Fail] = type.field_table_stage(?s.types, node.entries.len::u32);
        if (sel staged.err) { ret err[fail.Fail].err{staged.err}; }
        var j: usize = 0;
        for (j < node.entries.len) {
            val copied: err[fail.Fail] = type.field_table_stage_push_entry(?s.types, node.entries.data[j]);
            if (sel copied.err) { ret copied; }
            j = j + 1;
        }
        if (node.disc != type.TYPE_NIL) {
            val disc: err[fail.Fail] = type.set_tag_discriminator(?s.types, node.ty, node.disc);
            if (sel disc.err) { ret disc; }
        }
        if (node.has_align) {
            val aligned: err[fail.Fail] = fail.lift_err(session.register_type_align(s, node.ty::u32, node.align));
            if (sel aligned.err) { ret aligned; }
        }
        if (node.packed) {
            val packed: err[fail.Fail] = fail.lift_err(session.register_type_packed(s, node.ty::u32));
            if (sel packed.err) { ret packed; }
        }
        if (node.volatile_) {
            val volatile_: err[fail.Fail] = fail.lift_err(session.register_type_volatile(s, node.ty::u32));
            if (sel volatile_.err) { ret volatile_; }
        }
        val published: err[fail.Fail] = type.field_table_publish(?s.types, node.ty,
            staged.ok, node.entries.len::u32);
        if (sel published.err) { ret published; }
        i = i + 1;
    }
    graph.installed = true;
    graph.installed_generation = generation;
    ret err[fail.Fail].ok{};
}

fun t_prepared(s: *session.Session, ty: type.TypeId) R.Result[R.Void, fail.Fail] {
    ret R.ok_void[fail.Fail]();
}

fun t_one_field(s: *session.Session, owner: type.TypeId, field_type: type.TypeId) err[fail.Fail] {
    val staged: res[u32, fail.Fail] = type.field_table_stage(?s.types, 1);
    if (sel staged.err) { ret err[fail.Fail].err{staged.err}; }
    val pushed: err[fail.Fail] = type.field_table_stage_push(?s.types, 1::intern.StrId, field_type);
    if (sel pushed.err) { ret pushed; }
    ret type.field_table_publish(?s.types, owner, staged.ok, 1);
}

test "mach.lang.fe.sema.fields:circular_graph_owns_fields_and_remaps_rebuilt_projection_runs" {
    var tracker: T.Testing;
    val make_1: err[A.Error] = T.make(?tracker);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val allocated: *A.Allocator = T.allocator_of(?tracker);
    val initialized: R.Result[session.Session, str] = session.init(allocated);
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    var session_live: bool = true;
    fin { if (session_live) { session.dnit(?s); } }
    val first_r: res[type.TypeId, fail.Fail] = type.intern_nominal(?s.types, 1::intern.StrId, type.TypeOwner{ module: 0, file: 0 }, type.TYPE_REC);
    val second_r: res[type.TypeId, fail.Fail] = type.intern_nominal(?s.types, 2::intern.StrId, type.TypeOwner{ module: 0, file: 0 }, type.TYPE_REC);
    if (sel first_r.err) { ret 3; }
    if (sel second_r.err) { ret 3; }
    val first: type.TypeId = first_r.ok;
    val second: type.TypeId = second_r.ok;
    val to_first_r: res[type.TypeId, fail.Fail] = type.intern_pointer(?s.types, first);
    val to_second_r: res[type.TypeId, fail.Fail] = type.intern_pointer(?s.types, second);
    if (sel to_first_r.err) { ret 4; }
    if (sel to_second_r.err) { ret 4; }
    val to_first: type.TypeId = to_first_r.ok;
    val to_second: type.TypeId = to_second_r.ok;
    val one_a: err[fail.Fail] = t_one_field(?s, second, to_first);
    val one_b: err[fail.Fail] = t_one_field(?s, first, to_second);
    if (sel one_a.err) { ret 5; }
    if (sel one_b.err) { ret 5; }
    if (R.is_err[R.Void, str](session.register_type_align(?s, first::u32, 16))
        || R.is_err[R.Void, str](session.register_type_packed(?s, first::u32))
        || R.is_err[R.Void, str](session.register_type_volatile(?s, first::u32))) { ret 6; }
    val prior: opt[*type.FieldTable] = type.field_table_for_typed(?s.types, first);
    if (!sel prior.some) { ret 7; }
    val prior_start: u32 = prior.some.fields_start;
    var root: type.TypeId = first;
    var roots: Roots = Roots{ data: ?root, len: 1 };
    val captured: res[Graph, fail.Fail] = captured_of(capture[session.Session](?s, allocated, ?roots, 1, MATERIALIZED, nil, ?s, t_prepared));
    if (sel captured.err) { ret 8; }
    var graph: Graph = captured.ok;
    var graph_live: bool = true;
    fin { if (graph_live) { dnit(?graph); } }
    if (graph.nodes.len != 2 || graph.nodes.data[0].ty != first || graph.nodes.data[1].ty != second) { ret 9; }
    var baseline: usize = 0;
    var iteration: u32 = 0;
    for (iteration < 32) {
        if (R.is_err[R.Void, str](session.reset_type_projection(?s))) { ret 10; }
        if (type.field_count(?s.types, first) != 0 || session.type_is_packed(?s, first::u32)
            || session.type_is_volatile(?s, first::u32) || O.is_some[u32](session.type_align(?s, first::u32))) { ret 10; }
        val install_typed_2: err[fail.Fail] = install_typed(?s, ?graph);
        if (sel install_typed_2.err) { ret 11; }
        val current: opt[*type.FieldTable] = type.field_table_for_typed(?s.types, first);
        if (!sel current.some) { ret 12; }
        if (current.some.fields_start == prior_start) { ret 12; }
        val field: opt[*type.FieldEntry] = type.field_at_typed(?s.types, first, 0);
        if (!sel field.some) { ret 13; }
        if (field.some.ty != to_second) { ret 13; }
        if (!session.type_is_packed(?s, first::u32) || !session.type_is_volatile(?s, first::u32)) { ret 14; }
        val alignment: O.Option[u32] = session.type_align(?s, first::u32);
        if (O.is_none[u32](alignment) || O.unwrap[u32](alignment) != 16) { ret 15; }
        val before: usize = T.live_count(?tracker);
        val install_typed_3: err[fail.Fail] = install_typed(?s, ?graph);
        if (sel install_typed_3.err) { ret 16; }
        if (T.live_count(?tracker) != before) { ret 16; }
        if (iteration == 1) { baseline = T.live_count(?tracker); }
        if (iteration > 1 && T.live_count(?tracker) != baseline) { ret 17; }
        iteration = iteration + 1;
    }
    dnit(?graph);
    graph_live = false;
    session.dnit(?s);
    session_live = false;
    if (T.live_count(?tracker) != 0 || T.double_free_count(?tracker) != 0) { ret 18; }
    ret 0;
}

test "mach.lang.fe.sema.fields:install_verifies_once_per_projection" {
    var tracker: T.Testing;
    val make_1: err[A.Error] = T.make(?tracker);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val allocated: *A.Allocator = T.allocator_of(?tracker);
    val initialized: R.Result[session.Session, str] = session.init(allocated);
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    fin { session.dnit(?s); }
    val first_r: res[type.TypeId, fail.Fail] = type.intern_nominal(?s.types, 1::intern.StrId, type.TypeOwner{ module: 0, file: 0 }, type.TYPE_REC);
    val second_r: res[type.TypeId, fail.Fail] = type.intern_nominal(?s.types, 2::intern.StrId, type.TypeOwner{ module: 0, file: 0 }, type.TYPE_REC);
    if (sel first_r.err) { ret 3; }
    if (sel second_r.err) { ret 3; }
    val first: type.TypeId = first_r.ok;
    val second: type.TypeId = second_r.ok;
    val to_first_r: res[type.TypeId, fail.Fail] = type.intern_pointer(?s.types, first);
    val to_second_r: res[type.TypeId, fail.Fail] = type.intern_pointer(?s.types, second);
    if (sel to_first_r.err) { ret 4; }
    if (sel to_second_r.err) { ret 4; }
    val to_first: type.TypeId = to_first_r.ok;
    val to_second: type.TypeId = to_second_r.ok;
    val one_a: err[fail.Fail] = t_one_field(?s, second, to_first);
    val one_b: err[fail.Fail] = t_one_field(?s, first, to_second);
    if (sel one_a.err) { ret 5; }
    if (sel one_b.err) { ret 5; }
    var root: type.TypeId = first;
    var roots: Roots = Roots{ data: ?root, len: 1 };
    val captured: res[Graph, fail.Fail] = captured_of(capture[session.Session](?s, allocated, ?roots, 1, MATERIALIZED, nil, ?s, t_prepared));
    if (sel captured.err) { ret 6; }
    var graph: Graph = captured.ok;
    fin { dnit(?graph); }
    if (graph.nodes.len != 2 || graph.nodes.data[0].ty != first || graph.nodes.data[0].entries.len != 1) { ret 7; }

    if (R.is_err[R.Void, str](session.reset_type_projection(?s))) { ret 8; }
    val install_typed_2: err[fail.Fail] = install_typed(?s, ?graph);
    if (sel install_typed_2.err) { ret 9; }

    # a graph installed under this projection is not compared with the tables again,
    # so a disagreement introduced afterwards goes unseen until the projection resets
    graph.nodes.data[0].entries.data[0].ty = to_first;
    val install_typed_3: err[fail.Fail] = install_typed(?s, ?graph);
    if (sel install_typed_3.err) { ret 10; }
    val kept: opt[*type.FieldEntry] = type.field_at_typed(?s.types, first, 0);
    if (!sel kept.some) { ret 11; }
    if (kept.some.ty != to_second) { ret 11; }

    if (R.is_err[R.Void, str](session.reset_type_projection(?s))) { ret 12; }
    val install_typed_4: err[fail.Fail] = install_typed(?s, ?graph);
    if (sel install_typed_4.err) { ret 13; }
    val republished: opt[*type.FieldEntry] = type.field_at_typed(?s.types, first, 0);
    if (!sel republished.some) { ret 14; }
    if (republished.some.ty != to_first) { ret 14; }

    # the same projection with a foreign table that disagrees is still refused on first install
    var again: Graph = init(allocated);
    fin { dnit(?again); }
    val recaptured: res[Graph, fail.Fail] = captured_of(capture[session.Session](?s, allocated, ?roots, 1, MATERIALIZED, nil, ?s, t_prepared));
    if (sel recaptured.err) { ret 15; }
    dnit(?again);
    again = recaptured.ok;
    again.nodes.data[0].entries.data[0].ty = to_second;
    val install_typed_5: err[fail.Fail] = install_typed(?s, ?again);
    if (sel install_typed_5.ok) { ret 16; }
    ret 0;
}

rec RecipeProbe {
    s: *session.Session;
    calls: u32;
}

fun t_recipe_prepare(probe: *RecipeProbe, ty: type.TypeId) R.Result[R.Void, fail.Fail] {
    val found: opt[*type.Type] = type.get_typed(?probe.s.types, ty);
    if (!sel found.some) { ret R.err[R.Void, fail.Fail](fail.message("recipe type is missing")); }
    val kind: type.TypeKind = found.some.kind;
    if (kind != type.TYPE_REC && kind != type.TYPE_UNI && kind != type.TYPE_TAG) {
        ret R.err[R.Void, fail.Fail](fail.message("capture tried to materialize an instance"));
    }
    probe.calls = probe.calls + 1;
    ret R.ok_void[fail.Fail]();
}

fun t_instance_pointer(s: *session.Session, nominal: type.TypeId, argument: type.TypeId) res[type.TypeId, fail.Fail] {
    var args: [1]type.TypeId;
    args[0] = argument;
    val instance: res[type.TypeId, fail.Fail] = type.intern_instance(?s.types, nominal, ?args[0], 1);
    if (sel instance.err) { ret instance; }
    ret type.intern_pointer(?s.types, instance.ok);
}

test "mach.lang.fe.sema.fields:growing_pointer_recipe_does_not_expand_incidental_instances" {
    var tracker: T.Testing;
    val make_1: err[A.Error] = T.make(?tracker);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val alloc: *A.Allocator = T.allocator_of(?tracker);
    val initialized: R.Result[session.Session, str] = session.init(alloc);
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    fin { session.dnit(?s); }
    val nom_r: res[type.TypeId, fail.Fail] = type.intern_nominal(?s.types, 1::intern.StrId, type.TypeOwner{ module: 0, file: 0 }, type.TYPE_REC);
    val gp_r: res[type.TypeId, fail.Fail] = type.intern_generic_param(?s.types, 2::intern.StrId, type.TypeOwner{ module: 0, file: 0 }, 1::intern.StrId, type.TYPE_REC, 0);
    if (sel nom_r.err) { ret 3; }
    if (sel gp_r.err) { ret 3; }
    val nominal: type.TypeId = nom_r.ok;
    val argument_pointer: res[type.TypeId, fail.Fail] = type.intern_pointer(?s.types, gp_r.ok);
    if (sel argument_pointer.err) { ret 4; }
    val next_template: res[type.TypeId, fail.Fail] = t_instance_pointer(?s, nominal, argument_pointer.ok);
    if (sel next_template.err) { ret 5; }
    val template_type: type.TypeId = next_template.ok;
    val t_one_field_2: err[fail.Fail] = t_one_field(?s, nominal, template_type);
    if (sel t_one_field_2.err) { ret 6; }
    val primitive: opt[type.TypeId] = type.prim_typed(?s.types, type.TYPE_U32);
    if (!sel primitive.some) { ret 7; }
    var args: [1]type.TypeId;
    args[0] = primitive.some;
    val instance_r: res[type.TypeId, fail.Fail] = type.intern_instance(?s.types, nominal, ?args[0], 1);
    if (sel instance_r.err) { ret 8; }
    var instance: type.TypeId = instance_r.ok;
    var roots: Roots = Roots{ data: ?instance, len: 1 };
    var probe: RecipeProbe = RecipeProbe{ s: ?s, calls: 0 };
    val cold_r: res[Graph, fail.Fail] = captured_of(capture[RecipeProbe](?s, alloc, ?roots, 1, RECIPES, nil, ?probe, t_recipe_prepare));
    if (sel cold_r.err) { ret 9; }
    var cold: Graph = cold_r.ok;
    fin { dnit(?cold); }
    if (probe.calls != 1 || cold.nodes.len != 1 || cold.nodes.data[0].ty != nominal) { ret 10; }
    if (cold.nodes.data[0].entries.len != 1 || cold.nodes.data[0].entries.data[0].ty != template_type) { ret 11; }
    val field_table_for_typed_3: opt[*type.FieldTable] = type.field_table_for_typed(?s.types, instance);
    if (sel field_table_for_typed_3.some) { ret 12; }
    val to_primitive: res[type.TypeId, fail.Fail] = type.intern_pointer(?s.types, args[0]);
    if (sel to_primitive.err) { ret 13; }
    val next_concrete: res[type.TypeId, fail.Fail] = t_instance_pointer(?s, nominal, to_primitive.ok);
    if (sel next_concrete.err) { ret 14; }
    val one_c: err[fail.Fail] = t_one_field(?s, instance, next_concrete.ok);
    if (sel one_c.err) { ret 15; }
    probe.calls = 0;
    val warm_r: res[Graph, fail.Fail] = captured_of(capture[RecipeProbe](?s, alloc, ?roots, 1, RECIPES, nil, ?probe, t_recipe_prepare));
    if (sel warm_r.err) { ret 16; }
    var warm: Graph = warm_r.ok;
    fin { dnit(?warm); }
    if (probe.calls != 1 || warm.nodes.len != cold.nodes.len || warm.nodes.data[0].ty != nominal) { ret 17; }
    if (warm.nodes.data[0].entries.len != 1 || warm.nodes.data[0].entries.data[0].ty != template_type) { ret 18; }
    probe.calls = 0;
    val full_r: res[Graph, fail.Fail] = captured_of(capture[RecipeProbe](?s, alloc, ?roots, 1, MATERIALIZED, nil, ?probe, t_recipe_prepare));
    if (sel full_r.err) { ret 19; }
    var full: Graph = full_r.ok;
    fin { dnit(?full); }
    if (probe.calls != 1 || full.nodes.len != 2) { ret 20; }
    ret 0;
}

test "mach.lang.fe.sema.fields:handle_edges_follow_constructor_schema_and_skip_literal_words" {
    var tracker: T.Testing;
    val make_1: err[A.Error] = T.make(?tracker);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?tracker); }
    val initialized: R.Result[session.Session, str] = session.init(T.allocator_of(?tracker));
    if (R.is_err[session.Session, str](initialized)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](initialized);
    fin { session.dnit(?s); }
    var word_schema: u32 = isa.TYPE_OPERAND_WORD;
    var wrapper_schema: [2]u32 = [2]u32{ isa.TYPE_OPERAND_WORD, 10 };
    var constructors: [2]isa.TypeDef;
    constructors[0] = isa.type_def("word", 10, ?word_schema, 1, nil);
    constructors[1] = isa.type_def("wrapper", 11, ?wrapper_schema[0], 2, nil);
    var defs: isa.TargetDefs = isa.TargetDefs{ types: ?constructors[0], type_count: 2 };
    var literal: u32 = 0xFFFFFFFD;
    val leaf: res[type.TypeId, fail.Fail] = type.intern_handle_typed(?s.types, 1, 10, ?literal, 1);
    if (sel leaf.err) { ret 3; }
    var operands: [2]u32 = [2]u32{ literal, leaf.ok::u32 };
    val wrapper: res[type.TypeId, fail.Fail] = type.intern_handle_typed(?s.types, 2, 11, ?operands[0], 2);
    if (sel wrapper.err) { ret 4; }
    var root: type.TypeId = wrapper.ok;
    var roots: Roots = Roots{ data: ?root, len: 1 };
    val captured: res[Graph, fail.Fail] = captured_of(capture[session.Session](?s, s.alloc, ?roots, 1, RECIPES, ?defs, ?s, t_prepared));
    if (sel captured.err) { ret 5; }
    var graph: Graph = captured.ok;
    dnit(?graph);
    constructors[0].operands = ?wrapper_schema[1];
    val refused: res[Graph, fail.Fail] = captured_of(capture[session.Session](?s, s.alloc, ?roots, 1, RECIPES, ?defs, ?s, t_prepared));
    if (sel refused.ok) {
        graph = refused.ok;
        dnit(?graph);
        ret 6;
    }
    if (!fail.is_message(refused.err)) { ret 7; }
    ret 0;
}
