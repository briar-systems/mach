use std.allocator.page;
use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.id;
use atype: mach.lang.fe.ast.type;
use sema: mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.session;
use mach.lang.source;
use mach.lang.type;

rec GParamWalk {
    scan:     type.TypeScan;
    resolved: bool;
}

fun gparam_walk_begin(s: *session.Session, w: *GParamWalk) {
    type.type_scan_begin(?s.types, ?w.scan);
    w.resolved = true;
}

fun gparam_walk_end(s: *session.Session, w: *GParamWalk) {
    type.type_scan_end(?s.types, ?w.scan);
}

pub fun instantiate(
    sc:             *sema.SemaContext,
    generic_decl:   id.DeclId,
    generic_origin: session.ModuleId,
    args:           *type.TypeId,
    arg_count:      u32,
    span:           token.Span
) R.Result[type.TypeId, str] {
    if (generic_decl == id.DECL_NIL) {
        sema.report(sc, span, "not a generic: declaration is not generic");
        ret R.ok[type.TypeId, str](type.TYPE_ERROR);
    }

    if (!check_arity(sc, generic_decl, generic_origin, arg_count, span)) {
        ret R.ok[type.TypeId, str](type.TYPE_ERROR);
    }

    var i: u32 = 0;
    for (i < arg_count) {
        if (args[i] == type.TYPE_NIL || args[i] == type.TYPE_ERROR) {
            sema.report_numbered(sc, span, "generic argument ", (i + 1)::usize, " is not a valid type", "generic argument is not a valid type");
            ret R.ok[type.TypeId, str](type.TYPE_ERROR);
        }
        i = i + 1;
    }

    val gnom: type.TypeId = generic_nominal_of(sc.s, generic_origin, generic_decl);
    ret type.intern_instance(?sc.s.types, gnom, generic_origin, generic_decl, args, arg_count);
}

pub fun check_arity(
    sc:             *sema.SemaContext,
    generic_decl:   id.DeclId,
    generic_origin: session.ModuleId,
    arg_count:      u32,
    span:           token.Span
) bool {
    val a: *ast.Ast = declaring_ast(sc, generic_origin);
    if (a == nil) { ret true; }

    val opt_want: O.Option[u32] = generic_count_in(a, generic_decl);
    if (O.is_none[u32](opt_want)) {
        sema.report(sc, span, "not a generic: declaration takes no type parameters");
        ret false;
    }

    val want: u32 = O.unwrap[u32](opt_want);
    if (arg_count != want) {
        report_type_arg_count(sc, span, "wrong number of type arguments", want, arg_count);
        ret false;
    }
    ret true;
}

pub fun declared_arity(sc: *sema.SemaContext, generic_decl: id.DeclId, generic_origin: session.ModuleId) u32 {
    val a: *ast.Ast = declaring_ast(sc, generic_origin);
    if (a == nil) { ret 0; }

    val opt_want: O.Option[u32] = generic_count_in(a, generic_decl);
    if (O.is_none[u32](opt_want)) { ret 0; }
    ret O.unwrap[u32](opt_want);
}

fun declaring_ast(sc: *sema.SemaContext, origin: session.ModuleId) *ast.Ast {
    if (origin == sc.own_module) { ret sc.a; }
    ret session.module_ast(sc.s, origin);
}

pub fun substitute(s: *session.Session, body_type: type.TypeId, args: *type.TypeId, arg_count: u32) type.TypeId {
    if (body_type == type.TYPE_NIL || body_type == type.TYPE_ERROR) { ret body_type; }

    val opt_type: O.Option[*type.Type] = type.get(?s.types, body_type);
    if (O.is_none[*type.Type](opt_type)) { ret body_type; }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);

    if (t.kind == type.TYPE_GENERIC_PARAM) {
        val index: u32 = t.data.generic_param.index;
        if (index < arg_count) { ret args[index]; }
        ret type.TYPE_ERROR;
    }

    if (t.kind == type.TYPE_POINTER) {
        val original_base: type.TypeId = t.data.pointer.base;
        val base:          type.TypeId = substitute(s, original_base, args, arg_count);
        if (base == original_base) { ret body_type; }
        ret unwrap_or_error(type.intern_pointer(?s.types, base));
    }

    if (t.kind == type.TYPE_ARRAY) {
        val original_base: type.TypeId = t.data.array.base;
        val count:         u32         = t.data.array.count;
        val base:          type.TypeId = substitute(s, original_base, args, arg_count);
        if (base == original_base) { ret body_type; }
        ret unwrap_or_error(type.intern_array(?s.types, base, count));
    }

    if (t.kind == type.TYPE_SECRET) {
        val original_base: type.TypeId = t.data.secret.base;
        val base:          type.TypeId = substitute(s, original_base, args, arg_count);
        if (base == original_base) { ret body_type; }
        ret unwrap_or_error(type.intern_secret(?s.types, base));
    }

    if (t.kind == type.TYPE_FUN)      { ret substitute_fun(s, t, args, arg_count, body_type); }
    if (t.kind == type.TYPE_INSTANCE) { ret substitute_instance(s, t, args, arg_count, body_type); }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI) {
        if (!nominal_has_gparam(s, body_type)) { ret body_type; }
        ret substitute_aggregate(s, t, args, arg_count, body_type);
    }

    ret body_type;
}

pub fun ensure_fields(s: *session.Session, tid: type.TypeId) {
    val opt_existing: O.Option[*type.FieldTable] = type.field_table_for(?s.types, tid);
    if (O.is_some[*type.FieldTable](opt_existing)) {
        if (O.unwrap[*type.FieldTable](opt_existing).epoch == type.field_epoch(?s.types)) { ret; }
    }

    val opt_type: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_type)) { ret; }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);
    if (t.kind != type.TYPE_INSTANCE) { ret; }

    val origin: session.ModuleId = t.data.instance.target_origin;
    val gdecl:  id.DeclId        = t.data.instance.target_decl;

    val gnom: type.TypeId = generic_nominal_of(s, origin, gdecl);
    if (gnom == type.TYPE_ERROR) { ret; }

    build_instance_table(s, tid, gnom);
}

pub fun contains_secret_deep(s: *session.Session, tid: type.TypeId) bool {
    var scan: type.TypeScan;
    type.type_scan_begin(?s.types, ?scan);
    val found: bool = secret_deep_walk(s, tid, ?scan);
    type.type_scan_end(?s.types, ?scan);
    ret found;
}

fun kind_is_public_leaf(k: type.TypeKind) bool {
    val pc: type.PrimClass = type.prim_desc(k).class;
    if (pc == type.PRIM_CLASS_INT || pc == type.PRIM_CLASS_FLOAT || pc == type.PRIM_CLASS_PTR) { ret true; }
    if (k == type.TYPE_VECTOR)        { ret true; }
    if (k == type.TYPE_HANDLE)         { ret true; }
    if (k == type.TYPE_ABI)            { ret true; }
    if (k == type.TYPE_GENERIC_PARAM) { ret true; }
    ret false;
}

fun fn_sig_carries_secret(s: *session.Session, t: *type.Type, scan: *type.TypeScan) bool {
    if (secret_deep_walk(s, t.data.fn.ret_type, scan)) { ret true; }
    var pi: u32 = 0;
    for (pi < t.data.fn.params_len) {
        val pp: O.Option[type.TypeId] = type.get_param(?s.types, t.data.fn.params_start + pi);
        if (O.is_some[type.TypeId](pp)) {
            if (secret_deep_walk(s, O.unwrap[type.TypeId](pp), scan)) { ret true; }
        }
        pi = pi + 1;
    }
    ret false;
}

fun secret_deep_walk(s: *session.Session, tid: type.TypeId, scan: *type.TypeScan) bool {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }

    val opt_type: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_type)) { ret true; }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);

    if (t.kind == type.TYPE_SECRET)  { ret true; }
    if (t.kind == type.TYPE_POINTER) { ret secret_deep_walk(s, t.data.pointer.base, scan); }
    if (t.kind == type.TYPE_ARRAY)   { ret secret_deep_walk(s, t.data.array.base, scan); }
    if (t.kind == type.TYPE_FUN)     { ret fn_sig_carries_secret(s, t, scan); }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_INSTANCE) {
        val mark: type.VisitMark = type.type_scan_mark(?s.types, scan, tid);
        if (mark == type.VISIT_SEEN) { ret false; }
        if (mark == type.VISIT_FAILED) { ret true; }

        if (t.kind == type.TYPE_INSTANCE) { ensure_fields(s, tid); }

        val opt_tab: O.Option[*type.FieldTable] = type.field_table_for(?s.types, tid);
        if (O.is_none[*type.FieldTable](opt_tab)) { ret true; }
        val fields_len: u32 = O.unwrap[*type.FieldTable](opt_tab).fields_len;

        var f: u32 = 0;
        for (f < fields_len) {
            val opt_e: O.Option[*type.FieldEntry] = type.field_at(?s.types, tid, f);
            if (O.is_some[*type.FieldEntry](opt_e)) {
                if (secret_deep_walk(s, O.unwrap[*type.FieldEntry](opt_e).ty, scan)) { ret true; }
            }
            f = f + 1;
        }
        ret false;
    }

    if (kind_is_public_leaf(t.kind)) { ret false; }
    ret true;
}

pub fun contains_float_deep(s: *session.Session, tid: type.TypeId) bool {
    var scan: type.TypeScan;
    type.type_scan_begin(?s.types, ?scan);
    val found: bool = float_deep_walk(s, tid, ?scan);
    type.type_scan_end(?s.types, ?scan);
    ret found;
}

fun fn_sig_carries_float(s: *session.Session, t: *type.Type, scan: *type.TypeScan) bool {
    if (float_deep_walk(s, t.data.fn.ret_type, scan)) { ret true; }
    var pi: u32 = 0;
    for (pi < t.data.fn.params_len) {
        val pp: O.Option[type.TypeId] = type.get_param(?s.types, t.data.fn.params_start + pi);
        if (O.is_some[type.TypeId](pp)) {
            if (float_deep_walk(s, O.unwrap[type.TypeId](pp), scan)) { ret true; }
        }
        pi = pi + 1;
    }
    ret false;
}

fun float_deep_walk(s: *session.Session, tid: type.TypeId, scan: *type.TypeScan) bool {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }

    val opt_type: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_type)) { ret true; }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);

    if (type.prim_desc(t.kind).class == type.PRIM_CLASS_FLOAT) { ret true; }
    if (t.kind == type.TYPE_SECRET)  { ret float_deep_walk(s, t.data.secret.base, scan); }
    if (t.kind == type.TYPE_POINTER) { ret float_deep_walk(s, t.data.pointer.base, scan); }
    if (t.kind == type.TYPE_ARRAY)   { ret float_deep_walk(s, t.data.array.base, scan); }
    if (t.kind == type.TYPE_VECTOR)  { ret type.prim_desc(t.data.vector.element).class == type.PRIM_CLASS_FLOAT; }
    if (t.kind == type.TYPE_FUN)     { ret fn_sig_carries_float(s, t, scan); }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_INSTANCE) {
        val mark: type.VisitMark = type.type_scan_mark(?s.types, scan, tid);
        if (mark == type.VISIT_SEEN) { ret false; }
        if (mark == type.VISIT_FAILED) { ret true; }

        if (t.kind == type.TYPE_INSTANCE) { ensure_fields(s, tid); }

        val opt_tab: O.Option[*type.FieldTable] = type.field_table_for(?s.types, tid);
        if (O.is_none[*type.FieldTable](opt_tab)) { ret true; }
        val fields_len: u32 = O.unwrap[*type.FieldTable](opt_tab).fields_len;

        var f: u32 = 0;
        for (f < fields_len) {
            val opt_e: O.Option[*type.FieldEntry] = type.field_at(?s.types, tid, f);
            if (O.is_some[*type.FieldEntry](opt_e)) {
                if (float_deep_walk(s, O.unwrap[*type.FieldEntry](opt_e).ty, scan)) { ret true; }
            }
            f = f + 1;
        }
        ret false;
    }

    if (kind_is_public_leaf(t.kind)) { ret false; }
    ret true;
}

fun describe_type(s: *session.Session, id: u32) layout.Node {
    val base: type.TypeId = type.strip_secret(?s.types, id::type.TypeId);

    val opt_type: O.Option[*type.Type] = type.get(?s.types, base);
    if (O.is_none[*type.Type](opt_type)) { ret layout.node(layout.NODE_UNKNOWN); }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);

    val d: type.PrimDesc = type.prim_desc(t.kind);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) {
        var n: layout.Node = layout.node(layout.NODE_SCALAR);
        n.bytes = d.bits / 8;
        ret n;
    }
    if (d.class == type.PRIM_CLASS_PTR || t.kind == type.TYPE_POINTER || t.kind == type.TYPE_FUN
        || t.kind == type.TYPE_HANDLE) {
        ret layout.node(layout.NODE_POINTER);
    }
    if (t.kind == type.TYPE_ABI) {
        var n: layout.Node = layout.node(layout.NODE_OPAQUE);
        n.bytes      = t.data.abi.size;
        n.decl_align = t.data.abi.align;
        ret n;
    }
    if (t.kind == type.TYPE_VECTOR) {
        var n: layout.Node = layout.node(layout.NODE_VECTOR);
        n.bytes = type.prim_desc(t.data.vector.element).bits / 8;
        n.count = t.data.vector.lanes;
        ret n;
    }

    if (t.kind == type.TYPE_ARRAY) {
        var n: layout.Node = layout.node(layout.NODE_ARRAY);
        n.child = t.data.array.base::u32;
        n.count = t.data.array.count;
        ret n;
    }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_INSTANCE) {
        if (t.kind == type.TYPE_INSTANCE) { ensure_fields(s, base); }

        val ov: O.Option[bool] = nominal_overlays(s, base);
        if (O.is_none[bool](ov)) { ret layout.node(layout.NODE_UNKNOWN); }
        val opt_tab: O.Option[*type.FieldTable] = type.field_table_for(?s.types, base);
        if (O.is_none[*type.FieldTable](opt_tab)) { ret layout.node(layout.NODE_UNKNOWN); }

        var n: layout.Node = layout.node(layout.NODE_AGGREGATE);
        n.field_count = O.unwrap[*type.FieldTable](opt_tab).fields_len;
        n.overlays    = O.unwrap[bool](ov);
        val ta: O.Option[u32] = session.type_align(s, base::u32);
        if (O.is_some[u32](ta)) { n.decl_align = O.unwrap[u32](ta); }
        n.packed = session.type_is_packed(s, base::u32);
        ret n;
    }

    ret layout.node(layout.NODE_UNKNOWN);
}

fun describe_type_field(s: *session.Session, id: u32, index: u32) u32 {
    val base: type.TypeId = type.strip_secret(?s.types, id::type.TypeId);
    val fe: O.Option[*type.FieldEntry] = type.field_at(?s.types, base, index);
    if (O.is_none[*type.FieldEntry](fe)) { ret type.TYPE_ERROR::u32; }
    ret O.unwrap[*type.FieldEntry](fe).ty::u32;
}

val SEMA_LAYOUT_MAX_DEPTH: u32 = 64;

pub fun type_extent(s: *session.Session, m: layout.Machine, tid: type.TypeId) layout.Extent {
    ret layout.extent_of[session.Session](s, describe_type, describe_type_field, tid::u32, m,
                                          SEMA_LAYOUT_MAX_DEPTH);
}

fun nominal_overlays(s: *session.Session, tid: type.TypeId) O.Option[bool] {
    val nom: type.TypeId = type.aggregate_nominal(?s.types, tid);
    if (nom == type.TYPE_ERROR) { ret O.none[bool](); }
    val opt_nom: O.Option[*type.Type] = type.get(?s.types, nom);
    if (O.is_none[*type.Type](opt_nom)) { ret O.none[bool](); }
    val k: type.TypeKind = O.unwrap[*type.Type](opt_nom).kind;
    if (k == type.TYPE_UNI) { ret O.some[bool](true); }
    if (k == type.TYPE_REC) { ret O.some[bool](false); }
    ret O.none[bool]();
}

rec SecrecyPairScan {
    scan:         type.PairScan;
    unrecordable: bool;
}

pub def SecrecyVerdict: u8;

pub val SECRECY_EQUAL:        SecrecyVerdict = 0;
pub val SECRECY_DIFFERS:      SecrecyVerdict = 1;
pub val SECRECY_UNRECORDABLE: SecrecyVerdict = 2;

pub fun secrecy_structure_equal_deep(s: *session.Session, m: layout.Machine, a: type.TypeId, b: type.TypeId) SecrecyVerdict {
    if (!contains_secret_deep(s, a) && !contains_secret_deep(s, b)) { ret SECRECY_EQUAL; }

    var scan: SecrecyPairScan;
    scan.unrecordable = false;
    type.pair_scan_begin(?s.types, ?scan.scan);
    val equal: bool = sse_deep_walk(s, m, a, b, ?scan);
    type.pair_scan_end(?s.types, ?scan.scan);

    if (scan.unrecordable) { ret SECRECY_UNRECORDABLE; }
    if (equal)             { ret SECRECY_EQUAL; }
    ret SECRECY_DIFFERS;
}

fun sse_deep_walk(s: *session.Session, m: layout.Machine, a: type.TypeId, b: type.TypeId, scan: *SecrecyPairScan) bool {
    if (type.is_secret(?s.types, a) != type.is_secret(?s.types, b)) { ret false; }

    val sa: type.TypeId = type.strip_secret(?s.types, a);
    val sb: type.TypeId = type.strip_secret(?s.types, b);
    val oa: O.Option[*type.Type] = type.get(?s.types, sa);
    val ob: O.Option[*type.Type] = type.get(?s.types, sb);
    if (O.is_none[*type.Type](oa) || O.is_none[*type.Type](ob)) { ret false; }
    val ta: *type.Type = O.unwrap[*type.Type](oa);
    val tb: *type.Type = O.unwrap[*type.Type](ob);

    if (ta.kind == type.TYPE_POINTER && tb.kind == type.TYPE_POINTER) {
        ret sse_deep_walk(s, m, ta.data.pointer.base, tb.data.pointer.base, scan);
    }
    if (ta.kind == type.TYPE_ARRAY && tb.kind == type.TYPE_ARRAY) {
        ret sse_deep_walk(s, m, ta.data.array.base, tb.data.array.base, scan);
    }
    if (ta.kind == type.TYPE_FUN && tb.kind == type.TYPE_FUN) {
        if (ta.data.fn.params_len != tb.data.fn.params_len) { ret false; }
        if (!sse_deep_walk(s, m, ta.data.fn.ret_type, tb.data.fn.ret_type, scan)) { ret false; }
        var pi: u32 = 0;
        for (pi < ta.data.fn.params_len) {
            val pa: O.Option[type.TypeId] = type.get_param(?s.types, ta.data.fn.params_start + pi);
            val pb: O.Option[type.TypeId] = type.get_param(?s.types, tb.data.fn.params_start + pi);
            if (O.is_none[type.TypeId](pa) || O.is_none[type.TypeId](pb)) { ret false; }
            if (!sse_deep_walk(s, m, O.unwrap[type.TypeId](pa), O.unwrap[type.TypeId](pb), scan)) { ret false; }
            pi = pi + 1;
        }
        ret true;
    }

    val a_nom: bool = ta.kind == type.TYPE_REC || ta.kind == type.TYPE_UNI || ta.kind == type.TYPE_INSTANCE;
    val b_nom: bool = tb.kind == type.TYPE_REC || tb.kind == type.TYPE_UNI || tb.kind == type.TYPE_INSTANCE;
    if (a_nom && b_nom) {
        val mark: type.VisitMark = type.pair_scan_mark(?s.types, ?scan.scan, sa, sb);
        if (mark == type.VISIT_SEEN) { ret true; }
        if (mark == type.VISIT_FAILED) {
            scan.unrecordable = true;
            ret false;
        }

        if (ta.kind == type.TYPE_INSTANCE) { ensure_fields(s, sa); }
        if (tb.kind == type.TYPE_INSTANCE) { ensure_fields(s, sb); }

        if (deep_all_secret(s, sa) && deep_all_secret(s, sb)) { ret true; }

        val tab_a: O.Option[*type.FieldTable] = type.field_table_for(?s.types, sa);
        val tab_b: O.Option[*type.FieldTable] = type.field_table_for(?s.types, sb);
        if (O.is_none[*type.FieldTable](tab_a) || O.is_none[*type.FieldTable](tab_b)) { ret false; }
        val na: u32 = O.unwrap[*type.FieldTable](tab_a).fields_len;
        val nb: u32 = O.unwrap[*type.FieldTable](tab_b).fields_len;

        var common: u32 = na;
        if (nb < common) { common = nb; }
        var f: u32 = 0;
        for (f < common) {
            val fa: O.Option[*type.FieldEntry] = type.field_at(?s.types, sa, f);
            val fb: O.Option[*type.FieldEntry] = type.field_at(?s.types, sb, f);
            if (O.is_none[*type.FieldEntry](fa) || O.is_none[*type.FieldEntry](fb)) { ret false; }
            val ty_a: type.TypeId = O.unwrap[*type.FieldEntry](fa).ty;
            val ty_b: type.TypeId = O.unwrap[*type.FieldEntry](fb).ty;
            if (!sse_deep_walk(s, m, ty_a, ty_b, scan)) { ret false; }

            val ea: layout.Extent = type_extent(s, m, ty_a);
            val eb: layout.Extent = type_extent(s, m, ty_b);
            if (!ea.ok || !eb.ok)                           { ret false; }
            if (ea.size != eb.size || ea.align != eb.align) { ret false; }
            f = f + 1;
        }
        if (na == nb) { ret true; }

        val oa: O.Option[bool] = nominal_overlays(s, sa);
        val ob: O.Option[bool] = nominal_overlays(s, sb);
        if (O.is_none[bool](oa) || O.is_none[bool](ob)) { ret false; }
        if (O.unwrap[bool](oa) || O.unwrap[bool](ob))   { ret false; }
        ret true;
    }

    ret !contains_secret_deep(s, sa) && !contains_secret_deep(s, sb);
}

pub fun deep_all_secret(s: *session.Session, tid: type.TypeId) bool {
    var scan: type.TypeScan;
    type.type_scan_begin(?s.types, ?scan);
    val all: bool = all_secret_walk(s, tid, ?scan);
    type.type_scan_end(?s.types, ?scan);
    ret all;
}

fun all_secret_walk(s: *session.Session, tid: type.TypeId, scan: *type.TypeScan) bool {
    if (type.is_secret(?s.types, tid)) { ret true; }

    val opt_type: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_type)) { ret false; }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);

    if (t.kind == type.TYPE_POINTER) { ret false; }
    if (t.kind == type.TYPE_ARRAY)   { ret all_secret_walk(s, t.data.array.base, scan); }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_INSTANCE) {
        val mark: type.VisitMark = type.type_scan_mark(?s.types, scan, tid);
        if (mark == type.VISIT_SEEN) { ret true; }
        if (mark == type.VISIT_FAILED) { ret false; }

        if (t.kind == type.TYPE_INSTANCE) { ensure_fields(s, tid); }
        val opt_tab: O.Option[*type.FieldTable] = type.field_table_for(?s.types, tid);
        if (O.is_none[*type.FieldTable](opt_tab)) { ret false; }
        val n: u32 = O.unwrap[*type.FieldTable](opt_tab).fields_len;

        var f: u32 = 0;
        for (f < n) {
            val e: O.Option[*type.FieldEntry] = type.field_at(?s.types, tid, f);
            if (O.is_none[*type.FieldEntry](e)) { ret false; }
            if (!all_secret_walk(s, O.unwrap[*type.FieldEntry](e).ty, scan)) { ret false; }
            f = f + 1;
        }
        ret true;
    }

    ret false;
}

rec UniInstScan {
    scan:                type.TypeScan;
    unprovable_reported: bool;
}

pub fun module_reaches_secret(s: *session.Session, resolved: *type.TypeId, len: u32) bool {
    if (resolved == nil) { ret false; }

    var scan: type.TypeScan;
    type.type_scan_begin(?s.types, ?scan);

    var found: bool = false;
    var i:     u32  = 0;
    for (i < len) {
        if (secret_reach_walk(s, resolved[i], ?scan)) {
            found = true;
            brk;
        }
        i = i + 1;
    }

    type.type_scan_end(?s.types, ?scan);
    ret found;
}

fun secret_reach_walk(s: *session.Session, tid: type.TypeId, scan: *type.TypeScan) bool {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }

    val opt_t: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_t)) { ret true; }
    val t: *type.Type    = O.unwrap[*type.Type](opt_t);
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_SECRET) { ret true; }

    if (k == type.TYPE_POINTER) {
        val base: type.TypeId = t.data.pointer.base;
        ret secret_reach_walk(s, base, scan);
    }
    if (k == type.TYPE_ARRAY) {
        val base: type.TypeId = t.data.array.base;
        ret secret_reach_walk(s, base, scan);
    }
    if (k == type.TYPE_FUN) {
        val ret_ty:       type.TypeId = t.data.fn.ret_type;
        val params_start: u32         = t.data.fn.params_start;
        val params_len:   u32         = t.data.fn.params_len;
        if (secret_reach_walk(s, ret_ty, scan)) { ret true; }
        var pi: u32 = 0;
        for (pi < params_len) {
            val p_opt: O.Option[type.TypeId] = type.get_param(?s.types, params_start + pi);
            if (O.is_some[type.TypeId](p_opt) && secret_reach_walk(s, O.unwrap[type.TypeId](p_opt), scan)) { ret true; }
            pi = pi + 1;
        }
        ret false;
    }

    if (k == type.TYPE_INSTANCE) {
        val mark: type.VisitMark = type.type_scan_mark(?s.types, scan, tid);
        if (mark == type.VISIT_SEEN)   { ret false; }
        if (mark == type.VISIT_FAILED) { ret true; }

        val origin:     session.ModuleId = t.data.instance.target_origin;
        val decl_id:    id.DeclId        = t.data.instance.target_decl;
        val args_start: u32              = t.data.instance.args_start;
        val args_len:   u32              = t.data.instance.args_len;

        var i: u32 = 0;
        for (i < args_len) {
            val a_opt: O.Option[type.TypeId] = type.get_param(?s.types, args_start + i);
            if (O.is_some[type.TypeId](a_opt) && secret_reach_walk(s, O.unwrap[type.TypeId](a_opt), scan)) { ret true; }
            i = i + 1;
        }

        val gnom: type.TypeId = generic_nominal_of(s, origin, decl_id);
        if (gnom == type.TYPE_ERROR) { ret true; }
        ret secret_reach_walk(s, gnom, scan);
    }

    if (k == type.TYPE_REC || k == type.TYPE_UNI) {
        val mark: type.VisitMark = type.type_scan_mark(?s.types, scan, tid);
        if (mark == type.VISIT_SEEN)   { ret false; }
        if (mark == type.VISIT_FAILED) { ret true; }

        val opt_tab: O.Option[*type.FieldTable] = type.field_table_for(?s.types, tid);
        if (O.is_none[*type.FieldTable](opt_tab)) { ret true; }
        val fields_len: u32 = O.unwrap[*type.FieldTable](opt_tab).fields_len;

        var f: u32 = 0;
        for (f < fields_len) {
            val e_opt: O.Option[*type.FieldEntry] = type.field_at(?s.types, tid, f);
            if (O.is_some[*type.FieldEntry](e_opt)) {
                val fty: type.TypeId = O.unwrap[*type.FieldEntry](e_opt).ty;
                if (secret_reach_walk(s, fty, scan)) { ret true; }
            }
            f = f + 1;
        }
        ret false;
    }

    if (k == type.TYPE_PACK) { ret false; }

    if (kind_is_public_leaf(k)) { ret false; }
    ret true;
}

pub fun check_annotation_uni_secrecy(sc: *sema.SemaContext, ast_tid: id.TypeId) {
    if (!sc.has_secret)             { ret; }
    if (sc.type_resolved_ty == nil) { ret; }
    if (ast_tid >= sc.a.type_len::u32) { ret; }

    val t_opt: O.Option[*atype.Type] = ast.get_type(sc.a, ast_tid);
    if (O.is_none[*atype.Type](t_opt)) { ret; }

    check_type_uni_secrecy(sc, sc.type_resolved_ty[ast_tid], sc.subst, sc.subst_len,
                           O.unwrap[*atype.Type](t_opt).span);
}

pub fun check_type_uni_secrecy(sc: *sema.SemaContext, tid: type.TypeId, args: *type.TypeId,
                               arg_len: u32, span: token.Span) {
    if (!sc.has_secret) { ret; }
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret; }

    var scan: UniInstScan;
    scan.unprovable_reported = false;
    type.type_scan_begin(?sc.s.types, ?scan.scan);
    uni_inst_walk(sc, tid, args, arg_len, ?scan, span);
    type.type_scan_end(?sc.s.types, ?scan.scan);
}

fun uni_inst_walk(sc: *sema.SemaContext, tid: type.TypeId, args: *type.TypeId, arg_len: u32,
                  scan: *UniInstScan, span: token.Span) {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret; }
    val s: *session.Session = sc.s;

    val opt_t: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_t)) { ret; }
    val t: *type.Type = O.unwrap[*type.Type](opt_t);
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_GENERIC_PARAM) { ret; }

    if (k == type.TYPE_SECRET) {
        val base: type.TypeId = t.data.secret.base;
        uni_inst_walk(sc, base, args, arg_len, scan, span);
        ret;
    }
    if (k == type.TYPE_POINTER) {
        val base: type.TypeId = t.data.pointer.base;
        uni_inst_walk(sc, base, args, arg_len, scan, span);
        ret;
    }
    if (k == type.TYPE_ARRAY) {
        val base: type.TypeId = t.data.array.base;
        uni_inst_walk(sc, base, args, arg_len, scan, span);
        ret;
    }

    if (k == type.TYPE_FUN) {
        val ret_ty:       type.TypeId = t.data.fn.ret_type;
        val params_start: u32         = t.data.fn.params_start;
        val params_len:   u32         = t.data.fn.params_len;
        uni_inst_walk(sc, ret_ty, args, arg_len, scan, span);
        var i: u32 = 0;
        for (i < params_len) {
            val p_opt: O.Option[type.TypeId] = type.get_param(?s.types, params_start + i);
            if (O.is_some[type.TypeId](p_opt)) {
                uni_inst_walk(sc, O.unwrap[type.TypeId](p_opt), args, arg_len, scan, span);
            }
            i = i + 1;
        }
        ret;
    }

    if (k == type.TYPE_INSTANCE) {
        uni_inst_walk_instance(sc, tid, args, arg_len, scan, span);
        ret;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI) {
        uni_inst_walk_nominal(sc, tid, args, arg_len, scan, span);
        ret;
    }
}

fun uni_inst_walk_instance(sc: *sema.SemaContext, tid: type.TypeId, args: *type.TypeId,
                           arg_len: u32, scan: *UniInstScan, span: token.Span) {
    val s: *session.Session = sc.s;

    val opt_t: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_t)) { ret; }
    val t: *type.Type = O.unwrap[*type.Type](opt_t);
    val origin:     session.ModuleId = t.data.instance.target_origin;
    val decl_id:    id.DeclId        = t.data.instance.target_decl;
    val args_start: u32              = t.data.instance.args_start;
    val args_len:   u32              = t.data.instance.args_len;

    if (args_len == 0) { ret; }

    val res_raw: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (R.is_err[*type.TypeId, str](res_raw)) { ret; }
    val raw: *type.TypeId = R.unwrap_ok[*type.TypeId, str](res_raw);

    var i: u32 = 0;
    for (i < args_len) {
        val a_opt: O.Option[type.TypeId] = type.get_param(?s.types, args_start + i);
        if (O.is_none[type.TypeId](a_opt)) {
            A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
            ret;
        }
        raw[i] = O.unwrap[type.TypeId](a_opt);
        i = i + 1;
    }

    i = 0;
    for (i < args_len) {
        uni_inst_walk(sc, raw[i], args, arg_len, scan, span);
        i = i + 1;
    }

    val gnom: type.TypeId = generic_nominal_of(s, origin, decl_id);
    if (gnom == type.TYPE_ERROR) {
        sema.report(sc, span, "internal: #2225 union-secrecy instance walk: generic instance target declaration unavailable (pristine-type invariant violated)");
        A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
        ret;
    }

    val res_conc: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (R.is_err[*type.TypeId, str](res_conc)) {
        A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
        ret;
    }
    val conc: *type.TypeId = R.unwrap_ok[*type.TypeId, str](res_conc);

    i = 0;
    for (i < args_len) {
        conc[i] = subst_or_self(s, raw[i], args, arg_len);
        i = i + 1;
    }

    uni_inst_walk_nominal(sc, gnom, conc, args_len, scan, span);

    A.deallocate[type.TypeId](s.alloc, conc, args_len::usize);
    A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
}

fun uni_inst_walk_nominal(sc: *sema.SemaContext, nom: type.TypeId, args: *type.TypeId,
                          arg_len: u32, scan: *UniInstScan, span: token.Span) {
    val s: *session.Session = sc.s;

    val opt_nom: O.Option[*type.Type] = type.get(?s.types, nom);
    if (O.is_none[*type.Type](opt_nom)) {
        report_unprovable(sc, scan, span);
        ret;
    }
    val nom_kind: type.TypeKind = O.unwrap[*type.Type](opt_nom).kind;
    val opt_tab: O.Option[*type.FieldTable] = type.field_table_for(?s.types, nom);
    if (O.is_none[*type.FieldTable](opt_tab)) {
        report_unprovable(sc, scan, span);
        ret;
    }
    val fields_len: u32 = O.unwrap[*type.FieldTable](opt_tab).fields_len;

    var a: *type.TypeId = args;
    var n: u32          = arg_len;
    val generic: bool   = nominal_has_gparam(s, nom);
    if (!generic) {
        a = nil;
        n = 0;
    }

    val key: type.TypeId = nominal_visit_key(s, nom, a, n);
    val mark: type.VisitMark = type.type_scan_mark(?s.types, ?scan.scan, key);
    if (mark == type.VISIT_SEEN) { ret; }
    if (mark == type.VISIT_FAILED) {
        report_unprovable(sc, scan, span);
        ret;
    }

    if (generic && nom_kind == type.TYPE_UNI) {
        check_uni_variants(sc, nom, a, n, key, scan, span);
    }

    var f: u32 = 0;
    for (f < fields_len) {
        val e_opt: O.Option[*type.FieldEntry] = type.field_at(?s.types, nom, f);
        if (O.is_none[*type.FieldEntry](e_opt)) {
            report_unprovable(sc, scan, span);
            ret;
        }
        val fty: type.TypeId = O.unwrap[*type.FieldEntry](e_opt).ty;
        uni_inst_walk(sc, fty, a, n, scan, span);
        f = f + 1;
    }
}

fun report_unprovable(sc: *sema.SemaContext, scan: *UniInstScan, span: token.Span) {
    if (scan.unprovable_reported) { ret; }
    scan.unprovable_reported = true;
    sema.report(sc, span, "constant-time: cannot prove that every generic union this type reaches has variants agreeing on secrecy - its field layout is unavailable or its type graph is too large");
}

fun check_uni_variants(sc: *sema.SemaContext, nom: type.TypeId, args: *type.TypeId,
                       arg_len: u32, key: type.TypeId, scan: *UniInstScan, span: token.Span) {
    val s: *session.Session = sc.s;

    val opt_tab: O.Option[*type.FieldTable] = type.field_table_for(?s.types, nom);
    if (O.is_none[*type.FieldTable](opt_tab)) {
        report_unprovable(sc, scan, span);
        ret;
    }
    val fields_len: u32 = O.unwrap[*type.FieldTable](opt_tab).fields_len;
    if (fields_len < 2) { ret; }

    val first_opt: O.Option[*type.FieldEntry] = type.field_at(?s.types, nom, 0);
    if (O.is_none[*type.FieldEntry](first_opt)) {
        report_unprovable(sc, scan, span);
        ret;
    }
    val first_raw: type.TypeId = O.unwrap[*type.FieldEntry](first_opt).ty;
    val first:     type.TypeId = subst_or_self(s, first_raw, args, arg_len);
    if (type_mentions_gparam(s, first)) { ret; }

    var i: u32 = 1;
    for (i < fields_len) {
        val e_opt: O.Option[*type.FieldEntry] = type.field_at(?s.types, nom, i);
        if (O.is_none[*type.FieldEntry](e_opt)) {
            report_unprovable(sc, scan, span);
            ret;
        }
        val raw: type.TypeId = O.unwrap[*type.FieldEntry](e_opt).ty;
        val ty:  type.TypeId = subst_or_self(s, raw, args, arg_len);
        if (type_mentions_gparam(s, ty)) { ret; }
        val verdict: SecrecyVerdict = secrecy_structure_equal_deep(s, sema.machine_of(sc), first, ty);
        if (verdict == SECRECY_UNRECORDABLE) {
            report_unprovable(sc, scan, span);
            ret;
        }
        if (verdict == SECRECY_DIFFERS) {
            if (sema.uni_report_mark(sc.uni_reports, key)) {
                sema.report(sc, span, "union variants must agree on secrecy: this instantiation makes overlapping fields part secret `^` and part public, which would alias the same storage at two classifications");
            }
            ret;
        }
        i = i + 1;
    }
}

fun nominal_visit_key(s: *session.Session, nom: type.TypeId, args: *type.TypeId, arg_len: u32) type.TypeId {
    if (args == nil || arg_len == 0) { ret nom; }

    val opt_nom: O.Option[*type.Type] = type.get(?s.types, nom);
    if (O.is_none[*type.Type](opt_nom)) { ret nom; }
    val t: *type.Type = O.unwrap[*type.Type](opt_nom);
    if (t.kind != type.TYPE_REC && t.kind != type.TYPE_UNI) { ret nom; }
    val origin:  session.ModuleId = t.data.nominal.origin;
    val decl_id: id.DeclId        = t.data.nominal.decl;

    val r: R.Result[type.TypeId, str] = type.intern_instance(?s.types, nom, origin, decl_id, args, arg_len);
    if (R.is_err[type.TypeId, str](r)) { ret nom; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

fun subst_or_self(s: *session.Session, tid: type.TypeId, args: *type.TypeId, arg_len: u32) type.TypeId {
    if (args == nil || arg_len == 0) { ret tid; }
    ret substitute(s, tid, args, arg_len);
}

fun type_mentions_gparam(s: *session.Session, tid: type.TypeId) bool {
    var w: GParamWalk;
    gparam_walk_begin(s, ?w);
    val mentioned: bool = mentions_gparam(s, tid, ?w);
    gparam_walk_end(s, ?w);
    ret mentioned;
}

pub fun generic_nominal_of(s: *session.Session, origin: session.ModuleId, gdecl: id.DeclId) type.TypeId {
    val ga: *ast.Ast = session.module_ast(s, origin);
    if (ga == nil) { ret type.TYPE_ERROR; }

    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(ga, gdecl);
    if (O.is_none[*decl.Decl](opt_decl)) { ret type.TYPE_ERROR; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);

    var gname: intern.StrId  = intern.STR_NIL;
    var gkind: type.TypeKind = type.TYPE_REC;
    if (d.kind == decl.DECL_KIND_REC) {
        gname = intern_name_in(s, ga, d.data.rec_.name);
        gkind = type.TYPE_REC;
    }
    or (d.kind == decl.DECL_KIND_UNI) {
        gname = intern_name_in(s, ga, d.data.uni_.name);
        gkind = type.TYPE_UNI;
    }
    or {
        ret type.TYPE_ERROR;
    }

    val res_nominal: R.Result[type.TypeId, str] = type.intern_nominal(?s.types, gname, origin, gdecl, gkind);
    if (R.is_err[type.TypeId, str](res_nominal)) { ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](res_nominal);
}

fun build_instance_table(s: *session.Session, instance: type.TypeId, gnom: type.TypeId) {
    val opt_instance_table: O.Option[*type.FieldTable] = type.field_table_for(?s.types, instance);
    if (O.is_some[*type.FieldTable](opt_instance_table)) {
        if (O.unwrap[*type.FieldTable](opt_instance_table).epoch == type.field_epoch(?s.types)) { ret; }
    }

    val opt_generic_table: O.Option[*type.FieldTable] = type.field_table_for(?s.types, gnom);
    if (O.is_none[*type.FieldTable](opt_generic_table)) { ret; }
    val fields_len: u32 = O.unwrap[*type.FieldTable](opt_generic_table).fields_len;

    val opt_instance: O.Option[*type.Type] = type.get(?s.types, instance);
    if (O.is_none[*type.Type](opt_instance)) { ret; }
    val instance_type: *type.Type = O.unwrap[*type.Type](opt_instance);
    if (instance_type.kind != type.TYPE_INSTANCE) { ret; }
    val args_start: u32 = instance_type.data.instance.args_start;
    val args_len:   u32 = instance_type.data.instance.args_len;

    var args: *type.TypeId = nil;
    if (args_len > 0) {
        val res_alloc_args: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](s.alloc, args_len::usize);
        if (R.is_err[*type.TypeId, str](res_alloc_args)) { ret; }
        args = R.unwrap_ok[*type.TypeId, str](res_alloc_args);

        var i: u32 = 0;
        for (i < args_len) {
            val opt_arg: O.Option[type.TypeId] = type.get_param(?s.types, args_start + i);
            if (O.is_none[type.TypeId](opt_arg)) {
                A.deallocate[type.TypeId](s.alloc, args, args_len::usize);
                ret;
            }
            args[i] = O.unwrap[type.TypeId](opt_arg);
            i = i + 1;
        }
    }

    if (fields_len == 0) {
        val start_r: R.Result[u32, str] = type.field_table_stage(?s.types, 0);
        if (R.is_ok[u32, str](start_r)) {
            type.field_table_publish(?s.types, instance, R.unwrap_ok[u32, str](start_r), 0);
        }
        if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
        ret;
    }

    val res_alloc_types: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](s.alloc, fields_len::usize);
    if (R.is_err[*type.TypeId, str](res_alloc_types)) {
        if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
        ret;
    }
    val field_types: *type.TypeId = R.unwrap_ok[*type.TypeId, str](res_alloc_types);

    val res_alloc_names: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](s.alloc, fields_len::usize);
    if (R.is_err[*intern.StrId, str](res_alloc_names)) {
        A.deallocate[type.TypeId](s.alloc, field_types, fields_len::usize);
        if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
        ret;
    }
    val field_names: *intern.StrId = R.unwrap_ok[*intern.StrId, str](res_alloc_names);

    var i: u32 = 0;
    for (i < fields_len) {
        val opt_entry: O.Option[*type.FieldEntry] = type.field_at(?s.types, gnom, i);
        if (O.is_none[*type.FieldEntry](opt_entry)) {
            field_names[i] = intern.STR_NIL;
            field_types[i] = type.TYPE_ERROR;
        }
        or {
            val entry: *type.FieldEntry = O.unwrap[*type.FieldEntry](opt_entry);
            field_names[i] = entry.name;
            field_types[i] = substitute(s, entry.ty, args, args_len);
        }
        i = i + 1;
    }

    val start_r: R.Result[u32, str] = type.field_table_stage(?s.types, fields_len);
    if (R.is_ok[u32, str](start_r)) {
        val start: u32 = R.unwrap_ok[u32, str](start_r);
        var staged: bool = true;
        i = 0;
        for (i < fields_len) {
            if (R.is_err[R.Void, str](type.field_table_stage_push(?s.types, field_names[i], field_types[i]))) {
                staged = false;
                brk;
            }
            i = i + 1;
        }
        if (staged) { type.field_table_publish(?s.types, instance, start, fields_len); }
    }

    A.deallocate[intern.StrId](s.alloc, field_names, fields_len::usize);
    A.deallocate[type.TypeId](s.alloc, field_types, fields_len::usize);
    if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
}

fun substitute_fun(s: *session.Session, t: *type.Type, args: *type.TypeId, arg_count: u32, original: type.TypeId) type.TypeId {
    val original_ret: type.TypeId = t.data.fn.ret_type;
    val params_start: u32         = t.data.fn.params_start;
    val params_len:   u32         = t.data.fn.params_len;

    var changed:   bool         = false;
    var param_buf: *type.TypeId = nil;
    if (params_len > 0) {
        val res_alloc_params: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](s.alloc, params_len::usize);
        if (R.is_err[*type.TypeId, str](res_alloc_params)) { ret type.TYPE_ERROR; }
        param_buf = R.unwrap_ok[*type.TypeId, str](res_alloc_params);

        var i: u32 = 0;
        for (i < params_len) {
            val opt_param: O.Option[type.TypeId] = type.get_param(?s.types, params_start + i);
            if (O.is_none[type.TypeId](opt_param)) {
                A.deallocate[type.TypeId](s.alloc, param_buf, params_len::usize);
                ret type.TYPE_ERROR;
            }
            val original_param: type.TypeId = O.unwrap[type.TypeId](opt_param);
            param_buf[i] = substitute(s, original_param, args, arg_count);
            if (param_buf[i] != original_param) { changed = true; }
            i = i + 1;
        }
    }

    val new_ret: type.TypeId = substitute(s, original_ret, args, arg_count);
    if (new_ret != original_ret) { changed = true; }

    if (!changed) {
        if (params_len > 0) { A.deallocate[type.TypeId](s.alloc, param_buf, params_len::usize); }
        ret original;
    }

    val res_fun: R.Result[type.TypeId, str] = type.intern_function(?s.types, new_ret, param_buf, params_len, t.data.fn.c_variadic);
    if (params_len > 0) { A.deallocate[type.TypeId](s.alloc, param_buf, params_len::usize); }
    ret unwrap_or_error(res_fun);
}

fun substitute_instance(s: *session.Session, t: *type.Type, args: *type.TypeId, arg_count: u32, original: type.TypeId) type.TypeId {
    val nominal:    type.TypeId      = t.data.instance.nominal;
    val origin:     session.ModuleId = t.data.instance.target_origin;
    val decl_id:    id.DeclId        = t.data.instance.target_decl;
    val args_start: u32              = t.data.instance.args_start;
    val args_len:   u32              = t.data.instance.args_len;

    if (args_len == 0) { ret original; }

    val res_alloc_args: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (R.is_err[*type.TypeId, str](res_alloc_args)) { ret type.TYPE_ERROR; }
    val arg_buf: *type.TypeId = R.unwrap_ok[*type.TypeId, str](res_alloc_args);

    var changed: bool = false;
    var i:       u32  = 0;
    for (i < args_len) {
        val opt_arg: O.Option[type.TypeId] = type.get_param(?s.types, args_start + i);
        if (O.is_none[type.TypeId](opt_arg)) {
            A.deallocate[type.TypeId](s.alloc, arg_buf, args_len::usize);
            ret type.TYPE_ERROR;
        }
        val original_arg: type.TypeId = O.unwrap[type.TypeId](opt_arg);
        arg_buf[i] = substitute(s, original_arg, args, arg_count);
        if (arg_buf[i] != original_arg) { changed = true; }
        i = i + 1;
    }

    if (!changed) {
        A.deallocate[type.TypeId](s.alloc, arg_buf, args_len::usize);
        ret original;
    }

    val res_instance: R.Result[type.TypeId, str] = type.intern_instance(?s.types, nominal, origin, decl_id, arg_buf, args_len);
    A.deallocate[type.TypeId](s.alloc, arg_buf, args_len::usize);
    ret unwrap_or_error(res_instance);
}

fun substitute_aggregate(s: *session.Session, t: *type.Type, args: *type.TypeId, arg_count: u32, original: type.TypeId) type.TypeId {
    val origin:  session.ModuleId = t.data.nominal.origin;
    val decl_id: id.DeclId        = t.data.nominal.decl;

    val res_instance: R.Result[type.TypeId, str] = type.intern_instance(?s.types, original, origin, decl_id, args, arg_count);
    if (R.is_err[type.TypeId, str](res_instance)) { ret type.TYPE_ERROR; }
    val instance: type.TypeId = R.unwrap_ok[type.TypeId, str](res_instance);

    build_instance_table(s, instance, original);
    ret instance;
}

fun nominal_has_gparam(s: *session.Session, tid: type.TypeId) bool {
    val memo: type.GParamMemo = type.gparam_memo_get(?s.types, tid);
    if (memo == type.GPARAM_YES) { ret true; }
    if (memo == type.GPARAM_NO)  { ret false; }

    var w: GParamWalk;
    gparam_walk_begin(s, ?w);
    val mentioned: bool = nominal_fields_mention(s, tid, ?w);
    val resolved:  bool = w.resolved;
    gparam_walk_end(s, ?w);

    if (resolved) { type.gparam_memo_set(?s.types, tid, mentioned); }
    ret mentioned;
}

fun nominal_fields_mention(s: *session.Session, tid: type.TypeId, w: *GParamWalk) bool {
    val mark: type.VisitMark = type.type_scan_mark(?s.types, ?w.scan, tid);
    if (mark == type.VISIT_SEEN)   { ret false; }
    if (mark == type.VISIT_FAILED) {
        w.resolved = false;
        ret true;
    }

    val opt_table: O.Option[*type.FieldTable] = type.field_table_for(?s.types, tid);
    if (O.is_none[*type.FieldTable](opt_table)) {
        w.resolved = false;
        ret true;
    }
    val fields_len: u32 = O.unwrap[*type.FieldTable](opt_table).fields_len;

    var i: u32 = 0;
    for (i < fields_len) {
        val opt_entry: O.Option[*type.FieldEntry] = type.field_at(?s.types, tid, i);
        if (O.is_some[*type.FieldEntry](opt_entry)) {
            if (mentions_gparam(s, O.unwrap[*type.FieldEntry](opt_entry).ty, w)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun mentions_gparam(s: *session.Session, tid: type.TypeId, w: *GParamWalk) bool {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }

    val opt_type: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_type)) { ret false; }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);

    if (t.kind == type.TYPE_GENERIC_PARAM) { ret true; }
    if (t.kind == type.TYPE_POINTER)       { ret mentions_gparam(s, t.data.pointer.base, w); }
    if (t.kind == type.TYPE_SECRET)        { ret mentions_gparam(s, t.data.secret.base, w); }
    if (t.kind == type.TYPE_ARRAY)         { ret mentions_gparam(s, t.data.array.base, w); }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI) {
        ret nominal_fields_mention(s, tid, w);
    }

    if (t.kind == type.TYPE_FUN) {
        val ret_ty:       type.TypeId = t.data.fn.ret_type;
        val params_start: u32         = t.data.fn.params_start;
        val params_len:   u32         = t.data.fn.params_len;
        if (mentions_gparam(s, ret_ty, w)) { ret true; }
        var i: u32 = 0;
        for (i < params_len) {
            val p_opt: O.Option[type.TypeId] = type.get_param(?s.types, params_start + i);
            if (O.is_some[type.TypeId](p_opt) && mentions_gparam(s, O.unwrap[type.TypeId](p_opt), w)) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    if (t.kind == type.TYPE_INSTANCE) {
        val args_start: u32 = t.data.instance.args_start;
        val args_len:   u32 = t.data.instance.args_len;
        var i: u32 = 0;
        for (i < args_len) {
            val opt_arg: O.Option[type.TypeId] = type.get_param(?s.types, args_start + i);
            if (O.is_some[type.TypeId](opt_arg)) {
                if (mentions_gparam(s, O.unwrap[type.TypeId](opt_arg), w)) { ret true; }
            }
            i = i + 1;
        }
    }
    ret false;
}

fun intern_name_in(s: *session.Session, ga: *ast.Ast, span: token.Span) intern.StrId {
    val opt_source: O.Option[*source.SourceFile] = source.get(?s.sources, ga.file_id);
    if (O.is_none[*source.SourceFile](opt_source)) { ret intern.STR_NIL; }
    val text: str = O.unwrap[*source.SourceFile](opt_source).text;

    val res_intern: R.Result[intern.StrId, str] = intern.intern_span(?s.interner, text, span);
    if (R.is_err[intern.StrId, str](res_intern)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](res_intern);
}

fun generic_count_in(a: *ast.Ast, decl_id: id.DeclId) O.Option[u32] {
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(a, decl_id);
    if (O.is_none[*decl.Decl](opt_decl)) { ret O.none[u32](); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);

    if (d.kind == decl.DECL_KIND_FUN) { ret O.some[u32](d.data.fun_.generics_len); }
    if (d.kind == decl.DECL_KIND_REC) { ret O.some[u32](d.data.rec_.generics_len); }
    if (d.kind == decl.DECL_KIND_UNI) { ret O.some[u32](d.data.uni_.generics_len); }
    ret O.none[u32]();
}

fun unwrap_or_error(res: R.Result[type.TypeId, str]) type.TypeId {
    if (R.is_err[type.TypeId, str](res)) { ret type.TYPE_ERROR; }
    ret R.unwrap_ok[type.TypeId, str](res);
}

fun report_type_arg_count(sc: *sema.SemaContext, span: token.Span, prefix: str, expected: u32, actual: u32) {
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}: expected {}, found {}", prefix, expected::usize, actual::usize);
    if (R.is_err[str, str](res_msg)) {
        sema.report(sc, span, prefix);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    sema.report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

test "mach.lang.fe.sema.generics.contains_secret_deep:unresolvable_type_fails_closed" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var sA: session.Session = R.unwrap_ok[session.Session, str](sr);

    val bogus: type.TypeId = 500000::type.TypeId;

    var bad: i32 = 0;
    if (!contains_secret_deep(?sA, bogus)) { bad = 1; }

    session.dnit(?sA);
    ret bad;
}

