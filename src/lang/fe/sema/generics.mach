# the instantiation of a generic the sema context names, and the checks each instance owes
# its type annotations
use diagnostic_kind: mach.lang.diagnostic.kind;
use std_format:      std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.fail;
use ast_id: mach.lang.fe.ast.id;
use mach.lang.fe.resolve;
use sema_context: mach.lang.fe.sema.context;
use mach.lang.fe.sema.handle;
use mach.lang.fe.sema.variant;
use lang_source: mach.lang.source;
use mach.lang.type;

pub fun instantiate(
    sc: *sema_context.SemaContext,
    sym: *resolve.Symbol,
    args: *type.TypeId,
    arg_count: u32,
    span: lang_source.Span) res[type.TypeId, fail.Fail] {
    if (sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema_context.report(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "not a generic: declaration is not generic");
        ret res[type.TypeId, fail.Fail].ok{type.TYPE_ERROR};
    }

    if (!check_arity(sc, sym, arg_count, span)) {
        ret res[type.TypeId, fail.Fail].ok{type.TYPE_ERROR};
    }

    var i: u32 = 0;
    for (i < arg_count) {
        if (type.is_nil(args[i]) || type.is_error(args[i])) {
            sema_context.report_numbered(sc, diagnostic_kind.GENERIC_ARGUMENT, span, "generic argument ", (i + 1)::usize, " is not a valid type", "generic argument is not a valid type");
            ret res[type.TypeId, fail.Fail].ok{type.TYPE_ERROR};
        }
        i = i + 1;
    }

    val gnom: type.TypeId = nominal_of(sc, sym);
    if (sel sc.status.kind.internal) { ret res[type.TypeId, fail.Fail].err{fail.message(sc.status.kind.internal)}; }
    ret type.intern_instance(?sc.s.types, gnom, args, arg_count);
}

pub fun check_arity(
    sc: *sema_context.SemaContext,
    sym: *resolve.Symbol,
    arg_count: u32,
    span: lang_source.Span) bool {
    if (sym.definition_kind != resolve.SYM_FUN && sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema_context.report(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "not a generic: declaration takes no type parameters");
        ret false;
    }
    val want: u32 = sym.generic_arity;
    if (arg_count != want) {
        report_type_arg_count(sc, span, "wrong number of type arguments", want, arg_count);
        ret false;
    }
    ret true;
}

# the checks an instance owes each type annotation it resolves, which no check of the
# generic declaration can answer before its parameters are known
pub fun check_annotation(sc: *sema_context.SemaContext, ast_tid: ast_id.TypeId) {
    variant.check_annotation_uni_secrecy(sc, ast_tid);
    handle.check_annotation_handles(sc, ast_tid);
}

fun nominal_of(sc: *sema_context.SemaContext, sym: *resolve.Symbol) type.TypeId {
    var kind: type.TypeKind = type.TYPE_REC;
    if (sym.definition_kind == resolve.SYM_UNI) { kind = type.TYPE_UNI; }
    if (sym.definition_kind == resolve.SYM_TAG) { kind = type.TYPE_TAG; }
    if (lang_source.file_is_nil(sym.definition_file)) {
        fail.internal(?sc.status, "generic nominal has no defining source identity");
        ret type.TYPE_ERROR;
    }
    val nominal: res[type.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, sym.canon,
        resolve.type_owner(sc.s, sym.origin, sym.definition_file), kind);
    if (sel nominal.err) {
        fail.internal(?sc.status, fail.describe(nominal.err));
        ret type.TYPE_ERROR;
    }
    ret nominal.ok;
}

fun report_type_arg_count(sc: *sema_context.SemaContext, span: lang_source.Span, prefix: str, expected: u32, actual: u32) {
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{}: expected {}, found {}", prefix, expected::usize, actual::usize);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        ret;
    }
    val msg: str = res_msg.ok;
    sema_context.report(sc, diagnostic_kind.GENERIC_ARITY, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}
