rec GParamWalk {
    scan:     type.TypeScan;
    resolved: bool;
    # the declaration owning the first parameter the walk met
    owner: type.GenericOwner;
    owned: bool;
}

fun gparam_walk_begin(g: *GenericOp, w: *GParamWalk) {
    val s: *session.Session = g.s;
    w.resolved = false;
    w.owned    = false;
    val scan_r: err[fail.Fail] = type.type_scan_begin(?s.types, ?w.scan);
    if (sel scan_r.err) {
        fail.internal(g.status, fail.describe(scan_r.err));
        ret;
    }
    w.resolved = true;
}

fun gparam_walk_end(g: *GenericOp, w: *GParamWalk) {
    val s: *session.Session = g.s;
    type.type_scan_end(?s.types, ?w.scan);
}

pub fun instantiate(
    sc: *sema.SemaContext,
    sym: *resolve.Symbol,
    args: *type.TypeId,
    arg_count: u32,
    span: token.Span) res[type.TypeId, fail.Fail] {
    var op: GenericOp;
    op.s      = sc.s;
    op.status = ?sc.status;
    val g: *GenericOp = ?op;
    if (sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema.report(sc, dkind.GENERIC_NOT_GENERIC, span, "not a generic: declaration is not generic");
        ret res[type.TypeId, fail.Fail].ok{type.TYPE_ERROR};
    }

    if (!check_arity(sc, sym, arg_count, span)) {
        ret res[type.TypeId, fail.Fail].ok{type.TYPE_ERROR};
    }

    var i: u32 = 0;
    for (i < arg_count) {
        if (args[i] == type.TYPE_NIL || args[i] == type.TYPE_ERROR) {
            sema.report_numbered(sc, dkind.GENERIC_ARGUMENT, span, "generic argument ", (i + 1)::usize, " is not a valid type", "generic argument is not a valid type");
            ret res[type.TypeId, fail.Fail].ok{type.TYPE_ERROR};
        }
        i = i + 1;
    }

    val gnom: type.TypeId = generic_nominal_of_inner(sc, sym);
    if (sel sc.status.kind.internal) { ret res[type.TypeId, fail.Fail].err{fail.message(sc.status.kind.internal)}; }
    ret type.intern_instance(?sc.s.types, gnom, args, arg_count);
}

pub fun check_arity(
    sc: *sema.SemaContext,
    sym: *resolve.Symbol,
    arg_count: u32,
    span: token.Span) bool {
    if (sym.definition_kind != resolve.SYM_FUN && sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema.report(sc, dkind.GENERIC_NOT_GENERIC, span, "not a generic: declaration takes no type parameters");
        ret false;
    }
    val want: u32 = sym.generic_arity;
    if (arg_count != want) {
        report_type_arg_count(sc, span, "wrong number of type arguments", want, arg_count);
        ret false;
    }
    ret true;
}

fun substitute_inner(g: *GenericOp, body_type: type.TypeId, who: *type.GenericOwner, args: *type.TypeId, arg_count: u32) type.TypeId {
    val s: *session.Session = g.s;
    if (body_type == type.TYPE_NIL || body_type == type.TYPE_ERROR) { ret body_type; }

    val opt_type: opt[*type.Type] = type.get(?s.types, body_type);
    if (!sel opt_type.some) { ret body_type; }
    val t: *type.Type = opt_type.some;

    if (t.kind == type.TYPE_GENERIC_PARAM) {
        if (!type.param_owned_by(?t.data.generic_param, who)) { ret body_type; }
        val index: u32 = t.data.generic_param.index;
        if (index < arg_count) { ret args[index]; }
        ret type.TYPE_ERROR;
    }

    if (t.kind == type.TYPE_POINTER) {
        val original_base: type.TypeId = t.data.pointer.base;
        val base:          type.TypeId = substitute_inner(g, original_base, who, args, arg_count);
        if (base == original_base) { ret body_type; }
        ret unwrap_or_error(g, type.intern_pointer(?s.types, base));
    }

    if (t.kind == type.TYPE_ARRAY) {
        val original_base: type.TypeId = t.data.array.base;
        val count:         u32         = t.data.array.count;
        val base:          type.TypeId = substitute_inner(g, original_base, who, args, arg_count);
        if (base == original_base) { ret body_type; }
        ret unwrap_or_error(g, type.intern_array(?s.types, base, count));
    }

    if (t.kind == type.TYPE_SECRET) {
        val original_base: type.TypeId = t.data.secret.base;
        val base:          type.TypeId = substitute_inner(g, original_base, who, args, arg_count);
        if (base == original_base) { ret body_type; }
        ret unwrap_or_error(g, type.intern_secret(?s.types, base));
    }

    if (t.kind == type.TYPE_FUN)      { ret substitute_fun(g, t, who, args, arg_count, body_type); }
    if (t.kind == type.TYPE_INSTANCE) { ret substitute_instance(g, t, who, args, arg_count, body_type); }

    # a bare nominal mentioning parameters is an anonymous aggregate declared
    # inside a generic (a named generic is spelled with its arguments or refused):
    # its parameters are the enclosing declaration's, so it is instantiated
    # with `who`'s arguments exactly when `who` is that declaration
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        if (!nominal_has_gparam(g, body_type)) { ret body_type; }
        val of: opt[type.GenericOwner] = nominal_param_owner(g, body_type);
        if (!sel of.some) { ret body_type; }
        var owner: type.GenericOwner = of.some;
        if (!type.generic_owner_equals(?owner, who)) { ret body_type; }
        ret substitute_aggregate(g, args, arg_count, body_type);
    }

    if (t.kind == type.TYPE_CASE_SELECTOR) {
        val original_tag: type.TypeId = t.data.case_selector.tag_type;
        val new_tag:      type.TypeId = substitute_inner(g, original_tag, who, args, arg_count);
        if (new_tag == original_tag) { ret body_type; }
        ret unwrap_or_error(g, type.intern_case_selector(?s.types, new_tag, t.data.case_selector.case_name, t.data.case_selector.case_index));
    }
    ret body_type;
}

fun ensure_fields_inner(g: *GenericOp, tid: type.TypeId) {
    val s:            *session.Session      = g.s;
    val opt_existing: opt[*type.FieldTable] = type.field_table_for(?s.types, tid);
    if (sel opt_existing.some) {
        if (opt_existing.some.epoch == type.field_epoch(?s.types)) { ret; }
    }

    val opt_type: opt[*type.Type] = type.get(?s.types, tid);
    if (!sel opt_type.some) { ret; }
    val t: *type.Type = opt_type.some;
    if (t.kind != type.TYPE_INSTANCE) { ret; }

    val gnom: type.TypeId = t.data.instance.nominal;
    if (gnom == type.TYPE_ERROR) { ret; }

    build_instance_table(g, tid, gnom);
}

# the kinds that carry no secret of their own; false for every other kind,
# which the walk descends (a partition, enumerated by its test)
fun kind_is_public_leaf(k: type.TypeKind) bool {
    val pc: type.PrimClass = type.prim_desc(k).class;
    if (pc == type.PRIM_CLASS_INT || pc == type.PRIM_CLASS_FLOAT || pc == type.PRIM_CLASS_PTR) { ret true; }
    if (k == type.TYPE_VECTOR)                                                                 { ret true; }
    if (k == type.TYPE_HANDLE)                                                                 { ret true; }
    if (k == type.TYPE_ABI)                                                                    { ret true; }
    if (k == type.TYPE_GENERIC_PARAM)                                                          { ret true; }
    ret false;
}

fun contains_secret_deep_inner(g: *GenericOp, tid: type.TypeId) bool {
    ret deep_query(g, DEEP_SECRET, tid);
}

fun contains_float_deep_inner(g: *GenericOp, tid: type.TypeId) bool {
    ret deep_query(g, DEEP_FLOAT, tid);
}

# what a deep query looks for anywhere a type reaches, through pointers included
def DeepProp: u8;

val DEEP_SECRET: DeepProp = 0;
val DEEP_FLOAT:  DeepProp = 1;

val DEEP_NONE: u32 = 0xFFFFFFFF;

# one nominal's answer over the declaration graph, never the instance graph: a
# generic reached through a pointer can mint a fresh instance at every level
# (`rec L[T] { next: *L[*T]; }`), so the instances are unbounded but the
# declarations are not. `found` is the property reached by the fields on their
# own, and `reach` lists the owner's parameters the fields reach, so an instance
# answers `found`, or any reached parameter's argument answering
rec DeepEntry {
    nominal: type.TypeId;
    found:   bool;
    owned:   bool;
    owner:   type.GenericOwner;
    reach:   u32;
}

rec DeepReach {
    param: u32;
    next:  u32;
}

rec DeepQuery {
    g:       *GenericOp;
    prop:    DeepProp;
    index:   map.Map[type.TypeId, u32];
    entries: Vector[DeepEntry];
    reach:   Vector[DeepReach];
    # a pass changed an answer or met a new nominal, so another pass is owed
    grew: bool;
}

# the summaries are a least fixpoint: every answer starts false and only turns
# true, so passes repeat until one changes nothing, and the root's answer from
# that pass is final
fun deep_query(g: *GenericOp, prop: DeepProp, tid: type.TypeId) bool {
    val s: *session.Session = g.s;
    var q: DeepQuery;
    q.g       = g;
    q.prop    = prop;
    q.index   = map.init[type.TypeId, u32](s.types.a);
    q.entries = vector.init[DeepEntry](s.types.a);
    q.reach   = vector.init[DeepReach](s.types.a);
    q.grew    = false;

    var found: bool                = true;
    val room:  res[usize, A.Error] = vector.reserve[DeepEntry](?q.entries, 8);
    if (sel room.err) { fail.internal(g.status, alloc.text(room.err)); }
    or {
        for (true) {
            q.grew = false;
            if (deep_eval(?q, tid, DEEP_NONE)) { brk; }
            var i: usize = 0;
            for (i < q.entries.len) {
                deep_settle(?q, i::u32);
                i = i + 1;
            }
            if (sel g.status.kind.internal) { brk; }
            if (!q.grew) {
                found = false;
                brk;
            }
        }
    }

    map.dnit[type.TypeId, u32](?q.index);
    vector.dnit[DeepEntry](?q.entries);
    vector.dnit[DeepReach](?q.reach);
    ret found;
}

# the summary slot of `nominal`, opened on first sight; DEEP_NONE when out of memory
fun deep_entry(q: *DeepQuery, nominal: type.TypeId) u32 {
    val s:    *session.Session = q.g.s;
    val have: opt[*u32]        = map.get[type.TypeId, u32](?q.index, ?nominal);
    if (sel have.some) { ret @have.some; }

    var e: DeepEntry;
    e.nominal = nominal;
    e.found   = false;
    e.owned   = false;
    e.reach   = DEEP_NONE;
    # a nominal with no field table cannot be shown clear
    val table: opt[*type.FieldTable] = type.field_table_for(?s.types, nominal);
    if (!sel table.some) { e.found = true; }
    or {
        val of: opt[type.GenericOwner] = nominal_param_owner(q.g, nominal);
        if (sel of.some) {
            e.owned = true;
            e.owner = of.some;
        }
    }
    if (sel q.g.status.kind.internal) { ret DEEP_NONE; }

    val ix:     u32                 = q.entries.len::u32;
    val pushed: res[usize, A.Error] = vector.push[DeepEntry](?q.entries, e);
    if (sel pushed.err) {
        fail.internal(q.g.status, alloc.text(pushed.err));
        ret DEEP_NONE;
    }
    val indexed: res[bool, A.Error] = map.insert[type.TypeId, u32](?q.index, nominal, ix);
    if (sel indexed.err) {
        fail.internal(q.g.status, alloc.text(indexed.err));
        ret DEEP_NONE;
    }
    q.grew = true;
    ret ix;
}

fun deep_reaches(q: *DeepQuery, ix: u32, param: u32) bool {
    var r: u32 = q.entries.data[ix].reach;
    for (r != DEEP_NONE) {
        if (q.reach.data[r].param == param) { ret true; }
        r = q.reach.data[r].next;
    }
    ret false;
}

fun deep_add_reach(q: *DeepQuery, ix: u32, param: u32) {
    if (deep_reaches(q, ix, param)) { ret; }
    var link: DeepReach;
    link.param = param;
    link.next  = q.entries.data[ix].reach;
    val at:     u32                 = q.reach.len::u32;
    val pushed: res[usize, A.Error] = vector.push[DeepReach](?q.reach, link);
    if (sel pushed.err) {
        fail.internal(q.g.status, alloc.text(pushed.err));
        ret;
    }
    q.entries.data[ix].reach = at;
    q.grew                   = true;
}

fun deep_settle(q: *DeepQuery, ix: u32) {
    val s: *session.Session = q.g.s;
    if (q.entries.data[ix].found) { ret; }
    val nominal: type.TypeId           = q.entries.data[ix].nominal;
    val table:   opt[*type.FieldTable] = type.field_table_for(?s.types, nominal);
    if (!sel table.some) { ret; }
    val fields_len: u32 = table.some.fields_len;

    var f: u32 = 0;
    for (f < fields_len) {
        val entry: opt[*type.FieldEntry] = type.field_at(?s.types, nominal, f);
        if (sel entry.some && deep_eval(q, entry.some.ty, ix)) {
            q.entries.data[ix].found = true;
            q.grew                   = true;
            ret;
        }
        f = f + 1;
    }
}

# whether `tid` reaches the property under the current summaries; inside the
# fields of entry `ctx`, a parameter of its owner is recorded as reached instead
fun deep_eval(q: *DeepQuery, tid: type.TypeId, ctx: u32) bool {
    val s: *session.Session = q.g.s;
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }
    if (sel q.g.status.kind.internal)                   { ret true; }

    val opt_type: opt[*type.Type] = type.get(?s.types, tid);
    if (!sel opt_type.some) { ret true; }
    val t: *type.Type = opt_type.some;

    if (q.prop == DEEP_SECRET) {
        if (t.kind == type.TYPE_SECRET) { ret true; }
    }
    or {
        if (type.prim_desc(t.kind).class == type.PRIM_CLASS_FLOAT) { ret true; }
        if (t.kind == type.TYPE_SECRET)                            { ret deep_eval(q, t.data.secret.base, ctx); }
        if (t.kind == type.TYPE_VECTOR)                            { ret type.prim_desc(t.data.vector.element).class == type.PRIM_CLASS_FLOAT; }
    }
    if (t.kind == type.TYPE_POINTER) { ret deep_eval(q, t.data.pointer.base, ctx); }
    if (t.kind == type.TYPE_ARRAY)   { ret deep_eval(q, t.data.array.base, ctx); }

    if (t.kind == type.TYPE_FUN) {
        if (deep_eval(q, t.data.fn.ret_type, ctx)) { ret true; }
        var pi: u32 = 0;
        for (pi < t.data.fn.params_len) {
            val pp: opt[type.TypeId] = type.get_param(?s.types, t.data.fn.params_start + pi);
            if (sel pp.some && deep_eval(q, pp.some, ctx)) { ret true; }
            pi = pi + 1;
        }
        ret false;
    }

    if (t.kind == type.TYPE_GENERIC_PARAM) {
        if (ctx != DEEP_NONE && q.entries.data[ctx].owned
            && type.param_owned_by(?t.data.generic_param, ?q.entries.data[ctx].owner)) {
            deep_add_reach(q, ctx, t.data.generic_param.index);
        }
        ret false;
    }

    if (t.kind == type.TYPE_INSTANCE) {
        val ix: u32 = deep_entry(q, t.data.instance.nominal);
        if (ix == DEEP_NONE)          { ret true; }
        if (q.entries.data[ix].found) { ret true; }
        val args_start: u32 = t.data.instance.args_start;
        val args_len:   u32 = t.data.instance.args_len;
        var r:          u32 = q.entries.data[ix].reach;
        for (r != DEEP_NONE) {
            val param: u32 = q.reach.data[r].param;
            r = q.reach.data[r].next;
            if (param < args_len) {
                val arg: opt[type.TypeId] = type.get_param(?s.types, args_start + param);
                if (!sel arg.some)               { ret true; }
                if (deep_eval(q, arg.some, ctx)) { ret true; }
            }
        }
        ret false;
    }

    # a bare nominal mentioning parameters is an anonymous aggregate inside a
    # generic: its parameters are the enclosing declaration's, so what it
    # reaches is reached by the fields that hold it, under that same owner
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        val ix: u32 = deep_entry(q, tid);
        if (ix == DEEP_NONE)          { ret true; }
        if (q.entries.data[ix].found) { ret true; }
        if (ctx != DEEP_NONE && q.entries.data[ix].owned && q.entries.data[ctx].owned
            && type.generic_owner_equals(?q.entries.data[ix].owner, ?q.entries.data[ctx].owner)) {
            var r: u32 = q.entries.data[ix].reach;
            for (r != DEEP_NONE) {
                val param: u32 = q.reach.data[r].param;
                r = q.reach.data[r].next;
                deep_add_reach(q, ctx, param);
            }
        }
        ret false;
    }

    if (kind_is_public_leaf(t.kind)) { ret false; }
    ret true;
}

fun describe_type(g: *GenericOp, id: u32) layout.Node {
    val s: *session.Session = g.s;
    if (id == type.TYPE_NIL::u32) { ret layout.node(layout.NODE_ZERO); }
    val base: type.TypeId = type.strip_secret(?s.types, id::type.TypeId);

    val opt_type: opt[*type.Type] = type.get(?s.types, base);
    if (!sel opt_type.some) { ret layout.node(layout.NODE_UNKNOWN); }
    val t: *type.Type = opt_type.some;

    val d: type.PrimDesc = type.prim_desc(t.kind);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) {
        var n: layout.Node = layout.node(layout.NODE_SCALAR);
        n.bytes = d.bits / 8;
        ret n;
    }
    if (d.class == type.PRIM_CLASS_PTR || t.kind == type.TYPE_POINTER || t.kind == type.TYPE_FUN
        || t.kind == type.TYPE_HANDLE) {
        ret layout.node(layout.NODE_POINTER);
    }
    if (t.kind == type.TYPE_ABI) {
        var n: layout.Node = layout.node(layout.NODE_OPAQUE);
        n.bytes      = t.data.abi.size;
        n.decl_align = t.data.abi.align;
        ret n;
    }
    if (t.kind == type.TYPE_VECTOR) {
        var n: layout.Node = layout.node(layout.NODE_VECTOR);
        n.bytes = type.prim_desc(t.data.vector.element).bits / 8;
        n.count = t.data.vector.lanes;
        ret n;
    }

    if (t.kind == type.TYPE_ARRAY) {
        var n: layout.Node = layout.node(layout.NODE_ARRAY);
        n.child = t.data.array.base::u32;
        n.count = t.data.array.count;
        ret n;
    }

    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG || t.kind == type.TYPE_INSTANCE) {
        if (t.kind == type.TYPE_INSTANCE) { ensure_fields_inner(g, base); }

        val ov:     opt[bool] = nominal_overlays(g, base);
        val tagged: bool      = type.is_tag(?s.types, base);
        if (!tagged && !sel ov.some) { ret layout.node(layout.NODE_UNKNOWN); }
        val opt_tab: opt[*type.FieldTable] = type.field_table_for(?s.types, base);
        if (!sel opt_tab.some) { ret layout.node(layout.NODE_UNKNOWN); }

        var n: layout.Node = layout.node(layout.NODE_AGGREGATE);
        n.field_count = opt_tab.some.fields_len;
        if (tagged) {
            n.kind  = layout.NODE_TAG;
            n.bytes = type.tag_discriminator_bytes(?s.types, base);
        }
        or (sel ov.some) { n.overlays = ov.some; }
        val ta: opt[u32] = session.type_align(s, base::u32);
        if (sel ta.some) { n.decl_align = ta.some; }
        n.packed = session.type_is_packed(s, base::u32);
        ret n;
    }

    ret layout.node(layout.NODE_UNKNOWN);
}

fun describe_type_field(g: *GenericOp, id: u32, index: u32) u32 {
    val s:    *session.Session      = g.s;
    val base: type.TypeId           = type.strip_secret(?s.types, id::type.TypeId);
    val fe:   opt[*type.FieldEntry] = type.field_at(?s.types, base, index);
    if (!sel fe.some) { ret type.TYPE_ERROR::u32; }
    ret fe.some.ty::u32;
}

val SEMA_LAYOUT_MAX_DEPTH: u32 = 64;

fun type_extent_inner(g: *GenericOp, m: layout.Machine, tid: type.TypeId) layout.Extent {
    val s: *session.Session = g.s;
    ret layout.extent_of[GenericOp](g, describe_type, describe_type_field, tid::u32, m,
        SEMA_LAYOUT_MAX_DEPTH);
}

fun nominal_overlays(g: *GenericOp, tid: type.TypeId) opt[bool] {
    val s:   *session.Session = g.s;
    val nom: type.TypeId      = type.aggregate_nominal(?s.types, tid);
    if (nom == type.TYPE_ERROR) { ret opt[bool].none{}; }
    val opt_nom: opt[*type.Type] = type.get(?s.types, nom);
    if (!sel opt_nom.some) { ret opt[bool].none{}; }
    val k: type.TypeKind = opt_nom.some.kind;
    if (k == type.TYPE_UNI) { ret opt[bool].some{true}; }
    if (k == type.TYPE_REC) { ret opt[bool].some{false}; }
    ret opt[bool].none{};
}

# one run of bytes of the same secrecy class, as offsets into the type's storage;
# a pointer run carries the stripped pointer type whose target it reaches
rec SecrecyRun {
    start:    u32;
    end:      u32;
    ptr:      bool;
    secret:   bool;
    conflict: bool;
    leaf:     type.TypeId;
}

rec SecrecyWalk {
    g:    *GenericOp;
    m:    layout.Machine;
    scan: *type.PairScan;
    # the walk met two pointees it cannot compare, which no answer can settle
    unbounded: bool;
}

# how two storages compare on secrecy: they agree, they disagree, or the
# comparison would follow pointers into an expansive generic, whose instances
# are unbounded, so it cannot be decided and is refused
pub def Agreement: u8;

pub val AGREE:       Agreement = 0;
pub val DISAGREE:    Agreement = 1;
pub val UNDECIDABLE: Agreement = 2;

fun agreement_of(agree: bool, unbounded: bool) Agreement {
    if (agree)     { ret AGREE; }
    if (unbounded) { ret UNDECIDABLE; }
    ret DISAGREE;
}

# whether `tid` holds, by value, an instance of an expansive generic
fun holds_expansive(g: *GenericOp, tid: type.TypeId, scan: *type.TypeScan) bool {
    val s:    *session.Session = g.s;
    val base: type.TypeId      = type.strip_secret(?s.types, tid);
    val ot:   opt[*type.Type]  = type.get(?s.types, base);
    if (!sel ot.some) { ret false; }
    val t: *type.Type = ot.some;
    if (t.kind == type.TYPE_ARRAY)                                                                                     { ret holds_expansive(g, t.data.array.base, scan); }
    if (t.kind != type.TYPE_REC && t.kind != type.TYPE_UNI && t.kind != type.TYPE_TAG && t.kind != type.TYPE_INSTANCE) { ret false; }
    val mark: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, scan, base);
    if (sel mark.err) {
        fail.internal(g.status, fail.describe(mark.err));
        ret true;
    }
    if (mark.ok == type.VISIT_SEEN) { ret false; }
    if (t.kind == type.TYPE_INSTANCE) {
        if (nominal_expansive(g, t.data.instance.nominal)) { ret true; }
        ensure_fields_inner(g, base);
    }
    val n: u32 = type.field_count(?s.types, base);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*type.FieldEntry] = type.field_at(?s.types, base, i);
        if (sel fe.some && holds_expansive(g, fe.some.ty, scan)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a pointee pair the walk can compare: equal ones need no walk, and distinct ones
# holding an expansive instance would mint a fresh pair below every pointer
fun pointees_bounded(w: *SecrecyWalk, a: type.TypeId, b: type.TypeId) bool {
    val g: *GenericOp       = w.g;
    val s: *session.Session = g.s;
    if (a == b) { ret true; }
    var scan:   type.TypeScan;
    val opened: err[fail.Fail] = type.type_scan_begin(?s.types, ?scan);
    if (sel opened.err) {
        fail.internal(g.status, fail.describe(opened.err));
        ret false;
    }
    val holds: bool = holds_expansive(g, a, ?scan) || holds_expansive(g, b, ?scan);
    type.type_scan_end(?s.types, ?scan);
    if (holds) { w.unbounded = true; }
    ret !holds;
}

fun data_run(start: u32, end: u32, secret: bool) SecrecyRun {
    ret SecrecyRun{start: start, end: end, ptr: false, secret: secret, conflict: false, leaf: type.TYPE_NIL};
}

# a byte the walk cannot classify; it agrees with nothing
fun conflict_run(off: u32) SecrecyRun {
    ret SecrecyRun{start: off, end: off + 1, ptr: false, secret: false, conflict: true, leaf: type.TYPE_NIL};
}

fun shift_run(r: SecrecyRun, by: u32) SecrecyRun {
    var out: SecrecyRun = r;
    out.start = r.start + by;
    out.end   = r.end + by;
    ret out;
}

# the run of `tid` that holds byte `off`; padding is public, and an array of one
# data class is a single run
fun secrecy_run_at(w: *SecrecyWalk, tid: type.TypeId, inherited: bool, off: u32, depth: u32) SecrecyRun {
    val g: *GenericOp       = w.g;
    val s: *session.Session = g.s;
    if (depth > SEMA_LAYOUT_MAX_DEPTH) { ret conflict_run(off); }

    val secret: bool          = inherited || type.is_secret(?s.types, tid);
    val base:   type.TypeId   = type.strip_secret(?s.types, tid);
    val e:      layout.Extent = type_extent_inner(g, w.m, base);
    if (!e.ok || off >= e.size) { ret conflict_run(off); }
    val n: layout.Node = describe_type(g, base::u32);

    if (n.kind == layout.NODE_SCALAR || n.kind == layout.NODE_VECTOR || n.kind == layout.NODE_OPAQUE) {
        ret data_run(0, e.size, secret);
    }
    if (n.kind == layout.NODE_POINTER) {
        ret SecrecyRun{start: 0, end: e.size, ptr: true, secret: secret, conflict: false, leaf: base};
    }

    if (n.kind == layout.NODE_ARRAY) {
        val child: type.TypeId   = n.child::type.TypeId;
        val ce:    layout.Extent = type_extent_inner(g, w.m, type.strip_secret(?s.types, child));
        if (!ce.ok || ce.size == 0) { ret conflict_run(off); }
        val at:    u32        = (off / ce.size) * ce.size;
        val inner: SecrecyRun = secrecy_run_at(w, child, secret, off - at, depth + 1);
        if (!inner.ptr && !inner.conflict && inner.start == 0 && inner.end == ce.size) {
            ret data_run(at, e.size, inner.secret);
        }
        ret shift_run(inner, at);
    }

    if (n.kind == layout.NODE_TAG) {
        val disc: u32 = n.bytes;
        if (off < disc) { ret data_run(0, disc, false); }
        val pe: layout.Extent = layout.field_offset_of[GenericOp](g, describe_type, describe_type_field, base::u32, 0, w.m,
            SEMA_LAYOUT_MAX_DEPTH);
        if (!pe.ok)        { ret conflict_run(off); }
        if (off < pe.size) { ret data_run(disc, pe.size, false); }
        ret overlay_run_at(w, base, n.field_count, pe.size, e.size, secret, off, depth);
    }

    if (n.kind == layout.NODE_AGGREGATE && n.overlays) {
        ret overlay_run_at(w, base, n.field_count, 0, e.size, secret, off, depth);
    }

    if (n.kind == layout.NODE_AGGREGATE) {
        var offset:   u32 = 0;
        var prev_end: u32 = 0;
        var i:        u32 = 0;
        for (i < n.field_count) {
            val fty: type.TypeId   = describe_type_field(g, base::u32, i)::type.TypeId;
            val fe:  layout.Extent = type_extent_inner(g, w.m, type.strip_secret(?s.types, fty));
            if (!fe.ok) { ret conflict_run(off); }
            if (!n.packed) {
                val aligned: layout.Extent = layout.checked_round_up(offset, fe.align);
                if (!aligned.ok) { ret conflict_run(off); }
                offset = aligned.size;
            }
            if (off < offset) { ret data_run(prev_end, offset, false); }
            if (off < offset + fe.size) {
                ret shift_run(secrecy_run_at(w, fty, secret, off - offset, depth + 1), offset);
            }
            offset   = offset + fe.size;
            prev_end = offset;
            i        = i + 1;
        }
        ret data_run(prev_end, e.size, false);
    }

    ret conflict_run(off);
}

# the variants of a union or tag payload overlay one storage from `at`; a byte
# takes the class every variant covering it agrees on, and a conflict otherwise
fun overlay_run_at(w: *SecrecyWalk, base: type.TypeId, count: u32, at: u32, size: u32, secret: bool,
    off: u32, depth: u32) SecrecyRun {
    val g: *GenericOp       = w.g;
    val s: *session.Session = g.s;

    var covered:   bool       = false;
    var out:       SecrecyRun = data_run(at, size, false);
    var uncovered: u32        = at;
    var i:         u32        = 0;
    for (i < count) {
        val vty: type.TypeId   = describe_type_field(g, base::u32, i)::type.TypeId;
        val ve:  layout.Extent = type_extent_inner(g, w.m, type.strip_secret(?s.types, vty));
        if (!ve.ok) { ret conflict_run(off); }
        if (off < at + ve.size) {
            val r: SecrecyRun = shift_run(secrecy_run_at(w, vty, secret, off - at, depth + 1), at);
            if (!covered) {
                out     = r;
                covered = true;
            }
            or {
                out = merge_overlay_runs(w, out, r);
            }
        }
        or (at + ve.size > uncovered) { uncovered = at + ve.size; }
        i = i + 1;
    }
    if (!covered) { ret data_run(uncovered, size, false); }
    ret out;
}

fun merge_overlay_runs(w: *SecrecyWalk, a: SecrecyRun, b: SecrecyRun) SecrecyRun {
    var out: SecrecyRun = a;
    if (b.start > out.start) { out.start = b.start; }
    if (b.end < out.end)     { out.end = b.end; }
    if (a.conflict || b.conflict || a.ptr != b.ptr || a.secret != b.secret) {
        out.conflict = true;
        ret out;
    }
    if (a.ptr && (a.start != b.start || a.end != b.end || !pointer_leaves_equal(w, a.leaf, b.leaf))) {
        out.conflict = true;
    }
    ret out;
}

# a run that holds no secret and reaches none
fun run_is_public(w: *SecrecyWalk, r: SecrecyRun) bool {
    if (r.conflict || r.secret) { ret false; }
    if (!r.ptr)                 { ret true; }
    ret !contains_secret_deep_inner(w.g, r.leaf);
}

fun runs_agree(w: *SecrecyWalk, a: SecrecyRun, b: SecrecyRun) bool {
    if (a.conflict || b.conflict) { ret false; }
    if (!a.ptr && !b.ptr)         { ret a.secret == b.secret; }
    if (a.ptr && b.ptr && a.start == b.start && a.end == b.end) {
        ret a.secret == b.secret && pointer_leaves_equal(w, a.leaf, b.leaf);
    }
    ret run_is_public(w, a) && run_is_public(w, b);
}

# beneath a pointer the target is shared storage, so the two targets must match
# both ways: equal extent and the same class at every byte
fun pointer_leaves_equal(w: *SecrecyWalk, a: type.TypeId, b: type.TypeId) bool {
    val g: *GenericOp       = w.g;
    val s: *session.Session = g.s;
    if (!contains_secret_deep_inner(g, a) && !contains_secret_deep_inner(g, b)) { ret true; }

    val oa: opt[*type.Type] = type.get(?s.types, a);
    val ob: opt[*type.Type] = type.get(?s.types, b);
    if (!sel oa.some) { ret false; }
    if (!sel ob.some) { ret false; }
    val ta: *type.Type = oa.some;
    val tb: *type.Type = ob.some;

    if (ta.kind == type.TYPE_POINTER && tb.kind == type.TYPE_POINTER) {
        if (!pointees_bounded(w, ta.data.pointer.base, tb.data.pointer.base)) { ret false; }
        ret storage_equal(w, ta.data.pointer.base, tb.data.pointer.base);
    }
    if (ta.kind == type.TYPE_FUN && tb.kind == type.TYPE_FUN) {
        if (ta.data.fn.params_len != tb.data.fn.params_len)              { ret false; }
        if (!storage_equal(w, ta.data.fn.ret_type, tb.data.fn.ret_type)) { ret false; }
        var pi: u32 = 0;
        for (pi < ta.data.fn.params_len) {
            val pa: opt[type.TypeId] = type.get_param(?s.types, ta.data.fn.params_start + pi);
            val pb: opt[type.TypeId] = type.get_param(?s.types, tb.data.fn.params_start + pi);
            if (!sel pa.some)                        { ret false; }
            if (!sel pb.some)                        { ret false; }
            if (!storage_equal(w, pa.some, pb.some)) { ret false; }
            pi = pi + 1;
        }
        ret true;
    }
    ret false;
}

fun storage_equal(w: *SecrecyWalk, a: type.TypeId, b: type.TypeId) bool {
    val g: *GenericOp       = w.g;
    val s: *session.Session = g.s;
    if (a == type.TYPE_NIL || b == type.TYPE_NIL)                               { ret a == b; }
    if (a == b)                                                                 { ret true; }
    if (!contains_secret_deep_inner(g, a) && !contains_secret_deep_inner(g, b)) { ret true; }

    val mark_r: res[type.VisitMark, fail.Fail] = type.pair_scan_mark(?s.types, w.scan, a, b);
    if (sel mark_r.err) {
        fail.internal(g.status, fail.describe(mark_r.err));
        ret false;
    }
    if (mark_r.ok == type.VISIT_SEEN) { ret true; }

    val ea: layout.Extent = type_extent_inner(g, w.m, type.strip_secret(?s.types, a));
    val eb: layout.Extent = type_extent_inner(g, w.m, type.strip_secret(?s.types, b));
    if (!ea.ok || !eb.ok || ea.size != eb.size) { ret false; }
    ret agree_below(w, a, b, ea.size);
}

# every byte below `limit`, which both types cover, has one class on both sides
fun agree_below(w: *SecrecyWalk, a: type.TypeId, b: type.TypeId, limit: u32) bool {
    val g:   *GenericOp = w.g;
    var pos: u32        = 0;
    for (pos < limit) {
        val ra: SecrecyRun = secrecy_run_at(w, a, false, pos, 0);
        val rb: SecrecyRun = secrecy_run_at(w, b, false, pos, 0);
        if (sel g.status.kind.internal) { ret false; }
        if (!runs_agree(w, ra, rb))     { ret false; }
        var next: u32 = ra.end;
        if (rb.end < next) { next = rb.end; }
        pos = next;
    }
    ret true;
}

# the one data class that holds every byte of the type; none for a type with no
# bytes, a pointer or a byte of mixed class
fun single_class(w: *SecrecyWalk, tid: type.TypeId, size: u32) opt[bool] {
    if (size == 0) { ret opt[bool].none{}; }
    val first: SecrecyRun = secrecy_run_at(w, tid, false, 0, 0);
    if (first.ptr || first.conflict) { ret opt[bool].none{}; }
    var pos: u32 = first.end;
    for (pos < size) {
        val r: SecrecyRun = secrecy_run_at(w, tid, false, pos, 0);
        if (r.ptr || r.conflict || r.secret != first.secret) { ret opt[bool].none{}; }
        pos = r.end;
    }
    ret opt[bool].some{first.secret};
}

# a `*S` retyped as `*T`: the bytes both cover keep their class, a narrowing is
# accepted, and a widening only when `S` and `T` are one and the same class throughout
fun retype_allowed(w: *SecrecyWalk, from: type.TypeId, to: type.TypeId) bool {
    val g:  *GenericOp       = w.g;
    val s:  *session.Session = g.s;
    val ef: layout.Extent    = type_extent_inner(g, w.m, type.strip_secret(?s.types, from));
    val et: layout.Extent    = type_extent_inner(g, w.m, type.strip_secret(?s.types, to));
    if (!ef.ok || !et.ok) { ret false; }

    var common: u32 = ef.size;
    if (et.size < common)                  { common = et.size; }
    if (!agree_below(w, from, to, common)) { ret false; }
    if (et.size <= ef.size)                { ret true; }

    val cf: opt[bool] = single_class(w, from, ef.size);
    val ct: opt[bool] = single_class(w, to, et.size);
    if (!sel cf.some) { ret false; }
    if (!sel ct.some) { ret false; }
    ret cf.some == ct.some;
}

fun is_data_leaf(g: *GenericOp, tid: type.TypeId) bool {
    val s: *session.Session = g.s;
    val n: layout.Node      = describe_type(g, type.strip_secret(?s.types, tid)::u32);
    ret n.kind == layout.NODE_SCALAR || n.kind == layout.NODE_VECTOR;
}

fun secrecy_cast_allowed_inner(g: *GenericOp, m: layout.Machine, from: type.TypeId, to: type.TypeId, unbounded: *bool) bool {
    val s: *session.Session = g.s;
    if (!contains_secret_deep_inner(g, from) && !contains_secret_deep_inner(g, to)) { ret true; }

    var scan:   type.PairScan;
    val scan_r: err[fail.Fail] = type.pair_scan_begin(?s.types, ?scan);
    if (sel scan_r.err) {
        fail.internal(g.status, fail.describe(scan_r.err));
        ret false;
    }
    var w: SecrecyWalk = SecrecyWalk{g: g, m: m, scan: ?scan, unbounded: false};

    val sf:      type.TypeId     = type.strip_secret(?s.types, from);
    val st:      type.TypeId     = type.strip_secret(?s.types, to);
    val of:      opt[*type.Type] = type.get(?s.types, sf);
    val ot:      opt[*type.Type] = type.get(?s.types, st);
    var allowed: bool            = false;
    if (sel of.some) {
        if (sel ot.some) {
            val same: bool = type.is_secret(?s.types, from) == type.is_secret(?s.types, to);
            if (of.some.kind == type.TYPE_POINTER && ot.some.kind == type.TYPE_POINTER) {
                allowed = same && retype_allowed(?w, of.some.data.pointer.base, ot.some.data.pointer.base);
            }
            or (is_data_leaf(g, from) && is_data_leaf(g, to)) {
                allowed = same;
            }
            or {
                allowed = overlay_agrees_walk(?w, from, to);
            }
        }
    }
    type.pair_scan_end(?s.types, ?scan);
    @unbounded = w.unbounded;
    ret allowed;
}

fun overlay_agrees_walk(w: *SecrecyWalk, a: type.TypeId, b: type.TypeId) bool {
    val g:  *GenericOp       = w.g;
    val s:  *session.Session = g.s;
    val ea: layout.Extent    = type_extent_inner(g, w.m, type.strip_secret(?s.types, a));
    val eb: layout.Extent    = type_extent_inner(g, w.m, type.strip_secret(?s.types, b));
    if (!ea.ok || !eb.ok) { ret false; }
    var common: u32 = ea.size;
    if (eb.size < common) { common = eb.size; }
    ret agree_below(w, a, b, common);
}

# two types laid over one storage from offset 0, as union variants are: every
# byte both cover has one class on both sides
fun secrecy_overlay_agrees_inner(g: *GenericOp, m: layout.Machine, a: type.TypeId, b: type.TypeId, unbounded: *bool) bool {
    val s: *session.Session = g.s;
    if (!contains_secret_deep_inner(g, a) && !contains_secret_deep_inner(g, b)) { ret true; }

    var scan:   type.PairScan;
    val scan_r: err[fail.Fail] = type.pair_scan_begin(?s.types, ?scan);
    if (sel scan_r.err) {
        fail.internal(g.status, fail.describe(scan_r.err));
        ret false;
    }
    var w:     SecrecyWalk = SecrecyWalk{g: g, m: m, scan: ?scan, unbounded: false};
    val agree: bool        = overlay_agrees_walk(?w, a, b);
    type.pair_scan_end(?s.types, ?scan);
    @unbounded = w.unbounded;
    ret agree;
}

rec UniInstScan {
    scan:                type.TypeScan;
    unprovable_reported: bool;
}

fun module_reaches_secret_inner(g: *GenericOp, resolved: *type.TypeId, len: u32) bool {
    val s: *session.Session = g.s;
    if (resolved == nil) { ret false; }

    var scan:   type.TypeScan;
    val scan_r: err[fail.Fail] = type.type_scan_begin(?s.types, ?scan);
    if (sel scan_r.err) {
        fail.internal(g.status, fail.describe(scan_r.err));
        ret false;
    }

    var found: bool = false;
    var i:     u32  = 0;
    for (i < len) {
        if (secret_reach_walk(g, resolved[i], ?scan)) {
            found = true;
            brk;
        }
        i = i + 1;
    }

    type.type_scan_end(?s.types, ?scan);
    ret found;
}

fun secret_reach_walk(g: *GenericOp, tid: type.TypeId, scan: *type.TypeScan) bool {
    val s: *session.Session = g.s;
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }

    val opt_t: opt[*type.Type] = type.get(?s.types, tid);
    if (!sel opt_t.some) { ret true; }
    val t: *type.Type    = opt_t.some;
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_SECRET) { ret true; }

    if (k == type.TYPE_POINTER) {
        val base: type.TypeId = t.data.pointer.base;
        ret secret_reach_walk(g, base, scan);
    }
    if (k == type.TYPE_ARRAY) {
        val base: type.TypeId = t.data.array.base;
        ret secret_reach_walk(g, base, scan);
    }
    if (k == type.TYPE_FUN) {
        val ret_ty:       type.TypeId = t.data.fn.ret_type;
        val params_start: u32         = t.data.fn.params_start;
        val params_len:   u32         = t.data.fn.params_len;
        if (secret_reach_walk(g, ret_ty, scan)) { ret true; }
        var pi: u32 = 0;
        for (pi < params_len) {
            val p_opt: opt[type.TypeId] = type.get_param(?s.types, params_start + pi);
            if (sel p_opt.some && secret_reach_walk(g, p_opt.some, scan)) { ret true; }
            pi = pi + 1;
        }
        ret false;
    }

    if (k == type.TYPE_INSTANCE) {
        val mark_r: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, scan, tid);
        if (sel mark_r.err) {
            fail.internal(g.status, fail.describe(mark_r.err));
            ret true;
        }
        val mark: type.VisitMark = mark_r.ok;
        if (mark == type.VISIT_SEEN) { ret false; }

        val gnom:       type.TypeId = t.data.instance.nominal;
        val args_start: u32         = t.data.instance.args_start;
        val args_len:   u32         = t.data.instance.args_len;

        var i: u32 = 0;
        for (i < args_len) {
            val a_opt: opt[type.TypeId] = type.get_param(?s.types, args_start + i);
            if (sel a_opt.some && secret_reach_walk(g, a_opt.some, scan)) { ret true; }
            i = i + 1;
        }

        if (gnom == type.TYPE_ERROR) { ret true; }
        ret secret_reach_walk(g, gnom, scan);
    }

    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) {
        val mark_r: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, scan, tid);
        if (sel mark_r.err) {
            fail.internal(g.status, fail.describe(mark_r.err));
            ret true;
        }
        val mark: type.VisitMark = mark_r.ok;
        if (mark == type.VISIT_SEEN) { ret false; }

        val opt_tab: opt[*type.FieldTable] = type.field_table_for(?s.types, tid);
        if (!sel opt_tab.some) { ret true; }
        val fields_len: u32 = opt_tab.some.fields_len;

        var f: u32 = 0;
        for (f < fields_len) {
            val e_opt: opt[*type.FieldEntry] = type.field_at(?s.types, tid, f);
            if (sel e_opt.some) {
                val fty: type.TypeId = e_opt.some.ty;
                if (secret_reach_walk(g, fty, scan)) { ret true; }
            }
            f = f + 1;
        }
        ret false;
    }

    if (k == type.TYPE_PACK) { ret false; }

    if (kind_is_public_leaf(k)) { ret false; }
    ret true;
}

pub fun check_annotation_uni_secrecy(sc: *sema.SemaContext, ast_tid: id.TypeId) {
    if (!sc.has_secret)                { ret; }
    if (sc.type_resolved_ty == nil)    { ret; }
    if (ast_tid >= sc.a.type_len::u32) { ret; }

    val t_opt: opt[*atype.Type] = ast.get_type(sc.a, ast_tid);
    if (!sel t_opt.some) { ret; }

    check_type_uni_secrecy(sc, sc.type_resolved_ty[ast_tid], ?sc.subst_owner, sc.subst, sc.subst_len,
        t_opt.some.span);
}

# the checks an instance owes each type annotation it resolves, which no check of the
# generic declaration can answer before its parameters are known
pub fun check_annotation(sc: *sema.SemaContext, ast_tid: id.TypeId) {
    check_annotation_uni_secrecy(sc, ast_tid);
    check_annotation_handles(sc, ast_tid);
}

# a generic record, union or tag instantiated so that a field or payload holds a handle,
# directly or through a pointer, array or secret: the instance is the declaration its
# arguments spell, and the same declaration written out is refused for that field
pub fun check_annotation_handles(sc: *sema.SemaContext, ast_tid: id.TypeId) {
    if (sc.type_resolved_ty == nil)    { ret; }
    if (ast_tid >= sc.a.type_len::u32) { ret; }
    val t_opt: opt[*atype.Type] = ast.get_type(sc.a, ast_tid);
    if (!sel t_opt.some) { ret; }
    val tid: type.TypeId = sema.apply_subst(sc, sc.type_resolved_ty[ast_tid]);
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret; }

    var scan:   type.TypeScan;
    val scan_r: err[fail.Fail] = type.type_scan_begin(?sc.s.types, ?scan);
    if (sel scan_r.err) {
        fail.internal(?sc.status, fail.describe(scan_r.err));
        ret;
    }
    handle_inst_walk(sc, tid, ?scan, t_opt.some.span);
    type.type_scan_end(?sc.s.types, ?scan);
}

fun handle_inst_walk(sc: *sema.SemaContext, tid: type.TypeId, scan: *type.TypeScan, span: token.Span) {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret; }
    val s:     *session.Session = sc.s;
    val opt_t: opt[*type.Type]  = type.get(?s.types, tid);
    if (!sel opt_t.some) { ret; }
    val t: *type.Type = opt_t.some;
    if (t.kind == type.TYPE_SECRET)  { handle_inst_walk(sc, t.data.secret.base, scan, span); }
    if (t.kind == type.TYPE_POINTER) { handle_inst_walk(sc, t.data.pointer.base, scan, span); }
    if (t.kind == type.TYPE_ARRAY)   { handle_inst_walk(sc, t.data.array.base, scan, span); }
    if (t.kind == type.TYPE_FUN) {
        handle_inst_walk(sc, t.data.fn.ret_type, scan, span);
        var i: u32 = 0;
        for (i < t.data.fn.params_len) {
            val p_opt: opt[type.TypeId] = type.get_param(?s.types, t.data.fn.params_start + i);
            if (sel p_opt.some) { handle_inst_walk(sc, p_opt.some, scan, span); }
            i = i + 1;
        }
    }
    if (t.kind == type.TYPE_INSTANCE) { handle_inst_walk_instance(sc, tid, t, scan, span); }
}

# whether an instance's fields carry a handle turns only on which of its arguments carry
# one, so instances agreeing on that are one visit: a pointer-recursive generic whose
# arguments grow at every level is then still a finite walk
fun handle_visit_key(g: *GenericOp, gnom: type.TypeId, args: *type.TypeId, args_len: u32) opt[type.TypeId] {
    val s:     *session.Session = g.s;
    val plain: opt[type.TypeId] = type.prim(?s.types, type.TYPE_U8);
    if (sel plain.none) {
        fail.internal(g.status, "handle instance walk: the u8 type is not interned");
        ret opt[type.TypeId].none{};
    }
    val res_canon: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (sel res_canon.err) {
        fail.internal(g.status, alloc.text(res_canon.err));
        ret opt[type.TypeId].none{};
    }
    val canon: *type.TypeId = res_canon.ok;
    fin { A.deallocate[type.TypeId](s.alloc, canon, args_len::usize); }
    var i: u32 = 0;
    for (i < args_len) {
        canon[i] = plain.some;
        if (type.carries_handle(?s.types, args[i])) { canon[i] = carried_handle(g, args[i]); }
        i = i + 1;
    }
    val key: res[type.TypeId, fail.Fail] = type.intern_instance(?s.types, gnom, canon, args_len);
    if (sel key.err) {
        fail.internal(g.status, fail.describe(key.err));
        ret opt[type.TypeId].none{};
    }
    ret opt[type.TypeId].some{key.ok};
}

fun mentions_handle(g: *GenericOp, tid: type.TypeId) bool {
    val s:     *session.Session = g.s;
    val opt_t: opt[*type.Type]  = type.get(?s.types, tid);
    if (!sel opt_t.some) { ret false; }
    val t: *type.Type = opt_t.some;
    if (t.kind == type.TYPE_HANDLE)  { ret true; }
    if (t.kind == type.TYPE_SECRET)  { ret mentions_handle(g, t.data.secret.base); }
    if (t.kind == type.TYPE_POINTER) { ret mentions_handle(g, t.data.pointer.base); }
    if (t.kind == type.TYPE_ARRAY)   { ret mentions_handle(g, t.data.array.base); }
    if (t.kind == type.TYPE_FUN) {
        if (mentions_handle(g, t.data.fn.ret_type)) { ret true; }
        ret params_mention_handle(g, t.data.fn.params_start, t.data.fn.params_len);
    }
    if (t.kind == type.TYPE_INSTANCE) {
        ret params_mention_handle(g, t.data.instance.args_start, t.data.instance.args_len);
    }
    ret false;
}

fun params_mention_handle(g: *GenericOp, start: u32, len: u32) bool {
    val s: *session.Session = g.s;
    var i: u32              = 0;
    for (i < len) {
        val p_opt: opt[type.TypeId] = type.get_param(?s.types, start + i);
        if (sel p_opt.some) {
            if (mentions_handle(g, p_opt.some)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# the handle a type carries, under every pointer, array and secret over it
fun carried_handle(g: *GenericOp, tid: type.TypeId) type.TypeId {
    val s:     *session.Session = g.s;
    val opt_t: opt[*type.Type]  = type.get(?s.types, tid);
    if (!sel opt_t.some) { ret tid; }
    val t: *type.Type = opt_t.some;
    if (t.kind == type.TYPE_SECRET)  { ret carried_handle(g, t.data.secret.base); }
    if (t.kind == type.TYPE_POINTER) { ret carried_handle(g, t.data.pointer.base); }
    if (t.kind == type.TYPE_ARRAY)   { ret carried_handle(g, t.data.array.base); }
    ret tid;
}

fun handle_inst_walk_instance(sc: *sema.SemaContext, tid: type.TypeId, t: *type.Type, scan: *type.TypeScan,
    span: token.Span) {
    var op: GenericOp;
    op.s      = sc.s;
    op.status = ?sc.status;
    val g: *GenericOp       = ?op;
    val s: *session.Session = sc.s;

    val gnom:       type.TypeId = t.data.instance.nominal;
    val args_start: u32         = t.data.instance.args_start;
    val args_len:   u32         = t.data.instance.args_len;
    if (args_len == 0) { ret; }

    val res_args: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (sel res_args.err) {
        fail.internal(g.status, alloc.text(res_args.err));
        ret;
    }
    val args: *type.TypeId = res_args.ok;
    fin { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
    var i: u32 = 0;
    for (i < args_len) {
        val a_opt: opt[type.TypeId] = type.get_param(?s.types, args_start + i);
        if (!sel a_opt.some) { ret; }
        args[i] = a_opt.some;
        handle_inst_walk(sc, args[i], scan, span);
        i = i + 1;
    }

    # an instance none of whose arguments mentions a handle has fields holding none, since
    # a generic's own fields are checked as its declaration
    var mentioned: bool = false;
    i = 0;
    for (i < args_len) {
        if (mentions_handle(g, args[i])) { mentioned = true; }
        i = i + 1;
    }
    if (!mentioned) { ret; }

    val key: opt[type.TypeId] = handle_visit_key(g, gnom, args, args_len);
    if (sel key.none) { ret; }
    val mark_r: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, scan, key.some);
    if (sel mark_r.err) {
        fail.internal(g.status, fail.describe(mark_r.err));
        ret;
    }
    if (mark_r.ok == type.VISIT_SEEN) { ret; }

    # fields that mention no parameter are the declaration's own, which its check covers
    val who_opt: opt[type.GenericOwner] = nominal_param_owner(g, gnom);
    if (!sel who_opt.some) { ret; }
    var who: type.GenericOwner = who_opt.some;

    val opt_tab: opt[*type.FieldTable] = type.field_table_for(?s.types, gnom);
    if (!sel opt_tab.some) { ret; }
    val fields_len: u32 = opt_tab.some.fields_len;
    var f:          u32 = 0;
    for (f < fields_len) {
        val e_opt: opt[*type.FieldEntry] = type.field_at(?s.types, gnom, f);
        if (!sel e_opt.some) { ret; }
        val fty: type.TypeId = substitute_inner(g, e_opt.some.ty, ?who, args, args_len);
        if (sel g.status.kind.internal) { ret; }
        if (type.carries_handle(?s.types, fty)) {
            if (sema.uni_report_mark(sc.handle_reports, tid)) {
                sema.report(sc, dkind.HANDLE_STORAGE, span, "a handle cannot be a record or union field or a tag payload, and this instantiation puts one there: an instance is the declaration its type arguments spell, a record is storage the program owns at offsets it can compute, and a handle's representation is not the program's, so an aggregate holding one has no layout. pass the handle itself, or a pointer to its binding, instead");
            }
            ret;
        }
        handle_inst_walk(sc, fty, scan, span);
        f = f + 1;
    }
}

pub fun check_type_uni_secrecy(sc: *sema.SemaContext, tid: type.TypeId, who: *type.GenericOwner,
    args: *type.TypeId, arg_len: u32, span: token.Span) {
    if (!sc.has_secret)                                 { ret; }
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret; }

    var scan: UniInstScan;
    scan.unprovable_reported = false;
    val scan_r: err[fail.Fail] = type.type_scan_begin(?sc.s.types, ?scan.scan);
    if (sel scan_r.err) {
        fail.internal(?sc.status, fail.describe(scan_r.err));
        ret;
    }
    uni_inst_walk(sc, tid, who, args, arg_len, ?scan, span);
    type.type_scan_end(?sc.s.types, ?scan.scan);
}

fun uni_inst_walk(sc: *sema.SemaContext, tid: type.TypeId, who: *type.GenericOwner, args: *type.TypeId,
    arg_len: u32, scan: *UniInstScan, span: token.Span) {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret; }
    val s: *session.Session = sc.s;

    val opt_t: opt[*type.Type] = type.get(?s.types, tid);
    if (!sel opt_t.some) { ret; }
    val t: *type.Type    = opt_t.some;
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_GENERIC_PARAM) { ret; }

    if (k == type.TYPE_SECRET) {
        val base: type.TypeId = t.data.secret.base;
        uni_inst_walk(sc, base, who, args, arg_len, scan, span);
        ret;
    }
    if (k == type.TYPE_POINTER) {
        val base: type.TypeId = t.data.pointer.base;
        uni_inst_walk(sc, base, who, args, arg_len, scan, span);
        ret;
    }
    if (k == type.TYPE_ARRAY) {
        val base: type.TypeId = t.data.array.base;
        uni_inst_walk(sc, base, who, args, arg_len, scan, span);
        ret;
    }

    if (k == type.TYPE_FUN) {
        val ret_ty:       type.TypeId = t.data.fn.ret_type;
        val params_start: u32         = t.data.fn.params_start;
        val params_len:   u32         = t.data.fn.params_len;
        uni_inst_walk(sc, ret_ty, who, args, arg_len, scan, span);
        var i: u32 = 0;
        for (i < params_len) {
            val p_opt: opt[type.TypeId] = type.get_param(?s.types, params_start + i);
            if (sel p_opt.some) {
                uni_inst_walk(sc, p_opt.some, who, args, arg_len, scan, span);
            }
            i = i + 1;
        }
        ret;
    }

    if (k == type.TYPE_INSTANCE) {
        uni_inst_walk_instance(sc, tid, who, args, arg_len, scan, span);
        ret;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) {
        uni_inst_walk_nominal(sc, tid, args, arg_len, scan, span);
        ret;
    }
}

fun uni_inst_walk_instance(sc: *sema.SemaContext, tid: type.TypeId, who: *type.GenericOwner,
    args: *type.TypeId, arg_len: u32, scan: *UniInstScan, span: token.Span) {
    var op: GenericOp;
    op.s      = sc.s;
    op.status = ?sc.status;
    val g: *GenericOp       = ?op;
    val s: *session.Session = sc.s;

    val opt_t: opt[*type.Type] = type.get(?s.types, tid);
    if (!sel opt_t.some) { ret; }
    val t:          *type.Type  = opt_t.some;
    val gnom:       type.TypeId = t.data.instance.nominal;
    val args_start: u32         = t.data.instance.args_start;
    val args_len:   u32         = t.data.instance.args_len;

    if (args_len == 0) { ret; }

    val res_raw: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (sel res_raw.err) {
        fail.internal(g.status, alloc.text(res_raw.err));
        ret;
    }
    val raw: *type.TypeId = res_raw.ok;

    var i: u32 = 0;
    for (i < args_len) {
        val a_opt: opt[type.TypeId] = type.get_param(?s.types, args_start + i);
        if (!sel a_opt.some) {
            A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
            ret;
        }
        raw[i] = a_opt.some;
        i      = i + 1;
    }

    i = 0;
    for (i < args_len) {
        uni_inst_walk(sc, raw[i], who, args, arg_len, scan, span);
        i = i + 1;
    }

    # an expansive generic's instances are unbounded, so the walk cannot visit
    # them all; it needs to only when a secret and a generic union lie below
    if (gnom != type.TYPE_ERROR && nominal_expansive(g, gnom)) {
        if (contains_secret_deep_inner(g, tid) && reaches_generic_union(g, gnom)) { report_unbounded(sc, scan, span); }
        A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
        ret;
    }

    if (gnom == type.TYPE_ERROR) {
        sema.report_internal(sc, span, "internal: #2225 union-secrecy instance walk: generic instance target declaration unavailable (pristine-type invariant violated)");
        A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
        ret;
    }

    val res_conc: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (sel res_conc.err) {
        fail.internal(g.status, alloc.text(res_conc.err));
        A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
        ret;
    }
    val conc: *type.TypeId = res_conc.ok;

    i = 0;
    for (i < args_len) {
        conc[i] = subst_or_self(g, raw[i], who, args, arg_len);
        i       = i + 1;
    }

    uni_inst_walk_nominal(sc, gnom, conc, args_len, scan, span);

    A.deallocate[type.TypeId](s.alloc, conc, args_len::usize);
    A.deallocate[type.TypeId](s.alloc, raw, args_len::usize);
}

fun uni_inst_walk_nominal(sc: *sema.SemaContext, nom: type.TypeId, args: *type.TypeId,
    arg_len: u32, scan: *UniInstScan, span: token.Span) {
    var op: GenericOp;
    op.s      = sc.s;
    op.status = ?sc.status;
    val g: *GenericOp       = ?op;
    val s: *session.Session = sc.s;

    val opt_nom: opt[*type.Type] = type.get(?s.types, nom);
    if (!sel opt_nom.some) {
        report_unprovable(sc, scan, span);
        ret;
    }
    val nom_kind: type.TypeKind         = opt_nom.some.kind;
    val opt_tab:  opt[*type.FieldTable] = type.field_table_for(?s.types, nom);
    if (!sel opt_tab.some) {
        report_unprovable(sc, scan, span);
        ret;
    }
    val fields_len: u32 = opt_tab.some.fields_len;

    var a:       *type.TypeId = args;
    var n:       u32          = arg_len;
    val generic: bool         = nominal_has_gparam(g, nom);
    if (!generic) {
        a = nil;
        n = 0;
    }

    val key:    type.TypeId                    = nominal_visit_key(g, nom, a, n);
    val mark_r: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, ?scan.scan, key);
    if (sel mark_r.err) {
        fail.internal(g.status, fail.describe(mark_r.err));
        ret;
    }
    val mark: type.VisitMark = mark_r.ok;
    if (mark == type.VISIT_SEEN) { ret; }

    # a non-generic nominal walks its fields with no arguments, under no owner
    var who: type.GenericOwner;
    if (generic) {
        val who_opt: opt[type.GenericOwner] = nominal_param_owner(g, nom);
        if (!sel who_opt.some) {
            report_unprovable(sc, scan, span);
            ret;
        }
        who = who_opt.some;
    }

    if (generic && nom_kind == type.TYPE_UNI) {
        check_uni_variants(sc, nom, ?who, a, n, key, scan, span);
    }

    var f: u32 = 0;
    for (f < fields_len) {
        val e_opt: opt[*type.FieldEntry] = type.field_at(?s.types, nom, f);
        if (!sel e_opt.some) {
            report_unprovable(sc, scan, span);
            ret;
        }
        val fty: type.TypeId = e_opt.some.ty;
        uni_inst_walk(sc, fty, ?who, a, n, scan, span);
        f = f + 1;
    }
}

fun report_unbounded(sc: *sema.SemaContext, scan: *UniInstScan, span: token.Span) {
    if (scan.unprovable_reported) { ret; }
    scan.unprovable_reported = true;
    sema.report(sc, dkind.SECRET_VARIANT_UNPROVABLE, span, "constant-time: cannot prove that every generic union this type reaches has variants agreeing on secrecy - it reaches them through a generic whose argument grows through a pointer, so the unions are instantiated unboundedly many ways");
}

# whether a generic union is reachable from the fields of `nominal`, through any
# member, element, pointee, parameter, argument or declaration a mention names
fun reaches_generic_union(g: *GenericOp, nominal: type.TypeId) bool {
    val s:       *session.Session    = g.s;
    var pending: Vector[type.TypeId] = vector.init[type.TypeId](s.types.a);
    var scan:    type.TypeScan;
    val opened:  err[fail.Fail]      = type.type_scan_begin(?s.types, ?scan);
    if (sel opened.err) {
        fail.internal(g.status, fail.describe(opened.err));
        ret true;
    }
    fin {
        type.type_scan_end(?s.types, ?scan);
        vector.dnit[type.TypeId](?pending);
    }
    if (!union_walk_push(g, ?pending, ?scan, nominal)) { ret true; }

    var next: usize = 0;
    for (next < pending.len) {
        val tid: type.TypeId = pending.data[next];
        next = next + 1;
        val ot: opt[*type.Type] = type.get(?s.types, tid);
        if (sel ot.none) { cnt; }
        val t:  *type.Type = ot.some;
        var ok: bool       = true;
        if (t.kind == type.TYPE_POINTER) { ok = union_walk_push(g, ?pending, ?scan, t.data.pointer.base); }
        or (t.kind == type.TYPE_ARRAY)   { ok = union_walk_push(g, ?pending, ?scan, t.data.array.base); }
        or (t.kind == type.TYPE_SECRET)  { ok = union_walk_push(g, ?pending, ?scan, t.data.secret.base); }
        or (t.kind == type.TYPE_FUN) {
            ok = union_walk_push(g, ?pending, ?scan, t.data.fn.ret_type);
            var pi: u32 = 0;
            for (ok && pi < t.data.fn.params_len) {
                val pp: opt[type.TypeId] = type.get_param(?s.types, t.data.fn.params_start + pi);
                if (sel pp.some) { ok = union_walk_push(g, ?pending, ?scan, pp.some); }
                pi = pi + 1;
            }
        }
        or (t.kind == type.TYPE_INSTANCE) {
            ok = union_walk_push(g, ?pending, ?scan, t.data.instance.nominal);
            var ai: u32 = 0;
            for (ok && ai < t.data.instance.args_len) {
                val arg: opt[type.TypeId] = type.get_param(?s.types, t.data.instance.args_start + ai);
                if (sel arg.some) { ok = union_walk_push(g, ?pending, ?scan, arg.some); }
                ai = ai + 1;
            }
        }
        or (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
            if (t.kind == type.TYPE_UNI && nominal_has_gparam(g, tid)) { ret true; }
            val table: opt[*type.FieldTable] = type.field_table_for(?s.types, tid);
            if (sel table.none) { ret true; }
            var f: u32 = 0;
            for (ok && f < table.some.fields_len) {
                val entry: opt[*type.FieldEntry] = type.field_at(?s.types, tid, f);
                if (sel entry.some) { ok = union_walk_push(g, ?pending, ?scan, entry.some.ty); }
                f = f + 1;
            }
        }
        if (!ok) { ret true; }
    }
    ret false;
}

fun union_walk_push(g: *GenericOp, pending: *Vector[type.TypeId], scan: *type.TypeScan, tid: type.TypeId) bool {
    val s: *session.Session = g.s;
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret true; }
    val mark: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, scan, tid);
    if (sel mark.err) {
        fail.internal(g.status, fail.describe(mark.err));
        ret false;
    }
    if (mark.ok == type.VISIT_SEEN) { ret true; }
    val pushed: res[usize, A.Error] = vector.push[type.TypeId](pending, tid);
    if (sel pushed.err) {
        fail.internal(g.status, alloc.text(pushed.err));
        ret false;
    }
    ret true;
}

fun report_unprovable(sc: *sema.SemaContext, scan: *UniInstScan, span: token.Span) {
    if (scan.unprovable_reported) { ret; }
    scan.unprovable_reported = true;
    sema.report(sc, dkind.SECRET_VARIANT_UNPROVABLE, span, "constant-time: cannot prove that every generic union this type reaches has variants agreeing on secrecy - its field layout is unavailable or its type graph is too large");
}

fun check_uni_variants(sc: *sema.SemaContext, nom: type.TypeId, who: *type.GenericOwner,
    args: *type.TypeId, arg_len: u32, key: type.TypeId, scan: *UniInstScan, span: token.Span) {
    var op: GenericOp;
    op.s      = sc.s;
    op.status = ?sc.status;
    val g: *GenericOp       = ?op;
    val s: *session.Session = sc.s;

    val opt_tab: opt[*type.FieldTable] = type.field_table_for(?s.types, nom);
    if (!sel opt_tab.some) {
        report_unprovable(sc, scan, span);
        ret;
    }
    val fields_len: u32 = opt_tab.some.fields_len;
    if (fields_len < 2) { ret; }

    var i: u32 = 0;
    for (i < fields_len) {
        val vi: opt[type.TypeId] = uni_variant(g, nom, i, who, args, arg_len);
        if (!sel vi.some) {
            report_unprovable(sc, scan, span);
            ret;
        }
        if (type_mentions_gparam(g, vi.some)) { ret; }
        i = i + 1;
    }

    # agreement is pairwise over the bytes each pair shares, so no variant stands in for the rest
    i = 1;
    for (i < fields_len) {
        val vi: opt[type.TypeId] = uni_variant(g, nom, i, who, args, arg_len);
        var j:  u32              = 0;
        for (j < i) {
            val vj: opt[type.TypeId] = uni_variant(g, nom, j, who, args, arg_len);
            if (sel vi.some) {
                if (sel vj.some) {
                    var unbounded: bool = false;
                    val agree:     bool = secrecy_overlay_agrees_inner(g, sema.machine_of(sc), vj.some, vi.some, ?unbounded);
                    if (sel g.status.kind.internal) { ret; }
                    if (!agree && unbounded) {
                        if (sema.uni_report_mark(sc.uni_reports, key)) {
                            sema.report(sc, dkind.SECRET_VARIANT_UNPROVABLE, span, UNBOUNDED_VARIANTS_MSG);
                        }
                        ret;
                    }
                    if (!agree) {
                        if (sema.uni_report_mark(sc.uni_reports, key)) {
                            sema.report(sc, dkind.SECRET_VARIANT_MISMATCH, span, "union variants must agree on secrecy: this instantiation makes overlapping fields part secret `^` and part public, which would alias the same storage at two classifications");
                        }
                        ret;
                    }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

fun uni_variant(g: *GenericOp, nom: type.TypeId, i: u32, who: *type.GenericOwner, args: *type.TypeId,
    arg_len: u32) opt[type.TypeId] {
    val s:     *session.Session      = g.s;
    val e_opt: opt[*type.FieldEntry] = type.field_at(?s.types, nom, i);
    if (!sel e_opt.some) { ret opt[type.TypeId].none{}; }
    ret opt[type.TypeId].some{subst_or_self(g, e_opt.some.ty, who, args, arg_len)};
}

fun nominal_visit_key(g: *GenericOp, nom: type.TypeId, args: *type.TypeId, arg_len: u32) type.TypeId {
    val s: *session.Session = g.s;
    if (args == nil || arg_len == 0) { ret nom; }

    val opt_nom: opt[*type.Type] = type.get(?s.types, nom);
    if (!sel opt_nom.some) { ret nom; }
    val t: *type.Type = opt_nom.some;
    if (t.kind != type.TYPE_REC && t.kind != type.TYPE_UNI && t.kind != type.TYPE_TAG) { ret nom; }

    val r: res[type.TypeId, fail.Fail] = type.intern_instance(?s.types, nom, args, arg_len);
    if (sel r.err) {
        fail.internal(g.status, fail.describe(r.err));
        ret nom;
    }
    ret r.ok;
}

fun subst_or_self(g: *GenericOp, tid: type.TypeId, who: *type.GenericOwner, args: *type.TypeId, arg_len: u32) type.TypeId {
    val s: *session.Session = g.s;
    if (args == nil || arg_len == 0) { ret tid; }
    ret substitute_inner(g, tid, who, args, arg_len);
}

fun type_mentions_gparam(g: *GenericOp, tid: type.TypeId) bool {
    val s: *session.Session = g.s;
    var w: GParamWalk;
    gparam_walk_begin(g, ?w);
    val mentioned: bool = mentions_gparam(g, tid, ?w);
    gparam_walk_end(g, ?w);
    ret mentioned;
}

fun generic_nominal_of_inner(sc: *sema.SemaContext, sym: *resolve.Symbol) type.TypeId {
    var kind: type.TypeKind = type.TYPE_REC;
    if (sym.definition_kind == resolve.SYM_UNI) { kind = type.TYPE_UNI; }
    if (sym.definition_kind == resolve.SYM_TAG) { kind = type.TYPE_TAG; }
    if (sym.definition_file == source.FILE_NIL) {
        fail.internal(?sc.status, "generic nominal has no defining source identity");
        ret type.TYPE_ERROR;
    }
    val nominal: res[type.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, sym.canon,
        resolve.type_owner(sc.s, sym.origin, sym.definition_file), kind);
    if (sel nominal.err) {
        fail.internal(?sc.status, fail.describe(nominal.err));
        ret type.TYPE_ERROR;
    }
    ret nominal.ok;
}

fun build_instance_table(g: *GenericOp, instance: type.TypeId, gnom: type.TypeId) {
    val s:                  *session.Session      = g.s;
    val opt_instance_table: opt[*type.FieldTable] = type.field_table_for(?s.types, instance);
    if (sel opt_instance_table.some) {
        if (opt_instance_table.some.epoch == type.field_epoch(?s.types)) { ret; }
    }

    val opt_generic_table: opt[*type.FieldTable] = type.field_table_for(?s.types, gnom);
    if (!sel opt_generic_table.some) { ret; }
    val fields_len: u32 = opt_generic_table.some.fields_len;
    # fields that mention no parameter (an unused one) copy over under no owner
    val who_opt: opt[type.GenericOwner] = nominal_param_owner(g, gnom);
    var who:     type.GenericOwner;
    if (sel who_opt.some) { who = who_opt.some; }

    val opt_instance: opt[*type.Type] = type.get(?s.types, instance);
    if (!sel opt_instance.some) { ret; }
    val instance_type: *type.Type = opt_instance.some;
    if (instance_type.kind != type.TYPE_INSTANCE) { ret; }
    val args_start: u32 = instance_type.data.instance.args_start;
    val args_len:   u32 = instance_type.data.instance.args_len;

    var args: *type.TypeId = nil;
    if (args_len > 0) {
        val res_alloc_args: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, args_len::usize);
        if (sel res_alloc_args.err) {
            fail.internal(g.status, alloc.text(res_alloc_args.err));
            ret;
        }
        args = res_alloc_args.ok;

        var i: u32 = 0;
        for (i < args_len) {
            val opt_arg: opt[type.TypeId] = type.get_param(?s.types, args_start + i);
            if (!sel opt_arg.some) {
                A.deallocate[type.TypeId](s.alloc, args, args_len::usize);
                ret;
            }
            args[i] = opt_arg.some;
            i       = i + 1;
        }
    }

    if (fields_len == 0) {
        val start_r: res[u32, fail.Fail] = type.field_table_stage(?s.types, 0);
        if (sel start_r.err) { fail.internal(g.status, fail.describe(start_r.err)); }
        or (sel start_r.ok) {
            val published: err[fail.Fail] = type.field_table_publish(?s.types, instance, start_r.ok, 0);
            if (sel published.err) { fail.internal(g.status, fail.describe(published.err)); }
        }
        if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
        ret;
    }

    val res_alloc_types: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, fields_len::usize);
    if (sel res_alloc_types.err) {
        fail.internal(g.status, alloc.text(res_alloc_types.err));
        if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
        ret;
    }
    val field_types: *type.TypeId = res_alloc_types.ok;

    val res_alloc_names: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](s.alloc, fields_len::usize);
    if (sel res_alloc_names.err) {
        fail.internal(g.status, alloc.text(res_alloc_names.err));
        A.deallocate[type.TypeId](s.alloc, field_types, fields_len::usize);
        if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
        ret;
    }
    val field_names: *intern.StrId = res_alloc_names.ok;

    var i: u32 = 0;
    for (i < fields_len) {
        val opt_entry: opt[*type.FieldEntry] = type.field_at(?s.types, gnom, i);
        if (!sel opt_entry.some) {
            field_names[i] = intern.STR_NIL;
            field_types[i] = type.TYPE_ERROR;
        }
        or (sel opt_entry.some) {
            val entry: *type.FieldEntry = opt_entry.some;
            field_names[i] = entry.name;
            field_types[i] = substitute_inner(g, entry.ty, ?who, args, args_len);
        }
        i = i + 1;
    }

    val start_r: res[u32, fail.Fail] = type.field_table_stage(?s.types, fields_len);
    if (sel start_r.err) { fail.internal(g.status, fail.describe(start_r.err)); }
    or (sel start_r.ok) {
        if (!sel g.status.kind.internal) {
            val start:  u32  = start_r.ok;
            var staged: bool = true;
            i = 0;
            for (i < fields_len) {
                val pushed: err[fail.Fail] = type.field_table_stage_push(?s.types, field_names[i], field_types[i]);
                if (sel pushed.err) {
                    fail.internal(g.status, fail.describe(pushed.err));
                    staged = false;
                    brk;
                }
                i = i + 1;
            }
            if (staged) {
                val published: err[fail.Fail] = type.field_table_publish(?s.types, instance, start, fields_len);
                if (sel published.err) { fail.internal(g.status, fail.describe(published.err)); }
            }
        }
    }

    A.deallocate[intern.StrId](s.alloc, field_names, fields_len::usize);
    A.deallocate[type.TypeId](s.alloc, field_types, fields_len::usize);
    if (args_len > 0) { A.deallocate[type.TypeId](s.alloc, args, args_len::usize); }
}

fun substitute_fun(g: *GenericOp, t: *type.Type, who: *type.GenericOwner, args: *type.TypeId, arg_count: u32, original: type.TypeId) type.TypeId {
    val s:            *session.Session = g.s;
    val original_ret: type.TypeId      = t.data.fn.ret_type;
    val params_start: u32              = t.data.fn.params_start;
    val params_len:   u32              = t.data.fn.params_len;

    var changed:   bool         = false;
    var param_buf: *type.TypeId = nil;
    if (params_len > 0) {
        val res_alloc_params: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, params_len::usize);
        if (sel res_alloc_params.err) {
            fail.internal(g.status, alloc.text(res_alloc_params.err));
            ret type.TYPE_ERROR;
        }
        param_buf = res_alloc_params.ok;

        var i: u32 = 0;
        for (i < params_len) {
            val opt_param: opt[type.TypeId] = type.get_param(?s.types, params_start + i);
            if (!sel opt_param.some) {
                A.deallocate[type.TypeId](s.alloc, param_buf, params_len::usize);
                ret type.TYPE_ERROR;
            }
            val original_param: type.TypeId = opt_param.some;
            param_buf[i] = substitute_inner(g, original_param, who, args, arg_count);
            if (param_buf[i] != original_param) { changed = true; }
            i = i + 1;
        }
    }

    val new_ret: type.TypeId = substitute_inner(g, original_ret, who, args, arg_count);
    if (new_ret != original_ret) { changed = true; }

    if (!changed) {
        if (params_len > 0) { A.deallocate[type.TypeId](s.alloc, param_buf, params_len::usize); }
        ret original;
    }

    val res_fun: res[type.TypeId, fail.Fail] = type.intern_function(?s.types, new_ret, param_buf, params_len, t.data.fn.c_variadic);
    if (params_len > 0) { A.deallocate[type.TypeId](s.alloc, param_buf, params_len::usize); }
    ret unwrap_or_error(g, res_fun);
}

fun substitute_instance(g: *GenericOp, t: *type.Type, who: *type.GenericOwner, args: *type.TypeId, arg_count: u32, original: type.TypeId) type.TypeId {
    val s:          *session.Session = g.s;
    val nominal:    type.TypeId      = t.data.instance.nominal;
    val args_start: u32              = t.data.instance.args_start;
    val args_len:   u32              = t.data.instance.args_len;

    if (args_len == 0) { ret original; }

    val res_alloc_args: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](s.alloc, args_len::usize);
    if (sel res_alloc_args.err) {
        fail.internal(g.status, alloc.text(res_alloc_args.err));
        ret type.TYPE_ERROR;
    }
    val arg_buf: *type.TypeId = res_alloc_args.ok;

    var changed: bool = false;
    var i:       u32  = 0;
    for (i < args_len) {
        val opt_arg: opt[type.TypeId] = type.get_param(?s.types, args_start + i);
        if (!sel opt_arg.some) {
            A.deallocate[type.TypeId](s.alloc, arg_buf, args_len::usize);
            ret type.TYPE_ERROR;
        }
        val original_arg: type.TypeId = opt_arg.some;
        arg_buf[i] = substitute_inner(g, original_arg, who, args, arg_count);
        if (arg_buf[i] != original_arg) { changed = true; }
        i = i + 1;
    }

    if (!changed) {
        A.deallocate[type.TypeId](s.alloc, arg_buf, args_len::usize);
        ret original;
    }

    val res_instance: res[type.TypeId, fail.Fail] = type.intern_instance(?s.types, nominal, arg_buf, args_len);
    A.deallocate[type.TypeId](s.alloc, arg_buf, args_len::usize);
    ret unwrap_or_error(g, res_instance);
}

fun substitute_aggregate(g: *GenericOp, args: *type.TypeId, arg_count: u32, original: type.TypeId) type.TypeId {
    val s: *session.Session = g.s;

    val res_instance: res[type.TypeId, fail.Fail] = type.intern_instance(?s.types, original, args, arg_count);
    if (sel res_instance.err) {
        fail.internal(g.status, fail.describe(res_instance.err));
        ret type.TYPE_ERROR;
    }
    val instance: type.TypeId = res_instance.ok;

    build_instance_table(g, instance, original);
    ret instance;
}

# the declaration whose parameters a nominal's fields mention: the nominal
# itself for a named generic, the enclosing declaration for an anonymous
# aggregate declared inside one; none when the fields mention no parameter
fun nominal_param_owner(g: *GenericOp, tid: type.TypeId) opt[type.GenericOwner] {
    var w: GParamWalk;
    gparam_walk_begin(g, ?w);
    val mentioned: bool = nominal_fields_mention(g, tid, ?w);
    gparam_walk_end(g, ?w);
    if (!mentioned || !w.owned || sel g.status.kind.internal) { ret opt[type.GenericOwner].none{}; }
    ret opt[type.GenericOwner].some{w.owner};
}

fun nominal_has_gparam(g: *GenericOp, tid: type.TypeId) bool {
    val s:    *session.Session = g.s;
    val memo: type.GParamMemo  = type.gparam_memo_get(?s.types, tid);
    if (memo == type.GPARAM_YES) { ret true; }
    if (memo == type.GPARAM_NO)  { ret false; }

    var w: GParamWalk;
    gparam_walk_begin(g, ?w);
    val mentioned: bool = nominal_fields_mention(g, tid, ?w);
    val resolved:  bool = w.resolved;
    gparam_walk_end(g, ?w);

    if (resolved && !sel g.status.kind.internal) { type.gparam_memo_set(?s.types, tid, mentioned); }
    ret mentioned;
}

fun nominal_fields_mention(g: *GenericOp, tid: type.TypeId, w: *GParamWalk) bool {
    val s:      *session.Session               = g.s;
    val mark_r: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, ?w.scan, tid);
    if (sel mark_r.err) {
        fail.internal(g.status, fail.describe(mark_r.err));
        w.resolved = false;
        ret true;
    }
    val mark: type.VisitMark = mark_r.ok;
    if (mark == type.VISIT_SEEN) { ret false; }

    val opt_table: opt[*type.FieldTable] = type.field_table_for(?s.types, tid);
    if (!sel opt_table.some) {
        w.resolved = false;
        ret true;
    }
    val fields_len: u32 = opt_table.some.fields_len;

    var i: u32 = 0;
    for (i < fields_len) {
        val opt_entry: opt[*type.FieldEntry] = type.field_at(?s.types, tid, i);
        if (sel opt_entry.some) {
            if (mentions_gparam(g, opt_entry.some.ty, w)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun mentions_gparam(g: *GenericOp, tid: type.TypeId, w: *GParamWalk) bool {
    val s: *session.Session = g.s;
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }

    val opt_type: opt[*type.Type] = type.get(?s.types, tid);
    if (!sel opt_type.some) { ret false; }
    val t: *type.Type = opt_type.some;

    if (t.kind == type.TYPE_GENERIC_PARAM) {
        if (!w.owned) {
            w.owner = type.param_owner(?t.data.generic_param);
            w.owned = true;
        }
        ret true;
    }
    if (t.kind == type.TYPE_POINTER) { ret mentions_gparam(g, t.data.pointer.base, w); }
    if (t.kind == type.TYPE_SECRET)  { ret mentions_gparam(g, t.data.secret.base, w); }
    if (t.kind == type.TYPE_ARRAY)   { ret mentions_gparam(g, t.data.array.base, w); }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        ret nominal_fields_mention(g, tid, w);
    }

    if (t.kind == type.TYPE_FUN) {
        val ret_ty:       type.TypeId = t.data.fn.ret_type;
        val params_start: u32         = t.data.fn.params_start;
        val params_len:   u32         = t.data.fn.params_len;
        if (mentions_gparam(g, ret_ty, w)) { ret true; }
        var i: u32 = 0;
        for (i < params_len) {
            val p_opt: opt[type.TypeId] = type.get_param(?s.types, params_start + i);
            if (sel p_opt.some && mentions_gparam(g, p_opt.some, w)) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    if (t.kind == type.TYPE_INSTANCE) {
        val args_start: u32 = t.data.instance.args_start;
        val args_len:   u32 = t.data.instance.args_len;
        var i:          u32 = 0;
        for (i < args_len) {
            val opt_arg: opt[type.TypeId] = type.get_param(?s.types, args_start + i);
            if (sel opt_arg.some) {
                if (mentions_gparam(g, opt_arg.some, w)) { ret true; }
            }
            i = i + 1;
        }
    }
    ret false;
}

fun unwrap_or_error(g: *GenericOp, outcome: res[type.TypeId, fail.Fail]) type.TypeId {
    val s: *session.Session = g.s;
    if (sel outcome.err) {
        fail.internal(g.status, fail.describe(outcome.err));
        ret type.TYPE_ERROR;
    }
    ret outcome.ok;
}

fun report_type_arg_count(sc: *sema.SemaContext, span: token.Span, prefix: str, expected: u32, actual: u32) {
    val res_msg: res[str, format.FormatError] = format.sprint(sc.s.alloc, "{}: expected {}, found {}", prefix, expected::usize, actual::usize);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        ret;
    }
    val msg: str = res_msg.ok;
    sema.report(sc, dkind.GENERIC_ARITY, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

# each deep query answers true for a type id it cannot resolve, never false and never internal
test deep_query__unresolvable_type_fails_closed {
    var alloc:  A.Allocator;
    val made_1: err[A.Error] = page.make(?alloc);
    if (sel made_1.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;
    fin { session.dnit(?sA); }

    var bogus: [1]type.TypeId;
    bogus[0] = 500000::type.TypeId;

    val secret: res[bool, fail.Fail] = contains_secret_deep(?sA, bogus[0]);
    if (sel secret.err) { ret 2; }
    if (!secret.ok)     { ret 3; }
    val float: res[bool, fail.Fail] = contains_float_deep(?sA, bogus[0]);
    if (sel float.err) { ret 4; }
    if (!float.ok)     { ret 5; }
    val reach: res[bool, fail.Fail] = module_reaches_secret(?sA, ?bogus[0], 1);
    if (sel reach.err) { ret 6; }
    if (!reach.ok)     { ret 7; }
    ret 0;
}

test nominal_has_gparam__missing_field_table_fails_closed {
    var alloc:  A.Allocator;
    val made_4: err[A.Error] = page.make(?alloc);
    if (sel made_4.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var sA: session.Session = sr.ok;

    val rn: res[type.TypeId, fail.Fail] = type.intern_nominal(?sA.types, intern.STR_NIL, type.TypeOwner{module: 999, file: 1}, type.TYPE_REC);
    if (sel rn.err) {
        session.dnit(?sA);
        ret 1;
    }
    val nom: type.TypeId = rn.ok;

    var bad:    i32              = 0;
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = ?sA;
    op.status = ?status;
    if (!nominal_has_gparam(?op, nom)) { bad = 1; }
    if (sel status.kind.internal)      { bad = 2; }

    session.dnit(?sA);
    ret bad;
}

# #3711: substitution is keyed by the declaration whose parameters it replaces.
# a parameter of another declaration at the same index stays, a type substituted
# once reads as itself under a second pass with the same owner, and an anonymous
# aggregate is instantiated by the declaration that encloses it only
test substitute__replaces_only_the_owners_parameters {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    val at: type.TypeOwner = type.TypeOwner{module: 3, file: 1};
    # fun callee[T] (name 10) and fun caller[U, W] (name 11)
    var callee: type.GenericOwner           = type.GenericOwner{owner: at, name: 10::intern.StrId, kind: type.TYPE_FUN};
    var caller: type.GenericOwner           = type.GenericOwner{owner: at, name: 11::intern.StrId, kind: type.TYPE_FUN};
    val t_r:    res[type.TypeId, fail.Fail] = type.intern_generic_param(?s.types, 1::intern.StrId, at, 10::intern.StrId, type.TYPE_FUN, 0);
    if (sel t_r.err) { ret 2; }
    val t:   type.TypeId                 = t_r.ok;
    val u_r: res[type.TypeId, fail.Fail] = type.intern_generic_param(?s.types, 2::intern.StrId, at, 11::intern.StrId, type.TYPE_FUN, 0);
    if (sel u_r.err) { ret 2; }
    val u:   type.TypeId                 = u_r.ok;
    val w_r: res[type.TypeId, fail.Fail] = type.intern_generic_param(?s.types, 3::intern.StrId, at, 11::intern.StrId, type.TYPE_FUN, 1);
    if (sel w_r.err) { ret 2; }
    val w:     type.TypeId      = w_r.ok;
    val u32_o: opt[type.TypeId] = type.prim(?s.types, type.TYPE_U32);
    if (!sel u32_o.some) { ret 3; }
    val i64_o: opt[type.TypeId] = type.prim(?s.types, type.TYPE_I64);
    if (!sel i64_o.some) { ret 3; }
    val t_u32: type.TypeId = u32_o.some;
    val t_i64: type.TypeId = i64_o.some;

    # the open instance callee[caller.W]: callee.T (index 0) becomes caller.W, and
    # caller.U (also index 0) is not the callee's, so it is left as it is
    var w_args: [1]type.TypeId              = [1]type.TypeId{w};
    val once:   res[type.TypeId, fail.Fail] = substitute(?s, t, ?callee, ?w_args[0], 1);
    if (sel once.err) { ret 5; }
    if (once.ok != w) { ret 5; }
    val foreign: res[type.TypeId, fail.Fail] = substitute(?s, u, ?callee, ?w_args[0], 1);
    if (sel foreign.err) { ret 6; }
    if (foreign.ok != u) { ret 6; }
    # a second pass with the callee's arguments over the substituted type is the identity
    val twice: res[type.TypeId, fail.Fail] = substitute(?s, w, ?callee, ?w_args[0], 1);
    if (sel twice.err) { ret 7; }
    if (twice.ok != w) { ret 7; }
    # and the caller's own instantiation resolves caller.W by the caller's position
    var c_args: [2]type.TypeId              = [2]type.TypeId{t_u32, t_i64};
    val closed: res[type.TypeId, fail.Fail] = substitute(?s, w, ?caller, ?c_args[0], 2);
    if (sel closed.err)     { ret 8; }
    if (closed.ok != t_i64) { ret 8; }

    # an anonymous aggregate `uni { a: U; }` declared inside caller: its
    # parameters are caller's, so callee's arguments leave it alone and
    # caller's instantiate it
    val anon_r: res[type.TypeId, fail.Fail] = type.intern_nominal(?s.types, intern.STR_NIL, at, type.TYPE_UNI);
    if (sel anon_r.err) { ret 9; }
    val anon:   type.TypeId         = anon_r.ok;
    val staged: res[u32, fail.Fail] = type.field_table_stage(?s.types, 1);
    if (sel staged.err) { ret 9; }
    val pushed: err[fail.Fail] = type.field_table_stage_push(?s.types, 1::intern.StrId, u);
    if (sel pushed.err) { ret 9; }
    val published: err[fail.Fail] = type.field_table_publish(?s.types, anon, staged.ok, 1);
    if (sel published.err) { ret 9; }
    val by_callee: res[type.TypeId, fail.Fail] = substitute(?s, anon, ?callee, ?w_args[0], 1);
    if (sel by_callee.err)    { ret 10; }
    if (by_callee.ok != anon) { ret 10; }
    val by_caller: res[type.TypeId, fail.Fail] = substitute(?s, anon, ?caller, ?c_args[0], 2);
    if (sel by_caller.err) { ret 11; }
    val inst_o: opt[*type.Type] = type.get(?s.types, by_caller.ok);
    if (!sel inst_o.some)                                                                    { ret 11; }
    if (inst_o.some.kind != type.TYPE_INSTANCE || inst_o.some.data.instance.nominal != anon) { ret 11; }
    val fe: opt[*type.FieldEntry] = type.field_at(?s.types, by_caller.ok, 0);
    if (!sel fe.some)        { ret 12; }
    if (fe.some.ty != t_u32) { ret 12; }

    ret 0;
}

rec GenericOp {
    s:      *session.Session;
    status: *fail.PhaseStatus;
}

# replace `who`'s parameters in `body_type` with `args`, position for position;
# a parameter of any other declaration (an enclosing generic's, in an open
# instance) stays, so a substituted type reads as the identity under a second pass
pub fun substitute(s: *session.Session, body_type: type.TypeId, who: *type.GenericOwner, args: *type.TypeId, arg_count: u32) res[type.TypeId, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    val value: type.TypeId = substitute_inner(?op, body_type, who, args, arg_count);
    if (sel status.kind.internal) { ret res[type.TypeId, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[type.TypeId, fail.Fail].ok{value};
}

pub fun ensure_fields(s: *session.Session, tid: type.TypeId) err[fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    ensure_fields_inner(?op, tid);
    if (sel status.kind.internal) { ret err[fail.Fail].err{fail.message(status.kind.internal)}; }
    ret err[fail.Fail].ok{};
}

pub fun contains_secret_deep(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    val value: bool = contains_secret_deep_inner(?op, tid);
    if (sel status.kind.internal) { ret res[bool, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[bool, fail.Fail].ok{value};
}

pub fun contains_float_deep(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    val value: bool = contains_float_deep_inner(?op, tid);
    if (sel status.kind.internal) { ret res[bool, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[bool, fail.Fail].ok{value};
}

pub fun type_extent(s: *session.Session, m: layout.Machine, tid: type.TypeId) res[layout.Extent, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    val value: layout.Extent = type_extent_inner(?op, m, tid);
    if (sel status.kind.internal) { ret res[layout.Extent, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[layout.Extent, fail.Fail].ok{value};
}

# the byte offset of a record field or tag payload from the same checked layout that sizes the type;
# `size` carries the offset when `ok`
pub fun type_field_offset(s: *session.Session, m: layout.Machine, tid: type.TypeId, field_ix: u32) res[layout.Extent, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    val base:  type.TypeId   = type.strip_secret(?s.types, tid);
    val value: layout.Extent = layout.field_offset_of[GenericOp](?op, describe_type, describe_type_field, base::u32, field_ix, m,
        SEMA_LAYOUT_MAX_DEPTH);
    if (sel status.kind.internal) { ret res[layout.Extent, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[layout.Extent, fail.Fail].ok{value};
}

# whether a `::` or `:~` from `from` to `to` keeps every byte's secrecy class
pub fun secrecy_cast_allowed(s: *session.Session, m: layout.Machine, from: type.TypeId, to: type.TypeId) res[Agreement, fail.Fail] {
    var status:    fail.PhaseStatus = fail.accepted();
    var op:        GenericOp;
    var unbounded: bool             = false;
    op.s      = s;
    op.status = ?status;
    val value: bool = secrecy_cast_allowed_inner(?op, m, from, to, ?unbounded);
    if (sel status.kind.internal) { ret res[Agreement, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[Agreement, fail.Fail].ok{agreement_of(value, unbounded)};
}

# whether two union variants overlaying one storage agree on every byte they share
pub fun secrecy_overlay_agrees(s: *session.Session, m: layout.Machine, a: type.TypeId, b: type.TypeId) res[Agreement, fail.Fail] {
    var status:    fail.PhaseStatus = fail.accepted();
    var op:        GenericOp;
    var unbounded: bool             = false;
    op.s      = s;
    op.status = ?status;
    val value: bool = secrecy_overlay_agrees_inner(?op, m, a, b, ?unbounded);
    if (sel status.kind.internal) { ret res[Agreement, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[Agreement, fail.Fail].ok{agreement_of(value, unbounded)};
}

pub val UNBOUNDED_VARIANTS_MSG: str = "union variants: cannot prove that overlapping fields agree on secrecy - they point into a generic whose argument grows through a pointer, which has unboundedly many instances, so the storage below the pointers cannot be compared";
pub val UNBOUNDED_CAST_MSG:     str = "cast: cannot prove that the two types agree on secrecy - they point into a generic whose argument grows through a pointer, which has unboundedly many instances, so the storage below the pointers cannot be compared";

pub fun module_reaches_secret(s: *session.Session, resolved: *type.TypeId, len: u32) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    val value: bool = module_reaches_secret_inner(?op, resolved, len);
    if (sel status.kind.internal) { ret res[bool, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[bool, fail.Fail].ok{value};
}

fun tag_value_walk(g: *GenericOp, tid: type.TypeId, scan: *type.TypeScan) bool {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }
    val s:    *session.Session = g.s;
    val base: type.TypeId      = type.strip_secret(?s.types, tid);
    if (type.is_tag(?s.types, base)) { ret true; }
    val found: opt[*type.Type] = type.get(?s.types, base);
    if (!sel found.some) {
        fail.internal(g.status, "tag containment received an invalid type");
        ret false;
    }
    val t: *type.Type = found.some;
    if (t.kind == type.TYPE_ARRAY)                                                          { ret tag_value_walk(g, t.data.array.base, scan); }
    if (t.kind != type.TYPE_REC && t.kind != type.TYPE_UNI && t.kind != type.TYPE_INSTANCE) { ret false; }
    val marked: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, scan, base);
    if (sel marked.err) {
        fail.internal(g.status, fail.describe(marked.err));
        ret false;
    }
    if (marked.ok == type.VISIT_SEEN) { ret false; }
    if (t.kind == type.TYPE_INSTANCE) { ensure_fields_inner(g, base); }
    val table: opt[*type.FieldTable] = type.field_table_for(?s.types, base);
    if (!sel table.some) {
        fail.internal(g.status, "tag containment requires a complete nominal recipe");
        ret false;
    }
    var i: u32 = 0;
    for (i < table.some.fields_len) {
        val field: opt[*type.FieldEntry] = type.field_at(?s.types, base, i);
        if (!sel field.some) {
            fail.internal(g.status, "tag containment encountered an incomplete member table");
            ret false;
        }
        if (tag_value_walk(g, field.some.ty, scan)) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun contains_tag_value(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    var scan:   type.TypeScan;
    val opened: err[fail.Fail] = type.type_scan_begin(?s.types, ?scan);
    if (sel opened.err) { ret res[bool, fail.Fail].err{opened.err}; }
    fin { type.type_scan_end(?s.types, ?scan); }
    val found: bool = tag_value_walk(?op, tid, ?scan);
    if (sel status.kind.internal) { ret res[bool, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[bool, fail.Fail].ok{found};
}

test kind_is_public_leaf__partition_typekind {
    val leaves: [15]type.TypeKind = [15]type.TypeKind{type.TYPE_U8, type.TYPE_U16, type.TYPE_U32, type.TYPE_U64,
        type.TYPE_I8, type.TYPE_I16, type.TYPE_I32, type.TYPE_I64, type.TYPE_F32, type.TYPE_F64, type.TYPE_PTR,
        type.TYPE_VECTOR, type.TYPE_HANDLE, type.TYPE_ABI, type.TYPE_GENERIC_PARAM};
    val descended: [10]type.TypeKind = [10]type.TypeKind{type.TYPE_POINTER, type.TYPE_ARRAY, type.TYPE_FUN,
        type.TYPE_REC, type.TYPE_UNI, type.TYPE_INSTANCE, type.TYPE_PACK, type.TYPE_SECRET, type.TYPE_TAG,
        type.TYPE_CASE_SELECTOR};
    var i: usize = 0;
    for (i < 15) {
        if (!kind_is_public_leaf(leaves[i])) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 10) {
        if (kind_is_public_leaf(descended[i])) { ret 2; }
        i = i + 1;
    }
    ret 0;
}

# the instantiation graph over declarations: a node is one parameter of one
# generic, and an edge says that parameter flows into an argument of a generic
# its fields mention. An edge grows when the argument wraps the parameter
# (`L[*T]` in `L[T]`) rather than being it, `^T` included as the parameter
# itself since `^` is idempotent. A cycle with a growing edge mints a fresh
# instance at every trip, so its generics have unboundedly many instances
rec ExpEdge {
    from:  u32;
    to:    u32;
    grows: bool;
}

rec ExpGraph {
    g:     *GenericOp;
    key:   map.Map[u64, u32];
    nodes: Vector[type.TypeId];
    edges: Vector[ExpEdge];
    # the generics whose fields the graph holds, in the order they were met
    found: map.Map[type.TypeId, bool];
    work:  Vector[type.TypeId];
    occ:   Vector[u32];
    # a generic met had no field table, so its edges are unknown
    incomplete: bool;
}

fun exp_init(g: *GenericOp) ExpGraph {
    val s: *session.Session = g.s;
    var x: ExpGraph;
    x.g          = g;
    x.key        = map.init[u64, u32](s.types.a);
    x.nodes      = vector.init[type.TypeId](s.types.a);
    x.edges      = vector.init[ExpEdge](s.types.a);
    x.found      = map.init[type.TypeId, bool](s.types.a);
    x.work       = vector.init[type.TypeId](s.types.a);
    x.occ        = vector.init[u32](s.types.a);
    x.incomplete = false;
    ret x;
}

fun exp_dnit(x: *ExpGraph) {
    map.dnit[u64, u32](?x.key);
    vector.dnit[type.TypeId](?x.nodes);
    vector.dnit[ExpEdge](?x.edges);
    map.dnit[type.TypeId, bool](?x.found);
    vector.dnit[type.TypeId](?x.work);
    vector.dnit[u32](?x.occ);
}

fun exp_enqueue(x: *ExpGraph, body: type.TypeId) {
    val seen: opt[*bool] = map.get[type.TypeId, bool](?x.found, ?body);
    if (sel seen.some) { ret; }
    val put: res[bool, A.Error] = map.insert[type.TypeId, bool](?x.found, body, true);
    if (sel put.err) {
        fail.internal(x.g.status, alloc.text(put.err));
        ret;
    }
    val pushed: res[usize, A.Error] = vector.push[type.TypeId](?x.work, body);
    if (sel pushed.err) { fail.internal(x.g.status, alloc.text(pushed.err)); }
}

fun exp_node(x: *ExpGraph, nominal: type.TypeId, param: u32) u32 {
    val k:    u64       = (nominal::u64 << 32) | param::u64;
    val have: opt[*u32] = map.get[u64, u32](?x.key, ?k);
    if (sel have.some) { ret @have.some; }
    val ix:     u32                 = x.nodes.len::u32;
    val pushed: res[usize, A.Error] = vector.push[type.TypeId](?x.nodes, nominal);
    if (sel pushed.err) {
        fail.internal(x.g.status, alloc.text(pushed.err));
        ret DEEP_NONE;
    }
    val put: res[bool, A.Error] = map.insert[u64, u32](?x.key, k, ix);
    if (sel put.err) {
        fail.internal(x.g.status, alloc.text(put.err));
        ret DEEP_NONE;
    }
    ret ix;
}

# the parameters of `owner` that `tid` mentions, appended to x.occ
fun exp_occurrences(x: *ExpGraph, tid: type.TypeId, owner: *type.GenericOwner, scan: *type.TypeScan) {
    val s:        *session.Session = x.g.s;
    val opt_type: opt[*type.Type]  = type.get(?s.types, tid);
    if (!sel opt_type.some) { ret; }
    val t: *type.Type = opt_type.some;

    if (t.kind == type.TYPE_GENERIC_PARAM) {
        if (type.param_owned_by(?t.data.generic_param, owner)) {
            val pushed: res[usize, A.Error] = vector.push[u32](?x.occ, t.data.generic_param.index);
            if (sel pushed.err) { fail.internal(x.g.status, alloc.text(pushed.err)); }
        }
        ret;
    }
    if (t.kind == type.TYPE_POINTER) {
        exp_occurrences(x, t.data.pointer.base, owner, scan);
        ret;
    }
    if (t.kind == type.TYPE_ARRAY) {
        exp_occurrences(x, t.data.array.base, owner, scan);
        ret;
    }
    if (t.kind == type.TYPE_SECRET) {
        exp_occurrences(x, t.data.secret.base, owner, scan);
        ret;
    }
    if (t.kind == type.TYPE_FUN) {
        exp_occurrences(x, t.data.fn.ret_type, owner, scan);
        var pi: u32 = 0;
        for (pi < t.data.fn.params_len) {
            val pp: opt[type.TypeId] = type.get_param(?s.types, t.data.fn.params_start + pi);
            if (sel pp.some) { exp_occurrences(x, pp.some, owner, scan); }
            pi = pi + 1;
        }
        ret;
    }
    if (t.kind == type.TYPE_INSTANCE) {
        var i: u32 = 0;
        for (i < t.data.instance.args_len) {
            val arg: opt[type.TypeId] = type.get_param(?s.types, t.data.instance.args_start + i);
            if (sel arg.some) { exp_occurrences(x, arg.some, owner, scan); }
            i = i + 1;
        }
        ret;
    }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        if (!exp_same_owner(x, tid, owner, scan)) { ret; }
        val table: opt[*type.FieldTable] = type.field_table_for(?s.types, tid);
        if (!sel table.some) { ret; }
        var f: u32 = 0;
        for (f < table.some.fields_len) {
            val entry: opt[*type.FieldEntry] = type.field_at(?s.types, tid, f);
            if (sel entry.some) { exp_occurrences(x, entry.some.ty, owner, scan); }
            f = f + 1;
        }
    }
}

# an anonymous aggregate of `owner`'s body, first seen by this scan
fun exp_same_owner(x: *ExpGraph, tid: type.TypeId, owner: *type.GenericOwner, scan: *type.TypeScan) bool {
    val s: *session.Session = x.g.s;
    if (!nominal_has_gparam(x.g, tid)) { ret false; }
    val of: opt[type.GenericOwner] = nominal_param_owner(x.g, tid);
    if (!sel of.some) { ret false; }
    var who: type.GenericOwner = of.some;
    if (!type.generic_owner_equals(?who, owner)) { ret false; }
    val mark: res[type.VisitMark, fail.Fail] = type.type_scan_mark(?s.types, scan, tid);
    if (sel mark.err) {
        fail.internal(x.g.status, fail.describe(mark.err));
        ret false;
    }
    ret mark.ok == type.VISIT_FRESH;
}

# whether `arg` is parameter `param` of `owner` itself, a `^` around it included
fun exp_is_param(x: *ExpGraph, arg: type.TypeId, owner: *type.GenericOwner, param: u32) bool {
    val s: *session.Session = x.g.s;
    val t: opt[*type.Type]  = type.get(?s.types, type.strip_secret(?s.types, arg));
    if (!sel t.some)                              { ret false; }
    if (t.some.kind != type.TYPE_GENERIC_PARAM)   { ret false; }
    if (t.some.data.generic_param.index != param) { ret false; }
    ret type.param_owned_by(?t.some.data.generic_param, owner);
}

# the edges out of `body`'s parameters that `tid`, part of its fields, adds
fun exp_edges(x: *ExpGraph, body: type.TypeId, tid: type.TypeId, owner: *type.GenericOwner, scan: *type.TypeScan) {
    val s: *session.Session = x.g.s;
    if (sel x.g.status.kind.internal) { ret; }
    val opt_type: opt[*type.Type] = type.get(?s.types, tid);
    if (!sel opt_type.some) { ret; }
    val t: *type.Type = opt_type.some;

    if (t.kind == type.TYPE_POINTER) {
        exp_edges(x, body, t.data.pointer.base, owner, scan);
        ret;
    }
    if (t.kind == type.TYPE_ARRAY) {
        exp_edges(x, body, t.data.array.base, owner, scan);
        ret;
    }
    if (t.kind == type.TYPE_SECRET) {
        exp_edges(x, body, t.data.secret.base, owner, scan);
        ret;
    }
    if (t.kind == type.TYPE_FUN) {
        exp_edges(x, body, t.data.fn.ret_type, owner, scan);
        var pi: u32 = 0;
        for (pi < t.data.fn.params_len) {
            val pp: opt[type.TypeId] = type.get_param(?s.types, t.data.fn.params_start + pi);
            if (sel pp.some) { exp_edges(x, body, pp.some, owner, scan); }
            pi = pi + 1;
        }
        ret;
    }
    if (t.kind == type.TYPE_INSTANCE) {
        val target: type.TypeId = t.data.instance.nominal;
        var j:      u32         = 0;
        for (j < t.data.instance.args_len) {
            val arg: opt[type.TypeId] = type.get_param(?s.types, t.data.instance.args_start + j);
            if (sel arg.some) {
                vector.clear[u32](?x.occ);
                var inner:  type.TypeScan;
                val opened: err[fail.Fail] = type.type_scan_begin(?s.types, ?inner);
                if (sel opened.err) {
                    fail.internal(x.g.status, fail.describe(opened.err));
                    ret;
                }
                exp_occurrences(x, arg.some, owner, ?inner);
                type.type_scan_end(?s.types, ?inner);
                var k: usize = 0;
                for (k < x.occ.len) {
                    val param: u32 = x.occ.data[k];
                    var edge:  ExpEdge;
                    edge.from  = exp_node(x, body, param);
                    edge.to    = exp_node(x, target, j);
                    edge.grows = !exp_is_param(x, arg.some, owner, param);
                    if (edge.from == DEEP_NONE || edge.to == DEEP_NONE) { ret; }
                    val pushed: res[usize, A.Error] = vector.push[ExpEdge](?x.edges, edge);
                    if (sel pushed.err) {
                        fail.internal(x.g.status, alloc.text(pushed.err));
                        ret;
                    }
                    exp_enqueue(x, target);
                    k = k + 1;
                }
                exp_edges(x, body, arg.some, owner, scan);
            }
            j = j + 1;
        }
        ret;
    }
    if (t.kind == type.TYPE_REC || t.kind == type.TYPE_UNI || t.kind == type.TYPE_TAG) {
        if (!exp_same_owner(x, tid, owner, scan)) { ret; }
        exp_fields(x, body, tid, owner, scan);
    }
}

fun exp_fields(x: *ExpGraph, body: type.TypeId, nominal: type.TypeId, owner: *type.GenericOwner, scan: *type.TypeScan) {
    val s:     *session.Session      = x.g.s;
    val table: opt[*type.FieldTable] = type.field_table_for(?s.types, nominal);
    if (!sel table.some) {
        x.incomplete = true;
        ret;
    }
    var f: u32 = 0;
    for (f < table.some.fields_len) {
        val entry: opt[*type.FieldEntry] = type.field_at(?s.types, nominal, f);
        if (sel entry.some) { exp_edges(x, body, entry.some.ty, owner, scan); }
        f = f + 1;
    }
}

fun exp_push(x: *ExpGraph, v: *Vector[u32], value: u32) bool {
    val pushed: res[usize, A.Error] = vector.push[u32](v, value);
    if (sel pushed.err) {
        fail.internal(x.g.status, alloc.text(pushed.err));
        ret false;
    }
    ret true;
}

fun exp_push_flag(x: *ExpGraph, v: *Vector[bool]) bool {
    val pushed: res[usize, A.Error] = vector.push[bool](v, false);
    if (sel pushed.err) {
        fail.internal(x.g.status, alloc.text(pushed.err));
        ret false;
    }
    ret true;
}

# Tarjan's strongly connected components, iteratively; `comp` gets each node's
# component and the result is the component count
fun exp_components(x: *ExpGraph, comp: *u32) u32 {
    val s: *session.Session = x.g.s;
    val n: u32              = x.nodes.len::u32;
    val e: u32              = x.edges.len::u32;

    var start: Vector[u32]  = vector.init[u32](s.types.a);
    var adj:   Vector[u32]  = vector.init[u32](s.types.a);
    var order: Vector[u32]  = vector.init[u32](s.types.a);
    var low:   Vector[u32]  = vector.init[u32](s.types.a);
    var stack: Vector[u32]  = vector.init[u32](s.types.a);
    var calls: Vector[u32]  = vector.init[u32](s.types.a);
    var curs:  Vector[u32]  = vector.init[u32](s.types.a);
    var on:    Vector[bool] = vector.init[bool](s.types.a);
    fin {
        vector.dnit[u32](?start);
        vector.dnit[u32](?adj);
        vector.dnit[u32](?order);
        vector.dnit[u32](?low);
        vector.dnit[u32](?stack);
        vector.dnit[u32](?calls);
        vector.dnit[u32](?curs);
        vector.dnit[bool](?on);
    }

    var i: u32 = 0;
    for (i <= n) {
        if (!exp_push(x, ?start, 0)) { ret 0; }
        i = i + 1;
    }
    i = 0;
    for (i < e) {
        start.data[x.edges.data[i].from + 1] = start.data[x.edges.data[i].from + 1] + 1;
        if (!exp_push(x, ?adj, 0)) { ret 0; }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        start.data[i + 1] = start.data[i + 1] + start.data[i];
        if (!exp_push(x, ?order, DEEP_NONE)) { ret 0; }
        if (!exp_push(x, ?low, 0))           { ret 0; }
        if (!exp_push(x, ?curs, 0))          { ret 0; }
        if (!exp_push_flag(x, ?on))          { ret 0; }
        comp[i] = DEEP_NONE;
        i       = i + 1;
    }
    i = 0;
    for (i < e) {
        val from: u32 = x.edges.data[i].from;
        adj.data[start.data[from] + curs.data[from]] = x.edges.data[i].to;
        curs.data[from]                              = curs.data[from] + 1;
        i                                            = i + 1;
    }

    var counter: u32 = 0;
    var comps:   u32 = 0;
    var root:    u32 = 0;
    for (root < n) {
        if (order.data[root] != DEEP_NONE) {
            root = root + 1;
            cnt;
        }
        order.data[root] = counter;
        low.data[root]   = counter;
        counter          = counter + 1;
        curs.data[root]  = start.data[root];
        on.data[root]    = true;
        if (!exp_push(x, ?stack, root)) { ret 0; }
        if (!exp_push(x, ?calls, root)) { ret 0; }

        for (calls.len > 0) {
            val v: u32 = calls.data[calls.len - 1];
            if (curs.data[v] < start.data[v + 1]) {
                val w: u32 = adj.data[curs.data[v]];
                curs.data[v] = curs.data[v] + 1;
                if (order.data[w] == DEEP_NONE) {
                    order.data[w] = counter;
                    low.data[w]   = counter;
                    counter       = counter + 1;
                    curs.data[w]  = start.data[w];
                    on.data[w]    = true;
                    if (!exp_push(x, ?stack, w)) { ret 0; }
                    if (!exp_push(x, ?calls, w)) { ret 0; }
                }
                or (on.data[w] && order.data[w] < low.data[v]) {
                    low.data[v] = order.data[w];
                }
                cnt;
            }
            calls.len = calls.len - 1;
            if (calls.len > 0) {
                val p: u32 = calls.data[calls.len - 1];
                if (low.data[v] < low.data[p]) { low.data[p] = low.data[v]; }
            }
            if (low.data[v] == order.data[v]) {
                for (true) {
                    stack.len = stack.len - 1;
                    val m: u32 = stack.data[stack.len];
                    on.data[m] = false;
                    comp[m]    = comps;
                    if (m == v) { brk; }
                }
                comps = comps + 1;
            }
        }
        root = root + 1;
    }
    ret comps;
}

# walks every queued generic's fields, queueing what they flow into, then
# decides each one met: expansive when one of its parameters sits in a
# component holding a growing edge. A component is closed under the walk, so
# each decision is exact; the queue order makes the graph deterministic
fun exp_analyze(x: *ExpGraph, decided: *Vector[type.TypeId], expansive: *Vector[bool]) {
    val g: *GenericOp       = x.g;
    val s: *session.Session = g.s;

    var next: usize = 0;
    for (next < x.work.len) {
        val body: type.TypeId            = x.work.data[next];
        val of:   opt[type.GenericOwner] = nominal_param_owner(g, body);
        if (sel of.some) {
            var owner:  type.GenericOwner = of.some;
            var scan:   type.TypeScan;
            val opened: err[fail.Fail]    = type.type_scan_begin(?s.types, ?scan);
            if (sel opened.err) {
                fail.internal(g.status, fail.describe(opened.err));
                ret;
            }
            exp_fields(x, body, body, ?owner, ?scan);
            type.type_scan_end(?s.types, ?scan);
        }
        or {
            val table: opt[*type.FieldTable] = type.field_table_for(?s.types, body);
            if (sel table.none) { x.incomplete = true; }
        }
        if (sel g.status.kind.internal) { ret; }
        next = next + 1;
    }

    val n:        u32          = x.nodes.len::u32;
    var grows_of: Vector[bool] = vector.init[bool](s.types.a);
    var comp_of:  Vector[u32]  = vector.init[u32](s.types.a);
    fin {
        vector.dnit[bool](?grows_of);
        vector.dnit[u32](?comp_of);
    }
    var v: u32 = 0;
    for (v < n) {
        if (!exp_push(x, ?comp_of, DEEP_NONE)) { ret; }
        v = v + 1;
    }
    var comps: u32 = 0;
    if (n > 0)                      { comps = exp_components(x, comp_of.data); }
    if (sel g.status.kind.internal) { ret; }
    var c: u32 = 0;
    for (c < comps) {
        if (!exp_push_flag(x, ?grows_of)) { ret; }
        c = c + 1;
    }
    var i: usize = 0;
    for (i < x.edges.len) {
        val edge: *ExpEdge = ?x.edges.data[i];
        if (edge.grows && comp_of.data[edge.from] == comp_of.data[edge.to]) { grows_of.data[comp_of.data[edge.from]] = true; }
        i = i + 1;
    }

    var b: usize = 0;
    for (b < x.work.len) {
        val pushed: res[usize, A.Error] = vector.push[type.TypeId](decided, x.work.data[b]);
        if (sel pushed.err) {
            fail.internal(g.status, alloc.text(pushed.err));
            ret;
        }
        val flagged: res[usize, A.Error] = vector.push[bool](expansive, false);
        if (sel flagged.err) {
            fail.internal(g.status, alloc.text(flagged.err));
            ret;
        }
        b = b + 1;
    }
    var w: u32 = 0;
    for (w < n) {
        if (grows_of.data[comp_of.data[w]]) {
            var d: usize = 0;
            for (d < decided.len) {
                if (decided.data[d] == x.nodes.data[w]) { expansive.data[d] = true; }
                d = d + 1;
            }
        }
        w = w + 1;
    }
}

fun exp_record(g: *GenericOp, decided: *Vector[type.TypeId], expansive: *Vector[bool]) {
    val s: *session.Session = g.s;
    var d: usize            = 0;
    for (d < decided.len) {
        val put: err[fail.Fail] = type.expansive_decide(?s.types, decided.data[d], expansive.data[d]);
        if (sel put.err) {
            fail.internal(g.status, fail.describe(put.err));
            ret;
        }
        d = d + 1;
    }
}

# whether generic nominal `nominal` lies on an instantiation cycle that grows an
# argument, so it has unboundedly many instances; true when that cannot be shown
# either way
fun nominal_expansive(g: *GenericOp, nominal: type.TypeId) bool {
    val s:     *session.Session = g.s;
    val prior: opt[bool]        = type.expansive_decided(?s.types, nominal);
    if (sel prior.some) { ret prior.some; }

    var x:         ExpGraph            = exp_init(g);
    var decided:   Vector[type.TypeId] = vector.init[type.TypeId](s.types.a);
    var expansive: Vector[bool]        = vector.init[bool](s.types.a);
    fin {
        exp_dnit(?x);
        vector.dnit[type.TypeId](?decided);
        vector.dnit[bool](?expansive);
    }
    exp_enqueue(?x, nominal);
    exp_analyze(?x, ?decided, ?expansive);
    if (sel g.status.kind.internal) { ret true; }
    if (x.incomplete)               { ret true; }
    exp_record(g, ?decided, ?expansive);
    val now: opt[bool] = type.expansive_decided(?s.types, nominal);
    if (sel now.some) { ret now.some; }
    ret true;
}

fun mark_expansive_inner(g: *GenericOp) {
    val s:         *session.Session    = g.s;
    var x:         ExpGraph            = exp_init(g);
    var decided:   Vector[type.TypeId] = vector.init[type.TypeId](s.types.a);
    var expansive: Vector[bool]        = vector.init[bool](s.types.a);
    fin {
        exp_dnit(?x);
        vector.dnit[type.TypeId](?decided);
        vector.dnit[bool](?expansive);
    }
    # every generic mention is an interned instance, so the instances name every
    # generic whose instances could grow
    val count: u32 = type.type_count(?s.types);
    var tid:   u32 = 0;
    for (tid < count) {
        val t:    opt[*type.Type] = type.get(?s.types, tid::type.TypeId);
        var body: type.TypeId     = type.TYPE_NIL;
        if (sel t.some) {
            if (t.some.kind == type.TYPE_INSTANCE) { body = t.some.data.instance.nominal; }
        }
        if (body != type.TYPE_NIL) {
            val prior: opt[bool] = type.expansive_decided(?s.types, body);
            if (sel prior.none) { exp_enqueue(?x, body); }
        }
        if (sel g.status.kind.internal) { ret; }
        tid = tid + 1;
    }
    exp_analyze(?x, ?decided, ?expansive);
    if (sel g.status.kind.internal) { ret; }
    exp_record(g, ?decided, ?expansive);
    if (sel g.status.kind.internal) { ret; }
    type.expansive_sweep_done(?s.types);
}

# whether `tid` holds, by value, an instance of a generic whose argument grows
# through a pointer, so its instances are unbounded
pub fun holds_expansive_instance(s: *session.Session, tid: type.TypeId) res[bool, fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    var scan:   type.TypeScan;
    val opened: err[fail.Fail] = type.type_scan_begin(?s.types, ?scan);
    if (sel opened.err) { ret res[bool, fail.Fail].err{opened.err}; }
    val holds: bool = holds_expansive(?op, tid, ?scan);
    type.type_scan_end(?s.types, ?scan);
    if (sel status.kind.internal) { ret res[bool, fail.Fail].err{fail.message(status.kind.internal)}; }
    ret res[bool, fail.Fail].ok{holds};
}

# decides every generic the program instantiates (see ExpGraph) and records the
# decisions on the type store, for a consumer that follows pointers to cut at
# the expansive ones
pub fun mark_expansive(s: *session.Session) err[fail.Fail] {
    var status: fail.PhaseStatus = fail.accepted();
    var op:     GenericOp;
    op.s      = s;
    op.status = ?status;
    mark_expansive_inner(?op);
    if (sel status.kind.internal) { ret err[fail.Fail].err{fail.message(status.kind.internal)}; }
    ret err[fail.Fail].ok{};
}
