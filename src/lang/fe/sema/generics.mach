# the instantiation of a generic the sema context names, and the checks each instance owes
# its type annotations
use diagnostic_kind: mach.lang.diagnostic.kind;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mach.lang.fail;
use ast_id: mach.lang.fe.ast.id;
use mach.lang.fe.resolve;
use sema_context: mach.lang.fe.sema.context;
use sema_handle:  mach.lang.fe.sema.handle;
use mach.lang.fe.sema.variant;
use lang_phase:  mach.lang.phase;
use lang_source: mach.lang.source;
use mach.lang.type;
use type_kind: mach.lang.type.kind;

pub fun instantiate(
    sc: *sema_context.SemaContext,
    sym: *resolve.Symbol,
    args: *type_kind.TypeId,
    arg_count: u32,
    span: lang_source.Span) res[type_kind.TypeId, fail.Fail] {
    if (sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema_context.report(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "not a generic: declaration is not generic");
        ret res[type_kind.TypeId, fail.Fail].ok{type_kind.TYPE_ERROR};
    }

    if (!check_arity(sc, sym, arg_count, span)) {
        ret res[type_kind.TypeId, fail.Fail].ok{type_kind.TYPE_ERROR};
    }

    var i: u32 = 0;
    for (i < arg_count) {
        if (type_kind.is_nil(args[i]) || type_kind.is_error(args[i])) {
            sema_context.reportf(sc, diagnostic_kind.GENERIC_ARGUMENT, span, "generic argument {} is not a valid type", (i + 1)::usize);
            ret res[type_kind.TypeId, fail.Fail].ok{type_kind.TYPE_ERROR};
        }
        i = i + 1;
    }

    val gnom: type_kind.TypeId = nominal_of(sc, sym);
    if (sel sc.status.kind.internal) { ret res[type_kind.TypeId, fail.Fail].err{sc.status.kind.internal}; }
    ret type.intern_instance(?sc.s.types, gnom, args, arg_count);
}

pub fun check_arity(
    sc: *sema_context.SemaContext,
    sym: *resolve.Symbol,
    arg_count: u32,
    span: lang_source.Span) bool {
    if (sym.definition_kind != resolve.SYM_FUN && sym.definition_kind != resolve.SYM_REC && sym.definition_kind != resolve.SYM_UNI && sym.definition_kind != resolve.SYM_TAG) {
        sema_context.report(sc, diagnostic_kind.GENERIC_NOT_GENERIC, span, "not a generic: declaration takes no type parameters");
        ret false;
    }
    val want: u32 = sym.generic_arity;
    if (arg_count != want) {
        report_type_arg_count(sc, span, "wrong number of type arguments", want, arg_count);
        ret false;
    }
    ret true;
}

# the checks an instance owes each type annotation it resolves, which no check of the
# generic declaration can answer before its parameters are known
pub fun check_annotation(sc: *sema_context.SemaContext, ast_tid: ast_id.TypeId) {
    variant.check_annotation_uni_secrecy(sc, sc.instance.secrecy, ast_tid);
    sema_handle.check_annotation_handles(sc, sc.instance.handles, ast_tid);
}

fun nominal_of(sc: *sema_context.SemaContext, sym: *resolve.Symbol) type_kind.TypeId {
    var kind: type_kind.TypeKind = type_kind.TYPE_REC;
    if (sym.definition_kind == resolve.SYM_UNI) { kind = type_kind.TYPE_UNI; }
    if (sym.definition_kind == resolve.SYM_TAG) { kind = type_kind.TYPE_TAG; }
    if (lang_source.file_is_nil(sym.definition_file)) {
        lang_phase.internal(?sc.status, fail.message("generic nominal has no defining source identity"));
        ret type_kind.TYPE_ERROR;
    }
    val nominal: res[type_kind.TypeId, fail.Fail] = type.intern_nominal(?sc.s.types, sym.canon,
        resolve.type_owner(sc.s, resolve.origin_of(sc.s, sym), sym.definition_file), kind);
    if (sel nominal.err) {
        lang_phase.internal(?sc.status, nominal.err);
        ret type_kind.TYPE_ERROR;
    }
    ret nominal.ok;
}

fun report_type_arg_count(sc: *sema_context.SemaContext, span: lang_source.Span, prefix: str, expected: u32, actual: u32) {
    sema_context.reportf(sc, diagnostic_kind.GENERIC_ARITY, span, "{}: expected {}, found {}", prefix, expected::usize, actual::usize);
}
