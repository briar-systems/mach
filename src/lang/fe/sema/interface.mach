# what a module publishes for the lowering of every module that imports it, in place of
# its syntax tree: the facts of each module-level function and binding, the deep value of
# each module constant, and the public surface a `fwd` re-exports. it owns everything it
# holds and points into no syntax tree, scope or other product
use std.collections.map;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use ast_id:        mach.lang.fe.ast.id;
use comptime_deep: mach.lang.fe.comptime.deep;
use mach.lang.fe.resolve;
use sema_template: mach.lang.fe.sema.template;
use mach.lang.intern;
use lang_module: mach.lang.module;

pub val NONE: u32 = 0xFFFFFFFF;

def DeclarationFlags: u8;
pub val DECLARATION_EXT:  DeclarationFlags = 1;
pub val DECLARATION_BODY: DeclarationFlags = 2;
pub val DECLARATION_PACK: DeclarationFlags = 4;
# a `#[thread]` var: each thread holds its own copy, which every reference reaches through the thread
pub val DECLARATION_THREAD: DeclarationFlags = 8;
# a function declared `#[constant_time("soft")]` or `#[constant_time("hard")]`: what a constant-time caller may trust of
# it, from its declaration alone
pub val DECLARATION_SOFT: DeclarationFlags = 16;
pub val DECLARATION_HARD: DeclarationFlags = 32;
# a `#[weak]` function, a link-time default another definition may replace
pub val DECLARATION_WEAK: DeclarationFlags = 64;

# one module-level function, `val` or `var`
# ---
# decl:         the declaration in its module, which keys the session's tables of it
# generics:     how many type parameters a function declares
# params_start: where a function's parameters start in `params`
# op_set:       the instruction set and operation an `#[intrinsic]` names, STR_NIL without one
# value:        the node in `values` of a `val`'s constant value, or of the value
#               a `var`'s initializer gives it, NONE when it has none
# gated:        the value is declared under a comptime condition; the one record sema reads for it, from the binding the module's context holds
pub rec Declaration {
    kind:         resolve.SymKind;
    canon:        intern.StrId;
    decl:         ast_id.DeclId;
    flags:        DeclarationFlags;
    generics:     u32;
    params_start: u32;
    params_len:   u32;
    op_set:       intern.StrId;
    op_name:      intern.StrId;
    value:        u32;
    gated:        bool;
}

pub rec Param {
    comptime: bool;
}

# one symbol on the module's public surface, as an importer of it names it
# ---
# origin: the module that declares it, which may be one this module re-exports
# module: the module a `pub use` names, for a module symbol
pub rec Exported {
    kind:                resolve.SymKind;
    name:                intern.StrId;
    canon:               intern.StrId;
    origin:              lang_module.StableModuleId;
    module:              lang_module.StableModuleId;
    generic_arity:       u32;
    has_comptime_params: bool;
    has_pack_param:      bool;
}

pub rec Interface {
    alloc:        *A.Allocator;
    declarations: collections_vector.Vector[Declaration];
    params:       collections_vector.Vector[Param];
    surface:      collections_vector.Vector[Exported];
    by_decl:      map.Map[u32, u32];
    by_canon:     map.Map[u64, u32];
    # the deep value of each of the module's constants, and of each array a `$each` of its
    # typing reads
    values: comptime_deep.Store;
    # what an importer emits the module's instances from
    template: sema_template.Template;
}

# how a lowering reads the interface another module published
pub rec Reader {
    ctx:  ptr;
    read: fun(ptr, lang_module.ModuleId) res[*Interface, fail.Fail];
}

pub fun init(alloc: *A.Allocator) Interface {
    ret Interface{
        alloc:   alloc, declarations: collections_vector.init[Declaration](alloc), params: collections_vector.init[Param](alloc),
        surface: collections_vector.init[Exported](alloc), by_decl: map.init[u32, u32](alloc), by_canon: map.init[u64, u32](alloc),
        values:  comptime_deep.init(alloc), template: sema_template.none(alloc)
    };
}

# release an interface; a nil one, or one never made, holds nothing
pub fun dnit(iface: *Interface) {
    if (iface == nil || iface.alloc == nil) { ret; }
    collections_vector.dnit[Declaration](?iface.declarations);
    collections_vector.dnit[Param](?iface.params);
    comptime_deep.dnit(?iface.values);
    collections_vector.dnit[Exported](?iface.surface);
    map.dnit[u32, u32](?iface.by_decl);
    map.dnit[u64, u32](?iface.by_canon);
    sema_template.dnit(?iface.template);
    iface.alloc = nil;
}

fun canon_key(kind: resolve.SymKind, canon: intern.StrId) u64 {
    ret (kind::u64 << 32) | intern.str_index(canon)::u64;
}

# adds `d` with the parameters `params[0 .. params_len]`; a second declaration of one kind and
# canonical name leaves that name ambiguous, which a lookup by name refuses
pub fun declaration_add(iface: *Interface, d: Declaration, params: *Param, params_len: u32) err[fail.Fail] {
    var owned: Declaration = d;
    owned.params_start = iface.params.len::u32;
    owned.params_len   = params_len;
    var i: u32 = 0;
    for (i < params_len) {
        val pushed: res[usize, A.Error] = collections_vector.push[Param](?iface.params, params[i]);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    val at:     u32                 = iface.declarations.len::u32;
    val pushed: res[usize, A.Error] = collections_vector.push[Declaration](?iface.declarations, owned);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    val by_decl: res[bool, A.Error] = map.insert[u32, u32](?iface.by_decl, ast_id.decl_index(d.decl), at);
    if (sel by_decl.err) { ret err[fail.Fail].err{fail.refused(by_decl.err)}; }
    var key:  u64       = canon_key(d.kind, d.canon);
    val seen: opt[*u32] = map.get[u64, u32](?iface.by_canon, ?key);
    var slot: u32       = at;
    if (sel seen.some) { slot = NONE; }
    val by_canon: res[bool, A.Error] = map.insert[u64, u32](?iface.by_canon, key, slot);
    if (sel by_canon.err) { ret err[fail.Fail].err{fail.refused(by_canon.err)}; }
    ret err[fail.Fail].ok{};
}

# the declaration `decl` of the module, none for one the interface does not describe
pub fun declaration_at(iface: *Interface, decl: ast_id.DeclId) opt[*Declaration] {
    if (ast_id.decl_is_nil(decl)) { ret opt[*Declaration].none{}; }
    var key:   u32       = ast_id.decl_index(decl);
    val found: opt[*u32] = map.get[u32, u32](?iface.by_decl, ?key);
    if (sel found.none) { ret opt[*Declaration].none{}; }
    ret opt[*Declaration].some{?iface.declarations.data[@found.some]};
}

# the one declaration of `kind` the module defines under `canon`
pub fun declaration_for(iface: *Interface, kind: resolve.SymKind, canon: intern.StrId) res[*Declaration, fail.Fail] {
    var key:   u64       = canon_key(kind, canon);
    val found: opt[*u32] = map.get[u64, u32](?iface.by_canon, ?key);
    if (sel found.none)      { ret res[*Declaration, fail.Fail].err{fail.message("interface: the module defines no such declaration")}; }
    if (@found.some == NONE) { ret res[*Declaration, fail.Fail].err{fail.message("interface: the declaration's canonical name is ambiguous")}; }
    ret res[*Declaration, fail.Fail].ok{?iface.declarations.data[@found.some]};
}

pub fun param_at(iface: *Interface, d: *Declaration, ord: u32) opt[Param] {
    if (ord >= d.params_len) { ret opt[Param].none{}; }
    ret opt[Param].some{iface.params.data[d.params_start + ord]};
}

pub fun declaration_has_comptime_param(iface: *Interface, d: *Declaration) bool {
    var i: u32 = 0;
    for (i < d.params_len) {
        if (iface.params.data[d.params_start + i].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a generic, comptime-parameter or pack function has instances in place of one definition
pub fun declaration_has_instances(iface: *Interface, d: *Declaration) bool {
    ret d.generics > 0 || (d.flags & DECLARATION_PACK) != 0 || declaration_has_comptime_param(iface, d);
}

# the template part, none for a module with no generic, comptime-parameter or pack function
pub fun template_of(iface: *Interface) opt[*sema_template.Template] {
    if (!iface.template.present) { ret opt[*sema_template.Template].none{}; }
    ret opt[*sema_template.Template].some{?iface.template};
}

pub fun exported_add(iface: *Interface, e: Exported) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[Exported](?iface.surface, e);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun exported_count(iface: *Interface) u32 {
    ret iface.surface.len::u32;
}

pub fun exported_at(iface: *Interface, ord: u32) *Exported {
    ret ?iface.surface.data[ord];
}
