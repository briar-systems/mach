# the module constants sema binds: every module `val` whose initializer evaluates at compile
# time, bound once in sema's own bindings, which its result publishes to lowering and to every
# importer. a constant is bound where it is first read while declarations are typed, and every
# other one once they all are, before any body or instance is. the deep value of a constant,
# its array, record or case literal evaluated member by member, is built in the module's store
# of constant values, which its interface publishes
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_expr:   mach.lang.fe.ast.expr;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use mach.lang.fe.comptime;
use comptime_deep: mach.lang.fe.comptime.deep;
use mach.lang.fe.decorator;
use mach.lang.fe.resolve;
use sema_context: mach.lang.fe.sema.context;
use mach.lang.fe.sema.declared;
use mach.lang.fe.sema.infer;
use mach.lang.fe.sema.interface;
use sema_product: mach.lang.fe.sema.product;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.type;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

# pending: not bound yet, and tried again on the next read; none: no constant, for good
pub val CONSTANT_PENDING: u8 = 0;
val     CONSTANT_ACTIVE:  u8 = 1;
val     CONSTANT_BOUND:   u8 = 2;
val     CONSTANT_NONE:    u8 = 3;

# the value of the module constant the bare name `eid` names: one of this module's, bound on
# first read, or one an imported module published
pub fun named(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val found: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel found.some) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val sym:       *resolve.Symbol                               = found.some;
    val aggregate: res[opt[comptime.CTValue], comptime.EvalFail] = aggregate_value(sc, sym);
    if (sel aggregate.err)     { ret aggregate; }
    if (sel aggregate.ok.some) { ret aggregate; }
    if (sym.kind == resolve.SYM_IMPORTED) {
        if (gated_in_union(sc, sym)) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
        ret sema_context.resolve_module_member_const(sc, eid);
    }
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_MODULE) == 0 || ast_id.decl_is_nil(sym.decl)
        || !module.same(sym.origin, sc.view.own_module)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    ret bound_of(sc, sym.decl);
}

# the value of the module constant a path names, which for a path through a module is the
# imported constant itself
pub fun member(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val found: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel found.some) {
        val projected: res[opt[comptime.CTValue], comptime.EvalFail] = projected_value(sc, eid);
        if (sel projected.err)     { ret projected; }
        if (sel projected.ok.some) { ret projected; }
    }
    if (sel found.some) {
        val aggregate: res[opt[comptime.CTValue], comptime.EvalFail] = aggregate_value(sc, found.some);
        if (sel aggregate.err)     { ret aggregate; }
        if (sel aggregate.ok.some) { ret aggregate; }
    }
    ret sema_context.resolve_module_member_const(sc, eid);
}

# the value a field or element path into a constant reads, which includes the zero of a member
# its literal leaves out: the same answer a typed read gets, since it needs only the types the
# constant records on its nodes
fun projected_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    val none:  res[opt[comptime.CTValue], comptime.EvalFail] = res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    val e_opt: opt[*ast_expr.Expr]                           = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret none; }
    val e: *ast_expr.Expr = e_opt.some;
    if (e.kind != ast_expr.EXPR_KIND_MEMBER && !(e.kind == ast_expr.EXPR_KIND_INDEX && !ast_expr.is_range(?e.data.index))) { ret none; }
    val reached: res[Reach, fail.Fail] = reach(sc, eid, 0);
    if (sel reached.err)                  { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(reached.err, diagnostic_kind.COMPTIME_NOT_CONSTANT, "")}; }
    if (reached.ok.kind == REACH_REFUSED) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{reached.ok.why}; }
    if (reached.ok.kind != REACH_NODE)    { ret none; }
    val own:     u32                 = module.stable_index(sc.typing.module);
    val adopted: res[u32, fail.Fail] = adopt(sc, reached.ok.store, reached.ok.node);
    if (sel adopted.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(adopted.err, diagnostic_kind.COMPTIME_NOT_CONSTANT, "")}; }
    val read: res[comptime.CTValue, comptime.EvalFail] = comptime_deep.read(sc.typing.values, ?sc.s.interner, own, adopted.ok);
    if (sel read.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{read.err}; }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{read.ok}};
}

# the value of the record, array or case constant `sym` names, as the store of values holds it:
# this module's built on first ask and another module's as it published it; none for any other
# symbol, and for a constant a union build binds per target tuple
fun aggregate_value(sc: *sema_context.SemaContext, sym: *resolve.Symbol) res[opt[comptime.CTValue], comptime.EvalFail] {
    val none: res[opt[comptime.CTValue], comptime.EvalFail] = res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    if (!names_constant(sym)) { ret none; }
    if (module.same(sym.origin, sc.view.own_module)) {
        if (!reads_published(sc, sym)) { ret none; }
        type_initializer(sc, sym);
    }
    if (!module.same(sym.origin, sc.view.own_module)) {
        if (gated_in_union(sc, sym)) { ret none; }
        val found: res[opt[Published], fail.Fail] = published(sc, sym);
        if (sel found.err)     { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(found.err, diagnostic_kind.COMPTIME_NOT_CONSTANT, "")}; }
        if (sel found.ok.none) { ret none; }
        val p: Published = found.ok.some;
        if (p.declaration.value == interface.NONE) { ret none; }
        val kind: comptime_deep.NodeKind = comptime_deep.node_at(p.store, p.declaration.value).kind;
        if (kind != comptime_deep.NODE_LITERAL && kind != comptime_deep.NODE_ARRAY) { ret none; }
    }
    val value: res[opt[comptime.CTValue], fail.Fail] = array_value(sc, sym);
    if (sel value.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(value.err, diagnostic_kind.COMPTIME_NOT_CONSTANT, "")}; }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{value.ok};
}

# types the initializer of the module `val` `sym` if no walk has yet, quietly: the declaration
# reports what is wrong with it when it is typed in turn. a value is built at the types its
# expressions were given
fun type_initializer(sc: *sema_context.SemaContext, sym: *resolve.Symbol) {
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
    if (sel d_opt.none) { ret; }
    val init: ast_id.ExprId = d_opt.some.data.bind.init;
    if (!type.is_nil(type_at(sc, init))) { ret; }
    val outer: sema_context.Walk = sema_context.walk_open(sc);
    sc.walk.silent = true;
    infer.infer_expr(sc, init);
    sema_context.walk_close(sc, outer);
}

# whether the module `val` `sym` is an aggregate whose value this module's typing builds
fun reads_published(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (sc.view.constant_node == nil || ast_id.decl_is_nil(sym.decl)) { ret false; }
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
    if (sel d_opt.none) { ret false; }
    val init: ast_id.ExprId = d_opt.some.data.bind.init;
    ret d_opt.some.kind == ast_decl.DECL_KIND_VAL && !ast_id.expr_is_nil(init) && is_aggregate(sc, init);
}

# binds the module `val` `did` declares when its initializer is a compile-time constant
pub fun bind(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    val made: res[opt[comptime.CTValue], comptime.EvalFail] = bound_of(sc, did);
    if (sel made.ok) { ret err[fail.Fail].ok{}; }
    val failure: comptime.EvalFail = made.err;
    if (failure.kind == comptime.EVAL_FAIL_INTERNAL) { ret err[fail.Fail].err{fail.message(failure.message)}; }
    ret err[fail.Fail].ok{};
}

fun bound_of(sc: *sema_context.SemaContext, did: ast_id.DeclId) res[opt[comptime.CTValue], comptime.EvalFail] {
    val none: res[opt[comptime.CTValue], comptime.EvalFail] = res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    # a module read only through an instance of it is bound by its own typing
    if (sc.view.constant_state == nil || ast_id.decl_index(did) >= sc.view.a.decls.len::u32) { ret none; }
    val ix: u32 = ast_id.decl_index(did);
    val st: u8  = sc.view.constant_state[ix];
    if (st == CONSTANT_ACTIVE || st == CONSTANT_NONE) { ret none; }

    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel d_opt.some) { ret none; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_VAL || (d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.expr_is_nil(d.data.bind.init)
        || decorator.has(sc.view.a, d, decorator.EMBED)) {
        sc.view.constant_state[ix] = CONSTANT_NONE;
        ret none;
    }
    val name_r: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, d.data.bind.name.offset, d.data.bind.name.len);
    if (sel name_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "out of memory naming a module constant")}; }
    val name: intern.StrId = name_r.ok;
    # what an earlier stage bound, a constant tag over its literal included, stands
    val prior: opt[comptime.NamedConst] = comptime.lookup(sc.view.ctx, name);
    if (st == CONSTANT_BOUND || sel prior.some) {
        sc.view.constant_state[ix] = CONSTANT_BOUND;
        if (!sel prior.some) { ret none; }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{prior.some.value}};
    }

    sc.view.constant_state[ix] = CONSTANT_ACTIVE;
    # typed and evaluated quietly: the declaration reports what is wrong with it when it is
    # typed in turn, and a reader reports that it read no constant
    val outer: sema_context.Walk = sema_context.walk_open(sc);
    sc.walk.silent = true;
    infer.infer_expr(sc, d.data.bind.init);
    val evaluated: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[sema_context.SemaContext](sc.view.ctx, sc,
        sc.typing.type_caps, sc.view.a, sc.view.source, d.data.bind.init, ?sc.s.interner,
        comptime.declared_float_width(sc.view.a, sc.view.source, d.data.bind.ty));
    sema_context.walk_close(sc, outer);
    if (sel evaluated.err) {
        sc.view.constant_state[ix] = CONSTANT_PENDING;
        if (evaluated.err.kind == comptime.EVAL_FAIL_INTERNAL) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{evaluated.err}; }
        ret none;
    }
    # an aggregate is a value of the store, built from its initializer, and binds no scalar
    if (evaluated.ok.kind == comptime.CT_KIND_NODE) {
        sc.view.constant_state[ix] = CONSTANT_NONE;
        ret none;
    }
    val value: comptime.CTValue = comptime.apply_declared_int_type(sc.view.a, sc.view.source, d.data.bind.ty, evaluated.ok);
    val put:   err[fail.Fail]   = comptime.bind_gated(sc.view.ctx, name, value, !declared_at_top(sc, did));
    if (sel put.err) {
        sc.view.constant_state[ix] = CONSTANT_NONE;
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(put.err))};
    }
    sc.view.constant_state[ix] = CONSTANT_BOUND;
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{value}};
}

# whether `did` is one of the module's own declarations rather than one in a gated arm
pub fun declared_at_top(sc: *sema_context.SemaContext, did: ast_id.DeclId) bool {
    val m_opt: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel m_opt.some) { ret false; }
    var i: u32 = 0;
    for (i < m_opt.some.decls_len) {
        if (ast_id.decl_same(sc.view.a.decl_ids.data[m_opt.some.decls_start + i], did)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# every constant still unbound once all are tried is none, so no later read, inside a body or
# an instance, evaluates one again
pub fun settle(sc: *sema_context.SemaContext) {
    if (sc.view.constant_state == nil) { ret; }
    var i: u32 = 0;
    for (i < sc.view.a.decls.len::u32) {
        if (sc.view.constant_state[i] == CONSTANT_PENDING) { sc.view.constant_state[i] = CONSTANT_NONE; }
        i = i + 1;
    }
}

# the node of a constant while its value is built, so a value that names the constant itself
# is refused rather than built forever
val NODE_BUILDING: u32 = 0xFFFFFFFE;

# the node of the value the module `val` `sym` declares, built in the module's store on first
# ask: the constant sema bound, or its initializer evaluated member by member; NONE for a
# declaration with no initializer of its own
pub fun own_value(sc: *sema_context.SemaContext, sym: *resolve.Symbol) res[u32, fail.Fail] {
    val ix: u32 = ast_id.decl_index(sym.decl);
    if (sc.view.constant_node == nil || ix >= sc.view.a.decls.len::u32) {
        ret res[u32, fail.Fail].err{fail.message("sema: a module constant's value is built outside its module's typing")};
    }
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
    if (sel d_opt.none) { ret res[u32, fail.Fail].err{fail.message("sema: a module constant has no declaration")}; }
    val d: *ast_decl.Decl = d_opt.some;
    if (sc.view.constant_node[ix] == NODE_BUILDING) {
        ret refused_add(sc, type_at(sc, d.data.bind.init), comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_NOT_CONSTANT,
            "the value of this constant names the constant itself"), d.data.bind.init);
    }
    if (sc.view.constant_node[ix] != interface.NONE) { ret res[u32, fail.Fail].ok{sc.view.constant_node[ix]}; }
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.expr_is_nil(d.data.bind.init) || decorator.has(sc.view.a, d, decorator.EMBED)) {
        ret res[u32, fail.Fail].ok{interface.NONE};
    }
    var ty: type.TypeId = type.TYPE_NIL;
    if (sc.view.decl_type != nil) { ty = sc.view.decl_type[ix]; }
    val bound: opt[comptime.NamedConst] = comptime.lookup(sc.view.ctx, sym.name);
    if (sel bound.some) {
        if (bound.some.value.kind != comptime.CT_KIND_CONST_ELEM) {
            val scalar: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_SCALAR, ty: ty, value: bound.some.value});
            if (sel scalar.ok) { sc.view.constant_node[ix] = scalar.ok; }
            ret scalar;
        }
    }
    type_initializer(sc, sym);
    sc.view.constant_node[ix] = NODE_BUILDING;
    val built: res[u32, fail.Fail] = node_build(sc, d.data.bind.init);
    if (sel built.err) {
        sc.view.constant_node[ix] = interface.NONE;
        ret built;
    }
    sc.view.constant_node[ix] = built.ok;
    ret built;
}

# the published value of the module `val` `sym` names: the declaration in its module's interface
# that holds it, with the store it is a node of
rec Published {
    store:       *comptime_deep.Store;
    module:      u32;
    declaration: *interface.Declaration;
}

fun published(sc: *sema_context.SemaContext, sym: *resolve.Symbol) res[opt[Published], fail.Fail] {
    val acquired: res[*interface.Interface, fail.Fail] = sema_context.interface_of(sc, sym.origin);
    if (sel acquired.err) { ret res[opt[Published], fail.Fail].err{acquired.err}; }
    val iface: *interface.Interface = acquired.ok;
    var decl:  ast_id.DeclId        = sym.decl;
    if (sym.kind == resolve.SYM_IMPORTED) {
        val named: res[*interface.Declaration, fail.Fail] = interface.declaration_for(iface, sym.definition_kind, sym.canon);
        if (sel named.err) {
            fail.internal(?sc.status, fail.describe(named.err));
            ret res[opt[Published], fail.Fail].err{named.err};
        }
        decl = named.ok.decl;
    }
    val found: opt[*interface.Declaration] = interface.declaration_at(iface, decl);
    if (sel found.none) { ret res[opt[Published], fail.Fail].ok{opt[Published].none{}}; }
    ret res[opt[Published], fail.Fail].ok{opt[Published].some{Published{store: ?iface.values,
        module: module.stable_index(resolve.stable_of_module(sc.s, sym.origin)), declaration: found.some}}};
}

# whether `sym` is an imported constant a union build refuses to read: its exporter binds it under
# a per-target-tuple condition, so no one tuple's value may stand for it
pub fun gated_in_union(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED || !sc.view.ctx.env.build.union_build) { ret false; }
    val found: res[opt[Published], fail.Fail] = published(sc, sym);
    if (sel found.err) {
        fail.internal(?sc.status, fail.describe(found.err));
        ret false;
    }
    if (sel found.ok.none) { ret false; }
    ret found.ok.some.declaration.gated;
}

# reports the union build's refusal of the imported constant `sym` a read at `span` names
pub fun report_gated(sc: *sema_context.SemaContext, sym: *resolve.Symbol, span: lang_source.Span) {
    val msg: res[str, fail.Fail] = sema_context.gated_member_const_message(sc, sym.name, session.module_fqn(sc.s, sym.origin));
    if (sel msg.err) {
        fail.internal(?sc.status, fail.describe(msg.err));
        ret;
    }
    sema_context.report(sc, diagnostic_kind.CONST_TUPLE_DEPENDENT, span, msg.ok);
}

# the value of the array `sym` names that a `$each` reads: a module constant's, this module's
# built once and another module's as it published it, or the value of a `val` local to a body,
# built in the walk that reads it since each instance of the body may give it another; none for
# a binding with no array, record or case literal value
pub fun array_value(sc: *sema_context.SemaContext, sym: *resolve.Symbol) res[opt[comptime.CTValue], fail.Fail] {
    val none: res[opt[comptime.CTValue], fail.Fail] = res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].none{}};
    val own:  u32                                   = module.stable_index(sc.typing.module);
    if (sym.kind == resolve.SYM_VAL && (sym.flags & resolve.SYM_FLAG_MODULE) == 0) {
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
        if (sel d_opt.none) { ret none; }
        val init: ast_id.ExprId = d_opt.some.data.bind.init;
        if (d_opt.some.kind != ast_decl.DECL_KIND_VAL || ast_id.expr_is_nil(init) || !is_aggregate(sc, init)) { ret none; }
        val local: res[u32, fail.Fail] = node_build(sc, init);
        if (sel local.err) { ret res[opt[comptime.CTValue], fail.Fail].err{local.err}; }
        ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].some{comptime.node_ref(own, local.ok, type.index(type_at(sc, init)))}};
    }
    if (module.same(sym.origin, sc.view.own_module) && sc.view.constant_node != nil) {
        val built: res[u32, fail.Fail] = own_value(sc, sym);
        if (sel built.err)              { ret res[opt[comptime.CTValue], fail.Fail].err{built.err}; }
        if (built.ok == interface.NONE) { ret none; }
        ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].some{comptime.node_ref(own, built.ok,
            type.index(comptime_deep.node_at(sc.typing.values, built.ok).ty))}};
    }
    if (gated_in_union(sc, sym)) { ret none; }
    val found: res[opt[Published], fail.Fail] = published(sc, sym);
    if (sel found.err)                                     { ret res[opt[comptime.CTValue], fail.Fail].err{found.err}; }
    if (sel found.ok.none)                                 { ret none; }
    if (found.ok.some.declaration.value == interface.NONE) { ret none; }
    val p:    Published = found.ok.some;
    val node: u32       = p.declaration.value;
    ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].some{comptime.node_ref(p.module, node, type.index(comptime_deep.node_at(p.store, node).ty))}};
}

# the store of constant values of the module with stable id `module`: this module's, or the one
# another module's interface publishes
pub fun store_of(sc: *sema_context.SemaContext, module_index: u32) res[*comptime_deep.Store, comptime.EvalFail] {
    if (sc.typing.values != nil && module_index == module.stable_index(sc.typing.module)) {
        ret res[*comptime_deep.Store, comptime.EvalFail].ok{sc.typing.values};
    }
    val mid:      session.ModuleId                     = session.module_id_for_stable(sc.s, module.stable_id(module_index));
    val acquired: res[*interface.Interface, fail.Fail] = sema_context.interface_of(sc, mid);
    if (sel acquired.err) {
        ret res[*comptime_deep.Store, comptime.EvalFail].err{comptime.eval_from_fail(acquired.err, diagnostic_kind.COMPTIME_NOT_CONSTANT,
            "the module that publishes this constant was rejected")};
    }
    ret res[*comptime_deep.Store, comptime.EvalFail].ok{?acquired.ok.values};
}

# an array literal, or a record or case literal spelled with its head type
pub fun is_aggregate(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret false; }
    val e: *ast_expr.Expr = e_opt.some;
    if (e.kind == ast_expr.EXPR_KIND_ARRAY_LIT)  { ret true; }
    if (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT) { ret !ast_id.type_is_nil(e.data.struct_lit.ty); }
    if (e.kind == ast_expr.EXPR_KIND_VECTOR_LIT) { ret !ast_id.type_is_nil(e.data.vector_lit.ty); }
    ret false;
}

# the type the walk gave an expression
pub fun type_at(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type.TypeId {
    if (sc.view.expr_type == nil || ast_id.expr_index(eid)::usize >= sc.view.a.exprs.len) { ret type.TYPE_NIL; }
    ret sema_context.apply_subst(sc, sc.view.expr_type[ast_id.expr_index(eid)]);
}

# the node of the expression `eid`: an aggregate literal member by member, the value of the
# constant it names, an address, or anything else as the evaluator answers it at the type the
# walk gave it
pub fun node_build(sc: *sema_context.SemaContext, eid: ast_id.ExprId) res[u32, fail.Fail] {
    val ty: type.TypeId = type_at(sc, eid);
    if (!is_aggregate(sc, eid)) { ret leaf_build(sc, eid, ty); }
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret res[u32, fail.Fail].err{fail.message("sema: a constant names no expression")}; }
    val e: *ast_expr.Expr = e_opt.some;

    var head:      intern.StrId           = intern.STR_NIL;
    var named:     u32                    = 0;
    var elems:     u32                    = 0;
    var elems_at:  u32                    = 0;
    var fields_at: u32                    = 0;
    var kind:      comptime_deep.NodeKind = comptime_deep.NODE_ARRAY;
    if (e.kind == ast_expr.EXPR_KIND_ARRAY_LIT) {
        elems    = e.data.array_lit.elems_len;
        elems_at = e.data.array_lit.elems_start;
    }
    or {
        kind = comptime_deep.NODE_LITERAL;
        val case_r: res[intern.StrId, comptime.EvalFail] = comptime.literal_case[sema_context.SemaContext](sc.view.ctx, sc,
            sc.typing.type_caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
        if (sel case_r.err) { ret refused_add(sc, ty, case_r.err, eid); }
        head = case_r.ok;
        # a record literal's values are its named fields, and a case literal's its payload; the
        # parsed element list repeats the fields' values in order
        if (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT && intern.str_is_nil(head)) {
            named     = e.data.struct_lit.fields_len;
            fields_at = e.data.struct_lit.fields_start;
        }
        or (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT) {
            elems    = e.data.struct_lit.elems_len;
            elems_at = e.data.struct_lit.elems_start;
        }
        or {
            elems    = e.data.vector_lit.elems_len;
            elems_at = e.data.vector_lit.elems_start;
        }
    }

    var declared: u32 = elems;
    if (kind == comptime_deep.NODE_ARRAY) {
        val count: opt[u32] = type.element_count(?sc.s.types, ty);
        if (sel count.some) { declared = count.some; }
    }
    val node: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: kind, ty: ty, head: head, declared: declared});
    if (sel node.err) { ret node; }
    val total: u32 = named + elems;
    if (total == 0) { ret node; }
    val allocated: res[*comptime_deep.Member, A.Error] = A.allocate[comptime_deep.Member](sc.s.alloc, total::usize);
    if (sel allocated.err) { ret res[u32, fail.Fail].err{fail.refused(allocated.err)}; }
    val members: *comptime_deep.Member = allocated.ok;
    fin { A.deallocate[comptime_deep.Member](sc.s.alloc, members, total::usize); }

    var i: u32 = 0;
    for (i < named) {
        val fi:   *ast_expr.FieldInit        = ?sc.view.a.field_inits.data[fields_at + i];
        val name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, fi.name.offset, fi.name.len);
        if (sel name.err) { ret res[u32, fail.Fail].err{fail.refused(name.err)}; }
        val child: res[u32, fail.Fail] = node_build(sc, fi.value);
        if (sel child.err) { ret child; }
        members[i] = comptime_deep.Member{name: name.ok, node: child.ok};
        i          = i + 1;
    }
    i = 0;
    for (i < elems) {
        val child: res[u32, fail.Fail] = node_build(sc, sc.view.a.expr_ids.data[elems_at + i]);
        if (sel child.err) { ret child; }
        members[named + i] = comptime_deep.Member{name: intern.STR_NIL, node: child.ok};
        i                  = i + 1;
    }
    val linked: err[fail.Fail] = comptime_deep.members_add(sc.typing.values, node.ok, members, total);
    if (sel linked.err) { ret res[u32, fail.Fail].err{linked.err}; }
    ret node;
}

# a leaf's value at its type: a float read at the type's width, and an integer or float held
# as one of the type
fun leaf_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId, ty: type.TypeId) res[comptime.CTValue, comptime.EvalFail] {
    var fw:    float.FloatWidth = float.FLOAT_W_NONE;
    var class: type.PrimClass   = type.PRIM_CLASS_NONE;
    val found: opt[*type.Type]  = type.get(?sc.s.types, type.strip_secret(?sc.s.types, ty));
    if (sel found.some) {
        class = type.prim_desc(found.some.kind).class;
        if (class == type.PRIM_CLASS_FLOAT) { fw = type.float_width_of(found.some.kind); }
    }
    val evaluated: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[sema_context.SemaContext](sc.view.ctx, sc,
        sc.typing.type_caps, sc.view.a, sc.view.source, eid, ?sc.s.interner, fw);
    if (sel evaluated.err) { ret evaluated; }
    val v: comptime.CTValue = evaluated.ok;
    if ((v.kind != comptime.CT_KIND_INT && v.kind != comptime.CT_KIND_FLOAT) || (class != type.PRIM_CLASS_INT && class != type.PRIM_CLASS_FLOAT)) { ret evaluated; }
    ret comptime.cast_scalar(?sc.s.types, sc.view.ctx.env.target.pointer_width, sc.view.ctx.env.target.nan_rule, v, ty, ty, false);
}

# a leaf with no compile-time value keeps the refusal reading it gives, at the leaf; an internal
# failure is the build's own
fun refused_add(sc: *sema_context.SemaContext, ty: type.TypeId, why: comptime.EvalFail, eid: ast_id.ExprId) res[u32, fail.Fail] {
    if (why.kind == comptime.EVAL_FAIL_INTERNAL) { ret res[u32, fail.Fail].err{fail.message(why.message)}; }
    val message: res[intern.StrId, A.Error] = intern.add(?sc.s.interner, why.message);
    if (sel message.err) { ret res[u32, fail.Fail].err{fail.refused(message.err)}; }
    var span:  lang_source.Span    = lang_source.span(0, 0);
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.some) { span = e_opt.some.span; }
    ret comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_REFUSED, ty: ty,
        refusal: comptime_deep.Refusal{kind: why.kind, diag: why.diag, message: message.ok, at: lang_source.location(sc.view.a.file_id, span)}});
}

fun refused(message: str) comptime.EvalFail {
    ret comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_NOT_CONSTANT, message);
}

# a leaf: the value of the constant it names, an address, or what the evaluator answers
fun leaf_build(sc: *sema_context.SemaContext, eid: ast_id.ExprId, ty: type.TypeId) res[u32, fail.Fail] {
    val reached: res[Reach, fail.Fail] = reach(sc, eid, 0);
    if (sel reached.err)                  { ret res[u32, fail.Fail].err{reached.err}; }
    if (reached.ok.kind == REACH_NODE)    { ret adopt(sc, reached.ok.store, reached.ok.node); }
    if (reached.ok.kind == REACH_REFUSED) { ret refused_add(sc, ty, reached.ok.why, eid); }
    val address: res[opt[u32], fail.Fail] = address_build(sc, eid, ty);
    if (sel address.err)     { ret res[u32, fail.Fail].err{address.err}; }
    if (sel address.ok.some) { ret res[u32, fail.Fail].ok{address.ok.some}; }
    val evaluated: res[comptime.CTValue, comptime.EvalFail] = leaf_value(sc, eid, ty);
    if (sel evaluated.err) { ret refused_add(sc, ty, evaluated.err, eid); }
    if (evaluated.ok.kind == comptime.CT_KIND_NODE) {
        val store: res[*comptime_deep.Store, comptime.EvalFail] = store_of(sc, evaluated.ok.data.node.module);
        if (sel store.err) { ret refused_add(sc, ty, store.err, eid); }
        ret adopt(sc, store.ok, evaluated.ok.data.node.node);
    }
    ret comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_SCALAR, ty: ty, value: evaluated.ok});
}

# node `node` of `store` as a node of this module's store: itself when the store is this
# module's, and otherwise a copy, so every tree of a store lies wholly in it
fun adopt(sc: *sema_context.SemaContext, store: *comptime_deep.Store, node: u32) res[u32, fail.Fail] {
    if (store == sc.typing.values) { ret res[u32, fail.Fail].ok{node}; }
    ret comptime_deep.clone(sc.typing.values, store, node);
}

def ReachKind: u8;
# the expression names no constant
val REACH_NONE: ReachKind = 0;
# it names node `node` of `store`
val REACH_NODE: ReachKind = 1;
# it names a constant that holds no value there, for the reason `why`
val REACH_REFUSED: ReachKind = 2;

rec Reach {
    kind:  ReachKind;
    store: *comptime_deep.Store;
    node:  u32;
    why:   comptime.EvalFail;
}

# a constant may name another constant; the chain is finite in a checked program, and the bound
# only keeps a malformed one from recursing forever
val REACH_DEPTH: u32 = 64;

fun reach_node(store: *comptime_deep.Store, node: u32) res[Reach, fail.Fail] {
    ret res[Reach, fail.Fail].ok{Reach{kind: REACH_NODE, store: store, node: node}};
}

fun reach_refused(why: comptime.EvalFail) res[Reach, fail.Fail] {
    ret res[Reach, fail.Fail].ok{Reach{kind: REACH_REFUSED, why: why}};
}

# the value a constant-valued expression names: a module `val`, a field or an element of one, a
# window of one's elements, or an identity cast of one
fun reach(sc: *sema_context.SemaContext, eid: ast_id.ExprId, depth: u32) res[Reach, fail.Fail] {
    val none: res[Reach, fail.Fail] = res[Reach, fail.Fail].ok{Reach{kind: REACH_NONE}};
    if (depth >= REACH_DEPTH) { ret none; }
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret none; }
    val e:     ast_expr.Expr        = @e_opt.some;
    val named: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (sel named.some) {
        if (names_constant(named.some)) { ret reach_constant(sc, named.some); }
        ret none;
    }
    if (e.kind == ast_expr.EXPR_KIND_CAST) {
        val from: type.TypeId = type.strip_secret(?sc.s.types, type_at(sc, e.data.cast.value));
        val to:   type.TypeId = type.strip_secret(?sc.s.types, type_at(sc, eid));
        if (type.is_nil(from) || type.is_error(from)) { ret none; }
        # `::` between `[N]T` and `TxN` keeps every element as it is
        val same_elements: bool = !e.data.cast.reinterpret && ((is_array(sc, from) && type.is_vector(?sc.s.types, to))
            || (type.is_vector(?sc.s.types, from) && is_array(sc, to)));
        if (!type.same(from, to) && !same_elements) { ret none; }
        ret reach(sc, e.data.cast.value, depth + 1);
    }
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) { ret reach_member(sc, eid, ?e, depth); }
    if (e.kind == ast_expr.EXPR_KIND_INDEX)  { ret reach_index(sc, eid, ?e, depth); }
    ret none;
}

fun names_constant(sym: *resolve.Symbol) bool {
    if (sym.kind == resolve.SYM_IMPORTED) { ret sym.definition_kind == resolve.SYM_VAL; }
    ret sym.kind == resolve.SYM_VAL && (sym.flags & resolve.SYM_FLAG_MODULE) != 0 && !ast_id.decl_is_nil(sym.decl);
}

# the value of the module `val` `sym`: this module's, built on first ask, or the one another
# module published, which a union build refuses when that module binds it per target tuple
fun reach_constant(sc: *sema_context.SemaContext, sym: *resolve.Symbol) res[Reach, fail.Fail] {
    val none: res[Reach, fail.Fail] = res[Reach, fail.Fail].ok{Reach{kind: REACH_NONE}};
    if (module.same(sym.origin, sc.view.own_module)) {
        val built: res[u32, fail.Fail] = own_value(sc, sym);
        if (sel built.err)              { ret res[Reach, fail.Fail].err{built.err}; }
        if (built.ok == interface.NONE) { ret none; }
        ret reach_node(sc.typing.values, built.ok);
    }
    val found: res[opt[Published], fail.Fail] = published(sc, sym);
    if (sel found.err)     { ret res[Reach, fail.Fail].err{found.err}; }
    if (sel found.ok.none) { ret none; }
    val p: Published = found.ok.some;
    if (gated_in_union(sc, sym)) {
        val message: res[str, fail.Fail] = sema_context.gated_member_const_message(sc, sym.name, session.module_fqn(sc.s, sym.origin));
        if (sel message.err) { ret res[Reach, fail.Fail].err{message.err}; }
        ret reach_refused(comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.CONST_TUPLE_DEPENDENT, message.ok));
    }
    if (p.declaration.value == interface.NONE) { ret none; }
    ret reach_node(p.store, p.declaration.value);
}

# the constant a member or an element is read from, whose refusal is the read's
fun reach_aggregate(sc: *sema_context.SemaContext, eid: ast_id.ExprId, depth: u32) res[Reach, fail.Fail] {
    val inner: res[Reach, fail.Fail] = reach(sc, eid, depth);
    if (sel inner.err)               { ret inner; }
    if (inner.ok.kind != REACH_NODE) { ret inner; }
    val n: *comptime_deep.Node = comptime_deep.node_at(inner.ok.store, inner.ok.node);
    if (n.kind != comptime_deep.NODE_REFUSED) { ret inner; }
    ret reach_refused(comptime_deep.refusal_of(?sc.s.interner, n.refusal));
}

# a field of a record constant, or the payload of the case a case constant holds; a field the
# literal leaves out holds its zero
fun reach_member(sc: *sema_context.SemaContext, eid: ast_id.ExprId, e: *ast_expr.Expr, depth: u32) res[Reach, fail.Fail] {
    val inner: res[Reach, fail.Fail] = reach_aggregate(sc, e.data.member.object, depth + 1);
    if (sel inner.err)               { ret inner; }
    if (inner.ok.kind != REACH_NODE) { ret inner; }
    val name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, e.data.member.name.offset, e.data.member.name.len);
    if (sel name.err) { ret res[Reach, fail.Fail].err{fail.refused(name.err)}; }
    val p: comptime_deep.Projection = comptime_deep.project(inner.ok.store, inner.ok.node, name.ok);
    if (p.kind == comptime_deep.PROJECT_MEMBER) { ret reach_node(inner.ok.store, p.node); }
    if (p.kind == comptime_deep.PROJECT_OMITTED) {
        val owner: type.TypeId = comptime_deep.node_at(inner.ok.store, inner.ok.node).ty;
        if (!intern.str_is_nil(declared.ensure_layout_ready(sc, owner))) { ret reach_refused(refused(LAYOUT_PENDING_MSG)); }
        val field: opt[type.TypeId] = sema_context.field_lookup(sc, type.strip_secret(?sc.s.types, owner), name.ok);
        if (sel field.none) { ret reach_refused(refused(ZERO_UNKNOWN_MSG)); }
        ret reach_zero(sc, field.some);
    }
    if (p.kind == comptime_deep.PROJECT_UNSELECTED) {
        ret reach_refused(refused("this reads the payload of a case the constant does not hold"));
    }
    if (p.kind == comptime_deep.PROJECT_NO_PAYLOAD) {
        ret reach_refused(refused("this reads a payload, but the case the constant holds has none"));
    }
    ret res[Reach, fail.Fail].ok{Reach{kind: REACH_NONE}};
}

# an element of an array constant, or a window `A[start, n]` of its elements; an element the
# literal leaves out holds its zero
fun reach_index(sc: *sema_context.SemaContext, eid: ast_id.ExprId, e: *ast_expr.Expr, depth: u32) res[Reach, fail.Fail] {
    val inner: res[Reach, fail.Fail] = reach_aggregate(sc, e.data.index.object, depth + 1);
    if (sel inner.err)               { ret inner; }
    if (inner.ok.kind != REACH_NODE) { ret inner; }
    val array: *comptime_deep.Node = comptime_deep.node_at(inner.ok.store, inner.ok.node);
    if (array.kind != comptime_deep.NODE_ARRAY) { ret res[Reach, fail.Fail].ok{Reach{kind: REACH_NONE}}; }
    val at: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc,
        sc.typing.type_caps, sc.view.a, sc.view.source, e.data.index.index, ?sc.s.interner);
    if (sel at.err) { ret reach_refused(at.err); }
    val start_o: opt[u64] = comptime.ct_int_u64(at.ok);
    if (sel start_o.none) { ret reach_refused(refused("an index into a constant must be a non-negative integer")); }
    val start: u64 = start_o.some;
    if (!ast_expr.is_range(?e.data.index)) {
        val element: comptime_deep.Element = comptime_deep.element(inner.ok.store, inner.ok.node, start);
        if (element.kind == comptime_deep.ELEMENT_PAST_END) { ret reach_refused(refused(comptime_deep.INDEX_PAST_END_MSG)); }
        if (element.kind == comptime_deep.ELEMENT_MEMBER)   { ret reach_node(inner.ok.store, element.node); }
        ret reach_zero(sc, element_type(sc, array.ty));
    }
    val ty:    type.TypeId = type_at(sc, eid);
    val count: opt[u32]    = type.element_count(?sc.s.types, ty);
    if (sel count.none)                                { ret res[Reach, fail.Fail].ok{Reach{kind: REACH_NONE}}; }
    if (start + count.some::u64 > array.declared::u64) { ret reach_refused(refused("this window runs past the end of the constant it reads")); }
    var held: u32 = 0;
    if (start < array.len::u64) { held = array.len - start::u32; }
    if (held > count.some)      { held = count.some; }
    val window: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_ARRAY, ty: ty, declared: count.some});
    if (sel window.err) { ret res[Reach, fail.Fail].err{window.err}; }
    if (held == 0)      { ret reach_node(sc.typing.values, window.ok); }
    val allocated: res[*comptime_deep.Member, A.Error] = A.allocate[comptime_deep.Member](sc.s.alloc, held::usize);
    if (sel allocated.err) { ret res[Reach, fail.Fail].err{fail.refused(allocated.err)}; }
    val members: *comptime_deep.Member = allocated.ok;
    fin { A.deallocate[comptime_deep.Member](sc.s.alloc, members, held::usize); }
    val first: u32 = array.first + start::u32;
    var i:     u32 = 0;
    for (i < held) {
        val element: res[u32, fail.Fail] = adopt(sc, inner.ok.store, inner.ok.store.members.data[first + i].node);
        if (sel element.err) { ret res[Reach, fail.Fail].err{element.err}; }
        members[i] = comptime_deep.Member{name: intern.STR_NIL, node: element.ok};
        i          = i + 1;
    }
    val linked: err[fail.Fail] = comptime_deep.members_add(sc.typing.values, window.ok, members, held);
    if (sel linked.err) { ret res[Reach, fail.Fail].err{linked.err}; }
    ret reach_node(sc.typing.values, window.ok);
}

# the element type of the array or vector constant type `ty`, which the constant records itself so
# a read no walk has typed still knows the zero of an element
fun element_type(sc: *sema_context.SemaContext, ty: type.TypeId) type.TypeId {
    val types: *type.TypeInterner = ?sc.s.types;
    val found: opt[*type.Type]    = type.get(types, type.strip_secret(types, ty));
    if (sel found.none)                     { ret type.TYPE_NIL; }
    if (found.some.kind == type.TYPE_ARRAY) { ret found.some.data.array.base; }
    val lane: opt[type.TypeId] = type.prim(types, type.vector_element(types, ty));
    if (sel lane.none) { ret type.TYPE_NIL; }
    ret lane.some;
}

val ZERO_UNKNOWN_MSG:   str = "the zero of this field's type is not known";
val LAYOUT_PENDING_MSG: str = "the zero of this field's type needs a layout that is still being decided";

# the zero of `ty`, which a member a literal leaves out holds: a record or an array with no
# members, a scalar zero, or a tag's first declared case over the zero of its payload
fun reach_zero(sc: *sema_context.SemaContext, ty: type.TypeId) res[Reach, fail.Fail] {
    val types: *type.TypeInterner = ?sc.s.types;
    if (type.is_tag(types, type.strip_secret(types, ty))) { ret reach_zero_tag(sc, ty); }
    var node:     comptime_deep.Node = comptime_deep.Node{kind: comptime_deep.NODE_SCALAR, ty: ty, head: intern.STR_NIL};
    val elements: opt[u32]           = type.element_count(types, ty);
    if (type.is_record(types, ty) || type.is_union(types, ty)) { node.kind = comptime_deep.NODE_LITERAL; }
    or (sel elements.some) {
        node.kind     = comptime_deep.NODE_ARRAY;
        node.declared = elements.some;
    }
    or {
        val found: opt[*type.Type] = type.get(types, type.strip_secret(types, ty));
        if (sel found.none) { ret reach_refused(refused(ZERO_UNKNOWN_MSG)); }
        val desc: type.PrimDesc = type.prim_desc(found.some.kind);
        if (desc.class == type.PRIM_CLASS_FLOAT) { node.value = comptime.ct_float(0.0, type.float_width_of(found.some.kind)); }
        or (desc.class == type.PRIM_CLASS_INT)   { node.value = comptime.ct_zero_int(!desc.signed, desc.bits::u8); }
        or                                       { node.value = comptime.ct_zero_int(true, (sc.view.ctx.env.target.pointer_width * 8)::u8); }
    }
    val added: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, node);
    if (sel added.err) { ret res[Reach, fail.Fail].err{added.err}; }
    ret reach_node(sc.typing.values, added.ok);
}

# the case literal of the first declared case of tag `ty`, holding the zero of its payload when it
# declares one: the shape a written case literal has, and the value lowering zero-fills
fun reach_zero_tag(sc: *sema_context.SemaContext, ty: type.TypeId) res[Reach, fail.Fail] {
    val types: *type.TypeInterner = ?sc.s.types;
    val bare:  type.TypeId        = type.strip_secret(types, ty);
    if (!intern.str_is_nil(declared.ensure_layout_ready(sc, bare))) { ret reach_refused(refused(LAYOUT_PENDING_MSG)); }
    val first: opt[*type.FieldEntry] = type.field_at(types, bare, 0);
    if (sel first.none) { ret res[Reach, fail.Fail].err{fail.message("sema: a tag has no cases")}; }
    var payload: Reach = Reach{kind: REACH_NONE};
    if (!type.is_nil(first.some.ty)) {
        val zero: res[Reach, fail.Fail] = reach_zero(sc, first.some.ty);
        if (sel zero.err)               { ret zero; }
        if (zero.ok.kind != REACH_NODE) { ret zero; }
        payload = zero.ok;
    }
    val node: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_LITERAL, ty: ty, head: first.some.name});
    if (sel node.err) { ret res[Reach, fail.Fail].err{node.err}; }
    if (payload.kind == REACH_NODE) {
        val member: comptime_deep.Member = comptime_deep.Member{name: intern.STR_NIL, node: payload.node};
        val linked: err[fail.Fail]       = comptime_deep.members_add(sc.typing.values, node.ok, ?member, 1);
        if (sel linked.err) { ret res[Reach, fail.Fail].err{linked.err}; }
    }
    ret reach_node(sc.typing.values, node.ok);
}

fun is_array(sc: *sema_context.SemaContext, ty: type.TypeId) bool {
    val found: opt[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, ty));
    if (sel found.none) { ret false; }
    ret found.some.kind == type.TYPE_ARRAY;
}

# the address leaf `eid` spells: `nil`, the address of a place in a module-level binding, or a
# function named bare; none for any other leaf
fun address_build(sc: *sema_context.SemaContext, eid: ast_id.ExprId, ty: type.TypeId) res[opt[u32], fail.Fail] {
    val none:  res[opt[u32], fail.Fail] = res[opt[u32], fail.Fail].ok{opt[u32].none{}};
    val e_opt: opt[*ast_expr.Expr]      = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret none; }
    val e: ast_expr.Expr = @e_opt.some;
    if (e.kind == ast_expr.EXPR_KIND_LIT_NIL) {
        val null: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_SCALAR, ty: ty,
            value: comptime.ct_zero_int(true, (sc.view.ctx.env.target.pointer_width * 8)::u8)});
        if (sel null.err) { ret res[opt[u32], fail.Fail].err{null.err}; }
        ret res[opt[u32], fail.Fail].ok{opt[u32].some{null.ok}};
    }
    var place: ast_id.ExprId = eid;
    if (e.kind == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_ADDR) { place = e.data.unary.operand; }
    or {
        val named: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
        if (sel named.none)              { ret none; }
        if (!names_function(named.some)) { ret none; }
    }
    var steps: collections_vector.Vector[comptime_deep.Member] = collections_vector.init[comptime_deep.Member](sc.s.alloc);
    fin { collections_vector.dnit[comptime_deep.Member](?steps); }
    val root: res[Root, fail.Fail] = address_root(sc, place, ?steps, 0);
    if (sel root.err) { ret res[opt[u32], fail.Fail].err{root.err}; }
    if (root.ok.refused) {
        val refusal: res[u32, fail.Fail] = refused_add(sc, ty, root.ok.why, place);
        if (sel refusal.err) { ret res[opt[u32], fail.Fail].err{refusal.err}; }
        ret res[opt[u32], fail.Fail].ok{opt[u32].some{refusal.ok}};
    }
    val node: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_ADDRESS, ty: ty, symbol: root.ok.symbol});
    if (sel node.err) { ret res[opt[u32], fail.Fail].err{node.err}; }
    if (steps.len > 0) {
        val linked: err[fail.Fail] = comptime_deep.members_add(sc.typing.values, node.ok, steps.data, steps.len::u32);
        if (sel linked.err) { ret res[opt[u32], fail.Fail].err{linked.err}; }
    }
    ret res[opt[u32], fail.Fail].ok{opt[u32].some{node.ok}};
}

fun names_function(sym: *resolve.Symbol) bool {
    if (sym.kind == resolve.SYM_IMPORTED) { ret sym.definition_kind == resolve.SYM_FUN; }
    ret sym.kind == resolve.SYM_FUN;
}

# the binding an address points into, or why the place it spells has no fixed address
rec Root {
    symbol:  comptime_deep.Symbol;
    refused: bool;
    why:     comptime.EvalFail;
}

fun root_refused(message: str) res[Root, fail.Fail] {
    ret res[Root, fail.Fail].ok{Root{refused: true, why: refused(message)}};
}

# the binding the place `eid` names, with the field and element steps from it to the place
# appended to `steps` in order: each a scalar holding the step's ordinal at the type it steps into
fun address_root(sc: *sema_context.SemaContext, eid: ast_id.ExprId, steps: *collections_vector.Vector[comptime_deep.Member], depth: u32) res[Root, fail.Fail] {
    if (depth >= REACH_DEPTH) { ret root_refused("this address steps too deep into its binding to be a constant"); }
    val named: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (sel named.some) { ret root_of(sc, named.some); }
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e_opt.none) { ret res[Root, fail.Fail].err{fail.message("sema: an address names no expression")}; }
    val e:      ast_expr.Expr = @e_opt.some;
    var object: ast_id.ExprId = ast_id.EXPR_NIL;
    if (e.kind == ast_expr.EXPR_KIND_MEMBER)                                     { object = e.data.member.object; }
    or (e.kind == ast_expr.EXPR_KIND_INDEX && !ast_expr.is_range(?e.data.index)) { object = e.data.index.object; }
    or                                                                           { ret root_refused("only the address of a module-level function, `val` or `var`, or of a place in one, is a constant"); }
    val root: res[Root, fail.Fail] = address_root(sc, object, steps, depth + 1);
    if (sel root.err)    { ret root; }
    if (root.ok.refused) { ret root; }

    val owner:   type.TypeId  = type.strip_secret(?sc.s.types, type_at(sc, object));
    var ordinal: u64          = 0;
    var name:    intern.StrId = intern.STR_NIL;
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        if (!type.is_record(?sc.s.types, owner) && !type.is_union(?sc.s.types, owner)) {
            ret root_refused("this address reaches through a pointer, and what a pointer points at is fixed only when the program runs");
        }
        val field: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, e.data.member.name.offset, e.data.member.name.len);
        if (sel field.err) { ret res[Root, fail.Fail].err{fail.refused(field.err)}; }
        name = field.ok;
        val count: u32 = type.field_count(?sc.s.types, owner);
        ordinal = count::u64;
        var i: u32 = 0;
        for (i < count) {
            val entry: opt[*type.FieldEntry] = type.field_at(?sc.s.types, owner, i);
            if (sel entry.some && intern.str_same(entry.some.name, name)) {
                ordinal = i::u64;
                brk;
            }
            i = i + 1;
        }
        if (ordinal == count::u64) { ret res[Root, fail.Fail].err{fail.message("sema: an address names a field its record does not declare")}; }
    }
    or {
        val elements: opt[u32] = type.element_count(?sc.s.types, owner);
        if (sel elements.none) {
            ret root_refused("this address reaches through a pointer, and what a pointer points at is fixed only when the program runs");
        }
        val at: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc,
            sc.typing.type_caps, sc.view.a, sc.view.source, e.data.index.index, ?sc.s.interner);
        if (sel at.err) { ret res[Root, fail.Fail].ok{Root{refused: true, why: at.err}}; }
        val index: opt[u64] = comptime.ct_int_u64(at.ok);
        if (sel index.none)                   { ret root_refused("an index into a constant address must be a non-negative integer"); }
        if (index.some >= elements.some::u64) { ret root_refused("this index is past the end of the binding it addresses"); }
        ordinal = index.some;
    }
    val step: res[u32, fail.Fail] = comptime_deep.node_add(sc.typing.values, comptime_deep.Node{kind: comptime_deep.NODE_SCALAR, ty: owner,
        value: comptime.ct_uint(ordinal)});
    if (sel step.err) { ret res[Root, fail.Fail].err{step.err}; }
    val pushed: res[usize, A.Error] = collections_vector.push[comptime_deep.Member](steps, comptime_deep.Member{name: name, node: step.ok});
    if (sel pushed.err) { ret res[Root, fail.Fail].err{fail.refused(pushed.err)}; }
    ret root;
}

# the binding `sym` names as an address leaf points into it: a module-level function, `val` or
# `var`, this module's or another's
fun root_of(sc: *sema_context.SemaContext, sym: *resolve.Symbol) res[Root, fail.Fail] {
    var kind: resolve.SymKind = sym.kind;
    if (kind == resolve.SYM_IMPORTED) { kind = sym.definition_kind; }
    val module_level: bool = sym.kind == resolve.SYM_IMPORTED || (sym.flags & resolve.SYM_FLAG_MODULE) != 0;
    if (kind != resolve.SYM_FUN && !((kind == resolve.SYM_VAL || kind == resolve.SYM_VAR) && module_level)) {
        ret root_refused("only the address of a module-level function, `val` or `var`, or of a place in one, is a constant");
    }
    var decl: ast_id.DeclId = sym.decl;
    if (sym.kind == resolve.SYM_IMPORTED) {
        val found: res[opt[Published], fail.Fail] = published(sc, sym);
        if (sel found.err)     { ret res[Root, fail.Fail].err{found.err}; }
        if (sel found.ok.none) { ret res[Root, fail.Fail].err{fail.message("sema: an imported binding has no declaration in its module's interface")}; }
        decl = found.ok.some.declaration.decl;
    }
    if (ast_id.decl_is_nil(decl)) { ret root_refused("only the address of a module-level function, `val` or `var`, or of a place in one, is a constant"); }
    ret res[Root, fail.Fail].ok{Root{symbol: comptime_deep.Symbol{module: module.stable_index(resolve.stable_of_module(sc.s, sym.origin)),
        decl: ast_id.decl_index(decl), canon: sym.canon, function: kind == resolve.SYM_FUN}}};
}
