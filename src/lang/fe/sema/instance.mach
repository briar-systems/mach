# the instances a module's sema discovers and the typing of each, which lowering reads
#
# an instance is one monomorphisation of a declaration: a generic at its type arguments, a
# function with comptime value parameters at their values, or a function with a pack at its
# element types. a frame is one typing of a stretch of syntax: frame 0 is the module's own
# typing, which the module's typing tables hold, each instance has a root frame, and each
# `$each` iteration has a frame under the frame its statement was typed in. a frame holds
# what its typing decided differently from its parent's: expression and binding types, the
# instance each call names, the verdict of each comptime gate, and the constant array each
# `$each` over one reads. a lookup walks a frame and its parents, and a miss falls to the
# module's typing tables
use std.collections.map;
use collections_vector: std.collections.vector;
use std.crypto.hash.fnv1a;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.fail;
use ast_id: mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.type;
use mach.lang.wide;

pub def Kind: u8;
pub val KIND_TYPE:  Kind = 0;
pub val KIND_VALUE: Kind = 1;
pub val KIND_PACK:  Kind = 2;

# the objects an instance is emitted in: the module's normal object, its test object, or both
pub def Reach: u8;
pub val REACH_NONE:    Reach = 0;
pub val REACH_NORMAL:  Reach = 1;
pub val REACH_TESTING: Reach = 2;

pub val NONE: u32 = 0xFFFFFFFF;

# the module's own typing, held by its typing tables
pub val FRAME_TEMPLATE: u32 = 0;

# who asked for an instance: an instance id, or one of these
pub val FROM_TEMPLATE: u32 = 0xFFFFFFFF;
pub val FROM_NORMAL:   u32 = 0xFFFFFFFE;
pub val FROM_TESTING:  u32 = 0xFFFFFFFD;

pub rec Instance {
    kind:   Kind;
    origin: session.ModuleId;
    decl:   ast_id.DeclId;
    # the type arguments, for a generic
    args:    *type.TypeId;
    arg_len: u32;
    # the comptime value arguments and the parameters they bind
    values:    *comptime.CTValue;
    names:     *intern.StrId;
    value_len: u32;
    # the pack's element types
    pack:     *type.TypeId;
    pack_len: u32;
    # the declaration's name as written and as its module defines it, and the signature
    # the instance was asked for at
    bare:  intern.StrId;
    canon: intern.StrId;
    sig:   type.TypeId;
    # the instance whose typing asked for this one first, how many such steps lie below
    # it, and the place it was asked for at
    parent:    u32;
    depth:     u32;
    site:      lang_source.Span;
    site_file: lang_source.FileId;
    frame:     u32;
    reach:     Reach;
    # the next instance whose key hashes alike
    next: u32;
}

pub rec Frame {
    parent: u32;
    stmt:   ast_id.StmtId;
    index:  u32;
    exprs:  map.Map[u32, type.TypeId];
    decls:  map.Map[u32, type.TypeId];
    calls:  map.Map[u32, u32];
    gates:  map.Map[u32, bool];
    arrays: map.Map[u32, comptime.CTValue];
    # the next iteration frame whose key hashes alike
    next: u32;
}

rec Edge {
    from: u32;
    to:   u32;
}

pub rec Set {
    alloc:     *A.Allocator;
    items:     collections_vector.Vector[Instance];
    frames:    collections_vector.Vector[Frame];
    edges:     collections_vector.Vector[Edge];
    by_key:    map.Map[u64, u32];
    iteration: map.Map[u64, u32];
}

pub rec Added {
    id:    u32;
    fresh: bool;
}

pub fun init(alloc: *A.Allocator) res[Set, fail.Fail] {
    var set: Set;
    set.alloc     = alloc;
    set.items     = collections_vector.init[Instance](alloc);
    set.frames    = collections_vector.init[Frame](alloc);
    set.edges     = collections_vector.init[Edge](alloc);
    set.by_key    = map.init[u64, u32](alloc);
    set.iteration = map.init[u64, u32](alloc);
    val root: res[u32, fail.Fail] = frame_add(?set, NONE, ast_id.STMT_NIL, 0);
    if (sel root.err) {
        dnit(?set);
        ret res[Set, fail.Fail].err{root.err};
    }
    ret res[Set, fail.Fail].ok{set};
}

pub fun dnit(set: *Set) {
    if (set == nil || set.alloc == nil) { ret; }
    var i: usize = 0;
    for (i < set.items.len) {
        val item: *Instance = ?set.items.data[i];
        if (item.args != nil && item.arg_len > 0)     { A.deallocate[type.TypeId](set.alloc, item.args, item.arg_len::usize); }
        if (item.values != nil && item.value_len > 0) { A.deallocate[comptime.CTValue](set.alloc, item.values, item.value_len::usize); }
        if (item.names != nil && item.value_len > 0)  { A.deallocate[intern.StrId](set.alloc, item.names, item.value_len::usize); }
        if (item.pack != nil && item.pack_len > 0)    { A.deallocate[type.TypeId](set.alloc, item.pack, item.pack_len::usize); }
        i = i + 1;
    }
    i = 0;
    for (i < set.frames.len) {
        val f: *Frame = ?set.frames.data[i];
        map.dnit[u32, type.TypeId](?f.exprs);
        map.dnit[u32, type.TypeId](?f.decls);
        map.dnit[u32, u32](?f.calls);
        map.dnit[u32, bool](?f.gates);
        map.dnit[u32, comptime.CTValue](?f.arrays);
        i = i + 1;
    }
    collections_vector.dnit[Instance](?set.items);
    collections_vector.dnit[Frame](?set.frames);
    collections_vector.dnit[Edge](?set.edges);
    map.dnit[u64, u32](?set.by_key);
    map.dnit[u64, u32](?set.iteration);
    set.alloc = nil;
}

pub fun count(set: *Set) u32 {
    if (set == nil) { ret 0; }
    ret set.items.len::u32;
}

pub fun at(set: *Set, id: u32) *Instance {
    ret ?set.items.data[id];
}

# the instance `item` names, added when no instance has its key; the arrays it points at are
# copied, and its frame, reach and chain are the set's to fill
pub fun add(set: *Set, item: Instance) res[Added, fail.Fail] {
    val have: opt[u32] = find(set, ?item);
    if (sel have.some) { ret res[Added, fail.Fail].ok{Added{id: have.some, fresh: false}}; }
    val h:    u64       = key_hash(?item);
    val head: opt[*u32] = map.get[u64, u32](?set.by_key, ?h);

    var owned: Instance = item;
    owned.args   = nil;
    owned.values = nil;
    owned.names  = nil;
    owned.pack   = nil;
    val args: res[*type.TypeId, fail.Fail] = types_copy(set, item.args, item.arg_len);
    if (sel args.err) { ret res[Added, fail.Fail].err{args.err}; }
    owned.args = args.ok;
    val pack: res[*type.TypeId, fail.Fail] = types_copy(set, item.pack, item.pack_len);
    if (sel pack.err) {
        types_free(set, owned.args, owned.arg_len);
        ret res[Added, fail.Fail].err{pack.err};
    }
    owned.pack = pack.ok;
    if (item.value_len > 0) {
        val vr: res[*comptime.CTValue, A.Error] = A.allocate[comptime.CTValue](set.alloc, item.value_len::usize);
        if (sel vr.err) {
            types_free(set, owned.args, owned.arg_len);
            types_free(set, owned.pack, owned.pack_len);
            ret res[Added, fail.Fail].err{fail.refused(vr.err)};
        }
        val nr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](set.alloc, item.value_len::usize);
        if (sel nr.err) {
            A.deallocate[comptime.CTValue](set.alloc, vr.ok, item.value_len::usize);
            types_free(set, owned.args, owned.arg_len);
            types_free(set, owned.pack, owned.pack_len);
            ret res[Added, fail.Fail].err{fail.refused(nr.err)};
        }
        var i: u32 = 0;
        for (i < item.value_len) {
            vr.ok[i] = item.values[i];
            nr.ok[i] = item.names[i];
            i        = i + 1;
        }
        owned.values = vr.ok;
        owned.names  = nr.ok;
    }

    val id:    u32                 = set.items.len::u32;
    val frame: res[u32, fail.Fail] = frame_add(set, NONE, ast_id.STMT_NIL, id);
    if (sel frame.err) {
        instance_free(set, ?owned);
        ret res[Added, fail.Fail].err{frame.err};
    }
    owned.frame = frame.ok;
    owned.reach = REACH_NONE;
    owned.next  = NONE;
    if (sel head.some) { owned.next = @head.some; }
    val pushed: res[usize, A.Error] = collections_vector.push[Instance](?set.items, owned);
    if (sel pushed.err) {
        instance_free(set, ?owned);
        ret res[Added, fail.Fail].err{fail.refused(pushed.err)};
    }
    val put: res[bool, A.Error] = map.insert[u64, u32](?set.by_key, h, id);
    if (sel put.err) { ret res[Added, fail.Fail].err{fail.refused(put.err)}; }
    ret res[Added, fail.Fail].ok{Added{id: id, fresh: true}};
}

# the instance with `item`'s key, if the set holds one
pub fun find(set: *Set, item: *Instance) opt[u32] {
    val h:    u64       = key_hash(item);
    val head: opt[*u32] = map.get[u64, u32](?set.by_key, ?h);
    var walk: u32       = NONE;
    if (sel head.some) { walk = @head.some; }
    for (walk != NONE) {
        if (key_same(?set.items.data[walk], item)) { ret opt[u32].some{walk}; }
        walk = set.items.data[walk].next;
    }
    ret opt[u32].none{};
}

fun instance_free(set: *Set, item: *Instance) {
    types_free(set, item.args, item.arg_len);
    types_free(set, item.pack, item.pack_len);
    if (item.values != nil && item.value_len > 0) { A.deallocate[comptime.CTValue](set.alloc, item.values, item.value_len::usize); }
    if (item.names != nil && item.value_len > 0)  { A.deallocate[intern.StrId](set.alloc, item.names, item.value_len::usize); }
}

fun types_copy(set: *Set, src: *type.TypeId, len: u32) res[*type.TypeId, fail.Fail] {
    if (src == nil || len == 0) { ret res[*type.TypeId, fail.Fail].ok{nil}; }
    val r: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](set.alloc, len::usize);
    if (sel r.err) { ret res[*type.TypeId, fail.Fail].err{fail.refused(r.err)}; }
    var i: u32 = 0;
    for (i < len) {
        r.ok[i] = src[i];
        i       = i + 1;
    }
    ret res[*type.TypeId, fail.Fail].ok{r.ok};
}

fun types_free(set: *Set, p: *type.TypeId, len: u32) {
    if (p != nil && len > 0) { A.deallocate[type.TypeId](set.alloc, p, len::usize); }
}

fun key_hash(item: *Instance) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u32(h, item.kind::u32);
    h = fnv1a.step_u32(h, module.index(item.origin));
    h = fnv1a.step_u32(h, ast_id.decl_index(item.decl));
    h = types_hash(h, item.args, item.arg_len);
    h = types_hash(h, item.pack, item.pack_len);
    h = fnv1a.step_u32(h, item.value_len);
    var i: u32 = 0;
    for (i < item.value_len) {
        h = value_hash(h, ?item.values[i]);
        i = i + 1;
    }
    ret h;
}

fun types_hash(seed: u64, p: *type.TypeId, len: u32) u64 {
    var h: u64 = fnv1a.step_u32(seed, len);
    var i: u32 = 0;
    for (i < len) {
        h = fnv1a.step_u32(h, type.index(p[i]));
        i = i + 1;
    }
    ret h;
}

# a value's identity is what names it in a symbol: an integer's value whatever its width, a
# float's bits, a string's text
fun value_hash(seed: u64, v: *comptime.CTValue) u64 {
    var h: u64 = fnv1a.step_u32(seed, v.kind::u32);
    if (v.kind == comptime.CT_KIND_INT) {
        h = fnv1a.step_u32(h, (v.data.w.lo & 0xFFFFFFFF)::u32);
        h = fnv1a.step_u32(h, (v.data.w.lo >> 32)::u32);
        h = fnv1a.step_u32(h, (v.data.w.hi & 0xFFFFFFFF)::u32);
        ret fnv1a.step_u32(h, (v.data.w.hi >> 32)::u32);
    }
    if (v.kind == comptime.CT_KIND_FLOAT) {
        val bits: u64 = float.f64_bits(v.data.f);
        h = fnv1a.step_u32(h, (bits & 0xFFFFFFFF)::u32);
        ret fnv1a.step_u32(h, (bits >> 32)::u32);
    }
    if (v.kind == comptime.CT_KIND_STR) { ret fnv1a.step_u32(h, intern.str_index(v.data.s)); }
    if (v.kind == comptime.CT_KIND_NODE) {
        h = fnv1a.step_u32(h, v.data.node.module);
        h = fnv1a.step_u32(h, v.data.node.node);
        ret fnv1a.step_u32(h, v.data.node.ty);
    }
    ret fnv1a.step_u32(h, v.data.t);
}

fun value_same(a: *comptime.CTValue, b: *comptime.CTValue) bool {
    if (a.kind != b.kind)                 { ret false; }
    if (a.kind == comptime.CT_KIND_INT)   { ret wide.eq(a.data.w, b.data.w); }
    if (a.kind == comptime.CT_KIND_FLOAT) { ret float.f64_bits(a.data.f) == float.f64_bits(b.data.f); }
    if (a.kind == comptime.CT_KIND_STR)   { ret intern.str_same(a.data.s, b.data.s); }
    if (a.kind == comptime.CT_KIND_NODE) {
        ret a.data.node.module == b.data.node.module && a.data.node.node == b.data.node.node && a.data.node.ty == b.data.node.ty;
    }
    ret a.data.t == b.data.t;
}

fun types_same(a: *type.TypeId, b: *type.TypeId, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        if (!type.same(a[i], b[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun key_same(a: *Instance, b: *Instance) bool {
    if (a.kind != b.kind || !module.same(a.origin, b.origin) || !ast_id.decl_same(a.decl, b.decl)) { ret false; }
    if (a.arg_len != b.arg_len || a.pack_len != b.pack_len || a.value_len != b.value_len)          { ret false; }
    if (!types_same(a.args, b.args, a.arg_len) || !types_same(a.pack, b.pack, a.pack_len))         { ret false; }
    var i: u32 = 0;
    for (i < a.value_len) {
        if (!value_same(?a.values[i], ?b.values[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun frame_add(set: *Set, parent: u32, stmt: ast_id.StmtId, index: u32) res[u32, fail.Fail] {
    var f: Frame;
    f.parent = parent;
    f.stmt   = stmt;
    f.index  = index;
    f.exprs  = map.init[u32, type.TypeId](set.alloc);
    f.decls  = map.init[u32, type.TypeId](set.alloc);
    f.calls  = map.init[u32, u32](set.alloc);
    f.gates  = map.init[u32, bool](set.alloc);
    f.arrays = map.init[u32, comptime.CTValue](set.alloc);
    f.next   = NONE;
    val id:     u32                 = set.frames.len::u32;
    val pushed: res[usize, A.Error] = collections_vector.push[Frame](?set.frames, f);
    if (sel pushed.err) { ret res[u32, fail.Fail].err{fail.refused(pushed.err)}; }
    ret res[u32, fail.Fail].ok{id};
}

fun iteration_hash(parent: u32, stmt: ast_id.StmtId, index: u32) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u32(h, parent);
    h = fnv1a.step_u32(h, ast_id.stmt_index(stmt));
    ret fnv1a.step_u32(h, index);
}

# the frame of iteration `index` of the `$each` at `stmt` typed in frame `parent`
pub fun iteration_at(set: *Set, parent: u32, stmt: ast_id.StmtId, index: u32) opt[u32] {
    val h:    u64       = iteration_hash(parent, stmt, index);
    val head: opt[*u32] = map.get[u64, u32](?set.iteration, ?h);
    if (sel head.none) { ret opt[u32].none{}; }
    var walk: u32 = @head.some;
    for (walk != NONE) {
        val f: *Frame = ?set.frames.data[walk];
        if (f.parent == parent && ast_id.stmt_same(f.stmt, stmt) && f.index == index) { ret opt[u32].some{walk}; }
        walk = f.next;
    }
    ret opt[u32].none{};
}

# the frame of an iteration, made the first time it is typed
pub fun iteration_add(set: *Set, parent: u32, stmt: ast_id.StmtId, index: u32) res[u32, fail.Fail] {
    val have: opt[u32] = iteration_at(set, parent, stmt, index);
    if (sel have.some) { ret res[u32, fail.Fail].ok{have.some}; }
    val h:    u64                 = iteration_hash(parent, stmt, index);
    val made: res[u32, fail.Fail] = frame_add(set, parent, stmt, index);
    if (sel made.err) { ret made; }
    val head: opt[*u32] = map.get[u64, u32](?set.iteration, ?h);
    if (sel head.some) { set.frames.data[made.ok].next = @head.some; }
    val put: res[bool, A.Error] = map.insert[u64, u32](?set.iteration, h, made.ok);
    if (sel put.err) { ret res[u32, fail.Fail].err{fail.refused(put.err)}; }
    ret made;
}

# an iteration's frame, rather than an instance's or the module's
pub fun frame_is_iteration(set: *Set, frame: u32) bool {
    ret set.frames.data[frame].parent != NONE;
}

pub fun expr_record(set: *Set, frame: u32, eid: ast_id.ExprId, ty: type.TypeId) err[fail.Fail] {
    val put: res[bool, A.Error] = map.insert[u32, type.TypeId](?set.frames.data[frame].exprs, ast_id.expr_index(eid), ty);
    if (sel put.err) { ret err[fail.Fail].err{fail.refused(put.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun decl_record(set: *Set, frame: u32, did: ast_id.DeclId, ty: type.TypeId) err[fail.Fail] {
    val put: res[bool, A.Error] = map.insert[u32, type.TypeId](?set.frames.data[frame].decls, ast_id.decl_index(did), ty);
    if (sel put.err) { ret err[fail.Fail].err{fail.refused(put.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun call_record(set: *Set, frame: u32, eid: ast_id.ExprId, id: u32) err[fail.Fail] {
    val put: res[bool, A.Error] = map.insert[u32, u32](?set.frames.data[frame].calls, ast_id.expr_index(eid), id);
    if (sel put.err) { ret err[fail.Fail].err{fail.refused(put.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun gate_record(set: *Set, frame: u32, cond: ast_id.ExprId, active: bool) err[fail.Fail] {
    val put: res[bool, A.Error] = map.insert[u32, bool](?set.frames.data[frame].gates, ast_id.expr_index(cond), active);
    if (sel put.err) { ret err[fail.Fail].err{fail.refused(put.err)}; }
    ret err[fail.Fail].ok{};
}

# the published constant value of the array the `$each` at `sid` reads
pub fun each_record(set: *Set, frame: u32, sid: ast_id.StmtId, array: comptime.CTValue) err[fail.Fail] {
    val put: res[bool, A.Error] = map.insert[u32, comptime.CTValue](?set.frames.data[frame].arrays, ast_id.stmt_index(sid), array);
    if (sel put.err) { ret err[fail.Fail].err{fail.refused(put.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun expr_type_at(set: *Set, frame: u32, eid: ast_id.ExprId) opt[type.TypeId] {
    val key:  u32 = ast_id.expr_index(eid);
    var walk: u32 = frame;
    for (walk != NONE) {
        val found: opt[*type.TypeId] = map.get[u32, type.TypeId](?set.frames.data[walk].exprs, ?key);
        if (sel found.some) { ret opt[type.TypeId].some{@found.some}; }
        walk = set.frames.data[walk].parent;
    }
    ret opt[type.TypeId].none{};
}

pub fun decl_type_at(set: *Set, frame: u32, did: ast_id.DeclId) opt[type.TypeId] {
    val key:  u32 = ast_id.decl_index(did);
    var walk: u32 = frame;
    for (walk != NONE) {
        val found: opt[*type.TypeId] = map.get[u32, type.TypeId](?set.frames.data[walk].decls, ?key);
        if (sel found.some) { ret opt[type.TypeId].some{@found.some}; }
        walk = set.frames.data[walk].parent;
    }
    ret opt[type.TypeId].none{};
}

# the instance the call or generic reference `eid` names in frame `frame`
pub fun call_at(set: *Set, frame: u32, eid: ast_id.ExprId) opt[u32] {
    val key:  u32 = ast_id.expr_index(eid);
    var walk: u32 = frame;
    for (walk != NONE) {
        val found: opt[*u32] = map.get[u32, u32](?set.frames.data[walk].calls, ?key);
        if (sel found.some) { ret opt[u32].some{@found.some}; }
        walk = set.frames.data[walk].parent;
    }
    ret opt[u32].none{};
}

pub fun gate_at(set: *Set, frame: u32, cond: ast_id.ExprId) opt[bool] {
    val key:  u32 = ast_id.expr_index(cond);
    var walk: u32 = frame;
    for (walk != NONE) {
        val found: opt[*bool] = map.get[u32, bool](?set.frames.data[walk].gates, ?key);
        if (sel found.some) { ret opt[bool].some{@found.some}; }
        walk = set.frames.data[walk].parent;
    }
    ret opt[bool].none{};
}

pub fun each_at(set: *Set, frame: u32, sid: ast_id.StmtId) opt[comptime.CTValue] {
    val key:  u32 = ast_id.stmt_index(sid);
    var walk: u32 = frame;
    for (walk != NONE) {
        val found: opt[*comptime.CTValue] = map.get[u32, comptime.CTValue](?set.frames.data[walk].arrays, ?key);
        if (sel found.some) { ret opt[comptime.CTValue].some{@found.some}; }
        walk = set.frames.data[walk].parent;
    }
    ret opt[comptime.CTValue].none{};
}

# `from` asked for instance `to`: an instance id, or who asked from outside any instance
pub fun edge_add(set: *Set, from: u32, to: u32) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[Edge](?set.edges, Edge{from: from, to: to});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# decides which objects each instance is emitted in: those of the declarations whose bodies
# reach it, through any chain of instances. an instance only a template reaches is emitted
# in none
pub fun reach_settle(set: *Set) err[fail.Fail] {
    var changed: bool = true;
    for (changed) {
        changed = false;
        var i: usize = 0;
        for (i < set.edges.len) {
            val e:    Edge  = set.edges.data[i];
            var from: Reach = REACH_NONE;
            if (e.from == FROM_NORMAL)   { from = REACH_NORMAL; }
            or (e.from == FROM_TESTING)  { from = REACH_TESTING; }
            or (e.from != FROM_TEMPLATE) { from = set.items.data[e.from].reach; }
            val now: Reach = set.items.data[e.to].reach | from;
            if (now != set.items.data[e.to].reach) {
                set.items.data[e.to].reach = now;
                changed                    = true;
            }
            i = i + 1;
        }
    }
    ret err[fail.Fail].ok{};
}
