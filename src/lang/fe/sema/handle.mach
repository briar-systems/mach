use lang_alloc:      mach.lang.alloc;
use diagnostic_kind: mach.lang.diagnostic.kind;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std_format: std.format;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use ast_type: mach.lang.fe.ast.type;
use mach.lang.fe.comptime;
use mach.lang.fe.decorator;
use mach.lang.fe.resolve;
use sema_context: mach.lang.fe.sema.context;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.session;
use lang_source:       mach.lang.source;
use target_definition: mach.lang.target.definition;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.mention;
use mach.lang.type.query.subst;
use mach.lang.type.visit;

val FIXED_ARGS: u32 = 2;

pub def ReadStatus: u8;
pub val READ_OK:      ReadStatus = 0;
val     READ_INERT:   ReadStatus = 1;
val     READ_REFUSED: ReadStatus = 2;

rec Read {
    status: ReadStatus;
    ctor:   u32;
    ops:    *u32;
    len:    u32;
}

fun decorator_of(sc: *sema_context.SemaContext, d: *ast_decl.Decl) *ast_decl.Decorator {
    val found: opt[*ast_decl.Decorator] = decorator.get(sc.view.a, d, decorator.HANDLE);
    if (sel found.none) { ret nil; }
    ret found.some;
}

pub fun arg_is_type(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, index: u32) bool {
    if (dec.id != decorator.HANDLE)                  { ret false; }
    if (index < FIXED_ARGS || index >= dec.args_len) { ret false; }
    val eid:   ast_id.ExprId       = sc.view.a.expr_ids.data[dec.args_start + index];
    val opt_e: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (!sel opt_e.some)                             { ret false; }
    if (opt_e.some.kind != ast_expr.EXPR_KIND_IDENT) { ret false; }
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    ret !type.is_error(handle_type_named(sc, opt_sym.some, 0));
}

fun handle_type_named(sc: *sema_context.SemaContext, sym: *resolve.Symbol, depth: u32) type.TypeId {
    if (depth > MAX_COMPOSE_DEPTH)                                       { ret type.TYPE_ERROR; }
    if (sym.kind != resolve.SYM_DEF && sym.kind != resolve.SYM_IMPORTED) { ret type.TYPE_ERROR; }

    if (sym.kind == resolve.SYM_DEF && module.same(sym.origin, sc.view.own_module)) {
        val opt_d: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
        if (!sel opt_d.some) { ret type.TYPE_ERROR; }
        val d: *ast_decl.Decl = opt_d.some;
        if (d.kind != ast_decl.DECL_KIND_DEF)    { ret type.TYPE_ERROR; }
        if (!ast_id.type_is_nil(d.data.def_.ty)) { ret type.TYPE_ERROR; }
        ret type_at(sc, sym.decl, d, depth + 1);
    }

    val ty: type.TypeId = sema_context.decl_type_for(sc, sym);
    if (!type.is_handle(?sc.s.types, ty)) { ret type.TYPE_ERROR; }
    ret ty;
}

pub val MAX_COMPOSE_DEPTH: u32 = 8;

pub fun read(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator, report: bool, depth: u32) Read {
    var out: Read;
    out.status = READ_REFUSED;
    out.ctor   = target_definition.NO_TYPE_CTOR;
    out.ops    = nil;
    out.len    = 0;

    if (d.kind != ast_decl.DECL_KIND_DEF) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_NOT_DEF, dec.name, "`handle` decorator applies only to a `def` declaration: `def` is the form that means a name denotes a type and promises no fields and no storage, which is exactly what a handle is"); }
        ret out;
    }
    if (!ast_id.type_is_nil(d.data.def_.ty)) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_HAS_BODY, dec.name, "a `handle` declaration has no body: the owning target supplies the definition, so `def Name;` declares it and `def Name: T;` is an ordinary alias"); }
        ret out;
    }
    if (dec.args_len < FIXED_ARGS) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_ARGUMENTS, dec.name, "`handle` decorator takes at least two string arguments: the target and the type constructor, followed by that constructor's operands"); }
        ret out;
    }

    val ctr_e: *ast_expr.Expr = arg_expr(sc, dec, 1);
    if (ctr_e == nil) { ret out; }
    val tgt_c: opt[str] = string_arg(sc, dec, 0, report);
    val ctr_c: opt[str] = string_arg(sc, dec, 1, report);
    if (sel tgt_c.none) { ret out; }
    if (sel ctr_c.none) { ret out; }

    val defs: *target_definition.Table = sc.view.ctx.env.target_defs;
    if (!target_is_selected(sc, tgt_c.some) || defs == nil || defs.type_count == 0) {
        out.status = READ_INERT;
        out.ctor   = target_definition.NO_TYPE_CTOR;
        ret out;
    }

    val td: *target_definition.Type = target_definition.type_of_region(defs, ctr_c.some, 0, str_len(ctr_c.some));
    if (td == nil) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_UNKNOWN_CONSTRUCTOR, ctr_e.span, "the selected target defines no type constructor of this name; the target's own table lists the constructors it mints and what each one takes"); }
        ret out;
    }

    val given: u32 = dec.args_len - FIXED_ARGS;
    if (given != td.arity) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_COUNT, dec.name, "the operand count does not match the constructor's: every operand the constructor takes is written, so a missing one would be minted as whatever the target defaulted it to and describe a different thing than the declaration does"); }
        ret out;
    }

    var ops: *u32 = nil;
    if (td.arity > 0) {
        val r_ops: res[*u32, A.Error] = A.allocate[u32](sc.s.alloc, td.arity::usize);
        if (sel r_ops.err) {
            fail.internal(?sc.status, lang_alloc.text(r_ops.err));
            ret out;
        }
        ops = r_ops.ok;
    }

    var ok: bool = true;
    var i:  u32  = 0;
    for (i < td.arity) {
        ops[i] = 0;
        if (td.operands[i] == target_definition.TYPE_OPERAND_WORD) {
            if (!read_word_operand(sc, dec, i, report, ?ops[i])) { ok = false; }
        }
        or {
            if (!read_type_operand(sc, dec, i, td, defs, report, depth, ?ops[i])) { ok = false; }
        }
        i = i + 1;
    }

    if (!ok) {
        if (ops != nil) { A.deallocate[u32](sc.s.alloc, ops, td.arity::usize); }
        ret out;
    }

    if (td.refuse != nil) {
        val why: str = td.refuse(ops, td.arity);
        if (why != nil) {
            if (report)     { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_REFUSED, dec.name, why); }
            if (ops != nil) { A.deallocate[u32](sc.s.alloc, ops, td.arity::usize); }
            ret out;
        }
    }

    out.status = READ_OK;
    out.ctor   = td.tag;
    out.ops    = ops;
    out.len    = td.arity;
    ret out;
}

pub fun release(sc: *sema_context.SemaContext, r: Read) {
    if (r.ops != nil) { A.deallocate[u32](sc.s.alloc, r.ops, r.len::usize); }
}

fun target_is_selected(sc: *sema_context.SemaContext, tgt: str) bool {
    val no: opt[str] = intern.get(?sc.s.interner, sc.view.ctx.env.target_isa);
    if (!sel no.some) { ret false; }
    ret str_equals(tgt, no.some);
}

# the target and the constructor are strings the target registry is searched for
fun string_arg(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32, report: bool) opt[str] {
    if (!report) { ret decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, ord); }
    ret sema_context.decorator_string_arg(sc, dec, ord, diagnostic_kind.HANDLE_ARGUMENTS,
        "the `handle` decorator's target and constructor arguments must be strings: they are matched against the target registry");
}

fun arg_expr(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, index: u32) *ast_expr.Expr {
    if (index >= dec.args_len) { ret nil; }
    val opt_e: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, sc.view.a.expr_ids.data[dec.args_start + index]);
    if (!sel opt_e.some) { ret nil; }
    ret opt_e.some;
}

fun read_word_operand(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, index: u32,
    report: bool, out: *u32) bool {
    val ord: u32            = FIXED_ARGS + index;
    val e:   *ast_expr.Expr = arg_expr(sc, dec, ord);
    if (e == nil) { ret false; }
    val eid:     ast_id.ExprId                            = sc.view.a.expr_ids.data[dec.args_start + ord];
    val outcome: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
    sema_context.record_eval_result(sc, outcome);
    if (sel outcome.err) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_WORD, e.span, "a `handle` operand must be a compile-time constant: it is a word the target writes into the type it mints, so it cannot depend on anything the program computes"); }
        ret false;
    }
    val v: comptime.CTValue = outcome.ok;
    if (v.kind != comptime.CT_KIND_INT) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_WORD, e.span, "a `handle` operand must fold to an integer: the target writes it into the type as one word"); }
        ret false;
    }
    if (comptime.ct_is_negative(v)) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_WORD, e.span, "a `handle` operand cannot be negative: the target writes it into the type as one unsigned word"); }
        ret false;
    }
    val word_o: opt[u64] = comptime.ct_int_u64(v);
    var word:   u64      = 0;
    if (sel word_o.some) { word = word_o.some; }
    if (!sel word_o.some || word > 0xFFFFFFFF) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_WORD, e.span, "a `handle` operand must fit one 32-bit word"); }
        ret false;
    }
    @out = word::u32;
    ret true;
}

fun read_type_operand(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, index: u32,
    td: *target_definition.Type, defs: *target_definition.Table, report: bool, depth: u32,
    out: *u32) bool {
    val want_tag: u32            = td.operands[index];
    val ord:      u32            = FIXED_ARGS + index;
    val e:        *ast_expr.Expr = arg_expr(sc, dec, ord);
    if (e == nil) { ret false; }
    if (e.kind != ast_expr.EXPR_KIND_IDENT) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_TYPE, e.span, "this `handle` operand is a type, not a value: the constructor composes over another handle, and NAMING the one it wraps is what keeps the two from disagreeing about the operands they share"); }
        ret false;
    }
    val eid:     ast_id.ExprId        = sc.view.a.expr_ids.data[dec.args_start + ord];
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    val inner: type.TypeId = handle_type_named(sc, opt_sym.some, depth);
    if (type.is_error(inner)) {
        if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_TYPE, e.span, "this `handle` operand must name a handle the same target mints: the constructor composes over one, and an ordinary type has nothing for it to wrap"); }
        ret false;
    }
    val opt_t: opt[*type.Type] = type.get(?sc.s.types, inner);
    if (!sel opt_t.some) { ret false; }
    val got_tag: u32 = opt_t.some.data.handle.ctor;
    if (got_tag != want_tag) {
        if (report) { report_wrong_ctor(sc, e, target_definition.type_by_tag(defs, want_tag)); }
        ret false;
    }
    if (td.compose != nil) {
        val h:   type.TypeHandle = opt_t.some.data.handle;
        var ops: *u32            = nil;
        if (h.ops_len > 0) { ops = ?sc.s.types.handle_ops[h.ops_start]; }
        val why: str = td.compose(index, ops, h.ops_len);
        if (why != nil) {
            if (report) { sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_TYPE, e.span, why); }
            ret false;
        }
    }
    @out = inner::u32;
    ret true;
}

fun report_wrong_ctor(sc: *sema_context.SemaContext, e: *ast_expr.Expr, want: *target_definition.Type) {
    if (want == nil) {
        sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_TYPE, e.span, "this `handle` operand names a handle the constructor cannot compose over");
        ret;
    }
    val rm: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "this `handle` operand must name a handle minted by the target's `{}` constructor; the one named here was minted by another, so the constructor has nothing to compose over",
        want.name);
    if (sel rm.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(rm.err)));
        sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_TYPE, e.span, "this `handle` operand names a handle the constructor cannot compose over");
        ret;
    }
    val msg: str = rm.ok;
    sema_context.report(sc, diagnostic_kind.HANDLE_OPERAND_TYPE, e.span, msg);
    A.deallocate[char](sc.s.alloc, msg::*char, str_len(msg) + 1);
}

fun intern_name(sc: *sema_context.SemaContext, span: lang_source.Span) intern.StrId {
    if (span.len == 0) { ret intern.STR_NIL; }
    val r: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, span.offset, span.len);
    if (sel r.err) {
        fail.internal(?sc.status, lang_alloc.text(r.err));
        ret intern.STR_NIL;
    }
    ret r.ok;
}

pub fun validate(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    release(sc, read(sc, d, dec, true, 0));
}

pub fun type_of(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) type.TypeId {
    ret type_at(sc, did, d, 0);
}

fun type_at(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl, depth: u32) type.TypeId {
    val dec: *ast_decl.Decorator = decorator_of(sc, d);
    if (dec == nil) { ret type.TYPE_ERROR; }

    val r: Read = read(sc, d, dec, false, depth);
    if (r.status == READ_REFUSED) { ret type.TYPE_ERROR; }

    val name: intern.StrId = intern_name(sc, d.data.def_.name);
    var tid:  type.TypeId  = type.TYPE_ERROR;
    if (r.status == READ_INERT) {
        val owner: type.TypeOwner = resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id);
        var site:  [3]u32;
        site[0] = owner.module::u32;
        site[1] = owner.file::u32;
        site[2] = name::u32;
        val outcome: res[type.TypeId, fail.Fail] = type.intern_handle(?sc.s.types, name, target_definition.NO_TYPE_CTOR, ?site[0], 3);
        if (sel outcome.ok)  { tid = outcome.ok; }
        or (sel outcome.err) { fail.internal(?sc.status, fail.describe(outcome.err)); }
    }
    or {
        val outcome: res[type.TypeId, fail.Fail] = type.intern_handle(?sc.s.types, name, r.ctor, r.ops, r.len);
        if (sel outcome.ok)  { tid = outcome.ok; }
        or (sel outcome.err) { fail.internal(?sc.status, fail.describe(outcome.err)); }
    }
    release(sc, r);
    ret tid;
}

pub fun check_annotation_handles_all(sc: *sema_context.SemaContext) {
    if (sc.view.type_resolved_ty == nil) { ret; }
    var i: u32 = 0;
    for (i < sc.view.a.types.len::u32) {
        check_annotation_handles(sc, ast_id.type(i));
        i = i + 1;
    }
}

pub fun type_carries_handle(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    ret type.carries_handle(?sc.s.types, t);
}

# a field or payload type carrying a handle, other than through a chain of pointers over one,
# which its annotation is refused for already
fun handle_storage_unreported(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    if (!type_carries_handle(sc, t)) { ret false; }
    ret !type.has_handle_pointer_pointer(?sc.s.types, t);
}

# a binding whose written annotation holds a chain of pointers over a handle has drawn that
# annotation's refusal, and a binding whose type is inferred has no annotation to draw it
pub fun annotation_refuses_indirection(sc: *sema_context.SemaContext, ann: ast_id.TypeId, t: type.TypeId) bool {
    if (ast_id.type_is_nil(ann)) { ret false; }
    ret type.has_handle_pointer_pointer(?sc.s.types, t);
}

pub fun check_handle_fields_all(sc: *sema_context.SemaContext) {
    if (sc.view.decl_type == nil) { ret; }
    var d: u32 = 0;
    for (d < sc.view.a.decls.len::u32) {
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, ast_id.decl(d));
        if (!sel d_opt.some) {
            d = d + 1;
            cnt;
        }
        val dd: *ast_decl.Decl = d_opt.some;
        if (dd.kind == ast_decl.DECL_KIND_REC) {
            check_handle_fields(sc, dd.data.rec_.fields_start, dd.data.rec_.fields_len);
        }
        or (dd.kind == ast_decl.DECL_KIND_UNI) {
            check_handle_fields(sc, dd.data.uni_.fields_start, dd.data.uni_.fields_len);
        }
        or (dd.kind == ast_decl.DECL_KIND_TAG) {
            var i: u32 = 0;
            for (i < dd.data.tag_.cases_len) {
                val c: *ast_decl.TagCase = ?sc.view.a.tag_cases.data[dd.data.tag_.cases_start + i];
                if (handle_storage_unreported(sc, sema_context.resolved_type_of(sc, c.payload))) {
                    sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, c.name, "a handle cannot be a tag payload because its representation is owned by the target");
                }
                i = i + 1;
            }
        }
        d = d + 1;
    }
}

fun check_handle_fields(sc: *sema_context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[start + i];
        if (handle_storage_unreported(sc, sema_context.resolved_type_of(sc, tn.ty))) {
            sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, tn.name,
                "a handle cannot be a record or union field: a record is storage the program owns at offsets it can compute, and a handle's representation is not the program's, so an aggregate holding one has no layout. declare the handle itself");
        }
        i = i + 1;
    }
}

# a function's parameters and result are values the program passes, and a handle reaches
# one by value or behind a pointer to its binding, never inside an array
pub fun check_handle_signature(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret; }
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[d.data.fun_.params_start + i];
        sema_context.check_handle_in_array(sc, sema_context.resolved_type_of(sc, tn.ty), tn.name);
        i = i + 1;
    }
    sema_context.check_handle_in_array(sc, sema_context.resolved_type_of(sc, d.data.fun_.return_type), d.data.fun_.name);
}

pub fun check_handle_decl(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) {
    if (sc.view.decl_type == nil)                { ret; }
    if (!sema_context.is_global_binding(d.kind)) { ret; }
    val ty:      type.TypeId = sc.view.decl_type[ast_id.decl_index(did)];
    val carries: bool        = type_carries_handle(sc, ty);
    val sampler: bool        = decorator.has(sc.view.a, d, decorator.SAMPLER);
    val storage: bool        = decorator.has(sc.view.a, d, decorator.STORAGE);

    if (carries && !type.is_handle(?sc.s.types, ty)) {
        if (annotation_refuses_indirection(sc, d.data.bind.ty, ty)) { ret; }
        sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, d.span,
            "a handle cannot sit behind a pointer or inside an array: a pointer and an array are both extents the program computes, and a handle's extent is the owning target's rather than the program's, so there is no element size to step by. declare the handle itself");
        ret;
    }
    if (!carries) {
        if (sampler) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, d.span,
                "`sampler` decorator applies only to a handle binding, a `def` declared with `#[handle(...)]`; a descriptor-bound block or buffer of an ordinary type is `#[uniform(set, binding)]` or `#[storage(set, binding)]`");
        }
        ret;
    }

    val bind: u32 = handle_binding(sc, ty);
    if (bind == HANDLE_BIND_EITHER && (sampler || storage))       { ret; }
    if (bind == target_definition.HANDLE_BIND_STORAGE && storage) { ret; }
    if (bind == target_definition.HANDLE_BIND_SAMPLER && sampler) { ret; }
    if (bind == target_definition.HANDLE_BIND_STORAGE && sampler) {
        sema_context.report(sc, diagnostic_kind.HANDLE_ROLE, d.span,
            "a storage image binds through `#[storage(set, binding)]`, not `#[sampler(set, binding)]`: an image whose `Sampled` operand is `2` is read and written directly, which is Vulkan's STORAGE_IMAGE descriptor, and `\"readonly\"`, `\"writeonly\"` and `\"coherent\"` qualify it as they do a buffer");
        ret;
    }
    if (bind == target_definition.HANDLE_BIND_SAMPLER && storage) {
        sema_context.report(sc, diagnostic_kind.HANDLE_ROLE, d.span,
            "this handle binds through `#[sampler(set, binding)]`, not `#[storage(set, binding)]`: a sampled image, a sampled-image pair and a sampler are read through a sampler and never written, so they are no storage descriptor. only an image whose `Sampled` operand is `2` binds as storage");
        ret;
    }
    if (decorator.has(sc.view.a, d, decorator.INPUT) || decorator.has(sc.view.a, d, decorator.OUTPUT)
        || decorator.has(sc.view.a, d, decorator.BUILTIN) || decorator.has(sc.view.a, d, decorator.UNIFORM)
        || decorator.has(sc.view.a, d, decorator.PUSH) || decorator.has(sc.view.a, d, decorator.SHARED)) {
        sema_context.report(sc, diagnostic_kind.HANDLE_ROLE, d.span,
            "a handle is bound as a descriptor and carries `#[sampler(set, binding)]`, or `#[storage(set, binding)]` for a storage image; the role on it puts the handle in a storage class no handle may live in");
        ret;
    }
    sema_context.report(sc, diagnostic_kind.HANDLE_UNBOUND, d.span,
        "a handle binding needs a `#[sampler(set, binding)]` decorator, or `#[storage(set, binding)]` for a storage image: a shader has no general global storage, so a handle with no descriptor address is reachable from no stage");
}

# a handle whose target is not the selected one names no operands this build reads,
# so either descriptor role binds it
val HANDLE_BIND_EITHER: u32 = 0xFFFFFFFF;

# the descriptor role the selected target binds a handle type through
fun handle_binding(sc: *sema_context.SemaContext, ty: type.TypeId) u32 {
    val opt_t: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (!sel opt_t.some) { ret HANDLE_BIND_EITHER; }
    val h: type.TypeHandle = opt_t.some.data.handle;
    if (h.ctor == target_definition.NO_TYPE_CTOR) { ret HANDLE_BIND_EITHER; }
    val td: *target_definition.Type = target_definition.type_by_tag(sc.view.ctx.env.target_defs, h.ctor);
    if (td == nil) { ret HANDLE_BIND_EITHER; }
    var ops: *u32 = nil;
    if (h.ops_len > 0) { ops = ?sc.s.types.handle_ops[h.ops_start]; }
    ret target_definition.type_binding(td, ops, h.ops_len);
}

# a generic record, union or tag instantiated so that a field or payload holds a handle,
# directly or through a pointer, array or secret: the instance is the declaration its
# arguments spell, and the same declaration written out is refused for that field. a
# pointer to a pointer to a handle is refused at the annotation that spells or forms it
pub fun check_annotation_handles(sc: *sema_context.SemaContext, ast_tid: ast_id.TypeId) {
    if (sc.view.type_resolved_ty == nil)                        { ret; }
    if (ast_id.type_index(ast_tid) >= sc.view.a.types.len::u32) { ret; }
    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, ast_tid);
    if (!sel t_opt.some) { ret; }
    check_handle_indirection(sc, sc.view.type_resolved_ty[ast_id.type_index(ast_tid)], t_opt.some.span);
    val tid: type.TypeId = sema_context.apply_subst(sc, sc.view.type_resolved_ty[ast_id.type_index(ast_tid)]);
    if (type.is_nil(tid) || type.is_error(tid)) { ret; }

    var q:    type_query.Query = sema_context.query_of(sc);
    var scan: type.TypeScan;
    if (!type_query.scan_begin(?q, ?scan)) { ret; }
    var at: Held = Held{sc: sc, q: ?q, scan: ?scan, span: t_opt.some.span};
    held_walk(?at, tid);
    type_query.scan_end(?q, ?scan);
}

val HANDLE_INDIRECTION_MESSAGE: str = "a handle cannot sit behind a pointer to a pointer: a handle's address is the descriptor binding it is read from, and a `*Handle` already names that binding, so a second indirection is a pointer the program stores and may reassign, which roots the handle at no binding. take the handle as `*Handle` (`img: *Image`) and pass the binding's address (`f(?binding)`)";

# where an annotation's handle check reports
rec Site {
    sc:   *sema_context.SemaContext;
    span: lang_source.Span;
}

# a pointer to a pointer to a handle roots the handle at no binding. every annotation is
# visited once and a written chain has one annotation at its innermost double pointer, so
# that one site reports. an instance reports only a chain its substitution forms, once per
# type, since the template already reported every written one and its sites repeat
fun check_handle_indirection(sc: *sema_context.SemaContext, raw: type.TypeId, span: lang_source.Span) {
    if (type.is_nil(raw) || type.is_error(raw)) { ret; }
    val s: *session.Session = sc.s;
    if (sc.instance.subst == nil) {
        val opt_t: opt[*type.Type] = type.get(?s.types, raw);
        if (!sel opt_t.some)                             { ret; }
        if (opt_t.some.kind != type.TYPE_POINTER)        { ret; }
        if (!type.handle_pointer_pointer(?s.types, raw)) { ret; }
        sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, span, HANDLE_INDIRECTION_MESSAGE);
        ret;
    }
    if (!type.mentions_generic_param(?s.types, raw)) { ret; }
    var at: Site             = Site{sc: sc, span: span};
    var w:  visit.Walk[Site] = visit.Walk[Site]{types: ?s.types, status: ?sc.status, scan: nil,
        edges: visit.EDGES_SPELLING, ctx: ?at, leaf: indirection_leaf};
    visit.reaches[Site](?w, sema_context.apply_subst(sc, raw));
}

fun indirection_leaf(at: *Site, tid: type.TypeId, t: *type.Type) visit.Verdict {
    val sc: *sema_context.SemaContext = at.sc;
    if (type.handle_pointer_pointer(?sc.s.types, tid)) {
        if (sema_context.uni_report_mark(sc.typing.handle_reports, tid)) {
            sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, at.span, HANDLE_INDIRECTION_MESSAGE);
        }
        ret visit.PRUNE;
    }
    if (t.kind == type.TYPE_SECRET || t.kind == type.TYPE_POINTER || t.kind == type.TYPE_ARRAY
        || t.kind == type.TYPE_FUN || t.kind == type.TYPE_INSTANCE) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# an instance check's walk: the context it reports in, the query its type questions go
# to, the instances already checked, and the annotation it reports at
rec Held {
    sc:   *sema_context.SemaContext;
    q:    *type_query.Query;
    scan: *type.TypeScan;
    span: lang_source.Span;
}

fun held_walk(at: *Held, tid: type.TypeId) {
    var w: visit.Walk[Held] = visit.Walk[Held]{types: at.q.types, status: at.q.status, scan: nil,
        edges: visit.EDGE_BASE | visit.EDGE_POINTEE | visit.EDGE_ELEMENT | visit.EDGE_SIGNATURE, ctx: at,
        leaf:  held_leaf};
    visit.reaches[Held](?w, tid);
}

fun held_leaf(at: *Held, tid: type.TypeId, t: *type.Type) visit.Verdict {
    if (t.kind == type.TYPE_INSTANCE) {
        held_instance(at, tid, t);
        ret visit.PRUNE;
    }
    if (t.kind == type.TYPE_SECRET || t.kind == type.TYPE_POINTER || t.kind == type.TYPE_ARRAY
        || t.kind == type.TYPE_FUN) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether an instance's fields carry a handle turns only on which of its arguments carry
# one, so instances agreeing on that are one visit: a pointer-recursive generic whose
# arguments grow at every level is then still a finite walk
fun handle_visit_key(q: *type_query.Query, gnom: type.TypeId, args: *type.TypeId, args_len: u32) opt[type.TypeId] {
    val plain: opt[type.TypeId] = type.prim(q.types, type.TYPE_U8);
    if (sel plain.none) {
        fail.internal(q.status, "handle instance walk: the u8 type is not interned");
        ret opt[type.TypeId].none{};
    }
    val res_canon: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](q.types.a, args_len::usize);
    if (sel res_canon.err) {
        type_query.refused(q, res_canon.err);
        ret opt[type.TypeId].none{};
    }
    val canon: *type.TypeId = res_canon.ok;
    fin { A.deallocate[type.TypeId](q.types.a, canon, args_len::usize); }
    var i: u32 = 0;
    for (i < args_len) {
        canon[i] = plain.some;
        if (type.carries_handle(q.types, args[i])) { canon[i] = carried_handle(q, args[i]); }
        i = i + 1;
    }
    val key: res[type.TypeId, fail.Fail] = type.intern_instance(q.types, gnom, canon, args_len);
    if (sel key.err) {
        type_query.failed(q, key.err);
        ret opt[type.TypeId].none{};
    }
    ret opt[type.TypeId].some{key.ok};
}

fun mention_leaf(q: *type_query.Query, tid: type.TypeId, t: *type.Type) visit.Verdict {
    if (t.kind == type.TYPE_HANDLE) { ret visit.FOUND; }
    if (t.kind == type.TYPE_SECRET || t.kind == type.TYPE_POINTER || t.kind == type.TYPE_ARRAY
        || t.kind == type.TYPE_FUN || t.kind == type.TYPE_INSTANCE) {
        ret visit.DESCEND;
    }
    ret visit.PRUNE;
}

# whether a handle appears anywhere `tid` is spelled
fun mentions_handle(q: *type_query.Query, tid: type.TypeId) bool {
    var w: visit.Walk[type_query.Query] = visit.Walk[type_query.Query]{types: q.types, status: q.status, scan: nil,
        edges: visit.EDGES_SPELLING, ctx: q, leaf: mention_leaf};
    ret visit.reaches[type_query.Query](?w, tid);
}

# the handle a type carries, under every pointer, array and secret over it
fun carried_handle(q: *type_query.Query, tid: type.TypeId) type.TypeId {
    val opt_t: opt[*type.Type] = type.get(q.types, tid);
    if (!sel opt_t.some) { ret tid; }
    val t: *type.Type = opt_t.some;
    if (t.kind == type.TYPE_SECRET)  { ret carried_handle(q, t.data.secret.base); }
    if (t.kind == type.TYPE_POINTER) { ret carried_handle(q, t.data.pointer.base); }
    if (t.kind == type.TYPE_ARRAY)   { ret carried_handle(q, t.data.array.base); }
    ret tid;
}

fun held_instance(at: *Held, tid: type.TypeId, t: *type.Type) {
    val sc: *sema_context.SemaContext = at.sc;
    val q:  *type_query.Query         = at.q;

    val gnom:       type.TypeId = t.data.instance.nominal;
    val args_start: u32         = t.data.instance.args_start;
    val args_len:   u32         = t.data.instance.args_len;
    if (args_len == 0) { ret; }

    val res_args: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](q.types.a, args_len::usize);
    if (sel res_args.err) {
        type_query.refused(q, res_args.err);
        ret;
    }
    val args: *type.TypeId = res_args.ok;
    fin { A.deallocate[type.TypeId](q.types.a, args, args_len::usize); }
    var i: u32 = 0;
    for (i < args_len) {
        val a_opt: opt[type.TypeId] = type.get_param(q.types, args_start + i);
        if (!sel a_opt.some) { ret; }
        args[i] = a_opt.some;
        held_walk(at, args[i]);
        i = i + 1;
    }

    # an instance none of whose arguments mentions a handle has fields holding none, since
    # a generic's own fields are checked as its declaration
    var mentioned: bool = false;
    i = 0;
    for (i < args_len) {
        if (mentions_handle(q, args[i])) { mentioned = true; }
        i = i + 1;
    }
    if (!mentioned) { ret; }

    # a chain of pointers over a handle in an argument is refused at its annotation, so a
    # field that holds a handle only through that chain draws nothing more here
    var arg_chain: bool = false;
    i = 0;
    for (i < args_len) {
        if (type.has_handle_pointer_pointer(q.types, args[i])) { arg_chain = true; }
        i = i + 1;
    }

    val key: opt[type.TypeId] = handle_visit_key(q, gnom, args, args_len);
    if (sel key.none)                                 { ret; }
    if (!type_query.scan_fresh(q, at.scan, key.some)) { ret; }

    # fields that mention no parameter are the declaration's own, which its check covers
    val who_opt: opt[type.GenericOwner] = mention.owner(q, gnom);
    if (!sel who_opt.some) { ret; }
    var who: type.GenericOwner = who_opt.some;

    val opt_tab: opt[*type.FieldTable] = type.field_table_for(q.types, gnom);
    if (!sel opt_tab.some) { ret; }
    val fields_len: u32 = opt_tab.some.fields_len;
    var f:          u32 = 0;
    for (f < fields_len) {
        val e_opt: opt[*type.FieldEntry] = type.field_at(q.types, gnom, f);
        if (!sel e_opt.some) { ret; }
        val fty: type.TypeId = subst.apply(q, e_opt.some.ty, ?who, args, args_len);
        if (sel q.status.kind.internal) { ret; }
        if (type.carries_handle(q.types, fty)) {
            if (arg_chain && type.has_handle_pointer_pointer(q.types, fty)) { ret; }
            if (sema_context.uni_report_mark(sc.typing.handle_reports, tid)) {
                sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, at.span, "a handle cannot be a record or union field or a tag payload, and this instantiation puts one there: an instance is the declaration its type arguments spell, a record is storage the program owns at offsets it can compute, and a handle's representation is not the program's, so an aggregate holding one has no layout. pass the handle itself, or a pointer to its binding, instead");
            }
            ret;
        }
        held_walk(at, fty);
        f = f + 1;
    }
}
