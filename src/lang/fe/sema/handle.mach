# the `#[handle(target, constructor, operands...)]` directive (#2888)
#
# A bodyless `def` carrying this directive declares a type whose representation is
# not the program's: the owning target mints it and the pipeline binds it. The
# directive names the target and the constructor and hands over operands, and every
# fact beyond "there is a constructor of this name taking these operands" belongs to
# the target's own definition table. NOTHING HERE NAMES A TARGET.
#
# The rules a handle carries are FIXED AND CLOSED, never varied per declaration, and
# each follows from the one fact the directive states. They are checked where the
# question is asked rather than here: a field of one in `sema.check_handle_fields`, a
# local binding of one in the binding check, a value use of one in `infer`. This
# module owns the declaration itself - reading it, refusing it, and interning the
# type it denotes.
#
# THE OPERANDS ARE ORDINARY COMPTIME CONSTANTS but one position is not: a constructor
# that composes over another type takes a TYPE NAME. That is the only place a
# decorator argument is read as a type rather than as a value, and it is scoped to
# this directive precisely so it does not become a general rule. It exists because
# the alternative is a `sampled_image` restating the operands of the image it wraps,
# which is two copies of one fact that agree by hand rather than by construction.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.char.char;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use format: std.format;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.type;
use intern: mach.lang.intern;
use isa: mach.lang.target.isa;

# the directive's name, and the count of arguments that precede its operands
pub val DIRECTIVE: str = "handle";
val FIXED_ARGS: u32 = 2;

# how reading a `#[handle]` declaration came out
#
# `INERT` is an ordinary answer, not a failure: the selected target defines no type
# constructors at all, so it holds no opinion about this spelling. The declaration
# still denotes a type, sized at the target's pointer width, so a library declaring
# handles compiles on a machine target and a program that reaches one there fails at
# the operation rather than at the declaration.
pub def ReadStatus: u8;
pub val READ_OK:      ReadStatus = 0;
pub val READ_INERT:   ReadStatus = 1;
pub val READ_REFUSED: ReadStatus = 2;

# a read `#[handle]` declaration
# ---
# status: how the read came out
# ctor:   the owning target's constructor tag, when status is READ_OK
# ops:    the resolved operand words, owned by the caller's allocator, or nil
# len:    number of operand words
pub rec Read {
    status: ReadStatus;
    ctor:   u32;
    ops:    *u32;
    len:    u32;
}

# whether `dec` names directive `name`
# ---
# sc:   the context
# dec:  the decorator
# name: the directive name
# ret:  true when the decorator is that directive
fun decorator_is(sc: *context.SemaContext, dec: *decl.Decorator, name: str) bool {
    ret str_region_equals(sc.source, dec.name.offset, dec.name.len, name);
}

# the `#[handle]` decorator on `d`, or nil
# ---
# sc: the context
# d:  the decl to search
# ret: the decorator, or nil
pub fun decorator_of(sc: *context.SemaContext, d: *decl.Decl) *decl.Decorator {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (decorator_is(sc, dec, DIRECTIVE)) { ret dec; }
        i = i + 1;
    }
    ret nil;
}

# whether `d` is a declaration this directive owns: a bodyless `def` carrying it
# ---
# sc: the context
# d:  the decl to test
# ret: true for a bodyless `def` with a `#[handle]`
pub fun declares_handle(sc: *context.SemaContext, d: *decl.Decl) bool {
    if (d.kind != decl.DECL_KIND_DEF)  { ret false; }
    if (d.data.def_.ty != id.TYPE_NIL) { ret false; }
    ret decorator_of(sc, d) != nil;
}

# whether argument `index` of `dec` is a TYPE position rather than a value one
#
# THIS IS THE WHOLE SCOPE OF THE TYPE-NAME ARGUMENT. It is asked only of this
# directive, and only of an argument that is a bare identifier already resolved to a
# symbol that denotes a type. Everything else in every decorator, including every
# other argument of this one, stays an expression position.
#
# The question is answered WITHOUT a target, because it has to be: a library
# declaring handles is compiled on machine targets too, and which target a module is
# built for is not a property of the source. A target's constructor row says which
# operands it will accept as types, and this says which the reader wrote as one. The
# two are compared where the declaration is checked.
#
# It is also answered WITHOUT the constructor row, and that is what makes it scoped:
# an argument qualifies only by naming a handle, so no other decorator and no other
# argument shape gains a type position from this.
# ---
# sc:    the context
# dec:   the decorator
# index: which argument
# ret:   true when the argument names a type
pub fun arg_is_type(sc: *context.SemaContext, dec: *decl.Decorator, index: u32) bool {
    if (!decorator_is(sc, dec, DIRECTIVE)) { ret false; }
    if (index < FIXED_ARGS || index >= dec.args_len) { ret false; }
    val eid: id.ExprId = sc.a.expr_ids[dec.args_start + index];
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](opt_e)) { ret false; }
    if (O.unwrap[*expr.Expr](opt_e).kind != expr.EXPR_KIND_IDENT) { ret false; }
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
    ret handle_type_named(sc, O.unwrap[*resolve.Symbol](opt_sym), 0) != type.TYPE_ERROR;
}

# the handle type a resolved symbol names, or TYPE_ERROR
#
# RESOLVED THROUGH THE DECLARATION, not through the module's typing snapshot. The
# snapshot is filled in source order, and a handle composing over one declared
# further down the file is an ordinary forward reference that must work, so reading
# the snapshot would make composition depend on declaration order. A local `def` is
# read from this module's AST the same way `def_underlying` reads an alias. An
# imported one has a finished snapshot and is read from it.
#
# `depth` bounds a constructor that composes over itself, directly or through a
# ring. Such a ring names no type - each member is defined only in terms of the
# next - so it is refused rather than followed.
# ---
# sc:    the context
# sym:   the symbol
# depth: how many compositions deep this resolution already is
# ret:   the handle's TypeId, or TYPE_ERROR when the name is not a handle
fun handle_type_named(sc: *context.SemaContext, sym: *resolve.Symbol, depth: u32) type.TypeId {
    if (depth > MAX_COMPOSE_DEPTH) { ret type.TYPE_ERROR; }
    if (sym.kind != resolve.SYM_DEF && sym.kind != resolve.SYM_IMPORTED) { ret type.TYPE_ERROR; }

    if (sym.kind == resolve.SYM_DEF && sym.origin == sc.own_module) {
        val opt_d: O.Option[*decl.Decl] = ast.get_decl(sc.a, sym.decl);
        if (O.is_none[*decl.Decl](opt_d)) { ret type.TYPE_ERROR; }
        val d: *decl.Decl = O.unwrap[*decl.Decl](opt_d);
        if (d.kind != decl.DECL_KIND_DEF)  { ret type.TYPE_ERROR; }
        if (d.data.def_.ty != id.TYPE_NIL) { ret type.TYPE_ERROR; }
        ret type_at(sc, sym.decl, d, depth + 1);
    }

    val ty: type.TypeId = context.decl_type_for(sc, sym);
    if (!type.is_handle(?sc.s.types, ty)) { ret type.TYPE_ERROR; }
    ret ty;
}

# how many compositions deep a constructor chain may go
#
# A chain is a declaration composing over a declaration, and a ring of them defines
# nothing, so the bound exists to end one rather than to cap a legitimate depth: no
# real chain is anywhere near it, and one that were would be a target defining
# constructors that wrap constructors eight deep.
val MAX_COMPOSE_DEPTH: u32 = 8;

# read and check a `#[handle]` declaration, optionally reporting
#
# ONE READER FOR BOTH CALLERS. The validation pass reports and the type resolver
# interns, and if each read the directive its own way the accepted declarations and
# the interned types could disagree. The two differ only in `report`.
# ---
# sc:     the context
# d:      the decorated decl
# dec:    the `handle` decorator
# report: whether to report what is refused
# depth:  how many compositions deep this read already is
# ret:    the read
pub fun read(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator, report: bool, depth: u32) Read {
    var out: Read;
    out.status = READ_REFUSED;
    out.ctor   = isa.NO_TYPE_CTOR;
    out.ops    = nil;
    out.len    = 0;

    if (d.kind != decl.DECL_KIND_DEF) {
        if (report) { context.report(sc, dec.name, "`handle` decorator applies only to a `def` declaration: `def` is the form that means a name denotes a type and promises no fields and no storage, which is exactly what a handle is"); }
        ret out;
    }
    if (d.data.def_.ty != id.TYPE_NIL) {
        if (report) { context.report(sc, dec.name, "a `handle` declaration has no body: the owning target supplies the definition, so `def Name;` declares it and `def Name: T;` is an ordinary alias"); }
        ret out;
    }
    if (dec.args_len < FIXED_ARGS) {
        if (report) { context.report(sc, dec.name, "`handle` decorator takes at least two string arguments: the target and the type constructor, followed by that constructor's operands"); }
        ret out;
    }

    val tgt_e: *expr.Expr = arg_expr(sc, dec, 0);
    val ctr_e: *expr.Expr = arg_expr(sc, dec, 1);
    if (tgt_e == nil || ctr_e == nil) { ret out; }
    if (tgt_e.kind != expr.EXPR_KIND_LIT_STR || ctr_e.kind != expr.EXPR_KIND_LIT_STR) {
        if (report) { context.report(sc, dec.name, "the `handle` decorator's target and constructor arguments must be string literals: they are matched against the target registry rather than evaluated"); }
        ret out;
    }
    if (tgt_e.span.len < 2::usize || ctr_e.span.len < 2::usize) { ret out; }

    # a target the selected one is not holds no opinion about this declaration, and
    # neither does a target that defines no type constructors. the declaration is
    # inert rather than wrong: it still denotes a type, at the target's pointer
    # width, so a library of handles compiles on a machine target.
    val defs: *isa.TargetDefs = sc.ctx.target_defs;
    if (!target_is_selected(sc, tgt_e) || defs == nil || defs.type_count == 0) {
        out.status = READ_INERT;
        out.ctor   = isa.NO_TYPE_CTOR;
        ret out;
    }

    val td: *isa.TypeDef = isa.type_def_of_region(defs, sc.source,
        ctr_e.span.offset + 1::usize, ctr_e.span.len - 2::usize);
    if (td == nil) {
        if (report) { context.report(sc, ctr_e.span, "the selected target defines no type constructor of this name; the target's own table lists the constructors it mints and what each one takes"); }
        ret out;
    }

    val given: u32 = dec.args_len - FIXED_ARGS;
    if (given != td.arity) {
        if (report) { context.report(sc, dec.name, "the operand count does not match the constructor's: every operand the constructor takes is written, so a missing one would be minted as whatever the target defaulted it to and describe a different thing than the declaration does"); }
        ret out;
    }

    var ops: *u32 = nil;
    if (td.arity > 0) {
        val r_ops: R.Result[*u32, str] = A.allocate[u32](sc.s.alloc, td.arity::usize);
        if (R.is_err[*u32, str](r_ops)) { ret out; }
        ops = R.unwrap_ok[*u32, str](r_ops);
    }

    var ok: bool = true;
    var i:  u32  = 0;
    for (i < td.arity) {
        ops[i] = 0;
        if (td.operands[i] == isa.TYPE_OPERAND_WORD) {
            if (!read_word_operand(sc, dec, i, report, ?ops[i])) { ok = false; }
        }
        or {
            if (!read_type_operand(sc, dec, i, td.operands[i], defs, report, depth, ?ops[i])) { ok = false; }
        }
        i = i + 1;
    }

    if (!ok) {
        if (ops != nil) { A.deallocate[u32](sc.s.alloc, ops, td.arity::usize); }
        ret out;
    }

    # the target's own refusal, keyed to the operand that causes it. this is where
    # the reasons a spelling grammar used to carry survive: the compiler still owns
    # every one of them, and each is now triggered by a fact rather than by a string
    if (td.refuse != nil) {
        val why: str = td.refuse(ops, td.arity);
        if (why != nil) {
            if (report) { context.report(sc, dec.name, why); }
            if (ops != nil) { A.deallocate[u32](sc.s.alloc, ops, td.arity::usize); }
            ret out;
        }
    }

    out.status = READ_OK;
    out.ctor   = td.tag;
    out.ops    = ops;
    out.len    = td.arity;
    ret out;
}

# release a read's operand buffer
# ---
# sc: the context
# r:  the read to release
pub fun release(sc: *context.SemaContext, r: Read) {
    if (r.ops != nil) { A.deallocate[u32](sc.s.alloc, r.ops, r.len::usize); }
}

# whether the directive's target argument names the target this build selected
# ---
# sc:    the context
# tgt_e: the target-name string literal
# ret:   true when the selected target's isa is spelled here
fun target_is_selected(sc: *context.SemaContext, tgt_e: *expr.Expr) bool {
    val no: O.Option[str] = intern.lookup(?sc.s.interner, sc.ctx.target_isa);
    if (O.is_none[str](no)) { ret false; }
    val isa_name: str = O.unwrap[str](no);
    ret str_region_equals(sc.source, tgt_e.span.offset + 1::usize,
                          tgt_e.span.len - 2::usize, isa_name);
}

# argument `index` of `dec`, or nil
# ---
# sc:    the context
# dec:   the decorator
# index: which argument
# ret:   the expression, or nil
fun arg_expr(sc: *context.SemaContext, dec: *decl.Decorator, index: u32) *expr.Expr {
    if (index >= dec.args_len) { ret nil; }
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start + index]);
    if (O.is_none[*expr.Expr](opt_e)) { ret nil; }
    ret O.unwrap[*expr.Expr](opt_e);
}

# fold operand `index` to a literal word
# ---
# sc:     the context
# dec:    the decorator
# index:  which operand (relative to the operand list)
# report: whether to report a refusal
# out:    receives the folded word
# ret:    true when the operand folded
fun read_word_operand(sc: *context.SemaContext, dec: *decl.Decorator, index: u32,
                      report: bool, out: *u32) bool {
    val ord: u32 = FIXED_ARGS + index;
    val e: *expr.Expr = arg_expr(sc, dec, ord);
    if (e == nil) { ret false; }
    val eid: id.ExprId = sc.a.expr_ids[dec.args_start + ord];
    val res: R.Result[comptime.CTValue, str] = comptime.eval(sc.ctx, sc.a, sc.source, eid, ?sc.s.interner);
    if (R.is_err[comptime.CTValue, str](res)) {
        if (report) { context.report(sc, e.span, "a `handle` operand must be a compile-time constant: it is a word the target writes into the type it mints, so it cannot depend on anything the program computes"); }
        ret false;
    }
    val v: comptime.CTValue = R.unwrap_ok[comptime.CTValue, str](res);
    if (v.kind != comptime.CT_KIND_INT) {
        if (report) { context.report(sc, e.span, "a `handle` operand must fold to an integer: the target writes it into the type as one word"); }
        ret false;
    }
    if (comptime.ct_is_negative(v)) {
        if (report) { context.report(sc, e.span, "a `handle` operand cannot be negative: the target writes it into the type as one unsigned word"); }
        ret false;
    }
    @out = v.data.i::u32;
    ret true;
}

# resolve operand `index` to the handle type it names, checking its constructor
# ---
# sc:       the context
# dec:      the decorator
# index:    which operand (relative to the operand list)
# want_tag: the constructor tag the named type must carry
# defs:     the selected target's definitions
# report:   whether to report a refusal
# depth:    how many compositions deep this read already is
# out:      receives the named type's TypeId
# ret:      true when the operand named an admissible type
fun read_type_operand(sc: *context.SemaContext, dec: *decl.Decorator, index: u32,
                      want_tag: u32, defs: *isa.TargetDefs, report: bool, depth: u32,
                      out: *u32) bool {
    val ord: u32 = FIXED_ARGS + index;
    val e: *expr.Expr = arg_expr(sc, dec, ord);
    if (e == nil) { ret false; }
    # anything but a bare name is not a composition at all: this position takes a
    # declaration, and an expression in it was written as a value.
    if (e.kind != expr.EXPR_KIND_IDENT) {
        if (report) { context.report(sc, e.span, "this `handle` operand is a type, not a value: the constructor composes over another handle, and NAMING the one it wraps is what keeps the two from disagreeing about the operands they share"); }
        ret false;
    }
    val eid: id.ExprId = sc.a.expr_ids[dec.args_start + ord];
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
    val inner: type.TypeId = handle_type_named(sc, O.unwrap[*resolve.Symbol](opt_sym), depth);
    if (inner == type.TYPE_ERROR) {
        if (report) { context.report(sc, e.span, "this `handle` operand must name a handle the same target mints: the constructor composes over one, and an ordinary type has nothing for it to wrap"); }
        ret false;
    }
    val opt_t: O.Option[*type.Type] = type.get(?sc.s.types, inner);
    if (O.is_none[*type.Type](opt_t)) { ret false; }
    val got_tag: u32 = O.unwrap[*type.Type](opt_t).data.handle.ctor;
    if (got_tag != want_tag) {
        if (report) { report_wrong_ctor(sc, e, isa.type_def_by_tag(defs, want_tag)); }
        ret false;
    }
    @out = inner::u32;
    ret true;
}

# report a type operand naming a handle minted by the wrong constructor
#
# NAMES THE CONSTRUCTOR the operand position wants, because the whole reason the
# operand is a type rather than a word is that only one kind of thing belongs there.
# ---
# sc:   the context
# e:    the operand expression
# want: the constructor the position requires, or nil
fun report_wrong_ctor(sc: *context.SemaContext, e: *expr.Expr, want: *isa.TypeDef) {
    if (want == nil) {
        context.report(sc, e.span, "this `handle` operand names a handle the constructor cannot compose over");
        ret;
    }
    val rm: R.Result[str, str] = format.sprint(sc.s.alloc,
        "this `handle` operand must name a handle minted by the target's `{}` constructor; the one named here was minted by another, so the constructor has nothing to compose over",
        want.name);
    if (R.is_err[str, str](rm)) {
        context.report(sc, e.span, "this `handle` operand names a handle the constructor cannot compose over");
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](rm);
    context.report(sc, e.span, msg);
    A.deallocate[char](sc.s.alloc, msg::*char, str_len(msg) + 1);
}

# intern the text `span` covers, or STR_NIL
# ---
# sc:   the context
# span: the span to intern
# ret:  the interned id, or STR_NIL
fun intern_name(sc: *context.SemaContext, span: token.Span) intern.StrId {
    if (span.len == 0) { ret intern.STR_NIL; }
    val r: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (R.is_err[intern.StrId, str](r)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

# report every rule a `#[handle]` declaration itself breaks
# ---
# sc:  the context
# d:   the decorated decl
# dec: the `handle` decorator
pub fun validate(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    release(sc, read(sc, d, dec, true, 0));
}

# the type a `#[handle]` declaration denotes
#
# A refused declaration yields TYPE_ERROR, which poisons every use of the name
# without a second diagnostic: the refusal was reported once, where it was written.
# An INERT one still denotes a type, minted with no constructor, so a program built
# for a target that does not define it still type-checks and still sizes.
# ---
# sc:  the context
# did: the declaration
# d:   the declaration's record
# ret: the handle's TypeId, or TYPE_ERROR
pub fun type_of(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl) type.TypeId {
    ret type_at(sc, did, d, 0);
}

# the type a `#[handle]` declaration denotes, at a known composition depth
# ---
# sc:    the context
# did:   the declaration
# d:     the declaration's record
# depth: how many compositions deep this resolution already is
# ret:   the handle's TypeId, or TYPE_ERROR
fun type_at(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl, depth: u32) type.TypeId {
    val dec: *decl.Decorator = decorator_of(sc, d);
    if (dec == nil) { ret type.TYPE_ERROR; }

    val r: Read = read(sc, d, dec, false, depth);
    if (r.status == READ_REFUSED) { ret type.TYPE_ERROR; }

    val name: intern.StrId = intern_name(sc, d.data.def_.name);
    var tid: type.TypeId = type.TYPE_ERROR;
    if (r.status == READ_INERT) {
        # a handle the selected target does not mint is still one type PER
        # DECLARATION, keyed by the declaration site: the constructor and its
        # operands are exactly what this build has no reading of, so identity has to
        # come from somewhere the build can see, and two unrelated handles collapsing
        # into one would let each be passed where the other is declared
        var site: [2]u32;
        site[0] = sc.own_module::u32;
        site[1] = did::u32;
        val res: R.Result[type.TypeId, str] = type.intern_handle(?sc.s.types, name, isa.NO_TYPE_CTOR, ?site[0], 2);
        if (R.is_ok[type.TypeId, str](res)) { tid = R.unwrap_ok[type.TypeId, str](res); }
    }
    or {
        val res: R.Result[type.TypeId, str] = type.intern_handle(?sc.s.types, name, r.ctor, r.ops, r.len);
        if (R.is_ok[type.TypeId, str](res)) { tid = R.unwrap_ok[type.TypeId, str](res); }
    }
    release(sc, r);
    ret tid;
}
