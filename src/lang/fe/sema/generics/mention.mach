use std.collections.map;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.type;

# whether each nominal's fields mention a type parameter, as decided under one
# type projection; a lookup under a later projection finds the memo empty
pub rec Memo {
    known:      map.Map[type.TypeId, bool];
    generation: u64;
}

pub fun init(a: *A.Allocator) Memo {
    ret Memo{known: map.init[type.TypeId, bool](a), generation: 0};
}

pub fun dnit(m: *Memo) {
    map.dnit[type.TypeId, bool](?m.known);
}

fun generation_follow(m: *Memo, generation: u64) {
    if (m.generation == generation) { ret; }
    map.clear[type.TypeId, bool](?m.known);
    m.generation = generation;
}

pub fun get(m: *Memo, generation: u64, tid: type.TypeId) opt[bool] {
    generation_follow(m, generation);
    val hit: opt[*bool] = map.get[type.TypeId, bool](?m.known, ?tid);
    if (sel hit.some) { ret opt[bool].some{@hit.some}; }
    ret opt[bool].none{};
}

pub fun set(m: *Memo, generation: u64, tid: type.TypeId, mentions: bool) err[fail.Fail] {
    generation_follow(m, generation);
    val put: res[bool, A.Error] = map.insert[type.TypeId, bool](?m.known, tid, mentions);
    if (sel put.err) { ret err[fail.Fail].err{fail.refused(put.err)}; }
    ret err[fail.Fail].ok{};
}
