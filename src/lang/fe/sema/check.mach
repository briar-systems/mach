use std.format;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fail;
use mach.lang.diagnostic;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.abitype;
use mach.lang.fe.sema.coerce;
use mach.lang.fe.sema.context;
use mach.lang.fe.sema.generics;
use mach.lang.layout;
use mach.lang.fe.sema.typename;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.type;

val CHAIN_LINKS: u32 = 5;

pub fun check_assignable(sc: *context.SemaContext, expected: type.TypeId, actual: type.TypeId, span: token.Span) bool {
    if (expected == type.TYPE_ERROR || actual == type.TYPE_ERROR) { ret true; }
    if (expected == actual)                                       { ret true; }

    if (coerce.is_assignable(sc, actual, expected)) { ret true; }

    report_mismatch(sc, span, expected, actual,
        "mach has no implicit widening; cast the value with `value::Type`");
    ret false;
}

pub fun check_coercible(sc: *context.SemaContext, expected: type.TypeId, eid: id.ExprId, actual: type.TypeId, span: token.Span) bool {
    val cr: coerce.CoerceResult = coerce.try_coerce_literal(sc, eid, expected);
    if (cr.kind == coerce.COERCE_OUT_OF_RANGE) {
        report_out_of_range(sc, span, cr);
        ret false;
    }
    var have: type.TypeId = actual;
    if (cr.kind == coerce.COERCE_COERCED) { have = cr.ty; }

    val mark: u64 = context.diag_mark(sc);
    val ok: bool = check_assignable(sc, expected, have, span);
    if (!ok && context.reported_since(sc, mark)) { attach_cast_fix(sc, expected, have, eid); }
    ret ok;
}

fun attach_cast_fix(sc: *context.SemaContext, expected: type.TypeId, actual: type.TypeId, eid: id.ExprId) {
    if (!cast_would_compile(sc, actual, expected)) { ret; }

    val opt_expr: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](opt_expr)) { ret; }
    val span: token.Span = O.unwrap[*expr.Expr](opt_expr).span;
    if (span.len == 0) { ret; }

    val id_r: R.Result[diagnostic.DiagnosticId, str] = diagnostic.last_id(?sc.s.diags);
    if (R.is_err[diagnostic.DiagnosticId, str](id_r)) { ret; }
    val did: diagnostic.DiagnosticId = R.unwrap_ok[diagnostic.DiagnosticId, str](id_r);

    val ts_r: R.Result[str, str] = type_to_str(sc, expected);
    if (R.is_err[str, str](ts_r)) { fail.internal(?sc.status, R.unwrap_err[str, str](ts_r)); ret; }
    val ts: str = R.unwrap_ok[str, str](ts_r);

    val label_r: R.Result[str, str] = format.sprint(sc.s.alloc, "cast the value to `{}`", ts);
    if (R.is_err[str, str](label_r)) { fail.internal(?sc.status, R.unwrap_err[str, str](label_r)); type_str_free(sc, ts); ret; }
    val label: str = R.unwrap_ok[str, str](label_r);

    var head: token.Span;
    head.offset = span.offset;
    head.len    = 0;
    var tail: token.Span;
    tail.offset = span.offset + span.len;
    tail.len    = 0;

    if (expr_binds_tighter_than_cast(O.unwrap[*expr.Expr](opt_expr).kind)) {
        val sfx_r: R.Result[str, str] = format.sprint(sc.s.alloc, "::{}", ts);
        if (R.is_ok[str, str](sfx_r)) {
            val sfx: str = R.unwrap_ok[str, str](sfx_r);
            diagnostic.record_fix_committed(?sc.s.diags, did, label, sc.a.file_id, tail, sfx);
            A.deallocate[char](sc.s.alloc, sfx, str_len(sfx) + 1);
        }
    }
    or {
        val sfx_r: R.Result[str, str] = format.sprint(sc.s.alloc, ")::{}", ts);
        if (R.is_ok[str, str](sfx_r)) {
            val sfx: str = R.unwrap_ok[str, str](sfx_r);
            val fix_r: R.Result[diagnostic.FixId, str] = diagnostic.attach_fix_committed(?sc.s.diags, did, label, sc.a.file_id, head, "(");
            if (R.is_ok[diagnostic.FixId, str](fix_r)) {
                val fid: diagnostic.FixId = R.unwrap_ok[diagnostic.FixId, str](fix_r);
                val edit_r: R.Result[R.Void, str] = diagnostic.attach_fix_edit_committed(?sc.s.diags, did, fid, sc.a.file_id, tail, sfx);
                if (R.is_err[R.Void, str](edit_r)) { diagnostic.remove_fix_committed(?sc.s.diags, did, fid); }
            }
            A.deallocate[char](sc.s.alloc, sfx, str_len(sfx) + 1);
        }
    }

    A.deallocate[char](sc.s.alloc, label, str_len(label) + 1);
    type_str_free(sc, ts);
}

fun cast_would_compile(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId) bool {
    if (from == type.TYPE_ERROR || to == type.TYPE_ERROR) { ret false; }
    if (from == to)                                       { ret false; }
    if (!is_numeric(sc, from) || !is_numeric(sc, to))     { ret false; }

    if (type.is_secret(?sc.s.types, from) != type.is_secret(?sc.s.types, to)) { ret false; }

    if (type.is_secret(?sc.s.types, from) && cast_is_fp_conversion(sc, from, to)) { ret false; }

    ret true;
}

fun expr_binds_tighter_than_cast(k: expr.ExprKind) bool {
    if (k == expr.EXPR_KIND_IDENT)            { ret true; }
    if (k == expr.EXPR_KIND_COMPTIME_IDENT)   { ret true; }
    if (k == expr.EXPR_KIND_LIT_INT)          { ret true; }
    if (k == expr.EXPR_KIND_LIT_FLOAT)        { ret true; }
    if (k == expr.EXPR_KIND_LIT_CHAR)         { ret true; }
    if (k == expr.EXPR_KIND_LIT_STR)          { ret true; }
    if (k == expr.EXPR_KIND_LIT_NIL)          { ret true; }
    if (k == expr.EXPR_KIND_CALL)             { ret true; }
    if (k == expr.EXPR_KIND_INDEX)            { ret true; }
    if (k == expr.EXPR_KIND_MEMBER)           { ret true; }
    if (k == expr.EXPR_KIND_PROJECT)          { ret true; }
    if (k == expr.EXPR_KIND_CAST)             { ret true; }
    if (k == expr.EXPR_KIND_STRIP)            { ret true; }
    if (k == expr.EXPR_KIND_ARRAY_LIT)        { ret true; }
    if (k == expr.EXPR_KIND_STRUCT_LIT)       { ret true; }
    if (k == expr.EXPR_KIND_VECTOR_LIT)       { ret true; }
    if (k == expr.EXPR_KIND_GENERIC_INSTANCE) { ret true; }
    ret false;
}

pub fun check_call(sc: *context.SemaContext, callee_sig: type.TypeId, args_start: u32, args_len: u32, span: token.Span, pack_to_c_tail: bool) bool {
    if (callee_sig == type.TYPE_ERROR) { ret true; }

    val opt_fun: O.Option[*type.Type] = type.get(?sc.s.types, callee_sig);
    if (O.is_none[*type.Type](opt_fun)) {
        report(sc, span, "not callable: callee is not a function");
        ret false;
    }
    val fun_type: *type.Type = O.unwrap[*type.Type](opt_fun);
    if (fun_type.kind != type.TYPE_FUN) {
        report_typed(sc, span, "not callable: `", callee_sig, "` is not a function", "not callable: callee is not a function");
        ret false;
    }

    val params_len:   u32  = fun_type.data.fn.params_len;
    val params_start: u32  = fun_type.data.fn.params_start;
    val c_variadic:   bool = fun_type.data.fn.c_variadic;

    var fixed_len: u32  = params_len;
    val has_pack:  bool = params_len > 0 && param_is_pack(sc, params_start + params_len - 1);
    if (has_pack) { fixed_len = params_len - 1; }

    if (!validate_pack_spreads(sc, has_pack || c_variadic, fixed_len, args_start, args_len, span)) {
        ret false;
    }

    if (has_pack) {
        if (args_len < fixed_len) {
            report_arity(sc, span, fixed_len, args_len, true);
            ret false;
        }
    }
    or (c_variadic) {
        if (args_len < params_len) {
            report_arity(sc, span, params_len, args_len, true);
            ret false;
        }
    }
    or (args_len != params_len) {
        report_arity(sc, span, params_len, args_len, false);
        ret false;
    }

    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < fixed_len) {
        val opt_param_type: O.Option[type.TypeId] = type.get_param(?sc.s.types, params_start + i);
        if (O.is_none[type.TypeId](opt_param_type)) { all_ok = false; brk; }
        val expected: type.TypeId = O.unwrap[type.TypeId](opt_param_type);

        val arg_eid:  id.ExprId   = sc.a.expr_ids[args_start + i];
        val actual:   type.TypeId = expr_type_of(sc, arg_eid);
        val arg_span: token.Span  = expr_span_of(sc, arg_eid, span);
        if (!check_coercible(sc, expected, arg_eid, actual, arg_span)) {
            all_ok = false;
        }
        i = i + 1;
    }

    if (c_variadic) {
        var vi: u32 = params_len;
        for (vi < args_len) {
            val veid: id.ExprId = sc.a.expr_ids[args_start + vi];
            if (!arg_is_spread(sc, veid)) {
                if (!check_c_variadic_arg(sc, veid, span)) { all_ok = false; }
            }
            vi = vi + 1;
        }
    }

    if (has_pack) {
        var pk: u32 = fixed_len;
        for (pk < args_len) {
            val parg_eid: id.ExprId = sc.a.expr_ids[args_start + pk];
            if (!arg_is_spread(sc, parg_eid)) {
                if (pack_to_c_tail) {
                    if (!check_c_variadic_arg(sc, parg_eid, span)) { all_ok = false; }
                }
                val pactual: type.TypeId = expr_type_of(sc, parg_eid);
                if (pactual != type.TYPE_ERROR && context.recover[bool](sc, generics.contains_secret_deep(sc.s, pactual), false)) {
                    report_note(sc, expr_span_of(sc, parg_eid, span),
                        "a secret value cannot be passed to a variadic `...` argument",
                        "a variadic pack erases secrecy and is an observation boundary (format / log / print); declassify with `:>T` first");
                    all_ok = false;
                }
            }
            pk = pk + 1;
        }
    }
    ret all_ok;
}

pub fun check_comptime_call(sc: *context.SemaContext, callee_sig: type.TypeId, callee: id.ExprId, f: *decl.DeclFun, args_start: u32, args_len: u32, span: token.Span) bool {
    val params_ast: *ast.Ast = callee_origin_ast(sc, callee);
    if (params_ast == nil) { ret true; }

    val param_total: u32 = f.params_len;
    if (args_len != param_total) {
        report_arity(sc, span, param_total, args_len, false);
        ret false;
    }

    val opt_sig: O.Option[*type.Type] = type.get(?sc.s.types, callee_sig);
    if (O.is_none[*type.Type](opt_sig)) { ret true; }
    val sig:      *type.Type = O.unwrap[*type.Type](opt_sig);
    val rt_start: u32        = sig.data.fn.params_start;
    val rt_len:   u32        = sig.data.fn.params_len;

    var all_ok:  bool = true;
    var i:       u32  = 0;
    var rt_seen: u32  = 0;
    for (i < param_total) {
        val tn:       *decl.TypedName = ?params_ast.typed_names[f.params_start + i];
        val arg_eid:  id.ExprId       = sc.a.expr_ids[args_start + i];
        val arg_span: token.Span      = expr_span_of(sc, arg_eid, span);

        if (tn.comptime) {
            if (!arg_references_comptime_param(sc, arg_eid, arg_span) && !arg_names_module_constant(sc, arg_eid)) {
                val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, arg_eid, ?sc.s.interner);
                context.record_eval_result(sc, res_eval);
                if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
                    report_note(sc, arg_span, "comptime argument is not a compile-time constant", R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message);
                    all_ok = false;
                }
            }
            i = i + 1;
            cnt;
        }

        if (rt_seen < rt_len) {
            val opt_param_type: O.Option[type.TypeId] = type.get_param(?sc.s.types, rt_start + rt_seen);
            if (O.is_some[type.TypeId](opt_param_type)) {
                val expected: type.TypeId = O.unwrap[type.TypeId](opt_param_type);
                val actual:   type.TypeId = expr_type_of(sc, arg_eid);
                if (!check_coercible(sc, expected, arg_eid, actual, arg_span)) { all_ok = false; }
            }
            rt_seen = rt_seen + 1;
        }
        i = i + 1;
    }
    ret all_ok;
}

pub fun imported_module_const_sym(sc: *context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    val origin_ast: *ast.Ast = session.module_ast(sc.s, sym.origin);
    if (origin_ast == nil) { ret false; }
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_decl)) { ret false; }
    ret O.unwrap[*decl.Decl](opt_decl).kind == decl.DECL_KIND_VAL;
}

pub fun check_index(sc: *context.SemaContext, object: type.TypeId, index: type.TypeId, span: token.Span) O.Option[type.TypeId] {
    if (object == type.TYPE_ERROR) { ret O.some[type.TypeId](type.TYPE_ERROR); }

    if (index != type.TYPE_ERROR && type.is_secret(?sc.s.types, index)) {
        report_note(sc, span, "secret value used as a memory index",
            "a secret may not address memory; the access pattern leaks through the cache trace. index by a public value, or load the whole table obliviously");
    }

    check_secret_address(sc, object, span);

    val obj_secret: bool = type.is_secret(?sc.s.types, object);
    val base_obj:   type.TypeId = type.strip_secret(?sc.s.types, object);

    val opt_object: O.Option[*type.Type] = type.get(?sc.s.types, base_obj);
    if (O.is_none[*type.Type](opt_object)) {
        report(sc, span, "not indexable: object is neither a pointer nor an array");
        ret O.none[type.TypeId]();
    }
    val object_type: *type.Type = O.unwrap[*type.Type](opt_object);

    var elem: type.TypeId = type.TYPE_NIL;
    if (object_type.kind == type.TYPE_POINTER) {
        elem = object_type.data.pointer.base;
    }
    or (object_type.kind == type.TYPE_ARRAY) {
        elem = object_type.data.array.base;
    }
    or (object_type.kind == type.TYPE_FUN) {
        report_note(sc, span, "not indexable: a function has no elements",
            "type arguments are written where a generic is called (`f[i64](x)`); a generic instance cannot be named as a value");
        ret O.none[type.TypeId]();
    }
    or {
        report(sc, span, "not indexable: object is neither a pointer nor an array");
        ret O.none[type.TypeId]();
    }

    if (index != type.TYPE_ERROR && !is_integer(sc, index)) {
        report(sc, span, "type mismatch: index must be an integer");
    }
    if (obj_secret) { elem = secret_of(sc, elem); }
    ret O.some[type.TypeId](elem);
}

pub fun check_const_index(sc: *context.SemaContext, object: type.TypeId, idx: id.ExprId, span: token.Span) bool {
    val n_opt: O.Option[u32] = type.element_count(?sc.s.types, object);
    if (O.is_none[u32](n_opt)) { ret true; }

    val cv_opt: O.Option[comptime.CTValue] = const_index_value(sc, idx);
    if (O.is_none[comptime.CTValue](cv_opt)) { ret true; }

    val n:  u32              = O.unwrap[u32](n_opt);
    val cv: comptime.CTValue = O.unwrap[comptime.CTValue](cv_opt);

    if (!comptime.ct_is_negative(cv) && cv.data.i:~u64 < n::u64) { ret true; }

    report_index_oob(sc, span, cv, object, n);
    ret false;
}

pub fun const_index_value(sc: *context.SemaContext, eid: id.ExprId) O.Option[comptime.CTValue] {
    if (eid == id.EXPR_NIL) { ret O.none[comptime.CTValue](); }

    val cr: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);

    context.record_eval_result(sc, cr);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](cr)) { ret O.none[comptime.CTValue](); }

    val cv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](cr);
    if (cv.kind != comptime.CT_KIND_INT) { ret O.none[comptime.CTValue](); }
    ret O.some[comptime.CTValue](cv);
}

fun report_index_oob(sc: *context.SemaContext, span: token.Span, cv: comptime.CTValue, object: type.TypeId, n: u32) {
    val res_type: R.Result[str, str] = type_to_str(sc, object);
    if (R.is_err[str, str](res_type)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_type));
        report(sc, span, "index out of bounds for the element count");
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    var res_msg: R.Result[str, str] = R.err[str, str]("unformatted");
    if (cv.int_unsigned) {
        res_msg = format.sprint(sc.s.alloc, "index {} is out of bounds for `{}` of length {}",
            cv.data.i:~u64, type_str, n);
    }
    or {
        res_msg = format.sprint(sc.s.alloc, "index {} is out of bounds for `{}` of length {}",
            cv.data.i, type_str, n);
    }
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, "index out of bounds for the element count");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun check_secret_address(sc: *context.SemaContext, ty: type.TypeId, span: token.Span) bool {
    if (ty == type.TYPE_ERROR)               { ret true; }
    if (!type.is_secret(?sc.s.types, ty))    { ret true; }
    if (!is_pointer(sc, type.strip_secret(?sc.s.types, ty))) { ret true; }

    report_note(sc, span, "secret value used as a memory address",
        "a secret may not address memory; the access pattern leaks through the cache trace, exactly as a secret index does. address with a public pointer, or `:>T`-declassify the pointer when disclosure is intended");
    ret false;
}

fun is_pointer(sc: *context.SemaContext, t: type.TypeId) bool {
    val opt: O.Option[*type.Type] = type.get(?sc.s.types, t);
    if (O.is_none[*type.Type](opt)) { ret false; }
    ret O.unwrap[*type.Type](opt).kind == type.TYPE_POINTER;
}

pub fun check_member(sc: *context.SemaContext, object: type.TypeId, name: intern.StrId, span: token.Span) O.Option[type.TypeId] {
    if (object == type.TYPE_ERROR) { ret O.some[type.TypeId](type.TYPE_ERROR); }

    check_secret_address(sc, object, span);

    val deref:          type.TypeId = deref_one(sc, type.strip_secret(?sc.s.types, object));
    val container_secret: bool      = type.is_secret(?sc.s.types, object) || type.is_secret(?sc.s.types, deref);
    val record:         type.TypeId = type.strip_secret(?sc.s.types, deref);

    val opt_field: O.Option[type.TypeId] = context.field_lookup(sc, record, name);
    if (O.is_some[type.TypeId](opt_field)) {
        var fty: type.TypeId = O.unwrap[type.TypeId](opt_field);
        if (container_secret) { fty = secret_of(sc, fty); }
        ret O.some[type.TypeId](fty);
    }

    report_no_field(sc, span, name, record);
    ret O.none[type.TypeId]();
}

pub fun check_cast(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId, span: token.Span) O.Option[type.TypeId] {
    if (from == type.TYPE_ERROR || to == type.TYPE_ERROR) { ret O.some[type.TypeId](to); }
    if (from == to)                                       { ret O.some[type.TypeId](to); }
    if (!check_abi_type_cast(sc, from, to, span))         { ret O.none[type.TypeId](); }

    if (!check_secrecy_cast(sc, from, to, span)) { ret O.none[type.TypeId](); }

    if (is_numeric(sc, from) && is_numeric(sc, to)) {
        if (type.is_secret(?sc.s.types, from) && cast_is_fp_conversion(sc, from, to)) {
            report_note(sc, span, "secret value used as an operand of a variable-latency floating-point conversion",
                "the FP unit's timing can depend on the secret operand; convert public data, or `:>T` to a public value when disclosure is intended");
        }
        ret O.some[type.TypeId](to);
    }

    val size_from: u32 = byte_size(sc, from);
    val size_to:   u32 = byte_size(sc, to);
    if (size_from != 0 && size_from == size_to) {
        ret O.some[type.TypeId](to);
    }

    report_note(sc, span, "cast: conversion is invalid",
        "`::` casts numeric types or reinterprets equal-size values only");
    ret O.none[type.TypeId]();
}

fun check_abi_type_cast(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId, span: token.Span) bool {
    val f: type.TypeId = type.strip_secret(?sc.s.types, from);
    val t: type.TypeId = type.strip_secret(?sc.s.types, to);
    if (!type.is_abi_type(?sc.s.types, f) && !type.is_abi_type(?sc.s.types, t)) { ret true; }
    report(sc, span, abitype.exclusion_message());
    ret false;
}

fun cast_is_fp_conversion(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId) bool {
    val sf: type.TypeId = type.strip_secret(?sc.s.types, from);
    val st: type.TypeId = type.strip_secret(?sc.s.types, to);
    if (sf == st) { ret false; }
    ret type.is_float(?sc.s.types, sf) || type.is_float(?sc.s.types, st);
}

fun check_secrecy_cast(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId, span: token.Span) bool {
    val from_raw_ptr: bool = from == type.TYPE_PTR;
    val to_raw_ptr:   bool = to == type.TYPE_PTR;
    if ((from_raw_ptr && context.recover[bool](sc, generics.contains_secret_deep(sc.s, to), false))
        || (to_raw_ptr && context.recover[bool](sc, generics.contains_secret_deep(sc.s, from), false))) {
        report_note(sc, span, "cast: a secret-welded pointer cannot be erased to the untyped `ptr`",
            "secret memory is reached only through secrecy-typed pointers; erasing `^` to `ptr` would let a public alias read it");
        ret false;
    }
    val verdict: generics.SecrecyVerdict = context.recover[generics.SecrecyVerdict](sc, generics.secrecy_structure_equal_deep(sc.s, context.machine_of(sc), from, to), generics.SECRECY_UNRECORDABLE);
    if (verdict == generics.SECRECY_UNRECORDABLE) {
        report_note(sc, span, "cast: cannot prove that `::` / `:~` leaves the secret qualifier `^` in place",
            "the checker ran out of room to record this comparison; this is a limit of the compiler, not a defect in the cast");
        ret false;
    }
    if (verdict == generics.SECRECY_DIFFERS) {
        report_note(sc, span, "cast: `::` and `:~` cannot add or drop the secret qualifier `^`",
            "a public value coerces up to secret with no syntax; `:>T` is the only downgrade");
        ret false;
    }
    ret true;
}

pub fun check_reinterpret(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId, span: token.Span) O.Option[type.TypeId] {
    if (from == type.TYPE_ERROR || to == type.TYPE_ERROR) { ret O.some[type.TypeId](to); }
    if (!check_abi_type_cast(sc, from, to, span))         { ret O.none[type.TypeId](); }

    if (!check_secrecy_cast(sc, from, to, span)) { ret O.none[type.TypeId](); }

    val size_from: u32 = byte_size(sc, from);
    val size_to:   u32 = byte_size(sc, to);
    if (size_from != 0 && size_from == size_to) { ret O.some[type.TypeId](to); }

    report_reinterpret_mismatch(sc, span, from, size_from, to, size_to);
    ret O.none[type.TypeId]();
}

pub fun check_return(sc: *context.SemaContext, fn_ret: type.TypeId, value: type.TypeId, span: token.Span) bool {
    if (value == type.TYPE_NIL) {
        if (fn_ret == type.TYPE_NIL || fn_ret == type.TYPE_ERROR) { ret true; }
        report(sc, span, "type mismatch: function must return a value");
        ret false;
    }
    if (fn_ret == type.TYPE_NIL) {
        report(sc, span, "type mismatch: function returns no value");
        ret false;
    }
    ret check_assignable(sc, fn_ret, value, span);
}

pub fun check_condition(sc: *context.SemaContext, cond: type.TypeId, span: token.Span) bool {
    if (cond == type.TYPE_ERROR) { ret true; }
    if (type.is_secret(?sc.s.types, cond)) {
        report_note(sc, span, "secret value used as a branch condition",
            "a secret may not steer control flow; branching on it leaks through timing. compute branch-free, or `:>T` to a public value when disclosure is intended");
        ret false;
    }
    if (type.is_vector(?sc.s.types, cond)) {
        report_note(sc, span, "type mismatch: a vector is not a truth value",
            "a vector, including a comparison mask, is not a scalar condition; reduce it to a scalar before branching");
        ret false;
    }
    if (type.is_u8(?sc.s.types, cond)) { ret true; }
    report_note(sc, span, "type mismatch: condition must have type u8",
        "comparisons and logical operators produce u8 condition values");
    ret false;
}

pub fun is_numeric(sc: *context.SemaContext, t: type.TypeId) bool {
    ret type.is_numeric(?sc.s.types, t);
}

pub fun is_integer(sc: *context.SemaContext, t: type.TypeId) bool {
    ret type.is_integer(?sc.s.types, t);
}

fun secret_of(sc: *context.SemaContext, t: type.TypeId) type.TypeId {
    val r: R.Result[type.TypeId, str] = type.intern_secret(?sc.s.types, t);
    if (R.is_err[type.TypeId, str](r)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r)); ret t; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

pub fun byte_size(sc: *context.SemaContext, t: type.TypeId) u32 {
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, t));
    if (O.is_none[*type.Type](opt_type)) { ret 0; }
    val tp: *type.Type    = O.unwrap[*type.Type](opt_type);
    val k:  type.TypeKind = tp.kind;
    val d:  type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) { ret d.bits / 8; }
    if (k == type.TYPE_VECTOR) {
        ret (type.prim_desc(tp.data.vector.element).bits / 8) * tp.data.vector.lanes;
    }
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER || k == type.TYPE_FUN
        || k == type.TYPE_HANDLE) { ret ptr_width(sc); }
    if (k == type.TYPE_ABI) {
        val ext: layout.Extent = context.recover[layout.Extent](sc, generics.type_extent(sc.s, context.machine_of(sc), type.strip_secret(?sc.s.types, t)), layout.unknown_extent(layout.EXTENT_UNKNOWN_NODE));
        if (!ext.ok) { ret 0; }
        ret ext.size;
    }
    if (k == type.TYPE_ARRAY) {
        val total: u64 = byte_size(sc, tp.data.array.base)::u64 * tp.data.array.count::u64;
        if (total > 4294967295) { ret 0; }
        ret total::u32;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE) {
        val ext: layout.Extent = context.recover[layout.Extent](sc, generics.type_extent(sc.s, context.machine_of(sc), type.strip_secret(?sc.s.types, t)), layout.unknown_extent(layout.EXTENT_UNKNOWN_NODE));
        if (!ext.ok) { ret 0; }
        ret ext.size;
    }
    ret 0;
}

pub fun type_to_str(sc: *context.SemaContext, t: type.TypeId) R.Result[str, str] {
    ret typename.type_to_str(sc.s, t);
}

pub fun type_str_free(sc: *context.SemaContext, owned: str) {
    typename.type_str_free(sc.s, owned);
}

pub fun check_float_capability(sc: *context.SemaContext, tid: type.TypeId, span: token.Span) {
    if (sc.ctx == nil || sc.ctx.env.has_float) { ret; }
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret; }
    if (!context.recover[bool](sc, generics.contains_float_deep(sc.s, tid), false)) { ret; }

    var target_name: str = "this target";
    val name_o: O.Option[str] = intern.lookup(?sc.s.interner, sc.ctx.env.target_isa);
    if (O.is_some[str](name_o)) { target_name = O.unwrap[str](name_o); }

    val res_type: R.Result[str, str] = type_to_str(sc, tid);
    if (R.is_err[str, str](res_type)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_type));
        report(sc, span, "floating-point types are unsupported on this target");
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc,
        "`{}` uses a floating-point type, which target `{}` does not support", type_str, target_name);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, "floating-point types are unsupported on this target");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun report_no_field(sc: *context.SemaContext, span: token.Span, name: intern.StrId, record: type.TypeId) {
    val res_type: R.Result[str, str] = type_to_str(sc, record);
    if (R.is_err[str, str](res_type)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_type));
        report(sc, span, "no such field: type has no field with that name");
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "no such field `{}` on type {}", typename.name_str(sc.s, name), type_str);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, "no such field: type has no field with that name");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun report_named(sc: *context.SemaContext, span: token.Span, prefix: str, name: intern.StrId, suffix: str, fallback: str) {
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}", prefix, typename.name_str(sc.s, name), suffix);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, fallback);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

pub fun report_missing_type_args(sc: *context.SemaContext, span: token.Span, name: intern.StrId, expected: u32) {
    val note: str = "a generic declaration is a template, not a type; name it with its type arguments";
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "generic type `{}` named without type arguments: expected {}, found 0", typename.name_str(sc.s, name), expected::usize);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        context.report_note(sc, span, "generic type named without type arguments", note);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    context.report_note(sc, span, msg, note);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

pub fun report_typed(sc: *context.SemaContext, span: token.Span, prefix: str, t: type.TypeId, suffix: str, fallback: str) {
    val res_type: R.Result[str, str] = type_to_str(sc, t);
    if (R.is_err[str, str](res_type)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_type));
        report(sc, span, fallback);
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}", prefix, type_str, suffix);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, fallback);
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun report_typed2(sc: *context.SemaContext, span: token.Span, prefix: str, a: type.TypeId, mid: str, b: type.TypeId, suffix: str, fallback: str) {
    val res_a: R.Result[str, str] = type_to_str(sc, a);
    val res_b: R.Result[str, str] = type_to_str(sc, b);
    if (R.is_err[str, str](res_a) || R.is_err[str, str](res_b)) {
        if (R.is_err[str, str](res_a)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_a)); }
        if (R.is_err[str, str](res_b)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_b)); }
        report(sc, span, fallback);
        if (R.is_ok[str, str](res_a)) { type_str_free(sc, R.unwrap_ok[str, str](res_a)); }
        if (R.is_ok[str, str](res_b)) { type_str_free(sc, R.unwrap_ok[str, str](res_b)); }
        ret;
    }
    val a_str: str = R.unwrap_ok[str, str](res_a);
    val b_str: str = R.unwrap_ok[str, str](res_b);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}{}{}", prefix, a_str, mid, b_str, suffix);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, fallback);
        type_str_free(sc, a_str);
        type_str_free(sc, b_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report_types_pair(sc, span, msg, a, b, a_str, b_str, "");
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, a_str);
    type_str_free(sc, b_str);
}

fun check_c_variadic_arg(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) bool {
    val actual:   type.TypeId  = expr_type_of(sc, eid);
    if (actual == type.TYPE_ERROR) { ret true; }
    val arg_span: token.Span   = expr_span_of(sc, eid, span);

    if (context.recover[bool](sc, generics.contains_secret_deep(sc.s, actual), false)) {
        report_note(sc, arg_span, "a secret value cannot be passed to a C-variadic `...` argument",
            "a C variadic is an observation boundary (the callee is foreign code that prints or logs it); declassify with `:>T` first");
        ret false;
    }

    val bare: type.TypeId  = type.strip_secret(?sc.s.types, actual);
    val opt:  O.Option[*type.Type] = type.get(?sc.s.types, bare);
    if (O.is_none[*type.Type](opt)) { ret true; }
    val d: type.PrimDesc = type.prim_desc(O.unwrap[*type.Type](opt).kind);

    if (d.class == type.PRIM_CLASS_FLOAT && d.bits < 64) {
        report_typed(sc, arg_span, "`", actual, "` is promoted to `f64` in a C-variadic argument; write the cast (`x::f64`)",
            "a float narrower than `f64` cannot be passed to a C-variadic `...` argument; cast it to `f64`");
        ret false;
    }
    if (d.class == type.PRIM_CLASS_INT && d.bits < 32) {
        report_typed(sc, arg_span, "`", actual, "` is promoted to a 32-bit integer in a C-variadic argument; write the cast (`x::i32` / `x::u32`)",
            "an integer narrower than 32 bits cannot be passed to a C-variadic `...` argument; cast it to `i32` or `u32`");
        ret false;
    }
    ret true;
}

fun param_is_pack(sc: *context.SemaContext, param_idx: u32) bool {
    val opt_param_type: O.Option[type.TypeId] = type.get_param(?sc.s.types, param_idx);
    if (O.is_none[type.TypeId](opt_param_type)) { ret false; }
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, O.unwrap[type.TypeId](opt_param_type));
    if (O.is_none[*type.Type](opt_type)) { ret false; }
    ret O.unwrap[*type.Type](opt_type).kind == type.TYPE_PACK;
}

fun arg_is_spread(sc: *context.SemaContext, eid: id.ExprId) bool {
    val opt_expr: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](opt_expr)) { ret false; }
    ret O.unwrap[*expr.Expr](opt_expr).kind == expr.EXPR_KIND_SPREAD;
}

fun validate_pack_spreads(sc: *context.SemaContext, has_pack: bool, fixed_len: u32, args_start: u32, args_len: u32, span: token.Span) bool {
    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < args_len) {
        val arg_eid: id.ExprId = sc.a.expr_ids[args_start + i];
        if (arg_is_spread(sc, arg_eid)) {
            val arg_span: token.Span = expr_span_of(sc, arg_eid, span);
            if (expr_type_of(sc, arg_eid) == type.TYPE_ERROR) {
                all_ok = false;
            }
            or (!has_pack) {
                report(sc, arg_span, "cannot spread `...` into fixed parameters: the callee has no variadic pack parameter");
                all_ok = false;
            }
            or (i != fixed_len || args_len != fixed_len + 1) {
                report(sc, arg_span, "a `...` pack spread must be the sole trailing argument, forwarding the whole pack");
                all_ok = false;
            }
        }
        i = i + 1;
    }
    ret all_ok;
}

fun arg_names_module_constant(sc: *context.SemaContext, eid: id.ExprId) bool {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
    ret imported_module_const_sym(sc, O.unwrap[*resolve.Symbol](opt_sym));
}

fun arg_probe_ident_is_comptime_param(sc: *context.SemaContext, eid: id.ExprId) bool {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun arg_references_comptime_param(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val depends_r: R.Result[bool, str] = comptime.gate_depends_on[context.SemaContext](sc.a, sc.source, sc,
        comptime.gate_probes[context.SemaContext](arg_probe_ident_is_comptime_param, nil, nil, nil),
        comptime.GATE_PROBE_COMPTIME_PARAM, eid);
    if (R.is_err[bool, str](depends_r)) {
        report(sc, span, R.unwrap_err[bool, str](depends_r));
        ret true;
    }
    ret R.unwrap_ok[bool, str](depends_r);
}

fun callee_origin_ast(sc: *context.SemaContext, callee: id.ExprId) *ast.Ast {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, callee);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret nil; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.origin == sc.own_module) { ret sc.a; }
    ret session.module_ast(sc.s, sym.origin);
}

fun deref_one(sc: *context.SemaContext, object: type.TypeId) type.TypeId {
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, object);
    if (O.is_none[*type.Type](opt_type)) { ret object; }
    val tp: *type.Type = O.unwrap[*type.Type](opt_type);
    if (tp.kind == type.TYPE_POINTER) { ret tp.data.pointer.base; }
    ret object;
}

fun ptr_width(sc: *context.SemaContext) u32 {
    ret sc.ctx.env.pointer_width;
}

fun expr_type_of(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL)                                 { ret type.TYPE_ERROR; }
    if (sc.expr_type == nil || eid::usize >= sc.a.expr_len) { ret type.TYPE_ERROR; }
    ret sc.expr_type[eid];
}

fun expr_span_of(sc: *context.SemaContext, eid: id.ExprId, fallback: token.Span) token.Span {
    val opt_expr: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](opt_expr)) { ret fallback; }
    ret O.unwrap[*expr.Expr](opt_expr).span;
}

fun report(sc: *context.SemaContext, span: token.Span, message: str) {
    context.report(sc, span, message);
}

fun report_note(sc: *context.SemaContext, span: token.Span, message: str, note: str) {
    context.report_note(sc, span, message, note);
}

fun report_mismatch(sc: *context.SemaContext, span: token.Span, expected: type.TypeId, actual: type.TypeId, note: str) {
    if (actual == type.TYPE_NIL) {
        report_typed_note(sc, span, "type mismatch: expected ", expected,
            ", found no value",
            "type mismatch: a value is required, but the expression produces none",
            "a call to a function with no return type produces no value");
        ret;
    }

    val res_expected: R.Result[str, str] = type_to_str(sc, expected);
    val res_actual:   R.Result[str, str] = type_to_str(sc, actual);
    if (R.is_err[str, str](res_expected) || R.is_err[str, str](res_actual)) {
        if (R.is_err[str, str](res_expected)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_expected)); }
        if (R.is_err[str, str](res_actual)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_actual)); }
        report_note(sc, span, "type mismatch: incompatible types in assignment", note);
        if (R.is_ok[str, str](res_expected)) { type_str_free(sc, R.unwrap_ok[str, str](res_expected)); }
        if (R.is_ok[str, str](res_actual))   { type_str_free(sc, R.unwrap_ok[str, str](res_actual)); }
        ret;
    }
    val expected_str: str = R.unwrap_ok[str, str](res_expected);
    val actual_str:   str = R.unwrap_ok[str, str](res_actual);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "type mismatch: expected {}, found {}", expected_str, actual_str);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report_note(sc, span, "type mismatch: incompatible types in assignment", note);
        type_str_free(sc, expected_str);
        type_str_free(sc, actual_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);

    report_types_pair(sc, span, msg, expected, actual, expected_str, actual_str, note);

    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, expected_str);
    type_str_free(sc, actual_str);
}

fun report_types_pair(sc: *context.SemaContext, span: token.Span, msg: str,
                      a: type.TypeId, b: type.TypeId, a_str: str, b_str: str, note: str) {
    if (a == b || !str_equals(a_str, b_str)) {
        report_pair_plain(sc, span, msg, note);
        ret;
    }

    val am: intern.StrId = declaring_module_fqn(sc, a);
    val bm: intern.StrId = declaring_module_fqn(sc, b);
    if (am == intern.STR_NIL || bm == intern.STR_NIL) {
        report_pair_plain(sc, span, msg, note);
        ret;
    }
    val ao: O.Option[str] = intern.lookup(?sc.s.interner, am);
    val bo: O.Option[str] = intern.lookup(?sc.s.interner, bm);
    if (O.is_none[str](ao) || O.is_none[str](bo)) {
        report_pair_plain(sc, span, msg, note);
        ret;
    }

    val res_n: R.Result[str, str] = format.sprint(sc.s.alloc,
        "these are two different types that share the name `{}`: the first is declared in `{}`, the second in `{}`",
        a_str, O.unwrap[str](ao), O.unwrap[str](bo));
    if (R.is_err[str, str](res_n)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_n));
        report_pair_plain(sc, span, msg, note);
        ret;
    }
    val n: str = R.unwrap_ok[str, str](res_n);
    report_note(sc, span, msg, n);
    A.deallocate[char](sc.s.alloc, n, str_len(n) + 1);
}

fun report_pair_plain(sc: *context.SemaContext, span: token.Span, msg: str, note: str) {
    if (str_len(note) == 0) {
        report(sc, span, msg);
        ret;
    }
    report_note(sc, span, msg, note);
}

fun declaring_module_fqn(sc: *context.SemaContext, t: type.TypeId) intern.StrId {
    val opt: O.Option[*type.Type] = type.get(?sc.s.types, t);
    if (O.is_none[*type.Type](opt)) { ret intern.STR_NIL; }
    val ty: *type.Type = O.unwrap[*type.Type](opt);
    if (ty.kind == type.TYPE_REC || ty.kind == type.TYPE_UNI) {
        ret session.module_fqn(sc.s, ty.data.nominal.origin);
    }
    if (ty.kind == type.TYPE_INSTANCE) {
        ret session.module_fqn(sc.s, ty.data.instance.target_origin);
    }
    ret intern.STR_NIL;
}

pub fun report_out_of_range(sc: *context.SemaContext, span: token.Span, cr: coerce.CoerceResult) {
    val res_type: R.Result[str, str] = type_to_str(sc, cr.ty);
    if (R.is_err[str, str](res_type)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_type));
        report(sc, span, "integer value out of range for its type");
        ret;
    }
    val type_str: str            = R.unwrap_ok[str, str](res_type);
    val bounds:   type.IntRange = cr.bounds;

    var sign:     str = "";
    var min_sign: str = "";
    if (cr.negated)         { sign = "-"; }
    if (bounds.min_negated) { min_sign = "-"; }

    var noun: str = "value";
    if (cr.literal) { noun = "literal"; }
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{} {}{} is out of range for {} ({}{}..{})",
        noun, sign, cr.value::usize, type_str, min_sign, bounds.min_mag::usize, bounds.max_mag::usize);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, "integer value out of range for its type");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

fun report_typed_note(sc: *context.SemaContext, span: token.Span, prefix: str, t: type.TypeId, suffix: str, fallback: str, note: str) {
    val res_type: R.Result[str, str] = type_to_str(sc, t);
    if (R.is_err[str, str](res_type)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_type));
        report_note(sc, span, fallback, note);
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}", prefix, type_str, suffix);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report_note(sc, span, fallback, note);
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report_note(sc, span, msg, note);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

fun report_arity(sc: *context.SemaContext, span: token.Span, expected: u32, actual: u32, at_least: bool) {
    var atleast: str = "";
    if (at_least) { atleast = "at least "; }

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "arity mismatch: expected {}{}, found {}",
        atleast, expected::usize, actual::usize);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report(sc, span, "arity mismatch: wrong number of call arguments");
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

fun report_reinterpret_mismatch(sc: *context.SemaContext, span: token.Span, from: type.TypeId, size_from: u32, to: type.TypeId, size_to: u32) {
    val res_from: R.Result[str, str] = type_to_str(sc, from);
    val res_to:   R.Result[str, str] = type_to_str(sc, to);
    if (R.is_err[str, str](res_from) || R.is_err[str, str](res_to)) {
        if (R.is_err[str, str](res_from)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_from)); }
        if (R.is_err[str, str](res_to)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_to)); }
        report_note(sc, span, "bit reinterpret requires equal-size types",
            "`:~` reinterprets bits between types of identical, known byte size");
        if (R.is_ok[str, str](res_from)) { type_str_free(sc, R.unwrap_ok[str, str](res_from)); }
        if (R.is_ok[str, str](res_to))   { type_str_free(sc, R.unwrap_ok[str, str](res_to)); }
        ret;
    }
    val from_str: str = R.unwrap_ok[str, str](res_from);
    val to_str:   str = R.unwrap_ok[str, str](res_to);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "bit reinterpret requires equal-size types: {} ({} bytes) vs {} ({} bytes)",
        from_str, size_from::usize, to_str, size_to::usize);
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        report_note(sc, span, "bit reinterpret requires equal-size types",
            "`:~` reinterprets bits between types of identical, known byte size");
        type_str_free(sc, from_str);
        type_str_free(sc, to_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report_types_pair(sc, span, msg, from, to, from_str, to_str, "");

    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, from_str);
    type_str_free(sc, to_str);
}

pub fun report_instantiation_limit(sc: *context.SemaContext, span: token.Span, outcome: u8,
                                   bare: intern.StrId, args: *type.TypeId, arg_len: u32) {
    var headline: str = "generic instantiation limit exceeded: one module reached the cap on distinct instances";
    if (outcome == context.RECORD_LIMIT_DEPTH) {
        headline = "generic instantiation depth limit exceeded: a generic instantiates itself at a growing type argument";
    }
    report(sc, span, instantiation_chain(sc, headline, bare, args, arg_len));
}

fun instantiation_chain(sc: *context.SemaContext, headline: str, bare: intern.StrId,
                        args: *type.TypeId, arg_len: u32) str {
    val wl: *context.InstWorklist = sc.insts;
    if (wl == nil) { ret headline; }

    var shown: [CHAIN_LINKS]u32;
    var count: u32 = 0;
    var total: u32 = 0;
    var walk:  u32 = sc.inst_parent;
    for (walk != context.INST_NONE && walk < wl.len) {
        if (count < CHAIN_LINKS) {
            shown[count] = walk;
            count = count + 1;
        }
        total = total + 1;
        walk = wl.items[walk].parent;
    }

    val head_r: R.Result[str, str] = format.sprint(sc.s.alloc, "{}; chain: ", headline);
    if (R.is_err[str, str](head_r)) { fail.internal(?sc.status, R.unwrap_err[str, str](head_r)); ret headline; }
    var msg: str = R.unwrap_ok[str, str](head_r);

    if (total > count) {
        val elided: R.Result[str, str] = format.sprint(sc.s.alloc, "... ({} more) -> ", (total - count)::usize);
        if (R.is_err[str, str](elided)) { fail.internal(?sc.status, R.unwrap_err[str, str](elided)); typename.type_str_free(sc.s, msg); ret headline; }
        msg = typename.text_join(sc.s, msg, R.unwrap_ok[str, str](elided), true);
    }

    var i: u32 = count;
    for (i > 0) {
        i = i - 1;
        val e: *context.InstReq = ?wl.items[shown[i]];
        msg = chain_link(sc, msg, e.bare, e.args, e.arg_len);
        msg = typename.text_join(sc.s, msg, " -> ", false);
    }
    msg = chain_link(sc, msg, bare, args, arg_len);

    ret typename.text_stable(sc.s, msg, headline);
}

fun chain_link(sc: *context.SemaContext, msg: str, bare: intern.StrId,
               args: *type.TypeId, arg_len: u32) str {
    val link: R.Result[str, str] = typename.instance_spelling(sc.s, bare, args, arg_len);
    if (R.is_err[str, str](link)) { fail.internal(?sc.status, R.unwrap_err[str, str](link));
        typename.type_str_free(sc.s, msg);
        ret nil;
    }
    ret typename.text_join(sc.s, msg, R.unwrap_ok[str, str](link), true);
}
