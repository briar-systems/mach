fun check_assignable(sc: *sema_context.SemaContext, expected: type.TypeId, actual: type.TypeId, span: lang_source.Span) bool {
    if (type.is_error(expected) || type.is_error(actual)) { ret true; }
    if (type.is_case_selector(?sc.s.types, actual) || type.is_case_selector(?sc.s.types, expected)) {
        report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, span, "a case selector is not a value; it cannot be stored, assigned, or passed as a value");
        ret false;
    }
    if (type.same(expected, actual)) { ret true; }

    if (coerce.is_assignable(sc, actual, expected)) { ret true; }

    report_mismatch(sc, span, expected, actual,
        "mach has no implicit widening; cast the value with `value::Type`");
    ret false;
}

pub fun check_coercible(sc: *sema_context.SemaContext, expected: type.TypeId, eid: ast_id.ExprId, actual: type.TypeId, span: lang_source.Span) bool {
    val cr: coerce.CoerceResult = coerce.try_coerce_literal(sc, eid, expected);
    if (cr.kind == coerce.COERCE_OUT_OF_RANGE) {
        report_out_of_range(sc, span, cr);
        ret false;
    }
    var have: type.TypeId = actual;
    if (cr.kind == coerce.COERCE_COERCED) { have = cr.ty; }

    # a value a cast would make fit is offered that cast as the mismatch's fix
    if (!cast_would_compile(sc, have, expected) || coerce.is_assignable(sc, have, expected)) { ret check_assignable(sc, expected, have, span); }
    var offer:   sema_context.Offer = sema_context.Offer{};
    val offered: bool               = cast_offer(sc, expected, eid, ?offer);
    if (offered) { sc.walk.offer = ?offer; }
    val ok: bool = check_assignable(sc, expected, have, span);
    sc.walk.offer = nil;
    if (offered) { offer_free(sc, ?offer); }
    ret ok;
}

# the cast to `expected` written around expression `eid`: a suffix where the
# cast binds tighter than the expression's own form, parentheses and the
# suffix otherwise. false when no fix can be offered
fun cast_offer(sc: *sema_context.SemaContext, expected: type.TypeId, eid: ast_id.ExprId, out: *sema_context.Offer) bool {
    val opt_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel opt_expr.err) { ret false; }
    val span: lang_source.Span = opt_expr.ok.span;
    if (span.len == 0) { ret false; }

    val ts_r: res[str, fail.Fail] = type_to_str(sc, expected);
    if (sel ts_r.err) {
        fail.internal(?sc.status, fail.describe(ts_r.err));
        ret false;
    }
    val ts: str = ts_r.ok;
    fin { type_str_free(sc, ts); }

    val label_r: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "cast the value to `{}`", ts);
    if (sel label_r.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(label_r.err)));
        ret false;
    }

    var close_fmt: str = ")::{}";
    out.open = "(";
    if (expr_binds_tighter_than_cast(opt_expr.ok.kind)) {
        close_fmt = "::{}";
        out.open  = nil;
    }
    val close_r: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, close_fmt, ts);
    if (sel close_r.err) {
        A.deallocate[char](sc.s.alloc, label_r.ok, str_len(label_r.ok) + 1);
        ret false;
    }
    out.label       = label_r.ok;
    out.close       = close_r.ok;
    out.head.offset = span.offset;
    out.head.len    = 0;
    out.tail.offset = span.offset + span.len;
    out.tail.len    = 0;
    ret true;
}

fun offer_free(sc: *sema_context.SemaContext, o: *sema_context.Offer) {
    A.deallocate[char](sc.s.alloc, o.label, str_len(o.label) + 1);
    A.deallocate[char](sc.s.alloc, o.close, str_len(o.close) + 1);
}

fun cast_would_compile(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId) bool {
    if (type.is_error(from) || type.is_error(to))     { ret false; }
    if (type.same(from, to))                          { ret false; }
    if (!is_numeric(sc, from) || !is_numeric(sc, to)) { ret false; }

    if (type.is_secret(?sc.s.types, from) != type.is_secret(?sc.s.types, to)) { ret false; }

    if (type.is_secret(?sc.s.types, from) && cast_is_fp_conversion(sc, from, to)) { ret false; }

    ret true;
}

# the expression kinds a cast binds to without parentheses; false for every
# other kind (a partition, enumerated by its test)
fun expr_binds_tighter_than_cast(k: ast_expr.ExprKind) bool {
    if (k == ast_expr.EXPR_KIND_IDENT)            { ret true; }
    if (k == ast_expr.EXPR_KIND_COMPTIME_IDENT)   { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_INT)          { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_FLOAT)        { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_CHAR)         { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_STR)          { ret true; }
    if (k == ast_expr.EXPR_KIND_LIT_NIL)          { ret true; }
    if (k == ast_expr.EXPR_KIND_CALL)             { ret true; }
    if (k == ast_expr.EXPR_KIND_INDEX)            { ret true; }
    if (k == ast_expr.EXPR_KIND_MEMBER)           { ret true; }
    if (k == ast_expr.EXPR_KIND_PROJECT)          { ret true; }
    if (k == ast_expr.EXPR_KIND_CAST)             { ret true; }
    if (k == ast_expr.EXPR_KIND_STRIP)            { ret true; }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT)        { ret true; }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT)       { ret true; }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT)       { ret true; }
    if (k == ast_expr.EXPR_KIND_GENERIC_INSTANCE) { ret true; }
    ret false;
}

pub fun check_call(sc: *sema_context.SemaContext, callee_sig: type.TypeId, args_start: u32, args_len: u32, span: lang_source.Span, pack_to_c_tail: bool) bool {
    if (type.is_error(callee_sig)) { ret true; }

    val opt_fun: opt[*type.Type] = type.get(?sc.s.types, callee_sig);
    if (!sel opt_fun.some) {
        report(sc, diagnostic_kind.CALL_NOT_CALLABLE, span, "not callable: callee is not a function");
        ret false;
    }
    val fun_type: *type.Type = opt_fun.some;
    if (fun_type.kind != type.TYPE_FUN) {
        report_typed(sc, diagnostic_kind.CALL_NOT_CALLABLE, span, "not callable: `", callee_sig, "` is not a function", "not callable: callee is not a function");
        ret false;
    }

    val params_len:   u32  = fun_type.data.fn.params_len;
    val params_start: u32  = fun_type.data.fn.params_start;
    val c_variadic:   bool = fun_type.data.fn.c_variadic;

    var fixed_len: u32  = params_len;
    val has_pack:  bool = params_len > 0 && param_is_pack(sc, params_start + params_len - 1);
    if (has_pack) { fixed_len = params_len - 1; }

    if (!validate_pack_spreads(sc, has_pack || c_variadic, fixed_len, args_start, args_len, span)) {
        ret false;
    }

    if (has_pack) {
        if (args_len < fixed_len) {
            report_arity(sc, span, fixed_len, args_len, true);
            ret false;
        }
    }
    or (c_variadic) {
        if (args_len < params_len) {
            report_arity(sc, span, params_len, args_len, true);
            ret false;
        }
    }
    or (args_len != params_len) {
        report_arity(sc, span, params_len, args_len, false);
        ret false;
    }

    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < fixed_len) {
        val opt_param_type: opt[type.TypeId] = type.get_param(?sc.s.types, params_start + i);
        if (!sel opt_param_type.some) {
            all_ok = false;
            brk;
        }
        val expected: type.TypeId = opt_param_type.some;

        val arg_eid:  ast_id.ExprId    = sc.view.a.expr_ids.data[args_start + i];
        val actual:   type.TypeId      = expr_type_of(sc, arg_eid);
        val arg_span: lang_source.Span = expr_span_of(sc, arg_eid, span);
        if (!check_coercible(sc, expected, arg_eid, actual, arg_span)) {
            all_ok = false;
        }
        i = i + 1;
    }

    if (c_variadic) {
        var vi: u32 = params_len;
        for (vi < args_len) {
            val veid: ast_id.ExprId = sc.view.a.expr_ids.data[args_start + vi];
            if (!arg_is_spread(sc, veid)) {
                if (!check_variadic_value(sc, veid, span)) { all_ok = false; }
                or (!check_c_variadic_arg(sc, veid, span)) { all_ok = false; }
            }
            vi = vi + 1;
        }
    }

    if (has_pack) {
        var pk: u32 = fixed_len;
        for (pk < args_len) {
            val parg_eid: ast_id.ExprId = sc.view.a.expr_ids.data[args_start + pk];
            if (!check_variadic_value(sc, parg_eid, span)) { all_ok = false; }
            or (!arg_is_spread(sc, parg_eid)) {
                if (pack_to_c_tail) {
                    if (!check_c_variadic_arg(sc, parg_eid, span)) { all_ok = false; }
                }
                val pactual: type.TypeId = expr_type_of(sc, parg_eid);
                if (!type.is_error(pactual) && sema_context.recover[bool](sc, deep.contains_secret(sc.s, pactual), false)) {
                    report_note(sc, diagnostic_kind.SECRET_VARIADIC, expr_span_of(sc, parg_eid, span),
                        "a secret value cannot be passed to a variadic `...` argument",
                        "a variadic pack erases secrecy and is an observation boundary (format / log / print); declassify with `:>T` first");
                    all_ok = false;
                }
            }
            pk = pk + 1;
        }
    }
    ret all_ok;
}

pub fun check_comptime_call(sc: *sema_context.SemaContext, eid: ast_id.ExprId, callee_sig: type.TypeId, callee: ast_id.ExprId, f: *ast_decl.DeclFun, args_start: u32, args_len: u32, span: lang_source.Span) bool {
    val params_ast: *ast.Ast = callee_origin_ast(sc, callee);
    if (params_ast == nil) { ret true; }

    val param_total: u32 = f.params_len;
    if (args_len != param_total) {
        report_arity(sc, span, param_total, args_len, false);
        ret false;
    }

    val opt_sig: opt[*type.Type] = type.get(?sc.s.types, callee_sig);
    if (!sel opt_sig.some) { ret true; }
    val sig:      *type.Type = opt_sig.some;
    val rt_start: u32        = sig.data.fn.params_start;
    val rt_len:   u32        = sig.data.fn.params_len;

    var values: ComptimeArgs = comptime_args_init(sc, f, params_ast);
    fin { comptime_args_dnit(sc, ?values); }

    var all_ok:  bool = true;
    var i:       u32  = 0;
    var rt_seen: u32  = 0;
    for (i < param_total) {
        val tn:       *ast_decl.TypedName = ?params_ast.typed_names.data[f.params_start + i];
        val arg_eid:  ast_id.ExprId       = sc.view.a.expr_ids.data[args_start + i];
        val arg_span: lang_source.Span    = expr_span_of(sc, arg_eid, span);

        if (tn.comptime) {
            if (!comptime_arg_value(sc, ?values, callee, params_ast, tn, arg_eid, arg_span)) { all_ok = false; }
            i = i + 1;
            cnt;
        }

        if (rt_seen < rt_len) {
            val opt_param_type: opt[type.TypeId] = type.get_param(?sc.s.types, rt_start + rt_seen);
            if (sel opt_param_type.some) {
                val expected: type.TypeId = opt_param_type.some;
                val actual:   type.TypeId = expr_type_of(sc, arg_eid);
                if (!check_coercible(sc, expected, arg_eid, actual, arg_span)) { all_ok = false; }
            }
            rt_seen = rt_seen + 1;
        }
        i = i + 1;
    }
    if (all_ok && values.complete) { record_value_instance(sc, eid, callee, callee_sig, ?values, span); }
    ret all_ok;
}

# the comptime arguments of one call, in parameter order, with the parameters they bind;
# incomplete while any is decided only at an instance of the caller
rec ComptimeArgs {
    values:   *comptime.CTValue;
    names:    *intern.StrId;
    len:      u32;
    cap:      u32;
    complete: bool;
}

fun comptime_args_init(sc: *sema_context.SemaContext, f: *ast_decl.DeclFun, params_ast: *ast.Ast) ComptimeArgs {
    var out: ComptimeArgs;
    out.values   = nil;
    out.names    = nil;
    out.len      = 0;
    out.cap      = 0;
    out.complete = true;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < f.params_len) {
        if (params_ast.typed_names.data[f.params_start + i].comptime) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret out; }
    val vr: res[*comptime.CTValue, A.Error] = A.allocate[comptime.CTValue](sc.s.alloc, n::usize);
    if (sel vr.err) {
        fail.internal(?sc.status, "out of memory holding a call's comptime arguments");
        out.complete = false;
        ret out;
    }
    val nr: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](sc.s.alloc, n::usize);
    if (sel nr.err) {
        A.deallocate[comptime.CTValue](sc.s.alloc, vr.ok, n::usize);
        fail.internal(?sc.status, "out of memory holding a call's comptime arguments");
        out.complete = false;
        ret out;
    }
    out.values = vr.ok;
    out.names  = nr.ok;
    out.cap    = n;
    ret out;
}

fun comptime_args_dnit(sc: *sema_context.SemaContext, values: *ComptimeArgs) {
    if (values.cap == 0) { ret; }
    A.deallocate[comptime.CTValue](sc.s.alloc, values.values, values.cap::usize);
    A.deallocate[intern.StrId](sc.s.alloc, values.names, values.cap::usize);
    values.cap = 0;
}

# evaluates one comptime argument and holds it to its parameter's type. one that names a
# comptime parameter of the enclosing function is decided at each instance of it, where
# the walk binds that parameter, and an instance's walk reports what its template could not
fun comptime_arg_value(sc: *sema_context.SemaContext, values: *ComptimeArgs, callee: ast_id.ExprId, params_ast: *ast.Ast,
    tn: *ast_decl.TypedName, arg_eid: ast_id.ExprId, arg_span: lang_source.Span) bool {
    val per_instance: bool = arg_references_comptime_param(sc, arg_eid, arg_span);
    if (per_instance && !sema_context.walk_binds_values(sc)) {
        values.complete = false;
        ret true;
    }
    val outer: sema_context.Walk = sema_context.walk_open(sc);
    if (per_instance) { sc.walk.silent = false; }
    val ok: bool = comptime_arg_evaluate(sc, values, callee, params_ast, tn, arg_eid, arg_span);
    sema_context.walk_close(sc, outer);
    ret ok;
}

fun comptime_arg_evaluate(sc: *sema_context.SemaContext, values: *ComptimeArgs, callee: ast_id.ExprId, params_ast: *ast.Ast,
    tn: *ast_decl.TypedName, arg_eid: ast_id.ExprId, arg_span: lang_source.Span) bool {
    val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source,
        arg_eid, ?sc.s.interner, expr_float_width(sc, arg_eid));
    sema_context.record_eval_result(sc, res_eval);
    if (sel res_eval.err) {
        values.complete = false;
        # an imported constant this phase cannot read yet is left to the instance that reads it
        if (arg_names_module_constant(sc, arg_eid)) { ret true; }
        report_note(sc, diagnostic_kind.COMPTIME_ARGUMENT_NOT_CONSTANT, arg_span, "comptime argument is not a compile-time constant", res_eval.err.message);
        ret false;
    }
    if (!check_comptime_arg_fits(sc, res_eval.ok, comptime_param_type(sc, callee, params_ast, tn.ty), arg_span)) {
        values.complete = false;
        ret false;
    }
    if (values.len >= values.cap) {
        values.complete = false;
        ret true;
    }
    val text: opt[*lang_source.SourceFile] = lang_source.get(?sc.s.sources, params_ast.file_id);
    if (sel text.none) {
        fail.internal(?sc.status, "a comptime parameter's module has no source");
        values.complete = false;
        ret true;
    }
    val name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, text.some.text, tn.name.offset, tn.name.len);
    if (sel name.err) {
        fail.internal(?sc.status, "out of memory naming a comptime parameter");
        values.complete = false;
        ret true;
    }
    values.values[values.len] = res_eval.ok;
    values.names[values.len]  = name.ok;
    values.len                = values.len + 1;
    ret true;
}

fun expr_float_width(sc: *sema_context.SemaContext, eid: ast_id.ExprId) float.FloatWidth {
    val tid: type.TypeId = expr_type_of(sc, eid);
    if (type.is_nil(tid) || type.is_error(tid)) { ret float.FLOAT_W_NONE; }
    val ct:    type.TypeId     = type.strip_secret(?sc.s.types, sema_context.apply_subst(sc, tid));
    val opt_t: opt[*type.Type] = type.get(?sc.s.types, ct);
    if (!sel opt_t.some) { ret float.FLOAT_W_NONE; }
    ret type.float_width_of(opt_t.some.kind);
}

fun record_value_instance(sc: *sema_context.SemaContext, eid: ast_id.ExprId, callee: ast_id.ExprId, callee_sig: type.TypeId,
    values: *ComptimeArgs, span: lang_source.Span) {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel opt_sym.some) { ret; }
    val sym:      *resolve.Symbol                            = opt_sym.some;
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret; }
    var item: sema_instance.Instance;
    item.kind      = sema_instance.KIND_VALUE;
    item.origin    = sym.origin;
    item.decl      = acquired.ok.symbol.decl;
    item.args      = nil;
    item.arg_len   = 0;
    item.values    = values.values;
    item.names     = values.names;
    item.value_len = values.len;
    item.pack      = nil;
    item.pack_len  = 0;
    item.bare      = sym.name;
    item.canon     = sym.canon;
    item.sig       = callee_sig;
    item.site      = span;
    val recorded: err[fail.Fail] = sema_context.record_instance(sc, item, eid);
    if (sel recorded.err) { report(sc, diagnostic_kind.COMPILER_INTERNAL, span, fail.describe(recorded.err)); }
}

# the declared type of a comptime parameter of `callee`, read from the module that
# declares it
fun comptime_param_type(sc: *sema_context.SemaContext, callee: ast_id.ExprId, params_ast: *ast.Ast, ty: ast_id.TypeId) type.TypeId {
    if (ast_id.type_is_nil(ty) || ast_id.type_index(ty)::usize >= params_ast.types.len) { ret type.TYPE_ERROR; }
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel opt_sym.some) { ret type.TYPE_ERROR; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (module.same(sym.origin, sc.view.own_module)) {
        if (sc.view.type_resolved_ty == nil) { ret type.TYPE_ERROR; }
        ret sc.view.type_resolved_ty[ast_id.type_index(ty)];
    }
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.imported_definition(sc, sym, sema_product.DEFINITION_TYPED);
    if (sel acquired.err) { ret type.TYPE_ERROR; }
    val sr: *sema_product.SemaResult = acquired.ok.definition.sr;
    if (sr == nil || sr.type_resolved_ty == nil) { ret type.TYPE_ERROR; }
    ret sr.type_resolved_ty[ast_id.type_index(ty)];
}

# a comptime argument's value is held to its parameter's type the way a runtime
# argument is, so one its type cannot represent is refused as an overflow
pub fun check_comptime_arg_fits(sc: *sema_context.SemaContext, value: comptime.CTValue, param_ty: type.TypeId, span: lang_source.Span) bool {
    val cr: coerce.CoerceResult = coerce.fit_ct_int(sc, value, param_ty);
    if (cr.kind != coerce.COERCE_OUT_OF_RANGE) { ret true; }
    report_out_of_range_kind(sc, diagnostic_kind.COMPTIME_OVERFLOW, span, cr, "comptime argument", nil);
    ret false;
}

pub fun imported_module_const_sym(sc: *sema_context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    ret sym.definition_kind == resolve.SYM_VAL;
}

pub fun check_index(sc: *sema_context.SemaContext, object: type.TypeId, index: type.TypeId, span: lang_source.Span) opt[type.TypeId] {
    if (type.is_error(object)) { ret opt[type.TypeId].some{type.TYPE_ERROR}; }

    if (!type.is_error(index) && type.is_secret(?sc.s.types, index)) {
        report_note(sc, diagnostic_kind.SECRET_INDEX, span, "secret value used as a memory index",
            "a secret may not address memory; the access pattern leaks through the cache trace. index by a public value, or load the whole table obliviously");
    }

    check_secret_address(sc, object, span);

    val obj_secret: bool        = type.is_secret(?sc.s.types, object);
    val base_obj:   type.TypeId = type.strip_secret(?sc.s.types, object);

    val opt_object: opt[*type.Type] = type.get(?sc.s.types, base_obj);
    if (!sel opt_object.some) {
        report(sc, diagnostic_kind.INDEX_NOT_INDEXABLE, span, "not indexable: object is neither a pointer nor an array");
        ret opt[type.TypeId].none{};
    }
    val object_type: *type.Type = opt_object.some;

    var elem: type.TypeId = type.TYPE_NIL;
    if (object_type.kind == type.TYPE_POINTER) {
        elem = object_type.data.pointer.base;
    }
    or (object_type.kind == type.TYPE_ARRAY) {
        elem = object_type.data.array.base;
    }
    or (object_type.kind == type.TYPE_FUN) {
        report_note(sc, diagnostic_kind.INDEX_NOT_INDEXABLE, span, "not indexable: a function has no elements",
            "type arguments are written where a generic is called (`f[i64](x)`); a generic instance cannot be named as a value");
        ret opt[type.TypeId].none{};
    }
    or {
        report(sc, diagnostic_kind.INDEX_NOT_INDEXABLE, span, "not indexable: object is neither a pointer nor an array");
        ret opt[type.TypeId].none{};
    }

    if (!type.is_error(index) && !is_integer(sc, index)) {
        report(sc, diagnostic_kind.INDEX_TYPE, span, "type mismatch: index must be an integer");
    }
    if (obj_secret) { elem = secret_of(sc, elem); }
    ret opt[type.TypeId].some{elem};
}

pub fun check_const_index(sc: *sema_context.SemaContext, object: type.TypeId, idx: ast_id.ExprId, span: lang_source.Span) bool {
    val n_opt: opt[u32] = type.element_count(?sc.s.types, object);
    if (!sel n_opt.some) { ret true; }

    val cv_opt: opt[comptime.CTValue] = const_index_value(sc, idx);
    if (!sel cv_opt.some) { ret true; }

    val n:  u32              = n_opt.some;
    val cv: comptime.CTValue = cv_opt.some;

    val index_o: opt[u64] = comptime.ct_int_u64(cv);
    var index:   u64      = 0;
    if (sel index_o.some)                   { index = index_o.some; }
    if (sel index_o.some && index < n::u64) { ret true; }

    report_index_oob(sc, span, cv, object, n);
    ret false;
}

# the count of a range `x[i, n]`: a comptime constant, at least one. absent,
# reported at the count, when it is not
pub fun check_range_count(sc: *sema_context.SemaContext, count: ast_id.ExprId, span: lang_source.Span) opt[u32] {
    val at: lang_source.Span      = expr_span_of(sc, count, span);
    val cv: opt[comptime.CTValue] = const_index_value(sc, count);
    if (!sel cv.some) {
        report_note(sc, diagnostic_kind.RANGE_COUNT_NOT_CONSTANT, at, "range count is not a comptime constant",
            "`x[start, count]` takes a constant count; the start may vary");
        ret opt[u32].none{};
    }
    val n_o: opt[u64] = comptime.ct_int_u64(cv.some);
    var n:   u64      = 0;
    if (sel n_o.some) { n = n_o.some; }
    if (comptime.ct_is_negative(cv.some)) {
        report_range_count(sc, at, cv.some, "is negative");
        ret opt[u32].none{};
    }
    if (!sel n_o.some || n > 0xFFFFFFFF) {
        report_range_count(sc, at, cv.some, "is too large");
        ret opt[u32].none{};
    }
    if (n == 0) {
        report_range_count(sc, at, cv.some, "is empty");
        ret opt[u32].none{};
    }
    ret opt[u32].some{n::u32};
}

fun report_range_count(sc: *sema_context.SemaContext, span: lang_source.Span, cv: comptime.CTValue, why: str) {
    var digits:  [wide.FORMAT_CAP]u8;
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "range count {} {}",
        comptime.ct_int_text(cv, ?digits[0]), why);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, diagnostic_kind.RANGE_COUNT_INVALID, span, "range count is negative, empty or too large");
        ret;
    }
    report(sc, diagnostic_kind.RANGE_COUNT_INVALID, span, res_msg.ok);
    A.deallocate[char](sc.s.alloc, res_msg.ok, str_len(res_msg.ok) + 1);
}

# a constant start must keep the whole range inside an array or a vector:
# `start + count` may reach the length and not pass it. a pointer has no length
pub fun check_const_range(sc: *sema_context.SemaContext, object: type.TypeId, start: ast_id.ExprId, count: u32, span: lang_source.Span) bool {
    val n_opt: opt[u32] = type.element_count(?sc.s.types, object);
    if (!sel n_opt.some) { ret true; }

    val cv_opt: opt[comptime.CTValue] = const_index_value(sc, start);
    if (!sel cv_opt.some) { ret true; }

    val n:  u32              = n_opt.some;
    val cv: comptime.CTValue = cv_opt.some;

    val index_o: opt[u64] = comptime.ct_int_u64(cv);
    var index:   u64      = 0;
    if (sel index_o.some)                                                    { index = index_o.some; }
    if (sel index_o.some && index <= n::u64 && count::u64 <= n::u64 - index) { ret true; }

    report_range_oob(sc, span, cv, count, object, n);
    ret false;
}

fun report_range_oob(sc: *sema_context.SemaContext, span: lang_source.Span, cv: comptime.CTValue, count: u32, object: type.TypeId, n: u32) {
    val res_type: res[str, fail.Fail] = type_to_str(sc, object);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report(sc, diagnostic_kind.RANGE_OUT_OF_BOUNDS, span, "range out of bounds for the element count");
        ret;
    }
    val type_str: str = res_type.ok;

    var digits:  [wide.FORMAT_CAP]u8;
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "range [{}, {}] is out of bounds for `{}` of length {}",
        comptime.ct_int_text(cv, ?digits[0]), count, type_str, n);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, diagnostic_kind.RANGE_OUT_OF_BOUNDS, span, "range out of bounds for the element count");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, diagnostic_kind.RANGE_OUT_OF_BOUNDS, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun const_index_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId) opt[comptime.CTValue] {
    if (ast_id.expr_is_nil(eid)) { ret opt[comptime.CTValue].none{}; }

    val cr: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);

    sema_context.record_eval_result(sc, cr);
    if (sel cr.err) { ret opt[comptime.CTValue].none{}; }

    val cv: comptime.CTValue = cr.ok;
    if (cv.kind != comptime.CT_KIND_INT) { ret opt[comptime.CTValue].none{}; }
    ret opt[comptime.CTValue].some{cv};
}

# a shift whose count is a comptime constant must keep the count below the
# left operand's width: at or above it the runtime answer is the saturated
# value (0, or the sign fill), which a constant program never means
pub fun check_shift_count(sc: *sema_context.SemaContext, span: lang_source.Span, lt: type.TypeId, count: ast_id.ExprId) bool {
    val cv_opt: opt[comptime.CTValue] = const_index_value(sc, count);
    if (!sel cv_opt.some) { ret true; }
    val cv:   comptime.CTValue = cv_opt.some;
    val bits: u32              = byte_size(sc, lt) * 8;
    if (bits == 0) { ret true; }
    if (comptime.ct_is_negative(cv)) {
        report_shift_count(sc, span, cv, lt, bits, "is negative");
        ret false;
    }
    if (cv.data.w.hi != 0 || cv.data.w.lo >= bits::u64) {
        report_shift_count(sc, span, cv, lt, bits, "is at least the width of");
        ret false;
    }
    ret true;
}

fun report_shift_count(sc: *sema_context.SemaContext, span: lang_source.Span, cv: comptime.CTValue, lt: type.TypeId, bits: u32, why: str) {
    val fallback: str                 = "shift count is negative or at least the width of the shifted operand";
    val res_type: res[str, fail.Fail] = type_to_str(sc, lt);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report(sc, diagnostic_kind.SHIFT_COUNT, span, fallback);
        ret;
    }
    val type_str: str = res_type.ok;

    var digits:  [wide.FORMAT_CAP]u8;
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "shift count {} {} `{}` ({} bits)",
        comptime.ct_int_text(cv, ?digits[0]), why, type_str, bits);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, diagnostic_kind.SHIFT_COUNT, span, fallback);
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, diagnostic_kind.SHIFT_COUNT, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

fun report_index_oob(sc: *sema_context.SemaContext, span: lang_source.Span, cv: comptime.CTValue, object: type.TypeId, n: u32) {
    val res_type: res[str, fail.Fail] = type_to_str(sc, object);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report(sc, diagnostic_kind.INDEX_OUT_OF_BOUNDS, span, "index out of bounds for the element count");
        ret;
    }
    val type_str: str = res_type.ok;

    var digits:  [wide.FORMAT_CAP]u8;
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "index {} is out of bounds for `{}` of length {}",
        comptime.ct_int_text(cv, ?digits[0]), type_str, n);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, diagnostic_kind.INDEX_OUT_OF_BOUNDS, span, "index out of bounds for the element count");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, diagnostic_kind.INDEX_OUT_OF_BOUNDS, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun check_secret_address(sc: *sema_context.SemaContext, ty: type.TypeId, span: lang_source.Span) bool {
    if (type.is_error(ty))                                   { ret true; }
    if (!type.is_secret(?sc.s.types, ty))                    { ret true; }
    if (!is_pointer(sc, type.strip_secret(?sc.s.types, ty))) { ret true; }

    report_note(sc, diagnostic_kind.SECRET_ADDRESS, span, "secret value used as a memory address",
        "a secret may not address memory; the access pattern leaks through the cache trace, exactly as a secret index does. address with a public pointer, or `:>T`-declassify the pointer when disclosure is intended");
    ret false;
}

fun is_pointer(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    val found: opt[*type.Type] = type.get(?sc.s.types, t);
    if (!sel found.some) { ret false; }
    ret found.some.kind == type.TYPE_POINTER;
}

pub fun check_member(sc: *sema_context.SemaContext, object: type.TypeId, name: intern.StrId, guarded: bool, span: lang_source.Span) opt[type.TypeId] {
    if (type.is_error(object)) { ret opt[type.TypeId].some{type.TYPE_ERROR}; }

    check_secret_address(sc, object, span);

    val deref:            type.TypeId = deref_one(sc, type.strip_secret(?sc.s.types, object));
    val container_secret: bool        = type.is_secret(?sc.s.types, object) || type.is_secret(?sc.s.types, deref);
    val record:           type.TypeId = type.strip_secret(?sc.s.types, deref);

    if (type.is_tag(?sc.s.types, record)) {
        val opt_case: opt[type.TypeId] = sema_context.field_lookup(sc, record, name);
        if (!sel opt_case.some) {
            report_no_field(sc, span, name, record);
            ret opt[type.TypeId].none{};
        }
        if (type.is_nil(opt_case.some)) {
            report(sc, diagnostic_kind.TAG_PAYLOAD_UNEXPECTED, span, "this tag case takes no payload");
            ret opt[type.TypeId].none{};
        }
        if (!guarded) {
            report(sc, diagnostic_kind.TAG_PAYLOAD_UNGUARDED, span, "a tag payload requires a `sel` guard for its case");
            ret opt[type.TypeId].none{};
        }
        var pty: type.TypeId = opt_case.some;
        if (container_secret) { pty = secret_of(sc, pty); }
        ret opt[type.TypeId].some{pty};
    }
    val opt_field: opt[type.TypeId] = sema_context.field_lookup(sc, record, name);
    if (sel opt_field.some) {
        var fty: type.TypeId = opt_field.some;
        if (container_secret) { fty = secret_of(sc, fty); }
        ret opt[type.TypeId].some{fty};
    }

    report_no_field(sc, span, name, record);
    ret opt[type.TypeId].none{};
}

pub fun check_cast(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId, span: lang_source.Span) opt[type.TypeId] {
    if (type.is_error(from) || type.is_error(to)) { ret opt[type.TypeId].some{to}; }
    # neither side's conversion class is known while a type parameter is unsubstituted
    if (sema_context.awaits_instance(sc, from) || sema_context.awaits_instance(sc, to)) { ret opt[type.TypeId].some{to}; }
    if (type.is_case_selector(?sc.s.types, from) || type.is_case_selector(?sc.s.types, to)) {
        report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, span, "a case selector is not a value; it cannot be cast");
        ret opt[type.TypeId].none{};
    }
    if (type.same(from, to))                       { ret opt[type.TypeId].some{to}; }
    if (!check_tag_value_cast(sc, from, to, span)) { ret opt[type.TypeId].none{}; }
    if (!check_abi_type_cast(sc, from, to, span))  { ret opt[type.TypeId].none{}; }

    if (!check_secrecy_cast(sc, from, to, span)) { ret opt[type.TypeId].none{}; }

    val from_vec: bool = type.is_vector(?sc.s.types, from);
    val to_vec:   bool = type.is_vector(?sc.s.types, to);
    if (from_vec && to_vec)           { ret check_vector_cast(sc, from, to, span); }
    if (from_vec && is_array(sc, to)) { ret check_array_vector_cast(sc, to, from, to, span); }
    if (to_vec && is_array(sc, from)) { ret check_array_vector_cast(sc, from, to, to, span); }

    if (is_numeric(sc, from) && is_numeric(sc, to)) {
        if (type.is_secret(?sc.s.types, from) && cast_is_fp_conversion(sc, from, to)) {
            report_note(sc, diagnostic_kind.SECRET_VARIABLE_LATENCY, span, "secret value used as an operand of a variable-latency floating-point conversion",
                "the FP unit's timing can depend on the secret operand; convert public data, or `:>T` to a public value when disclosure is intended");
        }
        ret opt[type.TypeId].some{to};
    }

    val size_from: u32 = byte_size(sc, from);
    val size_to:   u32 = byte_size(sc, to);
    if (size_from != 0 && size_from == size_to) {
        ret opt[type.TypeId].some{to};
    }

    report_note(sc, diagnostic_kind.CAST_INVALID, span, "invalid cast",
        "`::` casts numeric types or reinterprets equal-size values only");
    ret opt[type.TypeId].none{};
}

fun check_tag_value_cast(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId, span: lang_source.Span) bool {
    if (type.same(from, to)) { ret true; }
    val f: bool = sema_context.recover[bool](sc, reach.tag_value(sc.s, from), false);
    val t: bool = sema_context.recover[bool](sc, reach.tag_value(sc.s, to), false);
    if (sel sc.status.kind.internal) { ret false; }
    if (!f && !t)                    { ret true; }
    report(sc, diagnostic_kind.CAST_TAG_REPRESENTATION, span, "a cast cannot change the representation of a tag or an aggregate containing a tag by value");
    ret false;
}

fun check_abi_type_cast(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId, span: lang_source.Span) bool {
    val f: type.TypeId = type.strip_secret(?sc.s.types, from);
    val t: type.TypeId = type.strip_secret(?sc.s.types, to);
    if (!type.is_abi_type(?sc.s.types, f) && !type.is_abi_type(?sc.s.types, t)) { ret true; }
    report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, span, abitype.exclusion_message());
    ret false;
}

# vector `::` applies the scalar numeric rule to each lane pair; lane counts must match
fun check_vector_cast(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId, span: lang_source.Span) opt[type.TypeId] {
    val lanes_from: u32 = type.vector_lanes(?sc.s.types, from);
    val lanes_to:   u32 = type.vector_lanes(?sc.s.types, to);
    if (lanes_from != lanes_to) {
        report_note(sc, diagnostic_kind.CAST_VECTOR_SHAPE, span, "vector lane counts differ",
            "`::` converts a vector lane by lane, so both sides need the same lane count");
        ret opt[type.TypeId].none{};
    }
    val lane_from: opt[type.TypeId] = type.prim(?sc.s.types, type.vector_element(?sc.s.types, from));
    val lane_to:   opt[type.TypeId] = type.prim(?sc.s.types, type.vector_element(?sc.s.types, to));
    if (!type.is_secret(?sc.s.types, from)) { ret opt[type.TypeId].some{to}; }
    if (sel lane_from.some) {
        if (sel lane_to.some) {
            if (cast_is_fp_conversion(sc, lane_from.some, lane_to.some)) {
                report_note(sc, diagnostic_kind.SECRET_VARIABLE_LATENCY, span, "secret value used as an operand of a variable-latency floating-point conversion",
                    "the FP unit's timing can depend on the secret operand; convert public data, or `:>T` to a public value when disclosure is intended");
            }
        }
    }
    ret opt[type.TypeId].some{to};
}

fun is_array(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    val found: opt[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, t));
    if (!sel found.some) { ret false; }
    ret found.some.kind == type.TYPE_ARRAY;
}

# `::` between `[N]T` and `TxN` moves the lanes as they are: the element type
# and the count are the same on both sides
fun check_array_vector_cast(sc: *sema_context.SemaContext, arr: type.TypeId, vec: type.TypeId, to: type.TypeId, span: lang_source.Span) opt[type.TypeId] {
    val at_opt: opt[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, arr));
    if (!sel at_opt.some) { ret opt[type.TypeId].some{to}; }
    val at: *type.Type = at_opt.some;
    if (at.data.array.count != type.vector_lanes(?sc.s.types, vec)) {
        report_note(sc, diagnostic_kind.CAST_VECTOR_SHAPE, span, "array length and vector lane count differ",
            "`::` between `[N]T` and `TxN` converts lane by lane, so both sides need the same count");
        ret opt[type.TypeId].none{};
    }
    val lane: opt[type.TypeId] = type.prim(?sc.s.types, type.vector_element(?sc.s.types, vec));
    var same: bool             = false;
    if (sel lane.some) { same = type.same(type.strip_secret(?sc.s.types, at.data.array.base), lane.some); }
    if (!same) {
        report_note(sc, diagnostic_kind.CAST_VECTOR_ELEMENT, span, "array and vector element types differ",
            "`::` between `[N]T` and `TxN` keeps the element type; convert the vector's lanes with a vector `::` first");
        ret opt[type.TypeId].none{};
    }
    ret opt[type.TypeId].some{to};
}

fun cast_is_fp_conversion(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId) bool {
    val sf: type.TypeId = type.strip_secret(?sc.s.types, from);
    val st: type.TypeId = type.strip_secret(?sc.s.types, to);
    if (type.same(sf, st)) { ret false; }
    ret type.is_float(?sc.s.types, sf) || type.is_float(?sc.s.types, st);
}

fun check_secrecy_cast(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId, span: lang_source.Span) bool {
    val from_raw_ptr: bool = type.same(from, type.id(type.TYPE_PTR::u32));
    val to_raw_ptr:   bool = type.same(to, type.id(type.TYPE_PTR::u32));
    if ((from_raw_ptr && sema_context.recover[bool](sc, deep.contains_secret(sc.s, to), false))
        || (to_raw_ptr && sema_context.recover[bool](sc, deep.contains_secret(sc.s, from), false))) {
        report_note(sc, diagnostic_kind.SECRET_PTR_ERASE, span, "a secret-welded pointer cannot be erased to the untyped `ptr`",
            "secret memory is reached only through secrecy-typed pointers; erasing `^` to `ptr` would let a public alias read it");
        ret false;
    }
    val allowed: secrecy.Agreement = sema_context.recover[secrecy.Agreement](sc, secrecy.cast_allowed(sc.s, sema_context.machine_of(sc), from, to), secrecy.DISAGREE);
    if (sel sc.status.kind.internal) { ret false; }
    if (allowed == secrecy.UNDECIDABLE) {
        report_note(sc, diagnostic_kind.SECRET_CAST_QUALIFIER, span, secrecy.UNBOUNDED_CAST_MSG,
            "each instance points at a fresh instance, so a comparison through the pointer never reaches an end");
        ret false;
    }
    if (allowed != secrecy.AGREE) {
        report_note(sc, diagnostic_kind.SECRET_CAST_QUALIFIER, span, "`::` and `:~` cannot add or drop the secret qualifier `^`",
            "a public value coerces up to secret with no syntax; `:>T` is the only downgrade");
        ret false;
    }
    ret true;
}

pub fun check_reinterpret(sc: *sema_context.SemaContext, from: type.TypeId, to: type.TypeId, span: lang_source.Span) opt[type.TypeId] {
    if (type.is_error(from) || type.is_error(to)) { ret opt[type.TypeId].some{to}; }
    if (type.same(from, to))                      { ret opt[type.TypeId].some{to}; }
    # an unsubstituted parameter has no size to compare; the instance has one
    if (sema_context.awaits_instance(sc, from) || sema_context.awaits_instance(sc, to)) { ret opt[type.TypeId].some{to}; }
    if (!check_tag_value_cast(sc, from, to, span))                                      { ret opt[type.TypeId].none{}; }
    if (!check_abi_type_cast(sc, from, to, span))                                       { ret opt[type.TypeId].none{}; }

    if (!check_secrecy_cast(sc, from, to, span)) { ret opt[type.TypeId].none{}; }

    val size_from: u32 = byte_size(sc, from);
    val size_to:   u32 = byte_size(sc, to);
    if (size_from != 0 && size_from == size_to) { ret opt[type.TypeId].some{to}; }

    report_reinterpret_mismatch(sc, span, from, size_from, to, size_to);
    ret opt[type.TypeId].none{};
}

pub fun check_return(sc: *sema_context.SemaContext, fn_ret: type.TypeId, value: type.TypeId, span: lang_source.Span) bool {
    if (type.is_nil(value)) {
        if (type.is_nil(fn_ret) || type.is_error(fn_ret)) { ret true; }
        report(sc, diagnostic_kind.RET_VALUE, span, "type mismatch: function must return a value");
        ret false;
    }
    if (type.is_nil(fn_ret)) {
        report(sc, diagnostic_kind.RET_VALUE, span, "type mismatch: function returns no value");
        ret false;
    }
    ret check_assignable(sc, fn_ret, value, span);
}

pub fun check_condition(sc: *sema_context.SemaContext, cond: type.TypeId, span: lang_source.Span) bool {
    if (type.is_error(cond)) { ret true; }
    # whether a type parameter is a truth value is the instance's answer, not the template's
    if (sema_context.awaits_instance(sc, cond)) { ret true; }
    if (type.is_secret(?sc.s.types, cond)) {
        report_note(sc, diagnostic_kind.SECRET_BRANCH, span, "secret value used as a branch condition",
            "a secret may not steer control flow; branching on it leaks through timing. compute branch-free, or `:>T` to a public value when disclosure is intended");
        ret false;
    }
    if (type.is_vector(?sc.s.types, cond)) {
        report_note(sc, diagnostic_kind.CONDITION_TYPE, span, "type mismatch: a vector is not a truth value",
            "a vector, including a comparison mask, is not a scalar condition; reduce it to a scalar before branching");
        ret false;
    }
    if (type.is_u8(?sc.s.types, cond)) { ret true; }
    report_note(sc, diagnostic_kind.CONDITION_TYPE, span, "type mismatch: condition must have type u8",
        "comparisons and logical operators produce u8 condition values");
    ret false;
}

pub fun is_numeric(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    ret type.is_numeric(?sc.s.types, t);
}

pub fun is_integer(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    ret type.is_integer(?sc.s.types, t);
}

fun secret_of(sc: *sema_context.SemaContext, t: type.TypeId) type.TypeId {
    val r: res[type.TypeId, fail.Fail] = type.intern_secret(?sc.s.types, t);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret t;
    }
    ret r.ok;
}

pub fun byte_size(sc: *sema_context.SemaContext, t: type.TypeId) u32 {
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, t));
    if (!sel opt_type.some) { ret 0; }
    val tp: *type.Type    = opt_type.some;
    val k:  type.TypeKind = tp.kind;
    val d:  type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) { ret d.bits / 8; }
    if (k == type.TYPE_VECTOR) {
        ret (type.prim_desc(tp.data.vector.element).bits / 8) * tp.data.vector.lanes;
    }
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER || k == type.TYPE_FUN
        || k == type.TYPE_HANDLE) { ret ptr_width(sc); }
    if (k == type.TYPE_ABI) {
        val ext: layout.Extent = sema_context.recover[layout.Extent](sc, extent.of(sc.s, sema_context.machine_of(sc), type.strip_secret(?sc.s.types, t)), layout.unknown_extent(layout.EXTENT_UNKNOWN_NODE));
        if (!ext.ok) { ret 0; }
        ret ext.size;
    }
    if (k == type.TYPE_ARRAY) {
        val total: u64 = byte_size(sc, tp.data.array.base)::u64 * tp.data.array.count::u64;
        if (total > 4294967295) { ret 0; }
        ret total::u32;
    }
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG || k == type.TYPE_INSTANCE) {
        val ext: layout.Extent = sema_context.recover[layout.Extent](sc, extent.of(sc.s, sema_context.machine_of(sc), type.strip_secret(?sc.s.types, t)), layout.unknown_extent(layout.EXTENT_UNKNOWN_NODE));
        if (!ext.ok) { ret 0; }
        ret ext.size;
    }
    ret 0;
}

pub fun type_to_str(sc: *sema_context.SemaContext, t: type.TypeId) res[str, fail.Fail] {
    ret typename.type_to_str(sc.s, t);
}

pub fun type_str_free(sc: *sema_context.SemaContext, owned: str) {
    typename.type_str_free(sc.s, owned);
}

pub fun check_float_capability(sc: *sema_context.SemaContext, tid: type.TypeId, span: lang_source.Span) {
    if (sc.view.ctx == nil || sc.view.ctx.env.has_float)                        { ret; }
    if (type.is_nil(tid) || type.is_error(tid))                                 { ret; }
    if (!sema_context.recover[bool](sc, deep.contains_float(sc.s, tid), false)) { ret; }

    var target_name: str      = "this target";
    val name_o:      opt[str] = intern.get(?sc.s.interner, sc.view.ctx.env.target_isa);
    if (sel name_o.some) { target_name = name_o.some; }

    val res_type: res[str, fail.Fail] = type_to_str(sc, tid);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report(sc, diagnostic_kind.TARGET_NO_FLOAT, span, "floating-point types are unsupported on this target");
        ret;
    }
    val type_str: str = res_type.ok;

    val note: res[opt[str], fail.Fail] = catalog_arch.float_absence_note(target_name);
    if (sel note.err) {
        fail.internal(?sc.status, fail.describe(note.err));
        report(sc, diagnostic_kind.TARGET_NO_FLOAT, span, "floating-point types are unsupported on this target");
        type_str_free(sc, type_str);
        ret;
    }
    val res_msg: res[str, std_format.FormatError] = float_capability_message(sc, type_str, target_name, note.ok);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, diagnostic_kind.TARGET_NO_FLOAT, span, "floating-point types are unsupported on this target");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, diagnostic_kind.TARGET_NO_FLOAT, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

fun float_capability_message(sc: *sema_context.SemaContext, type_str: str, target_name: str, note: opt[str]) res[str, std_format.FormatError] {
    if (sel note.some) {
        ret std_format.sprint(sc.s.alloc,
            "`{}` uses a floating-point type, which target `{}` does not support: {}", type_str, target_name, note.some);
    }
    ret std_format.sprint(sc.s.alloc,
        "`{}` uses a floating-point type, which target `{}` does not support", type_str, target_name);
}

pub fun report_no_field(sc: *sema_context.SemaContext, span: lang_source.Span, name: intern.StrId, record: type.TypeId) {
    val res_type: res[str, fail.Fail] = type_to_str(sc, record);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report(sc, diagnostic_kind.FIELD_UNKNOWN, span, "no such field: type has no field with that name");
        ret;
    }
    val type_str: str = res_type.ok;

    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "no such field `{}` on type {}", typename.name_str(sc.s, name), type_str);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, diagnostic_kind.FIELD_UNKNOWN, span, "no such field: type has no field with that name");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, diagnostic_kind.FIELD_UNKNOWN, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun report_named(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str, name: intern.StrId, suffix: str, fallback: str) {
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{}{}{}", prefix, typename.name_str(sc.s, name), suffix);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, k, span, fallback);
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, k, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

pub fun report_missing_type_args(sc: *sema_context.SemaContext, span: lang_source.Span, name: intern.StrId, expected: u32) {
    val note:    str                              = "a generic declaration is a template, not a type; name it with its type arguments";
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "generic type `{}` named without type arguments: expected {}, found 0", typename.name_str(sc.s, name), expected::usize);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        sema_context.report_note(sc, diagnostic_kind.GENERIC_MISSING_TYPE_ARGS, span, "generic type named without type arguments", note);
        ret;
    }
    val msg: str = res_msg.ok;
    sema_context.report_note(sc, diagnostic_kind.GENERIC_MISSING_TYPE_ARGS, span, msg, note);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

pub fun report_typed(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str, t: type.TypeId, suffix: str, fallback: str) {
    val res_type: res[str, fail.Fail] = type_to_str(sc, t);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report(sc, k, span, fallback);
        ret;
    }
    val type_str: str = res_type.ok;

    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{}{}{}", prefix, type_str, suffix);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, k, span, fallback);
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, k, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

pub fun report_typed2(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str, a: type.TypeId, mid: str, b: type.TypeId, suffix: str, fallback: str) {
    val res_a: res[str, fail.Fail] = type_to_str(sc, a);
    val res_b: res[str, fail.Fail] = type_to_str(sc, b);
    if (sel res_a.err) {
        fail.internal(?sc.status, fail.describe(res_a.err));
        if (sel res_b.err) { fail.internal(?sc.status, fail.describe(res_b.err)); }
        report(sc, k, span, fallback);
        if (sel res_b.ok) { type_str_free(sc, res_b.ok); }
        ret;
    }
    if (sel res_b.err) {
        fail.internal(?sc.status, fail.describe(res_b.err));
        report(sc, k, span, fallback);
        type_str_free(sc, res_a.ok);
        ret;
    }
    val a_str: str = res_a.ok;
    val b_str: str = res_b.ok;

    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{}{}{}{}{}", prefix, a_str, mid, b_str, suffix);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, k, span, fallback);
        type_str_free(sc, a_str);
        type_str_free(sc, b_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report_types_pair(sc, k, span, msg, a, b, a_str, b_str, "");
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, a_str);
    type_str_free(sc, b_str);
}

# the shapes refused as one `...` argument before its secrecy is asked: a case
# selector and an unspread pack are not values at all
fun check_variadic_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) bool {
    if (arg_is_spread(sc, eid)) { ret true; }
    val actual: type.TypeId = expr_type_of(sc, eid);
    if (type.is_error(actual)) { ret true; }
    val arg_span: lang_source.Span = expr_span_of(sc, eid, span);
    if (type.is_case_selector(?sc.s.types, actual)) {
        report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, arg_span, "a case selector is not a value; it cannot be passed to a variadic `...` argument");
        ret false;
    }
    if (type.is_pack(?sc.s.types, actual)) {
        report(sc, diagnostic_kind.PACK_SPREAD, arg_span, "a variadic pack is not one `...` argument; forward the pack with a spread (`va...`)");
        ret false;
    }
    ret true;
}

fun check_c_variadic_arg(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) bool {
    val actual: type.TypeId = expr_type_of(sc, eid);
    if (type.is_error(actual)) { ret true; }
    val arg_span: lang_source.Span = expr_span_of(sc, eid, span);

    if (sema_context.recover[bool](sc, deep.contains_secret(sc.s, actual), false)) {
        report_note(sc, diagnostic_kind.SECRET_VARIADIC, arg_span, "a secret value cannot be passed to a C-variadic `...` argument",
            "a C variadic is an observation boundary (the callee is foreign code that prints or logs it); declassify with `:>T` first");
        ret false;
    }

    val bare:  type.TypeId     = type.strip_secret(?sc.s.types, actual);
    val found: opt[*type.Type] = type.get(?sc.s.types, bare);
    if (!sel found.some) { ret true; }
    val d: type.PrimDesc = type.prim_desc(found.some.kind);

    if (d.class == type.PRIM_CLASS_FLOAT && d.bits < 64) {
        report_typed(sc, diagnostic_kind.CALL_C_VARIADIC_PROMOTION, arg_span, "`", actual, "` is promoted to `f64` in a C-variadic argument; write the cast (`x::f64`)",
            "a float narrower than `f64` cannot be passed to a C-variadic `...` argument; cast it to `f64`");
        ret false;
    }
    if (d.class == type.PRIM_CLASS_INT && d.bits < 32) {
        report_typed(sc, diagnostic_kind.CALL_C_VARIADIC_PROMOTION, arg_span, "`", actual, "` is promoted to a 32-bit integer in a C-variadic argument; write the cast (`x::i32` / `x::u32`)",
            "an integer narrower than 32 bits cannot be passed to a C-variadic `...` argument; cast it to `i32` or `u32`");
        ret false;
    }
    ret true;
}

fun param_is_pack(sc: *sema_context.SemaContext, param_idx: u32) bool {
    val opt_param_type: opt[type.TypeId] = type.get_param(?sc.s.types, param_idx);
    if (!sel opt_param_type.some) { ret false; }
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, opt_param_type.some);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == type.TYPE_PACK;
}

fun arg_is_spread(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val opt_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel opt_expr.err) { ret false; }
    ret opt_expr.ok.kind == ast_expr.EXPR_KIND_SPREAD;
}

fun validate_pack_spreads(sc: *sema_context.SemaContext, has_pack: bool, fixed_len: u32, args_start: u32, args_len: u32, span: lang_source.Span) bool {
    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < args_len) {
        val arg_eid: ast_id.ExprId = sc.view.a.expr_ids.data[args_start + i];
        if (arg_is_spread(sc, arg_eid)) {
            val arg_span: lang_source.Span = expr_span_of(sc, arg_eid, span);
            if (type.is_error(expr_type_of(sc, arg_eid))) {
                all_ok = false;
            }
            or (!has_pack) {
                report(sc, diagnostic_kind.CALL_SPREAD, arg_span, "cannot spread `...` into fixed parameters: the callee has no variadic pack parameter");
                all_ok = false;
            }
            or (i != fixed_len || args_len != fixed_len + 1) {
                report(sc, diagnostic_kind.CALL_SPREAD, arg_span, "a `...` pack spread must be the sole trailing argument, forwarding the whole pack");
                all_ok = false;
            }
        }
        i = i + 1;
    }
    ret all_ok;
}

fun arg_names_module_constant(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    ret imported_module_const_sym(sc, opt_sym.some);
}

fun arg_probe_ident_is_comptime_param(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    val sym: *resolve.Symbol = opt_sym.some;
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun arg_references_comptime_param(sc: *sema_context.SemaContext, eid: ast_id.ExprId, span: lang_source.Span) bool {
    if (ast_id.expr_is_nil(eid)) { ret false; }
    val depends_r: res[bool, fail.Fail] = comptime_gate.gate_depends_on[sema_context.SemaContext](sc.view.a, sc.view.source, sc,
        comptime_gate.gate_probes[sema_context.SemaContext](arg_probe_ident_is_comptime_param, nil, nil, nil, sema_context.comptime_expression),
        comptime_gate.GATE_PROBE_COMPTIME_PARAM, eid);
    if (sel depends_r.err) {
        report(sc, diagnostic_kind.COMPTIME_ARGUMENT_NOT_CONSTANT, span, fail.describe(depends_r.err));
        ret true;
    }
    ret depends_r.ok;
}

fun callee_origin_ast(sc: *sema_context.SemaContext, callee: ast_id.ExprId) *ast.Ast {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, callee);
    if (!sel opt_sym.some) { ret nil; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (module.same(sym.origin, sc.view.own_module)) { ret sc.view.a; }
    ret sema_context.definition_ast(sc, sym.origin);
}

fun deref_one(sc: *sema_context.SemaContext, object: type.TypeId) type.TypeId {
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, object);
    if (!sel opt_type.some) { ret object; }
    val tp: *type.Type = opt_type.some;
    if (tp.kind == type.TYPE_POINTER) { ret tp.data.pointer.base; }
    ret object;
}

fun ptr_width(sc: *sema_context.SemaContext) u32 {
    ret sc.view.ctx.env.pointer_width;
}

fun expr_type_of(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type.TypeId {
    if (ast_id.expr_is_nil(eid))                                                          { ret type.TYPE_ERROR; }
    if (sc.view.expr_type == nil || ast_id.expr_index(eid)::usize >= sc.view.a.exprs.len) { ret type.TYPE_ERROR; }
    ret sc.view.expr_type[ast_id.expr_index(eid)];
}

pub fun expr_span_of(sc: *sema_context.SemaContext, eid: ast_id.ExprId, fallback: lang_source.Span) lang_source.Span {
    val opt_expr: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel opt_expr.err) { ret fallback; }
    ret opt_expr.ok.span;
}

fun report(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str) {
    sema_context.report(sc, k, span, message);
}

fun report_note(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str, note: str) {
    sema_context.report_note(sc, k, span, message, note);
}

fun report_mismatch(sc: *sema_context.SemaContext, span: lang_source.Span, expected: type.TypeId, actual: type.TypeId, note: str) {
    if (type.is_nil(actual)) {
        report_typed_note(sc, diagnostic_kind.TYPE_MISMATCH, span, "type mismatch: expected ", expected,
            ", found no value",
            "type mismatch: a value is required, but the expression produces none",
            "a call to a function with no return type produces no value");
        ret;
    }

    val res_expected: res[str, fail.Fail] = type_to_str(sc, expected);
    val res_actual:   res[str, fail.Fail] = type_to_str(sc, actual);
    if (sel res_expected.err) {
        fail.internal(?sc.status, fail.describe(res_expected.err));
        if (sel res_actual.err) { fail.internal(?sc.status, fail.describe(res_actual.err)); }
        report_note(sc, diagnostic_kind.TYPE_MISMATCH, span, "type mismatch: incompatible types in assignment", note);
        if (sel res_actual.ok) { type_str_free(sc, res_actual.ok); }
        ret;
    }
    if (sel res_actual.err) {
        fail.internal(?sc.status, fail.describe(res_actual.err));
        report_note(sc, diagnostic_kind.TYPE_MISMATCH, span, "type mismatch: incompatible types in assignment", note);
        type_str_free(sc, res_expected.ok);
        ret;
    }
    val expected_str: str = res_expected.ok;
    val actual_str:   str = res_actual.ok;

    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "type mismatch: expected {}, found {}", expected_str, actual_str);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report_note(sc, diagnostic_kind.TYPE_MISMATCH, span, "type mismatch: incompatible types in assignment", note);
        type_str_free(sc, expected_str);
        type_str_free(sc, actual_str);
        ret;
    }
    val msg: str = res_msg.ok;

    report_types_pair(sc, diagnostic_kind.TYPE_MISMATCH, span, msg, expected, actual, expected_str, actual_str, note);

    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, expected_str);
    type_str_free(sc, actual_str);
}

fun report_types_pair(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, msg: str,
    a: type.TypeId, b: type.TypeId, a_str: str, b_str: str, note: str) {
    if (type.same(a, b) || !str_equals(a_str, b_str)) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }

    val am: intern.StrId = declaring_module_fqn(sc, a);
    val bm: intern.StrId = declaring_module_fqn(sc, b);
    if (intern.str_is_nil(am) || intern.str_is_nil(bm)) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }
    val ao: opt[str] = intern.get(?sc.s.interner, am);
    val bo: opt[str] = intern.get(?sc.s.interner, bm);
    if (!sel ao.some) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }
    if (!sel bo.some) {
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }

    val res_n: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "these are two different types that share the name `{}`: the first is declared in `{}`, the second in `{}`",
        a_str, ao.some, bo.some);
    if (sel res_n.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_n.err)));
        report_pair_plain(sc, k, span, msg, note);
        ret;
    }
    val n: str = res_n.ok;
    report_note(sc, k, span, msg, n);
    A.deallocate[char](sc.s.alloc, n, str_len(n) + 1);
}

fun report_pair_plain(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, msg: str, note: str) {
    if (str_len(note) == 0) {
        report(sc, k, span, msg);
        ret;
    }
    report_note(sc, k, span, msg, note);
}

fun declaring_module_fqn(sc: *sema_context.SemaContext, t: type.TypeId) intern.StrId {
    val found: opt[*type.Type] = type.get(?sc.s.types, t);
    if (!sel found.some) { ret intern.STR_NIL; }
    val ty: *type.Type = found.some;
    if (ty.kind == type.TYPE_REC || ty.kind == type.TYPE_UNI || ty.kind == type.TYPE_TAG) {
        ret session.module_fqn(sc.s, session.module_id_for_stable(sc.s, ty.data.nominal.owner.module));
    }
    if (ty.kind == type.TYPE_INSTANCE) {
        ret declaring_module_fqn(sc, ty.data.instance.nominal);
    }
    ret intern.STR_NIL;
}

pub fun report_out_of_range(sc: *sema_context.SemaContext, span: lang_source.Span, cr: coerce.CoerceResult) {
    report_out_of_range_note(sc, span, cr, nil);
}

# the range refusal of a literal no context typed, which took the i64 default
pub fun report_default_out_of_range(sc: *sema_context.SemaContext, span: lang_source.Span, cr: coerce.CoerceResult) {
    report_out_of_range_note(sc, span, cr,
        "an unsuffixed literal its context does not type is i64; give it a suffix (`u64`, `i128`, `u128`) or a typed context");
}

fun report_out_of_range_note(sc: *sema_context.SemaContext, span: lang_source.Span, cr: coerce.CoerceResult, note: str) {
    var noun: str = "value";
    if (cr.literal) { noun = "literal"; }
    report_out_of_range_kind(sc, diagnostic_kind.CONST_OUT_OF_RANGE, span, cr, noun, note);
}

fun report_out_of_range_kind(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, cr: coerce.CoerceResult, noun: str, note: str) {
    val res_type: res[str, fail.Fail] = type_to_str(sc, cr.ty);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report(sc, k, span, "integer value out of range for its type");
        ret;
    }
    val type_str: str           = res_type.ok;
    val bounds:   type.IntRange = cr.bounds;

    var sign:     str = "";
    var min_sign: str = "";
    if (cr.negated)         { sign = "-"; }
    if (bounds.min_negated) { min_sign = "-"; }

    var value_digits: [wide.FORMAT_CAP]u8;
    var min_digits:   [wide.FORMAT_CAP]u8;
    var max_digits:   [wide.FORMAT_CAP]u8;
    val res_msg:      res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{} {}{} is out of range for {} ({}{}..{})",
        noun, sign, wide.text_u(cr.value, ?value_digits[0]), type_str, min_sign,
        wide.text_u(bounds.min_mag, ?min_digits[0]), wide.text_u(bounds.max_mag, ?max_digits[0]));
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, k, span, "integer value out of range for its type");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    if (note == nil) { report(sc, k, span, msg); }
    or               { report_note(sc, k, span, msg, note); }
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

fun report_typed_note(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str, t: type.TypeId, suffix: str, fallback: str, note: str) {
    val res_type: res[str, fail.Fail] = type_to_str(sc, t);
    if (sel res_type.err) {
        fail.internal(?sc.status, fail.describe(res_type.err));
        report_note(sc, k, span, fallback, note);
        ret;
    }
    val type_str: str = res_type.ok;

    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{}{}{}", prefix, type_str, suffix);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report_note(sc, k, span, fallback, note);
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report_note(sc, k, span, msg, note);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

fun report_arity(sc: *sema_context.SemaContext, span: lang_source.Span, expected: u32, actual: u32, at_least: bool) {
    var atleast: str = "";
    if (at_least) { atleast = "at least "; }

    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "arity mismatch: expected {}{}, found {}",
        atleast, expected::usize, actual::usize);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report(sc, diagnostic_kind.CALL_ARITY, span, "arity mismatch: wrong number of call arguments");
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, diagnostic_kind.CALL_ARITY, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

fun report_reinterpret_mismatch(sc: *sema_context.SemaContext, span: lang_source.Span, from: type.TypeId, size_from: u32, to: type.TypeId, size_to: u32) {
    val res_from: res[str, fail.Fail] = type_to_str(sc, from);
    val res_to:   res[str, fail.Fail] = type_to_str(sc, to);
    if (sel res_from.err) {
        fail.internal(?sc.status, fail.describe(res_from.err));
        if (sel res_to.err) { fail.internal(?sc.status, fail.describe(res_to.err)); }
        report_note(sc, diagnostic_kind.CAST_REINTERPRET_SIZE, span, "bit reinterpret requires equal-size types",
            "`:~` reinterprets bits between types of identical, known byte size");
        if (sel res_to.ok) { type_str_free(sc, res_to.ok); }
        ret;
    }
    if (sel res_to.err) {
        fail.internal(?sc.status, fail.describe(res_to.err));
        report_note(sc, diagnostic_kind.CAST_REINTERPRET_SIZE, span, "bit reinterpret requires equal-size types",
            "`:~` reinterprets bits between types of identical, known byte size");
        type_str_free(sc, res_from.ok);
        ret;
    }
    val from_str: str = res_from.ok;
    val to_str:   str = res_to.ok;

    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "bit reinterpret requires equal-size types: {} ({} bytes) vs {} ({} bytes)",
        from_str, size_from::usize, to_str, size_to::usize);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        report_note(sc, diagnostic_kind.CAST_REINTERPRET_SIZE, span, "bit reinterpret requires equal-size types",
            "`:~` reinterprets bits between types of identical, known byte size");
        type_str_free(sc, from_str);
        type_str_free(sc, to_str);
        ret;
    }
    val msg: str = res_msg.ok;
    report_types_pair(sc, diagnostic_kind.CAST_REINTERPRET_SIZE, span, msg, from, to, from_str, to_str, "");

    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, from_str);
    type_str_free(sc, to_str);
}

test expr_binds_tighter_than_cast__partition_exprkind {
    val tighter: [17]ast_expr.ExprKind = [17]ast_expr.ExprKind{ast_expr.EXPR_KIND_IDENT, ast_expr.EXPR_KIND_COMPTIME_IDENT,
        ast_expr.EXPR_KIND_LIT_INT, ast_expr.EXPR_KIND_LIT_FLOAT, ast_expr.EXPR_KIND_LIT_CHAR, ast_expr.EXPR_KIND_LIT_STR,
        ast_expr.EXPR_KIND_LIT_NIL, ast_expr.EXPR_KIND_CALL, ast_expr.EXPR_KIND_INDEX, ast_expr.EXPR_KIND_MEMBER,
        ast_expr.EXPR_KIND_PROJECT, ast_expr.EXPR_KIND_CAST, ast_expr.EXPR_KIND_STRIP, ast_expr.EXPR_KIND_ARRAY_LIT,
        ast_expr.EXPR_KIND_STRUCT_LIT, ast_expr.EXPR_KIND_VECTOR_LIT, ast_expr.EXPR_KIND_GENERIC_INSTANCE};
    val looser: [6]ast_expr.ExprKind = [6]ast_expr.ExprKind{ast_expr.EXPR_KIND_BINARY, ast_expr.EXPR_KIND_UNARY,
        ast_expr.EXPR_KIND_SPREAD, ast_expr.EXPR_KIND_TYPE_REF, ast_expr.EXPR_KIND_SEL, ast_expr.EXPR_KIND_ERROR};
    var i: usize = 0;
    for (i < 17) {
        if (!expr_binds_tighter_than_cast(tighter[i])) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 6) {
        if (expr_binds_tighter_than_cast(looser[i])) { ret 2; }
        i = i + 1;
    }
    ret 0;
}
