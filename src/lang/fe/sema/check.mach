# type checking for semantic analysis
#
# where infer computes the type of every expression bottom-up, check
# validates that those types compose correctly at the sites that constrain
# them - assignments, calls, index and member access, casts, returns, and
# conditions - and reports a diagnostic with the canonical sema prefix when
# they do not.
#
# every check tolerates the poison type: a `TYPE_ERROR` operand short-
# circuits to success (or to an error-typed result) so a single upstream
# failure produces exactly one diagnostic instead of a cascade.
#
# assignability is literal coercion followed by identity (see `coerce`):
# an untyped literal is first offered the expected type, and only if that
# fails are the two types compared for identity. there is no implicit
# widening between typed values.

use std.format;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.coerce;
use mach.lang.fe.sema.context;
use mach.lang.fe.sema.generics;
use mach.lang.layout;
use mach.lang.fe.sema.typename;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.type;

# how many links of a refused instantiation chain a diagnostic spells
val CHAIN_LINKS: u32 = 5;

# checks that a value of type `actual` may flow into a slot of type `expected`
#
# callers coerce literals themselves before delegating here, so this is a pure
# type relation: identity first, then the structural assignability rule from
# `coerce`. records a `type mismatch:` diagnostic against `span` on failure.
# ---
# sc:       the active sema context
# expected: the destination slot's type
# actual:   the source value's (already-coerced) type
# span:     source range to attribute a mismatch to
# ret:      true when the value is assignable, false (with a diagnostic) otherwise
pub fun check_assignable(sc: *context.SemaContext, expected: type.TypeId, actual: type.TypeId, span: token.Span) bool {
    if (expected == type.TYPE_ERROR || actual == type.TYPE_ERROR) { ret true; }
    if (expected == actual)                                       { ret true; }

    if (coerce.is_assignable(sc, actual, expected)) { ret true; }

    report_mismatch(sc, span, expected, actual,
        "mach has no implicit widening; cast the value with `value::Type`");
    ret false;
}

# coerce the literal at `eid` toward `expected`, then check assignability
#
# the single consumer of coerce's tri-state result: it offers the expression the
# destination type (rewriting expr_type[eid] on a successful literal coercion),
# then validates the post-coercion type. an integer literal whose value overflows
# an integer destination reports a dedicated range diagnostic - naming the value
# and the type's bounds, with no cast suggestion - rather than the generic
# widening mismatch, which for an overflow would advise a truncating cast. every
# hard-failure assignment site (bindings, assignments, returns, call arguments,
# aggregate elements) routes here, so the overflow fact coerce computed is
# reported in exactly one place.
# ---
# sc:       the active sema context
# expected: the destination slot's type
# eid:      the source expression; a literal is offered `expected`
# actual:   the source's inferred (pre-coercion) type
# span:     source range to attribute a diagnostic to
# ret:      true when the value is assignable, false (with a diagnostic) otherwise
pub fun check_coercible(sc: *context.SemaContext, expected: type.TypeId, eid: id.ExprId, actual: type.TypeId, span: token.Span) bool {
    val cr: coerce.CoerceResult = coerce.try_coerce_literal(sc, eid, expected);
    if (cr.kind == coerce.COERCE_OUT_OF_RANGE) {
        report_out_of_range(sc, span, cr);
        ret false;
    }
    var have: type.TypeId = actual;
    if (cr.kind == coerce.COERCE_COERCED) { have = cr.ty; }
    ret check_assignable(sc, expected, have, span);
}

# checks a call against the callee's function signature
#
# the callee type must be a function, the argument count must match the fixed
# parameter count (or be at least that many for a pack-tailed or C-variadic
# function), and each fixed argument must be assignable to its parameter. trailing
# pack arguments carry their inferred types unchecked here; their element types are
# fixed per call site at monomorphization. argument expressions are taken from
# `sc.a.expr_ids[args_start ..]`, which lets untyped-literal arguments coerce to
# their parameter type.
#
# A C-VARIADIC callee (`ext fun f(a: T, ...)`) has no declared type for its tail, so
# each tail argument is checked against the C variadic contract instead of a
# parameter: it must already be a type C could pass unpromoted. mach performs no
# implicit conversion anywhere, so it does not silently apply C's default argument
# promotions either - a narrow argument is REPORTED with the cast that fixes it
# (`x::i32`, `x::f64`), which is the only spelling that survives a callee reading
# `va_arg(ap, int)`.
# ---
# sc:         the active sema context
# callee_sig: the callee's type; must be TYPE_FUN
# args_start: start index into sc.a.expr_ids for the argument expressions
# args_len:   number of arguments supplied at the call site
# span:       source range of the call
# ret:        true when the call is well-typed, false (with a diagnostic) otherwise
pub fun check_call(sc: *context.SemaContext, callee_sig: type.TypeId, args_start: u32, args_len: u32, span: token.Span) bool {
    if (callee_sig == type.TYPE_ERROR) { ret true; }

    val opt_fun: O.Option[*type.Type] = type.get(?sc.s.types, callee_sig);
    if (O.is_none[*type.Type](opt_fun)) {
        report(sc, span, "not callable: callee is not a function");
        ret false;
    }
    val fun_type: *type.Type = O.unwrap[*type.Type](opt_fun);
    if (fun_type.kind != type.TYPE_FUN) {
        report_typed(sc, span, "not callable: `", callee_sig, "` is not a function", "not callable: callee is not a function");
        ret false;
    }

    val params_len:   u32  = fun_type.data.fn.params_len;
    val params_start: u32  = fun_type.data.fn.params_start;
    val c_variadic:   bool = fun_type.data.fn.c_variadic;

    # a trailing comptime variadic pack param absorbs every trailing argument:
    # arity is `>= the leading fixed count`, and the collected args carry their
    # inferred types unchecked here - their concrete element types are fixed per
    # call site and bound at monomorphization.
    var fixed_len: u32  = params_len;
    val has_pack:  bool = params_len > 0 && param_is_pack(sc, params_start + params_len - 1);
    if (has_pack) { fixed_len = params_len - 1; }

    # a `va...` pack spread forwards a whole pack; reject an ill-placed one first
    # - before arity and the per-argument check - so a misplaced spread reports
    # its own clear diagnostic rather than an arity mismatch, and a pack operand
    # is never additionally diagnosed against a fixed parameter type.
    if (!validate_pack_spreads(sc, has_pack, fixed_len, args_start, args_len, span)) {
        ret false;
    }

    if (has_pack) {
        if (args_len < fixed_len) {
            report_arity(sc, span, fixed_len, args_len, true);
            ret false;
        }
    }
    or (c_variadic) {
        # the fixed arity is a lower bound; the tail may be empty.
        if (args_len < params_len) {
            report_arity(sc, span, params_len, args_len, true);
            ret false;
        }
    }
    or (args_len != params_len) {
        report_arity(sc, span, params_len, args_len, false);
        ret false;
    }

    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < fixed_len) {
        val opt_param_type: O.Option[type.TypeId] = type.get_param(?sc.s.types, params_start + i);
        if (O.is_none[type.TypeId](opt_param_type)) { all_ok = false; brk; }
        val expected: type.TypeId = O.unwrap[type.TypeId](opt_param_type);

        val arg_eid:  id.ExprId   = sc.a.expr_ids[args_start + i];
        val actual:   type.TypeId = expr_type_of(sc, arg_eid);
        val arg_span: token.Span  = expr_span_of(sc, arg_eid, span);
        # a bare integer / float literal argument adopts the parameter's type, so
        # `err[i64, i32](-1)` passes `-1` as an i32.
        if (!check_coercible(sc, expected, arg_eid, actual, arg_span)) {
            all_ok = false;
        }
        i = i + 1;
    }

    # a C-variadic tail: no parameter type to check against, so each argument is
    # checked against the C variadic contract itself.
    if (c_variadic) {
        var vi: u32 = params_len;
        for (vi < args_len) {
            if (!check_c_variadic_arg(sc, sc.a.expr_ids[args_start + vi], span)) { all_ok = false; }
            vi = vi + 1;
        }
    }

    # GATE (#2162): a secret value cannot enter a `...` variadic pack. A pack's
    # monomorphized instance name erases secrecy (`^u32` and `u32` collapse to one
    # emitted body), so a secret argument silently reuses a public instance and is
    # observed - and a variadic is an observation boundary (format / log / print). The
    # secret must be declassified with `:^` before it enters the pack, uniformly for
    # printlnf, log-style, and any user variadic. A `va...` spread forwards an existing
    # pack, whose elements were gated at their own entry, so it is skipped.
    if (has_pack) {
        var pk: u32 = fixed_len;
        for (pk < args_len) {
            val parg_eid: id.ExprId = sc.a.expr_ids[args_start + pk];
            if (!arg_is_spread(sc, parg_eid)) {
                val pactual: type.TypeId = expr_type_of(sc, parg_eid);
                # DEEP secret check (#2162): a nominal that wraps a secret (`rec P { x:
                # ^u32 }`, a nested record, an all-secret union, a `Box[^u32]`) carries a
                # secret through its field graph even though `carries_secret` treats a
                # nominal as a leaf; the pack-instance mangling erases that secrecy deeply.
                # `generics.contains_secret_deep` materializes lazy generic-instance field
                # tables before walking them (fail-closed if unresolvable), so it is not
                # fooled by an unelaborated instance reaching the boundary.
                if (pactual != type.TYPE_ERROR && generics.contains_secret_deep(sc.s, pactual)) {
                    report_note(sc, expr_span_of(sc, parg_eid, span),
                        "a secret value cannot be passed to a variadic `...` argument",
                        "a variadic pack erases secrecy and is an observation boundary (format / log / print); declassify with `:^` first");
                    all_ok = false;
                }
            }
            pk = pk + 1;
        }
    }
    ret all_ok;
}

# checks a call to a function with comptime value parameters
#
# arity is checked against the AST parameter list (which includes the comptime
# ones); each `$`-parameter's argument must be compile-time foldable (else a
# diagnostic); each runtime-parameter's argument is checked assignable against
# the stripped TYPE_FUN signature, whose params omit the comptime ordinals.
# ---
# sc:         the active sema context
# callee_sig: the callee's stripped TYPE_FUN (comptime params removed)
# callee:     the call's callee expression id (to resolve the origin DeclFun)
# f:          the callee's DeclFun, read from its origin AST
# args_start: start index into sc.a.expr_ids for the argument expressions
# args_len:   number of arguments supplied at the call site
# span:       source range of the call
# ret:        true when the call is well-typed, false (with a diagnostic) otherwise
pub fun check_comptime_call(sc: *context.SemaContext, callee_sig: type.TypeId, callee: id.ExprId, f: *decl.DeclFun, args_start: u32, args_len: u32, span: token.Span) bool {
    val params_ast: *ast.Ast = callee_origin_ast(sc, callee);
    if (params_ast == nil) { ret true; }

    val param_total: u32 = f.params_len;
    if (args_len != param_total) {
        report_arity(sc, span, param_total, args_len, false);
        ret false;
    }

    val opt_sig: O.Option[*type.Type] = type.get(?sc.s.types, callee_sig);
    if (O.is_none[*type.Type](opt_sig)) { ret true; }
    val sig:      *type.Type = O.unwrap[*type.Type](opt_sig);
    val rt_start: u32        = sig.data.fn.params_start;
    val rt_len:   u32        = sig.data.fn.params_len;

    var all_ok:  bool = true;
    var i:       u32  = 0;
    var rt_seen: u32  = 0;
    for (i < param_total) {
        val tn:       *decl.TypedName = ?params_ast.typed_names[f.params_start + i];
        val arg_eid:  id.ExprId       = sc.a.expr_ids[args_start + i];
        val arg_span: token.Span      = expr_span_of(sc, arg_eid, span);

        if (tn.comptime) {
            # the argument bound to a `$`-parameter must fold to a compile-time
            # constant in the caller's comptime context. an argument that itself
            # references a comptime parameter (a recursive comptime-param call,
            # e.g. `f($n - 1)`) is unfoldable at sema (the parameter's value is
            # per call site) but IS foldable at lowering, where the value is
            # bound; its constness is checked there, with an instantiation cap
            # guarding unbounded recursion.
            if (!arg_references_comptime_param(sc, arg_eid) && !arg_names_module_constant(sc, arg_eid)) {
                val res_eval: R.Result[comptime.CTValue, str] = comptime.eval(sc.ctx, sc.a, sc.source, arg_eid, ?sc.s.interner);
                if (R.is_err[comptime.CTValue, str](res_eval)) {
                    # the evaluator's reason (a static string) clarifies why the
                    # fold failed; surface it on a note line.
                    report_note(sc, arg_span, "comptime argument is not a compile-time constant", R.unwrap_err[comptime.CTValue, str](res_eval));
                    all_ok = false;
                }
            }
            i = i + 1;
            cnt;
        }

        # a runtime parameter: check the argument against the next stripped
        # signature param.
        if (rt_seen < rt_len) {
            val opt_param_type: O.Option[type.TypeId] = type.get_param(?sc.s.types, rt_start + rt_seen);
            if (O.is_some[type.TypeId](opt_param_type)) {
                val expected: type.TypeId = O.unwrap[type.TypeId](opt_param_type);
                val actual:   type.TypeId = expr_type_of(sc, arg_eid);
                if (!check_coercible(sc, expected, arg_eid, actual, arg_span)) { all_ok = false; }
            }
            rt_seen = rt_seen + 1;
        }
        i = i + 1;
    }
    ret all_ok;
}

# reports whether `sym` is an import that resolves to a module-level `val` in
# its origin module
#
# the only imports whose constness fold can be deferred to lowering.
# SYM_IMPORTED alone is too broad: it covers every imported symbol (functions,
# records, runtime bindings included), so an imported non-constant used as a
# `$if` gate or `$`-argument would otherwise pass sema and then fail span-less
# at lowering. reads the origin AST through the session registry.
# ---
# sc:  the active sema context
# sym: the resolved symbol to classify
# ret: true when `sym` imports a module-level `val`, false otherwise
pub fun imported_module_const_sym(sc: *context.SemaContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    val origin_ast: *ast.Ast = session.module_ast(sc.s, sym.origin);
    if (origin_ast == nil) { ret false; }
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_decl)) { ret false; }
    ret O.unwrap[*decl.Decl](opt_decl).kind == decl.DECL_KIND_VAL;
}

# checks an index expression `object[index]`
#
# the object must be a pointer or array; the index must be an integer. the
# result type is the pointee / element type. on failure a `not indexable:`
# diagnostic is recorded and `none` is returned (the caller poisons the
# expression).
# ---
# sc:     the active sema context
# object: the indexed object's type
# index:  the index expression's type
# span:   source range of the index expression
# ret:    some(element type) on success, none (with a diagnostic) otherwise
pub fun check_index(sc: *context.SemaContext, object: type.TypeId, index: type.TypeId, span: token.Span) O.Option[type.TypeId] {
    if (object == type.TYPE_ERROR) { ret O.some[type.TypeId](type.TYPE_ERROR); }

    # GATE: a secret index becomes a secret-dependent memory address the leakage
    # model observes through the access trace (#1645). reported before the integer
    # check, which sees through the `^` and would otherwise accept it.
    if (index != type.TYPE_ERROR && type.is_secret(?sc.s.types, index)) {
        report_note(sc, span, "secret value used as a memory index",
            "a secret may not address memory; the access pattern leaks through the cache trace. index by a public value, or load the whole table obliviously");
    }

    # GATE (#2191): the BASE of the access is the other half of the same address.
    # `p[i]` through a `^*T` computes `p + i`, so the address is secret even at a
    # public index - the identical channel the index gate above closes.
    check_secret_address(sc, object, span);

    # a secret container `^[N]T` / `^*T` is indexed through its inner type, and
    # the secrecy joins onto the element (every element of a secret aggregate is
    # secret). `[N]^T` carries the `^` on the element directly.
    val obj_secret: bool = type.is_secret(?sc.s.types, object);
    val base_obj:   type.TypeId = type.strip_secret(?sc.s.types, object);

    val opt_object: O.Option[*type.Type] = type.get(?sc.s.types, base_obj);
    if (O.is_none[*type.Type](opt_object)) {
        report(sc, span, "not indexable: object is neither a pointer nor an array");
        ret O.none[type.TypeId]();
    }
    val object_type: *type.Type = O.unwrap[*type.Type](opt_object);

    var elem: type.TypeId = type.TYPE_NIL;
    if (object_type.kind == type.TYPE_POINTER) {
        elem = object_type.data.pointer.base;
    }
    or (object_type.kind == type.TYPE_ARRAY) {
        elem = object_type.data.array.base;
    }
    or (object_type.kind == type.TYPE_FUN) {
        # `f[T]` names type arguments only where `f` is CALLED; the parser reads a
        # bracket with no call after it as an index, so a reader reaching for an
        # instance-as-a-value gets pointed at the form that exists rather than at a
        # bare "not indexable" (#2305). There is no address-of-an-instance spelling.
        report_note(sc, span, "not indexable: a function has no elements",
            "type arguments are written where a generic is called (`f[i64](x)`); a generic instance cannot be named as a value");
        ret O.none[type.TypeId]();
    }
    or {
        report(sc, span, "not indexable: object is neither a pointer nor an array");
        ret O.none[type.TypeId]();
    }

    if (index != type.TYPE_ERROR && !is_integer(sc, index)) {
        report(sc, span, "type mismatch: index must be an integer");
    }
    if (obj_secret) { elem = secret_of(sc, elem); }
    ret O.some[type.TypeId](elem);
}

# GATE (#2751): a CONSTANT index outside a STATICALLY KNOWN element count
#
# A fixed array's length and a vector's lane count are both part of the type, so
# an index the compiler can fold is decidable here on every target with no
# dataflow at all. Keyed on `type.element_count`, which is the ONE definition of
# "how many elements a type holds" and the same answer `$length_of` gives, so an
# array and a vector cannot drift into different bounds rules and a `^` wrapper
# is seen through by exactly the rule that makes `$length_of(^[4]u8)` four.
#
# Keying on the count rather than on the syntax is what makes the alias, the
# generic field and the nested-aggregate spellings free: `def Buf: [4]i32;` and
# `Box[i64].xs` both name the same interned array type, and the count is read off
# that type rather than off the expression that reached it.
#
# A pointer is deliberately NOT covered: `*T` carries no length, so `p[9]` has
# nothing to be measured against. A non-constant index is likewise out of scope,
# that one needs dataflow.
# ---
# sc:     the active sema context
# object: the indexed object's type
# idx:    the index expression
# span:   source range of the access
# ret:    true when the access is in bounds or not decidable here, false (with a
#         diagnostic) when a folded index falls outside the element count
pub fun check_const_index(sc: *context.SemaContext, object: type.TypeId, idx: id.ExprId, span: token.Span) bool {
    val n_opt: O.Option[u32] = type.element_count(?sc.s.types, object);
    if (O.is_none[u32](n_opt)) { ret true; }

    val cv_opt: O.Option[comptime.CTValue] = const_index_value(sc, idx);
    if (O.is_none[comptime.CTValue](cv_opt)) { ret true; }

    val n:  u32              = O.unwrap[u32](n_opt);
    val cv: comptime.CTValue = O.unwrap[comptime.CTValue](cv_opt);

    if (!comptime.ct_is_negative(cv) && cv.data.i:~u64 < n::u64) { ret true; }

    report_index_oob(sc, span, cv, object, n);
    ret false;
}

# the constant value of an index expression, or none when this layer cannot
# decide it
#
# Folds through `comptime.eval` and trusts the result. The evaluator decides each
# identifier on resolution identity (#2764), so a block-local `var n` sharing its
# name with a module-level `val n` fails the fold instead of reading back the
# module constant - and this rule no longer needs a walk of its own to protect
# itself from the evaluator. A second walk here would be a second place for the
# runtime-binding rule to live, which is exactly what #2751 had to work around.
# ---
# sc:  the active sema context
# eid: the index expression
# ret: some(value) for a decidable integer index, none otherwise
pub fun const_index_value(sc: *context.SemaContext, eid: id.ExprId) O.Option[comptime.CTValue] {
    if (eid == id.EXPR_NIL) { ret O.none[comptime.CTValue](); }

    val cr: R.Result[comptime.CTValue, str] =
        comptime.eval(sc.ctx, sc.a, sc.source, eid, ?sc.s.interner);
    if (R.is_err[comptime.CTValue, str](cr)) { ret O.none[comptime.CTValue](); }

    val cv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, str](cr);
    if (cv.kind != comptime.CT_KIND_INT) { ret O.none[comptime.CTValue](); }
    ret O.some[comptime.CTValue](cv);
}

# report `index N is out of bounds for `T` of length L` at `span`
#
# degrades to a static message on any allocation failure so the refusal always
# lands.
# ---
# sc:     the active sema context
# span:   source range of the access
# cv:     the folded index
# object: the indexed object's type
# n:      its element count
fun report_index_oob(sc: *context.SemaContext, span: token.Span, cv: comptime.CTValue, object: type.TypeId, n: u32) {
    val res_type: R.Result[str, str] = type_to_str(sc, object);
    if (R.is_err[str, str](res_type)) {
        report(sc, span, "index out of bounds for the element count");
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    var res_msg: R.Result[str, str] = R.err[str, str]("unformatted");
    if (cv.int_unsigned) {
        res_msg = format.sprint(sc.s.alloc, "index {} is out of bounds for `{}` of length {}",
            cv.data.i:~u64, type_str, n);
    }
    or {
        res_msg = format.sprint(sc.s.alloc, "index {} is out of bounds for `{}` of length {}",
            cv.data.i, type_str, n);
    }
    if (R.is_err[str, str](res_msg)) {
        report(sc, span, "index out of bounds for the element count");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

# GATE (#2191): reject a value used as a MEMORY ADDRESS whose own type is secret
#
# The address half of the leakage model's memory rule, and the exact counterpart of
# the secret-index gate in `check_index`: an access through a `^*T` computes its
# effective address from a secret, so the cache trace discloses it just as a secret
# index does. Both halves are the same MIR memory operand (base and scaled index),
# so gating one at source level and not the other was an unprincipled split - the
# rule belongs in sema, where it is decidable from the operand's type alone on every
# target, rather than only in the `#[oblivious]`-scoped translation validator, which
# is documented as the BACKSTOP behind the compile-time gates rather than their only
# enforcement point.
#
# Only a secret POINTER is an address. A `^[N]T` or `^Rec` is a secret VALUE held in
# storage whose address is public, so indexing or projecting it at a public offset
# stays constant-time and is not rejected here; a `*^T` is a public address to secret
# storage and is likewise fine. Called from every site that forms a memory access out
# of an operand: `@p`, `p[i]`, and the auto-deref in `p.x`.
# ---
# sc:   the active sema context
# ty:   the type of the operand supplying the address
# span: source range of the access
# ret:  true when the address is public, false (with a diagnostic) otherwise
pub fun check_secret_address(sc: *context.SemaContext, ty: type.TypeId, span: token.Span) bool {
    if (ty == type.TYPE_ERROR)               { ret true; }
    if (!type.is_secret(?sc.s.types, ty))    { ret true; }
    if (!is_pointer(sc, type.strip_secret(?sc.s.types, ty))) { ret true; }

    report_note(sc, span, "secret value used as a memory address",
        "a secret may not address memory; the access pattern leaks through the cache trace, exactly as a secret index does. address with a public pointer, or `:^`-declassify the pointer when disclosure is intended");
    ret false;
}

# whether `t` is a typed pointer `*T`
#
# The raw `ptr` is deliberately excluded: it is not dereferenceable, so it never
# forms a memory access on its own.
# ---
# sc:  the active sema context
# t:   a TypeId, already stripped of any `^`
# ret: true for `*T`
fun is_pointer(sc: *context.SemaContext, t: type.TypeId) bool {
    val opt: O.Option[*type.Type] = type.get(?sc.s.types, t);
    if (O.is_none[*type.Type](opt)) { ret false; }
    ret O.unwrap[*type.Type](opt).kind == type.TYPE_POINTER;
}

# checks a member access `object.name`
#
# delegates field lookup to the sema field tables (which know the fields of
# every record, union, and the builtin `str`). member access auto-dereferences
# a single pointer level: `p.x` on a `*Point` denotes the field through the
# pointer. on a missing field a `no such field:` diagnostic is recorded and
# `none` is returned.
# ---
# sc:     the active sema context
# object: the type of the expression to the left of the dot
# name:   interned identifier of the accessed field
# span:   source range of the member access
# ret:    some(field type) on success, none (with a diagnostic) otherwise
pub fun check_member(sc: *context.SemaContext, object: type.TypeId, name: intern.StrId, span: token.Span) O.Option[type.TypeId] {
    if (object == type.TYPE_ERROR) { ret O.some[type.TypeId](type.TYPE_ERROR); }

    # GATE (#2191): member access auto-dereferences one pointer level, so `p.x`
    # through a `^*Rec` addresses memory with a secret. a `^Rec` VALUE is not an
    # address and is unaffected - only a secret POINTER is rejected.
    check_secret_address(sc, object, span);

    # a secret container taints every field read out of it: accessing a field of a
    # `^Rec` (or through a `*^Rec`) yields a secret value. the field's own
    # declared `^` (e.g. `d: ^[32]u8`) joins with the container's.
    val deref:          type.TypeId = deref_one(sc, type.strip_secret(?sc.s.types, object));
    val container_secret: bool      = type.is_secret(?sc.s.types, object) || type.is_secret(?sc.s.types, deref);
    val record:         type.TypeId = type.strip_secret(?sc.s.types, deref);

    val opt_field: O.Option[type.TypeId] = context.field_lookup(sc, record, name);
    if (O.is_some[type.TypeId](opt_field)) {
        var fty: type.TypeId = O.unwrap[type.TypeId](opt_field);
        if (container_secret) { fty = secret_of(sc, fty); }
        ret O.some[type.TypeId](fty);
    }

    report_no_field(sc, span, name, record);
    ret O.none[type.TypeId]();
}

# checks an explicit cast `value::Type`
#
# two casts are legal: a numeric conversion between primitive numeric types, or
# a bit reinterpretation between any two types of identical byte size. anything
# else is rejected with a `cast:` diagnostic.
# ---
# sc:   the active sema context
# from: the operand's type
# to:   the target type written after `::`
# span: source range of the cast
# ret:  some(to) when the cast is legal, none (with a diagnostic) otherwise
pub fun check_cast(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId, span: token.Span) O.Option[type.TypeId] {
    if (from == type.TYPE_ERROR || to == type.TYPE_ERROR) { ret O.some[type.TypeId](to); }
    if (from == to)                                       { ret O.some[type.TypeId](to); }

    # the welded-storage discipline (#1645): `::` may neither launder a secret
    # pointer to the untyped `ptr` nor add / drop a `^`. checked before the
    # value-conversion rules, which strip secrecy to size and classify operands.
    if (!check_secrecy_cast(sc, from, to, span)) { ret O.none[type.TypeId](); }

    # primitive numeric <-> primitive numeric conversion (secrecy preserved: the
    # secrecy check above already proved from and to agree, so the result keeps
    # whatever `^` the target was written with)
    if (is_numeric(sc, from) && is_numeric(sc, to)) {
        # GATE (#1646): a numeric conversion involving floating point is variable-latency
        # (the FP unit), so a secret operand is rejected - the same always-unsafe class as
        # float arithmetic. covers `^f64 :: ^i64` (fp->int) and `^f32 :: ^f64` (float
        # widen); a `::` cannot drop `^`, so the operand's secrecy is `from`'s. mach has no
        # implicit float widening, so the explicit cast is the only secret-fp-convert path.
        if (type.is_secret(?sc.s.types, from) && cast_is_fp_conversion(sc, from, to)) {
            report_note(sc, span, "secret value used as an operand of a variable-latency floating-point conversion",
                "the FP unit's timing can depend on the secret operand; convert public data, or `:^` to a public value when disclosure is intended");
        }
        ret O.some[type.TypeId](to);
    }

    # same-size bit reinterpretation for everything else (covers
    # pointer <-> pointer, since every pointer type has size 8)
    val size_from: u32 = byte_size(sc, from);
    val size_to:   u32 = byte_size(sc, to);
    if (size_from != 0 && size_from == size_to) {
        ret O.some[type.TypeId](to);
    }

    report_note(sc, span, "cast: conversion is invalid",
        "`::` casts numeric types or reinterprets equal-size values only");
    ret O.none[type.TypeId]();
}

# whether a `::` numeric conversion emits a floating-point operation (#1646)
#
# True when `from` and `to` differ in representation and either is floating point - the
# conversions that lower to a variable-latency FP-convert / FP-widen instruction. A
# same-representation cast (e.g. `^u32 :: ^i32`) emits nothing and an int<->int width
# change is constant-time, so neither is floating point here.
# ---
# sc:   the sema context
# from: the operand's type
# to:   the target type
# ret:  true when the conversion involves a floating-point representation change
fun cast_is_fp_conversion(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId) bool {
    val sf: type.TypeId = type.strip_secret(?sc.s.types, from);
    val st: type.TypeId = type.strip_secret(?sc.s.types, to);
    if (sf == st) { ret false; }
    ret type.is_float(?sc.s.types, sf) || type.is_float(?sc.s.types, st);
}

# enforce the welded-storage secrecy rules common to `::` and `:~` (#1645)
#
# Two prohibitions keep the public/secret aliasing leak unconstructable with no
# alias analysis: a secret-welded pointer (`*^T` and friends) may never be erased
# to the untyped `ptr`, and a cast may never add or drop a `^` (that is the sole
# job of the implicit up-coerce and the `:^` strip). Differing inner leaf shapes
# the cast genuinely converts are unaffected - only `^` placement is compared.
# ---
# sc:   the active sema context
# from: the operand's type
# to:   the target type
# span: source range of the cast
# ret:  true when the cast respects secrecy, false (with a diagnostic) otherwise
fun check_secrecy_cast(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId, span: token.Span) bool {
    val from_raw_ptr: bool = from == type.TYPE_PTR;
    val to_raw_ptr:   bool = to == type.TYPE_PTR;
    # DEEP (#2165): a `*P` whose pointee `P` wraps a `^` field is secret-welded too, but
    # `carries_secret` treats `P` as a leaf, so erasing `*P` to `ptr` would launder the
    # secret bytes. `contains_secret_deep` inspects the whole pointee field graph.
    if ((from_raw_ptr && generics.contains_secret_deep(sc.s, to))
        || (to_raw_ptr && generics.contains_secret_deep(sc.s, from))) {
        report_note(sc, span, "cast: a secret-welded pointer cannot be erased to the untyped `ptr`",
            "secret memory is reached only through secrecy-typed pointers; erasing `^` to `ptr` would let a public alias read it");
        ret false;
    }
    # DEEP (#2165): the reinterpret's `^` placement must match through the field graph, not
    # just the pointer / array spine - else `*P :~ *Q` (P has a `^` field, Q public)
    # reinterprets the secret pointee as public and reads it out.
    if (!generics.secrecy_structure_equal_deep(sc.s, context.machine_of(sc), from, to)) {
        report_note(sc, span, "cast: `::` and `:~` cannot add or drop the secret qualifier `^`",
            "a public value coerces up to secret with no syntax; `:^` is the only downgrade");
        ret false;
    }
    ret true;
}

# checks a bit-reinterpret cast `value:~Type`
#
# legal only when `from` and `to` have a known, identical byte size; the
# operand's exact bits are reinterpreted as the target type. a size mismatch (or
# an unknown-layout operand) is rejected with a `bit reinterpret:` diagnostic
# naming both types and their sizes.
# ---
# sc:   the active sema context
# from: the operand's type
# to:   the target type written after `:~`
# span: source range of the cast
# ret:  some(to) when the reinterpret is legal, none (with a diagnostic) otherwise
pub fun check_reinterpret(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId, span: token.Span) O.Option[type.TypeId] {
    if (from == type.TYPE_ERROR || to == type.TYPE_ERROR) { ret O.some[type.TypeId](to); }

    # `:~` is bound by the same welded-storage secrecy rules as `::` - it can
    # neither erase a secret pointer to `ptr` nor change a `^` (#1645).
    if (!check_secrecy_cast(sc, from, to, span)) { ret O.none[type.TypeId](); }

    val size_from: u32 = byte_size(sc, from);
    val size_to:   u32 = byte_size(sc, to);
    if (size_from != 0 && size_from == size_to) { ret O.some[type.TypeId](to); }

    report_reinterpret_mismatch(sc, span, from, size_from, to, size_to);
    ret O.none[type.TypeId]();
}

# checks a `ret value;` against the enclosing function's declared return type
#
# a bare `ret;` is signalled by `value == TYPE_NIL` and is valid only when the
# function returns nothing (fn_ret TYPE_NIL); a value is required otherwise and
# must be assignable to the return type. `value` is the already-inferred (and
# caller-coerced) type of the returned expression.
# ---
# sc:     the active sema context
# fn_ret: the enclosing function's declared return type (TYPE_NIL = no return)
# value:  the returned value's inferred type (TYPE_NIL for a bare `ret;`)
# span:   source range of the return statement
# ret:    true when the return is well-typed, false (with a diagnostic) otherwise
pub fun check_return(sc: *context.SemaContext, fn_ret: type.TypeId, value: type.TypeId, span: token.Span) bool {
    if (value == type.TYPE_NIL) {
        if (fn_ret == type.TYPE_NIL || fn_ret == type.TYPE_ERROR) { ret true; }
        report(sc, span, "type mismatch: function must return a value");
        ret false;
    }
    if (fn_ret == type.TYPE_NIL) {
        report(sc, span, "type mismatch: function returns no value");
        ret false;
    }
    ret check_assignable(sc, fn_ret, value, span);
}

# checks that a control-flow condition is usable as a truth value
#
# Mach has no distinct boolean type; comparisons and logical operators produce
# `u8` (the stdlib `bool`), so a condition must be an integer primitive. a
# non-integer condition records a `type mismatch:` diagnostic.
# ---
# sc:   the active sema context
# cond: the condition expression's inferred type
# span: source range of the condition
# ret:  true when the condition is an integer primitive, false otherwise
pub fun check_condition(sc: *context.SemaContext, cond: type.TypeId, span: token.Span) bool {
    if (cond == type.TYPE_ERROR) { ret true; }
    # GATE: a secret condition is a secret-dependent branch the leakage model
    # observes through the control-flow trace (#1645). reported before the integer
    # check, which sees through the `^` and would otherwise accept it.
    if (type.is_secret(?sc.s.types, cond)) {
        report_note(sc, span, "secret value used as a branch condition",
            "a secret may not steer control flow; branching on it leaks through timing. compute branch-free, or `:^` to a public value when disclosure is intended");
        ret false;
    }
    # a vector (including a comparison mask) is not a scalar truth value (#1965).
    if (type.is_vector(?sc.s.types, cond)) {
        report_note(sc, span, "type mismatch: a vector is not a truth value",
            "a vector, including a comparison mask, is not a scalar condition; reduce it to a scalar before branching");
        ret false;
    }
    if (is_integer(sc, cond))    { ret true; }
    report_note(sc, span, "type mismatch: condition must be an integer",
        "mach has no `bool` type; comparisons yield an integer truth value");
    ret false;
}

# reports whether `t` is any numeric primitive (integer or float)
#
# delegates to the shared kind-based predicate in the type layer.
# ---
# sc:  the active sema context
# t:   a TypeId
# ret: true for u8..u64, i8..i64, f32, f64
pub fun is_numeric(sc: *context.SemaContext, t: type.TypeId) bool {
    ret type.is_numeric(?sc.s.types, t);
}

# reports whether `t` is an integer primitive (any signed or unsigned width)
#
# delegates to the shared kind-based predicate in the type layer.
# ---
# sc:  the active sema context
# t:   a TypeId
# ret: true for u8..u64 and i8..i64
pub fun is_integer(sc: *context.SemaContext, t: type.TypeId) bool {
    ret type.is_integer(?sc.s.types, t);
}

# wrap `t` in the secret qualifier `^t`, used by the secrecy JOIN when a secret
# container taints a value read out of it (#1645)
#
# A doubled qualifier collapses in intern_secret; an allocation failure degrades
# to `t` unchanged (the diagnostic for the real error lands elsewhere).
# ---
# sc:  the active sema context
# t:   the type to qualify
# ret: `^t`, or `t` unchanged on an allocation failure
fun secret_of(sc: *context.SemaContext, t: type.TypeId) type.TypeId {
    val r: R.Result[type.TypeId, str] = type.intern_secret(?sc.s.types, t);
    if (R.is_err[type.TypeId, str](r)) { ret t; }
    ret R.unwrap_ok[type.TypeId, str](r);
}

# the byte size of a type, resolving pointers/arrays/records via the interner
#
# pointer and function values are pointer-sized, read from the target's pointer
# width. A nominal aggregate is measured through `generics.type_extent`, the same
# policy `$size_of` folds with and `me.ir.type` lays out with (#2289), so the size
# a cast is checked against is the size the type actually has. Reporting 0 for
# every `rec` and `uni` instead - on the reasoning that the backend owns layout -
# made `:~` and `::` reject every reinterpret involving one, while `$size_of` on
# the same type answered correctly (#2672).
#
# A 0 result still signals "size unknown" and disables same-size cast
# reinterpretation. It stays reachable: an unmeasurable extent (a layout cycle, or
# a nest past `SEMA_LAYOUT_MAX_DEPTH`) reports `ok = false` and sizes as 0, which
# fails the cast closed rather than on a wrong number. An empty record measures a
# genuine 0 and is refused for the same reason - there are no bits to reinterpret.
# secrecy has no runtime width, so a `^T` sizes exactly as `T`.
# ---
# sc:  the active sema context
# t:   a TypeId
# ret: the size in bytes, or 0 when the size is not known at this layer
pub fun byte_size(sc: *context.SemaContext, t: type.TypeId) u32 {
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, t));
    if (O.is_none[*type.Type](opt_type)) { ret 0; }
    val tp: *type.Type    = O.unwrap[*type.Type](opt_type);
    val k:  type.TypeKind = tp.kind;
    val d:  type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) { ret d.bits / 8; }
    # a vector is `lanes` lanes of its element, packed: `f32x4` is 16 and `f32x3` is
    # 12 (#2687). measured here rather than deferred to `type_extent`, which handles
    # only the nominal aggregates.
    if (k == type.TYPE_VECTOR) {
        ret (type.prim_desc(tp.data.vector.element).bits / 8) * tp.data.vector.lanes;
    }
    # a raw `ptr`, a typed `*T`, and a function value (a code address) are all
    # pointer-sized, read from the target's pointer width. an opaque image / sampler
    # handle lays out the same way (#2794): it is a name for a descriptor the
    # pipeline binds, with no representation a program can read, and a pointer is
    # the shape every target already has for exactly that.
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER || k == type.TYPE_FUN
        || k == type.TYPE_HANDLE) { ret ptr_width(sc); }
    if (k == type.TYPE_ARRAY) {
        # widen the multiply: a >4GiB array would wrap a u32 product and report a
        # wrong size to cast legality, so saturate to the 0 "unknown" sentinel.
        val total: u64 = byte_size(sc, tp.data.array.base)::u64 * tp.data.array.count::u64;
        if (total > 4294967295) { ret 0; }
        ret total::u32;
    }
    # a nominal aggregate (`rec` / `uni`) and a generic instance of one: measured,
    # not assumed unknown. `type_extent` reports `ok = false` rather than a wrong
    # number when it cannot decide, which sizes as 0 and fails the cast closed.
    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE) {
        val ext: layout.Extent = generics.type_extent(sc.s, context.machine_of(sc), type.strip_secret(?sc.s.types, t));
        if (!ext.ok) { ret 0; }
        ret ext.size;
    }
    ret 0;
}

# render `t` to an owned, human-readable spelling for diagnostics
#
# the sema-facing spelling of `typename.type_to_str`: the renderer itself needs
# only the session, so it lives in `typename` where lowering can reach it too.
# ---
# sc:  the active sema context (supplies the session)
# t:   the type to render
# ret: an owned, null-terminated spelling, or an allocation error
pub fun type_to_str(sc: *context.SemaContext, t: type.TypeId) R.Result[str, str] {
    ret typename.type_to_str(sc.s, t);
}

# release a string returned by type_to_str
# ---
# sc:    the sema context whose allocator backed the string
# owned: the owned string to free (nil is a no-op)
pub fun type_str_free(sc: *context.SemaContext, owned: str) {
    typename.type_str_free(sc.s, owned);
}

# report a `no such field `<name>` on type <T>` diagnostic
#
# names the missing field and the record type it was looked up on. any
# allocation failure degrades to a static, name-free message so the error is
# always reported.
# ---
# sc:     the active sema context
# span:   source range to pin the diagnostic to
# name:   interned identifier of the missing field
# record: the record/union type the field was looked up on
pub fun report_no_field(sc: *context.SemaContext, span: token.Span, name: intern.StrId, record: type.TypeId) {
    val res_type: R.Result[str, str] = type_to_str(sc, record);
    if (R.is_err[str, str](res_type)) {
        report(sc, span, "no such field: type has no field with that name");
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "no such field `{}` on type {}", typename.name_str(sc.s, name), type_str);
    if (R.is_err[str, str](res_msg)) {
        report(sc, span, "no such field: type has no field with that name");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

# report `<prefix><name><suffix>` at `span`, interpolating the interned
# identifier `name`
#
# on any allocation failure it degrades to the static `fallback` so the
# diagnostic always lands.
# ---
# sc:       the active sema context
# span:     source range to pin the diagnostic to
# prefix:   text before the rendered name
# name:     interned identifier to embed
# suffix:   text after the rendered name
# fallback: name-free message used when allocation fails
pub fun report_named(sc: *context.SemaContext, span: token.Span, prefix: str, name: intern.StrId, suffix: str, fallback: str) {
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}", prefix, typename.name_str(sc.s, name), suffix);
    if (R.is_err[str, str](res_msg)) {
        report(sc, span, fallback);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

# report a generic type named without its type arguments, citing the declared
# arity and the spelling that fixes it
#
# The note carries the rule, because the mistake is not a miscount: the template
# is not a type at all, and the count alone reads like an off-by-one. Any
# allocation failure degrades to a static, name-free message so the error is
# always reported.
# ---
# sc:       the active sema context
# span:     source range to pin the diagnostic to
# name:     interned identifier of the generic declaration
# expected: the declared type-parameter count
pub fun report_missing_type_args(sc: *context.SemaContext, span: token.Span, name: intern.StrId, expected: u32) {
    val note: str = "a generic declaration is a template, not a type; name it with its type arguments";
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "generic type `{}` named without type arguments: expected {}, found 0", typename.name_str(sc.s, name), expected::usize);
    if (R.is_err[str, str](res_msg)) {
        context.report_note(sc, span, "generic type named without type arguments", note);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    context.report_note(sc, span, msg, note);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

# report `<prefix><type><suffix>` at `span`, rendering `t` through type_to_str
#
# on any allocation failure it degrades to the static `fallback` so the
# diagnostic always lands.
# ---
# sc:       the active sema context
# span:     source range to pin the diagnostic to
# prefix:   text before the rendered type
# t:        the type to render into the message
# suffix:   text after the rendered type
# fallback: type-free message used when rendering or allocation fails
pub fun report_typed(sc: *context.SemaContext, span: token.Span, prefix: str, t: type.TypeId, suffix: str, fallback: str) {
    val res_type: R.Result[str, str] = type_to_str(sc, t);
    if (R.is_err[str, str](res_type)) {
        report(sc, span, fallback);
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}", prefix, type_str, suffix);
    if (R.is_err[str, str](res_msg)) {
        report(sc, span, fallback);
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

# report `<prefix><a><mid><b><suffix>` at `span`, rendering both `a` and `b`
# through type_to_str
#
# degrades to the static `fallback` on any allocation failure so the diagnostic
# always lands.
# ---
# sc:       the active sema context
# span:     source range to pin the diagnostic to
# prefix:   text before the first rendered type
# a:        the first type to render
# mid:      text between the two rendered types
# b:        the second type to render
# suffix:   text after the second rendered type
# fallback: type-free message used when rendering or allocation fails
pub fun report_typed2(sc: *context.SemaContext, span: token.Span, prefix: str, a: type.TypeId, mid: str, b: type.TypeId, suffix: str, fallback: str) {
    val res_a: R.Result[str, str] = type_to_str(sc, a);
    val res_b: R.Result[str, str] = type_to_str(sc, b);
    if (R.is_err[str, str](res_a) || R.is_err[str, str](res_b)) {
        report(sc, span, fallback);
        if (R.is_ok[str, str](res_a)) { type_str_free(sc, R.unwrap_ok[str, str](res_a)); }
        if (R.is_ok[str, str](res_b)) { type_str_free(sc, R.unwrap_ok[str, str](res_b)); }
        ret;
    }
    val a_str: str = R.unwrap_ok[str, str](res_a);
    val b_str: str = R.unwrap_ok[str, str](res_b);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}{}{}", prefix, a_str, mid, b_str, suffix);
    if (R.is_err[str, str](res_msg)) {
        report(sc, span, fallback);
        type_str_free(sc, a_str);
        type_str_free(sc, b_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report_types_pair(sc, span, msg, a, b, a_str, b_str, "");
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, a_str);
    type_str_free(sc, b_str);
}

# checks one argument in a C-variadic callee's tail against the C variadic contract
#
# A tail argument has no declared parameter type, so what constrains it is the shape
# C guarantees a `va_arg` reader on the other side. C applies DEFAULT ARGUMENT
# PROMOTIONS there: an integer narrower than `int` arrives as an `int`, and a
# `float` arrives as a `double`. mach has no implicit conversions, so it does not
# insert those promotions silently - it rejects the narrow argument and names the
# cast, because the alternative is the exact failure shape #2575 exists to close: a
# value the callee reads at a width the caller never wrote.
#
# A secret is rejected for the reason a pack argument is (#2162): a C variadic is an
# observation boundary - the callee is libc, which prints or logs the value - so the
# secrecy must be dropped deliberately with `:^`.
#
# Everything at least four bytes wide passes: an i32/u32/i64/u64, an f64, any
# pointer, and an aggregate or vector (which C passes by value in a variadic
# position under every psABI mach targets).
# ---
# sc:  the active sema context
# eid: the tail argument's expression id
# ret: true when the argument may cross a C variadic boundary as written
fun check_c_variadic_arg(sc: *context.SemaContext, eid: id.ExprId, span: token.Span) bool {
    val actual:   type.TypeId  = expr_type_of(sc, eid);
    if (actual == type.TYPE_ERROR) { ret true; }
    val arg_span: token.Span   = expr_span_of(sc, eid, span);

    if (generics.contains_secret_deep(sc.s, actual)) {
        report_note(sc, arg_span, "a secret value cannot be passed to a C-variadic `...` argument",
            "a C variadic is an observation boundary (the callee is foreign code that prints or logs it); declassify with `:^` first");
        ret false;
    }

    val bare: type.TypeId  = type.strip_secret(?sc.s.types, actual);
    val opt:  O.Option[*type.Type] = type.get(?sc.s.types, bare);
    if (O.is_none[*type.Type](opt)) { ret true; }
    val d: type.PrimDesc = type.prim_desc(O.unwrap[*type.Type](opt).kind);

    if (d.class == type.PRIM_CLASS_FLOAT && d.bits < 64) {
        report_typed(sc, arg_span, "`", actual, "` is promoted to `f64` in a C-variadic argument; write the cast (`x::f64`)",
            "a float narrower than `f64` cannot be passed to a C-variadic `...` argument; cast it to `f64`");
        ret false;
    }
    if (d.class == type.PRIM_CLASS_INT && d.bits < 32) {
        report_typed(sc, arg_span, "`", actual, "` is promoted to a 32-bit integer in a C-variadic argument; write the cast (`x::i32` / `x::u32`)",
            "an integer narrower than 32 bits cannot be passed to a C-variadic `...` argument; cast it to `i32` or `u32`");
        ret false;
    }
    ret true;
}

# whether the parameter interned at `param_idx` is a comptime variadic pack
#
# the trailing form that absorbs a call's remaining arguments.
# ---
# sc:        the active sema context
# param_idx: index into the type interner's parameter pool
# ret:       true when the parameter's type is TYPE_PACK
fun param_is_pack(sc: *context.SemaContext, param_idx: u32) bool {
    val opt_param_type: O.Option[type.TypeId] = type.get_param(?sc.s.types, param_idx);
    if (O.is_none[type.TypeId](opt_param_type)) { ret false; }
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, O.unwrap[type.TypeId](opt_param_type));
    if (O.is_none[*type.Type](opt_type)) { ret false; }
    ret O.unwrap[*type.Type](opt_type).kind == type.TYPE_PACK;
}

# whether the argument at `eid` is a `va...` pack spread
# ---
# sc:  the active sema context
# eid: the argument expression id
# ret: true when the expression is an EXPR_KIND_SPREAD
fun arg_is_spread(sc: *context.SemaContext, eid: id.ExprId) bool {
    val opt_expr: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](opt_expr)) { ret false; }
    ret O.unwrap[*expr.Expr](opt_expr).kind == expr.EXPR_KIND_SPREAD;
}

# validates the placement of any `va...` pack spread among a call's arguments
#
# a spread forwards a whole pack and is valid ONLY as the sole trailing argument
# of a pack-tailed callee - i.e. at index `fixed_len` with `args_len == fixed_len
# + 1`. spreading into fixed parameters (no pack tail) or a spread mixed with
# other trailing args is rejected. a spread whose operand is not a pack already
# reported in `infer_spread`, so it is not re-diagnosed here.
# ---
# sc:         the active sema context
# has_pack:   whether the callee has a trailing pack parameter
# fixed_len:  number of leading fixed parameters
# args_start: start index into sc.a.expr_ids for the argument expressions
# args_len:   number of arguments supplied at the call site
# span:       fallback source range for a spread whose own span is unavailable
# ret:        true when every spread is well-placed, false (with a diagnostic) otherwise
fun validate_pack_spreads(sc: *context.SemaContext, has_pack: bool, fixed_len: u32, args_start: u32, args_len: u32, span: token.Span) bool {
    var all_ok: bool = true;
    var i:      u32  = 0;
    for (i < args_len) {
        val arg_eid: id.ExprId = sc.a.expr_ids[args_start + i];
        if (arg_is_spread(sc, arg_eid)) {
            val arg_span: token.Span = expr_span_of(sc, arg_eid, span);
            if (expr_type_of(sc, arg_eid) == type.TYPE_ERROR) {
                all_ok = false;
            }
            or (!has_pack) {
                report(sc, arg_span, "cannot spread `...` into fixed parameters: the callee has no variadic pack parameter");
                all_ok = false;
            }
            or (i != fixed_len || args_len != fixed_len + 1) {
                report(sc, arg_span, "a `...` pack spread must be the sole trailing argument, forwarding the whole pack");
                all_ok = false;
            }
        }
        i = i + 1;
    }
    ret all_ok;
}

# reports whether `eid` names a constant imported from another module
#
# an imported binding that resolves to a module-level `val` in its origin
# module. such a value lives only in the defining module's comptime context,
# which sema does not hold, so its constness fold is deferred to lowering. a
# local or module-level SYM_VAL is NOT deferred: a comptime one folds in the
# eager check here, and a non-foldable (runtime) one is reported eagerly rather
# than slipping through an uninstantiated template whose body never lowers.
# ---
# sc:  the active sema context
# eid: the argument expression id
# ret: true when `eid` names an imported module-level constant
fun arg_names_module_constant(sc: *context.SemaContext, eid: id.ExprId) bool {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
    ret imported_module_const_sym(sc, O.unwrap[*resolve.Symbol](opt_sym));
}

# walks `eid` reporting whether any leaf identifier resolves to a comptime value
# parameter (SYM_PARAM with SYM_FLAG_COMPTIME)
#
# such an argument is foldable only at lowering, so its constness check is
# deferred there.
# ---
# sc:  the active sema context
# eid: the argument expression id (EXPR_NIL terminates the walk)
# ret: true when any leaf resolves to a comptime value parameter
fun arg_references_comptime_param(sc: *context.SemaContext, eid: id.ExprId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val opt_expr: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](opt_expr)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](opt_expr);

    if (e.kind == expr.EXPR_KIND_IDENT) {
        val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
        if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
        val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
        ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
    }
    if (e.kind == expr.EXPR_KIND_BINARY) {
        ret arg_references_comptime_param(sc, e.data.binary.lhs)
         || arg_references_comptime_param(sc, e.data.binary.rhs);
    }
    if (e.kind == expr.EXPR_KIND_UNARY) {
        ret arg_references_comptime_param(sc, e.data.unary.operand);
    }
    ret false;
}

# the AST a call's callee is declared in
#
# the caller's own AST for a local callee, or the origin module's AST for a
# cross-module one. nil when the callee does not resolve to a declaration.
# ---
# sc:     the active sema context
# callee: the callee expression id
# ret:    the declaring AST, or nil when the callee does not resolve
fun callee_origin_ast(sc: *context.SemaContext, callee: id.ExprId) *ast.Ast {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, callee);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret nil; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.origin == sc.own_module) { ret sc.a; }
    ret session.module_ast(sc.s, sym.origin);
}

# the pointee of a single pointer level, or the type itself when not a pointer
#
# field access uses this so a record reached through a pointer is looked up in
# the record's own field table.
# ---
# sc:     the active sema context
# object: the type to peel a single pointer level from
# ret:    the pointee type, or `object` unchanged when it is not a pointer
fun deref_one(sc: *context.SemaContext, object: type.TypeId) type.TypeId {
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, object);
    if (O.is_none[*type.Type](opt_type)) { ret object; }
    val tp: *type.Type = O.unwrap[*type.Type](opt_type);
    if (tp.kind == type.TYPE_POINTER) { ret tp.data.pointer.base; }
    ret object;
}

# the target's pointer width in bytes
#
# read from the comptime context the driver seeds with the active target's
# parameters. cast/reinterpret legality is a target-dependent type rule, so the
# width must come from the target layer rather than a hardcoded constant.
# ---
# sc:  the active sema context
# ret: the active target's pointer width in bytes
fun ptr_width(sc: *context.SemaContext) u32 {
    ret sc.ctx.pointer_width;
}

# reads expr_type[eid] from the parallel array
#
# returns TYPE_ERROR for an out-of-range or nil id so callers never read past
# the array.
# ---
# sc:  the active sema context
# eid: the expression id to read the inferred type of
# ret: the inferred type, or TYPE_ERROR when the id is nil or out of range
fun expr_type_of(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL)                                 { ret type.TYPE_ERROR; }
    if (sc.expr_type == nil || eid::usize >= sc.a.expr_len) { ret type.TYPE_ERROR; }
    ret sc.expr_type[eid];
}

# the source span of an expression, falling back to `fallback` when the id is
# out of range
# ---
# sc:       the active sema context
# eid:      the expression id to read the span of
# fallback: span returned when the id does not resolve
# ret:      the expression's span, or `fallback`
fun expr_span_of(sc: *context.SemaContext, eid: id.ExprId, fallback: token.Span) token.Span {
    val opt_expr: O.Option[*expr.Expr] = ast.get_expr(sc.a, eid);
    if (O.is_none[*expr.Expr](opt_expr)) { ret fallback; }
    ret O.unwrap[*expr.Expr](opt_expr).span;
}

# records an error-severity diagnostic against the module's file
#
# The context leaf owns the sink, including the `silent` gate a re-derivation
# episode sets (#2254); check's checks route through it so one gate governs every
# sema diagnostic.
# ---
# sc:      the active sema context
# span:    source range to pin the diagnostic to
# message: the diagnostic text (copied by the sink)
fun report(sc: *context.SemaContext, span: token.Span, message: str) {
    context.report(sc, span, message);
}

# report plus a static clarifying `note:` line on the same diagnostic
# ---
# sc:      the active sema context
# span:    source range to pin the diagnostic to
# message: the diagnostic text
# note:    clarifying note attached when the error lands
fun report_note(sc: *context.SemaContext, span: token.Span, message: str, note: str) {
    context.report_note(sc, span, message, note);
}

# report a `type mismatch: expected <X>, found <Y>` diagnostic
#
# the two types are rendered via type_to_str, plus a static clarifying note. the
# assembled message and both type spellings are owned only for the duration of
# the call (the diagnostic sink copies them) and freed before returning. any
# allocation failure degrades to the static, type-free message so a mismatch is
# always reported.
# ---
# sc:       the active sema context
# span:     source range to pin the diagnostic to
# expected: the destination slot's type
# actual:   the source value's type
# note:     clarifying note attached to whichever message lands
fun report_mismatch(sc: *context.SemaContext, span: token.Span, expected: type.TypeId, actual: type.TypeId, note: str) {
    # a value-less actual (a call to a function with no return type) carries
    # TYPE_NIL, which has no spelling: rendering it would print the misleading
    # `<error>` placeholder, and the widening note does not apply. name the
    # missing value instead.
    if (actual == type.TYPE_NIL) {
        report_typed_note(sc, span, "type mismatch: expected ", expected,
            ", found no value",
            "type mismatch: a value is required, but the expression produces none",
            "a call to a function with no return type produces no value");
        ret;
    }

    val res_expected: R.Result[str, str] = type_to_str(sc, expected);
    val res_actual:   R.Result[str, str] = type_to_str(sc, actual);
    if (R.is_err[str, str](res_expected) || R.is_err[str, str](res_actual)) {
        report_note(sc, span, "type mismatch: incompatible types in assignment", note);
        if (R.is_ok[str, str](res_expected)) { type_str_free(sc, R.unwrap_ok[str, str](res_expected)); }
        if (R.is_ok[str, str](res_actual))   { type_str_free(sc, R.unwrap_ok[str, str](res_actual)); }
        ret;
    }
    val expected_str: str = R.unwrap_ok[str, str](res_expected);
    val actual_str:   str = R.unwrap_ok[str, str](res_actual);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "type mismatch: expected {}, found {}", expected_str, actual_str);
    if (R.is_err[str, str](res_msg)) {
        report_note(sc, span, "type mismatch: incompatible types in assignment", note);
        type_str_free(sc, expected_str);
        type_str_free(sc, actual_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);

    # TWO DISTINCT TYPES THAT SPELL THE SAME (#2288). A nominal is interned by
    # `(origin, decl)` and rendered by its bare name, so `rec P` in two modules
    # produces `type mismatch: expected P, found P` - a message that names the
    # defect and tells the reader nothing, which is this repo's diagnostic-surface
    # failure exactly. The types are different and the diagnostic could not show it.
    #
    # The ambiguity is a property of the PAIR, not of either type, which is why the
    # fix is here and not in the renderer: qualifying every nominal everywhere would
    # make every ordinary diagnostic noisier to fix a case that is rare. When the two
    # spellings collide, the note names each side's defining module instead of the
    # cast advice, which cannot apply between two unrelated records anyway.
    report_types_pair(sc, span, msg, expected, actual, expected_str, actual_str, note);

    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, expected_str);
    type_str_free(sc, actual_str);
}

# report an assembled message that names TWO types, disambiguating them when their
# two renderings are the same string (#2288)
#
# THE ONE DECISION POINT for the whole two-type diagnostic family, so a message
# added later inherits the disambiguation instead of collapsing the way the first
# one did. A nominal is interned by `(origin, decl)` and rendered by its bare name,
# so `rec P` declared in two modules produces `type mismatch: expected P, found P` -
# a diagnostic that reports the defect and cannot represent it.
#
# The ambiguity is a property of the PAIR, not of either type, which is why this is
# not a change to the renderer: qualifying every nominal at every site would make
# every ordinary diagnostic noisier to fix a case that is rare.
#
# Degrades to `note` (or to a bare report when `note` is empty) when either side has
# no module to name - a primitive, a generic parameter, a function type, or a nominal
# whose origin did not resolve - so a pair that collided for some other reason still
# reports with its ordinary advice rather than with a half-written sentence.
# ---
# sc:    the active sema context
# span:  source range to pin the diagnostic to
# msg:   the assembled message, already carrying both rendered types
# a:     the first type named in `msg`
# b:     the second type named in `msg`
# a_str: `a` as rendered into `msg`
# b_str: `b` as rendered into `msg`
# note:  the note to attach when the pair is not ambiguous; "" for no note
fun report_types_pair(sc: *context.SemaContext, span: token.Span, msg: str,
                      a: type.TypeId, b: type.TypeId, a_str: str, b_str: str, note: str) {
    if (a == b || !str_equals(a_str, b_str)) {
        report_pair_plain(sc, span, msg, note);
        ret;
    }

    val am: intern.StrId = declaring_module_fqn(sc, a);
    val bm: intern.StrId = declaring_module_fqn(sc, b);
    if (am == intern.STR_NIL || bm == intern.STR_NIL) {
        report_pair_plain(sc, span, msg, note);
        ret;
    }
    val ao: O.Option[str] = intern.lookup(?sc.s.interner, am);
    val bo: O.Option[str] = intern.lookup(?sc.s.interner, bm);
    if (O.is_none[str](ao) || O.is_none[str](bo)) {
        report_pair_plain(sc, span, msg, note);
        ret;
    }

    val res_n: R.Result[str, str] = format.sprint(sc.s.alloc,
        "these are two different types that share the name `{}`: the first is declared in `{}`, the second in `{}`",
        a_str, O.unwrap[str](ao), O.unwrap[str](bo));
    if (R.is_err[str, str](res_n)) {
        report_pair_plain(sc, span, msg, note);
        ret;
    }
    val n: str = R.unwrap_ok[str, str](res_n);
    report_note(sc, span, msg, n);
    A.deallocate[char](sc.s.alloc, n, str_len(n) + 1);
}

# report `msg`, attaching `note` only when there is one
# ---
# sc:   the active sema context
# span: source range to pin the diagnostic to
# msg:  the assembled message
# note: the note to attach, or "" for none
fun report_pair_plain(sc: *context.SemaContext, span: token.Span, msg: str, note: str) {
    if (str_len(note) == 0) {
        report(sc, span, msg);
        ret;
    }
    report_note(sc, span, msg, note);
}

# the FQN of the module that declares `t`'s nominal, or STR_NIL when it has none
#
# A generic instance is answered by the declaration it instantiates, so
# `lib.Box[i32]` and `main.Box[i32]` - which also render identically - name their
# own modules. Every other kind has no declaring module and answers STR_NIL.
# ---
# sc: the active sema context
# t:  the type to locate
# ret: the interned module FQN, or STR_NIL
fun declaring_module_fqn(sc: *context.SemaContext, t: type.TypeId) intern.StrId {
    val opt: O.Option[*type.Type] = type.get(?sc.s.types, t);
    if (O.is_none[*type.Type](opt)) { ret intern.STR_NIL; }
    val ty: *type.Type = O.unwrap[*type.Type](opt);
    if (ty.kind == type.TYPE_REC || ty.kind == type.TYPE_UNI) {
        ret session.module_fqn(sc.s, ty.data.nominal.origin);
    }
    if (ty.kind == type.TYPE_INSTANCE) {
        ret session.module_fqn(sc.s, ty.data.instance.target_origin);
    }
    ret intern.STR_NIL;
}

# report a `literal <v> is out of range for <T> (<min>..<max>)` diagnostic
#
# consumes an OUT_OF_RANGE coerce result: renders the offending literal's value
# (its magnitude, signed by `negated`), the destination integer type via
# type_to_str, and the type's inclusive bounds carried on the result, all as
# decimals. names the overflow directly and, unlike report_mismatch, carries no
# cast note - a truncating cast is the corrupting advice this diagnostic exists to
# avoid. any render or allocation failure degrades to a static, value-free message
# so the error is always reported.
# ---
# sc:   the active sema context
# span: source range to pin the diagnostic to
# cr:   the OUT_OF_RANGE result (destination type, literal magnitude, sign, bounds)
fun report_out_of_range(sc: *context.SemaContext, span: token.Span, cr: coerce.CoerceResult) {
    val res_type: R.Result[str, str] = type_to_str(sc, cr.ty);
    if (R.is_err[str, str](res_type)) {
        report(sc, span, "integer value out of range for its type");
        ret;
    }
    val type_str: str            = R.unwrap_ok[str, str](res_type);
    val bounds:   coerce.IntBounds = cr.bounds;

    # conditional signs render as empty/"-" str holes to keep the magnitudes
    # unsigned (i64::MIN's magnitude does not fit a signed hole).
    var sign:     str = "";
    var min_sign: str = "";
    if (cr.negated)         { sign = "-"; }
    if (bounds.min_negated) { min_sign = "-"; }

    var noun: str = "value";
    if (cr.literal) { noun = "literal"; }
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{} {}{} is out of range for {} ({}{}..{})",
        noun, sign, cr.value::usize, type_str, min_sign, bounds.min_mag::usize, bounds.max_mag::usize);
    if (R.is_err[str, str](res_msg)) {
        report(sc, span, "integer value out of range for its type");
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

# report_typed plus a static clarifying `note:` line
#
# on any allocation failure it degrades to the static `fallback` message, still
# carrying the note so the explanation is never lost.
# ---
# sc:       the active sema context
# span:     source range to pin the diagnostic to
# prefix:   text before the rendered type
# t:        the type to render into the message
# suffix:   text after the rendered type
# fallback: type-free message used when rendering or allocation fails
# note:     clarifying note attached to whichever message lands
fun report_typed_note(sc: *context.SemaContext, span: token.Span, prefix: str, t: type.TypeId, suffix: str, fallback: str, note: str) {
    val res_type: R.Result[str, str] = type_to_str(sc, t);
    if (R.is_err[str, str](res_type)) {
        report_note(sc, span, fallback, note);
        ret;
    }
    val type_str: str = R.unwrap_ok[str, str](res_type);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}", prefix, type_str, suffix);
    if (R.is_err[str, str](res_msg)) {
        report_note(sc, span, fallback, note);
        type_str_free(sc, type_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report_note(sc, span, msg, note);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, type_str);
}

# report an `arity mismatch: expected <E>, found <A>` diagnostic
#
# both counts render as decimals. `at_least` distinguishes a pack-tailed callee
# (`expected at least <E>`) from a fixed one (`expected <E>`). any allocation
# failure degrades to a static, count-free message so the error is always
# reported.
# ---
# sc:       the active sema context
# span:     source range to pin the diagnostic to
# expected: the expected argument count
# actual:   the supplied argument count
# at_least: whether `expected` is a lower bound (a pack-tailed callee)
fun report_arity(sc: *context.SemaContext, span: token.Span, expected: u32, actual: u32, at_least: bool) {
    # the optional "at least " lower-bound marker renders as an empty/present str hole.
    var atleast: str = "";
    if (at_least) { atleast = "at least "; }

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "arity mismatch: expected {}{}, found {}",
        atleast, expected::usize, actual::usize);
    if (R.is_err[str, str](res_msg)) {
        report(sc, span, "arity mismatch: wrong number of call arguments");
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

# report a `bit reinterpret requires equal-size types: <X> (<n> bytes) vs <Y>
# (<m> bytes)` diagnostic
#
# renders each type via type_to_str and its byte size as a decimal. the
# assembled message and type spellings are owned only for the call; any
# allocation failure degrades to a static, size-free message so the error is
# always reported.
# ---
# sc:        the active sema context
# span:      source range to pin the diagnostic to
# from:      the operand's type
# size_from: the operand's byte size
# to:        the target type
# size_to:   the target type's byte size
fun report_reinterpret_mismatch(sc: *context.SemaContext, span: token.Span, from: type.TypeId, size_from: u32, to: type.TypeId, size_to: u32) {
    val res_from: R.Result[str, str] = type_to_str(sc, from);
    val res_to:   R.Result[str, str] = type_to_str(sc, to);
    if (R.is_err[str, str](res_from) || R.is_err[str, str](res_to)) {
        report_note(sc, span, "bit reinterpret requires equal-size types",
            "`:~` reinterprets bits between types of identical, known byte size");
        if (R.is_ok[str, str](res_from)) { type_str_free(sc, R.unwrap_ok[str, str](res_from)); }
        if (R.is_ok[str, str](res_to))   { type_str_free(sc, R.unwrap_ok[str, str](res_to)); }
        ret;
    }
    val from_str: str = R.unwrap_ok[str, str](res_from);
    val to_str:   str = R.unwrap_ok[str, str](res_to);

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "bit reinterpret requires equal-size types: {} ({} bytes) vs {} ({} bytes)",
        from_str, size_from::usize, to_str, size_to::usize);
    if (R.is_err[str, str](res_msg)) {
        report_note(sc, span, "bit reinterpret requires equal-size types",
            "`:~` reinterprets bits between types of identical, known byte size");
        type_str_free(sc, from_str);
        type_str_free(sc, to_str);
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report_types_pair(sc, span, msg, from, to, from_str, to_str, "");

    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
    type_str_free(sc, from_str);
    type_str_free(sc, to_str);
}


# report a refused generic instantiation, naming the derivation chain that
# reached it (#2163)
#
# The recorder refuses an instantiation on one of two limits and says which; the
# chain is assembled here, where the type renderer is reachable and the call's
# span is in hand. The chain is the actionable half - the limit alone says only
# that something diverged, while `f[u32]` recording `f[*u32]` recording
# `f[**u32]` is a fix the author can see. Only the last CHAIN_LINKS links are
# spelled, with a count of those elided: the growth is visible in the tail, and a
# whole chain at the depth limit runs to thousands of characters (its last
# argument alone carries one qualifier per link). The refused instantiation is
# always the final link, and any allocation failure degrades to the bare limit,
# so the break is always reported.
# ---
# sc:      the active sema context (its worklist holds the chain)
# span:    source range of the instantiating call
# outcome: the RECORD_LIMIT_* code the recorder returned
# bare:    source name of the generic the refused instance specializes
# args:    the refused instance's concrete type arguments
# arg_len: number of type arguments
pub fun report_instantiation_limit(sc: *context.SemaContext, span: token.Span, outcome: u8,
                                   bare: intern.StrId, args: *type.TypeId, arg_len: u32) {
    var headline: str = "generic instantiation limit exceeded: one module reached the cap on distinct instances";
    if (outcome == context.RECORD_LIMIT_DEPTH) {
        headline = "generic instantiation depth limit exceeded: a generic instantiates itself at a growing type argument";
    }
    report(sc, span, instantiation_chain(sc, headline, bare, args, arg_len));
}

# the refused instantiation's message: the limit, then the chain that reached it
# ---
# sc:       the active sema context (its worklist holds the chain)
# headline: the limit that was reached
# bare:     source name of the generic the refused instance specializes
# args:     the refused instance's concrete type arguments
# arg_len:  number of type arguments
# ret:      the message, interned so it outlives this pass's scratch
fun instantiation_chain(sc: *context.SemaContext, headline: str, bare: intern.StrId,
                        args: *type.TypeId, arg_len: u32) str {
    val wl: *context.InstWorklist = sc.insts;
    if (wl == nil) { ret headline; }

    # the ancestors nearest the refusal, nearest first, and how many there are in
    # total; a chain longer than the window is reported with the elided count.
    var shown: [CHAIN_LINKS]u32;
    var count: u32 = 0;
    var total: u32 = 0;
    var walk:  u32 = sc.inst_parent;
    for (walk != context.INST_NONE && walk < wl.len) {
        if (count < CHAIN_LINKS) {
            shown[count] = walk;
            count = count + 1;
        }
        total = total + 1;
        walk = wl.items[walk].parent;
    }

    val head_r: R.Result[str, str] = format.sprint(sc.s.alloc, "{}; chain: ", headline);
    if (R.is_err[str, str](head_r)) { ret headline; }
    var msg: str = R.unwrap_ok[str, str](head_r);

    if (total > count) {
        val elided: R.Result[str, str] = format.sprint(sc.s.alloc, "... ({} more) -> ", (total - count)::usize);
        if (R.is_err[str, str](elided)) { typename.type_str_free(sc.s, msg); ret headline; }
        msg = typename.text_join(sc.s, msg, R.unwrap_ok[str, str](elided), true);
    }

    var i: u32 = count;
    for (i > 0) {
        i = i - 1;
        val e: *context.InstReq = ?wl.items[shown[i]];
        msg = chain_link(sc, msg, e.bare, e.args, e.arg_len);
        msg = typename.text_join(sc.s, msg, " -> ", false);
    }
    msg = chain_link(sc, msg, bare, args, arg_len);

    ret typename.text_stable(sc.s, msg, headline);
}

# append one `Name[Arg, ...]` link to a chain message
# ---
# sc:      the active sema context
# msg:     the owned accumulator (nil propagates)
# bare:    the link's declared name
# args:    the link's concrete type arguments
# arg_len: number of type arguments
# ret:     the extended message, or nil on an allocation failure
fun chain_link(sc: *context.SemaContext, msg: str, bare: intern.StrId,
               args: *type.TypeId, arg_len: u32) str {
    val link: R.Result[str, str] = typename.instance_spelling(sc.s, bare, args, arg_len);
    if (R.is_err[str, str](link)) {
        typename.type_str_free(sc.s, msg);
        ret nil;
    }
    ret typename.text_join(sc.s, msg, R.unwrap_ok[str, str](link), true);
}
