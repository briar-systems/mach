use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.type;

pub rec CaseSet {
    words:      *u64;
    word_count: u32;
}

pub fun caseset_alloc(alloc: *A.Allocator, word_count: u32) R.Result[CaseSet, str] {
    var count: u32 = word_count;
    if (count == 0) { count = 1; }
    val res: R.Result[*u64, str] = A.allocate[u64](alloc, count::usize);
    if (R.is_err[*u64, str](res)) { ret R.err[CaseSet, str](R.unwrap_err[*u64, str](res)); }
    val words: *u64 = R.unwrap_ok[*u64, str](res);
    var i: u32 = 0;
    for (i < count) {
        words[i] = 0u64;
        i = i + 1;
    }
    ret R.ok[CaseSet, str](CaseSet{ words: words, word_count: count });
}

pub fun caseset_free(alloc: *A.Allocator, cs: *CaseSet) {
    if (cs.words != nil && cs.word_count > 0) {
        A.deallocate[u64](alloc, cs.words, cs.word_count::usize);
        cs.words = nil;
        cs.word_count = 0;
    }
}

pub fun caseset_clone(alloc: *A.Allocator, src: CaseSet) R.Result[CaseSet, str] {
    val res: R.Result[CaseSet, str] = caseset_alloc(alloc, src.word_count);
    if (R.is_err[CaseSet, str](res)) { ret res; }
    var dst: CaseSet = R.unwrap_ok[CaseSet, str](res);
    var i: u32 = 0;
    for (i < src.word_count) {
        dst.words[i] = src.words[i];
        i = i + 1;
    }
    ret R.ok[CaseSet, str](dst);
}

pub fun caseset_set_all(cs: *CaseSet, total_cases: u32) {
    caseset_clear(cs);
    var i: u32 = 0;
    for (i < total_cases) {
        val word_idx: u32 = i / 64;
        val bit_idx:  u32 = i % 64;
        if (word_idx < cs.word_count) {
            cs.words[word_idx] = cs.words[word_idx] | (1u64 << bit_idx);
        }
        i = i + 1;
    }
}

pub fun caseset_clear(cs: *CaseSet) {
    var i: u32 = 0;
    for (i < cs.word_count) {
        cs.words[i] = 0u64;
        i = i + 1;
    }
}

pub fun caseset_set_single(cs: *CaseSet, case_idx: u32) {
    caseset_clear(cs);
    val word_idx: u32 = case_idx / 64;
    val bit_idx:  u32 = case_idx % 64;
    if (word_idx < cs.word_count) {
        cs.words[word_idx] = 1u64 << bit_idx;
    }
}

pub fun caseset_remove(cs: *CaseSet, case_idx: u32) {
    val word_idx: u32 = case_idx / 64;
    val bit_idx:  u32 = case_idx % 64;
    if (word_idx < cs.word_count) {
        cs.words[word_idx] = cs.words[word_idx] & ~(1u64 << bit_idx);
    }
}

pub fun caseset_has(cs: CaseSet, case_idx: u32) bool {
    val word_idx: u32 = case_idx / 64;
    val bit_idx:  u32 = case_idx % 64;
    if (word_idx >= cs.word_count) { ret false; }
    ret (cs.words[word_idx] & (1u64 << bit_idx)) != 0u64;
}

pub fun caseset_is_single(cs: CaseSet, case_idx: u32) bool {
    val target_word: u32 = case_idx / 64;
    val target_mask: u64 = 1u64 << (case_idx % 64);
    var i: u32 = 0;
    for (i < cs.word_count) {
        if (i == target_word) {
            if (cs.words[i] != target_mask) { ret false; }
        } or {
            if (cs.words[i] != 0u64) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

pub fun caseset_union(dst: *CaseSet, src: CaseSet) {
    var i: u32 = 0;
    val limit: u32 = dst.word_count;
    for (i < limit && i < src.word_count) {
        dst.words[i] = dst.words[i] | src.words[i];
        i = i + 1;
    }
}

pub fun caseset_intersect(dst: *CaseSet, src: CaseSet) {
    var i: u32 = 0;
    val limit: u32 = dst.word_count;
    for (i < limit && i < src.word_count) {
        dst.words[i] = dst.words[i] & src.words[i];
        i = i + 1;
    }
}

pub fun caseset_equals(a: CaseSet, b: CaseSet) bool {
    if (a.word_count != b.word_count) { ret false; }
    var i: u32 = 0;
    for (i < a.word_count) {
        if (a.words[i] != b.words[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun caseset_count(cs: CaseSet) u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    for (i < cs.word_count) {
        var w: u64 = cs.words[i];
        for (w != 0u64) {
            count = count + (w & 1u64)::u32;
            w = w >> 1;
        }
        i = i + 1;
    }
    ret count;
}

pub fun caseset_first_active(cs: CaseSet) O.Option[u32] {
    var i: u32 = 0;
    for (i < cs.word_count) {
        val w: u64 = cs.words[i];
        if (w != 0u64) {
            var b: u32 = 0;
            for (b < 64) {
                if ((w & (1u64 << b)) != 0u64) {
                    ret O.some[u32](i * 64 + b);
                }
                b = b + 1;
            }
        }
        i = i + 1;
    }
    ret O.none[u32]();
}

pub val ROOT_NONE:        u8 = 0;
pub val ROOT_LOCAL:       u8 = 1;
pub val ROOT_POINTEE:     u8 = 2;
pub val ROOT_ANY_POINTEE: u8 = 3;

pub rec StorageKey {
    root_kind:       u8;
    root_sym:        resolve.SymbolId;
    projections:     *intern.StrId;
    projections_len: u32;
    projections_cap: u32;
}

pub fun key_none() StorageKey {
    ret StorageKey{
        root_kind:       ROOT_NONE,
        root_sym:        resolve.SYMBOL_NIL,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_local(sym: resolve.SymbolId) StorageKey {
    ret StorageKey{
        root_kind:       ROOT_LOCAL,
        root_sym:        sym,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_pointee(sym: resolve.SymbolId) StorageKey {
    ret StorageKey{
        root_kind:       ROOT_POINTEE,
        root_sym:        sym,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_any_pointee() StorageKey {
    ret StorageKey{
        root_kind:       ROOT_ANY_POINTEE,
        root_sym:        resolve.SYMBOL_NIL,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_free(alloc: *A.Allocator, k: *StorageKey) {
    if (k.projections != nil && k.projections_cap > 0) {
        A.deallocate[intern.StrId](alloc, k.projections, k.projections_cap::usize);
        k.projections = nil;
        k.projections_len = 0;
        k.projections_cap = 0;
    }
}

pub fun key_clone(alloc: *A.Allocator, src: StorageKey) R.Result[StorageKey, str] {
    var k: StorageKey = src;
    if (src.projections != nil && src.projections_len > 0) {
        val res: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, src.projections_len::usize);
        if (R.is_err[*intern.StrId, str](res)) { ret R.err[StorageKey, str](R.unwrap_err[*intern.StrId, str](res)); }
        k.projections = R.unwrap_ok[*intern.StrId, str](res);
        k.projections_cap = src.projections_len;
        var i: u32 = 0;
        for (i < src.projections_len) {
            k.projections[i] = src.projections[i];
            i = i + 1;
        }
    } or {
        k.projections = nil;
        k.projections_len = 0;
        k.projections_cap = 0;
    }
    ret R.ok[StorageKey, str](k);
}

pub fun key_add_projection(alloc: *A.Allocator, k: *StorageKey, field: intern.StrId) R.Result[R.Void, str] {
    if (k.projections == nil) {
        val initial_cap: usize = 4;
        val res: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, initial_cap);
        if (R.is_err[*intern.StrId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](res)); }
        k.projections = R.unwrap_ok[*intern.StrId, str](res);
        k.projections_cap = initial_cap::u32;
        k.projections_len = 0;
    }
    if (k.projections_len >= k.projections_cap) {
        val new_cap: usize = (k.projections_cap * 2)::usize;
        val res: R.Result[*intern.StrId, str] = A.reallocate[intern.StrId](alloc, k.projections, k.projections_cap::usize, new_cap);
        if (R.is_err[*intern.StrId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](res)); }
        k.projections = R.unwrap_ok[*intern.StrId, str](res);
        k.projections_cap = new_cap::u32;
    }
    k.projections[k.projections_len] = field;
    k.projections_len = k.projections_len + 1;
    ret R.ok_void[str]();
}

pub fun key_equals(a: StorageKey, b: StorageKey) bool {
    if (a.root_kind != b.root_kind) { ret false; }
    if (a.root_sym != b.root_sym)   { ret false; }
    if (a.projections_len != b.projections_len) { ret false; }
    var i: u32 = 0;
    for (i < a.projections_len) {
        if (a.projections[i] != b.projections[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun key_is_prefix_of(prefix: StorageKey, candidate: StorageKey) bool {
    if (prefix.root_kind != candidate.root_kind) { ret false; }
    if (prefix.root_sym != candidate.root_sym)   { ret false; }
    if (prefix.projections_len > candidate.projections_len) { ret false; }
    var i: u32 = 0;
    for (i < prefix.projections_len) {
        if (prefix.projections[i] != candidate.projections[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub rec EscapeSet {
    syms: *resolve.SymbolId;
    len:  u32;
    cap:  u32;
}

pub fun escape_init() EscapeSet {
    ret EscapeSet{ syms: nil, len: 0, cap: 0 };
}

pub fun escape_free(alloc: *A.Allocator, es: *EscapeSet) {
    if (es.syms != nil && es.cap > 0) {
        A.deallocate[resolve.SymbolId](alloc, es.syms, es.cap::usize);
        es.syms = nil;
        es.len = 0;
        es.cap = 0;
    }
}

pub fun escape_clone(alloc: *A.Allocator, src: EscapeSet) R.Result[EscapeSet, str] {
    if (src.len == 0 || src.syms == nil) { ret R.ok[EscapeSet, str](escape_init()); }
    val res: R.Result[*resolve.SymbolId, str] = A.allocate[resolve.SymbolId](alloc, src.len::usize);
    if (R.is_err[*resolve.SymbolId, str](res)) { ret R.err[EscapeSet, str](R.unwrap_err[*resolve.SymbolId, str](res)); }
    val syms: *resolve.SymbolId = R.unwrap_ok[*resolve.SymbolId, str](res);
    var i: u32 = 0;
    for (i < src.len) {
        syms[i] = src.syms[i];
        i = i + 1;
    }
    ret R.ok[EscapeSet, str](EscapeSet{ syms: syms, len: src.len, cap: src.len });
}

pub fun escape_contains(es: EscapeSet, sym: resolve.SymbolId) bool {
    var i: u32 = 0;
    for (i < es.len) {
        if (es.syms[i] == sym) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun escape_add(alloc: *A.Allocator, es: *EscapeSet, sym: resolve.SymbolId) R.Result[R.Void, str] {
    if (sym == resolve.SYMBOL_NIL) { ret R.ok_void[str](); }
    if (escape_contains(@es, sym)) { ret R.ok_void[str](); }
    if (es.syms == nil) {
        val initial_cap: usize = 8;
        val res: R.Result[*resolve.SymbolId, str] = A.allocate[resolve.SymbolId](alloc, initial_cap);
        if (R.is_err[*resolve.SymbolId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*resolve.SymbolId, str](res)); }
        es.syms = R.unwrap_ok[*resolve.SymbolId, str](res);
        es.cap = initial_cap::u32;
        es.len = 0;
    }
    if (es.len >= es.cap) {
        val new_cap: usize = (es.cap * 2)::usize;
        val res: R.Result[*resolve.SymbolId, str] = A.reallocate[resolve.SymbolId](alloc, es.syms, es.cap::usize, new_cap);
        if (R.is_err[*resolve.SymbolId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*resolve.SymbolId, str](res)); }
        es.syms = R.unwrap_ok[*resolve.SymbolId, str](res);
        es.cap = new_cap::u32;
    }
    es.syms[es.len] = sym;
    es.len = es.len + 1;
    ret R.ok_void[str]();
}

pub fun escape_union(alloc: *A.Allocator, dst: *EscapeSet, src: EscapeSet) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < src.len) {
        val res: R.Result[R.Void, str] = escape_add(alloc, dst, src.syms[i]);
        if (R.is_err[R.Void, str](res)) { ret res; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun escape_equals(a: EscapeSet, b: EscapeSet) bool {
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < a.len) {
        if (!escape_contains(b, a.syms[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub rec StorageFact {
    key:            StorageKey;
    tag_type:       type.TypeId;
    total_cases:    u32;
    possible_cases: CaseSet;
}

pub fun fact_free(alloc: *A.Allocator, f: *StorageFact) {
    key_free(alloc, ?f.key);
    caseset_free(alloc, ?f.possible_cases);
}

pub fun fact_clone(alloc: *A.Allocator, src: StorageFact) R.Result[StorageFact, str] {
    val rk: R.Result[StorageKey, str] = key_clone(alloc, src.key);
    if (R.is_err[StorageKey, str](rk)) { ret R.err[StorageFact, str](R.unwrap_err[StorageKey, str](rk)); }
    val rc: R.Result[CaseSet, str] = caseset_clone(alloc, src.possible_cases);
    if (R.is_err[CaseSet, str](rc)) {
        var k_tmp: StorageKey = R.unwrap_ok[StorageKey, str](rk);
        key_free(alloc, ?k_tmp);
        ret R.err[StorageFact, str](R.unwrap_err[CaseSet, str](rc));
    }
    ret R.ok[StorageFact, str](StorageFact{
        key:            R.unwrap_ok[StorageKey, str](rk),
        tag_type:       src.tag_type,
        total_cases:    src.total_cases,
        possible_cases: R.unwrap_ok[CaseSet, str](rc),
    });
}

pub rec ProofEnv {
    facts:     *StorageFact;
    facts_len: u32;
    facts_cap: u32;
    escapes:   EscapeSet;
    reachable: bool;
    alloc:     *A.Allocator;
}

pub fun env_init(alloc: *A.Allocator) ProofEnv {
    ret ProofEnv{
        facts:     nil,
        facts_len: 0,
        facts_cap: 0,
        escapes:   escape_init(),
        reachable: true,
        alloc:     alloc,
    };
}

pub fun env_unreachable(alloc: *A.Allocator) ProofEnv {
    var e: ProofEnv = env_init(alloc);
    e.reachable = false;
    ret e;
}

pub fun env_free(e: *ProofEnv) {
    if (e.facts != nil) {
        var i: u32 = 0;
        for (i < e.facts_len) {
            fact_free(e.alloc, ?e.facts[i]);
            i = i + 1;
        }
        if (e.facts_cap > 0) {
            A.deallocate[StorageFact](e.alloc, e.facts, e.facts_cap::usize);
        }
        e.facts = nil;
        e.facts_len = 0;
        e.facts_cap = 0;
    }
    escape_free(e.alloc, ?e.escapes);
}

pub fun env_clone(alloc: *A.Allocator, src: *ProofEnv) R.Result[ProofEnv, str] {
    var out: ProofEnv = env_init(alloc);
    out.reachable = src.reachable;
    val res_esc: R.Result[EscapeSet, str] = escape_clone(alloc, src.escapes);
    if (R.is_err[EscapeSet, str](res_esc)) { ret R.err[ProofEnv, str](R.unwrap_err[EscapeSet, str](res_esc)); }
    out.escapes = R.unwrap_ok[EscapeSet, str](res_esc);

    if (src.facts_len > 0) {
        val res_f: R.Result[*StorageFact, str] = A.allocate[StorageFact](alloc, src.facts_len::usize);
        if (R.is_err[*StorageFact, str](res_f)) {
            env_free(?out);
            ret R.err[ProofEnv, str](R.unwrap_err[*StorageFact, str](res_f));
        }
        out.facts = R.unwrap_ok[*StorageFact, str](res_f);
        out.facts_cap = src.facts_len;
        var i: u32 = 0;
        for (i < src.facts_len) {
            val res_clone: R.Result[StorageFact, str] = fact_clone(alloc, src.facts[i]);
            if (R.is_err[StorageFact, str](res_clone)) {
                out.facts_len = i;
                env_free(?out);
                ret R.err[ProofEnv, str](R.unwrap_err[StorageFact, str](res_clone));
            }
            out.facts[i] = R.unwrap_ok[StorageFact, str](res_clone);
            out.facts_len = i + 1;
            i = i + 1;
        }
    }
    ret R.ok[ProofEnv, str](out);
}

pub fun env_find_fact(e: *ProofEnv, key: StorageKey) O.Option[u32] {
    var i: u32 = 0;
    for (i < e.facts_len) {
        if (key_equals(e.facts[i].key, key)) {
            ret O.some[u32](i);
        }
        i = i + 1;
    }
    ret O.none[u32]();
}

pub fun env_remove_fact_at(e: *ProofEnv, idx: u32) {
    if (idx >= e.facts_len) { ret; }
    fact_free(e.alloc, ?e.facts[idx]);
    var i: u32 = idx;
    for (i + 1 < e.facts_len) {
        e.facts[i] = e.facts[i + 1];
        i = i + 1;
    }
    e.facts_len = e.facts_len - 1;
}

pub fun env_remove_prefix(e: *ProofEnv, prefix: StorageKey) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        if (key_is_prefix_of(prefix, e.facts[i].key)) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_remove_pointee_sym(e: *ProofEnv, ptr_sym: resolve.SymbolId) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        val k: StorageKey = e.facts[i].key;
        if (k.root_kind == ROOT_POINTEE && k.root_sym == ptr_sym) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_remove_all_pointees(e: *ProofEnv) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        val k: StorageKey = e.facts[i].key;
        if (k.root_kind == ROOT_POINTEE || k.root_kind == ROOT_ANY_POINTEE) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_remove_escaped_locals(e: *ProofEnv) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        val k: StorageKey = e.facts[i].key;
        if (k.root_kind == ROOT_LOCAL && escape_contains(e.escapes, k.root_sym)) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_invalidate_calls(e: *ProofEnv) {
    env_remove_all_pointees(e);
    env_remove_escaped_locals(e);
}

pub fun env_set_fact_caseset(e: *ProofEnv, key: StorageKey, tag_type: type.TypeId, total_cases: u32, cs: CaseSet) R.Result[R.Void, str] {
    if (key.root_kind == ROOT_NONE) {
        var cs_tmp: CaseSet = cs;
        caseset_free(e.alloc, ?cs_tmp);
        ret R.ok_void[str]();
    }
    val opt_idx: O.Option[u32] = env_find_fact(e, key);
    if (O.is_some[u32](opt_idx)) {
        val idx: u32 = O.unwrap[u32](opt_idx);
        e.facts[idx].tag_type = tag_type;
        e.facts[idx].total_cases = total_cases;
        caseset_free(e.alloc, ?e.facts[idx].possible_cases);
        e.facts[idx].possible_cases = cs;
        ret R.ok_void[str]();
    }

    val res_key: R.Result[StorageKey, str] = key_clone(e.alloc, key);
    if (R.is_err[StorageKey, str](res_key)) {
        var cs_tmp: CaseSet = cs;
        caseset_free(e.alloc, ?cs_tmp);
        ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](res_key));
    }
    val owned_key: StorageKey = R.unwrap_ok[StorageKey, str](res_key);

    if (e.facts == nil) {
        val initial_cap: usize = 16;
        val res_arr: R.Result[*StorageFact, str] = A.allocate[StorageFact](e.alloc, initial_cap);
        if (R.is_err[*StorageFact, str](res_arr)) {
            var k_tmp: StorageKey = owned_key;
            key_free(e.alloc, ?k_tmp);
            var cs_tmp: CaseSet = cs;
            caseset_free(e.alloc, ?cs_tmp);
            ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
        }
        e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
        e.facts_cap = initial_cap::u32;
        e.facts_len = 0;
    }
    if (e.facts_len >= e.facts_cap) {
        val new_cap: usize = (e.facts_cap * 2)::usize;
        val res_arr: R.Result[*StorageFact, str] = A.reallocate[StorageFact](e.alloc, e.facts, e.facts_cap::usize, new_cap);
        if (R.is_err[*StorageFact, str](res_arr)) {
            var k_tmp: StorageKey = owned_key;
            key_free(e.alloc, ?k_tmp);
            var cs_tmp: CaseSet = cs;
            caseset_free(e.alloc, ?cs_tmp);
            ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
        }
        e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
        e.facts_cap = new_cap::u32;
    }
    e.facts[e.facts_len] = StorageFact{
        key:            owned_key,
        tag_type:       tag_type,
        total_cases:    total_cases,
        possible_cases: cs,
    };
    e.facts_len = e.facts_len + 1;
    ret R.ok_void[str]();
}

pub fun env_set_fact_case(e: *ProofEnv, key: StorageKey, tag_type: type.TypeId, total_cases: u32, case_idx: u32) R.Result[R.Void, str] {
    if (key.root_kind == ROOT_NONE) { ret R.ok_void[str](); }
    val words_needed: u32 = (total_cases + 63) / 64;
    val res_cs: R.Result[CaseSet, str] = caseset_alloc(e.alloc, words_needed);
    if (R.is_err[CaseSet, str](res_cs)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](res_cs)); }
    var cs: CaseSet = R.unwrap_ok[CaseSet, str](res_cs);
    caseset_set_single(?cs, case_idx);
    ret env_set_fact_caseset(e, key, tag_type, total_cases, cs);
}

pub fun env_remove_case(e: *ProofEnv, key: StorageKey, tag_type: type.TypeId, total_cases: u32, case_idx: u32) R.Result[R.Void, str] {
    if (key.root_kind == ROOT_NONE) { ret R.ok_void[str](); }
    val opt_f: O.Option[u32] = env_find_fact(e, key);
    if (O.is_some[u32](opt_f)) {
        val f_idx: u32 = O.unwrap[u32](opt_f);
        caseset_remove(?e.facts[f_idx].possible_cases, case_idx);
        ret R.ok_void[str]();
    }
    val words_needed: u32 = (total_cases + 63) / 64;
    val res_cs: R.Result[CaseSet, str] = caseset_alloc(e.alloc, words_needed);
    if (R.is_err[CaseSet, str](res_cs)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](res_cs)); }
    var cs: CaseSet = R.unwrap_ok[CaseSet, str](res_cs);
    caseset_set_all(?cs, total_cases);
    caseset_remove(?cs, case_idx);

    val res_key: R.Result[StorageKey, str] = key_clone(e.alloc, key);
    if (R.is_err[StorageKey, str](res_key)) {
        caseset_free(e.alloc, ?cs);
        ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](res_key));
    }
    val owned_key: StorageKey = R.unwrap_ok[StorageKey, str](res_key);

    if (e.facts == nil) {
        val initial_cap: usize = 16;
        val res_arr: R.Result[*StorageFact, str] = A.allocate[StorageFact](e.alloc, initial_cap);
        if (R.is_err[*StorageFact, str](res_arr)) {
            var k_tmp: StorageKey = owned_key;
            key_free(e.alloc, ?k_tmp);
            caseset_free(e.alloc, ?cs);
            ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
        }
        e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
        e.facts_cap = initial_cap::u32;
        e.facts_len = 0;
    }
    if (e.facts_len >= e.facts_cap) {
        val new_cap: usize = (e.facts_cap * 2)::usize;
        val res_arr: R.Result[*StorageFact, str] = A.reallocate[StorageFact](e.alloc, e.facts, e.facts_cap::usize, new_cap);
        if (R.is_err[*StorageFact, str](res_arr)) {
            var k_tmp: StorageKey = owned_key;
            key_free(e.alloc, ?k_tmp);
            caseset_free(e.alloc, ?cs);
            ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
        }
        e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
        e.facts_cap = new_cap::u32;
    }
    e.facts[e.facts_len] = StorageFact{
        key:            owned_key,
        tag_type:       tag_type,
        total_cases:    total_cases,
        possible_cases: cs,
    };
    e.facts_len = e.facts_len + 1;
    ret R.ok_void[str]();
}

pub fun env_transfer_fact(e: *ProofEnv, dst: StorageKey, src: StorageKey, tag_type: type.TypeId, total_cases: u32) R.Result[R.Void, str] {
    if (dst.root_kind == ROOT_NONE) { ret R.ok_void[str](); }
    if (src.root_kind != ROOT_NONE) {
        val opt_src_idx: O.Option[u32] = env_find_fact(e, src);
        if (O.is_some[u32](opt_src_idx)) {
            val s_idx: u32 = O.unwrap[u32](opt_src_idx);
            val opt_dst_idx: O.Option[u32] = env_find_fact(e, dst);
            if (O.is_some[u32](opt_dst_idx)) {
                val d_idx: u32 = O.unwrap[u32](opt_dst_idx);
                e.facts[d_idx].tag_type = tag_type;
                e.facts[d_idx].total_cases = total_cases;
                caseset_free(e.alloc, ?e.facts[d_idx].possible_cases);
                val res_cs: R.Result[CaseSet, str] = caseset_clone(e.alloc, e.facts[s_idx].possible_cases);
                if (R.is_err[CaseSet, str](res_cs)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](res_cs)); }
                e.facts[d_idx].possible_cases = R.unwrap_ok[CaseSet, str](res_cs);
                ret R.ok_void[str]();
            } or {
                val res_cs: R.Result[CaseSet, str] = caseset_clone(e.alloc, e.facts[s_idx].possible_cases);
                if (R.is_err[CaseSet, str](res_cs)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](res_cs)); }
                val cs: CaseSet = R.unwrap_ok[CaseSet, str](res_cs);
                val res_k: R.Result[StorageKey, str] = key_clone(e.alloc, dst);
                if (R.is_err[StorageKey, str](res_k)) {
                    var cs_tmp: CaseSet = cs;
                    caseset_free(e.alloc, ?cs_tmp);
                    ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](res_k));
                }
                val owned_k: StorageKey = R.unwrap_ok[StorageKey, str](res_k);
                if (e.facts == nil) {
                    val initial_cap: usize = 16;
                    val res_arr: R.Result[*StorageFact, str] = A.allocate[StorageFact](e.alloc, initial_cap);
                    if (R.is_err[*StorageFact, str](res_arr)) {
                        var k_tmp: StorageKey = owned_k;
                        key_free(e.alloc, ?k_tmp);
                        var cs_tmp: CaseSet = cs;
                        caseset_free(e.alloc, ?cs_tmp);
                        ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
                    }
                    e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
                    e.facts_cap = initial_cap::u32;
                    e.facts_len = 0;
                }
                if (e.facts_len >= e.facts_cap) {
                    val new_cap: usize = (e.facts_cap * 2)::usize;
                    val res_arr: R.Result[*StorageFact, str] = A.reallocate[StorageFact](e.alloc, e.facts, e.facts_cap::usize, new_cap);
                    if (R.is_err[*StorageFact, str](res_arr)) {
                        var k_tmp: StorageKey = owned_k;
                        key_free(e.alloc, ?k_tmp);
                        var cs_tmp: CaseSet = cs;
                        caseset_free(e.alloc, ?cs_tmp);
                        ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
                    }
                    e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
                    e.facts_cap = new_cap::u32;
                }
                e.facts[e.facts_len] = StorageFact{
                    key:            owned_k,
                    tag_type:       tag_type,
                    total_cases:    total_cases,
                    possible_cases: cs,
                };
                e.facts_len = e.facts_len + 1;
                ret R.ok_void[str]();
            }
        }
    }
    val opt_existing: O.Option[u32] = env_find_fact(e, dst);
    if (O.is_some[u32](opt_existing)) {
        env_remove_fact_at(e, O.unwrap[u32](opt_existing));
    }
    ret R.ok_void[str]();
}

pub fun env_equals(a: *ProofEnv, b: *ProofEnv) bool {
    if (a.reachable != b.reachable) { ret false; }
    if (!a.reachable)               { ret true; }
    if (!escape_equals(a.escapes, b.escapes)) { ret false; }
    if (a.facts_len != b.facts_len) { ret false; }
    var i: u32 = 0;
    for (i < a.facts_len) {
        val opt_b: O.Option[u32] = env_find_fact(b, a.facts[i].key);
        if (O.is_none[u32](opt_b)) { ret false; }
        val b_idx: u32 = O.unwrap[u32](opt_b);
        if (a.facts[i].tag_type != b.facts[b_idx].tag_type) { ret false; }
        if (!caseset_equals(a.facts[i].possible_cases, b.facts[b_idx].possible_cases)) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun env_join(alloc: *A.Allocator, a: *ProofEnv, b: *ProofEnv) R.Result[ProofEnv, str] {
    if (!a.reachable && !b.reachable) { ret R.ok[ProofEnv, str](env_unreachable(alloc)); }
    if (!a.reachable)                 { ret env_clone(alloc, b); }
    if (!b.reachable)                 { ret env_clone(alloc, a); }

    var out: ProofEnv = env_init(alloc);
    val res_esc_a: R.Result[EscapeSet, str] = escape_clone(alloc, a.escapes);
    if (R.is_err[EscapeSet, str](res_esc_a)) { ret R.err[ProofEnv, str](R.unwrap_err[EscapeSet, str](res_esc_a)); }
    out.escapes = R.unwrap_ok[EscapeSet, str](res_esc_a);
    val res_u: R.Result[R.Void, str] = escape_union(alloc, ?out.escapes, b.escapes);
    if (R.is_err[R.Void, str](res_u)) {
        env_free(?out);
        ret R.err[ProofEnv, str](R.unwrap_err[R.Void, str](res_u));
    }

    var i: u32 = 0;
    for (i < a.facts_len) {
        val opt_b: O.Option[u32] = env_find_fact(b, a.facts[i].key);
        if (O.is_some[u32](opt_b)) {
            val b_idx: u32 = O.unwrap[u32](opt_b);
            if (a.facts[i].tag_type == b.facts[b_idx].tag_type) {
                val res_cs: R.Result[CaseSet, str] = caseset_clone(alloc, a.facts[i].possible_cases);
                if (R.is_err[CaseSet, str](res_cs)) {
                    env_free(?out);
                    ret R.err[ProofEnv, str](R.unwrap_err[CaseSet, str](res_cs));
                }
                var joined_cs: CaseSet = R.unwrap_ok[CaseSet, str](res_cs);
                caseset_union(?joined_cs, b.facts[b_idx].possible_cases);

                val res_k: R.Result[StorageKey, str] = key_clone(alloc, a.facts[i].key);
                if (R.is_err[StorageKey, str](res_k)) {
                    caseset_free(alloc, ?joined_cs);
                    env_free(?out);
                    ret R.err[ProofEnv, str](R.unwrap_err[StorageKey, str](res_k));
                }
                val owned_k: StorageKey = R.unwrap_ok[StorageKey, str](res_k);

                if (out.facts == nil) {
                    val initial_cap: usize = 16;
                    val res_arr: R.Result[*StorageFact, str] = A.allocate[StorageFact](alloc, initial_cap);
                    if (R.is_err[*StorageFact, str](res_arr)) {
                        var k_tmp: StorageKey = owned_k;
                        key_free(alloc, ?k_tmp);
                        caseset_free(alloc, ?joined_cs);
                        env_free(?out);
                        ret R.err[ProofEnv, str](R.unwrap_err[*StorageFact, str](res_arr));
                    }
                    out.facts = R.unwrap_ok[*StorageFact, str](res_arr);
                    out.facts_cap = initial_cap::u32;
                    out.facts_len = 0;
                }
                if (out.facts_len >= out.facts_cap) {
                    val new_cap: usize = (out.facts_cap * 2)::usize;
                    val res_arr: R.Result[*StorageFact, str] = A.reallocate[StorageFact](alloc, out.facts, out.facts_cap::usize, new_cap);
                    if (R.is_err[*StorageFact, str](res_arr)) {
                        var k_tmp: StorageKey = owned_k;
                        key_free(alloc, ?k_tmp);
                        caseset_free(alloc, ?joined_cs);
                        env_free(?out);
                        ret R.err[ProofEnv, str](R.unwrap_err[*StorageFact, str](res_arr));
                    }
                    out.facts = R.unwrap_ok[*StorageFact, str](res_arr);
                    out.facts_cap = new_cap::u32;
                }
                out.facts[out.facts_len] = StorageFact{
                    key:            owned_k,
                    tag_type:       a.facts[i].tag_type,
                    total_cases:    a.facts[i].total_cases,
                    possible_cases: joined_cs,
                };
                out.facts_len = out.facts_len + 1;
            }
        }
        i = i + 1;
    }
    ret R.ok[ProofEnv, str](out);
}

pub fun is_case_proven(env: *ProofEnv, key: StorageKey, case_idx: u32) bool {
    if (!env.reachable)             { ret true; }
    if (key.root_kind == ROOT_NONE) { ret false; }
    val opt_idx: O.Option[u32] = env_find_fact(env, key);
    if (O.is_none[u32](opt_idx))    { ret false; }
    val idx: u32 = O.unwrap[u32](opt_idx);
    ret caseset_is_single(env.facts[idx].possible_cases, case_idx);
}

pub rec LoopContext {
    breaks:        *ProofEnv;
    breaks_len:    u32;
    breaks_cap:    u32;
    continues:     *ProofEnv;
    continues_len: u32;
    continues_cap: u32;
    alloc:         *A.Allocator;
}

pub fun loop_ctx_init(alloc: *A.Allocator) LoopContext {
    ret LoopContext{
        breaks:        nil,
        breaks_len:    0,
        breaks_cap:    0,
        continues:     nil,
        continues_len: 0,
        continues_cap: 0,
        alloc:         alloc,
    };
}

pub fun loop_ctx_reset(lc: *LoopContext) {
    if (lc.breaks != nil) {
        var i: u32 = 0;
        for (i < lc.breaks_len) {
            env_free(?lc.breaks[i]);
            i = i + 1;
        }
        lc.breaks_len = 0;
    }
    if (lc.continues != nil) {
        var i: u32 = 0;
        for (i < lc.continues_len) {
            env_free(?lc.continues[i]);
            i = i + 1;
        }
        lc.continues_len = 0;
    }
}

pub fun loop_ctx_free(lc: *LoopContext) {
    loop_ctx_reset(lc);
    if (lc.breaks != nil && lc.breaks_cap > 0) {
        A.deallocate[ProofEnv](lc.alloc, lc.breaks, lc.breaks_cap::usize);
        lc.breaks = nil;
        lc.breaks_cap = 0;
    }
    if (lc.continues != nil && lc.continues_cap > 0) {
        A.deallocate[ProofEnv](lc.alloc, lc.continues, lc.continues_cap::usize);
        lc.continues = nil;
        lc.continues_cap = 0;
    }
}

pub fun loop_ctx_add_break(lc: *LoopContext, env: *ProofEnv) R.Result[R.Void, str] {
    if (!env.reachable) { ret R.ok_void[str](); }
    if (lc.breaks == nil) {
        val initial_cap: usize = 8;
        val res: R.Result[*ProofEnv, str] = A.allocate[ProofEnv](lc.alloc, initial_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.breaks = R.unwrap_ok[*ProofEnv, str](res);
        lc.breaks_cap = initial_cap::u32;
        lc.breaks_len = 0;
    }
    if (lc.breaks_len >= lc.breaks_cap) {
        val new_cap: usize = (lc.breaks_cap * 2)::usize;
        val res: R.Result[*ProofEnv, str] = A.reallocate[ProofEnv](lc.alloc, lc.breaks, lc.breaks_cap::usize, new_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.breaks = R.unwrap_ok[*ProofEnv, str](res);
        lc.breaks_cap = new_cap::u32;
    }
    val res_c: R.Result[ProofEnv, str] = env_clone(lc.alloc, env);
    if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
    lc.breaks[lc.breaks_len] = R.unwrap_ok[ProofEnv, str](res_c);
    lc.breaks_len = lc.breaks_len + 1;
    ret R.ok_void[str]();
}

pub fun loop_ctx_add_continue(lc: *LoopContext, env: *ProofEnv) R.Result[R.Void, str] {
    if (!env.reachable) { ret R.ok_void[str](); }
    if (lc.continues == nil) {
        val initial_cap: usize = 8;
        val res: R.Result[*ProofEnv, str] = A.allocate[ProofEnv](lc.alloc, initial_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.continues = R.unwrap_ok[*ProofEnv, str](res);
        lc.continues_cap = initial_cap::u32;
        lc.continues_len = 0;
    }
    if (lc.continues_len >= lc.continues_cap) {
        val new_cap: usize = (lc.continues_cap * 2)::usize;
        val res: R.Result[*ProofEnv, str] = A.reallocate[ProofEnv](lc.alloc, lc.continues, lc.continues_cap::usize, new_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.continues = R.unwrap_ok[*ProofEnv, str](res);
        lc.continues_cap = new_cap::u32;
    }
    val res_c: R.Result[ProofEnv, str] = env_clone(lc.alloc, env);
    if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
    lc.continues[lc.continues_len] = R.unwrap_ok[ProofEnv, str](res_c);
    lc.continues_len = lc.continues_len + 1;
    ret R.ok_void[str]();
}

pub fun loop_ctx_join_breaks(lc: *LoopContext) R.Result[ProofEnv, str] {
    if (lc.breaks_len == 0) { ret R.ok[ProofEnv, str](env_unreachable(lc.alloc)); }
    var acc: ProofEnv;
    val res_0: R.Result[ProofEnv, str] = env_clone(lc.alloc, ?lc.breaks[0]);
    if (R.is_err[ProofEnv, str](res_0)) { ret res_0; }
    acc = R.unwrap_ok[ProofEnv, str](res_0);
    var i: u32 = 1;
    for (i < lc.breaks_len) {
        val res_j: R.Result[ProofEnv, str] = env_join(lc.alloc, ?acc, ?lc.breaks[i]);
        env_free(?acc);
        if (R.is_err[ProofEnv, str](res_j)) { ret res_j; }
        acc = R.unwrap_ok[ProofEnv, str](res_j);
        i = i + 1;
    }
    ret R.ok[ProofEnv, str](acc);
}

pub fun loop_ctx_join_continues(lc: *LoopContext) R.Result[ProofEnv, str] {
    if (lc.continues_len == 0) { ret R.ok[ProofEnv, str](env_unreachable(lc.alloc)); }
    var acc: ProofEnv;
    val res_0: R.Result[ProofEnv, str] = env_clone(lc.alloc, ?lc.continues[0]);
    if (R.is_err[ProofEnv, str](res_0)) { ret res_0; }
    acc = R.unwrap_ok[ProofEnv, str](res_0);
    var i: u32 = 1;
    for (i < lc.continues_len) {
        val res_j: R.Result[ProofEnv, str] = env_join(lc.alloc, ?acc, ?lc.continues[i]);
        env_free(?acc);
        if (R.is_err[ProofEnv, str](res_j)) { ret res_j; }
        acc = R.unwrap_ok[ProofEnv, str](res_j);
        i = i + 1;
    }
    ret R.ok[ProofEnv, str](acc);
}

pub rec FinStack {
    stmts: *id.StmtId;
    len:   u32;
    cap:   u32;
    alloc: *A.Allocator;
}

pub fun fin_stack_init(alloc: *A.Allocator) FinStack {
    ret FinStack{ stmts: nil, len: 0, cap: 0, alloc: alloc };
}

pub fun fin_stack_free(fs: *FinStack) {
    if (fs.stmts != nil && fs.cap > 0) {
        A.deallocate[id.StmtId](fs.alloc, fs.stmts, fs.cap::usize);
        fs.stmts = nil;
        fs.len = 0;
        fs.cap = 0;
    }
}

pub fun fin_stack_push(fs: *FinStack, sid: id.StmtId) R.Result[R.Void, str] {
    if (fs.stmts == nil) {
        val initial_cap: usize = 4;
        val res: R.Result[*id.StmtId, str] = A.allocate[id.StmtId](fs.alloc, initial_cap);
        if (R.is_err[*id.StmtId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*id.StmtId, str](res)); }
        fs.stmts = R.unwrap_ok[*id.StmtId, str](res);
        fs.cap = initial_cap::u32;
        fs.len = 0;
    }
    if (fs.len >= fs.cap) {
        val new_cap: usize = (fs.cap * 2)::usize;
        val res: R.Result[*id.StmtId, str] = A.reallocate[id.StmtId](fs.alloc, fs.stmts, fs.cap::usize, new_cap);
        if (R.is_err[*id.StmtId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*id.StmtId, str](res)); }
        fs.stmts = R.unwrap_ok[*id.StmtId, str](res);
        fs.cap = new_cap::u32;
    }
    fs.stmts[fs.len] = sid;
    fs.len = fs.len + 1;
    ret R.ok_void[str]();
}

fun intern_span_id(sc: *context.SemaContext, span: token.Span) intern.StrId {
    val res: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (R.is_err[intern.StrId, str](res)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](res);
}

fun symbol_id_for_expr(sc: *context.SemaContext, eid: id.ExprId) O.Option[resolve.SymbolId] {
    if (sc.rr == nil || sc.rr.expr_resolved == nil || eid >= sc.rr.expr_count) {
        ret O.none[resolve.SymbolId]();
    }
    val sid: resolve.SymbolId = sc.rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid == resolve.SYMBOL_REJECTED) {
        ret O.none[resolve.SymbolId]();
    }
    ret O.some[resolve.SymbolId](sid);
}

pub fun storage_of_expr(sc: *context.SemaContext, alloc: *A.Allocator, eid: id.ExprId) StorageKey {
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret key_none(); }
    val e_opt: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](e_opt)) { ret key_none(); }
    var ev: expr.Expr = R.unwrap_ok[expr.Expr, str](e_opt);
    val e: *expr.Expr = ?ev;

    if (e.kind == expr.EXPR_KIND_IDENT) {
        val sid_opt: O.Option[resolve.SymbolId] = symbol_id_for_expr(sc, eid);
        if (O.is_none[resolve.SymbolId](sid_opt)) { ret key_none(); }
        ret key_local(O.unwrap[resolve.SymbolId](sid_opt));
    }

    if (e.kind == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_DEREF) {
        val operand: id.ExprId = e.data.unary.operand;
        val sub_opt: R.Result[expr.Expr, str] = context.expression(sc, operand);
        if (R.is_ok[expr.Expr, str](sub_opt)) {
            var sub_ev: expr.Expr = R.unwrap_ok[expr.Expr, str](sub_opt);
            if (sub_ev.kind == expr.EXPR_KIND_IDENT) {
                val sid_opt: O.Option[resolve.SymbolId] = symbol_id_for_expr(sc, operand);
                if (O.is_some[resolve.SymbolId](sid_opt)) {
                    ret key_pointee(O.unwrap[resolve.SymbolId](sid_opt));
                }
            }
        }
        ret key_any_pointee();
    }

    if (e.kind == expr.EXPR_KIND_MEMBER) {
        val obj_eid: id.ExprId = e.data.member.object;
        var obj_key: StorageKey = key_none();
        var is_auto_deref: bool = false;
        if (sc.expr_type != nil && obj_eid < sc.a.expr_len::u32) {
            val ot: type.TypeId = type.strip_secret(?sc.s.types, sc.expr_type[obj_eid]);
            if (type.is_pointer(?sc.s.types, ot)) {
                is_auto_deref = true;
            }
        }
        if (is_auto_deref) {
            val sub_opt: R.Result[expr.Expr, str] = context.expression(sc, obj_eid);
            if (R.is_ok[expr.Expr, str](sub_opt)) {
                var sub_ev: expr.Expr = R.unwrap_ok[expr.Expr, str](sub_opt);
                if (sub_ev.kind == expr.EXPR_KIND_IDENT) {
                    val sid_opt: O.Option[resolve.SymbolId] = symbol_id_for_expr(sc, obj_eid);
                    if (O.is_some[resolve.SymbolId](sid_opt)) {
                        obj_key = key_pointee(O.unwrap[resolve.SymbolId](sid_opt));
                    }
                }
            }
            if (obj_key.root_kind == ROOT_NONE) {
                obj_key = key_any_pointee();
            }
        } or {
            obj_key = storage_of_expr(sc, alloc, obj_eid);
        }
        if (obj_key.root_kind != ROOT_NONE) {
            val field_name: intern.StrId = intern_span_id(sc, e.data.member.name);
            key_add_projection(alloc, ?obj_key, field_name);
            ret obj_key;
        }
    }

    ret key_none();
}

pub fun tag_storage_of_object(sc: *context.SemaContext, alloc: *A.Allocator, obj_eid: id.ExprId) StorageKey {
    if (obj_eid == id.EXPR_NIL || obj_eid >= sc.a.expr_len::u32) { ret key_none(); }
    if (sc.expr_type != nil) {
        val ot: type.TypeId = type.strip_secret(?sc.s.types, sc.expr_type[obj_eid]);
        if (type.is_pointer(?sc.s.types, ot)) {
            val sub_opt: R.Result[expr.Expr, str] = context.expression(sc, obj_eid);
            if (R.is_ok[expr.Expr, str](sub_opt)) {
                var sub_ev: expr.Expr = R.unwrap_ok[expr.Expr, str](sub_opt);
                if (sub_ev.kind == expr.EXPR_KIND_IDENT) {
                    val sid_opt: O.Option[resolve.SymbolId] = symbol_id_for_expr(sc, obj_eid);
                    if (O.is_some[resolve.SymbolId](sid_opt)) {
                        ret key_pointee(O.unwrap[resolve.SymbolId](sid_opt));
                    }
                }
            }
            ret key_any_pointee();
        }
    }
    ret storage_of_expr(sc, alloc, obj_eid);
}

pub fun tag_lit_case_index(sc: *context.SemaContext, eid: id.ExprId, tag_type: type.TypeId) O.Option[u32] {
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret O.none[u32](); }
    val e_opt: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](e_opt)) { ret O.none[u32](); }
    var ev: expr.Expr = R.unwrap_ok[expr.Expr, str](e_opt);
    val e: *expr.Expr = ?ev;
    if (e.kind != expr.EXPR_KIND_STRUCT_LIT) { ret O.none[u32](); }
    val sl: *expr.ExprStructLit = ?e.data.struct_lit;
    if (sl.fields_len != 1) { ret O.none[u32](); }
    val selected: *expr.FieldInit = ?sc.a.field_inits[sl.fields_start];
    val case_name: intern.StrId = intern_span_id(sc, selected.name);
    val ft_opt: O.Option[*type.FieldTable] = context.field_table_for(sc, tag_type);
    if (O.is_none[*type.FieldTable](ft_opt)) { ret O.none[u32](); }
    val ft: *type.FieldTable = O.unwrap[*type.FieldTable](ft_opt);
    var i: u32 = 0;
    for (i < ft.fields_len) {
        val fe: *type.FieldEntry = type.field_entry_at(?sc.s.types, ft, i);
        if (fe.name == case_name) {
            ret O.some[u32](i);
        }
        i = i + 1;
    }
    ret O.none[u32]();
}

pub fun refine_condition(
    sc:       *context.SemaContext,
    eid:      id.ExprId,
    env:      *ProofEnv,
    out_then: *ProofEnv,
    out_else: *ProofEnv,
    validate: bool
) R.Result[R.Void, str] {
    if (!env.reachable) {
        @out_then = env_unreachable(env.alloc);
        @out_else = env_unreachable(env.alloc);
        ret R.ok_void[str]();
    }
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) {
        val r_t: R.Result[ProofEnv, str] = env_clone(env.alloc, env);
        if (R.is_err[ProofEnv, str](r_t)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_t)); }
        @out_then = R.unwrap_ok[ProofEnv, str](r_t);
        @out_else = env_unreachable(env.alloc);
        ret R.ok_void[str]();
    }

    val e_opt: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](e_opt)) {
        val r_t: R.Result[ProofEnv, str] = env_clone(env.alloc, env);
        if (R.is_err[ProofEnv, str](r_t)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_t)); }
        val r_e: R.Result[ProofEnv, str] = env_clone(env.alloc, env);
        if (R.is_err[ProofEnv, str](r_e)) {
            var tmp: ProofEnv = R.unwrap_ok[ProofEnv, str](r_t);
            env_free(?tmp);
            ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_e));
        }
        @out_then = R.unwrap_ok[ProofEnv, str](r_t);
        @out_else = R.unwrap_ok[ProofEnv, str](r_e);
        ret R.ok_void[str]();
    }
    var ev: expr.Expr = R.unwrap_ok[expr.Expr, str](e_opt);
    val e: *expr.Expr = ?ev;

    if (e.kind == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_NOT) {
        var inner_then: ProofEnv;
        var inner_else: ProofEnv;
        val r_inner: R.Result[R.Void, str] = refine_condition(sc, e.data.unary.operand, env, ?inner_then, ?inner_else, validate);
        if (R.is_err[R.Void, str](r_inner)) { ret r_inner; }
        @out_then = inner_else;
        @out_else = inner_then;
        ret R.ok_void[str]();
    }

    if (e.kind == expr.EXPR_KIND_BINARY) {
        val b: *expr.ExprBinary = ?e.data.binary;
        if (b.op == expr.BIN_AND) {
            var a_then: ProofEnv;
            var a_else: ProofEnv;
            val ra: R.Result[R.Void, str] = refine_condition(sc, b.lhs, env, ?a_then, ?a_else, validate);
            if (R.is_err[R.Void, str](ra)) { ret ra; }
            var b_then: ProofEnv;
            var b_else: ProofEnv;
            val rb: R.Result[R.Void, str] = refine_condition(sc, b.rhs, ?a_then, ?b_then, ?b_else, validate);
            env_free(?a_then);
            if (R.is_err[R.Void, str](rb)) { env_free(?a_else); ret rb; }
            val r_else: R.Result[ProofEnv, str] = env_join(env.alloc, ?a_else, ?b_else);
            env_free(?a_else);
            env_free(?b_else);
            if (R.is_err[ProofEnv, str](r_else)) { env_free(?b_then); ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_else)); }
            @out_then = b_then;
            @out_else = R.unwrap_ok[ProofEnv, str](r_else);
            ret R.ok_void[str]();
        }
        if (b.op == expr.BIN_OR) {
            var a_then: ProofEnv;
            var a_else: ProofEnv;
            val ra: R.Result[R.Void, str] = refine_condition(sc, b.lhs, env, ?a_then, ?a_else, validate);
            if (R.is_err[R.Void, str](ra)) { ret ra; }
            var b_then: ProofEnv;
            var b_else: ProofEnv;
            val rb: R.Result[R.Void, str] = refine_condition(sc, b.rhs, ?a_else, ?b_then, ?b_else, validate);
            env_free(?a_else);
            if (R.is_err[R.Void, str](rb)) { env_free(?a_then); ret rb; }
            val r_then: R.Result[ProofEnv, str] = env_join(env.alloc, ?a_then, ?b_then);
            env_free(?a_then);
            env_free(?b_then);
            if (R.is_err[ProofEnv, str](r_then)) { env_free(?b_else); ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_then)); }
            @out_then = R.unwrap_ok[ProofEnv, str](r_then);
            @out_else = b_else;
            ret R.ok_void[str]();
        }
        if (b.op == expr.BIN_EQ || b.op == expr.BIN_NEQ) {
            if (sc.expr_type != nil && b.lhs < sc.a.expr_len::u32 && b.rhs < sc.a.expr_len::u32) {
                val lt: type.TypeId = sc.expr_type[b.lhs];
                val rt: type.TypeId = sc.expr_type[b.rhs];
                val lhs_sel: bool = type.is_case_selector(?sc.s.types, lt);
                val rhs_sel: bool = type.is_case_selector(?sc.s.types, rt);
                if (lhs_sel || rhs_sel) {
                    var sel_eid: id.ExprId = b.rhs;
                    var tag_eid: id.ExprId = b.lhs;
                    if (lhs_sel) { sel_eid = b.lhs; tag_eid = b.rhs; }
                    val sel_ty: type.TypeId = sc.expr_type[sel_eid];
                    val tag_ty: type.TypeId = type.strip_secret(?sc.s.types, type.case_selector_tag_type(?sc.s.types, sel_ty));
                    val c_idx:  u32         = type.case_selector_case_index(?sc.s.types, sel_ty);
                    val total:  u32         = type.field_count(?sc.s.types, tag_ty);

                    var eval_env: ProofEnv;
                    val re_c: R.Result[ProofEnv, str] = env_clone(env.alloc, env);
                    if (R.is_err[ProofEnv, str](re_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](re_c)); }
                    eval_env = R.unwrap_ok[ProofEnv, str](re_c);
                    val re_tag: R.Result[R.Void, str] = analyze_expr(sc, tag_eid, ?eval_env, validate);
                    if (R.is_err[R.Void, str](re_tag)) { env_free(?eval_env); ret re_tag; }

                    val key: StorageKey = storage_of_expr(sc, env.alloc, tag_eid);

                    var then_clone: ProofEnv;
                    val rt_c: R.Result[ProofEnv, str] = env_clone(env.alloc, ?eval_env);
                    if (R.is_err[ProofEnv, str](rt_c)) {
                        env_free(?eval_env);
                        var k_tmp: StorageKey = key;
                        key_free(env.alloc, ?k_tmp);
                        ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](rt_c));
                    }
                    then_clone = R.unwrap_ok[ProofEnv, str](rt_c);
                    var else_clone: ProofEnv = eval_env;

                    if (key.root_kind != ROOT_NONE) {
                        if (b.op == expr.BIN_EQ) {
                            env_set_fact_case(?then_clone, key, tag_ty, total, c_idx);
                            env_remove_case(?else_clone, key, tag_ty, total, c_idx);
                        } or {
                            env_remove_case(?then_clone, key, tag_ty, total, c_idx);
                            env_set_fact_case(?else_clone, key, tag_ty, total, c_idx);
                        }
                    }
                    var k_tmp: StorageKey = key;
                    key_free(env.alloc, ?k_tmp);
                    @out_then = then_clone;
                    @out_else = else_clone;
                    ret R.ok_void[str]();
                }
            }
        }
    }

    var cur_env: ProofEnv;
    val rc: R.Result[ProofEnv, str] = env_clone(env.alloc, env);
    if (R.is_err[ProofEnv, str](rc)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](rc)); }
    cur_env = R.unwrap_ok[ProofEnv, str](rc);
    val re: R.Result[R.Void, str] = analyze_expr(sc, eid, ?cur_env, validate);
    if (R.is_err[R.Void, str](re)) { env_free(?cur_env); ret re; }
    val r_t: R.Result[ProofEnv, str] = env_clone(env.alloc, ?cur_env);
    if (R.is_err[ProofEnv, str](r_t)) { env_free(?cur_env); ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_t)); }
    @out_then = R.unwrap_ok[ProofEnv, str](r_t);
    @out_else = cur_env;
    ret R.ok_void[str]();
}

pub fun analyze_expr(
    sc:       *context.SemaContext,
    eid:      id.ExprId,
    env:      *ProofEnv,
    validate: bool
) R.Result[R.Void, str] {
    if (!env.reachable) { ret R.ok_void[str](); }
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret R.ok_void[str](); }
    val e_opt: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](e_opt)) { ret R.ok_void[str](); }
    var ev: expr.Expr = R.unwrap_ok[expr.Expr, str](e_opt);
    val e: *expr.Expr = ?ev;
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_CALL) {
        val c: *expr.ExprCall = ?e.data.call;
        var i: u32 = 0;
        for (i < c.args_len) {
            val arg_eid: id.ExprId = sc.a.expr_ids[c.args_start + i];
            val ra: R.Result[R.Void, str] = analyze_expr(sc, arg_eid, env, validate);
            if (R.is_err[R.Void, str](ra)) { ret ra; }
            i = i + 1;
        }
        env_invalidate_calls(env);
        ret R.ok_void[str]();
    }

    if (k == expr.EXPR_KIND_BINARY) {
        val b: *expr.ExprBinary = ?e.data.binary;
        if (b.op == expr.BIN_ASSIGN) {
            val r_rhs: R.Result[R.Void, str] = analyze_expr(sc, b.rhs, env, validate);
            if (R.is_err[R.Void, str](r_rhs)) { ret r_rhs; }
            val r_lhs: R.Result[R.Void, str] = analyze_expr(sc, b.lhs, env, validate);
            if (R.is_err[R.Void, str](r_lhs)) { ret r_lhs; }

            val lhs_key: StorageKey = storage_of_expr(sc, env.alloc, b.lhs);

            var rhs_cs_opt: O.Option[CaseSet] = O.none[CaseSet]();
            val rhs_key: StorageKey = storage_of_expr(sc, env.alloc, b.rhs);
            if (rhs_key.root_kind != ROOT_NONE) {
                val opt_src: O.Option[u32] = env_find_fact(env, rhs_key);
                if (O.is_some[u32](opt_src)) {
                    val s_idx: u32 = O.unwrap[u32](opt_src);
                    val r_cs: R.Result[CaseSet, str] = caseset_clone(env.alloc, env.facts[s_idx].possible_cases);
                    if (R.is_ok[CaseSet, str](r_cs)) {
                        rhs_cs_opt = O.some[CaseSet](R.unwrap_ok[CaseSet, str](r_cs));
                    }
                }
            }
            var rk_tmp: StorageKey = rhs_key;
            key_free(env.alloc, ?rk_tmp);

            if (lhs_key.root_kind == ROOT_POINTEE || lhs_key.root_kind == ROOT_ANY_POINTEE) {
                env_remove_all_pointees(env);
                env_remove_escaped_locals(env);
            } or {
                if (lhs_key.root_kind == ROOT_LOCAL) {
                    if (sc.expr_type != nil && b.lhs < sc.a.expr_len::u32) {
                        val base_t: type.TypeId = type.strip_secret(?sc.s.types, sc.expr_type[b.lhs]);
                        if (type.is_pointer(?sc.s.types, base_t)) {
                            env_remove_pointee_sym(env, lhs_key.root_sym);
                        }
                    }
                    if (escape_contains(env.escapes, lhs_key.root_sym)) {
                        env_remove_all_pointees(env);
                    }
                    env_remove_prefix(env, lhs_key);
                } or {
                    env_remove_all_pointees(env);
                    env_remove_escaped_locals(env);
                }
            }

            if (sc.expr_type != nil && b.lhs < sc.a.expr_len::u32) {
                val lt: type.TypeId = type.strip_secret(?sc.s.types, sc.expr_type[b.lhs]);
                if (type.is_tag(?sc.s.types, lt)) {
                    val total: u32 = type.field_count(?sc.s.types, lt);
                    val lit_case: O.Option[u32] = tag_lit_case_index(sc, b.rhs, lt);
                    if (O.is_some[u32](lit_case)) {
                        env_set_fact_case(env, lhs_key, lt, total, O.unwrap[u32](lit_case));
                        if (O.is_some[CaseSet](rhs_cs_opt)) {
                            var cs_to_free: CaseSet = O.unwrap[CaseSet](rhs_cs_opt);
                            caseset_free(env.alloc, ?cs_to_free);
                        }
                    } or {
                        if (O.is_some[CaseSet](rhs_cs_opt)) {
                            env_set_fact_caseset(env, lhs_key, lt, total, O.unwrap[CaseSet](rhs_cs_opt));
                        }
                    }
                } or {
                    if (O.is_some[CaseSet](rhs_cs_opt)) {
                        var cs_to_free: CaseSet = O.unwrap[CaseSet](rhs_cs_opt);
                        caseset_free(env.alloc, ?cs_to_free);
                    }
                }
            } or {
                if (O.is_some[CaseSet](rhs_cs_opt)) {
                    var cs_to_free: CaseSet = O.unwrap[CaseSet](rhs_cs_opt);
                    caseset_free(env.alloc, ?cs_to_free);
                }
            }

            var lk_tmp: StorageKey = lhs_key;
            key_free(env.alloc, ?lk_tmp);
            ret R.ok_void[str]();
        }

        val rl: R.Result[R.Void, str] = analyze_expr(sc, b.lhs, env, validate);
        if (R.is_err[R.Void, str](rl)) { ret rl; }
        ret analyze_expr(sc, b.rhs, env, validate);
    }

    if (k == expr.EXPR_KIND_UNARY) {
        val u: *expr.ExprUnary = ?e.data.unary;
        if (u.op == expr.UN_ADDR) {
            val target_key: StorageKey = storage_of_expr(sc, env.alloc, u.operand);
            if (target_key.root_kind == ROOT_LOCAL) {
                escape_add(env.alloc, ?env.escapes, target_key.root_sym);
            }
            var tk_tmp: StorageKey = target_key;
            key_free(env.alloc, ?tk_tmp);
        }
        ret analyze_expr(sc, u.operand, env, validate);
    }

    if (k == expr.EXPR_KIND_MEMBER) {
        val m: *expr.ExprMember = ?e.data.member;
        val ro: R.Result[R.Void, str] = analyze_expr(sc, m.object, env, validate);
        if (R.is_err[R.Void, str](ro)) { ret ro; }

        if (validate) {
            val opt_acc: O.Option[*context.TagAccess] = context.find_tag_access(sc, eid);
            if (O.is_some[*context.TagAccess](opt_acc)) {
                val acc: *context.TagAccess = O.unwrap[*context.TagAccess](opt_acc);
                if (!acc.is_selector) {
                    val obj_key: StorageKey = tag_storage_of_object(sc, env.alloc, m.object);
                    val proven: bool = is_case_proven(env, obj_key, acc.case_index);
                    var ok_tmp: StorageKey = obj_key;
                    key_free(env.alloc, ?ok_tmp);
                    if (!proven) {
                        context.report(sc, e.span, "a tag payload requires proof that its case is active");
                    }
                }
            }
        }
        ret R.ok_void[str]();
    }

    if (k == expr.EXPR_KIND_INDEX)   { ret analyze_expr(sc, e.data.index.object, env, validate); }
    if (k == expr.EXPR_KIND_PROJECT) { ret analyze_expr(sc, e.data.project.object, env, validate); }
    if (k == expr.EXPR_KIND_CAST)    { ret analyze_expr(sc, e.data.cast.value, env, validate); }

    ret R.ok_void[str]();
}

pub fun analyze_stmt(
    sc:       *context.SemaContext,
    sid:      id.StmtId,
    env_in:   *ProofEnv,
    env_out:  *ProofEnv,
    loop_ctx: *LoopContext,
    validate: bool
) R.Result[R.Void, str] {
    if (!env_in.reachable) {
        @env_out = env_unreachable(env_in.alloc);
        ret R.ok_void[str]();
    }
    if (sid == id.STMT_NIL || sid >= sc.a.stmt_len::u32) {
        val res_c: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
        @env_out = R.unwrap_ok[ProofEnv, str](res_c);
        ret R.ok_void[str]();
    }
    val opt_s: O.Option[*stmt.Stmt] = ast.get_stmt(sc.a, sid);
    if (O.is_none[*stmt.Stmt](opt_s)) {
        val res_c: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
        @env_out = R.unwrap_ok[ProofEnv, str](res_c);
        ret R.ok_void[str]();
    }
    val s: *stmt.Stmt = O.unwrap[*stmt.Stmt](opt_s);
    val k: stmt.StmtKind = s.kind;

    if (k == stmt.STMT_KIND_EXPR) {
        val res_c: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
        var cur_env: ProofEnv = R.unwrap_ok[ProofEnv, str](res_c);
        val re: R.Result[R.Void, str] = analyze_expr(sc, s.data.expr.expr, ?cur_env, validate);
        if (R.is_err[R.Void, str](re)) { env_free(?cur_env); ret re; }
        @env_out = cur_env;
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_DECL) {
        val did: id.DeclId = s.data.decl.decl;
        val res_c: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
        var cur_env: ProofEnv = R.unwrap_ok[ProofEnv, str](res_c);

        val opt_decl: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
        if (O.is_some[*decl.Decl](opt_decl)) {
            val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);
            if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
                if (d.data.bind.init != id.EXPR_NIL) {
                    analyze_expr(sc, d.data.bind.init, ?cur_env, validate);
                }
                if (sc.decl_type != nil && did < sc.a.decl_len::u32) {
                    val raw_ty: type.TypeId = sc.decl_type[did];
                    val ty:     type.TypeId = type.strip_secret(?sc.s.types, raw_ty);
                    val opt_sid: O.Option[resolve.SymbolId] = context.symbol_for_decl(sc, did);
                    if (O.is_some[resolve.SymbolId](opt_sid)) {
                        val sid_val: resolve.SymbolId = O.unwrap[resolve.SymbolId](opt_sid);
                        val var_key: StorageKey = key_local(sid_val);
                        if (type.is_tag(?sc.s.types, ty)) {
                            val total: u32 = type.field_count(?sc.s.types, ty);
                            if (d.data.bind.init != id.EXPR_NIL) {
                                val lit_case: O.Option[u32] = tag_lit_case_index(sc, d.data.bind.init, ty);
                                if (O.is_some[u32](lit_case)) {
                                    env_set_fact_case(?cur_env, var_key, ty, total, O.unwrap[u32](lit_case));
                                } or {
                                    val rhs_key: StorageKey = storage_of_expr(sc, cur_env.alloc, d.data.bind.init);
                                    env_transfer_fact(?cur_env, var_key, rhs_key, ty, total);
                                    var rk_tmp: StorageKey = rhs_key;
                                    key_free(cur_env.alloc, ?rk_tmp);
                                }
                            } or {
                                if (total > 0) {
                                    env_set_fact_case(?cur_env, var_key, ty, total, 0);
                                }
                            }
                        }
                    }
                }
            }
        }
        @env_out = cur_env;
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_IF) {
        var then_in: ProofEnv;
        var else_in: ProofEnv;
        val rc: R.Result[R.Void, str] = refine_condition(sc, s.data.if_.cond, env_in, ?then_in, ?else_in, validate);
        if (R.is_err[R.Void, str](rc)) { ret rc; }

        var then_out: ProofEnv;
        val rt: R.Result[R.Void, str] = analyze_stmt(sc, s.data.if_.then_block, ?then_in, ?then_out, loop_ctx, validate);
        env_free(?then_in);
        if (R.is_err[R.Void, str](rt)) { env_free(?else_in); ret rt; }

        var else_out: ProofEnv;
        val re: R.Result[R.Void, str] = analyze_stmt(sc, s.data.if_.else_block, ?else_in, ?else_out, loop_ctx, validate);
        env_free(?else_in);
        if (R.is_err[R.Void, str](re)) { env_free(?then_out); ret re; }

        val r_joined: R.Result[ProofEnv, str] = env_join(env_in.alloc, ?then_out, ?else_out);
        env_free(?then_out);
        env_free(?else_out);
        if (R.is_err[ProofEnv, str](r_joined)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_joined)); }
        @env_out = R.unwrap_ok[ProofEnv, str](r_joined);
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_FOR) {
        var loop_inner: LoopContext = loop_ctx_init(env_in.alloc);

        var header_env: ProofEnv;
        val rh: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](rh)) { loop_ctx_free(?loop_inner); ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](rh)); }
        header_env = R.unwrap_ok[ProofEnv, str](rh);

        for (true) {
            loop_ctx_reset(?loop_inner);
            var body_in: ProofEnv;
            var cond_exit: ProofEnv;
            refine_condition(sc, s.data.for_.cond, ?header_env, ?body_in, ?cond_exit, false);

            var body_out: ProofEnv;
            analyze_stmt(sc, s.data.for_.body, ?body_in, ?body_out, ?loop_inner, false);
            env_free(?body_in);
            env_free(?cond_exit);

            var cont_joined: ProofEnv = R.unwrap_ok[ProofEnv, str](loop_ctx_join_continues(?loop_inner));
            var backedge_env: ProofEnv = R.unwrap_ok[ProofEnv, str](env_join(env_in.alloc, ?body_out, ?cont_joined));
            env_free(?body_out);
            env_free(?cont_joined);

            var next_header: ProofEnv = R.unwrap_ok[ProofEnv, str](env_join(env_in.alloc, env_in, ?backedge_env));
            env_free(?backedge_env);

            val converged: bool = env_equals(?header_env, ?next_header);
            env_free(?header_env);
            header_env = next_header;
            if (converged) { brk; }
        }

        loop_ctx_reset(?loop_inner);
        var body_in: ProofEnv;
        var cond_exit: ProofEnv;
        refine_condition(sc, s.data.for_.cond, ?header_env, ?body_in, ?cond_exit, validate);
        env_free(?header_env);

        var body_out: ProofEnv;
        analyze_stmt(sc, s.data.for_.body, ?body_in, ?body_out, ?loop_inner, validate);
        env_free(?body_in);
        env_free(?body_out);

        var break_joined: ProofEnv = R.unwrap_ok[ProofEnv, str](loop_ctx_join_breaks(?loop_inner));
        var final_exit: ProofEnv = R.unwrap_ok[ProofEnv, str](env_join(env_in.alloc, ?cond_exit, ?break_joined));
        env_free(?cond_exit);
        env_free(?break_joined);
        loop_ctx_free(?loop_inner);

        @env_out = final_exit;
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_BLOCK) {
        val b: *stmt.StmtBlock = ?s.data.block;
        var cur_env: ProofEnv;
        val rc: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](rc)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](rc)); }
        cur_env = R.unwrap_ok[ProofEnv, str](rc);

        var last_reachable: ProofEnv;
        val r_lr: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](r_lr)) { env_free(?cur_env); ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_lr)); }
        last_reachable = R.unwrap_ok[ProofEnv, str](r_lr);

        var fin_stack: FinStack = fin_stack_init(env_in.alloc);

        var i: u32 = 0;
        for (i < b.stmts_len) {
            val sub_sid: id.StmtId = sc.a.stmt_ids[b.stmts_start + i];
            val sub_opt: O.Option[*stmt.Stmt] = ast.get_stmt(sc.a, sub_sid);
            if (O.is_some[*stmt.Stmt](sub_opt)) {
                val sub_s: *stmt.Stmt = O.unwrap[*stmt.Stmt](sub_opt);
                if (sub_s.kind == stmt.STMT_KIND_FIN) {
                    fin_stack_push(?fin_stack, sub_s.data.fin_.body);
                } or {
                    if (cur_env.reachable) {
                        env_free(?last_reachable);
                        val r_c: R.Result[ProofEnv, str] = env_clone(env_in.alloc, ?cur_env);
                        if (R.is_err[ProofEnv, str](r_c)) {
                            env_free(?cur_env);
                            fin_stack_free(?fin_stack);
                            ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](r_c));
                        }
                        last_reachable = R.unwrap_ok[ProofEnv, str](r_c);
                    }
                    var next_env: ProofEnv;
                    val rs: R.Result[R.Void, str] = analyze_stmt(sc, sub_sid, ?cur_env, ?next_env, loop_ctx, validate);
                    env_free(?cur_env);
                    if (R.is_err[R.Void, str](rs)) {
                        env_free(?last_reachable);
                        fin_stack_free(?fin_stack);
                        ret rs;
                    }
                    cur_env = next_env;
                    if (!cur_env.reachable) { brk; }
                }
            }
            i = i + 1;
        }

        if (fin_stack.len > 0) {
            var fin_run_env: ProofEnv;
            if (cur_env.reachable) {
                fin_run_env = cur_env;
                cur_env = env_unreachable(env_in.alloc);
            } or {
                fin_run_env = last_reachable;
                last_reachable = env_unreachable(env_in.alloc);
            }
            var fi: u32 = fin_stack.len;
            for (fi > 0) {
                fi = fi - 1;
                val fin_sid: id.StmtId = fin_stack.stmts[fi];
                var next_fin: ProofEnv;
                val rf: R.Result[R.Void, str] = analyze_stmt(sc, fin_sid, ?fin_run_env, ?next_fin, loop_ctx, validate);
                env_free(?fin_run_env);
                if (R.is_err[R.Void, str](rf)) {
                    env_free(?cur_env);
                    env_free(?last_reachable);
                    fin_stack_free(?fin_stack);
                    ret rf;
                }
                fin_run_env = next_fin;
            }
            if (!cur_env.reachable) {
                env_free(?fin_run_env);
            } or {
                cur_env = fin_run_env;
            }
        }
        env_free(?last_reachable);
        fin_stack_free(?fin_stack);
        @env_out = cur_env;
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_RET) {
        val r: *stmt.StmtRet = ?s.data.ret_;
        if (r.value != id.EXPR_NIL) {
            analyze_expr(sc, r.value, env_in, validate);
        }
        @env_out = env_unreachable(env_in.alloc);
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_BRK) {
        if (loop_ctx != nil) {
            loop_ctx_add_break(loop_ctx, env_in);
        }
        @env_out = env_unreachable(env_in.alloc);
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_CNT) {
        if (loop_ctx != nil) {
            loop_ctx_add_continue(loop_ctx, env_in);
        }
        @env_out = env_unreachable(env_in.alloc);
        ret R.ok_void[str]();
    }

    if (k == stmt.STMT_KIND_FIN) {
        val res_c: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
        if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
        @env_out = R.unwrap_ok[ProofEnv, str](res_c);
        ret R.ok_void[str]();
    }

    val res_c: R.Result[ProofEnv, str] = env_clone(env_in.alloc, env_in);
    if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
    @env_out = R.unwrap_ok[ProofEnv, str](res_c);
    ret R.ok_void[str]();
}

pub fun validate_body(sc: *context.SemaContext, body_sid: id.StmtId) R.Result[R.Void, str] {
    var entry_env: ProofEnv = env_init(sc.s.alloc);
    var exit_env: ProofEnv;
    var loop_ctx: LoopContext = loop_ctx_init(sc.s.alloc);
    val res: R.Result[R.Void, str] = analyze_stmt(sc, body_sid, ?entry_env, ?exit_env, ?loop_ctx, true);
    env_free(?entry_env);
    env_free(?exit_env);
    loop_ctx_free(?loop_ctx);
    ret res;
}
