use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.resolve;
use mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.type;
use mach.lang.fail;

pub rec Hooks {
    fn_ret: type.TypeId;
    branch: fun(*context.SemaContext, *decl.ComptimeBranch) R.Result[bool, str];
    each: fun(*context.SemaContext, *stmt.StmtComptimeEach, token.Span, context.StmtListVisitor, ptr, type.TypeId) R.Result[R.Void, str];
}

pub rec CaseSet {
    words:      *u64;
    word_count: u32;
}

pub fun caseset_alloc(alloc: *A.Allocator, word_count: u32) R.Result[CaseSet, str] {
    var count: u32 = word_count;
    if (count == 0) { count = 1; }
    val res: R.Result[*u64, str] = A.allocate[u64](alloc, count::usize);
    if (R.is_err[*u64, str](res)) { ret R.err[CaseSet, str](R.unwrap_err[*u64, str](res)); }
    val words: *u64 = R.unwrap_ok[*u64, str](res);
    var i: u32 = 0;
    for (i < count) {
        words[i] = 0u64;
        i = i + 1;
    }
    ret R.ok[CaseSet, str](CaseSet{ words: words, word_count: count });
}

pub fun caseset_free(alloc: *A.Allocator, cs: *CaseSet) {
    if (cs.words != nil && cs.word_count > 0) {
        A.deallocate[u64](alloc, cs.words, cs.word_count::usize);
        cs.words = nil;
        cs.word_count = 0;
    }
}

pub fun caseset_clone(alloc: *A.Allocator, src: CaseSet) R.Result[CaseSet, str] {
    val res: R.Result[CaseSet, str] = caseset_alloc(alloc, src.word_count);
    if (R.is_err[CaseSet, str](res)) { ret res; }
    var dst: CaseSet = R.unwrap_ok[CaseSet, str](res);
    var i: u32 = 0;
    for (i < src.word_count) {
        dst.words[i] = src.words[i];
        i = i + 1;
    }
    ret R.ok[CaseSet, str](dst);
}

pub fun caseset_set_all(cs: *CaseSet, total_cases: u32) {
    caseset_clear(cs);
    var i: u32 = 0;
    for (i < total_cases) {
        val word_idx: u32 = i / 64;
        val bit_idx:  u32 = i % 64;
        if (word_idx < cs.word_count) {
            cs.words[word_idx] = cs.words[word_idx] | (1u64 << bit_idx);
        }
        i = i + 1;
    }
}

pub fun caseset_clear(cs: *CaseSet) {
    var i: u32 = 0;
    for (i < cs.word_count) {
        cs.words[i] = 0u64;
        i = i + 1;
    }
}

pub fun caseset_set_single(cs: *CaseSet, case_idx: u32) {
    caseset_clear(cs);
    val word_idx: u32 = case_idx / 64;
    val bit_idx:  u32 = case_idx % 64;
    if (word_idx < cs.word_count) {
        cs.words[word_idx] = 1u64 << bit_idx;
    }
}

pub fun caseset_remove(cs: *CaseSet, case_idx: u32) {
    val word_idx: u32 = case_idx / 64;
    val bit_idx:  u32 = case_idx % 64;
    if (word_idx < cs.word_count) {
        cs.words[word_idx] = cs.words[word_idx] & ~(1u64 << bit_idx);
    }
}

pub fun caseset_has(cs: CaseSet, case_idx: u32) bool {
    val word_idx: u32 = case_idx / 64;
    val bit_idx:  u32 = case_idx % 64;
    if (word_idx >= cs.word_count) { ret false; }
    ret (cs.words[word_idx] & (1u64 << bit_idx)) != 0u64;
}

pub fun caseset_is_single(cs: CaseSet, case_idx: u32) bool {
    val target_word: u32 = case_idx / 64;
    if (target_word >= cs.word_count) { ret false; }
    val target_mask: u64 = 1u64 << (case_idx % 64);
    var i: u32 = 0;
    for (i < cs.word_count) {
        if (i == target_word) {
            if (cs.words[i] != target_mask) { ret false; }
        } or {
            if (cs.words[i] != 0u64) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

pub fun caseset_union(dst: *CaseSet, src: CaseSet) {
    var i: u32 = 0;
    val limit: u32 = dst.word_count;
    for (i < limit && i < src.word_count) {
        dst.words[i] = dst.words[i] | src.words[i];
        i = i + 1;
    }
}

pub fun caseset_intersect(dst: *CaseSet, src: CaseSet) {
    var i: u32 = 0;
    val limit: u32 = dst.word_count;
    for (i < limit && i < src.word_count) {
        dst.words[i] = dst.words[i] & src.words[i];
        i = i + 1;
    }
}

pub fun caseset_equals(a: CaseSet, b: CaseSet) bool {
    if (a.word_count != b.word_count) { ret false; }
    var i: u32 = 0;
    for (i < a.word_count) {
        if (a.words[i] != b.words[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun caseset_count(cs: CaseSet) u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    for (i < cs.word_count) {
        var w: u64 = cs.words[i];
        for (w != 0u64) {
            count = count + (w & 1u64)::u32;
            w = w >> 1;
        }
        i = i + 1;
    }
    ret count;
}

pub fun caseset_first_active(cs: CaseSet) O.Option[u32] {
    var i: u32 = 0;
    for (i < cs.word_count) {
        val w: u64 = cs.words[i];
        if (w != 0u64) {
            var b: u32 = 0;
            for (b < 64) {
                if ((w & (1u64 << b)) != 0u64) {
                    ret O.some[u32](i * 64 + b);
                }
                b = b + 1;
            }
        }
        i = i + 1;
    }
    ret O.none[u32]();
}

pub val ROOT_NONE:        u8 = 0;
pub val ROOT_LOCAL:       u8 = 1;
pub val ROOT_POINTEE:     u8 = 2;
pub val ROOT_ANY_POINTEE: u8 = 3;

pub rec StorageKey {
    root_kind:       u8;
    root_sym:        resolve.SymbolId;
    projections:     *intern.StrId;
    projections_len: u32;
    projections_cap: u32;
}

pub fun key_none() StorageKey {
    ret StorageKey{
        root_kind:       ROOT_NONE,
        root_sym:        resolve.SYMBOL_NIL,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_local(sym: resolve.SymbolId) StorageKey {
    ret StorageKey{
        root_kind:       ROOT_LOCAL,
        root_sym:        sym,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_pointee(sym: resolve.SymbolId) StorageKey {
    ret StorageKey{
        root_kind:       ROOT_POINTEE,
        root_sym:        sym,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_any_pointee() StorageKey {
    ret StorageKey{
        root_kind:       ROOT_ANY_POINTEE,
        root_sym:        resolve.SYMBOL_NIL,
        projections:     nil,
        projections_len: 0,
        projections_cap: 0,
    };
}

pub fun key_free(alloc: *A.Allocator, k: *StorageKey) {
    if (k.projections != nil && k.projections_cap > 0) {
        A.deallocate[intern.StrId](alloc, k.projections, k.projections_cap::usize);
        k.projections = nil;
        k.projections_len = 0;
        k.projections_cap = 0;
    }
}

pub fun key_clone(alloc: *A.Allocator, src: StorageKey) R.Result[StorageKey, str] {
    var k: StorageKey = src;
    if (src.projections != nil && src.projections_len > 0) {
        val res: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, src.projections_len::usize);
        if (R.is_err[*intern.StrId, str](res)) { ret R.err[StorageKey, str](R.unwrap_err[*intern.StrId, str](res)); }
        k.projections = R.unwrap_ok[*intern.StrId, str](res);
        k.projections_cap = src.projections_len;
        var i: u32 = 0;
        for (i < src.projections_len) {
            k.projections[i] = src.projections[i];
            i = i + 1;
        }
    } or {
        k.projections = nil;
        k.projections_len = 0;
        k.projections_cap = 0;
    }
    ret R.ok[StorageKey, str](k);
}

pub fun key_add_projection(alloc: *A.Allocator, k: *StorageKey, field: intern.StrId) R.Result[R.Void, str] {
    if (k.projections == nil) {
        val initial_cap: usize = 4;
        val res: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](alloc, initial_cap);
        if (R.is_err[*intern.StrId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](res)); }
        k.projections = R.unwrap_ok[*intern.StrId, str](res);
        k.projections_cap = initial_cap::u32;
        k.projections_len = 0;
    }
    if (k.projections_len >= k.projections_cap) {
        if (k.projections_cap > 2147483647) { ret R.err[R.Void, str]("case proof: storage capacity overflow"); }
        val new_cap: usize = (k.projections_cap * 2)::usize;
        val res: R.Result[*intern.StrId, str] = A.reallocate[intern.StrId](alloc, k.projections, k.projections_cap::usize, new_cap);
        if (R.is_err[*intern.StrId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](res)); }
        k.projections = R.unwrap_ok[*intern.StrId, str](res);
        k.projections_cap = new_cap::u32;
    }
    k.projections[k.projections_len] = field;
    k.projections_len = k.projections_len + 1;
    ret R.ok_void[str]();
}

pub fun key_equals(a: StorageKey, b: StorageKey) bool {
    if (a.root_kind != b.root_kind) { ret false; }
    if (a.root_sym != b.root_sym)   { ret false; }
    if (a.projections_len != b.projections_len) { ret false; }
    var i: u32 = 0;
    for (i < a.projections_len) {
        if (a.projections[i] != b.projections[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun key_is_prefix_of(prefix: StorageKey, candidate: StorageKey) bool {
    if (prefix.root_kind != candidate.root_kind) { ret false; }
    if (prefix.root_sym != candidate.root_sym)   { ret false; }
    if (prefix.projections_len > candidate.projections_len) { ret false; }
    var i: u32 = 0;
    for (i < prefix.projections_len) {
        if (prefix.projections[i] != candidate.projections[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub rec EscapeSet {
    syms: *resolve.SymbolId;
    len:  u32;
    cap:  u32;
}

pub fun escape_init() EscapeSet {
    ret EscapeSet{ syms: nil, len: 0, cap: 0 };
}

pub fun escape_free(alloc: *A.Allocator, es: *EscapeSet) {
    if (es.syms != nil && es.cap > 0) {
        A.deallocate[resolve.SymbolId](alloc, es.syms, es.cap::usize);
        es.syms = nil;
        es.len = 0;
        es.cap = 0;
    }
}

pub fun escape_clone(alloc: *A.Allocator, src: EscapeSet) R.Result[EscapeSet, str] {
    if (src.len == 0 || src.syms == nil) { ret R.ok[EscapeSet, str](escape_init()); }
    val res: R.Result[*resolve.SymbolId, str] = A.allocate[resolve.SymbolId](alloc, src.len::usize);
    if (R.is_err[*resolve.SymbolId, str](res)) { ret R.err[EscapeSet, str](R.unwrap_err[*resolve.SymbolId, str](res)); }
    val syms: *resolve.SymbolId = R.unwrap_ok[*resolve.SymbolId, str](res);
    var i: u32 = 0;
    for (i < src.len) {
        syms[i] = src.syms[i];
        i = i + 1;
    }
    ret R.ok[EscapeSet, str](EscapeSet{ syms: syms, len: src.len, cap: src.len });
}

pub fun escape_contains(es: EscapeSet, sym: resolve.SymbolId) bool {
    var i: u32 = 0;
    for (i < es.len) {
        if (es.syms[i] == sym) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun escape_add(alloc: *A.Allocator, es: *EscapeSet, sym: resolve.SymbolId) R.Result[R.Void, str] {
    if (sym == resolve.SYMBOL_NIL) { ret R.ok_void[str](); }
    if (escape_contains(@es, sym)) { ret R.ok_void[str](); }
    if (es.syms == nil) {
        val initial_cap: usize = 8;
        val res: R.Result[*resolve.SymbolId, str] = A.allocate[resolve.SymbolId](alloc, initial_cap);
        if (R.is_err[*resolve.SymbolId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*resolve.SymbolId, str](res)); }
        es.syms = R.unwrap_ok[*resolve.SymbolId, str](res);
        es.cap = initial_cap::u32;
        es.len = 0;
    }
    if (es.len >= es.cap) {
        if (es.cap > 2147483647) { ret R.err[R.Void, str]("case proof: storage capacity overflow"); }
        val new_cap: usize = (es.cap * 2)::usize;
        val res: R.Result[*resolve.SymbolId, str] = A.reallocate[resolve.SymbolId](alloc, es.syms, es.cap::usize, new_cap);
        if (R.is_err[*resolve.SymbolId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*resolve.SymbolId, str](res)); }
        es.syms = R.unwrap_ok[*resolve.SymbolId, str](res);
        es.cap = new_cap::u32;
    }
    es.syms[es.len] = sym;
    es.len = es.len + 1;
    ret R.ok_void[str]();
}

pub fun escape_union(alloc: *A.Allocator, dst: *EscapeSet, src: EscapeSet) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < src.len) {
        val res: R.Result[R.Void, str] = escape_add(alloc, dst, src.syms[i]);
        if (R.is_err[R.Void, str](res)) { ret res; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

pub fun escape_equals(a: EscapeSet, b: EscapeSet) bool {
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < a.len) {
        if (!escape_contains(b, a.syms[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub rec StorageFact {
    key:            StorageKey;
    tag_type:       type.TypeId;
    total_cases:    u32;
    possible_cases: CaseSet;
}

pub fun fact_free(alloc: *A.Allocator, f: *StorageFact) {
    key_free(alloc, ?f.key);
    caseset_free(alloc, ?f.possible_cases);
}

pub fun fact_clone(alloc: *A.Allocator, src: StorageFact) R.Result[StorageFact, str] {
    val rk: R.Result[StorageKey, str] = key_clone(alloc, src.key);
    if (R.is_err[StorageKey, str](rk)) { ret R.err[StorageFact, str](R.unwrap_err[StorageKey, str](rk)); }
    val rc: R.Result[CaseSet, str] = caseset_clone(alloc, src.possible_cases);
    if (R.is_err[CaseSet, str](rc)) {
        var k_tmp: StorageKey = R.unwrap_ok[StorageKey, str](rk);
        key_free(alloc, ?k_tmp);
        ret R.err[StorageFact, str](R.unwrap_err[CaseSet, str](rc));
    }
    ret R.ok[StorageFact, str](StorageFact{
        key:            R.unwrap_ok[StorageKey, str](rk),
        tag_type:       src.tag_type,
        total_cases:    src.total_cases,
        possible_cases: R.unwrap_ok[CaseSet, str](rc),
    });
}

pub rec ProofEnv {
    facts:     *StorageFact;
    facts_len: u32;
    facts_cap: u32;
    escapes:   EscapeSet;
    reachable: bool;
    alloc:     *A.Allocator;
}

pub fun env_init(alloc: *A.Allocator) ProofEnv {
    ret ProofEnv{
        facts:     nil,
        facts_len: 0,
        facts_cap: 0,
        escapes:   escape_init(),
        reachable: true,
        alloc:     alloc,
    };
}

pub fun env_unreachable(alloc: *A.Allocator) ProofEnv {
    var e: ProofEnv = env_init(alloc);
    e.reachable = false;
    ret e;
}

pub fun env_free(e: *ProofEnv) {
    if (e.facts != nil) {
        var i: u32 = 0;
        for (i < e.facts_len) {
            fact_free(e.alloc, ?e.facts[i]);
            i = i + 1;
        }
        if (e.facts_cap > 0) {
            A.deallocate[StorageFact](e.alloc, e.facts, e.facts_cap::usize);
        }
        e.facts = nil;
        e.facts_len = 0;
        e.facts_cap = 0;
    }
    escape_free(e.alloc, ?e.escapes);
}

pub fun env_clone(alloc: *A.Allocator, src: *ProofEnv) R.Result[ProofEnv, str] {
    var out: ProofEnv = env_init(alloc);
    out.reachable = src.reachable;
    val res_esc: R.Result[EscapeSet, str] = escape_clone(alloc, src.escapes);
    if (R.is_err[EscapeSet, str](res_esc)) { ret R.err[ProofEnv, str](R.unwrap_err[EscapeSet, str](res_esc)); }
    out.escapes = R.unwrap_ok[EscapeSet, str](res_esc);

    if (src.facts_len > 0) {
        val res_f: R.Result[*StorageFact, str] = A.allocate[StorageFact](alloc, src.facts_len::usize);
        if (R.is_err[*StorageFact, str](res_f)) {
            env_free(?out);
            ret R.err[ProofEnv, str](R.unwrap_err[*StorageFact, str](res_f));
        }
        out.facts = R.unwrap_ok[*StorageFact, str](res_f);
        out.facts_cap = src.facts_len;
        var i: u32 = 0;
        for (i < src.facts_len) {
            val res_clone: R.Result[StorageFact, str] = fact_clone(alloc, src.facts[i]);
            if (R.is_err[StorageFact, str](res_clone)) {
                out.facts_len = i;
                env_free(?out);
                ret R.err[ProofEnv, str](R.unwrap_err[StorageFact, str](res_clone));
            }
            out.facts[i] = R.unwrap_ok[StorageFact, str](res_clone);
            out.facts_len = i + 1;
            i = i + 1;
        }
    }
    ret R.ok[ProofEnv, str](out);
}

pub fun env_find_fact(e: *ProofEnv, key: StorageKey) O.Option[u32] {
    var i: u32 = 0;
    for (i < e.facts_len) {
        if (key_equals(e.facts[i].key, key)) {
            ret O.some[u32](i);
        }
        i = i + 1;
    }
    ret O.none[u32]();
}

pub fun env_remove_fact_at(e: *ProofEnv, idx: u32) {
    if (idx >= e.facts_len) { ret; }
    fact_free(e.alloc, ?e.facts[idx]);
    var i: u32 = idx;
    for (i + 1 < e.facts_len) {
        e.facts[i] = e.facts[i + 1];
        i = i + 1;
    }
    e.facts_len = e.facts_len - 1;
}

pub fun env_remove_prefix(e: *ProofEnv, prefix: StorageKey) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        if (key_is_prefix_of(prefix, e.facts[i].key)) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_remove_pointee_sym(e: *ProofEnv, ptr_sym: resolve.SymbolId) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        val k: StorageKey = e.facts[i].key;
        if (k.root_kind == ROOT_POINTEE && k.root_sym == ptr_sym) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_remove_all_pointees(e: *ProofEnv) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        val k: StorageKey = e.facts[i].key;
        if (k.root_kind == ROOT_POINTEE || k.root_kind == ROOT_ANY_POINTEE) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_remove_escaped_locals(e: *ProofEnv) {
    var i: u32 = 0;
    for (i < e.facts_len) {
        val k: StorageKey = e.facts[i].key;
        if (k.root_kind == ROOT_LOCAL && escape_contains(e.escapes, k.root_sym)) {
            env_remove_fact_at(e, i);
        } or {
            i = i + 1;
        }
    }
}

pub fun env_invalidate_calls(e: *ProofEnv) {
    env_remove_all_pointees(e);
    env_remove_escaped_locals(e);
}

pub fun env_set_fact_caseset(e: *ProofEnv, key: StorageKey, tag_type: type.TypeId, total_cases: u32, cs: CaseSet) R.Result[R.Void, str] {
    if (key.root_kind == ROOT_NONE || key.root_kind == ROOT_ANY_POINTEE) {
        var cs_tmp: CaseSet = cs;
        caseset_free(e.alloc, ?cs_tmp);
        ret R.ok_void[str]();
    }
    val opt_idx: O.Option[u32] = env_find_fact(e, key);
    if (O.is_some[u32](opt_idx)) {
        val idx: u32 = O.unwrap[u32](opt_idx);
        e.facts[idx].tag_type = tag_type;
        e.facts[idx].total_cases = total_cases;
        caseset_free(e.alloc, ?e.facts[idx].possible_cases);
        e.facts[idx].possible_cases = cs;
        ret R.ok_void[str]();
    }

    val res_key: R.Result[StorageKey, str] = key_clone(e.alloc, key);
    if (R.is_err[StorageKey, str](res_key)) {
        var cs_tmp: CaseSet = cs;
        caseset_free(e.alloc, ?cs_tmp);
        ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](res_key));
    }
    val owned_key: StorageKey = R.unwrap_ok[StorageKey, str](res_key);

    if (e.facts == nil) {
        val initial_cap: usize = 16;
        val res_arr: R.Result[*StorageFact, str] = A.allocate[StorageFact](e.alloc, initial_cap);
        if (R.is_err[*StorageFact, str](res_arr)) {
            var k_tmp: StorageKey = owned_key;
            key_free(e.alloc, ?k_tmp);
            var cs_tmp: CaseSet = cs;
            caseset_free(e.alloc, ?cs_tmp);
            ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
        }
        e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
        e.facts_cap = initial_cap::u32;
        e.facts_len = 0;
    }
    if (e.facts_len >= e.facts_cap) {
        if (e.facts_cap > 2147483647) {
            var k_tmp: StorageKey = owned_key;
            var cs_tmp: CaseSet = cs;
            key_free(e.alloc, ?k_tmp);
            caseset_free(e.alloc, ?cs_tmp);
            ret R.err[R.Void, str]("case proof: storage capacity overflow");
        }
        val new_cap: usize = (e.facts_cap * 2)::usize;
        val res_arr: R.Result[*StorageFact, str] = A.reallocate[StorageFact](e.alloc, e.facts, e.facts_cap::usize, new_cap);
        if (R.is_err[*StorageFact, str](res_arr)) {
            var k_tmp: StorageKey = owned_key;
            key_free(e.alloc, ?k_tmp);
            var cs_tmp: CaseSet = cs;
            caseset_free(e.alloc, ?cs_tmp);
            ret R.err[R.Void, str](R.unwrap_err[*StorageFact, str](res_arr));
        }
        e.facts = R.unwrap_ok[*StorageFact, str](res_arr);
        e.facts_cap = new_cap::u32;
    }
    e.facts[e.facts_len] = StorageFact{
        key:            owned_key,
        tag_type:       tag_type,
        total_cases:    total_cases,
        possible_cases: cs,
    };
    e.facts_len = e.facts_len + 1;
    ret R.ok_void[str]();
}

pub fun env_set_fact_case(e: *ProofEnv, key: StorageKey, tag_type: type.TypeId, total_cases: u32, case_idx: u32) R.Result[R.Void, str] {
    if (key.root_kind == ROOT_NONE || key.root_kind == ROOT_ANY_POINTEE) { ret R.ok_void[str](); }
    val words_needed: u32 = total_cases / 64 + ((total_cases % 64 + 63) / 64);
    val res_cs: R.Result[CaseSet, str] = caseset_alloc(e.alloc, words_needed);
    if (R.is_err[CaseSet, str](res_cs)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](res_cs)); }
    var cs: CaseSet = R.unwrap_ok[CaseSet, str](res_cs);
    caseset_set_single(?cs, case_idx);
    ret env_set_fact_caseset(e, key, tag_type, total_cases, cs);
}

pub fun env_remove_case(e: *ProofEnv, key: StorageKey, tag_type: type.TypeId, total_cases: u32, case_idx: u32) R.Result[R.Void, str] {
    if (key.root_kind == ROOT_NONE || key.root_kind == ROOT_ANY_POINTEE) { ret R.ok_void[str](); }
    val opt_f: O.Option[u32] = env_find_fact(e, key);
    if (O.is_some[u32](opt_f)) {
        val f_idx: u32 = O.unwrap[u32](opt_f);
        caseset_remove(?e.facts[f_idx].possible_cases, case_idx);
        if (caseset_count(e.facts[f_idx].possible_cases) == 0) { e.reachable = false; }
        ret R.ok_void[str]();
    }
    val words_needed: u32 = total_cases / 64 + ((total_cases % 64 + 63) / 64);
    val res_cs: R.Result[CaseSet, str] = caseset_alloc(e.alloc, words_needed);
    if (R.is_err[CaseSet, str](res_cs)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](res_cs)); }
    var cs: CaseSet = R.unwrap_ok[CaseSet, str](res_cs);
    caseset_set_all(?cs, total_cases);
    caseset_remove(?cs, case_idx);
    if (caseset_count(cs) == 0) { e.reachable = false; }
    ret env_set_fact_caseset(e, key, tag_type, total_cases, cs);
}

pub fun env_transfer_fact(e: *ProofEnv, dst: StorageKey, src: StorageKey, tag_type: type.TypeId, total_cases: u32) R.Result[R.Void, str] {
    val found: O.Option[u32] = env_find_fact(e, src);
    if (O.is_some[u32](found)) {
        val copied: R.Result[CaseSet, str] = caseset_clone(e.alloc, e.facts[O.unwrap[u32](found)].possible_cases);
        if (R.is_err[CaseSet, str](copied)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](copied)); }
        ret env_set_fact_caseset(e, dst, tag_type, total_cases, R.unwrap_ok[CaseSet, str](copied));
    }
    env_remove_prefix(e, dst);
    ret R.ok_void[str]();
}

pub fun env_equals(a: *ProofEnv, b: *ProofEnv) bool {
    if (a.reachable != b.reachable) { ret false; }
    if (!a.reachable)               { ret true; }
    if (!escape_equals(a.escapes, b.escapes)) { ret false; }
    if (a.facts_len != b.facts_len) { ret false; }
    var i: u32 = 0;
    for (i < a.facts_len) {
        val opt_b: O.Option[u32] = env_find_fact(b, a.facts[i].key);
        if (O.is_none[u32](opt_b)) { ret false; }
        val b_idx: u32 = O.unwrap[u32](opt_b);
        if (a.facts[i].tag_type != b.facts[b_idx].tag_type) { ret false; }
        if (!caseset_equals(a.facts[i].possible_cases, b.facts[b_idx].possible_cases)) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun env_join(alloc: *A.Allocator, a: *ProofEnv, b: *ProofEnv) R.Result[ProofEnv, str] {
    if (!a.reachable && !b.reachable) { ret R.ok[ProofEnv, str](env_unreachable(alloc)); }
    if (!a.reachable)                 { ret env_clone(alloc, b); }
    if (!b.reachable)                 { ret env_clone(alloc, a); }

    var out: ProofEnv = env_init(alloc);
    val res_esc_a: R.Result[EscapeSet, str] = escape_clone(alloc, a.escapes);
    if (R.is_err[EscapeSet, str](res_esc_a)) { ret R.err[ProofEnv, str](R.unwrap_err[EscapeSet, str](res_esc_a)); }
    out.escapes = R.unwrap_ok[EscapeSet, str](res_esc_a);
    val res_u: R.Result[R.Void, str] = escape_union(alloc, ?out.escapes, b.escapes);
    if (R.is_err[R.Void, str](res_u)) {
        env_free(?out);
        ret R.err[ProofEnv, str](R.unwrap_err[R.Void, str](res_u));
    }

    var i: u32 = 0;
    for (i < a.facts_len) {
        val opt_b: O.Option[u32] = env_find_fact(b, a.facts[i].key);
        if (O.is_some[u32](opt_b)) {
            val b_idx: u32 = O.unwrap[u32](opt_b);
            if (a.facts[i].tag_type == b.facts[b_idx].tag_type) {
                val res_cs: R.Result[CaseSet, str] = caseset_clone(alloc, a.facts[i].possible_cases);
                if (R.is_err[CaseSet, str](res_cs)) {
                    env_free(?out);
                    ret R.err[ProofEnv, str](R.unwrap_err[CaseSet, str](res_cs));
                }
                var joined_cs: CaseSet = R.unwrap_ok[CaseSet, str](res_cs);
                caseset_union(?joined_cs, b.facts[b_idx].possible_cases);

                val added: R.Result[R.Void, str] = env_set_fact_caseset(?out, a.facts[i].key,
                    a.facts[i].tag_type, a.facts[i].total_cases, joined_cs);
                if (R.is_err[R.Void, str](added)) {
                    env_free(?out);
                    ret R.err[ProofEnv, str](R.unwrap_err[R.Void, str](added));
                }
            }
        }
        i = i + 1;
    }
    ret R.ok[ProofEnv, str](out);
}

pub fun is_case_proven(env: *ProofEnv, key: StorageKey, tag_type: type.TypeId, case_idx: u32) bool {
    if (!env.reachable)             { ret true; }
    if (key.root_kind == ROOT_NONE || key.root_kind == ROOT_ANY_POINTEE) { ret false; }
    val opt_idx: O.Option[u32] = env_find_fact(env, key);
    if (O.is_none[u32](opt_idx))    { ret false; }
    val idx: u32 = O.unwrap[u32](opt_idx);
    ret env.facts[idx].tag_type == tag_type && caseset_is_single(env.facts[idx].possible_cases, case_idx);
}

pub rec LoopContext {
    fin_depth: u32;
    breaks:        *ProofEnv;
    breaks_len:    u32;
    breaks_cap:    u32;
    continues:     *ProofEnv;
    continues_len: u32;
    continues_cap: u32;
    alloc:         *A.Allocator;
}

pub fun loop_ctx_init(alloc: *A.Allocator) LoopContext {
    ret LoopContext{
        breaks:        nil,
        breaks_len:    0,
        breaks_cap:    0,
        continues:     nil,
        continues_len: 0,
        continues_cap: 0,
        alloc:         alloc,
    };
}

pub fun loop_ctx_reset(lc: *LoopContext) {
    if (lc.breaks != nil) {
        var i: u32 = 0;
        for (i < lc.breaks_len) {
            env_free(?lc.breaks[i]);
            i = i + 1;
        }
        lc.breaks_len = 0;
    }
    if (lc.continues != nil) {
        var i: u32 = 0;
        for (i < lc.continues_len) {
            env_free(?lc.continues[i]);
            i = i + 1;
        }
        lc.continues_len = 0;
    }
}

pub fun loop_ctx_free(lc: *LoopContext) {
    loop_ctx_reset(lc);
    if (lc.breaks != nil && lc.breaks_cap > 0) {
        A.deallocate[ProofEnv](lc.alloc, lc.breaks, lc.breaks_cap::usize);
        lc.breaks = nil;
        lc.breaks_cap = 0;
    }
    if (lc.continues != nil && lc.continues_cap > 0) {
        A.deallocate[ProofEnv](lc.alloc, lc.continues, lc.continues_cap::usize);
        lc.continues = nil;
        lc.continues_cap = 0;
    }
}

pub fun loop_ctx_add_break(lc: *LoopContext, env: *ProofEnv) R.Result[R.Void, str] {
    if (!env.reachable) { ret R.ok_void[str](); }
    if (lc.breaks == nil) {
        val initial_cap: usize = 8;
        val res: R.Result[*ProofEnv, str] = A.allocate[ProofEnv](lc.alloc, initial_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.breaks = R.unwrap_ok[*ProofEnv, str](res);
        lc.breaks_cap = initial_cap::u32;
        lc.breaks_len = 0;
    }
    if (lc.breaks_len >= lc.breaks_cap) {
        if (lc.breaks_cap > 2147483647) { ret R.err[R.Void, str]("case proof: storage capacity overflow"); }
        val new_cap: usize = (lc.breaks_cap * 2)::usize;
        val res: R.Result[*ProofEnv, str] = A.reallocate[ProofEnv](lc.alloc, lc.breaks, lc.breaks_cap::usize, new_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.breaks = R.unwrap_ok[*ProofEnv, str](res);
        lc.breaks_cap = new_cap::u32;
    }
    val res_c: R.Result[ProofEnv, str] = env_clone(lc.alloc, env);
    if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
    lc.breaks[lc.breaks_len] = R.unwrap_ok[ProofEnv, str](res_c);
    lc.breaks_len = lc.breaks_len + 1;
    ret R.ok_void[str]();
}

pub fun loop_ctx_add_continue(lc: *LoopContext, env: *ProofEnv) R.Result[R.Void, str] {
    if (!env.reachable) { ret R.ok_void[str](); }
    if (lc.continues == nil) {
        val initial_cap: usize = 8;
        val res: R.Result[*ProofEnv, str] = A.allocate[ProofEnv](lc.alloc, initial_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.continues = R.unwrap_ok[*ProofEnv, str](res);
        lc.continues_cap = initial_cap::u32;
        lc.continues_len = 0;
    }
    if (lc.continues_len >= lc.continues_cap) {
        if (lc.continues_cap > 2147483647) { ret R.err[R.Void, str]("case proof: storage capacity overflow"); }
        val new_cap: usize = (lc.continues_cap * 2)::usize;
        val res: R.Result[*ProofEnv, str] = A.reallocate[ProofEnv](lc.alloc, lc.continues, lc.continues_cap::usize, new_cap);
        if (R.is_err[*ProofEnv, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*ProofEnv, str](res)); }
        lc.continues = R.unwrap_ok[*ProofEnv, str](res);
        lc.continues_cap = new_cap::u32;
    }
    val res_c: R.Result[ProofEnv, str] = env_clone(lc.alloc, env);
    if (R.is_err[ProofEnv, str](res_c)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](res_c)); }
    lc.continues[lc.continues_len] = R.unwrap_ok[ProofEnv, str](res_c);
    lc.continues_len = lc.continues_len + 1;
    ret R.ok_void[str]();
}

pub fun loop_ctx_join_breaks(lc: *LoopContext) R.Result[ProofEnv, str] {
    if (lc.breaks_len == 0) { ret R.ok[ProofEnv, str](env_unreachable(lc.alloc)); }
    var acc: ProofEnv;
    val res_0: R.Result[ProofEnv, str] = env_clone(lc.alloc, ?lc.breaks[0]);
    if (R.is_err[ProofEnv, str](res_0)) { ret res_0; }
    acc = R.unwrap_ok[ProofEnv, str](res_0);
    var i: u32 = 1;
    for (i < lc.breaks_len) {
        val res_j: R.Result[ProofEnv, str] = env_join(lc.alloc, ?acc, ?lc.breaks[i]);
        env_free(?acc);
        if (R.is_err[ProofEnv, str](res_j)) { ret res_j; }
        acc = R.unwrap_ok[ProofEnv, str](res_j);
        i = i + 1;
    }
    ret R.ok[ProofEnv, str](acc);
}

pub fun loop_ctx_join_continues(lc: *LoopContext) R.Result[ProofEnv, str] {
    if (lc.continues_len == 0) { ret R.ok[ProofEnv, str](env_unreachable(lc.alloc)); }
    var acc: ProofEnv;
    val res_0: R.Result[ProofEnv, str] = env_clone(lc.alloc, ?lc.continues[0]);
    if (R.is_err[ProofEnv, str](res_0)) { ret res_0; }
    acc = R.unwrap_ok[ProofEnv, str](res_0);
    var i: u32 = 1;
    for (i < lc.continues_len) {
        val res_j: R.Result[ProofEnv, str] = env_join(lc.alloc, ?acc, ?lc.continues[i]);
        env_free(?acc);
        if (R.is_err[ProofEnv, str](res_j)) { ret res_j; }
        acc = R.unwrap_ok[ProofEnv, str](res_j);
        i = i + 1;
    }
    ret R.ok[ProofEnv, str](acc);
}

pub rec FinStack {
    hooks: Hooks;
    stmts: *id.StmtId;
    len:   u32;
    cap:   u32;
    alloc: *A.Allocator;
}

pub fun fin_stack_init(alloc: *A.Allocator) FinStack {
    ret FinStack{ stmts: nil, len: 0, cap: 0, alloc: alloc };
}

pub fun fin_stack_free(fs: *FinStack) {
    if (fs.stmts != nil && fs.cap > 0) {
        A.deallocate[id.StmtId](fs.alloc, fs.stmts, fs.cap::usize);
        fs.stmts = nil;
        fs.len = 0;
        fs.cap = 0;
    }
}

pub fun fin_stack_push(fs: *FinStack, sid: id.StmtId) R.Result[R.Void, str] {
    if (fs.stmts == nil) {
        val initial_cap: usize = 4;
        val res: R.Result[*id.StmtId, str] = A.allocate[id.StmtId](fs.alloc, initial_cap);
        if (R.is_err[*id.StmtId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*id.StmtId, str](res)); }
        fs.stmts = R.unwrap_ok[*id.StmtId, str](res);
        fs.cap = initial_cap::u32;
        fs.len = 0;
    }
    if (fs.len >= fs.cap) {
        if (fs.cap > 2147483647) { ret R.err[R.Void, str]("case proof: storage capacity overflow"); }
        val new_cap: usize = (fs.cap * 2)::usize;
        val res: R.Result[*id.StmtId, str] = A.reallocate[id.StmtId](fs.alloc, fs.stmts, fs.cap::usize, new_cap);
        if (R.is_err[*id.StmtId, str](res)) { ret R.err[R.Void, str](R.unwrap_err[*id.StmtId, str](res)); }
        fs.stmts = R.unwrap_ok[*id.StmtId, str](res);
        fs.cap = new_cap::u32;
    }
    fs.stmts[fs.len] = sid;
    fs.len = fs.len + 1;
    ret R.ok_void[str]();
}

fun symbol_id_for_expr(sc: *context.SemaContext, eid: id.ExprId) O.Option[resolve.SymbolId] {
    if (sc.rr == nil || sc.rr.expr_resolved == nil || eid >= sc.rr.expr_count) {
        ret O.none[resolve.SymbolId]();
    }
    val sid: resolve.SymbolId = sc.rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid == resolve.SYMBOL_REJECTED) {
        ret O.none[resolve.SymbolId]();
    }
    ret O.some[resolve.SymbolId](sid);
}

pub fun storage_of_expr(sc: *context.SemaContext, alloc: *A.Allocator, eid: id.ExprId) R.Result[StorageKey, str] {
    if (eid == id.EXPR_NIL) { ret R.ok[StorageKey, str](key_none()); }
    val er: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](er)) { ret R.err[StorageKey, str](R.unwrap_err[expr.Expr, str](er)); }
    val e: expr.Expr = R.unwrap_ok[expr.Expr, str](er);
    if (e.kind == expr.EXPR_KIND_IDENT || e.kind == expr.EXPR_KIND_MEMBER) {
        val sym: O.Option[resolve.SymbolId] = symbol_id_for_expr(sc, eid);
        if (O.is_some[resolve.SymbolId](sym)) {
            val sid: resolve.SymbolId = O.unwrap[resolve.SymbolId](sym);
            var key: StorageKey = key_local(sid);
            val symbol: resolve.Symbol = sc.rr.symbols[sid];
            if ((symbol.flags & resolve.SYM_FLAG_MODULE) != 0 || symbol.origin != sc.own_module) {
                key.root_kind = ROOT_POINTEE;
            }
            ret R.ok[StorageKey, str](key);
        }
        if (e.kind == expr.EXPR_KIND_IDENT) { ret R.ok[StorageKey, str](key_none()); }
    }
    var child: id.ExprId = id.EXPR_NIL;
    var deref: bool = false;
    var field: intern.StrId = intern.STR_NIL;
    if (e.kind == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_DEREF) {
        child = e.data.unary.operand;
        deref = true;
    } or (e.kind == expr.EXPR_KIND_MEMBER) {
        child = e.data.member.object;
        val nr: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, e.data.member.name);
        if (R.is_err[intern.StrId, str](nr)) { ret R.err[StorageKey, str](R.unwrap_err[intern.StrId, str](nr)); }
        field = R.unwrap_ok[intern.StrId, str](nr);
        var owner: type.TypeId = type.strip_secret(?sc.s.types, sc.expr_type[child]);
        deref = type.is_pointer(?sc.s.types, owner);
        if (deref) { owner = type.strip_secret(?sc.s.types, type.deref_one(?sc.s.types, owner)); }
        if (type.is_union(?sc.s.types, owner)) {
            ret R.ok[StorageKey, str](key_any_pointee());
        }
    } or {
        ret R.ok[StorageKey, str](key_any_pointee());
    }
    val kr: R.Result[StorageKey, str] = storage_of_expr(sc, alloc, child);
    if (R.is_err[StorageKey, str](kr)) { ret kr; }
    var key: StorageKey = R.unwrap_ok[StorageKey, str](kr);
    if (key.root_kind == ROOT_NONE || key.root_kind == ROOT_ANY_POINTEE) { ret R.ok[StorageKey, str](key); }
    if (deref) {
        key.root_kind = ROOT_POINTEE;
        val ar: R.Result[R.Void, str] = key_add_projection(alloc, ?key, intern.STR_NIL);
        if (R.is_err[R.Void, str](ar)) { key_free(alloc, ?key); ret R.err[StorageKey, str](R.unwrap_err[R.Void, str](ar)); }
    }
    if (field != intern.STR_NIL) {
        val ar: R.Result[R.Void, str] = key_add_projection(alloc, ?key, field);
        if (R.is_err[R.Void, str](ar)) { key_free(alloc, ?key); ret R.err[StorageKey, str](R.unwrap_err[R.Void, str](ar)); }
    }
    ret R.ok[StorageKey, str](key);
}

pub fun tag_storage_of_object(sc: *context.SemaContext, alloc: *A.Allocator, eid: id.ExprId) R.Result[StorageKey, str] {
    val kr: R.Result[StorageKey, str] = storage_of_expr(sc, alloc, eid);
    if (R.is_err[StorageKey, str](kr)) { ret kr; }
    var key: StorageKey = R.unwrap_ok[StorageKey, str](kr);
    if (key.root_kind != ROOT_NONE && key.root_kind != ROOT_ANY_POINTEE
        && type.is_pointer(?sc.s.types, type.strip_secret(?sc.s.types, sc.expr_type[eid]))) {
        key.root_kind = ROOT_POINTEE;
        val ar: R.Result[R.Void, str] = key_add_projection(alloc, ?key, intern.STR_NIL);
        if (R.is_err[R.Void, str](ar)) { key_free(alloc, ?key); ret R.err[StorageKey, str](R.unwrap_err[R.Void, str](ar)); }
    }
    ret R.ok[StorageKey, str](key);
}

pub fun tag_lit_case_index(sc: *context.SemaContext, eid: id.ExprId, tag_type: type.TypeId) O.Option[u32] {
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret O.none[u32](); }
    val e_opt: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](e_opt)) { ret O.none[u32](); }
    var ev: expr.Expr = R.unwrap_ok[expr.Expr, str](e_opt);
    val e: *expr.Expr = ?ev;
    if (e.kind != expr.EXPR_KIND_STRUCT_LIT) { ret O.none[u32](); }
    val sl: *expr.ExprStructLit = ?e.data.struct_lit;
    if (sl.fields_len != 1) { ret O.none[u32](); }
    val selected: *expr.FieldInit = ?sc.a.field_inits[sl.fields_start];
    val ft_opt: O.Option[*type.FieldTable] = context.field_table_for(sc, tag_type);
    if (O.is_none[*type.FieldTable](ft_opt)) { ret O.none[u32](); }
    val ft: *type.FieldTable = O.unwrap[*type.FieldTable](ft_opt);
    var i: u32 = 0;
    for (i < ft.fields_len) {
        val fe: *type.FieldEntry = type.field_entry_at(?sc.s.types, ft, i);
        val name: O.Option[str] = intern.lookup(?sc.s.interner, fe.name);
        if (O.is_some[str](name) && str_region_equals(sc.source, selected.name.offset, selected.name.len, O.unwrap[str](name))) {
            ret O.some[u32](i);
        }
        i = i + 1;
    }
    ret O.none[u32]();
}

fun env_take(e: *ProofEnv) ProofEnv {
    val owned: ProofEnv = @e;
    @e = env_unreachable(e.alloc);
    ret owned;
}

fun env_copy_into(dst: *ProofEnv, src: *ProofEnv) R.Result[R.Void, str] {
    val copied: R.Result[ProofEnv, str] = env_clone(src.alloc, src);
    if (R.is_err[ProofEnv, str](copied)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](copied)); }
    env_free(dst);
    @dst = R.unwrap_ok[ProofEnv, str](copied);
    ret R.ok_void[str]();
}

fun env_join_into(dst: *ProofEnv, a: *ProofEnv, b: *ProofEnv) R.Result[R.Void, str] {
    val joined: R.Result[ProofEnv, str] = env_join(a.alloc, a, b);
    if (R.is_err[ProofEnv, str](joined)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](joined)); }
    env_free(dst);
    @dst = R.unwrap_ok[ProofEnv, str](joined);
    ret R.ok_void[str]();
}

fun assume_case(env: *ProofEnv, key: StorageKey, tag: type.TypeId, count: u32, selected: u32) R.Result[R.Void, str] {
    if (key.root_kind == ROOT_NONE || key.root_kind == ROOT_ANY_POINTEE) { ret R.ok_void[str](); }
    val found: O.Option[u32] = env_find_fact(env, key);
    if (O.is_some[u32](found) && !caseset_has(env.facts[O.unwrap[u32](found)].possible_cases, selected)) {
        env.reachable = false;
        ret R.ok_void[str]();
    }
    ret env_set_fact_case(env, key, tag, count, selected);
}

pub fun refine_condition(sc: *context.SemaContext, eid: id.ExprId, env: *ProofEnv,
                         yes: *ProofEnv, no: *ProofEnv, validate: bool) R.Result[R.Void, str] {
    if (!env.reachable) { ret R.ok_void[str](); }
    if (eid == id.EXPR_NIL) { ret env_copy_into(yes, env); }
    val er: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](er)) { ret R.err[R.Void, str](R.unwrap_err[expr.Expr, str](er)); }
    val e: expr.Expr = R.unwrap_ok[expr.Expr, str](er);
    if (e.kind == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_NOT) {
        ret refine_condition(sc, e.data.unary.operand, env, no, yes, validate);
    }
    if (e.kind == expr.EXPR_KIND_BINARY) {
        val b: expr.ExprBinary = e.data.binary;
        if (b.op == expr.BIN_AND || b.op == expr.BIN_OR) {
            var ly: ProofEnv = env_unreachable(env.alloc);
            var ln: ProofEnv = env_unreachable(env.alloc);
            var ry: ProofEnv = env_unreachable(env.alloc);
            var rn: ProofEnv = env_unreachable(env.alloc);
            fin { env_free(?ly); env_free(?ln); env_free(?ry); env_free(?rn); }
            val l: R.Result[R.Void, str] = refine_condition(sc, b.lhs, env, ?ly, ?ln, validate);
            if (R.is_err[R.Void, str](l)) { ret l; }
            var incoming: *ProofEnv = ?ly;
            if (b.op == expr.BIN_OR) { incoming = ?ln; }
            val r: R.Result[R.Void, str] = refine_condition(sc, b.rhs, incoming, ?ry, ?rn, validate);
            if (R.is_err[R.Void, str](r)) { ret r; }
            if (b.op == expr.BIN_AND) {
                @yes = env_take(?ry);
                ret env_join_into(no, ?ln, ?rn);
            }
            @no = env_take(?rn);
            ret env_join_into(yes, ?ly, ?ry);
        }
    }
    var evaluated: ProofEnv = env_unreachable(env.alloc);
    fin { env_free(?evaluated); }
    val copied: R.Result[R.Void, str] = env_copy_into(?evaluated, env);
    if (R.is_err[R.Void, str](copied)) { ret copied; }
    val visited: R.Result[R.Void, str] = analyze_expr(sc, eid, ?evaluated, validate);
    if (R.is_err[R.Void, str](visited)) { ret visited; }
    val cy: R.Result[R.Void, str] = env_copy_into(yes, ?evaluated);
    if (R.is_err[R.Void, str](cy)) { ret cy; }
    val cn: R.Result[R.Void, str] = env_copy_into(no, ?evaluated);
    if (R.is_err[R.Void, str](cn)) { ret cn; }
    if (e.kind != expr.EXPR_KIND_BINARY) { ret R.ok_void[str](); }
    val b: expr.ExprBinary = e.data.binary;
    if (b.op != expr.BIN_EQ && b.op != expr.BIN_NEQ) { ret R.ok_void[str](); }
    var selector: type.TypeId = sc.expr_type[b.rhs];
    var object: id.ExprId = b.lhs;
    if (type.is_case_selector(?sc.s.types, sc.expr_type[b.lhs])) {
        selector = sc.expr_type[b.lhs];
        object = b.rhs;
    }
    if (!type.is_case_selector(?sc.s.types, selector)) { ret R.ok_void[str](); }
    val tag: type.TypeId = type.case_selector_tag_type(?sc.s.types, selector);
    val selected: u32 = type.case_selector_case_index(?sc.s.types, selector);
    val kr: R.Result[StorageKey, str] = storage_of_expr(sc, env.alloc, object);
    if (R.is_err[StorageKey, str](kr)) { ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](kr)); }
    var key: StorageKey = R.unwrap_ok[StorageKey, str](kr);
    fin { key_free(env.alloc, ?key); }
    var matched: *ProofEnv = yes;
    var excluded: *ProofEnv = no;
    if (b.op == expr.BIN_NEQ) { matched = no; excluded = yes; }
    val ar: R.Result[R.Void, str] = assume_case(matched, key, tag, type.field_count(?sc.s.types, tag), selected);
    if (R.is_err[R.Void, str](ar)) { ret ar; }
    ret env_remove_case(excluded, key, tag, type.field_count(?sc.s.types, tag), selected);
}

fun analyze_list(sc: *context.SemaContext, start: u32, count: u32, env: *ProofEnv, validate: bool) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < count) {
        val r: R.Result[R.Void, str] = analyze_expr(sc, sc.a.expr_ids[start + i], env, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun assign_fact(sc: *context.SemaContext, eid: id.ExprId, key: StorageKey, ty: type.TypeId, env: *ProofEnv) R.Result[R.Void, str] {
    val tag: type.TypeId = type.strip_secret(?sc.s.types, ty);
    if (!type.is_tag(?sc.s.types, tag)) { ret R.ok_void[str](); }
    val count: u32 = type.field_count(?sc.s.types, tag);
    if (eid == id.EXPR_NIL) { ret env_set_fact_case(env, key, tag, count, 0); }
    val selected: O.Option[u32] = tag_lit_case_index(sc, eid, tag);
    if (O.is_some[u32](selected)) { ret env_set_fact_case(env, key, tag, count, O.unwrap[u32](selected)); }
    val kr: R.Result[StorageKey, str] = storage_of_expr(sc, env.alloc, eid);
    if (R.is_err[StorageKey, str](kr)) { ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](kr)); }
    var src: StorageKey = R.unwrap_ok[StorageKey, str](kr);
    fin { key_free(env.alloc, ?src); }
    ret env_transfer_fact(env, key, src, tag, count);
}

pub fun analyze_expr(sc: *context.SemaContext, eid: id.ExprId, env: *ProofEnv, validate: bool) R.Result[R.Void, str] {
    if (!env.reachable || eid == id.EXPR_NIL) { ret R.ok_void[str](); }
    val er: R.Result[expr.Expr, str] = context.expression(sc, eid);
    if (R.is_err[expr.Expr, str](er)) { ret R.err[R.Void, str](R.unwrap_err[expr.Expr, str](er)); }
    val e: expr.Expr = R.unwrap_ok[expr.Expr, str](er);
    val k: expr.ExprKind = e.kind;
    if (k == expr.EXPR_KIND_CALL || k == expr.EXPR_KIND_GENERIC_INSTANCE) {
        val cr: R.Result[R.Void, str] = analyze_expr(sc, e.data.call.callee, env, validate);
        if (R.is_err[R.Void, str](cr)) { ret cr; }
        val ar: R.Result[R.Void, str] = analyze_list(sc, e.data.call.args_start, e.data.call.args_len, env, validate);
        if (R.is_err[R.Void, str](ar)) { ret ar; }
        if (k == expr.EXPR_KIND_CALL) { env_invalidate_calls(env); }
        ret R.ok_void[str]();
    }
    if (k == expr.EXPR_KIND_BINARY) {
        val b: expr.ExprBinary = e.data.binary;
        if (b.op == expr.BIN_AND || b.op == expr.BIN_OR) {
            var yes: ProofEnv = env_unreachable(env.alloc);
            var no: ProofEnv = env_unreachable(env.alloc);
            fin { env_free(?yes); env_free(?no); }
            val r: R.Result[R.Void, str] = refine_condition(sc, eid, env, ?yes, ?no, validate);
            if (R.is_err[R.Void, str](r)) { ret r; }
            ret env_join_into(env, ?yes, ?no);
        }
        if (b.op == expr.BIN_ASSIGN) {
            val rr: R.Result[R.Void, str] = analyze_expr(sc, b.rhs, env, validate);
            if (R.is_err[R.Void, str](rr)) { ret rr; }
            val kr: R.Result[StorageKey, str] = storage_of_expr(sc, env.alloc, b.lhs);
            if (R.is_err[StorageKey, str](kr)) { ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](kr)); }
            var key: StorageKey = R.unwrap_ok[StorageKey, str](kr);
            fin { key_free(env.alloc, ?key); }
            var value: ProofEnv = env_unreachable(env.alloc);
            fin { env_free(?value); }
            val copied: R.Result[R.Void, str] = env_copy_into(?value, env);
            if (R.is_err[R.Void, str](copied)) { ret copied; }
            val assigned: R.Result[R.Void, str] = assign_fact(sc, b.rhs, key, sc.expr_type[b.lhs], ?value);
            if (R.is_err[R.Void, str](assigned)) { ret assigned; }
            val lr: R.Result[R.Void, str] = analyze_expr(sc, b.lhs, env, validate);
            if (R.is_err[R.Void, str](lr)) { ret lr; }
            if (key.root_kind == ROOT_ANY_POINTEE) {
                var i: u32 = env.facts_len;
                for (i > 0) { i = i - 1; env_remove_fact_at(env, i); }
            } or (key.root_kind != ROOT_LOCAL) { env_invalidate_calls(env); }
            or {
                env_remove_prefix(env, key);
                env_remove_pointee_sym(env, key.root_sym);
                if (escape_contains(env.escapes, key.root_sym)) { env_remove_all_pointees(env); }
            }
            if (type.is_tag(?sc.s.types, type.strip_secret(?sc.s.types, sc.expr_type[b.lhs]))) {
                val found: O.Option[u32] = env_find_fact(?value, key);
                if (O.is_some[u32](found)) {
                    val f: StorageFact = value.facts[O.unwrap[u32](found)];
                    val cs: R.Result[CaseSet, str] = caseset_clone(env.alloc, f.possible_cases);
                    if (R.is_err[CaseSet, str](cs)) { ret R.err[R.Void, str](R.unwrap_err[CaseSet, str](cs)); }
                    ret env_set_fact_caseset(env, key, f.tag_type, f.total_cases, R.unwrap_ok[CaseSet, str](cs));
                }
            }
            ret R.ok_void[str]();
        }
        val lr: R.Result[R.Void, str] = analyze_expr(sc, b.lhs, env, validate);
        if (R.is_err[R.Void, str](lr)) { ret lr; }
        ret analyze_expr(sc, b.rhs, env, validate);
    }
    if (k == expr.EXPR_KIND_UNARY) {
        val r: R.Result[R.Void, str] = analyze_expr(sc, e.data.unary.operand, env, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
        if (e.data.unary.op == expr.UN_ADDR) {
            val kr: R.Result[StorageKey, str] = storage_of_expr(sc, env.alloc, e.data.unary.operand);
            if (R.is_err[StorageKey, str](kr)) { ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](kr)); }
            var key: StorageKey = R.unwrap_ok[StorageKey, str](kr);
            fin { key_free(env.alloc, ?key); }
            if (key.root_kind == ROOT_LOCAL) { ret escape_add(env.alloc, ?env.escapes, key.root_sym); }
        }
        ret R.ok_void[str]();
    }
    if (k == expr.EXPR_KIND_MEMBER) {
        val r: R.Result[R.Void, str] = analyze_expr(sc, e.data.member.object, env, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
        if (validate) {
            var object: type.TypeId = type.strip_secret(?sc.s.types, sc.expr_type[e.data.member.object]);
            if (type.is_pointer(?sc.s.types, object)) { object = type.strip_secret(?sc.s.types, type.deref_one(?sc.s.types, object)); }
            val acc: O.Option[*context.TagAccess] = context.find_tag_access(sc, eid, object);
            if (type.is_tag(?sc.s.types, object) && O.is_none[*context.TagAccess](acc)) {
                ret R.err[R.Void, str]("case proof: missing typed payload metadata");
            }
            if (O.is_some[*context.TagAccess](acc) && !O.unwrap[*context.TagAccess](acc).is_selector) {
                val kr: R.Result[StorageKey, str] = tag_storage_of_object(sc, env.alloc, e.data.member.object);
                if (R.is_err[StorageKey, str](kr)) { ret R.err[R.Void, str](R.unwrap_err[StorageKey, str](kr)); }
                var key: StorageKey = R.unwrap_ok[StorageKey, str](kr);
                fin { key_free(env.alloc, ?key); }
                if (!is_case_proven(env, key, object, O.unwrap[*context.TagAccess](acc).case_index)) {
                    context.report(sc, e.span, "a tag payload requires proof that its case is active");
                }
            }
        }
        ret R.ok_void[str]();
    }
    if (k == expr.EXPR_KIND_INDEX || k == expr.EXPR_KIND_PROJECT) {
        var object: id.ExprId = e.data.index.object;
        var index: id.ExprId = e.data.index.index;
        if (k == expr.EXPR_KIND_PROJECT) { object = e.data.project.object; index = e.data.project.field; }
        val r: R.Result[R.Void, str] = analyze_expr(sc, object, env, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
        ret analyze_expr(sc, index, env, validate);
    }
    if (k == expr.EXPR_KIND_STRUCT_LIT) {
        var i: u32 = 0;
        for (i < e.data.struct_lit.fields_len) {
            val r: R.Result[R.Void, str] = analyze_expr(sc, sc.a.field_inits[e.data.struct_lit.fields_start + i].value, env, validate);
            if (R.is_err[R.Void, str](r)) { ret r; }
            i = i + 1;
        }
        ret R.ok_void[str]();
    }
    if (k == expr.EXPR_KIND_ARRAY_LIT) { ret analyze_list(sc, e.data.array_lit.elems_start, e.data.array_lit.elems_len, env, validate); }
    if (k == expr.EXPR_KIND_VECTOR_LIT) { ret analyze_list(sc, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len, env, validate); }
    if (k == expr.EXPR_KIND_CAST) { ret analyze_expr(sc, e.data.cast.value, env, validate); }
    if (k == expr.EXPR_KIND_STRIP) { ret analyze_expr(sc, e.data.strip.value, env, validate); }
    if (k == expr.EXPR_KIND_SPREAD) { ret analyze_expr(sc, e.data.spread.inner, env, validate); }
    if (k == expr.EXPR_KIND_IDENT || k == expr.EXPR_KIND_LIT_INT || k == expr.EXPR_KIND_LIT_FLOAT
        || k == expr.EXPR_KIND_LIT_CHAR || k == expr.EXPR_KIND_LIT_STR || k == expr.EXPR_KIND_LIT_NIL
        || k == expr.EXPR_KIND_COMPTIME_IDENT || k == expr.EXPR_KIND_TYPE_REF || k == expr.EXPR_KIND_ERROR) { ret R.ok_void[str](); }
    ret R.err[R.Void, str]("case proof: expression kind has no transfer rule");
}
fun run_fins(sc: *context.SemaContext, env: *ProofEnv, fins: *FinStack, floor: u32,
             loop: *LoopContext, validate: bool) R.Result[R.Void, str] {
    val saved: u32 = fins.len;
    fin { fins.len = saved; }
    var i: u32 = saved;
    for (i > floor && env.reachable) {
        i = i - 1;
        val body: id.StmtId = fins.stmts[i];
        fins.len = i;
        var next: ProofEnv = env_unreachable(env.alloc);
        fin { env_free(?next); }
        val r: R.Result[R.Void, str] = analyze_stmt(sc, body, env, ?next, loop, fins, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
        env_free(env);
        @env = env_take(?next);
    }
    ret R.ok_void[str]();
}

fun analyze_block(sc: *context.SemaContext, start: u32, count: u32, current: *ProofEnv,
                  loop: *LoopContext, fins: *FinStack, validate: bool) R.Result[R.Void, str] {
    val base: u32 = fins.len;
    fin { fins.len = base; }
    var i: u32 = 0;
    for (i < count && current.reachable) {
        val sid: id.StmtId = sc.a.stmt_ids[start + i];
        val st: O.Option[*stmt.Stmt] = ast.get_stmt(sc.a, sid);
        if (O.is_none[*stmt.Stmt](st)) { ret R.err[R.Void, str]("case proof: invalid block statement"); }
        if (O.unwrap[*stmt.Stmt](st).kind == stmt.STMT_KIND_FIN) {
            val r: R.Result[R.Void, str] = fin_stack_push(fins, O.unwrap[*stmt.Stmt](st).data.fin_.body);
            if (R.is_err[R.Void, str](r)) { ret r; }
        } or {
            var next: ProofEnv = env_unreachable(current.alloc);
            fin { env_free(?next); }
            val r: R.Result[R.Void, str] = analyze_stmt(sc, sid, current, ?next, loop, fins, validate);
            if (R.is_err[R.Void, str](r)) { ret r; }
            env_free(current);
            @current = env_take(?next);
        }
        i = i + 1;
    }
    ret run_fins(sc, current, fins, base, loop, validate);
}

pub fun analyze_stmt(sc: *context.SemaContext, sid: id.StmtId, incoming: *ProofEnv,
                     outgoing: *ProofEnv, loop: *LoopContext, fins: *FinStack,
                     validate: bool) R.Result[R.Void, str] {
    if (!incoming.reachable) { ret R.ok_void[str](); }
    if (sid == id.STMT_NIL) { ret env_copy_into(outgoing, incoming); }
    val sr: O.Option[*stmt.Stmt] = ast.get_stmt(sc.a, sid);
    if (O.is_none[*stmt.Stmt](sr)) { ret R.err[R.Void, str]("case proof: invalid statement"); }
    val st: stmt.Stmt = @O.unwrap[*stmt.Stmt](sr);
    var current: ProofEnv = env_unreachable(incoming.alloc);
    fin { env_free(?current); }
    val copied: R.Result[R.Void, str] = env_copy_into(?current, incoming);
    if (R.is_err[R.Void, str](copied)) { ret copied; }
    if (st.kind == stmt.STMT_KIND_BLOCK) {
        val r: R.Result[R.Void, str] = analyze_block(sc, st.data.block.stmts_start, st.data.block.stmts_len, ?current, loop, fins, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
    } or (st.kind == stmt.STMT_KIND_EXPR) {
        val r: R.Result[R.Void, str] = analyze_expr(sc, st.data.expr.expr, ?current, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
    } or (st.kind == stmt.STMT_KIND_DECL) {
        val dr: O.Option[*decl.Decl] = ast.get_decl(sc.a, st.data.decl.decl);
        if (O.is_none[*decl.Decl](dr)) { ret R.err[R.Void, str]("case proof: invalid local declaration"); }
        val d: decl.Decl = @O.unwrap[*decl.Decl](dr);
        if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
            val r: R.Result[R.Void, str] = analyze_expr(sc, d.data.bind.init, ?current, validate);
            if (R.is_err[R.Void, str](r)) { ret r; }
            val sym: O.Option[resolve.SymbolId] = context.symbol_for_decl(sc, st.data.decl.decl);
            if (O.is_some[resolve.SymbolId](sym)) {
                val ar: R.Result[R.Void, str] = assign_fact(sc, d.data.bind.init, key_local(O.unwrap[resolve.SymbolId](sym)), sc.decl_type[st.data.decl.decl], ?current);
                if (R.is_err[R.Void, str](ar)) { ret ar; }
            }
        }
    } or (st.kind == stmt.STMT_KIND_IF) {
        var yes: ProofEnv = env_unreachable(current.alloc);
        var no: ProofEnv = env_unreachable(current.alloc);
        var yo: ProofEnv = env_unreachable(current.alloc);
        var no_out: ProofEnv = env_unreachable(current.alloc);
        fin { env_free(?yes); env_free(?no); env_free(?yo); env_free(?no_out); }
        val r: R.Result[R.Void, str] = refine_condition(sc, st.data.if_.cond, ?current, ?yes, ?no, validate);
        if (R.is_err[R.Void, str](r)) { ret r; }
        val yr: R.Result[R.Void, str] = analyze_stmt(sc, st.data.if_.then_block, ?yes, ?yo, loop, fins, validate);
        if (R.is_err[R.Void, str](yr)) { ret yr; }
        val nr: R.Result[R.Void, str] = analyze_stmt(sc, st.data.if_.else_block, ?no, ?no_out, loop, fins, validate);
        if (R.is_err[R.Void, str](nr)) { ret nr; }
        ret env_join_into(outgoing, ?yo, ?no_out);
    } or (st.kind == stmt.STMT_KIND_FOR) {
        var inner: LoopContext = loop_ctx_init(current.alloc);
        inner.fin_depth = fins.len;
        fin { loop_ctx_free(?inner); }
        var header: ProofEnv = env_unreachable(current.alloc);
        fin { env_free(?header); }
        val hc: R.Result[R.Void, str] = env_copy_into(?header, ?current);
        if (R.is_err[R.Void, str](hc)) { ret hc; }
        var settled: bool = false;
        for (true) {
            loop_ctx_reset(?inner);
            var yes: ProofEnv = env_unreachable(current.alloc);
            var no: ProofEnv = env_unreachable(current.alloc);
            var body: ProofEnv = env_unreachable(current.alloc);
            var back: ProofEnv = env_unreachable(current.alloc);
            var next: ProofEnv = env_unreachable(current.alloc);
            fin { env_free(?yes); env_free(?no); env_free(?body); env_free(?back); env_free(?next); }
            val r: R.Result[R.Void, str] = refine_condition(sc, st.data.for_.cond, ?header, ?yes, ?no, settled && validate);
            if (R.is_err[R.Void, str](r)) { ret r; }
            val br: R.Result[R.Void, str] = analyze_stmt(sc, st.data.for_.body, ?yes, ?body, ?inner, fins, settled && validate);
            if (R.is_err[R.Void, str](br)) { ret br; }
            if (settled) {
                val exits: R.Result[ProofEnv, str] = loop_ctx_join_breaks(?inner);
                if (R.is_err[ProofEnv, str](exits)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](exits)); }
                var breaks: ProofEnv = R.unwrap_ok[ProofEnv, str](exits);
                fin { env_free(?breaks); }
                ret env_join_into(outgoing, ?no, ?breaks);
            }
            val cr: R.Result[ProofEnv, str] = loop_ctx_join_continues(?inner);
            if (R.is_err[ProofEnv, str](cr)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](cr)); }
            var cont: ProofEnv = R.unwrap_ok[ProofEnv, str](cr);
            fin { env_free(?cont); }
            val bj: R.Result[R.Void, str] = env_join_into(?back, ?body, ?cont);
            if (R.is_err[R.Void, str](bj)) { ret bj; }
            val nj: R.Result[R.Void, str] = env_join_into(?next, ?current, ?back);
            if (R.is_err[R.Void, str](nj)) { ret nj; }
            settled = env_equals(?header, ?next);
            env_free(?header);
            header = env_take(?next);
        }
    } or (st.kind == stmt.STMT_KIND_RET || st.kind == stmt.STMT_KIND_BRK || st.kind == stmt.STMT_KIND_CNT) {
        var floor: u32 = 0;
        if (st.kind == stmt.STMT_KIND_RET) {
            val r: R.Result[R.Void, str] = analyze_expr(sc, st.data.ret_.value, ?current, validate);
            if (R.is_err[R.Void, str](r)) { ret r; }
        } or {
            if (loop == nil) { ret R.err[R.Void, str]("case proof: loop exit without a loop"); }
            floor = loop.fin_depth;
        }
        val cleanup: R.Result[R.Void, str] = run_fins(sc, ?current, fins, floor, loop, validate);
        if (R.is_err[R.Void, str](cleanup)) { ret cleanup; }
        if (st.kind == stmt.STMT_KIND_BRK) { ret loop_ctx_add_break(loop, ?current); }
        if (st.kind == stmt.STMT_KIND_CNT) { ret loop_ctx_add_continue(loop, ?current); }
        ret R.ok_void[str]();
    } or (st.kind == stmt.STMT_KIND_COMPTIME_IF) {
        var i: u32 = 0;
        for (i < st.data.comptime_if.branches_len) {
            val arm: *decl.ComptimeBranch = ?sc.a.comptime_branches[st.data.comptime_if.branches_start + i];
            val active: R.Result[bool, str] = fins.hooks.branch(sc, arm);
            if (R.is_err[bool, str](active)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](active)); }
            if (R.unwrap_ok[bool, str](active)) {
                val r: R.Result[R.Void, str] = analyze_block(sc, arm.body_start, arm.body_len, ?current, loop, fins, validate);
                if (R.is_err[R.Void, str](r)) { ret r; }
                brk;
            }
            i = i + 1;
        }
    } or (st.kind == stmt.STMT_KIND_COMPTIME_EACH) {
        var state: EachState = EachState{env: ?current, loop: loop, fins: fins, validate: validate};
        var ce: stmt.StmtComptimeEach = st.data.comptime_each;
        val r: R.Result[R.Void, str] = fins.hooks.each(sc, ?ce, st.span, analyze_each_body, (?state)::ptr, fins.hooks.fn_ret);
        if (R.is_err[R.Void, str](r)) { ret r; }
    } or (st.kind == stmt.STMT_KIND_ASM) {
        var i: u32 = current.facts_len;
        for (i > 0) { i = i - 1; env_remove_fact_at(?current, i); }
    } or (st.kind == stmt.STMT_KIND_COMPTIME_ATTR || st.kind == stmt.STMT_KIND_ERROR) {
    } or {
        ret R.err[R.Void, str]("case proof: statement kind has no transfer rule");
    }
    @outgoing = env_take(?current);
    ret R.ok_void[str]();
}

rec EachState {
    env: *ProofEnv;
    loop: *LoopContext;
    fins: *FinStack;
    validate: bool;
}

fun analyze_each_body(data: ptr, sc: *context.SemaContext, start: u32, count: u32) R.Result[R.Void, str] {
    val state: *EachState = data::*EachState;
    ret analyze_block(sc, start, count, state.env, state.loop, state.fins, state.validate);
}

pub fun validate_body(sc: *context.SemaContext, body: id.StmtId, hooks: Hooks) R.Result[R.Void, str] {
    if (sc.status.kind != fail.ACCEPTED) { ret R.ok_void[str](); }
    var entry: ProofEnv = env_init(sc.s.alloc);
    var exit: ProofEnv = env_unreachable(sc.s.alloc);
    var fins: FinStack = fin_stack_init(sc.s.alloc);
    fins.hooks = hooks;
    fin { env_free(?entry); env_free(?exit); fin_stack_free(?fins); }
    ret analyze_stmt(sc, body, ?entry, ?exit, nil, ?fins, true);
}

use testing: std.allocator.testing;

fun allocation_probe(alloc: *A.Allocator) R.Result[R.Void, str] {
    var env: ProofEnv = env_init(alloc);
    var loop: LoopContext = loop_ctx_init(alloc);
    var fins: FinStack = fin_stack_init(alloc);
    fin { env_free(?env); loop_ctx_free(?loop); fin_stack_free(?fins); }
    var i: u32 = 0;
    for (i < 17) {
        var key: StorageKey = key_local(i);
        fin { key_free(alloc, ?key); }
        var j: u32 = 0;
        for (j < 5) {
            val pr: R.Result[R.Void, str] = key_add_projection(alloc, ?key, j);
            if (R.is_err[R.Void, str](pr)) { ret pr; }
            j = j + 1;
        }
        val set: R.Result[R.Void, str] = env_set_fact_case(?env, key, 100, 70, 69);
        if (R.is_err[R.Void, str](set)) { ret set; }
        val escape: R.Result[R.Void, str] = escape_add(alloc, ?env.escapes, i);
        if (R.is_err[R.Void, str](escape)) { ret escape; }
        val pushed: R.Result[R.Void, str] = fin_stack_push(?fins, i);
        if (R.is_err[R.Void, str](pushed)) { ret pushed; }
        i = i + 1;
    }
    val br: R.Result[R.Void, str] = loop_ctx_add_break(?loop, ?env);
    if (R.is_err[R.Void, str](br)) { ret br; }
    val cr: R.Result[R.Void, str] = loop_ctx_add_continue(?loop, ?env);
    if (R.is_err[R.Void, str](cr)) { ret cr; }
    val joined: R.Result[ProofEnv, str] = env_join(alloc, ?env, ?loop.breaks[0]);
    if (R.is_err[ProofEnv, str](joined)) { ret R.err[R.Void, str](R.unwrap_err[ProofEnv, str](joined)); }
    var owned: ProofEnv = R.unwrap_ok[ProofEnv, str](joined);
    env_free(?owned);
    ret R.ok_void[str]();
}

test "mach.lang.fe.sema.proof:allocation_refusals_preserve_ownership" {
    var state: testing.Testing;
    if (O.is_some[str](testing.make(?state))) { ret 1; }
    fin { testing.dnit(?state); }
    val baseline: R.Result[R.Void, str] = allocation_probe(?state.a);
    if (R.is_err[R.Void, str](baseline) || testing.leaked(?state)) { ret 2; }
    val total: usize = testing.attempt_count(?state);
    var ordinal: usize = 1;
    for (ordinal <= total) {
        testing.fail_at_ordinal(?state, testing.attempt_count(?state) + ordinal);
        val result: R.Result[R.Void, str] = allocation_probe(?state.a);
        if (R.is_ok[R.Void, str](result)) { ret 3; }
        if (testing.leaked(?state) || testing.double_free_count(?state) != 0
            || testing.tracking_exhausted(?state)) { ret 4; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
