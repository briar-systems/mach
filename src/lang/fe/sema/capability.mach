# the comptime capabilities a sema walk publishes for each of its phases
use std.types.bool.bool;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use ast_expr:            mach.lang.fe.ast.expr;
use ast_id:              mach.lang.fe.ast.id;
use comptime_capability: mach.lang.fe.comptime.capability;
use comptime_failure:    mach.lang.fe.comptime.failure;
use comptime_value:      mach.lang.fe.comptime.value;
use sema_constant:       mach.lang.fe.sema.constant;
use sema_context:        mach.lang.fe.sema.context;
use sema_declared:       mach.lang.fe.sema.declared;
use mach.lang.fe.sema.infer;
use type_kind: mach.lang.type.kind;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

pub fun semantic_name_caps() res[comptime_capability.PhaseCapabilities[sema_context.SemaContext], fail.Fail] {
    ret comptime_capability.semantic_name_capabilities[sema_context.SemaContext](
        sema_constant.member, sema_constant.named, sema_constant.store_of,
        sema_context.comptime_ident_is_runtime, comptime_secret, sema_context.comptime_expression, sema_context.comptime_head);
}

pub fun semantic_type_caps() res[comptime_capability.PhaseCapabilities[sema_context.SemaContext], fail.Fail] {
    ret comptime_capability.semantic_type_capabilities[sema_context.SemaContext](
        sema_constant.member, sema_constant.named, sema_constant.store_of,
        sema_context.resolve_type_comparison_operand,
        sema_context.type_store, sema_declared.field_offset, sema_constant.zero_of,
        sema_declared.resolve_type_query,
        sema_declared.resolve_layout_intrinsic,
        resolve_scalar_cast, resolve_scalar_value,
        sema_context.comptime_ident_is_runtime, comptime_secret, sema_context.comptime_expression, sema_context.comptime_head);
}

# whether the place `eid` reads is of a type that holds a secret, at the type the walk gives it:
# typed here, quietly, when no walk has yet
fun comptime_secret(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    var ty: type_kind.TypeId = sema_constant.type_at(sc, eid);
    if (type_kind.is_nil(ty)) {
        val outer: sema_context.Walk = sema_context.walk_open(sc);
        sc.walk.silent = true;
        ty             = sema_context.apply_subst(sc, infer.infer_expr(sc, eid));
        sema_context.walk_close(sc, outer);
    }
    ret sema_context.holds_secret(sc, ty);
}

fun resolve_scalar_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId, value: comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    if (sc.view.expr_type == nil || ast_id.expr_index(eid)::usize >= sc.view.a.exprs.len) {
        ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_NEEDS_TYPES, diagnostic_kind.COMPTIME_TYPE_UNRESOLVED, "comptime scalar expression type is not resolved")};
    }
    val ty: type_kind.TypeId = sema_context.apply_subst(sc, sc.view.expr_type[ast_id.expr_index(eid)]);
    ret comptime_value.cast_scalar(?sc.s.types, ?sc.s.interner, sc.view.ctx.env.target.pointer_width, sc.view.ctx.env.target.nans, sc.view.ctx.env.target.arch_id, value, ty, ty, false);
}

fun resolve_scalar_cast(sc: *sema_context.SemaContext, eid: ast_id.ExprId, value: comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val expression_r: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel expression_r.err) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(expression_r.err))}; }
    val node: ast_expr.Expr = expression_r.ok;
    if (node.kind != ast_expr.EXPR_KIND_CAST) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "semantic cast capability requires a cast expression")}; }
    if (sc.view.expr_type == nil || ast_id.expr_index(node.data.cast.value)::usize >= sc.view.a.exprs.len) {
        ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_NEEDS_TYPES, diagnostic_kind.COMPTIME_TYPE_UNRESOLVED, "comptime cast operand type is not resolved")};
    }
    ret comptime_value.cast_scalar(?sc.s.types, ?sc.s.interner, sc.view.ctx.env.target.pointer_width, sc.view.ctx.env.target.nans, sc.view.ctx.env.target.arch_id, value,
        sema_context.apply_subst(sc, sc.view.expr_type[ast_id.expr_index(node.data.cast.value)]), sema_context.resolved_type_of(sc, node.data.cast.ty), node.data.cast.reinterpret);
}
