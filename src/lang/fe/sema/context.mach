# the state of one sema walk: the module typing it shares, the module it reads, the
# instance it types and its own walk state, with the reads and reports every check makes
use lang_alloc: mach.lang.alloc;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use ast_type: mach.lang.fe.ast.type;
use mach.lang.fe.comptime;
use comptime_deep: mach.lang.fe.comptime.deep;
use mach.lang.fe.decorator;
use mach.lang.fe.resolve;
use sema_growth:   mach.lang.fe.sema.growth;
use sema_instance: mach.lang.fe.sema.instance;
use mach.lang.fe.sema.interface;
use sema_product: mach.lang.fe.sema.product;
use mach.lang.growth;
use mach.lang.intern;
use mach.lang.layout;
use mach.lang.module;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.type;
use type_query: mach.lang.type.query;
use mach.lang.type.query.logical;
use A: std.allocator;
use std.collections.map;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

pub fun imported_definition(sc: *SemaContext, sym: *resolve.Symbol,
    phase: sema_product.DefinitionPhase) res[sema_product.DefinedSymbol, fail.Fail] {
    if (module.same(sym.origin, sc.view.own_module) || sc.typing.deps == nil) {
        val reason: fail.Fail = fail.message("foreign definition acquisition cannot refresh the active semantic owner");
        fail.internal(?sc.status, fail.describe(reason));
        ret res[sema_product.DefinedSymbol, fail.Fail].err{reason};
    }
    val result: res[sema_product.DefinedSymbol, fail.Fail] = sema_product.acquire_symbol(?sc.typing.deps.definitions, sym, phase);
    if (sel result.err) {
        val reason: fail.Fail = result.err;
        if (sel reason.reported) { fail.reject(?sc.status); }
        or                       { fail.internal(?sc.status, fail.describe(reason)); }
    }
    ret result;
}

pub fun symbol_definition(sc: *SemaContext, sym: *resolve.Symbol,
    phase: sema_product.DefinitionPhase) res[sema_product.DefinedSymbol, fail.Fail] {
    if (!module.same(sym.origin, sc.view.own_module)) { ret imported_definition(sc, sym, phase); }
    if (sc.view.a == nil || sc.view.rr == nil || ast_id.decl_is_nil(sym.decl) || ast_id.decl_index(sym.decl) >= sc.view.a.decls.len::u32) {
        val reason: fail.Fail = fail.message("symbol has no declaration in the active semantic owner");
        fail.internal(?sc.status, fail.describe(reason));
        ret res[sema_product.DefinedSymbol, fail.Fail].err{reason};
    }
    val parsed: resolve.ParsedDefinition = resolve.ParsedDefinition{
        a: sc.view.a, owner: resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id), incarnation: sc.view.a.incarnation
    };
    ret res[sema_product.DefinedSymbol, fail.Fail].ok{sema_product.DefinedSymbol{
        definition: sema_product.Definition{parsed: parsed, origin: sc.view.own_module, rr: sc.view.rr, ctx: sc.view.ctx, decorators: sc.view.ctx}, symbol: @sym
    }};
}

fwd type.FieldEntry;
fwd type.FieldTable;

pub val INST_NONE: u32 = sema_instance.NONE;

# the instances a module's typing asks for, typed in the order they were first asked for;
# the set is the module's product, published with its result
pub rec InstWorklist {
    set:     sema_instance.Set;
    drained: u32;
    alloc:   *A.Allocator;
    # how many instances of each growing cycle, keyed by module and cycle, this module expanded
    expansions: map.Map[u64, u32];
}

pub val TYPE_MEMO_NONE:     u8 = 0;
pub val TYPE_MEMO_RESOLVED: u8 = 1;

pub val LAYOUT_PENDING: u8 = 0;
pub val LAYOUT_ACTIVE:  u8 = 1;
pub val LAYOUT_READY:   u8 = 2;
pub val LAYOUT_FAILED:  u8 = 3;

val UNI_REPORT_CAP: u32 = 256;

pub rec UniReports {
    seen: [UNI_REPORT_CAP]type.TypeId;
    len:  u32;
}

pub fun uni_report_mark(ur: *UniReports, key: type.TypeId) bool {
    if (ur == nil) { ret true; }
    var i: u32 = 0;
    for (i < ur.len) {
        if (type.same(ur.seen[i], key)) { ret false; }
        i = i + 1;
    }
    if (ur.len >= UNI_REPORT_CAP) { ret true; }
    ur.seen[ur.len] = key;
    ur.len          = ur.len + 1;
    ret true;
}

# one lexical payload guard: the tag place and the case it is known to hold; frames live on the
# walker's stack and chain through `prev`
pub rec Guard {
    place:     ast_id.ExprId;
    case_name: intern.StrId;
    prev:      *Guard;
}

# a fix an error offers: `close` at `tail`, and with `open` set, `open` at
# `head` too, as one fix labelled `label`
pub rec Offer {
    label: str;
    head:  lang_source.Span;
    open:  str;
    tail:  lang_source.Span;
    close: str;
}

# the typing of one module that every walk of it shares: the instances it asks for, its
# growing cycles, and the reports each instance would otherwise repeat
# ---
# caps:                what a comptime evaluation in the walk may ask of sema now
# type_caps:           the whole semantic set, which a module constant is always evaluated with
# collect_insts:       whether the walk records the instances it asks for
# subst_fn:            substitutes an instance's type arguments into a type
# annotation_check_fn: the per-instance checks over one type annotation, run as each is resolved
# module:              the stable id of the module being typed
# values:              the store the module's constant values are built in, which its
#                      interface publishes
pub rec Typing {
    deps:           *sema_product.SemaDeps;
    caps:           comptime.PhaseCapabilities[SemaContext];
    type_caps:      comptime.PhaseCapabilities[SemaContext];
    insts:          *InstWorklist;
    growth:         *sema_growth.Analysis;
    collect_insts:  bool;
    uni_reports:    *UniReports;
    handle_reports: *UniReports;
    # the module's tests typed so far, by name
    tests: *map.Map[u32, u32];
    # the types a logical-addressing target was asked to declare, each judged once
    logical_seen:        *map.Map[type.TypeId, bool];
    has_secret:          bool;
    subst_fn:            fun(*session.Session, type.TypeId, *type.GenericOwner, *type.TypeId, u32) res[type.TypeId, fail.Fail];
    annotation_check_fn: fun(*SemaContext, ast_id.TypeId);
    module:              session.StableModuleId;
    values:              *comptime_deep.Store;
}

# the module a walk reads and the typing tables it writes: the module being typed, or the
# declaring module of an instance
pub rec ModuleView {
    a:          *ast.Ast;
    rr:         *resolve.ResolveResult;
    ctx:        *comptime.ComptimeCtx;
    own_module: session.ModuleId;
    source:     str;

    expr_type:          *type.TypeId;
    type_resolved_ty:   *type.TypeId;
    decl_type:          *type.TypeId;
    type_resolved_memo: *u8;
    layout_state:       *u8;
    # how far each module `val` is bound, and the node of its value in the module's store once
    # built (see sema.constant); nil in a view of another module
    constant_state: *u8;
    constant_node:  *u32;
    embed_len:      *u64;
    embed_paths:    *intern.StrId;
    embed_path_len: u32;
    embed_path_cap: u32;
}

# the instance a walk types, or none
# ---
# depth:      how deep the chain of instances that asked for this one runs
# parent:     the instance being typed, INST_NONE outside one
# frame:      the typing frame the walk records into (see sema_instance.Frame)
# requester:  who asks for an instance from the frame (sema_instance.FROM_* or an instance id)
# pack_types: the element types of the pack the instance binds, `pack_len` of them; nil
#             outside a pack instance
# quiet:      a value or non-generic pack instance retypes what its template already
#             checked, so it reports only what the template could not decide: its comptime
#             arguments, and the bodies of an `$each` over its pack
# site:       where the instance was asked for, while `site_set`
# subst:      the type arguments that replace the parameters of `subst_owner`, position
#             for position; a parameter of any other declaration is left alone
pub rec Instance {
    depth:       u32;
    parent:      u32;
    frame:       u32;
    requester:   u32;
    pack_types:  *type.TypeId;
    pack_len:    u32;
    quiet:       bool;
    site:        lang_source.Span;
    site_file:   lang_source.FileId;
    site_set:    bool;
    subst:       *type.TypeId;
    subst_len:   u32;
    subst_owner: type.GenericOwner;
}

# the state of one walk over syntax, fresh at each body and scoped to the construct that
# sets it
# ---
# type_prepass:  resolving every type node up front, before any arm is selected
# deferred_hits: how many deferred names type resolution has met, so a consumer can tell a
#                type that failed on one from a type that failed on its own
# offer:         a fix the next error raised offers, set by a check that knows one and
#                cleared by it once the check is done; nil offers none
# write_place:   the place under a store or an address-of, whose root is written or
#                addressed rather than read
# in_test:       inside a `test` body, where a `ret` value is a status in 0..255
pub rec Walk {
    silent:           bool;
    type_prepass:     bool;
    deferred_hits:    u32;
    offer:            *Offer;
    in_deferred_arm:  bool;
    callee_eid:       ast_id.ExprId;
    write_place:      ast_id.ExprId;
    in_comptime_gate: bool;
    in_fin:           bool;
    fin_loop_depth:   u32;
    in_test:          bool;
    guards:           *Guard;
}

pub rec SemaContext {
    s:        *session.Session;
    diags:    *diagnostic.DiagnosticStore;
    status:   fail.PhaseStatus;
    typing:   Typing;
    view:     ModuleView;
    instance: Instance;
    walk:     Walk;
}

# the one way a walk is made: over `view`, typing `instance`, sharing `typing`, with a fresh walk
pub fun init(s: *session.Session, diags: *diagnostic.DiagnosticStore, typing: Typing, view: ModuleView,
    instance: Instance) SemaContext {
    ret SemaContext{s: s, diags: diags, status: fail.accepted(), typing: typing, view: view, instance: instance, walk: walk_init()};
}

pub fun walk_init() Walk {
    var w: Walk = Walk{};
    w.callee_eid  = ast_id.EXPR_NIL;
    w.write_place = ast_id.EXPR_NIL;
    ret w;
}

# a construct that sets walk state opens the walk and closes it on the way out, which
# undoes everything the construct set; the count of deferred names met carries out
pub fun walk_open(sc: *SemaContext) Walk {
    ret sc.walk;
}

pub fun walk_close(sc: *SemaContext, outer: Walk) {
    val hits: u32 = sc.walk.deferred_hits;
    sc.walk               = outer;
    sc.walk.deferred_hits = hits;
}

# outside any instance: typing the template, recording into its frame
pub fun instance_none() Instance {
    var i: Instance = Instance{};
    i.parent    = INST_NONE;
    i.frame     = sema_instance.FRAME_TEMPLATE;
    i.requester = sema_instance.FROM_TEMPLATE;
    ret i;
}

# a name resolve left for the arm sema selects, reported once at the name itself
# whichever instantiation walks it, and never for an arm sema discards
pub fun report_deferred_name(sc: *SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str) {
    if (sc.walk.silent || sc.walk.type_prepass) { ret; }
    fail.reject(?sc.status);
    val name_r: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, span.offset, span.len);
    if (sel name_r.err) {
        fail.internal(?sc.status, "out of memory naming an unresolved name");
        ret;
    }
    val name: opt[str] = intern.get(?sc.s.interner, name_r.ok);
    if (sel name.none) {
        fail.internal(?sc.status, "an unresolved name has no text");
        ret;
    }
    val committed: err[fail.Fail] = diagnostic.reportf(sc.diags, k, sc.view.a.file_id, span, "{}{}`", prefix, name.some);
    if (sel committed.err) { fail.internal(?sc.status, fail.describe(committed.err)); }
}

pub fun report_deferred_type(sc: *SemaContext, ast_tid: ast_id.TypeId) {
    report_deferred_subtree(sc, ast_tid, 0);
}

# a type is consumed whole, often from the memo, so every deferred name anywhere inside it is
# reached from here: its arguments, pointee, element, length, parameters and fields
fun report_deferred_subtree(sc: *SemaContext, ast_tid: ast_id.TypeId, depth: u32) {
    if (depth > 64 || ast_id.type_is_nil(ast_tid))                                                                   { ret; }
    if (sc.view.rr == nil || sc.view.rr.type_resolved == nil || ast_id.type_index(ast_tid) >= sc.view.rr.type_count) { ret; }
    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, ast_tid);
    if (!sel t_opt.some) { ret; }
    val t: *ast_type.Type = t_opt.some;
    if (resolve.symbol_same(sc.view.rr.type_resolved[ast_id.type_index(ast_tid)], resolve.SYMBOL_DEFERRED_TYPE)) {
        sc.walk.deferred_hits = sc.walk.deferred_hits + 1;
        report_deferred_name(sc, diagnostic_kind.NAME_UNRESOLVED, t.span, "unresolved type name `");
    }
    if (t.kind == ast_type.TYPE_KIND_NAMED) {
        var i: u32 = 0;
        for (i < t.data.named.args_len) {
            report_deferred_subtree(sc, sc.view.a.type_ids.data[t.data.named.args_start + i], depth + 1);
            i = i + 1;
        }
    }
    or (t.kind == ast_type.TYPE_KIND_PTR)             { report_deferred_subtree(sc, t.data.ptr.pointee, depth + 1); }
    or (t.kind == ast_type.TYPE_KIND_SECRET)          { report_deferred_subtree(sc, t.data.secret.inner, depth + 1); }
    or (t.kind == ast_type.TYPE_KIND_POINTEE_OF)      { report_deferred_subtree(sc, t.data.pointee_of.inner, depth + 1); }
    or (t.kind == ast_type.TYPE_KIND_DISCRIMINANT_OF) { report_deferred_subtree(sc, t.data.discriminant_of.inner, depth + 1); }
    or (t.kind == ast_type.TYPE_KIND_ARRAY) {
        report_deferred_length(sc, t.data.array.length);
        report_deferred_subtree(sc, t.data.array.element, depth + 1);
    }
    or (t.kind == ast_type.TYPE_KIND_FUN) {
        var p: u32 = 0;
        for (p < t.data.fun_.params_len) {
            report_deferred_subtree(sc, sc.view.a.type_ids.data[t.data.fun_.params_start + p], depth + 1);
            p = p + 1;
        }
        report_deferred_subtree(sc, t.data.fun_.ret_type, depth + 1);
    }
    or (t.kind == ast_type.TYPE_KIND_REC || t.kind == ast_type.TYPE_KIND_UNI) {
        var start: u32 = t.data.rec_.fields_start;
        var len:   u32 = t.data.rec_.fields_len;
        if (t.kind == ast_type.TYPE_KIND_UNI) {
            start = t.data.uni_.fields_start;
            len   = t.data.uni_.fields_len;
        }
        var f: u32 = 0;
        for (f < len) {
            report_deferred_subtree(sc, sc.view.a.typed_names.data[start + f].ty, depth + 1);
            f = f + 1;
        }
    }
}

# an array length that is one deferred name
fun report_deferred_length(sc: *SemaContext, eid: ast_id.ExprId) {
    if (ast_id.expr_is_nil(eid) || sc.view.rr.expr_resolved == nil || ast_id.expr_index(eid) >= sc.view.rr.expr_count) { ret; }
    if (!resolve.symbol_deferred(sc.view.rr.expr_resolved[ast_id.expr_index(eid)]))                                    { ret; }
    val e_opt: res[ast_expr.Expr, fail.Fail] = expression(sc, eid);
    if (sel e_opt.err) { ret; }
    sc.walk.deferred_hits = sc.walk.deferred_hits + 1;
    var at: lang_source.Span = e_opt.ok.span;
    if (e_opt.ok.kind == ast_expr.EXPR_KIND_IDENT) { at = e_opt.ok.data.ident.tok; }
    report_deferred_name(sc, diagnostic_kind.NAME_UNRESOLVED, at, "unresolved identifier `");
}

pub fun resolved_type_of(sc: *SemaContext, ast_tid: ast_id.TypeId) type.TypeId {
    if (ast_id.type_is_nil(ast_tid))                            { ret type.TYPE_NIL; }
    if (sc.view.type_resolved_ty == nil)                        { ret type.TYPE_ERROR; }
    if (ast_id.type_index(ast_tid) >= sc.view.a.types.len::u32) { ret type.TYPE_ERROR; }
    report_deferred_type(sc, ast_tid);
    if (sc.instance.subst != nil && sc.typing.annotation_check_fn != nil) {
        sc.typing.annotation_check_fn(sc, ast_tid);
    }
    ret apply_subst(sc, sc.view.type_resolved_ty[ast_id.type_index(ast_tid)]);
}

pub fun expression(sc: *SemaContext, eid: ast_id.ExprId) res[ast_expr.Expr, fail.Fail] {
    val result: res[ast_expr.Expr, fail.Fail] = resolve.expression(sc.view.rr, sc.view.a, eid);
    if (sel result.err) { fail.internal(?sc.status, fail.describe(result.err)); }
    ret result;
}

pub fun comptime_expression(sc: *SemaContext, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime.EvalFail] {
    if (sc == nil || sc.view.a != a) { ret res[ast_expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "semantic expression belongs to a different parsed owner")}; }
    val result: res[ast_expr.Expr, fail.Fail] = expression(sc, eid);
    if (sel result.err) {
        ret res[ast_expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(result.err))};
    }
    ret res[ast_expr.Expr, comptime.EvalFail].ok{result.ok};
}

pub fun apply_subst(sc: *SemaContext, tid: type.TypeId) type.TypeId {
    if (sc.instance.subst == nil || sc.instance.subst_len == 0 || sc.typing.subst_fn == nil) { ret tid; }
    ret type_result(sc, sc.typing.subst_fn(sc.s, tid, ?sc.instance.subst_owner, sc.instance.subst, sc.instance.subst_len));
}

# true while a type still names a type parameter: no operand predicate has an answer
# for it, and every question about it waits for an instantiation
pub fun awaits_instance(sc: *SemaContext, tid: type.TypeId) bool {
    if (type.is_error(tid) || type.is_nil(tid)) { ret false; }
    ret type.mentions_generic_param(?sc.s.types, tid);
}

# an instance the walk asks for at `eid`: added to the module's set when new, and noted as
# what `eid` names in the walk's frame. an instance whose type arguments or pack still
# mention a type parameter is the template under other names: nothing in its body is
# settled until the caller is itself instantiated, and that caller's walk asks for the
# closed instance. `item` carries the kind, the declaration, its arguments, name,
# signature and site; the rest is the set's
pub fun record_instance(sc: *SemaContext, item: sema_instance.Instance, eid: ast_id.ExprId) err[fail.Fail] {
    if (!sc.typing.collect_insts || sc.typing.insts == nil)                                  { ret err[fail.Fail].ok{}; }
    if (item.kind == sema_instance.KIND_TYPE && item.arg_len == 0)                           { ret err[fail.Fail].ok{}; }
    if (types_open(sc, item.args, item.arg_len) || types_open(sc, item.pack, item.pack_len)) { ret err[fail.Fail].ok{}; }

    # a refused cycle is reported where the analysis found it, and none of it is expanded
    val cycle: GrowthCycle = growth_cycle_of(sc, item.origin, item.decl);
    if (cycle.refused) { ret err[fail.Fail].ok{}; }

    val wl:  *InstWorklist          = sc.typing.insts;
    var req: sema_instance.Instance = item;
    req.parent    = sc.instance.parent;
    req.depth     = sc.instance.depth;
    req.site_file = sc.view.a.file_id;
    val added: res[sema_instance.Added, fail.Fail] = sema_instance.add(?wl.set, req);
    if (sel added.err) {
        fail.internal(?sc.status, fail.describe(added.err));
        ret err[fail.Fail].err{added.err};
    }
    if (added.ok.fresh && cycle.id != sema_growth.NONE) { expansion_note(sc, item.origin, cycle); }
    # an instance asked for at no call is checked and never emitted
    if (ast_id.expr_is_nil(eid)) { ret err[fail.Fail].ok{}; }
    val id:    u32            = added.ok.id;
    val noted: err[fail.Fail] = sema_instance.call_record(?wl.set, sc.instance.frame, eid, id);
    if (sel noted.err) { ret noted; }
    ret sema_instance.edge_add(?wl.set, sc.instance.requester, id);
}

# the growing cycle a declaration lies on, as its own module's analysis decided it
rec GrowthCycle {
    id:      u32;
    refused: bool;
    members: intern.StrId;
}

fun growth_cycle_of(sc: *SemaContext, origin: session.ModuleId, decl: ast_id.DeclId) GrowthCycle {
    var none: GrowthCycle           = GrowthCycle{id: sema_growth.NONE, refused: false, members: intern.STR_NIL};
    var an:   *sema_growth.Analysis = nil;
    if (sc.typing.growth != nil && module.same(origin, sc.typing.growth.module)) { an = sc.typing.growth; }
    or (sc.typing.deps != nil) {
        val acquired: res[sema_product.Definition, fail.Fail] = sema_product.acquire_definition(?sc.typing.deps.definitions, origin, sema_product.DEFINITION_TYPED);
        if (sel acquired.err)      { ret none; }
        if (acquired.ok.sr != nil) { an = ?acquired.ok.sr.growth; }
    }
    val id: opt[u32] = sema_growth.cycle_of(an, decl);
    if (sel id.none) { ret none; }
    val c: *sema_growth.Cycle = sema_growth.cycle_at(an, id.some);
    ret GrowthCycle{id: id.some, refused: c.refused, members: c.members};
}

# one more instance of a growing cycle: the watch hears of it each time the count doubles,
# so a runaway expansion is visible while it runs
fun expansion_note(sc: *SemaContext, origin: session.ModuleId, cycle: GrowthCycle) {
    val wl:  *InstWorklist = sc.typing.insts;
    var key: u64           = (module.index(origin)::u64 << 32) | cycle.id::u64;
    var n:   u32           = 1;
    val had: opt[*u32]     = map.get[u64, u32](?wl.expansions, ?key);
    if (sel had.some) { n = @had.some + 1; }
    val put: res[bool, A.Error] = map.insert[u64, u32](?wl.expansions, key, n);
    if (sel put.err) {
        fail.internal(?sc.status, lang_alloc.text(put.err));
        ret;
    }
    if ((n & (n - 1)) != 0)                                            { ret; }
    if (sc.typing.deps == nil || sc.typing.deps.watch.expanded == nil) { ret; }
    sc.typing.deps.watch.expanded(sc.typing.deps.watch.ctx, session.module_fqn(sc.s, origin), cycle.members, n);
}

fun types_open(sc: *SemaContext, p: *type.TypeId, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        if (type.mentions_generic_param(?sc.s.types, p[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun inst_worklist_new(alloc: *A.Allocator) res[*InstWorklist, fail.Fail] {
    val wr: res[*InstWorklist, A.Error] = A.allocate[InstWorklist](alloc, 1::usize);
    if (sel wr.err) { ret res[*InstWorklist, fail.Fail].err{fail.message("internal: out of memory allocating the instance worklist")}; }
    val set: res[sema_instance.Set, fail.Fail] = sema_instance.init(alloc);
    if (sel set.err) {
        A.deallocate[InstWorklist](alloc, wr.ok, 1::usize);
        ret res[*InstWorklist, fail.Fail].err{set.err};
    }
    val wl: *InstWorklist = wr.ok;
    wl.set        = set.ok;
    wl.drained    = 0;
    wl.alloc      = alloc;
    wl.expansions = map.init[u64, u32](alloc);
    ret res[*InstWorklist, fail.Fail].ok{wl};
}

pub fun inst_worklist_free(wl: *InstWorklist) {
    if (wl == nil) { ret; }
    sema_instance.dnit(?wl.set);
    map.dnit[u64, u32](?wl.expansions);
    A.deallocate[InstWorklist](wl.alloc, wl, 1::usize);
}

pub fun inst_worklist_dnit(sc: *SemaContext) {
    inst_worklist_free(sc.typing.insts);
    sc.typing.insts = nil;
}

# the type the walk gives expression `eid`, recorded in its frame when the frame is not
# the module's own typing
pub fun expr_type_set(sc: *SemaContext, eid: ast_id.ExprId, ty: type.TypeId) {
    if (sc.view.expr_type == nil || ast_id.expr_index(eid)::usize >= sc.view.a.exprs.len) { ret; }
    sc.view.expr_type[ast_id.expr_index(eid)] = ty;
    logical_check(sc, ty, sc.view.a.exprs.data[ast_id.expr_index(eid)].span);
    if (!frame_records_typing(sc)) { ret; }
    val put: err[fail.Fail] = sema_instance.expr_record(?sc.typing.insts.set, sc.instance.frame, eid, ty);
    if (sel put.err) { fail.internal(?sc.status, fail.describe(put.err)); }
}

pub fun decl_type_set(sc: *SemaContext, did: ast_id.DeclId, ty: type.TypeId) {
    if (sc.view.decl_type == nil || ast_id.decl_index(did)::usize >= sc.view.a.decls.len) { ret; }
    sc.view.decl_type[ast_id.decl_index(did)] = ty;
    val d: *ast_decl.Decl = ?sc.view.a.decls.data[ast_id.decl_index(did)];
    if (d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) { logical_check(sc, ty, d.span); }
    if (d.kind == ast_decl.DECL_KIND_FUN)                                     { logical_check_signature(sc, d, ty); }
    if (!frame_records_typing(sc))                                            { ret; }
    val put: err[fail.Fail] = sema_instance.decl_record(?sc.typing.insts.set, sc.instance.frame, did, ty);
    if (sel put.err) { fail.internal(?sc.status, fail.describe(put.err)); }
}

# a function's signature is judged a component at a time, each where it is written
fun logical_check_signature(sc: *SemaContext, d: *ast_decl.Decl, ty: type.TypeId) {
    val t: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (sel t.none)                   { ret; }
    if (t.some.kind != type.TYPE_FUN) { ret; }
    logical_check(sc, t.some.data.fn.ret_type, annotation_span(sc, d.data.fun_.return_type, d.span));
    var i: u32 = 0;
    for (i < t.some.data.fn.params_len) {
        val p:  opt[type.TypeId] = type.get_param(?sc.s.types, t.some.data.fn.params_start + i);
        var at: lang_source.Span = d.span;
        if (i < d.data.fun_.params_len) { at = annotation_span(sc, sc.view.a.typed_names.data[d.data.fun_.params_start + i].ty, d.span); }
        if (sel p.some)                 { logical_check(sc, p.some, at); }
        i = i + 1;
    }
}

fun annotation_span(sc: *SemaContext, tid: ast_id.TypeId, fallback: lang_source.Span) lang_source.Span {
    if (ast_id.type_is_nil(tid)) { ret fallback; }
    val t: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (sel t.none) { ret fallback; }
    ret t.some.span;
}

# a type the code needs that a logical-addressing target cannot declare is refused where
# the code is written, once per type
fun logical_check(sc: *SemaContext, ty: type.TypeId, span: lang_source.Span) {
    if (sc.typing.logical_seen == nil || sc.view.ctx == nil || sc.walk.silent) { ret; }
    if (sc.view.ctx.env.target.flat_addressing)                                { ret; }
    if (type.is_nil(ty) || type.is_error(ty))                                  { ret; }
    if (type.mentions_generic_param(?sc.s.types, ty))                          { ret; }
    val fresh: res[bool, A.Error] = map.insert[type.TypeId, bool](sc.typing.logical_seen, ty, true);
    if (sel fresh.err) {
        fail.internal(?sc.status, lang_alloc.text(fresh.err));
        ret;
    }
    if (!fresh.ok) { ret; }
    var q: type_query.Query = query_of(sc);
    val r: logical.Refusal  = logical.refusal(?q, ty);
    if (r == logical.REFUSAL_RECURSIVE) { report(sc, diagnostic_kind.SPIRV_RECURSIVE_TYPE, span, logical.RECURSIVE_MSG); }
    if (r == logical.REFUSAL_UNBOUNDED) { report(sc, diagnostic_kind.SPIRV_RECURSIVE_TYPE, span, logical.UNBOUNDED_MSG); }
}

# the walk is typing a value instance, so the comptime parameters of the function it
# instantiates are bound
pub fun walk_binds_values(sc: *SemaContext) bool {
    if (sc.typing.insts == nil || sc.instance.parent == INST_NONE) { ret false; }
    ret sema_instance.at(?sc.typing.insts.set, sc.instance.parent).kind == sema_instance.KIND_VALUE;
}

# the walk is typing a pack instance, so the pack's element types are bound
pub fun walk_binds_pack(sc: *SemaContext) bool {
    if (sc.typing.insts == nil || sc.instance.parent == INST_NONE) { ret false; }
    ret sema_instance.at(?sc.typing.insts.set, sc.instance.parent).kind == sema_instance.KIND_PACK;
}

# an instance with no type arguments is typed by its template, except in the iterations
# its frames hold
fun frame_records_typing(sc: *SemaContext) bool {
    if (sc.typing.insts == nil || sc.instance.frame == sema_instance.FRAME_TEMPLATE) { ret false; }
    if (sema_instance.frame_is_iteration(?sc.typing.insts.set, sc.instance.frame))   { ret true; }
    if (sc.instance.parent == INST_NONE)                                             { ret true; }
    ret sema_instance.at(?sc.typing.insts.set, sc.instance.parent).arg_len > 0;
}

# the verdict the walk gives a comptime gate in its frame
pub fun gate_set(sc: *SemaContext, cond: ast_id.ExprId, active: bool) {
    if (sc.typing.insts == nil || ast_id.expr_is_nil(cond)) { ret; }
    val put: err[fail.Fail] = sema_instance.gate_record(?sc.typing.insts.set, sc.instance.frame, cond, active);
    if (sel put.err) { fail.internal(?sc.status, fail.describe(put.err)); }
}

pub fun public_type_for(sc: *SemaContext, sym: *resolve.Symbol) opt[sema_product.TypeExport] {
    if (sc.typing.deps == nil) { ret opt[sema_product.TypeExport].none{}; }
    val owner: session.StableModuleId = resolve.type_owner(sc.s, sym.origin, sym.definition_file).module;
    var i:     u32                    = 0;
    for (i < sc.typing.deps.count) {
        val found: res[opt[sema_product.TypeExport], A.Error] = sema_product.module_export_for(sc.typing.deps.entries[i], owner, sym.canon);
        if (sel found.err) {
            fail.internal(?sc.status, "out of memory indexing a dependency's public types");
            ret opt[sema_product.TypeExport].none{};
        }
        if (sel found.ok.some) { ret found.ok; }
        i = i + 1;
    }
    ret opt[sema_product.TypeExport].none{};
}

pub fun decl_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    if (sym.kind == resolve.SYM_PARAM)   { ret param_type_for(sc, sym); }
    if (sym.kind == resolve.SYM_GENERIC) { ret generic_param_type_for(sc, sym); }
    if (module.same(sym.origin, sc.view.own_module)) {
        if (sc.view.decl_type == nil || ast_id.decl_is_nil(sym.decl) || ast_id.decl_index(sym.decl) >= sc.view.a.decls.len::u32) { ret type.TYPE_ERROR; }
        ret sc.view.decl_type[ast_id.decl_index(sym.decl)];
    }
    val exported: opt[sema_product.TypeExport] = public_type_for(sc, sym);
    if (!sel exported.some) {
        fail.internal(?sc.status, "imported type has no acquired public surface");
        ret type.TYPE_ERROR;
    }
    ret exported.some.ty;
}

pub fun symbol_for_expr(sc: *SemaContext, eid: ast_id.ExprId) opt[*resolve.Symbol] {
    if (sc.view.rr == nil || sc.view.rr.expr_resolved == nil) { ret opt[*resolve.Symbol].none{}; }
    if (ast_id.expr_index(eid) >= sc.view.rr.expr_count)      { ret opt[*resolve.Symbol].none{}; }
    val sid: resolve.SymbolId = sc.view.rr.expr_resolved[ast_id.expr_index(eid)];
    ret symbol_by_id(sc, sid);
}

pub fun comptime_ident_is_runtime(sc: *SemaContext, eid: ast_id.ExprId) bool {
    if (sc == nil || ast_id.expr_is_nil(eid)) { ret false; }
    val opt_sym: opt[*resolve.Symbol] = symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    ret resolve.symbol_is_runtime(opt_sym.some);
}

pub fun symbol_for_type(sc: *SemaContext, tid: ast_id.TypeId) opt[*resolve.Symbol] {
    if (sc.view.rr == nil || sc.view.rr.type_resolved == nil) { ret opt[*resolve.Symbol].none{}; }
    if (ast_id.type_index(tid) >= sc.view.rr.type_count)      { ret opt[*resolve.Symbol].none{}; }
    val sid: resolve.SymbolId = sc.view.rr.type_resolved[ast_id.type_index(tid)];
    ret symbol_by_id(sc, sid);
}

pub fun symbol_by_id(sc: *SemaContext, sid: resolve.SymbolId) opt[*resolve.Symbol] {
    if (resolve.symbol_is_nil(sid))                           { ret opt[*resolve.Symbol].none{}; }
    if (sc.view.rr == nil || sc.view.rr.symbols == nil)       { ret opt[*resolve.Symbol].none{}; }
    if (resolve.symbol_index(sid) >= sc.view.rr.symbol_count) { ret opt[*resolve.Symbol].none{}; }
    ret opt[*resolve.Symbol].some{?sc.view.rr.symbols[resolve.symbol_index(sid)]};
}

pub fun machine_of(sc: *SemaContext) layout.Machine {
    ret layout.machine(sc.view.ctx.env.target.pointer_width, sc.view.ctx.env.target.vector_bits, sc.view.ctx.env.target.register_bits);
}

val TEMPLATE_TRAIL_LABEL: str = "in this generic body, checked against this instance's type arguments";
val PACK_TRAIL_LABEL:     str = "in this body, checked against this instance's pack element types";
val VALUE_TRAIL_LABEL:    str = "in this body, checked against this instance's comptime arguments";

fun trail_label(sc: *SemaContext) str {
    if (sc.typing.insts == nil || sc.instance.parent == INST_NONE) { ret TEMPLATE_TRAIL_LABEL; }
    val kind: sema_instance.Kind = sema_instance.at(?sc.typing.insts.set, sc.instance.parent).kind;
    if (kind == sema_instance.KIND_PACK)  { ret PACK_TRAIL_LABEL; }
    if (kind == sema_instance.KIND_VALUE) { ret VALUE_TRAIL_LABEL; }
    ret TEMPLATE_TRAIL_LABEL;
}

# a rejection raised while checking an instance body is the instantiation's, not the
# template's: it points at the call that asked for this instance and carries the
# template's own span as the related site
# where a diagnostic about `span` is reported: an instance reports at its instantiation site
fun report_site(sc: *SemaContext, span: lang_source.Span) lang_source.Location {
    if (sc.instance.site_set) { ret lang_source.Location{file: sc.instance.site_file, span: sc.instance.site}; }
    ret lang_source.Location{file: sc.view.a.file_id, span: span};
}

fun emit_error(sc: *SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str, note: str) {
    val at: lang_source.Location = report_site(sc, span);
    emit(sc, diagnostic.builder_init(sc.diags.a, k, at.file, at.span, message), span, note);
}

fun emit(sc: *SemaContext, b_r: res[diagnostic.DiagnosticBuilder, fail.Fail], span: lang_source.Span, note: str) {
    if (sel b_r.err) {
        fail.internal(?sc.status, fail.describe(b_r.err));
        ret;
    }
    var b: diagnostic.DiagnosticBuilder = b_r.ok;

    if (note != nil) {
        val ar: err[fail.Fail] = diagnostic.attach_note(?b, note);
        if (sel ar.err) {
            diagnostic.builder_dnit(?b);
            fail.internal(?sc.status, fail.describe(ar.err));
            ret;
        }
    }
    if (sc.instance.site_set) {
        val rr: err[fail.Fail] = diagnostic.attach_related(?b, sc.view.a.file_id, span, trail_label(sc));
        if (sel rr.err) {
            diagnostic.builder_dnit(?b);
            fail.internal(?sc.status, fail.describe(rr.err));
            ret;
        }
    }

    if (sc.walk.offer != nil) {
        val offered: err[fail.Fail] = attach_offer(?b, sc.view.a.file_id, sc.walk.offer);
        if (sel offered.err) {
            diagnostic.builder_dnit(?b);
            fail.internal(?sc.status, fail.describe(offered.err));
            ret;
        }
        sc.walk.offer = nil;
    }

    val cr: err[fail.Fail] = diagnostic.commit(?b, sc.diags);
    if (sel cr.err) { fail.internal(?sc.status, fail.describe(cr.err)); }
}

# an offered fix the builder cannot hold whole is left off, and the error stands
# without it
fun attach_offer(b: *diagnostic.DiagnosticBuilder, file: lang_source.FileId, o: *Offer) err[fail.Fail] {
    if (o.open == nil) {
        diagnostic.attach_fix(b, o.label, file, o.tail, o.close);
        ret err[fail.Fail].ok{};
    }
    val made: res[diagnostic.FixId, fail.Fail] = diagnostic.attach_fix(b, o.label, file, o.head, o.open);
    if (sel made.err) { ret err[fail.Fail].ok{}; }
    val closed: err[fail.Fail] = diagnostic.attach_fix_edit(b, made.ok, file, o.tail, o.close);
    if (sel closed.err) { ret diagnostic.withdraw_fix(b, made.ok); }
    ret err[fail.Fail].ok{};
}

pub fun report(sc: *SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str) {
    if (sc.walk.silent) { ret; }
    fail.reject(?sc.status);
    emit_error(sc, k, span, message, nil);
}

pub fun check_handle_in_array(sc: *SemaContext, ty: type.TypeId, span: lang_source.Span) {
    if (!type.handle_in_array(?sc.s.types, ty)) { ret; }
    # a chain of pointers over a handle is refused at its annotation, the one diagnostic it draws
    if (type.has_handle_pointer_pointer(?sc.s.types, ty)) { ret; }
    report(sc, diagnostic_kind.HANDLE_STORAGE, span, "a handle cannot sit inside an array: an array is an extent the program computes, and a handle's extent is the owning target's rather than the program's, so there is no element size to step by. pass the handle itself, or a pointer to its binding, instead");
}

pub fun report_internal(sc: *SemaContext, span: lang_source.Span, message: str) {
    fail.internal(?sc.status, message);
}

fun type_result(sc: *SemaContext, r: res[type.TypeId, fail.Fail]) type.TypeId {
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

pub fun diag_mark(sc: *SemaContext) u64 {
    ret sc.status.rejections;
}

pub fun reported_since(sc: *SemaContext, mark: u64) bool {
    ret sc.status.rejections != mark;
}

pub fun report_note(sc: *SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str, note: str) {
    if (sc.walk.silent) { ret; }
    fail.reject(?sc.status);
    emit_error(sc, k, span, message, note);
}

# `fmt` formatted with `args`, owned by the caller and released with `text_free`; a refused
# format fails the phase as an internal failure and gives none
pub fun text(sc: *SemaContext, fmt: str, args: ...) opt[str] {
    val t: res[str, fail.Fail] = diagnostic.format(sc.s.alloc, fmt, args...);
    if (sel t.err) {
        fail.internal(?sc.status, fail.describe(t.err));
        ret opt[str].none{};
    }
    ret opt[str].some{t.ok};
}

pub fun text_free(sc: *SemaContext, t: str) {
    str_free(sc.s.alloc, t);
}

# a diagnostic whose message is `fmt` formatted with `args`; a refused format fails the
# phase as an internal failure, here and nowhere else
pub fun reportf(sc: *SemaContext, k: diagnostic_kind.Kind, span: lang_source.Span, fmt: str, args: ...) {
    if (sc.walk.silent) { ret; }
    fail.reject(?sc.status);
    val at: lang_source.Location = report_site(sc, span);
    emit(sc, diagnostic.builder_initf(sc.diags.a, k, at.file, at.span, fmt, args...), span, nil);
}

pub fun field_table_stage(sc: *SemaContext, additional: u32) res[u32, fail.Fail] {
    ret type.field_table_stage(?sc.s.types, additional);
}

pub fun field_table_stage_push_entry(sc: *SemaContext, entry: type.FieldEntry) err[fail.Fail] {
    ret type.field_table_stage_push_entry(?sc.s.types, entry);
}

pub fun field_table_publish(sc: *SemaContext, ty: type.TypeId, fields_start: u32, fields_len: u32) err[fail.Fail] {
    ret type.field_table_publish(?sc.s.types, ty, fields_start, fields_len);
}

pub fun field_table_for(sc: *SemaContext, ty: type.TypeId) opt[*FieldTable] {
    ret type.field_table_for(?sc.s.types, ty);
}

pub fun field_lookup(sc: *SemaContext, ty: type.TypeId, name: intern.StrId) opt[type.TypeId] {
    val ft_opt: opt[*FieldTable] = field_table_for(sc, ty);
    if (!sel ft_opt.some) { ret opt[type.TypeId].none{}; }
    val ft: *FieldTable = ft_opt.some;

    var i: u32 = 0;
    for (i < ft.fields_len) {
        val fe: *type.FieldEntry = type.field_entry_at(?sc.s.types, ft, i);
        if (intern.str_same(fe.name, name)) { ret opt[type.TypeId].some{fe.ty}; }
        i = i + 1;
    }
    ret opt[type.TypeId].none{};
}

# the type store a comptime evaluation inside this walk reads
pub fun type_store(sc: *SemaContext) *type.TypeInterner {
    ret ?sc.s.types;
}

pub fun resolve_type_comparison_operand(sc: *SemaContext, eid: ast_id.ExprId) res[opt[u32], comptime.EvalFail] {
    if (sc == nil)                                                                     { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    if (sc.view.expr_type == nil)                                                      { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    if (ast_id.expr_is_nil(eid) || ast_id.expr_index(eid) >= sc.view.a.exprs.len::u32) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    val t: type.TypeId = apply_subst(sc, sc.view.expr_type[ast_id.expr_index(eid)]);
    if (type.is_nil(t) || type.is_error(t)) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    if (type.mentions_generic_param(?sc.s.types, t)) {
        ret res[opt[u32], comptime.EvalFail].err{comptime.eval_error(
            comptime.EVAL_FAIL_NEEDS_INSTANCE, diagnostic_kind.COMPTIME_NEEDS_INSTANCE, comptime.COMPTIME_TYPE_NEEDS_INSTANCE_MSG)};
    }
    ret res[opt[u32], comptime.EvalFail].ok{opt[u32].some{t::u32}};
}

pub fun gated_member_const_message(sc: *SemaContext, name: intern.StrId, dep_path: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(dep_path)) { ret res[str, fail.Fail].err{fail.message("sema: a tuple-dependent constant's module has no stable name")}; }
    ret fail.format_intern(?sc.s.interner, sc.s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        intern.text(?sc.s.interner, name), intern.text(?sc.s.interner, dep_path));
}

pub fun resolve_module_member_const(sc: *SemaContext, eid: ast_id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val rr: *resolve.ResolveResult = sc.view.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sid: resolve.SymbolId = rr.expr_resolved[ast_id.expr_index(eid)];
    if (resolve.symbol_is_nil(sid) || sid::u32 >= rr.symbol_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sym: *resolve.Symbol = ?rr.symbols[resolve.symbol_index(sid)];
    if (sym.kind != resolve.SYM_IMPORTED) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val exported: opt[sema_product.TypeExport] = public_type_for(sc, sym);
    if (!sel exported.some) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    if (!exported.some.constant.present) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val named: resolve.ExportConstant = exported.some.constant;
    # another module's record, array or case constant is read as the value it published, which sema's constants answer
    if (named.value.kind == comptime.CT_KIND_NODE) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    if (named.gated && sc.view.ctx.env.build.union_build) {
        val dep_path: intern.StrId        = session.module_fqn(sc.s, sym.origin);
        val msg_r:    res[str, fail.Fail] = gated_member_const_message(sc, sym.name, dep_path);
        if (sel msg_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(msg_r.err, diagnostic_kind.CONST_TUPLE_DEPENDENT, "")}; }
        val msg:   str                           = msg_r.ok;
        val e_opt: res[ast_expr.Expr, fail.Fail] = expression(sc, eid);
        var span:  lang_source.Span;
        span.offset = 0;
        span.len    = 0;
        if (sel e_opt.ok) { span = e_opt.ok.span; }
        report(sc, diagnostic_kind.CONST_TUPLE_DEPENDENT, span, msg);
        if (sel sc.status.kind.internal) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.status_text(sc.status))};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.CONST_TUPLE_DEPENDENT, msg)};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{named.value}};
}

fun param_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    val f_opt: opt[*ast_decl.DeclFun] = fun_decl_for(sc, sym.decl);
    if (!sel f_opt.some) { ret type.TYPE_ERROR; }
    val f: *ast_decl.DeclFun = f_opt.some;
    if (sym.slot >= f.params_len) { ret type.TYPE_ERROR; }
    val tn: *ast_decl.TypedName = ?sc.view.a.typed_names.data[f.params_start + sym.slot];
    ret resolved_type_of(sc, tn.ty);
}

pub fun own_nominal_declaration(sc: *SemaContext, nominal: *type.Type) res[ast_id.DeclId, fail.Fail] {
    if (sc.view.rr == nil || sc.view.a == nil) { ret res[ast_id.DeclId, fail.Fail].err{fail.message("nominal definition requires the active resolved owner")}; }
    val owner: type.TypeOwner = resolve.type_owner(sc.s, sc.view.own_module, sc.view.a.file_id);
    if (!module.stable_same(nominal.data.nominal.owner.module, owner.module) || !lang_source.file_same(nominal.data.nominal.owner.file, owner.file)) {
        ret res[ast_id.DeclId, fail.Fail].err{fail.message("nominal definition belongs to another source owner")};
    }
    var found: ast_id.DeclId = ast_id.DECL_NIL;
    var i:     u32           = 0;
    for (i < sc.view.rr.symbol_count) {
        val symbol:  *resolve.Symbol = ?sc.view.rr.symbols[i];
        var matches: bool            = symbol.kind == resolve.SYM_REC && nominal.kind == type.TYPE_REC;
        if (symbol.kind == resolve.SYM_UNI && nominal.kind == type.TYPE_UNI) { matches = true; }
        if (symbol.kind == resolve.SYM_TAG && nominal.kind == type.TYPE_TAG) { matches = true; }
        if (matches && module.same(symbol.origin, sc.view.own_module) && intern.str_same(symbol.canon, nominal.data.nominal.name)) {
            if (!ast_id.decl_is_nil(found) && !ast_id.decl_same(found, symbol.decl)) { ret res[ast_id.DeclId, fail.Fail].err{fail.message("nominal definition is ambiguous in the active resolved owner")}; }
            found = symbol.decl;
        }
        i = i + 1;
    }
    if (ast_id.decl_is_nil(found) || ast_id.decl_index(found) >= sc.view.a.decls.len::u32) { ret res[ast_id.DeclId, fail.Fail].err{fail.message("nominal definition is absent from the active resolved owner")}; }
    ret res[ast_id.DeclId, fail.Fail].ok{found};
}

# the interface module `origin` published, read through the walk's acquisition of it
pub fun interface_of(sc: *SemaContext, origin: session.ModuleId) res[*interface.Interface, fail.Fail] {
    if (sc.typing.deps == nil) {
        val reason: fail.Fail = fail.message("a published interface requires a definition reader");
        fail.internal(?sc.status, fail.describe(reason));
        ret res[*interface.Interface, fail.Fail].err{reason};
    }
    val acquired: res[sema_product.Definition, fail.Fail] = sema_product.acquire_definition(?sc.typing.deps.definitions, origin, sema_product.DEFINITION_TYPED);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?sc.status); }
        or                       { fail.internal(?sc.status, fail.describe(reason)); }
        ret res[*interface.Interface, fail.Fail].err{reason};
    }
    ret res[*interface.Interface, fail.Fail].ok{?acquired.ok.sr.interface};
}

# the constant array the `$each` at `sid` reads in the walk's frame
pub fun each_set(sc: *SemaContext, sid: ast_id.StmtId, array: comptime.CTValue) {
    if (sc.typing.insts == nil) { ret; }
    val put: err[fail.Fail] = sema_instance.each_record(?sc.typing.insts.set, sc.instance.frame, sid, array);
    if (sel put.err) { fail.internal(?sc.status, fail.describe(put.err)); }
}

pub fun definition_ast(sc: *SemaContext, origin: session.ModuleId) *ast.Ast {
    if (module.same(origin, sc.view.own_module)) { ret sc.view.a; }
    if (sc.typing.deps == nil) {
        fail.internal(?sc.status, "semantic definition has no dependency reader");
        ret nil;
    }
    val acquired: res[sema_product.Definition, fail.Fail] = sema_product.acquire_definition(?sc.typing.deps.definitions, origin, sema_product.DEFINITION_PARSED);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?sc.status); }
        or                       { fail.internal(?sc.status, fail.describe(reason)); }
        ret nil;
    }
    ret acquired.ok.parsed.a;
}

# the identity a declaration's type parameters carry (type.TypeGenericParam owner
# fields): the one key both interning a parameter and substituting for it use
pub fun generic_owner_of_decl(s: *session.Session, a: *ast.Ast, origin: session.ModuleId,
    decl_id: ast_id.DeclId) res[type.GenericOwner, fail.Fail] {
    val selected: opt[*ast_decl.Decl] = ast.get_decl(a, decl_id);
    if (!sel selected.some) { ret res[type.GenericOwner, fail.Fail].err{fail.message("generic owner declaration is absent from its module")}; }
    val declaration: *ast_decl.Decl = selected.some;
    var name:        lang_source.Span;
    var kind:        type.TypeKind  = type.TYPE_FUN;
    if (declaration.kind == ast_decl.DECL_KIND_FUN) { name = declaration.data.fun_.name; }
    or (declaration.kind == ast_decl.DECL_KIND_REC) {
        name = declaration.data.rec_.name;
        kind = type.TYPE_REC;
    }
    or (declaration.kind == ast_decl.DECL_KIND_UNI) {
        name = declaration.data.uni_.name;
        kind = type.TYPE_UNI;
    }
    or (declaration.kind == ast_decl.DECL_KIND_TAG) {
        name = declaration.data.tag_.name;
        kind = type.TYPE_TAG;
    }
    or { ret res[type.GenericOwner, fail.Fail].err{fail.message("generic owner has the wrong declaration kind")}; }
    val text: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel text.none) { ret res[type.GenericOwner, fail.Fail].err{fail.message("generic owner has no source")}; }
    val canonical: res[intern.StrId, A.Error] = intern.range_add(?s.interner, text.some.text, name.offset, name.len);
    if (sel canonical.err) { ret res[type.GenericOwner, fail.Fail].err{fail.message(lang_alloc.text(canonical.err))}; }
    ret res[type.GenericOwner, fail.Fail].ok{type.GenericOwner{
        owner: resolve.type_owner(s, origin, a.file_id), name: canonical.ok, kind: kind
    }};
}

pub fun generic_param_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    val a: *ast.Ast = definition_ast(sc, sym.origin);
    if (a == nil) { ret type.TYPE_ERROR; }
    val who_r: res[type.GenericOwner, fail.Fail] = generic_owner_of_decl(sc.s, a, sym.origin, sym.decl);
    if (sel who_r.err) {
        fail.internal(?sc.status, fail.describe(who_r.err));
        ret type.TYPE_ERROR;
    }
    val who:        type.GenericOwner           = who_r.ok;
    val res_intern: res[type.TypeId, fail.Fail] = type.intern_generic_param(?sc.s.types, sym.name,
        who.owner, who.name, who.kind, sym.slot);
    if (sel res_intern.err) {
        fail.internal(?sc.status, fail.describe(res_intern.err));
        ret type.TYPE_ERROR;
    }
    ret apply_subst(sc, res_intern.ok);
}

fun fun_decl_for(sc: *SemaContext, did: ast_id.DeclId) opt[*ast_decl.DeclFun] {
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel d_opt.some) { ret opt[*ast_decl.DeclFun].none{}; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret opt[*ast_decl.DeclFun].none{}; }
    ret opt[*ast_decl.DeclFun].some{?d.data.fun_};
}

pub fun embed_len_of(sc: *SemaContext, tid: ast_id.TypeId) u64 {
    if (sc.view.embed_len == nil)                             { ret sema_product.EMBED_LEN_NONE; }
    if (ast_id.type_is_nil(tid))                              { ret sema_product.EMBED_LEN_NONE; }
    if (ast_id.type_index(tid)::usize >= sc.view.a.types.len) { ret sema_product.EMBED_LEN_NONE; }
    ret sc.view.embed_len[ast_id.type_index(tid)];
}

pub fun set_embed_len(sc: *SemaContext, tid: ast_id.TypeId, len: u64) {
    if (sc.view.embed_len == nil)                             { ret; }
    if (ast_id.type_is_nil(tid))                              { ret; }
    if (ast_id.type_index(tid)::usize >= sc.view.a.types.len) { ret; }
    sc.view.embed_len[ast_id.type_index(tid)] = len;
}

test embed_len__preserves_full_u32_domain {
    var a: ast.Ast;
    a.types.len = 1;

    var slots: [1]u64;
    slots[0] = sema_product.EMBED_LEN_NONE;

    var view: ModuleView = ModuleView{};
    view.a         = ?a;
    view.embed_len = ?slots[0];
    var sc: SemaContext = init(nil, nil, Typing{}, view, instance_none());

    set_embed_len(?sc, ast_id.type(0), 0xFFFFFFFF);
    if (embed_len_of(?sc, ast_id.type(0)) != 0xFFFFFFFF) { ret 1; }

    set_embed_len(?sc, ast_id.type(0), 0xFFFFFFFE);
    if (embed_len_of(?sc, ast_id.type(0)) != 0xFFFFFFFE) { ret 1; }
    ret 0;
}

pub fun record_embed_path(sc: *SemaContext, path_id: intern.StrId) err[fail.Fail] {
    var i: u32 = 0;
    for (i < sc.view.embed_path_len) {
        if (intern.str_same(sc.view.embed_paths[i], path_id)) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }

    val grown: err[A.Error] = growth.reserve[intern.StrId](sc.s.alloc, ?sc.view.embed_paths, ?sc.view.embed_path_cap, sc.view.embed_path_len::usize + 1);
    if (sel grown.err) {
        fail.internal(?sc.status, lang_alloc.text(grown.err));
        ret err[fail.Fail].err{fail.refused(grown.err)};
    }

    sc.view.embed_paths[sc.view.embed_path_len] = path_id;
    sc.view.embed_path_len                      = sc.view.embed_path_len + 1;
    ret err[fail.Fail].ok{};
}

# a question to the type store whose internal failures land in this context
pub fun query_of(sc: *SemaContext) type_query.Query {
    ret type_query.Query{types: ?sc.s.types, facts: ?sc.s.type_facts, status: ?sc.status};
}

pub fun recover[T](sc: *SemaContext, r: res[T, fail.Fail], recovery: T) T {
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret recovery;
    }
    ret r.ok;
}

pub fun record_result(sc: *SemaContext, r: err[fail.Fail]) {
    if (sel r.err) { fail.internal(?sc.status, fail.describe(r.err)); }
}

pub fun record_eval_result(sc: *SemaContext, r: res[comptime.CTValue, comptime.EvalFail]) {
    if (sel r.ok) { ret; }
    val f: comptime.EvalFail = r.err;
    if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?sc.status, f.message); }
}

# the string argument `ord` of a decorator evaluates to. one that is
# not a constant expression is refused with `decorator.not_constant`, naming
# the decorator, and a constant that is no string with `kind` and `kind_msg`
pub fun decorator_string_arg(sc: *SemaContext, dec: *ast_decl.Decorator, ord: u32, kind: diagnostic_kind.Kind, kind_msg: str) opt[str] {
    val known: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, ord);
    if (sel known.some) { ret known; }
    val eid: ast_id.ExprId                            = sc.view.a.expr_ids.data[dec.args_start + ord];
    val at:  lang_source.Span                         = decorator_arg_span(sc, eid, dec.name);
    val ev:  res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
    record_eval_result(sc, ev);
    if (sel ev.err) {
        if (ev.err.kind != comptime.EVAL_FAIL_INTERNAL) { report_not_constant(sc, dec, at); }
        ret opt[str].none{};
    }
    if (ev.ok.kind != comptime.CT_KIND_STR) {
        report(sc, kind, at, kind_msg);
        ret opt[str].none{};
    }
    # the load could not read what type checking can: the value no later phase sees
    report_not_constant(sc, dec, at);
    ret opt[str].none{};
}

# an integer argument that is not a constant expression is refused as one;
# a question only a later phase answers, a layout or an instance, is left to it
pub fun require_constant_arg(sc: *SemaContext, dec: *ast_decl.Decorator, ord: u32) {
    val eid: ast_id.ExprId                            = sc.view.a.expr_ids.data[dec.args_start + ord];
    val ev:  res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
    record_eval_result(sc, ev);
    if (sel ev.err && ev.err.diag == diagnostic_kind.COMPTIME_NOT_CONSTANT) {
        report_not_constant(sc, dec, decorator_arg_span(sc, eid, dec.name));
    }
}

pub fun decorator_arg_span(sc: *SemaContext, eid: ast_id.ExprId, fallback: lang_source.Span) lang_source.Span {
    val e: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e.none) { ret fallback; }
    ret e.some.span;
}

fun report_not_constant(sc: *SemaContext, dec: *ast_decl.Decorator, at: lang_source.Span) {
    reportf(sc, diagnostic_kind.DECORATOR_NOT_CONSTANT, at,
        "`{}` decorator argument is not a constant expression: a decorator's arguments are evaluated at compile time in its module", decorator.name_of(dec.id));
}

pub def StmtListVisitor: fun(ptr, *SemaContext, u32, u32) err[fail.Fail];

pub fun source_text_of(s: *session.Session, a: *ast.Ast) res[str, fail.Fail] {
    val opt_file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel opt_file.none) { ret res[str, fail.Fail].err{fail.message("sema: module source not registered")}; }
    ret res[str, fail.Fail].ok{opt_file.some.text};
}

pub fun is_global_binding(kind: ast_decl.DeclKind) bool {
    ret kind == ast_decl.DECL_KIND_VAL || kind == ast_decl.DECL_KIND_VAR;
}

pub fun is_fun_or_global(kind: ast_decl.DeclKind) bool {
    ret kind == ast_decl.DECL_KIND_FUN || kind == ast_decl.DECL_KIND_VAL || kind == ast_decl.DECL_KIND_VAR;
}
