    bare:    intern.StrId;
    depth:   u32;
    parent:  u32;
    site:    token.Span;
}

pub val INST_NONE: u32 = 4294967295;

pub val MAX_CT_INSTANCE_DEPTH: u32 = 32;

pub val MAX_CT_INSTANCES: u32 = 8192;

pub val RECORD_OK:           u8 = 0;
pub val RECORD_LIMIT_DEPTH:  u8 = 1;
pub val RECORD_LIMIT_COUNT:  u8 = 2;

pub rec InstWorklist {
    items:   *InstReq;
    len:     u32;
    cap:     u32;
    drained: u32;
    alloc:   *A.Allocator;
    limited: bool;
    dedup:   map.Map[u64, u32];

    uni_reports:  UniReports;
    secret_state: u8;
}

pub val SECRET_UNKNOWN: u8 = 0;
pub val SECRET_ABSENT:  u8 = 1;
pub val SECRET_PRESENT: u8 = 2;

pub val TYPE_MEMO_NONE:     u8 = 0;
pub val TYPE_MEMO_RESOLVED: u8 = 1;

pub val LAYOUT_PENDING: u8 = 0;
pub val LAYOUT_ACTIVE:  u8 = 1;
pub val LAYOUT_READY:   u8 = 2;
pub val LAYOUT_FAILED:  u8 = 3;

val UNI_REPORT_CAP: u32 = 256;

pub rec UniReports {
    seen: [UNI_REPORT_CAP]type.TypeId;
    len:  u32;
}

pub fun uni_report_mark(ur: *UniReports, key: type.TypeId) bool {
    if (ur == nil) { ret true; }
    var i: u32 = 0;
    for (i < ur.len) {
        if (ur.seen[i] == key) { ret false; }
        i = i + 1;
    }
    if (ur.len >= UNI_REPORT_CAP) { ret true; }
    ur.seen[ur.len] = key;
    ur.len = ur.len + 1;
    ret true;
}

pub rec SemaContext {
    diags: *diagnostic.DiagnosticStore;
    status: fail.PhaseStatus;
    s:          *session.Session;
    a:          *ast.Ast;
    rr:         *resolve.ResolveResult;
    deps:       *SemaDeps;
    ctx:        *comptime.ComptimeCtx;
    caps:       comptime.PhaseCapabilities[SemaContext];
    own_module: session.ModuleId;
    source:     str;

    insts: *InstWorklist;

    collect_insts: bool;

    inst_depth: u32;

    inst_parent: u32;

    silent: bool;

    expr_type:        *type.TypeId;
    type_resolved_ty: *type.TypeId;
    decl_type:        *type.TypeId;

    embed_len: *u64;

    embed_paths:     *intern.StrId;
    embed_path_len:  u32;
    embed_path_cap:  u32;

    type_resolved_memo: *u8;

    layout_state: *u8;

    inst_site:     token.Span;
    inst_site_set: bool;

    in_deferred_arm: bool;

    callee_eid: id.ExprId;

    in_comptime_gate: bool;

    in_fin:         bool;
    fin_loop_depth: u32;

    subst:     *type.TypeId;
    subst_len: u32;
    subst_fn:  fun(*session.Session, type.TypeId, *type.TypeId, u32) R.Result[type.TypeId, str];

    uni_check_fn: fun(*SemaContext, id.TypeId);
    uni_reports:  *UniReports;
    has_secret:   bool;
}

pub fun resolved_type_of(sc: *SemaContext, ast_tid: id.TypeId) type.TypeId {
    if (ast_tid == id.TYPE_NIL)        { ret type.TYPE_NIL; }
    if (sc.type_resolved_ty == nil)    { ret type.TYPE_ERROR; }
    if (ast_tid >= sc.a.type_len::u32) { ret type.TYPE_ERROR; }
    if (sc.has_secret && sc.subst != nil && sc.uni_check_fn != nil) {
        sc.uni_check_fn(sc, ast_tid);
    }
    ret apply_subst(sc, sc.type_resolved_ty[ast_tid]);
}

pub fun expression(sc: *SemaContext, eid: id.ExprId) R.Result[expr.Expr, str] {
    val result: R.Result[expr.Expr, str] = resolve.expression(sc.rr, sc.a, eid);
    if (R.is_err[expr.Expr, str](result)) { fail.internal(?sc.status, R.unwrap_err[expr.Expr, str](result)); }
    ret result;
}

pub fun comptime_expression(sc: *SemaContext, a: *ast.Ast, eid: id.ExprId) R.Result[expr.Expr, comptime.EvalFail] {
    if (sc == nil || sc.a != a) { ret R.err[expr.Expr, comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "semantic expression belongs to a different parsed owner")); }
    val result: R.Result[expr.Expr, str] = expression(sc, eid);
    if (R.is_err[expr.Expr, str](result)) {
        ret R.err[expr.Expr, comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, R.unwrap_err[expr.Expr, str](result)));
    }
    ret R.ok[expr.Expr, comptime.EvalFail](R.unwrap_ok[expr.Expr, str](result));
}

pub fun apply_subst(sc: *SemaContext, tid: type.TypeId) type.TypeId {
    if (sc.subst == nil || sc.subst_len == 0 || sc.subst_fn == nil) { ret tid; }
    ret type_result(sc, sc.subst_fn(sc.s, tid, sc.subst, sc.subst_len));
}

pub fun arg_triggers_revalidation(sc: *SemaContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_ERROR || tid == type.TYPE_NIL) { ret false; }

    if (type.carries_secret(?sc.s.types, tid)) { ret true; }

    if (type_mentions_generic_param(sc, tid)) { ret false; }

    val t_opt: O.Option[*type.Type] = type.get(?sc.s.types, tid);
    if (O.is_none[*type.Type](t_opt)) { ret true; }
    ret !type_is_public_scalar(O.unwrap[*type.Type](t_opt).kind);
}

fun module_rr_for(sc: *SemaContext, origin: session.ModuleId) *resolve.ResolveResult {
    if (origin == sc.own_module) { ret sc.rr; }
    if (sc.deps == nil) { fail.internal(?sc.status, "semantic definition has no dependency reader"); ret nil; }
    val acquired: R.Result[Definition, fail.Fail] = acquire_definition(?sc.deps.definitions, origin, DEFINITION_RESOLVED);
    if (R.is_err[Definition, fail.Fail](acquired)) {
        val reason: fail.Fail = R.unwrap_err[Definition, fail.Fail](acquired);
        if (reason.kind == fail.REPORTED) { fail.reject(?sc.status); }
        or { fail.internal(?sc.status, reason.message); }
        ret nil;
    }
    ret R.unwrap_ok[Definition, fail.Fail](acquired).rr;
}

fun callee_is_c_variadic(sc: *SemaContext, rr: *resolve.ResolveResult, callee_eid: id.ExprId) bool {
    if (rr == nil || rr.expr_resolved == nil || rr.symbols == nil) { ret false; }
    if (callee_eid == id.EXPR_NIL || callee_eid >= rr.expr_count)  { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[callee_eid];
    if (sid == resolve.SYMBOL_NIL || sid >= rr.symbol_count)       { ret false; }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED) { ret false; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret false; }
    val acquired: R.Result[DefinedSymbol, fail.Fail] = symbol_definition(sc, sym, DEFINITION_RESOLVED);
    if (R.is_err[DefinedSymbol, fail.Fail](acquired)) { ret false; }
    val current: DefinedSymbol = R.unwrap_ok[DefinedSymbol, fail.Fail](acquired);
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(current.definition.parsed.a, current.symbol.decl);
    if (O.is_none[*decl.Decl](d_opt)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_FUN) { ret false; }
    ret d.data.fun_.c_variadic;
}

fun call_has_spread_arg(a: *ast.Ast, e: *expr.Expr) bool {
    var i: u32 = 0;
    for (i < e.data.call.args_len) {
        val ix: u32 = e.data.call.args_start + i;
        if (ix::usize < a.expr_id_len) {
            val ao: O.Option[*expr.Expr] = ast.get_expr(a, a.expr_ids[ix]);
            if (O.is_some[*expr.Expr](ao)
                && O.unwrap[*expr.Expr](ao).kind == expr.EXPR_KIND_SPREAD) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun callee_body_reaches(sc: *SemaContext, rr: *resolve.ResolveResult, callee_eid: id.ExprId,
                        want_spread: bool, seen: *ReachSeen) bool {
    if (rr == nil || rr.expr_resolved == nil || rr.symbols == nil) { ret false; }
    if (callee_eid == id.EXPR_NIL || callee_eid >= rr.expr_count)  { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[callee_eid];
    if (sid == resolve.SYMBOL_NIL || sid >= rr.symbol_count)       { ret false; }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED) { ret false; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret false; }
    val acquired: R.Result[DefinedSymbol, fail.Fail] = symbol_definition(sc, sym, DEFINITION_RESOLVED);
    if (R.is_err[DefinedSymbol, fail.Fail](acquired)) { ret false; }
    val current: DefinedSymbol = R.unwrap_ok[DefinedSymbol, fail.Fail](acquired);
    ret decl_reaches_c_variadic(sc, current.symbol.origin, current.symbol.decl, want_spread, seen);
}

fun expr_has_c_variadic_call(sc: *SemaContext, a: *ast.Ast, rr: *resolve.ResolveResult, eid: id.ExprId, want_spread: bool, seen: *ReachSeen) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val e_opt: R.Result[expr.Expr, str] = resolve.expression(rr, a, eid);
    if (R.is_err[expr.Expr, str](e_opt)) {
        fail.internal(?sc.status, R.unwrap_err[expr.Expr, str](e_opt));
        ret false;
    }
    var e_value: expr.Expr = R.unwrap_ok[expr.Expr, str](e_opt);
    val e: *expr.Expr = ?e_value;
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_CALL) {
        val spread_here: bool = call_has_spread_arg(a, e);
        if (callee_is_c_variadic(sc, rr, e.data.call.callee)
            && (!want_spread || spread_here)) { ret true; }
        if (!want_spread || spread_here) {
            if (callee_body_reaches(sc, rr, e.data.call.callee, want_spread, seen)) { ret true; }
        }
        if (expr_has_c_variadic_call(sc, a, rr, e.data.call.callee, want_spread, seen)) { ret true; }
        var i: u32 = 0;
        for (i < e.data.call.args_len) {
            val ix: u32 = e.data.call.args_start + i;
            if (ix::usize < a.expr_id_len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == expr.EXPR_KIND_BINARY) {
        if (expr_has_c_variadic_call(sc, a, rr, e.data.binary.lhs, want_spread, seen)) { ret true; }
        ret expr_has_c_variadic_call(sc, a, rr, e.data.binary.rhs, want_spread, seen);
    }
    if (k == expr.EXPR_KIND_UNARY)  { ret expr_has_c_variadic_call(sc, a, rr, e.data.unary.operand, want_spread, seen); }
    if (k == expr.EXPR_KIND_INDEX)  { ret expr_has_c_variadic_call(sc, a, rr, e.data.index.object, want_spread, seen); }
    if (k == expr.EXPR_KIND_MEMBER) { ret expr_has_c_variadic_call(sc, a, rr, e.data.member.object, want_spread, seen); }
    if (k == expr.EXPR_KIND_PROJECT){ ret expr_has_c_variadic_call(sc, a, rr, e.data.project.object, want_spread, seen); }
    if (k == expr.EXPR_KIND_SPREAD) { ret expr_has_c_variadic_call(sc, a, rr, e.data.spread.inner, want_spread, seen); }
    if (k == expr.EXPR_KIND_CAST)   { ret expr_has_c_variadic_call(sc, a, rr, e.data.cast.value, want_spread, seen); }
    if (k == expr.EXPR_KIND_STRIP)  { ret expr_has_c_variadic_call(sc, a, rr, e.data.strip.value, want_spread, seen); }
    if (k == expr.EXPR_KIND_ARRAY_LIT) {
        var i: u32 = 0;
        for (i < e.data.array_lit.elems_len) {
            val ix: u32 = e.data.array_lit.elems_start + i;
            if (ix::usize < a.expr_id_len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == expr.EXPR_KIND_VECTOR_LIT) {
        var i: u32 = 0;
        for (i < e.data.vector_lit.elems_len) {
            val ix: u32 = e.data.vector_lit.elems_start + i;
            if (ix::usize < a.expr_id_len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == expr.EXPR_KIND_STRUCT_LIT) {
        var i: u32 = 0;
        for (i < e.data.struct_lit.fields_len) {
            val ix: u32 = e.data.struct_lit.fields_start + i;
            if (ix::usize < a.field_init_len
                && expr_has_c_variadic_call(sc, a, rr, a.field_inits[ix].value, want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    ret false;
}

fun decl_body_calls_c_variadic(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId) bool {
    ret decl_body_reaches_c_variadic(sc, origin, did, false);
}

pub fun decl_body_spreads_pack_to_c_variadic(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId) bool {
    ret decl_body_reaches_c_variadic(sc, origin, did, true);
}

val REACH_MAX_VISITED: u32 = 64;

rec ReachSeen {
    origins: *u32;
    decls:   *u32;
    len:     u32;
}

fun reach_visit(seen: *ReachSeen, origin: session.ModuleId, did: id.DeclId) bool {
    var i: u32 = 0;
    for (i < seen.len) {
        if (seen.origins[i] == origin::u32 && seen.decls[i] == did::u32) { ret false; }
        i = i + 1;
    }
    if (seen.len >= REACH_MAX_VISITED) { ret false; }
    seen.origins[seen.len] = origin::u32;
    seen.decls[seen.len]   = did::u32;
    seen.len = seen.len + 1;
    ret true;
}

fun decl_body_reaches_c_variadic(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId, want_spread: bool) bool {
    var so: [REACH_MAX_VISITED]u32;
    var sd: [REACH_MAX_VISITED]u32;
    var seen: ReachSeen;
    seen.origins = ?so[0];
    seen.decls   = ?sd[0];
    seen.len     = 0;
    ret decl_reaches_c_variadic(sc, origin, did, want_spread, ?seen);
}

fun decl_reaches_c_variadic(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId,
                            want_spread: bool, seen: *ReachSeen) bool {
    if (!reach_visit(seen, origin, did)) { ret false; }
    val a: *ast.Ast = definition_ast(sc, origin);
    if (a == nil) { ret false; }
    val rr: *resolve.ResolveResult = module_rr_for(sc, origin);
    if (rr == nil) { ret false; }

    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_FUN)    { ret false; }
    if (d.data.fun_.body == id.STMT_NIL) { ret false; }
    ret stmt_calls_c_variadic(sc, a, rr, d.data.fun_.body, want_spread, seen);
}

fun stmt_calls_c_variadic(sc: *SemaContext, a: *ast.Ast, rr: *resolve.ResolveResult, sid: id.StmtId, want_spread: bool, seen: *ReachSeen) bool {
    if (sid == id.STMT_NIL) { ret false; }
    val s_opt: O.Option[*stmt.Stmt] = ast.get_stmt(a, sid);
    if (O.is_none[*stmt.Stmt](s_opt)) { ret false; }
    val s: *stmt.Stmt = O.unwrap[*stmt.Stmt](s_opt);
    val k: stmt.StmtKind = s.kind;

    if (k == stmt.STMT_KIND_EXPR) { ret expr_has_c_variadic_call(sc, a, rr, s.data.expr.expr, want_spread, seen); }
    if (k == stmt.STMT_KIND_RET)  { ret expr_has_c_variadic_call(sc, a, rr, s.data.ret_.value, want_spread, seen); }
    if (k == stmt.STMT_KIND_DECL) {
        val dd_opt: O.Option[*decl.Decl] = ast.get_decl(a, s.data.decl.decl);
        if (O.is_none[*decl.Decl](dd_opt)) { ret false; }
        val dd: *decl.Decl = O.unwrap[*decl.Decl](dd_opt);
        if (dd.kind != decl.DECL_KIND_VAL && dd.kind != decl.DECL_KIND_VAR) { ret false; }
        ret expr_has_c_variadic_call(sc, a, rr, dd.data.bind.init, want_spread, seen);
    }
    if (k == stmt.STMT_KIND_IF) {
        if (expr_has_c_variadic_call(sc, a, rr, s.data.if_.cond, want_spread, seen))   { ret true; }
        if (stmt_calls_c_variadic(sc, a, rr, s.data.if_.then_block, want_spread, seen)) { ret true; }
        ret stmt_calls_c_variadic(sc, a, rr, s.data.if_.else_block, want_spread, seen);
    }
    if (k == stmt.STMT_KIND_FOR) {
        if (expr_has_c_variadic_call(sc, a, rr, s.data.for_.cond, want_spread, seen)) { ret true; }
        ret stmt_calls_c_variadic(sc, a, rr, s.data.for_.body, want_spread, seen);
    }
    if (k == stmt.STMT_KIND_FIN) { ret stmt_calls_c_variadic(sc, a, rr, s.data.fin_.body, want_spread, seen); }
    if (k == stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids[s.data.block.stmts_start + i], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == stmt.STMT_KIND_COMPTIME_IF) {
        var bi: u32 = 0;
        for (bi < s.data.comptime_if.branches_len) {
            val br: *decl.ComptimeBranch = ?a.comptime_branches[s.data.comptime_if.branches_start + bi];
            var si2: u32 = 0;
            for (si2 < br.body_len) {
                if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids[br.body_start + si2], want_spread, seen)) { ret true; }
                si2 = si2 + 1;
            }
            bi = bi + 1;
        }
        ret false;
    }
    if (k == stmt.STMT_KIND_COMPTIME_EACH) {
        var ei: u32 = 0;
        for (ei < s.data.comptime_each.body_len) {
            if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids[s.data.comptime_each.body_start + ei], want_spread, seen)) { ret true; }
            ei = ei + 1;
        }
        ret false;
    }

    ret false;
}

fun decl_body_has_type_directive(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId) bool {
    val a: *ast.Ast = definition_ast(sc, origin);
    if (a == nil) { ret false; }

    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_FUN)        { ret false; }
    if (d.data.fun_.body == id.STMT_NIL)     { ret false; }
    ret stmt_has_type_directive(a, d.data.fun_.body);
}

fun stmt_has_type_directive(a: *ast.Ast, sid: id.StmtId) bool {
    if (sid == id.STMT_NIL) { ret false; }
    val s_opt: O.Option[*stmt.Stmt] = ast.get_stmt(a, sid);
    if (O.is_none[*stmt.Stmt](s_opt)) { ret false; }
    val s: *stmt.Stmt = O.unwrap[*stmt.Stmt](s_opt);
    val k: stmt.StmtKind = s.kind;

    if (k == stmt.STMT_KIND_COMPTIME_IF || k == stmt.STMT_KIND_COMPTIME_EACH
     || k == stmt.STMT_KIND_COMPTIME_ATTR) { ret true; }

    if (k == stmt.STMT_KIND_EXPR || k == stmt.STMT_KIND_RET || k == stmt.STMT_KIND_BRK
     || k == stmt.STMT_KIND_CNT  || k == stmt.STMT_KIND_DECL || k == stmt.STMT_KIND_ASM
     || k == stmt.STMT_KIND_ERROR) { ret false; }

    if (k == stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            if (stmt_has_type_directive(a, a.stmt_ids[s.data.block.stmts_start + i])) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == stmt.STMT_KIND_IF) {
        if (stmt_has_type_directive(a, s.data.if_.then_block)) { ret true; }
        ret stmt_has_type_directive(a, s.data.if_.else_block);
    }
    if (k == stmt.STMT_KIND_FOR) { ret stmt_has_type_directive(a, s.data.for_.body); }
    if (k == stmt.STMT_KIND_FIN) { ret stmt_has_type_directive(a, s.data.fin_.body); }

    ret true;
}

pub fun type_mentions_generic_param(sc: *SemaContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_ERROR || tid == type.TYPE_NIL) { ret false; }
    val t_opt: O.Option[*type.Type] = type.get(?sc.s.types, tid);
    if (O.is_none[*type.Type](t_opt)) { ret false; }
    val t: *type.Type = O.unwrap[*type.Type](t_opt);

    if (t.kind == type.TYPE_GENERIC_PARAM) { ret true; }
    if (t.kind == type.TYPE_POINTER)       { ret type_mentions_generic_param(sc, t.data.pointer.base); }
    if (t.kind == type.TYPE_SECRET)        { ret type_mentions_generic_param(sc, t.data.secret.base); }
    if (t.kind == type.TYPE_ARRAY)         { ret type_mentions_generic_param(sc, t.data.array.base); }

    if (t.kind == type.TYPE_FUN) {
        if (type_mentions_generic_param(sc, t.data.fn.ret_type)) { ret true; }
        var i: u32 = 0;
        for (i < t.data.fn.params_len) {
            val opt_p: O.Option[type.TypeId] = type.get_param(?sc.s.types, t.data.fn.params_start + i);
            if (O.is_some[type.TypeId](opt_p) && type_mentions_generic_param(sc, O.unwrap[type.TypeId](opt_p))) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    if (t.kind == type.TYPE_INSTANCE) {
        var i: u32 = 0;
        for (i < t.data.instance.args_len) {
            val opt_a: O.Option[type.TypeId] = type.get_param(?sc.s.types, t.data.instance.args_start + i);
            if (O.is_some[type.TypeId](opt_a) && type_mentions_generic_param(sc, O.unwrap[type.TypeId](opt_a))) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

fun type_is_public_scalar(k: type.TypeKind) bool {
    val c: type.PrimClass = type.prim_desc(k).class;
    ret c == type.PRIM_CLASS_INT || c == type.PRIM_CLASS_FLOAT || c == type.PRIM_CLASS_PTR;
}

fun args_equal(a: *type.TypeId, b: *type.TypeId, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun record_instance(sc: *SemaContext, origin: session.ModuleId, decl: id.DeclId,
                        args: *type.TypeId, arg_len: u32, sig: type.TypeId,
                        bare: intern.StrId, site: token.Span) R.Result[u8, str] {
    if (!sc.collect_insts) { ret R.ok[u8, str](RECORD_OK); }
    if (arg_len == 0)      { ret R.ok[u8, str](RECORD_OK); }

    var any: bool = false;
    var i: u32 = 0;
    for (i < arg_len) {
        if (arg_triggers_revalidation(sc, args[i])) { any = true; }
        if (sc.has_secret && args[i] != type.TYPE_ERROR && args[i] != type.TYPE_NIL
            && !type_mentions_generic_param(sc, args[i])) { any = true; }
        i = i + 1;
    }
    if (!any && decl_body_has_type_directive(sc, origin, decl)) { any = true; }
    if (!any && decl_body_calls_c_variadic(sc, origin, decl)) { any = true; }
    if (!any) { ret R.ok[u8, str](RECORD_OK); }

    if (sc.insts == nil) {
        val wr: R.Result[*InstWorklist, str] = inst_worklist_new(sc.s.alloc);
        if (R.is_err[*InstWorklist, str](wr)) { fail.internal(?sc.status, R.unwrap_err[*InstWorklist, str](wr)); ret R.err[u8, str](R.unwrap_err[*InstWorklist, str](wr)); }
        sc.insts = R.unwrap_ok[*InstWorklist, str](wr);
    }
    val wl: *InstWorklist = sc.insts;

    val h: u64 = hash_inst_req(origin, decl, args, arg_len);
    val res_get: R.Result[*u32, str] = map.get[u64, u32](?wl.dedup, ?h);
    if (R.is_ok[*u32, str](res_get)) {
        val existing_idx: u32 = @R.unwrap_ok[*u32, str](res_get);
        val existing: *InstReq = ?wl.items[existing_idx];
        if (existing.origin == origin && existing.decl == decl && existing.arg_len == arg_len
            && args_equal(existing.args, args, arg_len)) {
            ret R.ok[u8, str](RECORD_OK);
        }
    }

    if (wl.limited) { ret R.ok[u8, str](RECORD_OK); }

    if (sc.inst_depth > MAX_CT_INSTANCE_DEPTH) {
        wl.limited = true;
        ret R.ok[u8, str](RECORD_LIMIT_DEPTH);
    }
    if (wl.len >= MAX_CT_INSTANCES) {
        wl.limited = true;
        ret R.ok[u8, str](RECORD_LIMIT_COUNT);
    }

    if (wl.len == wl.cap) {
        var new_cap: u32 = 8;
        if (wl.cap > 0) { new_cap = wl.cap * 2; }
        var nr: R.Result[*InstReq, str] = A.allocate[InstReq](wl.alloc, new_cap::usize);
        if (wl.cap > 0) { nr = A.reallocate[InstReq](wl.alloc, wl.items, wl.cap::usize, new_cap::usize); }
        if (R.is_err[*InstReq, str](nr)) { fail.internal(?sc.status, R.unwrap_err[*InstReq, str](nr)); ret R.err[u8, str]("internal: out of memory growing the constant-time re-validation worklist"); }
        wl.items = R.unwrap_ok[*InstReq, str](nr);
        wl.cap   = new_cap;
    }

    val cr: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](wl.alloc, arg_len::usize);
    if (R.is_err[*type.TypeId, str](cr)) { fail.internal(?sc.status, R.unwrap_err[*type.TypeId, str](cr)); ret R.err[u8, str]("internal: out of memory copying a generic instance's type arguments"); }
    val owned: *type.TypeId = R.unwrap_ok[*type.TypeId, str](cr);
    var k: u32 = 0;
    for (k < arg_len) { owned[k] = args[k]; k = k + 1; }

    val new_idx: u32 = wl.len;
    val slot: *InstReq = ?wl.items[new_idx];
    slot.origin  = origin;
    slot.decl    = decl;
    slot.sig     = sig;
    slot.args    = owned;
    slot.arg_len = arg_len;
    slot.bare    = bare;
    slot.depth   = sc.inst_depth;
    slot.parent  = sc.inst_parent;
    slot.site    = site;
    wl.len = wl.len + 1;

    val res_insert: R.Result[bool, str] = map.insert[u64, u32](?wl.dedup, h, new_idx);
    if (R.is_err[bool, str](res_insert)) { ret R.err[u8, str](R.unwrap_err[bool, str](res_insert)); }

    ret R.ok[u8, str](RECORD_OK);
}

fun hash_inst_req(origin: session.ModuleId, decl: id.DeclId, args: *type.TypeId, arg_len: u32) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u32(h, origin::u32);
    h = fnv1a.step_u32(h, decl::u32);
    h = fnv1a.step_u32(h, arg_len);

    var i: u32 = 0;
    for (i < arg_len) {
        h = fnv1a.step_u32(h, args[i]::u32);
        i = i + 1;
    }
    ret h;
}

pub fun inst_worklist_new(alloc: *A.Allocator) R.Result[*InstWorklist, str] {
    val wr: R.Result[*InstWorklist, str] = A.allocate[InstWorklist](alloc, 1::usize);
    if (R.is_err[*InstWorklist, str](wr)) { ret R.err[*InstWorklist, str]("internal: out of memory allocating the constant-time re-validation worklist"); }
    val wl: *InstWorklist = R.unwrap_ok[*InstWorklist, str](wr);
    wl.items            = nil;
    wl.len              = 0;
    wl.cap              = 0;
    wl.drained          = 0;
    wl.alloc            = alloc;
    wl.uni_reports.len  = 0;
    wl.secret_state     = SECRET_UNKNOWN;
    wl.limited          = false;
    wl.dedup            = map.init[u64, u32](alloc, map.hash_u64, map.eq_u64);
    ret R.ok[*InstWorklist, str](wl);
}

pub fun inst_worklist_free(wl: *InstWorklist) {
    if (wl == nil) { ret; }
    var i: u32 = 0;
    for (i < wl.len) {
        val e: *InstReq = ?wl.items[i];
        if (e.args != nil && e.arg_len > 0) {
            A.deallocate[type.TypeId](wl.alloc, e.args, e.arg_len::usize);
        }
        i = i + 1;
    }
    if (wl.items != nil && wl.cap > 0) {
        A.deallocate[InstReq](wl.alloc, wl.items, wl.cap::usize);
    }
    map.dnit[u64, u32](?wl.dedup);
    A.deallocate[InstWorklist](wl.alloc, wl, 1::usize);
}

pub fun inst_worklist_dnit(sc: *SemaContext) {
    inst_worklist_free(sc.insts);
    sc.insts = nil;
}

pub fun module_sema_for(sc: *SemaContext, module: session.ModuleId) O.Option[*ModuleSema] {
    if (sc.deps == nil) { ret O.none[*ModuleSema](); }
    var i: u32 = 0;
    for (i < sc.deps.count) {
        val ms: *ModuleSema = ?sc.deps.entries[i];
        if (ms.module == module) { ret O.some[*ModuleSema](ms); }
        i = i + 1;
    }
    ret O.none[*ModuleSema]();
}

pub fun public_type_for(sc: *SemaContext, sym: *resolve.Symbol) O.Option[TypeExport] {
    if (sc.deps == nil) { ret O.none[TypeExport](); }
    val owner: session.StableModuleId = resolve.type_owner(sc.s, sym.origin, sym.definition_file).module;
    var i: u32 = 0;
    for (i < sc.deps.count) {
        val module: *ModuleSema = ?sc.deps.entries[i];
        var j: usize = 0;
        for (j < module.exports.len) {
            val item: TypeExport = module.exports.data[j];
            if (item.origin == owner && item.canon == sym.canon) { ret O.some[TypeExport](item); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret O.none[TypeExport]();
}

pub fun decl_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    if (sym.kind == resolve.SYM_PARAM) { ret param_type_for(sc, sym); }
    if (sym.kind == resolve.SYM_GENERIC) { ret generic_param_type_for(sc, sym); }
    if (sym.origin == sc.own_module) {
        if (sc.decl_type == nil || sym.decl == id.DECL_NIL || sym.decl >= sc.a.decl_len::u32) { ret type.TYPE_ERROR; }
        ret sc.decl_type[sym.decl];
    }
    val exported: O.Option[TypeExport] = public_type_for(sc, sym);
    if (O.is_none[TypeExport](exported)) {
        fail.internal(?sc.status, "imported type has no acquired public surface");
        ret type.TYPE_ERROR;
    }
    ret O.unwrap[TypeExport](exported).ty;
}

pub fun symbol_for_expr(sc: *SemaContext, eid: id.ExprId) O.Option[*resolve.Symbol] {
    if (sc.rr == nil || sc.rr.expr_resolved == nil) { ret O.none[*resolve.Symbol](); }
    if (eid >= sc.rr.expr_count)                    { ret O.none[*resolve.Symbol](); }
    val sid: resolve.SymbolId = sc.rr.expr_resolved[eid];
    ret symbol_by_id(sc, sid);
}

pub fun comptime_ident_is_runtime(sc: *SemaContext, eid: id.ExprId) bool {
    if (sc == nil || eid == id.EXPR_NIL) { ret false; }
    val opt_sym: O.Option[*resolve.Symbol] = symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
    ret resolve.symbol_is_runtime(O.unwrap[*resolve.Symbol](opt_sym));
}

pub fun symbol_for_type(sc: *SemaContext, tid: id.TypeId) O.Option[*resolve.Symbol] {
    if (sc.rr == nil || sc.rr.type_resolved == nil) { ret O.none[*resolve.Symbol](); }
    if (tid >= sc.rr.type_count)                    { ret O.none[*resolve.Symbol](); }
    val sid: resolve.SymbolId = sc.rr.type_resolved[tid];
    ret symbol_by_id(sc, sid);
}

pub fun symbol_by_id(sc: *SemaContext, sid: resolve.SymbolId) O.Option[*resolve.Symbol] {
    if (sid == resolve.SYMBOL_NIL)            { ret O.none[*resolve.Symbol](); }
    if (sc.rr == nil || sc.rr.symbols == nil) { ret O.none[*resolve.Symbol](); }
    if (sid >= sc.rr.symbol_count)            { ret O.none[*resolve.Symbol](); }
    ret O.some[*resolve.Symbol](?sc.rr.symbols[sid]);
}

pub fun ptr_width_of(sc: *SemaContext) u32 {
    ret sc.ctx.env.pointer_width;
}

pub fun machine_of(sc: *SemaContext) layout.Machine {
    ret layout.machine(sc.ctx.env.pointer_width, sc.ctx.env.vector_bits);
}

pub fun report(sc: *SemaContext, span: token.Span, message: str) {
    if (sc.silent) { ret; }
    fail.reject(?sc.status);
    if (sc.in_comptime_gate) {
        val r: R.Result[bool, str] = diagnostic.gate_error(sc.diags, ?sc.s.interner, sc.a.file_id, span, message);
        if (R.is_err[bool, str](r)) { fail.internal(?sc.status, R.unwrap_err[bool, str](r)); }
        ret;
    }
    val r: R.Result[R.Void, str] = diagnostic.error(sc.diags, sc.a.file_id, span, message);
    if (R.is_err[R.Void, str](r)) { fail.internal(?sc.status, R.unwrap_err[R.Void, str](r)); }
}

pub fun report_internal(sc: *SemaContext, span: token.Span, message: str) {
    fail.internal(?sc.status, message);
}

pub fun type_result(sc: *SemaContext, r: R.Result[type.TypeId, str]) type.TypeId {
    if (R.is_err[type.TypeId, str](r)) {
        fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](r));
        ret type.TYPE_ERROR;
    }
    ret R.unwrap_ok[type.TypeId, str](r);
}

pub fun diag_mark(sc: *SemaContext) u64 {
    ret sc.status.rejections;
}

pub fun reported_since(sc: *SemaContext, mark: u64) bool {
    ret sc.status.rejections != mark;
}

pub fun report_warning(sc: *SemaContext, span: token.Span, message: str) {
    if (sc.silent || sc.in_comptime_gate) { ret; }
    val r: R.Result[R.Void, str] = diagnostic.warning(sc.diags, sc.a.file_id, span, message);
    if (R.is_err[R.Void, str](r)) { fail.internal(?sc.status, R.unwrap_err[R.Void, str](r)); }
}

pub fun report_note(sc: *SemaContext, span: token.Span, message: str, note: str) {
    if (sc.silent) { ret; }
    fail.reject(?sc.status);

    val b_r: R.Result[diagnostic.DiagnosticBuilder, str] = diagnostic.builder_init(sc.s.diags.a, diagnostic.SEVERITY_ERROR, sc.a.file_id, span, message);
    if (R.is_err[diagnostic.DiagnosticBuilder, str](b_r)) { fail.internal(?sc.status, R.unwrap_err[diagnostic.DiagnosticBuilder, str](b_r)); ret; }
    var b: diagnostic.DiagnosticBuilder = R.unwrap_ok[diagnostic.DiagnosticBuilder, str](b_r);

    val ar: R.Result[R.Void, str] = diagnostic.attach_note(?b, note);
    if (R.is_err[R.Void, str](ar)) { diagnostic.builder_dnit(?b); fail.internal(?sc.status, R.unwrap_err[R.Void, str](ar)); ret; }

    if (sc.in_comptime_gate) {
        val r: R.Result[bool, str] = diagnostic.gate_commit(sc.diags, ?sc.s.interner, ?b);
        if (R.is_err[bool, str](r)) { fail.internal(?sc.status, R.unwrap_err[bool, str](r)); }
        ret;
    }

    val cr: R.Result[diagnostic.DiagnosticId, str] = diagnostic.commit(?b, sc.diags);
    if (R.is_err[diagnostic.DiagnosticId, str](cr)) { diagnostic.builder_dnit(?b); fail.internal(?sc.status, R.unwrap_err[diagnostic.DiagnosticId, str](cr)); ret; }
}

pub fun report_numbered(sc: *SemaContext, span: token.Span, prefix: str, n: usize, suffix: str, fallback: str) {
    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc, "{}{}{}", prefix, n, suffix);
    if (R.is_err[str, str](res_msg)) {
        fail.internal(?sc.status, R.unwrap_err[str, str](res_msg));
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

pub fun field_table_stage(sc: *SemaContext, additional: u32) R.Result[u32, str] {
    ret type.field_table_stage(?sc.s.types, additional);
}

pub fun field_table_stage_push(sc: *SemaContext, name: intern.StrId, ty: type.TypeId) R.Result[R.Void, str] {
    ret type.field_table_stage_push(?sc.s.types, name, ty);
}

pub fun field_table_publish(sc: *SemaContext, ty: type.TypeId, fields_start: u32, fields_len: u32) R.Result[R.Void, str] {
    ret type.field_table_publish(?sc.s.types, ty, fields_start, fields_len);
}


pub fun field_table_for(sc: *SemaContext, ty: type.TypeId) O.Option[*FieldTable] {
    ret type.field_table_for(?sc.s.types, ty);
}

pub fun field_epoch(sc: *SemaContext) u32 {
    ret type.field_epoch(?sc.s.types);
}

pub fun field_lookup(sc: *SemaContext, ty: type.TypeId, name: intern.StrId) O.Option[type.TypeId] {
    val ft_opt: O.Option[*FieldTable] = field_table_for(sc, ty);
    if (O.is_none[*FieldTable](ft_opt)) { ret O.none[type.TypeId](); }
    val ft: *FieldTable = O.unwrap[*FieldTable](ft_opt);

    var i: u32 = 0;
    for (i < ft.fields_len) {
        val fe: *type.FieldEntry = type.field_entry_at(?sc.s.types, ft, i);
        if (fe.name == name) { ret O.some[type.TypeId](fe.ty); }
        i = i + 1;
    }
    ret O.none[type.TypeId]();
}

pub fun resolve_field_member(sc: *SemaContext, owner: u32, index: u32, pick: u8) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }

    if (pick == comptime.FIELD_SEL_ZERO_BY_NAME) {
        ret resolve_omitted_field_zero(sc, owner::type.TypeId, index::intern.StrId);
    }

    val fa: O.Option[*type.FieldEntry] = type.field_at(?sc.s.types, owner::type.TypeId, index);
    if (O.is_none[*type.FieldEntry](fa)) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    val fe: *type.FieldEntry = O.unwrap[*type.FieldEntry](fa);

    if (pick == comptime.FIELD_SEL_NAME) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](comptime.ct_str(fe.name)));
    }
    if (pick == comptime.FIELD_SEL_TYPE) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](comptime.ct_type(fe.ty::u32)));
    }
    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
}

fun resolve_omitted_field_zero(sc: *SemaContext, owner_ty: type.TypeId, name: intern.StrId) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    val stripped: type.TypeId = type.strip_secret(?sc.s.types, owner_ty);
    val n: u32 = type.field_count(?sc.s.types, stripped);
    var i: u32 = 0;
    for (i < n) {
        val fa: O.Option[*type.FieldEntry] = type.field_at(?sc.s.types, stripped, i);
        if (O.is_some[*type.FieldEntry](fa)) {
            val fe: *type.FieldEntry = O.unwrap[*type.FieldEntry](fa);
            if (fe.name == name) {
                val fty: type.TypeId = type.strip_secret(?sc.s.types, fe.ty);
                val ft: O.Option[*type.Type] = type.get(?sc.s.types, fty);
                if (O.is_none[*type.Type](ft)) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
                val kind: type.TypeKind = O.unwrap[*type.Type](ft).kind;
                val pd: type.PrimDesc = type.prim_desc(kind);
                if (pd.class == type.PRIM_CLASS_INT) {
                    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](
                        O.some[comptime.CTValue](comptime.ct_zero_int(!pd.signed, pd.bits::u8)));
                }
                if (pd.class == type.PRIM_CLASS_FLOAT) {
                    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](
                        O.some[comptime.CTValue](comptime.ct_float(0.0, type.float_width_of(kind))));
                }
                ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
            }
        }
        i = i + 1;
    }
    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
}

pub fun resolve_type_comparison_operand(sc: *SemaContext, eid: id.ExprId) R.Result[O.Option[u32], comptime.EvalFail] {
    if (sc == nil)           { ret R.ok[O.Option[u32], comptime.EvalFail](O.none[u32]()); }
    if (sc.expr_type == nil) { ret R.ok[O.Option[u32], comptime.EvalFail](O.none[u32]()); }
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret R.ok[O.Option[u32], comptime.EvalFail](O.none[u32]()); }
    val t: type.TypeId = sc.expr_type[eid];
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret R.ok[O.Option[u32], comptime.EvalFail](O.none[u32]()); }
    ret R.ok[O.Option[u32], comptime.EvalFail](O.some[u32](t::u32));
}

fun gated_member_const_message(sc: *SemaContext, name: intern.StrId, dep_path: intern.StrId) str {
    val fallback: str = "tuple-dependent public constants are not yet supported in union builds";
    val no: O.Option[str] = intern.lookup(?sc.s.interner, name);
    val fo: O.Option[str] = intern.lookup(?sc.s.interner, dep_path);
    if (O.is_none[str](no) || O.is_none[str](fo)) { ret fallback; }

    val res_msg: R.Result[str, str] = format.sprint(sc.s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        O.unwrap[str](no), O.unwrap[str](fo));
    if (R.is_err[str, str](res_msg)) { fail.internal(?sc.status, R.unwrap_err[str, str](res_msg)); ret fallback; }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    val ir: R.Result[intern.StrId, str] = intern.intern(?sc.s.interner, buf);
    str_free(sc.s.alloc, buf);
    if (R.is_err[intern.StrId, str](ir)) { fail.internal(?sc.status, R.unwrap_err[intern.StrId, str](ir)); ret fallback; }

    val nm: O.Option[str] = intern.lookup(?sc.s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret fallback;
}

pub fun resolve_module_member_const(sc: *SemaContext, eid: id.ExprId) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    val rr: *resolve.ResolveResult = sc.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val sid: resolve.SymbolId = rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid::u32 >= rr.symbol_count) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_IMPORTED) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val exported: O.Option[TypeExport] = public_type_for(sc, sym);
    if (O.is_none[TypeExport](exported) || !O.unwrap[TypeExport](exported).constant.present) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val item: TypeExport = O.unwrap[TypeExport](exported);
    val named: resolve.ExportConstant = item.constant;
    if (named.value.kind == comptime.CT_KIND_CONST_ELEM) {
        val current: R.Result[DefinedSymbol, fail.Fail] = imported_definition(sc, sym, DEFINITION_RESOLVED);
        if (R.is_err[DefinedSymbol, fail.Fail](current)) {
            val reason: fail.Fail = R.unwrap_err[DefinedSymbol, fail.Fail](current);
            var kind: comptime.EvalFailKind = comptime.EVAL_FAIL_INTERNAL;
            if (reason.kind == fail.REPORTED) { kind = comptime.EVAL_FAIL_REJECTED; }
            ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_error(kind, reason.message));
        }
        if (R.unwrap_ok[DefinedSymbol, fail.Fail](current).definition.parsed.incarnation != item.definition_incarnation) {
            fail.internal(?sc.status, "constant element does not belong to the acquired parsed definition");
            ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, sc.status.message));
        }
    }
    if (named.gated && sc.ctx.env.union_build) {
        val dep_path: intern.StrId = session.module_fqn(sc.s, sym.origin);
        val msg: str = gated_member_const_message(sc, sym.name, dep_path);
        val e_opt: R.Result[expr.Expr, str] = expression(sc, eid);
        var span: token.Span;
        span.offset = 0;
        span.len    = 0;
        if (R.is_ok[expr.Expr, str](e_opt)) { span = R.unwrap_ok[expr.Expr, str](e_opt).span; }
        report(sc, span, msg);
        if (sc.status.kind == fail.INTERNAL) {
            ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, sc.status.message));
        }
        ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_REJECTED, msg));
    }
    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](named.value));
}

fun param_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    val f_opt: O.Option[*decl.DeclFun] = fun_decl_for(sc, sym.decl);
    if (O.is_none[*decl.DeclFun](f_opt)) { ret type.TYPE_ERROR; }
    val f: *decl.DeclFun = O.unwrap[*decl.DeclFun](f_opt);
    if (sym.slot >= f.params_len) { ret type.TYPE_ERROR; }
    val tn: *decl.TypedName = ?sc.a.typed_names[f.params_start + sym.slot];
    ret resolved_type_of(sc, tn.ty);
}

pub fun own_nominal_declaration(sc: *SemaContext, nominal: *type.Type) R.Result[id.DeclId, fail.Fail] {
    if (sc.rr == nil || sc.a == nil) { ret R.err[id.DeclId, fail.Fail](fail.message("nominal definition requires the active resolved owner")); }
    val owner: type.TypeOwner = resolve.type_owner(sc.s, sc.own_module, sc.a.file_id);
    if (nominal.data.nominal.owner.module != owner.module || nominal.data.nominal.owner.file != owner.file) {
        ret R.err[id.DeclId, fail.Fail](fail.message("nominal definition belongs to another source owner"));
    }
    var found: id.DeclId = id.DECL_NIL;
    var i: u32 = 0;
    for (i < sc.rr.symbol_count) {
        val symbol: *resolve.Symbol = ?sc.rr.symbols[i];
        var matches: bool = symbol.kind == resolve.SYM_REC && nominal.kind == type.TYPE_REC;
        if (symbol.kind == resolve.SYM_UNI && nominal.kind == type.TYPE_UNI) { matches = true; }
        if (symbol.kind == resolve.SYM_TAG && nominal.kind == type.TYPE_TAG) { matches = true; }
        if (matches && symbol.origin == sc.own_module && symbol.canon == nominal.data.nominal.name) {
            if (found != id.DECL_NIL && found != symbol.decl) { ret R.err[id.DeclId, fail.Fail](fail.message("nominal definition is ambiguous in the active resolved owner")); }
            found = symbol.decl;
        }
        i = i + 1;
    }
    if (found == id.DECL_NIL || found >= sc.a.decl_len::u32) { ret R.err[id.DeclId, fail.Fail](fail.message("nominal definition is absent from the active resolved owner")); }
    ret R.ok[id.DeclId, fail.Fail](found);
}

pub fun definition_ast(sc: *SemaContext, origin: session.ModuleId) *ast.Ast {
    if (origin == sc.own_module) { ret sc.a; }
    if (sc.deps == nil) { fail.internal(?sc.status, "semantic definition has no dependency reader"); ret nil; }
    val acquired: R.Result[Definition, fail.Fail] = acquire_definition(?sc.deps.definitions, origin, DEFINITION_PARSED);
    if (R.is_err[Definition, fail.Fail](acquired)) {
        val reason: fail.Fail = R.unwrap_err[Definition, fail.Fail](acquired);
        if (reason.kind == fail.REPORTED) { fail.reject(?sc.status); }
        or { fail.internal(?sc.status, reason.message); }
        ret nil;
    }
    ret R.unwrap_ok[Definition, fail.Fail](acquired).parsed.a;
}

pub fun generic_param_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    val a: *ast.Ast = definition_ast(sc, sym.origin);
    if (a == nil) { ret type.TYPE_ERROR; }
    val selected: O.Option[*decl.Decl] = ast.get_decl(a, sym.decl);
    if (O.is_none[*decl.Decl](selected)) { fail.internal(?sc.status, "generic parameter has no current owning declaration"); ret type.TYPE_ERROR; }
    val declaration: *decl.Decl = O.unwrap[*decl.Decl](selected);
    var name: token.Span;
    var kind: type.TypeKind = type.TYPE_FUN;
    if (declaration.kind == decl.DECL_KIND_FUN) { name = declaration.data.fun_.name; }
    or (declaration.kind == decl.DECL_KIND_REC) { name = declaration.data.rec_.name; kind = type.TYPE_REC; }
    or (declaration.kind == decl.DECL_KIND_UNI) { name = declaration.data.uni_.name; kind = type.TYPE_UNI; }
    or (declaration.kind == decl.DECL_KIND_TAG) { name = declaration.data.tag_.name; kind = type.TYPE_TAG; }
    or { fail.internal(?sc.status, "generic parameter owner has the wrong declaration kind"); ret type.TYPE_ERROR; }
    val text: O.Option[*source.SourceFile] = source.get(?sc.s.sources, a.file_id);
    if (O.is_none[*source.SourceFile](text)) { fail.internal(?sc.status, "generic parameter owner has no source"); ret type.TYPE_ERROR; }
    val canonical: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, O.unwrap[*source.SourceFile](text).text, name);
    if (R.is_err[intern.StrId, str](canonical)) { fail.internal(?sc.status, R.unwrap_err[intern.StrId, str](canonical)); ret type.TYPE_ERROR; }
    val res_intern: R.Result[type.TypeId, str] = type.intern_generic_param(?sc.s.types, sym.name,
        resolve.type_owner(sc.s, sym.origin, a.file_id), R.unwrap_ok[intern.StrId, str](canonical), kind, sym.slot);
    if (R.is_err[type.TypeId, str](res_intern)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](res_intern)); ret type.TYPE_ERROR; }
    ret apply_subst(sc, R.unwrap_ok[type.TypeId, str](res_intern));
}

fun fun_decl_for(sc: *SemaContext, did: id.DeclId) O.Option[*decl.DeclFun] {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret O.none[*decl.DeclFun](); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_FUN) { ret O.none[*decl.DeclFun](); }
    ret O.some[*decl.DeclFun](?d.data.fun_);
}

pub fun embed_len_of(sc: *SemaContext, tid: id.TypeId) u64 {
    if (sc.embed_len == nil)         { ret EMBED_LEN_NONE; }
    if (tid == id.TYPE_NIL)          { ret EMBED_LEN_NONE; }
    if (tid::usize >= sc.a.type_len) { ret EMBED_LEN_NONE; }
    ret sc.embed_len[tid];
}

pub fun set_embed_len(sc: *SemaContext, tid: id.TypeId, len: u64) {
    if (sc.embed_len == nil)         { ret; }
    if (tid == id.TYPE_NIL)          { ret; }
    if (tid::usize >= sc.a.type_len) { ret; }
    sc.embed_len[tid] = len;
}

test "mach.lang.fe.sema.context.embed_len:preserves_full_u32_domain" {
    var a: ast.Ast;
    a.type_len = 1;

    var slots: [1]u64;
    slots[0] = EMBED_LEN_NONE;

    var sc: SemaContext;
    sc.a         = ?a;
    sc.embed_len = ?slots[0];

    set_embed_len(?sc, 0::id.TypeId, 0xFFFFFFFF);
    if (embed_len_of(?sc, 0::id.TypeId) != 0xFFFFFFFF) { ret 1; }

    set_embed_len(?sc, 0::id.TypeId, 0xFFFFFFFE);
    if (embed_len_of(?sc, 0::id.TypeId) != 0xFFFFFFFE) { ret 1; }
    ret 0;
}

pub fun record_embed_path(sc: *SemaContext, path_id: intern.StrId) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < sc.embed_path_len) {
        if (sc.embed_paths[i] == path_id) { ret R.ok_void[str](); }
        i = i + 1;
    }

    if (sc.embed_path_len == sc.embed_path_cap) {
        var new_cap: u32 = 4;
        if (sc.embed_path_cap > 0) { new_cap = sc.embed_path_cap * 2; }
        if (sc.embed_paths == nil) {
            val ar: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](sc.s.alloc, new_cap::usize);
            if (R.is_err[*intern.StrId, str](ar)) { fail.internal(?sc.status, R.unwrap_err[*intern.StrId, str](ar)); ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](ar)); }
            sc.embed_paths = R.unwrap_ok[*intern.StrId, str](ar);
        }
        or {
            val rr: R.Result[*intern.StrId, str] = A.reallocate[intern.StrId](sc.s.alloc, sc.embed_paths, sc.embed_path_cap::usize, new_cap::usize);
            if (R.is_err[*intern.StrId, str](rr)) { fail.internal(?sc.status, R.unwrap_err[*intern.StrId, str](rr)); ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](rr)); }
            sc.embed_paths = R.unwrap_ok[*intern.StrId, str](rr);
        }
        sc.embed_path_cap = new_cap;
    }

    sc.embed_paths[sc.embed_path_len] = path_id;
    sc.embed_path_len = sc.embed_path_len + 1;
    ret R.ok_void[str]();
}

fun record_distinct_instances(sc: *SemaContext, first: u32, count: u32) R.Result[R.Void, str] {
    var i: u32 = first;
    for (i < first + count) {
        val res_nom: R.Result[type.TypeId, str] =
            type.intern_nominal(?sc.s.types, i::intern.StrId, type.TypeOwner{ module: 0, file: 1 }, type.TYPE_REC);
        if (R.is_err[type.TypeId, str](res_nom)) { fail.internal(?sc.status, R.unwrap_err[type.TypeId, str](res_nom)); ret R.err[R.Void, str](R.unwrap_err[type.TypeId, str](res_nom)); }
        var arg: type.TypeId = R.unwrap_ok[type.TypeId, str](res_nom);

        var span: token.Span;
        span.offset = 0;
        span.len    = 0;

        val res_rec: R.Result[u8, str] = record_instance(sc, 0::session.ModuleId, i::id.DeclId, ?arg, 1, type.TYPE_ERROR, 0::intern.StrId, span);
        if (R.is_err[u8, str](res_rec)) { ret R.err[R.Void, str](R.unwrap_err[u8, str](res_rec)); }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun time_record_fresh(count: u32) i64 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var sess: session.Session;
    sess.alloc = ?alloc;
    if (O.is_some[str](type.init(?sess.types, ?alloc))) { ret -1; }

    var sc: SemaContext;
    sc.status        = fail.accepted();
    sc.s             = ?sess;
    sc.diags = ?sess.diags;
    sc.collect_insts = true;
    sc.insts         = nil;
    sc.inst_depth    = 0;
    sc.inst_parent   = INST_NONE;
    sc.has_secret    = false;

    val start: tm.Time = tm.monotonic();
    if (R.is_err[R.Void, str](record_distinct_instances(?sc, 0, count))) { ret -1; }
    val elapsed: duration.Duration = tm.time_sub(tm.monotonic(), start);

    inst_worklist_free(sc.insts);
    type.dnit(?sess.types);
    ret duration.duration_usec(elapsed);
}

fun min_time_record_fresh(count: u32, reps: u32) i64 {
    var best: i64 = -1;
    var r: u32 = 0;
    for (r < reps) {
        val us: i64 = time_record_fresh(count);
        if (us < 0) { ret -1; }
        if (best < 0 || us < best) { best = us; }
        r = r + 1;
    }
    ret best;
}

test "mach.lang.fe.sema.context.record_instance:cost_stays_near_linear_as_worklist_grows" {
    val small: u32 = 2000;
    val large: u32 = 8000;

    val us_small: i64 = min_time_record_fresh(small, 5);
    val us_large: i64 = min_time_record_fresh(large, 5);
    if (us_small < 0 || us_large < 0) { ret 1; }

    var pa: A.Allocator;
    page.make(?pa);
    val msg: R.Result[str, str] = format.sprint(?pa, "us_small={} us_large={}\n", us_small, us_large);
    if (R.is_ok[str, str](msg)) { print.eprint(R.unwrap_ok[str, str](msg)); }

    var bad: i32 = 0;
    if (us_large > (us_small + 2000) * 6) { bad = 1; }
    ret bad;
}

pub fun recover[T](sc: *SemaContext, r: R.Result[T, str], recovery: T) T {
    if (R.is_err[T, str](r)) {
        fail.internal(?sc.status, R.unwrap_err[T, str](r));
        ret recovery;
    }
    ret R.unwrap_ok[T, str](r);
}

pub fun record_result(sc: *SemaContext, r: R.Result[R.Void, str]) {
    if (R.is_err[R.Void, str](r)) { fail.internal(?sc.status, R.unwrap_err[R.Void, str](r)); }
}

pub fun record_eval_result(sc: *SemaContext, r: R.Result[comptime.CTValue, comptime.EvalFail]) {
    if (!R.is_err[comptime.CTValue, comptime.EvalFail](r)) { ret; }
    val f: comptime.EvalFail = R.unwrap_err[comptime.CTValue, comptime.EvalFail](r);
    if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?sc.status, f.message); }
}

rec CountingDefinition {
    current: Definition;
    reads: u32;
}

fun t_counting_definition(raw: ptr, origin: session.ModuleId, phase: DefinitionPhase) R.Result[Definition, fail.Fail] {
    val probe: *CountingDefinition = raw::*CountingDefinition;
    probe.reads = probe.reads + 1;
    if (probe.current.origin != origin) { ret R.err[Definition, fail.Fail](fail.message("counting definition owner differs")); }
    ret R.ok[Definition, fail.Fail](probe.current);
}

test "mach.lang.fe.sema.context.acquire_definition:reads_each_origin_once_per_reader_and_upgrades_the_phase" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }

    var a1: ast.Ast;
    var sm1: SemaResult = SemaResult{};
    var rr1: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    a1.incarnation = 1;
    rr1.status = fail.accepted();
    sm1.status = fail.accepted();
    val mid: session.ModuleId = 0::session.ModuleId;
    if (R.is_err[R.Void, str](session.register_module_identity(?s, mid, ?a1, 7::intern.StrId, 5))) { ret 1; }

    var probe: CountingDefinition = CountingDefinition{
        current: Definition{
            parsed: resolve.ParsedDefinition{ a: ?a1, owner: resolve.type_owner(?s, mid, a1.file_id), incarnation: a1.incarnation },
            origin: mid, rr: ?rr1, sr: ?sm1, ctx: ?cc1
        },
        reads: 0
    };
    var reader: DefinitionReader = reader_init((?probe)::ptr, t_counting_definition, ?alloc);
    fin { reader_dnit(?reader); }

    val first: R.Result[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_RESOLVED);
    val second: R.Result[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_RESOLVED);
    if (R.is_err[Definition, fail.Fail](first) || R.is_err[Definition, fail.Fail](second)) { ret 2; }
    if (probe.reads != 1) { ret 3; }
    if (R.unwrap_ok[Definition, fail.Fail](second).rr != ?rr1) { ret 4; }

    # a typed request outranks the resolved entry and replaces it
    val typed: R.Result[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_TYPED);
    if (R.is_err[Definition, fail.Fail](typed) || probe.reads != 2) { ret 5; }
    if (R.unwrap_ok[Definition, fail.Fail](typed).sr != ?sm1) { ret 6; }
    val resolved_again: R.Result[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_RESOLVED);
    val typed_again: R.Result[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_TYPED);
    if (R.is_err[Definition, fail.Fail](resolved_again) || R.is_err[Definition, fail.Fail](typed_again)) { ret 7; }
    if (probe.reads != 2 || reader.acquired.len != 1) { ret 8; }

    # a failed read is not remembered, and another origin is its own entry
    val other: R.Result[Definition, fail.Fail] = acquire_definition(?reader, 1::session.ModuleId, DEFINITION_RESOLVED);
    if (R.is_ok[Definition, fail.Fail](other) || probe.reads != 3 || reader.acquired.len != 1) { ret 9; }
    val other_again: R.Result[Definition, fail.Fail] = acquire_definition(?reader, 1::session.ModuleId, DEFINITION_RESOLVED);
    if (R.is_ok[Definition, fail.Fail](other_again) || probe.reads != 4) { ret 10; }
    ret 0;
}
