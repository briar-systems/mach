pub rec SemaResult {
    field_graph:      fields.Graph;
    status:           fail.PhaseStatus;
    alloc:            *A.Allocator;
    expr_type:        *type.TypeId;
    type_resolved_ty: *type.TypeId;
    decl_type:        *type.TypeId;
    expr_count:       u32;
    type_count:       u32;
    decl_count:       u32;
    embed_paths:      *intern.StrId;
    embed_path_count: u32;
    embed_path_cap:   u32;
}

pub val EMBED_LEN_NONE: u64 = 0xFFFFFFFFFFFFFFFF;

pub val EMBED_LEN_FAILED: u64 = 0xFFFFFFFFFFFFFFFE;

pub rec TypeExport {
    origin:                 session.StableModuleId;
    canon:                  intern.StrId;
    ty:                     type.TypeId;
    constant:               resolve.ExportConstant;
    definition_incarnation: u64;
}

# exports are append-only, and `index` maps (origin, canon) to the first export with
# that key over the first `indexed` of them (#3472)
pub rec ModuleSema {
    path:    intern.StrId;
    module:  session.ModuleId;
    exports: vector.Vector[TypeExport];
    graph:   fields.Graph;
    index:   map.Map[u64, u32];
    indexed: usize;
}

pub fun module_sema_init(a: *A.Allocator, path: intern.StrId, module: session.ModuleId) ModuleSema {
    ret ModuleSema{path: path, module: module, exports: vector.init[TypeExport](a), graph: fields.init(a),
        index: map.init[u64, u32](a), indexed: 0};
}

pub fun module_sema_dnit(module: *ModuleSema) {
    vector.dnit[TypeExport](?module.exports);
    fields.dnit(?module.graph);
    map.dnit[u64, u32](?module.index);
    module.indexed = 0;
}

fun export_key(origin: session.StableModuleId, canon: intern.StrId) u64 {
    ret (origin::u64 << 32) | canon::u64;
}

# the export of `module` keyed (origin, canon), bringing the index up to the current exports
fun module_export_for(module: *ModuleSema, origin: session.StableModuleId, canon: intern.StrId) res[opt[TypeExport], A.Error] {
    for (module.indexed < module.exports.len) {
        val item: *TypeExport = ?module.exports.data[module.indexed];
        var key:  u64         = export_key(item.origin, item.canon);
        val seen: opt[*u32]   = map.get[u64, u32](?module.index, ?key);
        if (sel seen.none) {
            val added: res[bool, A.Error] = map.insert[u64, u32](?module.index, key, module.indexed::u32);
            if (sel added.err) { ret res[opt[TypeExport], A.Error].err{added.err}; }
        }
        module.indexed = module.indexed + 1;
    }
    var want:  u64       = export_key(origin, canon);
    val found: opt[*u32] = map.get[u64, u32](?module.index, ?want);
    if (sel found.none) { ret res[opt[TypeExport], A.Error].ok{opt[TypeExport].none{}}; }
    ret res[opt[TypeExport], A.Error].ok{opt[TypeExport].some{module.exports.data[@found.some]}};
}

pub def DefinitionPhase: u8;
pub val DEFINITION_PARSED:   DefinitionPhase = 0;
pub val DEFINITION_RESOLVED: DefinitionPhase = 1;
pub val DEFINITION_TYPED:    DefinitionPhase = 2;

pub rec Definition {
    parsed: resolve.ParsedDefinition;
    origin: session.ModuleId;
    rr:     *resolve.ResolveResult;
    sr:     *SemaResult;
    ctx:    *comptime.ComptimeCtx;
}

pub rec AcquiredDefinition {
    phase:      DefinitionPhase;
    definition: Definition;
}

pub rec DefinitionReader {
    ctx:      ptr;
    read:     fun(ptr, session.ModuleId, DefinitionPhase) res[Definition, fail.Fail];
    acquired: vector.Vector[AcquiredDefinition];
}

# a reader lives for one computation, which acquires the same current definition once per origin
pub fun reader_init(ctx: ptr, read: fun(ptr, session.ModuleId, DefinitionPhase) res[Definition, fail.Fail],
    a: *A.Allocator) DefinitionReader {
    ret DefinitionReader{ctx: ctx, read: read, acquired: vector.init[AcquiredDefinition](a)};
}

pub fun reader_dnit(reader: *DefinitionReader) {
    if (reader == nil) { ret; }
    vector.dnit[AcquiredDefinition](?reader.acquired);
}

pub rec DefinedSymbol {
    definition: Definition;
    symbol:     resolve.Symbol;
}

pub fun acquire_definition(reader: *DefinitionReader, origin: session.ModuleId,
    phase: DefinitionPhase) res[Definition, fail.Fail] {
    if (reader == nil || reader.ctx == nil || reader.read == nil || phase > DEFINITION_TYPED) {
        ret res[Definition, fail.Fail].err{fail.message("current definition acquisition requires an active phase capability")};
    }
    var slot: usize = reader.acquired.len;
    var ai:   usize = 0;
    for (ai < reader.acquired.len) {
        val entry: *AcquiredDefinition = ?reader.acquired.data[ai];
        if (entry.definition.origin == origin) {
            if (entry.phase >= phase) { ret res[Definition, fail.Fail].ok{entry.definition}; }
            slot = ai;
            brk;
        }
        ai = ai + 1;
    }
    val acquired: res[Definition, fail.Fail] = reader.read(reader.ctx, origin, phase);
    if (sel acquired.err) { ret res[Definition, fail.Fail].err{acquired.err}; }
    val current: Definition = acquired.ok;
    if (current.origin != origin || current.parsed.a == nil || current.parsed.incarnation == 0
        || current.parsed.incarnation != current.parsed.a.incarnation
        || current.parsed.owner.file != current.parsed.a.file_id) {
        ret res[Definition, fail.Fail].err{fail.message("current definition has inconsistent parsed ownership")};
    }
    if (phase >= DEFINITION_RESOLVED && current.rr == nil) {
        ret res[Definition, fail.Fail].err{fail.message("current definition has no acquired resolution product")};
    }
    if (phase == DEFINITION_TYPED && (current.sr == nil || current.ctx == nil)) {
        ret res[Definition, fail.Fail].err{fail.message("current definition has no acquired semantic product")};
    }
    if (phase >= DEFINITION_RESOLVED && !sel current.rr.status.kind.accepted) {
        ret res[Definition, fail.Fail].err{fail.phase_failure(current.rr.status)};
    }
    if (phase == DEFINITION_TYPED && !sel current.sr.status.kind.accepted) {
        ret res[Definition, fail.Fail].err{fail.phase_failure(current.sr.status)};
    }
    val entry: AcquiredDefinition = AcquiredDefinition{phase: phase, definition: current};
    if (slot < reader.acquired.len) { reader.acquired.data[slot] = entry; }
    or {
        val added: res[usize, A.Error] = vector.push[AcquiredDefinition](?reader.acquired, entry);
        if (sel added.err) { ret res[Definition, fail.Fail].err{fail.refused(added.err)}; }
    }
    ret res[Definition, fail.Fail].ok{current};
}

pub fun acquire_symbol(reader: *DefinitionReader, requested: *resolve.Symbol,
    phase: DefinitionPhase) res[DefinedSymbol, fail.Fail] {
    if (requested == nil || phase < DEFINITION_RESOLVED) {
        ret res[DefinedSymbol, fail.Fail].err{fail.message("symbol definition requires resolved acquisition")};
    }
    val acquired: res[Definition, fail.Fail] = acquire_definition(reader, requested.origin, phase);
    if (sel acquired.err) { ret res[DefinedSymbol, fail.Fail].err{acquired.err}; }
    val current: Definition       = acquired.ok;
    var found:   resolve.SymbolId = resolve.SYMBOL_NIL;
    var i:       u32              = 0;
    for (i < current.rr.symbol_count) {
        val symbol: *resolve.Symbol = ?current.rr.symbols[i];
        if (symbol.origin == requested.origin && symbol.kind == requested.definition_kind
            && symbol.canon == requested.canon && symbol.decl != id.DECL_NIL) {
            if (found != resolve.SYMBOL_NIL && current.rr.symbols[found].decl != symbol.decl) {
                ret res[DefinedSymbol, fail.Fail].err{fail.message("current canonical definition is ambiguous")};
            }
            found = i;
        }
        i = i + 1;
    }
    if (found == resolve.SYMBOL_NIL || current.rr.symbols[found].decl >= current.parsed.a.decl_len::u32) {
        ret res[DefinedSymbol, fail.Fail].err{fail.message("current canonical definition is absent from its resolved owner")};
    }
    ret res[DefinedSymbol, fail.Fail].ok{DefinedSymbol{definition: current, symbol: current.rr.symbols[found]}};
}

pub fun imported_definition(sc: *SemaContext, sym: *resolve.Symbol,
    phase: DefinitionPhase) res[DefinedSymbol, fail.Fail] {
    if (sym.origin == sc.own_module || sc.deps == nil) {
        val reason: fail.Fail = fail.message("foreign definition acquisition cannot refresh the active semantic owner");
        fail.internal(?sc.status, fail.describe(reason));
        ret res[DefinedSymbol, fail.Fail].err{reason};
    }
    val result: res[DefinedSymbol, fail.Fail] = acquire_symbol(?sc.deps.definitions, sym, phase);
    if (sel result.err) {
        val reason: fail.Fail = result.err;
        if (sel reason.reported) { fail.reject(?sc.status); }
        or                       { fail.internal(?sc.status, fail.describe(reason)); }
    }
    ret result;
}

pub fun symbol_definition(sc: *SemaContext, sym: *resolve.Symbol,
    phase: DefinitionPhase) res[DefinedSymbol, fail.Fail] {
    if (sym.origin != sc.own_module) { ret imported_definition(sc, sym, phase); }
    if (sc.a == nil || sc.rr == nil || sym.decl == id.DECL_NIL || sym.decl >= sc.a.decl_len::u32) {
        val reason: fail.Fail = fail.message("symbol has no declaration in the active semantic owner");
        fail.internal(?sc.status, fail.describe(reason));
        ret res[DefinedSymbol, fail.Fail].err{reason};
    }
    val parsed: resolve.ParsedDefinition = resolve.ParsedDefinition{
        a: sc.a, owner: resolve.type_owner(sc.s, sc.own_module, sc.a.file_id), incarnation: sc.a.incarnation
    };
    ret res[DefinedSymbol, fail.Fail].ok{DefinedSymbol{
        definition: Definition{parsed: parsed, origin: sc.own_module, rr: sc.rr, ctx: sc.ctx}, symbol: @sym
    }};
}

# the imported surfaces are borrowed: the driver owns each one and shares it
# between every importer in a pass (#3472)
pub rec SemaDeps {
    definitions: DefinitionReader;
    entries:     **ModuleSema;
    count:       u32;
}

fwd type.FieldEntry;
fwd type.FieldTable;

pub rec InstReq {
    origin:  session.ModuleId;
    decl:    id.DeclId;
    sig:     type.TypeId;
    args:    *type.TypeId;
    arg_len: u32;
    bare:    intern.StrId;
    depth:   u32;
    parent:  u32;
    site:    token.Span;
    # the instantiating module's file, so a refusal points at the caller and not at an
    # offset in the template's own file
    site_file: source.FileId;
}

pub val INST_NONE: u32 = 4294967295;

pub val MAX_CT_INSTANCE_DEPTH: u32 = 32;

pub val MAX_CT_INSTANCES: u32 = 8192;

pub val RECORD_OK:          u8 = 0;
pub val RECORD_LIMIT_DEPTH: u8 = 1;
pub val RECORD_LIMIT_COUNT: u8 = 2;

pub rec InstWorklist {
    items:   *InstReq;
    len:     u32;
    cap:     u32;
    drained: u32;
    alloc:   *A.Allocator;
    limited: bool;
    dedup:   map.Map[u64, u32];

    uni_reports:  UniReports;
    secret_state: u8;
}

pub val SECRET_UNKNOWN: u8 = 0;
pub val SECRET_ABSENT:  u8 = 1;
pub val SECRET_PRESENT: u8 = 2;

pub val TYPE_MEMO_NONE:     u8 = 0;
pub val TYPE_MEMO_RESOLVED: u8 = 1;

pub val LAYOUT_PENDING: u8 = 0;
pub val LAYOUT_ACTIVE:  u8 = 1;
pub val LAYOUT_READY:   u8 = 2;
pub val LAYOUT_FAILED:  u8 = 3;

val UNI_REPORT_CAP: u32 = 256;

pub rec UniReports {
    seen: [UNI_REPORT_CAP]type.TypeId;
    len:  u32;
}

pub fun uni_report_mark(ur: *UniReports, key: type.TypeId) bool {
    if (ur == nil) { ret true; }
    var i: u32 = 0;
    for (i < ur.len) {
        if (ur.seen[i] == key) { ret false; }
        i = i + 1;
    }
    if (ur.len >= UNI_REPORT_CAP) { ret true; }
    ur.seen[ur.len] = key;
    ur.len          = ur.len + 1;
    ret true;
}

# one lexical payload guard: the tag place and the case it is known to hold; frames live on the
# walker's stack and chain through `prev`
pub rec Guard {
    place:     id.ExprId;
    case_name: intern.StrId;
    prev:      *Guard;
}

pub rec SemaContext {
    diags:      *diagnostic.DiagnosticStore;
    status:     fail.PhaseStatus;
    s:          *session.Session;
    a:          *ast.Ast;
    rr:         *resolve.ResolveResult;
    deps:       *SemaDeps;
    ctx:        *comptime.ComptimeCtx;
    caps:       comptime.PhaseCapabilities[SemaContext];
    own_module: session.ModuleId;
    source:     str;

    insts: *InstWorklist;

    collect_insts: bool;

    inst_depth: u32;

    inst_parent: u32;

    silent: bool;
    # resolving every type node up front, before any arm is selected
    type_prepass: bool;
    # how many deferred names type resolution has met, so a consumer can tell a type that
    # failed on one from a type that failed on its own
    deferred_hits: u32;

    expr_type:        *type.TypeId;
    type_resolved_ty: *type.TypeId;
    decl_type:        *type.TypeId;

    embed_len: *u64;

    embed_paths:    *intern.StrId;
    embed_path_len: u32;
    embed_path_cap: u32;

    type_resolved_memo: *u8;

    layout_state: *u8;

    inst_site:      token.Span;
    inst_site_file: source.FileId;
    inst_site_set:  bool;

    in_deferred_arm: bool;

    callee_eid: id.ExprId;

    in_comptime_gate: bool;

    in_fin:         bool;
    fin_loop_depth: u32;

    # inside a `test` body, where a `ret` value is a status in 0..255
    in_test: bool;

    guards: *Guard;

    # the instance under check: the declaration whose parameters `subst` replaces,
    # position for position; a parameter of any other declaration is left alone
    subst:       *type.TypeId;
    subst_len:   u32;
    subst_owner: type.GenericOwner;
    subst_fn:    fun(*session.Session, type.TypeId, *type.GenericOwner, *type.TypeId, u32) res[type.TypeId, fail.Fail];

    uni_check_fn: fun(*SemaContext, id.TypeId);
    uni_reports:  *UniReports;
    has_secret:   bool;
}

# a name resolve left for the arm sema selects (#3485), reported once at the name itself
# whichever instantiation walks it, and never for an arm sema discards
pub fun report_deferred_name(sc: *SemaContext, span: token.Span, prefix: str) {
    if (sc.silent || sc.type_prepass) { ret; }
    fail.reject(?sc.status);
    val name_r: res[intern.StrId, A.Error] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (sel name_r.err) {
        fail.internal(?sc.status, "out of memory naming an unresolved name");
        ret;
    }
    val name: opt[str] = intern.lookup(?sc.s.interner, name_r.ok);
    if (sel name.none) {
        fail.internal(?sc.status, "an unresolved name has no text");
        ret;
    }
    val msg_r: res[str, format.FormatError] = format.sprint(sc.diags.a, "{}{}`", prefix, name.some);
    if (sel msg_r.err) {
        fail.internal(?sc.status, "out of memory naming an unresolved name");
        ret;
    }
    val committed: res[bool, fail.Fail] = diagnostic.gate_error(sc.diags, ?sc.s.interner, sc.a.file_id, span, msg_r.ok);
    str_free(sc.diags.a, msg_r.ok);
    if (sel committed.err) { fail.internal(?sc.status, fail.describe(committed.err)); }
}

pub fun report_deferred_type(sc: *SemaContext, ast_tid: id.TypeId) {
    report_deferred_subtree(sc, ast_tid, 0);
}

# a type is consumed whole, often from the memo, so every deferred name anywhere inside it is
# reached from here: its arguments, pointee, element, length, parameters and fields
fun report_deferred_subtree(sc: *SemaContext, ast_tid: id.TypeId, depth: u32) {
    if (depth > 64 || ast_tid == id.TYPE_NIL)                                      { ret; }
    if (sc.rr == nil || sc.rr.type_resolved == nil || ast_tid >= sc.rr.type_count) { ret; }
    val t_opt: opt[*atype.Type] = ast.get_type(sc.a, ast_tid);
    if (!sel t_opt.some) { ret; }
    val t: *atype.Type = t_opt.some;
    if (sc.rr.type_resolved[ast_tid] == resolve.SYMBOL_DEFERRED_TYPE) {
        sc.deferred_hits = sc.deferred_hits + 1;
        report_deferred_name(sc, t.span, "unresolved type name `");
    }
    if (t.kind == atype.TYPE_KIND_NAMED) {
        var i: u32 = 0;
        for (i < t.data.named.args_len) {
            report_deferred_subtree(sc, sc.a.type_ids[t.data.named.args_start + i], depth + 1);
            i = i + 1;
        }
    }
    or (t.kind == atype.TYPE_KIND_PTR)             { report_deferred_subtree(sc, t.data.ptr.pointee, depth + 1); }
    or (t.kind == atype.TYPE_KIND_SECRET)          { report_deferred_subtree(sc, t.data.secret.inner, depth + 1); }
    or (t.kind == atype.TYPE_KIND_POINTEE_OF)      { report_deferred_subtree(sc, t.data.pointee_of.inner, depth + 1); }
    or (t.kind == atype.TYPE_KIND_DISCRIMINANT_OF) { report_deferred_subtree(sc, t.data.discriminant_of.inner, depth + 1); }
    or (t.kind == atype.TYPE_KIND_ARRAY) {
        report_deferred_length(sc, t.data.array.length);
        report_deferred_subtree(sc, t.data.array.element, depth + 1);
    }
    or (t.kind == atype.TYPE_KIND_FUN) {
        var p: u32 = 0;
        for (p < t.data.fun_.params_len) {
            report_deferred_subtree(sc, sc.a.type_ids[t.data.fun_.params_start + p], depth + 1);
            p = p + 1;
        }
        report_deferred_subtree(sc, t.data.fun_.ret_type, depth + 1);
    }
    or (t.kind == atype.TYPE_KIND_REC || t.kind == atype.TYPE_KIND_UNI) {
        var start: u32 = t.data.rec_.fields_start;
        var len:   u32 = t.data.rec_.fields_len;
        if (t.kind == atype.TYPE_KIND_UNI) {
            start = t.data.uni_.fields_start;
            len   = t.data.uni_.fields_len;
        }
        var f: u32 = 0;
        for (f < len) {
            report_deferred_subtree(sc, sc.a.typed_names[start + f].ty, depth + 1);
            f = f + 1;
        }
    }
}

# an array length that is one deferred name
fun report_deferred_length(sc: *SemaContext, eid: id.ExprId) {
    if (eid == id.EXPR_NIL || sc.rr.expr_resolved == nil || eid >= sc.rr.expr_count) { ret; }
    if (!resolve.symbol_deferred(sc.rr.expr_resolved[eid]))                          { ret; }
    val e_opt: res[expr.Expr, fail.Fail] = expression(sc, eid);
    if (sel e_opt.err) { ret; }
    sc.deferred_hits = sc.deferred_hits + 1;
    var at: token.Span = e_opt.ok.span;
    if (e_opt.ok.kind == expr.EXPR_KIND_IDENT) { at = e_opt.ok.data.ident.tok; }
    report_deferred_name(sc, at, "unresolved identifier `");
}

pub fun resolved_type_of(sc: *SemaContext, ast_tid: id.TypeId) type.TypeId {
    if (ast_tid == id.TYPE_NIL)        { ret type.TYPE_NIL; }
    if (sc.type_resolved_ty == nil)    { ret type.TYPE_ERROR; }
    if (ast_tid >= sc.a.type_len::u32) { ret type.TYPE_ERROR; }
    report_deferred_type(sc, ast_tid);
    if (sc.has_secret && sc.subst != nil && sc.uni_check_fn != nil) {
        sc.uni_check_fn(sc, ast_tid);
    }
    ret apply_subst(sc, sc.type_resolved_ty[ast_tid]);
}

pub fun expression(sc: *SemaContext, eid: id.ExprId) res[expr.Expr, fail.Fail] {
    val result: res[expr.Expr, fail.Fail] = resolve.expression(sc.rr, sc.a, eid);
    if (sel result.err) { fail.internal(?sc.status, fail.describe(result.err)); }
    ret result;
}

pub fun comptime_expression(sc: *SemaContext, a: *ast.Ast, eid: id.ExprId) res[expr.Expr, comptime.EvalFail] {
    if (sc == nil || sc.a != a) { ret res[expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "semantic expression belongs to a different parsed owner")}; }
    val result: res[expr.Expr, fail.Fail] = expression(sc, eid);
    if (sel result.err) {
        ret res[expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.describe(result.err))};
    }
    ret res[expr.Expr, comptime.EvalFail].ok{result.ok};
}

pub fun apply_subst(sc: *SemaContext, tid: type.TypeId) type.TypeId {
    if (sc.subst == nil || sc.subst_len == 0 || sc.subst_fn == nil) { ret tid; }
    ret type_result(sc, sc.subst_fn(sc.s, tid, ?sc.subst_owner, sc.subst, sc.subst_len));
}

# true while a type still names a type parameter: no operand predicate has an answer
# for it, and every question about it waits for an instantiation
pub fun awaits_instance(sc: *SemaContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_ERROR || tid == type.TYPE_NIL) { ret false; }
    ret type.mentions_generic_param(?sc.s.types, tid);
}

fun module_rr_for(sc: *SemaContext, origin: session.ModuleId) *resolve.ResolveResult {
    if (origin == sc.own_module) { ret sc.rr; }
    if (sc.deps == nil) {
        fail.internal(?sc.status, "semantic definition has no dependency reader");
        ret nil;
    }
    val acquired: res[Definition, fail.Fail] = acquire_definition(?sc.deps.definitions, origin, DEFINITION_RESOLVED);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?sc.status); }
        or                       { fail.internal(?sc.status, fail.describe(reason)); }
        ret nil;
    }
    ret acquired.ok.rr;
}

fun callee_is_c_variadic(sc: *SemaContext, rr: *resolve.ResolveResult, callee_eid: id.ExprId) bool {
    if (rr == nil || rr.expr_resolved == nil || rr.symbols == nil) { ret false; }
    if (callee_eid == id.EXPR_NIL || callee_eid >= rr.expr_count)  { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[callee_eid];
    if (sid == resolve.SYMBOL_NIL || sid >= rr.symbol_count) { ret false; }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)            { ret false; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret false; }
    val acquired: res[DefinedSymbol, fail.Fail] = symbol_definition(sc, sym, DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: DefinedSymbol   = acquired.ok;
    val d_opt:   opt[*decl.Decl] = ast.get_decl(current.definition.parsed.a, current.symbol.decl);
    if (!sel d_opt.some) { ret false; }
    val d: *decl.Decl = d_opt.some;
    if (d.kind != decl.DECL_KIND_FUN) { ret false; }
    ret d.data.fun_.c_variadic;
}

fun call_has_spread_arg(a: *ast.Ast, e: *expr.Expr) bool {
    var i: u32 = 0;
    for (i < e.data.call.args_len) {
        val ix: u32 = e.data.call.args_start + i;
        if (ix::usize < a.expr_id_len) {
            val ao: opt[*expr.Expr] = ast.get_expr(a, a.expr_ids[ix]);
            if (sel ao.some
                && ao.some.kind == expr.EXPR_KIND_SPREAD) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun callee_body_reaches(sc: *SemaContext, rr: *resolve.ResolveResult, callee_eid: id.ExprId,
    want_spread: bool, seen: *ReachSeen) bool {
    if (rr == nil || rr.expr_resolved == nil || rr.symbols == nil) { ret false; }
    if (callee_eid == id.EXPR_NIL || callee_eid >= rr.expr_count)  { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[callee_eid];
    if (sid == resolve.SYMBOL_NIL || sid >= rr.symbol_count) { ret false; }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)            { ret false; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret false; }
    val acquired: res[DefinedSymbol, fail.Fail] = symbol_definition(sc, sym, DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: DefinedSymbol = acquired.ok;
    ret decl_reaches_c_variadic(sc, current.symbol.origin, current.symbol.decl, want_spread, seen);
}

fun expr_has_c_variadic_call(sc: *SemaContext, a: *ast.Ast, rr: *resolve.ResolveResult, eid: id.ExprId, want_spread: bool, seen: *ReachSeen) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val e_opt: res[expr.Expr, fail.Fail] = resolve.expression(rr, a, eid);
    if (sel e_opt.err) {
        fail.internal(?sc.status, fail.describe(e_opt.err));
        ret false;
    }
    var e_value: expr.Expr     = e_opt.ok;
    val e:       *expr.Expr    = ?e_value;
    val k:       expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_CALL) {
        val spread_here: bool = call_has_spread_arg(a, e);
        if (callee_is_c_variadic(sc, rr, e.data.call.callee)
            && (!want_spread || spread_here)) { ret true; }
        if (!want_spread || spread_here) {
            if (callee_body_reaches(sc, rr, e.data.call.callee, want_spread, seen)) { ret true; }
        }
        if (expr_has_c_variadic_call(sc, a, rr, e.data.call.callee, want_spread, seen)) { ret true; }
        var i: u32 = 0;
        for (i < e.data.call.args_len) {
            val ix: u32 = e.data.call.args_start + i;
            if (ix::usize < a.expr_id_len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == expr.EXPR_KIND_BINARY) {
        if (expr_has_c_variadic_call(sc, a, rr, e.data.binary.lhs, want_spread, seen)) { ret true; }
        ret expr_has_c_variadic_call(sc, a, rr, e.data.binary.rhs, want_spread, seen);
    }
    if (k == expr.EXPR_KIND_UNARY)   { ret expr_has_c_variadic_call(sc, a, rr, e.data.unary.operand, want_spread, seen); }
    if (k == expr.EXPR_KIND_INDEX)   { ret expr_has_c_variadic_call(sc, a, rr, e.data.index.object, want_spread, seen); }
    if (k == expr.EXPR_KIND_MEMBER)  { ret expr_has_c_variadic_call(sc, a, rr, e.data.member.object, want_spread, seen); }
    if (k == expr.EXPR_KIND_PROJECT) { ret expr_has_c_variadic_call(sc, a, rr, e.data.project.object, want_spread, seen); }
    if (k == expr.EXPR_KIND_SPREAD)  { ret expr_has_c_variadic_call(sc, a, rr, e.data.spread.inner, want_spread, seen); }
    if (k == expr.EXPR_KIND_CAST)    { ret expr_has_c_variadic_call(sc, a, rr, e.data.cast.value, want_spread, seen); }
    if (k == expr.EXPR_KIND_STRIP)   { ret expr_has_c_variadic_call(sc, a, rr, e.data.strip.value, want_spread, seen); }
    if (k == expr.EXPR_KIND_ARRAY_LIT) {
        var i: u32 = 0;
        for (i < e.data.array_lit.elems_len) {
            val ix: u32 = e.data.array_lit.elems_start + i;
            if (ix::usize < a.expr_id_len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == expr.EXPR_KIND_VECTOR_LIT) {
        var i: u32 = 0;
        for (i < e.data.vector_lit.elems_len) {
            val ix: u32 = e.data.vector_lit.elems_start + i;
            if (ix::usize < a.expr_id_len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == expr.EXPR_KIND_STRUCT_LIT) {
        var i: u32 = 0;
        for (i < e.data.struct_lit.fields_len) {
            val ix: u32 = e.data.struct_lit.fields_start + i;
            if (ix::usize < a.field_init_len
                && expr_has_c_variadic_call(sc, a, rr, a.field_inits[ix].value, want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    ret false;
}

pub fun decl_body_spreads_pack_to_c_variadic(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId) bool {
    ret decl_body_reaches_c_variadic(sc, origin, did, true);
}

val REACH_MAX_VISITED: u32 = 64;

rec ReachSeen {
    origins: *u32;
    decls:   *u32;
    len:     u32;
}

fun reach_visit(seen: *ReachSeen, origin: session.ModuleId, did: id.DeclId) bool {
    var i: u32 = 0;
    for (i < seen.len) {
        if (seen.origins[i] == origin::u32 && seen.decls[i] == did::u32) { ret false; }
        i = i + 1;
    }
    if (seen.len >= REACH_MAX_VISITED) { ret false; }
    seen.origins[seen.len] = origin::u32;
    seen.decls[seen.len]   = did::u32;
    seen.len               = seen.len + 1;
    ret true;
}

fun decl_body_reaches_c_variadic(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId, want_spread: bool) bool {
    var so:   [REACH_MAX_VISITED]u32;
    var sd:   [REACH_MAX_VISITED]u32;
    var seen: ReachSeen;
    seen.origins = ?so[0];
    seen.decls   = ?sd[0];
    seen.len     = 0;
    ret decl_reaches_c_variadic(sc, origin, did, want_spread, ?seen);
}

fun decl_reaches_c_variadic(sc: *SemaContext, origin: session.ModuleId, did: id.DeclId,
    want_spread: bool, seen: *ReachSeen) bool {
    if (!reach_visit(seen, origin, did)) { ret false; }
    val a: *ast.Ast = definition_ast(sc, origin);
    if (a == nil) { ret false; }
    val rr: *resolve.ResolveResult = module_rr_for(sc, origin);
    if (rr == nil) { ret false; }

    val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
    if (!sel d_opt.some) { ret false; }
    val d: *decl.Decl = d_opt.some;
    if (d.kind != decl.DECL_KIND_FUN)    { ret false; }
    if (d.data.fun_.body == id.STMT_NIL) { ret false; }
    ret stmt_calls_c_variadic(sc, a, rr, d.data.fun_.body, want_spread, seen);
}

fun stmt_calls_c_variadic(sc: *SemaContext, a: *ast.Ast, rr: *resolve.ResolveResult, sid: id.StmtId, want_spread: bool, seen: *ReachSeen) bool {
    if (sid == id.STMT_NIL) { ret false; }
    val s_opt: opt[*stmt.Stmt] = ast.get_stmt(a, sid);
    if (!sel s_opt.some) { ret false; }
    val s: *stmt.Stmt    = s_opt.some;
    val k: stmt.StmtKind = s.kind;

    if (k == stmt.STMT_KIND_EXPR) { ret expr_has_c_variadic_call(sc, a, rr, s.data.expr.expr, want_spread, seen); }
    if (k == stmt.STMT_KIND_RET)  { ret expr_has_c_variadic_call(sc, a, rr, s.data.ret_.value, want_spread, seen); }
    if (k == stmt.STMT_KIND_DECL) {
        val dd_opt: opt[*decl.Decl] = ast.get_decl(a, s.data.decl.decl);
        if (!sel dd_opt.some) { ret false; }
        val dd: *decl.Decl = dd_opt.some;
        if (dd.kind != decl.DECL_KIND_VAL && dd.kind != decl.DECL_KIND_VAR) { ret false; }
        ret expr_has_c_variadic_call(sc, a, rr, dd.data.bind.init, want_spread, seen);
    }
    if (k == stmt.STMT_KIND_IF) {
        if (expr_has_c_variadic_call(sc, a, rr, s.data.if_.cond, want_spread, seen))    { ret true; }
        if (stmt_calls_c_variadic(sc, a, rr, s.data.if_.then_block, want_spread, seen)) { ret true; }
        ret stmt_calls_c_variadic(sc, a, rr, s.data.if_.else_block, want_spread, seen);
    }
    if (k == stmt.STMT_KIND_FOR) {
        if (expr_has_c_variadic_call(sc, a, rr, s.data.for_.cond, want_spread, seen)) { ret true; }
        ret stmt_calls_c_variadic(sc, a, rr, s.data.for_.body, want_spread, seen);
    }
    if (k == stmt.STMT_KIND_FIN) { ret stmt_calls_c_variadic(sc, a, rr, s.data.fin_.body, want_spread, seen); }
    if (k == stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids[s.data.block.stmts_start + i], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == stmt.STMT_KIND_COMPTIME_IF) {
        var bi: u32 = 0;
        for (bi < s.data.comptime_if.branches_len) {
            val br:  *decl.ComptimeBranch = ?a.comptime_branches[s.data.comptime_if.branches_start + bi];
            var si2: u32                  = 0;
            for (si2 < br.body_len) {
                if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids[br.body_start + si2], want_spread, seen)) { ret true; }
                si2 = si2 + 1;
            }
            bi = bi + 1;
        }
        ret false;
    }
    if (k == stmt.STMT_KIND_COMPTIME_EACH) {
        var ei: u32 = 0;
        for (ei < s.data.comptime_each.body_len) {
            if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids[s.data.comptime_each.body_start + ei], want_spread, seen)) { ret true; }
            ei = ei + 1;
        }
        ret false;
    }

    ret false;
}

fun args_equal(a: *type.TypeId, b: *type.TypeId, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun record_instance(sc: *SemaContext, origin: session.ModuleId, decl: id.DeclId,
    args: *type.TypeId, arg_len: u32, sig: type.TypeId,
    bare: intern.StrId, site: token.Span) res[u8, fail.Fail] {
    if (!sc.collect_insts) { ret res[u8, fail.Fail].ok{RECORD_OK}; }
    if (arg_len == 0)      { ret res[u8, fail.Fail].ok{RECORD_OK}; }

    # an instance whose arguments still mention a type parameter is the template
    # under other names: nothing in its body is settled until the caller is itself
    # instantiated, and that caller's episode records the closed instance. every
    # closed instance is checked, against its own arguments
    var i: u32 = 0;
    for (i < arg_len) {
        if (type.mentions_generic_param(?sc.s.types, args[i])) { ret res[u8, fail.Fail].ok{RECORD_OK}; }
        i = i + 1;
    }

    if (sc.insts == nil) {
        val wr: res[*InstWorklist, fail.Fail] = inst_worklist_new(sc.s.alloc);
        if (sel wr.err) {
            fail.internal(?sc.status, fail.describe(wr.err));
            ret res[u8, fail.Fail].err{wr.err};
        }
        sc.insts = wr.ok;
    }
    val wl: *InstWorklist = sc.insts;

    val h:       u64       = hash_inst_req(origin, decl, args, arg_len);
    val res_get: opt[*u32] = map.get[u64, u32](?wl.dedup, ?h);
    if (sel res_get.some) {
        val existing_idx: u32      = @res_get.some;
        val existing:     *InstReq = ?wl.items[existing_idx];
        if (existing.origin == origin && existing.decl == decl && existing.arg_len == arg_len
            && args_equal(existing.args, args, arg_len)) {
            ret res[u8, fail.Fail].ok{RECORD_OK};
        }
    }

    if (wl.limited) { ret res[u8, fail.Fail].ok{RECORD_OK}; }

    if (sc.inst_depth > MAX_CT_INSTANCE_DEPTH) {
        wl.limited = true;
        ret res[u8, fail.Fail].ok{RECORD_LIMIT_DEPTH};
    }
    if (wl.len >= MAX_CT_INSTANCES) {
        wl.limited = true;
        ret res[u8, fail.Fail].ok{RECORD_LIMIT_COUNT};
    }

    if (wl.len == wl.cap) {
        var new_cap: u32 = 8;
        if (wl.cap > 0) { new_cap = wl.cap * 2; }
        var nr: res[*InstReq, A.Error] = A.allocate[InstReq](wl.alloc, new_cap::usize);
        if (wl.cap > 0) { nr = A.reallocate[InstReq](wl.alloc, wl.items, wl.cap::usize, new_cap::usize); }
        if (sel nr.err) {
            fail.internal(?sc.status, alloc.text(nr.err));
            ret res[u8, fail.Fail].err{fail.message("internal: out of memory growing the constant-time re-validation worklist")};
        }
        wl.items = nr.ok;
        wl.cap   = new_cap;
    }

    val cr: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](wl.alloc, arg_len::usize);
    if (sel cr.err) {
        fail.internal(?sc.status, alloc.text(cr.err));
        ret res[u8, fail.Fail].err{fail.message("internal: out of memory copying a generic instance's type arguments")};
    }
    val owned: *type.TypeId = cr.ok;
    var k:     u32          = 0;
    for (k < arg_len) {
        owned[k] = args[k];
        k        = k + 1;
    }

    val new_idx: u32      = wl.len;
    val slot:    *InstReq = ?wl.items[new_idx];
    slot.origin    = origin;
    slot.decl      = decl;
    slot.sig       = sig;
    slot.args      = owned;
    slot.arg_len   = arg_len;
    slot.bare      = bare;
    slot.depth     = sc.inst_depth;
    slot.parent    = sc.inst_parent;
    slot.site      = site;
    slot.site_file = sc.a.file_id;
    wl.len         = wl.len + 1;

    val res_insert: res[bool, A.Error] = map.insert[u64, u32](?wl.dedup, h, new_idx);
    if (sel res_insert.err) { ret res[u8, fail.Fail].err{fail.refused(res_insert.err)}; }

    ret res[u8, fail.Fail].ok{RECORD_OK};
}

fun hash_inst_req(origin: session.ModuleId, decl: id.DeclId, args: *type.TypeId, arg_len: u32) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u32(h, origin::u32);
    h = fnv1a.step_u32(h, decl::u32);
    h = fnv1a.step_u32(h, arg_len);

    var i: u32 = 0;
    for (i < arg_len) {
        h = fnv1a.step_u32(h, args[i]::u32);
        i = i + 1;
    }
    ret h;
}

pub fun inst_worklist_new(alloc: *A.Allocator) res[*InstWorklist, fail.Fail] {
    val wr: res[*InstWorklist, A.Error] = A.allocate[InstWorklist](alloc, 1::usize);
    if (sel wr.err) { ret res[*InstWorklist, fail.Fail].err{fail.message("internal: out of memory allocating the constant-time re-validation worklist")}; }
    val wl: *InstWorklist = wr.ok;
    wl.items           = nil;
    wl.len             = 0;
    wl.cap             = 0;
    wl.drained         = 0;
    wl.alloc           = alloc;
    wl.uni_reports.len = 0;
    wl.secret_state    = SECRET_UNKNOWN;
    wl.limited         = false;
    wl.dedup           = map.init[u64, u32](alloc);
    ret res[*InstWorklist, fail.Fail].ok{wl};
}

pub fun inst_worklist_free(wl: *InstWorklist) {
    if (wl == nil) { ret; }
    var i: u32 = 0;
    for (i < wl.len) {
        val e: *InstReq = ?wl.items[i];
        if (e.args != nil && e.arg_len > 0) {
            A.deallocate[type.TypeId](wl.alloc, e.args, e.arg_len::usize);
        }
        i = i + 1;
    }
    if (wl.items != nil && wl.cap > 0) {
        A.deallocate[InstReq](wl.alloc, wl.items, wl.cap::usize);
    }
    map.dnit[u64, u32](?wl.dedup);
    A.deallocate[InstWorklist](wl.alloc, wl, 1::usize);
}

pub fun inst_worklist_dnit(sc: *SemaContext) {
    inst_worklist_free(sc.insts);
    sc.insts = nil;
}

pub fun module_sema_for(sc: *SemaContext, module: session.ModuleId) opt[*ModuleSema] {
    if (sc.deps == nil) { ret opt[*ModuleSema].none{}; }
    var i: u32 = 0;
    for (i < sc.deps.count) {
        val ms: *ModuleSema = sc.deps.entries[i];
        if (ms.module == module) { ret opt[*ModuleSema].some{ms}; }
        i = i + 1;
    }
    ret opt[*ModuleSema].none{};
}

pub fun public_type_for(sc: *SemaContext, sym: *resolve.Symbol) opt[TypeExport] {
    if (sc.deps == nil) { ret opt[TypeExport].none{}; }
    val owner: session.StableModuleId = resolve.type_owner(sc.s, sym.origin, sym.definition_file).module;
    var i:     u32                    = 0;
    for (i < sc.deps.count) {
        val found: res[opt[TypeExport], A.Error] = module_export_for(sc.deps.entries[i], owner, sym.canon);
        if (sel found.err) {
            fail.internal(?sc.status, "out of memory indexing a dependency's public types");
            ret opt[TypeExport].none{};
        }
        if (sel found.ok.some) { ret found.ok; }
        i = i + 1;
    }
    ret opt[TypeExport].none{};
}

pub fun decl_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    if (sym.kind == resolve.SYM_PARAM)   { ret param_type_for(sc, sym); }
    if (sym.kind == resolve.SYM_GENERIC) { ret generic_param_type_for(sc, sym); }
    if (sym.origin == sc.own_module) {
        if (sc.decl_type == nil || sym.decl == id.DECL_NIL || sym.decl >= sc.a.decl_len::u32) { ret type.TYPE_ERROR; }
        ret sc.decl_type[sym.decl];
    }
    val exported: opt[TypeExport] = public_type_for(sc, sym);
    if (!sel exported.some) {
        fail.internal(?sc.status, "imported type has no acquired public surface");
        ret type.TYPE_ERROR;
    }
    ret exported.some.ty;
}

pub fun symbol_for_expr(sc: *SemaContext, eid: id.ExprId) opt[*resolve.Symbol] {
    if (sc.rr == nil || sc.rr.expr_resolved == nil) { ret opt[*resolve.Symbol].none{}; }
    if (eid >= sc.rr.expr_count)                    { ret opt[*resolve.Symbol].none{}; }
    val sid: resolve.SymbolId = sc.rr.expr_resolved[eid];
    ret symbol_by_id(sc, sid);
}

pub fun comptime_ident_is_runtime(sc: *SemaContext, eid: id.ExprId) bool {
    if (sc == nil || eid == id.EXPR_NIL) { ret false; }
    val opt_sym: opt[*resolve.Symbol] = symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    ret resolve.symbol_is_runtime(opt_sym.some);
}

pub fun symbol_for_type(sc: *SemaContext, tid: id.TypeId) opt[*resolve.Symbol] {
    if (sc.rr == nil || sc.rr.type_resolved == nil) { ret opt[*resolve.Symbol].none{}; }
    if (tid >= sc.rr.type_count)                    { ret opt[*resolve.Symbol].none{}; }
    val sid: resolve.SymbolId = sc.rr.type_resolved[tid];
    ret symbol_by_id(sc, sid);
}

pub fun symbol_by_id(sc: *SemaContext, sid: resolve.SymbolId) opt[*resolve.Symbol] {
    if (sid == resolve.SYMBOL_NIL)            { ret opt[*resolve.Symbol].none{}; }
    if (sc.rr == nil || sc.rr.symbols == nil) { ret opt[*resolve.Symbol].none{}; }
    if (sid >= sc.rr.symbol_count)            { ret opt[*resolve.Symbol].none{}; }
    ret opt[*resolve.Symbol].some{?sc.rr.symbols[sid]};
}

pub fun ptr_width_of(sc: *SemaContext) u32 {
    ret sc.ctx.env.pointer_width;
}

pub fun machine_of(sc: *SemaContext) layout.Machine {
    ret layout.machine(sc.ctx.env.pointer_width, sc.ctx.env.vector_bits);
}

pub val TEMPLATE_TRAIL_LABEL: str = "in this generic body, checked against this instance's type arguments";

# a rejection raised while checking an instance body is the instantiation's, not the
# template's: it points at the call that asked for this instance and carries the
# template's own span as the related site
fun emit_error(sc: *SemaContext, span: token.Span, message: str, note: str) {
    var file: source.FileId = sc.a.file_id;
    var at:   token.Span    = span;
    if (sc.inst_site_set) {
        file = sc.inst_site_file;
        at   = sc.inst_site;
    }

    val b_r: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(sc.diags.a, diagnostic.SEVERITY_ERROR, file, at, message);
    if (sel b_r.err) {
        fail.internal(?sc.status, fail.describe(b_r.err));
        ret;
    }
    var b: diagnostic.DiagnosticBuilder = b_r.ok;

    if (note != nil) {
        val ar: err[fail.Fail] = diagnostic.attach_note(?b, note);
        if (sel ar.err) {
            diagnostic.builder_dnit(?b);
            fail.internal(?sc.status, fail.describe(ar.err));
            ret;
        }
    }
    if (sc.inst_site_set) {
        val rr: err[fail.Fail] = diagnostic.attach_related(?b, sc.a.file_id, span, TEMPLATE_TRAIL_LABEL);
        if (sel rr.err) {
            diagnostic.builder_dnit(?b);
            fail.internal(?sc.status, fail.describe(rr.err));
            ret;
        }
    }

    if (sc.in_comptime_gate) {
        val r: res[bool, fail.Fail] = diagnostic.gate_commit(sc.diags, ?sc.s.interner, ?b);
        if (sel r.err) { fail.internal(?sc.status, fail.describe(r.err)); }
        ret;
    }

    val cr: res[diagnostic.DiagnosticId, fail.Fail] = diagnostic.commit(?b, sc.diags);
    if (sel cr.err) {
        diagnostic.builder_dnit(?b);
        fail.internal(?sc.status, fail.describe(cr.err));
    }
}

pub fun report(sc: *SemaContext, span: token.Span, message: str) {
    if (sc.silent) { ret; }
    fail.reject(?sc.status);
    emit_error(sc, span, message, nil);
}

pub fun report_internal(sc: *SemaContext, span: token.Span, message: str) {
    fail.internal(?sc.status, message);
}

pub fun type_result(sc: *SemaContext, r: res[type.TypeId, fail.Fail]) type.TypeId {
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}

pub fun diag_mark(sc: *SemaContext) u64 {
    ret sc.status.rejections;
}

pub fun reported_since(sc: *SemaContext, mark: u64) bool {
    ret sc.status.rejections != mark;
}

pub fun report_warning(sc: *SemaContext, span: token.Span, message: str) {
    if (sc.silent || sc.in_comptime_gate) { ret; }
    val r: err[fail.Fail] = diagnostic.warning(sc.diags, sc.a.file_id, span, message);
    if (sel r.err) { fail.internal(?sc.status, fail.describe(r.err)); }
}

pub fun report_note(sc: *SemaContext, span: token.Span, message: str, note: str) {
    if (sc.silent) { ret; }
    fail.reject(?sc.status);
    emit_error(sc, span, message, note);
}

pub fun report_numbered(sc: *SemaContext, span: token.Span, prefix: str, n: usize, suffix: str, fallback: str) {
    val res_msg: res[str, format.FormatError] = format.sprint(sc.s.alloc, "{}{}{}", prefix, n, suffix);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        ret;
    }
    val msg: str = res_msg.ok;
    report(sc, span, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

pub fun field_table_stage(sc: *SemaContext, additional: u32) res[u32, fail.Fail] {
    ret type.field_table_stage(?sc.s.types, additional);
}

pub fun field_table_stage_push(sc: *SemaContext, name: intern.StrId, ty: type.TypeId) err[fail.Fail] {
    ret type.field_table_stage_push(?sc.s.types, name, ty);
}

pub fun field_table_stage_push_entry(sc: *SemaContext, entry: type.FieldEntry) err[fail.Fail] {
    ret type.field_table_stage_push_entry(?sc.s.types, entry);
}

pub fun field_table_publish(sc: *SemaContext, ty: type.TypeId, fields_start: u32, fields_len: u32) err[fail.Fail] {
    ret type.field_table_publish(?sc.s.types, ty, fields_start, fields_len);
}

pub fun field_table_for(sc: *SemaContext, ty: type.TypeId) opt[*FieldTable] {
    ret type.field_table_for(?sc.s.types, ty);
}

pub fun field_epoch(sc: *SemaContext) u32 {
    ret type.field_epoch(?sc.s.types);
}

pub fun field_lookup(sc: *SemaContext, ty: type.TypeId, name: intern.StrId) opt[type.TypeId] {
    val ft_opt: opt[*FieldTable] = field_table_for(sc, ty);
    if (!sel ft_opt.some) { ret opt[type.TypeId].none{}; }
    val ft: *FieldTable = ft_opt.some;

    var i: u32 = 0;
    for (i < ft.fields_len) {
        val fe: *type.FieldEntry = type.field_entry_at(?sc.s.types, ft, i);
        if (fe.name == name) { ret opt[type.TypeId].some{fe.ty}; }
        i = i + 1;
    }
    ret opt[type.TypeId].none{};
}

pub fun resolve_field_member(sc: *SemaContext, owner: u32, index: u32, pick: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }

    if (pick == comptime.FIELD_SEL_ZERO_BY_NAME) {
        ret resolve_omitted_field_zero(sc, owner::type.TypeId, index::intern.StrId);
    }
    if (pick == comptime.FIELD_SEL_TYPE_BY_NAME) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{field_type_by_name(?sc.s.types, owner::type.TypeId, index::intern.StrId)};
    }

    val fa: opt[*type.FieldEntry] = type.field_at(?sc.s.types, owner::type.TypeId, index);
    if (sel fa.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val fe: *type.FieldEntry = fa.some;

    if (pick == comptime.FIELD_SEL_NAME) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_str(fe.name)}};
    }
    if (pick == comptime.FIELD_SEL_HAS_PAYLOAD) {
        var bit: u8 = 1;
        if (fe.ty == type.TYPE_NIL) { bit = 0; }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(bit)}};
    }
    if (pick == comptime.FIELD_SEL_CODE) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(index::u64)}};
    }
    # a payloadless case owns no storage, so it has neither a type nor an offset
    if (fe.ty == type.TYPE_NIL && (pick == comptime.FIELD_SEL_TYPE || pick == comptime.FIELD_SEL_OFFSET)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, comptime.COMPTIME_CASE_NO_PAYLOAD_MSG)};
    }
    if (pick == comptime.FIELD_SEL_TYPE) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_type(fe.ty::u32)}};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
}

# the declared type of a field or case payload named on an owner; none for an unknown name or a payloadless case
pub fun field_type_by_name(types: *type.TypeInterner, owner_ty: type.TypeId, name: intern.StrId) opt[comptime.CTValue] {
    val stripped: type.TypeId = type.strip_secret(types, owner_ty);
    val n:        u32         = type.field_count(types, stripped);
    var i:        u32         = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(types, stripped, i);
        if (sel fa.some) {
            if (fa.some.name == name) {
                val fty: type.TypeId = fa.some.ty;
                if (fty == type.TYPE_NIL) { ret opt[comptime.CTValue].none{}; }
                ret opt[comptime.CTValue].some{comptime.ct_type(fty::u32)};
            }
        }
        i = i + 1;
    }
    ret opt[comptime.CTValue].none{};
}

fun resolve_omitted_field_zero(sc: *SemaContext, owner_ty: type.TypeId, name: intern.StrId) res[opt[comptime.CTValue], comptime.EvalFail] {
    val stripped: type.TypeId = type.strip_secret(?sc.s.types, owner_ty);
    val n:        u32         = type.field_count(?sc.s.types, stripped);
    var i:        u32         = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(?sc.s.types, stripped, i);
        if (sel fa.some) {
            val fe: *type.FieldEntry = fa.some;
            if (fe.name == name) {
                val fty: type.TypeId     = type.strip_secret(?sc.s.types, fe.ty);
                val ft:  opt[*type.Type] = type.get(?sc.s.types, fty);
                if (sel ft.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
                val kind: type.TypeKind = ft.some.kind;
                val pd:   type.PrimDesc = type.prim_desc(kind);
                if (pd.class == type.PRIM_CLASS_INT) {
                    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_zero_int(!pd.signed, pd.bits::u8)}};
                }
                if (pd.class == type.PRIM_CLASS_FLOAT) {
                    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_float(0.0, type.float_width_of(kind))}};
                }
                ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
            }
        }
        i = i + 1;
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
}

pub fun resolve_type_comparison_operand(sc: *SemaContext, eid: id.ExprId) res[opt[u32], comptime.EvalFail] {
    if (sc == nil)                                       { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    if (sc.expr_type == nil)                             { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    if (eid == id.EXPR_NIL || eid >= sc.a.expr_len::u32) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    val t: type.TypeId = apply_subst(sc, sc.expr_type[eid]);
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    if (type.mentions_generic_param(?sc.s.types, t)) {
        ret res[opt[u32], comptime.EvalFail].err{comptime.eval_error(
            comptime.EVAL_FAIL_NEEDS_INSTANCE, comptime.COMPTIME_TYPE_NEEDS_INSTANCE_MSG)};
    }
    ret res[opt[u32], comptime.EvalFail].ok{opt[u32].some{t::u32}};
}

fun gated_member_const_message(sc: *SemaContext, name: intern.StrId, dep_path: intern.StrId) str {
    val fallback: str      = "tuple-dependent public constants are not yet supported in union builds";
    val no:       opt[str] = intern.lookup(?sc.s.interner, name);
    val fo:       opt[str] = intern.lookup(?sc.s.interner, dep_path);
    if (!sel no.some) { ret fallback; }
    if (!sel fo.some) { ret fallback; }

    val res_msg: res[str, format.FormatError] = format.sprint(sc.s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        no.some, fo.some);
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        ret fallback;
    }
    val buf: str = res_msg.ok;

    val ir: res[intern.StrId, A.Error] = intern.intern(?sc.s.interner, buf);
    str_free(sc.s.alloc, buf);
    if (sel ir.err) {
        fail.internal(?sc.status, alloc.text(ir.err));
        ret fallback;
    }

    val nm: opt[str] = intern.lookup(?sc.s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret fallback;
}

pub fun resolve_module_member_const(sc: *SemaContext, eid: id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (sc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val rr: *resolve.ResolveResult = sc.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sid: resolve.SymbolId = rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid::u32 >= rr.symbol_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_IMPORTED) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val exported: opt[TypeExport] = public_type_for(sc, sym);
    if (!sel exported.some) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    if (!exported.some.constant.present) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val item:  TypeExport             = exported.some;
    val named: resolve.ExportConstant = item.constant;
    if (named.value.kind == comptime.CT_KIND_CONST_ELEM) {
        val current: res[DefinedSymbol, fail.Fail] = imported_definition(sc, sym, DEFINITION_RESOLVED);
        if (sel current.err) {
            val reason: fail.Fail             = current.err;
            var kind:   comptime.EvalFailKind = comptime.EVAL_FAIL_INTERNAL;
            if (sel reason.reported) { kind = comptime.EVAL_FAIL_REJECTED; }
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(kind, fail.describe(reason))};
        }
        if (current.ok.definition.parsed.incarnation != item.definition_incarnation) {
            fail.internal(?sc.status, "constant element does not belong to the acquired parsed definition");
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.status_text(sc.status))};
        }
    }
    if (named.gated && sc.ctx.env.union_build) {
        val dep_path: intern.StrId              = session.module_fqn(sc.s, sym.origin);
        val msg:      str                       = gated_member_const_message(sc, sym.name, dep_path);
        val e_opt:    res[expr.Expr, fail.Fail] = expression(sc, eid);
        var span:     token.Span;
        span.offset = 0;
        span.len    = 0;
        if (sel e_opt.ok) { span = e_opt.ok.span; }
        report(sc, span, msg);
        if (sel sc.status.kind.internal) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.status_text(sc.status))};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, msg)};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{named.value}};
}

fun param_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    val f_opt: opt[*decl.DeclFun] = fun_decl_for(sc, sym.decl);
    if (!sel f_opt.some) { ret type.TYPE_ERROR; }
    val f: *decl.DeclFun = f_opt.some;
    if (sym.slot >= f.params_len) { ret type.TYPE_ERROR; }
    val tn: *decl.TypedName = ?sc.a.typed_names[f.params_start + sym.slot];
    ret resolved_type_of(sc, tn.ty);
}

pub fun own_nominal_declaration(sc: *SemaContext, nominal: *type.Type) res[id.DeclId, fail.Fail] {
    if (sc.rr == nil || sc.a == nil) { ret res[id.DeclId, fail.Fail].err{fail.message("nominal definition requires the active resolved owner")}; }
    val owner: type.TypeOwner = resolve.type_owner(sc.s, sc.own_module, sc.a.file_id);
    if (nominal.data.nominal.owner.module != owner.module || nominal.data.nominal.owner.file != owner.file) {
        ret res[id.DeclId, fail.Fail].err{fail.message("nominal definition belongs to another source owner")};
    }
    var found: id.DeclId = id.DECL_NIL;
    var i:     u32       = 0;
    for (i < sc.rr.symbol_count) {
        val symbol:  *resolve.Symbol = ?sc.rr.symbols[i];
        var matches: bool            = symbol.kind == resolve.SYM_REC && nominal.kind == type.TYPE_REC;
        if (symbol.kind == resolve.SYM_UNI && nominal.kind == type.TYPE_UNI) { matches = true; }
        if (symbol.kind == resolve.SYM_TAG && nominal.kind == type.TYPE_TAG) { matches = true; }
        if (matches && symbol.origin == sc.own_module && symbol.canon == nominal.data.nominal.name) {
            if (found != id.DECL_NIL && found != symbol.decl) { ret res[id.DeclId, fail.Fail].err{fail.message("nominal definition is ambiguous in the active resolved owner")}; }
            found = symbol.decl;
        }
        i = i + 1;
    }
    if (found == id.DECL_NIL || found >= sc.a.decl_len::u32) { ret res[id.DeclId, fail.Fail].err{fail.message("nominal definition is absent from the active resolved owner")}; }
    ret res[id.DeclId, fail.Fail].ok{found};
}

pub fun definition_ast(sc: *SemaContext, origin: session.ModuleId) *ast.Ast {
    if (origin == sc.own_module) { ret sc.a; }
    if (sc.deps == nil) {
        fail.internal(?sc.status, "semantic definition has no dependency reader");
        ret nil;
    }
    val acquired: res[Definition, fail.Fail] = acquire_definition(?sc.deps.definitions, origin, DEFINITION_PARSED);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?sc.status); }
        or                       { fail.internal(?sc.status, fail.describe(reason)); }
        ret nil;
    }
    ret acquired.ok.parsed.a;
}

# the identity a declaration's type parameters carry (type.TypeGenericParam owner
# fields): the one key both interning a parameter and substituting for it use
pub fun generic_owner_of_decl(s: *session.Session, a: *ast.Ast, origin: session.ModuleId,
    decl_id: id.DeclId) res[type.GenericOwner, fail.Fail] {
    val selected: opt[*decl.Decl] = ast.get_decl(a, decl_id);
    if (!sel selected.some) { ret res[type.GenericOwner, fail.Fail].err{fail.message("generic owner declaration is absent from its module")}; }
    val declaration: *decl.Decl    = selected.some;
    var name:        token.Span;
    var kind:        type.TypeKind = type.TYPE_FUN;
    if (declaration.kind == decl.DECL_KIND_FUN) { name = declaration.data.fun_.name; }
    or (declaration.kind == decl.DECL_KIND_REC) {
        name = declaration.data.rec_.name;
        kind = type.TYPE_REC;
    }
    or (declaration.kind == decl.DECL_KIND_UNI) {
        name = declaration.data.uni_.name;
        kind = type.TYPE_UNI;
    }
    or (declaration.kind == decl.DECL_KIND_TAG) {
        name = declaration.data.tag_.name;
        kind = type.TYPE_TAG;
    }
    or { ret res[type.GenericOwner, fail.Fail].err{fail.message("generic owner has the wrong declaration kind")}; }
    val text: opt[*source.SourceFile] = source.get(?s.sources, a.file_id);
    if (sel text.none) { ret res[type.GenericOwner, fail.Fail].err{fail.message("generic owner has no source")}; }
    val canonical: res[intern.StrId, A.Error] = intern.intern_span(?s.interner, text.some.text, name);
    if (sel canonical.err) { ret res[type.GenericOwner, fail.Fail].err{fail.message(alloc.text(canonical.err))}; }
    ret res[type.GenericOwner, fail.Fail].ok{type.GenericOwner{
        owner: resolve.type_owner(s, origin, a.file_id), name: canonical.ok, kind: kind
    }};
}

pub fun generic_param_type_for(sc: *SemaContext, sym: *resolve.Symbol) type.TypeId {
    val a: *ast.Ast = definition_ast(sc, sym.origin);
    if (a == nil) { ret type.TYPE_ERROR; }
    val who_r: res[type.GenericOwner, fail.Fail] = generic_owner_of_decl(sc.s, a, sym.origin, sym.decl);
    if (sel who_r.err) {
        fail.internal(?sc.status, fail.describe(who_r.err));
        ret type.TYPE_ERROR;
    }
    val who:        type.GenericOwner           = who_r.ok;
    val res_intern: res[type.TypeId, fail.Fail] = type.intern_generic_param(?sc.s.types, sym.name,
        who.owner, who.name, who.kind, sym.slot);
    if (sel res_intern.err) {
        fail.internal(?sc.status, fail.describe(res_intern.err));
        ret type.TYPE_ERROR;
    }
    ret apply_subst(sc, res_intern.ok);
}

fun fun_decl_for(sc: *SemaContext, did: id.DeclId) opt[*decl.DeclFun] {
    val d_opt: opt[*decl.Decl] = ast.get_decl(sc.a, did);
    if (!sel d_opt.some) { ret opt[*decl.DeclFun].none{}; }
    val d: *decl.Decl = d_opt.some;
    if (d.kind != decl.DECL_KIND_FUN) { ret opt[*decl.DeclFun].none{}; }
    ret opt[*decl.DeclFun].some{?d.data.fun_};
}

pub fun embed_len_of(sc: *SemaContext, tid: id.TypeId) u64 {
    if (sc.embed_len == nil)         { ret EMBED_LEN_NONE; }
    if (tid == id.TYPE_NIL)          { ret EMBED_LEN_NONE; }
    if (tid::usize >= sc.a.type_len) { ret EMBED_LEN_NONE; }
    ret sc.embed_len[tid];
}

pub fun set_embed_len(sc: *SemaContext, tid: id.TypeId, len: u64) {
    if (sc.embed_len == nil)         { ret; }
    if (tid == id.TYPE_NIL)          { ret; }
    if (tid::usize >= sc.a.type_len) { ret; }
    sc.embed_len[tid] = len;
}

fun t_export(origin: session.StableModuleId, canon: intern.StrId, ty: type.TypeId) TypeExport {
    var e: TypeExport = TypeExport{};
    e.origin = origin;
    e.canon  = canon;
    e.ty     = ty;
    ret e;
}

fun t_push(m: *ModuleSema, e: TypeExport) bool {
    val r: res[usize, A.Error] = vector.push[TypeExport](?m.exports, e);
    ret sel r.ok;
}

fun t_export_ty(m: *ModuleSema, origin: session.StableModuleId, canon: intern.StrId) type.TypeId {
    val r: res[opt[TypeExport], A.Error] = module_export_for(m, origin, canon);
    if (sel r.err)     { ret 0xFFFFFFFE; }
    if (sel r.ok.none) { ret 0xFFFFFFFF; }
    ret r.ok.some.ty;
}

# the index answers what the scan it replaced answered: the first export with the key,
# a miss as none, and exports appended after a lookup (#3472)
test "mach.lang.fe.sema.context.module_export_for:indexes_first_match_and_follows_appends" {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var m: ModuleSema = module_sema_init(?alloc, 1, 1);
    fin { module_sema_dnit(?m); }
    if (!t_push(?m, t_export(7, 10, 100)))    { ret 2; }
    if (!t_push(?m, t_export(7, 10, 101)))    { ret 2; }
    if (!t_push(?m, t_export(8, 10, 102)))    { ret 2; }
    if (t_export_ty(?m, 7, 10) != 100)        { ret 3; }
    if (t_export_ty(?m, 8, 10) != 102)        { ret 4; }
    if (t_export_ty(?m, 7, 11) != 0xFFFFFFFF) { ret 5; }
    if (t_export_ty(?m, 10, 7) != 0xFFFFFFFF) { ret 6; }
    if (!t_push(?m, t_export(7, 11, 103)))    { ret 7; }
    if (t_export_ty(?m, 7, 11) != 103)        { ret 8; }
    if (m.indexed != 4)                       { ret 9; }
    ret 0;
}

test "mach.lang.fe.sema.context.embed_len:preserves_full_u32_domain" {
    var a: ast.Ast;
    a.type_len = 1;

    var slots: [1]u64;
    slots[0] = EMBED_LEN_NONE;

    var sc: SemaContext;
    sc.a         = ?a;
    sc.embed_len = ?slots[0];

    set_embed_len(?sc, 0::id.TypeId, 0xFFFFFFFF);
    if (embed_len_of(?sc, 0::id.TypeId) != 0xFFFFFFFF) { ret 1; }

    set_embed_len(?sc, 0::id.TypeId, 0xFFFFFFFE);
    if (embed_len_of(?sc, 0::id.TypeId) != 0xFFFFFFFE) { ret 1; }
    ret 0;
}

pub fun record_embed_path(sc: *SemaContext, path_id: intern.StrId) err[fail.Fail] {
    var i: u32 = 0;
    for (i < sc.embed_path_len) {
        if (sc.embed_paths[i] == path_id) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }

    if (sc.embed_path_len == sc.embed_path_cap) {
        var new_cap: u32 = 4;
        if (sc.embed_path_cap > 0) { new_cap = sc.embed_path_cap * 2; }
        if (sc.embed_paths == nil) {
            val ar: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](sc.s.alloc, new_cap::usize);
            if (sel ar.err) {
                fail.internal(?sc.status, alloc.text(ar.err));
                ret err[fail.Fail].err{fail.refused(ar.err)};
            }
            sc.embed_paths = ar.ok;
        }
        or {
            val rr: res[*intern.StrId, A.Error] = A.reallocate[intern.StrId](sc.s.alloc, sc.embed_paths, sc.embed_path_cap::usize, new_cap::usize);
            if (sel rr.err) {
                fail.internal(?sc.status, alloc.text(rr.err));
                ret err[fail.Fail].err{fail.refused(rr.err)};
            }
            sc.embed_paths = rr.ok;
        }
        sc.embed_path_cap = new_cap;
    }

    sc.embed_paths[sc.embed_path_len] = path_id;
    sc.embed_path_len                 = sc.embed_path_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun recover[T](sc: *SemaContext, r: res[T, fail.Fail], recovery: T) T {
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(r.err));
        ret recovery;
    }
    ret r.ok;
}

pub fun record_result(sc: *SemaContext, r: err[fail.Fail]) {
    if (sel r.err) { fail.internal(?sc.status, fail.describe(r.err)); }
}

pub fun record_eval_result(sc: *SemaContext, r: res[comptime.CTValue, comptime.EvalFail]) {
    if (sel r.ok) { ret; }
    val f: comptime.EvalFail = r.err;
    if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?sc.status, f.message); }
}

rec CountingDefinition {
    current: Definition;
    reads:   u32;
}

fun t_counting_definition(raw: ptr, origin: session.ModuleId, phase: DefinitionPhase) res[Definition, fail.Fail] {
    val probe: *CountingDefinition = raw::*CountingDefinition;
    probe.reads = probe.reads + 1;
    if (probe.current.origin != origin) { ret res[Definition, fail.Fail].err{fail.message("counting definition owner differs")}; }
    ret res[Definition, fail.Fail].ok{probe.current};
}

test "mach.lang.fe.sema.context.acquire_definition:reads_each_origin_once_per_reader_and_upgrades_the_phase" {
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var a1:  ast.Ast;
    var sm1: SemaResult = SemaResult{};
    var rr1: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    a1.incarnation = 1;
    rr1.status     = fail.accepted();
    sm1.status     = fail.accepted();
    val mid:                        session.ModuleId = 0::session.ModuleId;
    val register_module_identity_r: err[fail.Fail]   = session.register_module_identity(?s, mid, ?a1, 7::intern.StrId, 5);
    if (sel register_module_identity_r.err) { ret 1; }

    var probe: CountingDefinition = CountingDefinition{
        current: Definition{
            parsed: resolve.ParsedDefinition{a: ?a1, owner: resolve.type_owner(?s, mid, a1.file_id), incarnation: a1.incarnation},
            origin: mid, rr: ?rr1, sr: ?sm1, ctx: ?cc1
        },
        reads: 0
    };
    var reader: DefinitionReader = reader_init((?probe)::ptr, t_counting_definition, ?alloc);
    fin { reader_dnit(?reader); }

    val first:  res[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_RESOLVED);
    val second: res[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_RESOLVED);
    if (sel first.err)        { ret 2; }
    if (sel second.err)       { ret 2; }
    if (probe.reads != 1)     { ret 3; }
    if (second.ok.rr != ?rr1) { ret 4; }

    # a typed request outranks the resolved entry and replaces it
    val typed: res[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_TYPED);
    if (sel typed.err)       { ret 5; }
    if (probe.reads != 2)    { ret 5; }
    if (typed.ok.sr != ?sm1) { ret 6; }
    val resolved_again: res[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_RESOLVED);
    val typed_again:    res[Definition, fail.Fail] = acquire_definition(?reader, mid, DEFINITION_TYPED);
    if (sel resolved_again.err)                       { ret 7; }
    if (sel typed_again.err)                          { ret 7; }
    if (probe.reads != 2 || reader.acquired.len != 1) { ret 8; }

    # a failed read is not remembered, and another origin is its own entry
    val other: res[Definition, fail.Fail] = acquire_definition(?reader, 1::session.ModuleId, DEFINITION_RESOLVED);
    if (sel other.ok)             { ret 9; }
    if (probe.reads != 3)         { ret 9; }
    if (reader.acquired.len != 1) { ret 9; }
    val other_again: res[Definition, fail.Fail] = acquire_definition(?reader, 1::session.ModuleId, DEFINITION_RESOLVED);
    if (sel other_again.ok) { ret 10; }
    if (probe.reads != 4)   { ret 10; }
    ret 0;
}

pub def StmtListVisitor: fun(ptr, *SemaContext, u32, u32) err[fail.Fail];
