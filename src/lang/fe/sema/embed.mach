use lang_alloc:      mach.lang.alloc;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std_format: std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_empty;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use std_allocator: std.allocator;

use mach.lang.embed;
use mach.lang.fe.ast;
use ast_decl:     mach.lang.fe.ast.decl;
use ast_expr:     mach.lang.fe.ast.expr;
use ast_id:       mach.lang.fe.ast.id;
use ast_type:     mach.lang.fe.ast.type;
use sema_context: mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.session;
use lang_source: mach.lang.source;

# an embed outside the project root is refused, and its bytes are never read:
# the driver skips the path when it collects embed inputs, and this is the
# diagnostic that names why
pub val ESCAPED_EMBED_MSG: str = "`embed` path escapes the project root; an embedded file must live inside the project and the file is not read";

pub fun resolve_one(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl,
    dec: *ast_decl.Decorator) err[fail.Fail] {
    if (!check_target(sc, d, dec)) { ret embed_failed(sc, d); }

    val opt_arg: opt[str] = string_arg(sc, dec);
    if (!sel opt_arg.some) { ret embed_failed(sc, d); }
    val arg: str = opt_arg.some;

    val opt_file: opt[str] = module_file(sc);
    if (!sel opt_file.some) {
        sema_context.report(sc, diagnostic_kind.EMBED_NO_LOCATION, dec.name, "`embed` decorator cannot resolve a path: the declaring file has no on-disk location");
        ret embed_failed(sc, d);
    }

    val pr: res[str, manifest.TemplateError] = embed.resolve_arg(sc.s.alloc, ?sc.s.embeds, ?sc.s.interner,
        session.module_fqn(sc.s, sc.own_module), opt_file.some, arg);
    if (sel pr.err) {
        val e: manifest.TemplateError = pr.err;
        fin { manifest.template_error_dnit(sc.s.alloc, e); }
        if (sel e.internal) { fail.internal(?sc.status, e.internal); }
        or                  { sema_context.report(sc, diagnostic_kind.EMBED_PATH_TEMPLATE, dec.name, manifest.template_text(e)); }
        ret embed_failed(sc, d);
    }
    val resolved:  str                  = pr.ok;
    val contained: res[bool, fail.Fail] = embed.escapes_root(sc.s.alloc, ?sc.s.embeds, resolved);
    if (sel contained.err) {
        val reason: str = fail.describe(contained.err);
        fail.internal(?sc.status, reason);
        str_free(sc.s.alloc, resolved);
        ret err[fail.Fail].err{fail.message(reason)};
    }
    if (contained.ok) {
        sema_context.report(sc, diagnostic_kind.EMBED_ESCAPES_ROOT, dec.name, ESCAPED_EMBED_MSG);
        str_free(sc.s.alloc, resolved);
        ret embed_failed(sc, d);
    }

    val ir: res[intern.StrId, std_allocator.Error] = intern.intern(?sc.s.interner, resolved);
    str_free(sc.s.alloc, resolved);
    if (sel ir.err) {
        fail.internal(?sc.status, lang_alloc.text(ir.err));
        ret err[fail.Fail].err{fail.refused(ir.err)};
    }
    val path_id: intern.StrId = ir.ok;

    val rp: err[fail.Fail] = sema_context.record_embed_path(sc, path_id);
    if (sel rp.err) { ret rp; }

    val opt_entry: opt[*embed.EmbedFile] = embed.get(?sc.s.embeds, path_id);
    if (sel opt_entry.none) {
        report_path(sc, d, dec, path_id, arg, "was not read for this build");
        ret embed_failed(sc, d);
    }
    val e: *embed.EmbedFile = opt_entry.some;
    if (e.status != embed.EMBED_OK) {
        report_path(sc, d, dec, path_id, arg, e.reason);
        ret embed_failed(sc, d);
    }

    if (!size_annotation(sc, d, dec, e.len)) { ret embed_failed(sc, d); }
    ret err[fail.Fail].ok{};
}

fun embed_failed(sc: *sema_context.SemaContext, d: *ast_decl.Decl) err[fail.Fail] {
    if (d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) {
        mark_failed(sc, d.data.bind.ty);
    }
    ret err[fail.Fail].ok{};
}

fun mark_failed(sc: *sema_context.SemaContext, tid: ast_id.TypeId) {
    val opt_t: opt[*ast_type.Type] = ast.get_type(sc.a, tid);
    if (!sel opt_t.some) { ret; }
    val t: *ast_type.Type = opt_t.some;

    if (t.kind == ast_type.TYPE_KIND_ARRAY) {
        if (t.data.array.length == ast_id.EXPR_NIL) {
            sema_context.set_embed_len(sc, tid, sema_context.EMBED_LEN_FAILED);
        }
        mark_failed(sc, t.data.array.element);
        ret;
    }
    if (t.kind == ast_type.TYPE_KIND_PTR) {
        mark_failed(sc, t.data.ptr.pointee);
        ret;
    }
    if (t.kind == ast_type.TYPE_KIND_SECRET) {
        mark_failed(sc, t.data.secret.inner);
        ret;
    }
    if (t.kind == ast_type.TYPE_KIND_NAMED) {
        var i: u32 = 0;
        for (i < t.data.named.args_len) {
            mark_failed(sc, sc.a.type_ids[t.data.named.args_start + i]);
            i = i + 1;
        }
        ret;
    }
    if (t.kind == ast_type.TYPE_KIND_FUN) {
        var i: u32 = 0;
        for (i < t.data.fun_.params_len) {
            mark_failed(sc, sc.a.type_ids[t.data.fun_.params_start + i]);
            i = i + 1;
        }
        mark_failed(sc, t.data.fun_.ret_type);
        ret;
    }
    if (t.kind == ast_type.TYPE_KIND_REC) {
        mark_failed_fields(sc, t.data.rec_.fields_start, t.data.rec_.fields_len);
        ret;
    }
    if (t.kind == ast_type.TYPE_KIND_UNI) { mark_failed_fields(sc, t.data.uni_.fields_start, t.data.uni_.fields_len); }
}

fun mark_failed_fields(sc: *sema_context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        mark_failed(sc, sc.a.typed_names[start + i].ty);
        i = i + 1;
    }
}

fun check_target(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) bool {
    if (d.kind != ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.EMBED_TARGET, dec.name, "`embed` decorator applies only to a `val`");
        ret false;
    }
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.EMBED_TARGET, dec.name, "`embed` decorator cannot apply to an `ext` data import");
        ret false;
    }
    if (d.data.bind.init != ast_id.EXPR_NIL) {
        sema_context.report(sc, diagnostic_kind.EMBED_INITIALIZER, dec.name, "an `embed` declaration cannot also have an initializer; the file's content is the initializer");
        ret false;
    }
    ret true;
}

fun string_arg(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) opt[str] {
    if (dec.args_len != 1) {
        sema_context.report(sc, diagnostic_kind.EMBED_ARGUMENT, dec.name, "`embed` decorator takes one string argument");
        ret opt[str].none{};
    }
    val arg: opt[str] = sema_context.attr_string_arg(sc, dec, 0, diagnostic_kind.EMBED_ARGUMENT, "`embed` decorator argument must be a string");
    if (sel arg.none) { ret arg; }
    if (str_len(arg.some) == 0) {
        sema_context.report(sc, diagnostic_kind.EMBED_ARGUMENT, embed_arg_span(sc, dec), "`embed` decorator path must not be empty");
        ret opt[str].none{};
    }
    ret arg;
}

fun embed_arg_span(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) token.Span {
    val e: opt[*ast_expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start]);
    if (sel e.none) { ret dec.name; }
    ret e.some.span;
}

fun module_file(sc: *sema_context.SemaContext) opt[str] {
    val found: opt[*lang_source.SourceFile] = lang_source.get(?sc.s.sources, sc.a.file_id);
    if (sel found.none) { ret opt[str].none{}; }
    val f: *lang_source.SourceFile = found.some;
    if (f.path == nil) { ret opt[str].none{}; }
    ret opt[str].some{f.path};
}

fun size_annotation(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator, len: u32) bool {
    val tid:   ast_id.TypeId       = d.data.bind.ty;
    val opt_t: opt[*ast_type.Type] = ast.get_type(sc.a, tid);
    if (!sel opt_t.some) { ret false; }
    val t: *ast_type.Type = opt_t.some;

    if (t.kind != ast_type.TYPE_KIND_ARRAY) {
        sema_context.report(sc, diagnostic_kind.EMBED_TYPE, dec.name, "an `embed` declaration must be annotated `[_]u8` or `[N]u8`");
        ret false;
    }
    if (!is_u8_element(sc, t.data.array.element)) {
        sema_context.report(sc, diagnostic_kind.EMBED_TYPE, t.span, "an `embed` declaration's element type must be `u8`");
        ret false;
    }

    sema_context.set_embed_len(sc, tid, len::u64);
    ret true;
}

fun is_u8_element(sc: *sema_context.SemaContext, tid: ast_id.TypeId) bool {
    val opt_t: opt[*ast_type.Type] = ast.get_type(sc.a, tid);
    if (!sel opt_t.some) { ret false; }
    val t: *ast_type.Type = opt_t.some;
    if (t.kind != ast_type.TYPE_KIND_NAMED) { ret false; }
    ret str_region_equals(sc.source, t.data.named.name.offset, t.data.named.name.len, "u8");
}

# the path an artifact template resolved to names no artifact on its own, so the
# failure says whose output it is, and says when the invocation is one that never
# writes it
# ---
# arg: the decorator argument the path came from, a template or a literal path
fun report_path(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator,
    path_id: intern.StrId, arg: str, reason: str) {
    val opt_p: opt[str] = intern.lookup(?sc.s.interner, path_id);
    var p:     str      = "<unknown>";
    if (sel opt_p.some) { p = opt_p.some; }

    val opt_art: opt[str] = manifest.artifact_template_id(sc.s.alloc, arg);
    var owner:   str      = "";
    var hint:    str      = "";
    if (sel opt_art.some) {
        val o: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
            ", the output of required artifact `{}`", opt_art.some);
        if (sel o.ok) { owner = o.ok; }
        str_free(sc.s.alloc, opt_art.some);
        if (!sc.s.embeds.builds_artifacts) {
            hint = "; this command checks source without building, so it never writes that artifact: build the project first";
        }
    }
    fin {
        if (!str_empty(owner)) { str_free(sc.s.alloc, owner); }
    }

    val name: str                              = span_text(sc, d.data.bind.name, "<binding>");
    val r:    res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "`embed` on `{}` cannot read \"{}\"{}: {}{}", name, p, owner, reason, hint);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(r.err)));
        sema_context.report(sc, diagnostic_kind.EMBED_UNREADABLE, dec.name, "`embed` decorator cannot read the file it names");
        ret;
    }
    val msg: str = r.ok;
    sema_context.report(sc, diagnostic_kind.EMBED_UNREADABLE, dec.name, msg);
    std_allocator.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

fun span_text(sc: *sema_context.SemaContext, span: token.Span, fallback: str) str {
    val ir: res[intern.StrId, std_allocator.Error] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (sel ir.err) {
        fail.internal(?sc.status, lang_alloc.text(ir.err));
        ret fallback;
    }
    val found: opt[str] = intern.lookup(?sc.s.interner, ir.ok);
    if (!sel found.some) { ret fallback; }
    ret found.some;
}
