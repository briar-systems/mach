use std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use phase: mach.lang.fail;
use mach.lang.embed;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use atype: mach.lang.fe.ast.type;
use mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.source;

pub fun resolve_one(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl,
                    dec: *decl.Decorator) R.Result[R.Void, str] {
    if (!check_target(sc, d, dec)) { ret fail(sc, d); }

    val opt_arg: O.Option[str] = string_arg(sc, dec);
    if (O.is_none[str](opt_arg)) { ret fail(sc, d); }
    val arg: str = O.unwrap[str](opt_arg);

    val opt_file: O.Option[str] = module_file(sc);
    if (O.is_none[str](opt_file)) {
        context.report(sc, dec.name, "`embed` decorator cannot resolve a path: the declaring file has no on-disk location");
        ret fail(sc, d);
    }

    val pr: R.Result[str, manifest.TemplateError] = embed.resolve_arg(sc.s.alloc, ?sc.s.embeds, O.unwrap[str](opt_file), arg);
    if (R.is_err[str, manifest.TemplateError](pr)) {
        val e: manifest.TemplateError = R.unwrap_err[str, manifest.TemplateError](pr);
        fin { manifest.template_error_dnit(sc.s.alloc, e); }
        if (e.kind == phase.INTERNAL) { phase.internal(?sc.status, e.message); }
        or { context.report(sc, dec.name, e.message); }
        ret fail(sc, d);
    }
    val resolved: str = R.unwrap_ok[str, manifest.TemplateError](pr);
    val contained: R.Result[bool, str] = embed.escapes_root(sc.s.alloc, ?sc.s.embeds, resolved);
    if (R.is_err[bool, str](contained)) {
        val reason: str = R.unwrap_err[bool, str](contained);
        phase.internal(?sc.status, reason);
        str_free(sc.s.alloc, resolved);
        ret R.err[R.Void, str](reason);
    }
    if (R.unwrap_ok[bool, str](contained)) {
        context.report_warning(sc, dec.name, "`embed` path escapes the project root; 5.0.0 refuses it: keep embedded files inside the project");
    }

    val ir: R.Result[intern.StrId, str] = intern.intern(?sc.s.interner, resolved);
    str_free(sc.s.alloc, resolved);
    if (R.is_err[intern.StrId, str](ir)) { phase.internal(?sc.status, R.unwrap_err[intern.StrId, str](ir)); ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](ir)); }
    val path_id: intern.StrId = R.unwrap_ok[intern.StrId, str](ir);

    val rp: R.Result[R.Void, str] = context.record_embed_path(sc, path_id);
    if (R.is_err[R.Void, str](rp)) { ret rp; }

    val opt_entry: O.Option[*embed.EmbedFile] = embed.get(?sc.s.embeds, path_id);
    if (O.is_none[*embed.EmbedFile](opt_entry)) {
        report_path(sc, d, dec, path_id, "was not read for this build");
        ret fail(sc, d);
    }
    val e: *embed.EmbedFile = O.unwrap[*embed.EmbedFile](opt_entry);
    if (e.status != embed.EMBED_OK) {
        report_path(sc, d, dec, path_id, e.reason);
        ret fail(sc, d);
    }

    if (!size_annotation(sc, d, dec, e.len)) { ret fail(sc, d); }
    ret R.ok_void[str]();
}

fun fail(sc: *context.SemaContext, d: *decl.Decl) R.Result[R.Void, str] {
    if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
        mark_failed(sc, d.data.bind.ty);
    }
    ret R.ok_void[str]();
}

fun mark_failed(sc: *context.SemaContext, tid: id.TypeId) {
    val opt_t: O.Option[*atype.Type] = ast.get_type(sc.a, tid);
    if (O.is_none[*atype.Type](opt_t)) { ret; }
    val t: *atype.Type = O.unwrap[*atype.Type](opt_t);

    if (t.kind == atype.TYPE_KIND_ARRAY) {
        if (t.data.array.length == id.EXPR_NIL) {
            context.set_embed_len(sc, tid, context.EMBED_LEN_FAILED);
        }
        mark_failed(sc, t.data.array.element);
        ret;
    }
    if (t.kind == atype.TYPE_KIND_PTR)    { mark_failed(sc, t.data.ptr.pointee); ret; }
    if (t.kind == atype.TYPE_KIND_SECRET) { mark_failed(sc, t.data.secret.inner); ret; }
    if (t.kind == atype.TYPE_KIND_NAMED) {
        var i: u32 = 0;
        for (i < t.data.named.args_len) {
            mark_failed(sc, sc.a.type_ids[t.data.named.args_start + i]);
            i = i + 1;
        }
        ret;
    }
    if (t.kind == atype.TYPE_KIND_FUN) {
        var i: u32 = 0;
        for (i < t.data.fun_.params_len) {
            mark_failed(sc, sc.a.type_ids[t.data.fun_.params_start + i]);
            i = i + 1;
        }
        mark_failed(sc, t.data.fun_.ret_type);
        ret;
    }
    if (t.kind == atype.TYPE_KIND_REC) { mark_failed_fields(sc, t.data.rec_.fields_start, t.data.rec_.fields_len); ret; }
    if (t.kind == atype.TYPE_KIND_UNI) { mark_failed_fields(sc, t.data.uni_.fields_start, t.data.uni_.fields_len); }
}

fun mark_failed_fields(sc: *context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        mark_failed(sc, sc.a.typed_names[start + i].ty);
        i = i + 1;
    }
}

fun check_target(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) bool {
    if (d.kind != decl.DECL_KIND_VAL) {
        context.report(sc, dec.name, "`embed` decorator applies only to a `val`");
        ret false;
    }
    if ((d.flags & decl.DECL_FLAG_EXT) != 0) {
        context.report(sc, dec.name, "`embed` decorator cannot apply to an `ext` data import");
        ret false;
    }
    if (d.data.bind.init != id.EXPR_NIL) {
        context.report(sc, dec.name, "an `embed` declaration cannot also have an initializer; the file's content is the initializer");
        ret false;
    }
    ret true;
}

fun string_arg(sc: *context.SemaContext, dec: *decl.Decorator) O.Option[str] {
    if (dec.args_len != 1) {
        context.report(sc, dec.name, "`embed` decorator takes one string argument");
        ret O.none[str]();
    }
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start]);
    if (O.is_none[*expr.Expr](opt_e)) { ret O.none[str](); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](opt_e);
    if (e.kind != expr.EXPR_KIND_LIT_STR || e.span.len < 2::usize) {
        context.report(sc, e.span, "`embed` decorator argument must be a string literal");
        ret O.none[str]();
    }
    if (e.span.len == 2::usize) {
        context.report(sc, e.span, "`embed` decorator path must not be empty");
        ret O.none[str]();
    }

    var inner: token.Span = e.span;
    inner.offset = inner.offset + 1::usize;
    inner.len    = inner.len - 2::usize;

    val ir: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, inner);
    if (R.is_err[intern.StrId, str](ir)) { phase.internal(?sc.status, R.unwrap_err[intern.StrId, str](ir)); ret O.none[str](); }
    ret intern.lookup(?sc.s.interner, R.unwrap_ok[intern.StrId, str](ir));
}

fun module_file(sc: *context.SemaContext) O.Option[str] {
    val opt: O.Option[*source.SourceFile] = source.get(?sc.s.sources, sc.a.file_id);
    if (O.is_none[*source.SourceFile](opt)) { ret O.none[str](); }
    val f: *source.SourceFile = O.unwrap[*source.SourceFile](opt);
    if (f.path == nil) { ret O.none[str](); }
    ret O.some[str](f.path);
}

fun size_annotation(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator, len: u32) bool {
    val tid: id.TypeId = d.data.bind.ty;
    val opt_t: O.Option[*atype.Type] = ast.get_type(sc.a, tid);
    if (O.is_none[*atype.Type](opt_t)) { ret false; }
    val t: *atype.Type = O.unwrap[*atype.Type](opt_t);

    if (t.kind != atype.TYPE_KIND_ARRAY) {
        context.report(sc, dec.name, "an `embed` declaration must be annotated `[_]u8` or `[N]u8`");
        ret false;
    }
    if (!is_u8_element(sc, t.data.array.element)) {
        context.report(sc, t.span, "an `embed` declaration's element type must be `u8`");
        ret false;
    }

    context.set_embed_len(sc, tid, len::u64);
    ret true;
}

fun is_u8_element(sc: *context.SemaContext, tid: id.TypeId) bool {
    val opt_t: O.Option[*atype.Type] = ast.get_type(sc.a, tid);
    if (O.is_none[*atype.Type](opt_t)) { ret false; }
    val t: *atype.Type = O.unwrap[*atype.Type](opt_t);
    if (t.kind != atype.TYPE_KIND_NAMED) { ret false; }
    ret str_region_equals(sc.source, t.data.named.name.offset, t.data.named.name.len, "u8");
}

fun report_path(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator,
                path_id: intern.StrId, reason: str) {
    val opt_p: O.Option[str] = intern.lookup(?sc.s.interner, path_id);
    var p: str = "<unknown>";
    if (O.is_some[str](opt_p)) { p = O.unwrap[str](opt_p); }

    val name: str = span_text(sc, d.data.bind.name, "<binding>");
    val r: R.Result[str, str] = format.sprint(sc.s.alloc, "`embed` on `{}` cannot read \"{}\": {}", name, p, reason);
    if (R.is_err[str, str](r)) { phase.internal(?sc.status, R.unwrap_err[str, str](r));
        context.report(sc, dec.name, "`embed` decorator cannot read the file it names");
        ret;
    }
    val msg: str = R.unwrap_ok[str, str](r);
    context.report(sc, dec.name, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

fun span_text(sc: *context.SemaContext, span: token.Span, fallback: str) str {
    val ir: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (R.is_err[intern.StrId, str](ir)) { phase.internal(?sc.status, R.unwrap_err[intern.StrId, str](ir)); ret fallback; }
    val opt: O.Option[str] = intern.lookup(?sc.s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_none[str](opt)) { ret fallback; }
    ret O.unwrap[str](opt);
}
