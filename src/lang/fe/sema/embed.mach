use mach.lang.alloc;
use mach.lang.fail;
use std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.lang.embed;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use atype: mach.lang.fe.ast.type;
use mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.manifest;
use mach.lang.source;

# an embed outside the project root is refused, and its bytes are never read:
# the driver skips the path when it collects embed inputs, and this is the
# diagnostic that names why (the 4.30 warning was removed in 5.0.0)
pub val ESCAPED_EMBED_MSG: str = "`embed` path escapes the project root; an embedded file must live inside the project (4.30 read it with a warning, 5.0.0 refuses it and does not read the file)";

pub fun resolve_one(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl,
    dec: *decl.Decorator) err[fail.Fail] {
    if (!check_target(sc, d, dec)) { ret embed_failed(sc, d); }

    val opt_arg: opt[str] = string_arg(sc, dec);
    if (!sel opt_arg.some) { ret embed_failed(sc, d); }
    val arg: str = opt_arg.some;

    val opt_file: opt[str] = module_file(sc);
    if (!sel opt_file.some) {
        context.report(sc, dec.name, "`embed` decorator cannot resolve a path: the declaring file has no on-disk location");
        ret embed_failed(sc, d);
    }

    val pr: res[str, manifest.TemplateError] = embed.resolve_arg(sc.s.alloc, ?sc.s.embeds, opt_file.some, arg);
    if (sel pr.err) {
        val e: manifest.TemplateError = pr.err;
        fin { manifest.template_error_dnit(sc.s.alloc, e); }
        if (sel e.internal) { fail.internal(?sc.status, e.internal); }
        or                  { context.report(sc, dec.name, manifest.template_text(e)); }
        ret embed_failed(sc, d);
    }
    val resolved:  str                  = pr.ok;
    val contained: res[bool, fail.Fail] = embed.escapes_root(sc.s.alloc, ?sc.s.embeds, resolved);
    if (sel contained.err) {
        val reason: str = fail.describe(contained.err);
        fail.internal(?sc.status, reason);
        str_free(sc.s.alloc, resolved);
        ret err[fail.Fail].err{fail.message(reason)};
    }
    if (contained.ok) {
        context.report(sc, dec.name, ESCAPED_EMBED_MSG);
        str_free(sc.s.alloc, resolved);
        ret embed_failed(sc, d);
    }

    val ir: res[intern.StrId, A.Error] = intern.intern(?sc.s.interner, resolved);
    str_free(sc.s.alloc, resolved);
    if (sel ir.err) {
        fail.internal(?sc.status, alloc.text(ir.err));
        ret err[fail.Fail].err{fail.refused(ir.err)};
    }
    val path_id: intern.StrId = ir.ok;

    val rp: err[fail.Fail] = context.record_embed_path(sc, path_id);
    if (sel rp.err) { ret rp; }

    val opt_entry: opt[*embed.EmbedFile] = embed.get(?sc.s.embeds, path_id);
    if (sel opt_entry.none) {
        report_path(sc, d, dec, path_id, "was not read for this build");
        ret embed_failed(sc, d);
    }
    val e: *embed.EmbedFile = opt_entry.some;
    if (e.status != embed.EMBED_OK) {
        report_path(sc, d, dec, path_id, e.reason);
        ret embed_failed(sc, d);
    }

    if (!size_annotation(sc, d, dec, e.len)) { ret embed_failed(sc, d); }
    ret err[fail.Fail].ok{};
}

fun embed_failed(sc: *context.SemaContext, d: *decl.Decl) err[fail.Fail] {
    if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
        mark_failed(sc, d.data.bind.ty);
    }
    ret err[fail.Fail].ok{};
}

fun mark_failed(sc: *context.SemaContext, tid: id.TypeId) {
    val opt_t: opt[*atype.Type] = ast.get_type(sc.a, tid);
    if (!sel opt_t.some) { ret; }
    val t: *atype.Type = opt_t.some;

    if (t.kind == atype.TYPE_KIND_ARRAY) {
        if (t.data.array.length == id.EXPR_NIL) {
            context.set_embed_len(sc, tid, context.EMBED_LEN_FAILED);
        }
        mark_failed(sc, t.data.array.element);
        ret;
    }
    if (t.kind == atype.TYPE_KIND_PTR) {
        mark_failed(sc, t.data.ptr.pointee);
        ret;
    }
    if (t.kind == atype.TYPE_KIND_SECRET) {
        mark_failed(sc, t.data.secret.inner);
        ret;
    }
    if (t.kind == atype.TYPE_KIND_NAMED) {
        var i: u32 = 0;
        for (i < t.data.named.args_len) {
            mark_failed(sc, sc.a.type_ids[t.data.named.args_start + i]);
            i = i + 1;
        }
        ret;
    }
    if (t.kind == atype.TYPE_KIND_FUN) {
        var i: u32 = 0;
        for (i < t.data.fun_.params_len) {
            mark_failed(sc, sc.a.type_ids[t.data.fun_.params_start + i]);
            i = i + 1;
        }
        mark_failed(sc, t.data.fun_.ret_type);
        ret;
    }
    if (t.kind == atype.TYPE_KIND_REC) {
        mark_failed_fields(sc, t.data.rec_.fields_start, t.data.rec_.fields_len);
        ret;
    }
    if (t.kind == atype.TYPE_KIND_UNI) { mark_failed_fields(sc, t.data.uni_.fields_start, t.data.uni_.fields_len); }
}

fun mark_failed_fields(sc: *context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        mark_failed(sc, sc.a.typed_names[start + i].ty);
        i = i + 1;
    }
}

fun check_target(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) bool {
    if (d.kind != decl.DECL_KIND_VAL) {
        context.report(sc, dec.name, "`embed` decorator applies only to a `val`");
        ret false;
    }
    if ((d.flags & decl.DECL_FLAG_EXT) != 0) {
        context.report(sc, dec.name, "`embed` decorator cannot apply to an `ext` data import");
        ret false;
    }
    if (d.data.bind.init != id.EXPR_NIL) {
        context.report(sc, dec.name, "an `embed` declaration cannot also have an initializer; the file's content is the initializer");
        ret false;
    }
    ret true;
}

fun string_arg(sc: *context.SemaContext, dec: *decl.Decorator) opt[str] {
    if (dec.args_len != 1) {
        context.report(sc, dec.name, "`embed` decorator takes one string argument");
        ret opt[str].none{};
    }
    val opt_e: opt[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start]);
    if (!sel opt_e.some) { ret opt[str].none{}; }
    val e: *expr.Expr = opt_e.some;
    if (e.kind != expr.EXPR_KIND_LIT_STR || e.span.len < 2::usize) {
        context.report(sc, e.span, "`embed` decorator argument must be a string literal");
        ret opt[str].none{};
    }
    if (e.span.len == 2::usize) {
        context.report(sc, e.span, "`embed` decorator path must not be empty");
        ret opt[str].none{};
    }

    var inner: token.Span = e.span;
    inner.offset = inner.offset + 1::usize;
    inner.len    = inner.len - 2::usize;

    val ir: res[intern.StrId, A.Error] = intern.intern_span(?sc.s.interner, sc.source, inner);
    if (sel ir.err) {
        fail.internal(?sc.status, alloc.text(ir.err));
        ret opt[str].none{};
    }
    ret intern.lookup(?sc.s.interner, ir.ok);
}

fun module_file(sc: *context.SemaContext) opt[str] {
    val found: opt[*source.SourceFile] = source.get(?sc.s.sources, sc.a.file_id);
    if (sel found.none) { ret opt[str].none{}; }
    val f: *source.SourceFile = found.some;
    if (f.path == nil) { ret opt[str].none{}; }
    ret opt[str].some{f.path};
}

fun size_annotation(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator, len: u32) bool {
    val tid:   id.TypeId        = d.data.bind.ty;
    val opt_t: opt[*atype.Type] = ast.get_type(sc.a, tid);
    if (!sel opt_t.some) { ret false; }
    val t: *atype.Type = opt_t.some;

    if (t.kind != atype.TYPE_KIND_ARRAY) {
        context.report(sc, dec.name, "an `embed` declaration must be annotated `[_]u8` or `[N]u8`");
        ret false;
    }
    if (!is_u8_element(sc, t.data.array.element)) {
        context.report(sc, t.span, "an `embed` declaration's element type must be `u8`");
        ret false;
    }

    context.set_embed_len(sc, tid, len::u64);
    ret true;
}

fun is_u8_element(sc: *context.SemaContext, tid: id.TypeId) bool {
    val opt_t: opt[*atype.Type] = ast.get_type(sc.a, tid);
    if (!sel opt_t.some) { ret false; }
    val t: *atype.Type = opt_t.some;
    if (t.kind != atype.TYPE_KIND_NAMED) { ret false; }
    ret str_region_equals(sc.source, t.data.named.name.offset, t.data.named.name.len, "u8");
}

fun report_path(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator,
    path_id: intern.StrId, reason: str) {
    val opt_p: opt[str] = intern.lookup(?sc.s.interner, path_id);
    var p:     str      = "<unknown>";
    if (sel opt_p.some) { p = opt_p.some; }

    val name: str                          = span_text(sc, d.data.bind.name, "<binding>");
    val r:    res[str, format.FormatError] = format.sprint(sc.s.alloc, "`embed` on `{}` cannot read \"{}\": {}", name, p, reason);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(r.err)));
        context.report(sc, dec.name, "`embed` decorator cannot read the file it names");
        ret;
    }
    val msg: str = r.ok;
    context.report(sc, dec.name, msg);
    A.deallocate[char](sc.s.alloc, msg, str_len(msg) + 1);
}

fun span_text(sc: *context.SemaContext, span: token.Span, fallback: str) str {
    val ir: res[intern.StrId, A.Error] = intern.intern_span(?sc.s.interner, sc.source, span);
    if (sel ir.err) {
        fail.internal(?sc.status, alloc.text(ir.err));
        ret fallback;
    }
    val found: opt[str] = intern.lookup(?sc.s.interner, ir.ok);
    if (!sel found.some) { ret fallback; }
    ret found.some;
}
