use mach.lang.diagnostic;
use dkind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use std.format;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mach.lang.fe.ast;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.fe.sema.context;
use mach.lang.fe.sema.generics;
use mach.lang.fe.token;
use mach.lang.float;
use mach.lang.type;
use mach.lang.wide;

pub def CoerceKind: u8;

pub val COERCE_NOT_APPLICABLE: CoerceKind = 0;
pub val COERCE_COERCED:        CoerceKind = 1;
pub val COERCE_OUT_OF_RANGE:   CoerceKind = 2;

pub rec CoerceResult {
    kind:    CoerceKind;
    ty:      type.TypeId;
    value:   wide.Wide;
    negated: bool;
    bounds:  type.IntRange;

    literal: bool;
}

fun zero_bounds() type.IntRange {
    var b: type.IntRange;
    b.min_negated = false;
    b.min_mag     = wide.zero();
    b.max_mag     = wide.zero();
    ret b;
}

fun not_applicable() CoerceResult {
    var r: CoerceResult;
    r.kind    = COERCE_NOT_APPLICABLE;
    r.ty      = type.TYPE_ERROR;
    r.value   = wide.zero();
    r.negated = false;
    r.bounds  = zero_bounds();
    ret r;
}

fun applicable(to: type.TypeId) CoerceResult {
    var r: CoerceResult;
    r.kind    = COERCE_COERCED;
    r.ty      = to;
    r.value   = wide.zero();
    r.negated = false;
    r.bounds  = zero_bounds();
    ret r;
}

pub fun out_of_range(to: type.TypeId, value: wide.Wide, negated: bool, bounds: type.IntRange, literal: bool) CoerceResult {
    var r: CoerceResult;
    r.kind    = COERCE_OUT_OF_RANGE;
    r.ty      = to;
    r.value   = value;
    r.negated = negated;
    r.bounds  = bounds;
    r.literal = literal;
    ret r;
}

pub fun try_coerce_literal(sc: *context.SemaContext, eid: id.ExprId, to: type.TypeId) CoerceResult {
    if (to == type.TYPE_NIL || to == type.TYPE_ERROR) { ret not_applicable(); }

    val pub_to: type.TypeId  = type.strip_secret(?sc.s.types, to);
    var r:      CoerceResult = coerce_to(sc, eid, pub_to, false, true);
    if (r.kind == COERCE_COERCED) {
        r = coerce_to(sc, eid, pub_to, false, false);
    }
    if (pub_to != to && r.kind == COERCE_OUT_OF_RANGE) {
        var rr: CoerceResult = r;
        rr.ty = to;
        ret rr;
    }
    ret r;
}

# ask whether a literal-shaped expression fits the integer range of `to` without
# retyping anything: `COERCE_OUT_OF_RANGE` carries the offending leaf's value and
# sign, and any other kind means the shape is not a literal or it fits
# ---
# sc:  the semantic context
# eid: the expression to probe
# to:  the integer type whose range is asked about
# ret: the probe result; never commits an expression type
pub fun probe_literal_range(sc: *context.SemaContext, eid: id.ExprId, to: type.TypeId) CoerceResult {
    if (to == type.TYPE_NIL || to == type.TYPE_ERROR) { ret not_applicable(); }
    ret coerce_to(sc, eid, type.strip_secret(?sc.s.types, to), false, true);
}

fun coerce_to(sc: *context.SemaContext, eid: id.ExprId, to: type.TypeId, negated: bool, probe: bool) CoerceResult {
    if (eid == id.EXPR_NIL) { ret not_applicable(); }

    val opt_e: res[expr.Expr, fail.Fail] = context.expression(sc, eid);
    if (sel opt_e.err) { ret not_applicable(); }
    var e_value: expr.Expr  = opt_e.ok;
    val e:       *expr.Expr = ?e_value;

    if (context.awaits_instance(sc, to)) { ret coerce_to_parameter(sc, eid, e, to, negated, probe); }

    if (e.kind == expr.EXPR_KIND_LIT_INT) {
        if (e.data.lit_int.suffix != expr.LIT_SUFFIX_NONE) {
            ret coerce_suffixed_literal(sc, eid, e.data.lit_int.suffix, to, probe);
        }
        ret coerce_int_literal(sc, eid, e.data.lit_int.value, to, negated, true, probe);
    }
    if (e.kind == expr.EXPR_KIND_LIT_CHAR) {
        ret coerce_int_literal(sc, eid, wide.from_u64(e.data.lit_char.value::u64), to, negated, true, probe);
    }
    if (e.kind == expr.EXPR_KIND_LIT_FLOAT) {
        if (e.data.lit_float.suffix != expr.LIT_SUFFIX_NONE) {
            ret coerce_suffixed_literal(sc, eid, e.data.lit_float.suffix, to, probe);
        }
        if (to != type.TYPE_F32 && to != type.TYPE_F64) { ret not_applicable(); }
        ret commit(sc, eid, to, probe);
    }
    if (e.kind == expr.EXPR_KIND_LIT_NIL) {
        if (!type.is_pointer_like(?sc.s.types, to)) { ret not_applicable(); }
        ret commit(sc, eid, to, probe);
    }
    if (e.kind == expr.EXPR_KIND_COMPTIME_IDENT || e.kind == expr.EXPR_KIND_MEMBER) {
        ret coerce_comptime_int_path(sc, eid, to, negated, probe);
    }
    if (e.kind == expr.EXPR_KIND_CALL && comptime.is_path_call(sc.a, eid)) {
        ret coerce_comptime_int_path(sc, eid, to, negated, probe);
    }
    if (e.kind == expr.EXPR_KIND_CALL) {
        ret coerce_layout_intrinsic(sc, eid, to, negated, probe);
    }
    if (e.kind == expr.EXPR_KIND_UNARY) {
        ret coerce_unary(sc, eid, ?e.data.unary, to, negated, probe);
    }
    if (e.kind == expr.EXPR_KIND_BINARY) {
        ret coerce_binary(sc, eid, ?e.data.binary, to, probe);
    }

    ret not_applicable();
}

# an unsuffixed literal carries no type of its own, so against a type parameter it takes
# that parameter and its range is checked where there is a range: the instance. a
# suffixed literal already has a type and is left for the instance to agree or refuse
fun coerce_to_parameter(sc: *context.SemaContext, eid: id.ExprId, e: *expr.Expr, to: type.TypeId, negated: bool, probe: bool) CoerceResult {
    if (e.kind == expr.EXPR_KIND_LIT_INT && e.data.lit_int.suffix == expr.LIT_SUFFIX_NONE)     { ret commit(sc, eid, to, probe); }
    if (e.kind == expr.EXPR_KIND_LIT_FLOAT && e.data.lit_float.suffix == expr.LIT_SUFFIX_NONE) { ret commit(sc, eid, to, probe); }
    if (e.kind == expr.EXPR_KIND_LIT_CHAR)                                                     { ret commit(sc, eid, to, probe); }
    if (e.kind == expr.EXPR_KIND_LIT_NIL)                                                      { ret commit(sc, eid, to, probe); }
    if (e.kind == expr.EXPR_KIND_UNARY)                                                        { ret coerce_unary(sc, eid, ?e.data.unary, to, negated, probe); }
    if (e.kind == expr.EXPR_KIND_BINARY)                                                       { ret coerce_binary(sc, eid, ?e.data.binary, to, probe); }
    ret not_applicable();
}

fun coerce_suffixed_literal(sc: *context.SemaContext, eid: id.ExprId, suffix: type.TypeKind, to: type.TypeId, probe: bool) CoerceResult {
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, to);
    if (!sel opt_type.some)           { ret not_applicable(); }
    if (opt_type.some.kind != suffix) { ret not_applicable(); }
    ret commit(sc, eid, to, probe);
}

fun coerce_int_literal(sc: *context.SemaContext, eid: id.ExprId, v: wide.Wide, to: type.TypeId, negated: bool, literal: bool, probe: bool) CoerceResult {
    val opt_bounds: opt[type.IntRange] = int_bounds_of(sc, to);
    if (!sel opt_bounds.some) { ret not_applicable(); }
    val bounds: type.IntRange = opt_bounds.some;
    if (!type.int_fits(v, negated, bounds)) { ret out_of_range(to, v, negated, bounds, literal); }
    ret commit(sc, eid, to, probe);
}

fun coerce_comptime_int_path(sc: *context.SemaContext, eid: id.ExprId, to: type.TypeId, negated: bool, probe: bool) CoerceResult {
    if (!comptime.is_comptime_value(sc.a, eid)) { ret not_applicable(); }

    val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);

    context.record_eval_result(sc, res_eval);
    if (sel res_eval.err) { ret not_applicable(); }
    val ctval: comptime.CTValue = res_eval.ok;

    ret coerce_ct_int(sc, eid, ctval, to, negated, probe);
}

fun coerce_ct_int(sc: *context.SemaContext, eid: id.ExprId, ctval: comptime.CTValue, to: type.TypeId, negated: bool, probe: bool) CoerceResult {
    if (ctval.kind != comptime.CT_KIND_INT) { ret not_applicable(); }

    var mag:           wide.Wide = ctval.data.w;
    var value_negated: bool      = false;
    if (comptime.ct_is_negative(ctval)) {
        mag           = wide.neg(mag);
        value_negated = true;
    }

    var negated_total: bool = negated;
    if (value_negated) { negated_total = !negated; }

    ret coerce_int_literal(sc, eid, mag, to, negated_total, false, probe);
}

fun coerce_layout_intrinsic(sc: *context.SemaContext, eid: id.ExprId, to: type.TypeId, negated: bool, probe: bool) CoerceResult {
    if (!comptime.is_layout_intrinsic_call(sc.a, sc.source, eid)) { ret not_applicable(); }
    # an identity keeps all 64 bits, so it never adopts a narrower binding by value
    if (comptime.is_type_id_call(sc.a, sc.source, eid)) { ret not_applicable(); }

    val bounds: opt[type.IntRange] = int_bounds_of(sc, to);
    if (!sel bounds.some) { ret not_applicable(); }

    val saved_silent: bool = sc.silent;
    sc.silent = true;
    val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
    context.record_eval_result(sc, res_eval);
    sc.silent = saved_silent;

    if (sel res_eval.ok) {
        val ctval: comptime.CTValue = res_eval.ok;
        if (ctval.kind == comptime.CT_KIND_INT) {
            ret coerce_ct_int(sc, eid, ctval, to, negated, probe);
        }
    }

    ret commit(sc, eid, to, probe);
}

fun coerce_unary(sc: *context.SemaContext, eid: id.ExprId, u: *expr.ExprUnary, to: type.TypeId, negated: bool, probe: bool) CoerceResult {
    if (u.op != expr.UN_NEG && u.op != expr.UN_BIT_NOT) { ret not_applicable(); }

    var operand_negated: bool = negated;
    if (u.op == expr.UN_NEG) { operand_negated = !negated; }

    val r: CoerceResult = coerce_to(sc, u.operand, to, operand_negated, probe);
    if (r.kind != COERCE_COERCED) { ret r; }
    ret commit(sc, eid, to, probe);
}

fun coerce_binary(sc: *context.SemaContext, eid: id.ExprId, b: *expr.ExprBinary, to: type.TypeId, probe: bool) CoerceResult {
    if (!is_value_preserving_binop(b.op)) { ret not_applicable(); }

    val lhs: CoerceResult = coerce_to(sc, b.lhs, to, false, probe);
    if (lhs.kind != COERCE_COERCED) { ret lhs; }
    val rhs: CoerceResult = coerce_to(sc, b.rhs, to, false, probe);
    if (rhs.kind != COERCE_COERCED) { ret rhs; }
    ret commit(sc, eid, to, probe);
}

# the operators whose result coerces with their operands; false for every
# other operator (a partition, enumerated by its test)
fun is_value_preserving_binop(op: expr.BinOp) bool {
    if (op == expr.BIN_ADD || op == expr.BIN_SUB || op == expr.BIN_MUL
        || op == expr.BIN_DIV || op == expr.BIN_MOD) { ret true; }
    if (op == expr.BIN_BIT_AND || op == expr.BIN_BIT_OR || op == expr.BIN_BIT_XOR
        || op == expr.BIN_SHL || op == expr.BIN_SHR) { ret true; }
    ret false;
}

pub fun int_bounds_of(sc: *context.SemaContext, to: type.TypeId) opt[type.IntRange] {
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, to));
    if (!sel opt_type.some) { ret opt[type.IntRange].none{}; }
    ret type.int_range(opt_type.some.kind);
}

fun commit(sc: *context.SemaContext, eid: id.ExprId, to: type.TypeId, probe: bool) CoerceResult {
    if (!probe && sc.expr_type != nil && eid::usize < sc.a.expr_len) {
        sc.expr_type[eid] = to;
    }
    ret applicable(to);
}

# the float literal rule, applied once the literal's type is final. the literal rounds to
# nearest; one that rounds to infinity, or whose nonzero value rounds to zero, is refused,
# and an inexact one whose written digits are not the shortest spelling of the value stored
# warns with that value. an exact literal never warns
# ---
# sc:  the semantic context the literal was typed in
# eid: a float literal
# ty:  its final type; anything but a float type is left alone
pub fun check_float_literal(sc: *context.SemaContext, eid: id.ExprId, ty: type.TypeId) {
    if (sc.silent || ty == type.TYPE_NIL || ty == type.TYPE_ERROR) { ret; }
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, type.strip_secret(?sc.s.types, ty));
    if (!sel opt_type.some) { ret; }
    val w: float.FloatWidth = type.float_width_of(opt_type.some.kind);
    if (w == float.FLOAT_W_NONE) { ret; }

    val opt_e: res[expr.Expr, fail.Fail] = context.expression(sc, eid);
    if (sel opt_e.err) { ret; }
    val span: token.Span                    = opt_e.ok.data.lit_float.tok;
    val lit:  res[float.Rounded, fail.Fail] = comptime.lit_float_at(sc.source, span, w);
    if (sel lit.err) { ret; }
    val fit: float.Fit = lit.ok.fit;
    if (fit == float.FIT_EXACT) { ret; }

    if (fit == float.FIT_OVERFLOW || fit == float.FIT_UNDERFLOW) {
        var msg_r: res[str, format.FormatError];
        if (fit == float.FIT_OVERFLOW) { msg_r = format.sprint(sc.s.alloc, "float literal overflows `{}`: it rounds to infinity", float.width_name(w)); }
        or                             { msg_r = format.sprint(sc.s.alloc, "float literal underflows `{}`: its nonzero value rounds to zero", float.width_name(w)); }
        if (sel msg_r.err) {
            context.report(sc, span, "float literal is out of range for its type");
            ret;
        }
        context.report(sc, span, msg_r.ok);
        str_free(sc.s.alloc, msg_r.ok);
        ret;
    }

    var s: float.Shortest = float.shortest(lit.ok.value, w);
    if (comptime.lit_float_spells(sc.source, span, ?s)) { ret; }
    var text:  [float.SHORTEST_TEXT_CAP]u8;
    val msg_r: res[str, format.FormatError] = format.sprint(sc.s.alloc, "float literal is not exact in `{}`: the value stored is `{}`",
        float.width_name(w), float.shortest_text(?s, ?text[0]));
    if (sel msg_r.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(msg_r.err)));
        ret;
    }
    val msg: str                                          = msg_r.ok;
    val b_r: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init_kind(sc.diags.a, dkind.INEXACT_FLOAT_LITERAL, sc.a.file_id, span, msg);
    str_free(sc.s.alloc, msg);
    if (sel b_r.err) {
        fail.internal(?sc.status, fail.describe(b_r.err));
        ret;
    }
    var b: diagnostic.DiagnosticBuilder = b_r.ok;
    # a generic body warns once per site, however many instances or modules type it
    val committed: res[bool, fail.Fail] = diagnostic.gate_commit(sc.diags, ?sc.s.interner, ?b);
    if (sel committed.err) { fail.internal(?sc.status, fail.describe(committed.err)); }
}

pub fun is_assignable(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId) bool {
    if (from == to)                                       { ret true; }
    if (from == type.TYPE_ERROR || to == type.TYPE_ERROR) { ret true; }

    val to_secret:   bool = type.is_secret(?sc.s.types, to);
    val from_secret: bool = type.is_secret(?sc.s.types, from);
    if (to_secret) {
        ret is_assignable(sc, type.strip_secret(?sc.s.types, from), type.strip_secret(?sc.s.types, to));
    }
    if (from_secret) { ret false; }

    if (ptr_compatible(sc, from, to)) { ret true; }
    ret type.type_equals_signatures(?sc.s.types, from, to);
}

fun ptr_compatible(sc: *context.SemaContext, from: type.TypeId, to: type.TypeId) bool {
    if (from == type.TYPE_PTR && is_typed_pointer(sc, to)) {
        ret !context.recover[bool](sc, generics.contains_secret_deep(sc.s, to), false);
    }
    if (to == type.TYPE_PTR && is_typed_pointer(sc, from)) {
        ret !context.recover[bool](sc, generics.contains_secret_deep(sc.s, from), false);
    }
    ret false;
}

fun is_typed_pointer(sc: *context.SemaContext, t: type.TypeId) bool {
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, t);
    if (!sel opt_type.some) { ret false; }
    ret opt_type.some.kind == type.TYPE_POINTER;
}

test is_value_preserving_binop__partition_binop {
    val preserving: [10]expr.BinOp = [10]expr.BinOp{expr.BIN_ADD, expr.BIN_SUB, expr.BIN_MUL, expr.BIN_DIV,
        expr.BIN_MOD, expr.BIN_BIT_AND, expr.BIN_BIT_OR, expr.BIN_BIT_XOR, expr.BIN_SHL, expr.BIN_SHR};
    val others: [9]expr.BinOp = [9]expr.BinOp{expr.BIN_EQ, expr.BIN_NEQ, expr.BIN_LT, expr.BIN_LEQ,
        expr.BIN_GT, expr.BIN_GEQ, expr.BIN_AND, expr.BIN_OR, expr.BIN_ASSIGN};
    var i: usize = 0;
    for (i < 10) {
        if (!is_value_preserving_binop(preserving[i])) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 9) {
        if (is_value_preserving_binop(others[i])) { ret 2; }
        i = i + 1;
    }
    ret 0;
}
