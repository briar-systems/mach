# whether a function body reaches a C variadic call, directly or through what it calls,
# which decides how a pack spreads into one
use std.types.bool.bool;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use ast_stmt: mach.lang.fe.ast.stmt;
use mach.lang.fe.resolve;
use sema_context: mach.lang.fe.sema.context;
use sema_product: mach.lang.fe.sema.product;
use mach.lang.module;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.stack;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

fun module_rr_for(sc: *sema_context.SemaContext, origin: session.ModuleId) *resolve.ResolveResult {
    if (module.same(origin, sc.view.own_module)) { ret sc.view.rr; }
    if (sc.typing.deps == nil) {
        fail.internal(?sc.status, "semantic definition has no dependency reader");
        ret nil;
    }
    val acquired: res[sema_product.Definition, fail.Fail] = sema_product.acquire_definition(?sc.typing.deps.definitions, origin, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?sc.status); }
        or                       { fail.internal(?sc.status, fail.describe(reason)); }
        ret nil;
    }
    ret acquired.ok.rr;
}

fun callee_is_c_variadic(sc: *sema_context.SemaContext, rr: *resolve.ResolveResult, callee_eid: ast_id.ExprId) bool {
    if (rr == nil || rr.expr_resolved == nil || rr.symbols == nil)                        { ret false; }
    if (ast_id.expr_is_nil(callee_eid) || ast_id.expr_index(callee_eid) >= rr.expr_count) { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[ast_id.expr_index(callee_eid)];
    if (resolve.symbol_is_nil(sid) || resolve.symbol_index(sid) >= rr.symbol_count) { ret false; }
    val sym: *resolve.Symbol = ?rr.symbols[resolve.symbol_index(sid)];
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)            { ret false; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret false; }
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    val d_opt:   opt[*ast_decl.Decl]        = ast.get_decl(current.definition.parsed.a, current.symbol.decl);
    if (!sel d_opt.some) { ret false; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret false; }
    ret d.data.fun_.c_variadic;
}

# whether the stack has no room left to walk the node at `span` of `a`, which is refused, and
# the walk answers no for the part it could not reach
fun exhausted(sc: *sema_context.SemaContext, a: *ast.Ast, span: lang_source.Span) bool {
    if (!stack.exhausted()) { ret false; }
    sema_context.refuse_nesting_in(sc, lang_source.location(a.file_id, span));
    ret true;
}

fun call_has_spread_arg(a: *ast.Ast, e: *ast_expr.Expr) bool {
    var i: u32 = 0;
    for (i < e.data.call.args_len) {
        val ix: u32 = e.data.call.args_start + i;
        if (ix::usize < a.expr_ids.len) {
            val ao: opt[*ast_expr.Expr] = ast.get_expr(a, a.expr_ids.data[ix]);
            if (sel ao.some
                && ao.some.kind == ast_expr.EXPR_KIND_SPREAD) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun callee_body_reaches(sc: *sema_context.SemaContext, rr: *resolve.ResolveResult, callee_eid: ast_id.ExprId,
    want_spread: bool, seen: *ReachSeen) bool {
    if (rr == nil || rr.expr_resolved == nil || rr.symbols == nil)                        { ret false; }
    if (ast_id.expr_is_nil(callee_eid) || ast_id.expr_index(callee_eid) >= rr.expr_count) { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[ast_id.expr_index(callee_eid)];
    if (resolve.symbol_is_nil(sid) || resolve.symbol_index(sid) >= rr.symbol_count) { ret false; }
    val sym: *resolve.Symbol = ?rr.symbols[resolve.symbol_index(sid)];
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)            { ret false; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret false; }
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.symbol_definition(sc, sym, sema_product.DEFINITION_RESOLVED);
    if (sel acquired.err) { ret false; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    ret decl_reaches_c_variadic(sc, current.symbol.origin, current.symbol.decl, want_spread, seen);
}

fun expr_has_c_variadic_call(sc: *sema_context.SemaContext, a: *ast.Ast, rr: *resolve.ResolveResult, eid: ast_id.ExprId, want_spread: bool, seen: *ReachSeen) bool {
    if (ast_id.expr_is_nil(eid)) { ret false; }
    val e_opt: res[ast_expr.Expr, fail.Fail] = resolve.expression(rr, a, eid);
    if (sel e_opt.err) {
        fail.internal(?sc.status, fail.describe(e_opt.err));
        ret false;
    }
    var e_value: ast_expr.Expr     = e_opt.ok;
    val e:       *ast_expr.Expr    = ?e_value;
    val k:       ast_expr.ExprKind = e.kind;
    if (exhausted(sc, a, e.span)) { ret false; }

    if (k == ast_expr.EXPR_KIND_CALL) {
        val spread_here: bool = call_has_spread_arg(a, e);
        if (callee_is_c_variadic(sc, rr, e.data.call.callee)
            && (!want_spread || spread_here)) { ret true; }
        if (!want_spread || spread_here) {
            if (callee_body_reaches(sc, rr, e.data.call.callee, want_spread, seen)) { ret true; }
        }
        if (expr_has_c_variadic_call(sc, a, rr, e.data.call.callee, want_spread, seen)) { ret true; }
        var i: u32 = 0;
        for (i < e.data.call.args_len) {
            val ix: u32 = e.data.call.args_start + i;
            if (ix::usize < a.expr_ids.len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids.data[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == ast_expr.EXPR_KIND_BINARY) {
        if (expr_has_c_variadic_call(sc, a, rr, e.data.binary.lhs, want_spread, seen)) { ret true; }
        ret expr_has_c_variadic_call(sc, a, rr, e.data.binary.rhs, want_spread, seen);
    }
    if (k == ast_expr.EXPR_KIND_UNARY)   { ret expr_has_c_variadic_call(sc, a, rr, e.data.unary.operand, want_spread, seen); }
    if (k == ast_expr.EXPR_KIND_INDEX)   { ret expr_has_c_variadic_call(sc, a, rr, e.data.index.object, want_spread, seen); }
    if (k == ast_expr.EXPR_KIND_MEMBER)  { ret expr_has_c_variadic_call(sc, a, rr, e.data.member.object, want_spread, seen); }
    if (k == ast_expr.EXPR_KIND_PROJECT) { ret expr_has_c_variadic_call(sc, a, rr, e.data.project.object, want_spread, seen); }
    if (k == ast_expr.EXPR_KIND_SPREAD)  { ret expr_has_c_variadic_call(sc, a, rr, e.data.spread.inner, want_spread, seen); }
    if (k == ast_expr.EXPR_KIND_CAST)    { ret expr_has_c_variadic_call(sc, a, rr, e.data.cast.value, want_spread, seen); }
    if (k == ast_expr.EXPR_KIND_STRIP)   { ret expr_has_c_variadic_call(sc, a, rr, e.data.strip.value, want_spread, seen); }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT) {
        var i: u32 = 0;
        for (i < e.data.array_lit.elems_len) {
            val ix: u32 = e.data.array_lit.elems_start + i;
            if (ix::usize < a.expr_ids.len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids.data[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT) {
        var i: u32 = 0;
        for (i < e.data.vector_lit.elems_len) {
            val ix: u32 = e.data.vector_lit.elems_start + i;
            if (ix::usize < a.expr_ids.len
                && expr_has_c_variadic_call(sc, a, rr, a.expr_ids.data[ix], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT) {
        var i: u32 = 0;
        for (i < e.data.struct_lit.fields_len) {
            val ix: u32 = e.data.struct_lit.fields_start + i;
            if (ix::usize < a.field_inits.len
                && expr_has_c_variadic_call(sc, a, rr, a.field_inits.data[ix].value, want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }

    ret false;
}

pub fun decl_body_spreads_pack_to_c_variadic(sc: *sema_context.SemaContext, origin: session.ModuleId, did: ast_id.DeclId) bool {
    ret decl_body_reaches_c_variadic(sc, origin, did, true);
}

val REACH_MAX_VISITED: u32 = 64;

rec ReachSeen {
    origins: *u32;
    decls:   *u32;
    len:     u32;
}

fun reach_visit(seen: *ReachSeen, origin: session.ModuleId, did: ast_id.DeclId) bool {
    var i: u32 = 0;
    for (i < seen.len) {
        if (seen.origins[i] == origin::u32 && seen.decls[i] == did::u32) { ret false; }
        i = i + 1;
    }
    if (seen.len >= REACH_MAX_VISITED) { ret false; }
    seen.origins[seen.len] = origin::u32;
    seen.decls[seen.len]   = did::u32;
    seen.len               = seen.len + 1;
    ret true;
}

fun decl_body_reaches_c_variadic(sc: *sema_context.SemaContext, origin: session.ModuleId, did: ast_id.DeclId, want_spread: bool) bool {
    var so:   [REACH_MAX_VISITED]u32;
    var sd:   [REACH_MAX_VISITED]u32;
    var seen: ReachSeen;
    seen.origins = ?so[0];
    seen.decls   = ?sd[0];
    seen.len     = 0;
    ret decl_reaches_c_variadic(sc, origin, did, want_spread, ?seen);
}

fun decl_reaches_c_variadic(sc: *sema_context.SemaContext, origin: session.ModuleId, did: ast_id.DeclId,
    want_spread: bool, seen: *ReachSeen) bool {
    if (!reach_visit(seen, origin, did)) { ret false; }
    val a: *ast.Ast = sema_context.definition_ast(sc, origin);
    if (a == nil) { ret false; }
    val rr: *resolve.ResolveResult = module_rr_for(sc, origin);
    if (rr == nil) { ret false; }

    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (!sel d_opt.some) { ret false; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_FUN)     { ret false; }
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret false; }
    ret stmt_calls_c_variadic(sc, a, rr, d.data.fun_.body, want_spread, seen);
}

fun stmt_calls_c_variadic(sc: *sema_context.SemaContext, a: *ast.Ast, rr: *resolve.ResolveResult, sid: ast_id.StmtId, want_spread: bool, seen: *ReachSeen) bool {
    if (ast_id.stmt_is_nil(sid)) { ret false; }
    val s_opt: opt[*ast_stmt.Stmt] = ast.get_stmt(a, sid);
    if (!sel s_opt.some) { ret false; }
    val s: *ast_stmt.Stmt    = s_opt.some;
    val k: ast_stmt.StmtKind = s.kind;
    if (exhausted(sc, a, s.span)) { ret false; }

    if (k == ast_stmt.STMT_KIND_EXPR) { ret expr_has_c_variadic_call(sc, a, rr, s.data.expr.expr, want_spread, seen); }
    if (k == ast_stmt.STMT_KIND_RET)  { ret expr_has_c_variadic_call(sc, a, rr, s.data.ret_.value, want_spread, seen); }
    if (k == ast_stmt.STMT_KIND_DECL) {
        val dd_opt: opt[*ast_decl.Decl] = ast.get_decl(a, s.data.decl.decl);
        if (!sel dd_opt.some) { ret false; }
        val dd: *ast_decl.Decl = dd_opt.some;
        if (dd.kind != ast_decl.DECL_KIND_VAL && dd.kind != ast_decl.DECL_KIND_VAR) { ret false; }
        ret expr_has_c_variadic_call(sc, a, rr, dd.data.bind.init, want_spread, seen);
    }
    if (k == ast_stmt.STMT_KIND_IF) {
        if (expr_has_c_variadic_call(sc, a, rr, s.data.if_.cond, want_spread, seen))    { ret true; }
        if (stmt_calls_c_variadic(sc, a, rr, s.data.if_.then_block, want_spread, seen)) { ret true; }
        ret stmt_calls_c_variadic(sc, a, rr, s.data.if_.else_block, want_spread, seen);
    }
    if (k == ast_stmt.STMT_KIND_FOR) {
        if (expr_has_c_variadic_call(sc, a, rr, s.data.for_.cond, want_spread, seen)) { ret true; }
        ret stmt_calls_c_variadic(sc, a, rr, s.data.for_.body, want_spread, seen);
    }
    if (k == ast_stmt.STMT_KIND_FIN) { ret stmt_calls_c_variadic(sc, a, rr, s.data.fin_.body, want_spread, seen); }
    if (k == ast_stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids.data[s.data.block.stmts_start + i], want_spread, seen)) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    if (k == ast_stmt.STMT_KIND_COMPTIME_IF) {
        var bi: u32 = 0;
        for (bi < s.data.comptime_if.branches_len) {
            val br:  *ast_decl.ComptimeBranch = ?a.comptime_branches.data[s.data.comptime_if.branches_start + bi];
            var si2: u32                      = 0;
            for (si2 < br.body_len) {
                if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids.data[br.body_start + si2], want_spread, seen)) { ret true; }
                si2 = si2 + 1;
            }
            bi = bi + 1;
        }
        ret false;
    }
    if (k == ast_stmt.STMT_KIND_COMPTIME_EACH) {
        var ei: u32 = 0;
        for (ei < s.data.comptime_each.body_len) {
            if (stmt_calls_c_variadic(sc, a, rr, a.stmt_ids.data[s.data.comptime_each.body_start + ei], want_spread, seen)) { ret true; }
            ei = ei + 1;
        }
        ret false;
    }

    ret false;
}
