use lang_catalog: mach.lang.catalog;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.module;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.type;
use type_field:         mach.lang.type.field;
use type_kind:          mach.lang.type.kind;
use type_prim:          mach.lang.type.prim;
use A:                  std.allocator;
use collections_vector: std.collections.vector;
use std.crypto.hash.sha256;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

rec Encoder {
    s:       *session.Session;
    bytes:   collections_vector.Vector[u8];
    failure: err[fail.Fail];
}

# the failure is sticky and read through a call, so recording a later one
# is not an assignment inside a guard
fun failed(out: *Encoder) bool {
    ret sel out.failure.err;
}

fun refuse(out: *Encoder, f: fail.Fail) {
    out.failure = err[fail.Fail].err{f};
}

fun byte(out: *Encoder, value: u8) {
    if (failed(out)) { ret; }
    val appended: res[usize, A.Error] = collections_vector.push[u8](?out.bytes, value);
    if (sel appended.err) { refuse(out, fail.refused(appended.err)); }
}

fun word(out: *Encoder, value: u64) {
    if (failed(out)) { ret; }
    var shift: u32 = 64;
    for (shift > 0) {
        shift = shift - 4;
        val digit: u8 = ((value >> shift) & 15)::u8;
        if (digit < 10) { byte(out, '0' + digit); }
        or              { byte(out, 'a' + digit - 10); }
    }
}

fun text(out: *Encoder, value: str) {
    if (failed(out)) { ret; }
    val count: usize = str_len(value);
    word(out, count::u64);
    var i: usize = 0;
    for (i < count) {
        val high: u8 = value[i] >> 4;
        val low:  u8 = value[i] & 15;
        if (high < 10) { byte(out, '0' + high); }
        or             { byte(out, 'a' + high - 10); }
        if (low < 10)  { byte(out, '0' + low); }
        or             { byte(out, 'a' + low - 10); }
        i = i + 1;
    }
}

fun name(out: *Encoder, value: intern.StrId) {
    if (failed(out)) { ret; }
    val found: opt[str] = intern.get(?out.s.interner, value);
    if (!sel found.some) {
        refuse(out, fail.message("canonical type recipe has no interned name"));
        ret;
    }
    text(out, found.some);
}

fun nested_recipe(out: *Encoder, value: intern.StrId) {
    if (failed(out)) { ret; }
    val found: opt[str] = intern.get(?out.s.interner, value);
    if (!sel found.some) {
        refuse(out, fail.message("anonymous type has no owned canonical recipe"));
        ret;
    }
    val recipe: str   = found.some;
    val count:  usize = str_len(recipe);
    word(out, count::u64);
    var i: usize = 0;
    for (i < count) {
        byte(out, recipe[i]);
        i = i + 1;
    }
}

fun owner(out: *Encoder, value: type.TypeOwner) {
    if (failed(out)) { ret; }
    if (!module.stable_is_nil(value.module)) {
        val mid: module.ModuleId = module.module_id_for_stable(?out.s.modules, value.module);
        if (module.is_nil(mid)) {
            refuse(out, fail.message("canonical type owner is not acquired"));
            ret;
        }
        byte(out, 'm');
        name(out, module.module_fqn(?out.s.modules, mid));
        ret;
    }
    val file: opt[*lang_source.SourceFile] = lang_source.get(out.s.sources, value.file);
    if (sel file.none) {
        refuse(out, fail.message("canonical standalone type owner has no source identity"));
        ret;
    }
    byte(out, 'f');
    text(out, file.some.path);
}

fun parameters(out: *Encoder, start: u32, count: u32) {
    if (failed(out)) { ret; }
    if (start > out.s.types.params_len || count > out.s.types.params_len - start) {
        refuse(out, fail.message("canonical type recipe has an invalid parameter run"));
        ret;
    }
    word(out, count::u64);
    var i: u32 = 0;
    for (i < count) {
        encode_type(out, out.s.types.params[start + i]);
        i = i + 1;
    }
}

fun handle(out: *Encoder, value: type.TypeHandle) {
    if (failed(out)) { ret; }
    val ti: *type.TypeInterner = ?out.s.types;
    if (value.ops_start > ti.handle_ops_len || value.ops_len > ti.handle_ops_len - value.ops_start) {
        refuse(out, fail.message("canonical handle has an invalid operand run"));
        ret;
    }
    if (value.ctor == type.NO_HANDLE_CTOR) {
        if (value.ops_len != 3) {
            refuse(out, fail.message("inert handle has no stable declaration identity"));
            ret;
        }
        owner(out, type.TypeOwner{module: ti.handle_ops[value.ops_start]::module.StableModuleId,
            file: ti.handle_ops[value.ops_start + 1]::lang_source.FileId});
        name(out, ti.handle_ops[value.ops_start + 2]::intern.StrId);
        ret;
    }
    if ((value.ops_len & 1) != 0) {
        refuse(out, fail.message("minted handle has an unpaired operand"));
        ret;
    }
    name(out, value.ctor::intern.StrId);
    word(out, (value.ops_len / 2)::u64);
    var i: u32 = 0;
    for (i < value.ops_len) {
        val part: u32 = ti.handle_ops[value.ops_start + i];
        val held: u32 = ti.handle_ops[value.ops_start + i + 1];
        i = i + 2;
        word(out, part::u64);
        if (part == type.HANDLE_PART_TYPE) { encode_type(out, type_kind.id(held)); }
        or (part == type.HANDLE_PART_NAME) { name(out, held::intern.StrId); }
        or                                 { word(out, held::u64); }
    }
}

fun encode_type(out: *Encoder, tid: type_kind.TypeId) {
    if (failed(out)) { ret; }
    if (type_kind.is_nil(tid)) {
        byte(out, 'n');
        ret;
    }
    val found: opt[*type.Type] = type.get(?out.s.types, tid);
    if (!sel found.some) {
        refuse(out, fail.message("canonical type recipe has an invalid type"));
        ret;
    }
    val value: type.Type = @found.some;
    byte(out, 't');
    word(out, value.kind::u64);
    if (type_prim.is_prim(value.kind) || value.kind == type_kind.TYPE_PACK) { ret; }
    if (value.kind == type_kind.TYPE_POINTER) {
        encode_type(out, value.data.pointer.base);
        ret;
    }
    if (value.kind == type_kind.TYPE_SECRET) {
        encode_type(out, value.data.secret.base);
        ret;
    }
    if (value.kind == type_kind.TYPE_ARRAY) {
        word(out, value.data.array.count::u64);
        encode_type(out, value.data.array.base);
        ret;
    }
    if (value.kind == type_kind.TYPE_VECTOR) {
        word(out, value.data.vector.element::u64);
        word(out, value.data.vector.lanes::u64);
        ret;
    }
    if (value.kind == type_kind.TYPE_FUN) {
        word(out, value.data.fn.c_variadic::u64);
        encode_type(out, value.data.fn.ret_type);
        parameters(out, value.data.fn.params_start, value.data.fn.params_len);
        ret;
    }
    if (value.kind == type_kind.TYPE_REC || value.kind == type_kind.TYPE_UNI || value.kind == type_kind.TYPE_TAG) {
        owner(out, value.data.nominal.owner);
        name(out, value.data.nominal.name);
        if (value.data.nominal.incarnation == 0) { byte(out, 'd'); }
        or {
            byte(out, 'a');
            nested_recipe(out, value.data.nominal.syntax);
        }
        ret;
    }
    if (value.kind == type_kind.TYPE_GENERIC_PARAM) {
        owner(out, value.data.generic_param.owner);
        name(out, value.data.generic_param.owner_name);
        name(out, value.data.generic_param.name);
        word(out, value.data.generic_param.owner_kind::u64);
        word(out, value.data.generic_param.index::u64);
        ret;
    }
    if (value.kind == type_kind.TYPE_INSTANCE) {
        encode_type(out, value.data.instance.nominal);
        parameters(out, value.data.instance.args_start, value.data.instance.args_len);
        ret;
    }
    if (value.kind == type_kind.TYPE_HANDLE) {
        handle(out, value.data.handle);
        ret;
    }
    if (value.kind == type_kind.TYPE_ABI) {
        name(out, value.data.abi.name);
        word(out, value.data.abi.tag::u64);
        word(out, value.data.abi.size::u64);
        word(out, value.data.abi.align::u64);
        ret;
    }
    refuse(out, fail.message_of(lang_catalog.catalog_interned(?out.s.interner, out.s.alloc, lang_catalog.unknown_member("TypeKind", value.kind::u32))));
}

pub fun anonymous(s: *session.Session, kind: type_kind.TypeKind,
    fields: *type_field.Entry, count: u32) res[intern.StrId, fail.Fail] {
    var out: Encoder = Encoder{s: s, bytes: collections_vector.init[u8](s.alloc), failure: err[fail.Fail].ok{}};
    fin { collections_vector.dnit[u8](?out.bytes); }
    word(?out, kind::u64);
    word(?out, count::u64);
    var i: u32 = 0;
    for (i < count) {
        name(?out, fields[i].name);
        encode_type(?out, fields[i].ty);
        i = i + 1;
    }
    if (sel out.failure.err) { ret res[intern.StrId, fail.Fail].err{out.failure.err}; }
    val interned: res[intern.StrId, A.Error] = intern.bytes_add(?s.interner, out.bytes.data::str, out.bytes.len);
    if (sel interned.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(interned.err)}; }
    ret res[intern.StrId, fail.Fail].ok{interned.ok};
}

val IDENTITY_DOMAIN: str = "mach.type_id";

# the first 64 bits of sha-256 over a domain tag and the type's canonical recipe; the recipe
# names nominal types by owning module and name, so every unit of one program derives the same value
pub fun identity(s: *session.Session, tid: type_kind.TypeId) res[u64, fail.Fail] {
    var out: Encoder = Encoder{s: s, bytes: collections_vector.init[u8](s.alloc), failure: err[fail.Fail].ok{}};
    fin { collections_vector.dnit[u8](?out.bytes); }
    text(?out, IDENTITY_DOMAIN);
    encode_type(?out, tid);
    if (sel out.failure.err) { ret res[u64, fail.Fail].err{out.failure.err}; }
    var digest: [32]u8;
    sha256.hash(out.bytes.data, out.bytes.len, ?digest[0]);
    var value: u64 = 0;
    var i:     u32 = 0;
    for (i < 8) {
        value = (value << 8) | digest[i]::u64;
        i     = i + 1;
    }
    ret res[u64, fail.Fail].ok{value};
}
