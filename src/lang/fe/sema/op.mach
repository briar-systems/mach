# an `#[op]` function names an instruction of an owner's operation catalog: mirl's
# capability op catalog and masc's SPIR-V rows state them. mach holds no table of
# its own, so an op of the selected target is refused until mach reads theirs
use diagnostic_kind: mach.lang.diagnostic.kind;
use ast_decl:        mach.lang.fe.ast.decl;
use mach.lang.fe.decorator;
use sema_context: mach.lang.fe.sema.context;
use mach.lang.intern;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_equals;

pub fun validate_op(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (dec.args_len != 3) { ret; }
    val opt_tgt: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    if (sel opt_tgt.none)                      { ret; }
    if (!target_is_selected(sc, opt_tgt.some)) { ret; }
    sema_context.report(sc, diagnostic_kind.OP_UNKNOWN, dec.name, "an `op` of the selected target waits for mach to read the owners' operation catalog; mach states no instruction table of its own");
}

fun target_is_selected(sc: *sema_context.SemaContext, tgt: str) bool {
    val no: opt[str] = intern.get(?sc.s.interner, sc.view.ctx.env.build.isa_name);
    if (!sel no.some) { ret false; }
    ret str_equals(tgt, no.some);
}
