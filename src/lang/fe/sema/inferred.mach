use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;

use mach.lang.fe.ast;
use ast_decl:     mach.lang.fe.ast.decl;
use ast_expr:     mach.lang.fe.ast.expr;
use ast_id:       mach.lang.fe.ast.id;
use ast_type:     mach.lang.fe.ast.type;
use sema_context: mach.lang.fe.sema.context;
use sema_product: mach.lang.fe.sema.product;

# the one owner of "the length of an array literal" is its element count, which the
# `array.literal_length` check also reads. this pass hands that count to the `[_]T` type nodes
# a literal fixes, before any type resolves: the literal's own type spelling, and the annotation
# of a `val` or `var` initialized by one. a `[_]` left unset is refused where it resolves
pub fun record_all(sc: *sema_context.SemaContext) {
    var i: u32 = 0;
    for (i < sc.view.a.exprs.len::u32) {
        val lit: opt[*ast_expr.ExprArrayLit] = array_lit_at(sc, ast_id.expr(i));
        if (sel lit.some) { record_type(sc, lit.some.ty, lit.some.elems_len::u64); }
        i = i + 1;
    }

    i = 0;
    for (i < sc.view.a.decls.len::u32) {
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, ast_id.decl(i));
        if (sel d_opt.some) { record_binding(sc, d_opt.some); }
        i = i + 1;
    }
}

fun record_binding(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) { ret; }
    val tid: ast_id.TypeId = through_secret(sc, d.data.bind.ty);
    if (!is_inferred_array(sc, tid)) { ret; }
    # an `embed` declaration has no initializer and its length is already set
    if (ast_id.expr_is_nil(d.data.bind.init)) {
        if (sema_context.inferred_len_of(sc, tid) == sema_product.INFERRED_LEN_NONE) {
            sema_context.set_inferred_len(sc, tid, sema_product.INFERRED_LEN_NEEDS_LITERAL);
        }
        ret;
    }
    val lit: opt[*ast_expr.ExprArrayLit] = array_lit_at(sc, d.data.bind.init);
    if (!sel lit.some) {
        sema_context.set_inferred_len(sc, tid, sema_product.INFERRED_LEN_NEEDS_LITERAL);
        ret;
    }
    record_type(sc, tid, lit.some.elems_len::u64);
}

fun array_lit_at(sc: *sema_context.SemaContext, eid: ast_id.ExprId) opt[*ast_expr.ExprArrayLit] {
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (!sel e_opt.some)                                 { ret opt[*ast_expr.ExprArrayLit].none{}; }
    if (e_opt.some.kind != ast_expr.EXPR_KIND_ARRAY_LIT) { ret opt[*ast_expr.ExprArrayLit].none{}; }
    ret opt[*ast_expr.ExprArrayLit].some{?e_opt.some.data.array_lit};
}

# a binding annotation `^[_]T` fixes its length like `[_]T`, a secret array's length is public
fun through_secret(sc: *sema_context.SemaContext, tid: ast_id.TypeId) ast_id.TypeId {
    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (!sel t_opt.some)                              { ret tid; }
    if (t_opt.some.kind != ast_type.TYPE_KIND_SECRET) { ret tid; }
    ret t_opt.some.data.secret.inner;
}

fun record_type(sc: *sema_context.SemaContext, tid: ast_id.TypeId, len: u64) {
    if (!is_inferred_array(sc, tid)) { ret; }
    # the count is stored on the type node because an array literal's element count is syntactic,
    # an instance-dependent element form such as a pack spread would need it on the instance
    sema_context.set_inferred_len(sc, tid, len);
}

fun is_inferred_array(sc: *sema_context.SemaContext, tid: ast_id.TypeId) bool {
    val t_opt: opt[*ast_type.Type] = ast.get_type(sc.view.a, tid);
    if (!sel t_opt.some)                             { ret false; }
    if (t_opt.some.kind != ast_type.TYPE_KIND_ARRAY) { ret false; }
    ret ast_id.expr_is_nil(t_opt.some.data.array.length);
}
