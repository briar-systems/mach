test dotted_path__resolves_through_spacing_and_comments {
    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "mid.mach";
    names[2] = "leaf.mach";
    var texts: [3]str;
    texts[2] = "pub rec Box[T] { value: T; }\npub rec Plain { value: i32; }\npub fun answer() i32 { ret 7; }\n";
    texts[1] = "fwd uniontest.leaf;\nfwd B: uniontest.leaf.Box;\nfwd uniontest.leaf.Plain;\nfwd uniontest.leaf.answer;\n";
    texts[0] = "use uniontest.mid;\nuse B: uniontest.mid.B;\nuse uniontest.mid.Plain;\nuse uniontest.mid.answer;\nfun take(p: *mid.leaf.Box[i32]) i32 { ret p.value; }\nfun pass(p: *B[i32], q: *mid.B[i32], r: *Plain) i32 { ret take(p) + take(q) + r.value; }\nfun main() i32 { ret answer(); }\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "", false) != 0) { ret 1; }
    texts[1] = "fwd uniontest . leaf;\nfwd B: uniontest . leaf . Box;\nfwd uniontest . leaf . Plain;\nfwd uniontest . leaf . answer;\n";
    texts[0] = "use uniontest . mid;\nuse B: uniontest . mid . B;\nuse uniontest . mid . Plain;\nuse uniontest . mid . answer;\nfun take(p: *mid . leaf . Box[i32]) i32 { ret p.value; }\nfun pass(p: *B[i32], q: *mid . B[i32], r: *Plain) i32 { ret take(p) + take(q) + r.value; }\nfun main() i32 { ret answer(); }\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "", false) != 0) { ret 2; }
    texts[1] = "fwd uniontest # ignored.module\r\n . leaf;\nfwd B: uniontest . # not.a.module\n leaf . Box;\nfwd uniontest . leaf # .fake\r . Plain;\nfwd uniontest . leaf . # fake.symbol\n answer;\n";
    texts[0] = "use uniontest # .ignored\n . mid;\nuse B: uniontest . # wrong.module\r\n mid . B;\nuse uniontest . mid # .wrong\n . Plain;\nuse uniontest . mid . # false.leaf\n answer;\nfun take(p: *mid # ignored.path\n . leaf . # ignored.Type\n Box[i32]) i32 { ret p.value; }\nfun pass(p: *B[i32], q: *mid . # ignored.Type\n B[i32], r: *Plain) i32 { ret take(p) + take(q) + r.value; }\nfun main() i32 { ret answer(); }\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "", false) != 0) { ret 3; }
    ret 0;
}

# a rejected dotted path names what was written without its comments, and keeps the
# original source span for a module path and a type path
test dotted_path__rejection_ignores_trivia_and_keeps_its_span {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "use missing # other.root\n . library;\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;

    var bad: i32                             = 0;
    val pr:  res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    # the tolerant load keeps the project standing rejected; the report is what is checked
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = passes.frontend_status(?p);
        if (!sel standing.kind.rejected) { bad = 1; }
        project.dnit_project(?p);
    }
    {
        var seen: bool  = false;
        var i:    usize = 0;
        for (i < diagnostic.len(?s.diags)) {
            val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
            if (diagnostic_kind.is_error(d.kind) && ut_str_contains(d.message, "module root 'missing'")) {
                seen = true;
                if (!ut_str_contains(d.message, "missing.library")) { bad = 1; }
                if (ut_str_contains(d.message, "other.root"))       { bad = 1; }
            }
            i = i + 1;
        }
        if (!seen) { bad = 1; }
    }

    fs.remove_all(?alloc, root);
    session.dnit(?s);
    if (bad != 0) { ret bad; }
    if (ut_gate_diag_located("use missing # other.root\n . library;\nfun main() i32 { ret 0; }\n",
        "module root 'missing'", "main.mach", 1, 5, "missing # other.root\n . library") != 0) { ret 2; }
    if (ut_gate_diag_located("fun take(p: *missing # other.root\n . library) i32 { ret 0; }\nfun main() i32 { ret 0; }\n",
        "unresolved type name `missing`", "main.mach", 1, 14, "missing # other.root\n . library") != 0) { ret 3; }
    ret 0;
}

# a `fwd` is visible before its textual position, admits only the name it forwards, and a
# renamed forward does not admit the canonical spelling
test fwd__resolves_only_what_it_forwards {
    var names: [3]str = [3]str{"main.mach", "mid.mach", "leaf.mach"};
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.before() + mid.after(); }\n";
    texts[1] = "pub fun before() i32 { ret fa(); }\nfwd uniontest.leaf.fa;\npub fun after() i32 { ret fa(); }\n";
    texts[2] = "pub fun fa() i32 { ret 3; }\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "", false) != 0) { ret 1; }
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.before(); }\n";
    texts[1] = "pub fun before() i32 { ret nope(); }\nfwd uniontest.leaf.fa;\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "unresolved identifier", true) != 0) { ret 2; }
    texts[0] = "use uniontest.mid;\nfun main() i32 { ret mid.original_name(); }\n";
    texts[1] = "fwd renamed_alias: uniontest.leaf.original_name;\n";
    texts[2] = "pub fun original_name() i32 { ret 42; }\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "no symbol", true) != 0) { ret 3; }
    ret 0;
}

# 0 when a project whose mid module forwards leaf.original_name under two names links
#[testing]
fun t_fwd_renamed_links(main_text: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names:  [3]str              = [3]str{"main.mach", "mid.mach", "leaf.mach"};
    var texts:  [3]str              = [3]str{main_text, "fwd renamed_alias: uniontest.leaf.original_name;\nfwd uniontest.leaf.original_name;\n", "pub fun original_name() i32 { ret 42; }\n"};
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) { ret 1; }
    val root: str = root_r.ok;
    fin { fs.remove_all(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = ut_back_half(?s, root);
    if (sel pr.err) { ret 1; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    val set_link_config_input_r: err[fail.Fail] = engine.set_link_config_input(?p, "out/app"::*u8, "app"::*u8, 0, nil, 0, nil, 0, nil);
    if (sel set_link_config_input_r.err) { ret 1; }
    val rl: res[bool, fail.Fail] = driver.run_link_pass(?p);
    if (sel rl.err) { ret 2; }
    ret 0;
}

# a renamed re-export links across the module boundary whichever order its names are imported in
test fwd__renamed_reexport_links {
    val qualified: i32 = t_fwd_renamed_links("use uniontest.mid;\nfun main() i32 { ret mid.renamed_alias() - mid.original_name(); }\n");
    if (qualified != 0) { ret 10 + qualified; }
    val leaves: i32 = t_fwd_renamed_links("use uniontest.mid.renamed_alias;\nuse uniontest.mid.original_name;\nfun main() i32 { ret renamed_alias() - original_name(); }\n");
    if (leaves != 0) { ret 20 + leaves; }
    ret 0;
}

# the same parsed bracket is read as a generic call or an index as its names change, and the
# reused syntax tree is never rewritten
test bracket__reinterprets_without_rewriting_the_tree {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names:    [2]str = [2]str{"main.mach", "lib.mach"};
    var versions: [2]str = [2]str{
        "pub def Key: i64;\npub fun item[T](v: T) T { ret v; }\n",
        "pub val Key: u64 = 0;\nfun identity(v: i64) i64 { ret v; }\npub val item: [1]fun(i64) i64 = [1]fun(i64) i64{identity};\n"
    };
    var texts: [2]str = [2]str{
        "use uniontest.lib.item;\nuse uniontest.lib.Key;\nfun main() i64 { ret item[Key](3); }\n", versions[0]
    };
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val joined: res[str, A.Error] = types_path.join(?alloc, root, "src/lib.mach");
    if (sel joined.err) { ret 5; }
    val filename: str = joined.ok;
    fin { str_free(?alloc, filename); }
    var saved: *ast_expr.Expr = nil;
    var count: usize          = 0;
    fin {
        if (saved != nil) { A.deallocate[ast_expr.Expr](?alloc, saved, count); }
    }
    var owner:       *ast.Ast       = nil;
    var incarnation: u64            = 0;
    var selected:    ast_id.ExprId  = ast_id.EXPR_NIL;
    var revision:    query.Revision = 0;
    var round:       u32            = 0;
    for (round < 3) {
        val version:       u32             = round % 2;
        val write_bytes_r: err[fs.FsError] = fs.write_bytes(filename, versions[version], str_len(versions[version]), 420);
        if (sel write_bytes_r.err) { ret 6; }
        val opened: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
        if (sel opened.err) { ret 7; }
        var p: project.Project = opened.ok;
        fin { project.dnit_project(?p); }
        val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
        if (module.is_nil(mid)) { ret 8; }
        val parsed: *ast.Ast = project.module_at(?p, mid::u32).a;
        if (parsed == nil) { ret 9; }
        val current: query.Revision = query.peek_revision(?s.queries, query.Q_PARSE, lang_source.file_index(project.module_at(?p, mid::u32).file_id)::u64);
        if (round == 0) {
            owner       = parsed;
            incarnation = parsed.incarnation;
            revision    = current;
            count       = parsed.expr_len;
            val storage: res[*ast_expr.Expr, A.Error] = A.allocate[ast_expr.Expr](?alloc, count);
            if (sel storage.err) { ret 10; }
            saved = storage.ok;
            memory.copy[ast_expr.Expr](saved, parsed.exprs, count);
            var i: usize = 0;
            for (i < count) {
                if (saved[i].kind == ast_expr.EXPR_KIND_CALL && !ast_id.expr_is_nil(saved[i].data.call.index_callee)) {
                    if (!ast_id.expr_is_nil(selected)) { ret 11; }
                    selected = ast_id.expr(i::u32);
                }
                i = i + 1;
            }
            if (ast_id.expr_is_nil(selected) || revision == 0) { ret 12; }
        }
        if (parsed != owner || parsed.incarnation != incarnation || parsed.expr_len != count || current != revision
            || !memory.equal[ast_expr.Expr](saved, parsed.exprs, count)) { ret 13; }
        val run_sema_pass_r: err[fail.Fail] = driver.run_sema_pass(?p);
        if (sel run_sema_pass_r.err) {
            var di: usize = 0;
            for (di < diagnostic.len(?s.diags)) {
                print.eprintln(s.diags.items.data[di].message);
                di = di + 1;
            }
            ret 14;
        }
        val interpreted: res[ast_expr.Expr, fail.Fail] = resolve.expression(project.module_at(?p, mid::u32).resolve_result, parsed, selected);
        if (sel interpreted.err) { ret 15; }
        val node: ast_expr.Expr = interpreted.ok;
        if (node.kind != ast_expr.EXPR_KIND_CALL || !ast_id.expr_is_nil(node.data.call.index_callee))                                                                   { ret 16; }
        if (version == 0 && (node.data.call.type_args_len != 1 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.callee)))       { ret 17; }
        if (version == 1 && (node.data.call.type_args_len != 0 || !ast_id.expr_same(node.data.call.callee, saved[ast_id.expr_index(selected)].data.call.index_callee))) { ret 18; }
        val run_lower_pass_r: err[fail.Fail] = driver.run_lower_pass(?p);
        if (sel run_lower_pass_r.err)                                 { ret 19; }
        if (!memory.equal[ast_expr.Expr](saved, parsed.exprs, count)) { ret 20; }
        round = round + 1;
    }
    ret 0;
}

test qualified_member__unexported_is_refused {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pr: res[project.Project, fail.Fail] = ut_sema2(?s, ?alloc,
        "use a: uniontest.a;\nval NOPE: i64 = 1;\nfun main() i32 { ret a.NOPE::i32; }\n",
        "pub val X: i64 = 909;\n");
    if (!ut_project_was_rejected(pr)) {
        session.dnit(?s);
        ret 1;
    }

    var bad: i32 = 0;
    if (!ut_diag_has(?s.diags, "no symbol")) { bad = 1; }

    session.dnit(?s);
    ret bad;
}

# 0 when main builds without error and warns `unused import` exactly at `unused`, or not at all when it
# is empty. the project depends on `leaf`, whose own unused import is never reported
#[testing]
fun t_unused_import(main: str, unused: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names:    [2]str              = [2]str{"main.mach", "lib.mach"};
    var texts:    [2]str              = [2]str{main, "pub fun f() i32 { ret 1; }\npub val ON: u8 = 1;\n"};
    val consumer: str                 = ut_cc3(?alloc, ut_manifest(), "\n[dep.leaf]\npath = \"dep/leaf\"\n", "");
    val scaffold: res[str, fail.Fail] = ut_scaffold_m(?alloc, consumer, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 3; }
    val root: str = scaffold.ok;
    fin { fs.remove_all(?alloc, root); }
    val dep_src: str             = ut_cc3(?alloc, root, "/", "dep/leaf/src");
    val made:    err[fs.FsError] = fs.create_dir_all(?alloc, dep_src, 493);
    if (sel made.err) { ret 3; }
    val dep_manifest: str             = ut_lib_manifest(?alloc, "leaf");
    val dep_lib:      str             = "use leaf.util.u;\npub fun plain() i32 { ret 0; }\n";
    val dep_util:     str             = "pub fun u() i32 { ret 1; }\n";
    val w0:           err[fs.FsError] = fs.write_bytes(ut_cc3(?alloc, root, "/dep/leaf/", manifest.MANIFEST_FILE), dep_manifest, str_len(dep_manifest), 420);
    val w1:           err[fs.FsError] = fs.write_bytes(ut_cc3(?alloc, dep_src, "/", "lib.mach"), dep_lib, str_len(dep_lib), 420);
    val w2:           err[fs.FsError] = fs.write_bytes(ut_cc3(?alloc, dep_src, "/", "util.mach"), dep_util, str_len(dep_util), 420);
    if (sel w0.err) { ret 3; }
    if (sel w1.err) { ret 3; }
    if (sel w2.err) { ret 3; }
    val built: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    val checked: err[fail.Fail] = driver.run_sema_pass(?p);
    if (sel checked.err)                 { ret 4; }
    if (diagnostic.has_errors(?s.diags)) { ret 5; }
    var warned: u32   = 0;
    var i:      usize = 0;
    for (i < diagnostic.len(?s.diags)) {
        val d: *diagnostic.Diagnostic = ?s.diags.items.data[i];
        if (!diagnostic_kind.is_error(d.kind) && ut_str_contains(d.message, "unused import")) {
            val file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, d.loc.file);
            if (sel file.none)                                                       { ret 6; }
            if (!str_equals(file.some.text, main))                                   { ret 7; }
            if (!str_region_equals(main, d.loc.span.offset, d.loc.span.len, unused)) { ret 8; }
            warned = warned + 1;
        }
        i = i + 1;
    }
    if (str_len(unused) == 0 && warned != 0) { ret 9; }
    if (str_len(unused) != 0 && warned != 1) { ret 10; }
    ret 0;
}

test resolve__unused_symbol_imports_warn_and_module_imports_never_do {
    if (t_unused_import("use uniontest.lib.f;\nfun main() i32 { ret 0; }\n", "f") != 0)                                                      { ret 1; }
    if (t_unused_import("use g: uniontest.lib.f;\nuse uniontest.lib.ON;\nfun main() i32 { ret ON::i32; }\n", "g") != 0)                      { ret 2; }
    if (t_unused_import("use uniontest.lib;\nuse other: uniontest.lib;\nfun main() i32 { ret 0; }\n", "") != 0)                              { ret 3; }
    if (t_unused_import("use uniontest.lib.f;\nval C: u8 = 0;\n$if (C) { fun g() i32 { ret f(); } }\nfun main() i32 { ret 0; }\n", "") != 0) { ret 4; }
    if (t_unused_import("use uniontest.lib.f;\nval C: u8 = 0;\nfun main() i32 { $if (C) { ret f(); } ret 0; }\n", "") != 0)                  { ret 5; }
    if (t_unused_import("use leaf.lib.plain;\nfun main() i32 { ret plain(); }\n", "") != 0)                                                  { ret 6; }
    ret 0;
}
