pub def SymbolId: u32;

pub val SYMBOL_NIL: SymbolId = 0xFFFFFFFF;
# an identifier visited and rejected by resolution has no symbol to remap.
pub val SYMBOL_REJECTED: SymbolId = 0xFFFFFFFE;

pub def SymKind: u8;

pub val SYM_FUN:      SymKind = 0;
pub val SYM_REC:      SymKind = 1;
pub val SYM_DEF:      SymKind = 2;
pub val SYM_VAL:      SymKind = 3;
pub val SYM_VAR:      SymKind = 4;
pub val SYM_PARAM:    SymKind = 5;
pub val SYM_GENERIC:  SymKind = 6;
pub val SYM_USE:      SymKind = 7;
pub val SYM_IMPORTED: SymKind = 8;
pub val SYM_TEST:     SymKind = 9;
pub val SYM_UNI:      SymKind = 10;
pub val SYM_PRIM:     SymKind = 11;
pub val SYM_VECTOR:   SymKind = 12;
pub val SYM_TAG:      SymKind = 13;

pub val SYM_KIND_COUNT: u32 = 14;

pub fun sym_kind_valid(kind: SymKind) bool {
    ret kind::u32 < SYM_KIND_COUNT;
}

pub val SYM_FLAG_PUB: u8 = 1;

pub val SYM_FLAG_COMPTIME: u8 = 2;

pub val SYM_FLAG_MODULE: u8 = 4;

# an imported symbol is shared by every binding of the same definition that carries the
# same notice, so a deprecated alias never taints a clean alias of the same canonical name
rec ImportedKey {
    origin: session.ModuleId;
    canon:  intern.StrId;
    notice: deprecation.Deprecation;
}

fun imported_hash(p: ptr) u64 {
    val k: *ImportedKey = p::*ImportedKey;
    var h: u64 = k.origin::u64 ^ (k.canon::u64 << 32);
    if (k.notice.present) { h = h ^ (k.notice.owner::u64 * 1099511628211) ^ k.notice.message::u64 ^ 1; }
    ret h;
}

fun imported_equal(a: ptr, b: ptr) bool {
    val x: *ImportedKey = a::*ImportedKey;
    val y: *ImportedKey = b::*ImportedKey;
    ret x.origin == y.origin && x.canon == y.canon && deprecation.equal(x.notice, y.notice);
}

pub rec Symbol {
    kind:   SymKind;
    definition_kind: SymKind;
    definition_file: src.FileId;
    generic_arity: u32;
    has_comptime_params: bool;
    has_pack_param: bool;
    deprecation: deprecation.Deprecation;
    flags:  u8;
    name:   intern.StrId;
    canon:  intern.StrId;
    decl:   id.DeclId;
    slot:   u32;
    origin: session.ModuleId;
    origin_stable: session.StableModuleId;
    slot_stable:   session.StableModuleId;
}

pub rec PublicSymbol {
    kind:   SymKind;
    name:   intern.StrId;
    canon:  intern.StrId;
    file: src.FileId;
    generic_arity: u32;
    has_comptime_params: bool;
    has_pack_param: bool;
    deprecation: deprecation.Deprecation;
    slot:   u32;
    origin: session.ModuleId;
}

pub rec ModuleExports {
    path:    intern.StrId;
    module:  session.ModuleId;
    symbols: *PublicSymbol;
    count:   u32;
}

pub rec ExportConstant {
    name: intern.StrId;
    present: bool;
    gated: bool;
    value: comptime.CTValue;
}

pub rec ParsedDefinition {
    a: *ast.Ast;
    status: fail.PhaseStatus;
    owner: type.TypeOwner;
    incarnation: u64;
}

pub rec ResolveDeps {
    entries: *ModuleExports;
    count:   u32;
}

def ScopeId: u32;
val SCOPE_NIL: ScopeId = 0xFFFFFFFF;

rec ScopeEntry {
    name: intern.StrId;
    sym:  SymbolId;
}

rec Scope {
    parent:  ScopeId;
    entries: *ScopeEntry;
    len:     u32;
    cap:     u32;
}

val INITIAL_SCOPE_ENTRY_CAP: u32 = 8;
val INITIAL_SCOPES_CAP:      u32 = 8;
val INITIAL_SYMBOLS_CAP:     u32 = 32;

rec ResolveContext {
    diags: *diagnostic.DiagnosticStore;
    status: fail.PhaseStatus;
    s:          *session.Session;
    a:          *ast.Ast;
    deps:       *ResolveDeps;
    ctx:        *comptime.ComptimeCtx;
    caps:       comptime.PhaseCapabilities[ResolveContext];
    own_module: session.ModuleId;
    source:     str;
    terminal:   bool;
    in_gated_decl_scope: bool;

    symbols:    *Symbol;
    sym_len:    u32;
    sym_cap:    u32;

    expr_resolved: *SymbolId;
    type_resolved: *SymbolId;
    decl_symbol:   *SymbolId;

    scopes:        *Scope;
    scope_len:     u32;
    scope_cap:     u32;

    module_scope:  ScopeId;
    current_scope: ScopeId;

    prim_names: [11]intern.StrId;
    prim_syms:  [11]SymbolId;

    vec_cache: map.Map[intern.StrId, SymbolId];

    imported_cache: map.Map[ImportedKey, SymbolId];

    module_index: map.Map[intern.StrId, SymbolId];

    expr_choices: *interpretation.Choice;
    expr_choices_count: usize;
}

val PRIM_COUNT: u32 = 11;

pub rec ResolveResult {
    status: fail.PhaseStatus;
    alloc:         *A.Allocator;
    symbols:       *Symbol;
    symbol_count:  u32;
    pub_count:     u32;
    expr_resolved: *SymbolId;
    type_resolved: *SymbolId;
    decl_symbol:   *SymbolId;
    expr_count:    u32;
    type_count:    u32;
    decl_count:    u32;

    param_index:   map.Map[u64, SymbolId];

    public_constants: *ExportConstant;
    public_constant_count: u32;

    expr_choices: *interpretation.Choice;
    expr_choices_count: usize;

    remap_sequence: u64;
    remap_modules: u32;
}

pub fun param_symbol(r: *ResolveResult, decl: id.DeclId, slot: u32) SymbolId {
    var key: u64 = (decl::u64 << 32) | slot::u64;
    val g: opt[*SymbolId] = map.get[u64, SymbolId](?r.param_index, ?key);
    if (sel g.some) { ret @g.some; }
    ret SYMBOL_NIL;
}

fun stable_of_module(s: *session.Session, mid: session.ModuleId) session.StableModuleId {
    if (mid == session.MODULE_NIL) { ret session.STABLE_MODULE_NIL; }
    val fqn: intern.StrId = session.module_fqn(s, mid);
    if (fqn == intern.STR_NIL) { ret session.STABLE_MODULE_NIL; }
    ret session.stable_module_id_lookup(s, fqn);
}

pub fun type_owner(s: *session.Session, mid: session.ModuleId, file: src.FileId) type.TypeOwner {
    ret type.TypeOwner{ module: stable_of_module(s, mid), file: file };
}

pub fun remap_result(r: *ResolveResult, s: *session.Session) {
    if (r == nil || r.symbols == nil) { ret; }
    # a loaded module keeps its id for the whole operation, so a result already
    # remapped under this operation and module census is current
    val sequence: u64 = s.queries.operation_sequence;
    val modules: u32 = session.module_count(s);
    if (r.remap_sequence == sequence && r.remap_modules == modules) { ret; }
    var i: u32 = 0;
    for (i < r.symbol_count) {
        val sym: *Symbol = ?r.symbols[i];
        sym.origin = session.module_id_for_stable(s, sym.origin_stable);
        if (sym.kind == SYM_USE) {
            sym.slot = session.module_id_for_stable(s, sym.slot_stable)::u32;
        }
        i = i + 1;
    }
    r.remap_sequence = sequence;
    r.remap_modules = modules;
}

pub fun dnit_result(r: *ResolveResult) {
    if (r == nil) { ret; }
    if (r.symbols != nil && r.symbol_count > 0) {
        A.deallocate[Symbol](r.alloc, r.symbols, r.symbol_count::usize);
    }
    if (r.expr_resolved != nil) {
        A.deallocate[SymbolId](r.alloc, r.expr_resolved, r.expr_count::usize);
    }
    if (r.type_resolved != nil) {
        A.deallocate[SymbolId](r.alloc, r.type_resolved, r.type_count::usize);
    }
    if (r.decl_symbol != nil) {
        A.deallocate[SymbolId](r.alloc, r.decl_symbol, r.decl_count::usize);
    }
    if (r.public_constants != nil && r.public_constant_count > 0) {
        A.deallocate[ExportConstant](r.alloc, r.public_constants, r.public_constant_count::usize);
    }
    if (r.expr_choices != nil && r.expr_choices_count != 0) {
        A.deallocate[interpretation.Choice](r.alloc, r.expr_choices, r.expr_choices_count);
    }
    map.dnit[u64, SymbolId](?r.param_index);
    r.symbols       = nil;
    r.symbol_count  = 0;
    r.pub_count     = 0;
    r.expr_resolved = nil;
    r.type_resolved = nil;
    r.decl_symbol   = nil;
    r.expr_count    = 0;
    r.type_count    = 0;
    r.decl_count    = 0;
    r.public_constants = nil;
    r.public_constant_count = 0;
    r.expr_choices = nil;
    r.expr_choices_count = 0;
}

# translation shim (#3226): the legacy carrier the unmigrated driver, editor
# and query still read. deleted by the boundary flip, when the `_typed` core
# takes the name
pub fun resolve(
    s:          *session.Session,
    a:          *ast.Ast,
    deps:       *ResolveDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    terminal:   bool,
    diags:      *diagnostic.DiagnosticStore
) R.Result[ResolveResult, fail.Fail] {
    val r: res[ResolveResult, fail.Fail] = resolve_typed(s, a, deps, ctx, own_module, terminal, diags);
    if (sel r.err) { ret R.err[ResolveResult, fail.Fail](r.err); }
    ret R.ok[ResolveResult, fail.Fail](r.ok);
}

pub fun resolve_typed(
    s:          *session.Session,
    a:          *ast.Ast,
    deps:       *ResolveDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    terminal:   bool,
    diags:      *diagnostic.DiagnosticStore
) res[ResolveResult, fail.Fail] {
    var rc: ResolveContext;
    val init_r: err[fail.Fail] = init_context(?rc, s, a, deps, ctx, own_module, terminal, diags);
    if (sel init_r.err) {
        ret res[ResolveResult, fail.Fail].err{init_r.err};
    }

    val ms_r: res[ScopeId, fail.Fail] = open_scope(?rc, SCOPE_NIL);
    if (sel ms_r.err) {
        dnit_context(?rc);
        ret res[ResolveResult, fail.Fail].err{ms_r.err};
    }
    rc.module_scope  = ms_r.ok;
    rc.current_scope = rc.module_scope;

    val sp_r: err[fail.Fail] = seed_primitives(?rc);
    if (sel sp_r.err) {
        dnit_context(?rc);
        ret res[ResolveResult, fail.Fail].err{sp_r.err};
    }

    val m_opt: opt[*module.Module] = ast.get_module_typed(a, a.root_module);
    if (!sel m_opt.some) {
        dnit_context(?rc);
        ret res[ResolveResult, fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *module.Module = m_opt.some;

    val c1: err[fail.Fail] = collect_decl_list(?rc, mnode.decls_start, mnode.decls_len, rc.module_scope, true);
    if (sel c1.err) {
        dnit_context(?rc);
        ret res[ResolveResult, fail.Fail].err{c1.err};
    }

    val ct: err[fail.Fail] = register_constant_tags(?rc, mnode.decls_start, mnode.decls_len);
    if (sel ct.err) {
        dnit_context(?rc);
        ret res[ResolveResult, fail.Fail].err{ct.err};
    }

    val b1: err[fail.Fail] = bind_decl_list(?rc, mnode.decls_start, mnode.decls_len);
    if (sel b1.err) {
        dnit_context(?rc);
        ret res[ResolveResult, fail.Fail].err{b1.err};
    }

    ret build_result(?rc);
}

# a module `val` constructed as a case literal is a constant tag, and a gate anywhere in the module
# may test it, so every top-level one is bound before any body is bound: the literal head is split
# into type and case now that the module's symbols are declared, which binding later leaves as is
fun register_constant_tags(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val d_opt: opt[*decl.Decl] = ast.get_decl_typed(rc.a, rc.a.decl_ids[start + i]);
        if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
        val d: *decl.Decl = d_opt.some;
        if (d.kind == decl.DECL_KIND_VAL && d.data.bind.init != id.EXPR_NIL) {
            split_literal_head(rc, d.data.bind.init);
            val r: err[fail.Fail] = register_constant_tag(rc, d.data.bind.name, d.data.bind.init);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun split_literal_head(rc: *ResolveContext, eid: id.ExprId) {
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel e_opt.some) { ret; }
    val e: *expr.Expr = e_opt.some;
    var tid: id.TypeId = id.TYPE_NIL;
    if (e.kind == expr.EXPR_KIND_STRUCT_LIT) { tid = e.data.struct_lit.ty; }
    if (e.kind == expr.EXPR_KIND_VECTOR_LIT) { tid = e.data.vector_lit.ty; }
    if (tid == id.TYPE_NIL) { ret; }
    val t_opt: opt[*atype.Type] = ast.get_type_typed(rc.a, tid);
    if (!sel t_opt.some) { ret; }
    val t: *atype.Type = t_opt.some;
    if (t.kind == atype.TYPE_KIND_NAMED && t.data.named.case_desc == id.EXPR_NIL && t.data.named.case_name.len == 0) {
        split_case_head(rc, ?t.data.named);
    }
}

fun init_context(
    rc:         *ResolveContext,
    s:          *session.Session,
    a:          *ast.Ast,
    deps:       *ResolveDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    terminal:   bool,
    diags:      *diagnostic.DiagnosticStore
) err[fail.Fail] {
    rc.status     = fail.accepted();
    rc.s          = s;
    rc.diags      = diags;
    rc.a          = a;
    rc.deps       = deps;
    rc.ctx        = ctx;
    val caps_r: res[comptime.PhaseCapabilities[ResolveContext], fail.Fail] =
        comptime.resolution_capabilities[ResolveContext](comptime_ident_is_runtime, comptime_expression, diags);
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    rc.caps       = caps_r.ok;
    rc.own_module = own_module;
    rc.terminal   = terminal;
    rc.in_gated_decl_scope = false;

    val src_opt: O.Option[*src.SourceFile] = src.get(?s.sources, a.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) {
        ret err[fail.Fail].err{fail.message("Ast.file_id not registered with the session")};
    }
    rc.source = O.unwrap[*src.SourceFile](src_opt).text;

    rc.symbols  = nil;
    rc.sym_len  = 0;
    rc.sym_cap  = 0;

    rc.expr_resolved = nil;
    rc.type_resolved = nil;
    rc.decl_symbol   = nil;

    rc.scopes        = nil;
    rc.scope_len     = 0;
    rc.scope_cap     = 0;
    rc.module_scope  = SCOPE_NIL;
    rc.current_scope = SCOPE_NIL;

    var pi: u32 = 0;
    for (pi < PRIM_COUNT) {
        rc.prim_names[pi] = intern.STR_NIL;
        rc.prim_syms[pi]  = SYMBOL_NIL;
        pi = pi + 1;
    }

    rc.imported_cache = map.init[ImportedKey, SymbolId](s.alloc, imported_hash, imported_equal);
    rc.vec_cache      = map.init[intern.StrId, SymbolId](s.alloc, map.hash_u32, map.eq_u32);
    rc.module_index   = map.init[intern.StrId, SymbolId](s.alloc, map.hash_u32, map.eq_u32);

    rc.expr_choices = nil;
    rc.expr_choices_count = 0;

    val sa: res[*Symbol, A.Error] = A.allocate[Symbol](s.alloc, INITIAL_SYMBOLS_CAP::usize);
    if (sel sa.err) { fail.internal(?rc.status, alloc.text(sa.err));
        dnit_context(rc);
        ret err[fail.Fail].err{fail.refused(sa.err)};
    }
    rc.symbols = sa.ok;
    rc.sym_cap = INITIAL_SYMBOLS_CAP;

    val sca: res[*Scope, A.Error] = A.allocate[Scope](s.alloc, INITIAL_SCOPES_CAP::usize);
    if (sel sca.err) { fail.internal(?rc.status, alloc.text(sca.err));
        dnit_context(rc);
        ret err[fail.Fail].err{fail.refused(sca.err)};
    }
    rc.scopes    = sca.ok;
    rc.scope_cap = INITIAL_SCOPES_CAP;

    if (a.expr_len > 0) {
        val r: res[*SymbolId, A.Error] = A.allocate[SymbolId](s.alloc, a.expr_len);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); dnit_context(rc); ret err[fail.Fail].err{fail.refused(r.err)}; }
        rc.expr_resolved = r.ok;
        memory.fill[SymbolId](rc.expr_resolved, SYMBOL_NIL, a.expr_len);
        val choices: res[*interpretation.Choice, A.Error] = A.allocate[interpretation.Choice](s.alloc, a.expr_len);
        if (sel choices.err) {
            fail.internal(?rc.status, alloc.text(choices.err));
            dnit_context(rc);
            ret err[fail.Fail].err{fail.refused(choices.err)};
        }
        rc.expr_choices = choices.ok;
        rc.expr_choices_count = a.expr_len;
        memory.fill[interpretation.Choice](rc.expr_choices, interpretation.PARSED, a.expr_len);
    }
    if (a.type_len > 0) {
        val r: res[*SymbolId, A.Error] = A.allocate[SymbolId](s.alloc, a.type_len);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); dnit_context(rc); ret err[fail.Fail].err{fail.refused(r.err)}; }
        rc.type_resolved = r.ok;
        memory.fill[SymbolId](rc.type_resolved, SYMBOL_NIL, a.type_len);
    }
    if (a.decl_len > 0) {
        val r: res[*SymbolId, A.Error] = A.allocate[SymbolId](s.alloc, a.decl_len);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); dnit_context(rc); ret err[fail.Fail].err{fail.refused(r.err)}; }
        rc.decl_symbol = r.ok;
        memory.fill[SymbolId](rc.decl_symbol, SYMBOL_NIL, a.decl_len);
    }

    ret err[fail.Fail].ok{};
}

fun dnit_context(rc: *ResolveContext) {
    var i: u32 = 0;
    for (i < rc.scope_len) {
        val sc: *Scope = ?rc.scopes[i];
        if (sc.entries != nil && sc.cap > 0) {
            A.deallocate[ScopeEntry](rc.s.alloc, sc.entries, sc.cap::usize);
        }
        i = i + 1;
    }
    if (rc.scopes != nil && rc.scope_cap > 0) {
        A.deallocate[Scope](rc.s.alloc, rc.scopes, rc.scope_cap::usize);
    }
    if (rc.symbols != nil && rc.sym_cap > 0) {
        A.deallocate[Symbol](rc.s.alloc, rc.symbols, rc.sym_cap::usize);
    }
    if (rc.expr_resolved != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.expr_resolved, rc.a.expr_len);
    }
    if (rc.type_resolved != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.type_resolved, rc.a.type_len);
    }
    if (rc.decl_symbol != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.decl_symbol, rc.a.decl_len);
    }
    if (rc.expr_choices != nil && rc.expr_choices_count != 0) {
        A.deallocate[interpretation.Choice](rc.s.alloc, rc.expr_choices, rc.expr_choices_count);
    }
    map.dnit[ImportedKey, SymbolId](?rc.imported_cache);
    map.dnit[intern.StrId, SymbolId](?rc.vec_cache);
    map.dnit[intern.StrId, SymbolId](?rc.module_index);
}

fun open_scope(rc: *ResolveContext, parent: ScopeId) res[ScopeId, fail.Fail] {
    if (rc.scope_len == rc.scope_cap) {
        val new_cap: u32 = rc.scope_cap * 2;
        val r: res[*Scope, A.Error] = A.reallocate[Scope](rc.s.alloc, rc.scopes, rc.scope_cap::usize, new_cap::usize);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err));
            ret res[ScopeId, fail.Fail].err{fail.refused(r.err)};
        }
        rc.scopes    = r.ok;
        rc.scope_cap = new_cap;
    }
    var sc: Scope;
    sc.parent  = parent;
    sc.entries = nil;
    sc.len     = 0;
    sc.cap     = 0;
    val sid: ScopeId = rc.scope_len;
    rc.scopes[rc.scope_len] = sc;
    rc.scope_len = rc.scope_len + 1;
    ret res[ScopeId, fail.Fail].ok{sid};
}

fun scope_add(rc: *ResolveContext, scope: ScopeId, name: intern.StrId, sym: SymbolId) err[fail.Fail] {
    val sc: *Scope = ?rc.scopes[scope];
    if (sc.entries == nil) {
        val r: res[*ScopeEntry, A.Error] = A.allocate[ScopeEntry](rc.s.alloc, INITIAL_SCOPE_ENTRY_CAP::usize);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret err[fail.Fail].err{fail.refused(r.err)}; }
        sc.entries = r.ok;
        sc.cap     = INITIAL_SCOPE_ENTRY_CAP;
    }
    or (sc.len == sc.cap) {
        val new_cap: u32 = sc.cap * 2;
        val r: res[*ScopeEntry, A.Error] = A.reallocate[ScopeEntry](rc.s.alloc, sc.entries, sc.cap::usize, new_cap::usize);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret err[fail.Fail].err{fail.refused(r.err)}; }
        sc.entries = r.ok;
        sc.cap     = new_cap;
    }
    var e: ScopeEntry;
    e.name = name;
    e.sym  = sym;
    sc.entries[sc.len] = e;
    sc.len = sc.len + 1;

    if (scope == rc.module_scope) {
        val ins: res[bool, A.Error] = map.insert[intern.StrId, SymbolId](?rc.module_index, name, sym);
        if (sel ins.err) { ret err[fail.Fail].err{fail.refused(ins.err)}; }
    }
    ret err[fail.Fail].ok{};
}

fun scope_lookup_local(rc: *ResolveContext, scope: ScopeId, name: intern.StrId) SymbolId {
    if (scope == SCOPE_NIL) { ret SYMBOL_NIL; }
    if (scope == rc.module_scope) {
        val g: opt[*SymbolId] = map.get[intern.StrId, SymbolId](?rc.module_index, ?name);
        if (sel g.some) { ret @g.some; }
        ret SYMBOL_NIL;
    }
    val sc: *Scope = ?rc.scopes[scope];
    var i: u32 = 0;
    for (i < sc.len) {
        if (sc.entries[i].name == name) { ret sc.entries[i].sym; }
        i = i + 1;
    }
    ret SYMBOL_NIL;
}

fun scope_lookup_chain(rc: *ResolveContext, scope: ScopeId, name: intern.StrId) SymbolId {
    var cur: ScopeId = scope;
    for (cur != SCOPE_NIL) {
        val found: SymbolId = scope_lookup_local(rc, cur, name);
        if (found != SYMBOL_NIL) { ret found; }
        cur = rc.scopes[cur].parent;
    }
    ret SYMBOL_NIL;
}

# the notice a declaration's own `#[deprecated]` decorator records; a malformed decorator is
# reported by type checking and records nothing here
pub fun declaration_deprecation(a: *ast.Ast, source: str, interner: *intern.Interner, did: id.DeclId) res[deprecation.Deprecation, fail.Fail] {
    val defining: opt[*decl.Decl] = ast.get_decl_typed(a, did);
    if (!sel defining.some) { ret res[deprecation.Deprecation, fail.Fail].ok{deprecation.none()}; }
    val d: *decl.Decl = defining.some;
    ret decorators_deprecation(a, source, interner, d.decorators_start, d.decorators_len);
}

pub fun decorators_deprecation(a: *ast.Ast, source: str, interner: *intern.Interner, start: u32, len: u32) res[deprecation.Deprecation, fail.Fail] {
    var notice: deprecation.Deprecation = deprecation.none();
    var i: u32 = 0;
    for (i < len) {
        val dec: *decl.Decorator = ?a.decorators[start + i];
        i = i + 1;
        if (!str_region_equals(source, dec.name.offset, dec.name.len, "deprecated")) { cnt; }
        if (dec.args_len > 1) { ret res[deprecation.Deprecation, fail.Fail].ok{notice}; }
        if (dec.args_len == 1) {
            val e: opt[*expr.Expr] = ast.get_expr_typed(a, a.expr_ids[dec.args_start]);
            if (!sel e.some) {
                ret res[deprecation.Deprecation, fail.Fail].ok{notice};
            }
            if (e.some.kind != expr.EXPR_KIND_LIT_STR) {
                ret res[deprecation.Deprecation, fail.Fail].ok{notice};
            }
            val decoded: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.eval_lit_str(source, e.some.span, interner);
            if (R.is_err[comptime.CTValue, comptime.EvalFail](decoded)) {
                val problem: comptime.EvalFail = R.unwrap_err[comptime.CTValue, comptime.EvalFail](decoded);
                if (problem.kind == comptime.EVAL_FAIL_INTERNAL) { ret res[deprecation.Deprecation, fail.Fail].err{fail.message(problem.message)}; }
                ret res[deprecation.Deprecation, fail.Fail].ok{notice};
            }
            notice.message = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](decoded).data.s;
        }
        notice.present = true;
        notice.owner = a.file_id;
        ret res[deprecation.Deprecation, fail.Fail].ok{notice};
    }
    ret res[deprecation.Deprecation, fail.Fail].ok{notice};
}

fun add_symbol(rc: *ResolveContext, kind: SymKind, flags: u8, name: intern.StrId, canon: intern.StrId, decl_id: id.DeclId, slot: u32, origin: session.ModuleId) res[SymbolId, fail.Fail] {
    if (rc.sym_len >= SYMBOL_REJECTED) {
        val message: str = "resolver symbol table exhausted";
        fail.internal(?rc.status, message);
        ret res[SymbolId, fail.Fail].err{fail.message(message)};
    }
    if (rc.sym_len == rc.sym_cap) {
        var new_cap: u32 = SYMBOL_REJECTED;
        if (rc.sym_cap <= SYMBOL_REJECTED / 2) { new_cap = rc.sym_cap * 2; }
        val r: res[*Symbol, A.Error] = A.reallocate[Symbol](rc.s.alloc, rc.symbols, rc.sym_cap::usize, new_cap::usize);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err));
            ret res[SymbolId, fail.Fail].err{fail.refused(r.err)};
        }
        rc.symbols = r.ok;
        rc.sym_cap = new_cap;
    }
    var sym: Symbol;
    sym.kind   = kind;
    sym.definition_kind = kind;
    sym.definition_file = src.FILE_NIL;
    sym.generic_arity = 0;
    sym.deprecation = deprecation.none();
    if (rc.a != nil && origin == rc.own_module && kind != SYM_PARAM && kind != SYM_GENERIC) {
        val notice: res[deprecation.Deprecation, fail.Fail] = declaration_deprecation(rc.a, rc.source, ?rc.s.interner, decl_id);
        if (sel notice.err) { ret res[SymbolId, fail.Fail].err{notice.err}; }
        sym.deprecation = notice.ok;
    }
    if (rc.a != nil && origin == rc.own_module) {
        sym.definition_file = rc.a.file_id;
        val defining: opt[*decl.Decl] = ast.get_decl_typed(rc.a, decl_id);
        if (sel defining.some) {
            val d: *decl.Decl = defining.some;
            if (d.kind == decl.DECL_KIND_FUN) {
                sym.generic_arity = d.data.fun_.generics_len;
                var pi: u32 = 0;
                for (pi < d.data.fun_.params_len) {
                    val parameter: *decl.TypedName = ?rc.a.typed_names[d.data.fun_.params_start + pi];
                    if (parameter.comptime) { sym.has_comptime_params = true; }
                    val pt: opt[*atype.Type] = ast.get_type_typed(rc.a, parameter.ty);
                    if (sel pt.some && pt.some.kind == atype.TYPE_KIND_PACK) { sym.has_pack_param = true; }
                    pi = pi + 1;
                }
            }
            or (d.kind == decl.DECL_KIND_REC) { sym.generic_arity = d.data.rec_.generics_len; }
            or (d.kind == decl.DECL_KIND_UNI) { sym.generic_arity = d.data.uni_.generics_len; }
            or (d.kind == decl.DECL_KIND_TAG) { sym.generic_arity = d.data.tag_.generics_len; }
        }
    }
    sym.flags  = flags;
    sym.name   = name;
    sym.canon  = canon;
    sym.decl   = decl_id;
    sym.slot   = slot;
    sym.origin = origin;
    sym.origin_stable = session.STABLE_MODULE_NIL;
    sym.slot_stable   = session.STABLE_MODULE_NIL;
    val sid: SymbolId = rc.sym_len;
    rc.symbols[rc.sym_len] = sym;
    rc.sym_len = rc.sym_len + 1;
    ret res[SymbolId, fail.Fail].ok{sid};
}

fun declare(
    rc:      *ResolveContext,
    kind:    SymKind,
    flags:   u8,
    name:    token.Span,
    decl_id: id.DeclId,
    slot:    u32,
    origin:  session.ModuleId,
    scope:   ScopeId
) res[SymbolId, fail.Fail] {
    if (name.len == 0) {
        ret res[SymbolId, fail.Fail].ok{SYMBOL_NIL};
    }
    val r_id: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, name);
    if (sel r_id.err) { fail.internal(?rc.status, alloc.text(r_id.err));
        ret res[SymbolId, fail.Fail].err{fail.refused(r_id.err)};
    }
    val name_id: intern.StrId = r_id.ok;

    val existing: SymbolId = scope_lookup_local(rc, scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: err[fail.Fail] = report_named(rc, name, "duplicate definition: `", name_id, "` is already bound in this scope");
        if (sel de.ok) {
            report_prior_binding(rc, existing);
        }
        ret res[SymbolId, fail.Fail].ok{SYMBOL_NIL};
    }

    val r_sym: res[SymbolId, fail.Fail] = add_symbol(rc, kind, flags, name_id, name_id, decl_id, slot, origin);
    if (sel r_sym.err) { fail.internal(?rc.status, fail.describe(r_sym.err)); ret r_sym; }
    val sid: SymbolId = r_sym.ok;

    val r_add: err[fail.Fail] = scope_add(rc, scope, name_id, sid);
    if (sel r_add.err) {
        ret res[SymbolId, fail.Fail].err{r_add.err};
    }

    ret res[SymbolId, fail.Fail].ok{sid};
}

fun report_prior_binding(rc: *ResolveContext, prior: SymbolId) {
    val id_r: R.Result[diagnostic.DiagnosticId, str] = diagnostic.last_id(rc.diags);
    if (R.is_err[diagnostic.DiagnosticId, str](id_r)) { ret; }
    val did: diagnostic.DiagnosticId = R.unwrap_ok[diagnostic.DiagnosticId, str](id_r);

    if (rc.symbols[prior].origin == rc.own_module && rc.symbols[prior].decl != id.DECL_NIL) {
        val prev: token.Span = prior_name_span(rc, rc.symbols[prior].decl);
        if (prev.len != 0) {
            diagnostic.record_related_committed(rc.diags, did, rc.a.file_id, prev, "previous definition here");
            ret;
        }
    }
    diagnostic.record_note_committed(rc.diags, did, "a name with this spelling is already bound here");
}

fun prior_name_span(rc: *ResolveContext, decl_id: id.DeclId) token.Span {
    val span: token.Span = ast.decl_name_span(rc.a, decl_id);
    if (span.len != 0) { ret span; }

    val opt_d: opt[*decl.Decl] = ast.get_decl_typed(rc.a, decl_id);
    if (!sel opt_d.some) { ret span; }
    val d: *decl.Decl = opt_d.some;

    if (d.kind == decl.DECL_KIND_USE) { ret leaf_span(rc, d.data.use_.path); }
    if (d.kind == decl.DECL_KIND_FWD) { ret leaf_span(rc, d.data.fwd_.path); }
    ret span;
}

fun seed_primitives(rc: *ResolveContext) err[fail.Fail] {
    var k: u32 = 0;
    for (k < PRIM_COUNT) {
        val r: err[fail.Fail] = seed_one_primitive(rc, k, type.prim_name(k::u8), k);
        if (sel r.err) { ret r; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun seed_one_primitive(rc: *ResolveContext, index: u32, name: str, kind_ordinal: u32) err[fail.Fail] {
    val r_id: res[intern.StrId, A.Error] = intern.intern_typed(?rc.s.interner, name);
    if (sel r_id.err) { fail.internal(?rc.status, alloc.text(r_id.err)); ret err[fail.Fail].err{fail.refused(r_id.err)}; }
    val name_id: intern.StrId = r_id.ok;

    val r_sym: res[SymbolId, fail.Fail] = add_symbol(rc, SYM_PRIM, 0, name_id, name_id, id.DECL_NIL, kind_ordinal, rc.own_module);
    if (sel r_sym.err) { fail.internal(?rc.status, fail.describe(r_sym.err)); ret err[fail.Fail].err{r_sym.err}; }
    val sid: SymbolId = r_sym.ok;

    rc.prim_names[index] = name_id;
    rc.prim_syms[index]  = sid;
    ret err[fail.Fail].ok{};
}

pub def TypeSpellStatus: u8;

pub val TYPE_SPELL_NONE:        TypeSpellStatus = 0;
pub val TYPE_SPELL_FOUND:       TypeSpellStatus = 1;
pub val TYPE_SPELL_VEC_REFUSED: TypeSpellStatus = 2;

rec TypeSpelling {
    status: TypeSpellStatus;
    sym:    SymbolId;
    form:   type.VecForm;
}

fun type_spelling(rc: *ResolveContext, name: intern.StrId) res[TypeSpelling, fail.Fail] {
    var out: TypeSpelling;
    out.status = TYPE_SPELL_NONE;
    out.sym    = SYMBOL_NIL;

    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (rc.prim_names[i] == name) {
            out.status = TYPE_SPELL_FOUND;
            out.sym    = rc.prim_syms[i];
            ret res[TypeSpelling, fail.Fail].ok{out};
        }
        i = i + 1;
    }

    val cached: opt[*SymbolId] = map.get[intern.StrId, SymbolId](?rc.vec_cache, ?name);
    if (sel cached.some) {
        out.status = TYPE_SPELL_FOUND;
        out.sym    = @cached.some;
        ret res[TypeSpelling, fail.Fail].ok{out};
    }

    val no: opt[str] = intern.lookup_typed(?rc.s.interner, name);
    if (!sel no.some) { ret res[TypeSpelling, fail.Fail].ok{out}; }

    val form: type.VecForm = type.vector_form(no.some);
    out.form = form;
    if (form.status == type.VEC_FORM_NONE) { ret res[TypeSpelling, fail.Fail].ok{out}; }
    if (form.status != type.VEC_FORM_OK) {
        out.status = TYPE_SPELL_VEC_REFUSED;
        ret res[TypeSpelling, fail.Fail].ok{out};
    }

    val r_tid: res[type.TypeId, fail.Fail] = type.intern_vector_typed(?rc.s.types, form.element, form.lanes);
    if (sel r_tid.err) { fail.internal(?rc.status, fail.describe(r_tid.err)); ret res[TypeSpelling, fail.Fail].err{r_tid.err}; }
    val vtid: type.TypeId = r_tid.ok;

    val r_sym: res[SymbolId, fail.Fail] = add_symbol(rc, SYM_VECTOR, 0, name, name, id.DECL_NIL, vtid::u32, rc.own_module);
    if (sel r_sym.err) { fail.internal(?rc.status, fail.describe(r_sym.err)); ret res[TypeSpelling, fail.Fail].err{r_sym.err}; }
    val sid: SymbolId = r_sym.ok;

    val ins: res[bool, A.Error] = map.insert[intern.StrId, SymbolId](?rc.vec_cache, name, sid);
    if (sel ins.err) { ret res[TypeSpelling, fail.Fail].err{fail.refused(ins.err)}; }

    out.status = TYPE_SPELL_FOUND;
    out.sym    = sid;
    ret res[TypeSpelling, fail.Fail].ok{out};
}

fun report_vector_refused(rc: *ResolveContext, span: token.Span, name: intern.StrId,
                          form: type.VecForm) err[fail.Fail] {
    val no: opt[str] = intern.lookup_typed(?rc.s.interner, name);
    if (!sel no.some) { ret err[fail.Fail].ok{}; }
    val spelling: str = no.some;

    var rm: res[str, format.FormatError];
    if (form.status == type.VEC_FORM_TOO_WIDE) {
        rm = format.sprint(rc.s.alloc,
            "vector `{}` has more than {} lanes, which the compiler cannot represent",
            spelling, type.MAX_VEC_LANES);
    } or {
        rm = format.sprint(rc.s.alloc, "vector `{}` needs at least 2 lanes", spelling);
    }
    if (sel rm.err) { fail.internal(?rc.status, fail.describe(fail.format_refused(rm.err))); ret err[fail.Fail].err{fail.format_refused(rm.err)}; }
    val msg: str = rm.ok;

    val emit: err[fail.Fail] = report(rc, span, msg);
    A.deallocate[char](rc.s.alloc, msg::*char, str_len(msg) + 1);
    ret emit;
}

fun collect_decl_list(rc: *ResolveContext, start: u32, len: u32, scope: ScopeId, at_module_scope: bool) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val decl_id: id.DeclId = rc.a.decl_ids[start + i];
        val r: err[fail.Fail] = collect_one_decl(rc, decl_id, scope, at_module_scope);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun collect_one_decl(rc: *ResolveContext, decl_id: id.DeclId, scope: ScopeId, at_module_scope: bool) err[fail.Fail] {
    val d_opt: opt[*decl.Decl] = ast.get_decl_typed(rc.a, decl_id);
    if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *decl.Decl = d_opt.some;
    val flags_in: u8 = d.flags;

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret collect_comptime_if(rc, ?d.data.comptime_if, scope, at_module_scope, true);
    }
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) {
        ret err[fail.Fail].ok{};
    }
    if (d.kind == decl.DECL_KIND_TEST || d.kind == decl.DECL_KIND_ERROR) {
        ret err[fail.Fail].ok{};
    }

    if (d.kind == decl.DECL_KIND_FWD) {
        ret collect_fwd(rc, decl_id, ?d.data.fwd_, d.flags);
    }

    val sym_flags: u8 = symbol_flags_from(flags_in, at_module_scope);

    if (d.kind == decl.DECL_KIND_USE) {
        ret collect_use(rc, decl_id, ?d.data.use_, scope);
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        ret declare_decl(rc, SYM_FUN, sym_flags, d.data.fun_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_REC) {
        ret declare_decl(rc, SYM_REC, sym_flags, d.data.rec_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_UNI) {
        ret declare_decl(rc, SYM_UNI, sym_flags, d.data.uni_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_TAG) {
        ret declare_decl(rc, SYM_TAG, sym_flags, d.data.tag_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_DEF) {
        ret declare_decl(rc, SYM_DEF, sym_flags, d.data.def_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_VAL) {
        val r: err[fail.Fail] = declare_decl(rc, SYM_VAL, sym_flags, d.data.bind.name, decl_id, scope);
        if (sel r.err) { ret r; }
        if (d.data.bind.init != id.EXPR_NIL) {
            val rcr: err[fail.Fail] =
                try_register_comptime_const(rc, d.data.bind.name, d.data.bind.ty, d.data.bind.init);
            if (sel rcr.err) { ret rcr; }
        }
        ret err[fail.Fail].ok{};
    }
    if (d.kind == decl.DECL_KIND_VAR) {
        ret declare_decl(rc, SYM_VAR, sym_flags, d.data.bind.name, decl_id, scope);
    }
    ret unknown_kind(rc, "DeclKind", d.kind::u32);
}

fun declare_decl(rc: *ResolveContext, kind: SymKind, flags: u8, name_span: token.Span, decl_id: id.DeclId, scope: ScopeId) err[fail.Fail] {
    val rn: err[fail.Fail] = reject_vector_spelled_type(rc, kind, name_span);
    if (sel rn.err) { ret rn; }

    val r: res[SymbolId, fail.Fail] = declare(rc, kind, flags, name_span, decl_id, 0, rc.own_module, scope);
    if (sel r.err) { fail.internal(?rc.status, fail.describe(r.err)); ret err[fail.Fail].err{r.err}; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = r.ok;
    }
    ret err[fail.Fail].ok{};
}

fun reject_vector_spelled_type(rc: *ResolveContext, kind: SymKind, name_span: token.Span) err[fail.Fail] {
    if (kind != SYM_REC && kind != SYM_UNI && kind != SYM_TAG && kind != SYM_DEF) { ret err[fail.Fail].ok{}; }
    if (name_span.len == 0) { ret err[fail.Fail].ok{}; }

    val r_id: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, name_span);
    if (sel r_id.err) { fail.internal(?rc.status, alloc.text(r_id.err)); ret err[fail.Fail].ok{}; }
    val name_id: intern.StrId = r_id.ok;

    val no: opt[str] = intern.lookup_typed(?rc.s.interner, name_id);
    if (!sel no.some) { ret err[fail.Fail].ok{}; }
    val spelling: str = no.some;

    if (!type.is_vector_spelling(spelling)) { ret err[fail.Fail].ok{}; }

    val rm: res[str, format.FormatError] = format.sprint(rc.s.alloc,
        "`{}` is spelled as a vector type `<element>x<lanes>`, so it cannot also name a type; the declaration would be unreachable",
        spelling);
    if (sel rm.err) { fail.internal(?rc.status, fail.describe(fail.format_refused(rm.err))); ret err[fail.Fail].err{fail.format_refused(rm.err)}; }
    val msg: str = rm.ok;

    val emit: err[fail.Fail] = report(rc, name_span, msg);
    A.deallocate[char](rc.s.alloc, msg::*char, str_len(msg) + 1);
    if (sel emit.err) { ret emit; }
    ret err[fail.Fail].ok{};
}

fun symbol_flags_from(decl_flags: u8, at_module_scope: bool) u8 {
    if (!at_module_scope) { ret 0; }
    var f: u8 = SYM_FLAG_MODULE;
    if ((decl_flags & decl.DECL_FLAG_PUB) != 0) { f = f | SYM_FLAG_PUB; }
    ret f;
}

fun try_register_comptime_const(rc: *ResolveContext, name_span: token.Span, ty: id.TypeId,
                                init_expr: id.ExprId) err[fail.Fail] {
    if (name_span.len == 0) { ret err[fail.Fail].ok{}; }
    val r_id: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, name_span);
    if (sel r_id.err) { fail.internal(?rc.status, alloc.text(r_id.err)); ret err[fail.Fail].ok{}; }
    val name_id: intern.StrId = r_id.ok;

    val bound: opt[comptime.NamedConst] = comptime.lookup_typed(rc.ctx, name_id);
    if (sel bound.some) { ret err[fail.Fail].ok{}; }

    val fw: float.FloatWidth = comptime.declared_float_width(rc.a, rc.source, ty);
    val r_val: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate_at_float_width[ResolveContext](rc.ctx, rc, rc.caps, rc.a, rc.source, init_expr, ?rc.s.interner, fw);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](r_val)) { ret err[fail.Fail].ok{}; }
    val v: comptime.CTValue = comptime.apply_declared_int_type(rc.a, rc.source, ty,
        R.unwrap_ok[comptime.CTValue, comptime.EvalFail](r_val));
    if (comptime.float_width_unread(v)) { ret err[fail.Fail].ok{}; }

    ret comptime.bind_gated_typed(rc.ctx, name_id, v, rc.in_gated_decl_scope);
}

# a module `val` constructed as a case literal is a constant tag: a constant element over its own
# literal, bound once the literal's head has been split into type and case, and rebound with its
# declared type by type checking. it points into this syntax tree and is never exported
fun register_constant_tag(rc: *ResolveContext, name_span: token.Span, init_expr: id.ExprId) err[fail.Fail] {
    if (name_span.len == 0 || !comptime.is_case_literal(rc.a, init_expr)) { ret err[fail.Fail].ok{}; }
    val r_id: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, name_span);
    if (sel r_id.err) { fail.internal(?rc.status, alloc.text(r_id.err)); ret err[fail.Fail].ok{}; }
    val name_id: intern.StrId = r_id.ok;
    val bound: opt[comptime.NamedConst] = comptime.lookup_typed(rc.ctx, name_id);
    if (sel bound.some) { ret err[fail.Fail].ok{}; }
    ret comptime.bind_typed(rc.ctx, name_id, comptime.const_elem_untyped(init_expr::u32));
}

fun collect_comptime_if(rc: *ResolveContext, ci: *decl.DeclComptimeIf, scope: ScopeId, at_module_scope: bool, at_decl_scope: bool) err[fail.Fail] {
    if (at_decl_scope && comptime.comptime_if_declares_nothing(rc.a, ci.branches_start, ci.branches_len)) {
        ret err[fail.Fail].ok{};
    }
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?rc.a.comptime_branches[ci.branches_start + bi];
        val take_r: res[comptime.GateOutcome, fail.Fail] = comptime_branch_active(rc, br, at_decl_scope);
        if (sel take_r.err) {
            ret err[fail.Fail].err{take_r.err};
        }
        val outcome: comptime.GateOutcome = take_r.ok;
        if (outcome == comptime.GATE_DEFERRED || outcome == comptime.GATE_REJECTED || outcome == comptime.GATE_FAILED) {
            ret err[fail.Fail].ok{};
        }
        if (outcome == comptime.GATE_ACTIVE) {
            if (at_decl_scope) {
                val saved_gated: bool = rc.in_gated_decl_scope;
                rc.in_gated_decl_scope = true;
                val r: err[fail.Fail] = collect_decl_list(rc, br.body_start, br.body_len, scope, at_module_scope);
                rc.in_gated_decl_scope = saved_gated;
                ret r;
            }
            ret err[fail.Fail].ok{};
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun comptime_branch_active(rc: *ResolveContext, br: *decl.ComptimeBranch, at_decl_scope: bool) res[comptime.GateOutcome, fail.Fail] {
    var scope: comptime.GateScope = comptime.GATE_SCOPE_INSTANCE;
    if (at_decl_scope) { scope = comptime.GATE_SCOPE_DECL; }
    val vr: res[comptime.GateVerdict, fail.Fail] = comptime.evaluate_gate_typed[ResolveContext](
        rc.ctx, rc, rc.caps, rc.a, rc.source, br.cond, ?rc.s.interner, scope, at_decl_scope, rc.terminal);
    if (sel vr.err) {
        ret res[comptime.GateOutcome, fail.Fail].err{vr.err};
    }
    ret render_gate_verdict(rc, vr.ok);
}

fun render_gate_verdict(rc: *ResolveContext, v: comptime.GateVerdict) res[comptime.GateOutcome, fail.Fail] {
    if (v.outcome == comptime.GATE_ACTIVE || v.outcome == comptime.GATE_INACTIVE) {
        ret res[comptime.GateOutcome, fail.Fail].ok{v.outcome};
    }
    if (v.outcome == comptime.GATE_AWAITING_PHASE || v.outcome == comptime.GATE_AWAITING_TYPES
     || v.outcome == comptime.GATE_DEFERRED) {
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_DEFERRED};
    }
    if (v.outcome == comptime.GATE_REJECTED) {
        val e: err[fail.Fail] = emit_gate_message(rc, v);
        if (sel e.err) { ret res[comptime.GateOutcome, fail.Fail].err{e.err}; }
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_REJECTED};
    }
    if (v.outcome == comptime.GATE_AWAITING_LAYOUT) {
        val e: err[fail.Fail] = emit_gate_message(rc, v);
        if (sel e.err) { ret res[comptime.GateOutcome, fail.Fail].err{e.err}; }
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_FAILED};
    }
    if (v.outcome == comptime.GATE_FAILED) {
        if (v.depends != intern.STR_NIL) {
            fail.reject(?rc.status);
            val committed_r: R.Result[bool, str] = diagnostic.gate_error_named(rc.diags,
                ?rc.s.interner, rc.a.file_id, v.span, v.depends, v.message);
            if (R.is_err[bool, str](committed_r)) { ret res[comptime.GateOutcome, fail.Fail].err{fail.message(R.unwrap_err[bool, str](committed_r))}; }
            ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_FAILED};
        }
        val e: err[fail.Fail] = emit_gate_message(rc, v);
        if (sel e.err) { ret res[comptime.GateOutcome, fail.Fail].err{e.err}; }
        ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_FAILED};
    }
    ret res[comptime.GateOutcome, fail.Fail].ok{comptime.GATE_DEFERRED};
}

fun emit_gate_message(rc: *ResolveContext, v: comptime.GateVerdict) err[fail.Fail] {
    fail.reject(?rc.status);
    if (str_len(v.message) == 0) { ret err[fail.Fail].ok{}; }
    val committed: res[bool, fail.Fail] = fail.lift_res[bool](diagnostic.gate_error(rc.diags, ?rc.s.interner, rc.a.file_id, v.span, v.message));
    if (sel committed.err) { ret err[fail.Fail].err{committed.err}; }
    ret err[fail.Fail].ok{};
}

fun collect_use(rc: *ResolveContext, decl_id: id.DeclId, du: *decl.DeclUse, scope: ScopeId) err[fail.Fail] {
    if (du.path.len == 0) {
        ret err[fail.Fail].ok{};
    }

    val r_path: res[intern.StrId, A.Error] = np.intern_path_typed(?rc.s.interner, rc.source, du.path);
    if (sel r_path.err) { fail.internal(?rc.status, alloc.text(r_path.err));
        ret err[fail.Fail].err{fail.refused(r_path.err)};
    }
    val path_id: intern.StrId = r_path.ok;

    val mx: *ModuleExports = find_module_exports(rc, path_id);
    if (mx != nil) {
        var alias_span: token.Span = du.alias;
        if (alias_span.len == 0) {
            alias_span = leaf_span(rc, du.path);
        }
        val r: res[SymbolId, fail.Fail] = declare(rc, SYM_USE, 0, alias_span, decl_id, mx.module::u32, rc.own_module, scope);
        if (sel r.err) { fail.internal(?rc.status, fail.describe(r.err)); ret err[fail.Fail].err{r.err}; }
        if (rc.decl_symbol != nil) {
            rc.decl_symbol[decl_id] = r.ok;
        }
        ret err[fail.Fail].ok{};
    }

    val leaf: token.Span = leaf_span(rc, du.path);
    val prefix: token.Span = prefix_span(rc, du.path);
    if (prefix.len == 0 || leaf.len == 0) {
        record_report(rc, du.path, "imported module is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    val pmx: *ModuleExports = find_module_exports_span(rc, prefix);
    if (pmx == nil) {
        record_report(rc, du.path, "imported module is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    val r_leaf: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, leaf);
    if (sel r_leaf.err) { fail.internal(?rc.status, alloc.text(r_leaf.err));
        ret err[fail.Fail].err{fail.refused(r_leaf.err)};
    }
    val leaf_id: intern.StrId = r_leaf.ok;

    val ps: *PublicSymbol = find_export(pmx, leaf_id);
    if (ps == nil) {
        report_named2(rc, du.path, "`", leaf_id, "` is not exported by `", pmx.path, "`");
        ret err[fail.Fail].ok{};
    }

    var bind_span: token.Span = du.alias;
    if (bind_span.len == 0) {
        bind_span = leaf;
    }
    ret bind_imported_symbol(rc, decl_id, bind_span, ps, scope);
}

fun bind_imported_symbol(rc: *ResolveContext, decl_id: id.DeclId, bind_span: token.Span, ps: *PublicSymbol, scope: ScopeId) err[fail.Fail] {
    if (bind_span.len == 0) { ret err[fail.Fail].ok{}; }
    val r_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, bind_span);
    if (sel r_name.err) { fail.internal(?rc.status, alloc.text(r_name.err));
        ret err[fail.Fail].err{fail.refused(r_name.err)};
    }
    val name_id: intern.StrId = r_name.ok;

    val existing: SymbolId = scope_lookup_local(rc, scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: err[fail.Fail] = report_named(rc, bind_span, "imported name `", name_id, "` is already defined in this scope");
        if (sel de.ok) {
            report_prior_binding(rc, existing);
        }
        ret err[fail.Fail].ok{};
    }

    var imported: PublicSymbol = @ps;
    val notice: res[deprecation.Deprecation, fail.Fail] = declaration_deprecation(rc.a, rc.source, ?rc.s.interner, decl_id);
    if (sel notice.err) { ret err[fail.Fail].err{notice.err}; }
    if (notice.ok.present) { imported.deprecation = notice.ok; }
    val sid_r: res[SymbolId, fail.Fail] = imported_symbol_for(rc, ?imported);
    if (sel sid_r.err) { fail.internal(?rc.status, fail.describe(sid_r.err)); ret err[fail.Fail].err{sid_r.err}; }
    val sid: SymbolId = sid_r.ok;

    val r_add: err[fail.Fail] = scope_add(rc, scope, name_id, sid);
    if (sel r_add.err) { ret r_add; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = sid;
    }
    ret err[fail.Fail].ok{};
}

fun imported_symbol_for(rc: *ResolveContext, ps: *PublicSymbol) res[SymbolId, fail.Fail] {
    val key: ImportedKey = ImportedKey{ origin: ps.origin, canon: ps.canon, notice: ps.deprecation };
    val cached: opt[*SymbolId] = map.get[ImportedKey, SymbolId](?rc.imported_cache, ?key);
    if (sel cached.some) {
        ret res[SymbolId, fail.Fail].ok{@cached.some};
    }
    var kind: SymKind = SYM_IMPORTED;
    var slot: u32     = 0;
    if (ps.kind == SYM_USE) {
        kind = SYM_USE;
        slot = ps.slot;
    }
    val r: res[SymbolId, fail.Fail] = add_symbol(rc, kind, 0, ps.name, ps.canon, id.DECL_NIL, slot, ps.origin);
    if (sel r.err) { fail.internal(?rc.status, fail.describe(r.err)); ret r; }
    val sid: SymbolId = r.ok;
    rc.symbols[sid].definition_kind = ps.kind;
    rc.symbols[sid].definition_file = ps.file;
    rc.symbols[sid].generic_arity = ps.generic_arity;
    rc.symbols[sid].has_comptime_params = ps.has_comptime_params;
    rc.symbols[sid].has_pack_param = ps.has_pack_param;
    rc.symbols[sid].deprecation = ps.deprecation;
    val ins: res[bool, A.Error] = map.insert[ImportedKey, SymbolId](?rc.imported_cache, key, sid);
    if (sel ins.err) { ret res[SymbolId, fail.Fail].err{fail.refused(ins.err)}; }
    ret res[SymbolId, fail.Fail].ok{sid};
}

fun leaf_span(rc: *ResolveContext, path: token.Span) token.Span {
    ret np.leaf(rc.source, path);
}

fun prefix_span(rc: *ResolveContext, path: token.Span) token.Span {
    ret np.prefix(rc.source, path);
}

fun find_module_exports(rc: *ResolveContext, path: intern.StrId) *ModuleExports {
    var i: u32 = 0;
    for (i < rc.deps.count) {
        val mx: *ModuleExports = ?rc.deps.entries[i];
        if (mx.path == path) { ret mx; }
        i = i + 1;
    }
    ret nil;
}

fun find_module_exports_by_module(rc: *ResolveContext, mid: session.ModuleId) *ModuleExports {
    var i: u32 = 0;
    for (i < rc.deps.count) {
        val mx: *ModuleExports = ?rc.deps.entries[i];
        if (mx.module == mid) { ret mx; }
        i = i + 1;
    }
    ret nil;
}

fun bind_member_qualified(rc: *ResolveContext, eid: id.ExprId, member: *expr.ExprMember) err[fail.Fail] {
    if (rc.expr_resolved == nil) { ret err[fail.Fail].ok{}; }

    val obj_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, member.object);
    if (!sel obj_opt.some) { ret err[fail.Fail].ok{}; }

    val osid: SymbolId = rc.expr_resolved[member.object];
    if (osid == SYMBOL_NIL || osid >= rc.sym_len) { ret err[fail.Fail].ok{}; }
    val osym: *Symbol = ?rc.symbols[osid];
    if (osym.kind != SYM_USE) { ret err[fail.Fail].ok{}; }

    val target: session.ModuleId = osym.slot::session.ModuleId;
    val mx: *ModuleExports = find_module_exports_by_module(rc, target);
    if (mx == nil) {
        record_report(rc, member.name, "module alias names a module that is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    val r_leaf: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, member.name);
    if (sel r_leaf.err) { fail.internal(?rc.status, alloc.text(r_leaf.err)); ret err[fail.Fail].err{fail.refused(r_leaf.err)}; }
    val leaf_id: intern.StrId = r_leaf.ok;

    val ps: *PublicSymbol = find_export(mx, leaf_id);
    if (ps == nil) {
        report_named2(rc, member.name, "no symbol `", leaf_id, "` exported by `", mx.path, "`");
        ret err[fail.Fail].ok{};
    }

    val r_sym: res[SymbolId, fail.Fail] = imported_symbol_for(rc, ps);
    if (sel r_sym.err) { fail.internal(?rc.status, fail.describe(r_sym.err)); ret err[fail.Fail].err{r_sym.err}; }
    rc.expr_resolved[eid] = r_sym.ok;
    ret err[fail.Fail].ok{};
}

fun find_module_exports_span(rc: *ResolveContext, span: token.Span) *ModuleExports {
    val r: res[intern.StrId, A.Error] = np.intern_path_typed(?rc.s.interner, rc.source, span);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret nil; }
    ret find_module_exports(rc, r.ok);
}

fun resolve_prefix_module(rc: *ResolveContext, prefix: token.Span) *ModuleExports {
    val r: res[intern.StrId, A.Error] = np.intern_path_typed(?rc.s.interner, rc.source, prefix);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret nil; }
    val prefix_id: intern.StrId = r.ok;

    val sid: SymbolId = scope_lookup_chain(rc, rc.module_scope, prefix_id);
    if (sid != SYMBOL_NIL && sid < rc.sym_len) {
        val sym: *Symbol = ?rc.symbols[sid];
        if (sym.kind == SYM_USE) {
            ret find_module_exports_by_module(rc, sym.slot::session.ModuleId);
        }
    }
    ret find_module_exports(rc, prefix_id);
}

fun find_export(mx: *ModuleExports, name: intern.StrId) *PublicSymbol {
    var i: u32 = 0;
    for (i < mx.count) {
        val ps: *PublicSymbol = ?mx.symbols[i];
        if (ps.name == name) { ret ps; }
        i = i + 1;
    }
    ret nil;
}

fun bind_decl_list(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val decl_id: id.DeclId = rc.a.decl_ids[start + i];
        val r: err[fail.Fail] = bind_one_decl(rc, decl_id);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_decorator_args(rc: *ResolveContext, d: *decl.Decl) err[fail.Fail] {
    var k: u32 = 0;
    for (k < d.decorators_len) {
        val dec: *decl.Decorator = ?rc.a.decorators[d.decorators_start + k];
        var j: u32 = 0;
        for (j < dec.args_len) {
            val r: err[fail.Fail] = bind_expr(rc, rc.a.expr_ids[dec.args_start + j]);
            if (sel r.err) { ret r; }
            j = j + 1;
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_one_decl(rc: *ResolveContext, decl_id: id.DeclId) err[fail.Fail] {
    val d_opt: opt[*decl.Decl] = ast.get_decl_typed(rc.a, decl_id);
    if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *decl.Decl = d_opt.some;

    val rda: err[fail.Fail] = bind_decorator_args(rc, d);
    if (sel rda.err) { ret rda; }

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
        ret bind_comptime_if(rc, ci.branches_start, ci.branches_len, true);
    }
    if (d.kind == decl.DECL_KIND_USE || d.kind == decl.DECL_KIND_ERROR || d.kind == decl.DECL_KIND_FWD) {
        ret err[fail.Fail].ok{};
    }
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) {
        ret err[fail.Fail].ok{};
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        ret bind_fun(rc, ?d.data.fun_, decl_id);
    }
    if (d.kind == decl.DECL_KIND_REC) {
        ret bind_rec(rc, ?d.data.rec_, decl_id);
    }
    if (d.kind == decl.DECL_KIND_UNI) {
        ret bind_uni(rc, ?d.data.uni_, decl_id);
    }
    if (d.kind == decl.DECL_KIND_TAG) {
        val t: *decl.DeclTag = ?d.data.tag_;
        val rd: err[fail.Fail] = bind_type(rc, t.disc);
        if (sel rd.err) { ret rd; }
        ret bind_aggregate(rc, t.generics_start, t.generics_len, t.cases_start, t.cases_len, decl_id, true);
    }
    if (d.kind == decl.DECL_KIND_DEF) {
        ret bind_type(rc, d.data.def_.ty);
    }
    if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
        if (d.data.bind.ty != id.TYPE_NIL) {
            val r: err[fail.Fail] = bind_type(rc, d.data.bind.ty);
            if (sel r.err) { ret r; }
        }
        if (d.data.bind.init != id.EXPR_NIL) {
            val ri: err[fail.Fail] = bind_expr(rc, d.data.bind.init);
            if (sel ri.err) { ret ri; }
            if (d.kind == decl.DECL_KIND_VAL) { ret register_constant_tag(rc, d.data.bind.name, d.data.bind.init); }
        }
        ret err[fail.Fail].ok{};
    }
    if (d.kind == decl.DECL_KIND_TEST) {
        if (d.data.test_.body != id.STMT_NIL) {
            ret bind_stmt(rc, d.data.test_.body);
        }
        ret err[fail.Fail].ok{};
    }
    ret unknown_kind(rc, "DeclKind", d.kind::u32);
}

fun collect_fwd(rc: *ResolveContext, decl_id: id.DeclId, df: *decl.DeclFwd, flags: u8) err[fail.Fail] {
    if ((flags & decl.DECL_FLAG_PUB) != 0) {
        record_report(rc, df.path, "`fwd` always re-exports; `pub fwd` is not allowed");
        ret err[fail.Fail].ok{};
    }
    if (df.path.len == 0) {
        ret err[fail.Fail].ok{};
    }

    val r_full: res[intern.StrId, A.Error] = np.intern_path_typed(?rc.s.interner, rc.source, df.path);
    if (sel r_full.err) { fail.internal(?rc.status, alloc.text(r_full.err));
        ret err[fail.Fail].err{fail.refused(r_full.err)};
    }
    val full_id: intern.StrId = r_full.ok;
    val full_mx: *ModuleExports = find_module_exports(rc, full_id);
    if (full_mx != nil) {
        ret collect_fwd_module(rc, decl_id, df, full_mx.module);
    }

    val leaf: token.Span = leaf_span(rc, df.path);
    val prefix: token.Span = prefix_span(rc, df.path);
    if (prefix.len == 0 || leaf.len == 0) {
        record_report(rc, df.path, "`fwd` path must name a symbol of a module");
        ret err[fail.Fail].ok{};
    }

    val pmx: *ModuleExports = resolve_prefix_module(rc, prefix);
    if (pmx == nil) {
        record_report(rc, df.path, "re-exported module is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    val r_leaf: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, leaf);
    if (sel r_leaf.err) { fail.internal(?rc.status, alloc.text(r_leaf.err));
        ret err[fail.Fail].err{fail.refused(r_leaf.err)};
    }
    val leaf_id: intern.StrId = r_leaf.ok;

    val ps: *PublicSymbol = find_export(pmx, leaf_id);
    if (ps == nil) {
        record_report(rc, df.path, "re-exported symbol is not exported by its module");
        ret err[fail.Fail].ok{};
    }

    var bind_span: token.Span = df.alias;
    if (bind_span.len == 0) {
        bind_span = leaf;
    }

    val r_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, bind_span);
    if (sel r_name.err) { fail.internal(?rc.status, alloc.text(r_name.err));
        ret err[fail.Fail].err{fail.refused(r_name.err)};
    }
    val name_id: intern.StrId = r_name.ok;

    val existing: SymbolId = scope_lookup_local(rc, rc.module_scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: err[fail.Fail] = report_named(rc, bind_span, "re-exported name `", name_id, "` is already defined in this scope");
        if (sel de.ok) {
            report_prior_binding(rc, existing);
        }
        ret err[fail.Fail].ok{};
    }

    var slot: u32 = 0;
    if (ps.kind == SYM_USE) { slot = ps.slot; }

    val r_sym: res[SymbolId, fail.Fail] = add_symbol(rc, ps.kind, SYM_FLAG_PUB, name_id, ps.canon, id.DECL_NIL, slot, ps.origin);
    if (sel r_sym.err) { fail.internal(?rc.status, fail.describe(r_sym.err)); ret err[fail.Fail].err{r_sym.err}; }
    val sid: SymbolId = r_sym.ok;
    rc.symbols[sid].definition_file = ps.file;
    rc.symbols[sid].generic_arity = ps.generic_arity;
    rc.symbols[sid].has_comptime_params = ps.has_comptime_params;
    rc.symbols[sid].has_pack_param = ps.has_pack_param;
    rc.symbols[sid].deprecation = ps.deprecation;
    val notice: res[deprecation.Deprecation, fail.Fail] = declaration_deprecation(rc.a, rc.source, ?rc.s.interner, decl_id);
    if (sel notice.err) { ret err[fail.Fail].err{notice.err}; }
    if (notice.ok.present) { rc.symbols[sid].deprecation = notice.ok; }

    val r_add: err[fail.Fail] = scope_add(rc, rc.module_scope, name_id, sid);
    if (sel r_add.err) { ret r_add; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = sid;
    }
    ret err[fail.Fail].ok{};
}

fun collect_fwd_module(rc: *ResolveContext, decl_id: id.DeclId, df: *decl.DeclFwd, mid: session.ModuleId) err[fail.Fail] {
    var alias_span: token.Span = df.alias;
    if (alias_span.len == 0) {
        alias_span = leaf_span(rc, df.path);
    }

    val r_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, alias_span);
    if (sel r_name.err) { fail.internal(?rc.status, alloc.text(r_name.err));
        ret err[fail.Fail].err{fail.refused(r_name.err)};
    }
    val name_id: intern.StrId = r_name.ok;

    val existing: SymbolId = scope_lookup_local(rc, rc.module_scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: err[fail.Fail] = report_named(rc, alias_span, "re-exported name `", name_id, "` is already defined in this scope");
        if (sel de.ok) {
            report_prior_binding(rc, existing);
        }
        ret err[fail.Fail].ok{};
    }

    val r: res[SymbolId, fail.Fail] = declare(rc, SYM_USE, SYM_FLAG_PUB, alias_span, decl_id, mid::u32, rc.own_module, rc.module_scope);
    if (sel r.err) { fail.internal(?rc.status, fail.describe(r.err)); ret err[fail.Fail].err{r.err}; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = r.ok;
    }
    ret err[fail.Fail].ok{};
}

fun gate_probe_ident_is_comptime_param(rc: *ResolveContext, eid: id.ExprId) bool {
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel e_opt.some) { ret false; }
    val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, e_opt.some.span);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, r.ok);
    if (sid == SYMBOL_NIL) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.kind == SYM_PARAM && (sym.flags & SYM_FLAG_COMPTIME) != 0;
}

fun gate_probe_ident_is_each_loopvar(rc: *ResolveContext, eid: id.ExprId) bool {
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel e_opt.some) { ret false; }
    ret ident_is_each_loopvar(rc, e_opt.some.span);
}

fun gate_probe_member_is_field_loopvar(rc: *ResolveContext, eid: id.ExprId) bool {
    ret member_object_is_field_loopvar(rc, eid);
}

fun gate_probe_is_field_type_operand(rc: *ResolveContext, eid: id.ExprId) bool {
    ret is_field_type_operand(rc, eid);
}

fun resolve_gate_probes() comptime.GateProbes[ResolveContext] {
    ret comptime.gate_probes[ResolveContext](
        gate_probe_ident_is_comptime_param,
        gate_probe_ident_is_each_loopvar,
        gate_probe_member_is_field_loopvar,
        gate_probe_is_field_type_operand, comptime_expression);
}

fun gate_chain_defers_to_instantiation(rc: *ResolveContext, branches_start: u32, branches_len: u32) res[bool, fail.Fail] {
    ret comptime.gate_chain_defers[ResolveContext](rc.a, rc.source, rc, resolve_gate_probes(),
                                                   branches_start, branches_len);
}

fun bind_comptime_if(rc: *ResolveContext, branches_start: u32, branches_len: u32, at_decl_scope: bool) err[fail.Fail] {
    if (at_decl_scope && comptime.comptime_if_declares_nothing(rc.a, branches_start, branches_len)) {
        var di: u32 = 0;
        for (di < branches_len) {
            val arm: *decl.ComptimeBranch = ?rc.a.comptime_branches[branches_start + di];
            if (arm.cond != id.EXPR_NIL) {
                val rce: err[fail.Fail] = bind_expr(rc, arm.cond);
                if (sel rce.err) { ret rce; }
            }
            val rb: err[fail.Fail] = bind_decl_list(rc, arm.body_start, arm.body_len);
            if (sel rb.err) { ret rb; }
            di = di + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var all_arms: bool = false;
    if (!at_decl_scope) {
        val defers_r: res[bool, fail.Fail] = gate_chain_defers_to_instantiation(rc, branches_start, branches_len);
        if (sel defers_r.err) { ret err[fail.Fail].err{defers_r.err}; }
        all_arms = defers_r.ok;
    }
    if (all_arms) {
        var ai: u32 = 0;
        for (ai < branches_len) {
            val arm: *decl.ComptimeBranch = ?rc.a.comptime_branches[branches_start + ai];
            if (arm.cond != id.EXPR_NIL) {
                val rc_e: err[fail.Fail] = bind_expr(rc, arm.cond);
                if (sel rc_e.err) { ret rc_e; }
            }
            val rb: err[fail.Fail] = bind_stmt_list(rc, arm.body_start, arm.body_len);
            if (sel rb.err) { ret rb; }
            ai = ai + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var bi: u32 = 0;
    for (bi < branches_len) {
        val br: *decl.ComptimeBranch = ?rc.a.comptime_branches[branches_start + bi];
        if (br.cond != id.EXPR_NIL) {
            val rce: err[fail.Fail] = bind_expr(rc, br.cond);
            if (sel rce.err) { ret rce; }
        }
        val take_r: res[comptime.GateOutcome, fail.Fail] = comptime_branch_active(rc, br, at_decl_scope);
        if (sel take_r.err) {
            ret err[fail.Fail].err{take_r.err};
        }
        val outcome: comptime.GateOutcome = take_r.ok;
        if (outcome == comptime.GATE_DEFERRED || outcome == comptime.GATE_REJECTED || outcome == comptime.GATE_FAILED) {
            ret err[fail.Fail].ok{};
        }
        if (outcome == comptime.GATE_ACTIVE) {
            if (at_decl_scope) {
                ret bind_decl_list(rc, br.body_start, br.body_len);
            }
            ret bind_stmt_list(rc, br.body_start, br.body_len);
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun symbol_is_runtime(sym: *Symbol) bool {
    if ((sym.flags & SYM_FLAG_COMPTIME) != 0) { ret false; }
    if (sym.kind == SYM_VAL || sym.kind == SYM_VAR) {
        ret (sym.flags & SYM_FLAG_MODULE) == 0;
    }
    ret sym.kind == SYM_PARAM;
}

fun comptime_ident_is_runtime(rc: *ResolveContext, eid: id.ExprId) bool {
    if (rc == nil || rc.expr_resolved == nil) { ret false; }
    if (eid == id.EXPR_NIL || eid::u32 >= rc.a.expr_len::u32) { ret false; }
    val sid: SymbolId = rc.expr_resolved[eid];
    if (sid == SYMBOL_NIL || sid >= rc.sym_len) { ret false; }
    ret symbol_is_runtime(?rc.symbols[sid]);
}

fun bind_fun(rc: *ResolveContext, f: *decl.DeclFun, decl_id: id.DeclId) err[fail.Fail] {
    val r_g: res[ScopeId, fail.Fail] = open_scope(rc, rc.current_scope);
    if (sel r_g.err) { ret err[fail.Fail].err{r_g.err}; }
    val gen_scope: ScopeId = r_g.ok;
    val saved_scope: ScopeId = rc.current_scope;
    rc.current_scope = gen_scope;

    var gi: u32 = 0;
    for (gi < f.generics_len) {
        val name: token.Span = rc.a.generic_names[f.generics_start + gi];
        val r: res[SymbolId, fail.Fail] = declare(rc, SYM_GENERIC, 0, name, decl_id, gi, rc.own_module, gen_scope);
        if (sel r.err) { fail.internal(?rc.status, fail.describe(r.err));
            rc.current_scope = saved_scope;
            ret err[fail.Fail].err{r.err};
        }
        gi = gi + 1;
    }

    val r_p: res[ScopeId, fail.Fail] = open_scope(rc, gen_scope);
    if (sel r_p.err) {
        rc.current_scope = saved_scope;
        ret err[fail.Fail].err{r_p.err};
    }
    val param_scope: ScopeId = r_p.ok;
    rc.current_scope = param_scope;

    var pi: u32 = 0;
    for (pi < f.params_len) {
        val tn: *decl.TypedName = ?rc.a.typed_names[f.params_start + pi];
        val rt: err[fail.Fail] = bind_type(rc, tn.ty);
        if (sel rt.err) {
            rc.current_scope = saved_scope;
            ret rt;
        }
        val pflags: u8 = param_flags(tn);
        val r: res[SymbolId, fail.Fail] = declare(rc, SYM_PARAM, pflags, tn.name, decl_id, pi, rc.own_module, param_scope);
        if (sel r.err) { fail.internal(?rc.status, fail.describe(r.err));
            rc.current_scope = saved_scope;
            ret err[fail.Fail].err{r.err};
        }
        pi = pi + 1;
    }

    if (f.return_type != id.TYPE_NIL) {
        val rt: err[fail.Fail] = bind_type(rc, f.return_type);
        if (sel rt.err) {
            rc.current_scope = saved_scope;
            ret rt;
        }
    }

    if (f.body != id.STMT_NIL) {
        val rb: err[fail.Fail] = bind_stmt(rc, f.body);
        if (sel rb.err) {
            rc.current_scope = saved_scope;
            ret rb;
        }
    }

    rc.current_scope = saved_scope;
    ret err[fail.Fail].ok{};
}

fun param_flags(tn: *decl.TypedName) u8 {
    if (tn.comptime) { ret SYM_FLAG_COMPTIME; }
    ret 0;
}

fun bind_rec(rc: *ResolveContext, r: *decl.DeclRec, decl_id: id.DeclId) err[fail.Fail] {
    ret bind_aggregate(rc, r.generics_start, r.generics_len, r.fields_start, r.fields_len, decl_id, false);
}

fun bind_uni(rc: *ResolveContext, u: *decl.DeclUni, decl_id: id.DeclId) err[fail.Fail] {
    ret bind_aggregate(rc, u.generics_start, u.generics_len, u.fields_start, u.fields_len, decl_id, false);
}

fun bind_aggregate(rc: *ResolveContext, generics_start: u32, generics_len: u32, fields_start: u32, fields_len: u32, decl_id: id.DeclId, tagged: bool) err[fail.Fail] {
    val r_g: res[ScopeId, fail.Fail] = open_scope(rc, rc.current_scope);
    if (sel r_g.err) { ret err[fail.Fail].err{r_g.err}; }
    val gen_scope: ScopeId = r_g.ok;
    val saved_scope: ScopeId = rc.current_scope;
    rc.current_scope = gen_scope;

    var gi: u32 = 0;
    for (gi < generics_len) {
        val name: token.Span = rc.a.generic_names[generics_start + gi];
        val rd: res[SymbolId, fail.Fail] = declare(rc, SYM_GENERIC, 0, name, decl_id, gi, rc.own_module, gen_scope);
        if (sel rd.err) { fail.internal(?rc.status, fail.describe(rd.err));
            rc.current_scope = saved_scope;
            ret err[fail.Fail].err{rd.err};
        }
        gi = gi + 1;
    }

    var fi: u32 = 0;
    for (fi < fields_len) {
        var ty: id.TypeId = id.TYPE_NIL;
        if (tagged) { ty = rc.a.tag_cases[fields_start + fi].payload; }
        or { ty = rc.a.typed_names[fields_start + fi].ty; }
        val rt: err[fail.Fail] = bind_type(rc, ty);
        if (sel rt.err) {
            rc.current_scope = saved_scope;
            ret rt;
        }
        fi = fi + 1;
    }

    rc.current_scope = saved_scope;
    ret err[fail.Fail].ok{};
}

fun bind_stmt_list(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val sid: id.StmtId = rc.a.stmt_ids[start + i];
        val r: err[fail.Fail] = bind_stmt(rc, sid);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_stmt(rc: *ResolveContext, sid: id.StmtId) err[fail.Fail] {
    if (sid == id.STMT_NIL) { ret err[fail.Fail].ok{}; }
    val s_opt: opt[*stmt.Stmt] = ast.get_stmt_typed(rc.a, sid);
    if (!sel s_opt.some) { ret err[fail.Fail].err{fail.message("StmtId out of range")}; }
    val s: *stmt.Stmt = s_opt.some;

    if (s.kind == stmt.STMT_KIND_BLOCK) { ret bind_block(rc, ?s.data.block); }
    if (s.kind == stmt.STMT_KIND_EXPR)  { ret bind_expr(rc, s.data.expr.expr); }
    if (s.kind == stmt.STMT_KIND_RET) {
        if (s.data.ret_.value == id.EXPR_NIL) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, s.data.ret_.value);
    }
    if (s.kind == stmt.STMT_KIND_FIN)   { ret bind_stmt(rc, s.data.fin_.body); }
    if (s.kind == stmt.STMT_KIND_BRK || s.kind == stmt.STMT_KIND_CNT) {
        ret err[fail.Fail].ok{};
    }
    if (s.kind == stmt.STMT_KIND_IF) {
        val rc_e: err[fail.Fail] = bind_expr(rc, s.data.if_.cond);
        if (sel rc_e.err) { ret rc_e; }
        val rt: err[fail.Fail] = bind_stmt(rc, s.data.if_.then_block);
        if (sel rt.err) { ret rt; }
        ret bind_stmt(rc, s.data.if_.else_block);
    }
    if (s.kind == stmt.STMT_KIND_FOR) {
        if (s.data.for_.cond != id.EXPR_NIL) {
            val rc_e: err[fail.Fail] = bind_expr(rc, s.data.for_.cond);
            if (sel rc_e.err) { ret rc_e; }
        }
        ret bind_stmt(rc, s.data.for_.body);
    }
    if (s.kind == stmt.STMT_KIND_DECL) {
        ret bind_local_decl(rc, s.data.decl.decl);
    }
    if (s.kind == stmt.STMT_KIND_ASM) {
        ret err[fail.Fail].ok{};
    }
    if (s.kind == stmt.STMT_KIND_COMPTIME_IF) {
        ret bind_comptime_if(rc, s.data.comptime_if.branches_start, s.data.comptime_if.branches_len, false);
    }
    if (s.kind == stmt.STMT_KIND_COMPTIME_EACH) {
        ret bind_comptime_each(rc, ?s.data.comptime_each);
    }
    if (s.kind == stmt.STMT_KIND_COMPTIME_ATTR) {
        ret err[fail.Fail].ok{};
    }
    if (s.kind == stmt.STMT_KIND_ERROR) { ret err[fail.Fail].ok{}; }
    ret unknown_kind(rc, "StmtKind", s.kind::u32);
}

fun bind_comptime_each(rc: *ResolveContext, ce: *stmt.StmtComptimeEach) err[fail.Fail] {
    val rs: err[fail.Fail] = bind_expr(rc, ce.seq);
    if (sel rs.err) { ret rs; }

    val r_s: res[ScopeId, fail.Fail] = open_scope(rc, rc.current_scope);
    if (sel r_s.err) { ret err[fail.Fail].err{r_s.err}; }
    val saved: ScopeId = rc.current_scope;
    rc.current_scope = r_s.ok;

    val rd: res[SymbolId, fail.Fail] = declare(rc, SYM_VAL, SYM_FLAG_COMPTIME, ce.var_name, id.DECL_NIL, 0, rc.own_module, rc.current_scope);
    if (sel rd.err) { fail.internal(?rc.status, fail.describe(rd.err)); rc.current_scope = saved; ret err[fail.Fail].err{rd.err}; }

    val rb: err[fail.Fail] = bind_stmt_list(rc, ce.body_start, ce.body_len);
    rc.current_scope = saved;
    ret rb;
}

fun bind_block(rc: *ResolveContext, b: *stmt.StmtBlock) err[fail.Fail] {
    val r_s: res[ScopeId, fail.Fail] = open_scope(rc, rc.current_scope);
    if (sel r_s.err) { ret err[fail.Fail].err{r_s.err}; }
    val saved: ScopeId = rc.current_scope;
    rc.current_scope = r_s.ok;

    val r: err[fail.Fail] = bind_stmt_list(rc, b.stmts_start, b.stmts_len);
    rc.current_scope = saved;
    ret r;
}

fun bind_local_decl(rc: *ResolveContext, decl_id: id.DeclId) err[fail.Fail] {
    if (decl_id == id.DECL_NIL) { ret err[fail.Fail].ok{}; }
    val d_opt: opt[*decl.Decl] = ast.get_decl_typed(rc.a, decl_id);
    if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *decl.Decl = d_opt.some;

    if (d.kind > decl.DECL_KIND_TAG && d.kind != decl.DECL_KIND_ERROR) {
        ret unknown_kind(rc, "DeclKind", d.kind::u32);
    }
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) {
        ret err[fail.Fail].ok{};
    }

    if (d.data.bind.ty != id.TYPE_NIL) {
        val rt: err[fail.Fail] = bind_type(rc, d.data.bind.ty);
        if (sel rt.err) { ret rt; }
    }
    if (d.data.bind.init != id.EXPR_NIL) {
        val re: err[fail.Fail] = bind_expr(rc, d.data.bind.init);
        if (sel re.err) { ret re; }
    }

    val kind: SymKind = if_val_kind(d.kind == decl.DECL_KIND_VAL);
    val r_sym: res[SymbolId, fail.Fail] = declare(rc, kind, 0, d.data.bind.name, decl_id, 0, rc.own_module, rc.current_scope);
    if (sel r_sym.err) { fail.internal(?rc.status, fail.describe(r_sym.err));
        ret err[fail.Fail].err{r_sym.err};
    }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = r_sym.ok;
    }

    ret err[fail.Fail].ok{};
}

fun if_val_kind(is_val: bool) SymKind {
    if (is_val) { ret SYM_VAL; }
    ret SYM_VAR;
}

fun bind_expr(rc: *ResolveContext, eid: id.ExprId) err[fail.Fail] {
    if (eid == id.EXPR_NIL) { ret err[fail.Fail].ok{}; }
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel e_opt.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val e: *expr.Expr = e_opt.some;

    if (e.kind == expr.EXPR_KIND_IDENT) {
        ret bind_ident(rc, eid, e.span);
    }
    if (e.kind == expr.EXPR_KIND_BINARY) {
        if (comptime.is_type_comparison_binary(rc.a, rc.source, ?e.data.binary,
                is_field_type_operand(rc, e.data.binary.lhs),
                is_field_type_operand(rc, e.data.binary.rhs))) {
            ret bind_type_comparison(rc, ?e.data.binary);
        }
        val rl: err[fail.Fail] = bind_expr(rc, e.data.binary.lhs);
        if (sel rl.err) { ret rl; }
        ret bind_expr(rc, e.data.binary.rhs);
    }
    if (e.kind == expr.EXPR_KIND_UNARY) {
        ret bind_expr(rc, e.data.unary.operand);
    }
    if (e.kind == expr.EXPR_KIND_SPREAD) {
        ret bind_expr(rc, e.data.spread.inner);
    }
    if (e.kind == expr.EXPR_KIND_CALL) {
        if (e.data.call.index_callee != id.EXPR_NIL) {
            ret resolve_bracket_call(rc, eid);
        }

        val intr: opt[err[fail.Fail]] = bind_comptime_intrinsic_call(rc, ?e.data.call);
        if (sel intr.some) { ret intr.some; }

        val rc_e: err[fail.Fail] = bind_expr(rc, e.data.call.callee);
        if (sel rc_e.err) { ret rc_e; }
        ret bind_generic_call(rc, e.data.call.type_args_start, e.data.call.type_args_len, e.data.call.args_start, e.data.call.args_len);
    }
    if (e.kind == expr.EXPR_KIND_GENERIC_INSTANCE) {
        ret resolve_bracket_value(rc, eid);
    }
    if (e.kind == expr.EXPR_KIND_INDEX) {
        val ro: err[fail.Fail] = bind_expr(rc, e.data.index.object);
        if (sel ro.err) { ret ro; }
        ret bind_expr(rc, e.data.index.index);
    }
    if (e.kind == expr.EXPR_KIND_PROJECT) {
        val ro: err[fail.Fail] = bind_expr(rc, e.data.project.object);
        if (sel ro.err) { ret ro; }
        ret bind_expr(rc, e.data.project.field);
    }
    if (e.kind == expr.EXPR_KIND_MEMBER) {
        val ro: err[fail.Fail] = bind_expr(rc, e.data.member.object);
        if (sel ro.err) { ret ro; }
        ret bind_member_qualified(rc, eid, ?e.data.member);
    }
    if (e.kind == expr.EXPR_KIND_CAST) {
        val rv: err[fail.Fail] = bind_expr(rc, e.data.cast.value);
        if (sel rv.err) { ret rv; }
        ret bind_type(rc, e.data.cast.ty);
    }
    if (e.kind == expr.EXPR_KIND_STRIP) {
        val rv: err[fail.Fail] = bind_expr(rc, e.data.strip.value);
        if (sel rv.err) { ret rv; }
        ret bind_type(rc, e.data.strip.ty);
    }
    if (e.kind == expr.EXPR_KIND_ARRAY_LIT) {
        val rt: err[fail.Fail] = bind_type(rc, e.data.array_lit.ty);
        if (sel rt.err) { ret rt; }
        ret bind_expr_list(rc, e.data.array_lit.elems_start, e.data.array_lit.elems_len);
    }
    if (e.kind == expr.EXPR_KIND_VECTOR_LIT) {
        val rt: err[fail.Fail] = bind_literal_head(rc, e.data.vector_lit.ty);
        if (sel rt.err) { ret rt; }
        # a head that names a case is a tag construction, not a lane list
        if (literal_head_names_case(rc, e.data.vector_lit.ty)) {
            val vl: expr.ExprVectorLit = e.data.vector_lit;
            e.kind = expr.EXPR_KIND_STRUCT_LIT;
            e.data.struct_lit = expr.ExprStructLit{elems_start: vl.elems_start, elems_len: vl.elems_len,
                ty: vl.ty, fields_start: 0, fields_len: 0};
            ret bind_expr_list(rc, e.data.struct_lit.elems_start, e.data.struct_lit.elems_len);
        }
        ret bind_expr_list(rc, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len);
    }
    if (e.kind == expr.EXPR_KIND_STRUCT_LIT) {
        val rt: err[fail.Fail] = bind_literal_head(rc, e.data.struct_lit.ty);
        if (sel rt.err) { ret rt; }
        var fi: u32 = 0;
        for (fi < e.data.struct_lit.fields_len) {
            val finit: *expr.FieldInit = ?rc.a.field_inits[e.data.struct_lit.fields_start + fi];
            if (finit.form == expr.INIT_BARE) {
                val name: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, finit.name);
                if (sel name.err) { ret err[fail.Fail].err{fail.refused(name.err)}; }
                rc.expr_resolved[finit.value] = scope_lookup_chain(rc, rc.current_scope, name.ok);
            }
            or {
                val rf: err[fail.Fail] = bind_expr(rc, finit.value);
                if (sel rf.err) { ret rf; }
            }
            fi = fi + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (e.kind == expr.EXPR_KIND_SEL) {
        val rp: err[fail.Fail] = bind_expr(rc, e.data.sel.place);
        if (sel rp.err) { ret rp; }
        if (e.data.sel.case_desc == id.EXPR_NIL) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, e.data.sel.case_desc);
    }
    if (e.kind == expr.EXPR_KIND_TYPE_REF) {
        ret bind_type(rc, e.data.type_ref.ty);
    }
    if (expr_kind_binds_nothing(e.kind)) { ret err[fail.Fail].ok{}; }

    ret unknown_kind(rc, "ExprKind", e.kind::u32);
}

fun expr_kind_binds_nothing(k: expr.ExprKind) bool {
    ret k == expr.EXPR_KIND_LIT_INT   || k == expr.EXPR_KIND_LIT_FLOAT
     || k == expr.EXPR_KIND_LIT_CHAR  || k == expr.EXPR_KIND_LIT_STR
     || k == expr.EXPR_KIND_LIT_NIL   || k == expr.EXPR_KIND_COMPTIME_IDENT
     || k == expr.EXPR_KIND_ERROR;
}

fun bind_expr_list(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val eid: id.ExprId = rc.a.expr_ids[start + i];
        val r: err[fail.Fail] = bind_expr(rc, eid);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun comptime_expression(rc: *ResolveContext, a: *ast.Ast, eid: id.ExprId) R.Result[expr.Expr, comptime.EvalFail] {
    if (rc == nil || rc.a != a) { ret R.err[expr.Expr, comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "resolution expression belongs to a different parsed owner")); }
    val result: res[expr.Expr, fail.Fail] = interpretation.get(a, rc.expr_choices, rc.expr_choices_count, eid);
    if (sel result.err) {
        fail.internal(?rc.status, fail.describe(result.err));
        ret R.err[expr.Expr, comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.describe(result.err)));
    }
    ret R.ok[expr.Expr, comptime.EvalFail](result.ok);
}

# translation shim (#3226): the legacy carrier me.lower, editor and the driver
# tests still read. deleted by the boundary flip, when the `_typed` core
# takes the name
pub fun expression(rr: *ResolveResult, a: *ast.Ast, eid: id.ExprId) R.Result[expr.Expr, str] {
    val r: res[expr.Expr, fail.Fail] = expression_typed(rr, a, eid);
    if (sel r.err) { ret R.err[expr.Expr, str](fail.describe(r.err)); }
    ret R.ok[expr.Expr, str](r.ok);
}

pub fun expression_typed(rr: *ResolveResult, a: *ast.Ast, eid: id.ExprId) res[expr.Expr, fail.Fail] {
    if (rr == nil) { ret res[expr.Expr, fail.Fail].err{fail.message("resolved expression requires a resolver result")}; }
    ret interpretation.get(a, rr.expr_choices, rr.expr_choices_count, eid);
}

fun resolve_bracket_call(rc: *ResolveContext, eid: id.ExprId) err[fail.Fail] {
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel e_opt.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val e: *expr.Expr = e_opt.some;

    val callee:          id.ExprId = e.data.call.callee;
    val index_callee:    id.ExprId = e.data.call.index_callee;
    val type_args_start: u32       = e.data.call.type_args_start;
    val type_args_len:   u32       = e.data.call.type_args_len;
    val args_start:      u32       = e.data.call.args_start;
    val args_len:        u32       = e.data.call.args_len;

    val rc_e: err[fail.Fail] = bind_expr(rc, callee);
    if (sel rc_e.err) { ret rc_e; }

    if (callee_accepts_type_args(rc, callee)) {
        rc.expr_choices[eid] = interpretation.GENERIC;
        ret bind_generic_call(rc, type_args_start, type_args_len, args_start, args_len);
    }

    val idx_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, index_callee);
    if (!sel idx_opt.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val idxn: *expr.Expr = idx_opt.some;
    val rs: err[fail.Fail] = bind_expr(rc, idxn.data.index.index);
    if (sel rs.err) { ret rs; }

    rc.expr_choices[eid] = interpretation.INDEX_CALL;
    ret bind_expr_list(rc, args_start, args_len);
}

fun resolve_bracket_value(rc: *ResolveContext, eid: id.ExprId) err[fail.Fail] {
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel e_opt.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val e: *expr.Expr = e_opt.some;

    val object:          id.ExprId = e.data.call.callee;
    val index_callee:    id.ExprId = e.data.call.index_callee;
    val type_args_start: u32       = e.data.call.type_args_start;
    val type_args_len:   u32       = e.data.call.type_args_len;
    val span:            token.Span = e.span;

    val ro: err[fail.Fail] = bind_expr(rc, object);
    if (sel ro.err) { ret ro; }

    if (object_names_function(rc, object) || callee_accepts_type_args(rc, object)) {
        rc.expr_choices[eid] = interpretation.GENERIC;
        ret bind_generic_call(rc, type_args_start, type_args_len, 0, 0);
    }

    if (index_callee == id.EXPR_NIL) {
        val re: err[fail.Fail] = report(rc, span,
            "type arguments in value position name a generic instance, but this does not name a generic function");
        if (sel re.err) { ret re; }
        rc.expr_choices[eid] = interpretation.REJECTED;
        ret err[fail.Fail].ok{};
    }

    val idx_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, index_callee);
    if (!sel idx_opt.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val idxn: *expr.Expr = idx_opt.some;
    val rs: err[fail.Fail] = bind_expr(rc, idxn.data.index.index);
    if (sel rs.err) { ret rs; }

    rc.expr_choices[eid] = interpretation.INDEX_VALUE;
    ret err[fail.Fail].ok{};
}

fun object_names_function(rc: *ResolveContext, object: id.ExprId) bool {
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, object);
    if (!sel e_opt.some) { ret false; }
    val e: *expr.Expr = e_opt.some;
    if (e.kind != expr.EXPR_KIND_IDENT && e.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    if (rc.expr_resolved == nil)                                           { ret false; }
    val sid: SymbolId = rc.expr_resolved[object];
    if (sid == SYMBOL_NIL || sid >= rc.sym_len) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.definition_kind == SYM_FUN;
}

fun bind_generic_call(rc: *ResolveContext, type_args_start: u32, type_args_len: u32, args_start: u32, args_len: u32) err[fail.Fail] {
    var ti: u32 = 0;
    for (ti < type_args_len) {
        val arg_id: id.TypeId = rc.a.type_ids[type_args_start + ti];
        val rt: err[fail.Fail] = bind_type(rc, arg_id);
        if (sel rt.err) { ret rt; }
        ti = ti + 1;
    }
    ret bind_expr_list(rc, args_start, args_len);
}

fun callee_accepts_type_args(rc: *ResolveContext, callee: id.ExprId) bool {
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, callee);
    if (!sel e_opt.some) { ret false; }
    val e: *expr.Expr = e_opt.some;
    if (e.kind != expr.EXPR_KIND_IDENT && e.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    if (rc.expr_resolved == nil)                                           { ret false; }
    val sid: SymbolId = rc.expr_resolved[callee];
    if (sid == SYMBOL_NIL || sid >= rc.sym_len) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    val kind: SymKind = sym.definition_kind;
    ret kind == SYM_FUN || kind == SYM_REC || kind == SYM_UNI || kind == SYM_TAG
     || kind == SYM_DEF || kind == SYM_GENERIC || kind == SYM_PRIM;
}

fun bind_ident(rc: *ResolveContext, eid: id.ExprId, span: token.Span) err[fail.Fail] {
    val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, span);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err));
        ret err[fail.Fail].err{fail.refused(r.err)};
    }
    val name: intern.StrId = r.ok;
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, name);
    if (sid == SYMBOL_NIL) {
        if (rc.expr_resolved != nil) { rc.expr_resolved[eid] = SYMBOL_REJECTED; }
        val re: err[fail.Fail] = report_named(rc, span, "unresolved identifier `", name, "`");
        if (sel re.ok) { attach_suggestion(rc, span, name); }
    }
    or {
        if (rc.expr_resolved != nil) { rc.expr_resolved[eid] = sid; }
    }
    ret err[fail.Fail].ok{};
}

fun attach_suggestion(rc: *ResolveContext, span: token.Span, target: intern.StrId) {
    val to: opt[str] = intern.lookup_typed(?rc.s.interner, target);
    if (!sel to.some) { ret; }
    val tname: str = to.some;
    val tlen: usize = str_len(tname);
    if (tlen == 0) { ret; }

    var best_sym:  SymbolId = SYMBOL_NIL;
    var best_dist: usize = MAX_SUGGEST_DISTANCE + 1;
    var max_dist:  usize = tlen / 2;
    if (max_dist > MAX_SUGGEST_DISTANCE) { max_dist = MAX_SUGGEST_DISTANCE; }

    var cur: ScopeId = rc.current_scope;
    for (cur != SCOPE_NIL) {
        val sc: *Scope = ?rc.scopes[cur];
        var i: u32 = 0;
        for (i < sc.len) {
            val cname_id: intern.StrId = sc.entries[i].name;
            if (cname_id != target) {
                val co: opt[str] = intern.lookup_typed(?rc.s.interner, cname_id);
                if (sel co.some) {
                    val cname: str = co.some;
                    val dist: usize = edit_distance(tname, cname, best_dist);
                    if (dist <= max_dist && dist < best_dist) {
                        best_dist = dist;
                        best_sym  = sc.entries[i].sym;
                    }
                }
            }
            i = i + 1;
        }
        cur = rc.scopes[cur].parent;
    }

    if (best_sym == SYMBOL_NIL) { ret; }
    val bo: opt[str] = intern.lookup_typed(?rc.s.interner, rc.symbols[best_sym].name);
    if (!sel bo.some) { ret; }
    val bname: str = bo.some;

    val id_r: R.Result[diagnostic.DiagnosticId, str] = diagnostic.last_id(rc.diags);
    if (R.is_err[diagnostic.DiagnosticId, str](id_r)) { ret; }
    val did: diagnostic.DiagnosticId = R.unwrap_ok[diagnostic.DiagnosticId, str](id_r);

    val note_r: R.Result[str, str] = diagnostic.suggestion_build(rc.s.alloc, bname);
    if (R.is_err[str, str](note_r)) { fail.internal(?rc.status, R.unwrap_err[str, str](note_r)); ret; }
    val note: str = R.unwrap_ok[str, str](note_r);
    diagnostic.record_help_committed(rc.diags, did, note);

    val flabel_r: R.Result[str, str] = diagnostic.fix_label_replace(rc.s.alloc, bname);
    if (R.is_ok[str, str](flabel_r)) {
        val flabel: str = R.unwrap_ok[str, str](flabel_r);
        diagnostic.record_fix_committed(rc.diags, did, flabel, rc.a.file_id, span, bname);
        str_free(rc.s.alloc, flabel);
    }
    str_free(rc.s.alloc, note);
}

fun report_named(rc: *ResolveContext, span: token.Span, prefix: str, name_id: intern.StrId, suffix: str) err[fail.Fail] {
    val no: opt[str] = intern.lookup_typed(?rc.s.interner, name_id);
    if (!sel no.some) {
        ret report(rc, span, prefix);
    }
    val name: str = no.some;

    val pn: usize = str_len(prefix);
    val nn: usize = str_len(name);
    val sn: usize = str_len(suffix);
    val total: usize = pn + nn + sn;

    val r: res[*char, A.Error] = A.allocate[char](rc.s.alloc, total + 1);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err));
        ret err[fail.Fail].err{fail.refused(r.err)};
    }
    val buf: str = r.ok;

    memory.raw_copy(buf::ptr, prefix::ptr, pn);
    memory.raw_copy((buf::usize + pn)::ptr, name::ptr, nn);
    memory.raw_copy((buf::usize + pn + nn)::ptr, suffix::ptr, sn);
    buf[total] = 0;

    val emit: err[fail.Fail] = report(rc, span, buf);
    A.deallocate[char](rc.s.alloc, buf, total + 1);
    ret emit;
}

fun report_named2(rc: *ResolveContext, span: token.Span, prefix: str, a_id: intern.StrId, mid: str, b_id: intern.StrId, suffix: str) err[fail.Fail] {
    val ao: opt[str] = intern.lookup_typed(?rc.s.interner, a_id);
    val bo: opt[str] = intern.lookup_typed(?rc.s.interner, b_id);
    if (!sel ao.some) {
        ret report(rc, span, prefix);
    }
    if (!sel bo.some) {
        ret report(rc, span, prefix);
    }
    val a: str = ao.some;
    val b: str = bo.some;

    val pn: usize = str_len(prefix);
    val an: usize = str_len(a);
    val mn: usize = str_len(mid);
    val bn: usize = str_len(b);
    val sn: usize = str_len(suffix);
    val total: usize = pn + an + mn + bn + sn;

    val r: res[*char, A.Error] = A.allocate[char](rc.s.alloc, total + 1);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err));
        ret err[fail.Fail].err{fail.refused(r.err)};
    }
    val buf: str = r.ok;

    var off: usize = 0;
    memory.raw_copy((buf::usize + off)::ptr, prefix::ptr, pn); off = off + pn;
    memory.raw_copy((buf::usize + off)::ptr, a::ptr, an);      off = off + an;
    memory.raw_copy((buf::usize + off)::ptr, mid::ptr, mn);    off = off + mn;
    memory.raw_copy((buf::usize + off)::ptr, b::ptr, bn);      off = off + bn;
    memory.raw_copy((buf::usize + off)::ptr, suffix::ptr, sn);
    buf[total] = 0;

    val emit: err[fail.Fail] = report(rc, span, buf);
    A.deallocate[char](rc.s.alloc, buf, total + 1);
    ret emit;
}

val MAX_SUGGEST_DISTANCE: usize = 2;

fun edit_distance(a: str, b: str, cap: usize) usize {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    if (la == 0) { ret lb; }
    if (lb == 0) { ret la; }

    var prev: [128]usize;
    var curr: [128]usize;
    if (lb + 1 > SUGGEST_ROW) { ret cap + 1; }

    var j: usize = 0;
    for (j <= lb) { prev[j] = j; j = j + 1; }

    var i: usize = 1;
    for (i <= la) {
        curr[0] = i;
        var row_min: usize = i;
        var k: usize = 1;
        for (k <= lb) {
            var cost: usize = 1;
            if (a[i - 1] == b[k - 1]) { cost = 0; }
            var m: usize = prev[k] + 1;
            val del: usize = curr[k - 1] + 1;
            if (del < m) { m = del; }
            val sub: usize = prev[k - 1] + cost;
            if (sub < m) { m = sub; }
            curr[k] = m;
            if (m < row_min) { row_min = m; }
            k = k + 1;
        }
        if (row_min > cap) { ret cap + 1; }
        var t: usize = 0;
        for (t <= lb) { prev[t] = curr[t]; t = t + 1; }
        i = i + 1;
    }
    ret prev[lb];
}

val SUGGEST_ROW: usize = 128;

fun callee_is_offset_of(rc: *ResolveContext, callee: id.ExprId) bool {
    val ce_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, callee);
    if (!sel ce_opt.some) { ret false; }
    val ce: *expr.Expr = ce_opt.some;
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret false; }

    val ns: token.Span = comptime.comptime_ident_name(ce.span);
    if (ns.len == 0) { ret false; }
    val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, ns);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret false; }
    ret r.ok == interned_literal(rc, "offset_of");
}

fun bind_comptime_intrinsic_call(rc: *ResolveContext, c: *expr.ExprCall) opt[err[fail.Fail]] {
    if (!callee_is_offset_of(rc, c.callee)) { ret opt[err[fail.Fail]].none{}; }
    if (c.args_len < 1)                     { ret opt[err[fail.Fail]].some{err[fail.Fail].ok{}}; }

    val arg0: id.ExprId = rc.a.expr_ids[c.args_start];
    ret opt[err[fail.Fail]].some{bind_expr(rc, arg0)};
}

fun bind_type_comparison(rc: *ResolveContext, bin: *expr.ExprBinary) err[fail.Fail] {
    val rl: err[fail.Fail] = bind_type_operand(rc, bin.lhs);
    if (sel rl.err) { ret rl; }
    ret bind_type_operand(rc, bin.rhs);
}

fun bind_type_operand(rc: *ResolveContext, operand: id.ExprId) err[fail.Fail] {
    if (comptime.is_type_of_call(rc.a, rc.source, operand)) {
        val arg: id.ExprId = comptime.type_of_arg(rc.a, operand);
        if (arg == id.EXPR_NIL) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, arg);
    }
    if (is_field_type_operand(rc, operand)) {
        val n_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, operand);
        if (!sel n_opt.some) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, n_opt.some.data.member.object);
    }
    ret bind_type_name_expr(rc, operand);
}

fun bind_type_name_expr(rc: *ResolveContext, eid: id.ExprId) err[fail.Fail] {
    if (eid == id.EXPR_NIL) { ret err[fail.Fail].ok{}; }
    val e_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel e_opt.some) { ret err[fail.Fail].ok{}; }
    val e: *expr.Expr = e_opt.some;

    if (e.kind == expr.EXPR_KIND_IDENT) {
        val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, e.span);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret err[fail.Fail].err{fail.refused(r.err)}; }
        val name: intern.StrId = r.ok;

        val rs: res[TypeSpelling, fail.Fail] = type_spelling(rc, name);
        if (sel rs.err) { fail.internal(?rc.status, fail.describe(rs.err)); ret err[fail.Fail].err{rs.err}; }
        val sp: TypeSpelling = rs.ok;

        if (sp.status == TYPE_SPELL_VEC_REFUSED) {
            if (rc.expr_resolved != nil) { rc.expr_resolved[eid] = SYMBOL_REJECTED; }
            ret report_vector_refused(rc, e.span, name, sp.form);
        }

        var sid: SymbolId = sp.sym;
        if (sid == SYMBOL_NIL) { sid = scope_lookup_chain(rc, rc.current_scope, name); }
        if (sid == SYMBOL_NIL) {
            if (rc.expr_resolved != nil) { rc.expr_resolved[eid] = SYMBOL_REJECTED; }
            val re: err[fail.Fail] = report_named(rc, e.span, "unresolved type name `", name, "`");
            if (sel re.ok) { attach_suggestion(rc, e.span, name); }
        }
        or {
            if (rc.expr_resolved != nil) { rc.expr_resolved[eid] = sid; }
        }
        ret err[fail.Fail].ok{};
    }

    if (e.kind == expr.EXPR_KIND_MEMBER) {
        val ro: err[fail.Fail] = bind_expr(rc, e.data.member.object);
        if (sel ro.err) { ret ro; }
        ret bind_member_qualified(rc, eid, ?e.data.member);
    }

    ret bind_expr(rc, eid);
}

fun is_field_type_operand(rc: *ResolveContext, eid: id.ExprId) bool {
    if (!comptime.is_field_type_member(rc.a, rc.source, eid)) { ret false; }
    ret member_object_is_field_loopvar(rc, eid);
}

fun member_object_is_field_loopvar(rc: *ResolveContext, eid: id.ExprId) bool {
    val n_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, eid);
    if (!sel n_opt.some) { ret false; }
    val obj: id.ExprId = n_opt.some.data.member.object;
    val o_opt: opt[*expr.Expr] = ast.get_expr_typed(rc.a, obj);
    if (!sel o_opt.some) { ret false; }
    val oe: *expr.Expr = o_opt.some;
    if (oe.kind != expr.EXPR_KIND_IDENT) { ret false; }
    val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, oe.span);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, r.ok);
    if (sid == SYMBOL_NIL) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.kind == SYM_VAL && (sym.flags & SYM_FLAG_COMPTIME) != 0;
}

fun ident_is_each_loopvar(rc: *ResolveContext, span: token.Span) bool {
    val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, span);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, r.ok);
    if (sid == SYMBOL_NIL) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.kind == SYM_VAL && (sym.flags & SYM_FLAG_COMPTIME) != 0 && sym.decl == id.DECL_NIL;
}

fun interned_literal(rc: *ResolveContext, text: str) intern.StrId {
    val r: res[intern.StrId, A.Error] = intern.intern_typed(?rc.s.interner, text);
    if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret intern.STR_NIL; }
    ret r.ok;
}

# `A.b{...}` is a case selection when `A` is not a module, and a qualified type name when it is
fun bind_literal_head(rc: *ResolveContext, tid: id.TypeId) err[fail.Fail] {
    if (tid == id.TYPE_NIL) { ret err[fail.Fail].ok{}; }
    val t_opt: opt[*atype.Type] = ast.get_type_typed(rc.a, tid);
    if (sel t_opt.some) {
        val t: *atype.Type = t_opt.some;
        if (t.kind == atype.TYPE_KIND_NAMED && t.data.named.case_desc != id.EXPR_NIL) {
            val rd: err[fail.Fail] = bind_expr(rc, t.data.named.case_desc);
            if (sel rd.err) { ret rd; }
        }
        or (t.kind == atype.TYPE_KIND_NAMED && t.data.named.case_name.len == 0) {
            split_case_head(rc, ?t.data.named);
        }
    }
    ret bind_type(rc, tid);
}

fun literal_head_names_case(rc: *ResolveContext, tid: id.TypeId) bool {
    if (tid == id.TYPE_NIL) { ret false; }
    val t_opt: opt[*atype.Type] = ast.get_type_typed(rc.a, tid);
    if (!sel t_opt.some) { ret false; }
    val t: *atype.Type = t_opt.some;
    if (t.kind != atype.TYPE_KIND_NAMED) { ret false; }
    ret t.data.named.case_name.len != 0 || t.data.named.case_desc != id.EXPR_NIL;
}

fun split_case_head(rc: *ResolveContext, named: *atype.TypeNamed) {
    val path: token.Span = named.name;
    val pre:  token.Span = np.prefix(rc.source, path);
    if (pre.len == 0 || pre.len >= path.len) { ret; }
    val leaf: token.Span = np.leaf(rc.source, path);
    if (leaf.len == 0) { ret; }

    val sid: SymbolId = path_tail_symbol(rc, pre);
    if (sid == SYMBOL_NIL) { ret; }
    if (rc.symbols[sid].kind == SYM_USE) { ret; }

    named.name      = pre;
    named.case_name = leaf;
}

# the tail symbol of a dotted path, without reporting: SYMBOL_NIL when any segment is unknown
fun path_tail_symbol(rc: *ResolveContext, path: token.Span) SymbolId {
    if (path.len == 0) { ret SYMBOL_NIL; }
    var cursor: usize = path.offset;
    val end:    usize = path.offset + path.len;
    var current_module: session.ModuleId = session.MODULE_NIL;
    var current_sym:    SymbolId         = SYMBOL_NIL;
    var first:          bool             = true;

    for (cursor < end) {
        val seg_span: token.Span = np.next(rc.source, path, ?cursor);
        if (seg_span.len == 0) { brk; }
        val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, seg_span);
        if (sel r.err) { ret SYMBOL_NIL; }
        val seg_name: intern.StrId = r.ok;

        if (first) {
            current_sym = scope_lookup_chain(rc, rc.current_scope, seg_name);
            first = false;
        }
        or {
            current_sym = lookup_in_module(rc, current_module, seg_name);
        }
        if (current_sym == SYMBOL_NIL) { ret SYMBOL_NIL; }
        if (cursor >= end) { brk; }
        if (rc.symbols[current_sym].kind != SYM_USE) { ret SYMBOL_NIL; }
        current_module = rc.symbols[current_sym].slot::session.ModuleId;
    }
    ret current_sym;
}

fun bind_type(rc: *ResolveContext, tid: id.TypeId) err[fail.Fail] {
    if (tid == id.TYPE_NIL) { ret err[fail.Fail].ok{}; }
    val t_opt: opt[*atype.Type] = ast.get_type_typed(rc.a, tid);
    if (!sel t_opt.some) { ret err[fail.Fail].err{fail.message("TypeId out of range")}; }
    val t: *atype.Type = t_opt.some;

    if (t.kind == atype.TYPE_KIND_NAMED) {
        val sid: SymbolId = resolve_type_path(rc, ?t.data.named, t.span);
        if (rc.type_resolved != nil) { rc.type_resolved[tid] = sid; }
        var ai: u32 = 0;
        for (ai < t.data.named.args_len) {
            val arg_id: id.TypeId = rc.a.type_ids[t.data.named.args_start + ai];
            val r: err[fail.Fail] = bind_type(rc, arg_id);
            if (sel r.err) { ret r; }
            ai = ai + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (t.kind == atype.TYPE_KIND_PTR) {
        ret bind_type(rc, t.data.ptr.pointee);
    }
    if (t.kind == atype.TYPE_KIND_SECRET) {
        ret bind_type(rc, t.data.secret.inner);
    }
    if (t.kind == atype.TYPE_KIND_POINTEE_OF) {
        ret bind_type(rc, t.data.pointee_of.inner);
    }
    if (t.kind == atype.TYPE_KIND_DISCRIMINANT_OF) {
        ret bind_type(rc, t.data.discriminant_of.inner);
    }
    if (t.kind == atype.TYPE_KIND_FIELD_TYPE) {
        val fr: res[intern.StrId, A.Error] =
            intern.intern_span_typed(?rc.s.interner, rc.source, t.data.field_type.var_name);
        if (sel fr.err) { fail.internal(?rc.status, alloc.text(fr.err)); ret err[fail.Fail].err{fail.refused(fr.err)}; }
        val fsid: SymbolId = scope_lookup_chain(rc, rc.current_scope, fr.ok);
        if (fsid == SYMBOL_NIL) {
            ret report(rc, t.data.field_type.var_name,
                "`f.type` as a type argument names a `$each` field-descriptor loop variable; this name is not one in scope");
        }
        val fsym: *Symbol = ?rc.symbols[fsid];
        if (fsym.kind != SYM_VAL || (fsym.flags & SYM_FLAG_COMPTIME) == 0) {
            ret report(rc, t.data.field_type.var_name,
                "`f.type` as a type argument names a `$each` field-descriptor loop variable; this name is an ordinary binding");
        }
        ret err[fail.Fail].ok{};
    }
    if (t.kind == atype.TYPE_KIND_ARRAY) {
        if (t.data.array.length != id.EXPR_NIL) {
            val re: err[fail.Fail] = bind_expr(rc, t.data.array.length);
            if (sel re.err) { ret re; }
        }
        ret bind_type(rc, t.data.array.element);
    }
    if (t.kind == atype.TYPE_KIND_FUN) {
        var pi: u32 = 0;
        for (pi < t.data.fun_.params_len) {
            val pt: id.TypeId = rc.a.type_ids[t.data.fun_.params_start + pi];
            val r: err[fail.Fail] = bind_type(rc, pt);
            if (sel r.err) { ret r; }
            pi = pi + 1;
        }
        ret bind_type(rc, t.data.fun_.ret_type);
    }
    if (t.kind == atype.TYPE_KIND_REC || t.kind == atype.TYPE_KIND_UNI) {
        var fields_start: u32 = 0;
        var fields_len:   u32 = 0;
        if (t.kind == atype.TYPE_KIND_REC) {
            fields_start = t.data.rec_.fields_start;
            fields_len   = t.data.rec_.fields_len;
        }
        or {
            fields_start = t.data.uni_.fields_start;
            fields_len   = t.data.uni_.fields_len;
        }
        var fi: u32 = 0;
        for (fi < fields_len) {
            val tn: *decl.TypedName = ?rc.a.typed_names[fields_start + fi];
            val r: err[fail.Fail] = bind_type(rc, tn.ty);
            if (sel r.err) { ret r; }
            fi = fi + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (t.kind == atype.TYPE_KIND_PACK || t.kind == atype.TYPE_KIND_ERROR) { ret err[fail.Fail].ok{}; }
    ret unknown_kind(rc, "AstTypeKind", t.kind::u32);
}

fun resolve_type_path(rc: *ResolveContext, named: *atype.TypeNamed, full: token.Span) SymbolId {
    val path: token.Span = named.name;
    if (path.len == 0) { ret SYMBOL_NIL; }

    var cursor: usize = path.offset;
    val end: usize = path.offset + path.len;

    var current_module: session.ModuleId = session.MODULE_NIL;
    var current_sym:    SymbolId      = SYMBOL_NIL;
    var first:          bool          = true;

    for (cursor < end) {
        val seg_span: token.Span = np.next(rc.source, path, ?cursor);
        if (seg_span.len == 0) { brk; }

        val r: res[intern.StrId, A.Error] = intern.intern_span_typed(?rc.s.interner, rc.source, seg_span);
        if (sel r.err) { fail.internal(?rc.status, alloc.text(r.err)); ret SYMBOL_NIL; }
        val seg_name: intern.StrId = r.ok;

        if (first) {
            val is_single: bool = cursor >= end;
            if (is_single) {
                val rs: res[TypeSpelling, fail.Fail] = type_spelling(rc, seg_name);
                if (sel rs.err) { fail.internal(?rc.status, fail.describe(rs.err)); ret SYMBOL_NIL; }
                val sp: TypeSpelling = rs.ok;
                if (sp.status == TYPE_SPELL_VEC_REFUSED) {
                    report_vector_refused(rc, full, seg_name, sp.form);
                    ret SYMBOL_NIL;
                }
                current_sym = sp.sym;
            }
            if (current_sym == SYMBOL_NIL) {
                current_sym = scope_lookup_chain(rc, rc.current_scope, seg_name);
            }
            first = false;
        }
        or {
            current_sym = lookup_in_module(rc, current_module, seg_name);
        }

        if (current_sym == SYMBOL_NIL) {
            if (seg_span.offset == path.offset && cursor >= end) {
                val re: err[fail.Fail] = report_named(rc, full, "unresolved type name `", seg_name, "`");
                if (sel re.ok) { attach_suggestion(rc, full, seg_name); }
            }
            or {
                report_named(rc, full, "unresolved type name `", seg_name, "`");
            }
            ret SYMBOL_NIL;
        }

        if (cursor >= end) { brk; }

        val sym: *Symbol = ?rc.symbols[current_sym];
        if (sym.kind == SYM_USE) {
            current_module = sym.slot::session.ModuleId;
        }
        or {
            record_report(rc, full, "expected a module alias before `.`");
            ret SYMBOL_NIL;
        }
    }

    ret current_sym;
}

fun lookup_in_module(rc: *ResolveContext, m: session.ModuleId, name: intern.StrId) SymbolId {
    val mx: *ModuleExports = find_module_exports_by_module(rc, m);
    if (mx == nil) { ret SYMBOL_NIL; }
    val ps: *PublicSymbol = find_export(mx, name);
    if (ps == nil) { ret SYMBOL_NIL; }
    val sid_r: res[SymbolId, fail.Fail] = imported_symbol_for(rc, ps);
    if (sel sid_r.err) { fail.internal(?rc.status, fail.describe(sid_r.err)); ret SYMBOL_NIL; }
    ret sid_r.ok;
}

fun remap_symbol_refs(refs: *SymbolId, len: u32, remap: *u32, sym_len: u32) {
    if (refs == nil) { ret; }
    var i: u32 = 0;
    for (i < len) {
        val sid: SymbolId = refs[i];
        if (sid != SYMBOL_NIL && sid::u32 < sym_len) {
            refs[i] = remap[sid::u32]::SymbolId;
        }
        i = i + 1;
    }
}

fun build_result(rc: *ResolveContext) res[ResolveResult, fail.Fail] {
    if (sel rc.status.kind.internal) {
        val message: str = rc.status.kind.internal;
        dnit_context(rc);
        ret res[ResolveResult, fail.Fail].err{fail.message(message)};
    }
    var pub_count: u32 = 0;
    var i: u32 = 0;
    for (i < rc.sym_len) {
        if ((rc.symbols[i].flags & SYM_FLAG_PUB) != 0) {
            pub_count = pub_count + 1;
        }
        i = i + 1;
    }

    val r_syms: res[*Symbol, A.Error] = A.allocate[Symbol](rc.s.alloc, rc.sym_len::usize);
    if (sel r_syms.err) { fail.internal(?rc.status, alloc.text(r_syms.err));
        dnit_context(rc);
        ret res[ResolveResult, fail.Fail].err{fail.refused(r_syms.err)};
    }
    val out_syms: *Symbol = r_syms.ok;

    var remap: *u32 = nil;
    if (rc.sym_len > 0) {
        val r_remap: res[*u32, A.Error] = A.allocate[u32](rc.s.alloc, rc.sym_len::usize);
        if (sel r_remap.err) { fail.internal(?rc.status, alloc.text(r_remap.err));
            A.deallocate[Symbol](rc.s.alloc, out_syms, rc.sym_len::usize);
            dnit_context(rc);
            ret res[ResolveResult, fail.Fail].err{fail.refused(r_remap.err)};
        }
        remap = r_remap.ok;
    }

    var pi: u32 = 0;
    var ni: u32 = pub_count;
    var k:  u32 = 0;
    for (k < rc.sym_len) {
        if ((rc.symbols[k].flags & SYM_FLAG_PUB) != 0) {
            out_syms[pi] = rc.symbols[k];
            remap[k]     = pi;
            pi = pi + 1;
        }
        or {
            out_syms[ni] = rc.symbols[k];
            remap[k]     = ni;
            ni = ni + 1;
        }
        k = k + 1;
    }

    remap_symbol_refs(rc.expr_resolved, rc.a.expr_len::u32, remap, rc.sym_len);
    remap_symbol_refs(rc.type_resolved, rc.a.type_len::u32, remap, rc.sym_len);
    remap_symbol_refs(rc.decl_symbol,   rc.a.decl_len::u32, remap, rc.sym_len);

    if (remap != nil) { A.deallocate[u32](rc.s.alloc, remap, rc.sym_len::usize); }

    var si: u32 = 0;
    for (si < rc.sym_len) {
        val sym: *Symbol = ?out_syms[si];
        sym.origin_stable = stable_of_module(rc.s, sym.origin);
        if (sym.kind == SYM_USE) {
            sym.slot_stable = stable_of_module(rc.s, sym.slot::session.ModuleId);
        }
        or {
            sym.slot_stable = session.STABLE_MODULE_NIL;
        }
        si = si + 1;
    }

    var param_index: map.Map[u64, SymbolId] = map.init[u64, SymbolId](rc.s.alloc, map.hash_u64, map.eq_u64);
    var pk: u32 = 0;
    for (pk < rc.sym_len) {
        if (out_syms[pk].kind == SYM_PARAM) {
            val key: u64 = (out_syms[pk].decl::u64 << 32) | out_syms[pk].slot::u64;
            val ins: res[bool, A.Error] = map.insert[u64, SymbolId](?param_index, key, pk);
            if (sel ins.err) {
                map.dnit[u64, SymbolId](?param_index);
                A.deallocate[Symbol](rc.s.alloc, out_syms, rc.sym_len::usize);
                dnit_context(rc);
                ret res[ResolveResult, fail.Fail].err{fail.refused(ins.err)};
            }
        }
        pk = pk + 1;
    }

    var constant_count: u32 = 0;
    val constants: res[*ExportConstant, fail.Fail] = public_constants_copy(rc, out_syms, pub_count, ?constant_count);
    if (sel constants.err) { fail.internal(?rc.status, fail.describe(constants.err));
        map.dnit[u64, SymbolId](?param_index);
        A.deallocate[Symbol](rc.s.alloc, out_syms, rc.sym_len::usize);
        dnit_context(rc);
        ret res[ResolveResult, fail.Fail].err{constants.err};
    }

    var out: ResolveResult;
    out.status        = rc.status;
    out.alloc         = rc.s.alloc;
    out.symbols       = out_syms;
    out.symbol_count  = rc.sym_len;
    out.pub_count     = pub_count;
    out.expr_resolved = rc.expr_resolved;
    out.type_resolved = rc.type_resolved;
    out.decl_symbol   = rc.decl_symbol;
    out.expr_count    = rc.a.expr_len::u32;
    out.type_count    = rc.a.type_len::u32;
    out.decl_count    = rc.a.decl_len::u32;
    out.param_index   = param_index;
    out.public_constants = constants.ok;
    out.public_constant_count = constant_count;

    out.expr_choices = rc.expr_choices;
    out.expr_choices_count = rc.expr_choices_count;

    rc.expr_resolved = nil;
    rc.type_resolved = nil;
    rc.decl_symbol   = nil;
    rc.expr_choices = nil;
    rc.expr_choices_count = 0;

    dnit_context(rc);
    ret res[ResolveResult, fail.Fail].ok{out};
}

fun public_constants_copy(rc: *ResolveContext, symbols: *Symbol, count: u32,
                          copied_count: *u32) res[*ExportConstant, fail.Fail] {
    @copied_count = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        if (symbols[i].kind == SYM_VAL && (symbols[i].flags & SYM_FLAG_MODULE) != 0) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret res[*ExportConstant, fail.Fail].ok{nil}; }
    val allocated: res[*ExportConstant, A.Error] = A.allocate[ExportConstant](rc.s.alloc, n::usize);
    if (sel allocated.err) { ret res[*ExportConstant, fail.Fail].err{fail.refused(allocated.err)}; }
    val constants: *ExportConstant = allocated.ok;
    var written: u32 = 0;
    i = 0;
    for (i < count) {
        val symbol: *Symbol = ?symbols[i];
        if (symbol.kind == SYM_VAL && (symbol.flags & SYM_FLAG_MODULE) != 0) {
            var item: ExportConstant = ExportConstant{};
            item.name = symbol.name;
            val named: opt[comptime.NamedConst] = comptime.lookup_typed(rc.ctx, symbol.name);
            # a constant element points into this module's syntax tree and cannot cross a module boundary
            if (sel named.some) {
                if (named.some.value.kind != comptime.CT_KIND_CONST_ELEM) {
                    val constant: comptime.NamedConst = named.some;
                    item.present = true;
                    item.gated = constant.gated;
                    item.value = constant.value;
                }
            }
            constants[written] = item;
            written = written + 1;
        }
        i = i + 1;
    }
    @copied_count = n;
    if (sel allocated.err) { ret res[*ExportConstant, fail.Fail].err{fail.refused(allocated.err)}; }
    ret res[*ExportConstant, fail.Fail].ok{allocated.ok};
}

fun report(rc: *ResolveContext, span: token.Span, message: str) err[fail.Fail] {
    fail.reject(?rc.status);
    val r: R.Result[R.Void, str] = diagnostic.error(rc.diags, rc.a.file_id, span, message);
    if (R.is_err[R.Void, str](r)) {
        fail.internal(?rc.status, R.unwrap_err[R.Void, str](r));
        ret err[fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](r))};
    }
    ret err[fail.Fail].ok{};
}

# the diagnostic text belongs to the session interner, not a resolver candidate
pub fun unknown_catalog(s: *session.Session, catalog: str, tag: u32) str {
    ret fail.catalog_message(?s.interner, s.alloc, fail.unknown_member(catalog, tag));
}

fun unknown_kind(rc: *ResolveContext, catalog: str, tag: u32) err[fail.Fail] {
    val message: str = unknown_catalog(rc.s, catalog, tag);
    fail.internal(?rc.status, message);
    ret err[fail.Fail].err{fail.message(message)};
}

fun record_report(rc: *ResolveContext, span: token.Span, message: str) {
    val r: err[fail.Fail] = report(rc, span, message);
    if (sel r.err) { fail.internal(?rc.status, fail.describe(r.err)); }
}

fun t_vector_refusal_owner(refuse: bool) i32 {
    var backing: A.Allocator;
    val make_1: err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?backing);
    if (R.is_err[session.Session, str](sr)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    val nr: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, "u32x4294967296");
    if (sel nr.err) { ret 3; }
    val form: type.VecForm = type.vector_form("u32x4294967296");
    if (form.status != type.VEC_FORM_TOO_WIDE) { ret 4; }
    var a: ast.Ast = ast.init(?backing, 0);
    fin { ast.dnit(?a); }
    var rc: ResolveContext;
    rc.s = ?s;
    rc.diags = ?s.diags;
    rc.a = ?a;
    rc.status = fail.accepted();
    var span: token.Span;
    span.offset = 0;
    span.len = 0;
    var t: T.Testing;
    val make_2: err[A.Error] = T.make(?t);
    if (sel make_2.err) { ret 5; }
    fin { T.dnit(?t); }
    if (refuse) { T.fail_at_ordinal(?t, 1); }
    val original: *A.Allocator = s.alloc;
    s.alloc = T.allocator_of(?t);
    val r: err[fail.Fail] = report_vector_refused(?rc, span, nr.ok, form);
    s.alloc = original;
    if (refuse) {
        if (sel r.ok) { ret 6; }
        if (!sel rc.status.kind.internal) { ret 6; }
    } or {
        if (sel r.err) { ret 7; }
        if (!sel rc.status.kind.rejected) { ret 7; }
    }
    if (T.live_count(?t) != 0 || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { ret 8; }
    ret 0;
}

test "mach.lang.fe.resolve:oversized_vector_diagnostic_releases_its_only_message" {
    ret t_vector_refusal_owner(false);
}

test "mach.lang.fe.resolve:oversized_vector_diagnostic_preserves_allocation_refusal" {
    ret t_vector_refusal_owner(true);
}

test "mach.lang.fe.resolve:diagnostic_refusal_marks_partial_result_internal" {
    var backing: A.Allocator;
    val make_1: err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?backing);
    if (R.is_err[session.Session, str](sr)) { ret 2; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);
    fin { session.dnit(?s); }
    var a: ast.Ast = ast.init(?backing, 0);
    fin { ast.dnit(?a); }
    var rc: ResolveContext;
    rc.s = ?s;
    rc.diags = ?s.diags;
    rc.a = ?a;
    rc.status = fail.accepted();
    var span: token.Span;
    span.offset = 0;
    span.len = 0;
    var t: T.Testing;
    val make_2: err[A.Error] = T.make(?t);
    if (sel make_2.err) { ret 3; }
    fin { T.dnit(?t); }
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(T.allocator_of(?t));
    T.fail_at_ordinal(?t, 1);
    val r: err[fail.Fail] = report_named(?rc, span, "invalid name", intern.STR_NIL, "");
    diagnostic.store_dnit(?s.diags);
    s.diags = diagnostic.store_init(?backing);
    if (sel r.ok) { ret 4; }
    if (!sel rc.status.kind.internal) { ret 4; }
    if (T.attempt_count(?t) != 1 || T.leaked(?t) || T.double_free_count(?t) != 0) { ret 5; }
    ret 0;
}

rec SymbolGrowthProbe {
    allocations: u32;
    reallocations: u32;
    deallocations: u32;
    old_size: usize;
    new_size: usize;
}

fun t_symbol_growth_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    val p: *SymbolGrowthProbe = ctx::*SymbolGrowthProbe;
    p.allocations = p.allocations + 1;
    ret opt[ptr].none{};
}

fun t_symbol_growth_reallocate(ctx: ptr, item: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val p: *SymbolGrowthProbe = ctx::*SymbolGrowthProbe;
    p.reallocations = p.reallocations + 1;
    p.old_size = old_size;
    p.new_size = new_size;
    ret opt[ptr].none{};
}

fun t_symbol_growth_deallocate(ctx: ptr, item: ptr, size: usize, align: usize) i64 {
    val p: *SymbolGrowthProbe = ctx::*SymbolGrowthProbe;
    p.deallocations = p.deallocations + 1;
    ret -1;
}

fun t_symbol_growth_boundary(exhausted: bool) i32 {
    var probe: SymbolGrowthProbe;
    probe.allocations = 0;
    probe.reallocations = 0;
    probe.deallocations = 0;
    probe.old_size = 0;
    probe.new_size = 0;
    var alloc: A.Allocator;
    alloc.ctx = (?probe)::ptr;
    alloc.fn_allocate = t_symbol_growth_allocate;
    alloc.fn_reallocate = t_symbol_growth_reallocate;
    alloc.fn_deallocate = t_symbol_growth_deallocate;
    var s: session.Session;
    s.alloc = ?alloc;
    var storage: [1]Symbol;
    storage[0].kind = SYM_FUN;
    var rc: ResolveContext;
    rc.s = ?s;
    rc.diags = ?s.diags;
    rc.status = fail.accepted();
    rc.symbols = ?storage[0];
    rc.sym_cap = 0x80000000;
    if (exhausted) { rc.sym_cap = SYMBOL_REJECTED; }
    rc.sym_len = rc.sym_cap;
    val old_cap: u32 = rc.sym_cap;
    val r: res[SymbolId, fail.Fail] = add_symbol(?rc, SYM_VAL, 0, intern.STR_NIL, intern.STR_NIL,
        id.DECL_NIL, 0, session.MODULE_NIL);
    if (sel r.ok) { ret 1; }
    if (!sel rc.status.kind.internal) { ret 1; }
    if (exhausted) {
        if (!str_equals(fail.describe(r.err), "resolver symbol table exhausted")) { ret 2; }
        if (probe.reallocations != 0) { ret 3; }
    } or {
        if ($size_of(usize) == 8) {
            if (!str_equals(fail.describe(r.err), "out of memory")) { ret 4; }
            if (probe.reallocations != 1 || probe.old_size != old_cap::usize * $size_of(Symbol)
                || probe.new_size != SYMBOL_REJECTED::usize * $size_of(Symbol)) { ret 5; }
        } or {
            if (!str_equals(fail.describe(r.err), "allocation size overflow")) { ret 6; }
            if (probe.reallocations != 0) { ret 7; }
        }
    }
    if (!str_equals(fail.status_text(rc.status), fail.describe(r.err))) { ret 8; }
    if (probe.allocations != 0 || probe.deallocations != 0) { ret 9; }
    if (rc.symbols != ?storage[0] || rc.sym_len != old_cap || rc.sym_cap != old_cap
        || storage[0].kind != SYM_FUN) { ret 10; }
    ret 0;
}

test "mach.lang.fe.resolve:reserved_binding_ids_are_never_allocated_as_symbols" {
    ret t_symbol_growth_boundary(true);
}

test "mach.lang.fe.resolve:symbol_growth_does_not_wrap_into_deallocation" {
    ret t_symbol_growth_boundary(false);
}

use std.types.string.str_contains;

test "mach.lang.fe.resolve:unknown_syntax_catalog_members_are_internal" {
    var alloc: A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var s: session.Session = session.Session{};
    s.alloc = ?alloc;
    s.interner = intern.init(?alloc);
    fin { intern.dnit(?s.interner); }
    var st: stmt.Stmt = stmt.Stmt{kind: 200};
    var ty: atype.Type = atype.Type{kind: 200};
    var ex: expr.Expr = expr.Expr{kind: 5};
    var de: decl.Decl = decl.Decl{kind: 200};
    var a: ast.Ast = ast.Ast{stmts: ?st, stmt_len: 1, types: ?ty, type_len: 1,
        exprs: ?ex, expr_len: 1, decls: ?de, decl_len: 1};
    var rc: ResolveContext = ResolveContext{s: ?s, a: ?a};
    val names: [6]str = [6]str{"StmtKind", "AstTypeKind", "ExprKind", "DeclKind", "DeclKind", "DeclKind"};
    var i: usize = 0;
    for (i < 6) {
        rc.status = fail.accepted();
        var r: err[fail.Fail];
        if (i == 0) { r = bind_stmt(?rc, 0); }
        or (i == 1) { r = bind_type(?rc, 0); }
        or (i == 2) { r = bind_expr(?rc, 0); }
        or (i == 3) { r = collect_one_decl(?rc, 0, 0, true); }
        or (i == 4) { r = bind_one_decl(?rc, 0); }
        or { r = bind_local_decl(?rc, 0); }
        if (sel r.ok) { ret 2; }
        if (!sel rc.status.kind.internal) { ret 2; }
        if (rc.status.rejections != 0) { ret 2; }
        if (!str_contains(fail.status_text(rc.status), names[i])) { ret 3; }
        val number: str = t_tag_number(i == 2);
        if (!str_contains(fail.status_text(rc.status), number)) { ret 4; }
        i = i + 1;
    }
    rc.status = fail.accepted();
    st.kind = stmt.STMT_KIND_ERROR;
    ty.kind = atype.TYPE_KIND_ERROR;
    ex.kind = expr.EXPR_KIND_ERROR;
    de.kind = decl.DECL_KIND_ERROR;
    val bound_stmt: err[fail.Fail] = bind_stmt(?rc, 0);
    val bound_type: err[fail.Fail] = bind_type(?rc, 0);
    val bound_expr: err[fail.Fail] = bind_expr(?rc, 0);
    val bound_decl: err[fail.Fail] = bind_one_decl(?rc, 0);
    if (sel bound_stmt.err) { ret 5; }
    if (sel bound_type.err) { ret 5; }
    if (sel bound_expr.err) { ret 5; }
    if (sel bound_decl.err) { ret 5; }
    ty.kind = atype.TYPE_KIND_PACK;
    st.kind = stmt.STMT_KIND_ASM;
    val bind_type_2: err[fail.Fail] = bind_type(?rc, 0);
    val bind_stmt_3: err[fail.Fail] = bind_stmt(?rc, 0);
    if (sel bind_type_2.err) { ret 6; }
    if (sel bind_stmt_3.err) { ret 6; }
    if (!sel rc.status.kind.accepted) { ret 6; }
    ret 0;
}

fun t_tag_number(hole: bool) str {
    if (hole) { ret "5"; }
    ret "200";
}

fun t_catalog_message_attempt(ordinal: usize, attempts: *usize) i32 {
    var t: T.Testing;
    val make_1: err[A.Error] = T.make(?t);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?t); }
    var s: session.Session = session.Session{};
    s.alloc = T.allocator_of(?t);
    s.interner = intern.init(s.alloc);
    var rc: ResolveContext = ResolveContext{s: ?s, status: fail.accepted()};
    T.fail_at_ordinal(?t, ordinal);
    val result: err[fail.Fail] = unknown_kind(?rc, "ExprKind", 200);
    @attempts = T.attempt_count(?t);
    var bad: i32 = 0;
    if (sel result.ok || !sel rc.status.kind.internal) { bad = 2; }
    or (ordinal == 0 && !str_equals(fail.status_text(rc.status), "unknown ExprKind tag 200")) { bad = 3; }
    or (ordinal != 0 && !str_equals(fail.status_text(rc.status), "out of memory")) { bad = 4; }
    intern.dnit(?s.interner);
    if (T.leaked(?t) || T.double_free_count(?t) != 0 || T.tracking_exhausted(?t)) { bad = 5; }
    ret bad;
}

test "mach.lang.fe.resolve:unknown_catalog_diagnostic_allocation_refusal_keeps_its_owner" {
    var attempts: usize = 0;
    val baseline: i32 = t_catalog_message_attempt(0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 1; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused: usize = 0;
        val code: i32 = t_catalog_message_attempt(ordinal, ?refused);
        if (code != 0) { ret code + 1; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
