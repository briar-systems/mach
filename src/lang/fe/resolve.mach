# a symbol's slot in the resolve context's symbol table
pub def SymbolId: u32;

pub val SYMBOL_NIL: SymbolId = 0xFFFFFFFF;
# an identifier visited and rejected by resolution has no symbol to remap.
val SYMBOL_REJECTED: SymbolId = 0xFFFFFFFE;

pub fun symbol_id(index: u32) SymbolId {
    var id: SymbolId;
    id = index;
    ret id;
}

pub fun symbol_index(id: SymbolId) u32 {
    ret id;
}

pub fun symbol_same(left: SymbolId, right: SymbolId) bool {
    ret left == right;
}

# whether an id is one of the sentinels, which name no symbol
pub fun symbol_is_sentinel(id: SymbolId) bool {
    ret id >= SYMBOL_RESERVED_MIN;
}

pub fun symbol_is_nil(id: SymbolId) bool {
    ret id == SYMBOL_NIL;
}

pub fun symbol_is_rejected(id: SymbolId) bool {
    ret id == SYMBOL_REJECTED;
}

# a name in an arm of a statement-level gate resolve could not decide, which resolved to
# nothing: sema reports it if it selects that arm, and an arm it discards reports nothing
#. one sentinel per message, so the report reads as resolve's would have.
val     SYMBOL_DEFERRED_NAME: SymbolId = 0xFFFFFFFD;
pub val SYMBOL_DEFERRED_TYPE: SymbolId = 0xFFFFFFFC;
# every id at or above this one is a sentinel, never a symbol
val SYMBOL_RESERVED_MIN: SymbolId = 0xFFFFFFFC;

pub fun symbol_deferred(sid: SymbolId) bool {
    ret symbol_same(sid, SYMBOL_DEFERRED_NAME) || symbol_same(sid, SYMBOL_DEFERRED_TYPE);
}

pub def SymKind: u8;

pub val SYM_FUN:      SymKind = 0;
pub val SYM_REC:      SymKind = 1;
pub val SYM_DEF:      SymKind = 2;
pub val SYM_VAL:      SymKind = 3;
pub val SYM_VAR:      SymKind = 4;
pub val SYM_PARAM:    SymKind = 5;
pub val SYM_GENERIC:  SymKind = 6;
pub val SYM_USE:      SymKind = 7;
pub val SYM_IMPORTED: SymKind = 8;
# reached only by mach-lsp
pub val SYM_TEST:   SymKind = 9;
pub val SYM_UNI:    SymKind = 10;
pub val SYM_PRIM:   SymKind = 11;
pub val SYM_VECTOR: SymKind = 12;
pub val SYM_TAG:    SymKind = 13;

val SYM_KIND_COUNT: u32 = 14;

pub fun sym_kind_valid(kind: SymKind) bool {
    ret kind::u32 < SYM_KIND_COUNT;
}

# reached only by mach-lsp
pub val SYM_FLAG_PUB: u8 = 1;

pub val SYM_FLAG_COMPTIME: u8 = 2;

pub val SYM_FLAG_MODULE: u8 = 4;

# something stores to the local or parameter, takes its address or names it in an asm block,
# so it has storage of its own. one without the flag is only ever read
pub val SYM_FLAG_STORED: u8 = 8;

# the address of something reached from the local or parameter by name, a field or an element,
# is taken. where it is an aggregate held by value, a pointer into it then exists
pub val SYM_FLAG_REACHED: u8 = 16;

# an assignment writes a field or element reached from the local or parameter by name, so
# what it holds changes in part where nothing stores to it whole
pub val SYM_FLAG_WRITTEN: u8 = 32;

# an imported symbol is shared by every binding of the same definition that carries the
# same notice and testing mark, so a `#[deprecated]` or `#[testing]` binding never taints a clean
# alias of the same canonical name
rec ImportedKey {
    origin:  module.StableModuleId;
    canon:   intern.StrId;
    notice:  deprecation.Deprecation;
    testing: bool;
}

fun imported_hash(k: *ImportedKey) u64 {
    var h: u64 = module.stable_index(k.origin)::u64 ^ (intern.str_index(k.canon)::u64 << 32);
    if (k.notice.present) { h = h ^ (lang_source.file_index(k.notice.owner)::u64 * 1099511628211) ^ intern.str_index(k.notice.message)::u64 ^ 1; }
    if (k.testing)        { h = h ^ 0x9e3779b97f4a7c15; }
    # the probe reads the low bits, which the origin alone would fill
    ret natural.hash[u64](?h);
}

fun imported_equal(x: *ImportedKey, y: *ImportedKey) bool {
    ret module.stable_same(x.origin, y.origin) && intern.str_same(x.canon, y.canon) && deprecation.equal(x.notice, y.notice) && x.testing == y.testing;
}

pub rec Symbol {
    kind:                SymKind;
    definition_kind:     SymKind;
    definition_file:     lang_source.FileId;
    generic_arity:       u32;
    has_comptime_params: bool;
    has_pack_param:      bool;
    deprecation:         deprecation.Deprecation;
    testing:             bool;
    flags:               u8;
    name:                intern.StrId;
    canon:               intern.StrId;
    decl:                ast_id.DeclId;
    # a `use` symbol's slot is the stable id of the module it names
    slot: u32;
    # the module the symbol is defined in. a result outlives the operation that numbered the
    # modules, so it names modules by stable id and a reader numbers them through origin_of
    origin: module.StableModuleId;
}

pub rec PublicSymbol {
    kind:                SymKind;
    name:                intern.StrId;
    canon:               intern.StrId;
    file:                lang_source.FileId;
    generic_arity:       u32;
    has_comptime_params: bool;
    has_pack_param:      bool;
    deprecation:         deprecation.Deprecation;
    testing:             bool;
    # a `use` symbol's slot is the stable id of the module it names
    slot:   u32;
    origin: module.StableModuleId;
}

# what a module exports to an importer, every module it names by stable id
pub rec ModuleExports {
    path:    intern.StrId;
    module:  module.StableModuleId;
    symbols: *PublicSymbol;
    count:   u32;
    # `(name << 32) | index` of each symbol, ascending, which find_export searches
    by_name: *u64;
    # the module refused itself, and that refusal is its diagnostic, so a missing name is not one
    refused: bool;
}

# a constant an importer reads, whose per-tuple gate is the published declaration's, not this record's
pub rec ExportConstant {
    name:    intern.StrId;
    present: bool;
    value:   comptime_value.CTValue;
}

pub rec ParsedDefinition {
    a:           *ast.Ast;
    status:      lang_phase.PhaseStatus;
    owner:       type.TypeOwner;
    incarnation: u64;
}

# what a module's resolve reads of the modules it imports
# ---
# entries:       the public surface of each module it may name
# bindings:      the load's record of each of its import declarations, which resolve binds
#                from rather than reading their paths; a declaration with none is bound by
#                its path
# binding_count: how many records `bindings` holds
pub rec ResolveDeps {
    entries:       *ModuleExports;
    count:         u32;
    bindings:      *fe_load.Binding;
    binding_count: u32;
}

def ScopeId: u32;

val SCOPE_NIL: ScopeId = 0xFFFFFFFF;

fun scope_id(index: u32) ScopeId {
    var id: ScopeId;
    id = index;
    ret id;
}

fun scope_index(id: ScopeId) u32 {
    ret id;
}

fun scope_same(left: ScopeId, right: ScopeId) bool {
    ret left == right;
}

fun scope_is_nil(id: ScopeId) bool {
    ret id == SCOPE_NIL;
}

rec ScopeEntry {
    name: intern.StrId;
    sym:  SymbolId;
}

rec Scope {
    parent:  ScopeId;
    entries: *ScopeEntry;
    len:     u32;
    cap:     u32;
}

# a module-scope `use` of a symbol, which is unused until something names it
rec SymbolImport {
    name: intern.StrId;
    span: lang_source.Span;
    used: bool;
}

val INITIAL_SCOPES_CAP:  u32 = 8;
val INITIAL_SYMBOLS_CAP: u32 = 32;

rec ResolveContext {
    diags:      *diagnostic.DiagnosticStore;
    status:     lang_phase.PhaseStatus;
    s:          *session.Session;
    a:          *ast.Ast;
    deps:       *ResolveDeps;
    ctx:        *comptime_scope.ComptimeCtx;
    caps:       comptime_capability.PhaseCapabilities[ResolveContext];
    own_stable: module.StableModuleId;
    source:     str;
    # binding an arm of a statement-level gate that only sema can decide
    in_deferred_arm: bool;

    symbols: *Symbol;
    sym_len: u32;
    sym_cap: u32;

    expr_resolved: *SymbolId;
    type_resolved: *SymbolId;
    decl_symbol:   *SymbolId;

    scopes:    *Scope;
    scope_len: u32;
    scope_cap: u32;

    module_scope:  ScopeId;
    current_scope: ScopeId;

    prim_names: [type_prim.PRIM_COUNT]intern.StrId;
    prim_syms:  [type_prim.PRIM_COUNT]SymbolId;

    vec_cache: map.Map[intern.StrId, SymbolId];

    imported_cache: map.MapBy[ImportedKey, SymbolId];

    module_index: map.Map[intern.StrId, SymbolId];

    # names bound from a refused module: a use of one is that refusal again, not a new error
    refused_names: map.Map[intern.StrId, SymbolId];

    # a lint for the project being built, never its dependencies
    lint_imports:   bool;
    symbol_imports: collections_vector.Vector[SymbolImport];
    # `fwd` paths, which use the imports they name once every import is collected
    fwd_paths: collections_vector.Vector[lang_source.Span];
    asm_binds: collections_vector.Vector[AsmBind];

    expr_choices:       *interpretation.Choice;
    expr_choices_count: usize;
    # how each literal head's path reads, one per type node; the parsed tree is never rewritten
    type_heads: *interpretation.Head;
}

pub rec ResolveResult {
    status:        lang_phase.PhaseStatus;
    alloc:         *A.Allocator;
    symbols:       *Symbol;
    symbol_count:  u32;
    pub_count:     u32;
    expr_resolved: *SymbolId;
    type_resolved: *SymbolId;
    decl_symbol:   *SymbolId;
    expr_count:    u32;
    type_count:    u32;
    decl_count:    u32;

    param_index: map.Map[u64, SymbolId];
    # the record, union and tag symbols the module defines, by nominal_key (see own_nominal)
    nominals: map.Map[u64, SymbolId];
    # every symbol the module declares, by nominal_key (see own_declared)
    declared: map.Map[u64, SymbolId];

    public_constants:      *ExportConstant;
    public_constant_count: u32;

    # the constants resolve bound and the gates it decided, over the load's
    constants: comptime_scope.Bindings;

    expr_choices:       *interpretation.Choice;
    expr_choices_count: usize;
    # how each literal head's path reads, `type_count` of them: as written, or as a type and the
    # tag case its last segment selects
    type_heads: *interpretation.Head;

    # the local each `{name}` of an asm block binds
    asm_binds: collections_vector.Vector[AsmBind];

    # a module-scope `$error` in a decided arm refused the module, so nothing else was resolved
    refused: bool;
}

# one `{name}` of an asm block and the local it binds
pub rec AsmBind {
    stmt:   ast_id.StmtId;
    name:   intern.StrId;
    symbol: SymbolId;
}

pub fun param_symbol(r: *ResolveResult, decl: ast_id.DeclId, slot: u32) SymbolId {
    var key:                   u64            = (ast_id.decl_index(decl)::u64 << 32) | slot::u64;
    val opt_param_index_entry: opt[*SymbolId] = map.get[u64, SymbolId](?r.param_index, ?key);
    if (sel opt_param_index_entry.some) { ret @opt_param_index_entry.some; }
    ret SYMBOL_NIL;
}

# a nominal the module defines named by more than one declaration
pub val SYMBOL_AMBIGUOUS: SymbolId = 0xFFFFFFFD;

fun nominal_key(kind: SymKind, canon: intern.StrId) u64 {
    ret (kind::u64 << 32) | intern.str_index(canon)::u64;
}

fun nominal_kind(kind: SymKind) bool {
    ret kind == SYM_REC || kind == SYM_UNI || kind == SYM_TAG;
}

# the symbol of the record, union or tag of `kind` the module defines under `canon`: SYMBOL_NIL
# when it defines none, SYMBOL_AMBIGUOUS when more than one declaration does
pub fun own_nominal(r: *ResolveResult, kind: SymKind, canon: intern.StrId) SymbolId {
    val key:                u64            = nominal_key(kind, canon);
    val opt_nominals_entry: opt[*SymbolId] = map.get[u64, SymbolId](?r.nominals, ?key);
    if (sel opt_nominals_entry.some) { ret @opt_nominals_entry.some; }
    ret SYMBOL_NIL;
}

# the symbol of `kind` the module declares under `canon`, the last of them: SYMBOL_NIL when it
# declares none, SYMBOL_AMBIGUOUS when more than one declaration does
pub fun own_declared(r: *ResolveResult, kind: SymKind, canon: intern.StrId) SymbolId {
    val key:                u64            = nominal_key(kind, canon);
    val opt_declared_entry: opt[*SymbolId] = map.get[u64, SymbolId](?r.declared, ?key);
    if (sel opt_declared_entry.some) { ret @opt_declared_entry.some; }
    ret SYMBOL_NIL;
}

# file each symbol `own` declares under nominal_key, the last of one name and kind where they
# share a declaration; two declarations of one name and kind file it as ambiguous
fun declared_index(syms: *Symbol, count: u32, own: module.StableModuleId, out: *map.Map[u64, SymbolId]) err[A.Error] {
    var i: u32 = 0;
    for (i < count) {
        val sym: *Symbol = ?syms[i];
        if (!ast_id.decl_is_nil(sym.decl) && module.stable_same(sym.origin, own)) {
            val key:       u64            = nominal_key(sym.kind, sym.canon);
            var id:        SymbolId       = symbol_id(i);
            val opt_prior: opt[*SymbolId] = map.get[u64, SymbolId](out, ?key);
            if (sel opt_prior.some) {
                val was: SymbolId = @opt_prior.some;
                if (was == SYMBOL_AMBIGUOUS || !ast_id.decl_same(syms[was].decl, sym.decl)) { id = SYMBOL_AMBIGUOUS; }
            }
            val res_ins: res[bool, A.Error] = map.insert[u64, SymbolId](out, key, id);
            if (sel res_ins.err) { ret err[A.Error].err{res_ins.err}; }
        }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

# file each record, union and tag symbol `own` defines under nominal_key; two declarations of one
# name and kind file it as ambiguous
fun nominals_index(syms: *Symbol, count: u32, own: module.StableModuleId, out: *map.Map[u64, SymbolId]) err[A.Error] {
    var i: u32 = 0;
    for (i < count) {
        val sym: *Symbol = ?syms[i];
        if (nominal_kind(sym.kind) && module.stable_same(sym.origin, own)) {
            val key:       u64            = nominal_key(sym.kind, sym.canon);
            var id:        SymbolId       = symbol_id(i);
            val opt_prior: opt[*SymbolId] = map.get[u64, SymbolId](out, ?key);
            if (sel opt_prior.some) {
                id = @opt_prior.some;
                if (id != SYMBOL_AMBIGUOUS && !ast_id.decl_same(syms[id].decl, sym.decl)) { id = SYMBOL_AMBIGUOUS; }
            }
            val res_ins: res[bool, A.Error] = map.insert[u64, SymbolId](out, key, id);
            if (sel res_ins.err) { ret err[A.Error].err{res_ins.err}; }
        }
        i = i + 1;
    }
    ret err[A.Error].ok{};
}

pub fun stable_of_module(s: *session.Session, mid: module.ModuleId) module.StableModuleId {
    if (module.is_nil(mid)) { ret module.STABLE_MODULE_NIL; }
    val fqn: intern.StrId = module.module_fqn(?s.modules, mid);
    if (intern.str_is_nil(fqn)) { ret module.STABLE_MODULE_NIL; }
    ret module.stable_module_id_lookup(?s.modules, fqn);
}

pub fun type_owner(s: *session.Session, mid: module.ModuleId, file: lang_source.FileId) type.TypeOwner {
    ret type.TypeOwner{module: stable_of_module(s, mid), file: file};
}

# the module a symbol is defined in, as the current operation numbers it
pub fun origin_of(s: *session.Session, sym: *Symbol) module.ModuleId {
    ret module.module_id_for_stable(?s.modules, sym.origin);
}

# whether `sym` names a binding a module other than `own` declares: an import, or a `fwd` of one,
# which carries the kind the binding is declared with there as its own
pub fun foreign_to(s: *session.Session, sym: *Symbol, own: module.ModuleId) bool {
    ret !module.same(origin_of(s, sym), own);
}

# the module a `use` symbol names, as the current operation numbers it
pub fun use_target(s: *session.Session, sym: *Symbol) module.ModuleId {
    ret module.module_id_for_stable(?s.modules, sym.slot::module.StableModuleId);
}

# the stable id of the module a `use` symbol names, nil for any other symbol
pub fun use_stable(sym: *Symbol) module.StableModuleId {
    if (sym.kind != SYM_USE) { ret module.STABLE_MODULE_NIL; }
    ret sym.slot::module.StableModuleId;
}

# the modules an importer's resolution reads: how many are loaded, with ids below that count,
# what each one exports, and the path it is imported by
# ---
# exports: what a module exports to an importer, its symbols allocated from the allocator given;
#          reading it is what makes the importer's resolution depend on the exporter's surface
pub rec Exporters {
    ctx:     ptr;
    count:   u32;
    exports: fun(ptr, module.ModuleId, *A.Allocator) res[ModuleExports, fail.Fail];
    path:    fun(ptr, module.ModuleId) intern.StrId;
}

fun list_holds(list: *module.ModuleId, len: u32, id: module.ModuleId) bool {
    var i: u32 = 0;
    for (i < len) {
        if (module.same(list[i], id)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what a finished resolution of module `stable` exports to an importer
# ---
# alloc: owns the returned symbols, released with the ModuleExports they are in
pub fun result_exports(alloc: *A.Allocator, rr: *ResolveResult, path: intern.StrId,
    stable: module.StableModuleId) res[ModuleExports, fail.Fail] {
    var mx: ModuleExports = ModuleExports{path: path, module: stable, refused: rr != nil && rr.refused};
    if (rr == nil || rr.pub_count == 0) { ret res[ModuleExports, fail.Fail].ok{mx}; }
    val res_allocate: res[*PublicSymbol, A.Error] = A.allocate[PublicSymbol](alloc, rr.pub_count::usize);
    if (sel res_allocate.err) { ret res[ModuleExports, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val syms: *PublicSymbol = res_allocate.ok;
    var i:    u32           = 0;
    for (i < rr.pub_count) {
        val sym: *Symbol = ?rr.symbols[i];
        var ps:  PublicSymbol;
        ps.kind                = sym.definition_kind;
        ps.name                = sym.name;
        ps.canon               = sym.canon;
        ps.file                = sym.definition_file;
        ps.generic_arity       = sym.generic_arity;
        ps.has_comptime_params = sym.has_comptime_params;
        ps.has_pack_param      = sym.has_pack_param;
        ps.deprecation         = sym.deprecation;
        ps.testing             = sym.testing;
        ps.slot                = sym.slot;
        ps.origin              = sym.origin;
        syms[i]                = ps;
        i                      = i + 1;
    }
    mx.symbols = syms;
    mx.count   = rr.pub_count;
    val res_keys: res[*u64, A.Error] = A.allocate[u64](alloc, mx.count::usize);
    if (sel res_keys.err) {
        A.deallocate[PublicSymbol](alloc, syms, mx.count::usize);
        ret res[ModuleExports, fail.Fail].err{fail.refused(res_keys.err)};
    }
    i = 0;
    for (i < mx.count) {
        res_keys.ok[i] = (intern.str_index(syms[i].name)::u64 << 32) | i::u64;
        i              = i + 1;
    }
    sort.sort[u64](res_keys.ok, mx.count::usize);
    mx.by_name = res_keys.ok;
    ret res[ModuleExports, fail.Fail].ok{mx};
}

# an importer's own copy of `from`, under the importer's path for it
# ---
# alloc: owns the copy, released with exports_dnit
pub fun exports_copy(alloc: *A.Allocator, from: *ModuleExports, path: intern.StrId, stable: module.StableModuleId) res[ModuleExports, fail.Fail] {
    var mx: ModuleExports = ModuleExports{path: path, module: stable, refused: from.refused};
    if (from.count == 0) { ret res[ModuleExports, fail.Fail].ok{mx}; }
    val res_syms: res[*PublicSymbol, A.Error] = A.allocate[PublicSymbol](alloc, from.count::usize);
    if (sel res_syms.err) { ret res[ModuleExports, fail.Fail].err{fail.refused(res_syms.err)}; }
    val res_keys: res[*u64, A.Error] = A.allocate[u64](alloc, from.count::usize);
    if (sel res_keys.err) {
        A.deallocate[PublicSymbol](alloc, res_syms.ok, from.count::usize);
        ret res[ModuleExports, fail.Fail].err{fail.refused(res_keys.err)};
    }
    memory.raw_copy(res_syms.ok::ptr, from.symbols::ptr, from.count::usize * $size_of(PublicSymbol));
    memory.raw_copy(res_keys.ok::ptr, from.by_name::ptr, from.count::usize * $size_of(u64));
    mx.symbols = res_syms.ok;
    mx.by_name = res_keys.ok;
    mx.count   = from.count;
    ret res[ModuleExports, fail.Fail].ok{mx};
}

# release what an exports record owns
pub fun exports_dnit(alloc: *A.Allocator, mx: *ModuleExports) {
    if (mx.count == 0) { ret; }
    A.deallocate[PublicSymbol](alloc, mx.symbols, mx.count::usize);
    A.deallocate[u64](alloc, mx.by_name, mx.count::usize);
    mx.symbols = nil;
    mx.by_name = nil;
    mx.count   = 0;
}

# the exports module `m` of loader `l` reads: each loaded module it imports and every module a
# reached one re-exports, each once, allocated from `alloc` and released with deps_dnit
pub fun deps_of(alloc: *A.Allocator, s: *session.Session, l: *fe_load.Loader, m: *fe_load.Module, from: *Exporters) res[ResolveDeps, fail.Fail] {
    var deps: ResolveDeps = ResolveDeps{};
    if (m.deps.len == 0) { ret res[ResolveDeps, fail.Fail].ok{deps}; }
    val res_allocate: res[*module.ModuleId, A.Error] = A.allocate[module.ModuleId](alloc, from.count::usize);
    if (sel res_allocate.err) { ret res[ResolveDeps, fail.Fail].err{fail.refused(res_allocate.err)}; }
    val list:               *module.ModuleId             = res_allocate.ok;
    var len:                u32                          = 0;
    val res_allocate_alloc: res[*ModuleExports, A.Error] = A.allocate[ModuleExports](alloc, from.count::usize);
    if (sel res_allocate_alloc.err) {
        A.deallocate[module.ModuleId](alloc, list, from.count::usize);
        ret res[ResolveDeps, fail.Fail].err{fail.refused(res_allocate_alloc.err)};
    }
    deps.entries = res_allocate_alloc.ok;
    var cap: u32 = from.count;
    fin {
        A.deallocate[module.ModuleId](alloc, list, from.count::usize);
    }
    # a gated import is one only an arm this build does not select makes
    var i: usize = 0;
    for (i < m.deps.len) {
        val d: module.ModuleId = fe_load.module_of(l, m.deps.data[i]);
        if (d::u32 < from.count && !list_holds(list, len, d) && !fe_load.gated_at(l, d)) {
            list[len] = d;
            len       = len + 1;
        }
        i = i + 1;
    }
    var head: u32 = 0;
    for (head < len) {
        val res_exports: res[ModuleExports, fail.Fail] = from.exports(from.ctx, list[head], alloc);
        if (sel res_exports.err) {
            deps_entries_dnit(alloc, ?deps, cap);
            ret res[ResolveDeps, fail.Fail].err{res_exports.err};
        }
        deps.entries[head] = res_exports.ok;
        deps.count         = head + 1;
        var k: u32 = 0;
        for (k < res_exports.ok.count) {
            val ps: *PublicSymbol = ?res_exports.ok.symbols[k];
            if (ps.kind == SYM_USE) {
                val target: module.ModuleId = module.module_id_for_stable(?s.modules, ps.slot::module.StableModuleId);
                if (target::u32 < from.count && !list_holds(list, len, target)) {
                    list[len] = target;
                    len       = len + 1;
                }
            }
            k = k + 1;
        }
        head = head + 1;
    }
    # the entries were sized for every loaded module; keep only those read
    if (len == 0) {
        A.deallocate[ModuleExports](alloc, deps.entries, cap::usize);
        deps.entries = nil;
        ret res[ResolveDeps, fail.Fail].ok{deps};
    }
    val res_fitted: res[*ModuleExports, A.Error] = A.allocate[ModuleExports](alloc, len::usize);
    if (sel res_fitted.err) {
        deps_entries_dnit(alloc, ?deps, cap);
        ret res[ResolveDeps, fail.Fail].err{fail.refused(res_fitted.err)};
    }
    var e: u32 = 0;
    for (e < len) {
        res_fitted.ok[e] = deps.entries[e];
        e                = e + 1;
    }
    A.deallocate[ModuleExports](alloc, deps.entries, cap::usize);
    deps.entries = res_fitted.ok;
    ret res[ResolveDeps, fail.Fail].ok{deps};
}

# release the entries deps_of read so far, from an entry array of `cap` slots
fun deps_entries_dnit(alloc: *A.Allocator, deps: *ResolveDeps, cap: u32) {
    var i: u32 = 0;
    for (i < deps.count) {
        exports_dnit(alloc, ?deps.entries[i]);
        i = i + 1;
    }
    A.deallocate[ModuleExports](alloc, deps.entries, cap::usize);
    deps.entries = nil;
    deps.count   = 0;
}

# release what deps_of allocated; a list it left empty owns nothing
pub fun deps_dnit(alloc: *A.Allocator, deps: *ResolveDeps) {
    if (deps.entries == nil) { ret; }
    var i: u32 = 0;
    for (i < deps.count) {
        exports_dnit(alloc, ?deps.entries[i]);
        i = i + 1;
    }
    A.deallocate[ModuleExports](alloc, deps.entries, deps.count::usize);
    deps.entries = nil;
    deps.count   = 0;
}

# release a resolution; a nil result holds nothing
pub fun result_dnit(r: *ResolveResult) {
    if (r == nil) { ret; }
    if (r.symbols != nil && r.symbol_count > 0) {
        A.deallocate[Symbol](r.alloc, r.symbols, r.symbol_count::usize);
    }
    if (r.expr_resolved != nil) {
        A.deallocate[SymbolId](r.alloc, r.expr_resolved, r.expr_count::usize);
    }
    if (r.type_resolved != nil) {
        A.deallocate[SymbolId](r.alloc, r.type_resolved, r.type_count::usize);
    }
    if (r.decl_symbol != nil) {
        A.deallocate[SymbolId](r.alloc, r.decl_symbol, r.decl_count::usize);
    }
    if (r.public_constants != nil && r.public_constant_count > 0) {
        A.deallocate[ExportConstant](r.alloc, r.public_constants, r.public_constant_count::usize);
    }
    if (r.expr_choices != nil && r.expr_choices_count != 0) {
        A.deallocate[interpretation.Choice](r.alloc, r.expr_choices, r.expr_choices_count);
    }
    if (r.type_heads != nil && r.type_count != 0) {
        A.deallocate[interpretation.Head](r.alloc, r.type_heads, r.type_count::usize);
    }
    map.dnit[u64, SymbolId](?r.param_index);
    map.dnit[u64, SymbolId](?r.nominals);
    map.dnit[u64, SymbolId](?r.declared);
    collections_vector.dnit[AsmBind](?r.asm_binds);
    comptime_scope.bindings_dnit(?r.constants);
    r.symbols               = nil;
    r.symbol_count          = 0;
    r.pub_count             = 0;
    r.expr_resolved         = nil;
    r.type_resolved         = nil;
    r.decl_symbol           = nil;
    r.expr_count            = 0;
    r.type_count            = 0;
    r.decl_count            = 0;
    r.public_constants      = nil;
    r.public_constant_count = 0;
    r.expr_choices          = nil;
    r.expr_choices_count    = 0;
    r.type_heads            = nil;
}

# an owned copy of `r` from `alloc`, every entry at the id it has in `r`
pub fun result_copy(r: *ResolveResult, alloc: *A.Allocator) res[ResolveResult, fail.Fail] {
    var out: ResolveResult = ResolveResult{status: r.status, alloc: alloc, symbol_count: r.symbol_count, pub_count: r.pub_count,
        expr_count:         r.expr_count, type_count: r.type_count, decl_count: r.decl_count, public_constant_count: r.public_constant_count,
        expr_choices_count: r.expr_choices_count, refused: r.refused,
        param_index:        map.init[u64, SymbolId](alloc), nominals: map.init[u64, SymbolId](alloc), declared: map.init[u64, SymbolId](alloc),
        constants:          comptime_scope.bindings_init(alloc)};
    var done: bool = false;
    fin {
        if (!done) { result_dnit(?out); }
    }
    val res_symbols: res[*Symbol, A.Error] = array_copy[Symbol](alloc, r.symbols, r.symbol_count::usize);
    if (sel res_symbols.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_symbols.err)}; }
    out.symbols = res_symbols.ok;
    val res_exprs: res[*SymbolId, A.Error] = array_copy[SymbolId](alloc, r.expr_resolved, r.expr_count::usize);
    if (sel res_exprs.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_exprs.err)}; }
    out.expr_resolved = res_exprs.ok;
    val res_types: res[*SymbolId, A.Error] = array_copy[SymbolId](alloc, r.type_resolved, r.type_count::usize);
    if (sel res_types.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_types.err)}; }
    out.type_resolved = res_types.ok;
    val res_decls: res[*SymbolId, A.Error] = array_copy[SymbolId](alloc, r.decl_symbol, r.decl_count::usize);
    if (sel res_decls.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_decls.err)}; }
    out.decl_symbol = res_decls.ok;
    val res_constants: res[*ExportConstant, A.Error] = array_copy[ExportConstant](alloc, r.public_constants, r.public_constant_count::usize);
    if (sel res_constants.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_constants.err)}; }
    out.public_constants = res_constants.ok;
    val res_choices: res[*interpretation.Choice, A.Error] = array_copy[interpretation.Choice](alloc, r.expr_choices, r.expr_choices_count);
    if (sel res_choices.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_choices.err)}; }
    out.expr_choices = res_choices.ok;
    val res_heads: res[*interpretation.Head, A.Error] = array_copy[interpretation.Head](alloc, r.type_heads, r.type_count::usize);
    if (sel res_heads.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_heads.err)}; }
    out.type_heads = res_heads.ok;
    map.dnit[u64, SymbolId](?out.param_index);
    val res_params: res[map.Map[u64, SymbolId], A.Error] = map.clone[u64, SymbolId](?r.param_index, alloc);
    if (sel res_params.err) {
        out.param_index = map.init[u64, SymbolId](alloc);
        ret res[ResolveResult, fail.Fail].err{fail.refused(res_params.err)};
    }
    out.param_index = res_params.ok;
    map.dnit[u64, SymbolId](?out.nominals);
    val res_nominals: res[map.Map[u64, SymbolId], A.Error] = map.clone[u64, SymbolId](?r.nominals, alloc);
    if (sel res_nominals.err) {
        out.nominals = map.init[u64, SymbolId](alloc);
        ret res[ResolveResult, fail.Fail].err{fail.refused(res_nominals.err)};
    }
    out.nominals = res_nominals.ok;
    map.dnit[u64, SymbolId](?out.declared);
    val res_declared: res[map.Map[u64, SymbolId], A.Error] = map.clone[u64, SymbolId](?r.declared, alloc);
    if (sel res_declared.err) {
        out.declared = map.init[u64, SymbolId](alloc);
        ret res[ResolveResult, fail.Fail].err{fail.refused(res_declared.err)};
    }
    out.declared = res_declared.ok;
    comptime_scope.bindings_dnit(?out.constants);
    val res_bound: res[comptime_scope.Bindings, fail.Fail] = comptime_scope.bindings_copy(?r.constants, alloc);
    if (sel res_bound.err) {
        out.constants = comptime_scope.bindings_init(alloc);
        ret res[ResolveResult, fail.Fail].err{res_bound.err};
    }
    out.constants = res_bound.ok;
    out.asm_binds = collections_vector.init[AsmBind](alloc);
    val res_binds: res[usize, A.Error] = collections_vector.reserve[AsmBind](?out.asm_binds, r.asm_binds.len);
    if (sel res_binds.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_binds.err)}; }
    var bi: usize = 0;
    for (bi < r.asm_binds.len) {
        out.asm_binds.data[bi] = r.asm_binds.data[bi];
        bi                     = bi + 1;
    }
    collections_vector.commit[AsmBind](?out.asm_binds, r.asm_binds.len);
    done = true;
    ret res[ResolveResult, fail.Fail].ok{out};
}

fun array_copy[T](alloc: *A.Allocator, src: *T, n: usize) res[*T, A.Error] {
    if (src == nil || n == 0) { ret res[*T, A.Error].ok{nil}; }
    val res_made: res[*T, A.Error] = A.allocate[T](alloc, n);
    if (sel res_made.err) { ret res_made; }
    var i: usize = 0;
    for (i < n) {
        res_made.ok[i] = src[i];
        i              = i + 1;
    }
    ret res_made;
}

# resolve a module's names in a scope over the load's, `load`, whose constants and gate decisions
# resolve reads and never writes; what resolve binds is its result's
pub fun resolve(
    s: *session.Session,
    a: *ast.Ast,
    deps: *ResolveDeps,
    load: *comptime_scope.ComptimeCtx,
    own_module: module.ModuleId,
    own_stable: module.StableModuleId,
    diags: *diagnostic.DiagnosticStore) res[ResolveResult, fail.Fail] {
    var scope: comptime_scope.ComptimeCtx = comptime_scope.stage_init(load, comptime_scope.STAGE_RESOLVE, s.alloc);
    fin { comptime_scope.dnit(?scope); }
    val err_gates: err[fail.Fail] = comptime_scope.prepare_gates(?scope, a.exprs.len::u32);
    if (sel err_gates.err) { ret res[ResolveResult, fail.Fail].err{err_gates.err}; }
    var rc:       ResolveContext;
    val err_init: err[fail.Fail] = init_context(?rc, s, a, deps, ?scope, own_module, own_stable, diags);
    if (sel err_init.err) { ret res[ResolveResult, fail.Fail].err{err_init.err}; }
    fin { dnit_context(?rc); }

    val res_open_scope: res[ScopeId, fail.Fail] = scope_init(?rc, SCOPE_NIL);
    if (sel res_open_scope.err) { ret res[ResolveResult, fail.Fail].err{res_open_scope.err}; }
    rc.module_scope  = res_open_scope.ok;
    rc.current_scope = rc.module_scope;

    val err_seed_primitives: err[fail.Fail] = seed_primitives(?rc);
    if (sel err_seed_primitives.err) { ret res[ResolveResult, fail.Fail].err{err_seed_primitives.err}; }

    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (!sel opt_module.some) { ret res[ResolveResult, fail.Fail].err{fail.message("root_module is not set on this Ast")}; }
    val mnode: *ast_module.Module = opt_module.some;

    # every other diagnostic in a refused module is a consequence of the refusal
    val res_refusal: res[bool, fail.Fail] = module_refusal(?rc, mnode.decls_start, mnode.decls_len);
    if (sel res_refusal.err) { ret res[ResolveResult, fail.Fail].err{res_refusal.err}; }
    if (res_refusal.ok) {
        val res_refused: res[ResolveResult, fail.Fail] = build_result(?rc);
        if (sel res_refused.err) { ret res_refused; }
        var refused: ResolveResult = res_refused.ok;
        refused.refused = true;
        ret res[ResolveResult, fail.Fail].ok{refused};
    }

    val err_decls_collected: err[fail.Fail] = collect_decl_list(?rc, mnode.decls_start, mnode.decls_len, rc.module_scope, true);
    if (sel err_decls_collected.err) { ret res[ResolveResult, fail.Fail].err{err_decls_collected.err}; }

    val err_register_constant_tags: err[fail.Fail] = register_constant_tags(?rc, mnode.decls_start, mnode.decls_len);
    if (sel err_register_constant_tags.err) { ret res[ResolveResult, fail.Fail].err{err_register_constant_tags.err}; }

    val err_decls_bound: err[fail.Fail] = bind_decl_list(?rc, mnode.decls_start, mnode.decls_len);
    if (sel err_decls_bound.err) { ret res[ResolveResult, fail.Fail].err{err_decls_bound.err}; }

    val err_warn_unused_imports: err[fail.Fail] = warn_unused_imports(?rc);
    if (sel err_warn_unused_imports.err) { ret res[ResolveResult, fail.Fail].err{err_warn_unused_imports.err}; }

    ret build_result(?rc);
}

# whether a constant's declared type may hold a secret, as name resolution reads it: a `^` in its
# spelling, or a name no primitive spells, which this phase cannot follow, so a gate it decides
# never reads the constant; type checking reads it by its type
fun spelled_secret(rc: *ResolveContext, ty: ast_id.TypeId, depth: u32) bool {
    if (ast_id.type_is_nil(ty) || depth > 64) { ret false; }
    val opt_found: opt[*ast_type.Type] = ast.get_type(rc.a, ty);
    if (sel opt_found.none) { ret false; }
    val t: *ast_type.Type = opt_found.some;
    if (t.kind == ast_type.TYPE_KIND_SECRET)                   { ret true; }
    if (t.kind == ast_type.TYPE_KIND_ARRAY)                    { ret spelled_secret(rc, t.data.array.element, depth + 1); }
    if (t.kind != ast_type.TYPE_KIND_NAMED)                    { ret t.kind == ast_type.TYPE_KIND_REC || t.kind == ast_type.TYPE_KIND_UNI; }
    if (t.data.named.args_len != 0)                            { ret true; }
    if (fe_path.prefix(rc.source, t.data.named.name).len != 0) { ret true; }
    val opt_prim: opt[type_kind.TypeKind] = type_prim.prim_from_view(view(?rc.source[t.data.named.name.offset], t.data.named.name.len));
    ret sel opt_prim.none;
}

# a module `val` constructed as a case literal is a constant tag, and a gate anywhere in the module
# may test it, so every top-level one is bound before any body is bound: the literal head is split
# into type and case now that the module's symbols are declared, which binding later leaves as is
fun register_constant_tags(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(rc.a, rc.a.decl_ids.data[start + i]);
        if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_VAL && !ast_id.expr_is_nil(d.data.bind.init)) {
            split_literal_head(rc, d.data.bind.init);
            val err_register_constant_tag: err[fail.Fail] = register_constant_tag(rc, d.data.bind.name, d.data.bind.init);
            if (sel err_register_constant_tag.err) { ret err_register_constant_tag; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun split_literal_head(rc: *ResolveContext, eid: ast_id.ExprId) {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some) { ret; }
    val tid: ast_id.TypeId = comptime.literal_head_type(opt_expr.some);
    if (ast_id.type_is_nil(tid)) { ret; }
    split_case_head(rc, tid);
}

fun init_context(
    rc: *ResolveContext,
    s: *session.Session,
    a: *ast.Ast,
    deps: *ResolveDeps,
    ctx: *comptime_scope.ComptimeCtx,
    own_module: module.ModuleId,
    own_stable: module.StableModuleId,
    diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    rc.status = lang_phase.accepted();
    rc.s      = s;
    rc.diags  = diags;
    rc.a      = a;
    rc.deps   = deps;
    rc.ctx    = ctx;
    val res_caps: res[comptime_capability.PhaseCapabilities[ResolveContext], fail.Fail] =
        comptime_capability.resolution_capabilities[ResolveContext](comptime_ident_is_runtime, comptime_expression, comptime_head);
    if (sel res_caps.err) {
        ret err[fail.Fail].err{res_caps.err};
    }
    rc.caps            = res_caps.ok;
    rc.own_stable      = own_stable;
    rc.in_deferred_arm = false;

    val opt_src: opt[*lang_source.SourceFile] = lang_source.get(s.sources, a.file_id);
    if (sel opt_src.none) {
        ret err[fail.Fail].err{fail.message("Ast.file_id not registered with the session")};
    }
    rc.source = opt_src.some.text;

    rc.symbols = nil;
    rc.sym_len = 0;
    rc.sym_cap = 0;

    rc.expr_resolved = nil;
    rc.type_resolved = nil;
    rc.decl_symbol   = nil;

    rc.scopes        = nil;
    rc.scope_len     = 0;
    rc.scope_cap     = 0;
    rc.module_scope  = SCOPE_NIL;
    rc.current_scope = SCOPE_NIL;

    var pi: u32 = 0;
    for (pi < type_prim.PRIM_COUNT) {
        rc.prim_names[pi] = intern.STR_NIL;
        rc.prim_syms[pi]  = SYMBOL_NIL;
        pi                = pi + 1;
    }

    rc.imported_cache = map.init_by[ImportedKey, SymbolId](s.alloc, imported_hash, imported_equal);
    rc.vec_cache      = map.init[intern.StrId, SymbolId](s.alloc);
    rc.module_index   = map.init[intern.StrId, SymbolId](s.alloc);
    rc.refused_names  = map.init[intern.StrId, SymbolId](s.alloc);
    rc.lint_imports   = module.module_is_root_project(?s.modules, own_module);
    rc.symbol_imports = collections_vector.init[SymbolImport](s.alloc);
    rc.fwd_paths      = collections_vector.init[lang_source.Span](s.alloc);
    rc.asm_binds      = collections_vector.init[AsmBind](s.alloc);

    rc.expr_choices       = nil;
    rc.expr_choices_count = 0;
    rc.type_heads         = nil;

    var handed: bool = false;
    fin {
        if (!handed) { dnit_context(rc); }
    }

    val res_allocate: res[*Symbol, A.Error] = A.allocate[Symbol](s.alloc, INITIAL_SYMBOLS_CAP::usize);
    if (sel res_allocate.err) {
        lang_phase.internal(?rc.status, fail.refused(res_allocate.err));
        ret err[fail.Fail].err{fail.refused(res_allocate.err)};
    }
    rc.symbols = res_allocate.ok;
    rc.sym_cap = INITIAL_SYMBOLS_CAP;

    val res_sca: res[*Scope, A.Error] = A.allocate[Scope](s.alloc, INITIAL_SCOPES_CAP::usize);
    if (sel res_sca.err) {
        lang_phase.internal(?rc.status, fail.refused(res_sca.err));
        ret err[fail.Fail].err{fail.refused(res_sca.err)};
    }
    rc.scopes    = res_sca.ok;
    rc.scope_cap = INITIAL_SCOPES_CAP;

    if (a.exprs.len > 0) {
        val res_allocate: res[*SymbolId, A.Error] = A.allocate[SymbolId](s.alloc, a.exprs.len);
        if (sel res_allocate.err) {
            lang_phase.internal(?rc.status, fail.refused(res_allocate.err));
            ret err[fail.Fail].err{fail.refused(res_allocate.err)};
        }
        rc.expr_resolved = res_allocate.ok;
        memory.fill[SymbolId](rc.expr_resolved, SYMBOL_NIL, a.exprs.len);
        val res_choices: res[*interpretation.Choice, A.Error] = A.allocate[interpretation.Choice](s.alloc, a.exprs.len);
        if (sel res_choices.err) {
            lang_phase.internal(?rc.status, fail.refused(res_choices.err));
            ret err[fail.Fail].err{fail.refused(res_choices.err)};
        }
        rc.expr_choices       = res_choices.ok;
        rc.expr_choices_count = a.exprs.len;
        memory.fill[interpretation.Choice](rc.expr_choices, interpretation.PARSED, a.exprs.len);
    }
    if (a.types.len > 0) {
        val res_allocate: res[*SymbolId, A.Error] = A.allocate[SymbolId](s.alloc, a.types.len);
        if (sel res_allocate.err) {
            lang_phase.internal(?rc.status, fail.refused(res_allocate.err));
            ret err[fail.Fail].err{fail.refused(res_allocate.err)};
        }
        rc.type_resolved = res_allocate.ok;
        memory.fill[SymbolId](rc.type_resolved, SYMBOL_NIL, a.types.len);
        val res_heads: res[*interpretation.Head, A.Error] = A.allocate[interpretation.Head](s.alloc, a.types.len);
        if (sel res_heads.err) {
            lang_phase.internal(?rc.status, fail.refused(res_heads.err));
            ret err[fail.Fail].err{fail.refused(res_heads.err)};
        }
        rc.type_heads = res_heads.ok;
        memory.fill[interpretation.Head](rc.type_heads, interpretation.HEAD_PARSED, a.types.len);
    }
    if (a.decls.len > 0) {
        val res_allocate: res[*SymbolId, A.Error] = A.allocate[SymbolId](s.alloc, a.decls.len);
        if (sel res_allocate.err) {
            lang_phase.internal(?rc.status, fail.refused(res_allocate.err));
            ret err[fail.Fail].err{fail.refused(res_allocate.err)};
        }
        rc.decl_symbol = res_allocate.ok;
        memory.fill[SymbolId](rc.decl_symbol, SYMBOL_NIL, a.decls.len);
    }

    handed = true;
    ret err[fail.Fail].ok{};
}

fun dnit_context(rc: *ResolveContext) {
    var i: u32 = 0;
    for (i < rc.scope_len) {
        val sc: *Scope = ?rc.scopes[i];
        if (sc.entries != nil && sc.cap > 0) {
            A.deallocate[ScopeEntry](rc.s.alloc, sc.entries, sc.cap::usize);
        }
        i = i + 1;
    }
    if (rc.scopes != nil && rc.scope_cap > 0) {
        A.deallocate[Scope](rc.s.alloc, rc.scopes, rc.scope_cap::usize);
    }
    if (rc.symbols != nil && rc.sym_cap > 0) {
        A.deallocate[Symbol](rc.s.alloc, rc.symbols, rc.sym_cap::usize);
    }
    if (rc.expr_resolved != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.expr_resolved, rc.a.exprs.len);
    }
    if (rc.type_resolved != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.type_resolved, rc.a.types.len);
    }
    if (rc.decl_symbol != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.decl_symbol, rc.a.decls.len);
    }
    if (rc.expr_choices != nil && rc.expr_choices_count != 0) {
        A.deallocate[interpretation.Choice](rc.s.alloc, rc.expr_choices, rc.expr_choices_count);
    }
    if (rc.type_heads != nil) {
        A.deallocate[interpretation.Head](rc.s.alloc, rc.type_heads, rc.a.types.len);
    }
    map.dnit_by[ImportedKey, SymbolId](?rc.imported_cache);
    map.dnit[intern.StrId, SymbolId](?rc.vec_cache);
    map.dnit[intern.StrId, SymbolId](?rc.module_index);
    map.dnit[intern.StrId, SymbolId](?rc.refused_names);
    collections_vector.dnit[SymbolImport](?rc.symbol_imports);
    collections_vector.dnit[lang_source.Span](?rc.fwd_paths);
    collections_vector.dnit[AsmBind](?rc.asm_binds);
}

fun scope_init(rc: *ResolveContext, parent: ScopeId) res[ScopeId, fail.Fail] {
    val err_grown: err[A.Error] = growth.reserve[Scope](rc.s.alloc, ?rc.scopes, ?rc.scope_cap, rc.scope_len::usize + 1);
    if (sel err_grown.err) {
        lang_phase.internal(?rc.status, fail.refused(err_grown.err));
        ret res[ScopeId, fail.Fail].err{fail.refused(err_grown.err)};
    }
    var sc: Scope;
    sc.parent  = parent;
    sc.entries = nil;
    sc.len     = 0;
    sc.cap     = 0;
    val sid: ScopeId = scope_id(rc.scope_len);
    rc.scopes[rc.scope_len] = sc;
    rc.scope_len            = rc.scope_len + 1;
    ret res[ScopeId, fail.Fail].ok{sid};
}

fun scope_add(rc: *ResolveContext, scope: ScopeId, name: intern.StrId, sym: SymbolId) err[fail.Fail] {
    val sc:        *Scope       = ?rc.scopes[scope_index(scope)];
    val err_grown: err[A.Error] = growth.reserve[ScopeEntry](rc.s.alloc, ?sc.entries, ?sc.cap, sc.len::usize + 1);
    if (sel err_grown.err) {
        lang_phase.internal(?rc.status, fail.refused(err_grown.err));
        ret err[fail.Fail].err{fail.refused(err_grown.err)};
    }
    var e: ScopeEntry;
    e.name             = name;
    e.sym              = sym;
    sc.entries[sc.len] = e;
    sc.len             = sc.len + 1;

    if (scope_same(scope, rc.module_scope)) {
        val res_ins: res[bool, A.Error] = map.insert[intern.StrId, SymbolId](?rc.module_index, name, sym);
        if (sel res_ins.err) { ret err[fail.Fail].err{fail.refused(res_ins.err)}; }
    }
    ret err[fail.Fail].ok{};
}

fun scope_lookup_local(rc: *ResolveContext, scope: ScopeId, name: intern.StrId) SymbolId {
    if (scope_is_nil(scope)) { ret SYMBOL_NIL; }
    if (scope_same(scope, rc.module_scope)) {
        val opt_module_index_entry: opt[*SymbolId] = map.get[intern.StrId, SymbolId](?rc.module_index, ?name);
        if (sel opt_module_index_entry.some) { ret @opt_module_index_entry.some; }
        ret SYMBOL_NIL;
    }
    val sc: *Scope = ?rc.scopes[scope_index(scope)];
    var i:  u32    = 0;
    for (i < sc.len) {
        if (intern.str_same(sc.entries[i].name, name)) { ret sc.entries[i].sym; }
        i = i + 1;
    }
    ret SYMBOL_NIL;
}

fun scope_lookup_chain(rc: *ResolveContext, scope: ScopeId, name: intern.StrId) SymbolId {
    var cur: ScopeId = scope;
    for (!scope_is_nil(cur)) {
        val found: SymbolId = scope_lookup_local(rc, cur, name);
        if (!symbol_is_nil(found)) {
            if (scope_same(cur, rc.module_scope)) { mark_import_used(rc, name); }
            ret found;
        }
        cur = rc.scopes[scope_index(cur)].parent;
    }
    ret SYMBOL_NIL;
}

# the notice a declaration's own `#[deprecated]` decorator records; a malformed decorator is
# reported by type checking and records nothing here
fun declaration_deprecation(c: *comptime_scope.ComptimeCtx, a: *ast.Ast, did: ast_id.DeclId) res[deprecation.Deprecation, fail.Fail] {
    val opt_defining: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (!sel opt_defining.some) { ret res[deprecation.Deprecation, fail.Fail].ok{deprecation.none()}; }
    val d: *ast_decl.Decl = opt_defining.some;
    ret decorators_deprecation(c, a, d.decorators_start, d.decorators_len);
}

# the message is the string the argument evaluates to; one that is not a
# constant string is reported by type checking and leaves the notice bare
pub fun decorators_deprecation(c: *comptime_scope.ComptimeCtx, a: *ast.Ast, start: u32, len: u32) res[deprecation.Deprecation, fail.Fail] {
    var notice: deprecation.Deprecation = deprecation.none();
    var i:      u32                     = 0;
    for (i < len) {
        val dec: *ast_decl.Decorator = ?a.decorators.data[start + i];
        i = i + 1;
        if (dec.id != decorator.DEPRECATED) { cnt; }
        if (dec.args_len > 1)               { ret res[deprecation.Deprecation, fail.Fail].ok{notice}; }
        if (dec.args_len == 1) {
            val message: intern.StrId = decorator.string_id(c, a, dec, 0);
            if (intern.str_is_nil(message)) { ret res[deprecation.Deprecation, fail.Fail].ok{notice}; }
            notice.message = message;
        }
        notice.present = true;
        notice.owner   = a.file_id;
        ret res[deprecation.Deprecation, fail.Fail].ok{notice};
    }
    ret res[deprecation.Deprecation, fail.Fail].ok{notice};
}

# whether a declaration carries `#[testing]`, which confines every reference to it to test code
pub fun declaration_testing(a: *ast.Ast, did: ast_id.DeclId) bool {
    val opt_defining: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (!sel opt_defining.some) { ret false; }
    ret decorator.has(a, opt_defining.some, decorator.TESTING);
}

# a `use` symbol's slot is the stable id of the module it names
fun add_symbol(rc: *ResolveContext, kind: SymKind, flags: u8, name: intern.StrId, canon: intern.StrId, decl_id: ast_id.DeclId, slot: u32, origin: module.StableModuleId) res[SymbolId, fail.Fail] {
    if (rc.sym_len >= symbol_index(SYMBOL_RESERVED_MIN)) {
        val message: str = "resolver symbol table exhausted";
        lang_phase.internal(?rc.status, fail.message(message));
        ret res[SymbolId, fail.Fail].err{fail.message(message)};
    }
    val err_grown: err[A.Error] = growth.reserve[Symbol](rc.s.alloc, ?rc.symbols, ?rc.sym_cap, rc.sym_len::usize + 1);
    if (sel err_grown.err) {
        lang_phase.internal(?rc.status, fail.refused(err_grown.err));
        ret res[SymbolId, fail.Fail].err{fail.refused(err_grown.err)};
    }
    var sym: Symbol;
    sym.kind            = kind;
    sym.definition_kind = kind;
    sym.definition_file = lang_source.FILE_NIL;
    sym.generic_arity   = 0;
    sym.deprecation     = deprecation.none();
    sym.testing         = false;
    if (rc.a != nil && module.stable_same(origin, rc.own_stable) && kind != SYM_PARAM && kind != SYM_GENERIC) {
        val res_notice: res[deprecation.Deprecation, fail.Fail] = declaration_deprecation(rc.ctx, rc.a, decl_id);
        if (sel res_notice.err) { ret res[SymbolId, fail.Fail].err{res_notice.err}; }
        sym.deprecation = res_notice.ok;
        sym.testing     = declaration_testing(rc.a, decl_id);
    }
    if (rc.a != nil && module.stable_same(origin, rc.own_stable)) {
        sym.definition_file = rc.a.file_id;
        val opt_defining: opt[*ast_decl.Decl] = ast.get_decl(rc.a, decl_id);
        if (sel opt_defining.some) {
            val d: *ast_decl.Decl = opt_defining.some;
            if (d.kind == ast_decl.DECL_KIND_FUN) {
                sym.generic_arity = d.data.fun_.generics_len;
                var pi: u32 = 0;
                for (pi < d.data.fun_.params_len) {
                    val parameter: *ast_decl.TypedName = ?rc.a.typed_names.data[d.data.fun_.params_start + pi];
                    if (parameter.comptime) { sym.has_comptime_params = true; }
                    val opt_type: opt[*ast_type.Type] = ast.get_type(rc.a, parameter.ty);
                    if (sel opt_type.some && opt_type.some.kind == ast_type.TYPE_KIND_PACK) { sym.has_pack_param = true; }
                    pi = pi + 1;
                }
            }
            or (d.kind == ast_decl.DECL_KIND_REC) { sym.generic_arity = d.data.rec_.generics_len; }
            or (d.kind == ast_decl.DECL_KIND_UNI) { sym.generic_arity = d.data.uni_.generics_len; }
            or (d.kind == ast_decl.DECL_KIND_TAG) { sym.generic_arity = d.data.tag_.generics_len; }
        }
    }
    sym.flags  = flags;
    sym.name   = name;
    sym.canon  = canon;
    sym.decl   = decl_id;
    sym.slot   = slot;
    sym.origin = origin;
    val sid: SymbolId = symbol_id(rc.sym_len);
    rc.symbols[rc.sym_len] = sym;
    rc.sym_len             = rc.sym_len + 1;
    ret res[SymbolId, fail.Fail].ok{sid};
}

fun declare(
    rc: *ResolveContext,
    kind: SymKind,
    flags: u8,
    name: lang_source.Span,
    decl_id: ast_id.DeclId,
    slot: u32,
    origin: module.StableModuleId,
    scope: ScopeId) res[SymbolId, fail.Fail] {
    if (name.len == 0) {
        ret res[SymbolId, fail.Fail].ok{SYMBOL_NIL};
    }
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, name.offset, name.len);
    if (sel res_range_add.err) {
        lang_phase.internal(?rc.status, fail.refused(res_range_add.err));
        ret res[SymbolId, fail.Fail].err{fail.refused(res_range_add.err)};
    }
    val name_id: intern.StrId = res_range_add.ok;

    val err_reject_builtin_type_name: err[fail.Fail] = reject_builtin_type_name(rc, kind, name, name_id);
    if (sel err_reject_builtin_type_name.err) { ret res[SymbolId, fail.Fail].err{err_reject_builtin_type_name.err}; }
    val err_reject_vector_spelled_type: err[fail.Fail] = reject_vector_spelled_type(rc, kind, name, name_id);
    if (sel err_reject_vector_spelled_type.err) { ret res[SymbolId, fail.Fail].err{err_reject_vector_spelled_type.err}; }

    val existing: SymbolId = scope_lookup_local(rc, scope, name_id);
    if (!symbol_is_nil(existing)) {
        report_duplicate(rc, name, "duplicate definition: `", name_id, "` is already bound in this scope", existing);
        ret res[SymbolId, fail.Fail].ok{SYMBOL_NIL};
    }

    val res_sym: res[SymbolId, fail.Fail] = add_symbol(rc, kind, flags, name_id, name_id, decl_id, slot, origin);
    if (sel res_sym.err) {
        lang_phase.internal(?rc.status, res_sym.err);
        ret res_sym;
    }
    val sid: SymbolId = res_sym.ok;

    val err_add: err[fail.Fail] = scope_add(rc, scope, name_id, sid);
    if (sel err_add.err) {
        ret res[SymbolId, fail.Fail].err{err_add.err};
    }

    ret res[SymbolId, fail.Fail].ok{sid};
}

# the symbol kinds that bind a name in type position
fun declares_type(kind: SymKind) bool {
    ret kind == SYM_REC || kind == SYM_UNI || kind == SYM_TAG || kind == SYM_DEF || kind == SYM_GENERIC;
}

# a declared type or generic parameter may not take a primitive's name: every use in
# type position resolves to the primitive, so the declaration would be unreachable
fun reject_builtin_type_name(rc: *ResolveContext, kind: SymKind, name: lang_source.Span, name_id: intern.StrId) err[fail.Fail] {
    if (!declares_type(kind)) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < type_prim.PRIM_COUNT) {
        if (intern.str_same(rc.prim_names[i], name_id)) {
            ret report_named(rc, diagnostic_kind.NAME_BUILTIN_TYPE, name, "`", name_id,
                "` is a built-in type, so it cannot also name a declared type; every use of the name resolves to the built-in");
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun attach_prior_binding(rc: *ResolveContext, b: *diagnostic.DiagnosticBuilder, prior: SymbolId) err[fail.Fail] {
    if (module.stable_same(rc.symbols[symbol_index(prior)].origin, rc.own_stable) && !ast_id.decl_is_nil(rc.symbols[symbol_index(prior)].decl)) {
        val prev: lang_source.Span = prior_name_span(rc, rc.symbols[symbol_index(prior)].decl);
        if (prev.len != 0) { ret diagnostic.attach_related(b, rc.a.file_id, prev, "previous definition here"); }
    }
    ret diagnostic.attach_note(b, "a name with this spelling is already bound here");
}

fun prior_name_span(rc: *ResolveContext, decl_id: ast_id.DeclId) lang_source.Span {
    val span: lang_source.Span = ast.decl_name_span(rc.a, decl_id);
    if (span.len != 0) { ret span; }

    val opt_d: opt[*ast_decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (!sel opt_d.some) { ret span; }
    val d: *ast_decl.Decl = opt_d.some;

    if (d.kind == ast_decl.DECL_KIND_USE) { ret leaf_span(rc, d.data.use_.path); }
    if (d.kind == ast_decl.DECL_KIND_FWD) { ret leaf_span(rc, d.data.fwd_.path); }
    ret span;
}

fun seed_primitives(rc: *ResolveContext) err[fail.Fail] {
    var k: u32 = 0;
    for (k < type_prim.PRIM_COUNT) {
        val kind:                   type_kind.TypeKind = type_prim.prim_kind_at(k);
        val err_seed_one_primitive: err[fail.Fail]     = seed_one_primitive(rc, k, type_prim.prim_name(kind), kind::u32);
        if (sel err_seed_one_primitive.err) { ret err_seed_one_primitive; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# the symbol's slot is the TypeKind; the tables are indexed by catalog position
fun seed_one_primitive(rc: *ResolveContext, index: u32, name: str, kind_ordinal: u32) err[fail.Fail] {
    val res_interner_added: res[intern.StrId, A.Error] = intern.add(?rc.s.interner, name);
    if (sel res_interner_added.err) {
        lang_phase.internal(?rc.status, fail.refused(res_interner_added.err));
        ret err[fail.Fail].err{fail.refused(res_interner_added.err)};
    }
    val name_id: intern.StrId = res_interner_added.ok;

    val res_sym: res[SymbolId, fail.Fail] = add_symbol(rc, SYM_PRIM, 0, name_id, name_id, ast_id.DECL_NIL, kind_ordinal, rc.own_stable);
    if (sel res_sym.err) {
        lang_phase.internal(?rc.status, res_sym.err);
        ret err[fail.Fail].err{res_sym.err};
    }
    val sid: SymbolId = res_sym.ok;

    rc.prim_names[index] = name_id;
    rc.prim_syms[index]  = sid;
    ret err[fail.Fail].ok{};
}

def TypeSpellStatus: u8;

val TYPE_SPELL_NONE:        TypeSpellStatus = 0;
val TYPE_SPELL_FOUND:       TypeSpellStatus = 1;
val TYPE_SPELL_VEC_REFUSED: TypeSpellStatus = 2;

rec TypeSpelling {
    status: TypeSpellStatus;
    sym:    SymbolId;
    form:   type_prim.VecForm;
}

fun type_spelling(rc: *ResolveContext, name: intern.StrId) res[TypeSpelling, fail.Fail] {
    var out: TypeSpelling;
    out.status = TYPE_SPELL_NONE;
    out.sym    = SYMBOL_NIL;

    var i: u32 = 0;
    for (i < type_prim.PRIM_COUNT) {
        if (intern.str_same(rc.prim_names[i], name)) {
            out.status = TYPE_SPELL_FOUND;
            out.sym    = rc.prim_syms[i];
            ret res[TypeSpelling, fail.Fail].ok{out};
        }
        i = i + 1;
    }

    val opt_cached: opt[*SymbolId] = map.get[intern.StrId, SymbolId](?rc.vec_cache, ?name);
    if (sel opt_cached.some) {
        out.status = TYPE_SPELL_FOUND;
        out.sym    = @opt_cached.some;
        ret res[TypeSpelling, fail.Fail].ok{out};
    }

    val opt_interner_entry: opt[str] = intern.get(?rc.s.interner, name);
    if (!sel opt_interner_entry.some) { ret res[TypeSpelling, fail.Fail].ok{out}; }

    val form: type_prim.VecForm = type_prim.vector_form(opt_interner_entry.some);
    out.form = form;
    if (form.status == type_prim.VEC_FORM_NONE) { ret res[TypeSpelling, fail.Fail].ok{out}; }
    if (form.status != type_prim.VEC_FORM_OK) {
        out.status = TYPE_SPELL_VEC_REFUSED;
        ret res[TypeSpelling, fail.Fail].ok{out};
    }

    val res_tid: res[type_kind.TypeId, fail.Fail] = type.intern_vector(?rc.s.types, form.element, form.lanes);
    if (sel res_tid.err) {
        lang_phase.internal(?rc.status, res_tid.err);
        ret res[TypeSpelling, fail.Fail].err{res_tid.err};
    }
    val vtid: type_kind.TypeId = res_tid.ok;

    val res_sym: res[SymbolId, fail.Fail] = add_symbol(rc, SYM_VECTOR, 0, name, name, ast_id.DECL_NIL, vtid::u32, rc.own_stable);
    if (sel res_sym.err) {
        lang_phase.internal(?rc.status, res_sym.err);
        ret res[TypeSpelling, fail.Fail].err{res_sym.err};
    }
    val sid: SymbolId = res_sym.ok;

    val res_ins: res[bool, A.Error] = map.insert[intern.StrId, SymbolId](?rc.vec_cache, name, sid);
    if (sel res_ins.err) { ret res[TypeSpelling, fail.Fail].err{fail.refused(res_ins.err)}; }

    out.status = TYPE_SPELL_FOUND;
    out.sym    = sid;
    ret res[TypeSpelling, fail.Fail].ok{out};
}

fun report_vector_refused(rc: *ResolveContext, span: lang_source.Span, name: intern.StrId,
    form: type_prim.VecForm) err[fail.Fail] {
    val opt_interner_entry: opt[str] = intern.get(?rc.s.interner, name);
    if (!sel opt_interner_entry.some) { ret err[fail.Fail].ok{}; }
    val spelling: str = opt_interner_entry.some;

    var err_reportf: err[fail.Fail];
    if (form.status == type_prim.VEC_FORM_TOO_WIDE) {
        err_reportf = reportf(rc, diagnostic_kind.VECTOR_INVALID_TYPE, span,
            "vector `{}` has more than {} lanes, which the compiler cannot represent",
            spelling, type_prim.MAX_VEC_LANES);
    }
    or (form.status == type_prim.VEC_FORM_BAD_ELEMENT) {
        err_reportf = reportf(rc, diagnostic_kind.VECTOR_INVALID_TYPE, span,
            "vector `{}` has a `{}` lane; a vector lane is an integer of {} to {} bits, an `f16`, an `f32` or an `f64`",
            spelling, type_prim.prim_name(form.element), type_prim.VEC_LANE_MIN_BITS, type_prim.VEC_LANE_MAX_BITS);
    }
    or {
        err_reportf = reportf(rc, diagnostic_kind.VECTOR_INVALID_TYPE, span, "vector `{}` needs at least 2 lanes", spelling);
    }
    ret err_reportf;
}

fun collect_decl_list(rc: *ResolveContext, start: u32, len: u32, scope: ScopeId, at_module_scope: bool) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val decl_id:              ast_id.DeclId  = rc.a.decl_ids.data[start + i];
        val err_collect_one_decl: err[fail.Fail] = collect_one_decl(rc, decl_id, scope, at_module_scope);
        if (sel err_collect_one_decl.err) { ret err_collect_one_decl; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun collect_one_decl(rc: *ResolveContext, decl_id: ast_id.DeclId, scope: ScopeId, at_module_scope: bool) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d:        *ast_decl.Decl = opt_decl.some;
    val flags_in: u8             = d.flags;
    if (stack.exhausted()) { ret refuse_nesting(rc, d.span); }

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        ret collect_comptime_if(rc, ?d.data.comptime_if, d.span, scope, at_module_scope, true);
    }
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_DIRECTIVE) {
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_TEST || d.kind == ast_decl.DECL_KIND_ERROR) {
        ret err[fail.Fail].ok{};
    }

    if (d.kind == ast_decl.DECL_KIND_FWD) {
        ret collect_fwd(rc, decl_id, ?d.data.fwd_, d.flags);
    }

    val sym_flags: u8 = symbol_flags_from(flags_in, at_module_scope);

    if (d.kind == ast_decl.DECL_KIND_USE) {
        ret collect_use(rc, decl_id, ?d.data.use_, scope);
    }
    if (d.kind == ast_decl.DECL_KIND_FUN) {
        ret declare_decl(rc, SYM_FUN, sym_flags, d.data.fun_.name, decl_id, scope);
    }
    if (d.kind == ast_decl.DECL_KIND_REC) {
        ret declare_decl(rc, SYM_REC, sym_flags, d.data.rec_.name, decl_id, scope);
    }
    if (d.kind == ast_decl.DECL_KIND_UNI) {
        ret declare_decl(rc, SYM_UNI, sym_flags, d.data.uni_.name, decl_id, scope);
    }
    if (d.kind == ast_decl.DECL_KIND_TAG) {
        ret declare_decl(rc, SYM_TAG, sym_flags, d.data.tag_.name, decl_id, scope);
    }
    if (d.kind == ast_decl.DECL_KIND_DEF) {
        ret declare_decl(rc, SYM_DEF, sym_flags, d.data.def_.name, decl_id, scope);
    }
    if (d.kind == ast_decl.DECL_KIND_VAL) {
        val err_declare_decl: err[fail.Fail] = declare_decl(rc, SYM_VAL, sym_flags, d.data.bind.name, decl_id, scope);
        if (sel err_declare_decl.err) { ret err_declare_decl; }
        if (!ast_id.expr_is_nil(d.data.bind.init)) {
            val err_rcr: err[fail.Fail] = try_register_comptime_const(rc, d.data.bind.name, d.data.bind.ty, d.data.bind.init);
            if (sel err_rcr.err) { ret err_rcr; }
        }
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_VAR) {
        ret declare_decl(rc, SYM_VAR, sym_flags, d.data.bind.name, decl_id, scope);
    }
    ret unknown_kind(rc, "DeclKind", d.kind::u32);
}

fun declare_decl(rc: *ResolveContext, kind: SymKind, flags: u8, name_span: lang_source.Span, decl_id: ast_id.DeclId, scope: ScopeId) err[fail.Fail] {
    val res_declare: res[SymbolId, fail.Fail] = declare(rc, kind, flags, name_span, decl_id, 0, rc.own_stable, scope);
    if (sel res_declare.err) {
        lang_phase.internal(?rc.status, res_declare.err);
        ret err[fail.Fail].err{res_declare.err};
    }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[ast_id.decl_index(decl_id)] = res_declare.ok;
    }
    ret err[fail.Fail].ok{};
}

fun reject_vector_spelled_type(rc: *ResolveContext, kind: SymKind, name_span: lang_source.Span, name_id: intern.StrId) err[fail.Fail] {
    if (!declares_type(kind)) { ret err[fail.Fail].ok{}; }

    val opt_interner_entry: opt[str] = intern.get(?rc.s.interner, name_id);
    if (!sel opt_interner_entry.some) { ret err[fail.Fail].ok{}; }
    val spelling: str = opt_interner_entry.some;

    if (!type_prim.is_vector_spelling(spelling)) { ret err[fail.Fail].ok{}; }

    ret reportf(rc, diagnostic_kind.DECL_VECTOR_SPELLED_NAME, name_span,
        "`{}` is spelled as a vector type `<element>x<lanes>`, so it cannot also name a type; the declaration would be unreachable",
        spelling);
}

fun symbol_flags_from(decl_flags: u8, at_module_scope: bool) u8 {
    if (!at_module_scope) { ret 0; }
    var f: u8 = SYM_FLAG_MODULE;
    if ((decl_flags & ast_decl.DECL_FLAG_PUB) != 0) { f = f | SYM_FLAG_PUB; }
    ret f;
}

fun try_register_comptime_const(rc: *ResolveContext, name_span: lang_source.Span, ty: ast_id.TypeId,
    init_expr: ast_id.ExprId) err[fail.Fail] {
    if (name_span.len == 0) { ret err[fail.Fail].ok{}; }
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, name_span.offset, name_span.len);
    if (sel res_range_add.err) {
        lang_phase.internal(?rc.status, fail.refused(res_range_add.err));
        ret err[fail.Fail].ok{};
    }
    val name_id: intern.StrId = res_range_add.ok;

    val opt_bound: opt[comptime_scope.NamedConst] = comptime_scope.lookup(rc.ctx, name_id);
    if (sel opt_bound.some) { ret err[fail.Fail].ok{}; }

    val fw:                          float.FloatWidth                                       = comptime.declared_float_width(rc.a, rc.source, ty);
    val secret:                      bool                                                   = spelled_secret(rc, ty, 0);
    var res_evaluate_at_float_width: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate_at_float_width[ResolveContext](rc.ctx, rc, rc.caps, rc.a, rc.source, init_expr, ?rc.s.interner, fw);
    if (secret)                              { res_evaluate_at_float_width = comptime.evaluate_secret_at_float_width[ResolveContext](rc.ctx, rc, rc.caps, rc.a, rc.source, init_expr, ?rc.s.interner, fw); }
    if (sel res_evaluate_at_float_width.err) { ret err[fail.Fail].ok{}; }
    var v: comptime_value.CTValue = comptime_value.apply_declared_int_type(rc.a, rc.source, ty,
        res_evaluate_at_float_width.ok);
    if (comptime_value.float_width_unread(v)) { ret err[fail.Fail].ok{}; }
    v.secret = secret;

    ret comptime_scope.bind(rc.ctx, name_id, v);
}

# a module `val` constructed as a case literal is a constant tag: a constant element over its own
# literal, bound once the literal's head has been split into type and case, and rebound with its
# declared type by type checking. it points into this syntax tree and is never exported
fun register_constant_tag(rc: *ResolveContext, name_span: lang_source.Span, init_expr: ast_id.ExprId) err[fail.Fail] {
    if (name_span.len == 0 || !is_case_literal(rc, init_expr)) { ret err[fail.Fail].ok{}; }
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, name_span.offset, name_span.len);
    if (sel res_range_add.err) {
        lang_phase.internal(?rc.status, fail.refused(res_range_add.err));
        ret err[fail.Fail].ok{};
    }
    val name_id:   intern.StrId                   = res_range_add.ok;
    val opt_bound: opt[comptime_scope.NamedConst] = comptime_scope.lookup(rc.ctx, name_id);
    if (sel opt_bound.some) { ret err[fail.Fail].ok{}; }
    ret comptime_scope.bind(rc.ctx, name_id, comptime_value.const_elem_untyped(init_expr::u32));
}

# module_refusal reports the first module-scope `$error` reached through arms the gates
# decide here, and says whether one was. a gate that cannot be decided yet leaves its
# chain to collection and sema, which report it when it is decided.
fun module_refusal(rc: *ResolveContext, start: u32, len: u32) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(rc.a, rc.a.decl_ids.data[start + i]);
        if (!sel opt_decl.some) { ret res[bool, fail.Fail].err{fail.message("DeclId out of range")}; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_DIRECTIVE && !ast_id.expr_is_nil(d.data.comptime_directive.target)
            && intrinsic.is_error_call(rc.a, rc.source, d.data.comptime_directive.target)) {
            val err_report_error_directive: err[fail.Fail] = report_error_directive(rc, d.data.comptime_directive.target, d.span);
            if (sel err_report_error_directive.err) { ret res[bool, fail.Fail].err{err_report_error_directive.err}; }
            ret res[bool, fail.Fail].ok{true};
        }
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            val res_comptime_if_refusal: res[bool, fail.Fail] = comptime_if_refusal(rc, ?d.data.comptime_if);
            if (sel res_comptime_if_refusal.err) { ret res_comptime_if_refusal; }
            if (res_comptime_if_refusal.ok)      { ret res_comptime_if_refusal; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun comptime_if_refusal(rc: *ResolveContext, ci: *ast_decl.DeclComptimeIf) res[bool, fail.Fail] {
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br:                       *ast_decl.ComptimeBranch                  = ?rc.a.comptime_branches.data[ci.branches_start + bi];
        val res_refusal_gate_outcome: res[comptime_gate.GateOutcome, fail.Fail] = refusal_gate_outcome(rc, br);
        if (sel res_refusal_gate_outcome.err) { ret res[bool, fail.Fail].err{res_refusal_gate_outcome.err}; }
        val outcome: comptime_gate.GateOutcome = res_refusal_gate_outcome.ok;
        if (outcome == comptime_gate.GATE_ACTIVE)   { ret module_refusal(rc, br.body_start, br.body_len); }
        if (outcome != comptime_gate.GATE_INACTIVE) { ret res[bool, fail.Fail].ok{false}; }
        bi = bi + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# a decision the load recorded stands here as it does for collection, whatever
# decided it. the scan records nothing: a rejected gate's message is collection's
fun refusal_gate_outcome(rc: *ResolveContext, br: *ast_decl.ComptimeBranch) res[comptime_gate.GateOutcome, fail.Fail] {
    val known: comptime_scope.GateState = comptime_scope.gate_state(rc.ctx, br.cond);
    if (known == comptime_scope.GATE_STATE_TRUE)  { ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_ACTIVE}; }
    if (known == comptime_scope.GATE_STATE_FALSE) { ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_INACTIVE}; }
    val res_evaluate_gate: res[comptime_gate.GateVerdict, fail.Fail] = comptime_gate.evaluate_gate[ResolveContext](
        rc.ctx, rc, rc.caps, rc.a, rc.source, br.cond, ?rc.s.interner, comptime_gate.GATE_SCOPE_DECL, false);
    if (sel res_evaluate_gate.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_evaluate_gate.err}; }
    ret res[comptime_gate.GateOutcome, fail.Fail].ok{res_evaluate_gate.ok.outcome};
}

fun report_error_directive(rc: *ResolveContext, target: ast_id.ExprId, span: lang_source.Span) err[fail.Fail] {
    val res_msg: res[str, comptime_failure.EvalFail] = comptime.error_message[ResolveContext](
        rc.ctx, rc, rc.caps, rc.a, rc.source, target, ?rc.s.interner);
    if (sel res_msg.err) {
        val f: comptime_failure.EvalFail = res_msg.err;
        if (f.kind == comptime_failure.EVAL_FAIL_INTERNAL) {
            internal_at(rc, span, fail.message(f.message));
            ret err[fail.Fail].err{fail.message(f.message)};
        }
        ret report(rc, f.diag, span, f.message);
    }
    ret report(rc, diagnostic_kind.COMPTIME_USER_ERROR, span, res_msg.ok);
}

fun note_refused_name(rc: *ResolveContext, span: lang_source.Span) err[fail.Fail] {
    lang_phase.reject(?rc.status);
    val res_range_add: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, span.offset, span.len);
    if (sel res_range_add.err) {
        internal_at(rc, span, fail.refused(res_range_add.err));
        ret err[fail.Fail].err{fail.refused(res_range_add.err)};
    }
    val res_ins: res[bool, A.Error] = map.insert[intern.StrId, SymbolId](?rc.refused_names, res_range_add.ok, SYMBOL_REJECTED);
    if (sel res_ins.err) {
        internal_at(rc, span, fail.refused(res_ins.err));
        ret err[fail.Fail].err{fail.refused(res_ins.err)};
    }
    ret err[fail.Fail].ok{};
}

# report_unresolved names a missing identifier or type, unless a refusal already accounts for it;
# true when the name sits in an arm only sema can decide, which the caller marks deferred
fun report_unresolved(rc: *ResolveContext, span: lang_source.Span, prefix: str, name: intern.StrId, suggest: bool) bool {
    if (rc.in_deferred_arm) { ret true; }
    var key:       intern.StrId   = name;
    val opt_known: opt[*SymbolId] = map.get[intern.StrId, SymbolId](?rc.refused_names, ?key);
    if (sel opt_known.some) {
        lang_phase.reject(?rc.status);
        ret false;
    }
    val res_begun: res[diagnostic.DiagnosticBuilder, fail.Fail] = named_builder(rc, diagnostic_kind.NAME_UNRESOLVED, span, prefix, name, "`");
    if (sel res_begun.err) { ret false; }
    var b: diagnostic.DiagnosticBuilder = res_begun.ok;
    if (suggest) {
        val err_suggested: err[fail.Fail] = attach_suggestion(rc, ?b, span, name);
        if (sel err_suggested.err) {
            diagnostic.builder_dnit(?b);
            internal_at(rc, span, err_suggested.err);
            ret false;
        }
    }
    commit_built(rc, ?b);
    ret false;
}

fun collect_comptime_if(rc: *ResolveContext, ci: *ast_decl.DeclComptimeIf, span: lang_source.Span, scope: ScopeId, at_module_scope: bool, at_decl_scope: bool) err[fail.Fail] {
    if (at_decl_scope) {
        val res_nothing: res[bool, fail.Fail] = comptime_gate.comptime_if_declares_nothing(rc.a, ci.branches_start, ci.branches_len);
        if (sel res_nothing.err) { ret refuse(rc, span, res_nothing.err); }
        if (res_nothing.ok)      { ret err[fail.Fail].ok{}; }
    }
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br:       *ast_decl.ComptimeBranch                  = ?rc.a.comptime_branches.data[ci.branches_start + bi];
        val res_take: res[comptime_gate.GateOutcome, fail.Fail] = comptime_branch_active(rc, br, at_decl_scope);
        if (sel res_take.err) {
            ret err[fail.Fail].err{res_take.err};
        }
        val outcome: comptime_gate.GateOutcome = res_take.ok;
        if (outcome == comptime_gate.GATE_AWAITING_PHASE || outcome == comptime_gate.GATE_REJECTED || outcome == comptime_gate.GATE_FAILED) {
            ret err[fail.Fail].ok{};
        }
        if (outcome == comptime_gate.GATE_ACTIVE) {
            if (at_decl_scope) {
                ret collect_decl_list(rc, br.body_start, br.body_len, scope, at_module_scope);
            }
            ret err[fail.Fail].ok{};
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun comptime_branch_active(rc: *ResolveContext, br: *ast_decl.ComptimeBranch, at_decl_scope: bool) res[comptime_gate.GateOutcome, fail.Fail] {
    var scope: comptime_gate.GateScope = comptime_gate.GATE_SCOPE_INSTANCE;
    if (at_decl_scope) { scope = comptime_gate.GATE_SCOPE_DECL; }
    # a declaring gate the load did not decide, as in a buffer resolved alone, may not ask a type question either
    if (at_decl_scope && comptime_scope.gate_state(rc.ctx, br.cond) == comptime_scope.GATE_STATE_UNKNOWN) {
        val res_refused: res[bool, fail.Fail] = refuse_type_question(rc, br.cond);
        if (sel res_refused.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_refused.err}; }
        if (res_refused.ok)      { ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_FAILED}; }
    }
    val res_evaluate_gate: res[comptime_gate.GateVerdict, fail.Fail] = comptime_gate.evaluate_gate[ResolveContext](
        rc.ctx, rc, rc.caps, rc.a, rc.source, br.cond, ?rc.s.interner, scope, at_decl_scope);
    if (sel res_evaluate_gate.err) {
        ret res[comptime_gate.GateOutcome, fail.Fail].err{res_evaluate_gate.err};
    }
    ret render_gate_verdict(rc, res_evaluate_gate.ok);
}

fun refuse_type_question(rc: *ResolveContext, cond: ast_id.ExprId) res[bool, fail.Fail] {
    val res_question: res[ast_id.ExprId, fail.Fail] = comptime_gate.type_question(rc.a, rc.source, cond);
    if (sel res_question.err) {
        val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, cond);
        if (sel opt_expr.none) { ret res[bool, fail.Fail].err{res_question.err}; }
        val err_refused: err[fail.Fail] = refuse(rc, opt_expr.some.span, res_question.err);
        if (sel err_refused.err) { ret res[bool, fail.Fail].err{err_refused.err}; }
        ret res[bool, fail.Fail].ok{true};
    }
    if (ast_id.expr_is_nil(res_question.ok)) { ret res[bool, fail.Fail].ok{false}; }
    val res_message: res[intern.StrId, fail.Fail] = comptime_gate.type_question_message(?rc.s.interner, rc.a, rc.source, res_question.ok, "");
    if (sel res_message.err) { ret res[bool, fail.Fail].err{res_message.err}; }
    val opt_text: opt[str] = intern.get(?rc.s.interner, res_message.ok);
    if (sel opt_text.none) { ret res[bool, fail.Fail].err{fail.message("type question refusal is not interned")}; }
    val opt_cond: opt[*ast_expr.Expr] = ast.get_expr(rc.a, cond);
    if (sel opt_cond.none) { ret res[bool, fail.Fail].err{fail.message("gate condition is out of range")}; }
    comptime_scope.set_gate_state(rc.ctx, cond, comptime_scope.GATE_STATE_REJECTED);
    lang_phase.reject(?rc.status);
    val err_committed: err[fail.Fail] = diagnostic.report(rc.diags, diagnostic_kind.GATE_TYPE_QUESTION, rc.a.file_id, opt_cond.some.span, opt_text.some);
    if (sel err_committed.err) { ret res[bool, fail.Fail].err{err_committed.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun render_gate_verdict(rc: *ResolveContext, v: comptime_gate.GateVerdict) res[comptime_gate.GateOutcome, fail.Fail] {
    if (v.outcome == comptime_gate.GATE_ACTIVE || v.outcome == comptime_gate.GATE_INACTIVE) {
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{v.outcome};
    }
    if (v.outcome == comptime_gate.GATE_REJECTED) {
        val err_emit_gate_message: err[fail.Fail] = emit_gate_message(rc, v);
        if (sel err_emit_gate_message.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{err_emit_gate_message.err}; }
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_REJECTED};
    }
    if (v.outcome == comptime_gate.GATE_FAILED) {
        if (!intern.str_is_nil(v.depends)) {
            lang_phase.reject(?rc.status);
            val res_named: res[str, fail.Fail] = comptime_gate.never_decided_message(rc.diags.a, ?rc.s.interner, v.depends);
            if (sel res_named.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{res_named.err}; }
            val err_committed: err[fail.Fail] = diagnostic.report(rc.diags, v.diag, rc.a.file_id, v.span, res_named.ok);
            str_free(rc.diags.a, res_named.ok);
            if (sel err_committed.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{err_committed.err}; }
            ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_FAILED};
        }
        val err_emit_gate_message: err[fail.Fail] = emit_gate_message(rc, v);
        if (sel err_emit_gate_message.err) { ret res[comptime_gate.GateOutcome, fail.Fail].err{err_emit_gate_message.err}; }
        ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_FAILED};
    }
    # a later phase decides it: type checking for a statement arm, an instantiation for a generic's
    ret res[comptime_gate.GateOutcome, fail.Fail].ok{comptime_gate.GATE_AWAITING_PHASE};
}

fun emit_gate_message(rc: *ResolveContext, v: comptime_gate.GateVerdict) err[fail.Fail] {
    lang_phase.reject(?rc.status);
    if (str_len(v.message) == 0) { ret err[fail.Fail].ok{}; }
    val err_committed: err[fail.Fail] = diagnostic.report(rc.diags, v.diag, rc.a.file_id, v.span, v.message);
    if (sel err_committed.err) { ret err[fail.Fail].err{err_committed.err}; }
    ret err[fail.Fail].ok{};
}

fun collect_use(rc: *ResolveContext, decl_id: ast_id.DeclId, du: *ast_decl.DeclUse, scope: ScopeId) err[fail.Fail] {
    if (du.path.len == 0) {
        ret err[fail.Fail].ok{};
    }
    val recorded: *fe_load.Binding = binding_for(rc, decl_id);
    # the load reported this use and bound nothing: the name it would have bound is
    # a refused name, so a use of it is that report again, not a new error
    if (recorded != nil && recorded.kind == fe_load.BINDING_UNBOUND) {
        var unbound_span: lang_source.Span = du.alias;
        if (unbound_span.len == 0) { unbound_span = leaf_span(rc, du.path); }
        if (unbound_span.len == 0) {
            lang_phase.reject(?rc.status);
            ret err[fail.Fail].ok{};
        }
        ret note_refused_name(rc, unbound_span);
    }

    if (recorded != nil) { ret bind_recorded_use(rc, decl_id, du, recorded, scope); }

    val res_path: res[intern.StrId, A.Error] = fe_path.intern_path(?rc.s.interner, rc.source, du.path);
    if (sel res_path.err) {
        lang_phase.internal(?rc.status, fail.refused(res_path.err));
        ret err[fail.Fail].err{fail.refused(res_path.err)};
    }
    val path_id: intern.StrId = res_path.ok;

    val mx: *ModuleExports = find_module_exports(rc, path_id);
    if (mx != nil) {
        var alias_span: lang_source.Span = du.alias;
        if (alias_span.len == 0) {
            alias_span = leaf_span(rc, du.path);
        }
        val res_declare: res[SymbolId, fail.Fail] = declare(rc, SYM_USE, 0, alias_span, decl_id, mx.module::u32, rc.own_stable, scope);
        if (sel res_declare.err) {
            lang_phase.internal(?rc.status, res_declare.err);
            ret err[fail.Fail].err{res_declare.err};
        }
        if (rc.decl_symbol != nil) {
            rc.decl_symbol[ast_id.decl_index(decl_id)] = res_declare.ok;
        }
        ret err[fail.Fail].ok{};
    }

    val leaf:   lang_source.Span = leaf_span(rc, du.path);
    val prefix: lang_source.Span = prefix_span(rc, du.path);
    if (prefix.len == 0 || leaf.len == 0) {
        record_report(rc, diagnostic_kind.MODULE_NOT_IN_DEPS, du.path, "imported module is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    val pmx: *ModuleExports = find_module_exports_span(rc, prefix);
    if (pmx == nil) {
        record_report(rc, diagnostic_kind.MODULE_NOT_IN_DEPS, du.path, "imported module is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    val res_leaf: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, leaf.offset, leaf.len);
    if (sel res_leaf.err) {
        lang_phase.internal(?rc.status, fail.refused(res_leaf.err));
        ret err[fail.Fail].err{fail.refused(res_leaf.err)};
    }
    val leaf_id: intern.StrId = res_leaf.ok;

    var bind_span: lang_source.Span = du.alias;
    if (bind_span.len == 0) {
        bind_span = leaf;
    }

    val ps: *PublicSymbol = find_export(pmx, leaf_id);
    if (ps == nil && pmx.refused) { ret note_refused_name(rc, bind_span); }
    if (ps == nil) {
        report_named2(rc, diagnostic_kind.VISIBILITY_NOT_EXPORTED, du.path, "`", leaf_id, "` is not exported by `", pmx.path, "`");
        ret err[fail.Fail].ok{};
    }
    ret bind_imported_symbol(rc, decl_id, bind_span, ps, scope);
}

# bind a `use` as the load recorded it: a module under its alias or last segment, or a member
# of the module the load found by its name
fun bind_recorded_use(rc: *ResolveContext, decl_id: ast_id.DeclId, du: *ast_decl.DeclUse, b: *fe_load.Binding, scope: ScopeId) err[fail.Fail] {
    val mx: *ModuleExports = find_module_exports_by_module(rc, b.module);
    if (mx == nil) {
        record_report(rc, diagnostic_kind.MODULE_NOT_IN_DEPS, du.path, "imported module is not in the dep set");
        ret err[fail.Fail].ok{};
    }
    val leaf: lang_source.Span = leaf_span(rc, du.path);
    if (b.kind == fe_load.BINDING_MODULE) {
        var alias_span: lang_source.Span = du.alias;
        if (alias_span.len == 0) { alias_span = leaf; }
        val res_declare: res[SymbolId, fail.Fail] = declare(rc, SYM_USE, 0, alias_span, decl_id, mx.module::u32, rc.own_stable, scope);
        if (sel res_declare.err) {
            lang_phase.internal(?rc.status, res_declare.err);
            ret err[fail.Fail].err{res_declare.err};
        }
        if (rc.decl_symbol != nil) { rc.decl_symbol[ast_id.decl_index(decl_id)] = res_declare.ok; }
        ret err[fail.Fail].ok{};
    }
    var bind_span: lang_source.Span = du.alias;
    if (bind_span.len == 0) { bind_span = leaf; }
    val ps: *PublicSymbol = find_export(mx, b.name);
    if (ps == nil && mx.refused) { ret note_refused_name(rc, bind_span); }
    if (ps == nil) {
        report_named2(rc, diagnostic_kind.VISIBILITY_NOT_EXPORTED, du.path, "`", b.name, "` is not exported by `", mx.path, "`");
        ret err[fail.Fail].ok{};
    }
    ret bind_imported_symbol(rc, decl_id, bind_span, ps, scope);
}

# the load's record of an import declaration, nil when it recorded none
fun binding_for(rc: *ResolveContext, decl_id: ast_id.DeclId) *fe_load.Binding {
    var i: u32 = 0;
    for (i < rc.deps.binding_count) {
        if (ast_id.decl_same(rc.deps.bindings[i].decl, decl_id)) { ret ?rc.deps.bindings[i]; }
        i = i + 1;
    }
    ret nil;
}

fun bind_imported_symbol(rc: *ResolveContext, decl_id: ast_id.DeclId, bind_span: lang_source.Span, ps: *PublicSymbol, scope: ScopeId) err[fail.Fail] {
    if (bind_span.len == 0) { ret err[fail.Fail].ok{}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, bind_span.offset, bind_span.len);
    if (sel res_name.err) {
        lang_phase.internal(?rc.status, fail.refused(res_name.err));
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val name_id: intern.StrId = res_name.ok;

    val existing: SymbolId = scope_lookup_local(rc, scope, name_id);
    if (!symbol_is_nil(existing)) {
        report_duplicate(rc, bind_span, "imported name `", name_id, "` is already defined in this scope", existing);
        ret err[fail.Fail].ok{};
    }

    var imported:   PublicSymbol                            = @ps;
    val res_notice: res[deprecation.Deprecation, fail.Fail] = declaration_deprecation(rc.ctx, rc.a, decl_id);
    if (sel res_notice.err)                 { ret err[fail.Fail].err{res_notice.err}; }
    if (res_notice.ok.present)              { imported.deprecation = res_notice.ok; }
    if (declaration_testing(rc.a, decl_id)) { imported.testing = true; }
    val res_sid: res[SymbolId, fail.Fail] = imported_symbol_for(rc, ?imported);
    if (sel res_sid.err) {
        lang_phase.internal(?rc.status, res_sid.err);
        ret err[fail.Fail].err{res_sid.err};
    }
    val sid: SymbolId = res_sid.ok;

    val err_add: err[fail.Fail] = scope_add(rc, scope, name_id, sid);
    if (sel err_add.err) { ret err_add; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[ast_id.decl_index(decl_id)] = sid;
    }
    # a symbol that names a module is a module import, which is never unused
    if (!rc.lint_imports || ps.kind == SYM_USE) { ret err[fail.Fail].ok{}; }
    val res_pushed: res[usize, A.Error] = collections_vector.push[SymbolImport](?rc.symbol_imports, SymbolImport{name: name_id, span: bind_span, used: false});
    if (sel res_pushed.err) {
        lang_phase.internal(?rc.status, fail.refused(res_pushed.err));
        ret err[fail.Fail].err{fail.refused(res_pushed.err)};
    }
    ret err[fail.Fail].ok{};
}

fun imported_symbol_for(rc: *ResolveContext, ps: *PublicSymbol) res[SymbolId, fail.Fail] {
    val key:        ImportedKey    = ImportedKey{origin: ps.origin, canon: ps.canon, notice: ps.deprecation, testing: ps.testing};
    val opt_cached: opt[*SymbolId] = map.get_by[ImportedKey, SymbolId](?rc.imported_cache, ?key);
    if (sel opt_cached.some) {
        ret res[SymbolId, fail.Fail].ok{@opt_cached.some};
    }
    var kind: SymKind = SYM_IMPORTED;
    var slot: u32     = 0;
    if (ps.kind == SYM_USE) {
        kind = SYM_USE;
        slot = ps.slot;
    }
    val res_add_symbol: res[SymbolId, fail.Fail] = add_symbol(rc, kind, 0, ps.name, ps.canon, ast_id.DECL_NIL, slot, ps.origin);
    if (sel res_add_symbol.err) {
        lang_phase.internal(?rc.status, res_add_symbol.err);
        ret res_add_symbol;
    }
    val sid: SymbolId = res_add_symbol.ok;
    rc.symbols[symbol_index(sid)].definition_kind     = ps.kind;
    rc.symbols[symbol_index(sid)].definition_file     = ps.file;
    rc.symbols[symbol_index(sid)].generic_arity       = ps.generic_arity;
    rc.symbols[symbol_index(sid)].has_comptime_params = ps.has_comptime_params;
    rc.symbols[symbol_index(sid)].has_pack_param      = ps.has_pack_param;
    rc.symbols[symbol_index(sid)].deprecation         = ps.deprecation;
    rc.symbols[symbol_index(sid)].testing             = ps.testing;
    val res_ins: res[bool, A.Error] = map.insert_by[ImportedKey, SymbolId](?rc.imported_cache, key, sid);
    if (sel res_ins.err) { ret res[SymbolId, fail.Fail].err{fail.refused(res_ins.err)}; }
    ret res[SymbolId, fail.Fail].ok{sid};
}

fun leaf_span(rc: *ResolveContext, path: lang_source.Span) lang_source.Span {
    ret fe_path.leaf(rc.source, path);
}

fun prefix_span(rc: *ResolveContext, path: lang_source.Span) lang_source.Span {
    ret fe_path.prefix(rc.source, path);
}

fun find_module_exports(rc: *ResolveContext, path: intern.StrId) *ModuleExports {
    var i: u32 = 0;
    for (i < rc.deps.count) {
        val mx: *ModuleExports = ?rc.deps.entries[i];
        if (intern.str_same(mx.path, path)) { ret mx; }
        i = i + 1;
    }
    ret nil;
}

fun find_module_exports_by_module(rc: *ResolveContext, stable: module.StableModuleId) *ModuleExports {
    var i: u32 = 0;
    for (i < rc.deps.count) {
        val mx: *ModuleExports = ?rc.deps.entries[i];
        if (module.stable_same(mx.module, stable)) { ret mx; }
        i = i + 1;
    }
    ret nil;
}

fun bind_member_qualified(rc: *ResolveContext, eid: ast_id.ExprId, member: *ast_expr.ExprMember) err[fail.Fail] {
    if (rc.expr_resolved == nil) { ret err[fail.Fail].ok{}; }

    val opt_obj: opt[*ast_expr.Expr] = ast.get_expr(rc.a, member.object);
    if (!sel opt_obj.some) { ret err[fail.Fail].ok{}; }

    val osid: SymbolId = rc.expr_resolved[ast_id.expr_index(member.object)];
    if (symbol_is_nil(osid) || symbol_index(osid) >= rc.sym_len) { ret err[fail.Fail].ok{}; }
    val osym: *Symbol = ?rc.symbols[symbol_index(osid)];
    if (osym.kind != SYM_USE) { ret err[fail.Fail].ok{}; }

    val mx: *ModuleExports = find_module_exports_by_module(rc, use_stable(osym));
    if (mx == nil) {
        record_report(rc, diagnostic_kind.MODULE_NOT_IN_DEPS, member.name, "module alias names a module that is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    # a member with no name was reported by the parse
    val leaf_id: intern.StrId = member.name_id;
    if (intern.str_is_nil(leaf_id)) { ret err[fail.Fail].ok{}; }

    val ps: *PublicSymbol = find_export(mx, leaf_id);
    if (ps == nil && mx.refused) {
        lang_phase.reject(?rc.status);
        ret err[fail.Fail].ok{};
    }
    if (ps == nil && rc.in_deferred_arm) {
        rc.expr_resolved[ast_id.expr_index(eid)] = SYMBOL_DEFERRED_NAME;
        ret err[fail.Fail].ok{};
    }
    if (ps == nil) {
        report_named2(rc, diagnostic_kind.VISIBILITY_NOT_EXPORTED, member.name, "no symbol `", leaf_id, "` exported by `", mx.path, "`");
        ret err[fail.Fail].ok{};
    }

    val res_sym: res[SymbolId, fail.Fail] = imported_symbol_for(rc, ps);
    if (sel res_sym.err) {
        lang_phase.internal(?rc.status, res_sym.err);
        ret err[fail.Fail].err{res_sym.err};
    }
    rc.expr_resolved[ast_id.expr_index(eid)] = res_sym.ok;
    ret err[fail.Fail].ok{};
}

fun find_module_exports_span(rc: *ResolveContext, span: lang_source.Span) *ModuleExports {
    val res_intern_path: res[intern.StrId, A.Error] = fe_path.intern_path(?rc.s.interner, rc.source, span);
    if (sel res_intern_path.err) {
        internal_at(rc, span, fail.refused(res_intern_path.err));
        ret nil;
    }
    ret find_module_exports(rc, res_intern_path.ok);
}

fun resolve_prefix_module(rc: *ResolveContext, prefix: lang_source.Span) *ModuleExports {
    val res_intern_path: res[intern.StrId, A.Error] = fe_path.intern_path(?rc.s.interner, rc.source, prefix);
    if (sel res_intern_path.err) {
        lang_phase.internal(?rc.status, fail.refused(res_intern_path.err));
        ret nil;
    }
    val prefix_id: intern.StrId = res_intern_path.ok;

    val sid: SymbolId = scope_lookup_chain(rc, rc.module_scope, prefix_id);
    if (!symbol_is_nil(sid) && symbol_index(sid) < rc.sym_len) {
        val sym: *Symbol = ?rc.symbols[symbol_index(sid)];
        if (sym.kind == SYM_USE) {
            ret find_module_exports_by_module(rc, use_stable(sym));
        }
    }
    ret find_module_exports(rc, prefix_id);
}

# the first symbol `mx` exports under `name`, nil when none
fun find_export(mx: *ModuleExports, name: intern.StrId) *PublicSymbol {
    val key:  u64 = intern.str_index(name)::u64 << 32;
    var low:  u32 = 0;
    var high: u32 = mx.count;
    for (low < high) {
        val mid: u32 = (low + high) >> 1;
        if (mx.by_name[mid] < key) { low = mid + 1; }
        or                         { high = mid; }
    }
    if (low >= mx.count || (mx.by_name[low] >> 32) != (key >> 32)) { ret nil; }
    ret ?mx.symbols[(mx.by_name[low] & 0xFFFFFFFF)::u32];
}

fun bind_decl_list(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val decl_id:           ast_id.DeclId  = rc.a.decl_ids.data[start + i];
        val err_bind_one_decl: err[fail.Fail] = bind_one_decl(rc, decl_id);
        if (sel err_bind_one_decl.err) { ret err_bind_one_decl; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_decorator_args(rc: *ResolveContext, d: *ast_decl.Decl) err[fail.Fail] {
    var k: u32 = 0;
    for (k < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?rc.a.decorators.data[d.decorators_start + k];
        var j:   u32                 = 0;
        # the arguments of a decorator no row names bind to nothing
        for (j < dec.args_len && dec.id != decorator.NONE) {
            val err_bind_expr: err[fail.Fail] = bind_expr(rc, rc.a.expr_ids.data[dec.args_start + j]);
            if (sel err_bind_expr.err) { ret err_bind_expr; }
            j = j + 1;
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_one_decl(rc: *ResolveContext, decl_id: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (stack.exhausted()) { ret refuse_nesting(rc, d.span); }

    val err_rda: err[fail.Fail] = bind_decorator_args(rc, d);
    if (sel err_rda.err) { ret err_rda; }

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        val ci: *ast_decl.DeclComptimeIf = ?d.data.comptime_if;
        ret bind_comptime_if(rc, ci.branches_start, ci.branches_len, d.span, true);
    }
    if (d.kind == ast_decl.DECL_KIND_USE || d.kind == ast_decl.DECL_KIND_ERROR || d.kind == ast_decl.DECL_KIND_FWD) {
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_DIRECTIVE) {
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_FUN) {
        ret bind_fun(rc, ?d.data.fun_, decl_id);
    }
    if (d.kind == ast_decl.DECL_KIND_REC) {
        ret bind_rec(rc, ?d.data.rec_, decl_id);
    }
    if (d.kind == ast_decl.DECL_KIND_UNI) {
        ret bind_uni(rc, ?d.data.uni_, decl_id);
    }
    if (d.kind == ast_decl.DECL_KIND_TAG) {
        val t:             *ast_decl.DeclTag = ?d.data.tag_;
        val err_bind_type: err[fail.Fail]    = bind_type(rc, t.disc);
        if (sel err_bind_type.err) { ret err_bind_type; }
        ret bind_aggregate(rc, t.generics_start, t.generics_len, t.cases_start, t.cases_len, decl_id, true);
    }
    if (d.kind == ast_decl.DECL_KIND_DEF) {
        ret bind_type(rc, d.data.def_.ty);
    }
    if (d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) {
        if (!ast_id.type_is_nil(d.data.bind.ty)) {
            val err_bind_type: err[fail.Fail] = bind_type(rc, d.data.bind.ty);
            if (sel err_bind_type.err) { ret err_bind_type; }
        }
        if (!ast_id.expr_is_nil(d.data.bind.init)) {
            val err_bind_expr: err[fail.Fail] = bind_expr(rc, d.data.bind.init);
            if (sel err_bind_expr.err)            { ret err_bind_expr; }
            if (d.kind == ast_decl.DECL_KIND_VAL) { ret register_constant_tag(rc, d.data.bind.name, d.data.bind.init); }
        }
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_TEST) {
        if (!ast_id.stmt_is_nil(d.data.test_.body)) {
            ret bind_stmt(rc, d.data.test_.body);
        }
        ret err[fail.Fail].ok{};
    }
    ret unknown_kind(rc, "DeclKind", d.kind::u32);
}

fun collect_fwd(rc: *ResolveContext, decl_id: ast_id.DeclId, df: *ast_decl.DeclFwd, flags: u8) err[fail.Fail] {
    if ((flags & ast_decl.DECL_FLAG_PUB) != 0) {
        record_report(rc, diagnostic_kind.FWD_PUB, df.path, "`fwd` always re-exports; `pub fwd` is not allowed");
        ret err[fail.Fail].ok{};
    }
    if (df.path.len == 0) {
        ret err[fail.Fail].ok{};
    }
    if (rc.lint_imports) {
        val res_pushed: res[usize, A.Error] = collections_vector.push[lang_source.Span](?rc.fwd_paths, df.path);
        if (sel res_pushed.err) {
            lang_phase.internal(?rc.status, fail.refused(res_pushed.err));
            ret err[fail.Fail].err{fail.refused(res_pushed.err)};
        }
    }

    val recorded: *fe_load.Binding = binding_for(rc, decl_id);
    var full_mx:  *ModuleExports   = nil;
    if (recorded != nil && recorded.kind == fe_load.BINDING_MODULE) {
        full_mx = find_module_exports_by_module(rc, recorded.module);
    }
    or (recorded == nil) {
        val res_full: res[intern.StrId, A.Error] = fe_path.intern_path(?rc.s.interner, rc.source, df.path);
        if (sel res_full.err) {
            lang_phase.internal(?rc.status, fail.refused(res_full.err));
            ret err[fail.Fail].err{fail.refused(res_full.err)};
        }
        full_mx = find_module_exports(rc, res_full.ok);
    }
    if (full_mx != nil) {
        ret collect_fwd_module(rc, decl_id, df, full_mx.module);
    }

    val leaf:   lang_source.Span = leaf_span(rc, df.path);
    val prefix: lang_source.Span = prefix_span(rc, df.path);
    if (prefix.len == 0 || leaf.len == 0) {
        record_report(rc, diagnostic_kind.FWD_NOT_SYMBOL, df.path, "`fwd` path must name a symbol of a module");
        ret err[fail.Fail].ok{};
    }

    var pmx: *ModuleExports = nil;
    if (recorded != nil && recorded.kind == fe_load.BINDING_MEMBER) {
        pmx = find_module_exports_by_module(rc, recorded.module);
    }
    or { pmx = resolve_prefix_module(rc, prefix); }
    if (pmx == nil) {
        record_report(rc, diagnostic_kind.MODULE_NOT_IN_DEPS, df.path, "re-exported module is not in the dep set");
        ret err[fail.Fail].ok{};
    }

    val res_leaf: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, leaf.offset, leaf.len);
    if (sel res_leaf.err) {
        lang_phase.internal(?rc.status, fail.refused(res_leaf.err));
        ret err[fail.Fail].err{fail.refused(res_leaf.err)};
    }
    val leaf_id: intern.StrId = res_leaf.ok;

    var bind_span: lang_source.Span = df.alias;
    if (bind_span.len == 0) {
        bind_span = leaf;
    }

    val ps: *PublicSymbol = find_export(pmx, leaf_id);
    if (ps == nil && pmx.refused) { ret note_refused_name(rc, bind_span); }
    if (ps == nil) {
        record_report(rc, diagnostic_kind.VISIBILITY_NOT_EXPORTED, df.path, "re-exported symbol is not exported by its module");
        ret err[fail.Fail].ok{};
    }

    val res_name: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, bind_span.offset, bind_span.len);
    if (sel res_name.err) {
        lang_phase.internal(?rc.status, fail.refused(res_name.err));
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val name_id: intern.StrId = res_name.ok;

    val existing: SymbolId = scope_lookup_local(rc, rc.module_scope, name_id);
    if (!symbol_is_nil(existing)) {
        report_duplicate(rc, bind_span, "re-exported name `", name_id, "` is already defined in this scope", existing);
        ret err[fail.Fail].ok{};
    }

    var slot: u32 = 0;
    if (ps.kind == SYM_USE) { slot = ps.slot; }

    # a `fwd` binds its name at module scope, so what it forwards is module-level here as it is
    # where it is declared
    val res_sym: res[SymbolId, fail.Fail] = add_symbol(rc, ps.kind, SYM_FLAG_PUB | SYM_FLAG_MODULE, name_id, ps.canon, ast_id.DECL_NIL, slot, ps.origin);
    if (sel res_sym.err) {
        lang_phase.internal(?rc.status, res_sym.err);
        ret err[fail.Fail].err{res_sym.err};
    }
    val sid: SymbolId = res_sym.ok;
    rc.symbols[symbol_index(sid)].definition_file     = ps.file;
    rc.symbols[symbol_index(sid)].generic_arity       = ps.generic_arity;
    rc.symbols[symbol_index(sid)].has_comptime_params = ps.has_comptime_params;
    rc.symbols[symbol_index(sid)].has_pack_param      = ps.has_pack_param;
    rc.symbols[symbol_index(sid)].deprecation         = ps.deprecation;
    val res_notice: res[deprecation.Deprecation, fail.Fail] = declaration_deprecation(rc.ctx, rc.a, decl_id);
    if (sel res_notice.err)    { ret err[fail.Fail].err{res_notice.err}; }
    if (res_notice.ok.present) { rc.symbols[symbol_index(sid)].deprecation = res_notice.ok; }
    rc.symbols[symbol_index(sid)].testing = ps.testing || declaration_testing(rc.a, decl_id);

    val err_add: err[fail.Fail] = scope_add(rc, rc.module_scope, name_id, sid);
    if (sel err_add.err) { ret err_add; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[ast_id.decl_index(decl_id)] = sid;
    }
    ret err[fail.Fail].ok{};
}

fun collect_fwd_module(rc: *ResolveContext, decl_id: ast_id.DeclId, df: *ast_decl.DeclFwd, stable: module.StableModuleId) err[fail.Fail] {
    var alias_span: lang_source.Span = df.alias;
    if (alias_span.len == 0) {
        alias_span = leaf_span(rc, df.path);
    }

    val res_name: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, alias_span.offset, alias_span.len);
    if (sel res_name.err) {
        lang_phase.internal(?rc.status, fail.refused(res_name.err));
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val name_id: intern.StrId = res_name.ok;

    val existing: SymbolId = scope_lookup_local(rc, rc.module_scope, name_id);
    if (!symbol_is_nil(existing)) {
        report_duplicate(rc, alias_span, "re-exported name `", name_id, "` is already defined in this scope", existing);
        ret err[fail.Fail].ok{};
    }

    val res_declare: res[SymbolId, fail.Fail] = declare(rc, SYM_USE, SYM_FLAG_PUB, alias_span, decl_id, stable::u32, rc.own_stable, rc.module_scope);
    if (sel res_declare.err) {
        lang_phase.internal(?rc.status, res_declare.err);
        ret err[fail.Fail].err{res_declare.err};
    }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[ast_id.decl_index(decl_id)] = res_declare.ok;
    }
    ret err[fail.Fail].ok{};
}

fun gate_probe_ident_is_comptime_param(rc: *ResolveContext, eid: ast_id.ExprId) bool {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some)                             { ret false; }
    if (opt_expr.some.kind != ast_expr.EXPR_KIND_IDENT) { ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, opt_expr.some.data.ident.name);
    if (symbol_is_nil(sid)) { ret false; }
    val sym: *Symbol = ?rc.symbols[symbol_index(sid)];
    ret sym.kind == SYM_PARAM && (sym.flags & SYM_FLAG_COMPTIME) != 0;
}

fun gate_probe_ident_is_each_loopvar(rc: *ResolveContext, eid: ast_id.ExprId) bool {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some)                             { ret false; }
    if (opt_expr.some.kind != ast_expr.EXPR_KIND_IDENT) { ret false; }
    ret ident_is_each_loopvar(rc, opt_expr.some.data.ident.name);
}

fun gate_probe_member_is_field_loopvar(rc: *ResolveContext, eid: ast_id.ExprId) bool {
    ret member_object_is_field_loopvar(rc, eid);
}

fun gate_probe_is_field_type_operand(rc: *ResolveContext, eid: ast_id.ExprId) res[bool, fail.Fail] {
    ret res[bool, fail.Fail].ok{is_field_type_operand(rc, eid)};
}

fun resolve_gate_probes() comptime_gate.GateProbes[ResolveContext] {
    ret comptime_gate.gate_probes[ResolveContext](
        gate_probe_ident_is_comptime_param,
        gate_probe_ident_is_each_loopvar,
        gate_probe_member_is_field_loopvar,
        gate_probe_is_field_type_operand, comptime_expression);
}

fun gate_chain_defers_to_instantiation(rc: *ResolveContext, branches_start: u32, branches_len: u32) res[bool, fail.Fail] {
    ret comptime_gate.gate_chain_defers[ResolveContext](rc.a, rc.source, rc, resolve_gate_probes(),
        branches_start, branches_len);
}

fun bind_comptime_if(rc: *ResolveContext, branches_start: u32, branches_len: u32, span: lang_source.Span, at_decl_scope: bool) err[fail.Fail] {
    var nothing: bool = false;
    if (at_decl_scope) {
        val res_nothing: res[bool, fail.Fail] = comptime_gate.comptime_if_declares_nothing(rc.a, branches_start, branches_len);
        if (sel res_nothing.err) { ret refuse(rc, span, res_nothing.err); }
        nothing = res_nothing.ok;
    }
    if (nothing) {
        var di: u32 = 0;
        for (di < branches_len) {
            val arm: *ast_decl.ComptimeBranch = ?rc.a.comptime_branches.data[branches_start + di];
            if (!ast_id.expr_is_nil(arm.cond)) {
                val err_rce: err[fail.Fail] = bind_expr(rc, arm.cond);
                if (sel err_rce.err) { ret err_rce; }
            }
            val err_bind_decl_list: err[fail.Fail] = bind_decl_list(rc, arm.body_start, arm.body_len);
            if (sel err_bind_decl_list.err) { ret err_bind_decl_list; }
            di = di + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var all_arms: bool = false;
    if (!at_decl_scope) {
        val res_defers: res[bool, fail.Fail] = gate_chain_defers_to_instantiation(rc, branches_start, branches_len);
        if (sel res_defers.err) { ret refuse(rc, span, res_defers.err); }
        all_arms = res_defers.ok;
    }
    if (all_arms) {
        var ai: u32 = 0;
        for (ai < branches_len) {
            val arm: *ast_decl.ComptimeBranch = ?rc.a.comptime_branches.data[branches_start + ai];
            if (!ast_id.expr_is_nil(arm.cond)) {
                val err_bind_expr: err[fail.Fail] = bind_expr(rc, arm.cond);
                if (sel err_bind_expr.err) { ret err_bind_expr; }
            }
            val err_bind_stmt_list: err[fail.Fail] = bind_stmt_list(rc, arm.body_start, arm.body_len);
            if (sel err_bind_stmt_list.err) { ret err_bind_stmt_list; }
            ai = ai + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var bi: u32 = 0;
    for (bi < branches_len) {
        val br: *ast_decl.ComptimeBranch = ?rc.a.comptime_branches.data[branches_start + bi];
        if (!ast_id.expr_is_nil(br.cond)) {
            val err_rce: err[fail.Fail] = bind_expr(rc, br.cond);
            if (sel err_rce.err) { ret err_rce; }
        }
        val res_take: res[comptime_gate.GateOutcome, fail.Fail] = comptime_branch_active(rc, br, at_decl_scope);
        if (sel res_take.err) {
            ret err[fail.Fail].err{res_take.err};
        }
        val outcome: comptime_gate.GateOutcome = res_take.ok;
        if (outcome == comptime_gate.GATE_AWAITING_PHASE && !at_decl_scope) {
            mark_arm_names(rc, branches_start, bi, ARM_NONE, false);
            ret bind_deferred_arms(rc, branches_start + bi, branches_len - bi);
        }
        if (outcome == comptime_gate.GATE_AWAITING_PHASE || outcome == comptime_gate.GATE_REJECTED || outcome == comptime_gate.GATE_FAILED) {
            mark_arm_names(rc, branches_start, branches_len, ARM_NONE, at_decl_scope);
            ret err[fail.Fail].ok{};
        }
        if (outcome == comptime_gate.GATE_ACTIVE) {
            mark_arm_names(rc, branches_start, branches_len, bi, at_decl_scope);
            if (at_decl_scope) {
                ret bind_decl_list(rc, br.body_start, br.body_len);
            }
            ret bind_stmt_list(rc, br.body_start, br.body_len);
        }
        bi = bi + 1;
    }
    mark_arm_names(rc, branches_start, branches_len, ARM_NONE, at_decl_scope);
    ret err[fail.Fail].ok{};
}

val ARM_NONE: u32 = 0xFFFFFFFF;

# an arm resolution does not bind still references the names it spells, so a symbol import
# only such an arm uses is not unused. every arm but `bound` is scanned by name.
fun mark_arm_names(rc: *ResolveContext, start: u32, len: u32, bound: u32, at_decl_scope: bool) {
    if (rc.symbol_imports.len == 0) { ret; }
    var i: u32 = 0;
    for (i < len) {
        if (i == bound) {
            i = i + 1;
            cnt;
        }
        val arm: *ast_decl.ComptimeBranch = ?rc.a.comptime_branches.data[start + i];
        if (!ast_id.expr_is_nil(arm.cond)) {
            val opt_cond: opt[*ast_expr.Expr] = ast.get_expr(rc.a, arm.cond);
            if (sel opt_cond.some) { mark_names_in(rc, opt_cond.some.span); }
        }
        var k: u32 = 0;
        for (k < arm.body_len) {
            if (at_decl_scope) {
                val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(rc.a, rc.a.decl_ids.data[arm.body_start + k]);
                if (sel opt_decl.some) { mark_names_in(rc, opt_decl.some.span); }
            }
            or {
                val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(rc.a, rc.a.stmt_ids.data[arm.body_start + k]);
                if (sel opt_stmt.some) { mark_names_in(rc, opt_stmt.some.span); }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

# an asm body names what it uses in `{name}` substitutions, which lowering binds
# binds each `{name}` of an asm block to the local it names: a runtime `val`, `var` or
# parameter in scope, which lowering stores to and loads from by its slot
fun bind_asm(rc: *ResolveContext, sid: ast_id.StmtId, body: lang_source.Span) err[fail.Fail] {
    var at: usize = body.offset;
    for (true) {
        val r: fe_asm.Ref = fe_asm.ref_next(rc.source, body, ?at);
        if (r.kind == fe_asm.REF_END) { brk; }
        if (r.kind == fe_asm.REF_UNTERMINATED) {
            record_report(rc, diagnostic_kind.ASM_SYNTAX, body, "unterminated '{' in inline asm body");
            brk;
        }
        if (r.kind == fe_asm.REF_EMPTY) {
            record_report(rc, diagnostic_kind.ASM_SYNTAX, body, "empty '{}' in asm body; write '{name}' to reference a local");
            brk;
        }
        mark_names_in(rc, r.inner);
        if (r.kind == fe_asm.REF_NAME) {
            val err_bound: err[fail.Fail] = bind_asm_name(rc, sid, body, r.inner);
            if (sel err_bound.err) { ret err_bound; }
        }
    }
    ret err[fail.Fail].ok{};
}

fun bind_asm_name(rc: *ResolveContext, sid: ast_id.StmtId, body: lang_source.Span, name_span: lang_source.Span) err[fail.Fail] {
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?rc.s.interner, rc.source, name_span.offset, name_span.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val name: intern.StrId = res_name.ok;
    var i:    usize        = 0;
    for (i < rc.asm_binds.len) {
        val b: *AsmBind = ?rc.asm_binds.data[i];
        if (ast_id.stmt_same(b.stmt, sid) && intern.str_same(b.name, name)) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    val found: SymbolId = scope_lookup_chain(rc, rc.current_scope, name);
    var local: bool     = false;
    if (!symbol_is_nil(found) && !symbol_is_rejected(found)) {
        val sym: *Symbol = ?rc.symbols[symbol_index(found)];
        local = (sym.kind == SYM_VAL || sym.kind == SYM_VAR || sym.kind == SYM_PARAM) && (sym.flags & SYM_FLAG_MODULE) == 0;
        if (local && !symbol_is_runtime(sym)) {
            ret report_asm_name(rc, body, "'", name, "' is not stack-allocated and cannot be used in inline asm");
        }
    }
    if (!local) {
        ret report_asm_name(rc, body, "unknown local '", name, "' in inline asm; only stack-allocated variables in scope can be referenced");
    }
    rc.symbols[symbol_index(found)].flags = rc.symbols[symbol_index(found)].flags | SYM_FLAG_STORED;
    val res_pushed: res[usize, A.Error] = collections_vector.push[AsmBind](?rc.asm_binds, AsmBind{stmt: sid, name: name, symbol: found});
    if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
    ret err[fail.Fail].ok{};
}

fun report_asm_name(rc: *ResolveContext, body: lang_source.Span, prefix: str, name: intern.StrId, suffix: str) err[fail.Fail] {
    val res_begun: res[diagnostic.DiagnosticBuilder, fail.Fail] = named_builder(rc, diagnostic_kind.ASM_LOCAL, body, prefix, name, suffix);
    if (sel res_begun.err) { ret err[fail.Fail].err{res_begun.err}; }
    var b:                diagnostic.DiagnosticBuilder = res_begun.ok;
    val err_commit_built: err[fail.Fail]               = commit_built(rc, ?b);
    if (sel err_commit_built.err) { ret err_commit_built; }
    ret err[fail.Fail].ok{};
}

# the locals an asm block binds, in the order its body names them
pub fun asm_binds_at(r: *ResolveResult, sid: ast_id.StmtId, out: *collections_vector.Vector[AsmBind]) err[fail.Fail] {
    var i: usize = 0;
    for (i < r.asm_binds.len) {
        if (ast_id.stmt_same(r.asm_binds.data[i].stmt, sid)) {
            val res_pushed: res[usize, A.Error] = collections_vector.push[AsmBind](out, r.asm_binds.data[i]);
            if (sel res_pushed.err) { ret err[fail.Fail].err{fail.refused(res_pushed.err)}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun name_byte(c: char) bool {
    ret (c >= 'a'::char && c <= 'z'::char) || (c >= 'A'::char && c <= 'Z'::char) || (c >= '0'::char && c <= '9'::char) || c == '_'::char;
}

# every identifier spelled in the span uses the symbol import of that name
fun mark_names_in(rc: *ResolveContext, span: lang_source.Span) {
    val end: usize = span.offset + span.len;
    var i:   usize = span.offset;
    for (i < end) {
        if (!name_byte(rc.source[i])) {
            i = i + 1;
            cnt;
        }
        val start: usize = i;
        for (i < end && name_byte(rc.source[i])) { i = i + 1; }
        val lead: char = rc.source[start];
        if (lead < '0'::char || lead > '9'::char) { mark_import_spelled(rc, start, i - start); }
    }
}

fun mark_import_spelled(rc: *ResolveContext, offset: usize, len: usize) {
    var i: usize = 0;
    for (i < rc.symbol_imports.len) {
        val b: *SymbolImport = ?rc.symbol_imports.data[i];
        if (!b.used && b.span.len == len && region_equal(rc.source, b.span.offset, offset, len)) { b.used = true; }
        i = i + 1;
    }
}

fun region_equal(text: str, x: usize, y: usize, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (text[x + i] != text[y + i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun mark_import_used(rc: *ResolveContext, name: intern.StrId) {
    var i: usize = 0;
    for (i < rc.symbol_imports.len) {
        val b: *SymbolImport = ?rc.symbol_imports.data[i];
        if (intern.str_same(b.name, name)) { b.used = true; }
        i = i + 1;
    }
}

fun warn_unused(rc: *ResolveContext, b: *SymbolImport) err[fail.Fail] {
    val opt_name: opt[str] = intern.get(?rc.s.interner, b.name);
    if (!sel opt_name.some) { ret err[fail.Fail].err{fail.message("imported name is not interned")}; }
    ret diagnostic.reportf(rc.diags, diagnostic_kind.IMPORT_UNUSED, rc.a.file_id, b.span, "unused import `{}`", opt_name.some);
}

# a symbol import nothing in the module names adds nothing to the build. a module import is
# never reported: it pulls its module into the build, which is an effect of its own.
# only the root project's modules record imports, so a dependency's are never reported.
fun warn_unused_imports(rc: *ResolveContext) err[fail.Fail] {
    var f: usize = 0;
    for (f < rc.fwd_paths.len) {
        mark_names_in(rc, rc.fwd_paths.data[f]);
        f = f + 1;
    }
    var i: usize = 0;
    for (i < rc.symbol_imports.len) {
        val b: *SymbolImport = ?rc.symbol_imports.data[i];
        if (!b.used) {
            val err_warn_unused: err[fail.Fail] = warn_unused(rc, b);
            if (sel err_warn_unused.err) { ret err_warn_unused; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a statement-level gate only sema can decide: any arm from this one on may be the one it
# selects, so each is bound, and a name none of them can see is left for sema to report if it
# walks that arm. the gates of later arms are bound as the arms' own contents are.
fun bind_deferred_arms(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    val saved: bool = rc.in_deferred_arm;
    rc.in_deferred_arm = true;
    var i: u32 = 0;
    for (i < len) {
        val arm: *ast_decl.ComptimeBranch = ?rc.a.comptime_branches.data[start + i];
        if (i > 0 && !ast_id.expr_is_nil(arm.cond)) {
            val err_rce: err[fail.Fail] = bind_expr(rc, arm.cond);
            if (sel err_rce.err) {
                rc.in_deferred_arm = saved;
                ret err_rce;
            }
        }
        val err_bind_stmt_list: err[fail.Fail] = bind_stmt_list(rc, arm.body_start, arm.body_len);
        if (sel err_bind_stmt_list.err) {
            rc.in_deferred_arm = saved;
            ret err_bind_stmt_list;
        }
        i = i + 1;
    }
    rc.in_deferred_arm = saved;
    ret err[fail.Fail].ok{};
}

pub fun symbol_is_runtime(sym: *Symbol) bool {
    if ((sym.flags & SYM_FLAG_COMPTIME) != 0) { ret false; }
    if (sym.kind == SYM_VAL || sym.kind == SYM_VAR) {
        ret (sym.flags & SYM_FLAG_MODULE) == 0;
    }
    ret sym.kind == SYM_PARAM;
}

# whether a resolved expression names a runtime binding, a local or a parameter
# whose value no comptime evaluation sees; false for a name that resolved to none
pub fun expr_is_runtime(rr: *ResolveResult, eid: ast_id.ExprId) bool {
    if (rr == nil || rr.expr_resolved == nil || ast_id.expr_is_nil(eid) || eid::u32 >= rr.expr_count) { ret false; }
    val sid: SymbolId = rr.expr_resolved[ast_id.expr_index(eid)];
    if (symbol_is_nil(sid) || sid::u32 >= rr.symbol_count) { ret false; }
    ret symbol_is_runtime(?rr.symbols[symbol_index(sid)]);
}

fun comptime_ident_is_runtime(rc: *ResolveContext, eid: ast_id.ExprId) bool {
    if (rc == nil || rc.expr_resolved == nil)                       { ret false; }
    if (ast_id.expr_is_nil(eid) || eid::u32 >= rc.a.exprs.len::u32) { ret false; }
    val sid: SymbolId = rc.expr_resolved[ast_id.expr_index(eid)];
    if (symbol_is_nil(sid) || symbol_index(sid) >= rc.sym_len) { ret false; }
    ret symbol_is_runtime(?rc.symbols[symbol_index(sid)]);
}

fun bind_fun(rc: *ResolveContext, f: *ast_decl.DeclFun, decl_id: ast_id.DeclId) err[fail.Fail] {
    val res_open_scope: res[ScopeId, fail.Fail] = scope_init(rc, rc.current_scope);
    if (sel res_open_scope.err) { ret err[fail.Fail].err{res_open_scope.err}; }
    val gen_scope:   ScopeId = res_open_scope.ok;
    val saved_scope: ScopeId = rc.current_scope;
    rc.current_scope = gen_scope;

    var gi: u32 = 0;
    for (gi < f.generics_len) {
        val name:        lang_source.Span         = rc.a.generic_names.data[f.generics_start + gi];
        val res_declare: res[SymbolId, fail.Fail] = declare(rc, SYM_GENERIC, 0, name, decl_id, gi, rc.own_stable, gen_scope);
        if (sel res_declare.err) {
            lang_phase.internal(?rc.status, res_declare.err);
            rc.current_scope = saved_scope;
            ret err[fail.Fail].err{res_declare.err};
        }
        gi = gi + 1;
    }

    val res_open_scope_gen_scope: res[ScopeId, fail.Fail] = scope_init(rc, gen_scope);
    if (sel res_open_scope_gen_scope.err) {
        rc.current_scope = saved_scope;
        ret err[fail.Fail].err{res_open_scope_gen_scope.err};
    }
    val param_scope: ScopeId = res_open_scope_gen_scope.ok;
    rc.current_scope = param_scope;

    var pi: u32 = 0;
    for (pi < f.params_len) {
        val tn:            *ast_decl.TypedName = ?rc.a.typed_names.data[f.params_start + pi];
        val err_bind_type: err[fail.Fail]      = bind_type(rc, tn.ty);
        if (sel err_bind_type.err) {
            rc.current_scope = saved_scope;
            ret err_bind_type;
        }
        val pflags:      u8                       = param_flags(tn);
        val res_declare: res[SymbolId, fail.Fail] = declare(rc, SYM_PARAM, pflags, tn.name, decl_id, pi, rc.own_stable, param_scope);
        if (sel res_declare.err) {
            lang_phase.internal(?rc.status, res_declare.err);
            rc.current_scope = saved_scope;
            ret err[fail.Fail].err{res_declare.err};
        }
        pi = pi + 1;
    }

    if (!ast_id.type_is_nil(f.return_type)) {
        val err_bind_type: err[fail.Fail] = bind_type(rc, f.return_type);
        if (sel err_bind_type.err) {
            rc.current_scope = saved_scope;
            ret err_bind_type;
        }
    }

    if (!ast_id.stmt_is_nil(f.body)) {
        val err_bind_stmt: err[fail.Fail] = bind_stmt(rc, f.body);
        if (sel err_bind_stmt.err) {
            rc.current_scope = saved_scope;
            ret err_bind_stmt;
        }
    }

    rc.current_scope = saved_scope;
    ret err[fail.Fail].ok{};
}

fun param_flags(tn: *ast_decl.TypedName) u8 {
    if (tn.comptime) { ret SYM_FLAG_COMPTIME; }
    ret 0;
}

fun bind_rec(rc: *ResolveContext, r: *ast_decl.DeclRec, decl_id: ast_id.DeclId) err[fail.Fail] {
    ret bind_aggregate(rc, r.generics_start, r.generics_len, r.fields_start, r.fields_len, decl_id, false);
}

fun bind_uni(rc: *ResolveContext, u: *ast_decl.DeclUni, decl_id: ast_id.DeclId) err[fail.Fail] {
    ret bind_aggregate(rc, u.generics_start, u.generics_len, u.fields_start, u.fields_len, decl_id, false);
}

fun bind_aggregate(rc: *ResolveContext, generics_start: u32, generics_len: u32, fields_start: u32, fields_len: u32, decl_id: ast_id.DeclId, tagged: bool) err[fail.Fail] {
    val res_open_scope: res[ScopeId, fail.Fail] = scope_init(rc, rc.current_scope);
    if (sel res_open_scope.err) { ret err[fail.Fail].err{res_open_scope.err}; }
    val gen_scope:   ScopeId = res_open_scope.ok;
    val saved_scope: ScopeId = rc.current_scope;
    rc.current_scope = gen_scope;

    var gi: u32 = 0;
    for (gi < generics_len) {
        val name:        lang_source.Span         = rc.a.generic_names.data[generics_start + gi];
        val res_declare: res[SymbolId, fail.Fail] = declare(rc, SYM_GENERIC, 0, name, decl_id, gi, rc.own_stable, gen_scope);
        if (sel res_declare.err) {
            lang_phase.internal(?rc.status, res_declare.err);
            rc.current_scope = saved_scope;
            ret err[fail.Fail].err{res_declare.err};
        }
        gi = gi + 1;
    }

    var fi: u32 = 0;
    for (fi < fields_len) {
        var ty: ast_id.TypeId = ast_id.TYPE_NIL;
        if (tagged) { ty = rc.a.tag_cases.data[fields_start + fi].payload; }
        or          { ty = rc.a.typed_names.data[fields_start + fi].ty; }
        val err_bind_type: err[fail.Fail] = bind_type(rc, ty);
        if (sel err_bind_type.err) {
            rc.current_scope = saved_scope;
            ret err_bind_type;
        }
        fi = fi + 1;
    }

    rc.current_scope = saved_scope;
    ret err[fail.Fail].ok{};
}

fun bind_stmt_list(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val sid:           ast_id.StmtId  = rc.a.stmt_ids.data[start + i];
        val err_bind_stmt: err[fail.Fail] = bind_stmt(rc, sid);
        if (sel err_bind_stmt.err) { ret err_bind_stmt; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_stmt(rc: *ResolveContext, sid: ast_id.StmtId) err[fail.Fail] {
    if (ast_id.stmt_is_nil(sid)) { ret err[fail.Fail].ok{}; }
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(rc.a, sid);
    if (!sel opt_stmt.some) { ret err[fail.Fail].err{fail.message("StmtId out of range")}; }
    val s: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted()) { ret refuse_nesting(rc, s.span); }

    if (s.kind == ast_stmt.STMT_KIND_BLOCK) { ret bind_block(rc, ?s.data.block); }
    if (s.kind == ast_stmt.STMT_KIND_EXPR)  { ret bind_expr(rc, s.data.expr.expr); }
    if (s.kind == ast_stmt.STMT_KIND_RET) {
        if (ast_id.expr_is_nil(s.data.ret_.value)) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, s.data.ret_.value);
    }
    if (s.kind == ast_stmt.STMT_KIND_FIN) { ret bind_stmt(rc, s.data.fin_.body); }
    if (s.kind == ast_stmt.STMT_KIND_BRK || s.kind == ast_stmt.STMT_KIND_CNT) {
        ret err[fail.Fail].ok{};
    }
    if (s.kind == ast_stmt.STMT_KIND_IF) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, s.data.if_.cond);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        val err_bind_stmt: err[fail.Fail] = bind_stmt(rc, s.data.if_.then_block);
        if (sel err_bind_stmt.err) { ret err_bind_stmt; }
        ret bind_stmt(rc, s.data.if_.else_block);
    }
    if (s.kind == ast_stmt.STMT_KIND_FOR) {
        if (!ast_id.expr_is_nil(s.data.for_.cond)) {
            val err_bind_expr: err[fail.Fail] = bind_expr(rc, s.data.for_.cond);
            if (sel err_bind_expr.err) { ret err_bind_expr; }
        }
        ret bind_stmt(rc, s.data.for_.body);
    }
    if (s.kind == ast_stmt.STMT_KIND_DECL) {
        ret bind_local_decl(rc, s.data.decl.decl);
    }
    if (s.kind == ast_stmt.STMT_KIND_ASM) { ret bind_asm(rc, sid, s.data.asm_.body); }
    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        ret bind_comptime_if(rc, s.data.comptime_if.branches_start, s.data.comptime_if.branches_len, s.span, false);
    }
    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_EACH) {
        ret bind_comptime_each(rc, ?s.data.comptime_each);
    }
    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_DIRECTIVE) {
        ret err[fail.Fail].ok{};
    }
    if (s.kind == ast_stmt.STMT_KIND_ERROR) { ret err[fail.Fail].ok{}; }
    ret unknown_kind(rc, "StmtKind", s.kind::u32);
}

fun bind_comptime_each(rc: *ResolveContext, ce: *ast_stmt.StmtComptimeEach) err[fail.Fail] {
    val err_bind_expr: err[fail.Fail] = bind_expr(rc, ce.seq);
    if (sel err_bind_expr.err) { ret err_bind_expr; }

    val res_open_scope: res[ScopeId, fail.Fail] = scope_init(rc, rc.current_scope);
    if (sel res_open_scope.err) { ret err[fail.Fail].err{res_open_scope.err}; }
    val saved: ScopeId = rc.current_scope;
    rc.current_scope = res_open_scope.ok;

    val res_declare: res[SymbolId, fail.Fail] = declare(rc, SYM_VAL, SYM_FLAG_COMPTIME, ce.var_name, ast_id.DECL_NIL, 0, rc.own_stable, rc.current_scope);
    if (sel res_declare.err) {
        lang_phase.internal(?rc.status, res_declare.err);
        rc.current_scope = saved;
        ret err[fail.Fail].err{res_declare.err};
    }

    val err_bind_stmt_list: err[fail.Fail] = bind_stmt_list(rc, ce.body_start, ce.body_len);
    rc.current_scope = saved;
    ret err_bind_stmt_list;
}

fun bind_block(rc: *ResolveContext, b: *ast_stmt.StmtBlock) err[fail.Fail] {
    val res_open_scope: res[ScopeId, fail.Fail] = scope_init(rc, rc.current_scope);
    if (sel res_open_scope.err) { ret err[fail.Fail].err{res_open_scope.err}; }
    val saved: ScopeId = rc.current_scope;
    rc.current_scope = res_open_scope.ok;

    val err_bind_stmt_list: err[fail.Fail] = bind_stmt_list(rc, b.stmts_start, b.stmts_len);
    rc.current_scope = saved;
    ret err_bind_stmt_list;
}

fun bind_local_decl(rc: *ResolveContext, decl_id: ast_id.DeclId) err[fail.Fail] {
    if (ast_id.decl_is_nil(decl_id)) { ret err[fail.Fail].ok{}; }
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;

    if (d.kind > ast_decl.DECL_KIND_TAG && d.kind != ast_decl.DECL_KIND_ERROR) {
        ret unknown_kind(rc, "DeclKind", d.kind::u32);
    }
    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) {
        ret err[fail.Fail].ok{};
    }

    if (!ast_id.type_is_nil(d.data.bind.ty)) {
        val err_bind_type: err[fail.Fail] = bind_type(rc, d.data.bind.ty);
        if (sel err_bind_type.err) { ret err_bind_type; }
    }
    if (!ast_id.expr_is_nil(d.data.bind.init)) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, d.data.bind.init);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
    }

    val kind:    SymKind                  = if_val_kind(d.kind == ast_decl.DECL_KIND_VAL);
    val res_sym: res[SymbolId, fail.Fail] = declare(rc, kind, 0, d.data.bind.name, decl_id, 0, rc.own_stable, rc.current_scope);
    if (sel res_sym.err) {
        lang_phase.internal(?rc.status, res_sym.err);
        ret err[fail.Fail].err{res_sym.err};
    }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[ast_id.decl_index(decl_id)] = res_sym.ok;
    }

    ret err[fail.Fail].ok{};
}

fun if_val_kind(is_val: bool) SymKind {
    if (is_val) { ret SYM_VAL; }
    ret SYM_VAR;
}

# mark what the bound expression `eid` names as stored: the target of an assignment or the
# operand of an address-of, where it is a name
fun stored_mark(rc: *ResolveContext, eid: ast_id.ExprId) {
    if (rc.expr_resolved == nil || ast_id.expr_is_nil(eid)) { ret; }
    val sid: SymbolId = rc.expr_resolved[ast_id.expr_index(eid)];
    if (symbol_index(sid) >= rc.sym_len) { ret; }
    rc.symbols[symbol_index(sid)].flags = rc.symbols[symbol_index(sid)].flags | SYM_FLAG_STORED;
}

# mark the name an assignment's target `eid` is reached from, through fields and elements, as
# written in part. a target that is the name itself is stored, not written in part
fun written_mark(rc: *ResolveContext, eid: ast_id.ExprId) {
    var cur:  ast_id.ExprId = eid;
    var part: bool          = false;
    for (!ast_id.expr_is_nil(cur)) {
        val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, cur);
        if (sel opt_expr.none) { ret; }
        val e: *ast_expr.Expr = opt_expr.some;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER)  { cur = e.data.member.object; }
        or (e.kind == ast_expr.EXPR_KIND_PROJECT) { cur = e.data.project.object; }
        or (e.kind == ast_expr.EXPR_KIND_INDEX)   { cur = e.data.index.object; }
        or {
            if (!part || e.kind != ast_expr.EXPR_KIND_IDENT || rc.expr_resolved == nil) { ret; }
            val sid: SymbolId = rc.expr_resolved[ast_id.expr_index(cur)];
            if (symbol_index(sid) < rc.sym_len) { rc.symbols[symbol_index(sid)].flags = rc.symbols[symbol_index(sid)].flags | SYM_FLAG_WRITTEN; }
            ret;
        }
        part = true;
    }
}

# mark the name the bound place `eid` is reached from, through fields and elements, as reached
fun reached_mark(rc: *ResolveContext, eid: ast_id.ExprId) {
    var cur: ast_id.ExprId = eid;
    for (!ast_id.expr_is_nil(cur)) {
        val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, cur);
        if (sel opt_expr.none) { ret; }
        val e: *ast_expr.Expr = opt_expr.some;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER)  { cur = e.data.member.object; }
        or (e.kind == ast_expr.EXPR_KIND_PROJECT) { cur = e.data.project.object; }
        or (e.kind == ast_expr.EXPR_KIND_INDEX)   { cur = e.data.index.object; }
        or {
            if (e.kind != ast_expr.EXPR_KIND_IDENT || rc.expr_resolved == nil) { ret; }
            val sid: SymbolId = rc.expr_resolved[ast_id.expr_index(cur)];
            if (symbol_index(sid) < rc.sym_len) { rc.symbols[symbol_index(sid)].flags = rc.symbols[symbol_index(sid)].flags | SYM_FLAG_REACHED; }
            ret;
        }
    }
}

fun bind_expr(rc: *ResolveContext, eid: ast_id.ExprId) err[fail.Fail] {
    if (ast_id.expr_is_nil(eid)) { ret err[fail.Fail].ok{}; }
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val e: *ast_expr.Expr = opt_expr.some;
    if (stack.exhausted()) { ret refuse_nesting(rc, e.span); }

    if (e.kind == ast_expr.EXPR_KIND_IDENT) {
        ret bind_ident(rc, eid, e.data.ident.tok, e.data.ident.name);
    }
    if (e.kind == ast_expr.EXPR_KIND_BINARY) {
        if (intrinsic.is_type_comparison_binary(rc.a, rc.source, ?e.data.binary,
            is_field_type_operand(rc, e.data.binary.lhs),
            is_field_type_operand(rc, e.data.binary.rhs))) {
            ret bind_type_comparison(rc, ?e.data.binary);
        }
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.binary.lhs);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        if (e.data.binary.op == ast_expr.BIN_ASSIGN) {
            stored_mark(rc, e.data.binary.lhs);
            written_mark(rc, e.data.binary.lhs);
        }
        ret bind_expr(rc, e.data.binary.rhs);
    }
    if (e.kind == ast_expr.EXPR_KIND_UNARY) {
        val err_bound: err[fail.Fail] = bind_expr(rc, e.data.unary.operand);
        if (sel err_bound.err) { ret err_bound; }
        if (e.data.unary.op == ast_expr.UN_ADDR) {
            stored_mark(rc, e.data.unary.operand);
            reached_mark(rc, e.data.unary.operand);
        }
        ret err_bound;
    }
    if (e.kind == ast_expr.EXPR_KIND_SPREAD) {
        ret bind_expr(rc, e.data.spread.inner);
    }
    if (e.kind == ast_expr.EXPR_KIND_CALL) {
        if (!ast_id.expr_is_nil(e.data.call.index_callee)) {
            ret resolve_bracket_call(rc, eid);
        }

        val opt_intr: opt[err[fail.Fail]] = bind_comptime_intrinsic_call(rc, ?e.data.call);
        if (sel opt_intr.some) { ret opt_intr.some; }

        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.call.callee);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        ret bind_generic_call(rc, e.data.call.type_args_start, e.data.call.type_args_len, e.data.call.args_start, e.data.call.args_len);
    }
    if (e.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        ret resolve_bracket_value(rc, eid);
    }
    if (e.kind == ast_expr.EXPR_KIND_INDEX) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.index.object);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        ret bind_index_payload(rc, ?e.data.index);
    }
    if (e.kind == ast_expr.EXPR_KIND_PROJECT) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.project.object);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        ret bind_expr(rc, e.data.project.field);
    }
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.member.object);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        ret bind_member_qualified(rc, eid, ?e.data.member);
    }
    if (e.kind == ast_expr.EXPR_KIND_CAST) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.cast.value);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        ret bind_type(rc, e.data.cast.ty);
    }
    if (e.kind == ast_expr.EXPR_KIND_STRIP) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.strip.value);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        ret bind_type(rc, e.data.strip.ty);
    }
    if (e.kind == ast_expr.EXPR_KIND_ARRAY_LIT) {
        val err_bind_type: err[fail.Fail] = bind_type(rc, e.data.array_lit.ty);
        if (sel err_bind_type.err) { ret err_bind_type; }
        ret bind_expr_list(rc, e.data.array_lit.elems_start, e.data.array_lit.elems_len);
    }
    if (e.kind == ast_expr.EXPR_KIND_VECTOR_LIT) {
        val err_bind_literal_head: err[fail.Fail] = bind_literal_head(rc, e.data.vector_lit.ty);
        if (sel err_bind_literal_head.err) { ret err_bind_literal_head; }
        # a head that names a case is a tag construction, not a lane list
        if (literal_head_names_case(rc, e.data.vector_lit.ty)) { rc.expr_choices[ast_id.expr_index(eid)] = interpretation.CASE_LITERAL; }
        ret bind_expr_list(rc, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len);
    }
    if (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT) {
        val err_bind_literal_head: err[fail.Fail] = bind_literal_head(rc, e.data.struct_lit.ty);
        if (sel err_bind_literal_head.err) { ret err_bind_literal_head; }
        # positional elements, which a record literal repeats from its named fields
        val err_bind_expr_list: err[fail.Fail] = bind_expr_list(rc, e.data.struct_lit.elems_start, e.data.struct_lit.elems_len);
        if (sel err_bind_expr_list.err) { ret err_bind_expr_list; }
        var fi: u32 = 0;
        for (fi < e.data.struct_lit.fields_len) {
            val finit: *ast_expr.FieldInit = ?rc.a.field_inits.data[e.data.struct_lit.fields_start + fi];
            if (finit.form == ast_expr.INIT_BARE) {
                rc.expr_resolved[ast_id.expr_index(finit.value)] = scope_lookup_chain(rc, rc.current_scope, finit.name_id);
            }
            or {
                val err_bind_expr: err[fail.Fail] = bind_expr(rc, finit.value);
                if (sel err_bind_expr.err) { ret err_bind_expr; }
            }
            fi = fi + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (e.kind == ast_expr.EXPR_KIND_SEL) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.sel.place);
        if (sel err_bind_expr.err)                    { ret err_bind_expr; }
        if (ast_id.expr_is_nil(e.data.sel.case_desc)) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, e.data.sel.case_desc);
    }
    if (e.kind == ast_expr.EXPR_KIND_TYPE_REF) {
        ret bind_type(rc, e.data.type_ref.ty);
    }
    if (expr_kind_binds_nothing(e.kind)) { ret err[fail.Fail].ok{}; }

    ret unknown_kind(rc, "ExprKind", e.kind::u32);
}

fun expr_kind_binds_nothing(k: ast_expr.ExprKind) bool {
    ret k == ast_expr.EXPR_KIND_LIT_INT || k == ast_expr.EXPR_KIND_LIT_FLOAT
        || k == ast_expr.EXPR_KIND_LIT_CHAR || k == ast_expr.EXPR_KIND_LIT_STR
        || k == ast_expr.EXPR_KIND_LIT_NIL || k == ast_expr.EXPR_KIND_COMPTIME_IDENT
        || k == ast_expr.EXPR_KIND_ERROR;
}

fun bind_expr_list(rc: *ResolveContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val eid:           ast_id.ExprId  = rc.a.expr_ids.data[start + i];
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, eid);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun comptime_expression(rc: *ResolveContext, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    if (rc == nil || rc.a != a) { ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "resolution expression belongs to a different parsed owner")}; }
    val res_expr_choices_entry: res[ast_expr.Expr, fail.Fail] = interpretation.get(a, rc.expr_choices, rc.expr_choices_count, eid);
    if (sel res_expr_choices_entry.err) {
        lang_phase.internal(?rc.status, res_expr_choices_entry.err);
        ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_expr_choices_entry.err))};
    }
    ret res[ast_expr.Expr, comptime_failure.EvalFail].ok{res_expr_choices_entry.ok};
}

pub fun expression(rr: *ResolveResult, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, fail.Fail] {
    if (rr == nil) { ret res[ast_expr.Expr, fail.Fail].err{fail.message("resolved expression requires a resolver result")}; }
    ret interpretation.get(a, rr.expr_choices, rr.expr_choices_count, eid);
}

# the type node `tid` of `a`, whose text is `source`, as name resolution read it: a literal head
# it split names the type by its path's prefix and the case by the last segment
pub fun type_node(rr: *ResolveResult, a: *ast.Ast, source: str, tid: ast_id.TypeId) res[ast_type.Type, fail.Fail] {
    if (rr == nil) { ret res[ast_type.Type, fail.Fail].err{fail.message("resolved type requires a resolver result")}; }
    ret interpretation.type_node(a, source, rr.type_heads, rr.type_count::usize, tid);
}

# the type node `tid` as this resolution reads it so far
fun head_node(rc: *ResolveContext, tid: ast_id.TypeId) res[ast_type.Type, fail.Fail] {
    ret interpretation.type_node(rc.a, rc.source, rc.type_heads, rc.a.types.len, tid);
}

fun comptime_head(rc: *ResolveContext, a: *ast.Ast, tid: ast_id.TypeId) res[ast_type.Type, comptime_failure.EvalFail] {
    if (rc == nil || rc.a != a) { ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "resolution type belongs to a different parsed owner")}; }
    val res_head_node: res[ast_type.Type, fail.Fail] = head_node(rc, tid);
    if (sel res_head_node.err) {
        lang_phase.internal(?rc.status, res_head_node.err);
        ret res[ast_type.Type, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(res_head_node.err))};
    }
    ret res[ast_type.Type, comptime_failure.EvalFail].ok{res_head_node.ok};
}

# whether the literal `eid` constructs a tag case, its head read as this resolution reads it
fun is_case_literal(rc: *ResolveContext, eid: ast_id.ExprId) bool {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some) { ret false; }
    ret literal_head_names_case(rc, comptime.literal_head_type(opt_expr.some));
}

fun resolve_bracket_call(rc: *ResolveContext, eid: ast_id.ExprId) err[fail.Fail] {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val e: *ast_expr.Expr = opt_expr.some;

    val callee:          ast_id.ExprId = e.data.call.callee;
    val index_callee:    ast_id.ExprId = e.data.call.index_callee;
    val type_args_start: u32           = e.data.call.type_args_start;
    val type_args_len:   u32           = e.data.call.type_args_len;
    val args_start:      u32           = e.data.call.args_start;
    val args_len:        u32           = e.data.call.args_len;

    val err_bind_expr: err[fail.Fail] = bind_expr(rc, callee);
    if (sel err_bind_expr.err) { ret err_bind_expr; }

    if (callee_accepts_type_args(rc, callee)) {
        rc.expr_choices[ast_id.expr_index(eid)] = interpretation.GENERIC;
        ret bind_generic_call(rc, type_args_start, type_args_len, args_start, args_len);
    }

    val opt_idx: opt[*ast_expr.Expr] = ast.get_expr(rc.a, index_callee);
    if (!sel opt_idx.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val idxn:                   *ast_expr.Expr = opt_idx.some;
    val err_bind_index_payload: err[fail.Fail] = bind_index_payload(rc, ?idxn.data.index);
    if (sel err_bind_index_payload.err) { ret err_bind_index_payload; }

    rc.expr_choices[ast_id.expr_index(eid)] = interpretation.INDEX_CALL;
    ret bind_expr_list(rc, args_start, args_len);
}

fun resolve_bracket_value(rc: *ResolveContext, eid: ast_id.ExprId) err[fail.Fail] {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val e: *ast_expr.Expr = opt_expr.some;

    val object:          ast_id.ExprId    = e.data.call.callee;
    val index_callee:    ast_id.ExprId    = e.data.call.index_callee;
    val type_args_start: u32              = e.data.call.type_args_start;
    val type_args_len:   u32              = e.data.call.type_args_len;
    val span:            lang_source.Span = e.span;

    val err_bind_expr: err[fail.Fail] = bind_expr(rc, object);
    if (sel err_bind_expr.err) { ret err_bind_expr; }

    if (object_names_function(rc, object) || callee_accepts_type_args(rc, object)) {
        rc.expr_choices[ast_id.expr_index(eid)] = interpretation.GENERIC;
        ret bind_generic_call(rc, type_args_start, type_args_len, 0, 0);
    }

    if (ast_id.expr_is_nil(index_callee)) {
        val err_report: err[fail.Fail] = report(rc, diagnostic_kind.GENERIC_NOT_GENERIC, span,
            "type arguments in value position name a generic instance, but this does not name a generic function");
        if (sel err_report.err) { ret err_report; }
        rc.expr_choices[ast_id.expr_index(eid)] = interpretation.REJECTED;
        ret err[fail.Fail].ok{};
    }

    val opt_idx: opt[*ast_expr.Expr] = ast.get_expr(rc.a, index_callee);
    if (!sel opt_idx.some) { ret err[fail.Fail].err{fail.message("ExprId out of range")}; }
    val idxn:                   *ast_expr.Expr = opt_idx.some;
    val err_bind_index_payload: err[fail.Fail] = bind_index_payload(rc, ?idxn.data.index);
    if (sel err_bind_index_payload.err) { ret err_bind_index_payload; }

    rc.expr_choices[ast_id.expr_index(eid)] = interpretation.INDEX_VALUE;
    ret err[fail.Fail].ok{};
}

# the element index, and the count of a range
fun bind_index_payload(rc: *ResolveContext, ix: *ast_expr.ExprIndex) err[fail.Fail] {
    val err_bind_expr: err[fail.Fail] = bind_expr(rc, ix.index);
    if (sel err_bind_expr.err)  { ret err_bind_expr; }
    if (!ast_expr.is_range(ix)) { ret err[fail.Fail].ok{}; }
    ret bind_expr(rc, ix.count);
}

fun object_names_function(rc: *ResolveContext, object: ast_id.ExprId) bool {
    val opt_object: opt[*ast_expr.Expr] = ast.get_expr(rc.a, object);
    if (!sel opt_object.some) { ret false; }
    val e: *ast_expr.Expr = opt_object.some;
    if (e.kind != ast_expr.EXPR_KIND_IDENT && e.kind != ast_expr.EXPR_KIND_MEMBER) { ret false; }
    if (rc.expr_resolved == nil)                                                   { ret false; }
    val sid: SymbolId = rc.expr_resolved[ast_id.expr_index(object)];
    if (symbol_is_nil(sid) || symbol_index(sid) >= rc.sym_len) { ret false; }
    val sym: *Symbol = ?rc.symbols[symbol_index(sid)];
    ret sym.definition_kind == SYM_FUN;
}

fun bind_generic_call(rc: *ResolveContext, type_args_start: u32, type_args_len: u32, args_start: u32, args_len: u32) err[fail.Fail] {
    var ti: u32 = 0;
    for (ti < type_args_len) {
        val arg_id:        ast_id.TypeId  = rc.a.type_ids.data[type_args_start + ti];
        val err_bind_type: err[fail.Fail] = bind_type(rc, arg_id);
        if (sel err_bind_type.err) { ret err_bind_type; }
        ti = ti + 1;
    }
    ret bind_expr_list(rc, args_start, args_len);
}

fun callee_accepts_type_args(rc: *ResolveContext, callee: ast_id.ExprId) bool {
    val opt_callee: opt[*ast_expr.Expr] = ast.get_expr(rc.a, callee);
    if (!sel opt_callee.some) { ret false; }
    val e: *ast_expr.Expr = opt_callee.some;
    if (e.kind != ast_expr.EXPR_KIND_IDENT && e.kind != ast_expr.EXPR_KIND_MEMBER) { ret false; }
    if (rc.expr_resolved == nil)                                                   { ret false; }
    val sid: SymbolId = rc.expr_resolved[ast_id.expr_index(callee)];
    if (symbol_is_nil(sid) || symbol_index(sid) >= rc.sym_len) { ret false; }
    val sym:  *Symbol = ?rc.symbols[symbol_index(sid)];
    val kind: SymKind = sym.definition_kind;
    ret kind == SYM_FUN || kind == SYM_REC || kind == SYM_UNI || kind == SYM_TAG
        || kind == SYM_DEF || kind == SYM_GENERIC || kind == SYM_PRIM;
}

fun bind_ident(rc: *ResolveContext, eid: ast_id.ExprId, span: lang_source.Span, name: intern.StrId) err[fail.Fail] {
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, name);
    if (symbol_is_nil(sid)) {
        var mark: SymbolId = SYMBOL_REJECTED;
        if (report_unresolved(rc, span, "unresolved identifier `", name, true)) { mark = SYMBOL_DEFERRED_NAME; }
        if (rc.expr_resolved != nil)                                            { rc.expr_resolved[ast_id.expr_index(eid)] = mark; }
    }
    or {
        if (rc.expr_resolved != nil) { rc.expr_resolved[ast_id.expr_index(eid)] = sid; }
    }
    ret err[fail.Fail].ok{};
}

# the nearest name in scope to `target`, as help and a fix replacing it, when
# one is close enough to be a likely misspelling
fun attach_suggestion(rc: *ResolveContext, b: *diagnostic.DiagnosticBuilder, span: lang_source.Span, target: intern.StrId) err[fail.Fail] {
    val opt_interner_entry: opt[str] = intern.get(?rc.s.interner, target);
    if (!sel opt_interner_entry.some) { ret err[fail.Fail].ok{}; }
    val tname: str   = opt_interner_entry.some;
    val tlen:  usize = str_len(tname);
    if (tlen == 0) { ret err[fail.Fail].ok{}; }

    var best_sym:  SymbolId = SYMBOL_NIL;
    var best_dist: usize    = MAX_SUGGEST_DISTANCE + 1;
    var max_dist:  usize    = tlen / 2;
    if (max_dist > MAX_SUGGEST_DISTANCE) { max_dist = MAX_SUGGEST_DISTANCE; }

    var cur: ScopeId = rc.current_scope;
    for (!scope_is_nil(cur)) {
        val sc: *Scope = ?rc.scopes[scope_index(cur)];
        var i:  u32    = 0;
        for (i < sc.len) {
            val cname_id: intern.StrId = sc.entries[i].name;
            if (!intern.str_same(cname_id, target)) {
                val opt_interner_entry: opt[str] = intern.get(?rc.s.interner, cname_id);
                if (sel opt_interner_entry.some) {
                    val cname: str   = opt_interner_entry.some;
                    val dist:  usize = edit_distance(tname, cname, best_dist);
                    if (dist <= max_dist && dist < best_dist) {
                        best_dist = dist;
                        best_sym  = sc.entries[i].sym;
                    }
                }
            }
            i = i + 1;
        }
        cur = rc.scopes[scope_index(cur)].parent;
    }

    if (symbol_is_nil(best_sym)) { ret err[fail.Fail].ok{}; }
    val opt_interner_entry_symbols: opt[str] = intern.get(?rc.s.interner, rc.symbols[symbol_index(best_sym)].name);
    if (!sel opt_interner_entry_symbols.some) { ret err[fail.Fail].ok{}; }
    val bname: str = opt_interner_entry_symbols.some;

    val res_note: res[str, fail.Fail] = diagnostic.suggestion_build(rc.s.alloc, bname);
    if (sel res_note.err) { ret err[fail.Fail].err{res_note.err}; }
    val err_helped: err[fail.Fail] = diagnostic.attach_help(b, res_note.ok);
    str_free(rc.s.alloc, res_note.ok);
    if (sel err_helped.err) { ret err_helped; }

    val res_flabel: res[str, fail.Fail] = diagnostic.fix_label_replace(rc.s.alloc, bname);
    if (sel res_flabel.err) { ret err[fail.Fail].err{res_flabel.err}; }
    val res_fixed: res[diagnostic.FixId, fail.Fail] = diagnostic.attach_fix(b, res_flabel.ok, rc.a.file_id, span, bname);
    str_free(rc.s.alloc, res_flabel.ok);
    if (sel res_fixed.err) { ret err[fail.Fail].err{res_fixed.err}; }
    ret err[fail.Fail].ok{};
}

fun report_named(rc: *ResolveContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str, name_id: intern.StrId, suffix: str) err[fail.Fail] {
    val res_begun: res[diagnostic.DiagnosticBuilder, fail.Fail] = named_builder(rc, k, span, prefix, name_id, suffix);
    if (sel res_begun.err) { ret err[fail.Fail].err{res_begun.err}; }
    var b: diagnostic.DiagnosticBuilder = res_begun.ok;
    ret commit_built(rc, ?b);
}

# a diagnostic of kind `k` at `span` whose message names `name_id` between
# `prefix` and `suffix`, or says `prefix` alone when the name cannot be read,
# for the reporter to extend before `commit_built`
fun named_builder(rc: *ResolveContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str, name_id: intern.StrId, suffix: str) res[diagnostic.DiagnosticBuilder, fail.Fail] {
    lang_phase.reject(?rc.status);
    var res_begun:          res[diagnostic.DiagnosticBuilder, fail.Fail] = res[diagnostic.DiagnosticBuilder, fail.Fail].err{fail.message("a reported name is absent from the interner")};
    val opt_interner_entry: opt[str]                                     = intern.get(?rc.s.interner, name_id);
    # a nil name reports the prefix alone; a name the interner lacks is a defect
    if (sel opt_interner_entry.some) { res_begun = diagnostic.builder_initf(rc.diags.a, k, rc.a.file_id, span, "{}{}{}", prefix, opt_interner_entry.some, suffix); }
    or (intern.str_is_nil(name_id))  { res_begun = diagnostic.builder_init(rc.diags.a, k, rc.a.file_id, span, prefix); }
    if (sel res_begun.err)           { internal_at(rc, span, res_begun.err); }
    ret res_begun;
}

# commit a diagnostic `named_builder` began; the builder is consumed
fun commit_built(rc: *ResolveContext, b: *diagnostic.DiagnosticBuilder) err[fail.Fail] {
    val err_commit: err[fail.Fail] = diagnostic.commit(b, rc.diags);
    if (sel err_commit.err) { lang_phase.internal(?rc.status, err_commit.err); }
    ret err_commit;
}

# a name bound twice in one scope, pointing at the binding it repeats
fun report_duplicate(rc: *ResolveContext, span: lang_source.Span, prefix: str, name_id: intern.StrId, suffix: str, prior: SymbolId) err[fail.Fail] {
    val res_begun: res[diagnostic.DiagnosticBuilder, fail.Fail] = named_builder(rc, diagnostic_kind.NAME_DUPLICATE, span, prefix, name_id, suffix);
    if (sel res_begun.err) { ret err[fail.Fail].err{res_begun.err}; }
    var b:            diagnostic.DiagnosticBuilder = res_begun.ok;
    val err_attached: err[fail.Fail]               = attach_prior_binding(rc, ?b, prior);
    if (sel err_attached.err) {
        diagnostic.builder_dnit(?b);
        internal_at(rc, span, err_attached.err);
        ret err_attached;
    }
    ret commit_built(rc, ?b);
}

fun report_named2(rc: *ResolveContext, k: diagnostic_kind.Kind, span: lang_source.Span, prefix: str, a_id: intern.StrId, mid: str, b_id: intern.StrId, suffix: str) err[fail.Fail] {
    val opt_interner_entry:      opt[str] = intern.get(?rc.s.interner, a_id);
    val opt_interner_entry_b_id: opt[str] = intern.get(?rc.s.interner, b_id);
    if (!sel opt_interner_entry.some) {
        ret report(rc, k, span, prefix);
    }
    if (!sel opt_interner_entry_b_id.some) {
        ret report(rc, k, span, prefix);
    }
    ret reportf(rc, k, span, "{}{}{}{}{}", prefix, opt_interner_entry.some, mid, opt_interner_entry_b_id.some, suffix);
}

val MAX_SUGGEST_DISTANCE: usize = 2;

fun edit_distance(a: str, b: str, cap: usize) usize {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    if (la == 0) { ret lb; }
    if (lb == 0) { ret la; }

    var prev: [128]usize;
    var curr: [128]usize;
    if (lb + 1 > SUGGEST_ROW) { ret cap + 1; }

    var j: usize = 0;
    for (j <= lb) {
        prev[j] = j;
        j       = j + 1;
    }

    var i: usize = 1;
    for (i <= la) {
        curr[0] = i;
        var row_min: usize = i;
        var k:       usize = 1;
        for (k <= lb) {
            var cost: usize = 1;
            if (a[i - 1] == b[k - 1]) { cost = 0; }
            var m:   usize = prev[k] + 1;
            val del: usize = curr[k - 1] + 1;
            if (del < m) { m = del; }
            val sub: usize = prev[k - 1] + cost;
            if (sub < m) { m = sub; }
            curr[k] = m;
            if (m < row_min) { row_min = m; }
            k = k + 1;
        }
        if (row_min > cap) { ret cap + 1; }
        var t: usize = 0;
        for (t <= lb) {
            prev[t] = curr[t];
            t       = t + 1;
        }
        i = i + 1;
    }
    ret prev[lb];
}

val SUGGEST_ROW: usize = 128;

fun callee_is_offset_of(rc: *ResolveContext, callee: ast_id.ExprId) bool {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, callee);
    if (!sel opt_expr.some) { ret false; }
    val ce: *ast_expr.Expr = opt_expr.some;
    if (ce.kind != ast_expr.EXPR_KIND_COMPTIME_IDENT) { ret false; }

    ret intrinsic.ident_intrinsic(rc.source, ce.data.comptime_ident.tok) == intrinsic.OFFSET_OF;
}

# a call on a rooted comptime path names its first argument as a bare word
# (`$mach.build.ct_mul(low, 64)`), so only the arguments after it are bound
fun bind_comptime_path_call(rc: *ResolveContext, c: *ast_expr.ExprCall) err[fail.Fail] {
    var i: u32 = 1;
    for (i < c.args_len) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, rc.a.expr_ids.data[c.args_start + i]);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun bind_comptime_intrinsic_call(rc: *ResolveContext, c: *ast_expr.ExprCall) opt[err[fail.Fail]] {
    val opt_callee: opt[*ast_expr.Expr] = ast.get_expr(rc.a, c.callee);
    if (sel opt_callee.some && opt_callee.some.kind == ast_expr.EXPR_KIND_MEMBER && intrinsic.is_comptime_path(rc.a, c.callee)) {
        ret opt[err[fail.Fail]].some{bind_comptime_path_call(rc, c)};
    }
    if (!callee_is_offset_of(rc, c.callee)) { ret opt[err[fail.Fail]].none{}; }
    if (c.args_len < 1)                     { ret opt[err[fail.Fail]].some{err[fail.Fail].ok{}}; }

    val arg0: ast_id.ExprId = rc.a.expr_ids.data[c.args_start];
    ret opt[err[fail.Fail]].some{bind_expr(rc, arg0)};
}

fun bind_type_comparison(rc: *ResolveContext, bin: *ast_expr.ExprBinary) err[fail.Fail] {
    val err_bind_type_operand: err[fail.Fail] = bind_type_operand(rc, bin.lhs);
    if (sel err_bind_type_operand.err) { ret err_bind_type_operand; }
    ret bind_type_operand(rc, bin.rhs);
}

fun bind_type_operand(rc: *ResolveContext, operand: ast_id.ExprId) err[fail.Fail] {
    if (intrinsic.is_type_of_call(rc.a, rc.source, operand)) {
        val arg: ast_id.ExprId = intrinsic.type_of_arg(rc.a, operand);
        if (ast_id.expr_is_nil(arg)) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, arg);
    }
    if (is_field_type_operand(rc, operand)) {
        val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, operand);
        if (!sel opt_expr.some) { ret err[fail.Fail].ok{}; }
        ret bind_expr(rc, opt_expr.some.data.member.object);
    }
    ret bind_type_name_expr(rc, operand);
}

fun bind_type_name_expr(rc: *ResolveContext, eid: ast_id.ExprId) err[fail.Fail] {
    if (ast_id.expr_is_nil(eid)) { ret err[fail.Fail].ok{}; }
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some) { ret err[fail.Fail].ok{}; }
    val e: *ast_expr.Expr = opt_expr.some;

    if (e.kind == ast_expr.EXPR_KIND_IDENT) {
        val name:              intern.StrId                 = e.data.ident.name;
        val res_type_spelling: res[TypeSpelling, fail.Fail] = type_spelling(rc, name);
        if (sel res_type_spelling.err) {
            lang_phase.internal(?rc.status, res_type_spelling.err);
            ret err[fail.Fail].err{res_type_spelling.err};
        }
        val sp: TypeSpelling = res_type_spelling.ok;

        if (sp.status == TYPE_SPELL_VEC_REFUSED) {
            if (rc.expr_resolved != nil) { rc.expr_resolved[ast_id.expr_index(eid)] = SYMBOL_REJECTED; }
            ret report_vector_refused(rc, e.data.ident.tok, name, sp.form);
        }

        var sid: SymbolId = sp.sym;
        if (symbol_is_nil(sid)) { sid = scope_lookup_chain(rc, rc.current_scope, name); }
        if (symbol_is_nil(sid)) {
            var mark: SymbolId = SYMBOL_REJECTED;
            if (report_unresolved(rc, e.data.ident.tok, "unresolved type name `", name, true)) { mark = SYMBOL_DEFERRED_TYPE; }
            if (rc.expr_resolved != nil)                                                       { rc.expr_resolved[ast_id.expr_index(eid)] = mark; }
        }
        or {
            if (rc.expr_resolved != nil) { rc.expr_resolved[ast_id.expr_index(eid)] = sid; }
        }
        ret err[fail.Fail].ok{};
    }

    if (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        val err_bind_expr: err[fail.Fail] = bind_expr(rc, e.data.member.object);
        if (sel err_bind_expr.err) { ret err_bind_expr; }
        ret bind_member_qualified(rc, eid, ?e.data.member);
    }

    ret bind_expr(rc, eid);
}

fun is_field_type_operand(rc: *ResolveContext, eid: ast_id.ExprId) bool {
    if (!intrinsic.is_field_type_member(rc.a, rc.source, eid)) { ret false; }
    ret member_object_is_field_loopvar(rc, eid);
}

fun member_object_is_field_loopvar(rc: *ResolveContext, eid: ast_id.ExprId) bool {
    val opt_expr: opt[*ast_expr.Expr] = ast.get_expr(rc.a, eid);
    if (!sel opt_expr.some) { ret false; }
    val obj:        ast_id.ExprId       = opt_expr.some.data.member.object;
    val opt_object: opt[*ast_expr.Expr] = ast.get_expr(rc.a, obj);
    if (!sel opt_object.some) { ret false; }
    val oe: *ast_expr.Expr = opt_object.some;
    if (oe.kind != ast_expr.EXPR_KIND_IDENT) { ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, oe.data.ident.name);
    if (symbol_is_nil(sid)) { ret false; }
    val sym: *Symbol = ?rc.symbols[symbol_index(sid)];
    ret sym.kind == SYM_VAL && (sym.flags & SYM_FLAG_COMPTIME) != 0;
}

fun ident_is_each_loopvar(rc: *ResolveContext, name: intern.StrId) bool {
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, name);
    if (symbol_is_nil(sid)) { ret false; }
    val sym: *Symbol = ?rc.symbols[symbol_index(sid)];
    ret sym.kind == SYM_VAL && (sym.flags & SYM_FLAG_COMPTIME) != 0 && ast_id.decl_is_nil(sym.decl);
}

# `A.b{...}` is a case selection when `A` is not a module, and a qualified type name when it is
fun bind_literal_head(rc: *ResolveContext, tid: ast_id.TypeId) err[fail.Fail] {
    if (ast_id.type_is_nil(tid)) { ret err[fail.Fail].ok{}; }
    val opt_type: opt[*ast_type.Type] = ast.get_type(rc.a, tid);
    if (sel opt_type.some) {
        val t: *ast_type.Type = opt_type.some;
        if (t.kind == ast_type.TYPE_KIND_NAMED && !ast_id.expr_is_nil(t.data.named.case_desc)) {
            val err_bind_expr: err[fail.Fail] = bind_expr(rc, t.data.named.case_desc);
            if (sel err_bind_expr.err) { ret err_bind_expr; }
        }
        or (t.kind == ast_type.TYPE_KIND_NAMED) {
            split_case_head(rc, tid);
        }
    }
    ret bind_type(rc, tid);
}

fun literal_head_names_case(rc: *ResolveContext, tid: ast_id.TypeId) bool {
    if (ast_id.type_is_nil(tid)) { ret false; }
    val res_head_node: res[ast_type.Type, fail.Fail] = head_node(rc, tid);
    if (sel res_head_node.err) {
        lang_phase.internal(?rc.status, res_head_node.err);
        ret false;
    }
    ret comptime.names_case(res_head_node.ok);
}

# records that the bare named head `tid` reads as a type and a case when its path's prefix names
# something other than a module; a head already split, or one the parser gave a case, stays
fun split_case_head(rc: *ResolveContext, tid: ast_id.TypeId) {
    val opt_type: opt[*ast_type.Type] = ast.get_type(rc.a, tid);
    if (!sel opt_type.some) {
        lang_phase.internal(?rc.status, fail.message("a type head names no type in its syntax tree"));
        ret;
    }
    val t: *ast_type.Type = opt_type.some;
    if (t.kind != ast_type.TYPE_KIND_NAMED || !ast_id.expr_is_nil(t.data.named.case_desc) || t.data.named.case_name.len != 0) { ret; }
    if (rc.type_heads[ast_id.type_index(tid)] != interpretation.HEAD_PARSED)                                                  { ret; }
    val path: lang_source.Span = t.data.named.name;
    val pre:  lang_source.Span = fe_path.prefix(rc.source, path);
    if (pre.len == 0 || pre.len >= path.len) { ret; }
    val leaf: lang_source.Span = fe_path.leaf(rc.source, path);
    if (leaf.len == 0) { ret; }

    val sid: SymbolId = path_tail_symbol(rc, pre, t.data.named.segments);
    if (symbol_is_nil(sid))                            { ret; }
    if (rc.symbols[symbol_index(sid)].kind == SYM_USE) { ret; }

    rc.type_heads[ast_id.type_index(tid)] = interpretation.HEAD_CASE;
}

# the tail symbol of a dotted path whose segment ids start at `segments` in the tree's path names,
# without reporting a name it does not know: SYMBOL_NIL when any segment is unknown
fun path_tail_symbol(rc: *ResolveContext, path: lang_source.Span, segments: u32) SymbolId {
    if (path.len == 0) { ret SYMBOL_NIL; }
    var cursor:         usize                 = path.offset;
    val end:            usize                 = path.offset + path.len;
    var current_module: module.StableModuleId = module.STABLE_MODULE_NIL;
    var current_sym:    SymbolId              = SYMBOL_NIL;
    var first:          bool                  = true;
    var segment:        u32                   = segments;

    for (cursor < end) {
        val seg_span: lang_source.Span = fe_path.next(rc.source, path, ?cursor);
        if (seg_span.len == 0) { brk; }
        val seg_name: intern.StrId = rc.a.path_names.data[segment];
        segment = segment + 1;

        if (first) {
            current_sym = scope_lookup_chain(rc, rc.current_scope, seg_name);
            first       = false;
        }
        or {
            current_sym = lookup_in_module(rc, current_module, seg_name);
        }
        if (symbol_is_nil(current_sym))                            { ret SYMBOL_NIL; }
        if (cursor >= end)                                         { brk; }
        if (rc.symbols[symbol_index(current_sym)].kind != SYM_USE) { ret SYMBOL_NIL; }
        current_module = use_stable(?rc.symbols[symbol_index(current_sym)]);
    }
    ret current_sym;
}

fun bind_type(rc: *ResolveContext, tid: ast_id.TypeId) err[fail.Fail] {
    if (ast_id.type_is_nil(tid)) { ret err[fail.Fail].ok{}; }
    val opt_type: opt[*ast_type.Type] = ast.get_type(rc.a, tid);
    if (!sel opt_type.some) { ret err[fail.Fail].err{fail.message("TypeId out of range")}; }
    val t: *ast_type.Type = opt_type.some;
    if (stack.exhausted()) { ret refuse_nesting(rc, t.span); }

    if (t.kind == ast_type.TYPE_KIND_NAMED) {
        # the path as this resolution reads it: a literal head it split names the type by its prefix
        val res_head: res[ast_type.Type, fail.Fail] = head_node(rc, tid);
        if (sel res_head.err) {
            lang_phase.internal(?rc.status, res_head.err);
            ret err[fail.Fail].err{res_head.err};
        }
        var head: ast_type.Type = res_head.ok;
        val sid:  SymbolId      = resolve_type_path(rc, ?head.data.named, t.span);
        if (rc.type_resolved != nil) { rc.type_resolved[ast_id.type_index(tid)] = sid; }
        var ai: u32 = 0;
        for (ai < t.data.named.args_len) {
            val arg_id:        ast_id.TypeId  = rc.a.type_ids.data[t.data.named.args_start + ai];
            val err_bind_type: err[fail.Fail] = bind_type(rc, arg_id);
            if (sel err_bind_type.err) { ret err_bind_type; }
            ai = ai + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (t.kind == ast_type.TYPE_KIND_PTR) {
        ret bind_type(rc, t.data.ptr.pointee);
    }
    if (t.kind == ast_type.TYPE_KIND_SECRET) {
        ret bind_type(rc, t.data.secret.inner);
    }
    if (t.kind == ast_type.TYPE_KIND_POINTEE_OF) {
        ret bind_type(rc, t.data.pointee_of.inner);
    }
    if (t.kind == ast_type.TYPE_KIND_DISCRIMINANT_OF) {
        ret bind_type(rc, t.data.discriminant_of.inner);
    }
    if (t.kind == ast_type.TYPE_KIND_FIELD_TYPE) {
        val res_range_add: res[intern.StrId, A.Error] =
            intern.range_add(?rc.s.interner, rc.source, t.data.field_type.var_name.offset, t.data.field_type.var_name.len);
        if (sel res_range_add.err) {
            lang_phase.internal(?rc.status, fail.refused(res_range_add.err));
            ret err[fail.Fail].err{fail.refused(res_range_add.err)};
        }
        val fsid: SymbolId = scope_lookup_chain(rc, rc.current_scope, res_range_add.ok);
        if (symbol_is_nil(fsid)) {
            ret report(rc, diagnostic_kind.COMPTIME_FIELD_TYPE_BINDING, t.data.field_type.var_name,
                "`f.type` as a type argument names a `$each` field-descriptor loop variable; this name is not one in scope");
        }
        val fsym: *Symbol = ?rc.symbols[symbol_index(fsid)];
        if (fsym.kind != SYM_VAL || (fsym.flags & SYM_FLAG_COMPTIME) == 0) {
            ret report(rc, diagnostic_kind.COMPTIME_FIELD_TYPE_BINDING, t.data.field_type.var_name,
                "`f.type` as a type argument names a `$each` field-descriptor loop variable; this name is an ordinary binding");
        }
        ret err[fail.Fail].ok{};
    }
    if (t.kind == ast_type.TYPE_KIND_ARRAY) {
        if (!ast_id.expr_is_nil(t.data.array.length)) {
            val err_bind_expr: err[fail.Fail] = bind_expr(rc, t.data.array.length);
            if (sel err_bind_expr.err) { ret err_bind_expr; }
        }
        ret bind_type(rc, t.data.array.element);
    }
    if (t.kind == ast_type.TYPE_KIND_FUN) {
        var pi: u32 = 0;
        for (pi < t.data.fun_.params_len) {
            val pt:            ast_id.TypeId  = rc.a.type_ids.data[t.data.fun_.params_start + pi];
            val err_bind_type: err[fail.Fail] = bind_type(rc, pt);
            if (sel err_bind_type.err) { ret err_bind_type; }
            pi = pi + 1;
        }
        ret bind_type(rc, t.data.fun_.ret_type);
    }
    if (t.kind == ast_type.TYPE_KIND_REC || t.kind == ast_type.TYPE_KIND_UNI) {
        var fields_start: u32 = 0;
        var fields_len:   u32 = 0;
        if (t.kind == ast_type.TYPE_KIND_REC) {
            fields_start = t.data.rec_.fields_start;
            fields_len   = t.data.rec_.fields_len;
        }
        or {
            fields_start = t.data.uni_.fields_start;
            fields_len   = t.data.uni_.fields_len;
        }
        var fi: u32 = 0;
        for (fi < fields_len) {
            val tn:            *ast_decl.TypedName = ?rc.a.typed_names.data[fields_start + fi];
            val err_bind_type: err[fail.Fail]      = bind_type(rc, tn.ty);
            if (sel err_bind_type.err) { ret err_bind_type; }
            fi = fi + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (t.kind == ast_type.TYPE_KIND_PACK || t.kind == ast_type.TYPE_KIND_ERROR) { ret err[fail.Fail].ok{}; }
    ret unknown_kind(rc, "AstTypeKind", t.kind::u32);
}

fun resolve_type_path(rc: *ResolveContext, named: *ast_type.TypeNamed, full: lang_source.Span) SymbolId {
    val path: lang_source.Span = named.name;
    if (path.len == 0) { ret SYMBOL_NIL; }

    var cursor: usize = path.offset;
    val end:    usize = path.offset + path.len;

    var current_module: module.StableModuleId = module.STABLE_MODULE_NIL;
    var current_sym:    SymbolId              = SYMBOL_NIL;
    var first:          bool                  = true;
    var segment:        u32                   = named.segments;

    for (cursor < end) {
        val seg_span: lang_source.Span = fe_path.next(rc.source, path, ?cursor);
        if (seg_span.len == 0) { brk; }
        val seg_name: intern.StrId = rc.a.path_names.data[segment];
        segment = segment + 1;

        if (first) {
            val is_single: bool = cursor >= end;
            if (is_single) {
                val res_type_spelling: res[TypeSpelling, fail.Fail] = type_spelling(rc, seg_name);
                if (sel res_type_spelling.err) {
                    lang_phase.internal(?rc.status, res_type_spelling.err);
                    ret SYMBOL_NIL;
                }
                val sp: TypeSpelling = res_type_spelling.ok;
                if (sp.status == TYPE_SPELL_VEC_REFUSED) {
                    report_vector_refused(rc, full, seg_name, sp.form);
                    ret SYMBOL_NIL;
                }
                current_sym = sp.sym;
            }
            if (symbol_is_nil(current_sym)) {
                current_sym = scope_lookup_chain(rc, rc.current_scope, seg_name);
            }
            first = false;
        }
        or {
            current_sym = lookup_in_module(rc, current_module, seg_name);
        }

        if (symbol_is_nil(current_sym)) {
            if (report_unresolved(rc, full, "unresolved type name `", seg_name, seg_span.offset == path.offset && cursor >= end)) {
                ret SYMBOL_DEFERRED_TYPE;
            }
            ret SYMBOL_NIL;
        }

        if (cursor >= end) { brk; }

        val sym: *Symbol = ?rc.symbols[symbol_index(current_sym)];
        if (sym.kind == SYM_USE) {
            current_module = use_stable(sym);
        }
        or {
            record_report(rc, diagnostic_kind.MODULE_ALIAS_EXPECTED, full, "expected a module alias before `.`");
            ret SYMBOL_NIL;
        }
    }

    ret current_sym;
}

fun lookup_in_module(rc: *ResolveContext, m: module.StableModuleId, name: intern.StrId) SymbolId {
    val mx: *ModuleExports = find_module_exports_by_module(rc, m);
    if (mx == nil) { ret SYMBOL_NIL; }
    val ps: *PublicSymbol = find_export(mx, name);
    if (ps == nil) { ret SYMBOL_NIL; }
    val res_sid: res[SymbolId, fail.Fail] = imported_symbol_for(rc, ps);
    if (sel res_sid.err) {
        lang_phase.internal(?rc.status, res_sid.err);
        ret SYMBOL_NIL;
    }
    ret res_sid.ok;
}

fun remap_symbol_refs(refs: *SymbolId, len: u32, remap: *u32, sym_len: u32) {
    if (refs == nil) { ret; }
    var i: u32 = 0;
    for (i < len) {
        val sid: SymbolId = refs[i];
        if (!symbol_is_nil(sid) && sid::u32 < sym_len) {
            refs[i] = remap[sid::u32]::SymbolId;
        }
        i = i + 1;
    }
}

fun build_result(rc: *ResolveContext) res[ResolveResult, fail.Fail] {
    if (sel rc.status.kind.internal) {
        ret res[ResolveResult, fail.Fail].err{rc.status.kind.internal};
    }
    var pub_count: u32 = 0;
    var i:         u32 = 0;
    for (i < rc.sym_len) {
        if ((rc.symbols[i].flags & SYM_FLAG_PUB) != 0) {
            pub_count = pub_count + 1;
        }
        i = i + 1;
    }

    val res_syms: res[*Symbol, A.Error] = A.allocate[Symbol](rc.s.alloc, rc.sym_len::usize);
    if (sel res_syms.err) {
        lang_phase.internal(?rc.status, fail.refused(res_syms.err));
        ret res[ResolveResult, fail.Fail].err{fail.refused(res_syms.err)};
    }
    val out_syms: *Symbol = res_syms.ok;
    var handed:   bool    = false;
    fin {
        if (!handed) { A.deallocate[Symbol](rc.s.alloc, out_syms, rc.sym_len::usize); }
    }

    var remap: *u32 = nil;
    if (rc.sym_len > 0) {
        val res_remap: res[*u32, A.Error] = A.allocate[u32](rc.s.alloc, rc.sym_len::usize);
        if (sel res_remap.err) {
            lang_phase.internal(?rc.status, fail.refused(res_remap.err));
            ret res[ResolveResult, fail.Fail].err{fail.refused(res_remap.err)};
        }
        remap = res_remap.ok;
    }

    var pi: u32 = 0;
    var ni: u32 = pub_count;
    var k:  u32 = 0;
    for (k < rc.sym_len) {
        if ((rc.symbols[k].flags & SYM_FLAG_PUB) != 0) {
            out_syms[pi] = rc.symbols[k];
            remap[k]     = pi;
            pi           = pi + 1;
        }
        or {
            out_syms[ni] = rc.symbols[k];
            remap[k]     = ni;
            ni           = ni + 1;
        }
        k = k + 1;
    }

    remap_symbol_refs(rc.expr_resolved, rc.a.exprs.len::u32, remap, rc.sym_len);
    remap_symbol_refs(rc.type_resolved, rc.a.types.len::u32, remap, rc.sym_len);
    remap_symbol_refs(rc.decl_symbol, rc.a.decls.len::u32, remap, rc.sym_len);
    var bi: usize = 0;
    for (bi < rc.asm_binds.len) {
        remap_symbol_refs(?rc.asm_binds.data[bi].symbol, 1, remap, rc.sym_len);
        bi = bi + 1;
    }

    if (remap != nil) { A.deallocate[u32](rc.s.alloc, remap, rc.sym_len::usize); }

    var param_index: map.Map[u64, SymbolId] = map.init[u64, SymbolId](rc.s.alloc);
    fin {
        if (!handed) { map.dnit[u64, SymbolId](?param_index); }
    }
    var pk: u32 = 0;
    for (pk < rc.sym_len) {
        if (out_syms[pk].kind == SYM_PARAM) {
            val key:     u64                = (ast_id.decl_index(out_syms[pk].decl)::u64 << 32) | out_syms[pk].slot::u64;
            val res_ins: res[bool, A.Error] = map.insert[u64, SymbolId](?param_index, key, symbol_id(pk));
            if (sel res_ins.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(res_ins.err)}; }
        }
        pk = pk + 1;
    }
    var nominals: map.Map[u64, SymbolId] = map.init[u64, SymbolId](rc.s.alloc);
    fin {
        if (!handed) { map.dnit[u64, SymbolId](?nominals); }
    }
    val err_indexed: err[A.Error] = nominals_index(out_syms, rc.sym_len, rc.own_stable, ?nominals);
    if (sel err_indexed.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(err_indexed.err)}; }
    var declared: map.Map[u64, SymbolId] = map.init[u64, SymbolId](rc.s.alloc);
    fin {
        if (!handed) { map.dnit[u64, SymbolId](?declared); }
    }
    val err_filed: err[A.Error] = declared_index(out_syms, rc.sym_len, rc.own_stable, ?declared);
    if (sel err_filed.err) { ret res[ResolveResult, fail.Fail].err{fail.refused(err_filed.err)}; }

    var constant_count: u32                             = 0;
    val res_constants:  res[*ExportConstant, fail.Fail] = public_constants_copy(rc, out_syms, pub_count, ?constant_count);
    if (sel res_constants.err) {
        lang_phase.internal(?rc.status, res_constants.err);
        ret res[ResolveResult, fail.Fail].err{res_constants.err};
    }

    var out: ResolveResult;
    out.status                = rc.status;
    out.alloc                 = rc.s.alloc;
    out.symbols               = out_syms;
    out.symbol_count          = rc.sym_len;
    out.pub_count             = pub_count;
    out.expr_resolved         = rc.expr_resolved;
    out.type_resolved         = rc.type_resolved;
    out.decl_symbol           = rc.decl_symbol;
    out.expr_count            = rc.a.exprs.len::u32;
    out.type_count            = rc.a.types.len::u32;
    out.decl_count            = rc.a.decls.len::u32;
    out.param_index           = param_index;
    out.nominals              = nominals;
    out.declared              = declared;
    out.public_constants      = res_constants.ok;
    out.public_constant_count = constant_count;

    out.expr_choices       = rc.expr_choices;
    out.expr_choices_count = rc.expr_choices_count;
    out.type_heads         = rc.type_heads;
    out.asm_binds          = rc.asm_binds;
    rc.asm_binds           = collections_vector.init[AsmBind](rc.s.alloc);
    out.constants          = comptime_scope.publish(rc.ctx);

    rc.expr_resolved      = nil;
    rc.type_resolved      = nil;
    rc.decl_symbol        = nil;
    rc.expr_choices       = nil;
    rc.expr_choices_count = 0;
    rc.type_heads         = nil;

    handed = true;
    ret res[ResolveResult, fail.Fail].ok{out};
}

fun public_constants_copy(rc: *ResolveContext, symbols: *Symbol, count: u32,
    copied_count: *u32) res[*ExportConstant, fail.Fail] {
    @copied_count = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        if (symbols[i].kind == SYM_VAL && (symbols[i].flags & SYM_FLAG_MODULE) != 0) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret res[*ExportConstant, fail.Fail].ok{nil}; }
    val res_allocated: res[*ExportConstant, A.Error] = A.allocate[ExportConstant](rc.s.alloc, n::usize);
    if (sel res_allocated.err) { ret res[*ExportConstant, fail.Fail].err{fail.refused(res_allocated.err)}; }
    val constants: *ExportConstant = res_allocated.ok;
    var written:   u32             = 0;
    i = 0;
    for (i < count) {
        val symbol: *Symbol = ?symbols[i];
        if (symbol.kind == SYM_VAL && (symbol.flags & SYM_FLAG_MODULE) != 0) {
            var item: ExportConstant = ExportConstant{};
            item.name = symbol.name;
            val opt_named: opt[comptime_scope.NamedConst] = comptime_scope.lookup(rc.ctx, symbol.name);
            # a constant element points into this module's syntax tree and cannot cross a module boundary
            if (sel opt_named.some) {
                if (opt_named.some.value.kind != comptime_value.CT_KIND_CONST_ELEM) {
                    val constant: comptime_scope.NamedConst = opt_named.some;
                    item.present = true;
                    item.value   = constant.value;
                }
            }
            constants[written] = item;
            written            = written + 1;
        }
        i = i + 1;
    }
    @copied_count = n;
    if (sel res_allocated.err) { ret res[*ExportConstant, fail.Fail].err{fail.refused(res_allocated.err)}; }
    ret res[*ExportConstant, fail.Fail].ok{res_allocated.ok};
}

# the binders recurse as deep as the parse nested, on frames larger than the
# parser's, so each asks for stack before it descends and refuses the node it stands on
fun refuse_nesting(rc: *ResolveContext, span: lang_source.Span) err[fail.Fail] {
    ret report(rc, diagnostic_kind.SYNTAX_NESTING_DEPTH, span,
        "input nests deeper than name resolution descends; the stack has no room left to go deeper");
}

# a failure a walker without a diagnostic store returned, reported against `span`: a refusal of
# the input under its own kind; any other failure is the pass's own
fun refuse(rc: *ResolveContext, span: lang_source.Span, f: fail.Fail) err[fail.Fail] {
    val k: diagnostic_kind.Kind = fail.kind_of(f);
    if (k == diagnostic_kind.NONE)              { ret err[fail.Fail].err{f}; }
    if (k == diagnostic_kind.COMPILER_INTERNAL) { ret err[fail.Fail].err{fail.at(f, lang_source.location(rc.a.file_id, span))}; }
    ret report(rc, k, span, fail.describe(f));
}

fun report(rc: *ResolveContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str) err[fail.Fail] {
    lang_phase.reject(?rc.status);
    val err_report: err[fail.Fail] = diagnostic.report(rc.diags, k, rc.a.file_id, span, message);
    if (sel err_report.err) {
        internal_at(rc, span, err_report.err);
        ret err[fail.Fail].err{err_report.err};
    }
    ret err[fail.Fail].ok{};
}

# a diagnostic whose message is `fmt` formatted with `args`
fun reportf(rc: *ResolveContext, k: diagnostic_kind.Kind, span: lang_source.Span, fmt: str, args: ...) err[fail.Fail] {
    lang_phase.reject(?rc.status);
    val err_reportf: err[fail.Fail] = diagnostic.reportf(rc.diags, k, rc.a.file_id, span, fmt, args...);
    if (sel err_reportf.err) {
        internal_at(rc, span, err_reportf.err);
        ret err[fail.Fail].err{err_reportf.err};
    }
    ret err[fail.Fail].ok{};
}

# the internal failure naming a member its catalog lacks; the text belongs to
# the session interner, not a resolver candidate
pub fun unknown_catalog(s: *session.Session, catalog: str, tag: u32) fail.Fail {
    ret fail.message_of(lang_catalog.catalog_interned(?s.interner, s.alloc, lang_catalog.unknown_member(catalog, tag)));
}

fun unknown_kind(rc: *ResolveContext, catalog: str, tag: u32) err[fail.Fail] {
    val failure: fail.Fail = unknown_catalog(rc.s, catalog, tag);
    lang_phase.internal(?rc.status, failure);
    ret err[fail.Fail].err{failure};
}

# fail the pass internally with `f`, a defect met at `span` of the module's syntax; a failure
# that names a place of its own keeps it
fun internal_at(rc: *ResolveContext, span: lang_source.Span, f: fail.Fail) {
    lang_phase.internal(?rc.status, fail.at(f, lang_source.location(rc.a.file_id, span)));
}

fun record_report(rc: *ResolveContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str) {
    val err_report: err[fail.Fail] = report(rc, k, span, message);
    if (sel err_report.err) { internal_at(rc, span, err_report.err); }
}
