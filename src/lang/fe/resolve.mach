use std.collections.map;
use std.format;
use std.memory;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.module;
use mach.lang.fe.ast.stmt;
use atype: mach.lang.fe.ast.type;
use mach.lang.fe.comptime;
use mach.lang.fe.pool;
use mach.lang.fe.token;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.session;
use src: mach.lang.source;
use mach.lang.type;

pub def SymbolId: u32;

pub val SYMBOL_NIL: SymbolId = 0xFFFFFFFF;

pub def SymKind: u8;

pub val SYM_FUN:      SymKind = 0;
pub val SYM_REC:      SymKind = 1;
pub val SYM_DEF:      SymKind = 2;
pub val SYM_VAL:      SymKind = 3;
pub val SYM_VAR:      SymKind = 4;
pub val SYM_PARAM:    SymKind = 5;
pub val SYM_GENERIC:  SymKind = 6;
pub val SYM_USE:      SymKind = 7;
pub val SYM_IMPORTED: SymKind = 8;
pub val SYM_TEST:     SymKind = 9;
pub val SYM_UNI:      SymKind = 10;
pub val SYM_PRIM:     SymKind = 11;
pub val SYM_VECTOR:   SymKind = 12;
pub val SYM_FLAG_PUB: u8 = 1;

pub val SYM_FLAG_COMPTIME: u8 = 2;

pub val SYM_FLAG_MODULE: u8 = 4;

pub rec Symbol {
    kind:   SymKind;
    flags:  u8;
    name:   intern.StrId;
    canon:  intern.StrId;
    decl:   id.DeclId;
    slot:   u32;
    origin: session.ModuleId;
    origin_stable: session.StableModuleId;
    slot_stable:   session.StableModuleId;
}

pub rec PublicSymbol {
    kind:   SymKind;
    name:   intern.StrId;
    canon:  intern.StrId;
    decl:   id.DeclId;
    slot:   u32;
    origin: session.ModuleId;
}

pub rec ModuleExports {
    path:    intern.StrId;
    module:  session.ModuleId;
    symbols: *PublicSymbol;
    count:   u32;
}

pub rec ResolveDeps {
    entries: *ModuleExports;
    count:   u32;
}

def ScopeId: u32;
val SCOPE_NIL: ScopeId = 0xFFFFFFFF;

rec ScopeEntry {
    name: intern.StrId;
    sym:  SymbolId;
}

rec Scope {
    parent:  ScopeId;
    entries: *ScopeEntry;
    len:     u32;
    cap:     u32;
}

val INITIAL_SCOPE_ENTRY_CAP: u32 = 8;
val INITIAL_SCOPES_CAP:      u32 = 8;
val INITIAL_SYMBOLS_CAP:     u32 = 32;
val INITIAL_BRACKET_SNAPSHOT_CAP: usize = 4;

pub rec BracketSnapshot {
    eid:  id.ExprId;
    node: expr.Expr;
}

rec ResolveContext {
    status: fail.PhaseStatus;
    s:          *session.Session;
    a:          *ast.Ast;
    deps:       *ResolveDeps;
    ctx:        *comptime.ComptimeCtx;
    caps:       comptime.PhaseCapabilities[ResolveContext];
    own_module: session.ModuleId;
    source:     str;
    terminal:   bool;
    in_gated_decl_scope: bool;

    symbols:    *Symbol;
    sym_len:    u32;
    sym_cap:    u32;

    expr_resolved: *SymbolId;
    type_resolved: *SymbolId;
    decl_symbol:   *SymbolId;

    scopes:        *Scope;
    scope_len:     u32;
    scope_cap:     u32;

    module_scope:  ScopeId;
    current_scope: ScopeId;

    prim_names: [11]intern.StrId;
    prim_syms:  [11]SymbolId;

    vec_cache: map.Map[intern.StrId, SymbolId];

    imported_cache: map.Map[u64, SymbolId];

    module_index: map.Map[intern.StrId, SymbolId];

    bracket_before:     *BracketSnapshot;
    bracket_before_len: usize;
    bracket_before_cap: usize;
}

val PRIM_COUNT: u32 = 11;

pub rec ResolveResult {
    status: fail.PhaseStatus;
    alloc:         *A.Allocator;
    symbols:       *Symbol;
    symbol_count:  u32;
    pub_count:     u32;
    expr_resolved: *SymbolId;
    type_resolved: *SymbolId;
    decl_symbol:   *SymbolId;
    expr_count:    u32;
    type_count:    u32;
    decl_count:    u32;

    param_index:   map.Map[u64, SymbolId];

    pub_const_fp:     *u8;
    pub_const_fp_len: u32;

    bracket_before:     *BracketSnapshot;
    bracket_before_len: usize;
    bracket_before_cap: usize;
}

pub fun param_symbol(r: *ResolveResult, decl: id.DeclId, slot: u32) SymbolId {
    var key: u64 = (decl::u64 << 32) | slot::u64;
    val g: R.Result[*SymbolId, str] = map.get[u64, SymbolId](?r.param_index, ?key);
    if (R.is_ok[*SymbolId, str](g)) { ret @R.unwrap_ok[*SymbolId, str](g); }
    ret SYMBOL_NIL;
}

fun stable_of_module(s: *session.Session, mid: session.ModuleId) session.StableModuleId {
    if (mid == session.MODULE_NIL) { ret session.STABLE_MODULE_NIL; }
    val fqn: intern.StrId = session.module_fqn(s, mid);
    if (fqn == intern.STR_NIL) { ret session.STABLE_MODULE_NIL; }
    ret session.stable_module_id_lookup(s, fqn);
}

pub fun remap_result(r: *ResolveResult, s: *session.Session) {
    if (r == nil || r.symbols == nil) { ret; }
    var i: u32 = 0;
    for (i < r.symbol_count) {
        val sym: *Symbol = ?r.symbols[i];
        sym.origin = session.module_id_for_stable(s, sym.origin_stable);
        if (sym.kind == SYM_USE) {
            sym.slot = session.module_id_for_stable(s, sym.slot_stable)::u32;
        }
        i = i + 1;
    }
}

pub fun dnit_result(r: *ResolveResult) {
    if (r == nil) { ret; }
    if (r.symbols != nil && r.symbol_count > 0) {
        A.deallocate[Symbol](r.alloc, r.symbols, r.symbol_count::usize);
    }
    if (r.expr_resolved != nil) {
        A.deallocate[SymbolId](r.alloc, r.expr_resolved, r.expr_count::usize);
    }
    if (r.type_resolved != nil) {
        A.deallocate[SymbolId](r.alloc, r.type_resolved, r.type_count::usize);
    }
    if (r.decl_symbol != nil) {
        A.deallocate[SymbolId](r.alloc, r.decl_symbol, r.decl_count::usize);
    }
    if (r.pub_const_fp != nil && r.pub_const_fp_len > 0) {
        A.deallocate[u8](r.alloc, r.pub_const_fp, r.pub_const_fp_len::usize);
    }
    if (r.bracket_before != nil && r.bracket_before_cap > 0) {
        A.deallocate[BracketSnapshot](r.alloc, r.bracket_before, r.bracket_before_cap);
    }
    map.dnit[u64, SymbolId](?r.param_index);
    r.symbols       = nil;
    r.symbol_count  = 0;
    r.pub_count     = 0;
    r.expr_resolved = nil;
    r.type_resolved = nil;
    r.decl_symbol   = nil;
    r.expr_count    = 0;
    r.type_count    = 0;
    r.decl_count    = 0;
    r.pub_const_fp     = nil;
    r.pub_const_fp_len = 0;
    r.bracket_before     = nil;
    r.bracket_before_len = 0;
    r.bracket_before_cap = 0;
}

pub fun resolve(
    s:          *session.Session,
    a:          *ast.Ast,
    deps:       *ResolveDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    terminal:   bool
) R.Result[ResolveResult, fail.Fail] {
    var rc: ResolveContext;
    val init_r: R.Result[R.Void, str] = init_context(?rc, s, a, deps, ctx, own_module, terminal);
    if (R.is_err[R.Void, str](init_r)) {
        ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](init_r)));
    }

    val ms_r: R.Result[ScopeId, str] = open_scope(?rc, SCOPE_NIL);
    if (R.is_err[ScopeId, str](ms_r)) {
        dnit_context(?rc);
        ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[ScopeId, str](ms_r)));
    }
    rc.module_scope  = R.unwrap_ok[ScopeId, str](ms_r);
    rc.current_scope = rc.module_scope;

    val sp_r: R.Result[R.Void, str] = seed_primitives(?rc);
    if (R.is_err[R.Void, str](sp_r)) {
        dnit_context(?rc);
        ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](sp_r)));
    }

    val m_opt: O.Option[*module.Module] = ast.get_module(a, a.root_module);
    if (O.is_none[*module.Module](m_opt)) {
        dnit_context(?rc);
        ret R.err[ResolveResult, fail.Fail](fail.message("root_module is not set on this Ast"));
    }
    val mnode: *module.Module = O.unwrap[*module.Module](m_opt);

    val c1: R.Result[R.Void, str] = collect_decl_list(?rc, mnode.decls_start, mnode.decls_len, rc.module_scope, true);
    if (R.is_err[R.Void, str](c1)) {
        dnit_context(?rc);
        ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](c1)));
    }

    val b1: R.Result[R.Void, str] = bind_decl_list(?rc, mnode.decls_start, mnode.decls_len);
    if (R.is_err[R.Void, str](b1)) {
        dnit_context(?rc);
        ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](b1)));
    }

    ret build_result(?rc);
}

fun init_context(
    rc:         *ResolveContext,
    s:          *session.Session,
    a:          *ast.Ast,
    deps:       *ResolveDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    terminal:   bool
) R.Result[R.Void, str] {
    rc.status     = fail.accepted();
    rc.s          = s;
    rc.a          = a;
    rc.deps       = deps;
    rc.ctx        = ctx;
    val caps_r: R.Result[comptime.PhaseCapabilities[ResolveContext], str] =
        comptime.resolution_capabilities[ResolveContext](comptime_ident_is_runtime);
    if (R.is_err[comptime.PhaseCapabilities[ResolveContext], str](caps_r)) {
        ret R.err[R.Void, str](R.unwrap_err[comptime.PhaseCapabilities[ResolveContext], str](caps_r));
    }
    rc.caps       = R.unwrap_ok[comptime.PhaseCapabilities[ResolveContext], str](caps_r);
    rc.own_module = own_module;
    rc.terminal   = terminal;
    rc.in_gated_decl_scope = false;

    val src_opt: O.Option[*src.SourceFile] = src.get(?s.sources, a.file_id);
    if (O.is_none[*src.SourceFile](src_opt)) {
        ret R.err[R.Void, str]("Ast.file_id not registered with the session");
    }
    rc.source = O.unwrap[*src.SourceFile](src_opt).text;

    rc.symbols  = nil;
    rc.sym_len  = 0;
    rc.sym_cap  = 0;

    rc.expr_resolved = nil;
    rc.type_resolved = nil;
    rc.decl_symbol   = nil;

    rc.scopes        = nil;
    rc.scope_len     = 0;
    rc.scope_cap     = 0;
    rc.module_scope  = SCOPE_NIL;
    rc.current_scope = SCOPE_NIL;

    var pi: u32 = 0;
    for (pi < PRIM_COUNT) {
        rc.prim_names[pi] = intern.STR_NIL;
        rc.prim_syms[pi]  = SYMBOL_NIL;
        pi = pi + 1;
    }

    rc.imported_cache = map.init[u64, SymbolId](s.alloc, map.hash_u64, map.eq_u64);
    rc.vec_cache      = map.init[intern.StrId, SymbolId](s.alloc, map.hash_u32, map.eq_u32);
    rc.module_index   = map.init[intern.StrId, SymbolId](s.alloc, map.hash_u32, map.eq_u32);

    rc.bracket_before     = nil;
    rc.bracket_before_len = 0;
    rc.bracket_before_cap = 0;

    val sa: R.Result[*Symbol, str] = A.allocate[Symbol](s.alloc, INITIAL_SYMBOLS_CAP::usize);
    if (R.is_err[*Symbol, str](sa)) { fail.internal(?rc.status, R.unwrap_err[*Symbol, str](sa));
        dnit_context(rc);
        ret R.err[R.Void, str](R.unwrap_err[*Symbol, str](sa));
    }
    rc.symbols = R.unwrap_ok[*Symbol, str](sa);
    rc.sym_cap = INITIAL_SYMBOLS_CAP;

    val sca: R.Result[*Scope, str] = A.allocate[Scope](s.alloc, INITIAL_SCOPES_CAP::usize);
    if (R.is_err[*Scope, str](sca)) { fail.internal(?rc.status, R.unwrap_err[*Scope, str](sca));
        dnit_context(rc);
        ret R.err[R.Void, str](R.unwrap_err[*Scope, str](sca));
    }
    rc.scopes    = R.unwrap_ok[*Scope, str](sca);
    rc.scope_cap = INITIAL_SCOPES_CAP;

    if (a.expr_len > 0) {
        val r: R.Result[*SymbolId, str] = A.allocate[SymbolId](s.alloc, a.expr_len);
        if (R.is_err[*SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[*SymbolId, str](r)); dnit_context(rc); ret R.err[R.Void, str](R.unwrap_err[*SymbolId, str](r)); }
        rc.expr_resolved = R.unwrap_ok[*SymbolId, str](r);
        memory.fill[SymbolId](rc.expr_resolved, SYMBOL_NIL, a.expr_len);
    }
    if (a.type_len > 0) {
        val r: R.Result[*SymbolId, str] = A.allocate[SymbolId](s.alloc, a.type_len);
        if (R.is_err[*SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[*SymbolId, str](r)); dnit_context(rc); ret R.err[R.Void, str](R.unwrap_err[*SymbolId, str](r)); }
        rc.type_resolved = R.unwrap_ok[*SymbolId, str](r);
        memory.fill[SymbolId](rc.type_resolved, SYMBOL_NIL, a.type_len);
    }
    if (a.decl_len > 0) {
        val r: R.Result[*SymbolId, str] = A.allocate[SymbolId](s.alloc, a.decl_len);
        if (R.is_err[*SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[*SymbolId, str](r)); dnit_context(rc); ret R.err[R.Void, str](R.unwrap_err[*SymbolId, str](r)); }
        rc.decl_symbol = R.unwrap_ok[*SymbolId, str](r);
        memory.fill[SymbolId](rc.decl_symbol, SYMBOL_NIL, a.decl_len);
    }

    ret R.ok_void[str]();
}

fun dnit_context(rc: *ResolveContext) {
    var i: u32 = 0;
    for (i < rc.scope_len) {
        val sc: *Scope = ?rc.scopes[i];
        if (sc.entries != nil && sc.cap > 0) {
            A.deallocate[ScopeEntry](rc.s.alloc, sc.entries, sc.cap::usize);
        }
        i = i + 1;
    }
    if (rc.scopes != nil && rc.scope_cap > 0) {
        A.deallocate[Scope](rc.s.alloc, rc.scopes, rc.scope_cap::usize);
    }
    if (rc.symbols != nil && rc.sym_cap > 0) {
        A.deallocate[Symbol](rc.s.alloc, rc.symbols, rc.sym_cap::usize);
    }
    if (rc.expr_resolved != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.expr_resolved, rc.a.expr_len);
    }
    if (rc.type_resolved != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.type_resolved, rc.a.type_len);
    }
    if (rc.decl_symbol != nil) {
        A.deallocate[SymbolId](rc.s.alloc, rc.decl_symbol, rc.a.decl_len);
    }
    if (rc.bracket_before != nil && rc.bracket_before_cap > 0) {
        A.deallocate[BracketSnapshot](rc.s.alloc, rc.bracket_before, rc.bracket_before_cap);
    }
    map.dnit[u64, SymbolId](?rc.imported_cache);
    map.dnit[intern.StrId, SymbolId](?rc.vec_cache);
    map.dnit[intern.StrId, SymbolId](?rc.module_index);
}

fun open_scope(rc: *ResolveContext, parent: ScopeId) R.Result[ScopeId, str] {
    if (rc.scope_len == rc.scope_cap) {
        val new_cap: u32 = rc.scope_cap * 2;
        val r: R.Result[*Scope, str] = A.reallocate[Scope](rc.s.alloc, rc.scopes, rc.scope_cap::usize, new_cap::usize);
        if (R.is_err[*Scope, str](r)) { fail.internal(?rc.status, R.unwrap_err[*Scope, str](r));
            ret R.err[ScopeId, str](R.unwrap_err[*Scope, str](r));
        }
        rc.scopes    = R.unwrap_ok[*Scope, str](r);
        rc.scope_cap = new_cap;
    }
    var sc: Scope;
    sc.parent  = parent;
    sc.entries = nil;
    sc.len     = 0;
    sc.cap     = 0;
    val sid: ScopeId = rc.scope_len;
    rc.scopes[rc.scope_len] = sc;
    rc.scope_len = rc.scope_len + 1;
    ret R.ok[ScopeId, str](sid);
}

fun scope_add(rc: *ResolveContext, scope: ScopeId, name: intern.StrId, sym: SymbolId) R.Result[R.Void, str] {
    val sc: *Scope = ?rc.scopes[scope];
    if (sc.entries == nil) {
        val r: R.Result[*ScopeEntry, str] = A.allocate[ScopeEntry](rc.s.alloc, INITIAL_SCOPE_ENTRY_CAP::usize);
        if (R.is_err[*ScopeEntry, str](r)) { fail.internal(?rc.status, R.unwrap_err[*ScopeEntry, str](r)); ret R.err[R.Void, str](R.unwrap_err[*ScopeEntry, str](r)); }
        sc.entries = R.unwrap_ok[*ScopeEntry, str](r);
        sc.cap     = INITIAL_SCOPE_ENTRY_CAP;
    }
    or (sc.len == sc.cap) {
        val new_cap: u32 = sc.cap * 2;
        val r: R.Result[*ScopeEntry, str] = A.reallocate[ScopeEntry](rc.s.alloc, sc.entries, sc.cap::usize, new_cap::usize);
        if (R.is_err[*ScopeEntry, str](r)) { fail.internal(?rc.status, R.unwrap_err[*ScopeEntry, str](r)); ret R.err[R.Void, str](R.unwrap_err[*ScopeEntry, str](r)); }
        sc.entries = R.unwrap_ok[*ScopeEntry, str](r);
        sc.cap     = new_cap;
    }
    var e: ScopeEntry;
    e.name = name;
    e.sym  = sym;
    sc.entries[sc.len] = e;
    sc.len = sc.len + 1;

    if (scope == rc.module_scope) {
        val ins: R.Result[bool, str] = map.insert[intern.StrId, SymbolId](?rc.module_index, name, sym);
        if (R.is_err[bool, str](ins)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](ins)); }
    }
    ret R.ok_void[str]();
}

fun scope_lookup_local(rc: *ResolveContext, scope: ScopeId, name: intern.StrId) SymbolId {
    if (scope == SCOPE_NIL) { ret SYMBOL_NIL; }
    if (scope == rc.module_scope) {
        val g: R.Result[*SymbolId, str] = map.get[intern.StrId, SymbolId](?rc.module_index, ?name);
        if (R.is_ok[*SymbolId, str](g)) { ret @R.unwrap_ok[*SymbolId, str](g); }
        ret SYMBOL_NIL;
    }
    val sc: *Scope = ?rc.scopes[scope];
    var i: u32 = 0;
    for (i < sc.len) {
        if (sc.entries[i].name == name) { ret sc.entries[i].sym; }
        i = i + 1;
    }
    ret SYMBOL_NIL;
}

fun scope_lookup_chain(rc: *ResolveContext, scope: ScopeId, name: intern.StrId) SymbolId {
    var cur: ScopeId = scope;
    for (cur != SCOPE_NIL) {
        val found: SymbolId = scope_lookup_local(rc, cur, name);
        if (found != SYMBOL_NIL) { ret found; }
        cur = rc.scopes[cur].parent;
    }
    ret SYMBOL_NIL;
}

fun add_symbol(rc: *ResolveContext, kind: SymKind, flags: u8, name: intern.StrId, canon: intern.StrId, decl_id: id.DeclId, slot: u32, origin: session.ModuleId) R.Result[SymbolId, str] {
    if (rc.sym_len == rc.sym_cap) {
        val new_cap: u32 = rc.sym_cap * 2;
        val r: R.Result[*Symbol, str] = A.reallocate[Symbol](rc.s.alloc, rc.symbols, rc.sym_cap::usize, new_cap::usize);
        if (R.is_err[*Symbol, str](r)) { fail.internal(?rc.status, R.unwrap_err[*Symbol, str](r));
            ret R.err[SymbolId, str](R.unwrap_err[*Symbol, str](r));
        }
        rc.symbols = R.unwrap_ok[*Symbol, str](r);
        rc.sym_cap = new_cap;
    }
    var sym: Symbol;
    sym.kind   = kind;
    sym.flags  = flags;
    sym.name   = name;
    sym.canon  = canon;
    sym.decl   = decl_id;
    sym.slot   = slot;
    sym.origin = origin;
    sym.origin_stable = session.STABLE_MODULE_NIL;
    sym.slot_stable   = session.STABLE_MODULE_NIL;
    val sid: SymbolId = rc.sym_len;
    rc.symbols[rc.sym_len] = sym;
    rc.sym_len = rc.sym_len + 1;
    ret R.ok[SymbolId, str](sid);
}

fun declare(
    rc:      *ResolveContext,
    kind:    SymKind,
    flags:   u8,
    name:    token.Span,
    decl_id: id.DeclId,
    slot:    u32,
    origin:  session.ModuleId,
    scope:   ScopeId
) R.Result[SymbolId, str] {
    if (name.len == 0) {
        ret R.ok[SymbolId, str](SYMBOL_NIL);
    }
    val r_id: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, name);
    if (R.is_err[intern.StrId, str](r_id)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_id));
        ret R.err[SymbolId, str](R.unwrap_err[intern.StrId, str](r_id));
    }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_id);

    val existing: SymbolId = scope_lookup_local(rc, scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: R.Result[R.Void, str] = report_named(rc, name, "duplicate definition: `", name_id, "` is already bound in this scope");
        if (R.is_ok[R.Void, str](de)) {
            report_prior_binding(rc, existing);
        }
        ret R.ok[SymbolId, str](SYMBOL_NIL);
    }

    val r_sym: R.Result[SymbolId, str] = add_symbol(rc, kind, flags, name_id, name_id, decl_id, slot, origin);
    if (R.is_err[SymbolId, str](r_sym)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r_sym)); ret r_sym; }
    val sid: SymbolId = R.unwrap_ok[SymbolId, str](r_sym);

    val r_add: R.Result[R.Void, str] = scope_add(rc, scope, name_id, sid);
    if (R.is_err[R.Void, str](r_add)) {
        ret R.err[SymbolId, str](R.unwrap_err[R.Void, str](r_add));
    }

    ret R.ok[SymbolId, str](sid);
}

fun report_prior_binding(rc: *ResolveContext, prior: SymbolId) {
    val id_r: R.Result[diagnostic.DiagnosticId, str] = diagnostic.last_id(?rc.s.diags);
    if (R.is_err[diagnostic.DiagnosticId, str](id_r)) { ret; }
    val did: diagnostic.DiagnosticId = R.unwrap_ok[diagnostic.DiagnosticId, str](id_r);

    if (rc.symbols[prior].origin == rc.own_module && rc.symbols[prior].decl != id.DECL_NIL) {
        val prev: token.Span = prior_name_span(rc, rc.symbols[prior].decl);
        if (prev.len != 0) {
            diagnostic.record_related_committed(?rc.s.diags, did, rc.a.file_id, prev, "previous definition here");
            ret;
        }
    }
    diagnostic.record_note_committed(?rc.s.diags, did, "a name with this spelling is already bound here");
}

fun prior_name_span(rc: *ResolveContext, decl_id: id.DeclId) token.Span {
    val span: token.Span = ast.decl_name_span(rc.a, decl_id);
    if (span.len != 0) { ret span; }

    val opt_d: O.Option[*decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (O.is_none[*decl.Decl](opt_d)) { ret span; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_d);

    if (d.kind == decl.DECL_KIND_USE) { ret leaf_span(rc, d.data.use_.path); }
    if (d.kind == decl.DECL_KIND_FWD) { ret leaf_span(rc, d.data.fwd_.path); }
    ret span;
}

fun seed_primitives(rc: *ResolveContext) R.Result[R.Void, str] {
    var k: u32 = 0;
    for (k < PRIM_COUNT) {
        val r: R.Result[R.Void, str] = seed_one_primitive(rc, k, type.prim_name(k::u8), k);
        if (R.is_err[R.Void, str](r)) { ret r; }
        k = k + 1;
    }
    ret R.ok_void[str]();
}

fun seed_one_primitive(rc: *ResolveContext, index: u32, name: str, kind_ordinal: u32) R.Result[R.Void, str] {
    val r_id: R.Result[intern.StrId, str] = intern.intern(?rc.s.interner, name);
    if (R.is_err[intern.StrId, str](r_id)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_id)); ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_id)); }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_id);

    val r_sym: R.Result[SymbolId, str] = add_symbol(rc, SYM_PRIM, 0, name_id, name_id, id.DECL_NIL, kind_ordinal, rc.own_module);
    if (R.is_err[SymbolId, str](r_sym)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r_sym)); ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r_sym)); }
    val sid: SymbolId = R.unwrap_ok[SymbolId, str](r_sym);

    rc.prim_names[index] = name_id;
    rc.prim_syms[index]  = sid;
    ret R.ok_void[str]();
}

pub def TypeSpellStatus: u8;

pub val TYPE_SPELL_NONE:        TypeSpellStatus = 0;
pub val TYPE_SPELL_FOUND:       TypeSpellStatus = 1;
pub val TYPE_SPELL_VEC_REFUSED: TypeSpellStatus = 2;

rec TypeSpelling {
    status: TypeSpellStatus;
    sym:    SymbolId;
    form:   type.VecForm;
}

fun type_spelling(rc: *ResolveContext, name: intern.StrId) R.Result[TypeSpelling, str] {
    var out: TypeSpelling;
    out.status = TYPE_SPELL_NONE;
    out.sym    = SYMBOL_NIL;

    var i: u32 = 0;
    for (i < PRIM_COUNT) {
        if (rc.prim_names[i] == name) {
            out.status = TYPE_SPELL_FOUND;
            out.sym    = rc.prim_syms[i];
            ret R.ok[TypeSpelling, str](out);
        }
        i = i + 1;
    }

    val cached: R.Result[*SymbolId, str] = map.get[intern.StrId, SymbolId](?rc.vec_cache, ?name);
    if (R.is_ok[*SymbolId, str](cached)) {
        out.status = TYPE_SPELL_FOUND;
        out.sym    = @R.unwrap_ok[*SymbolId, str](cached);
        ret R.ok[TypeSpelling, str](out);
    }

    val no: O.Option[str] = intern.lookup(?rc.s.interner, name);
    if (O.is_none[str](no)) { ret R.ok[TypeSpelling, str](out); }

    val form: type.VecForm = type.vector_form(O.unwrap[str](no));
    out.form = form;
    if (form.status == type.VEC_FORM_NONE) { ret R.ok[TypeSpelling, str](out); }
    if (form.status != type.VEC_FORM_OK) {
        out.status = TYPE_SPELL_VEC_REFUSED;
        ret R.ok[TypeSpelling, str](out);
    }

    val r_tid: R.Result[type.TypeId, str] = type.intern_vector(?rc.s.types, form.element, form.lanes);
    if (R.is_err[type.TypeId, str](r_tid)) { fail.internal(?rc.status, R.unwrap_err[type.TypeId, str](r_tid)); ret R.err[TypeSpelling, str](R.unwrap_err[type.TypeId, str](r_tid)); }
    val vtid: type.TypeId = R.unwrap_ok[type.TypeId, str](r_tid);

    val r_sym: R.Result[SymbolId, str] = add_symbol(rc, SYM_VECTOR, 0, name, name, id.DECL_NIL, vtid::u32, rc.own_module);
    if (R.is_err[SymbolId, str](r_sym)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r_sym)); ret R.err[TypeSpelling, str](R.unwrap_err[SymbolId, str](r_sym)); }
    val sid: SymbolId = R.unwrap_ok[SymbolId, str](r_sym);

    val ins: R.Result[bool, str] = map.insert[intern.StrId, SymbolId](?rc.vec_cache, name, sid);
    if (R.is_err[bool, str](ins)) { ret R.err[TypeSpelling, str](R.unwrap_err[bool, str](ins)); }

    out.status = TYPE_SPELL_FOUND;
    out.sym    = sid;
    ret R.ok[TypeSpelling, str](out);
}

fun report_vector_refused(rc: *ResolveContext, span: token.Span, name: intern.StrId,
                          form: type.VecForm) R.Result[R.Void, str] {
    val no: O.Option[str] = intern.lookup(?rc.s.interner, name);
    if (O.is_none[str](no)) { ret R.ok_void[str](); }
    val spelling: str = O.unwrap[str](no);

    var rm: R.Result[str, str] = format.sprint(rc.s.alloc,
        "vector `{}` needs at least 2 lanes", spelling);
    if (form.status == type.VEC_FORM_TOO_WIDE) {
        rm = format.sprint(rc.s.alloc,
            "vector `{}` has more than {} lanes, which the compiler cannot represent",
            spelling, type.MAX_VEC_LANES);
    }
    if (R.is_err[str, str](rm)) { fail.internal(?rc.status, R.unwrap_err[str, str](rm)); ret R.err[R.Void, str](R.unwrap_err[str, str](rm)); }
    val msg: str = R.unwrap_ok[str, str](rm);

    val emit: R.Result[R.Void, str] = report(rc, span, msg);
    A.deallocate[char](rc.s.alloc, msg::*char, str_len(msg) + 1);
    ret emit;
}

fun collect_decl_list(rc: *ResolveContext, start: u32, len: u32, scope: ScopeId, at_module_scope: bool) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val decl_id: id.DeclId = rc.a.decl_ids[start + i];
        val r: R.Result[R.Void, str] = collect_one_decl(rc, decl_id, scope, at_module_scope);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun collect_one_decl(rc: *ResolveContext, decl_id: id.DeclId, scope: ScopeId, at_module_scope: bool) R.Result[R.Void, str] {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (O.is_none[*decl.Decl](d_opt)) { ret R.err[R.Void, str]("DeclId out of range"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    val flags_in: u8 = d.flags;

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret collect_comptime_if(rc, ?d.data.comptime_if, scope, at_module_scope, true);
    }
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) {
        ret R.ok_void[str]();
    }
    if (d.kind == decl.DECL_KIND_TEST || d.kind == decl.DECL_KIND_ERROR) {
        ret R.ok_void[str]();
    }

    if (d.kind == decl.DECL_KIND_FWD) {
        ret collect_fwd(rc, decl_id, ?d.data.fwd_, d.flags);
    }

    val sym_flags: u8 = symbol_flags_from(flags_in, at_module_scope);

    if (d.kind == decl.DECL_KIND_USE) {
        ret collect_use(rc, decl_id, ?d.data.use_, scope);
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        ret declare_decl(rc, SYM_FUN, sym_flags, d.data.fun_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_REC) {
        ret declare_decl(rc, SYM_REC, sym_flags, d.data.rec_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_UNI) {
        ret declare_decl(rc, SYM_UNI, sym_flags, d.data.uni_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_DEF) {
        ret declare_decl(rc, SYM_DEF, sym_flags, d.data.def_.name, decl_id, scope);
    }
    if (d.kind == decl.DECL_KIND_VAL) {
        val r: R.Result[R.Void, str] = declare_decl(rc, SYM_VAL, sym_flags, d.data.bind.name, decl_id, scope);
        if (R.is_err[R.Void, str](r)) { ret r; }
        if (d.data.bind.init != id.EXPR_NIL) {
            val rcr: R.Result[R.Void, str] =
                try_register_comptime_const(rc, d.data.bind.name, d.data.bind.ty, d.data.bind.init);
            if (R.is_err[R.Void, str](rcr)) { ret rcr; }
        }
        ret R.ok_void[str]();
    }
    if (d.kind == decl.DECL_KIND_VAR) {
        ret declare_decl(rc, SYM_VAR, sym_flags, d.data.bind.name, decl_id, scope);
    }
    ret R.ok_void[str]();
}

fun declare_decl(rc: *ResolveContext, kind: SymKind, flags: u8, name_span: token.Span, decl_id: id.DeclId, scope: ScopeId) R.Result[R.Void, str] {
    val rn: R.Result[R.Void, str] = reject_vector_named_type(rc, kind, name_span);
    if (R.is_err[R.Void, str](rn)) { ret rn; }

    val r: R.Result[SymbolId, str] = declare(rc, kind, flags, name_span, decl_id, 0, rc.own_module, scope);
    if (R.is_err[SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r)); ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r)); }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = R.unwrap_ok[SymbolId, str](r);
    }
    ret R.ok_void[str]();
}

fun reject_vector_named_type(rc: *ResolveContext, kind: SymKind, name_span: token.Span) R.Result[R.Void, str] {
    if (kind != SYM_REC && kind != SYM_UNI && kind != SYM_DEF) { ret R.ok_void[str](); }
    if (name_span.len == 0) { ret R.ok_void[str](); }

    val r_id: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, name_span);
    if (R.is_err[intern.StrId, str](r_id)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_id)); ret R.ok_void[str](); }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_id);

    val no: O.Option[str] = intern.lookup(?rc.s.interner, name_id);
    if (O.is_none[str](no)) { ret R.ok_void[str](); }
    val spelling: str = O.unwrap[str](no);

    if (!type.is_vector_spelling(spelling)) { ret R.ok_void[str](); }

    val rm: R.Result[str, str] = format.sprint(rc.s.alloc,
        "`{}` is spelled as a vector type `<element>x<lanes>`, so it cannot also name a type; the declaration would be unreachable",
        spelling);
    if (R.is_err[str, str](rm)) { fail.internal(?rc.status, R.unwrap_err[str, str](rm)); ret R.err[R.Void, str](R.unwrap_err[str, str](rm)); }
    val msg: str = R.unwrap_ok[str, str](rm);

    val emit: R.Result[R.Void, str] = report(rc, name_span, msg);
    A.deallocate[char](rc.s.alloc, msg::*char, str_len(msg) + 1);
    if (R.is_err[R.Void, str](emit)) { ret emit; }
    ret R.ok_void[str]();
}

fun symbol_flags_from(decl_flags: u8, at_module_scope: bool) u8 {
    if (!at_module_scope) { ret 0; }
    var f: u8 = SYM_FLAG_MODULE;
    if ((decl_flags & decl.DECL_FLAG_PUB) != 0) { f = f | SYM_FLAG_PUB; }
    ret f;
}

fun try_register_comptime_const(rc: *ResolveContext, name_span: token.Span, ty: id.TypeId,
                                init_expr: id.ExprId) R.Result[R.Void, str] {
    if (name_span.len == 0) { ret R.ok_void[str](); }
    val r_id: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, name_span);
    if (R.is_err[intern.StrId, str](r_id)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_id)); ret R.ok_void[str](); }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_id);

    if (O.is_some[comptime.NamedConst](comptime.lookup(rc.ctx, name_id))) { ret R.ok_void[str](); }

    val fw: float.FloatWidth = comptime.declared_float_width(rc.a, rc.source, ty);
    val r_val: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate_at_float_width[ResolveContext](rc.ctx, rc, rc.caps, rc.a, rc.source, init_expr, ?rc.s.interner, fw);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](r_val)) { ret R.ok_void[str](); }
    val v: comptime.CTValue = comptime.apply_declared_int_type(rc.a, rc.source, ty,
        R.unwrap_ok[comptime.CTValue, comptime.EvalFail](r_val));
    if (comptime.float_width_unread(v)) { ret R.ok_void[str](); }

    ret comptime.bind_gated(rc.ctx, name_id, v, rc.in_gated_decl_scope);
}

fun collect_comptime_if(rc: *ResolveContext, ci: *decl.DeclComptimeIf, scope: ScopeId, at_module_scope: bool, at_decl_scope: bool) R.Result[R.Void, str] {
    if (at_decl_scope && comptime.comptime_if_declares_nothing(rc.a, ci.branches_start, ci.branches_len)) {
        ret R.ok_void[str]();
    }
    var bi: u32 = 0;
    for (bi < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?rc.a.comptime_branches[ci.branches_start + bi];
        val take_r: R.Result[comptime.GateOutcome, str] = comptime_branch_active(rc, br, at_decl_scope);
        if (R.is_err[comptime.GateOutcome, str](take_r)) {
            ret R.err[R.Void, str](R.unwrap_err[comptime.GateOutcome, str](take_r));
        }
        val outcome: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](take_r);
        if (outcome == comptime.GATE_DEFERRED || outcome == comptime.GATE_REJECTED || outcome == comptime.GATE_FAILED) {
            ret R.ok_void[str]();
        }
        if (outcome == comptime.GATE_ACTIVE) {
            if (at_decl_scope) {
                val saved_gated: bool = rc.in_gated_decl_scope;
                rc.in_gated_decl_scope = true;
                val r: R.Result[R.Void, str] = collect_decl_list(rc, br.body_start, br.body_len, scope, at_module_scope);
                rc.in_gated_decl_scope = saved_gated;
                ret r;
            }
            ret R.ok_void[str]();
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

fun comptime_branch_active(rc: *ResolveContext, br: *decl.ComptimeBranch, at_decl_scope: bool) R.Result[comptime.GateOutcome, str] {
    var scope: comptime.GateScope = comptime.GATE_SCOPE_INSTANCE;
    if (at_decl_scope) { scope = comptime.GATE_SCOPE_DECL; }
    val vr: R.Result[comptime.GateVerdict, str] = comptime.evaluate_gate[ResolveContext](
        rc.ctx, rc, rc.caps, rc.a, rc.source, br.cond, ?rc.s.interner, scope, at_decl_scope, rc.terminal);
    if (R.is_err[comptime.GateVerdict, str](vr)) {
        ret R.err[comptime.GateOutcome, str](R.unwrap_err[comptime.GateVerdict, str](vr));
    }
    ret render_gate_verdict(rc, R.unwrap_ok[comptime.GateVerdict, str](vr));
}

fun render_gate_verdict(rc: *ResolveContext, v: comptime.GateVerdict) R.Result[comptime.GateOutcome, str] {
    if (v.outcome == comptime.GATE_ACTIVE || v.outcome == comptime.GATE_INACTIVE) {
        ret R.ok[comptime.GateOutcome, str](v.outcome);
    }
    if (v.outcome == comptime.GATE_AWAITING_PHASE || v.outcome == comptime.GATE_AWAITING_TYPES
     || v.outcome == comptime.GATE_DEFERRED) {
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_DEFERRED);
    }
    if (v.outcome == comptime.GATE_REJECTED) {
        val e: R.Result[R.Void, str] = emit_gate_message(rc, v);
        if (R.is_err[R.Void, str](e)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[R.Void, str](e)); }
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_REJECTED);
    }
    if (v.outcome == comptime.GATE_AWAITING_LAYOUT) {
        val e: R.Result[R.Void, str] = emit_gate_message(rc, v);
        if (R.is_err[R.Void, str](e)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[R.Void, str](e)); }
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_FAILED);
    }
    if (v.outcome == comptime.GATE_FAILED) {
        if (v.depends != intern.STR_NIL) {
            fail.reject(?rc.status);
            val committed_r: R.Result[bool, str] = diagnostic.gate_error_named(?rc.s.gate_diags, ?rc.s.diags,
                ?rc.s.interner, rc.a.file_id, v.span, v.depends, v.message);
            if (R.is_err[bool, str](committed_r)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[bool, str](committed_r)); }
            ret R.ok[comptime.GateOutcome, str](comptime.GATE_FAILED);
        }
        val e: R.Result[R.Void, str] = emit_gate_message(rc, v);
        if (R.is_err[R.Void, str](e)) { ret R.err[comptime.GateOutcome, str](R.unwrap_err[R.Void, str](e)); }
        ret R.ok[comptime.GateOutcome, str](comptime.GATE_FAILED);
    }
    ret R.ok[comptime.GateOutcome, str](comptime.GATE_DEFERRED);
}

fun emit_gate_message(rc: *ResolveContext, v: comptime.GateVerdict) R.Result[R.Void, str] {
    fail.reject(?rc.status);
    if (str_len(v.message) == 0) { ret R.ok_void[str](); }
    ret R.void_of[bool, str](diagnostic.gate_error(?rc.s.gate_diags, ?rc.s.diags, ?rc.s.interner, rc.a.file_id, v.span, v.message));
}


fun collect_use(rc: *ResolveContext, decl_id: id.DeclId, du: *decl.DeclUse, scope: ScopeId) R.Result[R.Void, str] {
    if (du.path.len == 0) {
        ret R.ok_void[str]();
    }

    val r_path: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, du.path);
    if (R.is_err[intern.StrId, str](r_path)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_path));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_path));
    }
    val path_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_path);

    val mx: *ModuleExports = find_module_exports(rc, path_id);
    if (mx != nil) {
        var alias_span: token.Span = du.alias;
        if (alias_span.len == 0) {
            alias_span = leaf_span(rc, du.path);
        }
        val r: R.Result[SymbolId, str] = declare(rc, SYM_USE, 0, alias_span, decl_id, mx.module::u32, rc.own_module, scope);
        if (R.is_err[SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r)); ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r)); }
        if (rc.decl_symbol != nil) {
            rc.decl_symbol[decl_id] = R.unwrap_ok[SymbolId, str](r);
        }
        ret R.ok_void[str]();
    }

    val leaf: token.Span = leaf_span(rc, du.path);
    val prefix: token.Span = prefix_span(rc, du.path);
    if (prefix.len == 0 || leaf.len == 0) {
        record_report(rc, du.path, "imported module is not in the dep set");
        ret R.ok_void[str]();
    }

    val pmx: *ModuleExports = find_module_exports_span(rc, prefix);
    if (pmx == nil) {
        record_report(rc, du.path, "imported module is not in the dep set");
        ret R.ok_void[str]();
    }

    val r_leaf: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, leaf);
    if (R.is_err[intern.StrId, str](r_leaf)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_leaf));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_leaf));
    }
    val leaf_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_leaf);

    val ps: *PublicSymbol = find_export(pmx, leaf_id);
    if (ps == nil) {
        report_named2(rc, du.path, "`", leaf_id, "` is not exported by `", pmx.path, "`");
        ret R.ok_void[str]();
    }

    var bind_span: token.Span = du.alias;
    if (bind_span.len == 0) {
        bind_span = leaf;
    }
    ret bind_imported_symbol(rc, decl_id, bind_span, ps, scope);
}

fun bind_imported_symbol(rc: *ResolveContext, decl_id: id.DeclId, bind_span: token.Span, ps: *PublicSymbol, scope: ScopeId) R.Result[R.Void, str] {
    if (bind_span.len == 0) { ret R.ok_void[str](); }
    val r_name: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, bind_span);
    if (R.is_err[intern.StrId, str](r_name)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_name));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_name));
    }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_name);

    val existing: SymbolId = scope_lookup_local(rc, scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: R.Result[R.Void, str] = report_named(rc, bind_span, "imported name `", name_id, "` is already defined in this scope");
        if (R.is_ok[R.Void, str](de)) {
            report_prior_binding(rc, existing);
        }
        ret R.ok_void[str]();
    }

    val sid_r: R.Result[SymbolId, str] = imported_symbol_for(rc, ps);
    if (R.is_err[SymbolId, str](sid_r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](sid_r)); ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](sid_r)); }
    val sid: SymbolId = R.unwrap_ok[SymbolId, str](sid_r);

    val r_add: R.Result[R.Void, str] = scope_add(rc, scope, name_id, sid);
    if (R.is_err[R.Void, str](r_add)) { ret r_add; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = sid;
    }
    ret R.ok_void[str]();
}

fun imported_symbol_for(rc: *ResolveContext, ps: *PublicSymbol) R.Result[SymbolId, str] {
    val key: u64 = (ps.origin::u64 << 32) | ps.decl::u64;
    val cached: R.Result[*SymbolId, str] = map.get[u64, SymbolId](?rc.imported_cache, ?key);
    if (R.is_ok[*SymbolId, str](cached)) {
        ret R.ok[SymbolId, str](@R.unwrap_ok[*SymbolId, str](cached));
    }
    var kind: SymKind = SYM_IMPORTED;
    var slot: u32     = 0;
    if (ps.kind == SYM_USE) {
        kind = SYM_USE;
        slot = ps.slot;
    }
    val r: R.Result[SymbolId, str] = add_symbol(rc, kind, 0, ps.name, ps.canon, ps.decl, slot, ps.origin);
    if (R.is_err[SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r)); ret r; }
    val sid: SymbolId = R.unwrap_ok[SymbolId, str](r);
    val ins: R.Result[bool, str] = map.insert[u64, SymbolId](?rc.imported_cache, key, sid);
    if (R.is_err[bool, str](ins)) { ret R.err[SymbolId, str](R.unwrap_err[bool, str](ins)); }
    ret R.ok[SymbolId, str](sid);
}

fun last_dot_offset(rc: *ResolveContext, path: token.Span) usize {
    val start: usize = path.offset;
    val end:   usize = path.offset + path.len;
    var dot:   usize = start;
    var found: bool  = false;
    var i:     usize = start;
    for (i < end) {
        if (rc.source[i] == '.') {
            dot   = i;
            found = true;
        }
        i = i + 1;
    }
    if (!found) { ret start; }
    ret dot;
}

fun leaf_span(rc: *ResolveContext, path: token.Span) token.Span {
    val end: usize = path.offset + path.len;
    val dot: usize = last_dot_offset(rc, path);
    var out: token.Span;
    if (dot == path.offset && rc.source[path.offset] != '.') {
        out.offset = path.offset;
        out.len    = path.len;
        ret out;
    }
    out.offset = dot + 1;
    out.len    = end - (dot + 1);
    ret out;
}

fun prefix_span(rc: *ResolveContext, path: token.Span) token.Span {
    val dot: usize = last_dot_offset(rc, path);
    var out: token.Span;
    if (dot == path.offset && rc.source[path.offset] != '.') {
        out.offset = path.offset;
        out.len    = 0;
        ret out;
    }
    out.offset = path.offset;
    out.len    = dot - path.offset;
    ret out;
}

fun find_module_exports(rc: *ResolveContext, path: intern.StrId) *ModuleExports {
    var i: u32 = 0;
    for (i < rc.deps.count) {
        val mx: *ModuleExports = ?rc.deps.entries[i];
        if (mx.path == path) { ret mx; }
        i = i + 1;
    }
    ret nil;
}

fun find_module_exports_by_module(rc: *ResolveContext, mid: session.ModuleId) *ModuleExports {
    var i: u32 = 0;
    for (i < rc.deps.count) {
        val mx: *ModuleExports = ?rc.deps.entries[i];
        if (mx.module == mid) { ret mx; }
        i = i + 1;
    }
    ret nil;
}

fun bind_member_qualified(rc: *ResolveContext, eid: id.ExprId, member: *expr.ExprMember) R.Result[R.Void, str] {
    if (rc.expr_resolved == nil) { ret R.ok_void[str](); }

    val obj_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, member.object);
    if (O.is_none[*expr.Expr](obj_opt)) { ret R.ok_void[str](); }

    val osid: SymbolId = rc.expr_resolved[member.object];
    if (osid == SYMBOL_NIL || osid >= rc.sym_len) { ret R.ok_void[str](); }
    val osym: *Symbol = ?rc.symbols[osid];
    if (osym.kind != SYM_USE) { ret R.ok_void[str](); }

    val target: session.ModuleId = osym.slot::session.ModuleId;
    val mx: *ModuleExports = find_module_exports_by_module(rc, target);
    if (mx == nil) {
        record_report(rc, member.name, "module alias names a module that is not in the dep set");
        ret R.ok_void[str]();
    }

    val r_leaf: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, member.name);
    if (R.is_err[intern.StrId, str](r_leaf)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_leaf)); ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_leaf)); }
    val leaf_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_leaf);

    val ps: *PublicSymbol = find_export(mx, leaf_id);
    if (ps == nil) {
        report_named2(rc, member.name, "no symbol `", leaf_id, "` exported by `", mx.path, "`");
        ret R.ok_void[str]();
    }

    val r_sym: R.Result[SymbolId, str] = imported_symbol_for(rc, ps);
    if (R.is_err[SymbolId, str](r_sym)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r_sym)); ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r_sym)); }
    rc.expr_resolved[eid] = R.unwrap_ok[SymbolId, str](r_sym);
    ret R.ok_void[str]();
}

fun find_module_exports_span(rc: *ResolveContext, span: token.Span) *ModuleExports {
    val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, span);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret nil; }
    ret find_module_exports(rc, R.unwrap_ok[intern.StrId, str](r));
}

fun resolve_prefix_module(rc: *ResolveContext, prefix: token.Span) *ModuleExports {
    val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, prefix);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret nil; }
    val prefix_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r);

    val sid: SymbolId = scope_lookup_chain(rc, rc.module_scope, prefix_id);
    if (sid != SYMBOL_NIL && sid < rc.sym_len) {
        val sym: *Symbol = ?rc.symbols[sid];
        if (sym.kind == SYM_USE) {
            ret find_module_exports_by_module(rc, sym.slot::session.ModuleId);
        }
    }
    ret find_module_exports(rc, prefix_id);
}

fun find_export(mx: *ModuleExports, name: intern.StrId) *PublicSymbol {
    var i: u32 = 0;
    for (i < mx.count) {
        val ps: *PublicSymbol = ?mx.symbols[i];
        if (ps.name == name) { ret ps; }
        i = i + 1;
    }
    ret nil;
}

fun bind_decl_list(rc: *ResolveContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val decl_id: id.DeclId = rc.a.decl_ids[start + i];
        val r: R.Result[R.Void, str] = bind_one_decl(rc, decl_id);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun bind_decorator_args(rc: *ResolveContext, d: *decl.Decl) R.Result[R.Void, str] {
    var k: u32 = 0;
    for (k < d.decorators_len) {
        val dec: *decl.Decorator = ?rc.a.decorators[d.decorators_start + k];
        var j: u32 = 0;
        for (j < dec.args_len) {
            val r: R.Result[R.Void, str] = bind_expr(rc, rc.a.expr_ids[dec.args_start + j]);
            if (R.is_err[R.Void, str](r)) { ret r; }
            j = j + 1;
        }
        k = k + 1;
    }
    ret R.ok_void[str]();
}

fun bind_one_decl(rc: *ResolveContext, decl_id: id.DeclId) R.Result[R.Void, str] {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (O.is_none[*decl.Decl](d_opt)) { ret R.err[R.Void, str]("DeclId out of range"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    val rda: R.Result[R.Void, str] = bind_decorator_args(rc, d);
    if (R.is_err[R.Void, str](rda)) { ret rda; }

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
        ret bind_comptime_if(rc, ci.branches_start, ci.branches_len, true);
    }
    if (d.kind == decl.DECL_KIND_USE || d.kind == decl.DECL_KIND_ERROR || d.kind == decl.DECL_KIND_FWD) {
        ret R.ok_void[str]();
    }
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) {
        ret R.ok_void[str]();
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        ret bind_fun(rc, ?d.data.fun_, decl_id);
    }
    if (d.kind == decl.DECL_KIND_REC) {
        ret bind_rec(rc, ?d.data.rec_, decl_id);
    }
    if (d.kind == decl.DECL_KIND_UNI) {
        ret bind_uni(rc, ?d.data.uni_, decl_id);
    }
    if (d.kind == decl.DECL_KIND_DEF) {
        ret bind_type(rc, d.data.def_.ty);
    }
    if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
        if (d.data.bind.ty != id.TYPE_NIL) {
            val r: R.Result[R.Void, str] = bind_type(rc, d.data.bind.ty);
            if (R.is_err[R.Void, str](r)) { ret r; }
        }
        if (d.data.bind.init != id.EXPR_NIL) {
            ret bind_expr(rc, d.data.bind.init);
        }
        ret R.ok_void[str]();
    }
    if (d.kind == decl.DECL_KIND_TEST) {
        if (d.data.test_.body != id.STMT_NIL) {
            ret bind_stmt(rc, d.data.test_.body);
        }
        ret R.ok_void[str]();
    }
    ret R.ok_void[str]();
}

fun collect_fwd(rc: *ResolveContext, decl_id: id.DeclId, df: *decl.DeclFwd, flags: u8) R.Result[R.Void, str] {
    if ((flags & decl.DECL_FLAG_PUB) != 0) {
        record_report(rc, df.path, "`fwd` always re-exports; `pub fwd` is not allowed");
        ret R.ok_void[str]();
    }
    if (df.path.len == 0) {
        ret R.ok_void[str]();
    }

    val r_full: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, df.path);
    if (R.is_err[intern.StrId, str](r_full)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_full));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_full));
    }
    val full_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_full);
    val full_mx: *ModuleExports = find_module_exports(rc, full_id);
    if (full_mx != nil) {
        ret collect_fwd_module(rc, decl_id, df, full_mx.module);
    }

    val leaf: token.Span = leaf_span(rc, df.path);
    val prefix: token.Span = prefix_span(rc, df.path);
    if (prefix.len == 0 || leaf.len == 0) {
        record_report(rc, df.path, "`fwd` path must name a symbol of a module");
        ret R.ok_void[str]();
    }

    val pmx: *ModuleExports = resolve_prefix_module(rc, prefix);
    if (pmx == nil) {
        record_report(rc, df.path, "re-exported module is not in the dep set");
        ret R.ok_void[str]();
    }

    val r_leaf: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, leaf);
    if (R.is_err[intern.StrId, str](r_leaf)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_leaf));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_leaf));
    }
    val leaf_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_leaf);

    val ps: *PublicSymbol = find_export(pmx, leaf_id);
    if (ps == nil) {
        record_report(rc, df.path, "re-exported symbol is not exported by its module");
        ret R.ok_void[str]();
    }

    var bind_span: token.Span = df.alias;
    if (bind_span.len == 0) {
        bind_span = leaf;
    }

    val r_name: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, bind_span);
    if (R.is_err[intern.StrId, str](r_name)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_name));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_name));
    }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_name);

    val existing: SymbolId = scope_lookup_local(rc, rc.module_scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: R.Result[R.Void, str] = report_named(rc, bind_span, "re-exported name `", name_id, "` is already defined in this scope");
        if (R.is_ok[R.Void, str](de)) {
            report_prior_binding(rc, existing);
        }
        ret R.ok_void[str]();
    }

    var slot: u32 = 0;
    if (ps.kind == SYM_USE) { slot = ps.slot; }

    val r_sym: R.Result[SymbolId, str] = add_symbol(rc, ps.kind, SYM_FLAG_PUB, name_id, ps.canon, ps.decl, slot, ps.origin);
    if (R.is_err[SymbolId, str](r_sym)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r_sym)); ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r_sym)); }
    val sid: SymbolId = R.unwrap_ok[SymbolId, str](r_sym);

    val r_add: R.Result[R.Void, str] = scope_add(rc, rc.module_scope, name_id, sid);
    if (R.is_err[R.Void, str](r_add)) { ret r_add; }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = sid;
    }
    ret R.ok_void[str]();
}

fun collect_fwd_module(rc: *ResolveContext, decl_id: id.DeclId, df: *decl.DeclFwd, mid: session.ModuleId) R.Result[R.Void, str] {
    var alias_span: token.Span = df.alias;
    if (alias_span.len == 0) {
        alias_span = leaf_span(rc, df.path);
    }

    val r_name: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, alias_span);
    if (R.is_err[intern.StrId, str](r_name)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r_name));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r_name));
    }
    val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](r_name);

    val existing: SymbolId = scope_lookup_local(rc, rc.module_scope, name_id);
    if (existing != SYMBOL_NIL) {
        val de: R.Result[R.Void, str] = report_named(rc, alias_span, "re-exported name `", name_id, "` is already defined in this scope");
        if (R.is_ok[R.Void, str](de)) {
            report_prior_binding(rc, existing);
        }
        ret R.ok_void[str]();
    }

    val r: R.Result[SymbolId, str] = declare(rc, SYM_USE, SYM_FLAG_PUB, alias_span, decl_id, mid::u32, rc.own_module, rc.module_scope);
    if (R.is_err[SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r)); ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r)); }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = R.unwrap_ok[SymbolId, str](r);
    }
    ret R.ok_void[str]();
}

fun gate_probe_ident_is_comptime_param(rc: *ResolveContext, eid: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, O.unwrap[*expr.Expr](e_opt).span);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, R.unwrap_ok[intern.StrId, str](r));
    if (sid == SYMBOL_NIL) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.kind == SYM_PARAM && (sym.flags & SYM_FLAG_COMPTIME) != 0;
}

fun gate_probe_ident_is_each_loopvar(rc: *ResolveContext, eid: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    ret ident_is_each_loopvar(rc, O.unwrap[*expr.Expr](e_opt).span);
}

fun gate_probe_member_is_field_loopvar(rc: *ResolveContext, eid: id.ExprId) bool {
    ret member_object_is_field_loopvar(rc, eid);
}

fun gate_probe_is_field_type_operand(rc: *ResolveContext, eid: id.ExprId) bool {
    ret is_field_type_operand(rc, eid);
}

fun resolve_gate_probes() comptime.GateProbes[ResolveContext] {
    ret comptime.gate_probes[ResolveContext](
        gate_probe_ident_is_comptime_param,
        gate_probe_ident_is_each_loopvar,
        gate_probe_member_is_field_loopvar,
        gate_probe_is_field_type_operand);
}

fun gate_chain_defers_to_instantiation(rc: *ResolveContext, branches_start: u32, branches_len: u32) R.Result[bool, str] {
    ret comptime.gate_chain_defers[ResolveContext](rc.a, rc.source, rc, resolve_gate_probes(),
                                                   branches_start, branches_len);
}

fun bind_comptime_if(rc: *ResolveContext, branches_start: u32, branches_len: u32, at_decl_scope: bool) R.Result[R.Void, str] {
    if (at_decl_scope && comptime.comptime_if_declares_nothing(rc.a, branches_start, branches_len)) {
        var di: u32 = 0;
        for (di < branches_len) {
            val arm: *decl.ComptimeBranch = ?rc.a.comptime_branches[branches_start + di];
            if (arm.cond != id.EXPR_NIL) {
                val rce: R.Result[R.Void, str] = bind_expr(rc, arm.cond);
                if (R.is_err[R.Void, str](rce)) { ret rce; }
            }
            val rb: R.Result[R.Void, str] = bind_decl_list(rc, arm.body_start, arm.body_len);
            if (R.is_err[R.Void, str](rb)) { ret rb; }
            di = di + 1;
        }
        ret R.ok_void[str]();
    }

    var all_arms: bool = false;
    if (!at_decl_scope) {
        val defers_r: R.Result[bool, str] = gate_chain_defers_to_instantiation(rc, branches_start, branches_len);
        if (R.is_err[bool, str](defers_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](defers_r)); }
        all_arms = R.unwrap_ok[bool, str](defers_r);
    }
    if (all_arms) {
        var ai: u32 = 0;
        for (ai < branches_len) {
            val arm: *decl.ComptimeBranch = ?rc.a.comptime_branches[branches_start + ai];
            if (arm.cond != id.EXPR_NIL) {
                val rc_e: R.Result[R.Void, str] = bind_expr(rc, arm.cond);
                if (R.is_err[R.Void, str](rc_e)) { ret rc_e; }
            }
            val rb: R.Result[R.Void, str] = bind_stmt_list(rc, arm.body_start, arm.body_len);
            if (R.is_err[R.Void, str](rb)) { ret rb; }
            ai = ai + 1;
        }
        ret R.ok_void[str]();
    }

    var bi: u32 = 0;
    for (bi < branches_len) {
        val br: *decl.ComptimeBranch = ?rc.a.comptime_branches[branches_start + bi];
        if (br.cond != id.EXPR_NIL) {
            val rce: R.Result[R.Void, str] = bind_expr(rc, br.cond);
            if (R.is_err[R.Void, str](rce)) { ret rce; }
        }
        val take_r: R.Result[comptime.GateOutcome, str] = comptime_branch_active(rc, br, at_decl_scope);
        if (R.is_err[comptime.GateOutcome, str](take_r)) {
            ret R.err[R.Void, str](R.unwrap_err[comptime.GateOutcome, str](take_r));
        }
        val outcome: comptime.GateOutcome = R.unwrap_ok[comptime.GateOutcome, str](take_r);
        if (outcome == comptime.GATE_DEFERRED || outcome == comptime.GATE_REJECTED || outcome == comptime.GATE_FAILED) {
            ret R.ok_void[str]();
        }
        if (outcome == comptime.GATE_ACTIVE) {
            if (at_decl_scope) {
                ret bind_decl_list(rc, br.body_start, br.body_len);
            }
            ret bind_stmt_list(rc, br.body_start, br.body_len);
        }
        bi = bi + 1;
    }
    ret R.ok_void[str]();
}

pub fun symbol_is_runtime(sym: *Symbol) bool {
    if ((sym.flags & SYM_FLAG_COMPTIME) != 0) { ret false; }
    if (sym.kind == SYM_VAL || sym.kind == SYM_VAR) {
        ret (sym.flags & SYM_FLAG_MODULE) == 0;
    }
    ret sym.kind == SYM_PARAM;
}

fun comptime_ident_is_runtime(rc: *ResolveContext, eid: id.ExprId) bool {
    if (rc == nil || rc.expr_resolved == nil) { ret false; }
    if (eid == id.EXPR_NIL || eid::u32 >= rc.a.expr_len::u32) { ret false; }
    val sid: SymbolId = rc.expr_resolved[eid];
    if (sid == SYMBOL_NIL || sid >= rc.sym_len) { ret false; }
    ret symbol_is_runtime(?rc.symbols[sid]);
}

fun bind_fun(rc: *ResolveContext, f: *decl.DeclFun, decl_id: id.DeclId) R.Result[R.Void, str] {
    val r_g: R.Result[ScopeId, str] = open_scope(rc, rc.current_scope);
    if (R.is_err[ScopeId, str](r_g)) { ret R.err[R.Void, str](R.unwrap_err[ScopeId, str](r_g)); }
    val gen_scope: ScopeId = R.unwrap_ok[ScopeId, str](r_g);
    val saved_scope: ScopeId = rc.current_scope;
    rc.current_scope = gen_scope;

    var gi: u32 = 0;
    for (gi < f.generics_len) {
        val name: token.Span = rc.a.generic_names[f.generics_start + gi];
        val r: R.Result[SymbolId, str] = declare(rc, SYM_GENERIC, 0, name, decl_id, gi, rc.own_module, gen_scope);
        if (R.is_err[SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r));
            rc.current_scope = saved_scope;
            ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r));
        }
        gi = gi + 1;
    }

    val r_p: R.Result[ScopeId, str] = open_scope(rc, gen_scope);
    if (R.is_err[ScopeId, str](r_p)) {
        rc.current_scope = saved_scope;
        ret R.err[R.Void, str](R.unwrap_err[ScopeId, str](r_p));
    }
    val param_scope: ScopeId = R.unwrap_ok[ScopeId, str](r_p);
    rc.current_scope = param_scope;

    var pi: u32 = 0;
    for (pi < f.params_len) {
        val tn: *decl.TypedName = ?rc.a.typed_names[f.params_start + pi];
        val rt: R.Result[R.Void, str] = bind_type(rc, tn.ty);
        if (R.is_err[R.Void, str](rt)) {
            rc.current_scope = saved_scope;
            ret rt;
        }
        val pflags: u8 = param_flags(tn);
        val r: R.Result[SymbolId, str] = declare(rc, SYM_PARAM, pflags, tn.name, decl_id, pi, rc.own_module, param_scope);
        if (R.is_err[SymbolId, str](r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r));
            rc.current_scope = saved_scope;
            ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r));
        }
        pi = pi + 1;
    }

    if (f.return_type != id.TYPE_NIL) {
        val rt: R.Result[R.Void, str] = bind_type(rc, f.return_type);
        if (R.is_err[R.Void, str](rt)) {
            rc.current_scope = saved_scope;
            ret rt;
        }
    }

    if (f.body != id.STMT_NIL) {
        val rb: R.Result[R.Void, str] = bind_stmt(rc, f.body);
        if (R.is_err[R.Void, str](rb)) {
            rc.current_scope = saved_scope;
            ret rb;
        }
    }

    rc.current_scope = saved_scope;
    ret R.ok_void[str]();
}

fun param_flags(tn: *decl.TypedName) u8 {
    if (tn.comptime) { ret SYM_FLAG_COMPTIME; }
    ret 0;
}

fun bind_rec(rc: *ResolveContext, r: *decl.DeclRec, decl_id: id.DeclId) R.Result[R.Void, str] {
    ret bind_aggregate(rc, r.generics_start, r.generics_len, r.fields_start, r.fields_len, decl_id);
}

fun bind_uni(rc: *ResolveContext, u: *decl.DeclUni, decl_id: id.DeclId) R.Result[R.Void, str] {
    ret bind_aggregate(rc, u.generics_start, u.generics_len, u.fields_start, u.fields_len, decl_id);
}

fun bind_aggregate(rc: *ResolveContext, generics_start: u32, generics_len: u32, fields_start: u32, fields_len: u32, decl_id: id.DeclId) R.Result[R.Void, str] {
    val r_g: R.Result[ScopeId, str] = open_scope(rc, rc.current_scope);
    if (R.is_err[ScopeId, str](r_g)) { ret R.err[R.Void, str](R.unwrap_err[ScopeId, str](r_g)); }
    val gen_scope: ScopeId = R.unwrap_ok[ScopeId, str](r_g);
    val saved_scope: ScopeId = rc.current_scope;
    rc.current_scope = gen_scope;

    var gi: u32 = 0;
    for (gi < generics_len) {
        val name: token.Span = rc.a.generic_names[generics_start + gi];
        val rd: R.Result[SymbolId, str] = declare(rc, SYM_GENERIC, 0, name, decl_id, gi, rc.own_module, gen_scope);
        if (R.is_err[SymbolId, str](rd)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](rd));
            rc.current_scope = saved_scope;
            ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](rd));
        }
        gi = gi + 1;
    }

    var fi: u32 = 0;
    for (fi < fields_len) {
        val tn: *decl.TypedName = ?rc.a.typed_names[fields_start + fi];
        val rt: R.Result[R.Void, str] = bind_type(rc, tn.ty);
        if (R.is_err[R.Void, str](rt)) {
            rc.current_scope = saved_scope;
            ret rt;
        }
        fi = fi + 1;
    }

    rc.current_scope = saved_scope;
    ret R.ok_void[str]();
}

fun bind_stmt_list(rc: *ResolveContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val sid: id.StmtId = rc.a.stmt_ids[start + i];
        val r: R.Result[R.Void, str] = bind_stmt(rc, sid);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun bind_stmt(rc: *ResolveContext, sid: id.StmtId) R.Result[R.Void, str] {
    if (sid == id.STMT_NIL) { ret R.ok_void[str](); }
    val s_opt: O.Option[*stmt.Stmt] = ast.get_stmt(rc.a, sid);
    if (O.is_none[*stmt.Stmt](s_opt)) { ret R.err[R.Void, str]("StmtId out of range"); }
    val s: *stmt.Stmt = O.unwrap[*stmt.Stmt](s_opt);

    if (s.kind == stmt.STMT_KIND_BLOCK) { ret bind_block(rc, ?s.data.block); }
    if (s.kind == stmt.STMT_KIND_EXPR)  { ret bind_expr(rc, s.data.expr.expr); }
    if (s.kind == stmt.STMT_KIND_RET) {
        if (s.data.ret_.value == id.EXPR_NIL) { ret R.ok_void[str](); }
        ret bind_expr(rc, s.data.ret_.value);
    }
    if (s.kind == stmt.STMT_KIND_FIN)   { ret bind_stmt(rc, s.data.fin_.body); }
    if (s.kind == stmt.STMT_KIND_BRK || s.kind == stmt.STMT_KIND_CNT) {
        ret R.ok_void[str]();
    }
    if (s.kind == stmt.STMT_KIND_IF) {
        val rc_e: R.Result[R.Void, str] = bind_expr(rc, s.data.if_.cond);
        if (R.is_err[R.Void, str](rc_e)) { ret rc_e; }
        val rt: R.Result[R.Void, str] = bind_stmt(rc, s.data.if_.then_block);
        if (R.is_err[R.Void, str](rt)) { ret rt; }
        ret bind_stmt(rc, s.data.if_.else_block);
    }
    if (s.kind == stmt.STMT_KIND_FOR) {
        if (s.data.for_.cond != id.EXPR_NIL) {
            val rc_e: R.Result[R.Void, str] = bind_expr(rc, s.data.for_.cond);
            if (R.is_err[R.Void, str](rc_e)) { ret rc_e; }
        }
        ret bind_stmt(rc, s.data.for_.body);
    }
    if (s.kind == stmt.STMT_KIND_DECL) {
        ret bind_local_decl(rc, s.data.decl.decl);
    }
    if (s.kind == stmt.STMT_KIND_ASM) {
        ret R.ok_void[str]();
    }
    if (s.kind == stmt.STMT_KIND_COMPTIME_IF) {
        ret bind_comptime_if(rc, s.data.comptime_if.branches_start, s.data.comptime_if.branches_len, false);
    }
    if (s.kind == stmt.STMT_KIND_COMPTIME_EACH) {
        ret bind_comptime_each(rc, ?s.data.comptime_each);
    }
    if (s.kind == stmt.STMT_KIND_COMPTIME_ATTR) {
        ret R.ok_void[str]();
    }
    ret R.ok_void[str]();
}

fun bind_comptime_each(rc: *ResolveContext, ce: *stmt.StmtComptimeEach) R.Result[R.Void, str] {
    val rs: R.Result[R.Void, str] = bind_expr(rc, ce.seq);
    if (R.is_err[R.Void, str](rs)) { ret rs; }

    val r_s: R.Result[ScopeId, str] = open_scope(rc, rc.current_scope);
    if (R.is_err[ScopeId, str](r_s)) { ret R.err[R.Void, str](R.unwrap_err[ScopeId, str](r_s)); }
    val saved: ScopeId = rc.current_scope;
    rc.current_scope = R.unwrap_ok[ScopeId, str](r_s);

    val rd: R.Result[SymbolId, str] = declare(rc, SYM_VAL, SYM_FLAG_COMPTIME, ce.var_name, id.DECL_NIL, 0, rc.own_module, rc.current_scope);
    if (R.is_err[SymbolId, str](rd)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](rd)); rc.current_scope = saved; ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](rd)); }

    val rb: R.Result[R.Void, str] = bind_stmt_list(rc, ce.body_start, ce.body_len);
    rc.current_scope = saved;
    ret rb;
}

fun bind_block(rc: *ResolveContext, b: *stmt.StmtBlock) R.Result[R.Void, str] {
    val r_s: R.Result[ScopeId, str] = open_scope(rc, rc.current_scope);
    if (R.is_err[ScopeId, str](r_s)) { ret R.err[R.Void, str](R.unwrap_err[ScopeId, str](r_s)); }
    val saved: ScopeId = rc.current_scope;
    rc.current_scope = R.unwrap_ok[ScopeId, str](r_s);

    val r: R.Result[R.Void, str] = bind_stmt_list(rc, b.stmts_start, b.stmts_len);
    rc.current_scope = saved;
    ret r;
}

fun bind_local_decl(rc: *ResolveContext, decl_id: id.DeclId) R.Result[R.Void, str] {
    if (decl_id == id.DECL_NIL) { ret R.ok_void[str](); }
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(rc.a, decl_id);
    if (O.is_none[*decl.Decl](d_opt)) { ret R.err[R.Void, str]("DeclId out of range"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);

    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) {
        ret R.ok_void[str]();
    }

    if (d.data.bind.ty != id.TYPE_NIL) {
        val rt: R.Result[R.Void, str] = bind_type(rc, d.data.bind.ty);
        if (R.is_err[R.Void, str](rt)) { ret rt; }
    }
    if (d.data.bind.init != id.EXPR_NIL) {
        val re: R.Result[R.Void, str] = bind_expr(rc, d.data.bind.init);
        if (R.is_err[R.Void, str](re)) { ret re; }
    }

    val kind: SymKind = if_val_kind(d.kind == decl.DECL_KIND_VAL);
    val r_sym: R.Result[SymbolId, str] = declare(rc, kind, 0, d.data.bind.name, decl_id, 0, rc.own_module, rc.current_scope);
    if (R.is_err[SymbolId, str](r_sym)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](r_sym));
        ret R.err[R.Void, str](R.unwrap_err[SymbolId, str](r_sym));
    }
    if (rc.decl_symbol != nil) {
        rc.decl_symbol[decl_id] = R.unwrap_ok[SymbolId, str](r_sym);
    }

    ret R.ok_void[str]();
}

fun if_val_kind(is_val: bool) SymKind {
    if (is_val) { ret SYM_VAL; }
    ret SYM_VAR;
}

fun bind_expr(rc: *ResolveContext, eid: id.ExprId) R.Result[R.Void, str] {
    if (eid == id.EXPR_NIL) { ret R.ok_void[str](); }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret R.err[R.Void, str]("ExprId out of range"); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    if (e.kind == expr.EXPR_KIND_IDENT) {
        ret bind_ident(rc, eid, e.span);
    }
    if (e.kind == expr.EXPR_KIND_BINARY) {
        if (comptime.is_type_comparison_binary(rc.a, rc.source, ?e.data.binary,
                is_field_type_operand(rc, e.data.binary.lhs),
                is_field_type_operand(rc, e.data.binary.rhs))) {
            ret bind_type_comparison(rc, ?e.data.binary);
        }
        val rl: R.Result[R.Void, str] = bind_expr(rc, e.data.binary.lhs);
        if (R.is_err[R.Void, str](rl)) { ret rl; }
        ret bind_expr(rc, e.data.binary.rhs);
    }
    if (e.kind == expr.EXPR_KIND_UNARY) {
        ret bind_expr(rc, e.data.unary.operand);
    }
    if (e.kind == expr.EXPR_KIND_SPREAD) {
        ret bind_expr(rc, e.data.spread.inner);
    }
    if (e.kind == expr.EXPR_KIND_CALL) {
        if (e.data.call.index_callee != id.EXPR_NIL) {
            ret resolve_bracket_call(rc, eid);
        }

        val intr: O.Option[R.Result[R.Void, str]] = bind_comptime_intrinsic_call(rc, ?e.data.call);
        if (O.is_some[R.Result[R.Void, str]](intr)) { ret O.unwrap[R.Result[R.Void, str]](intr); }

        val rc_e: R.Result[R.Void, str] = bind_expr(rc, e.data.call.callee);
        if (R.is_err[R.Void, str](rc_e)) { ret rc_e; }
        ret bind_generic_call(rc, e.data.call.type_args_start, e.data.call.type_args_len, e.data.call.args_start, e.data.call.args_len);
    }
    if (e.kind == expr.EXPR_KIND_GENERIC_INSTANCE) {
        ret resolve_bracket_value(rc, eid);
    }
    if (e.kind == expr.EXPR_KIND_INDEX) {
        val ro: R.Result[R.Void, str] = bind_expr(rc, e.data.index.object);
        if (R.is_err[R.Void, str](ro)) { ret ro; }
        ret bind_expr(rc, e.data.index.index);
    }
    if (e.kind == expr.EXPR_KIND_PROJECT) {
        val ro: R.Result[R.Void, str] = bind_expr(rc, e.data.project.object);
        if (R.is_err[R.Void, str](ro)) { ret ro; }
        ret bind_expr(rc, e.data.project.field);
    }
    if (e.kind == expr.EXPR_KIND_MEMBER) {
        val ro: R.Result[R.Void, str] = bind_expr(rc, e.data.member.object);
        if (R.is_err[R.Void, str](ro)) { ret ro; }
        ret bind_member_qualified(rc, eid, ?e.data.member);
    }
    if (e.kind == expr.EXPR_KIND_CAST) {
        val rv: R.Result[R.Void, str] = bind_expr(rc, e.data.cast.value);
        if (R.is_err[R.Void, str](rv)) { ret rv; }
        ret bind_type(rc, e.data.cast.ty);
    }
    if (e.kind == expr.EXPR_KIND_STRIP) {
        val rv: R.Result[R.Void, str] = bind_expr(rc, e.data.strip.value);
        if (R.is_err[R.Void, str](rv)) { ret rv; }
        ret bind_type(rc, e.data.strip.ty);
    }
    if (e.kind == expr.EXPR_KIND_ARRAY_LIT) {
        val rt: R.Result[R.Void, str] = bind_type(rc, e.data.array_lit.ty);
        if (R.is_err[R.Void, str](rt)) { ret rt; }
        ret bind_expr_list(rc, e.data.array_lit.elems_start, e.data.array_lit.elems_len);
    }
    if (e.kind == expr.EXPR_KIND_VECTOR_LIT) {
        val rt: R.Result[R.Void, str] = bind_type(rc, e.data.vector_lit.ty);
        if (R.is_err[R.Void, str](rt)) { ret rt; }
        ret bind_expr_list(rc, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len);
    }
    if (e.kind == expr.EXPR_KIND_STRUCT_LIT) {
        val rt: R.Result[R.Void, str] = bind_type(rc, e.data.struct_lit.ty);
        if (R.is_err[R.Void, str](rt)) { ret rt; }
        var fi: u32 = 0;
        for (fi < e.data.struct_lit.fields_len) {
            val finit: *expr.FieldInit = ?rc.a.field_inits[e.data.struct_lit.fields_start + fi];
            val rf: R.Result[R.Void, str] = bind_expr(rc, finit.value);
            if (R.is_err[R.Void, str](rf)) { ret rf; }
            fi = fi + 1;
        }
        ret R.ok_void[str]();
    }
    if (e.kind == expr.EXPR_KIND_TYPE_REF) {
        ret bind_type(rc, e.data.type_ref.ty);
    }
    if (expr_kind_binds_nothing(e.kind)) { ret R.ok_void[str](); }

    ret R.err[R.Void, str]("internal: this expression kind has no name-binding rule; the resolver cannot bind its operands");
}

fun expr_kind_binds_nothing(k: expr.ExprKind) bool {
    ret k == expr.EXPR_KIND_LIT_INT   || k == expr.EXPR_KIND_LIT_FLOAT
     || k == expr.EXPR_KIND_LIT_CHAR  || k == expr.EXPR_KIND_LIT_STR
     || k == expr.EXPR_KIND_LIT_NIL   || k == expr.EXPR_KIND_COMPTIME_IDENT
     || k == expr.EXPR_KIND_ERROR;
}

fun bind_expr_list(rc: *ResolveContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val eid: id.ExprId = rc.a.expr_ids[start + i];
        val r: R.Result[R.Void, str] = bind_expr(rc, eid);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun snapshot_bracket(rc: *ResolveContext, eid: id.ExprId, node: *expr.Expr) R.Result[R.Void, str] {
    if (rc.bracket_before_len == rc.bracket_before_cap) {
        val g: R.Result[*BracketSnapshot, str] = pool.grow[BracketSnapshot](
            rc.s.alloc, rc.bracket_before, rc.bracket_before_cap,
            INITIAL_BRACKET_SNAPSHOT_CAP, ?rc.bracket_before_cap);
        if (R.is_err[*BracketSnapshot, str](g)) { fail.internal(?rc.status, R.unwrap_err[*BracketSnapshot, str](g)); ret R.err[R.Void, str](R.unwrap_err[*BracketSnapshot, str](g)); }
        rc.bracket_before = R.unwrap_ok[*BracketSnapshot, str](g);
    }
    var snap: BracketSnapshot;
    snap.eid  = eid;
    snap.node = @node;
    rc.bracket_before[rc.bracket_before_len] = snap;
    rc.bracket_before_len = rc.bracket_before_len + 1;
    ret R.ok_void[str]();
}

pub fun as_parsed(rr: *ResolveResult, a: *ast.Ast, eid: id.ExprId) O.Option[expr.Expr] {
    var i: usize = 0;
    for (i < rr.bracket_before_len) {
        if (rr.bracket_before[i].eid == eid) { ret O.some[expr.Expr](rr.bracket_before[i].node); }
        i = i + 1;
    }
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](opt_e)) { ret O.none[expr.Expr](); }
    ret O.some[expr.Expr](@O.unwrap[*expr.Expr](opt_e));
}

fun resolve_bracket_call(rc: *ResolveContext, eid: id.ExprId) R.Result[R.Void, str] {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret R.err[R.Void, str]("ExprId out of range"); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    val callee:          id.ExprId = e.data.call.callee;
    val index_callee:    id.ExprId = e.data.call.index_callee;
    val type_args_start: u32       = e.data.call.type_args_start;
    val type_args_len:   u32       = e.data.call.type_args_len;
    val args_start:      u32       = e.data.call.args_start;
    val args_len:        u32       = e.data.call.args_len;

    val rc_e: R.Result[R.Void, str] = bind_expr(rc, callee);
    if (R.is_err[R.Void, str](rc_e)) { ret rc_e; }

    if (callee_accepts_type_args(rc, callee)) {
        val sn0: R.Result[R.Void, str] = snapshot_bracket(rc, eid, e);
        if (R.is_err[R.Void, str](sn0)) { ret sn0; }
        e.data.call.index_callee = id.EXPR_NIL;
        ret bind_generic_call(rc, type_args_start, type_args_len, args_start, args_len);
    }

    val idx_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, index_callee);
    if (O.is_none[*expr.Expr](idx_opt)) { ret R.err[R.Void, str]("ExprId out of range"); }
    val idxn: *expr.Expr = O.unwrap[*expr.Expr](idx_opt);
    val rs: R.Result[R.Void, str] = bind_expr(rc, idxn.data.index.index);
    if (R.is_err[R.Void, str](rs)) { ret rs; }

    val sn1: R.Result[R.Void, str] = snapshot_bracket(rc, eid, e);
    if (R.is_err[R.Void, str](sn1)) { ret sn1; }
    e.data.call.callee          = index_callee;
    e.data.call.index_callee    = id.EXPR_NIL;
    e.data.call.type_args_start = 0;
    e.data.call.type_args_len   = 0;
    ret bind_expr_list(rc, args_start, args_len);
}

fun resolve_bracket_value(rc: *ResolveContext, eid: id.ExprId) R.Result[R.Void, str] {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret R.err[R.Void, str]("ExprId out of range"); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    val object:          id.ExprId = e.data.call.callee;
    val index_callee:    id.ExprId = e.data.call.index_callee;
    val type_args_start: u32       = e.data.call.type_args_start;
    val type_args_len:   u32       = e.data.call.type_args_len;
    val span:            token.Span = e.span;

    val ro: R.Result[R.Void, str] = bind_expr(rc, object);
    if (R.is_err[R.Void, str](ro)) { ret ro; }

    if (object_names_function(rc, object)) {
        e.data.call.index_callee = id.EXPR_NIL;
        ret bind_generic_call(rc, type_args_start, type_args_len, 0, 0);
    }

    if (index_callee == id.EXPR_NIL) {
        val re: R.Result[R.Void, str] = report(rc, span,
            "type arguments in value position name a generic instance, but this does not name a generic function");
        if (R.is_err[R.Void, str](re)) { ret re; }
        val sn: R.Result[R.Void, str] = snapshot_bracket(rc, eid, e);
        if (R.is_err[R.Void, str](sn)) { ret sn; }
        e.kind = expr.EXPR_KIND_ERROR;
        ret R.ok_void[str]();
    }

    val idx_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, index_callee);
    if (O.is_none[*expr.Expr](idx_opt)) { ret R.err[R.Void, str]("ExprId out of range"); }
    val idxn: *expr.Expr = O.unwrap[*expr.Expr](idx_opt);
    val rs: R.Result[R.Void, str] = bind_expr(rc, idxn.data.index.index);
    if (R.is_err[R.Void, str](rs)) { ret rs; }

    val idx_payload: expr.ExprIndex = idxn.data.index;
    val sn2: R.Result[R.Void, str] = snapshot_bracket(rc, eid, e);
    if (R.is_err[R.Void, str](sn2)) { ret sn2; }
    e.kind       = expr.EXPR_KIND_INDEX;
    e.data.index = idx_payload;
    ret R.ok_void[str]();
}

fun object_names_function(rc: *ResolveContext, object: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, object);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (e.kind != expr.EXPR_KIND_IDENT && e.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    if (rc.expr_resolved == nil)                                           { ret false; }
    val sid: SymbolId = rc.expr_resolved[object];
    if (sid == SYMBOL_NIL || sid >= rc.sym_len) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    if (sym.kind == SYM_FUN)      { ret true; }
    if (sym.kind != SYM_IMPORTED) { ret false; }
    val origin_ast: *ast.Ast = session.module_ast(rc.s, sym.origin);
    if (origin_ast == nil) { ret false; }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret false; }
    ret O.unwrap[*decl.Decl](opt_d).kind == decl.DECL_KIND_FUN;
}

fun bind_generic_call(rc: *ResolveContext, type_args_start: u32, type_args_len: u32, args_start: u32, args_len: u32) R.Result[R.Void, str] {
    var ti: u32 = 0;
    for (ti < type_args_len) {
        val arg_id: id.TypeId = rc.a.type_ids[type_args_start + ti];
        val rt: R.Result[R.Void, str] = bind_type(rc, arg_id);
        if (R.is_err[R.Void, str](rt)) { ret rt; }
        ti = ti + 1;
    }
    ret bind_expr_list(rc, args_start, args_len);
}

fun callee_accepts_type_args(rc: *ResolveContext, callee: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, callee);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (e.kind != expr.EXPR_KIND_IDENT && e.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    if (rc.expr_resolved == nil)                                           { ret false; }
    val sid: SymbolId = rc.expr_resolved[callee];
    if (sid == SYMBOL_NIL || sid >= rc.sym_len) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.kind == SYM_FUN || sym.kind == SYM_REC || sym.kind == SYM_UNI
     || sym.kind == SYM_DEF || sym.kind == SYM_GENERIC || sym.kind == SYM_PRIM
     || sym.kind == SYM_IMPORTED;
}

fun bind_ident(rc: *ResolveContext, eid: id.ExprId, span: token.Span) R.Result[R.Void, str] {
    val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, span);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r));
        ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r));
    }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](r);
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, name);
    if (sid == SYMBOL_NIL) {
        val re: R.Result[R.Void, str] = report_named(rc, span, "unresolved identifier `", name, "`");
        if (R.is_ok[R.Void, str](re)) { attach_suggestion(rc, span, name); }
    }
    or {
        if (rc.expr_resolved != nil) { rc.expr_resolved[eid] = sid; }
    }
    ret R.ok_void[str]();
}

fun attach_suggestion(rc: *ResolveContext, span: token.Span, target: intern.StrId) {
    val to: O.Option[str] = intern.lookup(?rc.s.interner, target);
    if (O.is_none[str](to)) { ret; }
    val tname: str = O.unwrap[str](to);
    val tlen: usize = str_len(tname);
    if (tlen == 0) { ret; }

    var best_sym:  SymbolId = SYMBOL_NIL;
    var best_dist: usize = MAX_SUGGEST_DISTANCE + 1;
    var max_dist:  usize = tlen / 2;
    if (max_dist > MAX_SUGGEST_DISTANCE) { max_dist = MAX_SUGGEST_DISTANCE; }

    var cur: ScopeId = rc.current_scope;
    for (cur != SCOPE_NIL) {
        val sc: *Scope = ?rc.scopes[cur];
        var i: u32 = 0;
        for (i < sc.len) {
            val cname_id: intern.StrId = sc.entries[i].name;
            if (cname_id != target) {
                val co: O.Option[str] = intern.lookup(?rc.s.interner, cname_id);
                if (O.is_some[str](co)) {
                    val cname: str = O.unwrap[str](co);
                    val dist: usize = edit_distance(tname, cname, best_dist);
                    if (dist <= max_dist && dist < best_dist) {
                        best_dist = dist;
                        best_sym  = sc.entries[i].sym;
                    }
                }
            }
            i = i + 1;
        }
        cur = rc.scopes[cur].parent;
    }

    if (best_sym == SYMBOL_NIL) { ret; }
    val bo: O.Option[str] = intern.lookup(?rc.s.interner, rc.symbols[best_sym].name);
    if (O.is_none[str](bo)) { ret; }
    val bname: str = O.unwrap[str](bo);

    val id_r: R.Result[diagnostic.DiagnosticId, str] = diagnostic.last_id(?rc.s.diags);
    if (R.is_err[diagnostic.DiagnosticId, str](id_r)) { ret; }
    val did: diagnostic.DiagnosticId = R.unwrap_ok[diagnostic.DiagnosticId, str](id_r);

    val note_r: R.Result[str, str] = diagnostic.suggestion_build(rc.s.alloc, bname);
    if (R.is_err[str, str](note_r)) { fail.internal(?rc.status, R.unwrap_err[str, str](note_r)); ret; }
    val note: str = R.unwrap_ok[str, str](note_r);
    diagnostic.record_help_committed(?rc.s.diags, did, note);

    val flabel_r: R.Result[str, str] = diagnostic.fix_label_replace(rc.s.alloc, bname);
    if (R.is_ok[str, str](flabel_r)) {
        val flabel: str = R.unwrap_ok[str, str](flabel_r);
        diagnostic.record_fix_committed(?rc.s.diags, did, flabel, rc.a.file_id, span, bname);
        str_free(rc.s.alloc, flabel);
    }
    str_free(rc.s.alloc, note);
}

fun report_named(rc: *ResolveContext, span: token.Span, prefix: str, name_id: intern.StrId, suffix: str) R.Result[R.Void, str] {
    val no: O.Option[str] = intern.lookup(?rc.s.interner, name_id);
    if (O.is_none[str](no)) {
        ret report(rc, span, prefix);
    }
    val name: str = O.unwrap[str](no);

    val pn: usize = str_len(prefix);
    val nn: usize = str_len(name);
    val sn: usize = str_len(suffix);
    val total: usize = pn + nn + sn;

    val r: R.Result[*char, str] = A.allocate[char](rc.s.alloc, total + 1);
    if (R.is_err[*char, str](r)) { fail.internal(?rc.status, R.unwrap_err[*char, str](r));
        ret R.err[R.Void, str](R.unwrap_err[*char, str](r));
    }
    val buf: str = R.unwrap_ok[*char, str](r);

    memory.raw_copy(buf::ptr, prefix::ptr, pn);
    memory.raw_copy((buf::usize + pn)::ptr, name::ptr, nn);
    memory.raw_copy((buf::usize + pn + nn)::ptr, suffix::ptr, sn);
    buf[total] = 0;

    val emit: R.Result[R.Void, str] = report(rc, span, buf);
    A.deallocate[char](rc.s.alloc, buf, total + 1);
    ret emit;
}

fun report_named2(rc: *ResolveContext, span: token.Span, prefix: str, a_id: intern.StrId, mid: str, b_id: intern.StrId, suffix: str) R.Result[R.Void, str] {
    val ao: O.Option[str] = intern.lookup(?rc.s.interner, a_id);
    val bo: O.Option[str] = intern.lookup(?rc.s.interner, b_id);
    if (O.is_none[str](ao) || O.is_none[str](bo)) {
        ret report(rc, span, prefix);
    }
    val a: str = O.unwrap[str](ao);
    val b: str = O.unwrap[str](bo);

    val pn: usize = str_len(prefix);
    val an: usize = str_len(a);
    val mn: usize = str_len(mid);
    val bn: usize = str_len(b);
    val sn: usize = str_len(suffix);
    val total: usize = pn + an + mn + bn + sn;

    val r: R.Result[*char, str] = A.allocate[char](rc.s.alloc, total + 1);
    if (R.is_err[*char, str](r)) { fail.internal(?rc.status, R.unwrap_err[*char, str](r));
        ret R.err[R.Void, str](R.unwrap_err[*char, str](r));
    }
    val buf: str = R.unwrap_ok[*char, str](r);

    var off: usize = 0;
    memory.raw_copy((buf::usize + off)::ptr, prefix::ptr, pn); off = off + pn;
    memory.raw_copy((buf::usize + off)::ptr, a::ptr, an);      off = off + an;
    memory.raw_copy((buf::usize + off)::ptr, mid::ptr, mn);    off = off + mn;
    memory.raw_copy((buf::usize + off)::ptr, b::ptr, bn);      off = off + bn;
    memory.raw_copy((buf::usize + off)::ptr, suffix::ptr, sn);
    buf[total] = 0;

    val emit: R.Result[R.Void, str] = report(rc, span, buf);
    A.deallocate[char](rc.s.alloc, buf, total + 1);
    ret emit;
}

val MAX_SUGGEST_DISTANCE: usize = 2;

fun edit_distance(a: str, b: str, cap: usize) usize {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    if (la == 0) { ret lb; }
    if (lb == 0) { ret la; }

    var prev: [128]usize;
    var curr: [128]usize;
    if (lb + 1 > SUGGEST_ROW) { ret cap + 1; }

    var j: usize = 0;
    for (j <= lb) { prev[j] = j; j = j + 1; }

    var i: usize = 1;
    for (i <= la) {
        curr[0] = i;
        var row_min: usize = i;
        var k: usize = 1;
        for (k <= lb) {
            var cost: usize = 1;
            if (a[i - 1] == b[k - 1]) { cost = 0; }
            var m: usize = prev[k] + 1;
            val del: usize = curr[k - 1] + 1;
            if (del < m) { m = del; }
            val sub: usize = prev[k - 1] + cost;
            if (sub < m) { m = sub; }
            curr[k] = m;
            if (m < row_min) { row_min = m; }
            k = k + 1;
        }
        if (row_min > cap) { ret cap + 1; }
        var t: usize = 0;
        for (t <= lb) { prev[t] = curr[t]; t = t + 1; }
        i = i + 1;
    }
    ret prev[lb];
}

val SUGGEST_ROW: usize = 128;

fun callee_is_offset_of(rc: *ResolveContext, callee: id.ExprId) bool {
    val ce_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, callee);
    if (O.is_none[*expr.Expr](ce_opt)) { ret false; }
    val ce: *expr.Expr = O.unwrap[*expr.Expr](ce_opt);
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret false; }

    val ns: token.Span = comptime.comptime_ident_name(ce.span);
    if (ns.len == 0) { ret false; }
    val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, ns);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret false; }
    ret R.unwrap_ok[intern.StrId, str](r) == interned_literal(rc, "offset_of");
}

fun bind_comptime_intrinsic_call(rc: *ResolveContext, c: *expr.ExprCall) O.Option[R.Result[R.Void, str]] {
    if (!callee_is_offset_of(rc, c.callee)) { ret O.none[R.Result[R.Void, str]](); }
    if (c.args_len < 1)                     { ret O.some[R.Result[R.Void, str]](R.ok_void[str]()); }

    val arg0: id.ExprId = rc.a.expr_ids[c.args_start];
    ret O.some[R.Result[R.Void, str]](bind_expr(rc, arg0));
}

fun bind_type_comparison(rc: *ResolveContext, bin: *expr.ExprBinary) R.Result[R.Void, str] {
    val rl: R.Result[R.Void, str] = bind_type_operand(rc, bin.lhs);
    if (R.is_err[R.Void, str](rl)) { ret rl; }
    ret bind_type_operand(rc, bin.rhs);
}

fun bind_type_operand(rc: *ResolveContext, operand: id.ExprId) R.Result[R.Void, str] {
    if (comptime.is_type_of_call(rc.a, rc.source, operand)) {
        val arg: id.ExprId = comptime.type_of_arg(rc.a, operand);
        if (arg == id.EXPR_NIL) { ret R.ok_void[str](); }
        ret bind_expr(rc, arg);
    }
    if (is_field_type_operand(rc, operand)) {
        val n_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, operand);
        if (O.is_none[*expr.Expr](n_opt)) { ret R.ok_void[str](); }
        ret bind_expr(rc, O.unwrap[*expr.Expr](n_opt).data.member.object);
    }
    ret bind_type_name_expr(rc, operand);
}

fun bind_type_name_expr(rc: *ResolveContext, eid: id.ExprId) R.Result[R.Void, str] {
    if (eid == id.EXPR_NIL) { ret R.ok_void[str](); }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret R.ok_void[str](); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    if (e.kind == expr.EXPR_KIND_IDENT) {
        val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, e.span);
        if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](r)); }
        val name: intern.StrId = R.unwrap_ok[intern.StrId, str](r);

        val rs: R.Result[TypeSpelling, str] = type_spelling(rc, name);
        if (R.is_err[TypeSpelling, str](rs)) { fail.internal(?rc.status, R.unwrap_err[TypeSpelling, str](rs)); ret R.err[R.Void, str](R.unwrap_err[TypeSpelling, str](rs)); }
        val sp: TypeSpelling = R.unwrap_ok[TypeSpelling, str](rs);

        if (sp.status == TYPE_SPELL_VEC_REFUSED) {
            ret report_vector_refused(rc, e.span, name, sp.form);
        }

        var sid: SymbolId = sp.sym;
        if (sid == SYMBOL_NIL) { sid = scope_lookup_chain(rc, rc.current_scope, name); }
        if (sid == SYMBOL_NIL) {
            val re: R.Result[R.Void, str] = report_named(rc, e.span, "unresolved type name `", name, "`");
            if (R.is_ok[R.Void, str](re)) { attach_suggestion(rc, e.span, name); }
        }
        or {
            if (rc.expr_resolved != nil) { rc.expr_resolved[eid] = sid; }
        }
        ret R.ok_void[str]();
    }

    if (e.kind == expr.EXPR_KIND_MEMBER) {
        val ro: R.Result[R.Void, str] = bind_expr(rc, e.data.member.object);
        if (R.is_err[R.Void, str](ro)) { ret ro; }
        ret bind_member_qualified(rc, eid, ?e.data.member);
    }

    ret bind_expr(rc, eid);
}

fun is_field_type_operand(rc: *ResolveContext, eid: id.ExprId) bool {
    if (!comptime.is_field_type_member(rc.a, rc.source, eid)) { ret false; }
    ret member_object_is_field_loopvar(rc, eid);
}

fun member_object_is_field_loopvar(rc: *ResolveContext, eid: id.ExprId) bool {
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret false; }
    val obj: id.ExprId = O.unwrap[*expr.Expr](n_opt).data.member.object;
    val o_opt: O.Option[*expr.Expr] = ast.get_expr(rc.a, obj);
    if (O.is_none[*expr.Expr](o_opt)) { ret false; }
    val oe: *expr.Expr = O.unwrap[*expr.Expr](o_opt);
    if (oe.kind != expr.EXPR_KIND_IDENT) { ret false; }
    val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, oe.span);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, R.unwrap_ok[intern.StrId, str](r));
    if (sid == SYMBOL_NIL) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.kind == SYM_VAL && (sym.flags & SYM_FLAG_COMPTIME) != 0;
}

fun ident_is_each_loopvar(rc: *ResolveContext, span: token.Span) bool {
    val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, span);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret false; }
    val sid: SymbolId = scope_lookup_chain(rc, rc.current_scope, R.unwrap_ok[intern.StrId, str](r));
    if (sid == SYMBOL_NIL) { ret false; }
    val sym: *Symbol = ?rc.symbols[sid];
    ret sym.kind == SYM_VAL && (sym.flags & SYM_FLAG_COMPTIME) != 0 && sym.decl == id.DECL_NIL;
}

fun interned_literal(rc: *ResolveContext, text: str) intern.StrId {
    val r: R.Result[intern.StrId, str] = intern.intern(?rc.s.interner, text);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](r);
}

fun bind_type(rc: *ResolveContext, tid: id.TypeId) R.Result[R.Void, str] {
    if (tid == id.TYPE_NIL) { ret R.ok_void[str](); }
    val t_opt: O.Option[*atype.Type] = ast.get_type(rc.a, tid);
    if (O.is_none[*atype.Type](t_opt)) { ret R.err[R.Void, str]("TypeId out of range"); }
    val t: *atype.Type = O.unwrap[*atype.Type](t_opt);

    if (t.kind == atype.TYPE_KIND_NAMED) {
        val sid: SymbolId = resolve_type_path(rc, ?t.data.named, t.span);
        if (rc.type_resolved != nil) { rc.type_resolved[tid] = sid; }
        var ai: u32 = 0;
        for (ai < t.data.named.args_len) {
            val arg_id: id.TypeId = rc.a.type_ids[t.data.named.args_start + ai];
            val r: R.Result[R.Void, str] = bind_type(rc, arg_id);
            if (R.is_err[R.Void, str](r)) { ret r; }
            ai = ai + 1;
        }
        ret R.ok_void[str]();
    }
    if (t.kind == atype.TYPE_KIND_PTR) {
        ret bind_type(rc, t.data.ptr.pointee);
    }
    if (t.kind == atype.TYPE_KIND_SECRET) {
        ret bind_type(rc, t.data.secret.inner);
    }
    if (t.kind == atype.TYPE_KIND_POINTEE_OF) {
        ret bind_type(rc, t.data.pointee_of.inner);
    }
    if (t.kind == atype.TYPE_KIND_FIELD_TYPE) {
        val fr: R.Result[intern.StrId, str] =
            intern.intern_span(?rc.s.interner, rc.source, t.data.field_type.var_name);
        if (R.is_err[intern.StrId, str](fr)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](fr)); ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](fr)); }
        val fsid: SymbolId = scope_lookup_chain(rc, rc.current_scope, R.unwrap_ok[intern.StrId, str](fr));
        if (fsid == SYMBOL_NIL) {
            ret report(rc, t.data.field_type.var_name,
                "`f.type` as a type argument names a `$each` field-descriptor loop variable; this name is not one in scope");
        }
        val fsym: *Symbol = ?rc.symbols[fsid];
        if (fsym.kind != SYM_VAL || (fsym.flags & SYM_FLAG_COMPTIME) == 0) {
            ret report(rc, t.data.field_type.var_name,
                "`f.type` as a type argument names a `$each` field-descriptor loop variable; this name is an ordinary binding");
        }
        ret R.ok_void[str]();
    }
    if (t.kind == atype.TYPE_KIND_ARRAY) {
        if (t.data.array.length != id.EXPR_NIL) {
            val re: R.Result[R.Void, str] = bind_expr(rc, t.data.array.length);
            if (R.is_err[R.Void, str](re)) { ret re; }
        }
        ret bind_type(rc, t.data.array.element);
    }
    if (t.kind == atype.TYPE_KIND_FUN) {
        var pi: u32 = 0;
        for (pi < t.data.fun_.params_len) {
            val pt: id.TypeId = rc.a.type_ids[t.data.fun_.params_start + pi];
            val r: R.Result[R.Void, str] = bind_type(rc, pt);
            if (R.is_err[R.Void, str](r)) { ret r; }
            pi = pi + 1;
        }
        ret bind_type(rc, t.data.fun_.ret_type);
    }
    if (t.kind == atype.TYPE_KIND_REC || t.kind == atype.TYPE_KIND_UNI) {
        var fields_start: u32 = 0;
        var fields_len:   u32 = 0;
        if (t.kind == atype.TYPE_KIND_REC) {
            fields_start = t.data.rec_.fields_start;
            fields_len   = t.data.rec_.fields_len;
        }
        or {
            fields_start = t.data.uni_.fields_start;
            fields_len   = t.data.uni_.fields_len;
        }
        var fi: u32 = 0;
        for (fi < fields_len) {
            val tn: *decl.TypedName = ?rc.a.typed_names[fields_start + fi];
            val r: R.Result[R.Void, str] = bind_type(rc, tn.ty);
            if (R.is_err[R.Void, str](r)) { ret r; }
            fi = fi + 1;
        }
        ret R.ok_void[str]();
    }
    ret R.ok_void[str]();
}

fun resolve_type_path(rc: *ResolveContext, named: *atype.TypeNamed, full: token.Span) SymbolId {
    val path: token.Span = named.name;
    if (path.len == 0) { ret SYMBOL_NIL; }

    var seg_start: usize = path.offset;
    val end:       usize = path.offset + path.len;
    var seg_end:   usize = seg_start;

    var current_module: session.ModuleId = session.MODULE_NIL;
    var current_sym:    SymbolId      = SYMBOL_NIL;
    var first:          bool          = true;

    for (seg_start < end) {
        seg_end = seg_start;
        for (seg_end < end && rc.source[seg_end] != '.') {
            seg_end = seg_end + 1;
        }
        var seg_span: token.Span;
        seg_span.offset = seg_start;
        seg_span.len    = seg_end - seg_start;

        val r: R.Result[intern.StrId, str] = intern.intern_span(?rc.s.interner, rc.source, seg_span);
        if (R.is_err[intern.StrId, str](r)) { fail.internal(?rc.status, R.unwrap_err[intern.StrId, str](r)); ret SYMBOL_NIL; }
        val seg_name: intern.StrId = R.unwrap_ok[intern.StrId, str](r);

        if (first) {
            val is_single: bool = seg_end >= end;
            if (is_single) {
                val rs: R.Result[TypeSpelling, str] = type_spelling(rc, seg_name);
                if (R.is_err[TypeSpelling, str](rs)) { fail.internal(?rc.status, R.unwrap_err[TypeSpelling, str](rs)); ret SYMBOL_NIL; }
                val sp: TypeSpelling = R.unwrap_ok[TypeSpelling, str](rs);
                if (sp.status == TYPE_SPELL_VEC_REFUSED) {
                    report_vector_refused(rc, full, seg_name, sp.form);
                    ret SYMBOL_NIL;
                }
                current_sym = sp.sym;
            }
            if (current_sym == SYMBOL_NIL) {
                current_sym = scope_lookup_chain(rc, rc.current_scope, seg_name);
            }
            first = false;
        }
        or {
            current_sym = lookup_in_module(rc, current_module, seg_name);
        }

        if (current_sym == SYMBOL_NIL) {
            if (seg_start == path.offset && seg_end >= end) {
                val re: R.Result[R.Void, str] = report_named(rc, full, "unresolved type name `", seg_name, "`");
                if (R.is_ok[R.Void, str](re)) { attach_suggestion(rc, full, seg_name); }
            }
            or {
                report_named(rc, full, "unresolved type name `", seg_name, "`");
            }
            ret SYMBOL_NIL;
        }

        if (seg_end >= end) { brk; }

        val sym: *Symbol = ?rc.symbols[current_sym];
        if (sym.kind == SYM_USE) {
            current_module = sym.slot::session.ModuleId;
        }
        or {
            record_report(rc, full, "expected a module alias before `.`");
            ret SYMBOL_NIL;
        }

        seg_start = seg_end + 1;
    }

    ret current_sym;
}

fun lookup_in_module(rc: *ResolveContext, m: session.ModuleId, name: intern.StrId) SymbolId {
    val mx: *ModuleExports = find_module_exports_by_module(rc, m);
    if (mx == nil) { ret SYMBOL_NIL; }
    val ps: *PublicSymbol = find_export(mx, name);
    if (ps == nil) { ret SYMBOL_NIL; }
    val sid_r: R.Result[SymbolId, str] = imported_symbol_for(rc, ps);
    if (R.is_err[SymbolId, str](sid_r)) { fail.internal(?rc.status, R.unwrap_err[SymbolId, str](sid_r)); ret SYMBOL_NIL; }
    ret R.unwrap_ok[SymbolId, str](sid_r);
}

fun remap_symbol_refs(refs: *SymbolId, len: u32, remap: *u32, sym_len: u32) {
    if (refs == nil) { ret; }
    var i: u32 = 0;
    for (i < len) {
        val sid: SymbolId = refs[i];
        if (sid != SYMBOL_NIL && sid::u32 < sym_len) {
            refs[i] = remap[sid::u32]::SymbolId;
        }
        i = i + 1;
    }
}

fun build_result(rc: *ResolveContext) R.Result[ResolveResult, fail.Fail] {
    if (rc.status.kind == fail.INTERNAL) {
        val message: str = rc.status.message;
        dnit_context(rc);
        ret R.err[ResolveResult, fail.Fail](fail.message(message));
    }
    var pub_count: u32 = 0;
    var i: u32 = 0;
    for (i < rc.sym_len) {
        if ((rc.symbols[i].flags & SYM_FLAG_PUB) != 0) {
            pub_count = pub_count + 1;
        }
        i = i + 1;
    }

    val r_syms: R.Result[*Symbol, str] = A.allocate[Symbol](rc.s.alloc, rc.sym_len::usize);
    if (R.is_err[*Symbol, str](r_syms)) { fail.internal(?rc.status, R.unwrap_err[*Symbol, str](r_syms));
        dnit_context(rc);
        ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[*Symbol, str](r_syms)));
    }
    val out_syms: *Symbol = R.unwrap_ok[*Symbol, str](r_syms);

    var remap: *u32 = nil;
    if (rc.sym_len > 0) {
        val r_remap: R.Result[*u32, str] = A.allocate[u32](rc.s.alloc, rc.sym_len::usize);
        if (R.is_err[*u32, str](r_remap)) { fail.internal(?rc.status, R.unwrap_err[*u32, str](r_remap));
            A.deallocate[Symbol](rc.s.alloc, out_syms, rc.sym_len::usize);
            dnit_context(rc);
            ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[*u32, str](r_remap)));
        }
        remap = R.unwrap_ok[*u32, str](r_remap);
    }

    var pi: u32 = 0;
    var ni: u32 = pub_count;
    var k:  u32 = 0;
    for (k < rc.sym_len) {
        if ((rc.symbols[k].flags & SYM_FLAG_PUB) != 0) {
            out_syms[pi] = rc.symbols[k];
            remap[k]     = pi;
            pi = pi + 1;
        }
        or {
            out_syms[ni] = rc.symbols[k];
            remap[k]     = ni;
            ni = ni + 1;
        }
        k = k + 1;
    }

    remap_symbol_refs(rc.expr_resolved, rc.a.expr_len::u32, remap, rc.sym_len);
    remap_symbol_refs(rc.type_resolved, rc.a.type_len::u32, remap, rc.sym_len);
    remap_symbol_refs(rc.decl_symbol,   rc.a.decl_len::u32, remap, rc.sym_len);

    if (remap != nil) { A.deallocate[u32](rc.s.alloc, remap, rc.sym_len::usize); }

    var si: u32 = 0;
    for (si < rc.sym_len) {
        val sym: *Symbol = ?out_syms[si];
        sym.origin_stable = stable_of_module(rc.s, sym.origin);
        if (sym.kind == SYM_USE) {
            sym.slot_stable = stable_of_module(rc.s, sym.slot::session.ModuleId);
        }
        or {
            sym.slot_stable = session.STABLE_MODULE_NIL;
        }
        si = si + 1;
    }

    var param_index: map.Map[u64, SymbolId] = map.init[u64, SymbolId](rc.s.alloc, map.hash_u64, map.eq_u64);
    var pk: u32 = 0;
    for (pk < rc.sym_len) {
        if (out_syms[pk].kind == SYM_PARAM) {
            val key: u64 = (out_syms[pk].decl::u64 << 32) | out_syms[pk].slot::u64;
            val ins: R.Result[bool, str] = map.insert[u64, SymbolId](?param_index, key, pk);
            if (R.is_err[bool, str](ins)) {
                map.dnit[u64, SymbolId](?param_index);
                A.deallocate[Symbol](rc.s.alloc, out_syms, rc.sym_len::usize);
                dnit_context(rc);
                ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[bool, str](ins)));
            }
        }
        pk = pk + 1;
    }

    var fp_len: u32 = 0;
    val fp_r: R.Result[*u8, str] = pub_const_fp_build(rc, out_syms, pub_count, ?fp_len);
    if (R.is_err[*u8, str](fp_r)) { fail.internal(?rc.status, R.unwrap_err[*u8, str](fp_r));
        map.dnit[u64, SymbolId](?param_index);
        A.deallocate[Symbol](rc.s.alloc, out_syms, rc.sym_len::usize);
        dnit_context(rc);
        ret R.err[ResolveResult, fail.Fail](fail.message(R.unwrap_err[*u8, str](fp_r)));
    }

    var out: ResolveResult;
    out.status        = rc.status;
    out.alloc         = rc.s.alloc;
    out.symbols       = out_syms;
    out.symbol_count  = rc.sym_len;
    out.pub_count     = pub_count;
    out.expr_resolved = rc.expr_resolved;
    out.type_resolved = rc.type_resolved;
    out.decl_symbol   = rc.decl_symbol;
    out.expr_count    = rc.a.expr_len::u32;
    out.type_count    = rc.a.type_len::u32;
    out.decl_count    = rc.a.decl_len::u32;
    out.param_index   = param_index;
    out.pub_const_fp     = R.unwrap_ok[*u8, str](fp_r);
    out.pub_const_fp_len = fp_len;

    out.bracket_before     = rc.bracket_before;
    out.bracket_before_len = rc.bracket_before_len;
    out.bracket_before_cap = rc.bracket_before_cap;

    rc.expr_resolved = nil;
    rc.type_resolved = nil;
    rc.decl_symbol   = nil;
    rc.bracket_before     = nil;
    rc.bracket_before_len = 0;
    rc.bracket_before_cap = 0;

    dnit_context(rc);
    ret R.ok[ResolveResult, fail.Fail](out);
}

val PUB_CONST_FP_ENTRY: u32 = 15;

fun ct_value_bits(v: *comptime.CTValue) u64 {
    if (v.kind == comptime.CT_KIND_STR)  { ret v.data.s::u64; }
    if (v.kind == comptime.CT_KIND_TYPE) { ret v.data.t::u64; }
    ret v.data.i::u64;
}

fun pub_const_fp_build(rc: *ResolveContext, syms: *Symbol, pub_count: u32, out_len: *u32) R.Result[*u8, str] {
    @out_len = 0;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < pub_count) {
        if (syms[i].kind == SYM_VAL && (syms[i].flags & SYM_FLAG_MODULE) != 0) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret R.ok[*u8, str](nil); }

    val total: u32 = n * PUB_CONST_FP_ENTRY;
    val r: R.Result[*u8, str] = A.allocate[u8](rc.s.alloc, total::usize);
    if (R.is_err[*u8, str](r)) { fail.internal(?rc.status, R.unwrap_err[*u8, str](r)); ret r; }
    val buf: *u8 = R.unwrap_ok[*u8, str](r);

    var off: u32 = 0;
    i = 0;
    for (i < pub_count) {
        val sym: *Symbol = ?syms[i];
        if (sym.kind == SYM_VAL && (sym.flags & SYM_FLAG_MODULE) != 0) {
            fp_put_u32(buf, off, sym.name::u32); off = off + 4;
            val nc: O.Option[comptime.NamedConst] = comptime.lookup(rc.ctx, sym.name);
            if (O.is_some[comptime.NamedConst](nc)) {
                var named: comptime.NamedConst = O.unwrap[comptime.NamedConst](nc);
                val v: *comptime.CTValue = ?named.value;
                buf[off] = v.kind::u8; off = off + 1;
                if (v.kind == comptime.CT_KIND_INT) {
                    if (v.int_unsigned) { buf[off] = 1; } or { buf[off] = 0; }
                    off = off + 1;
                    buf[off] = v.int_width; off = off + 1;
                }
                or {
                    buf[off] = 0; off = off + 1;
                    buf[off] = 0; off = off + 1;
                }
                fp_put_u64(buf, off, ct_value_bits(v)); off = off + 8;
            }
            or {
                buf[off] = 0xFF; off = off + 1;
                buf[off] = 0;    off = off + 1;
                buf[off] = 0;    off = off + 1;
                fp_put_u64(buf, off, 0); off = off + 8;
            }
        }
        i = i + 1;
    }

    @out_len = total;
    ret R.ok[*u8, str](buf);
}

fun fp_put_u32(buf: *u8, off: u32, v: u32) {
    buf[off]     = (v & 0xFF)::u8;
    buf[off + 1] = ((v >> 8) & 0xFF)::u8;
    buf[off + 2] = ((v >> 16) & 0xFF)::u8;
    buf[off + 3] = ((v >> 24) & 0xFF)::u8;
}

fun fp_put_u64(buf: *u8, off: u32, v: u64) {
    var j: u32 = 0;
    for (j < 8) {
        buf[off + j] = ((v >> (j * 8)) & 0xFF)::u8;
        j = j + 1;
    }
}

fun report(rc: *ResolveContext, span: token.Span, message: str) R.Result[R.Void, str] {
    fail.reject(?rc.status);
    ret diagnostic.error(?rc.s.diags, rc.a.file_id, span, message);
}

fun record_report(rc: *ResolveContext, span: token.Span, message: str) {
    val r: R.Result[R.Void, str] = report(rc, span, message);
    if (R.is_err[R.Void, str](r)) { fail.internal(?rc.status, R.unwrap_err[R.Void, str](r)); }
}
