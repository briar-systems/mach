# the attribute arguments that take a string, and the string each one is
#
# an argument is a constant expression evaluated in its module's comptime
# context: a literal, a `val`, a gated `val`, or an imported constant. the load
# evaluates each once, after its walk has bound every constant, and records the
# string in the session; every later reader takes it from there, so resolution,
# type checking, lowering and the link all read one value (#4022)
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use mach.lang.fe.comptime;
use mach.lang.intern;
use mach.lang.session;

# an attribute whose arguments from `first` on are strings, `count` of them, or
# every one from `first` on when `count` is 0
rec StringArgs {
    name:  str;
    first: u32;
    count: u32;
}

val STRING_ARGS_N: usize                     = 12;
val STRING_ARGS:   [STRING_ARGS_N]StringArgs = [STRING_ARGS_N]StringArgs{
    StringArgs{name: "deprecated", first: 0, count: 1},
    StringArgs{name: "symbol", first: 0, count: 1},
    StringArgs{name: "library", first: 0, count: 1},
    StringArgs{name: "section", first: 0, count: 1},
    StringArgs{name: "stage", first: 0, count: 1},
    StringArgs{name: "builtin", first: 0, count: 1},
    StringArgs{name: "embed", first: 0, count: 1},
    StringArgs{name: "expect", first: 0, count: 0},
    StringArgs{name: "op", first: 0, count: 3},
    StringArgs{name: "storage", first: 2, count: 0},
    StringArgs{name: "handle", first: 0, count: 2},
    StringArgs{name: "abi_type", first: 0, count: 1},
};

# whether argument `ord` of `dec` takes a string
fun takes_string(source: str, dec: *ast_decl.Decorator, ord: u32) bool {
    if (ord >= dec.args_len) { ret false; }
    var i: usize = 0;
    for (i < STRING_ARGS_N) {
        val row: StringArgs = STRING_ARGS[i];
        if (str_region_equals(source, dec.name.offset, dec.name.len, row.name)) {
            if (ord < row.first) { ret false; }
            ret row.count == 0 || ord - row.first < row.count;
        }
        i = i + 1;
    }
    ret false;
}

# the string argument `ord` of `dec` evaluated to; none when it is not a constant string
pub fun string_id(s: *session.Session, mid: session.ModuleId, a: *ast.Ast, dec: *ast_decl.Decorator, ord: u32) opt[intern.StrId] {
    if (ord >= dec.args_len) { ret opt[intern.StrId].none{}; }
    ret session.attr_string(s, mid, a.expr_ids[dec.args_start + ord]::u32);
}

# the text of `string_id`
pub fun string_of(s: *session.Session, mid: session.ModuleId, a: *ast.Ast, dec: *ast_decl.Decorator, ord: u32) opt[str] {
    val sid: opt[intern.StrId] = string_id(s, mid, a, dec, ord);
    if (sel sid.none) { ret opt[str].none{}; }
    ret intern.lookup(?s.interner, sid.some);
}

# records the string every string argument of a module's attributes evaluates
# to, with the phase's own evaluator over the module's comptime context. an
# argument that is not a constant string is left out; a declaration in an `$if`
# arm the load did not walk is skipped when `walked` asks for it
pub fun record_strings[T](s: *session.Session, mid: session.ModuleId, a: *ast.Ast, source: str,
    c: *comptime.ComptimeCtx, cap_ctx: *T, caps: comptime.PhaseCapabilities[T], walked: bool) err[fail.Fail] {
    val root: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel root.none) { ret err[fail.Fail].ok{}; }
    var w: Recorder[T] = Recorder[T]{s: s, mid: mid, a: a, source: source, c: c, cap_ctx: cap_ctx, caps: caps, walked: walked};
    ret record_list[T](?w, root.some.decls_start, root.some.decls_len);
}

# drops what `record_strings` recorded for a module whose tree has `expr_count` expressions
pub fun forget_strings(s: *session.Session, mid: session.ModuleId, expr_count: usize) {
    var e: usize = 0;
    for (e < expr_count) {
        session.forget_attr_string(s, mid, e::u32);
        e = e + 1;
    }
}

rec Recorder[T] {
    s:       *session.Session;
    mid:     session.ModuleId;
    a:       *ast.Ast;
    source:  str;
    c:       *comptime.ComptimeCtx;
    cap_ctx: *T;
    caps:    comptime.PhaseCapabilities[T];
    walked:  bool;
}

fun record_list[T](w: *Recorder[T], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: ast_id.DeclId = w.a.decl_ids[start + i];
        i = i + 1;
        if (w.walked && !comptime.load_walked(w.c, did)) { cnt; }
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(w.a, did);
        if (sel d_opt.none) { cnt; }
        val d: *ast_decl.Decl = d_opt.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val br: *ast_decl.ComptimeBranch = ?w.a.comptime_branches[d.data.comptime_if.branches_start + b];
                val r:  err[fail.Fail]           = record_list[T](w, br.body_start, br.body_len);
                if (sel r.err) { ret r; }
                b = b + 1;
            }
            cnt;
        }
        val r: err[fail.Fail] = record_decorators[T](w, d.decorators_start, d.decorators_len);
        if (sel r.err) { ret r; }
        if (d.kind == ast_decl.DECL_KIND_TAG) {
            var k: u32 = 0;
            for (k < d.data.tag_.cases_len) {
                val tc: *ast_decl.TagCase = ?w.a.tag_cases[d.data.tag_.cases_start + k];
                val rc: err[fail.Fail]    = record_decorators[T](w, tc.decorators_start, tc.decorators_len);
                if (sel rc.err) { ret rc; }
                k = k + 1;
            }
        }
    }
    ret err[fail.Fail].ok{};
}

fun record_decorators[T](w: *Recorder[T], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val dec: *ast_decl.Decorator = ?w.a.decorators[start + i];
        var k:   u32                 = 0;
        for (k < dec.args_len) {
            if (takes_string(w.source, dec, k)) {
                val eid: ast_id.ExprId                            = w.a.expr_ids[dec.args_start + k];
                val v:   res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[T](w.c, w.cap_ctx, w.caps, w.a, w.source, eid, ?w.s.interner);
                if (sel v.err) {
                    if (v.err.kind == comptime.EVAL_FAIL_INTERNAL) { ret err[fail.Fail].err{fail.message(v.err.message)}; }
                    k = k + 1;
                    cnt;
                }
                if (v.ok.kind == comptime.CT_KIND_STR) {
                    val rr: err[fail.Fail] = session.register_attr_string(w.s, w.mid, eid::u32, v.ok.data.s);
                    if (sel rr.err) { ret rr; }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
