# the lexis of an inline-asm body that the language owns: its `#` comments, and the
# `{name}` references that bind a local. everything else in the body is the instruction
# set's, and reaches its assembler as written
use mach.lang.fail;
use lang_source: mach.lang.source;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

pub def RefKind: u8;

# the body has no more braces
pub val REF_END: RefKind = 0;
# `{name}`, a local the block reads or writes
pub val REF_NAME: RefKind = 1;
# a brace group that is not one identifier, such as an aarch64 `{v0.16b}` register list,
# which belongs to the instruction set
pub val REF_OTHER: RefKind = 2;
# a `{` the body never closes
pub val REF_UNTERMINATED: RefKind = 3;
# `{}`
pub val REF_EMPTY: RefKind = 4;

# one brace group of a body: its kind and the text between its braces
pub rec Ref {
    kind:  RefKind;
    inner: lang_source.Span;
}

# the next brace group of `body` at or after `at`, outside any comment; `at` moves past it
# ---
# source: the text the body indexes
# body:   the body's span in `source`
# at:     the scan's offset into `source`, which starts at body.offset
pub fun ref_next(source: str, body: lang_source.Span, at: *usize) Ref {
    val end: usize = body.offset + body.len;
    var i:   usize = @at;
    for (i < end && source[i] != '{'::char) {
        if (source[i] == '#'::char) {
            for (i < end && source[i] != '\n'::char) { i = i + 1; }
            cnt;
        }
        i = i + 1;
    }
    if (i >= end) {
        @at = end;
        ret Ref{kind: REF_END, inner: lang_source.Span{offset: end, len: 0}};
    }
    val start: usize = i + 1;
    var j:     usize = start;
    for (j < end && source[j] != '}'::char) {
        if (source[j] == '#'::char) {
            for (j < end && source[j] != '\n'::char) { j = j + 1; }
            cnt;
        }
        j = j + 1;
    }
    val inner: lang_source.Span = lang_source.Span{offset: start, len: j - start};
    if (j >= end) {
        @at = end;
        ret Ref{kind: REF_UNTERMINATED, inner: inner};
    }
    @at = j + 1;
    if (inner.len == 0)          { ret Ref{kind: REF_EMPTY, inner: inner}; }
    if (!name_is(source, inner)) { ret Ref{kind: REF_OTHER, inner: inner}; }
    ret Ref{kind: REF_NAME, inner: inner};
}

fun name_is(source: str, span: lang_source.Span) bool {
    var i: usize = span.offset;
    for (i < span.offset + span.len) {
        val c:     u8   = source[i]::u8;
        val alpha: bool = (c >= 'a'::u8 && c <= 'z'::u8) || (c >= 'A'::u8 && c <= 'Z'::u8) || c == '_'::u8;
        val digit: bool = c >= '0'::u8 && c <= '9'::u8;
        if (!alpha && !(digit && i > span.offset)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the body with its comments removed, the text an assembler reads; owned by `a`, body.len + 1
# bytes
pub fun comments_strip(a: *A.Allocator, source: str, body: lang_source.Span) res[str, fail.Fail] {
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, body.len + 1);
    if (sel res_buf.err) { ret res[str, fail.Fail].err{fail.refused(res_buf.err)}; }
    val out: *u8 = res_buf.ok;

    var i: usize = 0;
    var o: usize = 0;
    for (i < body.len) {
        val c: u8 = source[body.offset + i];
        if (c == '#'::char) {
            for (i < body.len && source[body.offset + i] != '\n'::char) { i = i + 1; }
            cnt;
        }
        out[o] = c;
        o      = o + 1;
        i      = i + 1;
    }
    out[o] = 0;
    ret res[str, fail.Fail].ok{out::str};
}

#[testing]
fun t_kinds(text: str, out: *RefKind, cap: usize) usize {
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = 0;
    for (text[span.len] != 0) { span.len = span.len + 1; }
    var at: usize = 0;
    var n:  usize = 0;
    for (n < cap) {
        val r: Ref = ref_next(text, span, ?at);
        if (r.kind == REF_END) { brk; }
        out[n] = r.kind;
        n      = n + 1;
    }
    ret n;
}

test ref_next__names_other_groups_and_comments {
    var k: [4]RefKind;
    var n: usize = t_kinds("mov rax, {x} # {y}\nld1 {v0.16b}, [{p_2}]", ?k[0], 4);
    if (n != 3)                                                    { ret 1; }
    if (k[0] != REF_NAME || k[1] != REF_OTHER || k[2] != REF_NAME) { ret 2; }
    n = t_kinds("mov rax, {}", ?k[0], 4);
    if (n != 1 || k[0] != REF_EMPTY) { ret 3; }
    n = t_kinds("mov rax, {x", ?k[0], 4);
    if (n != 1 || k[0] != REF_UNTERMINATED) { ret 4; }
    ret 0;
}
