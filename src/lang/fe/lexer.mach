use mach.lang.build.outcome;
use page: std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;

use A: std.allocator;

use mach.lang.diagnostic;
use mach.lang.fe.pool;
use mach.lang.fe.token;
use src: mach.lang.source;

pub def LexErrorCode: u8;

pub val LEX_ERR_UNEXPECTED_CHAR:   LexErrorCode = 1;
pub val LEX_ERR_UNTERMINATED_STR:  LexErrorCode = 2;
pub val LEX_ERR_UNTERMINATED_CHAR: LexErrorCode = 3;
pub val LEX_ERR_CONTROL_CHAR:      LexErrorCode = 4;

pub rec LexError {
    span: token.Span;
    code: LexErrorCode;
}

pub rec CommentRun {
    span:       token.Span;
    start_line: usize;
    end_line:   usize;
}

pub rec TokenStream {
    tokens: *token.Token;
    len:    usize;
    cap:    usize;

    source:  str;
    file_id: src.FileId;

    errors:    *LexError;
    error_len: usize;
    error_cap: usize;

    comments:    *CommentRun;
    comment_len: usize;
    comment_cap: usize;
}

val INITIAL_TOKEN_CAP:   usize = 256;
val INITIAL_ERROR_CAP:   usize = 8;
val INITIAL_COMMENT_CAP: usize = 16;

pub fun tokenize(source: str, alloc: *A.Allocator, file_id: src.FileId) res[TokenStream, fail.Fail] {
    var stream: TokenStream;
    stream.tokens      = nil;
    stream.len         = 0;
    stream.cap         = 0;
    stream.source      = source;
    stream.file_id     = file_id;
    stream.errors      = nil;
    stream.error_len   = 0;
    stream.error_cap   = 0;
    stream.comments    = nil;
    stream.comment_len = 0;
    stream.comment_cap = 0;

    var pos:  usize = 0;
    var line: usize = 1;
    for (source[pos] != 0) {
        val c: u8 = source[pos];

        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            val ws_nl: usize = newline_len(source, pos);
            if (ws_nl > 0) { line = line + 1; pos = pos + ws_nl; }
            or { pos = pos + 1; }
            cnt;
        }

        if (c == '#' && source[pos + 1] != '[') {
            val comment_start: usize = pos;
            val comment_line:  usize = line;
            for (source[pos] != 0 && newline_len(source, pos) == 0) {
                pos = pos + 1;
            }
            val res_comment: err[fail.Fail] = comment_add(?stream, alloc, comment_start, pos, comment_line);
            if (sel res_comment.err) {
                dnit(?stream, alloc);
                ret res[TokenStream, fail.Fail].err{res_comment.err};
            }
            cnt;
        }

        var tok: token.Token;

        val punct: token.Kind = punct_kind(c);
        if (punct != token.KIND_ERROR) {
            tok = token.make(punct, pos, 1);
            pos = pos + 1;
        }
        or (c == '#') {
            tok = token.make(token.KIND_ATTR_OPEN, pos, 2);
            pos = pos + 2;
        }
        or (c == ':') {
            if (source[pos + 1] == ':') {
                tok = token.make(token.KIND_COLON_COLON, pos, 2);
                pos = pos + 2;
            }
            or (source[pos + 1] == '~') {
                tok = token.make(token.KIND_COLON_TILDE, pos, 2);
                pos = pos + 2;
            }
            or (source[pos + 1] == '^') {
                tok = token.make(token.KIND_COLON_CARET, pos, 2);
                pos = pos + 2;
            }
            or (source[pos + 1] == '>') {
                tok = token.make(token.KIND_COLON_GT, pos, 2);
                pos = pos + 2;
            }
            or {
                tok = token.make(token.KIND_COLON, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '.') {
            if (source[pos + 1] == '.' && source[pos + 2] == '.') {
                tok = token.make(token.KIND_DOT_DOT_DOT, pos, 3);
                pos = pos + 3;
            }
            or {
                tok = token.make(token.KIND_DOT, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '=') {
            if (source[pos + 1] == '=') {
                tok = token.make(token.KIND_EQ_EQ, pos, 2);
                pos = pos + 2;
            }
            or {
                tok = token.make(token.KIND_EQ, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '!') {
            if (source[pos + 1] == '=') {
                tok = token.make(token.KIND_BANG_EQ, pos, 2);
                pos = pos + 2;
            }
            or {
                tok = token.make(token.KIND_BANG, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '<') {
            if (source[pos + 1] == '=') {
                tok = token.make(token.KIND_LT_EQ, pos, 2);
                pos = pos + 2;
            }
            or (source[pos + 1] == '<') {
                tok = token.make(token.KIND_LT_LT, pos, 2);
                pos = pos + 2;
            }
            or {
                tok = token.make(token.KIND_LT, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '>') {
            if (source[pos + 1] == '=') {
                tok = token.make(token.KIND_GT_EQ, pos, 2);
                pos = pos + 2;
            }
            or (source[pos + 1] == '>') {
                tok = token.make(token.KIND_GT_GT, pos, 2);
                pos = pos + 2;
            }
            or {
                tok = token.make(token.KIND_GT, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '&') {
            if (source[pos + 1] == '&') {
                tok = token.make(token.KIND_AMP_AMP, pos, 2);
                pos = pos + 2;
            }
            or {
                tok = token.make(token.KIND_AMP, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '|') {
            if (source[pos + 1] == '|') {
                tok = token.make(token.KIND_PIPE_PIPE, pos, 2);
                pos = pos + 2;
            }
            or {
                tok = token.make(token.KIND_PIPE, pos, 1);
                pos = pos + 1;
            }
        }
        or (c == '"') {
            val start: usize = pos;
            pos = pos + 1;
            for (source[pos] != 0 && source[pos] != '"' && newline_len(source, pos) == 0) {
                if (source[pos] == '\\' && source[pos + 1] != 0 && newline_len(source, pos + 1) == 0) {
                    pos = pos + 2;
                    cnt;
                }
                pos = pos + 1;
            }
            if (source[pos] == '"') {
                pos = pos + 1;
            }
            or {
                val res_err: err[fail.Fail] = error_add(?stream, alloc, start, pos - start, LEX_ERR_UNTERMINATED_STR);
                if (sel res_err.err) {
                    dnit(?stream, alloc);
                    ret res[TokenStream, fail.Fail].err{res_err.err};
                }
            }
            tok = token.make(token.KIND_LIT_STR, start, pos - start);
        }
        or (c == '\'') {
            val start: usize = pos;
            pos = pos + 1;
            for (source[pos] != 0 && source[pos] != '\'' && newline_len(source, pos) == 0) {
                if (source[pos] == '\\' && source[pos + 1] != 0 && newline_len(source, pos + 1) == 0) {
                    pos = pos + 2;
                    cnt;
                }
                pos = pos + 1;
            }
            if (source[pos] == '\'') {
                pos = pos + 1;
            }
            or {
                val res_err: err[fail.Fail] = error_add(?stream, alloc, start, pos - start, LEX_ERR_UNTERMINATED_CHAR);
                if (sel res_err.err) {
                    dnit(?stream, alloc);
                    ret res[TokenStream, fail.Fail].err{res_err.err};
                }
            }
            tok = token.make(token.KIND_LIT_CHAR, start, pos - start);
        }
        or (c >= '0' && c <= '9') {
            val start:    usize = pos;
            var is_float: bool  = false;

            if (c == '0' && source[pos + 1] == 'x') {
                pos = pos + 2;
                for (is_hex_char(source[pos]) || source[pos] == '_') {
                    pos = pos + 1;
                }
            }
            or (c == '0' && source[pos + 1] == 'b') {
                pos = pos + 2;
                for (source[pos] == '0' || source[pos] == '1' || source[pos] == '_') {
                    pos = pos + 1;
                }
            }
            or (c == '0' && source[pos + 1] == 'o') {
                pos = pos + 2;
                for (source[pos] >= '0' && source[pos] <= '7' || source[pos] == '_') {
                    pos = pos + 1;
                }
            }
            or {
                for (source[pos] >= '0' && source[pos] <= '9' || source[pos] == '_') {
                    pos = pos + 1;
                }
                if (source[pos] == '.' && source[pos + 1] >= '0' && source[pos + 1] <= '9') {
                    is_float = true;
                    pos = pos + 1;
                    for (source[pos] >= '0' && source[pos] <= '9' || source[pos] == '_') {
                        pos = pos + 1;
                    }
                }
                if (is_exponent_start(source, pos)) {
                    is_float = true;
                    pos = pos + 1;
                    if (source[pos] == '+' || source[pos] == '-') {
                        pos = pos + 1;
                    }
                    for (source[pos] >= '0' && source[pos] <= '9' || source[pos] == '_') {
                        pos = pos + 1;
                    }
                }
            }

            if (is_float) {
                if (source[pos] == 'f') {
                    pos = pos + 1;
                    for (source[pos] >= '0' && source[pos] <= '9') {
                        pos = pos + 1;
                    }
                }
                tok = token.make(token.KIND_LIT_FLOAT, start, pos - start);
            }
            or {
                if (source[pos] == 'u' || source[pos] == 'i' || source[pos] == 'f') {
                    pos = pos + 1;
                    for (source[pos] >= '0' && source[pos] <= '9') {
                        pos = pos + 1;
                    }
                }
                tok = token.make(token.KIND_LIT_INT, start, pos - start);
            }
        }
        or (is_ident_start(c)) {
            val start: usize = pos;
            for (is_ident_char(source[pos])) {
                pos = pos + 1;
            }
            tok = token.make(token.KIND_IDENT, start, pos - start);
        }
        or {
            tok = token.make(token.KIND_ERROR, pos, 1);
            var code: LexErrorCode = LEX_ERR_UNEXPECTED_CHAR;
            if (c < 0x20 || c == 0x7f) { code = LEX_ERR_CONTROL_CHAR; }
            val res_err: err[fail.Fail] = error_add(?stream, alloc, pos, 1, code);
            if (sel res_err.err) {
                dnit(?stream, alloc);
                ret res[TokenStream, fail.Fail].err{res_err.err};
            }
            pos = pos + 1;
        }

        val res_push: err[fail.Fail] = token_add(?stream, alloc, tok);
        if (sel res_push.err) {
            dnit(?stream, alloc);
            ret res[TokenStream, fail.Fail].err{res_push.err};
        }
    }

    val res_eof: err[fail.Fail] = token_add(?stream, alloc, token.make(token.KIND_EOF, pos, 0));
    if (sel res_eof.err) {
        dnit(?stream, alloc);
        ret res[TokenStream, fail.Fail].err{res_eof.err};
    }

    ret res[TokenStream, fail.Fail].ok{stream};
}

pub fun dnit(stream: *TokenStream, alloc: *A.Allocator) {
    if (stream == nil) { ret; }
    if (stream.tokens != nil && stream.cap > 0) {
        A.deallocate[token.Token](alloc, stream.tokens, stream.cap);
    }
    if (stream.errors != nil && stream.error_cap > 0) {
        A.deallocate[LexError](alloc, stream.errors, stream.error_cap);
    }
    if (stream.comments != nil && stream.comment_cap > 0) {
        A.deallocate[CommentRun](alloc, stream.comments, stream.comment_cap);
    }
    stream.tokens      = nil;
    stream.len         = 0;
    stream.cap         = 0;
    stream.errors      = nil;
    stream.error_len   = 0;
    stream.error_cap   = 0;
    stream.comments    = nil;
    stream.comment_len = 0;
    stream.comment_cap = 0;
}

pub fun doc_run_above(stream: *TokenStream, decl_offset: usize) token.Span {
    var empty: token.Span;
    empty.offset = 0;
    empty.len    = 0;

    var i: usize = stream.comment_len;
    for (i > 0) {
        i = i - 1;
        val run:     *CommentRun = ?stream.comments[i];
        val run_end: usize       = run.span.offset + run.span.len;
        if (run_end > decl_offset) { cnt; }
        if (comment_starts_line(stream.source, run.span.offset)
            && layout_only(stream.source, run_end, decl_offset)
            && newlines_capped(stream.source, run_end, decl_offset) == 1) { ret run.span; }
        ret empty;
    }
    ret empty;
}

pub fun emit_diagnostics(stream: *TokenStream, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var i: usize = 0;
    for (i < stream.error_len) {
        val e:   *LexError           = ?stream.errors[i];
        val text: opt[str] = error_message(e.code);
        if (sel text.none) { ret err[fail.Fail].err{fail.message("unknown LexErrorCode tag in the lexer's diagnostics")}; }
        val outcome: err[fail.Fail] = diagnostic.error(diags, stream.file_id, e.span, text.some);
        if (sel outcome.err) { ret outcome; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun token_add(stream: *TokenStream, alloc: *A.Allocator, tok: token.Token) err[fail.Fail] {
    if (stream.len == stream.cap) {
        val res_grow: res[*token.Token, A.Error] = pool.grow[token.Token](alloc, stream.tokens, stream.cap, INITIAL_TOKEN_CAP, ?stream.cap);
        if (sel res_grow.err) {
            ret err[fail.Fail].err{fail.refused(res_grow.err)};
        }
        stream.tokens = res_grow.ok;
    }
    stream.tokens[stream.len] = tok;
    stream.len = stream.len + 1;
    ret err[fail.Fail].ok{};
}

fun error_add(stream: *TokenStream, alloc: *A.Allocator, offset: usize, len: usize, code: LexErrorCode) err[fail.Fail] {
    if (stream.error_len == stream.error_cap) {
        val res_grow: res[*LexError, A.Error] = pool.grow[LexError](alloc, stream.errors, stream.error_cap, INITIAL_ERROR_CAP, ?stream.error_cap);
        if (sel res_grow.err) {
            ret err[fail.Fail].err{fail.refused(res_grow.err)};
        }
        stream.errors = res_grow.ok;
    }

    var e: LexError;
    e.span.offset = offset;
    e.span.len    = len;
    e.code        = code;
    stream.errors[stream.error_len] = e;
    stream.error_len = stream.error_len + 1;
    ret err[fail.Fail].ok{};
}

# a comment is on its own line when only layout precedes it on that line
fun comment_starts_line(source: str, offset: usize) bool {
    var i: usize = offset;
    for (i > 0) {
        i = i - 1;
        if (source[i] == '\n' || source[i] == '\r') { ret true; }
        if (source[i] != ' ' && source[i] != '\t') { ret false; }
    }
    ret true;
}

fun layout_only(source: str, start: usize, end: usize) bool {
    var i: usize = start;
    for (i < end) {
        val c: u8 = source[i];
        if (c != ' ' && c != '\t' && c != '\n' && c != '\r') { ret false; }
        i = i + 1;
    }
    ret true;
}

# a run is consecutive own-line comments; a trailing comment neither starts
# nor extends one, so code between two comments never joins them
fun comment_add(stream: *TokenStream, alloc: *A.Allocator, start: usize, end: usize, line: usize) err[fail.Fail] {
    if (stream.comment_len > 0) {
        val last: *CommentRun = ?stream.comments[stream.comment_len - 1];
        if (line == last.end_line + 1
            && comment_starts_line(stream.source, last.span.offset)
            && comment_starts_line(stream.source, start)
            && layout_only(stream.source, last.span.offset + last.span.len, start)) {
            last.span.len = end - last.span.offset;
            last.end_line = line;
            ret err[fail.Fail].ok{};
        }
    }

    if (stream.comment_len == stream.comment_cap) {
        val res_grow: res[*CommentRun, A.Error] = pool.grow[CommentRun](alloc, stream.comments, stream.comment_cap, INITIAL_COMMENT_CAP, ?stream.comment_cap);
        if (sel res_grow.err) {
            ret err[fail.Fail].err{fail.refused(res_grow.err)};
        }
        stream.comments = res_grow.ok;
    }

    var run: CommentRun;
    run.span.offset = start;
    run.span.len    = end - start;
    run.start_line  = line;
    run.end_line    = line;
    stream.comments[stream.comment_len] = run;
    stream.comment_len = stream.comment_len + 1;
    ret err[fail.Fail].ok{};
}

# the diagnostic text of a lex error; absent for a code outside the catalog
fun error_message(code: LexErrorCode) opt[str] {
    if (code == LEX_ERR_UNTERMINATED_STR)  { ret opt[str].some{"unterminated string literal"}; }
    if (code == LEX_ERR_UNTERMINATED_CHAR) { ret opt[str].some{"unterminated character literal"}; }
    if (code == LEX_ERR_CONTROL_CHAR)      { ret opt[str].some{"stray control character in source; only printable ASCII and whitespace are allowed"}; }
    if (code == LEX_ERR_UNEXPECTED_CHAR)   { ret opt[str].some{"unexpected character; only ASCII source text is supported"}; }
    ret opt[str].none{};
}

fun newline_len(source: str, pos: usize) usize {
    val c: u8 = source[pos];
    if (c == '\n') { ret 1; }
    if (c == '\r') {
        if (source[pos + 1] == '\n') { ret 2; }
        ret 1;
    }
    ret 0;
}

fun newlines_capped(source: str, start: usize, end: usize) usize {
    var n: usize = 0;
    var i: usize = start;
    for (i < end && source[i] != 0) {
        val nl: usize = newline_len(source, i);
        if (nl > 0) {
            n = n + 1;
            if (n == 2) { ret 2; }
            i = i + nl;
            cnt;
        }
        i = i + 1;
    }
    ret n;
}

fun punct_kind(c: u8) token.Kind {
    if (c == '(') { ret token.KIND_LPAREN; }
    if (c == ')') { ret token.KIND_RPAREN; }
    if (c == '{') { ret token.KIND_LBRACE; }
    if (c == '}') { ret token.KIND_RBRACE; }
    if (c == '[') { ret token.KIND_LBRACKET; }
    if (c == ']') { ret token.KIND_RBRACKET; }
    if (c == ';') { ret token.KIND_SEMI; }
    if (c == ',') { ret token.KIND_COMMA; }
    if (c == '?') { ret token.KIND_QUESTION; }
    if (c == '@') { ret token.KIND_AT; }
    if (c == '$') { ret token.KIND_DOLLAR; }
    if (c == '~') { ret token.KIND_TILDE; }
    if (c == '+') { ret token.KIND_PLUS; }
    if (c == '-') { ret token.KIND_MINUS; }
    if (c == '*') { ret token.KIND_STAR; }
    if (c == '/') { ret token.KIND_SLASH; }
    if (c == '%') { ret token.KIND_PERCENT; }
    if (c == '^') { ret token.KIND_CARET; }
    if (c == '`') { ret token.KIND_BACKTICK; }
    ret token.KIND_ERROR;
}

fun is_exponent_start(source: str, pos: usize) bool {
    if (source[pos] != 'e' && source[pos] != 'E') {
        ret false;
    }
    var next: usize = pos + 1;
    if (source[next] == '+' || source[next] == '-') {
        next = next + 1;
    }
    ret source[next] >= '0' && source[next] <= '9';
}

fun is_ident_start(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

fun is_ident_char(c: u8) bool {
    ret is_ident_start(c) || (c >= '0' && c <= '9');
}

fun is_hex_char(c: u8) bool {
    ret (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

test "mach.lang.fe.lexer.emit_diagnostics:drains_to_sink" {
    var alloc: A.Allocator;
    val made_1: err[A.Error] = page.make(?alloc);
    if (sel made_1.err) { ret 1; }

    val tr: res[TokenStream, fail.Fail] = tokenize("a \\ b", ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: TokenStream = tr.ok;
    if (stream.error_len == 0) { dnit(?stream, ?alloc); ret 1; }

    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    val er: err[fail.Fail] = emit_diagnostics(?stream, ?diags);
    if (sel er.err) { dnit(?stream, ?alloc); diagnostic.store_dnit(?diags); ret 1; }

    if (diagnostic.len(?diags) != stream.error_len)                        { dnit(?stream, ?alloc); diagnostic.store_dnit(?diags); ret 1; }
    if (diags.items.data[0].severity != diagnostic.SEVERITY_ERROR) { dnit(?stream, ?alloc); diagnostic.store_dnit(?diags); ret 1; }
    if (diags.items.data[0].loc.span.offset != 2)                  { dnit(?stream, ?alloc); diagnostic.store_dnit(?diags); ret 1; }

    diagnostic.store_dnit(?diags);
    dnit(?stream, ?alloc);
    ret 0;
}

test "mach.lang.fe.lexer.tokenize:radix_prefix_spans" {
    var alloc: A.Allocator;
    val made_2: err[A.Error] = page.make(?alloc);
    if (sel made_2.err) { ret 1; }

    val tr: res[TokenStream, fail.Fail] = tokenize("0b1010 0o755 0xFF", ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: TokenStream = tr.ok;

    var rc: i32 = 0;
    if (stream.len != 4)       { rc = 1; }
    or (stream.error_len != 0) { rc = 1; }
    or {
        if (stream.tokens[0].kind != token.KIND_LIT_INT) { rc = 1; }
        or (stream.tokens[0].span.offset != 0)           { rc = 1; }
        or (stream.tokens[0].span.len    != 6)           { rc = 1; }
        or (stream.tokens[1].kind != token.KIND_LIT_INT) { rc = 1; }
        or (stream.tokens[1].span.offset != 7)           { rc = 1; }
        or (stream.tokens[1].span.len    != 5)           { rc = 1; }
        or (stream.tokens[2].kind != token.KIND_LIT_INT) { rc = 1; }
        or (stream.tokens[2].span.len    != 4)           { rc = 1; }
    }

    dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:backtick" {
    var alloc: A.Allocator;
    val made_3: err[A.Error] = page.make(?alloc);
    if (sel made_3.err) { ret 1; }

    val tr: res[TokenStream, fail.Fail] = tokenize("`", ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: TokenStream = tr.ok;

    var rc: i32 = 0;
    if (stream.len != 2)       { rc = 1; }
    or (stream.error_len != 0) { rc = 1; }
    or {
        if (stream.tokens[0].kind != token.KIND_BACKTICK) { rc = 1; }
        or (stream.tokens[0].span.offset != 0)            { rc = 1; }
        or (stream.tokens[0].span.len    != 1)            { rc = 1; }
    }

    dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:attr_open_vs_comment" {
    var alloc: A.Allocator;
    val made_4: err[A.Error] = page.make(?alloc);
    if (sel made_4.err) { ret 1; }

    val tr1: res[TokenStream, fail.Fail] = tokenize("#[", ?alloc, 0::src.FileId);
    if (sel tr1.err) { ret 1; }
    var s1: TokenStream = tr1.ok;
    var rc: i32 = 0;
    if (s1.len != 2)       { rc = 1; }
    or (s1.error_len != 0) { rc = 1; }
    or {
        if (s1.tokens[0].kind != token.KIND_ATTR_OPEN) { rc = 1; }
        or (s1.tokens[0].span.offset != 0)             { rc = 1; }
        or (s1.tokens[0].span.len    != 2)             { rc = 1; }
    }
    dnit(?s1, ?alloc);
    if (rc != 0) { ret rc; }

    val tr2: res[TokenStream, fail.Fail] = tokenize("# [not an attr]", ?alloc, 0::src.FileId);
    if (sel tr2.err) { ret 1; }
    var s2: TokenStream = tr2.ok;
    if (s2.len != 1)                         { rc = 1; }
    or (s2.tokens[0].kind != token.KIND_EOF) { rc = 1; }
    dnit(?s2, ?alloc);
    if (rc != 0) { ret rc; }

    val tr3: res[TokenStream, fail.Fail] = tokenize("# comment\nval", ?alloc, 0::src.FileId);
    if (sel tr3.err) { ret 1; }
    var s3: TokenStream = tr3.ok;
    if (s3.tokens[0].kind != token.KIND_IDENT) { rc = 1; }
    dnit(?s3, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:char_literal_recovery" {
    var alloc: A.Allocator;
    val made_5: err[A.Error] = page.make(?alloc);
    if (sel made_5.err) { ret 1; }

    val tr1: res[TokenStream, fail.Fail] = tokenize("'a'", ?alloc, 0::src.FileId);
    if (sel tr1.err) { ret 1; }
    var s1: TokenStream = tr1.ok;
    var rc: i32 = 0;
    if (s1.tokens[0].kind     != token.KIND_LIT_CHAR) { rc = 1; }
    or (s1.tokens[0].span.len != 3)                   { rc = 1; }
    or (s1.error_len          != 0)                   { rc = 1; }
    dnit(?s1, ?alloc);
    if (rc != 0) { ret rc; }

    val tr2: res[TokenStream, fail.Fail] = tokenize("'\\n'", ?alloc, 0::src.FileId);
    if (sel tr2.err) { ret 1; }
    var s2: TokenStream = tr2.ok;
    if (s2.tokens[0].kind     != token.KIND_LIT_CHAR) { rc = 1; }
    or (s2.tokens[0].span.len != 4)                   { rc = 1; }
    or (s2.error_len          != 0)                   { rc = 1; }
    dnit(?s2, ?alloc);
    if (rc != 0) { ret rc; }

    val tr3: res[TokenStream, fail.Fail] = tokenize("'x\nval b: u8 = 1;", ?alloc, 0::src.FileId);
    if (sel tr3.err) { ret 1; }
    var s3: TokenStream = tr3.ok;
    if (s3.error_len      != 1)                         { rc = 1; }
    or (s3.errors[0].code != LEX_ERR_UNTERMINATED_CHAR) { rc = 1; }
    or (s3.tokens[1].kind != token.KIND_IDENT)          { rc = 1; }
    dnit(?s3, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:string_unterminated_at_newline" {
    var alloc: A.Allocator;
    val made_6: err[A.Error] = page.make(?alloc);
    if (sel made_6.err) { ret 1; }

    val tr: res[TokenStream, fail.Fail] = tokenize("\"line one\nval b: u8 = 1;", ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: TokenStream = tr.ok;

    if (stream.error_len != 1)                             { dnit(?stream, ?alloc); ret 1; }
    if (stream.errors[0].code != LEX_ERR_UNTERMINATED_STR) { dnit(?stream, ?alloc); ret 1; }
    if (stream.tokens[0].kind != token.KIND_LIT_STR) { dnit(?stream, ?alloc); ret 1; }
    if (stream.tokens[0].span.len != 9)              { dnit(?stream, ?alloc); ret 1; }
    if (stream.tokens[1].kind != token.KIND_IDENT) { dnit(?stream, ?alloc); ret 1; }

    dnit(?stream, ?alloc);
    ret 0;
}

test "mach.lang.fe.lexer.comment_add:run_folding" {
    var alloc: A.Allocator;
    val made_7: err[A.Error] = page.make(?alloc);
    if (sel made_7.err) { ret 1; }

    val tr: res[TokenStream, fail.Fail] = tokenize("# a\n# b\n\n# c\nval x: i64 = 1;", ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: TokenStream = tr.ok;

    var rc: i32 = 0;
    if (stream.comment_len != 2) { rc = 1; }
    or {
        if (stream.comments[0].start_line != 1)  { rc = 1; }
        or (stream.comments[0].end_line  != 2)   { rc = 1; }
        or (stream.comments[0].span.offset != 0) { rc = 1; }
        or (stream.comments[0].span.len  != 7)   { rc = 1; }
        or (stream.comments[1].start_line != 4) { rc = 1; }
        or (stream.comments[1].end_line  != 4)  { rc = 1; }
    }

    dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.doc_run_above:skips_attribute_lines" {
    var alloc: A.Allocator;
    val made_8: err[A.Error] = page.make(?alloc);
    if (sel made_8.err) { ret 1; }

    val source: str = "# the doc\n#[inline]\npub fun f() {}";
    val tr: res[TokenStream, fail.Fail] = tokenize(source, ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: TokenStream = tr.ok;

    var rc: i32 = 0;
    if (stream.comment_len != 1) { rc = 1; }
    or {
        val attr_off: usize = stream.tokens[0].span.offset;
        if (stream.tokens[0].kind != token.KIND_ATTR_OPEN) { rc = 1; }
        or (attr_off != 10)                                { rc = 1; }
        or {
            val span: token.Span = doc_run_above(?stream, attr_off);
            if (span.len == 0)    { rc = 1; }
            or (span.offset != 0) { rc = 1; }
            or (span.len != 9)    { rc = 1; }
        }
        val none_span: token.Span = doc_run_above(?stream, 999);
        if (none_span.len != 0) { rc = 1; }
    }

    dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:colon_caret_adjacency" {
    var alloc: A.Allocator;
    val made_9: err[A.Error] = page.make(?alloc);
    if (sel made_9.err) { ret 1; }

    val tr1: res[TokenStream, fail.Fail] = tokenize("k:^", ?alloc, 0::src.FileId);
    if (sel tr1.err) { ret 1; }
    var s1: TokenStream = tr1.ok;
    var rc: i32 = 0;
    if (s1.len != 3)       { rc = 1; }
    or (s1.error_len != 0) { rc = 1; }
    or {
        if (s1.tokens[0].kind != token.KIND_IDENT)       { rc = 1; }
        or (s1.tokens[1].kind != token.KIND_COLON_CARET) { rc = 1; }
        or (s1.tokens[1].span.offset != 1)               { rc = 1; }
        or (s1.tokens[1].span.len    != 2)               { rc = 1; }
        or (s1.tokens[2].kind != token.KIND_EOF)         { rc = 1; }
    }
    dnit(?s1, ?alloc);
    if (rc != 0) { ret rc; }

    val tr2: res[TokenStream, fail.Fail] = tokenize("k: ^[32]u8", ?alloc, 0::src.FileId);
    if (sel tr2.err) { ret 1; }
    var s2: TokenStream = tr2.ok;
    if (s2.error_len != 0) { rc = 1; }
    or {
        if (s2.tokens[0].kind != token.KIND_IDENT) { rc = 1; }
        or (s2.tokens[1].kind != token.KIND_COLON) { rc = 1; }
        or (s2.tokens[2].kind != token.KIND_CARET) { rc = 1; }
    }
    dnit(?s2, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:colon_gt_adjacency" {
    var alloc: A.Allocator;
    val made_10: err[A.Error] = page.make(?alloc);
    if (sel made_10.err) { ret 1; }
    var rc: i32 = 0;

    val tr1: res[TokenStream, fail.Fail] = tokenize("k:>u32", ?alloc, 0::src.FileId);
    if (sel tr1.err) { ret 1; }
    var s1: TokenStream = tr1.ok;
    if (s1.len != 4)       { rc = 1; }
    or (s1.error_len != 0) { rc = 1; }
    or {
        if (s1.tokens[0].kind != token.KIND_IDENT)    { rc = 1; }
        or (s1.tokens[1].kind != token.KIND_COLON_GT) { rc = 1; }
        or (s1.tokens[1].span.offset != 1)            { rc = 1; }
        or (s1.tokens[1].span.len    != 2)            { rc = 1; }
        or (s1.tokens[2].kind != token.KIND_IDENT)    { rc = 1; }
        or (s1.tokens[3].kind != token.KIND_EOF)      { rc = 1; }
    }
    dnit(?s1, ?alloc);
    if (rc != 0) { ret rc; }

    val tr2: res[TokenStream, fail.Fail] = tokenize("k: >u32", ?alloc, 0::src.FileId);
    if (sel tr2.err) { ret 1; }
    var s2: TokenStream = tr2.ok;
    if (s2.error_len != 0) { rc = 1; }
    or {
        if (s2.tokens[0].kind != token.KIND_IDENT) { rc = 1; }
        or (s2.tokens[1].kind != token.KIND_COLON) { rc = 1; }
        or (s2.tokens[2].kind != token.KIND_GT)    { rc = 1; }
        or (s2.tokens[3].kind != token.KIND_IDENT) { rc = 1; }
    }
    dnit(?s2, ?alloc);
    if (rc != 0) { ret rc; }

    val tr3: res[TokenStream, fail.Fail] = tokenize("a:>=b", ?alloc, 0::src.FileId);
    if (sel tr3.err) { ret 1; }
    var s3: TokenStream = tr3.ok;
    if (s3.error_len != 0) { rc = 1; }
    or {
        if (s3.tokens[1].kind != token.KIND_COLON_GT) { rc = 1; }
        or (s3.tokens[2].kind != token.KIND_EQ)       { rc = 1; }
    }
    dnit(?s3, ?alloc);
    if (rc != 0) { ret rc; }

    val tr4: res[TokenStream, fail.Fail] = tokenize("a:>>b", ?alloc, 0::src.FileId);
    if (sel tr4.err) { ret 1; }
    var s4: TokenStream = tr4.ok;
    if (s4.error_len != 0) { rc = 1; }
    or {
        if (s4.tokens[1].kind != token.KIND_COLON_GT) { rc = 1; }
        or (s4.tokens[2].kind != token.KIND_GT)       { rc = 1; }
    }
    dnit(?s4, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:newline_forms_end_comments" {
    var alloc: A.Allocator;
    val made_11: err[A.Error] = page.make(?alloc);
    if (sel made_11.err) { ret 1; }
    var rc: i32 = 0;

    val tr_lf: res[TokenStream, fail.Fail] = tokenize("# a\nval", ?alloc, 0::src.FileId);
    if (sel tr_lf.err) { ret 1; }
    var s_lf: TokenStream = tr_lf.ok;
    if (s_lf.comment_len != 1)              { rc = 1; }
    or (s_lf.comments[0].span.offset != 0)  { rc = 1; }
    or (s_lf.comments[0].span.len    != 3)  { rc = 1; }
    or (s_lf.error_len != 0)                { rc = 1; }
    or (s_lf.tokens[0].kind != token.KIND_IDENT) { rc = 1; }
    or (s_lf.tokens[0].span.offset != 4)    { rc = 1; }
    dnit(?s_lf, ?alloc);
    if (rc != 0) { ret rc; }

    val tr_crlf: res[TokenStream, fail.Fail] = tokenize("# a\r\nval", ?alloc, 0::src.FileId);
    if (sel tr_crlf.err) { ret 1; }
    var s_crlf: TokenStream = tr_crlf.ok;
    if (s_crlf.comment_len != 1)             { rc = 1; }
    or (s_crlf.comments[0].span.offset != 0) { rc = 1; }
    or (s_crlf.comments[0].span.len    != 3) { rc = 1; }
    or (s_crlf.error_len != 0)               { rc = 1; }
    or (s_crlf.tokens[0].kind != token.KIND_IDENT) { rc = 1; }
    or (s_crlf.tokens[0].span.offset != 5)   { rc = 1; }
    dnit(?s_crlf, ?alloc);
    if (rc != 0) { ret rc; }

    val tr_cr: res[TokenStream, fail.Fail] = tokenize("# a\rval", ?alloc, 0::src.FileId);
    if (sel tr_cr.err) { ret 1; }
    var s_cr: TokenStream = tr_cr.ok;
    if (s_cr.comment_len != 1)              { rc = 1; }
    or (s_cr.comments[0].span.offset != 0)  { rc = 1; }
    or (s_cr.comments[0].span.len    != 3)  { rc = 1; }
    or (s_cr.error_len != 0)                { rc = 1; }
    or (s_cr.tokens[0].kind != token.KIND_IDENT) { rc = 1; }
    or (s_cr.tokens[0].span.offset != 4)    { rc = 1; }
    dnit(?s_cr, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:newline_forms_increment_line_once" {
    var alloc: A.Allocator;
    val made_12: err[A.Error] = page.make(?alloc);
    if (sel made_12.err) { ret 1; }
    var rc: i32 = 0;

    val tr_lf: res[TokenStream, fail.Fail] = tokenize("# a\n# b\n\n# c\nval", ?alloc, 0::src.FileId);
    if (sel tr_lf.err) { ret 1; }
    var s_lf: TokenStream = tr_lf.ok;
    if (s_lf.comment_len != 2)             { rc = 1; }
    or (s_lf.comments[0].start_line != 1)  { rc = 1; }
    or (s_lf.comments[0].end_line   != 2)  { rc = 1; }
    or (s_lf.comments[1].start_line != 4)  { rc = 1; }
    dnit(?s_lf, ?alloc);
    if (rc != 0) { ret rc; }

    val tr_crlf: res[TokenStream, fail.Fail] = tokenize("# a\r\n# b\r\n\r\n# c\r\nval", ?alloc, 0::src.FileId);
    if (sel tr_crlf.err) { ret 1; }
    var s_crlf: TokenStream = tr_crlf.ok;
    if (s_crlf.comment_len != 2)             { rc = 1; }
    or (s_crlf.comments[0].start_line != 1)  { rc = 1; }
    or (s_crlf.comments[0].end_line   != 2)  { rc = 1; }
    or (s_crlf.comments[1].start_line != 4)  { rc = 1; }
    dnit(?s_crlf, ?alloc);
    if (rc != 0) { ret rc; }

    val tr_cr: res[TokenStream, fail.Fail] = tokenize("# a\r# b\r\r# c\rval", ?alloc, 0::src.FileId);
    if (sel tr_cr.err) { ret 1; }
    var s_cr: TokenStream = tr_cr.ok;
    if (s_cr.comment_len != 2)             { rc = 1; }
    or (s_cr.comments[0].start_line != 1)  { rc = 1; }
    or (s_cr.comments[0].end_line   != 2)  { rc = 1; }
    or (s_cr.comments[1].start_line != 4)  { rc = 1; }
    dnit(?s_cr, ?alloc);
    ret rc;
}

test "mach.lang.fe.lexer.tokenize:string_unterminated_at_bare_cr" {
    var alloc: A.Allocator;
    val made_13: err[A.Error] = page.make(?alloc);
    if (sel made_13.err) { ret 1; }

    val tr: res[TokenStream, fail.Fail] = tokenize("\"line one\rval b: u8 = 1;", ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: TokenStream = tr.ok;

    if (stream.error_len != 1)                             { dnit(?stream, ?alloc); ret 1; }
    if (stream.errors[0].code != LEX_ERR_UNTERMINATED_STR) { dnit(?stream, ?alloc); ret 1; }
    if (stream.tokens[0].kind != token.KIND_LIT_STR) { dnit(?stream, ?alloc); ret 1; }
    if (stream.tokens[0].span.len != 9)              { dnit(?stream, ?alloc); ret 1; }
    if (stream.tokens[1].kind != token.KIND_IDENT) { dnit(?stream, ?alloc); ret 1; }

    dnit(?stream, ?alloc);
    ret 0;
}

test "mach.lang.fe.lexer.comments:trailing_comments_never_capture_intervening_code" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val text: str = "val a: i32 = 1; # first\nval b: i32 = 2; # second\nval c: i32 = 3;\n";
    val parsed: res[TokenStream, fail.Fail] = tokenize(text, ?alloc, 0);
    if (sel parsed.err) { ret 1; }
    var stream: TokenStream = parsed.ok;
    fin { dnit(?stream, ?alloc); }
    if (stream.comment_len != 2) { ret 2; }
    if (stream.comments[0].span.len != 7 || stream.comments[1].span.len != 8) { ret 3; }
    var i: usize = 0;
    for (i < stream.len) {
        if (doc_run_above(?stream, stream.tokens[i].span.offset).len != 0) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.fe.lexer.comments:standalone_documentation_requires_a_clear_gap" {
    var alloc: A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val text: str = "# first\n# second\n#[inline]\npub fun f() {}\nval a: i32 = 0;\n";
    val parsed: res[TokenStream, fail.Fail] = tokenize(text, ?alloc, 0);
    if (sel parsed.err) { ret 1; }
    var stream: TokenStream = parsed.ok;
    fin { dnit(?stream, ?alloc); }
    if (stream.comment_len != 1 || stream.comments[0].span.len != 16) { ret 2; }
    val attached: token.Span = doc_run_above(?stream, stream.tokens[0].span.offset);
    if (attached.offset != 0 || attached.len != 16) { ret 3; }
    if (doc_run_above(?stream, stream.tokens[stream.len - 2].span.offset).len != 0) { ret 4; }
    val blocked_r: res[TokenStream, fail.Fail] = tokenize("# summary\nval a:i32=0; val b:i32=1;", ?alloc, 0);
    if (sel blocked_r.err) { ret 5; }
    var blocked: TokenStream = blocked_r.ok;
    fin { dnit(?blocked, ?alloc); }
    if (doc_run_above(?blocked, blocked.tokens[0].span.offset).len == 0) { ret 6; }
    if (doc_run_above(?blocked, blocked.tokens[7].span.offset).len != 0) { ret 7; }
    ret 0;
}
