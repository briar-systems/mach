use std.types.bool.bool;

val CROSS: u32 = 4000000000u32;

fun cross_comptime_kind() u8 {
    $if ($type_of(4000000000u32) == u32) { ret 1; }
    $or                                  { ret 0; }
}

fun signed_comptime_kind() u8 {
    $if ($type_of(1i8) == i8) { ret 1; }
    $or                       { ret 0; }
}

fun float_comptime_kind() u8 {
    $if ($type_of(1.5f32) == f32) { ret 1; }
    $or                           { ret 0; }
}

fun unsuffixed_comptime_kind() u8 {
    $if ($type_of(1) == i64) { ret 1; }
    $or                      { ret 0; }
}

fun sink(va: ...) u32 {
    var acc: u32 = 0;
    $each a in va { acc = acc + a; }
    ret acc;
}

#[noinline]
fun through_u32(x: u32) u32 { ret x; }

#[noinline]
fun through_f32(x: f32) f32 { ret x; }

test "mach.lang.fe.literal_suffix:unsigned_widths" {
    val a: u8  = 255u8;
    val b: u16 = 65535u16;
    val c: u32 = 4294967295u32;
    val d: u64 = 18446744073709551615u64;
    if (a != 255)                    { ret 1; }
    if (b != 65535)                  { ret 2; }
    if (c != 4294967295)             { ret 3; }
    if (d != 18446744073709551615)   { ret 4; }
    ret 0;
}

test "mach.lang.fe.literal_suffix:signed_widths" {
    val a: i8  = -128i8;
    val b: i16 = -32768i16;
    val c: i32 = -2147483648i32;
    val d: i64 = 9223372036854775807i64;
    val e: i8  = 127i8;
    if (a != -128)                  { ret 1; }
    if (b != -32768)                { ret 2; }
    if (c != -2147483648)           { ret 3; }
    if (d != 9223372036854775807)   { ret 4; }
    if (e != 127)                   { ret 5; }
    ret 0;
}

test "mach.lang.fe.literal_suffix:float_widths" {
    val a: f32 = 0.1f32;
    val b: f64 = 0.1f64;
    val c: f32 = 1.5f32;
    val d: f64 = 2.0f64;
    if (a::f64 == b) { ret 1; }
    if (c != 1.5)    { ret 2; }
    if (d != 2.0)    { ret 3; }
    if (through_f32(0.5f32) != 0.5) { ret 4; }
    ret 0;
}

test "mach.lang.fe.literal_suffix:radix_forms_carry_the_suffix" {
    val a: u8  = 0xFFu8;
    val b: u16 = 0b1010u16;
    val c: u32 = 0o755u32;
    val d: u32 = 1_000_000u32;
    val e: f32 = 1.5e2f32;
    if (a != 255)     { ret 1; }
    if (b != 10)      { ret 2; }
    if (c != 493)     { ret 3; }
    if (d != 1000000) { ret 4; }
    if (e != 150.0)   { ret 5; }
    val f: f32 = 1e0f32;
    if (f != 1.0)     { ret 6; }
    ret 0;
}

test "mach.lang.fe.literal_suffix:cross_phase_agreement" {
    if (cross_comptime_kind() != 1)  { ret 1; }
    if (signed_comptime_kind() != 1) { ret 2; }
    if (float_comptime_kind() != 1)  { ret 3; }
    if (unsuffixed_comptime_kind() != 1) { ret 7; }

    val folded: u32 = 4000000000u32 - 1000000000u32;
    if (folded != 3000000000) { ret 4; }

    if (through_u32(CROSS) != 4000000000) { ret 5; }
    if (CROSS - 1u32 != 3999999999)       { ret 6; }

    val mixed: u32 = 7u32 + 1;
    if (mixed != 8)                       { ret 8; }
    if (7u32::u64 != 7)                   { ret 9; }
    ret 0;
}

test "mach.lang.fe.literal_suffix:unsuffixed_literals_still_take_their_context" {
    val a: u8  = 255;
    val b: i16 = -32768;
    val c: f32 = 1.5;
    var d: u32 = 7;
    d = d + 1;
    if (a != 255)   { ret 1; }
    if (b != -32768) { ret 2; }
    if (c != 1.5)   { ret 3; }
    if (d != 8)     { ret 4; }
    ret 0;
}

test "mach.lang.fe.literal_suffix:pack_tail_elements_take_the_suffix" {
    if (sink(7u32, 8u32) != 15)   { ret 1; }
    if (sink(7::u32, 8::u32) != 15) { ret 2; }
    ret 0;
}
