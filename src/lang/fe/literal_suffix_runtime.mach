use std.types.size.usize;

#[testing]
val CROSS: u32 = 4000000000u32;

#[testing]
fun cross_comptime_kind() u8 {
    $if ($type_of(4000000000u32) == u32) { ret 1; }
    $or                                  { ret 0; }
}

#[testing]
fun signed_comptime_kind() u8 {
    $if ($type_of(1i8) == i8) { ret 1; }
    $or                       { ret 0; }
}

#[testing]
fun float_comptime_kind() u8 {
    $if ($type_of(1.5f32) == f32) { ret 1; }
    $or                           { ret 0; }
}

#[testing]
fun unsuffixed_comptime_kind() u8 {
    $if ($type_of(1) == i64) { ret 1; }
    $or                      { ret 0; }
}

#[testing]
fun sink(va: ...) u32 {
    var acc: u32 = 0;
    $each a in va { acc = acc + a; }
    ret acc;
}

#[testing]
#[noinline]
fun through_u32(x: u32) u32 {
    ret x;
}

#[testing]
#[noinline]
fun through_f32(x: f32) f32 {
    ret x;
}

#[testing]
val CAST_2P64: u128 = 18446744073709551616::u128;

#[testing]
val CAST_1E19: u128 = 10000000000000000000::u128;

#[testing]
val CAST_NEG_2P64: i128 = (-18446744073709551616)::i128;

#[testing]
val CAST_U128_MAX: u128 = 340282366920938463463374607431768211455::u128;

#[testing]
val CAST_I128_MAX: i128 = 170141183460469231731687303715884105727::i128;

#[testing]
val CAST_I128_MIN: i128 = (-170141183460469231731687303715884105728)::i128;

#[testing]
#[noinline]
fun through_u128(x: u128) u128 {
    ret x;
}

#[testing]
#[noinline]
fun through_i128(x: i128) i128 {
    ret x;
}

#[testing]
#[noinline]
fun through_u64(x: u64) u64 {
    ret x;
}

#[testing]
fun cast_comptime_exact() u8 {
    $if (18446744073709551616::u128 == 18446744073709551616u128 && (-18446744073709551616)::i128 == -18446744073709551616i128) { ret 1; }
    $or                                                                                                                        { ret 0; }
}

test suffix__extremes_radix_and_float_width {
    val umax: u64 = 18446744073709551615u64;
    val imin: i8  = -128i8;
    val imax: i64 = 9223372036854775807i64;
    if (umax != 18446744073709551615) { ret 1; }
    if (imin != -128)                 { ret 2; }
    if (imax != 9223372036854775807)  { ret 3; }
    val a: f32 = 0.1f32;
    val b: f64 = 0.1f64;
    if (a::f64 == b)                { ret 4; }
    if (through_f32(0.5f32) != 0.5) { ret 5; }
    val h: u8  = 0xFFu8;
    val o: u32 = 0o755u32;
    val e: f32 = 1.5e2f32;
    if (h != 255)   { ret 6; }
    if (o != 493)   { ret 7; }
    if (e != 150.0) { ret 8; }
    ret 0;
}

test suffix__cross_phase_agreement {
    if (cross_comptime_kind() != 1)      { ret 1; }
    if (signed_comptime_kind() != 1)     { ret 2; }
    if (float_comptime_kind() != 1)      { ret 3; }
    if (unsuffixed_comptime_kind() != 1) { ret 7; }

    val folded: u32 = 4000000000u32 - 1000000000u32;
    if (folded != 3000000000) { ret 4; }

    if (through_u32(CROSS) != 4000000000) { ret 5; }
    if (CROSS - 1u32 != 3999999999)       { ret 6; }

    val mixed: u32 = 7u32 + 1;
    if (mixed != 8)     { ret 8; }
    if (7u32::u64 != 7) { ret 9; }
    ret 0;
}

test suffix__pack_tail_elements_take_it {
    if (sink(7u32, 8u32) != 15)     { ret 1; }
    if (sink(7::u32, 8::u32) != 15) { ret 2; }
    ret 0;
}

# `::` converts an untyped literal's exact value, then extends or truncates it
# to the target as it would any value; folded and at run time (#4179)
test cast__untyped_literal_keeps_its_exact_value {
    if (cast_comptime_exact() != 1) { ret 1; }

    if (CAST_2P64 != 18446744073709551616u128)                         { ret 2; }
    if (CAST_1E19 != 10000000000000000000u128)                         { ret 3; }
    if (CAST_NEG_2P64 != -18446744073709551616i128)                    { ret 4; }
    if (CAST_U128_MAX != 340282366920938463463374607431768211455u128)  { ret 5; }
    if (CAST_I128_MAX != 170141183460469231731687303715884105727i128)  { ret 6; }
    if (CAST_I128_MIN != -170141183460469231731687303715884105728i128) { ret 7; }

    if (through_u128(18446744073709551616::u128) != 18446744073709551616u128)                                           { ret 8; }
    if (through_u128(10000000000000000000::u128) != 10000000000000000000u128)                                           { ret 9; }
    if (through_i128((-18446744073709551616)::i128) != -18446744073709551616i128)                                       { ret 10; }
    if (through_u128(340282366920938463463374607431768211455::u128) != 340282366920938463463374607431768211455u128)     { ret 11; }
    if (through_i128(170141183460469231731687303715884105727::i128) != 170141183460469231731687303715884105727i128)     { ret 12; }
    if (through_i128((-170141183460469231731687303715884105728)::i128) != -170141183460469231731687303715884105728i128) { ret 13; }

    # the resize is unchanged: a negative extends to the unsigned maximum, a wide value truncates
    if (through_u64((-1)::u64) != 18446744073709551615u64)   { ret 14; }
    if (through_u64((-1)::usize) != 18446744073709551615u64) { ret 15; }
    if (through_u64(18446744073709551616::u64) != 0)         { ret 16; }
    ret 0;
}

#[testing]
val SHL_2P100: u128 = 1 << 100;

#[testing]
val WRAP_MAX: usize = 0 - 1;

#[testing]
val WRAP_MASK: u64 = ~7;

# a literal expression takes its context type and runs at it: a shift wider than
# i64 is exact, and `0 - 1` and `~7` still wrap to the unsigned maximum and mask (#4183)
test context__literal_expression_runs_at_its_context_type {
    if (SHL_2P100 != 1267650600228229401496703205376u128)              { ret 1; }
    if (through_u128(1 << 100) != 1267650600228229401496703205376u128) { ret 2; }
    if (through_u128((1 << 100)::u128) != SHL_2P100)                   { ret 3; }
    if (WRAP_MAX != 18446744073709551615u64)                           { ret 4; }
    if (through_u64(0 - 1) != 18446744073709551615u64)                 { ret 5; }
    if (WRAP_MASK != 18446744073709551608u64)                          { ret 6; }
    if (through_u64(~7) != 18446744073709551608u64)                    { ret 7; }
    ret 0;
}
