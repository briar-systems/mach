    ret legacy_unit(reinfer_instance_body_typed(s, a, rr, deps, ctx, own_module, sema_result, fn_ret, body, subst, subst_len, diags));
}

pub fun sema_typed(
    s:          *session.Session,
    a:          *ast.Ast,
    rr:         *resolve.ResolveResult,
    deps:       *context.SemaDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    diags:      *diagnostic.DiagnosticStore
) res[context.SemaResult, fail.Fail] {
    var sc: context.SemaContext;
    var uni_reports: context.UniReports;
    uni_reports.len = 0;

    val res_init: err[fail.Fail] = init_context(?sc, s, a, rr, deps, ctx, own_module, diags);
    if (sel res_init.err) {
        ret res[context.SemaResult, fail.Fail].err{res_init.err};
    }

    val res_embeds: err[fail.Fail] = resolve_all_embeds(?sc);
    if (sel res_embeds.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{res_embeds.err};
    }

    val res_types: err[fail.Fail] = resolve_all_types(?sc);
    if (sel res_types.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{res_types.err};
    }

    val res_decls: err[fail.Fail] = infer_all_decls(?sc);
    if (sel res_decls.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{res_decls.err};
    }

    val res_occurs: err[fail.Fail] = infer.check_occurs_all(?sc);
    if (sel res_occurs.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{res_occurs.err};
    }

    val res_uni_secrecy: err[fail.Fail] = infer.check_uni_secrecy_all(?sc);
    if (sel res_uni_secrecy.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{res_uni_secrecy.err};
    }

    check_handle_fields_all(?sc);

    sc.has_secret  = context.recover[bool](?sc, generics.module_reaches_secret(s, sc.type_resolved_ty, a.type_len::u32), false);
    sc.uni_reports = ?uni_reports;
    check_annotation_uni_secrecy_all(?sc);

    val caps_r: res[comptime.PhaseCapabilities[context.SemaContext], fail.Fail] = semantic_type_caps(diags);
    if (sel caps_r.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{caps_r.err};
    }
    sc.caps = caps_r.ok;
    val res_bodies: err[fail.Fail] = infer_all_bodies(?sc);
    if (sel res_bodies.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{res_bodies.err};
    }

    val res_reval: err[fail.Fail] = drain_revalidations(?sc);
    context.inst_worklist_dnit(?sc);
    if (sel res_reval.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{res_reval.err};
    }

    val notices: err[fail.Fail] = warn_deprecated_uses(?sc);
    if (sel notices.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{notices.err};
    }

    ret build_result(?sc);
}

pub fun resolve_gates_typed(
    s:          *session.Session,
    a:          *ast.Ast,
    rr:         *resolve.ResolveResult,
    deps:       *context.SemaDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    diags:      *diagnostic.DiagnosticStore
) res[context.SemaResult, fail.Fail] {
    var sc: context.SemaContext;
    val ri: err[fail.Fail] = init_context(?sc, s, a, rr, deps, ctx, own_module, diags);
    if (sel ri.err) {
        ret res[context.SemaResult, fail.Fail].err{ri.err};
    }

    sc.silent = true;
    val rt: err[fail.Fail] = resolve_all_types(?sc);
    if (sel rt.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{rt.err};
    }
    val rd: err[fail.Fail] = infer_gate_support_decls(?sc);
    if (sel rd.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{rd.err};
    }

    sc.silent = false;
    val rg: err[fail.Fail] = resolve_module_gates(?sc);
    if (sel rg.err) {
        dnit_context(?sc);
        ret res[context.SemaResult, fail.Fail].err{rg.err};
    }
    ret finish_result(?sc, fields.init(s.alloc));
}

pub fun reinfer_pack_each_body_typed(
    s:           *session.Session,
    a:           *ast.Ast,
    rr:          *resolve.ResolveResult,
    deps:        *context.SemaDeps,
    ctx:         *comptime.ComptimeCtx,
    own_module:  session.ModuleId,
    sema_result: *context.SemaResult,
    fn_ret:      type.TypeId,
    body_start:  u32,
    body_len:    u32,
    subst:       *type.TypeId,
    subst_len:   u32,
    insts:       *context.InstWorklist,
    diags:       *diagnostic.DiagnosticStore
) err[fail.Fail] {
    if (insts == nil) { ret err[fail.Fail].err{fail.message("internal: #2177 deferred-body re-inference: no constant-time re-validation worklist supplied (invariant violated)")}; }

    var sc: context.SemaContext;
    sc.status     = fail.accepted();
    sc.s          = s;
    sc.diags      = diags;
    sc.a          = a;
    sc.rr         = rr;
    sc.deps       = deps;
    sc.ctx        = ctx;
    val caps_r: res[comptime.PhaseCapabilities[context.SemaContext], fail.Fail] = semantic_type_caps(diags);
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    sc.caps       = caps_r.ok;
    sc.own_module = own_module;
    sc.source     = source_text_of(s, a);

    sc.expr_type        = sema_result.expr_type;
    sc.type_resolved_ty = sema_result.type_resolved_ty;
    sc.decl_type        = sema_result.decl_type;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;

    sc.callee_eid       = id.EXPR_NIL;
    sc.in_comptime_gate = false;
    sc.in_deferred_arm  = false;
    sc.inst_site_set    = false;
    sc.in_fin           = false;
    sc.fin_loop_depth   = 0;
    sc.guards           = nil;
    sc.subst            = subst;
    sc.subst_len        = subst_len;
    sc.subst_fn         = generics.substitute_typed;
    sc.insts            = insts;
    sc.collect_insts    = true;
    sc.inst_depth       = 0;
    sc.inst_parent      = context.INST_NONE;
    sc.silent           = false;
    sc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    sc.uni_reports      = ?insts.uni_reports;
    sc.has_secret       = worklist_reaches_secret(?sc, insts, a, sema_result);

    val res_body: err[fail.Fail] = infer_stmt_list(?sc, body_start, body_len, fn_ret);
    if (sel res_body.err) { ret reinference_result(?sc, res_body); }

    ret reinference_result(?sc, drain_instances(?sc, deps));
}

pub fun reinfer_instance_body_typed(
    s:           *session.Session,
    a:           *ast.Ast,
    rr:          *resolve.ResolveResult,
    deps:        *context.SemaDeps,
    ctx:         *comptime.ComptimeCtx,
    own_module:  session.ModuleId,
    sema_result: *context.SemaResult,
    fn_ret:      type.TypeId,
    body:        id.StmtId,
    subst:       *type.TypeId,
    subst_len:   u32,
    diags:       *diagnostic.DiagnosticStore
) err[fail.Fail] {
    var sc: context.SemaContext;
    sc.status = fail.accepted();
    sc.s          = s;
    sc.diags      = diags;
    sc.a          = a;
    sc.rr         = rr;
    sc.deps       = deps;
    sc.ctx        = ctx;
    val caps_r: res[comptime.PhaseCapabilities[context.SemaContext], fail.Fail] = semantic_type_caps(diags);
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    sc.caps       = caps_r.ok;
    sc.own_module = own_module;
    sc.source     = source_text_of(s, a);

    sc.expr_type        = sema_result.expr_type;
    sc.type_resolved_ty = sema_result.type_resolved_ty;
    sc.decl_type        = sema_result.decl_type;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;

    sc.callee_eid       = id.EXPR_NIL;
    sc.in_comptime_gate = false;
    sc.in_deferred_arm  = false;
    sc.inst_site_set    = false;
    sc.in_fin           = false;
    sc.fin_loop_depth   = 0;
    sc.guards           = nil;
    sc.subst            = subst;
    sc.subst_len        = subst_len;
    sc.subst_fn         = generics.substitute_typed;
    sc.insts            = nil;
    sc.collect_insts    = false;
    sc.inst_depth       = 0;
    sc.inst_parent      = context.INST_NONE;
    sc.silent           = true;
    sc.uni_check_fn     = nil;
    sc.uni_reports      = nil;
    sc.has_secret       = false;

    val outcome: err[fail.Fail] = infer_stmt(?sc, body, fn_ret);
    ret reinference_result(?sc, outcome);
}

fun reinference_result(sc: *context.SemaContext, r: err[fail.Fail]) err[fail.Fail] {
    if (sel sc.status.kind.internal) { ret err[fail.Fail].err{fail.phase_failure(sc.status)}; }
    if (sel r.err) { ret r; }
    if (sel sc.status.kind.rejected) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun copy_typeids(dst: *type.TypeId, src: *type.TypeId, n: usize) {
    var i: u32 = 0;
    for (i < n::u32) {
        dst[i] = src[i];
        i = i + 1;
    }
}

fun free_typeids(alloc: *A.Allocator, arr: *type.TypeId, n: usize) {
    if (arr != nil && n > 0) { A.deallocate[type.TypeId](alloc, arr, n); }
}

fun drain_revalidations(sc: *context.SemaContext) err[fail.Fail] {
    if (sc.insts == nil)                       { ret err[fail.Fail].ok{}; }
    if (sc.insts.drained >= sc.insts.len)      { ret err[fail.Fail].ok{}; }

    ret drain_instances(sc, sc.deps);
}

fun drain_instances(sc: *context.SemaContext, deps: *context.SemaDeps) err[fail.Fail] {
    if (sc.insts == nil) { ret err[fail.Fail].ok{}; }

    for (sc.insts.drained < sc.insts.len) {
        val idx:     u32              = sc.insts.drained;
        val origin:  session.ModuleId = sc.insts.items[idx].origin;
        val decl:    id.DeclId        = sc.insts.items[idx].decl;
        val sig:     type.TypeId      = sc.insts.items[idx].sig;
        val args:    *type.TypeId     = sc.insts.items[idx].args;
        val arg_len: u32              = sc.insts.items[idx].arg_len;

        val depth:   u32              = sc.insts.items[idx].depth;
        val site:    token.Span        = sc.insts.items[idx].site;

        val r: err[fail.Fail] = revalidate_one(sc, deps, origin, decl, args, arg_len, sig, idx, depth, site);
        if (sel r.err) { ret r; }
        sc.insts.drained = sc.insts.drained + 1;
    }
    ret err[fail.Fail].ok{};
}

fun revalidate_one(sc: *context.SemaContext, deps: *context.SemaDeps, origin: session.ModuleId,
                   decl_id: id.DeclId, args: *type.TypeId, arg_len: u32, sig: type.TypeId,
                   index: u32, depth: u32, site: token.Span) err[fail.Fail] {
    var oa:              *ast.Ast               = nil;
    var orr:             *resolve.ResolveResult = nil;
    var octx:            *comptime.ComptimeCtx  = nil;
    var o_decl_type:     *type.TypeId           = nil;
    var o_type_resolved: *type.TypeId           = nil;
    var o_expr_type:     *type.TypeId           = nil;

    if (origin == sc.own_module) {
        oa              = sc.a;
        orr             = sc.rr;
        octx            = sc.ctx;
        o_decl_type     = sc.decl_type;
        o_type_resolved = sc.type_resolved_ty;
        o_expr_type     = sc.expr_type;
    } or {
        if (deps == nil) { ret err[fail.Fail].err{fail.message("generic revalidation has no definition acquisition capability")}; }
        val acquired: res[context.Definition, fail.Fail] = context.acquire_definition_typed(?deps.definitions, origin, context.DEFINITION_TYPED);
        if (sel acquired.err) {
            val failure: fail.Fail = acquired.err;
            if (sel failure.reported) { fail.reject(?sc.status); }
            or { fail.internal(?sc.status, fail.describe(failure)); }
            ret err[fail.Fail].err{failure};
        }
        val definition: context.Definition = acquired.ok;
        oa = definition.parsed.a;
        orr = definition.rr;
        octx = definition.ctx;
        val osr: *context.SemaResult = definition.sr;
        o_decl_type     = osr.decl_type;
        o_type_resolved = osr.type_resolved_ty;
        o_expr_type     = osr.expr_type;
    }
    if (oa == nil || o_decl_type == nil) { ret err[fail.Fail].err{fail.message("internal: #2157 CT re-validation: origin module decl table unavailable (dependency-ordering invariant violated)")}; }

    val d_opt: opt[*decl.Decl] = ast.get_decl_typed(oa, decl_id);
    if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("internal: #2157 CT re-validation: generic instance decl id out of range in origin AST (invariant violated)")}; }
    val d: *decl.Decl = d_opt.some;
    if (d.kind != decl.DECL_KIND_FUN)    { ret err[fail.Fail].err{fail.message("internal: #2157 CT re-validation: generic instance decl is not a function (invariant violated)")}; }
    if (d.data.fun_.body == id.STMT_NIL) { ret err[fail.Fail].ok{}; }

    var scratch_expr: *type.TypeId = nil;
    var scratch_decl: *type.TypeId = nil;
    if (oa.expr_len > 0) {
        val re: res[*type.TypeId, fail.Fail] = typeid_array_alloc(sc.s.alloc, oa.expr_len);
        if (sel re.err) { ret err[fail.Fail].err{re.err}; }
        scratch_expr = re.ok;
        if (o_expr_type != nil) { copy_typeids(scratch_expr, o_expr_type, oa.expr_len); }
    }
    if (oa.decl_len > 0) {
        val rd: res[*type.TypeId, fail.Fail] = typeid_array_alloc(sc.s.alloc, oa.decl_len);
        if (sel rd.err) {
            free_typeids(sc.s.alloc, scratch_expr, oa.expr_len);
            ret err[fail.Fail].err{rd.err};
        }
        scratch_decl = rd.ok;
        copy_typeids(scratch_decl, o_decl_type, oa.decl_len);
    }

    var tsc: context.SemaContext;
    tsc.status = fail.accepted();
    fin { fail.merge(?sc.status, tsc.status); }
    tsc.s                = sc.s;
    tsc.diags            = sc.diags;
    tsc.a                = oa;
    tsc.rr               = orr;
    tsc.deps             = deps;
    tsc.ctx              = octx;
    val caps_r: res[comptime.PhaseCapabilities[context.SemaContext], fail.Fail] = semantic_type_caps(sc.diags);
    if (sel caps_r.err) {
        free_typeids(sc.s.alloc, scratch_expr, oa.expr_len);
        free_typeids(sc.s.alloc, scratch_decl, oa.decl_len);
        ret err[fail.Fail].err{caps_r.err};
    }
    tsc.caps             = caps_r.ok;
    tsc.own_module       = origin;
    tsc.source           = source_text_of(sc.s, oa);
    tsc.expr_type        = scratch_expr;
    tsc.type_resolved_ty = o_type_resolved;
    tsc.type_resolved_memo = nil;
    tsc.layout_state       = nil;
    tsc.decl_type        = scratch_decl;
    tsc.callee_eid       = id.EXPR_NIL;
    tsc.in_comptime_gate = false;
    tsc.in_deferred_arm  = false;
    tsc.inst_site_set    = false;
    tsc.in_fin           = false;
    tsc.fin_loop_depth   = 0;
    tsc.guards           = nil;
    tsc.subst            = args;
    tsc.subst_len        = arg_len;
    tsc.subst_fn         = generics.substitute_typed;
    tsc.insts            = sc.insts;
    tsc.collect_insts    = true;
    tsc.inst_depth       = depth + 1;
    tsc.inst_parent      = index;
    tsc.silent           = false;
    tsc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    tsc.uni_reports      = sc.uni_reports;
    tsc.has_secret       = sc.has_secret;

    val ret_ty: type.TypeId = context.resolved_type_of(?tsc, d.data.fun_.return_type);

    var pi: u32 = 0;
    for (pi < d.data.fun_.params_len) {
        val ptn: *decl.TypedName = ?oa.typed_names[d.data.fun_.params_start + pi];
        generics.check_annotation_uni_secrecy(?tsc, ptn.ty);
        pi = pi + 1;
    }

    tsc.inst_site     = site;
    tsc.inst_site_set = true;
    val outcome: err[fail.Fail] = infer_stmt(?tsc, d.data.fun_.body, ret_ty);
    tsc.inst_site_set = false;
    free_typeids(sc.s.alloc, scratch_expr, oa.expr_len);
    free_typeids(sc.s.alloc, scratch_decl, oa.decl_len);
    ret outcome;
}

pub fun dnit_result(r: *context.SemaResult) {
    if (r == nil) { ret; }
    fields.dnit(?r.field_graph);
    if (r.expr_type != nil && r.expr_count > 0) {
        A.deallocate[type.TypeId](r.alloc, r.expr_type, r.expr_count::usize);
    }
    if (r.type_resolved_ty != nil && r.type_count > 0) {
        A.deallocate[type.TypeId](r.alloc, r.type_resolved_ty, r.type_count::usize);
    }
    if (r.decl_type != nil && r.decl_count > 0) {
        A.deallocate[type.TypeId](r.alloc, r.decl_type, r.decl_count::usize);
    }
    if (r.embed_paths != nil && r.embed_path_cap > 0) {
        A.deallocate[intern.StrId](r.alloc, r.embed_paths, r.embed_path_cap::usize);
    }
    r.embed_paths      = nil;
    r.embed_path_count = 0;
    r.embed_path_cap   = 0;
    r.expr_type        = nil;
    r.type_resolved_ty = nil;
    r.decl_type        = nil;
    r.expr_count       = 0;
    r.type_count       = 0;
    r.decl_count       = 0;
}

fun init_context(
    sc:         *context.SemaContext,
    s:          *session.Session,
    a:          *ast.Ast,
    rr:         *resolve.ResolveResult,
    deps:       *context.SemaDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    diags:      *diagnostic.DiagnosticStore
) err[fail.Fail] {
    sc.status = fail.accepted();
    sc.s          = s;
    sc.diags      = diags;
    sc.a          = a;
    sc.rr         = rr;
    sc.deps       = deps;
    sc.ctx        = ctx;
    val caps_r: res[comptime.PhaseCapabilities[context.SemaContext], fail.Fail] = semantic_name_caps(diags);
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    sc.caps       = caps_r.ok;
    sc.own_module = own_module;
    sc.source     = source_text_of(s, a);

    sc.expr_type        = nil;
    sc.type_resolved_ty = nil;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;
    sc.decl_type        = nil;
    sc.embed_len        = nil;
    sc.embed_paths      = nil;
    sc.embed_path_len   = 0;
    sc.embed_path_cap   = 0;

    sc.callee_eid       = id.EXPR_NIL;
    sc.in_comptime_gate = false;
    sc.in_deferred_arm  = false;
    sc.inst_site_set    = false;
    sc.in_fin           = false;
    sc.fin_loop_depth   = 0;
    sc.guards           = nil;
    sc.subst            = nil;
    sc.subst_len        = 0;
    sc.subst_fn         = nil;
    sc.insts            = nil;
    sc.collect_insts    = true;
    sc.inst_depth       = 0;
    sc.inst_parent      = context.INST_NONE;
    sc.silent           = false;
    sc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    sc.uni_reports      = nil;
    sc.has_secret       = false;

    if (a.expr_len > 0) {
        val res_expr: res[*type.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.expr_len);
        if (sel res_expr.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_expr.err};
        }
        sc.expr_type = res_expr.ok;
    }
    if (a.type_len > 0) {
        val res_type: res[*type.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.type_len);
        if (sel res_type.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_type.err};
        }
        sc.type_resolved_ty = res_type.ok;

        val res_memo: res[*u8, fail.Fail] = memo_array_alloc(s.alloc, a.type_len);
        if (sel res_memo.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_memo.err};
        }
        sc.type_resolved_memo = res_memo.ok;

        val res_emb: res[*u64, fail.Fail] = embed_len_array_alloc(s.alloc, a.type_len);
        if (sel res_emb.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_emb.err};
        }
        sc.embed_len = res_emb.ok;
    }
    if (a.decl_len > 0) {
        val res_decl: res[*type.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.decl_len);
        if (sel res_decl.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_decl.err};
        }
        sc.decl_type = res_decl.ok;

        val res_lay: res[*u8, fail.Fail] = layout_state_alloc(s.alloc, a.decl_len);
        if (sel res_lay.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_lay.err};
        }
        sc.layout_state = res_lay.ok;
    }

    val res_seed: err[fail.Fail] = infer.seed_builtins(sc);
    if (sel res_seed.err) {
        dnit_context(sc);
        ret res_seed;
    }

    ret err[fail.Fail].ok{};
}

fun typeid_array_alloc(a: *A.Allocator, len: usize) res[*type.TypeId, fail.Fail] {
    val res_arr: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](a, len);
    if (sel res_arr.err) { ret res[*type.TypeId, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *type.TypeId = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = type.TYPE_NIL;
        i = i + 1;
    }
    ret res[*type.TypeId, fail.Fail].ok{arr};
}

fun layout_state_alloc(a: *A.Allocator, len: usize) res[*u8, fail.Fail] {
    val res_arr: res[*u8, A.Error] = A.allocate[u8](a, len);
    if (sel res_arr.err) { ret res[*u8, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u8 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = context.LAYOUT_PENDING;
        i = i + 1;
    }
    ret res[*u8, fail.Fail].ok{arr};
}

fun embed_len_array_alloc(a: *A.Allocator, len: usize) res[*u64, fail.Fail] {
    val res_arr: res[*u64, A.Error] = A.allocate[u64](a, len);
    if (sel res_arr.err) { ret res[*u64, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u64 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = context.EMBED_LEN_NONE;
        i = i + 1;
    }
    ret res[*u64, fail.Fail].ok{arr};
}

fun memo_array_alloc(a: *A.Allocator, len: usize) res[*u8, fail.Fail] {
    val res_arr: res[*u8, A.Error] = A.allocate[u8](a, len);
    if (sel res_arr.err) { ret res[*u8, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u8 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = context.TYPE_MEMO_NONE;
        i = i + 1;
    }
    ret res[*u8, fail.Fail].ok{arr};
}

fun source_text_of(s: *session.Session, a: *ast.Ast) str {
    val opt_file: O.Option[*source.SourceFile] = source.get(?s.sources, a.file_id);
    if (O.is_none[*source.SourceFile](opt_file)) {
        panic("sema.source_text_of: module source not registered\n");
    }
    ret O.unwrap[*source.SourceFile](opt_file).text;
}

fun dnit_context(sc: *context.SemaContext) {
    if (sc.expr_type != nil && sc.a.expr_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.expr_type, sc.a.expr_len);
    }
    if (sc.type_resolved_ty != nil && sc.a.type_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.type_resolved_ty, sc.a.type_len);
    }
    if (sc.decl_type != nil && sc.a.decl_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.decl_type, sc.a.decl_len);
    }
    if (sc.type_resolved_memo != nil && sc.a.type_len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.type_resolved_memo, sc.a.type_len);
    }
    if (sc.layout_state != nil && sc.a.decl_len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.layout_state, sc.a.decl_len);
    }
    if (sc.embed_len != nil && sc.a.type_len > 0) {
        A.deallocate[u64](sc.s.alloc, sc.embed_len, sc.a.type_len);
    }
    if (sc.embed_paths != nil && sc.embed_path_cap > 0) {
        A.deallocate[intern.StrId](sc.s.alloc, sc.embed_paths, sc.embed_path_cap::usize);
    }
    sc.embed_len          = nil;
    sc.embed_paths        = nil;
    sc.embed_path_len     = 0;
    sc.embed_path_cap     = 0;
    sc.expr_type          = nil;
    sc.type_resolved_ty   = nil;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;
    sc.decl_type          = nil;
    context.inst_worklist_dnit(sc);
}

fun worklist_reaches_secret(sc: *context.SemaContext, wl: *context.InstWorklist, a: *ast.Ast,
                            sema_result: *context.SemaResult) bool {
    if (wl != nil && wl.secret_state != context.SECRET_UNKNOWN) {
        ret wl.secret_state == context.SECRET_PRESENT;
    }
    val r: res[bool, fail.Fail] = generics.module_reaches_secret(sc.s, sema_result.type_resolved_ty, a.type_len::u32);
    if (sel r.err) { fail.internal(?sc.status, fail.describe(r.err)); ret false; }
    val reaches: bool = r.ok;
    if (wl != nil) {
        wl.secret_state = context.SECRET_ABSENT;
        if (reaches) { wl.secret_state = context.SECRET_PRESENT; }
    }
    ret reaches;
}

fun check_annotation_uni_secrecy_all(sc: *context.SemaContext) {
    if (!sc.has_secret)             { ret; }
    if (sc.type_resolved_ty == nil) { ret; }
    var i: u32 = 0;
    for (i < sc.a.type_len::u32) {
        generics.check_annotation_uni_secrecy(sc, i);
        i = i + 1;
    }
}

fun resolve_all_types(sc: *context.SemaContext) err[fail.Fail] {
    if (sc.type_resolved_ty == nil) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < sc.a.type_len::u32) {
        sc.type_resolved_ty[i] = infer.resolve_type_ref(sc, i);
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun resolve_all_embeds(sc: *context.SemaContext) err[fail.Fail] {
    val opt_module: opt[*module.Module] = ast.get_module_typed(sc.a, sc.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *module.Module = opt_module.some;
    ret resolve_embeds_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun resolve_embeds_in_list(sc: *context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val r: err[fail.Fail] = resolve_embeds_one(sc, did);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun resolve_embeds_one(sc: *context.SemaContext, did: id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*decl.Decl] = ast.get_decl_typed(sc.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *decl.Decl = opt_decl.some;

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
        if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
            ret err[fail.Fail].ok{};
        }
        var b: u32 = 0;
        for (b < ci.branches_len) {
            val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + b];
            val active_r: res[bool, fail.Fail] = comptime_branch_active(sc, br);
            if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
            if (active_r.ok) {
                ret resolve_embeds_in_list(sc, br.body_start, br.body_len);
            }
            b = b + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var found: bool = false;
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (decorator_named(sc, dec, "embed")) {
            if (found) {
                context.report(sc, dec.name, "a declaration can carry only one `embed` decorator");
            }
            or {
                val r: err[fail.Fail] = embed.resolve_one(sc, did, d, dec);
                if (sel r.err) { ret r; }
                found = true;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_all_decls(sc: *context.SemaContext) err[fail.Fail] {
    if (sc.decl_type == nil) { ret err[fail.Fail].ok{}; }
    val opt_module: opt[*module.Module] = ast.get_module_typed(sc.a, sc.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *module.Module = opt_module.some;
    ret infer_decls_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_gate_support_decls(sc: *context.SemaContext) err[fail.Fail] {
    val opt_module: opt[*module.Module] = ast.get_module_typed(sc.a, sc.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *module.Module = opt_module.some;
    ret infer_gate_support_decls_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_gate_support_decls_in_list(sc: *context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val d_opt: opt[*decl.Decl] = ast.get_decl_typed(sc.a, did);
        if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
        if (d_opt.some.kind != decl.DECL_KIND_COMPTIME_IF) {
            sc.decl_type[did] = infer.infer_decl(sc, did);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun resolve_module_gates(sc: *context.SemaContext) err[fail.Fail] {
    val opt_module: opt[*module.Module] = ast.get_module_typed(sc.a, sc.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *module.Module = opt_module.some;
    ret resolve_gates_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun resolve_gates_in_list(sc: *context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val d_opt: opt[*decl.Decl] = ast.get_decl_typed(sc.a, did);
        if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
        val d: *decl.Decl = d_opt.some;
        if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
            val rr: err[fail.Fail] = resolve_gate_chain(sc, ?d.data.comptime_if);
            if (sel rr.err) { ret rr; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun resolve_gate_chain(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) err[fail.Fail] {
    if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
        ret err[fail.Fail].ok{};
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        if (br.cond != id.EXPR_NIL && comptime.gate_state(sc.ctx, br.cond) == comptime.GATE_STATE_UNKNOWN) {
            val dr: err[fail.Fail] = decide_decl_gate(sc, br.cond);
            if (sel dr.err) { ret dr; }
        }

        var active: bool = br.cond == id.EXPR_NIL;
        if (br.cond != id.EXPR_NIL) {
            val state: comptime.GateState = comptime.gate_state(sc.ctx, br.cond);
            if (state == comptime.GATE_STATE_TRUE)  { active = true; }
            or (state == comptime.GATE_STATE_FALSE) { active = false; }
            or (state == comptime.GATE_STATE_REJECTED) { ret err[fail.Fail].ok{}; }
            or {
                val fr: res[comptime.GateVerdict, fail.Fail] = decl_gate_verdict(sc, br.cond);
                if (sel fr.err) {
                    ret err[fail.Fail].err{fr.err};
                }
                val fv: comptime.GateVerdict = fr.ok;
                if (fv.outcome != comptime.GATE_ACTIVE && fv.outcome != comptime.GATE_INACTIVE) {
                    ret err[fail.Fail].ok{};
                }
                active = fv.outcome == comptime.GATE_ACTIVE;
            }
        }
        if (active) {
            val saved_silent: bool = sc.silent;
            sc.silent = true;
            val rd: err[fail.Fail] = infer_gate_support_decls_in_list(sc, br.body_start, br.body_len);
            sc.silent = saved_silent;
            if (sel rd.err) { ret rd; }
            ret resolve_gates_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun decl_gate_verdict(sc: *context.SemaContext, cond: id.ExprId) res[comptime.GateVerdict, fail.Fail] {
    ret comptime.evaluate_gate_typed[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, cond,
        ?sc.s.interner, comptime.GATE_SCOPE_DECL, true, true);
}

fun decl_gate_is_active(sc: *context.SemaContext, cond: id.ExprId) res[bool, fail.Fail] {
    val vr: res[comptime.GateVerdict, fail.Fail] = decl_gate_verdict(sc, cond);
    if (sel vr.err) {
        ret res[bool, fail.Fail].err{vr.err};
    }
    val v: comptime.GateVerdict = vr.ok;
    if (v.outcome == comptime.GATE_AWAITING_TYPES) { ret res[bool, fail.Fail].ok{comptime.truth(v.value)}; }
    ret res[bool, fail.Fail].ok{v.outcome == comptime.GATE_ACTIVE};
}

fun decl_gate_layout(sc: *context.SemaContext, eid: u32) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_error(
        comptime.EVAL_FAIL_NEEDS_LAYOUT, comptime.COMPTIME_LAYOUT_NO_RESOLVER_MSG));
}

fun decide_decl_gate(sc: *context.SemaContext, cond: id.ExprId) err[fail.Fail] {
    val vr: res[comptime.GateVerdict, fail.Fail] = decl_gate_verdict(sc, cond);
    if (sel vr.err) {
        ret err[fail.Fail].err{vr.err};
    }
    var v: comptime.GateVerdict = vr.ok;
    if (v.outcome == comptime.GATE_AWAITING_PHASE && v.fail == comptime.EVAL_FAIL_NEEDS_TYPES) {
        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        fin { sc.in_comptime_gate = saved_gate; }
        val gate_ty: type.TypeId = infer.infer_expr(sc, cond);
        if (type.is_u8(?sc.s.types, gate_ty)) {
            val caps_r: res[comptime.PhaseCapabilities[context.SemaContext], fail.Fail] = semantic_type_caps(sc.diags);
            if (sel caps_r.err) {
                ret err[fail.Fail].err{caps_r.err};
            }
            var caps: comptime.PhaseCapabilities[context.SemaContext] = caps_r.ok;
            caps.layout = decl_gate_layout;
            val typed: res[comptime.GateVerdict, fail.Fail] = comptime.evaluate_gate_typed[context.SemaContext](
                sc.ctx, sc, caps, sc.a, sc.source, cond, ?sc.s.interner, comptime.GATE_SCOPE_DECL, true, true);
            if (sel typed.err) {
                ret err[fail.Fail].err{typed.err};
            }
            v = typed.ok;
        }
    }

    if (v.outcome == comptime.GATE_ACTIVE || v.outcome == comptime.GATE_INACTIVE) {
        ret err[fail.Fail].ok{};
    }
    if (v.outcome == comptime.GATE_REJECTED) {
        if (!sc.silent) { fail.reject(?sc.status); }
        if (str_len(v.message) > 0) {
            val saved_gate: bool = sc.in_comptime_gate;
            sc.in_comptime_gate = true;
            context.report(sc, v.span, v.message);
            sc.in_comptime_gate = saved_gate;
        }
        ret err[fail.Fail].ok{};
    }
    if (v.outcome == comptime.GATE_AWAITING_TYPES) {
        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        val gate_ty: type.TypeId = infer.infer_expr(sc, cond);
        if (type.is_u8(?sc.s.types, gate_ty)) {
            var state: comptime.GateState = comptime.GATE_STATE_FALSE;
            if (comptime.truth(v.value)) { state = comptime.GATE_STATE_TRUE; }
            comptime.set_gate_state(sc.ctx, cond, state);
        }
        or (gate_ty != type.TYPE_NIL && gate_ty != type.TYPE_ERROR) {
            check.check_condition(sc, gate_ty, v.span);
            comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
        }
        or (gate_ty == type.TYPE_ERROR) {
            comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
        }
        sc.in_comptime_gate = saved_gate;
        ret err[fail.Fail].ok{};
    }

    val transient: bool = comptime.gate_eval_failure_is_transient(v.fail);
    val saved_gate: bool = sc.in_comptime_gate;
    val saved_silent: bool = sc.silent;
    sc.in_comptime_gate = true;
    if (transient) { sc.silent = true; }
    val gate_ty: type.TypeId = infer.infer_expr(sc, cond);
    sc.silent = saved_silent;
    if (gate_ty != type.TYPE_NIL && gate_ty != type.TYPE_ERROR && !type.is_u8(?sc.s.types, gate_ty)) {
        check.check_condition(sc, gate_ty, v.span);
        comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
    }
    or (type.is_u8(?sc.s.types, gate_ty) && !transient) {
        context.report(sc, v.span, v.message);
        comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
    }
    or (gate_ty == type.TYPE_ERROR && !transient) {
        comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
    }
    sc.in_comptime_gate = saved_gate;
    ret err[fail.Fail].ok{};
}

fun infer_decls_in_list(sc: *context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val res_decl: err[fail.Fail] = infer_one_decl(sc, did);
        if (sel res_decl.err) { ret res_decl; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_one_decl(sc: *context.SemaContext, did: id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*decl.Decl] = ast.get_decl_typed(sc.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *decl.Decl = opt_decl.some;

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret infer_decls_comptime_if(sc, ?d.data.comptime_if);
    }

    val ty: type.TypeId = infer.infer_decl(sc, did);
    sc.decl_type[did] = ty;
    ret err[fail.Fail].ok{};
}

fun infer_decls_comptime_if(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) err[fail.Fail] {
    if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
        ret err[fail.Fail].ok{};
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        if (br.cond != id.EXPR_NIL && comptime.gate_state(sc.ctx, br.cond) == comptime.GATE_STATE_UNKNOWN) {
            val saved_gate: bool = sc.in_comptime_gate;
            sc.in_comptime_gate = true;
            val gate_ty: type.TypeId = infer.infer_expr(sc, br.cond);
            if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret err[fail.Fail].ok{}; }
            val gate_opt: res[expr.Expr, fail.Fail] = context.expression(sc, br.cond);
            var gate_ok: bool = true;
            if (sel gate_opt.ok) { gate_ok = check.check_condition(sc, gate_ty, gate_opt.ok.span); }
            sc.in_comptime_gate = saved_gate;
            if (!gate_ok) { ret err[fail.Fail].ok{}; }
        }
        val active_r: res[bool, fail.Fail] = comptime_branch_active(sc, br);
        if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
        if (active_r.ok) {
            ret infer_decls_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_all_bodies(sc: *context.SemaContext) err[fail.Fail] {
    if (sc.decl_type == nil) { ret err[fail.Fail].ok{}; }
    val opt_module: opt[*module.Module] = ast.get_module_typed(sc.a, sc.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *module.Module = opt_module.some;
    ret infer_bodies_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_bodies_in_list(sc: *context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val res_body: err[fail.Fail] = infer_one_body(sc, did);
        if (sel res_body.err) { ret res_body; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pack_on_import_check(sc: *context.SemaContext, d: *decl.Decl) {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[d.data.fun_.params_start + i];
        val opt_t: opt[*atype.Type] = ast.get_type_typed(sc.a, tn.ty);
        if (sel opt_t.some) {
            if (opt_t.some.kind == atype.TYPE_KIND_PACK) {
                context.report_note(sc, d.span,
                    "a comptime variadic pack `...` cannot appear on a body-less `fun`",
                    "a pack is monomorphized per call site and takes a mangled name, so no foreign library can export it; for a C function declared with `...`, write the C-variadic form instead: `ext fun f(a: T, ...)`");
                ret;
            }
        }
        i = i + 1;
    }
}

fun infer_one_body(sc: *context.SemaContext, did: id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*decl.Decl] = ast.get_decl_typed(sc.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *decl.Decl = opt_decl.some;

    infer_decorator_args(sc, d);
    validate_decorators(sc, d);
    check_handle_decl(sc, did, d);
    check_abi_type_placement(sc, did, d);

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret infer_bodies_comptime_if(sc, ?d.data.comptime_if);
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        if (d.data.fun_.body != id.STMT_NIL) {
            if (d.data.fun_.c_variadic) {
                context.report(sc, d.span, "a C-variadic `...` declares a foreign import and cannot have a body");
            }
            val ret_ty: type.TypeId = context.resolved_type_of(sc, d.data.fun_.return_type);
            ret infer_stmt(sc, d.data.fun_.body, ret_ty);
        }
        pack_on_import_check(sc, d);
        ret err[fail.Fail].ok{};
    }
    if (d.kind == decl.DECL_KIND_TEST) {
        if (d.data.test_.body != id.STMT_NIL) {
            val ret_ty: type.TypeId = test_return_type(sc);
            ret infer_stmt(sc, d.data.test_.body, ret_ty);
        }
        ret err[fail.Fail].ok{};
    }
    if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
        if ((d.flags & decl.DECL_FLAG_EXT) != 0 && d.data.bind.init != id.EXPR_NIL) {
            context.report(sc, d.span, "an `ext` data import cannot have an initializer");
            ret err[fail.Fail].ok{};
        }
        ret infer_binding_init(sc, did, d);
    }
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) {
        eval_comptime_directive(sc, d.data.comptime_attr.target, d.span);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].ok{};
}

fun infer_decorator_args(sc: *context.SemaContext, d: *decl.Decl) {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        var ii: u32 = 0;
        for (ii < dec.args_len) {
            if (!handle.arg_is_type(sc, dec, ii)) {
                infer.infer_expr(sc, sc.a.expr_ids[dec.args_start + ii]);
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun validate_decorators(sc: *context.SemaContext, d: *decl.Decl) {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        validate_one_decorator(sc, d, ?sc.a.decorators[d.decorators_start + i]);
        i = i + 1;
    }
    validate_no_inline_conflict(sc, d);
    if (d.kind == decl.DECL_KIND_TAG) { validate_case_decorators(sc, ?d.data.tag_); }
}

# a tag case takes only `deprecated`: every other directive shapes a symbol or a whole type
fun validate_case_decorators(sc: *context.SemaContext, t: *decl.DeclTag) {
    var i: u32 = 0;
    for (i < t.cases_len) {
        val c: *decl.TagCase = ?sc.a.tag_cases[t.cases_start + i];
        var j: u32 = 0;
        for (j < c.decorators_len) {
            val dec: *decl.Decorator = ?sc.a.decorators[c.decorators_start + j];
            if (!decorator_named(sc, dec, "deprecated")) {
                context.report(sc, dec.name, "a tag case takes only the `deprecated` decorator");
            }
            or { validate_deprecated_args(sc, dec, c.decorators_start, j); }
            j = j + 1;
        }
        i = i + 1;
    }
}

fun validate_deprecated_args(sc: *context.SemaContext, dec: *decl.Decorator, decorators_start: u32, index: u32) {
    if (dec.args_len > 1) { context.report(sc, dec.name, "`deprecated` takes zero or one string literal argument"); }
    or (dec.args_len == 1) {
        require_string_arg(sc, dec, "`deprecated` takes zero or one string literal argument",
            "`deprecated` message must be a string literal");
    }
    var prior: u32 = 0;
    for (prior < index) {
        if (decorator_named(sc, ?sc.a.decorators[decorators_start + prior], "deprecated")) {
            context.report(sc, dec.name, "`deprecated` may appear only once on a declaration");
            ret;
        }
        prior = prior + 1;
    }
}

fun deprecation_leaf(sc: *context.SemaContext, span: token.Span) token.Span {
    var leaf: token.Span = span;
    var i: usize = span.offset;
    for (i < span.offset + span.len) {
        if (sc.source[i] == '.') { leaf.offset = i + 1; }
        i = i + 1;
    }
    leaf.len = span.offset + span.len - leaf.offset;
    ret leaf;
}

fun warn_deprecated_at(sc: *context.SemaContext, notice: deprecation.Deprecation, span: token.Span, what: str,
                       seen: *map.Map[u64, u8]) err[fail.Fail] {
    if (!notice.present || notice.owner == sc.a.file_id || span.len == 0) { ret err[fail.Fail].ok{}; }
    val key: u64 = span.offset::u64;
    val get_1: opt[*u8] = map.get[u64, u8](seen, ?key);
    if (sel get_1.some) { ret err[fail.Fail].ok{}; }
    val name_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.source, span.offset, span.len);
    if (sel name_r.err) {
        if (sel name_r.err.alloc) { ret err[fail.Fail].err{fail.refused(name_r.err.alloc)}; }
        ret err[fail.Fail].err{fail.message("deprecated declaration name lies outside its source")};
    }
    val name: str = name_r.ok;
    fin { str_free(sc.s.alloc, name); }
    var text: str = "";
    if (notice.message != intern.STR_NIL) {
        val found: opt[str] = intern.lookup_typed(?sc.s.interner, notice.message);
        if (!sel found.some) { ret err[fail.Fail].err{fail.message("deprecation message is not interned")}; }
        text = found.some;
    }
    var message: res[str, format.FormatError];
    if (str_len(text) == 0) { message = format.sprint(sc.s.alloc, "{}`{}` is deprecated", what, name); }
    or { message = format.sprint(sc.s.alloc, "{}`{}` is deprecated: {}", what, name, text); }
    if (sel message.err) { ret err[fail.Fail].err{fail.format_refused(message.err)}; }
    val owned: str = message.ok;
    fin { str_free(sc.s.alloc, owned); }
    val emitted: err[fail.Fail] = fail.lift_err(diagnostic.warning(sc.diags, sc.a.file_id, span, owned));
    if (sel emitted.err) { ret emitted; }
    val remembered: res[bool, A.Error] = map.insert[u64, u8](seen, key, 1);
    if (sel remembered.err) { ret err[fail.Fail].err{fail.refused(remembered.err)}; }
    ret err[fail.Fail].ok{};
}

fun warn_deprecated_symbol(sc: *context.SemaContext, sid: resolve.SymbolId, span: token.Span,
                           seen: *map.Map[u64, u8]) err[fail.Fail] {
    if (sid >= sc.rr.symbol_count) { ret err[fail.Fail].ok{}; }
    ret warn_deprecated_at(sc, sc.rr.symbols[sid].deprecation, span, "", seen);
}

# the tag nominal a place of this type selects a case of: through outer secrecy and one
# pointer level, as `sel` and a payload place read it
fun deprecation_tag_of_place(sc: *context.SemaContext, ty: type.TypeId) type.TypeId {
    if (ty == type.TYPE_NIL || ty == type.TYPE_ERROR) { ret type.TYPE_NIL; }
    var base: type.TypeId = type.strip_secret(?sc.s.types, ty);
    if (type.is_pointer(?sc.s.types, base)) { base = type.strip_secret(?sc.s.types, type.deref_one(?sc.s.types, base)); }
    val nominal: type.TypeId = type.aggregate_nominal(?sc.s.types, base);
    if (!type.is_tag(?sc.s.types, nominal)) { ret type.TYPE_NIL; }
    ret nominal;
}

fun warn_deprecated_case(sc: *context.SemaContext, tag: type.TypeId, case_span: token.Span,
                         seen: *map.Map[u64, u8]) err[fail.Fail] {
    if (tag == type.TYPE_NIL || case_span.len == 0) { ret err[fail.Fail].ok{}; }
    val name: res[intern.StrId, A.Error] = intern.intern_span_typed(?sc.s.interner, sc.source, case_span);
    if (sel name.err) { ret err[fail.Fail].err{fail.refused(name.err)}; }
    val table: opt[*type.FieldTable] = type.field_table_for_typed(?sc.s.types, tag);
    if (!sel table.some) { ret err[fail.Fail].ok{}; }
    val ft: *type.FieldTable = table.some;
    var i: u32 = 0;
    for (i < ft.fields_len) {
        val entry: *type.FieldEntry = type.field_entry_at(?sc.s.types, ft, i);
        if (entry != nil && entry.name == name.ok) {
            ret warn_deprecated_at(sc, entry.deprecation, case_span, "tag case ", seen);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# one warning per source site after every body and instantiation has been inferred: named
# declaration uses through their resolved symbol, and tag case uses (construction, `sel`,
# payload place) through the case table of the place's tag
fun warn_deprecated_uses(sc: *context.SemaContext) err[fail.Fail] {
    if (sc.silent || sc.in_comptime_gate || sc.rr == nil || sc.expr_type == nil) { ret err[fail.Fail].ok{}; }
    var seen: map.Map[u64, u8] = map.init[u64, u8](sc.s.alloc, map.hash_u64, map.eq_u64);
    fin { map.dnit[u64, u8](?seen); }
    var i: u32 = 0;
    for (i < sc.rr.expr_count && i::usize < sc.a.expr_len) {
        val e: *expr.Expr = ?sc.a.exprs[i];
        var span: token.Span = e.span;
        if (e.kind == expr.EXPR_KIND_MEMBER) { span = e.data.member.name; }
        val warned: err[fail.Fail] = warn_deprecated_symbol(sc, sc.rr.expr_resolved[i], span, ?seen);
        if (sel warned.err) { ret warned; }
        var tag: type.TypeId = type.TYPE_NIL;
        var case_span: token.Span = token.Span{ offset: 0, len: 0 };
        if (e.kind == expr.EXPR_KIND_SEL && e.data.sel.case_desc == id.EXPR_NIL && e.data.sel.place < sc.rr.expr_count) {
            tag = deprecation_tag_of_place(sc, sc.expr_type[e.data.sel.place]);
            case_span = e.data.sel.case_name;
        }
        or (e.kind == expr.EXPR_KIND_MEMBER && sc.expr_type[i] != type.TYPE_NIL) {
            val self_ty: type.TypeId = sc.expr_type[i];
            if (type.is_case_selector(?sc.s.types, self_ty)) { tag = type.aggregate_nominal(?sc.s.types, type.case_selector_tag_type(?sc.s.types, self_ty)); }
            or (e.data.member.object < sc.rr.expr_count) { tag = deprecation_tag_of_place(sc, sc.expr_type[e.data.member.object]); }
            case_span = e.data.member.name;
        }
        or (e.kind == expr.EXPR_KIND_STRUCT_LIT) {
            val head: opt[*atype.Type] = ast.get_type_typed(sc.a, e.data.struct_lit.ty);
            if (sel head.some) {
                if (head.some.kind == atype.TYPE_KIND_NAMED && head.some.data.named.case_desc == id.EXPR_NIL) {
                    tag = deprecation_tag_of_place(sc, sc.expr_type[i]);
                    case_span = head.some.data.named.case_name;
                }
            }
        }
        val case_warned: err[fail.Fail] = warn_deprecated_case(sc, tag, case_span, ?seen);
        if (sel case_warned.err) { ret case_warned; }
        i = i + 1;
    }
    i = 0;
    for (i < sc.rr.type_count && i::usize < sc.a.type_len) {
        val t: *atype.Type = ?sc.a.types[i];
        if (t.kind == atype.TYPE_KIND_NAMED) {
            val warned: err[fail.Fail] = warn_deprecated_symbol(sc, sc.rr.type_resolved[i], deprecation_leaf(sc, t.data.named.name), ?seen);
            if (sel warned.err) { ret warned; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_no_inline_conflict(sc: *context.SemaContext, d: *decl.Decl) {
    var has_inline:   bool = false;
    var has_noinline: bool = false;
    var noinline_span: token.Span;
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (decorator_named(sc, dec, "inline"))   { has_inline = true; }
        if (decorator_named(sc, dec, "noinline")) { has_noinline = true; noinline_span = dec.name; }
        i = i + 1;
    }
    if (has_inline && has_noinline) {
        context.report(sc, noinline_span, "`inline` and `noinline` decorators cannot both apply to the same function");
    }
}

fun decorator_named(sc: *context.SemaContext, dec: *decl.Decorator, name: str) bool {
    ret str_region_equals(sc.source, dec.name.offset, dec.name.len, name);
}

fun decl_has_decorator(sc: *context.SemaContext, d: *decl.Decl, name: str) bool {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        if (decorator_named(sc, ?sc.a.decorators[d.decorators_start + i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun require_string_arg(sc: *context.SemaContext, dec: *decl.Decorator, count_msg: str, kind_msg: str) {
    if (dec.args_len != 1) {
        context.report(sc, dec.name, count_msg);
        ret;
    }
    val opt_arg: res[expr.Expr, fail.Fail] = context.expression(sc, sc.a.expr_ids[dec.args_start]);
    if (sel opt_arg.ok) {
        var arg_value: expr.Expr = opt_arg.ok;
        val arg: *expr.Expr = ?arg_value;
        if (arg.kind != expr.EXPR_KIND_LIT_STR) {
            context.report(sc, arg.span, kind_msg);
        }
    }
}

fun validate_iface_target(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (!is_global_binding(d.kind)) {
        context.report(sc, dec.name, "shader interface decorators apply only to module-level `val` / `var` bindings");
        ret;
    }
    var roles: u32 = 0;
    if (has_decorator(sc, d, "input"))   { roles = roles + 1; }
    if (has_decorator(sc, d, "output"))  { roles = roles + 1; }
    if (has_decorator(sc, d, "builtin")) { roles = roles + 1; }
    if (has_decorator(sc, d, "uniform")) { roles = roles + 1; }
    if (has_decorator(sc, d, "storage")) { roles = roles + 1; }
    if (has_decorator(sc, d, "sampler")) { roles = roles + 1; }
    if (roles > 1) {
        context.report(sc, dec.name, "a shader interface variable carries exactly one role; `input`, `output`, `builtin`, `uniform`, `storage`, and `sampler` are mutually exclusive");
    }
}

fun validate_builtin_value(sc: *context.SemaContext, dec: *decl.Decorator) {
    if (dec.args_len != 1) { ret; }
    val opt_arg: res[expr.Expr, fail.Fail] = context.expression(sc, sc.a.expr_ids[dec.args_start]);
    if (sel opt_arg.err) { ret; }
    var arg_value: expr.Expr = opt_arg.ok;
    val arg: *expr.Expr = ?arg_value;
    if (arg.kind != expr.EXPR_KIND_LIT_STR || arg.span.len < 2::usize) { ret; }
    val off: usize = arg.span.offset + 1::usize;
    val len: usize = arg.span.len - 2::usize;
    if (str_region_equals(sc.source, off, len, "position"))          { ret; }
    if (str_region_equals(sc.source, off, len, "vertex_index"))      { ret; }
    if (str_region_equals(sc.source, off, len, "instance_index"))    { ret; }
    if (str_region_equals(sc.source, off, len, "frag_coord"))        { ret; }
    if (str_region_equals(sc.source, off, len, "point_size"))        { ret; }
    if (str_region_equals(sc.source, off, len, "global_invocation")) { ret; }
    if (str_region_equals(sc.source, off, len, "local_invocation"))  { ret; }
    if (str_region_equals(sc.source, off, len, "workgroup_id"))      { ret; }
    context.report(sc, arg.span, "unknown built-in; `builtin` accepts \"position\", \"vertex_index\", \"instance_index\", \"frag_coord\", \"point_size\", \"global_invocation\", \"local_invocation\", or \"workgroup_id\"");
}

fun validate_stage_value(sc: *context.SemaContext, dec: *decl.Decorator) {
    if (dec.args_len != 1) { ret; }
    val opt_arg: res[expr.Expr, fail.Fail] = context.expression(sc, sc.a.expr_ids[dec.args_start]);
    if (sel opt_arg.err) { ret; }
    var arg_value: expr.Expr = opt_arg.ok;
    val arg: *expr.Expr = ?arg_value;
    if (arg.kind != expr.EXPR_KIND_LIT_STR || arg.span.len < 2::usize) { ret; }
    val off: usize = arg.span.offset + 1::usize;
    val len: usize = arg.span.len - 2::usize;
    if (str_region_equals(sc.source, off, len, "vertex"))   { ret; }
    if (str_region_equals(sc.source, off, len, "fragment")) { ret; }
    if (str_region_equals(sc.source, off, len, "compute"))  { ret; }
    context.report(sc, arg.span, "unknown pipeline stage; `stage` accepts \"vertex\", \"fragment\", or \"compute\"");
}

fun validate_storage_quals(sc: *context.SemaContext, dec: *decl.Decorator) {
    var i: u32 = 2;
    for (i < dec.args_len) {
        val opt_arg: res[expr.Expr, fail.Fail] = context.expression(sc, sc.a.expr_ids[dec.args_start + i]);
        if (sel opt_arg.err) { i = i + 1; cnt; }
        var arg_value: expr.Expr = opt_arg.ok;
        val arg: *expr.Expr = ?arg_value;
        if (arg.kind != expr.EXPR_KIND_LIT_STR || arg.span.len < 2::usize) {
            context.report(sc, arg.span, "a `storage` memory qualifier must be a string literal; `storage` takes the descriptor set and binding followed by qualifiers, as in `#[storage(0, 3, \"readonly\")]`");
            i = i + 1; cnt;
        }
        val off: usize = arg.span.offset + 1::usize;
        val len: usize = arg.span.len - 2::usize;
        if (!str_region_equals(sc.source, off, len, "readonly")) {
            context.report(sc, arg.span, "unknown `storage` memory qualifier; `storage` accepts \"readonly\"");
        }
        i = i + 1;
    }
}

fun validate_op(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (d.kind != decl.DECL_KIND_FUN) {
        context.report(sc, dec.name, "`op` decorator applies only to functions");
        ret;
    }
    if (dec.args_len != 3) {
        context.report(sc, dec.name, "`op` decorator takes three string arguments: the target, the instruction set, and the instruction name");
        ret;
    }
    val opt_tgt: res[expr.Expr, fail.Fail] = context.expression(sc, sc.a.expr_ids[dec.args_start]);
    val opt_set: res[expr.Expr, fail.Fail] = context.expression(sc, sc.a.expr_ids[dec.args_start + 1]);
    val opt_nam: res[expr.Expr, fail.Fail] = context.expression(sc, sc.a.expr_ids[dec.args_start + 2]);
    if (sel opt_tgt.err) { ret; }
    if (sel opt_set.err) { ret; }
    if (sel opt_nam.err) { ret; }
    var tgt_e_value: expr.Expr = opt_tgt.ok;
    val tgt_e: *expr.Expr = ?tgt_e_value;
    var set_e_value: expr.Expr = opt_set.ok;
    val set_e: *expr.Expr = ?set_e_value;
    var nam_e_value: expr.Expr = opt_nam.ok;
    val nam_e: *expr.Expr = ?nam_e_value;
    if (tgt_e.kind != expr.EXPR_KIND_LIT_STR || set_e.kind != expr.EXPR_KIND_LIT_STR
        || nam_e.kind != expr.EXPR_KIND_LIT_STR) {
        context.report(sc, dec.name, "`op` decorator arguments must be string literals: all three are matched against the target registry rather than evaluated");
        ret;
    }
    if (tgt_e.span.len < 2::usize || set_e.span.len < 2::usize || nam_e.span.len < 2::usize) { ret; }

    val defs: *isa.TargetDefs = sc.ctx.env.target_defs;

    if (!target_is_selected(sc, tgt_e))    { ret; }
    if (defs == nil || defs.op_count == 0) { ret; }

    if (!isa.op_set_exists_region(defs, sc.source, set_e.span.offset + 1::usize, set_e.span.len - 2::usize)) {
        context.report(sc, set_e.span, "the selected target defines no instruction set of this name; an `op` declaration is emitted only by a target that publishes the instruction");
        ret;
    }
    val od: *isa.OpDef = isa.op_def_of_region(defs,
        sc.source, set_e.span.offset + 1::usize, set_e.span.len - 2::usize,
        sc.source, nam_e.span.offset + 1::usize, nam_e.span.len - 2::usize);
    if (od == nil) {
        context.report(sc, nam_e.span, "that instruction set defines no instruction of this name, or the selected target does not carry it; the target's own table lists the accepted names and why each omission is one");
        ret;
    }
    if (d.data.fun_.params_len != od.arity) {
        context.report(sc, dec.name, "the declaration's parameter count does not match the instruction's operand count: operands come from the parameters in order, so a mismatch assembles the instruction with the wrong number of operands");
    }
}

fun target_is_selected(sc: *context.SemaContext, tgt_e: *expr.Expr) bool {
    val no: opt[str] = intern.lookup_typed(?sc.s.interner, sc.ctx.env.target_isa);
    if (!sel no.some) { ret false; }
    ret str_region_equals(sc.source, tgt_e.span.offset + 1::usize,
                          tgt_e.span.len - 2::usize, no.some);
}

fun is_align_target(kind: decl.DeclKind) bool {
    ret kind == decl.DECL_KIND_VAL || kind == decl.DECL_KIND_VAR ||
        kind == decl.DECL_KIND_REC || kind == decl.DECL_KIND_UNI || kind == decl.DECL_KIND_TAG;
}

fun type_carries_handle(sc: *context.SemaContext, t: type.TypeId) bool {
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }
    val opt_type: opt[*type.Type] = type.get_typed(?sc.s.types, t);
    if (!sel opt_type.some) { ret false; }
    val tp: *type.Type = opt_type.some;
    if (tp.kind == type.TYPE_HANDLE)  { ret true; }
    if (tp.kind == type.TYPE_SECRET)  { ret type_carries_handle(sc, tp.data.secret.base); }
    if (tp.kind == type.TYPE_POINTER) { ret type_carries_handle(sc, tp.data.pointer.base); }
    if (tp.kind == type.TYPE_ARRAY)   { ret type_carries_handle(sc, tp.data.array.base); }
    ret false;
}

fun check_handle_fields_all(sc: *context.SemaContext) {
    if (sc.decl_type == nil) { ret; }
    var d: u32 = 0;
    for (d < sc.a.decl_len::u32) {
        val d_opt: opt[*decl.Decl] = ast.get_decl_typed(sc.a, d);
        if (!sel d_opt.some) { d = d + 1; cnt; }
        val dd: *decl.Decl = d_opt.some;
        if (dd.kind == decl.DECL_KIND_REC) {
            check_handle_fields(sc, dd.data.rec_.fields_start, dd.data.rec_.fields_len);
        }
        or (dd.kind == decl.DECL_KIND_UNI) {
            check_handle_fields(sc, dd.data.uni_.fields_start, dd.data.uni_.fields_len);
        }
        or (dd.kind == decl.DECL_KIND_TAG) {
            var i: u32 = 0;
            for (i < dd.data.tag_.cases_len) {
                val c: *decl.TagCase = ?sc.a.tag_cases[dd.data.tag_.cases_start + i];
                if (type_carries_handle(sc, context.resolved_type_of(sc, c.payload))) {
                    context.report(sc, c.name, "a handle cannot be a tag payload because its representation is owned by the target");
                }
                i = i + 1;
            }
        }
        d = d + 1;
    }
}

fun check_handle_fields(sc: *context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[start + i];
        if (type_carries_handle(sc, context.resolved_type_of(sc, tn.ty))) {
            context.report(sc, tn.name,
                "a handle cannot be a record or union field: a record is storage the program owns at offsets it can compute, and a handle's representation is not the program's, so an aggregate holding one has no layout. declare the handle itself");
        }
        i = i + 1;
    }
}

fun type_carries_abi_type(sc: *context.SemaContext, t: type.TypeId) bool {
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }
    val opt_type: opt[*type.Type] = type.get_typed(?sc.s.types, t);
    if (!sel opt_type.some) { ret false; }
    val tp: *type.Type = opt_type.some;
    if (tp.kind == type.TYPE_ABI)     { ret true; }
    if (tp.kind == type.TYPE_SECRET)  { ret type_carries_abi_type(sc, tp.data.secret.base); }
    if (tp.kind == type.TYPE_POINTER) { ret type_carries_abi_type(sc, tp.data.pointer.base); }
    if (tp.kind == type.TYPE_ARRAY)   { ret type_carries_abi_type(sc, tp.data.array.base); }
    ret false;
}

fun check_abi_type_placement(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl) {
    if (d.kind == decl.DECL_KIND_TAG) {
        var i: u32 = 0;
        for (i < d.data.tag_.cases_len) {
            val c: *decl.TagCase = ?sc.a.tag_cases[d.data.tag_.cases_start + i];
            if (type_carries_abi_type(sc, context.resolved_type_of(sc, c.payload))) {
                context.report(sc, c.name, abitype.exclusion_message());
            }
            i = i + 1;
        }
        ret;
    }
    if (d.kind == decl.DECL_KIND_REC) {
        check_abi_type_fields(sc, d.data.rec_.fields_start, d.data.rec_.fields_len);
        ret;
    }
    if (d.kind == decl.DECL_KIND_UNI) {
        check_abi_type_fields(sc, d.data.uni_.fields_start, d.data.uni_.fields_len);
        ret;
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        var i: u32 = 0;
        for (i < d.data.fun_.params_len) {
            val tn: *decl.TypedName = ?sc.a.typed_names[d.data.fun_.params_start + i];
            val pty: type.TypeId = context.resolved_type_of(sc, tn.ty);
            if (type_carries_abi_type(sc, pty) && !type.is_abi_type(?sc.s.types, pty)) {
                context.report(sc, tn.name, abitype.exclusion_message());
            }
            i = i + 1;
        }
        if (type_carries_abi_type(sc, context.resolved_type_of(sc, d.data.fun_.return_type))) {
            context.report(sc, d.data.fun_.name, abitype.exclusion_message());
        }
        ret;
    }
    if (is_global_binding(d.kind)) {
        if (sc.decl_type == nil) { ret; }
        if (type_carries_abi_type(sc, sc.decl_type[did])) {
            context.report(sc, d.span, abitype.exclusion_message());
        }
    }
}

fun check_abi_type_fields(sc: *context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[start + i];
        if (type_carries_abi_type(sc, context.resolved_type_of(sc, tn.ty))) {
            context.report(sc, tn.name, abitype.exclusion_message());
        }
        i = i + 1;
    }
}

fun check_handle_decl(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl) {
    if (sc.decl_type == nil)             { ret; }
    if (!is_global_binding(d.kind))      { ret; }
    val ty: type.TypeId = sc.decl_type[did];
    val carries: bool   = type_carries_handle(sc, ty);
    val marked:  bool   = decl_has_decorator(sc, d, "sampler");

    if (carries && !type.is_handle(?sc.s.types, ty)) {
        context.report(sc, d.span,
            "a handle cannot sit behind a pointer or inside an array: a pointer and an array are both extents the program computes, and a handle's extent is the owning target's rather than the program's, so there is no element size to step by. declare the handle itself");
        ret;
    }
    if (carries && !marked) {
        if (has_decorator(sc, d, "input") || has_decorator(sc, d, "output")
            || has_decorator(sc, d, "builtin") || has_decorator(sc, d, "uniform")
            || has_decorator(sc, d, "storage")) {
            context.report(sc, d.span,
                "a handle is bound as a descriptor and carries `#[sampler(set, binding)]`; the role on it puts the handle in a storage class no handle may live in");
            ret;
        }
        context.report(sc, d.span,
            "a handle binding needs a `#[sampler(set, binding)]` decorator: a shader has no general global storage, so a handle with no descriptor address is reachable from no stage");
        ret;
    }
    if (marked && !carries) {
        context.report(sc, d.span,
            "`sampler` decorator applies only to a handle binding, a `def` declared with `#[handle(...)]`; a descriptor-bound block or buffer of an ordinary type is `#[uniform(set, binding)]` or `#[storage(set, binding)]`");
    }
}

fun is_global_binding(kind: decl.DeclKind) bool {
    ret kind == decl.DECL_KIND_VAL || kind == decl.DECL_KIND_VAR;
}

fun is_fun_or_global(kind: decl.DeclKind) bool {
    ret kind == decl.DECL_KIND_FUN || kind == decl.DECL_KIND_VAL || kind == decl.DECL_KIND_VAR;
}

fun decorator_arg_type(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL)          { ret type.TYPE_ERROR; }
    if (eid::usize >= sc.a.expr_len) { ret type.TYPE_ERROR; }
    ret sc.expr_type[eid];
}

fun validate_one_decorator(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (decorator_named(sc, dec, "deprecated")) {
        if (d.kind != decl.DECL_KIND_FUN && d.kind != decl.DECL_KIND_REC
            && d.kind != decl.DECL_KIND_UNI && d.kind != decl.DECL_KIND_TAG && d.kind != decl.DECL_KIND_DEF
            && d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR
            && d.kind != decl.DECL_KIND_USE && d.kind != decl.DECL_KIND_FWD) {
            context.report(sc, dec.name, "`deprecated` applies only to fun, rec, uni, tag, def, val, var, use, or fwd declarations and tag cases");
            ret;
        }
        var index: u32 = 0;
        for (index < d.decorators_len) {
            if (?sc.a.decorators[d.decorators_start + index] == dec) { brk; }
            index = index + 1;
        }
        validate_deprecated_args(sc, dec, d.decorators_start, index);
        ret;
    }
    if (decorator_named(sc, dec, "symbol")) {
        require_string_arg(sc, dec,
            "`symbol` decorator takes one string argument",
            "`symbol` decorator argument must be a string literal");
        if (!is_fun_or_global(d.kind)) {
            context.report(sc, dec.name, "`symbol` decorator applies only to functions and globals");
        }
        ret;
    }
    if (decorator_named(sc, dec, "library")) {
        require_string_arg(sc, dec,
            "`library` decorator takes one string argument",
            "`library` decorator argument must be a string literal");
        if ((d.flags & decl.DECL_FLAG_EXT) == 0) {
            context.report(sc, dec.name, "`library` decorator applies only to ext imports");
        }
        ret;
    }
    if (decorator_named(sc, dec, "inline")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`inline` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`inline` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "noinline")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`noinline` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`noinline` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "oblivious")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`oblivious` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`oblivious` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "align")) {
        if (dec.args_len != 1) {
            context.report(sc, dec.name, "`align` decorator takes one argument");
        } or (is_global_binding(d.kind)) {
            val arg_eid: id.ExprId = sc.a.expr_ids[dec.args_start];
            if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, arg_eid))) {
                context.report(sc, dec.name, "`align` decorator argument must be an integer comptime expression");
            }
        }
        if (!is_align_target(d.kind)) {
            context.report(sc, dec.name, "`align` decorator applies only to records, unions, and globals");
        }
        ret;
    }
    if (decorator_named(sc, dec, "section")) {
        require_string_arg(sc, dec,
            "`section` decorator takes one string argument",
            "`section` decorator argument must be a string literal");
        if (!is_fun_or_global(d.kind)) {
            context.report(sc, dec.name, "`section` decorator applies only to functions and globals");
        }
        ret;
    }
    if (decorator_named(sc, dec, "stage")) {
        require_string_arg(sc, dec,
            "`stage` decorator takes one string argument",
            "`stage` decorator argument must be a string literal");
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`stage` decorator applies only to functions");
            ret;
        }
        validate_stage_value(sc, dec);
        ret;
    }
    if (decorator_named(sc, dec, "workgroup")) {
        if (dec.args_len != 3) {
            context.report(sc, dec.name, "`workgroup` decorator takes three arguments: the x, y, and z workgroup dimensions");
        }
        or {
            var wi: u32 = 0;
            for (wi < 3) {
                val aeid: id.ExprId = sc.a.expr_ids[dec.args_start + wi];
                if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, aeid))) {
                    context.report(sc, dec.name, "`workgroup` decorator dimensions must be integer comptime expressions");
                    wi = 3; cnt;
                }
                wi = wi + 1;
            }
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`workgroup` decorator applies only to functions");
            ret;
        }
        if (!has_decorator(sc, d, "stage")) {
            context.report(sc, dec.name, "`workgroup` decorator requires a `#[stage(\"compute\")]` on the same function; it sizes a compute stage's workgroup and means nothing without one");
        }
        ret;
    }
    if (decorator_named(sc, dec, "input") || decorator_named(sc, dec, "output")) {
        if (dec.args_len != 1) {
            context.report(sc, dec.name, "`input` / `output` decorator takes one argument: the interface location");
        }
        or {
            val leid: id.ExprId = sc.a.expr_ids[dec.args_start];
            if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, leid))) {
                context.report(sc, dec.name, "`input` / `output` location must be an integer comptime expression");
            }
        }
        validate_iface_target(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "builtin")) {
        require_string_arg(sc, dec,
            "`builtin` decorator takes one string argument",
            "`builtin` decorator argument must be a string literal");
        validate_iface_target(sc, d, dec);
        validate_builtin_value(sc, dec);
        ret;
    }
    if (decorator_named(sc, dec, "uniform") || decorator_named(sc, dec, "storage")) {
        val quals: bool = decorator_named(sc, dec, "storage");
        if (dec.args_len < 2 || (dec.args_len > 2 && !quals)) {
            context.report(sc, dec.name, "`uniform` / `storage` decorator takes two arguments: the descriptor set and the binding");
        }
        or {
            var ui: u32 = 0;
            for (ui < 2) {
                val ueid: id.ExprId = sc.a.expr_ids[dec.args_start + ui];
                if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, ueid))) {
                    context.report(sc, dec.name, "`uniform` / `storage` descriptor set and binding must be integer comptime expressions");
                    ui = 2; cnt;
                }
                ui = ui + 1;
            }
            if (quals) { validate_storage_quals(sc, dec); }
        }
        validate_iface_target(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "sampler")) {
        if (dec.args_len != 2) {
            context.report(sc, dec.name, "`sampler` decorator takes two arguments: the descriptor set and the binding");
        }
        or {
            var si: u32 = 0;
            for (si < 2) {
                val seid: id.ExprId = sc.a.expr_ids[dec.args_start + si];
                if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, seid))) {
                    context.report(sc, dec.name, "`sampler` descriptor set and binding must be integer comptime expressions");
                    si = 2; cnt;
                }
                si = si + 1;
            }
        }
        validate_iface_target(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "packed")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`packed` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_REC && d.kind != decl.DECL_KIND_UNI && d.kind != decl.DECL_KIND_TAG) {
            context.report(sc, dec.name, "`packed` decorator applies only to records, unions, and tags");
        }
        if (decl_has_decorator(sc, d, "uniform") || decl_has_decorator(sc, d, "storage")) {
            context.report(sc, dec.name,
                "`packed` cannot apply to a `uniform` / `storage` interface block: its member offsets are fixed by the std140 / std430 layout rules and emitted as explicit Offset decorations, which packing would contradict");
        }
        ret;
    }
    if (decorator_named(sc, dec, "volatile")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`volatile` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_REC && d.kind != decl.DECL_KIND_UNI && d.kind != decl.DECL_KIND_TAG) {
            context.report(sc, dec.name, "`volatile` decorator applies only to records, unions, and tags");
        }
        ret;
    }
    if (decorator_named(sc, dec, "scalar")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`scalar` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`scalar` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "naked")) {
        validate_naked(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "embed")) { ret; }
    if (decorator_named(sc, dec, "op")) {
        validate_op(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, handle.DIRECTIVE)) {
        handle.validate(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, abitype.DIRECTIVE)) {
        abitype.validate(sc, d, dec);
        ret;
    }
    context.report(sc, dec.name, "unknown decorator; valid directives are deprecated, symbol, section, inline, noinline, align, packed, volatile, library, oblivious, scalar, naked, embed, stage, workgroup, input, output, builtin, uniform, storage, sampler, op, handle, abi_type");
}

fun validate_naked(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (dec.args_len != 0) {
        context.report(sc, dec.name, "`naked` decorator takes no arguments");
    }
    if (d.kind != decl.DECL_KIND_FUN) {
        context.report(sc, dec.name, "`naked` decorator applies only to functions");
        ret;
    }
    if (has_decorator(sc, d, "inline")) {
        context.report(sc, dec.name, "`naked` and `inline` decorators are mutually exclusive; a naked function cannot be inlined");
    }
    if (has_decorator(sc, d, "oblivious")) {
        context.report(sc, dec.name, "`naked` and `oblivious` decorators are mutually exclusive; a naked body is inline asm, which `oblivious` forbids");
    }
    if (d.data.fun_.body == id.STMT_NIL) {
        context.report(sc, dec.name, "`naked` decorator applies only to a function with a body");
        ret;
    }
    check_naked_body(sc, d.data.fun_.body);
}

fun check_naked_body(sc: *context.SemaContext, sid: id.StmtId) {
    val opt_stmt: opt[*stmt.Stmt] = ast.get_stmt_typed(sc.a, sid);
    if (!sel opt_stmt.some) { ret; }
    val s: *stmt.Stmt = opt_stmt.some;

    if (s.kind == stmt.STMT_KIND_ASM) { ret; }

    if (s.kind == stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            check_naked_body(sc, sc.a.stmt_ids[s.data.block.stmts_start + i]);
            i = i + 1;
        }
        ret;
    }

    if (s.kind == stmt.STMT_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[s.data.comptime_if.branches_start + b];
            var i: u32 = 0;
            for (i < br.body_len) {
                check_naked_body(sc, sc.a.stmt_ids[br.body_start + i]);
                i = i + 1;
            }
            b = b + 1;
        }
        ret;
    }

    context.report(sc, s.span, "a `naked` function's body may contain only inline `asm` statements");
}

fun has_decorator(sc: *context.SemaContext, d: *decl.Decl, name: str) bool {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        if (decorator_named(sc, ?sc.a.decorators[d.decorators_start + i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun test_return_type(sc: *context.SemaContext) type.TypeId {
    val opt_i32: opt[type.TypeId] = type.prim_typed(?sc.s.types, type.TYPE_I32);
    if (!sel opt_i32.some) { ret type.TYPE_ERROR; }
    ret opt_i32.some;
}

fun infer_binding_init(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl) err[fail.Fail] {
    if (d.data.bind.init == id.EXPR_NIL) { ret err[fail.Fail].ok{}; }
    if (d.data.bind.ty   == id.TYPE_NIL) { ret err[fail.Fail].ok{}; }

    val actual:   type.TypeId = infer.infer_expr(sc, d.data.bind.init);
    val expected: type.TypeId = sc.decl_type[did];
    if (expected != type.TYPE_NIL && expected != type.TYPE_ERROR && actual != type.TYPE_ERROR) {
        check_binding(sc, expected, d.data.bind.init, actual, d.span);
        if (d.kind == decl.DECL_KIND_VAL && comptime.is_case_literal(sc.a, d.data.bind.init)) {
            ret rebind_constant_tag(sc, d, expected);
        }
    }
    ret err[fail.Fail].ok{};
}

# name resolution bound a case-literal `val` as an untyped constant element; the checked type lets
# a nested payload read name its member types
fun rebind_constant_tag(sc: *context.SemaContext, d: *decl.Decl, ty: type.TypeId) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.intern_span_typed(?sc.s.interner, sc.source, d.data.bind.name);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val name: intern.StrId = name_r.ok;
    val bound: opt[comptime.NamedConst] = comptime.lookup_typed(sc.ctx, name);
    if (!sel bound.some) { ret err[fail.Fail].ok{}; }
    val nc: comptime.NamedConst = bound.some;
    if (nc.value.kind != comptime.CT_KIND_CONST_ELEM || nc.value.data.celem.elem != d.data.bind.init::u32) { ret err[fail.Fail].ok{}; }
    if (nc.value.data.celem.ty == ty::u32) { ret err[fail.Fail].ok{}; }
    ret comptime.bind_gated_typed(sc.ctx, name, comptime.const_elem_value(d.data.bind.init::u32, ty::u32), nc.gated);
}

fun infer_bodies_deferred_chain(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) err[fail.Fail] {
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        if (br.cond == id.EXPR_NIL) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        val e_opt: res[expr.Expr, fail.Fail] = context.expression(sc, br.cond);
        if (sel e_opt.err) { ret err[fail.Fail].err{fail.message("comptime branch cond ExprId out of range")}; }
        val cond_span: token.Span = e_opt.ok.span;

        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        val gate_ty: type.TypeId = infer.infer_expr(sc, br.cond);
        if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret err[fail.Fail].ok{}; }
        if (!check.check_condition(sc, gate_ty, cond_span)) { sc.in_comptime_gate = saved_gate; ret err[fail.Fail].ok{}; }

        val vr: res[comptime.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, br.cond);
        if (sel vr.err) {
            sc.in_comptime_gate = saved_gate;
            ret err[fail.Fail].err{vr.err};
        }
        val v: comptime.GateVerdict = vr.ok;
        if (v.outcome != comptime.GATE_ACTIVE && v.outcome != comptime.GATE_INACTIVE
         && v.outcome != comptime.GATE_AWAITING_TYPES) {
            if (str_len(v.message) > 0) { context.report(sc, cond_span, v.message); }
            sc.in_comptime_gate = saved_gate;
            ret err[fail.Fail].ok{};
        }
        sc.in_comptime_gate = saved_gate;
        if (gate_verdict_truth(v)) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun stmt_gate_verdict(sc: *context.SemaContext, cond: id.ExprId) res[comptime.GateVerdict, fail.Fail] {
    ret comptime.evaluate_gate_typed[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, cond,
        ?sc.s.interner, comptime.GATE_SCOPE_INSTANCE, false, true);
}

fun gate_verdict_truth(v: comptime.GateVerdict) bool {
    if (v.outcome == comptime.GATE_ACTIVE)         { ret true; }
    if (v.outcome == comptime.GATE_AWAITING_TYPES) { ret comptime.truth(v.value); }
    ret false;
}

fun infer_bodies_comptime_if(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) err[fail.Fail] {
    if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
        ret infer_bodies_deferred_chain(sc, ci);
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        val active_r: res[bool, fail.Fail] = comptime_branch_active(sc, br);
        if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
        if (active_r.ok) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_stmt(sc: *context.SemaContext, sid: id.StmtId, fn_ret: type.TypeId) err[fail.Fail] {
    if (sid == id.STMT_NIL) { ret err[fail.Fail].ok{}; }
    val opt_stmt: opt[*stmt.Stmt] = ast.get_stmt_typed(sc.a, sid);
    if (!sel opt_stmt.some) { ret err[fail.Fail].err{fail.message("StmtId out of range")}; }
    val st: *stmt.Stmt = opt_stmt.some;

    if (st.kind == stmt.STMT_KIND_EXPR) {
        val ty: type.TypeId = infer.infer_expr(sc, st.data.expr.expr);
        if (type.is_case_selector(?sc.s.types, ty)) {
            context.report(sc, st.span, "a case selector is not a value");
        }
        ret err[fail.Fail].ok{};
    }
    if (st.kind == stmt.STMT_KIND_BLOCK) {
        ret infer_stmt_list(sc, st.data.block.stmts_start, st.data.block.stmts_len, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_IF) {
        val cond_ty: type.TypeId = infer.infer_expr(sc, st.data.if_.cond);
        if (cond_ty != type.TYPE_ERROR) { check.check_condition(sc, cond_ty, st.span); }
        var arm_guard: context.Guard;
        val opened: bool = guard.open_sel(sc, st.data.if_.cond, ?arm_guard);
        val res_then: err[fail.Fail] = infer_stmt(sc, st.data.if_.then_block, fn_ret);
        if (opened) { guard.close(sc, ?arm_guard); }
        if (sel res_then.err) { ret res_then; }
        ret infer_stmt(sc, st.data.if_.else_block, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_FOR) {
        if (st.data.for_.cond != id.EXPR_NIL) {
            val cond_ty: type.TypeId = infer.infer_expr(sc, st.data.for_.cond);
            if (cond_ty != type.TYPE_ERROR) { check.check_condition(sc, cond_ty, st.span); }
        }
        sc.fin_loop_depth = sc.fin_loop_depth + 1;
        val res_body: err[fail.Fail] = infer_stmt(sc, st.data.for_.body, fn_ret);
        sc.fin_loop_depth = sc.fin_loop_depth - 1;
        ret res_body;
    }
    if (st.kind == stmt.STMT_KIND_RET) {
        if (sc.in_fin) {
            context.report(sc, st.span, "`ret` cannot appear inside a `fin` body");
        }
        check_return_stmt(sc, fn_ret, st.data.ret_.value, st.span);
        ret err[fail.Fail].ok{};
    }
    if (st.kind == stmt.STMT_KIND_BRK) {
        if (sc.in_fin && sc.fin_loop_depth == 0) {
            context.report(sc, st.span, "`brk` inside a `fin` body cannot target a loop outside the fin");
        }
        ret err[fail.Fail].ok{};
    }
    if (st.kind == stmt.STMT_KIND_CNT) {
        if (sc.in_fin && sc.fin_loop_depth == 0) {
            context.report(sc, st.span, "`cnt` inside a `fin` body cannot target a loop outside the fin");
        }
        ret err[fail.Fail].ok{};
    }
    if (st.kind == stmt.STMT_KIND_FIN) {
        val saved_in:    bool = sc.in_fin;
        val saved_depth: u32  = sc.fin_loop_depth;
        sc.in_fin         = true;
        sc.fin_loop_depth = 0;
        val res_body: err[fail.Fail] = infer_stmt(sc, st.data.fin_.body, fn_ret);
        sc.in_fin         = saved_in;
        sc.fin_loop_depth = saved_depth;
        ret res_body;
    }
    if (st.kind == stmt.STMT_KIND_DECL) {
        ret infer_local_decl(sc, st.data.decl.decl);
    }
    if (st.kind == stmt.STMT_KIND_COMPTIME_IF) {
        ret infer_stmt_comptime_if(sc, st.data.comptime_if.branches_start, st.data.comptime_if.branches_len, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_COMPTIME_EACH) {
        ret infer_stmt_comptime_each(sc, ?st.data.comptime_each, st.span, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_COMPTIME_ATTR) {
        eval_comptime_directive(sc, st.data.comptime_attr.target, st.span);
        ret err[fail.Fail].ok{};
    }
    if (st.kind == stmt.STMT_KIND_ASM || st.kind == stmt.STMT_KIND_ERROR) { ret err[fail.Fail].ok{}; }
    val message: str = resolve.unknown_catalog(sc.s, "StmtKind", st.kind::u32);
    fail.internal(?sc.status, message);
    ret err[fail.Fail].err{fail.message(message)};
}

fun eval_comptime_directive(sc: *context.SemaContext, target: id.ExprId, span: token.Span) {
    if (target == id.EXPR_NIL)     { ret; }
    if (sc.in_deferred_arm)        { ret; }

    var at: token.Span = span;
    if (sc.inst_site_set) { at = sc.inst_site; }
    if (!comptime.is_error_call(sc.a, sc.source, target)) { ret; }
    val res_msg: R.Result[str, comptime.EvalFail] = comptime.error_message[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, target, ?sc.s.interner);
    if (R.is_err[str, comptime.EvalFail](res_msg)) {
        val f: comptime.EvalFail = R.unwrap_err[str, comptime.EvalFail](res_msg);
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?sc.status, f.message); }
        or { context.report(sc, at, f.message); }
        ret;
    }
    context.report(sc, at, R.unwrap_ok[str, comptime.EvalFail](res_msg));
}

fun infer_stmt_comptime_each(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span, fn_ret: type.TypeId) err[fail.Fail] {
    ret walk_stmt_comptime_each(sc, ce, span, infer_each_body, (?fn_ret)::ptr);
}

fun infer_each_body(data: ptr, sc: *context.SemaContext, start: u32, count: u32) err[fail.Fail] {
    ret infer_stmt_list(sc, start, count, @(data::*type.TypeId));
}

fun walk_stmt_comptime_each(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span, visit: context.StmtListVisitor, data: ptr) err[fail.Fail] {
    val over_cases: bool = comptime.is_cases_call(sc.a, sc.source, ce.seq);
    if (!comptime.is_fields_call(sc.a, sc.source, ce.seq) && !over_cases) {
        val seq_ty: type.TypeId = infer.infer_expr(sc, ce.seq);
        val opt_seq: opt[*type.Type] = type.get_typed(?sc.s.types, seq_ty);
        if (sel opt_seq.some) {
            if (opt_seq.some.kind == type.TYPE_PACK) {
                ret err[fail.Fail].ok{};
            }
        }
        if (sel opt_seq.some) {
            if (opt_seq.some.kind == type.TYPE_ARRAY) {
                ret infer_const_array_each(sc, ce, span, visit, data, seq_ty);
            }
        }
        if (seq_ty != type.TYPE_ERROR) {
            context.report(sc, span, "a `$each` sequence must be `$fields(T)`, `$cases(T)`, a variadic pack, or a constant array `val`");
        }
        ret err[fail.Fail].ok{};
    }

    var owner: type.TypeId = type.TYPE_ERROR;
    if (over_cases) { owner = infer.case_seq_owner(sc, ce.seq, span); }
    or             { owner = infer.field_seq_owner(sc, ce.seq, span); }
    if (owner == type.TYPE_ERROR) { ret err[fail.Fail].ok{}; }
    if (infer.type_is_generic_param(sc, owner)) { ret err[fail.Fail].ok{}; }

    val res_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?sc.s.interner, sc.source, ce.var_name);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    val n: u32 = type.field_count(?sc.s.types, owner);
    var i: u32 = 0;
    for (i < n) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open_typed(sc.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark: comptime.FrameMark = mark_r.ok;
        var desc: comptime.CTValue = comptime.field_value(owner::u32, i);
        if (over_cases) { desc = comptime.case_value(owner::u32, i); }
        val res_bind: err[fail.Fail] = comptime.bind_typed(sc.ctx, fname, desc);
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close_typed(sc.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }
        val res_body: err[fail.Fail] = visit(data, sc, ce.body_start, ce.body_len);
        val res_close: err[fail.Fail] = comptime.frame_close_typed(sc.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_const_array_each(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span, visit: context.StmtListVisitor, data: ptr, seq_ty: type.TypeId) err[fail.Fail] {
    val opt_arr: opt[*type.Type] = type.get_typed(?sc.s.types, seq_ty);
    if (!sel opt_arr.some) { ret err[fail.Fail].ok{}; }
    val arr: *type.Type = opt_arr.some;
    val elem_ty: type.TypeId = arr.data.array.base;
    val count:   u32         = arr.data.array.count;

    val opt_sym: opt[*resolve.Symbol] = context.symbol_for_expr(sc, ce.seq);
    if (!sel opt_sym.some) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind == resolve.SYM_VAR) {
        context.report(sc, span, "a `$each` array sequence must be an immutable `val`; a `var` is not a compile-time-constant sequence");
        ret err[fail.Fail].ok{};
    }
    if (sym.kind != resolve.SYM_VAL && sym.kind != resolve.SYM_IMPORTED) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }

    val opt_elem: opt[*type.Type] = type.get_typed(?sc.s.types, elem_ty);
    if (sel opt_elem.some) {
        if (opt_elem.some.kind == type.TYPE_ARRAY) {
            context.report(sc, span, "a `$each` array element type must be a scalar or record; nested-array elements are not supported");
            ret err[fail.Fail].ok{};
        }
    }

    if (sym.origin == sc.own_module) {
        ret infer_const_array_each_local(sc, ce, span, visit, data, sym, elem_ty, count);
    }
    ret infer_const_array_each_imported(sc, ce, span, visit, data, sym, elem_ty, count);
}

fun infer_const_array_each_local(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span,
                                 visit: context.StmtListVisitor, data: ptr, sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) err[fail.Fail] {
    val opt_info: opt[comptime.ArrayLitInfo] = comptime.decl_array_lit_typed(sc.a, sym.decl);
    if (!sel opt_info.some) {
        context.report(sc, span, "a `$each` array sequence must be initialized with an array literal");
        ret err[fail.Fail].ok{};
    }
    val info: comptime.ArrayLitInfo = opt_info.some;
    if (info.elems_len != count) {
        context.report(sc, span, "a `$each` array must be fully initialized: every element needs an initializer");
        ret err[fail.Fail].ok{};
    }

    val res_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?sc.s.interner, sc.source, ce.var_name);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    var i: u32 = 0;
    for (i < count) {
        if ((info.elems_start + i)::usize >= sc.a.expr_id_len) {
            ret err[fail.Fail].err{fail.message("sema: `$each` array element index out of range")};
        }
        val elem_eid: id.ExprId = sc.a.expr_ids[info.elems_start + i];
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open_typed(sc.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark: comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail] = comptime.bind_typed(sc.ctx, fname, comptime.const_elem_value(elem_eid::u32, elem_ty::u32));
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close_typed(sc.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }
        val res_body: err[fail.Fail] = visit(data, sc, ce.body_start, ce.body_len);
        val res_close: err[fail.Fail] = comptime.frame_close_typed(sc.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_const_array_each_imported(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span,
                                    visit: context.StmtListVisitor, data: ptr, sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) err[fail.Fail] {
    val acquired: res[context.DefinedSymbol, fail.Fail] = context.imported_definition(sc, sym, context.DEFINITION_TYPED);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val current: context.DefinedSymbol = acquired.ok;
    val oa: *ast.Ast = current.definition.parsed.a;
    val orr: *resolve.ResolveResult = current.definition.rr;
    val octx: *comptime.ComptimeCtx = current.definition.ctx;
    val osr: *context.SemaResult = current.definition.sr;

    val od_opt: opt[*decl.Decl] = ast.get_decl_typed(oa, current.symbol.decl);
    if (!sel od_opt.some) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }
    if (od_opt.some.kind == decl.DECL_KIND_VAR) {
        context.report(sc, span, "a `$each` array sequence must be an immutable `val`; a `var` is not a compile-time-constant sequence");
        ret err[fail.Fail].ok{};
    }
    if (od_opt.some.kind != decl.DECL_KIND_VAL) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }

    val opt_info: opt[comptime.ArrayLitInfo] = comptime.decl_array_lit_typed(oa, current.symbol.decl);
    if (!sel opt_info.some) {
        context.report(sc, span, "a `$each` array sequence must be initialized with an array literal");
        ret err[fail.Fail].ok{};
    }
    val info: comptime.ArrayLitInfo = opt_info.some;
    if (info.elems_len != count) {
        context.report(sc, span, "a `$each` array must be fully initialized: every element needs an initializer");
        ret err[fail.Fail].ok{};
    }

    val res_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?sc.s.interner, sc.source, ce.var_name);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    var tsc: context.SemaContext;
    tsc.status = fail.accepted();
    fin { fail.merge(?sc.status, tsc.status); }
    tsc.s                = sc.s;
    tsc.diags            = sc.diags;
    tsc.a                = oa;
    tsc.rr               = orr;
    tsc.deps             = sc.deps;
    tsc.ctx              = octx;
    val caps_r: res[comptime.PhaseCapabilities[context.SemaContext], fail.Fail] = semantic_type_caps(sc.diags);
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    tsc.caps             = caps_r.ok;
    tsc.own_module       = sym.origin;
    tsc.source           = source_text_of(sc.s, oa);
    tsc.expr_type        = osr.expr_type;
    tsc.type_resolved_ty = osr.type_resolved_ty;
    tsc.type_resolved_memo = nil;
    tsc.layout_state       = nil;
    tsc.decl_type        = osr.decl_type;
    tsc.callee_eid       = id.EXPR_NIL;
    tsc.in_comptime_gate = false;
    tsc.in_deferred_arm  = false;
    tsc.inst_site_set    = false;
    tsc.in_fin           = false;
    tsc.fin_loop_depth   = 0;
    tsc.guards           = nil;
    tsc.subst            = nil;
    tsc.subst_len        = 0;
    tsc.subst_fn         = generics.substitute_typed;
    tsc.insts            = sc.insts;
    tsc.collect_insts    = sc.collect_insts;
    tsc.inst_depth       = sc.inst_depth;
    tsc.inst_parent      = sc.inst_parent;
    tsc.silent           = sc.silent;
    tsc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    tsc.uni_reports      = sc.uni_reports;
    tsc.has_secret       = sc.has_secret;

    var i: u32 = 0;
    var out: err[fail.Fail] = err[fail.Fail].ok{};
    for (i < count) {
        if ((info.elems_start + i)::usize >= oa.expr_id_len) {
            out = err[fail.Fail].err{fail.message("sema: `$each` array element index out of range")};
            brk;
        }
        val elem_eid: id.ExprId = oa.expr_ids[info.elems_start + i];
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](octx, ?tsc, tsc.caps, oa, tsc.source, elem_eid, ?sc.s.interner);
        context.record_eval_result(?tsc, res_eval);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            out = err[fail.Fail].err{fail.message(R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message)};
            brk;
        }
        var ev: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval);
        each_retype_elem_value(sc.s, ?ev, elem_ty);

        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open_typed(sc.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark: comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail] = comptime.bind_typed(sc.ctx, fname, ev);
        if (sel res_bind.err) {
            val res_close_err: err[fail.Fail] = comptime.frame_close_typed(sc.ctx, mark);
            if (sel res_close_err.err) {
                out = err[fail.Fail].err{res_close_err.err};
                brk;
            }
            out = err[fail.Fail].err{res_bind.err};
            brk;
        }
        val res_body: err[fail.Fail] = visit(data, sc, ce.body_start, ce.body_len);
        val res_close: err[fail.Fail] = comptime.frame_close_typed(sc.ctx, mark);
        if (sel res_body.err) {
            out = err[fail.Fail].err{res_body.err};
            brk;
        }
        if (sel res_close.err) {
            out = err[fail.Fail].err{res_close.err};
            brk;
        }
        i = i + 1;
    }

    ret out;
}

fun each_retype_elem_value(s: *session.Session, ev: *comptime.CTValue, elem_ty: type.TypeId) {
    val opt_et: opt[*type.Type] = type.get_typed(?s.types, type.strip_secret(?s.types, elem_ty));
    if (!sel opt_et.some) { ret; }
    val pd: type.PrimDesc = type.prim_desc(opt_et.some.kind);
    if (ev.kind == comptime.CT_KIND_INT && pd.class == type.PRIM_CLASS_INT) {
        ev.int_unsigned = !pd.signed;
        ev.int_width    = pd.bits::u8;
    }
    if (ev.kind == comptime.CT_KIND_FLOAT && pd.class == type.PRIM_CLASS_FLOAT) {
        ev.float_width = pd.bits::float.FloatWidth;
    }
}

fun infer_stmt_list(sc: *context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val sid: id.StmtId = sc.a.stmt_ids[start + i];
        val res_stmt: err[fail.Fail] = infer_stmt(sc, sid, fn_ret);
        if (sel res_stmt.err) { ret res_stmt; }
        i = i + 1;
        # an exiting chain guards the rest of the block, so the rest is walked inside its frame
        var rest_guard: context.Guard;
        if (guard.open_exit_chain(sc, sid, ?rest_guard)) {
            val res_rest: err[fail.Fail] = infer_stmt_list(sc, start + i, len - i, fn_ret);
            guard.close(sc, ?rest_guard);
            ret res_rest;
        }
    }
    ret err[fail.Fail].ok{};
}

fun gate_probe_ident_is_comptime_param(sc: *context.SemaContext, eid: id.ExprId) bool {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    val sym: *resolve.Symbol = opt_sym.some;
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun gate_probe_is_field_type_operand(sc: *context.SemaContext, eid: id.ExprId) bool {
    ret infer.is_field_type_operand(sc, eid);
}

fun sema_gate_probes() comptime.GateProbes[context.SemaContext] {
    ret comptime.gate_probes[context.SemaContext](
        gate_probe_ident_is_comptime_param, nil, nil, gate_probe_is_field_type_operand, context.comptime_expression);
}

fun gate_chain_depends(sc: *context.SemaContext, probe: comptime.GateProbe,
                       start: u32, len: u32) res[bool, fail.Fail] {
    ret comptime.gate_chain_depends_on[context.SemaContext](sc.a, sc.source, sc, sema_gate_probes(),
                                                            probe, start, len);
}

fun infer_stmt_comptime_if(sc: *context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) err[fail.Fail] {
    val param_gated_r: res[bool, fail.Fail] = gate_chain_depends(sc, comptime.GATE_PROBE_COMPTIME_PARAM, start, len);
    if (sel param_gated_r.err) { ret err[fail.Fail].err{param_gated_r.err}; }
    val param_gated: bool = param_gated_r.ok;
    val has_type_cmp_r: res[bool, fail.Fail] = gate_chain_depends(sc, comptime.GATE_PROBE_TYPE_COMPARISON, start, len);
    if (sel has_type_cmp_r.err) { ret err[fail.Fail].err{has_type_cmp_r.err}; }
    val has_type_cmp: bool = has_type_cmp_r.ok;

    if (has_type_cmp && !param_gated) {
        val pruned_r: res[bool, fail.Fail] = prune_type_comparison_chain(sc, start, len, fn_ret);
        if (sel pruned_r.err)    { ret err[fail.Fail].err{pruned_r.err}; }
        if (pruned_r.ok) { ret err[fail.Fail].ok{}; }
    }

    if (param_gated || has_type_cmp) {
        var chain_bad: bool = false;
        var i: u32 = 0;
        for (i < len) {
            val arm: *decl.ComptimeBranch = ?sc.a.comptime_branches[start + i];
            if (arm.cond != id.EXPR_NIL) {
                val saved_gate: bool = sc.in_comptime_gate;
                sc.in_comptime_gate = true;
                val gate_ty: type.TypeId = infer.infer_expr(sc, arm.cond);
                if (gate_ty == type.TYPE_ERROR) { chain_bad = true; }
                or {
                    val gate_opt: res[expr.Expr, fail.Fail] = context.expression(sc, arm.cond);
                    if (sel gate_opt.ok
                     && !check.check_condition(sc, gate_ty, gate_opt.ok.span)) { chain_bad = true; }
                }
                sc.in_comptime_gate = saved_gate;
                val cg: err[fail.Fail] = check_comptime_gate(sc, arm.cond);
                if (sel cg.err) { ret cg; }
            }
            if (!chain_bad) {
                val saved_def: bool = sc.in_deferred_arm;
                sc.in_deferred_arm  = true;
                val res_body: err[fail.Fail] = infer_comptime_arm(sc, arm, fn_ret);
                sc.in_deferred_arm  = saved_def;
                if (sel res_body.err) { ret res_body; }
            }
            i = i + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var i: u32 = 0;
    for (i < len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[start + i];

        if (br.cond != id.EXPR_NIL) {
            val saved_gate: bool = sc.in_comptime_gate;
            sc.in_comptime_gate = true;
            val gate_ty: type.TypeId = infer.infer_expr(sc, br.cond);
            if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret err[fail.Fail].ok{}; }
            val e_opt: res[expr.Expr, fail.Fail] = context.expression(sc, br.cond);
            var gate_ok: bool = true;
            if (sel e_opt.ok) { gate_ok = check.check_condition(sc, gate_ty, e_opt.ok.span); }
            sc.in_comptime_gate = saved_gate;
            if (!gate_ok) { ret err[fail.Fail].ok{}; }
        }

        val active_r: res[bool, fail.Fail] = stmt_comptime_branch_active(sc, br);
        if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
        if (active_r.ok) {
            ret infer_comptime_arm(sc, br, fn_ret);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a comptime arm is a chain arm: a condition that is exactly `sel P.c` guards `P.c` in its body
fun infer_comptime_arm(sc: *context.SemaContext, br: *decl.ComptimeBranch, fn_ret: type.TypeId) err[fail.Fail] {
    var arm_guard: context.Guard;
    val opened: bool = guard.open_sel(sc, br.cond, ?arm_guard);
    val res_body: err[fail.Fail] = infer_stmt_list(sc, br.body_start, br.body_len, fn_ret);
    if (opened) { guard.close(sc, ?arm_guard); }
    ret res_body;
}

fun stmt_comptime_branch_active(sc: *context.SemaContext, br: *decl.ComptimeBranch) res[bool, fail.Fail] {
    if (br.cond == id.EXPR_NIL) { ret res[bool, fail.Fail].ok{true}; }
    val vr: res[comptime.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, br.cond);
    if (sel vr.err) {
        ret res[bool, fail.Fail].err{vr.err};
    }
    val v: comptime.GateVerdict = vr.ok;
    if (v.outcome == comptime.GATE_FAILED && str_len(v.message) > 0) {
        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        context.report(sc, v.span, v.message);
        sc.in_comptime_gate = saved_gate;
    }
    ret res[bool, fail.Fail].ok{gate_verdict_truth(v)};
}

fun prune_type_comparison_chain(sc: *context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val arm: *decl.ComptimeBranch = ?sc.a.comptime_branches[start + i];
        if (arm.cond == id.EXPR_NIL) {
            val res_body: err[fail.Fail] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (sel res_body.err) { ret res[bool, fail.Fail].err{res_body.err}; }
            ret res[bool, fail.Fail].ok{true};
        }

        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        val gate_ty: type.TypeId = infer.infer_expr(sc, arm.cond);
        if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret res[bool, fail.Fail].ok{true}; }
        val e_opt: res[expr.Expr, fail.Fail] = context.expression(sc, arm.cond);
        var gate_ok: bool = true;
        if (sel e_opt.ok) { gate_ok = check.check_condition(sc, gate_ty, e_opt.ok.span); }
        sc.in_comptime_gate = saved_gate;
        if (!gate_ok) { ret res[bool, fail.Fail].ok{true}; }

        val vr: res[comptime.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, arm.cond);
        if (sel vr.err) {
            ret res[bool, fail.Fail].err{vr.err};
        }
        val v: comptime.GateVerdict = vr.ok;
        if (v.outcome != comptime.GATE_ACTIVE && v.outcome != comptime.GATE_INACTIVE
         && v.outcome != comptime.GATE_AWAITING_TYPES) {
            ret res[bool, fail.Fail].ok{false};
        }
        if (gate_verdict_truth(v)) {
            val res_body: err[fail.Fail] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (sel res_body.err) { ret res[bool, fail.Fail].err{res_body.err}; }
            ret res[bool, fail.Fail].ok{true};
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

fun check_comptime_gate(sc: *context.SemaContext, eid: id.ExprId) err[fail.Fail] {
    if (eid == id.EXPR_NIL) { ret err[fail.Fail].ok{}; }
    val matched_r: res[bool, fail.Fail] = comptime.gate_walk[context.SemaContext](sc.a, sc.source, sc, gate_operand_check, context.comptime_expression, eid);
    if (sel matched_r.err) { ret err[fail.Fail].err{matched_r.err}; }
    ret err[fail.Fail].ok{};
}

fun gate_operand_check(sc: *context.SemaContext, eid: id.ExprId, e: *expr.Expr) comptime.GateNodeVerdict {
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_BINARY) {
        if (comptime.is_type_comparison_binary(sc.a, sc.source, ?e.data.binary,
                infer.is_field_type_operand(sc, e.data.binary.lhs),
                infer.is_field_type_operand(sc, e.data.binary.rhs))) {
            ret comptime.GATE_NODE_PRUNE;
        }
        ret comptime.GATE_NODE_NO;
    }
    if (k == expr.EXPR_KIND_UNARY) {
        if (e.data.unary.op == expr.UN_DEREF || e.data.unary.op == expr.UN_ADDR) {
            context.report(sc, e.span, "comptime `$if` gate is not a compile-time constant");
            ret comptime.GATE_NODE_PRUNE;
        }
        ret comptime.GATE_NODE_NO;
    }

    if (k == expr.EXPR_KIND_CALL
     && (comptime.is_type_query_call(sc.a, sc.source, eid) || comptime.is_layout_intrinsic_call(sc.a, sc.source, eid))) {
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_INDEX) { ret comptime.GATE_NODE_NO; }
    if (k == expr.EXPR_KIND_CAST)  { ret comptime.GATE_NODE_NO; }

    if (k == expr.EXPR_KIND_LIT_INT || k == expr.EXPR_KIND_LIT_FLOAT
     || k == expr.EXPR_KIND_LIT_CHAR || k == expr.EXPR_KIND_LIT_STR) {
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_COMPTIME_IDENT) {
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
        context.record_eval_result(sc, res_eval);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            context.report(sc, e.span, R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message);
        }
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_IDENT) {
        val opt_sym: opt[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
        if (!sel opt_sym.some) { ret comptime.GATE_NODE_PRUNE; }
        val sym: *resolve.Symbol = opt_sym.some;
        if (resolve.symbol_is_runtime(sym)) {
            if (sym.kind == resolve.SYM_PARAM) {
                check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime parameter '", sym.name, "'", "comptime `$if` gate cannot reference a runtime parameter");
                ret comptime.GATE_NODE_PRUNE;
            }
            check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
            ret comptime.GATE_NODE_PRUNE;
        }
        if (sym.kind == resolve.SYM_PARAM) { ret comptime.GATE_NODE_PRUNE; }
        if (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_IMPORTED) {
            val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
            context.record_eval_result(sc, res_eval);
            if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval) && !check.imported_module_const_sym(sc, sym)) {
                check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
            }
            ret comptime.GATE_NODE_PRUNE;
        }
        check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_MEMBER) {
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
        context.record_eval_result(sc, res_eval);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            val opt_sym: opt[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
            if (sel opt_sym.some) {
                if (!check.imported_module_const_sym(sc, opt_sym.some)) {
                    context.report(sc, e.span, "comptime `$if` gate is not a compile-time constant");
                }
            }
            or { context.report(sc, e.span, "comptime `$if` gate is not a compile-time constant"); }
        }
        ret comptime.GATE_NODE_PRUNE;
    }

    context.report(sc, e.span, "comptime `$if` gate is not a compile-time constant");
    ret comptime.GATE_NODE_PRUNE;
}

fun infer_local_decl(sc: *context.SemaContext, did: id.DeclId) err[fail.Fail] {
    if (did == id.DECL_NIL) { ret err[fail.Fail].ok{}; }
    val opt_decl: opt[*decl.Decl] = ast.get_decl_typed(sc.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *decl.Decl = opt_decl.some;
    if (d.kind > decl.DECL_KIND_TAG && d.kind != decl.DECL_KIND_ERROR) {
        val message: str = resolve.unknown_catalog(sc.s, "DeclKind", d.kind::u32);
        fail.internal(?sc.status, message);
        ret err[fail.Fail].err{fail.message(message)};
    }
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) {
        ret err[fail.Fail].ok{};
    }

    val ty: type.TypeId = infer.infer_decl(sc, did);
    if (sc.decl_type != nil) { sc.decl_type[did] = ty; }

    if (type.is_case_selector(?sc.s.types, ty)) {
        context.report(sc, d.span, "a case selector is not a value; it cannot be stored, assigned, or passed as a value");
    }

    if (type_carries_handle(sc, ty)) {
        context.report(sc, d.span,
            "a handle cannot be a local binding: a local is storage the program owns, and a handle's representation is not the program's, so there is nothing that may be written into it. hand the handle straight to the operation that consumes it instead of naming it first");
    }

    if (type_carries_abi_type(sc, ty)) {
        context.report(sc, d.span, abitype.exclusion_message());
    }

    if (d.data.bind.init != id.EXPR_NIL) {
        val actual: type.TypeId = infer.infer_expr(sc, d.data.bind.init);
        if (type.is_case_selector(?sc.s.types, actual)) {
            context.report(sc, d.span, "a case selector is not a value");
            ret err[fail.Fail].ok{};
        }
        if (d.data.bind.ty != id.TYPE_NIL && ty != type.TYPE_NIL
            && ty != type.TYPE_ERROR && actual != type.TYPE_ERROR) {
            check_binding(sc, ty, d.data.bind.init, actual, d.span);
        }
    }
    ret err[fail.Fail].ok{};
}

fun check_binding(sc: *context.SemaContext, expected: type.TypeId, eid: id.ExprId, actual: type.TypeId, span: token.Span) {
    check.check_coercible(sc, expected, eid, actual, span);
}

fun check_return_stmt(sc: *context.SemaContext, ret_type: type.TypeId, value: id.ExprId, span: token.Span) {
    if (value == id.EXPR_NIL) {
        check.check_return(sc, ret_type, type.TYPE_NIL, span);
        ret;
    }
    val value_ty: type.TypeId = infer.infer_expr(sc, value);
    if (ret_type == type.TYPE_NIL || ret_type == type.TYPE_ERROR
        || value_ty == type.TYPE_ERROR || value_ty == type.TYPE_NIL) {
        check.check_return(sc, ret_type, value_ty, span);
        ret;
    }
    check.check_coercible(sc, ret_type, value, value_ty, span);
}

fun comptime_branch_active(sc: *context.SemaContext, br: *decl.ComptimeBranch) res[bool, fail.Fail] {
    if (br.cond == id.EXPR_NIL) { ret res[bool, fail.Fail].ok{true}; }
    ret decl_gate_is_active(sc, br.cond);
}

fun build_result(sc: *context.SemaContext) res[context.SemaResult, fail.Fail] {
    if (sel sc.status.kind.internal) {
        val f: fail.Fail = fail.phase_failure(sc.status);
        dnit_context(sc);
        ret res[context.SemaResult, fail.Fail].err{f};
    }
    var graph: fields.Graph = fields.init(sc.s.alloc);
    if (sel sc.status.kind.accepted) {
        var roots: [3]fields.Roots;
        roots[0] = fields.Roots{ data: sc.expr_type, len: sc.a.expr_len };
        roots[1] = fields.Roots{ data: sc.type_resolved_ty, len: sc.a.type_len };
        roots[2] = fields.Roots{ data: sc.decl_type, len: sc.a.decl_len };
        val captured: res[fields.Graph, fail.Fail] = fields.captured_of(fields.capture[context.SemaContext](sc.s, sc.s.alloc,
            ?roots[0], 3, fields.MATERIALIZED, sc.ctx.env.target_defs, sc, infer.prepare_nominal_recipe));
        if (sel captured.err) {
            val reason: fail.Fail = captured.err;
            dnit_context(sc);
            ret res[context.SemaResult, fail.Fail].err{reason};
        }
        graph = captured.ok;
    }
    ret finish_result(sc, graph);
}

fun finish_result(sc: *context.SemaContext, graph: fields.Graph) res[context.SemaResult, fail.Fail] {
    if (sel sc.status.kind.internal) {
        val reason: fail.Fail = fail.phase_failure(sc.status);
        var owned: fields.Graph = graph;
        fields.dnit(?owned);
        dnit_context(sc);
        ret res[context.SemaResult, fail.Fail].err{reason};
    }
    var out: context.SemaResult;
    out.field_graph      = graph;
    out.status           = sc.status;
    out.alloc            = sc.s.alloc;
    out.expr_type        = sc.expr_type;
    out.type_resolved_ty = sc.type_resolved_ty;
    out.decl_type        = sc.decl_type;
    out.expr_count       = sc.a.expr_len::u32;
    out.type_count       = sc.a.type_len::u32;
    out.decl_count       = sc.a.decl_len::u32;
    out.embed_paths      = sc.embed_paths;
    out.embed_path_count = sc.embed_path_len;

    sc.expr_type        = nil;
    sc.type_resolved_ty = nil;
    sc.decl_type        = nil;
    out.embed_path_cap  = sc.embed_path_cap;
    sc.embed_paths      = nil;
    sc.embed_path_cap   = 0;
    sc.embed_path_len   = 0;
    dnit_context(sc);

    ret res[context.SemaResult, fail.Fail].ok{out};
}

use page: std.allocator.page;
use std.types.string.str_contains;
use mach.lang.fe.ast.interpretation;

test "mach.lang.fe.sema:unknown_syntax_and_operator_tags_never_become_error_types_without_failure" {
    var alloc: A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var s: session.Session = session.Session{};
    s.alloc = ?alloc;
    s.interner = intern.init(?alloc);
    fin { intern.dnit(?s.interner); }
    var ex: expr.Expr = expr.Expr{kind: 200};
    var de: decl.Decl = decl.Decl{kind: 200};
    var ty: atype.Type = atype.Type{kind: 200};
    var st: stmt.Stmt = stmt.Stmt{kind: 200};
    var choice: interpretation.Choice = interpretation.PARSED;
    var rr: resolve.ResolveResult = resolve.ResolveResult{expr_choices: ?choice, expr_choices_count: 1};
    var a: ast.Ast = ast.Ast{exprs: ?ex, expr_len: 1, decls: ?de, decl_len: 1,
        types: ?ty, type_len: 1, stmts: ?st, stmt_len: 1};
    var sc: context.SemaContext = context.SemaContext{s: ?s, a: ?a, rr: ?rr};
    val names: [7]str = [7]str{"ExprKind", "BinOp", "UnOp", "DeclKind", "AstTypeKind", "StmtKind", "DeclKind"};
    var i: usize = 0;
    for (i < 7) {
        sc.status = fail.accepted();
        var result: type.TypeId = type.TYPE_ERROR;
        if (i < 3) {
            if (i == 1) { ex.kind = expr.EXPR_KIND_BINARY; ex.data.binary.op = 200; }
            if (i == 2) { ex.kind = expr.EXPR_KIND_UNARY; ex.data.unary.op = 200; }
            result = infer.infer_expr(?sc, 0);
        }
        or (i == 3) { result = infer.infer_decl(?sc, 0); }
        or (i == 4) { result = infer.resolve_type_ref(?sc, 0); }
        or {
            if (i == 6) { st.kind = stmt.STMT_KIND_DECL; st.data.decl.decl = 0; }
            val infer_stmt_2: err[fail.Fail] = infer_stmt(?sc, 0, type.TYPE_NIL);
            if (sel infer_stmt_2.ok) { ret 2; }
        }
        if (result != type.TYPE_ERROR) { ret 3; }
        if (!sel sc.status.kind.internal) { ret 3; }
        if (sc.status.rejections != 0) { ret 3; }
        if (!str_contains(fail.status_text(sc.status), names[i]) || !str_contains(fail.status_text(sc.status), "200")) { ret 4; }
        i = i + 1;
    }
    sc.status = fail.accepted();
    ex.kind = expr.EXPR_KIND_ERROR;
    de.kind = decl.DECL_KIND_USE;
    ty.kind = atype.TYPE_KIND_ERROR;
    st.kind = stmt.STMT_KIND_ASM;
    if (infer.infer_expr(?sc, 0) != type.TYPE_ERROR || infer.infer_decl(?sc, 0) != type.TYPE_NIL
        || infer.resolve_type_ref(?sc, 0) != type.TYPE_ERROR) { ret 5; }
    val inferred_stmt: err[fail.Fail] = infer_stmt(?sc, 0, type.TYPE_NIL);
    if (sel inferred_stmt.err) { ret 5; }
    st.kind = stmt.STMT_KIND_ERROR;
    val infer_stmt_3: err[fail.Fail] = infer_stmt(?sc, 0, type.TYPE_NIL);
    if (sel infer_stmt_3.err) { ret 6; }
    if (!sel sc.status.kind.accepted) { ret 6; }
    ret 0;
}
