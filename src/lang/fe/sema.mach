fun semantic_name_caps() res[comptime.PhaseCapabilities[sema_context.SemaContext], fail.Fail] {
    ret comptime.semantic_name_capabilities[sema_context.SemaContext](
        sema_context.resolve_module_member_const,
        sema_context.comptime_ident_is_runtime, sema_context.comptime_expression);
}

fun semantic_type_caps() res[comptime.PhaseCapabilities[sema_context.SemaContext], fail.Fail] {
    ret comptime.semantic_type_capabilities[sema_context.SemaContext](
        sema_context.resolve_module_member_const,
        sema_context.resolve_type_comparison_operand,
        infer.resolve_field_member,
        infer.resolve_type_query,
        infer.resolve_layout_intrinsic,
        resolve_scalar_cast, resolve_scalar_value,
        sema_context.comptime_ident_is_runtime, sema_context.comptime_expression);
}

fun resolve_scalar_value(sc: *sema_context.SemaContext, eid: ast_id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    if (sc.view.expr_type == nil || ast_id.expr_index(eid)::usize >= sc.view.a.expr_len) {
        ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_NEEDS_TYPES, diagnostic_kind.COMPTIME_TYPE_UNRESOLVED, "comptime scalar expression type is not resolved")};
    }
    val ty: type.TypeId = sema_context.apply_subst(sc, sc.view.expr_type[ast_id.expr_index(eid)]);
    ret comptime.cast_scalar(?sc.s.types, sc.view.ctx.env.pointer_width, sc.view.ctx.env.nan_rule, value, ty, ty, false);
}

fun resolve_scalar_cast(sc: *sema_context.SemaContext, eid: ast_id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val expression_r: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, eid);
    if (sel expression_r.err) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(expression_r.err))}; }
    val node: ast_expr.Expr = expression_r.ok;
    if (node.kind != ast_expr.EXPR_KIND_CAST) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "semantic cast capability requires a cast expression")}; }
    if (sc.view.expr_type == nil || ast_id.expr_index(node.data.cast.value)::usize >= sc.view.a.expr_len) {
        ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_NEEDS_TYPES, diagnostic_kind.COMPTIME_TYPE_UNRESOLVED, "comptime cast operand type is not resolved")};
    }
    ret comptime.cast_scalar(?sc.s.types, sc.view.ctx.env.pointer_width, sc.view.ctx.env.nan_rule, value,
        sema_context.apply_subst(sc, sc.view.expr_type[ast_id.expr_index(node.data.cast.value)]), sema_context.resolved_type_of(sc, node.data.cast.ty), node.data.cast.reinterpret);
}

# type a module in a scope over the load's, `load`, and resolve's bindings in `rr`, which sema
# reads and never writes; what sema binds is its result's
pub fun sema(
    s: *session.Session,
    a: *ast.Ast,
    rr: *resolve.ResolveResult,
    deps: *sema_product.SemaDeps,
    load: *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    diags: *diagnostic.DiagnosticStore) res[sema_product.SemaResult, fail.Fail] {
    var scope: comptime.ComptimeCtx = comptime.stage_init(load, comptime.STAGE_SEMA, s.alloc);
    fin { comptime.dnit(?scope); }
    if (rr != nil) { comptime.layer_set(?scope, comptime.STAGE_RESOLVE, ?rr.constants); }
    val gates: err[fail.Fail] = comptime.prepare_gates(?scope, a.expr_len::u32);
    if (sel gates.err) { ret res[sema_product.SemaResult, fail.Fail].err{gates.err}; }
    var sc:          sema_context.SemaContext;
    var uni_reports: sema_context.UniReports;
    uni_reports.len = 0;
    var handle_reports: sema_context.UniReports;
    handle_reports.len = 0;

    val res_init: err[fail.Fail] = init_context(?sc, s, a, rr, deps, ?scope, own_module, diags);
    if (sel res_init.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_init.err}; }
    fin { dnit_context(?sc); }
    if (refused_module(?sc)) { ret finish_result(?sc, fields.init(s.alloc)); }

    val res_embeds: err[fail.Fail] = resolve_all_embeds(?sc);
    if (sel res_embeds.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_embeds.err}; }

    val res_types: err[fail.Fail] = resolve_all_types(?sc);
    if (sel res_types.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_types.err}; }

    val analyzed: res[sema_growth.Analysis, fail.Fail] = sema_growth.analyze(s, a, rr, sc.view.source, own_module, s.alloc);
    if (sel analyzed.err) { ret res[sema_product.SemaResult, fail.Fail].err{analyzed.err}; }
    var growth: sema_growth.Analysis = analyzed.ok;
    fin { sema_growth.dnit(?growth); }
    sc.typing.growth = ?growth;
    growth_refusals_report(?sc);

    val res_decls: err[fail.Fail] = infer_all_decls(?sc);
    if (sel res_decls.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_decls.err}; }

    val res_occurs: err[fail.Fail] = infer.check_occurs_all(?sc);
    if (sel res_occurs.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_occurs.err}; }

    val res_uni_secrecy: err[fail.Fail] = infer.check_uni_secrecy_all(?sc);
    if (sel res_uni_secrecy.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_uni_secrecy.err}; }

    check_handle_fields_all(?sc);

    sc.typing.has_secret  = sema_context.recover[bool](?sc, generics.module_reaches_secret(s, sc.view.type_resolved_ty, a.type_len::u32), false);
    sc.typing.uni_reports = ?uni_reports;
    check_annotation_uni_secrecy_all(?sc);
    sc.typing.handle_reports = ?handle_reports;
    check_annotation_handles_all(?sc);

    val caps_r: res[comptime.PhaseCapabilities[sema_context.SemaContext], fail.Fail] = semantic_type_caps();
    if (sel caps_r.err) { ret res[sema_product.SemaResult, fail.Fail].err{caps_r.err}; }
    sc.typing.caps = caps_r.ok;
    val res_bodies: err[fail.Fail] = infer_all_bodies(?sc);
    if (sel res_bodies.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_bodies.err}; }

    val res_reval: err[fail.Fail] = drain_instances(?sc, deps);
    if (sel res_reval.err) { ret res[sema_product.SemaResult, fail.Fail].err{res_reval.err}; }
    val reached: err[fail.Fail] = sema_instance.reach_settle(?sc.typing.insts.set);
    if (sel reached.err) { ret res[sema_product.SemaResult, fail.Fail].err{reached.err}; }

    check_float_literals(?sc);
    check_literal_shifts(?sc);

    val defaults: err[fail.Fail] = check_default_literals(?sc);
    if (sel defaults.err) { ret res[sema_product.SemaResult, fail.Fail].err{defaults.err}; }

    val notices: err[fail.Fail] = warn_deprecated_uses(?sc);
    if (sel notices.err) { ret res[sema_product.SemaResult, fail.Fail].err{notices.err}; }

    val confined: err[fail.Fail] = check_testing_uses(?sc);
    if (sel confined.err) { ret res[sema_product.SemaResult, fail.Fail].err{confined.err}; }

    ret build_result(?sc);
}

# a growing cycle no comptime gate stops is refused at its growing call, naming the
# templates on it, before any instance of it is made
fun growth_refusals_report(sc: *sema_context.SemaContext) {
    val an: *sema_growth.Analysis = sc.typing.growth;
    var i:  usize                 = 0;
    for (i < an.cycles.len) {
        val c: *sema_growth.Cycle = ?an.cycles.data[i];
        if (c.refused) {
            val msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
                "`{}` instantiates `{}` here at an argument that grows, on a cycle of instances no comptime gate can stop ({}), so its instances never end",
                intern.text(?sc.s.interner, c.caller), intern.text(?sc.s.interner, c.callee), intern.text(?sc.s.interner, c.members));
            if (sel msg.err) { fail.internal(?sc.status, fail.describe(fail.format_refused(msg.err))); }
            or (sel msg.ok) {
                sema_context.report_note(sc, diagnostic_kind.GENERIC_GROWING_CYCLE, c.site, msg.ok,
                    "an instance on this cycle asks for a new instance at every step; put the growing call under a comptime gate that ends it");
                str_free(sc.s.alloc, msg.ok);
            }
        }
        i = i + 1;
    }
}

# resolve refused this module with its own diagnostic and bound nothing else, so there is
# nothing to type, and the refusal is this pass's answer too
fun refused_module(sc: *sema_context.SemaContext) bool {
    if (sc.view.rr == nil || !sc.view.rr.refused) { ret false; }
    fail.reject(?sc.status);
    ret true;
}

fun copy_typeids(dst: *type.TypeId, src: *type.TypeId, n: usize) {
    var i: u32 = 0;
    for (i < n::u32) {
        dst[i] = src[i];
        i      = i + 1;
    }
}

fun free_typeids(alloc: *A.Allocator, arr: *type.TypeId, n: usize) {
    if (arr != nil && n > 0) { A.deallocate[type.TypeId](alloc, arr, n); }
}

# types every instance the module's typing asks for, in the order asked; typing one may
# ask for more
fun drain_instances(sc: *sema_context.SemaContext, deps: *sema_product.SemaDeps) err[fail.Fail] {
    val wl: *sema_context.InstWorklist = sc.typing.insts;
    for (wl.drained < sema_instance.count(?wl.set)) {
        val r: err[fail.Fail] = instance_type(sc, deps, wl.drained);
        if (sel r.err) { ret r; }
        wl.drained = wl.drained + 1;
    }
    ret err[fail.Fail].ok{};
}

# a module's view of the declaring module of an instance: its own, or a foreign one read
# through a scope of its own, so the body binds nothing there
fun origin_view(sc: *sema_context.SemaContext, deps: *sema_product.SemaDeps, origin: session.ModuleId, foreign: *comptime.ComptimeCtx) res[sema_context.ModuleView, fail.Fail] {
    var v: sema_context.ModuleView = sema_context.ModuleView{};
    v.own_module = origin;
    if (module.same(origin, sc.view.own_module)) {
        v.a                = sc.view.a;
        v.rr               = sc.view.rr;
        v.ctx              = sc.view.ctx;
        v.source           = sc.view.source;
        v.decl_type        = sc.view.decl_type;
        v.type_resolved_ty = sc.view.type_resolved_ty;
        v.expr_type        = sc.view.expr_type;
        ret res[sema_context.ModuleView, fail.Fail].ok{v};
    }
    if (deps == nil) { ret res[sema_context.ModuleView, fail.Fail].err{fail.message("instance typing has no definition acquisition capability")}; }
    val acquired: res[sema_product.Definition, fail.Fail] = sema_product.acquire_definition(?deps.definitions, origin, sema_product.DEFINITION_TYPED);
    if (sel acquired.err) {
        val failure: fail.Fail = acquired.err;
        if (sel failure.reported) { fail.reject(?sc.status); }
        or                        { fail.internal(?sc.status, fail.describe(failure)); }
        ret res[sema_context.ModuleView, fail.Fail].err{failure};
    }
    val definition: sema_product.Definition = acquired.ok;
    @foreign           = comptime.reader_init(definition.ctx);
    v.a                = definition.parsed.a;
    v.rr               = definition.rr;
    v.ctx              = foreign;
    v.decl_type        = definition.sr.decl_type;
    v.type_resolved_ty = definition.sr.type_resolved_ty;
    v.expr_type        = definition.sr.expr_type;
    if (v.a == nil || v.decl_type == nil) { ret res[sema_context.ModuleView, fail.Fail].err{fail.message("internal: instance typing: origin module decl table unavailable (dependency-ordering invariant violated)")}; }
    val source_r: res[str, fail.Fail] = source_text_of(sc.s, v.a);
    if (sel source_r.err) { ret res[sema_context.ModuleView, fail.Fail].err{source_r.err}; }
    v.source = source_r.ok;
    ret res[sema_context.ModuleView, fail.Fail].ok{v};
}

# types instance `index` into its frame: a generic under its type arguments, a function with
# comptime value parameters with them bound, a function with a pack over its element types
fun instance_type(sc: *sema_context.SemaContext, deps: *sema_product.SemaDeps, index: u32) err[fail.Fail] {
    val item:    sema_instance.Instance = @sema_instance.at(?sc.typing.insts.set, index);
    var foreign: comptime.ComptimeCtx   = comptime.reader_init(sc.view.ctx);
    fin { comptime.dnit(?foreign); }
    val view_r: res[sema_context.ModuleView, fail.Fail] = origin_view(sc, deps, item.origin, ?foreign);
    if (sel view_r.err) { ret err[fail.Fail].err{view_r.err}; }
    val origin: sema_context.ModuleView = view_r.ok;
    val oa:     *ast.Ast                = origin.a;

    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(oa, item.decl);
    if (!sel d_opt.some) { ret err[fail.Fail].err{fail.message("internal: instance typing: instance decl id out of range in origin AST (invariant violated)")}; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind != ast_decl.DECL_KIND_FUN)     { ret err[fail.Fail].err{fail.message("internal: instance typing: instance decl is not a function (invariant violated)")}; }
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    var owner: type.GenericOwner;
    if (item.arg_len > 0) {
        val who_r: res[type.GenericOwner, fail.Fail] = sema_context.generic_owner_of_decl(sc.s, oa, item.origin, item.decl);
        if (sel who_r.err) { ret err[fail.Fail].err{who_r.err}; }
        owner = who_r.ok;
    }

    var scratch_expr: *type.TypeId = nil;
    var scratch_decl: *type.TypeId = nil;
    fin {
        free_typeids(sc.s.alloc, scratch_expr, oa.expr_len);
        free_typeids(sc.s.alloc, scratch_decl, oa.decl_len);
    }
    if (oa.expr_len > 0) {
        val re: res[*type.TypeId, fail.Fail] = typeid_array_alloc(sc.s.alloc, oa.expr_len);
        if (sel re.err) { ret err[fail.Fail].err{re.err}; }
        scratch_expr = re.ok;
        if (origin.expr_type != nil) { copy_typeids(scratch_expr, origin.expr_type, oa.expr_len); }
    }
    if (oa.decl_len > 0) {
        val rd: res[*type.TypeId, fail.Fail] = typeid_array_alloc(sc.s.alloc, oa.decl_len);
        if (sel rd.err) { ret err[fail.Fail].err{rd.err}; }
        scratch_decl = rd.ok;
        copy_typeids(scratch_decl, origin.decl_type, oa.decl_len);
    }

    val caps_r: res[comptime.PhaseCapabilities[sema_context.SemaContext], fail.Fail] = semantic_type_caps();
    if (sel caps_r.err) { ret err[fail.Fail].err{caps_r.err}; }

    var view: sema_context.ModuleView = origin;
    view.expr_type = scratch_expr;
    view.decl_type = scratch_decl;
    var typing: sema_context.Typing = sc.typing;
    typing.deps          = deps;
    typing.caps          = caps_r.ok;
    typing.collect_insts = true;
    var instance: sema_context.Instance = sema_context.Instance{};
    instance.depth       = item.depth + 1;
    instance.parent      = index;
    instance.frame       = item.frame;
    instance.requester   = index;
    instance.pack_types  = item.pack;
    instance.pack_len    = item.pack_len;
    instance.quiet       = item.kind != sema_instance.KIND_TYPE;
    instance.site        = item.site;
    instance.site_file   = item.site_file;
    instance.site_set    = true;
    instance.subst       = item.args;
    instance.subst_len   = item.arg_len;
    instance.subst_owner = owner;
    var tsc: sema_context.SemaContext = sema_context.init(sc.s, sc.diags, typing, view, instance);
    fin { fail.merge(?sc.status, tsc.status); }
    tsc.walk.silent = instance.quiet;

    var bound: comptime.FrameMark;
    if (item.value_len > 0) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(tsc.view.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        bound = mark_r.ok;
        var vi: u32 = 0;
        for (vi < item.value_len) {
            val put: err[fail.Fail] = comptime.bind(tsc.view.ctx, item.names[vi], item.values[vi]);
            if (sel put.err) {
                val closed: err[fail.Fail] = comptime.frame_close(tsc.view.ctx, bound);
                if (sel closed.err) { ret closed; }
                ret put;
            }
            vi = vi + 1;
        }
    }

    val ret_ty: type.TypeId = sema_context.resolved_type_of(?tsc, d.data.fun_.return_type);
    sema_context.check_handle_in_array(?tsc, ret_ty, d.data.fun_.name);
    var pi: u32 = 0;
    for (pi < d.data.fun_.params_len) {
        val ptn: *ast_decl.TypedName = ?oa.typed_names[d.data.fun_.params_start + pi];
        generics.check_annotation(?tsc, ptn.ty);
        if (ast_id.type_index(ptn.ty) < oa.type_len::u32) {
            sema_context.check_handle_in_array(?tsc, sema_context.apply_subst(?tsc, tsc.view.type_resolved_ty[ast_id.type_index(ptn.ty)]), ptn.name);
        }
        pi = pi + 1;
    }
    val outcome: err[fail.Fail] = infer_stmt(?tsc, d.data.fun_.body, ret_ty);
    if (!tsc.instance.quiet) { check_instance_float_literals(?tsc, origin.expr_type); }
    tsc.instance.site_set = false;
    tsc.walk.offer        = nil;
    if (item.value_len > 0) {
        val closed: err[fail.Fail] = comptime.frame_close(tsc.view.ctx, bound);
        if (sel closed.err) { ret closed; }
    }
    ret outcome;
}

fun init_context(
    sc: *sema_context.SemaContext,
    s: *session.Session,
    a: *ast.Ast,
    rr: *resolve.ResolveResult,
    deps: *sema_product.SemaDeps,
    ctx: *comptime.ComptimeCtx,
    own_module: session.ModuleId,
    diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    val caps_r: res[comptime.PhaseCapabilities[sema_context.SemaContext], fail.Fail] = semantic_name_caps();
    if (sel caps_r.err) { ret err[fail.Fail].err{caps_r.err}; }
    val source_r: res[str, fail.Fail] = source_text_of(s, a);
    if (sel source_r.err) { ret err[fail.Fail].err{source_r.err}; }
    var view: sema_context.ModuleView = sema_context.ModuleView{};
    view.a          = a;
    view.rr         = rr;
    view.ctx        = ctx;
    view.own_module = own_module;
    view.source     = source_r.ok;
    var typing: sema_context.Typing = sema_context.Typing{};
    typing.deps                = deps;
    typing.caps                = caps_r.ok;
    typing.collect_insts       = true;
    typing.subst_fn            = generics.substitute;
    typing.annotation_check_fn = generics.check_annotation;
    @sc                        = sema_context.init(s, diags, typing, view, sema_context.instance_none());

    val worklist: res[*sema_context.InstWorklist, fail.Fail] = sema_context.inst_worklist_new(s.alloc);
    if (sel worklist.err) { ret err[fail.Fail].err{worklist.err}; }
    sc.typing.insts = worklist.ok;

    if (a.expr_len > 0) {
        val res_expr: res[*type.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.expr_len);
        if (sel res_expr.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_expr.err};
        }
        sc.view.expr_type = res_expr.ok;
    }
    if (a.type_len > 0) {
        val res_type: res[*type.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.type_len);
        if (sel res_type.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_type.err};
        }
        sc.view.type_resolved_ty = res_type.ok;

        val res_memo: res[*u8, fail.Fail] = memo_array_alloc(s.alloc, a.type_len);
        if (sel res_memo.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_memo.err};
        }
        sc.view.type_resolved_memo = res_memo.ok;

        val res_emb: res[*u64, fail.Fail] = embed_len_array_alloc(s.alloc, a.type_len);
        if (sel res_emb.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_emb.err};
        }
        sc.view.embed_len = res_emb.ok;
    }
    if (a.decl_len > 0) {
        val res_decl: res[*type.TypeId, fail.Fail] = typeid_array_alloc(s.alloc, a.decl_len);
        if (sel res_decl.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_decl.err};
        }
        sc.view.decl_type = res_decl.ok;

        val res_lay: res[*u8, fail.Fail] = layout_state_alloc(s.alloc, a.decl_len);
        if (sel res_lay.err) {
            dnit_context(sc);
            ret err[fail.Fail].err{res_lay.err};
        }
        sc.view.layout_state = res_lay.ok;
    }

    val res_seed: err[fail.Fail] = infer.seed_builtins(sc);
    if (sel res_seed.err) {
        dnit_context(sc);
        ret res_seed;
    }

    ret err[fail.Fail].ok{};
}

fun typeid_array_alloc(a: *A.Allocator, len: usize) res[*type.TypeId, fail.Fail] {
    val res_arr: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](a, len);
    if (sel res_arr.err) { ret res[*type.TypeId, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *type.TypeId = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = type.TYPE_NIL;
        i      = i + 1;
    }
    ret res[*type.TypeId, fail.Fail].ok{arr};
}

fun layout_state_alloc(a: *A.Allocator, len: usize) res[*u8, fail.Fail] {
    val res_arr: res[*u8, A.Error] = A.allocate[u8](a, len);
    if (sel res_arr.err) { ret res[*u8, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u8 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = sema_context.LAYOUT_PENDING;
        i      = i + 1;
    }
    ret res[*u8, fail.Fail].ok{arr};
}

fun embed_len_array_alloc(a: *A.Allocator, len: usize) res[*u64, fail.Fail] {
    val res_arr: res[*u64, A.Error] = A.allocate[u64](a, len);
    if (sel res_arr.err) { ret res[*u64, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u64 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = sema_product.EMBED_LEN_NONE;
        i      = i + 1;
    }
    ret res[*u64, fail.Fail].ok{arr};
}

fun memo_array_alloc(a: *A.Allocator, len: usize) res[*u8, fail.Fail] {
    val res_arr: res[*u8, A.Error] = A.allocate[u8](a, len);
    if (sel res_arr.err) { ret res[*u8, fail.Fail].err{fail.refused(res_arr.err)}; }
    val arr: *u8 = res_arr.ok;

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = sema_context.TYPE_MEMO_NONE;
        i      = i + 1;
    }
    ret res[*u8, fail.Fail].ok{arr};
}

fun source_text_of(s: *session.Session, a: *ast.Ast) res[str, fail.Fail] {
    val opt_file: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel opt_file.none) { ret res[str, fail.Fail].err{fail.message("sema: module source not registered")}; }
    ret res[str, fail.Fail].ok{opt_file.some.text};
}

fun dnit_context(sc: *sema_context.SemaContext) {
    if (sc.view.expr_type != nil && sc.view.a.expr_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.view.expr_type, sc.view.a.expr_len);
    }
    if (sc.view.type_resolved_ty != nil && sc.view.a.type_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.view.type_resolved_ty, sc.view.a.type_len);
    }
    if (sc.view.decl_type != nil && sc.view.a.decl_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.view.decl_type, sc.view.a.decl_len);
    }
    if (sc.view.type_resolved_memo != nil && sc.view.a.type_len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.view.type_resolved_memo, sc.view.a.type_len);
    }
    if (sc.view.layout_state != nil && sc.view.a.decl_len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.view.layout_state, sc.view.a.decl_len);
    }
    if (sc.view.embed_len != nil && sc.view.a.type_len > 0) {
        A.deallocate[u64](sc.s.alloc, sc.view.embed_len, sc.view.a.type_len);
    }
    if (sc.view.embed_paths != nil && sc.view.embed_path_cap > 0) {
        A.deallocate[intern.StrId](sc.s.alloc, sc.view.embed_paths, sc.view.embed_path_cap::usize);
    }
    sc.view.embed_len          = nil;
    sc.view.embed_paths        = nil;
    sc.view.embed_path_len     = 0;
    sc.view.embed_path_cap     = 0;
    sc.view.expr_type          = nil;
    sc.view.type_resolved_ty   = nil;
    sc.view.type_resolved_memo = nil;
    sc.view.layout_state       = nil;
    sc.view.decl_type          = nil;
    sema_context.inst_worklist_dnit(sc);
}

fun check_annotation_handles_all(sc: *sema_context.SemaContext) {
    if (sc.view.type_resolved_ty == nil) { ret; }
    var i: u32 = 0;
    for (i < sc.view.a.type_len::u32) {
        generics.check_annotation_handles(sc, ast_id.type(i));
        i = i + 1;
    }
}

fun check_annotation_uni_secrecy_all(sc: *sema_context.SemaContext) {
    if (!sc.typing.has_secret)           { ret; }
    if (sc.view.type_resolved_ty == nil) { ret; }
    var i: u32 = 0;
    for (i < sc.view.a.type_len::u32) {
        generics.check_annotation_uni_secrecy(sc, ast_id.type(i));
        i = i + 1;
    }
}

fun resolve_all_types(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.type_resolved_ty == nil) { ret err[fail.Fail].ok{}; }
    val outer: sema_context.Walk = sema_context.walk_open(sc);
    sc.walk.type_prepass = true;
    var i: u32 = 0;
    for (i < sc.view.a.type_len::u32) {
        sc.view.type_resolved_ty[i] = infer.resolve_type_ref(sc, ast_id.type(i));
        i                           = i + 1;
    }
    sema_context.walk_close(sc, outer);
    ret err[fail.Fail].ok{};
}

fun resolve_all_embeds(sc: *sema_context.SemaContext) err[fail.Fail] {
    val opt_module: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *ast_module.Module = opt_module.some;
    ret resolve_embeds_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun resolve_embeds_in_list(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did: ast_id.DeclId  = sc.view.a.decl_ids[start + i];
        val r:   err[fail.Fail] = resolve_embeds_one(sc, did);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun resolve_embeds_one(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        val ci: *ast_decl.DeclComptimeIf = ?d.data.comptime_if;
        if (comptime_gate.comptime_if_declares_nothing(sc.view.a, ci.branches_start, ci.branches_len)) {
            ret err[fail.Fail].ok{};
        }
        var b: u32 = 0;
        for (b < ci.branches_len) {
            val br:       *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[ci.branches_start + b];
            val active_r: res[bool, fail.Fail]     = comptime_branch_active(sc, br);
            if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
            if (active_r.ok) {
                ret resolve_embeds_in_list(sc, br.body_start, br.body_len);
            }
            b = b + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var found: bool = false;
    var i:     u32  = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators[d.decorators_start + i];
        if (dec.id == decorator.EMBED) {
            if (found) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_DUPLICATE, dec.name, "a declaration can carry only one `embed` decorator");
            }
            or {
                val r: err[fail.Fail] = sema_embed.resolve_one(sc, did, d, dec);
                if (sel r.err) { ret r; }
                found = true;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_all_decls(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.decl_type == nil) { ret err[fail.Fail].ok{}; }
    val opt_module: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *ast_module.Module = opt_module.some;
    ret infer_decls_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun decl_gate_verdict(sc: *sema_context.SemaContext, cond: ast_id.ExprId) res[comptime_gate.GateVerdict, fail.Fail] {
    ret comptime_gate.evaluate_gate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, cond,
        ?sc.s.interner, comptime_gate.GATE_SCOPE_DECL, true);
}

fun decl_gate_is_active(sc: *sema_context.SemaContext, cond: ast_id.ExprId) res[bool, fail.Fail] {
    val vr: res[comptime_gate.GateVerdict, fail.Fail] = decl_gate_verdict(sc, cond);
    if (sel vr.err) {
        ret res[bool, fail.Fail].err{vr.err};
    }
    ret res[bool, fail.Fail].ok{vr.ok.outcome == comptime_gate.GATE_ACTIVE};
}

fun infer_decls_in_list(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did:      ast_id.DeclId  = sc.view.a.decl_ids[start + i];
        val res_decl: err[fail.Fail] = infer_one_decl(sc, did);
        if (sel res_decl.err) { ret res_decl; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_one_decl(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        ret infer_decls_comptime_if(sc, ?d.data.comptime_if);
    }

    val ty: type.TypeId = infer.infer_decl(sc, did);
    sema_context.decl_type_set(sc, did, ty);
    ret err[fail.Fail].ok{};
}

fun infer_decls_comptime_if(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf) err[fail.Fail] {
    if (comptime_gate.comptime_if_declares_nothing(sc.view.a, ci.branches_start, ci.branches_len)) {
        ret err[fail.Fail].ok{};
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[ci.branches_start + i];
        if (!ast_id.expr_is_nil(br.cond) && comptime.gate_state(sc.view.ctx, br.cond) == comptime.GATE_STATE_UNKNOWN) {
            if (!gate_condition_check(sc, br.cond)) { ret err[fail.Fail].ok{}; }
        }
        val active_r: res[bool, fail.Fail] = comptime_branch_active(sc, br);
        if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
        if (active_r.ok) {
            ret infer_decls_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_all_bodies(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.view.decl_type == nil) { ret err[fail.Fail].ok{}; }
    val opt_module: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel opt_module.some) {
        ret err[fail.Fail].err{fail.message("root_module is not set on this Ast")};
    }
    val mnode: *ast_module.Module = opt_module.some;
    ret infer_bodies_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_bodies_in_list(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val did:      ast_id.DeclId  = sc.view.a.decl_ids[start + i];
        val res_body: err[fail.Fail] = infer_one_body(sc, did);
        if (sel res_body.err) { ret res_body; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun pack_on_import_check(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val tn:    *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + i];
        val opt_t: opt[*ast_type.Type] = ast.get_type(sc.view.a, tn.ty);
        if (sel opt_t.some) {
            if (opt_t.some.kind == ast_type.TYPE_KIND_PACK) {
                sema_context.report_note(sc, diagnostic_kind.PACK_BODYLESS, d.span,
                    "a comptime variadic pack `...` cannot appear on a body-less `fun`",
                    "a pack is monomorphized per call site and takes a mangled name, so no foreign library can export it; for a C function declared with `...`, write the C-variadic form instead: `ext fun f(a: T, ...)`");
                ret;
            }
        }
        i = i + 1;
    }
}

fun infer_one_body(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d:               *ast_decl.Decl = opt_decl.some;
    val saved_requester: u32            = sc.instance.requester;
    sc.instance.requester = body_requester(sc, did, d);
    val r: err[fail.Fail] = infer_one_body_as(sc, did, d);
    sc.instance.requester = saved_requester;
    ret r;
}

# who a declaration's body asks for instances as: the object it is emitted in, or nobody
# for a template, which is emitted only through its instances
fun body_requester(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) u32 {
    if (d.kind == ast_decl.DECL_KIND_FUN && fun_is_template(sc, d)) { ret sema_instance.FROM_TEMPLATE; }
    if (d.kind == ast_decl.DECL_KIND_TEST)                          { ret sema_instance.FROM_TESTING; }
    if (resolve.declaration_testing(sc.view.a, did))                { ret sema_instance.FROM_TESTING; }
    ret sema_instance.FROM_NORMAL;
}

# a generic, a function with a comptime value parameter, or one with a pack: emitted only
# as its instances
fun fun_is_template(sc: *sema_context.SemaContext, d: *ast_decl.Decl) bool {
    if (d.data.fun_.generics_len > 0) { ret true; }
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + i];
        if (tn.comptime) { ret true; }
        if (i + 1 == d.data.fun_.params_len) {
            val t: opt[*ast_type.Type] = ast.get_type(sc.view.a, tn.ty);
            if (sel t.some) {
                if (t.some.kind == ast_type.TYPE_KIND_PACK) { ret true; }
            }
        }
        i = i + 1;
    }
    ret false;
}

fun infer_one_body_as(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    infer_decorator_args(sc, d);
    validate_decorators(sc, d);
    check_handle_decl(sc, did, d);
    check_handle_signature(sc, d);
    check_abi_type_placement(sc, did, d);

    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        ret infer_bodies_comptime_if(sc, ?d.data.comptime_if);
    }
    if (d.kind == ast_decl.DECL_KIND_FUN) {
        if (!ast_id.stmt_is_nil(d.data.fun_.body)) {
            if (d.data.fun_.c_variadic) {
                sema_context.report(sc, diagnostic_kind.EXT_VARIADIC_BODY, d.span, "a C-variadic `...` declares a foreign import and cannot have a body");
            }
            val ret_ty: type.TypeId = sema_context.resolved_type_of(sc, d.data.fun_.return_type);
            # a generic body is judged at each instantiation, against that instance's own
            # types; the template has none to judge it by, so it types the body to fill the
            # expression table that each instance and the lowering read, and says nothing
            val outer: sema_context.Walk = sema_context.walk_open(sc);
            if (d.data.fun_.generics_len > 0) { sc.walk.silent = true; }
            val res_body: err[fail.Fail] = infer_stmt(sc, d.data.fun_.body, ret_ty);
            sema_context.walk_close(sc, outer);
            ret res_body;
        }
        pack_on_import_check(sc, d);
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_TEST) {
        if (!ast_id.stmt_is_nil(d.data.test_.body)) {
            val ret_ty: type.TypeId = test_return_type(sc);
            sc.walk.in_test = true;
            val res_body: err[fail.Fail] = infer_stmt(sc, d.data.test_.body, ret_ty);
            sc.walk.in_test = false;
            ret res_body;
        }
        ret err[fail.Fail].ok{};
    }
    if (d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) {
        if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 && !ast_id.expr_is_nil(d.data.bind.init)) {
            sema_context.report(sc, diagnostic_kind.EXT_DATA_INITIALIZER, d.span, "an `ext` data import cannot have an initializer");
            ret err[fail.Fail].ok{};
        }
        ret infer_binding_init(sc, did, d);
    }
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_DIRECTIVE) {
        eval_comptime_directive(sc, d.data.comptime_directive.target, d.span);
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].ok{};
}

fun infer_decorator_args(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators[d.decorators_start + i];
        var ii:  u32                 = 0;
        for (ii < dec.args_len && !decorator.flagged(dec.id, decorator.FLAG_WORDS)) {
            if (!sema_handle.arg_is_type(sc, dec, ii)) {
                infer.infer_expr(sc, sc.view.a.expr_ids[dec.args_start + ii]);
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun validate_decorators(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    val places: decorator.Places = decorator.places_of(d);
    var i:      u32              = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators[d.decorators_start + i];
        if (validate_decorator_row(sc, dec, places, d.decorators_start, i)) { validate_decorator_rule(sc, d, dec); }
        i = i + 1;
    }
    validate_no_inline_conflict(sc, d);
    if (d.kind == ast_decl.DECL_KIND_TAG) { validate_case_decorators(sc, ?d.data.tag_); }
}

# a tag case's decorators answer to their rows alone: every rule a decorator adds
# shapes a symbol or a whole type
fun validate_case_decorators(sc: *sema_context.SemaContext, t: *ast_decl.DeclTag) {
    var i: u32 = 0;
    for (i < t.cases_len) {
        val c: *ast_decl.TagCase = ?sc.view.a.tag_cases[t.cases_start + i];
        var j: u32               = 0;
        for (j < c.decorators_len) {
            validate_decorator_row(sc, ?sc.view.a.decorators[c.decorators_start + j], decorator.PLACE_CASE, c.decorators_start, j);
            j = j + 1;
        }
        i = i + 1;
    }
}

# holds `dec` to its registry row: the count and kind of its arguments, whether it
# stands somewhere in `places`, and whether it repeats among the `index` decorators
# before it from `start`. true when it stands where its row admits it, once
fun validate_decorator_row(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, places: decorator.Places, start: u32, index: u32) bool {
    val row: *decorator.Row = decorator.row(dec.id);
    if (row == nil) {
        report_decorator_listing(sc, diagnostic_kind.DECORATOR_UNKNOWN, dec.name, "unknown decorator; valid decorators are ", 0, decorator.PLACES_ANY, nil, "");
        ret false;
    }
    if (dec.args_len < row.args_min || dec.args_len > row.args_max) { sema_context.report(sc, diagnostic_kind.DECORATOR_ARITY, dec.name, row.arity); }
    or                                                              { validate_decorator_args(sc, dec, row); }
    if ((row.places & places) == 0) {
        if (places == decorator.PLACE_CASE) {
            report_decorator_listing(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "a tag case takes only the ", 0, decorator.PLACE_CASE, "or", " decorator");
        }
        or { sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, row.misplaced); }
        ret false;
    }
    if ((row.flags & decorator.FLAG_ONCE) != 0) {
        val prior: opt[*ast_decl.Decorator] = decorator.list_get(sc.view.a, start, index, dec.id);
        if (sel prior.some) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_DUPLICATE, dec.name, row.duplicate);
            ret false;
        }
    }
    ret true;
}

# the arguments its row checks: each string it records where the row checks them,
# and each integer, stopping at the first that is not one
fun validate_decorator_args(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, row: *decorator.Row) {
    var ord: u32 = 0;
    for (ord < dec.args_len) {
        if ((row.flags & decorator.FLAG_STRINGS_CHECKED) != 0 && decorator.takes_string(dec, ord)) {
            sema_context.decorator_string_arg(sc, dec, ord, diagnostic_kind.DECORATOR_ARGUMENT, row.argument);
        }
        ord = ord + 1;
    }
    ord = 0;
    for (ord < dec.args_len && ord < 32) {
        if (((row.integers >> ord) & 1) != 0 && !require_integer_arg(sc, dec, ord, row.argument)) { brk; }
        ord = ord + 1;
    }
}

# reports `prefix`, the names of the rows carrying `flags` that stand in `places`
# as `decorator.names_append` lists them, then `suffix`
fun report_decorator_listing(sc: *sema_context.SemaContext, k: diagnostic_kind.Kind, at: lang_source.Span, prefix: str,
    flags: decorator.Flags, places: decorator.Places, conjunction: str, suffix: str) {
    var b:      textbuild.TextBuilder = textbuild.tb_init(sc.s.alloc);
    val head:   err[textbuild.Error]  = textbuild.tb_append(?b, prefix);
    var failed: bool                  = sel head.err;
    if (!failed) {
        val names: err[textbuild.Error] = decorator.names_append(?b, flags, places, conjunction);
        failed = sel names.err;
    }
    if (!failed) {
        val tail: err[textbuild.Error] = textbuild.tb_append(?b, suffix);
        failed = sel tail.err;
    }
    if (failed) {
        textbuild.tb_dnit(?b);
        fail.internal(?sc.status, "a decorator listing could not be built");
        ret;
    }
    val text: res[str, textbuild.Error] = textbuild.tb_finish(?b);
    textbuild.tb_dnit(?b);
    if (sel text.err) {
        fail.internal(?sc.status, textbuild.text(text.err));
        ret;
    }
    sema_context.report(sc, k, at, text.ok);
    str_free(sc.s.alloc, text.ok);
}

fun warn_deprecated_at(sc: *sema_context.SemaContext, notice: deprecation.Deprecation, span: lang_source.Span, what: str,
    seen: *map.Map[u64, u8]) err[fail.Fail] {
    if (!notice.present || lang_source.file_same(notice.owner, sc.view.a.file_id) || span.len == 0) { ret err[fail.Fail].ok{}; }
    val key:        u64      = span.offset::u64;
    val seen_entry: opt[*u8] = map.get[u64, u8](seen, ?key);
    if (sel seen_entry.some) { ret err[fail.Fail].ok{}; }
    val name_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, span.offset, span.len);
    if (sel name_r.err) {
        if (sel name_r.err.alloc) { ret err[fail.Fail].err{fail.refused(name_r.err.alloc)}; }
        ret err[fail.Fail].err{fail.message("deprecated declaration name lies outside its source")};
    }
    val name: str = name_r.ok;
    fin { str_free(sc.s.alloc, name); }
    var text: str = "";
    if (!intern.str_is_nil(notice.message)) {
        val found: opt[str] = intern.get(?sc.s.interner, notice.message);
        if (!sel found.some) { ret err[fail.Fail].err{fail.message("deprecation message is not interned")}; }
        text = found.some;
    }
    var message: res[str, std_format.FormatError];
    if (str_len(text) == 0) { message = std_format.sprint(sc.s.alloc, "{}`{}` is deprecated", what, name); }
    or                      { message = std_format.sprint(sc.s.alloc, "{}`{}` is deprecated: {}", what, name, text); }
    if (sel message.err)    { ret err[fail.Fail].err{fail.format_refused(message.err)}; }
    val owned: str = message.ok;
    fin { str_free(sc.s.alloc, owned); }
    val emitted: err[fail.Fail] = diagnostic.report(sc.diags, diagnostic_kind.DECL_DEPRECATED, sc.view.a.file_id, span, owned);
    if (sel emitted.err) { ret emitted; }
    val remembered: res[bool, A.Error] = map.insert[u64, u8](seen, key, 1);
    if (sel remembered.err) { ret err[fail.Fail].err{fail.refused(remembered.err)}; }
    ret err[fail.Fail].ok{};
}

fun warn_deprecated_symbol(sc: *sema_context.SemaContext, sid: resolve.SymbolId, span: lang_source.Span,
    seen: *map.Map[u64, u8]) err[fail.Fail] {
    if (resolve.symbol_index(sid) >= sc.view.rr.symbol_count) { ret err[fail.Fail].ok{}; }
    ret warn_deprecated_at(sc, sc.view.rr.symbols[resolve.symbol_index(sid)].deprecation, span, "", seen);
}

# the tag nominal a place of this type selects a case of: through outer secrecy and one
# pointer level, as `sel` and a payload place read it
fun deprecation_tag_of_place(sc: *sema_context.SemaContext, ty: type.TypeId) type.TypeId {
    if (type.is_nil(ty) || type.is_error(ty)) { ret type.TYPE_NIL; }
    var base: type.TypeId = type.strip_secret(?sc.s.types, ty);
    if (type.is_pointer(?sc.s.types, base)) { base = type.strip_secret(?sc.s.types, type.deref_one(?sc.s.types, base)); }
    val nominal: type.TypeId = type.aggregate_nominal(?sc.s.types, base);
    if (!type.is_tag(?sc.s.types, nominal)) { ret type.TYPE_NIL; }
    ret nominal;
}

fun warn_deprecated_case(sc: *sema_context.SemaContext, tag: type.TypeId, case_span: lang_source.Span,
    seen: *map.Map[u64, u8]) err[fail.Fail] {
    if (type.is_nil(tag) || case_span.len == 0) { ret err[fail.Fail].ok{}; }
    val name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, case_span.offset, case_span.len);
    if (sel name.err) { ret err[fail.Fail].err{fail.refused(name.err)}; }
    val table: opt[*type.FieldTable] = type.field_table_for(?sc.s.types, tag);
    if (!sel table.some) { ret err[fail.Fail].ok{}; }
    val ft: *type.FieldTable = table.some;
    var i:  u32              = 0;
    for (i < ft.fields_len) {
        val entry: *type.FieldEntry = type.field_entry_at(?sc.s.types, ft, i);
        if (entry != nil && intern.str_same(entry.name, name.ok)) {
            ret warn_deprecated_at(sc, entry.deprecation, case_span, "tag case ", seen);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the float literal rule at each literal's final type, once every body has been inferred
fun check_float_literals(sc: *sema_context.SemaContext) {
    if (sc.walk.in_comptime_gate || sc.view.expr_type == nil) { ret; }
    var i: usize = 0;
    for (i < sc.view.a.expr_len) {
        if (sc.view.a.exprs[i].kind == ast_expr.EXPR_KIND_LIT_FLOAT) { coerce.check_float_literal(sc, ast_id.expr(i::u32), sc.view.expr_type[i]); }
        i = i + 1;
    }
}

# a literal its context did not type took the i64 default, where the range rule has
# not yet run: each outermost expression of untyped literals is checked at its final
# type once every body has been inferred. one its context typed was checked when it
# was coerced, and fits
fun check_default_literals(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.walk.in_comptime_gate || sc.view.expr_type == nil || sc.view.a.expr_len == 0) { ret err[fail.Fail].ok{}; }
    val n:      usize             = sc.view.a.expr_len;
    val res_in: res[*u8, A.Error] = A.allocate[u8](sc.s.alloc, n);
    if (sel res_in.err) { ret err[fail.Fail].err{fail.refused(res_in.err)}; }
    val inner: *u8 = res_in.ok;
    fin { A.deallocate[u8](sc.s.alloc, inner, n); }
    var i: usize = 0;
    for (i < n) {
        inner[i] = 0;
        i        = i + 1;
    }
    i = 0;
    for (i < n) {
        val e: *ast_expr.Expr = ?sc.view.a.exprs[i];
        if ((e.kind == ast_expr.EXPR_KIND_UNARY || e.kind == ast_expr.EXPR_KIND_BINARY) && coerce.is_untyped_int_literal(sc, ast_id.expr(i::u32))) {
            if (e.kind == ast_expr.EXPR_KIND_UNARY) { mark_inner(inner, n, e.data.unary.operand); }
            or {
                mark_inner(inner, n, e.data.binary.lhs);
                mark_inner(inner, n, e.data.binary.rhs);
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        if (inner[i] == 0 && coerce.is_untyped_int_literal(sc, ast_id.expr(i::u32))) {
            val cr: coerce.CoerceResult = coerce.probe_literal_range(sc, ast_id.expr(i::u32), sc.view.expr_type[i]);
            if (cr.kind == coerce.COERCE_OUT_OF_RANGE) { check.report_default_out_of_range(sc, sc.view.a.exprs[i].span, cr); }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun mark_inner(inner: *u8, n: usize, eid: ast_id.ExprId) {
    if (ast_id.expr_index(eid)::usize < n) { inner[ast_id.expr_index(eid)] = 1; }
}

# a shift of an untyped literal is typed by its context, so its count is checked
# against that type's width once every body has been inferred
fun check_literal_shifts(sc: *sema_context.SemaContext) {
    if (sc.walk.in_comptime_gate || sc.view.expr_type == nil) { ret; }
    var i: usize = 0;
    for (i < sc.view.a.expr_len) {
        val e:      *ast_expr.Expr     = ?sc.view.a.exprs[i];
        val is_int: opt[type.IntRange] = coerce.int_bounds_of(sc, sc.view.expr_type[i]);
        if (e.kind == ast_expr.EXPR_KIND_BINARY && (e.data.binary.op == ast_expr.BIN_SHL || e.data.binary.op == ast_expr.BIN_SHR)
            && sel is_int.some && coerce.is_untyped_int_literal(sc, ast_id.expr(i::u32))) {
            check.check_shift_count(sc, e.span, sc.view.expr_type[i], e.data.binary.rhs);
        }
        i = i + 1;
    }
}

# the rule for the literals an instance retypes: those its generic body left at a type
# parameter. the rest were checked with their module
fun check_instance_float_literals(sc: *sema_context.SemaContext, generic: *type.TypeId) {
    if (sc.view.expr_type == nil) { ret; }
    var i: usize = 0;
    for (i < sc.view.a.expr_len) {
        var before: type.TypeId = type.TYPE_NIL;
        if (generic != nil) { before = generic[i]; }
        if (sc.view.a.exprs[i].kind == ast_expr.EXPR_KIND_LIT_FLOAT && !type.same(sc.view.expr_type[i], before)) {
            coerce.check_float_literal(sc, ast_id.expr(i::u32), sc.view.expr_type[i]);
        }
        i = i + 1;
    }
}

# one warning per source site after every body and instantiation has been inferred: named
# declaration uses through their resolved symbol, and tag case uses (construction, `sel`,
# payload place) through the case table of the place's tag
fun warn_deprecated_uses(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.walk.silent || sc.walk.in_comptime_gate || sc.view.rr == nil || sc.view.expr_type == nil) { ret err[fail.Fail].ok{}; }
    var seen: map.Map[u64, u8] = map.init[u64, u8](sc.s.alloc);
    fin { map.dnit[u64, u8](?seen); }
    var i: u32 = 0;
    for (i < sc.view.rr.expr_count && i::usize < sc.view.a.expr_len) {
        val e:    *ast_expr.Expr   = ?sc.view.a.exprs[i];
        var span: lang_source.Span = e.span;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER) { span = e.data.member.name; }
        if (e.kind == ast_expr.EXPR_KIND_IDENT)  { span = e.data.ident.tok; }
        val warned: err[fail.Fail] = warn_deprecated_symbol(sc, sc.view.rr.expr_resolved[i], span, ?seen);
        if (sel warned.err) { ret warned; }
        var tag:       type.TypeId      = type.TYPE_NIL;
        var case_span: lang_source.Span = lang_source.Span{offset: 0, len: 0};
        if (e.kind == ast_expr.EXPR_KIND_SEL && ast_id.expr_is_nil(e.data.sel.case_desc) && ast_id.expr_index(e.data.sel.place) < sc.view.rr.expr_count) {
            tag       = deprecation_tag_of_place(sc, sc.view.expr_type[ast_id.expr_index(e.data.sel.place)]);
            case_span = e.data.sel.case_name;
        }
        or (e.kind == ast_expr.EXPR_KIND_MEMBER && !type.is_nil(sc.view.expr_type[i])) {
            val self_ty: type.TypeId = sc.view.expr_type[i];
            if (type.is_case_selector(?sc.s.types, self_ty))                     { tag = type.aggregate_nominal(?sc.s.types, type.case_selector_tag_type(?sc.s.types, self_ty)); }
            or (ast_id.expr_index(e.data.member.object) < sc.view.rr.expr_count) { tag = deprecation_tag_of_place(sc, sc.view.expr_type[ast_id.expr_index(e.data.member.object)]); }
            case_span = e.data.member.name;
        }
        or (e.kind == ast_expr.EXPR_KIND_STRUCT_LIT) {
            val head: opt[*ast_type.Type] = ast.get_type(sc.view.a, e.data.struct_lit.ty);
            if (sel head.some) {
                if (head.some.kind == ast_type.TYPE_KIND_NAMED && ast_id.expr_is_nil(head.some.data.named.case_desc)) {
                    tag       = deprecation_tag_of_place(sc, sc.view.expr_type[i]);
                    case_span = head.some.data.named.case_name;
                }
            }
        }
        val case_warned: err[fail.Fail] = warn_deprecated_case(sc, tag, case_span, ?seen);
        if (sel case_warned.err) { ret case_warned; }
        i = i + 1;
    }
    i = 0;
    for (i < sc.view.rr.type_count && i::usize < sc.view.a.type_len) {
        val t: *ast_type.Type = ?sc.view.a.types[i];
        if (t.kind == ast_type.TYPE_KIND_NAMED) {
            val warned: err[fail.Fail] = warn_deprecated_symbol(sc, sc.view.rr.type_resolved[i], fe_path.leaf(sc.view.source, t.data.named.name), ?seen);
            if (sel warned.err) { ret warned; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the source ranges of test bodies and `#[testing]` declarations in one declaration list, in
# source order, descending into comptime branches
fun collect_testing_regions(sc: *sema_context.SemaContext, start: u32, len: u32, regions: *collections_vector.Vector[lang_source.Span]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        i = i + 1;
        if (pool_ix::usize >= sc.view.a.decl_id_len) { ret err[fail.Fail].err{fail.message("testing regions: declaration index out of range")}; }
        val did:     ast_id.DeclId       = sc.view.a.decl_ids[pool_ix];
        val defined: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
        if (!sel defined.some) { cnt; }
        val d: *ast_decl.Decl = defined.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val branch:    *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[d.data.comptime_if.branches_start + b];
                val collected: err[fail.Fail]           = collect_testing_regions(sc, branch.body_start, branch.body_len, regions);
                if (sel collected.err) { ret collected; }
                b = b + 1;
            }
            cnt;
        }
        if (d.kind != ast_decl.DECL_KIND_TEST && !resolve.declaration_testing(sc.view.a, did)) { cnt; }
        val pushed: res[usize, A.Error] = collections_vector.push[lang_source.Span](regions, d.span);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    }
    ret err[fail.Fail].ok{};
}

# whether a source offset lies inside one of the sorted, disjoint regions
fun in_testing_region(regions: *collections_vector.Vector[lang_source.Span], offset: usize) bool {
    var lo: usize = 0;
    var hi: usize = regions.len;
    for (lo < hi) {
        val mid:    usize            = lo + (hi - lo) / 2;
        val region: lang_source.Span = regions.data[mid];
        if (offset < region.offset)               { hi = mid; }
        or (offset >= region.offset + region.len) { lo = mid + 1; }
        or                                        { ret true; }
    }
    ret false;
}

fun report_testing_use(sc: *sema_context.SemaContext, span: lang_source.Span, what: str, why: str) err[fail.Fail] {
    val name_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, span.offset, span.len);
    if (sel name_r.err) {
        if (sel name_r.err.alloc) { ret err[fail.Fail].err{fail.refused(name_r.err.alloc)}; }
        ret err[fail.Fail].err{fail.message("testing reference lies outside its source")};
    }
    val name: str = name_r.ok;
    fin { str_free(sc.s.alloc, name); }
    val message: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{}`{}` is a `#[testing]` declaration: {}", what, name, why);
    if (sel message.err) { ret err[fail.Fail].err{fail.format_refused(message.err)}; }
    val owned: str = message.ok;
    fin { str_free(sc.s.alloc, owned); }
    sema_context.report(sc, diagnostic_kind.TESTING_USE, span, owned);
    ret err[fail.Fail].ok{};
}

fun check_testing_symbol(sc: *sema_context.SemaContext, sid: resolve.SymbolId, span: lang_source.Span,
    regions: *collections_vector.Vector[lang_source.Span], seen: *map.Map[u64, u8]) err[fail.Fail] {
    if (resolve.symbol_index(sid) >= sc.view.rr.symbol_count || span.len == 0) { ret err[fail.Fail].ok{}; }
    if (!sc.view.rr.symbols[resolve.symbol_index(sid)].testing)                { ret err[fail.Fail].ok{}; }
    if (in_testing_region(regions, span.offset))                               { ret err[fail.Fail].ok{}; }
    val key:        u64      = span.offset::u64;
    val seen_entry: opt[*u8] = map.get[u64, u8](seen, ?key);
    if (sel seen_entry.some) { ret err[fail.Fail].ok{}; }
    val remembered: res[bool, A.Error] = map.insert[u64, u8](seen, key, 1);
    if (sel remembered.err) { ret err[fail.Fail].err{fail.refused(remembered.err)}; }
    ret report_testing_use(sc, span, "", "only a test body or another `#[testing]` declaration may reference it");
}

fun check_testing_fwds(sc: *sema_context.SemaContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        i = i + 1;
        if (pool_ix::usize >= sc.view.a.decl_id_len) { ret err[fail.Fail].err{fail.message("testing re-exports: declaration index out of range")}; }
        val did:     ast_id.DeclId       = sc.view.a.decl_ids[pool_ix];
        val defined: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
        if (!sel defined.some) { cnt; }
        val d: *ast_decl.Decl = defined.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val branch:  *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[d.data.comptime_if.branches_start + b];
                val checked: err[fail.Fail]           = check_testing_fwds(sc, branch.body_start, branch.body_len);
                if (sel checked.err) { ret checked; }
                b = b + 1;
            }
            cnt;
        }
        if (d.kind != ast_decl.DECL_KIND_FWD || sc.view.rr.decl_symbol == nil || ast_id.decl_index(did) >= sc.view.rr.decl_count) { cnt; }
        val sid: resolve.SymbolId = sc.view.rr.decl_symbol[ast_id.decl_index(did)];
        if (resolve.symbol_index(sid) >= sc.view.rr.symbol_count || !sc.view.rr.symbols[resolve.symbol_index(sid)].testing) { cnt; }
        if (resolve.declaration_testing(sc.view.a, did))                                                                    { cnt; }
        val reported: err[fail.Fail] = report_testing_use(sc, d.data.fwd_.path, "re-exported ",
            "an unmarked `fwd` puts it on a production surface; mark the `fwd` `#[testing]`");
        if (sel reported.err) { ret reported; }
    }
    ret err[fail.Fail].ok{};
}

# a reference to a `#[testing]` declaration is legal only inside a test body or another
# `#[testing]` declaration: every resolved name and type use is checked against the source
# ranges of those declarations, and an unmarked `fwd` may not re-export one
fun check_testing_uses(sc: *sema_context.SemaContext) err[fail.Fail] {
    if (sc.walk.silent || sc.walk.in_comptime_gate || sc.view.rr == nil) { ret err[fail.Fail].ok{}; }
    val root: opt[*ast_module.Module] = ast.get_module(sc.view.a, sc.view.a.root_module);
    if (!sel root.some) { ret err[fail.Fail].ok{}; }
    var regions: collections_vector.Vector[lang_source.Span] = collections_vector.init[lang_source.Span](sc.s.alloc);
    fin { collections_vector.dnit[lang_source.Span](?regions); }
    val collected: err[fail.Fail] = collect_testing_regions(sc, root.some.decls_start, root.some.decls_len, ?regions);
    if (sel collected.err) { ret collected; }
    val fwds: err[fail.Fail] = check_testing_fwds(sc, root.some.decls_start, root.some.decls_len);
    if (sel fwds.err) { ret fwds; }
    var seen: map.Map[u64, u8] = map.init[u64, u8](sc.s.alloc);
    fin { map.dnit[u64, u8](?seen); }
    var i: u32 = 0;
    for (i < sc.view.rr.expr_count && i::usize < sc.view.a.expr_len) {
        val e:    *ast_expr.Expr   = ?sc.view.a.exprs[i];
        var span: lang_source.Span = e.span;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER) { span = e.data.member.name; }
        if (e.kind == ast_expr.EXPR_KIND_IDENT)  { span = e.data.ident.tok; }
        val checked: err[fail.Fail] = check_testing_symbol(sc, sc.view.rr.expr_resolved[i], span, ?regions, ?seen);
        if (sel checked.err) { ret checked; }
        i = i + 1;
    }
    i = 0;
    for (i < sc.view.rr.type_count && i::usize < sc.view.a.type_len) {
        val t: *ast_type.Type = ?sc.view.a.types[i];
        if (t.kind == ast_type.TYPE_KIND_NAMED) {
            val checked: err[fail.Fail] = check_testing_symbol(sc, sc.view.rr.type_resolved[i], fe_path.leaf(sc.view.source, t.data.named.name), ?regions, ?seen);
            if (sel checked.err) { ret checked; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun validate_no_inline_conflict(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    var has_inline:    bool = false;
    var has_noinline:  bool = false;
    var noinline_span: lang_source.Span;
    var i:             u32  = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?sc.view.a.decorators[d.decorators_start + i];
        if (dec.id == decorator.INLINE) { has_inline = true; }
        if (dec.id == decorator.NOINLINE) {
            has_noinline  = true;
            noinline_span = dec.name;
        }
        i = i + 1;
    }
    if (has_inline && has_noinline) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, noinline_span, "`inline` and `noinline` decorators cannot both apply to the same function");
    }
}

# an integer argument: of an integer type and a constant expression
fun require_integer_arg(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32, kind_msg: str) bool {
    val eid: ast_id.ExprId = sc.view.a.expr_ids[dec.args_start + ord];
    if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, eid))) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, dec.name, kind_msg);
        ret false;
    }
    sema_context.require_constant_arg(sc, dec, ord);
    ret true;
}

# a workgroup dimension is an integer constant or names a `#[spec]` var, whose value the
# host supplies at pipeline creation. a var another module declares is held to that by
# the back end, which sees its role
fun validate_workgroup_dim(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, ord: u32) bool {
    val eid:     ast_id.ExprId        = sc.view.a.expr_ids[dec.args_start + ord];
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (sel opt_sym.some) {
        val sym:    *resolve.Symbol = opt_sym.some;
        val own:    bool            = sym.kind == resolve.SYM_VAR;
        val import: bool            = sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_VAR;
        if (own || import) {
            if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, eid))) {
                sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, dec.name, "`workgroup` decorator dimensions must be integers");
                ret false;
            }
            if (own && module.same(sym.origin, sc.view.own_module)) {
                val opt_d: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, sym.decl);
                if (sel opt_d.some && !decorator.has(sc.view.a, opt_d.some, decorator.SPEC)) {
                    sema_context.report(sc, diagnostic_kind.DECORATOR_NOT_CONSTANT, decorator_arg_span(sc, eid, dec.name), "a `workgroup` dimension that is not a constant must name a `#[spec(id)]` var, whose value the host supplies at pipeline creation; any other variable has no value when the pipeline is built");
                    ret false;
                }
            }
            ret true;
        }
    }
    ret require_integer_arg(sc, dec, ord, "`workgroup` decorator dimensions must be integer comptime expressions or `#[spec]` vars");
}

fun decorator_arg_span(sc: *sema_context.SemaContext, eid: ast_id.ExprId, fallback: lang_source.Span) lang_source.Span {
    val e: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
    if (sel e.none) { ret fallback; }
    ret e.some.span;
}

# a shader interface binding carries one role, and its initializer follows that role
fun validate_iface_role(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.count_flagged(sc.view.a, d, decorator.FLAG_ROLE) > 1) {
        report_decorator_listing(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "a shader interface variable carries exactly one role; ",
            decorator.FLAG_ROLE, decorator.PLACES_ANY, "and", " are mutually exclusive");
    }
    validate_iface_init(sc, d, dec);
}

# the one rule for an initializer on an interface binding, per role: a `#[spec]` var's is
# the default it requires, an output's is the value it starts at, and every other role's
# value is supplied by the host, the pipeline or the stage, so an initializer is refused
fun validate_iface_init(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val has: bool = !ast_id.expr_is_nil(d.data.bind.init);
    if (dec.id == decorator.SPEC) {
        if (!has) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "a `#[spec(id)]` var needs an initializer: it is the default the pipeline keeps when the host supplies no value for the id");
        }
        ret;
    }
    if (!has) { ret; }
    var why: str = nil;
    if (dec.id == decorator.INPUT) {
        why = "an `#[input]` variable cannot have an initializer: the previous stage or the vertex input supplies its value, so the written one would never be what the shader reads";
    }
    or (dec.id == decorator.BUILTIN && !builtin_is_output(sc, dec)) {
        why = "an input `#[builtin]` cannot have an initializer: the pipeline supplies its value, so the written one would never be what the shader reads";
    }
    or (dec.id == decorator.UNIFORM || dec.id == decorator.STORAGE || dec.id == decorator.SAMPLER) {
        why = "a descriptor-bound `#[uniform]` / `#[storage]` / `#[sampler]` variable cannot have an initializer: the host binds its memory, so the written value would never be what the shader sees";
    }
    or (dec.id == decorator.PUSH) {
        why = "a `#[push]` block cannot have an initializer: the host supplies it with the command that records the dispatch or draw, so the written value would never be what the shader sees";
    }
    or (dec.id == decorator.SHARED) {
        why = "a `#[shared]` variable cannot have an initializer: workgroup memory is zero when a compute stage starts, and no one invocation owns it to write any other value first. assign it inside the stage";
    }
    if (why != nil) { sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, why); }
}

# the built-ins a stage writes rather than reads; an unknown or unreadable one is left to
# the built-in check
fun builtin_is_output(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) bool {
    if (dec.args_len != 1) { ret true; }
    val v: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    if (sel v.none) { ret true; }
    ret str_equals(v.some, "position") || str_equals(v.some, "point_size");
}

fun validate_builtin_value(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, value: opt[str]) {
    if (sel value.none) { ret; }
    val v: str = value.some;
    if (str_equals(v, "position"))               { ret; }
    if (str_equals(v, "vertex_index"))           { ret; }
    if (str_equals(v, "instance_index"))         { ret; }
    if (str_equals(v, "frag_coord"))             { ret; }
    if (str_equals(v, "point_size"))             { ret; }
    if (str_equals(v, "global_invocation"))      { ret; }
    if (str_equals(v, "local_invocation"))       { ret; }
    if (str_equals(v, "workgroup_id"))           { ret; }
    if (str_equals(v, "num_workgroups"))         { ret; }
    if (str_equals(v, "local_invocation_index")) { ret; }
    if (str_equals(v, "subgroup_size"))          { ret; }
    if (str_equals(v, "subgroup_invocation"))    { ret; }
    if (str_equals(v, "subgroup_id"))            { ret; }
    if (str_equals(v, "num_subgroups"))          { ret; }
    sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, expect.arg_span(sc.view.a, sc.view.a.expr_ids[dec.args_start], dec.name), "unknown built-in; `builtin` accepts \"position\", \"vertex_index\", \"instance_index\", \"frag_coord\", \"point_size\", \"global_invocation\", \"local_invocation\", \"workgroup_id\", \"num_workgroups\", \"local_invocation_index\", \"subgroup_size\", \"subgroup_invocation\", \"subgroup_id\", or \"num_subgroups\"");
}

fun validate_stage_value(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator, value: opt[str]) {
    if (sel value.none) { ret; }
    val v: str = value.some;
    if (str_equals(v, "vertex"))   { ret; }
    if (str_equals(v, "fragment")) { ret; }
    if (str_equals(v, "compute"))  { ret; }
    sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, expect.arg_span(sc.view.a, sc.view.a.expr_ids[dec.args_start], dec.name), "unknown pipeline stage; `stage` accepts \"vertex\", \"fragment\", or \"compute\"");
}

fun validate_storage_quals(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) {
    var readonly:  bool = false;
    var writeonly: bool = false;
    var i:         u32  = 2;
    for (i < dec.args_len) {
        val qual: opt[str] = sema_context.decorator_string_arg(sc, dec, i, diagnostic_kind.DECORATOR_ARGUMENT,
            "a `storage` memory qualifier must be a string; `storage` takes the descriptor set and binding followed by qualifiers, as in `#[storage(0, 3, \"readonly\")]`");
        if (sel qual.none) {
            i = i + 1;
            cnt;
        }
        val at: lang_source.Span = expect.arg_span(sc.view.a, sc.view.a.expr_ids[dec.args_start + i], dec.name);
        if (str_equals(qual.some, "readonly"))  { readonly = true; }
        or (str_equals(qual.some, "writeonly")) { writeonly = true; }
        or (!str_equals(qual.some, "coherent")) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, at,
                "unknown `storage` memory qualifier; `storage` accepts \"readonly\", \"writeonly\", or \"coherent\"");
        }
        if (readonly && writeonly) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, at,
                "`\"readonly\"` and `\"writeonly\"` together declare a binding that no stage reads or writes; keep the one that says how the binding is used");
            readonly  = false;
            writeonly = false;
        }
        i = i + 1;
    }
}

fun validate_op(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (dec.args_len != 3) { ret; }
    val opt_tgt: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0);
    val opt_set: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 1);
    val opt_nam: opt[str] = decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 2);
    if (sel opt_tgt.none) { ret; }
    if (sel opt_set.none) { ret; }
    if (sel opt_nam.none) { ret; }
    val set_s: str = opt_set.some;
    val nam_s: str = opt_nam.some;

    val defs: *target_definition.Table = sc.view.ctx.env.target_defs;

    if (!target_is_selected(sc, opt_tgt.some)) { ret; }
    if (defs == nil || defs.op_count == 0)     { ret; }

    if (!target_definition.op_set_exists_region(defs, set_s, 0, str_len(set_s))) {
        sema_context.report(sc, diagnostic_kind.OP_UNKNOWN, expect.arg_span(sc.view.a, sc.view.a.expr_ids[dec.args_start + 1], dec.name), "the selected target defines no instruction set of this name; an `op` declaration is emitted only by a target that publishes the instruction");
        ret;
    }
    val od: *target_definition.Op = target_definition.op_of_region(defs, set_s, 0, str_len(set_s), nam_s, 0, str_len(nam_s));
    if (od == nil) {
        sema_context.report(sc, diagnostic_kind.OP_UNKNOWN, expect.arg_span(sc.view.a, sc.view.a.expr_ids[dec.args_start + 2], dec.name), "that instruction set defines no instruction of this name, or the selected target does not carry it; the target's own table lists the accepted names and why each omission is one");
        ret;
    }
    if (d.data.fun_.params_len < od.min_arity || d.data.fun_.params_len > od.arity) {
        sema_context.report(sc, diagnostic_kind.OP_OPERAND_COUNT, dec.name, "the declaration's parameter count is not one the instruction's operand count admits: operands come from the parameters in order, so a mismatch assembles the instruction with the wrong number of operands. an instruction with an optional tail admits each count from its required operands to all of them");
        ret;
    }
    validate_op_signature(sc, d, od);
}

# each parameter's type against the kind of the operand it supplies, and the
# return type against the row's result. an operand a literal's value brings is typed by
# the value a call passes, so the emitter holds its parameter to the kind the call decides
fun validate_op_signature(sc: *sema_context.SemaContext, d: *ast_decl.Decl, od: *target_definition.Op) {
    val ti: *type.TypeInterner = ?sc.s.types;
    var i:  u32                = 0;
    for (i < d.data.fun_.params_len && i < od.spelled) {
        val tn:   *ast_decl.TypedName             = ?sc.view.a.typed_names[d.data.fun_.params_start + i];
        val pty:  type.TypeId                     = sema_context.resolved_type_of(sc, tn.ty);
        val kind: target_definition.OpOperandKind = target_definition.op_operand_kind(od, i);
        if (type.is_error(pty)) {
            i = i + 1;
            cnt;
        }
        if (target_definition.op_kind_is_pointer(kind) && !type.is_pointer(ti, pty)) {
            sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, "this operand is a pointer the instruction reads or writes through, so the parameter must be a pointer: the argument's address, with the storage class of the object it names, is what the instruction takes");
        }
        or ((target_definition.op_kind_is_constant(kind) || kind == target_definition.OP_OPERAND_LITERAL) && !type.is_integer(ti, pty)) {
            sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, "this operand is an integer constant the instruction takes by value, such as a scope, memory semantics or an operand mask, so the parameter must be an integer");
        }
        or (target_definition.op_kind_is_handle(kind) && !type.is_handle(ti, pty)) {
            sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, "this operand is a handle whose memory the instruction reads or writes, such as a storage image's texels, so the parameter must be a handle type: the instruction takes the handle itself, not a value or an address");
        }
        or (kind == target_definition.OP_OPERAND_BOOL && !type.is_integer(ti, pty)) {
            sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, "this operand is a truth value the instruction takes as the target's boolean, so the parameter must be an integer such as `bool`, whose nonzero is true");
        }
        or (kind == target_definition.OP_OPERAND_VALUE && type.is_pointer_like(ti, pty)) {
            sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, "this operand is an ordinary value, so the parameter cannot be a pointer: only an operand the instruction reads or writes through takes an address");
        }
        or (target_definition.op_operand_scalar(od, i) != nil && target_definition.op_operand_relation(od, i) != target_definition.OP_RELATION_SHAPED) {
            check_op_scalar(sc, od, target_definition.op_operand_scalar(od, i), tn, pty);
        }
        i = i + 1;
    }

    val rty: type.TypeId = sema_context.resolved_type_of(sc, d.data.fun_.return_type);
    if (type.is_error(rty)) { ret; }
    if (od.result == target_definition.OP_RESULT_NONE && !type.is_nil(rty)) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, d.data.fun_.name, "the instruction has no result id, so the declaration returns nothing: a return type would name a value the instruction never produces");
    }
    or (od.result == target_definition.OP_RESULT_VALUE && type.is_nil(rty)) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, d.data.fun_.name, "the instruction produces a result, so the declaration must return its type: without one the result id has no type to declare");
    }
    or (od.result == target_definition.OP_RESULT_VALUE && type.is_pointer_like(ti, rty)) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, d.data.fun_.name, "the instruction's result is a value, not a pointer: only an instruction whose row declares a pointer result returns an address");
    }
    or (od.result == target_definition.OP_RESULT_BOOL && !type.is_integer(ti, rty)) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, d.data.fun_.name, "the instruction's result is a truth value, so the declaration returns an integer such as `bool`, which receives it as 1 or 0");
    }
    or (od.result == target_definition.OP_RESULT_POINTER && !type.is_pointer(ti, rty)) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, d.data.fun_.name, "the instruction's result is a pointer into the storage its row declares, so the declaration must return a pointer to the type it addresses");
    }
    or (od.result == target_definition.OP_RESULT_VALUE && type.is_handle(ti, type.strip_secret(ti, rty)) && od.source == target_definition.NO_OP_SOURCE) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, d.data.fun_.name, "the declaration returns a handle, and the instruction's row names no operand its result derives from: a handle holds a binding's descriptor, so only an instruction whose row says which operand's it holds returns a handle");
    }
    validate_op_data_type(sc, d, od);
    validate_op_relations(sc, d, od);
}

# an operand the row fixes to one scalar type, whatever its data type: `ty`, the type of
# the parameter `tn`, must be that scalar itself, not a vector of it
fun check_op_scalar(sc: *sema_context.SemaContext, od: *target_definition.Op, fixed: *target_definition.OpOperandScalar, tn: *ast_decl.TypedName, ty: type.TypeId) {
    val ti:  *type.TypeInterner = ?sc.s.types;
    val got: type.TypeId        = type.strip_secret(ti, ty);
    val g:   opt[*type.Type]    = type.get(ti, got);
    if (sel g.some && op_scalar_is(g.some.kind, fixed.scalar)) { ret; }
    val want:   target_definition.OpScalar = fixed.scalar;
    var prefix: str                        = "f";
    if (want.class == target_definition.OP_DATA_INT && want.signed)  { prefix = "i"; }
    if (want.class == target_definition.OP_DATA_INT && !want.signed) { prefix = "u"; }
    val got_r: res[str, fail.Fail] = check.type_to_str(sc, got);
    if (sel got_r.err) {
        fail.internal(?sc.status, fail.describe(got_r.err));
        ret;
    }
    val got_s: str = got_r.ok;
    fin { check.type_str_free(sc, got_s); }
    val name_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, tn.name.offset, tn.name.len);
    if (sel name_r.err) {
        fail.internal(?sc.status, fail.describe(fail.str_refused(name_r.err)));
        ret;
    }
    val name: str = name_r.ok;
    fin { str_free(sc.s.alloc, name); }
    val mr: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "`{}` must be `{}{}`, not `{}`: {}",
        name, prefix, want.bits, got_s, fixed.rule);
    if (sel mr.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(mr.err)));
        ret;
    }
    val msg: str = mr.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, msg);
}

# each related operand's type, and the result's, against the data type of the operand the
# row's typing names: a pointer's pointee, a value's own type, or a handle's texels. a
# related pointer operand's pointee is what relates
fun validate_op_relations(sc: *sema_context.SemaContext, d: *ast_decl.Decl, od: *target_definition.Op) {
    val t: *target_definition.OpTyping = od.typing;
    if (t == nil || t.operand >= d.data.fun_.params_len) { ret; }
    val ti:      *type.TypeInterner  = ?sc.s.types;
    val subject: *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + t.operand];
    var dty:     type.TypeId         = sema_context.resolved_type_of(sc, subject.ty);
    if (type.is_error(dty)) { ret; }
    val through: bool = target_definition.op_kind_is_pointer(target_definition.op_operand_kind(od, t.operand));
    if (through) {
        if (!type.is_pointer(ti, dty)) { ret; }
        dty = type.deref_one(ti, dty);
    }
    dty = type.strip_secret(ti, dty);
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val rel: target_definition.OpRelation = target_definition.op_operand_relation(od, i);
        if (rel != target_definition.OP_RELATION_NONE) {
            val tn:  *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + i];
            val pty: type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
            # a pointer operand that is no pointer is refused by its kind
            val via: bool = target_definition.op_kind_is_pointer(target_definition.op_operand_kind(od, i));
            if (!type.is_error(pty) && (!via || type.is_pointer(ti, pty))) {
                check_op_relation(sc, od, rel, subject, through, dty, tn.name, true, via, i, pty);
            }
        }
        i = i + 1;
    }
    if (od.result_relation == target_definition.OP_RELATION_NONE) { ret; }
    val rty: type.TypeId = sema_context.resolved_type_of(sc, d.data.fun_.return_type);
    if (type.is_error(rty) || type.is_nil(rty)) { ret; }
    check_op_relation(sc, od, od.result_relation, subject, through, dty, d.data.fun_.name, false, false, 0, rty);
}

# one relation: `ty`, the type of the operand `index` named at `at` (the result when
# `operand` is false), against the data type `dty` the typing's operand `subject` carries.
# when `via`, `ty` is a pointer whose pointee relates
fun check_op_relation(sc: *sema_context.SemaContext, od: *target_definition.Op, rel: target_definition.OpRelation, subject: *ast_decl.TypedName,
    through: bool, dty: type.TypeId, at: lang_source.Span, operand: bool, via: bool, index: u32, ty: type.TypeId) {
    val ti:  *type.TypeInterner = ?sc.s.types;
    var got: type.TypeId        = type.strip_secret(ti, ty);
    if (via) { got = type.strip_secret(ti, type.deref_one(ti, got)); }
    if (rel == target_definition.OP_RELATION_SHAPED) {
        check_op_shaped(sc, od, subject, dty, at, via, target_definition.op_operand_scalar(od, index), got, ty);
        ret;
    }
    if (rel == target_definition.OP_RELATION_DATA) {
        if (type.same(got, dty)) { ret; }
        val ts_r: res[str, fail.Fail] = check.type_to_str(sc, dty);
        if (sel ts_r.err) {
            fail.internal(?sc.status, fail.describe(ts_r.err));
            ret;
        }
        val want: str = ts_r.ok;
        fin { check.type_str_free(sc, want); }
        var what: str = "the type of";
        if (through)        { what = "the type pointed to by"; }
        if (via && through) { what = "a pointer to the type pointed to by"; }
        or (via)            { what = "a pointer to the type of"; }
        report_op_relation(sc, od, subject, at, operand, type.strip_secret(ti, ty), what, want,
            "operates on one type, read from");
        ret;
    }
    if (rel == target_definition.OP_RELATION_POINTEE) {
        check_op_pointee(sc, od, subject, dty, at, operand, got);
        ret;
    }
    if (rel == target_definition.OP_RELATION_COMPOSED) {
        check_op_composed(sc, od, subject, dty, at, got);
        ret;
    }
    if (rel == target_definition.OP_RELATION_SAMPLER) {
        check_op_sampler(sc, od, at, got);
        ret;
    }
    if (rel != target_definition.OP_RELATION_TEXEL) { ret; }
    var td:  *target_definition.Type = nil;
    var ops: *u32                    = nil;
    var n:   u32                     = 0;
    if (!op_texel_source(sc, dty, true, ?td, ?ops, ?n)) { ret; }
    val sampled: target_definition.OpScalar = target_definition.type_sampled(td, ops, n);
    var lanes:   u32                        = 1;
    # a type neither scalar nor vector keeps a kind with no primitive element
    var element: type.TypeKind = type.TYPE_VECTOR;
    if (type.is_vector(ti, got)) {
        lanes   = type.vector_lanes(ti, got);
        element = type.vector_element(ti, got);
    }
    or {
        val opt_g: opt[*type.Type] = type.get(ti, got);
        if (sel opt_g.some) { element = opt_g.some.kind; }
    }
    val count: *target_definition.OpTexelCount = od.texel_count;
    var what:  str                             = "a vector of the sampled type of";
    if (count.kind != target_definition.OP_COUNT_EXACT || count.components == 1)                                         { what = "a scalar or vector of the sampled type of"; }
    if (!op_sampled_matches(sc, od, subject, at, operand, got, sampled, element, what, "reads or writes the texels of")) { ret; }
    val stored: u32 = target_definition.type_components(td, ops, n);
    if (target_definition.op_texel_count_admits(count, lanes, stored)) { ret; }
    report_texel_count(sc, od, subject, at, operand, lanes, stored);
}

# an operand shaped like the data type `dty`: a scalar or vector of the scalar `fixed` states,
# with as many components as `dty`, which `got` is, read through the pointer `ty` when `via`
fun check_op_shaped(sc: *sema_context.SemaContext, od: *target_definition.Op, subject: *ast_decl.TypedName, dty: type.TypeId,
    at: lang_source.Span, via: bool, fixed: *target_definition.OpOperandScalar, got: type.TypeId, ty: type.TypeId) {
    val ti: *type.TypeInterner = ?sc.s.types;
    if (fixed == nil) { ret; }
    # a data type no scalar or vector of numbers is refused by the row's typing
    var lanes: u32 = 1;
    if (type.is_vector(ti, dty)) { lanes = type.vector_lanes(ti, dty); }
    var got_lanes: u32           = 0;
    var element:   type.TypeKind = type.TYPE_VECTOR;
    if (type.is_vector(ti, got)) {
        got_lanes = type.vector_lanes(ti, got);
        element   = type.vector_element(ti, got);
    }
    or {
        val opt_g: opt[*type.Type] = type.get(ti, got);
        if (sel opt_g.some) {
            got_lanes = 1;
            element   = opt_g.some.kind;
        }
    }
    if (got_lanes == lanes && op_scalar_is(element, fixed.scalar)) { ret; }
    var prefix: str = "f";
    if (fixed.scalar.class == target_definition.OP_DATA_INT && fixed.scalar.signed)  { prefix = "i"; }
    if (fixed.scalar.class == target_definition.OP_DATA_INT && !fixed.scalar.signed) { prefix = "u"; }
    var mw: res[str, std_format.FormatError];
    if (lanes == 1) { mw = std_format.sprint(sc.s.alloc, "{}{}", prefix, fixed.scalar.bits); }
    or              { mw = std_format.sprint(sc.s.alloc, "{}{}x{}", prefix, fixed.scalar.bits, lanes); }
    if (sel mw.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(mw.err)));
        ret;
    }
    val want: str = mw.ok;
    fin { str_free(sc.s.alloc, want); }
    val dty_r: res[str, fail.Fail] = check.type_to_str(sc, dty);
    if (sel dty_r.err) {
        fail.internal(?sc.status, fail.describe(dty_r.err));
        ret;
    }
    val dty_s: str = dty_r.ok;
    fin { check.type_str_free(sc, dty_s); }
    val got_r: res[str, fail.Fail] = check.type_to_str(sc, type.strip_secret(ti, ty));
    if (sel got_r.err) {
        fail.internal(?sc.status, fail.describe(got_r.err));
        ret;
    }
    val got_s: str = got_r.ok;
    fin { check.type_str_free(sc, got_s); }
    val name_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, at.offset, at.len);
    if (sel name_r.err) {
        fail.internal(?sc.status, fail.describe(fail.str_refused(name_r.err)));
        ret;
    }
    val name: str = name_r.ok;
    fin { str_free(sc.s.alloc, name); }
    val subject_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, subject.name.offset, subject.name.len);
    if (sel subject_r.err) {
        fail.internal(?sc.status, fail.describe(fail.str_refused(subject_r.err)));
        ret;
    }
    val subject_name: str = subject_r.ok;
    fin { str_free(sc.s.alloc, subject_name); }
    var lead: str = "";
    if (via) { lead = "a pointer to "; }
    val mr: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "`{}` must be {}`{}`, with as many components as `{}`, which is `{}`, not `{}`: {}",
        name, lead, want, subject_name, dty_s, got_s, fixed.rule);
    if (sel mr.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(mr.err)));
        ret;
    }
    val msg: str = mr.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, at, msg);
}

# a pointer result into the memory of the handle `dty`: a pointer to its sampled type, into
# a handle its constructor lets an instruction address
fun check_op_pointee(sc: *sema_context.SemaContext, od: *target_definition.Op, subject: *ast_decl.TypedName, dty: type.TypeId,
    at: lang_source.Span, operand: bool, got: type.TypeId) {
    val ti:  *type.TypeInterner      = ?sc.s.types;
    var td:  *target_definition.Type = nil;
    var ops: *u32                    = nil;
    var n:   u32                     = 0;
    if (!op_texel_source(sc, dty, false, ?td, ?ops, ?n)) { ret; }
    val refused: str = target_definition.type_address(td, ops, n);
    if (refused != nil) {
        sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, at, refused);
        ret;
    }
    # a type that is no pointer keeps a kind with no primitive element
    var kind: type.TypeKind = type.TYPE_VECTOR;
    if (type.is_pointer(ti, got)) {
        val pointee: opt[*type.Type] = type.get(ti, type.strip_secret(ti, type.deref_one(ti, got)));
        if (sel pointee.some) { kind = pointee.some.kind; }
    }
    op_sampled_matches(sc, od, subject, at, operand, got, target_definition.type_sampled(td, ops, n), kind,
        "a pointer to the sampled type of", "addresses a texel of");
}

# a result composed over the handle `dty`: a handle whose constructor takes its texels from
# that very handle, as a sampled image does from its image. only a result relates so
fun check_op_composed(sc: *sema_context.SemaContext, od: *target_definition.Op, subject: *ast_decl.TypedName, dty: type.TypeId,
    at: lang_source.Span, got: type.TypeId) {
    var td:     *target_definition.Type = nil;
    var ops:    *u32                    = nil;
    var n:      u32                     = 0;
    val minted: bool                    = op_texel_source(sc, dty, false, ?td, ?ops, ?n);
    if (minted && op_composes_over(sc, got, dty)) { ret; }
    val want_r: res[str, fail.Fail] = check.type_to_str(sc, dty);
    if (sel want_r.err) {
        fail.internal(?sc.status, fail.describe(want_r.err));
        ret;
    }
    val want: str = want_r.ok;
    fin { check.type_str_free(sc, want); }
    val got_r: res[str, fail.Fail] = check.type_to_str(sc, got);
    if (sel got_r.err) {
        fail.internal(?sc.status, fail.describe(got_r.err));
        ret;
    }
    val got_s: str = got_r.ok;
    fin { check.type_str_free(sc, got_s); }
    val subject_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, subject.name.offset, subject.name.len);
    if (sel subject_r.err) {
        fail.internal(?sc.status, fail.describe(fail.str_refused(subject_r.err)));
        ret;
    }
    val subject_name: str = subject_r.ok;
    fin { str_free(sc.s.alloc, subject_name); }
    var where: lang_source.Span                 = at;
    var mr:    res[str, std_format.FormatError] = res[str, std_format.FormatError].ok{nil};
    if (!minted) {
        where = subject.name;
        mr    = std_format.sprint(sc.s.alloc, "`{}` must be a handle the target mints, not `{}`: `{}` composes its result over `{}`, so its type decides the result's",
            subject_name, want, od.name, subject_name);
    }
    or {
        mr = std_format.sprint(sc.s.alloc, "the return type must be a handle composed over `{}`, the type of `{}`, and `{}` is not one: `{}` composes its result over `{}`",
            want, subject_name, got_s, od.name, subject_name);
    }
    if (sel mr.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(mr.err)));
        ret;
    }
    val msg: str = mr.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, where, msg);
}

# an operand that is a sampler: a handle whose constructor states how texels are sampled
fun check_op_sampler(sc: *sema_context.SemaContext, od: *target_definition.Op, at: lang_source.Span, got: type.TypeId) {
    val opt_h: opt[*type.Type] = type.get(?sc.s.types, got);
    if (sel opt_h.some) {
        val t: *type.Type = opt_h.some;
        if (t.kind == type.TYPE_HANDLE && t.data.handle.ctor != target_definition.NO_TYPE_CTOR) {
            val td: *target_definition.Type = target_definition.type_by_tag(sc.view.ctx.env.target_defs, t.data.handle.ctor);
            if (td != nil && td.samples) { ret; }
        }
    }
    val got_r: res[str, fail.Fail] = check.type_to_str(sc, got);
    if (sel got_r.err) {
        fail.internal(?sc.status, fail.describe(got_r.err));
        ret;
    }
    val got_s: str = got_r.ok;
    fin { check.type_str_free(sc, got_s); }
    val name_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, at.offset, at.len);
    if (sel name_r.err) {
        fail.internal(?sc.status, fail.describe(fail.str_refused(name_r.err)));
        ret;
    }
    val name: str = name_r.ok;
    fin { str_free(sc.s.alloc, name); }
    val mr: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "`{}` must be a sampler, a handle the target mints whose constructor states how texels are sampled, not `{}`: `{}` samples through it",
        name, got_s, od.name);
    if (sel mr.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(mr.err)));
        ret;
    }
    val msg: str = mr.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, at, msg);
}

# whether `got` is a handle whose constructor takes its texels from the handle `over`
fun op_composes_over(sc: *sema_context.SemaContext, got: type.TypeId, over: type.TypeId) bool {
    val opt_h: opt[*type.Type] = type.get(?sc.s.types, got);
    if (!sel opt_h.some)                     { ret false; }
    if (opt_h.some.kind != type.TYPE_HANDLE) { ret false; }
    val h: type.TypeHandle = opt_h.some.data.handle;
    if (h.ctor == target_definition.NO_TYPE_CTOR) { ret false; }
    val td: *target_definition.Type = target_definition.type_by_tag(sc.view.ctx.env.target_defs, h.ctor);
    if (td == nil || td.texels_of == target_definition.NO_TEXEL_OPERAND || td.texels_of >= h.ops_len) { ret false; }
    ret type.same(sc.s.types.handle_ops[h.ops_start + td.texels_of]::type.TypeId, over);
}

# whether the scalar of kind `kind` a texel or texel pointer carries is the handle's sampled
# type, reporting the relation `what` broken when it is not
fun op_sampled_matches(sc: *sema_context.SemaContext, od: *target_definition.Op, subject: *ast_decl.TypedName, at: lang_source.Span,
    operand: bool, got: type.TypeId, sampled: target_definition.OpScalar, kind: type.TypeKind, what: str, why: str) bool {
    if (sampled.class == target_definition.OP_DATA_OTHER) {
        report_op_relation(sc, od, subject, at, operand, got, what, "no type at all", why);
        ret false;
    }
    if (op_scalar_is(kind, sampled)) { ret true; }
    var prefix: str = "f";
    if (sampled.class == target_definition.OP_DATA_INT && sampled.signed)  { prefix = "i"; }
    if (sampled.class == target_definition.OP_DATA_INT && !sampled.signed) { prefix = "u"; }
    val sr: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc, "{}{}", prefix, sampled.bits);
    if (sel sr.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(sr.err)));
        ret false;
    }
    val want: str = sr.ok;
    fin { str_free(sc.s.alloc, want); }
    report_op_relation(sc, od, subject, at, operand, got, what, want, why);
    ret false;
}

# whether a scalar of kind `kind` is `want` by class, width and, for an integer, signedness
fun op_scalar_is(kind: type.TypeKind, want: target_definition.OpScalar) bool {
    val pd:    type.PrimDesc                 = type.prim_desc(kind);
    var class: target_definition.OpDataClass = target_definition.OP_DATA_OTHER;
    if (pd.class == type.PRIM_CLASS_INT)   { class = target_definition.OP_DATA_INT; }
    if (pd.class == type.PRIM_CLASS_FLOAT) { class = target_definition.OP_DATA_FLOAT; }
    ret class == want.class && pd.bits == want.bits && (class != target_definition.OP_DATA_INT || pd.signed == want.signed);
}

# the handle whose constructor states the texels of the handle `dty`: itself, or, when
# `follow`, the handle a composing constructor names as the one it takes its texels from.
# false when `dty` is no handle a target minted
fun op_texel_source(sc: *sema_context.SemaContext, dty: type.TypeId, follow: bool, out_td: **target_definition.Type, out_ops: **u32, out_n: *u32) bool {
    val ti:  *type.TypeInterner = ?sc.s.types;
    var cur: type.TypeId        = dty;
    var hop: u32                = 0;
    for (hop <= sema_handle.MAX_COMPOSE_DEPTH) {
        val opt_h: opt[*type.Type] = type.get(ti, cur);
        if (!sel opt_h.some)                     { ret false; }
        if (opt_h.some.kind != type.TYPE_HANDLE) { ret false; }
        val h: type.TypeHandle = opt_h.some.data.handle;
        if (h.ctor == target_definition.NO_TYPE_CTOR) { ret false; }
        val td: *target_definition.Type = target_definition.type_by_tag(sc.view.ctx.env.target_defs, h.ctor);
        if (td == nil) { ret false; }
        var ops: *u32 = nil;
        if (h.ops_len > 0) { ops = ?sc.s.types.handle_ops[h.ops_start]; }
        if (!follow || td.texels_of == target_definition.NO_TEXEL_OPERAND) {
            @out_td  = td;
            @out_ops = ops;
            @out_n   = h.ops_len;
            ret true;
        }
        if (td.texels_of >= h.ops_len) { ret false; }
        cur = ops[td.texels_of]::type.TypeId;
        hop = hop + 1;
    }
    ret false;
}

# a texel of `lanes` components refused by its row's count, naming the rule
fun report_texel_count(sc: *sema_context.SemaContext, od: *target_definition.Op, subject: *ast_decl.TypedName, at: lang_source.Span,
    operand: bool, lanes: u32, stored: u32) {
    val count:     *target_definition.OpTexelCount = od.texel_count;
    val subject_r: res[str, StrError]              = str_copy_slice(sc.s.alloc, sc.view.source, subject.name.offset, subject.name.len);
    if (sel subject_r.err) {
        fail.internal(?sc.status, fail.describe(fail.str_refused(subject_r.err)));
        ret;
    }
    val subject_name: str = subject_r.ok;
    fin { str_free(sc.s.alloc, subject_name); }
    var lead: str = "the return type";
    if (operand) {
        val related_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, at.offset, at.len);
        if (sel related_r.err) {
            fail.internal(?sc.status, fail.describe(fail.str_refused(related_r.err)));
            ret;
        }
        lead = related_r.ok;
    }
    fin {
        if (operand) { str_free(sc.s.alloc, lead); }
    }
    var quote: str = "`";
    if (!operand) { quote = ""; }
    var noun: str = "components";
    if (lanes == 1) { noun = "component"; }
    var mr: res[str, std_format.FormatError];
    if (count.kind == target_definition.OP_COUNT_FORMAT) {
        mr = std_format.sprint(sc.s.alloc,
            "{}{}{} has {} {}, and `{}` takes at least {}, the components the format of `{}` stores: {}",
            quote, lead, quote, lanes, noun, od.name, stored, subject_name, count.rule);
    }
    or {
        mr = std_format.sprint(sc.s.alloc, "{}{}{} has {} {}, and `{}` takes exactly {}: {}",
            quote, lead, quote, lanes, noun, od.name, count.components, count.rule);
    }
    if (sel mr.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(mr.err)));
        ret;
    }
    val msg: str = mr.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, at, msg);
}

# a relation refused, naming the related operand (or the result) and the typing's operand
fun report_op_relation(sc: *sema_context.SemaContext, od: *target_definition.Op, subject: *ast_decl.TypedName, at: lang_source.Span,
    operand: bool, got: type.TypeId, what: str, want: str, why: str) {
    val subject_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, subject.name.offset, subject.name.len);
    if (sel subject_r.err) {
        fail.internal(?sc.status, fail.describe(fail.str_refused(subject_r.err)));
        ret;
    }
    val subject_name: str = subject_r.ok;
    fin { str_free(sc.s.alloc, subject_name); }
    var lead: str = "the return type";
    if (operand) {
        val related_r: res[str, StrError] = str_copy_slice(sc.s.alloc, sc.view.source, at.offset, at.len);
        if (sel related_r.err) {
            fail.internal(?sc.status, fail.describe(fail.str_refused(related_r.err)));
            ret;
        }
        lead = related_r.ok;
    }
    fin {
        if (operand) { str_free(sc.s.alloc, lead); }
    }
    val got_r: res[str, fail.Fail] = check.type_to_str(sc, got);
    if (sel got_r.err) {
        fail.internal(?sc.status, fail.describe(got_r.err));
        ret;
    }
    val got_s: str = got_r.ok;
    fin { check.type_str_free(sc, got_s); }
    var quote: str = "`";
    if (!operand) { quote = ""; }
    val mr: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "{}{}{} must be {} `{}`, which is `{}`, not `{}`: `{}` {} `{}`, and holds this type to it",
        quote, lead, quote, what, subject_name, want, got_s, od.name, why, subject_name);
    if (sel mr.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(mr.err)));
        ret;
    }
    val msg: str = mr.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, at, msg);
}

# a typed row's data type must be one its typing admits in some storage class, a vector
# by its element type when the typing admits vectors. which feature it needs there is
# decided at each call, where the storage class is known
fun validate_op_data_type(sc: *sema_context.SemaContext, d: *ast_decl.Decl, od: *target_definition.Op) {
    val t: *target_definition.OpTyping = od.typing;
    if (t == nil || t.operand >= d.data.fun_.params_len)                                      { ret; }
    if (t.numeric != target_definition.OP_NUMERIC_NONE && !validate_op_numeric(sc, d, od, t)) { ret; }
    if (!target_definition.op_typing_constrains(t))                                           { ret; }
    val ti:  *type.TypeInterner  = ?sc.s.types;
    val tn:  *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + t.operand];
    var dty: type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
    if (type.is_error(dty))       { ret; }
    if (type.is_pointer(ti, dty)) { dty = type.deref_one(ti, dty); }
    dty = type.strip_secret(ti, dty);
    val vector: bool                          = type.is_vector(ti, dty);
    val pd:     type.PrimDesc                 = type.prim_desc(op_data_scalar(ti, dty));
    var class:  target_definition.OpDataClass = target_definition.OP_DATA_OTHER;
    if (!vector || t.vectors) {
        if (pd.class == type.PRIM_CLASS_INT)   { class = target_definition.OP_DATA_INT; }
        if (pd.class == type.PRIM_CLASS_FLOAT) { class = target_definition.OP_DATA_FLOAT; }
    }
    if (target_definition.op_type_requirement(t, class, pd.bits, target_definition.NO_OP_SPACE) != nil) { ret; }
    val shown_r: res[str, fail.Fail] = check.type_to_str(sc, dty);
    if (sel shown_r.err) {
        fail.internal(?sc.status, fail.describe(shown_r.err));
        ret;
    }
    val shown: str = shown_r.ok;
    fin { check.type_str_free(sc, shown); }
    var r: res[str, std_format.FormatError];
    if (vector && !t.vectors) { r = std_format.sprint(sc.s.alloc, "`{}` does not operate on `{}`: {} takes a scalar, never a vector", od.name, shown, t.name); }
    or {
        r = std_format.sprint(sc.s.alloc,
            "`{}` does not operate on `{}` in any storage class: {} takes only the integer and float widths the target's table lists, each with the feature it needs",
            od.name, shown, t.name);
    }
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(r.err)));
        ret;
    }
    val msg: str = r.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, msg);
}

# the scalar kind of a typed row's data type, a vector's element, TYPE_VECTOR (no number)
# for a type that is neither
fun op_data_scalar(ti: *type.TypeInterner, dty: type.TypeId) type.TypeKind {
    if (type.is_vector(ti, dty)) { ret type.vector_element(ti, dty); }
    val got: opt[*type.Type] = type.get(ti, dty);
    if (sel got.some) { ret got.some.kind; }
    ret type.TYPE_VECTOR;
}

# a numeric row's data operand is a scalar of the class of number its typing states, or a
# vector of one when the typing admits vectors, never a handle, a pointer or an aggregate.
# false, reported, when it is not
fun validate_op_numeric(sc: *sema_context.SemaContext, d: *ast_decl.Decl, od: *target_definition.Op, t: *target_definition.OpTyping) bool {
    val ti:  *type.TypeInterner  = ?sc.s.types;
    val tn:  *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + t.operand];
    val pty: type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
    if (type.is_error(pty)) { ret false; }
    val dty:   type.TypeId                   = type.strip_secret(ti, pty);
    val pd:    type.PrimDesc                 = type.prim_desc(op_data_scalar(ti, dty));
    var class: target_definition.OpDataClass = target_definition.OP_DATA_OTHER;
    if (!type.is_vector(ti, dty) || t.vectors) {
        if (pd.class == type.PRIM_CLASS_INT)   { class = target_definition.OP_DATA_INT; }
        if (pd.class == type.PRIM_CLASS_FLOAT) { class = target_definition.OP_DATA_FLOAT; }
    }
    if (target_definition.op_numeric_admits(t.numeric, class, pd.signed)) { ret true; }
    val shown_r: res[str, fail.Fail] = check.type_to_str(sc, pty);
    if (sel shown_r.err) {
        fail.internal(?sc.status, fail.describe(shown_r.err));
        ret false;
    }
    val shown: str = shown_r.ok;
    fin { check.type_str_free(sc, shown); }
    var form: str = "a scalar";
    if (t.vectors) { form = "a scalar or vector"; }
    val r: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "`{}` operates on {}, which must be {} of {}, not `{}`",
        od.name, t.name, form, target_definition.op_numeric_name(t.numeric), shown);
    if (sel r.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(r.err)));
        ret false;
    }
    val msg: str = r.ok;
    fin { str_free(sc.s.alloc, msg); }
    sema_context.report(sc, diagnostic_kind.OP_SIGNATURE, tn.name, msg);
    ret false;
}

fun target_is_selected(sc: *sema_context.SemaContext, tgt: str) bool {
    val no: opt[str] = intern.get(?sc.s.interner, sc.view.ctx.env.target_isa);
    if (!sel no.some) { ret false; }
    ret str_equals(tgt, no.some);
}

fun type_carries_handle(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    ret type.carries_handle(?sc.s.types, t);
}

# a field or payload type carrying a handle, other than through a chain of pointers over one,
# which its annotation is refused for already
fun handle_storage_unreported(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    if (!type_carries_handle(sc, t)) { ret false; }
    ret !type.has_handle_pointer_pointer(?sc.s.types, t);
}

# a binding whose written annotation holds a chain of pointers over a handle has drawn that
# annotation's refusal, and a binding whose type is inferred has no annotation to draw it
fun annotation_refuses_indirection(sc: *sema_context.SemaContext, ann: ast_id.TypeId, t: type.TypeId) bool {
    if (ast_id.type_is_nil(ann)) { ret false; }
    ret type.has_handle_pointer_pointer(?sc.s.types, t);
}

fun check_handle_fields_all(sc: *sema_context.SemaContext) {
    if (sc.view.decl_type == nil) { ret; }
    var d: u32 = 0;
    for (d < sc.view.a.decl_len::u32) {
        val d_opt: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, ast_id.decl(d));
        if (!sel d_opt.some) {
            d = d + 1;
            cnt;
        }
        val dd: *ast_decl.Decl = d_opt.some;
        if (dd.kind == ast_decl.DECL_KIND_REC) {
            check_handle_fields(sc, dd.data.rec_.fields_start, dd.data.rec_.fields_len);
        }
        or (dd.kind == ast_decl.DECL_KIND_UNI) {
            check_handle_fields(sc, dd.data.uni_.fields_start, dd.data.uni_.fields_len);
        }
        or (dd.kind == ast_decl.DECL_KIND_TAG) {
            var i: u32 = 0;
            for (i < dd.data.tag_.cases_len) {
                val c: *ast_decl.TagCase = ?sc.view.a.tag_cases[dd.data.tag_.cases_start + i];
                if (handle_storage_unreported(sc, sema_context.resolved_type_of(sc, c.payload))) {
                    sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, c.name, "a handle cannot be a tag payload because its representation is owned by the target");
                }
                i = i + 1;
            }
        }
        d = d + 1;
    }
}

fun check_handle_fields(sc: *sema_context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names[start + i];
        if (handle_storage_unreported(sc, sema_context.resolved_type_of(sc, tn.ty))) {
            sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, tn.name,
                "a handle cannot be a record or union field: a record is storage the program owns at offsets it can compute, and a handle's representation is not the program's, so an aggregate holding one has no layout. declare the handle itself");
        }
        i = i + 1;
    }
}

fun type_carries_abi_type(sc: *sema_context.SemaContext, t: type.TypeId) bool {
    if (type.is_nil(t) || type.is_error(t)) { ret false; }
    val opt_type: opt[*type.Type] = type.get(?sc.s.types, t);
    if (!sel opt_type.some) { ret false; }
    val tp: *type.Type = opt_type.some;
    if (tp.kind == type.TYPE_ABI)     { ret true; }
    if (tp.kind == type.TYPE_SECRET)  { ret type_carries_abi_type(sc, tp.data.secret.base); }
    if (tp.kind == type.TYPE_POINTER) { ret type_carries_abi_type(sc, tp.data.pointer.base); }
    if (tp.kind == type.TYPE_ARRAY)   { ret type_carries_abi_type(sc, tp.data.array.base); }
    ret false;
}

fun check_abi_type_placement(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) {
    if (d.kind == ast_decl.DECL_KIND_TAG) {
        var i: u32 = 0;
        for (i < d.data.tag_.cases_len) {
            val c: *ast_decl.TagCase = ?sc.view.a.tag_cases[d.data.tag_.cases_start + i];
            if (type_carries_abi_type(sc, sema_context.resolved_type_of(sc, c.payload))) {
                sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, c.name, abitype.exclusion_message());
            }
            i = i + 1;
        }
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_REC) {
        check_abi_type_fields(sc, d.data.rec_.fields_start, d.data.rec_.fields_len);
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_UNI) {
        check_abi_type_fields(sc, d.data.uni_.fields_start, d.data.uni_.fields_len);
        ret;
    }
    if (d.kind == ast_decl.DECL_KIND_FUN) {
        var i: u32 = 0;
        for (i < d.data.fun_.params_len) {
            val tn:  *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + i];
            val pty: type.TypeId         = sema_context.resolved_type_of(sc, tn.ty);
            if (type_carries_abi_type(sc, pty) && !type.is_abi_type(?sc.s.types, pty)) {
                sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, tn.name, abitype.exclusion_message());
            }
            i = i + 1;
        }
        if (type_carries_abi_type(sc, sema_context.resolved_type_of(sc, d.data.fun_.return_type))) {
            sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, d.data.fun_.name, abitype.exclusion_message());
        }
        ret;
    }
    if (is_global_binding(d.kind)) {
        if (sc.view.decl_type == nil) { ret; }
        if (type_carries_abi_type(sc, sc.view.decl_type[ast_id.decl_index(did)])) {
            sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, d.span, abitype.exclusion_message());
        }
    }
}

fun check_abi_type_fields(sc: *sema_context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names[start + i];
        if (type_carries_abi_type(sc, sema_context.resolved_type_of(sc, tn.ty))) {
            sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, tn.name, abitype.exclusion_message());
        }
        i = i + 1;
    }
}

# a function's parameters and result are values the program passes, and a handle reaches
# one by value or behind a pointer to its binding, never inside an array
fun check_handle_signature(sc: *sema_context.SemaContext, d: *ast_decl.Decl) {
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret; }
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val tn: *ast_decl.TypedName = ?sc.view.a.typed_names[d.data.fun_.params_start + i];
        sema_context.check_handle_in_array(sc, sema_context.resolved_type_of(sc, tn.ty), tn.name);
        i = i + 1;
    }
    sema_context.check_handle_in_array(sc, sema_context.resolved_type_of(sc, d.data.fun_.return_type), d.data.fun_.name);
}

fun check_handle_decl(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) {
    if (sc.view.decl_type == nil)   { ret; }
    if (!is_global_binding(d.kind)) { ret; }
    val ty:      type.TypeId = sc.view.decl_type[ast_id.decl_index(did)];
    val carries: bool        = type_carries_handle(sc, ty);
    val sampler: bool        = decorator.has(sc.view.a, d, decorator.SAMPLER);
    val storage: bool        = decorator.has(sc.view.a, d, decorator.STORAGE);

    if (carries && !type.is_handle(?sc.s.types, ty)) {
        if (annotation_refuses_indirection(sc, d.data.bind.ty, ty)) { ret; }
        sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, d.span,
            "a handle cannot sit behind a pointer or inside an array: a pointer and an array are both extents the program computes, and a handle's extent is the owning target's rather than the program's, so there is no element size to step by. declare the handle itself");
        ret;
    }
    if (!carries) {
        if (sampler) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, d.span,
                "`sampler` decorator applies only to a handle binding, a `def` declared with `#[handle(...)]`; a descriptor-bound block or buffer of an ordinary type is `#[uniform(set, binding)]` or `#[storage(set, binding)]`");
        }
        ret;
    }

    val bind: u32 = handle_binding(sc, ty);
    if (bind == HANDLE_BIND_EITHER && (sampler || storage))       { ret; }
    if (bind == target_definition.HANDLE_BIND_STORAGE && storage) { ret; }
    if (bind == target_definition.HANDLE_BIND_SAMPLER && sampler) { ret; }
    if (bind == target_definition.HANDLE_BIND_STORAGE && sampler) {
        sema_context.report(sc, diagnostic_kind.HANDLE_ROLE, d.span,
            "a storage image binds through `#[storage(set, binding)]`, not `#[sampler(set, binding)]`: an image whose `Sampled` operand is `2` is read and written directly, which is Vulkan's STORAGE_IMAGE descriptor, and `\"readonly\"`, `\"writeonly\"` and `\"coherent\"` qualify it as they do a buffer");
        ret;
    }
    if (bind == target_definition.HANDLE_BIND_SAMPLER && storage) {
        sema_context.report(sc, diagnostic_kind.HANDLE_ROLE, d.span,
            "this handle binds through `#[sampler(set, binding)]`, not `#[storage(set, binding)]`: a sampled image, a sampled-image pair and a sampler are read through a sampler and never written, so they are no storage descriptor. only an image whose `Sampled` operand is `2` binds as storage");
        ret;
    }
    if (decorator.has(sc.view.a, d, decorator.INPUT) || decorator.has(sc.view.a, d, decorator.OUTPUT)
        || decorator.has(sc.view.a, d, decorator.BUILTIN) || decorator.has(sc.view.a, d, decorator.UNIFORM)
        || decorator.has(sc.view.a, d, decorator.PUSH) || decorator.has(sc.view.a, d, decorator.SHARED)) {
        sema_context.report(sc, diagnostic_kind.HANDLE_ROLE, d.span,
            "a handle is bound as a descriptor and carries `#[sampler(set, binding)]`, or `#[storage(set, binding)]` for a storage image; the role on it puts the handle in a storage class no handle may live in");
        ret;
    }
    sema_context.report(sc, diagnostic_kind.HANDLE_UNBOUND, d.span,
        "a handle binding needs a `#[sampler(set, binding)]` decorator, or `#[storage(set, binding)]` for a storage image: a shader has no general global storage, so a handle with no descriptor address is reachable from no stage");
}

# a handle whose target is not the selected one names no operands this build reads,
# so either descriptor role binds it
val HANDLE_BIND_EITHER: u32 = 0xFFFFFFFF;

# the descriptor role the selected target binds a handle type through
fun handle_binding(sc: *sema_context.SemaContext, ty: type.TypeId) u32 {
    val opt_t: opt[*type.Type] = type.get(?sc.s.types, ty);
    if (!sel opt_t.some) { ret HANDLE_BIND_EITHER; }
    val h: type.TypeHandle = opt_t.some.data.handle;
    if (h.ctor == target_definition.NO_TYPE_CTOR) { ret HANDLE_BIND_EITHER; }
    val td: *target_definition.Type = target_definition.type_by_tag(sc.view.ctx.env.target_defs, h.ctor);
    if (td == nil) { ret HANDLE_BIND_EITHER; }
    var ops: *u32 = nil;
    if (h.ops_len > 0) { ops = ?sc.s.types.handle_ops[h.ops_start]; }
    ret target_definition.type_binding(td, ops, h.ops_len);
}

fun is_global_binding(kind: ast_decl.DeclKind) bool {
    ret kind == ast_decl.DECL_KIND_VAL || kind == ast_decl.DECL_KIND_VAR;
}

fun is_fun_or_global(kind: ast_decl.DeclKind) bool {
    ret kind == ast_decl.DECL_KIND_FUN || kind == ast_decl.DECL_KIND_VAL || kind == ast_decl.DECL_KIND_VAR;
}

fun decorator_arg_type(sc: *sema_context.SemaContext, eid: ast_id.ExprId) type.TypeId {
    if (ast_id.expr_is_nil(eid))                             { ret type.TYPE_ERROR; }
    if (ast_id.expr_index(eid)::usize >= sc.view.a.expr_len) { ret type.TYPE_ERROR; }
    ret sc.view.expr_type[ast_id.expr_index(eid)];
}

# the rule a decorator adds to its row, keyed by its id; a decorator its row holds
# entirely adds none
fun validate_decorator_rule(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    val id: decorator.Id = dec.id;
    if (id == decorator.SPEC && d.kind == ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`spec` decorator applies only to a module-level `var`: the host supplies a specialization constant's value at pipeline creation, so it is no compile-time constant and a `val` would promise one");
        ret;
    }
    if (id == decorator.SHARED && d.kind == ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`#[shared]` applies to a `var`: workgroup memory is written by the stage, and a `val` of it would only ever read zero");
        ret;
    }
    if (decorator.flagged(id, decorator.FLAG_ROLE)) { validate_iface_role(sc, d, dec); }
    if (id == decorator.TESTING)                    { validate_testing(sc, d, dec); }
    or (id == decorator.EXPECT)                     { validate_expect(sc, dec); }
    or (id == decorator.ALIGN)                      { validate_align(sc, d, dec); }
    or (id == decorator.STAGE)                      { validate_stage_value(sc, dec, decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0)); }
    or (id == decorator.WORKGROUP)                  { validate_workgroup(sc, d, dec); }
    or (id == decorator.BUILTIN)                    { validate_builtin_value(sc, dec, decorator.string_of(?sc.s.interner, sc.view.ctx, sc.view.a, dec, 0)); }
    or (id == decorator.STORAGE)                    { validate_storage_quals(sc, dec); }
    or (id == decorator.PACKED)                     { validate_packed(sc, d, dec); }
    or (id == decorator.NAKED)                      { validate_naked(sc, d, dec); }
    or (id == decorator.EXTENSIONS)                 { validate_extensions(sc, d, dec); }
    or (id == decorator.OP)                         { validate_op(sc, d, dec); }
    or (id == decorator.HANDLE)                     { sema_handle.validate(sc, d, dec); }
    or (id == decorator.ABI_TYPE)                   { abitype.validate(sc, d, dec); }
}

# an `align` on a function or a global is an integer constant; a type's is read with its layout
fun validate_align(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (dec.args_len == 1 && is_fun_or_global(d.kind)) {
        require_integer_arg(sc, dec, 0, "`align` decorator argument must be an integer comptime expression");
    }
}

# a workgroup sizes a compute stage, each dimension an integer or a `#[spec]` var
fun validate_workgroup(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    var wi: u32 = 0;
    for (dec.args_len == 3 && wi < 3) {
        if (!validate_workgroup_dim(sc, dec, wi)) { brk; }
        wi = wi + 1;
    }
    if (!decorator.has(sc.view.a, d, decorator.STAGE)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_REQUIRES, dec.name, "`workgroup` decorator requires a `#[stage(\"compute\")]` on the same function; it sizes a compute stage's workgroup and means nothing without one");
    }
}

fun validate_packed(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.has(sc.view.a, d, decorator.UNIFORM) || decorator.has(sc.view.a, d, decorator.STORAGE) || decorator.has(sc.view.a, d, decorator.PUSH)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name,
            "`packed` cannot apply to a `uniform` / `storage` / `push` interface block: its member offsets are fixed by the std140 / std430 layout rules and emitted as explicit Offset decorations, which packing would contradict");
    }
}

# `#[testing]` confines references to test code, which neither an `ext` declaration
# nor a decorator naming a consumer outside Mach source lets it follow
fun validate_testing(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`testing` cannot apply to an `ext` declaration: its definition and callers live outside Mach source, where test-only confinement cannot follow them");
    }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val other: *ast_decl.Decorator = ?sc.view.a.decorators[d.decorators_start + i];
        i = i + 1;
        if (!decorator.flagged(other.id, decorator.FLAG_TESTING_EXCLUSIVE)) { cnt; }
        val message: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
            "`testing` cannot combine with `{}`: it names a consumer outside Mach source, where test-only confinement cannot follow it", decorator.name_of(other.id));
        if (sel message.err) {
            fail.internal(?sc.status, "testing decorator message could not be formatted");
            ret;
        }
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, message.ok);
        str_free(sc.s.alloc, message.ok);
    }
}

# `#[expect("<key>", ...)]`: each argument names a warning key or family, as a
# string named once. an unknown key is refused, and so is one that covers only
# errors, since an error is never acknowledged
fun validate_expect(sc: *sema_context.SemaContext, dec: *ast_decl.Decorator) {
    var i: u32 = 0;
    for (i < dec.args_len) {
        val eid: ast_id.ExprId = sc.view.a.expr_ids[dec.args_start + i];
        val key: opt[str]      = sema_context.decorator_string_arg(sc, dec, i, diagnostic_kind.DECORATOR_ARGUMENT, "`expect` key must be a string");
        if (sel key.some) {
            val at:     lang_source.Span          = expect.arg_span(sc.view.a, eid, dec.name);
            var picked: diagnostic_kind.Selection = diagnostic_kind.select(key.some);
            var dup:    bool                      = false;
            var j:      u32                       = 0;
            for (!dup && j < i) {
                val prior: opt[str] = expect.key_of(sc.s, sc.view.ctx, sc.view.a.expr_ids[dec.args_start + j]);
                if (sel prior.some && str_equals(prior.some, key.some)) { dup = true; }
                j = j + 1;
            }
            var message: res[str, std_format.FormatError] = res[str, std_format.FormatError].ok{nil};
            var refused: diagnostic_kind.Kind             = diagnostic_kind.EXPECT_UNKNOWN_KEY;
            if (diagnostic_kind.selection_unknown(?picked)) {
                message = std_format.sprint(sc.s.alloc,
                    "`{}` is not a warning key: `expect` names a key or a family of keys from the diagnostic kind table, such as `vector.scalarize` or `vector`", key.some);
            }
            or (diagnostic_kind.selection_empty(?picked)) {
                message = std_format.sprint(sc.s.alloc, "`{}` names an error, and an error is never acknowledged", key.some);
                refused = diagnostic_kind.EXPECT_ERROR_KEY;
            }
            or (dup) {
                message = std_format.sprint(sc.s.alloc, "`expect` names `{}` twice", key.some);
                refused = diagnostic_kind.EXPECT_DUPLICATE_KEY;
            }
            if (sel message.err) {
                fail.internal(?sc.status, "expect decorator message could not be formatted");
                ret;
            }
            if (message.ok != nil) {
                sema_context.report(sc, refused, at, message.ok);
                str_free(sc.s.alloc, message.ok);
            }
        }
        i = i + 1;
    }
}

# `#[extensions(name, ...)]`: a function whose body may use extensions the target
# does not select. each argument is a bare extension name some isa declares,
# listed once, and never one only a target selects; the caller's run-time
# check is its own contract, never enforced
fun validate_extensions(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (ast_id.stmt_is_nil(d.data.fun_.body) || (d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`extensions` decorator applies only to a function with a body");
        ret;
    }
    val vocabulary: *extension.Vocabulary = ?sc.view.ctx.env.vocabulary;
    var i:          u32                   = 0;
    for (i < dec.args_len) {
        val eid:   ast_id.ExprId       = sc.view.a.expr_ids[dec.args_start + i];
        val e_opt: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, eid);
        if (!sel e_opt.some) { ret; }
        val e: *ast_expr.Expr = e_opt.some;
        if (e.kind != ast_expr.EXPR_KIND_IDENT) {
            sema_context.report(sc, diagnostic_kind.DECORATOR_ARGUMENT, e.span, "`extensions` decorator arguments are bare extension names, as in `#[extensions(sha, ssse3)]`");
            ret;
        }
        val tok:  lang_source.Span = e.data.ident.tok;
        val name: str              = (sc.view.source::usize + tok.offset::usize)::str;
        var j:    u32              = 0;
        for (j < i) {
            val prior: opt[*ast_expr.Expr] = ast.get_expr(sc.view.a, sc.view.a.expr_ids[dec.args_start + j]);
            if (sel prior.some) {
                val pe: *ast_expr.Expr = prior.some;
                if (pe.kind == ast_expr.EXPR_KIND_IDENT && guard.span_text_equal(sc, pe.data.ident.tok, tok)) {
                    sema_context.report(sc, diagnostic_kind.EXTENSION_DUPLICATE, e.span, "`extensions` decorator names this extension twice");
                    ret;
                }
            }
            j = j + 1;
        }
        if (vocabulary.len > 0) {
            val found: target_model.DecoratorExtension = target_model.decorator_extension(vocabulary, sc.view.ctx.env.extensions, name, tok.len::usize);
            if (!found.known) {
                sema_context.report(sc, diagnostic_kind.EXTENSION_UNKNOWN, e.span, unknown_extension_text(sc, vocabulary, name, tok.len::usize));
                ret;
            }
            if (found.target_only != nil) {
                sema_context.report(sc, diagnostic_kind.EXTENSION_TARGET_ONLY, e.span, target_only_extension_text(sc, name, tok.len::usize, found.target_only));
                ret;
            }
        }
        i = i + 1;
    }
}

fun target_only_extension_text(sc: *sema_context.SemaContext, name: str, len: usize, why: str) str {
    val fallback: str   = "`extensions` decorator names an extension only a target selects";
    var spelled:  [64]u8;
    var i:        usize = 0;
    for (i < len && i < 63) {
        spelled[i] = name[i]::u8;
        i          = i + 1;
    }
    spelled[i] = 0;
    val r: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "`extensions` decorator: `{}` is not a function's to admit, {}; select it with the target's `extensions` or isa string",
        (?spelled[0])::str, why);
    if (sel r.err) { ret fallback; }
    ret r.ok;
}

fun unknown_extension_text(sc: *sema_context.SemaContext, vocabulary: *extension.Vocabulary, name: str, len: usize) str {
    val fallback: str                 = "`extensions` decorator names an extension no instruction set declares";
    val known_r:  res[str, fail.Fail] = target_model.vocabulary_names(sc.s.alloc, vocabulary);
    if (sel known_r.err) { ret fallback; }
    val known: str = known_r.ok;
    fin { str_free(sc.s.alloc, known); }
    var spelled: [64]u8;
    var i:       usize = 0;
    for (i < len && i < 63) {
        spelled[i] = name[i]::u8;
        i          = i + 1;
    }
    spelled[i] = 0;
    val r: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "`extensions` decorator: no instruction set declares an extension `{}`; the known extensions are: {}",
        (?spelled[0])::str, known);
    if (sel r.err) { ret fallback; }
    ret r.ok;
}

fun validate_naked(sc: *sema_context.SemaContext, d: *ast_decl.Decl, dec: *ast_decl.Decorator) {
    if (decorator.has(sc.view.a, d, decorator.INLINE)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`naked` and `inline` decorators are mutually exclusive; a naked function cannot be inlined");
    }
    if (decorator.has(sc.view.a, d, decorator.OBLIVIOUS)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_CONFLICT, dec.name, "`naked` and `oblivious` decorators are mutually exclusive; a naked body is inline asm, which `oblivious` forbids");
    }
    if (ast_id.stmt_is_nil(d.data.fun_.body)) {
        sema_context.report(sc, diagnostic_kind.DECORATOR_MISPLACED, dec.name, "`naked` decorator applies only to a function with a body");
        ret;
    }
    check_naked_body(sc, d.data.fun_.body);
}

fun check_naked_body(sc: *sema_context.SemaContext, sid: ast_id.StmtId) {
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (!sel opt_stmt.some) { ret; }
    val s: *ast_stmt.Stmt = opt_stmt.some;

    if (s.kind == ast_stmt.STMT_KIND_ASM) { ret; }

    if (s.kind == ast_stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            check_naked_body(sc, sc.view.a.stmt_ids[s.data.block.stmts_start + i]);
            i = i + 1;
        }
        ret;
    }

    if (s.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[s.data.comptime_if.branches_start + b];
            var i:  u32                      = 0;
            for (i < br.body_len) {
                check_naked_body(sc, sc.view.a.stmt_ids[br.body_start + i]);
                i = i + 1;
            }
            b = b + 1;
        }
        ret;
    }

    sema_context.report(sc, diagnostic_kind.NAKED_BODY, s.span, "a `naked` function's body may contain only inline `asm` statements");
}

fun test_return_type(sc: *sema_context.SemaContext) type.TypeId {
    val opt_i32: opt[type.TypeId] = type.prim(?sc.s.types, type.TYPE_I32);
    if (!sel opt_i32.some) { ret type.TYPE_ERROR; }
    ret opt_i32.some;
}

# a test result is a process status: the u8 range is the status range, so a
# literal-shaped `ret` value outside it is refused here, at the ret, instead of
# being folded by the dispatcher at run time
fun check_test_status(sc: *sema_context.SemaContext, value: ast_id.ExprId, span: lang_source.Span) {
    if (ast_id.expr_is_nil(value)) { ret; }
    val opt_u8: opt[type.TypeId] = type.prim(?sc.s.types, type.TYPE_U8);
    if (!sel opt_u8.some) { ret; }
    val cr: coerce.CoerceResult = coerce.probe_literal_range(sc, value, opt_u8.some);
    if (cr.kind != coerce.COERCE_OUT_OF_RANGE) { ret; }
    var sign: str = "";
    if (cr.negated) { sign = "-"; }
    var digits:  [wide.FORMAT_CAP]u8;
    val res_msg: res[str, std_format.FormatError] = std_format.sprint(sc.s.alloc,
        "test result {}{} is outside the status range 0..255", sign, wide.text_u(cr.value, ?digits[0]));
    if (sel res_msg.err) {
        fail.internal(?sc.status, fail.describe(fail.format_refused(res_msg.err)));
        sema_context.report(sc, diagnostic_kind.TEST_STATUS_RANGE, span, "test result is outside the status range 0..255");
        ret;
    }
    val msg: str = res_msg.ok;
    sema_context.report_note(sc, diagnostic_kind.TEST_STATUS_RANGE, span, msg,
        "a test reports its result as the process exit status, which is eight bits on every host; 0 passes and 1..255 fail");
    str_free(sc.s.alloc, msg);
}

fun infer_binding_init(sc: *sema_context.SemaContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    if (ast_id.expr_is_nil(d.data.bind.init)) { ret err[fail.Fail].ok{}; }
    if (ast_id.type_is_nil(d.data.bind.ty))   { ret err[fail.Fail].ok{}; }

    val actual:   type.TypeId = infer.infer_expr(sc, d.data.bind.init);
    val expected: type.TypeId = sc.view.decl_type[ast_id.decl_index(did)];
    if (!type.is_nil(expected) && !type.is_error(expected) && !type.is_error(actual)) {
        check_binding(sc, expected, d.data.bind.init, actual, d.span);
        if (d.kind == ast_decl.DECL_KIND_VAL && comptime.is_case_literal(sc.view.a, d.data.bind.init)) {
            ret rebind_constant_tag(sc, d, expected);
        }
    }
    ret err[fail.Fail].ok{};
}

# name resolution bound a case-literal `val` as an untyped constant element; the checked type lets
# a nested payload read name its member types
fun rebind_constant_tag(sc: *sema_context.SemaContext, d: *ast_decl.Decl, ty: type.TypeId) err[fail.Fail] {
    val name_r: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, d.data.bind.name.offset, d.data.bind.name.len);
    if (sel name_r.err) { ret err[fail.Fail].err{fail.refused(name_r.err)}; }
    val name:  intern.StrId             = name_r.ok;
    val bound: opt[comptime.NamedConst] = comptime.lookup(sc.view.ctx, name);
    if (!sel bound.some) { ret err[fail.Fail].ok{}; }
    val nc: comptime.NamedConst = bound.some;
    if (nc.value.kind != comptime.CT_KIND_CONST_ELEM || nc.value.data.celem.elem != d.data.bind.init::u32) { ret err[fail.Fail].ok{}; }
    if (nc.value.data.celem.ty == ty::u32)                                                                 { ret err[fail.Fail].ok{}; }
    ret comptime.bind_gated(sc.view.ctx, name, comptime.const_elem_value(d.data.bind.init::u32, ty::u32), nc.gated);
}

fun infer_bodies_deferred_chain(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf) err[fail.Fail] {
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[ci.branches_start + i];
        if (ast_id.expr_is_nil(br.cond)) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        val e_opt: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, br.cond);
        if (sel e_opt.err) { ret err[fail.Fail].err{fail.message("comptime branch cond ExprId out of range")}; }
        val cond_span: lang_source.Span = e_opt.ok.span;

        val outer: sema_context.Walk = sema_context.walk_open(sc);
        sc.walk.in_comptime_gate = true;
        val decided: res[opt[comptime_gate.GateVerdict], fail.Fail] = deferred_gate_decide(sc, br.cond, cond_span);
        sema_context.walk_close(sc, outer);
        if (sel decided.err)     { ret err[fail.Fail].err{decided.err}; }
        if (sel decided.ok.none) { ret err[fail.Fail].ok{}; }
        val v: comptime_gate.GateVerdict = decided.ok.some;
        if (gate_verdict_truth(v)) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a statement gate's verdict in the walk's frame, recorded there for lowering once decided
# types a gate's condition inside the gate and checks that it is a condition
fun gate_condition_check(sc: *sema_context.SemaContext, cond: ast_id.ExprId) bool {
    val outer: sema_context.Walk = sema_context.walk_open(sc);
    sc.walk.in_comptime_gate = true;
    var ok:      bool        = false;
    val gate_ty: type.TypeId = infer.infer_expr(sc, cond);
    if (!type.is_error(gate_ty)) {
        ok = true;
        val gate: res[ast_expr.Expr, fail.Fail] = sema_context.expression(sc, cond);
        if (sel gate.ok) { ok = check.check_condition(sc, gate_ty, gate.ok.span); }
    }
    sema_context.walk_close(sc, outer);
    ret ok;
}

# the verdict of a deferred chain's gate, none when the gate is not a condition or its
# verdict is neither active nor inactive, which is reported at `cond_span`
fun deferred_gate_decide(sc: *sema_context.SemaContext, cond: ast_id.ExprId, cond_span: lang_source.Span) res[opt[comptime_gate.GateVerdict], fail.Fail] {
    val gate_ty: type.TypeId = infer.infer_expr(sc, cond);
    if (type.is_error(gate_ty) || !check.check_condition(sc, gate_ty, cond_span)) { ret res[opt[comptime_gate.GateVerdict], fail.Fail].ok{opt[comptime_gate.GateVerdict].none{}}; }
    val vr: res[comptime_gate.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, cond);
    if (sel vr.err) { ret res[opt[comptime_gate.GateVerdict], fail.Fail].err{vr.err}; }
    val v: comptime_gate.GateVerdict = vr.ok;
    if (v.outcome != comptime_gate.GATE_ACTIVE && v.outcome != comptime_gate.GATE_INACTIVE) {
        if (str_len(v.message) > 0) { sema_context.report(sc, v.diag, cond_span, v.message); }
        ret res[opt[comptime_gate.GateVerdict], fail.Fail].ok{opt[comptime_gate.GateVerdict].none{}};
    }
    ret res[opt[comptime_gate.GateVerdict], fail.Fail].ok{opt[comptime_gate.GateVerdict].some{v}};
}

fun stmt_gate_verdict(sc: *sema_context.SemaContext, cond: ast_id.ExprId) res[comptime_gate.GateVerdict, fail.Fail] {
    val vr: res[comptime_gate.GateVerdict, fail.Fail] = comptime_gate.evaluate_gate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, cond,
        ?sc.s.interner, comptime_gate.GATE_SCOPE_INSTANCE, false);
    if (sel vr.ok) {
        if (vr.ok.outcome == comptime_gate.GATE_ACTIVE)   { sema_context.gate_set(sc, cond, true); }
        if (vr.ok.outcome == comptime_gate.GATE_INACTIVE) { sema_context.gate_set(sc, cond, false); }
    }
    ret vr;
}

fun gate_verdict_truth(v: comptime_gate.GateVerdict) bool {
    ret v.outcome == comptime_gate.GATE_ACTIVE;
}

fun infer_bodies_comptime_if(sc: *sema_context.SemaContext, ci: *ast_decl.DeclComptimeIf) err[fail.Fail] {
    if (comptime_gate.comptime_if_declares_nothing(sc.view.a, ci.branches_start, ci.branches_len)) {
        ret infer_bodies_deferred_chain(sc, ci);
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br:       *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[ci.branches_start + i];
        val active_r: res[bool, fail.Fail]     = comptime_branch_active(sc, br);
        if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
        if (active_r.ok) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_stmt(sc: *sema_context.SemaContext, sid: ast_id.StmtId, fn_ret: type.TypeId) err[fail.Fail] {
    if (ast_id.stmt_is_nil(sid)) { ret err[fail.Fail].ok{}; }
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(sc.view.a, sid);
    if (!sel opt_stmt.some) { ret err[fail.Fail].err{fail.message("StmtId out of range")}; }
    val st: *ast_stmt.Stmt = opt_stmt.some;

    if (st.kind == ast_stmt.STMT_KIND_EXPR) {
        val ty: type.TypeId = infer.infer_expr(sc, st.data.expr.expr);
        if (type.is_case_selector(?sc.s.types, ty)) {
            sema_context.report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, st.span, "a case selector is not a value");
        }
        ret err[fail.Fail].ok{};
    }
    if (st.kind == ast_stmt.STMT_KIND_BLOCK) {
        ret infer_stmt_list(sc, st.data.block.stmts_start, st.data.block.stmts_len, fn_ret);
    }
    if (st.kind == ast_stmt.STMT_KIND_IF) {
        val cond_ty: type.TypeId = infer.infer_expr(sc, st.data.if_.cond);
        if (!type.is_error(cond_ty)) { check.check_condition(sc, cond_ty, st.span); }
        var arm_guard: sema_context.Guard;
        val opened:    bool           = guard.open_sel(sc, st.data.if_.cond, ?arm_guard);
        val res_then:  err[fail.Fail] = infer_stmt(sc, st.data.if_.then_block, fn_ret);
        if (opened)           { guard.close(sc, ?arm_guard); }
        if (sel res_then.err) { ret res_then; }
        ret infer_stmt(sc, st.data.if_.else_block, fn_ret);
    }
    if (st.kind == ast_stmt.STMT_KIND_FOR) {
        if (!ast_id.expr_is_nil(st.data.for_.cond)) {
            val cond_ty: type.TypeId = infer.infer_expr(sc, st.data.for_.cond);
            if (!type.is_error(cond_ty)) { check.check_condition(sc, cond_ty, st.span); }
        }
        sc.walk.fin_loop_depth = sc.walk.fin_loop_depth + 1;
        val res_body: err[fail.Fail] = infer_stmt(sc, st.data.for_.body, fn_ret);
        sc.walk.fin_loop_depth = sc.walk.fin_loop_depth - 1;
        ret res_body;
    }
    if (st.kind == ast_stmt.STMT_KIND_RET) {
        if (sc.walk.in_fin) {
            sema_context.report(sc, diagnostic_kind.FIN_RET, st.span, "`ret` cannot appear inside a `fin` body");
        }
        check_return_stmt(sc, fn_ret, st.data.ret_.value, st.span);
        if (sc.walk.in_test) { check_test_status(sc, st.data.ret_.value, st.span); }
        ret err[fail.Fail].ok{};
    }
    if (st.kind == ast_stmt.STMT_KIND_BRK) {
        if (sc.walk.in_fin && sc.walk.fin_loop_depth == 0) {
            sema_context.report(sc, diagnostic_kind.FIN_JUMP, st.span, "`brk` inside a `fin` body cannot target a loop outside the fin");
        }
        ret err[fail.Fail].ok{};
    }
    if (st.kind == ast_stmt.STMT_KIND_CNT) {
        if (sc.walk.in_fin && sc.walk.fin_loop_depth == 0) {
            sema_context.report(sc, diagnostic_kind.FIN_JUMP, st.span, "`cnt` inside a `fin` body cannot target a loop outside the fin");
        }
        ret err[fail.Fail].ok{};
    }
    if (st.kind == ast_stmt.STMT_KIND_FIN) {
        val outer: sema_context.Walk = sema_context.walk_open(sc);
        sc.walk.in_fin         = true;
        sc.walk.fin_loop_depth = 0;
        val res_body: err[fail.Fail] = infer_stmt(sc, st.data.fin_.body, fn_ret);
        sema_context.walk_close(sc, outer);
        ret res_body;
    }
    if (st.kind == ast_stmt.STMT_KIND_DECL) {
        ret infer_local_decl(sc, st.data.decl.decl);
    }
    if (st.kind == ast_stmt.STMT_KIND_COMPTIME_IF) {
        ret infer_stmt_comptime_if(sc, st.data.comptime_if.branches_start, st.data.comptime_if.branches_len, fn_ret);
    }
    if (st.kind == ast_stmt.STMT_KIND_COMPTIME_EACH) {
        ret infer_stmt_comptime_each(sc, sid, ?st.data.comptime_each, st.span, fn_ret);
    }
    if (st.kind == ast_stmt.STMT_KIND_COMPTIME_DIRECTIVE) {
        eval_comptime_directive(sc, st.data.comptime_directive.target, st.span);
        ret err[fail.Fail].ok{};
    }
    if (st.kind == ast_stmt.STMT_KIND_ASM || st.kind == ast_stmt.STMT_KIND_ERROR) { ret err[fail.Fail].ok{}; }
    val failure: fail.Fail = resolve.unknown_catalog(sc.s, "StmtKind", st.kind::u32);
    fail.internal(?sc.status, fail.describe(failure));
    ret err[fail.Fail].err{failure};
}

fun eval_comptime_directive(sc: *sema_context.SemaContext, target: ast_id.ExprId, span: lang_source.Span) {
    if (ast_id.expr_is_nil(target)) { ret; }
    if (sc.walk.in_deferred_arm)    { ret; }

    if (!intrinsic.is_error_call(sc.view.a, sc.view.source, target)) { ret; }
    val res_msg: res[str, comptime.EvalFail] = comptime.error_message[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, target, ?sc.s.interner);
    if (sel res_msg.err) {
        val f: comptime.EvalFail = res_msg.err;
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?sc.status, f.message); }
        or                                         { sema_context.report(sc, f.diag, span, f.message); }
        ret;
    }
    sema_context.report(sc, diagnostic_kind.COMPTIME_USER_ERROR, span, res_msg.ok);
}

fun infer_stmt_comptime_each(sc: *sema_context.SemaContext, sid: ast_id.StmtId, ce: *ast_stmt.StmtComptimeEach, span: lang_source.Span, fn_ret: type.TypeId) err[fail.Fail] {
    ret walk_stmt_comptime_each(sc, sid, ce, span, infer_each_body, (?fn_ret)::ptr);
}

# one iteration of the `$each` at `sid`, typed in a frame of its own under the walk's
rec EachIteration {
    sid:   ast_id.StmtId;
    index: u32;
    visit: sema_context.StmtListVisitor;
    data:  ptr;
}

fun each_iteration_visit(sc: *sema_context.SemaContext, it: EachIteration, start: u32, len: u32, pack: bool) err[fail.Fail] {
    if (sc.typing.insts == nil) { ret it.visit(it.data, sc, start, len); }
    val made: res[u32, fail.Fail] = sema_instance.iteration_add(?sc.typing.insts.set, sc.instance.frame, it.sid, it.index);
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    val saved_frame: u32               = sc.instance.frame;
    val saved_quiet: bool              = sc.instance.quiet;
    val outer:       sema_context.Walk = sema_context.walk_open(sc);
    sc.instance.frame = made.ok;
    # an `$each` over a pack is the one body a pack's template cannot type, so its instance
    # reports what it finds there, until the module has an error to show
    if (pack && sc.instance.quiet) {
        if (sel sc.status.kind.accepted) {
            sc.instance.quiet = false;
            sc.walk.silent    = false;
        }
    }
    val r: err[fail.Fail] = it.visit(it.data, sc, start, len);
    sc.instance.frame = saved_frame;
    sc.instance.quiet = saved_quiet;
    sema_context.walk_close(sc, outer);
    ret r;
}

fun infer_each_body(data: ptr, sc: *sema_context.SemaContext, start: u32, count: u32) err[fail.Fail] {
    ret infer_stmt_list(sc, start, count, @(data::*type.TypeId));
}

fun walk_stmt_comptime_each(sc: *sema_context.SemaContext, sid: ast_id.StmtId, ce: *ast_stmt.StmtComptimeEach, span: lang_source.Span, visit: sema_context.StmtListVisitor, data: ptr) err[fail.Fail] {
    var it:         EachIteration = EachIteration{sid: sid, index: 0, visit: visit, data: data};
    val over_cases: bool          = intrinsic.is_cases_call(sc.view.a, sc.view.source, ce.seq);
    if (!intrinsic.is_fields_call(sc.view.a, sc.view.source, ce.seq) && !over_cases) {
        val seq_ty:  type.TypeId     = infer.infer_expr(sc, ce.seq);
        val opt_seq: opt[*type.Type] = type.get(?sc.s.types, seq_ty);
        if (sel opt_seq.some) {
            if (opt_seq.some.kind == type.TYPE_PACK) {
                ret infer_pack_each(sc, ce, it);
            }
        }
        if (sel opt_seq.some) {
            if (opt_seq.some.kind == type.TYPE_ARRAY) {
                ret infer_const_array_each(sc, ce, span, it, seq_ty);
            }
        }
        if (!type.is_error(seq_ty)) {
            sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` sequence must be `$fields(T)`, `$cases(T)`, a variadic pack, or a constant array `val`");
        }
        ret err[fail.Fail].ok{};
    }

    var owner: type.TypeId = type.TYPE_ERROR;
    if (over_cases)                             { owner = infer.case_seq_owner(sc, ce.seq, span); }
    or                                          { owner = infer.field_seq_owner(sc, ce.seq, span); }
    if (type.is_error(owner))                   { ret err[fail.Fail].ok{}; }
    if (infer.type_is_generic_param(sc, owner)) { ret err[fail.Fail].ok{}; }

    val res_name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    val n: u32 = type.field_count(?sc.s.types, owner);
    var i: u32 = 0;
    for (i < n) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(sc.view.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark: comptime.FrameMark = mark_r.ok;
        var desc: comptime.CTValue   = comptime.field_value(owner::u32, i);
        if (over_cases) { desc = comptime.case_value(owner::u32, i); }
        val res_bind: err[fail.Fail] = comptime.bind(sc.view.ctx, fname, desc);
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }
        it.index = i;
        val res_body:  err[fail.Fail] = each_iteration_visit(sc, it, ce.body_start, ce.body_len, false);
        val res_close: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# an `$each` over a pack, typed once per element where an instance binds the pack; a
# template binds none and leaves the body to its instances
fun infer_pack_each(sc: *sema_context.SemaContext, ce: *ast_stmt.StmtComptimeEach, it: EachIteration) err[fail.Fail] {
    if (!sema_context.walk_binds_pack(sc)) { ret err[fail.Fail].ok{}; }
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId  = res_name.ok;
    var at:    EachIteration = it;
    var i:     u32           = 0;
    for (i < sc.instance.pack_len) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(sc.view.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark:     comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail]     = comptime.bind(sc.view.ctx, fname, comptime.pack_elem_value(i, sc.instance.pack_types[i]::u32));
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }
        at.index = i;
        val res_body:  err[fail.Fail] = each_iteration_visit(sc, at, ce.body_start, ce.body_len, true);
        val res_close: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_const_array_each(sc: *sema_context.SemaContext, ce: *ast_stmt.StmtComptimeEach, span: lang_source.Span, it: EachIteration, seq_ty: type.TypeId) err[fail.Fail] {
    val opt_arr: opt[*type.Type] = type.get(?sc.s.types, seq_ty);
    if (!sel opt_arr.some) { ret err[fail.Fail].ok{}; }
    val arr:     *type.Type  = opt_arr.some;
    val elem_ty: type.TypeId = arr.data.array.base;
    val count:   u32         = arr.data.array.count;

    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, ce.seq);
    if (!sel opt_sym.some) {
        sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind == resolve.SYM_VAR) {
        sema_context.report(sc, diagnostic_kind.EACH_MUTABLE, span, "a `$each` array sequence must be an immutable `val`; a `var` is not a compile-time-constant sequence");
        ret err[fail.Fail].ok{};
    }
    if (sym.kind != resolve.SYM_VAL && sym.kind != resolve.SYM_IMPORTED) {
        sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }

    val opt_elem: opt[*type.Type] = type.get(?sc.s.types, elem_ty);
    if (sel opt_elem.some) {
        if (opt_elem.some.kind == type.TYPE_ARRAY) {
            sema_context.report(sc, diagnostic_kind.EACH_ELEMENT_TYPE, span, "a `$each` array element type must be a scalar or record; nested-array elements are not supported");
            ret err[fail.Fail].ok{};
        }
    }

    if (module.same(sym.origin, sc.view.own_module)) {
        ret infer_const_array_each_local(sc, ce, span, it, sym, elem_ty, count);
    }
    ret infer_const_array_each_imported(sc, ce, span, it, sym, elem_ty, count);
}

fun infer_const_array_each_local(sc: *sema_context.SemaContext, ce: *ast_stmt.StmtComptimeEach, span: lang_source.Span,
    it: EachIteration, sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) err[fail.Fail] {
    var at:       EachIteration              = it;
    val opt_info: opt[comptime.ArrayLitInfo] = comptime.decl_array_lit(sc.view.a, sym.decl);
    if (!sel opt_info.some) {
        sema_context.report(sc, diagnostic_kind.EACH_INITIALIZER, span, "a `$each` array sequence must be initialized with an array literal");
        ret err[fail.Fail].ok{};
    }
    val info: comptime.ArrayLitInfo = opt_info.some;
    if (info.elems_len != count) {
        sema_context.report(sc, diagnostic_kind.EACH_INITIALIZER, span, "a `$each` array must be fully initialized: every element needs an initializer");
        ret err[fail.Fail].ok{};
    }

    val res_name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    var i: u32 = 0;
    for (i < count) {
        if ((info.elems_start + i)::usize >= sc.view.a.expr_id_len) {
            ret err[fail.Fail].err{fail.message("sema: `$each` array element index out of range")};
        }
        val elem_eid: ast_id.ExprId                      = sc.view.a.expr_ids[info.elems_start + i];
        val mark_r:   res[comptime.FrameMark, fail.Fail] = comptime.frame_open(sc.view.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark:     comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail]     = comptime.bind(sc.view.ctx, fname, comptime.const_elem_value(elem_eid::u32, elem_ty::u32));
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }
        at.index = i;
        val res_body:  err[fail.Fail] = each_iteration_visit(sc, at, ce.body_start, ce.body_len, false);
        val res_close: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun infer_const_array_each_imported(sc: *sema_context.SemaContext, ce: *ast_stmt.StmtComptimeEach, span: lang_source.Span,
    it: EachIteration, sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) err[fail.Fail] {
    var at:       EachIteration                              = it;
    val acquired: res[sema_product.DefinedSymbol, fail.Fail] = sema_context.imported_definition(sc, sym, sema_product.DEFINITION_TYPED);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val current: sema_product.DefinedSymbol = acquired.ok;
    val oa:      *ast.Ast                   = current.definition.parsed.a;
    val orr:     *resolve.ResolveResult     = current.definition.rr;
    var foreign: comptime.ComptimeCtx       = comptime.reader_init(current.definition.ctx);
    fin { comptime.dnit(?foreign); }
    val octx: *comptime.ComptimeCtx    = ?foreign;
    val osr:  *sema_product.SemaResult = current.definition.sr;

    val od_opt: opt[*ast_decl.Decl] = ast.get_decl(oa, current.symbol.decl);
    if (!sel od_opt.some) {
        sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }
    if (od_opt.some.kind == ast_decl.DECL_KIND_VAR) {
        sema_context.report(sc, diagnostic_kind.EACH_MUTABLE, span, "a `$each` array sequence must be an immutable `val`; a `var` is not a compile-time-constant sequence");
        ret err[fail.Fail].ok{};
    }
    if (od_opt.some.kind != ast_decl.DECL_KIND_VAL) {
        sema_context.report(sc, diagnostic_kind.EACH_SEQUENCE, span, "a `$each` array sequence must name an array `val`");
        ret err[fail.Fail].ok{};
    }

    val opt_info: opt[comptime.ArrayLitInfo] = comptime.decl_array_lit(oa, current.symbol.decl);
    if (!sel opt_info.some) {
        sema_context.report(sc, diagnostic_kind.EACH_INITIALIZER, span, "a `$each` array sequence must be initialized with an array literal");
        ret err[fail.Fail].ok{};
    }
    val info: comptime.ArrayLitInfo = opt_info.some;
    if (info.elems_len != count) {
        sema_context.report(sc, diagnostic_kind.EACH_INITIALIZER, span, "a `$each` array must be fully initialized: every element needs an initializer");
        ret err[fail.Fail].ok{};
    }

    val res_name: res[intern.StrId, A.Error] = intern.range_add(?sc.s.interner, sc.view.source, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    val caps_r: res[comptime.PhaseCapabilities[sema_context.SemaContext], fail.Fail] = semantic_type_caps();
    if (sel caps_r.err) { ret err[fail.Fail].err{caps_r.err}; }
    val source_r: res[str, fail.Fail] = source_text_of(sc.s, oa);
    if (sel source_r.err) { ret err[fail.Fail].err{source_r.err}; }
    var view: sema_context.ModuleView = sema_context.ModuleView{};
    view.a                = oa;
    view.rr               = orr;
    view.ctx              = octx;
    view.own_module       = sym.origin;
    view.source           = source_r.ok;
    view.expr_type        = osr.expr_type;
    view.type_resolved_ty = osr.type_resolved_ty;
    view.decl_type        = osr.decl_type;
    # its expressions are the defining module's, so it records nothing in this module's set
    var typing: sema_context.Typing = sc.typing;
    typing.caps          = caps_r.ok;
    typing.insts         = nil;
    typing.collect_insts = false;
    var instance: sema_context.Instance = sema_context.instance_none();
    instance.depth      = sc.instance.depth;
    instance.parent     = sc.instance.parent;
    instance.pack_types = sc.instance.pack_types;
    instance.pack_len   = sc.instance.pack_len;
    instance.quiet      = sc.instance.quiet;
    var tsc: sema_context.SemaContext = sema_context.init(sc.s, sc.diags, typing, view, instance);
    fin { fail.merge(?sc.status, tsc.status); }
    tsc.walk.silent = sc.walk.silent;

    var i:   u32            = 0;
    var out: err[fail.Fail] = err[fail.Fail].ok{};
    for (i < count) {
        if ((info.elems_start + i)::usize >= oa.expr_id_len) {
            out = err[fail.Fail].err{fail.message("sema: `$each` array element index out of range")};
            brk;
        }
        val elem_eid: ast_id.ExprId                            = oa.expr_ids[info.elems_start + i];
        val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](octx, ?tsc, tsc.typing.caps, oa, tsc.view.source, elem_eid, ?sc.s.interner);
        sema_context.record_eval_result(?tsc, res_eval);
        if (sel res_eval.err) {
            out = err[fail.Fail].err{fail.message(res_eval.err.message)};
            brk;
        }
        var ev: comptime.CTValue = res_eval.ok;
        each_retype_elem_value(sc.s, ?ev, elem_ty);

        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(sc.view.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark:     comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail]     = comptime.bind(sc.view.ctx, fname, ev);
        if (sel res_bind.err) {
            val res_close_err: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
            if (sel res_close_err.err) {
                out = err[fail.Fail].err{res_close_err.err};
                brk;
            }
            out = err[fail.Fail].err{res_bind.err};
            brk;
        }
        at.index = i;
        val res_body:  err[fail.Fail] = each_iteration_visit(sc, at, ce.body_start, ce.body_len, false);
        val res_close: err[fail.Fail] = comptime.frame_close(sc.view.ctx, mark);
        if (sel res_body.err) {
            out = err[fail.Fail].err{res_body.err};
            brk;
        }
        if (sel res_close.err) {
            out = err[fail.Fail].err{res_close.err};
            brk;
        }
        i = i + 1;
    }

    ret out;
}

fun each_retype_elem_value(s: *session.Session, ev: *comptime.CTValue, elem_ty: type.TypeId) {
    val opt_et: opt[*type.Type] = type.get(?s.types, type.strip_secret(?s.types, elem_ty));
    if (!sel opt_et.some) { ret; }
    val pd: type.PrimDesc = type.prim_desc(opt_et.some.kind);
    if (ev.kind == comptime.CT_KIND_INT && pd.class == type.PRIM_CLASS_INT) {
        ev.int_unsigned = !pd.signed;
        ev.int_width    = pd.bits::u8;
    }
    if (ev.kind == comptime.CT_KIND_FLOAT && pd.class == type.PRIM_CLASS_FLOAT) {
        ev.float_width = pd.bits::float.FloatWidth;
    }
}

fun infer_stmt_list(sc: *sema_context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val sid:      ast_id.StmtId  = sc.view.a.stmt_ids[start + i];
        val res_stmt: err[fail.Fail] = infer_stmt(sc, sid, fn_ret);
        if (sel res_stmt.err) { ret res_stmt; }
        i = i + 1;
        # an exiting chain guards the rest of the block, so the rest is walked inside its frame
        var rest_guard: sema_context.Guard;
        if (guard.open_exit_chain(sc, sid, ?rest_guard)) {
            val res_rest: err[fail.Fail] = infer_stmt_list(sc, start + i, len - i, fn_ret);
            guard.close(sc, ?rest_guard);
            ret res_rest;
        }
    }
    ret err[fail.Fail].ok{};
}

fun gate_probe_ident_is_comptime_param(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
    if (!sel opt_sym.some) { ret false; }
    val sym: *resolve.Symbol = opt_sym.some;
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun gate_probe_is_field_type_operand(sc: *sema_context.SemaContext, eid: ast_id.ExprId) bool {
    ret infer.is_field_type_operand(sc, eid);
}

fun sema_gate_probes() comptime_gate.GateProbes[sema_context.SemaContext] {
    ret comptime_gate.gate_probes[sema_context.SemaContext](
        gate_probe_ident_is_comptime_param, nil, nil, gate_probe_is_field_type_operand, sema_context.comptime_expression);
}

fun gate_chain_depends(sc: *sema_context.SemaContext, probe: comptime_gate.GateProbe,
    start: u32, len: u32) res[bool, fail.Fail] {
    ret comptime_gate.gate_chain_depends_on[sema_context.SemaContext](sc.view.a, sc.view.source, sc, sema_gate_probes(),
        probe, start, len);
}

fun infer_stmt_comptime_if(sc: *sema_context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) err[fail.Fail] {
    val param_gated_r: res[bool, fail.Fail] = gate_chain_depends(sc, comptime_gate.GATE_PROBE_COMPTIME_PARAM, start, len);
    if (sel param_gated_r.err) { ret err[fail.Fail].err{param_gated_r.err}; }
    val param_gated:    bool                 = param_gated_r.ok;
    val has_type_cmp_r: res[bool, fail.Fail] = gate_chain_depends(sc, comptime_gate.GATE_PROBE_TYPE_COMPARISON, start, len);
    if (sel has_type_cmp_r.err) { ret err[fail.Fail].err{has_type_cmp_r.err}; }
    val has_type_cmp: bool = has_type_cmp_r.ok;

    if (has_type_cmp && !param_gated) {
        val pruned_r: res[u8, fail.Fail] = prune_type_comparison_chain(sc, start, len, fn_ret);
        if (sel pruned_r.err)              { ret err[fail.Fail].err{pruned_r.err}; }
        if (pruned_r.ok == PRUNE_SELECTED) { ret err[fail.Fail].ok{}; }
        # a gate reading a type no instantiation has pinned down yet is decided at the instantiation,
        # so no arm is selected and none is checked here
        if (pruned_r.ok == PRUNE_UNINSTANTIATED) { ret err[fail.Fail].ok{}; }
    }

    # a value instance binds the parameters the chain reads, so it selects the arm
    if ((param_gated || has_type_cmp) && !(param_gated && sema_context.walk_binds_values(sc))) {
        var chain_bad: bool = false;
        var i:         u32  = 0;
        for (i < len) {
            val arm: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[start + i];
            if (!ast_id.expr_is_nil(arm.cond)) {
                if (!gate_condition_check(sc, arm.cond)) { chain_bad = true; }
                val cg: err[fail.Fail] = check_comptime_gate(sc, arm.cond);
                if (sel cg.err) { ret cg; }
            }
            if (!chain_bad) {
                val outer: sema_context.Walk = sema_context.walk_open(sc);
                sc.walk.in_deferred_arm = true;
                val res_body: err[fail.Fail] = infer_comptime_arm(sc, arm, fn_ret);
                sema_context.walk_close(sc, outer);
                if (sel res_body.err) { ret res_body; }
            }
            i = i + 1;
        }
        ret err[fail.Fail].ok{};
    }

    var i: u32 = 0;
    for (i < len) {
        val br: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[start + i];

        if (!ast_id.expr_is_nil(br.cond)) {
            if (!gate_condition_check(sc, br.cond)) { ret err[fail.Fail].ok{}; }
        }

        val active_r: res[bool, fail.Fail] = stmt_comptime_branch_active(sc, br);
        if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
        if (active_r.ok) {
            ret infer_comptime_arm(sc, br, fn_ret);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a comptime arm is a chain arm: a condition that is exactly `sel P.c` guards `P.c` in its body
fun infer_comptime_arm(sc: *sema_context.SemaContext, br: *ast_decl.ComptimeBranch, fn_ret: type.TypeId) err[fail.Fail] {
    var arm_guard: sema_context.Guard;
    val opened:    bool           = guard.open_sel(sc, br.cond, ?arm_guard);
    val res_body:  err[fail.Fail] = infer_stmt_list(sc, br.body_start, br.body_len, fn_ret);
    if (opened) { guard.close(sc, ?arm_guard); }
    ret res_body;
}

fun stmt_comptime_branch_active(sc: *sema_context.SemaContext, br: *ast_decl.ComptimeBranch) res[bool, fail.Fail] {
    if (ast_id.expr_is_nil(br.cond)) { ret res[bool, fail.Fail].ok{true}; }
    val vr: res[comptime_gate.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, br.cond);
    if (sel vr.err) {
        ret res[bool, fail.Fail].err{vr.err};
    }
    val v: comptime_gate.GateVerdict = vr.ok;
    if (v.outcome == comptime_gate.GATE_FAILED && str_len(v.message) > 0) {
        val outer: sema_context.Walk = sema_context.walk_open(sc);
        sc.walk.in_comptime_gate = true;
        sema_context.report(sc, v.diag, v.span, v.message);
        sema_context.walk_close(sc, outer);
    }
    ret res[bool, fail.Fail].ok{gate_verdict_truth(v)};
}

val PRUNE_SELECTED:       u8 = 0;
val PRUNE_UNDECIDABLE:    u8 = 1;
val PRUNE_UNINSTANTIATED: u8 = 2;

# walks a `$type_of`-gated chain and type-checks only the arm this instantiation selects; an arm is
# never selected while an earlier gate is still undecided
fun prune_type_comparison_chain(sc: *sema_context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) res[u8, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val arm: *ast_decl.ComptimeBranch = ?sc.view.a.comptime_branches[start + i];
        if (ast_id.expr_is_nil(arm.cond)) {
            val res_body: err[fail.Fail] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (sel res_body.err) { ret res[u8, fail.Fail].err{res_body.err}; }
            ret res[u8, fail.Fail].ok{PRUNE_SELECTED};
        }

        if (!gate_condition_check(sc, arm.cond)) { ret res[u8, fail.Fail].ok{PRUNE_SELECTED}; }

        val vr: res[comptime_gate.GateVerdict, fail.Fail] = stmt_gate_verdict(sc, arm.cond);
        if (sel vr.err) {
            ret res[u8, fail.Fail].err{vr.err};
        }
        val v: comptime_gate.GateVerdict = vr.ok;
        if (v.outcome == comptime_gate.GATE_AWAITING_INSTANCE) { ret res[u8, fail.Fail].ok{PRUNE_UNINSTANTIATED}; }
        if (v.outcome != comptime_gate.GATE_ACTIVE && v.outcome != comptime_gate.GATE_INACTIVE) {
            ret res[u8, fail.Fail].ok{PRUNE_UNDECIDABLE};
        }
        if (gate_verdict_truth(v)) {
            val res_body: err[fail.Fail] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (sel res_body.err) { ret res[u8, fail.Fail].err{res_body.err}; }
            ret res[u8, fail.Fail].ok{PRUNE_SELECTED};
        }
        i = i + 1;
    }
    ret res[u8, fail.Fail].ok{PRUNE_SELECTED};
}

fun check_comptime_gate(sc: *sema_context.SemaContext, eid: ast_id.ExprId) err[fail.Fail] {
    if (ast_id.expr_is_nil(eid)) { ret err[fail.Fail].ok{}; }
    val matched_r: res[bool, fail.Fail] = comptime_gate.gate_walk[sema_context.SemaContext](sc.view.a, sc.view.source, sc, gate_operand_check, sema_context.comptime_expression, eid);
    if (sel matched_r.err) { ret err[fail.Fail].err{matched_r.err}; }
    ret err[fail.Fail].ok{};
}

fun gate_operand_check(sc: *sema_context.SemaContext, eid: ast_id.ExprId, e: *ast_expr.Expr) comptime_gate.GateNodeVerdict {
    val k: ast_expr.ExprKind = e.kind;

    if (k == ast_expr.EXPR_KIND_BINARY) {
        if (intrinsic.is_type_comparison_binary(sc.view.a, sc.view.source, ?e.data.binary,
            infer.is_field_type_operand(sc, e.data.binary.lhs),
            infer.is_field_type_operand(sc, e.data.binary.rhs))) {
            ret comptime_gate.GATE_NODE_PRUNE;
        }
        ret comptime_gate.GATE_NODE_NO;
    }
    if (k == ast_expr.EXPR_KIND_UNARY) {
        if (e.data.unary.op == ast_expr.UN_DEREF || e.data.unary.op == ast_expr.UN_ADDR) {
            sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant");
            ret comptime_gate.GATE_NODE_PRUNE;
        }
        ret comptime_gate.GATE_NODE_NO;
    }

    if (k == ast_expr.EXPR_KIND_CALL
        && (intrinsic.is_type_query_call(sc.view.a, sc.view.source, eid) || intrinsic.is_layout_intrinsic_call(sc.view.a, sc.view.source, eid))) {
        ret comptime_gate.GATE_NODE_PRUNE;
    }

    if (k == ast_expr.EXPR_KIND_INDEX) { ret comptime_gate.GATE_NODE_NO; }
    if (k == ast_expr.EXPR_KIND_CAST)  { ret comptime_gate.GATE_NODE_NO; }

    if (k == ast_expr.EXPR_KIND_LIT_INT || k == ast_expr.EXPR_KIND_LIT_FLOAT
        || k == ast_expr.EXPR_KIND_LIT_CHAR || k == ast_expr.EXPR_KIND_LIT_STR) {
        ret comptime_gate.GATE_NODE_PRUNE;
    }

    if (k == ast_expr.EXPR_KIND_COMPTIME_IDENT) {
        val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
        sema_context.record_eval_result(sc, res_eval);
        if (sel res_eval.err) {
            sema_context.report(sc, res_eval.err.diag, e.span, res_eval.err.message);
        }
        ret comptime_gate.GATE_NODE_PRUNE;
    }

    if (k == ast_expr.EXPR_KIND_IDENT) {
        val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
        if (!sel opt_sym.some) { ret comptime_gate.GATE_NODE_PRUNE; }
        val sym: *resolve.Symbol = opt_sym.some;
        if (resolve.symbol_is_runtime(sym)) {
            if (sym.kind == resolve.SYM_PARAM) {
                check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime parameter '", sym.name, "'", "comptime `$if` gate cannot reference a runtime parameter");
                ret comptime_gate.GATE_NODE_PRUNE;
            }
            check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
            ret comptime_gate.GATE_NODE_PRUNE;
        }
        if (sym.kind == resolve.SYM_PARAM) { ret comptime_gate.GATE_NODE_PRUNE; }
        if (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_IMPORTED) {
            val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
            sema_context.record_eval_result(sc, res_eval);
            if (sel res_eval.err && !check.imported_module_const_sym(sc, sym)) {
                check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
            }
            ret comptime_gate.GATE_NODE_PRUNE;
        }
        check.report_named(sc, diagnostic_kind.GATE_RUNTIME_VALUE, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
        ret comptime_gate.GATE_NODE_PRUNE;
    }

    if (k == ast_expr.EXPR_KIND_MEMBER) {
        val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[sema_context.SemaContext](sc.view.ctx, sc, sc.typing.caps, sc.view.a, sc.view.source, eid, ?sc.s.interner);
        sema_context.record_eval_result(sc, res_eval);
        if (sel res_eval.err) {
            val opt_sym: opt[*resolve.Symbol] = sema_context.symbol_for_expr(sc, eid);
            if (sel opt_sym.some) {
                if (!check.imported_module_const_sym(sc, opt_sym.some)) {
                    sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant");
                }
            }
            if (sel opt_sym.none) { sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant"); }
        }
        ret comptime_gate.GATE_NODE_PRUNE;
    }

    sema_context.report(sc, diagnostic_kind.GATE_NOT_CONSTANT, e.span, "comptime `$if` gate is not a compile-time constant");
    ret comptime_gate.GATE_NODE_PRUNE;
}

fun infer_local_decl(sc: *sema_context.SemaContext, did: ast_id.DeclId) err[fail.Fail] {
    if (ast_id.decl_is_nil(did)) { ret err[fail.Fail].ok{}; }
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.view.a, did);
    if (!sel opt_decl.some) { ret err[fail.Fail].err{fail.message("DeclId out of range")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind > ast_decl.DECL_KIND_TAG && d.kind != ast_decl.DECL_KIND_ERROR) {
        val failure: fail.Fail = resolve.unknown_catalog(sc.s, "DeclKind", d.kind::u32);
        fail.internal(?sc.status, fail.describe(failure));
        ret err[fail.Fail].err{failure};
    }
    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) {
        ret err[fail.Fail].ok{};
    }

    val ty: type.TypeId = infer.infer_decl(sc, did);
    sema_context.decl_type_set(sc, did, ty);

    if (type.is_case_selector(?sc.s.types, ty)) {
        sema_context.report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, d.span, "a case selector is not a value; it cannot be stored, assigned, or passed as a value");
    }

    if (type_carries_handle(sc, ty) && !annotation_refuses_indirection(sc, d.data.bind.ty, ty)) {
        sema_context.report(sc, diagnostic_kind.HANDLE_STORAGE, d.span,
            "a handle cannot be a local binding: a local is storage the program owns, and a handle's representation is not the program's, so there is nothing that may be written into it. hand the handle straight to the operation that consumes it instead of naming it first");
    }

    if (type_carries_abi_type(sc, ty)) {
        sema_context.report(sc, diagnostic_kind.ABI_TYPE_OPAQUE, d.span, abitype.exclusion_message());
    }

    if (!ast_id.expr_is_nil(d.data.bind.init)) {
        val actual: type.TypeId = infer.infer_expr(sc, d.data.bind.init);
        if (type.is_case_selector(?sc.s.types, actual)) {
            sema_context.report(sc, diagnostic_kind.TAG_SELECTOR_VALUE, d.span, "a case selector is not a value");
            ret err[fail.Fail].ok{};
        }
        if (!ast_id.type_is_nil(d.data.bind.ty) && !type.is_nil(ty)
            && !type.is_error(ty) && !type.is_error(actual)) {
            check_binding(sc, ty, d.data.bind.init, actual, d.span);
        }
    }
    ret err[fail.Fail].ok{};
}

fun check_binding(sc: *sema_context.SemaContext, expected: type.TypeId, eid: ast_id.ExprId, actual: type.TypeId, span: lang_source.Span) {
    check.check_coercible(sc, expected, eid, actual, span);
}

fun check_return_stmt(sc: *sema_context.SemaContext, ret_type: type.TypeId, value: ast_id.ExprId, span: lang_source.Span) {
    if (ast_id.expr_is_nil(value)) {
        check.check_return(sc, ret_type, type.TYPE_NIL, span);
        ret;
    }
    val value_ty: type.TypeId = infer.infer_expr(sc, value);
    infer.refuse_confined_flow(sc, value, "returned");
    if (type.is_nil(ret_type) || type.is_error(ret_type)
        || type.is_error(value_ty) || type.is_nil(value_ty)) {
        check.check_return(sc, ret_type, value_ty, span);
        ret;
    }
    check.check_coercible(sc, ret_type, value, value_ty, span);
}

fun comptime_branch_active(sc: *sema_context.SemaContext, br: *ast_decl.ComptimeBranch) res[bool, fail.Fail] {
    if (ast_id.expr_is_nil(br.cond)) { ret res[bool, fail.Fail].ok{true}; }
    ret decl_gate_is_active(sc, br.cond);
}

fun build_result(sc: *sema_context.SemaContext) res[sema_product.SemaResult, fail.Fail] {
    if (sel sc.status.kind.internal) {
        ret res[sema_product.SemaResult, fail.Fail].err{fail.phase_failure(sc.status)};
    }
    var graph: fields.Graph = fields.init(sc.s.alloc);
    if (sel sc.status.kind.accepted) {
        var roots: [3]fields.Roots;
        roots[0] = fields.Roots{data: sc.view.expr_type, len: sc.view.a.expr_len};
        roots[1] = fields.Roots{data: sc.view.type_resolved_ty, len: sc.view.a.type_len};
        roots[2] = fields.Roots{data: sc.view.decl_type, len: sc.view.a.decl_len};
        val captured: res[fields.Graph, fail.Fail] = fields.capture[sema_context.SemaContext](sc.s, sc.s.alloc,
            ?roots[0], 3, fields.MATERIALIZED, sc.view.ctx.env.target_defs, sc, infer.prepare_nominal_recipe);
        if (sel captured.err) { ret res[sema_product.SemaResult, fail.Fail].err{captured.err}; }
        graph = captured.ok;
    }
    ret finish_result(sc, graph);
}

fun finish_result(sc: *sema_context.SemaContext, graph: fields.Graph) res[sema_product.SemaResult, fail.Fail] {
    if (sel sc.status.kind.internal) {
        var owned: fields.Graph = graph;
        fields.dnit(?owned);
        ret res[sema_product.SemaResult, fail.Fail].err{fail.phase_failure(sc.status)};
    }
    var out: sema_product.SemaResult;
    out.field_graph      = graph;
    out.status           = sc.status;
    out.alloc            = sc.s.alloc;
    out.expr_type        = sc.view.expr_type;
    out.type_resolved_ty = sc.view.type_resolved_ty;
    out.decl_type        = sc.view.decl_type;
    out.expr_count       = sc.view.a.expr_len::u32;
    out.type_count       = sc.view.a.type_len::u32;
    out.decl_count       = sc.view.a.decl_len::u32;
    out.embed_paths      = sc.view.embed_paths;
    out.embed_path_count = sc.view.embed_path_len;
    out.constants        = comptime.publish(sc.view.ctx);
    out.instances        = sc.typing.insts.set;
    # the result owns the set and the analysis now
    sc.typing.insts.set.alloc = nil;
    out.growth.alloc          = nil;
    if (sc.typing.growth != nil) {
        out.growth             = @sc.typing.growth;
        sc.typing.growth.alloc = nil;
    }

    sc.view.expr_type        = nil;
    sc.view.type_resolved_ty = nil;
    sc.view.decl_type        = nil;
    out.embed_path_cap       = sc.view.embed_path_cap;
    sc.view.embed_paths      = nil;
    sc.view.embed_path_cap   = 0;
    sc.view.embed_path_len   = 0;

    ret res[sema_product.SemaResult, fail.Fail].ok{out};
}

use mach.lang.fe.ast.interpretation;
#[testing]
use fe_load: mach.lang.fe.load;
use mach.lang.module;
#[testing]
use mach.lang.source.provider.resident;
use std.allocator.page;
use std.types.string.str_contains;

# one module checked by the front end alone: its text held in memory as the
# module `t.main`, loaded, resolved and typed in a fresh session whose store
# holds the diagnostics; it must not move once made
#[testing]
pub rec Checked {
    alloc:  A.Allocator;
    s:      session.Session;
    held:   resident.Resident;
    host:   fe_load.Fixture;
    loader: fe_load.Loader;
    mid:    session.ModuleId;
    rr:     resolve.ResolveResult;
    sr:     sema_product.SemaResult;
    view:   comptime.ComptimeCtx;
    # how far it was made: the session, then what reads the session
    opened:   bool;
    hosted:   bool;
    resolved: bool;
    typed:    bool;
    viewed:   bool;
}

#[testing]
fun checked_module(c: *Checked) *fe_load.Module {
    ret c.host.rows[module.index(c.mid)].load;
}

#[testing]
fun checked_definition(raw: ptr, origin: session.ModuleId, phase: sema_product.DefinitionPhase) res[sema_product.Definition, fail.Fail] {
    val c: *Checked = raw::*Checked;
    if (!module.same(origin, c.mid)) {
        ret res[sema_product.Definition, fail.Fail].err{fail.message("a checked module reads no other module's definitions")};
    }
    val row: fe_load.Row             = c.host.rows[module.index(c.mid)];
    var d:   sema_product.Definition = sema_product.Definition{
        parsed: resolve.ParsedDefinition{a: row.syntax, owner: resolve.type_owner(?c.s, c.mid, row.file), incarnation: row.syntax.incarnation},
        origin: origin, decorators: ?checked_module(c).ctx
    };
    if (phase >= sema_product.DEFINITION_RESOLVED) { d.rr = ?c.rr; }
    if (phase == sema_product.DEFINITION_TYPED) {
        d.sr = ?c.sr;
        if (c.viewed) { comptime.dnit(?c.view); }
        c.viewed = true;
        c.view   = comptime.stage_init(?checked_module(c).ctx, comptime.STAGE_LOWER, ?c.alloc);
        comptime.layer_set(?c.view, comptime.STAGE_RESOLVE, ?c.rr.constants);
        comptime.layer_set(?c.view, comptime.STAGE_SEMA, ?c.sr.constants);
        d.ctx = ?c.view;
    }
    ret res[sema_product.Definition, fail.Fail].ok{d};
}

# check `text` into `c`, released with checked_dnit also when this fails; a
# failure is the fixture's own, and the module's verdict is in the diagnostics
#[testing]
pub fun checked_init(c: *Checked, text: str) err[fail.Fail] {
    c.opened   = false;
    c.hosted   = false;
    c.resolved = false;
    c.typed    = false;
    c.viewed   = false;
    c.mid      = module.MODULE_NIL;
    page.make(?c.alloc);
    val made: res[session.Session, fail.Fail] = session.init(?c.alloc);
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    c.s      = made.ok;
    c.opened = true;
    val root: res[intern.StrId, A.Error] = intern.add(?c.s.interner, "t");
    if (sel root.err) { ret err[fail.Fail].err{fail.refused(root.err)}; }
    c.held   = resident.init(?c.alloc, ?c.s.interner, root.ok);
    c.host   = fe_load.fixture_init(?c.s, ?c.alloc, ?c.s.diags);
    c.loader = fe_load.init(?c.s, ?c.alloc);
    c.hosted = true;
    val set: err[fail.Fail] = resident.module_set(?c.held, "t.main", text);
    if (sel set.err) { ret set; }
    fe_load.bind(?c.loader, fe_load.fixture_host(?c.host), resident.provider_of(?c.held), ?c.s.diags);

    val name: res[intern.StrId, A.Error] = intern.add(?c.s.interner, "t.main");
    if (sel name.err) { ret err[fail.Fail].err{fail.refused(name.err)}; }
    val loaded: res[session.ModuleId, fail.Fail] = fe_load.module_load(?c.loader, name.ok);
    if (sel loaded.err) { ret err[fail.Fail].err{loaded.err}; }
    c.mid = loaded.ok;
    val row: fe_load.Row = c.host.rows[module.index(c.mid)];
    if (row.syntax == nil) { ret err[fail.Fail].err{fail.message("the checked module was not parsed")}; }
    val registered: err[fail.Fail] = session.register_module_ast(?c.s, c.mid, row.syntax);
    if (sel registered.err) { ret registered; }

    val m:     *fe_load.Module                       = row.load;
    var rdeps: resolve.ResolveDeps                   = resolve.ResolveDeps{entries: nil, count: 0, bindings: m.bindings.data, binding_count: m.bindings.len::u32};
    val rr:    res[resolve.ResolveResult, fail.Fail] = resolve.resolve(?c.s, row.syntax, ?rdeps, ?m.ctx, c.mid, ?c.s.diags);
    if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
    c.rr       = rr.ok;
    c.resolved = true;

    var sdeps: sema_product.SemaDeps = sema_product.SemaDeps{};
    sdeps.definitions = sema_product.reader_init(c::ptr, checked_definition, ?c.alloc);
    fin { sema_product.reader_dnit(?sdeps.definitions); }
    sdeps.entries = nil;
    sdeps.count   = 0;
    val sr: res[sema_product.SemaResult, fail.Fail] = sema(?c.s, row.syntax, ?c.rr, ?sdeps, ?m.ctx, c.mid, ?c.s.diags);
    if (sel sr.err) { ret err[fail.Fail].err{sr.err}; }
    c.sr    = sr.ok;
    c.typed = true;
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun checked_dnit(c: *Checked) {
    if (c.viewed)   { comptime.dnit(?c.view); }
    if (c.typed)    { sema_product.result_dnit(?c.sr); }
    if (c.resolved) { resolve.result_dnit(?c.rr); }
    if (c.hosted) {
        fe_load.dnit(?c.loader);
        fe_load.fixture_dnit(?c.host);
        resident.dnit(?c.held);
    }
    if (c.opened) { session.dnit(?c.s); }
}

# whether any diagnostic the check reported says `needle`
#[testing]
pub fun checked_says(c: *Checked, needle: str) bool {
    var i: usize = 0;
    for (i < diagnostic.len(?c.s.diags)) {
        val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?c.s.diags, i);
        if (sel d.some) {
            if (str_contains(d.some.message, needle)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

test checked__a_well_typed_module_reports_nothing {
    var c:    Checked;
    val made: err[fail.Fail] = checked_init(?c, "fun twice(x: i32) i32 { ret x + x; }\n");
    fin { checked_dnit(?c); }
    if (sel made.err)                    { ret 1; }
    if (diagnostic.len(?c.s.diags) != 0) { ret 2; }
    ret 0;
}

test checked__a_narrowing_return_is_rejected {
    var c:    Checked;
    val made: err[fail.Fail] = checked_init(?c, "fun narrow(x: i64) i32 { ret x; }\n");
    fin { checked_dnit(?c); }
    if (sel made.err)                       { ret 1; }
    if (!checked_says(?c, "type mismatch")) { ret 2; }
    ret 0;
}

test unknown_kind__never_becomes_an_error_type_without_failure {
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var s: session.Session = session.Session{};
    s.alloc    = ?alloc;
    s.interner = intern.init(?alloc);
    fin { intern.dnit(?s.interner); }
    var ex:     ast_expr.Expr         = ast_expr.Expr{kind: 200};
    var de:     ast_decl.Decl         = ast_decl.Decl{kind: 200};
    var ty:     ast_type.Type         = ast_type.Type{kind: 200};
    var st:     ast_stmt.Stmt         = ast_stmt.Stmt{kind: 200};
    var choice: interpretation.Choice = interpretation.PARSED;
    var rr:     resolve.ResolveResult = resolve.ResolveResult{expr_choices: ?choice, expr_choices_count: 1};
    var a:      ast.Ast               = ast.Ast{exprs: ?ex, expr_len: 1, decls: ?de, decl_len: 1,
        types: ?ty, type_len: 1, stmts: ?st, stmt_len: 1};
    var sc:    sema_context.SemaContext = sema_context.init(?s, nil, sema_context.Typing{}, sema_context.ModuleView{a: ?a, rr: ?rr}, sema_context.instance_none());
    val names: [7]str                   = [7]str{"ExprKind", "BinOp", "UnOp", "DeclKind", "AstTypeKind", "StmtKind", "DeclKind"};
    var i:     usize                    = 0;
    for (i < 7) {
        sc.status = fail.accepted();
        var result: type.TypeId = type.TYPE_ERROR;
        if (i < 3) {
            if (i == 1) {
                ex.kind           = ast_expr.EXPR_KIND_BINARY;
                ex.data.binary.op = 200;
            }
            if (i == 2) {
                ex.kind          = ast_expr.EXPR_KIND_UNARY;
                ex.data.unary.op = 200;
            }
            result = infer.infer_expr(?sc, ast_id.expr(0));
        }
        or (i == 3) { result = infer.infer_decl(?sc, ast_id.decl(0)); }
        or (i == 4) { result = infer.resolve_type_ref(?sc, ast_id.type(0)); }
        or {
            if (i == 6) {
                st.kind           = ast_stmt.STMT_KIND_DECL;
                st.data.decl.decl = ast_id.decl(0);
            }
            val infer_stmt_2: err[fail.Fail] = infer_stmt(?sc, ast_id.stmt(0), type.TYPE_NIL);
            if (sel infer_stmt_2.ok) { ret 2; }
        }
        if (!type.is_error(result))                                                                                    { ret 3; }
        if (!sel sc.status.kind.internal)                                                                              { ret 3; }
        if (sc.status.rejections != 0)                                                                                 { ret 3; }
        if (!str_contains(fail.status_text(sc.status), names[i]) || !str_contains(fail.status_text(sc.status), "200")) { ret 4; }
        i = i + 1;
    }
    sc.status = fail.accepted();
    ex.kind   = ast_expr.EXPR_KIND_ERROR;
    de.kind   = ast_decl.DECL_KIND_USE;
    ty.kind   = ast_type.TYPE_KIND_ERROR;
    st.kind   = ast_stmt.STMT_KIND_ASM;
    if (!type.is_error(infer.infer_expr(?sc, ast_id.expr(0))) || !type.is_nil(infer.infer_decl(?sc, ast_id.decl(0)))
        || !type.is_error(infer.resolve_type_ref(?sc, ast_id.type(0)))) { ret 5; }
    val inferred_stmt: err[fail.Fail] = infer_stmt(?sc, ast_id.stmt(0), type.TYPE_NIL);
    if (sel inferred_stmt.err) { ret 5; }
    st.kind = ast_stmt.STMT_KIND_ERROR;
    val infer_stmt_3: err[fail.Fail] = infer_stmt(?sc, ast_id.stmt(0), type.TYPE_NIL);
    if (sel infer_stmt_3.err)         { ret 6; }
    if (!sel sc.status.kind.accepted) { ret 6; }
    ret 0;
}

test in_testing_region__half_open_bounds {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var regions: collections_vector.Vector[lang_source.Span] = collections_vector.init[lang_source.Span](?alloc);
    fin { collections_vector.dnit[lang_source.Span](?regions); }
    val first:  res[usize, A.Error] = collections_vector.push[lang_source.Span](?regions, lang_source.Span{offset: 10, len: 5});
    val second: res[usize, A.Error] = collections_vector.push[lang_source.Span](?regions, lang_source.Span{offset: 15, len: 3});
    val third:  res[usize, A.Error] = collections_vector.push[lang_source.Span](?regions, lang_source.Span{offset: 30, len: 1});
    if (sel first.err || sel second.err || sel third.err)                                                        { ret 2; }
    if (in_testing_region(?regions, 9) || !in_testing_region(?regions, 10) || !in_testing_region(?regions, 14))  { ret 3; }
    if (!in_testing_region(?regions, 15) || !in_testing_region(?regions, 17) || in_testing_region(?regions, 18)) { ret 4; }
    if (in_testing_region(?regions, 29) || !in_testing_region(?regions, 30) || in_testing_region(?regions, 31))  { ret 5; }
    var empty: collections_vector.Vector[lang_source.Span] = collections_vector.init[lang_source.Span](?alloc);
    if (in_testing_region(?empty, 0)) { ret 6; }
    ret 0;
}
