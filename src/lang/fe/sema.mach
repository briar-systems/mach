fun semantic_name_caps() R.Result[comptime.PhaseCapabilities[context.SemaContext], str] {
    ret comptime.semantic_name_capabilities[context.SemaContext](
        context.resolve_module_member_const,
        context.comptime_ident_is_runtime
    );
}

fun semantic_type_caps() R.Result[comptime.PhaseCapabilities[context.SemaContext], str] {
    ret comptime.semantic_type_capabilities[context.SemaContext](
        context.resolve_module_member_const,
        context.resolve_type_comparison_operand,
        context.resolve_field_member,
        infer.resolve_type_query,
        infer.resolve_layout_intrinsic,
        context.comptime_ident_is_runtime
    );
}

pub fun sema(
    s:          *session.Session,
    a:          *ast.Ast,
    rr:         *resolve.ResolveResult,
    deps:       *context.SemaDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId
) R.Result[context.SemaResult, fail.Fail] {
    var sc: context.SemaContext;
    var uni_reports: context.UniReports;
    uni_reports.len = 0;

    val res_init: R.Result[R.Void, str] = init_context(?sc, s, a, rr, deps, ctx, own_module);
    if (R.is_err[R.Void, str](res_init)) {
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_init)));
    }

    val res_embeds: R.Result[R.Void, str] = resolve_all_embeds(?sc);
    if (R.is_err[R.Void, str](res_embeds)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_embeds)));
    }

    val res_types: R.Result[R.Void, str] = resolve_all_types(?sc);
    if (R.is_err[R.Void, str](res_types)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_types)));
    }

    val res_decls: R.Result[R.Void, str] = infer_all_decls(?sc);
    if (R.is_err[R.Void, str](res_decls)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_decls)));
    }

    val res_occurs: R.Result[R.Void, str] = infer.check_occurs_all(?sc);
    if (R.is_err[R.Void, str](res_occurs)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_occurs)));
    }

    val res_uni_secrecy: R.Result[R.Void, str] = infer.check_uni_secrecy_all(?sc);
    if (R.is_err[R.Void, str](res_uni_secrecy)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_uni_secrecy)));
    }

    check_handle_fields_all(?sc);

    sc.has_secret  = context.recover[bool](?sc, generics.module_reaches_secret(s, sc.type_resolved_ty, a.type_len::u32), false);
    sc.uni_reports = ?uni_reports;
    check_annotation_uni_secrecy_all(?sc);

    val caps_r: R.Result[comptime.PhaseCapabilities[context.SemaContext], str] = semantic_type_caps();
    if (R.is_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)));
    }
    sc.caps = R.unwrap_ok[comptime.PhaseCapabilities[context.SemaContext], str](caps_r);
    val res_bodies: R.Result[R.Void, str] = infer_all_bodies(?sc);
    if (R.is_err[R.Void, str](res_bodies)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_bodies)));
    }

    val res_reval: R.Result[R.Void, str] = drain_revalidations(?sc);
    context.inst_worklist_dnit(?sc);
    if (R.is_err[R.Void, str](res_reval)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_reval)));
    }

    ret build_result(?sc);
}

pub fun resolve_gates(
    s:          *session.Session,
    a:          *ast.Ast,
    rr:         *resolve.ResolveResult,
    deps:       *context.SemaDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId
) R.Result[context.SemaResult, fail.Fail] {
    var sc: context.SemaContext;
    val ri: R.Result[R.Void, str] = init_context(?sc, s, a, rr, deps, ctx, own_module);
    if (R.is_err[R.Void, str](ri)) {
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](ri)));
    }

    sc.silent = true;
    val rt: R.Result[R.Void, str] = resolve_all_types(?sc);
    if (R.is_err[R.Void, str](rt)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rt)));
    }
    val rd: R.Result[R.Void, str] = infer_gate_support_decls(?sc);
    if (R.is_err[R.Void, str](rd)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rd)));
    }

    sc.silent = false;
    val rg: R.Result[R.Void, str] = resolve_module_gates(?sc);
    if (R.is_err[R.Void, str](rg)) {
        dnit_context(?sc);
        ret R.err[context.SemaResult, fail.Fail](fail.message(R.unwrap_err[R.Void, str](rg)));
    }
    ret build_result(?sc);
}

pub fun reinfer_pack_each_body(
    s:           *session.Session,
    a:           *ast.Ast,
    rr:          *resolve.ResolveResult,
    deps:        *context.SemaDeps,
    ctx:         *comptime.ComptimeCtx,
    own_module:  session.ModuleId,
    sema_result: *context.SemaResult,
    fn_ret:      type.TypeId,
    body_start:  u32,
    body_len:    u32,
    subst:       *type.TypeId,
    subst_len:   u32,
    insts:       *context.InstWorklist
) R.Result[R.Void, fail.Fail] {
    if (insts == nil) { ret R.err[R.Void, fail.Fail](fail.message("internal: #2177 deferred-body re-inference: no constant-time re-validation worklist supplied (invariant violated)")); }

    var sc: context.SemaContext;
    sc.status     = fail.accepted();
    sc.s          = s;
    sc.a          = a;
    sc.rr         = rr;
    sc.deps       = deps;
    sc.ctx        = ctx;
    val caps_r: R.Result[comptime.PhaseCapabilities[context.SemaContext], str] = semantic_type_caps();
    if (R.is_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)));
    }
    sc.caps       = R.unwrap_ok[comptime.PhaseCapabilities[context.SemaContext], str](caps_r);
    sc.own_module = own_module;
    sc.source     = source_text_of(s, a);

    sc.expr_type        = sema_result.expr_type;
    sc.type_resolved_ty = sema_result.type_resolved_ty;
    sc.decl_type        = sema_result.decl_type;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;

    sc.callee_eid       = id.EXPR_NIL;
    sc.in_comptime_gate = false;
    sc.in_deferred_arm  = false;
    sc.inst_site_set    = false;
    sc.in_fin           = false;
    sc.fin_loop_depth   = 0;
    sc.subst            = subst;
    sc.subst_len        = subst_len;
    sc.subst_fn         = generics.substitute;
    sc.insts            = insts;
    sc.collect_insts    = true;
    sc.inst_depth       = 0;
    sc.inst_parent      = context.INST_NONE;
    sc.silent           = false;
    sc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    sc.uni_reports      = ?insts.uni_reports;
    sc.has_secret       = worklist_reaches_secret(?sc, insts, a, sema_result);

    val res_body: R.Result[R.Void, str] = infer_stmt_list(?sc, body_start, body_len, fn_ret);
    if (R.is_err[R.Void, str](res_body)) { ret reinference_result(?sc, res_body); }

    ret reinference_result(?sc, drain_instances(?sc, deps));
}

pub fun reinfer_instance_body(
    s:           *session.Session,
    a:           *ast.Ast,
    rr:          *resolve.ResolveResult,
    deps:        *context.SemaDeps,
    ctx:         *comptime.ComptimeCtx,
    own_module:  session.ModuleId,
    sema_result: *context.SemaResult,
    fn_ret:      type.TypeId,
    body:        id.StmtId,
    subst:       *type.TypeId,
    subst_len:   u32
) R.Result[R.Void, fail.Fail] {
    var sc: context.SemaContext;
    sc.status = fail.accepted();
    sc.s          = s;
    sc.a          = a;
    sc.rr         = rr;
    sc.deps       = deps;
    sc.ctx        = ctx;
    val caps_r: R.Result[comptime.PhaseCapabilities[context.SemaContext], str] = semantic_type_caps();
    if (R.is_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)));
    }
    sc.caps       = R.unwrap_ok[comptime.PhaseCapabilities[context.SemaContext], str](caps_r);
    sc.own_module = own_module;
    sc.source     = source_text_of(s, a);

    sc.expr_type        = sema_result.expr_type;
    sc.type_resolved_ty = sema_result.type_resolved_ty;
    sc.decl_type        = sema_result.decl_type;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;

    sc.callee_eid       = id.EXPR_NIL;
    sc.in_comptime_gate = false;
    sc.in_deferred_arm  = false;
    sc.inst_site_set    = false;
    sc.in_fin           = false;
    sc.fin_loop_depth   = 0;
    sc.subst            = subst;
    sc.subst_len        = subst_len;
    sc.subst_fn         = generics.substitute;
    sc.insts            = nil;
    sc.collect_insts    = false;
    sc.inst_depth       = 0;
    sc.inst_parent      = context.INST_NONE;
    sc.silent           = true;
    sc.uni_check_fn     = nil;
    sc.uni_reports      = nil;
    sc.has_secret       = false;

    ret reinference_result(?sc, infer_stmt(?sc, body, fn_ret));
}

fun reinference_result(sc: *context.SemaContext, r: R.Result[R.Void, str]) R.Result[R.Void, fail.Fail] {
    if (sc.status.kind == fail.INTERNAL) { ret R.err[R.Void, fail.Fail](fail.phase_failure(sc.status)); }
    if (R.is_err[R.Void, str](r)) { ret fail.lift[R.Void](r); }
    if (sc.status.kind == fail.REJECTED) { ret R.err[R.Void, fail.Fail](fail.reported()); }
    ret R.ok_void[fail.Fail]();
}

fun copy_typeids(dst: *type.TypeId, src: *type.TypeId, n: usize) {
    var i: u32 = 0;
    for (i < n::u32) {
        dst[i] = src[i];
        i = i + 1;
    }
}

fun free_typeids(alloc: *A.Allocator, arr: *type.TypeId, n: usize) {
    if (arr != nil && n > 0) { A.deallocate[type.TypeId](alloc, arr, n); }
}

fun drain_revalidations(sc: *context.SemaContext) R.Result[R.Void, str] {
    if (sc.insts == nil)                       { ret R.ok_void[str](); }
    if (sc.insts.drained >= sc.insts.len)      { ret R.ok_void[str](); }

    val dr: R.Result[context.SemaDeps, str] = collect_module_deps(sc.s);
    if (R.is_err[context.SemaDeps, str](dr)) { ret R.err[R.Void, str](R.unwrap_err[context.SemaDeps, str](dr)); }
    var full_deps: context.SemaDeps = R.unwrap_ok[context.SemaDeps, str](dr);

    val r: R.Result[R.Void, str] = drain_instances(sc, ?full_deps);
    free_module_deps(sc.s, ?full_deps);
    ret r;
}

fun drain_instances(sc: *context.SemaContext, deps: *context.SemaDeps) R.Result[R.Void, str] {
    if (sc.insts == nil) { ret R.ok_void[str](); }

    for (sc.insts.drained < sc.insts.len) {
        val idx:     u32              = sc.insts.drained;
        val origin:  session.ModuleId = sc.insts.items[idx].origin;
        val decl:    id.DeclId        = sc.insts.items[idx].decl;
        val sig:     type.TypeId      = sc.insts.items[idx].sig;
        val args:    *type.TypeId     = sc.insts.items[idx].args;
        val arg_len: u32              = sc.insts.items[idx].arg_len;

        val depth:   u32              = sc.insts.items[idx].depth;
        val site:    token.Span        = sc.insts.items[idx].site;

        val r: R.Result[R.Void, str] = revalidate_one(sc, deps, origin, decl, args, arg_len, sig, idx, depth, site);
        if (R.is_err[R.Void, str](r)) { ret r; }
        sc.insts.drained = sc.insts.drained + 1;
    }
    ret R.ok_void[str]();
}

fun revalidate_one(sc: *context.SemaContext, deps: *context.SemaDeps, origin: session.ModuleId,
                   decl_id: id.DeclId, args: *type.TypeId, arg_len: u32, sig: type.TypeId,
                   index: u32, depth: u32, site: token.Span) R.Result[R.Void, str] {
    var oa:              *ast.Ast               = nil;
    var orr:             *resolve.ResolveResult = nil;
    var octx:            *comptime.ComptimeCtx  = nil;
    var o_decl_type:     *type.TypeId           = nil;
    var o_type_resolved: *type.TypeId           = nil;
    var o_expr_type:     *type.TypeId           = nil;

    if (origin == sc.own_module) {
        oa              = sc.a;
        orr             = sc.rr;
        octx            = sc.ctx;
        o_decl_type     = sc.decl_type;
        o_type_resolved = sc.type_resolved_ty;
        o_expr_type     = sc.expr_type;
    } or {
        oa = session.module_ast(sc.s, origin);
        if (oa == nil) { ret R.err[R.Void, str]("internal: #2157 CT re-validation: origin module AST unavailable (dependency-ordering invariant violated)"); }
        orr  = (session.module_resolve_ptr(sc.s, origin))::*resolve.ResolveResult;
        octx = (session.module_comptime_ptr(sc.s, origin))::*comptime.ComptimeCtx;
        val osp: ptr = session.module_sema_ptr(sc.s, origin);
        if (osp == nil || orr == nil || octx == nil) { ret R.err[R.Void, str]("internal: #2157 CT re-validation: origin module sema/resolve/comptime snapshot unavailable (dependency-ordering invariant violated)"); }
        val osr: *context.SemaResult = osp::*context.SemaResult;
        o_decl_type     = osr.decl_type;
        o_type_resolved = osr.type_resolved_ty;
        o_expr_type     = osr.expr_type;
    }
    if (oa == nil || o_decl_type == nil) { ret R.err[R.Void, str]("internal: #2157 CT re-validation: origin module decl table unavailable (dependency-ordering invariant violated)"); }

    val d_opt: O.Option[*decl.Decl] = ast.get_decl(oa, decl_id);
    if (O.is_none[*decl.Decl](d_opt)) { ret R.err[R.Void, str]("internal: #2157 CT re-validation: generic instance decl id out of range in origin AST (invariant violated)"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_FUN)    { ret R.err[R.Void, str]("internal: #2157 CT re-validation: generic instance decl is not a function (invariant violated)"); }
    if (d.data.fun_.body == id.STMT_NIL) { ret R.ok_void[str](); }

    var scratch_expr: *type.TypeId = nil;
    var scratch_decl: *type.TypeId = nil;
    if (oa.expr_len > 0) {
        val re: R.Result[*type.TypeId, str] = typeid_array_alloc(sc.s.alloc, oa.expr_len);
        if (R.is_err[*type.TypeId, str](re)) { ret R.err[R.Void, str](R.unwrap_err[*type.TypeId, str](re)); }
        scratch_expr = R.unwrap_ok[*type.TypeId, str](re);
        if (o_expr_type != nil) { copy_typeids(scratch_expr, o_expr_type, oa.expr_len); }
    }
    if (oa.decl_len > 0) {
        val rd: R.Result[*type.TypeId, str] = typeid_array_alloc(sc.s.alloc, oa.decl_len);
        if (R.is_err[*type.TypeId, str](rd)) {
            free_typeids(sc.s.alloc, scratch_expr, oa.expr_len);
            ret R.err[R.Void, str](R.unwrap_err[*type.TypeId, str](rd));
        }
        scratch_decl = R.unwrap_ok[*type.TypeId, str](rd);
        copy_typeids(scratch_decl, o_decl_type, oa.decl_len);
    }

    var tsc: context.SemaContext;
    tsc.status = fail.accepted();
    fin { fail.merge(?sc.status, tsc.status); }
    tsc.s                = sc.s;
    tsc.a                = oa;
    tsc.rr               = orr;
    tsc.deps             = deps;
    tsc.ctx              = octx;
    val caps_r: R.Result[comptime.PhaseCapabilities[context.SemaContext], str] = semantic_type_caps();
    if (R.is_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)) {
        free_typeids(sc.s.alloc, scratch_expr, oa.expr_len);
        free_typeids(sc.s.alloc, scratch_decl, oa.decl_len);
        ret R.err[R.Void, str](R.unwrap_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r));
    }
    tsc.caps             = R.unwrap_ok[comptime.PhaseCapabilities[context.SemaContext], str](caps_r);
    tsc.own_module       = origin;
    tsc.source           = source_text_of(sc.s, oa);
    tsc.expr_type        = scratch_expr;
    tsc.type_resolved_ty = o_type_resolved;
    tsc.type_resolved_memo = nil;
    tsc.layout_state       = nil;
    tsc.decl_type        = scratch_decl;
    tsc.callee_eid       = id.EXPR_NIL;
    tsc.in_comptime_gate = false;
    tsc.in_deferred_arm  = false;
    tsc.inst_site_set    = false;
    tsc.in_fin           = false;
    tsc.fin_loop_depth   = 0;
    tsc.subst            = args;
    tsc.subst_len        = arg_len;
    tsc.subst_fn         = generics.substitute;
    tsc.insts            = sc.insts;
    tsc.collect_insts    = true;
    tsc.inst_depth       = depth + 1;
    tsc.inst_parent      = index;
    tsc.silent           = false;
    tsc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    tsc.uni_reports      = sc.uni_reports;
    tsc.has_secret       = sc.has_secret;

    val ret_ty: type.TypeId = context.resolved_type_of(?tsc, d.data.fun_.return_type);

    var pi: u32 = 0;
    for (pi < d.data.fun_.params_len) {
        val ptn: *decl.TypedName = ?oa.typed_names[d.data.fun_.params_start + pi];
        generics.check_annotation_uni_secrecy(?tsc, ptn.ty);
        pi = pi + 1;
    }

    tsc.inst_site     = site;
    tsc.inst_site_set = true;
    val res: R.Result[R.Void, str] = infer_stmt(?tsc, d.data.fun_.body, ret_ty);
    tsc.inst_site_set = false;
    free_typeids(sc.s.alloc, scratch_expr, oa.expr_len);
    free_typeids(sc.s.alloc, scratch_decl, oa.decl_len);
    ret res;
}

pub fun collect_module_deps(s: *session.Session) R.Result[context.SemaDeps, str] {
    var deps: context.SemaDeps;
    deps.entries = nil;
    deps.count   = 0;

    val n: u32 = session.module_count(s);
    if (n == 0) { ret R.ok[context.SemaDeps, str](deps); }

    val res_arr: R.Result[*context.ModuleSema, str] = A.allocate[context.ModuleSema](s.alloc, n::usize);
    if (R.is_err[*context.ModuleSema, str](res_arr)) {
        ret R.err[context.SemaDeps, str](R.unwrap_err[*context.ModuleSema, str](res_arr));
    }
    val arr: *context.ModuleSema = R.unwrap_ok[*context.ModuleSema, str](res_arr);

    var i: u32 = 0;
    for (i < n) {
        var ms: context.ModuleSema;
        ms.path       = session.module_fqn(s, i::session.ModuleId);
        ms.module     = i::session.ModuleId;
        ms.decl_type  = nil;
        ms.decl_count = 0;
        ms.ctx        = (session.module_comptime_ptr(s, i::session.ModuleId))::*comptime.ComptimeCtx;

        val sp: ptr = session.module_sema_ptr(s, i::session.ModuleId);
        if (sp != nil) {
            val sr: *context.SemaResult = sp::*context.SemaResult;
            ms.decl_type  = sr.decl_type;
            ms.decl_count = sr.decl_count;
        }

        arr[i] = ms;
        i = i + 1;
    }

    deps.entries = arr;
    deps.count   = n;
    ret R.ok[context.SemaDeps, str](deps);
}

pub fun free_module_deps(s: *session.Session, deps: *context.SemaDeps) {
    if (deps.entries != nil && deps.count > 0) {
        A.deallocate[context.ModuleSema](s.alloc, deps.entries, deps.count::usize);
    }
    deps.entries = nil;
    deps.count   = 0;
}

pub fun dnit_result(r: *context.SemaResult) {
    if (r == nil) { ret; }
    if (r.expr_type != nil && r.expr_count > 0) {
        A.deallocate[type.TypeId](r.alloc, r.expr_type, r.expr_count::usize);
    }
    if (r.type_resolved_ty != nil && r.type_count > 0) {
        A.deallocate[type.TypeId](r.alloc, r.type_resolved_ty, r.type_count::usize);
    }
    if (r.decl_type != nil && r.decl_count > 0) {
        A.deallocate[type.TypeId](r.alloc, r.decl_type, r.decl_count::usize);
    }
    if (r.embed_paths != nil && r.embed_path_cap > 0) {
        A.deallocate[intern.StrId](r.alloc, r.embed_paths, r.embed_path_cap::usize);
    }
    r.embed_paths      = nil;
    r.embed_path_count = 0;
    r.embed_path_cap   = 0;
    r.expr_type        = nil;
    r.type_resolved_ty = nil;
    r.decl_type        = nil;
    r.expr_count       = 0;
    r.type_count       = 0;
    r.decl_count       = 0;
}

fun init_context(
    sc:         *context.SemaContext,
    s:          *session.Session,
    a:          *ast.Ast,
    rr:         *resolve.ResolveResult,
    deps:       *context.SemaDeps,
    ctx:        *comptime.ComptimeCtx,
    own_module: session.ModuleId
) R.Result[R.Void, str] {
    sc.status = fail.accepted();
    sc.s          = s;
    sc.a          = a;
    sc.rr         = rr;
    sc.deps       = deps;
    sc.ctx        = ctx;
    val caps_r: R.Result[comptime.PhaseCapabilities[context.SemaContext], str] = semantic_name_caps();
    if (R.is_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)) {
        ret R.err[R.Void, str](R.unwrap_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r));
    }
    sc.caps       = R.unwrap_ok[comptime.PhaseCapabilities[context.SemaContext], str](caps_r);
    sc.own_module = own_module;
    sc.source     = source_text_of(s, a);

    sc.expr_type        = nil;
    sc.type_resolved_ty = nil;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;
    sc.decl_type        = nil;
    sc.embed_len        = nil;
    sc.embed_paths      = nil;
    sc.embed_path_len   = 0;
    sc.embed_path_cap   = 0;

    sc.callee_eid       = id.EXPR_NIL;
    sc.in_comptime_gate = false;
    sc.in_deferred_arm  = false;
    sc.inst_site_set    = false;
    sc.in_fin           = false;
    sc.fin_loop_depth   = 0;
    sc.subst            = nil;
    sc.subst_len        = 0;
    sc.subst_fn         = nil;
    sc.insts            = nil;
    sc.collect_insts    = true;
    sc.inst_depth       = 0;
    sc.inst_parent      = context.INST_NONE;
    sc.silent           = false;
    sc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    sc.uni_reports      = nil;
    sc.has_secret       = false;

    if (a.expr_len > 0) {
        val res_expr: R.Result[*type.TypeId, str] = typeid_array_alloc(s.alloc, a.expr_len);
        if (R.is_err[*type.TypeId, str](res_expr)) {
            dnit_context(sc);
            ret R.err[R.Void, str](R.unwrap_err[*type.TypeId, str](res_expr));
        }
        sc.expr_type = R.unwrap_ok[*type.TypeId, str](res_expr);
    }
    if (a.type_len > 0) {
        val res_type: R.Result[*type.TypeId, str] = typeid_array_alloc(s.alloc, a.type_len);
        if (R.is_err[*type.TypeId, str](res_type)) {
            dnit_context(sc);
            ret R.err[R.Void, str](R.unwrap_err[*type.TypeId, str](res_type));
        }
        sc.type_resolved_ty = R.unwrap_ok[*type.TypeId, str](res_type);

        val res_memo: R.Result[*u8, str] = memo_array_alloc(s.alloc, a.type_len);
        if (R.is_err[*u8, str](res_memo)) {
            dnit_context(sc);
            ret R.err[R.Void, str](R.unwrap_err[*u8, str](res_memo));
        }
        sc.type_resolved_memo = R.unwrap_ok[*u8, str](res_memo);

        val res_emb: R.Result[*u64, str] = embed_len_array_alloc(s.alloc, a.type_len);
        if (R.is_err[*u64, str](res_emb)) {
            dnit_context(sc);
            ret R.err[R.Void, str](R.unwrap_err[*u64, str](res_emb));
        }
        sc.embed_len = R.unwrap_ok[*u64, str](res_emb);
    }
    if (a.decl_len > 0) {
        val res_decl: R.Result[*type.TypeId, str] = typeid_array_alloc(s.alloc, a.decl_len);
        if (R.is_err[*type.TypeId, str](res_decl)) {
            dnit_context(sc);
            ret R.err[R.Void, str](R.unwrap_err[*type.TypeId, str](res_decl));
        }
        sc.decl_type = R.unwrap_ok[*type.TypeId, str](res_decl);

        val res_lay: R.Result[*u8, str] = layout_state_alloc(s.alloc, a.decl_len);
        if (R.is_err[*u8, str](res_lay)) {
            dnit_context(sc);
            ret R.err[R.Void, str](R.unwrap_err[*u8, str](res_lay));
        }
        sc.layout_state = R.unwrap_ok[*u8, str](res_lay);
    }

    val res_seed: R.Result[R.Void, str] = infer.seed_builtins(sc);
    if (R.is_err[R.Void, str](res_seed)) {
        dnit_context(sc);
        ret res_seed;
    }

    ret R.ok_void[str]();
}

fun typeid_array_alloc(a: *A.Allocator, len: usize) R.Result[*type.TypeId, str] {
    val res_arr: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](a, len);
    if (R.is_err[*type.TypeId, str](res_arr)) { ret res_arr; }
    val arr: *type.TypeId = R.unwrap_ok[*type.TypeId, str](res_arr);

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = type.TYPE_NIL;
        i = i + 1;
    }
    ret R.ok[*type.TypeId, str](arr);
}

fun layout_state_alloc(a: *A.Allocator, len: usize) R.Result[*u8, str] {
    val res_arr: R.Result[*u8, str] = A.allocate[u8](a, len);
    if (R.is_err[*u8, str](res_arr)) { ret res_arr; }
    val arr: *u8 = R.unwrap_ok[*u8, str](res_arr);

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = context.LAYOUT_PENDING;
        i = i + 1;
    }
    ret R.ok[*u8, str](arr);
}

fun embed_len_array_alloc(a: *A.Allocator, len: usize) R.Result[*u64, str] {
    val res_arr: R.Result[*u64, str] = A.allocate[u64](a, len);
    if (R.is_err[*u64, str](res_arr)) { ret res_arr; }
    val arr: *u64 = R.unwrap_ok[*u64, str](res_arr);

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = context.EMBED_LEN_NONE;
        i = i + 1;
    }
    ret R.ok[*u64, str](arr);
}

fun memo_array_alloc(a: *A.Allocator, len: usize) R.Result[*u8, str] {
    val res_arr: R.Result[*u8, str] = A.allocate[u8](a, len);
    if (R.is_err[*u8, str](res_arr)) { ret res_arr; }
    val arr: *u8 = R.unwrap_ok[*u8, str](res_arr);

    var i: u32 = 0;
    for (i < len::u32) {
        arr[i] = context.TYPE_MEMO_NONE;
        i = i + 1;
    }
    ret R.ok[*u8, str](arr);
}

fun source_text_of(s: *session.Session, a: *ast.Ast) str {
    val opt_file: O.Option[*source.SourceFile] = source.get(?s.sources, a.file_id);
    if (O.is_none[*source.SourceFile](opt_file)) {
        panic("sema.source_text_of: module source not registered\n");
    }
    ret O.unwrap[*source.SourceFile](opt_file).text;
}

fun dnit_context(sc: *context.SemaContext) {
    if (sc.expr_type != nil && sc.a.expr_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.expr_type, sc.a.expr_len);
    }
    if (sc.type_resolved_ty != nil && sc.a.type_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.type_resolved_ty, sc.a.type_len);
    }
    if (sc.decl_type != nil && sc.a.decl_len > 0) {
        A.deallocate[type.TypeId](sc.s.alloc, sc.decl_type, sc.a.decl_len);
    }
    if (sc.type_resolved_memo != nil && sc.a.type_len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.type_resolved_memo, sc.a.type_len);
    }
    if (sc.layout_state != nil && sc.a.decl_len > 0) {
        A.deallocate[u8](sc.s.alloc, sc.layout_state, sc.a.decl_len);
    }
    if (sc.embed_len != nil && sc.a.type_len > 0) {
        A.deallocate[u64](sc.s.alloc, sc.embed_len, sc.a.type_len);
    }
    if (sc.embed_paths != nil && sc.embed_path_cap > 0) {
        A.deallocate[intern.StrId](sc.s.alloc, sc.embed_paths, sc.embed_path_cap::usize);
    }
    sc.embed_len          = nil;
    sc.embed_paths        = nil;
    sc.embed_path_len     = 0;
    sc.embed_path_cap     = 0;
    sc.expr_type          = nil;
    sc.type_resolved_ty   = nil;
    sc.type_resolved_memo = nil;
    sc.layout_state       = nil;
    sc.decl_type          = nil;
    context.inst_worklist_dnit(sc);
}

fun worklist_reaches_secret(sc: *context.SemaContext, wl: *context.InstWorklist, a: *ast.Ast,
                            sema_result: *context.SemaResult) bool {
    if (wl != nil && wl.secret_state != context.SECRET_UNKNOWN) {
        ret wl.secret_state == context.SECRET_PRESENT;
    }
    val r: R.Result[bool, str] = generics.module_reaches_secret(sc.s, sema_result.type_resolved_ty, a.type_len::u32);
    if (R.is_err[bool, str](r)) { fail.internal(?sc.status, R.unwrap_err[bool, str](r)); ret false; }
    val reaches: bool = R.unwrap_ok[bool, str](r);
    if (wl != nil) {
        wl.secret_state = context.SECRET_ABSENT;
        if (reaches) { wl.secret_state = context.SECRET_PRESENT; }
    }
    ret reaches;
}

fun check_annotation_uni_secrecy_all(sc: *context.SemaContext) {
    if (!sc.has_secret)             { ret; }
    if (sc.type_resolved_ty == nil) { ret; }
    var i: u32 = 0;
    for (i < sc.a.type_len::u32) {
        generics.check_annotation_uni_secrecy(sc, i);
        i = i + 1;
    }
}

fun resolve_all_types(sc: *context.SemaContext) R.Result[R.Void, str] {
    if (sc.type_resolved_ty == nil) { ret R.ok_void[str](); }
    var i: u32 = 0;
    for (i < sc.a.type_len::u32) {
        sc.type_resolved_ty[i] = infer.resolve_type_ref(sc, i);
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun resolve_all_embeds(sc: *context.SemaContext) R.Result[R.Void, str] {
    val opt_module: O.Option[*module.Module] = ast.get_module(sc.a, sc.a.root_module);
    if (O.is_none[*module.Module](opt_module)) {
        ret R.err[R.Void, str]("root_module is not set on this Ast");
    }
    val mnode: *module.Module = O.unwrap[*module.Module](opt_module);
    ret resolve_embeds_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun resolve_embeds_in_list(sc: *context.SemaContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val r: R.Result[R.Void, str] = resolve_embeds_one(sc, did);
        if (R.is_err[R.Void, str](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun resolve_embeds_one(sc: *context.SemaContext, did: id.DeclId) R.Result[R.Void, str] {
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](opt_decl)) { ret R.err[R.Void, str]("DeclId out of range"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        val ci: *decl.DeclComptimeIf = ?d.data.comptime_if;
        if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
            ret R.ok_void[str]();
        }
        var b: u32 = 0;
        for (b < ci.branches_len) {
            val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + b];
            val active_r: R.Result[bool, str] = comptime_branch_active(sc, br);
            if (R.is_err[bool, str](active_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](active_r)); }
            if (R.unwrap_ok[bool, str](active_r)) {
                ret resolve_embeds_in_list(sc, br.body_start, br.body_len);
            }
            b = b + 1;
        }
        ret R.ok_void[str]();
    }

    var found: bool = false;
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (decorator_named(sc, dec, "embed")) {
            if (found) {
                context.report(sc, dec.name, "a declaration can carry only one `embed` decorator");
            }
            or {
                val r: R.Result[R.Void, str] = embed.resolve_one(sc, did, d, dec);
                if (R.is_err[R.Void, str](r)) { ret r; }
                found = true;
            }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun infer_all_decls(sc: *context.SemaContext) R.Result[R.Void, str] {
    if (sc.decl_type == nil) { ret R.ok_void[str](); }
    val opt_module: O.Option[*module.Module] = ast.get_module(sc.a, sc.a.root_module);
    if (O.is_none[*module.Module](opt_module)) {
        ret R.err[R.Void, str]("root_module is not set on this Ast");
    }
    val mnode: *module.Module = O.unwrap[*module.Module](opt_module);
    ret infer_decls_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_gate_support_decls(sc: *context.SemaContext) R.Result[R.Void, str] {
    val opt_module: O.Option[*module.Module] = ast.get_module(sc.a, sc.a.root_module);
    if (O.is_none[*module.Module](opt_module)) {
        ret R.err[R.Void, str]("root_module is not set on this Ast");
    }
    val mnode: *module.Module = O.unwrap[*module.Module](opt_module);
    ret infer_gate_support_decls_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_gate_support_decls_in_list(sc: *context.SemaContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
        if (O.is_none[*decl.Decl](d_opt)) { ret R.err[R.Void, str]("DeclId out of range"); }
        if (O.unwrap[*decl.Decl](d_opt).kind != decl.DECL_KIND_COMPTIME_IF) {
            sc.decl_type[did] = infer.infer_decl(sc, did);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun resolve_module_gates(sc: *context.SemaContext) R.Result[R.Void, str] {
    val opt_module: O.Option[*module.Module] = ast.get_module(sc.a, sc.a.root_module);
    if (O.is_none[*module.Module](opt_module)) {
        ret R.err[R.Void, str]("root_module is not set on this Ast");
    }
    val mnode: *module.Module = O.unwrap[*module.Module](opt_module);
    ret resolve_gates_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun resolve_gates_in_list(sc: *context.SemaContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
        if (O.is_none[*decl.Decl](d_opt)) { ret R.err[R.Void, str]("DeclId out of range"); }
        val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
        if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
            val rr: R.Result[R.Void, str] = resolve_gate_chain(sc, ?d.data.comptime_if);
            if (R.is_err[R.Void, str](rr)) { ret rr; }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun resolve_gate_chain(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) R.Result[R.Void, str] {
    if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
        ret R.ok_void[str]();
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        if (br.cond != id.EXPR_NIL && comptime.gate_state(sc.ctx, br.cond) == comptime.GATE_STATE_UNKNOWN) {
            val dr: R.Result[R.Void, str] = decide_decl_gate(sc, br.cond);
            if (R.is_err[R.Void, str](dr)) { ret dr; }
        }

        var active: bool = br.cond == id.EXPR_NIL;
        if (br.cond != id.EXPR_NIL) {
            val state: comptime.GateState = comptime.gate_state(sc.ctx, br.cond);
            if (state == comptime.GATE_STATE_TRUE)  { active = true; }
            or (state == comptime.GATE_STATE_FALSE) { active = false; }
            or (state == comptime.GATE_STATE_REJECTED) { ret R.ok_void[str](); }
            or {
                val fr: R.Result[comptime.GateVerdict, str] = decl_gate_verdict(sc, br.cond);
                if (R.is_err[comptime.GateVerdict, str](fr)) {
                    ret R.err[R.Void, str](R.unwrap_err[comptime.GateVerdict, str](fr));
                }
                val fv: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](fr);
                if (fv.outcome != comptime.GATE_ACTIVE && fv.outcome != comptime.GATE_INACTIVE) {
                    ret R.ok_void[str]();
                }
                active = fv.outcome == comptime.GATE_ACTIVE;
            }
        }
        if (active) {
            val saved_silent: bool = sc.silent;
            sc.silent = true;
            val rd: R.Result[R.Void, str] = infer_gate_support_decls_in_list(sc, br.body_start, br.body_len);
            sc.silent = saved_silent;
            if (R.is_err[R.Void, str](rd)) { ret rd; }
            ret resolve_gates_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun decl_gate_verdict(sc: *context.SemaContext, cond: id.ExprId) R.Result[comptime.GateVerdict, str] {
    ret comptime.evaluate_gate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, cond,
        ?sc.s.interner, comptime.GATE_SCOPE_DECL, true, true);
}

fun decl_gate_is_active(sc: *context.SemaContext, cond: id.ExprId) R.Result[bool, str] {
    val vr: R.Result[comptime.GateVerdict, str] = decl_gate_verdict(sc, cond);
    if (R.is_err[comptime.GateVerdict, str](vr)) {
        ret R.err[bool, str](R.unwrap_err[comptime.GateVerdict, str](vr));
    }
    val v: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](vr);
    if (v.outcome == comptime.GATE_AWAITING_TYPES) { ret R.ok[bool, str](comptime.truth(v.value)); }
    ret R.ok[bool, str](v.outcome == comptime.GATE_ACTIVE);
}

fun decide_decl_gate(sc: *context.SemaContext, cond: id.ExprId) R.Result[R.Void, str] {
    val vr: R.Result[comptime.GateVerdict, str] = decl_gate_verdict(sc, cond);
    if (R.is_err[comptime.GateVerdict, str](vr)) {
        ret R.err[R.Void, str](R.unwrap_err[comptime.GateVerdict, str](vr));
    }
    val v: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](vr);

    if (v.outcome == comptime.GATE_ACTIVE || v.outcome == comptime.GATE_INACTIVE) {
        ret R.ok_void[str]();
    }
    if (v.outcome == comptime.GATE_REJECTED) {
        if (!sc.silent) { fail.reject(?sc.status); }
        if (str_len(v.message) > 0) {
            val saved_gate: bool = sc.in_comptime_gate;
            sc.in_comptime_gate = true;
            context.report(sc, v.span, v.message);
            sc.in_comptime_gate = saved_gate;
        }
        ret R.ok_void[str]();
    }
    if (v.outcome == comptime.GATE_AWAITING_TYPES) {
        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        val gate_ty: type.TypeId = infer.infer_expr(sc, cond);
        if (type.is_u8(?sc.s.types, gate_ty)) {
            var state: comptime.GateState = comptime.GATE_STATE_FALSE;
            if (comptime.truth(v.value)) { state = comptime.GATE_STATE_TRUE; }
            comptime.set_gate_state(sc.ctx, cond, state);
        }
        or (gate_ty != type.TYPE_NIL && gate_ty != type.TYPE_ERROR) {
            check.check_condition(sc, gate_ty, v.span);
            comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
        }
        or (gate_ty == type.TYPE_ERROR) {
            comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
        }
        sc.in_comptime_gate = saved_gate;
        ret R.ok_void[str]();
    }

    val transient: bool = comptime.gate_eval_failure_is_transient(v.fail);
    val saved_gate: bool = sc.in_comptime_gate;
    val saved_silent: bool = sc.silent;
    sc.in_comptime_gate = true;
    if (transient) { sc.silent = true; }
    val gate_ty: type.TypeId = infer.infer_expr(sc, cond);
    sc.silent = saved_silent;
    if (gate_ty != type.TYPE_NIL && gate_ty != type.TYPE_ERROR && !type.is_u8(?sc.s.types, gate_ty)) {
        check.check_condition(sc, gate_ty, v.span);
        comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
    }
    or (type.is_u8(?sc.s.types, gate_ty) && !transient) {
        context.report(sc, v.span, v.message);
        comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
    }
    or (gate_ty == type.TYPE_ERROR && !transient) {
        comptime.set_gate_state(sc.ctx, cond, comptime.GATE_STATE_REJECTED);
    }
    sc.in_comptime_gate = saved_gate;
    ret R.ok_void[str]();
}

fun infer_decls_in_list(sc: *context.SemaContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val res_decl: R.Result[R.Void, str] = infer_one_decl(sc, did);
        if (R.is_err[R.Void, str](res_decl)) { ret res_decl; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun infer_one_decl(sc: *context.SemaContext, did: id.DeclId) R.Result[R.Void, str] {
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](opt_decl)) { ret R.err[R.Void, str]("DeclId out of range"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret infer_decls_comptime_if(sc, ?d.data.comptime_if);
    }

    val ty: type.TypeId = infer.infer_decl(sc, did);
    sc.decl_type[did] = ty;
    ret R.ok_void[str]();
}

fun infer_decls_comptime_if(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) R.Result[R.Void, str] {
    if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
        ret R.ok_void[str]();
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        if (br.cond != id.EXPR_NIL && comptime.gate_state(sc.ctx, br.cond) == comptime.GATE_STATE_UNKNOWN) {
            val saved_gate: bool = sc.in_comptime_gate;
            sc.in_comptime_gate = true;
            val gate_ty: type.TypeId = infer.infer_expr(sc, br.cond);
            if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret R.ok_void[str](); }
            val gate_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, br.cond);
            val gate_ok: bool = O.is_none[*expr.Expr](gate_opt)
                || check.check_condition(sc, gate_ty, O.unwrap[*expr.Expr](gate_opt).span);
            sc.in_comptime_gate = saved_gate;
            if (!gate_ok) { ret R.ok_void[str](); }
        }
        val active_r: R.Result[bool, str] = comptime_branch_active(sc, br);
        if (R.is_err[bool, str](active_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](active_r)); }
        if (R.unwrap_ok[bool, str](active_r)) {
            ret infer_decls_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun infer_all_bodies(sc: *context.SemaContext) R.Result[R.Void, str] {
    if (sc.decl_type == nil) { ret R.ok_void[str](); }
    val opt_module: O.Option[*module.Module] = ast.get_module(sc.a, sc.a.root_module);
    if (O.is_none[*module.Module](opt_module)) {
        ret R.err[R.Void, str]("root_module is not set on this Ast");
    }
    val mnode: *module.Module = O.unwrap[*module.Module](opt_module);
    ret infer_bodies_in_list(sc, mnode.decls_start, mnode.decls_len);
}

fun infer_bodies_in_list(sc: *context.SemaContext, start: u32, len: u32) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val did: id.DeclId = sc.a.decl_ids[start + i];
        val res_body: R.Result[R.Void, str] = infer_one_body(sc, did);
        if (R.is_err[R.Void, str](res_body)) { ret res_body; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun pack_on_import_check(sc: *context.SemaContext, d: *decl.Decl) {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[d.data.fun_.params_start + i];
        val opt_t: O.Option[*atype.Type] = ast.get_type(sc.a, tn.ty);
        if (O.is_some[*atype.Type](opt_t)) {
            if (O.unwrap[*atype.Type](opt_t).kind == atype.TYPE_KIND_PACK) {
                context.report_note(sc, d.span,
                    "a comptime variadic pack `...` cannot appear on a body-less `fun`",
                    "a pack is monomorphized per call site and takes a mangled name, so no foreign library can export it; for a C function declared with `...`, write the C-variadic form instead: `ext fun f(a: T, ...)`");
                ret;
            }
        }
        i = i + 1;
    }
}

fun infer_one_body(sc: *context.SemaContext, did: id.DeclId) R.Result[R.Void, str] {
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](opt_decl)) { ret R.err[R.Void, str]("DeclId out of range"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);

    infer_decorator_args(sc, d);
    validate_decorators(sc, d);
    check_handle_decl(sc, did, d);
    check_abi_type_placement(sc, did, d);

    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret infer_bodies_comptime_if(sc, ?d.data.comptime_if);
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        if (d.data.fun_.body != id.STMT_NIL) {
            if (d.data.fun_.c_variadic) {
                context.report(sc, d.span, "a C-variadic `...` declares a foreign import and cannot have a body");
            }
            val ret_ty: type.TypeId = context.resolved_type_of(sc, d.data.fun_.return_type);
            ret infer_stmt(sc, d.data.fun_.body, ret_ty);
        }
        pack_on_import_check(sc, d);
        ret R.ok_void[str]();
    }
    if (d.kind == decl.DECL_KIND_TEST) {
        if (d.data.test_.body != id.STMT_NIL) {
            val ret_ty: type.TypeId = test_return_type(sc);
            ret infer_stmt(sc, d.data.test_.body, ret_ty);
        }
        ret R.ok_void[str]();
    }
    if (d.kind == decl.DECL_KIND_VAL || d.kind == decl.DECL_KIND_VAR) {
        if ((d.flags & decl.DECL_FLAG_EXT) != 0 && d.data.bind.init != id.EXPR_NIL) {
            context.report(sc, d.span, "an `ext` data import cannot have an initializer");
            ret R.ok_void[str]();
        }
        ret infer_binding_init(sc, did, d);
    }
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) {
        eval_comptime_directive(sc, d.data.comptime_attr.target, d.span);
        ret R.ok_void[str]();
    }
    ret R.ok_void[str]();
}

fun infer_decorator_args(sc: *context.SemaContext, d: *decl.Decl) {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        var ii: u32 = 0;
        for (ii < dec.args_len) {
            if (!handle.arg_is_type(sc, dec, ii)) {
                infer.infer_expr(sc, sc.a.expr_ids[dec.args_start + ii]);
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun validate_decorators(sc: *context.SemaContext, d: *decl.Decl) {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        validate_one_decorator(sc, d, ?sc.a.decorators[d.decorators_start + i]);
        i = i + 1;
    }
    validate_no_inline_conflict(sc, d);
}

fun validate_no_inline_conflict(sc: *context.SemaContext, d: *decl.Decl) {
    var has_inline:   bool = false;
    var has_noinline: bool = false;
    var noinline_span: token.Span;
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?sc.a.decorators[d.decorators_start + i];
        if (decorator_named(sc, dec, "inline"))   { has_inline = true; }
        if (decorator_named(sc, dec, "noinline")) { has_noinline = true; noinline_span = dec.name; }
        i = i + 1;
    }
    if (has_inline && has_noinline) {
        context.report(sc, noinline_span, "`inline` and `noinline` decorators cannot both apply to the same function");
    }
}

fun decorator_named(sc: *context.SemaContext, dec: *decl.Decorator, name: str) bool {
    ret str_region_equals(sc.source, dec.name.offset, dec.name.len, name);
}

fun decl_has_decorator(sc: *context.SemaContext, d: *decl.Decl, name: str) bool {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        if (decorator_named(sc, ?sc.a.decorators[d.decorators_start + i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun require_string_arg(sc: *context.SemaContext, dec: *decl.Decorator, count_msg: str, kind_msg: str) {
    if (dec.args_len != 1) {
        context.report(sc, dec.name, count_msg);
        ret;
    }
    val opt_arg: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start]);
    if (O.is_some[*expr.Expr](opt_arg)) {
        val arg: *expr.Expr = O.unwrap[*expr.Expr](opt_arg);
        if (arg.kind != expr.EXPR_KIND_LIT_STR) {
            context.report(sc, arg.span, kind_msg);
        }
    }
}

fun validate_iface_target(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (!is_global_binding(d.kind)) {
        context.report(sc, dec.name, "shader interface decorators apply only to module-level `val` / `var` bindings");
        ret;
    }
    var roles: u32 = 0;
    if (has_decorator(sc, d, "input"))   { roles = roles + 1; }
    if (has_decorator(sc, d, "output"))  { roles = roles + 1; }
    if (has_decorator(sc, d, "builtin")) { roles = roles + 1; }
    if (has_decorator(sc, d, "uniform")) { roles = roles + 1; }
    if (has_decorator(sc, d, "storage")) { roles = roles + 1; }
    if (has_decorator(sc, d, "sampler")) { roles = roles + 1; }
    if (roles > 1) {
        context.report(sc, dec.name, "a shader interface variable carries exactly one role; `input`, `output`, `builtin`, `uniform`, `storage`, and `sampler` are mutually exclusive");
    }
}

fun validate_builtin_value(sc: *context.SemaContext, dec: *decl.Decorator) {
    if (dec.args_len != 1) { ret; }
    val opt_arg: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start]);
    if (O.is_none[*expr.Expr](opt_arg)) { ret; }
    val arg: *expr.Expr = O.unwrap[*expr.Expr](opt_arg);
    if (arg.kind != expr.EXPR_KIND_LIT_STR || arg.span.len < 2::usize) { ret; }
    val off: usize = arg.span.offset + 1::usize;
    val len: usize = arg.span.len - 2::usize;
    if (str_region_equals(sc.source, off, len, "position"))          { ret; }
    if (str_region_equals(sc.source, off, len, "vertex_index"))      { ret; }
    if (str_region_equals(sc.source, off, len, "instance_index"))    { ret; }
    if (str_region_equals(sc.source, off, len, "frag_coord"))        { ret; }
    if (str_region_equals(sc.source, off, len, "point_size"))        { ret; }
    if (str_region_equals(sc.source, off, len, "global_invocation")) { ret; }
    if (str_region_equals(sc.source, off, len, "local_invocation"))  { ret; }
    if (str_region_equals(sc.source, off, len, "workgroup_id"))      { ret; }
    context.report(sc, arg.span, "unknown built-in; `builtin` accepts \"position\", \"vertex_index\", \"instance_index\", \"frag_coord\", \"point_size\", \"global_invocation\", \"local_invocation\", or \"workgroup_id\"");
}

fun validate_stage_value(sc: *context.SemaContext, dec: *decl.Decorator) {
    if (dec.args_len != 1) { ret; }
    val opt_arg: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start]);
    if (O.is_none[*expr.Expr](opt_arg)) { ret; }
    val arg: *expr.Expr = O.unwrap[*expr.Expr](opt_arg);
    if (arg.kind != expr.EXPR_KIND_LIT_STR || arg.span.len < 2::usize) { ret; }
    val off: usize = arg.span.offset + 1::usize;
    val len: usize = arg.span.len - 2::usize;
    if (str_region_equals(sc.source, off, len, "vertex"))   { ret; }
    if (str_region_equals(sc.source, off, len, "fragment")) { ret; }
    if (str_region_equals(sc.source, off, len, "compute"))  { ret; }
    context.report(sc, arg.span, "unknown pipeline stage; `stage` accepts \"vertex\", \"fragment\", or \"compute\"");
}

fun validate_storage_quals(sc: *context.SemaContext, dec: *decl.Decorator) {
    var i: u32 = 2;
    for (i < dec.args_len) {
        val opt_arg: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start + i]);
        if (O.is_none[*expr.Expr](opt_arg)) { i = i + 1; cnt; }
        val arg: *expr.Expr = O.unwrap[*expr.Expr](opt_arg);
        if (arg.kind != expr.EXPR_KIND_LIT_STR || arg.span.len < 2::usize) {
            context.report(sc, arg.span, "a `storage` memory qualifier must be a string literal; `storage` takes the descriptor set and binding followed by qualifiers, as in `#[storage(0, 3, \"readonly\")]`");
            i = i + 1; cnt;
        }
        val off: usize = arg.span.offset + 1::usize;
        val len: usize = arg.span.len - 2::usize;
        if (!str_region_equals(sc.source, off, len, "readonly")) {
            context.report(sc, arg.span, "unknown `storage` memory qualifier; `storage` accepts \"readonly\"");
        }
        i = i + 1;
    }
}

fun validate_op(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (d.kind != decl.DECL_KIND_FUN) {
        context.report(sc, dec.name, "`op` decorator applies only to functions");
        ret;
    }
    if (dec.args_len != 3) {
        context.report(sc, dec.name, "`op` decorator takes three string arguments: the target, the instruction set, and the instruction name");
        ret;
    }
    val opt_tgt: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start]);
    val opt_set: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start + 1]);
    val opt_nam: O.Option[*expr.Expr] = ast.get_expr(sc.a, sc.a.expr_ids[dec.args_start + 2]);
    if (O.is_none[*expr.Expr](opt_tgt) || O.is_none[*expr.Expr](opt_set) || O.is_none[*expr.Expr](opt_nam)) { ret; }
    val tgt_e: *expr.Expr = O.unwrap[*expr.Expr](opt_tgt);
    val set_e: *expr.Expr = O.unwrap[*expr.Expr](opt_set);
    val nam_e: *expr.Expr = O.unwrap[*expr.Expr](opt_nam);
    if (tgt_e.kind != expr.EXPR_KIND_LIT_STR || set_e.kind != expr.EXPR_KIND_LIT_STR
        || nam_e.kind != expr.EXPR_KIND_LIT_STR) {
        context.report(sc, dec.name, "`op` decorator arguments must be string literals: all three are matched against the target registry rather than evaluated");
        ret;
    }
    if (tgt_e.span.len < 2::usize || set_e.span.len < 2::usize || nam_e.span.len < 2::usize) { ret; }

    val defs: *isa.TargetDefs = sc.ctx.env.target_defs;

    if (!target_is_selected(sc, tgt_e))    { ret; }
    if (defs == nil || defs.op_count == 0) { ret; }

    if (!isa.op_set_exists_region(defs, sc.source, set_e.span.offset + 1::usize, set_e.span.len - 2::usize)) {
        context.report(sc, set_e.span, "the selected target defines no instruction set of this name; an `op` declaration is emitted only by a target that publishes the instruction");
        ret;
    }
    val od: *isa.OpDef = isa.op_def_of_region(defs,
        sc.source, set_e.span.offset + 1::usize, set_e.span.len - 2::usize,
        sc.source, nam_e.span.offset + 1::usize, nam_e.span.len - 2::usize);
    if (od == nil) {
        context.report(sc, nam_e.span, "that instruction set defines no instruction of this name, or the selected target does not carry it; the target's own table lists the accepted names and why each omission is one");
        ret;
    }
    if (d.data.fun_.params_len != od.arity) {
        context.report(sc, dec.name, "the declaration's parameter count does not match the instruction's operand count: operands come from the parameters in order, so a mismatch assembles the instruction with the wrong number of operands");
    }
}

fun target_is_selected(sc: *context.SemaContext, tgt_e: *expr.Expr) bool {
    val no: O.Option[str] = intern.lookup(?sc.s.interner, sc.ctx.env.target_isa);
    if (O.is_none[str](no)) { ret false; }
    ret str_region_equals(sc.source, tgt_e.span.offset + 1::usize,
                          tgt_e.span.len - 2::usize, O.unwrap[str](no));
}

fun is_align_target(kind: decl.DeclKind) bool {
    ret kind == decl.DECL_KIND_VAL || kind == decl.DECL_KIND_VAR ||
        kind == decl.DECL_KIND_REC || kind == decl.DECL_KIND_UNI;
}

fun type_carries_handle(sc: *context.SemaContext, t: type.TypeId) bool {
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, t);
    if (O.is_none[*type.Type](opt_type)) { ret false; }
    val tp: *type.Type = O.unwrap[*type.Type](opt_type);
    if (tp.kind == type.TYPE_HANDLE)  { ret true; }
    if (tp.kind == type.TYPE_SECRET)  { ret type_carries_handle(sc, tp.data.secret.base); }
    if (tp.kind == type.TYPE_POINTER) { ret type_carries_handle(sc, tp.data.pointer.base); }
    if (tp.kind == type.TYPE_ARRAY)   { ret type_carries_handle(sc, tp.data.array.base); }
    ret false;
}

fun check_handle_fields_all(sc: *context.SemaContext) {
    if (sc.decl_type == nil) { ret; }
    var d: u32 = 0;
    for (d < sc.a.decl_len::u32) {
        val d_opt: O.Option[*decl.Decl] = ast.get_decl(sc.a, d);
        if (O.is_none[*decl.Decl](d_opt)) { d = d + 1; cnt; }
        val dd: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
        if (dd.kind == decl.DECL_KIND_REC) {
            check_handle_fields(sc, dd.data.rec_.fields_start, dd.data.rec_.fields_len);
        }
        or (dd.kind == decl.DECL_KIND_UNI) {
            check_handle_fields(sc, dd.data.uni_.fields_start, dd.data.uni_.fields_len);
        }
        d = d + 1;
    }
}

fun check_handle_fields(sc: *context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[start + i];
        if (type_carries_handle(sc, context.resolved_type_of(sc, tn.ty))) {
            context.report(sc, tn.name,
                "a handle cannot be a record or union field: a record is storage the program owns at offsets it can compute, and a handle's representation is not the program's, so an aggregate holding one has no layout. declare the handle itself");
        }
        i = i + 1;
    }
}

fun type_carries_abi_type(sc: *context.SemaContext, t: type.TypeId) bool {
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }
    val opt_type: O.Option[*type.Type] = type.get(?sc.s.types, t);
    if (O.is_none[*type.Type](opt_type)) { ret false; }
    val tp: *type.Type = O.unwrap[*type.Type](opt_type);
    if (tp.kind == type.TYPE_ABI)     { ret true; }
    if (tp.kind == type.TYPE_SECRET)  { ret type_carries_abi_type(sc, tp.data.secret.base); }
    if (tp.kind == type.TYPE_POINTER) { ret type_carries_abi_type(sc, tp.data.pointer.base); }
    if (tp.kind == type.TYPE_ARRAY)   { ret type_carries_abi_type(sc, tp.data.array.base); }
    ret false;
}

fun check_abi_type_placement(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl) {
    if (d.kind == decl.DECL_KIND_REC) {
        check_abi_type_fields(sc, d.data.rec_.fields_start, d.data.rec_.fields_len);
        ret;
    }
    if (d.kind == decl.DECL_KIND_UNI) {
        check_abi_type_fields(sc, d.data.uni_.fields_start, d.data.uni_.fields_len);
        ret;
    }
    if (d.kind == decl.DECL_KIND_FUN) {
        var i: u32 = 0;
        for (i < d.data.fun_.params_len) {
            val tn: *decl.TypedName = ?sc.a.typed_names[d.data.fun_.params_start + i];
            val pty: type.TypeId = context.resolved_type_of(sc, tn.ty);
            if (type_carries_abi_type(sc, pty) && !type.is_abi_type(?sc.s.types, pty)) {
                context.report(sc, tn.name, abitype.exclusion_message());
            }
            i = i + 1;
        }
        if (type_carries_abi_type(sc, context.resolved_type_of(sc, d.data.fun_.return_type))) {
            context.report(sc, d.data.fun_.name, abitype.exclusion_message());
        }
        ret;
    }
    if (is_global_binding(d.kind)) {
        if (sc.decl_type == nil) { ret; }
        if (type_carries_abi_type(sc, sc.decl_type[did])) {
            context.report(sc, d.span, abitype.exclusion_message());
        }
    }
}

fun check_abi_type_fields(sc: *context.SemaContext, start: u32, len: u32) {
    var i: u32 = 0;
    for (i < len) {
        val tn: *decl.TypedName = ?sc.a.typed_names[start + i];
        if (type_carries_abi_type(sc, context.resolved_type_of(sc, tn.ty))) {
            context.report(sc, tn.name, abitype.exclusion_message());
        }
        i = i + 1;
    }
}

fun check_handle_decl(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl) {
    if (sc.decl_type == nil)             { ret; }
    if (!is_global_binding(d.kind))      { ret; }
    val ty: type.TypeId = sc.decl_type[did];
    val carries: bool   = type_carries_handle(sc, ty);
    val marked:  bool   = decl_has_decorator(sc, d, "sampler");

    if (carries && !type.is_handle(?sc.s.types, ty)) {
        context.report(sc, d.span,
            "a handle cannot sit behind a pointer or inside an array: a pointer and an array are both extents the program computes, and a handle's extent is the owning target's rather than the program's, so there is no element size to step by. declare the handle itself");
        ret;
    }
    if (carries && !marked) {
        if (has_decorator(sc, d, "input") || has_decorator(sc, d, "output")
            || has_decorator(sc, d, "builtin") || has_decorator(sc, d, "uniform")
            || has_decorator(sc, d, "storage")) {
            context.report(sc, d.span,
                "a handle is bound as a descriptor and carries `#[sampler(set, binding)]`; the role on it puts the handle in a storage class no handle may live in");
            ret;
        }
        context.report(sc, d.span,
            "a handle binding needs a `#[sampler(set, binding)]` decorator: a shader has no general global storage, so a handle with no descriptor address is reachable from no stage");
        ret;
    }
    if (marked && !carries) {
        context.report(sc, d.span,
            "`sampler` decorator applies only to a handle binding, a `def` declared with `#[handle(...)]`; a descriptor-bound block or buffer of an ordinary type is `#[uniform(set, binding)]` or `#[storage(set, binding)]`");
    }
}

fun is_global_binding(kind: decl.DeclKind) bool {
    ret kind == decl.DECL_KIND_VAL || kind == decl.DECL_KIND_VAR;
}

fun is_fun_or_global(kind: decl.DeclKind) bool {
    ret kind == decl.DECL_KIND_FUN || kind == decl.DECL_KIND_VAL || kind == decl.DECL_KIND_VAR;
}

fun decorator_arg_type(sc: *context.SemaContext, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL)          { ret type.TYPE_ERROR; }
    if (eid::usize >= sc.a.expr_len) { ret type.TYPE_ERROR; }
    ret sc.expr_type[eid];
}

fun validate_one_decorator(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (decorator_named(sc, dec, "symbol")) {
        require_string_arg(sc, dec,
            "`symbol` decorator takes one string argument",
            "`symbol` decorator argument must be a string literal");
        if (!is_fun_or_global(d.kind)) {
            context.report(sc, dec.name, "`symbol` decorator applies only to functions and globals");
        }
        ret;
    }
    if (decorator_named(sc, dec, "library")) {
        require_string_arg(sc, dec,
            "`library` decorator takes one string argument",
            "`library` decorator argument must be a string literal");
        if ((d.flags & decl.DECL_FLAG_EXT) == 0) {
            context.report(sc, dec.name, "`library` decorator applies only to ext imports");
        }
        ret;
    }
    if (decorator_named(sc, dec, "inline")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`inline` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`inline` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "noinline")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`noinline` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`noinline` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "oblivious")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`oblivious` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`oblivious` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "align")) {
        if (dec.args_len != 1) {
            context.report(sc, dec.name, "`align` decorator takes one argument");
        } or (is_global_binding(d.kind)) {
            val arg_eid: id.ExprId = sc.a.expr_ids[dec.args_start];
            if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, arg_eid))) {
                context.report(sc, dec.name, "`align` decorator argument must be an integer comptime expression");
            }
        }
        if (!is_align_target(d.kind)) {
            context.report(sc, dec.name, "`align` decorator applies only to records, unions, and globals");
        }
        ret;
    }
    if (decorator_named(sc, dec, "section")) {
        require_string_arg(sc, dec,
            "`section` decorator takes one string argument",
            "`section` decorator argument must be a string literal");
        if (!is_fun_or_global(d.kind)) {
            context.report(sc, dec.name, "`section` decorator applies only to functions and globals");
        }
        ret;
    }
    if (decorator_named(sc, dec, "stage")) {
        require_string_arg(sc, dec,
            "`stage` decorator takes one string argument",
            "`stage` decorator argument must be a string literal");
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`stage` decorator applies only to functions");
            ret;
        }
        validate_stage_value(sc, dec);
        ret;
    }
    if (decorator_named(sc, dec, "workgroup")) {
        if (dec.args_len != 3) {
            context.report(sc, dec.name, "`workgroup` decorator takes three arguments: the x, y, and z workgroup dimensions");
        }
        or {
            var wi: u32 = 0;
            for (wi < 3) {
                val aeid: id.ExprId = sc.a.expr_ids[dec.args_start + wi];
                if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, aeid))) {
                    context.report(sc, dec.name, "`workgroup` decorator dimensions must be integer comptime expressions");
                    wi = 3; cnt;
                }
                wi = wi + 1;
            }
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`workgroup` decorator applies only to functions");
            ret;
        }
        if (!has_decorator(sc, d, "stage")) {
            context.report(sc, dec.name, "`workgroup` decorator requires a `#[stage(\"compute\")]` on the same function; it sizes a compute stage's workgroup and means nothing without one");
        }
        ret;
    }
    if (decorator_named(sc, dec, "input") || decorator_named(sc, dec, "output")) {
        if (dec.args_len != 1) {
            context.report(sc, dec.name, "`input` / `output` decorator takes one argument: the interface location");
        }
        or {
            val leid: id.ExprId = sc.a.expr_ids[dec.args_start];
            if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, leid))) {
                context.report(sc, dec.name, "`input` / `output` location must be an integer comptime expression");
            }
        }
        validate_iface_target(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "builtin")) {
        require_string_arg(sc, dec,
            "`builtin` decorator takes one string argument",
            "`builtin` decorator argument must be a string literal");
        validate_iface_target(sc, d, dec);
        validate_builtin_value(sc, dec);
        ret;
    }
    if (decorator_named(sc, dec, "uniform") || decorator_named(sc, dec, "storage")) {
        val quals: bool = decorator_named(sc, dec, "storage");
        if (dec.args_len < 2 || (dec.args_len > 2 && !quals)) {
            context.report(sc, dec.name, "`uniform` / `storage` decorator takes two arguments: the descriptor set and the binding");
        }
        or {
            var ui: u32 = 0;
            for (ui < 2) {
                val ueid: id.ExprId = sc.a.expr_ids[dec.args_start + ui];
                if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, ueid))) {
                    context.report(sc, dec.name, "`uniform` / `storage` descriptor set and binding must be integer comptime expressions");
                    ui = 2; cnt;
                }
                ui = ui + 1;
            }
            if (quals) { validate_storage_quals(sc, dec); }
        }
        validate_iface_target(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "sampler")) {
        if (dec.args_len != 2) {
            context.report(sc, dec.name, "`sampler` decorator takes two arguments: the descriptor set and the binding");
        }
        or {
            var si: u32 = 0;
            for (si < 2) {
                val seid: id.ExprId = sc.a.expr_ids[dec.args_start + si];
                if (!type.is_integer(?sc.s.types, decorator_arg_type(sc, seid))) {
                    context.report(sc, dec.name, "`sampler` descriptor set and binding must be integer comptime expressions");
                    si = 2; cnt;
                }
                si = si + 1;
            }
        }
        validate_iface_target(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "packed")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`packed` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_REC && d.kind != decl.DECL_KIND_UNI) {
            context.report(sc, dec.name, "`packed` decorator applies only to records and unions");
        }
        if (decl_has_decorator(sc, d, "uniform") || decl_has_decorator(sc, d, "storage")) {
            context.report(sc, dec.name,
                "`packed` cannot apply to a `uniform` / `storage` interface block: its member offsets are fixed by the std140 / std430 layout rules and emitted as explicit Offset decorations, which packing would contradict");
        }
        ret;
    }
    if (decorator_named(sc, dec, "volatile")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`volatile` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_REC && d.kind != decl.DECL_KIND_UNI) {
            context.report(sc, dec.name, "`volatile` decorator applies only to records and unions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "scalar")) {
        if (dec.args_len != 0) {
            context.report(sc, dec.name, "`scalar` decorator takes no arguments");
        }
        if (d.kind != decl.DECL_KIND_FUN) {
            context.report(sc, dec.name, "`scalar` decorator applies only to functions");
        }
        ret;
    }
    if (decorator_named(sc, dec, "naked")) {
        validate_naked(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, "embed")) { ret; }
    if (decorator_named(sc, dec, "op")) {
        validate_op(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, handle.DIRECTIVE)) {
        handle.validate(sc, d, dec);
        ret;
    }
    if (decorator_named(sc, dec, abitype.DIRECTIVE)) {
        abitype.validate(sc, d, dec);
        ret;
    }
    context.report(sc, dec.name, "unknown decorator; valid directives are symbol, section, inline, noinline, align, packed, volatile, library, oblivious, scalar, naked, embed, stage, workgroup, input, output, builtin, uniform, storage, sampler, op, handle, abi_type");
}

fun validate_naked(sc: *context.SemaContext, d: *decl.Decl, dec: *decl.Decorator) {
    if (dec.args_len != 0) {
        context.report(sc, dec.name, "`naked` decorator takes no arguments");
    }
    if (d.kind != decl.DECL_KIND_FUN) {
        context.report(sc, dec.name, "`naked` decorator applies only to functions");
        ret;
    }
    if (has_decorator(sc, d, "inline")) {
        context.report(sc, dec.name, "`naked` and `inline` decorators are mutually exclusive; a naked function cannot be inlined");
    }
    if (has_decorator(sc, d, "oblivious")) {
        context.report(sc, dec.name, "`naked` and `oblivious` decorators are mutually exclusive; a naked body is inline asm, which `oblivious` forbids");
    }
    if (d.data.fun_.body == id.STMT_NIL) {
        context.report(sc, dec.name, "`naked` decorator applies only to a function with a body");
        ret;
    }
    check_naked_body(sc, d.data.fun_.body);
}

fun check_naked_body(sc: *context.SemaContext, sid: id.StmtId) {
    val opt_stmt: O.Option[*stmt.Stmt] = ast.get_stmt(sc.a, sid);
    if (O.is_none[*stmt.Stmt](opt_stmt)) { ret; }
    val s: *stmt.Stmt = O.unwrap[*stmt.Stmt](opt_stmt);

    if (s.kind == stmt.STMT_KIND_ASM) { ret; }

    if (s.kind == stmt.STMT_KIND_BLOCK) {
        var i: u32 = 0;
        for (i < s.data.block.stmts_len) {
            check_naked_body(sc, sc.a.stmt_ids[s.data.block.stmts_start + i]);
            i = i + 1;
        }
        ret;
    }

    if (s.kind == stmt.STMT_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < s.data.comptime_if.branches_len) {
            val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[s.data.comptime_if.branches_start + b];
            var i: u32 = 0;
            for (i < br.body_len) {
                check_naked_body(sc, sc.a.stmt_ids[br.body_start + i]);
                i = i + 1;
            }
            b = b + 1;
        }
        ret;
    }

    context.report(sc, s.span, "a `naked` function's body may contain only inline `asm` statements");
}

fun has_decorator(sc: *context.SemaContext, d: *decl.Decl, name: str) bool {
    var i: u32 = 0;
    for (i < d.decorators_len) {
        if (decorator_named(sc, ?sc.a.decorators[d.decorators_start + i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun test_return_type(sc: *context.SemaContext) type.TypeId {
    val opt_i32: O.Option[type.TypeId] = type.prim(?sc.s.types, type.TYPE_I32);
    if (O.is_none[type.TypeId](opt_i32)) { ret type.TYPE_ERROR; }
    ret O.unwrap[type.TypeId](opt_i32);
}

fun infer_binding_init(sc: *context.SemaContext, did: id.DeclId, d: *decl.Decl) R.Result[R.Void, str] {
    if (d.data.bind.init == id.EXPR_NIL) { ret R.ok_void[str](); }
    if (d.data.bind.ty   == id.TYPE_NIL) { ret R.ok_void[str](); }

    val actual:   type.TypeId = infer.infer_expr(sc, d.data.bind.init);
    val expected: type.TypeId = sc.decl_type[did];
    if (expected != type.TYPE_NIL && expected != type.TYPE_ERROR && actual != type.TYPE_ERROR) {
        check_binding(sc, expected, d.data.bind.init, actual, d.span);
    }
    ret R.ok_void[str]();
}

fun infer_bodies_deferred_chain(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        if (br.cond == id.EXPR_NIL) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, br.cond);
        if (O.is_none[*expr.Expr](e_opt)) { ret R.err[R.Void, str]("comptime branch cond ExprId out of range"); }
        val cond_span: token.Span = O.unwrap[*expr.Expr](e_opt).span;

        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        val gate_ty: type.TypeId = infer.infer_expr(sc, br.cond);
        if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret R.ok_void[str](); }
        if (!check.check_condition(sc, gate_ty, cond_span)) { sc.in_comptime_gate = saved_gate; ret R.ok_void[str](); }

        val vr: R.Result[comptime.GateVerdict, str] = stmt_gate_verdict(sc, br.cond);
        if (R.is_err[comptime.GateVerdict, str](vr)) {
            sc.in_comptime_gate = saved_gate;
            ret R.err[R.Void, str](R.unwrap_err[comptime.GateVerdict, str](vr));
        }
        val v: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](vr);
        if (v.outcome != comptime.GATE_ACTIVE && v.outcome != comptime.GATE_INACTIVE
         && v.outcome != comptime.GATE_AWAITING_TYPES) {
            if (str_len(v.message) > 0) { context.report(sc, cond_span, v.message); }
            sc.in_comptime_gate = saved_gate;
            ret R.ok_void[str]();
        }
        sc.in_comptime_gate = saved_gate;
        if (gate_verdict_truth(v)) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun stmt_gate_verdict(sc: *context.SemaContext, cond: id.ExprId) R.Result[comptime.GateVerdict, str] {
    ret comptime.evaluate_gate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, cond,
        ?sc.s.interner, comptime.GATE_SCOPE_INSTANCE, false, true);
}

fun gate_verdict_truth(v: comptime.GateVerdict) bool {
    if (v.outcome == comptime.GATE_ACTIVE)         { ret true; }
    if (v.outcome == comptime.GATE_AWAITING_TYPES) { ret comptime.truth(v.value); }
    ret false;
}

fun infer_bodies_comptime_if(sc: *context.SemaContext, ci: *decl.DeclComptimeIf) R.Result[R.Void, str] {
    if (comptime.comptime_if_declares_nothing(sc.a, ci.branches_start, ci.branches_len)) {
        ret infer_bodies_deferred_chain(sc, ci);
    }
    var i: u32 = 0;
    for (i < ci.branches_len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[ci.branches_start + i];
        val active_r: R.Result[bool, str] = comptime_branch_active(sc, br);
        if (R.is_err[bool, str](active_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](active_r)); }
        if (R.unwrap_ok[bool, str](active_r)) {
            ret infer_bodies_in_list(sc, br.body_start, br.body_len);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun infer_stmt(sc: *context.SemaContext, sid: id.StmtId, fn_ret: type.TypeId) R.Result[R.Void, str] {
    if (sid == id.STMT_NIL) { ret R.ok_void[str](); }
    val opt_stmt: O.Option[*stmt.Stmt] = ast.get_stmt(sc.a, sid);
    if (O.is_none[*stmt.Stmt](opt_stmt)) { ret R.err[R.Void, str]("StmtId out of range"); }
    val st: *stmt.Stmt = O.unwrap[*stmt.Stmt](opt_stmt);

    if (st.kind == stmt.STMT_KIND_EXPR) {
        infer.infer_expr(sc, st.data.expr.expr);
        ret R.ok_void[str]();
    }
    if (st.kind == stmt.STMT_KIND_BLOCK) {
        ret infer_stmt_list(sc, st.data.block.stmts_start, st.data.block.stmts_len, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_IF) {
        val cond_ty: type.TypeId = infer.infer_expr(sc, st.data.if_.cond);
        if (cond_ty != type.TYPE_ERROR) { check.check_condition(sc, cond_ty, st.span); }
        val res_then: R.Result[R.Void, str] = infer_stmt(sc, st.data.if_.then_block, fn_ret);
        if (R.is_err[R.Void, str](res_then)) { ret res_then; }
        ret infer_stmt(sc, st.data.if_.else_block, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_FOR) {
        if (st.data.for_.cond != id.EXPR_NIL) {
            val cond_ty: type.TypeId = infer.infer_expr(sc, st.data.for_.cond);
            if (cond_ty != type.TYPE_ERROR) { check.check_condition(sc, cond_ty, st.span); }
        }
        sc.fin_loop_depth = sc.fin_loop_depth + 1;
        val res_body: R.Result[R.Void, str] = infer_stmt(sc, st.data.for_.body, fn_ret);
        sc.fin_loop_depth = sc.fin_loop_depth - 1;
        ret res_body;
    }
    if (st.kind == stmt.STMT_KIND_RET) {
        if (sc.in_fin) {
            context.report(sc, st.span, "`ret` cannot appear inside a `fin` body");
        }
        check_return_stmt(sc, fn_ret, st.data.ret_.value, st.span);
        ret R.ok_void[str]();
    }
    if (st.kind == stmt.STMT_KIND_BRK) {
        if (sc.in_fin && sc.fin_loop_depth == 0) {
            context.report(sc, st.span, "`brk` inside a `fin` body cannot target a loop outside the fin");
        }
        ret R.ok_void[str]();
    }
    if (st.kind == stmt.STMT_KIND_CNT) {
        if (sc.in_fin && sc.fin_loop_depth == 0) {
            context.report(sc, st.span, "`cnt` inside a `fin` body cannot target a loop outside the fin");
        }
        ret R.ok_void[str]();
    }
    if (st.kind == stmt.STMT_KIND_FIN) {
        val saved_in:    bool = sc.in_fin;
        val saved_depth: u32  = sc.fin_loop_depth;
        sc.in_fin         = true;
        sc.fin_loop_depth = 0;
        val res_body: R.Result[R.Void, str] = infer_stmt(sc, st.data.fin_.body, fn_ret);
        sc.in_fin         = saved_in;
        sc.fin_loop_depth = saved_depth;
        ret res_body;
    }
    if (st.kind == stmt.STMT_KIND_DECL) {
        ret infer_local_decl(sc, st.data.decl.decl);
    }
    if (st.kind == stmt.STMT_KIND_COMPTIME_IF) {
        ret infer_stmt_comptime_if(sc, st.data.comptime_if.branches_start, st.data.comptime_if.branches_len, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_COMPTIME_EACH) {
        ret infer_stmt_comptime_each(sc, ?st.data.comptime_each, st.span, fn_ret);
    }
    if (st.kind == stmt.STMT_KIND_COMPTIME_ATTR) {
        eval_comptime_directive(sc, st.data.comptime_attr.target, st.span);
        ret R.ok_void[str]();
    }
    ret R.ok_void[str]();
}

fun eval_comptime_directive(sc: *context.SemaContext, target: id.ExprId, span: token.Span) {
    if (target == id.EXPR_NIL)     { ret; }
    if (sc.in_deferred_arm)        { ret; }

    var at: token.Span = span;
    if (sc.inst_site_set) { at = sc.inst_site; }
    if (!comptime.is_error_call(sc.a, sc.source, target)) { ret; }
    val res_msg: R.Result[str, comptime.EvalFail] = comptime.error_message[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, target, ?sc.s.interner);
    if (R.is_err[str, comptime.EvalFail](res_msg)) {
        val f: comptime.EvalFail = R.unwrap_err[str, comptime.EvalFail](res_msg);
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?sc.status, f.message); }
        or { context.report(sc, at, f.message); }
        ret;
    }
    context.report(sc, at, R.unwrap_ok[str, comptime.EvalFail](res_msg));
}

fun infer_stmt_comptime_each(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span, fn_ret: type.TypeId) R.Result[R.Void, str] {
    if (!comptime.is_fields_call(sc.a, sc.source, ce.seq)) {
        val seq_ty: type.TypeId = infer.infer_expr(sc, ce.seq);
        val opt_seq: O.Option[*type.Type] = type.get(?sc.s.types, seq_ty);
        if (O.is_some[*type.Type](opt_seq) && O.unwrap[*type.Type](opt_seq).kind == type.TYPE_PACK) {
            ret R.ok_void[str]();
        }
        if (O.is_some[*type.Type](opt_seq) && O.unwrap[*type.Type](opt_seq).kind == type.TYPE_ARRAY) {
            ret infer_const_array_each(sc, ce, span, fn_ret, seq_ty);
        }
        if (seq_ty != type.TYPE_ERROR) {
            context.report(sc, span, "a `$each` sequence must be `$fields(T)`, a variadic pack, or a constant array `val`");
        }
        ret R.ok_void[str]();
    }

    val owner: type.TypeId = infer.field_seq_owner(sc, ce.seq, span);
    if (owner == type.TYPE_ERROR) { ret R.ok_void[str](); }
    if (infer.type_is_generic_param(sc, owner)) { ret R.ok_void[str](); }

    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, ce.var_name);
    if (R.is_err[intern.StrId, str](res_name)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](res_name)); }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    val n: u32 = type.field_count(?sc.s.types, owner);
    var i: u32 = 0;
    for (i < n) {
        val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(sc.ctx);
        if (R.is_err[comptime.FrameMark, str](mark_r)) { ret R.err[R.Void, str](R.unwrap_err[comptime.FrameMark, str](mark_r)); }
        val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);
        val res_bind: R.Result[R.Void, str] = comptime.bind(sc.ctx, fname, comptime.field_value(owner::u32, i));
        if (R.is_err[R.Void, str](res_bind)) {
            val res_close: R.Result[R.Void, str] = comptime.frame_close(sc.ctx, mark);
            if (R.is_err[R.Void, str](res_close)) { ret res_close; }
            ret res_bind;
        }
        val res_body:  R.Result[R.Void, str] = infer_stmt_list(sc, ce.body_start, ce.body_len, fn_ret);
        val res_close: R.Result[R.Void, str] = comptime.frame_close(sc.ctx, mark);
        if (R.is_err[R.Void, str](res_body))  { ret res_body; }
        if (R.is_err[R.Void, str](res_close)) { ret res_close; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun infer_const_array_each(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span, fn_ret: type.TypeId, seq_ty: type.TypeId) R.Result[R.Void, str] {
    val opt_arr: O.Option[*type.Type] = type.get(?sc.s.types, seq_ty);
    if (O.is_none[*type.Type](opt_arr)) { ret R.ok_void[str](); }
    val arr: *type.Type = O.unwrap[*type.Type](opt_arr);
    val elem_ty: type.TypeId = arr.data.array.base;
    val count:   u32         = arr.data.array.count;

    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, ce.seq);
    if (O.is_none[*resolve.Symbol](opt_sym)) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret R.ok_void[str]();
    }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.kind == resolve.SYM_VAR) {
        context.report(sc, span, "a `$each` array sequence must be an immutable `val`; a `var` is not a compile-time-constant sequence");
        ret R.ok_void[str]();
    }
    if (sym.kind != resolve.SYM_VAL && sym.kind != resolve.SYM_IMPORTED) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret R.ok_void[str]();
    }

    val opt_elem: O.Option[*type.Type] = type.get(?sc.s.types, elem_ty);
    if (O.is_some[*type.Type](opt_elem) && O.unwrap[*type.Type](opt_elem).kind == type.TYPE_ARRAY) {
        context.report(sc, span, "a `$each` array element type must be a scalar or record; nested-array elements are not supported");
        ret R.ok_void[str]();
    }

    if (sym.origin == sc.own_module) {
        ret infer_const_array_each_local(sc, ce, span, fn_ret, sym, elem_ty, count);
    }
    ret infer_const_array_each_imported(sc, ce, span, fn_ret, sym, elem_ty, count);
}

fun infer_const_array_each_local(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span,
                                 fn_ret: type.TypeId, sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) R.Result[R.Void, str] {
    val opt_info: O.Option[comptime.ArrayLitInfo] = comptime.decl_array_lit(sc.a, sym.decl);
    if (O.is_none[comptime.ArrayLitInfo](opt_info)) {
        context.report(sc, span, "a `$each` array sequence must be initialized with an array literal");
        ret R.ok_void[str]();
    }
    val info: comptime.ArrayLitInfo = O.unwrap[comptime.ArrayLitInfo](opt_info);
    if (info.elems_len != count) {
        context.report(sc, span, "a `$each` array must be fully initialized: every element needs an initializer");
        ret R.ok_void[str]();
    }

    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, ce.var_name);
    if (R.is_err[intern.StrId, str](res_name)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](res_name)); }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    var i: u32 = 0;
    for (i < count) {
        if ((info.elems_start + i)::usize >= sc.a.expr_id_len) {
            ret R.err[R.Void, str]("sema: `$each` array element index out of range");
        }
        val elem_eid: id.ExprId = sc.a.expr_ids[info.elems_start + i];
        val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(sc.ctx);
        if (R.is_err[comptime.FrameMark, str](mark_r)) { ret R.err[R.Void, str](R.unwrap_err[comptime.FrameMark, str](mark_r)); }
        val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);
        val res_bind: R.Result[R.Void, str] = comptime.bind(sc.ctx, fname, comptime.const_elem_value(elem_eid::u32, elem_ty::u32));
        if (R.is_err[R.Void, str](res_bind)) {
            val res_close: R.Result[R.Void, str] = comptime.frame_close(sc.ctx, mark);
            if (R.is_err[R.Void, str](res_close)) { ret res_close; }
            ret res_bind;
        }
        val res_body:  R.Result[R.Void, str] = infer_stmt_list(sc, ce.body_start, ce.body_len, fn_ret);
        val res_close: R.Result[R.Void, str] = comptime.frame_close(sc.ctx, mark);
        if (R.is_err[R.Void, str](res_body))  { ret res_body; }
        if (R.is_err[R.Void, str](res_close)) { ret res_close; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun infer_const_array_each_imported(sc: *context.SemaContext, ce: *stmt.StmtComptimeEach, span: token.Span,
                                    fn_ret: type.TypeId, sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) R.Result[R.Void, str] {
    val oa: *ast.Ast = session.module_ast(sc.s, sym.origin);
    if (oa == nil) { ret R.err[R.Void, str]("internal: `$each` imported array origin AST unavailable (dependency-ordering invariant violated)"); }
    val orr: *resolve.ResolveResult = (session.module_resolve_ptr(sc.s, sym.origin))::*resolve.ResolveResult;
    val octx: *comptime.ComptimeCtx = (session.module_comptime_ptr(sc.s, sym.origin))::*comptime.ComptimeCtx;
    val osp: ptr = session.module_sema_ptr(sc.s, sym.origin);
    if (osp == nil || orr == nil || octx == nil) { ret R.err[R.Void, str]("internal: `$each` imported array origin sema/resolve/comptime snapshot unavailable (dependency-ordering invariant violated)"); }
    val osr: *context.SemaResult = osp::*context.SemaResult;

    val od_opt: O.Option[*decl.Decl] = ast.get_decl(oa, sym.decl);
    if (O.is_none[*decl.Decl](od_opt)) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret R.ok_void[str]();
    }
    if (O.unwrap[*decl.Decl](od_opt).kind == decl.DECL_KIND_VAR) {
        context.report(sc, span, "a `$each` array sequence must be an immutable `val`; a `var` is not a compile-time-constant sequence");
        ret R.ok_void[str]();
    }
    if (O.unwrap[*decl.Decl](od_opt).kind != decl.DECL_KIND_VAL) {
        context.report(sc, span, "a `$each` array sequence must name an array `val`");
        ret R.ok_void[str]();
    }

    val opt_info: O.Option[comptime.ArrayLitInfo] = comptime.decl_array_lit(oa, sym.decl);
    if (O.is_none[comptime.ArrayLitInfo](opt_info)) {
        context.report(sc, span, "a `$each` array sequence must be initialized with an array literal");
        ret R.ok_void[str]();
    }
    val info: comptime.ArrayLitInfo = O.unwrap[comptime.ArrayLitInfo](opt_info);
    if (info.elems_len != count) {
        context.report(sc, span, "a `$each` array must be fully initialized: every element needs an initializer");
        ret R.ok_void[str]();
    }

    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?sc.s.interner, sc.source, ce.var_name);
    if (R.is_err[intern.StrId, str](res_name)) { ret R.err[R.Void, str](R.unwrap_err[intern.StrId, str](res_name)); }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    var tsc: context.SemaContext;
    tsc.status = fail.accepted();
    fin { fail.merge(?sc.status, tsc.status); }
    tsc.s                = sc.s;
    tsc.a                = oa;
    tsc.rr               = orr;
    tsc.deps             = sc.deps;
    tsc.ctx              = octx;
    val caps_r: R.Result[comptime.PhaseCapabilities[context.SemaContext], str] = semantic_type_caps();
    if (R.is_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r)) {
        ret R.err[R.Void, str](R.unwrap_err[comptime.PhaseCapabilities[context.SemaContext], str](caps_r));
    }
    tsc.caps             = R.unwrap_ok[comptime.PhaseCapabilities[context.SemaContext], str](caps_r);
    tsc.own_module       = sym.origin;
    tsc.source           = source_text_of(sc.s, oa);
    tsc.expr_type        = osr.expr_type;
    tsc.type_resolved_ty = osr.type_resolved_ty;
    tsc.type_resolved_memo = nil;
    tsc.layout_state       = nil;
    tsc.decl_type        = osr.decl_type;
    tsc.callee_eid       = id.EXPR_NIL;
    tsc.in_comptime_gate = false;
    tsc.in_deferred_arm  = false;
    tsc.inst_site_set    = false;
    tsc.in_fin           = false;
    tsc.fin_loop_depth   = 0;
    tsc.subst            = nil;
    tsc.subst_len        = 0;
    tsc.subst_fn         = generics.substitute;
    tsc.insts            = sc.insts;
    tsc.collect_insts    = sc.collect_insts;
    tsc.inst_depth       = sc.inst_depth;
    tsc.inst_parent      = sc.inst_parent;
    tsc.silent           = sc.silent;
    tsc.uni_check_fn     = generics.check_annotation_uni_secrecy;
    tsc.uni_reports      = sc.uni_reports;
    tsc.has_secret       = sc.has_secret;

    var i: u32 = 0;
    var out_err: str = nil;
    for (i < count) {
        if ((info.elems_start + i)::usize >= oa.expr_id_len) {
            out_err = "sema: `$each` array element index out of range";
            brk;
        }
        val elem_eid: id.ExprId = oa.expr_ids[info.elems_start + i];
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](octx, ?tsc, tsc.caps, oa, tsc.source, elem_eid, ?sc.s.interner);
        context.record_eval_result(?tsc, res_eval);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            out_err = R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message;
            brk;
        }
        var ev: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval);
        each_retype_elem_value(sc.s, ?ev, elem_ty);

        val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(sc.ctx);
        if (R.is_err[comptime.FrameMark, str](mark_r)) { ret R.err[R.Void, str](R.unwrap_err[comptime.FrameMark, str](mark_r)); }
        val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);
        val res_bind: R.Result[R.Void, str] = comptime.bind(sc.ctx, fname, ev);
        if (R.is_err[R.Void, str](res_bind)) {
            val res_close_err: R.Result[R.Void, str] = comptime.frame_close(sc.ctx, mark);
            if (R.is_err[R.Void, str](res_close_err)) {
                out_err = R.unwrap_err[R.Void, str](res_close_err);
                brk;
            }
            out_err = R.unwrap_err[R.Void, str](res_bind);
            brk;
        }
        val res_body:  R.Result[R.Void, str] = infer_stmt_list(sc, ce.body_start, ce.body_len, fn_ret);
        val res_close: R.Result[R.Void, str] = comptime.frame_close(sc.ctx, mark);
        if (R.is_err[R.Void, str](res_body)) {
            out_err = R.unwrap_err[R.Void, str](res_body);
            brk;
        }
        if (R.is_err[R.Void, str](res_close)) {
            out_err = R.unwrap_err[R.Void, str](res_close);
            brk;
        }
        i = i + 1;
    }

    if (out_err != nil) { ret R.err[R.Void, str](out_err); }
    ret R.ok_void[str]();
}

fun each_retype_elem_value(s: *session.Session, ev: *comptime.CTValue, elem_ty: type.TypeId) {
    val opt_et: O.Option[*type.Type] = type.get(?s.types, type.strip_secret(?s.types, elem_ty));
    if (O.is_none[*type.Type](opt_et)) { ret; }
    val pd: type.PrimDesc = type.prim_desc(O.unwrap[*type.Type](opt_et).kind);
    if (ev.kind == comptime.CT_KIND_INT && pd.class == type.PRIM_CLASS_INT) {
        ev.int_unsigned = !pd.signed;
        ev.int_width    = pd.bits::u8;
    }
    if (ev.kind == comptime.CT_KIND_FLOAT && pd.class == type.PRIM_CLASS_FLOAT) {
        ev.float_width = pd.bits::float.FloatWidth;
    }
}

fun infer_stmt_list(sc: *context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < len) {
        val sid: id.StmtId = sc.a.stmt_ids[start + i];
        val res_stmt: R.Result[R.Void, str] = infer_stmt(sc, sid, fn_ret);
        if (R.is_err[R.Void, str](res_stmt)) { ret res_stmt; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun gate_probe_ident_is_comptime_param(sc: *context.SemaContext, eid: id.ExprId) bool {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret false; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    ret sym.kind == resolve.SYM_PARAM && (sym.flags & resolve.SYM_FLAG_COMPTIME) != 0;
}

fun gate_probe_is_field_type_operand(sc: *context.SemaContext, eid: id.ExprId) bool {
    ret infer.is_field_type_operand(sc, eid);
}

fun sema_gate_probes() comptime.GateProbes[context.SemaContext] {
    ret comptime.gate_probes[context.SemaContext](
        gate_probe_ident_is_comptime_param, nil, nil, gate_probe_is_field_type_operand);
}

fun gate_chain_depends(sc: *context.SemaContext, probe: comptime.GateProbe,
                       start: u32, len: u32) R.Result[bool, str] {
    ret comptime.gate_chain_depends_on[context.SemaContext](sc.a, sc.source, sc, sema_gate_probes(),
                                                            probe, start, len);
}

fun infer_stmt_comptime_if(sc: *context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) R.Result[R.Void, str] {
    val param_gated_r: R.Result[bool, str] = gate_chain_depends(sc, comptime.GATE_PROBE_COMPTIME_PARAM, start, len);
    if (R.is_err[bool, str](param_gated_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](param_gated_r)); }
    val param_gated: bool = R.unwrap_ok[bool, str](param_gated_r);
    val has_type_cmp_r: R.Result[bool, str] = gate_chain_depends(sc, comptime.GATE_PROBE_TYPE_COMPARISON, start, len);
    if (R.is_err[bool, str](has_type_cmp_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](has_type_cmp_r)); }
    val has_type_cmp: bool = R.unwrap_ok[bool, str](has_type_cmp_r);

    if (has_type_cmp && !param_gated) {
        val pruned_r: R.Result[bool, str] = prune_type_comparison_chain(sc, start, len, fn_ret);
        if (R.is_err[bool, str](pruned_r))    { ret R.err[R.Void, str](R.unwrap_err[bool, str](pruned_r)); }
        if (R.unwrap_ok[bool, str](pruned_r)) { ret R.ok_void[str](); }
    }

    if (param_gated || has_type_cmp) {
        var chain_bad: bool = false;
        var i: u32 = 0;
        for (i < len) {
            val arm: *decl.ComptimeBranch = ?sc.a.comptime_branches[start + i];
            if (arm.cond != id.EXPR_NIL) {
                val saved_gate: bool = sc.in_comptime_gate;
                sc.in_comptime_gate = true;
                val gate_ty: type.TypeId = infer.infer_expr(sc, arm.cond);
                if (gate_ty == type.TYPE_ERROR) { chain_bad = true; }
                or {
                    val gate_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, arm.cond);
                    if (O.is_some[*expr.Expr](gate_opt)
                     && !check.check_condition(sc, gate_ty, O.unwrap[*expr.Expr](gate_opt).span)) { chain_bad = true; }
                }
                sc.in_comptime_gate = saved_gate;
                val cg: R.Result[R.Void, str] = check_comptime_gate(sc, arm.cond);
                if (R.is_err[R.Void, str](cg)) { ret cg; }
            }
            if (!chain_bad) {
                val saved_def: bool = sc.in_deferred_arm;
                sc.in_deferred_arm  = true;
                val res_body: R.Result[R.Void, str] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
                sc.in_deferred_arm  = saved_def;
                if (R.is_err[R.Void, str](res_body)) { ret res_body; }
            }
            i = i + 1;
        }
        ret R.ok_void[str]();
    }

    var i: u32 = 0;
    for (i < len) {
        val br: *decl.ComptimeBranch = ?sc.a.comptime_branches[start + i];

        if (br.cond != id.EXPR_NIL) {
            val saved_gate: bool = sc.in_comptime_gate;
            sc.in_comptime_gate = true;
            val gate_ty: type.TypeId = infer.infer_expr(sc, br.cond);
            if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret R.ok_void[str](); }
            val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, br.cond);
            val gate_ok: bool = O.is_none[*expr.Expr](e_opt)
                || check.check_condition(sc, gate_ty, O.unwrap[*expr.Expr](e_opt).span);
            sc.in_comptime_gate = saved_gate;
            if (!gate_ok) { ret R.ok_void[str](); }
        }

        val active_r: R.Result[bool, str] = stmt_comptime_branch_active(sc, br);
        if (R.is_err[bool, str](active_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](active_r)); }
        if (R.unwrap_ok[bool, str](active_r)) {
            ret infer_stmt_list(sc, br.body_start, br.body_len, fn_ret);
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun stmt_comptime_branch_active(sc: *context.SemaContext, br: *decl.ComptimeBranch) R.Result[bool, str] {
    if (br.cond == id.EXPR_NIL) { ret R.ok[bool, str](true); }
    val vr: R.Result[comptime.GateVerdict, str] = stmt_gate_verdict(sc, br.cond);
    if (R.is_err[comptime.GateVerdict, str](vr)) {
        ret R.err[bool, str](R.unwrap_err[comptime.GateVerdict, str](vr));
    }
    val v: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](vr);
    if (v.outcome == comptime.GATE_FAILED && str_len(v.message) > 0) {
        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        context.report(sc, v.span, v.message);
        sc.in_comptime_gate = saved_gate;
    }
    ret R.ok[bool, str](gate_verdict_truth(v));
}

fun prune_type_comparison_chain(sc: *context.SemaContext, start: u32, len: u32, fn_ret: type.TypeId) R.Result[bool, str] {
    var i: u32 = 0;
    for (i < len) {
        val arm: *decl.ComptimeBranch = ?sc.a.comptime_branches[start + i];
        if (arm.cond == id.EXPR_NIL) {
            val res_body: R.Result[R.Void, str] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (R.is_err[R.Void, str](res_body)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_body)); }
            ret R.ok[bool, str](true);
        }

        val saved_gate: bool = sc.in_comptime_gate;
        sc.in_comptime_gate = true;
        val gate_ty: type.TypeId = infer.infer_expr(sc, arm.cond);
        if (gate_ty == type.TYPE_ERROR) { sc.in_comptime_gate = saved_gate; ret R.ok[bool, str](true); }
        val e_opt: O.Option[*expr.Expr] = ast.get_expr(sc.a, arm.cond);
        val gate_ok: bool = O.is_none[*expr.Expr](e_opt)
            || check.check_condition(sc, gate_ty, O.unwrap[*expr.Expr](e_opt).span);
        sc.in_comptime_gate = saved_gate;
        if (!gate_ok) { ret R.ok[bool, str](true); }

        val vr: R.Result[comptime.GateVerdict, str] = stmt_gate_verdict(sc, arm.cond);
        if (R.is_err[comptime.GateVerdict, str](vr)) {
            ret R.err[bool, str](R.unwrap_err[comptime.GateVerdict, str](vr));
        }
        val v: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](vr);
        if (v.outcome != comptime.GATE_ACTIVE && v.outcome != comptime.GATE_INACTIVE
         && v.outcome != comptime.GATE_AWAITING_TYPES) {
            ret R.ok[bool, str](false);
        }
        if (gate_verdict_truth(v)) {
            val res_body: R.Result[R.Void, str] = infer_stmt_list(sc, arm.body_start, arm.body_len, fn_ret);
            if (R.is_err[R.Void, str](res_body)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_body)); }
            ret R.ok[bool, str](true);
        }
        i = i + 1;
    }
    ret R.ok[bool, str](true);
}

fun check_comptime_gate(sc: *context.SemaContext, eid: id.ExprId) R.Result[R.Void, str] {
    if (eid == id.EXPR_NIL) { ret R.ok_void[str](); }
    val matched_r: R.Result[bool, str] = comptime.gate_walk[context.SemaContext](sc.a, sc.source, sc, gate_operand_check, eid);
    if (R.is_err[bool, str](matched_r)) { ret R.err[R.Void, str](R.unwrap_err[bool, str](matched_r)); }
    ret R.ok_void[str]();
}

fun gate_operand_check(sc: *context.SemaContext, eid: id.ExprId, e: *expr.Expr) comptime.GateNodeVerdict {
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_BINARY) {
        if (comptime.is_type_comparison_binary(sc.a, sc.source, ?e.data.binary,
                infer.is_field_type_operand(sc, e.data.binary.lhs),
                infer.is_field_type_operand(sc, e.data.binary.rhs))) {
            ret comptime.GATE_NODE_PRUNE;
        }
        ret comptime.GATE_NODE_NO;
    }
    if (k == expr.EXPR_KIND_UNARY) {
        if (e.data.unary.op == expr.UN_DEREF || e.data.unary.op == expr.UN_ADDR) {
            context.report(sc, e.span, "comptime `$if` gate is not a compile-time constant");
            ret comptime.GATE_NODE_PRUNE;
        }
        ret comptime.GATE_NODE_NO;
    }

    if (k == expr.EXPR_KIND_CALL
     && (comptime.is_type_query_call(sc.a, sc.source, eid) || comptime.is_layout_intrinsic_call(sc.a, sc.source, eid))) {
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_INDEX) { ret comptime.GATE_NODE_NO; }
    if (k == expr.EXPR_KIND_CAST)  { ret comptime.GATE_NODE_NO; }

    if (k == expr.EXPR_KIND_LIT_INT || k == expr.EXPR_KIND_LIT_FLOAT
     || k == expr.EXPR_KIND_LIT_CHAR || k == expr.EXPR_KIND_LIT_STR) {
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_COMPTIME_IDENT) {
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
        context.record_eval_result(sc, res_eval);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            context.report(sc, e.span, R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message);
        }
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_IDENT) {
        val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
        if (O.is_none[*resolve.Symbol](opt_sym)) { ret comptime.GATE_NODE_PRUNE; }
        val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
        if (resolve.symbol_is_runtime(sym)) {
            if (sym.kind == resolve.SYM_PARAM) {
                check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime parameter '", sym.name, "'", "comptime `$if` gate cannot reference a runtime parameter");
                ret comptime.GATE_NODE_PRUNE;
            }
            check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
            ret comptime.GATE_NODE_PRUNE;
        }
        if (sym.kind == resolve.SYM_PARAM) { ret comptime.GATE_NODE_PRUNE; }
        if (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_IMPORTED) {
            val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
            context.record_eval_result(sc, res_eval);
            if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval) && !check.imported_module_const_sym(sc, sym)) {
                check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
            }
            ret comptime.GATE_NODE_PRUNE;
        }
        check.report_named(sc, e.span, "comptime `$if` gate cannot reference runtime value '", sym.name, "'", "comptime `$if` gate cannot reference a runtime value");
        ret comptime.GATE_NODE_PRUNE;
    }

    if (k == expr.EXPR_KIND_MEMBER) {
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.SemaContext](sc.ctx, sc, sc.caps, sc.a, sc.source, eid, ?sc.s.interner);
        context.record_eval_result(sc, res_eval);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            val opt_sym: O.Option[*resolve.Symbol] = context.symbol_for_expr(sc, eid);
            if (O.is_none[*resolve.Symbol](opt_sym) || !check.imported_module_const_sym(sc, O.unwrap[*resolve.Symbol](opt_sym))) {
                context.report(sc, e.span, "comptime `$if` gate is not a compile-time constant");
            }
        }
        ret comptime.GATE_NODE_PRUNE;
    }

    context.report(sc, e.span, "comptime `$if` gate is not a compile-time constant");
    ret comptime.GATE_NODE_PRUNE;
}

fun infer_local_decl(sc: *context.SemaContext, did: id.DeclId) R.Result[R.Void, str] {
    if (did == id.DECL_NIL) { ret R.ok_void[str](); }
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(sc.a, did);
    if (O.is_none[*decl.Decl](opt_decl)) { ret R.err[R.Void, str]("DeclId out of range"); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) {
        ret R.ok_void[str]();
    }

    val ty: type.TypeId = infer.infer_decl(sc, did);
    if (sc.decl_type != nil) { sc.decl_type[did] = ty; }

    if (type_carries_handle(sc, ty)) {
        context.report(sc, d.span,
            "a handle cannot be a local binding: a local is storage the program owns, and a handle's representation is not the program's, so there is nothing that may be written into it. hand the handle straight to the operation that consumes it instead of naming it first");
    }

    if (type_carries_abi_type(sc, ty)) {
        context.report(sc, d.span, abitype.exclusion_message());
    }

    if (d.data.bind.init != id.EXPR_NIL) {
        val actual: type.TypeId = infer.infer_expr(sc, d.data.bind.init);
        if (d.data.bind.ty != id.TYPE_NIL && ty != type.TYPE_NIL
            && ty != type.TYPE_ERROR && actual != type.TYPE_ERROR) {
            check_binding(sc, ty, d.data.bind.init, actual, d.span);
        }
    }
    ret R.ok_void[str]();
}

fun check_binding(sc: *context.SemaContext, expected: type.TypeId, eid: id.ExprId, actual: type.TypeId, span: token.Span) {
    check.check_coercible(sc, expected, eid, actual, span);
}

fun check_return_stmt(sc: *context.SemaContext, ret_type: type.TypeId, value: id.ExprId, span: token.Span) {
    if (value == id.EXPR_NIL) {
        check.check_return(sc, ret_type, type.TYPE_NIL, span);
        ret;
    }
    val value_ty: type.TypeId = infer.infer_expr(sc, value);
    if (ret_type == type.TYPE_NIL || ret_type == type.TYPE_ERROR
        || value_ty == type.TYPE_ERROR || value_ty == type.TYPE_NIL) {
        check.check_return(sc, ret_type, value_ty, span);
        ret;
    }
    check.check_coercible(sc, ret_type, value, value_ty, span);
}

fun comptime_branch_active(sc: *context.SemaContext, br: *decl.ComptimeBranch) R.Result[bool, str] {
    if (br.cond == id.EXPR_NIL) { ret R.ok[bool, str](true); }
    ret decl_gate_is_active(sc, br.cond);
}

fun build_result(sc: *context.SemaContext) R.Result[context.SemaResult, fail.Fail] {
    if (sc.status.kind == fail.INTERNAL) {
        val f: fail.Fail = fail.phase_failure(sc.status);
        dnit_context(sc);
        ret R.err[context.SemaResult, fail.Fail](f);
    }
    var out: context.SemaResult;
    out.status           = sc.status;
    out.alloc            = sc.s.alloc;
    out.expr_type        = sc.expr_type;
    out.type_resolved_ty = sc.type_resolved_ty;
    out.decl_type        = sc.decl_type;
    out.expr_count       = sc.a.expr_len::u32;
    out.type_count       = sc.a.type_len::u32;
    out.decl_count       = sc.a.decl_len::u32;
    out.embed_paths      = sc.embed_paths;
    out.embed_path_count = sc.embed_path_len;

    sc.expr_type        = nil;
    sc.type_resolved_ty = nil;
    sc.decl_type        = nil;
    out.embed_path_cap  = sc.embed_path_cap;
    sc.embed_paths      = nil;
    sc.embed_path_cap   = 0;
    sc.embed_path_len   = 0;
    dnit_context(sc);

    ret R.ok[context.SemaResult, fail.Fail](out);
}
