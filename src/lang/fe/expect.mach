# `#[expect("<key>", ...)]`: a declaration's acknowledgement of named warnings
#
# type checking validates each `#[expect]` where it stands; this module reads the
# keys back out of a parsed module into the expectations a diagnostic store
# matches warnings against, so a warning replayed from the cache is matched
# exactly as a fresh one is
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:       mach.lang.fe.ast.decl;
use ast_expr:       mach.lang.fe.ast.expr;
use ast_id:         mach.lang.fe.ast.id;
use ast_module:     mach.lang.fe.ast.module;
use comptime_scope: mach.lang.fe.comptime.scope;
use mach.lang.fe.decorator;
use mach.lang.intern;
use mach.lang.session;
use lang_source: mach.lang.source;
use mach.lang.stack;

# the key an argument evaluates to; none when the argument is not a constant string
pub fun key_of(s: *session.Session, ctx: *comptime_scope.ComptimeCtx, eid: ast_id.ExprId) opt[str] {
    val sid: intern.StrId = comptime_scope.decorator_string_at(ctx, eid);
    if (intern.str_is_nil(sid)) { ret opt[str].none{}; }
    ret intern.get(?s.interner, sid);
}

# the span an argument occupies, where a refused or unfulfilled key is reported
pub fun arg_span(a: *ast.Ast, eid: ast_id.ExprId, fallback: lang_source.Span) lang_source.Span {
    val e: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (sel e.none) { ret fallback; }
    ret e.some.span;
}

# where a module's `#[expect]` declarations stand in its syntax, read once per parse so a
# refresh of the diagnostics walks none of the module's declarations
# ---
# syntax:      the parsed module the sites were read from, nil before the first read
# incarnation: that parse's incarnation
# sites:       each declaration that carries `#[expect]`, in source order
# steps:       the `$if` arms each site stands in, outermost first, as the sites' ranges name them
# visited:     the declarations every read has walked, over the module's parses
pub rec Index {
    syntax:      *ast.Ast;
    incarnation: u64;
    sites:       Vector[Site];
    steps:       Vector[Step];
    visited:     u64;
}

# a declaration that carries `#[expect]`, and the run of steps that leads to it
rec Site {
    decl:        ast_id.DeclId;
    steps_start: u32;
    steps_len:   u32;
}

# one arm of a `$if` chain a site stands in
rec Step {
    chain:  ast_id.DeclId;
    branch: u32;
}

pub fun index_dnit(idx: *Index) {
    collections_vector.dnit[Site](?idx.sites);
    collections_vector.dnit[Step](?idx.steps);
    idx.syntax      = nil;
    idx.incarnation = 0;
}

# how many declarations in the module the index holds carry `#[expect]`
pub fun site_count(idx: *Index) usize {
    ret idx.sites.len;
}

# bring the index up to the parsed module `a`, reading its sites when it was read from another
# parse; a failed read leaves it unread, so the next one walks the module again
pub fun index(s: *session.Session, a: *ast.Ast, idx: *Index) err[fail.Fail] {
    if (idx.syntax == a && idx.incarnation == a.incarnation) { ret err[fail.Fail].ok{}; }
    if (idx.sites.a == nil)                                  { idx.sites = collections_vector.init[Site](s.alloc); }
    if (idx.steps.a == nil)                                  { idx.steps = collections_vector.init[Step](s.alloc); }
    collections_vector.clear[Site](?idx.sites);
    collections_vector.clear[Step](?idx.steps);
    idx.syntax = nil;
    var path: Vector[Step] = collections_vector.init[Step](s.alloc);
    fin { collections_vector.dnit[Step](?path); }
    val root: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel root.some) {
        val r: err[fail.Fail] = read_list(s, a, idx, ?path, root.some.decls_start, root.some.decls_len);
        if (sel r.err) {
            collections_vector.clear[Site](?idx.sites);
            collections_vector.clear[Step](?idx.steps);
            ret r;
        }
    }
    idx.syntax      = a;
    idx.incarnation = a.incarnation;
    ret err[fail.Fail].ok{};
}

fun read_list(s: *session.Session, a: *ast.Ast, idx: *Index, path: *Vector[Step], start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= a.decl_ids.len) { ret err[fail.Fail].err{fail.message("expect: declaration index out of range")}; }
        val r: err[fail.Fail] = read_decl(s, a, idx, path, a.decl_ids.data[pool_ix]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun read_decl(s: *session.Session, a: *ast.Ast, idx: *Index, path: *Vector[Step], did: ast_id.DeclId) err[fail.Fail] {
    idx.visited = idx.visited + 1;
    val d_o: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (sel d_o.none) { ret err[fail.Fail].err{fail.message("expect: declaration id out of range")}; }
    val d: *ast_decl.Decl = d_o.some;
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF && stack.exhausted()) {
        val reported: err[fail.Fail] = diagnostic.report(?s.diags, diagnostic_kind.SYNTAX_NESTING_DEPTH, a.file_id, d.span,
            "input nests deeper than gathering `#[expect]` keys descends; the stack has no room left to go deeper");
        if (sel reported.err) { ret reported; }
        ret err[fail.Fail].err{fail.reported()};
    }
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        var b: u32 = 0;
        for (b < d.data.comptime_if.branches_len) {
            val ix: u32 = d.data.comptime_if.branches_start + b;
            if (ix::usize >= a.comptime_branches.len) { ret err[fail.Fail].err{fail.message("expect: comptime branch index out of range")}; }
            val br:     *ast_decl.ComptimeBranch = ?a.comptime_branches.data[ix];
            val pushed: res[usize, A.Error]      = collections_vector.push[Step](path, Step{chain: did, branch: b});
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
            val r: err[fail.Fail] = read_list(s, a, idx, path, br.body_start, br.body_len);
            collections_vector.truncate[Step](path, path.len - 1);
            if (sel r.err) { ret r; }
            b = b + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (!decorator.admits(decorator.EXPECT, d)) { ret err[fail.Fail].ok{}; }
    var carries: bool = false;
    var i:       u32  = 0;
    for (i < d.decorators_len && !carries) {
        if (a.decorators.data[d.decorators_start + i].id == decorator.EXPECT) { carries = true; }
        i = i + 1;
    }
    if (!carries) { ret err[fail.Fail].ok{}; }
    val site: Site  = Site{decl: did, steps_start: idx.steps.len::u32, steps_len: path.len::u32};
    var j:    usize = 0;
    for (j < path.len) {
        val step: res[usize, A.Error] = collections_vector.push[Step](?idx.steps, path.data[j]);
        if (sel step.err) { ret err[fail.Fail].err{fail.refused(step.err)}; }
        j = j + 1;
    }
    val added: res[usize, A.Error] = collections_vector.push[Site](?idx.sites, site);
    if (sel added.err) { ret err[fail.Fail].err{fail.refused(added.err)}; }
    ret err[fail.Fail].ok{};
}

# every `#[expect]` key at the sites the index read from `a`, one expectation each
#
# s:       the session whose interner holds its keys
# a:       the parsed module the index was brought up to
# idx:     the module's index
# ctx:     the comptime scope whose gate decisions say which `$if` branch is taken, over the load's
#          bindings that hold its keys
# checked: the module was type checked this build, or its warnings replayed
# out:     the list the expectations are appended to
pub fun collect(s: *session.Session, a: *ast.Ast, idx: *Index, ctx: *comptime_scope.ComptimeCtx, checked: bool,
    out: *Vector[diagnostic.Expectation]) err[fail.Fail] {
    if (idx.syntax != a || idx.incarnation != a.incarnation) { ret err[fail.Fail].err{fail.message("expect: the index was read from another parse")}; }
    var i: usize = 0;
    for (i < idx.sites.len) {
        val site: *Site = ?idx.sites.data[i];
        var live: bool  = checked;
        var k:    u32   = 0;
        for (live && k < site.steps_len) {
            val taken: res[bool, fail.Fail] = arm_taken(a, ctx, idx.steps.data[site.steps_start + k]);
            if (sel taken.err) { ret err[fail.Fail].err{taken.err}; }
            live = taken.ok;
            k    = k + 1;
        }
        val r: err[fail.Fail] = collect_site(s, a, ctx, live, site.decl, out);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the first arm of a `$if` chain whose gate is decided true is taken, and an undecided gate
# leaves every arm from it on untaken
fun arm_taken(a: *ast.Ast, ctx: *comptime_scope.ComptimeCtx, step: Step) res[bool, fail.Fail] {
    val d_o: opt[*ast_decl.Decl] = ast.get_decl(a, step.chain);
    if (sel d_o.none) { ret res[bool, fail.Fail].err{fail.message("expect: an indexed `$if` chain is not in the parse")}; }
    val d: *ast_decl.Decl = d_o.some;
    var b: u32            = 0;
    for (b <= step.branch) {
        val br: *ast_decl.ComptimeBranch = ?a.comptime_branches.data[d.data.comptime_if.branches_start + b];
        if (ast_id.expr_is_nil(br.cond)) { ret res[bool, fail.Fail].ok{b == step.branch}; }
        val state: comptime_scope.GateState = comptime_scope.gate_state(ctx, br.cond);
        if (state == comptime_scope.GATE_STATE_TRUE)  { ret res[bool, fail.Fail].ok{b == step.branch}; }
        if (state != comptime_scope.GATE_STATE_FALSE) { ret res[bool, fail.Fail].ok{false}; }
        b = b + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun collect_site(s: *session.Session, a: *ast.Ast, ctx: *comptime_scope.ComptimeCtx, live: bool,
    did: ast_id.DeclId, out: *Vector[diagnostic.Expectation]) err[fail.Fail] {
    val d_o: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (sel d_o.none) { ret err[fail.Fail].err{fail.message("expect: declaration id out of range")}; }
    val d: *ast_decl.Decl = d_o.some;

    var start: usize = d.span.offset;
    if (d.doc.len > 0 && d.doc.offset < start) { start = d.doc.offset; }
    val end: usize = d.span.offset + d.span.len;

    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?a.decorators.data[d.decorators_start + i];
        if (dec.id == decorator.EXPECT) {
            var j: u32 = 0;
            for (j < dec.args_len) {
                val eid: ast_id.ExprId = a.expr_ids.data[dec.args_start + j];
                val key: opt[str]      = key_of(s, ctx, eid);
                if (sel key.some) {
                    var picked: diagnostic_kind.Selection = diagnostic_kind.select(key.some);
                    var e:      diagnostic.Expectation;
                    e.file_id   = a.file_id;
                    e.start     = start;
                    e.end       = end;
                    e.key       = arg_span(a, eid, dec.name);
                    e.text      = key.some;
                    e.kinds     = picked.warnings;
                    e.judged    = live && picked.source;
                    e.fulfilled = false;
                    val pushed: res[usize, A.Error] = collections_vector.push[diagnostic.Expectation](out, e);
                    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
