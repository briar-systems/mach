# `#[expect("<key>", ...)]`: a declaration's acknowledgement of named warnings
#
# type checking validates each `#[expect]` where it stands; this module reads the
# keys back out of a parsed module into the expectations a diagnostic store
# matches warnings against, so a warning replayed from the cache is matched
# exactly as a fresh one is
use std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use A: std.allocator;

use mach.lang.diagnostic;
use dkind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.module;
use mach.lang.fe.comptime;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.session;

pub val DIRECTIVE: str = "expect";

# the declaration kinds an `#[expect]` may stand on; a module has no
# declaration of its own, so a module-wide silence is a profile's `allow`
pub fun placement_allowed(k: decl.DeclKind) bool {
    ret k == decl.DECL_KIND_FUN || k == decl.DECL_KIND_REC || k == decl.DECL_KIND_UNI || k == decl.DECL_KIND_TAG
        || k == decl.DECL_KIND_VAL || k == decl.DECL_KIND_VAR || k == decl.DECL_KIND_TEST;
}

pub fun is_expect(source: str, dec: *decl.Decorator) bool {
    ret str_region_equals(source, dec.name.offset, dec.name.len, DIRECTIVE);
}

# the key an argument evaluates to; none when the argument is not a constant string
pub fun key_of(s: *session.Session, mid: session.ModuleId, eid: id.ExprId) opt[str] {
    val sid: opt[intern.StrId] = session.attr_string(s, mid, eid::u32);
    if (sel sid.none) { ret opt[str].none{}; }
    ret intern.lookup(?s.interner, sid.some);
}

# the span an argument occupies, where a refused or unfulfilled key is reported
pub fun arg_span(a: *ast.Ast, eid: id.ExprId, fallback: token.Span) token.Span {
    val e: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (sel e.none) { ret fallback; }
    ret e.some.span;
}

# every `#[expect]` key in the module, one expectation each
#
# a:       the parsed module
# source:  its text
# s:       the session whose attribute strings hold its keys
# mid:     the module
# ctx:     the comptime context whose gate decisions say which `$if` branch is taken
# checked: the module was type checked this build, or its warnings replayed
# out:     the list the expectations are appended to
pub fun collect(s: *session.Session, mid: session.ModuleId, a: *ast.Ast, source: str, ctx: *comptime.ComptimeCtx, checked: bool,
    out: *Vector[diagnostic.Expectation]) err[fail.Fail] {
    val root: opt[*module.Module] = ast.get_module(a, a.root_module);
    if (sel root.none) { ret err[fail.Fail].ok{}; }
    ret collect_list(s, mid, a, source, ctx, checked, root.some.decls_start, root.some.decls_len, out);
}

fun collect_list(s: *session.Session, mid: session.ModuleId, a: *ast.Ast, source: str, ctx: *comptime.ComptimeCtx, live: bool,
    start: u32, len: u32, out: *Vector[diagnostic.Expectation]) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= a.decl_id_len) { ret err[fail.Fail].err{fail.message("expect: declaration index out of range")}; }
        val r: err[fail.Fail] = collect_decl(s, mid, a, source, ctx, live, a.decl_ids[pool_ix], out);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a declaration in an `$if` branch is live only on the branch its gate decided taken
fun collect_decl(s: *session.Session, mid: session.ModuleId, a: *ast.Ast, source: str, ctx: *comptime.ComptimeCtx, live: bool,
    did: id.DeclId, out: *Vector[diagnostic.Expectation]) err[fail.Fail] {
    val d_o: opt[*decl.Decl] = ast.get_decl(a, did);
    if (sel d_o.none) { ret err[fail.Fail].err{fail.message("expect: declaration id out of range")}; }
    val d: *decl.Decl = d_o.some;
    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        # the first branch whose gate is decided true is taken, and an undecided
        # gate leaves every branch from it on untaken
        var open: bool = true;
        var b:    u32  = 0;
        for (b < d.data.comptime_if.branches_len) {
            val ix: u32 = d.data.comptime_if.branches_start + b;
            if (ix::usize >= a.comptime_branch_len) { ret err[fail.Fail].err{fail.message("expect: comptime branch index out of range")}; }
            val br:  *decl.ComptimeBranch = ?a.comptime_branches[ix];
            var now: bool                 = false;
            if (open) {
                if (br.cond == id.EXPR_NIL) { now = true; }
                or {
                    val state: comptime.GateState = comptime.gate_state(ctx, br.cond);
                    if (state == comptime.GATE_STATE_TRUE)  { now = true; }
                    or (state != comptime.GATE_STATE_FALSE) { open = false; }
                }
            }
            val r: err[fail.Fail] = collect_list(s, mid, a, source, ctx, live && now, br.body_start, br.body_len, out);
            if (sel r.err) { ret r; }
            if (now)       { open = false; }
            b = b + 1;
        }
        ret err[fail.Fail].ok{};
    }
    if (!placement_allowed(d.kind)) { ret err[fail.Fail].ok{}; }

    var start: usize = d.span.offset;
    if (d.doc.len > 0 && d.doc.offset < start) { start = d.doc.offset; }
    val end: usize = d.span.offset + d.span.len;

    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?a.decorators[d.decorators_start + i];
        if (is_expect(source, dec)) {
            var j: u32 = 0;
            for (j < dec.args_len) {
                val eid: id.ExprId = a.expr_ids[dec.args_start + j];
                val key: opt[str]  = key_of(s, mid, eid);
                if (sel key.some) {
                    var picked: dkind.Selection = dkind.select(key.some);
                    var e:      diagnostic.Expectation;
                    e.file_id   = a.file_id;
                    e.start     = start;
                    e.end       = end;
                    e.key       = arg_span(a, eid, dec.name);
                    e.text      = key.some;
                    e.kinds     = picked.warnings;
                    e.judged    = live && picked.source;
                    e.fulfilled = false;
                    val pushed: res[usize, A.Error] = vector.push[diagnostic.Expectation](out, e);
                    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}
