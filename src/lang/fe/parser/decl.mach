use mach.lang.fe.ast.id;
use mach.lang.fe.parser.grammar;
use mach.lang.fe.parser.state;

pub fun parse_module(p: *state.Parser) id.ModuleNodeId { ret grammar.parse_module(p); }
pub fun parse_decl(p: *state.Parser) id.DeclId { ret grammar.parse_decl(p); }
pub fun parse_stmt(p: *state.Parser) id.StmtId { ret grammar.parse_stmt(p); }
