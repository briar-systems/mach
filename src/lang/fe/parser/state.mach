use std.allocator.page;
use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use A: std.allocator;
use T: std.allocator.testing;
use O: std.types.option;
use R: std.types.result;

use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.module;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.ast.type;
use mach.lang.fe.lexer;
use mach.lang.fe.pool;
use mach.lang.fe.token;
use src: mach.lang.source;
use mach.lang.validation;

pub def ParseFailKind: u8;

pub val PARSE_FAIL_OOM:  ParseFailKind = 0;
pub val PARSE_FAIL_ICE:  ParseFailKind = 1;
pub val PARSE_FAIL_DIAG: ParseFailKind = 2;
pub val PARSE_FAIL_DEPTH: ParseFailKind = 3;

pub rec ParseFail {
    kind:    ParseFailKind;
    message: str;
}

pub rec Parser {
    tokens:        *lexer.TokenStream;
    pos:           usize;
    ast:           *ast.Ast;
    diags:         *diagnostic.DiagnosticStore;
    status:        fail.PhaseStatus;
    panic:         bool;
    fatal:         bool;
    fatal_kind:    ParseFailKind;
    fatal_message: str;
    no_struct_lit: bool;
    depth:         usize;
    suppressed:    bool;
    probed:        *u8;
    probed_len:    usize;

    pending:     *PendingDiag;
    pending_len: usize;
    pending_cap: usize;
    buffering:   bool;
}

# what a deciding walk said. the walk that decides between the two readings of
# `name[` cannot speak as it goes: if its reading loses, nothing it said was
# ever true. it records here, and whichever reading becomes the parse says what
# it recorded, in order.
pub rec PendingDiag {
    span:    token.Span;
    message: str;
}

# the deepest nesting the parser will descend into. this is the last-resort
# stack guard, not the semantic limit: the recursive-type checker refuses at
# 1024 (REACHES_MAX_DEPTH in fe/sema/infer.mach) with a message that says what
# to do about it, so the parser must sit above that or sema never gets to speak.
# the compiler's own source and the standard library reach 14.
pub val MAX_NEST_DEPTH: usize = 2048;

pub rec ListBuf[T] {
    data: *T;
    len:  usize;
    cap:  usize;
}

val LIST_BUF_SEED_CAP: usize = 8;

pub fun make(tokens: *lexer.TokenStream, out: *ast.Ast, diags: *diagnostic.DiagnosticStore) Parser {
    var p: Parser;
    p.tokens        = tokens;
    p.pos           = 0;
    p.ast           = out;
    p.diags         = diags;
    p.status        = fail.accepted();
    if (tokens.error_len > 0) { fail.reject(?p.status); }
    p.panic         = false;
    p.fatal         = false;
    p.fatal_kind    = PARSE_FAIL_OOM;
    p.fatal_message = nil;
    p.no_struct_lit = false;
    p.depth         = 0;
    p.suppressed    = false;
    p.probed        = nil;
    p.probed_len    = 0;
    p.pending       = nil;
    p.pending_len   = 0;
    p.pending_cap   = 0;
    p.buffering     = false;
    ret p;
}

pub fun current(p: *Parser) token.Token {
    ret p.tokens.tokens[p.pos];
}

pub fun peek(p: *Parser, offset: usize) token.Token {
    val idx: usize = p.pos + offset;
    if (idx >= p.tokens.len) {
        ret p.tokens.tokens[p.tokens.len - 1];
    }
    ret p.tokens.tokens[idx];
}

pub fun advance(p: *Parser) token.Token {
    val t: token.Token = p.tokens.tokens[p.pos];
    if (t.kind != token.KIND_EOF) {
        p.pos = p.pos + 1;
    }
    ret t;
}

pub fun at(p: *Parser, kind: token.Kind) bool {
    ret current(p).kind == kind;
}

pub fun at_kw(p: *Parser, kw: str) bool {
    if (!at(p, token.KIND_IDENT)) { ret false; }
    val t: token.Token = current(p);
    ret str_region_equals(p.tokens.source, t.span.offset, t.span.len, kw);
}

pub fun at_eof(p: *Parser) bool {
    ret at(p, token.KIND_EOF);
}

pub fun at_decl_start(p: *Parser) bool {
    if (at(p, token.KIND_ATTR_OPEN) || at(p, token.KIND_BACKTICK)) { ret true; }
    if (at(p, token.KIND_DOLLAR)) { ret true; }
    if (!at(p, token.KIND_IDENT)) { ret false; }
    ret at_kw(p, token.KW_PUB) || at_kw(p, token.KW_EXT)
     || at_kw(p, token.KW_USE) || at_kw(p, token.KW_FWD) || at_kw(p, token.KW_FUN)
     || at_kw(p, token.KW_REC) || at_kw(p, token.KW_UNI) || at_kw(p, token.KW_VAL)
     || at_kw(p, token.KW_VAR) || at_kw(p, token.KW_DEF) || at_kw(p, token.KW_TEST);
}

pub fun eat(p: *Parser, kind: token.Kind) bool {
    if (at(p, kind)) {
        advance(p);
        ret true;
    }
    ret false;
}

pub fun eat_kw(p: *Parser, kw: str) bool {
    if (at_kw(p, kw)) {
        advance(p);
        ret true;
    }
    ret false;
}

pub fun expect(p: *Parser, kind: token.Kind, message: str) bool {
    if (eat(p, kind)) {
        ret true;
    }
    error_at_current(p, message);
    ret false;
}

pub fun previous(p: *Parser) token.Token {
    ret p.tokens.tokens[p.pos - 1];
}

pub fun expect_end(p: *Parser, kind: token.Kind, message: str) token.Token {
    val candidate: token.Token = current(p);
    if (expect(p, kind, message)) {
        ret candidate;
    }
    ret previous(p);
}

fun set_fatal(p: *Parser, kind: ParseFailKind, span: token.Span, message: str) {
    if (p.fatal) { ret; }
    if (kind == PARSE_FAIL_DEPTH) { fail.reject(?p.status); }
    or { fail.internal(?p.status, message); }
    p.fatal         = true;
    p.fatal_kind    = kind;
    p.fatal_message = message;

    # a fatal parse is discarded whole, so nothing below this point can be
    # published and there is nothing left to read. moving to the end of input
    # is what ends it: every loop above unwinds through its own end-of-input
    # check instead of walking the rest of the file a token at a time.
    p.pos   = p.tokens.len - 1;
    p.panic = true;

    val r: R.Result[R.Void, str] = diagnostic.error(p.diags, p.tokens.file_id, span, message);
    if (R.is_err[R.Void, str](r)) {
        fail.internal(?p.status, R.unwrap_err[R.Void, str](r));
        if (kind == PARSE_FAIL_DEPTH) {
            p.fatal_kind = PARSE_FAIL_DIAG;
            p.fatal_message = R.unwrap_err[R.Void, str](r);
        }
    }
}

pub fun failure(f: ParseFail) fail.Fail {
    if (f.kind == PARSE_FAIL_DEPTH) { ret fail.reported(); }
    ret fail.message(f.message);
}

fun error_at_span(p: *Parser, span: token.Span, message: str) {
    if (p.buffering) {
        pending_push(p, span, message);
        ret;
    }
    fail.reject(?p.status);
    val r: R.Result[R.Void, str] = diagnostic.error(p.diags, p.tokens.file_id, span, message);
    if (R.is_err[R.Void, str](r)) {
        set_fatal(p, PARSE_FAIL_DIAG, span, R.unwrap_err[R.Void, str](r));
    }
}

fun pending_push(p: *Parser, span: token.Span, message: str) {
    if (p.pending_len == p.pending_cap) {
        val g: R.Result[*PendingDiag, str] = pool.grow[PendingDiag](
            p.ast.a, p.pending, p.pending_cap, LIST_BUF_SEED_CAP, ?p.pending_cap);
        if (R.is_err[*PendingDiag, str](g)) {
            p.buffering = false;
            fatal_oom_at(p, span);
            ret;
        }
        p.pending = R.unwrap_ok[*PendingDiag, str](g);
    }
    p.pending[p.pending_len].span    = span;
    p.pending[p.pending_len].message = message;
    p.pending_len = p.pending_len + 1;
}

pub fun diag_mark(p: *Parser) usize { ret p.pending_len; }

pub fun diag_discard(p: *Parser, m: usize) {
    if (m <= p.pending_len) { p.pending_len = m; }
}

# the reading that recorded these is the parse, so they are real. inside an
# enclosing deciding walk they stay in the buffer, because that walk may yet
# lose and take them with it; at the top they go to the sink, in order.
pub fun diag_flush(p: *Parser, m: usize) {
    if (m > p.pending_len) { ret; }
    if (p.buffering)       { ret; }
    var i: usize = m;
    for (i < p.pending_len) {
        error_at_span(p, p.pending[i].span, p.pending[i].message);
        i = i + 1;
    }
    p.pending_len = m;
}

pub fun diag_dnit(p: *Parser, alloc: *A.Allocator) {
    if (p.pending != nil && p.pending_cap > 0) {
        A.deallocate[PendingDiag](alloc, p.pending, p.pending_cap);
    }
    p.pending     = nil;
    p.pending_len = 0;
    p.pending_cap = 0;
}

pub fun error_at_current(p: *Parser, message: str) {
    if (p.panic) { p.suppressed = true; ret; }
    p.panic = true;
    error_at_span(p, current(p).span, message);
}

pub fun error_recover_advance(p: *Parser, message: str) {
    val was_panicking: bool = p.panic;
    error_at_current(p, message);
    if (!was_panicking) { advance(p); }
}

pub fun error_at(p: *Parser, span: token.Span, message: str) {
    if (p.panic) { p.suppressed = true; ret; }
    p.panic = true;
    error_at_span(p, span, message);
}

pub fun fatal_oom_at(p: *Parser, span: token.Span) {
    set_fatal(p, PARSE_FAIL_OOM, span, "out of memory while parsing");
}

pub fun fatal_oom(p: *Parser) {
    fatal_oom_at(p, current(p).span);
}

pub fun fatal_ice_at(p: *Parser, span: token.Span, message: str) {
    set_fatal(p, PARSE_FAIL_ICE, span, message);
}

# a token position where the index reading of `name[` has already been tried
# and did not parse. the verdict is about tokens alone, so it survives any
# rollback, and without it a malformed chain re-derives the same failure at
# every level and doubles with depth.
pub fun probed_init(p: *Parser, alloc: *A.Allocator) {
    p.probed     = nil;
    p.probed_len = 0;
    if (p.tokens == nil || p.tokens.len == 0) { ret; }
    val r: R.Result[*u8, str] = A.allocate[u8](alloc, p.tokens.len);
    if (R.is_err[*u8, str](r)) {
        fatal_oom_at(p, current(p).span);
        ret;
    }
    p.probed     = R.unwrap_ok[*u8, str](r);
    p.probed_len = p.tokens.len;
    var i: usize = 0;
    for (i < p.probed_len) { p.probed[i] = 0; i = i + 1; }
}

pub fun probed_dnit(p: *Parser, alloc: *A.Allocator) {
    if (p.probed != nil && p.probed_len > 0) { A.deallocate[u8](alloc, p.probed, p.probed_len); }
    p.probed     = nil;
    p.probed_len = 0;
}

pub fun index_reading_failed_here(p: *Parser, at: usize) bool {
    if (p.probed == nil || at >= p.probed_len) { ret false; }
    ret p.probed[at] != 0;
}

pub fun record_index_reading_failed(p: *Parser, at: usize) {
    if (p.probed == nil || at >= p.probed_len) { ret; }
    p.probed[at] = 1;
}

pub fun descend(p: *Parser) bool {
    if (p.depth >= MAX_NEST_DEPTH) {
        fatal_depth(p);
        ret false;
    }
    p.depth = p.depth + 1;
    ret true;
}

pub fun ascend(p: *Parser) {
    if (p.depth > 0) { p.depth = p.depth - 1; }
}

fun fatal_depth(p: *Parser) {
    var message: str = "input nests deeper than this parser descends";
    val r: R.Result[str, str] = format.sprint(p.ast.a,
        "input nests deeper than this parser descends; the limit is {} levels",
        MAX_NEST_DEPTH);
    if (!R.is_err[str, str](r)) { message = R.unwrap_ok[str, str](r); }
    set_fatal(p, PARSE_FAIL_DEPTH, current(p).span, message);
}

pub fun ast_mark(p: *Parser) ast.AstMark {
    ret ast.mark(p.ast);
}

pub fun ast_rollback(p: *Parser, m: ast.AstMark) {
    if (!ast.rollback(p.ast, m)) {
        fatal_ice_at(p, current(p).span, "internal compiler error: parser AST rollback mark is invalid");
    }
}

pub fun sync_to(p: *Parser, k0: token.Kind, k1: token.Kind, k2: token.Kind) {
    for (!at(p, token.KIND_EOF)) {
        val k: token.Kind = current(p).kind;
        if (k == k0 || k == k1 || k == k2) {
            p.panic = false;
            ret;
        }
        advance(p);
    }
    p.panic = false;
}

pub fun sync_to_body(p: *Parser, k0: token.Kind, k1: token.Kind, k2: token.Kind) {
    var depth: usize = 0;
    for (!at(p, token.KIND_EOF)) {
        val k: token.Kind = current(p).kind;
        if (depth == 0 && (k == k0 || k == k1 || k == k2)) {
            p.panic = false;
            ret;
        }
        if (k == token.KIND_LBRACE || k == token.KIND_LPAREN || k == token.KIND_LBRACKET) {
            depth = depth + 1;
        }
        or (depth > 0 && (k == token.KIND_RBRACE || k == token.KIND_RPAREN || k == token.KIND_RBRACKET)) {
            depth = depth - 1;
        }
        advance(p);
    }
    p.panic = false;
}

pub fun sync_to_decl(p: *Parser) {
    if (!at_decl_start(p)) { advance(p); }
    for (!at(p, token.KIND_EOF) && !at_decl_start(p)) {
        advance(p);
    }
    p.panic = false;
}

pub fun span_of(start: token.Span, end: token.Span) token.Span {
    var s: token.Span;
    s.offset = start.offset;
    s.len    = (end.offset + end.len) - start.offset;
    ret s;
}

pub fun push_expr(p: *Parser, e: expr.Expr) id.ExprId {
    if (p.fatal) { ret id.EXPR_NIL; }
    val res_add: R.Result[id.ExprId, str] = ast.add_expr(p.ast, e);
    if (R.is_err[id.ExprId, str](res_add)) {
        fatal_oom_at(p, e.span);
        ret id.EXPR_NIL;
    }
    ret R.unwrap_ok[id.ExprId, str](res_add);
}

pub fun push_stmt(p: *Parser, s: stmt.Stmt) id.StmtId {
    if (p.fatal) { ret id.STMT_NIL; }
    val res_add: R.Result[id.StmtId, str] = ast.add_stmt(p.ast, s);
    if (R.is_err[id.StmtId, str](res_add)) {
        fatal_oom_at(p, s.span);
        ret id.STMT_NIL;
    }
    ret R.unwrap_ok[id.StmtId, str](res_add);
}

pub fun push_decl(p: *Parser, d: decl.Decl) id.DeclId {
    if (p.fatal) { ret id.DECL_NIL; }
    val res_add: R.Result[id.DeclId, str] = ast.add_decl(p.ast, d);
    if (R.is_err[id.DeclId, str](res_add)) {
        fatal_oom_at(p, d.span);
        ret id.DECL_NIL;
    }
    ret R.unwrap_ok[id.DeclId, str](res_add);
}

pub fun push_type(p: *Parser, t: type.Type) id.TypeId {
    if (p.fatal) { ret id.TYPE_NIL; }
    val res_add: R.Result[id.TypeId, str] = ast.add_type(p.ast, t);
    if (R.is_err[id.TypeId, str](res_add)) {
        fatal_oom_at(p, t.span);
        ret id.TYPE_NIL;
    }
    ret R.unwrap_ok[id.TypeId, str](res_add);
}

pub fun push_module(p: *Parser, m: module.Module) id.ModuleNodeId {
    if (p.fatal) { ret id.MODULE_NODE_NIL; }
    val res_add: R.Result[id.ModuleNodeId, str] = ast.add_module(p.ast, m);
    if (R.is_err[id.ModuleNodeId, str](res_add)) {
        fatal_oom_at(p, m.span);
        ret id.MODULE_NODE_NIL;
    }
    ret R.unwrap_ok[id.ModuleNodeId, str](res_add);
}

pub fun push_decl_id(p: *Parser, id_: id.DeclId) u32 {
    if (p.fatal) { ret 0; }
    val res_add: R.Result[u32, str] = ast.add_decl_id(p.ast, id_);
    if (R.is_err[u32, str](res_add)) {
        fatal_oom(p);
        ret 0;
    }
    ret R.unwrap_ok[u32, str](res_add);
}

pub fun push_stmt_id(p: *Parser, id_: id.StmtId) u32 {
    if (p.fatal) { ret 0; }
    val res_add: R.Result[u32, str] = ast.add_stmt_id(p.ast, id_);
    if (R.is_err[u32, str](res_add)) {
        fatal_oom(p);
        ret 0;
    }
    ret R.unwrap_ok[u32, str](res_add);
}

pub fun push_expr_id(p: *Parser, id_: id.ExprId) u32 {
    if (p.fatal) { ret 0; }
    val res_add: R.Result[u32, str] = ast.add_expr_id(p.ast, id_);
    if (R.is_err[u32, str](res_add)) {
        fatal_oom(p);
        ret 0;
    }
    ret R.unwrap_ok[u32, str](res_add);
}

pub fun push_type_id(p: *Parser, id_: id.TypeId) u32 {
    if (p.fatal) { ret 0; }
    val res_add: R.Result[u32, str] = ast.add_type_id(p.ast, id_);
    if (R.is_err[u32, str](res_add)) {
        fatal_oom(p);
        ret 0;
    }
    ret R.unwrap_ok[u32, str](res_add);
}

pub fun list_buf_init[T]() ListBuf[T] {
    var b: ListBuf[T];
    b.data = nil;
    b.len  = 0;
    b.cap  = 0;
    ret b;
}

pub fun list_buf_push[T](p: *Parser, b: *ListBuf[T], x: T) {
    if (p.fatal) { ret; }
    if (b.len == b.cap) {
        val res_grow: R.Result[*T, str] = pool.grow[T](p.ast.a, b.data, b.cap, LIST_BUF_SEED_CAP, ?b.cap);
        if (R.is_err[*T, str](res_grow)) {
            fatal_oom(p);
            ret;
        }
        b.data = R.unwrap_ok[*T, str](res_grow);
    }
    b.data[b.len] = x;
    b.len = b.len + 1;
}

pub fun list_buf_free[T](p: *Parser, b: *ListBuf[T]) {
    if (b.data != nil && b.cap > 0) {
        A.deallocate[T](p.ast.a, b.data, b.cap);
    }
    b.data = nil;
    b.len  = 0;
    b.cap  = 0;
}

pub fun decl_id_buf_flush(p: *Parser, b: *ListBuf[id.DeclId], out_len: *u32) u32 {
    val start: u32 = p.ast.decl_id_len::u32;
    var i: usize = 0;
    for (i < b.len && !p.fatal) {
        push_decl_id(p, b.data[i]);
        i = i + 1;
    }
    @out_len = (p.ast.decl_id_len::u32) - start;
    list_buf_free[id.DeclId](p, b);
    ret start;
}

pub fun stmt_id_buf_flush(p: *Parser, b: *ListBuf[id.StmtId], out_len: *u32) u32 {
    val start: u32 = p.ast.stmt_id_len::u32;
    var i: usize = 0;
    for (i < b.len && !p.fatal) {
        push_stmt_id(p, b.data[i]);
        i = i + 1;
    }
    @out_len = (p.ast.stmt_id_len::u32) - start;
    list_buf_free[id.StmtId](p, b);
    ret start;
}

pub fun expr_id_buf_flush(p: *Parser, b: *ListBuf[id.ExprId], out_len: *u32) u32 {
    val start: u32 = p.ast.expr_id_len::u32;
    var i: usize = 0;
    for (i < b.len && !p.fatal) {
        push_expr_id(p, b.data[i]);
        i = i + 1;
    }
    @out_len = (p.ast.expr_id_len::u32) - start;
    list_buf_free[id.ExprId](p, b);
    ret start;
}

pub fun type_id_buf_flush(p: *Parser, b: *ListBuf[id.TypeId], out_len: *u32) u32 {
    val start: u32 = p.ast.type_id_len::u32;
    var i: usize = 0;
    for (i < b.len && !p.fatal) {
        push_type_id(p, b.data[i]);
        i = i + 1;
    }
    @out_len = (p.ast.type_id_len::u32) - start;
    list_buf_free[id.TypeId](p, b);
    ret start;
}

pub fun field_init_buf_flush(p: *Parser, b: *ListBuf[expr.FieldInit], out_len: *u32) u32 {
    val start: u32 = p.ast.field_init_len::u32;
    var i: usize = 0;
    for (i < b.len && !p.fatal) {
        val res_add: R.Result[u32, str] = ast.add_field_init(p.ast, b.data[i]);
        if (R.is_err[u32, str](res_add)) { fatal_oom(p); }
        i = i + 1;
    }
    @out_len = (p.ast.field_init_len::u32) - start;
    list_buf_free[expr.FieldInit](p, b);
    ret start;
}

pub fun typed_name_buf_flush(p: *Parser, b: *ListBuf[decl.TypedName], out_len: *u32) u32 {
    val start: u32 = p.ast.typed_name_len::u32;
    var i: usize = 0;
    for (i < b.len && !p.fatal) {
        val res_add: R.Result[u32, str] = ast.add_typed_name(p.ast, b.data[i]);
        if (R.is_err[u32, str](res_add)) { fatal_oom(p); }
        i = i + 1;
    }
    @out_len = (p.ast.typed_name_len::u32) - start;
    list_buf_free[decl.TypedName](p, b);
    ret start;
}

pub fun comptime_branch_buf_flush(p: *Parser, b: *ListBuf[decl.ComptimeBranch], out_len: *u32) u32 {
    val start: u32 = p.ast.comptime_branch_len::u32;
    var i: usize = 0;
    for (i < b.len && !p.fatal) {
        val res_add: R.Result[u32, str] = ast.add_comptime_branch(p.ast, b.data[i]);
        if (R.is_err[u32, str](res_add)) { fatal_oom(p); }
        i = i + 1;
    }
    @out_len = (p.ast.comptime_branch_len::u32) - start;
    list_buf_free[decl.ComptimeBranch](p, b);
    ret start;
}

fun t_ident_expr() expr.Expr {
    var e: expr.Expr;
    e.span.offset = 0;
    e.span.len    = 1;
    e.kind        = expr.EXPR_KIND_IDENT;
    ret e;
}

test "mach.lang.fe.parser.state.push_expr:no_ops_once_already_fatal" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("1;", ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a:      ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p:      Parser            = make(?stream, ?a, ?diags);

    push_expr(?p, t_ident_expr());
    val len_before: usize = a.expr_len;

    fatal_ice_at(?p, t_ident_expr().span, "test-forced fatal");
    var rc: i32 = 0;
    if (!p.fatal || len_before == 0) { rc = 1; }

    val id_after: id.ExprId = push_expr(?p, t_ident_expr());
    if (id_after != id.EXPR_NIL) { rc = 1; }
    or (a.expr_len != len_before) { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.state.list_buf_push:no_ops_once_already_fatal" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("1;", ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a:      ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p:      Parser            = make(?stream, ?a, ?diags);

    fatal_ice_at(?p, current(?p).span, "test-forced fatal");

    var buf: ListBuf[id.ExprId] = list_buf_init[id.ExprId]();
    list_buf_push[id.ExprId](?p, ?buf, id.EXPR_NIL);
    var rc: i32 = 0;
    if (buf.len != 0 || buf.cap != 0) { rc = 1; }

    list_buf_free[id.ExprId](?p, ?buf);
    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.state.descend:accepts_exactly_the_maximum_and_refuses_one_more" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("1;", ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var out:    ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: Parser = make(?stream, ?out, ?diags);

    var i: usize = 0;
    for (i < MAX_NEST_DEPTH) {
        if (!descend(?p)) { ret 1; }
        i = i + 1;
    }
    if (p.depth != MAX_NEST_DEPTH)        { ret 2; }
    if (descend(?p))                      { ret 3; }
    if (!p.fatal)                         { ret 4; }
    if (p.fatal_kind != PARSE_FAIL_DEPTH) { ret 5; }
    if (!diagnostic.has_errors(?diags))   { ret 6; }

    var j: usize = 0;
    for (j < MAX_NEST_DEPTH) { ascend(?p); j = j + 1; }
    if (p.depth != 0) { ret 7; }
    ascend(?p);
    if (p.depth != 0) { ret 8; }
    ret 0;
}

test "mach.lang.fe.parser.state.ast_rollback:invalid_mark_escalates_to_ice" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("1;", ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a:      ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p:      Parser            = make(?stream, ?a, ?diags);

    val m0: ast.AstMark = ast_mark(?p);
    push_expr(?p, t_ident_expr());
    val m_ahead: ast.AstMark = ast_mark(?p);
    push_expr(?p, t_ident_expr());

    ast_rollback(?p, m0);
    var rc: i32 = 0;
    if (p.fatal) { rc = 1; }

    ast_rollback(?p, m_ahead);
    if (!p.fatal)                       { rc = 1; }
    or (p.fatal_kind != PARSE_FAIL_ICE) { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.state.error_at_current:diagnostic_append_failure_escalates_to_fatal" {
    var backing: A.Allocator;
    page.make(?backing);
    var found: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 32 && !found) {
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("1;", ?backing, 0::src.FileId);
        if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
        var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
        var a:      ast.Ast           = ast.init(?backing, 0::src.FileId);
        var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(T.allocator_of(?failing));
        var p:      Parser            = make(?stream, ?a, ?diags);

        error_at_current(?p, "test diagnostic");
        if (p.fatal && p.fatal_kind == PARSE_FAIL_DIAG) { found = true; }

        diagnostic.store_dnit(?diags);
        ast.dnit(?a);
        lexer.dnit(?stream, ?backing);
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}
