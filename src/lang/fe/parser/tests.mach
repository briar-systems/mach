# parse errors located over whole programs
use std.types.string.str;

use mach.lang.driver.tests.testing.ut_lower_ok;
use mach.lang.driver.tests.testing.ut_sema_rejects_with;

# `:^` and `:^T` are no operator: the parse stops at the colon and the statement's
# terminator check reports it; `:>T` builds
test colon_caret__is_refused_at_the_colon {
    val msg: str = "expected ';' after 'ret'";
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))       { ret 1; }
    if (!ut_sema_rejects_with("fun down(a: ^u32) u32 { ret a:^; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n", msg))          { ret 2; }
    if (!ut_sema_rejects_with("rec K { d: [4]u8; }\nfun down(a: ^K) K { ret a:^K; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n", msg)) { ret 3; }
    if (ut_lower_ok("fun down(a: ^u32) u32 { ret a:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n") != 0)                 { ret 4; }
    ret 0;
}
