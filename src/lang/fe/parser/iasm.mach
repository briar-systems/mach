use std.allocator.page;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.diagnostic;
use mach.lang.fe.ast;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.lexer;
use mach.lang.fe.parser.state;
use mach.lang.fe.token;
use src: mach.lang.source;

pub fun parse_asm(p: *state.Parser) id.StmtId {
    val start: token.Token = state.advance(p);

    var isa: token.Span;
    isa.offset = 0;
    isa.len    = 0;

    if (state.at(p, token.KIND_IDENT)) {
        isa = state.advance(p).span;
    }
    or {
        state.error_at_current(p, "expected ISA tag after 'asm'");
    }

    var body: token.Span;
    body.offset = 0;
    body.len    = 0;
    var end_span: token.Span = start.span;

    if (state.at(p, token.KIND_LBRACE)) {
        val lbrace:     token.Token = state.advance(p);
        val body_start: usize       = lbrace.span.offset + lbrace.span.len;
        collect_body(p, body_start, start.span, ?body, ?end_span);
        seek_to_offset(p, end_span.offset + end_span.len);
    }
    or {
        state.error_at_current(p, "expected '{' to open inline assembly body");
    }

    var asm_stmt: stmt.StmtAsm;
    asm_stmt.isa  = isa;
    asm_stmt.body = body;

    var node: stmt.Stmt;
    node.span      = state.span_of(start.span, end_span);
    node.kind      = stmt.STMT_KIND_ASM;
    node.data.asm_ = asm_stmt;
    ret state.push_stmt(p, node);
}

fun seek_to_offset(p: *state.Parser, offset: usize) {
    for (p.pos < p.tokens.len && p.tokens.tokens[p.pos].span.offset < offset) {
        p.pos = p.pos + 1;
    }
}

fun collect_body(p: *state.Parser, start_offset: usize, asm_span: token.Span, body: *token.Span, end_span: *token.Span) {
    val src: str = p.tokens.source;
    var depth: usize = 1;
    var i:     usize = start_offset;

    for (src[i] != 0) {
        val c: u8 = src[i];
        if (c == '{'::u8) {
            depth = depth + 1;
        }
        or (c == '}'::u8) {
            depth = depth - 1;
            if (depth == 0) {
                body.offset     = start_offset;
                body.len        = i - start_offset;
                end_span.offset = i;
                end_span.len    = 1;
                ret;
            }
        }
        i = i + 1;
    }

    state.error_at(p, asm_span, "unterminated asm body");
    body.offset     = start_offset;
    body.len        = i - start_offset;
    end_span.offset = i;
    end_span.len    = 0;
}

test "mach.lang.fe.parser.iasm.parse_asm:closing_brace_survives_sharing_a_line_with_a_hash" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    val text: str = "asm aarch64 { mov x0, #5 }\nret";
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize(text, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?stream, ?a, ?diags);

    val sid: id.StmtId = parse_asm(?p);

    if (diagnostic.len(?diags) != 0) { bad = 1; }

    val opt_s: O.Option[*stmt.Stmt] = ast.get_stmt(?a, sid);
    if (O.is_none[*stmt.Stmt](opt_s)) { bad = 1; }
    or {
        val s: *stmt.Stmt = O.unwrap[*stmt.Stmt](opt_s);
        val body: token.Span = s.data.asm_.body;
        if (!str_region_equals(text, body.offset, body.len, " mov x0, #5 ")) { bad = 1; }
    }

    if (!state.at_kw(?p, "ret")) { bad = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret bad;
}

test "mach.lang.fe.parser.iasm.parse_asm:unterminated_body_still_reports_at_the_asm_keyword" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var bad: i32 = 0;

    val text: str = "asm aarch64 { mov x0, #5";
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize(text, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?stream, ?a, ?diags);

    parse_asm(?p);

    if (diagnostic.len(?diags) != 1)             { bad = 1; }
    or (diags.items.data[0].loc.span.offset != 0) { bad = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret bad;
}
