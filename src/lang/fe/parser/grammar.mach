use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_expr:   mach.lang.fe.ast.expr;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use ast_stmt:   mach.lang.fe.ast.stmt;
use ast_type:   mach.lang.fe.ast.type;
use mach.lang.fe.comptime.intrinsic;
use mach.lang.fe.decorator;
use fe_lexer:   mach.lang.fe.lexer;
use fe_literal: mach.lang.fe.literal;
use mach.lang.fe.parser.iasm;
use mach.lang.fe.parser.state;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.lexis;
use lang_source: mach.lang.source;
use mach.lang.textbuild;
use mach.lang.wide;
use std.collections.vector.Vector;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_region_equals;

pub fun parse_module(p: *state.Parser) ast_id.ModuleNodeId {
    val start: token.Token = state.current(p);

    var buf: Vector[ast_id.DeclId] = state.list_init[ast_id.DeclId](p);

    for (!state.at_eof(p)) {
        val before: usize         = p.pos;
        val d:      ast_id.DeclId = parse_decl(p);
        if (!ast_id.decl_is_nil(d)) {
            state.list_push[ast_id.DeclId](p, ?buf, d);
        }
        if (p.panic) {
            state.sync_to_decl(p);
        }
        if (p.pos == before && !state.at_eof(p)) { state.advance(p); }
    }

    val end: token.Token = state.current(p);

    var decls_len:   u32 = 0;
    val decls_start: u32 = state.list_flush[ast_id.DeclId](p, ?buf, ?p.ast.decl_ids, ?decls_len);

    var m: ast_module.Module;
    m.span        = state.span_of(start.span, end.span);
    m.doc         = module_doc(p, decls_start, decls_len);
    m.decls_start = decls_start;
    m.decls_len   = decls_len;

    val mid: ast_id.ModuleNodeId = state.push_module(p, m);
    p.ast.root_module = mid;
    ret mid;
}

# the comment run opening the file, unless it is the docstring of the first
# declaration: a `use` or `fwd` has none of its own, so a run directly above
# one still documents the module
fun module_doc(p: *state.Parser, decls_start: u32, decls_len: u32) lang_source.Span {
    val run: lang_source.Span = fe_lexer.leading_run(p.tokens);
    if (run.len == 0 || decls_len == 0) { ret run; }
    val first: opt[*ast_decl.Decl] = ast.get_decl(p.ast, p.ast.decl_ids.data[decls_start]);
    if (!sel first.some) { ret run; }
    val d: *ast_decl.Decl = first.some;
    if (d.doc.len == 0 || d.doc.offset != run.offset)                         { ret run; }
    if (d.kind == ast_decl.DECL_KIND_USE || d.kind == ast_decl.DECL_KIND_FWD) { ret run; }
    var none: lang_source.Span;
    none.offset = 0;
    none.len    = 0;
    ret none;
}

fun parse_decl(p: *state.Parser) ast_id.DeclId {
    if (!state.descend(p)) { ret ast_id.DECL_NIL; }
    val d: ast_id.DeclId = parse_decl_body(p);
    state.ascend(p);
    ret d;
}

fun parse_decl_body(p: *state.Parser) ast_id.DeclId {
    val start: token.Token = state.current(p);

    val doc: lang_source.Span = fe_lexer.doc_run_above(p.tokens, start.span.offset);

    var decorators_len:   u32 = 0;
    val decorators_start: u32 = parse_decorators(p, ?decorators_len);

    val did: ast_id.DeclId = parse_decl_dispatch(p, start.span, decorators_start, decorators_len);

    if (!ast_id.decl_is_nil(did)) {
        val declared: opt[*ast_decl.Decl] = ast.get_decl(p.ast, did);
        if (!sel declared.some) {
            state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
            ret ast_id.DECL_NIL;
        }
        val d: *ast_decl.Decl = declared.some;
        d.doc              = doc;
        d.decorators_start = decorators_start;
        d.decorators_len   = decorators_len;
    }
    ret did;
}

fun parse_decl_dispatch(p: *state.Parser, start: lang_source.Span, dec_start: u32, dec_len: u32) ast_id.DeclId {
    if (state.at(p, token.KIND_DOLLAR)) { ret parse_comptime_decl(p, start); }

    var flags: u8 = parse_flags(p);
    if (p.in_gate_arm) { flags = flags | ast_decl.DECL_FLAG_GATED; }

    if (state.at_kw(p, lexis.KW_USE))  { ret parse_use_decl(p, start, flags); }
    if (state.at_kw(p, lexis.KW_FWD))  { ret parse_fwd_decl(p, start, flags); }
    if (state.at_kw(p, lexis.KW_FUN))  { ret parse_fun_decl(p, start, flags); }
    if (state.at_kw(p, lexis.KW_TAG))  { ret parse_tag_decl(p, start, flags); }
    if (state.at_kw(p, lexis.KW_REC))  { ret parse_rec_uni_decl(p, start, flags, ast_decl.DECL_KIND_REC, "expected record name"); }
    if (state.at_kw(p, lexis.KW_UNI))  { ret parse_rec_uni_decl(p, start, flags, ast_decl.DECL_KIND_UNI, "expected union name"); }
    if (state.at_kw(p, lexis.KW_VAL))  { ret parse_bind_decl(p, start, flags, ast_decl.DECL_KIND_VAL, dec_start, dec_len); }
    if (state.at_kw(p, lexis.KW_VAR))  { ret parse_bind_decl(p, start, flags, ast_decl.DECL_KIND_VAR, dec_start, dec_len); }
    if (state.at_kw(p, lexis.KW_DEF))  { ret parse_def_decl(p, start, flags); }
    if (state.at_kw(p, lexis.KW_TEST)) { ret parse_test_decl(p, start, flags); }

    state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_DECL, "expected a declaration; valid starters: use, fwd, fun, rec, uni, tag, val, var, def, test");
    var failure: ast_decl.Decl;
    failure.span  = start;
    failure.kind  = ast_decl.DECL_KIND_ERROR;
    failure.flags = flags;
    ret state.push_decl(p, failure);
}

fun parse_decorators(p: *state.Parser, out_len: *u32) u32 {
    val start: u32 = p.ast.decorators.len::u32;

    var len: u32 = 0;
    for (state.at(p, token.KIND_DECORATOR_OPEN)) {
        if (!parse_one_decorator(p)) { brk; }
        len = len + 1;
    }
    @out_len = len;
    ret start;
}

fun parse_one_decorator(p: *state.Parser) bool {
    state.advance(p);

    if (!state.at(p, token.KIND_IDENT)) {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, "expected decorator name after '#['");
        ret false;
    }
    var name: lang_source.Span = state.advance(p).span;
    # a dotted name, as the `gpu.` set spells, is one name only where nothing stands between its words
    for (state.at(p, token.KIND_DOT) && state.current(p).span.offset == name.offset + name.len) {
        val dot:  lang_source.Span = state.current(p).span;
        val next: token.Token      = state.peek(p, 1);
        if (next.kind != token.KIND_IDENT || next.span.offset != dot.offset + dot.len) { brk; }
        state.advance(p);
        val word: lang_source.Span = state.advance(p).span;
        name.len = word.offset + word.len - name.offset;
    }

    var args_start: u32 = 0;
    var args_len:   u32 = 0;
    if (state.at(p, token.KIND_LPAREN)) {
        args_start = parse_decorator_args(p, ?args_len);
    }

    if (!state.expect(p, token.KIND_RBRACKET, "expected closing ']' to end decorator")) {
        ret false;
    }

    var d: ast_decl.Decorator;
    d.name       = name;
    d.id         = decorator.id_of(p.tokens.source, name);
    d.args_start = args_start;
    d.args_len   = args_len;

    val res_add: res[u32, fail.Fail] = ast.add_decorator(p.ast, d);
    if (sel res_add.err) {
        state.fatal_oom_at(p, name);
        ret false;
    }
    ret true;
}

fun parse_decorator_args(p: *state.Parser, out_len: *u32) u32 {
    state.advance(p);

    var buf: Vector[ast_id.ExprId] = state.list_init[ast_id.ExprId](p);
    if (!state.at(p, token.KIND_RPAREN)) {
        state.list_push[ast_id.ExprId](p, ?buf, parse_expr(p));
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RPAREN)) { brk; }
            state.list_push[ast_id.ExprId](p, ?buf, parse_expr(p));
        }
    }
    state.expect(p, token.KIND_RPAREN, "expected ')' to close decorator arguments");

    ret state.list_flush[ast_id.ExprId](p, ?buf, ?p.ast.expr_ids, out_len);
}

fun parse_stmt(p: *state.Parser) ast_id.StmtId {
    if (!state.descend(p)) { ret ast_id.STMT_NIL; }
    val s: ast_id.StmtId = parse_stmt_body(p);
    state.ascend(p);
    ret s;
}

fun parse_stmt_body(p: *state.Parser) ast_id.StmtId {
    val start: token.Token = state.current(p);

    if (state.at(p, token.KIND_DECORATOR_OPEN))                       { ret parse_decorated_stmt(p); }
    if (state.at(p, token.KIND_LBRACE))                               { ret parse_block_stmt(p); }
    if (state.at_kw(p, lexis.KW_IF))                                  { ret parse_if_stmt(p, start.span); }
    if (state.at_kw(p, lexis.KW_FOR))                                 { ret parse_for_stmt(p, start.span); }
    if (state.at_kw(p, lexis.KW_RET))                                 { ret parse_ret_stmt(p, start.span); }
    if (at_bare_kw_stmt(p, lexis.KW_BRK))                             { ret parse_brk_stmt(p, start.span); }
    if (at_bare_kw_stmt(p, lexis.KW_CNT))                             { ret parse_cnt_stmt(p, start.span); }
    if (state.at_kw(p, lexis.KW_FIN))                                 { ret parse_fin_stmt(p, start.span); }
    if (state.at_kw(p, lexis.KW_ASM))                                 { ret iasm.parse_asm(p); }
    if (state.at_kw(p, lexis.KW_VAL) || state.at_kw(p, lexis.KW_VAR)) { ret parse_local_decl_stmt(p, start.span); }

    if (state.at(p, token.KIND_DOLLAR) && peek_is_kw(p, 1, lexis.KW_IF)) {
        ret parse_comptime_if_stmt(p, start.span);
    }
    if (state.at(p, token.KIND_DOLLAR) && peek_is_kw(p, 1, lexis.KW_EACH)) {
        ret parse_comptime_each_stmt(p, start.span);
    }
    if (state.at(p, token.KIND_DOLLAR) && peek_is_kw(p, 1, lexis.KW_ERROR)) {
        ret parse_comptime_directive_stmt(p, start.span);
    }

    ret parse_expr_stmt(p, start.span);
}

# decorators attach only to module-level declarations. each one on a local
# statement is refused by name and dropped, and the statement it precedes is
# read as if it stood bare, so what follows still reports
fun parse_decorated_stmt(p: *state.Parser) ast_id.StmtId {
    val m:     ast.AstMark = state.ast_mark(p);
    var len:   u32         = 0;
    val first: u32         = parse_decorators(p, ?len);
    var i:     u32         = 0;
    for (i < len) {
        state.error_naming(p, diagnostic_kind.DECORATOR_MISPLACED, p.ast.decorators.data[first + i].name,
            "`#[{}]` applies only to module-level declarations, not to a local statement",
            p.ast.decorators.data[first + i].name);
        i = i + 1;
    }
    state.ast_rollback(p, m);
    if (p.panic || state.at(p, token.KIND_RBRACE) || state.at_eof(p)) { ret ast_id.STMT_NIL; }
    ret parse_stmt_body(p);
}

fun parse_comptime_directive_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    val target: ast_id.ExprId = parse_expr_bp(p, 2);
    val end:    token.Token   = state.expect_end(p, token.KIND_SEMI, "expected ';' after comptime directive");

    var directive: ast_stmt.StmtComptimeDirective;
    directive.target = target;

    var node: ast_stmt.Stmt;
    node.span                    = state.span_of(start, end.span);
    node.kind                    = ast_stmt.STMT_KIND_COMPTIME_DIRECTIVE;
    node.data.comptime_directive = directive;
    ret state.push_stmt(p, node);
}

fun parse_flags(p: *state.Parser) u8 {
    var flags: u8 = 0;
    for (true) {
        if (state.eat_kw(p, lexis.KW_PUB)) { flags = flags | ast_decl.DECL_FLAG_PUB; }
        or (state.eat_kw(p, lexis.KW_EXT)) { flags = flags | ast_decl.DECL_FLAG_EXT; }
        or                                 { brk; }
    }
    ret flags;
}

fun parse_dotted_path(p: *state.Parser) lang_source.Span {
    val start: lang_source.Span = state.advance(p).span;
    var last:  lang_source.Span = start;
    for (state.at(p, token.KIND_DOT) && state.peek(p, 1).kind == token.KIND_IDENT) {
        state.advance(p);
        last = state.advance(p).span;
    }
    ret state.span_of(start, last);
}

fun peek_is_kw(p: *state.Parser, offset: usize, kw: str) bool {
    val t: token.Token = state.peek(p, offset);
    if (t.kind != token.KIND_IDENT) { ret false; }
    ret str_region_equals(p.tokens.source, t.span.offset, t.span.len, kw);
}

fun at_bare_kw_stmt(p: *state.Parser, kw: str) bool {
    if (!state.at_kw(p, kw)) { ret false; }
    ret state.peek(p, 1).kind == token.KIND_SEMI;
}

fun parse_required(p: *state.Parser, kind: token.Kind, msg: str) lang_source.Span {
    if (state.at(p, kind)) {
        ret state.advance(p).span;
    }
    state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, msg);
    ret span_empty();
}

fun span_empty() lang_source.Span {
    var sp: lang_source.Span;
    sp.offset = 0;
    sp.len    = 0;
    ret sp;
}

fun parse_alias_path(p: *state.Parser, path_msg: str, semi_msg: str, alias_out: *lang_source.Span, path_out: *lang_source.Span) token.Token {
    var alias: lang_source.Span = span_empty();
    if (state.at(p, token.KIND_IDENT) && state.peek(p, 1).kind == token.KIND_COLON) {
        alias = state.advance(p).span;
        state.advance(p);
    }

    var path: lang_source.Span = span_empty();
    if (state.at(p, token.KIND_IDENT)) {
        path = parse_dotted_path(p);
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_PATH, path_msg);
    }

    val end: token.Token = state.expect_end(p, token.KIND_SEMI, semi_msg);

    @alias_out = alias;
    @path_out  = path;
    ret end;
}

fun parse_use_decl(p: *state.Parser, start: lang_source.Span, flags: u8) ast_id.DeclId {
    state.advance(p);

    var alias: lang_source.Span;
    var path:  lang_source.Span;
    val end:   token.Token = parse_alias_path(p,
        "expected module path after 'use'",
        "expected ';' after 'use' declaration", ?alias, ?path);

    var u: ast_decl.DeclUse;
    u.alias = alias;
    u.path  = path;

    var d: ast_decl.Decl;
    d.span      = state.span_of(start, end.span);
    d.kind      = ast_decl.DECL_KIND_USE;
    d.flags     = flags;
    d.data.use_ = u;
    ret state.push_decl(p, d);
}

fun parse_fwd_decl(p: *state.Parser, start: lang_source.Span, flags: u8) ast_id.DeclId {
    if ((flags & ast_decl.DECL_FLAG_PUB) != 0) {
        state.error_at(p, diagnostic_kind.FWD_PUB, start, "'fwd' always publishes; 'pub fwd' is not allowed");
    }

    state.advance(p);

    var alias: lang_source.Span;
    var path:  lang_source.Span;
    val end:   token.Token = parse_alias_path(p,
        "expected re-export path after 'fwd'",
        "expected ';' after 'fwd' declaration", ?alias, ?path);

    var fwd_d: ast_decl.DeclFwd;
    fwd_d.alias = alias;
    fwd_d.path  = path;

    var d: ast_decl.Decl;
    d.span      = state.span_of(start, end.span);
    d.kind      = ast_decl.DECL_KIND_FWD;
    d.flags     = 0;
    d.data.fwd_ = fwd_d;
    ret state.push_decl(p, d);
}

fun parse_fun_decl(p: *state.Parser, start: lang_source.Span, flags: u8) ast_id.DeclId {
    state.advance(p);

    val name: lang_source.Span = parse_required(p, token.KIND_IDENT, "expected function name");

    val gen_start: u32 = p.ast.generic_names.len::u32;
    val gen_len:   u32 = parse_generic_params(p);

    var params_start: u32  = 0;
    var c_variadic:   bool = false;
    val params_len:   u32  = parse_fun_params(p, ?params_start,
        (flags & ast_decl.DECL_FLAG_EXT) != 0, ?c_variadic);

    var ret_type: ast_id.TypeId = ast_id.TYPE_NIL;
    if (!state.at(p, token.KIND_LBRACE) && !state.at(p, token.KIND_SEMI)) {
        ret_type = parse_type(p);
    }

    var placeholder: ast_decl.Decl;
    placeholder.span  = start;
    placeholder.kind  = ast_decl.DECL_KIND_FUN;
    placeholder.flags = flags;
    val did: ast_id.DeclId = state.push_decl(p, placeholder);
    if (ast_id.decl_is_nil(did)) { ret ast_id.DECL_NIL; }

    var body: ast_id.StmtId    = ast_id.STMT_NIL;
    var end:  lang_source.Span = name;
    if (state.at(p, token.KIND_LBRACE)) {
        body = parse_block_stmt(p);
        if (!ast_id.stmt_is_nil(body)) {
            val statement: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, body);
            if (!sel statement.some) {
                state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
                ret ast_id.DECL_NIL;
            }
            end = statement.some.span;
        }
    }
    or {
        val semi: token.Token = state.current(p);
        state.expect(p, token.KIND_SEMI, "expected '{' or ';' after function signature");
        end = semi.span;
    }

    var f: ast_decl.DeclFun;
    f.name           = name;
    f.generics_start = gen_start;
    f.generics_len   = gen_len;
    f.params_start   = params_start;
    f.params_len     = params_len;
    f.return_type    = ret_type;
    f.body           = body;
    f.c_variadic     = c_variadic;

    var d: ast_decl.Decl;
    d.span      = state.span_of(start, end);
    d.kind      = ast_decl.DECL_KIND_FUN;
    d.flags     = flags;
    d.data.fun_ = f;

    val declared: opt[*ast_decl.Decl] = ast.get_decl(p.ast, did);
    if (!sel declared.some) {
        state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
        ret ast_id.DECL_NIL;
    }
    @declared.some = d;
    ret did;
}

fun parse_rec_uni_decl(p: *state.Parser, start: lang_source.Span, flags: u8, kind: ast_decl.DeclKind, name_msg: str) ast_id.DeclId {
    state.advance(p);

    val name: lang_source.Span = parse_required(p, token.KIND_IDENT, name_msg);

    val gen_start: u32 = p.ast.generic_names.len::u32;
    val gen_len:   u32 = parse_generic_params(p);

    var fields_start: u32 = 0;
    val fields_len:   u32 = parse_rec_fields(p, ?fields_start);

    var end_span: lang_source.Span = name;
    if (p.pos > 0) {
        end_span = p.tokens.tokens[p.pos - 1].span;
    }

    var d: ast_decl.Decl;
    d.span  = state.span_of(start, end_span);
    d.kind  = kind;
    d.flags = flags;
    if (kind == ast_decl.DECL_KIND_REC) {
        var r: ast_decl.DeclRec;
        r.name           = name;
        r.generics_start = gen_start;
        r.generics_len   = gen_len;
        r.fields_start   = fields_start;
        r.fields_len     = fields_len;
        d.data.rec_      = r;
    }
    or {
        var u: ast_decl.DeclUni;
        u.name           = name;
        u.generics_start = gen_start;
        u.generics_len   = gen_len;
        u.fields_start   = fields_start;
        u.fields_len     = fields_len;
        d.data.uni_      = u;
    }
    ret state.push_decl(p, d);
}

fun parse_tag_decl(p: *state.Parser, start: lang_source.Span, flags: u8) ast_id.DeclId {
    state.advance(p);
    val name:           lang_source.Span = parse_required(p, token.KIND_IDENT, "expected tag name");
    val generics_start: u32              = p.ast.generic_names.len::u32;
    val generics_len:   u32              = parse_generic_params(p);
    var disc:           ast_id.TypeId    = ast_id.TYPE_NIL;
    if (state.eat(p, token.KIND_COLON)) { disc = parse_type(p); }
    or                                  { state.error_at_current(p, diagnostic_kind.TAG_NO_DISCRIMINATOR, "a tag declaration requires a discriminator type; write `tag Name: u8 { ... }` with `u8`, `u16`, `u32` or `u64`"); }
    state.expect(p, token.KIND_LBRACE, "expected '{' to open tag body");
    var cases: Vector[ast_decl.TagCase] = state.list_init[ast_decl.TagCase](p);
    # a declaration keyword inside the body means the closing brace is missing: stop here so the
    # declaration that follows survives, and let the closing expectation report the brace
    for (!state.at(p, token.KIND_RBRACE) && !state.at_eof(p) && !(state.at_decl_start(p) && !state.at(p, token.KIND_DECORATOR_OPEN))) {
        var member: ast_decl.TagCase;
        member.decorators_start = parse_decorators(p, ?member.decorators_len);
        if (!state.at(p, token.KIND_IDENT)) {
            state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, "expected tag case name");
            state.sync_to(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            state.eat(p, token.KIND_SEMI);
            cnt;
        }
        member.name    = state.advance(p).span;
        member.payload = ast_id.TYPE_NIL;
        if (state.eat(p, token.KIND_COLON)) { member.payload = parse_type(p); }
        state.list_push[ast_decl.TagCase](p, ?cases, member);
        if (!state.expect(p, token.KIND_SEMI, "expected ';' after tag case")) {
            state.sync_to(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            state.eat(p, token.KIND_SEMI);
        }
    }
    val end:  token.Token = state.expect_end(p, token.KIND_RBRACE, "expected '}' to close tag body");
    var body: ast_decl.DeclTag;
    body.name           = name;
    body.generics_start = generics_start;
    body.generics_len   = generics_len;
    body.disc           = disc;
    body.cases_start    = state.list_flush[ast_decl.TagCase](p, ?cases, ?p.ast.tag_cases, ?body.cases_len);
    var d: ast_decl.Decl;
    d.span      = state.span_of(start, end.span);
    d.kind      = ast_decl.DECL_KIND_TAG;
    d.flags     = flags;
    d.data.tag_ = body;
    ret state.push_decl(p, d);
}

fun parse_bind_decl(p: *state.Parser, start: lang_source.Span, flags: u8, kind: ast_decl.DeclKind,
    dec_start: u32, dec_len: u32) ast_id.DeclId {
    state.advance(p);

    val name: lang_source.Span = parse_required(p, token.KIND_IDENT, "expected binding name");

    var ty: ast_id.TypeId = ast_id.TYPE_NIL;
    if (state.eat(p, token.KIND_COLON)) {
        ty = parse_type(p);
    }
    or {
        state.error_at_current(p, diagnostic_kind.BINDING_UNTYPED, "expected ':' and a type; bindings require an explicit type annotation");
    }

    var init: ast_id.ExprId = ast_id.EXPR_NIL;
    if (state.eat(p, token.KIND_EQ)) {
        init = parse_expr(p);
    }
    or (kind == ast_decl.DECL_KIND_VAL && (flags & ast_decl.DECL_FLAG_EXT) == 0 &&
        !decorator.list_has(p.ast, dec_start, dec_len, decorator.EMBED)) {
        state.error_at_current(p, diagnostic_kind.BINDING_VAL_UNINITIALIZED, "'val' requires an initializer");
    }

    val end: token.Token = state.expect_end(p, token.KIND_SEMI, "expected ';' after binding");

    var b: ast_decl.DeclBind;
    b.name = name;
    b.ty   = ty;
    b.init = init;

    var d: ast_decl.Decl;
    d.span      = state.span_of(start, end.span);
    d.kind      = kind;
    d.flags     = flags;
    d.data.bind = b;
    ret state.push_decl(p, d);
}

fun parse_def_decl(p: *state.Parser, start: lang_source.Span, flags: u8) ast_id.DeclId {
    state.advance(p);

    val name: lang_source.Span = parse_required(p, token.KIND_IDENT, "expected type alias name");

    var ty: ast_id.TypeId = ast_id.TYPE_NIL;
    if (state.at(p, token.KIND_COLON)) {
        state.advance(p);
        ty = parse_type(p);
    }

    val end: token.Token = state.expect_end(p, token.KIND_SEMI, "expected ';' after 'def' declaration");

    var def_: ast_decl.DeclDef;
    def_.name = name;
    def_.ty   = ty;

    var d: ast_decl.Decl;
    d.span      = state.span_of(start, end.span);
    d.kind      = ast_decl.DECL_KIND_DEF;
    d.flags     = flags;
    d.data.def_ = def_;
    ret state.push_decl(p, d);
}

fun parse_test_decl(p: *state.Parser, start: lang_source.Span, flags: u8) ast_id.DeclId {
    state.advance(p);

    var name: lang_source.Span = span_empty();
    if (state.at(p, token.KIND_LIT_STR)) {
        state.error_at(p, diagnostic_kind.TEST_STRING_NAME, state.advance(p).span, "a test is named with an identifier, not a string: test <identifier> { ... }");
    }
    or { name = parse_required(p, token.KIND_IDENT, "expected a test name after 'test': test <identifier> { ... }"); }

    var body: ast_id.StmtId    = ast_id.STMT_NIL;
    var end:  lang_source.Span = name;
    if (state.at(p, token.KIND_LBRACE)) {
        body = parse_block_stmt(p);
        if (!ast_id.stmt_is_nil(body)) {
            val statement: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, body);
            if (!sel statement.some) {
                state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
                ret ast_id.DECL_NIL;
            }
            end = statement.some.span;
        }
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected '{' to open test body");
    }

    var t: ast_decl.DeclTest;
    t.name = name;
    t.body = body;

    var d: ast_decl.Decl;
    d.span       = state.span_of(start, end);
    d.kind       = ast_decl.DECL_KIND_TEST;
    d.flags      = flags;
    d.data.test_ = t;
    ret state.push_decl(p, d);
}

fun parse_comptime_decl(p: *state.Parser, start: lang_source.Span) ast_id.DeclId {
    if (peek_is_kw(p, 1, lexis.KW_IF)) { ret parse_comptime_if_decl(p, start); }
    ret parse_comptime_directive_decl(p, start);
}

def ComptimeBodyFn: fun(*state.Parser, *u32, *u32) lang_source.Span;

fun parse_comptime_chain(p: *state.Parser, start: lang_source.Span, parse_body: ComptimeBodyFn, branches_start_out: *u32, branches_len_out: *u32) lang_source.Span {
    var br_buf: Vector[ast_decl.ComptimeBranch] = state.list_init[ast_decl.ComptimeBranch](p);

    state.advance(p);
    state.advance(p);

    var has_more: bool             = true;
    var first:    bool             = true;
    var end:      lang_source.Span = start;

    for (has_more) {
        var cond: ast_id.ExprId = ast_id.EXPR_NIL;
        if (first) {
            state.expect(p, token.KIND_LPAREN, "expected '(' after '$if'");
            cond = parse_expr(p);
            state.expect(p, token.KIND_RPAREN, "expected ')' after '$if' condition");
            first = false;
        }
        or {
            if (state.eat(p, token.KIND_LPAREN)) {
                cond = parse_expr(p);
                state.expect(p, token.KIND_RPAREN, "expected ')' after '$or' condition");
            }
        }

        var body_start: u32 = 0;
        var body_len:   u32 = 0;
        end = parse_body(p, ?body_start, ?body_len);

        var br: ast_decl.ComptimeBranch;
        br.cond       = cond;
        br.body_start = body_start;
        br.body_len   = body_len;
        state.list_push[ast_decl.ComptimeBranch](p, ?br_buf, br);

        if (state.at(p, token.KIND_DOLLAR) && peek_is_kw(p, 1, lexis.KW_OR)) {
            state.advance(p);
            state.advance(p);
            has_more = true;
        }
        or {
            has_more = false;
        }
    }

    var branches_len:   u32 = 0;
    val branches_start: u32 = state.list_flush[ast_decl.ComptimeBranch](p, ?br_buf, ?p.ast.comptime_branches, ?branches_len);
    @branches_start_out = branches_start;
    @branches_len_out   = branches_len;
    ret end;
}

fun parse_comptime_decl_body(p: *state.Parser, body_start_out: *u32, body_len_out: *u32) lang_source.Span {
    var body_buf: Vector[ast_id.DeclId] = state.list_init[ast_id.DeclId](p);

    state.expect(p, token.KIND_LBRACE, "expected '{' to open comptime branch body");
    val outer_gate: bool = p.in_gate_arm;
    p.in_gate_arm = true;
    for (!state.at(p, token.KIND_RBRACE) && !state.at_eof(p)) {
        val d: ast_id.DeclId = parse_decl(p);
        if (!ast_id.decl_is_nil(d)) {
            state.list_push[ast_id.DeclId](p, ?body_buf, d);
        }
        if (p.panic) {
            state.sync_to_body(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            if (state.at(p, token.KIND_SEMI)) { state.advance(p); }
        }
    }
    p.in_gate_arm = outer_gate;
    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close comptime branch body");

    var body_len:   u32 = 0;
    val body_start: u32 = state.list_flush[ast_id.DeclId](p, ?body_buf, ?p.ast.decl_ids, ?body_len);
    @body_start_out = body_start;
    @body_len_out   = body_len;
    ret close.span;
}

fun parse_comptime_stmt_body(p: *state.Parser, body_start_out: *u32, body_len_out: *u32) lang_source.Span {
    var body_buf: Vector[ast_id.StmtId] = state.list_init[ast_id.StmtId](p);

    state.expect(p, token.KIND_LBRACE, "expected '{' to open comptime branch body");
    for (!state.at(p, token.KIND_RBRACE) && !state.at_eof(p)) {
        val s: ast_id.StmtId = parse_stmt(p);
        if (!ast_id.stmt_is_nil(s)) {
            state.list_push[ast_id.StmtId](p, ?body_buf, s);
        }
        if (p.panic) {
            state.sync_to_body(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            if (state.at(p, token.KIND_SEMI)) { state.advance(p); }
        }
    }
    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close comptime branch body");

    var body_len:   u32 = 0;
    val body_start: u32 = state.list_flush[ast_id.StmtId](p, ?body_buf, ?p.ast.stmt_ids, ?body_len);
    @body_start_out = body_start;
    @body_len_out   = body_len;
    ret close.span;
}

fun parse_comptime_if_decl(p: *state.Parser, start: lang_source.Span) ast_id.DeclId {
    var branches_start: u32              = 0;
    var branches_len:   u32              = 0;
    val end:            lang_source.Span = parse_comptime_chain(p, start, parse_comptime_decl_body, ?branches_start, ?branches_len);

    var ci: ast_decl.DeclComptimeIf;
    ci.branches_start = branches_start;
    ci.branches_len   = branches_len;

    var node: ast_decl.Decl;
    node.span             = state.span_of(start, end);
    node.kind             = ast_decl.DECL_KIND_COMPTIME_IF;
    node.flags            = 0;
    node.data.comptime_if = ci;
    ret state.push_decl(p, node);
}

fun parse_comptime_directive_decl(p: *state.Parser, start: lang_source.Span) ast_id.DeclId {
    val target: ast_id.ExprId = parse_expr_bp(p, 2);
    val end:    token.Token   = state.expect_end(p, token.KIND_SEMI, "expected ';' after comptime directive");

    var directive: ast_decl.DeclComptimeDirective;
    directive.target = target;

    var d: ast_decl.Decl;
    d.span                    = state.span_of(start, end.span);
    d.kind                    = ast_decl.DECL_KIND_COMPTIME_DIRECTIVE;
    d.flags                   = 0;
    d.data.comptime_directive = directive;
    ret state.push_decl(p, d);
}

fun parse_generic_params(p: *state.Parser) u32 {
    if (!state.eat(p, token.KIND_LBRACKET)) { ret 0; }

    if (state.at(p, token.KIND_RBRACKET)) {
        state.advance(p);
        ret 0;
    }

    var len: u32 = 0;
    if (parse_generic_param(p)) {
        len = len + 1;
    }
    or {
        state.sync_to(p, token.KIND_RBRACKET, token.KIND_LPAREN, token.KIND_EOF);
        if (state.at(p, token.KIND_RBRACKET)) { state.advance(p); }
        ret len;
    }

    for (state.eat(p, token.KIND_COMMA)) {
        if (state.at(p, token.KIND_RBRACKET)) { brk; }
        if (!parse_generic_param(p))          { brk; }
        len = len + 1;
    }

    state.expect(p, token.KIND_RBRACKET, "expected ']' to close generic parameters");
    ret len;
}

fun parse_generic_param(p: *state.Parser) bool {
    if (!state.at(p, token.KIND_IDENT)) {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, "expected generic parameter name");
        ret false;
    }
    val name:    lang_source.Span    = state.advance(p).span;
    val res_add: res[u32, fail.Fail] = ast.add_generic_name(p.ast, name);
    if (sel res_add.err) {
        state.fatal_oom_at(p, name);
        ret false;
    }
    ret true;
}

fun parse_fun_params(p: *state.Parser, out_start: *u32, allow_c_va: bool, out_c_variadic: *bool) u32 {
    state.expect(p, token.KIND_LPAREN, "expected '(' to open parameter list");

    var buf: Vector[ast_decl.TypedName] = state.list_init[ast_decl.TypedName](p);
    var len: u32                        = 0;
    @out_c_variadic = false;

    if (state.at(p, token.KIND_RPAREN)) {
        state.advance(p);
        @out_start = state.list_flush[ast_decl.TypedName](p, ?buf, ?p.ast.typed_names, ?len);
        ret len;
    }

    if (allow_c_va && state.at(p, token.KIND_DOT_DOT_DOT)) {
        state.error_at_current(p, diagnostic_kind.VARIADIC_NO_FIXED_PARAM, "a C-variadic `ext fun` needs at least one fixed parameter before `...`");
        state.advance(p);
    }
    or (parse_typed_name(p, ?buf, "expected parameter name")) {}
    or {
        state.sync_to(p, token.KIND_RPAREN, token.KIND_LBRACE, token.KIND_EOF);
        if (state.at(p, token.KIND_RPAREN)) { state.advance(p); }
        @out_start = state.list_flush[ast_decl.TypedName](p, ?buf, ?p.ast.typed_names, ?len);
        ret len;
    }

    for (state.eat(p, token.KIND_COMMA)) {
        if (state.at(p, token.KIND_RPAREN)) { brk; }
        if (allow_c_va && state.at(p, token.KIND_DOT_DOT_DOT)) {
            @out_c_variadic = true;
            state.advance(p);
            brk;
        }
        if (!parse_typed_name(p, ?buf, "expected parameter name")) { brk; }
    }

    state.expect(p, token.KIND_RPAREN, "expected ')' to close parameter list");
    @out_start = state.list_flush[ast_decl.TypedName](p, ?buf, ?p.ast.typed_names, ?len);
    ret len;
}

fun parse_rec_fields(p: *state.Parser, out_start: *u32) u32 {
    state.expect(p, token.KIND_LBRACE, "expected '{' to open record body");

    var buf: Vector[ast_decl.TypedName] = state.list_init[ast_decl.TypedName](p);
    var len: u32                        = 0;

    for (!state.at(p, token.KIND_RBRACE) && !state.at_eof(p)) {
        if (!parse_typed_name(p, ?buf, "expected field name")) {
            state.sync_to(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            if (state.at(p, token.KIND_SEMI)) { state.advance(p); }
            cnt;
        }
        state.expect(p, token.KIND_SEMI, "expected ';' after record field");
    }

    state.expect(p, token.KIND_RBRACE, "expected '}' to close record body");
    @out_start = state.list_flush[ast_decl.TypedName](p, ?buf, ?p.ast.typed_names, ?len);
    ret len;
}

fun parse_typed_name(p: *state.Parser, buf: *Vector[ast_decl.TypedName], missing_name_msg: str) bool {
    var comptime: bool = false;
    if (state.eat(p, token.KIND_DOLLAR)) {
        comptime = true;
    }

    if (!state.at(p, token.KIND_IDENT)) {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, missing_name_msg);
        ret false;
    }
    val name: lang_source.Span = state.advance(p).span;
    if (!state.expect(p, token.KIND_COLON, "expected ':' between name and type")) { ret false; }
    val ty: ast_id.TypeId = parse_type(p);

    var tn: ast_decl.TypedName;
    tn.name     = name;
    tn.ty       = ty;
    tn.comptime = comptime;
    state.list_push[ast_decl.TypedName](p, buf, tn);
    ret true;
}

fun parse_block_stmt(p: *state.Parser) ast_id.StmtId {
    val start: token.Token = state.current(p);
    state.expect(p, token.KIND_LBRACE, "expected '{' to open block");

    var buf: Vector[ast_id.StmtId] = state.list_init[ast_id.StmtId](p);

    for (!state.at(p, token.KIND_RBRACE) && !state.at_eof(p)) {
        val s: ast_id.StmtId = parse_stmt(p);
        if (!ast_id.stmt_is_nil(s)) {
            state.list_push[ast_id.StmtId](p, ?buf, s);
        }
        if (p.panic) {
            state.sync_to_body(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            if (state.at(p, token.KIND_SEMI)) { state.advance(p); }
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close block");

    var stmts_len:   u32 = 0;
    val stmts_start: u32 = state.list_flush[ast_id.StmtId](p, ?buf, ?p.ast.stmt_ids, ?stmts_len);

    var block: ast_stmt.StmtBlock;
    block.stmts_start = stmts_start;
    block.stmts_len   = stmts_len;

    var node: ast_stmt.Stmt;
    node.span       = state.span_of(start.span, close.span);
    node.kind       = ast_stmt.STMT_KIND_BLOCK;
    node.data.block = block;
    ret state.push_stmt(p, node);
}

fun parse_if_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    state.advance(p);
    state.expect(p, token.KIND_LPAREN, "expected '(' after 'if'");
    val cond: ast_id.ExprId = parse_expr(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' after 'if' condition");

    var then_block: ast_id.StmtId = ast_id.STMT_NIL;
    if (state.at(p, token.KIND_LBRACE)) {
        then_block = parse_block_stmt(p);
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected '{' to open 'if' body");
    }

    var else_block: ast_id.StmtId = ast_id.STMT_NIL;
    if (state.at_kw(p, lexis.KW_OR)) {
        else_block = parse_or_chain(p);
    }

    var if_: ast_stmt.StmtIf;
    if_.cond       = cond;
    if_.then_block = then_block;
    if_.else_block = else_block;

    var end_span: lang_source.Span = start;
    if (!ast_id.stmt_is_nil(else_block)) {
        val statement: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, else_block);
        if (!sel statement.some) {
            state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
            ret ast_id.STMT_NIL;
        }
        end_span = statement.some.span;
    }
    or (!ast_id.stmt_is_nil(then_block)) {
        val statement_2: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, then_block);
        if (!sel statement_2.some) {
            state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
            ret ast_id.STMT_NIL;
        }
        end_span = statement_2.some.span;
    }

    var node: ast_stmt.Stmt;
    node.span     = state.span_of(start, end_span);
    node.kind     = ast_stmt.STMT_KIND_IF;
    node.data.if_ = if_;
    ret state.push_stmt(p, node);
}

fun parse_or_chain(p: *state.Parser) ast_id.StmtId {
    val start: token.Token = state.current(p);
    state.advance(p);

    if (state.at(p, token.KIND_LBRACE)) {
        ret parse_block_stmt(p);
    }

    state.expect(p, token.KIND_LPAREN, "expected '(' after 'or'");
    val cond: ast_id.ExprId = parse_expr(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' after 'or' condition");

    var then_block: ast_id.StmtId = ast_id.STMT_NIL;
    if (state.at(p, token.KIND_LBRACE)) {
        then_block = parse_block_stmt(p);
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected '{' to open 'or' body");
    }

    var else_block: ast_id.StmtId = ast_id.STMT_NIL;
    if (state.at_kw(p, lexis.KW_OR)) {
        else_block = parse_or_chain(p);
    }

    var if_: ast_stmt.StmtIf;
    if_.cond       = cond;
    if_.then_block = then_block;
    if_.else_block = else_block;

    var end_span: lang_source.Span = start.span;
    if (!ast_id.stmt_is_nil(else_block)) {
        val statement: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, else_block);
        if (!sel statement.some) {
            state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
            ret ast_id.STMT_NIL;
        }
        end_span = statement.some.span;
    }
    or (!ast_id.stmt_is_nil(then_block)) {
        val statement_2: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, then_block);
        if (!sel statement_2.some) {
            state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
            ret ast_id.STMT_NIL;
        }
        end_span = statement_2.some.span;
    }

    var node: ast_stmt.Stmt;
    node.span     = state.span_of(start.span, end_span);
    node.kind     = ast_stmt.STMT_KIND_IF;
    node.data.if_ = if_;
    ret state.push_stmt(p, node);
}

fun parse_for_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    state.advance(p);

    var cond: ast_id.ExprId = ast_id.EXPR_NIL;
    if (state.eat(p, token.KIND_LPAREN)) {
        cond = parse_expr(p);
        state.expect(p, token.KIND_RPAREN, "expected ')' after 'for' condition");
    }

    var body:     ast_id.StmtId    = ast_id.STMT_NIL;
    var end_span: lang_source.Span = start;
    if (state.at(p, token.KIND_LBRACE)) {
        body = parse_block_stmt(p);
        if (!ast_id.stmt_is_nil(body)) {
            val statement: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, body);
            if (!sel statement.some) {
                state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
                ret ast_id.STMT_NIL;
            }
            end_span = statement.some.span;
        }
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected '{' to open 'for' body");
    }

    var for_: ast_stmt.StmtFor;
    for_.cond = cond;
    for_.body = body;

    var node: ast_stmt.Stmt;
    node.span      = state.span_of(start, end_span);
    node.kind      = ast_stmt.STMT_KIND_FOR;
    node.data.for_ = for_;
    ret state.push_stmt(p, node);
}

fun parse_ret_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    state.advance(p);

    var value: ast_id.ExprId = ast_id.EXPR_NIL;
    if (!state.at(p, token.KIND_SEMI) && !state.at_eof(p)) {
        value = parse_expr(p);
    }

    val end: token.Token = state.expect_end(p, token.KIND_SEMI, "expected ';' after 'ret'");

    var ret_: ast_stmt.StmtRet;
    ret_.value = value;

    var node: ast_stmt.Stmt;
    node.span      = state.span_of(start, end.span);
    node.kind      = ast_stmt.STMT_KIND_RET;
    node.data.ret_ = ret_;
    ret state.push_stmt(p, node);
}

fun parse_brk_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    state.advance(p);
    val end: token.Token = state.expect_end(p, token.KIND_SEMI, "expected ';' after 'brk'");

    var node: ast_stmt.Stmt;
    node.span = state.span_of(start, end.span);
    node.kind = ast_stmt.STMT_KIND_BRK;
    ret state.push_stmt(p, node);
}

fun parse_cnt_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    state.advance(p);
    val end: token.Token = state.expect_end(p, token.KIND_SEMI, "expected ';' after 'cnt'");

    var node: ast_stmt.Stmt;
    node.span = state.span_of(start, end.span);
    node.kind = ast_stmt.STMT_KIND_CNT;
    ret state.push_stmt(p, node);
}

fun parse_fin_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    state.advance(p);

    var body_id: ast_id.StmtId = ast_id.STMT_NIL;
    if (state.at(p, token.KIND_LBRACE)) {
        body_id = parse_block_stmt(p);
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected '{' to open 'fin' body");
    }

    var end_span: lang_source.Span = start;
    if (!ast_id.stmt_is_nil(body_id)) {
        val statement: opt[*ast_stmt.Stmt] = ast.get_stmt(p.ast, body_id);
        if (!sel statement.some) {
            state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
            ret ast_id.STMT_NIL;
        }
        end_span = statement.some.span;
    }

    var fin_s: ast_stmt.StmtFin;
    fin_s.body = body_id;

    var node: ast_stmt.Stmt;
    node.span      = state.span_of(start, end_span);
    node.kind      = ast_stmt.STMT_KIND_FIN;
    node.data.fin_ = fin_s;
    ret state.push_stmt(p, node);
}

fun parse_local_decl_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    # a body's own declarations are never module declarations, so no gate around the body gates them
    val outer_gate: bool = p.in_gate_arm;
    p.in_gate_arm = false;
    val d: ast_id.DeclId = parse_decl(p);
    p.in_gate_arm = outer_gate;

    var sd: ast_stmt.StmtDecl;
    sd.decl = d;

    var end_span: lang_source.Span = start;
    if (!ast_id.decl_is_nil(d)) {
        val declared: opt[*ast_decl.Decl] = ast.get_decl(p.ast, d);
        if (!sel declared.some) {
            state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
            ret ast_id.STMT_NIL;
        }
        end_span = declared.some.span;
    }

    var node: ast_stmt.Stmt;
    node.span      = state.span_of(start, end_span);
    node.kind      = ast_stmt.STMT_KIND_DECL;
    node.data.decl = sd;
    ret state.push_stmt(p, node);
}

fun parse_expr_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    val expr_id: ast_id.ExprId = parse_expr(p);
    val end:     token.Token   = state.expect_end(p, token.KIND_SEMI, "expected ';' after expression statement");

    var se: ast_stmt.StmtExpr;
    se.expr = expr_id;

    var node: ast_stmt.Stmt;
    node.span      = state.span_of(start, end.span);
    node.kind      = ast_stmt.STMT_KIND_EXPR;
    node.data.expr = se;
    ret state.push_stmt(p, node);
}

fun parse_comptime_each_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    state.expect(p, token.KIND_DOLLAR, "expected '$' to open a comptime $each");
    state.eat_kw(p, lexis.KW_EACH);

    val var_tok: token.Token = state.current(p);
    state.expect(p, token.KIND_IDENT, "expected a loop variable name after '$each'");
    if (!state.eat_kw(p, lexis.KW_IN)) {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected 'in' after the $each loop variable");
    }

    val saved_nsl: bool = p.no_struct_lit;
    p.no_struct_lit = true;
    val seq: ast_id.ExprId = parse_expr(p);
    p.no_struct_lit = saved_nsl;

    var body_start: u32              = 0;
    var body_len:   u32              = 0;
    val end:        lang_source.Span = parse_comptime_stmt_body(p, ?body_start, ?body_len);

    var ce: ast_stmt.StmtComptimeEach;
    ce.var_name   = var_tok.span;
    ce.seq        = seq;
    ce.body_start = body_start;
    ce.body_len   = body_len;

    var node: ast_stmt.Stmt;
    node.span               = state.span_of(start, end);
    node.kind               = ast_stmt.STMT_KIND_COMPTIME_EACH;
    node.data.comptime_each = ce;
    ret state.push_stmt(p, node);
}

fun parse_comptime_if_stmt(p: *state.Parser, start: lang_source.Span) ast_id.StmtId {
    var branches_start: u32              = 0;
    var branches_len:   u32              = 0;
    val end:            lang_source.Span = parse_comptime_chain(p, start, parse_comptime_stmt_body, ?branches_start, ?branches_len);

    var ci: ast_stmt.StmtComptimeIf;
    ci.branches_start = branches_start;
    ci.branches_len   = branches_len;

    var node: ast_stmt.Stmt;
    node.span             = state.span_of(start, end);
    node.kind             = ast_stmt.STMT_KIND_COMPTIME_IF;
    node.data.comptime_if = ci;
    ret state.push_stmt(p, node);
}

fun parse_expr(p: *state.Parser) ast_id.ExprId {
    ret parse_expr_bp(p, 0);
}

fun parse_expr_bp(p: *state.Parser, min_bp: u8) ast_id.ExprId {
    var lhs: ast_id.ExprId = parse_prefix(p);
    lhs = parse_postfix(p, lhs);

    for (!state.at_eof(p)) {
        val op_tok: token.Token = state.current(p);
        val op_bp:  u8          = token.infix_precedence(op_tok.kind);
        if (op_bp == 0)     { brk; }
        if (op_bp < min_bp) { brk; }

        state.advance(p);

        var right_bp: u8 = op_bp + 1;
        if (token.is_right_assoc(op_tok.kind)) { right_bp = op_bp; }

        val rhs: ast_id.ExprId = parse_expr_bp(p, right_bp);

        val op_o: opt[ast_expr.BinOp] = bin_op_from_kind(op_tok.kind);
        if (sel op_o.none) {
            # the parser owns no interner, so the text is static and names the catalog
            state.fatal_ice_at(p, op_tok.span, "unknown token.Kind in the infix operator table");
            ret lhs;
        }
        var bin: ast_expr.ExprBinary;
        bin.op  = op_o.some;
        bin.lhs = lhs;
        bin.rhs = rhs;

        var node: ast_expr.Expr;
        node.span        = span_of_expr_pair(p, lhs, rhs);
        node.kind        = ast_expr.EXPR_KIND_BINARY;
        node.data.binary = bin;
        lhs              = state.push_expr(p, node);
    }

    ret lhs;
}

fun at_type_start(p: *state.Parser) bool {
    ret state.at(p, token.KIND_CARET)
        || state.at(p, token.KIND_STAR)
        || state.at(p, token.KIND_LBRACKET)
        || state.at_kw(p, lexis.KW_FUN)
        || state.at_kw(p, lexis.KW_REC)
        || state.at_kw(p, lexis.KW_UNI)
        || state.at(p, token.KIND_DOT_DOT_DOT)
        || state.at(p, token.KIND_DOLLAR)
        || state.at(p, token.KIND_IDENT);
}

fun parse_type(p: *state.Parser) ast_id.TypeId {
    if (!state.descend(p)) { ret ast_id.TYPE_NIL; }
    val t: ast_id.TypeId = parse_type_body(p);
    state.ascend(p);
    ret t;
}

fun parse_type_body(p: *state.Parser) ast_id.TypeId {
    val start: token.Token = state.current(p);

    if (state.at(p, token.KIND_CARET))    { ret parse_secret(p, start.span); }
    if (state.at(p, token.KIND_STAR))     { ret parse_ptr(p, start.span); }
    if (state.at(p, token.KIND_LBRACKET)) { ret parse_array(p, start.span); }
    if (state.at_kw(p, lexis.KW_FUN))     { ret parse_fun(p, start.span); }
    if (state.at_kw(p, lexis.KW_REC))     { ret parse_rec_or_uni(p, start.span, ast_type.TYPE_KIND_REC); }
    if (state.at_kw(p, lexis.KW_UNI))     { ret parse_rec_or_uni(p, start.span, ast_type.TYPE_KIND_UNI); }

    if (state.at(p, token.KIND_DOT_DOT_DOT)) {
        state.advance(p);
        var pk: ast_type.Type;
        pk.span = start.span;
        pk.kind = ast_type.TYPE_KIND_PACK;
        ret state.push_type(p, pk);
    }

    if (state.at(p, token.KIND_DOLLAR)) { ret parse_pointee_of(p, start.span); }

    if (at_field_type_spelling(p)) { ret parse_field_type_arg(p); }

    if (state.at(p, token.KIND_IDENT)) { ret parse_named(p, start.span); }

    state.error_recover_advance(p, diagnostic_kind.SYNTAX_EXPECTED_TYPE, "expected a type; named, '*T', '[N]T', '$pointee_of(T)', '$discriminant_of(T)', 'fun(...)', or inline 'rec'/'uni' forms are valid here");
    var t: ast_type.Type;
    t.span = start.span;
    t.kind = ast_type.TYPE_KIND_ERROR;
    ret state.push_type(p, t);
}

fun parse_prefix(p: *state.Parser) ast_id.ExprId {
    if (!state.descend(p)) { ret ast_id.EXPR_NIL; }
    val e: ast_id.ExprId = parse_prefix_body(p);
    state.ascend(p);
    ret e;
}

fun parse_prefix_body(p: *state.Parser) ast_id.ExprId {
    val t: token.Token = state.current(p);

    if (t.kind == token.KIND_LIT_INT)   { ret parse_lit_int(p); }
    if (t.kind == token.KIND_LIT_FLOAT) { ret parse_lit_float(p); }
    if (t.kind == token.KIND_LIT_CHAR)  { ret parse_lit_char(p); }
    if (t.kind == token.KIND_LIT_STR)   { ret parse_lit_str(p); }

    if (t.kind == token.KIND_MINUS)    { ret parse_unary(p, ast_expr.UN_NEG); }
    if (t.kind == token.KIND_BANG)     { ret parse_unary(p, ast_expr.UN_NOT); }
    if (t.kind == token.KIND_TILDE)    { ret parse_unary(p, ast_expr.UN_BIT_NOT); }
    if (t.kind == token.KIND_QUESTION) { ret parse_unary(p, ast_expr.UN_ADDR); }
    if (t.kind == token.KIND_AT)       { ret parse_unary(p, ast_expr.UN_DEREF); }

    if (t.kind == token.KIND_LPAREN)   { ret parse_paren(p); }
    if (t.kind == token.KIND_DOLLAR)   { ret parse_comptime_ident(p); }
    if (t.kind == token.KIND_LBRACKET) { ret parse_array_literal(p); }

    if (t.kind == token.KIND_IDENT) {
        if (state.at_kw(p, lexis.KW_SEL))                    { ret parse_sel(p); }
        if (state.at_kw(p, lexis.KW_NIL))                    { ret parse_lit_nil(p); }
        if (!p.no_struct_lit && looks_like_typed_literal(p)) { ret parse_typed_literal(p); }
        ret parse_ident(p);
    }

    state.error_recover_advance(p, diagnostic_kind.SYNTAX_EXPECTED_EXPR, "expected an expression; literals, identifiers, '(', and unary operators are valid here");
    var node: ast_expr.Expr;
    node.span = t.span;
    node.kind = ast_expr.EXPR_KIND_ERROR;
    ret state.push_expr(p, node);
}

fun parse_postfix(p: *state.Parser, base: ast_id.ExprId) ast_id.ExprId {
    var lhs: ast_id.ExprId = base;
    for (true) {
        val k: token.Kind = state.current(p).kind;
        if (k == token.KIND_LPAREN) { lhs = parse_call(p, lhs, 0, 0, ast_id.EXPR_NIL); }
        or (k == token.KIND_LBRACKET) {
            val after: usize = scan_bracket_close(p, 0);
            if (after != 0 && state.peek(p, after).kind == token.KIND_LPAREN) {
                lhs = parse_bracket_call(p, lhs);
            }
            or {
                lhs = parse_bracket_value(p, lhs);
            }
        }
        or (k == token.KIND_DOT) {
            if (state.peek(p, 1).kind == token.KIND_LBRACKET) {
                lhs = parse_project(p, lhs);
            }
            or {
                lhs = parse_member(p, lhs);
            }
        }
        or (k == token.KIND_COLON_COLON) { lhs = parse_cast(p, lhs, false); }
        or (k == token.KIND_COLON_TILDE) { lhs = parse_cast(p, lhs, true); }
        or (k == token.KIND_COLON_GT)    { lhs = parse_strip(p, lhs); }
        or {
            brk;
        }
    }
    ret lhs;
}

fun scan_bracket_close(p: *state.Parser, bracket_off: usize) usize {
    var i:     usize = bracket_off + 1;
    var depth: usize = 1;
    for (depth > 0) {
        val k: token.Kind = state.peek(p, i).kind;
        if (k == token.KIND_EOF || k == token.KIND_SEMI) { ret 0; }
        if (k == token.KIND_LBRACKET)                    { depth = depth + 1; }
        or (k == token.KIND_RBRACKET)                    { depth = depth - 1; }
        i = i + 1;
    }
    ret i;
}

fun token_begins_expr(k: token.Kind) bool {
    ret k == token.KIND_LIT_INT || k == token.KIND_LIT_FLOAT
        || k == token.KIND_LIT_CHAR || k == token.KIND_LIT_STR
        || k == token.KIND_IDENT || k == token.KIND_DOLLAR
        || k == token.KIND_MINUS || k == token.KIND_BANG
        || k == token.KIND_TILDE || k == token.KIND_QUESTION
        || k == token.KIND_AT || k == token.KIND_LPAREN
        || k == token.KIND_LBRACKET;
}

rec IndexReading {
    expr:  ast_id.ExprId;
    count: ast_id.ExprId;
    end:   usize;
    clean: bool;
    diags: usize;
    mark:  ast.AstMark;
    held:  bool;
    panic: bool;
}

rec TypeArgList {
    ok:    bool;
    start: u32;
    len:   u32;
    close: lang_source.Span;
}

fun parse_bracket_call(p: *state.Parser, callee: ast_id.ExprId) ast_id.ExprId {
    var idx: IndexReading;
    probe_index_payload(p, ?idx);
    var targs: TypeArgList;
    parse_type_args_once(p, ?targs);

    if (targs.ok) {
        drop_index_reading(p, ?idx);
        var index_callee: ast_id.ExprId = ast_id.EXPR_NIL;
        if (idx.clean) { index_callee = make_index(p, callee, idx.expr, idx.count); }
        ret parse_call(p, callee, targs.start, targs.len, index_callee);
    }
    ret take_index_reading(p, callee, ?idx);
}

fun parse_bracket_value(p: *state.Parser, object: ast_id.ExprId) ast_id.ExprId {
    val open: lang_source.Span = state.current(p).span;
    var idx:  IndexReading;
    probe_index_payload(p, ?idx);
    var targs: TypeArgList;
    parse_type_args_once(p, ?targs);

    if (!targs.ok) {
        ret take_index_reading(p, object, ?idx);
    }

    drop_index_reading(p, ?idx);
    val start_span: lang_source.Span = expr_span_or(p, object, open);

    var index_callee: ast_id.ExprId = ast_id.EXPR_NIL;
    if (idx.clean) { index_callee = make_index(p, object, idx.expr, idx.count); }

    var call: ast_expr.ExprCall;
    call.callee          = object;
    call.args_start      = 0;
    call.args_len        = 0;
    call.type_args_start = targs.start;
    call.type_args_len   = targs.len;
    call.index_callee    = index_callee;

    var node: ast_expr.Expr;
    node.span      = state.span_of(start_span, targs.close);
    node.kind      = ast_expr.EXPR_KIND_GENERIC_INSTANCE;
    node.data.call = call;
    ret state.push_expr(p, node);
}

# reads the payload as an index expression, or as the start and count of a
# range (`x[i, n]`). it is the parse that would happen
# if this reading wins, not a rehearsal of it: panic is left alone so error
# recovery moves the cursor exactly as it would, and what it says goes to the
# buffer rather than the sink until a reading is chosen.
fun probe_index_payload(p: *state.Parser, out: *IndexReading) {
    out.expr  = ast_id.EXPR_NIL;
    out.count = ast_id.EXPR_NIL;
    out.end   = p.pos;
    out.clean = false;
    out.diags = state.diag_mark(p);
    out.held  = false;
    out.panic = p.panic;
    if (!token_begins_expr(state.peek(p, 1).kind)) { ret; }
    if (state.index_reading_failed_here(p, p.pos)) { ret; }

    val m:              ast.AstMark = state.ast_mark(p);
    val save_pos:       usize       = p.pos;
    val save_panic:     bool        = p.panic;
    val save_buffering: bool        = p.buffering;
    p.buffering = true;
    state.advance(p);
    val before: usize         = p.pos;
    val e:      ast_id.ExprId = parse_expr(p);
    var count:  ast_id.ExprId = ast_id.EXPR_NIL;
    if (state.eat(p, token.KIND_COMMA)) { count = parse_expr(p); }
    val quiet: bool = state.diag_mark(p) == out.diags;
    val clean: bool = p.pos > before && !p.fatal && state.at(p, token.KIND_RBRACKET)
        && quiet;
    out.expr    = e;
    out.count   = count;
    out.end     = p.pos;
    out.clean   = clean;
    out.mark    = m;
    out.held    = true;
    out.panic   = p.panic;
    p.pos       = save_pos;
    p.panic     = save_panic;
    p.buffering = save_buffering;

    if (!clean) { state.record_index_reading_failed(p, save_pos); }
}

# the type reading won, so the index reading never happened: drop what it said
# and, unless its nodes are the ones the generic instance points at, drop those.
fun drop_index_reading(p: *state.Parser, idx: *IndexReading) {
    state.diag_discard(p, idx.diags);
}

# the index reading is the parse. it already walked the payload, so say what it
# said and finish from where it stopped.
fun take_index_reading(p: *state.Parser, object: ast_id.ExprId, idx: *IndexReading) ast_id.ExprId {
    if (!idx.held) {
        state.diag_discard(p, idx.diags);
        ret parse_index(p, object);
    }
    p.pos   = idx.end;
    p.panic = idx.panic;
    state.diag_flush(p, idx.diags);
    ret close_index(p, object, idx.expr, idx.count);
}

fun parse_type_args_once(p: *state.Parser, out: *TypeArgList) {
    out.ok    = false;
    out.start = 0;
    out.len   = 0;
    out.close = state.current(p).span;

    val m:               ast.AstMark = state.ast_mark(p);
    val save_pos:        usize       = p.pos;
    val save_panic:      bool        = p.panic;
    val save_suppressed: bool        = p.suppressed;
    p.panic      = true;
    p.suppressed = false;
    state.advance(p);

    var buf:    Vector[ast_id.TypeId] = state.list_init[ast_id.TypeId](p);
    var parsed: bool                  = false;
    if (!state.at(p, token.KIND_RBRACKET)) {
        val before: usize = p.pos;
        state.list_push[ast_id.TypeId](p, ?buf, parse_type_arg(p));
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RBRACKET)) { brk; }
            state.list_push[ast_id.TypeId](p, ?buf, parse_type_arg(p));
        }
        parsed = p.pos > before && !p.fatal && state.at(p, token.KIND_RBRACKET)
            && !p.suppressed;
    }

    if (!parsed) {
        state.list_free[ast_id.TypeId](p, ?buf);
        p.pos        = save_pos;
        p.panic      = save_panic;
        p.suppressed = save_suppressed;
        state.ast_rollback(p, m);
        ret;
    }

    out.close = state.current(p).span;
    state.advance(p);
    p.panic      = save_panic;
    p.suppressed = save_suppressed;

    var len: u32 = 0;
    out.start = state.list_flush[ast_id.TypeId](p, ?buf, ?p.ast.type_ids, ?len);
    out.len   = len;
    out.ok    = true;
}

fun parse_type_arg(p: *state.Parser) ast_id.TypeId {
    if (at_field_type_arg(p)) { ret parse_field_type_arg(p); }
    ret parse_type(p);
}

fun make_index(p: *state.Parser, object: ast_id.ExprId, index: ast_id.ExprId, count: ast_id.ExprId) ast_id.ExprId {
    var node_index: ast_expr.ExprIndex;
    node_index.object = object;
    node_index.index  = index;
    node_index.count  = count;

    val cur:        lang_source.Span = state.current(p).span;
    val start_span: lang_source.Span = expr_span_or(p, object, cur);
    var last:       ast_id.ExprId    = index;
    if (!ast_id.expr_is_nil(count)) { last = count; }
    val end_span: lang_source.Span = expr_span_or(p, last, start_span);

    var node: ast_expr.Expr;
    node.span       = state.span_of(start_span, end_span);
    node.kind       = ast_expr.EXPR_KIND_INDEX;
    node.data.index = node_index;
    ret state.push_expr(p, node);
}

fun parse_lit_int(p: *state.Parser) ast_id.ExprId {
    val t:    token.Token = state.advance(p);
    var node: ast_expr.Expr;
    node.span             = t.span;
    node.kind             = ast_expr.EXPR_KIND_LIT_INT;
    node.data.lit_int.tok = t.span;
    val res_int: res[fe_literal.Int, fe_literal.Refusal] = fe_literal.int_scan(p.tokens.source, t.span);
    if (sel res_int.err) {
        state.error_at(p, res_int.err.diag, t.span, res_int.err.message);
        node.data.lit_int.value  = wide.zero();
        node.data.lit_int.suffix = ast_expr.LIT_SUFFIX_NONE;
    }
    or (sel res_int.ok) {
        val lit: fe_literal.Int = res_int.ok;
        node.data.lit_int.value  = lit.value;
        node.data.lit_int.suffix = lit.suffix;
    }
    ret state.push_expr(p, node);
}

fun parse_lit_float(p: *state.Parser) ast_id.ExprId {
    val t:    token.Token = state.advance(p);
    var node: ast_expr.Expr;
    node.span               = t.span;
    node.kind               = ast_expr.EXPR_KIND_LIT_FLOAT;
    node.data.lit_float.tok = t.span;
    val res_float: res[fe_literal.Float, fe_literal.Refusal] = fe_literal.float_scan(p.tokens.source, t.span);
    if (sel res_float.err) {
        state.error_at(p, res_float.err.diag, t.span, res_float.err.message);
        node.data.lit_float.value  = 0.0;
        node.data.lit_float.suffix = ast_expr.LIT_SUFFIX_NONE;
    }
    or (sel res_float.ok) {
        val lit: fe_literal.Float = res_float.ok;
        node.data.lit_float.value  = lit.value;
        node.data.lit_float.suffix = lit.suffix;
    }
    ret state.push_expr(p, node);
}

fun parse_lit_char(p: *state.Parser) ast_id.ExprId {
    val t:    token.Token = state.advance(p);
    var node: ast_expr.Expr;
    node.span              = t.span;
    node.kind              = ast_expr.EXPR_KIND_LIT_CHAR;
    node.data.lit_char.tok = t.span;
    val res_char: res[u8, fe_literal.Refusal] = fe_literal.char_scan(p.tokens.source, t.span);
    if (sel res_char.err) {
        state.error_at(p, res_char.err.diag, t.span, res_char.err.message);
        node.data.lit_char.value = 0;
    }
    if (sel res_char.ok) { node.data.lit_char.value = res_char.ok::u32; }
    ret state.push_expr(p, node);
}

fun parse_lit_str(p: *state.Parser) ast_id.ExprId {
    val t:    token.Token = state.advance(p);
    var node: ast_expr.Expr;
    node.span             = t.span;
    node.kind             = ast_expr.EXPR_KIND_LIT_STR;
    node.data.lit_str.tok = t.span;
    if (p.fatal) { ret ast_id.EXPR_NIL; }
    val room: res[*u8, fail.Fail] = ast.literal_bytes_reserve(p.ast, t.span.len);
    if (sel room.err) {
        state.fatal_oom_at(p, t.span);
        ret ast_id.EXPR_NIL;
    }
    val res_str: res[usize, fe_literal.Refusal] = fe_literal.str_scan(p.tokens.source, t.span, room.ok);
    if (sel res_str.err) {
        state.error_at(p, res_str.err.diag, t.span, res_str.err.message);
        node.data.lit_str.value = ast.literal_bytes_take(p.ast, 0);
    }
    or (sel res_str.ok) { node.data.lit_str.value = ast.literal_bytes_take(p.ast, res_str.ok); }
    ret state.push_expr(p, node);
}

fun parse_lit_nil(p: *state.Parser) ast_id.ExprId {
    val t:    token.Token = state.advance(p);
    var node: ast_expr.Expr;
    node.span             = t.span;
    node.kind             = ast_expr.EXPR_KIND_LIT_NIL;
    node.data.lit_nil.tok = t.span;
    ret state.push_expr(p, node);
}

fun parse_ident(p: *state.Parser) ast_id.ExprId {
    val t:    token.Token = state.advance(p);
    var node: ast_expr.Expr;
    node.span            = t.span;
    node.kind            = ast_expr.EXPR_KIND_IDENT;
    node.data.ident.tok  = t.span;
    node.data.ident.name = state.name_id(p, t.span);
    ret state.push_expr(p, node);
}

fun parse_comptime_ident(p: *state.Parser) ast_id.ExprId {
    val dollar: token.Token      = state.advance(p);
    var end:    lang_source.Span = dollar.span;
    if (state.at(p, token.KIND_IDENT)) {
        end = state.advance(p).span;
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, "expected an identifier after '$'");
    }

    var node: ast_expr.Expr;
    node.span                     = state.span_of(dollar.span, end);
    node.kind                     = ast_expr.EXPR_KIND_COMPTIME_IDENT;
    node.data.comptime_ident.tok  = node.span;
    node.data.comptime_ident.name = intern.STR_NIL;
    ret state.push_expr(p, node);
}

fun parse_unary(p: *state.Parser, op: ast_expr.UnOp) ast_id.ExprId {
    val start:   token.Token   = state.advance(p);
    var operand: ast_id.ExprId = parse_prefix(p);
    operand = parse_postfix(p, operand);

    var unary: ast_expr.ExprUnary;
    unary.op      = op;
    unary.operand = operand;

    val end_span: lang_source.Span = expr_span_or(p, operand, start.span);

    var node: ast_expr.Expr;
    node.span       = state.span_of(start.span, end_span);
    node.kind       = ast_expr.EXPR_KIND_UNARY;
    node.data.unary = unary;
    ret state.push_expr(p, node);
}

# `sel place.case` binds tighter than every binary operator and looser than postfix
fun parse_sel(p: *state.Parser) ast_id.ExprId {
    val start:   token.Token   = state.advance(p);
    var operand: ast_id.ExprId = parse_prefix(p);
    operand = parse_postfix(p, operand);

    var node: ast_expr.Expr;
    node.span = state.span_of(start.span, expr_span_or(p, operand, start.span));
    node.kind = ast_expr.EXPR_KIND_SEL;

    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(p.ast, operand);
    if (sel e_opt.some) {
        if (e_opt.some.kind == ast_expr.EXPR_KIND_PROJECT) {
            val proj: *ast_expr.Expr = e_opt.some;
            node.data.sel = ast_expr.ExprSel{place: proj.data.project.object, case_name: lang_source.Span{offset: proj.span.offset, len: 0},
                case_id: intern.STR_NIL, case_desc: proj.data.project.field};
            ret state.push_expr(p, node);
        }
    }
    if (!sel e_opt.some) {
        state.error_at(p, diagnostic_kind.SEL_NOT_A_CASE, node.span, "`sel` tests one case of a place: write `sel place.case` or `sel place.[case]`");
        node.kind = ast_expr.EXPR_KIND_ERROR;
        ret state.push_expr(p, node);
    }
    if (e_opt.some.kind != ast_expr.EXPR_KIND_MEMBER) {
        state.error_at(p, diagnostic_kind.SEL_NOT_A_CASE, node.span, "`sel` tests one case of a place: write `sel place.case` or `sel place.[case]`");
        node.kind = ast_expr.EXPR_KIND_ERROR;
        ret state.push_expr(p, node);
    }
    val member: *ast_expr.Expr = e_opt.some;
    node.data.sel = ast_expr.ExprSel{place: member.data.member.object, case_name: member.data.member.name, case_id: member.data.member.name_id, case_desc: ast_id.EXPR_NIL};
    ret state.push_expr(p, node);
}

# the parentheses carry no node: the grouped expression's span widens to cover them
fun parse_paren(p: *state.Parser) ast_id.ExprId {
    val open:  token.Token         = state.advance(p);
    val inner: ast_id.ExprId       = parse_expr(p);
    val close: token.Token         = state.expect_end(p, token.KIND_RPAREN, "expected ')' after parenthesized expression");
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(p.ast, inner);
    if (sel e_opt.some) { e_opt.some.span = state.span_of(open.span, close.span); }
    ret inner;
}

fun parse_call_arg(p: *state.Parser) ast_id.ExprId {
    val e: ast_id.ExprId = parse_expr(p);
    if (!state.at(p, token.KIND_DOT_DOT_DOT)) { ret e; }
    val dots: token.Token = state.advance(p);

    var sp: ast_expr.ExprSpread;
    sp.inner = e;

    val start_span: lang_source.Span = expr_span_or(p, e, dots.span);

    var node: ast_expr.Expr;
    node.span        = state.span_of(start_span, dots.span);
    node.kind        = ast_expr.EXPR_KIND_SPREAD;
    node.data.spread = sp;
    ret state.push_expr(p, node);
}

fun callee_takes_type_operand(p: *state.Parser, callee: ast_id.ExprId) bool {
    val ce_opt: opt[*ast_expr.Expr] = ast.get_expr(p.ast, callee);
    if (!sel ce_opt.some) { ret false; }
    val ce: *ast_expr.Expr = ce_opt.some;
    if (ce.kind != ast_expr.EXPR_KIND_COMPTIME_IDENT) { ret false; }
    ret intrinsic.intrinsic_takes_type_operand(p.tokens.source, ce.data.comptime_ident.tok);
}

fun at_field_type_operand(p: *state.Parser) bool {
    if (!state.at(p, token.KIND_IDENT))                 { ret false; }
    if (state.peek(p, 1::usize).kind != token.KIND_DOT) { ret false; }

    val member: token.Token = state.peek(p, 2::usize);
    if (member.kind != token.KIND_IDENT)                                                  { ret false; }
    if (!str_region_equals(p.tokens.source, member.span.offset, member.span.len, "type")) { ret false; }

    val after: token.Kind = state.peek(p, 3::usize).kind;
    ret after == token.KIND_RPAREN || after == token.KIND_COMMA;
}

fun at_field_type_arg(p: *state.Parser) bool {
    if (!state.at(p, token.KIND_IDENT))                 { ret false; }
    if (state.peek(p, 1::usize).kind != token.KIND_DOT) { ret false; }

    val member: token.Token = state.peek(p, 2::usize);
    if (member.kind != token.KIND_IDENT)                                                  { ret false; }
    if (!str_region_equals(p.tokens.source, member.span.offset, member.span.len, "type")) { ret false; }

    val after: token.Kind = state.peek(p, 3::usize).kind;
    ret after == token.KIND_RBRACKET || after == token.KIND_COMMA;
}

fun at_field_type_spelling(p: *state.Parser) bool {
    if (!state.at(p, token.KIND_IDENT))                 { ret false; }
    if (state.peek(p, 1::usize).kind != token.KIND_DOT) { ret false; }

    val member: token.Token = state.peek(p, 2::usize);
    if (member.kind != token.KIND_IDENT)                                                  { ret false; }
    if (!str_region_equals(p.tokens.source, member.span.offset, member.span.len, "type")) { ret false; }

    val after: token.Kind = state.peek(p, 3::usize).kind;
    ret after != token.KIND_DOT && after != token.KIND_LBRACKET;
}

fun parse_pointee_of(p: *state.Parser, start: lang_source.Span) ast_id.TypeId {
    state.advance(p);
    var kind: ast_type.TypeKind = ast_type.TYPE_KIND_ERROR;
    if (state.at(p, token.KIND_IDENT)) {
        val named: intrinsic.Id = intrinsic.id_of(p.tokens.source, state.current(p).span);
        if (named == intrinsic.POINTEE_OF)      { kind = ast_type.TYPE_KIND_POINTEE_OF; }
        or (named == intrinsic.DISCRIMINANT_OF) { kind = ast_type.TYPE_KIND_DISCRIMINANT_OF; }
    }
    if (kind == ast_type.TYPE_KIND_ERROR) {
        val was_panicking: bool                      = p.panic;
        val refusal:       res[str, textbuild.Error] = intrinsic.constructor_refusal(p.ast.a);
        if (sel refusal.err) {
            state.fatal_ice_at(p, state.current(p).span, textbuild.text(refusal.err));
            ret ast_id.TYPE_NIL;
        }
        state.error_at_current(p, diagnostic_kind.COMPTIME_TYPE_CONSTRUCTOR, refusal.ok);
        str_free(p.ast.a, refusal.ok);
        var bad_end: lang_source.Span = start;
        if (!was_panicking && state.at(p, token.KIND_IDENT)) { bad_end = state.advance(p).span; }
        var bad: ast_type.Type;
        bad.span = state.span_of(start, bad_end);
        bad.kind = ast_type.TYPE_KIND_ERROR;
        ret state.push_type(p, bad);
    }
    state.advance(p);
    state.expect(p, token.KIND_LPAREN, "expected '(' after a comptime type constructor");
    val inner: ast_id.TypeId = parse_type(p);
    val close: token.Token   = state.current(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' to close the comptime type constructor");

    var t: ast_type.Type;
    t.span = state.span_of(start, close.span);
    t.kind = kind;
    if (kind == ast_type.TYPE_KIND_POINTEE_OF) { t.data.pointee_of = ast_type.TypePointeeOf{inner: inner}; }
    or                                         { t.data.discriminant_of = ast_type.TypeDiscriminantOf{inner: inner}; }
    ret state.push_type(p, t);
}

fun parse_field_type_arg(p: *state.Parser) ast_id.TypeId {
    val var_tok: token.Token = state.current(p);
    state.advance(p);
    state.advance(p);
    val member: token.Token = state.current(p);
    state.advance(p);

    var payload: ast_type.TypeFieldType;
    payload.var_name = var_tok.span;

    var span: lang_source.Span = var_tok.span;
    span.len = (member.span.offset + member.span.len) - var_tok.span.offset;

    var node: ast_type.Type;
    node.span            = span;
    node.kind            = ast_type.TYPE_KIND_FIELD_TYPE;
    node.data.field_type = payload;
    ret state.push_type(p, node);
}

fun mark_operand_slot(p: *state.Parser, tid: ast_id.TypeId) {
    val t_opt: opt[*ast_type.Type] = ast.get_type(p.ast, tid);
    if (!sel t_opt.some) { ret; }
    val t: *ast_type.Type = t_opt.some;
    if (t.kind != ast_type.TYPE_KIND_NAMED) { ret; }
    t.data.named.operand = true;
}

fun parse_type_operand(p: *state.Parser) ast_id.ExprId {
    val start: lang_source.Span = state.current(p).span;
    val tid:   ast_id.TypeId    = parse_type(p);
    mark_operand_slot(p, tid);

    var payload: ast_expr.ExprTypeRef;
    payload.ty = tid;

    var span:  lang_source.Span    = start;
    val t_opt: opt[*ast_type.Type] = ast.get_type(p.ast, tid);
    if (sel t_opt.some) { span = t_opt.some.span; }

    var node: ast_expr.Expr;
    node.span          = span;
    node.kind          = ast_expr.EXPR_KIND_TYPE_REF;
    node.data.type_ref = payload;
    ret state.push_expr(p, node);
}

fun parse_call(p: *state.Parser, callee: ast_id.ExprId, type_args_start: u32, type_args_len: u32, index_callee: ast_id.ExprId) ast_id.ExprId {
    state.advance(p);
    val type_operand: bool = callee_takes_type_operand(p, callee);

    var buf: Vector[ast_id.ExprId] = state.list_init[ast_id.ExprId](p);
    if (!state.at(p, token.KIND_RPAREN)) {
        if (type_operand && !at_field_type_operand(p)) { state.list_push[ast_id.ExprId](p, ?buf, parse_type_operand(p)); }
        or                                             { state.list_push[ast_id.ExprId](p, ?buf, parse_call_arg(p)); }
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RPAREN)) { brk; }
            state.list_push[ast_id.ExprId](p, ?buf, parse_call_arg(p));
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' to close call arguments");

    var args_len:   u32 = 0;
    val args_start: u32 = state.list_flush[ast_id.ExprId](p, ?buf, ?p.ast.expr_ids, ?args_len);

    var call: ast_expr.ExprCall;
    call.callee          = callee;
    call.args_start      = args_start;
    call.args_len        = args_len;
    call.type_args_start = type_args_start;
    call.type_args_len   = type_args_len;
    call.index_callee    = index_callee;

    val start_span: lang_source.Span = expr_span_or(p, callee, close.span);

    var node: ast_expr.Expr;
    node.span      = state.span_of(start_span, close.span);
    node.kind      = ast_expr.EXPR_KIND_CALL;
    node.data.call = call;
    ret state.push_expr(p, node);
}

fun parse_index(p: *state.Parser, object: ast_id.ExprId) ast_id.ExprId {
    state.advance(p);
    val idx:   ast_id.ExprId = parse_expr(p);
    var count: ast_id.ExprId = ast_id.EXPR_NIL;
    if (state.eat(p, token.KIND_COMMA)) { count = parse_expr(p); }
    ret close_index(p, object, idx, count);
}

fun close_index(p: *state.Parser, object: ast_id.ExprId, idx: ast_id.ExprId, count: ast_id.ExprId) ast_id.ExprId {
    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACKET, "expected ']' to close index expression");

    var index: ast_expr.ExprIndex;
    index.object = object;
    index.index  = idx;
    index.count  = count;

    val start_span: lang_source.Span = expr_span_or(p, object, close.span);

    var node: ast_expr.Expr;
    node.span       = state.span_of(start_span, close.span);
    node.kind       = ast_expr.EXPR_KIND_INDEX;
    node.data.index = index;
    ret state.push_expr(p, node);
}

fun parse_member(p: *state.Parser, object: ast_id.ExprId) ast_id.ExprId {
    val dot: token.Token = state.advance(p);
    if (!state.at(p, token.KIND_IDENT)) {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, "expected field name after '.'");
        var empty_name: lang_source.Span;
        empty_name.offset = state.current(p).span.offset;
        empty_name.len    = 0;

        var bad_member: ast_expr.ExprMember;
        bad_member.object  = object;
        bad_member.name    = empty_name;
        bad_member.name_id = intern.STR_NIL;

        var err_node: ast_expr.Expr;
        err_node.span        = expr_span_or(p, object, dot.span);
        err_node.kind        = ast_expr.EXPR_KIND_MEMBER;
        err_node.data.member = bad_member;
        ret state.push_expr(p, err_node);
    }
    val name_tok: token.Token = state.advance(p);

    var member: ast_expr.ExprMember;
    member.object  = object;
    member.name    = name_tok.span;
    member.name_id = state.name_id(p, name_tok.span);

    val start_span: lang_source.Span = expr_span_or(p, object, name_tok.span);

    var node: ast_expr.Expr;
    node.span        = state.span_of(start_span, name_tok.span);
    node.kind        = ast_expr.EXPR_KIND_MEMBER;
    node.data.member = member;
    ret state.push_expr(p, node);
}

fun parse_project(p: *state.Parser, object: ast_id.ExprId) ast_id.ExprId {
    state.expect(p, token.KIND_DOT, "expected '.' before '[' in a field projection");
    state.expect(p, token.KIND_LBRACKET, "expected '[' in a field projection");
    val field: ast_id.ExprId = parse_expr(p);
    val close: token.Token   = state.current(p);
    state.expect(p, token.KIND_RBRACKET, "expected ']' to close a field projection");

    var proj: ast_expr.ExprProject;
    proj.object = object;
    proj.field  = field;

    val start_span: lang_source.Span = expr_span_or(p, object, close.span);

    var node: ast_expr.Expr;
    node.span         = state.span_of(start_span, close.span);
    node.kind         = ast_expr.EXPR_KIND_PROJECT;
    node.data.project = proj;
    ret state.push_expr(p, node);
}

fun parse_cast(p: *state.Parser, value: ast_id.ExprId, reinterpret: bool) ast_id.ExprId {
    state.advance(p);
    val ty: ast_id.TypeId = parse_type(p);

    var cast: ast_expr.ExprCast;
    cast.value       = value;
    cast.ty          = ty;
    cast.reinterpret = reinterpret;

    val cur:        lang_source.Span = state.current(p).span;
    val start_span: lang_source.Span = expr_span_or(p, value, cur);
    val end_span:   lang_source.Span = type_span_or(p, ty, start_span);

    var node: ast_expr.Expr;
    node.span      = state.span_of(start_span, end_span);
    node.kind      = ast_expr.EXPR_KIND_CAST;
    node.data.cast = cast;
    ret state.push_expr(p, node);
}

fun parse_strip(p: *state.Parser, value: ast_id.ExprId) ast_id.ExprId {
    val op: token.Token = state.current(p);
    state.advance(p);

    var ty: ast_id.TypeId = ast_id.TYPE_NIL;
    if (at_type_start(p)) {
        ty = parse_type(p);
    }
    or {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TYPE, "expected a type after ':>'; declassification always names its public result type, as in `x:>u32`");
    }

    var strip: ast_expr.ExprStrip;
    strip.value = value;
    strip.ty    = ty;

    val start_span: lang_source.Span = expr_span_or(p, value, op.span);
    var end_span:   lang_source.Span = op.span;
    if (!ast_id.type_is_nil(ty)) { end_span = type_span_or(p, ty, op.span); }

    var node: ast_expr.Expr;
    node.span       = state.span_of(start_span, end_span);
    node.kind       = ast_expr.EXPR_KIND_STRIP;
    node.data.strip = strip;
    ret state.push_expr(p, node);
}

fun parse_array_literal(p: *state.Parser) ast_id.ExprId {
    val start: token.Token   = state.current(p);
    val ty:    ast_id.TypeId = parse_type(p);
    state.expect(p, token.KIND_LBRACE, "expected '{' after array type in array literal");

    var buf: Vector[ast_id.ExprId] = state.list_init[ast_id.ExprId](p);
    if (!state.at(p, token.KIND_RBRACE)) {
        state.list_push[ast_id.ExprId](p, ?buf, parse_expr(p));
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RBRACE)) { brk; }
            state.list_push[ast_id.ExprId](p, ?buf, parse_expr(p));
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close array literal");

    var elems_len:   u32 = 0;
    val elems_start: u32 = state.list_flush[ast_id.ExprId](p, ?buf, ?p.ast.expr_ids, ?elems_len);

    var array: ast_expr.ExprArrayLit;
    array.ty          = ty;
    array.elems_start = elems_start;
    array.elems_len   = elems_len;

    var node: ast_expr.Expr;
    node.span           = state.span_of(start.span, close.span);
    node.kind           = ast_expr.EXPR_KIND_ARRAY_LIT;
    node.data.array_lit = array;
    ret state.push_expr(p, node);
}

fun parse_typed_literal(p: *state.Parser) ast_id.ExprId {
    val start_tok: token.Token   = state.current(p);
    val ty:        ast_id.TypeId = parse_literal_head(p);
    state.expect(p, token.KIND_LBRACE, "expected '{' after type in struct or vector literal");

    var buf: Vector[ast_expr.FieldInit] = state.list_init[ast_expr.FieldInit](p);
    if (!state.at(p, token.KIND_RBRACE)) {
        if (!parse_field_init(p, ?buf)) {
            state.sync_to(p, token.KIND_RBRACE, token.KIND_EOF, token.KIND_EOF);
        }
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RBRACE)) { brk; }
            if (!parse_field_init(p, ?buf)) {
                state.sync_to(p, token.KIND_RBRACE, token.KIND_EOF, token.KIND_EOF);
                brk;
            }
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close struct literal");

    var fields_len:   u32 = 0;
    val fields_start: u32 = state.list_flush[ast_expr.FieldInit](p, ?buf, ?p.ast.field_inits, ?fields_len);

    var values: Vector[ast_id.ExprId] = state.list_init[ast_id.ExprId](p);
    var named:  bool                  = false;
    var bare:   bool                  = false;
    var i:      u32                   = 0;
    for (i < fields_len) {
        val field: *ast_expr.FieldInit = ?p.ast.field_inits.data[fields_start + i];
        if (field.form == ast_expr.INIT_NAMED) { named = true; }
        if (field.form == ast_expr.INIT_BARE)  { bare = true; }
        state.list_push[ast_id.ExprId](p, ?values, field.value);
        i = i + 1;
    }
    var elems_len:   u32 = 0;
    val elems_start: u32 = state.list_flush[ast_id.ExprId](p, ?values, ?p.ast.expr_ids, ?elems_len);
    var node:        ast_expr.Expr;
    node.span = state.span_of(start_tok.span, close.span);
    if (!named && !bare && fields_len != 0) {
        node.kind            = ast_expr.EXPR_KIND_VECTOR_LIT;
        node.data.vector_lit = ast_expr.ExprVectorLit{ty: ty, elems_start: elems_start, elems_len: elems_len};
    }
    or {
        node.kind            = ast_expr.EXPR_KIND_STRUCT_LIT;
        node.data.struct_lit = ast_expr.ExprStructLit{ty: ty, fields_start: fields_start, fields_len: fields_len,
            elems_start: elems_start, elems_len: elems_len};
    }
    ret state.push_expr(p, node);
}

fun parse_field_init(p: *state.Parser, buf: *Vector[ast_expr.FieldInit]) bool {
    var field: ast_expr.FieldInit;
    field.name_id = intern.STR_NIL;
    if (state.at(p, token.KIND_IDENT) && state.peek(p, 1).kind == token.KIND_COLON) {
        field.name    = state.advance(p).span;
        field.name_id = state.name_id(p, field.name);
        state.advance(p);
        field.value = parse_expr(p);
        field.form  = ast_expr.INIT_NAMED;
    }
    or {
        field.value = parse_expr(p);
        val selected: opt[*ast_expr.Expr] = ast.get_expr(p.ast, field.value);
        if (!sel selected.some) { ret false; }
        val value: *ast_expr.Expr = selected.some;
        field.name = value.span;
        field.form = ast_expr.INIT_POSITIONAL;
        if (value.kind == ast_expr.EXPR_KIND_IDENT) {
            field.name    = value.data.ident.tok;
            field.name_id = value.data.ident.name;
            field.form    = ast_expr.INIT_BARE;
        }
    }
    if (!state.at(p, token.KIND_COMMA) && !state.at(p, token.KIND_RBRACE)) {
        state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_TOKEN, "expected ':' between field name and value");
        ret false;
    }
    state.list_push[ast_expr.FieldInit](p, buf, field);
    ret true;
}

# after generic arguments a trailing `.case` or `.[case]` is unambiguous, so the head parser keeps it
fun parse_literal_head(p: *state.Parser) ast_id.TypeId {
    val tid: ast_id.TypeId = parse_type(p);
    if (!state.at(p, token.KIND_DOT)) { ret tid; }
    val bracketed: bool = state.peek(p, 1).kind == token.KIND_LBRACKET;
    if (!bracketed && state.peek(p, 1).kind != token.KIND_IDENT) { ret tid; }
    val t_opt: opt[*ast_type.Type] = ast.get_type(p.ast, tid);
    if (!sel t_opt.some) { ret tid; }
    val t: *ast_type.Type = t_opt.some;
    if (t.kind != ast_type.TYPE_KIND_NAMED) { ret tid; }
    state.advance(p);
    if (bracketed) {
        state.advance(p);
        val desc:  ast_id.ExprId = parse_expr(p);
        val close: token.Token   = state.current(p);
        state.expect(p, token.KIND_RBRACKET, "expected ']' to close a case descriptor in a literal head");
        t.data.named.case_desc = desc;
        t.span                 = state.span_of(t.span, close.span);
        ret tid;
    }
    val case_tok: token.Token = state.advance(p);
    t.data.named.case_name = case_tok.span;
    t.span                 = state.span_of(t.span, case_tok.span);
    ret tid;
}

fun looks_like_typed_literal(p: *state.Parser) bool {
    if (state.current(p).kind != token.KIND_IDENT) { ret false; }

    var i: usize = 1;
    for (state.peek(p, i).kind == token.KIND_DOT && state.peek(p, i + 1).kind == token.KIND_IDENT) {
        i = i + 2;
    }

    if (state.peek(p, i).kind == token.KIND_LBRACKET) {
        val after: usize = scan_bracket_close(p, i);
        if (after == 0) { ret false; }
        i = after;
        if (state.peek(p, i).kind == token.KIND_DOT && state.peek(p, i + 1).kind == token.KIND_IDENT) {
            i = i + 2;
        }
    }

    # `T.[case]{...}` constructs through a comptime case descriptor
    if (state.peek(p, i).kind == token.KIND_DOT && state.peek(p, i + 1).kind == token.KIND_LBRACKET) {
        val after: usize = scan_bracket_close(p, i + 1);
        if (after == 0) { ret false; }
        i = after;
    }

    ret state.peek(p, i).kind == token.KIND_LBRACE;
}

# the binary operator an infix token spells; absent for a kind the operator
# table never admits, which the caller reports through the catalog policy
fun bin_op_from_kind(kind: token.Kind) opt[ast_expr.BinOp] {
    if (kind == token.KIND_PLUS)      { ret opt[ast_expr.BinOp].some{ast_expr.BIN_ADD}; }
    if (kind == token.KIND_MINUS)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_SUB}; }
    if (kind == token.KIND_STAR)      { ret opt[ast_expr.BinOp].some{ast_expr.BIN_MUL}; }
    if (kind == token.KIND_SLASH)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_DIV}; }
    if (kind == token.KIND_PERCENT)   { ret opt[ast_expr.BinOp].some{ast_expr.BIN_MOD}; }
    if (kind == token.KIND_EQ_EQ)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_EQ}; }
    if (kind == token.KIND_BANG_EQ)   { ret opt[ast_expr.BinOp].some{ast_expr.BIN_NEQ}; }
    if (kind == token.KIND_LT)        { ret opt[ast_expr.BinOp].some{ast_expr.BIN_LT}; }
    if (kind == token.KIND_LT_EQ)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_LEQ}; }
    if (kind == token.KIND_GT)        { ret opt[ast_expr.BinOp].some{ast_expr.BIN_GT}; }
    if (kind == token.KIND_GT_EQ)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_GEQ}; }
    if (kind == token.KIND_AMP_AMP)   { ret opt[ast_expr.BinOp].some{ast_expr.BIN_AND}; }
    if (kind == token.KIND_PIPE_PIPE) { ret opt[ast_expr.BinOp].some{ast_expr.BIN_OR}; }
    if (kind == token.KIND_AMP)       { ret opt[ast_expr.BinOp].some{ast_expr.BIN_BIT_AND}; }
    if (kind == token.KIND_PIPE)      { ret opt[ast_expr.BinOp].some{ast_expr.BIN_BIT_OR}; }
    if (kind == token.KIND_CARET)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_BIT_XOR}; }
    if (kind == token.KIND_LT_LT)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_SHL}; }
    if (kind == token.KIND_GT_GT)     { ret opt[ast_expr.BinOp].some{ast_expr.BIN_SHR}; }
    if (kind == token.KIND_EQ)        { ret opt[ast_expr.BinOp].some{ast_expr.BIN_ASSIGN}; }
    ret opt[ast_expr.BinOp].none{};
}

fun span_of_expr_pair(p: *state.Parser, lhs: ast_id.ExprId, rhs: ast_id.ExprId) lang_source.Span {
    val cur: lang_source.Span = state.current(p).span;
    ret state.span_of(expr_span_or(p, lhs, cur), expr_span_or(p, rhs, cur));
}

fun expr_span_or(p: *state.Parser, eid: ast_id.ExprId, fallback: lang_source.Span) lang_source.Span {
    if (ast_id.expr_is_nil(eid)) { ret fallback; }
    val parsed_1: opt[*ast_expr.Expr] = ast.get_expr(p.ast, eid);
    if (!sel parsed_1.some) {
        state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
        ret fallback;
    }
    ret parsed_1.some.span;
}

fun type_span_or(p: *state.Parser, tid: ast_id.TypeId, fallback: lang_source.Span) lang_source.Span {
    if (ast_id.type_is_nil(tid)) { ret fallback; }
    val typed: opt[*ast_type.Type] = ast.get_type(p.ast, tid);
    if (!sel typed.some) {
        state.fatal_ice_at(p, state.current(p).span, "internal compiler error: a parsed node is absent from the tree");
        ret fallback;
    }
    ret typed.some.span;
}

fun parse_named(p: *state.Parser, start: lang_source.Span) ast_id.TypeId {
    var last:     lang_source.Span = state.advance(p).span;
    val segments: u32              = p.ast.path_names.len::u32;
    path_segment(p, last);

    for (state.at(p, token.KIND_DOT) && state.peek(p, 1).kind == token.KIND_IDENT) {
        state.advance(p);
        last = state.advance(p).span;
        path_segment(p, last);
    }

    val path_span: lang_source.Span = state.span_of(start, last);

    var args_start: u32              = 0;
    var args_len:   u32              = 0;
    var end:        lang_source.Span = last;

    if (state.eat(p, token.KIND_LBRACKET)) {
        var buf: Vector[ast_id.TypeId] = state.list_init[ast_id.TypeId](p);
        if (!state.at(p, token.KIND_RBRACKET)) {
            state.list_push[ast_id.TypeId](p, ?buf, parse_type(p));
            for (state.eat(p, token.KIND_COMMA)) {
                if (state.at(p, token.KIND_RBRACKET)) { brk; }
                state.list_push[ast_id.TypeId](p, ?buf, parse_type(p));
            }
        }
        val close: token.Token = state.current(p);
        state.expect(p, token.KIND_RBRACKET, "expected ']' to close generic arguments");
        end        = close.span;
        args_start = state.list_flush[ast_id.TypeId](p, ?buf, ?p.ast.type_ids, ?args_len);
    }

    var named: ast_type.TypeNamed;
    named.name       = path_span;
    named.args_start = args_start;
    named.args_len   = args_len;
    named.operand    = false;
    named.case_name  = lang_source.Span{offset: path_span.offset, len: 0};
    named.case_desc  = ast_id.EXPR_NIL;
    named.segments   = segments;

    var t: ast_type.Type;
    t.span       = state.span_of(start, end);
    t.kind       = ast_type.TYPE_KIND_NAMED;
    t.data.named = named;
    ret state.push_type(p, t);
}

fun path_segment(p: *state.Parser, span: lang_source.Span) {
    val added: res[u32, fail.Fail] = ast.add_path_name(p.ast, state.name_id(p, span));
    if (sel added.err) { state.fatal_oom_at(p, span); }
}

fun parse_ptr(p: *state.Parser, start: lang_source.Span) ast_id.TypeId {
    state.advance(p);
    val inner: ast_id.TypeId = parse_type(p);

    var ptr: ast_type.TypePtr;
    ptr.pointee = inner;

    val end_span: lang_source.Span = type_span_or(p, inner, start);

    var t: ast_type.Type;
    t.span     = state.span_of(start, end_span);
    t.kind     = ast_type.TYPE_KIND_PTR;
    t.data.ptr = ptr;
    ret state.push_type(p, t);
}

fun parse_secret(p: *state.Parser, start: lang_source.Span) ast_id.TypeId {
    state.advance(p);
    val inner: ast_id.TypeId = parse_type(p);

    var secret: ast_type.TypeSecret;
    secret.inner = inner;

    val end_span: lang_source.Span = type_span_or(p, inner, start);

    var t: ast_type.Type;
    t.span        = state.span_of(start, end_span);
    t.kind        = ast_type.TYPE_KIND_SECRET;
    t.data.secret = secret;
    ret state.push_type(p, t);
}

fun parse_array(p: *state.Parser, start: lang_source.Span) ast_id.TypeId {
    state.advance(p);
    var length: ast_id.ExprId = ast_id.EXPR_NIL;
    if (state.at_kw(p, "_") && state.peek(p, 1::usize).kind == token.KIND_RBRACKET) {
        state.advance(p);
    }
    or {
        length = parse_expr(p);
    }
    state.expect(p, token.KIND_RBRACKET, "expected ']' after array length");

    val element: ast_id.TypeId = parse_type(p);

    var array: ast_type.TypeArray;
    array.length  = length;
    array.element = element;

    val end_span: lang_source.Span = type_span_or(p, element, start);

    var t: ast_type.Type;
    t.span       = state.span_of(start, end_span);
    t.kind       = ast_type.TYPE_KIND_ARRAY;
    t.data.array = array;
    ret state.push_type(p, t);
}

fun parse_fun(p: *state.Parser, start: lang_source.Span) ast_id.TypeId {
    state.advance(p);
    state.expect(p, token.KIND_LPAREN, "expected '(' after 'fun'");

    var buf: Vector[ast_id.TypeId] = state.list_init[ast_id.TypeId](p);

    var c_variadic: bool = false;
    if (state.at(p, token.KIND_DOT_DOT_DOT)) {
        state.error_at_current(p, diagnostic_kind.VARIADIC_NO_FIXED_PARAM, "a C-variadic function type needs at least one fixed parameter before `...`");
        state.advance(p);
    }
    or (!state.at(p, token.KIND_RPAREN)) {
        state.list_push[ast_id.TypeId](p, ?buf, parse_type(p));
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RPAREN)) { brk; }
            if (state.at(p, token.KIND_DOT_DOT_DOT)) {
                c_variadic = true;
                state.advance(p);
                brk;
            }
            state.list_push[ast_id.TypeId](p, ?buf, parse_type(p));
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' to close function parameters");

    var params_len:   u32 = 0;
    val params_start: u32 = state.list_flush[ast_id.TypeId](p, ?buf, ?p.ast.type_ids, ?params_len);

    var ret_type: ast_id.TypeId    = ast_id.TYPE_NIL;
    var end_span: lang_source.Span = close.span;
    if (!at_type_boundary(p)) {
        ret_type = parse_type(p);
        end_span = type_span_or(p, ret_type, end_span);
    }

    var fun_: ast_type.TypeFun;
    fun_.params_start = params_start;
    fun_.params_len   = params_len;
    fun_.ret_type     = ret_type;
    fun_.c_variadic   = c_variadic;

    var t: ast_type.Type;
    t.span      = state.span_of(start, end_span);
    t.kind      = ast_type.TYPE_KIND_FUN;
    t.data.fun_ = fun_;
    ret state.push_type(p, t);
}

fun parse_rec_or_uni(p: *state.Parser, start: lang_source.Span, kind: ast_type.TypeKind) ast_id.TypeId {
    state.advance(p);
    state.expect(p, token.KIND_LBRACE, "expected '{' to open anonymous type body");

    var buf: Vector[ast_decl.TypedName] = state.list_init[ast_decl.TypedName](p);

    for (!state.at(p, token.KIND_RBRACE) && !state.at_eof(p)) {
        if (!state.at(p, token.KIND_IDENT)) {
            state.error_at_current(p, diagnostic_kind.SYNTAX_EXPECTED_NAME, "expected a field name in anonymous type body");
            state.sync_to(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            if (state.at(p, token.KIND_SEMI)) { state.advance(p); }
            cnt;
        }
        val name: lang_source.Span = state.advance(p).span;
        state.expect(p, token.KIND_COLON, "expected ':' between field name and type");
        val ty: ast_id.TypeId = parse_type(p);

        var tn: ast_decl.TypedName;
        tn.name     = name;
        tn.ty       = ty;
        tn.comptime = false;
        state.list_push[ast_decl.TypedName](p, ?buf, tn);

        state.expect(p, token.KIND_SEMI, "expected ';' after field declaration");
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close anonymous type body");

    var fields_len:   u32 = 0;
    val fields_start: u32 = state.list_flush[ast_decl.TypedName](p, ?buf, ?p.ast.typed_names, ?fields_len);

    var t: ast_type.Type;
    t.span = state.span_of(start, close.span);
    t.kind = kind;
    if (kind == ast_type.TYPE_KIND_REC) {
        var r: ast_type.TypeRec;
        r.fields_start = fields_start;
        r.fields_len   = fields_len;
        t.data.rec_    = r;
    }
    or {
        var u: ast_type.TypeUni;
        u.fields_start = fields_start;
        u.fields_len   = fields_len;
        t.data.uni_    = u;
    }
    ret state.push_type(p, t);
}

fun at_type_boundary(p: *state.Parser) bool {
    val k: token.Kind = state.current(p).kind;
    if (k == token.KIND_LBRACE)   { ret true; }
    if (k == token.KIND_SEMI)     { ret true; }
    if (k == token.KIND_COMMA)    { ret true; }
    if (k == token.KIND_RPAREN)   { ret true; }
    if (k == token.KIND_RBRACKET) { ret true; }
    if (k == token.KIND_EQ)       { ret true; }
    if (k == token.KIND_EOF)      { ret true; }
    ret false;
}
