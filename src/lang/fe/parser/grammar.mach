test "mach.lang.fe.parser.expr.parse_try:operand_boundary_and_failure_block" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val text: str = "try fetch(1).result or (error: Error) { fin { cleanup(); } ret Error{native: error}; } + 2";
    val lexed: R.Result[lexer.TokenStream, str] = lexer.tokenize(text, ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](lexed)) { ret 2; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](lexed);
    fin { lexer.dnit(?stream, ?alloc); }
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);
    fin { ast.dnit(?a); }
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?diags); }
    var p: state.Parser = state.make(?stream, ?a, ?diags);
    p.no_struct_lit = true;
    val parsed: id.ExprId = parse_expr(?p);
    if (p.fatal || !p.no_struct_lit || diagnostic.len(?diags) != 0 || !state.at_eof(?p)) { ret 3; }
    val root: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, parsed));
    if (root.kind != expr.EXPR_KIND_BINARY || root.data.binary.op != expr.BIN_ADD) { ret 4; }
    val selected: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, root.data.binary.lhs));
    if (selected.kind != expr.EXPR_KIND_TRY || selected.data.try_.error_type == id.TYPE_NIL
        || selected.data.try_.failure == id.STMT_NIL) { ret 5; }
    val binding: token.Span = selected.data.try_.error_name;
    if (!str_region_equals(text, binding.offset, binding.len, "error")) { ret 6; }
    val operand: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, selected.data.try_.operand));
    if (operand.kind != expr.EXPR_KIND_MEMBER) { ret 7; }
    val failure: *stmt.Stmt = O.unwrap[*stmt.Stmt](ast.get_stmt(?a, selected.data.try_.failure));
    if (failure.kind != stmt.STMT_KIND_BLOCK || failure.data.block.stmts_len != 2) { ret 8; }
    ret 0;
}

test "mach.lang.fe.parser.expr.parse_try:parenthesized_operand_without_error_binding" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val text: str = "try (left + right) or { ret; }";
    val lexed: R.Result[lexer.TokenStream, str] = lexer.tokenize(text, ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](lexed)) { ret 2; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](lexed);
    fin { lexer.dnit(?stream, ?alloc); }
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);
    fin { ast.dnit(?a); }
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?diags); }
    var p: state.Parser = state.make(?stream, ?a, ?diags);
    val parsed: id.ExprId = parse_expr(?p);
    if (p.fatal || diagnostic.len(?diags) != 0 || !state.at_eof(?p)) { ret 3; }
    val root: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, parsed));
    if (root.kind != expr.EXPR_KIND_TRY || root.data.try_.error_name.len != 0
        || root.data.try_.error_type != id.TYPE_NIL) { ret 4; }
    val operand: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, root.data.try_.operand));
    if (operand.kind != expr.EXPR_KIND_BINARY || operand.data.binary.op != expr.BIN_ADD) { ret 5; }
    ret 0;
}

test "mach.lang.fe.parser.expr.parse_try:requires_typed_binding_and_explicit_block" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var texts: [5]str = [5]str{
        "try value", "try value or", "try value or (error) { ret; }",
        "try value or (error: Error) ret;", "try left + right or { ret; }"
    };
    var i: usize = 0;
    for (i < 5) {
        val lexed: R.Result[lexer.TokenStream, str] = lexer.tokenize(texts[i], ?alloc, 0::source.FileId);
        if (R.is_err[lexer.TokenStream, str](lexed)) { ret 2; }
        var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](lexed);
        fin { lexer.dnit(?stream, ?alloc); }
        var a: ast.Ast = ast.init(?alloc, 0::source.FileId);
        fin { ast.dnit(?a); }
        var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
        fin { diagnostic.store_dnit(?diags); }
        var p: state.Parser = state.make(?stream, ?a, ?diags);
        parse_expr(?p);
        if (p.fatal || diagnostic.len(?diags) == 0) { ret 3; }
        i = i + 1;
    }
    ret 0;
}
