    if (n1.kind != expr.EXPR_KIND_STRIP) { rc = 1; }
    or (n1.data.strip.ty != id.TYPE_NIL) { rc = 1; }
    or {
        val v: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a1, n1.data.strip.value));
        if (v.kind != expr.EXPR_KIND_IDENT) { rc = 1; }
