test "mach.lang.fe.parser.expr.parse_array:inferred_length" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var rc: i32 = 0;

    val tr1: R.Result[lexer.TokenStream, str] = lexer.tokenize("[_]u8", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr1)) { ret 1; }
    var s1: lexer.TokenStream   = R.unwrap_ok[lexer.TokenStream, str](tr1);
    var a1: ast.Ast             = ast.init(?alloc, 0::source.FileId);
    var d1: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p1: state.Parser        = state.make(?s1, ?a1, ?d1);
    val t1: id.TypeId           = parse_type(?p1);
    val n1: *type.Type          = O.unwrap[*type.Type](ast.get_type(?a1, t1));
    if (n1.kind != type.TYPE_KIND_ARRAY)          { rc = 1; }
    or (n1.data.array.length != id.EXPR_NIL)      { rc = 1; }
    if (diagnostic.has_errors(?d1))               { rc = 1; }
    diagnostic.store_dnit(?d1); ast.dnit(?a1); lexer.dnit(?s1, ?alloc);
    if (rc != 0) { ret rc; }

    val tr2: R.Result[lexer.TokenStream, str] = lexer.tokenize("[4]u8", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr2)) { ret 1; }
    var s2: lexer.TokenStream   = R.unwrap_ok[lexer.TokenStream, str](tr2);
    var a2: ast.Ast             = ast.init(?alloc, 0::source.FileId);
    var d2: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p2: state.Parser        = state.make(?s2, ?a2, ?d2);
    val t2: id.TypeId           = parse_type(?p2);
    val n2: *type.Type          = O.unwrap[*type.Type](ast.get_type(?a2, t2));
    if (n2.kind != type.TYPE_KIND_ARRAY)          { rc = 1; }
    or (n2.data.array.length == id.EXPR_NIL)      { rc = 1; }
    if (diagnostic.has_errors(?d2))               { rc = 1; }
    diagnostic.store_dnit(?d2); ast.dnit(?a2); lexer.dnit(?s2, ?alloc);
    if (rc != 0) { ret rc; }

    val tr3: R.Result[lexer.TokenStream, str] = lexer.tokenize("[_ + 1]u8", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr3)) { ret 1; }
    var s3: lexer.TokenStream   = R.unwrap_ok[lexer.TokenStream, str](tr3);
    var a3: ast.Ast             = ast.init(?alloc, 0::source.FileId);
    var d3: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p3: state.Parser        = state.make(?s3, ?a3, ?d3);
    val t3: id.TypeId           = parse_type(?p3);
    val n3: *type.Type          = O.unwrap[*type.Type](ast.get_type(?a3, t3));
    if (n3.kind != type.TYPE_KIND_ARRAY)          { rc = 1; }
    or (n3.data.array.length == id.EXPR_NIL)      { rc = 1; }
    diagnostic.store_dnit(?d3); ast.dnit(?a3); lexer.dnit(?s3, ?alloc);

    ret rc;
}

test "mach.lang.fe.parser.expr.parse_strip:accepts_full_type_grammar" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("x:^*u8", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var s: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);
    var d: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?s, ?a, ?d);

    val eid: id.ExprId = parse_expr(?p);
    var rc: i32 = 0;
    val e: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, eid));
    if (e.kind != expr.EXPR_KIND_STRIP)  { rc = 1; }
    or (e.data.strip.ty == id.TYPE_NIL)  { rc = 1; }
    or {
        val t: *type.Type = O.unwrap[*type.Type](ast.get_type(?a, e.data.strip.ty));
        if (t.kind != type.TYPE_KIND_PTR) { rc = 1; }
    }
    if (diagnostic.has_errors(?d)) { rc = 1; }

    diagnostic.store_dnit(?d); ast.dnit(?a); lexer.dnit(?s, ?alloc);
    ret rc;
}

