test "mach.lang.fe.parser.expr.parse_typed_literal:colon_gt_does_not_disturb_field_init" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var rc: i32 = 0;

    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("P { a: b }", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var s: lexer.TokenStream          = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast                    = ast.init(?alloc, 0::source.FileId);
    var d: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser               = state.make(?s, ?a, ?d);
    val e: id.ExprId                  = parse_expr(?p);
    val n: *expr.Expr                 = O.unwrap[*expr.Expr](ast.get_expr(?a, e));
    if (n.kind != expr.EXPR_KIND_STRUCT_LIT) { rc = 1; }
    if (diagnostic.has_errors(?d))           { rc = 1; }
    diagnostic.store_dnit(?d); ast.dnit(?a); lexer.dnit(?s, ?alloc);
    if (rc != 0) { ret rc; }

    val tr2: R.Result[lexer.TokenStream, str] = lexer.tokenize("P { a: b > c }", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr2)) { ret 1; }
    var s2: lexer.TokenStream          = R.unwrap_ok[lexer.TokenStream, str](tr2);
    var a2: ast.Ast                    = ast.init(?alloc, 0::source.FileId);
    var d2: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p2: state.Parser               = state.make(?s2, ?a2, ?d2);
    val e2: id.ExprId                  = parse_expr(?p2);
    val n2: *expr.Expr                 = O.unwrap[*expr.Expr](ast.get_expr(?a2, e2));
    if (n2.kind != expr.EXPR_KIND_STRUCT_LIT) { rc = 1; }
    if (diagnostic.has_errors(?d2))           { rc = 1; }
    diagnostic.store_dnit(?d2); ast.dnit(?a2); lexer.dnit(?s2, ?alloc);
    if (rc != 0) { ret rc; }

    val tr3: R.Result[lexer.TokenStream, str] = lexer.tokenize("P { a:>u32 }", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr3)) { ret 1; }
    var s3: lexer.TokenStream          = R.unwrap_ok[lexer.TokenStream, str](tr3);
    var a3: ast.Ast                    = ast.init(?alloc, 0::source.FileId);
    var d3: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p3: state.Parser               = state.make(?s3, ?a3, ?d3);
    val e3: id.ExprId                  = parse_expr(?p3);
    val n3: *expr.Expr                 = O.unwrap[*expr.Expr](ast.get_expr(?a3, e3));
    if (n3.kind != expr.EXPR_KIND_VECTOR_LIT) { rc = 1; }
    or (n3.data.vector_lit.elems_len != 1)    { rc = 1; }
    or {
        val el: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a3, a3.expr_ids[n3.data.vector_lit.elems_start]));
        if (el.kind != expr.EXPR_KIND_STRIP) { rc = 1; }
    }
    if (diagnostic.has_errors(?d3)) { rc = 1; }
    diagnostic.store_dnit(?d3); ast.dnit(?a3); lexer.dnit(?s3, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.expr.parse_expr:caret_stays_infix_xor" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_tokens: R.Result[lexer.TokenStream, str] = lexer.tokenize("a ^ b", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](res_tokens)) { ret 1; }
    var stream: lexer.TokenStream   = R.unwrap_ok[lexer.TokenStream, str](res_tokens);
    var a:      ast.Ast             = ast.init(?alloc, 0::source.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p:      state.Parser        = state.make(?stream, ?a, ?diags);

    val eid: id.ExprId = parse_expr(?p);
    var rc: i32 = 0;
    val e: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, eid));
    if (e.kind != expr.EXPR_KIND_BINARY)      { rc = 1; }
    or (e.data.binary.op != expr.BIN_BIT_XOR) { rc = 1; }
    if (diagnostic.has_errors(?diags)) { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

