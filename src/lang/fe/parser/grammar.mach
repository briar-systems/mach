    var s: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);
    var d: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?s, ?a, ?d);

    val eid: id.ExprId = parse_expr(?p);
    var rc: i32 = 0;
    if (eid == id.EXPR_NIL)      { rc = 1; }
    or (!state.at_eof(?p))       { rc = 1; }
    or (diagnostic.len(?d) != 1) { rc = 1; }

    diagnostic.store_dnit(?d); ast.dnit(?a); lexer.dnit(?s, ?alloc);
    ret rc;
}

