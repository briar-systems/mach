    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("$pointee(T)", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var s: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);
    var d: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?s, ?a, ?d);

    val tid: id.TypeId = parse_type(?p);
    var rc: i32 = 0;
    if (tid == id.TYPE_NIL)                            { rc = 1; }
    or (diagnostic.len(?d) != 1)                       { rc = 1; }
    or (state.current(?p).kind != token.KIND_LPAREN)   { rc = 1; }

    diagnostic.store_dnit(?d); ast.dnit(?a); lexer.dnit(?s, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.expr.parse_member:missing_name_retains_object" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("obj.;", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var s: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);
    var d: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?s, ?a, ?d);

    val eid: id.ExprId = parse_expr(?p);
    var rc: i32 = 0;
    val e: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, eid));
    if (e.kind != expr.EXPR_KIND_MEMBER)     { rc = 1; }
    or (e.data.member.object == id.EXPR_NIL) { rc = 1; }
    or {
        val obj: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, e.data.member.object));
        if (obj.kind != expr.EXPR_KIND_IDENT) { rc = 1; }
    }
    if (diagnostic.len(?d) != 1) { rc = 1; }

    diagnostic.store_dnit(?d); ast.dnit(?a); lexer.dnit(?s, ?alloc);
    ret rc;
}

