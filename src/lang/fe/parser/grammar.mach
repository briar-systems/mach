}

test "mach.lang.fe.parser.decl.parse_comptime_chain:decl_and_stmt_scope" {
    if (t_parse_module_has_errors("$if (1) {} $or (2) {} $or {}")) { ret 1; }
    if (t_parse_module_has_errors("fun f() i64 { $if (1) { ret 1; } $or { ret 0; } }")) { ret 1; }
    if (!t_parse_module_has_errors("$if 1 {}")) { ret 1; }
    ret 0;
}

test "mach.lang.fe.parser.decl.parse_comptime_directive:setter_rejected_same_in_decl_and_stmt_scope" {
    val setter_removed_message: str = "comptime attribute setters were removed in v2.0.0; use a #[symbol(\"...\")] or #[library(\"...\")] decorator on the declaration";

    var alloc_decl: A.Allocator;
    page.make(?alloc_decl);
    val tr_decl: R.Result[lexer.TokenStream, str] = lexer.tokenize("$error = 1;", ?alloc_decl, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr_decl)) { ret 1; }
    var stream_decl: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr_decl);
    var a_decl: ast.Ast = ast.init(?alloc_decl, 0::src.FileId);
    var diags_decl: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc_decl);
    var p_decl: state.Parser = state.make(?stream_decl, ?a_decl, ?diags_decl);
    parse_module(?p_decl);

    var rc: i32 = 0;
    if (diagnostic.len(?diags_decl) != 1)                                                 { rc = 1; }
    or (!str_equals(diags_decl.items.data[0].message, setter_removed_message))            { rc = 1; }

    diagnostic.store_dnit(?diags_decl);
    ast.dnit(?a_decl);
    lexer.dnit(?stream_decl, ?alloc_decl);
    if (rc != 0) { ret rc; }

    var alloc_stmt: A.Allocator;
    page.make(?alloc_stmt);
    val source_stmt: str = "fun f() { $error = 1; }";
    val tr_stmt: R.Result[lexer.TokenStream, str] = lexer.tokenize(source_stmt, ?alloc_stmt, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr_stmt)) { ret 1; }
    var stream_stmt: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr_stmt);
    var a_stmt: ast.Ast = ast.init(?alloc_stmt, 0::src.FileId);
    var diags_stmt: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc_stmt);
    var p_stmt: state.Parser = state.make(?stream_stmt, ?a_stmt, ?diags_stmt);
    parse_module(?p_stmt);

    if (diagnostic.len(?diags_stmt) != 1)                                          { rc = 1; }
    or (a_stmt.decl_len < 1)                                                       { rc = 1; }
    or (a_stmt.decls[0].kind != decl.DECL_KIND_FUN)                                { rc = 1; }
    or (!str_equals(diags_stmt.items.data[0].message, setter_removed_message))     { rc = 1; }

    diagnostic.store_dnit(?diags_stmt);
    ast.dnit(?a_stmt);
    lexer.dnit(?stream_stmt, ?alloc_stmt);
    ret rc;
}

test "mach.lang.fe.parser.decl.parse_stmt:bare_kw_as_ident" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val source: str = "fun g() i64 { ret 1; } fun f() i64 { var cnt: i64 = 0; for (true) { cnt = g(); brk; cnt; } ret cnt; }";
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize(source, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?stream, ?a, ?diags);
    parse_module(?p);

    var rc: i32 = 0;
    if (diagnostic.has_errors(?diags)) { rc = 1; }

    var n_cnt:  usize = 0;
    var n_brk:  usize = 0;
    var n_expr: usize = 0;
    var i: usize = 0;
    for (i < a.stmt_len) {
        val k: stmt.StmtKind = a.stmts[i].kind;
        if (k == stmt.STMT_KIND_CNT)  { n_cnt  = n_cnt  + 1; }
        or (k == stmt.STMT_KIND_BRK)  { n_brk  = n_brk  + 1; }
        or (k == stmt.STMT_KIND_EXPR) { n_expr = n_expr + 1; }
        i = i + 1;
    }
    if (n_cnt  != 1) { rc = 1; }
    if (n_brk  != 1) { rc = 1; }
    if (n_expr != 1) { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.decl.parse_fin_stmt:requires_block" {
    if (!t_parse_module_has_errors("fun f() { fin g(); }"))              { ret 1; }
    if (!t_parse_module_has_errors("fun f() i64 { fin ret 0; ret 0; }")) { ret 1; }
    if (!t_parse_module_has_errors("fun f() { var x: i64 = 0; fin x = 1; }")) { ret 1; }
    if (t_parse_module_has_errors("fun f() { fin { } }"))                { ret 1; }
    if (t_parse_module_has_errors("fun f() i64 { var x: i64 = 0; fin { x = x + 1; } ret x; }")) { ret 1; }
    ret 0;
}

