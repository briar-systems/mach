    ret rc;
}

test "mach.lang.fe.parser.decl.parse_decorators:attrs_attach" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val source: str = "#[inline] #[symbol(\"_start\")] fun f() {} fun g() {}";
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize(source, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?stream, ?a, ?diags);
    parse_module(?p);

    var rc: i32 = 0;
    if (diagnostic.has_errors(?diags))         { rc = 1; }
    or (a.decl_len < 2)                        { rc = 1; }
    or (a.decls[0].kind != decl.DECL_KIND_FUN) { rc = 1; }
    or (a.decls[1].kind != decl.DECL_KIND_FUN) { rc = 1; }
    or (a.decls[0].decorators_len != 2)        { rc = 1; }
    or (a.decls[1].decorators_len != 0)        { rc = 1; }

    if (rc == 0) {
        val d0: decl.Decorator = a.decorators[a.decls[0].decorators_start];
        val d1: decl.Decorator = a.decorators[a.decls[0].decorators_start + 1];
        if (!str_region_equals(p.tokens.source, d0.name.offset, d0.name.len, "inline")) { rc = 1; }
        if (d0.args_len != 0)                                                           { rc = 1; }
        if (!str_region_equals(p.tokens.source, d1.name.offset, d1.name.len, "symbol")) { rc = 1; }
        if (d1.args_len != 1)                                                           { rc = 1; }
    }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.decl.parse_decorators:malformed_attr_errors" {
    if (!t_parse_module_has_errors("#[inline fun f() {}")) { ret 1; }
    if (!t_parse_module_has_errors("#[] fun f() {}")) { ret 1; }
    ret 0;
}

test "mach.lang.fe.parser.decl.parse_decorators:unclosed_attr_not_attached" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val source: str = "#[inline fun f() {} fun g() {}";
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize(source, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var a: ast.Ast = ast.init(?alloc, 0::src.FileId);
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var p: state.Parser = state.make(?stream, ?a, ?diags);
    parse_module(?p);

    var rc: i32 = 0;
    if (diagnostic.len(?diags) != 1)           { rc = 1; }
    or (a.decorator_len != 0)                  { rc = 1; }
    or (a.decl_len < 2)                        { rc = 1; }
    or (a.decls[0].kind != decl.DECL_KIND_FUN) { rc = 1; }
    or (a.decls[0].decorators_len != 0)        { rc = 1; }
    or (a.decls[1].kind != decl.DECL_KIND_FUN) { rc = 1; }
    or (a.decls[1].decorators_len != 0)        { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.decl.parse_tag_decl:generic_cases_keep_payload_presence_and_order" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val source: str = "pub tag Reply[T]: u8 { empty; value: T; pair: rec { first: T; second: T; }; } tag End: u8 { done; }";
    val lexed: R.Result[lexer.TokenStream, str] = lexer.tokenize(source, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](lexed)) { ret 2; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](lexed);
    fin { lexer.dnit(?stream, ?alloc); }
    var a: ast.Ast = ast.init(?alloc, 0::src.FileId);
    fin { ast.dnit(?a); }
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?diags); }
    var p: state.Parser = state.make(?stream, ?a, ?diags);
    parse_module(?p);
    if (p.fatal || diagnostic.len(?diags) != 0 || a.decl_len != 2 || a.tag_case_len != 4) { ret 3; }
    if (a.decls[0].kind != decl.DECL_KIND_TAG || a.decls[0].flags != decl.DECL_FLAG_PUB
        || a.decls[1].kind != decl.DECL_KIND_TAG) { ret 4; }
    val reply: decl.DeclTag = a.decls[0].data.tag_;
    val end: decl.DeclTag = a.decls[1].data.tag_;
    if (reply.generics_len != 1 || reply.cases_start != 0 || reply.cases_len != 3
        || end.generics_len != 0 || end.cases_start != 3 || end.cases_len != 1) { ret 5; }
    if (a.tag_cases[0].payload != id.TYPE_NIL || a.tag_cases[1].payload == id.TYPE_NIL
        || a.tag_cases[2].payload == id.TYPE_NIL || a.tag_cases[3].payload != id.TYPE_NIL) { ret 6; }
    var names: [4]str = [4]str{"empty", "value", "pair", "done"};
    var i: usize = 0;
    for (i < 4) {
        val span: token.Span = a.tag_cases[i].name;
        if (!str_region_equals(source, span.offset, span.len, names[i])) { ret 7; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.fe.parser.decl.parse_tag_decl:recovery_retains_the_following_tag" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val source: str = "tag Broken: u8 { 42; } tag End: u8 { done; }";
    val lexed: R.Result[lexer.TokenStream, str] = lexer.tokenize(source, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](lexed)) { ret 2; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](lexed);
    fin { lexer.dnit(?stream, ?alloc); }
    var a: ast.Ast = ast.init(?alloc, 0::src.FileId);
    fin { ast.dnit(?a); }
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?diags); }
    var p: state.Parser = state.make(?stream, ?a, ?diags);
    parse_module(?p);
    if (p.fatal || diagnostic.len(?diags) != 1 || a.decl_len != 2 || a.tag_case_len != 1) { ret 3; }
    if (a.decls[1].kind != decl.DECL_KIND_TAG || a.decls[1].data.tag_.cases_len != 1) { ret 4; }
    ret 0;
}

pub fun parse_expr(p: *state.Parser) id.ExprId {
    ret parse_expr_bp(p, 0);
}

pub fun parse_expr_bp(p: *state.Parser, min_bp: u8) id.ExprId {
    var lhs: id.ExprId = parse_prefix(p);
    lhs = parse_postfix(p, lhs);

    for (!state.at_eof(p)) {
        val op_tok: token.Token = state.current(p);
        val op_bp:  u8          = token.infix_precedence(op_tok.kind);
        if (op_bp == 0)     { brk; }
        if (op_bp < min_bp) { brk; }

        state.advance(p);

        var right_bp: u8 = op_bp + 1;
        if (token.is_right_assoc(op_tok.kind)) { right_bp = op_bp; }

        val rhs: id.ExprId = parse_expr_bp(p, right_bp);

        var bin: expr.ExprBinary;
        bin.op  = bin_op_from_kind(p, op_tok.kind);
        bin.lhs = lhs;
        bin.rhs = rhs;

        var node: expr.Expr;
        node.span        = span_of_expr_pair(p, lhs, rhs);
        node.kind        = expr.EXPR_KIND_BINARY;
        node.data.binary = bin;
        lhs = state.push_expr(p, node);
    }

    ret lhs;
}

fun at_type_start(p: *state.Parser) bool {
    ret state.at(p, token.KIND_CARET)
     || state.at(p, token.KIND_STAR)
     || state.at(p, token.KIND_LBRACKET)
     || state.at_kw(p, token.KW_FUN)
     || state.at_kw(p, token.KW_REC)
     || state.at_kw(p, token.KW_UNI)
     || state.at(p, token.KIND_DOT_DOT_DOT)
     || state.at(p, token.KIND_DOLLAR)
     || state.at(p, token.KIND_IDENT);
}

pub fun parse_type(p: *state.Parser) id.TypeId {
    if (!state.descend(p)) { ret id.TYPE_NIL; }
    val t: id.TypeId = parse_type_body(p);
    state.ascend(p);
    ret t;
}

fun parse_type_body(p: *state.Parser) id.TypeId {
    val start: token.Token = state.current(p);

    if (state.at(p, token.KIND_CARET))    { ret parse_secret(p, start.span); }
    if (state.at(p, token.KIND_STAR))     { ret parse_ptr(p, start.span); }
    if (state.at(p, token.KIND_LBRACKET)) { ret parse_array(p, start.span); }
    if (state.at_kw(p, token.KW_FUN))            { ret parse_fun(p, start.span); }
    if (state.at_kw(p, token.KW_REC))            { ret parse_rec_or_uni(p, start.span, type.TYPE_KIND_REC); }
    if (state.at_kw(p, token.KW_UNI))            { ret parse_rec_or_uni(p, start.span, type.TYPE_KIND_UNI); }

    if (state.at(p, token.KIND_DOT_DOT_DOT)) {
        state.advance(p);
        var pk: type.Type;
        pk.span = start.span;
        pk.kind = type.TYPE_KIND_PACK;
        ret state.push_type(p, pk);
    }

    if (state.at(p, token.KIND_DOLLAR)) { ret parse_pointee_of(p, start.span); }

    if (at_field_type_spelling(p)) { ret parse_field_type_arg(p); }

    if (state.at(p, token.KIND_IDENT)) { ret parse_named(p, start.span); }

    state.error_recover_advance(p, "expected a type; named, '*T', '[N]T', '$pointee_of(T)', '$discriminant_of(T)', 'fun(...)', or inline 'rec'/'uni' forms are valid here");
    var t: type.Type;
    t.span = start.span;
    t.kind = type.TYPE_KIND_ERROR;
    ret state.push_type(p, t);
}

fun parse_prefix(p: *state.Parser) id.ExprId {
    if (!state.descend(p)) { ret id.EXPR_NIL; }
    val e: id.ExprId = parse_prefix_body(p);
    state.ascend(p);
    ret e;
}

fun parse_prefix_body(p: *state.Parser) id.ExprId {
    val t: token.Token = state.current(p);

    if (t.kind == token.KIND_LIT_INT)   { ret parse_lit_int(p); }
    if (t.kind == token.KIND_LIT_FLOAT) { ret parse_lit_float(p); }
    if (t.kind == token.KIND_LIT_CHAR)  { ret parse_lit_char(p); }
    if (t.kind == token.KIND_LIT_STR)   { ret parse_lit_str(p); }

    if (t.kind == token.KIND_MINUS)    { ret parse_unary(p, expr.UN_NEG); }
    if (t.kind == token.KIND_BANG)     { ret parse_unary(p, expr.UN_NOT); }
    if (t.kind == token.KIND_TILDE)    { ret parse_unary(p, expr.UN_BIT_NOT); }
    if (t.kind == token.KIND_QUESTION) { ret parse_unary(p, expr.UN_ADDR); }
    if (t.kind == token.KIND_AT)       { ret parse_unary(p, expr.UN_DEREF); }

    if (t.kind == token.KIND_LPAREN)   { ret parse_paren(p); }
    if (t.kind == token.KIND_DOLLAR)   { ret parse_comptime_ident(p); }
    if (t.kind == token.KIND_LBRACKET) { ret parse_array_literal(p); }

    if (t.kind == token.KIND_IDENT) {
        if (state.at_kw(p, token.KW_TRY)) { ret parse_try(p); }
        if (state.at_kw(p, token.KW_SEL)) { ret parse_sel(p); }
        if (state.at_kw(p, token.KW_NIL))                           { ret parse_lit_nil(p); }
        if (!p.no_struct_lit && looks_like_typed_literal(p)) { ret parse_typed_literal(p); }
        ret parse_ident(p);
    }

    state.error_recover_advance(p, "expected an expression; literals, identifiers, '(', and unary operators are valid here");
    var node: expr.Expr;
    node.span = t.span;
    node.kind = expr.EXPR_KIND_ERROR;
    ret state.push_expr(p, node);
}

fun parse_postfix(p: *state.Parser, base: id.ExprId) id.ExprId {
    var lhs: id.ExprId = base;
    for (true) {
        val k: token.Kind = state.current(p).kind;
        if (k == token.KIND_LPAREN) { lhs = parse_call(p, lhs, 0, 0, id.EXPR_NIL); }
        or (k == token.KIND_LBRACKET) {
            val after: usize = scan_bracket_close(p, 0);
            if (after != 0 && state.peek(p, after).kind == token.KIND_LPAREN) {
                lhs = parse_bracket_call(p, lhs);
            }
            or {
                lhs = parse_bracket_value(p, lhs);
            }
        }
        or (k == token.KIND_DOT) {
            if (state.peek(p, 1).kind == token.KIND_LBRACKET) {
                lhs = parse_project(p, lhs);
            }
            or {
                lhs = parse_member(p, lhs);
            }
        }
        or (k == token.KIND_COLON_COLON) { lhs = parse_cast(p, lhs, false); }
        or (k == token.KIND_COLON_TILDE) { lhs = parse_cast(p, lhs, true); }
        or (k == token.KIND_COLON_GT)    { lhs = parse_strip(p, lhs); }
        # 5.0.0 flip site: this arm becomes a migration diagnostic naming `:>T`
        or (k == token.KIND_COLON_CARET) { lhs = parse_strip(p, lhs); }
        or {
            brk;
        }
    }
    ret lhs;
}

fun scan_bracket_close(p: *state.Parser, bracket_off: usize) usize {
    var i:     usize = bracket_off + 1;
    var depth: usize = 1;
    for (depth > 0) {
        val k: token.Kind = state.peek(p, i).kind;
        if (k == token.KIND_EOF || k == token.KIND_SEMI) { ret 0; }
        if (k == token.KIND_LBRACKET)                    { depth = depth + 1; }
        or (k == token.KIND_RBRACKET)                    { depth = depth - 1; }
        i = i + 1;
    }
    ret i;
}

fun token_begins_expr(k: token.Kind) bool {
    ret k == token.KIND_LIT_INT   || k == token.KIND_LIT_FLOAT
     || k == token.KIND_LIT_CHAR  || k == token.KIND_LIT_STR
     || k == token.KIND_IDENT     || k == token.KIND_DOLLAR
     || k == token.KIND_MINUS     || k == token.KIND_BANG
     || k == token.KIND_TILDE     || k == token.KIND_QUESTION
     || k == token.KIND_AT        || k == token.KIND_LPAREN
     || k == token.KIND_LBRACKET;
}

rec IndexReading {
    expr:  id.ExprId;
    end:   usize;
    clean: bool;
    diags: usize;
    mark:  ast.AstMark;
    held:  bool;
    panic: bool;
}

rec TypeArgList {
    ok:    bool;
    start: u32;
    len:   u32;
    close: token.Span;
}

fun parse_bracket_call(p: *state.Parser, callee: id.ExprId) id.ExprId {
    var idx: IndexReading;
    probe_index_payload(p, ?idx);
    var targs: TypeArgList;
    parse_type_args_once(p, ?targs);

    if (targs.ok) {
        drop_index_reading(p, ?idx);
        var index_callee: id.ExprId = id.EXPR_NIL;
        if (idx.clean) { index_callee = make_index(p, callee, idx.expr); }
        ret parse_call(p, callee, targs.start, targs.len, index_callee);
    }
    ret take_index_reading(p, callee, ?idx);
}

fun parse_bracket_value(p: *state.Parser, object: id.ExprId) id.ExprId {
    val open: token.Span = state.current(p).span;
    var idx:  IndexReading;
    probe_index_payload(p, ?idx);
    var targs: TypeArgList;
    parse_type_args_once(p, ?targs);

    if (!targs.ok) {
        ret take_index_reading(p, object, ?idx);
    }

    drop_index_reading(p, ?idx);
    val start_span: token.Span = expr_span_or(p, object, open);

    var index_callee: id.ExprId = id.EXPR_NIL;
    if (idx.clean) { index_callee = make_index(p, object, idx.expr); }

    var call: expr.ExprCall;
    call.callee          = object;
    call.args_start      = 0;
    call.args_len        = 0;
    call.type_args_start = targs.start;
    call.type_args_len   = targs.len;
    call.index_callee    = index_callee;

    var node: expr.Expr;
    node.span      = state.span_of(start_span, targs.close);
    node.kind      = expr.EXPR_KIND_GENERIC_INSTANCE;
    node.data.call = call;
    ret state.push_expr(p, node);
}

# reads the payload as an index expression. it is the parse that would happen
# if this reading wins, not a rehearsal of it: panic is left alone so error
# recovery moves the cursor exactly as it would, and what it says goes to the
# buffer rather than the sink until a reading is chosen.
fun probe_index_payload(p: *state.Parser, out: *IndexReading) {
    out.expr  = id.EXPR_NIL;
    out.end   = p.pos;
    out.clean = false;
    out.diags = state.diag_mark(p);
    out.held  = false;
    out.panic = p.panic;
    if (!token_begins_expr(state.peek(p, 1).kind)) { ret; }
    if (state.index_reading_failed_here(p, p.pos))  { ret; }

    val m:              ast.AstMark = state.ast_mark(p);
    val save_pos:       usize       = p.pos;
    val save_panic:     bool        = p.panic;
    val save_buffering: bool        = p.buffering;
    p.buffering = true;
    state.advance(p);
    val before: usize     = p.pos;
    val e:      id.ExprId = parse_expr(p);
    val quiet:  bool      = state.diag_mark(p) == out.diags;
    val clean:  bool      = p.pos > before && !p.fatal && state.at(p, token.KIND_RBRACKET)
                         && quiet;
    out.expr    = e;
    out.end     = p.pos;
    out.clean   = clean;
    out.mark    = m;
    out.held    = true;
    out.panic   = p.panic;
    p.pos       = save_pos;
    p.panic     = save_panic;
    p.buffering = save_buffering;

    if (!clean) { state.record_index_reading_failed(p, save_pos); }
}

# the type reading won, so the index reading never happened: drop what it said
# and, unless its nodes are the ones the generic instance points at, drop those.
fun drop_index_reading(p: *state.Parser, idx: *IndexReading) {
    state.diag_discard(p, idx.diags);
}

# the index reading is the parse. it already walked the payload, so say what it
# said and finish from where it stopped.
fun take_index_reading(p: *state.Parser, object: id.ExprId, idx: *IndexReading) id.ExprId {
    if (!idx.held) {
        state.diag_discard(p, idx.diags);
        ret parse_index(p, object);
    }
    p.pos   = idx.end;
    p.panic = idx.panic;
    state.diag_flush(p, idx.diags);
    ret close_index(p, object, idx.expr);
}

fun parse_type_args_once(p: *state.Parser, out: *TypeArgList) {
    out.ok    = false;
    out.start = 0;
    out.len   = 0;
    out.close = state.current(p).span;

    val m:               ast.AstMark = state.ast_mark(p);
    val save_pos:        usize       = p.pos;
    val save_panic:      bool        = p.panic;
    val save_suppressed: bool        = p.suppressed;
    p.panic      = true;
    p.suppressed = false;
    state.advance(p);

    var buf:    state.ListBuf[id.TypeId] = state.list_buf_init[id.TypeId]();
    var parsed: bool                     = false;
    if (!state.at(p, token.KIND_RBRACKET)) {
        val before: usize = p.pos;
        state.list_buf_push[id.TypeId](p, ?buf, parse_type_arg(p));
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RBRACKET)) { brk; }
            state.list_buf_push[id.TypeId](p, ?buf, parse_type_arg(p));
        }
        parsed = p.pos > before && !p.fatal && state.at(p, token.KIND_RBRACKET)
              && !p.suppressed;
    }

    if (!parsed) {
        state.list_buf_free[id.TypeId](p, ?buf);
        p.pos        = save_pos;
        p.panic      = save_panic;
        p.suppressed = save_suppressed;
        state.ast_rollback(p, m);
        ret;
    }

    out.close = state.current(p).span;
    state.advance(p);
    p.panic      = save_panic;
    p.suppressed = save_suppressed;

    var len: u32 = 0;
    out.start = state.type_id_buf_flush(p, ?buf, ?len);
    out.len   = len;
    out.ok    = true;
}

fun parse_type_arg(p: *state.Parser) id.TypeId {
    if (at_field_type_arg(p)) { ret parse_field_type_arg(p); }
    ret parse_type(p);
}

fun make_index(p: *state.Parser, object: id.ExprId, index: id.ExprId) id.ExprId {
    var node_index: expr.ExprIndex;
    node_index.object = object;
    node_index.index  = index;

    val cur:        token.Span = state.current(p).span;
    val start_span: token.Span = expr_span_or(p, object, cur);
    val end_span:   token.Span = expr_span_or(p, index, start_span);

    var node: expr.Expr;
    node.span       = state.span_of(start_span, end_span);
    node.kind       = expr.EXPR_KIND_INDEX;
    node.data.index = node_index;
    ret state.push_expr(p, node);
}

fun parse_lit_int(p: *state.Parser) id.ExprId {
    val t: token.Token = state.advance(p);
    var node: expr.Expr;
    node.span = t.span;
    node.kind = expr.EXPR_KIND_LIT_INT;
    val res_int: R.Result[comptime.LitInt, str] = comptime.scan_lit_int(p.tokens.source, t.span);
    if (R.is_err[comptime.LitInt, str](res_int)) {
        state.error_at(p, t.span, R.unwrap_err[comptime.LitInt, str](res_int));
        node.data.lit_int.value  = 0;
        node.data.lit_int.suffix = expr.LIT_SUFFIX_NONE;
    }
    or {
        val lit: comptime.LitInt = R.unwrap_ok[comptime.LitInt, str](res_int);
        node.data.lit_int.value  = lit.value;
        node.data.lit_int.suffix = lit.suffix;
    }
    ret state.push_expr(p, node);
}

fun parse_lit_float(p: *state.Parser) id.ExprId {
    val t: token.Token = state.advance(p);
    var node: expr.Expr;
    node.span = t.span;
    node.kind = expr.EXPR_KIND_LIT_FLOAT;
    val res_float: R.Result[comptime.LitFloat, str] = comptime.scan_lit_float(p.tokens.source, t.span);
    if (R.is_err[comptime.LitFloat, str](res_float)) {
        state.error_at(p, t.span, R.unwrap_err[comptime.LitFloat, str](res_float));
        node.data.lit_float.value  = 0.0;
        node.data.lit_float.suffix = expr.LIT_SUFFIX_NONE;
    }
    or {
        val lit: comptime.LitFloat = R.unwrap_ok[comptime.LitFloat, str](res_float);
        node.data.lit_float.value  = lit.value;
        node.data.lit_float.suffix = lit.suffix;
    }
    ret state.push_expr(p, node);
}

fun parse_lit_char(p: *state.Parser) id.ExprId {
    val t: token.Token = state.advance(p);
    var node: expr.Expr;
    node.span = t.span;
    node.kind = expr.EXPR_KIND_LIT_CHAR;
    val res_char: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.eval_lit_char(p.tokens.source, t.span);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_char)) {
        state.error_at(p, t.span, R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_char).message);
        node.data.lit_char = 0;
    }
    or {
        val cv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_char);
        node.data.lit_char = cv.data.i::u32;
    }
    ret state.push_expr(p, node);
}

fun parse_lit_str(p: *state.Parser) id.ExprId {
    val t: token.Token = state.advance(p);
    var node: expr.Expr;
    node.span = t.span;
    node.kind = expr.EXPR_KIND_LIT_STR;
    ret state.push_expr(p, node);
}

fun parse_lit_nil(p: *state.Parser) id.ExprId {
    val t: token.Token = state.advance(p);
    var node: expr.Expr;
    node.span = t.span;
    node.kind = expr.EXPR_KIND_LIT_NIL;
    ret state.push_expr(p, node);
}

fun parse_ident(p: *state.Parser) id.ExprId {
    val t: token.Token = state.advance(p);
    var node: expr.Expr;
    node.span = t.span;
    node.kind = expr.EXPR_KIND_IDENT;
    ret state.push_expr(p, node);
}

fun parse_comptime_ident(p: *state.Parser) id.ExprId {
    val dollar: token.Token = state.advance(p);
    var end: token.Span = dollar.span;
    if (state.at(p, token.KIND_IDENT)) {
        end = state.advance(p).span;
    }
    or {
        state.error_at_current(p, "expected an identifier after '$'");
    }

    var node: expr.Expr;
    node.span = state.span_of(dollar.span, end);
    node.kind = expr.EXPR_KIND_COMPTIME_IDENT;
    ret state.push_expr(p, node);
}

fun parse_unary(p: *state.Parser, op: expr.UnOp) id.ExprId {
    val start: token.Token = state.advance(p);
    var operand: id.ExprId = parse_prefix(p);
    operand = parse_postfix(p, operand);

    var unary: expr.ExprUnary;
    unary.op      = op;
    unary.operand = operand;

    val end_span: token.Span = expr_span_or(p, operand, start.span);

    var node: expr.Expr;
    node.span       = state.span_of(start.span, end_span);
    node.kind       = expr.EXPR_KIND_UNARY;
    node.data.unary = unary;
    ret state.push_expr(p, node);
}

# `sel place.case` binds tighter than every binary operator and looser than postfix
fun parse_sel(p: *state.Parser) id.ExprId {
    val start: token.Token = state.advance(p);
    var operand: id.ExprId = parse_prefix(p);
    operand = parse_postfix(p, operand);

    var node: expr.Expr;
    node.span = state.span_of(start.span, expr_span_or(p, operand, start.span));
    node.kind = expr.EXPR_KIND_SEL;

    val e_opt: O.Option[*expr.Expr] = ast.get_expr(p.ast, operand);
    if (O.is_some[*expr.Expr](e_opt) && O.unwrap[*expr.Expr](e_opt).kind == expr.EXPR_KIND_PROJECT) {
        val proj: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
        node.data.sel = expr.ExprSel{place: proj.data.project.object, case_name: token.Span{offset: proj.span.offset, len: 0},
            case_desc: proj.data.project.field};
        ret state.push_expr(p, node);
    }
    if (O.is_none[*expr.Expr](e_opt) || O.unwrap[*expr.Expr](e_opt).kind != expr.EXPR_KIND_MEMBER) {
        state.error_at(p, node.span, "`sel` tests one case of a place: write `sel place.case` or `sel place.[case]`");
        node.kind = expr.EXPR_KIND_ERROR;
        ret state.push_expr(p, node);
    }
    val member: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    node.data.sel = expr.ExprSel{place: member.data.member.object, case_name: member.data.member.name, case_desc: id.EXPR_NIL};
    ret state.push_expr(p, node);
}

fun parse_try(p: *state.Parser) id.ExprId {
    val start: token.Token = state.advance(p);
    var body: expr.ExprTry;
    body.operand = parse_prefix(p);
    body.operand = parse_postfix(p, body.operand);
    body.error_type = id.TYPE_NIL;
    body.failure = id.STMT_NIL;
    var node: expr.Expr;
    node.span = state.span_of(start.span, expr_span_or(p, body.operand, start.span));
    node.kind = expr.EXPR_KIND_ERROR;
    if (!state.eat_kw(p, token.KW_OR)) {
        state.error_at_current(p, "expected 'or' and a failure block after try operand");
        ret state.push_expr(p, node);
    }
    if (state.eat(p, token.KIND_LPAREN)) {
        if (!state.at(p, token.KIND_IDENT)) {
            state.error_at_current(p, "expected failure binding name");
            ret state.push_expr(p, node);
        }
        body.error_name = state.advance(p).span;
        if (!state.expect(p, token.KIND_COLON, "failure bindings require an explicit type")) {
            ret state.push_expr(p, node);
        }
        body.error_type = parse_type(p);
        if (!state.expect(p, token.KIND_RPAREN, "expected ')' after failure binding")) {
            ret state.push_expr(p, node);
        }
    }
    if (!state.at(p, token.KIND_LBRACE)) {
        state.error_at_current(p, "expected a block after try failure binding");
        ret state.push_expr(p, node);
    }
    val no_struct_lit: bool = p.no_struct_lit;
    p.no_struct_lit = false;
    body.failure = parse_stmt(p);
    p.no_struct_lit = no_struct_lit;
    node.span = state.span_of(start.span, p.tokens.tokens[p.pos - 1].span);
    node.kind = expr.EXPR_KIND_TRY;
    node.data.try_ = body;
    ret state.push_expr(p, node);
}

fun parse_paren(p: *state.Parser) id.ExprId {
    state.advance(p);
    val inner: id.ExprId = parse_expr(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' after parenthesized expression");
    ret inner;
}

fun parse_call_arg(p: *state.Parser) id.ExprId {
    val e: id.ExprId = parse_expr(p);
    if (!state.at(p, token.KIND_DOT_DOT_DOT)) { ret e; }
    val dots: token.Token = state.advance(p);

    var sp: expr.ExprSpread;
    sp.inner = e;

    val start_span: token.Span = expr_span_or(p, e, dots.span);

    var node: expr.Expr;
    node.span        = state.span_of(start_span, dots.span);
    node.kind        = expr.EXPR_KIND_SPREAD;
    node.data.spread = sp;
    ret state.push_expr(p, node);
}

fun callee_takes_type_operand(p: *state.Parser, callee: id.ExprId) bool {
    val ce_opt: O.Option[*expr.Expr] = ast.get_expr(p.ast, callee);
    if (O.is_none[*expr.Expr](ce_opt)) { ret false; }
    val ce: *expr.Expr = O.unwrap[*expr.Expr](ce_opt);
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret false; }
    ret comptime.intrinsic_takes_type_operand(p.tokens.source, ce.span);
}

fun at_field_type_operand(p: *state.Parser) bool {
    if (!state.at(p, token.KIND_IDENT)) { ret false; }
    if (state.peek(p, 1::usize).kind != token.KIND_DOT) { ret false; }

    val member: token.Token = state.peek(p, 2::usize);
    if (member.kind != token.KIND_IDENT) { ret false; }
    if (!str_region_equals(p.tokens.source, member.span.offset, member.span.len, "type")) { ret false; }

    val after: token.Kind = state.peek(p, 3::usize).kind;
    ret after == token.KIND_RPAREN || after == token.KIND_COMMA;
}

fun at_field_type_arg(p: *state.Parser) bool {
    if (!state.at(p, token.KIND_IDENT)) { ret false; }
    if (state.peek(p, 1::usize).kind != token.KIND_DOT) { ret false; }

    val member: token.Token = state.peek(p, 2::usize);
    if (member.kind != token.KIND_IDENT) { ret false; }
    if (!str_region_equals(p.tokens.source, member.span.offset, member.span.len, "type")) { ret false; }

    val after: token.Kind = state.peek(p, 3::usize).kind;
    ret after == token.KIND_RBRACKET || after == token.KIND_COMMA;
}

fun at_field_type_spelling(p: *state.Parser) bool {
    if (!state.at(p, token.KIND_IDENT)) { ret false; }
    if (state.peek(p, 1::usize).kind != token.KIND_DOT) { ret false; }

    val member: token.Token = state.peek(p, 2::usize);
    if (member.kind != token.KIND_IDENT) { ret false; }
    if (!str_region_equals(p.tokens.source, member.span.offset, member.span.len, "type")) { ret false; }

    val after: token.Kind = state.peek(p, 3::usize).kind;
    ret after != token.KIND_DOT && after != token.KIND_LBRACKET;
}

fun parse_pointee_of(p: *state.Parser, start: token.Span) id.TypeId {
    state.advance(p);
    var kind: type.TypeKind = type.TYPE_KIND_ERROR;
    if (state.at(p, token.KIND_IDENT)) {
        val here: token.Span = state.current(p).span;
        if (str_region_equals(p.tokens.source, here.offset, here.len, "pointee_of")) { kind = type.TYPE_KIND_POINTEE_OF; }
        or (str_region_equals(p.tokens.source, here.offset, here.len, "discriminant_of")) { kind = type.TYPE_KIND_DISCRIMINANT_OF; }
    }
    if (kind == type.TYPE_KIND_ERROR) {
        val was_panicking: bool = p.panic;
        state.error_at_current(p, "expected `pointee_of` or `discriminant_of` after '$' in a type; `$pointee_of(T)` and `$discriminant_of(T)` are the only comptime type constructors");
        var bad_end: token.Span = start;
        if (!was_panicking && state.at(p, token.KIND_IDENT)) { bad_end = state.advance(p).span; }
        var bad: type.Type;
        bad.span = state.span_of(start, bad_end);
        bad.kind = type.TYPE_KIND_ERROR;
        ret state.push_type(p, bad);
    }
    state.advance(p);
    state.expect(p, token.KIND_LPAREN, "expected '(' after a comptime type constructor");
    val inner: id.TypeId = parse_type(p);
    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' to close the comptime type constructor");

    var t: type.Type;
    t.span = state.span_of(start, close.span);
    t.kind = kind;
    if (kind == type.TYPE_KIND_POINTEE_OF) { t.data.pointee_of = type.TypePointeeOf{inner: inner}; }
    or { t.data.discriminant_of = type.TypeDiscriminantOf{inner: inner}; }
    ret state.push_type(p, t);
}

fun parse_field_type_arg(p: *state.Parser) id.TypeId {
    val var_tok: token.Token = state.current(p);
    state.advance(p);
    state.advance(p);
    val member: token.Token = state.current(p);
    state.advance(p);

    var payload: type.TypeFieldType;
    payload.var_name = var_tok.span;

    var span: token.Span = var_tok.span;
    span.len = (member.span.offset + member.span.len) - var_tok.span.offset;

    var node: type.Type;
    node.span            = span;
    node.kind            = type.TYPE_KIND_FIELD_TYPE;
    node.data.field_type = payload;
    ret state.push_type(p, node);
}

fun mark_operand_slot(p: *state.Parser, tid: id.TypeId) {
    val t_opt: O.Option[*type.Type] = ast.get_type(p.ast, tid);
    if (O.is_none[*type.Type](t_opt)) { ret; }
    val t: *type.Type = O.unwrap[*type.Type](t_opt);
    if (t.kind != type.TYPE_KIND_NAMED) { ret; }
    t.data.named.operand = true;
}

fun parse_type_operand(p: *state.Parser) id.ExprId {
    val start: token.Span = state.current(p).span;
    val tid:   id.TypeId  = parse_type(p);
    mark_operand_slot(p, tid);

    var payload: expr.ExprTypeRef;
    payload.ty = tid;

    var span: token.Span = start;
    val t_opt: O.Option[*type.Type] = ast.get_type(p.ast, tid);
    if (O.is_some[*type.Type](t_opt)) { span = O.unwrap[*type.Type](t_opt).span; }

    var node: expr.Expr;
    node.span          = span;
    node.kind          = expr.EXPR_KIND_TYPE_REF;
    node.data.type_ref = payload;
    ret state.push_expr(p, node);
}

fun parse_call(p: *state.Parser, callee: id.ExprId, type_args_start: u32, type_args_len: u32, index_callee: id.ExprId) id.ExprId {
    state.advance(p);
    val type_operand: bool = callee_takes_type_operand(p, callee);

    var buf: state.ListBuf[id.ExprId] = state.list_buf_init[id.ExprId]();
    if (!state.at(p, token.KIND_RPAREN)) {
        if (type_operand && !at_field_type_operand(p)) { state.list_buf_push[id.ExprId](p, ?buf, parse_type_operand(p)); }
        or                                             { state.list_buf_push[id.ExprId](p, ?buf, parse_call_arg(p)); }
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RPAREN)) { brk; }
            state.list_buf_push[id.ExprId](p, ?buf, parse_call_arg(p));
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' to close call arguments");

    var args_len:   u32 = 0;
    val args_start: u32 = state.expr_id_buf_flush(p, ?buf, ?args_len);

    var call: expr.ExprCall;
    call.callee          = callee;
    call.args_start      = args_start;
    call.args_len        = args_len;
    call.type_args_start = type_args_start;
    call.type_args_len   = type_args_len;
    call.index_callee    = index_callee;

    val start_span: token.Span = expr_span_or(p, callee, close.span);

    var node: expr.Expr;
    node.span      = state.span_of(start_span, close.span);
    node.kind      = expr.EXPR_KIND_CALL;
    node.data.call = call;
    ret state.push_expr(p, node);
}

fun parse_index(p: *state.Parser, object: id.ExprId) id.ExprId {
    state.advance(p);
    val idx: id.ExprId = parse_expr(p);
    ret close_index(p, object, idx);
}

fun close_index(p: *state.Parser, object: id.ExprId, idx: id.ExprId) id.ExprId {
    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACKET, "expected ']' to close index expression");

    var index: expr.ExprIndex;
    index.object = object;
    index.index  = idx;

    val start_span: token.Span = expr_span_or(p, object, close.span);

    var node: expr.Expr;
    node.span       = state.span_of(start_span, close.span);
    node.kind       = expr.EXPR_KIND_INDEX;
    node.data.index = index;
    ret state.push_expr(p, node);
}

fun parse_member(p: *state.Parser, object: id.ExprId) id.ExprId {
    val dot: token.Token = state.advance(p);
    if (!state.at(p, token.KIND_IDENT)) {
        state.error_at_current(p, "expected field name after '.'");
        var empty_name: token.Span;
        empty_name.offset = state.current(p).span.offset;
        empty_name.len    = 0;

        var bad_member: expr.ExprMember;
        bad_member.object = object;
        bad_member.name   = empty_name;

        var err_node: expr.Expr;
        err_node.span        = expr_span_or(p, object, dot.span);
        err_node.kind        = expr.EXPR_KIND_MEMBER;
        err_node.data.member = bad_member;
        ret state.push_expr(p, err_node);
    }
    val name_tok: token.Token = state.advance(p);

    var member: expr.ExprMember;
    member.object = object;
    member.name   = name_tok.span;

    val start_span: token.Span = expr_span_or(p, object, name_tok.span);

    var node: expr.Expr;
    node.span        = state.span_of(start_span, name_tok.span);
    node.kind        = expr.EXPR_KIND_MEMBER;
    node.data.member = member;
    ret state.push_expr(p, node);
}

fun parse_project(p: *state.Parser, object: id.ExprId) id.ExprId {
    state.expect(p, token.KIND_DOT, "expected '.' before '[' in a field projection");
    state.expect(p, token.KIND_LBRACKET, "expected '[' in a field projection");
    val field: id.ExprId = parse_expr(p);
    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACKET, "expected ']' to close a field projection");

    var proj: expr.ExprProject;
    proj.object = object;
    proj.field  = field;

    val start_span: token.Span = expr_span_or(p, object, close.span);

    var node: expr.Expr;
    node.span         = state.span_of(start_span, close.span);
    node.kind         = expr.EXPR_KIND_PROJECT;
    node.data.project = proj;
    ret state.push_expr(p, node);
}

fun parse_cast(p: *state.Parser, value: id.ExprId, reinterpret: bool) id.ExprId {
    state.advance(p);
    val ty: id.TypeId = parse_type(p);

    var cast: expr.ExprCast;
    cast.value       = value;
    cast.ty          = ty;
    cast.reinterpret = reinterpret;

    val cur:        token.Span = state.current(p).span;
    val start_span: token.Span = expr_span_or(p, value, cur);
    val end_span:   token.Span = type_span_or(p, ty, start_span);

    var node: expr.Expr;
    node.span      = state.span_of(start_span, end_span);
    node.kind      = expr.EXPR_KIND_CAST;
    node.data.cast = cast;
    ret state.push_expr(p, node);
}

fun parse_strip(p: *state.Parser, value: id.ExprId) id.ExprId {
    val op: token.Token = state.current(p);
    state.advance(p);

    var ty: id.TypeId = id.TYPE_NIL;
    if (at_type_start(p)) {
        ty = parse_type(p);
    }
    or (op.kind == token.KIND_COLON_GT) {
        state.error_at_current(p, "expected a type after ':>'; declassification always names its public result type, as in `x:>u32`");
    }

    var strip: expr.ExprStrip;
    strip.value = value;
    strip.ty    = ty;

    val start_span: token.Span = expr_span_or(p, value, op.span);
    var end_span:   token.Span = op.span;
    if (ty != id.TYPE_NIL) { end_span = type_span_or(p, ty, op.span); }

    var node: expr.Expr;
    node.span       = state.span_of(start_span, end_span);
    node.kind       = expr.EXPR_KIND_STRIP;
    node.data.strip = strip;
    ret state.push_expr(p, node);
}

fun parse_array_literal(p: *state.Parser) id.ExprId {
    val start: token.Token = state.current(p);
    val ty: id.TypeId = parse_type(p);
    state.expect(p, token.KIND_LBRACE, "expected '{' after array type in array literal");

    var buf: state.ListBuf[id.ExprId] = state.list_buf_init[id.ExprId]();
    if (!state.at(p, token.KIND_RBRACE)) {
        state.list_buf_push[id.ExprId](p, ?buf, parse_expr(p));
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RBRACE)) { brk; }
            state.list_buf_push[id.ExprId](p, ?buf, parse_expr(p));
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close array literal");

    var elems_len:   u32 = 0;
    val elems_start: u32 = state.expr_id_buf_flush(p, ?buf, ?elems_len);

    var array: expr.ExprArrayLit;
    array.ty          = ty;
    array.elems_start = elems_start;
    array.elems_len   = elems_len;

    var node: expr.Expr;
    node.span           = state.span_of(start.span, close.span);
    node.kind           = expr.EXPR_KIND_ARRAY_LIT;
    node.data.array_lit = array;
    ret state.push_expr(p, node);
}

fun parse_typed_literal(p: *state.Parser) id.ExprId {
    val start_tok: token.Token = state.current(p);
    val ty: id.TypeId = parse_literal_head(p);
    state.expect(p, token.KIND_LBRACE, "expected '{' after type in struct or vector literal");

    var buf: state.ListBuf[expr.FieldInit] = state.list_buf_init[expr.FieldInit]();
    if (!state.at(p, token.KIND_RBRACE)) {
        if (!parse_field_init(p, ?buf)) {
            state.sync_to(p, token.KIND_RBRACE, token.KIND_EOF, token.KIND_EOF);
        }
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RBRACE)) { brk; }
            if (!parse_field_init(p, ?buf)) {
                state.sync_to(p, token.KIND_RBRACE, token.KIND_EOF, token.KIND_EOF);
                brk;
            }
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close struct literal");

    var fields_len:   u32 = 0;
    val fields_start: u32 = state.field_init_buf_flush(p, ?buf, ?fields_len);

    var values: state.ListBuf[id.ExprId] = state.list_buf_init[id.ExprId]();
    var named: bool = false;
    var bare: bool = false;
    var i: u32 = 0;
    for (i < fields_len) {
        val field: *expr.FieldInit = ?p.ast.field_inits[fields_start + i];
        if (field.form == expr.INIT_NAMED) { named = true; }
        if (field.form == expr.INIT_BARE) { bare = true; }
        state.list_buf_push[id.ExprId](p, ?values, field.value);
        i = i + 1;
    }
    var elems_len: u32 = 0;
    val elems_start: u32 = state.expr_id_buf_flush(p, ?values, ?elems_len);
    var node: expr.Expr;
    node.span = state.span_of(start_tok.span, close.span);
    if (!named && !bare && fields_len != 0) {
        node.kind = expr.EXPR_KIND_VECTOR_LIT;
        node.data.vector_lit = expr.ExprVectorLit{ ty: ty, elems_start: elems_start, elems_len: elems_len };
    }
    or {
        node.kind = expr.EXPR_KIND_STRUCT_LIT;
        node.data.struct_lit = expr.ExprStructLit{ ty: ty, fields_start: fields_start, fields_len: fields_len,
            elems_start: elems_start, elems_len: elems_len };
    }
    ret state.push_expr(p, node);
}

fun parse_field_init(p: *state.Parser, buf: *state.ListBuf[expr.FieldInit]) bool {
    var field: expr.FieldInit;
    if (state.at(p, token.KIND_IDENT) && state.peek(p, 1).kind == token.KIND_COLON) {
        field.name = state.advance(p).span;
        state.advance(p);
        field.value = parse_expr(p);
        field.form = expr.INIT_NAMED;
    }
    or {
        field.value = parse_expr(p);
        val selected: O.Option[*expr.Expr] = ast.get_expr(p.ast, field.value);
        if (O.is_none[*expr.Expr](selected)) { ret false; }
        val value: *expr.Expr = O.unwrap[*expr.Expr](selected);
        field.name = value.span;
        field.form = expr.INIT_POSITIONAL;
        if (value.kind == expr.EXPR_KIND_IDENT) { field.form = expr.INIT_BARE; }
    }
    if (!state.at(p, token.KIND_COMMA) && !state.at(p, token.KIND_RBRACE)) {
        state.error_at_current(p, "expected ':' between field name and value");
        ret false;
    }
    state.list_buf_push[expr.FieldInit](p, buf, field);
    ret true;
}

# after generic arguments a trailing `.case` or `.[case]` is unambiguous, so the head parser keeps it
fun parse_literal_head(p: *state.Parser) id.TypeId {
    val tid: id.TypeId = parse_type(p);
    if (!state.at(p, token.KIND_DOT)) { ret tid; }
    val bracketed: bool = state.peek(p, 1).kind == token.KIND_LBRACKET;
    if (!bracketed && state.peek(p, 1).kind != token.KIND_IDENT) { ret tid; }
    val t_opt: O.Option[*type.Type] = ast.get_type(p.ast, tid);
    if (O.is_none[*type.Type](t_opt)) { ret tid; }
    val t: *type.Type = O.unwrap[*type.Type](t_opt);
    if (t.kind != type.TYPE_KIND_NAMED) { ret tid; }
    state.advance(p);
    if (bracketed) {
        state.advance(p);
        val desc: id.ExprId = parse_expr(p);
        val close: token.Token = state.current(p);
        state.expect(p, token.KIND_RBRACKET, "expected ']' to close a case descriptor in a literal head");
        t.data.named.case_desc = desc;
        t.span = state.span_of(t.span, close.span);
        ret tid;
    }
    val case_tok: token.Token = state.advance(p);
    t.data.named.case_name = case_tok.span;
    t.span = state.span_of(t.span, case_tok.span);
    ret tid;
}

fun looks_like_typed_literal(p: *state.Parser) bool {
    if (state.current(p).kind != token.KIND_IDENT) { ret false; }

    var i: usize = 1;
    for (state.peek(p, i).kind == token.KIND_DOT && state.peek(p, i + 1).kind == token.KIND_IDENT) {
        i = i + 2;
    }

    if (state.peek(p, i).kind == token.KIND_LBRACKET) {
        val after: usize = scan_bracket_close(p, i);
        if (after == 0) { ret false; }
        i = after;
        if (state.peek(p, i).kind == token.KIND_DOT && state.peek(p, i + 1).kind == token.KIND_IDENT) {
            i = i + 2;
        }
    }

    # `T.[case]{...}` constructs through a comptime case descriptor
    if (state.peek(p, i).kind == token.KIND_DOT && state.peek(p, i + 1).kind == token.KIND_LBRACKET) {
        val after: usize = scan_bracket_close(p, i + 1);
        if (after == 0) { ret false; }
        i = after;
    }

    ret state.peek(p, i).kind == token.KIND_LBRACE;
}

fun bin_op_from_kind(p: *state.Parser, kind: token.Kind) expr.BinOp {
    if (kind == token.KIND_PLUS)      { ret expr.BIN_ADD; }
    if (kind == token.KIND_MINUS)     { ret expr.BIN_SUB; }
    if (kind == token.KIND_STAR)      { ret expr.BIN_MUL; }
    if (kind == token.KIND_SLASH)     { ret expr.BIN_DIV; }
    if (kind == token.KIND_PERCENT)   { ret expr.BIN_MOD; }
    if (kind == token.KIND_EQ_EQ)     { ret expr.BIN_EQ; }
    if (kind == token.KIND_BANG_EQ)   { ret expr.BIN_NEQ; }
    if (kind == token.KIND_LT)        { ret expr.BIN_LT; }
    if (kind == token.KIND_LT_EQ)     { ret expr.BIN_LEQ; }
    if (kind == token.KIND_GT)        { ret expr.BIN_GT; }
    if (kind == token.KIND_GT_EQ)     { ret expr.BIN_GEQ; }
    if (kind == token.KIND_AMP_AMP)   { ret expr.BIN_AND; }
    if (kind == token.KIND_PIPE_PIPE) { ret expr.BIN_OR; }
    if (kind == token.KIND_AMP)       { ret expr.BIN_BIT_AND; }
    if (kind == token.KIND_PIPE)      { ret expr.BIN_BIT_OR; }
    if (kind == token.KIND_CARET)     { ret expr.BIN_BIT_XOR; }
    if (kind == token.KIND_LT_LT)     { ret expr.BIN_SHL; }
    if (kind == token.KIND_GT_GT)     { ret expr.BIN_SHR; }
    if (kind == token.KIND_EQ)        { ret expr.BIN_ASSIGN; }

    state.fatal_ice_at(p, state.current(p).span, "internal compiler error: infix operator has no binary-operator mapping");
    ret expr.BIN_ASSIGN;
}

fun span_of_expr_pair(p: *state.Parser, lhs: id.ExprId, rhs: id.ExprId) token.Span {
    val cur: token.Span = state.current(p).span;
    ret state.span_of(expr_span_or(p, lhs, cur), expr_span_or(p, rhs, cur));
}

fun expr_span_or(p: *state.Parser, eid: id.ExprId, fallback: token.Span) token.Span {
    if (eid == id.EXPR_NIL) { ret fallback; }
    ret O.unwrap[*expr.Expr](ast.get_expr(p.ast, eid)).span;
}

fun type_span_or(p: *state.Parser, tid: id.TypeId, fallback: token.Span) token.Span {
    if (tid == id.TYPE_NIL) { ret fallback; }
    ret O.unwrap[*type.Type](ast.get_type(p.ast, tid)).span;
}

fun parse_named(p: *state.Parser, start: token.Span) id.TypeId {
    var last: token.Span = state.advance(p).span;

    for (state.at(p, token.KIND_DOT) && state.peek(p, 1).kind == token.KIND_IDENT) {
        state.advance(p);
        last = state.advance(p).span;
    }

    val path_span: token.Span = state.span_of(start, last);

    var args_start: u32        = 0;
    var args_len:   u32        = 0;
    var end:        token.Span = last;

    if (state.eat(p, token.KIND_LBRACKET)) {
        var buf: state.ListBuf[id.TypeId] = state.list_buf_init[id.TypeId]();
        if (!state.at(p, token.KIND_RBRACKET)) {
            state.list_buf_push[id.TypeId](p, ?buf, parse_type(p));
            for (state.eat(p, token.KIND_COMMA)) {
                if (state.at(p, token.KIND_RBRACKET)) { brk; }
                state.list_buf_push[id.TypeId](p, ?buf, parse_type(p));
            }
        }
        val close: token.Token = state.current(p);
        state.expect(p, token.KIND_RBRACKET, "expected ']' to close generic arguments");
        end = close.span;
        args_start = state.type_id_buf_flush(p, ?buf, ?args_len);
    }

    var named: type.TypeNamed;
    named.name       = path_span;
    named.args_start = args_start;
    named.args_len   = args_len;
    named.operand    = false;
    named.case_name  = token.Span{offset: path_span.offset, len: 0};
    named.case_desc  = id.EXPR_NIL;

    var t: type.Type;
    t.span       = state.span_of(start, end);
    t.kind       = type.TYPE_KIND_NAMED;
    t.data.named = named;
    ret state.push_type(p, t);
}

fun parse_ptr(p: *state.Parser, start: token.Span) id.TypeId {
    state.advance(p);
    val inner: id.TypeId = parse_type(p);

    var ptr: type.TypePtr;
    ptr.pointee = inner;

    val end_span: token.Span = type_span_or(p, inner, start);

    var t: type.Type;
    t.span     = state.span_of(start, end_span);
    t.kind     = type.TYPE_KIND_PTR;
    t.data.ptr = ptr;
    ret state.push_type(p, t);
}

fun parse_secret(p: *state.Parser, start: token.Span) id.TypeId {
    state.advance(p);
    val inner: id.TypeId = parse_type(p);

    var secret: type.TypeSecret;
    secret.inner = inner;

    val end_span: token.Span = type_span_or(p, inner, start);

    var t: type.Type;
    t.span        = state.span_of(start, end_span);
    t.kind        = type.TYPE_KIND_SECRET;
    t.data.secret = secret;
    ret state.push_type(p, t);
}

fun parse_array(p: *state.Parser, start: token.Span) id.TypeId {
    state.advance(p);
    var length: id.ExprId = id.EXPR_NIL;
    if (state.at_kw(p, "_") && state.peek(p, 1::usize).kind == token.KIND_RBRACKET) {
        state.advance(p);
    }
    or {
        length = parse_expr(p);
    }
    state.expect(p, token.KIND_RBRACKET, "expected ']' after array length");

    val element: id.TypeId = parse_type(p);

    var array: type.TypeArray;
    array.length  = length;
    array.element = element;

    val end_span: token.Span = type_span_or(p, element, start);

    var t: type.Type;
    t.span       = state.span_of(start, end_span);
    t.kind       = type.TYPE_KIND_ARRAY;
    t.data.array = array;
    ret state.push_type(p, t);
}

fun parse_fun(p: *state.Parser, start: token.Span) id.TypeId {
    state.advance(p);
    state.expect(p, token.KIND_LPAREN, "expected '(' after 'fun'");

    var buf: state.ListBuf[id.TypeId] = state.list_buf_init[id.TypeId]();

    var c_variadic: bool = false;
    if (state.at(p, token.KIND_DOT_DOT_DOT)) {
        state.error_at_current(p, "a C-variadic function type needs at least one fixed parameter before `...`");
        state.advance(p);
    }
    or (!state.at(p, token.KIND_RPAREN)) {
        state.list_buf_push[id.TypeId](p, ?buf, parse_type(p));
        for (state.eat(p, token.KIND_COMMA)) {
            if (state.at(p, token.KIND_RPAREN)) { brk; }
            if (state.at(p, token.KIND_DOT_DOT_DOT)) {
                c_variadic = true;
                state.advance(p);
                brk;
            }
            state.list_buf_push[id.TypeId](p, ?buf, parse_type(p));
        }
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RPAREN, "expected ')' to close function parameters");

    var params_len:   u32 = 0;
    val params_start: u32 = state.type_id_buf_flush(p, ?buf, ?params_len);

    var ret_type: id.TypeId  = id.TYPE_NIL;
    var end_span: token.Span = close.span;
    if (!at_type_boundary(p)) {
        ret_type = parse_type(p);
        end_span = type_span_or(p, ret_type, end_span);
    }

    var fun_: type.TypeFun;
    fun_.params_start = params_start;
    fun_.params_len   = params_len;
    fun_.ret_type     = ret_type;
    fun_.c_variadic   = c_variadic;

    var t: type.Type;
    t.span      = state.span_of(start, end_span);
    t.kind      = type.TYPE_KIND_FUN;
    t.data.fun_ = fun_;
    ret state.push_type(p, t);
}

fun parse_rec_or_uni(p: *state.Parser, start: token.Span, kind: type.TypeKind) id.TypeId {
    state.advance(p);
    state.expect(p, token.KIND_LBRACE, "expected '{' to open anonymous type body");

    var buf: state.ListBuf[decl.TypedName] = state.list_buf_init[decl.TypedName]();

    for (!state.at(p, token.KIND_RBRACE) && !state.at_eof(p)) {
        if (!state.at(p, token.KIND_IDENT)) {
            state.error_at_current(p, "expected a field name in anonymous type body");
            state.sync_to(p, token.KIND_SEMI, token.KIND_RBRACE, token.KIND_EOF);
            if (state.at(p, token.KIND_SEMI)) { state.advance(p); }
            cnt;
        }
        val name: token.Span = state.advance(p).span;
        state.expect(p, token.KIND_COLON, "expected ':' between field name and type");
        val ty: id.TypeId = parse_type(p);

        var tn: decl.TypedName;
        tn.name     = name;
        tn.ty       = ty;
        tn.comptime = false;
        state.list_buf_push[decl.TypedName](p, ?buf, tn);

        state.expect(p, token.KIND_SEMI, "expected ';' after field declaration");
    }

    val close: token.Token = state.current(p);
    state.expect(p, token.KIND_RBRACE, "expected '}' to close anonymous type body");

    var fields_len:   u32 = 0;
    val fields_start: u32 = state.typed_name_buf_flush(p, ?buf, ?fields_len);

    var t: type.Type;
    t.span = state.span_of(start, close.span);
    t.kind = kind;
    if (kind == type.TYPE_KIND_REC) {
        var r: type.TypeRec;
        r.fields_start = fields_start;
        r.fields_len   = fields_len;
        t.data.rec_    = r;
    }
    or {
        var u: type.TypeUni;
        u.fields_start = fields_start;
        u.fields_len   = fields_len;
        t.data.uni_    = u;
    }
    ret state.push_type(p, t);
}

fun at_type_boundary(p: *state.Parser) bool {
    val k: token.Kind = state.current(p).kind;
    if (k == token.KIND_LBRACE)   { ret true; }
    if (k == token.KIND_SEMI)     { ret true; }
    if (k == token.KIND_COMMA)    { ret true; }
    if (k == token.KIND_RPAREN)   { ret true; }
    if (k == token.KIND_RBRACKET) { ret true; }
    if (k == token.KIND_EQ)       { ret true; }
    if (k == token.KIND_EOF)      { ret true; }
    ret false;
}

test "mach.lang.fe.parser.expr.parse_expr:chained_assign_right_assoc" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_tokens: R.Result[lexer.TokenStream, str] = lexer.tokenize("x = y = 0", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](res_tokens)) { ret 1; }
    var stream: lexer.TokenStream     = R.unwrap_ok[lexer.TokenStream, str](res_tokens);
    var a:      ast.Ast               = ast.init(?alloc, 0::source.FileId);
    var diags:  diagnostic.DiagnosticStore   = diagnostic.store_init(?alloc);
    var p:      state.Parser          = state.make(?stream, ?a, ?diags);

    val eid: id.ExprId = parse_expr(?p);
    var rc: i32 = 0;
    val e: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, eid));
    if (e.kind != expr.EXPR_KIND_BINARY)     { rc = 1; }
    or (e.data.binary.op != expr.BIN_ASSIGN) { rc = 1; }
    or {
        val rhs: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, e.data.binary.rhs));
        if (rhs.kind != expr.EXPR_KIND_BINARY)     { rc = 1; }
        or (rhs.data.binary.op != expr.BIN_ASSIGN) { rc = 1; }
    }
    if (diagnostic.has_errors(?diags)) { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.expr.parse_expr:index_then_call" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_tokens: R.Result[lexer.TokenStream, str] = lexer.tokenize("t[0]()", ?alloc, 0::source.FileId);
    if (R.is_err[lexer.TokenStream, str](res_tokens)) { ret 1; }
    var stream: lexer.TokenStream     = R.unwrap_ok[lexer.TokenStream, str](res_tokens);
    var a:      ast.Ast               = ast.init(?alloc, 0::source.FileId);
    var diags:  diagnostic.DiagnosticStore   = diagnostic.store_init(?alloc);
    var p:      state.Parser          = state.make(?stream, ?a, ?diags);

    val eid: id.ExprId = parse_expr(?p);
    var rc: i32 = 0;
    val e: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, eid));
    if (e.kind != expr.EXPR_KIND_CALL)  { rc = 1; }
    or (e.data.call.type_args_len != 0) { rc = 1; }
    or {
        val callee: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, e.data.call.callee));
        if (callee.kind != expr.EXPR_KIND_INDEX) { rc = 1; }
    }
    if (diagnostic.has_errors(?diags)) { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?a);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

