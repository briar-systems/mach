    val eid: id.ExprId = parse_expr(?p);
    var rc: i32 = 0;
    val e: *expr.Expr = O.unwrap[*expr.Expr](ast.get_expr(?a, eid));
    if (e.kind != expr.EXPR_KIND_STRUCT_LIT)   { rc = 1; }
    or (e.data.struct_lit.fields_len != 1)     { rc = 1; }
