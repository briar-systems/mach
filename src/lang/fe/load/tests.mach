#[testing]
pub fun t_ctx(p: *project.Project, s: *session.Session, fqn: str) *comptime.ComptimeCtx {
    val idr: res[intern.StrId, A.Error] = intern.add(?s.interner, fqn);
    if (sel idr.err) { ret nil; }
    var id: intern.StrId           = idr.ok;
    val mr: opt[*session.ModuleId] = map.get[intern.StrId, session.ModuleId](?p.loader.by_name, ?id);
    if (sel mr.none) { ret nil; }
    val mid: session.ModuleId     = @mr.some;
    val m:   *project.ModuleEntry = project.module_at(p, mid::u32);
    ret ?m.load.ctx;
}

#[testing]
fun t_union_gate_result(src_text: str, want_diag: str, forbid_diag: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src_text;
    ret ut_union_gate_result_n(?names[0], ?texts[0], 1, want_diag, forbid_diag);
}

test union_gate__alias_is_typed_per_tuple {
    val uniform:         str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val selected_u8:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u8; }\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } } $or { use uniontest.missing; }\nfun main() i32 { ret selected(); }\n";
    val true_import:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    val false_embed:     str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[embed(\"missing.bin\")] val DATA: [_]u8; }\nfun main() i32 { ret 0; }\n";
    val false_library:   str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 0;\n$if (C) { #[library(\"missing\")] ext fun probe(); }\nfun main() i32 { ret 0; }\n";
    val nested:          str = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8; } $or { def Flag: u16; }\nval C: Flag = 1;\n$if ($mach.build.os == $mach.os.windows) { $if (C) { use uniontest.missing; } }\nfun main() i32 { ret 0; }\n";
    val permanent_error: str = "def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret selected() + no_such(); }\n";
    val u0:              i32 = t_union_gate_result(uniform, "", "");
    if (u0 != 0) { ret 10 + u0; }
    val u1: i32 = t_union_gate_result(selected_u8, "", "");
    if (u1 != 0) { ret 20 + u1; }
    val u2: i32 = t_union_gate_result(true_import, "condition must have type u8", "no project or dep matches");
    if (u2 != 0) { ret 30 + u2; }
    val u3: i32 = t_union_gate_result(false_embed, "condition must have type u8", "cannot read");
    if (u3 != 0) { ret 40 + u3; }
    val u4: i32 = t_union_gate_result(false_library, "condition must have type u8", "cannot read");
    if (u4 != 0) { ret 50 + u4; }
    val u5: i32 = t_union_gate_result(nested, "condition must have type u8", "no project or dep matches");
    if (u5 != 0) { ret 60 + u5; }
    val u6: i32 = t_union_gate_result(permanent_error, "unresolved identifier `no_such`", "");
    if (u6 != 0) { ret 70 + u6; }
    ret 0;
}

test union_gate__unevaluable_condition_keeps_independent_diagnostics {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "fun condition() u8 { ret 1; }\n$if (condition()) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret no_such(); }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (sel pr.err) {
        bad = 4;
    }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (!ut_diag_has(?p.s.diags, "function calls are not comptime-evaluable")) { bad = 5; }
        if (!ut_diag_has(?p.s.diags, "unresolved identifier `no_such`"))           { bad = 6; }
        if (diagnostic.len(?p.s.diags) != 2)                                       { bad = 7; }
        project.dnit_project(?p);
    }
    session.dnit(?s);
    ret bad;
}

# a gate reading a constant nothing binds is refused although the constant beside it binds through an import
test union_gate__unbound_constant_is_refused_beside_a_bound_import {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "use uniontest.dep.K;\npub val UNSTUCK: u8 = K;\npub val A: u8 = totally_undefined;\n$if (A) { fun helper() i32 { ret 1; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val K: u8 = 1;\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    var bad: i32 = 0;
    if (sel pr.ok) {
        var p:        project.Project  = pr.ok;
        val standing: fail.PhaseStatus = driver.frontend_status(?p);
        if (sel standing.kind.accepted) { bad = 1; }
        project.dnit_project(?p);
    }
    if (sel pr.err) {
        val f: fail.Fail = pr.err;
        if (!sel f.reported) { bad = 1; }
    }
    if (!ut_diag_has(?s.diags, "is never decided: `A`")) { bad = 2; }
    session.dnit(?s);
    ret bad;
}

test union_gate__gated_walk_does_not_taint_a_fresh_dependency {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "dep.mach";
    var texts: [2]str;
    texts[0] = "$if ($mach.build.os == NATIVE_OS) { use uniontest.dep.X;\n$if (X) { $error(\"XTRUE\"); } $or { $error(\"XFALSE\"); } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val X: u8 = 1;\n";
    val text0_r: res[str, fail.Fail] = ut_union_native_text(?alloc, texts[0]);
    if (sel text0_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[0] = text0_r.ok;
    fin { str_free(?alloc, texts[0]); }
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;
    fin { str_free(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    val se:  err[fail.Fail]  = driver.run_sema_pass(?p);
    if (!(sel se.err && fail.is_reported(se.err)))                                         { bad = 1; }
    if (ut_diag_has(?p.s.diags, "tuple-dependent public constants are not yet supported")) { bad = 1; }
    if (!ut_diag_has(?p.s.diags, "XTRUE"))                                                 { bad = 1; }
    if (ut_diag_has(?p.s.diags, "XFALSE"))                                                 { bad = 1; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test union_gate__tuple_bindings_are_isolated {
    var names: [5]str;
    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "windows_flag.mach";
    names[3] = "yes.mach";
    names[4] = "no.mach";
    var texts: [5]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; } $or { use chosen: uniontest.windows_flag; }\n$if (chosen.ENABLED) { use uniontest.yes; } $or { use uniontest.no; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub def Flag: u8;\npub val ENABLED: Flag = 1;\n";
    texts[2] = "pub def Flag: u8;\npub val ENABLED: Flag = 0;\n";
    texts[3] = "pub fun yes() i32 { ret 1; }\n";
    texts[4] = "pub fun no() i32 { ret 0; }\n";
    if (ut_union_gate_result_n(?names[0], ?texts[0], 5, "", "") != 0) { ret 1; }

    names[0] = "main.mach";
    names[1] = "linux_flag.mach";
    names[2] = "yes.mach";
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use chosen: uniontest.linux_flag; $if (chosen.ENABLED) { use uniontest.yes; } }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub val ENABLED: u8 = 1;\n";
    texts[2] = "pub fun yes() i32 { ret 1; }\n";
    if (ut_union_gate_result_n(?names[0], ?texts[0], 3, "", "unresolved identifier") != 0) { ret 2; }
    ret 0;
}

test tuple_reach__propagates_transitively {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == NATIVE_OS) { use uniontest.a; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "use uniontest.b;\npub fun a() i32 { ret 1; }\n";
    texts[2] = "$if ($mach.build.os != NATIVE_OS) { def Word: u16; val BAD: Word = 1; $if (BAD) { use uniontest.missing; } }\npub fun b() i32 { ret 2; }\n";
    val text0_r: res[str, fail.Fail] = ut_union_native_text(?alloc, texts[0]);
    if (sel text0_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[0] = text0_r.ok;
    fin { str_free(?alloc, texts[0]); }
    val text2_r: res[str, fail.Fail] = ut_union_native_text(?alloc, texts[2]);
    if (sel text2_r.err) {
        session.dnit(?s);
        ret 1;
    }
    texts[2] = text2_r.ok;
    fin { str_free(?alloc, texts[2]); }
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 3);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 1;
    }
    val root: str = root_r.ok;
    fin { str_free(?alloc, root); }
    val pr: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 2;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (ut_count_errors(?s.diags) != 0) { bad = 3; }
    val bmid: session.ModuleId = ut_mid(?p, ?s, "uniontest.b");
    if (module.is_nil(bmid)) { bad = 4; }
    or {
        val bm: *project.ModuleEntry = project.module_at(?p, bmid::u32);
        if (bm.load.reached == nil || bm.load.reach_count != p.loader.tuple_count) { bad = 5; }
        or {
            var ti: u32 = 0;
            for (ti < p.loader.tuple_count) {
                val should_reach: bool = p.loader.tuples[ti].os_id == ut_union_native_os_id();
                if (bm.load.reached[ti] != should_reach) { bad = 6; }
                ti = ti + 1;
            }
        }
    }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# shared loads first under the native tuples alone, through main's gated import, and is reached
# under every tuple only by the later late: its load is walked again under the tuples new to it, so
# the foreign-only import it gates is loaded, and the topo is ordered again to put it first
test tuple_reach__a_module_reached_under_a_new_tuple_is_walked_again {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var names: [4]str = [4]str{"main.mach", "late.mach", "shared.mach", "foreign.mach"};
    var texts: [4]str = [4]str{
        "$if ($mach.build.os == NATIVE_OS) { use uniontest.shared; }\nuse uniontest.late;\nfun main() i32 { ret 0; }\n",
        "use uniontest.shared;\npub fun late() i32 { ret 1; }\n",
        "$if ($mach.build.os == FOREIGN_OS) { use uniontest.foreign; }\npub fun shared() i32 { ret 2; }\n",
        "pub fun foreign() i32 { ret 3; }\n"
    };
    var s:      session.Session;
    val root_r: res[str, fail.Fail] = ut_gate_session(?alloc, ?names[0], ?texts[0], 4, ?s);
    if (sel root_r.err) { ret 2; }
    val root: str = root_r.ok;
    fin {
        fs.remove_all(?alloc, root);
        session.dnit(?s);
    }
    val built: res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    if (sel built.err) { ret 3; }
    var p: project.Project = built.ok;
    fin { project.dnit_project(?p); }
    if (ut_count_errors(?s.diags) != 0) { ret 4; }
    val shared:  session.ModuleId = ut_mid(?p, ?s, "uniontest.shared");
    val foreign: session.ModuleId = ut_mid(?p, ?s, "uniontest.foreign");
    if (module.is_nil(shared) || module.is_nil(foreign)) { ret 5; }
    val sm: *project.ModuleEntry = project.module_at(?p, shared::u32);
    val fm: *project.ModuleEntry = project.module_at(?p, foreign::u32);
    if (sm.load.reached == nil || fm.load.reached == nil) { ret 6; }
    # FOREIGN_OS spells windows, or linux on a windows host
    var foreign_os: u32 = catalog_os.WINDOWS;
    if (ut_union_native_os_id() == catalog_os.WINDOWS) { foreign_os = catalog_os.LINUX; }
    var foreign_tuples: u32 = 0;
    var ti:             u32 = 0;
    for (ti < p.loader.tuple_count) {
        if (!sm.load.reached[ti]) { ret 7; }
        val wanted: bool = p.loader.tuples[ti].os_id == foreign_os;
        if (fm.load.reached[ti] != wanted) { ret 8; }
        if (wanted)                        { foreign_tuples = foreign_tuples + 1; }
        ti = ti + 1;
    }
    if (foreign_tuples == 0)                                     { ret 9; }
    if (ut_topo_index(?p, foreign) >= ut_topo_index(?p, shared)) { ret 10; }
    if (ut_topo_index(?p, shared) >= p.topo_len)                 { ret 11; }
    ret 0;
}

test union_gate__distinct_failures_per_tuple_are_all_visible {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { def Flag: u8x4; val C: Flag = u8x4{1, 2, 3, 4}; } $or { def Flag: u16; val C: Flag = 1; }\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 1);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = driver.build_project_union(?s, root);
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 4;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (!ut_diag_has(?p.s.diags, "`C` is not an integer constant")) { bad = 5; }
    if (!ut_diag_has(?p.s.diags, "condition must have type u8"))    { bad = 6; }
    if (diagnostic.len(?p.s.diags) != 2)                            { bad = 7; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

#[testing]
fun t_idx2(alloc: *A.Allocator, n: u32) str {
    val r: res[*u8, A.Error] = A.allocate[u8](alloc, 3::usize);
    if (sel r.err) { ret "00"; }
    val buf: *u8 = r.ok;
    buf[0] = (48 + (n / 10))::u8;
    buf[1] = (48 + (n % 10))::u8;
    buf[2] = 0;
    ret buf::str;
}

#[testing]
val REALLOC_LEAVES: u32 = 24;

#[testing]
fun t_realloc_fixture(alloc: *A.Allocator, names: *str, texts: *str) u32 {
    var body: str = "";
    var i:    u32 = 0;
    for (i < REALLOC_LEAVES) {
        val nm: str = ut_cc3(alloc, "w", t_idx2(alloc, i), "");
        names[1 + i] = ut_cc3(alloc, nm, ".mach", "");
        texts[1 + i] = ut_cc3(alloc, "pub fun f() i32 { ret ", t_idx2(alloc, i), "; }\n");
        body         = ut_cc3(alloc, body, "  use uniontest.", ut_cc3(alloc, nm, ";\n", ""));
        i            = i + 1;
    }
    names[1 + REALLOC_LEAVES] = "lx.mach";
    texts[1 + REALLOC_LEAVES] = "pub fun fl() i32 { ret 99; }\n";

    names[0] = "main.mach";
    val br0: str = ut_cc3(alloc, "$if ($mach.build.os == $mach.os.windows) {\n", body, "}\n");
    texts[0] = ut_cc3(alloc, br0, "$or ($mach.build.os == $mach.os.linux) { use uniontest.lx; }\n\nfun main() i32 { ret 0; }\n", "");
    ret 2 + REALLOC_LEAVES;
}

# 0 when the union loads a.mach exactly when `want_a` and b.mach exactly when `want_b`
#[testing]
fun t_union_selects(main: str, want_a: bool, want_b: bool) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [3]str                          = [3]str{"main.mach", "a.mach", "b.mach"};
    var texts: [3]str                          = [3]str{main, "pub fun fa() i32 { ret 1; }\n", "pub fun fb() i32 { ret 2; }\n"};
    val pr:    res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }
    if (ut_has(?p, ?s, "uniontest.a") != want_a) { ret 3; }
    if (ut_has(?p, ?s, "uniontest.b") != want_b) { ret 4; }
    ret 0;
}

# the first active branch wins in every tuple, and a module constant a gate reads keeps its
# value under each tuple's override of the target facts
test union_gate__first_active_branch_wins_per_tuple {
    val first: i32 = t_union_selects("$if ($mach.build.pointer_width == 8) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.linux) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n", true, false);
    if (first != 0) { ret 10 + first; }
    val constant: i32 = t_union_selects("pub val FLAG: i32 = 1;\n$if (FLAG == 0) { use uniontest.a; }\n$or (FLAG == 1) { use uniontest.b; }\n\nfun main() i32 { ret 0; }\n", false, true);
    if (constant != 0) { ret 20 + constant; }
    ret 0;
}

test union_gate__selection_uses_tuple_abi_and_platform {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s:     session.Session = sr.ok;
    val mf:    str             = "[project]\nmach = \">=5\"\nid = \"tuplefacts\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\nplatform = \"alpha\"\n\n[target.windows]\nisa = \"x86_64\"\nos = \"windows\"\nabi = \"win64\"\nplatform = \"beta\"\n\n[artifact.tuplefacts]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"{project.out}/bin/tuplefacts\"\ntargets = [\"*\"]\nlink = []\nneed = []\n[profile.debug]\ndefault = true\nopt = 0\ndebug = true\nsimd = \"scalarize\"\nvectorize = false\nfloat_reassoc = false\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n";
    var names: [5]str;
    names[0] = "main.mach";
    names[1] = "sysv.mach";
    names[2] = "win.mach";
    names[3] = "alpha.mach";
    names[4] = "beta.mach";
    var texts: [5]str;
    texts[0] = "$if ($mach.build.abi == $mach.abi.sysv64) { use tuplefacts.sysv; } $or ($mach.build.abi == $mach.abi.win64) { use tuplefacts.win; }\n$if ($mach.build.platform == \"alpha\") { use tuplefacts.alpha; } $or ($mach.build.platform == \"beta\") { use tuplefacts.beta; }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun selected() i32 { ret 1; }\n";
    texts[2] = "pub fun selected() i32 { ret 2; }\n";
    texts[3] = "pub fun selected() i32 { ret 3; }\n";
    texts[4] = "pub fun selected() i32 { ret 4; }\n";
    val root_r: res[str, fail.Fail] = ut_scaffold_m(?alloc, mf, ?names[0], ?texts[0], 5);
    if (sel root_r.err) {
        session.dnit(?s);
        ret 2;
    }
    val root: str                             = root_r.ok;
    val pr:   res[project.Project, fail.Fail] = driver.build_project_union_for(?s, root, "linux");
    fs.remove_all(?alloc, root);
    if (sel pr.err) {
        session.dnit(?s);
        ret 4;
    }
    var p:   project.Project = pr.ok;
    var bad: i32             = 0;
    if (ut_count_errors(?s.diags) != 0) { bad = 5; }
    if (!ut_has(?p, ?s, "tuplefacts.sysv") || !ut_has(?p, ?s, "tuplefacts.win")
        || !ut_has(?p, ?s, "tuplefacts.alpha") || !ut_has(?p, ?s, "tuplefacts.beta")) { bad = 6; }
    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test union_ctx__restored_to_the_default_tuple {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "a.mach";
    names[2] = "b.mach";
    var texts: [3]str;
    texts[0] = "$if ($mach.build.os == $mach.os.linux) { use uniontest.a; }\n$or ($mach.build.os == $mach.os.windows) { use uniontest.b; }\nval BAD: u16 = 1;\n$if (BAD) { }\nfun main() i32 { ret 0; }\n";
    texts[1] = "pub fun fa() i32 { ret 1; }\n";
    texts[2] = "pub fun fb() i32 { ret 2; }\n";

    val pr: res[project.Project, fail.Fail] = ut_build(?s, ?alloc, ?names[0], ?texts[0], 3);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    val cm: *comptime.ComptimeCtx = t_ctx(?p, ?s, "uniontest.main");
    val ca: *comptime.ComptimeCtx = t_ctx(?p, ?s, "uniontest.a");
    val cb: *comptime.ComptimeCtx = t_ctx(?p, ?s, "uniontest.b");

    var bad: i32 = 0;
    if (cm == nil || ca == nil || cb == nil)                                    { bad = 1; }
    or (cm.env.target_os_id != ca.env.target_os_id)                             { bad = 2; }
    or (cm.env.target_os_id != cb.env.target_os_id)                             { bad = 3; }
    or (cm.env.target_arch_id != ca.env.target_arch_id)                         { bad = 4; }
    or (cm.env.target_arch_id != cb.env.target_arch_id)                         { bad = 5; }
    or (cm.env.target_abi_id != ca.env.target_abi_id)                           { bad = 6; }
    or (cm.env.target_abi_id != cb.env.target_abi_id)                           { bad = 7; }
    or (cm.env.pointer_width != ca.env.pointer_width)                           { bad = 8; }
    or (cm.env.pointer_width != cb.env.pointer_width)                           { bad = 9; }
    or (cm.env.vector_bits != ca.env.vector_bits)                               { bad = 10; }
    or (cm.env.vector_bits != cb.env.vector_bits)                               { bad = 11; }
    or (cm.env.register_bits != ca.env.register_bits)                           { bad = 10; }
    or (cm.env.register_bits != cb.env.register_bits)                           { bad = 11; }
    or (cm.env.target_defs != ca.env.target_defs)                               { bad = 12; }
    or (cm.env.target_defs != cb.env.target_defs)                               { bad = 13; }
    or (cm.env.va_list_size != ca.env.va_list_size)                             { bad = 14; }
    or (cm.env.va_list_size != cb.env.va_list_size)                             { bad = 15; }
    or (cm.env.va_list_align != ca.env.va_list_align)                           { bad = 16; }
    or (cm.env.va_list_align != cb.env.va_list_align)                           { bad = 17; }
    or (cm.env.target_os_id != lang_target.host_os_id())                        { bad = 18; }
    or (cm.env.target_arch_id != lang_target.host_arch_id())                    { bad = 19; }
    or (cm.env.target_abi_id != p.target.target.abi_id)                         { bad = 20; }
    or (!intern.str_same(cm.env.target_os, p.target_entry.os_name))             { bad = 21; }
    or (!intern.str_same(cm.env.target_isa, p.target_entry.isa_name))           { bad = 22; }
    or (!intern.str_same(cm.env.target_abi, p.target_entry.abi_name))           { bad = 23; }
    or (!intern.str_same(cm.env.target_platform, p.target_entry.platform_name)) { bad = 24; }
    or (cm.env.has_float != ca.env.has_float)                                   { bad = 25; }
    or (cm.env.has_float != cb.env.has_float)                                   { bad = 26; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

