}

pub val MODE_DEBUG:   u32 = 0;
pub val MODE_RELEASE: u32 = 1;

# the `$mach.mode.*` tags, each at its mode's value
pub val MODE_COUNT: usize           = 2;
val     MODES:      [MODE_COUNT]str = [MODE_COUNT]str{"debug", "release"};

fun mode_tag_for(name: View) res[u32, fail.Fail] {
    var i: usize = 0;
    for (i < MODE_COUNT) {
        if (view_eq_str(name, MODES[i])) { ret res[u32, fail.Fail].ok{i::u32}; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].err{fail.message("unknown `$mach.mode.*` tag")};
}

fun version_component(s: str, which: u32) res[i64, fail.Fail] {
    var comp: u32   = 0;
    var acc:  i64   = 0;
    var seen: bool  = false;
    var i:    usize = 0;
    for (s[i] != 0) {
        val ch: u8 = s[i];
        if (ch == '.') {
            comp = comp + 1;
        }
        or (comp == which) {
            if (ch < '0' || ch > '9') { ret res[i64, fail.Fail].err{fail.message("version component is not numeric")}; }
            acc  = acc * 10 + (ch - '0')::i64;
            seen = true;
        }
        i = i + 1;
    }
    if (!seen) { ret res[i64, fail.Fail].err{fail.message("version string has no such component")}; }
    ret res[i64, fail.Fail].ok{acc};
}

fun version_value(s: str, which: u32) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val r: res[i64, fail.Fail] = version_component(s, which);
    if (sel r.err) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNKNOWN, fail.describe(r.err)); }
    ret comptime_value.int_value(r.ok);
}

#[testing]
pub fun mode_at(i: usize) str {
    if (i >= MODE_COUNT) { ret nil; }
    ret MODES[i];
}
