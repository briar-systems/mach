# the comptime path registry: one row per `$root.segment...` path the compiler
# answers, matched once against a written path's segments
#
# a row names the value its path reads; the evaluator reads it by that id and
# never by a segment's spelling. a path that matches no row is refused with the
# message of the most specific family it falls in. a new path is a row here and
# its read
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use lang_alloc:      mach.lang.alloc;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_expr:         mach.lang.fe.ast.expr;
use ast_id:           mach.lang.fe.ast.id;
use comptime_failure: mach.lang.fe.comptime.failure;
use mach.lang.fe.comptime.intrinsic;
use comptime_scope: mach.lang.fe.comptime.scope;
use comptime_value: mach.lang.fe.comptime.value;
use mach.lang.intern;
use lang_source:  mach.lang.source;
use catalog_abi:  mach.lang.target.catalog.abi;
use catalog_arch: mach.lang.target.catalog.arch;
use catalog_os:   mach.lang.target.catalog.os;
use mach.lang.target.extension;
use target_model: mach.lang.target.model;
use A:            std.allocator;
use std_format:   std.format;
use std.text.string.str_free;
use std.types.option.opt;
use std.types.result.res;
use std.types.view.View;
use std.types.view.view_eq_str;

# what a path reads; `Row.arg` refines the version components, 0 major, 1 minor and 2 patch
pub def Read: u8;

pub val READ_NONE:             Read = 0;
pub val READ_COMPILER_VERSION: Read = 1;
pub val READ_COMPILER_NAME:    Read = 2;
pub val READ_COMPILER_PART:    Read = 3;
pub val READ_OS_TAG:           Read = 4;
pub val READ_ARCH_TAG:         Read = 5;
pub val READ_ABI_TAG:          Read = 6;
pub val READ_MODE_TAG:         Read = 7;
pub val READ_OWNER_ID:         Read = 8;
pub val READ_OWNER_VERSION:    Read = 9;
pub val READ_OWNER_PART:       Read = 10;
pub val READ_SOURCE_FILE:      Read = 11;
pub val READ_SOURCE_MODULE:    Read = 12;
pub val READ_SOURCE_LINE:      Read = 13;
pub val READ_BUILD_OS:         Read = 14;
pub val READ_BUILD_ARCH:       Read = 15;
pub val READ_BUILD_ABI:        Read = 16;
pub val READ_BUILD_WIDTH:      Read = 17;
pub val READ_BUILD_MODE:       Read = 18;
pub val READ_BUILD_PIE:        Read = 19;
pub val READ_BUILD_EXTENSION:  Read = 20;
pub val READ_BUILD_PLATFORM:   Read = 21;
pub val READ_BUILD_CT_MUL:     Read = 22;
pub val READ_PROJECT_ID:       Read = 23;
pub val READ_PROJECT_VERSION:  Read = 24;
pub val READ_PROJECT_PART:     Read = 25;
pub val READ_TARGET_OS:        Read = 26;
pub val READ_TARGET_ARCH:      Read = 27;
pub val READ_TARGET_ABI:       Read = 28;
pub val READ_BIN_NAME:         Read = 29;
pub val READ_REFUSED:          Read = 30;
pub val READ_RESERVED:         Read = 31;
val     READ_COUNT:            u32  = 32;

# one path
# ---
# path: its segments after the `$`, `.`-separated, where `*` is any one segment
# arg:  what `read` needs beyond the path, a version component
# call: the path is called with arguments, `$mach.build.ct_mul(op, width)`
# note: the refusal READ_REFUSED and READ_RESERVED report
pub rec Row {
    path: str;
    read: Read;
    arg:  u32;
    call: bool;
    note: str;
}

val COUNT: usize      = 38;
val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{path: "mach.version", read: READ_COMPILER_VERSION, arg: 0, call: false, note: nil},
    Row{path: "mach.version.major", read: READ_COMPILER_PART, arg: 0, call: false, note: nil},
    Row{path: "mach.version.minor", read: READ_COMPILER_PART, arg: 1, call: false, note: nil},
    Row{path: "mach.version.patch", read: READ_COMPILER_PART, arg: 2, call: false, note: nil},
    Row{path: "mach.compiler.version", read: READ_COMPILER_VERSION, arg: 0, call: false, note: nil},
    Row{path: "mach.compiler.name", read: READ_COMPILER_NAME, arg: 0, call: false, note: nil},
    Row{path: "mach.os.*", read: READ_OS_TAG, arg: 0, call: false, note: nil},
    Row{path: "mach.arch.*", read: READ_ARCH_TAG, arg: 0, call: false, note: nil},
    Row{path: "mach.abi.*", read: READ_ABI_TAG, arg: 0, call: false, note: nil},
    Row{path: "mach.mode.*", read: READ_MODE_TAG, arg: 0, call: false, note: nil},
    Row{path: "mach.project.id", read: READ_OWNER_ID, arg: 0, call: false, note: nil},
    Row{path: "mach.project.version", read: READ_OWNER_VERSION, arg: 0, call: false, note: nil},
    Row{path: "mach.project.version.major", read: READ_OWNER_PART, arg: 0, call: false, note: nil},
    Row{path: "mach.project.version.minor", read: READ_OWNER_PART, arg: 1, call: false, note: nil},
    Row{path: "mach.project.version.patch", read: READ_OWNER_PART, arg: 2, call: false, note: nil},
    Row{path: "mach.source.file", read: READ_SOURCE_FILE, arg: 0, call: false, note: nil},
    Row{path: "mach.source.module", read: READ_SOURCE_MODULE, arg: 0, call: false, note: nil},
    Row{path: "mach.source.line", read: READ_SOURCE_LINE, arg: 0, call: false, note: nil},
    Row{path: "mach.build.os", read: READ_BUILD_OS, arg: 0, call: false, note: nil},
    Row{path: "mach.build.arch", read: READ_BUILD_ARCH, arg: 0, call: false, note: nil},
    Row{path: "mach.build.abi", read: READ_BUILD_ABI, arg: 0, call: false, note: nil},
    Row{path: "mach.build.pointer_width", read: READ_BUILD_WIDTH, arg: 0, call: false, note: nil},
    Row{path: "mach.build.mode", read: READ_BUILD_MODE, arg: 0, call: false, note: nil},
    Row{path: "mach.build.pie", read: READ_BUILD_PIE, arg: 0, call: false, note: nil},
    Row{path: "mach.build.extensions.*", read: READ_BUILD_EXTENSION, arg: 0, call: false, note: nil},
    Row{path: "mach.build.extensions", read: READ_REFUSED, arg: 0, call: false,
        note: "`$mach.build.extensions` names one extension, as in `$mach.build.extensions.sse41`"},
    Row{path: "mach.build.platform", read: READ_BUILD_PLATFORM, arg: 0, call: false, note: nil},
    Row{path: "mach.build.ct_mul", read: READ_BUILD_CT_MUL, arg: 0, call: true, note: nil},
    Row{path: "project.id", read: READ_PROJECT_ID, arg: 0, call: false, note: nil},
    Row{path: "project.version", read: READ_PROJECT_VERSION, arg: 0, call: false, note: nil},
    Row{path: "project.version.major", read: READ_PROJECT_PART, arg: 0, call: false, note: nil},
    Row{path: "project.version.minor", read: READ_PROJECT_PART, arg: 1, call: false, note: nil},
    Row{path: "project.version.patch", read: READ_PROJECT_PART, arg: 2, call: false, note: nil},
    Row{path: "project.target.os", read: READ_TARGET_OS, arg: 0, call: false, note: nil},
    Row{path: "project.target.arch", read: READ_TARGET_ARCH, arg: 0, call: false, note: nil},
    Row{path: "project.target.abi", read: READ_TARGET_ABI, arg: 0, call: false, note: nil},
    Row{path: "bin.name", read: READ_BIN_NAME, arg: 0, call: false, note: nil},
    Row{path: "project.deps.*.version", read: READ_RESERVED, arg: 0, call: false,
        note: "`$project.deps.*.version` is not yet available (reserved for the package registry)"},
};

# the row at `i` in declaration order, nil past the end
pub fun at(i: usize) *Row {
    if (i >= COUNT) { ret nil; }
    ret ?ROWS[i];
}

# the refusal of a path no row matches: the most specific family whose prefix it
# extends by `extra_min` to `extra_max` segments
rec Family {
    prefix:    str;
    extra_min: u32;
    extra_max: u32;
    unknown:   str;
}

val EXTRA_ANY:    u32                  = 0xFFFFFFFF;
val FAMILY_COUNT: usize                = 9;
val FAMILIES:     [FAMILY_COUNT]Family = [FAMILY_COUNT]Family{
    Family{prefix: "mach.version", extra_min: 1, extra_max: 1, unknown: "unknown `$mach.version.*` component"},
    Family{prefix: "mach.project.version", extra_min: 1, extra_max: 1, unknown: "unknown `$mach.project.version.*` component"},
    Family{prefix: "mach.project", extra_min: 1, extra_max: EXTRA_ANY, unknown: "unknown `$mach.project.*` path"},
    Family{prefix: "mach.source", extra_min: 1, extra_max: EXTRA_ANY, unknown: "unknown `$mach.source.*` path"},
    Family{prefix: "mach", extra_min: 0, extra_max: EXTRA_ANY, unknown: "unknown `$mach.*` path"},
    Family{prefix: "project.target", extra_min: 1, extra_max: 1, unknown: "unknown `$project.target.*` path"},
    Family{prefix: "project.version", extra_min: 1, extra_max: 1, unknown: "unknown `$project.version.*` component"},
    Family{prefix: "project", extra_min: 0, extra_max: EXTRA_ANY, unknown: "unknown `$project.*` path"},
    Family{prefix: "bin", extra_min: 0, extra_max: EXTRA_ANY, unknown: "unknown `$bin.*` path"},
};

# the row a written path matches, called or not; nil when none does. `stack`
# holds its `depth` segments innermost first, the root at `depth - 1`
pub fun lookup(source: str, stack: *lang_source.Span, depth: u32, call: bool) *Row {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        i = i + 1;
        if (r.call != call)                                                                           { cnt; }
        if (prefix_segments(r.path, source, stack, depth) == depth && segment_count(r.path) == depth) { ret r; }
    }
    ret nil;
}

# the refusal of a path no row matches; nil when its root names no family
pub fun unknown(source: str, stack: *lang_source.Span, depth: u32) str {
    var i: usize = 0;
    for (i < FAMILY_COUNT) {
        val f: *Family = ?FAMILIES[i];
        i = i + 1;
        val n: u32 = segment_count(f.prefix);
        if (depth < n + f.extra_min || (f.extra_max != EXTRA_ANY && depth > n + f.extra_max)) { cnt; }
        if (prefix_segments(f.prefix, source, stack, depth) == n)                             { ret f.unknown; }
    }
    ret nil;
}

fun segment_count(pattern: str) u32 {
    var n: u32   = 1;
    var i: usize = 0;
    for (i < str_len(pattern)) {
        if (pattern[i] == '.') { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# how many leading segments of `pattern` the written path matches, stopping at
# the first that differs or at the path's end
fun prefix_segments(pattern: str, source: str, stack: *lang_source.Span, depth: u32) u32 {
    var matched: u32   = 0;
    var start:   usize = 0;
    val len:     usize = str_len(pattern);
    for (start <= len && matched < depth) {
        var end: usize = start;
        for (end < len && pattern[end] != '.') { end = end + 1; }
        val seg:  lang_source.Span = stack[depth - 1 - matched];
        val wild: bool             = end - start == 1 && pattern[start] == '*';
        if (!wild && !segment_is(source, seg, pattern, start, end)) { ret matched; }
        matched = matched + 1;
        start   = end + 1;
    }
    ret matched;
}

fun segment_is(source: str, seg: lang_source.Span, pattern: str, start: usize, end: usize) bool {
    if (seg.len != end - start) { ret false; }
    var i: usize = 0;
    for (i < seg.len) {
        if (source[seg.offset + i] != pattern[start + i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# every row's path is reached by the lookup, no other row shadows it, and every read has a row
test rows__match_their_own_paths {
    var i: usize = 0;
    for (i < COUNT) {
        val r:     *Row = ?ROWS[i];
        var stack: [8]lang_source.Span;
        val depth: u32  = t_split(r.path, ?stack[0]);
        if (lookup(r.path, ?stack[0], depth, r.call) != r)    { ret 1; }
        if (lookup(r.path, ?stack[0], depth, !r.call) != nil) { ret 2; }
        i = i + 1;
    }
    # every read the evaluator answers has a path that reaches it
    var read: u32 = 1;
    for (read < READ_COUNT) {
        var found: bool  = false;
        var j:     usize = 0;
        for (j < COUNT) {
            if (ROWS[j].read::u32 == read) { found = true; }
            j = j + 1;
        }
        if (!found) { ret 3; }
        read = read + 1;
    }
    ret 0;
}

# a path no row matches is refused by its most specific family
test unknown__names_the_closest_family {
    if (!t_unknown("mach.version.build", "unknown `$mach.version.*` component"))             { ret 1; }
    if (!t_unknown("mach.version.major.x", "unknown `$mach.*` path"))                        { ret 2; }
    if (!t_unknown("mach.project.version.x", "unknown `$mach.project.version.*` component")) { ret 3; }
    if (!t_unknown("mach.project.version.major.x", "unknown `$mach.project.*` path"))        { ret 4; }
    if (!t_unknown("mach.project", "unknown `$mach.*` path"))                                { ret 5; }
    if (!t_unknown("project.target.os.x", "unknown `$project.*` path"))                      { ret 6; }
    if (!t_unknown("bin", "unknown `$bin.*` path"))                                          { ret 7; }
    var stack: [8]lang_source.Span;
    val depth: u32 = t_split("other.x", ?stack[0]);
    if (unknown("other.x", ?stack[0], depth) != nil)                                                   { ret 8; }
    if (lookup("mach.build.ct_mul", ?stack[0], t_split("mach.build.ct_mul", ?stack[0]), false) != nil) { ret 9; }
    ret 0;
}

#[testing]
fun t_unknown(path: str, want: str) bool {
    var stack: [8]lang_source.Span;
    val depth: u32 = t_split(path, ?stack[0]);
    if (lookup(path, ?stack[0], depth, false) != nil) { ret false; }
    val got: str = unknown(path, ?stack[0], depth);
    ret got != nil && str_equals(got, want);
}

# `path`'s segments as the evaluator stacks them, innermost first; its depth
#[testing]
pub fun t_split(path: str, stack: *lang_source.Span) u32 {
    val n:     u32   = segment_count(path);
    var k:     u32   = 0;
    var start: usize = 0;
    for (k < n) {
        var end: usize = start;
        for (end < str_len(path) && path[end] != '.') { end = end + 1; }
        stack[n - 1 - k] = lang_source.Span{offset: start, len: end - start};
        k                = k + 1;
        start            = end + 1;
    }
    ret n;
}

pub val COMPTIME_BARE_IDENT_MSG: str =
    "comptime parameters are referenced without `$`; comptime paths are rooted: `$mach`, `$project`, `$bin`";

pub fun eval_path(
    c: *comptime_scope.ComptimeCtx,
    a: *ast.Ast,
    source: str,
    e: ast_id.ExprId,
    interner: *intern.Interner) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    var stack: [16]lang_source.Span;
    var depth: u32 = 0;

    var cur: ast_id.ExprId = e;
    for (true) {
        if (depth >= 16) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNKNOWN, "comptime path is too deeply nested"); }
        val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, cur);
        if (!sel n_opt.some) { ret comptime_value.reject(diagnostic_kind.COMPTIME_NOT_EVALUABLE, "ExprId out of range during comptime member walk"); }
        val node: *ast_expr.Expr = n_opt.some;
        if (node.kind == ast_expr.EXPR_KIND_MEMBER) {
            stack[depth] = node.data.member.name;
            depth        = depth + 1;
            cur          = node.data.member.object;
            cnt;
        }
        if (node.kind == ast_expr.EXPR_KIND_COMPTIME_IDENT) {
            stack[depth] = intrinsic.comptime_ident_name(node.data.comptime_ident.tok);
            depth        = depth + 1;
            brk;
        }
        ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNKNOWN, "comptime path must start with a `$` identifier");
    }

    ret resolve_comptime_path(c, source, ?stack[0], depth, interner);
}

pub fun resolve_comptime_path(c: *comptime_scope.ComptimeCtx, source: str, stack: *lang_source.Span, depth: u32, interner: *intern.Interner) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    if (depth == 0) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNKNOWN, "empty comptime path"); }
    val row: *Row = lookup(source, stack, depth, false);
    if (row == nil) {
        val unknown: str = unknown(source, stack, depth);
        if (unknown == nil) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_ROOT, COMPTIME_BARE_IDENT_MSG); }
        ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNKNOWN, unknown);
    }
    ret path_read(c, row, source, stack, depth, interner);
}

# the value the path `row` matched reads; `stack[0]` is the written path's last
# segment and `stack[depth - 1]` its root
fun path_read(c: *comptime_scope.ComptimeCtx, row: *Row, source: str, stack: *lang_source.Span, depth: u32, interner: *intern.Interner) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val r:    Read = row.read;
    val last: View = lang_source.span_view(source, stack[0]);
    if (r == READ_COMPILER_VERSION) { ret comptime_value.str_value(c.env.compiler_ver); }
    if (r == READ_COMPILER_NAME)    { ret comptime_value.str_value(c.env.compiler_name); }
    if (r == READ_COMPILER_PART) {
        val vo: opt[str] = intern.get(interner, c.env.compiler_ver);
        if (!sel vo.some) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNAVAILABLE, "compiler version is not available"); }
        ret version_value(vo.some, row.arg);
    }
    if (r == READ_OS_TAG)          { ret tag_value(os_tag_for(last)); }
    if (r == READ_ARCH_TAG)        { ret tag_value(arch_tag_for(last)); }
    if (r == READ_ABI_TAG)         { ret tag_value(abi_tag_for(last)); }
    if (r == READ_MODE_TAG)        { ret tag_value(mode_tag_for(last)); }
    if (r == READ_OWNER_ID)        { ret project_field(c.env.owner_id); }
    if (r == READ_OWNER_VERSION)   { ret project_field(c.env.owner_ver); }
    if (r == READ_OWNER_PART)      { ret version_part(c.env.owner_ver, row.arg, interner); }
    if (r == READ_SOURCE_FILE)     { ret project_field(c.env.source_file); }
    if (r == READ_SOURCE_MODULE)   { ret project_field(c.env.module_fqn); }
    if (r == READ_SOURCE_LINE)     { ret comptime_value.int_value(line_at(source, stack[depth - 1].offset)::i64); }
    if (r == READ_BUILD_OS)        { ret comptime_value.int_value(c.env.target_os_id::i64); }
    if (r == READ_BUILD_ARCH)      { ret comptime_value.int_value(c.env.target_arch_id::i64); }
    if (r == READ_BUILD_ABI)       { ret comptime_value.int_value(c.env.target_abi_id::i64); }
    if (r == READ_BUILD_WIDTH)     { ret comptime_value.int_value(c.env.pointer_width::i64); }
    if (r == READ_BUILD_MODE)      { ret comptime_value.int_value(c.env.build_mode_id::i64); }
    if (r == READ_BUILD_PIE)       { ret comptime_value.u8_value(c.env.build_pie::u8); }
    if (r == READ_BUILD_EXTENSION) { ret extension_value(c, last); }
    if (r == READ_BUILD_PLATFORM) {
        if (!intern.str_is_nil(c.env.target_platform)) { ret comptime_value.str_value(c.env.target_platform); }
        val pr: res[intern.StrId, A.Error] = intern.add(interner, "");
        if (sel pr.err) { ret comptime_value.internal_failure(lang_alloc.text(pr.err)); }
        ret comptime_value.str_value(pr.ok);
    }
    if (r == READ_PROJECT_ID)      { ret project_field(c.env.project_id); }
    if (r == READ_PROJECT_VERSION) { ret project_field(c.env.project_ver); }
    if (r == READ_PROJECT_PART)    { ret version_part(c.env.project_ver, row.arg, interner); }
    if (r == READ_TARGET_OS)       { ret project_field(c.env.target_os); }
    if (r == READ_TARGET_ARCH)     { ret project_field(c.env.target_isa); }
    if (r == READ_TARGET_ABI)      { ret project_field(c.env.target_abi); }
    if (r == READ_BIN_NAME)        { ret project_field(c.env.bin_name); }
    if (r == READ_REFUSED)         { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNKNOWN, row.note); }
    if (r == READ_RESERVED)        { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_RESERVED, row.note); }
    ret comptime_value.internal_failure("a comptime path row reads nothing the evaluator answers");
}

# a target tag a path segment spells, refused as an unknown path when it spells none
fun tag_value(r: res[u32, fail.Fail]) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    if (sel r.err) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNKNOWN, fail.describe(r.err)); }
    ret comptime_value.int_value(r.ok::i64);
}

# component `which` of a project's version
fun version_part(ver: intern.StrId, which: u32, interner: *intern.Interner) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    if (intern.str_is_nil(ver)) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNAVAILABLE, "comptime path value is not available in this context"); }
    val vo: opt[str] = intern.get(interner, ver);
    if (!sel vo.some) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNAVAILABLE, "project version is not available"); }
    ret version_value(vo.some, which);
}

# the 1-based line of a byte offset in the text
fun line_at(source: str, offset: usize) u64 {
    var line: u64   = 1;
    var i:    usize = 0;
    for (i < offset) {
        if (source[i] == '\n') { line = line + 1; }
        i = i + 1;
    }
    ret line;
}

fun project_field(value: intern.StrId) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    if (intern.str_is_nil(value)) {
        ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNAVAILABLE, "comptime path value is not available in this context");
    }
    ret comptime_value.str_value(value);
}

# `$mach.build.extensions.<name>`: 1 when the target selects the extension and 0
# when it does not; the name is read against the selected isa's vocabulary only,
# and one it does not declare is refused, never folded, as `$mach.arch.*` is
fun extension_value(c: *comptime_scope.ComptimeCtx, name: View) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val ext: target_model.ExtensionView = c.env.extensions;
    if (ext.table == nil) { ret comptime_value.reject(diagnostic_kind.COMPTIME_PATH_UNAVAILABLE, "`$mach.build.extensions.*` is not available in this context"); }
    val bit: u64 = extension.bit_of(ext.table, ext.count, name.data::str, name.len);
    if (bit != 0) {
        if ((ext.selected & bit) != 0) { ret comptime_value.u8_value(1); }
        ret comptime_value.u8_value(0);
    }
    val known_r: res[str, fail.Fail] = target_model.table_names(c.env.alloc, ext.table, ext.count);
    if (sel known_r.err) { ret comptime_value.internal_failure(fail.describe(known_r.err)); }
    val known: str = known_r.ok;
    fin { str_free(c.env.alloc, known); }
    var spelled: [64]u8;
    var i:       usize = 0;
    for (i < name.len && i < 63) {
        spelled[i] = name.data[i]::u8;
        i          = i + 1;
    }
    spelled[i] = 0;
    val fallback: str                              = "`$mach.build.extensions.<name>` names an extension the selected instruction set does not declare";
    val msg:      res[str, std_format.FormatError] = std_format.sprint(c.env.alloc,
        "`$mach.build.extensions.{}`: `{}` is not an extension of isa '{}'; its extensions are: {}",
        (?spelled[0])::str, (?spelled[0])::str, catalog_arch.name_for(c.env.target_arch_id), known);
    if (sel msg.err) { ret comptime_value.reject(diagnostic_kind.COMPTIME_EXTENSION_UNKNOWN, fallback); }
    ret comptime_value.reject(diagnostic_kind.COMPTIME_EXTENSION_UNKNOWN, msg.ok);
}

pub fun os_tag_for(name: View) res[u32, fail.Fail] {
    var i: usize = 0;
    for (i < catalog_os.count()) {
        val spelling: str = catalog_os.name_at(i);
        if (view_eq_str(name, spelling)) { ret res[u32, fail.Fail].ok{catalog_os.id_for(spelling)}; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].err{fail.message("unknown `$mach.os.*` tag")};
}

pub fun arch_tag_for(name: View) res[u32, fail.Fail] {
    var i: usize = 0;
    for (i < catalog_arch.count()) {
        val spelling: str = catalog_arch.name_at(i);
        if (view_eq_str(name, spelling)) { ret res[u32, fail.Fail].ok{catalog_arch.id_for(spelling)}; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].err{fail.message("unknown `$mach.arch.*` tag")};
}

