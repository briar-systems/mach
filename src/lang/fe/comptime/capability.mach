# what each phase lets a comptime evaluation ask of it: members, identifiers, types,
# fields and layout, published as one record per phase
use T:               std.allocator.testing;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_expr:         mach.lang.fe.ast.expr;
use ast_id:           mach.lang.fe.ast.id;
use comptime_deep:    mach.lang.fe.comptime.deep;
use comptime_failure: mach.lang.fe.comptime.failure;
use comptime_value:   mach.lang.fe.comptime.value;
use mach.lang.intern;
use mach.lang.type;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

pub val FIELD_SEL_NAME:         u8 = 0;
pub val FIELD_SEL_TYPE:         u8 = 1;
pub val FIELD_SEL_OFFSET:       u8 = 2;
pub val FIELD_SEL_ZERO_BY_NAME: u8 = 3;
pub val FIELD_SEL_HAS_PAYLOAD:  u8 = 4;
pub val FIELD_SEL_CODE:         u8 = 5;
pub val FIELD_SEL_TYPE_BY_NAME: u8 = 6;

pub val COMPTIME_CASE_NO_PAYLOAD_MSG: str =
    "this case has no payload, so it has no `.type` or `.offset`; gate on `.has_payload` first";

pub val TYPE_QUERY_IS_RECORD:    u8 = 0;
pub val TYPE_QUERY_IS_UNION:     u8 = 1;
pub val TYPE_QUERY_IS_POINTER:   u8 = 2;
pub val TYPE_QUERY_NAME:         u8 = 3;
pub val TYPE_QUERY_IS_SECRET:    u8 = 4;
pub val TYPE_QUERY_IS_TAG:       u8 = 5;
pub val TYPE_QUERY_IS_INTEGER:   u8 = 6;
pub val TYPE_QUERY_IS_FLOAT:     u8 = 7;
pub val TYPE_QUERY_HOLDS_SECRET: u8 = 8;

def PhaseCapabilityKind: u8;

pub val PHASE_CAP_NONE:           PhaseCapabilityKind = 0;
pub val PHASE_CAP_LOADING:        PhaseCapabilityKind = 1;
pub val PHASE_CAP_RESOLUTION:     PhaseCapabilityKind = 2;
val     PHASE_CAP_SEMANTIC_NAMES: PhaseCapabilityKind = 3;
val     PHASE_CAP_SEMANTIC_TYPES: PhaseCapabilityKind = 4;
val     PHASE_CAP_LOWERING:       PhaseCapabilityKind = 5;

# the context of an evaluation that holds no phase capability
pub rec NoCapabilityContext {}

pub rec PhaseCapabilities[T] {
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail];
    kind:       PhaseCapabilityKind;
    member:     fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    type_:      fun(*T, ast_id.ExprId) res[opt[u32], comptime_failure.EvalFail];
    # the type store the field descriptors read, and the byte offset of a field, which only
    # the phase that knows layout answers
    types:  fun(*T) *type.TypeInterner;
    offset: fun(*T, u32, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    query:  fun(*T, u32, u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    layout: fun(*T, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    ident:  fun(*T, ast_id.ExprId) bool;
    # the value of the module constant a bare name names, which only sema binds on demand
    constant: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail];
    cast:     fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail];
    scalar:   fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail];
    # the store of published constant values of the module with a stable id, which only the
    # phases that read interfaces hold
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail];
}

pub fun capabilities_empty[T](kind: PhaseCapabilityKind) PhaseCapabilities[T] {
    var caps: PhaseCapabilities[T];
    caps.kind       = kind;
    caps.expression = parsed_expression[T];
    caps.member     = nil;
    caps.type_      = nil;
    caps.types      = nil;
    caps.offset     = nil;
    caps.query      = nil;
    caps.layout     = nil;
    caps.ident      = nil;
    caps.constant   = nil;
    caps.cast       = nil;
    caps.scalar     = nil;
    caps.store      = nil;
    ret caps;
}

pub fun parsed_expression[T](ctx: *T, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    if (a == nil) { ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime expression has no parsed owner")}; }
    val found: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (sel found.none) { ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime expression identity is out of range")}; }
    ret res[ast_expr.Expr, comptime_failure.EvalFail].ok{@found.some};
}

pub fun read_expression[T](ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    if (!capabilities_complete[T](caps) || (ctx == nil && caps.kind != PHASE_CAP_NONE)) {
        ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime expression requires its active phase capability")};
    }
    ret caps.expression(ctx, a, eid);
}

# no phase capability: an expression reads literals and the constants its context binds
pub fun no_capabilities() PhaseCapabilities[NoCapabilityContext] {
    ret capabilities_empty[NoCapabilityContext](PHASE_CAP_NONE);
}

fun capabilities_complete[T](caps: PhaseCapabilities[T]) bool {
    if (caps.expression == nil) { ret false; }
    val no_types: bool = caps.type_ == nil && caps.offset == nil && caps.query == nil && caps.layout == nil && caps.cast == nil && caps.scalar == nil;
    val semantic: bool = caps.kind == PHASE_CAP_SEMANTIC_NAMES || caps.kind == PHASE_CAP_SEMANTIC_TYPES;
    if ((caps.constant != nil) != semantic)                                   { ret false; }
    if ((caps.store != nil) != (semantic || caps.kind == PHASE_CAP_LOWERING)) { ret false; }
    if (caps.kind == PHASE_CAP_NONE) {
        ret caps.member == nil && no_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_LOADING) {
        # the load casts to the integer a def chain names, so it may carry a cast and no other type capability
        val no_other_types: bool = caps.type_ == nil && caps.offset == nil && caps.query == nil && caps.layout == nil && caps.scalar == nil;
        ret caps.member != nil && no_other_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_RESOLUTION) {
        ret caps.member == nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_NAMES) {
        ret caps.member != nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING) {
        ret caps.member != nil && caps.type_ != nil && caps.offset != nil && caps.types != nil
            && caps.query != nil && caps.layout != nil && caps.ident != nil && caps.cast != nil && caps.scalar != nil;
    }
    ret false;
}

fun capabilities_publish[T](caps: PhaseCapabilities[T]) res[PhaseCapabilities[T], fail.Fail] {
    if (!capabilities_complete[T](caps)) {
        ret res[PhaseCapabilities[T], fail.Fail].err{fail.message("comptime: incomplete or contradictory phase capabilities")};
    }
    ret res[PhaseCapabilities[T], fail.Fail].ok{caps};
}

pub fun loading_capabilities[T](member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    cast: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_LOADING);
    caps.member = member;
    caps.cast   = cast;
    ret capabilities_publish[T](caps);
}

pub fun resolution_capabilities[T](ident: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_RESOLUTION);
    caps.ident      = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

pub fun semantic_name_capabilities[T](
    member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    constant: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail],
    ident: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_SEMANTIC_NAMES);
    caps.member     = member;
    caps.constant   = constant;
    caps.store      = store;
    caps.ident      = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

pub fun semantic_type_capabilities[T](
    member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    constant: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail],
    type_: fun(*T, ast_id.ExprId) res[opt[u32], comptime_failure.EvalFail],
    types: fun(*T) *type.TypeInterner,
    offset: fun(*T, u32, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    query: fun(*T, u32, u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    layout: fun(*T, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    cast: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    scalar: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    ident: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_SEMANTIC_TYPES);
    caps.member     = member;
    caps.constant   = constant;
    caps.store      = store;
    caps.type_      = type_;
    caps.types      = types;
    caps.offset     = offset;
    caps.query      = query;
    caps.layout     = layout;
    caps.cast       = cast;
    caps.scalar     = scalar;
    caps.ident      = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

pub fun lowering_capabilities[T](
    member: fun(*T, ast_id.ExprId) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    store: fun(*T, u32) res[*comptime_deep.Store, comptime_failure.EvalFail],
    type_: fun(*T, ast_id.ExprId) res[opt[u32], comptime_failure.EvalFail],
    types: fun(*T) *type.TypeInterner,
    offset: fun(*T, u32, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    query: fun(*T, u32, u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    layout: fun(*T, u32) res[opt[comptime_value.CTValue], comptime_failure.EvalFail],
    cast: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    scalar: fun(*T, ast_id.ExprId, comptime_value.CTValue) res[comptime_value.CTValue, comptime_failure.EvalFail],
    ident: fun(*T, ast_id.ExprId) bool,
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_LOWERING);
    caps.member     = member;
    caps.store      = store;
    caps.type_      = type_;
    caps.types      = types;
    caps.offset     = offset;
    caps.query      = query;
    caps.layout     = layout;
    caps.cast       = cast;
    caps.scalar     = scalar;
    caps.ident      = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

pub fun capabilities_have_member[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_LOADING
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

pub fun capabilities_have_ident[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_RESOLUTION
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

pub fun capabilities_have_constant[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.constant != nil;
}

# the store holding the node a value names, which only a phase that reads interfaces has
pub fun store_of[T](ctx: *T, caps: PhaseCapabilities[T], module: u32) res[*comptime_deep.Store, comptime_failure.EvalFail] {
    if (ctx == nil || !capabilities_complete[T](caps) || caps.store == nil) {
        ret res[*comptime_deep.Store, comptime_failure.EvalFail].err{comptime_failure.eval_internal("comptime: a published constant value is read outside a phase that reads interfaces")};
    }
    ret caps.store(ctx, module);
}

pub fun capabilities_have_types[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING;
}

pub fun capabilities_cast[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps) || caps.cast == nil) { ret false; }
    ret capabilities_have_types[T](ctx, caps) || caps.kind == PHASE_CAP_LOADING;
}

#[testing]
pub rec TCapabilityNested {
    inner:       PhaseCapabilities[u32];
    outer_calls: u32;
    inner_calls: u32;
}

# what a field descriptor answers about field `index` of `owner`, `pick` naming the member
# asked; every answer but the offset reads the type store, and the offset is the phase's
pub fun field_of[T](ctx: *T, caps: PhaseCapabilities[T], owner: u32, index: u32, pick: u8) res[opt[comptime_value.CTValue], comptime_failure.EvalFail] {
    val owner_ty: type.TypeId = owner::type.TypeId;
    if (pick == FIELD_SEL_ZERO_BY_NAME) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{zero_by_name(caps.types(ctx), owner_ty, index::intern.StrId)}; }
    if (pick == FIELD_SEL_TYPE_BY_NAME) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{type_by_name(caps.types(ctx), owner_ty, index::intern.StrId)}; }

    val fa: opt[*type.FieldEntry] = type.field_at(caps.types(ctx), owner_ty, index);
    if (sel fa.none) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}}; }
    val fe: *type.FieldEntry = fa.some;

    if (pick == FIELD_SEL_NAME) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_str(fe.name)}}; }
    if (pick == FIELD_SEL_HAS_PAYLOAD) {
        var bit: u8 = 1;
        if (type.is_nil(fe.ty)) { bit = 0; }
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_u8(bit)}};
    }
    if (pick == FIELD_SEL_CODE) { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_uint(index::u64)}}; }
    # a payloadless case owns no storage, so it has neither a type nor an offset
    if (type.is_nil(fe.ty) && (pick == FIELD_SEL_TYPE || pick == FIELD_SEL_OFFSET)) {
        ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_CASE_NO_PAYLOAD, COMPTIME_CASE_NO_PAYLOAD_MSG)};
    }
    if (pick == FIELD_SEL_TYPE)   { ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].some{comptime_value.ct_type(fe.ty::u32)}}; }
    if (pick == FIELD_SEL_OFFSET) { ret caps.offset(ctx, owner, index); }
    ret res[opt[comptime_value.CTValue], comptime_failure.EvalFail].ok{opt[comptime_value.CTValue].none{}};
}

# the entry of the field or case `name` declares on `owner`
fun field_named(types: *type.TypeInterner, owner: type.TypeId, name: intern.StrId) opt[*type.FieldEntry] {
    val stripped: type.TypeId = type.strip_secret(types, owner);
    val n:        u32         = type.field_count(types, stripped);
    var i:        u32         = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(types, stripped, i);
        if (sel fa.some && intern.str_same(fa.some.name, name)) { ret fa; }
        i = i + 1;
    }
    ret opt[*type.FieldEntry].none{};
}

# the declared type of a field or case payload named on an owner; none for an unknown name or a payloadless case
fun type_by_name(types: *type.TypeInterner, owner: type.TypeId, name: intern.StrId) opt[comptime_value.CTValue] {
    val fe: opt[*type.FieldEntry] = field_named(types, owner, name);
    if (sel fe.none)             { ret opt[comptime_value.CTValue].none{}; }
    if (type.is_nil(fe.some.ty)) { ret opt[comptime_value.CTValue].none{}; }
    ret opt[comptime_value.CTValue].some{comptime_value.ct_type(fe.some.ty::u32)};
}

# the zero of a scalar field named on an owner, which an initializer that omits it holds;
# none for an unknown name or a field that is no scalar
fun zero_by_name(types: *type.TypeInterner, owner: type.TypeId, name: intern.StrId) opt[comptime_value.CTValue] {
    val fe: opt[*type.FieldEntry] = field_named(types, owner, name);
    if (sel fe.none) { ret opt[comptime_value.CTValue].none{}; }
    val ft: opt[*type.Type] = type.get(types, type.strip_secret(types, fe.some.ty));
    if (sel ft.none) { ret opt[comptime_value.CTValue].none{}; }
    val kind: type.TypeKind = ft.some.kind;
    val pd:   type.PrimDesc = type.prim_desc(kind);
    if (pd.class == type.PRIM_CLASS_INT)   { ret opt[comptime_value.CTValue].some{comptime_value.ct_zero_int(!pd.signed, pd.bits::u8)}; }
    if (pd.class == type.PRIM_CLASS_FLOAT) { ret opt[comptime_value.CTValue].some{comptime_value.ct_float(0.0, type.float_width_of(kind))}; }
    ret opt[comptime_value.CTValue].none{};
}
