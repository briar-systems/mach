# the comptime intrinsic registry: one row per `$name(...)` the compiler answers,
# which every phase reads by id
#
# each phase decodes a comptime call's `$name` to the id it spells and decides by
# the id and its row, never by the name. a new intrinsic is a row here and the
# consumers that answer it
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use lang_source: mach.lang.source;

pub def Id: u8;

pub val NONE:            Id = 0;
pub val SIZE_OF:         Id = 1;
pub val ALIGN_OF:        Id = 2;
pub val OFFSET_OF:       Id = 3;
pub val LENGTH_OF:       Id = 4;
pub val TYPE_ID:         Id = 5;
pub val TYPE_NAME:       Id = 6;
pub val IS_RECORD:       Id = 7;
pub val IS_UNION:        Id = 8;
pub val IS_TAG:          Id = 9;
pub val IS_POINTER:      Id = 10;
pub val IS_SECRET:       Id = 11;
pub val HOLDS_SECRET:    Id = 12;
pub val IS_INTEGER:      Id = 13;
pub val IS_FLOAT:        Id = 14;
pub val TYPE_OF:         Id = 15;
pub val POINTEE_OF:      Id = 16;
pub val DISCRIMINANT_OF: Id = 17;
pub val FIELDS:          Id = 18;
pub val CASES:           Id = 19;
pub val ERROR:           Id = 20;

# what an intrinsic answers
# ---
# CLASS_LAYOUT:      a constant measured from a type's layout or identity
# CLASS_QUERY:       a predicate over a type, or its spelling
# CLASS_GATE:        a type compared inside a `$if` gate, never a value
# CLASS_CONSTRUCTOR: a type built from a type, written where a type is expected
# CLASS_ITERATION:   the members a `$each` walks
# CLASS_DIRECTIVE:   a compile-time refusal
pub def Class: u8;

pub val CLASS_LAYOUT:      Class = 0;
pub val CLASS_QUERY:       Class = 1;
pub val CLASS_GATE:        Class = 2;
pub val CLASS_CONSTRUCTOR: Class = 3;
pub val CLASS_ITERATION:   Class = 4;
pub val CLASS_DIRECTIVE:   Class = 5;

# one intrinsic
# ---
# args:         the argument count it takes
# type_operand: its first argument is a type, written in the full type grammar
pub rec Row {
    id:           Id;
    name:         str;
    class:        Class;
    args:         u32;
    type_operand: bool;
}

val COUNT: usize      = 20;
val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{id: SIZE_OF, name: "size_of", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: ALIGN_OF, name: "align_of", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: OFFSET_OF, name: "offset_of", class: CLASS_LAYOUT, args: 2, type_operand: true},
    Row{id: LENGTH_OF, name: "length_of", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: TYPE_ID, name: "type_id", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: TYPE_NAME, name: "type_name", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_RECORD, name: "is_record", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_UNION, name: "is_union", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_TAG, name: "is_tag", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_POINTER, name: "is_pointer", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_SECRET, name: "is_secret", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: HOLDS_SECRET, name: "holds_secret", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_INTEGER, name: "is_integer", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_FLOAT, name: "is_float", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: TYPE_OF, name: "type_of", class: CLASS_GATE, args: 1, type_operand: false},
    Row{id: POINTEE_OF, name: "pointee_of", class: CLASS_CONSTRUCTOR, args: 1, type_operand: false},
    Row{id: DISCRIMINANT_OF, name: "discriminant_of", class: CLASS_CONSTRUCTOR, args: 1, type_operand: false},
    Row{id: FIELDS, name: "fields", class: CLASS_ITERATION, args: 1, type_operand: true},
    Row{id: CASES, name: "cases", class: CLASS_ITERATION, args: 1, type_operand: true},
    Row{id: ERROR, name: "error", class: CLASS_DIRECTIVE, args: 1, type_operand: false},
};

# the row of `id`; nil for NONE and any id no row declares
pub fun row(id: Id) *Row {
    if (id == NONE || id::usize > COUNT) { ret nil; }
    ret ?ROWS[id::usize - 1];
}

# the intrinsic the name at `name` in `source` spells, without its `$`; NONE when it spells none
pub fun id_of(source: str, name: lang_source.Span) Id {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        if (str_region_equals(source, name.offset, name.len, r.name)) { ret r.id; }
        i = i + 1;
    }
    ret NONE;
}

# whether `id` answers within `class`
pub fun in_class(id: Id, class: Class) bool {
    val r: *Row = row(id);
    ret r != nil && r.class == class;
}

# whether `id` takes a type as its first argument
pub fun takes_type_operand(id: Id) bool {
    val r: *Row = row(id);
    ret r != nil && r.type_operand;
}

# every row sits at its id and spells a distinct name the lookup finds
test rows__sit_at_their_ids {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        if (r.id::usize != i + 1 || row(r.id) != r)                                   { ret 1; }
        if (id_of(r.name, lang_source.Span{offset: 0, len: str_len(r.name)}) != r.id) { ret 2; }
        if (r.args == 0)                                                              { ret 3; }
        var j: usize = 0;
        for (j < i) {
            if (str_equals(ROWS[j].name, r.name)) { ret 4; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (row(NONE) != nil || row((COUNT + 1)::Id) != nil)                       { ret 5; }
    if (id_of("size_ofs", lang_source.Span{offset: 0, len: 8}) != NONE)        { ret 6; }
    if (!in_class(OFFSET_OF, CLASS_LAYOUT) || in_class(TYPE_OF, CLASS_LAYOUT)) { ret 7; }
    if (!takes_type_operand(FIELDS) || takes_type_operand(POINTEE_OF))         { ret 8; }
    ret 0;
}
