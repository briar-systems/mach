# the comptime intrinsic registry: one row per `$name(...)` the compiler answers,
# which every phase reads by id
#
# each phase decodes a comptime call's `$name` to the id it spells and decides by
# the id and its row, never by the name. a new intrinsic is a row here and the
# consumers that answer it
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.string.str_region_equals;

use std.allocator.page;
use std.collections.vector.Vector;
use std.print;
use std.types.option.opt;
use std.types.result.res;

use A:                  std.allocator;
use collections_vector: std.collections.vector;

use mach.lang.fe.ast;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use mach.lang.lexis;
use mach.lang.reference;
use lang_source: mach.lang.source;
use mach.lang.textbuild;
use std.types.view.View;
use std.types.view.view_eq_str;

pub def Id: u8;

pub val NONE:            Id = 0;
pub val SIZE_OF:         Id = 1;
pub val ALIGN_OF:        Id = 2;
pub val OFFSET_OF:       Id = 3;
pub val LENGTH_OF:       Id = 4;
pub val TYPE_ID:         Id = 5;
pub val TYPE_NAME:       Id = 6;
pub val IS_RECORD:       Id = 7;
pub val IS_UNION:        Id = 8;
pub val IS_TAG:          Id = 9;
pub val IS_POINTER:      Id = 10;
pub val IS_SECRET:       Id = 11;
pub val HOLDS_SECRET:    Id = 12;
pub val IS_INTEGER:      Id = 13;
pub val IS_FLOAT:        Id = 14;
pub val TYPE_OF:         Id = 15;
pub val POINTEE_OF:      Id = 16;
pub val DISCRIMINANT_OF: Id = 17;
pub val FIELDS:          Id = 18;
pub val CASES:           Id = 19;
pub val ERROR:           Id = 20;

# what an intrinsic answers
# ---
# CLASS_LAYOUT:      a constant measured from a type's layout or identity
# CLASS_QUERY:       a predicate over a type, or its spelling
# CLASS_GATE:        a type compared inside a `$if` gate, never a value
# CLASS_CONSTRUCTOR: a type built from a type, written where a type is expected
# CLASS_ITERATION:   the members a `$each` walks
# CLASS_DIRECTIVE:   a compile-time refusal
pub def Class: u8;

pub val CLASS_LAYOUT:      Class = 0;
pub val CLASS_QUERY:       Class = 1;
pub val CLASS_GATE:        Class = 2;
pub val CLASS_CONSTRUCTOR: Class = 3;
pub val CLASS_ITERATION:   Class = 4;
pub val CLASS_DIRECTIVE:   Class = 5;

# one intrinsic
# ---
# args:         the argument count it takes
# type_operand: its first argument is a type, written in the full type grammar
pub rec Row {
    id:           Id;
    name:         str;
    class:        Class;
    args:         u32;
    type_operand: bool;
}

val COUNT: usize      = 20;
val ROWS:  [COUNT]Row = [COUNT]Row{
    Row{id: SIZE_OF, name: "size_of", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: ALIGN_OF, name: "align_of", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: OFFSET_OF, name: "offset_of", class: CLASS_LAYOUT, args: 2, type_operand: true},
    Row{id: LENGTH_OF, name: "length_of", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: TYPE_ID, name: "type_id", class: CLASS_LAYOUT, args: 1, type_operand: true},
    Row{id: TYPE_NAME, name: "type_name", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_RECORD, name: "is_record", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_UNION, name: "is_union", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_TAG, name: "is_tag", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_POINTER, name: "is_pointer", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_SECRET, name: "is_secret", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: HOLDS_SECRET, name: "holds_secret", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_INTEGER, name: "is_integer", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: IS_FLOAT, name: "is_float", class: CLASS_QUERY, args: 1, type_operand: true},
    Row{id: TYPE_OF, name: "type_of", class: CLASS_GATE, args: 1, type_operand: false},
    Row{id: POINTEE_OF, name: "pointee_of", class: CLASS_CONSTRUCTOR, args: 1, type_operand: false},
    Row{id: DISCRIMINANT_OF, name: "discriminant_of", class: CLASS_CONSTRUCTOR, args: 1, type_operand: false},
    Row{id: FIELDS, name: "fields", class: CLASS_ITERATION, args: 1, type_operand: true},
    Row{id: CASES, name: "cases", class: CLASS_ITERATION, args: 1, type_operand: true},
    Row{id: ERROR, name: "error", class: CLASS_DIRECTIVE, args: 1, type_operand: false},
};

# the row of `id`; nil for NONE and any id no row declares
pub fun row(id: Id) *Row {
    if (id == NONE || id::usize > COUNT) { ret nil; }
    ret ?ROWS[id::usize - 1];
}

# the intrinsic the name at `name` in `source` spells, without its `$`; NONE when it spells none
pub fun id_of(source: str, name: lang_source.Span) Id {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        if (str_region_equals(source, name.offset, name.len, r.name)) { ret r.id; }
        i = i + 1;
    }
    ret NONE;
}

# whether `id` answers within `class`
pub fun in_class(id: Id, class: Class) bool {
    val r: *Row = row(id);
    ret r != nil && r.class == class;
}

# whether `id` takes a type as its first argument
pub fun takes_type_operand(id: Id) bool {
    val r: *Row = row(id);
    ret r != nil && r.type_operand;
}

# every row sits at its id and spells a distinct name the lookup finds
test rows__sit_at_their_ids {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Row = ?ROWS[i];
        if (r.id::usize != i + 1 || row(r.id) != r)                                   { ret 1; }
        if (id_of(r.name, lang_source.Span{offset: 0, len: str_len(r.name)}) != r.id) { ret 2; }
        if (r.args == 0)                                                              { ret 3; }
        var j: usize = 0;
        for (j < i) {
            if (str_equals(ROWS[j].name, r.name)) { ret 4; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (row(NONE) != nil || row((COUNT + 1)::Id) != nil)                       { ret 5; }
    if (id_of("size_ofs", lang_source.Span{offset: 0, len: 8}) != NONE)        { ret 6; }
    if (!in_class(OFFSET_OF, CLASS_LAYOUT) || in_class(TYPE_OF, CLASS_LAYOUT)) { ret 7; }
    if (!takes_type_operand(FIELDS) || takes_type_operand(POINTEE_OF))         { ret 8; }
    ret 0;
}

# appends the names of `class`, each between `before` and `after`, joined by commas and
# `last` before the final one
fun class_list(b: *textbuild.TextBuilder, class: Class, before: str, after: str, last: str) {
    var count: usize = 0;
    var i:     usize = 0;
    for (i < COUNT) {
        if (ROWS[i].class == class) { count = count + 1; }
        i = i + 1;
    }
    var at: usize = 0;
    i = 0;
    for (i < COUNT) {
        if (ROWS[i].class == class) {
            if (at > 0 && at + 1 < count)  { textbuild.tb_append(b, ", "); }
            if (at > 0 && at + 1 == count) { textbuild.tb_append(b, last); }
            textbuild.tb_append(b, before);
            textbuild.tb_append(b, ROWS[i].name);
            textbuild.tb_append(b, after);
            at = at + 1;
        }
        i = i + 1;
    }
}

# the refusal of a `$` in a type that names no type constructor, listing the ones there are
pub fun constructor_refusal(a: *A.Allocator) res[str, textbuild.Error] {
    var b: textbuild.TextBuilder = textbuild.tb_init(a);
    fin { textbuild.tb_dnit(?b); }
    textbuild.tb_append(?b, "expected ");
    class_list(?b, CLASS_CONSTRUCTOR, "`", "`", " or ");
    textbuild.tb_append(?b, " after '$' in a type; ");
    class_list(?b, CLASS_CONSTRUCTOR, "`$", "(T)`", " and ");
    textbuild.tb_append(?b, " are the only comptime type constructors");
    ret textbuild.tb_finish(?b);
}

#[testing]
fun constructor_at(i: usize) str {
    if (ROWS[i].class != CLASS_CONSTRUCTOR) { ret nil; }
    ret ROWS[i].name;
}

# whether `text` writes `$<name>(` somewhere
#[testing]
fun called(text: str, name: str) bool {
    var at: usize = reference.find(text, 0, "$");
    val n:  usize = str_len(text);
    val nl: usize = str_len(name);
    for (at < n) {
        if (str_region_equals(text, at + 1, nl, name) && text[at + 1 + nl] == '(') { ret true; }
        at = reference.find(text, at + 1, "$");
    }
    ret false;
}

# the first `$<name>(` of `text` outside `skip` that names no intrinsic and no
# keyword; none when every one names an intrinsic
#[testing]
fun stray(text: str, skip: opt[lang_source.Span]) opt[lang_source.Span] {
    val n:  usize = str_len(text);
    var at: usize = reference.find(text, 0, "$");
    for (at < n) {
        var e: usize = at + 1;
        for ((text[e] >= 'a' && text[e] <= 'z') || (text[e] >= '0' && text[e] <= '9') || text[e] == '_') { e = e + 1; }
        val name:   lang_source.Span = lang_source.Span{offset: at + 1, len: e - at - 1};
        var exempt: bool             = name.len == 0 || text[e] != '(' || lexis.is_keyword((?text[at + 1])::str, name.len);
        if (sel skip.some) {
            if (at >= skip.some.offset && at < skip.some.offset + skip.some.len) { exempt = true; }
        }
        if (!exempt && id_of(text, name) == NONE) { ret opt[lang_source.Span].some{name}; }
        at = reference.find(text, e, "$");
    }
    ret opt[lang_source.Span].none{};
}

# the intrinsic pages are the registry: comptime-intrinsics.md and the authoring
# skill describe every intrinsic, grammar.md's type constructors are its
# constructor rows, and no page calls an intrinsic the registry does not hold
test reference__intrinsics_are_the_registry {
    var alloc: A.Allocator;
    page.make(?alloc);
    val grammar: opt[str] = reference.page_or_report(?alloc, "doc/language/grammar.md");
    if (sel grammar.none) { ret 1; }
    val ctors: opt[lang_source.Span] = reference.production(grammar.some, "type-constructor");
    if (sel ctors.none)                                                                                                                   { ret 2; }
    if (!reference.agree(?alloc, "grammar.md type-constructor", grammar.some, ctors.some, reference.WORDS_QUOTED, constructor_at, COUNT)) { ret 3; }

    val owner: opt[str] = reference.page_or_report(?alloc, "doc/language/comptime-intrinsics.md");
    if (sel owner.none) { ret 4; }
    val skill: opt[str] = reference.page_or_report(?alloc, "doc/skills/mach/SKILL.md");
    if (sel skill.none) { ret 4; }
    var i: usize = 0;
    for (i < COUNT) {
        if (!called(owner.some, ROWS[i].name)) {
            print.eprintlnf("comptime-intrinsics.md: `${}` is in the registry and not described", ROWS[i].name);
            ret 5;
        }
        if (!called(skill.some, ROWS[i].name)) {
            print.eprintlnf("SKILL.md: `${}` is in the registry and not listed", ROWS[i].name);
            ret 6;
        }
        i = i + 1;
    }

    val listed: opt[Vector[str]] = reference.pages(?alloc);
    if (sel listed.none) {
        print.eprintln("reference: cannot list the pages");
        ret 7;
    }
    var paths: Vector[str] = listed.some;
    i = 0;
    for (i < paths.len) {
        val path: opt[*str] = collections_vector.get[str](?paths, i);
        i = i + 1;
        if (sel path.none) { ret 7; }
        val text: opt[str] = reference.page_or_report(?alloc, @path.some);
        if (sel text.none) { ret 7; }
        var skip: opt[lang_source.Span] = opt[lang_source.Span].none{};
        if (str_ends_with(@path.some, "comptime-intrinsics.md")) { skip = reference.section(text.some, "## Not provided as intrinsics"); }
        val bad: opt[lang_source.Span] = stray(text.some, skip);
        if (sel bad.some) {
            print.eprintlnf("{}: `${}(` names no intrinsic", @path.some, reference.spelled(?alloc, text.some, bad.some));
            ret 8;
        }
    }
    ret 0;
}

# the intrinsic a comptime call `$name(...)` names; NONE for any other expression
pub fun call_intrinsic(a: *ast.Ast, source: str, eid: ast_id.ExprId) Id {
    if (ast_id.expr_is_nil(eid)) { ret NONE; }
    val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret NONE; }
    val node: *ast_expr.Expr = n_opt.some;
    if (node.kind != ast_expr.EXPR_KIND_CALL) { ret NONE; }
    val ce_opt: opt[*ast_expr.Expr] = ast.get_expr(a, node.data.call.callee);
    if (!sel ce_opt.some) { ret NONE; }
    val ce: *ast_expr.Expr = ce_opt.some;
    if (ce.kind != ast_expr.EXPR_KIND_COMPTIME_IDENT) { ret NONE; }
    ret ident_intrinsic(source, ce.data.comptime_ident.tok);
}

# the intrinsic a `$name` token spells
pub fun ident_intrinsic(source: str, full: lang_source.Span) Id {
    val ns: lang_source.Span = comptime_ident_name(full);
    if (ns.len == 0) { ret NONE; }
    ret id_of(source, ns);
}

pub fun first_call_arg(a: *ast.Ast, eid: ast_id.ExprId) ast_id.ExprId {
    if (ast_id.expr_is_nil(eid)) { ret ast_id.EXPR_NIL; }
    val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret ast_id.EXPR_NIL; }
    val node: *ast_expr.Expr = n_opt.some;
    if (node.kind != ast_expr.EXPR_KIND_CALL) { ret ast_id.EXPR_NIL; }
    if (node.data.call.args_len < 1)          { ret ast_id.EXPR_NIL; }
    ret a.expr_ids.data[node.data.call.args_start];
}

pub fun intrinsic_takes_type_operand(source: str, full: lang_source.Span) bool {
    ret takes_type_operand(ident_intrinsic(source, full));
}

pub fun is_type_of_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == TYPE_OF;
}

pub fun type_of_arg(a: *ast.Ast, eid: ast_id.ExprId) ast_id.ExprId {
    ret first_call_arg(a, eid);
}

pub fun is_fields_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == FIELDS;
}

pub fun is_cases_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == CASES;
}

pub fun is_layout_intrinsic_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret in_class(call_intrinsic(a, source, eid), CLASS_LAYOUT);
}

pub fun is_type_id_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == TYPE_ID;
}

pub fun is_length_of_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == LENGTH_OF;
}

pub fun is_offset_of_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == OFFSET_OF;
}

pub fun is_size_of_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == SIZE_OF;
}

pub fun is_align_of_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == ALIGN_OF;
}

pub fun layout_intrinsic_type_arg(a: *ast.Ast, eid: ast_id.ExprId) ast_id.ExprId {
    ret first_call_arg(a, eid);
}

pub fun fields_type_arg(a: *ast.Ast, eid: ast_id.ExprId) ast_id.ExprId {
    ret first_call_arg(a, eid);
}

pub fun is_error_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret call_intrinsic(a, source, eid) == ERROR;
}

pub fun type_operand_value(a: *ast.Ast, source: str, operand: ast_id.ExprId) ast_id.ExprId {
    if (is_type_of_call(a, source, operand)) { ret type_of_arg(a, operand); }
    ret operand;
}

pub fun is_type_comparison(a: *ast.Ast, source: str, bin: *ast_expr.ExprBinary) bool {
    ret is_type_of_call(a, source, bin.lhs) || is_type_of_call(a, source, bin.rhs);
}

pub fun is_type_comparison_binary(a: *ast.Ast, source: str, bin: *ast_expr.ExprBinary,
    lhs_is_field_type: bool, rhs_is_field_type: bool) bool {
    if (bin.op != ast_expr.BIN_EQ && bin.op != ast_expr.BIN_NEQ) { ret false; }
    ret is_type_comparison(a, source, bin) || lhs_is_field_type || rhs_is_field_type;
}

pub fun is_field_type_member(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    if (ast_id.expr_is_nil(eid)) { ret false; }
    val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret false; }
    val node: *ast_expr.Expr = n_opt.some;
    if (node.kind != ast_expr.EXPR_KIND_MEMBER) { ret false; }
    ret view_eq_str(lang_source.span_view(source, node.data.member.name), "type");
}

pub fun is_field_descriptor_member(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    if (ast_id.expr_is_nil(eid)) { ret false; }
    val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret false; }
    val node: *ast_expr.Expr = n_opt.some;
    if (node.kind != ast_expr.EXPR_KIND_MEMBER) { ret false; }
    val m: View = lang_source.span_view(source, node.data.member.name);
    ret view_eq_str(m, "name") || view_eq_str(m, "type") || view_eq_str(m, "offset")
        || view_eq_str(m, "has_payload") || view_eq_str(m, "code");
}

pub fun is_type_query_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret in_class(call_intrinsic(a, source, eid), CLASS_QUERY);
}

# a call that asks about a type: its layout, its identity, or a predicate over it
pub fun is_type_question_call(a: *ast.Ast, source: str, eid: ast_id.ExprId) bool {
    ret is_layout_intrinsic_call(a, source, eid) || is_type_of_call(a, source, eid) || is_type_query_call(a, source, eid);
}

# a call whose callee is a rooted comptime path: `$mach.build.ct_mul(low, 64)`
pub fun is_path_call(a: *ast.Ast, e: ast_id.ExprId) bool {
    if (ast_id.expr_is_nil(e)) { ret false; }
    val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, e);
    if (!sel n_opt.some) { ret false; }
    val node: *ast_expr.Expr = n_opt.some;
    if (node.kind != ast_expr.EXPR_KIND_CALL) { ret false; }
    val callee_opt: opt[*ast_expr.Expr] = ast.get_expr(a, node.data.call.callee);
    if (!sel callee_opt.some)                              { ret false; }
    if (callee_opt.some.kind != ast_expr.EXPR_KIND_MEMBER) { ret false; }
    ret is_comptime_path(a, node.data.call.callee);
}

# a rooted comptime path, or a call on one: both fold to a constant
pub fun is_comptime_value(a: *ast.Ast, e: ast_id.ExprId) bool {
    ret is_comptime_path(a, e) || is_path_call(a, e);
}

pub fun is_comptime_path(a: *ast.Ast, e: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = e;
    for (true) {
        if (ast_id.expr_is_nil(cur)) { ret false; }
        val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, cur);
        if (!sel n_opt.some) { ret false; }
        val node: *ast_expr.Expr = n_opt.some;
        if (node.kind == ast_expr.EXPR_KIND_COMPTIME_IDENT) { ret true; }
        if (node.kind == ast_expr.EXPR_KIND_MEMBER) {
            cur = node.data.member.object;
            cnt;
        }
        ret false;
    }
    ret false;
}

pub fun comptime_ident_name(full: lang_source.Span) lang_source.Span {
    var s: lang_source.Span;
    s.offset = full.offset + 1;
    if (full.len > 0) { s.len = full.len - 1; }
    or                { s.len = 0; }
    ret s;
}
