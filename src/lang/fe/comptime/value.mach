# the comptime value model: its kinds, constructors, integer and float arithmetic and
# casts between scalars
use lang_alloc:      mach.lang.alloc;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_expr:         mach.lang.fe.ast.expr;
use ast_id:           mach.lang.fe.ast.id;
use ast_type:         mach.lang.fe.ast.type;
use comptime_failure: mach.lang.fe.comptime.failure;
use mach.lang.float;
use mach.lang.intern;
use lang_source: mach.lang.source;
use mach.lang.type;
use mach.lang.wide;
use A: std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

pub def CTKind: u8;

pub val CT_KIND_INT:   CTKind = 0;
pub val CT_KIND_FLOAT: CTKind = 1;
pub val CT_KIND_STR:   CTKind = 2;

pub val CT_KIND_TYPE: CTKind = 3;

pub val CT_KIND_FIELD: CTKind = 4;

pub rec FieldRef {
    owner: u32;
    index: u32;
}

pub val CT_KIND_PACK_ELEM: CTKind = 5;

rec PackElemRef {
    index: u32;
    ty:    u32;
}

pub val CT_KIND_CONST_ELEM: CTKind = 6;

# a tag case descriptor from `$cases(T)`: the same owner/index shape as a field descriptor
pub val CT_KIND_CASE: CTKind = 7;

# an integer constant whose declared type is a def chain ending outside the integers;
# data.s is the interned refusal naming the chain, and reading it fails with that refusal
pub val CT_KIND_NON_INTEGER: CTKind = 8;

rec ConstElemRef {
    elem: u32;
    ty:   u32;
}

# a node of a module's published constant values (see comptime.deep), read at type `ty`;
# `module` is the stable id of the module whose store holds it
pub val CT_KIND_NODE: CTKind = 9;

pub rec NodeRef {
    module: u32;
    node:   u32;
    ty:     u32;
}

# an integer value is 128 bits in data.w; data.i is its low limb, and a signed
# value sign-fills the high limb so every reader of a value that fits 64 bits
# sees the same i64 it always did
pub rec CTValue {
    kind:         CTKind;
    int_unsigned: bool;
    int_width:    u8;
    float_width:  float.FloatWidth;
    data:         uni {
        i: i64;
        w: wide.Wide;
        f: f64;
        s: intern.StrId;
        t: u32;
        fld: FieldRef;
        pelem: PackElemRef;
        celem: ConstElemRef;
        node: NodeRef;
    };
}

val FLOAT_WIDTH_MISMATCH_MSG: str =
    "float operands have different declared widths; mach has no implicit widening";

pub fun internal_failure(message: str) res[CTValue, comptime_failure.EvalFail] {
    ret res[CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_internal(message)};
}

pub fun reject(diag: diagnostic_kind.Kind, message: str) res[CTValue, comptime_failure.EvalFail] {
    ret awaiting(comptime_failure.EVAL_FAIL_REJECTED, diag, message);
}

pub fun awaiting(kind: comptime_failure.EvalFailKind, diag: diagnostic_kind.Kind, message: str) res[CTValue, comptime_failure.EvalFail] {
    var f: comptime_failure.EvalFail;
    f.kind    = kind;
    f.diag    = diag;
    f.message = message;
    ret res[CTValue, comptime_failure.EvalFail].err{f};
}

pub fun cast_int(bits: wide.Wide, width: u32, signed: bool) res[CTValue, comptime_failure.EvalFail] {
    if (width == 0 || width > 128) { ret internal_failure("comptime scalar cast has an invalid integer width"); }
    var value: wide.Wide = wide.trunc(bits, width);
    if (signed) { value = wide.sext(bits, width); }
    var out: CTValue;
    out.kind         = CT_KIND_INT;
    out.int_unsigned = !signed;
    out.int_width    = width::u8;
    out.data.w       = value;
    ret res[CTValue, comptime_failure.EvalFail].ok{out};
}

fun cast_desc(types: *type.TypeInterner, tid: type.TypeId, pointer_width: u32) res[type.PrimDesc, comptime_failure.EvalFail] {
    val found: opt[*type.Type] = type.get(types, type.strip_secret(types, tid));
    if (!sel found.some) {
        ret res[type.PrimDesc, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_NEEDS_TYPES, diagnostic_kind.COMPTIME_TOO_EARLY, "comptime cast type is not resolved")};
    }
    val kind: type.TypeKind = found.some.kind;
    var desc: type.PrimDesc = type.prim_desc(kind);
    if (kind == type.TYPE_PTR || kind == type.TYPE_POINTER || kind == type.TYPE_FUN) {
        desc.class  = type.PRIM_CLASS_PTR;
        desc.bits   = pointer_width * 8;
        desc.signed = false;
    }
    if (desc.class == type.PRIM_CLASS_NONE) {
        ret res[type.PrimDesc, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_CAST, "comptime casts require scalar types")};
    }
    ret res[type.PrimDesc, comptime_failure.EvalFail].ok{desc};
}

# a float converted to another float width folds by `nan_rule`, the target's, so the
# folded conversion is the one the target makes at run time
pub fun cast_scalar(types: *type.TypeInterner, pointer_width: u32, nan_rule: float.NanRule, value: CTValue,
    from_ty: type.TypeId, to_ty: type.TypeId, reinterpret: bool) res[CTValue, comptime_failure.EvalFail] {
    val from_r: res[type.PrimDesc, comptime_failure.EvalFail] = cast_desc(types, from_ty, pointer_width);
    if (sel from_r.err) { ret res[CTValue, comptime_failure.EvalFail].err{from_r.err}; }
    val to_r: res[type.PrimDesc, comptime_failure.EvalFail] = cast_desc(types, to_ty, pointer_width);
    if (sel to_r.err) { ret res[CTValue, comptime_failure.EvalFail].err{to_r.err}; }
    val from:           type.PrimDesc = from_r.ok;
    val to:             type.PrimDesc = to_r.ok;
    val representation: bool          = reinterpret || from.class == type.PRIM_CLASS_PTR || to.class == type.PRIM_CLASS_PTR;
    if (representation && from.bits != to.bits) { ret reject(diagnostic_kind.COMPTIME_CAST, "comptime bit reinterpret requires equal source and destination sizes"); }
    if (value.kind == CT_KIND_STR && from.class == type.PRIM_CLASS_PTR && to.class == type.PRIM_CLASS_PTR) {
        ret res[CTValue, comptime_failure.EvalFail].ok{value};
    }
    val from_float: bool = from.class == type.PRIM_CLASS_FLOAT;
    val to_float:   bool = to.class == type.PRIM_CLASS_FLOAT;
    if ((from_float && value.kind != CT_KIND_FLOAT) || (!from_float && value.kind != CT_KIND_INT)) {
        ret reject(diagnostic_kind.COMPTIME_CAST, "comptime cast operand is not a scalar value of its source type");
    }
    val fw: float.FloatWidth = float.width_of_bits(to.bits);
    if (from_float) {
        val source_fw: float.FloatWidth                        = float.width_of_bits(from.bits);
        val source_r:  res[CTValue, comptime_failure.EvalFail] = float_value(value.data.f, source_fw);
        if (sel source_r.err) { ret source_r; }
        val source_value: f64 = source_r.ok.data.f;
        if (to_float) {
            if (source_value != source_value && fw != source_fw && !float.nan_rule_valid(nan_rule)) {
                ret reject(diagnostic_kind.COMPTIME_CAST, "a NaN converted to another float width folds only for a selected target");
            }
            ret float_value(float.convert(source_value, source_fw, fw, nan_rule), fw);
        }
        if (representation) { ret cast_int(wide.from_u64(float.bits_at(source_value, source_fw)), to.bits, to.signed); }
        if (to.signed)      { ret cast_int(wide.from_f64_s(source_value), to.bits, true); }
        ret cast_int(wide.from_f64_u(source_value), to.bits, false);
    }
    val source_r: res[CTValue, comptime_failure.EvalFail] = cast_int(value.data.w, from.bits, from.signed);
    if (sel source_r.err) { ret source_r; }
    val source_value: wide.Wide = source_r.ok.data.w;
    if (!to_float)      { ret cast_int(source_value, to.bits, to.signed); }
    if (representation) { ret float_value(float.value_of_bits(source_value.lo, fw), fw); }
    if (from.signed)    { ret float_value(wide.to_f64_s(source_value), fw); }
    ret float_value(wide.to_f64_u(source_value), fw);
}

pub fun is_descriptor(v: CTValue) bool {
    ret v.kind == CT_KIND_FIELD || v.kind == CT_KIND_CASE;
}

pub fun apply_declared_int_type(a: *ast.Ast, source: str, t: ast_id.TypeId, value: CTValue) CTValue {
    var out: CTValue = value;
    if (out.kind != CT_KIND_INT || ast_id.type_is_nil(t)) { ret out; }
    val found: opt[*ast_type.Type] = ast.get_type(a, t);
    if (!sel found.some) { ret out; }
    val ty: *ast_type.Type = found.some;
    if (ty.kind == ast_type.TYPE_KIND_SECRET)                               { ret apply_declared_int_type(a, source, ty.data.secret.inner, out); }
    if (ty.kind != ast_type.TYPE_KIND_NAMED || ty.data.named.args_len != 0) { ret out; }
    # the catalog decides the width and signedness a spelling declares; any
    # other name leaves the value untyped
    out.int_width = 0;
    val kind: opt[type.TypeKind] = type.prim_from_view(lang_source.span_view(source, ty.data.named.name));
    if (sel kind.some) {
        val d: type.PrimDesc = type.prim_desc(kind.some);
        if (d.class == type.PRIM_CLASS_INT) { ret typed_int(out, !d.signed, d.bits::u8); }
    }
    ret out;
}

# an integer cast as a scalar cast computes it: a typed operand is read at its own width and sign,
# an untyped one as it stands, then the result is cut or extended to the destination
pub fun cast_to_int(value: CTValue, width: u32, signed: bool) res[CTValue, comptime_failure.EvalFail] {
    if (value.kind != CT_KIND_INT) { ret reject(diagnostic_kind.COMPTIME_CAST, "comptime cast operand is not a scalar value of its source type"); }
    var source: wide.Wide = value.data.w;
    if (value.int_width != 0) {
        val read: res[CTValue, comptime_failure.EvalFail] = cast_int(value.data.w, value.int_width::u32, !value.int_unsigned);
        if (sel read.err) { ret read; }
        source = read.ok.data.w;
    }
    ret cast_int(source, width, signed);
}

pub fun typed_int(value: CTValue, unsigned: bool, width: u8) CTValue {
    var out: CTValue = value;
    out.int_unsigned = unsigned;
    out.int_width    = width;
    ret out;
}

pub fun float_width_unread(v: CTValue) bool {
    ret v.kind == CT_KIND_FLOAT && v.float_width == float.FLOAT_W_NONE;
}

pub fun ct_is_negative(v: CTValue) bool {
    if (v.kind != CT_KIND_INT) { ret false; }
    if (v.int_unsigned)        { ret false; }
    ret wide.is_negative(v.data.w);
}

# an integer value that is neither negative nor above u64, read as a u64
pub fun ct_int_u64(v: CTValue) opt[u64] {
    if (v.kind != CT_KIND_INT || ct_is_negative(v)) { ret opt[u64].none{}; }
    if (v.data.w.hi != 0)                           { ret opt[u64].none{}; }
    ret opt[u64].some{v.data.w.lo};
}

# the decimal text of an integer value in a wide.FORMAT_CAP buffer
pub fun ct_int_text(v: CTValue, buf: *u8) str {
    if (v.int_unsigned) { ret wide.text_u(v.data.w, buf); }
    ret wide.text_s(v.data.w, buf);
}

# operands of one sign order as their two's complement bit patterns
fun ct_int_lt(a: CTValue, b: CTValue) bool {
    val an: bool = ct_is_negative(a);
    val bn: bool = ct_is_negative(b);
    if (an != bn) { ret an; }
    ret wide.lt_u(a.data.w, b.data.w);
}

fun ct_int_eq(a: CTValue, b: CTValue) bool {
    if (ct_is_negative(a) != ct_is_negative(b)) { ret false; }
    ret wide.eq(a.data.w, b.data.w);
}

pub fun apply_equality(op: ast_expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, comptime_failure.EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject(diagnostic_kind.COMPTIME_OPERAND_TYPE, "equality requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_FLOAT && !float.widths_agree(lhs.float_width, rhs.float_width)) {
        ret reject(diagnostic_kind.COMPTIME_FLOAT_WIDTH_MISMATCH, FLOAT_WIDTH_MISMATCH_MSG);
    }
    var eq: bool = false;
    if (lhs.kind == CT_KIND_INT) { eq = ct_int_eq(lhs, rhs); }
    or (lhs.kind == CT_KIND_FLOAT) {
        val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
        eq = float.round_at(lhs.data.f, w) == float.round_at(rhs.data.f, w);
    }
    or (lhs.kind == CT_KIND_STR)  { eq = intern.str_same(lhs.data.s, rhs.data.s); }
    or (lhs.kind == CT_KIND_TYPE) { eq = lhs.data.t == rhs.data.t; }
    or                            { ret reject(diagnostic_kind.COMPTIME_OPERAND_TYPE, "equality requires integer, float, string or type operands"); }

    if (op == ast_expr.BIN_EQ) { ret u8_value(if_u8(eq)); }
    ret u8_value(if_u8(!eq));
}

pub fun apply_compare(op: ast_expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, comptime_failure.EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject(diagnostic_kind.COMPTIME_OPERAND_TYPE, "comparison requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_INT) {
        if (op == ast_expr.BIN_LT)  { ret u8_value(if_u8(ct_int_lt(lhs, rhs))); }
        if (op == ast_expr.BIN_LEQ) { ret u8_value(if_u8(!ct_int_lt(rhs, lhs))); }
        if (op == ast_expr.BIN_GT)  { ret u8_value(if_u8(ct_int_lt(rhs, lhs))); }
        ret u8_value(if_u8(!ct_int_lt(lhs, rhs)));
    }
    if (lhs.kind == CT_KIND_FLOAT) {
        if (!float.widths_agree(lhs.float_width, rhs.float_width)) {
            ret reject(diagnostic_kind.COMPTIME_FLOAT_WIDTH_MISMATCH, FLOAT_WIDTH_MISMATCH_MSG);
        }
        val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
        val l: f64              = float.round_at(lhs.data.f, w);
        val r: f64              = float.round_at(rhs.data.f, w);
        if (op == ast_expr.BIN_LT)  { ret u8_value(if_u8(l < r)); }
        if (op == ast_expr.BIN_LEQ) { ret u8_value(if_u8(l <= r)); }
        if (op == ast_expr.BIN_GT)  { ret u8_value(if_u8(l > r)); }
        ret u8_value(if_u8(l >= r));
    }
    ret reject(diagnostic_kind.COMPTIME_OPERAND_TYPE, "ordered comparison requires numeric operands");
}

# the quotient here is a zero, an infinity or a NaN, which truncation leaves
# unchanged, so the formula is taken in floating point as the lowering takes it.
# a zero quotient is a finite dividend over an infinite divisor, which gives the
# dividend as in C fmod
fun float_trunc_rem_narrow(a: f64, b: f64, w: float.FloatWidth) f64 {
    val q: f64 = float.round_at(a / b, w);
    if (q == 0.0) { ret a; }
    ret float.round_at(a - float.round_at(q * b, w), w);
}

fun float_trunc_rem(a: f64, b: f64, w: float.FloatWidth) f64 {
    val ab: u64 = float.f64_bits(a);
    val bb: u64 = float.f64_bits(b);
    val ae: u64 = (ab >> 52) & 0x7FF;
    val be: u64 = (bb >> 52) & 0x7FF;

    if (ae == 0x7FF || be == 0x7FF || b == 0.0) {
        ret float_trunc_rem_narrow(a, b, w);
    }

    val neg: bool = float.f64_signbit(a);
    var x:   f64  = a;
    if (neg) { x = float.f64_neg(x); }
    var y: f64 = b;
    if (float.f64_signbit(b)) { y = float.f64_neg(y); }

    if (x < y) { ret float.round_at(a, w); }

    var yk: f64 = y;
    for (yk <= x / 2.0) { yk = yk * 2.0; }

    for (yk >= y) {
        if (x >= yk) { x = x - yk; }
        yk = yk / 2.0;
    }

    if (neg) { x = float.f64_neg(x); }
    ret float.round_at(x, w);
}

pub fun apply_arith(op: ast_expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, comptime_failure.EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject(diagnostic_kind.COMPTIME_OPERAND_TYPE, "arithmetic requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_INT)   { ret apply_int_arith(op, lhs, rhs); }
    if (lhs.kind == CT_KIND_FLOAT) { ret apply_float_arith(op, lhs, rhs); }
    ret reject(diagnostic_kind.COMPTIME_OPERAND_TYPE, "arithmetic requires numeric operands");
}

fun apply_float_arith(op: ast_expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, comptime_failure.EvalFail] {
    if (!float.widths_agree(lhs.float_width, rhs.float_width)) {
        ret reject(diagnostic_kind.COMPTIME_FLOAT_WIDTH_MISMATCH, FLOAT_WIDTH_MISMATCH_MSG);
    }
    val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
    val l: f64              = float.round_at(lhs.data.f, w);
    val r: f64              = float.round_at(rhs.data.f, w);

    if (op == ast_expr.BIN_ADD) { ret float_value(l + r, w); }
    if (op == ast_expr.BIN_SUB) { ret float_value(l - r, w); }
    if (op == ast_expr.BIN_MUL) { ret float_value(l * r, w); }
    if (op == ast_expr.BIN_DIV) {
        if (r == 0.0) { ret reject(diagnostic_kind.COMPTIME_DIVISION_BY_ZERO, "float division by zero"); }
        ret float_value(l / r, w);
    }
    if (op == ast_expr.BIN_MOD) {
        if (r == 0.0) { ret reject(diagnostic_kind.COMPTIME_DIVISION_BY_ZERO, "float modulo by zero"); }
        ret float_value(float_trunc_rem(l, r, w), w);
    }
    ret reject(diagnostic_kind.COMPTIME_NOT_EVALUABLE, "unsupported float operator");
}

fun bitwise_value(bits: wide.Wide, lhs: CTValue, rhs: CTValue) res[CTValue, comptime_failure.EvalFail] {
    val unsigned: bool = lhs.int_unsigned || rhs.int_unsigned;
    if (lhs.int_width != 0 && lhs.int_width == rhs.int_width) {
        ret cast_int(bits, lhs.int_width::u32, !unsigned);
    }
    ret make_int_wide(bits, unsigned);
}

fun apply_int_arith(op: ast_expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, comptime_failure.EvalFail] {
    val res_uns: bool = lhs.int_unsigned || rhs.int_unsigned;

    if (op == ast_expr.BIN_BIT_AND)                       { ret bitwise_value(wide.and(lhs.data.w, rhs.data.w), lhs, rhs); }
    if (op == ast_expr.BIN_BIT_OR)                        { ret bitwise_value(wide.or (lhs.data.w, rhs.data.w), lhs, rhs); }
    if (op == ast_expr.BIN_BIT_XOR)                       { ret bitwise_value(wide.xor(lhs.data.w, rhs.data.w), lhs, rhs); }
    if (op == ast_expr.BIN_SHL || op == ast_expr.BIN_SHR) { ret apply_int_shift(op, lhs, rhs); }

    if (!res_uns) { ret apply_signed_arith(op, lhs.data.w, rhs.data.w); }
    if (ct_is_negative(lhs) || ct_is_negative(rhs)) {
        ret reject(diagnostic_kind.COMPTIME_OPERAND_TYPE, "comptime arithmetic mixes a negative value with an unsigned operand");
    }
    ret apply_unsigned_arith(op, lhs.data.w, rhs.data.w);
}

fun apply_signed_arith(op: ast_expr.BinOp, a: wide.Wide, b: wide.Wide) res[CTValue, comptime_failure.EvalFail] {
    var overflow: bool = false;
    if (op == ast_expr.BIN_ADD) {
        val s: wide.Wide = wide.add_signed(a, b, ?overflow);
        if (overflow) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime integer overflow in '+'"); }
        ret make_int_wide(s, false);
    }
    if (op == ast_expr.BIN_SUB) {
        val s: wide.Wide = wide.sub_signed(a, b, ?overflow);
        if (overflow) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime integer overflow in '-'"); }
        ret make_int_wide(s, false);
    }
    if (op == ast_expr.BIN_MUL) {
        if (wide.mul_overflows_s(a, b)) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime integer overflow in '*'"); }
        ret make_int_wide(wide.mul(a, b), false);
    }
    val min_by_minus_one: bool = wide.eq(a, wide.min_s()) && wide.eq(b, wide.from_i64(-1));
    var q:                wide.Wide;
    var r:                wide.Wide;
    if (op == ast_expr.BIN_DIV) {
        if (wide.is_zero(b))  { ret reject(diagnostic_kind.COMPTIME_DIVISION_BY_ZERO, "integer division by zero"); }
        if (min_by_minus_one) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "integer division overflow (INT128_MIN / -1)"); }
        wide.divmod_s(a, b, ?q, ?r);
        ret make_int_wide(q, false);
    }
    if (op == ast_expr.BIN_MOD) {
        if (wide.is_zero(b))  { ret reject(diagnostic_kind.COMPTIME_DIVISION_BY_ZERO, "integer modulo by zero"); }
        if (min_by_minus_one) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "integer modulo overflow (INT128_MIN % -1)"); }
        wide.divmod_s(a, b, ?q, ?r);
        ret make_int_wide(r, false);
    }
    ret reject(diagnostic_kind.COMPTIME_NOT_EVALUABLE, "unsupported integer operator");
}

fun apply_unsigned_arith(op: ast_expr.BinOp, a: wide.Wide, b: wide.Wide) res[CTValue, comptime_failure.EvalFail] {
    var flag: bool = false;
    if (op == ast_expr.BIN_ADD) {
        val s: wide.Wide = wide.add_carry(a, b, ?flag);
        if (flag) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime integer overflow in '+'"); }
        ret make_int_wide(s, true);
    }
    if (op == ast_expr.BIN_SUB) {
        val d: wide.Wide = wide.sub_borrow(a, b, ?flag);
        if (flag) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime integer overflow in '-'"); }
        ret make_int_wide(d, true);
    }
    if (op == ast_expr.BIN_MUL) {
        if (wide.mul_overflows_u(a, b)) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime integer overflow in '*'"); }
        ret make_int_wide(wide.mul(a, b), true);
    }
    var q: wide.Wide;
    var r: wide.Wide;
    if (op == ast_expr.BIN_DIV) {
        if (!wide.divmod_u(a, b, ?q, ?r)) { ret reject(diagnostic_kind.COMPTIME_DIVISION_BY_ZERO, "integer division by zero"); }
        ret make_int_wide(q, true);
    }
    if (op == ast_expr.BIN_MOD) {
        if (!wide.divmod_u(a, b, ?q, ?r)) { ret reject(diagnostic_kind.COMPTIME_DIVISION_BY_ZERO, "integer modulo by zero"); }
        ret make_int_wide(r, true);
    }
    ret reject(diagnostic_kind.COMPTIME_NOT_EVALUABLE, "unsupported integer operator");
}

fun apply_int_shift(op: ast_expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, comptime_failure.EvalFail] {
    if (ct_is_negative(rhs))                        { ret reject(diagnostic_kind.COMPTIME_SHIFT_COUNT, "comptime shift amount is negative"); }
    if (rhs.data.w.hi != 0 || rhs.data.w.lo >= 128) { ret reject(diagnostic_kind.COMPTIME_SHIFT_COUNT, "comptime shift amount must be less than 128"); }
    # a typed operand is shifted at its own width, and the runtime rule at or
    # above that width is saturation, which a constant program never means
    if (lhs.int_width != 0 && rhs.data.w.lo >= lhs.int_width::u64) {
        ret reject(diagnostic_kind.COMPTIME_SHIFT_COUNT, "comptime shift amount is at least the width of the shifted operand");
    }
    val amt: u32 = rhs.data.w.lo::u32;
    if (op == ast_expr.BIN_SHL) {
        if (amt > 0) {
            val discarded: wide.Wide = wide.shr_u(lhs.data.w, 128 - amt);
            if (!wide.is_zero(discarded)) { ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime left shift discards significant bits"); }
        }
        val shifted: wide.Wide = wide.shl(lhs.data.w, amt);
        ret make_int_wide(shifted, wide.is_negative(shifted));
    }
    if (lhs.int_unsigned) { ret make_int_wide(wide.shr_u(lhs.data.w, amt), true); }
    ret make_int_wide(wide.shr_s(lhs.data.w, amt), false);
}

pub fun non_integer(message: intern.StrId) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_NON_INTEGER;
    v.int_unsigned = false;
    v.int_width    = 0;
    v.float_width  = float.FLOAT_W_NONE;
    v.data.w       = wide.make(0, 0);
    v.data.s       = message;
    ret v;
}

# a named constant's value as a reader sees it: a non-integer constant fails with its refusal
pub fun readable(v: CTValue, interner: *intern.Interner) res[CTValue, comptime_failure.EvalFail] {
    if (v.kind != CT_KIND_NON_INTEGER) { ret res[CTValue, comptime_failure.EvalFail].ok{v}; }
    val message: opt[str] = intern.get(interner, v.data.s);
    if (sel message.none) { ret internal_failure("non-integer constant refusal is not interned"); }
    ret awaiting(comptime_failure.EVAL_FAIL_NOT_INTEGER, diagnostic_kind.COMPTIME_NOT_INTEGER, message.some);
}

pub fun make_int_wide(bits: wide.Wide, unsigned: bool) res[CTValue, comptime_failure.EvalFail] {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = 0;
    v.data.w       = bits;
    ret res[CTValue, comptime_failure.EvalFail].ok{v};
}

# a 64-bit producer: the bits are a u64 when unsigned and an i64 otherwise
fun make_int_value(bits: i64, unsigned: bool) res[CTValue, comptime_failure.EvalFail] {
    if (unsigned) { ret make_int_wide(wide.from_u64(bits:~u64), unsigned); }
    ret make_int_wide(wide.from_i64(bits), unsigned);
}

pub fun int_value(i: i64) res[CTValue, comptime_failure.EvalFail] {
    ret make_int_value(i, false);
}

# -x over the untyped 128-bit range: the signed minimum negates to its own
# magnitude, which only reads as unsigned; an unsigned magnitude past it has no
# negation
pub fun ct_negate(v: CTValue) res[CTValue, comptime_failure.EvalFail] {
    if (!v.int_unsigned) {
        if (wide.eq(v.data.w, wide.min_s())) { ret make_int_wide(v.data.w, true); }
        ret make_int_wide(wide.neg(v.data.w), false);
    }
    if (wide.is_zero(v.data.w)) { ret make_int_wide(wide.zero(), false); }
    if (wide.lt_u(wide.min_s(), v.data.w)) {
        ret reject(diagnostic_kind.COMPTIME_OVERFLOW, "comptime negation of an unsigned value is out of range");
    }
    ret make_int_wide(wide.neg(v.data.w), false);
}

pub fun float_value(f: f64, w: float.FloatWidth) res[CTValue, comptime_failure.EvalFail] {
    ret res[CTValue, comptime_failure.EvalFail].ok{ct_float(f, w)};
}

pub fun ct_float(f: f64, w: float.FloatWidth) CTValue {
    var v: CTValue;
    v.kind        = CT_KIND_FLOAT;
    v.float_width = w;
    v.data.f      = float.round_at(f, w);
    ret v;
}

pub fun u8_value(n: u8) res[CTValue, comptime_failure.EvalFail] {
    ret res[CTValue, comptime_failure.EvalFail].ok{ct_u8(n)};
}

pub fun str_value(s: intern.StrId) res[CTValue, comptime_failure.EvalFail] {
    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = s;
    ret res[CTValue, comptime_failure.EvalFail].ok{v};
}

pub fun type_value(t: u32) res[CTValue, comptime_failure.EvalFail] {
    var v: CTValue;
    v.kind   = CT_KIND_TYPE;
    v.data.t = t;
    ret res[CTValue, comptime_failure.EvalFail].ok{v};
}

pub fun field_value(owner: u32, index: u32) CTValue {
    var v: CTValue;
    v.kind           = CT_KIND_FIELD;
    v.data.fld.owner = owner;
    v.data.fld.index = index;
    ret v;
}

pub fun case_value(owner: u32, index: u32) CTValue {
    var v: CTValue;
    v.kind           = CT_KIND_CASE;
    v.data.fld.owner = owner;
    v.data.fld.index = index;
    ret v;
}

pub fun pack_elem_value(index: u32, ty: u32) CTValue {
    var v: CTValue;
    v.kind             = CT_KIND_PACK_ELEM;
    v.data.pelem.index = index;
    v.data.pelem.ty    = ty;
    ret v;
}

# a constant element whose checked type is not yet known: name resolution and loading bind case
# literals this way, and type checking rebinds them with the declared type
pub fun const_elem_untyped(elem: u32) CTValue {
    ret const_elem_value(elem, type.index(type.TYPE_NIL));
}

pub fun const_elem_value(elem: u32, ty: u32) CTValue {
    var v: CTValue;
    v.kind            = CT_KIND_CONST_ELEM;
    v.data.celem.elem = elem;
    v.data.celem.ty   = ty;
    ret v;
}

pub fun node_ref(module: u32, node: u32, ty: u32) CTValue {
    var v: CTValue;
    v.kind             = CT_KIND_NODE;
    v.data.node.module = module;
    v.data.node.node   = node;
    v.data.node.ty     = ty;
    ret v;
}

pub fun ct_str(s: intern.StrId) CTValue {
    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = s;
    ret v;
}

pub fun ct_u8(n: u8) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 8;
    v.data.w       = wide.from_u64(n::u64);
    ret v;
}

pub fun is_u8(v: CTValue) bool {
    ret v.kind == CT_KIND_INT && v.int_unsigned && v.int_width == 8;
}

pub fun truth(v: CTValue) bool {
    ret v.kind == CT_KIND_INT && wide.eq(v.data.w, wide.from_u64(1));
}

pub fun if_u8(v: bool) u8 {
    if (v) { ret 1; }
    ret 0;
}

pub fun ct_type(t: u32) CTValue {
    var v: CTValue;
    v.kind   = CT_KIND_TYPE;
    v.data.t = t;
    ret v;
}

pub fun ct_uint(n: u64) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 64;
    v.data.w       = wide.from_u64(n);
    ret v;
}

pub fun ct_zero_int(unsigned: bool, width: u8) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = width;
    v.data.w       = wide.zero();
    ret v;
}

#[testing]
pub fun t_ct_wide(lo: u64, hi: u64, unsigned: bool) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = 0;
    v.data.w       = wide.make(lo, hi);
    ret v;
}

#[testing]
pub fun t_is(v: CTValue, lo: u64, hi: u64, unsigned: bool) bool {
    ret v.kind == CT_KIND_INT && v.data.w.lo == lo && v.data.w.hi == hi && v.int_unsigned == unsigned;
}

#[testing]
pub fun t_ok_is(r: res[CTValue, comptime_failure.EvalFail], lo: u64, hi: u64, unsigned: bool) bool {
    if (sel r.err) { ret false; }
    ret t_is(r.ok, lo, hi, unsigned);
}

#[testing]
fun t_val(r: res[CTValue, comptime_failure.EvalFail]) CTValue {
    if (sel r.err) { ret ct_zero_int(false, 0); }
    ret r.ok;
}

#[testing]
pub fun t_width(r: res[CTValue, comptime_failure.EvalFail]) u8 {
    if (sel r.err) { ret 0; }
    ret r.ok.int_width;
}

#[testing]
fun t_float_of(r: res[CTValue, comptime_failure.EvalFail]) f64 {
    if (sel r.err) { ret 0.0; }
    ret r.ok.data.f;
}

test apply_arith__int_min_idiv_traps {
    val lhs:          CTValue                                 = t_ct_wide(0, 0x8000000000000000, false);
    val int_value_r2: res[CTValue, comptime_failure.EvalFail] = int_value(0 - 1);
    if (sel int_value_r2.err) { ret 99; }
    val rhs:           CTValue                                 = int_value_r2.ok;
    val apply_arith_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_DIV, lhs, rhs);
    if (sel apply_arith_r.ok) { ret 1; }
    val apply_arith_r2: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MOD, lhs, rhs);
    if (sel apply_arith_r2.ok) { ret 1; }
    val int_value_r3: res[CTValue, comptime_failure.EvalFail] = int_value(10);
    if (sel int_value_r3.err) { ret 99; }
    val ten:          CTValue                                 = int_value_r3.ok;
    val int_value_r4: res[CTValue, comptime_failure.EvalFail] = int_value(2);
    if (sel int_value_r4.err) { ret 99; }
    val two: CTValue                                 = int_value_r4.ok;
    val okd: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_DIV, ten, two);
    if (sel okd.err)        { ret 1; }
    if (okd.ok.data.i != 5) { ret 1; }
    ret 0;
}

test apply_arith__float_mod_truncated {
    val float_value_r: res[CTValue, comptime_failure.EvalFail] = float_value(5.5, float.FLOAT_W_NONE);
    if (sel float_value_r.err) { ret 99; }
    val a:              CTValue                                 = float_value_r.ok;
    val float_value_r2: res[CTValue, comptime_failure.EvalFail] = float_value(3.0, float.FLOAT_W_NONE);
    if (sel float_value_r2.err) { ret 99; }
    val b: CTValue                                 = float_value_r2.ok;
    val r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MOD, a, b);
    if (sel r.err)          { ret 1; }
    if (r.ok.data.f != 2.5) { ret 1; }

    val float_value_r3: res[CTValue, comptime_failure.EvalFail] = float_value(0.0 - 5.5, float.FLOAT_W_NONE);
    if (sel float_value_r3.err) { ret 99; }
    val na: CTValue                                 = float_value_r3.ok;
    val rn: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MOD, na, b);
    if (sel rn.err)                  { ret 1; }
    if (rn.ok.data.f != (0.0 - 2.5)) { ret 1; }

    val float_value_r4: res[CTValue, comptime_failure.EvalFail] = float_value(0.45, float.FLOAT_W_NONE);
    if (sel float_value_r4.err) { ret 99; }
    val s:              CTValue                                 = float_value_r4.ok;
    val float_value_r5: res[CTValue, comptime_failure.EvalFail] = float_value(1.0, float.FLOAT_W_NONE);
    if (sel float_value_r5.err) { ret 99; }
    val one: CTValue                                 = float_value_r5.ok;
    val rs:  res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MOD, s, one);
    if (sel rs.err)           { ret 1; }
    if (rs.ok.data.f != 0.45) { ret 1; }

    val float_value_r6: res[CTValue, comptime_failure.EvalFail] = float_value(0.0, float.FLOAT_W_NONE);
    if (sel float_value_r6.err) { ret 99; }
    val z:             CTValue                                 = float_value_r6.ok;
    val apply_arith_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MOD, a, z);
    if (sel apply_arith_r.ok) { ret 1; }
    ret 0;
}

#[testing]
pub fun t_capability_member(calls: *u32, _eid: ast_id.ExprId) res[opt[CTValue], comptime_failure.EvalFail] {
    @calls = @calls + 1;
    ret res[opt[CTValue], comptime_failure.EvalFail].ok{opt[CTValue].some{ct_u8(1)}};
}

test cast_scalar__width_signedness_and_reinterpretation {
    var a:      A.Allocator;
    val make_1: err[A.Error] = page.make(?a);
    if (sel make_1.err) { ret 1; }
    var types:        type.TypeInterner;
    val init_typed_2: err[fail.Fail] = type.init(?types, ?a);
    if (sel init_typed_2.err) { ret 1; }
    fin { type.dnit(?types); }
    val prim_typed_3: opt[type.TypeId] = type.prim(?types, type.TYPE_U8);
    if (!sel prim_typed_3.some) { ret 1; }
    val u8t:          type.TypeId      = prim_typed_3.some;
    val prim_typed_4: opt[type.TypeId] = type.prim(?types, type.TYPE_I8);
    if (!sel prim_typed_4.some) { ret 1; }
    val i8t:          type.TypeId      = prim_typed_4.some;
    val prim_typed_5: opt[type.TypeId] = type.prim(?types, type.TYPE_U64);
    if (!sel prim_typed_5.some) { ret 1; }
    val u64t:         type.TypeId      = prim_typed_5.some;
    val prim_typed_6: opt[type.TypeId] = type.prim(?types, type.TYPE_I64);
    if (!sel prim_typed_6.some) { ret 1; }
    val i64t:         type.TypeId      = prim_typed_6.some;
    val prim_typed_7: opt[type.TypeId] = type.prim(?types, type.TYPE_F64);
    if (!sel prim_typed_7.some) { ret 1; }
    val f64t:             type.TypeId                             = prim_typed_7.some;
    val make_int_value_r: res[CTValue, comptime_failure.EvalFail] = make_int_value(255, true);
    if (sel make_int_value_r.err) { ret 99; }
    val raw:      CTValue                                 = make_int_value_r.ok;
    val signed_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, raw, u8t, i8t, true);
    if (sel signed_r.err) { ret 2; }
    val signed: CTValue = signed_r.ok;
    if (signed.data.i != -1 || signed.int_unsigned || signed.int_width != 8) { ret 3; }
    val wide_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, signed, i8t, u64t, false);
    if (sel wide_r.err) { ret 4; }
    val wide: CTValue = wide_r.ok;
    if (wide.data.i != -1 || !wide.int_unsigned || wide.int_width != 64) { ret 5; }
    val int_value_r: res[CTValue, comptime_failure.EvalFail] = int_value(300);
    if (sel int_value_r.err) { ret 99; }
    val narrow_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE,
        int_value_r.ok, i64t, u8t, false);
    if (sel narrow_r.err) { ret 6; }
    val narrow: CTValue = narrow_r.ok;
    if (narrow.data.i != 44 || !narrow.int_unsigned || narrow.int_width != 8) { ret 7; }
    val negative_zero: CTValue                                 = ct_float(float.f64_neg(0.0), float.FLOAT_W_64);
    val bits_r:        res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, negative_zero, f64t, u64t, true);
    if (sel bits_r.err) { ret 8; }
    val bits: CTValue = bits_r.ok;
    if (bits.data.i:~u64 != 0x8000000000000000 || !bits.int_unsigned) { ret 9; }
    val back_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, bits, u64t, f64t, true);
    if (sel back_r.err)                              { ret 10; }
    if (back_r.ok.data.f:~u64 != 0x8000000000000000) { ret 11; }
    val cast_scalar_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, raw, u8t, u64t, true);
    if (sel cast_scalar_r.ok) { ret 12; }
    val prim_typed_8: opt[type.TypeId] = type.prim(?types, type.TYPE_PTR);
    if (sel prim_typed_8.none) { ret 1; }
    val ptrt:              type.TypeId                             = prim_typed_8.some;
    val make_int_value_r2: res[CTValue, comptime_failure.EvalFail] = make_int_value(0x3FF0000000000000, true);
    if (sel make_int_value_r2.err) { ret 99; }
    val pointer: CTValue                                 = make_int_value_r2.ok;
    val float_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, pointer, ptrt, f64t, false);
    if (sel float_r.err)          { ret 13; }
    if (float_r.ok.data.f != 1.0) { ret 13; }
    val pointer_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, ct_float(1.0, float.FLOAT_W_64), f64t, ptrt, false);
    if (sel pointer_r.err)                     { ret 14; }
    if (pointer_r.ok.data.i != pointer.data.i) { ret 14; }
    ret 0;
}

#[testing]
pub fun t_bool(r: res[CTValue, comptime_failure.EvalFail]) bool {
    if (sel r.err) { ret false; }
    ret truth(r.ok);
}

test predicates__produce_u8_values {
    val int_value_r: res[CTValue, comptime_failure.EvalFail] = int_value(1);
    if (sel int_value_r.err) { ret 99; }
    val one:          CTValue                                 = int_value_r.ok;
    val int_value_r2: res[CTValue, comptime_failure.EvalFail] = int_value(2);
    if (sel int_value_r2.err) { ret 99; }
    val two:  CTValue                                 = int_value_r2.ok;
    val eq_r: res[CTValue, comptime_failure.EvalFail] = apply_equality(ast_expr.BIN_EQ, one, one);
    val lt_r: res[CTValue, comptime_failure.EvalFail] = apply_compare(ast_expr.BIN_LT, one, two);
    if (sel eq_r.err) { ret 1; }
    if (sel lt_r.err) { ret 1; }
    val eq: CTValue = eq_r.ok;
    val lt: CTValue = lt_r.ok;
    if (!is_u8(eq) || !is_u8(lt))         { ret 1; }
    if (eq.data.i != 1 || lt.data.i != 1) { ret 1; }
    var descriptor: CTValue;
    descriptor.kind = CT_KIND_FIELD;
    for (descriptor.kind <= CT_KIND_CASE) {
        val invalid: res[CTValue, comptime_failure.EvalFail] = apply_equality(ast_expr.BIN_EQ, descriptor, descriptor);
        if (sel invalid.ok)                                          { ret 2; }
        if (invalid.err.kind != comptime_failure.EVAL_FAIL_REJECTED) { ret 2; }
        descriptor.kind = descriptor.kind + 1;
    }
    ret 0;
}

test apply_equality__cross_sign_magnitude {
    val int_value_r: res[CTValue, comptime_failure.EvalFail] = int_value(5);
    if (sel int_value_r.err) { ret 99; }
    val s5:               CTValue                                 = int_value_r.ok;
    val make_int_value_r: res[CTValue, comptime_failure.EvalFail] = make_int_value(5, true);
    if (sel make_int_value_r.err) { ret 99; }
    val u5: CTValue = make_int_value_r.ok;
    if (!t_bool(apply_equality(ast_expr.BIN_EQ, s5, u5))) { ret 1; }
    if (t_bool(apply_compare(ast_expr.BIN_LT, s5, u5)))   { ret 1; }
    ret 0;
}

test apply_equality__type_identity {
    val type_value_r: res[CTValue, comptime_failure.EvalFail] = type_value(7);
    if (sel type_value_r.err) { ret 99; }
    val a:             CTValue                                 = type_value_r.ok;
    val type_value_r2: res[CTValue, comptime_failure.EvalFail] = type_value(7);
    if (sel type_value_r2.err) { ret 99; }
    val b:             CTValue                                 = type_value_r2.ok;
    val type_value_r3: res[CTValue, comptime_failure.EvalFail] = type_value(9);
    if (sel type_value_r3.err) { ret 99; }
    val c: CTValue = type_value_r3.ok;
    if (!t_bool(apply_equality(ast_expr.BIN_EQ, a, b)))  { ret 1; }
    if (t_bool(apply_equality(ast_expr.BIN_EQ, a, c)))   { ret 1; }
    if (!t_bool(apply_equality(ast_expr.BIN_NEQ, a, c))) { ret 1; }
    val int_value_r: res[CTValue, comptime_failure.EvalFail] = int_value(7);
    if (sel int_value_r.err) { ret 99; }
    val i:                CTValue                                 = int_value_r.ok;
    val apply_equality_r: res[CTValue, comptime_failure.EvalFail] = apply_equality(ast_expr.BIN_EQ, a, i);
    if (sel apply_equality_r.ok) { ret 1; }
    ret 0;
}

# every operator carries across the limb boundary and rejects only at 2^128 or
# the i128 extremes
test apply_arith__128_bit_operators {
    val two64: CTValue = t_ct_wide(0, 1, false);
    val one:   CTValue = t_ct_wide(1, 0, false);
    val three: CTValue = t_ct_wide(3, 0, false);
    val neg1:  CTValue = t_ct_wide(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, false);
    val smax:  CTValue = t_ct_wide(0xFFFFFFFFFFFFFFFF, 0x7FFFFFFFFFFFFFFF, false);
    val smin:  CTValue = t_ct_wide(0, 0x8000000000000000, false);
    val umax:  CTValue = t_ct_wide(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, true);

    val sub_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SUB, two64, one);
    if (!t_ok_is(sub_r, 0xFFFFFFFFFFFFFFFF, 0, false)) { ret 1; }
    val mul_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MUL, two64, three);
    if (!t_ok_is(mul_r, 0, 3, false)) { ret 2; }
    val mul_neg: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MUL, two64, neg1);
    if (!t_ok_is(mul_neg, 0, 0xFFFFFFFFFFFFFFFF, false)) { ret 3; }
    if (!ct_is_negative(t_val(mul_neg)))                 { ret 4; }
    val mul_over: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MUL, smax, three);
    if (sel mul_over.ok) { ret 5; }
    val div_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_DIV, t_val(mul_r), three);
    if (!t_ok_is(div_r, 0, 1, false)) { ret 6; }
    val big_seven: CTValue                                 = t_ct_wide(7, 5, false);
    val mod_r:     res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MOD, big_seven, two64);
    if (!t_ok_is(mod_r, 7, 0, false)) { ret 7; }
    val neg_div: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_DIV, t_val(mul_neg), three);
    if (!t_ok_is(neg_div, 0xAAAAAAAAAAAAAAAB, 0xFFFFFFFFFFFFFFFF, false)) { ret 8; }
    val add_over: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_ADD, smax, one);
    if (sel add_over.ok) { ret 9; }
    val sub_over: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SUB, smin, one);
    if (sel sub_over.ok) { ret 10; }
    val udiv: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_DIV, umax, two64);
    if (!t_ok_is(udiv, 0xFFFFFFFFFFFFFFFF, 0, true)) { ret 11; }
    val umod: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MOD, umax, two64);
    if (!t_ok_is(umod, 0xFFFFFFFFFFFFFFFF, 0, true)) { ret 12; }
    val umul_over: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_MUL, umax, t_ct_wide(2, 0, true));
    if (sel umul_over.ok) { ret 13; }
    val usub_under: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SUB, t_ct_wide(0, 1, true), umax);
    if (sel usub_under.ok) { ret 14; }
    val and_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_BIT_AND, umax, two64);
    if (!t_ok_is(and_r, 0, 1, true)) { ret 15; }
    val xor_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_BIT_XOR, umax, t_ct_wide(0xF, 0xF, true));
    if (!t_ok_is(xor_r, 0xFFFFFFFFFFFFFFF0, 0xFFFFFFFFFFFFFFF0, true)) { ret 16; }
    val or_r: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_BIT_OR, two64, three);
    if (!t_ok_is(or_r, 3, 1, false)) { ret 17; }
    ret 0;
}

test apply_compare__128_bit_orders {
    val two64: CTValue = t_ct_wide(0, 1, false);
    val big:   CTValue = t_ct_wide(0xFFFFFFFFFFFFFFFF, 0, false);
    val neg:   CTValue = t_ct_wide(0, 0xFFFFFFFFFFFFFFFF, false);
    val umax:  CTValue = t_ct_wide(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, true);
    val smin:  CTValue = t_ct_wide(0, 0x8000000000000000, false);
    if (!t_bool(apply_compare(ast_expr.BIN_LT, big, two64)))                                 { ret 1; }
    if (!t_bool(apply_compare(ast_expr.BIN_LT, neg, big)))                                   { ret 2; }
    if (!t_bool(apply_compare(ast_expr.BIN_GT, umax, two64)))                                { ret 3; }
    if (!t_bool(apply_compare(ast_expr.BIN_LT, neg, umax)))                                  { ret 4; }
    if (!t_bool(apply_compare(ast_expr.BIN_LT, smin, neg)))                                  { ret 5; }
    if (!t_bool(apply_compare(ast_expr.BIN_EQ, two64, t_ct_wide(0, 1, true))))               { ret 6; }
    if (t_bool(apply_compare(ast_expr.BIN_EQ, neg, t_ct_wide(0, 0xFFFFFFFFFFFFFFFF, true)))) { ret 7; }
    ret 0;
}

# shifts cross the limb at 64, reach 127 and stop at 128
test apply_int_shift__limb_crossing_and_bounds {
    val one:   CTValue                                 = t_ct_wide(1, 0, false);
    val sh64:  CTValue                                 = t_ct_wide(64, 0, false);
    val sh100: CTValue                                 = t_ct_wide(100, 0, false);
    val sh128: CTValue                                 = t_ct_wide(128, 0, false);
    val shl64: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHL, one, sh64);
    if (!t_ok_is(shl64, 0, 1, false)) { ret 1; }
    val shl100: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHL, one, sh100);
    if (!t_ok_is(shl100, 0, 1::u64 << 36, false)) { ret 2; }
    val back: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHR, t_val(shl100), sh100);
    if (!t_ok_is(back, 1, 0, false)) { ret 3; }
    val too_far: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHL, one, sh128);
    if (sel too_far.ok)                                                                  { ret 4; }
    if (!str_equals(too_far.err.message, "comptime shift amount must be less than 128")) { ret 5; }
    val huge_amt: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHR, one, t_ct_wide(0, 1, false));
    if (sel huge_amt.ok) { ret 6; }
    val neg: CTValue                                 = t_ct_wide(0, 0x8000000000000000, false);
    val sar: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHR, neg, sh100);
    if (!t_ok_is(sar, 0xFFFFFFFFF8000000, 0xFFFFFFFFFFFFFFFF, false)) { ret 7; }
    val umax: CTValue                                 = t_ct_wide(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, true);
    val lsr:  res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHR, umax, sh64);
    if (!t_ok_is(lsr, 0xFFFFFFFFFFFFFFFF, 0, true)) { ret 8; }
    val drop: res[CTValue, comptime_failure.EvalFail] = apply_arith(ast_expr.BIN_SHL, t_ct_wide(0, 2, false), t_ct_wide(63, 0, false));
    if (sel drop.ok) { ret 9; }
    ret 0;
}

# casts between 64 and 128 bits: truncation drops the high limb, sign
# extension fills it, and a 128-bit reinterpret keeps every bit
test cast_scalar__between_64_and_128_bits {
    var a:      A.Allocator;
    val make_1: err[A.Error] = page.make(?a);
    if (sel make_1.err) { ret 1; }
    var types:  type.TypeInterner;
    val init_r: err[fail.Fail] = type.init(?types, ?a);
    if (sel init_r.err) { ret 1; }
    fin { type.dnit(?types); }
    val u128_o: opt[type.TypeId] = type.prim(?types, type.TYPE_U128);
    val i128_o: opt[type.TypeId] = type.prim(?types, type.TYPE_I128);
    val u64_o:  opt[type.TypeId] = type.prim(?types, type.TYPE_U64);
    val i64_o:  opt[type.TypeId] = type.prim(?types, type.TYPE_I64);
    val f64_o:  opt[type.TypeId] = type.prim(?types, type.TYPE_F64);
    if (!sel u128_o.some) { ret 1; }
    if (!sel i128_o.some) { ret 1; }
    if (!sel u64_o.some)  { ret 1; }
    if (!sel i64_o.some)  { ret 1; }
    if (!sel f64_o.some)  { ret 1; }
    val u128t: type.TypeId = u128_o.some;
    val i128t: type.TypeId = i128_o.some;
    val u64t:  type.TypeId = u64_o.some;
    val i64t:  type.TypeId = i64_o.some;
    val f64t:  type.TypeId = f64_o.some;

    val neg1_r: res[CTValue, comptime_failure.EvalFail] = int_value(0 - 1);
    if (sel neg1_r.err) { ret 99; }
    val neg1:   CTValue                                 = neg1_r.ok;
    val sext_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, neg1, i64t, i128t, false);
    if (sel sext_r.err)                                                                                { ret 2; }
    if (!t_is(sext_r.ok, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, false) || sext_r.ok.int_width != 128) { ret 3; }
    val to_u128: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, neg1, i64t, u128t, false);
    if (!t_ok_is(to_u128, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, true)) { ret 4; }
    val u64_max: CTValue                                 = t_ct_wide(0xFFFFFFFFFFFFFFFF, 0, true);
    val zext_r:  res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, u64_max, u64t, i128t, false);
    if (!t_ok_is(zext_r, 0xFFFFFFFFFFFFFFFF, 0, false)) { ret 5; }
    val wide_v:  CTValue                                 = t_ct_wide(0x0FEDCBA987654321, 0x123456789ABCDEF0, true);
    val trunc_r: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, wide_v, u128t, u64t, false);
    if (!t_ok_is(trunc_r, 0x0FEDCBA987654321, 0, true) || t_width(trunc_r) != 64) { ret 6; }
    val to_i64: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, t_ct_wide(0x8000000000000000, 7, true), u128t, i64t, false);
    if (!t_ok_is(to_i64, 0x8000000000000000, 0xFFFFFFFFFFFFFFFF, false)) { ret 7; }
    val reinterp: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, t_ct_wide(5, 0x8000000000000000, true), u128t, i128t, true);
    if (!t_ok_is(reinterp, 5, 0x8000000000000000, false) || !ct_is_negative(t_val(reinterp))) { ret 8; }
    val narrow_reinterp: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, wide_v, u128t, u64t, true);
    if (sel narrow_reinterp.ok) { ret 9; }
    val to_f: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, t_ct_wide(0, 1, true), u128t, f64t, false);
    if (t_float_of(to_f) != 18446744073709551616.0) { ret 10; }
    val neg_f: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, t_ct_wide(0, 0xFFFFFFFFFFFFFFFF, false), i128t, f64t, false);
    if (t_float_of(neg_f) != -18446744073709551616.0) { ret 11; }
    val from_f: res[CTValue, comptime_failure.EvalFail] = cast_scalar(?types, 8, float.NAN_PRESERVE, ct_float(18446744073709551616.0, float.FLOAT_W_64), f64t, u128t, false);
    if (!t_ok_is(from_f, 0, 1, true)) { ret 12; }
    ret 0;
}

test ct_int_u64__reads_only_what_fits {
    val small: opt[u64] = ct_int_u64(t_ct_wide(7, 0, false));
    if (!(sel small.some && small.some == 7)) { ret 1; }
    val top: opt[u64] = ct_int_u64(t_ct_wide(0xFFFFFFFFFFFFFFFF, 0, true));
    if (!(sel top.some && top.some == 0xFFFFFFFFFFFFFFFF)) { ret 2; }
    val wide_hi: opt[u64] = ct_int_u64(t_ct_wide(0, 1, false));
    if (sel wide_hi.some) { ret 3; }
    val negative: opt[u64] = ct_int_u64(t_ct_wide(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, false));
    if (sel negative.some) { ret 4; }
    val unsigned_top: opt[u64] = ct_int_u64(t_ct_wide(0xFFFFFFFFFFFFFFFF, 0, false));
    if (!sel unsigned_top.some) { ret 5; }
    var digits: [wide.FORMAT_CAP]u8;
    if (!str_equals(ct_int_text(t_ct_wide(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, false), ?digits[0]), "-1")) { ret 6; }
    if (!str_equals(ct_int_text(t_ct_wide(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, true), ?digits[0]),
        "340282366920938463463374607431768211455")) { ret 7; }
    ret 0;
}

#[testing]
pub fun t_str_id(r: res[CTValue, comptime_failure.EvalFail]) intern.StrId {
    if (sel r.err) { ret intern.STR_NIL; }
    val v: CTValue = r.ok;
    if (v.kind != CT_KIND_STR) { ret intern.STR_NIL; }
    ret v.data.s;
}

test float_trunc_rem__exact_at_the_real_2_53_boundary {
    if (float.f64_bits(float_trunc_rem(9007199254740984.0, 7.0, float.FLOAT_W_64)) != 0x4008000000000000) { ret 1; }
    if (float.f64_bits(float_trunc_rem(9007199254740996.0, 7.0, float.FLOAT_W_64)) != 0x3FF0000000000000) { ret 2; }
    if (float.f64_bits(float_trunc_rem(1.0e300, 3.0, float.FLOAT_W_64)) != 0x0000000000000000)            { ret 3; }
    if (float.f64_bits(float_trunc_rem(1.0e300, 7.0, float.FLOAT_W_64)) != 0x3FF0000000000000)            { ret 4; }
    if (float.f64_bits(float_trunc_rem(0.0 - 1.0e300, 7.0, float.FLOAT_W_64)) != 0xBFF0000000000000)      { ret 5; }
    if (float_trunc_rem(7.5, 2.0, float.FLOAT_W_64) != 1.5)                                               { ret 6; }
    if (float_trunc_rem(0.0 - 7.5, 2.0, float.FLOAT_W_64) != -1.5)                                        { ret 7; }
    if (float_trunc_rem(2.0, 5.0, float.FLOAT_W_64) != 2.0)                                               { ret 8; }

    # a zero divisor and an infinite dividend are NaN at every width, as at run time
    val inf: f64 = float.bits_f64(0x7FF0000000000000);
    if (!t_rem_nan(1.0, 0.0))                    { ret 9; }
    if (!t_rem_nan(inf, 3.0))                    { ret 10; }
    if (!t_rem_nan(float.f64_neg(inf), 3.0))     { ret 11; }
    if (!t_rem_nan(inf, float.f64_neg(1.0e300))) { ret 12; }

    # a finite dividend over an infinite divisor is the dividend, signed zero included
    if (!t_rem_is(5.5, inf, 5.5))                                              { ret 13; }
    if (!t_rem_is(float.f64_neg(5.5), float.f64_neg(inf), float.f64_neg(5.5))) { ret 14; }
    if (!t_rem_is(float.f64_neg(0.0), inf, float.f64_neg(0.0)))                { ret 15; }
    if (!t_rem_nan(inf, inf))                                                  { ret 16; }
    ret 0;
}

#[testing]
fun t_rem_is(a: f64, b: f64, want: f64) bool {
    val bits: u64 = float.f64_bits(want);
    ret float.f64_bits(float_trunc_rem(a, b, float.FLOAT_W_64)) == bits && float.f64_bits(float_trunc_rem(a, b, float.FLOAT_W_32)) == bits;
}

#[testing]
fun t_rem_nan(a: f64, b: f64) bool {
    val r64: f64 = float_trunc_rem(a, b, float.FLOAT_W_64);
    val r32: f64 = float_trunc_rem(a, b, float.FLOAT_W_32);
    ret r64 != r64 && r32 != r32;
}

#[testing]
pub fun t_capability_refusing(a: *A.Allocator, _eid: ast_id.ExprId) res[opt[CTValue], comptime_failure.EvalFail] {
    val r: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel r.err) {
        ret res[opt[CTValue], comptime_failure.EvalFail].err{comptime_failure.eval_internal(lang_alloc.text(r.err))};
    }
    A.deallocate[u8](a, r.ok, 1);
    ret res[opt[CTValue], comptime_failure.EvalFail].ok{opt[CTValue].some{ct_u8(1)}};
}

#[testing]
pub fun t_internal_catalog(result: res[CTValue, comptime_failure.EvalFail], message: str) bool {
    if (sel result.ok) { ret false; }
    val failure: comptime_failure.EvalFail = result.err;
    ret failure.kind == comptime_failure.EVAL_FAIL_INTERNAL && str_equals(failure.message, message);
}
