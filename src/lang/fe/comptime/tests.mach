# `$mach.build.*` has no manifest-defined members: a name outside the
# known set is refused at the use site as an unknown path, and a known member
# on the line before it still resolves
test mach_build__unknown_member_is_refused_at_the_use_site {
    val src: str = "val w: u64 = $mach.build.pointer_width;\nval n: u64 = $mach.build.nosuch;\nfun main() i32 { ret 0; }\n";
    if (!ut_sema_rejects_at(src, "unknown `$mach.*` path", 53, 18))                             { ret 1; }
    if (!ut_sema_clean("val w: u64 = $mach.build.pointer_width;\nfun main() i32 { ret 0; }\n")) { ret 2; }
    ret 0;
}

test comptime_gate__reads_a_float_at_its_width {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val K: f32 = 16777217.0;\n$if (K - 16777216.0 == 0.0) { val G: i64 = 1; }\n$or { val G: i64 = 0; }\nval K64: f64 = 16777217.0;\n$if (K64 - 16777216.0 == 0.0) { val G64: i64 = 1; }\n$or { val G64: i64 = 0; }\nval P: f32 = 0.1;\n$if (P > 0.1) { val GT: i64 = 1; }\n$or { val GT: i64 = 0; }\nval P64: f64 = 0.1;\n$if (P64 > 0.1) { val GT64: i64 = 1; }\n$or { val GT64: i64 = 0; }\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, fail.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad: i32           = 0;
    val m:   *me_ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        val gg: i64 = ut_global_ix(?s, m, "uniontest.main.G");
        if (gg < 0) { bad = 1; }
        or {
            if ((?m.globals[gg::u32]).init.data.int_lit != 1) { bad = 1; }
        }

        val gg64: i64 = ut_global_ix(?s, m, "uniontest.main.G64");
        if (gg64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gg64::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt: i64 = ut_global_ix(?s, m, "uniontest.main.GT");
        if (gt < 0) { bad = 1; }
        or {
            if ((?m.globals[gt::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt64: i64 = ut_global_ix(?s, m, "uniontest.main.GT64");
        if (gt64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gt64::u32]).init.data.int_lit != 0) { bad = 1; }
        }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test comptime_gate__cast_resolves_local_and_imported_aliases {
    ret ut_single_ok2(
        "use Flag: uniontest.lib.Flag;\ndef Local: u8;\n$if ((1::Local) == 1u8) { fun local_selected() i32 { ret 1; } } $or { use uniontest.missing; }\n$if ((0::Flag) == 1u8) { use uniontest.missing; } $or { fun imported_selected() i32 { ret 2; } }\nfun main() i32 { ret local_selected() + imported_selected(); }\n",
        "pub def Flag: u8;\n");
}

#[testing]
fun t_single_diag(src: str, needle: str) i32 {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    ret ut_single_result_n(?names[0], ?texts[0], 1, needle, true);
}

#[testing]
fun t_single_diag2(main: str, lib: str, needle: str) i32 {
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;
    ret ut_single_result_n(?names[0], ?texts[0], 2, needle, true);
}

test layout_intrinsic__in_a_comptime_gate {
    var bad: i32 = 0;

    if (ut_arm("rec A { x: u64; y: u64; }\nrec B { p: u64; q: u64; }\nfun main() i32 { $if ($size_of(A) == $size_of(B)) { $error(\"SAME\"); } $or { $error(\"DIFF\"); } ret 0; }\n", "SAME", "DIFF") != 0)         { bad = 1; }
    if (ut_arm("rec A { x: u64; y: u64; }\nrec C { z: u64; w: u64; v: u64; }\nfun main() i32 { $if ($size_of(A) == $size_of(C)) { $error(\"SAME\"); } $or { $error(\"DIFF\"); } ret 0; }\n", "DIFF", "SAME") != 0) { bad = 1; }

    if (ut_arm("rec C { z: u64; w: u64; v: u64; }\nfun main() i32 { $if ($size_of(C) == 24) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_arm("rec C { z: u64; w: u64; v: u64; }\nfun main() i32 { $if ($align_of(C) == 8) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    ret bad;
}

test length_of__in_a_comptime_gate {
    var bad: i32 = 0;

    if (ut_arm("$if ($length_of([3]i64) == 3) { $error(\"Y\"); } $or { $error(\"N\"); }\nfun main() i32 { ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("$if ($length_of([3]i64) == 4) { $error(\"N\"); } $or { $error(\"Y\"); }\nfun main() i32 { ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_lower_ok("$if ($length_of([3]i64) != 3) { $error(\"BAD\"); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n") != 0) { bad = 1; }

    if (ut_lower_rejects("fun f(a: ^u32, b: ^u32) ^u32 { $if ($length_of([3]i64) == 3) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n",
        "not declared `#[oblivious]`") != 0) { bad = 1; }
    if (ut_lower_ok("fun f(a: ^u32, b: ^u32) ^u32 { $if ($length_of([3]i64) == 4) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n") != 0) { bad = 1; }

    if (ut_lower_rejects("fun f(a: ^u32, b: ^u32) ^u32 { $if ($size_of([3]i64) == 24) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n",
        "not declared `#[oblivious]`") != 0) { bad = 1; }
    if (ut_lower_ok("fun f(a: ^u32, b: ^u32) ^u32 { $if ($size_of([3]i64) == 0) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n") != 0) { bad = 1; }

    ret bad;
}

test layout_intrinsic__refused_where_not_yet_evaluable {
    var bad: i32 = 0;

    if (ut_vec_diag("rec Pair { a: u64; b: u64; }\n$if ($size_of(Pair) == 16) {\n    fun helper() i32 { ret 1; }\n}\nfun main() i32 { ret 0; }\n",
        "`$size_of` asks a type question, which is only comptime-evaluable after type checking") != 0) { bad = 1; }

    # a declaring gate is refused for every type question, asked directly or through the constants it reads
    val pair:  str    = "rec Pair { a: u64; b: u64; }\nval A: [4]u8 = [4]u8{1, 2, 3, 4};\nval X: u32 = 1;\n";
    var gates: [5]str = [5]str{"$align_of(Pair) == 8", "$type_of(X) == u32", "$is_record(Pair)", "$length_of(A) == 4", "$size_of(Pair) == 16"};
    var vals:  [5]str = [5]str{"val Q: u64 = $align_of(Pair);\n", "val Q: u8 = $type_of(X) == u32;\n", "val Q: u8 = $is_record(Pair);\n",
        "val Q: u64 = $length_of(A);\n", "val Q: u64 = $size_of(Pair);\n"};
    var asks: [5]str = [5]str{"`$align_of` asks a type question", "`$type_of` asks a type question", "`$is_record` asks a type question",
        "`$length_of` asks a type question", "`$size_of` asks a type question"};
    var alloc: A.Allocator;
    page.make(?alloc);
    var qi: u32 = 0;
    for (qi < 5) {
        val direct: str = ut_cc3(?alloc, pair, ut_cc3(?alloc, "$if (", gates[qi], ") {\n    fun helper() i32 { ret 1; }\n}\n"), "fun main() i32 { ret 0; }\n");
        if (ut_vec_diag(direct, ut_cc3(?alloc, asks[qi], ", which is only comptime-evaluable after type checking", "")) != 0) { bad = 10 + qi::i32; }
        val through: str = ut_cc3(?alloc, pair, vals[qi], "val R: u64 = Q;\n$if (R == 1) {\n    fun helper() i32 { ret 1; }\n}\nfun main() i32 { ret 0; }\n");
        if (ut_vec_diag(through, ut_cc3(?alloc, asks[qi], " through `R` -> `Q`, which is only comptime-evaluable", "")) != 0) { bad = 20 + qi::i32; }
        qi = qi + 1;
    }

    if (ut_vec_diag("fun sz() u64 { ret 16; }\nfun main() i32 { var a: [sz()]u8; ret a[0]::i32; }\n",
        "array length is not a comptime constant") != 0) { bad = 1; }

    ret bad;
}

test comptime_condition__exact_u8_truth {
    var bad: i32 = 0;
    if (ut_arm("val C: u8 = 0;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "FALSE", "TRUE") != 0)                { bad = 1; }
    if (ut_arm("val C: u8 = 1;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "TRUE", "FALSE") != 0)                { bad = 2; }
    if (ut_arm("val C: u8 = 2;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "FALSE", "TRUE") != 0)                { bad = 3; }
    if (t_single_diag("def Flag: u8;\nval C: Flag = 1;\nfun main() i32 { $if (C) { $error(\"TRUE\"); } $or { $error(\"FALSE\"); } ret 0; }\n", "TRUE") != 0) { bad = 4; }
    if (!ut_sema_rejects_with("val C: u16 = 1;\nfun main() i32 { $if (C) { ret 1; } $or { ret 0; } }\n", "condition must have type u8"))                     { bad = 5; }
    if (!ut_sema_rejects_with("val C: i8 = 1;\nfun main() i32 { $if (C) { ret 1; } $or { ret 0; } }\n", "condition must have type u8"))                      { bad = 6; }
    if (t_single_diag("def Word: u16;\nval C: Word = 1;\nfun main() i32 { $if (C) { ret 1; } $or { ret 0; } }\n", "condition must have type u8") != 0)       { bad = 7; }
    if (!ut_sema_rejects_with("fun main() i32 { $if (1) { ret 1; } $or { ret 0; } }\n", "condition must have type u8"))                                      { bad = 8; }
    if (!ut_sema_rejects_with("fun none() {}\nfun main() i32 { $if (none()) { ret 1; } $or { ret 0; } }\n", "condition must have type u8"))                  { bad = 9; }
    if (ut_vec_diag("$if (!0) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand") != 0)                               { bad = 10; }
    if (ut_arm("$if (!0) { #[embed(\"missing.bin\")] val A: [_]u8; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand", "cannot read") != 0)    { bad = 11; }
    if (ut_vec_diag("val C: u8 = 1;\n$if (C && 1) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands") != 0)   { bad = 12; }
    val sc_import: str = "val C: u8 = 0;\n$if (C || 1) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(sc_import, "logical operator requires u8 operands") != 0)                                                                                                      { ret 131; }
    if (ut_vec_diag(sc_import, "no project or dep matches") == 0)                                                                                                                  { ret 132; }
    if (ut_arm("val C: u8 = 0;\n$if (C && 1) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands", "no project or dep matches") != 0) { bad = 14; }
    val sc_embed: str = "val C: u8 = 1;\n$if (C || 1) { #[embed(\"missing.bin\")] val A: [_]u8; }\nfun main() i32 { ret 0; }\n";
    if (ut_vec_diag(sc_embed, "logical operator requires u8 operands") != 0)                                                                                                                  { ret 151; }
    if (ut_vec_diag(sc_embed, "cannot read") == 0)                                                                                                                                            { ret 152; }
    if (ut_arm("val C: u8 = 0;\n$if ((C && 1) || C) { #[library(\"missing\")] ext fun probe(); }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands", "cannot read") != 0) { ret 16; }
    if (ut_single_ok("val C: u8 = 0;\nval Z: u8 = 0;\n$if (C && (1 / Z)) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n") != 0)                                                      { bad = 21; }
    if (ut_single_ok("val C: u8 = 1;\nval Z: u8 = 0;\n$if (C || (1 / Z)) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n") != 0)                                              { bad = 22; }
    ret bad;
}

test comptime_condition__resolves_through_aliases {
    if (ut_single_ok("def Flag: u8;\nval C: Flag = 1;\n$if (C) { fun selected() i32 { ret 7; } }\nfun main() i32 { ret selected(); }\n") != 0)                                                              { ret 1; }
    if (ut_single_ok("def Flag: u8;\nval C: Flag = 2;\n$if (C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n") != 0)                                                                              { ret 2; }
    if (t_single_diag("def Word: u16;\nval C: Word = 1;\n$if (C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "condition must have type u8") != 0)                                             { ret 3; }
    if (t_single_diag("def Word: u16;\nval C: Word = 2;\n$if (C) { } $or { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "condition must have type u8") != 0)                                     { ret 4; }
    if (ut_single_ok("def Flag: u8;\nval OUTER: Flag = 1;\n$if (OUTER) { def Inner: u8; val INNER: Inner = 1; $if (INNER) { fun selected() i32 { ret 9; } } }\nfun main() i32 { ret selected(); }\n") != 0) { ret 5; }
    if (ut_single_ok2("use uniontest.lib;\n$if (lib.YES) { fun selected() i32 { ret 1; } }\nfun main() i32 { ret selected(); }\n", "pub def Flag: u8;\npub val YES: Flag = 1;\n") != 0)                     { ret 6; }
    if (t_single_diag2("use uniontest.lib;\n$if (lib.BAD) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "pub def Word: u16;\npub val BAD: Word = 1;\n", "condition must have type u8") != 0)    { ret 7; }
    if (ut_single_ok2("use uniontest.lib.true;\n$if (true) { fun selected() i32 { ret 2; } }\nfun main() i32 { ret selected(); }\n", "pub def bool: u8;\npub val true: bool = 1;\n") != 0)                  { ret 8; }
    if (ut_single_ok2("use uniontest.lib.false;\n$if (false) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "pub def bool: u8;\npub val false: bool = 0;\n") != 0)                               { ret 9; }
    if (ut_single_ok2("def Flag: u8;\nval C: Flag = 1;\n$if (C) { use uniontest.lib; }\nfun main() i32 { ret lib.selected(); }\n", "pub fun selected() i32 { ret 17; }\n") != 0)                            { ret 10; }
    var names: [3]str;
    names[0] = "main.mach";
    names[1] = "mid.mach";
    names[2] = "base.mach";
    var texts: [3]str;
    texts[0] = "use uniontest.mid;\n$if (mid.ENABLED) { fun selected() i32 { ret 19; } }\nfun main() i32 { ret selected(); }\n";
    texts[1] = "use uniontest.base;\n$if (base.ENABLE) { pub def Flag: u8; pub val ENABLED: Flag = 1; }\n";
    texts[2] = "pub def Flag: u8;\npub val ENABLE: Flag = 1;\n";
    if (ut_single_result_n(?names[0], ?texts[0], 3, "", false) != 0)                                                                                                           { ret 1; }
    if (t_single_diag("def Word: u16;\nval C: Word = 1;\n$if (!C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "unary ! requires a u8 operand") != 0)             { ret 12; }
    if (t_single_diag("def Word: u16;\nval C: Word = 1;\n$if (C && C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands") != 0) { ret 2; }
    if (t_single_diag("def Word: u16;\nval C: Word = 1;\n$if (C || C) { use uniontest.missing; }\nfun main() i32 { ret 0; }\n", "logical operator requires u8 operands") != 0) { ret 3; }
    ret 0;
}

test type_predicate__decided_per_instance {
    var bad: i32 = 0;

    if (ut_layout_ok("rec P { a: u64; }\nfun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret probe[P](); }\n") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { a: u64; }\nfun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret probe[P]() + probe[u64](); }\n", "T must be a record") != 0) { bad = 1; }

    if (ut_layout_ok("fun probe[T]() i32 { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } ret 0; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }

    if (ut_layout_ok("rec P { a: u64; }\nfun probe[T]() i32 { fin { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } } ret 0; }\nfun main() i32 { ret probe[P](); }\n") != 0) { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { fin { $if ($is_record(T)) { } $or { $error(\"T must be a record\"); } } ret 0; }\nfun main() i32 { ret probe[u64](); }\n",
        "T must be a record") != 0) { bad = 1; }

    if (ut_layout_ok("fun probe[T]() i32 { val n: *u8 = $type_name(T); ret 0; }\nfun main() i32 { ret probe[u64](); }\n") != 0)                                     { bad = 1; }
    if (ut_layout_ok("fun probe[T]() i32 { $if ($type_name(T) == \"u64\") { } $or { $error(\"not u64\"); } ret 0; }\nfun main() i32 { ret probe[u64](); }\n") != 0) { bad = 1; }
    if (ut_vec_diag("fun probe[T]() i32 { $if ($type_name(T) == \"u64\") { } $or { $error(\"not u64\"); } ret 0; }\nfun main() i32 { ret probe[i32](); }\n",
        "not u64") != 0) { bad = 1; }

    ret bad;
}

test type_predicate__answers {
    var bad: i32 = 0;

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)           { bad = 1; }
    if (ut_arm("uni U { a: u64; b: u32; }\nfun main() i32 { $if ($is_record(U)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)   { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_record(u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                            { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(*P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)          { bad = 1; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($is_record(Box[i64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_arm("uni U { a: u64; b: u32; }\nfun main() i32 { $if ($is_union(U)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)           { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_union(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                   { bad = 1; }
    if (ut_arm("uni Box[T] { v: T; w: u32; }\nfun main() i32 { $if ($is_union(Box[i64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_pointer(*P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_pointer(ptr)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                   { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_pointer(P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)  { bad = 1; }

    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_record(^P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)           { bad = 1; }
    if (ut_arm("rec P { a: u64; }\nfun main() i32 { $if ($is_pointer(^*P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)         { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($is_pointer(*^u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                           { bad = 1; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($is_record(Box[^u64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_vec_diag("rec P { a: u64; }\nfun main() i32 { val b: u8 = $is_record(P); ret 0; }\n",
        "comptime type predicate is comptime-only") != 0) { bad = 1; }
    if (ut_vec_diag("rec P { a: u64; }\nfun main() i32 { $if ($is_record(P, P)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n",
        "expected 1 argument") != 0) { bad = 1; }

    ret bad;
}

test type_name__spellings {
    var bad: i32 = 0;

    if (ut_arm("rec Pair { a: u64; }\nfun main() i32 { $if ($type_name(Pair) == \"Pair\") { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)   { bad = 1; }
    if (ut_arm("rec Pair { a: u64; }\nfun main() i32 { $if ($type_name(*Pair) == \"*Pair\") { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("rec Pair { a: u64; }\nfun main() i32 { $if ($type_name(^Pair) == \"^Pair\") { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (ut_arm("fun main() i32 { $if ($type_name(*^u8) == \"*^u8\") { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                         { bad = 1; }
    if (ut_layout_ok("rec Pair { a: u64; }\nfun main() i32 { val n: *u8 = $type_name(Pair); ret 0; }\n") != 0)                                                     { bad = 1; }

    ret bad;
}

test type_id__identity {
    var bad: i32 = 0;

    if (ut_arm("rec Pair { a: u64; }\nfun main() i32 { $if ($type_id(Pair) == $type_id(Pair)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)                    { bad = 1; }
    if (ut_arm("rec Pair { a: u64; }\ndef Other: Pair;\nfun main() i32 { $if ($type_id(Other) == $type_id(Pair)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { bad = 2; }
    if (ut_arm("rec Pair { a: u64; }\nfun main() i32 { $if ($type_id(^Pair) == $type_id(Pair)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                   { bad = 3; }
    if (ut_arm("fun main() i32 { $if ($type_id(^u64) == $type_id(u64)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                                           { bad = 4; }
    if (ut_arm("rec Pair { a: u64; }\nfun main() i32 { $if ($type_id(*Pair) == $type_id(Pair)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                   { bad = 5; }
    if (ut_arm("fun main() i32 { $if ($type_id([4]u8) == $type_id([5]u8)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)                                        { bad = 6; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($type_id(Box[u64]) == $type_id(Box[u32])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "N", "Y") != 0)            { bad = 7; }
    if (ut_arm("rec Box[T] { v: T; }\nfun main() i32 { $if ($type_id(Box[u64]) == $type_id(Box[u64])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0)            { bad = 8; }

    if (ut_arm("rec Pair { a: u64; }\nrec Box[T] { v: T; }\nfun probe[T]() i32 { $if ($type_id(T) == $type_id(Box[Pair])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\nfun main() i32 { ret probe[Box[Pair]](); }\n", "Y", "N") != 0) { bad = 9; }
    if (ut_arm("rec Pair { a: u64; }\nrec Box[T] { v: T; }\nfun probe[T]() i32 { $if ($type_id(T) == $type_id(Box[Pair])) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\nfun main() i32 { ret probe[Box[u64]](); }\n", "N", "Y") != 0)  { bad = 10; }

    val lib: str = "pub rec Pair { a: u64; }\npub rec Box[T] { v: T; }\npub fun box_gate[T]() i32 { $if ($type_id(T) == $type_id(Box[Pair])) { $error(\"LIB_Y\"); } ret 0; }\n";
    if (t_arm2("use uniontest.lib;\nrec Pair { a: u64; }\nfun main() i32 { $if ($type_id(Pair) == $type_id(lib.Pair)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", lib, "N", "Y") != 0) { bad = 11; }
    if (ut_vec_diag2("use uniontest.lib;\nfun main() i32 { ret lib.box_gate[lib.Box[lib.Pair]](); }\n", lib, "LIB_Y") != 0)                                                                       { bad = 12; }

    if (ut_layout_ok("rec Pair { a: u64; }\nval ID: u64 = $type_id(Pair);\nfun main() i32 { val n: u64 = $type_id(^Pair); if (n == ID) { ret 1; } ret 0; }\n") != 0) { bad = 13; }
    if (ut_vec_diag("rec Pair { a: u64; }\nfun main() i32 { val n: u32 = $type_id(Pair); ret 0; }\n", "type mismatch") != 0)                                         { bad = 14; }
    if (ut_vec_diag("fun main() i32 { val n: u64 = $type_id(u8, u16); ret 0; }\n", "$type_id: expected 1 argument") != 0)                                            { bad = 15; }

    ret bad;
}

#[testing]
fun t_arm2(main: str, lib: str, want: str, other: str) i32 {
    if (ut_vec_diag2(main, lib, want) != 0)  { ret 1; }
    if (ut_vec_diag2(main, lib, other) == 0) { ret 1; }
    ret 0;
}

test reflection__descends_into_field_types {
    var bad: i32 = 0;

    if (ut_arm("rec Inner { x: u64; }\nrec Outer { i: Inner; }\nfun main() i32 { $each f in $fields(Outer) { $if ($is_record(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "Y", "N") != 0)   { bad = 1; }
    if (ut_arm("rec Outer { n: u64; }\nfun main() i32 { $each f in $fields(Outer) { $if ($is_record(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "N", "Y") != 0)                            { bad = 1; }
    if (ut_arm("rec Inner { x: u64; }\nrec Outer { p: *Inner; }\nfun main() i32 { $each f in $fields(Outer) { $if ($is_pointer(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_arm("rec Inner { x: u64; }\nrec Outer { i: Inner; }\nfun main() i32 { $each f in $fields(Outer) { $if ($type_name(f.type) == \"Inner\") { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_arm("rec Inner { x: u64; }\nrec Outer { i: ^Inner; }\nfun main() i32 { $each f in $fields(Outer) { $if ($is_record(f.type)) { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "N", "Y") != 0) { bad = 1; }

    if (ut_arm("rec Inner { x: u64; }\nrec Outer { i: ^Inner; }\nfun main() i32 { $each f in $fields(Outer) { $if ($is_record(f.type)) { $error(\"REC\"); } $or (f.type == u64) { $error(\"SCALAR\"); } $or { $error(\"REFUSED\"); } } ret 0; }\n", "REFUSED", "REC") != 0) { bad = 1; }

    if (ut_arm("rec Inner { x: u64; }\nrec Outer { i: ^Inner; }\nfun main() i32 { $each f in $fields(Outer) { $if ($type_name(f.type) == \"^Inner\") { $error(\"Y\"); } $or { $error(\"N\"); } } ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (ut_layout_ok("rec Inner { x: u64; y: u64; }\nrec Outer { i: Inner; n: u64; }\nfun main() i32 { var c: i32 = 0; $each f in $fields(Outer) { $if ($is_record(f.type)) { $each g in $fields(f.type) { c = c + 1; } } $or { c = c + 100; } } ret c; }\n") != 0) { bad = 1; }

    ret bad;
}

test reflection__recursion_through_generics {
    var bad: i32 = 0;

    if (ut_layout_ok("rec I { x: u64; }\nrec M { i: I; n: u64; }\nrec O { m: M; n: u64; }\nfun w[T](v: *T) i32 { $each f in $fields(T) { $if ($is_record(f.type)) { w[f.type](?v.[f]); } $or { } } ret 0; }\nfun main() i32 { var o: O; ret w[O](?o); }\n") != 0) { bad = 1; }

    if (ut_arm("rec I { x: u64; }\nrec O { i: I; }\nfun w[T]() i32 { $each f in $fields(T) { $if (f.name == \"x\") { $error(\"INNER\"); } $or ($is_record(f.type)) { w[f.type](); } $or { } } ret 0; }\nfun main() i32 { ret w[O](); }\n", "INNER", "OUTER") != 0) { bad = 1; }

    if (ut_layout_ok("rec I { x: u64; }\nrec O { i: I; }\nfun two[A, B](a: *A, b: *B) i32 { ret 0; }\nfun w[T](v: *T) i32 { var n: i32 = 0; $each f in $fields(T) { $if ($is_record(f.type)) { n = two[f.type, i32](?v.[f], ?n); } $or { } } ret n; }\nfun main() i32 { var o: O; ret w[O](?o); }\n") != 0) { bad = 1; }

    if (ut_vec_diag("fun g[T](a: *T) i32 { ret 0; }\nfun main() i32 { var x: u64; ret g[nosuchmod.T](?x); }\n",
        "unresolved type name") != 0) { bad = 1; }

    if (ut_vec_diag("fun g[T](a: *T) i32 { ret 0; }\nfun main() i32 { var f: u64; var x: u64; ret g[f.type](?x); }\n",
        "names a `$each` field-descriptor loop variable") != 0) { bad = 1; }

    if (ut_layout_ok("rec S { type: u64; }\nfun main() i32 { var s: S; s.type = 5; ret 0; }\n") != 0) { bad = 1; }

    ret bad;
}

# a short-circuit gate that holds binds its body; one that does not stays inactive
test comptime_gate__short_circuit_binds_its_body {
    if (!ut_sema_clean("fun repro(x: u64) u64 { var probe: u64 = x; $if ($mach.build.os == $mach.os.linux || $mach.build.os == $mach.os.darwin) { probe = probe + 1; } ret probe; }\nfun main() i32 { ret 0; }\n")) { ret 1; }
    if (!ut_sema_clean("fun repro(x: u64) u64 { var probe: u64 = x; $if (1 == 1 || 0 == 1) { probe = probe + 1; } ret probe; }\nfun main() i32 { ret 0; }\n"))                                                      { ret 2; }
    if (!ut_sema_clean("fun repro(x: u64) u64 { var probe: u64 = x; $if (0 == 1 && 1 == 1) { probe = probe + 1; } ret probe; }\nfun main() i32 { ret 0; }\n"))                                                      { ret 3; }
    ret 0;
}

#[testing]
fun t_global_float_bits(s: *session.Session, m: *me_ir.Module, needle: str, is_f32: bool) i64 {
    val gi: i64 = ut_global_ix(s, m, needle);
    if (gi < 0) { ret 0 - 1; }
    val g: *me_ir.Global = ?m.globals[gi::u32];
    if (g.init.kind != value.VAL_CONST_FLOAT) { ret 0 - 1; }
    if (is_f32)                               { ret float.f64_to_f32_bits(float.f64_bits(g.init.data.float_lit))::i64; }
    ret float.f64_bits(g.init.data.float_lit)::i64;
}

test comptime_float__folds_at_its_declared_width {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = "val A: f32 = 16777217.0;\nval B: f32 = A - 16777216.0;\nval C: f32 = 1.0 / 3.0 * 7.0 - 2.0;\nval H: f32 = 1.0 / 3.0 * 0.1;\nval N: f32 = 0.0 - (1.0 / 3.0);\nval D: f64 = 1.0 / 3.0 * 7.0 - 2.0;\nval E: f64 = 16777217.0 - 16777216.0;\nfun main() i32 { ret 0; }\n";

    val pr: res[project.Project, fail.Fail] = ut_lower_n(?s, ?alloc, ?names[0], ?texts[0], 1);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var ra: f32 = 16777216.0;
    var rb: f32 = ra - 16777216.0;
    var rc: f32 = 1.0 / 3.0 * 7.0 - 2.0;
    var rh: f32 = 1.0 / 3.0 * 0.1;
    var rn: f32 = 0.0 - (1.0 / 3.0);
    var rd: f64 = 1.0 / 3.0 * 7.0 - 2.0;
    var re: f64 = 16777217.0 - 16777216.0;

    var bad: i32           = 0;
    val m:   *me_ir.Module = ut_ir_of(?p, ?s, "uniontest.main");
    if (m == nil) { bad = 1; }
    or {
        if (t_global_float_bits(?s, m, "uniontest.main.A", true) != 0x4B800000)     { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.A", true) != (ra:~u32)::i64) { bad = 1; }

        if (t_global_float_bits(?s, m, "uniontest.main.B", true) != 0x00000000)     { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.B", true) != (rb:~u32)::i64) { bad = 1; }

        if (t_global_float_bits(?s, m, "uniontest.main.C", true) != 0x3EAAAAB0)     { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.C", true) != (rc:~u32)::i64) { bad = 1; }

        if (t_global_float_bits(?s, m, "uniontest.main.H", true) != 0x3D088889)     { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.H", true) != (rh:~u32)::i64) { bad = 1; }

        if (t_global_float_bits(?s, m, "uniontest.main.N", true) != 0xBEAAAAAB)     { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.N", true) != (rn:~u32)::i64) { bad = 1; }

        if (t_global_float_bits(?s, m, "uniontest.main.D", false) != 0x3FD5555555555550) { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.D", false) != (rd:~u64)::i64)     { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.E", false) != 0x3FF0000000000000) { bad = 1; }
        if (t_global_float_bits(?s, m, "uniontest.main.E", false) != (re:~u64)::i64)     { bad = 1; }
    }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

# 0 when `expr` folds at comptime to `want`
#[testing]
fun t_folds_to(expr: str, want: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val cond: str = ut_cc3(?alloc, "fun main() i32 { $if ((", expr, ") == ");
    ret ut_arm(ut_cc3(?alloc, cond, want, ") { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n"), "Y", "N");
}

# 0 when the f16 expression `expr` folds to the binary16 encoding `bits`
#[testing]
fun t_f16_folds(expr: str, bits: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    ret t_folds_to(ut_cc3(?alloc, "(", expr, "):~u16"), bits);
}

# comptime folds f16 in binary16, agreeing with float.mach's operator and conversion table
test comptime_f16__folds_in_binary16 {
    if (t_f16_folds("65504.0f16 + 16.0f16", "0x7C00") != 0)                                { ret 1; }
    if (t_f16_folds("65504.0f16 + 15.9921875f16", "0x7BFF") != 0)                          { ret 2; }
    if (t_f16_folds("2048.0f16 + 1.0f16", "0x6800") != 0)                                  { ret 3; }
    if (t_f16_folds("2048.0f16 + 3.0f16", "0x6802") != 0)                                  { ret 4; }
    if (t_f16_folds("0.00006103515625f16 - 0.000000059604644775390625f16", "0x03FF") != 0) { ret 5; }
    if (t_f16_folds("0.000000059604644775390625f16 * 0.5f16", "0x0000") != 0)              { ret 6; }
    if (t_f16_folds("0.000000059604644775390625f16 * 1.5f16", "0x0002") != 0)              { ret 7; }
    if (t_f16_folds("256.0f16 * 256.0f16", "0x7C00") != 0)                                 { ret 8; }
    if (t_f16_folds("0.1f16 * 0.1f16", "0x211E") != 0)                                     { ret 9; }
    if (t_f16_folds("1.0f16 / 3.0f16", "0x3555") != 0)                                     { ret 10; }
    if (t_f16_folds("1.0f16 / 65504.0f16", "0x0100") != 0)                                 { ret 11; }
    if (t_f16_folds("5.5f16 % 3.0f16", "0x4100") != 0)                                     { ret 12; }
    if (t_f16_folds("-(1.5f16)", "0xBE00") != 0)                                           { ret 13; }
    if (t_f16_folds("65520.0::f16", "0x7C00") != 0)                                        { ret 14; }
    if (t_f16_folds("65519.0::f16", "0x7BFF") != 0)                                        { ret 15; }
    if (t_f16_folds("0.1f32::f16", "0x2E66") != 0)                                         { ret 16; }
    if (t_f16_folds("0.0000000894069671630859375::f16", "0x0002") != 0)                    { ret 17; }
    if (t_f16_folds("65519::i32::f16", "0x7BFF") != 0)                                     { ret 18; }
    if (t_f16_folds("65520::u32::f16", "0x7C00") != 0)                                     { ret 19; }
    if (t_f16_folds("2049::u32::f16", "0x6800") != 0)                                      { ret 20; }
    if (t_f16_folds("(0 - 2051)::i64::f16", "0xE802") != 0)                                { ret 21; }
    if (t_f16_folds("0x7E00::u16:~f16", "0x7E00") != 0)                                    { ret 22; }
    if (t_f16_folds("(0 - 1)::i16:~f16", "0xFFFF") != 0)                                   { ret 23; }
    if (t_f16_folds("0x03FF::u16:~f16 * 2.0f16", "0x07FE") != 0)                           { ret 24; }
    if (t_folds_to("0.000000059604644775390625f16::f64:~u64", "0x3E70000000000000") != 0)  { ret 25; }
    if (t_folds_to("65504.0f16::f32:~u32", "0x477FE000") != 0)                             { ret 26; }
    if (t_folds_to("(0.0f16 - 2.75f16)::i32", "(0 - 2)") != 0)                             { ret 27; }
    if (t_folds_to("65504.0f16::u16", "65504") != 0)                                       { ret 28; }
    if (t_folds_to("0.0f16 == -(0.0f16) && 65504.0f16 < 65504.0f16 + 16.0f16", "1") != 0)  { ret 29; }
    ret 0;
}

test comptime_f16__layout_and_predicates {
    if (t_folds_to("$size_of(f16) + $align_of(f16) * 10", "22") != 0)                                                        { ret 1; }
    if (t_folds_to("$size_of(rec { a: u8; b: f16; }) + $size_of([3]f16) * 10", "64") != 0)                                   { ret 2; }
    if (ut_arm("fun main() i32 { $if ($is_float(f16)) { $error(\"Y\"); } $or { $error(\"N\"); } ret 0; }\n", "Y", "N") != 0) { ret 3; }
    ret 0;
}

# true when the two-module project is rejected with a diagnostic carrying the needle
#[testing]
fun t_sema_rejects_with2(main: str, lib: str, needle: str) bool {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret false; }
    val sr: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel sr.err) { ret false; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var names: [2]str;
    names[0] = "main.mach";
    names[1] = "lib.mach";
    var texts: [2]str;
    texts[0] = main;
    texts[1] = lib;
    val pr: res[project.Project, fail.Fail] = ut_vec_sema_n(?s, ?alloc, ?names[0], ?texts[0], 2);
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        project.dnit_project(?p);
    }
    ret ut_count_errors(?s.diags) > 0 && ut_diag_has(?s.diags, needle);
}

test comptime_sel__refuses_a_mutable_or_foreign_place {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err)                                                                                                                                                                                                 { ret 1; }
    if (!ut_pipeline_rejects_with(?alloc, "tag Reply: u8 { empty; value: i64; } var G: Reply = Reply.value{1}; fun f() i64 { $if (sel G.value) { ret 1; } ret 0; }", "identifier is not a comptime constant in scope")) { ret 2; }
    if (!t_sema_rejects_with2("use uniontest.lib; fun f() i64 { $if (sel lib.C.value) { ret 1; } ret 0; }",
        "tag Reply: u8 { empty; value: i64; } pub val C: Reply = Reply.value{42};", "`sel` at compile time tests a constant tag")) { ret 3; }
    ret 0;
}

# `$project.name` and `$project.description` are refused at their use site as
# unknown paths, the same as any other wrong path
test project_path__name_and_description_are_refused_as_unknown {
    if (!ut_sema_rejects_with("val n: *u8 = $project.name;\nfun main() i32 { ret 0; }\n",
        "unknown `$project.*` path")) { ret 1; }
    if (!ut_sema_rejects_with("val d: *u8 = $project.description;\nfun main() i32 { ret 0; }\n",
        "unknown `$project.*` path")) { ret 2; }
    if (!ut_sema_rejects_with("val d: *u8 = $project.bogus;\nfun main() i32 { ret 0; }\n",
        "unknown `$project.*` path")) { ret 3; }
    if (!ut_sema_clean("val i: *u8 = $project.id;\nval v: *u8 = $project.version;\nfun main() i32 { ret 0; }\n")) { ret 4; }
    ret 0;
}
