# the deep value of a constant: an array, record or case literal as a tree of nodes with every
# member evaluated, an address as the symbol it points into, and a leaf that has no compile-time
# value kept with its refusal. a store holds the trees of one module, every node under a tree's
# root in that store, and a value names a node of it by the module's stable id
use std.collections.map;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use comptime_failure: mach.lang.fe.comptime.failure;
use comptime_value:   mach.lang.fe.comptime.value;
use mach.lang.intern;
use lang_source: mach.lang.source;
use mach.lang.stack;
use mach.lang.type;
use type_field: mach.lang.type.field;
use type_kind:  mach.lang.type.kind;
use type_prim:  mach.lang.type.prim;

pub def NodeKind: u8;
# a value the evaluator holds whole
pub val NODE_SCALAR: NodeKind = 0;
# an array literal: its elements, in order
pub val NODE_ARRAY: NodeKind = 1;
# a record or case literal: the case its head selects, STR_NIL for a record, then its
# named fields as written and its positional elements
pub val NODE_LITERAL: NodeKind = 2;
# a leaf that has no compile-time value, with the refusal reading it gives
pub val NODE_REFUSED: NodeKind = 3;
# the address of `symbol`, then of the place its members step to: a field, named, or an
# element, unnamed, each a scalar holding its ordinal at the type it steps into
pub val NODE_ADDRESS: NodeKind = 4;

# what reading a leaf with no compile-time value gives, and where that leaf is
pub rec Refusal {
    kind:    comptime_failure.EvalFailKind;
    diag:    diagnostic_kind.Kind;
    message: intern.StrId;
    at:      lang_source.Location;
}

# the module-level function, `val` or `var` an address points into: its declaration `decl` in
# the module with stable id `module`, which name it in every module that reads it
pub rec Symbol {
    module:   u32;
    decl:     u32;
    canon:    intern.StrId;
    function: bool;
}

# one node of a value; an aggregate's members are `members[first .. first + len]`
pub rec Node {
    kind:  NodeKind;
    ty:    type_kind.TypeId;
    value: comptime_value.CTValue;
    head:  intern.StrId;
    first: u32;
    len:   u32;
    # an array's declared element count, of which `len` are held and the rest are zero
    declared: u32;
    refusal:  Refusal;
    symbol:   Symbol;
}

# a member of an aggregate node: a named field, or an element or positional value with STR_NIL
pub rec Member {
    name: intern.StrId;
    node: u32;
}

pub rec Store {
    nodes:   collections_vector.Vector[Node];
    members: collections_vector.Vector[Member];
    # the root of the zero of each type built in this store, which every reader of that zero shares
    zeros: map.Map[type_kind.TypeId, u32];
}

pub fun init(alloc: *A.Allocator) Store {
    ret Store{nodes: collections_vector.init[Node](alloc), members: collections_vector.init[Member](alloc), zeros: map.init[type_kind.TypeId, u32](alloc)};
}

# release a deep store; a nil store holds nothing
pub fun dnit(s: *Store) {
    if (s == nil) { ret; }
    collections_vector.dnit[Node](?s.nodes);
    collections_vector.dnit[Member](?s.members);
    map.dnit[type_kind.TypeId, u32](?s.zeros);
}

pub fun node_add(s: *Store, n: Node) res[u32, fail.Fail] {
    val at:     u32                 = s.nodes.len::u32;
    val pushed: res[usize, A.Error] = collections_vector.push[Node](?s.nodes, n);
    if (sel pushed.err) { ret res[u32, fail.Fail].err{fail.refused(pushed.err)}; }
    ret res[u32, fail.Fail].ok{at};
}

# the members of an aggregate are added together once its children are, so they are contiguous
pub fun members_add(s: *Store, node: u32, members: *Member, len: u32) err[fail.Fail] {
    val first: u32 = s.members.len::u32;
    var i:     u32 = 0;
    for (i < len) {
        val pushed: res[usize, A.Error] = collections_vector.push[Member](?s.members, members[i]);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    s.nodes.data[node].first = first;
    s.nodes.data[node].len   = len;
    ret err[fail.Fail].ok{};
}

pub fun node_at(s: *Store, node: u32) *Node {
    ret ?s.nodes.data[node];
}

pub fun member_at(s: *Store, n: *Node, ord: u32) opt[Member] {
    if (n.kind != NODE_ARRAY && n.kind != NODE_LITERAL) { ret opt[Member].none{}; }
    if (ord >= n.len)                                   { ret opt[Member].none{}; }
    ret opt[Member].some{s.members.data[n.first + ord]};
}

pub fun refusal_of(itn: *intern.Interner, r: Refusal) comptime_failure.EvalFail {
    ret comptime_failure.eval_error(r.kind, r.diag, intern.text(itn, r.message));
}

# the value a scalar node holds, or the refusal a refused one gives; an aggregate has no
# value of its own, and an address has none until the program is linked
pub fun value(s: *Store, itn: *intern.Interner, node: u32) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val n: *Node = node_at(s, node);
    if (n.kind == NODE_SCALAR)  { ret res[comptime_value.CTValue, comptime_failure.EvalFail].ok{n.value}; }
    if (n.kind == NODE_REFUSED) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{refusal_of(itn, n.refusal)}; }
    if (n.kind == NODE_ADDRESS) {
        ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED,
            diagnostic_kind.COMPTIME_NOT_EVALUABLE, "an address is fixed only when the program is linked, so it has no compile-time value")};
    }
    ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED,
        diagnostic_kind.COMPTIME_NOT_EVALUABLE, "an aggregate constant has no single compile-time value")};
}

# what reading node `node` of module `module`'s store gives: a scalar's value, a refused leaf's
# or an address's refusal, or the aggregate itself as a value naming it
pub fun read(s: *Store, itn: *intern.Interner, module: u32, node: u32) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val n: *Node = node_at(s, node);
    if (n.kind == NODE_SCALAR || n.kind == NODE_REFUSED || n.kind == NODE_ADDRESS) { ret value(s, itn, node); }
    ret res[comptime_value.CTValue, comptime_failure.EvalFail].ok{comptime_value.node_ref(module, node, type_kind.index(n.ty))};
}

def ProjectionKind: u8;
# the node is no record or case literal
val     PROJECT_ABSENT: ProjectionKind = 0;
pub val PROJECT_MEMBER: ProjectionKind = 1;
# a case literal holding another case, `head`
pub val PROJECT_UNSELECTED: ProjectionKind = 2;
# a case literal holding the case but no payload for it
pub val PROJECT_NO_PAYLOAD: ProjectionKind = 3;
# a record literal that leaves the field out, which holds its zero
pub val PROJECT_OMITTED: ProjectionKind = 4;

pub rec Projection {
    kind: ProjectionKind;
    node: u32;
    head: intern.StrId;
}

# member `name` of a record or case literal: a record's field, or a case literal's payload when
# `name` is the case it holds
pub fun project(s: *Store, node: u32, name: intern.StrId) Projection {
    val n: *Node = node_at(s, node);
    if (n.kind != NODE_LITERAL) { ret Projection{kind: PROJECT_ABSENT, head: intern.STR_NIL}; }
    if (!intern.str_is_nil(n.head)) {
        if (!intern.str_same(n.head, name)) { ret Projection{kind: PROJECT_UNSELECTED, head: n.head}; }
        val payload: opt[Member] = member_at(s, n, 0);
        if (sel payload.none) { ret Projection{kind: PROJECT_NO_PAYLOAD, head: n.head}; }
        ret Projection{kind: PROJECT_MEMBER, node: payload.some.node, head: n.head};
    }
    var i: u32 = 0;
    for (i < n.len) {
        val m: Member = s.members.data[n.first + i];
        if (intern.str_same(m.name, name)) { ret Projection{kind: PROJECT_MEMBER, node: m.node, head: intern.STR_NIL}; }
        i = i + 1;
    }
    ret Projection{kind: PROJECT_OMITTED, head: intern.STR_NIL};
}

def ElementKind: u8;
# the node is no array
val     ELEMENT_ABSENT: ElementKind = 0;
pub val ELEMENT_MEMBER: ElementKind = 1;
# an index the array declares but its literal leaves out, which holds its zero
val     ELEMENT_OMITTED:  ElementKind = 2;
pub val ELEMENT_PAST_END: ElementKind = 3;

pub val INDEX_PAST_END_MSG: str = "this index is past the end of the constant it reads";

pub rec Element {
    kind: ElementKind;
    node: u32;
}

# element `index` of an array node
pub fun element(s: *Store, node: u32, index: u64) Element {
    val n: *Node = node_at(s, node);
    if (n.kind != NODE_ARRAY)     { ret Element{kind: ELEMENT_ABSENT}; }
    if (index >= n.declared::u64) { ret Element{kind: ELEMENT_PAST_END}; }
    if (index >= n.len::u64)      { ret Element{kind: ELEMENT_OMITTED}; }
    ret Element{kind: ELEMENT_MEMBER, node: s.members.data[n.first + index::u32].node};
}

# the first leaf under `node` that has no compile-time value, none when every leaf has one
pub fun refused_within(s: *Store, node: u32) opt[u32] {
    val n: *Node = node_at(s, node);
    if (n.kind == NODE_REFUSED)                          { ret opt[u32].some{node}; }
    if (n.kind == NODE_SCALAR || n.kind == NODE_ADDRESS) { ret opt[u32].none{}; }
    var i: u32 = 0;
    for (i < n.len) {
        val inner: opt[u32] = refused_within(s, s.members.data[n.first + i].node);
        if (sel inner.some) { ret inner; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# node `node` of `from` with everything under it, added to `to`, which is another store. the
# copy recurses as deep as the value nests, so it asks for stack before it descends and refuses
# a value nested deeper (`nesting`), which the node that asked reports. a failure leaves `to`
# as it was
pub fun clone(to: *Store, from: *Store, node: u32) res[u32, fail.Fail] {
    val nodes:   usize               = to.nodes.len;
    val members: usize               = to.members.len;
    val copied:  res[u32, fail.Fail] = clone_tree(to, from, node);
    if (sel copied.err) {
        collections_vector.truncate[Node](?to.nodes, nodes);
        collections_vector.truncate[Member](?to.members, members);
    }
    ret copied;
}

fun clone_tree(to: *Store, from: *Store, node: u32) res[u32, fail.Fail] {
    if (stack.exhausted()) { ret res[u32, fail.Fail].err{nesting()}; }
    var n:     Node = from.nodes.data[node];
    val count: u32  = n.len;
    val first: u32  = n.first;
    n.first = 0;
    n.len   = 0;
    val at: res[u32, fail.Fail] = node_add(to, n);
    if (sel at.err) { ret at; }
    if (count == 0) { ret at; }
    val allocated: res[*Member, A.Error] = A.allocate[Member](to.members.a, count::usize);
    if (sel allocated.err) { ret res[u32, fail.Fail].err{fail.refused(allocated.err)}; }
    val members: *Member = allocated.ok;
    fin { A.deallocate[Member](to.members.a, members, count::usize); }
    var i: u32 = 0;
    for (i < count) {
        val m:     Member              = from.members.data[first + i];
        val child: res[u32, fail.Fail] = clone_tree(to, from, m.node);
        if (sel child.err) { ret child; }
        members[i] = Member{name: m.name, node: child.ok};
        i          = i + 1;
    }
    val linked: err[fail.Fail] = members_add(to, at.ok, members, count);
    if (sel linked.err) { ret res[u32, fail.Fail].err{linked.err}; }
    ret at;
}

pub val ZERO_UNKNOWN_MSG: str = "the zero of this field's type is not known";

# whether `ty` has a zero: every type the type store holds does, an unresolved or error type does not
pub fun zero_defined(types: *type.TypeInterner, ty: type_kind.TypeId) bool {
    val found: opt[*type.Type] = type.get(types, type.strip_secret(types, ty));
    ret sel found.some;
}

# the zero of `ty` in `s`, which a member a literal leaves out holds: a record, union or array
# with no members, a scalar zero, or a tag's first declared case over the zero of its payload.
# It is built the first time it is asked for and shared by every later reader, so `s` holds at
# most one tree per distinct type. Nothing writes a node once its members are linked, which is
# what makes the sharing safe. The tag's field table must be ready, and a tag with no cases is
# an internal failure. A failure leaves `s` as it was.
pub fun zero_node(s: *Store, types: *type.TypeInterner, pointer_width: u32, ty: type_kind.TypeId) res[u32, fail.Fail] {
    val hit: opt[*u32] = map.get[type_kind.TypeId, u32](?s.zeros, ?ty);
    if (sel hit.some) { ret res[u32, fail.Fail].ok{@hit.some}; }
    val nodes:   usize               = s.nodes.len;
    val members: usize               = s.members.len;
    val built:   res[u32, fail.Fail] = zero_build(s, types, pointer_width, ty);
    var kept:    res[u32, fail.Fail] = built;
    if (sel built.ok) {
        val put: res[bool, A.Error] = map.insert[type_kind.TypeId, u32](?s.zeros, ty, built.ok);
        if (sel put.ok) { ret built; }
        kept = res[u32, fail.Fail].err{fail.refused(put.err)};
    }
    collections_vector.truncate[Node](?s.nodes, nodes);
    collections_vector.truncate[Member](?s.members, members);
    ret kept;
}

# the refusal of a walk over a value or type nested deeper than the stack lets it descend
fun nesting() fail.Fail {
    ret fail.user(diagnostic_kind.SYNTAX_NESTING_DEPTH, "input nests deeper than building a constant's value descends; the stack has no room left to go deeper");
}

# the zero recurses as deep as tags hold tags by value, so it asks for stack before it descends
fun zero_build(s: *Store, types: *type.TypeInterner, pointer_width: u32, ty: type_kind.TypeId) res[u32, fail.Fail] {
    if (stack.exhausted()) { ret res[u32, fail.Fail].err{nesting()}; }
    val bare: type_kind.TypeId = type.strip_secret(types, ty);
    if (type.is_tag(types, bare)) { ret zero_tag(s, types, pointer_width, ty); }
    var node:     Node     = Node{kind: NODE_SCALAR, ty: ty, head: intern.STR_NIL};
    val elements: opt[u32] = type.element_count(types, ty);
    if (type.is_record(types, ty) || type.is_union(types, ty)) { node.kind = NODE_LITERAL; }
    or (sel elements.some) {
        node.kind     = NODE_ARRAY;
        node.declared = elements.some;
    }
    or {
        val found: opt[*type.Type] = type.get(types, bare);
        if (sel found.none) { ret res[u32, fail.Fail].err{fail.message(ZERO_UNKNOWN_MSG)}; }
        val desc: type_prim.PrimDesc = type_prim.prim_desc(found.some.kind);
        if (desc.class == type_prim.PRIM_CLASS_FLOAT) { node.value = comptime_value.ct_float(0.0, type_prim.float_width_of(found.some.kind)); }
        or (desc.class == type_prim.PRIM_CLASS_INT)   { node.value = comptime_value.ct_zero_int(!desc.signed, comptime_value.width_held(desc.bits)); }
        or                                            { node.value = comptime_value.ct_zero_int(true, (pointer_width * 8)::u8); }
    }
    ret node_add(s, node);
}

# the case literal of the first declared case of tag `ty`, holding the zero of its payload when it
# declares one: the shape a written case literal has, and the value lowering zero-fills
fun zero_tag(s: *Store, types: *type.TypeInterner, pointer_width: u32, ty: type_kind.TypeId) res[u32, fail.Fail] {
    val first: opt[*type_field.Entry] = type.field_at(types, type.strip_secret(types, ty), 0);
    if (sel first.none) { ret res[u32, fail.Fail].err{fail.message("a tag has no cases, or its field table is not ready")}; }
    var payload: u32  = 0;
    val has:     bool = !type_kind.is_nil(first.some.ty);
    if (has) {
        val zero: res[u32, fail.Fail] = zero_build(s, types, pointer_width, first.some.ty);
        if (sel zero.err) { ret zero; }
        payload = zero.ok;
    }
    val node: res[u32, fail.Fail] = node_add(s, Node{kind: NODE_LITERAL, ty: ty, head: first.some.name});
    if (sel node.err) { ret node; }
    if (has) {
        val member: Member         = Member{name: intern.STR_NIL, node: payload};
        val linked: err[fail.Fail] = members_add(s, node.ok, ?member, 1);
        if (sel linked.err) { ret res[u32, fail.Fail].err{linked.err}; }
    }
    ret node;
}

# the module index a scratch store of zeros answers to when a node of it is read as a value
pub val SCRATCH_MODULE: u32 = 0xFFFFFFFF;
