# the deep value of a constant: an array, record or case literal as a tree of nodes with every
# member evaluated, and a leaf that has no compile-time value kept with its refusal. a store
# holds the trees of one module, and a value names a node of it by the module's stable id
use collections_vector: std.collections.vector;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.page;

use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use comptime_failure: mach.lang.fe.comptime.failure;
use comptime_value:   mach.lang.fe.comptime.value;
use mach.lang.intern;
use mach.lang.type;

pub def NodeKind: u8;
# a value the evaluator holds whole
pub val NODE_SCALAR: NodeKind = 0;
# an array literal: its elements, in order
pub val NODE_ARRAY: NodeKind = 1;
# a record or case literal: the case its head selects, STR_NIL for a record, then its
# named fields as written and its positional elements
pub val NODE_LITERAL: NodeKind = 2;
# a leaf that has no compile-time value, with the refusal reading it gives
pub val NODE_REFUSED: NodeKind = 3;

pub rec Refusal {
    kind:    comptime_failure.EvalFailKind;
    diag:    diagnostic_kind.Kind;
    message: intern.StrId;
}

# one node of a value; an aggregate's members are `members[first .. first + len]`
pub rec Node {
    kind:    NodeKind;
    ty:      type.TypeId;
    value:   comptime_value.CTValue;
    head:    intern.StrId;
    first:   u32;
    len:     u32;
    refusal: Refusal;
}

# a member of an aggregate node: a named field, or an element or positional value with STR_NIL
pub rec Member {
    name: intern.StrId;
    node: u32;
}

pub rec Store {
    nodes:   collections_vector.Vector[Node];
    members: collections_vector.Vector[Member];
}

pub fun init(alloc: *A.Allocator) Store {
    ret Store{nodes: collections_vector.init[Node](alloc), members: collections_vector.init[Member](alloc)};
}

pub fun dnit(s: *Store) {
    if (s == nil) { ret; }
    collections_vector.dnit[Node](?s.nodes);
    collections_vector.dnit[Member](?s.members);
}

pub fun node_add(s: *Store, n: Node) res[u32, fail.Fail] {
    val at:     u32                 = s.nodes.len::u32;
    val pushed: res[usize, A.Error] = collections_vector.push[Node](?s.nodes, n);
    if (sel pushed.err) { ret res[u32, fail.Fail].err{fail.refused(pushed.err)}; }
    ret res[u32, fail.Fail].ok{at};
}

# the members of an aggregate are added together once its children are, so they are contiguous
pub fun members_add(s: *Store, node: u32, members: *Member, len: u32) err[fail.Fail] {
    val first: u32 = s.members.len::u32;
    var i:     u32 = 0;
    for (i < len) {
        val pushed: res[usize, A.Error] = collections_vector.push[Member](?s.members, members[i]);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    s.nodes.data[node].first = first;
    s.nodes.data[node].len   = len;
    ret err[fail.Fail].ok{};
}

pub fun node_at(s: *Store, node: u32) *Node {
    ret ?s.nodes.data[node];
}

pub fun member_at(s: *Store, n: *Node, ord: u32) opt[Member] {
    if (n.kind != NODE_ARRAY && n.kind != NODE_LITERAL) { ret opt[Member].none{}; }
    if (ord >= n.len)                                   { ret opt[Member].none{}; }
    ret opt[Member].some{s.members.data[n.first + ord]};
}

pub fun refusal_of(itn: *intern.Interner, r: Refusal) comptime_failure.EvalFail {
    ret comptime_failure.eval_error(r.kind, r.diag, intern.text(itn, r.message));
}

# the value a scalar node holds, or the refusal a refused one gives; an aggregate has no
# value of its own
pub fun value(s: *Store, itn: *intern.Interner, node: u32) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val n: *Node = node_at(s, node);
    if (n.kind == NODE_SCALAR)  { ret res[comptime_value.CTValue, comptime_failure.EvalFail].ok{n.value}; }
    if (n.kind == NODE_REFUSED) { ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{refusal_of(itn, n.refusal)}; }
    ret res[comptime_value.CTValue, comptime_failure.EvalFail].err{comptime_failure.eval_error(comptime_failure.EVAL_FAIL_REJECTED,
        diagnostic_kind.COMPTIME_NOT_EVALUABLE, "an aggregate constant has no single compile-time value")};
}

# what reading node `node` of module `module`'s store gives: a scalar's value, a refused leaf's
# refusal, or the aggregate itself as a value naming it
pub fun read(s: *Store, itn: *intern.Interner, module: u32, node: u32) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    val n: *Node = node_at(s, node);
    if (n.kind == NODE_SCALAR || n.kind == NODE_REFUSED) { ret value(s, itn, node); }
    ret res[comptime_value.CTValue, comptime_failure.EvalFail].ok{comptime_value.node_ref(module, node, type.index(n.ty))};
}

pub def ProjectionKind: u8;
# the node is no record or case literal
pub val PROJECT_ABSENT: ProjectionKind = 0;
pub val PROJECT_MEMBER: ProjectionKind = 1;
# a case literal holding another case, `head`
pub val PROJECT_UNSELECTED: ProjectionKind = 2;
# a case literal holding the case but no payload for it
pub val PROJECT_NO_PAYLOAD: ProjectionKind = 3;
# a record literal that leaves the field out, which holds its zero
pub val PROJECT_OMITTED: ProjectionKind = 4;

pub rec Projection {
    kind: ProjectionKind;
    node: u32;
    head: intern.StrId;
}

# member `name` of a record or case literal: a record's field, or a case literal's payload when
# `name` is the case it holds
pub fun project(s: *Store, node: u32, name: intern.StrId) Projection {
    val n: *Node = node_at(s, node);
    if (n.kind != NODE_LITERAL) { ret Projection{kind: PROJECT_ABSENT, head: intern.STR_NIL}; }
    if (!intern.str_is_nil(n.head)) {
        if (!intern.str_same(n.head, name)) { ret Projection{kind: PROJECT_UNSELECTED, head: n.head}; }
        val payload: opt[Member] = member_at(s, n, 0);
        if (sel payload.none) { ret Projection{kind: PROJECT_NO_PAYLOAD, head: n.head}; }
        ret Projection{kind: PROJECT_MEMBER, node: payload.some.node, head: n.head};
    }
    var i: u32 = 0;
    for (i < n.len) {
        val m: Member = s.members.data[n.first + i];
        if (intern.str_same(m.name, name)) { ret Projection{kind: PROJECT_MEMBER, node: m.node, head: intern.STR_NIL}; }
        i = i + 1;
    }
    ret Projection{kind: PROJECT_OMITTED, head: intern.STR_NIL};
}

# the first leaf under `node` that has no compile-time value, none when every leaf has one
pub fun refused_within(s: *Store, node: u32) opt[u32] {
    val n: *Node = node_at(s, node);
    if (n.kind == NODE_REFUSED) { ret opt[u32].some{node}; }
    if (n.kind == NODE_SCALAR)  { ret opt[u32].none{}; }
    var i: u32 = 0;
    for (i < n.len) {
        val inner: opt[u32] = refused_within(s, s.members.data[n.first + i].node);
        if (sel inner.some) { ret inner; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

#[testing]
fun t_name(itn: *intern.Interner, text: str) intern.StrId {
    val made: res[intern.StrId, A.Error] = intern.add(itn, text);
    if (sel made.err) { ret intern.STR_NIL; }
    ret made.ok;
}

# an aggregate's members read back in order, a scalar gives its value, a refused leaf gives its
# refusal, and an aggregate reads as a value naming it
test node__reads_members_and_leaves {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var s: Store = init(?alloc);
    fin { dnit(?s); }
    val why: intern.StrId = t_name(?itn, "not constant");
    if (intern.str_is_nil(why)) { ret 1; }
    val leaf: res[u32, fail.Fail] = node_add(?s, Node{kind: NODE_SCALAR, value: comptime_value.ct_u8(7)});
    if (sel leaf.err) { ret 2; }
    val refused: res[u32, fail.Fail] = node_add(?s, Node{kind: NODE_REFUSED,
        refusal: Refusal{kind: comptime_failure.EVAL_FAIL_REJECTED, diag: diagnostic_kind.COMPTIME_NOT_EVALUABLE, message: why}});
    if (sel refused.err) { ret 2; }
    val array: res[u32, fail.Fail] = node_add(?s, Node{kind: NODE_ARRAY});
    if (sel array.err) { ret 2; }
    var members: [2]Member      = [2]Member{Member{name: intern.STR_NIL, node: leaf.ok}, Member{name: intern.STR_NIL, node: refused.ok}};
    val linked:  err[fail.Fail] = members_add(?s, array.ok, ?members[0], 2);
    if (sel linked.err) { ret 3; }
    val second: opt[Member] = member_at(?s, node_at(?s, array.ok), 1);
    if (sel second.none)                { ret 4; }
    if (second.some.node != refused.ok) { ret 4; }
    val past: opt[Member] = member_at(?s, node_at(?s, array.ok), 2);
    if (sel past.some) { ret 4; }
    val v: res[comptime_value.CTValue, comptime_failure.EvalFail] = read(?s, ?itn, 5, leaf.ok);
    if (sel v.err)        { ret 5; }
    if (v.ok.data.i != 7) { ret 5; }
    val r: res[comptime_value.CTValue, comptime_failure.EvalFail] = read(?s, ?itn, 5, refused.ok);
    if (sel r.ok)                                             { ret 6; }
    if (r.err.diag != diagnostic_kind.COMPTIME_NOT_EVALUABLE) { ret 6; }
    if (!str_equals(r.err.message, "not constant"))           { ret 6; }
    val whole: res[comptime_value.CTValue, comptime_failure.EvalFail] = read(?s, ?itn, 5, array.ok);
    if (sel whole.err)                                                         { ret 7; }
    if (whole.ok.kind != comptime_value.CT_KIND_NODE)                          { ret 7; }
    if (whole.ok.data.node.module != 5 || whole.ok.data.node.node != array.ok) { ret 7; }
    val bad: opt[u32] = refused_within(?s, array.ok);
    if (sel bad.none)           { ret 8; }
    if (bad.some != refused.ok) { ret 8; }
    val clean: opt[u32] = refused_within(?s, leaf.ok);
    if (sel clean.some) { ret 8; }
    ret 0;
}

# a record literal projects its named fields, and a case literal its payload under the case it
# holds, refusing any other case and a case it holds without a payload
test project__reads_fields_and_the_held_case {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var s: Store = init(?alloc);
    fin { dnit(?s); }
    val x:     intern.StrId        = t_name(?itn, "x");
    val value: intern.StrId        = t_name(?itn, "value");
    val empty: intern.StrId        = t_name(?itn, "empty");
    val leaf:  res[u32, fail.Fail] = node_add(?s, Node{kind: NODE_SCALAR, value: comptime_value.ct_u8(3)});
    if (sel leaf.err) { ret 1; }
    val rec_r: res[u32, fail.Fail] = node_add(?s, Node{kind: NODE_LITERAL, head: intern.STR_NIL});
    if (sel rec_r.err) { ret 1; }
    var fields:   [1]Member      = [1]Member{Member{name: x, node: leaf.ok}};
    val fields_r: err[fail.Fail] = members_add(?s, rec_r.ok, ?fields[0], 1);
    if (sel fields_r.err) { ret 1; }
    val held: res[u32, fail.Fail] = node_add(?s, Node{kind: NODE_LITERAL, head: value});
    if (sel held.err) { ret 1; }
    var payload:   [1]Member      = [1]Member{Member{name: intern.STR_NIL, node: leaf.ok}};
    val payload_r: err[fail.Fail] = members_add(?s, held.ok, ?payload[0], 1);
    if (sel payload_r.err) { ret 1; }
    val bare: res[u32, fail.Fail] = node_add(?s, Node{kind: NODE_LITERAL, head: empty});
    if (sel bare.err) { ret 1; }

    val field: Projection = project(?s, rec_r.ok, x);
    if (field.kind != PROJECT_MEMBER || field.node != leaf.ok) { ret 2; }
    if (project(?s, rec_r.ok, value).kind != PROJECT_OMITTED)  { ret 3; }
    val case_r: Projection = project(?s, held.ok, value);
    if (case_r.kind != PROJECT_MEMBER || case_r.node != leaf.ok) { ret 4; }
    val other: Projection = project(?s, held.ok, empty);
    if (other.kind != PROJECT_UNSELECTED || !intern.str_same(other.head, value)) { ret 5; }
    if (project(?s, bare.ok, empty).kind != PROJECT_NO_PAYLOAD)                  { ret 6; }
    if (project(?s, leaf.ok, x).kind != PROJECT_ABSENT)                          { ret 7; }
    ret 0;
}
