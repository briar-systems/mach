# comptime gates: which later phase a gate's condition depends on, and the verdict that
# selects or discards its arm
use std.allocator.page;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;
use mach.lang.fe.ast.interpretation;
use mach.lang.fe.comptime;
use comptime_capability: mach.lang.fe.comptime.capability;
use comptime_failure:    mach.lang.fe.comptime.failure;
use mach.lang.fe.comptime.intrinsic;
use comptime_scope: mach.lang.fe.comptime.scope;
use comptime_value: mach.lang.fe.comptime.value;
use mach.lang.intern;
use lang_source: mach.lang.source;
use mach.lang.stack;
use mach.lang.target.resolved;
use mach.lang.wide;
use A: std.allocator;
use T: std.allocator.testing;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

pub def GateOutcome: u8;

pub val GATE_INACTIVE:          GateOutcome = 0;
pub val GATE_ACTIVE:            GateOutcome = 1;
pub val GATE_REJECTED:          GateOutcome = 2;
pub val GATE_FAILED:            GateOutcome = 3;
pub val GATE_AWAITING_PHASE:    GateOutcome = 4;
pub val GATE_AWAITING_INSTANCE: GateOutcome = 5;

fun gate_eval_failure_is_transient(kind: comptime_failure.EvalFailKind) bool {
    ret kind == comptime_failure.EVAL_FAIL_UNBOUND
        || kind == comptime_failure.EVAL_FAIL_NEEDS_MEMBER
        || kind == comptime_failure.EVAL_FAIL_NEEDS_LAYOUT;
}

# whether every arm of a chain, at any depth, declares nothing but directives and chains; a
# chain nested deeper than the stack lets the walk descend is refused (`nesting`)
pub fun comptime_if_declares_nothing(a: *ast.Ast, branches_start: u32, branches_len: u32) res[bool, fail.Fail] {
    if (stack.exhausted()) { ret res[bool, fail.Fail].err{nesting()}; }
    var bi: u32 = 0;
    for (bi < branches_len) {
        val branch_ix: u32 = branches_start + bi;
        if (branch_ix::usize >= a.comptime_branches.len) { ret res[bool, fail.Fail].ok{false}; }
        val br: *ast_decl.ComptimeBranch = ?a.comptime_branches.data[branch_ix];
        var di: u32                      = 0;
        for (di < br.body_len) {
            val pool_ix: u32 = br.body_start + di;
            if (pool_ix::usize >= a.decl_ids.len) { ret res[bool, fail.Fail].ok{false}; }
            val nothing: res[bool, fail.Fail] = decl_declares_nothing(a, a.decl_ids.data[pool_ix]);
            if (sel nothing.err) { ret nothing; }
            if (!nothing.ok)     { ret nothing; }
            di = di + 1;
        }
        bi = bi + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

fun decl_declares_nothing(a: *ast.Ast, did: ast_id.DeclId) res[bool, fail.Fail] {
    val d_opt: opt[*ast_decl.Decl] = ast.get_decl(a, did);
    if (!sel d_opt.some) { ret res[bool, fail.Fail].ok{false}; }
    val d: *ast_decl.Decl = d_opt.some;
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_DIRECTIVE) { ret res[bool, fail.Fail].ok{true}; }
    if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
        ret comptime_if_declares_nothing(a, d.data.comptime_if.branches_start, d.data.comptime_if.branches_len);
    }
    ret res[bool, fail.Fail].ok{false};
}

# the refusal of a walk over nesting deeper than the stack lets it descend, which the phase
# that asked reports against the node it asked about
pub fun nesting() fail.Fail {
    ret fail.user(diagnostic_kind.SYNTAX_NESTING_DEPTH, "input nests deeper than a compile-time gate walk descends; the stack has no room left to go deeper");
}

pub def GateProbe: u8;

pub val GATE_PROBE_COMPTIME_PARAM:   GateProbe = 0;
val     GATE_PROBE_LAYOUT_INTRINSIC: GateProbe = 1;
pub val GATE_PROBE_TYPE_COMPARISON:  GateProbe = 2;
val     GATE_PROBE_FIELD_DESCRIPTOR: GateProbe = 3;
val     GATE_PROBE_EACH_LOOPVAR:     GateProbe = 4;
val     GATE_PROBE_NODE_ACTION:      GateProbe = 5;

val GATE_PROBE_COUNT: u32 = 5;

pub def GateNodeVerdict: u8;

pub val GATE_NODE_NO:    GateNodeVerdict = 0;
val     GATE_NODE_YES:   GateNodeVerdict = 1;
pub val GATE_NODE_PRUNE: GateNodeVerdict = 2;

val GATE_PROBE_UNLISTED_KIND_MSG: str =
    "internal: this expression kind has no entry in the compile-time dependency visitor; a gate that nests it cannot be scanned for dependencies";

val GATE_PROBE_NO_OBSERVER_MSG: str =
    "internal: this phase did not supply the observer a compile-time dependency probe needs";

pub rec GateProbes[T] {
    expression:         fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail];
    comptime_param:     fun(*T, ast_id.ExprId) bool;
    each_loopvar:       fun(*T, ast_id.ExprId) bool;
    field_loopvar:      fun(*T, ast_id.ExprId) bool;
    field_type_operand: fun(*T, ast_id.ExprId) res[bool, fail.Fail];
    node_action:        fun(*T, ast_id.ExprId, *ast_expr.Expr) res[GateNodeVerdict, fail.Fail];
}

pub fun gate_probes[T](
    comptime_param: fun(*T, ast_id.ExprId) bool,
    each_loopvar: fun(*T, ast_id.ExprId) bool,
    field_loopvar: fun(*T, ast_id.ExprId) bool,
    field_type_operand: fun(*T, ast_id.ExprId) res[bool, fail.Fail],
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail]) GateProbes[T] {
    var p: GateProbes[T];
    p.expression         = expression;
    p.comptime_param     = comptime_param;
    p.each_loopvar       = each_loopvar;
    p.field_loopvar      = field_loopvar;
    p.field_type_operand = field_type_operand;
    p.node_action        = nil;
    ret p;
}

fun gate_node_action_probes[T](action: fun(*T, ast_id.ExprId, *ast_expr.Expr) res[GateNodeVerdict, fail.Fail],
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail]) GateProbes[T] {
    var p: GateProbes[T] = gate_probes[T](nil, nil, nil, nil, expression);
    p.node_action = action;
    ret p;
}

pub fun gate_walk[T](a: *ast.Ast, source: str, obs: *T,
    action: fun(*T, ast_id.ExprId, *ast_expr.Expr) res[GateNodeVerdict, fail.Fail],
    expression: fun(*T, *ast.Ast, ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail],
    eid: ast_id.ExprId) res[bool, fail.Fail] {
    ret gate_depends_on[T](a, source, obs, gate_node_action_probes[T](action, expression), GATE_PROBE_NODE_ACTION, eid);
}

pub fun gate_chain_depends_on[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    branches_start: u32, branches_len: u32) res[bool, fail.Fail] {
    var bi: u32 = 0;
    for (bi < branches_len) {
        val branch_ix: u32 = branches_start + bi;
        if (branch_ix::usize >= a.comptime_branches.len) {
            ret res[bool, fail.Fail].err{fail.message("comptime branch index out of range in the dependency visitor")};
        }
        val br: *ast_decl.ComptimeBranch = ?a.comptime_branches.data[branch_ix];
        if (!ast_id.expr_is_nil(br.cond)) {
            val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, br.cond);
            if (sel depends_r.err) { ret depends_r; }
            if (depends_r.ok)      { ret depends_r; }
        }
        bi = bi + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

pub def GateScope: u8;

pub val GATE_SCOPE_DECL:     GateScope = 0;
pub val GATE_SCOPE_INSTANCE: GateScope = 1;

val GATE_U8_MSG: str =
    "comptime branch condition must have type u8";

val GATE_U8_FLOAT_MSG: str =
    "comptime branch condition must have type u8, found float";

val GATE_U8_STR_MSG: str =
    "comptime branch condition must have type u8, found str";

pub rec GateVerdict {
    outcome: GateOutcome;
    fail:    comptime_failure.EvalFailKind;
    diag:    diagnostic_kind.Kind;
    message: str;
    span:    lang_source.Span;
    depends: intern.StrId;
    value:   comptime_value.CTValue;
}

# what a failed gate says when the name it waits on is a constant nowhere the
# module can see, which the caller frees
pub fun never_decided_message(a: *A.Allocator, itn: *intern.Interner, depends: intern.StrId) res[str, fail.Fail] {
    val name: opt[str] = intern.get(itn, depends);
    if (sel name.none) { ret res[str, fail.Fail].err{fail.message("a gate waits on a name the interner does not hold")}; }
    ret diagnostic.format(a, "this `$if` gate is never decided: `{}` is not a compile-time constant anywhere this module can see", name.some);
}

fun gate_verdict(outcome: GateOutcome, diag: diagnostic_kind.Kind, message: str, span: lang_source.Span, depends: intern.StrId) GateVerdict {
    var v: GateVerdict;
    v.outcome         = outcome;
    v.fail            = comptime_failure.EVAL_FAIL_NONE;
    v.diag            = diag;
    v.message         = message;
    v.span            = span;
    v.depends         = depends;
    v.value.kind      = comptime_value.CT_KIND_INT;
    v.value.int_width = 0;
    v.value.data.w    = wide.zero();
    ret v;
}

# a verdict that reports nothing, so it names no diagnostic kind
fun gate_verdict_quiet(outcome: GateOutcome, span: lang_source.Span) GateVerdict {
    ret gate_verdict(outcome, diagnostic_kind.NONE, "", span, intern.STR_NIL);
}

fun gate_verdict_valued(outcome: GateOutcome, span: lang_source.Span, value: comptime_value.CTValue) GateVerdict {
    var v: GateVerdict = gate_verdict_quiet(outcome, span);
    v.value = value;
    ret v;
}

fun gate_failure_awaits_phase[T](cap_ctx: *T, caps: comptime_capability.PhaseCapabilities[T], kind: comptime_failure.EvalFailKind) bool {
    if (kind == comptime_failure.EVAL_FAIL_NEEDS_MEMBER) {
        ret !comptime_capability.capabilities_have_member[T](cap_ctx, caps);
    }
    if (kind == comptime_failure.EVAL_FAIL_NEEDS_TYPES || kind == comptime_failure.EVAL_FAIL_NEEDS_LAYOUT) {
        ret !comptime_capability.capabilities_have_types[T](cap_ctx, caps);
    }
    ret false;
}

fun gate_verdict_failed(outcome: GateOutcome, f: comptime_failure.EvalFail, span: lang_source.Span, depends: intern.StrId) GateVerdict {
    var v: GateVerdict = gate_verdict(outcome, f.diag, f.message, span, depends);
    v.fail = f.kind;
    ret v;
}

fun gate_u8_message(v: comptime_value.CTValue) str {
    if (v.kind == comptime_value.CT_KIND_FLOAT) { ret GATE_U8_FLOAT_MSG; }
    if (v.kind == comptime_value.CT_KIND_STR)   { ret GATE_U8_STR_MSG; }
    ret GATE_U8_MSG;
}

rec GateNameProbe[T] {
    cap_ctx:  *T;
    caps:     comptime_capability.PhaseCapabilities[T];
    c:        *comptime_scope.ComptimeCtx;
    source:   str;
    interner: *intern.Interner;
    found:    intern.StrId;
}

fun gate_name_probe_node[T](g: *GateNameProbe[T], eid: ast_id.ExprId, e: *ast_expr.Expr) res[GateNodeVerdict, fail.Fail] {
    if (!intern.str_is_nil(g.found))        { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_PRUNE}; }
    if (e.kind != ast_expr.EXPR_KIND_IDENT) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
    val r: res[intern.StrId, A.Error] = intern.range_add(g.interner, g.source, e.data.ident.tok.offset, e.data.ident.tok.len);
    if (sel r.err) { ret res[GateNodeVerdict, fail.Fail].err{fail.refused(r.err)}; }
    val name:  intern.StrId                   = r.ok;
    val bound: opt[comptime_scope.NamedConst] = comptime_scope.lookup(g.c, name);
    if (sel bound.some) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
    g.found = name;
    ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_PRUNE};
}

fun gate_name_expression[T](g: *GateNameProbe[T], a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    ret comptime_capability.read_expression[T](g.cap_ctx, g.caps, a, eid);
}

fun gate_unresolved_dependency[T](c: *comptime_scope.ComptimeCtx, cap_ctx: *T, caps: comptime_capability.PhaseCapabilities[T],
    a: *ast.Ast, source: str, interner: *intern.Interner, cond: ast_id.ExprId) res[intern.StrId, fail.Fail] {
    if (c == nil || interner == nil) { ret res[intern.StrId, fail.Fail].err{fail.message("gate dependency name has no active context")}; }
    var g: GateNameProbe[T];
    g.cap_ctx  = cap_ctx;
    g.caps     = caps;
    g.c        = c;
    g.source   = source;
    g.interner = interner;
    g.found    = intern.STR_NIL;
    val matched_r: res[bool, fail.Fail] = gate_walk[GateNameProbe[T]](a, source, ?g,
        gate_name_probe_node[T], gate_name_expression[T], cond);
    if (sel matched_r.err) { ret res[intern.StrId, fail.Fail].err{matched_r.err}; }
    ret res[intern.StrId, fail.Fail].ok{g.found};
}

pub fun evaluate_gate[T](
    c: *comptime_scope.ComptimeCtx,
    cap_ctx: *T,
    caps: comptime_capability.PhaseCapabilities[T],
    a: *ast.Ast,
    source: str,
    cond: ast_id.ExprId,
    interner: *intern.Interner,
    scope: GateScope,
    cache: bool) res[GateVerdict, fail.Fail] {
    var nil_span: lang_source.Span;
    nil_span.offset = 0;
    nil_span.len    = 0;
    if (ast_id.expr_is_nil(cond)) {
        ret res[GateVerdict, fail.Fail].ok{gate_verdict_quiet(GATE_ACTIVE, nil_span)};
    }
    val e_opt: opt[*ast_expr.Expr] = ast.get_expr(a, cond);
    if (!sel e_opt.some) {
        ret res[GateVerdict, fail.Fail].err{fail.message("comptime branch cond ExprId out of range")};
    }
    val span: lang_source.Span = e_opt.some.span;

    val cacheable: bool = cache;
    if (cacheable) {
        val cached: comptime_scope.GateState = comptime_scope.gate_state(c, cond);
        if (cached == comptime_scope.GATE_STATE_TRUE) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_quiet(GATE_ACTIVE, span)};
        }
        if (cached == comptime_scope.GATE_STATE_FALSE) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_quiet(GATE_INACTIVE, span)};
        }
        if (cached == comptime_scope.GATE_STATE_REJECTED) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_quiet(GATE_REJECTED, span)};
        }
    }
    or (comptime_scope.gate_state(c, cond) == comptime_scope.GATE_STATE_REJECTED) {
        ret res[GateVerdict, fail.Fail].ok{gate_verdict_quiet(GATE_REJECTED, span)};
    }

    val r: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime.evaluate[T](c, cap_ctx, caps, a, source, cond, interner);
    if (sel r.err) {
        val f: comptime_failure.EvalFail = r.err;
        if (f.kind == comptime_failure.EVAL_FAIL_INTERNAL) { ret res[GateVerdict, fail.Fail].err{fail.message(f.message)}; }
        if (f.kind == comptime_failure.EVAL_FAIL_NOT_INTEGER) {
            if (cacheable) { comptime_scope.set_gate_state(c, cond, comptime_scope.GATE_STATE_REJECTED); }
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_REJECTED, f, span, intern.STR_NIL)};
        }
        if (f.kind == comptime_failure.EVAL_FAIL_NEEDS_INSTANCE) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_AWAITING_INSTANCE, f, span, intern.STR_NIL)};
        }
        # a typed phase is the last to bind constants, so what it cannot read stays unread
        if (scope == GATE_SCOPE_INSTANCE && gate_eval_failure_is_transient(f.kind) && !comptime_capability.capabilities_have_types[T](cap_ctx, caps)) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_AWAITING_PHASE, f, span, intern.STR_NIL)};
        }
        if (gate_failure_awaits_phase[T](cap_ctx, caps, f.kind)) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_AWAITING_PHASE, f, span, intern.STR_NIL)};
        }
        # only an unbound name is waited on: any other failure says its own cause
        if (f.kind != comptime_failure.EVAL_FAIL_UNBOUND) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_FAILED, f, span, intern.STR_NIL)};
        }
        val depends_r: res[intern.StrId, fail.Fail] = gate_unresolved_dependency[T](c, cap_ctx, caps, a, source, interner, cond);
        if (sel depends_r.err) { ret res[GateVerdict, fail.Fail].err{depends_r.err}; }
        ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_FAILED, f, span, depends_r.ok)};
    }

    val v: comptime_value.CTValue = r.ok;
    if (v.kind != comptime_value.CT_KIND_INT || (v.int_width != 0 && !comptime_value.is_u8(v))) {
        if (cacheable) { comptime_scope.set_gate_state(c, cond, comptime_scope.GATE_STATE_REJECTED); }
        var rej: GateVerdict = gate_verdict(GATE_REJECTED, diagnostic_kind.GATE_NOT_U8, gate_u8_message(v), span, intern.STR_NIL);
        rej.value = v;
        ret res[GateVerdict, fail.Fail].ok{rej};
    }
    # an untyped value is a u8 only where type checking has typed the condition as one
    if (v.int_width == 0 && !comptime_capability.capabilities_have_types[T](cap_ctx, caps)) {
        if (scope == GATE_SCOPE_INSTANCE) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_valued(GATE_AWAITING_PHASE, span, v)};
        }
        if (cacheable) { comptime_scope.set_gate_state(c, cond, comptime_scope.GATE_STATE_REJECTED); }
        var untyped: GateVerdict = gate_verdict(GATE_REJECTED, diagnostic_kind.GATE_NOT_U8, GATE_U8_MSG, span, intern.STR_NIL);
        untyped.value = v;
        ret res[GateVerdict, fail.Fail].ok{untyped};
    }
    if (comptime_value.truth(v)) {
        if (cacheable) { comptime_scope.set_gate_state(c, cond, comptime_scope.GATE_STATE_TRUE); }
        ret res[GateVerdict, fail.Fail].ok{gate_verdict_quiet(GATE_ACTIVE, span)};
    }
    if (cacheable) { comptime_scope.set_gate_state(c, cond, comptime_scope.GATE_STATE_FALSE); }
    ret res[GateVerdict, fail.Fail].ok{gate_verdict_quiet(GATE_INACTIVE, span)};
}

pub fun gate_chain_defers[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T],
    branches_start: u32, branches_len: u32) res[bool, fail.Fail] {
    var pi: u32 = 0;
    for (pi < GATE_PROBE_COUNT) {
        val depends_r: res[bool, fail.Fail] = gate_chain_depends_on[T](a, source, obs, probes, pi::GateProbe, branches_start, branches_len);
        if (sel depends_r.err) { ret depends_r; }
        if (depends_r.ok)      { ret depends_r; }
        pi = pi + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

pub fun gate_depends_on[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe, eid: ast_id.ExprId) res[bool, fail.Fail] {
    if (ast_id.expr_is_nil(eid))  { ret res[bool, fail.Fail].ok{false}; }
    if (probes.expression == nil) { ret res[bool, fail.Fail].err{fail.message("gate dependency visitor has no expression reader")}; }
    val e_opt: res[ast_expr.Expr, comptime_failure.EvalFail] = probes.expression(obs, a, eid);
    if (sel e_opt.err) {
        ret res[bool, fail.Fail].err{fail.message(e_opt.err.message)};
    }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;

    val here: res[GateNodeVerdict, fail.Fail] = gate_probe_node[T](a, source, obs, probes, probe, eid, e);
    if (sel here.err) {
        ret res[bool, fail.Fail].err{here.err};
    }
    val verdict: GateNodeVerdict = here.ok;
    if (verdict == GATE_NODE_YES)   { ret res[bool, fail.Fail].ok{true}; }
    if (verdict == GATE_NODE_PRUNE) { ret res[bool, fail.Fail].ok{false}; }

    ret gate_depends_on_children[T](a, source, obs, probes, probe, e);
}

fun gate_probe_node[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    eid: ast_id.ExprId, e: *ast_expr.Expr) res[GateNodeVerdict, fail.Fail] {
    if (probe == GATE_PROBE_COMPTIME_PARAM) {
        if (e.kind != ast_expr.EXPR_KIND_IDENT) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
        if (probes.comptime_param == nil)       { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(probes.comptime_param(obs, eid))};
    }
    if (probe == GATE_PROBE_EACH_LOOPVAR) {
        if (e.kind != ast_expr.EXPR_KIND_IDENT) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
        if (probes.each_loopvar == nil)         { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(probes.each_loopvar(obs, eid))};
    }
    if (probe == GATE_PROBE_FIELD_DESCRIPTOR) {
        if (!intrinsic.is_field_descriptor_member(a, source, eid)) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
        if (probes.field_loopvar == nil)                           { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(probes.field_loopvar(obs, eid))};
    }
    if (probe == GATE_PROBE_LAYOUT_INTRINSIC) {
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(intrinsic.is_layout_intrinsic_call(a, source, eid))};
    }
    if (probe == GATE_PROBE_TYPE_COMPARISON) {
        if (e.kind == ast_expr.EXPR_KIND_BINARY
            && (e.data.binary.op == ast_expr.BIN_EQ || e.data.binary.op == ast_expr.BIN_NEQ)) {
            if (intrinsic.is_type_comparison(a, source, ?e.data.binary)) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_YES}; }
            if (probes.field_type_operand == nil)                        { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
            val lhs: res[bool, fail.Fail] = probes.field_type_operand(obs, e.data.binary.lhs);
            if (sel lhs.err) { ret res[GateNodeVerdict, fail.Fail].err{lhs.err}; }
            if (lhs.ok)      { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_YES}; }
            val rhs: res[bool, fail.Fail] = probes.field_type_operand(obs, e.data.binary.rhs);
            if (sel rhs.err) { ret res[GateNodeVerdict, fail.Fail].err{rhs.err}; }
            ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(rhs.ok)};
        }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(intrinsic.is_type_query_call(a, source, eid))};
    }
    if (probe == GATE_PROBE_NODE_ACTION) {
        if (probes.node_action == nil) { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret probes.node_action(obs, eid, e);
    }
    ret res[GateNodeVerdict, fail.Fail].err{fail.message("internal: unknown compile-time dependency probe")};
}

fun gate_node_if(matched: bool) GateNodeVerdict {
    if (matched) { ret GATE_NODE_YES; }
    ret GATE_NODE_NO;
}

fun gate_depends_on_children[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe, e: *ast_expr.Expr) res[bool, fail.Fail] {
    val k: ast_expr.ExprKind = e.kind;

    if (k == ast_expr.EXPR_KIND_BINARY) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.binary.lhs, e.data.binary.rhs);
    }
    if (k == ast_expr.EXPR_KIND_UNARY) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.unary.operand);
    }
    if (k == ast_expr.EXPR_KIND_SEL) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.sel.place, e.data.sel.case_desc);
    }
    if (k == ast_expr.EXPR_KIND_CALL || k == ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        val depends_r: res[bool, fail.Fail] = gate_depends_on_pair[T](a, source, obs, probes, probe,
            e.data.call.callee, e.data.call.index_callee);
        if (sel depends_r.err) { ret depends_r; }
        if (depends_r.ok)      { ret depends_r; }
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.call.args_start, e.data.call.args_len);
    }
    if (k == ast_expr.EXPR_KIND_INDEX) {
        val depends_r: res[bool, fail.Fail] = gate_depends_on_pair[T](a, source, obs, probes, probe,
            e.data.index.object, e.data.index.index);
        if (sel depends_r.err) { ret depends_r; }
        if (depends_r.ok)      { ret depends_r; }
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.index.count);
    }
    if (k == ast_expr.EXPR_KIND_MEMBER) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.member.object);
    }
    if (k == ast_expr.EXPR_KIND_PROJECT) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.project.object, e.data.project.field);
    }
    if (k == ast_expr.EXPR_KIND_CAST) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.cast.value);
    }
    if (k == ast_expr.EXPR_KIND_STRIP) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.strip.value);
    }
    if (k == ast_expr.EXPR_KIND_SPREAD) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.spread.inner);
    }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT) {
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.array_lit.elems_start, e.data.array_lit.elems_len);
    }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT) {
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len);
    }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT) {
        var fi: u32 = 0;
        for (fi < e.data.struct_lit.fields_len) {
            val pool_ix: u32 = e.data.struct_lit.fields_start + fi;
            if (pool_ix::usize >= a.field_inits.len) {
                ret res[bool, fail.Fail].err{fail.message("struct literal field index out of range in the dependency visitor")};
            }
            val finit:     *ast_expr.FieldInit  = ?a.field_inits.data[pool_ix];
            val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, finit.value);
            if (sel depends_r.err) { ret depends_r; }
            if (depends_r.ok)      { ret depends_r; }
            fi = fi + 1;
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (gate_expr_kind_is_leaf(k)) { ret res[bool, fail.Fail].ok{false}; }

    ret res[bool, fail.Fail].err{fail.message(GATE_PROBE_UNLISTED_KIND_MSG)};
}

fun gate_expr_kind_is_leaf(k: ast_expr.ExprKind) bool {
    ret k == ast_expr.EXPR_KIND_IDENT || k == ast_expr.EXPR_KIND_LIT_INT
        || k == ast_expr.EXPR_KIND_LIT_FLOAT || k == ast_expr.EXPR_KIND_LIT_CHAR
        || k == ast_expr.EXPR_KIND_LIT_STR || k == ast_expr.EXPR_KIND_LIT_NIL
        || k == ast_expr.EXPR_KIND_COMPTIME_IDENT
        || k == ast_expr.EXPR_KIND_TYPE_REF || k == ast_expr.EXPR_KIND_ERROR;
}

fun gate_depends_on_pair[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    first: ast_id.ExprId, second: ast_id.ExprId) res[bool, fail.Fail] {
    val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, first);
    if (sel depends_r.err) { ret depends_r; }
    if (depends_r.ok)      { ret depends_r; }
    ret gate_depends_on[T](a, source, obs, probes, probe, second);
}

fun gate_depends_on_list[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    start: u32, len: u32) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= a.expr_ids.len) {
            ret res[bool, fail.Fail].err{fail.message("expression list index out of range in the dependency visitor")};
        }
        val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, a.expr_ids.data[pool_ix]);
        if (sel depends_r.err) { ret depends_r; }
        if (depends_r.ok)      { ret depends_r; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

rec TypeQuestionProbe {
    a:      *ast.Ast;
    source: str;
    found:  ast_id.ExprId;
}

fun type_question_node(q: *TypeQuestionProbe, eid: ast_id.ExprId, e: *ast_expr.Expr) res[GateNodeVerdict, fail.Fail] {
    if (!ast_id.expr_is_nil(q.found))                         { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_PRUNE}; }
    if (!intrinsic.is_type_question_call(q.a, q.source, eid)) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
    q.found = eid;
    ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_PRUNE};
}

# the first call in an expression that asks a type question, EXPR_NIL when none does
pub fun type_question(a: *ast.Ast, source: str, eid: ast_id.ExprId) res[ast_id.ExprId, fail.Fail] {
    var q:      TypeQuestionProbe    = TypeQuestionProbe{a: a, source: source, found: ast_id.EXPR_NIL};
    val walked: res[bool, fail.Fail] = gate_walk[TypeQuestionProbe](a, source, ?q, type_question_node, comptime_capability.parsed_expression[TypeQuestionProbe], eid);
    if (sel walked.err) { ret res[ast_id.ExprId, fail.Fail].err{walked.err}; }
    ret res[ast_id.ExprId, fail.Fail].ok{q.found};
}

# a declaring gate may not ask a type question; `through` names the constants it asks it through,
# as ` through `T` -> `S``, or is empty when the gate asks it itself
pub fun type_question_message(interner: *intern.Interner, a: *ast.Ast, source: str, call: ast_id.ExprId, through: str) res[intern.StrId, fail.Fail] {
    val callee: lang_source.Span           = comptime_callee_span(a, call);
    val named:  res[intern.StrId, A.Error] = intern.range_add(interner, source, callee.offset, callee.len);
    if (sel named.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(named.err)}; }
    val text: opt[str] = intern.get(interner, named.ok);
    if (sel text.none) { ret res[intern.StrId, fail.Fail].err{fail.message("type question callee is not interned")}; }
    val msg_r: res[str, fail.Fail] = diagnostic.format(interner.a,
        "`{}` asks a type question{}, which is only comptime-evaluable after type checking: an arm of this `$if` declares something, so the gate selects DECLARATIONS and is decided during name resolution, before any type is known. a `$if` whose every arm declares nothing is decided during type checking and can ask one",
        text.some, through);
    if (sel msg_r.err) { ret res[intern.StrId, fail.Fail].err{msg_r.err}; }
    val interned: res[intern.StrId, A.Error] = intern.add(interner, msg_r.ok);
    str_free(interner.a, msg_r.ok);
    if (sel interned.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(interned.err)}; }
    ret res[intern.StrId, fail.Fail].ok{interned.ok};
}

# the spelling of the intrinsic a comptime call names, `$size_of` for `$size_of(T)`
fun comptime_callee_span(a: *ast.Ast, eid: ast_id.ExprId) lang_source.Span {
    var none: lang_source.Span;
    none.offset = 0;
    none.len    = 0;
    val n_opt: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret none; }
    val node: *ast_expr.Expr = n_opt.some;
    if (node.kind != ast_expr.EXPR_KIND_CALL) { ret none; }
    val ce_opt: opt[*ast_expr.Expr] = ast.get_expr(a, node.data.call.callee);
    if (!sel ce_opt.some) { ret none; }
    ret ce_opt.some.span;
}

test gate_depends_on__unlisted_expression_kind_fails_closed {
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var a: ast.Ast = ast.init(?alloc, lang_source.FILE_NIL);
    fin { ast.dnit(?a); }

    var lit: ast_expr.Expr;
    lit.kind                = ast_expr.EXPR_KIND_LIT_INT;
    lit.data.lit_int.value  = wide.from_u64(1);
    lit.data.lit_int.suffix = ast_expr.LIT_SUFFIX_NONE;
    val lit_r: res[ast_id.ExprId, fail.Fail] = ast.add_expr(?a, lit);
    if (sel lit_r.err) { ret 1; }

    var ident: ast_expr.Expr;
    ident.kind = ast_expr.EXPR_KIND_IDENT;
    val ident_r: res[ast_id.ExprId, fail.Fail] = ast.add_expr(?a, ident);
    if (sel ident_r.err) { ret 1; }

    var unlisted: ast_expr.Expr;
    unlisted.kind = 5::ast_expr.ExprKind;
    val un_r: res[ast_id.ExprId, fail.Fail] = ast.add_expr(?a, unlisted);
    if (sel un_r.err) { ret 1; }

    var nested: ast_expr.Expr;
    nested.kind               = ast_expr.EXPR_KIND_UNARY;
    nested.data.unary.op      = ast_expr.UN_NOT;
    nested.data.unary.operand = un_r.ok;
    val nest_r: res[ast_id.ExprId, fail.Fail] = ast.add_expr(?a, nested);
    if (sel nest_r.err) { ret 1; }

    val probes: GateProbes[comptime_capability.NoCapabilityContext] = gate_probes[comptime_capability.NoCapabilityContext](nil, nil, nil, nil, comptime_capability.parsed_expression[comptime_capability.NoCapabilityContext]);
    var bad:    i32                                                 = 0;

    val listed: res[bool, fail.Fail] = gate_depends_on[comptime_capability.NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, lit_r.ok);
    if (sel listed.err) { bad = 1; }
    or (sel listed.ok) {
        if (listed.ok) { bad = 1; }
    }

    val closed: res[bool, fail.Fail] = gate_depends_on[comptime_capability.NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, nest_r.ok);
    if (sel closed.ok) { bad = 2; }
    or (sel closed.err) {
        if (!str_equals(fail.describe(closed.err), GATE_PROBE_UNLISTED_KIND_MSG)) { bad = 3; }
    }

    val no_obs: res[bool, fail.Fail] = gate_depends_on[comptime_capability.NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_COMPTIME_PARAM, ident_r.ok);
    if (sel no_obs.ok) { bad = 4; }
    or (sel no_obs.err) {
        if (!str_equals(fail.describe(no_obs.err), GATE_PROBE_NO_OBSERVER_MSG)) { bad = 5; }
    }

    val out_of_range: res[bool, fail.Fail] = gate_depends_on[comptime_capability.NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, ast_id.expr(99));
    if (sel out_of_range.ok) { bad = 6; }

    ret bad;
}

#[testing]
fun t_gate_choice_action(f: *comptime.GateChoiceFixture, eid: ast_id.ExprId, e: *ast_expr.Expr) res[GateNodeVerdict, fail.Fail] {
    ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(ast_id.expr_same(eid, ast_id.expr(1)))};
}

test gate_depends_on__resolved_brackets_visit_only_the_selected_expression {
    var nodes: [4]ast_expr.Expr;
    nodes[0].kind                      = ast_expr.EXPR_KIND_IDENT;
    nodes[1].kind                      = ast_expr.EXPR_KIND_IDENT;
    nodes[2].kind                      = ast_expr.EXPR_KIND_INDEX;
    nodes[2].data.index.object         = ast_id.expr(0);
    nodes[2].data.index.index          = ast_id.expr(1);
    nodes[2].data.index.count          = ast_id.EXPR_NIL;
    nodes[3].kind                      = ast_expr.EXPR_KIND_CALL;
    nodes[3].data.call.callee          = ast_id.expr(0);
    nodes[3].data.call.index_callee    = ast_id.expr(2);
    nodes[3].data.call.args_start      = 0;
    nodes[3].data.call.args_len        = 0;
    nodes[3].data.call.type_args_start = 0;
    nodes[3].data.call.type_args_len   = 1;
    var a: ast.Ast;
    a.exprs = ast.table_over[ast_expr.Expr](?nodes[0], 4);
    var choices: [4]interpretation.Choice;
    choices[0] = interpretation.PARSED;
    choices[1] = interpretation.PARSED;
    choices[2] = interpretation.PARSED;
    choices[3] = interpretation.GENERIC;
    var f: comptime.GateChoiceFixture;
    f.choices = ?choices[0];
    f.count   = 4;
    val generic: res[bool, fail.Fail] = gate_walk[comptime.GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, comptime.t_gate_choice_expression, ast_id.expr(3));
    if (sel generic.err) { ret 1; }
    if (generic.ok)      { ret 1; }
    choices[3] = interpretation.INDEX_CALL;
    val indexed: res[bool, fail.Fail] = gate_walk[comptime.GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, comptime.t_gate_choice_expression, ast_id.expr(3));
    if (sel indexed.err)                                                                                                                                                             { ret 2; }
    if (!indexed.ok)                                                                                                                                                                 { ret 2; }
    if (!ast_id.expr_same(nodes[3].data.call.callee, ast_id.expr(0)) || !ast_id.expr_same(nodes[3].data.call.index_callee, ast_id.expr(2)) || nodes[3].data.call.type_args_len != 1) { ret 3; }
    val missing: res[bool, fail.Fail] = gate_walk[comptime.GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, nil, ast_id.expr(3));
    if (sel missing.ok) { ret 4; }
    f.count = 3;
    val wrong_owner: res[bool, fail.Fail] = gate_walk[comptime.GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, comptime.t_gate_choice_expression, ast_id.expr(3));
    if (sel wrong_owner.ok) { ret 5; }
    ret 0;
}

test gate_unresolved_dependency__allocation_refusal_is_not_an_absent_name {
    var tracked: T.Testing;
    val make_1:  err[A.Error] = T.make(?tracked);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?tracked); }
    val alloc: *A.Allocator               = T.allocator_of(?tracked);
    var itn:   intern.Interner            = intern.init(alloc);
    var c:     comptime_scope.ComptimeCtx = comptime_scope.init(alloc, resolved.facts_none(), comptime_scope.build_facts(0, 0, intern.STR_NIL, intern.STR_NIL));
    var node:  ast_expr.Expr;
    node.kind           = ast_expr.EXPR_KIND_IDENT;
    node.span.offset    = 0;
    node.span.len       = 7;
    node.data.ident.tok = node.span;
    var a: ast.Ast;
    a.exprs = ast.table_over[ast_expr.Expr](?node, 1);
    val caps: comptime_capability.PhaseCapabilities[comptime_capability.NoCapabilityContext] = comptime_capability.no_capabilities();
    T.fail_at_ordinal(?tracked, 1);
    val refused: res[intern.StrId, fail.Fail] = gate_unresolved_dependency[comptime_capability.NoCapabilityContext](
        ?c, nil, caps, ?a, "missing", ?itn, ast_id.expr(0));
    var bad: i32 = 0;
    if (sel refused.ok) { bad = 2; }
    or (sel refused.err) {
        if (!str_equals(fail.describe(refused.err), "out of memory")) { bad = 3; }
    }
    if (T.attempt_count(?tracked) != 1 || itn.len != 0) { bad = 4; }
    T.fail_at_ordinal(?tracked, 0);
    val found: res[intern.StrId, fail.Fail] = gate_unresolved_dependency[comptime_capability.NoCapabilityContext](
        ?c, nil, caps, ?a, "missing", ?itn, ast_id.expr(0));
    if (sel found.err) { bad = 5; }
    or (sel found.ok) {
        val name: opt[str] = intern.get(?itn, found.ok);
        if (sel name.some) {
            if (!str_equals(name.some, "missing")) { bad = 6; }
        }
        if (sel name.none) { bad = 6; }
    }
    comptime_scope.dnit(?c);
    intern.dnit(?itn);
    if (T.leaked(?tracked) || T.double_free_count(?tracked) != 0) { bad = 7; }
    ret bad;
}
