use std.allocator.arena;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use T: std.allocator.testing;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.fe.ast;
use mach.lang.fe.ast.id;
use mach.lang.fe.doclint;
use mach.lang.fe.lexer;
use mach.lang.fe.parser.decl;
use mach.lang.fe.parser.state;
use src: mach.lang.source;
use mach.lang.validation;

pub fun parse(tokens: *lexer.TokenStream, out: *ast.Ast, diags: *diagnostic.DiagnosticStore) res[fail.PhaseStatus, state.ParseFail] {
    var txn: ast.Ast      = @out;
    var p:   state.Parser = state.make(tokens, ?txn, diags);
    state.probed_init(?p, txn.a);
    decl.parse_module(?p);
    state.probed_dnit(?p, txn.a);
    state.diag_dnit(?p, txn.a);

    if (p.fatal) {
        ast.dnit(?txn);
        var f: state.ParseFail;
        f.kind    = p.fatal_kind;
        f.message = p.fatal_message;
        ret res[fail.PhaseStatus, state.ParseFail].err{f};
    }

    val lint: err[fail.Fail] = doclint.lint_module(?txn, tokens.source, diags);
    if (sel lint.err) {
        ast.dnit(?txn);
        var f: state.ParseFail;
        f.kind    = state.PARSE_FAIL_DIAG;
        f.message = fail.describe(lint.err);
        ret res[fail.PhaseStatus, state.ParseFail].err{f};
    }
    @out = txn;
    ret res[fail.PhaseStatus, state.ParseFail].ok{p.status};
}

#[testing]
fun t_out_is_pristine(out: *ast.Ast) bool {
    ret out.module_len == 0 && out.expr_len == 0 && out.stmt_len == 0
        && out.decl_len == 0 && out.type_len == 0 && out.root_module == id.MODULE_NODE_NIL;
}

#[testing]
fun t_nested_source(alloc: *A.Allocator, opens: usize) opt[str] {
    val prefix: str               = "val x: i64 = ";
    val n:      usize             = str_len(prefix) + opens + 1 + opens + 2;
    val rb:     res[*u8, A.Error] = A.allocate[u8](alloc, n);
    if (sel rb.err) { ret opt[str].none{}; }
    val buf: *u8   = rb.ok;
    var at:  usize = 0;
    var i:   usize = 0;
    for (i < str_len(prefix)) {
        buf[at] = prefix[i]::u8;
        at      = at + 1;
        i       = i + 1;
    }
    i = 0;
    for (i < opens) {
        buf[at] = '('::u8;
        at      = at + 1;
        i       = i + 1;
    }
    buf[at] = '1'::u8;
    at      = at + 1;
    i       = 0;
    for (i < opens) {
        buf[at] = ')'::u8;
        at      = at + 1;
        i       = i + 1;
    }
    buf[at] = ';'::u8;
    at      = at + 1;
    buf[at] = 0;
    ret opt[str].some{buf::str};
}

#[testing]
fun t_parse_nesting(opens: usize, kind_out: *state.ParseFailKind) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val so: opt[str] = t_nested_source(?alloc, opens);
    if (!sel so.some) { ret -1; }
    val tr: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(so.some, ?alloc, 0::src.FileId);
    if (sel tr.err) { ret -1; }
    var stream: lexer.TokenStream                      = tr.ok;
    var out:    ast.Ast                                = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore             = diagnostic.store_init(?alloc);
    val r:      res[fail.PhaseStatus, state.ParseFail] = parse(?stream, ?out, ?diags);
    var code:   i32                                    = 0;
    if (sel r.err) {
        @kind_out = r.err.kind;
        code      = 1;
    }
    ret code;
}

test parse__nesting_past_the_limit_is_refused_rather_than_running_out_of_stack {
    # the declaration and its initializer are levels of their own, so the
    # deepest parenthesis run a value can carry is two short of the limit.
    val deepest: usize               = state.MAX_NEST_DEPTH - 2;
    var kind:    state.ParseFailKind = state.PARSE_FAIL_OOM;

    if (t_parse_nesting(deepest, ?kind) != 0)     { ret 1; }
    if (t_parse_nesting(deepest + 1, ?kind) != 1) { ret 2; }
    if (kind != state.PARSE_FAIL_DEPTH)           { ret 3; }
    if (t_parse_nesting(32768, ?kind) != 1)       { ret 4; }
    if (kind != state.PARSE_FAIL_DEPTH)           { ret 5; }
    ret 0;
}

#[testing]
fun t_publishes(source: str, accepted: bool) i32 {
    var alloc:  A.Allocator;
    val made_1: err[A.Error] = page.make(?alloc);
    if (sel made_1.err) { ret 1; }
    val tr: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(source, ?alloc, 0::src.FileId);
    if (sel tr.err) { ret 1; }
    var stream: lexer.TokenStream          = tr.ok;
    var out:    ast.Ast                    = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);

    val r:  res[fail.PhaseStatus, state.ParseFail] = parse(?stream, ?out, ?diags);
    var rc: i32                                    = 0;
    if (sel r.err)                                      { rc = 1; }
    or (sel r.ok && fail.is_accepted(r.ok) != accepted) { rc = 2; }
    or (out.root_module == id.MODULE_NODE_NIL)          { rc = 3; }
    or (diagnostic.has_errors(?diags) == accepted)      { rc = 4; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?out);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

# clean input and a recoverable syntax error both publish a structurally complete ast
test parse__publishes_a_complete_ast {
    if (t_publishes("val x: i64 = 1;", true) != 0) { ret 1; }
    if (t_publishes("val x: i64 = ;", false) != 0) { ret 2; }
    ret 0;
}

test parse__fatal_node_allocation_failure_leaves_out_untouched_and_reports_oom {
    var backing: A.Allocator;
    val made_4:  err[A.Error] = page.make(?backing);
    if (sel made_4.err) { ret 1; }
    var saw_fatal: bool = false;
    var ordinal:   u64  = 1;
    for (ordinal <= 64) {
        var failing: T.Testing;
        val make_1:  err[A.Error] = T.make(?failing);
        if (sel make_1.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        val tr: res[lexer.TokenStream, fail.Fail] = lexer.tokenize("val x: i64 = 1; fun f() i64 { ret x; }", ?backing, 0::src.FileId);
        if (sel tr.err) { ret 1; }
        var stream: lexer.TokenStream          = tr.ok;
        var out:    ast.Ast                    = ast.init(T.allocator_of(?failing), 0::src.FileId);
        var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?backing);

        val r:   res[fail.PhaseStatus, state.ParseFail] = parse(?stream, ?out, ?diags);
        var bad: bool                                   = false;
        if (sel r.err) {
            saw_fatal = true;
            val f: state.ParseFail = r.err;
            if (f.kind != state.PARSE_FAIL_OOM || !t_out_is_pristine(?out)) { bad = true; }
        }

        diagnostic.store_dnit(?diags);
        ast.dnit(?out);
        lexer.dnit(?stream, ?backing);
        if (bad) { ret 1; }
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!saw_fatal) { ret 1; }
    ret 0;
}

test parse__diagnostic_store_failure_escalates_to_fatal_and_leaves_out_untouched {
    var backing: A.Allocator;
    val made_5:  err[A.Error] = page.make(?backing);
    if (sel made_5.err) { ret 1; }
    var saw_fatal: bool = false;
    var ordinal:   u64  = 1;
    for (ordinal <= 32) {
        var failing: T.Testing;
        val make_1:  err[A.Error] = T.make(?failing);
        if (sel make_1.err) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        val tr: res[lexer.TokenStream, fail.Fail] = lexer.tokenize("val x: i64 = ;", ?backing, 0::src.FileId);
        if (sel tr.err) { ret 1; }
        var stream: lexer.TokenStream          = tr.ok;
        var out:    ast.Ast                    = ast.init(?backing, 0::src.FileId);
        var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(T.allocator_of(?failing));

        val r:   res[fail.PhaseStatus, state.ParseFail] = parse(?stream, ?out, ?diags);
        var bad: bool                                   = false;
        if (sel r.err) {
            saw_fatal = true;
            val f: state.ParseFail = r.err;
            if (f.kind != state.PARSE_FAIL_DIAG || !t_out_is_pristine(?out)) { bad = true; }
        }

        diagnostic.store_dnit(?diags);
        ast.dnit(?out);
        lexer.dnit(?stream, ?backing);
        if (bad) { ret 1; }
        if (T.tracking_exhausted(?failing)) {
            T.dnit(?failing);
            ret 1;
        }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) {
            T.dnit(?failing);
            ret 1;
        }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!saw_fatal) { ret 1; }
    ret 0;
}

test parse__depth_reason_outlives_reclaimed_parser_storage {
    var backing: A.Allocator;
    val make_1:  err[A.Error] = page.make(?backing);
    if (sel make_1.err) { ret 1; }
    var ar:     arena.Arena;
    val init_2: err[A.Error] = arena.init(?ar, ?backing, 0);
    if (sel init_2.err) { ret 2; }
    var live: bool = true;
    fin {
        if (live) { arena.dnit(?ar); }
    }
    var alloc:  A.Allocator;
    val make_3: err[A.Error] = arena.make(?alloc, ?ar);
    if (sel make_3.err) { ret 3; }
    val text: opt[str] = t_nested_source(?alloc, state.MAX_NEST_DEPTH + 1);
    if (!sel text.some) { ret 4; }
    val tr: res[lexer.TokenStream, fail.Fail] = lexer.tokenize(text.some, ?alloc, 1::src.FileId);
    if (sel tr.err) { ret 5; }
    var stream: lexer.TokenStream                      = tr.ok;
    var out:    ast.Ast                                = ast.init(?alloc, 1::src.FileId);
    var diags:  diagnostic.DiagnosticStore             = diagnostic.store_init(?alloc);
    val r:      res[fail.PhaseStatus, state.ParseFail] = parse(?stream, ?out, ?diags);
    if (sel r.ok) { ret 6; }
    val f: state.ParseFail = r.err;
    if (f.kind != state.PARSE_FAIL_DEPTH || !fail.is_reported(state.failure(f))) { ret 7; }
    arena.dnit(?ar);
    live = false;
    if (!str_equals(f.message, "input nests deeper than this parser descends")) { ret 8; }
    ret 0;
}
