use std.allocator.arena;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.string.str_len;

use std.types.size.usize;
use A: std.allocator;
use T: std.allocator.testing;
use O: std.types.option;
use R: std.types.result;

use mach.lang.diagnostic;
use mach.lang.fe.ast;
use mach.lang.fe.ast.id;
use mach.lang.fe.doclint;
use mach.lang.fe.lexer;
use mach.lang.fe.parser.decl;
use mach.lang.fe.parser.state;
use src: mach.lang.source;
use mach.lang.validation;

pub fun parse(tokens: *lexer.TokenStream, out: *ast.Ast, diags: *diagnostic.DiagnosticStore) R.Result[bool, state.ParseFail] {
    var txn: ast.Ast = @out;
    var p: state.Parser = state.make(tokens, ?txn, diags);
    state.probed_init(?p, txn.a);
    decl.parse_module(?p);
    state.probed_dnit(?p, txn.a);
    state.diag_dnit(?p, txn.a);

    if (p.fatal) {
        ast.dnit(?txn);
        var f: state.ParseFail;
        f.kind    = p.fatal_kind;
        f.message = p.fatal_message;
        ret R.err[bool, state.ParseFail](f);
    }

    doclint.lint_module(?txn, tokens.source, diags);
    @out = txn;
    ret R.ok[bool, state.ParseFail](true);
}

fun t_out_is_pristine(out: *ast.Ast) bool {
    ret out.module_len == 0 && out.expr_len == 0 && out.stmt_len == 0
     && out.decl_len == 0 && out.type_len == 0 && out.root_module == id.MODULE_NODE_NIL;
}

fun t_nested_source(alloc: *A.Allocator, opens: usize) O.Option[str] {
    val prefix: str = "val x: i64 = ";
    val n: usize = str_len(prefix) + opens + 1 + opens + 2;
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, n);
    if (R.is_err[*u8, str](rb)) { ret O.none[str](); }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    var at: usize = 0;
    var i: usize = 0;
    for (i < str_len(prefix)) { buf[at] = prefix[i]::u8; at = at + 1; i = i + 1; }
    i = 0;
    for (i < opens) { buf[at] = '('::u8; at = at + 1; i = i + 1; }
    buf[at] = '1'::u8; at = at + 1;
    i = 0;
    for (i < opens) { buf[at] = ')'::u8; at = at + 1; i = i + 1; }
    buf[at] = ';'::u8; at = at + 1;
    buf[at] = 0;
    ret O.some[str](buf::str);
}

fun t_parse_nesting(opens: usize, kind_out: *state.ParseFailKind) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val so: O.Option[str] = t_nested_source(?alloc, opens);
    if (!O.is_some[str](so)) { ret -1; }
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize(O.unwrap[str](so), ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret -1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var out:    ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    val r: R.Result[bool, state.ParseFail] = parse(?stream, ?out, ?diags);
    var code: i32 = 0;
    if (R.is_err[bool, state.ParseFail](r)) {
        @kind_out = R.unwrap_err[bool, state.ParseFail](r).kind;
        code = 1;
    }
    ret code;
}

fun t_bracket_chain(alloc: *A.Allocator, repeats: usize, closed: bool) O.Option[str] {
    val head: str = "fun main() i64 { val x = ";
    val tail: str = "; ret 0; }";
    var n: usize = str_len(head) + repeats * 2 + str_len(tail) + 2;
    if (closed) { n = n + repeats + 1; }
    val rb: R.Result[*u8, str] = A.allocate[u8](alloc, n);
    if (R.is_err[*u8, str](rb)) { ret O.none[str](); }
    val buf: *u8 = R.unwrap_ok[*u8, str](rb);
    var at: usize = 0;
    var i: usize = 0;
    for (i < str_len(head)) { buf[at] = head[i]::u8; at = at + 1; i = i + 1; }
    i = 0;
    for (i < repeats) {
        buf[at] = 'M'::u8; at = at + 1;
        buf[at] = '['::u8; at = at + 1;
        i = i + 1;
    }
    if (closed) {
        buf[at] = '1'::u8; at = at + 1;
        i = 0;
        for (i < repeats) { buf[at] = ']'::u8; at = at + 1; i = i + 1; }
    }
    i = 0;
    for (i < str_len(tail)) { buf[at] = tail[i]::u8; at = at + 1; i = i + 1; }
    buf[at] = 0;
    ret O.some[str](buf::str);
}

fun t_parses(source: str) bool {
    var backing: A.Allocator;
    page.make(?backing);
    var ar: arena.Arena;
    var alloc: A.Allocator;
    if (O.is_some[str](arena.init(?ar, ?backing, 0)))   { ret false; }
    if (O.is_some[str](arena.make(?alloc, ?ar)))        { arena.dnit(?ar); ret false; }
    fin { arena.dnit(?ar); }
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize(source, ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret false; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var out:    ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    val r: R.Result[bool, state.ParseFail] = parse(?stream, ?out, ?diags);
    ret !R.is_err[bool, state.ParseFail](r);
}

test "mach.lang.fe.parser.parse:a_bracket_chain_costs_no_more_than_its_square" {
    # `M[` after a name can open a generic argument list or an index expression.
    # the parser used to parse the payload as an expression, then as a type,
    # then again as whichever won, so each level doubled the one below and
    # thirty of these took minutes. each mode is parsed once now. a run this
    # deep finishing at all is the regression pin.
    var alloc: A.Allocator;
    page.make(?alloc);

    val closed: O.Option[str] = t_bracket_chain(?alloc, 30, true);
    if (!O.is_some[str](closed))       { ret 1; }
    if (!t_parses(O.unwrap[str](closed))) { ret 2; }

    val deeper: O.Option[str] = t_bracket_chain(?alloc, 120, true);
    if (!O.is_some[str](deeper))       { ret 4; }
    if (!t_parses(O.unwrap[str](deeper))) { ret 5; }

    # an unterminated chain wins with neither reading, so it is the one that
    # used to walk the payload twice per level. it costs what the closed one
    # costs now; restoring the second walk makes this stop finishing.
    val open_deep: O.Option[str] = t_bracket_chain(?alloc, 120, false);
    if (!O.is_some[str](open_deep))    { ret 6; }
    t_parses(O.unwrap[str](open_deep));
    ret 0;
}

test "mach.lang.fe.parser.parse:nesting_past_the_limit_is_refused_rather_than_running_out_of_stack" {
    # the declaration and its initializer are levels of their own, so the
    # deepest parenthesis run a value can carry is two short of the limit.
    val deepest: usize = state.MAX_NEST_DEPTH - 2;
    var kind: state.ParseFailKind = state.PARSE_FAIL_OOM;

    if (t_parse_nesting(deepest, ?kind) != 0)     { ret 1; }
    if (t_parse_nesting(deepest + 1, ?kind) != 1) { ret 2; }
    if (kind != state.PARSE_FAIL_DEPTH)           { ret 3; }
    if (t_parse_nesting(32768, ?kind) != 1)       { ret 4; }
    if (kind != state.PARSE_FAIL_DEPTH)           { ret 5; }
    ret 0;
}

test "mach.lang.fe.parser.parse:clean_input_publishes_a_complete_ast_atomically" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("val x: i64 = 1;", ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var out:    ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);

    val r: R.Result[bool, state.ParseFail] = parse(?stream, ?out, ?diags);
    var rc: i32 = 0;
    if (R.is_err[bool, state.ParseFail](r)) { rc = 1; }
    or (out.root_module == id.MODULE_NODE_NIL)   { rc = 1; }
    or (diagnostic.has_errors(?diags))      { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?out);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.parse:recoverable_syntax_error_still_publishes_a_structurally_complete_recovery_product" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("val x: i64 = ;", ?alloc, 0::src.FileId);
    if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
    var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
    var out:    ast.Ast           = ast.init(?alloc, 0::src.FileId);
    var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);

    val r: R.Result[bool, state.ParseFail] = parse(?stream, ?out, ?diags);
    var rc: i32 = 0;
    if (R.is_err[bool, state.ParseFail](r))  { rc = 1; }
    or (out.root_module == id.MODULE_NODE_NIL)    { rc = 1; }
    or (!diagnostic.has_errors(?diags))      { rc = 1; }

    diagnostic.store_dnit(?diags);
    ast.dnit(?out);
    lexer.dnit(?stream, ?alloc);
    ret rc;
}

test "mach.lang.fe.parser.parse:fatal_node_allocation_failure_leaves_out_untouched_and_reports_oom" {
    var backing: A.Allocator;
    page.make(?backing);
    var saw_fatal: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 64) {
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("val x: i64 = 1; fun f() i64 { ret x; }", ?backing, 0::src.FileId);
        if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
        var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
        var out:    ast.Ast           = ast.init(T.allocator_of(?failing), 0::src.FileId);
        var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(?backing);

        val r: R.Result[bool, state.ParseFail] = parse(?stream, ?out, ?diags);
        var bad: bool = false;
        if (R.is_err[bool, state.ParseFail](r)) {
            saw_fatal = true;
            val f: state.ParseFail = R.unwrap_err[bool, state.ParseFail](r);
            if (f.kind != state.PARSE_FAIL_OOM || !t_out_is_pristine(?out)) { bad = true; }
        }

        diagnostic.store_dnit(?diags);
        ast.dnit(?out);
        lexer.dnit(?stream, ?backing);
        if (bad) { ret 1; }
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!saw_fatal) { ret 1; }
    ret 0;
}

test "mach.lang.fe.parser.parse:diagnostic_store_failure_escalates_to_fatal_and_leaves_out_untouched" {
    var backing: A.Allocator;
    page.make(?backing);
    var saw_fatal: bool = false;
    var ordinal: u64 = 1;
    for (ordinal <= 32) {
        var failing: T.Testing;
        if (O.is_some[str](T.make(?failing))) { ret 1; }
        T.fail_at_ordinal(?failing, ordinal::usize);

        val tr: R.Result[lexer.TokenStream, str] = lexer.tokenize("val x: i64 = ;", ?backing, 0::src.FileId);
        if (R.is_err[lexer.TokenStream, str](tr)) { ret 1; }
        var stream: lexer.TokenStream = R.unwrap_ok[lexer.TokenStream, str](tr);
        var out:    ast.Ast           = ast.init(?backing, 0::src.FileId);
        var diags:  diagnostic.DiagnosticStore = diagnostic.store_init(T.allocator_of(?failing));

        val r: R.Result[bool, state.ParseFail] = parse(?stream, ?out, ?diags);
        var bad: bool = false;
        if (R.is_err[bool, state.ParseFail](r)) {
            saw_fatal = true;
            val f: state.ParseFail = R.unwrap_err[bool, state.ParseFail](r);
            if (f.kind != state.PARSE_FAIL_DIAG || !t_out_is_pristine(?out)) { bad = true; }
        }

        diagnostic.store_dnit(?diags);
        ast.dnit(?out);
        lexer.dnit(?stream, ?backing);
        if (bad) { ret 1; }
        if (T.tracking_exhausted(?failing)) { T.dnit(?failing); ret 1; }
        if (T.leaked(?failing) || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
        T.dnit(?failing);
        ordinal = ordinal + 1;
    }
    if (!saw_fatal) { ret 1; }
    ret 0;
}
