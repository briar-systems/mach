use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use std.types.error.err;
use std.types.result.res;

use mach.lang.diagnostic;
use mach.lang.fail;
use mach.lang.fe.ast;
use mach.lang.fe.doclint;
use fe_lexer: mach.lang.fe.lexer;
use mach.lang.fe.parser.grammar;
use mach.lang.fe.parser.state;
use lang_phase: mach.lang.phase;

pub fun parse(tokens: *fe_lexer.TokenStream, out: *ast.Ast, diags: *diagnostic.DiagnosticStore) res[lang_phase.PhaseStatus, state.ParseFail] {
    var txn: ast.Ast      = @out;
    var p:   state.Parser = state.make(tokens, ?txn, diags);

    var handed: bool = false;
    fin {
        if (!handed) { ast.dnit(?txn); }
    }
    state.probed_init(?p, txn.a);
    grammar.parse_module(?p);
    state.probed_dnit(?p, txn.a);
    state.diag_dnit(?p, txn.a);

    if (p.fatal) {
        var f: state.ParseFail;
        f.kind    = p.fatal_kind;
        f.message = p.fatal_message;
        ret res[lang_phase.PhaseStatus, state.ParseFail].err{f};
    }

    val lint: err[fail.Fail] = doclint.lint_module(?txn, tokens.source, diags);
    if (sel lint.err) {
        var f: state.ParseFail;
        f.kind    = state.PARSE_FAIL_DIAG;
        f.message = fail.describe(lint.err);
        ret res[lang_phase.PhaseStatus, state.ParseFail].err{f};
    }
    @out   = txn;
    handed = true;
    ret res[lang_phase.PhaseStatus, state.ParseFail].ok{p.status};
}
