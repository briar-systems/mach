use std.allocator.page;
use std.types.size.usize;
use std.types.string.str;

use mach.lang.layout;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

pub fun grow[T](a: *A.Allocator, data: *T, cap: usize, seed: usize, out_cap: *usize) R.Result[*T, str] {
    var new_cap: usize = seed;
    if (cap != 0) {
        val doubled: R.Result[layout.CheckedCount[T], layout.CheckCause] =
            layout.count_mul[T](layout.count[T](cap), 2::usize);
        if (R.is_err[layout.CheckedCount[T], layout.CheckCause](doubled)) {
            ret R.err[*T, str]("pool: growth capacity overflow");
        }
        new_cap = R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](doubled).value;
    }

    var res_buf: R.Result[*T, str];
    if (data == nil) {
        res_buf = A.allocate[T](a, new_cap);
    }
    or {
        res_buf = A.reallocate[T](a, data, cap, new_cap);
    }
    if (R.is_err[*T, str](res_buf)) {
        ret R.err[*T, str](R.unwrap_err[*T, str](res_buf));
    }

    @out_cap = new_cap;
    ret R.ok[*T, str](R.unwrap_ok[*T, str](res_buf));
}

test "mach.lang.fe.pool.grow:seed" {
    var a: A.Allocator;
    page.make(?a);

    var cap1: usize = 0;
    val res_buf1: R.Result[*u8, str] = grow[u8](?a, nil::*u8, 0, 16, ?cap1);
    if (R.is_err[*u8, str](res_buf1)) { ret 1; }
    if (cap1 != 16)                   { ret 1; }
    val ptr1: *u8 = R.unwrap_ok[*u8, str](res_buf1);
    A.deallocate[u8](?a, ptr1, 16);

    var cap2: usize = 0;
    val res_buf2: R.Result[*u8, str] = grow[u8](?a, nil::*u8, 0, 8, ?cap2);
    if (R.is_err[*u8, str](res_buf2)) { ret 1; }
    if (cap2 != 8)                    { ret 1; }
    val ptr2: *u8 = R.unwrap_ok[*u8, str](res_buf2);
    A.deallocate[u8](?a, ptr2, 8);

    ret 0;
}

test "mach.lang.fe.pool.grow:double" {
    var a: A.Allocator;
    page.make(?a);

    var cap1: usize = 0;
    val res_buf1: R.Result[*u8, str] = grow[u8](?a, nil::*u8, 0, 16, ?cap1);
    if (R.is_err[*u8, str](res_buf1)) { ret 1; }
    val ptr1: *u8 = R.unwrap_ok[*u8, str](res_buf1);

    var cap2: usize = 0;
    val res_buf2: R.Result[*u8, str] = grow[u8](?a, ptr1, 16, 16, ?cap2);
    if (R.is_err[*u8, str](res_buf2)) { ret 1; }
    if (cap2 != 32)                   { ret 1; }
    val ptr2: *u8 = R.unwrap_ok[*u8, str](res_buf2);
    A.deallocate[u8](?a, ptr2, 32);

    ret 0;
}

rec PoolGrowthProbe {
    reallocate_calls: u32;
}

fun pool_growth_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun pool_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val g: *PoolGrowthProbe = ctx::*PoolGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret O.none[ptr]();
}

fun pool_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.fe.pool.grow:refuses_capacity_overflow_before_reallocating" {
    var probe: PoolGrowthProbe;
    probe.reallocate_calls = 0;
    var pp: *PoolGrowthProbe = ?probe;
    var a: A.Allocator;
    a.ctx           = pp::ptr;
    a.fn_allocate   = pool_growth_probe_allocate;
    a.fn_reallocate = pool_growth_probe_reallocate;
    a.fn_deallocate = pool_growth_probe_deallocate;

    val huge_cap: usize = (~(0::usize) / 2) + 1;
    var dummy: u8;
    var out_cap: usize = 0;
    val res_buf: R.Result[*u8, str] = grow[u8](?a, ?dummy, huge_cap, 16, ?out_cap);

    var bad: i32 = 0;
    if (!R.is_err[*u8, str](res_buf))  { bad = 1; }
    if (probe.reallocate_calls != 0)   { bad = 2; }
    if (out_cap != 0)                  { bad = 3; }
    ret bad;
}
