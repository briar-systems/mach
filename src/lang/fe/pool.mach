use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.size.usize;

use mach.lang.layout;

use A: std.allocator;
use R: std.types.result;
use page: std.allocator.page;

pub fun grow[T](a: *A.Allocator, data: *T, cap: usize, seed: usize, out_cap: *usize) res[*T, A.Error] {
    var new_cap: usize = seed;
    if (cap != 0) {
        val doubled: R.Result[layout.CheckedCount[T], layout.CheckCause] =
            layout.count_mul[T](layout.count[T](cap), 2::usize);
        if (R.is_err[layout.CheckedCount[T], layout.CheckCause](doubled)) {
            ret res[*T, A.Error].err{A.Error.overflow{}};
        }
        new_cap = R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](doubled).value;
    }

    var res_buf: res[*T, A.Error];
    if (data == nil) {
        res_buf = A.allocate[T](a, new_cap);
    }
    or {
        res_buf = A.reallocate[T](a, data, cap, new_cap);
    }
    if (sel res_buf.err) {
        ret res[*T, A.Error].err{res_buf.err};
    }

    @out_cap = new_cap;
    ret res[*T, A.Error].ok{res_buf.ok};
}

test "mach.lang.fe.pool.grow:seed" {
    var a: A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }

    var cap1: usize = 0;
    val res_buf1: res[*u8, A.Error] = grow[u8](?a, nil::*u8, 0, 16, ?cap1);
    if (sel res_buf1.err) { ret 1; }
    if (cap1 != 16)                   { ret 1; }
    val ptr1: *u8 = res_buf1.ok;
    A.deallocate[u8](?a, ptr1, 16);

    var cap2: usize = 0;
    val res_buf2: res[*u8, A.Error] = grow[u8](?a, nil::*u8, 0, 8, ?cap2);
    if (sel res_buf2.err) { ret 1; }
    if (cap2 != 8)                    { ret 1; }
    val ptr2: *u8 = res_buf2.ok;
    A.deallocate[u8](?a, ptr2, 8);

    ret 0;
}

test "mach.lang.fe.pool.grow:double" {
    var a: A.Allocator;
    val made: err[A.Error] = page.make(?a);
    if (sel made.err) { ret 1; }

    var cap1: usize = 0;
    val res_buf1: res[*u8, A.Error] = grow[u8](?a, nil::*u8, 0, 16, ?cap1);
    if (sel res_buf1.err) { ret 1; }
    val ptr1: *u8 = res_buf1.ok;

    var cap2: usize = 0;
    val res_buf2: res[*u8, A.Error] = grow[u8](?a, ptr1, 16, 16, ?cap2);
    if (sel res_buf2.err) { ret 1; }
    if (cap2 != 32)                   { ret 1; }
    val ptr2: *u8 = res_buf2.ok;
    A.deallocate[u8](?a, ptr2, 32);

    ret 0;
}

rec PoolGrowthProbe {
    reallocate_calls: u32;
}

fun pool_growth_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun pool_growth_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *PoolGrowthProbe = ctx::*PoolGrowthProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

fun pool_growth_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.fe.pool.grow:refuses_capacity_overflow_before_reallocating" {
    var probe: PoolGrowthProbe;
    probe.reallocate_calls = 0;
    var pp: *PoolGrowthProbe = ?probe;
    var a: A.Allocator;
    a.ctx           = pp::ptr;
    a.fn_allocate   = pool_growth_probe_allocate;
    a.fn_reallocate = pool_growth_probe_reallocate;
    a.fn_deallocate = pool_growth_probe_deallocate;

    val huge_cap: usize = (~(0::usize) / 2) + 1;
    var dummy: u8;
    var out_cap: usize = 0;
    val res_buf: res[*u8, A.Error] = grow[u8](?a, ?dummy, huge_cap, 16, ?out_cap);

    var bad: i32 = 0;
    if (sel res_buf.ok)  { bad = 1; }
    if (probe.reallocate_calls != 0)   { bad = 2; }
    if (out_cap != 0)                  { bad = 3; }
    ret bad;
}
