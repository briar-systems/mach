use std.types.bool.bool;

# the ids of syntax nodes in one ast, each a record so one kind of node id
# cannot be handed where another, or a bare integer, is meant

# an expression node
pub rec ExprId {
    index: u32;
}

# a statement node
pub rec StmtId {
    index: u32;
}

# a declaration node
pub rec DeclId {
    index: u32;
}

# a type-syntax node, distinct from the semantic type.TypeId
pub rec TypeId {
    index: u32;
}

# a module node
pub rec ModuleNodeId {
    index: u32;
}

pub val EXPR_NIL:        ExprId       = ExprId{index: 0xFFFFFFFF};
pub val STMT_NIL:        StmtId       = StmtId{index: 0xFFFFFFFF};
pub val DECL_NIL:        DeclId       = DeclId{index: 0xFFFFFFFF};
pub val TYPE_NIL:        TypeId       = TypeId{index: 0xFFFFFFFF};
pub val MODULE_NODE_NIL: ModuleNodeId = ModuleNodeId{index: 0xFFFFFFFF};

pub fun expr(index: u32) ExprId {
    var id: ExprId;
    id.index = index;
    ret id;
}

pub fun expr_index(id: ExprId) u32 {
    ret id.index;
}

pub fun expr_same(left: ExprId, right: ExprId) bool {
    ret left.index == right.index;
}

pub fun expr_is_nil(id: ExprId) bool {
    ret id.index == EXPR_NIL.index;
}

pub fun stmt(index: u32) StmtId {
    var id: StmtId;
    id.index = index;
    ret id;
}

pub fun stmt_index(id: StmtId) u32 {
    ret id.index;
}

pub fun stmt_same(left: StmtId, right: StmtId) bool {
    ret left.index == right.index;
}

pub fun stmt_is_nil(id: StmtId) bool {
    ret id.index == STMT_NIL.index;
}

pub fun decl(index: u32) DeclId {
    var id: DeclId;
    id.index = index;
    ret id;
}

pub fun decl_index(id: DeclId) u32 {
    ret id.index;
}

pub fun decl_same(left: DeclId, right: DeclId) bool {
    ret left.index == right.index;
}

pub fun decl_is_nil(id: DeclId) bool {
    ret id.index == DECL_NIL.index;
}

pub fun type(index: u32) TypeId {
    var id: TypeId;
    id.index = index;
    ret id;
}

pub fun type_index(id: TypeId) u32 {
    ret id.index;
}

pub fun type_is_nil(id: TypeId) bool {
    ret id.index == TYPE_NIL.index;
}

pub fun module_node(index: u32) ModuleNodeId {
    var id: ModuleNodeId;
    id.index = index;
    ret id;
}

pub fun module_node_index(id: ModuleNodeId) u32 {
    ret id.index;
}

pub fun module_node_is_nil(id: ModuleNodeId) bool {
    ret id.index == MODULE_NODE_NIL.index;
}
