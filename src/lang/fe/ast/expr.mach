use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mach.lang.fe.ast.id;
use mach.lang.fe.token;
use mach.lang.type;
use mach.lang.wide;

pub def ExprKind: u8;

pub val EXPR_KIND_IDENT:            ExprKind = 0;
pub val EXPR_KIND_LIT_INT:          ExprKind = 1;
pub val EXPR_KIND_LIT_FLOAT:        ExprKind = 2;
pub val EXPR_KIND_LIT_CHAR:         ExprKind = 3;
pub val EXPR_KIND_LIT_STR:          ExprKind = 4;
pub val EXPR_KIND_LIT_NIL:          ExprKind = 6;
pub val EXPR_KIND_BINARY:           ExprKind = 7;
pub val EXPR_KIND_UNARY:            ExprKind = 8;
pub val EXPR_KIND_CALL:             ExprKind = 9;
pub val EXPR_KIND_INDEX:            ExprKind = 10;
pub val EXPR_KIND_MEMBER:           ExprKind = 11;
pub val EXPR_KIND_CAST:             ExprKind = 12;
pub val EXPR_KIND_ARRAY_LIT:        ExprKind = 13;
pub val EXPR_KIND_STRUCT_LIT:       ExprKind = 14;
pub val EXPR_KIND_COMPTIME_IDENT:   ExprKind = 15;
pub val EXPR_KIND_PROJECT:          ExprKind = 16;
pub val EXPR_KIND_SPREAD:           ExprKind = 17;
pub val EXPR_KIND_STRIP:            ExprKind = 18;
pub val EXPR_KIND_VECTOR_LIT:       ExprKind = 19;
pub val EXPR_KIND_TYPE_REF:         ExprKind = 20;
pub val EXPR_KIND_GENERIC_INSTANCE: ExprKind = 21;
pub val EXPR_KIND_SEL:              ExprKind = 23;
pub val EXPR_KIND_ERROR:            ExprKind = 255;

pub def BinOp: u8;

pub val BIN_ADD:     BinOp = 0;
pub val BIN_SUB:     BinOp = 1;
pub val BIN_MUL:     BinOp = 2;
pub val BIN_DIV:     BinOp = 3;
pub val BIN_MOD:     BinOp = 4;
pub val BIN_EQ:      BinOp = 5;
pub val BIN_NEQ:     BinOp = 6;
pub val BIN_LT:      BinOp = 7;
pub val BIN_LEQ:     BinOp = 8;
pub val BIN_GT:      BinOp = 9;
pub val BIN_GEQ:     BinOp = 10;
pub val BIN_AND:     BinOp = 11;
pub val BIN_OR:      BinOp = 12;
pub val BIN_BIT_AND: BinOp = 13;
pub val BIN_BIT_OR:  BinOp = 14;
pub val BIN_BIT_XOR: BinOp = 15;
pub val BIN_SHL:     BinOp = 16;
pub val BIN_SHR:     BinOp = 17;
pub val BIN_ASSIGN:  BinOp = 18;

# the operators whose result coerces with their operands, so an untyped literal
# flows through them; false for every other operator (a partition, enumerated by
# its test)
pub fun is_value_preserving_binop(op: BinOp) bool {
    if (op == BIN_ADD || op == BIN_SUB || op == BIN_MUL || op == BIN_DIV || op == BIN_MOD)            { ret true; }
    if (op == BIN_BIT_AND || op == BIN_BIT_OR || op == BIN_BIT_XOR || op == BIN_SHL || op == BIN_SHR) { ret true; }
    ret false;
}

pub def UnOp: u8;

pub val UN_NEG:     UnOp = 0;
pub val UN_NOT:     UnOp = 1;
pub val UN_BIT_NOT: UnOp = 2;
pub val UN_ADDR:    UnOp = 3;
pub val UN_DEREF:   UnOp = 4;

pub val LIT_SUFFIX_NONE: type.TypeKind = 0xFF;

# an identifier, or a `$name` comptime identifier whose `tok` covers the `$` and the name
pub rec ExprIdent {
    tok: token.Span;
}

pub rec ExprLitInt {
    value:  wide.Wide;
    suffix: type.TypeKind;
    tok:    token.Span;
}

pub rec ExprLitFloat {
    value:  f64;
    suffix: type.TypeKind;
    tok:    token.Span;
}

pub rec ExprLitChar {
    value: u32;
    tok:   token.Span;
}

# a string literal: `tok` covers the quotes
pub rec ExprLitStr {
    tok: token.Span;
}

pub rec ExprLitNil {
    tok: token.Span;
}

# the text between a string literal's quotes, read from its token; none for any other node
pub fun lit_str_content(e: *Expr) opt[token.Span] {
    if (e.kind != EXPR_KIND_LIT_STR) { ret opt[token.Span].none{}; }
    val tok: token.Span = e.data.lit_str.tok;
    if (tok.len < 2) { ret opt[token.Span].none{}; }
    ret opt[token.Span].some{token.Span{offset: tok.offset + 1, len: tok.len - 2}};
}

pub rec ExprBinary {
    op:  BinOp;
    lhs: id.ExprId;
    rhs: id.ExprId;
}

pub rec ExprUnary {
    op:      UnOp;
    operand: id.ExprId;
}

pub rec ExprCall {
    callee:          id.ExprId;
    args_start:      u32;
    args_len:        u32;
    type_args_start: u32;
    type_args_len:   u32;
    index_callee:    id.ExprId;
}

# `x[i]` reads one element; `x[i, n]` is a range of `n` elements from `i`, and
# `count` is EXPR_NIL for the single element
pub rec ExprIndex {
    object: id.ExprId;
    index:  id.ExprId;
    count:  id.ExprId;
}

pub fun is_range(ix: *ExprIndex) bool {
    ret ix.count != id.EXPR_NIL;
}

pub rec ExprMember {
    object: id.ExprId;
    name:   token.Span;
}

pub rec ExprProject {
    object: id.ExprId;
    field:  id.ExprId;
}

pub rec ExprSpread {
    inner: id.ExprId;
}

pub rec ExprCast {
    value:       id.ExprId;
    ty:          id.TypeId;
    reinterpret: bool;
}

pub rec ExprStrip {
    value: id.ExprId;
    ty:    id.TypeId;
}

pub rec ExprArrayLit {
    ty:          id.TypeId;
    elems_start: u32;
    elems_len:   u32;
}

pub val INIT_NAMED:      u8 = 0;
pub val INIT_BARE:       u8 = 1;
pub val INIT_POSITIONAL: u8 = 2;

pub rec FieldInit {
    form:  u8;
    name:  token.Span;
    value: id.ExprId;
}

pub rec ExprStructLit {
    elems_start:  u32;
    elems_len:    u32;
    ty:           id.TypeId;
    fields_start: u32;
    fields_len:   u32;
}

pub rec ExprVectorLit {
    ty:          id.TypeId;
    elems_start: u32;
    elems_len:   u32;
}

pub rec ExprTypeRef {
    ty: id.TypeId;
}

pub rec ExprSel {
    place:     id.ExprId;
    case_name: token.Span;
    # `sel place.[c]`: the comptime case descriptor; EXPR_NIL when the case is named
    case_desc: id.ExprId;
}

# `span` is the node's visual extent, grouping parentheses included. a token-backed node (a name
# or a literal) keeps its token in its payload's `tok`, and its text is read through `tok`, never
# through `span`
pub rec Expr {
    span: token.Span;
    kind: ExprKind;
    data: uni {
        ident: ExprIdent;
        comptime_ident: ExprIdent;
        lit_int: ExprLitInt;
        lit_float: ExprLitFloat;
        lit_char: ExprLitChar;
        lit_str: ExprLitStr;
        lit_nil: ExprLitNil;
        binary: ExprBinary;
        unary: ExprUnary;
        call: ExprCall;
        index: ExprIndex;
        member: ExprMember;
        cast: ExprCast;
        strip: ExprStrip;
        array_lit: ExprArrayLit;
        struct_lit: ExprStructLit;
        vector_lit: ExprVectorLit;
        project: ExprProject;
        spread: ExprSpread;
        type_ref: ExprTypeRef;
        sel: ExprSel;
    };
}

test is_value_preserving_binop__partition_binop {
    val preserving: [10]BinOp = [10]BinOp{BIN_ADD, BIN_SUB, BIN_MUL, BIN_DIV,
        BIN_MOD, BIN_BIT_AND, BIN_BIT_OR, BIN_BIT_XOR, BIN_SHL, BIN_SHR};
    val others: [9]BinOp = [9]BinOp{BIN_EQ, BIN_NEQ, BIN_LT, BIN_LEQ,
        BIN_GT, BIN_GEQ, BIN_AND, BIN_OR, BIN_ASSIGN};
    var i: u32 = 0;
    for (i < 10) {
        if (!is_value_preserving_binop(preserving[i])) { ret 1; }
        i = i + 1;
    }
    i = 0;
    for (i < 9) {
        if (is_value_preserving_binop(others[i])) { ret 2; }
        i = i + 1;
    }
    ret 0;
}
