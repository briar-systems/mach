use mach.lang.fail;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mach.lang.fe.ast;
use ast_expr: mach.lang.fe.ast.expr;
use ast_id:   mach.lang.fe.ast.id;

pub def Choice: u8;
pub val PARSED:      Choice = 0;
pub val GENERIC:     Choice = 1;
pub val INDEX_CALL:  Choice = 2;
pub val INDEX_VALUE: Choice = 3;
pub val REJECTED:    Choice = 4;

pub fun get(a: *ast.Ast, choices: *Choice, count: usize, eid: ast_id.ExprId) res[ast_expr.Expr, fail.Fail] {
    if (a == nil || count != a.exprs.len || (choices == nil && count != 0)) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("resolved expression view does not match its parsed owner")};
    }
    val found: opt[*ast_expr.Expr] = ast.get_expr(a, eid);
    if (!sel found.some) { ret res[ast_expr.Expr, fail.Fail].err{fail.message("resolved expression identity is out of range")}; }
    var node:   ast_expr.Expr = @found.some;
    val choice: Choice        = choices[ast_id.expr_index(eid)];
    if (choice == PARSED) { ret res[ast_expr.Expr, fail.Fail].ok{node}; }
    if (node.kind != ast_expr.EXPR_KIND_CALL && node.kind != ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("bracket interpretation does not belong to a bracket expression")};
    }
    if (choice == GENERIC) {
        node.data.call.index_callee = ast_id.EXPR_NIL;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    if (choice == REJECTED) {
        node.kind = ast_expr.EXPR_KIND_ERROR;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    val indexed: opt[*ast_expr.Expr] = ast.get_expr(a, node.data.call.index_callee);
    if (!sel indexed.some) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("bracket interpretation has no parsed index alternative")};
    }
    if (indexed.some.kind != ast_expr.EXPR_KIND_INDEX) {
        ret res[ast_expr.Expr, fail.Fail].err{fail.message("bracket interpretation has no parsed index alternative")};
    }
    if (choice == INDEX_CALL && node.kind == ast_expr.EXPR_KIND_CALL) {
        node.data.call.callee          = node.data.call.index_callee;
        node.data.call.index_callee    = ast_id.EXPR_NIL;
        node.data.call.type_args_start = 0;
        node.data.call.type_args_len   = 0;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    if (choice == INDEX_VALUE && node.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE) {
        node.kind       = ast_expr.EXPR_KIND_INDEX;
        node.data.index = indexed.some.data.index;
        ret res[ast_expr.Expr, fail.Fail].ok{node};
    }
    ret res[ast_expr.Expr, fail.Fail].err{fail.message("invalid bracket interpretation choice")};
}

test get__separate_choices_preserve_the_same_parsed_call {
    var nodes: [3]ast_expr.Expr;
    nodes[0].kind                      = ast_expr.EXPR_KIND_IDENT;
    nodes[1].kind                      = ast_expr.EXPR_KIND_INDEX;
    nodes[1].data.index.object         = ast_id.expr(0);
    nodes[1].data.index.index          = ast_id.expr(0);
    nodes[1].data.index.count          = ast_id.EXPR_NIL;
    nodes[2].kind                      = ast_expr.EXPR_KIND_CALL;
    nodes[2].data.call.callee          = ast_id.expr(0);
    nodes[2].data.call.index_callee    = ast_id.expr(1);
    nodes[2].data.call.type_args_start = 7;
    nodes[2].data.call.type_args_len   = 2;
    nodes[2].data.call.args_start      = 9;
    nodes[2].data.call.args_len        = 3;
    var a: ast.Ast;
    a.exprs = ast.table_over[ast_expr.Expr](?nodes[0], 3);
    var generic:   [3]Choice                     = [3]Choice{PARSED, PARSED, GENERIC};
    var indexed:   [3]Choice                     = [3]Choice{PARSED, PARSED, INDEX_CALL};
    val generic_r: res[ast_expr.Expr, fail.Fail] = get(?a, ?generic[0], 3, ast_id.expr(2));
    val indexed_r: res[ast_expr.Expr, fail.Fail] = get(?a, ?indexed[0], 3, ast_id.expr(2));
    if (sel generic_r.err) { ret 1; }
    if (sel indexed_r.err) { ret 1; }
    val g: ast_expr.Expr = generic_r.ok;
    val i: ast_expr.Expr = indexed_r.ok;
    if (!ast_id.expr_same(g.data.call.callee, ast_id.expr(0)) || !ast_id.expr_is_nil(g.data.call.index_callee) || g.data.call.type_args_len != 2)                                      { ret 2; }
    if (!ast_id.expr_same(i.data.call.callee, ast_id.expr(1)) || i.data.call.type_args_len != 0 || i.data.call.args_start != 9 || i.data.call.args_len != 3)                           { ret 3; }
    if (!ast_id.expr_same(nodes[2].data.call.callee, ast_id.expr(0)) || !ast_id.expr_same(nodes[2].data.call.index_callee, ast_id.expr(1)) || nodes[2].data.call.type_args_start != 7) { ret 4; }
    val get_1: res[ast_expr.Expr, fail.Fail] = get(?a, ?generic[0], 2, ast_id.expr(2));
    if (sel get_1.ok) { ret 5; }
    indexed[2] = 0xFF;
    val get_2: res[ast_expr.Expr, fail.Fail] = get(?a, ?indexed[0], 3, ast_id.expr(2));
    if (sel get_2.ok) { ret 6; }
    ret 0;
}
