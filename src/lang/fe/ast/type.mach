use std.types.bool.bool;

use mach.lang.fe.ast.id;
use mach.lang.fe.token;

pub def TypeKind: u8;

pub val TYPE_KIND_NAMED: TypeKind = 0;
pub val TYPE_KIND_PTR:   TypeKind = 1;
pub val TYPE_KIND_ARRAY: TypeKind = 2;
pub val TYPE_KIND_FUN:   TypeKind = 3;
pub val TYPE_KIND_REC:   TypeKind = 4;
pub val TYPE_KIND_UNI:   TypeKind = 5;
pub val TYPE_KIND_PACK:  TypeKind = 6;
pub val TYPE_KIND_SECRET: TypeKind = 7;
pub val TYPE_KIND_FIELD_TYPE: TypeKind = 8;
pub val TYPE_KIND_POINTEE_OF: TypeKind = 9;
pub val TYPE_KIND_ERROR: TypeKind = 255;

pub rec TypeNamed {
    name:       token.Span;
    args_start: u32;
    args_len:   u32;
    operand:    bool;
}

pub rec TypePtr {
    pointee: id.TypeId;
}

pub rec TypeSecret {
    inner: id.TypeId;
}

pub rec TypeArray {
    length:  id.ExprId;
    element: id.TypeId;
}

pub rec TypeFun {
    params_start: u32;
    params_len:   u32;
    ret_type:     id.TypeId;
    c_variadic:   bool;
}

pub rec TypeRec {
    fields_start: u32;
    fields_len:   u32;
}

pub rec TypeUni {
    fields_start: u32;
    fields_len:   u32;
}

pub rec TypeFieldType {
    var_name: token.Span;
}

pub rec TypePointeeOf {
    inner: id.TypeId;
}

pub rec Type {
    span: token.Span;
    kind: TypeKind;
    data: uni {
        named:  TypeNamed;
        ptr:    TypePtr;
        secret: TypeSecret;
        array:  TypeArray;
        fun_:   TypeFun;
        rec_:   TypeRec;
        uni_:   TypeUni;
        field_type: TypeFieldType;
        pointee_of: TypePointeeOf;
    };
}
