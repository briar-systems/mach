# syntactic type AST nodes, the parser's representation of types as written in source
#
# Each Type is stored by value in Ast.types. Distinct from the semantic
# mach.lang.type.Type, which is the interned type sema produces from these
# syntactic nodes.

use std.types.bool.bool;

use mach.lang.fe.ast.id;
use mach.lang.fe.token;

# discriminator for Type.data
pub def TypeKind: u8;

pub val TYPE_KIND_NAMED: TypeKind = 0;
pub val TYPE_KIND_PTR:   TypeKind = 1;
pub val TYPE_KIND_ARRAY: TypeKind = 2;
pub val TYPE_KIND_FUN:   TypeKind = 3;
pub val TYPE_KIND_REC:   TypeKind = 4;
pub val TYPE_KIND_UNI:   TypeKind = 5;
# a comptime variadic pack type `...` on a named trailing parameter, as in
# `fun f(va: ...)`. carries no payload; the pack's element types are fixed per
# call site and supplied by monomorphization, not at declaration
pub val TYPE_KIND_PACK:  TypeKind = 6;
# a secret-qualified type `^T` (#1643): marks the inner type as carrying secret
# data for the constant-time guarantee. flow-typing semantics land in #1645; the
# parser only records the qualifier
pub val TYPE_KIND_SECRET: TypeKind = 7;
# a field descriptor's own type, `f.type`, written where a type is expected
# (#2691). the only type spelling whose meaning is not fixed by the source text:
# it names whatever field the enclosing `$each f in $fields(T)` is on, so one node
# resolves to a different type per iteration and is never memoized
pub val TYPE_KIND_FIELD_TYPE: TypeKind = 8;
# `$pointee_of(T)`, the type a typed reference `*U` refers to (#2693). a type
# CONSTRUCTOR like `*` and `^` rather than an intrinsic call, so it nests wherever
# a type is written - inside another intrinsic's operand, inside a generic argument
# list, and inside itself for `**U`
pub val TYPE_KIND_POINTEE_OF: TypeKind = 9;
pub val TYPE_KIND_ERROR: TypeKind = 255;

# a named type reference, optionally with generic arguments
# ---
# name:       span of the identifier or dotted path as written in source
# args_start: start index into ast.type_ids
# args_len:   number of generic arguments (0 for a non-generic name)
pub rec TypeNamed {
    name:       token.Span;
    args_start: u32;
    args_len:   u32;
}

# a pointer type *T
# ---
# pointee: element type being pointed to
pub rec TypePtr {
    pointee: id.TypeId;
}

# a secret-qualified type ^T
#
# `^` binds to the type constructor immediately to its right and nests freely
# with `*` and `[N]` (`*^u8`, `[N]^u8`). flow-typing semantics land in #1645.
# ---
# inner: the qualified type
pub rec TypeSecret {
    inner: id.TypeId;
}

# an array type [N]T, or [_]T with the length left to be inferred
# ---
# length:  expression that evaluates to the array length, or EXPR_NIL for `[_]`,
#          whose length an `#[embed(...)]` on the declaration supplies (#2507)
# element: element type
pub rec TypeArray {
    length:  id.ExprId;
    element: id.TypeId;
}

# a function type fun(T, U) R
# ---
# params_start: start index into ast.type_ids
# params_len:   number of parameter types
# ret_type:     return type, or TYPE_NIL for no explicit return
pub rec TypeFun {
    params_start: u32;
    params_len:   u32;
    ret_type:     id.TypeId;
}

# an anonymous record type `rec { name: T; ... }`
# ---
# fields_start: start index into ast.typed_names; each slot holds a TypedName
# fields_len:   number of fields
pub rec TypeRec {
    fields_start: u32;
    fields_len:   u32;
}

# an anonymous raw union type `uni { name: T; ... }`
# ---
# fields_start: start index into ast.typed_names; each slot holds a TypedName
# fields_len:   number of variants
pub rec TypeUni {
    fields_start: u32;
    fields_len:   u32;
}

# a field descriptor's type `f.type` used as a type spelling (#2691)
#
# `var_name` is the loop variable's span, not a resolved binding: the descriptor
# it names exists only inside the enclosing `$each` body, and which field it is on
# is decided per iteration by the unroll. resolve checks the name really is a
# `$each` loop variable, so an ordinary record field called `type` is untouched.
# ---
# var_name: span of the loop variable as written (`f` in `f.type`)
pub rec TypeFieldType {
    var_name: token.Span;
}

# the pointee of a typed reference, `$pointee_of(T)` (#2693)
#
# `inner` is the operand written inside the parentheses, itself a full type
# spelling, so `$pointee_of($pointee_of(**U))` and `$pointee_of(f.type)` both nest
# structurally. Whether `inner` really is a reference is a semantic question and is
# answered by sema, not here.
# ---
# inner: the operand type
pub rec TypePointeeOf {
    inner: id.TypeId;
}

# a syntactic type reference as it appears in source
# ---
# span: byte range of the type expression
# kind: which TYPE_KIND_* variant is active
# data: kind-specific payload; unused for ERROR (discriminated by kind alone)
pub rec Type {
    span: token.Span;
    kind: TypeKind;
    data: uni {
        named:  TypeNamed;
        ptr:    TypePtr;
        secret: TypeSecret;
        array:  TypeArray;
        fun_:   TypeFun;
        rec_:   TypeRec;
        uni_:   TypeUni;
        field_type: TypeFieldType;
        pointee_of: TypePointeeOf;
    };
}
