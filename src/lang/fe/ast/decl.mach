use std.types.bool.bool;

use ast_id:      mach.lang.fe.ast.id;
use lang_source: mach.lang.source;

pub def DeclKind: u8;

pub val DECL_KIND_USE:                DeclKind = 0;
pub val DECL_KIND_FWD:                DeclKind = 1;
pub val DECL_KIND_FUN:                DeclKind = 2;
pub val DECL_KIND_REC:                DeclKind = 3;
pub val DECL_KIND_VAL:                DeclKind = 4;
pub val DECL_KIND_VAR:                DeclKind = 5;
pub val DECL_KIND_DEF:                DeclKind = 6;
pub val DECL_KIND_TEST:               DeclKind = 7;
pub val DECL_KIND_COMPTIME_IF:        DeclKind = 8;
pub val DECL_KIND_COMPTIME_DIRECTIVE: DeclKind = 9;
pub val DECL_KIND_UNI:                DeclKind = 10;
pub val DECL_KIND_TAG:                DeclKind = 11;
pub val DECL_KIND_ERROR:              DeclKind = 255;

pub val DECL_FLAG_PUB: u8 = 1;
pub val DECL_FLAG_EXT: u8 = 2;

# declared in a comptime branch body, at any depth: the parser sets it, and every later phase reads it
pub val DECL_FLAG_GATED: u8 = 4;

pub rec TypedName {
    name:     lang_source.Span;
    ty:       ast_id.TypeId;
    comptime: bool;
}

pub rec DeclUse {
    alias: lang_source.Span;
    path:  lang_source.Span;
}

pub rec DeclFwd {
    alias: lang_source.Span;
    path:  lang_source.Span;
}

pub rec DeclFun {
    name:           lang_source.Span;
    generics_start: u32;
    generics_len:   u32;
    params_start:   u32;
    params_len:     u32;
    return_type:    ast_id.TypeId;
    body:           ast_id.StmtId;
    c_variadic:     bool;
}

pub rec DeclRec {
    name:           lang_source.Span;
    generics_start: u32;
    generics_len:   u32;
    fields_start:   u32;
    fields_len:     u32;
}

pub rec DeclUni {
    name:           lang_source.Span;
    generics_start: u32;
    generics_len:   u32;
    fields_start:   u32;
    fields_len:     u32;
}

pub rec TagCase {
    name:             lang_source.Span;
    payload:          ast_id.TypeId;
    decorators_start: u32;
    decorators_len:   u32;
}

pub rec DeclTag {
    name:           lang_source.Span;
    generics_start: u32;
    generics_len:   u32;
    cases_start:    u32;
    cases_len:      u32;
    disc:           ast_id.TypeId;
}

pub rec DeclBind {
    name: lang_source.Span;
    ty:   ast_id.TypeId;
    init: ast_id.ExprId;
}

pub rec DeclDef {
    name: lang_source.Span;
    ty:   ast_id.TypeId;
}

pub rec DeclTest {
    name: lang_source.Span;
    body: ast_id.StmtId;
}

pub rec ComptimeBranch {
    cond:       ast_id.ExprId;
    body_start: u32;
    body_len:   u32;
}

pub rec DeclComptimeIf {
    branches_start: u32;
    branches_len:   u32;
}

pub rec DeclComptimeDirective {
    target: ast_id.ExprId;
}

# `#[name(args)]`; `id` is the decorator registry's id the name spells, decoded
# once by the parser, and 0 when it spells none
pub rec Decorator {
    name:       lang_source.Span;
    id:         u8;
    args_start: u32;
    args_len:   u32;
}

pub rec Decl {
    span:             lang_source.Span;
    kind:             DeclKind;
    flags:            u8;
    doc:              lang_source.Span;
    decorators_start: u32;
    decorators_len:   u32;
    data:             uni {
        use_: DeclUse;
        fwd_: DeclFwd;
        fun_: DeclFun;
        rec_: DeclRec;
        uni_: DeclUni;
        tag_: DeclTag;
        bind: DeclBind;
        def_: DeclDef;
        test_: DeclTest;
        comptime_if: DeclComptimeIf;
        comptime_directive: DeclComptimeDirective;
    };
}
