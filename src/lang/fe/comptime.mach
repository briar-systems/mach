    "float operands have different declared widths; mach has no implicit widening";

pub val TYPE_QUERY_IS_RECORD:  u8 = 0;
pub val TYPE_QUERY_IS_UNION:   u8 = 1;
pub val TYPE_QUERY_IS_POINTER: u8 = 2;
pub val TYPE_QUERY_NAME:       u8 = 3;
pub val TYPE_QUERY_IS_SECRET:  u8 = 4;

pub def PhaseCapabilityKind: u8;

pub val PHASE_CAP_NONE:           PhaseCapabilityKind = 0;
pub val PHASE_CAP_LOADING:        PhaseCapabilityKind = 1;
pub val PHASE_CAP_RESOLUTION:     PhaseCapabilityKind = 2;
pub val PHASE_CAP_SEMANTIC_NAMES: PhaseCapabilityKind = 3;
pub val PHASE_CAP_SEMANTIC_TYPES: PhaseCapabilityKind = 4;
pub val PHASE_CAP_LOWERING:       PhaseCapabilityKind = 5;

pub rec NoCapabilityContext {
}

pub rec PhaseCapabilities[T] {
    kind:      PhaseCapabilityKind;
    member:    fun(*T, id.ExprId) R.Result[O.Option[CTValue], EvalFail];
    type_:     fun(*T, id.ExprId) R.Result[O.Option[u32], EvalFail];
    field:     fun(*T, u32, u32, u8) R.Result[O.Option[CTValue], EvalFail];
    query:     fun(*T, u32, u8) R.Result[O.Option[CTValue], EvalFail];
    layout:    fun(*T, u32) R.Result[O.Option[CTValue], EvalFail];
    ident:     fun(*T, id.ExprId) bool;
}

fun capabilities_empty[T](kind: PhaseCapabilityKind) PhaseCapabilities[T] {
    var caps: PhaseCapabilities[T];
    caps.kind   = kind;
    caps.member = nil;
    caps.type_  = nil;
    caps.field  = nil;
    caps.query  = nil;
    caps.layout = nil;
    caps.ident  = nil;
    ret caps;
}

pub fun no_capabilities() PhaseCapabilities[NoCapabilityContext] {
    ret capabilities_empty[NoCapabilityContext](PHASE_CAP_NONE);
}

fun capabilities_complete[T](caps: PhaseCapabilities[T]) bool {
    val no_types: bool = caps.type_ == nil && caps.field == nil && caps.query == nil && caps.layout == nil;
    if (caps.kind == PHASE_CAP_NONE) {
        ret caps.member == nil && no_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_LOADING) {
        ret caps.member != nil && no_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_RESOLUTION) {
        ret caps.member == nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_NAMES) {
        ret caps.member != nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING) {
        ret caps.member != nil && caps.type_ != nil && caps.field != nil
            && caps.query != nil && caps.layout != nil && caps.ident != nil;
    }
    ret false;
}

fun capabilities_publish[T](caps: PhaseCapabilities[T]) R.Result[PhaseCapabilities[T], str] {
    if (!capabilities_complete[T](caps)) {
        ret R.err[PhaseCapabilities[T], str]("comptime: incomplete or contradictory phase capabilities");
    }
    ret R.ok[PhaseCapabilities[T], str](caps);
}

pub fun loading_capabilities[T](member: fun(*T, id.ExprId) R.Result[O.Option[CTValue], EvalFail]) R.Result[PhaseCapabilities[T], str] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_LOADING);
    caps.member = member;
    ret capabilities_publish[T](caps);
}

pub fun resolution_capabilities[T](ident: fun(*T, id.ExprId) bool) R.Result[PhaseCapabilities[T], str] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_RESOLUTION);
    caps.ident = ident;
    ret capabilities_publish[T](caps);
}

pub fun semantic_name_capabilities[T](
    member: fun(*T, id.ExprId) R.Result[O.Option[CTValue], EvalFail],
    ident:  fun(*T, id.ExprId) bool
) R.Result[PhaseCapabilities[T], str] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_SEMANTIC_NAMES);
    caps.member = member;
    caps.ident  = ident;
    ret capabilities_publish[T](caps);
}

pub fun semantic_type_capabilities[T](
    member: fun(*T, id.ExprId) R.Result[O.Option[CTValue], EvalFail],
    type_:  fun(*T, id.ExprId) R.Result[O.Option[u32], EvalFail],
    field:  fun(*T, u32, u32, u8) R.Result[O.Option[CTValue], EvalFail],
    query:  fun(*T, u32, u8) R.Result[O.Option[CTValue], EvalFail],
    layout: fun(*T, u32) R.Result[O.Option[CTValue], EvalFail],
    ident:  fun(*T, id.ExprId) bool
) R.Result[PhaseCapabilities[T], str] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_SEMANTIC_TYPES);
    caps.member = member;
    caps.type_  = type_;
    caps.field  = field;
    caps.query  = query;
    caps.layout = layout;
    caps.ident  = ident;
    ret capabilities_publish[T](caps);
}

pub fun lowering_capabilities[T](
    member: fun(*T, id.ExprId) R.Result[O.Option[CTValue], EvalFail],
    type_:  fun(*T, id.ExprId) R.Result[O.Option[u32], EvalFail],
    field:  fun(*T, u32, u32, u8) R.Result[O.Option[CTValue], EvalFail],
    query:  fun(*T, u32, u8) R.Result[O.Option[CTValue], EvalFail],
    layout: fun(*T, u32) R.Result[O.Option[CTValue], EvalFail],
    ident:  fun(*T, id.ExprId) bool
) R.Result[PhaseCapabilities[T], str] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_LOWERING);
    caps.member = member;
    caps.type_  = type_;
    caps.field  = field;
    caps.query  = query;
    caps.layout = layout;
    caps.ident  = ident;
    ret capabilities_publish[T](caps);
}

fun capabilities_have_member[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_LOADING
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

fun capabilities_have_ident[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_RESOLUTION
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

fun capabilities_have_types[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING;
}

pub val COMPTIME_TYPE_QUERY_NO_RESOLVER_MSG: str =
    "a comptime type predicate is only evaluable after type checking";

pub val COMPTIME_FIELD_NO_RESOLVER_MSG: str =
    "a field descriptor member is only comptime-evaluable after type checking";

pub val COMPTIME_FIELD_UNKNOWN_MEMBER_MSG: str =
    "a field descriptor has only `.name`, `.type`, and `.offset`";

pub val COMPTIME_FIELD_UNAVAILABLE_MSG: str =
    "this field descriptor member is not available until lowering";

pub val COMPTIME_MEMBER_NOT_CONST_MSG: str =
    "module-qualified member does not name a module-level constant";

pub def EvalFailKind: u8;

pub val EVAL_FAIL_NONE:         EvalFailKind = 0;
pub val EVAL_FAIL_REJECTED:     EvalFailKind = 1;
pub val EVAL_FAIL_UNBOUND:      EvalFailKind = 2;
pub val EVAL_FAIL_NEEDS_MEMBER: EvalFailKind = 3;
pub val EVAL_FAIL_NEEDS_TYPES:  EvalFailKind = 4;
pub val EVAL_FAIL_NEEDS_LAYOUT: EvalFailKind = 5;
pub val EVAL_FAIL_INTERNAL:     EvalFailKind = 6;

pub rec EvalFail {
    kind:    EvalFailKind;
    message: str;
}

fun eval_internal_result[T](r: R.Result[T, str]) R.Result[T, EvalFail] {
    if (R.is_err[T, str](r)) { ret R.err[T, EvalFail](eval_error(EVAL_FAIL_INTERNAL, R.unwrap_err[T, str](r))); }
    ret R.ok[T, EvalFail](R.unwrap_ok[T, str](r));
}

pub fun eval_error(kind: EvalFailKind, message: str) EvalFail {
    var f: EvalFail;
    f.kind = kind;
    f.message = message;
    ret f;
}

pub fun eval_from_fail(f: fail.Fail, rejected_message: str) EvalFail {
    if (f.kind == fail.REPORTED) { ret eval_error(EVAL_FAIL_REJECTED, rejected_message); }
    ret eval_error(EVAL_FAIL_INTERNAL, f.message);
}

fun internal_failure(message: str) R.Result[CTValue, EvalFail] {
    ret awaiting(EVAL_FAIL_INTERNAL, message);
}

fun reject(message: str) R.Result[CTValue, EvalFail] {
    ret awaiting(EVAL_FAIL_REJECTED, message);
}

fun awaiting(kind: EvalFailKind, message: str) R.Result[CTValue, EvalFail] {
    var f: EvalFail;
    f.kind    = kind;
    f.message = message;
    ret R.err[CTValue, EvalFail](f);
}

pub fun gate_eval_failure_is_transient(kind: EvalFailKind) bool {
    ret kind == EVAL_FAIL_UNBOUND
     || kind == EVAL_FAIL_NEEDS_MEMBER
     || kind == EVAL_FAIL_NEEDS_LAYOUT;
}

pub def ConstKind: u8;

pub val CONST_INT:     ConstKind = 0;
pub val CONST_FLOAT:   ConstKind = 1;
pub val CONST_POINTER: ConstKind = 2;
pub val CONST_SYMBOL:  ConstKind = 3;
pub val CONST_ZERO:    ConstKind = 4;

pub rec ConstAddress {
    symbol: intern.StrId;
    addend: i64;
}

pub rec TypedConstant {
    ty:   type.TypeId;
    kind: ConstKind;
    bits: u64;
    addr: ConstAddress;
}

pub fun const_int(ty: type.TypeId, bits: u64) TypedConstant {
    var c: TypedConstant;
    c.ty   = ty;
    c.kind = CONST_INT;
    c.bits = bits;
    ret c;
}

pub fun const_float(ti: *type.TypeInterner, ty: type.TypeId, f: f64) R.Result[TypedConstant, str] {
    val stripped: type.TypeId = type.strip_secret(ti, ty);
    val opt_t: O.Option[*type.Type] = type.get(ti, stripped);
    if (O.is_none[*type.Type](opt_t)) { ret R.err[TypedConstant, str]("typed constant: unknown float type"); }
    val w: float.FloatWidth = type.float_width_of(O.unwrap[*type.Type](opt_t).kind);
    if (w == float.FLOAT_W_NONE) { ret R.err[TypedConstant, str]("typed constant: not a float type"); }

    var c: TypedConstant;
    c.ty   = ty;
    c.kind = CONST_FLOAT;
    c.bits = float.f64_bits(float.round_at(f, w));
    ret R.ok[TypedConstant, str](c);
}

pub fun const_zero(ty: type.TypeId) TypedConstant {
    var c: TypedConstant;
    c.ty   = ty;
    c.kind = CONST_ZERO;
    c.bits = 0;
    ret c;
}

pub fun const_pointer(ty: type.TypeId, symbol: intern.StrId, addend: i64) TypedConstant {
    var c: TypedConstant;
    c.ty          = ty;
    c.kind        = CONST_POINTER;
    c.addr.symbol = symbol;
    c.addr.addend = addend;
    ret c;
}

pub fun const_symbol(ty: type.TypeId, symbol: intern.StrId) TypedConstant {
    var c: TypedConstant;
    c.ty          = ty;
    c.kind        = CONST_SYMBOL;
    c.addr.symbol = symbol;
    c.addr.addend = 0;
    ret c;
}

fun const_bit_extent(ti: *type.TypeInterner, ty: type.TypeId, ptr_width: u32) O.Option[u32] {
    val stripped: type.TypeId = type.strip_secret(ti, ty);
    val opt_t: O.Option[*type.Type] = type.get(ti, stripped);
    if (O.is_none[*type.Type](opt_t)) { ret O.none[u32](); }
    val t: *type.Type = O.unwrap[*type.Type](opt_t);
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER) { ret O.some[u32](ptr_width * 8); }
    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_NONE) { ret O.none[u32](); }
    ret O.some[u32](d.bits);
}

pub val REINTERPRET_MSG_UNSUPPORTED_SOURCE: str =
    "typed constant reinterpretation: unsupported source kind";

pub val REINTERPRET_MSG_UNREPRESENTABLE: str =
    "typed constant reinterpretation: unrepresentable operand type";

pub val REINTERPRET_MSG_WIDTH_MISMATCH: str =
    "typed constant reinterpretation: bit extent mismatch";

pub fun const_reinterpret(ti: *type.TypeInterner, c: TypedConstant, dest_ty: type.TypeId, ptr_width: u32)
                          R.Result[TypedConstant, str] {
    if (c.kind != CONST_INT && c.kind != CONST_FLOAT) {
        ret R.err[TypedConstant, str](REINTERPRET_MSG_UNSUPPORTED_SOURCE);
    }

    val src_extent: O.Option[u32] = const_bit_extent(ti, c.ty, ptr_width);
    val dst_extent: O.Option[u32] = const_bit_extent(ti, dest_ty, ptr_width);
    if (O.is_none[u32](src_extent) || O.is_none[u32](dst_extent)) {
        ret R.err[TypedConstant, str](REINTERPRET_MSG_UNREPRESENTABLE);
    }
    if (O.unwrap[u32](src_extent) != O.unwrap[u32](dst_extent)) {
        ret R.err[TypedConstant, str](REINTERPRET_MSG_WIDTH_MISMATCH);
    }

    val dest_stripped: type.TypeId = type.strip_secret(ti, dest_ty);
    val opt_dest: O.Option[*type.Type] = type.get(ti, dest_stripped);
    if (O.is_none[*type.Type](opt_dest)) {
        ret R.err[TypedConstant, str](REINTERPRET_MSG_UNREPRESENTABLE);
    }
    val dest_kind: type.TypeKind = O.unwrap[*type.Type](opt_dest).kind;
    val dest_class: type.PrimClass = type.prim_desc(dest_kind).class;

    var out: TypedConstant;
    out.ty   = dest_ty;
    out.bits = c.bits;
    if (dest_class == type.PRIM_CLASS_FLOAT) { out.kind = CONST_FLOAT; }
    or                                       { out.kind = CONST_INT; }
    ret R.ok[TypedConstant, str](out);
}

val MAX_ADDEND: i64 = 9223372036854775807;
val MIN_ADDEND: i64 = -9223372036854775807 - 1;

pub fun const_address_add(c: TypedConstant, delta: i64) R.Result[TypedConstant, str] {
    if (c.kind != CONST_POINTER && c.kind != CONST_SYMBOL) {
        ret R.err[TypedConstant, str]("typed constant address arithmetic: not an address-carrying constant");
    }
    if (delta > 0 && c.addr.addend > MAX_ADDEND - delta) {
        ret R.err[TypedConstant, str]("typed constant address arithmetic: addend overflow");
    }
    if (delta < 0 && c.addr.addend < MIN_ADDEND - delta) {
        ret R.err[TypedConstant, str]("typed constant address arithmetic: addend underflow");
    }
    var out: TypedConstant = c;
    out.addr.addend = c.addr.addend + delta;
    ret R.ok[TypedConstant, str](out);
}

pub rec DataModel {
    ptr_width:  u32;
    big_endian: bool;
}

pub fun data_model(ptr_width: u32, big_endian: bool) DataModel {
    var dm: DataModel;
    dm.ptr_width  = ptr_width;
    dm.big_endian = big_endian;
    ret dm;
}

pub rec RelocationRequest {
    offset: u32;
    symbol: intern.StrId;
    addend: i64;
    width:  u32;
}

fun encode_width_bytes(bits: u64, width: u32, big_endian: bool, out: *u8, out_len: usize) R.Result[u32, str] {
    if (width::usize > out_len) {
        ret R.err[u32, str]("typed constant encode: destination buffer too small");
    }
    var i: u32 = 0;
    for (i < width) {
        val shift: u64 = (i * 8)::u64;
        val byte: u8 = ((bits >> shift) & 0xFF)::u8;
        if (big_endian) { out[width - 1 - i] = byte; }
        or               { out[i] = byte; }
        i = i + 1;
    }
    ret R.ok[u32, str](width);
}

pub fun encode_scalar(ti: *type.TypeInterner, c: TypedConstant, dm: DataModel, base_offset: u32,
                      out: *u8, out_len: usize, reloc_out: *O.Option[RelocationRequest]) R.Result[u32, str] {
    @reloc_out = O.none[RelocationRequest]();

    if (c.kind == CONST_ZERO) {
        val extent_opt: O.Option[u32] = const_bit_extent(ti, c.ty, dm.ptr_width);
        if (O.is_none[u32](extent_opt)) { ret R.err[u32, str]("typed constant encode: unrepresentable type"); }
        val bytes: u32 = O.unwrap[u32](extent_opt) / 8;
        if (bytes::usize > out_len) { ret R.err[u32, str]("typed constant encode: destination buffer too small"); }
        var i: u32 = 0;
        for (i < bytes) { out[i] = 0; i = i + 1; }
        ret R.ok[u32, str](bytes);
    }

    if (c.kind == CONST_INT || c.kind == CONST_FLOAT) {
        val extent_opt: O.Option[u32] = const_bit_extent(ti, c.ty, dm.ptr_width);
        if (O.is_none[u32](extent_opt)) { ret R.err[u32, str]("typed constant encode: unrepresentable type"); }
        val bits_width: u32 = O.unwrap[u32](extent_opt);
        val bytes: u32 = bits_width / 8;
        if (c.kind == CONST_FLOAT && bytes == 4) {
            ret encode_width_bytes(float.f64_to_f32_bits(c.bits)::u64, 4, dm.big_endian, out, out_len);
        }
        ret encode_width_bytes(c.bits, bytes, dm.big_endian, out, out_len);
    }

    if (c.kind == CONST_POINTER || c.kind == CONST_SYMBOL) {
        if (dm.ptr_width::usize > out_len) {
            ret R.err[u32, str]("typed constant encode: destination buffer too small");
        }
        var i: u32 = 0;
        for (i < dm.ptr_width) { out[i] = 0; i = i + 1; }
        var rr: RelocationRequest;
        rr.offset = base_offset;
        rr.symbol = c.addr.symbol;
        rr.addend = c.addr.addend;
        rr.width  = dm.ptr_width;
        @reloc_out = O.some[RelocationRequest](rr);
        ret R.ok[u32, str](dm.ptr_width);
    }

    ret R.err[u32, str]("typed constant encode: unsupported constant kind");
}

pub rec FrameMark {
    owner:         ptr;
    entries_len:   u32;
    deferred_len:  u32;
    generation:    u64;
    parent:        u64;
}

pub rec ComptimeEnv {
    alloc:          *A.Allocator;
    target_os_id:   u32;
    target_arch_id: u32;
    target_abi_id:  u32;
    build_mode_id:  u32;
    build_pie:      u32;
    pointer_width:  u32;
    target_defs:    *isa.TargetDefs;
    vector_bits:    u32;
    has_float:      bool;
    va_list_size:   u32;
    va_list_align:  u32;
    compiler_name:  intern.StrId;
    compiler_ver:   intern.StrId;
    defines:        *NamedConst;
    define_len:     u32;
    define_cap:     u32;
    project_id:     intern.StrId;
    project_ver:    intern.StrId;
    project_name:   intern.StrId;
    project_desc:   intern.StrId;
    target_os:      intern.StrId;
    target_isa:     intern.StrId;
    target_abi:     intern.StrId;
    target_platform: intern.StrId;
    bin_name:       intern.StrId;
    union_build:    bool;
    diags:          *diagnostic.DiagnosticStore;
}

pub rec ComptimeCtx {
    env:              ComptimeEnv;
    entries:          *NamedConst;
    entries_len:      u32;
    entries_cap:      u32;
    deferred:         *intern.StrId;
    deferred_len:     u32;
    deferred_cap:     u32;
    frame_generation: u64;
    frame_top:        u64;
    gate_states:      *GateState;
    gate_count:       u32;
    load_walked:      *bool;
    gate_decl_count:  u32;
}

pub fun environment(c: *ComptimeCtx) ComptimeEnv {
    ret c.env;
}

val INITIAL_CONST_CAP: u32 = 8;

fun is_i64_min(a: i64) bool {
    ret a != 0 && (0 - a) == a;
}

pub fun init(
    alloc:          *A.Allocator,
    target_os_id:   u32,
    target_arch_id: u32,
    target_abi_id:  u32,
    build_mode_id:  u32,
    build_pie:      u32,
    pointer_width:  u32,
    vector_bits:    u32,
    has_float:      bool,
    compiler_name:  intern.StrId,
    compiler_ver:   intern.StrId
) ComptimeCtx {
    var c: ComptimeCtx;
    c.env.alloc           = alloc;
    c.env.target_os_id    = target_os_id;
    c.env.target_arch_id  = target_arch_id;
    c.env.target_abi_id   = target_abi_id;
    c.env.build_mode_id   = build_mode_id;
    c.env.build_pie       = build_pie;
    c.env.pointer_width   = pointer_width;
    c.env.target_defs     = nil;
    c.env.vector_bits     = vector_bits;
    c.env.has_float       = has_float;
    c.env.va_list_size    = 0;
    c.env.va_list_align   = 0;
    c.env.compiler_name   = compiler_name;
    c.env.compiler_ver    = compiler_ver;
    c.env.defines         = nil;
    c.env.define_len      = 0;
    c.env.define_cap      = 0;
    c.env.project_id      = intern.STR_NIL;
    c.env.project_ver     = intern.STR_NIL;
    c.env.project_name    = intern.STR_NIL;
    c.env.project_desc    = intern.STR_NIL;
    c.env.target_os       = intern.STR_NIL;
    c.env.target_isa      = intern.STR_NIL;
    c.env.target_abi      = intern.STR_NIL;
    c.env.target_platform = intern.STR_NIL;
    c.env.bin_name        = intern.STR_NIL;
    c.env.union_build     = false;
    c.env.diags           = nil;

    c.entries          = nil;
    c.entries_len      = 0;
    c.entries_cap      = 0;
    c.deferred         = nil;
    c.deferred_len     = 0;
    c.deferred_cap     = 0;
    c.frame_generation = 0;
    c.frame_top        = 0;
    c.gate_states      = nil;
    c.gate_count       = 0;
    c.load_walked      = nil;
    c.gate_decl_count  = 0;
    ret c;
}

pub fun set_diagnostics(c: *ComptimeCtx, diags: *diagnostic.DiagnosticStore) {
    c.env.diags = diags;
}

pub fun set_union_build(c: *ComptimeCtx, v: bool) {
    c.env.union_build = v;
}

pub fun set_target_defs(c: *ComptimeCtx, d: *isa.TargetDefs) {
    c.env.target_defs = d;
}

pub fun set_va_list(c: *ComptimeCtx, size: u32, align: u32) {
    c.env.va_list_size  = size;
    c.env.va_list_align = align;
}

pub fun set_build_context(
    c:            *ComptimeCtx,
    project_id:   intern.StrId,
    project_ver:  intern.StrId,
    project_name: intern.StrId,
    project_desc: intern.StrId,
    target_os:    intern.StrId,
    target_isa:   intern.StrId,
    target_abi:   intern.StrId,
    target_platform: intern.StrId,
    bin_name:     intern.StrId
) {
    c.env.project_id   = project_id;
    c.env.project_ver  = project_ver;
    c.env.project_name = project_name;
    c.env.project_desc = project_desc;
    c.env.target_os    = target_os;
    c.env.target_isa   = target_isa;
    c.env.target_abi   = target_abi;
    c.env.target_platform = target_platform;
    c.env.bin_name     = bin_name;
}

pub fun dnit(c: *ComptimeCtx) {
    if (c == nil) { ret; }
    if (c.entries != nil && c.entries_cap > 0) {
        A.deallocate[NamedConst](c.env.alloc, c.entries, c.entries_cap::usize);
    }
    if (c.env.defines != nil && c.env.define_cap > 0) {
        A.deallocate[NamedConst](c.env.alloc, c.env.defines, c.env.define_cap::usize);
    }
    c.entries     = nil;
    c.entries_len = 0;
    c.entries_cap = 0;
    if (c.deferred != nil && c.deferred_cap > 0) {
        A.deallocate[intern.StrId](c.env.alloc, c.deferred, c.deferred_cap::usize);
    }
    if (c.gate_states != nil && c.gate_count > 0) {
        A.deallocate[GateState](c.env.alloc, c.gate_states, c.gate_count::usize);
    }
    if (c.load_walked != nil && c.gate_decl_count > 0) {
        A.deallocate[bool](c.env.alloc, c.load_walked, c.gate_decl_count::usize);
    }
    c.env.defines     = nil;
    c.env.define_len  = 0;
    c.env.define_cap  = 0;
    c.deferred    = nil;
    c.deferred_len = 0;
    c.deferred_cap = 0;
    c.frame_top   = 0;
    c.gate_states = nil;
    c.gate_count  = 0;
    c.load_walked = nil;
    c.gate_decl_count = 0;
}

pub fun prepare_gates(c: *ComptimeCtx, expr_count: u32, decl_count: u32) R.Result[R.Void, str] {
    if (c.gate_states == nil && expr_count > 0) {
        val sr: R.Result[*GateState, str] = A.allocate[GateState](c.env.alloc, expr_count::usize);
        if (R.is_err[*GateState, str](sr)) { ret R.err[R.Void, str](R.unwrap_err[*GateState, str](sr)); }
        c.gate_states = R.unwrap_ok[*GateState, str](sr);
        c.gate_count = expr_count;
        var i: u32 = 0;
        for (i < expr_count) { c.gate_states[i] = GATE_STATE_UNKNOWN; i = i + 1; }
    }
    if (c.load_walked == nil && decl_count > 0) {
        val wr: R.Result[*bool, str] = A.allocate[bool](c.env.alloc, decl_count::usize);
        if (R.is_err[*bool, str](wr)) { ret R.err[R.Void, str](R.unwrap_err[*bool, str](wr)); }
        c.load_walked = R.unwrap_ok[*bool, str](wr);
        c.gate_decl_count = decl_count;
        var i: u32 = 0;
        for (i < decl_count) { c.load_walked[i] = false; i = i + 1; }
    }
    ret R.ok_void[str]();
}

pub fun gate_state(c: *ComptimeCtx, eid: id.ExprId) GateState {
    if (c == nil || c.gate_states == nil || eid == id.EXPR_NIL || eid >= c.gate_count) {
        ret GATE_STATE_UNKNOWN;
    }
    ret c.gate_states[eid];
}

pub fun set_gate_state(c: *ComptimeCtx, eid: id.ExprId, state: GateState) {
    if (c == nil || c.gate_states == nil || eid == id.EXPR_NIL || eid >= c.gate_count) { ret; }
    c.gate_states[eid] = state;
}

pub fun load_walked(c: *ComptimeCtx, did: id.DeclId) bool {
    if (c == nil || c.load_walked == nil || did == id.DECL_NIL || did >= c.gate_decl_count) { ret false; }
    ret c.load_walked[did];
}

pub fun mark_load_walked(c: *ComptimeCtx, did: id.DeclId) {
    if (c == nil || c.load_walked == nil || did == id.DECL_NIL || did >= c.gate_decl_count) { ret; }
    c.load_walked[did] = true;
}

pub fun defer_float_width(c: *ComptimeCtx, name: intern.StrId) R.Result[R.Void, str] {
    if (c.deferred_len == c.deferred_cap) {
        var new_cap: u32 = c.deferred_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_CONST_CAP; }
        val g: R.Result[*intern.StrId, str] =
            A.reallocate[intern.StrId](c.env.alloc, c.deferred, c.deferred_cap::usize, new_cap::usize);
        if (R.is_err[*intern.StrId, str](g)) {
            ret R.err[R.Void, str](R.unwrap_err[*intern.StrId, str](g));
        }
        c.deferred     = R.unwrap_ok[*intern.StrId, str](g);
        c.deferred_cap = new_cap;
    }
    c.deferred[c.deferred_len] = name;
    c.deferred_len = c.deferred_len + 1;
    ret R.ok_void[str]();
}

pub fun float_width_deferred(c: *ComptimeCtx, name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < c.deferred_len) {
        if (c.deferred[i] == name) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun bind(c: *ComptimeCtx, name: intern.StrId, value: CTValue) R.Result[R.Void, str] {
    var nc: NamedConst;
    nc.name  = name;
    nc.value = value;
    nc.gated = false;
    ret consts_push(c.env.alloc, ?c.entries, ?c.entries_len, ?c.entries_cap, nc);
}

pub fun bind_gated(c: *ComptimeCtx, name: intern.StrId, value: CTValue, gated: bool) R.Result[R.Void, str] {
    var nc: NamedConst;
    nc.name  = name;
    nc.value = value;
    nc.gated = gated;
    ret consts_push(c.env.alloc, ?c.entries, ?c.entries_len, ?c.entries_cap, nc);
}

pub fun frame_open(c: *ComptimeCtx) R.Result[FrameMark, str] {
    if (c == nil) { ret R.err[FrameMark, str]("comptime: frame_open requires a context"); }
    if (c.frame_generation == 0xFFFFFFFFFFFFFFFF) {
        ret R.err[FrameMark, str]("comptime: frame generation exhausted");
    }
    var mark: FrameMark;
    mark.owner        = c::ptr;
    mark.entries_len  = c.entries_len;
    mark.deferred_len = c.deferred_len;
    mark.generation   = c.frame_generation + 1;
    mark.parent       = c.frame_top;
    c.frame_generation = mark.generation;
    c.frame_top        = mark.generation;
    ret R.ok[FrameMark, str](mark);
}

pub fun frame_close(c: *ComptimeCtx, mark: FrameMark) R.Result[R.Void, str] {
    if (c == nil || mark.owner != c::ptr) {
        ret R.err[R.Void, str]("comptime: frame_close mark belongs to another context");
    }
    if (mark.generation == 0 || mark.generation != c.frame_top) {
        ret R.err[R.Void, str]("comptime: frame_close mark is stale or out of order");
    }
    if (mark.entries_len > c.entries_len || mark.deferred_len > c.deferred_len) {
        ret R.err[R.Void, str]("comptime: frame_close mark exceeds current frame state");
    }
    c.entries_len  = mark.entries_len;
    c.deferred_len = mark.deferred_len;
    c.frame_top    = mark.parent;
    ret R.ok_void[str]();
}

pub fun lookup(c: *ComptimeCtx, name: intern.StrId) O.Option[NamedConst] {
    var i: u32 = c.entries_len;
    for (i > 0) {
        i = i - 1;
        if (c.entries[i].name == name) {
            ret O.some[NamedConst](c.entries[i]);
        }
    }
    ret O.none[NamedConst]();
}

pub fun field_type_of_binding[T](c: *ComptimeCtx, cap_ctx: *T, caps: PhaseCapabilities[T], name: intern.StrId) R.Result[O.Option[u32], EvalFail] {
    val bound: O.Option[NamedConst] = lookup(c, name);
    if (O.is_none[NamedConst](bound)) { ret R.ok[O.Option[u32], EvalFail](O.none[u32]()); }
    val nc: NamedConst = O.unwrap[NamedConst](bound);
    if (nc.value.kind != CT_KIND_FIELD) { ret R.ok[O.Option[u32], EvalFail](O.none[u32]()); }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.field == nil) { ret R.ok[O.Option[u32], EvalFail](O.none[u32]()); }
    val r: R.Result[O.Option[CTValue], EvalFail] =
        caps.field(cap_ctx, nc.value.data.fld.owner, nc.value.data.fld.index, FIELD_SEL_TYPE);
    if (R.is_err[O.Option[CTValue], EvalFail](r)) { ret R.err[O.Option[u32], EvalFail](R.unwrap_err[O.Option[CTValue], EvalFail](r)); }
    val o: O.Option[CTValue] = R.unwrap_ok[O.Option[CTValue], EvalFail](r);
    if (O.is_none[CTValue](o)) { ret R.ok[O.Option[u32], EvalFail](O.none[u32]()); }
    val v: CTValue = O.unwrap[CTValue](o);
    if (v.kind != CT_KIND_TYPE) { ret R.ok[O.Option[u32], EvalFail](O.none[u32]()); }
    ret R.ok[O.Option[u32], EvalFail](O.some[u32](v.data.t));
}

pub fun bind_define(c: *ComptimeCtx, name: intern.StrId, value: CTValue) R.Result[R.Void, str] {
    var i: u32 = 0;
    for (i < c.env.define_len) {
        if (c.env.defines[i].name == name) {
            c.env.defines[i].value = value;
            ret R.ok_void[str]();
        }
        i = i + 1;
    }

    var nc: NamedConst;
    nc.name  = name;
    nc.value = value;
    nc.gated = false;
    ret consts_push(c.env.alloc, ?c.env.defines, ?c.env.define_len, ?c.env.define_cap, nc);
}

pub fun lookup_define(c: *ComptimeCtx, name: intern.StrId) O.Option[NamedConst] {
    var i: u32 = 0;
    for (i < c.env.define_len) {
        if (c.env.defines[i].name == name) { ret O.some[NamedConst](c.env.defines[i]); }
        i = i + 1;
    }
    ret O.none[NamedConst]();
}

fun consts_push(a: *A.Allocator, arr: **NamedConst, len: *u32, cap: *u32, nc: NamedConst) R.Result[R.Void, str] {
    if (@len == @cap) {
        var new_cap: u32 = @cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_CONST_CAP; }
        val res_grow: R.Result[*NamedConst, str] =
            A.reallocate[NamedConst](a, @arr, (@cap)::usize, new_cap::usize);
        if (R.is_err[*NamedConst, str](res_grow)) {
            ret R.err[R.Void, str](R.unwrap_err[*NamedConst, str](res_grow));
        }
        @arr = R.unwrap_ok[*NamedConst, str](res_grow);
        @cap = new_cap;
    }

    val dst: *NamedConst = @arr;
    dst[@len] = nc;
    @len = @len + 1;
    ret R.ok_void[str]();
}

pub fun evaluate[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner
) R.Result[CTValue, EvalFail] {
    ret evaluate_at_float_width[T](c, cap_ctx, caps, a, source, e, interner, float.FLOAT_W_NONE);
}

pub fun evaluate_at_float_width[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) R.Result[CTValue, EvalFail] {
    if (e == id.EXPR_NIL) { ret reject("missing expression"); }

    val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, e);
    if (O.is_none[*expr.Expr](n_opt)) { ret reject("ExprId out of range"); }
    val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
    val k: expr.ExprKind = node.kind;

    if (k == expr.EXPR_KIND_LIT_INT)   { ret eval_lit_int(source, node.span); }
    if (k == expr.EXPR_KIND_LIT_FLOAT) {
        val r_lit: R.Result[LitFloat, str] = scan_lit_float(source, node.span);
        if (R.is_err[LitFloat, str](r_lit)) { ret reject(R.unwrap_err[LitFloat, str](r_lit)); }
        val lit: LitFloat = R.unwrap_ok[LitFloat, str](r_lit);
        if (lit.suffix != expr.LIT_SUFFIX_NONE) { ret float_value(lit.value, type.float_width_of(lit.suffix)); }
        ret float_value(lit.value, fw);
    }
    if (k == expr.EXPR_KIND_LIT_CHAR)  { ret eval_lit_char(source, node.span); }
    if (k == expr.EXPR_KIND_LIT_STR)   { ret eval_lit_str(source, node.span, interner); }
    if (k == expr.EXPR_KIND_LIT_NIL)   { ret reject("nil is not comptime-evaluable"); }

    if (k == expr.EXPR_KIND_BINARY) { ret eval_binary[T](c, cap_ctx, caps, a, source, ?node.data.binary, interner, fw); }
    if (k == expr.EXPR_KIND_UNARY)  { ret eval_unary[T](c, cap_ctx, caps, a, source, ?node.data.unary, interner, fw); }

    if (k == expr.EXPR_KIND_IDENT) {
        val r_id: R.Result[CTValue, EvalFail] = eval_ident[T](c, cap_ctx, caps, source, e, node.span, interner);
        if (R.is_err[CTValue, EvalFail](r_id)) { ret r_id; }
        val v_id: CTValue = R.unwrap_ok[CTValue, EvalFail](r_id);
        if (v_id.kind == CT_KIND_CONST_ELEM) {
            ret evaluate_at_float_width[T](c, cap_ctx, caps, a, source, v_id.data.celem.elem::id.ExprId, interner, fw);
        }
        ret r_id;
    }

    if (k == expr.EXPR_KIND_COMPTIME_IDENT) {
        ret reject(COMPTIME_BARE_IDENT_MSG);
    }
    if (k == expr.EXPR_KIND_MEMBER) {
        if (is_comptime_path(a, e)) { ret eval_path(c, a, source, e, interner); }
        val cel: O.Option[R.Result[CTValue, EvalFail]] =
            eval_const_elem_member[T](c, cap_ctx, caps, a, source, node.data.member.object, node.data.member.name, interner, fw);
        if (O.is_some[R.Result[CTValue, EvalFail]](cel)) { ret O.unwrap[R.Result[CTValue, EvalFail]](cel); }
        val fld: O.Option[R.Result[CTValue, EvalFail]] =
            eval_field_member[T](c, cap_ctx, caps, a, source, node.data.member.object, node.data.member.name, interner);
        if (O.is_some[R.Result[CTValue, EvalFail]](fld)) { ret O.unwrap[R.Result[CTValue, EvalFail]](fld); }
        ret eval_module_member[T](cap_ctx, caps, e);
    }

    if (k == expr.EXPR_KIND_CALL) {
        val q: O.Option[R.Result[CTValue, EvalFail]] = eval_type_query[T](c, cap_ctx, caps, a, source, e, interner);
        if (O.is_some[R.Result[CTValue, EvalFail]](q)) { ret O.unwrap[R.Result[CTValue, EvalFail]](q); }
        if (is_layout_intrinsic_call(a, source, e)) { ret eval_layout_intrinsic[T](cap_ctx, caps, a, source, e); }
        ret reject("function calls are not comptime-evaluable");
    }
    if (k == expr.EXPR_KIND_INDEX)      { ret reject("index expressions are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_CAST)       { ret reject("type casts are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_ARRAY_LIT)  { ret reject("array literals are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_STRUCT_LIT) { ret reject("struct literals are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_VECTOR_LIT) { ret reject("vector literals are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_ERROR)      { ret reject("expression has a parse error"); }

    ret reject("expression is not comptime-evaluable");
}

fun eval_layout_intrinsic[T](cap_ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, source: str, e: id.ExprId) R.Result[CTValue, EvalFail] {
    if (!capabilities_have_types[T](cap_ctx, caps) || caps.layout == nil) {
        if (is_comptime_call(a, source, e, "offset_of")) {
            ret reject("`$offset_of` has no value in a comptime condition: a field's offset is decided at lowering, later than any comptime branch");
        }
        ret awaiting(EVAL_FAIL_NEEDS_LAYOUT, COMPTIME_LAYOUT_NO_RESOLVER_MSG);
    }
    val r: R.Result[O.Option[CTValue], EvalFail] = caps.layout(cap_ctx, e::u32);
    if (R.is_err[O.Option[CTValue], EvalFail](r)) {
        ret R.err[CTValue, EvalFail](R.unwrap_err[O.Option[CTValue], EvalFail](r));
    }
    val ans: O.Option[CTValue] = R.unwrap_ok[O.Option[CTValue], EvalFail](r);
    if (O.is_none[CTValue](ans)) {
        ret reject("`$offset_of` has no value in a comptime condition: a field's offset is decided at lowering, later than any comptime branch");
    }
    ret R.ok[CTValue, EvalFail](O.unwrap[CTValue](ans));
}

fun span_text(source: str, span: token.Span) View {
    ret view(?source[span.offset], span.len);
}

pub rec LitInt {
    value:    u64;
    suffix:   type.TypeKind;
    in_range: bool;
}

pub rec LitFloat {
    value:  f64;
    suffix: type.TypeKind;
}

val LIT_SUFFIX_INT_MSG: str =
    "unknown integer literal suffix: an integer literal takes `u8`, `u16`, `u32`, `u64`, `i8`, `i16`, `i32`, or `i64`; a float literal carries a fractional part or an exponent (`1.0f32`)";

val LIT_SUFFIX_FLOAT_MSG: str =
    "unknown float literal suffix: a float literal takes `f32` or `f64`";

val LIT_SUFFIX_RANGE_MSG: str =
    "integer literal is out of range for the type its suffix declares";

fun scan_lit_suffix(text: View, start: usize, want: type.PrimClass, unknown: str) R.Result[type.TypeKind, str] {
    if (start >= text.len) { ret R.ok[type.TypeKind, str](expr.LIT_SUFFIX_NONE); }
    val k_opt: O.Option[type.TypeKind] = type.prim_from_view(view(?text.data[start], text.len - start));
    if (O.is_none[type.TypeKind](k_opt)) { ret R.err[type.TypeKind, str](unknown); }
    val k: type.TypeKind = O.unwrap[type.TypeKind](k_opt);
    if (type.prim_desc(k).class != want) { ret R.err[type.TypeKind, str](unknown); }
    ret R.ok[type.TypeKind, str](k);
}

pub fun scan_lit_int(source: str, span: token.Span) R.Result[LitInt, str] {
    val text: View = span_text(source, span);
    if (text.len == 0) { ret R.err[LitInt, str]("empty integer literal"); }

    var i:     usize = 0;
    var base:  i64 = 10;

    if (text.len >= 2 && text.data[0] == '0') {
        if      (text.data[1] == 'x') { base = 16; i = 2; }
        or      (text.data[1] == 'b') { base = 2;  i = 2; }
        or      (text.data[1] == 'o') { base = 8;  i = 2; }
    }

    val u64_max: u64 = 0xFFFFFFFFFFFFFFFF;
    val base_u:  u64 = base:~u64;
    var value:   u64 = 0;
    var saw_digit: bool = false;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == '_') { i = i + 1; cnt; }

        var digit: i64 = 0 - 1;
        if      (c >= '0' && c <= '9') { digit = (c - '0')::i64; }
        or      (c >= 'a' && c <= 'f') { digit = (c - 'a')::i64 + 10; }
        or      (c >= 'A' && c <= 'F') { digit = (c - 'A')::i64 + 10; }

        if (digit >= 0 && digit < base) {
            val d: u64 = digit:~u64;
            if (value > (u64_max - d) / base_u) {
                ret R.err[LitInt, str]("integer literal out of range");
            }
            value = value * base_u + d;
            saw_digit = true;
            i = i + 1;
        }
        or (c == 'u' || c == 'i' || c == 'f') {
            brk;
        }
        or {
            if (base == 16) { ret R.err[LitInt, str]("invalid digit in hexadecimal literal (expected 0-9, a-f, A-F)"); }
            if (base == 2)  { ret R.err[LitInt, str]("invalid digit in binary literal (expected 0 or 1)"); }
            if (base == 8)  { ret R.err[LitInt, str]("invalid digit in octal literal (expected 0-7)"); }
            ret R.err[LitInt, str]("invalid digit in decimal literal (expected 0-9)");
        }
    }

    if (!saw_digit) { ret R.err[LitInt, str]("integer literal has no digits"); }

    val sfx_r: R.Result[type.TypeKind, str] = scan_lit_suffix(text, i, type.PRIM_CLASS_INT, LIT_SUFFIX_INT_MSG);
    if (R.is_err[type.TypeKind, str](sfx_r)) { ret R.err[LitInt, str](R.unwrap_err[type.TypeKind, str](sfx_r)); }
    val sfx: type.TypeKind = R.unwrap_ok[type.TypeKind, str](sfx_r);

    var lit: LitInt;
    lit.value    = value;
    lit.suffix   = sfx;
    lit.in_range = sfx == expr.LIT_SUFFIX_NONE || type.int_fits_either_sign(value, sfx);
    ret R.ok[LitInt, str](lit);
}

pub fun eval_lit_int(source: str, span: token.Span) R.Result[CTValue, EvalFail] {
    val lit_r: R.Result[LitInt, str] = scan_lit_int(source, span);
    if (R.is_err[LitInt, str](lit_r)) { ret reject(R.unwrap_err[LitInt, str](lit_r)); }
    val lit: LitInt = R.unwrap_ok[LitInt, str](lit_r);
    if (!lit.in_range) { ret reject(LIT_SUFFIX_RANGE_MSG); }

    val signed_max: u64 = 0x7FFFFFFFFFFFFFFF;
    val result: R.Result[CTValue, EvalFail] = make_int_value(lit.value:~i64, lit.value > signed_max);
    if (R.is_err[CTValue, EvalFail](result)) { ret result; }
    var out: CTValue = R.unwrap_ok[CTValue, EvalFail](result);
    out.int_width = 64;
    if (lit.suffix != expr.LIT_SUFFIX_NONE) {
        val d: type.PrimDesc = type.prim_desc(lit.suffix);
        out.int_width    = d.bits::u8;
        out.int_unsigned = !d.signed;
    }
    ret R.ok[CTValue, EvalFail](out);
}

fun cmp_ratio_pow2(num: *bignum.Big, den: *bignum.Big, p: i64) i64 {
    var a: bignum.Big;
    var b: bignum.Big;
    bignum.copy(?a, num);
    bignum.copy(?b, den);
    if (p >= 0) { bignum.shl(?b, p::usize); }
    or { bignum.shl(?a, (0 - p)::usize); }
    ret bignum.cmp(?a, ?b);
}

fun decimal_to_f64(mant: *bignum.Big, exp10: i64, trunc: bool) u64 {
    if (bignum.is_zero(mant)) { ret 0; }

    val approx: i64 = exp10 + (bignum.bitlen(mant)::i64 * 1233) / 4096;
    if (approx > 320)  { ret 0x7FF0000000000000; }
    if (approx < -340) { ret 0; }

    var num: bignum.Big;
    var den: bignum.Big;
    bignum.copy(?num, mant);
    bignum.from_u64(?den, 1);
    if (exp10 >= 0) { bignum.mul_pow10(?num, exp10::usize); }
    or { bignum.mul_pow10(?den, (0 - exp10)::usize); }

    var e2: i64 = bignum.bitlen(?num)::i64 - bignum.bitlen(?den)::i64 - 53;
    var done: bool = false;
    for (!done) {
        if (cmp_ratio_pow2(?num, ?den, e2 + 53) >= 0) { e2 = e2 + 1; cnt; }
        if (cmp_ratio_pow2(?num, ?den, e2 + 52) < 0)  { e2 = e2 - 1; cnt; }
        done = true;
    }

    var lsb: i64 = e2;
    if (lsb < -1074) { lsb = -1074; }

    var nn: bignum.Big;
    var dd: bignum.Big;
    bignum.copy(?nn, ?num);
    bignum.copy(?dd, ?den);
    if (lsb >= 0) { bignum.shl(?dd, lsb::usize); }
    or { bignum.shl(?nn, (0 - lsb)::usize); }

    var q: u64 = 0;
    var rem: bignum.Big;
    bignum.copy(?rem, ?nn);
    var b: i64 = 53;
    for (b >= 0) {
        var t: bignum.Big;
        bignum.copy(?t, ?dd);
        bignum.shl(?t, b::usize);
        if (bignum.cmp(?rem, ?t) >= 0) {
            bignum.sub(?rem, ?t);
            q = q | (1::u64 << b::usize);
        }
        b = b - 1;
    }

    var rem2: bignum.Big;
    bignum.copy(?rem2, ?rem);
    bignum.shl(?rem2, 1);
    val c: i64 = bignum.cmp(?rem2, ?dd);
    if (c > 0) { q = q + 1; }
    or (c == 0) {
        if (trunc)             { q = q + 1; }
        or { if ((q & 1) == 1) { q = q + 1; } }
    }

    if (lsb == -1074) {
        ret q;
    }
    var biased: i64 = e2 + 1075;
    if (q == 0x20000000000000) {
        q = 0x10000000000000;
        biased = biased + 1;
    }
    if (biased >= 2047) { ret 0x7FF0000000000000; }
    ret (biased::u64 << 52) | (q & 0xFFFFFFFFFFFFF);
}

pub fun scan_lit_float(source: str, span: token.Span) R.Result[LitFloat, str] {
    val text: View = span_text(source, span);
    if (text.len == 0) { ret R.err[LitFloat, str]("empty float literal"); }

    var mant: bignum.Big;
    bignum.from_u64(?mant, 0);
    var dexp:      i64  = 0;
    var sig:       i64  = 0;
    var trunc:     bool = false;
    var saw_digit: bool = false;
    val MAX_SIG_DIGITS: i64 = 768;

    var i: usize = 0;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == '_')             { i = i + 1; cnt; }
        if (c == '.')             { brk; }
        if (c == 'e' || c == 'E') { brk; }
        if (c == 'f')             { brk; }
        if (c < '0' || c > '9')   { ret R.err[LitFloat, str]("invalid character in float literal"); }
        saw_digit = true;
        if (sig < MAX_SIG_DIGITS) {
            bignum.mul_small(?mant, 10);
            bignum.add_small(?mant, (c - '0')::u32);
            if (!bignum.is_zero(?mant)) { sig = sig + 1; }
        }
        or {
            dexp = dexp + 1;
            if (c != '0') { trunc = true; }
        }
        i = i + 1;
    }

    if (i < text.len && text.data[i] == '.') {
        i = i + 1;
        for (i < text.len) {
            val c: u8 = text.data[i];
            if (c == '_')             { i = i + 1; cnt; }
            if (c == 'e' || c == 'E') { brk; }
            if (c == 'f')             { brk; }
            if (c < '0' || c > '9')   { ret R.err[LitFloat, str]("invalid character in float literal"); }
            saw_digit = true;
            if (sig < MAX_SIG_DIGITS) {
                bignum.mul_small(?mant, 10);
                bignum.add_small(?mant, (c - '0')::u32);
                if (!bignum.is_zero(?mant)) { sig = sig + 1; }
                dexp = dexp - 1;
            }
            or {
                if (c != '0') { trunc = true; }
            }
            i = i + 1;
        }
    }

    var exp: i64 = 0;
    if (i < text.len && (text.data[i] == 'e' || text.data[i] == 'E')) {
        i = i + 1;
        var neg: bool = false;
        if (i < text.len && text.data[i] == '-') { neg = true; i = i + 1; }
        or (i < text.len && text.data[i] == '+') { i = i + 1; }

        var saw_exp_digit: bool = false;
        for (i < text.len) {
            val c: u8 = text.data[i];
            if (c == 'f')           { brk; }
            if (c == '_')           { i = i + 1; cnt; }
            if (c < '0' || c > '9') { ret R.err[LitFloat, str]("invalid character in float exponent"); }
            if (exp < 1000000) { exp = exp * 10 + (c - '0')::i64; }
            saw_exp_digit = true;
            i = i + 1;
        }
        if (!saw_exp_digit) { ret R.err[LitFloat, str]("missing digits in float exponent"); }
        if (neg)            { exp = 0 - exp; }
    }

    if (!saw_digit) { ret R.err[LitFloat, str]("float literal has no digits"); }

    val sfx_r: R.Result[type.TypeKind, str] = scan_lit_suffix(text, i, type.PRIM_CLASS_FLOAT, LIT_SUFFIX_FLOAT_MSG);
    if (R.is_err[type.TypeKind, str](sfx_r)) { ret R.err[LitFloat, str](R.unwrap_err[type.TypeKind, str](sfx_r)); }
    val sfx: type.TypeKind = R.unwrap_ok[type.TypeKind, str](sfx_r);

    val bits: u64 = decimal_to_f64(?mant, dexp + exp, trunc);

    var lit: LitFloat;
    lit.value  = float.round_at(float.bits_f64(bits), type.float_width_of(sfx));
    lit.suffix = sfx;
    ret R.ok[LitFloat, str](lit);
}

pub fun eval_lit_float(source: str, span: token.Span) R.Result[CTValue, EvalFail] {
    val lit_r: R.Result[LitFloat, str] = scan_lit_float(source, span);
    if (R.is_err[LitFloat, str](lit_r)) { ret reject(R.unwrap_err[LitFloat, str](lit_r)); }
    val lit: LitFloat = R.unwrap_ok[LitFloat, str](lit_r);
    ret R.ok[CTValue, EvalFail](ct_float(lit.value, type.float_width_of(lit.suffix)));
}

pub fun eval_lit_char(source: str, span: token.Span) R.Result[CTValue, EvalFail] {
    val text: View = span_text(source, span);
    if (text.len < 3) { ret reject("malformed character literal"); }
    if (text.data[0] != '\'' || text.data[text.len - 1] != '\'') {
        ret reject("character literal not delimited by single quotes");
    }

    val inner: View = view(?text.data[1], text.len - 2);

    val r: R.Result[u8, str] = decode_char(inner);
    if (R.is_err[u8, str](r)) {
        ret reject(R.unwrap_err[u8, str](r));
    }

    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 8;
    v.data.i       = R.unwrap_ok[u8, str](r)::i64;
    ret R.ok[CTValue, EvalFail](v);
}

fun eval_lit_str(source: str, span: token.Span, interner: *intern.Interner) R.Result[CTValue, EvalFail] {
    val text: View = span_text(source, span);
    if (text.len < 2) { ret reject("malformed string literal"); }

    val open: u8 = text.data[0];
    if (open != '"') {
        ret reject("string literal not delimited");
    }
    if (text.data[text.len - 1] != open) {
        ret reject("string literal missing closing delimiter");
    }

    val inner: View = view(?text.data[1], text.len - 2);

    val s_r: R.Result[intern.StrId, EvalFail] = intern_decoded(interner, inner);
    if (R.is_err[intern.StrId, EvalFail](s_r)) {
        ret R.err[CTValue, EvalFail](R.unwrap_err[intern.StrId, EvalFail](s_r));
    }

    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = R.unwrap_ok[intern.StrId, EvalFail](s_r);
    ret R.ok[CTValue, EvalFail](v);
}

fun intern_decoded(interner: *intern.Interner, inner: View) R.Result[intern.StrId, EvalFail] {
    val has_escape: bool = view_contains_char(inner, '\\');
    if (!has_escape) {
        ret eval_internal_result[intern.StrId](intern.intern_bytes(interner, inner.data::str, inner.len));
    }

    val r_buf: R.Result[*u8, str] = A.allocate[u8](interner.a, inner.len);
    if (R.is_err[*u8, str](r_buf)) {
        ret R.err[intern.StrId, EvalFail](eval_error(EVAL_FAIL_INTERNAL, R.unwrap_err[*u8, str](r_buf)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](r_buf);

    var read:  usize = 0;
    var write: usize = 0;
    for (read < inner.len) {
        val c: u8 = inner.data[read];
        if (c != '\\') {
            buf[write] = c;
            read  = read + 1;
            write = write + 1;
            cnt;
        }
        if (read + 1 >= inner.len) {
            A.deallocate[u8](interner.a, buf, inner.len);
            ret R.err[intern.StrId, EvalFail](eval_error(EVAL_FAIL_REJECTED, "stray backslash at end of string literal"));
        }
        var consumed: usize = 0;
        val esc_r: R.Result[u8, str] = decode_escape((?inner.data[read])::*u8, inner.len - read, ?consumed);
        if (R.is_err[u8, str](esc_r)) {
            A.deallocate[u8](interner.a, buf, inner.len);
            ret R.err[intern.StrId, EvalFail](eval_error(EVAL_FAIL_REJECTED, R.unwrap_err[u8, str](esc_r)));
        }
        buf[write] = R.unwrap_ok[u8, str](esc_r);
        read  = read + consumed;
        write = write + 1;
    }

    val id_r: R.Result[intern.StrId, str] = intern.intern_bytes(interner, buf::str, write);
    A.deallocate[u8](interner.a, buf, inner.len);
    ret eval_internal_result[intern.StrId](id_r);
}

fun decode_char(inner: View) R.Result[u8, str] {
    if (inner.len == 0) { ret R.err[u8, str]("empty character literal; must contain exactly one character or escape"); }
    if (inner.data[0] != '\\') {
        if (inner.len != 1) { ret R.err[u8, str]("character literal must contain exactly one character"); }
        ret R.ok[u8, str](inner.data[0]);
    }
    var consumed: usize = 0;
    val r: R.Result[u8, str] = decode_escape(inner.data::*u8, inner.len, ?consumed);
    if (R.is_err[u8, str](r)) { ret r; }
    if (consumed != inner.len) {
        ret R.err[u8, str]("character literal must contain exactly one escape sequence");
    }
    ret r;
}

fun decode_escape(p: *u8, len: usize, out_consumed: *usize) R.Result[u8, str] {
    if (len < 2) { ret R.err[u8, str]("incomplete escape sequence"); }
    val c: u8 = p[1];

    if (c == 'n')  { @out_consumed = 2; ret R.ok[u8, str](10); }
    if (c == 't')  { @out_consumed = 2; ret R.ok[u8, str](9); }
    if (c == 'r')  { @out_consumed = 2; ret R.ok[u8, str](13); }
    if (c == '\\') { @out_consumed = 2; ret R.ok[u8, str](92); }
    if (c == '\'') { @out_consumed = 2; ret R.ok[u8, str](39); }
    if (c == '"')  { @out_consumed = 2; ret R.ok[u8, str](34); }
    if (c == '0')  { @out_consumed = 2; ret R.ok[u8, str](0); }
    if (c == 'x') {
        if (len < 4) { ret R.err[u8, str]("incomplete \\x escape"); }
        val hi: i64 = hex_digit(p[2]);
        val lo: i64 = hex_digit(p[3]);
        if (hi < 0 || lo < 0) { ret R.err[u8, str]("invalid \\x escape"); }
        @out_consumed = 4;
        ret R.ok[u8, str]((hi * 16 + lo)::u8);
    }
    ret R.err[u8, str]("unknown escape sequence (valid: \\n \\t \\r \\\\ \\' \\\" \\0 \\xHH)");
}

fun hex_digit(c: u8) i64 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i64; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i64 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i64 + 10; }
    ret 0 - 1;
}

fun eval_binary[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    bin:      *expr.ExprBinary,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) R.Result[CTValue, EvalFail] {
    if (bin.op == expr.BIN_ASSIGN) { ret reject("assignment is not comptime-evaluable"); }

    if (bin.op == expr.BIN_AND || bin.op == expr.BIN_OR) {
        ret eval_logical[T](c, cap_ctx, caps, a, source, bin, interner);
    }

    if (bin.op == expr.BIN_EQ || bin.op == expr.BIN_NEQ) {
        var type_comparison: bool = is_type_comparison(a, source, bin);
        if (!type_comparison) {
            val l: R.Result[bool, EvalFail] = field_type_eval_operand[T](c, cap_ctx, caps, a, source, bin.lhs, interner);
            if (R.is_err[bool, EvalFail](l)) { ret R.err[CTValue, EvalFail](R.unwrap_err[bool, EvalFail](l)); }
            type_comparison = R.unwrap_ok[bool, EvalFail](l);
        }
        if (!type_comparison) {
            val r: R.Result[bool, EvalFail] = field_type_eval_operand[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
            if (R.is_err[bool, EvalFail](r)) { ret R.err[CTValue, EvalFail](R.unwrap_err[bool, EvalFail](r)); }
            type_comparison = R.unwrap_ok[bool, EvalFail](r);
        }
        if (type_comparison) { ret eval_type_comparison[T](c, cap_ctx, caps, a, source, bin, interner); }
    }

    val lhs_r: R.Result[CTValue, EvalFail] = evaluate_at_float_width[T](c, cap_ctx, caps, a, source, bin.lhs, interner, operand_fw);
    if (R.is_err[CTValue, EvalFail](lhs_r)) { ret lhs_r; }
    val rhs_r: R.Result[CTValue, EvalFail] = evaluate_at_float_width[T](c, cap_ctx, caps, a, source, bin.rhs, interner, operand_fw);
    if (R.is_err[CTValue, EvalFail](rhs_r)) { ret rhs_r; }

    val lhs: CTValue = R.unwrap_ok[CTValue, EvalFail](lhs_r);
    val rhs: CTValue = R.unwrap_ok[CTValue, EvalFail](rhs_r);

    if (bin.op == expr.BIN_EQ || bin.op == expr.BIN_NEQ) {
        ret apply_equality(bin.op, lhs, rhs);
    }
    if (bin.op == expr.BIN_LT || bin.op == expr.BIN_LEQ
     || bin.op == expr.BIN_GT || bin.op == expr.BIN_GEQ) {
        ret apply_compare(bin.op, lhs, rhs);
    }
    ret apply_arith(bin.op, lhs, rhs);
}

fun eval_unary[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    un:       *expr.ExprUnary,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) R.Result[CTValue, EvalFail] {
    if (un.op == expr.UN_ADDR || un.op == expr.UN_DEREF) {
        ret reject("address-of and dereference are not comptime-evaluable");
    }

    val r: R.Result[CTValue, EvalFail] = evaluate_at_float_width[T](c, cap_ctx, caps, a, source, un.operand, interner, fw);
    if (R.is_err[CTValue, EvalFail](r)) { ret r; }
    val v: CTValue = R.unwrap_ok[CTValue, EvalFail](r);

    if (un.op == expr.UN_NEG) {
        if (v.kind == CT_KIND_INT)   { ret ct_negate(v); }
        if (v.kind == CT_KIND_FLOAT) { ret float_value(float.f64_neg(v.data.f), v.float_width); }
        ret reject("unary - requires a numeric operand");
    }
    if (un.op == expr.UN_NOT) {
        if (v.kind != CT_KIND_INT || (v.int_width != 0 && !is_u8(v))) {
            ret reject("unary ! requires a u8 operand");
        }
        var out: CTValue = ct_u8(if_u8(v.data.i != 1));
        if (v.int_width == 0) { out.int_width = 0; }
        ret R.ok[CTValue, EvalFail](out);
    }
    if (un.op == expr.UN_BIT_NOT) {
        if (v.kind != CT_KIND_INT) { ret reject("unary ~ requires an integer operand"); }
        ret make_int_value(~v.data.i, v.int_unsigned);
    }
    ret reject("unsupported unary operator");
}

fun eval_logical[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    bin:      *expr.ExprBinary,
    interner: *intern.Interner
) R.Result[CTValue, EvalFail] {
    val lhs_r: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, bin.lhs, interner);
    if (R.is_err[CTValue, EvalFail](lhs_r)) { ret lhs_r; }
    val lhs: CTValue = R.unwrap_ok[CTValue, EvalFail](lhs_r);
    if (lhs.kind != CT_KIND_INT || (lhs.int_width != 0 && !is_u8(lhs))) {
        ret reject("logical operator requires u8 operands");
    }

    if ((bin.op == expr.BIN_AND && lhs.data.i != 1) || (bin.op == expr.BIN_OR && lhs.data.i == 1)) {
        ret short_circuit[T](c, cap_ctx, caps, a, source, bin, interner, lhs);
    }

    val rhs_r: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
    if (R.is_err[CTValue, EvalFail](rhs_r)) { ret rhs_r; }
    val rhs: CTValue = R.unwrap_ok[CTValue, EvalFail](rhs_r);
    if (rhs.kind != CT_KIND_INT || (rhs.int_width != 0 && !is_u8(rhs))) {
        ret reject("logical operator requires u8 operands");
    }

    var out: CTValue = ct_u8(if_u8(rhs.data.i == 1));
    if (lhs.int_width == 0 || rhs.int_width == 0) { out.int_width = 0; }
    ret R.ok[CTValue, EvalFail](out);
}

fun short_circuit[T](
    c: *ComptimeCtx, cap_ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, source: str,
    bin: *expr.ExprBinary, interner: *intern.Interner, lhs: CTValue,
) R.Result[CTValue, EvalFail] {
    var out: CTValue = ct_u8(if_u8(bin.op == expr.BIN_OR));
    out.int_width = lhs.int_width;
    val rhs_r: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
    if (R.is_err[CTValue, EvalFail](rhs_r)) {
        if (R.unwrap_err[CTValue, EvalFail](rhs_r).kind == EVAL_FAIL_INTERNAL) { ret rhs_r; }
        ret R.ok[CTValue, EvalFail](out);
    }
    val rhs: CTValue = R.unwrap_ok[CTValue, EvalFail](rhs_r);
    if (rhs.kind != CT_KIND_INT || (rhs.int_width != 0 && !is_u8(rhs))) {
        ret reject("logical operator requires u8 operands");
    }
    if (rhs.int_width == 0) { out.int_width = 0; }
    ret R.ok[CTValue, EvalFail](out);
}

fun is_comptime_call(a: *ast.Ast, source: str, eid: id.ExprId, name: str) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret false; }
    val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
    if (node.kind != expr.EXPR_KIND_CALL) { ret false; }
    val ce_opt: O.Option[*expr.Expr] = ast.get_expr(a, node.data.call.callee);
    if (O.is_none[*expr.Expr](ce_opt)) { ret false; }
    val ce: *expr.Expr = O.unwrap[*expr.Expr](ce_opt);
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret false; }
    val ns: token.Span = comptime_ident_name(ce.span);
    if (ns.len == 0) { ret false; }
    ret view_eq_str(span_text(source, ns), name);
}

fun first_call_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    if (eid == id.EXPR_NIL) { ret id.EXPR_NIL; }
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret id.EXPR_NIL; }
    val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
    if (node.kind != expr.EXPR_KIND_CALL) { ret id.EXPR_NIL; }
    if (node.data.call.args_len < 1)      { ret id.EXPR_NIL; }
    ret a.expr_ids[node.data.call.args_start];
}

pub fun intrinsic_takes_type_operand(source: str, full: token.Span) bool {
    val ns: token.Span = comptime_ident_name(full);
    if (ns.len == 0) { ret false; }
    val text: View = span_text(source, ns);
    ret view_eq_str(text, "size_of")
     || view_eq_str(text, "length_of")
     || view_eq_str(text, "align_of")
     || view_eq_str(text, "offset_of")
     || view_eq_str(text, "fields")
     || view_eq_str(text, "is_record")
     || view_eq_str(text, "is_union")
     || view_eq_str(text, "is_pointer")
     || view_eq_str(text, "is_secret")
     || view_eq_str(text, "type_name");
}

pub fun is_type_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "type_of");
}

pub fun type_of_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    ret first_call_arg(a, eid);
}

pub fun is_fields_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "fields");
}

pub fun comptime_if_declares_nothing(a: *ast.Ast, branches_start: u32, branches_len: u32) bool {
    var bi: u32 = 0;
    for (bi < branches_len) {
        val branch_ix: u32 = branches_start + bi;
        if (branch_ix::usize >= a.comptime_branch_len) { ret false; }
        val br: *decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
        var di: u32 = 0;
        for (di < br.body_len) {
            val pool_ix: u32 = br.body_start + di;
            if (pool_ix::usize >= a.decl_id_len) { ret false; }
            if (!decl_declares_nothing(a, a.decl_ids[pool_ix])) { ret false; }
            di = di + 1;
        }
        bi = bi + 1;
    }
    ret true;
}

fun decl_declares_nothing(a: *ast.Ast, did: id.DeclId) bool {
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, did);
    if (O.is_none[*decl.Decl](d_opt)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) { ret true; }
    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret comptime_if_declares_nothing(a, d.data.comptime_if.branches_start, d.data.comptime_if.branches_len);
    }
    ret false;
}

pub def GateProbe: u8;

pub val GATE_PROBE_COMPTIME_PARAM:   GateProbe = 0;
pub val GATE_PROBE_LAYOUT_INTRINSIC: GateProbe = 1;
pub val GATE_PROBE_TYPE_COMPARISON:  GateProbe = 2;
pub val GATE_PROBE_FIELD_DESCRIPTOR: GateProbe = 3;
pub val GATE_PROBE_EACH_LOOPVAR:     GateProbe = 4;
pub val GATE_PROBE_TARGET_DEPENDENT: GateProbe = 5;
pub val GATE_PROBE_NODE_ACTION:      GateProbe = 6;

pub val GATE_PROBE_COUNT: u32 = 5;

pub def GateNodeVerdict: u8;

pub val GATE_NODE_NO:    GateNodeVerdict = 0;
pub val GATE_NODE_YES:   GateNodeVerdict = 1;
pub val GATE_NODE_PRUNE: GateNodeVerdict = 2;

pub val GATE_PROBE_UNLISTED_KIND_MSG: str =
    "internal: this expression kind has no entry in the compile-time dependency visitor; a gate that nests it cannot be scanned for dependencies";

pub val GATE_PROBE_NO_OBSERVER_MSG: str =
    "internal: this phase did not supply the observer a compile-time dependency probe needs";

pub rec GateProbes[T] {
    comptime_param:     fun(*T, id.ExprId) bool;
    each_loopvar:       fun(*T, id.ExprId) bool;
    field_loopvar:      fun(*T, id.ExprId) bool;
    field_type_operand: fun(*T, id.ExprId) bool;
    node_action:        fun(*T, id.ExprId, *expr.Expr) GateNodeVerdict;
}

pub fun gate_probes[T](
    comptime_param:     fun(*T, id.ExprId) bool,
    each_loopvar:       fun(*T, id.ExprId) bool,
    field_loopvar:      fun(*T, id.ExprId) bool,
    field_type_operand: fun(*T, id.ExprId) bool
) GateProbes[T] {
    var p: GateProbes[T];
    p.comptime_param     = comptime_param;
    p.each_loopvar       = each_loopvar;
    p.field_loopvar      = field_loopvar;
    p.field_type_operand = field_type_operand;
    p.node_action        = nil;
    ret p;
}

pub fun gate_node_action_probes[T](action: fun(*T, id.ExprId, *expr.Expr) GateNodeVerdict) GateProbes[T] {
    var p: GateProbes[T] = gate_probes[T](nil, nil, nil, nil);
    p.node_action = action;
    ret p;
}

pub fun gate_walk[T](a: *ast.Ast, source: str, obs: *T,
                     action: fun(*T, id.ExprId, *expr.Expr) GateNodeVerdict,
                     eid: id.ExprId) R.Result[bool, str] {
    ret gate_depends_on[T](a, source, obs, gate_node_action_probes[T](action), GATE_PROBE_NODE_ACTION, eid);
}

pub fun gate_chain_depends_on[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    branches_start: u32, branches_len: u32
) R.Result[bool, str] {
    var bi: u32 = 0;
    for (bi < branches_len) {
        val branch_ix: u32 = branches_start + bi;
        if (branch_ix::usize >= a.comptime_branch_len) {
            ret R.err[bool, str]("comptime branch index out of range in the dependency visitor");
        }
        val br: *decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
        if (br.cond != id.EXPR_NIL) {
            val depends_r: R.Result[bool, str] = gate_depends_on[T](a, source, obs, probes, probe, br.cond);
            if (R.is_err[bool, str](depends_r))    { ret depends_r; }
            if (R.unwrap_ok[bool, str](depends_r)) { ret depends_r; }
        }
        bi = bi + 1;
    }
    ret R.ok[bool, str](false);
}

pub fun gate_needs_typed_selection(a: *ast.Ast, source: str, eid: id.ExprId) R.Result[bool, str] {
    ret gate_depends_on[NoCapabilityContext](a, source, nil,
        gate_probes[NoCapabilityContext](nil, nil, nil, nil),
        GATE_PROBE_TARGET_DEPENDENT, eid);
}

pub def GateScope: u8;

pub val GATE_SCOPE_DECL:     GateScope = 0;
pub val GATE_SCOPE_INSTANCE: GateScope = 1;

pub val GATE_U8_MSG: str =
    "comptime branch condition must have type u8";

pub val GATE_U8_FLOAT_MSG: str =
    "comptime branch condition must have type u8, found float";

pub val GATE_U8_STR_MSG: str =
    "comptime branch condition must have type u8, found str";

pub rec GateVerdict {
    outcome: GateOutcome;
    fail:    EvalFailKind;
    message: str;
    span:    token.Span;
    depends: intern.StrId;
    value:   CTValue;
}

fun gate_verdict(outcome: GateOutcome, message: str, span: token.Span, depends: intern.StrId) GateVerdict {
    var v: GateVerdict;
    v.outcome = outcome;
    v.fail    = EVAL_FAIL_NONE;
    v.message = message;
    v.span    = span;
    v.depends = depends;
    v.value.kind      = CT_KIND_INT;
    v.value.int_width = 0;
    v.value.data.i    = 0;
    ret v;
}

fun gate_verdict_valued(outcome: GateOutcome, span: token.Span, value: CTValue) GateVerdict {
    var v: GateVerdict = gate_verdict(outcome, "", span, intern.STR_NIL);
    v.value = value;
    ret v;
}

fun gate_failure_awaits_phase[T](cap_ctx: *T, caps: PhaseCapabilities[T], kind: EvalFailKind) bool {
    if (kind == EVAL_FAIL_NEEDS_MEMBER) {
        ret !capabilities_have_member[T](cap_ctx, caps);
    }
    if (kind == EVAL_FAIL_NEEDS_TYPES || kind == EVAL_FAIL_NEEDS_LAYOUT) {
        ret !capabilities_have_types[T](cap_ctx, caps);
    }
    ret false;
}

fun gate_verdict_failed(outcome: GateOutcome, f: EvalFail, span: token.Span, depends: intern.StrId) GateVerdict {
    var v: GateVerdict = gate_verdict(outcome, f.message, span, depends);
    v.fail = f.kind;
    ret v;
}

fun gate_u8_message(v: CTValue) str {
    if (v.kind == CT_KIND_FLOAT) { ret GATE_U8_FLOAT_MSG; }
    if (v.kind == CT_KIND_STR)   { ret GATE_U8_STR_MSG; }
    ret GATE_U8_MSG;
}

rec GateNameProbe {
    c:        *ComptimeCtx;
    source:   str;
    interner: *intern.Interner;
    found:    intern.StrId;
}

fun gate_name_probe_node(g: *GateNameProbe, eid: id.ExprId, e: *expr.Expr) GateNodeVerdict {
    if (g.found != intern.STR_NIL)      { ret GATE_NODE_PRUNE; }
    if (e.kind != expr.EXPR_KIND_IDENT) { ret GATE_NODE_NO; }
    val r: R.Result[intern.StrId, str] = intern.intern_span(g.interner, g.source, e.span);
    if (R.is_err[intern.StrId, str](r)) { ret GATE_NODE_NO; }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](r);
    if (O.is_some[NamedConst](lookup(g.c, name)))        { ret GATE_NODE_NO; }
    if (O.is_some[NamedConst](lookup_define(g.c, name))) { ret GATE_NODE_NO; }
    g.found = name;
    ret GATE_NODE_PRUNE;
}

pub fun gate_unresolved_dependency(c: *ComptimeCtx, a: *ast.Ast, source: str,
                                   interner: *intern.Interner, cond: id.ExprId) intern.StrId {
    if (c == nil || interner == nil) { ret intern.STR_NIL; }
    var g: GateNameProbe;
    g.c        = c;
    g.source   = source;
    g.interner = interner;
    g.found    = intern.STR_NIL;
    val matched_r: R.Result[bool, str] = gate_walk[GateNameProbe](a, source, ?g, gate_name_probe_node, cond);
    if (R.is_err[bool, str](matched_r)) { ret intern.STR_NIL; }
    ret g.found;
}

pub fun evaluate_gate[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    cond:     id.ExprId,
    interner: *intern.Interner,
    scope:    GateScope,
    cache:    bool,
    terminal: bool
) R.Result[GateVerdict, str] {
    var nil_span: token.Span;
    nil_span.offset = 0;
    nil_span.len    = 0;
    if (cond == id.EXPR_NIL) {
        ret R.ok[GateVerdict, str](gate_verdict(GATE_ACTIVE, "", nil_span, intern.STR_NIL));
    }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(a, cond);
    if (O.is_none[*expr.Expr](e_opt)) {
        ret R.err[GateVerdict, str]("comptime branch cond ExprId out of range");
    }
    val span: token.Span = O.unwrap[*expr.Expr](e_opt).span;

    val cacheable: bool = cache;
    if (cacheable) {
        val cached: GateState = gate_state(c, cond);
        if (cached == GATE_STATE_TRUE) {
            ret R.ok[GateVerdict, str](gate_verdict(GATE_ACTIVE, "", span, intern.STR_NIL));
        }
        if (cached == GATE_STATE_FALSE) {
            ret R.ok[GateVerdict, str](gate_verdict(GATE_INACTIVE, "", span, intern.STR_NIL));
        }
        if (cached == GATE_STATE_REJECTED) {
            ret R.ok[GateVerdict, str](gate_verdict(GATE_REJECTED, "", span, intern.STR_NIL));
        }
    }
    or (gate_state(c, cond) == GATE_STATE_REJECTED) {
        ret R.ok[GateVerdict, str](gate_verdict(GATE_REJECTED, "", span, intern.STR_NIL));
    }

    val r: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, cond, interner);
    if (R.is_err[CTValue, EvalFail](r)) {
        val f: EvalFail = R.unwrap_err[CTValue, EvalFail](r);
        if (f.kind == EVAL_FAIL_INTERNAL) { ret R.err[GateVerdict, str](f.message); }
        if (f.kind == EVAL_FAIL_NEEDS_LAYOUT && scope == GATE_SCOPE_DECL) {
            ret R.ok[GateVerdict, str](gate_verdict_failed(GATE_AWAITING_LAYOUT, f, span, intern.STR_NIL));
        }
        if (scope == GATE_SCOPE_INSTANCE && gate_eval_failure_is_transient(f.kind)) {
            ret R.ok[GateVerdict, str](gate_verdict_failed(GATE_AWAITING_PHASE, f, span, intern.STR_NIL));
        }
        if (gate_failure_awaits_phase[T](cap_ctx, caps, f.kind)) {
            ret R.ok[GateVerdict, str](gate_verdict_failed(GATE_AWAITING_PHASE, f, span, intern.STR_NIL));
        }
        val depends: intern.StrId = gate_unresolved_dependency(c, a, source, interner, cond);
        if (!terminal) {
            ret R.ok[GateVerdict, str](gate_verdict_failed(GATE_DEFERRED, f, span, depends));
        }
        ret R.ok[GateVerdict, str](gate_verdict_failed(GATE_FAILED, f, span, depends));
    }

    val v: CTValue = R.unwrap_ok[CTValue, EvalFail](r);
    if (v.kind != CT_KIND_INT || (v.int_width != 0 && !is_u8(v))) {
        if (cacheable) { set_gate_state(c, cond, GATE_STATE_REJECTED); }
        var rej: GateVerdict = gate_verdict(GATE_REJECTED, gate_u8_message(v), span, intern.STR_NIL);
        rej.value = v;
        ret R.ok[GateVerdict, str](rej);
    }
    if (v.int_width == 0) {
        ret R.ok[GateVerdict, str](gate_verdict_valued(GATE_AWAITING_TYPES, span, v));
    }
    if (truth(v)) {
        if (cacheable) { set_gate_state(c, cond, GATE_STATE_TRUE); }
        ret R.ok[GateVerdict, str](gate_verdict(GATE_ACTIVE, "", span, intern.STR_NIL));
    }
    if (cacheable) { set_gate_state(c, cond, GATE_STATE_FALSE); }
    ret R.ok[GateVerdict, str](gate_verdict(GATE_INACTIVE, "", span, intern.STR_NIL));
}

pub fun gate_chain_defers[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T],
    branches_start: u32, branches_len: u32
) R.Result[bool, str] {
    var pi: u32 = 0;
    for (pi < GATE_PROBE_COUNT) {
        val depends_r: R.Result[bool, str] = gate_chain_depends_on[T](a, source, obs, probes, pi::GateProbe, branches_start, branches_len);
        if (R.is_err[bool, str](depends_r))    { ret depends_r; }
        if (R.unwrap_ok[bool, str](depends_r)) { ret depends_r; }
        pi = pi + 1;
    }
    ret R.ok[bool, str](false);
}

pub fun gate_depends_on[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe, eid: id.ExprId
) R.Result[bool, str] {
    if (eid == id.EXPR_NIL) { ret R.ok[bool, str](false); }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](e_opt)) {
        ret R.err[bool, str]("gate condition ExprId out of range in the dependency visitor");
    }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);

    val here: R.Result[GateNodeVerdict, str] = gate_probe_node[T](a, source, obs, probes, probe, eid, e);
    if (R.is_err[GateNodeVerdict, str](here)) {
        ret R.err[bool, str](R.unwrap_err[GateNodeVerdict, str](here));
    }
    val verdict: GateNodeVerdict = R.unwrap_ok[GateNodeVerdict, str](here);
    if (verdict == GATE_NODE_YES)   { ret R.ok[bool, str](true); }
    if (verdict == GATE_NODE_PRUNE) { ret R.ok[bool, str](false); }

    ret gate_depends_on_children[T](a, source, obs, probes, probe, e);
}

fun gate_probe_node[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    eid: id.ExprId, e: *expr.Expr
) R.Result[GateNodeVerdict, str] {
    if (probe == GATE_PROBE_COMPTIME_PARAM) {
        if (e.kind != expr.EXPR_KIND_IDENT) { ret R.ok[GateNodeVerdict, str](GATE_NODE_NO); }
        if (probes.comptime_param == nil)   { ret R.err[GateNodeVerdict, str](GATE_PROBE_NO_OBSERVER_MSG); }
        ret R.ok[GateNodeVerdict, str](gate_node_if(probes.comptime_param(obs, eid)));
    }
    if (probe == GATE_PROBE_EACH_LOOPVAR) {
        if (e.kind != expr.EXPR_KIND_IDENT) { ret R.ok[GateNodeVerdict, str](GATE_NODE_NO); }
        if (probes.each_loopvar == nil)     { ret R.err[GateNodeVerdict, str](GATE_PROBE_NO_OBSERVER_MSG); }
        ret R.ok[GateNodeVerdict, str](gate_node_if(probes.each_loopvar(obs, eid)));
    }
    if (probe == GATE_PROBE_FIELD_DESCRIPTOR) {
        if (!is_field_descriptor_member(a, source, eid)) { ret R.ok[GateNodeVerdict, str](GATE_NODE_NO); }
        if (probes.field_loopvar == nil)    { ret R.err[GateNodeVerdict, str](GATE_PROBE_NO_OBSERVER_MSG); }
        ret R.ok[GateNodeVerdict, str](gate_node_if(probes.field_loopvar(obs, eid)));
    }
    if (probe == GATE_PROBE_LAYOUT_INTRINSIC) {
        ret R.ok[GateNodeVerdict, str](gate_node_if(is_layout_intrinsic_call(a, source, eid)));
    }
    if (probe == GATE_PROBE_TYPE_COMPARISON) {
        if (e.kind == expr.EXPR_KIND_BINARY
         && (e.data.binary.op == expr.BIN_EQ || e.data.binary.op == expr.BIN_NEQ)) {
            if (is_type_comparison(a, source, ?e.data.binary)) { ret R.ok[GateNodeVerdict, str](GATE_NODE_YES); }
            if (probes.field_type_operand == nil) { ret R.err[GateNodeVerdict, str](GATE_PROBE_NO_OBSERVER_MSG); }
            if (probes.field_type_operand(obs, e.data.binary.lhs)) { ret R.ok[GateNodeVerdict, str](GATE_NODE_YES); }
            ret R.ok[GateNodeVerdict, str](gate_node_if(probes.field_type_operand(obs, e.data.binary.rhs)));
        }
        ret R.ok[GateNodeVerdict, str](gate_node_if(is_type_query_call(a, source, eid)));
    }
    if (probe == GATE_PROBE_TARGET_DEPENDENT) {
        ret R.ok[GateNodeVerdict, str](gate_target_dependent_node(a, source, eid, e));
    }
    if (probe == GATE_PROBE_NODE_ACTION) {
        if (probes.node_action == nil) { ret R.err[GateNodeVerdict, str](GATE_PROBE_NO_OBSERVER_MSG); }
        ret R.ok[GateNodeVerdict, str](probes.node_action(obs, eid, e));
    }
    ret R.err[GateNodeVerdict, str]("internal: unknown compile-time dependency probe");
}

fun gate_node_if(matched: bool) GateNodeVerdict {
    if (matched) { ret GATE_NODE_YES; }
    ret GATE_NODE_NO;
}

fun gate_target_dependent_node(a: *ast.Ast, source: str, eid: id.ExprId, e: *expr.Expr) GateNodeVerdict {
    val k: expr.ExprKind = e.kind;
    if (k == expr.EXPR_KIND_LIT_INT   || k == expr.EXPR_KIND_LIT_FLOAT
     || k == expr.EXPR_KIND_LIT_CHAR  || k == expr.EXPR_KIND_LIT_STR
     || k == expr.EXPR_KIND_LIT_NIL   || k == expr.EXPR_KIND_COMPTIME_IDENT) {
        ret GATE_NODE_PRUNE;
    }
    if (k == expr.EXPR_KIND_MEMBER && is_comptime_path(a, eid))            { ret GATE_NODE_PRUNE; }
    if (k == expr.EXPR_KIND_CALL && is_layout_intrinsic_call(a, source, eid)) { ret GATE_NODE_PRUNE; }
    if (k == expr.EXPR_KIND_BINARY || k == expr.EXPR_KIND_UNARY)           { ret GATE_NODE_NO; }
    ret GATE_NODE_YES;
}

fun gate_depends_on_children[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe, e: *expr.Expr
) R.Result[bool, str] {
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_BINARY) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.binary.lhs, e.data.binary.rhs);
    }
    if (k == expr.EXPR_KIND_UNARY) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.unary.operand);
    }
    if (k == expr.EXPR_KIND_CALL || k == expr.EXPR_KIND_GENERIC_INSTANCE) {
        val depends_r: R.Result[bool, str] = gate_depends_on_pair[T](a, source, obs, probes, probe,
            e.data.call.callee, e.data.call.index_callee);
        if (R.is_err[bool, str](depends_r))    { ret depends_r; }
        if (R.unwrap_ok[bool, str](depends_r)) { ret depends_r; }
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.call.args_start, e.data.call.args_len);
    }
    if (k == expr.EXPR_KIND_INDEX) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.index.object, e.data.index.index);
    }
    if (k == expr.EXPR_KIND_MEMBER) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.member.object);
    }
    if (k == expr.EXPR_KIND_PROJECT) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.project.object, e.data.project.field);
    }
    if (k == expr.EXPR_KIND_CAST) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.cast.value);
    }
    if (k == expr.EXPR_KIND_STRIP) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.strip.value);
    }
    if (k == expr.EXPR_KIND_SPREAD) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.spread.inner);
    }
    if (k == expr.EXPR_KIND_ARRAY_LIT) {
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.array_lit.elems_start, e.data.array_lit.elems_len);
    }
    if (k == expr.EXPR_KIND_VECTOR_LIT) {
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len);
    }
    if (k == expr.EXPR_KIND_STRUCT_LIT) {
        var fi: u32 = 0;
        for (fi < e.data.struct_lit.fields_len) {
            val pool_ix: u32 = e.data.struct_lit.fields_start + fi;
            if (pool_ix::usize >= a.field_init_len) {
                ret R.err[bool, str]("struct literal field index out of range in the dependency visitor");
            }
            val finit: *expr.FieldInit = ?a.field_inits[pool_ix];
            val depends_r: R.Result[bool, str] = gate_depends_on[T](a, source, obs, probes, probe, finit.value);
            if (R.is_err[bool, str](depends_r))    { ret depends_r; }
            if (R.unwrap_ok[bool, str](depends_r)) { ret depends_r; }
            fi = fi + 1;
        }
        ret R.ok[bool, str](false);
    }
    if (gate_expr_kind_is_leaf(k)) { ret R.ok[bool, str](false); }

    ret R.err[bool, str](GATE_PROBE_UNLISTED_KIND_MSG);
}

fun gate_expr_kind_is_leaf(k: expr.ExprKind) bool {
    ret k == expr.EXPR_KIND_IDENT     || k == expr.EXPR_KIND_LIT_INT
     || k == expr.EXPR_KIND_LIT_FLOAT || k == expr.EXPR_KIND_LIT_CHAR
     || k == expr.EXPR_KIND_LIT_STR   || k == expr.EXPR_KIND_LIT_NIL
     || k == expr.EXPR_KIND_COMPTIME_IDENT
     || k == expr.EXPR_KIND_TYPE_REF  || k == expr.EXPR_KIND_ERROR;
}

fun gate_depends_on_pair[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    first: id.ExprId, second: id.ExprId
) R.Result[bool, str] {
    val depends_r: R.Result[bool, str] = gate_depends_on[T](a, source, obs, probes, probe, first);
    if (R.is_err[bool, str](depends_r))    { ret depends_r; }
    if (R.unwrap_ok[bool, str](depends_r)) { ret depends_r; }
    ret gate_depends_on[T](a, source, obs, probes, probe, second);
}

fun gate_depends_on_list[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    start: u32, len: u32
) R.Result[bool, str] {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= a.expr_id_len) {
            ret R.err[bool, str]("expression list index out of range in the dependency visitor");
        }
        val depends_r: R.Result[bool, str] = gate_depends_on[T](a, source, obs, probes, probe, a.expr_ids[pool_ix]);
        if (R.is_err[bool, str](depends_r))    { ret depends_r; }
        if (R.unwrap_ok[bool, str](depends_r)) { ret depends_r; }
        i = i + 1;
    }
    ret R.ok[bool, str](false);
}

pub fun is_layout_intrinsic_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (is_size_of_call(a, source, eid))   { ret true; }
    if (is_length_of_call(a, source, eid)) { ret true; }
    if (is_align_of_call(a, source, eid))  { ret true; }
    ret is_comptime_call(a, source, eid, "offset_of");
}

pub fun is_length_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "length_of");
}

pub fun is_size_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "size_of");
}

pub fun is_align_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "align_of");
}

pub fun layout_intrinsic_type_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    ret first_call_arg(a, eid);
}

pub fun fields_type_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    ret first_call_arg(a, eid);
}

pub rec ArrayLitInfo {
    elems_start: u32;
    elems_len:   u32;
}

pub fun declared_float_width(a: *ast.Ast, source: str, t: id.TypeId) float.FloatWidth {
    if (t == id.TYPE_NIL) { ret float.FLOAT_W_NONE; }
    val opt: O.Option[*atype.Type] = ast.get_type(a, t);
    if (O.is_none[*atype.Type](opt)) { ret float.FLOAT_W_NONE; }
    val ty: *atype.Type = O.unwrap[*atype.Type](opt);

    if (ty.kind == atype.TYPE_KIND_SECRET) {
        ret declared_float_width(a, source, ty.data.secret.inner);
    }
    if (ty.kind != atype.TYPE_KIND_NAMED)   { ret float.FLOAT_W_NONE; }
    if (ty.data.named.args_len != 0)        { ret float.FLOAT_W_NONE; }

    val text: View = span_text(source, ty.data.named.name);
    if (view_eq_str(text, "f32")) { ret float.FLOAT_W_32; }
    if (view_eq_str(text, "f64")) { ret float.FLOAT_W_64; }
    ret float.FLOAT_W_NONE;
}

pub fun apply_declared_int_type(a: *ast.Ast, source: str, t: id.TypeId, value: CTValue) CTValue {
    var out: CTValue = value;
    if (out.kind != CT_KIND_INT || t == id.TYPE_NIL) { ret out; }
    val opt: O.Option[*atype.Type] = ast.get_type(a, t);
    if (O.is_none[*atype.Type](opt)) { ret out; }
    val ty: *atype.Type = O.unwrap[*atype.Type](opt);
    if (ty.kind == atype.TYPE_KIND_SECRET) { ret apply_declared_int_type(a, source, ty.data.secret.inner, out); }
    if (ty.kind != atype.TYPE_KIND_NAMED || ty.data.named.args_len != 0) { ret out; }
    val text: View = span_text(source, ty.data.named.name);
    out.int_width = 0;
    if (view_eq_str(text, "u8"))  { out.int_unsigned = true;  out.int_width = 8;  }
    if (view_eq_str(text, "u16")) { out.int_unsigned = true;  out.int_width = 16; }
    if (view_eq_str(text, "u32")) { out.int_unsigned = true;  out.int_width = 32; }
    if (view_eq_str(text, "u64")) { out.int_unsigned = true;  out.int_width = 64; }
    if (view_eq_str(text, "i8"))  { out.int_unsigned = false; out.int_width = 8;  }
    if (view_eq_str(text, "i16")) { out.int_unsigned = false; out.int_width = 16; }
    if (view_eq_str(text, "i32")) { out.int_unsigned = false; out.int_width = 32; }
    if (view_eq_str(text, "i64")) { out.int_unsigned = false; out.int_width = 64; }
    ret out;
}

pub fun float_width_unread(v: CTValue) bool {
    ret v.kind == CT_KIND_FLOAT && v.float_width == float.FLOAT_W_NONE;
}

pub fun decl_array_lit(a: *ast.Ast, decl_id: id.DeclId) O.Option[ArrayLitInfo] {
    if (decl_id == id.DECL_NIL) { ret O.none[ArrayLitInfo](); }
    val d_opt: O.Option[*decl.Decl] = ast.get_decl(a, decl_id);
    if (O.is_none[*decl.Decl](d_opt)) { ret O.none[ArrayLitInfo](); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](d_opt);
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) { ret O.none[ArrayLitInfo](); }
    val init: id.ExprId = d.data.bind.init;
    if (init == id.EXPR_NIL) { ret O.none[ArrayLitInfo](); }
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(a, init);
    if (O.is_none[*expr.Expr](e_opt)) { ret O.none[ArrayLitInfo](); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (e.kind != expr.EXPR_KIND_ARRAY_LIT) { ret O.none[ArrayLitInfo](); }
    var info: ArrayLitInfo;
    info.elems_start = e.data.array_lit.elems_start;
    info.elems_len   = e.data.array_lit.elems_len;
    ret O.some[ArrayLitInfo](info);
}

pub fun is_error_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "error");
}

pub fun error_message[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    eid:      id.ExprId,
    interner: *intern.Interner
) R.Result[str, EvalFail] {
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret R.err[str, EvalFail](eval_error(EVAL_FAIL_REJECTED, "comptime `$error` directive is malformed")); }
    val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
    if (node.kind != expr.EXPR_KIND_CALL || node.data.call.args_len != 1) {
        ret R.err[str, EvalFail](eval_error(EVAL_FAIL_REJECTED, "comptime `$error` takes one string-literal message"));
    }
    val arg: id.ExprId = a.expr_ids[node.data.call.args_start];
    val ev: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, arg, interner);
    if (R.is_err[CTValue, EvalFail](ev)) { ret R.err[str, EvalFail](R.unwrap_err[CTValue, EvalFail](ev)); }
    val v: CTValue = R.unwrap_ok[CTValue, EvalFail](ev);
    if (v.kind != CT_KIND_STR) { ret R.err[str, EvalFail](eval_error(EVAL_FAIL_REJECTED, "comptime `$error` message must be a string")); }
    val txt: O.Option[str] = intern.lookup(interner, v.data.s);
    if (O.is_none[str](txt)) { ret R.err[str, EvalFail](eval_error(EVAL_FAIL_INTERNAL, "comptime `$error` message could not be read")); }
    ret R.ok[str, EvalFail](O.unwrap[str](txt));
}

pub fun type_operand_value(a: *ast.Ast, source: str, operand: id.ExprId) id.ExprId {
    if (is_type_of_call(a, source, operand)) { ret type_of_arg(a, operand); }
    ret operand;
}

pub fun is_type_comparison(a: *ast.Ast, source: str, bin: *expr.ExprBinary) bool {
    ret is_type_of_call(a, source, bin.lhs) || is_type_of_call(a, source, bin.rhs);
}

pub fun is_type_comparison_binary(a: *ast.Ast, source: str, bin: *expr.ExprBinary,
                                  lhs_is_field_type: bool, rhs_is_field_type: bool) bool {
    if (bin.op != expr.BIN_EQ && bin.op != expr.BIN_NEQ) { ret false; }
    ret is_type_comparison(a, source, bin) || lhs_is_field_type || rhs_is_field_type;
}

pub fun is_field_type_member(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret false; }
    val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
    if (node.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    ret view_eq_str(span_text(source, node.data.member.name), "type");
}

pub fun is_field_descriptor_member(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret false; }
    val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
    if (node.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    val m: View = span_text(source, node.data.member.name);
    ret view_eq_str(m, "name") || view_eq_str(m, "type") || view_eq_str(m, "offset");
}

fun field_type_eval_operand[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    eid:      id.ExprId,
    interner: *intern.Interner
) R.Result[bool, EvalFail] {
    if (!is_field_type_member(a, source, eid)) { ret R.ok[bool, EvalFail](false); }
    val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, eid);
    if (O.is_none[*expr.Expr](n_opt)) { ret R.ok[bool, EvalFail](false); }
    val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
    val obj_r: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, node.data.member.object, interner);
    if (R.is_err[CTValue, EvalFail](obj_r)) {
        val f: EvalFail = R.unwrap_err[CTValue, EvalFail](obj_r);
        if (f.kind == EVAL_FAIL_INTERNAL) { ret R.err[bool, EvalFail](f); }
        ret R.ok[bool, EvalFail](false);
    }
    ret R.ok[bool, EvalFail](R.unwrap_ok[CTValue, EvalFail](obj_r).kind == CT_KIND_FIELD);
}

fun eval_type_comparison[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    bin:      *expr.ExprBinary,
    interner: *intern.Interner
) R.Result[CTValue, EvalFail] {
    val l_r: R.Result[CTValue, EvalFail] = eval_type_operand[T](c, cap_ctx, caps, a, source, bin.lhs, interner);
    if (R.is_err[CTValue, EvalFail](l_r)) { ret l_r; }
    val r_r: R.Result[CTValue, EvalFail] = eval_type_operand[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
    if (R.is_err[CTValue, EvalFail](r_r)) { ret r_r; }
    ret apply_equality(bin.op, R.unwrap_ok[CTValue, EvalFail](l_r), R.unwrap_ok[CTValue, EvalFail](r_r));
}

fun eval_type_query[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner
) O.Option[R.Result[CTValue, EvalFail]] {
    var which: u8 = TYPE_QUERY_IS_RECORD;
    if      (is_comptime_call(a, source, e, "is_record"))  { which = TYPE_QUERY_IS_RECORD; }
    or      (is_comptime_call(a, source, e, "is_union"))   { which = TYPE_QUERY_IS_UNION; }
    or      (is_comptime_call(a, source, e, "is_pointer")) { which = TYPE_QUERY_IS_POINTER; }
    or      (is_comptime_call(a, source, e, "is_secret"))  { which = TYPE_QUERY_IS_SECRET; }
    or      (is_comptime_call(a, source, e, "type_name"))  { which = TYPE_QUERY_NAME; }
    or      { ret O.none[R.Result[CTValue, EvalFail]](); }

    val arg: id.ExprId = first_call_arg(a, e);
    if (arg == id.EXPR_NIL) {
        ret O.some[R.Result[CTValue, EvalFail]](
            reject("a comptime type query takes one type argument"));
    }

    val tv: R.Result[CTValue, EvalFail] = eval_type_operand[T](c, cap_ctx, caps, a, source, arg, interner);
    if (R.is_err[CTValue, EvalFail](tv)) { ret O.some[R.Result[CTValue, EvalFail]](tv); }
    val t: CTValue = R.unwrap_ok[CTValue, EvalFail](tv);
    if (t.kind != CT_KIND_TYPE) {
        ret O.some[R.Result[CTValue, EvalFail]](
            reject("a comptime type query's argument must name a type"));
    }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.query == nil) {
        ret O.some[R.Result[CTValue, EvalFail]](awaiting(EVAL_FAIL_NEEDS_TYPES, COMPTIME_TYPE_QUERY_NO_RESOLVER_MSG));
    }
    val r: R.Result[O.Option[CTValue], EvalFail] = caps.query(cap_ctx, t.data.t, which);
    if (R.is_err[O.Option[CTValue], EvalFail](r)) {
        ret O.some[R.Result[CTValue, EvalFail]](R.err[CTValue, EvalFail](R.unwrap_err[O.Option[CTValue], EvalFail](r)));
    }
    val ans: O.Option[CTValue] = R.unwrap_ok[O.Option[CTValue], EvalFail](r);
    if (O.is_none[CTValue](ans)) {
        ret O.some[R.Result[CTValue, EvalFail]](awaiting(EVAL_FAIL_NEEDS_TYPES, COMPTIME_TYPE_QUERY_NO_RESOLVER_MSG));
    }
    ret O.some[R.Result[CTValue, EvalFail]](R.ok[CTValue, EvalFail](O.unwrap[CTValue](ans)));
}

pub fun is_type_query_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (is_comptime_call(a, source, eid, "is_record"))  { ret true; }
    if (is_comptime_call(a, source, eid, "is_union"))   { ret true; }
    if (is_comptime_call(a, source, eid, "is_pointer")) { ret true; }
    if (is_comptime_call(a, source, eid, "is_secret"))  { ret true; }
    ret is_comptime_call(a, source, eid, "type_name");
}

pub fun is_type_name_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "type_name");
}

fun eval_type_operand[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    operand:  id.ExprId,
    interner: *intern.Interner
) R.Result[CTValue, EvalFail] {
    if (is_field_type_member(a, source, operand)) {
        val direct: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, operand, interner);
        if (R.is_err[CTValue, EvalFail](direct))                         { ret direct; }
        if (R.unwrap_ok[CTValue, EvalFail](direct).kind == CT_KIND_TYPE) { ret direct; }
    }
    if (!capabilities_have_types[T](cap_ctx, caps) || caps.type_ == nil) { ret awaiting(EVAL_FAIL_NEEDS_TYPES, COMPTIME_TYPE_NO_RESOLVER_MSG); }
    val value_eid: id.ExprId = type_operand_value(a, source, operand);
    val r: R.Result[O.Option[u32], EvalFail] = caps.type_(cap_ctx, value_eid);
    if (R.is_err[O.Option[u32], EvalFail](r)) { ret R.err[CTValue, EvalFail](R.unwrap_err[O.Option[u32], EvalFail](r)); }
    val o: O.Option[u32] = R.unwrap_ok[O.Option[u32], EvalFail](r);
    if (O.is_none[u32](o)) { ret reject(COMPTIME_TYPE_UNRESOLVED_MSG); }
    ret type_value(O.unwrap[u32](o));
}

pub fun ct_is_negative(v: CTValue) bool {
    if (v.kind != CT_KIND_INT) { ret false; }
    if (v.int_unsigned)        { ret false; }
    ret v.data.i < 0;
}

fun ct_int_lt(a: CTValue, b: CTValue) bool {
    val an: bool = ct_is_negative(a);
    val bn: bool = ct_is_negative(b);
    if (an != bn) { ret an; }
    ret (a.data.i:~u64) < (b.data.i:~u64);
}

fun ct_int_eq(a: CTValue, b: CTValue) bool {
    if (ct_is_negative(a) != ct_is_negative(b)) { ret false; }
    ret a.data.i == b.data.i;
}

fun apply_equality(op: expr.BinOp, lhs: CTValue, rhs: CTValue) R.Result[CTValue, EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject("equality requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_FLOAT && !float.widths_agree(lhs.float_width, rhs.float_width)) {
        ret reject(FLOAT_WIDTH_MISMATCH_MSG);
    }
    var eq: bool = false;
    if (lhs.kind == CT_KIND_INT)   { eq = ct_int_eq(lhs, rhs); }
    or (lhs.kind == CT_KIND_FLOAT) {
        val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
        eq = float.round_at(lhs.data.f, w) == float.round_at(rhs.data.f, w);
    }
    or (lhs.kind == CT_KIND_STR)   { eq = lhs.data.s == rhs.data.s; }
    or (lhs.kind == CT_KIND_TYPE)  { eq = lhs.data.t == rhs.data.t; }

    if (op == expr.BIN_EQ)  { ret u8_value(if_u8(eq)); }
    ret u8_value(if_u8(!eq));
}

fun apply_compare(op: expr.BinOp, lhs: CTValue, rhs: CTValue) R.Result[CTValue, EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject("comparison requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_INT) {
        if (op == expr.BIN_LT)  { ret u8_value(if_u8(ct_int_lt(lhs, rhs))); }
        if (op == expr.BIN_LEQ) { ret u8_value(if_u8(!ct_int_lt(rhs, lhs))); }
        if (op == expr.BIN_GT)  { ret u8_value(if_u8(ct_int_lt(rhs, lhs))); }
        ret u8_value(if_u8(!ct_int_lt(lhs, rhs)));
    }
    if (lhs.kind == CT_KIND_FLOAT) {
        if (!float.widths_agree(lhs.float_width, rhs.float_width)) {
            ret reject(FLOAT_WIDTH_MISMATCH_MSG);
        }
        val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
        val l: f64 = float.round_at(lhs.data.f, w);
        val r: f64 = float.round_at(rhs.data.f, w);
        if (op == expr.BIN_LT)  { ret u8_value(if_u8(l <  r)); }
        if (op == expr.BIN_LEQ) { ret u8_value(if_u8(l <= r)); }
        if (op == expr.BIN_GT)  { ret u8_value(if_u8(l >  r)); }
        ret u8_value(if_u8(l >= r));
    }
    ret reject("ordered comparison requires numeric operands");
}

fun float_trunc_rem_narrow(a: f64, b: f64, w: float.FloatWidth) f64 {
    val q: i64 = float.round_at(a / b, w)::i64;
    ret float.round_at(a - float.round_at(float.round_at(q::f64, w) * b, w), w);
}

fun float_trunc_rem(a: f64, b: f64, w: float.FloatWidth) f64 {
    val ab: u64 = float.f64_bits(a);
    val bb: u64 = float.f64_bits(b);
    val ae: u64 = (ab >> 52) & 0x7FF;
    val be: u64 = (bb >> 52) & 0x7FF;

    if (ae == 0x7FF || be == 0x7FF || b == 0.0) {
        ret float_trunc_rem_narrow(a, b, w);
    }

    val neg: bool = float.f64_signbit(a);
    var x: f64 = a;
    if (neg) { x = float.f64_neg(x); }
    var y: f64 = b;
    if (float.f64_signbit(b)) { y = float.f64_neg(y); }

    if (x < y) { ret float.round_at(a, w); }

    var yk: f64 = y;
    for (yk <= x / 2.0) { yk = yk * 2.0; }

    for (yk >= y) {
        if (x >= yk) { x = x - yk; }
        yk = yk / 2.0;
    }

    if (neg) { x = float.f64_neg(x); }
    ret float.round_at(x, w);
}

fun apply_arith(op: expr.BinOp, lhs: CTValue, rhs: CTValue) R.Result[CTValue, EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject("arithmetic requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_INT)   { ret apply_int_arith(op, lhs, rhs); }
    if (lhs.kind == CT_KIND_FLOAT) { ret apply_float_arith(op, lhs, rhs); }
    ret reject("arithmetic requires numeric operands");
}

fun apply_float_arith(op: expr.BinOp, lhs: CTValue, rhs: CTValue) R.Result[CTValue, EvalFail] {
    if (!float.widths_agree(lhs.float_width, rhs.float_width)) {
        ret reject(FLOAT_WIDTH_MISMATCH_MSG);
    }
    val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
    val l: f64 = float.round_at(lhs.data.f, w);
    val r: f64 = float.round_at(rhs.data.f, w);

    if (op == expr.BIN_ADD) { ret float_value(l + r, w); }
    if (op == expr.BIN_SUB) { ret float_value(l - r, w); }
    if (op == expr.BIN_MUL) { ret float_value(l * r, w); }
    if (op == expr.BIN_DIV) {
        if (r == 0.0) { ret reject("float division by zero"); }
        ret float_value(l / r, w);
    }
    if (op == expr.BIN_MOD) {
        if (r == 0.0) { ret reject("float modulo by zero"); }
        ret float_value(float_trunc_rem(l, r, w), w);
    }
    ret reject("unsupported float operator");
}

fun apply_int_arith(op: expr.BinOp, lhs: CTValue, rhs: CTValue) R.Result[CTValue, EvalFail] {
    val res_uns: bool = lhs.int_unsigned || rhs.int_unsigned;

    if (op == expr.BIN_BIT_AND)                   { ret make_int_value(lhs.data.i & rhs.data.i, res_uns); }
    if (op == expr.BIN_BIT_OR)                    { ret make_int_value(lhs.data.i | rhs.data.i, res_uns); }
    if (op == expr.BIN_BIT_XOR)                   { ret make_int_value(lhs.data.i ^ rhs.data.i, res_uns); }
    if (op == expr.BIN_SHL || op == expr.BIN_SHR) { ret apply_int_shift(op, lhs, rhs); }

    if (!res_uns) { ret apply_signed_arith(op, lhs.data.i, rhs.data.i); }
    if (ct_is_negative(lhs) || ct_is_negative(rhs)) {
        ret reject("comptime arithmetic mixes a negative value with an unsigned operand");
    }
    ret apply_unsigned_arith(op, lhs.data.i:~u64, rhs.data.i:~u64);
}

fun apply_signed_arith(op: expr.BinOp, a: i64, b: i64) R.Result[CTValue, EvalFail] {
    if (op == expr.BIN_ADD) {
        val s: i64 = a + b;
        if (((a ^ s) & (b ^ s)) < 0) {
            ret reject("comptime integer overflow in '+'");
        }
        ret make_int_value(s, false);
    }
    if (op == expr.BIN_SUB) {
        val s: i64 = a - b;
        if (((a ^ b) & (a ^ s)) < 0) {
            ret reject("comptime integer overflow in '-'");
        }
        ret make_int_value(s, false);
    }
    if (op == expr.BIN_MUL) { ret signed_mul(a, b); }
    if (op == expr.BIN_DIV) {
        if (b == 0) { ret reject("integer division by zero"); }
        if (is_i64_min(a) && b == (0 - 1)) {
            ret reject("integer division overflow (INT64_MIN / -1)");
        }
        ret make_int_value(a / b, false);
    }
    if (op == expr.BIN_MOD) {
        if (b == 0) { ret reject("integer modulo by zero"); }
        if (is_i64_min(a) && b == (0 - 1)) {
            ret reject("integer modulo overflow (INT64_MIN % -1)");
        }
        ret make_int_value(a % b, false);
    }
    ret reject("unsupported integer operator");
}

fun signed_mul(a: i64, b: i64) R.Result[CTValue, EvalFail] {
    if (a == 0 || b == 0) { ret make_int_value(0, false); }
    if ((is_i64_min(a) && b == (0 - 1)) || (is_i64_min(b) && a == (0 - 1))) {
        ret reject("comptime integer overflow in '*'");
    }
    val p: i64 = a * b;
    if (p / a != b) { ret reject("comptime integer overflow in '*'"); }
    ret make_int_value(p, false);
}

fun apply_unsigned_arith(op: expr.BinOp, a: u64, b: u64) R.Result[CTValue, EvalFail] {
    if (op == expr.BIN_ADD) {
        val s: u64 = a + b;
        if (s < a) { ret reject("comptime integer overflow in '+'"); }
        ret make_int_value(s:~i64, true);
    }
    if (op == expr.BIN_SUB) {
        if (a < b) { ret reject("comptime integer overflow in '-'"); }
        ret make_int_value((a - b):~i64, true);
    }
    if (op == expr.BIN_MUL) {
        val p: u64 = a * b;
        if (b != 0 && p / b != a) { ret reject("comptime integer overflow in '*'"); }
        ret make_int_value(p:~i64, true);
    }
    if (op == expr.BIN_DIV) {
        if (b == 0) { ret reject("integer division by zero"); }
        ret make_int_value((a / b):~i64, true);
    }
    if (op == expr.BIN_MOD) {
        if (b == 0) { ret reject("integer modulo by zero"); }
        ret make_int_value((a % b):~i64, true);
    }
    ret reject("unsupported integer operator");
}

fun apply_int_shift(op: expr.BinOp, lhs: CTValue, rhs: CTValue) R.Result[CTValue, EvalFail] {
    if (ct_is_negative(rhs)) { ret reject("comptime shift amount is negative"); }
    val amt: u64 = rhs.data.i:~u64;
    if (amt >= 64) { ret reject("comptime shift amount must be less than 64"); }
    val sh: i64 = amt:~i64;
    if (op == expr.BIN_SHL) {
        if (amt > 0) {
            val discarded: u64 = (lhs.data.i:~u64) >> (64 - amt);
            if (discarded != 0) { ret reject("comptime left shift discards significant bits"); }
        }
        val shifted: u64 = (lhs.data.i:~u64) << amt;
        ret make_int_value(shifted:~i64, shifted > 0x7FFFFFFFFFFFFFFF);
    }
    if (lhs.int_unsigned)   { ret make_int_value((lhs.data.i:~u64 >> amt):~i64, true); }
    ret make_int_value(lhs.data.i >> sh, false);
}

fun eval_ident[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    source:   str,
    e:        id.ExprId,
    span:     token.Span,
    interner: *intern.Interner
) R.Result[CTValue, EvalFail] {
    if (capabilities_have_ident[T](cap_ctx, caps)) {
        if (caps.ident(cap_ctx, e)) { ret reject(COMPTIME_IDENT_RUNTIME_MSG); }
    }

    val id_r: R.Result[intern.StrId, str] = intern.intern_span(interner, source, span);
    if (R.is_err[intern.StrId, str](id_r)) {
        ret internal_failure(R.unwrap_err[intern.StrId, str](id_r));
    }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](id_r);
    val nc_opt: O.Option[NamedConst] = lookup(c, name);
    if (O.is_none[NamedConst](nc_opt)) {
        if (float_width_deferred(c, name)) {
            ret reject(COMPTIME_ALIAS_FLOAT_MSG);
        }
        ret awaiting(EVAL_FAIL_UNBOUND, COMPTIME_IDENT_UNBOUND_MSG);
    }
    ret R.ok[CTValue, EvalFail](O.unwrap[NamedConst](nc_opt).value);
}

fun eval_module_member[T](cap_ctx: *T, caps: PhaseCapabilities[T], e: id.ExprId) R.Result[CTValue, EvalFail] {
    if (!capabilities_have_member[T](cap_ctx, caps)) { ret awaiting(EVAL_FAIL_NEEDS_MEMBER, COMPTIME_MEMBER_NO_RESOLVER_MSG); }
    val r: R.Result[O.Option[CTValue], EvalFail] = caps.member(cap_ctx, e);
    if (R.is_err[O.Option[CTValue], EvalFail](r)) { ret R.err[CTValue, EvalFail](R.unwrap_err[O.Option[CTValue], EvalFail](r)); }
    val o: O.Option[CTValue] = R.unwrap_ok[O.Option[CTValue], EvalFail](r);
    if (O.is_some[CTValue](o)) { ret R.ok[CTValue, EvalFail](O.unwrap[CTValue](o)); }
    ret awaiting(EVAL_FAIL_NEEDS_MEMBER, COMPTIME_MEMBER_NOT_CONST_MSG);
}

fun eval_field_member[T](
    c:           *ComptimeCtx,
    cap_ctx:     *T,
    caps:        PhaseCapabilities[T],
    a:           *ast.Ast,
    source:      str,
    object_eid:  id.ExprId,
    member_span: token.Span,
    interner:    *intern.Interner
) O.Option[R.Result[CTValue, EvalFail]] {
    val obj_r: R.Result[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, object_eid, interner);
    if (R.is_err[CTValue, EvalFail](obj_r)) {
        if (R.unwrap_err[CTValue, EvalFail](obj_r).kind == EVAL_FAIL_INTERNAL) {
            ret O.some[R.Result[CTValue, EvalFail]](obj_r);
        }
        ret O.none[R.Result[CTValue, EvalFail]]();
    }
    val obj: CTValue = R.unwrap_ok[CTValue, EvalFail](obj_r);
    if (obj.kind != CT_KIND_FIELD) { ret O.none[R.Result[CTValue, EvalFail]](); }

    val mtext: View = span_text(source, member_span);
    var sel: u8 = FIELD_SEL_NAME;
    if      (view_eq_str(mtext, "name"))   { sel = FIELD_SEL_NAME; }
    or      (view_eq_str(mtext, "type"))   { sel = FIELD_SEL_TYPE; }
    or      (view_eq_str(mtext, "offset")) { sel = FIELD_SEL_OFFSET; }
    or      { ret O.some[R.Result[CTValue, EvalFail]](reject(COMPTIME_FIELD_UNKNOWN_MEMBER_MSG)); }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.field == nil) { ret O.some[R.Result[CTValue, EvalFail]](reject(COMPTIME_FIELD_NO_RESOLVER_MSG)); }
    val r: R.Result[O.Option[CTValue], EvalFail] = caps.field(cap_ctx, obj.data.fld.owner, obj.data.fld.index, sel);
    if (R.is_err[O.Option[CTValue], EvalFail](r)) { ret O.some[R.Result[CTValue, EvalFail]](R.err[CTValue, EvalFail](R.unwrap_err[O.Option[CTValue], EvalFail](r))); }
    val o: O.Option[CTValue] = R.unwrap_ok[O.Option[CTValue], EvalFail](r);
    if (O.is_none[CTValue](o)) { ret O.some[R.Result[CTValue, EvalFail]](reject(COMPTIME_FIELD_UNAVAILABLE_MSG)); }
    ret O.some[R.Result[CTValue, EvalFail]](R.ok[CTValue, EvalFail](O.unwrap[CTValue](o)));
}

fun eval_const_elem_member[T](
    c:           *ComptimeCtx,
    cap_ctx:     *T,
    caps:        PhaseCapabilities[T],
    a:           *ast.Ast,
    source:      str,
    object_eid:  id.ExprId,
    member_span: token.Span,
    interner:    *intern.Interner,
    fw:          float.FloatWidth
) O.Option[R.Result[CTValue, EvalFail]] {
    val obj_opt: O.Option[*expr.Expr] = ast.get_expr(a, object_eid);
    if (O.is_none[*expr.Expr](obj_opt))                                       { ret O.none[R.Result[CTValue, EvalFail]](); }
    val obj: *expr.Expr = O.unwrap[*expr.Expr](obj_opt);
    if (obj.kind != expr.EXPR_KIND_IDENT)                                     { ret O.none[R.Result[CTValue, EvalFail]](); }

    val obj_r: R.Result[CTValue, EvalFail] = eval_ident[T](c, cap_ctx, caps, source, object_eid, obj.span, interner);
    if (R.is_err[CTValue, EvalFail](obj_r)) {
        if (R.unwrap_err[CTValue, EvalFail](obj_r).kind == EVAL_FAIL_INTERNAL) {
            ret O.some[R.Result[CTValue, EvalFail]](obj_r);
        }
        ret O.none[R.Result[CTValue, EvalFail]]();
    }
    val ov: CTValue = R.unwrap_ok[CTValue, EvalFail](obj_r);
    if (ov.kind != CT_KIND_CONST_ELEM)                                        { ret O.none[R.Result[CTValue, EvalFail]](); }

    val el_opt: O.Option[*expr.Expr] = ast.get_expr(a, ov.data.celem.elem::id.ExprId);
    if (O.is_none[*expr.Expr](el_opt))                                        { ret O.none[R.Result[CTValue, EvalFail]](); }
    val el: *expr.Expr = O.unwrap[*expr.Expr](el_opt);
    if (el.kind != expr.EXPR_KIND_STRUCT_LIT)                                 { ret O.none[R.Result[CTValue, EvalFail]](); }

    val mname_r: R.Result[intern.StrId, str] = intern.intern_span(interner, source, member_span);
    if (R.is_err[intern.StrId, str](mname_r)) { ret O.some[R.Result[CTValue, EvalFail]](internal_failure(R.unwrap_err[intern.StrId, str](mname_r))); }
    val mname: intern.StrId = R.unwrap_ok[intern.StrId, str](mname_r);

    var i: u32 = 0;
    for (i < el.data.struct_lit.fields_len) {
        val pool_ix: usize = (el.data.struct_lit.fields_start + i)::usize;
        if (pool_ix >= a.field_init_len)                                      { ret O.none[R.Result[CTValue, EvalFail]](); }
        val fi: *expr.FieldInit = ?a.field_inits[pool_ix];
        val fname_r: R.Result[intern.StrId, str] = intern.intern_span(interner, source, fi.name);
        if (R.is_err[intern.StrId, str](fname_r)) { ret O.some[R.Result[CTValue, EvalFail]](internal_failure(R.unwrap_err[intern.StrId, str](fname_r))); }
        if (R.unwrap_ok[intern.StrId, str](fname_r) == mname) {
            ret O.some[R.Result[CTValue, EvalFail]](evaluate_at_float_width[T](c, cap_ctx, caps, a, source, fi.value, interner, fw));
        }
        i = i + 1;
    }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.field == nil) { ret O.none[R.Result[CTValue, EvalFail]](); }
    val zr: R.Result[O.Option[CTValue], EvalFail] = caps.field(cap_ctx, ov.data.celem.ty, mname::u32, FIELD_SEL_ZERO_BY_NAME);
    if (R.is_err[O.Option[CTValue], EvalFail](zr)) { ret O.some[R.Result[CTValue, EvalFail]](R.err[CTValue, EvalFail](R.unwrap_err[O.Option[CTValue], EvalFail](zr))); }
    val zo: O.Option[CTValue] = R.unwrap_ok[O.Option[CTValue], EvalFail](zr);
    if (O.is_none[CTValue](zo))               { ret O.none[R.Result[CTValue, EvalFail]](); }
    ret O.some[R.Result[CTValue, EvalFail]](R.ok[CTValue, EvalFail](O.unwrap[CTValue](zo)));
}

pub fun is_comptime_path(a: *ast.Ast, e: id.ExprId) bool {
    var cur: id.ExprId = e;
    for (true) {
        if (cur == id.EXPR_NIL) { ret false; }
        val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, cur);
        if (O.is_none[*expr.Expr](n_opt)) { ret false; }
        val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
        if (node.kind == expr.EXPR_KIND_COMPTIME_IDENT) { ret true; }
        if (node.kind == expr.EXPR_KIND_MEMBER) {
            cur = node.data.member.object;
            cnt;
        }
        ret false;
    }
    ret false;
}

fun eval_path(
    c:        *ComptimeCtx,
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner
) R.Result[CTValue, EvalFail] {
    var stack: [16]token.Span;
    var depth: u32 = 0;

    var cur: id.ExprId = e;
    for (true) {
        if (depth >= 16) { ret reject("comptime path is too deeply nested"); }
        val n_opt: O.Option[*expr.Expr] = ast.get_expr(a, cur);
        if (O.is_none[*expr.Expr](n_opt)) { ret reject("ExprId out of range during comptime member walk"); }
        val node: *expr.Expr = O.unwrap[*expr.Expr](n_opt);
        if (node.kind == expr.EXPR_KIND_MEMBER) {
            stack[depth] = node.data.member.name;
            depth = depth + 1;
            cur = node.data.member.object;
            cnt;
        }
        if (node.kind == expr.EXPR_KIND_COMPTIME_IDENT) {
            stack[depth] = comptime_ident_name(node.span);
            depth = depth + 1;
            brk;
        }
        ret reject("comptime path must start with a `$` identifier");
    }

    ret resolve_comptime_path(c, source, ?stack[0], depth, interner);
}

fun resolve_comptime_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32, interner: *intern.Interner) R.Result[CTValue, EvalFail] {
    if (depth == 0) { ret reject("empty comptime path"); }
    val root: View = span_text(source, stack[depth - 1]);
    if (view_eq_str(root, "mach"))    { ret resolve_mach_path(c, source, stack, depth, interner); }
    if (view_eq_str(root, "project")) { ret resolve_project_path(c, source, stack, depth, interner); }
    if (view_eq_str(root, "bin"))     { ret resolve_bin_path(c, source, stack, depth); }
    ret reject(COMPTIME_BARE_IDENT_MSG);
}

fun resolve_project_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32, interner: *intern.Interner) R.Result[CTValue, EvalFail] {
    if (depth == 3 && seg_is(source, stack, 1, "target")) {
        if (seg_is(source, stack, 0, "os"))   { ret project_field(c.env.target_os); }
        if (seg_is(source, stack, 0, "arch")) { ret project_field(c.env.target_isa); }
        if (seg_is(source, stack, 0, "abi"))  { ret project_field(c.env.target_abi); }
        ret reject("unknown `$project.target.*` path");
    }
    if (depth == 3 && seg_is(source, stack, 1, "version")) {
        if (c.env.project_ver == intern.STR_NIL) { ret reject("comptime path value is not available in this context"); }
        val vo: O.Option[str] = intern.lookup(interner, c.env.project_ver);
        if (O.is_none[str](vo)) { ret reject("project version is not available"); }
        val vs: str = O.unwrap[str](vo);
        if (seg_is(source, stack, 0, "major")) { ret version_value(vs, 0); }
        if (seg_is(source, stack, 0, "minor")) { ret version_value(vs, 1); }
        if (seg_is(source, stack, 0, "patch")) { ret version_value(vs, 2); }
        ret reject("unknown `$project.version.*` component");
    }
    if (depth == 4 && seg_is(source, stack, 2, "deps") && seg_is(source, stack, 0, "version")) {
        ret reject("`$project.deps.*.version` is not yet available (reserved for the package registry)");
    }
    if (depth != 2)                              { ret reject("unknown `$project.*` path"); }
    if (seg_is(source, stack, 0, "id"))          { ret project_field(c.env.project_id); }
    if (seg_is(source, stack, 0, "version"))     { ret project_field(c.env.project_ver); }
    if (seg_is(source, stack, 0, "name"))        { ret project_field(c.env.project_name); }
    if (seg_is(source, stack, 0, "description")) { ret project_field(c.env.project_desc); }
    ret reject("unknown `$project.*` path");
}

fun resolve_bin_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32) R.Result[CTValue, EvalFail] {
    if (depth != 2)                       { ret reject("unknown `$bin.*` path"); }
    if (seg_is(source, stack, 0, "name")) { ret project_field(c.env.bin_name); }
    ret reject("unknown `$bin.*` path");
}

fun project_field(value: intern.StrId) R.Result[CTValue, EvalFail] {
    if (value == intern.STR_NIL) {
        ret reject("comptime path value is not available in this context");
    }
    ret str_value(value);
}

pub fun comptime_ident_name(full: token.Span) token.Span {
    var s: token.Span;
    s.offset = full.offset + 1;
    if (full.len > 0) { s.len = full.len - 1; } or { s.len = 0; }
    ret s;
}

fun resolve_mach_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32, interner: *intern.Interner) R.Result[CTValue, EvalFail] {
    if (depth == 0) { ret reject("empty comptime path"); }

    if (depth == 2 && seg_is(source, stack, 0, "version")) {
        ret str_value(c.env.compiler_ver);
    }
    if (depth == 3 && seg_is(source, stack, 1, "version")) {
        val vo: O.Option[str] = intern.lookup(interner, c.env.compiler_ver);
        if (O.is_none[str](vo)) { ret reject("compiler version is not available"); }
        val vs: str = O.unwrap[str](vo);
        if (seg_is(source, stack, 0, "major")) { ret version_value(vs, 0); }
        if (seg_is(source, stack, 0, "minor")) { ret version_value(vs, 1); }
        if (seg_is(source, stack, 0, "patch")) { ret version_value(vs, 2); }
        ret reject("unknown `$mach.version.*` component");
    }

    if (depth == 3 && seg_is(source, stack, 1, "os")) {
        val name: View = span_text(source, stack[0]);
        val r: R.Result[u32, str] = os_tag_for(name);
        if (R.is_err[u32, str](r)) { ret reject(R.unwrap_err[u32, str](r)); }
        ret int_value(R.unwrap_ok[u32, str](r)::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "arch")) {
        val name: View = span_text(source, stack[0]);
        val r: R.Result[u32, str] = arch_tag_for(name);
        if (R.is_err[u32, str](r)) { ret reject(R.unwrap_err[u32, str](r)); }
        ret int_value(R.unwrap_ok[u32, str](r)::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "abi")) {
        val name: View = span_text(source, stack[0]);
        val r: R.Result[u32, str] = abi_tag_for(c, name);
        if (R.is_err[u32, str](r)) { ret reject(R.unwrap_err[u32, str](r)); }
        ret int_value(R.unwrap_ok[u32, str](r)::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "mode")) {
        val name: View = span_text(source, stack[0]);
        val r: R.Result[u32, str] = mode_tag_for(name);
        if (R.is_err[u32, str](r)) { ret reject(R.unwrap_err[u32, str](r)); }
        ret int_value(R.unwrap_ok[u32, str](r)::i64);
    }

    if (depth == 3 && seg_is(source, stack, 1, "compiler") && seg_is(source, stack, 0, "version")) {
        ret str_value(c.env.compiler_ver);
    }
    if (depth == 3 && seg_is(source, stack, 1, "compiler") && seg_is(source, stack, 0, "name")) {
        ret str_value(c.env.compiler_name);
    }

    if (depth == 3 && seg_is(source, stack, 1, "project")
     && (seg_is(source, stack, 0, "name") || seg_is(source, stack, 0, "version") || seg_is(source, stack, 0, "root"))) {
        ret reject("`$mach.project.*` is not yet available");
    }

    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "os")) {
        ret int_value(c.env.target_os_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "arch")) {
        ret int_value(c.env.target_arch_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "abi")) {
        ret int_value(c.env.target_abi_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "pointer_width")) {
        ret int_value(c.env.pointer_width::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "mode")) {
        ret int_value(c.env.build_mode_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "pie")) {
        ret u8_value(c.env.build_pie::u8);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "platform")) {
        if (c.env.target_platform != intern.STR_NIL) { ret str_value(c.env.target_platform); }
        val pr: R.Result[intern.StrId, str] = intern.intern(interner, "");
        if (R.is_err[intern.StrId, str](pr)) { ret internal_failure(R.unwrap_err[intern.StrId, str](pr)); }
        ret str_value(R.unwrap_ok[intern.StrId, str](pr));
    }

    if (depth == 3 && seg_is(source, stack, 1, "build")
     && (seg_is(source, stack, 0, "timestamp") || seg_is(source, stack, 0, "host"))) {
        ret reject("`$mach.build.*` is not yet available");
    }
    if (depth == 4 && seg_is(source, stack, 2, "build") && seg_is(source, stack, 1, "git")
     && (seg_is(source, stack, 0, "commit") || seg_is(source, stack, 0, "dirty"))) {
        ret reject("`$mach.build.git.*` is not yet available");
    }
    if (depth == 3 && seg_is(source, stack, 1, "build")) {
        val nr: R.Result[intern.StrId, str] = intern.intern_span(interner, source, stack[0]);
        if (R.is_err[intern.StrId, str](nr)) { ret internal_failure(R.unwrap_err[intern.StrId, str](nr)); }
        val d_opt: O.Option[NamedConst] = lookup_define(c, R.unwrap_ok[intern.StrId, str](nr));
        if (O.is_some[NamedConst](d_opt)) { ret R.ok[CTValue, EvalFail](O.unwrap[NamedConst](d_opt).value); }
        ret reject("no manifest define named in `$mach.build.<name>`");
    }

    if (depth == 3 && seg_is(source, stack, 1, "source")
     && (seg_is(source, stack, 0, "file") || seg_is(source, stack, 0, "line")
      || seg_is(source, stack, 0, "module") || seg_is(source, stack, 0, "function"))) {
        ret reject("`$mach.source.*` is not yet available");
    }

    ret reject("unknown `$mach.*` path");
}

fun seg_is(source: str, stack: *token.Span, idx: u32, expected: str) bool {
    val span: token.Span = stack[idx];
    val text: View = span_text(source, span);
    ret view_eq_str(text, expected);
}

fun os_tag_for(name: View) R.Result[u32, str] {
    var i: usize = 0;
    for (i < os.os_catalog_len()) {
        val spelling: str = os.os_catalog_name(i);
        if (view_eq_str(name, spelling)) { ret R.ok[u32, str](os.os_id_for(spelling)); }
        i = i + 1;
    }
    ret R.err[u32, str]("unknown `$mach.os.*` tag");
}

fun arch_tag_for(name: View) R.Result[u32, str] {
    var i: usize = 0;
    for (i < isa.arch_catalog_len()) {
        val spelling: str = isa.arch_catalog_name(i);
        if (view_eq_str(name, spelling)) { ret R.ok[u32, str](isa.arch_id_for(spelling)); }
        i = i + 1;
    }
    ret R.err[u32, str]("unknown `$mach.arch.*` tag");
}

rec DeprecatedAbi {
    spelling:    str;
    replacement: str;
}

val DEPRECATED_ABI_N: usize = 1;
val DEPRECATED_ABIS: [DEPRECATED_ABI_N]DeprecatedAbi = [DEPRECATED_ABI_N]DeprecatedAbi{
    DeprecatedAbi{ spelling: "sysv", replacement: "sysv64" },
};

fun deprecate_abi(c: *ComptimeCtx, spelling: str, replacement: str) R.Result[u32, str] {
    if (c.env.diags != nil) {
        val msg: R.Result[str, str] = format.sprint(c.env.alloc,
            "`$mach.abi.{}` is deprecated and resolves to `$mach.abi.{}`; the registry spells this ABI `{}`, and the deprecated spelling is removed in the next major release",
            spelling, replacement, replacement);
        if (R.is_err[str, str](msg)) { ret R.err[u32, str](R.unwrap_err[str, str](msg)); }
        var span: token.Span;
        span.offset = 0;
        span.len    = 0;
        val emitted: R.Result[R.Void, str] =
            diagnostic.warning(c.env.diags, 0xFFFFFFFF::source.FileId, span,
                               R.unwrap_ok[str, str](msg));
        if (R.is_err[R.Void, str](emitted)) { ret R.err[u32, str](R.unwrap_err[R.Void, str](emitted)); }
    }
    ret R.ok[u32, str](abi.abi_id_for(replacement));
}

fun abi_tag_for(c: *ComptimeCtx, name: View) R.Result[u32, str] {
    var i: usize = 0;
    for (i < abi.abi_catalog_len()) {
        val spelling: str = abi.abi_catalog_name(i);
        if (view_eq_str(name, spelling)) { ret R.ok[u32, str](abi.abi_id_for(spelling)); }
        i = i + 1;
    }
    var d: usize = 0;
    for (d < DEPRECATED_ABI_N) {
        if (view_eq_str(name, DEPRECATED_ABIS[d].spelling)) {
            ret deprecate_abi(c, DEPRECATED_ABIS[d].spelling, DEPRECATED_ABIS[d].replacement);
        }
        d = d + 1;
    }
    ret R.err[u32, str]("unknown `$mach.abi.*` tag");
}

pub val MODE_DEBUG:   u32 = 0;
pub val MODE_RELEASE: u32 = 1;

fun mode_tag_for(name: View) R.Result[u32, str] {
    if (view_eq_str(name, "debug"))   { ret R.ok[u32, str](MODE_DEBUG); }
    if (view_eq_str(name, "release")) { ret R.ok[u32, str](MODE_RELEASE); }
    ret R.err[u32, str]("unknown `$mach.mode.*` tag");
}

fun version_component(s: str, which: u32) R.Result[i64, str] {
    var comp: u32   = 0;
    var acc:  i64   = 0;
    var seen: bool  = false;
    var i:    usize = 0;
    for (s[i] != 0) {
        val ch: u8 = s[i];
        if (ch == '.') {
            comp = comp + 1;
        } or (comp == which) {
            if (ch < '0' || ch > '9') { ret R.err[i64, str]("version component is not numeric"); }
            acc  = acc * 10 + (ch - '0')::i64;
            seen = true;
        }
        i = i + 1;
    }
    if (!seen) { ret R.err[i64, str]("version string has no such component"); }
    ret R.ok[i64, str](acc);
}

fun version_value(s: str, which: u32) R.Result[CTValue, EvalFail] {
    val r: R.Result[i64, str] = version_component(s, which);
    if (R.is_err[i64, str](r)) { ret reject(R.unwrap_err[i64, str](r)); }
    ret int_value(R.unwrap_ok[i64, str](r));
}

fun make_int_value(bits: i64, unsigned: bool) R.Result[CTValue, EvalFail] {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = 0;
    v.data.i       = bits;
    ret R.ok[CTValue, EvalFail](v);
}

fun int_value(i: i64) R.Result[CTValue, EvalFail] {
    ret make_int_value(i, false);
}

fun ct_negate(v: CTValue) R.Result[CTValue, EvalFail] {
    if (!v.int_unsigned) {
        if (is_i64_min(v.data.i)) { ret make_int_value(v.data.i, true); }
        ret make_int_value(0 - v.data.i, false);
    }
    val mag: u64 = v.data.i:~u64;
    if (mag == 0) { ret make_int_value(0, false); }
    val signed_min_mag: u64 = 0x8000000000000000;
    if (mag > signed_min_mag) {
        ret reject("comptime negation of an unsigned value is out of range");
    }
    ret make_int_value(0 - v.data.i, false);
}

fun float_value(f: f64, w: float.FloatWidth) R.Result[CTValue, EvalFail] {
    ret R.ok[CTValue, EvalFail](ct_float(f, w));
}

pub fun ct_float(f: f64, w: float.FloatWidth) CTValue {
    var v: CTValue;
    v.kind        = CT_KIND_FLOAT;
    v.float_width = w;
    v.data.f      = float.round_at(f, w);
    ret v;
}

fun u8_value(n: u8) R.Result[CTValue, EvalFail] {
    ret R.ok[CTValue, EvalFail](ct_u8(n));
}

fun str_value(s: intern.StrId) R.Result[CTValue, EvalFail] {
    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = s;
    ret R.ok[CTValue, EvalFail](v);
}

fun type_value(t: u32) R.Result[CTValue, EvalFail] {
    var v: CTValue;
    v.kind   = CT_KIND_TYPE;
    v.data.t = t;
    ret R.ok[CTValue, EvalFail](v);
}

pub fun field_value(owner: u32, index: u32) CTValue {
    var v: CTValue;
    v.kind          = CT_KIND_FIELD;
    v.data.fld.owner = owner;
    v.data.fld.index = index;
    ret v;
}

pub fun pack_elem_value(index: u32, ty: u32) CTValue {
    var v: CTValue;
    v.kind            = CT_KIND_PACK_ELEM;
    v.data.pelem.index = index;
    v.data.pelem.ty    = ty;
    ret v;
}

pub fun const_elem_value(elem: u32, ty: u32) CTValue {
    var v: CTValue;
    v.kind             = CT_KIND_CONST_ELEM;
    v.data.celem.elem = elem;
    v.data.celem.ty   = ty;
    ret v;
}

pub fun ct_str(s: intern.StrId) CTValue {
    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = s;
    ret v;
}

pub fun ct_u8(n: u8) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 8;
    v.data.i       = n::i64;
    ret v;
}

pub fun is_u8(v: CTValue) bool {
    ret v.kind == CT_KIND_INT && v.int_unsigned && v.int_width == 8;
}

pub fun truth(v: CTValue) bool {
    ret v.kind == CT_KIND_INT && v.data.i == 1;
}

fun if_u8(v: bool) u8 {
    if (v) { ret 1; }
    ret 0;
}

pub fun ct_type(t: u32) CTValue {
    var v: CTValue;
    v.kind   = CT_KIND_TYPE;
    v.data.t = t;
    ret v;
}

pub fun ct_uint(n: u64) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 64;
    v.data.i       = n:~i64;
    ret v;
}

pub fun ct_zero_int(unsigned: bool, width: u8) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = width;
    v.data.i       = 0;
    ret v;
}

fun t_eval_int(s: str) R.Result[CTValue, EvalFail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret eval_lit_int(s, span);
}

fun t_i64_min() i64 { var one: u64 = 1; ret (one << 63):~i64; }
fun t_i64_max() i64 { var one: u64 = 1; ret ((one << 63) - 1):~i64; }

test "mach.lang.fe.comptime.eval_lit_int:above_u64_max_rejected" {
    val r: R.Result[CTValue, EvalFail] = t_eval_int("18446744073709551616");
    if (!R.is_err[CTValue, EvalFail](r)) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:u64_max_preserved" {
    val r: R.Result[CTValue, EvalFail] = t_eval_int("18446744073709551615");
    if (R.is_err[CTValue, EvalFail](r)) { ret 1; }
    val v: CTValue = R.unwrap_ok[CTValue, EvalFail](r);
    if (v.data.i:~u64 != 0xFFFFFFFFFFFFFFFF) { ret 1; }
    ret 0;
}

fun t_scan_int(s: str) R.Result[LitInt, str] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret scan_lit_int(s, span);
}

fun t_suffix_of(s: str) type.TypeKind {
    val r: R.Result[LitInt, str] = t_scan_int(s);
    if (R.is_err[LitInt, str](r)) { ret expr.LIT_SUFFIX_NONE; }
    ret R.unwrap_ok[LitInt, str](r).suffix;
}

test "mach.lang.fe.comptime.scan_lit_int:suffix_names_a_primitive_type" {
    if (t_suffix_of("7u8")   != type.TYPE_U8)  { ret 1; }
    if (t_suffix_of("7u16")  != type.TYPE_U16) { ret 2; }
    if (t_suffix_of("7u32")  != type.TYPE_U32) { ret 3; }
    if (t_suffix_of("7u64")  != type.TYPE_U64) { ret 4; }
    if (t_suffix_of("7i8")   != type.TYPE_I8)  { ret 5; }
    if (t_suffix_of("7i16")  != type.TYPE_I16) { ret 6; }
    if (t_suffix_of("7i32")  != type.TYPE_I32) { ret 7; }
    if (t_suffix_of("7i64")  != type.TYPE_I64) { ret 8; }
    if (t_suffix_of("7")     != expr.LIT_SUFFIX_NONE) { ret 9; }
    if (t_suffix_of("0xFFu8") != type.TYPE_U8)  { ret 10; }
    if (t_suffix_of("0b1010u16") != type.TYPE_U16) { ret 11; }
    if (t_suffix_of("0o755u32")  != type.TYPE_U32) { ret 12; }
    if (t_suffix_of("0xFF")      != expr.LIT_SUFFIX_NONE) { ret 13; }

    val r: R.Result[LitInt, str] = t_scan_int("255u8");
    if (R.is_err[LitInt, str](r))                     { ret 14; }
    if (R.unwrap_ok[LitInt, str](r).value != 255)     { ret 15; }
    if (!R.unwrap_ok[LitInt, str](r).in_range)        { ret 16; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:suffix_sets_width_and_signedness" {
    val a: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("7u32"));
    if (a.int_width != 32 || !a.int_unsigned) { ret 1; }
    val b: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("7i8"));
    if (b.int_width != 8 || b.int_unsigned)   { ret 2; }
    val c: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("1u8"));
    if (!is_u8(c) || !truth(c))               { ret 3; }
    val d: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("7"));
    if (d.int_width != 64 || d.int_unsigned)  { ret 4; }
    ret 0;
}

test "mach.lang.fe.comptime.scan_lit_int:unknown_suffix_rejected" {
    if (!R.is_err[LitInt, str](t_scan_int("7u7")))   { ret 1; }
    if (!R.is_err[LitInt, str](t_scan_int("7u")))    { ret 2; }
    if (!R.is_err[LitInt, str](t_scan_int("7i")))    { ret 3; }
    if (!R.is_err[LitInt, str](t_scan_int("1f32")))  { ret 4; }
    if (!R.is_err[LitInt, str](t_scan_int("7u128"))) { ret 5; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:out_of_range_for_its_suffix_rejected" {
    if (R.unwrap_ok[LitInt, str](t_scan_int("256u8")).in_range)     { ret 1; }
    if (R.unwrap_ok[LitInt, str](t_scan_int("40000i16")).in_range)  { ret 2; }
    if (!R.is_err[CTValue, EvalFail](t_eval_int("256u8")))               { ret 3; }
    if (!R.is_err[CTValue, EvalFail](t_eval_int("40000i16")))            { ret 4; }
    if (R.is_err[CTValue, EvalFail](t_eval_int("255u8")))                { ret 5; }
    if (R.is_err[CTValue, EvalFail](t_eval_int("128i8")))                { ret 6; }
    if (R.is_err[CTValue, EvalFail](t_eval_int("32767i16")))             { ret 7; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:hex_overflow_rejected" {
    val r: R.Result[CTValue, EvalFail] = t_eval_int("0x1FFFFFFFFFFFFFFFF");
    if (!R.is_err[CTValue, EvalFail](r)) { ret 1; }
    ret 0;
}

fun t_view(s: str) View {
    ret view(?s[0], str_len(s));
}

test "mach.lang.fe.comptime.apply_arith:int_min_idiv_traps" {
    val lhs: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(t_i64_min()));
    val rhs: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(0 - 1));
    if (!R.is_err[CTValue, EvalFail](apply_arith(expr.BIN_DIV, lhs, rhs))) { ret 1; }
    if (!R.is_err[CTValue, EvalFail](apply_arith(expr.BIN_MOD, lhs, rhs))) { ret 1; }
    val ten: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(10));
    val two: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(2));
    val okd: R.Result[CTValue, EvalFail] = apply_arith(expr.BIN_DIV, ten, two);
    if (R.is_err[CTValue, EvalFail](okd))                { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](okd).data.i != 5) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:float_mod_truncated" {
    val a: CTValue = R.unwrap_ok[CTValue, EvalFail](float_value(5.5, float.FLOAT_W_NONE));
    val b: CTValue = R.unwrap_ok[CTValue, EvalFail](float_value(3.0, float.FLOAT_W_NONE));
    val r: R.Result[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, a, b);
    if (R.is_err[CTValue, EvalFail](r))                  { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r).data.f != 2.5) { ret 1; }

    val na: CTValue = R.unwrap_ok[CTValue, EvalFail](float_value(0.0 - 5.5, float.FLOAT_W_NONE));
    val rn: R.Result[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, na, b);
    if (R.is_err[CTValue, EvalFail](rn))                          { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](rn).data.f != (0.0 - 2.5)) { ret 1; }

    val s:   CTValue = R.unwrap_ok[CTValue, EvalFail](float_value(0.45, float.FLOAT_W_NONE));
    val one: CTValue = R.unwrap_ok[CTValue, EvalFail](float_value(1.0, float.FLOAT_W_NONE));
    val rs: R.Result[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, s, one);
    if (R.is_err[CTValue, EvalFail](rs))                   { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](rs).data.f != 0.45) { ret 1; }

    val z: CTValue = R.unwrap_ok[CTValue, EvalFail](float_value(0.0, float.FLOAT_W_NONE));
    if (!R.is_err[CTValue, EvalFail](apply_arith(expr.BIN_MOD, a, z))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.tag_for:registry_names_are_the_only_names" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var quiet: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true,
                                  intern.STR_NIL, intern.STR_NIL);

    var i: usize = 0;
    for (i < isa.arch_catalog_len()) {
        val spelling: str = isa.arch_catalog_name(i);
        val r: R.Result[u32, str] = arch_tag_for(t_view(spelling));
        if (R.is_err[u32, str](r)) { ret 1; }
        if (R.unwrap_ok[u32, str](r) != isa.arch_id_for(spelling)) { ret 1; }
        if (R.unwrap_ok[u32, str](r) == isa.ARCH_UNKNOWN)          { ret 1; }
        i = i + 1;
    }
    if (isa.arch_catalog_len() != 6) { ret 1; }

    i = 0;
    for (i < abi.abi_catalog_len()) {
        val spelling: str = abi.abi_catalog_name(i);
        val r: R.Result[u32, str] = abi_tag_for(?quiet, t_view(spelling));
        if (R.is_err[u32, str](r)) { ret 1; }
        if (R.unwrap_ok[u32, str](r) != abi.abi_id_for(spelling)) { ret 1; }
        if (R.unwrap_ok[u32, str](r) == abi.ABI_UNKNOWN)          { ret 1; }
        i = i + 1;
    }
    if (abi.abi_catalog_len() != 10) { ret 1; }

    i = 0;
    for (i < os.os_catalog_len()) {
        val spelling: str = os.os_catalog_name(i);
        val r: R.Result[u32, str] = os_tag_for(t_view(spelling));
        if (R.is_err[u32, str](r)) { ret 1; }
        if (R.unwrap_ok[u32, str](r) != os.os_id_for(spelling)) { ret 1; }
        if (R.unwrap_ok[u32, str](r) == os.OS_UNKNOWN)          { ret 1; }
        i = i + 1;
    }
    if (os.os_catalog_len() != 4) { ret 1; }

    if (R.is_err[u32, str](arch_tag_for(t_view("spirv"))))   { ret 1; }
    if (R.is_err[u32, str](arch_tag_for(t_view("mos6502")))) { ret 1; }
    if (!R.is_err[u32, str](arch_tag_for(t_view("riscv"))))  { ret 1; }
    if (!R.is_err[u32, str](os_tag_for(t_view("unknown"))))  { ret 1; }

    val current: R.Result[u32, str] = abi_tag_for(?quiet, t_view("sysv64"));
    if (R.is_err[u32, str](current)) { ret 1; }

    var store: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    var loud: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true,
                                 intern.STR_NIL, intern.STR_NIL);
    set_diagnostics(?loud, ?store);
    if (diagnostic.len(?store) != 0) { ret 1; }

    val deprecated: R.Result[u32, str] = abi_tag_for(?loud, t_view("sysv"));
    if (R.is_err[u32, str](deprecated)) { ret 1; }
    if (R.unwrap_ok[u32, str](deprecated) != R.unwrap_ok[u32, str](current)) { ret 1; }
    if (R.unwrap_ok[u32, str](deprecated) != abi.ABI_SYSV)                   { ret 1; }
    if (diagnostic.len(?store) != 1)                                        { ret 1; }
    if (diagnostic.error_count(?store) != 0)                                { ret 1; }

    val noted: R.Result[*diagnostic.Diagnostic, str] = diagnostic.get(?store, 0);
    if (R.is_err[*diagnostic.Diagnostic, str](noted)) { ret 1; }
    val d: *diagnostic.Diagnostic = R.unwrap_ok[*diagnostic.Diagnostic, str](noted);
    if (d.severity != diagnostic.SEVERITY_WARNING)  { ret 1; }
    if (!str_contains(d.message, "sysv64"))         { ret 1; }
    if (!str_contains(d.message, "deprecated"))     { ret 1; }

    val current_again: R.Result[u32, str] = abi_tag_for(?loud, t_view("sysv64"));
    if (R.is_err[u32, str](current_again))   { ret 1; }
    if (diagnostic.len(?store) != 1)         { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.os_tag_for:unknown_errors_freestanding_distinct" {
    if (!R.is_err[u32, str](os_tag_for(t_view("linxu"))))    { ret 1; }
    if (!R.is_err[u32, str](arch_tag_for(t_view("x84_64")))) { ret 1; }
    val fr: R.Result[u32, str] = os_tag_for(t_view("freestanding"));
    if (R.is_err[u32, str](fr))                     { ret 1; }
    if (R.unwrap_ok[u32, str](fr) == os.OS_UNKNOWN) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.frame_close:owner_order_and_repeated_close_rejected" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var first: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    var second: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    val outer_r: R.Result[FrameMark, str] = frame_open(?first);
    val inner_r: R.Result[FrameMark, str] = frame_open(?first);
    if (R.is_err[FrameMark, str](outer_r) || R.is_err[FrameMark, str](inner_r)) { ret 1; }
    val outer: FrameMark = R.unwrap_ok[FrameMark, str](outer_r);
    val inner: FrameMark = R.unwrap_ok[FrameMark, str](inner_r);
    if (!R.is_err[R.Void, str](frame_close(?first, outer))) { ret 1; }
    if (!R.is_err[R.Void, str](frame_close(?second, inner))) { ret 1; }
    if (R.is_err[R.Void, str](frame_close(?first, inner)))   { ret 1; }
    if (!R.is_err[R.Void, str](frame_close(?first, inner))) { ret 1; }
    if (R.is_err[R.Void, str](frame_close(?first, outer)))  { ret 1; }
    val stale_r: R.Result[FrameMark, str] = frame_open(?second);
    if (R.is_err[FrameMark, str](stale_r)) { ret 1; }
    val stale: FrameMark = R.unwrap_ok[FrameMark, str](stale_r);
    dnit(?second);
    if (!R.is_err[R.Void, str](frame_close(?second, stale))) { ret 1; }
    dnit(?first);
    ret 0;
}

fun t_capability_member(calls: *u32, _eid: id.ExprId) R.Result[O.Option[CTValue], EvalFail] {
    @calls = @calls + 1;
    ret R.ok[O.Option[CTValue], EvalFail](O.some[CTValue](ct_u8(1)));
}

fun t_capability_ident(calls: *u32, _eid: id.ExprId) bool {
    @calls = @calls + 1;
    ret false;
}

rec TCapabilityNested {
    inner:       PhaseCapabilities[u32];
    outer_calls: u32;
    inner_calls: u32;
}

fun t_capability_nested(state: *TCapabilityNested, eid: id.ExprId) R.Result[O.Option[CTValue], EvalFail] {
    state.outer_calls = state.outer_calls + 1;
    val r: R.Result[CTValue, EvalFail] = eval_module_member[u32](?state.inner_calls, state.inner, eid);
    if (R.is_err[CTValue, EvalFail](r)) {
        ret R.err[O.Option[CTValue], EvalFail](R.unwrap_err[CTValue, EvalFail](r));
    }
    ret R.ok[O.Option[CTValue], EvalFail](O.some[CTValue](R.unwrap_ok[CTValue, EvalFail](r)));
}

test "mach.lang.fe.comptime.capabilities:mismatched_phase_does_not_dispatch" {
    var calls: u32 = 0;
    val caps_r: R.Result[PhaseCapabilities[u32], str] = loading_capabilities[u32](t_capability_member);
    if (R.is_err[PhaseCapabilities[u32], str](caps_r)) { ret 1; }
    var caps: PhaseCapabilities[u32] = R.unwrap_ok[PhaseCapabilities[u32], str](caps_r);
    val accepted: R.Result[CTValue, EvalFail] = eval_module_member[u32](?calls, caps, id.EXPR_NIL);
    if (R.is_err[CTValue, EvalFail](accepted) || calls != 1) { ret 1; }
    caps.kind = PHASE_CAP_RESOLUTION;
    val mismatched: R.Result[CTValue, EvalFail] = eval_module_member[u32](?calls, caps, id.EXPR_NIL);
    if (!R.is_err[CTValue, EvalFail](mismatched) || calls != 1) { ret 1; }
    val missing: R.Result[CTValue, EvalFail] =
        eval_module_member[NoCapabilityContext](nil, no_capabilities(), id.EXPR_NIL);
    if (!R.is_err[CTValue, EvalFail](missing) || calls != 1) { ret 1; }
    val nil_context: R.Result[CTValue, EvalFail] = eval_module_member[u32](nil, caps, id.EXPR_NIL);
    if (!R.is_err[CTValue, EvalFail](nil_context) || calls != 1) { ret 1; }
    if (!R.is_err[PhaseCapabilities[u32], str](loading_capabilities[u32](nil))) { ret 1; }
    caps.kind = PHASE_CAP_LOADING;
    caps.ident = t_capability_ident;
    val incomplete: R.Result[CTValue, EvalFail] = eval_module_member[u32](?calls, caps, id.EXPR_NIL);
    if (!R.is_err[CTValue, EvalFail](incomplete) || calls != 1) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.capabilities:nested_sessions_keep_their_phase_value" {
    var state: TCapabilityNested;
    state.outer_calls = 0;
    state.inner_calls = 0;
    val inner_r: R.Result[PhaseCapabilities[u32], str] = loading_capabilities[u32](t_capability_member);
    val outer_r: R.Result[PhaseCapabilities[TCapabilityNested], str] =
        loading_capabilities[TCapabilityNested](t_capability_nested);
    if (R.is_err[PhaseCapabilities[u32], str](inner_r)
     || R.is_err[PhaseCapabilities[TCapabilityNested], str](outer_r)) { ret 1; }
    state.inner = R.unwrap_ok[PhaseCapabilities[u32], str](inner_r);
    val outer: PhaseCapabilities[TCapabilityNested] =
        R.unwrap_ok[PhaseCapabilities[TCapabilityNested], str](outer_r);
    val r: R.Result[CTValue, EvalFail] = eval_module_member[TCapabilityNested](?state, outer, id.EXPR_NIL);
    if (R.is_err[CTValue, EvalFail](r)) { ret 1; }
    if (state.outer_calls != 1 || state.inner_calls != 1) { ret 1; }
    ret 0;
}

fun t_bool(r: R.Result[CTValue, EvalFail]) bool {
    ret truth(R.unwrap_ok[CTValue, EvalFail](r));
}

test "mach.lang.fe.comptime.predicates:produce_u8_values" {
    val one: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(1));
    val two: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(2));
    val eq_r: R.Result[CTValue, EvalFail] = apply_equality(expr.BIN_EQ, one, one);
    val lt_r: R.Result[CTValue, EvalFail] = apply_compare(expr.BIN_LT, one, two);
    if (R.is_err[CTValue, EvalFail](eq_r) || R.is_err[CTValue, EvalFail](lt_r)) { ret 1; }
    val eq: CTValue = R.unwrap_ok[CTValue, EvalFail](eq_r);
    val lt: CTValue = R.unwrap_ok[CTValue, EvalFail](lt_r);
    if (!is_u8(eq) || !is_u8(lt)) { ret 1; }
    if (eq.data.i != 1 || lt.data.i != 1) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_compare:u64_magnitude" {
    val big:  CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("0xFFFFFFFFFFFFFFFF"));
    val zero: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(0));
    if (!t_bool(apply_compare(expr.BIN_GT, big, zero))) { ret 1; }
    if (t_bool(apply_compare(expr.BIN_LT, big, zero)))  { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_compare:cross_sign" {
    val big: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("0xFFFFFFFFFFFFFFFF"));
    val neg: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(0 - 1));
    if (!t_bool(apply_compare(expr.BIN_LT, neg, big)))   { ret 1; }
    if (!t_bool(apply_compare(expr.BIN_GT, big, neg)))   { ret 1; }
    if (t_bool(apply_compare(expr.BIN_GEQ, neg, big)))   { ret 1; }
    if (t_bool(apply_equality(expr.BIN_EQ, neg, big)))   { ret 1; }
    if (!t_bool(apply_equality(expr.BIN_NEQ, neg, big))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_equality:cross_sign_magnitude" {
    val s5: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(5));
    val u5: CTValue = R.unwrap_ok[CTValue, EvalFail](make_int_value(5, true));
    if (!t_bool(apply_equality(expr.BIN_EQ, s5, u5))) { ret 1; }
    if (t_bool(apply_compare(expr.BIN_LT, s5, u5)))   { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_equality:type_identity" {
    val a: CTValue = R.unwrap_ok[CTValue, EvalFail](type_value(7));
    val b: CTValue = R.unwrap_ok[CTValue, EvalFail](type_value(7));
    val c: CTValue = R.unwrap_ok[CTValue, EvalFail](type_value(9));
    if (!t_bool(apply_equality(expr.BIN_EQ, a, b)))  { ret 1; }
    if (t_bool(apply_equality(expr.BIN_EQ, a, c)))   { ret 1; }
    if (!t_bool(apply_equality(expr.BIN_NEQ, a, c))) { ret 1; }
    val i: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(7));
    if (!R.is_err[CTValue, EvalFail](apply_equality(expr.BIN_EQ, a, i))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:u64_unsigned_div" {
    val big: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("0xFFFFFFFFFFFFFFFF"));
    val two: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(2));
    val q:   CTValue = R.unwrap_ok[CTValue, EvalFail](apply_arith(expr.BIN_DIV, big, two));
    if (q.data.i:~u64 != 0x7FFFFFFFFFFFFFFF) { ret 1; }
    if (!q.int_unsigned)                     { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:u64_boundary_overflow" {
    val big:  CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("0xFFFFFFFFFFFFFFFF"));
    val one:  CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(1));
    val zero: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(0));
    val dec: CTValue = R.unwrap_ok[CTValue, EvalFail](apply_arith(expr.BIN_SUB, big, one));
    if (!t_bool(apply_compare(expr.BIN_GT, dec, zero))) { ret 1; }
    if (dec.data.i:~u64 != 0xFFFFFFFFFFFFFFFE)          { ret 1; }
    if (!R.is_err[CTValue, EvalFail](apply_arith(expr.BIN_ADD, big, one))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:signed_overflow_traps" {
    val imax: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(t_i64_max()));
    val one:  CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(1));
    if (!R.is_err[CTValue, EvalFail](apply_arith(expr.BIN_ADD, imax, one))) { ret 1; }
    val five: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(5));
    val ten:  CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(10));
    val d:    CTValue = R.unwrap_ok[CTValue, EvalFail](apply_arith(expr.BIN_SUB, five, ten));
    if (d.data.i != (0 - 5)) { ret 1; }
    if (d.int_unsigned)      { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_int_shift:signedness" {
    val big: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("0xFFFFFFFFFFFFFFFF"));
    val one: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(1));
    val lu: CTValue = R.unwrap_ok[CTValue, EvalFail](apply_arith(expr.BIN_SHR, big, one));
    if (lu.data.i:~u64 != 0x7FFFFFFFFFFFFFFF) { ret 1; }
    val negtwo: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(0 - 2));
    val ls: CTValue = R.unwrap_ok[CTValue, EvalFail](apply_arith(expr.BIN_SHR, negtwo, one));
    if (ls.data.i != (0 - 1)) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_int_shift:left_shift_high_bit_matches_the_equivalent_literal" {
    val one:  CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(1));
    val sh63: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(63));
    val shifted: CTValue = R.unwrap_ok[CTValue, EvalFail](apply_arith(expr.BIN_SHL, one, sh63));
    val lit:     CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("0x8000000000000000"));

    if (shifted.int_unsigned != lit.int_unsigned) { ret 1; }
    if (shifted.data.i != lit.data.i)              { ret 2; }
    if (ct_is_negative(shifted))                   { ret 3; }

    val two: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(2));
    if (!R.is_err[CTValue, EvalFail](apply_arith(expr.BIN_SHL, two, sh63))) { ret 4; }

    ret 0;
}

test "mach.lang.fe.comptime.ct_negate:i64_u64_boundary" {
    val imin: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(t_i64_min()));
    val n:    CTValue = R.unwrap_ok[CTValue, EvalFail](ct_negate(imin));
    if (!n.int_unsigned)                     { ret 1; }
    if (n.data.i:~u64 != 0x8000000000000000) { ret 1; }
    val big: CTValue = R.unwrap_ok[CTValue, EvalFail](t_eval_int("0xFFFFFFFFFFFFFFFF"));
    if (!R.is_err[CTValue, EvalFail](ct_negate(big))) { ret 1; }
    ret 0;
}

fun t_dotted(source: str, out_stack: *token.Span) u32 {
    val n: usize = str_len(source);
    var tmp: [8]token.Span;
    var count: u32 = 0;
    var start: usize = 0;
    var i: usize = 0;
    for (i <= n) {
        if (i == n || source[i] == '.') {
            var sp: token.Span;
            sp.offset = start;
            sp.len    = i - start;
            tmp[count] = sp;
            count = count + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < count) {
        out_stack[k] = tmp[count - 1 - k];
        k = k + 1;
    }
    ret count;
}

fun t_build_ctx() ComptimeCtx {
    var c: ComptimeCtx;
    c.env.project_id   = 10;
    c.env.project_ver  = 11;
    c.env.project_name = 12;
    c.env.project_desc = intern.STR_NIL;
    c.env.target_os    = 20;
    c.env.target_isa   = 21;
    c.env.target_abi   = 22;
    c.env.bin_name     = 30;
    ret c;
}

fun t_str_id(r: R.Result[CTValue, EvalFail]) intern.StrId {
    if (R.is_err[CTValue, EvalFail](r)) { ret intern.STR_NIL; }
    val v: CTValue = R.unwrap_ok[CTValue, EvalFail](r);
    if (v.kind != CT_KIND_STR) { ret intern.STR_NIL; }
    ret v.data.s;
}

test "mach.lang.fe.comptime.resolve_project_path:fields" {
    var c: ComptimeCtx = t_build_ctx();
    var stack: [8]token.Span;
    var alloc: A.Allocator;
    page.make(?alloc);
    var itab: intern.Interner = intern.init(?alloc);

    val sid: str = "project.id";
    if (t_str_id(resolve_project_path(?c, sid, ?stack[0], t_dotted(sid, ?stack[0]), ?itab)) != 10) { ret 1; }
    val sver: str = "project.version";
    if (t_str_id(resolve_project_path(?c, sver, ?stack[0], t_dotted(sver, ?stack[0]), ?itab)) != 11) { ret 1; }
    val sname: str = "project.name";
    if (t_str_id(resolve_project_path(?c, sname, ?stack[0], t_dotted(sname, ?stack[0]), ?itab)) != 12) { ret 1; }
    val sdesc: str = "project.description";
    if (!R.is_err[CTValue, EvalFail](resolve_project_path(?c, sdesc, ?stack[0], t_dotted(sdesc, ?stack[0]), ?itab))) { ret 1; }
    val sbogus: str = "project.bogus";
    if (!R.is_err[CTValue, EvalFail](resolve_project_path(?c, sbogus, ?stack[0], t_dotted(sbogus, ?stack[0]), ?itab))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.resolve_project_path:target_tuple" {
    var c: ComptimeCtx = t_build_ctx();
    var stack: [8]token.Span;
    var alloc: A.Allocator;
    page.make(?alloc);
    var itab: intern.Interner = intern.init(?alloc);

    val sos: str = "project.target.os";
    if (t_str_id(resolve_project_path(?c, sos, ?stack[0], t_dotted(sos, ?stack[0]), ?itab)) != 20) { ret 1; }
    val sisa: str = "project.target.arch";
    if (t_str_id(resolve_project_path(?c, sisa, ?stack[0], t_dotted(sisa, ?stack[0]), ?itab)) != 21) { ret 1; }
    val sabi: str = "project.target.abi";
    if (t_str_id(resolve_project_path(?c, sabi, ?stack[0], t_dotted(sabi, ?stack[0]), ?itab)) != 22) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.resolve_mach_path:build_platform" {
    var c: ComptimeCtx = t_build_ctx();
    var stack: [8]token.Span;
    var alloc: A.Allocator;
    page.make(?alloc);
    var itab: intern.Interner = intern.init(?alloc);

    val sp: str = "mach.build.platform";

    val pid_r: R.Result[intern.StrId, str] = intern.intern(?itab, "bmos");
    if (R.is_err[intern.StrId, str](pid_r)) { ret 1; }
    val pid: intern.StrId = R.unwrap_ok[intern.StrId, str](pid_r);
    c.env.target_platform = pid;
    if (t_str_id(resolve_mach_path(?c, sp, ?stack[0], t_dotted(sp, ?stack[0]), ?itab)) != pid) { ret 1; }

    c.env.target_platform = intern.STR_NIL;
    val empty_r: R.Result[intern.StrId, str] = intern.intern(?itab, "");
    if (R.is_err[intern.StrId, str](empty_r)) { ret 1; }
    val empty_id: intern.StrId = R.unwrap_ok[intern.StrId, str](empty_r);
    if (empty_id == intern.STR_NIL) { ret 1; }
    if (t_str_id(resolve_mach_path(?c, sp, ?stack[0], t_dotted(sp, ?stack[0]), ?itab)) != empty_id) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.resolve_bin_path:name" {
    var c: ComptimeCtx = t_build_ctx();
    var stack: [8]token.Span;
    val sn: str = "bin.name";
    if (t_str_id(resolve_bin_path(?c, sn, ?stack[0], t_dotted(sn, ?stack[0]))) != 30) { ret 1; }
    c.env.bin_name = intern.STR_NIL;
    if (!R.is_err[CTValue, EvalFail](resolve_bin_path(?c, sn, ?stack[0], t_dotted(sn, ?stack[0])))) { ret 1; }
    ret 0;
}

fun t_char(s: str) R.Result[CTValue, EvalFail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret eval_lit_char(s, span);
}

fun t_float(s: str) R.Result[CTValue, EvalFail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret eval_lit_float(s, span);
}

fun t_fbits(s: str) u64 {
    val r: R.Result[CTValue, EvalFail] = t_float(s);
    if (R.is_err[CTValue, EvalFail](r)) { ret 0xFFFFFFFFFFFFFFFF; }
    ret float.f64_bits(R.unwrap_ok[CTValue, EvalFail](r).data.f);
}

test "mach.lang.fe.comptime.eval_lit_char:escapes_and_malformed" {
    if (R.is_err[CTValue, EvalFail](t_char("'\\n'")))                 { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](t_char("'\\n'")).data.i != 10) { ret 1; }
    if (R.is_err[CTValue, EvalFail](t_char("'\\t'")))                { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](t_char("'\\t'")).data.i != 9) { ret 1; }
    if (R.is_err[CTValue, EvalFail](t_char("'\\\\'")))                 { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](t_char("'\\\\'")).data.i != 92) { ret 1; }
    if (R.is_err[CTValue, EvalFail](t_char("'\\0'")))                { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](t_char("'\\0'")).data.i != 0) { ret 1; }
    if (R.is_err[CTValue, EvalFail](t_char("'\\''"))  )               { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](t_char("'\\''")).data.i != 39) { ret 1; }
    if (!R.is_err[CTValue, EvalFail](t_char("'ab'")))  { ret 1; }
    if (!R.is_err[CTValue, EvalFail](t_char("''")))    { ret 1; }
    if (!R.is_err[CTValue, EvalFail](t_char("'a")))    { ret 1; }
    ret 0;
}

fun t_scan_float(s: str) R.Result[LitFloat, str] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret scan_lit_float(s, span);
}

test "mach.lang.fe.comptime.scan_lit_float:suffix_names_the_float_width" {
    val a: LitFloat = R.unwrap_ok[LitFloat, str](t_scan_float("1.5f32"));
    if (a.suffix != type.TYPE_F32) { ret 1; }
    val b: LitFloat = R.unwrap_ok[LitFloat, str](t_scan_float("1.5f64"));
    if (b.suffix != type.TYPE_F64) { ret 2; }
    val c: LitFloat = R.unwrap_ok[LitFloat, str](t_scan_float("1.5"));
    if (c.suffix != expr.LIT_SUFFIX_NONE) { ret 3; }

    if (!R.is_err[LitFloat, str](t_scan_float("1.5f16"))) { ret 4; }
    if (!R.is_err[LitFloat, str](t_scan_float("1.5f")))   { ret 5; }
    if (!R.is_err[LitFloat, str](t_scan_float("1.5u32"))) { ret 6; }
    ret 0;
}

test "mach.lang.fe.comptime.scan_lit_float:f32_suffix_rounds_at_binary32" {
    val wide:   f64 = R.unwrap_ok[LitFloat, str](t_scan_float("0.1")).value;
    val narrow: f64 = R.unwrap_ok[LitFloat, str](t_scan_float("0.1f32")).value;
    if (float.f64_bits(wide) == float.f64_bits(narrow))                        { ret 1; }
    if (float.f64_bits(narrow) != float.f64_bits(float.round_at(wide, float.FLOAT_W_32))) { ret 2; }

    val ev: CTValue = R.unwrap_ok[CTValue, EvalFail](t_float("0.1f32"));
    if (ev.float_width != float.FLOAT_W_32)               { ret 3; }
    if (float.f64_bits(ev.data.f) != float.f64_bits(narrow)) { ret 4; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:exponent_forms" {
    val r1: R.Result[CTValue, EvalFail] = t_float("1.5e2");
    if (R.is_err[CTValue, EvalFail](r1))                    { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r1).data.f != 150.0) { ret 1; }
    val r2: R.Result[CTValue, EvalFail] = t_float("1.0E-1");
    if (R.is_err[CTValue, EvalFail](r2)) { ret 1; }
    var d2: f64 = R.unwrap_ok[CTValue, EvalFail](r2).data.f - 0.1;
    if (d2 < 0.0)    { d2 = 0.0 - d2; }
    if (d2 > 1.0e-9) { ret 1; }
    val r3: R.Result[CTValue, EvalFail] = t_float("3.14");
    if (R.is_err[CTValue, EvalFail](r3)) { ret 1; }
    var d3: f64 = R.unwrap_ok[CTValue, EvalFail](r3).data.f - 3.14;
    if (d3 < 0.0)    { d3 = 0.0 - d3; }
    if (d3 > 1.0e-9) { ret 1; }
    val r4: R.Result[CTValue, EvalFail] = t_float("1.");
    if (R.is_err[CTValue, EvalFail](r4))                  { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r4).data.f != 1.0) { ret 1; }
    if (!R.is_err[CTValue, EvalFail](t_float(""))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:extreme_exponent_saturates" {
    val rp: R.Result[CTValue, EvalFail] = t_float("1.0e2000000000");
    if (R.is_err[CTValue, EvalFail](rp))                        { ret 1; }
    if (!(R.unwrap_ok[CTValue, EvalFail](rp).data.f > 1.0e308)) { ret 1; }
    val rn: R.Result[CTValue, EvalFail] = t_float("1.0e-2000000000");
    if (R.is_err[CTValue, EvalFail](rn))                  { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](rn).data.f != 0.0) { ret 1; }
    val rz: R.Result[CTValue, EvalFail] = t_float("0.0e2000000000");
    if (R.is_err[CTValue, EvalFail](rz))                  { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](rz).data.f != 0.0) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:correctly_rounded" {
    if (t_fbits("1.0e100")                  != 0x54B249AD2594C37D) { ret 1; }

    if (t_fbits("1.0e308")                  != 0x7FE1CCF385EBC8A0) { ret 2; }
    if (t_fbits("1.0e-308")                 != 0x000730D67819E8D2) { ret 3; }
    if (t_fbits("1.0e-300")                 != 0x01A56E1FC2F8F359) { ret 4; }
    if (t_fbits("1.0e23")                   != 0x44B52D02C7E14AF6) { ret 5; }
    if (t_fbits("9.999999999999999e307")    != 0x7FE1CCF385EBC89F) { ret 6; }
    if (t_fbits("8.98846567431158e307")     != 0x7FE0000000000000) { ret 7; }

    if (t_fbits("1.7976931348623157e308")   != 0x7FEFFFFFFFFFFFFF) { ret 8; }
    if (t_fbits("2.2250738585072014e-308")  != 0x0010000000000000) { ret 9; }
    if (t_fbits("2.2250738585072009e-308")  != 0x000FFFFFFFFFFFFF) { ret 10; }
    if (t_fbits("5.0e-324")                 != 0x0000000000000001) { ret 11; }
    if (t_fbits("1.0e-323")                 != 0x0000000000000002) { ret 12; }
    if (t_fbits("7.5e-324")                 != 0x0000000000000002) { ret 13; }

    if (t_fbits("1.00000000000000011102230246251565404236316680908203125")
                                            != 0x3FF0000000000000) { ret 14; }
    if (t_fbits("1.00000000000000033306690738754696212708950042724609375")
                                            != 0x3FF0000000000002) { ret 15; }
    if (t_fbits("1.000000000000000111022302462515654042363166809082031250000001")
                                            != 0x3FF0000000000001) { ret 16; }

    if (t_fbits("1.0e320")                  != 0x7FF0000000000000) { ret 17; }
    if (t_fbits("0.1")                      != 0x3FB999999999999A) { ret 18; }
    if (t_fbits("3.141592653589793")        != 0x400921FB54442D18) { ret 19; }
    if (t_fbits("1.5e2")                    != 0x4062C00000000000) { ret 20; }
    if (t_fbits("123456789.0")              != 0x419D6F3454000000) { ret 21; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:sticky_bit_tie" {
    if (t_fbits("1.")
                                            != 0x3FF0000000000001) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.float_trunc_rem:exact_at_the_real_2_53_boundary" {
    if (float.f64_bits(float_trunc_rem(9007199254740984.0, 7.0, float.FLOAT_W_64)) != 0x4008000000000000) { ret 1; }
    if (float.f64_bits(float_trunc_rem(9007199254740996.0, 7.0, float.FLOAT_W_64)) != 0x3FF0000000000000) { ret 2; }
    if (float.f64_bits(float_trunc_rem(1.0e300, 3.0, float.FLOAT_W_64)) != 0x0000000000000000) { ret 3; }
    if (float.f64_bits(float_trunc_rem(1.0e300, 7.0, float.FLOAT_W_64)) != 0x3FF0000000000000) { ret 4; }
    if (float.f64_bits(float_trunc_rem(0.0 - 1.0e300, 7.0, float.FLOAT_W_64)) != 0xBFF0000000000000) { ret 5; }
    if (float_trunc_rem(7.5, 2.0, float.FLOAT_W_64) != 1.5)          { ret 6; }
    if (float_trunc_rem(0.0 - 7.5, 2.0, float.FLOAT_W_64) != -1.5)   { ret 7; }
    if (float_trunc_rem(2.0, 5.0, float.FLOAT_W_64) != 2.0)          { ret 8; }

    if (float.f64_bits(float_trunc_rem(1.0, 0.0, float.FLOAT_W_64)) == 0xDEADBEEFDEADBEEF) { ret 9; }
    if (float.f64_bits(float_trunc_rem(float.bits_f64(0x7FF0000000000000), 3.0, float.FLOAT_W_64)) == 0xDEADBEEFDEADBEEF) { ret 10; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:prefixes_and_separators" {
    val r1: R.Result[CTValue, EvalFail] = t_eval_int("0b11111111");
    if (R.is_err[CTValue, EvalFail](r1))                       { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r1).data.i:~u64 != 255) { ret 1; }
    val r2: R.Result[CTValue, EvalFail] = t_eval_int("0o377");
    if (R.is_err[CTValue, EvalFail](r2))                       { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r2).data.i:~u64 != 255) { ret 1; }
    val r3: R.Result[CTValue, EvalFail] = t_eval_int("1_000");
    if (R.is_err[CTValue, EvalFail](r3))                   { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r3).data.i != 1000) { ret 1; }
    val r4: R.Result[CTValue, EvalFail] = t_eval_int("0b1_0000_0000");
    if (R.is_err[CTValue, EvalFail](r4))                       { ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r4).data.i:~u64 != 256) { ret 1; }
    if (!R.is_err[CTValue, EvalFail](t_eval_int("0b"))) { ret 1; }
    if (!R.is_err[CTValue, EvalFail](t_eval_int("0o"))) { ret 1; }
    if (!R.is_err[CTValue, EvalFail](t_eval_int("0x"))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.bind:frame_scoping" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var c: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);

    val name1: intern.StrId = 1::intern.StrId;
    val name2: intern.StrId = 2::intern.StrId;

    val v10: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(10));
    val v20: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(20));

    val b1: R.Result[R.Void, str] = bind(?c, name1, v10);
    if (R.is_err[R.Void, str](b1)) { dnit(?c); ret 1; }

    val mr: R.Result[FrameMark, str] = frame_open(?c);
    if (R.is_err[FrameMark, str](mr)) { dnit(?c); ret 1; }
    val m: FrameMark = R.unwrap_ok[FrameMark, str](mr);
    val b2: R.Result[R.Void, str] = bind(?c, name1, v20);
    if (R.is_err[R.Void, str](b2)) { dnit(?c); ret 1; }
    val df: R.Result[R.Void, str] = defer_float_width(?c, name2);
    if (R.is_err[R.Void, str](df)) { dnit(?c); ret 1; }

    val lk1: O.Option[NamedConst] = lookup(?c, name1);
    if (O.is_none[NamedConst](lk1))                   { dnit(?c); ret 1; }
    if (O.unwrap[NamedConst](lk1).value.data.i != 20) { dnit(?c); ret 1; }

    val fc: R.Result[R.Void, str] = frame_close(?c, m);
    if (R.is_err[R.Void, str](fc)) { dnit(?c); ret 1; }

    val lk2: O.Option[NamedConst] = lookup(?c, name1);
    if (O.is_none[NamedConst](lk2))                   { dnit(?c); ret 1; }
    if (O.unwrap[NamedConst](lk2).value.data.i != 10) { dnit(?c); ret 1; }

    val lk3: O.Option[NamedConst] = lookup(?c, name2);
    if (!O.is_none[NamedConst](lk3))        { dnit(?c); ret 1; }
    if (float_width_deferred(?c, name2))    { dnit(?c); ret 1; }

    val depth_before: u32 = c.entries_len;
    val m2r: R.Result[FrameMark, str] = frame_open(?c);
    if (R.is_err[FrameMark, str](m2r)) { dnit(?c); ret 1; }
    val m2: FrameMark = R.unwrap_ok[FrameMark, str](m2r);
    val fc2: R.Result[R.Void, str] = frame_close(?c, m2);
    if (R.is_err[R.Void, str](fc2))      { dnit(?c); ret 1; }
    if (c.entries_len != depth_before) { dnit(?c); ret 1; }

    dnit(?c);
    ret 0;
}

test "mach.lang.fe.comptime.eval_ident:deferred_float_is_not_absent" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var c: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    var itn: intern.Interner = intern.init(?alloc);

    val source: str = "ALIASED ABSENT";
    var s_alias: token.Span;
    s_alias.offset = 0::usize;
    s_alias.len    = 7::usize;
    var s_absent: token.Span;
    s_absent.offset = 8::usize;
    s_absent.len    = 6::usize;

    val id_r: R.Result[intern.StrId, str] = intern.intern_span(?itn, source, s_alias);
    if (R.is_err[intern.StrId, str](id_r)) { dnit(?c); ret 1; }
    val aliased: intern.StrId = R.unwrap_ok[intern.StrId, str](id_r);

    val r0: R.Result[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_alias, ?itn);
    if (!R.is_err[CTValue, EvalFail](r0))                                              { dnit(?c); ret 1; }
    if (R.unwrap_err[CTValue, EvalFail](r0).message == COMPTIME_ALIAS_FLOAT_MSG)               { dnit(?c); ret 1; }

    val d: R.Result[R.Void, str] = defer_float_width(?c, aliased);
    if (R.is_err[R.Void, str](d))            { dnit(?c); ret 1; }
    if (!float_width_deferred(?c, aliased)) { dnit(?c); ret 1; }

    val r1: R.Result[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_alias, ?itn);
    if (!R.is_err[CTValue, EvalFail](r1))                                { dnit(?c); ret 1; }
    if (R.unwrap_err[CTValue, EvalFail](r1).message != COMPTIME_ALIAS_FLOAT_MSG) { dnit(?c); ret 1; }

    val r2: R.Result[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_absent, ?itn);
    if (!R.is_err[CTValue, EvalFail](r2))                                { dnit(?c); ret 1; }
    if (R.unwrap_err[CTValue, EvalFail](r2).message == COMPTIME_ALIAS_FLOAT_MSG) { dnit(?c); ret 1; }

    val bv: CTValue = R.unwrap_ok[CTValue, EvalFail](int_value(3));
    val b: R.Result[R.Void, str] = bind(?c, aliased, bv);
    if (R.is_err[R.Void, str](b)) { dnit(?c); ret 1; }
    val r3: R.Result[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_alias, ?itn);
    if (R.is_err[CTValue, EvalFail](r3))                            { dnit(?c); ret 1; }
    if (R.unwrap_ok[CTValue, EvalFail](r3).data.i != 3)             { dnit(?c); ret 1; }

    dnit(?c);
    ret 0;
}

test "mach.lang.fe.comptime.eval_ident:true_and_false_are_ordinary_bindings" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var c: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    var itn: intern.Interner = intern.init(?alloc);

    val source: str = "true false";
    var s_true: token.Span;
    s_true.offset = 0::usize;
    s_true.len    = 4::usize;
    var s_false: token.Span;
    s_false.offset = 5::usize;
    s_false.len    = 5::usize;

    val unbound: R.Result[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_true, ?itn);
    if (!R.is_err[CTValue, EvalFail](unbound)) { dnit(?c); ret 1; }

    val true_id_r: R.Result[intern.StrId, str] = intern.intern_span(?itn, source, s_true);
    if (R.is_err[intern.StrId, str](true_id_r)) { dnit(?c); ret 1; }
    val false_id_r: R.Result[intern.StrId, str] = intern.intern_span(?itn, source, s_false);
    if (R.is_err[intern.StrId, str](false_id_r)) { dnit(?c); ret 1; }

    val bind_true: R.Result[R.Void, str] = bind(?c, R.unwrap_ok[intern.StrId, str](true_id_r), ct_u8(1));
    if (R.is_err[R.Void, str](bind_true)) { dnit(?c); ret 1; }
    val bind_false: R.Result[R.Void, str] = bind(?c, R.unwrap_ok[intern.StrId, str](false_id_r), ct_u8(0));
    if (R.is_err[R.Void, str](bind_false)) { dnit(?c); ret 1; }

    val true_r: R.Result[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_true, ?itn);
    if (R.is_err[CTValue, EvalFail](true_r)) { dnit(?c); ret 1; }
    val true_v: CTValue = R.unwrap_ok[CTValue, EvalFail](true_r);
    if (!is_u8(true_v) || true_v.data.i != 1) { dnit(?c); ret 1; }

    val false_r: R.Result[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_false, ?itn);
    if (R.is_err[CTValue, EvalFail](false_r)) { dnit(?c); ret 1; }
    val false_v: CTValue = R.unwrap_ok[CTValue, EvalFail](false_r);
    if (!is_u8(false_v) || false_v.data.i != 0) { dnit(?c); ret 1; }

    dnit(?c);
    ret 0;
}

test "mach.lang.fe.comptime.encode_scalar:int_honors_declared_endianness" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: type.TypeInterner;
    if (O.is_some[str](type.init(?ti, ?alloc))) { ret 1; }

    val u32t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_U32));
    val c: TypedConstant = const_int(u32t, 0x11223344);

    var buf_le: [4]u8;
    var reloc: O.Option[RelocationRequest];
    val le_r: R.Result[u32, str] = encode_scalar(?ti, c, data_model(8, false), 0, ?buf_le[0], 4, ?reloc);
    if (R.is_err[u32, str](le_r) || R.unwrap_ok[u32, str](le_r) != 4) { type.dnit(?ti); ret 1; }
    if (buf_le[0] != 0x44 || buf_le[1] != 0x33 || buf_le[2] != 0x22 || buf_le[3] != 0x11) { type.dnit(?ti); ret 1; }

    var buf_be: [4]u8;
    val be_r: R.Result[u32, str] = encode_scalar(?ti, c, data_model(8, true), 0, ?buf_be[0], 4, ?reloc);
    if (R.is_err[u32, str](be_r) || R.unwrap_ok[u32, str](be_r) != 4) { type.dnit(?ti); ret 1; }
    if (buf_be[0] != 0x11 || buf_be[1] != 0x22 || buf_be[2] != 0x33 || buf_be[3] != 0x44) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.const_float:rounds_to_declared_width_and_roundtrips" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: type.TypeInterner;
    if (O.is_some[str](type.init(?ti, ?alloc))) { ret 1; }

    val f32t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_F32));
    val f64t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_F64));
    val precise: f64 = 0.1;

    val c32_r: R.Result[TypedConstant, str] = const_float(?ti, f32t, precise);
    if (R.is_err[TypedConstant, str](c32_r)) { type.dnit(?ti); ret 1; }
    val c32: TypedConstant = R.unwrap_ok[TypedConstant, str](c32_r);
    if (float.bits_f64(c32.bits) == precise) { type.dnit(?ti); ret 1; }

    val c64_r: R.Result[TypedConstant, str] = const_float(?ti, f64t, precise);
    if (R.is_err[TypedConstant, str](c64_r)) { type.dnit(?ti); ret 1; }
    val c64: TypedConstant = R.unwrap_ok[TypedConstant, str](c64_r);
    if (float.bits_f64(c64.bits) != precise) { type.dnit(?ti); ret 1; }

    var buf32: [4]u8;
    var reloc: O.Option[RelocationRequest];
    val e32: R.Result[u32, str] = encode_scalar(?ti, c32, data_model(8, false), 0, ?buf32[0], 4, ?reloc);
    if (R.is_err[u32, str](e32) || R.unwrap_ok[u32, str](e32) != 4) { type.dnit(?ti); ret 1; }
    val back32: u32 = buf32[0]::u32 | (buf32[1]::u32 << 8) | (buf32[2]::u32 << 16) | (buf32[3]::u32 << 24);
    if (float.f32_bits_to_f64_bits(back32) != c32.bits) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.const_reinterpret:relabels_kind_and_strips_secret_before_measuring" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: type.TypeInterner;
    if (O.is_some[str](type.init(?ti, ?alloc))) { ret 1; }

    val u32t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_U32));
    val f32t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_F32));
    val u64t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_U64));
    val sec_r: R.Result[type.TypeId, str] = type.intern_secret(?ti, f32t);
    if (R.is_err[type.TypeId, str](sec_r)) { type.dnit(?ti); ret 1; }
    val sec_f32: type.TypeId = R.unwrap_ok[type.TypeId, str](sec_r);

    val c: TypedConstant = const_int(u32t, 0x3F800000);
    val re_r: R.Result[TypedConstant, str] = const_reinterpret(?ti, c, sec_f32, 8);
    if (R.is_err[TypedConstant, str](re_r)) { type.dnit(?ti); ret 1; }
    val re: TypedConstant = R.unwrap_ok[TypedConstant, str](re_r);
    if (re.kind != CONST_FLOAT || re.bits != 0x3F800000 || re.ty != sec_f32) { type.dnit(?ti); ret 1; }

    val bad_r: R.Result[TypedConstant, str] = const_reinterpret(?ti, c, u64t, 8);
    if (!R.is_err[TypedConstant, str](bad_r)) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.encode_scalar:pointer_field_emits_relocation_not_a_fabricated_address" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: type.TypeInterner;
    if (O.is_some[str](type.init(?ti, ?alloc))) { ret 1; }

    val u32t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_U32));
    val ptr_r: R.Result[type.TypeId, str] = type.intern_pointer(?ti, u32t);
    if (R.is_err[type.TypeId, str](ptr_r)) { type.dnit(?ti); ret 1; }
    val ptr_ty: type.TypeId = R.unwrap_ok[type.TypeId, str](ptr_r);

    val sym: intern.StrId = 42::intern.StrId;
    val c: TypedConstant = const_pointer(ptr_ty, sym, 12);

    var buf: [8]u8;
    var i: u32 = 0;
    for (i < 8) { buf[i] = 0xAA; i = i + 1; }
    var reloc: O.Option[RelocationRequest];
    val r: R.Result[u32, str] = encode_scalar(?ti, c, data_model(8, false), 100, ?buf[0], 8, ?reloc);
    if (R.is_err[u32, str](r) || R.unwrap_ok[u32, str](r) != 8) { type.dnit(?ti); ret 1; }
    i = 0;
    for (i < 8) { if (buf[i] != 0) { type.dnit(?ti); ret 1; } i = i + 1; }
    if (O.is_none[RelocationRequest](reloc)) { type.dnit(?ti); ret 1; }
    val rr: RelocationRequest = O.unwrap[RelocationRequest](reloc);
    if (rr.offset != 100 || rr.symbol != sym || rr.addend != 12 || rr.width != 8) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.const_address_add:checked_and_rejects_overflow" {
    val sym: intern.StrId = 7::intern.StrId;
    val nil_ty: type.TypeId = 0::type.TypeId;
    val c: TypedConstant = const_symbol(nil_ty, sym);

    val ok_r: R.Result[TypedConstant, str] = const_address_add(c, 16);
    if (R.is_err[TypedConstant, str](ok_r)) { ret 1; }
    if (R.unwrap_ok[TypedConstant, str](ok_r).addr.addend != 16) { ret 1; }

    val near_max: TypedConstant = const_pointer(nil_ty, sym, 9223372036854775806);
    val overflow_r: R.Result[TypedConstant, str] = const_address_add(near_max, 2);
    if (!R.is_err[TypedConstant, str](overflow_r)) { ret 1; }

    val near_min: TypedConstant = const_pointer(nil_ty, sym, -9223372036854775807);
    val underflow_r: R.Result[TypedConstant, str] = const_address_add(near_min, -2);
    if (!R.is_err[TypedConstant, str](underflow_r)) { ret 1; }

    val non_address: TypedConstant = const_int(nil_ty, 0);
    if (!R.is_err[TypedConstant, str](const_address_add(non_address, 1))) { ret 1; }

    ret 0;
}

test "mach.lang.fe.comptime.encode_scalar:destination_buffer_too_small_fails_closed" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var ti: type.TypeInterner;
    if (O.is_some[str](type.init(?ti, ?alloc))) { ret 1; }

    val u64t: type.TypeId = O.unwrap[type.TypeId](type.prim(?ti, type.TYPE_U64));
    val c: TypedConstant = const_int(u64t, 1);

    var buf: [4]u8;
    var reloc: O.Option[RelocationRequest];
    val r: R.Result[u32, str] = encode_scalar(?ti, c, data_model(8, false), 0, ?buf[0], 4, ?reloc);
    if (!R.is_err[u32, str](r)) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.gate_depends_on:unlisted_expression_kind_fails_closed" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);

    var lit: expr.Expr;
    lit.kind = expr.EXPR_KIND_LIT_INT;
    lit.data.lit_int.value  = 1;
    lit.data.lit_int.suffix = expr.LIT_SUFFIX_NONE;
    val lit_r: R.Result[id.ExprId, str] = ast.add_expr(?a, lit);
    if (R.is_err[id.ExprId, str](lit_r)) { ast.dnit(?a); ret 1; }

    var ident: expr.Expr;
    ident.kind = expr.EXPR_KIND_IDENT;
    val ident_r: R.Result[id.ExprId, str] = ast.add_expr(?a, ident);
    if (R.is_err[id.ExprId, str](ident_r)) { ast.dnit(?a); ret 1; }

    var unlisted: expr.Expr;
    unlisted.kind = 5::expr.ExprKind;
    val un_r: R.Result[id.ExprId, str] = ast.add_expr(?a, unlisted);
    if (R.is_err[id.ExprId, str](un_r)) { ast.dnit(?a); ret 1; }

    var nested: expr.Expr;
    nested.kind = expr.EXPR_KIND_UNARY;
    nested.data.unary.op      = expr.UN_NOT;
    nested.data.unary.operand = R.unwrap_ok[id.ExprId, str](un_r);
    val nest_r: R.Result[id.ExprId, str] = ast.add_expr(?a, nested);
    if (R.is_err[id.ExprId, str](nest_r)) { ast.dnit(?a); ret 1; }

    val probes: GateProbes[NoCapabilityContext] = gate_probes[NoCapabilityContext](nil, nil, nil, nil);
    var bad: i32 = 0;

    val listed: R.Result[bool, str] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, R.unwrap_ok[id.ExprId, str](lit_r));
    if (R.is_err[bool, str](listed) || R.unwrap_ok[bool, str](listed)) { bad = 1; }

    val closed: R.Result[bool, str] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, R.unwrap_ok[id.ExprId, str](nest_r));
    if (!R.is_err[bool, str](closed)) { bad = 2; }
    or (!str_equals(R.unwrap_err[bool, str](closed), GATE_PROBE_UNLISTED_KIND_MSG)) { bad = 3; }

    val no_obs: R.Result[bool, str] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_COMPTIME_PARAM, R.unwrap_ok[id.ExprId, str](ident_r));
    if (!R.is_err[bool, str](no_obs)) { bad = 4; }
    or (!str_equals(R.unwrap_err[bool, str](no_obs), GATE_PROBE_NO_OBSERVER_MSG)) { bad = 5; }

    val out_of_range: R.Result[bool, str] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, 99::id.ExprId);
    if (!R.is_err[bool, str](out_of_range)) { bad = 6; }

    ast.dnit(?a);
    ret bad;
}


fun t_capability_refusing(alloc: *A.Allocator, _eid: id.ExprId) R.Result[O.Option[CTValue], EvalFail] {
    val r: R.Result[*u8, str] = A.allocate[u8](alloc, 1);
    if (R.is_err[*u8, str](r)) {
        ret R.err[O.Option[CTValue], EvalFail](eval_error(EVAL_FAIL_INTERNAL, R.unwrap_err[*u8, str](r)));
    }
    A.deallocate[u8](alloc, R.unwrap_ok[*u8, str](r), 1);
    ret R.ok[O.Option[CTValue], EvalFail](O.some[CTValue](ct_u8(1)));
}

test "mach.lang.fe.comptime.capabilities:callback_allocation_failure_preserves_internal_kind" {
    var t: T.Testing;
    if (O.is_some[str](T.make(?t))) { ret 1; }
    fin { T.dnit(?t); }
    val cr: R.Result[PhaseCapabilities[A.Allocator], str] = loading_capabilities[A.Allocator](t_capability_refusing);
    if (R.is_err[PhaseCapabilities[A.Allocator], str](cr)) { ret 2; }
    val caps: PhaseCapabilities[A.Allocator] = R.unwrap_ok[PhaseCapabilities[A.Allocator], str](cr);
    T.fail_at_ordinal(?t, 1);
    val r: R.Result[CTValue, EvalFail] = eval_module_member[A.Allocator](T.allocator_of(?t), caps, id.EXPR_NIL);
    if (R.is_ok[CTValue, EvalFail](r)) { ret 3; }
    if (R.unwrap_err[CTValue, EvalFail](r).kind != EVAL_FAIL_INTERNAL) { ret 4; }
    if (T.attempt_count(?t) != 1 || T.leaked(?t) || T.double_free_count(?t) != 0) { ret 5; }
    ret 0;
}
