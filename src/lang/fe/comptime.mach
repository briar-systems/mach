}

#[testing]
fun t_float(s: str) res[comptime_value.CTValue, comptime_failure.EvalFail] {
    var span: lang_source.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret eval_lit_float(s, span);
}

#[testing]
fun t_fbits(s: str) u64 {
    val r: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float(s);
    if (sel r.err) { ret 0xFFFFFFFFFFFFFFFF; }
    ret float.f64_bits(r.ok.data.f);
}

test scan_lit_float__f32_suffix_rounds_at_binary32 {
    val t_scan_float_1: res[fe_literal.Float, fe_literal.Refusal] = fe_literal.t_scan_float("0.1");
    if (!sel t_scan_float_1.ok) { ret 1; }
    val wide:           f64                                       = t_scan_float_1.ok.value;
    val t_scan_float_2: res[fe_literal.Float, fe_literal.Refusal] = fe_literal.t_scan_float("0.1f32");
    if (!sel t_scan_float_2.ok) { ret 1; }
    val narrow: f64 = t_scan_float_2.ok.value;
    if (float.f64_bits(wide) == float.f64_bits(narrow))                                   { ret 1; }
    if (float.f64_bits(narrow) != float.f64_bits(float.round_at(wide, float.FLOAT_W_32))) { ret 2; }

    val t_float_r: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("0.1f32");
    if (sel t_float_r.err) { ret 99; }
    val ev: comptime_value.CTValue = t_float_r.ok;
    if (ev.float_width != float.FLOAT_W_32)                  { ret 3; }
    if (float.f64_bits(ev.data.f) != float.f64_bits(narrow)) { ret 4; }
    ret 0;
}

test eval_lit_float__exponent_forms {
    val r1: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("1.5e2");
    if (sel r1.err)            { ret 1; }
    if (r1.ok.data.f != 150.0) { ret 1; }
    val r2: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("1.0E-1");
    if (sel r2.err) { ret 1; }
    var d2: f64 = r2.ok.data.f - 0.1;
    if (d2 < 0.0)    { d2 = 0.0 - d2; }
    if (d2 > 1.0e-9) { ret 1; }
    val r3: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("3.14");
    if (sel r3.err) { ret 1; }
    var d3: f64 = r3.ok.data.f - 3.14;
    if (d3 < 0.0)    { d3 = 0.0 - d3; }
    if (d3 > 1.0e-9) { ret 1; }
    val r4: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("1.");
    if (sel r4.err)          { ret 1; }
    if (r4.ok.data.f != 1.0) { ret 1; }
    val t_float_r: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("");
    if (sel t_float_r.ok) { ret 1; }
    ret 0;
}

test eval_lit_float__extreme_exponent_saturates {
    val rp: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("1.0e2000000000");
    if (sel rp.err)                { ret 1; }
    if (!(rp.ok.data.f > 1.0e308)) { ret 1; }
    val rn: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("1.0e-2000000000");
    if (sel rn.err)          { ret 1; }
    if (rn.ok.data.f != 0.0) { ret 1; }
    val rz: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_float("0.0e2000000000");
    if (sel rz.err)          { ret 1; }
    if (rz.ok.data.f != 0.0) { ret 1; }
    ret 0;
}

test eval_lit_float__correctly_rounded {
    if (t_fbits("1.0e100") != 0x54B249AD2594C37D) { ret 1; }

    if (t_fbits("1.0e308") != 0x7FE1CCF385EBC8A0)               { ret 2; }
    if (t_fbits("1.0e-308") != 0x000730D67819E8D2)              { ret 3; }
    if (t_fbits("1.0e-300") != 0x01A56E1FC2F8F359)              { ret 4; }
    if (t_fbits("1.0e23") != 0x44B52D02C7E14AF6)                { ret 5; }
    if (t_fbits("9.999999999999999e307") != 0x7FE1CCF385EBC89F) { ret 6; }
    if (t_fbits("8.98846567431158e307") != 0x7FE0000000000000)  { ret 7; }

    if (t_fbits("1.7976931348623157e308") != 0x7FEFFFFFFFFFFFFF)  { ret 8; }
    if (t_fbits("2.2250738585072014e-308") != 0x0010000000000000) { ret 9; }
    if (t_fbits("2.2250738585072009e-308") != 0x000FFFFFFFFFFFFF) { ret 10; }
    if (t_fbits("5.0e-324") != 0x0000000000000001)                { ret 11; }
    if (t_fbits("1.0e-323") != 0x0000000000000002)                { ret 12; }
    if (t_fbits("7.5e-324") != 0x0000000000000002)                { ret 13; }

    if (t_fbits("1.00000000000000011102230246251565404236316680908203125")
        != 0x3FF0000000000000) { ret 14; }
    if (t_fbits("1.00000000000000033306690738754696212708950042724609375")
        != 0x3FF0000000000002) { ret 15; }
    if (t_fbits("1.000000000000000111022302462515654042363166809082031250000001")
        != 0x3FF0000000000001) { ret 16; }

    if (t_fbits("1.0e320") != 0x7FF0000000000000) { ret 17; }
    if (t_fbits("0.1") != 0x3FB999999999999A)     { ret 18; }
    ret 0;
}

test eval_lit_float__sticky_bit_tie {
    if (t_fbits("1.")
        != 0x3FF0000000000001) { ret 1; }
    ret 0;
}

test eval_lit_int__prefixes_and_separators {
    val r1: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_eval_int("0b11111111");
    if (sel r1.err)               { ret 1; }
    if (r1.ok.data.i:~u64 != 255) { ret 1; }
    val r2: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_eval_int("0o377");
    if (sel r2.err)               { ret 1; }
    if (r2.ok.data.i:~u64 != 255) { ret 1; }
    val r3: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_eval_int("1_000");
    if (sel r3.err)           { ret 1; }
    if (r3.ok.data.i != 1000) { ret 1; }
    val r4: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_eval_int("0b1_0000_0000");
    if (sel r4.err)               { ret 1; }
    if (r4.ok.data.i:~u64 != 256) { ret 1; }
    val t_eval_int_r: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_eval_int("0b");
    if (sel t_eval_int_r.ok) { ret 1; }
    val t_eval_int_r2: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_eval_int("0o");
    if (sel t_eval_int_r2.ok) { ret 1; }
    val t_eval_int_r3: res[comptime_value.CTValue, comptime_failure.EvalFail] = t_eval_int("0x");
    if (sel t_eval_int_r3.ok) { ret 1; }
    ret 0;
}

test eval_ident__deferred_float_is_not_absent {
    var alloc:  A.Allocator;
    val made_7: err[A.Error] = page.make(?alloc);
    if (sel made_7.err) { ret 1; }
    var c:   comptime_scope.ComptimeCtx = comptime_scope.init(?alloc, resolved.facts_none(), comptime_scope.build_facts(0, 0, intern.STR_NIL, intern.STR_NIL));
    var itn: intern.Interner            = intern.init(?alloc);

    val source:  str = "ALIASED ABSENT";
    var s_alias: lang_source.Span;
    s_alias.offset = 0::usize;
    s_alias.len    = 7::usize;
    var s_absent: lang_source.Span;
    s_absent.offset = 8::usize;
    s_absent.len    = 6::usize;

    val id_r: res[intern.StrId, A.Error] = intern.range_add(?itn, source, s_alias.offset, s_alias.len);
    if (sel id_r.err) {
        comptime_scope.dnit(?c);
        ret 1;
    }
    val aliased: intern.StrId = id_r.ok;

    var ev: Evaluation[comptime_capability.NoCapabilityContext] = Evaluation[comptime_capability.NoCapabilityContext]{c: ?c, cap_ctx: nil,
        caps: comptime_capability.no_capabilities(), a: nil, source: source, interner: ?itn};
    val r0: res[comptime_value.CTValue, comptime_failure.EvalFail] = eval_ident[comptime_capability.NoCapabilityContext](?ev, ast_id.EXPR_NIL, s_alias);
    if (sel r0.ok) {
        comptime_scope.dnit(?c);
        ret 1;
    }
    if (r0.err.message == COMPTIME_ALIAS_FLOAT_MSG) {
        comptime_scope.dnit(?c);
        ret 1;
    }

    val d: err[fail.Fail] = comptime_scope.defer_float_width(?c, aliased);
    if (sel d.err) {
        comptime_scope.dnit(?c);
        ret 1;
    }
    if (!comptime_scope.float_width_deferred(?c, aliased)) {
        comptime_scope.dnit(?c);
        ret 1;
    }

    val r1: res[comptime_value.CTValue, comptime_failure.EvalFail] = eval_ident[comptime_capability.NoCapabilityContext](?ev, ast_id.EXPR_NIL, s_alias);
    if (sel r1.ok) {
        comptime_scope.dnit(?c);
        ret 1;
    }
    if (r1.err.message != COMPTIME_ALIAS_FLOAT_MSG) {
        comptime_scope.dnit(?c);
        ret 1;
    }

    val r2: res[comptime_value.CTValue, comptime_failure.EvalFail] = eval_ident[comptime_capability.NoCapabilityContext](?ev, ast_id.EXPR_NIL, s_absent);
    if (sel r2.ok) {
        comptime_scope.dnit(?c);
        ret 1;
    }
    if (r2.err.message == COMPTIME_ALIAS_FLOAT_MSG) {
        comptime_scope.dnit(?c);
        ret 1;
    }

    val int_value_r: res[comptime_value.CTValue, comptime_failure.EvalFail] = comptime_value.int_value(3);
    if (sel int_value_r.err) { ret 99; }
    val bv: comptime_value.CTValue = int_value_r.ok;
    val b:  err[fail.Fail]         = comptime_scope.bind(?c, aliased, bv);
    if (sel b.err) {
        comptime_scope.dnit(?c);
        ret 1;
    }
    val r3: res[comptime_value.CTValue, comptime_failure.EvalFail] = eval_ident[comptime_capability.NoCapabilityContext](?ev, ast_id.EXPR_NIL, s_alias);
    if (sel r3.err) {
        comptime_scope.dnit(?c);
        ret 1;
    }
    if (r3.ok.data.i != 3) {
        comptime_scope.dnit(?c);
        ret 1;
    }

    comptime_scope.dnit(?c);
    ret 0;
}

test capabilities__callback_allocation_failure_preserves_internal_kind {
    var t:      T.Testing;
    val make_1: err[A.Error] = T.make(?t);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?t); }
    val cr: res[comptime_capability.PhaseCapabilities[A.Allocator], fail.Fail] = comptime_capability.loading_capabilities[A.Allocator](comptime_value.t_capability_refusing, nil);
    if (sel cr.err) { ret 2; }
    val caps: comptime_capability.PhaseCapabilities[A.Allocator] = cr.ok;
    T.fail_at_ordinal(?t, 1);
    val r: res[comptime_value.CTValue, comptime_failure.EvalFail] = eval_module_member[A.Allocator](T.allocator_of(?t), caps, ast_id.EXPR_NIL);
    if (sel r.ok)                                                                 { ret 3; }
    if (r.err.kind != comptime_failure.EVAL_FAIL_INTERNAL)                        { ret 4; }
    if (T.attempt_count(?t) != 1 || T.leaked(?t) || T.double_free_count(?t) != 0) { ret 5; }
    ret 0;
}

#[testing]
pub rec GateChoiceFixture {
    choices: *interpretation.Choice;
    count:   usize;
}

#[testing]
pub fun t_gate_choice_expression(f: *GateChoiceFixture, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime_failure.EvalFail] {
    val read: res[ast_expr.Expr, fail.Fail] = interpretation.get(a, f.choices, f.count, eid);
    if (sel read.err) {
        ret res[ast_expr.Expr, comptime_failure.EvalFail].err{comptime_failure.eval_internal(fail.describe(read.err))};
    }
    ret res[ast_expr.Expr, comptime_failure.EvalFail].ok{read.ok};
}

test catalogs__unknown_tags_are_internal_and_known_unsupported_values_are_rejected {
    var alloc:  A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var caps: comptime_capability.PhaseCapabilities[ast_expr.Expr] = comptime_capability.capabilities_empty[ast_expr.Expr](comptime_capability.PHASE_CAP_NONE);
    caps.expression = comptime_failure.t_catalog_expression;
    var node: ast_expr.Expr;
    node.kind = 200;
    val unknown: res[comptime_value.CTValue, comptime_failure.EvalFail] = evaluate[ast_expr.Expr](nil, ?node, caps, nil, "", ast_id.expr(0), ?itn);
    if (!comptime_value.t_internal_catalog(unknown, "unknown ExprKind tag 200")) { ret 2; }
    node.kind           = ast_expr.EXPR_KIND_BINARY;
    node.data.binary.op = 201;
    if (!comptime_value.t_internal_catalog(evaluate[ast_expr.Expr](nil, ?node, caps, nil, "", ast_id.expr(0), ?itn), "unknown BinOp tag 201")) { ret 3; }
    node.kind          = ast_expr.EXPR_KIND_UNARY;
    node.data.unary.op = 202;
    if (!comptime_value.t_internal_catalog(evaluate[ast_expr.Expr](nil, ?node, caps, nil, "", ast_id.expr(0), ?itn), "unknown UnOp tag 202")) { ret 4; }
    node.kind = ast_expr.EXPR_KIND_VECTOR_LIT;
    val unsupported: res[comptime_value.CTValue, comptime_failure.EvalFail] = evaluate[ast_expr.Expr](nil, ?node, caps, nil, "", ast_id.expr(0), ?itn);
    if (sel unsupported.ok)                                          { ret 5; }
    if (unsupported.err.kind != comptime_failure.EVAL_FAIL_REJECTED) { ret 5; }
    var bad: comptime_value.CTValue;
    bad.kind = 203;
    if (!comptime_value.t_internal_catalog(checked_value(?itn, res[comptime_value.CTValue, comptime_failure.EvalFail].ok{bad}), "unknown CTKind tag 203")) { ret 6; }
    if (!comptime_value.t_internal_catalog(unknown, "unknown ExprKind tag 200"))                                                                           { ret 7; }
    ret 0;
}

#[testing]
fun os_at(i: usize) str {
    if (i >= catalog_os.count()) { ret nil; }
    ret catalog_os.name_at(i);
}

#[testing]
fun arch_at(i: usize) str {
    if (i >= catalog_arch.count()) { ret nil; }
    ret catalog_arch.name_at(i);
}

#[testing]
fun abi_at(i: usize) str {
    if (i >= catalog_abi.count()) { ret nil; }
    ret catalog_abi.name_at(i);
}

# what a page documents of the `$` paths: one bit per path row by position, and
# one per tag of each catalog by its position there
#[testing]
rec Documented {
    rows: u64;
    os:   u64;
    arch: u64;
    abi:  u64;
    mode: u64;
}

# the bit of the tag `path[tag]` among the `count` names `names` gives; 0 when it is none of them
#[testing]
fun tag_bit(path: str, tag: lang_source.Span, names: fun(usize) str, count: usize) u64 {
    var i: usize = 0;
    for (i < count) {
        val name: str = names(i);
        if (name != nil && str_region_equals(path, tag.offset, tag.len, name)) { ret 1::u64 << i::u64; }
        i = i + 1;
    }
    ret 0;
}

# record the path `path`, written without its `$`, as documented in `d`: the row
# it reads and, for a tag, the tag. a path ending `.*` names a family and records
# nothing. false, reported under `what`, when it reads no row or names no tag
#[testing]
fun path_record(what: str, path: str, call: bool, d: *Documented) bool {
    val n: usize = str_len(path);
    if (n >= 2 && path[n - 1] == '*' && path[n - 2] == '.') { ret true; }
    var stack: [8]lang_source.Span;
    val depth: u32                = comptime_path.t_split(path, ?stack[0]);
    val r:     *comptime_path.Row = comptime_path.lookup(path, ?stack[0], depth, call);
    if (r == nil) {
        print.eprintlnf("{}: `${}` is no path the compiler answers", what, path);
        ret false;
    }
    var i: usize = 0;
    for (comptime_path.at(i) != nil) {
        if (comptime_path.at(i) == r) { d.rows = d.rows | (1::u64 << i::u64); }
        i = i + 1;
    }
    val tag: lang_source.Span = stack[0];
    var bit: u64              = 1;
    if (r.read == comptime_path.READ_OS_TAG) {
        bit  = tag_bit(path, tag, os_at, catalog_os.count());
        d.os = d.os | bit;
    }
    or (r.read == comptime_path.READ_ARCH_TAG) {
        bit    = tag_bit(path, tag, arch_at, catalog_arch.count());
        d.arch = d.arch | bit;
    }
    or (r.read == comptime_path.READ_ABI_TAG) {
        bit   = tag_bit(path, tag, abi_at, catalog_abi.count());
        d.abi = d.abi | bit;
    }
    or (r.read == comptime_path.READ_MODE_TAG) {
        bit    = tag_bit(path, tag, comptime_path.mode_at, comptime_path.MODE_COUNT);
        d.mode = d.mode | bit;
    }
    if (bit == 0) {
        print.eprintlnf("{}: `${}` names a tag its catalog does not hold", what, path);
        ret false;
    }
    ret true;
}

# record the path written at `at` of `text`, just past its `$`, once per
# alternative of a `{a,b}` group; false when one of them is no path
#[testing]
fun written_record(what: str, text: str, at: usize, d: *Documented) bool {
    var e:     usize = at;
    var open:  usize = 0;
    var close: usize = 0;
    for ((text[e] >= 'a' && text[e] <= 'z') || (text[e] >= '0' && text[e] <= '9') || text[e] == '_' || text[e] == '.'
        || text[e] == '<' || text[e] == '>' || text[e] == '*' || text[e] == '{' || text[e] == '}' || text[e] == ',') {
        if (text[e] == '{') { open = e; }
        if (text[e] == '}') { close = e; }
        e = e + 1;
    }
    val call: bool = text[e] == '(';
    if (close <= open) {
        open  = e;
        close = e;
    }
    var alt: usize = open + 1;
    for (true) {
        var alt_end: usize = alt;
        for (alt_end < close && text[alt_end] != ',') { alt_end = alt_end + 1; }
        var buf: [128]u8;
        var o:   usize = 0;
        var k:   usize = at;
        for (k < open && o < 127) {
            buf[o] = text[k]::u8;
            o      = o + 1;
            k      = k + 1;
        }
        k = alt;
        for (k < alt_end && o < 127) {
            buf[o] = text[k]::u8;
            o      = o + 1;
            k      = k + 1;
        }
        k = close + 1;
        for (k < e && o < 127) {
            buf[o] = text[k]::u8;
            o      = o + 1;
            k      = k + 1;
        }
        buf[o] = 0;
        if (!path_record(what, (?buf[0])::str, call, d)) { ret false; }
        if (alt_end >= close)                            { brk; }
        alt = alt_end + 1;
    }
    ret true;
}

# whether `d` documents every tag of a catalog of `count` names, reporting the first it misses
#[testing]
fun tags_whole(what: str, seen: u64, names: fun(usize) str, count: usize) bool {
    var i: usize = 0;
    for (i < count) {
        if ((seen & (1::u64 << i::u64)) == 0) {
            print.eprintlnf("{}: the tag `{}` is in its catalog and not documented", what, names(i));
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

# comptime-mach.md documents every `$mach.*` path the compiler answers and every
# tag of the target catalogs, comptime.md every `$project.*` and `$bin.*` path,
# and neither documents a path or a tag the compiler does not answer
test reference__comptime_paths_are_the_registry {
    # one bit per path row
    if (comptime_path.at(63) != nil) { ret 7; }
    var alloc: A.Allocator;
    page.make(?alloc);
    val machs: opt[str] = reference.page_or_report(?alloc, "doc/language/comptime-mach.md");
    if (sel machs.none) { ret 1; }
    val roots: opt[str] = reference.page_or_report(?alloc, "doc/language/comptime.md");
    if (sel roots.none) { ret 1; }

    # comptime-mach.md lists its paths one per line, each line beginning with it
    var dm: Documented = Documented{rows: 0, os: 0, arch: 0, abi: 0, mode: 0};
    val n:  usize      = str_len(machs.some);
    var at: usize      = 0;
    for (at < n) {
        if (str_region_equals(machs.some, at, 6, "$mach.") && !written_record("comptime-mach.md", machs.some, at + 1, ?dm)) { ret 2; }
        at = reference.line_next(machs.some, at);
    }

    # comptime.md lists the roots in the first cell of its table
    var dc:  Documented            = Documented{rows: 0, os: 0, arch: 0, abi: 0, mode: 0};
    val sec: opt[lang_source.Span] = reference.section(roots.some, "## Compiler-owned roots");
    if (sel sec.none) { ret 3; }
    val rows: opt[lang_source.Span] = reference.table(roots.some, sec.some.offset, "| Root |");
    if (sel rows.none) { ret 3; }
    var r:    usize = rows.some.offset;
    var line: lang_source.Span;
    for (reference.row_next(roots.some, ?r, rows.some.offset + rows.some.len, ?line)) {
        val first: opt[lang_source.Span] = reference.cell(roots.some, line, 0);
        if (sel first.none) { ret 3; }
        var c:    usize = first.some.offset;
        var path: lang_source.Span;
        for (reference.code_next(roots.some, ?c, first.some.offset + first.some.len, ?path)) {
            if (roots.some[path.offset] == '$' && !written_record("comptime.md", roots.some, path.offset + 1, ?dc)) { ret 4; }
        }
    }

    var i: usize = 0;
    for (comptime_path.at(i) != nil) {
        val row: *comptime_path.Row = comptime_path.at(i);
        val bit: u64                = 1::u64 << i::u64;
        i = i + 1;
        if (row.read == comptime_path.READ_REFUSED || row.read == comptime_path.READ_RESERVED) { cnt; }
        if (row.read == comptime_path.READ_OS_TAG || row.read == comptime_path.READ_ARCH_TAG
            || row.read == comptime_path.READ_ABI_TAG || row.read == comptime_path.READ_MODE_TAG) { cnt; }
        var seen:      u64 = dc.rows;
        var page_name: str = "comptime.md";
        if (str_region_equals(row.path, 0, 5, "mach.")) {
            seen      = dm.rows;
            page_name = "comptime-mach.md";
        }
        if ((seen & bit) == 0) {
            print.eprintlnf("{}: `${}` is a path the compiler answers and is not documented", page_name, row.path);
            ret 5;
        }
    }
    if (!tags_whole("comptime-mach.md $mach.os", dm.os, os_at, catalog_os.count()))                           { ret 6; }
    if (!tags_whole("comptime-mach.md $mach.arch", dm.arch, arch_at, catalog_arch.count()))                   { ret 6; }
    if (!tags_whole("comptime-mach.md $mach.abi", dm.abi, abi_at, catalog_abi.count()))                       { ret 6; }
    if (!tags_whole("comptime-mach.md $mach.mode", dm.mode, comptime_path.mode_at, comptime_path.MODE_COUNT)) { ret 6; }
    ret 0;
}
