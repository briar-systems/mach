    "float operands have different declared widths; mach has no implicit widening";

pub val TYPE_QUERY_IS_RECORD:  u8 = 0;
pub val TYPE_QUERY_IS_UNION:   u8 = 1;
pub val TYPE_QUERY_IS_POINTER: u8 = 2;
pub val TYPE_QUERY_NAME:       u8 = 3;
pub val TYPE_QUERY_IS_SECRET:  u8 = 4;
pub val TYPE_QUERY_IS_TAG:     u8 = 5;

pub def PhaseCapabilityKind: u8;

pub val PHASE_CAP_NONE:           PhaseCapabilityKind = 0;
pub val PHASE_CAP_LOADING:        PhaseCapabilityKind = 1;
pub val PHASE_CAP_RESOLUTION:     PhaseCapabilityKind = 2;
pub val PHASE_CAP_SEMANTIC_NAMES: PhaseCapabilityKind = 3;
pub val PHASE_CAP_SEMANTIC_TYPES: PhaseCapabilityKind = 4;
pub val PHASE_CAP_LOWERING:       PhaseCapabilityKind = 5;

pub rec NoCapabilityContext {
}

pub rec PhaseCapabilities[T] {
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail];
    kind:      PhaseCapabilityKind;
    member:    fun(*T, id.ExprId) res[opt[CTValue], EvalFail];
    type_:     fun(*T, id.ExprId) res[opt[u32], EvalFail];
    field:     fun(*T, u32, u32, u8) res[opt[CTValue], EvalFail];
    query:     fun(*T, u32, u8) res[opt[CTValue], EvalFail];
    layout:    fun(*T, u32) res[opt[CTValue], EvalFail];
    ident:     fun(*T, id.ExprId) bool;
    cast:      fun(*T, id.ExprId, CTValue) res[CTValue, EvalFail];
    scalar:    fun(*T, id.ExprId, CTValue) res[CTValue, EvalFail];
}

fun capabilities_empty[T](kind: PhaseCapabilityKind) PhaseCapabilities[T] {
    var caps: PhaseCapabilities[T];
    caps.kind   = kind;
    caps.expression = parsed_expression[T];
    caps.member = nil;
    caps.type_  = nil;
    caps.field  = nil;
    caps.query  = nil;
    caps.layout = nil;
    caps.ident  = nil;
    caps.cast   = nil;
    caps.scalar = nil;
    ret caps;
}

fun parsed_expression[T](ctx: *T, a: *ast.Ast, eid: id.ExprId) res[expr.Expr, EvalFail] {
    if (a == nil) { ret res[expr.Expr, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, "comptime expression has no parsed owner")}; }
    val found: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (sel found.none) { ret res[expr.Expr, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, "comptime expression identity is out of range")}; }
    ret res[expr.Expr, EvalFail].ok{@found.some};
}

fun read_expression[T](ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, eid: id.ExprId) res[expr.Expr, EvalFail] {
    if (!capabilities_complete[T](caps) || (ctx == nil && caps.kind != PHASE_CAP_NONE)) {
        ret res[expr.Expr, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, "comptime expression requires its active phase capability")};
    }
    ret caps.expression(ctx, a, eid);
}

pub fun no_capabilities() PhaseCapabilities[NoCapabilityContext] {
    ret capabilities_empty[NoCapabilityContext](PHASE_CAP_NONE);
}

fun capabilities_complete[T](caps: PhaseCapabilities[T]) bool {
    if (caps.expression == nil) { ret false; }
    val no_types: bool = caps.type_ == nil && caps.field == nil && caps.query == nil && caps.layout == nil && caps.cast == nil && caps.scalar == nil;
    if (caps.kind == PHASE_CAP_NONE) {
        ret caps.member == nil && no_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_LOADING) {
        ret caps.member != nil && no_types && caps.ident == nil;
    }
    if (caps.kind == PHASE_CAP_RESOLUTION) {
        ret caps.member == nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_NAMES) {
        ret caps.member != nil && no_types && caps.ident != nil;
    }
    if (caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING) {
        ret caps.member != nil && caps.type_ != nil && caps.field != nil
            && caps.query != nil && caps.layout != nil && caps.ident != nil && caps.cast != nil && caps.scalar != nil;
    }
    ret false;
}

fun capabilities_publish[T](caps: PhaseCapabilities[T]) res[PhaseCapabilities[T], fail.Fail] {
    if (!capabilities_complete[T](caps)) {
        ret res[PhaseCapabilities[T], fail.Fail].err{fail.message("comptime: incomplete or contradictory phase capabilities")};
    }
    ret res[PhaseCapabilities[T], fail.Fail].ok{caps};
}

pub fun loading_capabilities[T](member: fun(*T, id.ExprId) res[opt[CTValue], EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_LOADING);
    caps.member = member;
    ret capabilities_publish[T](caps);
}

pub fun resolution_capabilities[T](ident: fun(*T, id.ExprId) bool,
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail]) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_RESOLUTION);
    caps.ident = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

pub fun semantic_name_capabilities[T](
    member: fun(*T, id.ExprId) res[opt[CTValue], EvalFail],
    ident:  fun(*T, id.ExprId) bool,
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail]
) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_SEMANTIC_NAMES);
    caps.member = member;
    caps.ident  = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

pub fun semantic_type_capabilities[T](
    member: fun(*T, id.ExprId) res[opt[CTValue], EvalFail],
    type_:  fun(*T, id.ExprId) res[opt[u32], EvalFail],
    field:  fun(*T, u32, u32, u8) res[opt[CTValue], EvalFail],
    query:  fun(*T, u32, u8) res[opt[CTValue], EvalFail],
    layout: fun(*T, u32) res[opt[CTValue], EvalFail],
    cast:   fun(*T, id.ExprId, CTValue) res[CTValue, EvalFail],
    scalar: fun(*T, id.ExprId, CTValue) res[CTValue, EvalFail],
    ident:  fun(*T, id.ExprId) bool,
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail]
) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_SEMANTIC_TYPES);
    caps.member = member;
    caps.type_  = type_;
    caps.field  = field;
    caps.query  = query;
    caps.layout = layout;
    caps.cast = cast;
    caps.scalar = scalar;
    caps.ident  = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

pub fun lowering_capabilities[T](
    member: fun(*T, id.ExprId) res[opt[CTValue], EvalFail],
    type_:  fun(*T, id.ExprId) res[opt[u32], EvalFail],
    field:  fun(*T, u32, u32, u8) res[opt[CTValue], EvalFail],
    query:  fun(*T, u32, u8) res[opt[CTValue], EvalFail],
    layout: fun(*T, u32) res[opt[CTValue], EvalFail],
    cast:   fun(*T, id.ExprId, CTValue) res[CTValue, EvalFail],
    scalar: fun(*T, id.ExprId, CTValue) res[CTValue, EvalFail],
    ident:  fun(*T, id.ExprId) bool,
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail]
) res[PhaseCapabilities[T], fail.Fail] {
    var caps: PhaseCapabilities[T] = capabilities_empty[T](PHASE_CAP_LOWERING);
    caps.member = member;
    caps.type_  = type_;
    caps.field  = field;
    caps.query  = query;
    caps.layout = layout;
    caps.cast = cast;
    caps.scalar = scalar;
    caps.ident  = ident;
    caps.expression = expression;
    ret capabilities_publish[T](caps);
}

fun capabilities_have_member[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_LOADING
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

fun capabilities_have_ident[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_RESOLUTION
        || caps.kind == PHASE_CAP_SEMANTIC_NAMES
        || caps.kind == PHASE_CAP_SEMANTIC_TYPES
        || caps.kind == PHASE_CAP_LOWERING;
}

fun capabilities_have_types[T](ctx: *T, caps: PhaseCapabilities[T]) bool {
    if (ctx == nil || !capabilities_complete[T](caps)) { ret false; }
    ret caps.kind == PHASE_CAP_SEMANTIC_TYPES || caps.kind == PHASE_CAP_LOWERING;
}

