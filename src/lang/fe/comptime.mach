    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.gate_depends_on:unlisted_expression_kind_fails_closed" {
    var alloc: A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var a: ast.Ast = ast.init(?alloc, 0::source.FileId);

    var lit: expr.Expr;
    lit.kind = expr.EXPR_KIND_LIT_INT;
    lit.data.lit_int.value  = 1;
    lit.data.lit_int.suffix = expr.LIT_SUFFIX_NONE;
    val lit_r: res[id.ExprId, fail.Fail] = ast.add_expr(?a, lit);
    if (sel lit_r.err) { ast.dnit(?a); ret 1; }

    var ident: expr.Expr;
    ident.kind = expr.EXPR_KIND_IDENT;
    val ident_r: res[id.ExprId, fail.Fail] = ast.add_expr(?a, ident);
    if (sel ident_r.err) { ast.dnit(?a); ret 1; }

    var unlisted: expr.Expr;
    unlisted.kind = 5::expr.ExprKind;
    val un_r: res[id.ExprId, fail.Fail] = ast.add_expr(?a, unlisted);
    if (sel un_r.err) { ast.dnit(?a); ret 1; }

    var nested: expr.Expr;
    nested.kind = expr.EXPR_KIND_UNARY;
    nested.data.unary.op      = expr.UN_NOT;
    nested.data.unary.operand = un_r.ok;
    val nest_r: res[id.ExprId, fail.Fail] = ast.add_expr(?a, nested);
    if (sel nest_r.err) { ast.dnit(?a); ret 1; }

    val probes: GateProbes[NoCapabilityContext] = gate_probes[NoCapabilityContext](nil, nil, nil, nil, parsed_expression[NoCapabilityContext]);
    var bad: i32 = 0;

    val listed: res[bool, fail.Fail] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, lit_r.ok);
    if (sel listed.err) { bad = 1; }
    or (sel listed.ok) { if (listed.ok) { bad = 1; } }

    val closed: res[bool, fail.Fail] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, nest_r.ok);
    if (sel closed.ok) { bad = 2; }
    or (sel closed.err) { if (!str_equals(fail.describe(closed.err), GATE_PROBE_UNLISTED_KIND_MSG)) { bad = 3; } }

    val no_obs: res[bool, fail.Fail] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_COMPTIME_PARAM, ident_r.ok);
    if (sel no_obs.ok) { bad = 4; }
    or (sel no_obs.err) { if (!str_equals(fail.describe(no_obs.err), GATE_PROBE_NO_OBSERVER_MSG)) { bad = 5; } }

    val out_of_range: res[bool, fail.Fail] = gate_depends_on[NoCapabilityContext](?a, "", nil, probes,
        GATE_PROBE_LAYOUT_INTRINSIC, 99::id.ExprId);
    if (sel out_of_range.ok) { bad = 6; }

    ast.dnit(?a);
    ret bad;
}

fun t_capability_refusing(a: *A.Allocator, _eid: id.ExprId) res[opt[CTValue], EvalFail] {
    val r: res[*u8, A.Error] = A.allocate[u8](a, 1);
    if (sel r.err) {
        ret res[opt[CTValue], EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, alloc.text(r.err))};
    }
    A.deallocate[u8](a, r.ok, 1);
    ret res[opt[CTValue], EvalFail].ok{opt[CTValue].some{ct_u8(1)}};
}

test "mach.lang.fe.comptime.capabilities:callback_allocation_failure_preserves_internal_kind" {
    var t: T.Testing;
    val make_1: err[A.Error] = T.make(?t);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?t); }
    val cr: res[PhaseCapabilities[A.Allocator], fail.Fail] = loading_capabilities[A.Allocator](t_capability_refusing);
    if (sel cr.err) { ret 2; }
    val caps: PhaseCapabilities[A.Allocator] = cr.ok;
    T.fail_at_ordinal(?t, 1);
    val r: res[CTValue, EvalFail] = eval_module_member[A.Allocator](T.allocator_of(?t), caps, id.EXPR_NIL);
    if (sel r.ok) { ret 3; }
    if (r.err.kind != EVAL_FAIL_INTERNAL) { ret 4; }
    if (T.attempt_count(?t) != 1 || T.leaked(?t) || T.double_free_count(?t) != 0) { ret 5; }
    ret 0;
}

rec GateChoiceFixture {
    choices: *interpretation.Choice;
    count: usize;
}

fun t_gate_choice_expression(f: *GateChoiceFixture, a: *ast.Ast, eid: id.ExprId) res[expr.Expr, EvalFail] {
    val read: res[expr.Expr, fail.Fail] = interpretation.get(a, f.choices, f.count, eid);
    if (sel read.err) {
        ret res[expr.Expr, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, fail.describe(read.err))};
    }
    ret res[expr.Expr, EvalFail].ok{read.ok};
}

fun t_gate_choice_action(f: *GateChoiceFixture, eid: id.ExprId, e: *expr.Expr) GateNodeVerdict {
    if (eid == 1) { ret GATE_NODE_YES; }
    ret GATE_NODE_NO;
}

test "mach.lang.fe.comptime.gate_depends_on:resolved_brackets_visit_only_the_selected_expression" {
    var nodes: [4]expr.Expr;
    nodes[0].kind = expr.EXPR_KIND_IDENT;
    nodes[1].kind = expr.EXPR_KIND_IDENT;
    nodes[2].kind = expr.EXPR_KIND_INDEX;
    nodes[2].data.index.object = 0;
    nodes[2].data.index.index = 1;
    nodes[3].kind = expr.EXPR_KIND_CALL;
    nodes[3].data.call.callee = 0;
    nodes[3].data.call.index_callee = 2;
    nodes[3].data.call.args_start = 0;
    nodes[3].data.call.args_len = 0;
    nodes[3].data.call.type_args_start = 0;
    nodes[3].data.call.type_args_len = 1;
    var a: ast.Ast;
    a.exprs = ?nodes[0];
    a.expr_len = 4;
    var choices: [4]interpretation.Choice;
    choices[0] = interpretation.PARSED;
    choices[1] = interpretation.PARSED;
    choices[2] = interpretation.PARSED;
    choices[3] = interpretation.GENERIC;
    var f: GateChoiceFixture;
    f.choices = ?choices[0];
    f.count = 4;
    val generic: res[bool, fail.Fail] = gate_walk[GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, t_gate_choice_expression, 3);
    if (sel generic.err) { ret 1; }
    if (generic.ok) { ret 1; }
    choices[3] = interpretation.INDEX_CALL;
    val indexed: res[bool, fail.Fail] = gate_walk[GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, t_gate_choice_expression, 3);
    if (sel indexed.err) { ret 2; }
    if (!indexed.ok) { ret 2; }
    if (nodes[3].data.call.callee != 0 || nodes[3].data.call.index_callee != 2 || nodes[3].data.call.type_args_len != 1) { ret 3; }
    val missing: res[bool, fail.Fail] = gate_walk[GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, nil, 3);
    if (sel missing.ok) { ret 4; }
    f.count = 3;
    val wrong_owner: res[bool, fail.Fail] = gate_walk[GateChoiceFixture](?a, "", ?f,
        t_gate_choice_action, t_gate_choice_expression, 3);
    if (sel wrong_owner.ok) { ret 5; }
    ret 0;
}

test "mach.lang.fe.comptime.gate_unresolved_dependency:allocation_refusal_is_not_an_absent_name" {
    var tracked: T.Testing;
    val make_1: err[A.Error] = T.make(?tracked);
    if (sel make_1.err) { ret 1; }
    fin { T.dnit(?tracked); }
    val alloc: *A.Allocator = T.allocator_of(?tracked);
    var itn: intern.Interner = intern.init(alloc);
    var c: ComptimeCtx = init(alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    var node: expr.Expr;
    node.kind = expr.EXPR_KIND_IDENT;
    node.span.offset = 0;
    node.span.len = 7;
    var a: ast.Ast;
    a.exprs = ?node;
    a.expr_len = 1;
    val caps: PhaseCapabilities[NoCapabilityContext] = no_capabilities();
    T.fail_at_ordinal(?tracked, 1);
    val refused: res[intern.StrId, fail.Fail] = gate_unresolved_dependency[NoCapabilityContext](
        ?c, nil, caps, ?a, "missing", ?itn, 0);
    var bad: i32 = 0;
    if (sel refused.ok) { bad = 2; }
    or (sel refused.err) { if (!str_equals(fail.describe(refused.err), "out of memory")) { bad = 3; } }
    if (T.attempt_count(?tracked) != 1 || itn.len != 0) { bad = 4; }
    T.fail_at_ordinal(?tracked, 0);
    val found: res[intern.StrId, fail.Fail] = gate_unresolved_dependency[NoCapabilityContext](
        ?c, nil, caps, ?a, "missing", ?itn, 0);
    if (sel found.err) { bad = 5; }
    or (sel found.ok) {
        val name: opt[str] = intern.lookup(?itn, found.ok);
        if (sel name.some) { if (!str_equals(name.some, "missing")) { bad = 6; } }
        if (sel name.none) { bad = 6; }
    }
    dnit(?c);
    intern.dnit(?itn);
    if (T.leaked(?tracked) || T.double_free_count(?tracked) != 0) { bad = 7; }
    ret bad;
}

fun t_catalog_expression(node: *expr.Expr, a: *ast.Ast, eid: id.ExprId) res[expr.Expr, EvalFail] {
    ret res[expr.Expr, EvalFail].ok{@node};
}

fun t_internal_catalog(result: res[CTValue, EvalFail], message: str) bool {
    if (sel result.ok) { ret false; }
    val failure: EvalFail = result.err;
    ret failure.kind == EVAL_FAIL_INTERNAL && str_equals(failure.message, message);
}

test "mach.lang.fe.comptime.catalogs:unknown_tags_are_internal_and_known_unsupported_values_are_rejected" {
    var alloc: A.Allocator;
    val make_1: err[A.Error] = page.make(?alloc);
    if (sel make_1.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var caps: PhaseCapabilities[expr.Expr] = capabilities_empty[expr.Expr](PHASE_CAP_NONE);
    caps.expression = t_catalog_expression;
    var node: expr.Expr;
    node.kind = 200;
    val unknown: res[CTValue, EvalFail] = evaluate[expr.Expr](nil, ?node, caps, nil, "", 0, ?itn);
    if (!t_internal_catalog(unknown, "unknown ExprKind tag 200")) { ret 2; }
    node.kind = expr.EXPR_KIND_BINARY;
    node.data.binary.op = 201;
    if (!t_internal_catalog(evaluate[expr.Expr](nil, ?node, caps, nil, "", 0, ?itn), "unknown BinOp tag 201")) { ret 3; }
    node.kind = expr.EXPR_KIND_UNARY;
    node.data.unary.op = 202;
    if (!t_internal_catalog(evaluate[expr.Expr](nil, ?node, caps, nil, "", 0, ?itn), "unknown UnOp tag 202")) { ret 4; }
    node.kind = expr.EXPR_KIND_VECTOR_LIT;
    val unsupported: res[CTValue, EvalFail] = evaluate[expr.Expr](nil, ?node, caps, nil, "", 0, ?itn);
    if (sel unsupported.ok) { ret 5; }
    if (unsupported.err.kind != EVAL_FAIL_REJECTED) { ret 5; }
    var bad: CTValue;
    bad.kind = 203;
    if (!t_internal_catalog(checked_value(?itn, res[CTValue, EvalFail].ok{bad}), "unknown CTKind tag 203")) { ret 6; }
    if (!t_internal_catalog(unknown, "unknown ExprKind tag 200")) { ret 7; }
    ret 0;
}
