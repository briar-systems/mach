fun t_char(s: str) res[CTValue, EvalFail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret eval_lit_char(s, span);
}

fun t_float(s: str) res[CTValue, EvalFail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret eval_lit_float(s, span);
}

fun t_fbits(s: str) u64 {
    val r: res[CTValue, EvalFail] = t_float(s);
    if (sel r.err) { ret 0xFFFFFFFFFFFFFFFF; }
    ret float.f64_bits(r.ok.data.f);
}

test "mach.lang.fe.comptime.eval_lit_char:escapes_and_malformed" {
    val t_char_r: res[CTValue, EvalFail] = t_char("'\\n'");
    if (sel t_char_r.err)                 { ret 1; }
    val t_char_r2: res[CTValue, EvalFail] = t_char("'\\n'");
    if (sel t_char_r2.err) { ret 99; }
    if (t_char_r2.ok.data.i != 10) { ret 1; }
    val t_char_r3: res[CTValue, EvalFail] = t_char("'\\t'");
    if (sel t_char_r3.err)                { ret 1; }
    val t_char_r4: res[CTValue, EvalFail] = t_char("'\\t'");
    if (sel t_char_r4.err) { ret 99; }
    if (t_char_r4.ok.data.i != 9) { ret 1; }
    val t_char_r5: res[CTValue, EvalFail] = t_char("'\\\\'");
    if (sel t_char_r5.err)                 { ret 1; }
    val t_char_r6: res[CTValue, EvalFail] = t_char("'\\\\'");
    if (sel t_char_r6.err) { ret 99; }
    if (t_char_r6.ok.data.i != 92) { ret 1; }
    val t_char_r7: res[CTValue, EvalFail] = t_char("'\\0'");
    if (sel t_char_r7.err)                { ret 1; }
    val t_char_r8: res[CTValue, EvalFail] = t_char("'\\0'");
    if (sel t_char_r8.err) { ret 99; }
    if (t_char_r8.ok.data.i != 0) { ret 1; }
    val t_char_r9: res[CTValue, EvalFail] = t_char("'\\''");
    if (sel t_char_r9.err  )               { ret 1; }
    val t_char_r10: res[CTValue, EvalFail] = t_char("'\\''");
    if (sel t_char_r10.err) { ret 99; }
    if (t_char_r10.ok.data.i != 39) { ret 1; }
    val t_char_r11: res[CTValue, EvalFail] = t_char("'ab'");
    if (sel t_char_r11.ok)  { ret 1; }
    val t_char_r12: res[CTValue, EvalFail] = t_char("''");
    if (sel t_char_r12.ok)    { ret 1; }
    val t_char_r13: res[CTValue, EvalFail] = t_char("'a");
    if (sel t_char_r13.ok)    { ret 1; }
    ret 0;
}

fun t_scan_float(s: str) res[LitFloat, fail.Fail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret scan_lit_float(s, span);
}

test "mach.lang.fe.comptime.scan_lit_float:suffix_names_the_float_width" {
    val t_scan_float_1: res[LitFloat, fail.Fail] = t_scan_float("1.5f32");
    if (!sel t_scan_float_1.ok) { ret 1; }
    val a: LitFloat = t_scan_float_1.ok;
    if (a.suffix != type.TYPE_F32) { ret 1; }
    val t_scan_float_2: res[LitFloat, fail.Fail] = t_scan_float("1.5f64");
    if (!sel t_scan_float_2.ok) { ret 1; }
    val b: LitFloat = t_scan_float_2.ok;
    if (b.suffix != type.TYPE_F64) { ret 2; }
    val t_scan_float_3: res[LitFloat, fail.Fail] = t_scan_float("1.5");
    if (!sel t_scan_float_3.ok) { ret 1; }
    val c: LitFloat = t_scan_float_3.ok;
    if (c.suffix != expr.LIT_SUFFIX_NONE) { ret 3; }

    val t_scan_float_4: res[LitFloat, fail.Fail] = t_scan_float("1.5f16");
    if (sel t_scan_float_4.ok) { ret 4; }
    val t_scan_float_5: res[LitFloat, fail.Fail] = t_scan_float("1.5f");
    if (sel t_scan_float_5.ok)   { ret 5; }
    val t_scan_float_6: res[LitFloat, fail.Fail] = t_scan_float("1.5u32");
    if (sel t_scan_float_6.ok) { ret 6; }
    ret 0;
}

test "mach.lang.fe.comptime.scan_lit_float:f32_suffix_rounds_at_binary32" {
    val t_scan_float_1: res[LitFloat, fail.Fail] = t_scan_float("0.1");
    if (!sel t_scan_float_1.ok) { ret 1; }
    val wide:   f64 = t_scan_float_1.ok.value;
    val t_scan_float_2: res[LitFloat, fail.Fail] = t_scan_float("0.1f32");
    if (!sel t_scan_float_2.ok) { ret 1; }
    val narrow: f64 = t_scan_float_2.ok.value;
    if (float.f64_bits(wide) == float.f64_bits(narrow))                        { ret 1; }
    if (float.f64_bits(narrow) != float.f64_bits(float.round_at(wide, float.FLOAT_W_32))) { ret 2; }

    val t_float_r: res[CTValue, EvalFail] = t_float("0.1f32");
    if (sel t_float_r.err) { ret 99; }
    val ev: CTValue = t_float_r.ok;
    if (ev.float_width != float.FLOAT_W_32)               { ret 3; }
    if (float.f64_bits(ev.data.f) != float.f64_bits(narrow)) { ret 4; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:exponent_forms" {
    val r1: res[CTValue, EvalFail] = t_float("1.5e2");
    if (sel r1.err)                    { ret 1; }
    if (r1.ok.data.f != 150.0) { ret 1; }
    val r2: res[CTValue, EvalFail] = t_float("1.0E-1");
    if (sel r2.err) { ret 1; }
    var d2: f64 = r2.ok.data.f - 0.1;
    if (d2 < 0.0)    { d2 = 0.0 - d2; }
    if (d2 > 1.0e-9) { ret 1; }
    val r3: res[CTValue, EvalFail] = t_float("3.14");
    if (sel r3.err) { ret 1; }
    var d3: f64 = r3.ok.data.f - 3.14;
    if (d3 < 0.0)    { d3 = 0.0 - d3; }
    if (d3 > 1.0e-9) { ret 1; }
    val r4: res[CTValue, EvalFail] = t_float("1.");
    if (sel r4.err)                  { ret 1; }
    if (r4.ok.data.f != 1.0) { ret 1; }
    val t_float_r: res[CTValue, EvalFail] = t_float("");
    if (sel t_float_r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:extreme_exponent_saturates" {
    val rp: res[CTValue, EvalFail] = t_float("1.0e2000000000");
    if (sel rp.err)                        { ret 1; }
    if (!(rp.ok.data.f > 1.0e308)) { ret 1; }
    val rn: res[CTValue, EvalFail] = t_float("1.0e-2000000000");
    if (sel rn.err)                  { ret 1; }
    if (rn.ok.data.f != 0.0) { ret 1; }
    val rz: res[CTValue, EvalFail] = t_float("0.0e2000000000");
    if (sel rz.err)                  { ret 1; }
    if (rz.ok.data.f != 0.0) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:correctly_rounded" {
    if (t_fbits("1.0e100")                  != 0x54B249AD2594C37D) { ret 1; }

    if (t_fbits("1.0e308")                  != 0x7FE1CCF385EBC8A0) { ret 2; }
    if (t_fbits("1.0e-308")                 != 0x000730D67819E8D2) { ret 3; }
    if (t_fbits("1.0e-300")                 != 0x01A56E1FC2F8F359) { ret 4; }
    if (t_fbits("1.0e23")                   != 0x44B52D02C7E14AF6) { ret 5; }
    if (t_fbits("9.999999999999999e307")    != 0x7FE1CCF385EBC89F) { ret 6; }
    if (t_fbits("8.98846567431158e307")     != 0x7FE0000000000000) { ret 7; }

    if (t_fbits("1.7976931348623157e308")   != 0x7FEFFFFFFFFFFFFF) { ret 8; }
    if (t_fbits("2.2250738585072014e-308")  != 0x0010000000000000) { ret 9; }
    if (t_fbits("2.2250738585072009e-308")  != 0x000FFFFFFFFFFFFF) { ret 10; }
    if (t_fbits("5.0e-324")                 != 0x0000000000000001) { ret 11; }
    if (t_fbits("1.0e-323")                 != 0x0000000000000002) { ret 12; }
    if (t_fbits("7.5e-324")                 != 0x0000000000000002) { ret 13; }

    if (t_fbits("1.00000000000000011102230246251565404236316680908203125")
                                            != 0x3FF0000000000000) { ret 14; }
    if (t_fbits("1.00000000000000033306690738754696212708950042724609375")
                                            != 0x3FF0000000000002) { ret 15; }
    if (t_fbits("1.000000000000000111022302462515654042363166809082031250000001")
                                            != 0x3FF0000000000001) { ret 16; }

    if (t_fbits("1.0e320")                  != 0x7FF0000000000000) { ret 17; }
    if (t_fbits("0.1")                      != 0x3FB999999999999A) { ret 18; }
    if (t_fbits("3.141592653589793")        != 0x400921FB54442D18) { ret 19; }
    if (t_fbits("1.5e2")                    != 0x4062C00000000000) { ret 20; }
    if (t_fbits("123456789.0")              != 0x419D6F3454000000) { ret 21; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_float:sticky_bit_tie" {
    if (t_fbits("1.")
                                            != 0x3FF0000000000001) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.float_trunc_rem:exact_at_the_real_2_53_boundary" {
    if (float.f64_bits(float_trunc_rem(9007199254740984.0, 7.0, float.FLOAT_W_64)) != 0x4008000000000000) { ret 1; }
    if (float.f64_bits(float_trunc_rem(9007199254740996.0, 7.0, float.FLOAT_W_64)) != 0x3FF0000000000000) { ret 2; }
    if (float.f64_bits(float_trunc_rem(1.0e300, 3.0, float.FLOAT_W_64)) != 0x0000000000000000) { ret 3; }
    if (float.f64_bits(float_trunc_rem(1.0e300, 7.0, float.FLOAT_W_64)) != 0x3FF0000000000000) { ret 4; }
    if (float.f64_bits(float_trunc_rem(0.0 - 1.0e300, 7.0, float.FLOAT_W_64)) != 0xBFF0000000000000) { ret 5; }
    if (float_trunc_rem(7.5, 2.0, float.FLOAT_W_64) != 1.5)          { ret 6; }
    if (float_trunc_rem(0.0 - 7.5, 2.0, float.FLOAT_W_64) != -1.5)   { ret 7; }
    if (float_trunc_rem(2.0, 5.0, float.FLOAT_W_64) != 2.0)          { ret 8; }

    if (float.f64_bits(float_trunc_rem(1.0, 0.0, float.FLOAT_W_64)) == 0xDEADBEEFDEADBEEF) { ret 9; }
    if (float.f64_bits(float_trunc_rem(float.bits_f64(0x7FF0000000000000), 3.0, float.FLOAT_W_64)) == 0xDEADBEEFDEADBEEF) { ret 10; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:prefixes_and_separators" {
    val r1: res[CTValue, EvalFail] = t_eval_int("0b11111111");
    if (sel r1.err)                       { ret 1; }
    if (r1.ok.data.i:~u64 != 255) { ret 1; }
    val r2: res[CTValue, EvalFail] = t_eval_int("0o377");
    if (sel r2.err)                       { ret 1; }
    if (r2.ok.data.i:~u64 != 255) { ret 1; }
    val r3: res[CTValue, EvalFail] = t_eval_int("1_000");
    if (sel r3.err)                   { ret 1; }
    if (r3.ok.data.i != 1000) { ret 1; }
    val r4: res[CTValue, EvalFail] = t_eval_int("0b1_0000_0000");
    if (sel r4.err)                       { ret 1; }
    if (r4.ok.data.i:~u64 != 256) { ret 1; }
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0b");
    if (sel t_eval_int_r.ok) { ret 1; }
    val t_eval_int_r2: res[CTValue, EvalFail] = t_eval_int("0o");
    if (sel t_eval_int_r2.ok) { ret 1; }
    val t_eval_int_r3: res[CTValue, EvalFail] = t_eval_int("0x");
    if (sel t_eval_int_r3.ok) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.bind:frame_scoping" {
    var alloc: A.Allocator;
    val made_6: err[A.Error] = page.make(?alloc);
    if (sel made_6.err) { ret 1; }
    var c: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);

    val name1: intern.StrId = 1::intern.StrId;
    val name2: intern.StrId = 2::intern.StrId;

    val int_value_r: res[CTValue, EvalFail] = int_value(10);
    if (sel int_value_r.err) { ret 99; }
    val v10: CTValue = int_value_r.ok;
    val int_value_r2: res[CTValue, EvalFail] = int_value(20);
    if (sel int_value_r2.err) { ret 99; }
    val v20: CTValue = int_value_r2.ok;

    val b1: err[fail.Fail] = bind(?c, name1, v10);
    if (sel b1.err) { dnit(?c); ret 1; }

    val mr: res[FrameMark, fail.Fail] = frame_open(?c);
    if (sel mr.err) { dnit(?c); ret 1; }
    val m: FrameMark = mr.ok;
    val b2: err[fail.Fail] = bind(?c, name1, v20);
    if (sel b2.err) { dnit(?c); ret 1; }
    val df: err[fail.Fail] = defer_float_width(?c, name2);
    if (sel df.err) { dnit(?c); ret 1; }

    val lk1: opt[NamedConst] = lookup(?c, name1);
    if (!sel lk1.some)                   { dnit(?c); ret 1; }
    if (lk1.some.value.data.i != 20) { dnit(?c); ret 1; }

    val fc: err[fail.Fail] = frame_close(?c, m);
    if (sel fc.err) { dnit(?c); ret 1; }

    val lk2: opt[NamedConst] = lookup(?c, name1);
    if (!sel lk2.some)                   { dnit(?c); ret 1; }
    if (lk2.some.value.data.i != 10) { dnit(?c); ret 1; }

    val lk3: opt[NamedConst] = lookup(?c, name2);
    if (sel lk3.some)        { dnit(?c); ret 1; }
    if (float_width_deferred(?c, name2))    { dnit(?c); ret 1; }

    val depth_before: u32 = c.entries_len;
    val m2r: res[FrameMark, fail.Fail] = frame_open(?c);
    if (sel m2r.err) { dnit(?c); ret 1; }
    val m2: FrameMark = m2r.ok;
    val fc2: err[fail.Fail] = frame_close(?c, m2);
    if (sel fc2.err)      { dnit(?c); ret 1; }
    if (c.entries_len != depth_before) { dnit(?c); ret 1; }

    dnit(?c);
    ret 0;
}

test "mach.lang.fe.comptime.eval_ident:deferred_float_is_not_absent" {
    var alloc: A.Allocator;
    val made_7: err[A.Error] = page.make(?alloc);
    if (sel made_7.err) { ret 1; }
    var c: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    var itn: intern.Interner = intern.init(?alloc);

    val source: str = "ALIASED ABSENT";
    var s_alias: token.Span;
    s_alias.offset = 0::usize;
    s_alias.len    = 7::usize;
    var s_absent: token.Span;
    s_absent.offset = 8::usize;
    s_absent.len    = 6::usize;

    val id_r: res[intern.StrId, A.Error] = intern.intern_span(?itn, source, s_alias);
    if (sel id_r.err) { dnit(?c); ret 1; }
    val aliased: intern.StrId = id_r.ok;

    val r0: res[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_alias, ?itn);
    if (sel r0.ok)                                              { dnit(?c); ret 1; }
    if (r0.err.message == COMPTIME_ALIAS_FLOAT_MSG)               { dnit(?c); ret 1; }

    val d: err[fail.Fail] = defer_float_width(?c, aliased);
    if (sel d.err)            { dnit(?c); ret 1; }
    if (!float_width_deferred(?c, aliased)) { dnit(?c); ret 1; }

    val r1: res[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_alias, ?itn);
    if (sel r1.ok)                                { dnit(?c); ret 1; }
    if (r1.err.message != COMPTIME_ALIAS_FLOAT_MSG) { dnit(?c); ret 1; }

    val r2: res[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_absent, ?itn);
    if (sel r2.ok)                                { dnit(?c); ret 1; }
    if (r2.err.message == COMPTIME_ALIAS_FLOAT_MSG) { dnit(?c); ret 1; }

    val int_value_r: res[CTValue, EvalFail] = int_value(3);
    if (sel int_value_r.err) { ret 99; }
    val bv: CTValue = int_value_r.ok;
    val b: err[fail.Fail] = bind(?c, aliased, bv);
    if (sel b.err) { dnit(?c); ret 1; }
    val r3: res[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_alias, ?itn);
    if (sel r3.err)                            { dnit(?c); ret 1; }
    if (r3.ok.data.i != 3)             { dnit(?c); ret 1; }

    dnit(?c);
    ret 0;
}

test "mach.lang.fe.comptime.eval_ident:true_and_false_are_ordinary_bindings" {
    var alloc: A.Allocator;
    val made_8: err[A.Error] = page.make(?alloc);
    if (sel made_8.err) { ret 1; }
    var c: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    var itn: intern.Interner = intern.init(?alloc);

    val source: str = "true false";
    var s_true: token.Span;
    s_true.offset = 0::usize;
    s_true.len    = 4::usize;
    var s_false: token.Span;
    s_false.offset = 5::usize;
    s_false.len    = 5::usize;

    val unbound: res[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_true, ?itn);
    if (sel unbound.ok) { dnit(?c); ret 1; }

    val true_id_r: res[intern.StrId, A.Error] = intern.intern_span(?itn, source, s_true);
    if (sel true_id_r.err) { dnit(?c); ret 1; }
    val false_id_r: res[intern.StrId, A.Error] = intern.intern_span(?itn, source, s_false);
    if (sel false_id_r.err) { dnit(?c); ret 1; }

    val bind_true: err[fail.Fail] = bind(?c, true_id_r.ok, ct_u8(1));
    if (sel bind_true.err) { dnit(?c); ret 1; }
    val bind_false: err[fail.Fail] = bind(?c, false_id_r.ok, ct_u8(0));
    if (sel bind_false.err) { dnit(?c); ret 1; }

    val true_r: res[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_true, ?itn);
    if (sel true_r.err) { dnit(?c); ret 1; }
    val true_v: CTValue = true_r.ok;
    if (!is_u8(true_v) || true_v.data.i != 1) { dnit(?c); ret 1; }

    val false_r: res[CTValue, EvalFail] = eval_ident[NoCapabilityContext](?c, nil, no_capabilities(), source, id.EXPR_NIL, s_false, ?itn);
    if (sel false_r.err) { dnit(?c); ret 1; }
    val false_v: CTValue = false_r.ok;
    if (!is_u8(false_v) || false_v.data.i != 0) { dnit(?c); ret 1; }

    dnit(?c);
    ret 0;
}

test "mach.lang.fe.comptime.encode_scalar:int_honors_declared_endianness" {
    var alloc: A.Allocator;
    val made_9: err[A.Error] = page.make(?alloc);
    if (sel made_9.err) { ret 1; }
    var ti: type.TypeInterner;
    val init_typed_1: err[fail.Fail] = type.init(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[type.TypeId] = type.prim(?ti, type.TYPE_U32);
    if (!sel prim_typed_2.some) { ret 1; }
    val u32t: type.TypeId = prim_typed_2.some;
    val c: TypedConstant = const_int(u32t, 0x11223344);

    var buf_le: [4]u8;
    var reloc: opt[RelocationRequest];
    val le_r: res[u32, fail.Fail] = encode_scalar(?ti, c, data_model(8, false), 0, ?buf_le[0], 4, ?reloc);
    if (sel le_r.err) { type.dnit(?ti); ret 1; }
    if (le_r.ok != 4) { type.dnit(?ti); ret 1; }
    if (buf_le[0] != 0x44 || buf_le[1] != 0x33 || buf_le[2] != 0x22 || buf_le[3] != 0x11) { type.dnit(?ti); ret 1; }

    var buf_be: [4]u8;
    val be_r: res[u32, fail.Fail] = encode_scalar(?ti, c, data_model(8, true), 0, ?buf_be[0], 4, ?reloc);
    if (sel be_r.err) { type.dnit(?ti); ret 1; }
    if (be_r.ok != 4) { type.dnit(?ti); ret 1; }
    if (buf_be[0] != 0x11 || buf_be[1] != 0x22 || buf_be[2] != 0x33 || buf_be[3] != 0x44) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.const_float:rounds_to_declared_width_and_roundtrips" {
    var alloc: A.Allocator;
    val made_10: err[A.Error] = page.make(?alloc);
    if (sel made_10.err) { ret 1; }
    var ti: type.TypeInterner;
    val init_typed_1: err[fail.Fail] = type.init(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[type.TypeId] = type.prim(?ti, type.TYPE_F32);
    if (!sel prim_typed_2.some) { ret 1; }
    val f32t: type.TypeId = prim_typed_2.some;
    val prim_typed_3: opt[type.TypeId] = type.prim(?ti, type.TYPE_F64);
    if (!sel prim_typed_3.some) { ret 1; }
    val f64t: type.TypeId = prim_typed_3.some;
    val precise: f64 = 0.1;

    val c32_r: res[TypedConstant, fail.Fail] = const_float(?ti, f32t, precise);
    if (sel c32_r.err) { type.dnit(?ti); ret 1; }
    val c32: TypedConstant = c32_r.ok;
    if (float.bits_f64(c32.bits) == precise) { type.dnit(?ti); ret 1; }

    val c64_r: res[TypedConstant, fail.Fail] = const_float(?ti, f64t, precise);
    if (sel c64_r.err) { type.dnit(?ti); ret 1; }
    val c64: TypedConstant = c64_r.ok;
    if (float.bits_f64(c64.bits) != precise) { type.dnit(?ti); ret 1; }

    var buf32: [4]u8;
    var reloc: opt[RelocationRequest];
    val e32: res[u32, fail.Fail] = encode_scalar(?ti, c32, data_model(8, false), 0, ?buf32[0], 4, ?reloc);
    if (sel e32.err) { type.dnit(?ti); ret 1; }
    if (e32.ok != 4) { type.dnit(?ti); ret 1; }
    val back32: u32 = buf32[0]::u32 | (buf32[1]::u32 << 8) | (buf32[2]::u32 << 16) | (buf32[3]::u32 << 24);
    if (float.f32_bits_to_f64_bits(back32) != c32.bits) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.const_reinterpret:relabels_kind_and_strips_secret_before_measuring" {
    var alloc: A.Allocator;
    val made_11: err[A.Error] = page.make(?alloc);
    if (sel made_11.err) { ret 1; }
    var ti: type.TypeInterner;
    val init_typed_1: err[fail.Fail] = type.init(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[type.TypeId] = type.prim(?ti, type.TYPE_U32);
    if (!sel prim_typed_2.some) { ret 1; }
    val u32t: type.TypeId = prim_typed_2.some;
    val prim_typed_3: opt[type.TypeId] = type.prim(?ti, type.TYPE_F32);
    if (!sel prim_typed_3.some) { ret 1; }
    val f32t: type.TypeId = prim_typed_3.some;
    val prim_typed_4: opt[type.TypeId] = type.prim(?ti, type.TYPE_U64);
    if (!sel prim_typed_4.some) { ret 1; }
    val u64t: type.TypeId = prim_typed_4.some;
    val sec_r: res[type.TypeId, fail.Fail] = type.intern_secret(?ti, f32t);
    if (sel sec_r.err) { type.dnit(?ti); ret 1; }
    val sec_f32: type.TypeId = sec_r.ok;

    val c: TypedConstant = const_int(u32t, 0x3F800000);
    val re_r: res[TypedConstant, fail.Fail] = const_reinterpret(?ti, c, sec_f32, 8);
    if (sel re_r.err) { type.dnit(?ti); ret 1; }
    val re: TypedConstant = re_r.ok;
    if (re.kind != CONST_FLOAT || re.bits != 0x3F800000 || re.ty != sec_f32) { type.dnit(?ti); ret 1; }

    val bad_r: res[TypedConstant, fail.Fail] = const_reinterpret(?ti, c, u64t, 8);
    if (sel bad_r.ok) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.encode_scalar:pointer_field_emits_relocation_not_a_fabricated_address" {
    var alloc: A.Allocator;
    val made_12: err[A.Error] = page.make(?alloc);
    if (sel made_12.err) { ret 1; }
    var ti: type.TypeInterner;
    val init_typed_1: err[fail.Fail] = type.init(?ti, ?alloc);
    if (sel init_typed_1.err) { ret 1; }

    val prim_typed_2: opt[type.TypeId] = type.prim(?ti, type.TYPE_U32);
    if (!sel prim_typed_2.some) { ret 1; }
    val u32t: type.TypeId = prim_typed_2.some;
    val ptr_r: res[type.TypeId, fail.Fail] = type.intern_pointer(?ti, u32t);
    if (sel ptr_r.err) { type.dnit(?ti); ret 1; }
    val ptr_ty: type.TypeId = ptr_r.ok;

    val sym: intern.StrId = 42::intern.StrId;
    val c: TypedConstant = const_pointer(ptr_ty, sym, 12);

    var buf: [8]u8;
    var i: u32 = 0;
    for (i < 8) { buf[i] = 0xAA; i = i + 1; }
    var reloc: opt[RelocationRequest];
    val r: res[u32, fail.Fail] = encode_scalar(?ti, c, data_model(8, false), 100, ?buf[0], 8, ?reloc);
    if (sel r.err) { type.dnit(?ti); ret 1; }
    if (r.ok != 8) { type.dnit(?ti); ret 1; }
    i = 0;
    for (i < 8) { if (buf[i] != 0) { type.dnit(?ti); ret 1; } i = i + 1; }
    if (!sel reloc.some) { type.dnit(?ti); ret 1; }
    val rr: RelocationRequest = reloc.some;
    if (rr.offset != 100 || rr.symbol != sym || rr.addend != 12 || rr.width != 8) { type.dnit(?ti); ret 1; }

    type.dnit(?ti);
    ret 0;
}

test "mach.lang.fe.comptime.const_address_add:checked_and_rejects_overflow" {
    val sym: intern.StrId = 7::intern.StrId;
    val nil_ty: type.TypeId = 0::type.TypeId;
    val c: TypedConstant = const_symbol(nil_ty, sym);

    val ok_r: res[TypedConstant, fail.Fail] = const_address_add(c, 16);
    if (sel ok_r.err) { ret 1; }
    if (ok_r.ok.addr.addend != 16) { ret 1; }

    val near_max: TypedConstant = const_pointer(nil_ty, sym, 9223372036854775806);
    val overflow_r: res[TypedConstant, fail.Fail] = const_address_add(near_max, 2);
    if (sel overflow_r.ok) { ret 1; }

    val near_min: TypedConstant = const_pointer(nil_ty, sym, -9223372036854775807);
    val underflow_r: res[TypedConstant, fail.Fail] = const_address_add(near_min, -2);
    if (sel underflow_r.ok) { ret 1; }

    val non_address: TypedConstant = const_int(nil_ty, 0);
    val const_address_add_1: res[TypedConstant, fail.Fail] = const_address_add(non_address, 1);
    if (sel const_address_add_1.ok) { ret 1; }

    ret 0;
}

