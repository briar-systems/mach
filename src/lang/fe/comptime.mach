    val c: TypedConstant = const_int(u64t, 1);

    var buf: [4]u8;
    var reloc: opt[RelocationRequest];
    val r: res[u32, fail.Fail] = encode_scalar(?ti, c, data_model(8, false), 0, ?buf[0], 4, ?reloc);
