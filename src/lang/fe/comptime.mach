    "a comptime type predicate is only evaluable after type checking";

pub val COMPTIME_FIELD_NO_RESOLVER_MSG: str =
    "a field descriptor member is only comptime-evaluable after type checking";

pub val COMPTIME_FIELD_UNKNOWN_MEMBER_MSG: str =
    "a field descriptor has only `.name`, `.type`, and `.offset`";

pub val COMPTIME_CASE_UNKNOWN_MEMBER_MSG: str =
    "a case descriptor has only `.name`, `.has_payload`, `.type`, `.offset`, and `.code`";

pub val COMPTIME_DESCRIPTOR_LAYOUT_MSG: str =
    "this descriptor's offset has no answer: the layout of its owning type could not be determined";

pub val COMPTIME_CASE_NO_PAYLOAD_MSG: str =
    "this case has no payload, so it has no `.type` or `.offset`; gate on `.has_payload` first";

pub val COMPTIME_FIELD_UNAVAILABLE_MSG: str =
    "this field descriptor member is not available until lowering";

pub val COMPTIME_MEMBER_NOT_CONST_MSG: str =
    "module-qualified member does not name a module-level constant";

pub def EvalFailKind: u8;

pub val EVAL_FAIL_NONE:         EvalFailKind = 0;
pub val EVAL_FAIL_REJECTED:     EvalFailKind = 1;
pub val EVAL_FAIL_UNBOUND:      EvalFailKind = 2;
pub val EVAL_FAIL_NEEDS_MEMBER: EvalFailKind = 3;
pub val EVAL_FAIL_NEEDS_TYPES:  EvalFailKind = 4;
pub val EVAL_FAIL_NEEDS_LAYOUT: EvalFailKind = 5;
pub val EVAL_FAIL_INTERNAL:     EvalFailKind = 6;

pub rec EvalFail {
    kind:    EvalFailKind;
    message: str;
}

fun eval_internal_result[T](r: res[T, fail.Fail]) res[T, EvalFail] {
    if (sel r.err) { ret res[T, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, fail.describe(r.err))}; }
    ret res[T, EvalFail].ok{r.ok};
}

fun eval_refused_result[T](r: res[T, A.Error]) res[T, EvalFail] {
    if (sel r.err) { ret res[T, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, alloc.text(r.err))}; }
    ret res[T, EvalFail].ok{r.ok};
}

pub fun eval_error(kind: EvalFailKind, message: str) EvalFail {
    var f: EvalFail;
    f.kind = kind;
    f.message = message;
    ret f;
}

pub fun eval_from_fail(f: fail.Fail, rejected_message: str) EvalFail {
    if (sel f.reported) { ret eval_error(EVAL_FAIL_REJECTED, rejected_message); }
    ret eval_error(EVAL_FAIL_INTERNAL, fail.describe(f));
}

fun internal_failure(message: str) res[CTValue, EvalFail] {
    ret awaiting(EVAL_FAIL_INTERNAL, message);
}

fun reject(message: str) res[CTValue, EvalFail] {
    ret awaiting(EVAL_FAIL_REJECTED, message);
}

fun awaiting(kind: EvalFailKind, message: str) res[CTValue, EvalFail] {
    var f: EvalFail;
    f.kind    = kind;
    f.message = message;
    ret res[CTValue, EvalFail].err{f};
}

pub fun gate_eval_failure_is_transient(kind: EvalFailKind) bool {
    ret kind == EVAL_FAIL_UNBOUND
     || kind == EVAL_FAIL_NEEDS_MEMBER
     || kind == EVAL_FAIL_NEEDS_LAYOUT;
}

pub def ConstKind: u8;

pub val CONST_INT:     ConstKind = 0;
pub val CONST_FLOAT:   ConstKind = 1;
pub val CONST_POINTER: ConstKind = 2;
pub val CONST_SYMBOL:  ConstKind = 3;
pub val CONST_ZERO:    ConstKind = 4;

pub rec ConstAddress {
    symbol: intern.StrId;
    addend: i64;
}

pub rec TypedConstant {
    ty:   type.TypeId;
    kind: ConstKind;
    bits: u64;
    addr: ConstAddress;
}

pub fun const_int(ty: type.TypeId, bits: u64) TypedConstant {
    var c: TypedConstant;
    c.ty   = ty;
    c.kind = CONST_INT;
    c.bits = bits;
    ret c;
}

pub fun const_float(ti: *type.TypeInterner, ty: type.TypeId, f: f64) res[TypedConstant, fail.Fail] {
    val stripped: type.TypeId = type.strip_secret(ti, ty);
    val opt_t: opt[*type.Type] = type.get(ti, stripped);
    if (!sel opt_t.some) { ret res[TypedConstant, fail.Fail].err{fail.message("typed constant: unknown float type")}; }
    val w: float.FloatWidth = type.float_width_of(opt_t.some.kind);
    if (w == float.FLOAT_W_NONE) { ret res[TypedConstant, fail.Fail].err{fail.message("typed constant: not a float type")}; }

    var c: TypedConstant;
    c.ty   = ty;
    c.kind = CONST_FLOAT;
    c.bits = float.f64_bits(float.round_at(f, w));
    ret res[TypedConstant, fail.Fail].ok{c};
}

pub fun const_zero(ty: type.TypeId) TypedConstant {
    var c: TypedConstant;
    c.ty   = ty;
    c.kind = CONST_ZERO;
    c.bits = 0;
    ret c;
}

pub fun const_pointer(ty: type.TypeId, symbol: intern.StrId, addend: i64) TypedConstant {
    var c: TypedConstant;
    c.ty          = ty;
    c.kind        = CONST_POINTER;
    c.addr.symbol = symbol;
    c.addr.addend = addend;
    ret c;
}

pub fun const_symbol(ty: type.TypeId, symbol: intern.StrId) TypedConstant {
    var c: TypedConstant;
    c.ty          = ty;
    c.kind        = CONST_SYMBOL;
    c.addr.symbol = symbol;
    c.addr.addend = 0;
    ret c;
}

fun const_bit_extent(ti: *type.TypeInterner, ty: type.TypeId, ptr_width: u32) opt[u32] {
    val stripped: type.TypeId = type.strip_secret(ti, ty);
    val opt_t: opt[*type.Type] = type.get(ti, stripped);
    if (!sel opt_t.some) { ret opt[u32].none{}; }
    val t: *type.Type = opt_t.some;
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER) { ret opt[u32].some{ptr_width * 8}; }
    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_NONE) { ret opt[u32].none{}; }
    ret opt[u32].some{d.bits};
}

pub val REINTERPRET_MSG_UNSUPPORTED_SOURCE: str =
    "typed constant reinterpretation: unsupported source kind";

pub val REINTERPRET_MSG_UNREPRESENTABLE: str =
    "typed constant reinterpretation: unrepresentable operand type";

pub val REINTERPRET_MSG_WIDTH_MISMATCH: str =
    "typed constant reinterpretation: bit extent mismatch";

pub fun const_reinterpret(ti: *type.TypeInterner, c: TypedConstant, dest_ty: type.TypeId, ptr_width: u32) res[TypedConstant, fail.Fail] {
    if (c.kind != CONST_INT && c.kind != CONST_FLOAT) {
        ret res[TypedConstant, fail.Fail].err{fail.message(REINTERPRET_MSG_UNSUPPORTED_SOURCE)};
    }

    val src_extent: opt[u32] = const_bit_extent(ti, c.ty, ptr_width);
    val dst_extent: opt[u32] = const_bit_extent(ti, dest_ty, ptr_width);
    if (!sel src_extent.some) {
        ret res[TypedConstant, fail.Fail].err{fail.message(REINTERPRET_MSG_UNREPRESENTABLE)};
    }
    if (!sel dst_extent.some) {
        ret res[TypedConstant, fail.Fail].err{fail.message(REINTERPRET_MSG_UNREPRESENTABLE)};
    }
    if (src_extent.some != dst_extent.some) {
        ret res[TypedConstant, fail.Fail].err{fail.message(REINTERPRET_MSG_WIDTH_MISMATCH)};
    }

    val dest_stripped: type.TypeId = type.strip_secret(ti, dest_ty);
    val opt_dest: opt[*type.Type] = type.get(ti, dest_stripped);
    if (!sel opt_dest.some) {
        ret res[TypedConstant, fail.Fail].err{fail.message(REINTERPRET_MSG_UNREPRESENTABLE)};
    }
    val dest_kind: type.TypeKind = opt_dest.some.kind;
    val dest_class: type.PrimClass = type.prim_desc(dest_kind).class;

    var out: TypedConstant;
    out.ty   = dest_ty;
    out.bits = c.bits;
    if (dest_class == type.PRIM_CLASS_FLOAT) { out.kind = CONST_FLOAT; }
    or                                       { out.kind = CONST_INT; }
    ret res[TypedConstant, fail.Fail].ok{out};
}

val MAX_ADDEND: i64 = 9223372036854775807;
val MIN_ADDEND: i64 = -9223372036854775807 - 1;

pub fun const_address_add(c: TypedConstant, delta: i64) res[TypedConstant, fail.Fail] {
    if (c.kind != CONST_POINTER && c.kind != CONST_SYMBOL) {
        ret res[TypedConstant, fail.Fail].err{fail.message("typed constant address arithmetic: not an address-carrying constant")};
    }
    if (delta > 0 && c.addr.addend > MAX_ADDEND - delta) {
        ret res[TypedConstant, fail.Fail].err{fail.message("typed constant address arithmetic: addend overflow")};
    }
    if (delta < 0 && c.addr.addend < MIN_ADDEND - delta) {
        ret res[TypedConstant, fail.Fail].err{fail.message("typed constant address arithmetic: addend underflow")};
    }
    var out: TypedConstant = c;
    out.addr.addend = c.addr.addend + delta;
    ret res[TypedConstant, fail.Fail].ok{out};
}

pub rec DataModel {
    ptr_width:  u32;
    big_endian: bool;
}

pub fun data_model(ptr_width: u32, big_endian: bool) DataModel {
    var dm: DataModel;
    dm.ptr_width  = ptr_width;
    dm.big_endian = big_endian;
    ret dm;
}

pub rec RelocationRequest {
    offset: u32;
    symbol: intern.StrId;
    addend: i64;
    width:  u32;
}

fun encode_width_bytes(bits: u64, width: u32, big_endian: bool, out: *u8, out_len: usize) res[u32, fail.Fail] {
    if (width::usize > out_len) {
        ret res[u32, fail.Fail].err{fail.message("typed constant encode: destination buffer too small")};
    }
    var i: u32 = 0;
    for (i < width) {
        val shift: u64 = (i * 8)::u64;
        val byte: u8 = ((bits >> shift) & 0xFF)::u8;
        if (big_endian) { out[width - 1 - i] = byte; }
        or               { out[i] = byte; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].ok{width};
}

pub fun encode_scalar(ti: *type.TypeInterner, c: TypedConstant, dm: DataModel, base_offset: u32,
                      out: *u8, out_len: usize, reloc_out: *opt[RelocationRequest]) res[u32, fail.Fail] {
    @reloc_out = opt[RelocationRequest].none{};

    if (c.kind == CONST_ZERO) {
        val extent_opt: opt[u32] = const_bit_extent(ti, c.ty, dm.ptr_width);
        if (!sel extent_opt.some) { ret res[u32, fail.Fail].err{fail.message("typed constant encode: unrepresentable type")}; }
        val bytes: u32 = extent_opt.some / 8;
        if (bytes::usize > out_len) { ret res[u32, fail.Fail].err{fail.message("typed constant encode: destination buffer too small")}; }
        var i: u32 = 0;
        for (i < bytes) { out[i] = 0; i = i + 1; }
        ret res[u32, fail.Fail].ok{bytes};
    }

    if (c.kind == CONST_INT || c.kind == CONST_FLOAT) {
        val extent_opt: opt[u32] = const_bit_extent(ti, c.ty, dm.ptr_width);
        if (!sel extent_opt.some) { ret res[u32, fail.Fail].err{fail.message("typed constant encode: unrepresentable type")}; }
        val bits_width: u32 = extent_opt.some;
        val bytes: u32 = bits_width / 8;
        if (c.kind == CONST_FLOAT && bytes == 4) {
            ret encode_width_bytes(float.f64_to_f32_bits(c.bits)::u64, 4, dm.big_endian, out, out_len);
        }
        ret encode_width_bytes(c.bits, bytes, dm.big_endian, out, out_len);
    }

    if (c.kind == CONST_POINTER || c.kind == CONST_SYMBOL) {
        if (dm.ptr_width::usize > out_len) {
            ret res[u32, fail.Fail].err{fail.message("typed constant encode: destination buffer too small")};
        }
        var i: u32 = 0;
        for (i < dm.ptr_width) { out[i] = 0; i = i + 1; }
        var rr: RelocationRequest;
        rr.offset = base_offset;
        rr.symbol = c.addr.symbol;
        rr.addend = c.addr.addend;
        rr.width  = dm.ptr_width;
        @reloc_out = opt[RelocationRequest].some{rr};
        ret res[u32, fail.Fail].ok{dm.ptr_width};
    }

    ret res[u32, fail.Fail].err{fail.message("typed constant encode: unsupported constant kind")};
}

pub rec FrameMark {
    owner:         ptr;
    entries_len:   u32;
    deferred_len:  u32;
    generation:    u64;
    parent:        u64;
}

pub rec ComptimeEnv {
    alloc:          *A.Allocator;
    target_os_id:   u32;
    target_arch_id: u32;
    target_abi_id:  u32;
    build_mode_id:  u32;
    build_pie:      u32;
    pointer_width:  u32;
    target_defs:    *isa.TargetDefs;
    vector_bits:    u32;
    has_float:      bool;
    va_list_size:   u32;
    va_list_align:  u32;
    compiler_name:  intern.StrId;
    compiler_ver:   intern.StrId;
    project_id:     intern.StrId;
    project_ver:    intern.StrId;
    target_os:      intern.StrId;
    target_isa:     intern.StrId;
    target_abi:     intern.StrId;
    target_platform: intern.StrId;
    bin_name:       intern.StrId;
    union_build:    bool;
}

pub rec ComptimeCtx {
    env:              ComptimeEnv;
    entries:          *NamedConst;
    entries_len:      u32;
    entries_cap:      u32;
    deferred:         *intern.StrId;
    deferred_len:     u32;
    deferred_cap:     u32;
    frame_generation: u64;
    frame_top:        u64;
    gate_states:      *GateState;
    gate_count:       u32;
    load_walked:      *bool;
    gate_decl_count:  u32;
}

pub fun environment(c: *ComptimeCtx) ComptimeEnv {
    ret c.env;
}

val INITIAL_CONST_CAP: u32 = 8;

fun is_i64_min(a: i64) bool {
    ret a != 0 && (0 - a) == a;
}

pub fun init(
    alloc:          *A.Allocator,
    target_os_id:   u32,
    target_arch_id: u32,
    target_abi_id:  u32,
    build_mode_id:  u32,
    build_pie:      u32,
    pointer_width:  u32,
    vector_bits:    u32,
    has_float:      bool,
    compiler_name:  intern.StrId,
    compiler_ver:   intern.StrId
) ComptimeCtx {
    var c: ComptimeCtx;
    c.env.alloc           = alloc;
    c.env.target_os_id    = target_os_id;
    c.env.target_arch_id  = target_arch_id;
    c.env.target_abi_id   = target_abi_id;
    c.env.build_mode_id   = build_mode_id;
    c.env.build_pie       = build_pie;
    c.env.pointer_width   = pointer_width;
    c.env.target_defs     = nil;
    c.env.vector_bits     = vector_bits;
    c.env.has_float       = has_float;
    c.env.va_list_size    = 0;
    c.env.va_list_align   = 0;
    c.env.compiler_name   = compiler_name;
    c.env.compiler_ver    = compiler_ver;
    c.env.project_id      = intern.STR_NIL;
    c.env.project_ver     = intern.STR_NIL;
    c.env.target_os       = intern.STR_NIL;
    c.env.target_isa      = intern.STR_NIL;
    c.env.target_abi      = intern.STR_NIL;
    c.env.target_platform = intern.STR_NIL;
    c.env.bin_name        = intern.STR_NIL;
    c.env.union_build     = false;

    c.entries          = nil;
    c.entries_len      = 0;
    c.entries_cap      = 0;
    c.deferred         = nil;
    c.deferred_len     = 0;
    c.deferred_cap     = 0;
    c.frame_generation = 0;
    c.frame_top        = 0;
    c.gate_states      = nil;
    c.gate_count       = 0;
    c.load_walked      = nil;
    c.gate_decl_count  = 0;
    ret c;
}

pub fun set_union_build(c: *ComptimeCtx, v: bool) {
    c.env.union_build = v;
}

pub fun set_target_defs(c: *ComptimeCtx, d: *isa.TargetDefs) {
    c.env.target_defs = d;
}

pub fun set_va_list(c: *ComptimeCtx, size: u32, align: u32) {
    c.env.va_list_size  = size;
    c.env.va_list_align = align;
}

pub fun set_build_context(
    c:            *ComptimeCtx,
    project_id:   intern.StrId,
    project_ver:  intern.StrId,
    target_os:    intern.StrId,
    target_isa:   intern.StrId,
    target_abi:   intern.StrId,
    target_platform: intern.StrId,
    bin_name:     intern.StrId
) {
    c.env.project_id   = project_id;
    c.env.project_ver  = project_ver;
    c.env.target_os    = target_os;
    c.env.target_isa   = target_isa;
    c.env.target_abi   = target_abi;
    c.env.target_platform = target_platform;
    c.env.bin_name     = bin_name;
}

pub fun dnit(c: *ComptimeCtx) {
    if (c == nil) { ret; }
    if (c.entries != nil && c.entries_cap > 0) {
        A.deallocate[NamedConst](c.env.alloc, c.entries, c.entries_cap::usize);
    }
    c.entries     = nil;
    c.entries_len = 0;
    c.entries_cap = 0;
    if (c.deferred != nil && c.deferred_cap > 0) {
        A.deallocate[intern.StrId](c.env.alloc, c.deferred, c.deferred_cap::usize);
    }
    if (c.gate_states != nil && c.gate_count > 0) {
        A.deallocate[GateState](c.env.alloc, c.gate_states, c.gate_count::usize);
    }
    if (c.load_walked != nil && c.gate_decl_count > 0) {
        A.deallocate[bool](c.env.alloc, c.load_walked, c.gate_decl_count::usize);
    }
    c.deferred    = nil;
    c.deferred_len = 0;
    c.deferred_cap = 0;
    c.frame_top   = 0;
    c.gate_states = nil;
    c.gate_count  = 0;
    c.load_walked = nil;
    c.gate_decl_count = 0;
}

pub fun prepare_gates(c: *ComptimeCtx, expr_count: u32, decl_count: u32) err[fail.Fail] {
    if (c.gate_states == nil && expr_count > 0) {
        val sr: res[*GateState, A.Error] = A.allocate[GateState](c.env.alloc, expr_count::usize);
        if (sel sr.err) { ret err[fail.Fail].err{fail.refused(sr.err)}; }
        c.gate_states = sr.ok;
        c.gate_count = expr_count;
        var i: u32 = 0;
        for (i < expr_count) { c.gate_states[i] = GATE_STATE_UNKNOWN; i = i + 1; }
    }
    if (c.load_walked == nil && decl_count > 0) {
        val wr: res[*bool, A.Error] = A.allocate[bool](c.env.alloc, decl_count::usize);
        if (sel wr.err) { ret err[fail.Fail].err{fail.refused(wr.err)}; }
        c.load_walked = wr.ok;
        c.gate_decl_count = decl_count;
        var i: u32 = 0;
        for (i < decl_count) { c.load_walked[i] = false; i = i + 1; }
    }
    ret err[fail.Fail].ok{};
}

pub fun gate_state(c: *ComptimeCtx, eid: id.ExprId) GateState {
    if (c == nil || c.gate_states == nil || eid == id.EXPR_NIL || eid >= c.gate_count) {
        ret GATE_STATE_UNKNOWN;
    }
    ret c.gate_states[eid];
}

pub fun set_gate_state(c: *ComptimeCtx, eid: id.ExprId, state: GateState) {
    if (c == nil || c.gate_states == nil || eid == id.EXPR_NIL || eid >= c.gate_count) { ret; }
    c.gate_states[eid] = state;
}

pub fun load_walked(c: *ComptimeCtx, did: id.DeclId) bool {
    if (c == nil || c.load_walked == nil || did == id.DECL_NIL || did >= c.gate_decl_count) { ret false; }
    ret c.load_walked[did];
}

pub fun mark_load_walked(c: *ComptimeCtx, did: id.DeclId) {
    if (c == nil || c.load_walked == nil || did == id.DECL_NIL || did >= c.gate_decl_count) { ret; }
    c.load_walked[did] = true;
}

pub fun defer_float_width(c: *ComptimeCtx, name: intern.StrId) err[fail.Fail] {
    if (c.deferred_len == c.deferred_cap) {
        var new_cap: u32 = c.deferred_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_CONST_CAP; }
        val g: res[*intern.StrId, A.Error] =
            A.reallocate[intern.StrId](c.env.alloc, c.deferred, c.deferred_cap::usize, new_cap::usize);
        if (sel g.err) {
            ret err[fail.Fail].err{fail.refused(g.err)};
        }
        c.deferred     = g.ok;
        c.deferred_cap = new_cap;
    }
    c.deferred[c.deferred_len] = name;
    c.deferred_len = c.deferred_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun float_width_deferred(c: *ComptimeCtx, name: intern.StrId) bool {
    var i: u32 = 0;
    for (i < c.deferred_len) {
        if (c.deferred[i] == name) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun bind(c: *ComptimeCtx, name: intern.StrId, value: CTValue) err[fail.Fail] {
    var nc: NamedConst;
    nc.name  = name;
    nc.value = value;
    nc.gated = false;
    ret consts_push(c.env.alloc, ?c.entries, ?c.entries_len, ?c.entries_cap, nc);
}

pub fun bind_gated(c: *ComptimeCtx, name: intern.StrId, value: CTValue, gated: bool) err[fail.Fail] {
    var nc: NamedConst;
    nc.name  = name;
    nc.value = value;
    nc.gated = gated;
    ret consts_push(c.env.alloc, ?c.entries, ?c.entries_len, ?c.entries_cap, nc);
}

pub fun frame_open(c: *ComptimeCtx) res[FrameMark, fail.Fail] {
    if (c == nil) { ret res[FrameMark, fail.Fail].err{fail.message("comptime: frame_open requires a context")}; }
    if (c.frame_generation == 0xFFFFFFFFFFFFFFFF) {
        ret res[FrameMark, fail.Fail].err{fail.message("comptime: frame generation exhausted")};
    }
    var mark: FrameMark;
    mark.owner        = c::ptr;
    mark.entries_len  = c.entries_len;
    mark.deferred_len = c.deferred_len;
    mark.generation   = c.frame_generation + 1;
    mark.parent       = c.frame_top;
    c.frame_generation = mark.generation;
    c.frame_top        = mark.generation;
    ret res[FrameMark, fail.Fail].ok{mark};
}

pub fun frame_close(c: *ComptimeCtx, mark: FrameMark) err[fail.Fail] {
    if (c == nil || mark.owner != c::ptr) {
        ret err[fail.Fail].err{fail.message("comptime: frame_close mark belongs to another context")};
    }
    if (mark.generation == 0 || mark.generation != c.frame_top) {
        ret err[fail.Fail].err{fail.message("comptime: frame_close mark is stale or out of order")};
    }
    if (mark.entries_len > c.entries_len || mark.deferred_len > c.deferred_len) {
        ret err[fail.Fail].err{fail.message("comptime: frame_close mark exceeds current frame state")};
    }
    c.entries_len  = mark.entries_len;
    c.deferred_len = mark.deferred_len;
    c.frame_top    = mark.parent;
    ret err[fail.Fail].ok{};
}

pub fun lookup(c: *ComptimeCtx, name: intern.StrId) opt[NamedConst] {
    var i: u32 = c.entries_len;
    for (i > 0) {
        i = i - 1;
        if (c.entries[i].name == name) {
            ret opt[NamedConst].some{c.entries[i]};
        }
    }
    ret opt[NamedConst].none{};
}

pub fun field_type_of_binding[T](c: *ComptimeCtx, cap_ctx: *T, caps: PhaseCapabilities[T], name: intern.StrId) res[opt[u32], EvalFail] {
    val bound: opt[NamedConst] = lookup(c, name);
    if (sel bound.none) { ret res[opt[u32], EvalFail].ok{opt[u32].none{}}; }
    val nc: NamedConst = bound.some;
    if (!is_descriptor(nc.value)) { ret res[opt[u32], EvalFail].ok{opt[u32].none{}}; }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.field == nil) { ret res[opt[u32], EvalFail].ok{opt[u32].none{}}; }
    val r: res[opt[CTValue], EvalFail] = caps.field(cap_ctx, nc.value.data.fld.owner, nc.value.data.fld.index, FIELD_SEL_TYPE);
    if (sel r.err) { ret res[opt[u32], EvalFail].err{r.err}; }
    val o: opt[CTValue] = r.ok;
    if (sel o.none) { ret res[opt[u32], EvalFail].ok{opt[u32].none{}}; }
    val v: CTValue = o.some;
    if (v.kind != CT_KIND_TYPE) { ret res[opt[u32], EvalFail].ok{opt[u32].none{}}; }
    ret res[opt[u32], EvalFail].ok{opt[u32].some{v.data.t}};
}

fun consts_push(a: *A.Allocator, arr: **NamedConst, len: *u32, cap: *u32, nc: NamedConst) err[fail.Fail] {
    if (@len == @cap) {
        var new_cap: u32 = @cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_CONST_CAP; }
        val res_grow: res[*NamedConst, A.Error] =
            A.reallocate[NamedConst](a, @arr, (@cap)::usize, new_cap::usize);
        if (sel res_grow.err) {
            ret err[fail.Fail].err{fail.refused(res_grow.err)};
        }
        @arr = res_grow.ok;
        @cap = new_cap;
    }

    val dst: *NamedConst = @arr;
    dst[@len] = nc;
    @len = @len + 1;
    ret err[fail.Fail].ok{};
}

pub fun evaluate[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner
) res[CTValue, EvalFail] {
    ret evaluate_at_float_width[T](c, cap_ctx, caps, a, source, e, interner, float.FLOAT_W_NONE);
}

pub fun evaluate_at_float_width[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[CTValue, EvalFail] {
    val result: res[CTValue, EvalFail] = evaluate_expression[T](c, cap_ctx, caps, a, source, e, interner, fw);
    ret checked_value(interner, result);
}

fun checked_value(interner: *intern.Interner, result: res[CTValue, EvalFail]) res[CTValue, EvalFail] {
    if (sel result.err) { ret result; }
    val value: CTValue = result.ok;
    if (value.kind > CT_KIND_CASE) { ret unknown_catalog(interner, "CTKind", value.kind::u32); }
    ret result;
}

# the one closed-catalog policy, owned by the interner that outlives this evaluation
fun unknown_catalog(interner: *intern.Interner, catalog: str, tag: u32) res[CTValue, EvalFail] {
    if (interner == nil) { ret internal_failure("comptime catalog diagnostic requires its interner"); }
    ret internal_failure(fail.catalog_message(interner, interner.a, fail.unknown_member(catalog, tag)));
}

fun evaluate_expression[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[CTValue, EvalFail] {
    if (e == id.EXPR_NIL) { ret reject("missing expression"); }

    val expression: res[expr.Expr, EvalFail] = read_expression[T](cap_ctx, caps, a, e);
    if (sel expression.err) { ret res[CTValue, EvalFail].err{expression.err}; }
    var node_value: expr.Expr = expression.ok;
    val node: *expr.Expr = ?node_value;
    val k: expr.ExprKind = node.kind;

    if (k == expr.EXPR_KIND_LIT_INT)   { ret eval_lit_int(source, node.span); }
    if (k == expr.EXPR_KIND_LIT_FLOAT) {
        val r_lit: res[LitFloat, fail.Fail] = scan_lit_float(source, node.span);
        if (sel r_lit.err) { ret reject(fail.describe(r_lit.err)); }
        val lit: LitFloat = r_lit.ok;
        if (lit.suffix != expr.LIT_SUFFIX_NONE) { ret float_value(lit.value, type.float_width_of(lit.suffix)); }
        ret float_value(lit.value, fw);
    }
    if (k == expr.EXPR_KIND_LIT_CHAR)  { ret eval_lit_char(source, node.span); }
    if (k == expr.EXPR_KIND_LIT_STR)   { ret eval_lit_str(source, node.span, interner); }
    if (k == expr.EXPR_KIND_LIT_NIL)   { ret reject("nil is not comptime-evaluable"); }

    if (k == expr.EXPR_KIND_BINARY) { ret eval_binary[T](c, cap_ctx, caps, a, source, e, ?node.data.binary, interner, fw); }
    if (k == expr.EXPR_KIND_UNARY)  { ret eval_unary[T](c, cap_ctx, caps, a, source, ?node.data.unary, interner, fw); }
    if (k == expr.EXPR_KIND_SEL)    { ret eval_sel[T](c, cap_ctx, caps, a, source, ?node.data.sel, interner, fw); }

    if (k == expr.EXPR_KIND_IDENT) {
        val r_id: res[CTValue, EvalFail] = eval_ident[T](c, cap_ctx, caps, source, e, node.span, interner);
        if (sel r_id.err) { ret r_id; }
        val v_id: CTValue = r_id.ok;
        if (v_id.kind == CT_KIND_CONST_ELEM) {
            ret evaluate_at_float_width[T](c, cap_ctx, caps, a, source, v_id.data.celem.elem::id.ExprId, interner, fw);
        }
        ret r_id;
    }

    if (k == expr.EXPR_KIND_COMPTIME_IDENT) {
        ret reject(COMPTIME_BARE_IDENT_MSG);
    }
    if (k == expr.EXPR_KIND_MEMBER) {
        if (is_comptime_path(a, e)) { ret eval_path(c, a, source, e, interner); }
        val cel: opt[res[CTValue, EvalFail]] =
            eval_const_elem_member[T](c, cap_ctx, caps, a, source, node.data.member.object, node.data.member.name, interner, fw);
        if (sel cel.some) { ret cel.some; }
        val fld: opt[res[CTValue, EvalFail]] =
            eval_field_member[T](c, cap_ctx, caps, a, source, node.data.member.object, node.data.member.name, interner);
        if (sel fld.some) { ret fld.some; }
        ret eval_module_member[T](cap_ctx, caps, e);
    }

    if (k == expr.EXPR_KIND_CALL) {
        val q: opt[res[CTValue, EvalFail]] = eval_type_query[T](c, cap_ctx, caps, a, source, e, interner);
        if (sel q.some) { ret q.some; }
        if (is_layout_intrinsic_call(a, source, e)) { ret eval_layout_intrinsic[T](cap_ctx, caps, a, source, e); }
        ret reject("function calls are not comptime-evaluable");
    }
    if (k == expr.EXPR_KIND_INDEX)      { ret reject("index expressions are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_CAST) {
        if (!capabilities_have_types[T](cap_ctx, caps)) {
            ret awaiting(EVAL_FAIL_NEEDS_TYPES, "a comptime cast requires its resolved source and destination types");
        }
        val operand: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, node.data.cast.value, interner);
        if (sel operand.err) { ret operand; }
        ret caps.cast(cap_ctx, e, operand.ok);
    }
    if (k == expr.EXPR_KIND_ARRAY_LIT)  { ret reject("array literals are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_STRUCT_LIT) { ret reject("struct literals are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_VECTOR_LIT) { ret reject("vector literals are not comptime-evaluable"); }
    if (k == expr.EXPR_KIND_ERROR)      { ret reject("expression has a parse error"); }

    if (k == expr.EXPR_KIND_PROJECT || k == expr.EXPR_KIND_SPREAD
        || k == expr.EXPR_KIND_STRIP || k == expr.EXPR_KIND_TYPE_REF
        || k == expr.EXPR_KIND_GENERIC_INSTANCE) { ret reject("expression is not comptime-evaluable"); }
    ret unknown_catalog(interner, "ExprKind", k::u32);
}

fun eval_layout_intrinsic[T](cap_ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, source: str, e: id.ExprId) res[CTValue, EvalFail] {
    if (!capabilities_have_types[T](cap_ctx, caps) || caps.layout == nil) {
        ret awaiting(EVAL_FAIL_NEEDS_LAYOUT, COMPTIME_LAYOUT_NO_RESOLVER_MSG);
    }
    val r: res[opt[CTValue], EvalFail] = caps.layout(cap_ctx, e::u32);
    if (sel r.err) {
        ret res[CTValue, EvalFail].err{r.err};
    }
    val ans: opt[CTValue] = r.ok;
    if (sel ans.none) {
        ret reject("this layout intrinsic has no value in this phase");
    }
    ret res[CTValue, EvalFail].ok{ans.some};
}

fun span_text(source: str, span: token.Span) View {
    ret view(?source[span.offset], span.len);
}

pub rec LitInt {
    value:    u64;
    suffix:   type.TypeKind;
    in_range: bool;
}

pub rec LitFloat {
    value:  f64;
    suffix: type.TypeKind;
}

val LIT_SUFFIX_INT_MSG: str =
    "unknown integer literal suffix: an integer literal takes `u8`, `u16`, `u32`, `u64`, `i8`, `i16`, `i32`, or `i64`; a float literal carries a fractional part or an exponent (`1.0f32`)";

val LIT_SUFFIX_FLOAT_MSG: str =
    "unknown float literal suffix: a float literal takes `f32` or `f64`";

val LIT_SUFFIX_RANGE_MSG: str =
    "integer literal is out of range for the type its suffix declares";

fun scan_lit_suffix(text: View, start: usize, want: type.PrimClass, unknown: str) res[type.TypeKind, fail.Fail] {
    if (start >= text.len) { ret res[type.TypeKind, fail.Fail].ok{expr.LIT_SUFFIX_NONE}; }
    val k_opt: opt[type.TypeKind] = type.prim_from_view(view(?text.data[start], text.len - start));
    if (!sel k_opt.some) { ret res[type.TypeKind, fail.Fail].err{fail.message(unknown)}; }
    val k: type.TypeKind = k_opt.some;
    if (type.prim_desc(k).class != want) { ret res[type.TypeKind, fail.Fail].err{fail.message(unknown)}; }
    ret res[type.TypeKind, fail.Fail].ok{k};
}

pub fun scan_lit_int(source: str, span: token.Span) res[LitInt, fail.Fail] {
    val text: View = span_text(source, span);
    if (text.len == 0) { ret res[LitInt, fail.Fail].err{fail.message("empty integer literal")}; }

    var i:     usize = 0;
    var base:  i64 = 10;

    if (text.len >= 2 && text.data[0] == '0') {
        if      (text.data[1] == 'x') { base = 16; i = 2; }
        or      (text.data[1] == 'b') { base = 2;  i = 2; }
        or      (text.data[1] == 'o') { base = 8;  i = 2; }
    }

    val u64_max: u64 = 0xFFFFFFFFFFFFFFFF;
    val base_u:  u64 = base:~u64;
    var value:   u64 = 0;
    var saw_digit: bool = false;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == '_') { i = i + 1; cnt; }

        var digit: i64 = 0 - 1;
        if      (c >= '0' && c <= '9') { digit = (c - '0')::i64; }
        or      (c >= 'a' && c <= 'f') { digit = (c - 'a')::i64 + 10; }
        or      (c >= 'A' && c <= 'F') { digit = (c - 'A')::i64 + 10; }

        if (digit >= 0 && digit < base) {
            val d: u64 = digit:~u64;
            if (value > (u64_max - d) / base_u) {
                ret res[LitInt, fail.Fail].err{fail.message("integer literal out of range")};
            }
            value = value * base_u + d;
            saw_digit = true;
            i = i + 1;
        }
        or (c == 'u' || c == 'i' || c == 'f') {
            brk;
        }
        or {
            if (base == 16) { ret res[LitInt, fail.Fail].err{fail.message("invalid digit in hexadecimal literal (expected 0-9, a-f, A-F)")}; }
            if (base == 2)  { ret res[LitInt, fail.Fail].err{fail.message("invalid digit in binary literal (expected 0 or 1)")}; }
            if (base == 8)  { ret res[LitInt, fail.Fail].err{fail.message("invalid digit in octal literal (expected 0-7)")}; }
            ret res[LitInt, fail.Fail].err{fail.message("invalid digit in decimal literal (expected 0-9)")};
        }
    }

    if (!saw_digit) { ret res[LitInt, fail.Fail].err{fail.message("integer literal has no digits")}; }

    val sfx_r: res[type.TypeKind, fail.Fail] = scan_lit_suffix(text, i, type.PRIM_CLASS_INT, LIT_SUFFIX_INT_MSG);
    if (sel sfx_r.err) { ret res[LitInt, fail.Fail].err{sfx_r.err}; }
    val sfx: type.TypeKind = sfx_r.ok;

    var lit: LitInt;
    lit.value    = value;
    lit.suffix   = sfx;
    lit.in_range = sfx == expr.LIT_SUFFIX_NONE || type.int_fits_either_sign(value, sfx);
    ret res[LitInt, fail.Fail].ok{lit};
}

pub fun eval_lit_int(source: str, span: token.Span) res[CTValue, EvalFail] {
    val lit_r: res[LitInt, fail.Fail] = scan_lit_int(source, span);
    if (sel lit_r.err) { ret reject(fail.describe(lit_r.err)); }
    val lit: LitInt = lit_r.ok;
    if (!lit.in_range) { ret reject(LIT_SUFFIX_RANGE_MSG); }

    val signed_max: u64 = 0x7FFFFFFFFFFFFFFF;
    val result: res[CTValue, EvalFail] = make_int_value(lit.value:~i64, lit.value > signed_max);
    if (sel result.err) { ret result; }
    var out: CTValue = result.ok;
    out.int_width = 64;
    if (lit.suffix != expr.LIT_SUFFIX_NONE) {
        val d: type.PrimDesc = type.prim_desc(lit.suffix);
        out.int_width    = d.bits::u8;
        out.int_unsigned = !d.signed;
    }
    ret res[CTValue, EvalFail].ok{out};
}

fun cmp_ratio_pow2(num: *bignum.Big, den: *bignum.Big, p: i64) i64 {
    var a: bignum.Big;
    var b: bignum.Big;
    bignum.copy(?a, num);
    bignum.copy(?b, den);
    if (p >= 0) { bignum.shl(?b, p::usize); }
    or { bignum.shl(?a, (0 - p)::usize); }
    ret bignum.cmp(?a, ?b);
}

fun decimal_to_f64(mant: *bignum.Big, exp10: i64, trunc: bool) u64 {
    if (bignum.is_zero(mant)) { ret 0; }

    val approx: i64 = exp10 + (bignum.bitlen(mant)::i64 * 1233) / 4096;
    if (approx > 320)  { ret 0x7FF0000000000000; }
    if (approx < -340) { ret 0; }

    var num: bignum.Big;
    var den: bignum.Big;
    bignum.copy(?num, mant);
    bignum.from_u64(?den, 1);
    if (exp10 >= 0) { bignum.mul_pow10(?num, exp10::usize); }
    or { bignum.mul_pow10(?den, (0 - exp10)::usize); }

    var e2: i64 = bignum.bitlen(?num)::i64 - bignum.bitlen(?den)::i64 - 53;
    var done: bool = false;
    for (!done) {
        if (cmp_ratio_pow2(?num, ?den, e2 + 53) >= 0) { e2 = e2 + 1; cnt; }
        if (cmp_ratio_pow2(?num, ?den, e2 + 52) < 0)  { e2 = e2 - 1; cnt; }
        done = true;
    }

    var lsb: i64 = e2;
    if (lsb < -1074) { lsb = -1074; }

    var nn: bignum.Big;
    var dd: bignum.Big;
    bignum.copy(?nn, ?num);
    bignum.copy(?dd, ?den);
    if (lsb >= 0) { bignum.shl(?dd, lsb::usize); }
    or { bignum.shl(?nn, (0 - lsb)::usize); }

    var q: u64 = 0;
    var rem: bignum.Big;
    bignum.copy(?rem, ?nn);
    var b: i64 = 53;
    for (b >= 0) {
        var t: bignum.Big;
        bignum.copy(?t, ?dd);
        bignum.shl(?t, b::usize);
        if (bignum.cmp(?rem, ?t) >= 0) {
            bignum.sub(?rem, ?t);
            q = q | (1::u64 << b::usize);
        }
        b = b - 1;
    }

    var rem2: bignum.Big;
    bignum.copy(?rem2, ?rem);
    bignum.shl(?rem2, 1);
    val c: i64 = bignum.cmp(?rem2, ?dd);
    if (c > 0) { q = q + 1; }
    or (c == 0) {
        if (trunc)             { q = q + 1; }
        or { if ((q & 1) == 1) { q = q + 1; } }
    }

    if (lsb == -1074) {
        ret q;
    }
    var biased: i64 = e2 + 1075;
    if (q == 0x20000000000000) {
        q = 0x10000000000000;
        biased = biased + 1;
    }
    if (biased >= 2047) { ret 0x7FF0000000000000; }
    ret (biased::u64 << 52) | (q & 0xFFFFFFFFFFFFF);
}

pub fun scan_lit_float(source: str, span: token.Span) res[LitFloat, fail.Fail] {
    val text: View = span_text(source, span);
    if (text.len == 0) { ret res[LitFloat, fail.Fail].err{fail.message("empty float literal")}; }

    var mant: bignum.Big;
    bignum.from_u64(?mant, 0);
    var dexp:      i64  = 0;
    var sig:       i64  = 0;
    var trunc:     bool = false;
    var saw_digit: bool = false;
    val MAX_SIG_DIGITS: i64 = 768;

    var i: usize = 0;
    for (i < text.len) {
        val c: u8 = text.data[i];
        if (c == '_')             { i = i + 1; cnt; }
        if (c == '.')             { brk; }
        if (c == 'e' || c == 'E') { brk; }
        if (c == 'f')             { brk; }
        if (c < '0' || c > '9')   { ret res[LitFloat, fail.Fail].err{fail.message("invalid character in float literal")}; }
        saw_digit = true;
        if (sig < MAX_SIG_DIGITS) {
            bignum.mul_small(?mant, 10);
            bignum.add_small(?mant, (c - '0')::u32);
            if (!bignum.is_zero(?mant)) { sig = sig + 1; }
        }
        or {
            dexp = dexp + 1;
            if (c != '0') { trunc = true; }
        }
        i = i + 1;
    }

    if (i < text.len && text.data[i] == '.') {
        i = i + 1;
        for (i < text.len) {
            val c: u8 = text.data[i];
            if (c == '_')             { i = i + 1; cnt; }
            if (c == 'e' || c == 'E') { brk; }
            if (c == 'f')             { brk; }
            if (c < '0' || c > '9')   { ret res[LitFloat, fail.Fail].err{fail.message("invalid character in float literal")}; }
            saw_digit = true;
            if (sig < MAX_SIG_DIGITS) {
                bignum.mul_small(?mant, 10);
                bignum.add_small(?mant, (c - '0')::u32);
                if (!bignum.is_zero(?mant)) { sig = sig + 1; }
                dexp = dexp - 1;
            }
            or {
                if (c != '0') { trunc = true; }
            }
            i = i + 1;
        }
    }

    var exp: i64 = 0;
    if (i < text.len && (text.data[i] == 'e' || text.data[i] == 'E')) {
        i = i + 1;
        var neg: bool = false;
        if (i < text.len && text.data[i] == '-') { neg = true; i = i + 1; }
        or (i < text.len && text.data[i] == '+') { i = i + 1; }

        var saw_exp_digit: bool = false;
        for (i < text.len) {
            val c: u8 = text.data[i];
            if (c == 'f')           { brk; }
            if (c == '_')           { i = i + 1; cnt; }
            if (c < '0' || c > '9') { ret res[LitFloat, fail.Fail].err{fail.message("invalid character in float exponent")}; }
            if (exp < 1000000) { exp = exp * 10 + (c - '0')::i64; }
            saw_exp_digit = true;
            i = i + 1;
        }
        if (!saw_exp_digit) { ret res[LitFloat, fail.Fail].err{fail.message("missing digits in float exponent")}; }
        if (neg)            { exp = 0 - exp; }
    }

    if (!saw_digit) { ret res[LitFloat, fail.Fail].err{fail.message("float literal has no digits")}; }

    val sfx_r: res[type.TypeKind, fail.Fail] = scan_lit_suffix(text, i, type.PRIM_CLASS_FLOAT, LIT_SUFFIX_FLOAT_MSG);
    if (sel sfx_r.err) { ret res[LitFloat, fail.Fail].err{sfx_r.err}; }
    val sfx: type.TypeKind = sfx_r.ok;

    val bits: u64 = decimal_to_f64(?mant, dexp + exp, trunc);

    var lit: LitFloat;
    lit.value  = float.round_at(float.bits_f64(bits), type.float_width_of(sfx));
    lit.suffix = sfx;
    ret res[LitFloat, fail.Fail].ok{lit};
}

pub fun eval_lit_float(source: str, span: token.Span) res[CTValue, EvalFail] {
    val lit_r: res[LitFloat, fail.Fail] = scan_lit_float(source, span);
    if (sel lit_r.err) { ret reject(fail.describe(lit_r.err)); }
    val lit: LitFloat = lit_r.ok;
    ret res[CTValue, EvalFail].ok{ct_float(lit.value, type.float_width_of(lit.suffix))};
}

pub fun eval_lit_char(source: str, span: token.Span) res[CTValue, EvalFail] {
    val text: View = span_text(source, span);
    if (text.len < 3) { ret reject("malformed character literal"); }
    if (text.data[0] != '\'' || text.data[text.len - 1] != '\'') {
        ret reject("character literal not delimited by single quotes");
    }

    val inner: View = view(?text.data[1], text.len - 2);

    val r: res[u8, fail.Fail] = decode_char(inner);
    if (sel r.err) {
        ret reject(fail.describe(r.err));
    }

    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 8;
    v.data.i       = r.ok::i64;
    ret res[CTValue, EvalFail].ok{v};
}

pub fun eval_lit_str(source: str, span: token.Span, interner: *intern.Interner) res[CTValue, EvalFail] {
    val text: View = span_text(source, span);
    if (text.len < 2) { ret reject("malformed string literal"); }

    val open: u8 = text.data[0];
    if (open != '"') {
        ret reject("string literal not delimited");
    }
    if (text.data[text.len - 1] != open) {
        ret reject("string literal missing closing delimiter");
    }

    val inner: View = view(?text.data[1], text.len - 2);

    val s_r: res[intern.StrId, EvalFail] = intern_decoded(interner, inner);
    if (sel s_r.err) {
        ret res[CTValue, EvalFail].err{s_r.err};
    }

    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = s_r.ok;
    ret res[CTValue, EvalFail].ok{v};
}

fun intern_decoded(interner: *intern.Interner, inner: View) res[intern.StrId, EvalFail] {
    val has_escape: bool = view_contains_char(inner, '\\');
    if (!has_escape) {
        ret eval_refused_result[intern.StrId](intern.intern_bytes(interner, inner.data::str, inner.len));
    }

    val r_buf: res[*u8, A.Error] = A.allocate[u8](interner.a, inner.len);
    if (sel r_buf.err) {
        ret res[intern.StrId, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, alloc.text(r_buf.err))};
    }
    val buf: *u8 = r_buf.ok;

    var read:  usize = 0;
    var write: usize = 0;
    for (read < inner.len) {
        val c: u8 = inner.data[read];
        if (c != '\\') {
            buf[write] = c;
            read  = read + 1;
            write = write + 1;
            cnt;
        }
        if (read + 1 >= inner.len) {
            A.deallocate[u8](interner.a, buf, inner.len);
            ret res[intern.StrId, EvalFail].err{eval_error(EVAL_FAIL_REJECTED, "stray backslash at end of string literal")};
        }
        var consumed: usize = 0;
        val esc_r: res[u8, fail.Fail] = decode_escape((?inner.data[read])::*u8, inner.len - read, ?consumed);
        if (sel esc_r.err) {
            A.deallocate[u8](interner.a, buf, inner.len);
            ret res[intern.StrId, EvalFail].err{eval_error(EVAL_FAIL_REJECTED, fail.describe(esc_r.err))};
        }
        buf[write] = esc_r.ok;
        read  = read + consumed;
        write = write + 1;
    }

    val id_r: res[intern.StrId, A.Error] = intern.intern_bytes(interner, buf::str, write);
    A.deallocate[u8](interner.a, buf, inner.len);
    ret eval_refused_result[intern.StrId](id_r);
}

fun decode_char(inner: View) res[u8, fail.Fail] {
    if (inner.len == 0) { ret res[u8, fail.Fail].err{fail.message("empty character literal; must contain exactly one character or escape")}; }
    if (inner.data[0] != '\\') {
        if (inner.len != 1) { ret res[u8, fail.Fail].err{fail.message("character literal must contain exactly one character")}; }
        ret res[u8, fail.Fail].ok{inner.data[0]};
    }
    var consumed: usize = 0;
    val r: res[u8, fail.Fail] = decode_escape(inner.data::*u8, inner.len, ?consumed);
    if (sel r.err) { ret r; }
    if (consumed != inner.len) {
        ret res[u8, fail.Fail].err{fail.message("character literal must contain exactly one escape sequence")};
    }
    ret r;
}

fun decode_escape(p: *u8, len: usize, out_consumed: *usize) res[u8, fail.Fail] {
    if (len < 2) { ret res[u8, fail.Fail].err{fail.message("incomplete escape sequence")}; }
    val c: u8 = p[1];

    if (c == 'n')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{10}; }
    if (c == 't')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{9}; }
    if (c == 'r')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{13}; }
    if (c == '\\') { @out_consumed = 2; ret res[u8, fail.Fail].ok{92}; }
    if (c == '\'') { @out_consumed = 2; ret res[u8, fail.Fail].ok{39}; }
    if (c == '"')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{34}; }
    if (c == '0')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{0}; }
    if (c == 'x') {
        if (len < 4) { ret res[u8, fail.Fail].err{fail.message("incomplete \\x escape")}; }
        val hi: i64 = hex_digit(p[2]);
        val lo: i64 = hex_digit(p[3]);
        if (hi < 0 || lo < 0) { ret res[u8, fail.Fail].err{fail.message("invalid \\x escape")}; }
        @out_consumed = 4;
        ret res[u8, fail.Fail].ok{(hi * 16 + lo)::u8};
    }
    ret res[u8, fail.Fail].err{fail.message("unknown escape sequence (valid: \\n \\t \\r \\\\ \\' \\\" \\0 \\xHH)")};
}

fun hex_digit(c: u8) i64 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i64; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i64 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i64 + 10; }
    ret 0 - 1;
}

fun eval_binary[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    eid:      id.ExprId,
    bin:      *expr.ExprBinary,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[CTValue, EvalFail] {
    if (bin.op > expr.BIN_ASSIGN) { ret unknown_catalog(interner, "BinOp", bin.op::u32); }
    if (bin.op == expr.BIN_ASSIGN) { ret reject("assignment is not comptime-evaluable"); }

    if (bin.op == expr.BIN_AND || bin.op == expr.BIN_OR) {
        ret eval_logical[T](c, cap_ctx, caps, a, source, bin, interner);
    }

    if (bin.op == expr.BIN_EQ || bin.op == expr.BIN_NEQ) {
        var type_comparison: bool = is_type_comparison(a, source, bin);
        if (!type_comparison) {
            val l: res[bool, EvalFail] = field_type_eval_operand[T](c, cap_ctx, caps, a, source, bin.lhs, interner);
            if (sel l.err) { ret res[CTValue, EvalFail].err{l.err}; }
            type_comparison = l.ok;
        }
        if (!type_comparison) {
            val r: res[bool, EvalFail] = field_type_eval_operand[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
            if (sel r.err) { ret res[CTValue, EvalFail].err{r.err}; }
            type_comparison = r.ok;
        }
        if (type_comparison) { ret eval_type_comparison[T](c, cap_ctx, caps, a, source, bin, interner); }
    }

    var operand_fw: float.FloatWidth = fw;
    if (bin.op == expr.BIN_EQ || bin.op == expr.BIN_NEQ
     || bin.op == expr.BIN_LT || bin.op == expr.BIN_LEQ
     || bin.op == expr.BIN_GT || bin.op == expr.BIN_GEQ) {
        operand_fw = float.FLOAT_W_NONE;
    }

    val lhs_r: res[CTValue, EvalFail] = evaluate_at_float_width[T](c, cap_ctx, caps, a, source, bin.lhs, interner, operand_fw);
    if (sel lhs_r.err) { ret lhs_r; }
    val rhs_r: res[CTValue, EvalFail] = evaluate_at_float_width[T](c, cap_ctx, caps, a, source, bin.rhs, interner, operand_fw);
    if (sel rhs_r.err) { ret rhs_r; }

    val lhs: CTValue = lhs_r.ok;
    val rhs: CTValue = rhs_r.ok;

    if (bin.op == expr.BIN_EQ || bin.op == expr.BIN_NEQ) {
        ret apply_equality(bin.op, lhs, rhs);
    }
    if (bin.op == expr.BIN_LT || bin.op == expr.BIN_LEQ
     || bin.op == expr.BIN_GT || bin.op == expr.BIN_GEQ) {
        ret apply_compare(bin.op, lhs, rhs);
    }
    val result: res[CTValue, EvalFail] = apply_arith(bin.op, lhs, rhs);
    if (sel result.err) { ret result; }
    if ((bin.op == expr.BIN_BIT_AND || bin.op == expr.BIN_BIT_OR || bin.op == expr.BIN_BIT_XOR)
        && capabilities_have_types[T](cap_ctx, caps)) {
        ret caps.scalar(cap_ctx, eid, result.ok);
    }
    ret result;
}

fun eval_unary[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    un:       *expr.ExprUnary,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[CTValue, EvalFail] {
    if (un.op > expr.UN_DEREF) { ret unknown_catalog(interner, "UnOp", un.op::u32); }
    if (un.op == expr.UN_ADDR || un.op == expr.UN_DEREF) {
        ret reject("address-of and dereference are not comptime-evaluable");
    }

    val r: res[CTValue, EvalFail] = evaluate_at_float_width[T](c, cap_ctx, caps, a, source, un.operand, interner, fw);
    if (sel r.err) { ret r; }
    var v: CTValue = r.ok;
    if (un.op == expr.UN_BIT_NOT && capabilities_have_types[T](cap_ctx, caps)) {
        val typed: res[CTValue, EvalFail] = checked_value(interner, caps.scalar(cap_ctx, un.operand, v));
        if (sel typed.err) { ret typed; }
        v = typed.ok;
    }

    if (un.op == expr.UN_NEG) {
        if (v.kind == CT_KIND_INT)   { ret ct_negate(v); }
        if (v.kind == CT_KIND_FLOAT) { ret float_value(float.f64_neg(v.data.f), v.float_width); }
        ret reject("unary - requires a numeric operand");
    }
    if (un.op == expr.UN_NOT) {
        if (v.kind != CT_KIND_INT || (v.int_width != 0 && !is_u8(v))) {
            ret reject("unary ! requires a u8 operand");
        }
        var out: CTValue = ct_u8(if_u8(v.data.i != 1));
        if (v.int_width == 0) { out.int_width = 0; }
        ret res[CTValue, EvalFail].ok{out};
    }
    if (un.op == expr.UN_BIT_NOT) {
        if (v.kind != CT_KIND_INT) { ret reject("unary ~ requires an integer operand"); }
        if (v.int_width == 0) { ret make_int_value(~v.data.i, v.int_unsigned); }
        ret cast_int(~v.data.i, v.int_width::u32, !v.int_unsigned);
    }
    ret reject("unsupported unary operator");
}

fun cast_int(bits: i64, width: u32, signed: bool) res[CTValue, EvalFail] {
    if (width == 0 || width > 64) { ret internal_failure("comptime scalar cast has an invalid integer width"); }
    var value: i64 = bits;
    if (width < 64) {
        val shift: u64 = (64 - width)::u64;
        val masked: u64 = (bits:~u64 << shift) >> shift;
        value = masked:~i64;
        if (signed) { value = (value << shift) >> shift; }
    }
    var out: CTValue;
    out.kind = CT_KIND_INT;
    out.int_unsigned = !signed;
    out.int_width = width::u8;
    out.data.i = value;
    ret res[CTValue, EvalFail].ok{out};
}

fun cast_desc(types: *type.TypeInterner, tid: type.TypeId, pointer_width: u32) res[type.PrimDesc, EvalFail] {
    val found: opt[*type.Type] = type.get(types, type.strip_secret(types, tid));
    if (!sel found.some) {
        ret res[type.PrimDesc, EvalFail].err{eval_error(EVAL_FAIL_NEEDS_TYPES, "comptime cast type is not resolved")};
    }
    val kind: type.TypeKind = found.some.kind;
    var desc: type.PrimDesc = type.prim_desc(kind);
    if (kind == type.TYPE_PTR || kind == type.TYPE_POINTER || kind == type.TYPE_FUN) {
        desc.class = type.PRIM_CLASS_PTR;
        desc.bits = pointer_width * 8;
        desc.signed = false;
    }
    if (desc.class == type.PRIM_CLASS_NONE) {
        ret res[type.PrimDesc, EvalFail].err{eval_error(EVAL_FAIL_REJECTED, "comptime casts require scalar types")};
    }
    ret res[type.PrimDesc, EvalFail].ok{desc};
}

pub fun cast_scalar(types: *type.TypeInterner, pointer_width: u32, value: CTValue,
                    from_ty: type.TypeId, to_ty: type.TypeId, reinterpret: bool) res[CTValue, EvalFail] {
    val from_r: res[type.PrimDesc, EvalFail] = cast_desc(types, from_ty, pointer_width);
    if (sel from_r.err) { ret res[CTValue, EvalFail].err{from_r.err}; }
    val to_r: res[type.PrimDesc, EvalFail] = cast_desc(types, to_ty, pointer_width);
    if (sel to_r.err) { ret res[CTValue, EvalFail].err{to_r.err}; }
    val from: type.PrimDesc = from_r.ok;
    val to: type.PrimDesc = to_r.ok;
    val representation: bool = reinterpret || from.class == type.PRIM_CLASS_PTR || to.class == type.PRIM_CLASS_PTR;
    if (representation && from.bits != to.bits) { ret reject("comptime bit reinterpret requires equal source and destination sizes"); }
    if (value.kind == CT_KIND_STR && from.class == type.PRIM_CLASS_PTR && to.class == type.PRIM_CLASS_PTR) {
        ret res[CTValue, EvalFail].ok{value};
    }
    val from_float: bool = from.class == type.PRIM_CLASS_FLOAT;
    val to_float: bool = to.class == type.PRIM_CLASS_FLOAT;
    if ((from_float && value.kind != CT_KIND_FLOAT) || (!from_float && value.kind != CT_KIND_INT)) {
        ret reject("comptime cast operand is not a scalar value of its source type");
    }
    var fw: float.FloatWidth = float.FLOAT_W_64;
    if (to.bits == 32) { fw = float.FLOAT_W_32; }
    if (from_float) {
        var source_fw: float.FloatWidth = float.FLOAT_W_64;
        if (from.bits == 32) { source_fw = float.FLOAT_W_32; }
        val source_r: res[CTValue, EvalFail] = float_value(value.data.f, source_fw);
        if (sel source_r.err) { ret source_r; }
        val source_value: f64 = source_r.ok.data.f;
        if (to_float) { ret float_value(source_value, fw); }
        if (representation) {
            if (from.bits == 32) { ret cast_int(((source_value::f32):~u32)::i64, to.bits, to.signed); }
            ret cast_int(source_value:~i64, to.bits, to.signed);
        }
        if (to.signed) { ret cast_int(source_value::i64, to.bits, true); }
        ret cast_int((source_value::u64):~i64, to.bits, false);
    }
    val source_r: res[CTValue, EvalFail] = cast_int(value.data.i, from.bits, from.signed);
    if (sel source_r.err) { ret source_r; }
    val source_value: i64 = source_r.ok.data.i;
    if (!to_float) { ret cast_int(source_value, to.bits, to.signed); }
    if (representation) {
        if (to.bits == 32) { ret float_value(((source_value:~u64)::u32):~f32::f64, fw); }
        ret float_value(source_value:~f64, fw);
    }
    if (from.signed) { ret float_value(source_value::f64, fw); }
    ret float_value((source_value:~u64)::f64, fw);
}

fun eval_logical[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    bin:      *expr.ExprBinary,
    interner: *intern.Interner
) res[CTValue, EvalFail] {
    val lhs_r: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, bin.lhs, interner);
    if (sel lhs_r.err) { ret lhs_r; }
    val lhs: CTValue = lhs_r.ok;
    if (lhs.kind != CT_KIND_INT || (lhs.int_width != 0 && !is_u8(lhs))) {
        ret reject("logical operator requires u8 operands");
    }

    if ((bin.op == expr.BIN_AND && lhs.data.i != 1) || (bin.op == expr.BIN_OR && lhs.data.i == 1)) {
        ret short_circuit[T](c, cap_ctx, caps, a, source, bin, interner, lhs);
    }

    val rhs_r: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
    if (sel rhs_r.err) { ret rhs_r; }
    val rhs: CTValue = rhs_r.ok;
    if (rhs.kind != CT_KIND_INT || (rhs.int_width != 0 && !is_u8(rhs))) {
        ret reject("logical operator requires u8 operands");
    }

    var out: CTValue = ct_u8(if_u8(rhs.data.i == 1));
    if (lhs.int_width == 0 || rhs.int_width == 0) { out.int_width = 0; }
    ret res[CTValue, EvalFail].ok{out};
}

fun short_circuit[T](
    c: *ComptimeCtx, cap_ctx: *T, caps: PhaseCapabilities[T], a: *ast.Ast, source: str,
    bin: *expr.ExprBinary, interner: *intern.Interner, lhs: CTValue,
) res[CTValue, EvalFail] {
    var out: CTValue = ct_u8(if_u8(bin.op == expr.BIN_OR));
    out.int_width = lhs.int_width;
    val rhs_r: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
    if (sel rhs_r.err) {
        if (rhs_r.err.kind == EVAL_FAIL_INTERNAL) { ret rhs_r; }
        ret res[CTValue, EvalFail].ok{out};
    }
    val rhs: CTValue = rhs_r.ok;
    if (rhs.kind != CT_KIND_INT || (rhs.int_width != 0 && !is_u8(rhs))) {
        ret reject("logical operator requires u8 operands");
    }
    if (rhs.int_width == 0) { out.int_width = 0; }
    ret res[CTValue, EvalFail].ok{out};
}

fun is_comptime_call(a: *ast.Ast, source: str, eid: id.ExprId, name: str) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val n_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret false; }
    val node: *expr.Expr = n_opt.some;
    if (node.kind != expr.EXPR_KIND_CALL) { ret false; }
    val ce_opt: opt[*expr.Expr] = ast.get_expr(a, node.data.call.callee);
    if (!sel ce_opt.some) { ret false; }
    val ce: *expr.Expr = ce_opt.some;
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret false; }
    val ns: token.Span = comptime_ident_name(ce.span);
    if (ns.len == 0) { ret false; }
    ret view_eq_str(span_text(source, ns), name);
}

fun first_call_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    if (eid == id.EXPR_NIL) { ret id.EXPR_NIL; }
    val n_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret id.EXPR_NIL; }
    val node: *expr.Expr = n_opt.some;
    if (node.kind != expr.EXPR_KIND_CALL) { ret id.EXPR_NIL; }
    if (node.data.call.args_len < 1)      { ret id.EXPR_NIL; }
    ret a.expr_ids[node.data.call.args_start];
}

pub fun intrinsic_takes_type_operand(source: str, full: token.Span) bool {
    val ns: token.Span = comptime_ident_name(full);
    if (ns.len == 0) { ret false; }
    val text: View = span_text(source, ns);
    ret view_eq_str(text, "size_of")
     || view_eq_str(text, "length_of")
     || view_eq_str(text, "align_of")
     || view_eq_str(text, "offset_of")
     || view_eq_str(text, "fields")
     || view_eq_str(text, "cases")
     || view_eq_str(text, "is_record")
     || view_eq_str(text, "is_union")
     || view_eq_str(text, "is_tag")
     || view_eq_str(text, "is_pointer")
     || view_eq_str(text, "is_secret")
     || view_eq_str(text, "type_name");
}

pub fun is_type_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "type_of");
}

pub fun type_of_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    ret first_call_arg(a, eid);
}

pub fun is_fields_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "fields");
}

pub fun is_cases_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "cases");
}

# `$fields(T)` and `$cases(T)` are the two descriptor sequences a `$each` walks
pub fun is_descriptor_seq_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_fields_call(a, source, eid) || is_cases_call(a, source, eid);
}

pub fun is_descriptor(v: CTValue) bool {
    ret v.kind == CT_KIND_FIELD || v.kind == CT_KIND_CASE;
}

pub fun comptime_if_declares_nothing(a: *ast.Ast, branches_start: u32, branches_len: u32) bool {
    var bi: u32 = 0;
    for (bi < branches_len) {
        val branch_ix: u32 = branches_start + bi;
        if (branch_ix::usize >= a.comptime_branch_len) { ret false; }
        val br: *decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
        var di: u32 = 0;
        for (di < br.body_len) {
            val pool_ix: u32 = br.body_start + di;
            if (pool_ix::usize >= a.decl_id_len) { ret false; }
            if (!decl_declares_nothing(a, a.decl_ids[pool_ix])) { ret false; }
            di = di + 1;
        }
        bi = bi + 1;
    }
    ret true;
}

fun decl_declares_nothing(a: *ast.Ast, did: id.DeclId) bool {
    val d_opt: opt[*decl.Decl] = ast.get_decl(a, did);
    if (!sel d_opt.some) { ret false; }
    val d: *decl.Decl = d_opt.some;
    if (d.kind == decl.DECL_KIND_COMPTIME_ATTR) { ret true; }
    if (d.kind == decl.DECL_KIND_COMPTIME_IF) {
        ret comptime_if_declares_nothing(a, d.data.comptime_if.branches_start, d.data.comptime_if.branches_len);
    }
    ret false;
}

pub def GateProbe: u8;

pub val GATE_PROBE_COMPTIME_PARAM:   GateProbe = 0;
pub val GATE_PROBE_LAYOUT_INTRINSIC: GateProbe = 1;
pub val GATE_PROBE_TYPE_COMPARISON:  GateProbe = 2;
pub val GATE_PROBE_FIELD_DESCRIPTOR: GateProbe = 3;
pub val GATE_PROBE_EACH_LOOPVAR:     GateProbe = 4;
pub val GATE_PROBE_TARGET_DEPENDENT: GateProbe = 5;
pub val GATE_PROBE_NODE_ACTION:      GateProbe = 6;

pub val GATE_PROBE_COUNT: u32 = 5;

pub def GateNodeVerdict: u8;

pub val GATE_NODE_NO:    GateNodeVerdict = 0;
pub val GATE_NODE_YES:   GateNodeVerdict = 1;
pub val GATE_NODE_PRUNE: GateNodeVerdict = 2;

pub val GATE_PROBE_UNLISTED_KIND_MSG: str =
    "internal: this expression kind has no entry in the compile-time dependency visitor; a gate that nests it cannot be scanned for dependencies";

pub val GATE_PROBE_NO_OBSERVER_MSG: str =
    "internal: this phase did not supply the observer a compile-time dependency probe needs";

pub rec GateProbes[T] {
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail];
    comptime_param:     fun(*T, id.ExprId) bool;
    each_loopvar:       fun(*T, id.ExprId) bool;
    field_loopvar:      fun(*T, id.ExprId) bool;
    field_type_operand: fun(*T, id.ExprId) bool;
    node_action:        fun(*T, id.ExprId, *expr.Expr) GateNodeVerdict;
}

pub fun gate_probes[T](
    comptime_param:     fun(*T, id.ExprId) bool,
    each_loopvar:       fun(*T, id.ExprId) bool,
    field_loopvar:      fun(*T, id.ExprId) bool,
    field_type_operand: fun(*T, id.ExprId) bool,
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail]
) GateProbes[T] {
    var p: GateProbes[T];
    p.expression = expression;
    p.comptime_param     = comptime_param;
    p.each_loopvar       = each_loopvar;
    p.field_loopvar      = field_loopvar;
    p.field_type_operand = field_type_operand;
    p.node_action        = nil;
    ret p;
}

pub fun gate_node_action_probes[T](action: fun(*T, id.ExprId, *expr.Expr) GateNodeVerdict,
    expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail]) GateProbes[T] {
    var p: GateProbes[T] = gate_probes[T](nil, nil, nil, nil, expression);
    p.node_action = action;
    ret p;
}

pub fun gate_walk[T](a: *ast.Ast, source: str, obs: *T,
                     action: fun(*T, id.ExprId, *expr.Expr) GateNodeVerdict,
                     expression: fun(*T, *ast.Ast, id.ExprId) res[expr.Expr, EvalFail],
                     eid: id.ExprId) res[bool, fail.Fail] {
    ret gate_depends_on[T](a, source, obs, gate_node_action_probes[T](action, expression), GATE_PROBE_NODE_ACTION, eid);
}

pub fun gate_chain_depends_on[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    branches_start: u32, branches_len: u32
) res[bool, fail.Fail] {
    var bi: u32 = 0;
    for (bi < branches_len) {
        val branch_ix: u32 = branches_start + bi;
        if (branch_ix::usize >= a.comptime_branch_len) {
            ret res[bool, fail.Fail].err{fail.message("comptime branch index out of range in the dependency visitor")};
        }
        val br: *decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
        if (br.cond != id.EXPR_NIL) {
            val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, br.cond);
            if (sel depends_r.err)    { ret depends_r; }
            if (depends_r.ok) { ret depends_r; }
        }
        bi = bi + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

pub fun gate_needs_typed_selection(a: *ast.Ast, source: str, eid: id.ExprId) res[bool, fail.Fail] {
    ret gate_depends_on[NoCapabilityContext](a, source, nil,
        gate_probes[NoCapabilityContext](nil, nil, nil, nil, parsed_expression[NoCapabilityContext]),
        GATE_PROBE_TARGET_DEPENDENT, eid);
}

pub def GateScope: u8;

pub val GATE_SCOPE_DECL:     GateScope = 0;
pub val GATE_SCOPE_INSTANCE: GateScope = 1;

pub val GATE_U8_MSG: str =
    "comptime branch condition must have type u8";

pub val GATE_U8_FLOAT_MSG: str =
    "comptime branch condition must have type u8, found float";

pub val GATE_U8_STR_MSG: str =
    "comptime branch condition must have type u8, found str";

pub rec GateVerdict {
    outcome: GateOutcome;
    fail:    EvalFailKind;
    message: str;
    span:    token.Span;
    depends: intern.StrId;
    value:   CTValue;
}

fun gate_verdict(outcome: GateOutcome, message: str, span: token.Span, depends: intern.StrId) GateVerdict {
    var v: GateVerdict;
    v.outcome = outcome;
    v.fail    = EVAL_FAIL_NONE;
    v.message = message;
    v.span    = span;
    v.depends = depends;
    v.value.kind      = CT_KIND_INT;
    v.value.int_width = 0;
    v.value.data.i    = 0;
    ret v;
}

fun gate_verdict_valued(outcome: GateOutcome, span: token.Span, value: CTValue) GateVerdict {
    var v: GateVerdict = gate_verdict(outcome, "", span, intern.STR_NIL);
    v.value = value;
    ret v;
}

fun gate_failure_awaits_phase[T](cap_ctx: *T, caps: PhaseCapabilities[T], kind: EvalFailKind) bool {
    if (kind == EVAL_FAIL_NEEDS_MEMBER) {
        ret !capabilities_have_member[T](cap_ctx, caps);
    }
    if (kind == EVAL_FAIL_NEEDS_TYPES || kind == EVAL_FAIL_NEEDS_LAYOUT) {
        ret !capabilities_have_types[T](cap_ctx, caps);
    }
    ret false;
}

fun gate_verdict_failed(outcome: GateOutcome, f: EvalFail, span: token.Span, depends: intern.StrId) GateVerdict {
    var v: GateVerdict = gate_verdict(outcome, f.message, span, depends);
    v.fail = f.kind;
    ret v;
}

fun gate_u8_message(v: CTValue) str {
    if (v.kind == CT_KIND_FLOAT) { ret GATE_U8_FLOAT_MSG; }
    if (v.kind == CT_KIND_STR)   { ret GATE_U8_STR_MSG; }
    ret GATE_U8_MSG;
}

rec GateNameProbe[T] {
    cap_ctx: *T;
    caps: PhaseCapabilities[T];
    failure: err[fail.Fail];
    c:        *ComptimeCtx;
    source:   str;
    interner: *intern.Interner;
    found:    intern.StrId;
}

fun gate_name_probe_node[T](g: *GateNameProbe[T], eid: id.ExprId, e: *expr.Expr) GateNodeVerdict {
    if (g.found != intern.STR_NIL) { ret GATE_NODE_PRUNE; }
    val failed: bool = sel g.failure.err;
    if (failed) { ret GATE_NODE_PRUNE; }
    if (e.kind != expr.EXPR_KIND_IDENT) { ret GATE_NODE_NO; }
    val r: res[intern.StrId, A.Error] = intern.intern_span(g.interner, g.source, e.span);
    if (sel r.err) { g.failure = err[fail.Fail].err{fail.refused(r.err)}; ret GATE_NODE_PRUNE; }
    val name: intern.StrId = r.ok;
    val bound: opt[NamedConst] = lookup(g.c, name);
    if (sel bound.some) { ret GATE_NODE_NO; }
    g.found = name;
    ret GATE_NODE_PRUNE;
}

fun gate_name_expression[T](g: *GateNameProbe[T], a: *ast.Ast, eid: id.ExprId) res[expr.Expr, EvalFail] {
    ret read_expression[T](g.cap_ctx, g.caps, a, eid);
}

pub fun gate_unresolved_dependency[T](c: *ComptimeCtx, cap_ctx: *T, caps: PhaseCapabilities[T],
    a: *ast.Ast, source: str, interner: *intern.Interner, cond: id.ExprId) res[intern.StrId, fail.Fail] {
    if (c == nil || interner == nil) { ret res[intern.StrId, fail.Fail].err{fail.message("gate dependency name has no active context")}; }
    var g: GateNameProbe[T];
    g.cap_ctx  = cap_ctx;
    g.caps     = caps;
    g.failure  = err[fail.Fail].ok{};
    g.c        = c;
    g.source   = source;
    g.interner = interner;
    g.found    = intern.STR_NIL;
    val matched_r: res[bool, fail.Fail] = gate_walk[GateNameProbe[T]](a, source, ?g,
        gate_name_probe_node[T], gate_name_expression[T], cond);
    if (sel matched_r.err) { ret res[intern.StrId, fail.Fail].err{matched_r.err}; }
    if (sel g.failure.err) { ret res[intern.StrId, fail.Fail].err{g.failure.err}; }
    ret res[intern.StrId, fail.Fail].ok{g.found};
}

pub fun evaluate_gate[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    cond:     id.ExprId,
    interner: *intern.Interner,
    scope:    GateScope,
    cache:    bool,
    terminal: bool
) res[GateVerdict, fail.Fail] {
    var nil_span: token.Span;
    nil_span.offset = 0;
    nil_span.len    = 0;
    if (cond == id.EXPR_NIL) {
        ret res[GateVerdict, fail.Fail].ok{gate_verdict(GATE_ACTIVE, "", nil_span, intern.STR_NIL)};
    }
    val e_opt: opt[*expr.Expr] = ast.get_expr(a, cond);
    if (!sel e_opt.some) {
        ret res[GateVerdict, fail.Fail].err{fail.message("comptime branch cond ExprId out of range")};
    }
    val span: token.Span = e_opt.some.span;

    val cacheable: bool = cache;
    if (cacheable) {
        val cached: GateState = gate_state(c, cond);
        if (cached == GATE_STATE_TRUE) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict(GATE_ACTIVE, "", span, intern.STR_NIL)};
        }
        if (cached == GATE_STATE_FALSE) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict(GATE_INACTIVE, "", span, intern.STR_NIL)};
        }
        if (cached == GATE_STATE_REJECTED) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict(GATE_REJECTED, "", span, intern.STR_NIL)};
        }
    }
    or (gate_state(c, cond) == GATE_STATE_REJECTED) {
        ret res[GateVerdict, fail.Fail].ok{gate_verdict(GATE_REJECTED, "", span, intern.STR_NIL)};
    }

    val r: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, cond, interner);
    if (sel r.err) {
        val f: EvalFail = r.err;
        if (f.kind == EVAL_FAIL_INTERNAL) { ret res[GateVerdict, fail.Fail].err{fail.message(f.message)}; }
        if (f.kind == EVAL_FAIL_NEEDS_LAYOUT && scope == GATE_SCOPE_DECL) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_AWAITING_LAYOUT, f, span, intern.STR_NIL)};
        }
        if (scope == GATE_SCOPE_INSTANCE && gate_eval_failure_is_transient(f.kind)) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_AWAITING_PHASE, f, span, intern.STR_NIL)};
        }
        if (gate_failure_awaits_phase[T](cap_ctx, caps, f.kind)) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_AWAITING_PHASE, f, span, intern.STR_NIL)};
        }
        val depends_r: res[intern.StrId, fail.Fail] = gate_unresolved_dependency[T](c, cap_ctx, caps, a, source, interner, cond);
        if (sel depends_r.err) { ret res[GateVerdict, fail.Fail].err{depends_r.err}; }
        val depends: intern.StrId = depends_r.ok;
        if (!terminal) {
            ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_DEFERRED, f, span, depends)};
        }
        ret res[GateVerdict, fail.Fail].ok{gate_verdict_failed(GATE_FAILED, f, span, depends)};
    }

    val v: CTValue = r.ok;
    if (v.kind != CT_KIND_INT || (v.int_width != 0 && !is_u8(v))) {
        if (cacheable) { set_gate_state(c, cond, GATE_STATE_REJECTED); }
        var rej: GateVerdict = gate_verdict(GATE_REJECTED, gate_u8_message(v), span, intern.STR_NIL);
        rej.value = v;
        ret res[GateVerdict, fail.Fail].ok{rej};
    }
    if (v.int_width == 0) {
        ret res[GateVerdict, fail.Fail].ok{gate_verdict_valued(GATE_AWAITING_TYPES, span, v)};
    }
    if (truth(v)) {
        if (cacheable) { set_gate_state(c, cond, GATE_STATE_TRUE); }
        ret res[GateVerdict, fail.Fail].ok{gate_verdict(GATE_ACTIVE, "", span, intern.STR_NIL)};
    }
    if (cacheable) { set_gate_state(c, cond, GATE_STATE_FALSE); }
    ret res[GateVerdict, fail.Fail].ok{gate_verdict(GATE_INACTIVE, "", span, intern.STR_NIL)};
}

pub fun gate_chain_defers[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T],
    branches_start: u32, branches_len: u32
) res[bool, fail.Fail] {
    var pi: u32 = 0;
    for (pi < GATE_PROBE_COUNT) {
        val depends_r: res[bool, fail.Fail] = gate_chain_depends_on[T](a, source, obs, probes, pi::GateProbe, branches_start, branches_len);
        if (sel depends_r.err)    { ret depends_r; }
        if (depends_r.ok) { ret depends_r; }
        pi = pi + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

pub fun gate_depends_on[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe, eid: id.ExprId
) res[bool, fail.Fail] {
    if (eid == id.EXPR_NIL) { ret res[bool, fail.Fail].ok{false}; }
    if (probes.expression == nil) { ret res[bool, fail.Fail].err{fail.message("gate dependency visitor has no expression reader")}; }
    val e_opt: res[expr.Expr, EvalFail] = probes.expression(obs, a, eid);
    if (sel e_opt.err) {
        ret res[bool, fail.Fail].err{fail.message(e_opt.err.message)};
    }
    var e_value: expr.Expr = e_opt.ok;
    val e: *expr.Expr = ?e_value;

    val here: res[GateNodeVerdict, fail.Fail] = gate_probe_node[T](a, source, obs, probes, probe, eid, e);
    if (sel here.err) {
        ret res[bool, fail.Fail].err{here.err};
    }
    val verdict: GateNodeVerdict = here.ok;
    if (verdict == GATE_NODE_YES)   { ret res[bool, fail.Fail].ok{true}; }
    if (verdict == GATE_NODE_PRUNE) { ret res[bool, fail.Fail].ok{false}; }

    ret gate_depends_on_children[T](a, source, obs, probes, probe, e);
}

fun gate_probe_node[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    eid: id.ExprId, e: *expr.Expr
) res[GateNodeVerdict, fail.Fail] {
    if (probe == GATE_PROBE_COMPTIME_PARAM) {
        if (e.kind != expr.EXPR_KIND_IDENT) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
        if (probes.comptime_param == nil)   { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(probes.comptime_param(obs, eid))};
    }
    if (probe == GATE_PROBE_EACH_LOOPVAR) {
        if (e.kind != expr.EXPR_KIND_IDENT) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
        if (probes.each_loopvar == nil)     { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(probes.each_loopvar(obs, eid))};
    }
    if (probe == GATE_PROBE_FIELD_DESCRIPTOR) {
        if (!is_field_descriptor_member(a, source, eid)) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_NO}; }
        if (probes.field_loopvar == nil)    { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(probes.field_loopvar(obs, eid))};
    }
    if (probe == GATE_PROBE_LAYOUT_INTRINSIC) {
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(is_layout_intrinsic_call(a, source, eid))};
    }
    if (probe == GATE_PROBE_TYPE_COMPARISON) {
        if (e.kind == expr.EXPR_KIND_BINARY
         && (e.data.binary.op == expr.BIN_EQ || e.data.binary.op == expr.BIN_NEQ)) {
            if (is_type_comparison(a, source, ?e.data.binary)) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_YES}; }
            if (probes.field_type_operand == nil) { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
            if (probes.field_type_operand(obs, e.data.binary.lhs)) { ret res[GateNodeVerdict, fail.Fail].ok{GATE_NODE_YES}; }
            ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(probes.field_type_operand(obs, e.data.binary.rhs))};
        }
        ret res[GateNodeVerdict, fail.Fail].ok{gate_node_if(is_type_query_call(a, source, eid))};
    }
    if (probe == GATE_PROBE_TARGET_DEPENDENT) {
        ret res[GateNodeVerdict, fail.Fail].ok{gate_target_dependent_node(a, source, eid, e)};
    }
    if (probe == GATE_PROBE_NODE_ACTION) {
        if (probes.node_action == nil) { ret res[GateNodeVerdict, fail.Fail].err{fail.message(GATE_PROBE_NO_OBSERVER_MSG)}; }
        ret res[GateNodeVerdict, fail.Fail].ok{probes.node_action(obs, eid, e)};
    }
    ret res[GateNodeVerdict, fail.Fail].err{fail.message("internal: unknown compile-time dependency probe")};
}

fun gate_node_if(matched: bool) GateNodeVerdict {
    if (matched) { ret GATE_NODE_YES; }
    ret GATE_NODE_NO;
}

fun gate_target_dependent_node(a: *ast.Ast, source: str, eid: id.ExprId, e: *expr.Expr) GateNodeVerdict {
    val k: expr.ExprKind = e.kind;
    if (k == expr.EXPR_KIND_LIT_INT   || k == expr.EXPR_KIND_LIT_FLOAT
     || k == expr.EXPR_KIND_LIT_CHAR  || k == expr.EXPR_KIND_LIT_STR
     || k == expr.EXPR_KIND_LIT_NIL   || k == expr.EXPR_KIND_COMPTIME_IDENT) {
        ret GATE_NODE_PRUNE;
    }
    if (k == expr.EXPR_KIND_MEMBER && is_comptime_path(a, eid))            { ret GATE_NODE_PRUNE; }
    if (k == expr.EXPR_KIND_CALL && is_layout_intrinsic_call(a, source, eid)) { ret GATE_NODE_PRUNE; }
    if (k == expr.EXPR_KIND_BINARY || k == expr.EXPR_KIND_UNARY
     || k == expr.EXPR_KIND_SEL)                                           { ret GATE_NODE_NO; }
    ret GATE_NODE_YES;
}

fun gate_depends_on_children[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe, e: *expr.Expr
) res[bool, fail.Fail] {
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_BINARY) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.binary.lhs, e.data.binary.rhs);
    }
    if (k == expr.EXPR_KIND_UNARY) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.unary.operand);
    }
    if (k == expr.EXPR_KIND_SEL) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.sel.place, e.data.sel.case_desc);
    }
    if (k == expr.EXPR_KIND_CALL || k == expr.EXPR_KIND_GENERIC_INSTANCE) {
        val depends_r: res[bool, fail.Fail] = gate_depends_on_pair[T](a, source, obs, probes, probe,
            e.data.call.callee, e.data.call.index_callee);
        if (sel depends_r.err)    { ret depends_r; }
        if (depends_r.ok) { ret depends_r; }
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.call.args_start, e.data.call.args_len);
    }
    if (k == expr.EXPR_KIND_INDEX) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.index.object, e.data.index.index);
    }
    if (k == expr.EXPR_KIND_MEMBER) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.member.object);
    }
    if (k == expr.EXPR_KIND_PROJECT) {
        ret gate_depends_on_pair[T](a, source, obs, probes, probe, e.data.project.object, e.data.project.field);
    }
    if (k == expr.EXPR_KIND_CAST) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.cast.value);
    }
    if (k == expr.EXPR_KIND_STRIP) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.strip.value);
    }
    if (k == expr.EXPR_KIND_SPREAD) {
        ret gate_depends_on[T](a, source, obs, probes, probe, e.data.spread.inner);
    }
    if (k == expr.EXPR_KIND_ARRAY_LIT) {
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.array_lit.elems_start, e.data.array_lit.elems_len);
    }
    if (k == expr.EXPR_KIND_VECTOR_LIT) {
        ret gate_depends_on_list[T](a, source, obs, probes, probe, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len);
    }
    if (k == expr.EXPR_KIND_STRUCT_LIT) {
        var fi: u32 = 0;
        for (fi < e.data.struct_lit.fields_len) {
            val pool_ix: u32 = e.data.struct_lit.fields_start + fi;
            if (pool_ix::usize >= a.field_init_len) {
                ret res[bool, fail.Fail].err{fail.message("struct literal field index out of range in the dependency visitor")};
            }
            val finit: *expr.FieldInit = ?a.field_inits[pool_ix];
            val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, finit.value);
            if (sel depends_r.err)    { ret depends_r; }
            if (depends_r.ok) { ret depends_r; }
            fi = fi + 1;
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (gate_expr_kind_is_leaf(k)) { ret res[bool, fail.Fail].ok{false}; }

    ret res[bool, fail.Fail].err{fail.message(GATE_PROBE_UNLISTED_KIND_MSG)};
}

fun gate_expr_kind_is_leaf(k: expr.ExprKind) bool {
    ret k == expr.EXPR_KIND_IDENT     || k == expr.EXPR_KIND_LIT_INT
     || k == expr.EXPR_KIND_LIT_FLOAT || k == expr.EXPR_KIND_LIT_CHAR
     || k == expr.EXPR_KIND_LIT_STR   || k == expr.EXPR_KIND_LIT_NIL
     || k == expr.EXPR_KIND_COMPTIME_IDENT
     || k == expr.EXPR_KIND_TYPE_REF  || k == expr.EXPR_KIND_ERROR;
}

fun gate_depends_on_pair[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    first: id.ExprId, second: id.ExprId
) res[bool, fail.Fail] {
    val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, first);
    if (sel depends_r.err)    { ret depends_r; }
    if (depends_r.ok) { ret depends_r; }
    ret gate_depends_on[T](a, source, obs, probes, probe, second);
}

fun gate_depends_on_list[T](
    a: *ast.Ast, source: str, obs: *T, probes: GateProbes[T], probe: GateProbe,
    start: u32, len: u32
) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= a.expr_id_len) {
            ret res[bool, fail.Fail].err{fail.message("expression list index out of range in the dependency visitor")};
        }
        val depends_r: res[bool, fail.Fail] = gate_depends_on[T](a, source, obs, probes, probe, a.expr_ids[pool_ix]);
        if (sel depends_r.err)    { ret depends_r; }
        if (depends_r.ok) { ret depends_r; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

pub fun is_layout_intrinsic_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (is_size_of_call(a, source, eid))   { ret true; }
    if (is_length_of_call(a, source, eid)) { ret true; }
    if (is_align_of_call(a, source, eid))  { ret true; }
    ret is_comptime_call(a, source, eid, "offset_of");
}

pub fun is_length_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "length_of");
}

pub fun is_offset_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "offset_of");
}

pub fun is_size_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "size_of");
}

pub fun is_align_of_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "align_of");
}

pub fun layout_intrinsic_type_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    ret first_call_arg(a, eid);
}

pub fun fields_type_arg(a: *ast.Ast, eid: id.ExprId) id.ExprId {
    ret first_call_arg(a, eid);
}

pub rec ArrayLitInfo {
    elems_start: u32;
    elems_len:   u32;
}

pub fun declared_float_width(a: *ast.Ast, source: str, t: id.TypeId) float.FloatWidth {
    if (t == id.TYPE_NIL) { ret float.FLOAT_W_NONE; }
    val found: opt[*atype.Type] = ast.get_type(a, t);
    if (!sel found.some) { ret float.FLOAT_W_NONE; }
    val ty: *atype.Type = found.some;

    if (ty.kind == atype.TYPE_KIND_SECRET) {
        ret declared_float_width(a, source, ty.data.secret.inner);
    }
    if (ty.kind != atype.TYPE_KIND_NAMED)   { ret float.FLOAT_W_NONE; }
    if (ty.data.named.args_len != 0)        { ret float.FLOAT_W_NONE; }

    val text: View = span_text(source, ty.data.named.name);
    if (view_eq_str(text, "f32")) { ret float.FLOAT_W_32; }
    if (view_eq_str(text, "f64")) { ret float.FLOAT_W_64; }
    ret float.FLOAT_W_NONE;
}

pub fun apply_declared_int_type(a: *ast.Ast, source: str, t: id.TypeId, value: CTValue) CTValue {
    var out: CTValue = value;
    if (out.kind != CT_KIND_INT || t == id.TYPE_NIL) { ret out; }
    val found: opt[*atype.Type] = ast.get_type(a, t);
    if (!sel found.some) { ret out; }
    val ty: *atype.Type = found.some;
    if (ty.kind == atype.TYPE_KIND_SECRET) { ret apply_declared_int_type(a, source, ty.data.secret.inner, out); }
    if (ty.kind != atype.TYPE_KIND_NAMED || ty.data.named.args_len != 0) { ret out; }
    val text: View = span_text(source, ty.data.named.name);
    out.int_width = 0;
    if (view_eq_str(text, "u8"))  { out.int_unsigned = true;  out.int_width = 8;  }
    if (view_eq_str(text, "u16")) { out.int_unsigned = true;  out.int_width = 16; }
    if (view_eq_str(text, "u32")) { out.int_unsigned = true;  out.int_width = 32; }
    if (view_eq_str(text, "u64")) { out.int_unsigned = true;  out.int_width = 64; }
    if (view_eq_str(text, "i8"))  { out.int_unsigned = false; out.int_width = 8;  }
    if (view_eq_str(text, "i16")) { out.int_unsigned = false; out.int_width = 16; }
    if (view_eq_str(text, "i32")) { out.int_unsigned = false; out.int_width = 32; }
    if (view_eq_str(text, "i64")) { out.int_unsigned = false; out.int_width = 64; }
    ret out;
}

pub fun float_width_unread(v: CTValue) bool {
    ret v.kind == CT_KIND_FLOAT && v.float_width == float.FLOAT_W_NONE;
}

pub fun decl_array_lit(a: *ast.Ast, decl_id: id.DeclId) opt[ArrayLitInfo] {
    if (decl_id == id.DECL_NIL) { ret opt[ArrayLitInfo].none{}; }
    val d_opt: opt[*decl.Decl] = ast.get_decl(a, decl_id);
    if (!sel d_opt.some) { ret opt[ArrayLitInfo].none{}; }
    val d: *decl.Decl = d_opt.some;
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) { ret opt[ArrayLitInfo].none{}; }
    val init: id.ExprId = d.data.bind.init;
    if (init == id.EXPR_NIL) { ret opt[ArrayLitInfo].none{}; }
    val e_opt: opt[*expr.Expr] = ast.get_expr(a, init);
    if (!sel e_opt.some) { ret opt[ArrayLitInfo].none{}; }
    val e: *expr.Expr = e_opt.some;
    if (e.kind != expr.EXPR_KIND_ARRAY_LIT) { ret opt[ArrayLitInfo].none{}; }
    var info: ArrayLitInfo;
    info.elems_start = e.data.array_lit.elems_start;
    info.elems_len   = e.data.array_lit.elems_len;
    ret opt[ArrayLitInfo].some{info};
}

pub fun is_error_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "error");
}

pub fun error_message[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    eid:      id.ExprId,
    interner: *intern.Interner
) res[str, EvalFail] {
    val n_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (sel n_opt.none) { ret res[str, EvalFail].err{eval_error(EVAL_FAIL_REJECTED, "comptime `$error` directive is malformed")}; }
    val node: *expr.Expr = n_opt.some;
    if (node.kind != expr.EXPR_KIND_CALL || node.data.call.args_len != 1) {
        ret res[str, EvalFail].err{eval_error(EVAL_FAIL_REJECTED, "comptime `$error` takes one string-literal message")};
    }
    val arg: id.ExprId = a.expr_ids[node.data.call.args_start];
    val ev: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, arg, interner);
    if (sel ev.err) { ret res[str, EvalFail].err{ev.err}; }
    val v: CTValue = ev.ok;
    if (v.kind != CT_KIND_STR) { ret res[str, EvalFail].err{eval_error(EVAL_FAIL_REJECTED, "comptime `$error` message must be a string")}; }
    val txt: opt[str] = intern.lookup(interner, v.data.s);
    if (sel txt.none) { ret res[str, EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, "comptime `$error` message could not be read")}; }
    ret res[str, EvalFail].ok{txt.some};
}

pub fun type_operand_value(a: *ast.Ast, source: str, operand: id.ExprId) id.ExprId {
    if (is_type_of_call(a, source, operand)) { ret type_of_arg(a, operand); }
    ret operand;
}

pub fun is_type_comparison(a: *ast.Ast, source: str, bin: *expr.ExprBinary) bool {
    ret is_type_of_call(a, source, bin.lhs) || is_type_of_call(a, source, bin.rhs);
}

pub fun is_type_comparison_binary(a: *ast.Ast, source: str, bin: *expr.ExprBinary,
                                  lhs_is_field_type: bool, rhs_is_field_type: bool) bool {
    if (bin.op != expr.BIN_EQ && bin.op != expr.BIN_NEQ) { ret false; }
    ret is_type_comparison(a, source, bin) || lhs_is_field_type || rhs_is_field_type;
}

pub fun is_field_type_member(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val n_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret false; }
    val node: *expr.Expr = n_opt.some;
    if (node.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    ret view_eq_str(span_text(source, node.data.member.name), "type");
}

pub fun is_field_descriptor_member(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    val n_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (!sel n_opt.some) { ret false; }
    val node: *expr.Expr = n_opt.some;
    if (node.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    val m: View = span_text(source, node.data.member.name);
    ret view_eq_str(m, "name") || view_eq_str(m, "type") || view_eq_str(m, "offset")
        || view_eq_str(m, "has_payload") || view_eq_str(m, "code");
}

fun field_type_eval_operand[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    eid:      id.ExprId,
    interner: *intern.Interner
) res[bool, EvalFail] {
    if (!is_field_type_member(a, source, eid)) { ret res[bool, EvalFail].ok{false}; }
    val n_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (sel n_opt.none) { ret res[bool, EvalFail].ok{false}; }
    val node: *expr.Expr = n_opt.some;
    val obj_r: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, node.data.member.object, interner);
    if (sel obj_r.err) {
        val f: EvalFail = obj_r.err;
        if (f.kind == EVAL_FAIL_INTERNAL) { ret res[bool, EvalFail].err{f}; }
        ret res[bool, EvalFail].ok{false};
    }
    ret res[bool, EvalFail].ok{is_descriptor(obj_r.ok)};
}

fun eval_type_comparison[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    bin:      *expr.ExprBinary,
    interner: *intern.Interner
) res[CTValue, EvalFail] {
    val l_r: res[CTValue, EvalFail] = eval_type_operand[T](c, cap_ctx, caps, a, source, bin.lhs, interner);
    if (sel l_r.err) { ret l_r; }
    val r_r: res[CTValue, EvalFail] = eval_type_operand[T](c, cap_ctx, caps, a, source, bin.rhs, interner);
    if (sel r_r.err) { ret r_r; }
    ret apply_equality(bin.op, l_r.ok, r_r.ok);
}

fun eval_type_query[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner
) opt[res[CTValue, EvalFail]] {
    var which: u8 = TYPE_QUERY_IS_RECORD;
    if      (is_comptime_call(a, source, e, "is_record"))  { which = TYPE_QUERY_IS_RECORD; }
    or      (is_comptime_call(a, source, e, "is_union"))   { which = TYPE_QUERY_IS_UNION; }
    or      (is_comptime_call(a, source, e, "is_tag"))     { which = TYPE_QUERY_IS_TAG; }
    or      (is_comptime_call(a, source, e, "is_pointer")) { which = TYPE_QUERY_IS_POINTER; }
    or      (is_comptime_call(a, source, e, "is_secret"))  { which = TYPE_QUERY_IS_SECRET; }
    or      (is_comptime_call(a, source, e, "type_name"))  { which = TYPE_QUERY_NAME; }
    or      { ret opt[res[CTValue, EvalFail]].none{}; }

    val arg: id.ExprId = first_call_arg(a, e);
    if (arg == id.EXPR_NIL) {
        ret opt[res[CTValue, EvalFail]].some{
            reject("a comptime type query takes one type argument")};
    }

    val tv: res[CTValue, EvalFail] = eval_type_operand[T](c, cap_ctx, caps, a, source, arg, interner);
    if (sel tv.err) { ret opt[res[CTValue, EvalFail]].some{tv}; }
    val t: CTValue = tv.ok;
    if (t.kind != CT_KIND_TYPE) {
        ret opt[res[CTValue, EvalFail]].some{
            reject("a comptime type query's argument must name a type")};
    }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.query == nil) {
        ret opt[res[CTValue, EvalFail]].some{awaiting(EVAL_FAIL_NEEDS_TYPES, COMPTIME_TYPE_QUERY_NO_RESOLVER_MSG)};
    }
    val r: res[opt[CTValue], EvalFail] = caps.query(cap_ctx, t.data.t, which);
    if (sel r.err) {
        ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].err{r.err}};
    }
    val ans: opt[CTValue] = r.ok;
    if (sel ans.none) {
        ret opt[res[CTValue, EvalFail]].some{awaiting(EVAL_FAIL_NEEDS_TYPES, COMPTIME_TYPE_QUERY_NO_RESOLVER_MSG)};
    }
    ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].ok{ans.some}};
}

pub fun is_type_query_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    if (is_comptime_call(a, source, eid, "is_record"))  { ret true; }
    if (is_comptime_call(a, source, eid, "is_union"))   { ret true; }
    if (is_comptime_call(a, source, eid, "is_tag"))     { ret true; }
    if (is_comptime_call(a, source, eid, "is_pointer")) { ret true; }
    if (is_comptime_call(a, source, eid, "is_secret"))  { ret true; }
    ret is_comptime_call(a, source, eid, "type_name");
}

pub fun is_type_name_call(a: *ast.Ast, source: str, eid: id.ExprId) bool {
    ret is_comptime_call(a, source, eid, "type_name");
}

fun eval_type_operand[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    operand:  id.ExprId,
    interner: *intern.Interner
) res[CTValue, EvalFail] {
    if (is_field_type_member(a, source, operand)) {
        val direct: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, operand, interner);
        if (sel direct.err)                         { ret direct; }
        if (direct.ok.kind == CT_KIND_TYPE) { ret direct; }
    }
    if (!capabilities_have_types[T](cap_ctx, caps) || caps.type_ == nil) { ret awaiting(EVAL_FAIL_NEEDS_TYPES, COMPTIME_TYPE_NO_RESOLVER_MSG); }
    val value_eid: id.ExprId = type_operand_value(a, source, operand);
    val r: res[opt[u32], EvalFail] = caps.type_(cap_ctx, value_eid);
    if (sel r.err) { ret res[CTValue, EvalFail].err{r.err}; }
    val o: opt[u32] = r.ok;
    if (sel o.none) { ret reject(COMPTIME_TYPE_UNRESOLVED_MSG); }
    ret type_value(o.some);
}

pub fun ct_is_negative(v: CTValue) bool {
    if (v.kind != CT_KIND_INT) { ret false; }
    if (v.int_unsigned)        { ret false; }
    ret v.data.i < 0;
}

fun ct_int_lt(a: CTValue, b: CTValue) bool {
    val an: bool = ct_is_negative(a);
    val bn: bool = ct_is_negative(b);
    if (an != bn) { ret an; }
    ret (a.data.i:~u64) < (b.data.i:~u64);
}

fun ct_int_eq(a: CTValue, b: CTValue) bool {
    if (ct_is_negative(a) != ct_is_negative(b)) { ret false; }
    ret a.data.i == b.data.i;
}

fun apply_equality(op: expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject("equality requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_FLOAT && !float.widths_agree(lhs.float_width, rhs.float_width)) {
        ret reject(FLOAT_WIDTH_MISMATCH_MSG);
    }
    var eq: bool = false;
    if (lhs.kind == CT_KIND_INT)   { eq = ct_int_eq(lhs, rhs); }
    or (lhs.kind == CT_KIND_FLOAT) {
        val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
        eq = float.round_at(lhs.data.f, w) == float.round_at(rhs.data.f, w);
    }
    or (lhs.kind == CT_KIND_STR)   { eq = lhs.data.s == rhs.data.s; }
    or (lhs.kind == CT_KIND_TYPE)  { eq = lhs.data.t == rhs.data.t; }
    or { ret reject("equality requires integer, float, string or type operands"); }

    if (op == expr.BIN_EQ)  { ret u8_value(if_u8(eq)); }
    ret u8_value(if_u8(!eq));
}

fun apply_compare(op: expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject("comparison requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_INT) {
        if (op == expr.BIN_LT)  { ret u8_value(if_u8(ct_int_lt(lhs, rhs))); }
        if (op == expr.BIN_LEQ) { ret u8_value(if_u8(!ct_int_lt(rhs, lhs))); }
        if (op == expr.BIN_GT)  { ret u8_value(if_u8(ct_int_lt(rhs, lhs))); }
        ret u8_value(if_u8(!ct_int_lt(lhs, rhs)));
    }
    if (lhs.kind == CT_KIND_FLOAT) {
        if (!float.widths_agree(lhs.float_width, rhs.float_width)) {
            ret reject(FLOAT_WIDTH_MISMATCH_MSG);
        }
        val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
        val l: f64 = float.round_at(lhs.data.f, w);
        val r: f64 = float.round_at(rhs.data.f, w);
        if (op == expr.BIN_LT)  { ret u8_value(if_u8(l <  r)); }
        if (op == expr.BIN_LEQ) { ret u8_value(if_u8(l <= r)); }
        if (op == expr.BIN_GT)  { ret u8_value(if_u8(l >  r)); }
        ret u8_value(if_u8(l >= r));
    }
    ret reject("ordered comparison requires numeric operands");
}

fun float_trunc_rem_narrow(a: f64, b: f64, w: float.FloatWidth) f64 {
    val q: i64 = float.round_at(a / b, w)::i64;
    ret float.round_at(a - float.round_at(float.round_at(q::f64, w) * b, w), w);
}

fun float_trunc_rem(a: f64, b: f64, w: float.FloatWidth) f64 {
    val ab: u64 = float.f64_bits(a);
    val bb: u64 = float.f64_bits(b);
    val ae: u64 = (ab >> 52) & 0x7FF;
    val be: u64 = (bb >> 52) & 0x7FF;

    if (ae == 0x7FF || be == 0x7FF || b == 0.0) {
        ret float_trunc_rem_narrow(a, b, w);
    }

    val neg: bool = float.f64_signbit(a);
    var x: f64 = a;
    if (neg) { x = float.f64_neg(x); }
    var y: f64 = b;
    if (float.f64_signbit(b)) { y = float.f64_neg(y); }

    if (x < y) { ret float.round_at(a, w); }

    var yk: f64 = y;
    for (yk <= x / 2.0) { yk = yk * 2.0; }

    for (yk >= y) {
        if (x >= yk) { x = x - yk; }
        yk = yk / 2.0;
    }

    if (neg) { x = float.f64_neg(x); }
    ret float.round_at(x, w);
}

fun apply_arith(op: expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, EvalFail] {
    if (lhs.kind != rhs.kind) {
        ret reject("arithmetic requires operands of the same kind");
    }
    if (lhs.kind == CT_KIND_INT)   { ret apply_int_arith(op, lhs, rhs); }
    if (lhs.kind == CT_KIND_FLOAT) { ret apply_float_arith(op, lhs, rhs); }
    ret reject("arithmetic requires numeric operands");
}

fun apply_float_arith(op: expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, EvalFail] {
    if (!float.widths_agree(lhs.float_width, rhs.float_width)) {
        ret reject(FLOAT_WIDTH_MISMATCH_MSG);
    }
    val w: float.FloatWidth = float.unify_width(lhs.float_width, rhs.float_width);
    val l: f64 = float.round_at(lhs.data.f, w);
    val r: f64 = float.round_at(rhs.data.f, w);

    if (op == expr.BIN_ADD) { ret float_value(l + r, w); }
    if (op == expr.BIN_SUB) { ret float_value(l - r, w); }
    if (op == expr.BIN_MUL) { ret float_value(l * r, w); }
    if (op == expr.BIN_DIV) {
        if (r == 0.0) { ret reject("float division by zero"); }
        ret float_value(l / r, w);
    }
    if (op == expr.BIN_MOD) {
        if (r == 0.0) { ret reject("float modulo by zero"); }
        ret float_value(float_trunc_rem(l, r, w), w);
    }
    ret reject("unsupported float operator");
}

fun bitwise_value(bits: i64, lhs: CTValue, rhs: CTValue) res[CTValue, EvalFail] {
    val unsigned: bool = lhs.int_unsigned || rhs.int_unsigned;
    if (lhs.int_width != 0 && lhs.int_width == rhs.int_width) {
        ret cast_int(bits, lhs.int_width::u32, !unsigned);
    }
    ret make_int_value(bits, unsigned);
}

fun apply_int_arith(op: expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, EvalFail] {
    val res_uns: bool = lhs.int_unsigned || rhs.int_unsigned;

    if (op == expr.BIN_BIT_AND) { ret bitwise_value(lhs.data.i & rhs.data.i, lhs, rhs); }
    if (op == expr.BIN_BIT_OR) { ret bitwise_value(lhs.data.i | rhs.data.i, lhs, rhs); }
    if (op == expr.BIN_BIT_XOR) { ret bitwise_value(lhs.data.i ^ rhs.data.i, lhs, rhs); }
    if (op == expr.BIN_SHL || op == expr.BIN_SHR) { ret apply_int_shift(op, lhs, rhs); }

    if (!res_uns) { ret apply_signed_arith(op, lhs.data.i, rhs.data.i); }
    if (ct_is_negative(lhs) || ct_is_negative(rhs)) {
        ret reject("comptime arithmetic mixes a negative value with an unsigned operand");
    }
    ret apply_unsigned_arith(op, lhs.data.i:~u64, rhs.data.i:~u64);
}

fun apply_signed_arith(op: expr.BinOp, a: i64, b: i64) res[CTValue, EvalFail] {
    if (op == expr.BIN_ADD) {
        val s: i64 = a + b;
        if (((a ^ s) & (b ^ s)) < 0) {
            ret reject("comptime integer overflow in '+'");
        }
        ret make_int_value(s, false);
    }
    if (op == expr.BIN_SUB) {
        val s: i64 = a - b;
        if (((a ^ b) & (a ^ s)) < 0) {
            ret reject("comptime integer overflow in '-'");
        }
        ret make_int_value(s, false);
    }
    if (op == expr.BIN_MUL) { ret signed_mul(a, b); }
    if (op == expr.BIN_DIV) {
        if (b == 0) { ret reject("integer division by zero"); }
        if (is_i64_min(a) && b == (0 - 1)) {
            ret reject("integer division overflow (INT64_MIN / -1)");
        }
        ret make_int_value(a / b, false);
    }
    if (op == expr.BIN_MOD) {
        if (b == 0) { ret reject("integer modulo by zero"); }
        if (is_i64_min(a) && b == (0 - 1)) {
            ret reject("integer modulo overflow (INT64_MIN % -1)");
        }
        ret make_int_value(a % b, false);
    }
    ret reject("unsupported integer operator");
}

fun signed_mul(a: i64, b: i64) res[CTValue, EvalFail] {
    if (a == 0 || b == 0) { ret make_int_value(0, false); }
    if ((is_i64_min(a) && b == (0 - 1)) || (is_i64_min(b) && a == (0 - 1))) {
        ret reject("comptime integer overflow in '*'");
    }
    val p: i64 = a * b;
    if (p / a != b) { ret reject("comptime integer overflow in '*'"); }
    ret make_int_value(p, false);
}

fun apply_unsigned_arith(op: expr.BinOp, a: u64, b: u64) res[CTValue, EvalFail] {
    if (op == expr.BIN_ADD) {
        val s: u64 = a + b;
        if (s < a) { ret reject("comptime integer overflow in '+'"); }
        ret make_int_value(s:~i64, true);
    }
    if (op == expr.BIN_SUB) {
        if (a < b) { ret reject("comptime integer overflow in '-'"); }
        ret make_int_value((a - b):~i64, true);
    }
    if (op == expr.BIN_MUL) {
        val p: u64 = a * b;
        if (b != 0 && p / b != a) { ret reject("comptime integer overflow in '*'"); }
        ret make_int_value(p:~i64, true);
    }
    if (op == expr.BIN_DIV) {
        if (b == 0) { ret reject("integer division by zero"); }
        ret make_int_value((a / b):~i64, true);
    }
    if (op == expr.BIN_MOD) {
        if (b == 0) { ret reject("integer modulo by zero"); }
        ret make_int_value((a % b):~i64, true);
    }
    ret reject("unsupported integer operator");
}

fun apply_int_shift(op: expr.BinOp, lhs: CTValue, rhs: CTValue) res[CTValue, EvalFail] {
    if (ct_is_negative(rhs)) { ret reject("comptime shift amount is negative"); }
    val amt: u64 = rhs.data.i:~u64;
    if (amt >= 64) { ret reject("comptime shift amount must be less than 64"); }
    val sh: i64 = amt:~i64;
    if (op == expr.BIN_SHL) {
        if (amt > 0) {
            val discarded: u64 = (lhs.data.i:~u64) >> (64 - amt);
            if (discarded != 0) { ret reject("comptime left shift discards significant bits"); }
        }
        val shifted: u64 = (lhs.data.i:~u64) << amt;
        ret make_int_value(shifted:~i64, shifted > 0x7FFFFFFFFFFFFFFF);
    }
    if (lhs.int_unsigned)   { ret make_int_value((lhs.data.i:~u64 >> amt):~i64, true); }
    ret make_int_value(lhs.data.i >> sh, false);
}

fun eval_ident[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    source:   str,
    e:        id.ExprId,
    span:     token.Span,
    interner: *intern.Interner
) res[CTValue, EvalFail] {
    if (capabilities_have_ident[T](cap_ctx, caps)) {
        if (caps.ident(cap_ctx, e)) { ret reject(COMPTIME_IDENT_RUNTIME_MSG); }
    }

    val id_r: res[intern.StrId, A.Error] = intern.intern_span(interner, source, span);
    if (sel id_r.err) {
        ret internal_failure(alloc.text(id_r.err));
    }
    val name: intern.StrId = id_r.ok;
    val nc_opt: opt[NamedConst] = lookup(c, name);
    if (!sel nc_opt.some) {
        if (float_width_deferred(c, name)) {
            ret reject(COMPTIME_ALIAS_FLOAT_MSG);
        }
        ret awaiting(EVAL_FAIL_UNBOUND, COMPTIME_IDENT_UNBOUND_MSG);
    }
    ret res[CTValue, EvalFail].ok{nc_opt.some.value};
}

fun eval_module_member[T](cap_ctx: *T, caps: PhaseCapabilities[T], e: id.ExprId) res[CTValue, EvalFail] {
    if (!capabilities_have_member[T](cap_ctx, caps)) { ret awaiting(EVAL_FAIL_NEEDS_MEMBER, COMPTIME_MEMBER_NO_RESOLVER_MSG); }
    val r: res[opt[CTValue], EvalFail] = caps.member(cap_ctx, e);
    if (sel r.err) { ret res[CTValue, EvalFail].err{r.err}; }
    val o: opt[CTValue] = r.ok;
    if (sel o.some) { ret res[CTValue, EvalFail].ok{o.some}; }
    ret awaiting(EVAL_FAIL_NEEDS_MEMBER, COMPTIME_MEMBER_NOT_CONST_MSG);
}

fun eval_field_member[T](
    c:           *ComptimeCtx,
    cap_ctx:     *T,
    caps:        PhaseCapabilities[T],
    a:           *ast.Ast,
    source:      str,
    object_eid:  id.ExprId,
    member_span: token.Span,
    interner:    *intern.Interner
) opt[res[CTValue, EvalFail]] {
    val obj_r: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, object_eid, interner);
    if (sel obj_r.err) {
        if (obj_r.err.kind == EVAL_FAIL_INTERNAL) {
            ret opt[res[CTValue, EvalFail]].some{obj_r};
        }
        ret opt[res[CTValue, EvalFail]].none{};
    }
    val obj: CTValue = obj_r.ok;
    if (!is_descriptor(obj)) { ret opt[res[CTValue, EvalFail]].none{}; }

    val mtext: View = span_text(source, member_span);
    var pick: u8 = FIELD_SEL_NAME;
    if      (view_eq_str(mtext, "name"))   { pick = FIELD_SEL_NAME; }
    or      (view_eq_str(mtext, "type"))   { pick = FIELD_SEL_TYPE; }
    or      (view_eq_str(mtext, "offset")) { pick = FIELD_SEL_OFFSET; }
    or      (obj.kind == CT_KIND_CASE && view_eq_str(mtext, "has_payload")) { pick = FIELD_SEL_HAS_PAYLOAD; }
    or      (obj.kind == CT_KIND_CASE && view_eq_str(mtext, "code"))        { pick = FIELD_SEL_CODE; }
    or      (obj.kind == CT_KIND_CASE) { ret opt[res[CTValue, EvalFail]].some{reject(COMPTIME_CASE_UNKNOWN_MEMBER_MSG)}; }
    or      { ret opt[res[CTValue, EvalFail]].some{reject(COMPTIME_FIELD_UNKNOWN_MEMBER_MSG)}; }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.field == nil) { ret opt[res[CTValue, EvalFail]].some{reject(COMPTIME_FIELD_NO_RESOLVER_MSG)}; }
    val r: res[opt[CTValue], EvalFail] = caps.field(cap_ctx, obj.data.fld.owner, obj.data.fld.index, pick);
    if (sel r.err) { ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].err{r.err}}; }
    val o: opt[CTValue] = r.ok;
    if (sel o.none) { ret opt[res[CTValue, EvalFail]].some{reject(COMPTIME_FIELD_UNAVAILABLE_MSG)}; }
    ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].ok{o.some}};
}

fun eval_const_elem_member[T](
    c:           *ComptimeCtx,
    cap_ctx:     *T,
    caps:        PhaseCapabilities[T],
    a:           *ast.Ast,
    source:      str,
    object_eid:  id.ExprId,
    member_span: token.Span,
    interner:    *intern.Interner,
    fw:          float.FloatWidth
) opt[res[CTValue, EvalFail]] {
    val obj_opt: opt[*expr.Expr] = ast.get_expr(a, object_eid);
    if (sel obj_opt.none)                                       { ret opt[res[CTValue, EvalFail]].none{}; }
    val obj: *expr.Expr = obj_opt.some;

    val obj_r: res[opt[CTValue], EvalFail] = eval_const_elem_object[T](c, cap_ctx, caps, a, source, object_eid, interner, fw);
    if (sel obj_r.err) {
        val kind: EvalFailKind = obj_r.err.kind;
        # a nested constant read that was refused (the case it does not hold) is the answer; a plain
        # identifier that is not a constant falls through to the other member readers as before
        if (kind == EVAL_FAIL_INTERNAL || (kind == EVAL_FAIL_REJECTED && obj.kind == expr.EXPR_KIND_MEMBER)) {
            ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].err{obj_r.err}};
        }
        ret opt[res[CTValue, EvalFail]].none{};
    }
    val ov_opt: opt[CTValue] = obj_r.ok;
    if (sel ov_opt.none)                                           { ret opt[res[CTValue, EvalFail]].none{}; }
    val ov: CTValue = ov_opt.some;

    val el_opt: opt[*expr.Expr] = ast.get_expr(a, ov.data.celem.elem::id.ExprId);
    if (sel el_opt.none)                                        { ret opt[res[CTValue, EvalFail]].none{}; }
    val el: *expr.Expr = el_opt.some;
    if (literal_head_type(el) == id.TYPE_NIL)                                 { ret opt[res[CTValue, EvalFail]].none{}; }

    val mname_r: res[intern.StrId, A.Error] = intern.intern_span(interner, source, member_span);
    if (sel mname_r.err) { ret opt[res[CTValue, EvalFail]].some{internal_failure(alloc.text(mname_r.err))}; }
    val mname: intern.StrId = mname_r.ok;

    val head_r: res[opt[intern.StrId], EvalFail] = case_literal_head[T](c, cap_ctx, caps, a, source, el, interner);
    if (sel head_r.err) {
        ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].err{head_r.err}};
    }
    val head: opt[intern.StrId] = head_r.ok;
    if (sel head.some) {
        ret opt[res[CTValue, EvalFail]].some{constant_payload[T](c, cap_ctx, caps, a, source, el, ov.data.celem.ty,
            head.some, mname, interner, fw)};
    }
    if (el.kind != expr.EXPR_KIND_STRUCT_LIT)                                 { ret opt[res[CTValue, EvalFail]].none{}; }

    var i: u32 = 0;
    for (i < el.data.struct_lit.fields_len) {
        val pool_ix: usize = (el.data.struct_lit.fields_start + i)::usize;
        if (pool_ix >= a.field_init_len)                                      { ret opt[res[CTValue, EvalFail]].none{}; }
        val fi: *expr.FieldInit = ?a.field_inits[pool_ix];
        val fname_r: res[intern.StrId, A.Error] = intern.intern_span(interner, source, fi.name);
        if (sel fname_r.err) { ret opt[res[CTValue, EvalFail]].some{internal_failure(alloc.text(fname_r.err))}; }
        if (fname_r.ok == mname) {
            ret opt[res[CTValue, EvalFail]].some{constant_leaf[T](c, cap_ctx, caps, a, source, fi.value, ov.data.celem.ty, mname, interner, fw)};
        }
        i = i + 1;
    }

    if (!capabilities_have_types[T](cap_ctx, caps) || caps.field == nil) { ret opt[res[CTValue, EvalFail]].none{}; }
    val zr: res[opt[CTValue], EvalFail] = caps.field(cap_ctx, ov.data.celem.ty, mname::u32, FIELD_SEL_ZERO_BY_NAME);
    if (sel zr.err) { ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].err{zr.err}}; }
    val zo: opt[CTValue] = zr.ok;
    if (sel zo.none)               { ret opt[res[CTValue, EvalFail]].none{}; }
    ret opt[res[CTValue, EvalFail]].some{res[CTValue, EvalFail].ok{zo.some}};
}

# the constant element an expression names: a `$each` element or a module `val` constructed as a
# case literal, spelled as the binding itself or as a member path into its literal; ok(none) when
# the expression evaluates to something else, err when evaluating it fails
fun eval_const_elem_object[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    eid:      id.ExprId,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[opt[CTValue], EvalFail] {
    val e_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (sel e_opt.none) { ret res[opt[CTValue], EvalFail].ok{opt[CTValue].none{}}; }
    val e: *expr.Expr = e_opt.some;
    if (e.kind == expr.EXPR_KIND_IDENT) {
        val r: res[CTValue, EvalFail] = eval_ident[T](c, cap_ctx, caps, source, eid, e.span, interner);
        if (sel r.err) { ret res[opt[CTValue], EvalFail].err{r.err}; }
        val v: CTValue = r.ok;
        if (v.kind != CT_KIND_CONST_ELEM) { ret res[opt[CTValue], EvalFail].ok{opt[CTValue].none{}}; }
        ret res[opt[CTValue], EvalFail].ok{opt[CTValue].some{v}};
    }
    if (e.kind == expr.EXPR_KIND_MEMBER) {
        val nested: opt[res[CTValue, EvalFail]] =
            eval_const_elem_member[T](c, cap_ctx, caps, a, source, e.data.member.object, e.data.member.name, interner, fw);
        if (sel nested.none) { ret res[opt[CTValue], EvalFail].ok{opt[CTValue].none{}}; }
        val r: res[CTValue, EvalFail] = nested.some;
        if (sel r.err) { ret res[opt[CTValue], EvalFail].err{r.err}; }
        val v: CTValue = r.ok;
        if (v.kind != CT_KIND_CONST_ELEM) { ret res[opt[CTValue], EvalFail].ok{opt[CTValue].none{}}; }
        ret res[opt[CTValue], EvalFail].ok{opt[CTValue].some{v}};
    }
    ret res[opt[CTValue], EvalFail].ok{opt[CTValue].none{}};
}

# a literal is a case literal when its head names a tag case, `T.c{...}` or `T.[c]{...}`; the
# parser records the case only for a head with generic arguments, name resolution splits the
# others, so the answer is complete once the literal's head has been bound
pub fun is_case_literal(a: *ast.Ast, eid: id.ExprId) bool {
    val e_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (!sel e_opt.some) { ret false; }
    val tid: id.TypeId = literal_head_type(e_opt.some);
    if (tid == id.TYPE_NIL) { ret false; }
    val t_opt: opt[*atype.Type] = ast.get_type(a, tid);
    if (!sel t_opt.some) { ret false; }
    val t: *atype.Type = t_opt.some;
    if (t.kind != atype.TYPE_KIND_NAMED) { ret false; }
    ret t.data.named.case_desc != id.EXPR_NIL || t.data.named.case_name.len != 0;
}

# the head type of a literal in either parsed spelling: the parser emits a positional `T.c{x}` as a
# lane list until name resolution learns the head names a case and rewrites it to a struct literal
fun literal_head_type(e: *expr.Expr) id.TypeId {
    if (e.kind == expr.EXPR_KIND_STRUCT_LIT) { ret e.data.struct_lit.ty; }
    if (e.kind == expr.EXPR_KIND_VECTOR_LIT) { ret e.data.vector_lit.ty; }
    ret id.TYPE_NIL;
}

fun literal_elems_start(e: *expr.Expr) u32 {
    if (e.kind == expr.EXPR_KIND_VECTOR_LIT) { ret e.data.vector_lit.elems_start; }
    ret e.data.struct_lit.elems_start;
}

fun literal_elems_len(e: *expr.Expr) u32 {
    if (e.kind == expr.EXPR_KIND_VECTOR_LIT) { ret e.data.vector_lit.elems_len; }
    ret e.data.struct_lit.elems_len;
}

# the case a literal's head selects, none for a record literal
fun case_literal_head[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    lit:      *expr.Expr,
    interner: *intern.Interner
) res[opt[intern.StrId], EvalFail] {
    val tid: id.TypeId = literal_head_type(lit);
    if (tid == id.TYPE_NIL) { ret res[opt[intern.StrId], EvalFail].ok{opt[intern.StrId].none{}}; }
    val t_opt: opt[*atype.Type] = ast.get_type(a, tid);
    if (sel t_opt.none) { ret res[opt[intern.StrId], EvalFail].ok{opt[intern.StrId].none{}}; }
    val t: *atype.Type = t_opt.some;
    if (t.kind != atype.TYPE_KIND_NAMED) { ret res[opt[intern.StrId], EvalFail].ok{opt[intern.StrId].none{}}; }
    if (t.data.named.case_desc != id.EXPR_NIL) {
        ret descriptor_case_name[T](c, cap_ctx, caps, a, source, t.data.named.case_desc, interner);
    }
    if (t.data.named.case_name.len == 0) { ret res[opt[intern.StrId], EvalFail].ok{opt[intern.StrId].none{}}; }
    val name_r: res[intern.StrId, A.Error] = intern.intern_span(interner, source, t.data.named.case_name);
    if (sel name_r.err) { ret res[opt[intern.StrId], EvalFail].err{eval_error(EVAL_FAIL_INTERNAL, alloc.text(name_r.err))}; }
    ret res[opt[intern.StrId], EvalFail].ok{opt[intern.StrId].some{name_r.ok}};
}

# the case name a comptime case descriptor stands for; the tag's fields must be known
fun descriptor_case_name[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    desc_eid: id.ExprId,
    interner: *intern.Interner
) res[opt[intern.StrId], EvalFail] {
    val d_r: res[CTValue, EvalFail] = evaluate[T](c, cap_ctx, caps, a, source, desc_eid, interner);
    if (sel d_r.err) { ret res[opt[intern.StrId], EvalFail].err{d_r.err}; }
    val d: CTValue = d_r.ok;
    if (d.kind != CT_KIND_CASE) { ret res[opt[intern.StrId], EvalFail].err{eval_error(EVAL_FAIL_REJECTED, COMPTIME_CASE_DESCRIPTOR_OPERAND_MSG)}; }
    if (!capabilities_have_types[T](cap_ctx, caps) || caps.field == nil) {
        ret res[opt[intern.StrId], EvalFail].err{eval_error(EVAL_FAIL_NEEDS_TYPES, COMPTIME_SEL_DESCRIPTOR_NEEDS_TYPES_MSG)};
    }
    val r: res[opt[CTValue], EvalFail] = caps.field(cap_ctx, d.data.fld.owner, d.data.fld.index, FIELD_SEL_NAME);
    if (sel r.err) { ret res[opt[intern.StrId], EvalFail].err{r.err}; }
    val o: opt[CTValue] = r.ok;
    if (sel o.none) {
        ret res[opt[intern.StrId], EvalFail].err{eval_error(EVAL_FAIL_REJECTED, COMPTIME_CASE_DESCRIPTOR_OPERAND_MSG)};
    }
    if (o.some.kind != CT_KIND_STR) {
        ret res[opt[intern.StrId], EvalFail].err{eval_error(EVAL_FAIL_REJECTED, COMPTIME_CASE_DESCRIPTOR_OPERAND_MSG)};
    }
    ret res[opt[intern.StrId], EvalFail].ok{opt[intern.StrId].some{o.some.data.s}};
}

# `sel place.case` on a constant tag compares the literal's head case with the tested case
fun eval_sel[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    s:        *expr.ExprSel,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[CTValue, EvalFail] {
    val obj_r: res[opt[CTValue], EvalFail] = eval_const_elem_object[T](c, cap_ctx, caps, a, source, s.place, interner, fw);
    if (sel obj_r.err) {
        val f: EvalFail = obj_r.err;
        # a runtime binding is not a constant; a nested refusal and every transient failure keep their own reason
        if (f.kind == EVAL_FAIL_REJECTED && !place_is_member(a, s.place)) { ret reject(COMPTIME_SEL_NOT_CONSTANT_MSG); }
        ret res[CTValue, EvalFail].err{f};
    }
    val ov_opt: opt[CTValue] = obj_r.ok;
    if (sel ov_opt.none) { ret reject(COMPTIME_SEL_NOT_CONSTANT_MSG); }
    val ov: CTValue = ov_opt.some;

    val el_opt: opt[*expr.Expr] = ast.get_expr(a, ov.data.celem.elem::id.ExprId);
    if (!sel el_opt.some) { ret internal_failure("comptime: a constant element names no expression"); }
    val el: *expr.Expr = el_opt.some;
    if (literal_head_type(el) == id.TYPE_NIL) { ret reject(COMPTIME_SEL_NOT_CONSTANT_MSG); }
    val head_r: res[opt[intern.StrId], EvalFail] = case_literal_head[T](c, cap_ctx, caps, a, source, el, interner);
    if (sel head_r.err) { ret res[CTValue, EvalFail].err{head_r.err}; }
    val head: opt[intern.StrId] = head_r.ok;
    if (sel head.none) { ret reject(COMPTIME_SEL_NOT_CONSTANT_MSG); }

    var tested: intern.StrId = intern.STR_NIL;
    if (s.case_desc != id.EXPR_NIL) {
        val t_r: res[opt[intern.StrId], EvalFail] = descriptor_case_name[T](c, cap_ctx, caps, a, source, s.case_desc, interner);
        if (sel t_r.err) { ret res[CTValue, EvalFail].err{t_r.err}; }
        val t: opt[intern.StrId] = t_r.ok;
        if (sel t.none) { ret reject(COMPTIME_CASE_DESCRIPTOR_OPERAND_MSG); }
        tested = t.some;
    } or {
        val name_r: res[intern.StrId, A.Error] = intern.intern_span(interner, source, s.case_name);
        if (sel name_r.err) { ret internal_failure(alloc.text(name_r.err)); }
        tested = name_r.ok;
    }
    ret res[CTValue, EvalFail].ok{ct_u8(if_u8(head.some == tested))};
}

fun place_is_member(a: *ast.Ast, eid: id.ExprId) bool {
    val e_opt: opt[*expr.Expr] = ast.get_expr(a, eid);
    if (!sel e_opt.some) { ret false; }
    ret e_opt.some.kind == expr.EXPR_KIND_MEMBER;
}

# the payload of a constant case literal: the literal's single element when the read names the
# case it holds. reading the case it does not hold is refused, which is the comptime form of the
# debug discriminator trap: constant state is never stale, so the mismatch is a compile-time error
fun constant_payload[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    lit:      *expr.Expr,
    owner_ty: u32,
    head:     intern.StrId,
    name:     intern.StrId,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[CTValue, EvalFail] {
    if (head != name) { ret unselected_payload(interner, head, name); }
    if (literal_elems_len(lit) == 0) { ret reject(COMPTIME_CASE_PAYLOAD_MISSING_MSG); }
    if (literal_elems_start(lit)::usize >= a.expr_id_len) { ret internal_failure("comptime: case literal payload index out of range"); }
    ret constant_leaf[T](c, cap_ctx, caps, a, source, a.expr_ids[literal_elems_start(lit)], owner_ty, name, interner, fw);
}

fun unselected_payload(interner: *intern.Interner, head: intern.StrId, name: intern.StrId) res[CTValue, EvalFail] {
    if (interner == nil) { ret internal_failure("comptime payload diagnostic requires its interner"); }
    val head_s: opt[str] = intern.lookup(interner, head);
    val name_s: opt[str] = intern.lookup(interner, name);
    if (!sel head_s.some) { ret internal_failure("comptime payload diagnostic names an uninterned case"); }
    if (!sel name_s.some) { ret internal_failure("comptime payload diagnostic names an uninterned case"); }
    val formatted: res[str, format.FormatError] = format.sprint(interner.a,
        "this constant holds its `{}` case, so its `{}` payload is never selected", head_s.some, name_s.some);
    if (sel formatted.err) { ret internal_failure(fail.describe(fail.format_refused(formatted.err))); }
    val text: str = formatted.ok;
    fin { str_free(interner.a, text); }
    val saved: res[intern.StrId, A.Error] = intern.intern(interner, text);
    if (sel saved.err) { ret internal_failure(alloc.text(saved.err)); }
    val owned: opt[str] = intern.lookup(interner, saved.ok);
    if (!sel owned.some) { ret internal_failure("comptime payload diagnostic is absent from its interner"); }
    ret reject(owned.some);
}

# a leaf of a constant aggregate: a nested literal stays a constant element, carrying the
# member's checked type when the phase can name it; anything else evaluates as a value
fun constant_leaf[T](
    c:        *ComptimeCtx,
    cap_ctx:  *T,
    caps:     PhaseCapabilities[T],
    a:        *ast.Ast,
    source:   str,
    value_eid: id.ExprId,
    owner_ty: u32,
    name:     intern.StrId,
    interner: *intern.Interner,
    fw:       float.FloatWidth
) res[CTValue, EvalFail] {
    val v_opt: opt[*expr.Expr] = ast.get_expr(a, value_eid);
    if (sel v_opt.some) {
        if (literal_head_type(v_opt.some) != id.TYPE_NIL) {
            var nested_ty: u32 = type.TYPE_NIL::u32;
            if (owner_ty != type.TYPE_NIL::u32 && capabilities_have_types[T](cap_ctx, caps) && caps.field != nil) {
                val r: res[opt[CTValue], EvalFail] = caps.field(cap_ctx, owner_ty, name::u32, FIELD_SEL_TYPE_BY_NAME);
                if (sel r.err) { ret res[CTValue, EvalFail].err{r.err}; }
                val o: opt[CTValue] = r.ok;
                if (sel o.some) { if (o.some.kind == CT_KIND_TYPE) { nested_ty = o.some.data.t; } }
            }
            ret res[CTValue, EvalFail].ok{const_elem_value(value_eid::u32, nested_ty)};
        }
    }
    ret evaluate_at_float_width[T](c, cap_ctx, caps, a, source, value_eid, interner, fw);
}

pub fun is_comptime_path(a: *ast.Ast, e: id.ExprId) bool {
    var cur: id.ExprId = e;
    for (true) {
        if (cur == id.EXPR_NIL) { ret false; }
        val n_opt: opt[*expr.Expr] = ast.get_expr(a, cur);
        if (!sel n_opt.some) { ret false; }
        val node: *expr.Expr = n_opt.some;
        if (node.kind == expr.EXPR_KIND_COMPTIME_IDENT) { ret true; }
        if (node.kind == expr.EXPR_KIND_MEMBER) {
            cur = node.data.member.object;
            cnt;
        }
        ret false;
    }
    ret false;
}

fun eval_path(
    c:        *ComptimeCtx,
    a:        *ast.Ast,
    source:   str,
    e:        id.ExprId,
    interner: *intern.Interner
) res[CTValue, EvalFail] {
    var stack: [16]token.Span;
    var depth: u32 = 0;

    var cur: id.ExprId = e;
    for (true) {
        if (depth >= 16) { ret reject("comptime path is too deeply nested"); }
        val n_opt: opt[*expr.Expr] = ast.get_expr(a, cur);
        if (!sel n_opt.some) { ret reject("ExprId out of range during comptime member walk"); }
        val node: *expr.Expr = n_opt.some;
        if (node.kind == expr.EXPR_KIND_MEMBER) {
            stack[depth] = node.data.member.name;
            depth = depth + 1;
            cur = node.data.member.object;
            cnt;
        }
        if (node.kind == expr.EXPR_KIND_COMPTIME_IDENT) {
            stack[depth] = comptime_ident_name(node.span);
            depth = depth + 1;
            brk;
        }
        ret reject("comptime path must start with a `$` identifier");
    }

    ret resolve_comptime_path(c, source, ?stack[0], depth, interner);
}

fun resolve_comptime_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32, interner: *intern.Interner) res[CTValue, EvalFail] {
    if (depth == 0) { ret reject("empty comptime path"); }
    val root: View = span_text(source, stack[depth - 1]);
    if (view_eq_str(root, "mach"))    { ret resolve_mach_path(c, source, stack, depth, interner); }
    if (view_eq_str(root, "project")) { ret resolve_project_path(c, source, stack, depth, interner); }
    if (view_eq_str(root, "bin"))     { ret resolve_bin_path(c, source, stack, depth); }
    ret reject(COMPTIME_BARE_IDENT_MSG);
}

fun resolve_project_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32, interner: *intern.Interner) res[CTValue, EvalFail] {
    if (depth == 3 && seg_is(source, stack, 1, "target")) {
        if (seg_is(source, stack, 0, "os"))   { ret project_field(c.env.target_os); }
        if (seg_is(source, stack, 0, "arch")) { ret project_field(c.env.target_isa); }
        if (seg_is(source, stack, 0, "abi"))  { ret project_field(c.env.target_abi); }
        ret reject("unknown `$project.target.*` path");
    }
    if (depth == 3 && seg_is(source, stack, 1, "version")) {
        if (c.env.project_ver == intern.STR_NIL) { ret reject("comptime path value is not available in this context"); }
        val vo: opt[str] = intern.lookup(interner, c.env.project_ver);
        if (!sel vo.some) { ret reject("project version is not available"); }
        val vs: str = vo.some;
        if (seg_is(source, stack, 0, "major")) { ret version_value(vs, 0); }
        if (seg_is(source, stack, 0, "minor")) { ret version_value(vs, 1); }
        if (seg_is(source, stack, 0, "patch")) { ret version_value(vs, 2); }
        ret reject("unknown `$project.version.*` component");
    }
    if (depth == 4 && seg_is(source, stack, 2, "deps") && seg_is(source, stack, 0, "version")) {
        ret reject("`$project.deps.*.version` is not yet available (reserved for the package registry)");
    }
    if (depth != 2)                              { ret reject("unknown `$project.*` path"); }
    if (seg_is(source, stack, 0, "id"))          { ret project_field(c.env.project_id); }
    if (seg_is(source, stack, 0, "version"))     { ret project_field(c.env.project_ver); }
    if (seg_is(source, stack, 0, "name"))        { ret reject(REMOVED_PROJECT_NAME_MSG); }
    if (seg_is(source, stack, 0, "description")) { ret reject(REMOVED_PROJECT_DESC_MSG); }
    ret reject("unknown `$project.*` path");
}

# the two paths read manifest keys that were never used; they went with the keys
# and are refused by name rather than as unknown paths (#3128)
pub val REMOVED_PROJECT_NAME_MSG: str = "`$project.name` was removed in 5.0.0 with the `[project] name` manifest key; the project is identified by `$project.id`";
pub val REMOVED_PROJECT_DESC_MSG: str = "`$project.description` was removed in 5.0.0 with the `[project] description` manifest key; there is no comptime project description";

fun resolve_bin_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32) res[CTValue, EvalFail] {
    if (depth != 2)                       { ret reject("unknown `$bin.*` path"); }
    if (seg_is(source, stack, 0, "name")) { ret project_field(c.env.bin_name); }
    ret reject("unknown `$bin.*` path");
}

fun project_field(value: intern.StrId) res[CTValue, EvalFail] {
    if (value == intern.STR_NIL) {
        ret reject("comptime path value is not available in this context");
    }
    ret str_value(value);
}

pub fun comptime_ident_name(full: token.Span) token.Span {
    var s: token.Span;
    s.offset = full.offset + 1;
    if (full.len > 0) { s.len = full.len - 1; } or { s.len = 0; }
    ret s;
}

fun resolve_mach_path(c: *ComptimeCtx, source: str, stack: *token.Span, depth: u32, interner: *intern.Interner) res[CTValue, EvalFail] {
    if (depth == 0) { ret reject("empty comptime path"); }

    if (depth == 2 && seg_is(source, stack, 0, "version")) {
        ret str_value(c.env.compiler_ver);
    }
    if (depth == 3 && seg_is(source, stack, 1, "version")) {
        val vo: opt[str] = intern.lookup(interner, c.env.compiler_ver);
        if (!sel vo.some) { ret reject("compiler version is not available"); }
        val vs: str = vo.some;
        if (seg_is(source, stack, 0, "major")) { ret version_value(vs, 0); }
        if (seg_is(source, stack, 0, "minor")) { ret version_value(vs, 1); }
        if (seg_is(source, stack, 0, "patch")) { ret version_value(vs, 2); }
        ret reject("unknown `$mach.version.*` component");
    }

    if (depth == 3 && seg_is(source, stack, 1, "os")) {
        val name: View = span_text(source, stack[0]);
        val r: res[u32, fail.Fail] = os_tag_for(name);
        if (sel r.err) { ret reject(fail.describe(r.err)); }
        ret int_value(r.ok::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "arch")) {
        val name: View = span_text(source, stack[0]);
        val r: res[u32, fail.Fail] = arch_tag_for(name);
        if (sel r.err) { ret reject(fail.describe(r.err)); }
        ret int_value(r.ok::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "abi")) {
        val name: View = span_text(source, stack[0]);
        val r: res[u32, fail.Fail] = abi_tag_for(name);
        if (sel r.err) { ret reject(fail.describe(r.err)); }
        ret int_value(r.ok::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "mode")) {
        val name: View = span_text(source, stack[0]);
        val r: res[u32, fail.Fail] = mode_tag_for(name);
        if (sel r.err) { ret reject(fail.describe(r.err)); }
        ret int_value(r.ok::i64);
    }

    if (depth == 3 && seg_is(source, stack, 1, "compiler") && seg_is(source, stack, 0, "version")) {
        ret str_value(c.env.compiler_ver);
    }
    if (depth == 3 && seg_is(source, stack, 1, "compiler") && seg_is(source, stack, 0, "name")) {
        ret str_value(c.env.compiler_name);
    }

    if (depth == 3 && seg_is(source, stack, 1, "project")
     && (seg_is(source, stack, 0, "name") || seg_is(source, stack, 0, "version") || seg_is(source, stack, 0, "root"))) {
        ret reject("`$mach.project.*` is not yet available");
    }

    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "os")) {
        ret int_value(c.env.target_os_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "arch")) {
        ret int_value(c.env.target_arch_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "abi")) {
        ret int_value(c.env.target_abi_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "pointer_width")) {
        ret int_value(c.env.pointer_width::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "mode")) {
        ret int_value(c.env.build_mode_id::i64);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "pie")) {
        ret u8_value(c.env.build_pie::u8);
    }
    if (depth == 3 && seg_is(source, stack, 1, "build") && seg_is(source, stack, 0, "platform")) {
        if (c.env.target_platform != intern.STR_NIL) { ret str_value(c.env.target_platform); }
        val pr: res[intern.StrId, A.Error] = intern.intern(interner, "");
        if (sel pr.err) { ret internal_failure(alloc.text(pr.err)); }
        ret str_value(pr.ok);
    }

    if (depth == 3 && seg_is(source, stack, 1, "build")
     && (seg_is(source, stack, 0, "timestamp") || seg_is(source, stack, 0, "host"))) {
        ret reject("`$mach.build.*` is not yet available");
    }
    if (depth == 4 && seg_is(source, stack, 2, "build") && seg_is(source, stack, 1, "git")
     && (seg_is(source, stack, 0, "commit") || seg_is(source, stack, 0, "dirty"))) {
        ret reject("`$mach.build.git.*` is not yet available");
    }

    if (depth == 3 && seg_is(source, stack, 1, "source")
     && (seg_is(source, stack, 0, "file") || seg_is(source, stack, 0, "line")
      || seg_is(source, stack, 0, "module") || seg_is(source, stack, 0, "function"))) {
        ret reject("`$mach.source.*` is not yet available");
    }

    ret reject("unknown `$mach.*` path");
}

fun seg_is(source: str, stack: *token.Span, idx: u32, expected: str) bool {
    val span: token.Span = stack[idx];
    val text: View = span_text(source, span);
    ret view_eq_str(text, expected);
}

fun os_tag_for(name: View) res[u32, fail.Fail] {
    var i: usize = 0;
    for (i < os.os_catalog_len()) {
        val spelling: str = os.os_catalog_name(i);
        if (view_eq_str(name, spelling)) { ret res[u32, fail.Fail].ok{os.os_id_for(spelling)}; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].err{fail.message("unknown `$mach.os.*` tag")};
}

fun arch_tag_for(name: View) res[u32, fail.Fail] {
    var i: usize = 0;
    for (i < isa.arch_catalog_len()) {
        val spelling: str = isa.arch_catalog_name(i);
        if (view_eq_str(name, spelling)) { ret res[u32, fail.Fail].ok{isa.arch_id_for(spelling)}; }
        i = i + 1;
    }
    ret res[u32, fail.Fail].err{fail.message("unknown `$mach.arch.*` tag")};
}

# the 4.30 alias `sysv`, refused by name so the diagnostic names the removal
val REMOVED_ABI_SPELLING: str = "sysv";

fun abi_tag_for(name: View) res[u32, fail.Fail] {
    var i: usize = 0;
    for (i < abi.abi_catalog_len()) {
        val spelling: str = abi.abi_catalog_name(i);
        if (view_eq_str(name, spelling)) { ret res[u32, fail.Fail].ok{abi.abi_id_for(spelling)}; }
        i = i + 1;
    }
    if (view_eq_str(name, REMOVED_ABI_SPELLING)) {
        ret res[u32, fail.Fail].err{fail.message("`$mach.abi.sysv` was removed in 5.0.0; the registry spells this ABI `sysv64`: write `$mach.abi.sysv64`")};
    }
    ret res[u32, fail.Fail].err{fail.message("unknown `$mach.abi.*` tag")};
}

pub val MODE_DEBUG:   u32 = 0;
pub val MODE_RELEASE: u32 = 1;

fun mode_tag_for(name: View) res[u32, fail.Fail] {
    if (view_eq_str(name, "debug"))   { ret res[u32, fail.Fail].ok{MODE_DEBUG}; }
    if (view_eq_str(name, "release")) { ret res[u32, fail.Fail].ok{MODE_RELEASE}; }
    ret res[u32, fail.Fail].err{fail.message("unknown `$mach.mode.*` tag")};
}

fun version_component(s: str, which: u32) res[i64, fail.Fail] {
    var comp: u32   = 0;
    var acc:  i64   = 0;
    var seen: bool  = false;
    var i:    usize = 0;
    for (s[i] != 0) {
        val ch: u8 = s[i];
        if (ch == '.') {
            comp = comp + 1;
        } or (comp == which) {
            if (ch < '0' || ch > '9') { ret res[i64, fail.Fail].err{fail.message("version component is not numeric")}; }
            acc  = acc * 10 + (ch - '0')::i64;
            seen = true;
        }
        i = i + 1;
    }
    if (!seen) { ret res[i64, fail.Fail].err{fail.message("version string has no such component")}; }
    ret res[i64, fail.Fail].ok{acc};
}

fun version_value(s: str, which: u32) res[CTValue, EvalFail] {
    val r: res[i64, fail.Fail] = version_component(s, which);
    if (sel r.err) { ret reject(fail.describe(r.err)); }
    ret int_value(r.ok);
}

fun make_int_value(bits: i64, unsigned: bool) res[CTValue, EvalFail] {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = 0;
    v.data.i       = bits;
    ret res[CTValue, EvalFail].ok{v};
}

fun int_value(i: i64) res[CTValue, EvalFail] {
    ret make_int_value(i, false);
}

fun ct_negate(v: CTValue) res[CTValue, EvalFail] {
    if (!v.int_unsigned) {
        if (is_i64_min(v.data.i)) { ret make_int_value(v.data.i, true); }
        ret make_int_value(0 - v.data.i, false);
    }
    val mag: u64 = v.data.i:~u64;
    if (mag == 0) { ret make_int_value(0, false); }
    val signed_min_mag: u64 = 0x8000000000000000;
    if (mag > signed_min_mag) {
        ret reject("comptime negation of an unsigned value is out of range");
    }
    ret make_int_value(0 - v.data.i, false);
}

fun float_value(f: f64, w: float.FloatWidth) res[CTValue, EvalFail] {
    ret res[CTValue, EvalFail].ok{ct_float(f, w)};
}

pub fun ct_float(f: f64, w: float.FloatWidth) CTValue {
    var v: CTValue;
    v.kind        = CT_KIND_FLOAT;
    v.float_width = w;
    v.data.f      = float.round_at(f, w);
    ret v;
}

fun u8_value(n: u8) res[CTValue, EvalFail] {
    ret res[CTValue, EvalFail].ok{ct_u8(n)};
}

fun str_value(s: intern.StrId) res[CTValue, EvalFail] {
    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = s;
    ret res[CTValue, EvalFail].ok{v};
}

fun type_value(t: u32) res[CTValue, EvalFail] {
    var v: CTValue;
    v.kind   = CT_KIND_TYPE;
    v.data.t = t;
    ret res[CTValue, EvalFail].ok{v};
}

pub fun field_value(owner: u32, index: u32) CTValue {
    var v: CTValue;
    v.kind          = CT_KIND_FIELD;
    v.data.fld.owner = owner;
    v.data.fld.index = index;
    ret v;
}

pub fun case_value(owner: u32, index: u32) CTValue {
    var v: CTValue;
    v.kind          = CT_KIND_CASE;
    v.data.fld.owner = owner;
    v.data.fld.index = index;
    ret v;
}

pub fun pack_elem_value(index: u32, ty: u32) CTValue {
    var v: CTValue;
    v.kind            = CT_KIND_PACK_ELEM;
    v.data.pelem.index = index;
    v.data.pelem.ty    = ty;
    ret v;
}

# a constant element whose checked type is not yet known: name resolution and loading bind case
# literals this way, and type checking rebinds them with the declared type
pub fun const_elem_untyped(elem: u32) CTValue {
    ret const_elem_value(elem, type.TYPE_NIL::u32);
}

pub fun const_elem_value(elem: u32, ty: u32) CTValue {
    var v: CTValue;
    v.kind             = CT_KIND_CONST_ELEM;
    v.data.celem.elem = elem;
    v.data.celem.ty   = ty;
    ret v;
}

pub fun ct_str(s: intern.StrId) CTValue {
    var v: CTValue;
    v.kind   = CT_KIND_STR;
    v.data.s = s;
    ret v;
}

pub fun ct_u8(n: u8) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 8;
    v.data.i       = n::i64;
    ret v;
}

pub fun is_u8(v: CTValue) bool {
    ret v.kind == CT_KIND_INT && v.int_unsigned && v.int_width == 8;
}

pub fun truth(v: CTValue) bool {
    ret v.kind == CT_KIND_INT && v.data.i == 1;
}

fun if_u8(v: bool) u8 {
    if (v) { ret 1; }
    ret 0;
}

pub fun ct_type(t: u32) CTValue {
    var v: CTValue;
    v.kind   = CT_KIND_TYPE;
    v.data.t = t;
    ret v;
}

pub fun ct_uint(n: u64) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = true;
    v.int_width    = 64;
    v.data.i       = n:~i64;
    ret v;
}

pub fun ct_zero_int(unsigned: bool, width: u8) CTValue {
    var v: CTValue;
    v.kind         = CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = width;
    v.data.i       = 0;
    ret v;
}

fun t_eval_int(s: str) res[CTValue, EvalFail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret eval_lit_int(s, span);
}

fun t_i64_min() i64 { var one: u64 = 1;
 ret (one << 63):~i64; }
fun t_i64_max() i64 { var one: u64 = 1;
 ret ((one << 63) - 1):~i64; }

test "mach.lang.fe.comptime.eval_lit_int:above_u64_max_rejected" {
    val r: res[CTValue, EvalFail] = t_eval_int("18446744073709551616");
    if (sel r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:u64_max_preserved" {
    val r: res[CTValue, EvalFail] = t_eval_int("18446744073709551615");
    if (sel r.err) { ret 1; }
    val v: CTValue = r.ok;
    if (v.data.i:~u64 != 0xFFFFFFFFFFFFFFFF) { ret 1; }
    ret 0;
}

fun t_scan_int(s: str) res[LitInt, fail.Fail] {
    var span: token.Span;
    span.offset = 0;
    span.len    = str_len(s);
    ret scan_lit_int(s, span);
}

fun t_suffix_of(s: str) type.TypeKind {
    val r: res[LitInt, fail.Fail] = t_scan_int(s);
    if (sel r.err) { ret expr.LIT_SUFFIX_NONE; }
    ret r.ok.suffix;
}

test "mach.lang.fe.comptime.scan_lit_int:suffix_names_a_primitive_type" {
    if (t_suffix_of("7u8")   != type.TYPE_U8)  { ret 1; }
    if (t_suffix_of("7u16")  != type.TYPE_U16) { ret 2; }
    if (t_suffix_of("7u32")  != type.TYPE_U32) { ret 3; }
    if (t_suffix_of("7u64")  != type.TYPE_U64) { ret 4; }
    if (t_suffix_of("7i8")   != type.TYPE_I8)  { ret 5; }
    if (t_suffix_of("7i16")  != type.TYPE_I16) { ret 6; }
    if (t_suffix_of("7i32")  != type.TYPE_I32) { ret 7; }
    if (t_suffix_of("7i64")  != type.TYPE_I64) { ret 8; }
    if (t_suffix_of("7")     != expr.LIT_SUFFIX_NONE) { ret 9; }
    if (t_suffix_of("0xFFu8") != type.TYPE_U8)  { ret 10; }
    if (t_suffix_of("0b1010u16") != type.TYPE_U16) { ret 11; }
    if (t_suffix_of("0o755u32")  != type.TYPE_U32) { ret 12; }
    if (t_suffix_of("0xFF")      != expr.LIT_SUFFIX_NONE) { ret 13; }

    val r: res[LitInt, fail.Fail] = t_scan_int("255u8");
    if (sel r.err)                     { ret 14; }
    if (r.ok.value != 255)     { ret 15; }
    if (!r.ok.in_range)        { ret 16; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:suffix_sets_width_and_signedness" {
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("7u32");
    if (sel t_eval_int_r.err) { ret 99; }
    val a: CTValue = t_eval_int_r.ok;
    if (a.int_width != 32 || !a.int_unsigned) { ret 1; }
    val t_eval_int_r2: res[CTValue, EvalFail] = t_eval_int("7i8");
    if (sel t_eval_int_r2.err) { ret 99; }
    val b: CTValue = t_eval_int_r2.ok;
    if (b.int_width != 8 || b.int_unsigned)   { ret 2; }
    val t_eval_int_r3: res[CTValue, EvalFail] = t_eval_int("1u8");
    if (sel t_eval_int_r3.err) { ret 99; }
    val c: CTValue = t_eval_int_r3.ok;
    if (!is_u8(c) || !truth(c))               { ret 3; }
    val t_eval_int_r4: res[CTValue, EvalFail] = t_eval_int("7");
    if (sel t_eval_int_r4.err) { ret 99; }
    val d: CTValue = t_eval_int_r4.ok;
    if (d.int_width != 64 || d.int_unsigned)  { ret 4; }
    ret 0;
}

test "mach.lang.fe.comptime.scan_lit_int:unknown_suffix_rejected" {
    val t_scan_int_1: res[LitInt, fail.Fail] = t_scan_int("7u7");
    if (sel t_scan_int_1.ok)   { ret 1; }
    val t_scan_int_2: res[LitInt, fail.Fail] = t_scan_int("7u");
    if (sel t_scan_int_2.ok)    { ret 2; }
    val t_scan_int_3: res[LitInt, fail.Fail] = t_scan_int("7i");
    if (sel t_scan_int_3.ok)    { ret 3; }
    val t_scan_int_4: res[LitInt, fail.Fail] = t_scan_int("1f32");
    if (sel t_scan_int_4.ok)  { ret 4; }
    val t_scan_int_5: res[LitInt, fail.Fail] = t_scan_int("7u128");
    if (sel t_scan_int_5.ok) { ret 5; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:out_of_range_for_its_suffix_rejected" {
    val t_scan_int_1: res[LitInt, fail.Fail] = t_scan_int("256u8");
    if (!sel t_scan_int_1.ok) { ret 1; }
    if (t_scan_int_1.ok.in_range)     { ret 1; }
    val t_scan_int_2: res[LitInt, fail.Fail] = t_scan_int("40000i16");
    if (!sel t_scan_int_2.ok) { ret 1; }
    if (t_scan_int_2.ok.in_range)  { ret 2; }
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("256u8");
    if (sel t_eval_int_r.ok)               { ret 3; }
    val t_eval_int_r2: res[CTValue, EvalFail] = t_eval_int("40000i16");
    if (sel t_eval_int_r2.ok)            { ret 4; }
    val t_eval_int_r3: res[CTValue, EvalFail] = t_eval_int("255u8");
    if (sel t_eval_int_r3.err)                { ret 5; }
    val t_eval_int_r4: res[CTValue, EvalFail] = t_eval_int("128i8");
    if (sel t_eval_int_r4.err)                { ret 6; }
    val t_eval_int_r5: res[CTValue, EvalFail] = t_eval_int("32767i16");
    if (sel t_eval_int_r5.err)             { ret 7; }
    ret 0;
}

test "mach.lang.fe.comptime.eval_lit_int:hex_overflow_rejected" {
    val r: res[CTValue, EvalFail] = t_eval_int("0x1FFFFFFFFFFFFFFFF");
    if (sel r.ok) { ret 1; }
    ret 0;
}

fun t_view(s: str) View {
    ret view(?s[0], str_len(s));
}

test "mach.lang.fe.comptime.apply_arith:int_min_idiv_traps" {
    val int_value_r: res[CTValue, EvalFail] = int_value(t_i64_min());
    if (sel int_value_r.err) { ret 99; }
    val lhs: CTValue = int_value_r.ok;
    val int_value_r2: res[CTValue, EvalFail] = int_value(0 - 1);
    if (sel int_value_r2.err) { ret 99; }
    val rhs: CTValue = int_value_r2.ok;
    val apply_arith_r: res[CTValue, EvalFail] = apply_arith(expr.BIN_DIV, lhs, rhs);
    if (sel apply_arith_r.ok) { ret 1; }
    val apply_arith_r2: res[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, lhs, rhs);
    if (sel apply_arith_r2.ok) { ret 1; }
    val int_value_r3: res[CTValue, EvalFail] = int_value(10);
    if (sel int_value_r3.err) { ret 99; }
    val ten: CTValue = int_value_r3.ok;
    val int_value_r4: res[CTValue, EvalFail] = int_value(2);
    if (sel int_value_r4.err) { ret 99; }
    val two: CTValue = int_value_r4.ok;
    val okd: res[CTValue, EvalFail] = apply_arith(expr.BIN_DIV, ten, two);
    if (sel okd.err)                { ret 1; }
    if (okd.ok.data.i != 5) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:float_mod_truncated" {
    val float_value_r: res[CTValue, EvalFail] = float_value(5.5, float.FLOAT_W_NONE);
    if (sel float_value_r.err) { ret 99; }
    val a: CTValue = float_value_r.ok;
    val float_value_r2: res[CTValue, EvalFail] = float_value(3.0, float.FLOAT_W_NONE);
    if (sel float_value_r2.err) { ret 99; }
    val b: CTValue = float_value_r2.ok;
    val r: res[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, a, b);
    if (sel r.err)                  { ret 1; }
    if (r.ok.data.f != 2.5) { ret 1; }

    val float_value_r3: res[CTValue, EvalFail] = float_value(0.0 - 5.5, float.FLOAT_W_NONE);
    if (sel float_value_r3.err) { ret 99; }
    val na: CTValue = float_value_r3.ok;
    val rn: res[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, na, b);
    if (sel rn.err)                          { ret 1; }
    if (rn.ok.data.f != (0.0 - 2.5)) { ret 1; }

    val float_value_r4: res[CTValue, EvalFail] = float_value(0.45, float.FLOAT_W_NONE);
    if (sel float_value_r4.err) { ret 99; }
    val s:   CTValue = float_value_r4.ok;
    val float_value_r5: res[CTValue, EvalFail] = float_value(1.0, float.FLOAT_W_NONE);
    if (sel float_value_r5.err) { ret 99; }
    val one: CTValue = float_value_r5.ok;
    val rs: res[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, s, one);
    if (sel rs.err)                   { ret 1; }
    if (rs.ok.data.f != 0.45) { ret 1; }

    val float_value_r6: res[CTValue, EvalFail] = float_value(0.0, float.FLOAT_W_NONE);
    if (sel float_value_r6.err) { ret 99; }
    val z: CTValue = float_value_r6.ok;
    val apply_arith_r: res[CTValue, EvalFail] = apply_arith(expr.BIN_MOD, a, z);
    if (sel apply_arith_r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.tag_for:registry_names_are_the_only_names" {
    var i: usize = 0;
    for (i < isa.arch_catalog_len()) {
        val spelling: str = isa.arch_catalog_name(i);
        val r: res[u32, fail.Fail] = arch_tag_for(t_view(spelling));
        if (sel r.err) { ret 1; }
        if (r.ok != isa.arch_id_for(spelling)) { ret 1; }
        if (r.ok == isa.ARCH_UNKNOWN)          { ret 1; }
        i = i + 1;
    }
    if (isa.arch_catalog_len() != 5) { ret 1; }

    i = 0;
    for (i < abi.abi_catalog_len()) {
        val spelling: str = abi.abi_catalog_name(i);
        val r: res[u32, fail.Fail] = abi_tag_for(t_view(spelling));
        if (sel r.err) { ret 1; }
        if (r.ok != abi.abi_id_for(spelling)) { ret 1; }
        if (r.ok == abi.ABI_UNKNOWN)          { ret 1; }
        i = i + 1;
    }
    if (abi.abi_catalog_len() != 10) { ret 1; }

    i = 0;
    for (i < os.os_catalog_len()) {
        val spelling: str = os.os_catalog_name(i);
        val r: res[u32, fail.Fail] = os_tag_for(t_view(spelling));
        if (sel r.err) { ret 1; }
        if (r.ok != os.os_id_for(spelling)) { ret 1; }
        if (r.ok == os.OS_UNKNOWN)          { ret 1; }
        i = i + 1;
    }
    if (os.os_catalog_len() != 4) { ret 1; }

    val arch_tag_for_1: res[u32, fail.Fail] = arch_tag_for(t_view("spirv"));
    if (sel arch_tag_for_1.err)   { ret 1; }
    # the withdrawn MOS 6502 target is no tag at all (#3226, #3112)
    val arch_tag_for_2: res[u32, fail.Fail] = arch_tag_for(t_view("mos6502"));
    if (sel arch_tag_for_2.ok) { ret 1; }
    val arch_tag_for_3: res[u32, fail.Fail] = arch_tag_for(t_view("riscv"));
    if (sel arch_tag_for_3.ok)  { ret 1; }
    val os_tag_for_4: res[u32, fail.Fail] = os_tag_for(t_view("unknown"));
    if (sel os_tag_for_4.ok)  { ret 1; }

    val current: res[u32, fail.Fail] = abi_tag_for(t_view("sysv64"));
    if (sel current.err) { ret 1; }
    if (current.ok != abi.ABI_SYSV) { ret 1; }
    ret 0;
}

# intentional removal test (#3226, #3112): the 4.30 alias `$mach.abi.sysv` is refused by name
test "mach.lang.fe.comptime.tag_for:removed_sysv_alias_is_refused_by_name" {
    val removed: res[u32, fail.Fail] = abi_tag_for(t_view("sysv"));
    if (sel removed.ok) { ret 1; }
    val text: str = fail.describe(removed.err);
    if (!str_contains(text, "`$mach.abi.sysv` was removed in 5.0.0")) { ret 2; }
    if (!str_contains(text, "`$mach.abi.sysv64`"))                    { ret 3; }
    val unknown: res[u32, fail.Fail] = abi_tag_for(t_view("sysv32"));
    if (sel unknown.ok) { ret 4; }
    if (str_contains(fail.describe(unknown.err), "removed")) { ret 5; }
    ret 0;
}

test "mach.lang.fe.comptime.os_tag_for:unknown_errors_freestanding_distinct" {
    val os_tag_for_1: res[u32, fail.Fail] = os_tag_for(t_view("linxu"));
    if (sel os_tag_for_1.ok)    { ret 1; }
    val arch_tag_for_2: res[u32, fail.Fail] = arch_tag_for(t_view("x84_64"));
    if (sel arch_tag_for_2.ok) { ret 1; }
    val fr: res[u32, fail.Fail] = os_tag_for(t_view("freestanding"));
    if (sel fr.err)                     { ret 1; }
    if (fr.ok == os.OS_UNKNOWN) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.frame_close:owner_order_and_repeated_close_rejected" {
    var alloc: A.Allocator;
    val made_2: err[A.Error] = page.make(?alloc);
    if (sel made_2.err) { ret 1; }
    var first: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    var second: ComptimeCtx = init(?alloc, 0, 0, 0, 0, 0, 8, 128, true, intern.STR_NIL, intern.STR_NIL);
    val outer_r: res[FrameMark, fail.Fail] = frame_open(?first);
    val inner_r: res[FrameMark, fail.Fail] = frame_open(?first);
    if (sel outer_r.err) { ret 1; }
    if (sel inner_r.err) { ret 1; }
    val outer: FrameMark = outer_r.ok;
    val inner: FrameMark = inner_r.ok;
    val frame_close_typed_1: err[fail.Fail] = frame_close(?first, outer);
    if (sel frame_close_typed_1.ok) { ret 1; }
    val frame_close_typed_2: err[fail.Fail] = frame_close(?second, inner);
    if (sel frame_close_typed_2.ok) { ret 1; }
    val frame_close_typed_3: err[fail.Fail] = frame_close(?first, inner);
    if (sel frame_close_typed_3.err)   { ret 1; }
    val frame_close_typed_4: err[fail.Fail] = frame_close(?first, inner);
    if (sel frame_close_typed_4.ok) { ret 1; }
    val frame_close_typed_5: err[fail.Fail] = frame_close(?first, outer);
    if (sel frame_close_typed_5.err)  { ret 1; }
    val stale_r: res[FrameMark, fail.Fail] = frame_open(?second);
    if (sel stale_r.err) { ret 1; }
    val stale: FrameMark = stale_r.ok;
    dnit(?second);
    val frame_close_typed_6: err[fail.Fail] = frame_close(?second, stale);
    if (sel frame_close_typed_6.ok) { ret 1; }
    dnit(?first);
    ret 0;
}

fun t_capability_member(calls: *u32, _eid: id.ExprId) res[opt[CTValue], EvalFail] {
    @calls = @calls + 1;
    ret res[opt[CTValue], EvalFail].ok{opt[CTValue].some{ct_u8(1)}};
}

fun t_capability_ident(calls: *u32, _eid: id.ExprId) bool {
    @calls = @calls + 1;
    ret false;
}

rec TCapabilityNested {
    inner:       PhaseCapabilities[u32];
    outer_calls: u32;
    inner_calls: u32;
}

fun t_capability_nested(state: *TCapabilityNested, eid: id.ExprId) res[opt[CTValue], EvalFail] {
    state.outer_calls = state.outer_calls + 1;
    val r: res[CTValue, EvalFail] = eval_module_member[u32](?state.inner_calls, state.inner, eid);
    if (sel r.err) {
        ret res[opt[CTValue], EvalFail].err{r.err};
    }
    ret res[opt[CTValue], EvalFail].ok{opt[CTValue].some{r.ok}};
}

test "mach.lang.fe.comptime.cast_scalar:width_signedness_and_reinterpretation" {
    var a: A.Allocator;
    val make_1: err[A.Error] = page.make(?a);
    if (sel make_1.err) { ret 1; }
    var types: type.TypeInterner;
    val init_typed_2: err[fail.Fail] = type.init(?types, ?a);
    if (sel init_typed_2.err) { ret 1; }
    fin { type.dnit(?types); }
    val prim_typed_3: opt[type.TypeId] = type.prim(?types, type.TYPE_U8);
    if (!sel prim_typed_3.some) { ret 1; }
    val u8t: type.TypeId = prim_typed_3.some;
    val prim_typed_4: opt[type.TypeId] = type.prim(?types, type.TYPE_I8);
    if (!sel prim_typed_4.some) { ret 1; }
    val i8t: type.TypeId = prim_typed_4.some;
    val prim_typed_5: opt[type.TypeId] = type.prim(?types, type.TYPE_U64);
    if (!sel prim_typed_5.some) { ret 1; }
    val u64t: type.TypeId = prim_typed_5.some;
    val prim_typed_6: opt[type.TypeId] = type.prim(?types, type.TYPE_I64);
    if (!sel prim_typed_6.some) { ret 1; }
    val i64t: type.TypeId = prim_typed_6.some;
    val prim_typed_7: opt[type.TypeId] = type.prim(?types, type.TYPE_F64);
    if (!sel prim_typed_7.some) { ret 1; }
    val f64t: type.TypeId = prim_typed_7.some;
    val make_int_value_r: res[CTValue, EvalFail] = make_int_value(255, true);
    if (sel make_int_value_r.err) { ret 99; }
    val raw: CTValue = make_int_value_r.ok;
    val signed_r: res[CTValue, EvalFail] = cast_scalar(?types, 8, raw, u8t, i8t, true);
    if (sel signed_r.err) { ret 2; }
    val signed: CTValue = signed_r.ok;
    if (signed.data.i != -1 || signed.int_unsigned || signed.int_width != 8) { ret 3; }
    val wide_r: res[CTValue, EvalFail] = cast_scalar(?types, 8, signed, i8t, u64t, false);
    if (sel wide_r.err) { ret 4; }
    val wide: CTValue = wide_r.ok;
    if (wide.data.i != -1 || !wide.int_unsigned || wide.int_width != 64) { ret 5; }
    val int_value_r: res[CTValue, EvalFail] = int_value(300);
    if (sel int_value_r.err) { ret 99; }
    val narrow_r: res[CTValue, EvalFail] = cast_scalar(?types, 8,
        int_value_r.ok, i64t, u8t, false);
    if (sel narrow_r.err) { ret 6; }
    val narrow: CTValue = narrow_r.ok;
    if (narrow.data.i != 44 || !narrow.int_unsigned || narrow.int_width != 8) { ret 7; }
    val negative_zero: CTValue = ct_float(float.f64_neg(0.0), float.FLOAT_W_64);
    val bits_r: res[CTValue, EvalFail] = cast_scalar(?types, 8, negative_zero, f64t, u64t, true);
    if (sel bits_r.err) { ret 8; }
    val bits: CTValue = bits_r.ok;
    if (bits.data.i:~u64 != 0x8000000000000000 || !bits.int_unsigned) { ret 9; }
    val back_r: res[CTValue, EvalFail] = cast_scalar(?types, 8, bits, u64t, f64t, true);
    if (sel back_r.err) { ret 10; }
    if (back_r.ok.data.f:~u64 != 0x8000000000000000) { ret 11; }
    val cast_scalar_r: res[CTValue, EvalFail] = cast_scalar(?types, 8, raw, u8t, u64t, true);
    if (sel cast_scalar_r.ok) { ret 12; }
    val prim_typed_8: opt[type.TypeId] = type.prim(?types, type.TYPE_PTR);
    if (sel prim_typed_8.none) { ret 1; }
    val ptrt: type.TypeId = prim_typed_8.some;
    val make_int_value_r2: res[CTValue, EvalFail] = make_int_value(0x3FF0000000000000, true);
    if (sel make_int_value_r2.err) { ret 99; }
    val pointer: CTValue = make_int_value_r2.ok;
    val float_r: res[CTValue, EvalFail] = cast_scalar(?types, 8, pointer, ptrt, f64t, false);
    if (sel float_r.err) { ret 13; }
    if (float_r.ok.data.f != 1.0) { ret 13; }
    val pointer_r: res[CTValue, EvalFail] = cast_scalar(?types, 8, ct_float(1.0, float.FLOAT_W_64), f64t, ptrt, false);
    if (sel pointer_r.err) { ret 14; }
    if (pointer_r.ok.data.i != pointer.data.i) { ret 14; }
    ret 0;
}

test "mach.lang.fe.comptime.capabilities:mismatched_phase_does_not_dispatch" {
    var calls: u32 = 0;
    val caps_r: res[PhaseCapabilities[u32], fail.Fail] = loading_capabilities[u32](t_capability_member);
    if (sel caps_r.err) { ret 1; }
    var caps: PhaseCapabilities[u32] = caps_r.ok;
    val accepted: res[CTValue, EvalFail] = eval_module_member[u32](?calls, caps, id.EXPR_NIL);
    if (sel accepted.err) { ret 1; }
    if (calls != 1) { ret 1; }
    caps.kind = PHASE_CAP_RESOLUTION;
    val mismatched: res[CTValue, EvalFail] = eval_module_member[u32](?calls, caps, id.EXPR_NIL);
    if (sel mismatched.ok) { ret 1; }
    if (calls != 1) { ret 1; }
    val missing: res[CTValue, EvalFail] = eval_module_member[NoCapabilityContext](nil, no_capabilities(), id.EXPR_NIL);
    if (sel missing.ok) { ret 1; }
    if (calls != 1) { ret 1; }
    val nil_context: res[CTValue, EvalFail] = eval_module_member[u32](nil, caps, id.EXPR_NIL);
    if (sel nil_context.ok) { ret 1; }
    if (calls != 1) { ret 1; }
    val loading_capabilities_1: res[PhaseCapabilities[u32], fail.Fail] = loading_capabilities[u32](nil);
    if (sel loading_capabilities_1.ok) { ret 1; }
    caps.kind = PHASE_CAP_LOADING;
    caps.ident = t_capability_ident;
    val incomplete: res[CTValue, EvalFail] = eval_module_member[u32](?calls, caps, id.EXPR_NIL);
    if (sel incomplete.ok) { ret 1; }
    if (calls != 1) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.capabilities:nested_sessions_keep_their_phase_value" {
    var state: TCapabilityNested;
    state.outer_calls = 0;
    state.inner_calls = 0;
    val inner_r: res[PhaseCapabilities[u32], fail.Fail] = loading_capabilities[u32](t_capability_member);
    val outer_r: res[PhaseCapabilities[TCapabilityNested], fail.Fail] =
        loading_capabilities[TCapabilityNested](t_capability_nested);
    if (sel inner_r.err) { ret 1; }
    if (sel outer_r.err) { ret 1; }
    state.inner = inner_r.ok;
    val outer: PhaseCapabilities[TCapabilityNested] =
        outer_r.ok;
    val r: res[CTValue, EvalFail] = eval_module_member[TCapabilityNested](?state, outer, id.EXPR_NIL);
    if (sel r.err) { ret 1; }
    if (state.outer_calls != 1 || state.inner_calls != 1) { ret 1; }
    ret 0;
}

fun t_bool(r: res[CTValue, EvalFail]) bool {
    if (sel r.err) { ret false; }
    ret truth(r.ok);
}

test "mach.lang.fe.comptime.predicates:produce_u8_values" {
    val int_value_r: res[CTValue, EvalFail] = int_value(1);
    if (sel int_value_r.err) { ret 99; }
    val one: CTValue = int_value_r.ok;
    val int_value_r2: res[CTValue, EvalFail] = int_value(2);
    if (sel int_value_r2.err) { ret 99; }
    val two: CTValue = int_value_r2.ok;
    val eq_r: res[CTValue, EvalFail] = apply_equality(expr.BIN_EQ, one, one);
    val lt_r: res[CTValue, EvalFail] = apply_compare(expr.BIN_LT, one, two);
    if (sel eq_r.err) { ret 1; }
    if (sel lt_r.err) { ret 1; }
    val eq: CTValue = eq_r.ok;
    val lt: CTValue = lt_r.ok;
    if (!is_u8(eq) || !is_u8(lt)) { ret 1; }
    if (eq.data.i != 1 || lt.data.i != 1) { ret 1; }
    var descriptor: CTValue;
    descriptor.kind = CT_KIND_FIELD;
    for (descriptor.kind <= CT_KIND_CASE) {
        val invalid: res[CTValue, EvalFail] = apply_equality(expr.BIN_EQ, descriptor, descriptor);
        if (sel invalid.ok) { ret 2; }
        if (invalid.err.kind != EVAL_FAIL_REJECTED) { ret 2; }
        descriptor.kind = descriptor.kind + 1;
    }
    ret 0;
}

test "mach.lang.fe.comptime.apply_compare:u64_magnitude" {
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0xFFFFFFFFFFFFFFFF");
    if (sel t_eval_int_r.err) { ret 99; }
    val big:  CTValue = t_eval_int_r.ok;
    val int_value_r: res[CTValue, EvalFail] = int_value(0);
    if (sel int_value_r.err) { ret 99; }
    val zero: CTValue = int_value_r.ok;
    if (!t_bool(apply_compare(expr.BIN_GT, big, zero))) { ret 1; }
    if (t_bool(apply_compare(expr.BIN_LT, big, zero)))  { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_compare:cross_sign" {
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0xFFFFFFFFFFFFFFFF");
    if (sel t_eval_int_r.err) { ret 99; }
    val big: CTValue = t_eval_int_r.ok;
    val int_value_r: res[CTValue, EvalFail] = int_value(0 - 1);
    if (sel int_value_r.err) { ret 99; }
    val neg: CTValue = int_value_r.ok;
    if (!t_bool(apply_compare(expr.BIN_LT, neg, big)))   { ret 1; }
    if (!t_bool(apply_compare(expr.BIN_GT, big, neg)))   { ret 1; }
    if (t_bool(apply_compare(expr.BIN_GEQ, neg, big)))   { ret 1; }
    if (t_bool(apply_equality(expr.BIN_EQ, neg, big)))   { ret 1; }
    if (!t_bool(apply_equality(expr.BIN_NEQ, neg, big))) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_equality:cross_sign_magnitude" {
    val int_value_r: res[CTValue, EvalFail] = int_value(5);
    if (sel int_value_r.err) { ret 99; }
    val s5: CTValue = int_value_r.ok;
    val make_int_value_r: res[CTValue, EvalFail] = make_int_value(5, true);
    if (sel make_int_value_r.err) { ret 99; }
    val u5: CTValue = make_int_value_r.ok;
    if (!t_bool(apply_equality(expr.BIN_EQ, s5, u5))) { ret 1; }
    if (t_bool(apply_compare(expr.BIN_LT, s5, u5)))   { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_equality:type_identity" {
    val type_value_r: res[CTValue, EvalFail] = type_value(7);
    if (sel type_value_r.err) { ret 99; }
    val a: CTValue = type_value_r.ok;
    val type_value_r2: res[CTValue, EvalFail] = type_value(7);
    if (sel type_value_r2.err) { ret 99; }
    val b: CTValue = type_value_r2.ok;
    val type_value_r3: res[CTValue, EvalFail] = type_value(9);
    if (sel type_value_r3.err) { ret 99; }
    val c: CTValue = type_value_r3.ok;
    if (!t_bool(apply_equality(expr.BIN_EQ, a, b)))  { ret 1; }
    if (t_bool(apply_equality(expr.BIN_EQ, a, c)))   { ret 1; }
    if (!t_bool(apply_equality(expr.BIN_NEQ, a, c))) { ret 1; }
    val int_value_r: res[CTValue, EvalFail] = int_value(7);
    if (sel int_value_r.err) { ret 99; }
    val i: CTValue = int_value_r.ok;
    val apply_equality_r: res[CTValue, EvalFail] = apply_equality(expr.BIN_EQ, a, i);
    if (sel apply_equality_r.ok) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:u64_unsigned_div" {
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0xFFFFFFFFFFFFFFFF");
    if (sel t_eval_int_r.err) { ret 99; }
    val big: CTValue = t_eval_int_r.ok;
    val int_value_r: res[CTValue, EvalFail] = int_value(2);
    if (sel int_value_r.err) { ret 99; }
    val two: CTValue = int_value_r.ok;
    val apply_arith_r: res[CTValue, EvalFail] = apply_arith(expr.BIN_DIV, big, two);
    if (sel apply_arith_r.err) { ret 99; }
    val q:   CTValue = apply_arith_r.ok;
    if (q.data.i:~u64 != 0x7FFFFFFFFFFFFFFF) { ret 1; }
    if (!q.int_unsigned)                     { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:u64_boundary_overflow" {
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0xFFFFFFFFFFFFFFFF");
    if (sel t_eval_int_r.err) { ret 99; }
    val big:  CTValue = t_eval_int_r.ok;
    val int_value_r: res[CTValue, EvalFail] = int_value(1);
    if (sel int_value_r.err) { ret 99; }
    val one:  CTValue = int_value_r.ok;
    val int_value_r2: res[CTValue, EvalFail] = int_value(0);
    if (sel int_value_r2.err) { ret 99; }
    val zero: CTValue = int_value_r2.ok;
    val apply_arith_r: res[CTValue, EvalFail] = apply_arith(expr.BIN_SUB, big, one);
    if (sel apply_arith_r.err) { ret 99; }
    val dec: CTValue = apply_arith_r.ok;
    if (!t_bool(apply_compare(expr.BIN_GT, dec, zero))) { ret 1; }
    if (dec.data.i:~u64 != 0xFFFFFFFFFFFFFFFE)          { ret 1; }
    val apply_arith_r2: res[CTValue, EvalFail] = apply_arith(expr.BIN_ADD, big, one);
    if (sel apply_arith_r2.ok) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_arith:signed_overflow_traps" {
    val int_value_r: res[CTValue, EvalFail] = int_value(t_i64_max());
    if (sel int_value_r.err) { ret 99; }
    val imax: CTValue = int_value_r.ok;
    val int_value_r2: res[CTValue, EvalFail] = int_value(1);
    if (sel int_value_r2.err) { ret 99; }
    val one:  CTValue = int_value_r2.ok;
    val apply_arith_r: res[CTValue, EvalFail] = apply_arith(expr.BIN_ADD, imax, one);
    if (sel apply_arith_r.ok) { ret 1; }
    val int_value_r3: res[CTValue, EvalFail] = int_value(5);
    if (sel int_value_r3.err) { ret 99; }
    val five: CTValue = int_value_r3.ok;
    val int_value_r4: res[CTValue, EvalFail] = int_value(10);
    if (sel int_value_r4.err) { ret 99; }
    val ten:  CTValue = int_value_r4.ok;
    val apply_arith_r2: res[CTValue, EvalFail] = apply_arith(expr.BIN_SUB, five, ten);
    if (sel apply_arith_r2.err) { ret 99; }
    val d:    CTValue = apply_arith_r2.ok;
    if (d.data.i != (0 - 5)) { ret 1; }
    if (d.int_unsigned)      { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_int_shift:signedness" {
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0xFFFFFFFFFFFFFFFF");
    if (sel t_eval_int_r.err) { ret 99; }
    val big: CTValue = t_eval_int_r.ok;
    val int_value_r: res[CTValue, EvalFail] = int_value(1);
    if (sel int_value_r.err) { ret 99; }
    val one: CTValue = int_value_r.ok;
    val apply_arith_r: res[CTValue, EvalFail] = apply_arith(expr.BIN_SHR, big, one);
    if (sel apply_arith_r.err) { ret 99; }
    val lu: CTValue = apply_arith_r.ok;
    if (lu.data.i:~u64 != 0x7FFFFFFFFFFFFFFF) { ret 1; }
    val int_value_r2: res[CTValue, EvalFail] = int_value(0 - 2);
    if (sel int_value_r2.err) { ret 99; }
    val negtwo: CTValue = int_value_r2.ok;
    val apply_arith_r2: res[CTValue, EvalFail] = apply_arith(expr.BIN_SHR, negtwo, one);
    if (sel apply_arith_r2.err) { ret 99; }
    val ls: CTValue = apply_arith_r2.ok;
    if (ls.data.i != (0 - 1)) { ret 1; }
    ret 0;
}

test "mach.lang.fe.comptime.apply_int_shift:left_shift_high_bit_matches_the_equivalent_literal" {
    val int_value_r: res[CTValue, EvalFail] = int_value(1);
    if (sel int_value_r.err) { ret 99; }
    val one:  CTValue = int_value_r.ok;
    val int_value_r2: res[CTValue, EvalFail] = int_value(63);
    if (sel int_value_r2.err) { ret 99; }
    val sh63: CTValue = int_value_r2.ok;
    val apply_arith_r: res[CTValue, EvalFail] = apply_arith(expr.BIN_SHL, one, sh63);
    if (sel apply_arith_r.err) { ret 99; }
    val shifted: CTValue = apply_arith_r.ok;
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0x8000000000000000");
    if (sel t_eval_int_r.err) { ret 99; }
    val lit:     CTValue = t_eval_int_r.ok;

    if (shifted.int_unsigned != lit.int_unsigned) { ret 1; }
    if (shifted.data.i != lit.data.i)              { ret 2; }
    if (ct_is_negative(shifted))                   { ret 3; }

    val int_value_r3: res[CTValue, EvalFail] = int_value(2);
    if (sel int_value_r3.err) { ret 99; }
    val two: CTValue = int_value_r3.ok;
    val apply_arith_r2: res[CTValue, EvalFail] = apply_arith(expr.BIN_SHL, two, sh63);
    if (sel apply_arith_r2.ok) { ret 4; }

    ret 0;
}

test "mach.lang.fe.comptime.ct_negate:i64_u64_boundary" {
    val int_value_r: res[CTValue, EvalFail] = int_value(t_i64_min());
    if (sel int_value_r.err) { ret 99; }
    val imin: CTValue = int_value_r.ok;
    val ct_negate_r: res[CTValue, EvalFail] = ct_negate(imin);
    if (sel ct_negate_r.err) { ret 99; }
    val n:    CTValue = ct_negate_r.ok;
    if (!n.int_unsigned)                     { ret 1; }
    if (n.data.i:~u64 != 0x8000000000000000) { ret 1; }
    val t_eval_int_r: res[CTValue, EvalFail] = t_eval_int("0xFFFFFFFFFFFFFFFF");
    if (sel t_eval_int_r.err) { ret 99; }
    val big: CTValue = t_eval_int_r.ok;
    val ct_negate_r2: res[CTValue, EvalFail] = ct_negate(big);
    if (sel ct_negate_r2.ok) { ret 1; }
    ret 0;
}

fun t_dotted(source: str, out_stack: *token.Span) u32 {
    val n: usize = str_len(source);
    var tmp: [8]token.Span;
    var count: u32 = 0;
    var start: usize = 0;
    var i: usize = 0;
    for (i <= n) {
        if (i == n || source[i] == '.') {
            var sp: token.Span;
            sp.offset = start;
            sp.len    = i - start;
            tmp[count] = sp;
            count = count + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < count) {
        out_stack[k] = tmp[count - 1 - k];
        k = k + 1;
    }
    ret count;
}

fun t_build_ctx() ComptimeCtx {
    var c: ComptimeCtx;
    c.env.project_id   = 10;
    c.env.project_ver  = 11;
    c.env.target_os    = 20;
    c.env.target_isa   = 21;
    c.env.target_abi   = 22;
    c.env.bin_name     = 30;
    ret c;
}

fun t_str_id(r: res[CTValue, EvalFail]) intern.StrId {
    if (sel r.err) { ret intern.STR_NIL; }
    val v: CTValue = r.ok;
    if (v.kind != CT_KIND_STR) { ret intern.STR_NIL; }
    ret v.data.s;
}

test "mach.lang.fe.comptime.resolve_project_path:fields" {
    var c: ComptimeCtx = t_build_ctx();
    var stack: [8]token.Span;
    var alloc: A.Allocator;
    val made_3: err[A.Error] = page.make(?alloc);
    if (sel made_3.err) { ret 1; }
    var itab: intern.Interner = intern.init(?alloc);

    val sid: str = "project.id";
    if (t_str_id(resolve_project_path(?c, sid, ?stack[0], t_dotted(sid, ?stack[0]), ?itab)) != 10) { ret 1; }
    val sver: str = "project.version";
    if (t_str_id(resolve_project_path(?c, sver, ?stack[0], t_dotted(sver, ?stack[0]), ?itab)) != 11) { ret 1; }
    val sbogus: str = "project.bogus";
    val resolve_project_path_r2: res[CTValue, EvalFail] = resolve_project_path(?c, sbogus, ?stack[0], t_dotted(sbogus, ?stack[0]), ?itab);
    if (sel resolve_project_path_r2.ok) { ret 1; }
    ret 0;
}

# intentional removal test (#3226, #3112, #3128): the two paths are refused by name
test "mach.lang.fe.comptime.resolve_project_path:removed_name_and_description_are_refused_by_name" {
    var c: ComptimeCtx = t_build_ctx();
    var stack: [8]token.Span;
    var alloc: A.Allocator;
    val made: err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var itab: intern.Interner = intern.init(?alloc);

    val sname: str = "project.name";
    val name_r: res[CTValue, EvalFail] = resolve_project_path(?c, sname, ?stack[0], t_dotted(sname, ?stack[0]), ?itab);
    if (sel name_r.ok) { ret 2; }
    if (name_r.err.kind != EVAL_FAIL_REJECTED) { ret 3; }
    if (!str_contains(name_r.err.message, "`$project.name` was removed in 5.0.0")) { ret 4; }
    if (!str_contains(name_r.err.message, "`[project] name`")) { ret 5; }

    val sdesc: str = "project.description";
    val desc_r: res[CTValue, EvalFail] = resolve_project_path(?c, sdesc, ?stack[0], t_dotted(sdesc, ?stack[0]), ?itab);
    if (sel desc_r.ok) { ret 6; }
    if (!str_contains(desc_r.err.message, "`$project.description` was removed in 5.0.0")) { ret 7; }

    # an unknown path stays an unknown path
    val sbogus: str = "project.bogus";
    val bogus_r: res[CTValue, EvalFail] = resolve_project_path(?c, sbogus, ?stack[0], t_dotted(sbogus, ?stack[0]), ?itab);
    if (sel bogus_r.ok) { ret 8; }
    if (str_contains(bogus_r.err.message, "removed")) { ret 9; }
    ret 0;
}

