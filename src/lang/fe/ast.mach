use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std_allocator: std.allocator;

use ast_decl:   mach.lang.fe.ast.decl;
use ast_expr:   mach.lang.fe.ast.expr;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use ast_stmt:   mach.lang.fe.ast.stmt;
use ast_type:   mach.lang.fe.ast.type;
use mach.lang.fe.pool;
use mach.lang.fe.token;
use mach.lang.layout;
use lang_source: mach.lang.source;

rec ModuleNodeIdDomain {}

rec ExprIdDomain {}

rec StmtIdDomain {}

rec DeclIdDomain {}

rec TypeIdDomain {}

pub rec Ast {
    a:           *std_allocator.Allocator;
    file_id:     lang_source.FileId;
    incarnation: u64;
    root_module: ast_id.ModuleNodeId;

    modules:    *ast_module.Module;
    module_len: usize;
    module_cap: usize;

    exprs:    *ast_expr.Expr;
    expr_len: usize;
    expr_cap: usize;

    stmts:    *ast_stmt.Stmt;
    stmt_len: usize;
    stmt_cap: usize;

    decls:    *ast_decl.Decl;
    decl_len: usize;
    decl_cap: usize;

    types:    *ast_type.Type;
    type_len: usize;
    type_cap: usize;

    typed_names:    *ast_decl.TypedName;
    typed_name_len: usize;
    typed_name_cap: usize;

    tag_cases:    *ast_decl.TagCase;
    tag_case_len: usize;
    tag_case_cap: usize;

    field_inits:    *ast_expr.FieldInit;
    field_init_len: usize;
    field_init_cap: usize;

    generic_names:    *token.Span;
    generic_name_len: usize;
    generic_name_cap: usize;

    comptime_branches:   *ast_decl.ComptimeBranch;
    comptime_branch_len: usize;
    comptime_branch_cap: usize;

    decorators:    *ast_decl.Decorator;
    decorator_len: usize;
    decorator_cap: usize;

    decl_ids:    *ast_id.DeclId;
    decl_id_len: usize;
    decl_id_cap: usize;

    stmt_ids:    *ast_id.StmtId;
    stmt_id_len: usize;
    stmt_id_cap: usize;

    expr_ids:    *ast_id.ExprId;
    expr_id_len: usize;
    expr_id_cap: usize;

    type_ids:    *ast_id.TypeId;
    type_id_len: usize;
    type_id_cap: usize;
}

val INITIAL_NODE_CAP:    usize = 32;
val INITIAL_AUX_CAP:     usize = 16;
val INITIAL_ID_POOL_CAP: usize = 64;

pub fun init(a: *std_allocator.Allocator, file_id: lang_source.FileId) Ast {
    var ast: Ast;
    ast.a           = a;
    ast.file_id     = file_id;
    ast.incarnation = 0;
    ast.root_module = ast_id.MODULE_NODE_NIL;

    ast.modules    = nil;
    ast.module_len = 0;
    ast.module_cap = 0;

    ast.exprs    = nil;
    ast.expr_len = 0;
    ast.expr_cap = 0;

    ast.stmts    = nil;
    ast.stmt_len = 0;
    ast.stmt_cap = 0;

    ast.decls    = nil;
    ast.decl_len = 0;
    ast.decl_cap = 0;

    ast.types    = nil;
    ast.type_len = 0;
    ast.type_cap = 0;

    ast.typed_names    = nil;
    ast.typed_name_len = 0;
    ast.typed_name_cap = 0;

    ast.tag_cases    = nil;
    ast.tag_case_len = 0;
    ast.tag_case_cap = 0;

    ast.field_inits    = nil;
    ast.field_init_len = 0;
    ast.field_init_cap = 0;

    ast.generic_names    = nil;
    ast.generic_name_len = 0;
    ast.generic_name_cap = 0;

    ast.comptime_branches   = nil;
    ast.comptime_branch_len = 0;
    ast.comptime_branch_cap = 0;

    ast.decorators    = nil;
    ast.decorator_len = 0;
    ast.decorator_cap = 0;

    ast.decl_ids    = nil;
    ast.decl_id_len = 0;
    ast.decl_id_cap = 0;

    ast.stmt_ids    = nil;
    ast.stmt_id_len = 0;
    ast.stmt_id_cap = 0;

    ast.expr_ids    = nil;
    ast.expr_id_len = 0;
    ast.expr_id_cap = 0;

    ast.type_ids    = nil;
    ast.type_id_len = 0;
    ast.type_id_cap = 0;

    ret ast;
}

pub fun dnit(a: *Ast) {
    if (a == nil) { ret; }

    if (a.modules != nil && a.module_cap > 0) {
        std_allocator.deallocate[ast_module.Module](a.a, a.modules, a.module_cap);
    }
    if (a.exprs != nil && a.expr_cap > 0) {
        std_allocator.deallocate[ast_expr.Expr](a.a, a.exprs, a.expr_cap);
    }
    if (a.stmts != nil && a.stmt_cap > 0) {
        std_allocator.deallocate[ast_stmt.Stmt](a.a, a.stmts, a.stmt_cap);
    }
    if (a.decls != nil && a.decl_cap > 0) {
        std_allocator.deallocate[ast_decl.Decl](a.a, a.decls, a.decl_cap);
    }
    if (a.types != nil && a.type_cap > 0) {
        std_allocator.deallocate[ast_type.Type](a.a, a.types, a.type_cap);
    }
    if (a.typed_names != nil && a.typed_name_cap > 0) {
        std_allocator.deallocate[ast_decl.TypedName](a.a, a.typed_names, a.typed_name_cap);
    }

    if (a.tag_cases != nil && a.tag_case_cap > 0) {
        std_allocator.deallocate[ast_decl.TagCase](a.a, a.tag_cases, a.tag_case_cap);
    }
    if (a.field_inits != nil && a.field_init_cap > 0) {
        std_allocator.deallocate[ast_expr.FieldInit](a.a, a.field_inits, a.field_init_cap);
    }
    if (a.generic_names != nil && a.generic_name_cap > 0) {
        std_allocator.deallocate[token.Span](a.a, a.generic_names, a.generic_name_cap);
    }
    if (a.comptime_branches != nil && a.comptime_branch_cap > 0) {
        std_allocator.deallocate[ast_decl.ComptimeBranch](a.a, a.comptime_branches, a.comptime_branch_cap);
    }
    if (a.decorators != nil && a.decorator_cap > 0) {
        std_allocator.deallocate[ast_decl.Decorator](a.a, a.decorators, a.decorator_cap);
    }
    if (a.decl_ids != nil && a.decl_id_cap > 0) {
        std_allocator.deallocate[ast_id.DeclId](a.a, a.decl_ids, a.decl_id_cap);
    }
    if (a.stmt_ids != nil && a.stmt_id_cap > 0) {
        std_allocator.deallocate[ast_id.StmtId](a.a, a.stmt_ids, a.stmt_id_cap);
    }
    if (a.expr_ids != nil && a.expr_id_cap > 0) {
        std_allocator.deallocate[ast_id.ExprId](a.a, a.expr_ids, a.expr_id_cap);
    }
    if (a.type_ids != nil && a.type_id_cap > 0) {
        std_allocator.deallocate[ast_id.TypeId](a.a, a.type_ids, a.type_id_cap);
    }

    a.modules    = nil;
    a.module_len = 0;
    a.module_cap = 0;

    a.exprs    = nil;
    a.expr_len = 0;
    a.expr_cap = 0;

    a.stmts    = nil;
    a.stmt_len = 0;
    a.stmt_cap = 0;

    a.decls    = nil;
    a.decl_len = 0;
    a.decl_cap = 0;

    a.types    = nil;
    a.type_len = 0;
    a.type_cap = 0;

    a.typed_names    = nil;
    a.typed_name_len = 0;
    a.typed_name_cap = 0;

    a.tag_cases    = nil;
    a.tag_case_len = 0;
    a.tag_case_cap = 0;

    a.field_inits    = nil;
    a.field_init_len = 0;
    a.field_init_cap = 0;

    a.generic_names    = nil;
    a.generic_name_len = 0;
    a.generic_name_cap = 0;

    a.comptime_branches   = nil;
    a.comptime_branch_len = 0;
    a.comptime_branch_cap = 0;

    a.decorators    = nil;
    a.decorator_len = 0;
    a.decorator_cap = 0;

    a.decl_ids    = nil;
    a.decl_id_len = 0;
    a.decl_id_cap = 0;

    a.stmt_ids    = nil;
    a.stmt_id_len = 0;
    a.stmt_id_cap = 0;

    a.expr_ids    = nil;
    a.expr_id_len = 0;
    a.expr_id_cap = 0;

    a.type_ids    = nil;
    a.type_id_len = 0;
    a.type_id_cap = 0;

    a.root_module = ast_id.MODULE_NODE_NIL;
}

pub fun add_module(a: *Ast, m: ast_module.Module) res[ast_id.ModuleNodeId, fail.Fail] {
    if (a.module_len == a.module_cap) {
        val res_modules: res[*ast_module.Module, std_allocator.Error] = pool.grow[ast_module.Module](a.a, a.modules, a.module_cap, INITIAL_NODE_CAP, ?a.module_cap);
        if (sel res_modules.err) {
            ret res[ast_id.ModuleNodeId, fail.Fail].err{fail.refused(res_modules.err)};
        }
        a.modules = res_modules.ok;
    }
    val checked_id: res[layout.CheckedId[ModuleNodeIdDomain], layout.CheckCause] =
        layout.id_below[ModuleNodeIdDomain](a.module_len, layout.count[ModuleNodeIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[ast_id.ModuleNodeId, fail.Fail].err{fail.message("ast: module id exhausts its 32-bit domain")};
    }
    val new_id: ast_id.ModuleNodeId = checked_id.ok.value::u32;
    a.modules[a.module_len] = m;
    a.module_len            = a.module_len + 1;
    ret res[ast_id.ModuleNodeId, fail.Fail].ok{new_id};
}

pub fun get_module(a: *Ast, id_: ast_id.ModuleNodeId) opt[*ast_module.Module] {
    if (id_::usize >= a.module_len) { ret opt[*ast_module.Module].none{}; }
    ret opt[*ast_module.Module].some{?a.modules[id_]};
}

pub fun add_expr(a: *Ast, e: ast_expr.Expr) res[ast_id.ExprId, fail.Fail] {
    if (a.expr_len == a.expr_cap) {
        val res_exprs: res[*ast_expr.Expr, std_allocator.Error] = pool.grow[ast_expr.Expr](a.a, a.exprs, a.expr_cap, INITIAL_NODE_CAP, ?a.expr_cap);
        if (sel res_exprs.err) {
            ret res[ast_id.ExprId, fail.Fail].err{fail.refused(res_exprs.err)};
        }
        a.exprs = res_exprs.ok;
    }
    val checked_id: res[layout.CheckedId[ExprIdDomain], layout.CheckCause] =
        layout.id_below[ExprIdDomain](a.expr_len, layout.count[ExprIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[ast_id.ExprId, fail.Fail].err{fail.message("ast: expr id exhausts its 32-bit domain")};
    }
    val new_id: ast_id.ExprId = checked_id.ok.value::u32;
    a.exprs[a.expr_len] = e;
    a.expr_len          = a.expr_len + 1;
    ret res[ast_id.ExprId, fail.Fail].ok{new_id};
}

pub fun get_expr(a: *Ast, id_: ast_id.ExprId) opt[*ast_expr.Expr] {
    if (id_::usize >= a.expr_len) { ret opt[*ast_expr.Expr].none{}; }
    ret opt[*ast_expr.Expr].some{?a.exprs[id_]};
}

pub fun expr_place_kind(e: *ast_expr.Expr) ast_expr.ExprKind {
    val k: ast_expr.ExprKind = e.kind;
    if (k == ast_expr.EXPR_KIND_IDENT
        || k == ast_expr.EXPR_KIND_MEMBER
        || k == ast_expr.EXPR_KIND_PROJECT
        || k == ast_expr.EXPR_KIND_INDEX
        || k == ast_expr.EXPR_KIND_CALL) { ret k; }
    if (k == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_DEREF) { ret k; }
    ret ast_expr.EXPR_KIND_ERROR;
}

pub fun add_stmt(a: *Ast, s: ast_stmt.Stmt) res[ast_id.StmtId, fail.Fail] {
    if (a.stmt_len == a.stmt_cap) {
        val res_stmts: res[*ast_stmt.Stmt, std_allocator.Error] = pool.grow[ast_stmt.Stmt](a.a, a.stmts, a.stmt_cap, INITIAL_NODE_CAP, ?a.stmt_cap);
        if (sel res_stmts.err) {
            ret res[ast_id.StmtId, fail.Fail].err{fail.refused(res_stmts.err)};
        }
        a.stmts = res_stmts.ok;
    }
    val checked_id: res[layout.CheckedId[StmtIdDomain], layout.CheckCause] =
        layout.id_below[StmtIdDomain](a.stmt_len, layout.count[StmtIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[ast_id.StmtId, fail.Fail].err{fail.message("ast: stmt id exhausts its 32-bit domain")};
    }
    val new_id: ast_id.StmtId = checked_id.ok.value::u32;
    a.stmts[a.stmt_len] = s;
    a.stmt_len          = a.stmt_len + 1;
    ret res[ast_id.StmtId, fail.Fail].ok{new_id};
}

pub fun get_stmt(a: *Ast, id_: ast_id.StmtId) opt[*ast_stmt.Stmt] {
    if (id_::usize >= a.stmt_len) { ret opt[*ast_stmt.Stmt].none{}; }
    ret opt[*ast_stmt.Stmt].some{?a.stmts[id_]};
}

pub fun add_decl(a: *Ast, d: ast_decl.Decl) res[ast_id.DeclId, fail.Fail] {
    if (a.decl_len == a.decl_cap) {
        val res_decls: res[*ast_decl.Decl, std_allocator.Error] = pool.grow[ast_decl.Decl](a.a, a.decls, a.decl_cap, INITIAL_NODE_CAP, ?a.decl_cap);
        if (sel res_decls.err) {
            ret res[ast_id.DeclId, fail.Fail].err{fail.refused(res_decls.err)};
        }
        a.decls = res_decls.ok;
    }
    val checked_id: res[layout.CheckedId[DeclIdDomain], layout.CheckCause] =
        layout.id_below[DeclIdDomain](a.decl_len, layout.count[DeclIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[ast_id.DeclId, fail.Fail].err{fail.message("ast: decl id exhausts its 32-bit domain")};
    }
    val new_id: ast_id.DeclId = checked_id.ok.value::u32;
    a.decls[a.decl_len] = d;
    a.decl_len          = a.decl_len + 1;
    ret res[ast_id.DeclId, fail.Fail].ok{new_id};
}

pub fun get_decl(a: *Ast, id_: ast_id.DeclId) opt[*ast_decl.Decl] {
    if (id_::usize >= a.decl_len) { ret opt[*ast_decl.Decl].none{}; }
    ret opt[*ast_decl.Decl].some{?a.decls[id_]};
}

pub fun decl_name_span(a: *Ast, id_: ast_id.DeclId) token.Span {
    var empty: token.Span;
    empty.offset = 0;
    empty.len    = 0;

    val opt_d: opt[*ast_decl.Decl] = get_decl(a, id_);
    if (!sel opt_d.some) { ret empty; }
    val d: *ast_decl.Decl = opt_d.some;

    if (d.kind == ast_decl.DECL_KIND_USE) { ret d.data.use_.alias; }
    if (d.kind == ast_decl.DECL_KIND_FWD) { ret d.data.fwd_.alias; }
    if (d.kind == ast_decl.DECL_KIND_FUN) { ret d.data.fun_.name; }
    if (d.kind == ast_decl.DECL_KIND_REC) { ret d.data.rec_.name; }
    if (d.kind == ast_decl.DECL_KIND_UNI) { ret d.data.uni_.name; }
    if (d.kind == ast_decl.DECL_KIND_TAG) { ret d.data.tag_.name; }
    if (d.kind == ast_decl.DECL_KIND_DEF) { ret d.data.def_.name; }
    if (d.kind == ast_decl.DECL_KIND_VAL) { ret d.data.bind.name; }
    if (d.kind == ast_decl.DECL_KIND_VAR) { ret d.data.bind.name; }
    ret empty;
}

pub fun add_type(a: *Ast, t: ast_type.Type) res[ast_id.TypeId, fail.Fail] {
    if (a.type_len == a.type_cap) {
        val res_types: res[*ast_type.Type, std_allocator.Error] = pool.grow[ast_type.Type](a.a, a.types, a.type_cap, INITIAL_NODE_CAP, ?a.type_cap);
        if (sel res_types.err) {
            ret res[ast_id.TypeId, fail.Fail].err{fail.refused(res_types.err)};
        }
        a.types = res_types.ok;
    }
    val checked_id: res[layout.CheckedId[TypeIdDomain], layout.CheckCause] =
        layout.id_below[TypeIdDomain](a.type_len, layout.count[TypeIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[ast_id.TypeId, fail.Fail].err{fail.message("ast: type id exhausts its 32-bit domain")};
    }
    val new_id: ast_id.TypeId = checked_id.ok.value::u32;
    a.types[a.type_len] = t;
    a.type_len          = a.type_len + 1;
    ret res[ast_id.TypeId, fail.Fail].ok{new_id};
}

pub fun get_type(a: *Ast, id_: ast_id.TypeId) opt[*ast_type.Type] {
    if (id_::usize >= a.type_len) { ret opt[*ast_type.Type].none{}; }
    ret opt[*ast_type.Type].some{?a.types[id_]};
}

pub fun add_typed_name(a: *Ast, tn: ast_decl.TypedName) res[u32, fail.Fail] {
    if (a.typed_name_len == a.typed_name_cap) {
        val res_typed_names: res[*ast_decl.TypedName, std_allocator.Error] = pool.grow[ast_decl.TypedName](a.a, a.typed_names, a.typed_name_cap, INITIAL_AUX_CAP, ?a.typed_name_cap);
        if (sel res_typed_names.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_typed_names.err)};
        }
        a.typed_names = res_typed_names.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.typed_name_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: typed-name index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.typed_names[a.typed_name_len] = tn;
    a.typed_name_len                = a.typed_name_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

