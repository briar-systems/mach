test "mach.lang.fe.ast.add_typed_name:refuses_an_index_past_the_u32_limit" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var a: Ast = init(?alloc, 0::source.FileId);

    a.typed_name_len = 0x100000000;
    a.typed_name_cap = 0x200000000;
    var tn: decl.TypedName;
    val res_over: R.Result[u32, str] = add_typed_name(?a, tn);
    if (!R.is_err[u32, str](res_over)) { a.typed_name_len = 0; a.typed_name_cap = 0; dnit(?a); ret 1; }
    if (a.typed_name_len != 0x100000000) { dnit(?a); ret 1; }

    a.typed_name_len = 0;
    a.typed_name_cap = 0;
    val res_ok: R.Result[u32, str] = add_typed_name(?a, tn);
    if (R.is_err[u32, str](res_ok)) { dnit(?a); ret 1; }

    dnit(?a);
    ret 0;
}
