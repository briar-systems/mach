use page: std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;

use A: std.allocator;

use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.module;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.ast.type;
use mach.lang.fe.pool;
use mach.lang.fe.token;
use mach.lang.layout;
use mach.lang.source;

rec ModuleNodeIdDomain {
}

rec ExprIdDomain {
}

rec StmtIdDomain {
}

rec DeclIdDomain {
}

rec TypeIdDomain {
}

pub rec Ast {
    a:           *A.Allocator;
    file_id:     source.FileId;
    incarnation: u64;
    root_module: id.ModuleNodeId;

    modules:    *module.Module;
    module_len: usize;
    module_cap: usize;

    exprs:    *expr.Expr;
    expr_len: usize;
    expr_cap: usize;

    stmts:    *stmt.Stmt;
    stmt_len: usize;
    stmt_cap: usize;

    decls:    *decl.Decl;
    decl_len: usize;
    decl_cap: usize;

    types:    *type.Type;
    type_len: usize;
    type_cap: usize;

    typed_names:    *decl.TypedName;
    typed_name_len: usize;
    typed_name_cap: usize;

    tag_cases:    *decl.TagCase;
    tag_case_len: usize;
    tag_case_cap: usize;

    field_inits:    *expr.FieldInit;
    field_init_len: usize;
    field_init_cap: usize;

    generic_names:    *token.Span;
    generic_name_len: usize;
    generic_name_cap: usize;

    comptime_branches:    *decl.ComptimeBranch;
    comptime_branch_len:  usize;
    comptime_branch_cap:  usize;

    decorators:    *decl.Decorator;
    decorator_len: usize;
    decorator_cap: usize;

    decl_ids:    *id.DeclId;
    decl_id_len: usize;
    decl_id_cap: usize;

    stmt_ids:    *id.StmtId;
    stmt_id_len: usize;
    stmt_id_cap: usize;

    expr_ids:    *id.ExprId;
    expr_id_len: usize;
    expr_id_cap: usize;

    type_ids:    *id.TypeId;
    type_id_len: usize;
    type_id_cap: usize;
}

val INITIAL_NODE_CAP:    usize = 32;
val INITIAL_AUX_CAP:     usize = 16;
val INITIAL_ID_POOL_CAP: usize = 64;

pub fun init(a: *A.Allocator, file_id: source.FileId) Ast {
    var ast: Ast;
    ast.a           = a;
    ast.file_id     = file_id;
    ast.incarnation = 0;
    ast.root_module = id.MODULE_NODE_NIL;

    ast.modules    = nil;
    ast.module_len = 0;
    ast.module_cap = 0;

    ast.exprs    = nil;
    ast.expr_len = 0;
    ast.expr_cap = 0;

    ast.stmts    = nil;
    ast.stmt_len = 0;
    ast.stmt_cap = 0;

    ast.decls    = nil;
    ast.decl_len = 0;
    ast.decl_cap = 0;

    ast.types    = nil;
    ast.type_len = 0;
    ast.type_cap = 0;

    ast.typed_names    = nil;
    ast.typed_name_len = 0;
    ast.typed_name_cap = 0;

    ast.tag_cases    = nil;
    ast.tag_case_len = 0;
    ast.tag_case_cap = 0;

    ast.field_inits    = nil;
    ast.field_init_len = 0;
    ast.field_init_cap = 0;

    ast.generic_names    = nil;
    ast.generic_name_len = 0;
    ast.generic_name_cap = 0;

    ast.comptime_branches   = nil;
    ast.comptime_branch_len = 0;
    ast.comptime_branch_cap = 0;

    ast.decorators    = nil;
    ast.decorator_len = 0;
    ast.decorator_cap = 0;

    ast.decl_ids    = nil;
    ast.decl_id_len = 0;
    ast.decl_id_cap = 0;

    ast.stmt_ids    = nil;
    ast.stmt_id_len = 0;
    ast.stmt_id_cap = 0;

    ast.expr_ids    = nil;
    ast.expr_id_len = 0;
    ast.expr_id_cap = 0;

    ast.type_ids    = nil;
    ast.type_id_len = 0;
    ast.type_id_cap = 0;

    ret ast;
}

pub fun dnit(a: *Ast) {
    if (a == nil) { ret; }

    if (a.modules != nil && a.module_cap > 0) {
        A.deallocate[module.Module](a.a, a.modules, a.module_cap);
    }
    if (a.exprs != nil && a.expr_cap > 0) {
        A.deallocate[expr.Expr](a.a, a.exprs, a.expr_cap);
    }
    if (a.stmts != nil && a.stmt_cap > 0) {
        A.deallocate[stmt.Stmt](a.a, a.stmts, a.stmt_cap);
    }
    if (a.decls != nil && a.decl_cap > 0) {
        A.deallocate[decl.Decl](a.a, a.decls, a.decl_cap);
    }
    if (a.types != nil && a.type_cap > 0) {
        A.deallocate[type.Type](a.a, a.types, a.type_cap);
    }
    if (a.typed_names != nil && a.typed_name_cap > 0) {
        A.deallocate[decl.TypedName](a.a, a.typed_names, a.typed_name_cap);
    }

    if (a.tag_cases != nil && a.tag_case_cap > 0) {
        A.deallocate[decl.TagCase](a.a, a.tag_cases, a.tag_case_cap);
    }
    if (a.field_inits != nil && a.field_init_cap > 0) {
        A.deallocate[expr.FieldInit](a.a, a.field_inits, a.field_init_cap);
    }
    if (a.generic_names != nil && a.generic_name_cap > 0) {
        A.deallocate[token.Span](a.a, a.generic_names, a.generic_name_cap);
    }
    if (a.comptime_branches != nil && a.comptime_branch_cap > 0) {
        A.deallocate[decl.ComptimeBranch](a.a, a.comptime_branches, a.comptime_branch_cap);
    }
    if (a.decorators != nil && a.decorator_cap > 0) {
        A.deallocate[decl.Decorator](a.a, a.decorators, a.decorator_cap);
    }
    if (a.decl_ids != nil && a.decl_id_cap > 0) {
        A.deallocate[id.DeclId](a.a, a.decl_ids, a.decl_id_cap);
    }
    if (a.stmt_ids != nil && a.stmt_id_cap > 0) {
        A.deallocate[id.StmtId](a.a, a.stmt_ids, a.stmt_id_cap);
    }
    if (a.expr_ids != nil && a.expr_id_cap > 0) {
        A.deallocate[id.ExprId](a.a, a.expr_ids, a.expr_id_cap);
    }
    if (a.type_ids != nil && a.type_id_cap > 0) {
        A.deallocate[id.TypeId](a.a, a.type_ids, a.type_id_cap);
    }

    a.modules    = nil;
    a.module_len = 0;
    a.module_cap = 0;

    a.exprs    = nil;
    a.expr_len = 0;
    a.expr_cap = 0;

    a.stmts    = nil;
    a.stmt_len = 0;
    a.stmt_cap = 0;

    a.decls    = nil;
    a.decl_len = 0;
    a.decl_cap = 0;

    a.types    = nil;
    a.type_len = 0;
    a.type_cap = 0;

    a.typed_names    = nil;
    a.typed_name_len = 0;
    a.typed_name_cap = 0;

    a.tag_cases    = nil;
    a.tag_case_len = 0;
    a.tag_case_cap = 0;

    a.field_inits    = nil;
    a.field_init_len = 0;
    a.field_init_cap = 0;

    a.generic_names    = nil;
    a.generic_name_len = 0;
    a.generic_name_cap = 0;

    a.comptime_branches   = nil;
    a.comptime_branch_len = 0;
    a.comptime_branch_cap = 0;

    a.decorators    = nil;
    a.decorator_len = 0;
    a.decorator_cap = 0;

    a.decl_ids    = nil;
    a.decl_id_len = 0;
    a.decl_id_cap = 0;

    a.stmt_ids    = nil;
    a.stmt_id_len = 0;
    a.stmt_id_cap = 0;

    a.expr_ids    = nil;
    a.expr_id_len = 0;
    a.expr_id_cap = 0;

    a.type_ids    = nil;
    a.type_id_len = 0;
    a.type_id_cap = 0;

    a.root_module = id.MODULE_NODE_NIL;
}

pub fun add_module(a: *Ast, m: module.Module) res[id.ModuleNodeId, fail.Fail] {
    if (a.module_len == a.module_cap) {
        val res_modules: res[*module.Module, A.Error] = pool.grow[module.Module](a.a, a.modules, a.module_cap, INITIAL_NODE_CAP, ?a.module_cap);
        if (sel res_modules.err) {
            ret res[id.ModuleNodeId, fail.Fail].err{fail.refused(res_modules.err)};
        }
        a.modules = res_modules.ok;
    }
    val checked_id: res[layout.CheckedId[ModuleNodeIdDomain], layout.CheckCause] =
        layout.id_below[ModuleNodeIdDomain](a.module_len, layout.count[ModuleNodeIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[id.ModuleNodeId, fail.Fail].err{fail.message("ast: module id exhausts its 32-bit domain")};
    }
    val new_id: id.ModuleNodeId = checked_id.ok.value::u32;
    a.modules[a.module_len] = m;
    a.module_len = a.module_len + 1;
    ret res[id.ModuleNodeId, fail.Fail].ok{new_id};
}

pub fun get_module(a: *Ast, id_: id.ModuleNodeId) opt[*module.Module] {
    if (id_::usize >= a.module_len) { ret opt[*module.Module].none{}; }
    ret opt[*module.Module].some{?a.modules[id_]};
}

pub fun add_expr(a: *Ast, e: expr.Expr) res[id.ExprId, fail.Fail] {
    if (a.expr_len == a.expr_cap) {
        val res_exprs: res[*expr.Expr, A.Error] = pool.grow[expr.Expr](a.a, a.exprs, a.expr_cap, INITIAL_NODE_CAP, ?a.expr_cap);
        if (sel res_exprs.err) {
            ret res[id.ExprId, fail.Fail].err{fail.refused(res_exprs.err)};
        }
        a.exprs = res_exprs.ok;
    }
    val checked_id: res[layout.CheckedId[ExprIdDomain], layout.CheckCause] =
        layout.id_below[ExprIdDomain](a.expr_len, layout.count[ExprIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[id.ExprId, fail.Fail].err{fail.message("ast: expr id exhausts its 32-bit domain")};
    }
    val new_id: id.ExprId = checked_id.ok.value::u32;
    a.exprs[a.expr_len] = e;
    a.expr_len = a.expr_len + 1;
    ret res[id.ExprId, fail.Fail].ok{new_id};
}

pub fun get_expr(a: *Ast, id_: id.ExprId) opt[*expr.Expr] {
    if (id_::usize >= a.expr_len) { ret opt[*expr.Expr].none{}; }
    ret opt[*expr.Expr].some{?a.exprs[id_]};
}

pub fun expr_place_kind(e: *expr.Expr) expr.ExprKind {
    val k: expr.ExprKind = e.kind;
    if (k == expr.EXPR_KIND_IDENT
        || k == expr.EXPR_KIND_MEMBER
        || k == expr.EXPR_KIND_PROJECT
        || k == expr.EXPR_KIND_INDEX
        || k == expr.EXPR_KIND_CALL) { ret k; }
    if (k == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_DEREF) { ret k; }
    ret expr.EXPR_KIND_ERROR;
}

pub fun add_stmt(a: *Ast, s: stmt.Stmt) res[id.StmtId, fail.Fail] {
    if (a.stmt_len == a.stmt_cap) {
        val res_stmts: res[*stmt.Stmt, A.Error] = pool.grow[stmt.Stmt](a.a, a.stmts, a.stmt_cap, INITIAL_NODE_CAP, ?a.stmt_cap);
        if (sel res_stmts.err) {
            ret res[id.StmtId, fail.Fail].err{fail.refused(res_stmts.err)};
