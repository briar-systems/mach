    val checked_id: res[layout.CheckedId[StmtIdDomain], layout.CheckCause] =
        layout.id_below[StmtIdDomain](a.stmt_len, layout.count[StmtIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[id.StmtId, fail.Fail].err{fail.message("ast: stmt id exhausts its 32-bit domain")};
    }
    val new_id: id.StmtId = checked_id.ok.value::u32;
    a.stmts[a.stmt_len] = s;
    a.stmt_len = a.stmt_len + 1;
    ret res[id.StmtId, fail.Fail].ok{new_id};
}

pub fun get_stmt(a: *Ast, id_: id.StmtId) opt[*stmt.Stmt] {
    if (id_::usize >= a.stmt_len) { ret opt[*stmt.Stmt].none{}; }
    ret opt[*stmt.Stmt].some{?a.stmts[id_]};
