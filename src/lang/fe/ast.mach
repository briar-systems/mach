    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.tag_case_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: tag case index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.tag_cases[a.tag_case_len] = member;
    a.tag_case_len              = a.tag_case_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

