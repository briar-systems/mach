use mach.lang.fail;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;
use std.types.view.view;

use A: std.allocator;

use ast_decl:    mach.lang.fe.ast.decl;
use ast_expr:    mach.lang.fe.ast.expr;
use ast_id:      mach.lang.fe.ast.id;
use ast_module:  mach.lang.fe.ast.module;
use ast_stmt:    mach.lang.fe.ast.stmt;
use ast_type:    mach.lang.fe.ast.type;
use lang_source: mach.lang.source;

# one parsed file: each node kind and each side list lives in its own table, and a
# node is named by its index in that table
pub rec Ast {
    a:                 *A.Allocator;
    file_id:           lang_source.FileId;
    incarnation:       u64;
    root_module:       ast_id.ModuleNodeId;
    modules:           Vector[ast_module.Module];
    exprs:             Vector[ast_expr.Expr];
    stmts:             Vector[ast_stmt.Stmt];
    decls:             Vector[ast_decl.Decl];
    types:             Vector[ast_type.Type];
    typed_names:       Vector[ast_decl.TypedName];
    tag_cases:         Vector[ast_decl.TagCase];
    field_inits:       Vector[ast_expr.FieldInit];
    generic_names:     Vector[lang_source.Span];
    comptime_branches: Vector[ast_decl.ComptimeBranch];
    decorators:        Vector[ast_decl.Decorator];
    decl_ids:          Vector[ast_id.DeclId];
    stmt_ids:          Vector[ast_id.StmtId];
    expr_ids:          Vector[ast_id.ExprId];
    type_ids:          Vector[ast_id.TypeId];
    literal_bytes:     Vector[u8];
}

pub fun init(a: *A.Allocator, file_id: lang_source.FileId) Ast {
    var ast: Ast;
    ast.a                 = a;
    ast.file_id           = file_id;
    ast.incarnation       = 0;
    ast.root_module       = ast_id.MODULE_NODE_NIL;
    ast.modules           = collections_vector.init[ast_module.Module](a);
    ast.exprs             = collections_vector.init[ast_expr.Expr](a);
    ast.stmts             = collections_vector.init[ast_stmt.Stmt](a);
    ast.decls             = collections_vector.init[ast_decl.Decl](a);
    ast.types             = collections_vector.init[ast_type.Type](a);
    ast.typed_names       = collections_vector.init[ast_decl.TypedName](a);
    ast.tag_cases         = collections_vector.init[ast_decl.TagCase](a);
    ast.field_inits       = collections_vector.init[ast_expr.FieldInit](a);
    ast.generic_names     = collections_vector.init[lang_source.Span](a);
    ast.comptime_branches = collections_vector.init[ast_decl.ComptimeBranch](a);
    ast.decorators        = collections_vector.init[ast_decl.Decorator](a);
    ast.decl_ids          = collections_vector.init[ast_id.DeclId](a);
    ast.stmt_ids          = collections_vector.init[ast_id.StmtId](a);
    ast.expr_ids          = collections_vector.init[ast_id.ExprId](a);
    ast.type_ids          = collections_vector.init[ast_id.TypeId](a);
    ast.literal_bytes     = collections_vector.init[u8](a);
    ret ast;
}

pub fun dnit(a: *Ast) {
    if (a == nil) { ret; }
    collections_vector.dnit[ast_module.Module](?a.modules);
    collections_vector.dnit[ast_expr.Expr](?a.exprs);
    collections_vector.dnit[ast_stmt.Stmt](?a.stmts);
    collections_vector.dnit[ast_decl.Decl](?a.decls);
    collections_vector.dnit[ast_type.Type](?a.types);
    collections_vector.dnit[ast_decl.TypedName](?a.typed_names);
    collections_vector.dnit[ast_decl.TagCase](?a.tag_cases);
    collections_vector.dnit[ast_expr.FieldInit](?a.field_inits);
    collections_vector.dnit[lang_source.Span](?a.generic_names);
    collections_vector.dnit[ast_decl.ComptimeBranch](?a.comptime_branches);
    collections_vector.dnit[ast_decl.Decorator](?a.decorators);
    collections_vector.dnit[ast_id.DeclId](?a.decl_ids);
    collections_vector.dnit[ast_id.StmtId](?a.stmt_ids);
    collections_vector.dnit[ast_id.ExprId](?a.expr_ids);
    collections_vector.dnit[ast_id.TypeId](?a.type_ids);
    collections_vector.dnit[u8](?a.literal_bytes);
    a.root_module = ast_id.MODULE_NODE_NIL;
}

# an owned copy of `src` from `alloc`, every node at the id it has in `src`
pub fun copy(src: *Ast, alloc: *A.Allocator) res[Ast, fail.Fail] {
    var out: Ast = init(alloc, src.file_id);
    out.incarnation = src.incarnation;
    out.root_module = src.root_module;
    val modules: err[fail.Fail] = table_copy[ast_module.Module](?out.modules, ?src.modules);
    if (sel modules.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{modules.err};
    }
    val exprs: err[fail.Fail] = table_copy[ast_expr.Expr](?out.exprs, ?src.exprs);
    if (sel exprs.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{exprs.err};
    }
    val stmts: err[fail.Fail] = table_copy[ast_stmt.Stmt](?out.stmts, ?src.stmts);
    if (sel stmts.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{stmts.err};
    }
    val decls: err[fail.Fail] = table_copy[ast_decl.Decl](?out.decls, ?src.decls);
    if (sel decls.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{decls.err};
    }
    val types: err[fail.Fail] = table_copy[ast_type.Type](?out.types, ?src.types);
    if (sel types.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{types.err};
    }
    val typed_names: err[fail.Fail] = table_copy[ast_decl.TypedName](?out.typed_names, ?src.typed_names);
    if (sel typed_names.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{typed_names.err};
    }
    val tag_cases: err[fail.Fail] = table_copy[ast_decl.TagCase](?out.tag_cases, ?src.tag_cases);
    if (sel tag_cases.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{tag_cases.err};
    }
    val field_inits: err[fail.Fail] = table_copy[ast_expr.FieldInit](?out.field_inits, ?src.field_inits);
    if (sel field_inits.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{field_inits.err};
    }
    val generic_names: err[fail.Fail] = table_copy[lang_source.Span](?out.generic_names, ?src.generic_names);
    if (sel generic_names.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{generic_names.err};
    }
    val comptime_branches: err[fail.Fail] = table_copy[ast_decl.ComptimeBranch](?out.comptime_branches, ?src.comptime_branches);
    if (sel comptime_branches.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{comptime_branches.err};
    }
    val decorators: err[fail.Fail] = table_copy[ast_decl.Decorator](?out.decorators, ?src.decorators);
    if (sel decorators.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{decorators.err};
    }
    val decl_ids: err[fail.Fail] = table_copy[ast_id.DeclId](?out.decl_ids, ?src.decl_ids);
    if (sel decl_ids.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{decl_ids.err};
    }
    val stmt_ids: err[fail.Fail] = table_copy[ast_id.StmtId](?out.stmt_ids, ?src.stmt_ids);
    if (sel stmt_ids.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{stmt_ids.err};
    }
    val expr_ids: err[fail.Fail] = table_copy[ast_id.ExprId](?out.expr_ids, ?src.expr_ids);
    if (sel expr_ids.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{expr_ids.err};
    }
    val type_ids: err[fail.Fail] = table_copy[ast_id.TypeId](?out.type_ids, ?src.type_ids);
    if (sel type_ids.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{type_ids.err};
    }
    val literal_bytes: err[fail.Fail] = table_copy[u8](?out.literal_bytes, ?src.literal_bytes);
    if (sel literal_bytes.err) {
        dnit(?out);
        ret res[Ast, fail.Fail].err{literal_bytes.err};
    }
    ret res[Ast, fail.Fail].ok{out};
}

fun table_copy[T](dst: *Vector[T], src: *Vector[T]) err[fail.Fail] {
    if (src.len == 0) { ret err[fail.Fail].ok{}; }
    val reserved: res[usize, A.Error] = collections_vector.reserve[T](dst, src.len);
    if (sel reserved.err) { ret err[fail.Fail].err{fail.refused(reserved.err)}; }
    var i: usize = 0;
    for (i < src.len) {
        dst.data[i] = src.data[i];
        i           = i + 1;
    }
    dst.len = src.len;
    ret err[fail.Fail].ok{};
}

# the 32-bit id one more element takes, the last value being every id domain's nil
val ID_LIMIT: usize = 0xFFFFFFFF;

# appends `value` to an AST table and answers the index it takes
pub fun table_push[T](v: *Vector[T], value: T) res[u32, fail.Fail] {
    if (v.len >= ID_LIMIT) { ret res[u32, fail.Fail].err{fail.message("ast: a node table exhausts its 32-bit id domain")}; }
    val index: u32                 = v.len::u32;
    val grown: res[usize, A.Error] = collections_vector.push[T](v, value);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_module(a: *Ast, m: ast_module.Module) res[ast_id.ModuleNodeId, fail.Fail] {
    val index: res[u32, fail.Fail] = table_push[ast_module.Module](?a.modules, m);
    if (sel index.err) { ret res[ast_id.ModuleNodeId, fail.Fail].err{index.err}; }
    ret res[ast_id.ModuleNodeId, fail.Fail].ok{ast_id.module_node(index.ok)};
}

pub fun get_module(a: *Ast, id_: ast_id.ModuleNodeId) opt[*ast_module.Module] {
    val at: usize = ast_id.module_node_index(id_)::usize;
    if (at >= a.modules.len) { ret opt[*ast_module.Module].none{}; }
    ret opt[*ast_module.Module].some{?a.modules.data[at]};
}

pub fun add_expr(a: *Ast, e: ast_expr.Expr) res[ast_id.ExprId, fail.Fail] {
    val index: res[u32, fail.Fail] = table_push[ast_expr.Expr](?a.exprs, e);
    if (sel index.err) { ret res[ast_id.ExprId, fail.Fail].err{index.err}; }
    ret res[ast_id.ExprId, fail.Fail].ok{ast_id.expr(index.ok)};
}

pub fun get_expr(a: *Ast, id_: ast_id.ExprId) opt[*ast_expr.Expr] {
    val at: usize = ast_id.expr_index(id_)::usize;
    if (at >= a.exprs.len) { ret opt[*ast_expr.Expr].none{}; }
    ret opt[*ast_expr.Expr].some{?a.exprs.data[at]};
}

pub fun expr_place_kind(e: *ast_expr.Expr) ast_expr.ExprKind {
    val k: ast_expr.ExprKind = e.kind;
    if (k == ast_expr.EXPR_KIND_IDENT
        || k == ast_expr.EXPR_KIND_MEMBER
        || k == ast_expr.EXPR_KIND_PROJECT
        || k == ast_expr.EXPR_KIND_INDEX
        || k == ast_expr.EXPR_KIND_CALL) { ret k; }
    if (k == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_DEREF) { ret k; }
    ret ast_expr.EXPR_KIND_ERROR;
}

pub fun add_stmt(a: *Ast, s: ast_stmt.Stmt) res[ast_id.StmtId, fail.Fail] {
    val index: res[u32, fail.Fail] = table_push[ast_stmt.Stmt](?a.stmts, s);
    if (sel index.err) { ret res[ast_id.StmtId, fail.Fail].err{index.err}; }
    ret res[ast_id.StmtId, fail.Fail].ok{ast_id.stmt(index.ok)};
}

pub fun get_stmt(a: *Ast, id_: ast_id.StmtId) opt[*ast_stmt.Stmt] {
    val at: usize = ast_id.stmt_index(id_)::usize;
    if (at >= a.stmts.len) { ret opt[*ast_stmt.Stmt].none{}; }
    ret opt[*ast_stmt.Stmt].some{?a.stmts.data[at]};
}

pub fun add_decl(a: *Ast, d: ast_decl.Decl) res[ast_id.DeclId, fail.Fail] {
    val index: res[u32, fail.Fail] = table_push[ast_decl.Decl](?a.decls, d);
    if (sel index.err) { ret res[ast_id.DeclId, fail.Fail].err{index.err}; }
    ret res[ast_id.DeclId, fail.Fail].ok{ast_id.decl(index.ok)};
}

pub fun get_decl(a: *Ast, id_: ast_id.DeclId) opt[*ast_decl.Decl] {
    val at: usize = ast_id.decl_index(id_)::usize;
    if (at >= a.decls.len) { ret opt[*ast_decl.Decl].none{}; }
    ret opt[*ast_decl.Decl].some{?a.decls.data[at]};
}

pub fun decl_name_span(a: *Ast, id_: ast_id.DeclId) lang_source.Span {
    var empty: lang_source.Span;
    empty.offset = 0;
    empty.len    = 0;

    val opt_d: opt[*ast_decl.Decl] = get_decl(a, id_);
    if (!sel opt_d.some) { ret empty; }
    val d: *ast_decl.Decl = opt_d.some;

    if (d.kind == ast_decl.DECL_KIND_USE) { ret d.data.use_.alias; }
    if (d.kind == ast_decl.DECL_KIND_FWD) { ret d.data.fwd_.alias; }
    if (d.kind == ast_decl.DECL_KIND_FUN) { ret d.data.fun_.name; }
    if (d.kind == ast_decl.DECL_KIND_REC) { ret d.data.rec_.name; }
    if (d.kind == ast_decl.DECL_KIND_UNI) { ret d.data.uni_.name; }
    if (d.kind == ast_decl.DECL_KIND_TAG) { ret d.data.tag_.name; }
    if (d.kind == ast_decl.DECL_KIND_DEF) { ret d.data.def_.name; }
    if (d.kind == ast_decl.DECL_KIND_VAL) { ret d.data.bind.name; }
    if (d.kind == ast_decl.DECL_KIND_VAR) { ret d.data.bind.name; }
    ret empty;
}

pub fun add_type(a: *Ast, t: ast_type.Type) res[ast_id.TypeId, fail.Fail] {
    val index: res[u32, fail.Fail] = table_push[ast_type.Type](?a.types, t);
    if (sel index.err) { ret res[ast_id.TypeId, fail.Fail].err{index.err}; }
    ret res[ast_id.TypeId, fail.Fail].ok{ast_id.type(index.ok)};
}

pub fun get_type(a: *Ast, id_: ast_id.TypeId) opt[*ast_type.Type] {
    val at: usize = ast_id.type_index(id_)::usize;
    if (at >= a.types.len) { ret opt[*ast_type.Type].none{}; }
    ret opt[*ast_type.Type].some{?a.types.data[at]};
}

pub fun add_typed_name(a: *Ast, tn: ast_decl.TypedName) res[u32, fail.Fail] {
    ret table_push[ast_decl.TypedName](?a.typed_names, tn);
}

fun add_tag_case(a: *Ast, member: ast_decl.TagCase) res[u32, fail.Fail] {
    ret table_push[ast_decl.TagCase](?a.tag_cases, member);
}

# reached only by mach-lsp
pub fun add_field_init(a: *Ast, fi: ast_expr.FieldInit) res[u32, fail.Fail] {
    ret table_push[ast_expr.FieldInit](?a.field_inits, fi);
}

pub fun add_generic_name(a: *Ast, name: lang_source.Span) res[u32, fail.Fail] {
    ret table_push[lang_source.Span](?a.generic_names, name);
}

pub fun add_decorator(a: *Ast, d: ast_decl.Decorator) res[u32, fail.Fail] {
    ret table_push[ast_decl.Decorator](?a.decorators, d);
}

fun add_decl_id(a: *Ast, id_: ast_id.DeclId) res[u32, fail.Fail] {
    ret table_push[ast_id.DeclId](?a.decl_ids, id_);
}

# a table over storage the caller owns, for a test that builds nodes in place
# room for `n` more bytes at the end of the literal byte table, which literal_bytes_take
# then claims
pub fun literal_bytes_reserve(a: *Ast, n: usize) res[*u8, fail.Fail] {
    if (a.literal_bytes.len + n >= ID_LIMIT) { ret res[*u8, fail.Fail].err{fail.message("ast: the literal byte table exhausts its 32-bit range")}; }
    val grown: res[usize, A.Error] = collections_vector.reserve[u8](?a.literal_bytes, n);
    if (sel grown.err) { ret res[*u8, fail.Fail].err{fail.refused(grown.err)}; }
    ret res[*u8, fail.Fail].ok{?a.literal_bytes.data[a.literal_bytes.len]};
}

# claims the first `n` reserved bytes as one literal's value
pub fun literal_bytes_take(a: *Ast, n: usize) ast_expr.ByteRange {
    val range: ast_expr.ByteRange = ast_expr.ByteRange{start: a.literal_bytes.len::u32, len: n::u32};
    a.literal_bytes.len = a.literal_bytes.len + n;
    ret range;
}

# the decoded bytes a string literal names
pub fun lit_str_value(a: *Ast, e: *ast_expr.Expr) View {
    val range: ast_expr.ByteRange = e.data.lit_str.value;
    if (range.len == 0) { ret view(nil, 0); }
    ret view(?a.literal_bytes.data[range.start], range.len::usize);
}

#[testing]
pub fun table_over[T](data: *T, len: usize) Vector[T] {
    ret Vector[T]{a: nil, data: data, len: len, cap: 0};
}

# the length of every table, to roll a failed parse back to
pub rec AstMark {
    module_len:          usize;
    expr_len:            usize;
    stmt_len:            usize;
    decl_len:            usize;
    type_len:            usize;
    typed_name_len:      usize;
    tag_case_len:        usize;
    field_init_len:      usize;
    generic_name_len:    usize;
    comptime_branch_len: usize;
    decorator_len:       usize;
    decl_id_len:         usize;
    stmt_id_len:         usize;
    expr_id_len:         usize;
    type_id_len:         usize;
    literal_byte_len:    usize;
}

pub fun mark(a: *Ast) AstMark {
    var m: AstMark;
    m.module_len          = a.modules.len;
    m.expr_len            = a.exprs.len;
    m.stmt_len            = a.stmts.len;
    m.decl_len            = a.decls.len;
    m.type_len            = a.types.len;
    m.typed_name_len      = a.typed_names.len;
    m.tag_case_len        = a.tag_cases.len;
    m.field_init_len      = a.field_inits.len;
    m.generic_name_len    = a.generic_names.len;
    m.comptime_branch_len = a.comptime_branches.len;
    m.decorator_len       = a.decorators.len;
    m.decl_id_len         = a.decl_ids.len;
    m.stmt_id_len         = a.stmt_ids.len;
    m.expr_id_len         = a.expr_ids.len;
    m.type_id_len         = a.type_ids.len;
    m.literal_byte_len    = a.literal_bytes.len;
    ret m;
}

pub fun rollback(a: *Ast, m: AstMark) bool {
    if (m.module_len > a.modules.len)                    { ret false; }
    if (m.expr_len > a.exprs.len)                        { ret false; }
    if (m.stmt_len > a.stmts.len)                        { ret false; }
    if (m.decl_len > a.decls.len)                        { ret false; }
    if (m.type_len > a.types.len)                        { ret false; }
    if (m.typed_name_len > a.typed_names.len)            { ret false; }
    if (m.tag_case_len > a.tag_cases.len)                { ret false; }
    if (m.field_init_len > a.field_inits.len)            { ret false; }
    if (m.generic_name_len > a.generic_names.len)        { ret false; }
    if (m.comptime_branch_len > a.comptime_branches.len) { ret false; }
    if (m.decorator_len > a.decorators.len)              { ret false; }
    if (m.decl_id_len > a.decl_ids.len)                  { ret false; }
    if (m.stmt_id_len > a.stmt_ids.len)                  { ret false; }
    if (m.expr_id_len > a.expr_ids.len)                  { ret false; }
    if (m.type_id_len > a.type_ids.len)                  { ret false; }
    if (m.literal_byte_len > a.literal_bytes.len)        { ret false; }

    a.modules.len           = m.module_len;
    a.exprs.len             = m.expr_len;
    a.stmts.len             = m.stmt_len;
    a.decls.len             = m.decl_len;
    a.types.len             = m.type_len;
    a.typed_names.len       = m.typed_name_len;
    a.tag_cases.len         = m.tag_case_len;
    a.field_inits.len       = m.field_init_len;
    a.generic_names.len     = m.generic_name_len;
    a.comptime_branches.len = m.comptime_branch_len;
    a.decorators.len        = m.decorator_len;
    a.decl_ids.len          = m.decl_id_len;
    a.stmt_ids.len          = m.stmt_id_len;
    a.expr_ids.len          = m.expr_id_len;
    a.type_ids.len          = m.type_id_len;
    a.literal_bytes.len     = m.literal_byte_len;
    ret true;
}

# reached only by mach-lsp
pub fun span_contains(span: lang_source.Span, offset: usize) bool {
    if (span.len == 0)        { ret false; }
    if (offset < span.offset) { ret false; }
    ret offset < span.offset + span.len;
}

# the tightest expression enclosing a byte offset
# a linear scan of every expression; among equal spans the later one wins;
# an empty span never matches
# ---
# a:      the tree
# offset: byte offset into the tree's source text
# ret:    the ExprId with the smallest span containing offset, or EXPR_NIL when none does
pub fun offset_to_expr(a: *Ast, offset: usize) ast_id.ExprId {
    var best:     ast_id.ExprId = ast_id.EXPR_NIL;
    var best_len: usize         = 0;
    var i:        usize         = 0;
    for (i < a.exprs.len) {
        val sp: lang_source.Span = a.exprs.data[i].span;
        if (span_contains(sp, offset)) {
            if (ast_id.expr_is_nil(best) || sp.len <= best_len) {
                best     = ast_id.expr(i::u32);
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the tightest declaration enclosing a byte offset
# a linear scan of every declaration; among equal spans the later one wins;
# an empty span never matches
# ---
# a:      the tree
# offset: byte offset into the tree's source text
# ret:    the DeclId with the smallest span containing offset, or DECL_NIL when none does
pub fun offset_to_decl(a: *Ast, offset: usize) ast_id.DeclId {
    var best:     ast_id.DeclId = ast_id.DECL_NIL;
    var best_len: usize         = 0;
    var i:        usize         = 0;
    for (i < a.decls.len) {
        val sp: lang_source.Span = a.decls.data[i].span;
        if (span_contains(sp, offset)) {
            if (ast_id.decl_is_nil(best) || sp.len <= best_len) {
                best     = ast_id.decl(i::u32);
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the tightest type expression enclosing a byte offset
# a linear scan of every type node; among equal spans the later one wins;
# an empty span never matches
# ---
# a:      the tree
# offset: byte offset into the tree's source text
# ret:    the TypeId with the smallest span containing offset, or TYPE_NIL when none does
pub fun offset_to_type(a: *Ast, offset: usize) ast_id.TypeId {
    var best:     ast_id.TypeId = ast_id.TYPE_NIL;
    var best_len: usize         = 0;
    var i:        usize         = 0;
    for (i < a.types.len) {
        val sp: lang_source.Span = a.types.data[i].span;
        if (span_contains(sp, offset)) {
            if (ast_id.type_is_nil(best) || sp.len <= best_len) {
                best     = ast_id.type(i::u32);
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

#[testing]
fun span_make(offset: usize, len: usize) lang_source.Span {
    var sp: lang_source.Span;
    sp.offset = offset;
    sp.len    = len;
    ret sp;
}

#[testing]
fun expr_make(offset: usize, len: usize) ast_expr.Expr {
    var e: ast_expr.Expr;
    e.span           = span_make(offset, len);
    e.kind           = ast_expr.EXPR_KIND_IDENT;
    e.data.ident.tok = e.span;
    ret e;
}

test span_contains__half_open {
    val sp: lang_source.Span = span_make(10, 3);
    if (span_contains(sp, 9))              { ret 1; }
    if (!span_contains(sp, 10))            { ret 1; }
    if (!span_contains(sp, 12))            { ret 1; }
    if (span_contains(sp, 13))             { ret 1; }
    if (span_contains(span_make(5, 0), 5)) { ret 1; }
    ret 0;
}

test expr_place_kind__classifies_every_place_shape {
    var e: ast_expr.Expr;
    e.kind = ast_expr.EXPR_KIND_IDENT;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_IDENT) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_MEMBER;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_MEMBER) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_PROJECT;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_PROJECT) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_INDEX;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_INDEX) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_GENERIC_INSTANCE;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_ERROR) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_CALL;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_CALL) { ret 1; }
    e.kind          = ast_expr.EXPR_KIND_UNARY;
    e.data.unary.op = ast_expr.UN_DEREF;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_UNARY) { ret 1; }
    e.data.unary.op = ast_expr.UN_ADDR;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_ERROR) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_BINARY;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_ERROR) { ret 1; }
    ret 0;
}

test offset_to_expr__tightest_enclosing {
    var alloc:  A.Allocator;
    val made_1: err[A.Error] = page.make(?alloc);
    if (sel made_1.err) { ret 1; }
    var a: Ast = init(?alloc, lang_source.FILE_NIL);

    val res_outer: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 10));
    if (sel res_outer.err) {
        dnit(?a);
        ret 1;
    }
    val res_inner: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(2, 3));
    if (sel res_inner.err) {
        dnit(?a);
        ret 1;
    }
    val inner_id: ast_id.ExprId = res_inner.ok;
    val outer_id: ast_id.ExprId = res_outer.ok;

    if (!ast_id.expr_same(offset_to_expr(?a, 3), inner_id)) {
        dnit(?a);
        ret 1;
    }
    if (!ast_id.expr_same(offset_to_expr(?a, 7), outer_id)) {
        dnit(?a);
        ret 1;
    }
    if (!ast_id.expr_is_nil(offset_to_expr(?a, 99))) {
        dnit(?a);
        ret 1;
    }
    dnit(?a);
    ret 0;
}

test mark_rollback__discards_every_arena_grown_since_the_mark {
    var alloc:  A.Allocator;
    val made_2: err[A.Error] = page.make(?alloc);
    if (sel made_2.err) { ret 1; }
    var a: Ast = init(?alloc, lang_source.FILE_NIL);

    val add_expr_1: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel add_expr_1.err) {
        dnit(?a);
        ret 1;
    }
    val m: AstMark = mark(?a);

    val add_expr_2: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(1, 1));
    if (sel add_expr_2.err) {
        dnit(?a);
        ret 1;
    }
    var d:          ast_decl.Decl;
    val add_decl_3: res[ast_id.DeclId, fail.Fail] = add_decl(?a, d);
    if (sel add_decl_3.err) {
        dnit(?a);
        ret 1;
    }
    val add_decl_id_4: res[u32, fail.Fail] = add_decl_id(?a, ast_id.decl(0));
    if (sel add_decl_id_4.err) {
        dnit(?a);
        ret 1;
    }
    var member: ast_decl.TagCase;
    member.payload = ast_id.TYPE_NIL;
    val add_tag_case_5: res[u32, fail.Fail] = add_tag_case(?a, member);
    if (sel add_tag_case_5.err) {
        dnit(?a);
        ret 1;
    }
    if (a.tag_cases.len != 1) {
        dnit(?a);
        ret 1;
    }
    if (a.exprs.len != 2 || a.decls.len != 1 || a.decl_ids.len != 1) {
        dnit(?a);
        ret 1;
    }

    if (!rollback(?a, m)) {
        dnit(?a);
        ret 1;
    }
    if (a.tag_cases.len != 0) {
        dnit(?a);
        ret 1;
    }
    if (a.exprs.len != 1 || a.decls.len != 0 || a.decl_ids.len != 0) {
        dnit(?a);
        ret 1;
    }

    val kept: opt[*ast_expr.Expr] = get_expr(?a, ast_id.expr(0));
    if (!sel kept.some) {
        dnit(?a);
        ret 1;
    }
    if (kept.some.span.offset != 0) {
        dnit(?a);
        ret 1;
    }

    dnit(?a);
    ret 0;
}

test rollback__rejects_a_mark_taken_after_an_earlier_rollback_already_ran {
    var alloc:  A.Allocator;
    val made_3: err[A.Error] = page.make(?alloc);
    if (sel made_3.err) { ret 1; }
    var a: Ast = init(?alloc, lang_source.FILE_NIL);

    val m0:         AstMark                       = mark(?a);
    val add_expr_1: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel add_expr_1.err) {
        dnit(?a);
        ret 1;
    }
    val m_ahead:    AstMark                       = mark(?a);
    val add_expr_2: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(1, 1));
    if (sel add_expr_2.err) {
        dnit(?a);
        ret 1;
    }
    if (a.exprs.len != 2) {
        dnit(?a);
        ret 1;
    }

    if (!rollback(?a, m0)) {
        dnit(?a);
        ret 1;
    }
    if (a.exprs.len != 0) {
        dnit(?a);
        ret 1;
    }

    if (rollback(?a, m_ahead)) {
        dnit(?a);
        ret 1;
    }
    if (a.exprs.len != 0) {
        dnit(?a);
        ret 1;
    }

    dnit(?a);
    ret 0;
}

# every arena refuses the id that would reach its nil sentinel or pass the u32 index limit,
# and leaves its length untouched
test add__refuses_an_id_past_its_domain {
    var alloc:  A.Allocator;
    val made_5: err[A.Error] = page.make(?alloc);
    if (sel made_5.err) { ret 1; }
    var a:  Ast = init(?alloc, lang_source.FILE_NIL);
    var rc: i32 = 0;

    a.exprs.len = 0xFFFFFFFF;
    a.exprs.cap = 0x100000000;
    val expr_over: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel expr_over.ok || a.exprs.len != 0xFFFFFFFF) { rc = 1; }
    a.exprs.len = 0;
    a.exprs.cap = 0;

    a.modules.len = 0xFFFFFFFF;
    a.modules.cap = 0x100000000;
    var mo:          ast_module.Module;
    val module_over: res[ast_id.ModuleNodeId, fail.Fail] = add_module(?a, mo);
    if (sel module_over.ok) { rc = 2; }
    a.modules.len = 0;
    a.modules.cap = 0;

    a.stmts.len = 0xFFFFFFFF;
    a.stmts.cap = 0x100000000;
    var s:         ast_stmt.Stmt;
    val stmt_over: res[ast_id.StmtId, fail.Fail] = add_stmt(?a, s);
    if (sel stmt_over.ok) { rc = 3; }
    a.stmts.len = 0;
    a.stmts.cap = 0;

    a.decls.len = 0xFFFFFFFF;
    a.decls.cap = 0x100000000;
    var d:         ast_decl.Decl;
    val decl_over: res[ast_id.DeclId, fail.Fail] = add_decl(?a, d);
    if (sel decl_over.ok) { rc = 4; }
    a.decls.len = 0;
    a.decls.cap = 0;

    a.types.len = 0xFFFFFFFF;
    a.types.cap = 0x100000000;
    var t:         ast_type.Type;
    val type_over: res[ast_id.TypeId, fail.Fail] = add_type(?a, t);
    if (sel type_over.ok) { rc = 5; }
    a.types.len = 0;
    a.types.cap = 0;

    a.typed_names.len = 0x100000000;
    a.typed_names.cap = 0x200000000;
    var tn:        ast_decl.TypedName;
    val name_over: res[u32, fail.Fail] = add_typed_name(?a, tn);
    if (sel name_over.ok || a.typed_names.len != 0x100000000) { rc = 6; }
    a.typed_names.len = 0;
    a.typed_names.cap = 0;

    val expr_ok: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel expr_ok.err) { rc = 7; }
    if (sel expr_ok.ok) {
        if (!ast_id.expr_same(expr_ok.ok, ast_id.expr(0))) { rc = 7; }
    }

    dnit(?a);
    ret rc;
}
