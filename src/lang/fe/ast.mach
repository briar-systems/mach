    if (sel res_over.ok) { a.module_len = 0; a.module_cap = 0; dnit(?a); ret 1; }

    a.module_len = 0;
    a.module_cap = 0;
    dnit(?a);
    ret 0;
}

test "mach.lang.fe.ast.add_stmt:refuses_a_stmt_id_at_the_stmt_nil_sentinel" {
    var alloc: A.Allocator;
