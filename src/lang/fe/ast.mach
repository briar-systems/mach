pub fun add_decl_id(a: *Ast, id_: id.DeclId) res[u32, fail.Fail] {
    if (a.decl_id_len == a.decl_id_cap) {
        val res_decl_ids: res[*id.DeclId, A.Error] = pool.grow[id.DeclId](a.a, a.decl_ids, a.decl_id_cap, INITIAL_ID_POOL_CAP, ?a.decl_id_cap);
        if (sel res_decl_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_decl_ids.err)};
        }
        a.decl_ids = res_decl_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.decl_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: decl-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.decl_ids[a.decl_id_len] = id_;
    a.decl_id_len = a.decl_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_stmt_id(a: *Ast, id_: id.StmtId) res[u32, fail.Fail] {
    if (a.stmt_id_len == a.stmt_id_cap) {
        val res_stmt_ids: res[*id.StmtId, A.Error] = pool.grow[id.StmtId](a.a, a.stmt_ids, a.stmt_id_cap, INITIAL_ID_POOL_CAP, ?a.stmt_id_cap);
        if (sel res_stmt_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_stmt_ids.err)};
        }
        a.stmt_ids = res_stmt_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.stmt_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: stmt-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.stmt_ids[a.stmt_id_len] = id_;
    a.stmt_id_len = a.stmt_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_expr_id(a: *Ast, id_: id.ExprId) res[u32, fail.Fail] {
    if (a.expr_id_len == a.expr_id_cap) {
        val res_expr_ids: res[*id.ExprId, A.Error] = pool.grow[id.ExprId](a.a, a.expr_ids, a.expr_id_cap, INITIAL_ID_POOL_CAP, ?a.expr_id_cap);
        if (sel res_expr_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_expr_ids.err)};
        }
        a.expr_ids = res_expr_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.expr_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: expr-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.expr_ids[a.expr_id_len] = id_;
    a.expr_id_len = a.expr_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_type_id(a: *Ast, id_: id.TypeId) res[u32, fail.Fail] {
    if (a.type_id_len == a.type_id_cap) {
        val res_type_ids: res[*id.TypeId, A.Error] = pool.grow[id.TypeId](a.a, a.type_ids, a.type_id_cap, INITIAL_ID_POOL_CAP, ?a.type_id_cap);
        if (sel res_type_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_type_ids.err)};
        }
        a.type_ids = res_type_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.type_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: type-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.type_ids[a.type_id_len] = id_;
    a.type_id_len = a.type_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub rec AstMark {
    module_len:          usize;
    expr_len:            usize;
    stmt_len:            usize;
    decl_len:            usize;
    type_len:            usize;
    typed_name_len:      usize;
    tag_case_len:        usize;
    field_init_len:      usize;
    generic_name_len:    usize;
    comptime_branch_len: usize;
    decorator_len:       usize;
    decl_id_len:         usize;
    stmt_id_len:         usize;
    expr_id_len:         usize;
    type_id_len:         usize;
}

pub fun mark(a: *Ast) AstMark {
    var m: AstMark;
    m.module_len          = a.module_len;
    m.expr_len             = a.expr_len;
    m.stmt_len              = a.stmt_len;
    m.decl_len               = a.decl_len;
    m.type_len                = a.type_len;
    m.typed_name_len           = a.typed_name_len;
    m.tag_case_len           = a.tag_case_len;
    m.field_init_len             = a.field_init_len;
    m.generic_name_len             = a.generic_name_len;
    m.comptime_branch_len            = a.comptime_branch_len;
    m.decorator_len                    = a.decorator_len;
    m.decl_id_len                        = a.decl_id_len;
    m.stmt_id_len                          = a.stmt_id_len;
    m.expr_id_len                            = a.expr_id_len;
    m.type_id_len                              = a.type_id_len;
    ret m;
}

pub fun rollback(a: *Ast, m: AstMark) bool {
    if (m.module_len > a.module_len)                   { ret false; }
    if (m.expr_len > a.expr_len)                        { ret false; }
    if (m.stmt_len > a.stmt_len)                         { ret false; }
    if (m.decl_len > a.decl_len)                          { ret false; }
    if (m.type_len > a.type_len)                           { ret false; }
    if (m.typed_name_len > a.typed_name_len)                { ret false; }
    if (m.tag_case_len > a.tag_case_len)                { ret false; }
    if (m.field_init_len > a.field_init_len)                 { ret false; }
    if (m.generic_name_len > a.generic_name_len)              { ret false; }
    if (m.comptime_branch_len > a.comptime_branch_len)         { ret false; }
    if (m.decorator_len > a.decorator_len)                      { ret false; }
    if (m.decl_id_len > a.decl_id_len)                           { ret false; }
    if (m.stmt_id_len > a.stmt_id_len)                            { ret false; }
    if (m.expr_id_len > a.expr_id_len)                             { ret false; }
    if (m.type_id_len > a.type_id_len)                              { ret false; }

    a.module_len          = m.module_len;
    a.expr_len             = m.expr_len;
    a.stmt_len              = m.stmt_len;
    a.decl_len               = m.decl_len;
    a.type_len                = m.type_len;
    a.typed_name_len           = m.typed_name_len;
    a.tag_case_len           = m.tag_case_len;
    a.field_init_len             = m.field_init_len;
    a.generic_name_len             = m.generic_name_len;
    a.comptime_branch_len            = m.comptime_branch_len;
    a.decorator_len                    = m.decorator_len;
    a.decl_id_len                        = m.decl_id_len;
    a.stmt_id_len                          = m.stmt_id_len;
    a.expr_id_len                            = m.expr_id_len;
    a.type_id_len                              = m.type_id_len;
    ret true;
}

pub fun span_contains(span: token.Span, offset: usize) bool {
    if (span.len == 0)        { ret false; }
    if (offset < span.offset) { ret false; }
    ret offset < span.offset + span.len;
}

# the tightest expression enclosing a byte offset
# a linear scan of every expression; among equal spans the later one wins;
# an empty span never matches
# ---
# a: the tree
# offset: byte offset into the tree's source text
# ret: the ExprId with the smallest span containing offset, or EXPR_NIL when none does
pub fun offset_to_expr(a: *Ast, offset: usize) id.ExprId {
    var best:     id.ExprId = id.EXPR_NIL;
    var best_len: usize     = 0;
    var i:        usize     = 0;
    for (i < a.expr_len) {
        val sp: token.Span = a.exprs[i].span;
        if (span_contains(sp, offset)) {
            if (best == id.EXPR_NIL || sp.len <= best_len) {
                best = i::id.ExprId;
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the tightest statement enclosing a byte offset
# a linear scan of every statement; among equal spans the later one wins;
# an empty span never matches
# ---
# a: the tree
# offset: byte offset into the tree's source text
# ret: the StmtId with the smallest span containing offset, or STMT_NIL when none does
pub fun offset_to_stmt(a: *Ast, offset: usize) id.StmtId {
    var best:     id.StmtId = id.STMT_NIL;
    var best_len: usize     = 0;
    var i:        usize     = 0;
    for (i < a.stmt_len) {
        val sp: token.Span = a.stmts[i].span;
        if (span_contains(sp, offset)) {
            if (best == id.STMT_NIL || sp.len <= best_len) {
                best = i::id.StmtId;
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the tightest declaration enclosing a byte offset
# a linear scan of every declaration; among equal spans the later one wins;
# an empty span never matches
# ---
# a: the tree
# offset: byte offset into the tree's source text
# ret: the DeclId with the smallest span containing offset, or DECL_NIL when none does
pub fun offset_to_decl(a: *Ast, offset: usize) id.DeclId {
    var best:     id.DeclId = id.DECL_NIL;
    var best_len: usize     = 0;
    var i:        usize     = 0;
    for (i < a.decl_len) {
        val sp: token.Span = a.decls[i].span;
        if (span_contains(sp, offset)) {
            if (best == id.DECL_NIL || sp.len <= best_len) {
                best = i::id.DeclId;
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the tightest type expression enclosing a byte offset
# a linear scan of every type node; among equal spans the later one wins;
# an empty span never matches
# ---
# a: the tree
# offset: byte offset into the tree's source text
# ret: the TypeId with the smallest span containing offset, or TYPE_NIL when none does
pub fun offset_to_type(a: *Ast, offset: usize) id.TypeId {
    var best:     id.TypeId = id.TYPE_NIL;
    var best_len: usize     = 0;
    var i:        usize     = 0;
    for (i < a.type_len) {
        val sp: token.Span = a.types[i].span;
        if (span_contains(sp, offset)) {
            if (best == id.TYPE_NIL || sp.len <= best_len) {
                best = i::id.TypeId;
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

fun span_make(offset: usize, len: usize) token.Span {
    var sp: token.Span;
    sp.offset = offset;
    sp.len    = len;
    ret sp;
}

fun expr_make(offset: usize, len: usize) expr.Expr {
    var e: expr.Expr;
    e.span = span_make(offset, len);
    e.kind = expr.EXPR_KIND_IDENT;
    ret e;
}

test "mach.lang.fe.ast.span_contains:half_open" {
    val sp: token.Span = span_make(10, 3);
    if (span_contains(sp, 9))              { ret 1; }
    if (!span_contains(sp, 10))            { ret 1; }
    if (!span_contains(sp, 12))            { ret 1; }
    if (span_contains(sp, 13))             { ret 1; }
    if (span_contains(span_make(5, 0), 5)) { ret 1; }
    ret 0;
}

test "mach.lang.fe.ast.expr_place_kind:classifies_every_place_shape" {
    var e: expr.Expr;
    e.kind = expr.EXPR_KIND_IDENT;
    if (expr_place_kind(?e) != expr.EXPR_KIND_IDENT) { ret 1; }
    e.kind = expr.EXPR_KIND_MEMBER;
    if (expr_place_kind(?e) != expr.EXPR_KIND_MEMBER) { ret 1; }
    e.kind = expr.EXPR_KIND_PROJECT;
    if (expr_place_kind(?e) != expr.EXPR_KIND_PROJECT) { ret 1; }
    e.kind = expr.EXPR_KIND_INDEX;
    if (expr_place_kind(?e) != expr.EXPR_KIND_INDEX) { ret 1; }
    e.kind = expr.EXPR_KIND_GENERIC_INSTANCE;
    if (expr_place_kind(?e) != expr.EXPR_KIND_ERROR) { ret 1; }
    e.kind = expr.EXPR_KIND_CALL;
    if (expr_place_kind(?e) != expr.EXPR_KIND_CALL) { ret 1; }
    e.kind = expr.EXPR_KIND_UNARY;
    e.data.unary.op = expr.UN_DEREF;
    if (expr_place_kind(?e) != expr.EXPR_KIND_UNARY) { ret 1; }
    e.data.unary.op = expr.UN_ADDR;
    if (expr_place_kind(?e) != expr.EXPR_KIND_ERROR) { ret 1; }
    e.kind = expr.EXPR_KIND_BINARY;
    if (expr_place_kind(?e) != expr.EXPR_KIND_ERROR) { ret 1; }
    ret 0;
}

test "mach.lang.fe.ast.offset_to_expr:tightest_enclosing" {
    var alloc: A.Allocator;
    val made_1: err[A.Error] = page.make(?alloc);
    if (sel made_1.err) { ret 1; }
    var a: Ast = init(?alloc, 0::source.FileId);

    val res_outer: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 10));
    if (sel res_outer.err) { dnit(?a); ret 1; }
    val res_inner: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(2, 3));
    if (sel res_inner.err) { dnit(?a); ret 1; }
    val inner_id: id.ExprId = res_inner.ok;
    val outer_id: id.ExprId = res_outer.ok;

    if (offset_to_expr(?a, 3) != inner_id)     { dnit(?a); ret 1; }
    if (offset_to_expr(?a, 7) != outer_id)     { dnit(?a); ret 1; }
    if (offset_to_expr(?a, 99) != id.EXPR_NIL) { dnit(?a); ret 1; }
    dnit(?a);
    ret 0;
}

test "mach.lang.fe.ast.mark_rollback:discards_every_arena_grown_since_the_mark" {
    var alloc: A.Allocator;
    val made_2: err[A.Error] = page.make(?alloc);
    if (sel made_2.err) { ret 1; }
    var a: Ast = init(?alloc, 0::source.FileId);

    val add_expr_1: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel add_expr_1.err) { dnit(?a); ret 1; }
    val m: AstMark = mark(?a);

    val add_expr_2: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(1, 1));
    if (sel add_expr_2.err) { dnit(?a); ret 1; }
    var d: decl.Decl;
    val add_decl_3: res[id.DeclId, fail.Fail] = add_decl(?a, d);
    if (sel add_decl_3.err)               { dnit(?a); ret 1; }
    val add_decl_id_4: res[u32, fail.Fail] = add_decl_id(?a, 0::id.DeclId);
    if (sel add_decl_id_4.err)       { dnit(?a); ret 1; }
    var member: decl.TagCase;
    member.payload = id.TYPE_NIL;
    val add_tag_case_5: res[u32, fail.Fail] = add_tag_case(?a, member);
    if (sel add_tag_case_5.err) { dnit(?a); ret 1; }
    if (a.tag_case_len != 1) { dnit(?a); ret 1; }
    if (a.expr_len != 2 || a.decl_len != 1 || a.decl_id_len != 1) { dnit(?a); ret 1; }

    if (!rollback(?a, m)) { dnit(?a); ret 1; }
    if (a.tag_case_len != 0) { dnit(?a); ret 1; }
    if (a.expr_len != 1 || a.decl_len != 0 || a.decl_id_len != 0) { dnit(?a); ret 1; }

    val kept: opt[*expr.Expr] = get_expr(?a, 0::id.ExprId);
    if (!sel kept.some) { dnit(?a); ret 1; }
    if (kept.some.span.offset != 0) { dnit(?a); ret 1; }

    dnit(?a);
    ret 0;
}

test "mach.lang.fe.ast.rollback:rejects_a_mark_taken_after_an_earlier_rollback_already_ran" {
    var alloc: A.Allocator;
    val made_3: err[A.Error] = page.make(?alloc);
    if (sel made_3.err) { ret 1; }
    var a: Ast = init(?alloc, 0::source.FileId);

    val m0: AstMark = mark(?a);
    val add_expr_1: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel add_expr_1.err) { dnit(?a); ret 1; }
    val m_ahead: AstMark = mark(?a);
    val add_expr_2: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(1, 1));
    if (sel add_expr_2.err) { dnit(?a); ret 1; }
    if (a.expr_len != 2) { dnit(?a); ret 1; }

    if (!rollback(?a, m0)) { dnit(?a); ret 1; }
    if (a.expr_len != 0) { dnit(?a); ret 1; }

    if (rollback(?a, m_ahead)) { dnit(?a); ret 1; }
    if (a.expr_len != 0) { dnit(?a); ret 1; }

    dnit(?a);
    ret 0;
}

test "mach.lang.fe.ast:offset_miss_returns_nil" {
    var alloc: A.Allocator;
    val made_4: err[A.Error] = page.make(?alloc);
    if (sel made_4.err) { ret 1; }
    var a: Ast = init(?alloc, 0::source.FileId);

    if (offset_to_expr(?a, 0) != id.EXPR_NIL) { dnit(?a); ret 1; }
    if (offset_to_stmt(?a, 0) != id.STMT_NIL) { dnit(?a); ret 1; }
    if (offset_to_decl(?a, 0) != id.DECL_NIL) { dnit(?a); ret 1; }
    if (offset_to_type(?a, 0) != id.TYPE_NIL) { dnit(?a); ret 1; }
    dnit(?a);
    ret 0;
}

test "mach.lang.fe.ast.add_expr:refuses_an_expr_id_at_the_expr_nil_sentinel" {
    var alloc: A.Allocator;
    val made_5: err[A.Error] = page.make(?alloc);
    if (sel made_5.err) { ret 1; }
    var a: Ast = init(?alloc, 0::source.FileId);

    a.expr_len = 0xFFFFFFFF;
    a.expr_cap = 0x100000000;
    val res_over: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel res_over.ok) { a.expr_len = 0; a.expr_cap = 0; dnit(?a); ret 1; }
    if (a.expr_len != 0xFFFFFFFF)            { dnit(?a); ret 1; }

    a.expr_len = 0;
    a.expr_cap = 0;
    val res_ok: res[id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel res_ok.err)                     { dnit(?a); ret 1; }
    if (res_ok.ok != 0::id.ExprId)  { dnit(?a); ret 1; }

    dnit(?a);
    ret 0;
}

test "mach.lang.fe.ast.add_module:refuses_a_module_id_at_the_module_nil_sentinel" {
    var alloc: A.Allocator;
    val made_6: err[A.Error] = page.make(?alloc);
