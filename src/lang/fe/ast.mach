pub fun add_decorator(a: *Ast, d: ast_decl.Decorator) res[u32, fail.Fail] {
    if (a.decorator_len == a.decorator_cap) {
        val res_decorators: res[*ast_decl.Decorator, std_allocator.Error] = pool.grow[ast_decl.Decorator](a.a, a.decorators, a.decorator_cap, INITIAL_AUX_CAP, ?a.decorator_cap);
        if (sel res_decorators.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_decorators.err)};
        }
        a.decorators = res_decorators.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.decorator_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: decorator index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.decorators[a.decorator_len] = d;
    a.decorator_len               = a.decorator_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_decl_id(a: *Ast, id_: ast_id.DeclId) res[u32, fail.Fail] {
    if (a.decl_id_len == a.decl_id_cap) {
        val res_decl_ids: res[*ast_id.DeclId, std_allocator.Error] = pool.grow[ast_id.DeclId](a.a, a.decl_ids, a.decl_id_cap, INITIAL_ID_POOL_CAP, ?a.decl_id_cap);
        if (sel res_decl_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_decl_ids.err)};
        }
        a.decl_ids = res_decl_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.decl_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: decl-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.decl_ids[a.decl_id_len] = id_;
    a.decl_id_len             = a.decl_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_stmt_id(a: *Ast, id_: ast_id.StmtId) res[u32, fail.Fail] {
    if (a.stmt_id_len == a.stmt_id_cap) {
        val res_stmt_ids: res[*ast_id.StmtId, std_allocator.Error] = pool.grow[ast_id.StmtId](a.a, a.stmt_ids, a.stmt_id_cap, INITIAL_ID_POOL_CAP, ?a.stmt_id_cap);
        if (sel res_stmt_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_stmt_ids.err)};
        }
        a.stmt_ids = res_stmt_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.stmt_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: stmt-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.stmt_ids[a.stmt_id_len] = id_;
    a.stmt_id_len             = a.stmt_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_expr_id(a: *Ast, id_: ast_id.ExprId) res[u32, fail.Fail] {
    if (a.expr_id_len == a.expr_id_cap) {
        val res_expr_ids: res[*ast_id.ExprId, std_allocator.Error] = pool.grow[ast_id.ExprId](a.a, a.expr_ids, a.expr_id_cap, INITIAL_ID_POOL_CAP, ?a.expr_id_cap);
        if (sel res_expr_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_expr_ids.err)};
        }
        a.expr_ids = res_expr_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.expr_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: expr-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.expr_ids[a.expr_id_len] = id_;
    a.expr_id_len             = a.expr_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub fun add_type_id(a: *Ast, id_: ast_id.TypeId) res[u32, fail.Fail] {
    if (a.type_id_len == a.type_id_cap) {
        val res_type_ids: res[*ast_id.TypeId, std_allocator.Error] = pool.grow[ast_id.TypeId](a.a, a.type_ids, a.type_id_cap, INITIAL_ID_POOL_CAP, ?a.type_id_cap);
        if (sel res_type_ids.err) {
            ret res[u32, fail.Fail].err{fail.refused(res_type_ids.err)};
        }
        a.type_ids = res_type_ids.ok;
    }
    val index_r: res[u32, layout.CheckCause] = layout.usize_to_u32(a.type_id_len);
    if (sel index_r.err) {
        ret res[u32, fail.Fail].err{fail.message("ast: type-id pool index exceeds the u32 limit")};
    }
    val index: u32 = index_r.ok;
    a.type_ids[a.type_id_len] = id_;
    a.type_id_len             = a.type_id_len + 1;
    ret res[u32, fail.Fail].ok{index};
}

pub rec AstMark {
    module_len:          usize;
    expr_len:            usize;
    stmt_len:            usize;
    decl_len:            usize;
    type_len:            usize;
    typed_name_len:      usize;
    tag_case_len:        usize;
    field_init_len:      usize;
    generic_name_len:    usize;
    comptime_branch_len: usize;
    decorator_len:       usize;
    decl_id_len:         usize;
    stmt_id_len:         usize;
    expr_id_len:         usize;
    type_id_len:         usize;
}

pub fun mark(a: *Ast) AstMark {
    var m: AstMark;
    m.module_len          = a.module_len;
    m.expr_len            = a.expr_len;
    m.stmt_len            = a.stmt_len;
    m.decl_len            = a.decl_len;
    m.type_len            = a.type_len;
    m.typed_name_len      = a.typed_name_len;
    m.tag_case_len        = a.tag_case_len;
    m.field_init_len      = a.field_init_len;
    m.generic_name_len    = a.generic_name_len;
    m.comptime_branch_len = a.comptime_branch_len;
    m.decorator_len       = a.decorator_len;
    m.decl_id_len         = a.decl_id_len;
    m.stmt_id_len         = a.stmt_id_len;
    m.expr_id_len         = a.expr_id_len;
    m.type_id_len         = a.type_id_len;
    ret m;
}

pub fun rollback(a: *Ast, m: AstMark) bool {
    if (m.module_len > a.module_len)                   { ret false; }
    if (m.expr_len > a.expr_len)                       { ret false; }
    if (m.stmt_len > a.stmt_len)                       { ret false; }
    if (m.decl_len > a.decl_len)                       { ret false; }
    if (m.type_len > a.type_len)                       { ret false; }
    if (m.typed_name_len > a.typed_name_len)           { ret false; }
    if (m.tag_case_len > a.tag_case_len)               { ret false; }
    if (m.field_init_len > a.field_init_len)           { ret false; }
    if (m.generic_name_len > a.generic_name_len)       { ret false; }
    if (m.comptime_branch_len > a.comptime_branch_len) { ret false; }
    if (m.decorator_len > a.decorator_len)             { ret false; }
    if (m.decl_id_len > a.decl_id_len)                 { ret false; }
    if (m.stmt_id_len > a.stmt_id_len)                 { ret false; }
    if (m.expr_id_len > a.expr_id_len)                 { ret false; }
    if (m.type_id_len > a.type_id_len)                 { ret false; }

    a.module_len          = m.module_len;
    a.expr_len            = m.expr_len;
    a.stmt_len            = m.stmt_len;
    a.decl_len            = m.decl_len;
    a.type_len            = m.type_len;
    a.typed_name_len      = m.typed_name_len;
    a.tag_case_len        = m.tag_case_len;
    a.field_init_len      = m.field_init_len;
    a.generic_name_len    = m.generic_name_len;
    a.comptime_branch_len = m.comptime_branch_len;
    a.decorator_len       = m.decorator_len;
    a.decl_id_len         = m.decl_id_len;
    a.stmt_id_len         = m.stmt_id_len;
    a.expr_id_len         = m.expr_id_len;
    a.type_id_len         = m.type_id_len;
    ret true;
}

pub fun span_contains(span: token.Span, offset: usize) bool {
    if (span.len == 0)        { ret false; }
    if (offset < span.offset) { ret false; }
    ret offset < span.offset + span.len;
}

# the tightest expression enclosing a byte offset
# a linear scan of every expression; among equal spans the later one wins;
# an empty span never matches
# ---
# a:      the tree
# offset: byte offset into the tree's source text
# ret:    the ExprId with the smallest span containing offset, or EXPR_NIL when none does
pub fun offset_to_expr(a: *Ast, offset: usize) ast_id.ExprId {
    var best:     ast_id.ExprId = ast_id.EXPR_NIL;
    var best_len: usize         = 0;
    var i:        usize         = 0;
    for (i < a.expr_len) {
        val sp: token.Span = a.exprs[i].span;
        if (span_contains(sp, offset)) {
            if (best == ast_id.EXPR_NIL || sp.len <= best_len) {
                best     = i::ast_id.ExprId;
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the tightest declaration enclosing a byte offset
# a linear scan of every declaration; among equal spans the later one wins;
# an empty span never matches
# ---
# a:      the tree
# offset: byte offset into the tree's source text
# ret:    the DeclId with the smallest span containing offset, or DECL_NIL when none does
pub fun offset_to_decl(a: *Ast, offset: usize) ast_id.DeclId {
    var best:     ast_id.DeclId = ast_id.DECL_NIL;
    var best_len: usize         = 0;
    var i:        usize         = 0;
    for (i < a.decl_len) {
        val sp: token.Span = a.decls[i].span;
        if (span_contains(sp, offset)) {
            if (best == ast_id.DECL_NIL || sp.len <= best_len) {
                best     = i::ast_id.DeclId;
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

# the tightest type expression enclosing a byte offset
# a linear scan of every type node; among equal spans the later one wins;
# an empty span never matches
# ---
# a:      the tree
# offset: byte offset into the tree's source text
# ret:    the TypeId with the smallest span containing offset, or TYPE_NIL when none does
pub fun offset_to_type(a: *Ast, offset: usize) ast_id.TypeId {
    var best:     ast_id.TypeId = ast_id.TYPE_NIL;
    var best_len: usize         = 0;
    var i:        usize         = 0;
    for (i < a.type_len) {
        val sp: token.Span = a.types[i].span;
        if (span_contains(sp, offset)) {
            if (best == ast_id.TYPE_NIL || sp.len <= best_len) {
                best     = i::ast_id.TypeId;
                best_len = sp.len;
            }
        }
        i = i + 1;
    }
    ret best;
}

#[testing]
fun span_make(offset: usize, len: usize) token.Span {
    var sp: token.Span;
    sp.offset = offset;
    sp.len    = len;
    ret sp;
}

#[testing]
fun expr_make(offset: usize, len: usize) ast_expr.Expr {
    var e: ast_expr.Expr;
    e.span           = span_make(offset, len);
    e.kind           = ast_expr.EXPR_KIND_IDENT;
    e.data.ident.tok = e.span;
    ret e;
}

test span_contains__half_open {
    val sp: token.Span = span_make(10, 3);
    if (span_contains(sp, 9))              { ret 1; }
    if (!span_contains(sp, 10))            { ret 1; }
    if (!span_contains(sp, 12))            { ret 1; }
    if (span_contains(sp, 13))             { ret 1; }
    if (span_contains(span_make(5, 0), 5)) { ret 1; }
    ret 0;
}

test expr_place_kind__classifies_every_place_shape {
    var e: ast_expr.Expr;
    e.kind = ast_expr.EXPR_KIND_IDENT;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_IDENT) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_MEMBER;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_MEMBER) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_PROJECT;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_PROJECT) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_INDEX;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_INDEX) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_GENERIC_INSTANCE;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_ERROR) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_CALL;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_CALL) { ret 1; }
    e.kind          = ast_expr.EXPR_KIND_UNARY;
    e.data.unary.op = ast_expr.UN_DEREF;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_UNARY) { ret 1; }
    e.data.unary.op = ast_expr.UN_ADDR;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_ERROR) { ret 1; }
    e.kind = ast_expr.EXPR_KIND_BINARY;
    if (expr_place_kind(?e) != ast_expr.EXPR_KIND_ERROR) { ret 1; }
    ret 0;
}

test offset_to_expr__tightest_enclosing {
    var alloc:  std_allocator.Allocator;
    val made_1: err[std_allocator.Error] = page.make(?alloc);
    if (sel made_1.err) { ret 1; }
    var a: Ast = init(?alloc, 0::lang_source.FileId);

    val res_outer: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 10));
    if (sel res_outer.err) {
        dnit(?a);
        ret 1;
    }
    val res_inner: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(2, 3));
    if (sel res_inner.err) {
        dnit(?a);
        ret 1;
    }
    val inner_id: ast_id.ExprId = res_inner.ok;
    val outer_id: ast_id.ExprId = res_outer.ok;

    if (offset_to_expr(?a, 3) != inner_id) {
        dnit(?a);
        ret 1;
    }
    if (offset_to_expr(?a, 7) != outer_id) {
        dnit(?a);
        ret 1;
    }
    if (offset_to_expr(?a, 99) != ast_id.EXPR_NIL) {
        dnit(?a);
        ret 1;
    }
    dnit(?a);
    ret 0;
}

test mark_rollback__discards_every_arena_grown_since_the_mark {
    var alloc:  std_allocator.Allocator;
    val made_2: err[std_allocator.Error] = page.make(?alloc);
    if (sel made_2.err) { ret 1; }
    var a: Ast = init(?alloc, 0::lang_source.FileId);

    val add_expr_1: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel add_expr_1.err) {
        dnit(?a);
        ret 1;
    }
    val m: AstMark = mark(?a);

    val add_expr_2: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(1, 1));
    if (sel add_expr_2.err) {
        dnit(?a);
        ret 1;
    }
    var d:          ast_decl.Decl;
    val add_decl_3: res[ast_id.DeclId, fail.Fail] = add_decl(?a, d);
    if (sel add_decl_3.err) {
        dnit(?a);
        ret 1;
    }
    val add_decl_id_4: res[u32, fail.Fail] = add_decl_id(?a, 0::ast_id.DeclId);
    if (sel add_decl_id_4.err) {
        dnit(?a);
        ret 1;
    }
    var member: ast_decl.TagCase;
    member.payload = ast_id.TYPE_NIL;
    val add_tag_case_5: res[u32, fail.Fail] = add_tag_case(?a, member);
    if (sel add_tag_case_5.err) {
        dnit(?a);
        ret 1;
    }
    if (a.tag_case_len != 1) {
        dnit(?a);
        ret 1;
    }
    if (a.expr_len != 2 || a.decl_len != 1 || a.decl_id_len != 1) {
        dnit(?a);
        ret 1;
    }

    if (!rollback(?a, m)) {
        dnit(?a);
        ret 1;
    }
    if (a.tag_case_len != 0) {
        dnit(?a);
        ret 1;
    }
    if (a.expr_len != 1 || a.decl_len != 0 || a.decl_id_len != 0) {
        dnit(?a);
        ret 1;
    }

    val kept: opt[*ast_expr.Expr] = get_expr(?a, 0::ast_id.ExprId);
    if (!sel kept.some) {
        dnit(?a);
        ret 1;
    }
    if (kept.some.span.offset != 0) {
        dnit(?a);
        ret 1;
    }

    dnit(?a);
    ret 0;
}

test rollback__rejects_a_mark_taken_after_an_earlier_rollback_already_ran {
    var alloc:  std_allocator.Allocator;
    val made_3: err[std_allocator.Error] = page.make(?alloc);
    if (sel made_3.err) { ret 1; }
    var a: Ast = init(?alloc, 0::lang_source.FileId);

    val m0:         AstMark                       = mark(?a);
    val add_expr_1: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel add_expr_1.err) {
        dnit(?a);
        ret 1;
    }
    val m_ahead:    AstMark                       = mark(?a);
    val add_expr_2: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(1, 1));
    if (sel add_expr_2.err) {
        dnit(?a);
        ret 1;
    }
    if (a.expr_len != 2) {
        dnit(?a);
        ret 1;
    }

    if (!rollback(?a, m0)) {
        dnit(?a);
        ret 1;
    }
    if (a.expr_len != 0) {
        dnit(?a);
        ret 1;
    }

    if (rollback(?a, m_ahead)) {
        dnit(?a);
        ret 1;
    }
    if (a.expr_len != 0) {
        dnit(?a);
        ret 1;
    }

    dnit(?a);
    ret 0;
}

# every arena refuses the id that would reach its nil sentinel or pass the u32 index limit,
# and leaves its length untouched
test add__refuses_an_id_past_its_domain {
    var alloc:  std_allocator.Allocator;
    val made_5: err[std_allocator.Error] = page.make(?alloc);
    if (sel made_5.err) { ret 1; }
    var a:  Ast = init(?alloc, 0::lang_source.FileId);
    var rc: i32 = 0;

    a.expr_len = 0xFFFFFFFF;
    a.expr_cap = 0x100000000;
    val expr_over: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel expr_over.ok || a.expr_len != 0xFFFFFFFF) { rc = 1; }
    a.expr_len = 0;
    a.expr_cap = 0;

    a.module_len = 0xFFFFFFFF;
    a.module_cap = 0x100000000;
    var mo:          ast_module.Module;
    val module_over: res[ast_id.ModuleNodeId, fail.Fail] = add_module(?a, mo);
    if (sel module_over.ok) { rc = 2; }
    a.module_len = 0;
    a.module_cap = 0;

    a.stmt_len = 0xFFFFFFFF;
    a.stmt_cap = 0x100000000;
    var s:         ast_stmt.Stmt;
    val stmt_over: res[ast_id.StmtId, fail.Fail] = add_stmt(?a, s);
    if (sel stmt_over.ok) { rc = 3; }
    a.stmt_len = 0;
    a.stmt_cap = 0;

    a.decl_len = 0xFFFFFFFF;
    a.decl_cap = 0x100000000;
    var d:         ast_decl.Decl;
    val decl_over: res[ast_id.DeclId, fail.Fail] = add_decl(?a, d);
    if (sel decl_over.ok) { rc = 4; }
    a.decl_len = 0;
    a.decl_cap = 0;

    a.type_len = 0xFFFFFFFF;
    a.type_cap = 0x100000000;
    var t:         ast_type.Type;
    val type_over: res[ast_id.TypeId, fail.Fail] = add_type(?a, t);
    if (sel type_over.ok) { rc = 5; }
    a.type_len = 0;
    a.type_cap = 0;

    a.typed_name_len = 0x100000000;
    a.typed_name_cap = 0x200000000;
    var tn:        ast_decl.TypedName;
    val name_over: res[u32, fail.Fail] = add_typed_name(?a, tn);
    if (sel name_over.ok || a.typed_name_len != 0x100000000) { rc = 6; }
    a.typed_name_len = 0;
    a.typed_name_cap = 0;

    val expr_ok: res[ast_id.ExprId, fail.Fail] = add_expr(?a, expr_make(0, 1));
    if (sel expr_ok.err) { rc = 7; }
    if (sel expr_ok.ok) {
        if (expr_ok.ok != 0::ast_id.ExprId) { rc = 7; }
    }

    dnit(?a);
    ret rc;
}
