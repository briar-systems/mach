    if (a.tag_case_len == a.tag_case_cap) {
        val res_tag_cases: res[*ast_decl.TagCase, std_allocator.Error] = pool.grow[ast_decl.TagCase](a.a, a.tag_cases, a.tag_case_cap, INITIAL_AUX_CAP, ?a.tag_case_cap);
        if (sel res_tag_cases.err) {
