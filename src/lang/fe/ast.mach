pub fun add_decl(a: *Ast, d: decl.Decl) res[id.DeclId, fail.Fail] {
    if (a.decl_len == a.decl_cap) {
        val res_decls: res[*decl.Decl, A.Error] = pool.grow[decl.Decl](a.a, a.decls, a.decl_cap, INITIAL_NODE_CAP, ?a.decl_cap);
        if (sel res_decls.err) {
            ret res[id.DeclId, fail.Fail].err{fail.refused(res_decls.err)};
        }
        a.decls = res_decls.ok;
    }
    val checked_id: res[layout.CheckedId[DeclIdDomain], layout.CheckCause] =
        layout.id_below[DeclIdDomain](a.decl_len, layout.count[DeclIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[id.DeclId, fail.Fail].err{fail.message("ast: decl id exhausts its 32-bit domain")};
    }
    val new_id: id.DeclId = checked_id.ok.value::u32;
    a.decls[a.decl_len] = d;
    a.decl_len = a.decl_len + 1;
    ret res[id.DeclId, fail.Fail].ok{new_id};
}

pub fun get_decl(a: *Ast, id_: id.DeclId) opt[*decl.Decl] {
    if (id_::usize >= a.decl_len) { ret opt[*decl.Decl].none{}; }
    ret opt[*decl.Decl].some{?a.decls[id_]};
}

pub fun decl_name_span(a: *Ast, id_: id.DeclId) token.Span {
    var empty: token.Span;
    empty.offset = 0;
    empty.len    = 0;

    val opt_d: opt[*decl.Decl] = get_decl(a, id_);
    if (!sel opt_d.some) { ret empty; }
    val d: *decl.Decl = opt_d.some;

    if (d.kind == decl.DECL_KIND_USE) { ret d.data.use_.alias; }
    if (d.kind == decl.DECL_KIND_FWD) { ret d.data.fwd_.alias; }
    if (d.kind == decl.DECL_KIND_FUN) { ret d.data.fun_.name;  }
    if (d.kind == decl.DECL_KIND_REC) { ret d.data.rec_.name;  }
    if (d.kind == decl.DECL_KIND_UNI) { ret d.data.uni_.name;  }
    if (d.kind == decl.DECL_KIND_TAG) { ret d.data.tag_.name;  }
    if (d.kind == decl.DECL_KIND_DEF) { ret d.data.def_.name;  }
    if (d.kind == decl.DECL_KIND_VAL) { ret d.data.bind.name;  }
    if (d.kind == decl.DECL_KIND_VAR) { ret d.data.bind.name;  }
    ret empty;
}

pub fun add_type(a: *Ast, t: type.Type) res[id.TypeId, fail.Fail] {
    if (a.type_len == a.type_cap) {
        val res_types: res[*type.Type, A.Error] = pool.grow[type.Type](a.a, a.types, a.type_cap, INITIAL_NODE_CAP, ?a.type_cap);
        if (sel res_types.err) {
            ret res[id.TypeId, fail.Fail].err{fail.refused(res_types.err)};
        }
        a.types = res_types.ok;
    }
    val checked_id: res[layout.CheckedId[TypeIdDomain], layout.CheckCause] =
        layout.id_below[TypeIdDomain](a.type_len, layout.count[TypeIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[id.TypeId, fail.Fail].err{fail.message("ast: type id exhausts its 32-bit domain")};
    }
    val new_id: id.TypeId = checked_id.ok.value::u32;
    a.types[a.type_len] = t;
    a.type_len = a.type_len + 1;
    ret res[id.TypeId, fail.Fail].ok{new_id};
}

pub fun get_type(a: *Ast, id_: id.TypeId) opt[*type.Type] {
    if (id_::usize >= a.type_len) { ret opt[*type.Type].none{}; }
