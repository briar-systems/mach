# literal suffixes, their types, ranges and spellings, checked over whole programs
use mach.lang.type;

use mach.lang.driver.tests.testing.ut_cc_src;
use mach.lang.driver.tests.testing.ut_sema_clean;
use mach.lang.driver.tests.testing.ut_vec_diag;

# a suffix is the literal's type, out of range names the range, and an unknown spelling is
# refused as an integer or a float suffix
test literal_suffix__types_ranges_and_spellings {
    if (!ut_sema_clean(ut_cc_src("fun f() u32 { val x: u32 = 7u32; ret x; }", "\n")))                                      { ret 1; }
    if (!ut_sema_clean(ut_cc_src("fun f() f32 { val x: f32 = 1.5f32; ret x; }", "\n")))                                    { ret 2; }
    if (!ut_sema_clean(ut_cc_src("fun f() i8 { val x: i8 = -128i8; ret x; }", "\n")))                                      { ret 3; }
    if (ut_vec_diag(ut_cc_src("fun f() u64 { val x: u64 = 7u32; ret x; }", "\n"), "type mismatch: expected") != 0)         { ret 4; }
    if (ut_vec_diag(ut_cc_src("fun f() f64 { val x: f64 = 1.5f32; ret x; }", "\n"), "type mismatch: expected") != 0)       { ret 5; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = 7u32 + 8u64; ret x; }", "\n"), "are different types") != 0)      { ret 6; }
    if (ut_vec_diag(ut_cc_src("fun f() u8 { val x: u8 = 256u8; ret x; }", "\n"), "literal 256 is out of range for") != 0)  { ret 7; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = -1u32; ret x; }", "\n"), "literal -1 is out of range for") != 0) { ret 8; }
    if (ut_vec_diag(ut_cc_src("fun f() i8 { val x: i8 = 128i8; ret x; }", "\n"), "literal 128 is out of range for") != 0)  { ret 9; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = 7u7; ret x; }", "\n"), "unknown integer literal suffix") != 0)   { ret 10; }
    if (ut_vec_diag(ut_cc_src("fun f() u32 { val x: u32 = 7u; ret x; }", "\n"), "unknown integer literal suffix") != 0)    { ret 11; }
    if (ut_vec_diag(ut_cc_src("fun f() f32 { val x: f32 = 1f32; ret x; }", "\n"), "unknown integer literal suffix") != 0)  { ret 12; }
    if (ut_vec_diag(ut_cc_src("fun f() f32 { val x: f32 = 1.5f8; ret x; }", "\n"), "unknown float literal suffix") != 0)   { ret 13; }
    if (!ut_sema_clean(ut_cc_src("fun f() f16 { val x: f16 = 1.5f16; ret x; }", "\n")))                                    { ret 14; }
    if (ut_vec_diag(ut_cc_src("fun f() f32 { val x: f32 = 1.5f16; ret x; }", "\n"), "type mismatch: expected") != 0)       { ret 15; }
    ret 0;
}
