use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

pub def Kind: u8;

pub val KIND_IDENT:     Kind = 0;
pub val KIND_LIT_INT:   Kind = 1;
pub val KIND_LIT_FLOAT: Kind = 2;
pub val KIND_LIT_CHAR:  Kind = 3;
pub val KIND_LIT_STR:   Kind = 4;

pub val KIND_LPAREN:   Kind = 5;
pub val KIND_RPAREN:   Kind = 6;
pub val KIND_LBRACE:   Kind = 7;
pub val KIND_RBRACE:   Kind = 8;
pub val KIND_LBRACKET: Kind = 9;
pub val KIND_RBRACKET: Kind = 10;

pub val KIND_SEMI:     Kind = 11;
pub val KIND_COLON:    Kind = 12;
pub val KIND_COMMA:    Kind = 13;
pub val KIND_DOT:      Kind = 14;
pub val KIND_QUESTION: Kind = 15;
pub val KIND_AT:       Kind = 16;
pub val KIND_DOLLAR:   Kind = 17;

pub val KIND_PLUS:    Kind = 18;
pub val KIND_MINUS:   Kind = 19;
pub val KIND_STAR:    Kind = 20;
pub val KIND_SLASH:   Kind = 21;
pub val KIND_PERCENT: Kind = 22;
pub val KIND_AMP:     Kind = 23;
pub val KIND_PIPE:    Kind = 24;
pub val KIND_CARET:   Kind = 25;
pub val KIND_TILDE:   Kind = 26;

pub val KIND_EQ:      Kind = 27;
pub val KIND_EQ_EQ:   Kind = 28;
pub val KIND_BANG:    Kind = 29;
pub val KIND_BANG_EQ: Kind = 30;
pub val KIND_LT:      Kind = 31;
pub val KIND_LT_EQ:   Kind = 32;
pub val KIND_LT_LT:   Kind = 33;
pub val KIND_GT:      Kind = 34;
pub val KIND_GT_EQ:   Kind = 35;
pub val KIND_GT_GT:   Kind = 36;

pub val KIND_AMP_AMP:   Kind = 37;
pub val KIND_PIPE_PIPE: Kind = 38;

pub val KIND_COLON_COLON: Kind = 39;
pub val KIND_DOT_DOT_DOT: Kind = 40;
pub val KIND_COLON_TILDE: Kind = 41;

pub val KIND_BACKTICK:    Kind = 42;
pub val KIND_ATTR_OPEN:   Kind = 43;
pub val KIND_COLON_CARET: Kind = 44;
pub val KIND_COLON_GT:    Kind = 45;

pub val KIND_EOF:   Kind = 254;
pub val KIND_ERROR: Kind = 255;

pub val KW_ASM:   str = "asm";
pub val KW_BRK:   str = "brk";
pub val KW_CNT:   str = "cnt";
pub val KW_DEF:   str = "def";
pub val KW_EACH:  str = "each";
pub val KW_ERROR: str = "error";
pub val KW_EXT:   str = "ext";
pub val KW_FIN:   str = "fin";
pub val KW_FOR:   str = "for";
pub val KW_FUN:   str = "fun";
pub val KW_FWD:   str = "fwd";
pub val KW_IF:    str = "if";
pub val KW_IN:    str = "in";
pub val KW_NIL:   str = "nil";
pub val KW_OR:    str = "or";
pub val KW_PUB:   str = "pub";
pub val KW_REC:   str = "rec";
pub val KW_RET:   str = "ret";
pub val KW_SEL:   str = "sel";
pub val KW_TAG:   str = "tag";
pub val KW_TEST:  str = "test";
pub val KW_UNI:   str = "uni";
pub val KW_USE:   str = "use";
pub val KW_VAL:   str = "val";
pub val KW_VAR:   str = "var";

pub rec Span {
    offset: usize;
    len:    usize;
}

pub rec Token {
    span: Span;
    kind: Kind;
}

pub fun make(kind: Kind, offset: usize, len: usize) Token {
    var tok: Token;
    tok.kind        = kind;
    tok.span.offset = offset;
    tok.span.len    = len;
    ret tok;
}

# the spelling of a kind; absent for a tag outside the catalog
pub fun kind_str(kind: Kind) opt[str] {
    if (kind == KIND_IDENT)       { ret opt[str].some{"ident"}; }
    if (kind == KIND_LIT_INT)     { ret opt[str].some{"int"}; }
    if (kind == KIND_LIT_FLOAT)   { ret opt[str].some{"float"}; }
    if (kind == KIND_LIT_CHAR)    { ret opt[str].some{"char"}; }
    if (kind == KIND_LIT_STR)     { ret opt[str].some{"str"}; }
    if (kind == KIND_LPAREN)      { ret opt[str].some{"("}; }
    if (kind == KIND_RPAREN)      { ret opt[str].some{")"}; }
    if (kind == KIND_LBRACE)      { ret opt[str].some{"{"}; }
    if (kind == KIND_RBRACE)      { ret opt[str].some{"}"}; }
    if (kind == KIND_LBRACKET)    { ret opt[str].some{"["}; }
    if (kind == KIND_RBRACKET)    { ret opt[str].some{"]"}; }
    if (kind == KIND_SEMI)        { ret opt[str].some{";"}; }
    if (kind == KIND_COLON)       { ret opt[str].some{":"}; }
    if (kind == KIND_COMMA)       { ret opt[str].some{","}; }
    if (kind == KIND_DOT)         { ret opt[str].some{"."}; }
    if (kind == KIND_QUESTION)    { ret opt[str].some{"?"}; }
    if (kind == KIND_AT)          { ret opt[str].some{"@"}; }
    if (kind == KIND_DOLLAR)      { ret opt[str].some{"$"}; }
    if (kind == KIND_PLUS)        { ret opt[str].some{"+"}; }
    if (kind == KIND_MINUS)       { ret opt[str].some{"-"}; }
    if (kind == KIND_STAR)        { ret opt[str].some{"*"}; }
    if (kind == KIND_SLASH)       { ret opt[str].some{"/"}; }
    if (kind == KIND_PERCENT)     { ret opt[str].some{"%"}; }
    if (kind == KIND_AMP)         { ret opt[str].some{"&"}; }
    if (kind == KIND_PIPE)        { ret opt[str].some{"|"}; }
    if (kind == KIND_CARET)       { ret opt[str].some{"^"}; }
    if (kind == KIND_TILDE)       { ret opt[str].some{"~"}; }
    if (kind == KIND_EQ)          { ret opt[str].some{"="}; }
    if (kind == KIND_EQ_EQ)       { ret opt[str].some{"=="}; }
    if (kind == KIND_BANG)        { ret opt[str].some{"!"}; }
    if (kind == KIND_BANG_EQ)     { ret opt[str].some{"!="}; }
    if (kind == KIND_LT)          { ret opt[str].some{"<"}; }
    if (kind == KIND_LT_EQ)       { ret opt[str].some{"<="}; }
    if (kind == KIND_LT_LT)       { ret opt[str].some{"<<"}; }
    if (kind == KIND_GT)          { ret opt[str].some{">"}; }
    if (kind == KIND_GT_EQ)       { ret opt[str].some{">="}; }
    if (kind == KIND_GT_GT)       { ret opt[str].some{">>"}; }
    if (kind == KIND_AMP_AMP)     { ret opt[str].some{"&&"}; }
    if (kind == KIND_PIPE_PIPE)   { ret opt[str].some{"||"}; }
    if (kind == KIND_COLON_COLON) { ret opt[str].some{"::"}; }
    if (kind == KIND_DOT_DOT_DOT) { ret opt[str].some{"..."}; }
    if (kind == KIND_COLON_TILDE) { ret opt[str].some{":~"}; }
    if (kind == KIND_COLON_CARET) { ret opt[str].some{":^"}; }
    if (kind == KIND_COLON_GT)    { ret opt[str].some{":>"}; }
    if (kind == KIND_BACKTICK)    { ret opt[str].some{"`"}; }
    if (kind == KIND_ATTR_OPEN)   { ret opt[str].some{"#["}; }
    if (kind == KIND_EOF)         { ret opt[str].some{"eof"}; }
    if (kind == KIND_ERROR)       { ret opt[str].some{"error"}; }
    ret opt[str].none{};
}

# the binding power of an infix operator token; 0 for every other kind, which
# is not an operator (a partition, enumerated by its test)
pub fun infix_precedence(kind: Kind) u8 {
    if (kind == KIND_EQ)        { ret 1; }
    if (kind == KIND_PIPE_PIPE) { ret 2; }
    if (kind == KIND_AMP_AMP)   { ret 3; }
    if (kind == KIND_PIPE)      { ret 4; }
    if (kind == KIND_CARET)     { ret 5; }
    if (kind == KIND_AMP)       { ret 6; }
    if (kind == KIND_EQ_EQ)     { ret 7; }
    if (kind == KIND_BANG_EQ)   { ret 7; }
    if (kind == KIND_LT)        { ret 8; }
    if (kind == KIND_LT_EQ)     { ret 8; }
    if (kind == KIND_GT)        { ret 8; }
    if (kind == KIND_GT_EQ)     { ret 8; }
    if (kind == KIND_LT_LT)     { ret 9; }
    if (kind == KIND_GT_GT)     { ret 9; }
    if (kind == KIND_PLUS)      { ret 10; }
    if (kind == KIND_MINUS)     { ret 10; }
    if (kind == KIND_STAR)      { ret 11; }
    if (kind == KIND_SLASH)     { ret 11; }
    if (kind == KIND_PERCENT)   { ret 11; }
    ret 0;
}

pub fun is_right_assoc(kind: Kind) bool {
    ret kind == KIND_EQ;
}

test "mach.lang.fe.token.infix_precedence" {
    if (infix_precedence(KIND_STAR) != 11)     { ret 1; }
    if (infix_precedence(KIND_PLUS) != 10)     { ret 1; }
    if (infix_precedence(KIND_LT_LT) != 9)     { ret 1; }
    if (infix_precedence(KIND_LT) != 8)        { ret 1; }
    if (infix_precedence(KIND_AMP) != 6)       { ret 1; }
    if (infix_precedence(KIND_PIPE_PIPE) != 2) { ret 1; }
    if (infix_precedence(KIND_EQ) != 1)        { ret 1; }
    if (infix_precedence(KIND_EOF) != 0)       { ret 1; }
    if (infix_precedence(KIND_SEMI) != 0)      { ret 1; }
    ret 0;
}

test "mach.lang.fe.token.infix_precedence:partition_Kind" {
    val operators: [21]Kind = [21]Kind{KIND_EQ, KIND_PIPE_PIPE, KIND_AMP_AMP, KIND_PIPE, KIND_CARET, KIND_AMP,
        KIND_EQ_EQ, KIND_BANG_EQ, KIND_LT, KIND_LT_EQ, KIND_GT, KIND_GT_EQ, KIND_LT_LT, KIND_GT_GT,
        KIND_PLUS, KIND_MINUS, KIND_STAR, KIND_SLASH, KIND_PERCENT, KIND_EOF, KIND_ERROR};
    val powers: [21]u8   = [21]u8{1, 2, 3, 4, 5, 6, 7, 7, 8, 8, 8, 8, 9, 9, 10, 10, 11, 11, 11, 0, 0};
    val others: [27]Kind = [27]Kind{KIND_IDENT, KIND_LIT_INT, KIND_LIT_FLOAT, KIND_LIT_CHAR, KIND_LIT_STR,
        KIND_LPAREN, KIND_RPAREN, KIND_LBRACE, KIND_RBRACE, KIND_LBRACKET, KIND_RBRACKET, KIND_SEMI,
        KIND_COLON, KIND_COMMA, KIND_DOT, KIND_QUESTION, KIND_AT, KIND_DOLLAR, KIND_TILDE, KIND_BANG,
        KIND_COLON_COLON, KIND_DOT_DOT_DOT, KIND_COLON_TILDE, KIND_BACKTICK, KIND_ATTR_OPEN,
        KIND_COLON_CARET, KIND_COLON_GT};
    var i: usize = 0;
    for (i < 21) {
        if (infix_precedence(operators[i]) != powers[i]) { ret 1; }
        val op_name: opt[str] = kind_str(operators[i]);
        if (sel op_name.none) { ret 2; }
        i = i + 1;
    }
    i = 0;
    for (i < 27) {
        if (infix_precedence(others[i]) != 0) { ret 3; }
        val other_name: opt[str] = kind_str(others[i]);
        if (sel other_name.none) { ret 4; }
        i = i + 1;
    }
    # every kind below the sentinels is one of the 46 above and no other tag is spelled
    var k:     usize = 0;
    var named: usize = 0;
    for (k < 256) {
        val name_k: opt[str] = kind_str(k::Kind);
        if (sel name_k.some) { named = named + 1; }
        k = k + 1;
    }
    if (named != 48) { ret 5; }
    ret 0;
}

test "mach.lang.fe.token.is_right_assoc" {
    if (!is_right_assoc(KIND_EQ))  { ret 1; }
    if (is_right_assoc(KIND_PLUS)) { ret 1; }
    ret 0;
}
