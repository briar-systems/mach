use std.allocator.page;
use std.print;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.reference;
use lang_source: mach.lang.source;

pub def Kind: u8;

pub val KIND_IDENT:     Kind = 0;
pub val KIND_LIT_INT:   Kind = 1;
pub val KIND_LIT_FLOAT: Kind = 2;
pub val KIND_LIT_CHAR:  Kind = 3;
pub val KIND_LIT_STR:   Kind = 4;

pub val KIND_LPAREN:   Kind = 5;
pub val KIND_RPAREN:   Kind = 6;
pub val KIND_LBRACE:   Kind = 7;
pub val KIND_RBRACE:   Kind = 8;
pub val KIND_LBRACKET: Kind = 9;
pub val KIND_RBRACKET: Kind = 10;

pub val KIND_SEMI:     Kind = 11;
pub val KIND_COLON:    Kind = 12;
pub val KIND_COMMA:    Kind = 13;
pub val KIND_DOT:      Kind = 14;
pub val KIND_QUESTION: Kind = 15;
pub val KIND_AT:       Kind = 16;
pub val KIND_DOLLAR:   Kind = 17;

pub val KIND_PLUS:    Kind = 18;
pub val KIND_MINUS:   Kind = 19;
pub val KIND_STAR:    Kind = 20;
pub val KIND_SLASH:   Kind = 21;
pub val KIND_PERCENT: Kind = 22;
pub val KIND_AMP:     Kind = 23;
pub val KIND_PIPE:    Kind = 24;
pub val KIND_CARET:   Kind = 25;
pub val KIND_TILDE:   Kind = 26;

pub val KIND_EQ:      Kind = 27;
pub val KIND_EQ_EQ:   Kind = 28;
pub val KIND_BANG:    Kind = 29;
pub val KIND_BANG_EQ: Kind = 30;
pub val KIND_LT:      Kind = 31;
pub val KIND_LT_EQ:   Kind = 32;
pub val KIND_LT_LT:   Kind = 33;
pub val KIND_GT:      Kind = 34;
pub val KIND_GT_EQ:   Kind = 35;
pub val KIND_GT_GT:   Kind = 36;

pub val KIND_AMP_AMP:   Kind = 37;
pub val KIND_PIPE_PIPE: Kind = 38;

pub val KIND_COLON_COLON: Kind = 39;
pub val KIND_DOT_DOT_DOT: Kind = 40;
pub val KIND_COLON_TILDE: Kind = 41;

pub val KIND_DECORATOR_OPEN: Kind = 42;
pub val KIND_COLON_GT:       Kind = 43;

pub val KIND_EOF:   Kind = 254;
pub val KIND_ERROR: Kind = 255;

pub rec Token {
    span: lang_source.Span;
    kind: Kind;
}

pub fun make(kind: Kind, offset: usize, len: usize) Token {
    ret Token{span: lang_source.span(offset, len), kind: kind};
}

# a token the source spells with fixed punctuation
pub rec Spelling {
    text: str;
    kind: Kind;
}

# every fixed spelling, longest first, so the first one a scan matches is the longest
val SPELLING_COUNT: usize                    = 39;
val SPELLINGS:      [SPELLING_COUNT]Spelling = [SPELLING_COUNT]Spelling{
    Spelling{text: "...", kind: KIND_DOT_DOT_DOT},
    Spelling{text: "::", kind: KIND_COLON_COLON},
    Spelling{text: ":~", kind: KIND_COLON_TILDE},
    Spelling{text: ":>", kind: KIND_COLON_GT},
    Spelling{text: "==", kind: KIND_EQ_EQ},
    Spelling{text: "!=", kind: KIND_BANG_EQ},
    Spelling{text: "<=", kind: KIND_LT_EQ},
    Spelling{text: "<<", kind: KIND_LT_LT},
    Spelling{text: ">=", kind: KIND_GT_EQ},
    Spelling{text: ">>", kind: KIND_GT_GT},
    Spelling{text: "&&", kind: KIND_AMP_AMP},
    Spelling{text: "||", kind: KIND_PIPE_PIPE},
    Spelling{text: "#[", kind: KIND_DECORATOR_OPEN},
    Spelling{text: "(", kind: KIND_LPAREN},
    Spelling{text: ")", kind: KIND_RPAREN},
    Spelling{text: "{", kind: KIND_LBRACE},
    Spelling{text: "}", kind: KIND_RBRACE},
    Spelling{text: "[", kind: KIND_LBRACKET},
    Spelling{text: "]", kind: KIND_RBRACKET},
    Spelling{text: ";", kind: KIND_SEMI},
    Spelling{text: ":", kind: KIND_COLON},
    Spelling{text: ",", kind: KIND_COMMA},
    Spelling{text: ".", kind: KIND_DOT},
    Spelling{text: "?", kind: KIND_QUESTION},
    Spelling{text: "@", kind: KIND_AT},
    Spelling{text: "$", kind: KIND_DOLLAR},
    Spelling{text: "+", kind: KIND_PLUS},
    Spelling{text: "-", kind: KIND_MINUS},
    Spelling{text: "*", kind: KIND_STAR},
    Spelling{text: "/", kind: KIND_SLASH},
    Spelling{text: "%", kind: KIND_PERCENT},
    Spelling{text: "&", kind: KIND_AMP},
    Spelling{text: "|", kind: KIND_PIPE},
    Spelling{text: "^", kind: KIND_CARET},
    Spelling{text: "~", kind: KIND_TILDE},
    Spelling{text: "=", kind: KIND_EQ},
    Spelling{text: "!", kind: KIND_BANG},
    Spelling{text: "<", kind: KIND_LT},
    Spelling{text: ">", kind: KIND_GT}
};

# the fixed spelling that starts at `pos` in NUL-terminated `source`, the longest one
pub fun spelling_at(source: str, pos: usize) opt[Spelling] {
    var i: usize = 0;
    for (i < SPELLING_COUNT) {
        val text: str   = SPELLINGS[i].text;
        var j:    usize = 0;
        for (text[j] != 0 && source[pos + j] == text[j]) {
            j = j + 1;
        }
        if (text[j] == 0) { ret opt[Spelling].some{SPELLINGS[i]}; }
        i = i + 1;
    }
    ret opt[Spelling].none{};
}

# the spelling of a kind; absent for a tag outside the catalog
#[testing]
fun kind_str(kind: Kind) opt[str] {
    var i: usize = 0;
    for (i < SPELLING_COUNT) {
        if (SPELLINGS[i].kind == kind) { ret opt[str].some{SPELLINGS[i].text}; }
        i = i + 1;
    }
    if (kind == KIND_IDENT)     { ret opt[str].some{"ident"}; }
    if (kind == KIND_LIT_INT)   { ret opt[str].some{"int"}; }
    if (kind == KIND_LIT_FLOAT) { ret opt[str].some{"float"}; }
    if (kind == KIND_LIT_CHAR)  { ret opt[str].some{"char"}; }
    if (kind == KIND_LIT_STR)   { ret opt[str].some{"str"}; }
    if (kind == KIND_EOF)       { ret opt[str].some{"eof"}; }
    if (kind == KIND_ERROR)     { ret opt[str].some{"error"}; }
    ret opt[str].none{};
}

# the binding power of an infix operator token; 0 for every other kind, which
# is not an operator (a partition, enumerated by its test)
pub fun infix_precedence(kind: Kind) u8 {
    if (kind == KIND_EQ)        { ret 1; }
    if (kind == KIND_PIPE_PIPE) { ret 2; }
    if (kind == KIND_AMP_AMP)   { ret 3; }
    if (kind == KIND_PIPE)      { ret 4; }
    if (kind == KIND_CARET)     { ret 5; }
    if (kind == KIND_AMP)       { ret 6; }
    if (kind == KIND_EQ_EQ)     { ret 7; }
    if (kind == KIND_BANG_EQ)   { ret 7; }
    if (kind == KIND_LT)        { ret 8; }
    if (kind == KIND_LT_EQ)     { ret 8; }
    if (kind == KIND_GT)        { ret 8; }
    if (kind == KIND_GT_EQ)     { ret 8; }
    if (kind == KIND_LT_LT)     { ret 9; }
    if (kind == KIND_GT_GT)     { ret 9; }
    if (kind == KIND_PLUS)      { ret 10; }
    if (kind == KIND_MINUS)     { ret 10; }
    if (kind == KIND_STAR)      { ret 11; }
    if (kind == KIND_SLASH)     { ret 11; }
    if (kind == KIND_PERCENT)   { ret 11; }
    ret 0;
}

pub fun is_right_assoc(kind: Kind) bool {
    ret kind == KIND_EQ;
}

test infix_precedence__partition_kind {
    val operators: [21]Kind = [21]Kind{KIND_EQ, KIND_PIPE_PIPE, KIND_AMP_AMP, KIND_PIPE, KIND_CARET, KIND_AMP,
        KIND_EQ_EQ, KIND_BANG_EQ, KIND_LT, KIND_LT_EQ, KIND_GT, KIND_GT_EQ, KIND_LT_LT, KIND_GT_GT,
        KIND_PLUS, KIND_MINUS, KIND_STAR, KIND_SLASH, KIND_PERCENT, KIND_EOF, KIND_ERROR};
    val powers: [21]u8   = [21]u8{1, 2, 3, 4, 5, 6, 7, 7, 8, 8, 8, 8, 9, 9, 10, 10, 11, 11, 11, 0, 0};
    val others: [25]Kind = [25]Kind{KIND_IDENT, KIND_LIT_INT, KIND_LIT_FLOAT, KIND_LIT_CHAR, KIND_LIT_STR,
        KIND_LPAREN, KIND_RPAREN, KIND_LBRACE, KIND_RBRACE, KIND_LBRACKET, KIND_RBRACKET, KIND_SEMI,
        KIND_COLON, KIND_COMMA, KIND_DOT, KIND_QUESTION, KIND_AT, KIND_DOLLAR, KIND_TILDE, KIND_BANG,
        KIND_COLON_COLON, KIND_DOT_DOT_DOT, KIND_COLON_TILDE, KIND_DECORATOR_OPEN, KIND_COLON_GT};
    var i: usize = 0;
    for (i < 21) {
        if (infix_precedence(operators[i]) != powers[i]) { ret 1; }
        val op_name: opt[str] = kind_str(operators[i]);
        if (sel op_name.none) { ret 2; }
        i = i + 1;
    }
    i = 0;
    for (i < 25) {
        if (infix_precedence(others[i]) != 0) { ret 3; }
        val other_name: opt[str] = kind_str(others[i]);
        if (sel other_name.none) { ret 4; }
        i = i + 1;
    }
    # every kind below the sentinels is one of the 44 above and no other tag is spelled
    var k:     usize = 0;
    var named: usize = 0;
    for (k < 256) {
        val name_k: opt[str] = kind_str(k::Kind);
        if (sel name_k.some) { named = named + 1; }
        k = k + 1;
    }
    if (named != 46) { ret 5; }
    ret 0;
}

# the spelling of the `i`th kind that has one in source, punctuation and operators alike
#[testing]
fun spelled_at(i: usize) str {
    if (i > (KIND_COLON_GT - KIND_LPAREN)::usize) { ret nil; }
    val name: opt[str] = kind_str((i + KIND_LPAREN::usize)::Kind);
    if (sel name.none) { ret nil; }
    ret name.some;
}

# the spelling of the `i`th kind when it is an infix operator
#[testing]
fun infix_at(i: usize) str {
    if (infix_precedence((i + KIND_LPAREN::usize)::Kind) == 0) { ret nil; }
    ret spelled_at(i);
}

#[testing]
val SPELLED_COUNT: usize = (KIND_COLON_GT - KIND_LPAREN)::usize + 1;

# grammar.md spells every token the lexer has a spelling for, and its binary
# operators and precedence table are the parser's infix table
test grammar_doc__tokens_and_precedence_are_the_lexer_tables {
    var alloc: A.Allocator;
    page.make(?alloc);
    val text: opt[str] = reference.page_or_report(?alloc, "doc/language/grammar.md");
    if (sel text.none) { ret 1; }
    val punct: opt[lang_source.Span] = reference.production(text.some, "punctuation");
    if (sel punct.none) { ret 2; }
    val ops: opt[lang_source.Span] = reference.production(text.some, "operator");
    if (sel ops.none) { ret 2; }
    val both: lang_source.Span = lang_source.Span{offset: punct.some.offset, len: ops.some.offset + ops.some.len - punct.some.offset};
    if (!reference.agree(?alloc, "grammar.md punctuation and operator", text.some, both, reference.WORDS_QUOTED, spelled_at, SPELLED_COUNT)) { ret 3; }
    val binary: opt[lang_source.Span] = reference.production(text.some, "binary-op");
    if (sel binary.none)                                                                                                           { ret 4; }
    if (!reference.agree(?alloc, "grammar.md binary-op", text.some, binary.some, reference.WORDS_QUOTED, infix_at, SPELLED_COUNT)) { ret 5; }

    # each row of the precedence table names its operators at their binding power and associativity
    val rows: opt[lang_source.Span] = reference.table(text.some, 0, "| Prec |");
    if (sel rows.none) { ret 6; }
    var at:    usize = rows.some.offset;
    var line:  lang_source.Span;
    var count: usize = 0;
    for (reference.row_next(text.some, ?at, rows.some.offset + rows.some.len, ?line)) {
        val prec: opt[lang_source.Span] = reference.cell(text.some, line, 0);
        if (sel prec.none) { ret 7; }
        val names: opt[lang_source.Span] = reference.cell(text.some, line, 1);
        if (sel names.none) { ret 7; }
        val assoc: opt[lang_source.Span] = reference.cell(text.some, line, 2);
        if (sel assoc.none) { ret 7; }
        var power: u32   = 0;
        var d:     usize = 0;
        for (d < prec.some.len) {
            power = power * 10 + (text.some[prec.some.offset + d]::u32 - '0'::u32);
            d     = d + 1;
        }
        var c:  usize = names.some.offset;
        var op: lang_source.Span;
        for (reference.code_next(text.some, ?c, names.some.offset + names.some.len, ?op)) {
            val k: opt[usize] = reference.index_of(text.some, op, infix_at, SPELLED_COUNT);
            if (sel k.none) {
                print.eprintlnf("grammar.md precedence: `{}` is not an infix operator", reference.spelled(?alloc, text.some, op));
                ret 8;
            }
            val kind: Kind = (k.some + KIND_LPAREN::usize)::Kind;
            if (infix_precedence(kind)::u32 != power || is_right_assoc(kind) != reference.spells(text.some, assoc.some, "right")) {
                print.eprintlnf("grammar.md precedence: `{}` is not at precedence {} with that associativity", reference.spelled(?alloc, text.some, op), reference.spelled(?alloc, text.some, prec.some));
                ret 9;
            }
            count = count + 1;
        }
    }
    var infix: usize = 0;
    var i:     usize = 0;
    for (i < SPELLED_COUNT) {
        if (infix_at(i) != nil) { infix = infix + 1; }
        i = i + 1;
    }
    if (count != infix) {
        print.eprintln("grammar.md precedence: the table does not list every infix operator once");
        ret 10;
    }
    ret 0;
}

# a longer spelling comes before every shorter one, so the first match is the longest,
# and each spelled kind has one row
test spellings__longest_first_and_one_row_per_kind {
    var i: usize = 0;
    for (i < SPELLING_COUNT) {
        var j: usize = i + 1;
        for (j < SPELLING_COUNT) {
            if (str_len(SPELLINGS[j].text) > str_len(SPELLINGS[i].text)) { ret 1; }
            if (SPELLINGS[j].kind == SPELLINGS[i].kind)                  { ret 2; }
            j = j + 1;
        }
        i = i + 1;
    }
    val dots: opt[Spelling] = spelling_at("...x", 0);
    if (!sel dots.some)                     { ret 3; }
    if (dots.some.kind != KIND_DOT_DOT_DOT) { ret 3; }
    val colon: opt[Spelling] = spelling_at(":x", 0);
    if (!sel colon.some)               { ret 4; }
    if (colon.some.kind != KIND_COLON) { ret 4; }
    val none: opt[Spelling] = spelling_at("x", 0);
    if (sel none.some) { ret 5; }
    ret 0;
}
