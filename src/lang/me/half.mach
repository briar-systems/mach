# scalar f16 as ordinary ir, written once and shared by every target (#3799).
# an f16 value is carried as its 16 bits in an i16. an operation the target
# declares in its half rows (isa.half_native) is its own instruction on those
# bits; every other one is the expansion here, which calls nothing, so no
# runtime symbol appears for a freestanding link to provide.
#
# arithmetic widens both operands exactly to binary64, computes there and
# narrows once. binary64 carries more than twice binary16's precision plus two
# bits, so that one rounding is the correctly rounded binary16 result, the rule
# comptime folds by. a target whose rows convert f16 to and from binary32
# computes in binary32 instead, which carries exactly that much (#3801). an
# arithmetic operand widens with a NaN kept as it is, signaling or quiet, so
# the binary64 unit picks and quiets the NaN as the target's half unit would.
# a conversion goes through binary64 the same way, and a comparison compares
# the widened values. widening and narrowing are integer code on the halves of
# the binary64 encoding: sign, exponent and significand extraction, round to
# nearest even, subnormals, overflow to infinity, and a converted NaN made by
# the target's NaN rule, as float.narrow_bits and float.widen_bits define them,
# so the expansion converts as the target's own half instructions would. every
# step is branch-free, a select being a mask

use mach.lang.fail;
use mach.lang.float;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.vecform;
use mach.lang.target;
use mach.lang.target.isa;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

# an emitter over the caller's builder that remembers the first failure, so
# the algorithms read as their arithmetic. a value emitted after a failure is
# the nil value and is never used: the caller reads `done` before its result
pub rec Half {
    b:      *builder.Builder;
    tgt:    *target.Target;
    model:  *isa.MachineModel;
    nan:    float.NanRule;
    failed: bool;
    first:  fail.Fail;
    bits_t: ir_type.IrTypeId;
    i32t:   ir_type.IrTypeId;
    i64t:   ir_type.IrTypeId;
    f64t:   ir_type.IrTypeId;
}

# the ir type an f16 value is carried in: an i16 whose form says its bits are
# a binary16, so a calling convention can place it as the float it is (#3800)
pub fun carrier(types: *ir_type.IrTypeTable) res[ir_type.IrTypeId, fail.Fail] {
    ret ir_type.intern_int_form(types, 16, ir_type.INT_FORM_BINARY16);
}

# tgt is the target: its machine model's half rows, packed rows and NaN rule
pub fun init(b: *builder.Builder, tgt: *target.Target) res[Half, fail.Fail] {
    if (tgt == nil || !float.nan_rule_valid(tgt.model.nan_rule)) {
        ret res[Half, fail.Fail].err{fail.message("half: expansion requires the target's machine model")};
    }
    var h: Half;
    h.b      = b;
    h.tgt    = tgt;
    h.model  = ?tgt.model;
    h.nan    = tgt.model.nan_rule;
    h.failed = false;
    val t16: res[ir_type.IrTypeId, fail.Fail] = carrier(?b.m.types);
    if (sel t16.err) { ret res[Half, fail.Fail].err{t16.err}; }
    val t32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?b.m.types, 32);
    if (sel t32.err) { ret res[Half, fail.Fail].err{t32.err}; }
    val t64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?b.m.types, 64);
    if (sel t64.err) { ret res[Half, fail.Fail].err{t64.err}; }
    val f64r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?b.m.types, 64);
    if (sel f64r.err) { ret res[Half, fail.Fail].err{f64r.err}; }
    h.bits_t = t16.ok;
    h.i32t   = t32.ok;
    h.i64t   = t64.ok;
    h.f64t   = f64r.ok;
    ret res[Half, fail.Fail].ok{h};
}

# the value, or the first failure on the way to it
pub fun done(h: *Half, v: value.Value) res[value.Value, fail.Fail] {
    if (h.failed) { ret res[value.Value, fail.Fail].err{h.first}; }
    ret res[value.Value, fail.Fail].ok{v};
}

fun take(h: *Half, r: res[value.Value, fail.Fail]) value.Value {
    if (sel r.err) {
        if (!h.failed) {
            h.failed = true;
            h.first  = r.err;
        }
        ret value.const_null(ir_type.IRT_NIL);
    }
    ret r.ok;
}

fun type_of(h: *Half, r: res[ir_type.IrTypeId, fail.Fail]) ir_type.IrTypeId {
    if (sel r.err) {
        if (!h.failed) {
            h.failed = true;
            h.first  = r.err;
        }
        ret ir_type.IRT_NIL;
    }
    ret r.ok;
}

fun native(h: *Half, op: isa.VecOp, is_float: bool, lane_bits: u32, from_bits: u32) bool {
    ret isa.half_native(h.model, op, is_float, lane_bits, from_bits);
}

fun f16_type(h: *Half) ir_type.IrTypeId {
    ret type_of(h, ir_type.intern_float(?h.b.m.types, 16));
}

fun float_type(h: *Half, bits: u32) ir_type.IrTypeId {
    ret type_of(h, ir_type.intern_float(?h.b.m.types, bits));
}

fun k32(h: *Half, n: u64) value.Value {
    ret value.const_int(n, h.i32t);
}

fun add(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_add(h.b, a, b));
}

fun sub(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_sub(h.b, a, b));
}

fun band(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_and(h.b, a, b));
}

fun bor(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_or(h.b, a, b));
}

fun bxor(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_xor(h.b, a, b));
}

fun shl(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_shl(h.b, a, b));
}

fun shr(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_shr_u(h.b, a, b));
}

fun eq(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_cmp_eq(h.b, a, b));
}

fun ne(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_cmp_ne(h.b, a, b));
}

fun lt_s(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_cmp_lt_s(h.b, a, b));
}

fun lt_u(h: *Half, a: value.Value, b: value.Value) value.Value {
    ret take(h, builder.emit_cmp_lt_u(h.b, a, b));
}

fun zext(h: *Half, a: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(h, builder.emit_zext(h.b, a, to));
}

fun trunc(h: *Half, a: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(h, builder.emit_trunc(h.b, a, to));
}

fun bitcast(h: *Half, a: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(h, builder.emit_bitcast(h.b, a, to));
}

# `a` where the flag `c` (a compare result) is set, else `b`, both i32
fun pick(h: *Half, c: value.Value, a: value.Value, b: value.Value) value.Value {
    val mask: value.Value = sub(h, k32(h, 0), zext(h, c, h.i32t));
    ret bxor(h, b, band(h, bxor(h, a, b), mask));
}

# the carried bits `x` widened exactly to binary64, a NaN as the target's
# rule converts it
pub fun widen(h: *Half, x: value.Value) value.Value {
    if (native(h, isa.VEC_OP_FP_EXT, true, 64, 16)) {
        ret take(h, builder.emit_fp_ext(h.b, bitcast(h, x, f16_type(h)), h.f64t));
    }
    ret widen_bits(h, x, false);
}

# `x` widened to binary64 as an operand of + - * /: a NaN keeps its sign, its
# payload and whether it signals, so the target's binary64 unit applies its own
# NaN selection, as a native half instruction does (#3801)
fun widen_operand(h: *Half, x: value.Value) value.Value {
    ret widen_bits(h, x, true);
}

# the integer widening: `exact` keeps a NaN as it is, otherwise it follows the rule
fun widen_bits(h: *Half, x: value.Value, exact: bool) value.Value {
    val w:    value.Value = zext(h, x, h.i32t);
    val sign: value.Value = shl(h, band(h, w, k32(h, 0x8000)), k32(h, 16));
    val e:    value.Value = band(h, shr(h, w, k32(h, 10)), k32(h, 0x1F));
    val m:    value.Value = band(h, w, k32(h, 0x3FF));
    val mhi:  value.Value = shl(h, m, k32(h, 10));
    # the high word of the binary64 encoding: rebiased for a normal value, the
    # all-ones exponent for an infinity, and for a NaN the rule's: the payload
    # kept and quieted, or the canonical NaN
    val norm: value.Value = bor(h, bor(h, sign, shl(h, add(h, e, k32(h, 1008)), k32(h, 20))), mhi);
    val inf:  value.Value = bor(h, sign, k32(h, 0x7FF00000));
    var spec: value.Value = pick(h, eq(h, m, k32(h, 0)), inf, k32(h, 0x7FF80000));
    if (exact) { spec = bor(h, inf, mhi); }
    or (h.nan == float.NAN_PRESERVE) {
        spec = bor(h, bor(h, inf, mhi), shl(h, zext(h, ne(h, m, k32(h, 0)), h.i32t), k32(h, 19)));
    }
    # a subnormal or zero is m * 2^-24, exact in binary64, and its low word is zero
    val subf: value.Value = take(h, builder.emit_mul(h.b, take(h, builder.emit_si_to_fp(h.b, m, h.f64t)),
        value.const_float(1.0 / 16777216.0, h.f64t)));
    val sub_hi: value.Value = bor(h, sign, trunc(h, take(h, builder.emit_shr_u(h.b, bitcast(h, subf, h.i64t), value.const_int(32, h.i64t))), h.i32t));
    val hi:     value.Value = pick(h, eq(h, e, k32(h, 0)), sub_hi, pick(h, eq(h, e, k32(h, 0x1F)), spec, norm));
    val bits:   value.Value = take(h, builder.emit_shl(h.b, zext(h, hi, h.i64t), value.const_int(32, h.i64t)));
    ret bitcast(h, bits, h.f64t);
}

# the binary64 `d` rounded once, to nearest with ties to even, into the carried bits
pub fun narrow(h: *Half, d: value.Value) value.Value {
    if (native(h, isa.VEC_OP_FP_TRUNC, true, 16, 64)) {
        ret bitcast(h, take(h, builder.emit_fp_trunc(h.b, d, f16_type(h))), h.bits_t);
    }
    val bits: value.Value = bitcast(h, d, h.i64t);
    val hi:   value.Value = trunc(h, take(h, builder.emit_shr_u(h.b, bits, value.const_int(32, h.i64t))), h.i32t);
    val lo:   value.Value = trunc(h, bits, h.i32t);
    val sign: value.Value = band(h, shr(h, hi, k32(h, 16)), k32(h, 0x8000));
    val ex:   value.Value = shr(h, band(h, hi, k32(h, 0x7FFFFFFF)), k32(h, 20));
    val mhi:  value.Value = band(h, hi, k32(h, 0xFFFFF));
    # the low word only ever lies below the round bit, so it folds into one
    # sticky bit under the high word's 20 significand bits
    val m:   value.Value = bor(h, mhi, zext(h, ne(h, lo, k32(h, 0)), h.i32t));
    val sig: value.Value = bor(h, m, k32(h, 0x100000));
    # the bits shifted out: 10 for a normal result, more for a subnormal one,
    # and 22 once the value lies below a quarter of the smallest subnormal,
    # where every bit goes and the result is zero
    val t:     value.Value = sub(h, k32(h, 1009), ex);
    val below: value.Value = pick(h, lt_s(h, t, k32(h, 0)), k32(h, 0), t);
    val s0:    value.Value = add(h, below, k32(h, 10));
    val s:     value.Value = pick(h, lt_u(h, k32(h, 22), s0), k32(h, 22), s0);
    val q:     value.Value = shr(h, sig, s);
    val rem:   value.Value = band(h, sig, sub(h, shl(h, k32(h, 1), s), k32(h, 1)));
    val half:  value.Value = shl(h, k32(h, 1), sub(h, s, k32(h, 1)));
    val odd:   value.Value = ne(h, band(h, q, k32(h, 1)), k32(h, 0));
    val up:    value.Value = bor(h, zext(h, lt_u(h, half, rem), h.i32t), band(h, zext(h, eq(h, rem, half), h.i32t), zext(h, odd, h.i32t)));
    # a carry out of the significand steps the exponent, and a subnormal that
    # rounds up to the smallest normal already spells its encoding
    val eo:   value.Value = sub(h, ex, k32(h, 1009));
    val ebit: value.Value = pick(h, lt_s(h, eo, k32(h, 0)), k32(h, 0), eo);
    val fin:  value.Value = add(h, add(h, q, up), shl(h, ebit, k32(h, 10)));
    val sat:  value.Value = pick(h, lt_u(h, fin, k32(h, 0x7C00)), fin, k32(h, 0x7C00));
    val nan:  value.Value = band(h, zext(h, eq(h, ex, k32(h, 0x7FF)), h.i32t), zext(h, ne(h, m, k32(h, 0)), h.i32t));
    var out:  value.Value = pick(h, ne(h, nan, k32(h, 0)), k32(h, 0x7E00), bor(h, sign, sat));
    if (h.nan == float.NAN_PRESERVE) {
        val qnan: value.Value = bor(h, k32(h, 0x7E00), shr(h, mhi, k32(h, 10)));
        out = bor(h, sign, pick(h, ne(h, nan, k32(h, 0)), qnan, sat));
    }
    ret trunc(h, out, h.bits_t);
}

# the carried bits negated: the sign flipped, as every float negation does
pub fun neg(h: *Half, x: value.Value) value.Value {
    ret bxor(h, x, value.const_int(0x8000, h.bits_t));
}

fun vec_op_of(k: instruction.InstrKind) isa.VecOp {
    if (k == instruction.OP_ADD) { ret isa.VEC_OP_ADD; }
    if (k == instruction.OP_SUB) { ret isa.VEC_OP_SUB; }
    if (k == instruction.OP_MUL) { ret isa.VEC_OP_MUL; }
    ret isa.VEC_OP_DIV;
}

fun emit_arith(h: *Half, k: instruction.InstrKind, a: value.Value, b: value.Value) value.Value {
    if (k == instruction.OP_ADD) { ret take(h, builder.emit_add(h.b, a, b)); }
    if (k == instruction.OP_SUB) { ret take(h, builder.emit_sub(h.b, a, b)); }
    if (k == instruction.OP_MUL) { ret take(h, builder.emit_mul(h.b, a, b)); }
    ret take(h, builder.emit_div_u(h.b, a, b));
}

# the target converts between f16 and binary32 both ways with its own
# instructions. binary32 carries 24 bits, twice binary16's 11 plus two, so one
# operation there on two widened operands and one rounding back is the
# correctly rounded binary16 result for + - * / (the 2p+2 bound). the
# conversion quiets a signaling operand, so the path is taken only where that
# leaves the NaN result as the exact operands give it: the units return the
# first NaN whatever signals, or every NaN is the canonical one
fun through_f32(h: *Half) bool {
    if (!h.model.nan_first_operand && h.nan != float.NAN_CANONICAL) { ret false; }
    ret converts_f32(h);
}

fun converts_f32(h: *Half) bool {
    ret native(h, isa.VEC_OP_FP_EXT, true, 32, 16) && native(h, isa.VEC_OP_FP_TRUNC, true, 16, 32);
}

# `a k b` on carried bits, k one of OP_ADD, OP_SUB, OP_MUL and OP_DIV_U, the
# float division
pub fun arith(h: *Half, k: instruction.InstrKind, a: value.Value, b: value.Value) value.Value {
    if (native(h, vec_op_of(k), true, 16, 16)) {
        val ft: ir_type.IrTypeId = f16_type(h);
        ret bitcast(h, emit_arith(h, k, bitcast(h, a, ft), bitcast(h, b, ft)), h.bits_t);
    }
    if (through_f32(h)) { ret from_float(h, emit_arith(h, k, to_float(h, a, 32), to_float(h, b, 32)), 32); }
    ret narrow(h, emit_arith(h, k, widen_operand(h, a), widen_operand(h, b)));
}

# the operand a comparison of carried bits reads: the f16 itself where the
# target compares at 16 bits, the exact binary32 widening where it converts
# there (a comparison makes no NaN, so quieting one changes nothing), else the
# exact binary64 widening
pub fun compare_operand(h: *Half, x: value.Value) value.Value {
    if (native(h, isa.VEC_OP_CMP, true, 16, 16)) { ret bitcast(h, x, f16_type(h)); }
    if (converts_f32(h))                         { ret to_float(h, x, 32); }
    ret widen(h, x);
}

# the float `v` of `bits` (32 or 64) converted to carried bits
pub fun from_float(h: *Half, v: value.Value, bits: u32) value.Value {
    if (native(h, isa.VEC_OP_FP_TRUNC, true, 16, bits)) {
        ret bitcast(h, take(h, builder.emit_fp_trunc(h.b, v, f16_type(h))), h.bits_t);
    }
    if (bits == 64) { ret narrow(h, v); }
    # binary32 widens exactly, so one rounding still happens
    ret narrow(h, take(h, builder.emit_fp_ext(h.b, v, h.f64t)));
}

# carried bits converted exactly to a float of `bits` (32 or 64)
pub fun to_float(h: *Half, x: value.Value, bits: u32) value.Value {
    if (native(h, isa.VEC_OP_FP_EXT, true, bits, 16)) {
        ret take(h, builder.emit_fp_ext(h.b, bitcast(h, x, f16_type(h)), float_type(h, bits)));
    }
    val d: value.Value = widen(h, x);
    if (bits == 64) { ret d; }
    ret take(h, builder.emit_fp_trunc(h.b, d, float_type(h, bits)));
}

# the integer `v` of `bits` converted to carried bits, rounding to nearest even
# and overflowing to infinity. binary64 rounds an integer past 2^53, but any
# such value lies past binary16's range, where the narrowing saturates anyway
pub fun from_int(h: *Half, v: value.Value, bits: u32, signed: bool) value.Value {
    var op: isa.VecOp = isa.VEC_OP_UI_TO_FP;
    if (signed) { op = isa.VEC_OP_SI_TO_FP; }
    if (native(h, op, true, 16, bits)) {
        var r: res[value.Value, fail.Fail] = builder.emit_ui_to_fp(h.b, v, f16_type(h));
        if (signed) { r = builder.emit_si_to_fp(h.b, v, f16_type(h)); }
        ret bitcast(h, take(h, r), h.bits_t);
    }
    if (signed) { ret narrow(h, take(h, builder.emit_si_to_fp(h.b, v, h.f64t))); }
    ret narrow(h, take(h, builder.emit_ui_to_fp(h.b, v, h.f64t)));
}

# carried bits converted to the integer type `ity` of `bits`, truncating toward
# zero; an operand out of range converts as the target's binary64 conversion
# does, the rule every float width follows
pub fun to_int(h: *Half, x: value.Value, ity: ir_type.IrTypeId, bits: u32, signed: bool) value.Value {
    var op: isa.VecOp = isa.VEC_OP_FP_TO_UI;
    if (signed) { op = isa.VEC_OP_FP_TO_SI; }
    var src: value.Value = value.const_null(ir_type.IRT_NIL);
    if (native(h, op, false, bits, 16)) { src = bitcast(h, x, f16_type(h)); }
    or                                  { src = widen(h, x); }
    if (signed)                         { ret take(h, builder.emit_fp_to_si(h.b, src, ity)); }
    ret take(h, builder.emit_fp_to_ui(h.b, src, ity));
}

# f16 lanes (#3802). a vector of f16 lanes is carried as a vector of the
# carrier, and each lane-wise operation is bit for bit the scalar one above on
# every lane: the target's packed row where it packs the cell of f16 lanes, the
# binary32 lanes its packed conversions reach where the scalar rule computes in
# binary32 too, and otherwise each lane's scalar operation, the expansion or the
# target's own half row. the lanes are read one by one and the result built from
# them as a vector literal is

# the lane count and element of a vector type, 0 lanes when it is not one
fun vec_shape(h: *Half, ty: ir_type.IrTypeId, elem: *ir_type.IrTypeId) u32 {
    val o: opt[*ir_type.IrType] = ir_type.get(?h.b.m.types, ty);
    if (sel o.none) { ret 0; }
    val t: *ir_type.IrType = o.some;
    if (t.kind != ir_type.IRT_VECTOR) { ret 0; }
    @elem = t.data.vector_.element;
    ret t.data.vector_.lanes;
}

fun vec_of(h: *Half, elem: ir_type.IrTypeId, lanes: u32) ir_type.IrTypeId {
    ret type_of(h, ir_type.intern_vector(?h.b.m.types, elem, lanes));
}

fun index_t(h: *Half) ir_type.IrTypeId {
    ret type_of(h, ir_type.intern_int(?h.b.m.types, h.model.index_width));
}

fun lane_of(h: *Half, v: value.Value, k: u32, elem: ir_type.IrTypeId) value.Value {
    ret take(h, builder.emit_vec_extract(h.b, v, value.const_int(k::u64, index_t(h)), elem));
}

# the cell of `kind` over `operand` vectors into a `ty` vector is one the
# target packs at these lanes
fun vec_packs(h: *Half, kind: instruction.InstrKind, ty: ir_type.IrTypeId, operand: ir_type.IrTypeId, n: u32) bool {
    ret vecform.operation_packs(h.b.m, h.tgt, kind, ty, operand, n);
}

# a vector of `vty` built from lanes as a vector literal is: one build where
# the target builds vectors from lanes, otherwise a slot written lane by lane
# and read whole. `at` yields lane k
rec Build {
    vty:   ir_type.IrTypeId;
    lanes: u32;
    slot:  value.Value;
    built: [16]value.Value;
    whole: bool;
}

fun build_start(h: *Half, vty: ir_type.IrTypeId, lanes: u32) Build {
    var bl: Build;
    bl.vty   = vty;
    bl.lanes = lanes;
    bl.whole = h.model.has_vec_build && lanes <= 16;
    if (!bl.whole) { bl.slot = take(h, builder.emit_alloca(h.b, vty, value.const_int(1, index_t(h)))); }
    ret bl;
}

fun build_lane(h: *Half, bl: *Build, k: u32, x: value.Value) {
    if (bl.whole) {
        bl.built[k] = x;
        ret;
    }
    var idx: [2]value.Value;
    idx[0] = value.const_int(0, index_t(h));
    idx[1] = value.const_int(k::u64, index_t(h));
    val at: value.Value    = take(h, builder.emit_gep(h.b, bl.slot, bl.vty, ?idx[0], 2));
    val st: err[fail.Fail] = builder.emit_store(h.b, x, at);
    if (sel st.err) {
        if (!h.failed) {
            h.failed = true;
            h.first  = st.err;
        }
    }
}

fun build_end(h: *Half, bl: *Build) value.Value {
    if (h.failed) { ret value.const_null(ir_type.IRT_NIL); }
    if (bl.whole) { ret take(h, builder.emit_vec_build(h.b, bl.vty, ?bl.built[0], bl.lanes)); }
    ret take(h, builder.emit_load(h.b, bl.slot, bl.vty));
}

fun f16_vec(h: *Half, lanes: u32) ir_type.IrTypeId {
    ret vec_of(h, f16_type(h), lanes);
}

fun carrier_vec(h: *Half, lanes: u32) ir_type.IrTypeId {
    ret vec_of(h, h.bits_t, lanes);
}

# the lanes `a k b` of two f16 vectors, k one of OP_ADD, OP_SUB, OP_MUL and
# OP_DIV_U, the float division
pub fun vec_arith(h: *Half, k: instruction.InstrKind, a: value.Value, b: value.Value) value.Value {
    var elem: ir_type.IrTypeId = ir_type.IRT_NIL;
    val n:    u32              = vec_shape(h, a.ty, ?elem);
    val fv:   ir_type.IrTypeId = f16_vec(h, n);
    if (vec_packs(h, k, fv, fv, 2)) {
        ret bitcast(h, emit_arith(h, k, bitcast(h, a, fv), bitcast(h, b, fv)), a.ty);
    }
    val sv: ir_type.IrTypeId = vec_of(h, float_type(h, 32), n);
    if (through_f32(h) && vec_packs(h, instruction.OP_FP_EXT, sv, fv, 1) && vec_packs(h, instruction.OP_FP_TRUNC, fv, sv, 1)) {
        val wa: value.Value = take(h, builder.emit_fp_ext(h.b, bitcast(h, a, fv), sv));
        val wb: value.Value = take(h, builder.emit_fp_ext(h.b, bitcast(h, b, fv), sv));
        ret bitcast(h, take(h, builder.emit_fp_trunc(h.b, emit_arith(h, k, wa, wb), fv)), a.ty);
    }
    var bl: Build = build_start(h, a.ty, n);
    var i:  u32   = 0;
    for (i < n) {
        build_lane(h, ?bl, i, arith(h, k, lane_of(h, a, i, elem), lane_of(h, b, i, elem)));
        i = i + 1;
    }
    ret build_end(h, ?bl);
}

fun emit_compare(h: *Half, k: instruction.InstrKind, a: value.Value, b: value.Value) value.Value {
    if (k == instruction.OP_CMP_EQ)   { ret take(h, builder.emit_cmp_eq(h.b, a, b)); }
    if (k == instruction.OP_CMP_NE)   { ret take(h, builder.emit_cmp_ne(h.b, a, b)); }
    if (k == instruction.OP_CMP_LT_U) { ret take(h, builder.emit_cmp_lt_u(h.b, a, b)); }
    ret take(h, builder.emit_cmp_le_u(h.b, a, b));
}

# the lane mask of `a k b` over two f16 vectors, k one of OP_CMP_EQ, OP_CMP_NE,
# OP_CMP_LT_U and OP_CMP_LE_U: all ones where it holds. a comparison makes no
# NaN and every widening is exact, so the f16 lanes, their binary32 lanes and
# each lane's scalar comparison agree
pub fun vec_compare(h: *Half, k: instruction.InstrKind, a: value.Value, b: value.Value, mask_ty: ir_type.IrTypeId) value.Value {
    var elem: ir_type.IrTypeId = ir_type.IRT_NIL;
    val n:    u32              = vec_shape(h, a.ty, ?elem);
    val fv:   ir_type.IrTypeId = f16_vec(h, n);
    if (vec_packs(h, k, mask_ty, fv, 2)) {
        ret take(h, builder.emit_vcompare(h.b, k, bitcast(h, a, fv), bitcast(h, b, fv), mask_ty));
    }
    val sv: ir_type.IrTypeId = vec_of(h, float_type(h, 32), n);
    val sm: ir_type.IrTypeId = vec_of(h, h.i32t, n);
    if (vec_packs(h, instruction.OP_FP_EXT, sv, fv, 1) && vec_packs(h, k, sm, sv, 2)) {
        val wa: value.Value = take(h, builder.emit_fp_ext(h.b, bitcast(h, a, fv), sv));
        val wb: value.Value = take(h, builder.emit_fp_ext(h.b, bitcast(h, b, fv), sv));
        ret take(h, builder.emit_trunc(h.b, take(h, builder.emit_vcompare(h.b, k, wa, wb, sm)), mask_ty));
    }
    var mask_elem: ir_type.IrTypeId = ir_type.IRT_NIL;
    vec_shape(h, mask_ty, ?mask_elem);
    var bl: Build = build_start(h, mask_ty, n);
    var i:  u32   = 0;
    for (i < n) {
        val c: value.Value = emit_compare(h, k, compare_operand(h, lane_of(h, a, i, elem)), compare_operand(h, lane_of(h, b, i, elem)));
        build_lane(h, ?bl, i, take(h, builder.emit_sub(h.b, value.const_int(0, mask_elem), zext(h, c, mask_elem))));
        i = i + 1;
    }
    ret build_end(h, ?bl);
}

# the lane-wise `::` of a vector with f16 lanes on one side or both into
# `dst`: `from_fp`, `from_bits` and `from_signed` describe the operand's lanes
# and the `to_` ones the result's, as the scalar conversions above take them
pub fun vec_convert(h: *Half, v: value.Value, dst: ir_type.IrTypeId, from_fp: bool, from_bits: u32, from_signed: bool,
    to_fp: bool, to_bits: u32, to_signed: bool) value.Value {
    var from_elem: ir_type.IrTypeId = ir_type.IRT_NIL;
    var to_elem:   ir_type.IrTypeId = ir_type.IRT_NIL;
    val n:         u32              = vec_shape(h, v.ty, ?from_elem);
    vec_shape(h, dst, ?to_elem);
    if (from_fp && to_fp && from_bits == 16 && to_bits > 16) {
        val fv: ir_type.IrTypeId = f16_vec(h, n);
        if (vec_packs(h, instruction.OP_FP_EXT, dst, fv, 1)) { ret take(h, builder.emit_fp_ext(h.b, bitcast(h, v, fv), dst)); }
    }
    if (from_fp && to_fp && to_bits == 16 && from_bits > 16) {
        val fv: ir_type.IrTypeId = f16_vec(h, n);
        if (vec_packs(h, instruction.OP_FP_TRUNC, fv, v.ty, 1)) { ret bitcast(h, take(h, builder.emit_fp_trunc(h.b, v, fv)), dst); }
    }
    var bl: Build = build_start(h, dst, n);
    var i:  u32   = 0;
    for (i < n) {
        val x: value.Value = lane_of(h, v, i, from_elem);
        var y: value.Value = x;
        if (from_fp && from_bits == 16 && to_fp) { y = to_float(h, x, to_bits); }
        or (from_fp && from_bits == 16)          { y = to_int(h, x, to_elem, to_bits, to_signed); }
        or (from_fp)                             { y = from_float(h, x, from_bits); }
        or                                       { y = from_int(h, x, from_bits, from_signed); }
        build_lane(h, ?bl, i, y);
        i = i + 1;
    }
    ret build_end(h, ?bl);
}
