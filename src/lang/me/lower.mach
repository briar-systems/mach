pub fun lower_module(req: *lower_context.LowerRequest) res[me_ir.Module, fail.Fail] {
    if (req == nil) { ret res[me_ir.Module, fail.Fail].err{fail.message("lower: lower_module requires a lowering request")}; }
    val s: *session.Session = req.s;
    val a: *ast.Ast         = req.module.a;

    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(req.malloc, req.module.fqn);
    if (sel res_module.err) {
        ret res[me_ir.Module, fail.Fail].err{res_module.err};
    }
    var m: me_ir.Module = res_module.ok;

    var lc:       lower_context.LowerContext;
    val res_init: err[fail.Fail] = lower_context.init_context(?lc, req, ?m);
    if (sel res_init.err) {
        me_ir.dnit(?m);
        ret res[me_ir.Module, fail.Fail].err{res_init.err};
    }

    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) {
        ret lower_module_fail(?lc, ?m, fail.message("lower: root_module is not set on this Ast"));
    }
    val mnode: *ast_module.Module = opt_module.some;

    var i: u32 = 0;
    for (i < mnode.decls_len) {
        val pool_ix: u32 = mnode.decls_start + i;
        if (pool_ix::usize >= a.decl_ids.len) {
            ret lower_module_fail(?lc, ?m, fail.message("lower: module decl index out of range"));
        }
        val did:      ast_id.DeclId  = a.decl_ids.data[pool_ix];
        val res_decl: err[fail.Fail] = lower_decl.lower_decl(?lc, did);
        if (sel res_decl.err) {
            val failure:     fail.Fail           = res_decl.err;
            val declaration: opt[*ast_decl.Decl] = ast.get_decl(a, did);
            if (!sel failure.reported) { ret lower_module_fail(?lc, ?m, failure); }
            if (sel declaration.none)  { ret lower_module_fail(?lc, ?m, failure); }
            val kind: ast_decl.DeclKind = declaration.some.kind;
            if (kind != ast_decl.DECL_KIND_VAL && kind != ast_decl.DECL_KIND_VAR) {
                ret lower_module_fail(?lc, ?m, failure);
            }
            if (sel lc.status.kind.accepted) { fail.reject(?lc.status); }
        }
        i = i + 1;
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    val res_emit: err[fail.Fail] = emit_instances(?lc, s);
    if (sel res_emit.err) {
        ret lower_module_fail(?lc, ?m, res_emit.err);
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    lower_context.dnit_context(?lc);
    ret res[me_ir.Module, fail.Fail].ok{m};
}

# binds the module's constants for `sweep` and emits nothing (see context.BindSweep)
pub fun bind_constants(req: *lower_context.LowerRequest, sweep: lower_context.BindSweep) err[fail.Fail] {
    if (req == nil) { ret err[fail.Fail].err{fail.message("lower: bind_constants requires a lowering request")}; }
    val a: *ast.Ast = req.module.a;

    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(req.malloc, req.module.fqn);
    if (sel res_module.err) { ret err[fail.Fail].err{res_module.err}; }
    var m: me_ir.Module = res_module.ok;

    var lc:       lower_context.LowerContext;
    val res_init: err[fail.Fail] = lower_context.init_context(?lc, req, ?m);
    if (sel res_init.err) {
        me_ir.dnit(?m);
        ret res_init;
    }
    lc.sweep = sweep;

    var bound: err[fail.Fail] = bind_decls(?lc, a);
    if (!sel lc.status.kind.accepted) { bound = err[fail.Fail].err{fail.phase_failure(lc.status)}; }
    lower_context.dnit_context(?lc);
    me_ir.dnit(?m);
    ret bound;
}

fun bind_decls(lc: *lower_context.LowerContext, a: *ast.Ast) err[fail.Fail] {
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret err[fail.Fail].err{fail.message("lower: root_module is not set on this Ast")}; }
    val mnode: *ast_module.Module = opt_module.some;
    var i:     u32                = 0;
    for (i < mnode.decls_len) {
        val pool_ix: u32 = mnode.decls_start + i;
        if (pool_ix::usize >= a.decl_ids.len) { ret err[fail.Fail].err{fail.message("lower: module decl index out of range")}; }
        val bound: err[fail.Fail] = lower_decl.lower_decl(lc, a.decl_ids.data[pool_ix]);
        if (sel bound.err) { ret bound; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a bind sweep over the module has work: a module-scope global of the sweep's kind
# whose constant is not bound yet, in any branch of a comptime `if`
pub fun constants_pending(s: *session.Session, a: *ast.Ast, ctx: *comptime.ComptimeCtx, sweep: lower_context.BindSweep) bool {
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret true; }
    val sf: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel sf.none) { ret true; }
    ret decls_pending(s, a, sf.some.text, ctx, sweep, opt_module.some.decls_start, opt_module.some.decls_len);
}

fun decls_pending(s: *session.Session, a: *ast.Ast, text: str, ctx: *comptime.ComptimeCtx, sweep: lower_context.BindSweep, start: u32, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= a.decl_ids.len) { ret true; }
        val did:      ast_id.DeclId       = a.decl_ids.data[pool_ix];
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, did);
        if (sel opt_decl.none) { ret true; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val branch_ix: u32 = d.data.comptime_if.branches_start + b;
                if (branch_ix::usize >= a.comptime_branches.len) { ret true; }
                val branch: *ast_decl.ComptimeBranch = ?a.comptime_branches.data[branch_ix];
                if (decls_pending(s, a, text, ctx, sweep, branch.body_start, branch.body_len)) { ret true; }
                b = b + 1;
            }
        }
        or ((d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) && !ast_id.expr_is_nil(d.data.bind.init)
            && resolve.declaration_testing(a, did) == (sweep == lower_context.SWEEP_TESTING)) {
            val named: res[intern.StrId, A.Error] = intern.range_add(?s.interner, text, d.data.bind.name.offset, d.data.bind.name.len);
            if (sel named.err) { ret true; }
            val bound: opt[comptime.NamedConst] = comptime.lookup(ctx, named.ok);
            if (sel bound.none) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun lower_module_fail(lc: *lower_context.LowerContext, m: *me_ir.Module, f: fail.Fail) res[me_ir.Module, fail.Fail] {
    var result: fail.Fail = f;
    if (sel lc.status.kind.internal) { result = fail.phase_failure(lc.status); }
    lower_context.dnit_context(lc);
    me_ir.dnit(m);
    ret res[me_ir.Module, fail.Fail].err{result};
}

# emits every instance sema found this object's code reaching, in the order sema found
# them: the module's normal object holds what its normal code reaches, its test object
# what any of its code reaches
fun emit_instances(lc: *lower_context.LowerContext, s: *session.Session) err[fail.Fail] {
    if (lc.instances == nil) { ret err[fail.Fail].ok{}; }
    val test_object: bool = lc.normal_object != nil;
    val n:           u32  = fe_sema.instance.count(lc.instances);
    var i:           u32  = 0;
    for (i < n) {
        val reach:  fe_sema.instance.Reach = fe_sema.instance.at(lc.instances, i).reach;
        var wanted: bool                   = (reach & fe_sema.instance.REACH_NORMAL) != 0;
        if (test_object && (reach & fe_sema.instance.REACH_TESTING) != 0) { wanted = true; }
        if (wanted) {
            val emitted: err[fail.Fail] = emit_instance(lc, s, i);
            if (sel emitted.err) { ret emitted; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_instance(lc: *lower_context.LowerContext, s: *session.Session, id: u32) err[fail.Fail] {
    val item:     *fe_sema.instance.Instance                = fe_sema.instance.at(lc.instances, id);
    val acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, item.origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: lower_context.ModuleScope = acquired.ok;

    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.a, item.decl);
    if (sel opt_decl.none) { ret err[fail.Fail].err{fail.message("lower: instance origin declaration not found")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("lower: instance origin declaration is not a function")}; }
    if (item.arg_len > 0) {
        val who_r: res[type.GenericOwner, fail.Fail] = fe_sema.generic_owner_of_decl(s, sc.a, item.origin, item.decl);
        if (sel who_r.err) { ret err[fail.Fail].err{who_r.err}; }
        sc.subst       = item.args;
        sc.subst_len   = item.arg_len;
        sc.subst_owner = who_r.ok;
    }
    sc.frame = item.frame;

    val name_r: res[intern.StrId, fail.Fail] = lower_context.instance_link_name(lc, item);
    if (sel name_r.err) { ret err[fail.Fail].err{name_r.err}; }

    val mark_r: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, sc);
    if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }

    var res_lower: err[fail.Fail] = err[fail.Fail].ok{};
    if (item.kind == fe_sema.instance.KIND_PACK) {
        res_lower = lower_decl.lower_pack_instance(lc, item.decl, d, name_r.ok, item.pack, item.pack_len);
    }
    or (item.kind == fe_sema.instance.KIND_VALUE) {
        res_lower = lower_bound_value_instance(lc, item.decl, d, name_r.ok, item.values, item.names, item.value_len);
    }
    or {
        res_lower = lower_decl.lower_instance(lc, item.decl, d, name_r.ok);
    }

    val leave: err[fail.Fail] = lower_context.scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret leave; }
    ret res_lower;
}

fun lower_bound_value_instance(lc: *lower_context.LowerContext, decl_id: ast_id.DeclId, d: *ast_decl.Decl,
    name: intern.StrId, vals: *comptime.CTValue,
    names: *intern.StrId, val_len: u32) err[fail.Fail] {
    val octx:   *comptime.ComptimeCtx              = lc.scope.ctx;
    val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(octx);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }
    val mark: comptime.FrameMark = mark_r.ok;

    var bound: err[fail.Fail] = err[fail.Fail].ok{};
    var i:     u32            = 0;
    for (i < val_len) {
        val res_bind: err[fail.Fail] = comptime.bind(octx, names[i], vals[i]);
        if (sel res_bind.err) {
            bound = res_bind;
            i     = val_len;
        }
        or { i = i + 1; }
    }
    var res_: err[fail.Fail] = bound;
    if (sel bound.ok) {
        res_ = lower_decl.lower_value_instance(lc, decl_id, d, name);
    }

    val res_close: err[fail.Fail] = comptime.frame_close(octx, mark);
    if (sel res_close.err) { ret res_close; }
    ret res_;
}

# modules checked by the front end alone, then lowered in the order they were typed, each into a
# home of its own, and held to the checks a build runs on lowered code; it must not move once made
#[testing]
pub rec Lowered {
    c:       checked.Checked;
    homes:   [resolve.FIXTURE_MODULES]me_ir.ModuleHome;
    irs:     [resolve.FIXTURE_MODULES]me_ir.Module;
    homed:   [resolve.FIXTURE_MODULES]bool;
    lowered: [resolve.FIXTURE_MODULES]bool;
    count:   u32;
    # the standing of every module's lowering and its checks
    status: fail.PhaseStatus;
}

# lower the module typed at `place` and check it; a rejection is the module's and is kept in
# the standing, anything else is the fixture's
#[testing]
fun lower_one(l: *Lowered, place: u32) err[fail.Fail] {
    val c:      *checked.Checked = ?l.c;
    val mid:    session.ModuleId = c.r.order[place];
    val row:    fe_load.Row      = resolve.resolved_row(?c.r, mid);
    val opened: err[fail.Fail]   = me_ir.home_init(?l.homes[place], ?c.r.alloc);
    if (sel opened.err) { ret opened; }
    l.homed[place] = true;
    val scoped: res[*comptime.ComptimeCtx, fail.Fail] = checked.checked_scope(c, place);
    if (sel scoped.err) { ret err[fail.Fail].err{scoped.err}; }
    var deps: fe_sema.SemaDeps = checked.checked_deps(c, place);
    fin { fe_sema.reader_dnit(?deps.definitions); }
    val req: res[lower_context.LowerRequest, fail.Fail] = lower_context.request(?c.r.s, ?c.r.target, ?l.homes[place].alloc, row.syntax, row.name, mid,
        ?c.mods[place].sr, ?c.r.results[place], scoped.ok, nil, false, true, true, ?c.r.s.diags, ?deps);
    if (sel req.err) { ret err[fail.Fail].err{req.err}; }
    var request: lower_context.LowerRequest   = req.ok;
    val made:    res[me_ir.Module, fail.Fail] = lower_module(?request);
    if (sel made.err) {
        val failure: fail.Fail = made.err;
        if (!sel failure.reported) { ret err[fail.Fail].err{failure}; }
        fail.reject(?l.status);
        ret err[fail.Fail].ok{};
    }
    l.irs[place]         = made.ok;
    l.irs[place].backing = l.homes[place].backing;
    l.lowered[place]     = true;
    var scope:      check_scope.Scope = check_scope.init(?l.irs[place], ?c.r.target, ?c.r.s.interner, ?c.r.s.diags, ?c.r.alloc);
    val checked_ir: err[fail.Fail]    = check_oblivious.run(?scope);
    if (sel checked_ir.err) {
        val failure: fail.Fail = checked_ir.err;
        if (!sel failure.reported) { ret checked_ir; }
        fail.reject(?l.status);
    }
    ret err[fail.Fail].ok{};
}

# check and lower `src` into `l`, released with lowered_dnit also when this fails; a failure is
# the fixture's own, and the modules' verdict is in the standings and the diagnostics. modules
# the front end rejected are not lowered, as a build stops there
#[testing]
pub fun lowered_check(l: *Lowered, src: *resolve.Sources) err[fail.Fail] {
    l.count  = 0;
    l.status = fail.accepted();
    val front: err[fail.Fail] = checked.checked_check(?l.c, src);
    if (sel front.err)                   { ret front; }
    if (!checked.checked_accepted(?l.c)) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < l.c.count) {
        l.homed[i]   = false;
        l.lowered[i] = false;
        l.count      = i + 1;
        val lowered: err[fail.Fail] = lower_one(l, i);
        if (sel lowered.err) { ret lowered; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun lowered_dnit(l: *Lowered) {
    var i: u32 = 0;
    for (i < l.count) {
        if (l.homed[i]) { me_ir.home_dnit(?l.homes[i]); }
        i = i + 1;
    }
    checked.checked_dnit(?l.c);
}

# whether the front end, the lowering and its checks all accepted the modules
#[testing]
pub fun lowered_accepted(l: *Lowered) bool {
    ret checked.checked_accepted(?l.c) && sel l.status.kind.accepted;
}

# the lowered module named `fqn`, nil when it was not lowered
#[testing]
pub fun lowered_ir(l: *Lowered, fqn: str) *me_ir.Module {
    var i: u32 = 0;
    for (i < l.count) {
        if (l.lowered[i] && str_equals(intern.text(?l.c.r.s.interner, resolve.resolved_row(?l.c.r, l.c.r.order[i]).name), fqn)) { ret ?l.irs[i]; }
        i = i + 1;
    }
    ret nil;
}

# the errors the front end and the lowering reported over `src`, -1 when the check failed or a
# phase rejected the modules without one
#[testing]
pub fun lower_errors(src: *resolve.Sources) i32 {
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, src);
    fin { lowered_dnit(?l); }
    if (sel made.err) { ret -1; }
    val errors: usize = diagnostic.error_count(?l.c.r.s.diags);
    if (errors == 0 && !lowered_accepted(?l)) { ret -1; }
    ret errors::i32;
}

# zero when the lowering, after the front end accepted `src`, rejects it with an error that says
# `needle`; the diagnostics are shown when it does not
#[testing]
pub fun lower_refuses(src: *resolve.Sources, needle: str) i32 {
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, src);
    fin { lowered_dnit(?l); }
    if (sel made.err)                                                                                                   { ret 1; }
    if (checked.checked_accepted(?l.c) && !sel l.status.kind.accepted && diagnostic.error_says(?l.c.r.s.diags, needle)) { ret 0; }
    diagnostic.show(?l.c.r.s.diags);
    ret 1;
}

# zero when the front end and the lowering report an error over `src` that says `needle`,
# whichever phase stopped it
#[testing]
pub fun lower_diagnostic(src: *resolve.Sources, needle: str) i32 {
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, src);
    fin { lowered_dnit(?l); }
    if (sel made.err)                                  { ret 1; }
    if (diagnostic.error_says(?l.c.r.s.diags, needle)) { ret 0; }
    ret 1;
}

# the one-module forms, over `t.main`
#[testing]
pub fun lower_clean(text: str) bool {
    var src: resolve.Sources = resolve.sources("t.main", text);
    ret lower_errors(?src) == 0;
}

#[testing]
pub fun lower_rejects_with(text: str, needle: str) i32 {
    var src: resolve.Sources = resolve.sources("t.main", text);
    ret lower_refuses(?src, needle);
}

#[testing]
pub fun lower_count(text: str) i32 {
    var src: resolve.Sources = resolve.sources("t.main", text);
    ret lower_errors(?src);
}

# zero when the front end and the lowering accept `text`
#[testing]
pub fun lower_ok(text: str) i32 {
    var src:  resolve.Sources = resolve.sources("t.main", text);
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 1; }
    ret 0;
}

#[testing]
pub fun lower_diag(text: str, needle: str) i32 {
    var src: resolve.Sources = resolve.sources("t.main", text);
    ret lower_diagnostic(?src, needle);
}

# whether `text` checks and lowers to a verdict with no error that says `needle`
#[testing]
pub fun lower_lacks(text: str, needle: str) bool {
    ret lower_count(text) >= 0 && lower_diag(text, needle) != 0;
}

test lowered__a_checked_module_lowers_to_its_functions {
    var src: resolve.Sources = resolve.sources("t.main", "use t.lib;\nfun twice(x: i32) i32 { ret lib.add(x, x); }\n");
    resolve.sources_add(?src, "t.lib", "pub fun add(a: i32, b: i32) i32 { ret a + b; }\n");
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err)          { ret 1; }
    if (!lowered_accepted(?l)) { ret 2; }
    val main: *me_ir.Module = lowered_ir(?l, "t.main");
    val lib:  *me_ir.Module = lowered_ir(?l, "t.lib");
    if (main == nil || lib == nil)                       { ret 3; }
    if (main.function_len == 0 || lib.function_len == 0) { ret 4; }
    ret 0;
}

# lowering reads the constants typing bound, its own module's and an import's alike
test lowered__reads_the_constants_typing_bound {
    var src: resolve.Sources = resolve.sources("t.main", "use t.lib;\nrec Q { a: u64; b: u32; }\nval OWN: u64 = $size_of(Q);\nfun main() u64 { ret OWN + lib.SIZE; }\n");
    resolve.sources_add(?src, "t.lib", "rec P { a: u64; b: u64; }\npub val SIZE: u64 = $size_of(P);\npub fun size() u64 { ret SIZE; }\n");
    if (lower_errors(?src) != 0) { ret 1; }
    ret 0;
}

test generic_instance__as_a_value {
    var bad: i32 = 0;

    if (!checked.sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(i64) i64 = ident[i64]; ret f(3); }\n"))                                     { bad = 1; }
    if (!checked.sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun apply(f: fun(i64) i64, x: i64) i64 { ret f(x); }\nfun main() i64 { ret apply(ident[i64], 3); }\n")) { bad = 1; }
    if (!checked.sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun pick() fun(i64) i64 { ret ident[i64]; }\nfun main() i64 { ret pick()(3); }\n"))                     { bad = 1; }
    if (!checked.sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val t: [1]fun(i64) i64 = [1]fun(i64) i64{ident[i64]}; ret t[0](3); }\n"))              { bad = 1; }
    if (!checked.sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val p: ptr = ?ident[i64]; ret p::i64; }\n"))                                           { bad = 1; }
    if (!lower_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(i64) i64 = ident[i64]; ret f(3); }\n"))                                            { bad = 1; }

    if (!checked.sema_clean("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(u32) u32 = ident[u32]; ret f(3::u32)::i64; }\n"))   { bad = 1; }
    if (!checked.sema_rejects("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(u32) u32 = ident[i64]; ret f(3::u32)::i64; }\n")) { bad = 1; }

    if (!checked.sema_rejects("pub fun ident[T](s: T) T { ret s; }\nfun main() i64 { val f: fun(i64) i64 = ident[i64, u32]; ret f(3); }\n")) { bad = 1; }
    if (!checked.sema_rejects("pub fun plain(s: i64) i64 { ret s; }\nfun main() i64 { val f: fun(i64) i64 = plain[i64]; ret f(3); }\n"))     { bad = 1; }
    if (!checked.sema_clean("pub fun plain(s: i64) i64 { ret s; }\nfun main() i64 { val f: fun(i64) i64 = plain; ret f(3); }\n"))            { bad = 1; }
    if (!checked.sema_clean2("use a: t.lib;\nfun main() i64 { val f: fun(i64) i64 = a.ident[i64]; ret f(3); }\n",
        "pub fun ident[T](s: T) T { ret s; }\n")) { bad = 1; }
    ret bad;
}

test generic_instance__reinfers_secrecy {
    var bad: i32 = 0;

    val cb: str = "fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; cb[^u32](x, y); ret 0; }\n";
    if (checked.sema_diag(cb, "secret value used as a branch condition") != 0) { bad = 1; }

    if (!checked.sema_clean("fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: u32 = 1; var y: u32 = 2; cb[u32](x, y); ret 0; }\n")) { bad = 1; }

    if (!checked.sema_rejects("fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: u32 = 1; var q: u32 = 2; var x: ^u32 = 1; var y: ^u32 = 1; cb[u32](p, q); cb[^u32](x, y); ret 0; }\n")) { bad = 1; }

    if (!checked.sema_rejects("fun cb[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun outer[T](a: T, b: T) u32 { ret cb[T](a, b); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; outer[^u32](x, y); ret 0; }\n")) { bad = 1; }

    if (!checked.sema_rejects("rec Pt { x: u32; y: u32; }\nfun eq[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: Pt; var q: Pt; eq[Pt](p, q); ret 0; }\n")) { bad = 1; }

    if (lower_rejects_with("fun mk[T](a: T, b: T) ^u8 { ret a == b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; mk[^u32](x, y); ret 0; }\n",
        "constant-time comparison on a secret value") != 0) { bad = 1; }
    if (lower_ok("#[oblivious]\nfun mk[T](a: T, b: T) ^u8 { ret a == b; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var x: ^u32 = 1; var y: ^u32 = 1; mk[^u32](x, y); ret 0; }\n") != 0) { bad = 1; }

    ret bad;
}

# a cycle of instances no comptime gate stops is refused at its growing call, naming the
# templates on it; a gated one runs as far as its gate lets it, however far that is
test generic_growth__ungated_cycles_refused_gated_ones_run {
    var bad: i32 = 0;
    if (checked.sema_diag("fun grow[T](x: i64) i64 { if (x == 0) { ret 0; } ret grow[*T](x - 1); }\nfun main() i64 { ret grow[i64](3); }\n",
        "`grow` instantiates `grow` here at an argument that grows, on a cycle of instances no comptime gate can stop (grow)") != 0) { bad = 1; }
    if (checked.sema_diag("fun f[T](x: i64) i64 { ret g[T](x); }\nfun g[T](x: i64) i64 { ret f[*T](x); }\nfun main() i64 { ret f[i64](3); }\n",
        "`g` instantiates `f` here at an argument that grows, on a cycle of instances no comptime gate can stop (f, g)") != 0) { bad = 2; }
    if (checked.sema_diag("fun up($n: u32, x: i64) i64 { if (x == 0) { ret 0; } ret up(n + 1, x - 1); }\nfun main() i64 { ret up(0, 3); }\n",
        "no comptime gate can stop (up)") != 0) { bad = 3; }
    if (checked.sema_diag("fun more(x: i64, va: ...) i64 { if (x == 0) { ret 0; } ret more(x - 1, x, va...); }\nfun main() i64 { ret more(3, 1); }\n",
        "no comptime gate can stop (more)") != 0) { bad = 4; }
    # a parameter passed on unchanged, or arguments swapped, grows nothing
    if (!checked.sema_clean("fun f[T, U](x: i64) i64 { if (x == 0) { ret 0; } ret f[U, T](x - 1); }\nfun main() i64 { ret f[i64, u8](3); }\n"))         { bad = 5; }
    if (!checked.sema_clean("fun fact($n: u32) i64 { $if (n == 0) { ret 1; } $or { ret n::i64 * fact(n - 1); } }\nfun main() i64 { ret fact(12); }\n")) { bad = 6; }
    # a finite chain longer than any depth bound builds
    if (lower_ok("fun peel[T](x: i64) i64 { $if ($is_pointer(T)) { ret peel[$pointee_of(T)](x + 1); } ret x; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i64 { ret peel[***************************************i64](0); }\n") != 0) { bad = 7; }
    ret bad;
}

test generic_arguments__pointee_of_a_parameter_names_the_instance_pointee {
    if (lower_ok("fun pt[T](x: T) T { ret x; }\nfun deref[T](p: T) i64 { ret pt[$pointee_of(T)](@p); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var y: i64 = 1; ret deref[*i64](?y)::i32; }\n") != 0) { ret 1; }
    ret 0;
}

# a generic body names the public type it expects and
# the template defers the equality to each instance
test generic_strip__target_checked_per_instance {
    if (!lower_clean("var g: ^u32 = 99;\nfun show[U](s: U) u32 { ret s:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u32](g); ret 0; }\n")) { ret 1; }
    if (lower_diag("var h: ^u64 = 99;\nfun show[U](s: U) u32 { ret s:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u64](h); ret 0; }\n",
        "must name the operand's stripped (public) type") != 0) { ret 2; }
    if (lower_diag("var g: ^u32 = 99;\nfun show[U](s: U) ^u32 { ret s:>^u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { show[^u32](g); ret 0; }\n",
        "target type must be public") != 0) { ret 3; }
    ret 0;
}

test generic_pack__each_body_instance_revalidated {
    var bad: i32 = 0;

    if (lower_diag("var g: ^u32 = 99;\nfun fmt(va: ...) u32 { ret 0; }\nfun show[U](s: U) u32 { ret fmt(s); }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + show[^u32](g) + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("var g: ^u32 = 99;\nfun fmt(va: ...) u32 { ret 0; }\nfun show[U](s: U) u32 { ret fmt(s); }\nfun sink() u32 { ret show[^u32](g); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { sink(); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("rec Pt { x: u32; y: u32; }\nvar p: Pt;\nvar q: Pt;\nfun eq[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + eq[Pt](p, q) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "aggregate equality is not structural") != 0) { bad = 1; }

    if (lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun eq[T](a: T, b: T) u8 { ret a == b; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + eq[^u32](g, g)::u32 + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "expected u8, found ^u8") != 0) { bad = 1; }

    if (lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun br[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + br[^u32](g, g) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun inner[V](a: V, b: V) u32 { if (a == b) { ret 1; } ret 0; }\n#[oblivious]\nfun outer[U](a: U, b: U) u32 { ret inner[U](a, b); }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + outer[^u32](g, g) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun br[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun inr(va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + br[^u32](g, g) + b; } ret acc; }\nfun otr(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + inr(a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; otr(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (lower_diag("var g: ^u32 = 99;\n#[oblivious]\nfun br[T](a: T, b: T) u32 { if (a == b) { ret 1; } ret 0; }\nfun tail(va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + br[^u32](g, g) + b; } ret acc; }\nfun head(va: ...) u32 { ret tail(va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; head(one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (!lower_clean("fun show[U](s: U) u32 { ret 1; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + show[u32](a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n"))                                                                    { bad = 1; }
    if (!lower_clean("var g: ^u32 = 99;\nfun fmt(va: ...) u32 { ret 0; }\nfun show[U](s: U) u32 { ret fmt(s:>u32); }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + show[^u32](g) + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n")) { bad = 1; }

    if (!lower_clean("rec Rc { a: u32; }\nvar g: Rc;\nfun take[T](x: T) u32 { ret 1u32; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + take[Rc](g); $if ($type_of(e) == u32) { acc = acc + e; } $or { $error(\"sink: unsupported element type\"); } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n")) { bad = 1; }

    ret bad;
}

test generic_pack__body_typed_at_the_instance {
    var bad: i32 = 0;

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); ret 0; }\n")) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T, U](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: U; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32, ^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](t: T, va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + logf(t); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 9; var one: u32 = 1; sink[^u32](s, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun probe[U](a: U, b: U) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each e in va { var x: T; var y: T; acc = acc + probe[T](x, y); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value used as a branch condition") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun inner[U](va: ...) u32 { var acc: u32 = 0; $each b in va { var z: U; acc = acc + logf(z); acc = acc + b; } ret acc; }\nfun outer[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + inner[T](a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; outer[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun tail[U](va: ...) u32 { var acc: u32 = 0; $each b in va { var z: U; acc = acc + logf(z); acc = acc + b; } ret acc; }\nfun fwd[T](va: ...) u32 { ret tail[T](va...); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; fwd[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("rec P { x: ^u32; }\nfun logf(va: ...) u32 { ret 0; }\nfun sink[T](v: T, va: ...) u32 { var acc: u32 = 0; $each e in va { $each f in $fields(T) { acc = acc + logf(v.[f]); } acc = acc + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var p: P; var one: u32 = 1; sink[P](p, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!lower_clean("rec Q { x: u32; }\nfun logf(va: ...) u32 { ret 0; }\nfun sink[T](v: T, va: ...) u32 { var acc: u32 = 0; $each e in va { $each f in $fields(T) { acc = acc + logf(v.[f]); } acc = acc + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var q: Q; var one: u32 = 1; sink[Q](q, one); ret 0; }\n")) { bad = 1; }

    if (lower_diag("rec P { x: ^u32; }\nfun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[P](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { var z: T; acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); sink[u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    val cmp_pack: str = "fun cmp[T](a: T, b: T, va: ...) u32 { var acc: u32 = 0; $each e in va { var m: ^u8 = a == b; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 1; var one: u32 = 1; cmp[^u32](s, s, one); ret 0; }\n";
    if (lower_diag(cmp_pack,
        "`cmp` performs a constant-time comparison") != 0) { bad = 1; }

    ret bad;
}

test generic_type_gate__folds_per_instance {
    var src:  resolve.Sources = resolve.sources("t.main", "fun byloc[T](s: T) i64 { var out: T = s;\n$if ($type_of(out) == u32) { ret 111; }\n$or ($type_of(out) == u64) { ret 333; }\n$or { ret 999; } }\nfun bypar[T](s: T) i64 {\n$if ($type_of(s) == u32) { ret 222; }\n$or ($type_of(s) == u64) { ret 444; }\n$or { ret 999; } }\npub fun p1(x: u32) i64 { ret byloc[u32](x); }\npub fun p2(y: u64) i64 { ret byloc[u64](y); }\npub fun p3(x: u32) i64 { ret bypar[u32](x); }\npub fun p4(y: u64) i64 { ret bypar[u64](y); }\nfun main() i32 { ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 1; }

    var bad: i32           = 0;
    val m:   *me_ir.Module = lowered_ir(?l, "t.main");
    if (m == nil) { bad = 1; }
    or {
        if (me_ir.const_uses(m, 111) != 1) { bad = 1; }
        if (me_ir.const_uses(m, 333) != 1) { bad = 1; }
        if (me_ir.const_uses(m, 222) != 1) { bad = 1; }
        if (me_ir.const_uses(m, 444) != 1) { bad = 1; }
    }

    ret bad;
}

# `$is_integer` and `$is_float` answer per instance, and each arm reaches lowering
# alone: the constant of the arm the instance selects is the only one emitted
test shape_predicates__answer_per_instance {
    var src:  resolve.Sources = resolve.sources("t.main", "rec P { x: i64; }\nfun kind[T](a: T) i64 { $if ($is_integer(T)) { ret 171; } $or ($is_float(T)) { ret 272; } $or { ret 373; } }\nfun main() i32 { var i: i64 = 1; var f: f64 = 1.0; var p: P; kind[i64](i); kind[f64](f); kind[P](p); ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 1; }

    var bad: i32           = 0;
    val m:   *me_ir.Module = lowered_ir(?l, "t.main");
    if (m == nil) { bad = 1; }
    or {
        if (me_ir.const_uses(m, 171) != 1) { bad = 2; }
        if (me_ir.const_uses(m, 272) != 1) { bad = 3; }
        if (me_ir.const_uses(m, 373) != 1) { bad = 4; }
    }

    ret bad;
}

test generic_type_gate__error_arm_chain_selects_the_matching_arm {
    var src:  resolve.Sources = resolve.sources("t.main", "fun write_any[T](a: T) i64 {\n$if ($type_of(a) == i64) { ret 171; }\n$or ($type_of(a) == u32) { ret 272; }\n$or { $error(\"unsupported type\"); } }\npub fun p1(x: i64) i64 { ret write_any[i64](x); }\npub fun p2(y: u32) i64 { ret write_any[u32](y); }\nfun main() i32 { ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 1; }

    var bad: i32           = 0;
    val m:   *me_ir.Module = lowered_ir(?l, "t.main");
    if (m == nil) { bad = 1; }
    or {
        if (me_ir.const_uses(m, 171) != 1) { bad = 2; }
        if (me_ir.const_uses(m, 272) != 1) { bad = 3; }
    }

    ret bad;
}

test generic_pack__body_typed_by_instantiated_types {
    if (!checked.sema_rejects_with("fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\nfun main() i32 { sink(7i64, 8i64); ret 0; }\n", "`u32` and `i64` are different types")) { ret 1; }
    if (lower_ok("fun sink(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a::u32; } ret acc; }\nfun main() i32 { sink(7i64, 8i64); ret 0; }\n") != 0)                                                { ret 2; }
    if (lower_ok("fun sum(va: ...) i64 { var t: i64 = 0; $each a in va { t = t + a::i64; } ret t; }\nfun main() i32 { sum(1000, 50::i32, 7::u8); ret 0; }\n") != 0)                                                { ret 3; }
    ret 0;
}

# an `$error` arm is pruned at an instance another arm matches and fires at one
# none does, for a chain of equalities and for a negated arm
test generic_type_gate__error_arm_fires_only_at_an_unmatched_instance {
    val chain:   str = "fun write_any[T](a: T) i64 {\n$if ($type_of(a) == i64) { ret 1; }\n$or ($type_of(a) == u32) { ret 2; }\n$or { $error(\"unsupported type\"); } }\n";
    val negated: str = "fun write_any[T](a: T) i64 {\n$if ($type_of(a) == i64) { ret 1; }\n$or ($type_of(a) != i64) { $error(\"unsupported type\"); }\n$or { ret 0; } }\n";
    val at_i64:  str = "pub fun run(x: i64) i64 { ret write_any[i64](x); }\n";
    val at_f64:  str = "pub fun run(x: f64) i64 { ret write_any[f64](x); }\n";
    if (!lower_clean(checked.joined(chain, at_i64)))                          { ret 2; }
    if (!lower_clean(checked.joined(negated, at_i64)))                        { ret 3; }
    if (lower_diag(checked.joined(chain, at_f64), "unsupported type") != 0)   { ret 4; }
    if (lower_diag(checked.joined(negated, at_f64), "unsupported type") != 0) { ret 5; }
    ret 0;
}

# how many integer operands of `t.main` equal `want` once `text` lowers as `t.main`, -1 when
# it does not lower
#[testing]
fun t_const_uses(text: str, want: u64) i64 {
    var src:  resolve.Sources = resolve.sources("t.main", text);
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret -1; }
    ret me_ir.const_uses(lowered_ir(?l, "t.main"), want)::i64;
}

# how many functions `t.main` defines whose name holds `needle`, or with `exact` is it, once
# `src` lowers, -1 when it does not lower
#[testing]
fun t_defined(src: *resolve.Sources, needle: str, exact: bool) i64 {
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret -1; }
    ret me_ir.defined_count(lowered_ir(?l, "t.main"), ?l.c.r.s.interner, needle, exact)::i64;
}

# a type parameter is replaced by the argument at ITS declaration's position, never by the
# caller's parameter that shares its index, so a caller whose list is reordered or longer than
# the callee's hands the callee the types the source names
#[testing]
fun t_reorder(callers: str, calls: str) str {
    val head: str = checked.joined("rec Natural {}\nrec Custom {}\nrec A[K, V] { k: K; v: V; policy: Natural; }\nrec B[K, V] { k: K; v: V; policy: Custom; }\nfun hk[K, M, P](m: *M, p: P, key: *K) u64 {\n$if ($type_of(p) == Natural) { ret (@key)::u64 + 3711; }\n$or ($type_of(p) == Custom) { ret m.k::u64 + 7113; }\n$or { $error(\"no arm\"); } }\n", callers);
    val call: str = checked.joined("pub fun run(a: *A[i64, u8], b: *B[i64, u8], key: *i64) u64 { ", calls);
    ret checked.joined(head, checked.joined(call, " }\nfun main() i32 { ret 0; }\n"));
}

test generic_arguments__map_to_the_callee_parameters {
    # the extra parameter after the callee's first (`find_extra`) and before it
    # (`find_first`); each reaches hk through a concrete two-layer instance
    val callers: str = "fun find_extra[K, V, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }\nfun find_first[V, K, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }\npub fun get_extra[K, V](m: *A[K, V], key: *K) u64 { var p: Natural; ret find_extra[K, V, A[K, V], Natural](m, p, key); }\npub fun get_first[K, V](m: *B[K, V], key: *K) u64 { var p: Custom; ret find_first[V, K, B[K, V], Custom](m, p, key); }\n";
    val text:    str = t_reorder(callers, "ret get_extra[i64, u8](a, key) + get_first[i64, u8](b, key);");
    # hk[i64, A[i64, u8], Natural] lowers its Natural arm and hk[i64, B[i64, u8], Custom] its Custom arm
    if (t_const_uses(text, 3711) != 1) { ret 4; }
    if (t_const_uses(text, 7113) != 1) { ret 5; }
    # the gate still judges the concrete instance: a Custom policy on a record
    # without the field the Custom arm reads is refused there
    val refused: str = "fun find_extra[K, V, M, P](m: *M, p: P, key: *K) u64 { ret hk[K, M, P](m, p, key); }\npub fun get_bad[K, V](m: *Natural, key: *K) u64 { var p: Custom; ret find_extra[K, V, Natural, Custom](m, p, key); }\n";
    if (lower_diag(t_reorder(refused, "var n: Natural; ret get_bad[i64, u8](?n, key);"), "no such field `k` on type Natural") != 0) { ret 7; }
    ret 0;
}

# an instance whose arguments are the caller's own type parameters is
# the template under other names, so it is judged as the template is (not at
# all: nothing in it is decided until the caller is instantiated); the closed
# instance the caller's own instantiation records is still judged, with the trail
test generic_instance__open_instance_judged_as_its_template {
    var bad: i32 = 0;

    # the two templates alone, no call site
    if (!checked.sema_clean("rec Min {}\nrec Max {}\nrec H[T, D] { v: T; order: D; }\nfun before[T, X](h: *X, a: *T, b: *T) i64 {\n$if ($type_of(h.order) == Max) { ret @b - @a; }\n$or ($type_of(h.order) == Min) { ret @a - @b; }\n$or { $error(\"bad\"); } }\nfun mid[T, X](h: *X, a: *T, b: *T) i64 { ret before[T, X](h, a, b); }\nfun main() i32 { ret 0; }\n")) { bad = 1; }
    # the concrete call through the forwarding layer selects the Max arm
    if (!lower_clean("rec Min {}\nrec Max {}\nrec H[T, D] { v: T; order: D; }\nfun before[T, X](h: *X, a: *T, b: *T) i64 {\n$if ($type_of(h.order) == Max) { ret @b - @a; }\n$or ($type_of(h.order) == Min) { ret @a - @b; }\n$or { $error(\"bad\"); } }\nfun mid[T, X](h: *X, a: *T, b: *T) i64 { ret before[T, X](h, a, b); }\nfun go2[T, D](h: *H[T, D], a: *T, b: *T) i64 { ret mid[T, H[T, D]](h, a, b); }\npub fun run(h: *H[i64, Max], a: *i64, b: *i64) i64 { ret go2[i64, Max](h, a, b); }\nfun main() i32 { ret 0; }\n")) { bad = 2; }
    # a closed instance whose X has no `order` is refused, at the instantiation
    val refused: str = "rec Min {}\nrec Max {}\nrec H[T, D] { v: T; order: D; }\nrec Bare { v: i64; }\nfun before[T, X](h: *X, a: *T, b: *T) i64 {\n$if ($type_of(h.order) == Max) { ret @b - @a; }\n$or ($type_of(h.order) == Min) { ret @a - @b; }\n$or { $error(\"bad\"); } }\nfun mid[T, X](h: *X, a: *T, b: *T) i64 { ret before[T, X](h, a, b); }\npub fun run(h: *Bare, a: *i64, b: *i64) i64 { ret mid[i64, Bare](h, a, b); }\nfun main() i32 { ret 0; }\n";
    if (!checked.sema_trail(refused, "no such field `order` on type Bare", 285, 21, 133, 7)) { bad = 4; }

    ret bad;
}

test generic_pack__instance_names {
    var one: resolve.Sources = resolve.sources("t.main", "fun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\nfun main() i32 { var one: u32 = 1; sink[u32](one); sink[^u32](one); ret 0; }\n");
    if (t_defined(?one, ".sink$", false) != 2)                      { ret 1; }
    if (t_defined(?one, "t.main.sink$u32$pack$u32", true) != 1)     { ret 2; }
    if (t_defined(?one, "t.main.sink$sec$u32$pack$u32", true) != 1) { ret 3; }
    var two: resolve.Sources = resolve.sources("t.main", "fun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + 1; } ret acc; }\nfun main() i32 { var a: u32 = 1; var b: u64 = 2; sink[u32](a); sink[u64](a); sink[u32](a, b); sink[u64](a, b); sink[u32](a); ret 0; }\n");
    if (t_defined(?two, ".sink$", false) != 4)                      { ret 4; }
    if (t_defined(?two, "t.main.sink$u32$pack$u32", true) != 1)     { ret 5; }
    if (t_defined(?two, "t.main.sink$u64$pack$u32", true) != 1)     { ret 6; }
    if (t_defined(?two, "t.main.sink$u32$pack$u32$u64", true) != 1) { ret 7; }
    if (t_defined(?two, "t.main.sink$u64$pack$u32$u64", true) != 1) { ret 8; }
    var plain: resolve.Sources = resolve.sources("t.main", "fun sum(va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\nfun main() i32 { var one: u32 = 1; sum(one); ret 0; }\n");
    if (t_defined(?plain, "t.main.sum$pack$u32", true) != 1) { ret 9; }
    if (t_defined(?plain, ".sum$", false) != 1)              { ret 10; }
    var imported: resolve.Sources = resolve.sources("t.main", "use t.lib;\nfun main() i32 { var one: u32 = 1; lib.sink[u32](one); lib.sink[^u32](one); ret 0; }\n");
    resolve.sources_add(?imported, "t.lib", "pub fun sink[T](va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\n");
    if (t_defined(?imported, "t.lib.", false) != 2)                     { ret 11; }
    if (t_defined(?imported, "t.lib.sink$u32$pack$u32", true) != 1)     { ret 12; }
    if (t_defined(?imported, "t.lib.sink$sec$u32$pack$u32", true) != 1) { ret 13; }
    ret 0;
}

# the kind of the type at `ix` of the signature of the first function `t.main` defines whose
# name holds `needle`, the return type when `ix` is past the parameters, IRT_VOID when there
# is none
#[testing]
fun t_sig_kind(l: *Lowered, needle: str, ix: u32) ir_type.IrTypeKind {
    val m: *me_ir.Module = lowered_ir(l, "t.main");
    if (m == nil) { ret ir_type.IRT_VOID; }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *me_ir.Function = ?m.functions[fi];
        if ((f.flags & me_ir.FN_FLAG_EXTERN) == 0 && str_contains(intern.text(?l.c.r.s.interner, f.name), needle)) {
            val t: opt[*ir_type.IrType] = ir_type.get(?m.types, f.sig);
            if (sel t.none)                    { ret ir_type.IRT_VOID; }
            if (t.some.kind != ir_type.IRT_FN) { ret ir_type.IRT_VOID; }
            var at: ir_type.IrTypeId = t.some.data.fn.ret_type;
            if (ix < t.some.data.fn.param_count) { at = t.some.data.fn.params[ix]; }
            val k: opt[*ir_type.IrType] = ir_type.get(?m.types, at);
            if (sel k.none) { ret ir_type.IRT_VOID; }
            ret k.some.kind;
        }
        fi = fi + 1;
    }
    ret ir_type.IRT_VOID;
}

test generic_pack__signature_substituted {
    if (lower_ok("fun sink[T](t: T, va: ...) u32 { var acc: u32 = 0; $each a in va { acc = acc + a; } ret acc; }\nfun main() i32 { var t: u32 = 3; var one: u32 = 1; sink[u32](t, one); ret 0; }\n") != 0)                                                          { ret 1; }
    if (lower_ok("fun sink[T](t: T, va: ...) u32 { var acc: *u8 = nil; $each a in va { acc = a; } ret 0; }\nfun main() i32 { var t: u32 = 3; var one: u32 = 1; sink[u32](t, one); ret 0; }\n") == 0)                                                                { ret 2; }
    if (!lower_clean("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { $each a in va { ret seed; } ret seed; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n")) { ret 3; }
    if (lower_diag("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { $each a in va { ret a; } ret seed; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n",
        "expected Box, found u32") != 0) { ret 4; }
    var src:  resolve.Sources = resolve.sources("t.main", "rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { $each a in va { ret seed; } ret seed; }\nfun main() i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l))                  { ret 5; }
    if (t_sig_kind(?l, "t.main.mk$", 0) != ir_type.IRT_STRUCT)  { ret 6; }
    if (t_sig_kind(?l, "t.main.mk$", 99) != ir_type.IRT_STRUCT) { ret 7; }
    ret 0;
}

test generic_pack__enclosing_body_typed {
    var bad: i32 = 0;

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }
    if (!lower_clean("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32](one); ret 0; }\n")) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](t: T, va: ...) u32 { var acc: u32 = 0; var z: T = t; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var s: ^u32 = 9; var one: u32 = 1; sink[^u32](s, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T, U](va: ...) u32 { var acc: u32 = 0; var z: U; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[u32, ^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; { var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](n: u32, va: ...) u32 { var acc: u32 = 0; if (n > 0) { var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one, one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; var i: u32 = 0; for (i < 2) { $each a in va { acc = acc + logf(z) + a; } i = i + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; { fin { $each a in va { acc = acc + logf(z) + a; } } acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    var xs: resolve.Sources = resolve.sources("t.main", "use t.lib;\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; lib.sink[^u32](one); ret 0; }\n");
    resolve.sources_add(?xs, "t.lib", "pub fun logf(va: ...) u32 { ret 0; }\npub fun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + logf(z); acc = acc + a; } ret acc; }\n");
    if (lower_diagnostic(?xs, "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (!lower_lacks("fun logf(va: ...) u32 { ret 0; }\nfun inner[U](x: U, va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + logf(x) + b; } ret acc; }\nfun outer[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + inner[T](z, a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; outer[^u32](one); ret 0; }\n",
        "found T")) { bad = 1; }
    if (lower_diag("fun logf(va: ...) u32 { ret 0; }\nfun inner[U](x: U, va: ...) u32 { var acc: u32 = 0; $each b in va { acc = acc + logf(x) + b; } ret acc; }\nfun outer[T](va: ...) u32 { var acc: u32 = 0; var z: T; $each a in va { acc = acc + inner[T](z, a); } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; outer[^u32](one); ret 0; }\n",
        "secret value cannot be passed to a variadic") != 0) { bad = 1; }

    if (!lower_clean("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { var out: T = seed; $each a in va { ret out; } ret out; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n")) { bad = 1; }
    if (!lower_clean("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) T { var out: T; $each a in va { out = seed; } ret out; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n"))     { bad = 1; }

    if (lower_diag("rec Box { a: u32; b: u32; c: u32; d: u32; }\nfun mk[T](seed: T, va: ...) u32 { var out: T = seed; $each a in va { ret out; } ret 0; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var b: Box; var one: u32 = 1; mk[Box](b, one); ret 0; }\n",
        "expected u32, found Box") != 0) { bad = 1; }

    if (lower_count("fun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; if (z) { acc = 1; } $each a in va { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; var two: u64 = 2; sink[^u32](one); sink[^u32](one, two); ret 0; }\n") != 1)                                                   { bad = 1; }
    if (lower_count("fun sink[T](va: ...) u32 { var acc: u32 = 0; var z: T; $error(\"boom\"); $each a in va { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; var two: u64 = 2; sink[^u32](one); sink[^u32](one, two); ret 0; }\n") != 1)                                                     { bad = 1; }
    if (lower_count("#[oblivious]\nfun br[V](a: V, b: V) u32 { if (a == b) { ret 1; } ret 0; }\nfun sink[T](va: ...) u32 { var acc: u32 = 0; var x: T; var y: T; acc = acc + br[T](x, y); $each a in va { acc = acc + 1; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink[^u32](one); ret 0; }\n") != 1) { bad = 1; }

    ret bad;
}

test generic_pack__enclosing_type_of_folds {
    if (t_const_uses("fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n", 4001) != 1)            { ret 1; }
    if (t_const_uses("fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n", 4002) != 0)            { ret 2; }
    if (t_const_uses("fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } $each a in va { r = r + a; } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n", 4001) != 1) { ret 3; }
    if (t_const_uses("fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } $each a in va { r = r + a; } ret r; }\nfun main() i32 { var p: u32 = 5; var one: u32 = 1; pick[u32](p, one); ret 0; }\n", 4002) != 0) { ret 4; }
    if (t_const_uses("fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u64 = 5; var one: u32 = 1; pick[u64](p, one); ret 0; }\n", 4001) != 0)            { ret 5; }
    if (t_const_uses("fun pick[T](seed: T, va: ...) u32 { var out: T = seed; var r: u32 = 0; $each a in va { $if ($type_of(out) == u32) { r = r + 4001; } $or { r = r + 4002; } } ret r; }\nfun main() i32 { var p: u64 = 5; var one: u32 = 1; pick[u64](p, one); ret 0; }\n", 4002) != 1)            { ret 6; }
    ret 0;
}

test length_of__in_a_comptime_gate {
    var bad: i32 = 0;

    if (checked.sema_arm("$if ($length_of([3]i64) == 3) { $error(\"Y\"); } $or { $error(\"N\"); }\nfun main() i32 { ret 0; }\n", "Y", "N") != 0) { bad = 1; }
    if (checked.sema_arm("$if ($length_of([3]i64) == 4) { $error(\"N\"); } $or { $error(\"Y\"); }\nfun main() i32 { ret 0; }\n", "Y", "N") != 0) { bad = 1; }

    if (lower_ok("$if ($length_of([3]i64) != 3) { $error(\"BAD\"); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n") != 0) { bad = 1; }

    if (lower_rejects_with("fun f(a: ^u32, b: ^u32) ^u32 { $if ($length_of([3]i64) == 3) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n",
        "not declared `#[oblivious]`") != 0) { bad = 1; }
    if (lower_ok("fun f(a: ^u32, b: ^u32) ^u32 { $if ($length_of([3]i64) == 4) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n") != 0) { bad = 1; }

    if (lower_rejects_with("fun f(a: ^u32, b: ^u32) ^u32 { $if ($size_of([3]i64) == 24) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n",
        "not declared `#[oblivious]`") != 0) { bad = 1; }
    if (lower_ok("fun f(a: ^u32, b: ^u32) ^u32 { $if ($size_of([3]i64) == 0) { ret a + b; } ret a; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { f(1, 2); ret 0; }\n") != 0) { bad = 1; }

    ret bad;
}

# an f16 value lowers, and an `ext` signature carries one by value, alone or in
# a record, by its convention's half row
test comptime_f16__lowers_and_crosses_ext {
    if (lower_ok("fun main() i32 { var x: f16 = 1.5; ret x::i32 - 1; }\n") != 0)                                       { ret 1; }
    if (lower_ok("rec H { a: f16; }\nfun main() i32 { var h: H; ret h.a::i32; }\n") != 0)                              { ret 2; }
    if (lower_ok("val X: u16 = (1.5f16 + 0.25f16):~u16;\nfun main() i32 { ret X::i32 - 16128; }\n") != 0)              { ret 3; }
    if (lower_ok("ext fun half(x: f16) f16;\nfun main() i32 { ret half(1.0)::i32; }\n") != 0)                          { ret 4; }
    if (lower_ok("rec H { a: f16; }\next fun take(h: H) H;\nfun main() i32 { var h: H; ret take(h).a::i32; }\n") != 0) { ret 5; }
    ret 0;
}

# the bits of the float global of `t.main` whose name holds `needle`, as f32 with `is_f32`,
# -1 when there is none
#[testing]
fun t_float_bits(l: *Lowered, needle: str, is_f32: bool) i64 {
    val m:  *me_ir.Module = lowered_ir(l, "t.main");
    val gi: i64           = me_ir.global_index(m, ?l.c.r.s.interner, needle);
    if (gi < 0) { ret -1; }
    val g: *me_ir.Global = ?m.globals[gi::u32];
    if (g.init.kind != value.VAL_CONST_FLOAT) { ret -1; }
    if (is_f32)                               { ret float.f64_to_f32_bits(float.f64_bits(g.init.data.float_lit))::i64; }
    ret float.f64_bits(g.init.data.float_lit)::i64;
}

test comptime_float__folds_at_its_declared_width {
    var src:  resolve.Sources = resolve.sources("t.main", "val A: f32 = 16777217.0;\nval B: f32 = A - 16777216.0;\nval C: f32 = 1.0 / 3.0 * 7.0 - 2.0;\nval H: f32 = 1.0 / 3.0 * 0.1;\nval N: f32 = 0.0 - (1.0 / 3.0);\nval D: f64 = 1.0 / 3.0 * 7.0 - 2.0;\nval E: f64 = 16777217.0 - 16777216.0;\nfun main() i32 { ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 1; }

    var ra: f32 = 16777216.0;
    var rb: f32 = ra - 16777216.0;
    var rc: f32 = 1.0 / 3.0 * 7.0 - 2.0;
    var rh: f32 = 1.0 / 3.0 * 0.1;
    var rn: f32 = 0.0 - (1.0 / 3.0);
    var rd: f64 = 1.0 / 3.0 * 7.0 - 2.0;
    var re: f64 = 16777217.0 - 16777216.0;

    var bad: i32 = 0;
    if (t_float_bits(?l, "t.main.A", true) != 0x4B800000)          { bad = 1; }
    if (t_float_bits(?l, "t.main.A", true) != (ra:~u32)::i64)      { bad = 1; }
    if (t_float_bits(?l, "t.main.B", true) != 0x00000000)          { bad = 1; }
    if (t_float_bits(?l, "t.main.B", true) != (rb:~u32)::i64)      { bad = 1; }
    if (t_float_bits(?l, "t.main.C", true) != 0x3EAAAAB0)          { bad = 1; }
    if (t_float_bits(?l, "t.main.C", true) != (rc:~u32)::i64)      { bad = 1; }
    if (t_float_bits(?l, "t.main.H", true) != 0x3D088889)          { bad = 1; }
    if (t_float_bits(?l, "t.main.H", true) != (rh:~u32)::i64)      { bad = 1; }
    if (t_float_bits(?l, "t.main.N", true) != 0xBEAAAAAB)          { bad = 1; }
    if (t_float_bits(?l, "t.main.N", true) != (rn:~u32)::i64)      { bad = 1; }
    if (t_float_bits(?l, "t.main.D", false) != 0x3FD5555555555550) { bad = 1; }
    if (t_float_bits(?l, "t.main.D", false) != (rd:~u64)::i64)     { bad = 1; }
    if (t_float_bits(?l, "t.main.E", false) != 0x3FF0000000000000) { bad = 1; }
    if (t_float_bits(?l, "t.main.E", false) != (re:~u64)::i64)     { bad = 1; }
    ret bad;
}

test char_literal__lowers_at_its_context_width {
    var bad: i32 = 0;
    if (!lower_clean("fun f() u64 { ret '0'; }\nfun main() i32 { ret 0; }\n"))                             { bad = 1; }
    if (!lower_clean("fun f(v: u64) u8 { ret ('0' + v % 10)::u8; }\nfun main() i32 { ret f(2)::i32; }\n")) { bad = 1; }
    if (!lower_clean("fun f(v: u64) u8 { ret (v % 10 + '0')::u8; }\nfun main() i32 { ret f(2)::i32; }\n")) { bad = 1; }
    if (!lower_clean("fun f(v: u64) u64 { ret ('0' + v)::u64; }\nfun main() i32 { ret f(2)::i32; }\n"))    { bad = 1; }
    ret bad;
}

test each__deferred_body_is_typed_per_instance {
    var bad: i32 = 0;

    val src: str = "rec Rc { a: u32; b: u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x; } ret acc; }\nfun sink(va: ...) u32 { var acc: u32 = 0; $each e in va { acc = acc + walk[Rc](g) + e; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { var one: u32 = 1; sink(one); ret 0; }\n";
    if (lower_diag(src, "operand types `u32` and `Rc`") != 0) { bad = 1; }
    if (!lower_lacks(src, "and `Tp`"))                        { bad = 1; }

    if (!lower_clean("rec Rc { a: u32; b: u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x.a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { walk[Rc](g); ret 0; }\n")) { bad = 1; }

    if (lower_diag("rec Rc { a: ^u32; }\nvar g: Rc;\nfun walk[Tp](x: Tp) u32 { var acc: u32 = 0; $each f in $fields(Tp) { acc = acc + x.a; } ret acc; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { walk[Rc](g); ret 0; }\n",
        "expected u32, found ^u32") != 0) { bad = 1; }

    ret bad;
}

test comptime_gate__reads_a_float_at_its_width {
    var src:  resolve.Sources = resolve.sources("t.main", "val K: f32 = 16777217.0;\n$if (K - 16777216.0 == 0.0) { val G: i64 = 1; }\n$or { val G: i64 = 0; }\nval K64: f64 = 16777217.0;\n$if (K64 - 16777216.0 == 0.0) { val G64: i64 = 1; }\n$or { val G64: i64 = 0; }\nval P: f32 = 0.1;\n$if (P > 0.1) { val GT: i64 = 1; }\n$or { val GT: i64 = 0; }\nval P64: f64 = 0.1;\n$if (P64 > 0.1) { val GT64: i64 = 1; }\n$or { val GT64: i64 = 0; }\nfun main() i32 { ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 1; }

    var bad: i32           = 0;
    val m:   *me_ir.Module = lowered_ir(?l, "t.main");
    if (m == nil) { bad = 1; }
    or {
        val gg: i64 = me_ir.global_index(m, ?l.c.r.s.interner, "t.main.G");
        if (gg < 0) { bad = 1; }
        or {
            if ((?m.globals[gg::u32]).init.data.int_lit != 1) { bad = 1; }
        }

        val gg64: i64 = me_ir.global_index(m, ?l.c.r.s.interner, "t.main.G64");
        if (gg64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gg64::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt: i64 = me_ir.global_index(m, ?l.c.r.s.interner, "t.main.GT");
        if (gt < 0) { bad = 1; }
        or {
            if ((?m.globals[gt::u32]).init.data.int_lit != 0) { bad = 1; }
        }

        val gt64: i64 = me_ir.global_index(m, ?l.c.r.s.interner, "t.main.GT64");
        if (gt64 < 0) { bad = 1; }
        or {
            if ((?m.globals[gt64::u32]).init.data.int_lit != 0) { bad = 1; }
        }
    }

    ret bad;
}

# an intrinsic over a generic's own type, a range read through a named count, and a `:>`
# declassification lower clean
test lowered__intrinsics_ranges_and_declassification {
    if (lower_ok("rec Box[T] { v: T; }\nfun sz[T]() u64 { ret $size_of(Box[T]); }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { sz[u32](); ret 0; }\n") != 0) { ret 1; }
    if (!lower_clean("val N: u64 = 2;\nfun main() i64 { val s: u64 = 1; val a: [4]i64 = [4]i64{1, 2, 3, 4}; val r: [2]i64 = a[s, N]; ret r[1]; }\n"))                       { ret 2; }
    if (lower_ok("fun down(a: ^u32) u32 { ret a:>u32; }\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { down(1); ret 0; }\n") != 0)                             { ret 3; }
    ret 0;
}

# whether `m` declares, not defines, a function or with `global` a global whose name holds `needle`
#[testing]
fun t_has_extern(l: *Lowered, m: *me_ir.Module, needle: str, global: bool) bool {
    if (m == nil) { ret false; }
    if (global) {
        var gi: u32 = 0;
        for (gi < m.global_len) {
            if (m.globals[gi].is_extern && str_contains(intern.text(?l.c.r.s.interner, m.globals[gi].name), needle)) { ret true; }
            gi = gi + 1;
        }
        ret false;
    }
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *me_ir.Function = ?m.functions[fi];
        if ((f.flags & me_ir.FN_FLAG_EXTERN) != 0 && str_contains(intern.text(?l.c.r.s.interner, f.name), needle)) { ret true; }
        fi = fi + 1;
    }
    ret false;
}

# how a module value reaches an importer: a qualified or leaf-imported `val` folds to its
# own module's value whatever shadows it, a same-module global folds through a cross-module
# base, an own `val` folds and its global goes unused, an aliased import folds, a `fun`, a
# `var`, a pointer `val` and a string `val` stay references to one definition, and a `def`
# is the declaring module's
test module_const__folds_across_modules {
    var src: resolve.Sources = resolve.sources("t.main", "use t.a;\nuse t.a.K;\nuse t.a.MSG;\nuse x: t.c;\nuse t.b;\nval X: i64 = 707;\nval A: u64 = a.BASE + 0x48;\nval B: u64 = A + 8;\ndef T: [9]u8;\nfun f() i64 { ret 101; }\nvar G: i64 = 404;\npub val N: i64 = 6543;\npub fun p1() i64 { ret a.X; }\npub fun p2() i64 { ret X; }\npub fun p3() i64 { ret b.Y; }\npub fun p4() i64 { ret b.K; }\npub fun p5() i64 { ret K; }\npub fun p6() u64 { ret B; }\npub fun p7() i64 { ret a.f(); }\npub fun p8() i64 { ret a.G; }\npub fun p9() u64 { ret $size_of(a.T); }\npub fun p10() i64 { val L: i64 = 808; ret a.L + L; }\npub fun p11() i64 { ret N; }\npub fun p12() i64 { ret x.N; }\npub fun p13() ptr { ret x.PH; }\npub fun p14() ptr { ret a.MSG; }\npub fun p15() ptr { ret MSG; }\nfun main() i32 { ret 0; }\n");
    resolve.sources_add(?src, "t.a", "pub val X: i64 = 909;\npub val K: i64 = 303;\npub rec P { x: u64; y: u64; }\npub val BASE: u64 = $size_of(P);\npub def T: [7]u8;\npub fun f() i64 { ret 202; }\npub var G: i64 = 505;\npub val L: i64 = 616;\npub val MSG: ptr = \"hello\";\n");
    resolve.sources_add(?src, "t.b", "pub val Y: i64 = 1505;\npub val K: i64 = 606;\n");
    resolve.sources_add(?src, "t.c", "pub val N: i64 = 4321;\npub var H: i64 = 1;\npub val PH: ptr = ?H;\n");
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 2; }
    val m: *me_ir.Module = lowered_ir(?l, "t.main");
    if (m == nil) { ret 4; }
    val itn: *intern.Interner = ?l.c.r.s.interner;

    # the imported `L` folds to its module's 616, not the local that shares its name
    var folded: [9]u64 = [9]u64{909, 707, 1505, 606, 303, 0x60, 616, 6543, 4321};
    var i:      usize  = 0;
    for (i < 9) {
        if (me_ir.const_uses(m, folded[i]) != 1) { ret (10 + i)::i32; }
        i = i + 1;
    }
    val gx: i64 = me_ir.global_index(m, itn, "t.main.X");
    if (gx < 0 || me_ir.operand_uses(m, value.VAL_GLOBAL, gx::u64) != 0 || m.globals[gx::u32].init.data.int_lit != 707) { ret 20; }
    val gn: i64 = me_ir.global_index(m, itn, "t.main.N");
    if (gn < 0 || me_ir.operand_uses(m, value.VAL_GLOBAL, gn::u64) != 0 || m.globals[gn::u32].init.data.int_lit != 6543) { ret 21; }
    if (!t_has_extern(?l, m, "t.a.f", false))                                                                            { ret 22; }
    if (!t_has_extern(?l, m, "t.a.G", true))                                                                             { ret 23; }
    if (me_ir.const_uses(m, 7) != 1 || me_ir.const_uses(m, 9) != 0)                                                      { ret 24; }
    if (t_has_extern(?l, m, "t.c.N", true))                                                                              { ret 25; }
    if (!t_has_extern(?l, m, "t.c.PH", true))                                                                            { ret 26; }
    if (!t_has_extern(?l, m, "t.a.MSG", true))                                                                           { ret 27; }
    var rodata: u32 = 0;
    var gi:     u32 = 0;
    for (gi < m.global_len) {
        if (m.globals[gi].init.kind == value.VAL_CONST_BYTES) { rodata = rodata + 1; }
        gi = gi + 1;
    }
    if (rodata != 0) { ret 28; }
    ret 0;
}

test global_init__folds_nested_scalar_casts {
    var src:  resolve.Sources = resolve.sources("t.main", "def Word: u64;\nval ALL: Word = ~(0::Word);\nval BYTE: u8 = ~((0::u8) | (0::u8));\nval SIGNED: i8 = (255u8:~i8);\nval HIGH: u64 = (128u8:~i8)::u64;\nval EXP: u64 = ((5.0:~u64) >> 52);\nfun main() i32 { $if ((~((0::u8) + (0::u8))) != 255u8) { $error(\"nested bitwise width\"); } $if (((5.0:~u64) >> 52) != 1025) { $error(\"nested cast gate\"); } ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 2; }
    val m: *me_ir.Module = lowered_ir(?l, "t.main");
    if (m == nil) { ret 4; }
    var labels:   [5]str = [5]str{"t.main.ALL", "t.main.BYTE", "t.main.SIGNED", "t.main.HIGH", "t.main.EXP"};
    var expected: [5]u64 = [5]u64{0xFFFFFFFFFFFFFFFF, 255, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFF80, 1025};
    var i:        u32    = 0;
    for (i < 5) {
        val gi: i64 = me_ir.global_index(m, ?l.c.r.s.interner, labels[i]);
        if (gi < 0) { ret 5; }
        val init: value.Value = m.globals[gi::u32].init;
        if (init.kind != value.VAL_CONST_INT || init.data.int_lit != expected[i]) { ret (6 + i)::i32; }
        i = i + 1;
    }
    ret 0;
}

test global_init__same_module_forward_reference_is_refused {
    var src: resolve.Sources = resolve.sources("t.main", "use t.a;\nval B: u64 = A + 8;\nval A: u64 = a.BASE + 0x48;\nfun main() i32 { ret 0; }\n");
    resolve.sources_add(?src, "t.a", "pub rec P { x: u64; y: u64; }\npub val BASE: u64 = $size_of(P);\n");
    ret lower_diagnostic(?src, "global initialiser of `B` must be a constant expression");
}

# whether the lowered text of `t.main` holds `needle`
#[testing]
fun t_ir_text_has(text: str, needle: str) bool {
    var src:  resolve.Sources = resolve.sources("t.main", text);
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret false; }
    var buf: [65536]u8;
    var b:   io_writer.Memory;
    var w:   io_writer.Writer    = io_writer.memory(?b, ?buf[0], 65536);
    var d:   ir_printer.IrWriter = ir_printer.ir_writer(?w, lowered_ir(?l, "t.main"), ?l.c.r.s.interner, ?l.c.r.s.sources,
        ir_printer.ir_context("post-lower", "t", "i", "o", "a", "f"), ir_printer.IR_FORM_DEBUG);
    val written: err[fail.Fail] = ir_printer.write_ir(?d);
    if (sel written.err) { ret false; }
    val n: usize = str_len(needle);
    var i: usize = 0;
    for (i + n <= b.len) {
        if (str_region_equals((?buf[0])::str, i, n, needle)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# ordering compares public addresses, so it lowers to the same unsigned integer
# compare a `usize` would, with no widening and no signed form
test pointer_compare__lowers_to_an_unsigned_compare {
    val src: str = "fun f(a: *^u8, b: *^u8) u8 { ret a < b; }\n#[symbol(\"main\")]\nfun main() i32 { ret 0; }\n";
    if (!t_ir_text_has(src, "cmp_lt_u")) { ret 1; }
    if (t_ir_text_has(src, "cmp_lt_s"))  { ret 2; }
    ret 0;
}

# a string literal lowers its escapes, and an unknown one is refused over its own span
test string_literal__unknown_escape_is_located {
    var src:  resolve.Sources = resolve.sources("t.main", "fun main() i32 { val s: *u8 = \"\\b\"; ret 0; }\n");
    var l:    Lowered;
    val made: err[fail.Fail]  = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err)                                                                                    { ret 1; }
    if (!diagnostic.error_at(?l.c.r.s.diags, "lower: unknown escape sequence in string literal", 30, 4)) { ret 2; }
    if (lower_ok("fun main() i32 { val s: *u8 = \"\\x08\"; ret 0; }\n") != 0)                            { ret 3; }
    ret 0;
}

# lowers `text` as `t.main` into `l` and hands its module, nil when it does not lower
#[testing]
fun t_lowered(l: *Lowered, text: str) *me_ir.Module {
    var src:  resolve.Sources = resolve.sources("t.main", text);
    val made: err[fail.Fail]  = lowered_check(l, ?src);
    if (sel made.err || !lowered_accepted(l)) { ret nil; }
    ret lowered_ir(l, "t.main");
}

#[testing]
rec ArithCount {
    arith:      u32;
    mismatched: u32;
}

#[testing]
fun count_arith(c: *ArithCount, f: *me_ir.Function, ins: *ir_instruction.Instruction) {
    if (ins.kind != ir_instruction.OP_ADD && ins.kind != ir_instruction.OP_SUB && ins.kind != ir_instruction.OP_MUL
        && ins.kind != ir_instruction.OP_DIV_S && ins.kind != ir_instruction.OP_DIV_U) { ret; }
    c.arith = c.arith + 1;
    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        if (!ir_type.same(ins.operands[oi].ty, ins.ty)) { c.mismatched = c.mismatched + 1; }
        oi = oi + 1;
    }
}

# how many arithmetic operands of lowered `text` have another type than their instruction,
# -1 when it does not lower and -2 when it has no arithmetic
#[testing]
fun t_arith_mismatches(text: str) i32 {
    var l: Lowered;
    fin { lowered_dnit(?l); }
    val m: *me_ir.Module = t_lowered(?l, text);
    if (m == nil) { ret -1; }
    var c: ArithCount = ArithCount{arith: 0, mismatched: 0};
    me_ir.each_instruction[ArithCount](m, ?c, count_arith);
    if (c.arith == 0) { ret -2; }
    ret c.mismatched::i32;
}

test literal_coercion__leaves_no_stale_subtree_type {
    if (t_arith_mismatches("fun f(a: f32, b: f32) f32 { ret a * (3.0 - 2.0 * b); }\n") != 0)         { ret 1; }
    if (t_arith_mismatches("fun f(a: f32, b: f32) f32 { ret a * (1.0 + (3.0 - 2.0 * b)); }\n") != 0) { ret 2; }
    if (t_arith_mismatches("fun f(a: i32, b: i32) i32 { ret a * (3 - 2 * b); }\n") != 0)             { ret 3; }
    ret 0;
}

#[testing]
rec Truth {
    cbrs:  u32;
    nots:  u32;
    wrong: bool;
}

# a branch tests its condition through a compare with one, and a negation compares with one
#[testing]
fun count_truth(t: *Truth, f: *me_ir.Function, ins: *ir_instruction.Instruction) {
    var compare: *ir_instruction.Instruction = nil;
    if (ins.kind == ir_instruction.OP_CBR && ins.operand_count == 3) {
        t.cbrs = t.cbrs + 1;
        if (ins.operands[0].kind != value.VAL_INSTR) {
            t.wrong = true;
            ret;
        }
        val cond: opt[*ir_instruction.Instruction] = me_ir.instruction_get(f, ins.operands[0].data.instr);
        if (sel cond.none) {
            t.wrong = true;
            ret;
        }
        if (sel cond.some) {
            if (cond.some.kind == ir_instruction.OP_CMP_EQ) { compare = cond.some; }
        }
    }
    or (ins.kind == ir_instruction.OP_CMP_NE) {
        t.nots  = t.nots + 1;
        compare = ins;
    }
    if (compare == nil) { ret; }
    if (compare.operand_count != 2) {
        t.wrong = true;
        ret;
    }
    val a_one: bool = compare.operands[0].kind == value.VAL_CONST_INT && compare.operands[0].data.int_lit == 1;
    val b_one: bool = compare.operands[1].kind == value.VAL_CONST_INT && compare.operands[1].data.int_lit == 1;
    if (!a_one && !b_one) { t.wrong = true; }
}

test condition__truth_is_a_compare_with_one {
    var l: Lowered;
    fin { lowered_dnit(?l); }
    val m: *me_ir.Module = t_lowered(?l, "fun choose(v: u8) u8 { if (v) { ret 1; } ret 0; }\nfun repeat(v: u8) u8 { for (v) { ret 1; } ret 0; }\nfun both(a: u8, b: u8) u8 { ret a && b; }\nfun either(a: u8, b: u8) u8 { ret a || b; }\nfun invert(v: u8) u8 { ret !v; }\nfun main() i32 { choose(0); choose(1); choose(2); ret 0; }\n");
    if (m == nil) { ret 1; }
    var t: Truth = Truth{cbrs: 0, nots: 0, wrong: false};
    me_ir.each_instruction[Truth](m, ?t, count_truth);
    if (t.wrong)                    { ret 2; }
    if (t.cbrs != 4 || t.nots != 1) { ret 3; }
    ret 0;
}

#[testing]
fun t_le(b: *u8, off: u32, len: u32) u64 {
    var v: u64 = 0;
    var i: u32 = 0;
    for (i < len) {
        v = v | (b[off + i]::u64 << (i::u64 * 8));
        i = i + 1;
    }
    ret v;
}

test const_aggregate__folds_cast_leaves {
    var l: Lowered;
    fin { lowered_dnit(?l); }
    val m: *me_ir.Module = t_lowered(?l, "val BIG: u32 = 0x1CAFE;\nval SMALL: u8 = 200;\nval PI64: f64 = 3.5;\nval HALFf: f32 = 0.5;\nval QRTf: f32 = 0.25;\npub val IPACK: [2]u32 = [2]u32{BIG::u16::u32, SMALL::u32};\npub val FNARROW: [1]f32 = [1]f32{PI64::f32};\npub val FWIDE: [2]f64 = [2]f64{HALFf::f64, QRTf::f64};\n");
    if (m == nil) { ret 1; }
    var saw_ipack:   bool = false;
    var saw_fnarrow: bool = false;
    var saw_fwide:   bool = false;
    var gi:          u32  = 0;
    for (gi < m.global_len) {
        val g: *me_ir.Global = ?m.globals[gi];
        if (g.init.kind == value.VAL_CONST_AGG) {
            val bytes: *u8 = g.init.data.agg.bytes;
            val len:   u32 = g.init.data.agg.len;
            if (len == 8 && t_le(bytes, 0, 4) == 51966 && t_le(bytes, 4, 4) == 200)                              { saw_ipack = true; }
            if (len == 4 && t_le(bytes, 0, 4) == 0x40600000)                                                     { saw_fnarrow = true; }
            if (len == 16 && t_le(bytes, 0, 8) == 0x3FE0000000000000 && t_le(bytes, 8, 8) == 0x3FD0000000000000) { saw_fwide = true; }
        }
        gi = gi + 1;
    }
    if (!saw_ipack)   { ret 2; }
    if (!saw_fnarrow) { ret 3; }
    if (!saw_fwide)   { ret 4; }
    ret 0;
}

test linkage_name__dotted_shapes {
    var src: resolve.Sources = resolve.sources("t.main", "use t.lib;\nfun main() i32 {\n    var l: lib.Leaf;\n    var bl: lib.Box[lib.Leaf];\n    var bbl: lib.Box[lib.Box[lib.Leaf]];\n    var arr: [4]u8;\n    var sec: ^u32 = 1;\n    var f: lib.BinOp = nil;\n    var acc: i64 = 0;\n    acc = acc + lib.wrap[lib.Leaf](l);\n    acc = acc + lib.wrap[lib.Box[lib.Leaf]](bl);\n    acc = acc + lib.wrap[lib.Box[lib.Box[lib.Leaf]]](bbl);\n    acc = acc + lib.wrap[*lib.Leaf](?l);\n    acc = acc + lib.wrap[[4]u8](arr);\n    acc = acc + lib.wrap[^u32](sec);\n    acc = acc + lib.wrap[lib.BinOp](f);\n    acc = acc + lib.pair[lib.Box[lib.Leaf], i64](bl, 1);\n    acc = acc + lib.pair[*lib.Box[lib.Leaf], u8](?bl, 2);\n    acc = acc + lib.plain(1);\n    acc = acc + lib.tag(7, 1);\n    acc = acc + lib.tag(-3, 1);\n    acc = acc + lib.gsum[u32](1, 2);\n    if (acc > 0) { ret 1; }\n    ret 0;\n}\n");
    resolve.sources_add(?src, "t.lib", "pub rec Leaf { n: i64; }\npub rec Box[T] { v: T; }\npub def BinOp: fun(i64, i64) i64;\npub fun wrap[T](x: T) i64 { ret 0; }\npub fun pair[A, B](a: A, b: B) i64 { ret 0; }\npub fun plain(x: i64) i64 { ret x; }\npub fun tag($n: i64, x: i64) i64 { ret x + n; }\npub fun gsum[T](va: ...) i64 { var a: i64 = 0; $each e in va { a = a + 1; } ret a; }\n");
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err || !lowered_accepted(?l)) { ret 1; }
    val itn:   *intern.Interner = ?l.c.r.s.interner;
    val m:     *me_ir.Module    = lowered_ir(?l, "t.main");
    var exact: [12]str          = [12]str{
        "t.lib.wrap$t.lib.Leaf", "t.lib.wrap$t.lib.Box$$t.lib.Leaf", "t.lib.wrap$t.lib.Box$$t.lib.Box$$$t.lib.Leaf",
        "t.lib.wrap$p$t.lib.Leaf", "t.lib.wrap$arr4$u8", "t.lib.wrap$sec$u32", "t.lib.wrap$fn$$i64$$i64$$i64",
        "t.lib.pair$t.lib.Box$$t.lib.Leaf$i64", "t.lib.pair$p$t.lib.Box$$t.lib.Leaf$u8", "t.lib.tag$7", "t.lib.tag$n3",
        "t.lib.gsum$u32$pack$i64$i64"
    };
    var i: u32 = 0;
    for (i < 12) {
        if (me_ir.defined_count(m, itn, exact[i], true) != 1) { ret (2 + i)::i32; }
        i = i + 1;
    }
    if (me_ir.defined_count(m, itn, "t.lib.wrap$", false) != 7) { ret 14; }
    # the plain function is defined once in lib, and main refers to it by the same name
    val lib: *me_ir.Module = lowered_ir(?l, "t.lib");
    if (me_ir.defined_count(lib, itn, "t.lib.plain", true) != 1) { ret 16; }
    if (!t_has_extern(?l, m, "t.lib.plain", false))              { ret 15; }
    ret 0;
}

#[testing]
rec Returns {
    types:      *ir_type.IrTypeTable;
    zero_bad:   bool;
    agg_values: u32;
}

# a constant a function returns is never an aggregate or a float zero filler, and an
# aggregate is returned as a value
#[testing]
fun count_returns(r: *Returns, f: *me_ir.Function, ins: *ir_instruction.Instruction) {
    if (ins.kind != ir_instruction.OP_RET || ins.operand_count == 0) { ret; }
    val op: value.Value = ins.operands[0];
    if (op.kind == value.VAL_CONST_INT && (ir_type.is_aggregate(r.types, op.ty) || ir_type.is_float_scalar(r.types, op.ty))) { r.zero_bad = true; }
    if (!value.is_constant(op) && ir_type.is_aggregate(r.types, op.ty))                                                      { r.agg_values = r.agg_values + 1; }
}

test fallthrough_return__is_well_typed {
    var l: Lowered;
    fin { lowered_dnit(?l); }
    val m: *me_ir.Module = t_lowered(?l, "rec P { a: u64; b: u64; }\nfun rec_loop() P { var p: P; for { p.a = 1; ret p; } }\nfun f64_loop() f64 { var i: i64 = 0; for { i = i + 1; ret 1.5; } }\nfun u64_loop() u64 { var i: u64 = 0; for { i = i + 1; ret i; } }\nfun rec_fall() P { var p: P; p.a = 1; }\nfun f64_fall() f64 { var i: i64 = 0; i = i + 1; }\nfun main() i32 { var a: P = rec_loop(); var b: P = rec_fall(); ret (a.a + b.a + u64_loop())::i32; }\n");
    if (m == nil) { ret 1; }
    var r: Returns = Returns{types: ?m.types, zero_bad: false, agg_values: 0};
    me_ir.each_instruction[Returns](m, ?r, count_returns);
    if (r.zero_bad)        { ret 2; }
    if (r.agg_values == 0) { ret 3; }
    # the loop's own return is the only one of rec_loop
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val f: *me_ir.Function = ?m.functions[fi];
        if (str_equals(intern.text(?l.c.r.s.interner, f.disp), "rec_loop")) {
            var rets: u32 = 0;
            var ii:   u32 = 0;
            for (ii < f.instr_len) {
                if (f.instrs[ii].kind == ir_instruction.OP_RET) { rets = rets + 1; }
                ii = ii + 1;
            }
            if (rets != 1) { ret 4; }
            ret 0;
        }
        fi = fi + 1;
    }
    ret 5;
}

# a grouped name or literal spans its parentheses, and every reader takes its name or value from
# the token it keeps: a comptime gate, a layout member, a decorator string
test grouped_expr__keeps_its_text {
    val src: str = "rec R { a: u8; b: u32; }\nval N: i32 = (4);\n$if ((N) != 4) { $error(\"name\"); }\n$if ((0x10) != 16) { $error(\"int\"); }\n$if (('a') != 97) { $error(\"char\"); }\n$if ((2.5) != 2.5) { $error(\"float\"); }\n$if ((\"ab\") != \"ab\") { $error(\"str\"); }\n$if ($offset_of(R, (b)) != 4) { $error(\"member\"); }\n#[section((\".text.grouped\"))]\nfun g() i32 { ret (N); }\nfun main() i32 {\n    var x: i32 = (N);\n    (x) = g();\n    ret (x) - 4;\n}\n";
    if (!checked.sema_clean(src)) { ret 1; }
    if (lower_ok(src) != 0)       { ret 2; }
    # an unresolved grouped name is reported by its own spelling, at the name
    if (!checked.sema_rejects_at("fun main() i32 { ret (nope); }\n", "unresolved identifier `nope`", 22, 4)) { ret 3; }
    ret 0;
}
