pub fun lower_module(req: *context.LowerRequest) res[ir.Module, fail.Fail] {
    if (req == nil) { ret res[ir.Module, fail.Fail].err{fail.message("lower: lower_module requires a lowering request")}; }
    val s: *session.Session = req.s;
    val a: *ast.Ast         = req.module.a;

    val res_module: res[ir.Module, fail.Fail] = ir.init(req.malloc, req.module.fqn);
    if (sel res_module.err) {
        ret res[ir.Module, fail.Fail].err{res_module.err};
    }
    var m: ir.Module = res_module.ok;

    var lc: context.LowerContext;
    val res_init: err[fail.Fail] = context.init_context(?lc, req, ?m);
    if (sel res_init.err) {
        ir.dnit(?m);
        ret res[ir.Module, fail.Fail].err{res_init.err};
    }

    val opt_module: O.Option[*module.Module] = ast.get_module(a, a.root_module);
    if (O.is_none[*module.Module](opt_module)) {
        ret lower_module_fail(?lc, ?m, fail.message("lower: root_module is not set on this Ast"));
    }
    val mnode: *module.Module = O.unwrap[*module.Module](opt_module);

    var i: u32 = 0;
    for (i < mnode.decls_len) {
        val pool_ix: u32 = mnode.decls_start + i;
        if (pool_ix::usize >= a.decl_id_len) {
            ret lower_module_fail(?lc, ?m, fail.message("lower: module decl index out of range"));
        }
        val did: id.DeclId = a.decl_ids[pool_ix];
        val res_decl: err[fail.Fail] = decl.lower_decl(?lc, did);
        if (sel res_decl.err) {
            val failure: fail.Fail = res_decl.err;
            val declaration: O.Option[*adecl.Decl] = ast.get_decl(a, did);
            if (!sel failure.reported) { ret lower_module_fail(?lc, ?m, failure); }
            if (O.is_none[*adecl.Decl](declaration)) { ret lower_module_fail(?lc, ?m, failure); }
            val kind: adecl.DeclKind = O.unwrap[*adecl.Decl](declaration).kind;
            if (kind != adecl.DECL_KIND_VAL && kind != adecl.DECL_KIND_VAR) {
                ret lower_module_fail(?lc, ?m, failure);
            }
            if (sel lc.status.kind.accepted) { fail.reject(?lc.status); }
        }
        i = i + 1;
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    val res_drain_types: err[fail.Fail] = drain_instances(?lc, s);
    if (sel res_drain_types.err) {
        ret lower_module_fail(?lc, ?m, res_drain_types.err);
    }

    val res_drain_values: err[fail.Fail] = drain_value_instances(?lc, s);
    if (sel res_drain_values.err) {
        ret lower_module_fail(?lc, ?m, res_drain_values.err);
    }

    val res_drain_packs: err[fail.Fail] = drain_pack_instances(?lc, s);
    if (sel res_drain_packs.err) {
        ret lower_module_fail(?lc, ?m, res_drain_packs.err);
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    context.dnit_context(?lc);
    ret res[ir.Module, fail.Fail].ok{m};
}

fun lower_module_fail(lc: *context.LowerContext, m: *ir.Module, f: fail.Fail) res[ir.Module, fail.Fail] {
    var result: fail.Fail = f;
    if (sel lc.status.kind.internal) { result = fail.phase_failure(lc.status); }
    context.dnit_context(lc);
    ir.dnit(m);
    ret res[ir.Module, fail.Fail].err{result};
}

fun drain_instances(lc: *context.LowerContext, s: *session.Session) err[fail.Fail] {
    for (lc.inst_drained < lc.inst_len) {
        val processed: u32              = lc.inst_drained;
        val decl_id:   id.DeclId        = lc.insts[processed].decl;
        val origin:    session.ModuleId = lc.insts[processed].origin;
        val arg_len:   u32              = lc.insts[processed].arg_len;
        val name:      intern.StrId     = lc.insts[processed].name;
        val args:      *type.TypeId     = lc.insts[processed].args;

        val res_emit: err[fail.Fail] = emit_one_instance(lc, s, decl_id, origin, args, arg_len, name, processed);
        if (sel res_emit.err) { ret res_emit; }

        lc.inst_drained = lc.inst_drained + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_one_instance(lc: *context.LowerContext, s: *session.Session,
                      decl_id: id.DeclId, origin: session.ModuleId,
                      args: *type.TypeId, arg_len: u32, name: intern.StrId,
                      current: u32) err[fail.Fail] {
    val acquired: res[context.ModuleScope, fail.Fail] = context.origin_scope(lc, origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: context.ModuleScope = acquired.ok;

    val opt_decl: O.Option[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (O.is_none[*adecl.Decl](opt_decl)) { ret err[fail.Fail].ok{}; }
    val d: *adecl.Decl = O.unwrap[*adecl.Decl](opt_decl);
    if (d.kind != adecl.DECL_KIND_FUN) { ret err[fail.Fail].ok{}; }

    sc.subst        = args;
    sc.subst_len    = arg_len;
    sc.inst_current = current;

    val mark_r: res[context.ScopeMark, fail.Fail] = context.scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }

    val res_lower: err[fail.Fail] = decl.lower_instance(lc, decl_id, d, name);

    val leave: err[fail.Fail] = context.scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret leave; }
    ret res_lower;
}

fun drain_value_instances(lc: *context.LowerContext, s: *session.Session) err[fail.Fail] {
    for (lc.vinst_drained < lc.vinst_len || lc.inst_drained < lc.inst_len) {
        for (lc.vinst_drained < lc.vinst_len) {
            val processed: u32               = lc.vinst_drained;
            val decl_id:   id.DeclId         = lc.vinsts[processed].decl;
            val origin:    session.ModuleId  = lc.vinsts[processed].origin;
            val val_len:   u32               = lc.vinsts[processed].val_len;
            val name:      intern.StrId      = lc.vinsts[processed].name;
            val vals:      *comptime.CTValue = lc.vinsts[processed].vals;
            val names:     *intern.StrId     = lc.vinsts[processed].names;

            val res_emit: err[fail.Fail] = emit_one_value_instance(lc, s, decl_id, origin, vals, names, val_len, name);
            if (sel res_emit.err) { ret res_emit; }

            lc.vinst_drained = lc.vinst_drained + 1;
        }

        val res_drain_types: err[fail.Fail] = drain_instances(lc, s);
        if (sel res_drain_types.err) { ret res_drain_types; }
    }
    ret err[fail.Fail].ok{};
}

fun emit_one_value_instance(lc: *context.LowerContext, s: *session.Session,
                            decl_id: id.DeclId, origin: session.ModuleId,
                            vals: *comptime.CTValue, names: *intern.StrId, val_len: u32,
                            name: intern.StrId) err[fail.Fail] {
    val acquired: res[context.ModuleScope, fail.Fail] = context.origin_scope(lc, origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: context.ModuleScope = acquired.ok;

    val opt_decl: O.Option[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (O.is_none[*adecl.Decl](opt_decl)) { ret err[fail.Fail].err{fail.message("lower: value-instance origin declaration not found")}; }
    val d: *adecl.Decl = O.unwrap[*adecl.Decl](opt_decl);
    if (d.kind != adecl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("lower: value-instance origin declaration is not a function")}; }

    val mark_r: res[context.ScopeMark, fail.Fail] = context.scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }
    val mark: context.ScopeMark = mark_r.ok;

    val res_bound: err[fail.Fail] = lower_bound_value_instance(lc, decl_id, d, name, vals, names, val_len);

    val leave: err[fail.Fail] = context.scope_leave(lc, mark);
    if (sel leave.err) { ret leave; }
    ret res_bound;
}

fun lower_bound_value_instance(lc: *context.LowerContext, decl_id: id.DeclId, d: *adecl.Decl,
                               name: intern.StrId, vals: *comptime.CTValue,
                               names: *intern.StrId, val_len: u32) err[fail.Fail] {
    val octx: *comptime.ComptimeCtx = lc.scope.ctx;
    val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(octx);
    if (R.is_err[comptime.FrameMark, str](mark_r)) {
        ret err[fail.Fail].err{fail.message(R.unwrap_err[comptime.FrameMark, str](mark_r))};
    }
    val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);

    var bound: err[fail.Fail] = err[fail.Fail].ok{};
    var i: u32 = 0;
    for (i < val_len) {
        val res_bind: R.Result[R.Void, str] = comptime.bind(octx, names[i], vals[i]);
        if (R.is_err[R.Void, str](res_bind)) { bound = fail.lift_err(res_bind); i = val_len; }
        or { i = i + 1; }
    }
    var res_: err[fail.Fail] = bound;
    if (sel bound.ok) {
        res_ = decl.lower_value_instance(lc, decl_id, d, name);
    }

    val res_close: R.Result[R.Void, str] = comptime.frame_close(octx, mark);
    if (R.is_err[R.Void, str](res_close)) { ret fail.lift_err(res_close); }
    ret res_;
}

fun drain_pack_instances(lc: *context.LowerContext, s: *session.Session) err[fail.Fail] {
    for (lc.pinst_drained < lc.pinst_len || lc.inst_drained < lc.inst_len || lc.vinst_drained < lc.vinst_len) {
        for (lc.pinst_drained < lc.pinst_len) {
            val processed: u32              = lc.pinst_drained;
            val decl_id:   id.DeclId        = lc.pinsts[processed].decl;
            val origin:    session.ModuleId = lc.pinsts[processed].origin;
            val arg_len:   u32              = lc.pinsts[processed].arg_len;
            val type_len:  u32              = lc.pinsts[processed].type_len;
            val name:      intern.StrId     = lc.pinsts[processed].name;
            val args:      *type.TypeId     = lc.pinsts[processed].args;
            val types:     *type.TypeId     = lc.pinsts[processed].types;

            val res_emit: err[fail.Fail] = emit_one_pack_instance(lc, s, decl_id, origin, args, arg_len, types, type_len, name);
            if (sel res_emit.err) { ret res_emit; }

            lc.pinst_drained = lc.pinst_drained + 1;
        }

        val res_drain_types: err[fail.Fail] = drain_instances(lc, s);
        if (sel res_drain_types.err) { ret res_drain_types; }
        val res_drain_values: err[fail.Fail] = drain_value_instances(lc, s);
        if (sel res_drain_values.err) { ret res_drain_values; }
    }
    ret err[fail.Fail].ok{};
}

fun emit_one_pack_instance(lc: *context.LowerContext, s: *session.Session,
                           decl_id: id.DeclId, origin: session.ModuleId,
                           args: *type.TypeId, arg_len: u32,
                           types: *type.TypeId, type_len: u32, name: intern.StrId) err[fail.Fail] {
    val acquired: res[context.ModuleScope, fail.Fail] = context.origin_scope(lc, origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: context.ModuleScope = acquired.ok;

    val opt_decl: O.Option[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (O.is_none[*adecl.Decl](opt_decl)) { ret err[fail.Fail].err{fail.message("lower: pack-instance origin declaration not found")}; }
    val d: *adecl.Decl = O.unwrap[*adecl.Decl](opt_decl);
    if (d.kind != adecl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("lower: pack-instance origin declaration is not a function")}; }

    sc.subst     = args;
    sc.subst_len = arg_len;

    val mark_r: res[context.ScopeMark, fail.Fail] = context.scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }

    val res_lower: err[fail.Fail] = decl.lower_pack_instance(lc, decl_id, d, name, types, type_len);

    val leave: err[fail.Fail] = context.scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret leave; }
    ret res_lower;
}
