pub fun lower_module(req: *context.LowerRequest) R.Result[ir.Module, fail.Fail] {
    if (req == nil) { ret R.err[ir.Module, fail.Fail](fail.message("lower: lower_module requires a lowering request")); }
    val s: *session.Session = req.s;
    val a: *ast.Ast         = req.module.a;

    val res_module: R.Result[ir.Module, str] = ir.init(req.malloc, req.module.fqn);
    if (R.is_err[ir.Module, str](res_module)) {
        ret R.err[ir.Module, fail.Fail](fail.message(R.unwrap_err[ir.Module, str](res_module)));
    }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    var lc: context.LowerContext;
    val res_init: R.Result[R.Void, fail.Fail] = context.init_context(?lc, req, ?m);
    if (R.is_err[R.Void, fail.Fail](res_init)) {
        ir.dnit(?m);
        ret R.err[ir.Module, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_init));
    }

    val opt_module: O.Option[*module.Module] = ast.get_module(a, a.root_module);
    if (O.is_none[*module.Module](opt_module)) {
        ret lower_module_fail(?lc, ?m, "lower: root_module is not set on this Ast");
    }
    val mnode: *module.Module = O.unwrap[*module.Module](opt_module);

    var i: u32 = 0;
    for (i < mnode.decls_len) {
        val pool_ix: u32 = mnode.decls_start + i;
        if (pool_ix::usize >= a.decl_id_len) {
            ret lower_module_fail(?lc, ?m, "lower: module decl index out of range");
        }
        val did: id.DeclId = a.decl_ids[pool_ix];
        val res_decl: R.Result[R.Void, fail.Fail] = decl.lower_decl(?lc, did);
        if (R.is_err[R.Void, fail.Fail](res_decl)) {
            ret lower_module_fail(?lc, ?m, R.unwrap_err[R.Void, fail.Fail](res_decl).message);
        }
        i = i + 1;
    }

    val res_drain_types: R.Result[R.Void, fail.Fail] = drain_instances(?lc, s);
    if (R.is_err[R.Void, fail.Fail](res_drain_types)) {
        ret lower_module_fail(?lc, ?m, R.unwrap_err[R.Void, fail.Fail](res_drain_types).message);
    }

    val res_drain_values: R.Result[R.Void, fail.Fail] = drain_value_instances(?lc, s);
    if (R.is_err[R.Void, fail.Fail](res_drain_values)) {
        ret lower_module_fail(?lc, ?m, R.unwrap_err[R.Void, fail.Fail](res_drain_values).message);
    }

    val res_drain_packs: R.Result[R.Void, fail.Fail] = drain_pack_instances(?lc, s);
    if (R.is_err[R.Void, fail.Fail](res_drain_packs)) {
        ret lower_module_fail(?lc, ?m, R.unwrap_err[R.Void, fail.Fail](res_drain_packs).message);
    }

    context.dnit_context(?lc);
    ret R.ok[ir.Module, fail.Fail](m);
}

fun lower_module_fail(lc: *context.LowerContext, m: *ir.Module, msg: str) R.Result[ir.Module, fail.Fail] {
    context.dnit_context(lc);
    ir.dnit(m);
    ret R.err[ir.Module, fail.Fail](fail.message(msg));
}

fun drain_instances(lc: *context.LowerContext, s: *session.Session) R.Result[R.Void, fail.Fail] {
    for (lc.inst_drained < lc.inst_len) {
        val processed: u32              = lc.inst_drained;
        val decl_id:   id.DeclId        = lc.insts[processed].decl;
        val origin:    session.ModuleId = lc.insts[processed].origin;
        val arg_len:   u32              = lc.insts[processed].arg_len;
        val name:      intern.StrId     = lc.insts[processed].name;
        val args:      *type.TypeId     = lc.insts[processed].args;

        val res_emit: R.Result[R.Void, fail.Fail] = emit_one_instance(lc, s, decl_id, origin, args, arg_len, name, processed);
        if (R.is_err[R.Void, fail.Fail](res_emit)) { ret res_emit; }

        lc.inst_drained = lc.inst_drained + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun emit_one_instance(lc: *context.LowerContext, s: *session.Session,
                      decl_id: id.DeclId, origin: session.ModuleId,
                      args: *type.TypeId, arg_len: u32, name: intern.StrId,
                      current: u32) R.Result[R.Void, fail.Fail] {
    val sc_o: O.Option[context.ModuleScope] = context.origin_scope(s, origin);
    if (O.is_none[context.ModuleScope](sc_o)) { ret R.ok_void[fail.Fail](); }
    var sc: context.ModuleScope = O.unwrap[context.ModuleScope](sc_o);

    val opt_decl: O.Option[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (O.is_none[*adecl.Decl](opt_decl)) { ret R.ok_void[fail.Fail](); }
    val d: *adecl.Decl = O.unwrap[*adecl.Decl](opt_decl);
    if (d.kind != adecl.DECL_KIND_FUN) { ret R.ok_void[fail.Fail](); }

    sc.subst        = args;
    sc.subst_len    = arg_len;
    sc.inst_current = current;

    val mark_r: R.Result[context.ScopeMark, fail.Fail] = context.scope_enter(lc, sc);
    if (R.is_err[context.ScopeMark, fail.Fail](mark_r)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[context.ScopeMark, fail.Fail](mark_r));
    }

    val res_lower: R.Result[R.Void, fail.Fail] = decl.lower_instance(lc, decl_id, d, name);

    val leave: R.Result[R.Void, fail.Fail] = context.scope_leave(lc, R.unwrap_ok[context.ScopeMark, fail.Fail](mark_r));
    if (R.is_err[R.Void, fail.Fail](leave)) { ret leave; }
    ret res_lower;
}

fun drain_value_instances(lc: *context.LowerContext, s: *session.Session) R.Result[R.Void, fail.Fail] {
    for (lc.vinst_drained < lc.vinst_len || lc.inst_drained < lc.inst_len) {
        for (lc.vinst_drained < lc.vinst_len) {
            val processed: u32               = lc.vinst_drained;
            val decl_id:   id.DeclId         = lc.vinsts[processed].decl;
            val origin:    session.ModuleId  = lc.vinsts[processed].origin;
            val val_len:   u32               = lc.vinsts[processed].val_len;
            val name:      intern.StrId      = lc.vinsts[processed].name;
            val vals:      *comptime.CTValue = lc.vinsts[processed].vals;
            val names:     *intern.StrId     = lc.vinsts[processed].names;

            val res_emit: R.Result[R.Void, fail.Fail] = emit_one_value_instance(lc, s, decl_id, origin, vals, names, val_len, name);
            if (R.is_err[R.Void, fail.Fail](res_emit)) { ret res_emit; }

            lc.vinst_drained = lc.vinst_drained + 1;
        }

        val res_drain_types: R.Result[R.Void, fail.Fail] = drain_instances(lc, s);
        if (R.is_err[R.Void, fail.Fail](res_drain_types)) { ret res_drain_types; }
    }
    ret R.ok_void[fail.Fail]();
}

fun emit_one_value_instance(lc: *context.LowerContext, s: *session.Session,
                            decl_id: id.DeclId, origin: session.ModuleId,
                            vals: *comptime.CTValue, names: *intern.StrId, val_len: u32,
                            name: intern.StrId) R.Result[R.Void, fail.Fail] {
    val sc_o: O.Option[context.ModuleScope] = context.origin_scope(s, origin);
    if (O.is_none[context.ModuleScope](sc_o)) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: value-instance origin module is not registered"));
    }
    val sc: context.ModuleScope = O.unwrap[context.ModuleScope](sc_o);

    val opt_decl: O.Option[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (O.is_none[*adecl.Decl](opt_decl)) { ret R.err[R.Void, fail.Fail](fail.message("lower: value-instance origin declaration not found")); }
    val d: *adecl.Decl = O.unwrap[*adecl.Decl](opt_decl);
    if (d.kind != adecl.DECL_KIND_FUN) { ret R.err[R.Void, fail.Fail](fail.message("lower: value-instance origin declaration is not a function")); }

    val mark_r: R.Result[context.ScopeMark, fail.Fail] = context.scope_enter(lc, sc);
    if (R.is_err[context.ScopeMark, fail.Fail](mark_r)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[context.ScopeMark, fail.Fail](mark_r));
    }
    val mark: context.ScopeMark = R.unwrap_ok[context.ScopeMark, fail.Fail](mark_r);

    val res_bound: R.Result[R.Void, fail.Fail] = lower_bound_value_instance(lc, decl_id, d, name, vals, names, val_len);

    val leave: R.Result[R.Void, fail.Fail] = context.scope_leave(lc, mark);
    if (R.is_err[R.Void, fail.Fail](leave)) { ret leave; }
    ret res_bound;
}

fun lower_bound_value_instance(lc: *context.LowerContext, decl_id: id.DeclId, d: *adecl.Decl,
                               name: intern.StrId, vals: *comptime.CTValue,
                               names: *intern.StrId, val_len: u32) R.Result[R.Void, fail.Fail] {
    val octx: *comptime.ComptimeCtx = lc.scope.ctx;
    val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(octx);
    if (R.is_err[comptime.FrameMark, str](mark_r)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.FrameMark, str](mark_r)));
    }
    val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);

    var res: R.Result[R.Void, fail.Fail] = R.ok_void[fail.Fail]();
    var i: u32 = 0;
    for (i < val_len) {
        val res_bind: R.Result[R.Void, str] = comptime.bind(octx, names[i], vals[i]);
        if (R.is_err[R.Void, str](res_bind)) { res = fail.lift[R.Void](res_bind); i = val_len; }
        or { i = i + 1; }
    }
    if (R.is_ok[R.Void, fail.Fail](res)) {
        res = decl.lower_value_instance(lc, decl_id, d, name);
    }

    val res_close: R.Result[R.Void, str] = comptime.frame_close(octx, mark);
    if (R.is_err[R.Void, str](res_close)) { ret fail.lift[R.Void](res_close); }
    ret res;
}

fun drain_pack_instances(lc: *context.LowerContext, s: *session.Session) R.Result[R.Void, fail.Fail] {
    for (lc.pinst_drained < lc.pinst_len || lc.inst_drained < lc.inst_len || lc.vinst_drained < lc.vinst_len) {
        for (lc.pinst_drained < lc.pinst_len) {
            val processed: u32              = lc.pinst_drained;
            val decl_id:   id.DeclId        = lc.pinsts[processed].decl;
            val origin:    session.ModuleId = lc.pinsts[processed].origin;
            val arg_len:   u32              = lc.pinsts[processed].arg_len;
            val type_len:  u32              = lc.pinsts[processed].type_len;
            val name:      intern.StrId     = lc.pinsts[processed].name;
            val args:      *type.TypeId     = lc.pinsts[processed].args;
            val types:     *type.TypeId     = lc.pinsts[processed].types;

            val res_emit: R.Result[R.Void, fail.Fail] = emit_one_pack_instance(lc, s, decl_id, origin, args, arg_len, types, type_len, name);
            if (R.is_err[R.Void, fail.Fail](res_emit)) { ret res_emit; }

            lc.pinst_drained = lc.pinst_drained + 1;
        }

        val res_drain_types: R.Result[R.Void, fail.Fail] = drain_instances(lc, s);
        if (R.is_err[R.Void, fail.Fail](res_drain_types)) { ret res_drain_types; }
        val res_drain_values: R.Result[R.Void, fail.Fail] = drain_value_instances(lc, s);
        if (R.is_err[R.Void, fail.Fail](res_drain_values)) { ret res_drain_values; }
    }
    ret R.ok_void[fail.Fail]();
}

fun emit_one_pack_instance(lc: *context.LowerContext, s: *session.Session,
                           decl_id: id.DeclId, origin: session.ModuleId,
                           args: *type.TypeId, arg_len: u32,
                           types: *type.TypeId, type_len: u32, name: intern.StrId) R.Result[R.Void, fail.Fail] {
    val sc_o: O.Option[context.ModuleScope] = context.origin_scope(s, origin);
    if (O.is_none[context.ModuleScope](sc_o)) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: pack-instance origin module is not registered"));
    }
    var sc: context.ModuleScope = O.unwrap[context.ModuleScope](sc_o);

    val opt_decl: O.Option[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (O.is_none[*adecl.Decl](opt_decl)) { ret R.err[R.Void, fail.Fail](fail.message("lower: pack-instance origin declaration not found")); }
    val d: *adecl.Decl = O.unwrap[*adecl.Decl](opt_decl);
    if (d.kind != adecl.DECL_KIND_FUN) { ret R.err[R.Void, fail.Fail](fail.message("lower: pack-instance origin declaration is not a function")); }

    sc.subst     = args;
    sc.subst_len = arg_len;

    val mark_r: R.Result[context.ScopeMark, fail.Fail] = context.scope_enter(lc, sc);
    if (R.is_err[context.ScopeMark, fail.Fail](mark_r)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[context.ScopeMark, fail.Fail](mark_r));
    }

    val res_lower: R.Result[R.Void, fail.Fail] = decl.lower_pack_instance(lc, decl_id, d, name, types, type_len);

    val leave: R.Result[R.Void, fail.Fail] = context.scope_leave(lc, R.unwrap_ok[context.ScopeMark, fail.Fail](mark_r));
    if (R.is_err[R.Void, fail.Fail](leave)) { ret leave; }
    ret res_lower;
}
