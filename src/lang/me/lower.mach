pub fun lower_module(req: *lower_context.LowerRequest) res[me_ir.Module, fail.Fail] {
    if (req == nil) { ret res[me_ir.Module, fail.Fail].err{fail.message("lower: lower_module requires a lowering request")}; }
    val s: *session.Session = req.s;
    val a: *ast.Ast         = req.module.a;

    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(req.malloc, req.module.fqn);
    if (sel res_module.err) {
        ret res[me_ir.Module, fail.Fail].err{res_module.err};
    }
    var m: me_ir.Module = res_module.ok;

    var lc:       lower_context.LowerContext;
    val res_init: err[fail.Fail] = lower_context.init_context(?lc, req, ?m);
    if (sel res_init.err) {
        me_ir.dnit(?m);
        ret res[me_ir.Module, fail.Fail].err{res_init.err};
    }

    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) {
        ret lower_module_fail(?lc, ?m, fail.message("lower: root_module is not set on this Ast"));
    }
    val mnode: *ast_module.Module = opt_module.some;

    var i: u32 = 0;
    for (i < mnode.decls_len) {
        val pool_ix: u32 = mnode.decls_start + i;
        if (pool_ix::usize >= a.decl_id_len) {
            ret lower_module_fail(?lc, ?m, fail.message("lower: module decl index out of range"));
        }
        val did:      ast_id.DeclId  = a.decl_ids[pool_ix];
        val res_decl: err[fail.Fail] = lower_decl.lower_decl(?lc, did);
        if (sel res_decl.err) {
            val failure:     fail.Fail           = res_decl.err;
            val declaration: opt[*ast_decl.Decl] = ast.get_decl(a, did);
            if (!sel failure.reported) { ret lower_module_fail(?lc, ?m, failure); }
            if (sel declaration.none)  { ret lower_module_fail(?lc, ?m, failure); }
            val kind: ast_decl.DeclKind = declaration.some.kind;
            if (kind != ast_decl.DECL_KIND_VAL && kind != ast_decl.DECL_KIND_VAR) {
                ret lower_module_fail(?lc, ?m, failure);
            }
            if (sel lc.status.kind.accepted) { fail.reject(?lc.status); }
        }
        i = i + 1;
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    val res_drain_types: err[fail.Fail] = drain_instances(?lc, s);
    if (sel res_drain_types.err) {
        ret lower_module_fail(?lc, ?m, res_drain_types.err);
    }

    val res_drain_values: err[fail.Fail] = drain_value_instances(?lc, s);
    if (sel res_drain_values.err) {
        ret lower_module_fail(?lc, ?m, res_drain_values.err);
    }

    val res_drain_packs: err[fail.Fail] = drain_pack_instances(?lc, s);
    if (sel res_drain_packs.err) {
        ret lower_module_fail(?lc, ?m, res_drain_packs.err);
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    lower_context.dnit_context(?lc);
    ret res[me_ir.Module, fail.Fail].ok{m};
}

# binds the module's constants for `sweep` and emits nothing (see context.BindSweep)
pub fun bind_constants(req: *lower_context.LowerRequest, sweep: lower_context.BindSweep) err[fail.Fail] {
    if (req == nil) { ret err[fail.Fail].err{fail.message("lower: bind_constants requires a lowering request")}; }
    val a: *ast.Ast = req.module.a;

    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(req.malloc, req.module.fqn);
    if (sel res_module.err) { ret err[fail.Fail].err{res_module.err}; }
    var m: me_ir.Module = res_module.ok;

    var lc:       lower_context.LowerContext;
    val res_init: err[fail.Fail] = lower_context.init_context(?lc, req, ?m);
    if (sel res_init.err) {
        me_ir.dnit(?m);
        ret res_init;
    }
    lc.sweep = sweep;

    var bound: err[fail.Fail] = bind_decls(?lc, a);
    if (!sel lc.status.kind.accepted) { bound = err[fail.Fail].err{fail.phase_failure(lc.status)}; }
    lower_context.dnit_context(?lc);
    me_ir.dnit(?m);
    ret bound;
}

fun bind_decls(lc: *lower_context.LowerContext, a: *ast.Ast) err[fail.Fail] {
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret err[fail.Fail].err{fail.message("lower: root_module is not set on this Ast")}; }
    val mnode: *ast_module.Module = opt_module.some;
    var i:     u32                = 0;
    for (i < mnode.decls_len) {
        val pool_ix: u32 = mnode.decls_start + i;
        if (pool_ix::usize >= a.decl_id_len) { ret err[fail.Fail].err{fail.message("lower: module decl index out of range")}; }
        val bound: err[fail.Fail] = lower_decl.lower_decl(lc, a.decl_ids[pool_ix]);
        if (sel bound.err) { ret bound; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a bind sweep over the module has work: a module-scope global of the sweep's kind
# whose constant is not bound yet, in any branch of a comptime `if`
pub fun constants_pending(s: *session.Session, a: *ast.Ast, ctx: *comptime.ComptimeCtx, sweep: lower_context.BindSweep) bool {
    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) { ret true; }
    val sf: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel sf.none) { ret true; }
    ret decls_pending(s, a, sf.some.text, ctx, sweep, opt_module.some.decls_start, opt_module.some.decls_len);
}

fun decls_pending(s: *session.Session, a: *ast.Ast, text: str, ctx: *comptime.ComptimeCtx, sweep: lower_context.BindSweep, start: u32, len: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= a.decl_id_len) { ret true; }
        val did:      ast_id.DeclId       = a.decl_ids[pool_ix];
        val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(a, did);
        if (sel opt_decl.none) { ret true; }
        val d: *ast_decl.Decl = opt_decl.some;
        if (d.kind == ast_decl.DECL_KIND_COMPTIME_IF) {
            var b: u32 = 0;
            for (b < d.data.comptime_if.branches_len) {
                val branch_ix: u32 = d.data.comptime_if.branches_start + b;
                if (branch_ix::usize >= a.comptime_branch_len) { ret true; }
                val branch: *ast_decl.ComptimeBranch = ?a.comptime_branches[branch_ix];
                if (decls_pending(s, a, text, ctx, sweep, branch.body_start, branch.body_len)) { ret true; }
                b = b + 1;
            }
        }
        or ((d.kind == ast_decl.DECL_KIND_VAL || d.kind == ast_decl.DECL_KIND_VAR) && d.data.bind.init != ast_id.EXPR_NIL
            && resolve.declaration_testing(a, text, did) == (sweep == lower_context.SWEEP_TESTING)) {
            val named: res[intern.StrId, A.Error] = intern.intern_span(?s.interner, text, d.data.bind.name);
            if (sel named.err) { ret true; }
            val bound: opt[comptime.NamedConst] = comptime.lookup(ctx, named.ok);
            if (sel bound.none) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun lower_module_fail(lc: *lower_context.LowerContext, m: *me_ir.Module, f: fail.Fail) res[me_ir.Module, fail.Fail] {
    var result: fail.Fail = f;
    if (sel lc.status.kind.internal) { result = fail.phase_failure(lc.status); }
    lower_context.dnit_context(lc);
    me_ir.dnit(m);
    ret res[me_ir.Module, fail.Fail].err{result};
}

fun drain_instances(lc: *lower_context.LowerContext, s: *session.Session) err[fail.Fail] {
    for (lc.inst_drained < lc.inst_len) {
        val processed: u32              = lc.inst_drained;
        val decl_id:   ast_id.DeclId    = lc.insts[processed].decl;
        val origin:    session.ModuleId = lc.insts[processed].origin;
        val arg_len:   u32              = lc.insts[processed].arg_len;
        val name:      intern.StrId     = lc.insts[processed].name;
        val args:      *type.TypeId     = lc.insts[processed].args;

        val res_emit: err[fail.Fail] = emit_one_instance(lc, s, decl_id, origin, args, arg_len, name, processed);
        if (sel res_emit.err) { ret res_emit; }

        lc.inst_drained = lc.inst_drained + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_one_instance(lc: *lower_context.LowerContext, s: *session.Session,
    decl_id: ast_id.DeclId, origin: session.ModuleId,
    args: *type.TypeId, arg_len: u32, name: intern.StrId,
    current: u32) err[fail.Fail] {
    val acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: lower_context.ModuleScope = acquired.ok;

    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.a, decl_id);
    if (sel opt_decl.none) { ret err[fail.Fail].ok{}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret err[fail.Fail].ok{}; }
    val who_r: res[type.GenericOwner, fail.Fail] = sema_context.generic_owner_of_decl(s, sc.a, origin, decl_id);
    if (sel who_r.err) { ret err[fail.Fail].err{who_r.err}; }

    sc.subst        = args;
    sc.subst_len    = arg_len;
    sc.subst_owner  = who_r.ok;
    sc.inst_current = current;

    val mark_r: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }

    val res_lower: err[fail.Fail] = lower_decl.lower_instance(lc, decl_id, d, name);

    val leave: err[fail.Fail] = lower_context.scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret leave; }
    ret res_lower;
}

fun drain_value_instances(lc: *lower_context.LowerContext, s: *session.Session) err[fail.Fail] {
    for (lc.vinst_drained < lc.vinst_len || lc.inst_drained < lc.inst_len) {
        for (lc.vinst_drained < lc.vinst_len) {
            val processed: u32               = lc.vinst_drained;
            val decl_id:   ast_id.DeclId     = lc.vinsts[processed].decl;
            val origin:    session.ModuleId  = lc.vinsts[processed].origin;
            val val_len:   u32               = lc.vinsts[processed].val_len;
            val name:      intern.StrId      = lc.vinsts[processed].name;
            val vals:      *comptime.CTValue = lc.vinsts[processed].vals;
            val names:     *intern.StrId     = lc.vinsts[processed].names;

            val res_emit: err[fail.Fail] = emit_one_value_instance(lc, s, decl_id, origin, vals, names, val_len, name);
            if (sel res_emit.err) { ret res_emit; }

            lc.vinst_drained = lc.vinst_drained + 1;
        }

        val res_drain_types: err[fail.Fail] = drain_instances(lc, s);
        if (sel res_drain_types.err) { ret res_drain_types; }
    }
    ret err[fail.Fail].ok{};
}

fun emit_one_value_instance(lc: *lower_context.LowerContext, s: *session.Session,
    decl_id: ast_id.DeclId, origin: session.ModuleId,
    vals: *comptime.CTValue, names: *intern.StrId, val_len: u32,
    name: intern.StrId) err[fail.Fail] {
    val acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: lower_context.ModuleScope = acquired.ok;

    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.a, decl_id);
    if (sel opt_decl.none) { ret err[fail.Fail].err{fail.message("lower: value-instance origin declaration not found")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("lower: value-instance origin declaration is not a function")}; }

    val mark_r: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }
    val mark: lower_context.ScopeMark = mark_r.ok;

    val res_bound: err[fail.Fail] = lower_bound_value_instance(lc, decl_id, d, name, vals, names, val_len);

    val leave: err[fail.Fail] = lower_context.scope_leave(lc, mark);
    if (sel leave.err) { ret leave; }
    ret res_bound;
}

fun lower_bound_value_instance(lc: *lower_context.LowerContext, decl_id: ast_id.DeclId, d: *ast_decl.Decl,
    name: intern.StrId, vals: *comptime.CTValue,
    names: *intern.StrId, val_len: u32) err[fail.Fail] {
    val octx:   *comptime.ComptimeCtx              = lc.scope.ctx;
    val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(octx);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }
    val mark: comptime.FrameMark = mark_r.ok;

    var bound: err[fail.Fail] = err[fail.Fail].ok{};
    var i:     u32            = 0;
    for (i < val_len) {
        val res_bind: err[fail.Fail] = comptime.bind(octx, names[i], vals[i]);
        if (sel res_bind.err) {
            bound = res_bind;
            i     = val_len;
        }
        or { i = i + 1; }
    }
    var res_: err[fail.Fail] = bound;
    if (sel bound.ok) {
        res_ = lower_decl.lower_value_instance(lc, decl_id, d, name);
    }

    val res_close: err[fail.Fail] = comptime.frame_close(octx, mark);
    if (sel res_close.err) { ret res_close; }
    ret res_;
}

fun drain_pack_instances(lc: *lower_context.LowerContext, s: *session.Session) err[fail.Fail] {
    for (lc.pinst_drained < lc.pinst_len || lc.inst_drained < lc.inst_len || lc.vinst_drained < lc.vinst_len) {
        for (lc.pinst_drained < lc.pinst_len) {
            val processed: u32              = lc.pinst_drained;
            val decl_id:   ast_id.DeclId    = lc.pinsts[processed].decl;
            val origin:    session.ModuleId = lc.pinsts[processed].origin;
            val arg_len:   u32              = lc.pinsts[processed].arg_len;
            val type_len:  u32              = lc.pinsts[processed].type_len;
            val name:      intern.StrId     = lc.pinsts[processed].name;
            val args:      *type.TypeId     = lc.pinsts[processed].args;
            val types:     *type.TypeId     = lc.pinsts[processed].types;

            val res_emit: err[fail.Fail] = emit_one_pack_instance(lc, s, decl_id, origin, args, arg_len, types, type_len, name);
            if (sel res_emit.err) { ret res_emit; }

            lc.pinst_drained = lc.pinst_drained + 1;
        }

        val res_drain_types: err[fail.Fail] = drain_instances(lc, s);
        if (sel res_drain_types.err) { ret res_drain_types; }
        val res_drain_values: err[fail.Fail] = drain_value_instances(lc, s);
        if (sel res_drain_values.err) { ret res_drain_values; }
    }
    ret err[fail.Fail].ok{};
}

fun emit_one_pack_instance(lc: *lower_context.LowerContext, s: *session.Session,
    decl_id: ast_id.DeclId, origin: session.ModuleId,
    args: *type.TypeId, arg_len: u32,
    types: *type.TypeId, type_len: u32, name: intern.StrId) err[fail.Fail] {
    val acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: lower_context.ModuleScope = acquired.ok;

    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.a, decl_id);
    if (sel opt_decl.none) { ret err[fail.Fail].err{fail.message("lower: pack-instance origin declaration not found")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("lower: pack-instance origin declaration is not a function")}; }
    val who_r: res[type.GenericOwner, fail.Fail] = sema_context.generic_owner_of_decl(s, sc.a, origin, decl_id);
    if (sel who_r.err) { ret err[fail.Fail].err{who_r.err}; }

    sc.subst       = args;
    sc.subst_len   = arg_len;
    sc.subst_owner = who_r.ok;

    val mark_r: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }

    val res_lower: err[fail.Fail] = lower_decl.lower_pack_instance(lc, decl_id, d, name, types, type_len);

    val leave: err[fail.Fail] = lower_context.scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret leave; }
    ret res_lower;
}
