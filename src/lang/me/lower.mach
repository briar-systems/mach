pub fun lower_module(req: *lower_context.LowerRequest) res[me_ir.Module, fail.Fail] {
    if (req == nil) { ret res[me_ir.Module, fail.Fail].err{fail.message("lower: lower_module requires a lowering request")}; }
    val s: *session.Session = req.s;
    val a: *ast.Ast         = req.module.a;

    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(req.malloc, req.module.fqn);
    if (sel res_module.err) {
        ret res[me_ir.Module, fail.Fail].err{res_module.err};
    }
    var m: me_ir.Module = res_module.ok;

    var lc:       lower_context.LowerContext;
    val res_init: err[fail.Fail] = lower_context.init_context(?lc, req, ?m);
    if (sel res_init.err) {
        me_ir.dnit(?m);
        ret res[me_ir.Module, fail.Fail].err{res_init.err};
    }

    val opt_module: opt[*ast_module.Module] = ast.get_module(a, a.root_module);
    if (sel opt_module.none) {
        ret lower_module_fail(?lc, ?m, fail.message("lower: root_module is not set on this Ast"));
    }
    val mnode: *ast_module.Module = opt_module.some;

    var i: u32 = 0;
    for (i < mnode.decls_len) {
        val pool_ix: u32 = mnode.decls_start + i;
        if (pool_ix::usize >= a.decl_ids.len) {
            ret lower_module_fail(?lc, ?m, fail.message("lower: module decl index out of range"));
        }
        val did:      ast_id.DeclId  = a.decl_ids.data[pool_ix];
        val res_decl: err[fail.Fail] = lower_decl.lower_decl(?lc, did);
        if (sel res_decl.err) {
            val failure:     fail.Fail           = res_decl.err;
            val declaration: opt[*ast_decl.Decl] = ast.get_decl(a, did);
            if (!sel failure.reported) { ret lower_module_fail(?lc, ?m, failure); }
            if (sel declaration.none)  { ret lower_module_fail(?lc, ?m, failure); }
            val kind: ast_decl.DeclKind = declaration.some.kind;
            if (kind != ast_decl.DECL_KIND_VAL && kind != ast_decl.DECL_KIND_VAR) {
                ret lower_module_fail(?lc, ?m, failure);
            }
            if (sel lc.status.kind.accepted) { fail.reject(?lc.status); }
        }
        i = i + 1;
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    val res_emit: err[fail.Fail] = emit_instances(?lc, s);
    if (sel res_emit.err) {
        ret lower_module_fail(?lc, ?m, res_emit.err);
    }

    if (!sel lc.status.kind.accepted) { ret lower_module_fail(?lc, ?m, fail.phase_failure(lc.status)); }
    lower_context.dnit_context(?lc);
    ret res[me_ir.Module, fail.Fail].ok{m};
}

fun lower_module_fail(lc: *lower_context.LowerContext, m: *me_ir.Module, f: fail.Fail) res[me_ir.Module, fail.Fail] {
    var result: fail.Fail = f;
    if (sel lc.status.kind.internal) { result = fail.phase_failure(lc.status); }
    lower_context.dnit_context(lc);
    me_ir.dnit(m);
    ret res[me_ir.Module, fail.Fail].err{result};
}

# emits every instance sema found this object's code reaching, in the order sema found
# them: the module's normal object holds what its normal code reaches, its test object
# what any of its code reaches
fun emit_instances(lc: *lower_context.LowerContext, s: *session.Session) err[fail.Fail] {
    if (lc.instances == nil) { ret err[fail.Fail].ok{}; }
    val test_object: bool = lc.normal_object != nil;
    val n:           u32  = fe_sema.instance.count(lc.instances);
    var i:           u32  = 0;
    for (i < n) {
        val reach:  fe_sema.instance.Reach = fe_sema.instance.at(lc.instances, i).reach;
        var wanted: bool                   = (reach & fe_sema.instance.REACH_NORMAL) != 0;
        if (test_object && (reach & fe_sema.instance.REACH_TESTING) != 0) { wanted = true; }
        if (wanted) {
            val emitted: err[fail.Fail] = emit_instance(lc, s, i);
            if (sel emitted.err) { ret emitted; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_instance(lc: *lower_context.LowerContext, s: *session.Session, id: u32) err[fail.Fail] {
    val item:     *fe_sema.instance.Instance                = fe_sema.instance.at(lc.instances, id);
    val acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, item.origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    var sc: lower_context.ModuleScope = acquired.ok;

    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(sc.a, item.decl);
    if (sel opt_decl.none) { ret err[fail.Fail].err{fail.message("lower: instance origin declaration not found")}; }
    val d: *ast_decl.Decl = opt_decl.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("lower: instance origin declaration is not a function")}; }
    if (item.arg_len > 0) {
        val who_r: res[type.GenericOwner, fail.Fail] = fe_sema.generic_owner_of_decl(s, sc.a, item.origin, item.decl);
        if (sel who_r.err) { ret err[fail.Fail].err{who_r.err}; }
        sc.subst       = item.args;
        sc.subst_len   = item.arg_len;
        sc.subst_owner = who_r.ok;
    }
    sc.frame = item.frame;

    val name_r: res[intern.StrId, fail.Fail] = lower_context.instance_link_name(lc, item);
    if (sel name_r.err) { ret err[fail.Fail].err{name_r.err}; }

    val mark_r: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, sc);
    if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }

    var res_lower: err[fail.Fail] = err[fail.Fail].ok{};
    if (item.kind == fe_sema.instance.KIND_PACK) {
        res_lower = lower_decl.lower_pack_instance(lc, item.decl, d, name_r.ok, item.pack, item.pack_len);
    }
    or (item.kind == fe_sema.instance.KIND_VALUE) {
        res_lower = lower_bound_value_instance(lc, item.decl, d, name_r.ok, item.values, item.names, item.value_len);
    }
    or {
        res_lower = lower_decl.lower_instance(lc, item.decl, d, name_r.ok);
    }

    val leave: err[fail.Fail] = lower_context.scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret leave; }
    ret res_lower;
}

fun lower_bound_value_instance(lc: *lower_context.LowerContext, decl_id: ast_id.DeclId, d: *ast_decl.Decl,
    name: intern.StrId, vals: *comptime.CTValue,
    names: *intern.StrId, val_len: u32) err[fail.Fail] {
    val octx:   *comptime.ComptimeCtx              = lc.scope.ctx;
    val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(octx);
    if (sel mark_r.err) {
        ret err[fail.Fail].err{mark_r.err};
    }
    val mark: comptime.FrameMark = mark_r.ok;

    var bound: err[fail.Fail] = err[fail.Fail].ok{};
    var i:     u32            = 0;
    for (i < val_len) {
        val res_bind: err[fail.Fail] = comptime.bind(octx, names[i], vals[i]);
        if (sel res_bind.err) {
            bound = res_bind;
            i     = val_len;
        }
        or { i = i + 1; }
    }
    var res_: err[fail.Fail] = bound;
    if (sel bound.ok) {
        res_ = lower_decl.lower_value_instance(lc, decl_id, d, name);
    }

    val res_close: err[fail.Fail] = comptime.frame_close(octx, mark);
    if (sel res_close.err) { ret res_close; }
    ret res_;
}

# modules checked by the front end alone, then lowered in the order they were typed, each into a
# home of its own, and held to the checks a build runs on lowered code; it must not move once made
#[testing]
pub rec Lowered {
    c:       checked.Checked;
    homes:   [resolve.FIXTURE_MODULES]me_ir.ModuleHome;
    irs:     [resolve.FIXTURE_MODULES]me_ir.Module;
    homed:   [resolve.FIXTURE_MODULES]bool;
    lowered: [resolve.FIXTURE_MODULES]bool;
    count:   u32;
    # the standing of every module's lowering and its checks
    status: fail.PhaseStatus;
}

# the interface the module `mid` published, which is all an importer's lowering reads of it
#[testing]
fun lowered_interface(raw: ptr, mid: session.ModuleId) res[*fe_sema.interface.Interface, fail.Fail] {
    val c:     *checked.Checked = raw::*checked.Checked;
    val place: u32              = resolve.resolved_place(?c.r, mid);
    if (place >= c.count || !c.mods[place].typed)   { ret res[*fe_sema.interface.Interface, fail.Fail].err{fail.message("a lowered module reads one that is not typed")}; }
    if (!sel c.mods[place].sr.status.kind.accepted) { ret res[*fe_sema.interface.Interface, fail.Fail].err{fail.phase_failure(c.mods[place].sr.status)}; }
    ret res[*fe_sema.interface.Interface, fail.Fail].ok{?c.mods[place].sr.interface};
}

# lower the module typed at `place` and check it; a rejection is the module's and is kept in
# the standing, anything else is the fixture's
#[testing]
fun lower_one(l: *Lowered, place: u32) err[fail.Fail] {
    val c:      *checked.Checked = ?l.c;
    val mid:    session.ModuleId = c.r.order[place];
    val row:    fe_load.Row      = resolve.resolved_row(?c.r, mid);
    val opened: err[fail.Fail]   = me_ir.home_init(?l.homes[place], ?c.r.alloc);
    if (sel opened.err) { ret opened; }
    l.homed[place] = true;
    val scoped: res[*comptime.ComptimeCtx, fail.Fail] = checked.checked_scope(c, place);
    if (sel scoped.err) { ret err[fail.Fail].err{scoped.err}; }
    val req: res[lower_context.LowerRequest, fail.Fail] = lower_context.request(?c.r.s, ?c.r.target, ?l.homes[place].alloc, row.syntax, row.name, mid,
        ?c.mods[place].sr, ?c.r.results[place], scoped.ok, nil, false, true, true, ?c.r.s.diags,
        fe_sema.interface.Reader{ctx: c::ptr, read: lowered_interface});
    if (sel req.err) { ret err[fail.Fail].err{req.err}; }
    var request: lower_context.LowerRequest   = req.ok;
    val made:    res[me_ir.Module, fail.Fail] = lower_module(?request);
    if (sel made.err) {
        val failure: fail.Fail = made.err;
        if (!sel failure.reported) { ret err[fail.Fail].err{failure}; }
        fail.reject(?l.status);
        ret err[fail.Fail].ok{};
    }
    l.irs[place]         = made.ok;
    l.irs[place].backing = l.homes[place].backing;
    l.lowered[place]     = true;
    var scope:      check_scope.Scope = check_scope.init(?l.irs[place], ?c.r.target, ?c.r.s.interner, ?c.r.s.diags, ?c.r.alloc);
    val checked_ir: err[fail.Fail]    = check_oblivious.run(?scope);
    if (sel checked_ir.err) {
        val failure: fail.Fail = checked_ir.err;
        if (!sel failure.reported) { ret checked_ir; }
        fail.reject(?l.status);
    }
    ret err[fail.Fail].ok{};
}

# check and lower `src` into `l`, released with lowered_dnit also when this fails; a failure is
# the fixture's own, and the modules' verdict is in the standings and the diagnostics. modules
# the front end rejected are not lowered, as a build stops there
#[testing]
pub fun lowered_check(l: *Lowered, src: *resolve.Sources) err[fail.Fail] {
    l.count  = 0;
    l.status = fail.accepted();
    val front: err[fail.Fail] = checked.checked_check(?l.c, src);
    if (sel front.err)                   { ret front; }
    if (!checked.checked_accepted(?l.c)) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < l.c.count) {
        l.homed[i]   = false;
        l.lowered[i] = false;
        l.count      = i + 1;
        val lowered: err[fail.Fail] = lower_one(l, i);
        if (sel lowered.err) { ret lowered; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun lowered_dnit(l: *Lowered) {
    var i: u32 = 0;
    for (i < l.count) {
        if (l.homed[i]) { me_ir.home_dnit(?l.homes[i]); }
        i = i + 1;
    }
    checked.checked_dnit(?l.c);
}

# whether the front end, the lowering and its checks all accepted the modules
#[testing]
pub fun lowered_accepted(l: *Lowered) bool {
    ret checked.checked_accepted(?l.c) && sel l.status.kind.accepted;
}

# the lowered module named `fqn`, nil when it was not lowered
#[testing]
pub fun lowered_ir(l: *Lowered, fqn: str) *me_ir.Module {
    var i: u32 = 0;
    for (i < l.count) {
        if (l.lowered[i] && str_equals(intern.text(?l.c.r.s.interner, resolve.resolved_row(?l.c.r, l.c.r.order[i]).name), fqn)) { ret ?l.irs[i]; }
        i = i + 1;
    }
    ret nil;
}

# the errors the front end and the lowering reported over `src`, -1 when the check failed or a
# phase rejected the modules without one
#[testing]
pub fun lower_errors(src: *resolve.Sources) i32 {
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, src);
    fin { lowered_dnit(?l); }
    if (sel made.err) { ret -1; }
    val errors: usize = diagnostic.error_count(?l.c.r.s.diags);
    if (errors == 0 && !lowered_accepted(?l)) { ret -1; }
    ret errors::i32;
}

# zero when the lowering, after the front end accepted `src`, rejects it with an error that says
# `needle`; the diagnostics are shown when it does not
#[testing]
pub fun lower_refuses(src: *resolve.Sources, needle: str) i32 {
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, src);
    fin { lowered_dnit(?l); }
    if (sel made.err)                                                                                                   { ret 1; }
    if (checked.checked_accepted(?l.c) && !sel l.status.kind.accepted && diagnostic.error_says(?l.c.r.s.diags, needle)) { ret 0; }
    diagnostic.show(?l.c.r.s.diags);
    ret 1;
}

# the one-module forms, over `t.main`
#[testing]
pub fun lower_clean(text: str) bool {
    var src: resolve.Sources = resolve.sources("t.main", text);
    ret lower_errors(?src) == 0;
}

#[testing]
pub fun lower_rejects_with(text: str, needle: str) i32 {
    var src: resolve.Sources = resolve.sources("t.main", text);
    ret lower_refuses(?src, needle);
}

test lowered__a_checked_module_lowers_to_its_functions {
    var src: resolve.Sources = resolve.sources("t.main", "use t.lib;\nfun twice(x: i32) i32 { ret lib.add(x, x); }\n");
    resolve.sources_add(?src, "t.lib", "pub fun add(a: i32, b: i32) i32 { ret a + b; }\n");
    var l:    Lowered;
    val made: err[fail.Fail] = lowered_check(?l, ?src);
    fin { lowered_dnit(?l); }
    if (sel made.err)          { ret 1; }
    if (!lowered_accepted(?l)) { ret 2; }
    val main: *me_ir.Module = lowered_ir(?l, "t.main");
    val lib:  *me_ir.Module = lowered_ir(?l, "t.lib");
    if (main == nil || lib == nil)                       { ret 3; }
    if (main.function_len == 0 || lib.function_len == 0) { ret 4; }
    ret 0;
}

test lowered__a_refused_lowering_is_the_module_s {
    if (!lower_clean("fun main() i32 { val s: *u8 = \"\\x08\"; ret 0; }\n"))                                                              { ret 1; }
    if (lower_rejects_with("fun main() i32 { val s: *u8 = \"\\b\"; ret 0; }\n", "lower: unknown escape sequence in string literal") != 0) { ret 2; }
    ret 0;
}

# lowering reads the constants typing bound, its own module's and an import's alike
test lowered__reads_the_constants_typing_bound {
    var src: resolve.Sources = resolve.sources("t.main", "use t.lib;\nrec Q { a: u64; b: u32; }\nval OWN: u64 = $size_of(Q);\nfun main() u64 { ret OWN + lib.SIZE; }\n");
    resolve.sources_add(?src, "t.lib", "rec P { a: u64; b: u64; }\npub val SIZE: u64 = $size_of(P);\npub fun size() u64 { ret SIZE; }\n");
    if (lower_errors(?src) != 0) { ret 1; }
    ret 0;
}
