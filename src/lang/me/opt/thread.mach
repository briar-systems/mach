# jump threading over a boolean phi
#
# a block that holds nothing but a phi of a condition and a conditional branch
# on it is the join the lowering emits for `a && b` and `a || b`: each
# predecessor arrives knowing the outcome, either as a constant or as the
# compare it just computed, and then re-tests it. every predecessor that
# reaches the join with an unconditional branch is redirected to the branch's
# target directly, or branches on its own compare, and the join keeps only the
# predecessors that could not be threaded.

use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mach.lang.me.analysis;
use me_ir:          mach.lang.me.ir;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.value;
use mach.lang.me.pass;
use mach.lang.wide;

# the pass the pipeline schedules
pub val PASS: pass.Pass = pass.Pass{run: nil, applies: applies, preserves: analysis.NONE, visit: thread_function, skips: pass.SKIP_EXTERN, eligible: nil, rounds: 1};

# a target that keeps structured control flow keeps every branch where it is
fun applies(ctx: *pass.Context) bool {
    ret !ctx.target.model.structured_control_flow;
}

fun thread_function(request: *pass.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:       *me_ir.Module   = request.module;
    val fn:      *me_ir.Function = request.body;
    var changed: bool            = false;
    var bi:      u32             = 0;
    for (bi < fn.block_count) {
        val r: res[bool, fail.Fail] = thread_block(m, fn, bi::ir_id.BlockId);
        if (sel r.err) { ret r; }
        if (r.ok)      { changed = true; }
        bi = bi + 1;
    }
    if (changed) {
        val rp: err[fail.Fail] = me_ir.preds_rebuild(m, fn);
        if (sel rp.err) { ret res[bool, fail.Fail].err{rp.err}; }
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun terminator_of(fn: *me_ir.Function, bid: ir_id.BlockId) opt[*ir_instruction.Instruction] {
    val blk: *me_ir.Block = ?fn.blocks[bid::u32];
    if (ir_id.instruction_is_nil(blk.terminator)) { ret opt[*ir_instruction.Instruction].none{}; }
    ret me_ir.instruction_get(fn, blk.terminator);
}

fun thread_block(m: *me_ir.Module, fn: *me_ir.Function, bid: ir_id.BlockId) res[bool, fail.Fail] {
    val blk: *me_ir.Block = ?fn.blocks[bid::u32];
    if (blk.instr_count != 0 || blk.phi_count != 1) { ret res[bool, fail.Fail].ok{false}; }

    val topt: opt[*ir_instruction.Instruction] = terminator_of(fn, bid);
    if (!sel topt.some) { ret res[bool, fail.Fail].ok{false}; }
    val term: *ir_instruction.Instruction = topt.some;
    if (term.kind != ir_instruction.OP_CBR || term.operand_count != 3) { ret res[bool, fail.Fail].ok{false}; }

    val cond: value.Value = term.operands[0];
    if (cond.kind != value.VAL_INSTR || !ir_id.instruction_same(cond.data.instr, blk.phis[0])) { ret res[bool, fail.Fail].ok{false}; }
    val popt: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, blk.phis[0]);
    if (!sel popt.some) { ret res[bool, fail.Fail].ok{false}; }
    val phi: *ir_instruction.Instruction = popt.some;

    val on_true:  ir_id.BlockId = me_ir.block_target(term.operands[1]);
    val on_false: ir_id.BlockId = me_ir.block_target(term.operands[2]);
    if (ir_id.block_same(on_true, bid) || ir_id.block_same(on_false, bid) || ir_id.block_same(on_true, on_false)) { ret res[bool, fail.Fail].ok{false}; }

    var changed: bool = false;
    var o:       u32  = 0;
    for (o + 1 < phi.operand_count) {
        val pred: ir_id.BlockId = me_ir.block_target(phi.operands[o]);
        val v:    value.Value   = phi.operands[o + 1];
        if (ir_id.block_same(pred, bid)) {
            o = o + 2;
            cnt;
        }
        val ptopt: opt[*ir_instruction.Instruction] = terminator_of(fn, pred);
        if (!sel ptopt.some) {
            o = o + 2;
            cnt;
        }
        val pterm: *ir_instruction.Instruction = ptopt.some;

        # the arm of a conditional predecessor that enters the join knows the
        # outcome when the incoming is a constant or the predecessor's own
        # condition; an unconditional predecessor knows it for any value
        var to_true:  bool = false;
        var to_false: bool = false;
        var arm:      u32  = 0;
        if (pterm.kind == ir_instruction.OP_BR && pterm.operand_count == 1 && ir_id.block_same(me_ir.block_target(pterm.operands[0]), bid)) {
            if (v.kind == value.VAL_CONST_INT) {
                if (!wide.is_zero(value.int_of(?v))) { to_true = true; }
                or                                   { to_false = true; }
            }
            or (v.kind == value.VAL_INSTR || v.kind == value.VAL_PARAM) {
                to_true  = true;
                to_false = true;
            }
        }
        or (pterm.kind == ir_instruction.OP_CBR && pterm.operand_count == 3) {
            val t1: bool = ir_id.block_same(me_ir.block_target(pterm.operands[1]), bid);
            val t2: bool = ir_id.block_same(me_ir.block_target(pterm.operands[2]), bid);
            if (t1 != t2) {
                if (t1) { arm = 1; }
                or      { arm = 2; }
                var known: opt[bool] = opt[bool].none{};
                if (v.kind == value.VAL_CONST_INT) { known = opt[bool].some{!wide.is_zero(value.int_of(?v))}; }
                or (v.kind == value.VAL_INSTR && pterm.operands[0].kind == value.VAL_INSTR
                    && ir_id.instruction_same(v.data.instr, pterm.operands[0].data.instr)) {
                    known = opt[bool].some{arm == 1};
                }
                if (sel known.some) {
                    if (known.some) { to_true = true; }
                    or              { to_false = true; }
                }
            }
        }
        if (!to_true && !to_false) {
            o = o + 2;
            cnt;
        }

        if (to_true) {
            val r: err[fail.Fail] = extend_phis(m, fn, on_true, bid, pred, blk.phis[0], v);
            if (sel r.err) { ret res[bool, fail.Fail].err{r.err}; }
        }
        if (to_false) {
            val r: err[fail.Fail] = extend_phis(m, fn, on_false, bid, pred, blk.phis[0], v);
            if (sel r.err) { ret res[bool, fail.Fail].err{r.err}; }
        }

        if (to_true && to_false) {
            val ra: res[me_ir.OperandArray, fail.Fail] = me_ir.operands_alloc(m, 3);
            if (sel ra.err) { ret res[bool, fail.Fail].err{ra.err}; }
            val arr: me_ir.OperandArray = ra.ok;
            arr.ops[0] = v;
            arr.ops[1] = term.operands[1];
            arr.ops[2] = term.operands[2];
            pterm.kind = ir_instruction.OP_CBR;
            me_ir.instr_replace_operands(m, pterm, arr);
        }
        or {
            var dest: ir_id.BlockId = on_false;
            if (to_true) { dest = on_true; }
            me_ir.block_target_set(?pterm.operands[arm], dest);
        }

        me_ir.phi_incoming_del_at(phi, o);
        changed = true;
    }
    ret res[bool, fail.Fail].ok{changed};
}

# every phi in `target` that took a value from `join` also takes one from
# `pred` now: the same value, or the threaded predecessor's own incoming when
# the value was the join's condition phi
fun extend_phis(m: *me_ir.Module, fn: *me_ir.Function, target: ir_id.BlockId, join: ir_id.BlockId, pred: ir_id.BlockId, cond: ir_id.InstructionId, incoming: value.Value) err[fail.Fail] {
    val tb: *me_ir.Block = ?fn.blocks[target::u32];
    var pi: u32          = 0;
    for (pi < tb.phi_count) {
        val popt: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, tb.phis[pi]);
        if (sel popt.some) {
            val phi: *ir_instruction.Instruction = popt.some;
            var w:   value.Value;
            var has: bool                        = false;
            var o:   u32                         = 0;
            for (o + 1 < phi.operand_count) {
                if (ir_id.block_same(me_ir.block_target(phi.operands[o]), join)) {
                    w   = phi.operands[o + 1];
                    has = true;
                }
                o = o + 2;
            }
            if (has) {
                if (w.kind == value.VAL_INSTR && ir_id.instruction_same(w.data.instr, cond)) {
                    w = value.retype(incoming, w.ty);
                }
                val r: err[fail.Fail] = me_ir.phi_append_incoming(m, phi, pred, w);
                if (sel r.err) { ret r; }
            }
        }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

use mach.lang.intern;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.equal;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.target.resolved;
use std.allocator.page;
use std.types.size.usize;

# `p0 < 10 && p1 < 20` as the lowering emits it: the entry branches to the
# right-hand test or straight to the join with false, the right-hand test
# jumps to the join with its compare, and the join branches on the phi of the
# two to blocks returning 1 and 2
#[testing]
fun probe_build(a: *me_testing.Attempt, m: *me_ir.Module) i32 {
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 1; }
    val i64t: ir_type.IrTypeId    = ri.ok;
    val rf:   res[u32, fail.Fail] = me_ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ret 2; }
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[rf.ok]);
    var blocks: [5]ir_id.BlockId;
    var k:      u32 = 0;
    for (k < 5) {
        val made: res[ir_id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel made.err) { ret 3; }
        blocks[k] = made.ok;
        k         = k + 1;
    }
    val entry: ir_id.BlockId = blocks[0];
    val rhs:   ir_id.BlockId = blocks[1];
    val join:  ir_id.BlockId = blocks[2];
    val yes:   ir_id.BlockId = blocks[3];
    val no:    ir_id.BlockId = blocks[4];

    builder.set_block(?b, entry);
    val left: value.Value = builder.lt_s(?b, value.param(0, i64t), value.const_int(10, i64t));
    builder.cbr(?b, left, rhs, join);
    builder.set_block(?b, rhs);
    val right: value.Value = builder.lt_s(?b, value.param(1, i64t), value.const_int(20, i64t));
    builder.br(?b, join);
    builder.set_block(?b, join);
    val both: value.Value = builder.phi(?b, left.ty);
    builder.incoming(?b, both, entry, value.const_int(0, left.ty));
    builder.incoming(?b, both, rhs, right);
    builder.cbr(?b, both, yes, no);
    val built: res[value.Value, fail.Fail] = builder.done(?b, both);
    if (sel built.err) { ret 4; }
    builder.set_block(?b, yes);
    val ret_yes: err[fail.Fail] = builder.emit_ret(?b, value.const_int(1, i64t));
    if (sel ret_yes.err) { ret 5; }
    builder.set_block(?b, no);
    val ret_no: err[fail.Fail] = builder.emit_ret(?b, value.const_int(2, i64t));
    if (sel ret_no.err) { ret 5; }
    ret 0;
}

# the block a terminator's operand `o` targets
#[testing]
fun t_target(fn: *me_ir.Function, bid: ir_id.BlockId, o: u32) ir_id.BlockId {
    ret me_ir.block_target(fn.instrs[fn.blocks[bid::u32].terminator::u32].operands[o]);
}

test run__threads_each_predecessor_that_knows_the_outcome {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val rm: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: me_ir.Module = rm.ok;
    fin { me_ir.dnit(?m); }
    if (probe_build(nil, ?m) != 0) { ret 2; }
    var tgt: resolved.Target      = resolved.described_named("x86_64");
    val ran: res[bool, fail.Fail] = pass.run_alone(?PASS, ?m, ?tgt);
    if (sel ran.err)                     { ret 3; }
    if (!ran.ok)                         { ret 4; }
    if (!me_testing.verifies(?m, false)) { ret 5; }

    val fn:   *me_ir.Function = ?m.functions[0];
    val join: ir_id.BlockId   = ir_id.block(2);
    val yes:  ir_id.BlockId   = ir_id.block(3);
    val no:   ir_id.BlockId   = ir_id.block(4);
    # the entry knows the outcome is false on its edge to the join, so that
    # edge goes to the false block, and its other edge still tests the right
    val entry_term: *ir_instruction.Instruction = ?fn.instrs[fn.blocks[0].terminator::u32];
    if (entry_term.kind != ir_instruction.OP_CBR)                           { ret 6; }
    if (!ir_id.block_same(t_target(fn, ir_id.block(0), 1), ir_id.block(1))) { ret 7; }
    if (!ir_id.block_same(t_target(fn, ir_id.block(0), 2), no))             { ret 8; }
    # the right-hand test branches on its own compare
    val rhs_term: *ir_instruction.Instruction = ?fn.instrs[fn.blocks[1].terminator::u32];
    if (rhs_term.kind != ir_instruction.OP_CBR)                  { ret 9; }
    if (!ir_id.block_same(t_target(fn, ir_id.block(1), 1), yes)) { ret 10; }
    if (!ir_id.block_same(t_target(fn, ir_id.block(1), 2), no))  { ret 11; }
    if (rhs_term.operands[0].kind != value.VAL_INSTR)            { ret 12; }
    # and the join keeps no predecessor
    val phi: *ir_instruction.Instruction = ?fn.instrs[fn.blocks[join::u32].phis[0]::u32];
    if (phi.operand_count != 0) { ret 13; }
    ret 0;
}

test run__a_join_with_an_instruction_beside_its_phi_is_left {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val rm: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: me_ir.Module = rm.ok;
    fin { me_ir.dnit(?m); }
    if (probe_build(nil, ?m) != 0) { ret 2; }
    # an add in the join means the block does more than re-test the condition
    val fn: *me_ir.Function = ?m.functions[0];
    var b:  builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    builder.at(?b, ir_id.block(2), 0);
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 3; }
    val added: res[value.Value, fail.Fail] = builder.emit_add(?b, value.param(0, ri.ok), value.param(1, ri.ok));
    if (sel added.err) { ret 3; }
    var tgt: resolved.Target      = resolved.described_named("x86_64");
    val ran: res[bool, fail.Fail] = pass.run_alone(?PASS, ?m, ?tgt);
    if (sel ran.err) { ret 4; }
    if (ran.ok)      { ret 5; }
    ret 0;
}

#[testing]
fun probe_transform(a: *me_testing.Attempt, m: *me_ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    var ctx: pass.Context         = pass.context(m, a.target, workspace);
    val r:   res[bool, fail.Fail] = pass.run(?PASS, ?ctx);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# a refusal leaves the input, or some predecessors threaded: each takes the
# edge it now knows, and only the predecessor lists, rebuilt last, are stale
#[testing]
fun probe_contract(a: *me_testing.Attempt, m: *me_ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    val rebuilt: err[fail.Fail] = me_ir.preds_rebuild(m, ?m.functions[0]);
    ret !sel rebuilt.err && me_testing.verifies(m, false);
}

test pass__refusal_at_every_ordinal_leaves_the_input_or_a_partial_threading {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var tgt: resolved.Target    = resolved.described_named("x86_64");
    var a:   me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: ?tgt, control: nil, context: nil};
    var control: me_ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { me_ir.dnit(?control); }
    ret me_testing.walk(?a);
}
