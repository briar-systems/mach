# promotion of memory to registers. a scalar local whose address is only
# loaded from and stored to becomes ssa values: a phi where its stores meet,
# at the dominance frontiers of the blocks that store it, and each load the
# value that reaches it. unreachable blocks are pruned first, so every block
# has a dominator. an aggregate, a local whose address escapes and one an
# inline asm binds stay in memory. the debug variable on a promoted local
# follows its values, a phi taking a binding of its own
use mach.lang.fail;
use std.allocator.page;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.intern;
use mach.lang.me.analysis;
use mach.lang.me.analysis.dominance;
use me_ir: mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.equal;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.reachability;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.ir.verify;
use mach.lang.me.pass;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.target.resolved;
use mach.lang.type;

rec State {
    alloc:       *A.Allocator;
    m:           *me_ir.Module;
    fn:          *me_ir.Function;
    block_count: u32;

    # the dominator tree with its frontiers, the analysis cache's
    dom: *dominance.Dominance;

    pool_len:    u32;
    instr_block: *ir_id.BlockId;
    alloca_of:   *u32;

    cand_cap:     u32;
    alloca_ids:   *ir_id.InstructionId;
    alloca_ty:    *ir_type.IrTypeId;
    alloca_count: u32;

    store_start:  *u32;
    store_len:    *u32;
    store_blocks: *ir_id.BlockId;
    store_total:  u32;

    phi_alloca:     *ir_id.InstructionId;
    phi_alloca_cap: u32;
}

# a run that owns its workspace
pub fun run(m: *me_ir.Module) res[bool, fail.Fail] {
    var workspace:   scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace, m.backing);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    var ctx: pass.Context = pass.context(m, nil, ?workspace);
    ret pass.run(?PASS, ?ctx);
}

# the pass the pipeline schedules
pub val PASS: pass.Pass = pass.Pass{run: nil, applies: nil, preserves: analysis.NONE, visit: promote_function, skips: pass.SKIP_EXTERN | pass.SKIP_VOLATILE, eligible: nil, rounds: 1};

fun promote_function(request: *pass.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:      *me_ir.Module        = request.module;
    val fn:     *me_ir.Function      = request.body;
    val pruned: res[bool, fail.Fail] = reachability.prune(m, fn, alloc);
    if (sel pruned.err) { ret pruned; }
    if (pruned.ok)      { analysis.del(request.analyses, m, fn); }
    var st: State;
    state_init(?st, m, fn, alloc);
    fin { state_dnit(?st); }

    if (fn.block_count == 0) { ret res[bool, fail.Fail].ok{false}; }

    val res_collect: err[fail.Fail] = collect_promotable(?st);
    if (sel res_collect.err)  { ret res[bool, fail.Fail].err{res_collect.err}; }
    if (st.alloca_count == 0) { ret pruned; }

    val res_phi: err[fail.Fail] = phi_table_init(?st);
    if (sel res_phi.err) { ret res[bool, fail.Fail].err{res_phi.err}; }

    val res_dom: res[*dominance.Dominance, fail.Fail] = analysis.frontiers_of(request.analyses, m, fn);
    if (sel res_dom.err) { ret res[bool, fail.Fail].err{res_dom.err}; }
    st.dom = res_dom.ok;

    val res_insert: err[fail.Fail] = insert_phis(?st);
    if (sel res_insert.err) { ret res[bool, fail.Fail].err{res_insert.err}; }

    val res_rename: err[fail.Fail] = rename(?st);
    if (sel res_rename.err) { ret res[bool, fail.Fail].err{res_rename.err}; }

    val res_births: err[fail.Fail] = emit_phi_dbg_births(?st);
    if (sel res_births.err) { ret res[bool, fail.Fail].err{res_births.err}; }

    ret res[bool, fail.Fail].ok{true};
}

fun state_init(st: *State, m: *me_ir.Module, fn: *me_ir.Function, alloc: *A.Allocator) {
    st.alloc       = alloc;
    st.m           = m;
    st.fn          = fn;
    st.block_count = fn.block_count;

    st.dom = nil;

    st.pool_len    = 0;
    st.instr_block = nil;
    st.alloca_of   = nil;

    st.cand_cap     = 0;
    st.alloca_ids   = nil;
    st.alloca_ty    = nil;
    st.alloca_count = 0;

    st.store_start  = nil;
    st.store_len    = nil;
    st.store_blocks = nil;
    st.store_total  = 0;

    st.phi_alloca     = nil;
    st.phi_alloca_cap = 0;
}

fun state_dnit(st: *State) {
    if (st.instr_block != nil)  { A.deallocate[ir_id.BlockId](st.alloc, st.instr_block, st.pool_len::usize); }
    if (st.alloca_of != nil)    { A.deallocate[u32](st.alloc, st.alloca_of, st.pool_len::usize); }
    if (st.alloca_ids != nil)   { A.deallocate[ir_id.InstructionId](st.alloc, st.alloca_ids, st.cand_cap::usize); }
    if (st.alloca_ty != nil)    { A.deallocate[ir_type.IrTypeId](st.alloc, st.alloca_ty, st.cand_cap::usize); }
    if (st.store_start != nil)  { A.deallocate[u32](st.alloc, st.store_start, st.alloca_count::usize); }
    if (st.store_len != nil)    { A.deallocate[u32](st.alloc, st.store_len, st.alloca_count::usize); }
    if (st.store_blocks != nil) { A.deallocate[ir_id.BlockId](st.alloc, st.store_blocks, st.store_total::usize); }
    if (st.phi_alloca != nil)   { A.deallocate[ir_id.InstructionId](st.alloc, st.phi_alloca, st.phi_alloca_cap::usize); }
}

fun phi_table_init(st: *State) err[fail.Fail] {
    val phi_cap: u32 = st.fn.instr_len + st.block_count * st.alloca_count;

    val res_phi: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](st.alloc, phi_cap::usize);
    if (sel res_phi.err) {
        ret err[fail.Fail].err{fail.refused(res_phi.err)};
    }
    st.phi_alloca     = res_phi.ok;
    st.phi_alloca_cap = phi_cap;

    var i: u32 = 0;
    for (i < phi_cap) {
        st.phi_alloca[i] = ir_id.INSTR_NIL;
        i                = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun collect_promotable(st: *State) err[fail.Fail] {
    val fn:   *me_ir.Function = st.fn;
    val ilen: u32             = fn.instr_len;
    if (ilen == 0) { ret err[fail.Fail].ok{}; }
    st.pool_len = ilen;

    val res_alloca_ids: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](st.alloc, ilen::usize);
    if (sel res_alloca_ids.err) {
        ret err[fail.Fail].err{fail.refused(res_alloca_ids.err)};
    }
    st.alloca_ids = res_alloca_ids.ok;
    # the capacity is recorded with the first array it sizes, so a refusal of
    # the second releases the first at its true extent
    st.cand_cap = ilen;

    val res_alloca_ty: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](st.alloc, ilen::usize);
    if (sel res_alloca_ty.err) {
        ret err[fail.Fail].err{fail.refused(res_alloca_ty.err)};
    }
    st.alloca_ty = res_alloca_ty.ok;

    val res_instr_block: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](st.alloc, ilen::usize);
    if (sel res_instr_block.err) {
        ret err[fail.Fail].err{fail.refused(res_instr_block.err)};
    }
    st.instr_block = res_instr_block.ok;

    val res_alloca_of: res[*u32, A.Error] = A.allocate[u32](st.alloc, ilen::usize);
    if (sel res_alloca_of.err) {
        ret err[fail.Fail].err{fail.refused(res_alloca_of.err)};
    }
    st.alloca_of = res_alloca_of.ok;

    var i: u32 = 0;
    for (i < ilen) {
        st.alloca_of[i] = ir_id.NONE;
        i               = i + 1;
    }
    me_ir.placement_fill(fn, st.instr_block, nil, ilen);

    var ii: u32 = 0;
    for (ii < ilen) {
        if (fn.instrs[ii].kind == ir_instruction.OP_ALLOCA && !ir_id.block_is_nil(st.instr_block[ii])) {
            st.alloca_of[ii]               = st.alloca_count;
            st.alloca_ids[st.alloca_count] = ii::ir_id.InstructionId;
            st.alloca_ty[st.alloca_count]  = ir_type.IRT_NIL;
            st.alloca_count                = st.alloca_count + 1;
        }
        ii = ii + 1;
    }
    if (st.alloca_count == 0) { ret err[fail.Fail].ok{}; }

    val cand_n:  u32   = st.alloca_count;
    var escaped: *bool = nil;
    var loaded:  *bool = nil;
    fin {
        if (escaped != nil) { A.deallocate[bool](st.alloc, escaped, cand_n::usize); }
        if (loaded != nil)  { A.deallocate[bool](st.alloc, loaded, cand_n::usize); }
    }
    val res_escaped: res[*bool, A.Error] = A.allocate[bool](st.alloc, cand_n::usize);
    if (sel res_escaped.err) { ret err[fail.Fail].err{fail.refused(res_escaped.err)}; }
    escaped = res_escaped.ok;
    val res_loaded: res[*bool, A.Error] = A.allocate[bool](st.alloc, cand_n::usize);
    if (sel res_loaded.err) { ret err[fail.Fail].err{fail.refused(res_loaded.err)}; }
    loaded = res_loaded.ok;

    var e: u32 = 0;
    for (e < cand_n) {
        escaped[e] = false;
        loaded[e]  = false;
        e          = e + 1;
    }

    classify_escapes(st, escaped, loaded);
    compact_promotable(st, escaped, loaded);
    if (st.alloca_count == 0) { ret err[fail.Fail].ok{}; }

    ret collect_store_blocks(st);
}

fun classify_escapes(st: *State, escaped: *bool, loaded: *bool) {
    val fn: *me_ir.Function = st.fn;
    var c:  u32             = 0;
    for (c < st.pool_len) {
        if (!ir_id.block_is_nil(st.instr_block[c])) {
            val inst: *ir_instruction.Instruction = ?fn.instrs[c];
            if (inst.kind == ir_instruction.OP_ASM) {
                mark_asm_binds_escaped(st, c::ir_id.InstructionId, escaped);
            }
            if (inst.kind != ir_instruction.OP_DBG_VALUE) {
                var o: u32 = 0;
                for (o < inst.operand_count) {
                    val op: value.Value = inst.operands[o];
                    if (op.kind == value.VAL_INSTR && op.data.instr::u32 < st.pool_len) {
                        val ai: u32 = st.alloca_of[op.data.instr::u32];
                        if (ai != ir_id.NONE) {
                            val ok_load:  bool = inst.kind == ir_instruction.OP_LOAD && o == 0;
                            val ok_store: bool = inst.kind == ir_instruction.OP_STORE && o == 1;
                            if (ok_load == false && ok_store == false) {
                                escaped[ai] = true;
                            }
                            or {
                                if (ok_load) { loaded[ai] = true; }
                                if (ir_type.is_nil(st.alloca_ty[ai])) {
                                    if (ok_load) { st.alloca_ty[ai] = inst.ty; }
                                    or           { st.alloca_ty[ai] = inst.operands[0].ty; }
                                }
                            }
                        }
                    }
                    o = o + 1;
                }
            }
        }
        c = c + 1;
    }
}

fun compact_promotable(st: *State, escaped: *bool, loaded: *bool) {
    val cand_n: u32 = st.alloca_count;
    var w:      u32 = 0;
    var r:      u32 = 0;
    for (r < cand_n) {
        val aid:      ir_id.InstructionId = st.alloca_ids[r];
        val agg_read: bool                = loaded[r] && ir_type.is_aggregate(?st.m.types, st.alloca_ty[r]);
        if (escaped[r] == false && agg_read == false) {
            st.alloca_ids[w]       = aid;
            st.alloca_ty[w]        = st.alloca_ty[r];
            st.alloca_of[aid::u32] = w;
            w                      = w + 1;
        }
        or {
            st.alloca_of[aid::u32] = ir_id.NONE;
        }
        r = r + 1;
    }
    st.alloca_count = w;
}

fun mark_asm_binds_escaped(st: *State, asm_id: ir_id.InstructionId, escaped: *bool) {
    var key:     ir_id.InstructionId = asm_id;
    val res_asm: opt[*me_ir.IrAsm]   = map.get[ir_id.InstructionId, me_ir.IrAsm](?st.fn.asm_blocks, ?key);
    if (sel res_asm.none) { ret; }
    val payload: *me_ir.IrAsm = res_asm.some;
    var b:       u32          = 0;
    for (b < payload.bind_count) {
        val bid: ir_id.InstructionId = payload.binds[b].instr;
        if (bid::u32 < st.pool_len && st.alloca_of[bid::u32] != ir_id.NONE) {
            escaped[st.alloca_of[bid::u32]] = true;
        }
        b = b + 1;
    }
}

fun collect_store_blocks(st: *State) err[fail.Fail] {
    val na: u32 = st.alloca_count;

    val res_start: res[*u32, A.Error] = A.allocate[u32](st.alloc, na::usize);
    if (sel res_start.err) { ret err[fail.Fail].err{fail.refused(res_start.err)}; }
    st.store_start = res_start.ok;

    val res_len: res[*u32, A.Error] = A.allocate[u32](st.alloc, na::usize);
    if (sel res_len.err) { ret err[fail.Fail].err{fail.refused(res_len.err)}; }
    st.store_len = res_len.ok;

    var a: u32 = 0;
    for (a < na) {
        st.store_len[a]   = 0;
        st.store_start[a] = 0;
        a                 = a + 1;
    }

    var i: u32 = 0;
    for (i < st.pool_len) {
        val ai: u32 = store_alloca_index(st, i);
        if (ai != ir_id.NONE) { st.store_len[ai] = st.store_len[ai] + 1; }
        i = i + 1;
    }

    var total: u32 = 0;
    var p:     u32 = 0;
    for (p < na) {
        st.store_start[p] = total;
        total             = total + st.store_len[p];
        p                 = p + 1;
    }
    var alloc_n: u32 = total;
    if (alloc_n == 0) { alloc_n = 1; }
    st.store_total = alloc_n;

    val res_blocks: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](st.alloc, alloc_n::usize);
    if (sel res_blocks.err) { ret err[fail.Fail].err{fail.refused(res_blocks.err)}; }
    st.store_blocks = res_blocks.ok;

    var f: u32 = 0;
    for (f < na) {
        st.store_len[f] = 0;
        f               = f + 1;
    }
    var j: u32 = 0;
    for (j < st.pool_len) {
        val ai: u32 = store_alloca_index(st, j);
        if (ai != ir_id.NONE) {
            st.store_blocks[st.store_start[ai] + st.store_len[ai]] = st.instr_block[j];
            st.store_len[ai]                                       = st.store_len[ai] + 1;
        }
        j = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun store_alloca_index(st: *State, i: u32) u32 {
    if (ir_id.block_is_nil(st.instr_block[i])) { ret ir_id.NONE; }
    val inst: *ir_instruction.Instruction = ?st.fn.instrs[i];
    if (inst.kind != ir_instruction.OP_STORE) { ret ir_id.NONE; }
    if (inst.operand_count < 2)               { ret ir_id.NONE; }
    val ptr: value.Value = inst.operands[1];
    if (ptr.kind != value.VAL_INSTR)        { ret ir_id.NONE; }
    if (ptr.data.instr::u32 >= st.pool_len) { ret ir_id.NONE; }
    ret st.alloca_of[ptr.data.instr::u32];
}

fun block_successors(st: *State, bid: ir_id.BlockId, out0: *ir_id.BlockId, out1: *ir_id.BlockId) u32 {
    ret me_ir.block_successors(st.fn, ?st.fn.blocks[bid::u32], out0, out1);
}

fun insert_phis(st: *State) err[fail.Fail] {
    val n:       u32            = st.block_count;
    var has_phi: *bool          = nil;
    var on_work: *bool          = nil;
    var work:    *ir_id.BlockId = nil;
    fin {
        if (has_phi != nil) { A.deallocate[bool](st.alloc, has_phi, n::usize); }
        if (on_work != nil) { A.deallocate[bool](st.alloc, on_work, n::usize); }
        if (work != nil)    { A.deallocate[ir_id.BlockId](st.alloc, work, n::usize); }
    }
    val res_has_phi: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel res_has_phi.err) { ret err[fail.Fail].err{fail.refused(res_has_phi.err)}; }
    has_phi = res_has_phi.ok;
    val res_on_work: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel res_on_work.err) { ret err[fail.Fail].err{fail.refused(res_on_work.err)}; }
    on_work = res_on_work.ok;
    val res_work: res[*ir_id.BlockId, A.Error] = A.allocate[ir_id.BlockId](st.alloc, n::usize);
    if (sel res_work.err) { ret err[fail.Fail].err{fail.refused(res_work.err)}; }
    work = res_work.ok;

    var failed: opt[fail.Fail] = opt[fail.Fail].none{};
    var a:      u32            = 0;
    for (a < st.alloca_count && sel failed.none) {
        val alloca_id: ir_id.InstructionId = st.alloca_ids[a];
        if (ir_type.is_aggregate(?st.m.types, st.alloca_ty[a])) {
            a = a + 1;
            cnt;
        }
        var i: u32 = 0;
        for (i < n) {
            has_phi[i] = false;
            on_work[i] = false;
            i          = i + 1;
        }

        var wlen:   u32 = 0;
        val sstart: u32 = st.store_start[a];
        val slen:   u32 = st.store_len[a];
        var s:      u32 = 0;
        for (s < slen) {
            val bb: u32 = st.store_blocks[sstart + s]::u32;
            if (bb < n && on_work[bb] == false) {
                on_work[bb] = true;
                work[wlen]  = bb::ir_id.BlockId;
                wlen        = wlen + 1;
            }
            s = s + 1;
        }

        for (wlen > 0 && sel failed.none) {
            wlen = wlen - 1;
            val x: u32 = work[wlen]::u32;
            on_work[x] = false;
            val fstart: u32 = st.dom.frontier_start[x];
            val flen:   u32 = st.dom.frontier_len[x];
            var k:      u32 = 0;
            for (k < flen) {
                val y: u32 = st.dom.frontier[fstart + k]::u32;
                if (has_phi[y] == false) {
                    has_phi[y] = true;
                    val res_place: err[fail.Fail] = place_phi(st, y::ir_id.BlockId, alloca_id);
                    if (sel res_place.err) { failed = opt[fail.Fail].some{res_place.err}; }
                    if (on_work[y] == false) {
                        on_work[y] = true;
                        work[wlen] = y::ir_id.BlockId;
                        wlen       = wlen + 1;
                    }
                }
                k = k + 1;
            }
        }
        a = a + 1;
    }

    if (sel failed.some) { ret err[fail.Fail].err{failed.some}; }
    ret err[fail.Fail].ok{};
}

fun place_phi(st: *State, bid: ir_id.BlockId, alloca_id: ir_id.InstructionId) err[fail.Fail] {
    val ai: u32 = alloca_index(st, alloca_id);
    if (ai == ir_id.NONE) {
        ret err[fail.Fail].err{fail.message("mem2reg: phi placed for a non-promotable alloca")};
    }

    var bld: builder.Builder = builder.init(st.m);
    builder.set_function(?bld, st.fn);
    builder.set_block(?bld, bid);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, st.alloca_ty[ai]);
    if (sel res_phi.err) {
        ret err[fail.Fail].err{res_phi.err};
    }
    val phi_id: ir_id.InstructionId = res_phi.ok.data.instr;
    if (phi_id::u32 >= st.phi_alloca_cap) {
        ret err[fail.Fail].err{fail.message("mem2reg: phi id exceeds phi_alloca capacity")};
    }
    st.phi_alloca[phi_id::u32] = alloca_id;
    ret err[fail.Fail].ok{};
}

fun emit_phi_dbg_births(st: *State) err[fail.Fail] {
    var bld: builder.Builder = builder.init(st.m);
    builder.set_function(?bld, st.fn);
    var bi: u32 = 0;
    for (bi < st.block_count) {
        val blk: *me_ir.Block = ?st.fn.blocks[bi];
        val pc:  u32          = blk.phi_count;
        var pi:  u32          = 0;
        for (pi < pc) {
            val phi_id: ir_id.InstructionId = blk.phis[pi];
            pi = pi + 1;

            if (phi_id::u32 >= st.phi_alloca_cap) { cnt; }
            val alloca_id: ir_id.InstructionId = st.phi_alloca[phi_id::u32];
            if (ir_id.instruction_is_nil(alloca_id)) { cnt; }

            val opt_dv: opt[*me_ir.DbgVar] = me_ir.alloca_dbg_var_get(st.fn, alloca_id);
            if (sel opt_dv.none) { cnt; }
            val dv: me_ir.DbgVar = @opt_dv.some;

            val opt_phi: opt[*ir_instruction.Instruction] = me_ir.instruction_get(st.fn, phi_id);
            if (sel opt_phi.none) { cnt; }

            # each birth goes first in the block, so the last phi's leads
            builder.after_phis(?bld, ir_id.block(bi));
            val born: err[fail.Fail] = builder.emit_dbg_value(?bld, value.instr(phi_id, opt_phi.some.ty), dv.name, dv.ty,
                dv.ty_sem, dv.is_param, dv.scope);
            if (sel born.err) { ret born; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

rec RenameCtx {
    st:      *State;
    rw:      mutate.Rewrite;
    cur:     *value.Value;
    defined: *bool;
    cap:     u32;
}

fun rename(st: *State) err[fail.Fail] {
    val na:   u32 = st.alloca_count;
    val ilen: u32 = st.fn.instr_len;

    var rc: RenameCtx;
    rc.st      = st;
    rc.cur     = nil;
    rc.defined = nil;
    rc.cap     = 0;

    val res_init: err[fail.Fail] = rename_ctx_init(?rc, na, ilen);
    if (sel res_init.err) { ret res_init; }

    val res_walk:  err[fail.Fail] = rename_walk(?rc);
    var res_strip: err[fail.Fail] = err[fail.Fail].ok{};
    if (sel res_walk.ok) {
        mutate.rewrite_apply(st.fn, ?rc.rw);
        res_strip = strip_promoted(st);
    }

    rename_ctx_dnit(?rc);
    if (sel res_walk.err) { ret res_walk; }
    ret res_strip;
}

fun rename_ctx_init(rc: *RenameCtx, na: u32, ilen: u32) err[fail.Fail] {
    val a: *A.Allocator = rc.st.alloc;

    val res_rw: err[fail.Fail] = mutate.rewrite_init(?rc.rw, a, ilen);
    if (sel res_rw.err) { ret res_rw; }

    val res_cur: res[*value.Value, A.Error] = A.allocate[value.Value](a, na::usize);
    if (sel res_cur.err) {
        rename_ctx_dnit(rc);
        ret err[fail.Fail].err{fail.refused(res_cur.err)};
    }
    rc.cur = res_cur.ok;
    rc.cap = na;

    val res_defined: res[*bool, A.Error] = A.allocate[bool](a, na::usize);
    if (sel res_defined.err) {
        rename_ctx_dnit(rc);
        ret err[fail.Fail].err{fail.refused(res_defined.err)};
    }
    rc.defined = res_defined.ok;

    var ai: u32 = 0;
    for (ai < na) {
        rc.defined[ai] = false;
        ai             = ai + 1;
    }
    ret err[fail.Fail].ok{};
}

fun rename_ctx_dnit(rc: *RenameCtx) {
    val a: *A.Allocator = rc.st.alloc;
    mutate.rewrite_dnit(?rc.rw, a);
    if (rc.cur != nil)     { A.deallocate[value.Value](a, rc.cur, rc.cap::usize); }
    if (rc.defined != nil) { A.deallocate[bool](a, rc.defined, rc.cap::usize); }
    rc.cur     = nil;
    rc.defined = nil;
    rc.cap     = 0;
}

fun alloca_index(st: *State, alloca_id: ir_id.InstructionId) u32 {
    if (ir_id.instruction_is_nil(alloca_id)) { ret ir_id.NONE; }
    if (alloca_id::u32 >= st.pool_len)       { ret ir_id.NONE; }
    ret st.alloca_of[alloca_id::u32];
}

fun rename_walk(rc: *RenameCtx) err[fail.Fail] {
    val st: *State = rc.st;
    val n:  u32    = st.block_count;
    val na: u32    = st.alloca_count;

    var snap_n: u32 = n * na;
    if (snap_n == 0) { snap_n = 1; }
    var save_cur:    *value.Value = nil;
    var save_def:    *bool        = nil;
    var frame_block: *u32         = nil;
    var frame_child: *u32         = nil;
    fin {
        if (frame_block != nil) { A.deallocate[u32](st.alloc, frame_block, n::usize); }
        if (frame_child != nil) { A.deallocate[u32](st.alloc, frame_child, n::usize); }
        if (save_cur != nil)    { A.deallocate[value.Value](st.alloc, save_cur, snap_n::usize); }
        if (save_def != nil)    { A.deallocate[bool](st.alloc, save_def, snap_n::usize); }
    }
    val res_save_cur: res[*value.Value, A.Error] = A.allocate[value.Value](st.alloc, snap_n::usize);
    if (sel res_save_cur.err) { ret err[fail.Fail].err{fail.refused(res_save_cur.err)}; }
    save_cur = res_save_cur.ok;
    val res_save_def: res[*bool, A.Error] = A.allocate[bool](st.alloc, snap_n::usize);
    if (sel res_save_def.err) { ret err[fail.Fail].err{fail.refused(res_save_def.err)}; }
    save_def = res_save_def.ok;
    val res_frame_block: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_frame_block.err) { ret err[fail.Fail].err{fail.refused(res_frame_block.err)}; }
    frame_block = res_frame_block.ok;
    val res_frame_child: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_frame_child.err) { ret err[fail.Fail].err{fail.refused(res_frame_child.err)}; }
    frame_child = res_frame_child.ok;

    var failed: opt[fail.Fail] = opt[fail.Fail].none{};
    snapshot(rc, save_cur, save_def, 0);
    val res_entry: err[fail.Fail] = rename_enter_block(rc, ir_id.block(0));
    if (sel res_entry.err) { failed = opt[fail.Fail].some{res_entry.err}; }
    frame_block[0] = 0;
    frame_child[0] = 0;
    var sp: u32 = 1;

    for (sp > 0 && sel failed.none) {
        val top:    u32 = sp - 1;
        val b:      u32 = frame_block[top];
        val ci:     u32 = frame_child[top];
        val cstart: u32 = st.dom.child_start[b];
        val clen:   u32 = st.dom.child_start[b + 1] - cstart;
        if (ci < clen) {
            frame_child[top] = ci + 1;
            val child: u32 = st.dom.children[cstart + ci];
            snapshot(rc, save_cur, save_def, sp);
            val res_child: err[fail.Fail] = rename_enter_block(rc, child::ir_id.BlockId);
            if (sel res_child.err) { failed = opt[fail.Fail].some{res_child.err}; }
            frame_block[sp] = child;
            frame_child[sp] = 0;
            sp              = sp + 1;
        }
        or {
            restore(rc, save_cur, save_def, top);
            sp = sp - 1;
        }
    }

    if (sel failed.some) { ret err[fail.Fail].err{failed.some}; }
    ret err[fail.Fail].ok{};
}

fun snapshot(rc: *RenameCtx, save_cur: *value.Value, save_def: *bool, d: u32) {
    val na: u32 = rc.st.alloca_count;
    var a:  u32 = 0;
    for (a < na) {
        save_cur[d * na + a] = rc.cur[a];
        save_def[d * na + a] = rc.defined[a];
        a                    = a + 1;
    }
}

fun restore(rc: *RenameCtx, save_cur: *value.Value, save_def: *bool, d: u32) {
    val na: u32 = rc.st.alloca_count;
    var a:  u32 = 0;
    for (a < na) {
        rc.cur[a]     = save_cur[d * na + a];
        rc.defined[a] = save_def[d * na + a];
        a             = a + 1;
    }
}

fun rename_enter_block(rc: *RenameCtx, bid: ir_id.BlockId) err[fail.Fail] {
    val st:  *State       = rc.st;
    val blk: *me_ir.Block = ?st.fn.blocks[bid::u32];

    var pi: u32 = 0;
    for (pi < blk.phi_count) {
        val phi_id: ir_id.InstructionId = blk.phis[pi];
        val ai:     u32                 = phi_alloca_index(rc, phi_id);
        if (ai != ir_id.NONE) {
            val opt_phi: opt[*ir_instruction.Instruction] = me_ir.instruction_get(st.fn, phi_id);
            if (sel opt_phi.some) {
                val phi: *ir_instruction.Instruction = opt_phi.some;
                rc.cur[ai]     = value.instr(phi_id, phi.ty);
                rc.defined[ai] = true;
            }
        }
        pi = pi + 1;
    }

    var ii: u32 = 0;
    for (ii < blk.instr_count) {
        val iid:      ir_id.InstructionId              = blk.instructions[ii];
        val opt_inst: opt[*ir_instruction.Instruction] = me_ir.instruction_get(st.fn, iid);
        if (sel opt_inst.some) {
            val inst: *ir_instruction.Instruction = opt_inst.some;
            if (inst.kind == ir_instruction.OP_LOAD && inst.operand_count >= 1) {
                val ptr: value.Value = inst.operands[0];
                if (ptr.kind == value.VAL_INSTR) {
                    val ai: u32 = alloca_index(st, ptr.data.instr);
                    if (ai != ir_id.NONE && iid::u32 < rc.rw.len) {
                        if (rc.defined[ai]) {
                            mutate.replace_value(?rc.rw, iid, rc.cur[ai]);
                        }
                        or {
                            mutate.replace_value(?rc.rw, iid, value.const_null(inst.ty));
                        }
                    }
                }
            }
            or (inst.kind == ir_instruction.OP_STORE && inst.operand_count >= 2) {
                val ptr: value.Value = inst.operands[1];
                if (ptr.kind == value.VAL_INSTR) {
                    val ai: u32 = alloca_index(st, ptr.data.instr);
                    if (ai != ir_id.NONE) {
                        rc.cur[ai]     = mutate.rewrite_resolve(?rc.rw, inst.operands[0]);
                        rc.defined[ai] = true;
                    }
                }
            }
        }
        ii = ii + 1;
    }

    var succ0: ir_id.BlockId = ir_id.BLOCK_NIL;
    var succ1: ir_id.BlockId = ir_id.BLOCK_NIL;
    val sn:    u32           = block_successors(st, bid, ?succ0, ?succ1);
    if (sn >= 1) {
        val res_first: err[fail.Fail] = add_phi_incomings(rc, bid, succ0);
        if (sel res_first.err) { ret res_first; }
    }
    if (sn >= 2 && !ir_id.block_same(succ1, succ0)) {
        val res_second: err[fail.Fail] = add_phi_incomings(rc, bid, succ1);
        if (sel res_second.err) { ret res_second; }
    }
    ret err[fail.Fail].ok{};
}

fun phi_alloca_index(rc: *RenameCtx, phi_id: ir_id.InstructionId) u32 {
    if (phi_id::u32 >= rc.st.phi_alloca_cap) { ret ir_id.NONE; }
    val alloca_id: ir_id.InstructionId = rc.st.phi_alloca[phi_id::u32];
    if (ir_id.instruction_is_nil(alloca_id)) { ret ir_id.NONE; }
    ret alloca_index(rc.st, alloca_id);
}

fun add_phi_incomings(rc: *RenameCtx, pred: ir_id.BlockId, succ: ir_id.BlockId) err[fail.Fail] {
    val st: *State = rc.st;
    if (succ::u32 >= st.block_count) { ret err[fail.Fail].ok{}; }
    val blk: *me_ir.Block = ?st.fn.blocks[succ::u32];
    var pi:  u32          = 0;
    for (pi < blk.phi_count) {
        val phi_id: ir_id.InstructionId = blk.phis[pi];
        val ai:     u32                 = phi_alloca_index(rc, phi_id);
        if (ai != ir_id.NONE) {
            val opt_phi: opt[*ir_instruction.Instruction] = me_ir.instruction_get(st.fn, phi_id);
            if (sel opt_phi.some) {
                val phi:      *ir_instruction.Instruction = opt_phi.some;
                var incoming: value.Value;
                if (rc.defined[ai]) {
                    incoming = rc.cur[ai];
                }
                or {
                    incoming = value.const_null(phi.ty);
                }
                val res_push: err[fail.Fail] = me_ir.phi_append_incoming(st.m, phi, pred, incoming);
                if (sel res_push.err) { ret res_push; }
            }
        }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun strip_promoted(st: *State) err[fail.Fail] {
    val changed_r: res[bool, fail.Fail] = mutate.erase_marked[State](st.m, st.fn, st.alloc, st, strip_test);
    if (sel changed_r.err) { ret err[fail.Fail].err{changed_r.err}; }
    ret err[fail.Fail].ok{};
}

fun strip_test(st: *State, iid: ir_id.InstructionId) bool {
    ret is_promoted_memop(st, iid);
}

fun is_promoted_memop(st: *State, iid: ir_id.InstructionId) bool {
    val opt_inst: opt[*ir_instruction.Instruction] = me_ir.instruction_get(st.fn, iid);
    if (sel opt_inst.none) { ret false; }
    val inst: *ir_instruction.Instruction = opt_inst.some;
    if (inst.kind == ir_instruction.OP_ALLOCA) {
        ret alloca_index(st, iid) != ir_id.NONE;
    }
    if (inst.kind == ir_instruction.OP_LOAD && inst.operand_count >= 1) {
        val ptr: value.Value = inst.operands[0];
        if (ptr.kind == value.VAL_INSTR) {
            ret alloca_index(st, ptr.data.instr) != ir_id.NONE;
        }
    }
    if (inst.kind == ir_instruction.OP_STORE && inst.operand_count >= 2) {
        val ptr: value.Value = inst.operands[1];
        if (ptr.kind == value.VAL_INSTR) {
            ret alloca_index(st, ptr.data.instr) != ir_id.NONE;
        }
    }
    ret false;
}

#[testing]
fun live_alloca_count(fn: *me_ir.Function, blk: *me_ir.Block) u32 {
    var n:  u32 = 0;
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        val opt_inst: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, blk.instructions[ix]);
        if (sel opt_inst.some) {
            if (opt_inst.some.kind == ir_instruction.OP_ALLOCA) { n = n + 1; }
        }
        ix = ix + 1;
    }
    ret n;
}

#[testing]
fun unlink_block_instr(blk: *me_ir.Block, iid: ir_id.InstructionId) {
    var w:  u32 = 0;
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        if (!ir_id.instruction_same(blk.instructions[ix], iid)) {
            blk.instructions[w] = blk.instructions[ix];
            w                   = w + 1;
        }
        ix = ix + 1;
    }
    blk.instr_count = w;
}

test run__promotes_only_once_the_escaping_call_is_removed {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: me_ir.Module = res_module.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t:     ir_type.IrTypeId                 = res_i64.ok;
    val res_void: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel res_void.err) { ret 1; }
    val voidt:   ir_type.IrTypeId                 = res_void.ok;
    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel res_ptr.err) { ret 1; }
    val ptrt: ir_type.IrTypeId = res_ptr.ok;

    val res_callee: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_callee.err) { ret 1; }
    val callee_ix: u32 = res_callee.ok;

    val res_caller: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_caller.err) { ret 1; }
    val caller_ix: u32             = res_caller.ok;
    val fn:        *me_ir.Function = ?m.functions[caller_ix];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: ir_id.BlockId = res_entry.ok;
    builder.set_block(?bld, entry);

    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val p: value.Value = res_alloca.ok;

    val stored_p: err[fail.Fail] = builder.emit_store(?bld, value.const_int(0, i64t), p);
    if (sel stored_p.err) { ret 1; }

    var args: [1]value.Value;
    args[0] = p;
    val callee_val: value.Value                 = value.fn(callee_ix, ptrt);
    val res_call:   res[value.Value, fail.Fail] = builder.emit_call(?bld, callee_val, ?args[0], 1, voidt);
    if (sel res_call.err) { ret 1; }
    val call_v:  value.Value         = res_call.ok;
    val call_id: ir_id.InstructionId = call_v.data.instr;

    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, p, i64t);
    if (sel res_load.err) { ret 1; }
    val returned: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel returned.err) { ret 1; }

    val entry_blk: *me_ir.Block = ?fn.blocks[entry::u32];

    val ran: res[bool, fail.Fail] = run(?m);
    if (sel ran.err)                           { ret 1; }
    if (live_alloca_count(fn, entry_blk) != 1) { ret 1; }
    # an escaping slot promotes nothing and reports no change
    if (ran.ok) { ret 2; }

    unlink_block_instr(entry_blk, call_id);

    val promoted: res[bool, fail.Fail] = run(?m);
    if (sel promoted.err)                      { ret 1; }
    if (live_alloca_count(fn, entry_blk) != 0) { ret 1; }
    if (!promoted.ok)                          { ret 3; }
    ret 0;
}

test run__dbg_value_is_not_an_escape {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: me_ir.Module = res_module.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: ir_id.BlockId = res_entry.ok;
    builder.set_block(?bld, entry);

    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val p: value.Value = res_alloca.ok;

    val stored_p: err[fail.Fail] = builder.emit_store(?bld, value.const_int(0, i64t), p);
    if (sel stored_p.err) { ret 1; }
    val described: err[fail.Fail] = builder.emit_dbg_value(?bld, p, intern.STR_NIL, i64t, type.TYPE_NIL, false, 0);
    if (sel described.err) { ret 1; }

    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, p, i64t);
    if (sel res_load.err) { ret 1; }
    val returned: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel returned.err) { ret 1; }

    val entry_blk: *me_ir.Block = ?fn.blocks[entry::u32];

    val ran: res[bool, fail.Fail] = run(?m);
    if (sel ran.err)                           { ret 1; }
    if (live_alloca_count(fn, entry_blk) != 0) { ret 1; }
    ret 0;
}

test run__phi_gets_a_dbg_birth {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: me_ir.Module = res_module.ok;
    fin { me_ir.dnit(?m); }

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val rb0: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb3: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 1; }
    if (sel rb1.err) { ret 1; }
    if (sel rb2.err) { ret 1; }
    if (sel rb3.err) { ret 1; }
    val entry: ir_id.BlockId = rb0.ok;
    val bb1:   ir_id.BlockId = rb1.ok;
    val bb2:   ir_id.BlockId = rb2.ok;
    val merge: ir_id.BlockId = rb3.ok;

    builder.set_block(?bld, entry);
    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val x:  value.Value = res_alloca.ok;
    var dv: me_ir.DbgVar;
    dv.name     = intern.str_id(7);
    dv.ty       = i64t;
    dv.ty_sem   = type.TYPE_NIL;
    dv.is_param = false;
    dv.scope    = 0;
    val recorded: err[fail.Fail] = me_ir.record_alloca_dbg_var(fn, x.data.instr, dv);
    if (sel recorded.err) { ret 1; }
    val to_bb1_or_bb2: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int(1, i64t), bb1, bb2);
    if (sel to_bb1_or_bb2.err) { ret 1; }

    builder.set_block(?bld, bb1);
    val stored_x: err[fail.Fail] = builder.emit_store(?bld, value.const_int(10, i64t), x);
    if (sel stored_x.err) { ret 1; }
    val to_merge: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel to_merge.err) { ret 1; }

    builder.set_block(?bld, bb2);
    val stored: err[fail.Fail] = builder.emit_store(?bld, value.const_int(20, i64t), x);
    if (sel stored.err) { ret 1; }
    val branched: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel branched.err) { ret 1; }

    builder.set_block(?bld, merge);
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, x, i64t);
    if (sel res_load.err) { ret 1; }
    val returned: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel returned.err) { ret 1; }

    val ran: res[bool, fail.Fail] = run(?m);
    if (sel ran.err) { ret 1; }

    val mblk: *me_ir.Block = ?fn.blocks[merge::u32];
    if (mblk.phi_count < 1) { ret 1; }
    val phi_id: ir_id.InstructionId = mblk.phis[0];

    var found: bool = false;
    var i:     u32  = 0;
    for (i < mblk.instr_count) {
        val iid: ir_id.InstructionId              = mblk.instructions[i];
        val oi:  opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, iid);
        if (sel oi.some) {
            val inst: *ir_instruction.Instruction = oi.some;
            if (inst.kind == ir_instruction.OP_DBG_VALUE && inst.operand_count >= 1) {
                val op: value.Value = inst.operands[0];
                if (op.kind == value.VAL_INSTR && ir_id.instruction_same(op.data.instr, phi_id)) {
                    val odv: opt[*me_ir.DbgVar] = me_ir.dbg_var_get(fn, iid);
                    if (sel odv.some && intern.str_same(odv.some.name, intern.str_id(7))) { found = true; }
                }
            }
        }
        i = i + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

#[testing]
fun agg_address_violations(m: *me_ir.Module) i64 {
    var tr:  resolved.Target = resolved.described_named("x86_64");
    var tgt: resolved.Target = tr;

    val res_rep: res[verify.VerifyReport, fail.Fail] =
        verify.verify_module_ext(m, m.alloc, verify.opts(?tgt, false, true));
    if (sel res_rep.err) { ret -1; }
    var rep: verify.VerifyReport = res_rep.ok;
    var n:   i64                 = 0;
    var i:   u32                 = 0;
    for (i < rep.len) {
        if (rep.violations[i].check == verify.VC_AGG_ADDRESS) { n = n + 1; }
        i = i + 1;
    }
    verify.dnit_report(?rep);
    ret n;
}

test run__aggregate_slot_takes_no_phi {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: me_ir.Module = res_module.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    var i64t: ir_type.IrTypeId = res_i64.ok;

    var fields: [2]ir_type.IrTypeId;
    fields[0] = i64t;
    fields[1] = i64t;
    val res_st: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?fields[0], 2, 0, false);
    if (sel res_st.err) { ret 1; }
    val stty: ir_type.IrTypeId = res_st.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rb0: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb3: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 1; }
    if (sel rb1.err) { ret 1; }
    if (sel rb2.err) { ret 1; }
    if (sel rb3.err) { ret 1; }
    val entry: ir_id.BlockId = rb0.ok;
    val arm:   ir_id.BlockId = rb1.ok;
    val skip:  ir_id.BlockId = rb2.ok;
    val merge: ir_id.BlockId = rb3.ok;

    builder.set_block(?bld, entry);
    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, stty, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val s:              value.Value    = res_alloca.ok;
    val to_arm_or_skip: err[fail.Fail] = builder.emit_cbr(?bld, value.param(0, i64t), arm, skip);
    if (sel to_arm_or_skip.err) { ret 1; }

    builder.set_block(?bld, arm);
    val stored_s: err[fail.Fail] = builder.emit_store(?bld, value.param(1, stty), s);
    if (sel stored_s.err) { ret 1; }
    val to_merge: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel to_merge.err) { ret 1; }

    builder.set_block(?bld, skip);
    val branched: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel branched.err) { ret 1; }

    builder.set_block(?bld, merge);
    val returned: err[fail.Fail] = builder.emit_ret(?bld, value.param(0, i64t));
    if (sel returned.err) { ret 1; }

    val ran: res[bool, fail.Fail] = run(?m);
    if (sel ran.err) { ret 1; }

    if (live_alloca_count(fn, ?fn.blocks[entry::u32]) != 0) { ret 1; }
    var b: u32 = 0;
    for (b < fn.block_count) {
        if ((?fn.blocks[b]).phi_count != 0) { ret 1; }
        b = b + 1;
    }
    if (agg_address_violations(?m) != 0) { ret 1; }
    ret 0;
}

test run__read_aggregate_slot_stays_in_memory {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: me_ir.Module = res_module.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    var i64t: ir_type.IrTypeId = res_i64.ok;

    var fields: [2]ir_type.IrTypeId;
    fields[0] = i64t;
    fields[1] = i64t;
    val res_st: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?fields[0], 2, 0, false);
    if (sel res_st.err) { ret 1; }
    val stty: ir_type.IrTypeId = res_st.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: ir_id.BlockId = res_entry.ok;
    builder.set_block(?bld, entry);

    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, stty, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val s:        value.Value    = res_alloca.ok;
    val stored_s: err[fail.Fail] = builder.emit_store(?bld, value.param(0, stty), s);
    if (sel stored_s.err) { ret 1; }
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, s, stty);
    if (sel res_load.err) { ret 1; }
    val returned: err[fail.Fail] = builder.emit_ret(?bld, value.param(1, i64t));
    if (sel returned.err) { ret 1; }

    val ran: res[bool, fail.Fail] = run(?m);
    if (sel ran.err) { ret 1; }

    if (live_alloca_count(fn, ?fn.blocks[entry::u32]) != 1) { ret 1; }
    ret 0;
}

test rename_ctx_dnit__idempotent_and_partial_construction_frees_its_own_extent {
    var failing: T.Testing;
    val made:    err[A.Error] = T.make(?failing);
    if (sel made.err) { ret 1; }
    var st: State;
    st.alloc = T.allocator_of(?failing);
    var rc: RenameCtx;
    rc.st      = ?st;
    rc.cur     = nil;
    rc.defined = nil;
    rc.cap     = 0;

    val opened: err[fail.Fail] = rename_ctx_init(?rc, 3, 4);
    if (sel opened.err) {
        T.dnit(?failing);
        ret 1;
    }
    if (rc.cap != 3 || rc.cur == nil || rc.defined == nil) {
        T.dnit(?failing);
        ret 1;
    }
    rename_ctx_dnit(?rc);
    rename_ctx_dnit(?rc);
    if (T.live_count(?failing) != 0 || T.double_free_count(?failing) != 0) {
        T.dnit(?failing);
        ret 1;
    }
    val total: usize = T.total_count(?failing);
    T.dnit(?failing);
    if (total == 0) { ret 1; }

    var ordinal: usize = 1;
    for (ordinal <= total) {
        var f:      T.Testing;
        val made_f: err[A.Error] = T.make(?f);
        if (sel made_f.err) { ret 1; }
        T.fail_at_ordinal(?f, ordinal);
        var pst: State;
        pst.alloc = T.allocator_of(?f);
        var prc: RenameCtx;
        prc.st      = ?pst;
        prc.cur     = nil;
        prc.defined = nil;
        prc.cap     = 0;
        val r: err[fail.Fail] = rename_ctx_init(?prc, 3, 4);
        if (sel r.ok) { rename_ctx_dnit(?prc); }
        or (prc.cur != nil || prc.defined != nil || prc.cap != 0) {
            T.dnit(?f);
            ret 1;
        }
        if (T.live_count(?f) != 0 || T.double_free_count(?f) != 0) {
            T.dnit(?f);
            ret 1;
        }
        T.dnit(?f);
        ordinal = ordinal + 1;
    }
    ret 0;
}

#[testing]
fun t_unreachable_promotion(promote: bool) i32 {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel initialized.err) { ret 2; }
    var m: me_ir.Module = initialized.ok;
    fin { me_ir.dnit(?m); }
    val integer: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel integer.err) { ret 3; }
    val i64t:      ir_type.IrTypeId                 = integer.ok;
    val signature: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, i64t, nil, 0, false);
    if (sel signature.err) { ret 4; }
    val added: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL,
        signature.ok, 0);
    if (sel added.err) { ret 5; }
    val fn:  *me_ir.Function = ?m.functions[added.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val first: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val dead:  res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val last:  res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel first.err) { ret 6; }
    if (sel dead.err)  { ret 6; }
    if (sel last.err)  { ret 6; }
    val entry:   ir_id.BlockId = first.ok;
    val removed: ir_id.BlockId = dead.ok;
    val merge:   ir_id.BlockId = last.ok;
    builder.set_block(?bld, entry);
    var slot: value.Value = value.const_null(i64t);
    if (promote) {
        val allocated: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
        if (sel allocated.err) { ret 7; }
        slot = allocated.ok;
        val stored_slot: err[fail.Fail] = builder.emit_store(?bld, value.const_int(7, i64t), slot);
        if (sel stored_slot.err) { ret 8; }
    }
    val to_merge: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel to_merge.err) { ret 9; }
    builder.set_block(?bld, removed);
    var dead_value: value.Value = value.const_int(9, i64t);
    if (promote) {
        val loaded: res[value.Value, fail.Fail] = builder.emit_load(?bld, slot, i64t);
        if (sel loaded.err) { ret 10; }
        val sum: res[value.Value, fail.Fail] = builder.emit_add(?bld,
            loaded.ok, value.const_int(2, i64t));
        if (sel sum.err) { ret 11; }
        dead_value = sum.ok;
    }
    val branched: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel branched.err) { ret 12; }
    builder.set_block(?bld, merge);
    val joined: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel joined.err) { ret 13; }
    val phi:            value.Value    = joined.ok;
    val phi_from_entry: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, value.const_int(7, i64t));
    if (sel phi_from_entry.err) { ret 14; }
    val phi_from_removed: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, removed, dead_value);
    if (sel phi_from_removed.err) { ret 14; }
    var live_value: value.Value = value.const_int(7, i64t);
    if (promote) {
        val loaded: res[value.Value, fail.Fail] = builder.emit_load(?bld, slot, i64t);
        if (sel loaded.err) { ret 15; }
        live_value = loaded.ok;
    }
    val total: res[value.Value, fail.Fail] = builder.emit_add(?bld, phi, live_value);
    if (sel total.err) { ret 16; }
    val returned: err[fail.Fail] = builder.emit_ret(?bld, total.ok);
    if (sel returned.err) { ret 17; }
    val before: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(nil, false, false));
    if (sel before.err) { ret 18; }
    var initial:       verify.VerifyReport = before.ok;
    val initial_count: u32                 = initial.len;
    verify.dnit_report(?initial);
    if (initial_count != 0) { ret 19; }

    val changed: res[bool, fail.Fail] = run(?m);
    if (sel changed.err) { ret 20; }
    val checked: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(nil, true, false));
    if (sel checked.err) { ret 21; }
    var report:     verify.VerifyReport = checked.ok;
    val violations: u32                 = report.len;
    verify.dnit_report(?report);
    if (violations != 0)                                                                 { ret 22; }
    if (!changed.ok)                                                                     { ret 23; }
    if (fn.block_count != 2 || !ir_id.block_same(fn.blocks[1].id, ir_id.block(1)))       { ret 24; }
    if (fn.blocks[1].pred_count != 1 || !ir_id.block_same(fn.blocks[1].preds[0], entry)) { ret 25; }
    val branch: *ir_instruction.Instruction = ?fn.instrs[ir_id.instruction_index(fn.blocks[0].terminator)];
    if (branch.kind != ir_instruction.OP_BR || branch.operands[0].data.int_lit != 1) { ret 26; }
    val incoming: *ir_instruction.Instruction = ?fn.instrs[ir_id.instruction_index(phi.data.instr)];
    if (incoming.operand_count != 2 || incoming.operands[0].data.int_lit != 0
        || incoming.operands[1].kind != value.VAL_CONST_INT || incoming.operands[1].data.int_lit != 7) { ret 27; }
    val sum: *ir_instruction.Instruction = ?fn.instrs[ir_id.instruction_index(total.ok.data.instr)];
    if (sum.operands[0].kind != value.VAL_INSTR || !ir_id.instruction_same(sum.operands[0].data.instr, phi.data.instr)
        || sum.operands[1].kind != value.VAL_CONST_INT || sum.operands[1].data.int_lit != 7) { ret 28; }
    if (live_alloca_count(fn, ?fn.blocks[0]) != 0) { ret 29; }
    val repeated: res[bool, fail.Fail] = run(?m);
    if (sel repeated.err) { ret 30; }
    if (repeated.ok)      { ret 30; }
    ret 0;
}

test run__unreachable_load_consumers_are_pruned_before_promotion {
    ret t_unreachable_promotion(true);
}

test run__unreachable_only_change_repairs_phi_and_predecessor_ids {
    ret t_unreachable_promotion(false);
}

# the fail-at-N fixture: a slot with a debug variable stored in both arms of a
# diamond and loaded at the join, plus an unreachable block the prune removes
#[testing]
fun probe_build(a: *me_testing.Attempt, m: *me_ir.Module) i32 {
    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t:   ir_type.IrTypeId    = res_i64.ok;
    val res_fn: res[u32, fail.Fail] = me_ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 2; }
    val fn:  *me_ir.Function = ?m.functions[res_fn.ok];
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, fn);
    val rb0: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb3: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb4: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 3; }
    if (sel rb1.err) { ret 3; }
    if (sel rb2.err) { ret 3; }
    if (sel rb3.err) { ret 3; }
    if (sel rb4.err) { ret 3; }
    val entry:  ir_id.BlockId = rb0.ok;
    val bb1:    ir_id.BlockId = rb1.ok;
    val bb2:    ir_id.BlockId = rb2.ok;
    val merge:  ir_id.BlockId = rb3.ok;
    val orphan: ir_id.BlockId = rb4.ok;
    val p0:     value.Value   = value.param(0, i64t);

    builder.set_block(?bld, entry);
    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 4; }
    val x:  value.Value = res_alloca.ok;
    var dv: me_ir.DbgVar;
    dv.name     = intern.str_id(7);
    dv.ty       = i64t;
    dv.ty_sem   = type.TYPE_NIL;
    dv.is_param = false;
    dv.scope    = 0;
    val r_dv: err[fail.Fail] = me_ir.record_alloca_dbg_var(fn, x.data.instr, dv);
    if (sel r_dv.err) { ret 5; }
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?bld, p0, bb1, bb2);
    if (sel r_cbr.err) { ret 6; }
    builder.set_block(?bld, bb1);
    val r_s1: err[fail.Fail] = builder.emit_store(?bld, value.const_int(10, i64t), x);
    if (sel r_s1.err) { ret 7; }
    val r_b1: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_b1.err) { ret 8; }
    builder.set_block(?bld, bb2);
    val r_s2: err[fail.Fail] = builder.emit_store(?bld, value.const_int(20, i64t), x);
    if (sel r_s2.err) { ret 9; }
    val r_b2: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_b2.err) { ret 10; }
    builder.set_block(?bld, merge);
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, x, i64t);
    if (sel res_load.err) { ret 11; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel r_ret.err) { ret 12; }
    builder.set_block(?bld, orphan);
    val r_orphan: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_orphan.err) { ret 13; }
    ret 0;
}

#[testing]
fun probe_transform(a: *me_testing.Attempt, m: *me_ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    var ctx: pass.Context         = pass.context(m, nil, workspace);
    val r:   res[bool, fail.Fail] = pass.run(?PASS, ?ctx);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the prune and every analysis phase (candidates, dominance, frontiers, phi
# placement work lists) are scratch and precede their mutation; phi placement,
# renaming (incoming appends) and the debug births allocate from the module as
# they rewrite, so a refusal there leaves a partially promoted function: the
# unreachable block is gone, no block was added, and every phi still holds
# whole (block, value) pairs
#[testing]
fun probe_contract(a: *me_testing.Attempt, m: *me_ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    val fn: *me_ir.Function = ?m.functions[0];
    if (fn.block_count != a.control.functions[0].block_count - 1) { ret false; }
    var b: u32 = 0;
    for (b < fn.block_count) {
        var p: u32 = 0;
        for (p < fn.blocks[b].phi_count) {
            if (fn.instrs[ir_id.instruction_index(fn.blocks[b].phis[p])].operand_count % 2 != 0) { ret false; }
            p = p + 1;
        }
        b = b + 1;
    }
    ret true;
}

test pass__refusal_at_every_ordinal_leaves_the_input_or_whole_phi_pairs {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: nil, control: nil, context: nil};
    var control: me_ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { me_ir.dnit(?control); }
    ret me_testing.walk(?a);
}
