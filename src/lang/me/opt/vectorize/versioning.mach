        ret 1;
    }
    val rf: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val fn:  *me_ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val safe_bound: value.Value = value.const_int(VER_I64_SMAX - VER_MAGNITUDE_MARGIN, i64t);
    var entry:      ir_id.BlockId;
    var header:     ir_id.BlockId;
    var body:       ir_id.BlockId;
    var exit:       ir_id.BlockId;
    var iv:         value.Value;
    if (build_axpy_ext(?m, ?bld, i64t, ptrt, safe_bound, value.const_int(0, i64t), 0, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        me_ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis                 = ral.ok;
    val rd: res[dependence.DepInfo, fail.Fail] = dependence.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        me_ir.dnit(?m);
        ret 1;
    }
    var di: dependence.DepInfo            = rd.ok;
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di, ?alloc);
    if (sel rv.err) {
        dependence.dep_dnit(?di);
        loops.dnit(?la);
        me_ir.dnit(?m);
        ret 1;
    }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_OK) { code = 1; }
    version_result_dnit(?vres, ?alloc);
    dependence.dep_dnit(?di);
    loops.dnit(?la);
    me_ir.dnit(?m);
    ret code;
}

test version_loop__refuses_an_unsafe_offset_before_mutation {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  me_ir.Module                     = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig:  ir_type.IrTypeId;
    if (t_axpy_sig(?m, i64t, ptrt, ?sig) != 0) {
        me_ir.dnit(?m);
        ret 1;
    }
    val rf: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val fn:  *me_ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val n:      value.Value = value.param(0, i64t);
    var entry:  ir_id.BlockId;
    var header: ir_id.BlockId;
    var body:   ir_id.BlockId;
    var exit:   ir_id.BlockId;
    var iv:     value.Value;
    if (build_axpy_ext(?m, ?bld, i64t, ptrt, n, value.const_int(0, i64t), VER_MAGNITUDE_MARGIN + 1, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        me_ir.dnit(?m);
        ret 1;
    }

    val blocks_before: u32 = fn.block_count;
    val instrs_before: u32 = fn.instr_len;

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis                 = ral.ok;
    val rd: res[dependence.DepInfo, fail.Fail] = dependence.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        me_ir.dnit(?m);
        ret 1;
    }
    var di: dependence.DepInfo            = rd.ok;
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di, ?alloc);
    if (sel rv.err) {
        dependence.dep_dnit(?di);
        loops.dnit(?la);
        me_ir.dnit(?m);
        ret 1;
    }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_UNSAFE_BOUND) { code = 1; }
    if (fn.block_count != blocks_before)     { code = 1; }
    if (fn.instr_len != instrs_before)       { code = 1; }
    version_result_dnit(?vres, ?alloc);
    dependence.dep_dnit(?di);
    loops.dnit(?la);
    me_ir.dnit(?m);
    ret code;
}

test version_loop__dynamic_bound_guard_gains_magnitude_checks {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  me_ir.Module                     = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig:  ir_type.IrTypeId;
    if (t_axpy_sig(?m, i64t, ptrt, ?sig) != 0) {
        me_ir.dnit(?m);
        ret 1;
    }
    val rf: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val fn:  *me_ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry:  ir_id.BlockId;
    var header: ir_id.BlockId;
    var body:   ir_id.BlockId;
    var exit:   ir_id.BlockId;
    var iv:     value.Value;
    if (build_axpy(?m, ?bld, i64t, ptrt, ?entry, ?header, ?body, ?exit, ?iv) != 0) {
        me_ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    var la: loops.LoopAnalysis                 = ral.ok;
    val rd: res[dependence.DepInfo, fail.Fail] = dependence.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) {
        loops.dnit(?la);
        me_ir.dnit(?m);
        ret 1;
    }
    var di: dependence.DepInfo            = rd.ok;
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di, ?alloc);
    if (sel rv.err) {
        dependence.dep_dnit(?di);
        loops.dnit(?la);
        me_ir.dnit(?m);
        ret 1;
    }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_OK) { code = 1; }
    or {
        if (count_op(fn, vres.guard, ir_instruction.OP_CMP_LE_S) != 2) { code = 1; }
        if (count_op(fn, vres.guard, ir_instruction.OP_CMP_LE_U) != 4) { code = 1; }
        if (count_op(fn, vres.guard, ir_instruction.OP_OR) != 2)       { code = 1; }
        # the bound's two-sided check, the two alias pairs joined, and the two joined again;
        # the constant initial value and offsets contribute no instruction
        if (count_op(fn, vres.guard, ir_instruction.OP_AND) != 3) { code = 1; }
    }
    version_result_dnit(?vres, ?alloc);
    dependence.dep_dnit(?di);
    loops.dnit(?la);
    me_ir.dnit(?m);
    ret code;
}

#[testing]
rec MetaSeen { mask: u32; }

#[testing]
fun note_meta(c: *MetaSeen, r: *refs.Ref) bool {
    if (r.role == refs.REF_METADATA)      { c.mask = c.mask | (1 << r.meta::u32); }
    if (r.role == refs.REF_INLINE_PARENT) { c.mask = c.mask | (1 << refs.META_INLINE_SITE::u32); }
    if (r.role == refs.REF_ASM_BIND)      { c.mask = c.mask | 0x80000000; }
    ret true;
}

#[testing]
fun meta_mask_of(fn: *me_ir.Function, iid: ir_id.InstructionId) u32 {
    var c: MetaSeen;
    c.mask = 0;
    refs.visit[MetaSeen](fn, iid, ?c, note_meta);
    ret c.mask;
}

test clone_instruction_complete__carries_every_metadata_kind_the_reference_visitor_reports {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;
    fin { me_ir.dnit(?m); }

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 1; }
    val i64t: ir_type.IrTypeId                 = ri.ok;
    val rv:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;

    val r_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (sel r_fn.err) { ret 1; }
    val fn_ix: u32 = r_fn.ok;

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[fn_ix]);
    val rblk: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rblk.err) { ret 1; }
    builder.set_block(?bld, rblk.ok);

    val r_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel r_alloca.err) { ret 1; }
    val slot:  value.Value                 = r_alloca.ok;
    val r_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.const_int(1, i64t), value.const_int(2, i64t));
    if (sel r_add.err) { ret 1; }
    val added:    value.Value    = r_add.ok;
    val returned: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel returned.err) { ret 1; }

    val fn:         *me_ir.Function     = ?m.functions[fn_ix];
    val add_iid:    ir_id.InstructionId = added.data.instr;
    val alloca_iid: ir_id.InstructionId = slot.data.instr;

    var dv: me_ir.DbgVar;
    dv.name     = intern.str_id(4242);
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 7;
    val noted: res[bool, A.Error] = map.insert[ir_id.InstructionId, me_ir.DbgVar](?fn.dbg_vars, add_iid, dv);
    if (sel noted.err) { ret 1; }
    val recorded: err[fail.Fail] = me_ir.record_alloca_dbg_var(fn, alloca_iid, dv);
    if (sel recorded.err) { ret 1; }

    var sk: u32 = 0;
    for (sk < 4) {
        val site: res[u32, fail.Fail] = me_ir.inline_site_add(?m, fn, intern.str_id(9), lang_source.location_nil(), 0);
        if (sel site.err) { ret 1; }
        sk = sk + 1;
    }
    val sited: err[fail.Fail] = me_ir.instr_inline_site_set(fn, add_iid, 3);
    if (sel sited.err) { ret 1; }

    val src_mask: u32 = meta_mask_of(fn, add_iid);
    if ((src_mask & (1 << refs.META_DBG_VAR::u32)) == 0)     { ret 1; }
    if ((src_mask & (1 << refs.META_INLINE_SITE::u32)) == 0) { ret 1; }
    val src_alloca_mask: u32 = meta_mask_of(fn, alloca_iid);
    if ((src_alloca_mask & (1 << refs.META_ALLOCA_DBG_VAR::u32)) == 0) { ret 1; }

    val map_len: u32                = fn.instr_len;
    val res_map: res[*u32, A.Error] = A.allocate[u32](m.alloc, map_len::usize);
    if (sel res_map.err) { ret 1; }
    val instr_map: *u32 = res_map.ok;
    fin { A.deallocate[u32](m.alloc, instr_map, map_len::usize); }
    var k: u32 = 0;
    for (k < map_len) {
        instr_map[k] = 0xFFFFFFFF;
        k            = k + 1;
    }

    val cloned: res[ir_id.InstructionId, fail.Fail] = mutate.clone_instruction_complete(?m, fn, fn, add_iid, instr_map, map_len);
    if (sel cloned.err) { ret 1; }
    val cloned_fn: res[ir_id.InstructionId, fail.Fail] = mutate.clone_instruction_complete(?m, fn, fn, alloca_iid, instr_map, map_len);
    if (sel cloned_fn.err) { ret 1; }

    val add_clone:    ir_id.InstructionId = cloned.ok;
    val alloca_clone: ir_id.InstructionId = cloned_fn.ok;

    if (meta_mask_of(fn, add_clone) != src_mask)           { ret 1; }
    if (meta_mask_of(fn, alloca_clone) != src_alloca_mask) { ret 1; }
    ret 0;
}
