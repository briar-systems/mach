# the optimizer's gates over lowered programs
use A: std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use mach.lang.driver.project;
use mach.lang.fail;
use me_ir:          mach.lang.me.ir;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.module;
use mach.lang.session;
use mach.lang.toolchain;

use mach.lang.driver.tests.testing.ut_inline_calls_of;
use mach.lang.driver.tests.testing.ut_inline_function;
use mach.lang.driver.tests.testing.ut_inline_ops;
use mach.lang.driver.tests.testing.ut_inline_prepare;
use mach.lang.driver.tests.testing.ut_mid;
use mach.lang.driver.tests.testing.ut_scaffold;

# an #[oblivious] provider body is expanded only into an #[oblivious] importer
test inline__oblivious_callee_stays_a_call_in_a_public_caller {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val initialized: res[session.Session, fail.Fail] = toolchain.session_init(?alloc);
    if (sel initialized.err) { ret 2; }
    var s: session.Session = initialized.ok;
    fin { session.dnit(?s); }
    var names: [2]str = [2]str{"main.mach", "helper.mach"};
    var texts: [2]str;
    texts[0] = "use h: uniontest.helper;\npub fun open(v: ^i32) ^i32 { ret h.classified(v); }\n#[oblivious] pub fun closed(v: ^i32) ^i32 { ret h.classified(v); }\nfun main() i32 { ret 0; }\n";
    texts[1] = "#[oblivious] pub fun classified(v: ^i32) ^i32 { ret v + 1; }\n";
    val scaffold: res[str, fail.Fail] = ut_scaffold(?alloc, ?names[0], ?texts[0], 2);
    if (sel scaffold.err) { ret 4; }
    val root: str = scaffold.ok;
    fin {
        fs.remove_all(?alloc, root);
        str_free(?alloc, root);
    }
    val lowered: res[project.Project, fail.Fail] = ut_inline_prepare(?s, root, 0);
    if (sel lowered.err) { ret 5; }
    var p: project.Project = lowered.ok;
    fin { project.dnit_project(?p); }
    val mid: session.ModuleId = ut_mid(?p, ?s, "uniontest.main");
    if (module.is_nil(mid)) { ret 6; }
    val m: *me_ir.Module = project.module_at(?p, mid::u32).ir_module;
    if (ut_inline_calls_of(?s, m, "uniontest.main.open") != 1) { ret 7; }
    val closed: *me_ir.Function = ut_inline_function(?s, m, "uniontest.main.closed");
    if (ut_inline_ops(closed, ir_instruction.OP_CALL) != 0) { ret 8; }
    var secret_add: bool = false;
    var ii:         u32  = 0;
    for (ii < closed.instr_len) {
        if (closed.instrs[ii].kind == ir_instruction.OP_ADD && closed.instrs[ii].secret) { secret_add = true; }
        ii = ii + 1;
    }
    if (!secret_add) { ret 9; }
    ret 0;
}
