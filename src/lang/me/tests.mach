test vector_bitcast_does_not_survive {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val src: str = "pub fun pick(m: u8x16, a: i8x16, b: i8x16) i8x16 {\n    ret ((m & a:~u8x16) | (~m & b:~u8x16)):~i8x16;\n}\nfun main() i32 { ret 0; }\n";

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux-riscv64");
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (ut_count_vector_typed_instrs(?p) != 0) { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

test vector_bitcast_survives_on_capable_target {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val src: str = "pub fun pick(m: u8x16, a: i8x16, b: i8x16) i8x16 {\n    ret ((m & a:~u8x16) | (~m & b:~u8x16)):~i8x16;\n}\nfun main() i32 { ret 0; }\n";

    var bad: i32                                = 0;
    val pr:  res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, src, "linux");
    if (sel pr.err) { bad = 1; }
    if (sel pr.ok) {
        var p: project.Project = pr.ok;
        if (ut_count_vector_typed_instrs(?p) == 0) { bad = 1; }
        project.dnit_project(?p);
    }

    session.dnit(?s);
    ret bad;
}

fun ut_count_bitcasts(p: *project.Project) u32 {
    var n:  u32 = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val fn: *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ix:  u32       = 0;
                    for (ix < blk.instr_count) {
                        if ((?fn.instrs[blk.instructions[ix]]).kind == instruction.OP_BITCAST) { n = n + 1; }
                        ix = ix + 1;
                    }
                    bi = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
    ret n;
}

test identity_cast_emits_no_bitcast {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var bad: i32 = 0;

    val ident: str                                = "pub fun f(a: u64, b: i64, c: f64) u64 { ret a::u64 + b::u64 + (c::f64)::u64; }\nfun main() i32 { ret 0; }\n";
    val ir:    res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, ident, "linux");
    if (sel ir.err) { bad = 1; }
    if (sel ir.ok) {
        var pi: project.Project = ir.ok;
        if (ut_count_bitcasts(?pi) != 0) { bad = 1; }
        project.dnit_project(?pi);
    }

    val cross: str                                = "pub fun g(a: u64) u64 { ret (a:~f64):~u64; }\nfun main() i32 { ret 0; }\n";
    val cr:    res[project.Project, outcome.Fail] = ut_vec_lower(?s, ?alloc, cross, "linux");
    if (sel cr.err) { bad = 1; }
    if (sel cr.ok) {
        var pc: project.Project = cr.ok;
        if (ut_count_bitcasts(?pc) != 2) { bad = 1; }
        project.dnit_project(?pc);
    }

    session.dnit(?s);
    ret bad;
}

test identity_cast_keeps_secret_taint {
    var bad: i32 = 0;
    if (ut_lower_rejects("fun f(a: ^u64, b: ^u64) ^u64 { ret a::^u64 * b::^u64; }\nfun main() i32 { ret 0; }\n",
        "#[oblivious]") != 0) { bad = 1; }
    if (ut_lower_ok("fun f(a: ^u64) ^u64 { ret a::^u64; }\nfun main() i32 { ret 0; }\n") != 0) { bad = 1; }
    ret bad;
}

fun ut_instr_in_blocks(f: *ir.Function, iid: ir.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < f.block_count) {
        val b: *ir.Block = ?f.blocks[bi];
        var k: u32       = 0;
        for (k < b.phi_count) {
            if (b.phis[k] == iid) { ret true; }
            k = k + 1;
        }
        k = 0;
        for (k < b.instr_count) {
            if (b.instructions[k] == iid) { ret true; }
            k = k + 1;
        }
        if (b.terminator == iid) { ret true; }
        bi = bi + 1;
    }
    ret false;
}

fun ut_dangling_ops(f: *ir.Function, iid: ir.InstructionId) u32 {
    val opt_ins: opt[*instruction.Instruction] = ir.instruction_get(f, iid);
    if (sel opt_ins.none) { ret 0; }
    val ins:  *instruction.Instruction = opt_ins.some;
    var hits: u32                      = 0;
    var oi:   u32                      = 0;
    for (oi < ins.operand_count) {
        val v: *value.Value = ?ins.operands[oi];
        if (v.kind == value.VAL_INSTR) {
            if (!ut_instr_in_blocks(f, v.data.instr)) { hits = hits + 1; }
        }
        oi = oi + 1;
    }
    ret hits;
}

fun ut_operand_audit(p: *project.Project, phis: *u32, dangling: *u32) {
    @phis     = 0;
    @dangling = 0;
    var ti: u32 = 0;
    for (ti < p.topo_len) {
        val m: *ir.Module = project.module_at(p, p.topo[ti]::u32).ir_module;
        if (m != nil) {
            var fi: u32 = 0;
            for (fi < m.function_len) {
                val f:  *ir.Function = ?m.functions[fi];
                var bi: u32          = 0;
                for (bi < f.block_count) {
                    val b: *ir.Block = ?f.blocks[bi];
                    @phis = @phis + b.phi_count;
                    var k: u32 = 0;
                    for (k < b.phi_count) {
                        @dangling = @dangling + ut_dangling_ops(f, b.phis[k]);
                        k         = k + 1;
                    }
                    k = 0;
                    for (k < b.instr_count) {
                        @dangling = @dangling + ut_dangling_ops(f, b.instructions[k]);
                        k         = k + 1;
                    }
                    @dangling = @dangling + ut_dangling_ops(f, b.terminator);
                    bi        = bi + 1;
                }
                fi = fi + 1;
            }
        }
        ti = ti + 1;
    }
}

fun ut_lane_merge_src() str {
    ret "fun sink(h: u64, v: f32) u64 { ret h + 1; }\n\npub fun probe(seed: u64) f32 {\n    val z: f32 = seed::f32;\n    var a: f32x4 = f32x4{1.5, -2.25, 3.75, -0.5};\n    a[0] = a[0] + z;\n    var h: u64 = 0;\n    h = sink(h, a[0]);\n    var mx: f32 = a[0];\n    if (a[1] > mx) { mx = a[1]; }\n    ret mx;\n}\n\n#[symbol(\"main\")]\nfun main(argc: i64, argv: **u8) i32 { ret 0; }\n";
}

fun ut_manifest_o2() str {
    ret "[project]\nmach = \">=5\"\nid = \"uniontest\"\nversion = \"0.0.0\"\nsrc = \"src\"\nout = \"out/{target.name}/{profile.name}\"\n\n[target.linux]\nisa = \"x86_64\"\nos = \"linux\"\nabi = \"sysv64\"\n\n[target.linux-arm64]\nisa = \"aarch64\"\nos = \"linux\"\nabi = \"aapcs64\"\n\n[target.linux-riscv64]\nisa = \"riscv64\"\nos = \"linux\"\nabi = \"lp64d\"\n\n[profile.release]\nopt = 2\ndebug = false\nsimd = \"scalarize\"\nvectorize = true\nfloat_reassoc = false\n\n[artifact.uniontest]\nkind = \"bin\"\nentry = \"main.mach\"\nout = \"bin/uniontest\"\ntargets = [\"*\"]\nlink = []\nneed = []\n";
}

fun ut_o2_lower(s: *session.Session, alloc: *A.Allocator, src: str, target_name: str) res[project.Project, outcome.Fail] {
    var names: [1]str;
    names[0] = "main.mach";
    var texts: [1]str;
    texts[0] = src;
    val root_r: res[str, fail.Fail] = ut_scaffold_m(alloc, ut_manifest_o2(), ?names[0], ?texts[0], 1);
    if (sel root_r.err) { ret res[project.Project, outcome.Fail].err{outcome.from_fail(root_r.err)}; }
    val root: str               = root_r.ok;
    val rr:   err[outcome.Fail] = driver.setup_registry(s.registry);
    if (sel rr.err) {
        fs.remove_all(alloc, root);
        ret res[project.Project, outcome.Fail].err{rr.err};
    }
    var tsel_17664: manifest.Selection                 = ut_target_sel(target_name);
    val pr:         res[project.Project, outcome.Fail] = driver.build_project(s, root, ?tsel_17664);
    fs.remove_all(alloc, root);
    if (sel pr.err) { ret pr; }
    var p:  project.Project   = pr.ok;
    val se: err[outcome.Fail] = driver.run_sema_pass(?p);
    if (sel se.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{se.err};
    }
    val le: err[outcome.Fail] = driver.run_lower_pass(?p);
    if (sel le.err) {
        project.dnit_project(?p);
        ret res[project.Project, outcome.Fail].err{le.err};
    }
    ret res[project.Project, outcome.Fail].ok{p};
}

fun ut_lane_merge_operands_ok(target_name: str) i32 {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    val pr: res[project.Project, outcome.Fail] = ut_o2_lower(?s, ?alloc, ut_lane_merge_src(), target_name);
    if (sel pr.err) {
        session.dnit(?s);
        ret 1;
    }
    var p: project.Project = pr.ok;

    var bad:      i32 = 0;
    var phis:     u32 = 0;
    var dangling: u32 = 0;
    ut_operand_audit(?p, ?phis, ?dangling);
    if (phis == 0)     { bad = 1; }
    if (dangling != 0) { bad = 1; }

    project.dnit_project(?p);
    session.dnit(?s);
    ret bad;
}

test lane_merge_phi_keeps_its_incoming {
    var bad: i32 = 0;
    if (ut_lane_merge_operands_ok("linux-riscv64") != 0) { bad = 1; }
    if (ut_lane_merge_operands_ok("linux") != 0)         { bad = 1; }
    if (ut_lane_merge_operands_ok("linux-arm64") != 0)   { bad = 1; }
    ret bad;
}

test tag_values_lower_and_codegen {
    if (ut_codegen_target_ok("tag Reply: u8 { empty; value: i64; } fun main() i32 { val a: Reply = Reply.value{42}; val b: Reply = Reply.empty{}; if (sel a.value && sel b.empty) { ret 0; } ret 1; }", "linux") != 0)                               { ret 1; }
    if (ut_codegen_target_ok("tag Reply: u8 { empty; value: i64; } val g: Reply = Reply.value{42}; fun main() i32 { if (sel g.value) { ret 0; } ret 1; }", "linux") != 0)                                                                            { ret 2; }
    if (ut_codegen_target_ok("tag Wide: u32 { a; b: i64; c: i64; } fun main() i32 { val w: Wide = Wide.c{9}; if (sel w.c) { ret 0; } ret 1; }", "linux") != 0)                                                                                       { ret 3; }
    if (ut_codegen_target_ok("tag res[T, E]: u8 { err: E; ok: T; } tag opt[T]: u8 { none; some: T; } tag err[E]: u8 { err: E; ok; }\nfun main() i32 { val r: res[i64, u32] = res[i64, u32].ok{5}; if (sel r.ok) { ret 0; } ret 1; }", "linux") != 0) { ret 4; }
    if (ut_codegen_target_ok("tag Reply: u8 { empty; value: i64; } rec Box { r: Reply; } fun main() i32 { var b: Box; if (sel b.r.empty) { ret 0; } ret 1; }", "linux") != 0)                                                                        { ret 5; }
    if (ut_codegen_target_ok("tag Reply: u8 { empty; value: i64; } fun main() i32 { var a: [2]Reply; a[0] = Reply.value{1}; if (sel a[0].value) { ret 0; } ret 1; }", "linux") != 0)                                                                 { ret 6; }
    val cross: str = "tag Reply: u8 { empty; value: i64; } val g: Reply = Reply.value{42}; fun main() i32 { val a: Reply = Reply.empty{}; if (sel a.empty && sel g.value) { ret 0; } ret 1; }";
    if (ut_codegen_target_ok(cross, "linux-arm64") != 0)   { ret 7; }
    if (ut_codegen_target_ok(cross, "linux-riscv64") != 0) { ret 8; }
    ret 0;
}

test cases_projection_and_construction_lower_and_codegen {
    # descriptor tests, projections, constructions and a generic instantiated over a tag reach every native backend
    val src: str = "tag Reply: u8 { empty; value: i64; }\ntag Other: u8 { empty; value: i64; }\ntag Box[T]: u8 { none; some: T; }\ntag Outer: u8 { none; inner: Reply; }\nfun code_of(v: Reply) u64 { $each c in $cases(Reply) { if (sel v.[c]) { ret c.code; } } ret 99; }\nfun build[T](x: T) Box[T] { $each c in $cases(Box[T]) { $if (c.has_payload) { ret Box[T].[c]{x}; } } ret Box[T].none{}; }\nfun take[T](v: Box[T]) T { $each c in $cases(Box[T]) { $if (c.has_payload) { if (sel v.[c]) { ret v.[c]; } } } var z: T; ret z; }\nfun count[T](v: T) u64 { var n: u64 = 0; $each c in $cases(T) { n = n + 1; } ret n; }\nfun main() i32 { var r: Reply = Reply.value{5}; if (code_of(r) != 1) { ret 1; } var b: Box[u32] = build[u32](7); if (take[u32](b) != 7) { ret 2; } $each c in $cases(Box[u32]) { $if (c.has_payload) { if (sel b.[c]) { b.[c] = 9; } if (c.offset != $offset_of(Box[u32], some)) { ret 3; } } } if (take[u32](b) != 9) { ret 4; } var o: Outer = Outer.inner{r}; $each c in $cases(Outer) { $if (c.has_payload) { if (sel o.[c]) { if (sel o.[c].value) { if (o.[c].value != 5) { ret 5; } } } } } if (count[Reply](r) != 2 || count[Box[u32]](b) != 2) { ret 6; } ret 0; }";
    if (ut_codegen_target_ok(src, "linux") != 0)         { ret 1; }
    if (ut_codegen_target_ok(src, "linux-arm64") != 0)   { ret 2; }
    if (ut_codegen_target_ok(src, "linux-riscv64") != 0) { ret 3; }
    ret 0;
}

# the 128-bit operations that reach the backend through more than the lane
# legalizer: a mixed-sign compare at 128 bits (the compare runs at the wider
# operand's width), a shift by a 128-bit count (its count stays a vreg), the
# division and float-conversion helpers, all on every native backend (#3511)
test int128_operations_lower_and_codegen {
    val src: str = "fun cmp(a: u128, b: i128, c: u64, d: i32) u8 { var r: u8 = 0; if (a == b) { r = r | 1; } if (a < b) { r = r | 2; } if (b <= c) { r = r | 4; } if (a > d) { r = r | 8; } if (d != a) { r = r | 16; } ret r; }\nfun sh(a: u128, k: u128, s: i128) u128 { ret (a << k) | (a >> (127 - k)) | (s >> k):~u128; }\nfun dv(a: u128, b: u128, c: i128, d: i128) u128 { ret a / b + a % b + (c / d):~u128 + (c % d):~u128; }\nfun cv(a: u128, b: i128, f: f64, g: f32) f64 { ret a::f64 + b::f64 + (a::f32)::f64 + (b::f32)::f64 + (f::u128)::f64 + (f::i128)::f64 + (g::u128)::f64 + (g::i128)::f64; }\nfun main() i32 { if (cmp(5, -5, 7, -1) != 8 + 16) { ret 1; } if (sh(1, 127, -1) != 340282366920938463463374607431768211455) { ret 2; } if (dv(100, 7, -100, 7) != 14 + 2 + (0i128 - 14):~u128 + (0i128 - 2):~u128) { ret 3; } if (cv(1, -1, 2.0, 3.0) != 10.0) { ret 4; } ret 0; }";
    if (ut_codegen_target_ok(src, "linux") != 0)         { ret 1; }
    if (ut_codegen_target_ok(src, "linux-arm64") != 0)   { ret 2; }
    if (ut_codegen_target_ok(src, "linux-riscv64") != 0) { ret 3; }
    if (ut_codegen_target_ok(src, "windows") != 0)       { ret 4; }
    ret 0;
}

# a shift whose count the range analysis proves below the operand's width
# carries the count-bounded mark and lowers to the bare machine shift; every
# other keeps the saturation of #3756 (#3885). each function holds one kind of
# count: a loop counter under its guard, the same counter run to the width, an
# inclusive guard, a signed counter, a mask, a parameter, a guard around the
# shift and one that does not dominate it, the failing arm of a compare, the
# differences `63 - bit` and `127 - bit` under both arms of `bit < 64`, and the
# bit-plane position of a bitsliced cipher with and without a runtime term
fun ut_shift_bound_program() str {
    ret "#[noinline] fun loop_below(x: u64) u64 { var r: u64 = 0; var i: u64 = 0; for (i < 64) { r = r ^ (x >> i); i = i + 1; } ret r; }\n#[noinline] fun loop_to_width(x: u64) u64 { var r: u64 = 0; var i: u64 = 0; for (i < 65) { r = r ^ (x >> i); i = i + 1; } ret r; }\n#[noinline] fun loop_inclusive(x: u64) u64 { var r: u64 = 0; var i: u64 = 0; for (i <= 63) { r = r ^ (x << i); i = i + 1; } ret r; }\n#[noinline] fun loop_inclusive_width(x: u64) u64 { var r: u64 = 0; var i: u64 = 0; for (i <= 64) { r = r ^ (x << i); i = i + 1; } ret r; }\n#[noinline] fun loop_signed(x: u64) u64 { var r: u64 = 0; var i: i64 = 0; for (i < 64) { r = r ^ (x >> i); i = i + 1; } ret r; }\n#[noinline] fun loop_narrow(x: u32) u32 { var r: u32 = 0; var i: u32 = 0; for (i < 40) { r = r ^ (x << i); i = i + 1; } ret r; }\n#[noinline] fun masked(x: u64, n: u64) u64 { ret x << (n & 63); }\n#[noinline] fun unproven(x: u64, n: u64) u64 { ret x << n; }\n#[noinline] fun guarded(x: u64, n: u64) u64 { if (n < 64) { ret x << n; } ret 0; }\n#[noinline] fun past_guard(x: u64, n: u64) u64 { var r: u64 = 0; if (n < 64) { r = 1; } ret r | (x << n); }\n#[noinline] fun failing_arm(x: u64, n: u64) u64 { if (n >= 64) { ret 0; } ret x >> n; }\n#[noinline] fun differences(x: u64) u64 { var r: u64 = 0; var bit: u64 = 0; for (bit < 128) { if (bit < 64) { r = r ^ (x >> (63 - bit)); } or { r = r ^ (x >> (127 - bit)); } bit = bit + 1; } ret r; }\n#[noinline] fun position(b: u64) u64 { var r: u64 = 0; var i: u64 = 0; for (i < 16) { r = r | (b << ((i & 3) * 16 + (i >> 2) * 4)); i = i + 1; } ret r; }\n#[noinline] fun position_runtime(b: u64, block: u64) u64 { var r: u64 = 0; var i: u64 = 0; for (i < 16) { r = r | (b << ((i & 3) * 16 + (i >> 2) * 4 + block)); i = i + 1; } ret r; }\n";
}

# the variable-count shifts of the ir function named by `suffix`, split into
# those carrying the count-bounded mark and those without it
fun ut_shift_bound_counts(s: *session.Session, m: *ir.Module, suffix: str, bounded: *u32, unbounded: *u32) bool {
    @bounded   = 0;
    @unbounded = 0;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn:   *ir.Function = ?m.functions[fi];
        val name: opt[str]     = intern.lookup(?s.interner, fn.name);
        if (sel name.some) {
            if (ut_str_ends_with(name.some, suffix) && fn.block_count > 0) {
                var bi: u32 = 0;
                for (bi < fn.block_count) {
                    val blk: *ir.Block = ?fn.blocks[bi];
                    var ii:  u32       = 0;
                    for (ii < blk.instr_count) {
                        val ins:   *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
                        val shift: bool                     = ins.kind == instruction.OP_SHL || ins.kind == instruction.OP_SHR_U || ins.kind == instruction.OP_SHR_S;
                        if (shift && ins.operand_count == 2 && ins.operands[1].kind != value.VAL_CONST_INT) {
                            if ((ins.flags & instruction.INSTR_FLAG_COUNT_BOUNDED) != 0) { @bounded = @bounded + 1; }
                            or                                                           { @unbounded = @unbounded + 1; }
                        }
                        ii = ii + 1;
                    }
                    bi = bi + 1;
                }
                ret true;
            }
        }
        fi = fi + 1;
    }
    ret false;
}

fun ut_shift_bound_case(alloc: *A.Allocator, found: pipeline.OptLevel) i32 {
    val sr: res[session.Session, fail.Fail] = session.init(alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    val pr: res[project.Project, outcome.Fail] = ut_vec_lower_opt(?s, alloc, ut_shift_bound_program(), "linux", found);
    if (sel pr.err) { ret 2; }
    var p: project.Project = pr.ok;
    fin { project.dnit_project(?p); }

    var names: [14]str;
    var want:  [14]u32;
    var wantn: [14]u32;
    names[0]  = ".loop_below";
    want[0]   = 1;
    wantn[0]  = 0;
    names[1]  = ".loop_to_width";
    want[1]   = 0;
    wantn[1]  = 1;
    names[2]  = ".loop_inclusive";
    want[2]   = 1;
    wantn[2]  = 0;
    names[3]  = ".loop_inclusive_width";
    want[3]   = 0;
    wantn[3]  = 1;
    names[4]  = ".loop_signed";
    want[4]   = 1;
    wantn[4]  = 0;
    names[5]  = ".loop_narrow";
    want[5]   = 0;
    wantn[5]  = 1;
    names[6]  = ".masked";
    want[6]   = 1;
    wantn[6]  = 0;
    names[7]  = ".unproven";
    want[7]   = 0;
    wantn[7]  = 1;
    names[8]  = ".guarded";
    want[8]   = 1;
    wantn[8]  = 0;
    names[9]  = ".past_guard";
    want[9]   = 0;
    wantn[9]  = 1;
    names[10] = ".failing_arm";
    want[10]  = 1;
    wantn[10] = 0;
    names[11] = ".differences";
    want[11]  = 2;
    wantn[11] = 0;
    names[12] = ".position";
    want[12]  = 1;
    wantn[12] = 0;
    names[13] = ".position_runtime";
    want[13]  = 0;
    wantn[13] = 1;

    var found_all: [14]bool;
    var k:         u32 = 0;
    for (k < 14) {
        found_all[k] = false;
        k            = k + 1;
    }
    var bad: i32 = 0;
    var mi:  u32 = 0;
    for (mi < project.module_count(?p)) {
        val me: *project.ModuleEntry = project.module_at(?p, mi);
        if (me.ir_module != nil) {
            k = 0;
            for (k < 14) {
                var b: u32 = 0;
                var u: u32 = 0;
                if (ut_shift_bound_counts(?s, me.ir_module, names[k], ?b, ?u)) {
                    found_all[k] = true;
                    if (b != want[k] || u != wantn[k]) {
                        print.printf("shift bound: {} has {} bounded and {} unbounded shifts, want {} and {}\n", names[k], b, u, want[k], wantn[k]);
                        bad = 3;
                    }
                }
                k = k + 1;
            }
        }
        mi = mi + 1;
    }
    k = 0;
    for (k < 14) {
        if (!found_all[k]) {
            print.printf("shift bound: {} not found\n", names[k]);
            bad = 4;
        }
        k = k + 1;
    }
    ret bad;
}

test marks_only_a_count_proven_below_the_width {
    var alloc:  A.Allocator;
    val make_r: err[A.Error] = page.make(?alloc);
    if (sel make_r.err) { ret 1; }
    val debug: i32 = ut_shift_bound_case(?alloc, pipeline.OPT_DEBUG);
    if (debug != 0) { ret 10 + debug; }
    val release: i32 = ut_shift_bound_case(?alloc, pipeline.OPT_RELEASE);
    if (release != 0) { ret 20 + release; }
    ret 0;
}
