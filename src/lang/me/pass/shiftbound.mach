# marks every scalar shift whose count the range analysis proves below its
# operand's width, so lowering emits the bare machine shift for it and keeps
# the saturation of #3756 for the rest (#3885). the mark is recomputed from
# scratch on each run: a shift the analysis cannot prove loses one an earlier
# run or an inlined body left on it, so the flag never outlives its proof
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use A: std.allocator;

use mach.lang.me.analysis.loops;
use mach.lang.me.analysis.range;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.scratch;

pub fun run_in(m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var i:       u32  = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.block_count > 0) {
            var work: scratch.Function     = scratch.Function{module: m, body: fn};
            val r:    res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, mark_function);
            if (sel r.err) { ret r; }
            if (r.ok)      { changed = true; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun is_shift(k: instruction.InstrKind) bool {
    ret k == instruction.OP_SHL || k == instruction.OP_SHR_U || k == instruction.OP_SHR_S;
}

# the width of a scalar integer shift, 0 for anything else
fun shift_bits(types: *ir_type.IrTypeTable, ins: *instruction.Instruction) u32 {
    if (!is_shift(ins.kind) || ins.operand_count != 2) { ret 0; }
    val found: opt[*ir_type.IrType] = ir_type.get(types, ins.ty);
    if (sel found.none)                     { ret 0; }
    if (found.some.kind != ir_type.IRT_INT) { ret 0; }
    ret found.some.data.bits;
}

# the analysis is built only for a function that has a shift by a count
# that is not a constant
fun mark_function(work: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:  *ir.Module   = work.module;
    val fn: *ir.Function = work.body;

    var variable: bool = false;
    var bi:       u32  = 0;
    for (bi < fn.block_count && !variable) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            val ins: *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
            if (shift_bits(?m.types, ins) != 0 && ins.operands[1].kind != value.VAL_CONST_INT) { variable = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    var la:       loops.LoopAnalysis;
    var ra:       range.RangeAnalysis;
    var analyzed: bool = false;
    if (variable) {
        val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, alloc);
        if (sel ral.err) { ret res[bool, fail.Fail].err{ral.err}; }
        la = ral.ok;
        val ri: err[fail.Fail] = range.init(?ra, fn, ?m.types, ?la, alloc);
        if (sel ri.err) {
            loops.dnit(?la);
            ret res[bool, fail.Fail].err{ri.err};
        }
        analyzed = true;
    }

    var changed: bool = false;
    bi = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            val ins:    *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
            val bits:   u32                      = shift_bits(?m.types, ins);
            var proven: bool                     = false;
            if (bits != 0) {
                val count: value.Value = ins.operands[1];
                if (count.kind == value.VAL_CONST_INT) { proven = range.constant_range(?m.types, count).hi < bits::u64; }
                or (analyzed)                          { proven = range.below(?ra, count, blk.id, bits::u64); }
            }
            var flags: u16 = ins.flags & (0xFFFF - instruction.INSTR_FLAG_COUNT_BOUNDED);
            if (proven) { flags = flags | instruction.INSTR_FLAG_COUNT_BOUNDED; }
            if (flags != ins.flags) {
                ins.flags = flags;
                changed   = true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    if (analyzed) {
        range.dnit(?ra);
        loops.dnit(?la);
    }
    ret res[bool, fail.Fail].ok{changed};
}
