use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.allocator.page;
use std.crypto.hash.fnv1a;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.float;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;

rec SeenTable {
    bucket: *id.InstructionId;
    stamp:  *u32;
    chain:  *id.InstructionId;
    mask:   u32;
    epoch:  u32;
    len:    u32;
}

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module) res[bool, fail.Fail] {
    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, ?workspace);
}

pub fun run_in(m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var work: scratch.Function = scratch.Function{module: m, body: fn};
            val changed_r: res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, cse_function);
            if (sel changed_r.err) { ret changed_r; }
            if (changed_r.ok) { changed = true; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun cse_function(request: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = request.module;
    val fn: *ir.Function = request.body;
    val ilen: u32 = fn.instr_len;
    if (ilen == 0) { ret res[bool, fail.Fail].ok{false}; }

    var subst: mutate.Rewrite;
    val res_subst: err[fail.Fail] = mutate.rewrite_init(?subst, alloc, ilen);
    if (sel res_subst.err) {
        ret res[bool, fail.Fail].err{res_subst.err};
    }

    var seen: SeenTable;
    val opt_seen: err[fail.Fail] = seen_init(?seen, alloc, ilen);
    if (sel opt_seen.err) {
        mutate.rewrite_dnit(?subst, alloc);
        ret res[bool, fail.Fail].err{opt_seen.err};
    }

    var any: bool = false;
    var i: u32 = 0;
    for (i < fn.block_count) {
        seen_block_begin(?seen);
        if (cse_block(fn, ?fn.blocks[i], ?subst, ?seen)) { any = true; }
        i = i + 1;
    }
    if (any) { mutate.rewrite_apply(fn, ?subst); }

    seen_dnit(?seen, alloc);
    mutate.rewrite_dnit(?subst, alloc);
    ret res[bool, fail.Fail].ok{any};
}

fun cse_block(fn: *ir.Function, blk: *ir.Block, subst: *mutate.Rewrite, seen: *SeenTable) bool {
    var any: bool = false;
    var i: u32 = 0;
    for (i < blk.instr_count) {
        val iid: id.InstructionId = blk.instructions[i];
        val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
        if (sel opt_inst.some) {
            val inst: *instruction.Instruction = opt_inst.some;
            if (is_candidate(inst)) {
                val h: u64 = hash_candidate(inst, subst);
                val idx: u32 = (h::u32) & seen.mask;

                var matched: bool = false;
                var cur: id.InstructionId = seen_head(seen, idx);
                for (cur != id.INSTR_NIL && matched == false) {
                    val opt_cand: opt[*instruction.Instruction] = ir.instruction_get(fn, cur);
                    if (sel opt_cand.some) {
                        val cand: *instruction.Instruction = opt_cand.some;
                        if (instrs_equal(inst, cand, subst)) {
                            mutate.replace_value(subst, iid, value.instr(cur, inst.ty));
                            matched = true;
                            any     = true;
                        }
                    }
                    cur = seen_next(seen, cur);
                }

                if (matched == false) { seen_add(seen, idx, iid); }
            }
        }
        i = i + 1;
    }
    ret any;
}

fun is_candidate(inst: *instruction.Instruction) bool {
    ret effect.cse_safe(inst);
}

fun hash_candidate(inst: *instruction.Instruction, subst: *mutate.Rewrite) u64 {
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, inst.kind::u8);
    h = fnv1a.step_u32(h, inst.flags::u32);
    h = fnv1a.step_u32(h, inst.ty::u32);
    h = fnv1a.step_u32(h, inst.aux_ty::u32);
    h = fnv1a.step_u32(h, inst.operand_count);
    var i: u32 = 0;
    for (i < inst.operand_count) {
        h = hash_value(h, mutate.rewrite_resolve(subst, inst.operands[i]));
        i = i + 1;
    }
    ret h;
}

fun hash_value(h: u64, v: value.Value) u64 {
    var hv: u64 = fnv1a.step_u8(h, v.kind::u8);
    if (v.kind == value.VAL_INSTR)       { ret fnv1a.step_u32(hv, v.data.instr::u32); }
    if (v.kind == value.VAL_PARAM)       { ret fnv1a.step_u32(hv, v.data.param_ix); }
    if (v.kind == value.VAL_CONST_INT)   { ret step_u64(hv, v.data.int_lit); }
    if (v.kind == value.VAL_CONST_FLOAT) { ret step_u64(hv, float.f64_bits(v.data.float_lit)); }
    if (v.kind == value.VAL_GLOBAL)      { ret fnv1a.step_u32(hv, v.data.global_ix); }
    if (v.kind == value.VAL_FN)          { ret fnv1a.step_u32(hv, v.data.fn_ix); }
    ret hv;
}

fun step_u64(h: u64, v: u64) u64 {
    ret fnv1a.step_u32(fnv1a.step_u32(h, v::u32), (v >> 32)::u32);
}

fun instrs_equal(a: *instruction.Instruction, b: *instruction.Instruction, subst: *mutate.Rewrite) bool {
    if (a.kind          != b.kind)          { ret false; }
    if (a.flags         != b.flags)         { ret false; }
    if (a.ty            != b.ty)            { ret false; }
    if (a.aux_ty        != b.aux_ty)        { ret false; }
    if (a.operand_count != b.operand_count) { ret false; }
    var i: u32 = 0;
    for (i < a.operand_count) {
        val va: value.Value = mutate.rewrite_resolve(subst, a.operands[i]);
        val vb: value.Value = mutate.rewrite_resolve(subst, b.operands[i]);
        if (values_equal(va, vb) == false) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun values_equal(a: value.Value, b: value.Value) bool {
    if (a.kind != b.kind)               { ret false; }
    if (a.kind == value.VAL_INSTR)      { ret a.data.instr == b.data.instr; }
    if (a.kind == value.VAL_PARAM)      { ret a.data.param_ix == b.data.param_ix; }
    if (a.kind == value.VAL_CONST_INT)  { ret a.data.int_lit == b.data.int_lit; }
    if (a.kind == value.VAL_CONST_NULL) { ret true; }
    if (a.kind == value.VAL_CONST_FLOAT) {
        ret float.f64_bits(a.data.float_lit) == float.f64_bits(b.data.float_lit);
    }
    if (a.kind == value.VAL_GLOBAL) { ret a.data.global_ix == b.data.global_ix; }
    if (a.kind == value.VAL_FN)     { ret a.data.fn_ix == b.data.fn_ix; }
    ret false;
}

fun round_pow2(n: u32) u32 {
    var p: u32 = 1;
    for (p < n) { p = p * 2; }
    ret p;
}

fun seen_init(s: *SeenTable, a: *A.Allocator, len: u32) err[fail.Fail] {
    val tsize: u32 = round_pow2(len);

    val res_bucket: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](a, tsize::usize);
    if (sel res_bucket.err) {
        ret err[fail.Fail].err{fail.refused(res_bucket.err)};
    }

    val res_stamp: res[*u32, A.Error] = A.allocate[u32](a, tsize::usize);
    if (sel res_stamp.err) {
        A.deallocate[id.InstructionId](a, res_bucket.ok, tsize::usize);
        ret err[fail.Fail].err{fail.refused(res_stamp.err)};
    }

    val res_chain: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](a, len::usize);
    if (sel res_chain.err) {
        A.deallocate[id.InstructionId](a, res_bucket.ok, tsize::usize);
        A.deallocate[u32](a, res_stamp.ok, tsize::usize);
        ret err[fail.Fail].err{fail.refused(res_chain.err)};
    }

    s.bucket = res_bucket.ok;
    s.stamp  = res_stamp.ok;
    s.chain  = res_chain.ok;
    s.mask   = tsize - 1;
    s.epoch  = 0;
    s.len    = len;

    var i: u32 = 0;
    for (i < tsize) { s.stamp[i] = 0; i = i + 1; }
    ret err[fail.Fail].ok{};
}

fun seen_dnit(s: *SeenTable, a: *A.Allocator) {
    val tsize: u32 = s.mask + 1;
    A.deallocate[id.InstructionId](a, s.bucket, tsize::usize);
    A.deallocate[u32](a, s.stamp, tsize::usize);
    A.deallocate[id.InstructionId](a, s.chain, s.len::usize);
    s.bucket = nil;
    s.stamp  = nil;
    s.chain  = nil;
    s.mask   = 0;
    s.epoch  = 0;
    s.len    = 0;
}

fun seen_block_begin(s: *SeenTable) {
    s.epoch = s.epoch + 1;
}

fun seen_head(s: *SeenTable, idx: u32) id.InstructionId {
    if (s.stamp[idx] == s.epoch) { ret s.bucket[idx]; }
    ret id.INSTR_NIL;
}

fun seen_next(s: *SeenTable, iid: id.InstructionId) id.InstructionId {
    ret s.chain[iid::u32];
}

fun seen_add(s: *SeenTable, idx: u32, iid: id.InstructionId) {
    s.chain[iid::u32] = seen_head(s, idx);
    s.bucket[idx]     = iid;
    s.stamp[idx]      = s.epoch;
}

test "mach.lang.me.pass.cse.run:within_block_dedup" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ir.dnit(?m); ret 1; }
    val i64ty: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ir.dnit(?m); ret 1; }
    val fi: u32 = res_fn.ok;
    val fn: *ir.Function = ?m.functions[fi];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_blk_a: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk_a.err) { ir.dnit(?m); ret 1; }
    val blk_a: id.BlockId = res_blk_a.ok;
    val res_blk_b: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk_b.err) { ir.dnit(?m); ret 1; }
    val blk_b: id.BlockId = res_blk_b.ok;

    val p0: value.Value = value.param(0, i64ty);
    val p1: value.Value = value.param(1, i64ty);

    builder.set_block(?bld, blk_a);
    val res_add_1: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add_1.err) { ir.dnit(?m); ret 1; }
    val add_1: value.Value = res_add_1.ok;
    val res_add_2: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add_2.err) { ir.dnit(?m); ret 1; }
    val add_2: value.Value = res_add_2.ok;
    val res_mul: res[value.Value, fail.Fail] = builder.emit_mul(?bld, add_2, p0);
    if (sel res_mul.err) { ir.dnit(?m); ret 1; }
    val mul: value.Value = res_mul.ok;
    val r_296: err[fail.Fail] = builder.emit_br(?bld, blk_b);
    if (sel r_296.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, blk_b);
    val res_add_3: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add_3.err) { ir.dnit(?m); ret 1; }
    val add_3: value.Value = res_add_3.ok;
    val r_302: err[fail.Fail] = builder.emit_ret(?bld, add_3);
    if (sel r_302.err) { ir.dnit(?m); ret 1; }

    val r_304: res[bool, fail.Fail] = run(?m);
    if (sel r_304.err) { ir.dnit(?m); ret 1; }

    val mul_inst: *instruction.Instruction = ?fn.instrs[mul.data.instr];
    val mul_op0: value.Value = mul_inst.operands[0];
    if (mul_op0.kind != value.VAL_INSTR)        { ir.dnit(?m); ret 1; }
    if (mul_op0.data.instr != add_1.data.instr) { ir.dnit(?m); ret 1; }

    val ret_iid: id.InstructionId = fn.blocks[blk_b::u32].terminator;
    val ret_inst: *instruction.Instruction = ?fn.instrs[ret_iid];
    val ret_op0: value.Value = ret_inst.operands[0];
    if (ret_op0.kind != value.VAL_INSTR)        { ir.dnit(?m); ret 1; }
    if (ret_op0.data.instr != add_3.data.instr) { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.pass.cse.run:reports_no_change_when_nothing_is_redundant" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i32t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_entry.ok);

    val p0: value.Value = value.param(0, i32t);
    val p1: value.Value = value.param(1, i32t);
    val res_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add.err) { ir.dnit(?m); ret 1; }
    val r_346: err[fail.Fail] = builder.emit_ret(?bld, res_add.ok);
    if (sel r_346.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) { ir.dnit(?m); ret 1; }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.cse.run:reports_change_when_a_duplicate_expression_is_eliminated" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i32t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_entry.ok);

    val p0: value.Value = value.param(0, i32t);
    val p1: value.Value = value.param(1, i32t);
    val res_a: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_a.err) { ir.dnit(?m); ret 1; }
    val a: value.Value = res_a.ok;
    val res_b: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_b.err) { ir.dnit(?m); ret 1; }
    val b: value.Value = res_b.ok;
    val res_sum: res[value.Value, fail.Fail] = builder.emit_add(?bld, a, b);
    if (sel res_sum.err) { ir.dnit(?m); ret 1; }
    val r_387: err[fail.Fail] = builder.emit_ret(?bld, res_sum.ok);
    if (sel r_387.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) { ir.dnit(?m); ret 1; }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != true) { ret 1; }
    ret 0;
}

# the fail-at-N fixture: a redundant sum in one block, a repeat in another
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 2; }
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[res_fn.ok]);
    val res_a: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_a.err) { ret 3; }
    val res_b: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_b.err) { ret 3; }
    val p0: value.Value = value.param(0, i64t);
    val p1: value.Value = value.param(1, i64t);
    builder.set_block(?bld, res_a.ok);
    val res_add_1: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add_1.err) { ret 4; }
    val res_add_2: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add_2.err) { ret 5; }
    val res_mul: res[value.Value, fail.Fail] = builder.emit_mul(?bld, res_add_2.ok, res_add_1.ok);
    if (sel res_mul.err) { ret 6; }
    val r_br: err[fail.Fail] = builder.emit_br(?bld, res_b.ok);
    if (sel r_br.err) { ret 7; }
    builder.set_block(?bld, res_b.ok);
    val res_add_3: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add_3.err) { ret 8; }
    val res_sum: res[value.Value, fail.Fail] = builder.emit_add(?bld, res_add_3.ok, res_mul.ok);
    if (sel res_sum.err) { ret 9; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, res_sum.ok);
    if (sel r_ret.err) { ret 10; }
    ret 0;
}

fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val r: res[bool, fail.Fail] = run_in(m, workspace);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# every allocation (the rewrite table and the seen table) is scratch and
# precedes the rewrite, so a refusal leaves the input unchanged
test "mach.lang.me.pass.cse.run_in:refusal_at_every_ordinal_leaves_the_input_unchanged" {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: nil, target: nil, control: nil, context: nil};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}
