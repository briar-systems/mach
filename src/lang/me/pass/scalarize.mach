test "mach.lang.me.pass.scalarize.resolve:deliberately_retypes_to_the_slot_pointer_not_the_use_site_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val res_e: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel res_e.err) { ir.dnit(?m); ret 1; }
    val elem: ir_type.IrTypeId = res_e.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem, 4);
    if (sel res_v.err) { ir.dnit(?m); ret 1; }
    val vec: ir_type.IrTypeId = res_v.ok;
    val res_p: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel res_p.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = res_p.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_blk.ok);

    val pv: value.Value = value.param(0, vec);
    val r_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, pv, pv);
    if (sel r_add.err) { ir.dnit(?m); ret 1; }
    val add_id: u32 = r_add.ok.data.instr::u32;

    var pval: [1]value.Value;
    var pval_set: [1]bool;
    pval[0]     = value.instr(add_id::id.InstructionId, ptrt);
    pval_set[0] = true;

    var c: Ctx;
    c.pval     = ?pval[0];
    c.pval_set = ?pval_set[0];
    c.n        = 1;
    c.is_vp    = nil;
    c.pcount   = 0;
    c.ptr_ty   = ptrt;

    val use_site: value.Value = value.instr(add_id::id.InstructionId, vec);
    val out: value.Value = resolve(?c, use_site);

    var bad: i32 = 0;
    if (out.ty != ptrt) { bad = 1; }
    if (out.ty == vec)  { bad = 2; }

    ir.dnit(?m);
    ret bad;
}


test "mach.lang.me.pass.scalarize:rejected_work_does_not_retain_maps_in_ir" {
    var backing: A.Allocator;
    val r_1853: err[A.Error] = page.make(?backing);
    if (sel r_1853.err) { ret 1; }
    var owner: arena.Arena;
    val r_1855: err[A.Error] = arena.init(?owner, ?backing, 0);
    if (sel r_1855.err) { ret 1; }
    fin { arena.dnit(?owner); }
    var alloc: A.Allocator;
    val r_1858: err[A.Error] = arena.make(?alloc, ?owner);
    if (sel r_1858.err) { ret 1; }
    var module: ir.Module;
    if (!vec_binop_module(?alloc, instruction.OP_ADD, 32, 4, ?module)) { ret 1; }
    fin { ir.dnit(?module); }
    val fn: *ir.Function = ?module.functions[0];
    fn.instrs[0].kind = instruction.OP_SHL;
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    val r_1866: err[fail.Fail] = target.register_all(?registry, target_testing.debug_descriptor);
    if (sel r_1866.err) { ret 1; }
    var tgt: target.Target;
    if (!test_target(?registry, "riscv64", ?tgt)) { ret 1; }
    var work: FunctionWork = FunctionWork{module: ?module, body: fn, target: ?tgt,
        void_ty: ir_type.IRT_NIL, ptr_ty: ir_type.IRT_NIL, idx_ty: ir_type.IRT_NIL, i8_ty: ir_type.IRT_NIL};
    val chunk: *arena.Chunk = owner.chunk;
    val offset: usize = owner.off;
    var workspace: scratch.Workspace;
    val r_1874: err[fail.Fail] = scratch.init(?workspace);
    if (sel r_1874.err) { ret 1; }
    val rejected: err[fail.Fail] = scratch.run_unit[FunctionWork](?workspace, ?backing, ?work, scalarize_work);
    scratch.dnit(?workspace);
    if (sel rejected.ok) { ret 2; }
    val reason: str = fail.describe(rejected.err);
    fin { str_free(?backing, reason); }
    if (!str_contains(reason, "vector operator is not")) { ret 3; }
    if (owner.chunk != chunk || owner.off != offset) { ret 4; }
    if (fn.instr_len != 1 || fn.instrs[0].kind != instruction.OP_SHL) { ret 5; }
    ret 0;
}


test "mach.lang.me.pass.scalarize:failed_instruction_releases_untransferred_operands" {
    var tracking: T.Testing;
    val r_1889: err[A.Error] = T.make(?tracking);
    if (sel r_1889.err) { ret 1; }
    fin { T.dnit(?tracking); }
    val initialized: res[ir.Module, fail.Fail] = ir.init(?tracking.a, intern.STR_NIL);
    if (sel initialized.err) { ret 1; }
    var module: ir.Module = initialized.ok;
    fin { ir.dnit(?module); }
    var fn: ir.Function = ir.function_new(?tracking.a, intern.STR_NIL, ir_type.IRT_NIL, 0);
    fin { ir.function_dnit(?module, ?fn); }
    val live: usize = tracking.live;
    tracking.fail_at = tracking.attempts + 2;
    var operands: [1]value.Value;
    operands[0] = value.const_int(7, ir_type.IRT_NIL);
    val inserted: res[id.InstructionId, fail.Fail] = new_instr(?module, ?fn, instruction.OP_RET,
        ir_type.IRT_NIL, ir_type.IRT_NIL, ?operands[0], 1, source.loc(source.FILE_NIL, 0));
    if (sel inserted.ok) { ret 2; }
    if (tracking.live != live || tracking.double_frees != 0) { ret 3; }
    if (tracking.attempts != tracking.fail_at || fn.instr_len != 0) { ret 4; }
    ret 0;
}

fun test_external_parameter(fn: *ir.Function, v: value.Value) u32 {
    var current: value.Value = v;
    var left: u32 = fn.instr_len;
    for (left > 0 && current.kind == value.VAL_INSTR) {
        val ix: u32 = current.data.instr::u32;
        if (ix >= fn.instr_len || fn.instrs[ix].kind != instruction.OP_GEP) { ret 0; }
        current = fn.instrs[ix].operands[0];
        left = left - 1;
    }
    if (current.kind == value.VAL_PARAM) { ret current.data.param_ix + 1; }
    ret 0;
}

fun test_volatile_division(alloc: *A.Allocator, reg: *target.TargetRegistry, arch: str) i32 {
    var tgt: target.Target;
    if (!test_target(reg, arch, ?tgt)) { ret 1; }
    val mr: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) { ret 2; }
    var m: ir.Module = mr.ok;
    fin { ir.dnit(?m); }
    val pr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    val er: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    val vr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel pr.err) { ret 3; }
    if (sel er.err) { ret 3; }
    if (sel vr.err) { ret 3; }
    val pt: ir_type.IrTypeId = pr.ok;
    val elem: ir_type.IrTypeId = er.ok;
    val vty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem, 4);
    if (sel vty.err) { ret 4; }
    val vec: ir_type.IrTypeId = vty.ok;
    val fr: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel fr.err) { ret 5; }
    val fn: *ir.Function = ?m.functions[fr.ok];
    val args: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, 4);
    if (sel args.err) { ret 6; }
    fn.params = args.ok;
    fn.param_count = 4;
    var i: u32 = 0;
    for (i < 4) { fn.params[i] = value.param(i, pt); i = i + 1; }
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val br: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel br.err) { ret 7; }
    val bid: id.BlockId = br.ok;
    builder.set_block(?b, bid);
    val blk: *ir.Block = ?fn.blocks[bid::u32];
    var c: Ctx = Ctx{alloc: alloc, m: ?m, fn: fn, ptr_ty: pt,
        void_ty: vr.ok};
    val loc: source.SrcLoc = source.loc(source.FILE_NIL, 0);
    val scalar: res[value.Value, fail.Fail] = emit_load(?c, blk, value.param(3, pt), elem, loc, instruction.INSTR_FLAG_VOLATILE);
    val lhs: res[value.Value, fail.Fail] = emit_load(?c, blk, value.param(0, pt), vec, loc, instruction.INSTR_FLAG_VOLATILE);
    val rhs: res[value.Value, fail.Fail] = emit_load(?c, blk, value.param(1, pt), vec, loc, instruction.INSTR_FLAG_VOLATILE);
    if (sel scalar.err) { ret 8; }
    if (sel lhs.err) { ret 8; }
    if (sel rhs.err) { ret 8; }
    val q: res[value.Value, fail.Fail] = emit_binop(?c, blk, instruction.OP_DIV_S, vec,
        lhs.ok, rhs.ok, loc);
    if (sel q.err) { ret 9; }
    val r_1968: err[fail.Fail] = emit_store(?c, blk, q.ok, value.param(2, pt), loc, instruction.INSTR_FLAG_VOLATILE);
    if (sel r_1968.err) { ret 10; }
    val r_1969: err[fail.Fail] = emit_store(?c, blk, scalar.ok, value.param(3, pt), loc, instruction.INSTR_FLAG_VOLATILE);
    if (sel r_1969.err) { ret 11; }
    val r_1970: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_1970.err) { ret 12; }
    var site: ScalarizeSite;
    if (detect(?m, ?tgt, ?site) != 1 || site.op != instruction.OP_DIV_S) { ret 13; }
    val r_1973: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel r_1973.err) { ret 14; }
    val r_1974: res[bool, fail.Fail] = expand_gap_ops(?m, ?tgt);
    if (sel r_1974.err) { ret 14; }
    val r_1975: res[bool, fail.Fail] = expand_lane_ops(?m, ?tgt);
    if (sel r_1975.err) { ret 14; }
    val body: *ir.Function = ?m.functions[0];
    val block: *ir.Block = ?body.blocks[bid::u32];
    var counts: [4]u32 = [4]u32{0, 0, 0, 0};
    var divisions: u32 = 0;
    var phase: u32 = 0;
    var accesses: u32 = 1;
    if (!tgt.model.has_v128) { accesses = 4; }
    i = 0;
    for (i < block.instr_count) {
        val inst: *instruction.Instruction = ?body.instrs[block.instructions[i]::u32];
        if (inst.kind == instruction.OP_DIV_S || inst.kind == instruction.OP_DIV_U) {
            if (inst.kind != instruction.OP_DIV_S || inst.ty != elem || inst.operands[0].ty != elem
                || inst.operands[1].ty != elem || counts[0] != accesses || counts[1] != accesses || counts[2] != 0) { ret 15; }
            divisions = divisions + 1;
        }
        if (inst.kind == instruction.OP_LOAD || inst.kind == instruction.OP_STORE) {
            var pointer: value.Value = inst.operands[0];
            var memory_type: ir_type.IrTypeId = inst.ty;
            if (inst.kind == instruction.OP_STORE) { pointer = inst.operands[1]; memory_type = inst.operands[0].ty; }
            val owner: u32 = test_external_parameter(body, pointer);
            if (owner == 0) {
                if (effect.is_volatile(inst)) { ret 16; }
            }
            or {
                if (owner > 4 || !effect.is_volatile(inst)) { ret 17; }
                counts[owner - 1] = counts[owner - 1] + 1;
                if (owner == 4) {
                    if (memory_type != elem) { ret 18; }
                    if (counts[3] == 1 && (phase != 0 || inst.kind != instruction.OP_LOAD)) { ret 19; }
                    if (counts[3] == 2 && (phase != 3 || inst.kind != instruction.OP_STORE)) { ret 20; }
                }
                or {
                    if (counts[3] != 1 || owner < phase) { ret 21; }
                    phase = owner;
                    val want_store: bool = owner == 3;
                    if ((inst.kind == instruction.OP_STORE) != want_store) { ret 22; }
                    if (want_store && divisions != 4) { ret 23; }
                    if (accesses == 1 && memory_type != vec) { ret 24; }
                    if (accesses == 4 && memory_type != elem) { ret 25; }
                }
            }
        }
        i = i + 1;
    }
    if (divisions != 4 || counts[0] != accesses || counts[1] != accesses
        || counts[2] != accesses || counts[3] != 2) { ret 26; }
    ret 0;
}

test "mach.lang.me.pass.scalarize:division_preserves_external_volatile_accesses" {
    var alloc: A.Allocator;
    val r_2027: err[A.Error] = page.make(?alloc);
    if (sel r_2027.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_2030: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_2030.err) { ret 2; }
    val x64: i32 = test_volatile_division(?alloc, ?reg, "x86_64");
    if (x64 != 0) { ret x64; }
    val arm: i32 = test_volatile_division(?alloc, ?reg, "aarch64");
    if (arm != 0) { ret arm; }
    ret test_volatile_division(?alloc, ?reg, "riscv64");
}
