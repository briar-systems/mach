use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.allocator.page;
use std.allocator.arena;
use std.text.string.str_free;
use std.types.string.str_contains;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;
use mach.lang.target;
use mach.lang.target.isa;
use target_testing: mach.lang.target.testing;
use mach.lang.me.vecform;

rec FunctionWork {
    module: *ir.Module;
    body: *ir.Function;
    target: *target.Target;
    void_ty: ir_type.IrTypeId;
    ptr_ty: ir_type.IrTypeId;
    idx_ty: ir_type.IrTypeId;
    i8_ty: ir_type.IrTypeId;
}

rec Ctx {
    alloc:    *A.Allocator;
    m:        *ir.Module;
    fn:       *ir.Function;
    tgt:      *target.Target;
    pval:     *value.Value;
    pval_set: *bool;
    n:        u32;
    is_vp:    *bool;
    pcount:   u32;
    void_ty:  ir_type.IrTypeId;
    ptr_ty:   ir_type.IrTypeId;
    idx_ty:   ir_type.IrTypeId;
    lane_buf: *value.Value;
    lane_cap: u32;
}

fun lane_scratch(c: *Ctx, n: u32) res[*value.Value, fail.Fail] {
    if (c.lane_buf != nil && c.lane_cap >= n) { ret res[*value.Value, fail.Fail].ok{c.lane_buf}; }
    if (c.lane_buf != nil) {
        A.deallocate[value.Value](c.alloc, c.lane_buf, c.lane_cap::usize);
        c.lane_buf = nil;
        c.lane_cap = 0;
    }
    val rb: res[*value.Value, A.Error] = A.allocate[value.Value](c.alloc, n::usize);
    if (sel rb.err) { ret res[*value.Value, fail.Fail].err{fail.refused(rb.err)}; }
    c.lane_buf = rb.ok;
    c.lane_cap = n;
    ret res[*value.Value, fail.Fail].ok{c.lane_buf};
}

fun mem_image(c: *Ctx, ty: ir_type.IrTypeId) bool {
    ret !vecform.holds_in_register(c.m, c.tgt, ty);
}

rec VInfo {
    elem:  ir_type.IrTypeId;
    lanes: u32;
    bits:  u32;
}

fun is_binary_op(k: instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_BINARY;
}


fun is_unary_op(k: instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_UNARY;
}


fun is_disallowed_op(k: instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_DISALLOWED;
}


fun is_compare_op(k: instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_COMPARE;
}


fun is_operator(m: *ir.Module, inst: *instruction.Instruction) bool {
    if (!ir_type.is_vector(?m.types, inst.ty)) { ret false; }
    ret is_binary_op(inst.kind) || is_unary_op(inst.kind) || is_compare_op(inst.kind);
}

fun is_vector_bitcast(c: *Ctx, inst: *instruction.Instruction) bool {
    if (inst.kind != instruction.OP_BITCAST) { ret false; }
    if (inst.operand_count < 1)              { ret false; }
    if (!mem_image(c, inst.ty))              { ret false; }
    ret ir_type.is_vector(?c.m.types, inst.operands[0].ty);
}

fun produces_vector(c: *Ctx, inst: *instruction.Instruction) bool {
    if (!mem_image(c, inst.ty)) { ret false; }
    ret is_binary_op(inst.kind) || is_unary_op(inst.kind) || is_compare_op(inst.kind)
        || inst.kind == instruction.OP_DECLASSIFY || inst.kind == instruction.OP_LOAD
        || inst.kind == instruction.OP_VEC_INSERT;
}

pub rec ScalarizeSite {
    fn_name:   intern.StrId;
    op:        instruction.InstrKind;
    lane_bits: u32;
    lanes:     u32;
}

# operators the target scalarizes (declared scalar rows, lane counts past the
# register, and undeclared shapes alike), with the first site named
pub fun detect(m: *ir.Module, tgt: *target.Target, first: *ScalarizeSite) u32 {
    ret detect_sites(m, tgt, first, false);
}

# operators whose lane shape the target's catalog names neither packed nor scalar
pub fun detect_undeclared(m: *ir.Module, tgt: *target.Target, first: *ScalarizeSite) u32 {
    ret detect_sites(m, tgt, first, true);
}

fun detect_sites(m: *ir.Module, tgt: *target.Target, first: *ScalarizeSite, undeclared_only: bool) u32 {
    var count: u32 = 0;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var bi: u32 = 0;
            for (bi < fn.block_count) {
                val blk: *ir.Block = ?fn.blocks[bi];
                var ii: u32 = 0;
                for (ii < blk.instr_count) {
                    val inst: *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
                    var hit: bool = false;
                    if (is_operator(m, inst)) {
                        if (undeclared_only) { hit = vecform.decide(m, tgt, inst) == isa.FORM_UNDECLARED; }
                        or { hit = !vecform.realizes_packed(m, tgt, inst); }
                    }
                    if (hit) {
                        if (count == 0) {
                            first.fn_name   = fn.name;
                            first.op        = inst.kind;
                            first.lane_bits = 0;
                            first.lanes     = 0;
                            var d: vecform.LaneDesc;
                            if (vecform.lane_desc(m, inst, ?d)) {
                                first.lane_bits = d.lane_bits;
                                first.lanes     = d.lanes;
                            }
                        }
                        count = count + 1;
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
        }
        fi = fi + 1;
    }
    ret count;
}

fun vec_info(m: *ir.Module, vty: ir_type.IrTypeId, out: *VInfo) err[fail.Fail] {
    val opt_v: opt[*ir_type.IrType] = ir_type.get(?m.types, vty);
    if (sel opt_v.none) { ret err[fail.Fail].err{fail.message("scalarize: operand is not a resolvable IR type")}; }
    val vt: *ir_type.IrType = opt_v.some;
    if (vt.kind != ir_type.IRT_VECTOR) { ret err[fail.Fail].err{fail.message("scalarize: expected an IR vector type")}; }
    out.elem  = vt.data.vector_.element;
    out.lanes = vt.data.vector_.lanes;

    val opt_e: opt[*ir_type.IrType] = ir_type.get(?m.types, vt.data.vector_.element);
    if (sel opt_e.none) { ret err[fail.Fail].err{fail.message("scalarize: vector element type not resolvable")}; }
    out.bits = opt_e.some.data.bits;
    ret err[fail.Fail].ok{};
}

fun new_instr(m: *ir.Module, fn: *ir.Function, kind: instruction.InstrKind, ty: ir_type.IrTypeId,
              aux: ir_type.IrTypeId, ops: *value.Value, opn: u32, loc: source.SrcLoc) res[id.InstructionId, fail.Fail] {
    var owned: *value.Value = nil;
    if (opn > 0) {
        val ro: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, opn::usize);
        if (sel ro.err) { ret res[id.InstructionId, fail.Fail].err{fail.refused(ro.err)}; }
        owned = ro.ok;
        var i: u32 = 0;
        for (i < opn) { owned[i] = ops[i]; i = i + 1; }
    }
    var ins: instruction.Instruction;
    ins.kind          = kind;
    ins.ty            = ty;
    ins.operands      = owned;
    ins.operand_count = opn;
    ins.operand_cap   = opn;
    ins.flags         = 0;
    ins.aux_ty        = aux;
    ins.loc           = loc;
    ins.secret        = false;
    val added: res[id.InstructionId, fail.Fail] = ir.instruction_add(m, fn, ins);
    if (sel added.err && owned != nil) {
        A.deallocate[value.Value](m.alloc, owned, opn::usize);
    }
    ret added;
}

fun push(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, ty: ir_type.IrTypeId,
         aux: ir_type.IrTypeId, ops: *value.Value, opn: u32, loc: source.SrcLoc) res[value.Value, fail.Fail] {
    val ri: res[id.InstructionId, fail.Fail] = new_instr(c.m, c.fn, kind, ty, aux, ops, opn, loc);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    val iid: id.InstructionId = ri.ok;
    val rl: err[fail.Fail] = ir.block_append_instr(c.m, blk, iid);
    if (sel rl.err) { ret res[value.Value, fail.Fail].err{rl.err}; }
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

fun lane_ptr(c: *Ctx, blk: *ir.Block, base: value.Value, arr_ty: ir_type.IrTypeId, k: u32, loc: source.SrcLoc) res[value.Value, fail.Fail] {
    var ops: [3]value.Value;
    ops[0] = base;
    ops[1] = value.const_int(0, c.idx_ty);
    ops[2] = value.const_int(k::u64, c.idx_ty);
    ret push(c, blk, instruction.OP_GEP, c.ptr_ty, arr_ty, ?ops[0], 3, loc);
}

fun emit_load(c: *Ctx, blk: *ir.Block, ptr: value.Value, elem_ty: ir_type.IrTypeId, loc: source.SrcLoc, flags: u16) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = ptr;
    val r: res[value.Value, fail.Fail] = push(c, blk, instruction.OP_LOAD, elem_ty, ir_type.IRT_NIL, ?ops[0], 1, loc);
    if (sel r.ok) { c.fn.instrs[r.ok.data.instr::u32].flags = flags; }
    ret r;
}

fun emit_store(c: *Ctx, blk: *ir.Block, v: value.Value, ptr: value.Value, loc: source.SrcLoc, flags: u16) err[fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = v;
    ops[1] = ptr;
    val r: res[value.Value, fail.Fail] = push(c, blk, instruction.OP_STORE, c.void_ty, ir_type.IRT_NIL, ?ops[0], 2, loc);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    c.fn.instrs[r.ok.data.instr::u32].flags = flags;
    ret err[fail.Fail].ok{};
}

fun lane_secret(c: *Ctx, loaded: value.Value, src_secret: bool) value.Value {
    if (!src_secret) { ret loaded; }
    var v: value.Value = loaded;
    v.secret = true;
    instruction.mark_result_secret(c.fn.instrs, c.fn.instr_len, v);
    ret v;
}

fun emit_binop(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, ty: ir_type.IrTypeId, a: value.Value, b: value.Value, loc: source.SrcLoc) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = a;
    ops[1] = b;
    ret push(c, blk, kind, ty, ir_type.IRT_NIL, ?ops[0], 2, loc);
}

fun emit_unop(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, ty: ir_type.IrTypeId, a: value.Value, loc: source.SrcLoc) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = a;
    ret push(c, blk, kind, ty, ir_type.IRT_NIL, ?ops[0], 1, loc);
}

fun resolve(c: *Ctx, v: value.Value) value.Value {
    if (v.kind == value.VAL_INSTR) {
        val iid: u32 = v.data.instr::u32;
        if (iid < c.n && c.pval_set[iid]) { ret c.pval[iid]; }
        ret v;
    }
    if (v.kind == value.VAL_PARAM) {
        val p: u32 = v.data.param_ix;
        if (p < c.pcount && c.is_vp[p]) { ret value.param(p, c.ptr_ty); }
        ret v;
    }
    ret v;
}

fun rewrite_ops(c: *Ctx, inst: *instruction.Instruction) {
    var i: u32 = 0;
    for (i < inst.operand_count) {
        inst.operands[i] = resolve(c, inst.operands[i]);
        i = i + 1;
    }
}

fun expand_binary(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, dst: value.Value, a: value.Value, b: value.Value, a_secret: bool, b_secret: bool, vi: VInfo, loc: source.SrcLoc) err[fail.Fail] {
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val pa: res[value.Value, fail.Fail] = lane_ptr(c, blk, a, arr, k, loc);
        if (sel pa.err) { ret err[fail.Fail].err{pa.err}; }
        val va: res[value.Value, fail.Fail] = emit_load(c, blk, pa.ok, vi.elem, loc, 0);
        if (sel va.err) { ret err[fail.Fail].err{va.err}; }

        val pb: res[value.Value, fail.Fail] = lane_ptr(c, blk, b, arr, k, loc);
        if (sel pb.err) { ret err[fail.Fail].err{pb.err}; }
        val vb: res[value.Value, fail.Fail] = emit_load(c, blk, pb.ok, vi.elem, loc, 0);
        if (sel vb.err) { ret err[fail.Fail].err{vb.err}; }

        val va_v: value.Value = lane_secret(c, va.ok, a_secret);
        val vb_v: value.Value = lane_secret(c, vb.ok, b_secret);
        val vr: res[value.Value, fail.Fail] = emit_binop(c, blk, kind, vi.elem, va_v, vb_v, loc);
        if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }

        val pr: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr, k, loc);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, vr.ok, pr.ok, loc, 0);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_unary(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, dst: value.Value, a: value.Value, a_secret: bool, vi: VInfo, loc: source.SrcLoc) err[fail.Fail] {
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val pa: res[value.Value, fail.Fail] = lane_ptr(c, blk, a, arr, k, loc);
        if (sel pa.err) { ret err[fail.Fail].err{pa.err}; }
        val va: res[value.Value, fail.Fail] = emit_load(c, blk, pa.ok, vi.elem, loc, 0);
        if (sel va.err) { ret err[fail.Fail].err{va.err}; }

        val va_v: value.Value = lane_secret(c, va.ok, a_secret);
        val vr: res[value.Value, fail.Fail] = emit_unop(c, blk, kind, vi.elem, va_v, loc);
        if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }

        val pr: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr, k, loc);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, vr.ok, pr.ok, loc, 0);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_compare(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, dst: value.Value, a: value.Value, b: value.Value,
                   op: VInfo, mask: VInfo, i8_ty: ir_type.IrTypeId, loc: source.SrcLoc) err[fail.Fail] {
    val rao: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, op.elem, op.lanes);
    if (sel rao.err) { ret err[fail.Fail].err{rao.err}; }
    val arr_op: ir_type.IrTypeId = rao.ok;
    val ram: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, mask.elem, mask.lanes);
    if (sel ram.err) { ret err[fail.Fail].err{ram.err}; }
    val arr_mask: ir_type.IrTypeId = ram.ok;

    val need_sext: bool = (kind == instruction.OP_CMP_LT_S || kind == instruction.OP_CMP_LE_S) && op.bits < 32;
    var ext_ty: ir_type.IrTypeId = ir_type.IRT_NIL;
    if (need_sext) {
        val rx: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?c.m.types, 32);
        if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
        ext_ty = rx.ok;
    }

    var k: u32 = 0;
    for (k < op.lanes) {
        val pa: res[value.Value, fail.Fail] = lane_ptr(c, blk, a, arr_op, k, loc);
        if (sel pa.err) { ret err[fail.Fail].err{pa.err}; }
        val va: res[value.Value, fail.Fail] = emit_load(c, blk, pa.ok, op.elem, loc, 0);
        if (sel va.err) { ret err[fail.Fail].err{va.err}; }

        val pb: res[value.Value, fail.Fail] = lane_ptr(c, blk, b, arr_op, k, loc);
        if (sel pb.err) { ret err[fail.Fail].err{pb.err}; }
        val vb: res[value.Value, fail.Fail] = emit_load(c, blk, pb.ok, op.elem, loc, 0);
        if (sel vb.err) { ret err[fail.Fail].err{vb.err}; }

        var la: value.Value = va.ok;
        var lb: value.Value = vb.ok;
        if (need_sext) {
            val sa: res[value.Value, fail.Fail] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, la, loc);
            if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
            la = sa.ok;
            val sb: res[value.Value, fail.Fail] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, lb, loc);
            if (sel sb.err) { ret err[fail.Fail].err{sb.err}; }
            lb = sb.ok;
        }

        val cmp: res[value.Value, fail.Fail] = emit_binop(c, blk, kind, i8_ty, la, lb, loc);
        if (sel cmp.err) { ret err[fail.Fail].err{cmp.err}; }
        var wide: value.Value = cmp.ok;

        if (mask.bits != 8) {
            val z: res[value.Value, fail.Fail] = emit_unop(c, blk, instruction.OP_ZEXT, mask.elem, wide, loc);
            if (sel z.err) { ret err[fail.Fail].err{z.err}; }
            wide = z.ok;
        }

        val neg: res[value.Value, fail.Fail] = emit_binop(c, blk, instruction.OP_SUB, mask.elem, value.const_int(0, mask.elem), wide, loc);
        if (sel neg.err) { ret err[fail.Fail].err{neg.err}; }

        val pr: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr_mask, k, loc);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, neg.ok, pr.ok, loc, 0);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun copy_vector(c: *Ctx, blk: *ir.Block, dst: value.Value, src: value.Value, vi: VInfo, loc: source.SrcLoc, read_flags: u16, write_flags: u16) err[fail.Fail] {
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val ps: res[value.Value, fail.Fail] = lane_ptr(c, blk, src, arr, k, loc);
        if (sel ps.err) { ret err[fail.Fail].err{ps.err}; }
        val v: res[value.Value, fail.Fail] = emit_load(c, blk, ps.ok, vi.elem, loc, read_flags);
        if (sel v.err) { ret err[fail.Fail].err{v.err}; }

        val pd: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr, k, loc);
        if (sel pd.err) { ret err[fail.Fail].err{pd.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, v.ok, pd.ok, loc, write_flags);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun make_slot(c: *Ctx, vty: ir_type.IrTypeId, slots: *id.InstructionId, slot_len: *u32) res[value.Value, fail.Fail] {
    var vi: VInfo;
    val vr: err[fail.Fail] = vec_info(c.m, vty, ?vi);
    if (sel vr.err) { ret res[value.Value, fail.Fail].err{vr.err}; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret res[value.Value, fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var ops: [1]value.Value;
    ops[0] = value.const_int(1, c.idx_ty);
    val ri: res[id.InstructionId, fail.Fail] = new_instr(c.m, c.fn, instruction.OP_ALLOCA, c.ptr_ty, arr, ?ops[0], 1, source.loc(source.FILE_NIL, 0));
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    val iid: id.InstructionId = ri.ok;
    slots[@slot_len] = iid;
    @slot_len = @slot_len + 1;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, c.ptr_ty)};
}

fun retype_aux(c: *Ctx, inst: *instruction.Instruction) err[fail.Fail] {
    if (inst.aux_ty == ir_type.IRT_NIL) { ret err[fail.Fail].ok{}; }
    if (!mem_image(c, inst.aux_ty)) { ret err[fail.Fail].ok{}; }
    var vi: VInfo;
    val vr: err[fail.Fail] = vec_info(c.m, inst.aux_ty, ?vi);
    if (sel vr.err) { ret vr; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    inst.aux_ty = ra.ok;
    ret err[fail.Fail].ok{};
}

fun scalarize_function(c: *Ctx, i8_ty: ir_type.IrTypeId) err[fail.Fail] {
    val fn: *ir.Function = c.fn;

    var slots:    *id.InstructionId = nil;
    var slot_len: u32 = 0;
    if (c.n > 0) {
        val rs: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](c.alloc, c.n::usize);
        if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
        slots = rs.ok;
    }

    var iid: u32 = 0;
    for (iid < c.n) {
        val inst: *instruction.Instruction = ?fn.instrs[iid];
        if (mem_image(c, inst.ty) && is_disallowed_op(inst.kind)) {
            slots_free(c, slots);
            ret err[fail.Fail].err{fail.message("scalarize: vector operator is not in the increment-1 table (shift / remainder / negate)")};
        }
        if (inst.kind == instruction.OP_BITCAST && inst.operand_count >= 1
            && mem_image(c, inst.ty)
            && !ir_type.is_vector(?c.m.types, inst.operands[0].ty)) {
            slots_free(c, slots);
            ret err[fail.Fail].err{fail.message("scalarize: a bit reinterpret into a vector from a non-vector type is not expanded on a target without SIMD")};
        }
        if (inst.kind == instruction.OP_ALLOCA || inst.kind == instruction.OP_GEP) {
            val rr: err[fail.Fail] = retype_aux(c, inst);
            if (sel rr.err) { slots_free(c, slots); ret rr; }
        } or (produces_vector(c, inst)) {
            val vty: ir_type.IrTypeId = inst.ty;
            val ms: res[value.Value, fail.Fail] = make_slot(c, vty, slots, ?slot_len);
            if (sel ms.err) { slots_free(c, slots); ret err[fail.Fail].err{ms.err}; }
            c.pval[iid]     = ms.ok;
            c.pval_set[iid] = true;
        } or (inst.kind == instruction.OP_PHI && mem_image(c, inst.ty)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        } or (inst.kind == instruction.OP_CALL && mem_image(c, inst.ty)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        } or (is_vector_bitcast(c, inst)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        }
        iid = iid + 1;
    }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        val rf: err[fail.Fail] = fill_block(c, blk, bi == 0, slots, slot_len, i8_ty);
        if (sel rf.err) { slots_free(c, slots); ret rf; }
        bi = bi + 1;
    }

    rewrite_uses(c, fn);

    slots_free(c, slots);
    ret err[fail.Fail].ok{};
}

fun slots_free(c: *Ctx, slots: *id.InstructionId) {
    if (slots != nil && c.n > 0) {
        A.deallocate[id.InstructionId](c.alloc, slots, c.n::usize);
    }
}

fun fill_block(c: *Ctx, blk: *ir.Block, is_entry: bool, slots: *id.InstructionId, slot_len: u32, i8_ty: ir_type.IrTypeId) err[fail.Fail] {
    val old_len: u32 = blk.instr_count;
    var old: *id.InstructionId = nil;
    if (old_len > 0) {
        val ro: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](c.alloc, old_len::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        old = ro.ok;
        var i: u32 = 0;
        for (i < old_len) { old[i] = blk.instructions[i]; i = i + 1; }
    }
    blk.instr_count = 0;

    if (is_entry) {
        var s: u32 = 0;
        for (s < slot_len) {
            val ra: err[fail.Fail] = ir.block_append_instr(c.m, blk, slots[s]);
            if (sel ra.err) { body_free(c, old, old_len); ret ra; }
            s = s + 1;
        }
    }

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur: id.InstructionId = old[oi];
        val rr: err[fail.Fail] = fill_one(c, blk, cur, i8_ty);
        if (sel rr.err) { body_free(c, old, old_len); ret rr; }
        oi = oi + 1;
    }

    body_free(c, old, old_len);
    ret err[fail.Fail].ok{};
}

fun body_free(c: *Ctx, old: *id.InstructionId, old_len: u32) {
    if (old != nil && old_len > 0) {
        A.deallocate[id.InstructionId](c.alloc, old, old_len::usize);
    }
}

fun expand_lane_read_scalarized(c: *Ctx, blk: *ir.Block, cur: id.InstructionId) err[fail.Fail] {
    val ip: *instruction.Instruction = ?c.fn.instrs[cur::u32];
    val src_ty: ir_type.IrTypeId = ip.operands[0].ty;
    val elem:   ir_type.IrTypeId = ip.ty;
    val loc:    source.SrcLoc    = ip.loc;
    val secret: bool             = ip.operands[0].secret;

    if (ip.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("scalarize: vector lane index is not a constant")};
    }
    val k: u32 = ip.operands[1].data.int_lit::u32;
    val base: value.Value = resolve(c, ip.operands[0]);

    var vi: VInfo;
    val rv: err[fail.Fail] = vec_info(c.m, src_ty, ?vi);
    if (sel rv.err) { ret rv; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }

    val rp: res[value.Value, fail.Fail] = lane_ptr(c, blk, base, ra.ok, k, loc);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    val rl: res[value.Value, fail.Fail] = emit_load(c, blk, rp.ok, elem, loc, 0);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }

    c.pval[cur::u32]     = lane_secret(c, rl.ok, secret);
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun expand_lane_write_scalarized(c: *Ctx, blk: *ir.Block, cur: id.InstructionId) err[fail.Fail] {
    val ip: *instruction.Instruction = ?c.fn.instrs[cur::u32];
    val vty: ir_type.IrTypeId = ip.ty;
    val loc: source.SrcLoc    = ip.loc;

    if (ip.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("scalarize: vector lane index is not a constant")};
    }
    val k: u32 = ip.operands[1].data.int_lit::u32;
    val dst: value.Value = c.pval[cur::u32];
    val src: value.Value = resolve(c, ip.operands[0]);
    val lane_val: value.Value = resolve(c, ip.operands[2]);

    var vi: VInfo;
    val rv: err[fail.Fail] = vec_info(c.m, vty, ?vi);
    if (sel rv.err) { ret rv; }
    val rc: err[fail.Fail] = copy_vector(c, blk, dst, src, vi, loc, 0, 0);
    if (sel rc.err) { ret rc; }

    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val rp: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, ra.ok, k, loc);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    ret emit_store(c, blk, lane_val, rp.ok, loc, 0);
}

fun fill_one(c: *Ctx, blk: *ir.Block, cur: id.InstructionId, i8_ty: ir_type.IrTypeId) err[fail.Fail] {
    val fn: *ir.Function = c.fn;

    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val kind: instruction.InstrKind = ip.kind;
    val ty:   ir_type.IrTypeId = ip.ty;
    val loc:  source.SrcLoc = ip.loc;
    val is_vec_ty: bool = mem_image(c, ty);

    if (is_vec_ty && (is_binary_op(kind) || is_unary_op(kind) || is_compare_op(kind)
        || kind == instruction.OP_DECLASSIFY || kind == instruction.OP_LOAD)) {
        val dst: value.Value = c.pval[cur::u32];
        if (is_compare_op(kind)) {
            val op0: value.Value = resolve(c, ip.operands[0]);
            val op1: value.Value = resolve(c, ip.operands[1]);
            val op0ty: ir_type.IrTypeId = ip.operands[0].ty;
            var opi: VInfo;
            val re: err[fail.Fail] = vec_info(c.m, op0ty, ?opi);
            if (sel re.err) { ret re; }
            var mi: VInfo;
            val rm: err[fail.Fail] = vec_info(c.m, ty, ?mi);
            if (sel rm.err) { ret rm; }
            ret expand_compare(c, blk, kind, dst, op0, op1, opi, mi, i8_ty, loc);
        }
        var vi: VInfo;
        val rv: err[fail.Fail] = vec_info(c.m, ty, ?vi);
        if (sel rv.err) { ret rv; }
        if (kind == instruction.OP_LOAD) {
            val src: value.Value = resolve(c, ip.operands[0]);
            ret copy_vector(c, blk, dst, src, vi, loc, ip.flags & instruction.INSTR_FLAG_VOLATILE, 0);
        }
        if (is_unary_op(kind) || kind == instruction.OP_DECLASSIFY) {
            val a: value.Value = resolve(c, ip.operands[0]);
            ret expand_unary(c, blk, kind, dst, a, ip.operands[0].secret, vi, loc);
        }
        val a: value.Value = resolve(c, ip.operands[0]);
        val b: value.Value = resolve(c, ip.operands[1]);
        ret expand_binary(c, blk, kind, dst, a, b, ip.operands[0].secret, ip.operands[1].secret, vi, loc);
    }

    if (kind == instruction.OP_VEC_EXTRACT && mem_image(c, ip.operands[0].ty)) {
        ret expand_lane_read_scalarized(c, blk, cur);
    }
    if (kind == instruction.OP_VEC_INSERT && is_vec_ty) {
        ret expand_lane_write_scalarized(c, blk, cur);
    }

    if (kind == instruction.OP_STORE && mem_image(c, ip.operands[0].ty)) {
        val srcv: value.Value = resolve(c, ip.operands[0]);
        val dstp: value.Value = resolve(c, ip.operands[1]);
        val vty:  ir_type.IrTypeId = ip.operands[0].ty;
        var vi: VInfo;
        val rv: err[fail.Fail] = vec_info(c.m, vty, ?vi);
        if (sel rv.err) { ret rv; }
        ret copy_vector(c, blk, dstp, srcv, vi, loc, 0, ip.flags & instruction.INSTR_FLAG_VOLATILE);
    }

    rewrite_ops(c, ?fn.instrs[cur::u32]);
    ret ir.block_append_instr(c.m, blk, cur);
}

rec LaneCtx {
    c:           Ctx;
    slot:        *value.Value;
    slot_set:    *bool;
    store_at:    *bool;
    slot_alloca: *id.InstructionId;
    pslot:       *value.Value;
    pslot_set:   *bool;
    pallocas:    *id.InstructionId;
    palloca_len: u32;
    pn:          u32;
}

fun make_lane_slot(c: *Ctx, vty: ir_type.IrTypeId, out_id: *id.InstructionId) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = value.const_int(1, c.idx_ty);
    val ri: res[id.InstructionId, fail.Fail] = new_instr(c.m, c.fn, instruction.OP_ALLOCA, c.ptr_ty, vty, ?ops[0], 1, source.loc(source.FILE_NIL, 0));
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    val iid: id.InstructionId = ri.ok;
    @out_id = iid;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, c.ptr_ty)};
}

fun has_lane_op(fn: *ir.Function) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val k: instruction.InstrKind = fn.instrs[i].kind;
        if (k == instruction.OP_VEC_EXTRACT || k == instruction.OP_VEC_INSERT) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun lane_index_of(inst: *instruction.Instruction) res[u32, fail.Fail] {
    if (inst.operands[1].kind != value.VAL_CONST_INT) {
        ret res[u32, fail.Fail].err{fail.message("scalarize: vector lane index is not a constant")};
    }
    ret res[u32, fail.Fail].ok{inst.operands[1].data.int_lit::u32};
}

fun reserve_read_slot(lc: *LaneCtx, v: value.Value) err[fail.Fail] {
    if (v.kind == value.VAL_INSTR) {
        val j: u32 = v.data.instr::u32;
        if (j >= lc.c.n) { ret err[fail.Fail].err{fail.message("scalarize: lane read of an out-of-range value")}; }
        if (lc.slot_set[j]) { ret err[fail.Fail].ok{}; }
        val ms: res[value.Value, fail.Fail] = make_lane_slot(?lc.c, v.ty, ?lc.slot_alloca[j]);
        if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }
        lc.slot[j]     = ms.ok;
        lc.slot_set[j] = true;
        lc.store_at[j] = true;
        ret err[fail.Fail].ok{};
    }
    if (v.kind == value.VAL_PARAM) {
        val p: u32 = v.data.param_ix;
        if (p >= lc.pn) { ret err[fail.Fail].err{fail.message("scalarize: lane read of an out-of-range parameter")}; }
        if (lc.pslot_set[p]) { ret err[fail.Fail].ok{}; }
        val ms: res[value.Value, fail.Fail] = make_lane_slot(?lc.c, v.ty, ?lc.pallocas[lc.palloca_len]);
        if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }
        lc.palloca_len  = lc.palloca_len + 1;
        lc.pslot[p]     = ms.ok;
        lc.pslot_set[p] = true;
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].err{fail.message("scalarize: lane read of a value with no stack home")};
}

fun slot_of(lc: *LaneCtx, v: value.Value) res[value.Value, fail.Fail] {
    if (v.kind == value.VAL_INSTR) {
        val j: u32 = v.data.instr::u32;
        if (j < lc.c.n && lc.slot_set[j]) { ret res[value.Value, fail.Fail].ok{lc.slot[j]}; }
    }
    if (v.kind == value.VAL_PARAM) {
        val p: u32 = v.data.param_ix;
        if (p < lc.pn && lc.pslot_set[p]) { ret res[value.Value, fail.Fail].ok{lc.pslot[p]}; }
    }
    ret res[value.Value, fail.Fail].err{fail.message("scalarize: lane read has no reserved slot")};
}

fun expand_lane_read(lc: *LaneCtx, blk: *ir.Block, cur: id.InstructionId) err[fail.Fail] {
    val fn: *ir.Function = lc.c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val src:  value.Value      = ip.operands[0];
    val elem: ir_type.IrTypeId = ip.ty;
    val loc:  source.SrcLoc    = ip.loc;

    val rk: res[u32, fail.Fail] = lane_index_of(ip);
    if (sel rk.err) { ret err[fail.Fail].err{rk.err}; }
    val k: u32 = rk.ok;

    var vi: VInfo;
    val vr: err[fail.Fail] = vec_info(lc.c.m, src.ty, ?vi);
    if (sel vr.err) { ret vr; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?lc.c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }

    val rb: res[value.Value, fail.Fail] = slot_of(lc, src);
    if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }

    val rp: res[value.Value, fail.Fail] = lane_ptr(?lc.c, blk, rb.ok,
        ra.ok, k, loc);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }

    val rl: res[value.Value, fail.Fail] = emit_load(?lc.c, blk, rp.ok, elem, loc, 0);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }

    lc.c.pval[cur::u32]     = lane_secret(?lc.c, rl.ok, src.secret);
    lc.c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun expand_lane_write(lc: *LaneCtx, blk: *ir.Block, cur: id.InstructionId) err[fail.Fail] {
    val fn: *ir.Function = lc.c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val vty: ir_type.IrTypeId = ip.ty;
    val loc: source.SrcLoc    = ip.loc;
    val src: value.Value      = resolve(?lc.c, ip.operands[0]);
    val lane_val: value.Value = resolve(?lc.c, ip.operands[2]);

    val rk: res[u32, fail.Fail] = lane_index_of(ip);
    if (sel rk.err) { ret err[fail.Fail].err{rk.err}; }
    val k: u32 = rk.ok;

    var vi: VInfo;
    val vr: err[fail.Fail] = vec_info(lc.c.m, vty, ?vi);
    if (sel vr.err) { ret vr; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?lc.c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    val slot: value.Value = lc.slot[cur::u32];

    val rs: err[fail.Fail] = emit_store(?lc.c, blk, src, slot, loc, 0);
    if (sel rs.err) { ret rs; }

    val rp: res[value.Value, fail.Fail] = lane_ptr(?lc.c, blk, slot, arr, k, loc);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }

    val rs2: err[fail.Fail] = emit_store(?lc.c, blk, lane_val, rp.ok, loc, 0);
    if (sel rs2.err) { ret rs2; }

    val rl: res[value.Value, fail.Fail] = emit_load(?lc.c, blk, slot, vty, loc, 0);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }

    lc.c.pval[cur::u32]     = rl.ok;
    lc.c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun reserve_lane_slots(lc: *LaneCtx) err[fail.Fail] {
    val fn: *ir.Function = lc.c.fn;
    var iid: u32 = 0;
    for (iid < lc.c.n) {
        val k: instruction.InstrKind = fn.instrs[iid].kind;
        if (k == instruction.OP_VEC_INSERT) {
            val ms: res[value.Value, fail.Fail] = make_lane_slot(?lc.c, fn.instrs[iid].ty, ?lc.slot_alloca[iid]);
            if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }
            lc.slot[iid]     = ms.ok;
            lc.slot_set[iid] = true;
        }
        or (k == instruction.OP_VEC_EXTRACT) {
            val rr: err[fail.Fail] = reserve_read_slot(lc, fn.instrs[iid].operands[0]);
            if (sel rr.err) { ret rr; }
        }
        iid = iid + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_lane_block(lc: *LaneCtx, blk: *ir.Block, is_entry: bool) err[fail.Fail] {
    val fn: *ir.Function = lc.c.fn;

    val old_len: u32 = blk.instr_count;
    var old: *id.InstructionId = nil;
    if (old_len > 0) {
        val ro: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](lc.c.alloc, old_len::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        old = ro.ok;
        var i: u32 = 0;
        for (i < old_len) { old[i] = blk.instructions[i]; i = i + 1; }
    }
    blk.instr_count = 0;

    if (is_entry) {
        var s: u32 = 0;
        for (s < lc.palloca_len) {
            val rap: err[fail.Fail] = ir.block_append_instr(lc.c.m, blk, lc.pallocas[s]);
            if (sel rap.err) { body_free(?lc.c, old, old_len); ret rap; }
            s = s + 1;
        }
        var p: u32 = 0;
        for (p < lc.pn) {
            if (lc.pslot_set[p]) {
                val rsp: err[fail.Fail] = emit_store(?lc.c, blk,
                    value.param(p, fn.params[p].ty), lc.pslot[p], source.loc(source.FILE_NIL, 0), 0);
                if (sel rsp.err) { body_free(?lc.c, old, old_len); ret rsp; }
            }
            p = p + 1;
        }
    }

    var ph: u32 = 0;
    for (ph < blk.phi_count) {
        val pid: u32 = blk.phis[ph]::u32;
        if (pid < lc.c.n && lc.store_at[pid]) {
            val rap: err[fail.Fail] = ir.block_append_instr(lc.c.m, blk, lc.slot_alloca[pid]);
            if (sel rap.err) { body_free(?lc.c, old, old_len); ret rap; }
            val rsp: err[fail.Fail] = emit_store(?lc.c, blk,
                value.instr(pid::id.InstructionId, fn.instrs[pid].ty), lc.slot[pid], fn.instrs[pid].loc, 0);
            if (sel rsp.err) { body_free(?lc.c, old, old_len); ret rsp; }
        }
        ph = ph + 1;
    }

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur: id.InstructionId = old[oi];
        val kind: instruction.InstrKind = fn.instrs[cur::u32].kind;
        var rr: err[fail.Fail] = err[fail.Fail].ok{};
        if (kind == instruction.OP_VEC_EXTRACT) {
            rr = expand_lane_read(lc, blk, cur);
        }
        or (kind == instruction.OP_VEC_INSERT) {
            rr = ir.block_append_instr(lc.c.m, blk, lc.slot_alloca[cur::u32]);
            if (!sel rr.err) { rr = expand_lane_write(lc, blk, cur); }
        }
        or {
            rr = ir.block_append_instr(lc.c.m, blk, cur);
            if (!sel rr.err && cur::u32 < lc.c.n && lc.store_at[cur::u32]) {
                rr = ir.block_append_instr(lc.c.m, blk, lc.slot_alloca[cur::u32]);
                if (!sel rr.err) {
                    rr = emit_store(?lc.c, blk,
                        value.instr(cur, fn.instrs[cur::u32].ty), lc.slot[cur::u32], fn.instrs[cur::u32].loc, 0);
                }
            }
        }
        if (sel rr.err) { body_free(?lc.c, old, old_len); ret rr; }
        oi = oi + 1;
    }

    body_free(?lc.c, old, old_len);
    ret err[fail.Fail].ok{};
}

fun lane_ctx_free(lc: *LaneCtx) {
    if (lc.slot != nil && lc.c.n > 0)      { A.deallocate[value.Value](lc.c.alloc, lc.slot, lc.c.n::usize); }
    if (lc.slot_set != nil && lc.c.n > 0)  { A.deallocate[bool](lc.c.alloc, lc.slot_set, lc.c.n::usize); }
    if (lc.store_at != nil && lc.c.n > 0)  { A.deallocate[bool](lc.c.alloc, lc.store_at, lc.c.n::usize); }
    if (lc.slot_alloca != nil && lc.c.n > 0) { A.deallocate[id.InstructionId](lc.c.alloc, lc.slot_alloca, lc.c.n::usize); }
    if (lc.pslot != nil && lc.pn > 0)      { A.deallocate[value.Value](lc.c.alloc, lc.pslot, lc.pn::usize); }
    if (lc.pslot_set != nil && lc.pn > 0)  { A.deallocate[bool](lc.c.alloc, lc.pslot_set, lc.pn::usize); }
    if (lc.pallocas != nil && lc.pn > 0)   { A.deallocate[id.InstructionId](lc.c.alloc, lc.pallocas, lc.pn::usize); }
    lc.slot = nil; lc.slot_set = nil; lc.store_at = nil; lc.slot_alloca = nil;
    lc.pslot = nil; lc.pslot_set = nil; lc.pallocas = nil;
    ctx_free(?lc.c);
}

fun lane_work(work: *FunctionWork, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = work.module;
    val fn: *ir.Function = work.body;
    val tgt: *target.Target = work.target;
    val void_ty: ir_type.IrTypeId = work.void_ty;
    val ptr_ty: ir_type.IrTypeId = work.ptr_ty;
    val idx_ty: ir_type.IrTypeId = work.idx_ty;
    if (!has_lane_op(fn)) { ret res[bool, fail.Fail].ok{false}; }

    var lc: LaneCtx;
    lc.c.alloc   = alloc;
    lc.c.m       = m;
    lc.c.tgt     = tgt;
    lc.c.fn      = fn;
    lc.c.lane_buf = nil;
    lc.c.lane_cap = 0;
    lc.c.n       = fn.instr_len;
    lc.c.pcount  = 0;
    lc.c.is_vp   = nil;
    lc.c.void_ty = void_ty;
    lc.c.ptr_ty  = ptr_ty;
    lc.c.idx_ty  = idx_ty;
    lc.pn        = fn.param_count;
    lc.palloca_len = 0;

    val rpv: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, lc.c.n::usize);
    if (sel rpv.err) { ret res[bool, fail.Fail].err{fail.refused(rpv.err)}; }
    lc.c.pval = rpv.ok;
    val rps: res[*bool, A.Error] = A.zallocate[bool](alloc, lc.c.n::usize);
    if (sel rps.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(rps.err)}; }
    lc.c.pval_set = rps.ok;

    val rsl: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, lc.c.n::usize);
    if (sel rsl.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(rsl.err)}; }
    lc.slot = rsl.ok;
    val rss: res[*bool, A.Error] = A.zallocate[bool](alloc, lc.c.n::usize);
    if (sel rss.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(rss.err)}; }
    lc.slot_set = rss.ok;
    val rsa: res[*bool, A.Error] = A.zallocate[bool](alloc, lc.c.n::usize);
    if (sel rsa.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(rsa.err)}; }
    lc.store_at = rsa.ok;
    val ral: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](alloc, lc.c.n::usize);
    if (sel ral.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(ral.err)}; }
    lc.slot_alloca = ral.ok;

    if (lc.pn > 0) {
        val rpl: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, lc.pn::usize);
        if (sel rpl.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(rpl.err)}; }
        lc.pslot = rpl.ok;
        val rpss: res[*bool, A.Error] = A.zallocate[bool](alloc, lc.pn::usize);
        if (sel rpss.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(rpss.err)}; }
        lc.pslot_set = rpss.ok;
        val rpa: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](alloc, lc.pn::usize);
        if (sel rpa.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{fail.refused(rpa.err)}; }
        lc.pallocas = rpa.ok;
    }

    val rr: err[fail.Fail] = reserve_lane_slots(?lc);
    if (sel rr.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{rr.err}; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val rb: err[fail.Fail] = expand_lane_block(?lc, ?fn.blocks[bi], bi == 0);
        if (sel rb.err) { lane_ctx_free(?lc); ret res[bool, fail.Fail].err{rb.err}; }
        bi = bi + 1;
    }
    rewrite_uses(?lc.c, fn);

    lane_ctx_free(?lc);
    ret res[bool, fail.Fail].ok{true};
}

pub fun expand_lane_ops(m: *ir.Module, tgt: *target.Target) res[bool, fail.Fail] {
    if (tgt.model.has_lane_ops) { ret res[bool, fail.Fail].ok{false}; }
    if (!tgt.model.has_v128)    { ret res[bool, fail.Fail].ok{false}; }

    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret res[bool, fail.Fail].err{rv.err}; }
    val void_ty: ir_type.IrTypeId = rv.ok;

    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret res[bool, fail.Fail].err{rp.err}; }
    val ptr_ty: ir_type.IrTypeId = rp.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, tgt.isa.pointer_width * 8);
    if (sel ri.err) { ret res[bool, fail.Fail].err{ri.err}; }
    val idx_ty: ir_type.IrTypeId = ri.ok;

    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    var changed: bool = false;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0) {
            var work: FunctionWork = FunctionWork{module: m, body: fn, target: tgt,
                void_ty: void_ty, ptr_ty: ptr_ty, idx_ty: idx_ty, i8_ty: ir_type.IRT_NIL};
            val changed_r: res[bool, fail.Fail] = scratch.run[FunctionWork, bool](?workspace, m.alloc, ?work, lane_work);
            if (sel changed_r.err) { ret changed_r; }
            if (changed_r.ok) { changed = true; }
        }
        fi = fi + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun has_gap_op(m: *ir.Module, fn: *ir.Function, tgt: *target.Target) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (is_operator(m, inst) && !vecform.realizes_packed(m, tgt, inst)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun expand_gap_op(c: *Ctx, tgt: *target.Target, blk: *ir.Block, cur: id.InstructionId) err[fail.Fail] {
    val fn: *ir.Function = c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val kind: instruction.InstrKind = ip.kind;
    val loc:  source.SrcLoc = ip.loc;
    val vty:  ir_type.IrTypeId = ip.ty;

    if (is_compare_op(kind)) { ret expand_gap_compare(c, tgt, blk, cur); }
    if (!is_binary_op(kind) && !is_unary_op(kind)) {
        ret err[fail.Fail].err{fail.message("scalarize: gap operator is not a lane-wise arithmetic or bitwise op")};
    }

    var vi: VInfo;
    val rvi: err[fail.Fail] = vec_info(c.m, vty, ?vi);
    if (sel rvi.err) { ret rvi; }

    val unary: bool = is_unary_op(kind);
    if (ip.operand_count < 1)             { ret err[fail.Fail].err{fail.message("scalarize: gap operator missing operands")}; }
    if (!unary && ip.operand_count < 2)   { ret err[fail.Fail].err{fail.message("scalarize: gap operator missing operands")}; }

    val a: value.Value = resolve(c, ip.operands[0]);
    var b: value.Value = a;
    if (!unary) { b = resolve(c, ip.operands[1]); }
    val a_secret: bool = ip.operands[0].secret;
    var b_secret: bool = false;
    if (!unary) { b_secret = ip.operands[1].secret; }

    val rlb: res[*value.Value, fail.Fail] = lane_scratch(c, vi.lanes);
    if (sel rlb.err) { ret err[fail.Fail].err{rlb.err}; }
    val lanes: *value.Value = rlb.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val ra: res[value.Value, fail.Fail] = emit_lane_read(c, blk, a, vi.elem, k, loc);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        val av: value.Value = lane_secret(c, ra.ok, a_secret);

        var rr: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].ok{av};
        if (unary) {
            rr = emit_unop(c, blk, kind, vi.elem, av, loc);
        }
        or {
            val rb: res[value.Value, fail.Fail] = emit_lane_read(c, blk, b, vi.elem, k, loc);
            if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
            val bv: value.Value = lane_secret(c, rb.ok, b_secret);
            rr = emit_binop(c, blk, kind, vi.elem, av, bv, loc);
        }
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        lanes[k] = lane_secret(c, rr.ok, a_secret || b_secret);
        k = k + 1;
    }

    var acc: value.Value = a;
    var j: u32 = 0;
    for (j < vi.lanes) {
        val ri: res[value.Value, fail.Fail] = emit_lane_write(c, blk, acc, vty, j, lanes[j], loc);
        if (sel ri.err) { ret err[fail.Fail].err{ri.err}; }
        acc = ri.ok;
        j = j + 1;
    }

    c.pval[cur::u32]     = acc;
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun expand_gap_compare(c: *Ctx, tgt: *target.Target, blk: *ir.Block, cur: id.InstructionId) err[fail.Fail] {
    val fn: *ir.Function = c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val kind: instruction.InstrKind = ip.kind;
    val loc:  source.SrcLoc = ip.loc;
    val mask_ty: ir_type.IrTypeId = ip.ty;

    if (ip.operand_count < 2) { ret err[fail.Fail].err{fail.message("scalarize: gap compare missing operands")}; }
    val op_ty: ir_type.IrTypeId = ip.operands[0].ty;

    var opi: VInfo;
    val ro: err[fail.Fail] = vec_info(c.m, op_ty, ?opi);
    if (sel ro.err) { ret ro; }
    var mi: VInfo;
    val rm: err[fail.Fail] = vec_info(c.m, mask_ty, ?mi);
    if (sel rm.err) { ret rm; }
    if (opi.lanes != mi.lanes) {
        ret err[fail.Fail].err{fail.message("scalarize: gap compare mask has a different lane count from its operands")};
    }

    val ri8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?c.m.types, 8);
    if (sel ri8.err) { ret err[fail.Fail].err{ri8.err}; }
    val i8_ty: ir_type.IrTypeId = ri8.ok;

    val need_sext: bool = (kind == instruction.OP_CMP_LT_S || kind == instruction.OP_CMP_LE_S) && opi.bits < 32;
    var ext_ty: ir_type.IrTypeId = ir_type.IRT_NIL;
    if (need_sext) {
        val rx: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?c.m.types, 32);
        if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
        ext_ty = rx.ok;
    }

    val a: value.Value = resolve(c, ip.operands[0]);
    val b: value.Value = resolve(c, ip.operands[1]);
    val secret: bool = ip.operands[0].secret || ip.operands[1].secret;

    val rlb: res[*value.Value, fail.Fail] = lane_scratch(c, opi.lanes);
    if (sel rlb.err) { ret err[fail.Fail].err{rlb.err}; }
    val lanes: *value.Value = rlb.ok;

    var k: u32 = 0;
    for (k < opi.lanes) {
        val ra: res[value.Value, fail.Fail] = emit_lane_read(c, blk, a, opi.elem, k, loc);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        var la: value.Value = lane_secret(c, ra.ok, ip.operands[0].secret);
        val rb: res[value.Value, fail.Fail] = emit_lane_read(c, blk, b, opi.elem, k, loc);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        var lb: value.Value = lane_secret(c, rb.ok, ip.operands[1].secret);

        if (need_sext) {
            val sa: res[value.Value, fail.Fail] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, la, loc);
            if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
            la = lane_secret(c, sa.ok, ip.operands[0].secret);
            val sb: res[value.Value, fail.Fail] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, lb, loc);
            if (sel sb.err) { ret err[fail.Fail].err{sb.err}; }
            lb = lane_secret(c, sb.ok, ip.operands[1].secret);
        }

        val cmp: res[value.Value, fail.Fail] = emit_binop(c, blk, kind, i8_ty, la, lb, loc);
        if (sel cmp.err) { ret err[fail.Fail].err{cmp.err}; }
        var wide: value.Value = lane_secret(c, cmp.ok, secret);

        if (mi.bits != 8) {
            val z: res[value.Value, fail.Fail] = emit_unop(c, blk, instruction.OP_ZEXT, mi.elem, wide, loc);
            if (sel z.err) { ret err[fail.Fail].err{z.err}; }
            wide = lane_secret(c, z.ok, secret);
        }

        val neg: res[value.Value, fail.Fail] = emit_binop(c, blk, instruction.OP_SUB, mi.elem,
                                                         value.const_int(0, mi.elem), wide, loc);
        if (sel neg.err) { ret err[fail.Fail].err{neg.err}; }
        lanes[k] = lane_secret(c, neg.ok, secret);
        k = k + 1;
    }

    var acc: value.Value;
    if (tgt.model.has_vec_build) {
        val rv: res[value.Value, fail.Fail] = push(c, blk, instruction.OP_VEC_BUILD, mask_ty, mask_ty,
                                                  ?lanes[0], opi.lanes, loc);
        if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
        acc = rv.ok;
    }
    or {
        if (mask_ty != op_ty) {
            ret err[fail.Fail].err{fail.message("scalarize: no per-lane expansion for a gapped float-lane vector compare on a target that cannot build a vector from its lanes")};
        }
        acc = a;
        var j: u32 = 0;
        for (j < opi.lanes) {
            val rw: res[value.Value, fail.Fail] = emit_lane_write(c, blk, acc, mask_ty, j, lanes[j], loc);
            if (sel rw.err) { ret err[fail.Fail].err{rw.err}; }
            acc = rw.ok;
            j = j + 1;
        }
    }

    c.pval[cur::u32]     = acc;
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun emit_lane_read(c: *Ctx, blk: *ir.Block, vec: value.Value, elem_ty: ir_type.IrTypeId, k: u32, loc: source.SrcLoc) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = vec;
    ops[1] = value.const_int(k::u64, c.idx_ty);
    ret push(c, blk, instruction.OP_VEC_EXTRACT, elem_ty, vec.ty, ?ops[0], 2, loc);
}

fun emit_lane_write(c: *Ctx, blk: *ir.Block, vec: value.Value, vty: ir_type.IrTypeId, k: u32, v: value.Value, loc: source.SrcLoc) res[value.Value, fail.Fail] {
    var ops: [3]value.Value;
    ops[0] = vec;
    ops[1] = value.const_int(k::u64, c.idx_ty);
    ops[2] = v;
    ret push(c, blk, instruction.OP_VEC_INSERT, vty, vty, ?ops[0], 3, loc);
}

fun expand_gap_block(c: *Ctx, tgt: *target.Target, blk: *ir.Block) err[fail.Fail] {
    val fn: *ir.Function = c.fn;

    val old_len: u32 = blk.instr_count;
    var old: *id.InstructionId = nil;
    if (old_len > 0) {
        val ro: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](c.alloc, old_len::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        old = ro.ok;
        var i: u32 = 0;
        for (i < old_len) { old[i] = blk.instructions[i]; i = i + 1; }
    }
    blk.instr_count = 0;

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur: id.InstructionId = old[oi];
        val inst: *instruction.Instruction = ?fn.instrs[cur::u32];
        var rr: err[fail.Fail] = err[fail.Fail].ok{};
        if (is_operator(c.m, inst) && !vecform.realizes_packed(c.m, tgt, inst)) {
            rr = expand_gap_op(c, tgt, blk, cur);
        }
        or {
            rr = ir.block_append_instr(c.m, blk, cur);
        }
        if (sel rr.err) { body_free(c, old, old_len); ret rr; }
        oi = oi + 1;
    }

    body_free(c, old, old_len);
    ret err[fail.Fail].ok{};
}

fun rewrite_uses(c: *Ctx, fn: *ir.Function) {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            rewrite_ops(c, ?fn.instrs[blk.phis[p]::u32]);
            p = p + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            rewrite_ops(c, ?fn.instrs[blk.instructions[ii]::u32]);
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL) { rewrite_ops(c, ?fn.instrs[blk.terminator::u32]); }
        bi = bi + 1;
    }
}

fun gap_work(work: *FunctionWork, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = work.module;
    val fn: *ir.Function = work.body;
    val tgt: *target.Target = work.target;
    val void_ty: ir_type.IrTypeId = work.void_ty;
    val ptr_ty: ir_type.IrTypeId = work.ptr_ty;
    val idx_ty: ir_type.IrTypeId = work.idx_ty;
    if (!has_gap_op(m, fn, tgt)) { ret res[bool, fail.Fail].ok{false}; }

    var c: Ctx;
    c.alloc    = alloc;
    c.m        = m;
    c.tgt      = tgt;
    c.fn       = fn;
    c.n        = fn.instr_len;
    c.lane_buf = nil;
    c.lane_cap = 0;
    c.pcount  = 0;
    c.is_vp   = nil;
    c.void_ty = void_ty;
    c.ptr_ty  = ptr_ty;
    c.idx_ty  = idx_ty;

    val rpv: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, c.n::usize);
    if (sel rpv.err) { ret res[bool, fail.Fail].err{fail.refused(rpv.err)}; }
    c.pval = rpv.ok;
    val rps: res[*bool, A.Error] = A.zallocate[bool](alloc, c.n::usize);
    if (sel rps.err) { ctx_free(?c); ret res[bool, fail.Fail].err{fail.refused(rps.err)}; }
    c.pval_set = rps.ok;

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val rb: err[fail.Fail] = expand_gap_block(?c, tgt, ?fn.blocks[bi]);
        if (sel rb.err) { ctx_free(?c); ret res[bool, fail.Fail].err{rb.err}; }
        bi = bi + 1;
    }
    rewrite_uses(?c, fn);

    ctx_free(?c);
    ret res[bool, fail.Fail].ok{true};
}

pub fun expand_gap_ops(m: *ir.Module, tgt: *target.Target) res[bool, fail.Fail] {
    if (!tgt.model.has_v128) { ret res[bool, fail.Fail].ok{false}; }

    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret res[bool, fail.Fail].err{rv.err}; }
    val void_ty: ir_type.IrTypeId = rv.ok;

    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret res[bool, fail.Fail].err{rp.err}; }
    val ptr_ty: ir_type.IrTypeId = rp.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, tgt.isa.pointer_width * 8);
    if (sel ri.err) { ret res[bool, fail.Fail].err{ri.err}; }
    val idx_ty: ir_type.IrTypeId = ri.ok;

    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    var changed: bool = false;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0) {
            var work: FunctionWork = FunctionWork{module: m, body: fn, target: tgt,
                void_ty: void_ty, ptr_ty: ptr_ty, idx_ty: idx_ty, i8_ty: ir_type.IRT_NIL};
            val changed_r: res[bool, fail.Fail] = scratch.run[FunctionWork, bool](?workspace, m.alloc, ?work, gap_work);
            if (sel changed_r.err) { ret changed_r; }
            if (changed_r.ok) { changed = true; }
        }
        fi = fi + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun function_has_mem_image(m: *ir.Module, fn: *ir.Function, tgt: *target.Target) bool {
    var p: u32 = 0;
    for (p < fn.param_count) {
        if (!vecform.holds_in_register(m, tgt, fn.params[p].ty)) { ret true; }
        p = p + 1;
    }
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (!vecform.holds_in_register(m, tgt, inst.ty))     { ret true; }
        if (!vecform.holds_in_register(m, tgt, inst.aux_ty)) { ret true; }
        var o: u32 = 0;
        for (o < inst.operand_count) {
            if (!vecform.holds_in_register(m, tgt, inst.operands[o].ty)) { ret true; }
            o = o + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun has_mem_image_value(m: *ir.Module, tgt: *target.Target) bool {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0) {
            if (function_has_mem_image(m, fn, tgt)) { ret true; }
        }
        fi = fi + 1;
    }
    ret false;
}

pub fun run(m: *ir.Module, tgt: *target.Target) res[bool, fail.Fail] {
    if (!has_mem_image_value(m, tgt)) { ret res[bool, fail.Fail].ok{false}; }

    var first: ScalarizeSite;
    m.vector_ops_scalarized = detect(m, tgt, ?first);

    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret res[bool, fail.Fail].err{rp.err}; }
    val ptr_ty: ir_type.IrTypeId = rp.ok;

    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret res[bool, fail.Fail].err{rv.err}; }
    val void_ty: ir_type.IrTypeId = rv.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, tgt.isa.pointer_width * 8);
    if (sel ri.err) { ret res[bool, fail.Fail].err{ri.err}; }
    val idx_ty: ir_type.IrTypeId = ri.ok;

    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ret res[bool, fail.Fail].err{r8.err}; }
    val i8_ty: ir_type.IrTypeId = r8.ok;

    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    var changed: bool = false;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0
            && function_has_mem_image(m, fn, tgt)) {
            var work: FunctionWork = FunctionWork{module: m, body: fn, target: tgt,
                void_ty: void_ty, ptr_ty: ptr_ty, idx_ty: idx_ty, i8_ty: i8_ty};
            val expanded: err[fail.Fail] = scratch.run_unit[FunctionWork](?workspace, m.alloc, ?work, scalarize_work);
            if (sel expanded.err) { ret res[bool, fail.Fail].err{expanded.err}; }
            changed = true;
        }
        fi = fi + 1;
    }

    ret res[bool, fail.Fail].ok{changed};
}

fun scalarize_work(work: *FunctionWork, alloc: *A.Allocator) err[fail.Fail] {
    val m: *ir.Module = work.module;
    val fn: *ir.Function = work.body;
    val tgt: *target.Target = work.target;
    val void_ty: ir_type.IrTypeId = work.void_ty;
    val ptr_ty: ir_type.IrTypeId = work.ptr_ty;
    val idx_ty: ir_type.IrTypeId = work.idx_ty;
    val i8_ty: ir_type.IrTypeId = work.i8_ty;
    var c: Ctx;
    c.alloc    = alloc;
    c.m        = m;
    c.tgt      = tgt;
    c.fn       = fn;
    c.n        = fn.instr_len;
    c.lane_buf = nil;
    c.lane_cap = 0;
    c.pcount  = fn.param_count;
    c.void_ty = void_ty;
    c.ptr_ty  = ptr_ty;
    c.idx_ty  = idx_ty;

    val rpv: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, c.n::usize);
    if (sel rpv.err) { ret err[fail.Fail].err{fail.refused(rpv.err)}; }
    c.pval = rpv.ok;
    val rps: res[*bool, A.Error] = A.allocate[bool](alloc, c.n::usize);
    if (sel rps.err) { A.deallocate[value.Value](alloc, c.pval, c.n::usize); ret err[fail.Fail].err{fail.refused(rps.err)}; }
    c.pval_set = rps.ok;

    var iid: u32 = 0;
    for (iid < c.n) { c.pval_set[iid] = false; iid = iid + 1; }

    c.is_vp = nil;
    if (c.pcount > 0) {
        val rvp: res[*bool, A.Error] = A.allocate[bool](alloc, c.pcount::usize);
        if (sel rvp.err) { ctx_free(?c); ret err[fail.Fail].err{fail.refused(rvp.err)}; }
        c.is_vp = rvp.ok;
        var p: u32 = 0;
        for (p < c.pcount) {
            c.is_vp[p] = mem_image(?c, fn.params[p].ty);
            if (c.is_vp[p]) { fn.params[p] = value.retype(fn.params[p], ptr_ty); }
            p = p + 1;
        }
    }

    val rf: err[fail.Fail] = scalarize_function(?c, i8_ty);
    ctx_free(?c);
    if (sel rf.err) { ret err[fail.Fail].err{rf.err}; }
    ret err[fail.Fail].ok{};
}

fun ctx_free(c: *Ctx) {
    if (c.lane_buf != nil && c.lane_cap > 0) {
        A.deallocate[value.Value](c.alloc, c.lane_buf, c.lane_cap::usize);
        c.lane_buf = nil;
        c.lane_cap = 0;
    }
    if (c.pval != nil && c.n > 0)     { A.deallocate[value.Value](c.alloc, c.pval, c.n::usize); }
    if (c.pval_set != nil && c.n > 0) { A.deallocate[bool](c.alloc, c.pval_set, c.n::usize); }
    if (c.is_vp != nil && c.pcount > 0) { A.deallocate[bool](c.alloc, c.is_vp, c.pcount::usize); }
    c.pval = nil;
    c.pval_set = nil;
    c.is_vp = nil;
}

test "mach.lang.me.pass.scalarize.detect:counts_only_vector_operators" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val res_f: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?m.types, 32);
    if (sel res_f.err) { ir.dnit(?m); ret 1; }
    val f32: ir_type.IrTypeId = res_f.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, f32, 4);
    if (sel res_v.err) { ir.dnit(?m); ret 1; }
    val vec: ir_type.IrTypeId = res_v.ok;
    val res_i: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel res_i.err) { ir.dnit(?m); ret 1; }
    val i32: ir_type.IrTypeId = res_i.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_blk.ok);

    val pv0: value.Value = value.param(0, vec);
    val pv1: value.Value = value.param(1, vec);
    val ps:  value.Value = value.param(2, i32);

    val r_1551: res[value.Value, fail.Fail] = builder.emit_add(?bld, ps, ps);
    if (sel r_1551.err) { ir.dnit(?m); ret 1; }
    val r_1552: res[value.Value, fail.Fail] = builder.emit_add(?bld, pv0, pv1);
    if (sel r_1552.err) { ir.dnit(?m); ret 1; }
    val r_1553: res[value.Value, fail.Fail] = builder.emit_mul(?bld, pv0, pv1);
    if (sel r_1553.err) { ir.dnit(?m); ret 1; }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1557: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1557.err) { ir.dnit(?m); ret 1; }
    val rt: res[target.Target, fail.Fail] = target.select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    var tgt: target.Target = rt.ok;

    var site: ScalarizeSite;
    val n: u32 = detect(?m, ?tgt, ?site);
    if (n != 2)                              { ir.dnit(?m); ret 1; }
    if (site.op != instruction.OP_ADD)       { ir.dnit(?m); ret 1; }
    if (site.lane_bits != 32)                { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

fun vec_binop_module(alloc: *A.Allocator, kind: instruction.InstrKind, elem_bits: u32, lanes: u32, out: *ir.Module) bool {
    val res_m: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel res_m.err) { ret false; }
    @out = res_m.ok;

    val res_e: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?out.types, elem_bits);
    if (sel res_e.err) { ret false; }
    val elem: ir_type.IrTypeId = res_e.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?out.types, elem, lanes);
    if (sel res_v.err) { ret false; }
    val vec: ir_type.IrTypeId = res_v.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(out, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret false; }
    val fn: *ir.Function = ?out.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(out);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ret false; }
    builder.set_block(?bld, res_blk.ok);

    val pv0: value.Value = value.param(0, vec);
    val pv1: value.Value = value.param(1, vec);
    if (kind == instruction.OP_MUL) {
        val r_1597: res[value.Value, fail.Fail] = builder.emit_mul(?bld, pv0, pv1);
        if (sel r_1597.err) { ret false; }
        ret true;
    }
    if (kind == instruction.OP_DIV_S) {
        val r_1601: res[value.Value, fail.Fail] = builder.emit_div_s(?bld, pv0, pv1);
        ret sel r_1601.ok;
    }
    if (kind == instruction.OP_DIV_U) {
        val r_1604: res[value.Value, fail.Fail] = builder.emit_div_u(?bld, pv0, pv1);
        ret sel r_1604.ok;
    }
    val r_1606: res[value.Value, fail.Fail] = builder.emit_add(?bld, pv0, pv1);
    if (sel r_1606.err) { ret false; }
    ret true;
}

fun test_target(reg: *target.TargetRegistry, isa_name: str, out: *target.Target) bool {
    var abi: str = "sysv64";
    if (str_equals(isa_name, "aarch64")) { abi = "aapcs64"; }
    if (str_equals(isa_name, "riscv64")) { abi = "lp64d"; }
    val rt: res[target.Target, fail.Fail] = target.select_of(reg, isa_name, "linux", abi, "");
    if (sel rt.err) { ret false; }
    @out = rt.ok;
    ret true;
}

test "mach.lang.me.pass.scalarize:require_and_expansion_read_one_authority" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1625: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1625.err) { ret 1; }

    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_MUL, 32, 4) != 1) { ret 1; }
    if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_MUL, 32, 4) != 1) { ret 2; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_MUL, 32, 4) != 0) { ret 3; }

    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_MUL, 64, 2) != 1) { ret 4; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_MUL, 64, 2) != 1) { ret 5; }
    if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_MUL, 64, 2) != 1) { ret 6; }

    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_MUL, 16, 8) != 0) { ret 7; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_MUL, 16, 8) != 0) { ret 8; }
    if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_MUL, 16, 8) != 1) { ret 9; }

    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_ADD, 32, 4) != 0)  { ret 10; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_ADD, 32, 4) != 0) { ret 11; }

    var bits: u32 = 8;
    for (bits <= 64) {
        if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_DIV_S, bits, 128 / bits) != 1) { ret 12; }
        if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_DIV_U, bits, 128 / bits) != 1) { ret 13; }
        if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_DIV_S, bits, 128 / bits) != 1) { ret 14; }
        if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_DIV_U, bits, 128 / bits) != 1) { ret 15; }
        if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_DIV_S, bits, 128 / bits) != 1) { ret 16; }
        if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_DIV_U, bits, 128 / bits) != 1) { ret 17; }
        bits = bits * 2;
    }
    ret 0;
}

fun gap_agreement(alloc: *A.Allocator, reg: *target.TargetRegistry, isa_name: str,
                  kind: instruction.InstrKind, elem_bits: u32, lanes: u32) u32 {
    var tgt: target.Target;
    if (!test_target(reg, isa_name, ?tgt)) { ret 0xFFFFFFFF; }
    var m: ir.Module;
    if (!vec_binop_module(alloc, kind, elem_bits, lanes, ?m)) { ret 0xFFFFFFFF; }

    var site: ScalarizeSite;
    val before: u32 = detect(?m, ?tgt, ?site);

    if (tgt.model.has_v128) {
        val r_1666: res[bool, fail.Fail] = expand_gap_ops(?m, ?tgt);
        if (sel r_1666.err) { ir.dnit(?m); ret 0xFFFFFFFF; }
        var after: ScalarizeSite;
        if (detect(?m, ?tgt, ?after) != 0) { ir.dnit(?m); ret 0xFFFFFFFF; }
    }

    ir.dnit(?m);
    ret before;
}

fun sext_count(tgt: *target.Target, kind: instruction.InstrKind, elem_bits: u32, lanes: u32) u32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 0xFFFFFFFF; }
    var m: ir.Module = res_m.ok;

    val res_e: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, elem_bits);
    if (sel res_e.err) { ir.dnit(?m); ret 0xFFFFFFFF; }
    val elem: ir_type.IrTypeId = res_e.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem, lanes);
    if (sel res_v.err) { ir.dnit(?m); ret 0xFFFFFFFF; }
    val vec: ir_type.IrTypeId = res_v.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ir.dnit(?m); ret 0xFFFFFFFF; }
    val fidx: u32 = res_fn.ok;
    val fn: *ir.Function = ?m.functions[fidx];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ir.dnit(?m); ret 0xFFFFFFFF; }
    builder.set_block(?bld, res_blk.ok);

    val pv0: value.Value = value.param(0, vec);
    val pv1: value.Value = value.param(1, vec);
    val r_1702: res[value.Value, fail.Fail] = builder.emit_vcompare(?bld, kind, pv0, pv1, vec);
    if (sel r_1702.err) { ir.dnit(?m); ret 0xFFFFFFFF; }

    val r_1704: res[bool, fail.Fail] = run(?m, tgt);
    if (sel r_1704.err) { ir.dnit(?m); ret 0xFFFFFFFF; }

    val fnc: *ir.Function = ?m.functions[fidx];
    var count: u32 = 0;
    var i: u32 = 0;
    for (i < fnc.instr_len) {
        if (fnc.instrs[i].kind == instruction.OP_SEXT) { count = count + 1; }
        i = i + 1;
    }
    ir.dnit(?m);
    ret count;
}

test "mach.lang.me.pass.scalarize.expand_compare:sign_extends_narrow_signed_lanes" {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1720: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1720.err) { ret 1; }
    val rt: res[target.Target, fail.Fail] = target.select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (sel rt.err) { ret 1; }
    var tgt: target.Target = rt.ok;

    if (sext_count(?tgt, instruction.OP_CMP_LT_S, 16, 8) != 16)  { ret 1; }
    if (sext_count(?tgt, instruction.OP_CMP_LE_S, 8, 16) != 32)  { ret 1; }

    if (sext_count(?tgt, instruction.OP_CMP_EQ, 16, 8) != 0)     { ret 1; }
    if (sext_count(?tgt, instruction.OP_CMP_LT_U, 16, 8) != 0)   { ret 1; }
    if (sext_count(?tgt, instruction.OP_CMP_LT_S, 32, 4) != 0)   { ret 1; }

    ret 0;
}

test "mach.lang.me.pass.scalarize.run:reports_no_change_with_no_vector_values" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1740: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1740.err) { ret 1; }
    var tgt: target.Target;
    if (!test_target(?reg, "riscv64", ?tgt)) { ret 1; }

    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val res_i: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel res_i.err) { ir.dnit(?m); ret 1; }
    val i32t: ir_type.IrTypeId = res_i.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_blk.ok);
    val ps: value.Value = value.param(0, i32t);
    val res_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, ps, ps);
    if (sel res_add.err) { ir.dnit(?m); ret 1; }
    val r_1764: err[fail.Fail] = builder.emit_ret(?bld, res_add.ok);
    if (sel r_1764.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rr.err) { ir.dnit(?m); ret 1; }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.scalarize.run:reports_change_when_a_vector_op_is_scalarized" {
    var alloc: A.Allocator;
