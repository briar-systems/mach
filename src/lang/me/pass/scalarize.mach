# target-conditional vector scalarization pass (#2016)
#
# On a SIMD-incapable target (`MachineModel.has_v128 == false`, rv64gc the shipping
# instance) there is no vector register file and no packed instruction for any
# lane-wise operator, so every `IRT_VECTOR` value and operator must be lowered to a
# defined per-lane scalar form before the back end selects instructions. This pass
# runs as a middle-end IR legalization stage, after the always-on mem2reg / constfold
# / dce sequence and before codegen, so that by the time MIR selection runs there are
# no `IRT_VECTOR`-typed values left: the per-target isel guard in mir/lower.mach then
# never fires on rv64 (it stays a loud backstop) and the existing scalar back end
# selects the result unchanged.
#
# The governing rule is the epic's: scalarize OPERATORS, never algorithms. Each
# lane-wise operator becomes a fixed, bounded per-lane unroll -- N independent scalar
# computations, one per lane, never reordered, fused, or reassociated across lanes --
# so the result is lane-exact-identical to the packed hardware backends, including
# the compare -> all-ones / all-zeros mask encoding and every IEEE-754 edge case
# (NaN, signed zero, rounding), which per-lane scalar ops reproduce for free.
#
# Representation: every vector value becomes a pointer to a 16-byte stack slot (an
# `[lanes]elem` array), exactly as an aggregate flows by address. A lane is a scalar
# load / store at its offset; an operator reads its operand lanes, computes per lane,
# and writes its result lanes. Vector-typed function signatures are left intact: a
# vector parameter / return is the ABI's memory (by-reference) class on rv64, so the
# callee receives / returns it by address, and this pass makes every body use of that
# value a pointer to match.

use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;
use mach.lang.target;
use vecform: mach.lang.me.vecform;

# per-function rewrite state, threaded through the expansion helpers
# ---
# m:       the module being legalized
# fn:      the function being legalized
# pval:    replacement pointer Value per original instruction id (a vector result's
#          16-byte slot address, a retyped phi / call result, meaningful where set)
# pval_set: whether pval[iid] holds a replacement
# n:       original instruction count (pval / pval_set are sized to it; ids >= n are
#          freshly emitted scalar instructions that never produce a vector value)
# is_vp:   whether parameter p is vector-typed (a body use becomes a pointer)
# pcount:  parameter count (bounds is_vp)
# void_ty: interned void type for stores
# ptr_ty:  interned pointer type for slots / lane addresses
# idx_ty:  interned integer type for gep lane indices (target pointer width)
# tgt:     the target, read only through `mem_image` to decide which vector values
#          this rewrite claims
# lane_buf: shared per-lane scratch for a gap expansion, grown on demand and owned
#          until `ctx_free`; nil until first use
# lane_cap: how many lanes `lane_buf` holds
rec Ctx {
    m:        *ir.Module;
    fn:       *ir.Function;
    tgt:      *target.Target;
    pval:     *value.Value;
    pval_set: *bool;
    n:        u32;
    is_vp:    *bool;
    pcount:   u32;
    void_ty:  ir_type.IrTypeId;
    ptr_ty:   ir_type.IrTypeId;
    idx_ty:   ir_type.IrTypeId;
    lane_buf: *value.Value;
    lane_cap: u32;
}

# the per-lane scratch a gap expansion assembles its lanes in, grown to hold `n`
#
# IT LIVES ON THE CONTEXT rather than on the stack of the function that uses it, and
# that is what removes the fixed bound (#2727). It was a `[16]value.Value` local with
# a lane-count refusal in front of it, sized 16 because the surface could not spell a
# vector with more lanes than a 128-bit register holds at its narrowest lane. With
# that bound gone the buffer has to be an allocation, and an allocation on the stack
# of a function with a dozen error returns is a dozen frees to get right. One owner,
# grown on demand, freed once in `ctx_free`: no expansion frees anything, and no
# error path can leak it.
#
# The buffer is live only within one expansion, and the two expansions that use it do
# not nest, so sharing it across them is safe by construction rather than by care.
fun lane_scratch(c: *Ctx, n: u32) R.Result[*value.Value, str] {
    if (c.lane_buf != nil && c.lane_cap >= n) { ret R.ok[*value.Value, str](c.lane_buf); }
    if (c.lane_buf != nil) {
        A.deallocate[value.Value](c.m.alloc, c.lane_buf, c.lane_cap::usize);
        c.lane_buf = nil;
        c.lane_cap = 0;
    }
    val rb: R.Result[*value.Value, str] = A.allocate[value.Value](c.m.alloc, n::usize);
    if (R.is_err[*value.Value, str](rb)) { ret rb; }
    c.lane_buf = R.unwrap_ok[*value.Value, str](rb);
    c.lane_cap = n;
    ret R.ok[*value.Value, str](c.lane_buf);
}

# whether a value of `ty` is a vector this target carries as a MEMORY IMAGE rather
# than in a vector register, so this pass owns it (#2727)
#
# THE SELECTION PREDICATE, and the whole of it. It replaced a bare `is_vector`, which
# was the same question only because the pass ran on all-or-nothing terms: a target
# with no vector unit held NO vector in a register, so "is a vector" and "is not
# register-resident" agreed everywhere the pass was allowed to run. They stop
# agreeing once a shape can be wider than the register on a target that has one, and
# the answer that generalises is the second.
#
# So `has_v128 == false` is no longer a special case: every vector on rv64gc answers
# true here and the pass rewrites all of them exactly as before, while on x86-64 only
# an over-width shape answers true and its `i32x4` neighbour keeps its packed
# register form. One rule, and the total case falls out of it rather than sitting
# beside it.
fun mem_image(c: *Ctx, ty: ir_type.IrTypeId) bool {
    ret !vecform.holds_in_register(c.m, c.tgt, ty);
}

# a vector type's element type, lane count, and element bit width
# ---
# elem:  scalar element IrTypeId
# lanes: number of lanes
# bits:  element bit width (a lane mask's width)
rec VInfo {
    elem:  ir_type.IrTypeId;
    lanes: u32;
    bits:  u32;
}

# whether a binary opcode is a lane-wise vector arithmetic / bitwise operator in the
# increment-1 table
#
# The legal set (#1965, narrowed by #2030): float `+ - * /` (float `/` lowers to
# OP_DIV_U), integer `+ -` at all widths, integer `*` on 16-bit lanes, and bitwise
# `& | ^`. Integer `/` `%` and shifts are NOT in the table -- `is_disallowed_op`
# rejects them loudly rather than silently expanding a form the language does not
# admit.
fun is_binary_op(k: instruction.InstrKind) bool {
    ret k == instruction.OP_ADD || k == instruction.OP_SUB || k == instruction.OP_MUL
        || k == instruction.OP_DIV_U
        || k == instruction.OP_AND || k == instruction.OP_OR || k == instruction.OP_XOR;
}

# whether a unary opcode is a lane-wise vector operator (bitwise not)
fun is_unary_op(k: instruction.InstrKind) bool {
    ret k == instruction.OP_NOT;
}

# whether an opcode is a vector operator OUTSIDE the increment-1 table: a shift
# (per-lane variable shift is AVX2/NEON-only, deferred by #2030), integer `/` `%`,
# or negate. A vector value carrying one is a defined loud error, never a silent
# expansion of a form sema is meant to reject.
fun is_disallowed_op(k: instruction.InstrKind) bool {
    ret k == instruction.OP_SHL || k == instruction.OP_SHR_S || k == instruction.OP_SHR_U
        || k == instruction.OP_DIV_S || k == instruction.OP_REM_S || k == instruction.OP_REM_U
        || k == instruction.OP_NEG;
}

# whether an opcode is a lane-wise vector comparison (result is the same-shape mask)
fun is_compare_op(k: instruction.InstrKind) bool {
    ret k == instruction.OP_CMP_EQ || k == instruction.OP_CMP_NE
        || k == instruction.OP_CMP_LT_S || k == instruction.OP_CMP_LT_U
        || k == instruction.OP_CMP_LE_S || k == instruction.OP_CMP_LE_U;
}

# whether an instruction is a lane-wise vector OPERATOR (the unit the note counts and
# the require lever names)
#
# Exactly the arithmetic / unary / comparison operators the pass expands per lane;
# loads, stores, phis, and calls carry vectors but are not operators.
fun is_operator(m: *ir.Module, inst: *instruction.Instruction) bool {
    if (!ir_type.is_vector(?m.types, inst.ty)) { ret false; }
    ret is_binary_op(inst.kind) || is_unary_op(inst.kind) || is_compare_op(inst.kind);
}

# whether an instruction is a `:~` bit reinterpret between two VECTOR types
#
# Both sides are 128 bits, so the cast moves no bytes and only renames the lane
# shape. It is the one vector-typed instruction the pass has no lane-wise expansion
# for and must not simply keep: kept, it reached the backend still carrying a vector
# type and tripped the no-SIMD guard, which reported a missing backend feature for
# what was really an unhandled op here (#2654).
#
# A bitcast with a vector on only one side is NOT this: it changes representation
# between a slot and a value, so it is left for the guard to reject rather than
# silently reinterpreted.
fun is_vector_bitcast(c: *Ctx, inst: *instruction.Instruction) bool {
    if (inst.kind != instruction.OP_BITCAST) { ret false; }
    if (inst.operand_count < 1)              { ret false; }
    if (!mem_image(c, inst.ty))              { ret false; }
    ret ir_type.is_vector(?c.m.types, inst.operands[0].ty);
}

# whether an instruction produces a vector result that needs a backing stack slot
#
# Arithmetic / unary / comparison operators, a whole-vector load, and a lane write
# each define a fresh vector value; a phi / call result is a vector too but is
# handled by retyping in place, and a store / ret consume a vector without producing
# one.
fun produces_vector(c: *Ctx, inst: *instruction.Instruction) bool {
    if (!mem_image(c, inst.ty)) { ret false; }
    ret is_binary_op(inst.kind) || is_unary_op(inst.kind) || is_compare_op(inst.kind)
        || inst.kind == instruction.OP_DECLASSIFY || inst.kind == instruction.OP_LOAD
        || inst.kind == instruction.OP_VEC_INSERT;
}

# a single would-scalarize site: the operator, its lane width, and its containing
# function
#
# The shared detection currency between this child's build-time note and the profile
# lever's (#2017) `require`-mode error, so both name the same operators by
# construction rather than re-deriving them from two independent walks.
#
# The lane width rides along because the shortfall is now per-operation rather than
# per-target (#2726): "multiply would scalarize" is not actionable on a target that
# packs the same multiply one lane width down, so the diagnostic names the width the
# gap is at.
#
# The lane COUNT rides along for the same reason one axis over (#2749). A target may
# have a packed form for the operation at this lane width and still not for THIS many
# lanes of it - SPIR-V packs four components and no more - and then naming only the
# width describes a gap that does not exist.
pub rec ScalarizeSite {
    fn_name:   intern.StrId;
    op:        instruction.InstrKind;
    lane_bits: u32;
    lanes:     u32;
}

# count the lane-wise vector operators in `m` whose realization on `tgt` is per-lane
# scalar code, filling `first` with the earliest one in program order
#
# Read-only: it inspects the IR without transforming it, so the profile lever can
# call it under `require` (where the expansion must not run) and this child calls it
# to set the note count -- both over the identical operator set. Walks block-listed
# instructions (the ones the expansion would rewrite); phis / calls / loads / stores
# carry vectors but are not operators and are not counted.
#
# The verdict comes from `vecform.realizes_packed` (#2726), the same authority the
# expansion stages act on, so the count, the note, the `require` error and the actual
# transformation cannot name different operators. Before this it was implicitly "every
# operator, because the target has no vector unit"; that is now just the case where the
# authority reports no packed form for anything.
# ---
# m:     the module to inspect
# tgt:   the target whose packed forms decide each operator's realization
# first: filled with the first operator's { containing function, opcode, lane width }
#        when the returned count is > 0; left unset when the count is 0
# ret:   the number of scalar-realized vector operators in the module
pub fun detect(m: *ir.Module, tgt: *target.Target, first: *ScalarizeSite) u32 {
    var count: u32 = 0;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var bi: u32 = 0;
            for (bi < fn.block_count) {
                val blk: *ir.Block = ?fn.blocks[bi];
                var ii: u32 = 0;
                for (ii < blk.instr_count) {
                    val inst: *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
                    if (is_operator(m, inst) && !vecform.realizes_packed(m, tgt, inst)) {
                        if (count == 0) {
                            first.fn_name   = fn.name;
                            first.op        = inst.kind;
                            first.lane_bits = 0;
                            first.lanes     = 0;
                            var d: vecform.LaneDesc;
                            if (vecform.lane_desc(m, inst, ?d)) {
                                first.lane_bits = d.lane_bits;
                                first.lanes     = d.lanes;
                            }
                        }
                        count = count + 1;
                    }
                    ii = ii + 1;
                }
                bi = bi + 1;
            }
        }
        fi = fi + 1;
    }
    ret count;
}

# read a vector type's element / lane / bit-width descriptor
# ---
# m:   the module (its type table)
# vty: a vector IrTypeId
# out: filled with the descriptor on success
# ret: ok(true), or an err if `vty` is not a resolvable vector
fun vec_info(m: *ir.Module, vty: ir_type.IrTypeId, out: *VInfo) R.Result[bool, str] {
    val opt_v: O.Option[*ir_type.IrType] = ir_type.get(?m.types, vty);
    if (O.is_none[*ir_type.IrType](opt_v)) { ret R.err[bool, str]("scalarize: operand is not a resolvable IR type"); }
    val vt: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_v);
    if (vt.kind != ir_type.IRT_VECTOR) { ret R.err[bool, str]("scalarize: expected an IR vector type"); }
    out.elem  = vt.data.vector_.element;
    out.lanes = vt.data.vector_.lanes;

    val opt_e: O.Option[*ir_type.IrType] = ir_type.get(?m.types, vt.data.vector_.element);
    if (O.is_none[*ir_type.IrType](opt_e)) { ret R.err[bool, str]("scalarize: vector element type not resolvable"); }
    out.bits = O.unwrap[*ir_type.IrType](opt_e).data.bits;
    ret R.ok[bool, str](true);
}

# create a fresh instruction in the function's pool with owned operands
#
# The pool-level primitive underlying every emit: it never links the instruction into
# a block, so the caller controls placement. Stamps `loc` for debug-line fidelity.
# ---
# ret: the new instruction id, or an allocation error
fun new_instr(m: *ir.Module, fn: *ir.Function, kind: instruction.InstrKind, ty: ir_type.IrTypeId,
              aux: ir_type.IrTypeId, ops: *value.Value, opn: u32, loc: source.SrcLoc) R.Result[id.InstructionId, str] {
    var owned: *value.Value = nil;
    if (opn > 0) {
        val ro: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, opn::usize);
        if (R.is_err[*value.Value, str](ro)) { ret R.err[id.InstructionId, str](R.unwrap_err[*value.Value, str](ro)); }
        owned = R.unwrap_ok[*value.Value, str](ro);
        var i: u32 = 0;
        for (i < opn) { owned[i] = ops[i]; i = i + 1; }
    }
    var ins: instruction.Instruction;
    ins.kind          = kind;
    ins.ty            = ty;
    ins.operands      = owned;
    ins.operand_count = opn;
    ins.operand_cap   = opn;
    ins.flags         = 0;
    ins.aux_ty        = aux;
    ins.loc           = loc;
    ins.secret        = false;   # default public; a secret lane read is marked by lane_secret (#1646)
    ret ir.instruction_add(m, fn, ins);
}

# create an instruction and append it to `blk`'s body, returning its result Value
fun push(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, ty: ir_type.IrTypeId,
         aux: ir_type.IrTypeId, ops: *value.Value, opn: u32, loc: source.SrcLoc) R.Result[value.Value, str] {
    val ri: R.Result[id.InstructionId, str] = new_instr(c.m, c.fn, kind, ty, aux, ops, opn, loc);
    if (R.is_err[id.InstructionId, str](ri)) { ret R.err[value.Value, str](R.unwrap_err[id.InstructionId, str](ri)); }
    val iid: id.InstructionId = R.unwrap_ok[id.InstructionId, str](ri);
    val rl: R.Result[bool, str] = ir.block_append_instr(c.m, blk, iid);
    if (R.is_err[bool, str](rl)) { ret R.err[value.Value, str](R.unwrap_err[bool, str](rl)); }
    ret R.ok[value.Value, str](value.instr(iid, ty));
}

# the pointer to lane `k` of the `[lanes]elem` slot at `base` (a `gep [0, k]`)
fun lane_ptr(c: *Ctx, blk: *ir.Block, base: value.Value, arr_ty: ir_type.IrTypeId, k: u32, loc: source.SrcLoc) R.Result[value.Value, str] {
    var ops: [3]value.Value;
    ops[0] = base;
    ops[1] = value.const_int(0, c.idx_ty);
    ops[2] = value.const_int(k::u64, c.idx_ty);
    ret push(c, blk, instruction.OP_GEP, c.ptr_ty, arr_ty, ?ops[0], 3, loc);
}

# a scalar load of `elem_ty` from `ptr`
fun emit_load(c: *Ctx, blk: *ir.Block, ptr: value.Value, elem_ty: ir_type.IrTypeId, loc: source.SrcLoc) R.Result[value.Value, str] {
    var ops: [1]value.Value;
    ops[0] = ptr;
    ret push(c, blk, instruction.OP_LOAD, elem_ty, ir_type.IRT_NIL, ?ops[0], 1, loc);
}

# a scalar store of `v` to `ptr`
fun emit_store(c: *Ctx, blk: *ir.Block, v: value.Value, ptr: value.Value, loc: source.SrcLoc) R.Result[bool, str] {
    var ops: [2]value.Value;
    ops[0] = v;
    ops[1] = ptr;
    val r: R.Result[value.Value, str] = push(c, blk, instruction.OP_STORE, c.void_ty, ir_type.IRT_NIL, ?ops[0], 2, loc);
    if (R.is_err[value.Value, str](r)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](r)); }
    ret R.ok[bool, str](true);
}

# mark a scalarized lane read of a secret vector operand as secret (#1646)
#
# Every lane of a secret vector is secret (welded storage), so a lane read of a secret
# operand is a secret scalar. Marks both the loaded VALUE - so a scalarized
# variable-latency op (an integer multiply on a SIMD-incapable target) still trips the
# MIR gate, closing the scalarize taint-laundering hole - and the load INSTRUCTION, so
# it is a secret-source seed the #1648 re-derive starts from. A public operand is
# untouched, so non-secret vector code is unchanged.
# ---
# c:          the scalarize context
# loaded:     the lane-load result value
# src_secret: whether the vector operand the lane was read from is secret
# ret:        `loaded`, marked secret when `src_secret`
fun lane_secret(c: *Ctx, loaded: value.Value, src_secret: bool) value.Value {
    if (!src_secret) { ret loaded; }
    var v: value.Value = loaded;
    v.secret = true;
    instruction.mark_result_secret(c.fn.instrs, c.fn.instr_len, v);
    ret v;
}

# a scalar binary op `kind ty a, b`
fun emit_binop(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, ty: ir_type.IrTypeId, a: value.Value, b: value.Value, loc: source.SrcLoc) R.Result[value.Value, str] {
    var ops: [2]value.Value;
    ops[0] = a;
    ops[1] = b;
    ret push(c, blk, kind, ty, ir_type.IRT_NIL, ?ops[0], 2, loc);
}

# a scalar unary op `kind ty a`
fun emit_unop(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, ty: ir_type.IrTypeId, a: value.Value, loc: source.SrcLoc) R.Result[value.Value, str] {
    var ops: [1]value.Value;
    ops[0] = a;
    ret push(c, blk, kind, ty, ir_type.IRT_NIL, ?ops[0], 1, loc);
}

# resolve a value to its scalarized replacement
#
# A vector-typed instruction result resolves to its slot pointer; a vector parameter
# resolves to the same-index pointer parameter (byref on rv64, so the register holds
# the address); everything else passes through unchanged.
fun resolve(c: *Ctx, v: value.Value) value.Value {
    if (v.kind == value.VAL_INSTR) {
        val iid: u32 = v.data.instr::u32;
        if (iid < c.n && c.pval_set[iid]) { ret c.pval[iid]; }
        ret v;
    }
    if (v.kind == value.VAL_PARAM) {
        val p: u32 = v.data.param_ix;
        if (p < c.pcount && c.is_vp[p]) { ret value.param(p, c.ptr_ty); }
        ret v;
    }
    ret v;
}

# rewrite every operand of `inst` through `resolve`, in place
#
# Used for the kept instructions, the phi value operands, and the terminator: a
# vector value naming a scalarized producer becomes its slot pointer. Block-target
# operands ride in VAL_CONST_INT slots and pass through untouched.
fun rewrite_ops(c: *Ctx, inst: *instruction.Instruction) {
    var i: u32 = 0;
    for (i < inst.operand_count) {
        inst.operands[i] = resolve(c, inst.operands[i]);
        i = i + 1;
    }
}

# expand a lane-wise arithmetic / bitwise binary vector operator into N scalar ops
#
# reads lane k of each operand slot, applies the scalar op, stores lane k of the
# result slot -- N independent computations, no cross-lane interaction.
fun expand_binary(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, dst: value.Value, a: value.Value, b: value.Value, a_secret: bool, b_secret: bool, vi: VInfo, loc: source.SrcLoc) R.Result[bool, str] {
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }
    val arr: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    var k: u32 = 0;
    for (k < vi.lanes) {
        val pa: R.Result[value.Value, str] = lane_ptr(c, blk, a, arr, k, loc);
        if (R.is_err[value.Value, str](pa)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pa)); }
        val va: R.Result[value.Value, str] = emit_load(c, blk, R.unwrap_ok[value.Value, str](pa), vi.elem, loc);
        if (R.is_err[value.Value, str](va)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](va)); }

        val pb: R.Result[value.Value, str] = lane_ptr(c, blk, b, arr, k, loc);
        if (R.is_err[value.Value, str](pb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pb)); }
        val vb: R.Result[value.Value, str] = emit_load(c, blk, R.unwrap_ok[value.Value, str](pb), vi.elem, loc);
        if (R.is_err[value.Value, str](vb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](vb)); }

        # a lane of a secret vector operand is secret, so the scalar op inherits the taint:
        # this is what makes a scalarized secret multiply trip the MIR gate (#1646).
        val va_v: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](va), a_secret);
        val vb_v: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](vb), b_secret);
        val vr: R.Result[value.Value, str] = emit_binop(c, blk, kind, vi.elem, va_v, vb_v, loc);
        if (R.is_err[value.Value, str](vr)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](vr)); }

        val pr: R.Result[value.Value, str] = lane_ptr(c, blk, dst, arr, k, loc);
        if (R.is_err[value.Value, str](pr)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pr)); }
        val rs: R.Result[bool, str] = emit_store(c, blk, R.unwrap_ok[value.Value, str](vr), R.unwrap_ok[value.Value, str](pr), loc);
        if (R.is_err[bool, str](rs)) { ret rs; }
        k = k + 1;
    }
    ret R.ok[bool, str](true);
}

# expand a lane-wise unary vector operator (bitwise not, negate, or a `:^` declassify)
# into N scalar ops. `a_secret` is the original operand's secrecy (resolve drops it),
# so a lane read of a secret operand is tainted - and for OP_DECLASSIFY, each per-lane
# OP_DECLASSIFY then declassifies its secret lane to a public result, so a vector `:^`
# lowers on a no-SIMD target instead of tripping the v128 guard (#1646).
fun expand_unary(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, dst: value.Value, a: value.Value, a_secret: bool, vi: VInfo, loc: source.SrcLoc) R.Result[bool, str] {
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }
    val arr: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    var k: u32 = 0;
    for (k < vi.lanes) {
        val pa: R.Result[value.Value, str] = lane_ptr(c, blk, a, arr, k, loc);
        if (R.is_err[value.Value, str](pa)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pa)); }
        val va: R.Result[value.Value, str] = emit_load(c, blk, R.unwrap_ok[value.Value, str](pa), vi.elem, loc);
        if (R.is_err[value.Value, str](va)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](va)); }

        val va_v: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](va), a_secret);
        val vr: R.Result[value.Value, str] = emit_unop(c, blk, kind, vi.elem, va_v, loc);
        if (R.is_err[value.Value, str](vr)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](vr)); }

        val pr: R.Result[value.Value, str] = lane_ptr(c, blk, dst, arr, k, loc);
        if (R.is_err[value.Value, str](pr)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pr)); }
        val rs: R.Result[bool, str] = emit_store(c, blk, R.unwrap_ok[value.Value, str](vr), R.unwrap_ok[value.Value, str](pr), loc);
        if (R.is_err[bool, str](rs)) { ret rs; }
        k = k + 1;
    }
    ret R.ok[bool, str](true);
}

# expand a lane-wise vector comparison into N scalar compares each writing a full-width
# mask lane (all-ones for true, all-zeros for false)
#
# The operand element carries the compared values (`op`); the result mask element is a
# same-width integer. Per lane: a scalar compare yields a 0/1 boolean, widened to the
# mask width and negated (`0 - z`) so a true lane is all-ones in two's complement --
# lane-for-lane identical to CMPPS / FCMEQ, including the NaN outcome the scalar
# ordered / unordered compare reproduces.
fun expand_compare(c: *Ctx, blk: *ir.Block, kind: instruction.InstrKind, dst: value.Value, a: value.Value, b: value.Value,
                   op: VInfo, mask: VInfo, i8_ty: ir_type.IrTypeId, loc: source.SrcLoc) R.Result[bool, str] {
    val rao: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, op.elem, op.lanes);
    if (R.is_err[ir_type.IrTypeId, str](rao)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rao)); }
    val arr_op: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rao);
    val ram: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, mask.elem, mask.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ram)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ram)); }
    val arr_mask: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ram);

    # a signed ordering compare of a sub-word lane must sign-extend both operands to a
    # register-canonical width before the scalar compare: rv64's sub-word integer loads
    # zero-extend (lbu / lhu), so a negative i8 / i16 lane would otherwise be read as its
    # large unsigned bit pattern and `-1 < 0` would evaluate false (#2077). i32 / i64
    # lanes load sign-canonical (lw / ld), and equality / unsigned relations read the
    # zero-extended lane correctly, so neither needs the extension.
    val need_sext: bool = (kind == instruction.OP_CMP_LT_S || kind == instruction.OP_CMP_LE_S) && op.bits < 32;
    var ext_ty: ir_type.IrTypeId = ir_type.IRT_NIL;
    if (need_sext) {
        val rx: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?c.m.types, 32);
        if (R.is_err[ir_type.IrTypeId, str](rx)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rx)); }
        ext_ty = R.unwrap_ok[ir_type.IrTypeId, str](rx);
    }

    var k: u32 = 0;
    for (k < op.lanes) {
        val pa: R.Result[value.Value, str] = lane_ptr(c, blk, a, arr_op, k, loc);
        if (R.is_err[value.Value, str](pa)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pa)); }
        val va: R.Result[value.Value, str] = emit_load(c, blk, R.unwrap_ok[value.Value, str](pa), op.elem, loc);
        if (R.is_err[value.Value, str](va)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](va)); }

        val pb: R.Result[value.Value, str] = lane_ptr(c, blk, b, arr_op, k, loc);
        if (R.is_err[value.Value, str](pb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pb)); }
        val vb: R.Result[value.Value, str] = emit_load(c, blk, R.unwrap_ok[value.Value, str](pb), op.elem, loc);
        if (R.is_err[value.Value, str](vb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](vb)); }

        var la: value.Value = R.unwrap_ok[value.Value, str](va);
        var lb: value.Value = R.unwrap_ok[value.Value, str](vb);
        # sign-extend the narrow signed operands (see need_sext above) so the scalar
        # compare reads them at register width in two's complement.
        if (need_sext) {
            val sa: R.Result[value.Value, str] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, la, loc);
            if (R.is_err[value.Value, str](sa)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](sa)); }
            la = R.unwrap_ok[value.Value, str](sa);
            val sb: R.Result[value.Value, str] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, lb, loc);
            if (R.is_err[value.Value, str](sb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](sb)); }
            lb = R.unwrap_ok[value.Value, str](sb);
        }

        # a scalar compare of the two lanes yields an 8-bit 0/1 boolean.
        val cmp: R.Result[value.Value, str] = emit_binop(c, blk, kind, i8_ty, la, lb, loc);
        if (R.is_err[value.Value, str](cmp)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](cmp)); }
        var wide: value.Value = R.unwrap_ok[value.Value, str](cmp);

        # widen the boolean to the mask lane width (identity when the mask is 8-bit).
        if (mask.bits != 8) {
            val z: R.Result[value.Value, str] = emit_unop(c, blk, instruction.OP_ZEXT, mask.elem, wide, loc);
            if (R.is_err[value.Value, str](z)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](z)); }
            wide = R.unwrap_ok[value.Value, str](z);
        }

        # negate: 0 - {0,1} is {0, all-ones} in two's complement at the mask width.
        val neg: R.Result[value.Value, str] = emit_binop(c, blk, instruction.OP_SUB, mask.elem, value.const_int(0, mask.elem), wide, loc);
        if (R.is_err[value.Value, str](neg)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](neg)); }

        val pr: R.Result[value.Value, str] = lane_ptr(c, blk, dst, arr_mask, k, loc);
        if (R.is_err[value.Value, str](pr)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pr)); }
        val rs: R.Result[bool, str] = emit_store(c, blk, R.unwrap_ok[value.Value, str](neg), R.unwrap_ok[value.Value, str](pr), loc);
        if (R.is_err[bool, str](rs)) { ret rs; }
        k = k + 1;
    }
    ret R.ok[bool, str](true);
}

# copy the 16 bytes of a vector from `src` to `dst`, lane by lane (a whole-vector
# load's snapshot, or a whole-vector store)
fun copy_vector(c: *Ctx, blk: *ir.Block, dst: value.Value, src: value.Value, vi: VInfo, loc: source.SrcLoc) R.Result[bool, str] {
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }
    val arr: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    var k: u32 = 0;
    for (k < vi.lanes) {
        val ps: R.Result[value.Value, str] = lane_ptr(c, blk, src, arr, k, loc);
        if (R.is_err[value.Value, str](ps)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](ps)); }
        val v: R.Result[value.Value, str] = emit_load(c, blk, R.unwrap_ok[value.Value, str](ps), vi.elem, loc);
        if (R.is_err[value.Value, str](v)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](v)); }

        val pd: R.Result[value.Value, str] = lane_ptr(c, blk, dst, arr, k, loc);
        if (R.is_err[value.Value, str](pd)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](pd)); }
        val rs: R.Result[bool, str] = emit_store(c, blk, R.unwrap_ok[value.Value, str](v), R.unwrap_ok[value.Value, str](pd), loc);
        if (R.is_err[bool, str](rs)) { ret rs; }
        k = k + 1;
    }
    ret R.ok[bool, str](true);
}

# create a fresh `[lanes]elem` stack slot for `vty` in the entry block's alloca set,
# returning its pointer Value
#
# The slot is emitted into `entry`'s body front later (it must dominate every use);
# here it is only created in the pool and its id recorded in `slots`.
fun make_slot(c: *Ctx, vty: ir_type.IrTypeId, slots: *id.InstructionId, slot_len: *u32) R.Result[value.Value, str] {
    var vi: VInfo;
    val vr: R.Result[bool, str] = vec_info(c.m, vty, ?vi);
    if (R.is_err[bool, str](vr)) { ret R.err[value.Value, str](R.unwrap_err[bool, str](vr)); }
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[value.Value, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }
    val arr: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    var ops: [1]value.Value;
    ops[0] = value.const_int(1, c.idx_ty);
    val ri: R.Result[id.InstructionId, str] = new_instr(c.m, c.fn, instruction.OP_ALLOCA, c.ptr_ty, arr, ?ops[0], 1, source.loc(source.FILE_NIL, 0));
    if (R.is_err[id.InstructionId, str](ri)) { ret R.err[value.Value, str](R.unwrap_err[id.InstructionId, str](ri)); }
    val iid: id.InstructionId = R.unwrap_ok[id.InstructionId, str](ri);
    slots[@slot_len] = iid;
    @slot_len = @slot_len + 1;
    ret R.ok[value.Value, str](value.instr(iid, c.ptr_ty));
}

# retype an alloca / gep whose aggregate type is a vector to the equivalent
# `[lanes]elem` array, so the back end strides and sizes it as ordinary array memory
# and no `IRT_VECTOR` is referenced after the pass
fun retype_aux(c: *Ctx, inst: *instruction.Instruction) R.Result[bool, str] {
    if (inst.aux_ty == ir_type.IRT_NIL) { ret R.ok[bool, str](true); }
    if (!mem_image(c, inst.aux_ty)) { ret R.ok[bool, str](true); }
    var vi: VInfo;
    val vr: R.Result[bool, str] = vec_info(c.m, inst.aux_ty, ?vi);
    if (R.is_err[bool, str](vr)) { ret vr; }
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }
    inst.aux_ty = R.unwrap_ok[ir_type.IrTypeId, str](ra);
    ret R.ok[bool, str](true);
}

# legalize one function: no IRT_VECTOR value or operand survives afterward
fun scalarize_function(c: *Ctx, i8_ty: ir_type.IrTypeId) R.Result[bool, str] {
    val fn: *ir.Function = c.fn;

    # slot ids created in the pre-pass, prepended to the entry block in the fill pass.
    var slots:    *id.InstructionId = nil;
    var slot_len: u32 = 0;
    if (c.n > 0) {
        val rs: R.Result[*id.InstructionId, str] = A.allocate[id.InstructionId](c.m.alloc, c.n::usize);
        if (R.is_err[*id.InstructionId, str](rs)) { ret R.err[bool, str](R.unwrap_err[*id.InstructionId, str](rs)); }
        slots = R.unwrap_ok[*id.InstructionId, str](rs);
    }

    # pre-pass: give every vector-producing instruction its pointer representation,
    # and retype vector allocas / geps to array form. iterate the pool by id so a
    # phi's incoming producers are mapped before the fill pass reads them.
    var iid: u32 = 0;
    for (iid < c.n) {
        val inst: *instruction.Instruction = ?fn.instrs[iid];
        # a vector operator outside the increment-1 table (a shift, integer `/` `%`,
        # negate) is a defined loud error, never a silent expansion (#2030).
        if (mem_image(c, inst.ty) && is_disallowed_op(inst.kind)) {
            slots_free(c, slots);
            ret R.err[bool, str]("scalarize: vector operator is not in the increment-1 table (shift / integer div-rem / negate)");
        }
        # a `:~` INTO a vector from a non-vector is a representation change, not the
        # lane rename `is_vector_bitcast` aliases away, and the pass has no expansion
        # for it. Reject it here, naming the construct: left to fall through it
        # reached the backend still vector-typed and was reported as a missing
        # 128-bit vector feature, which named the wrong component entirely (#2654).
        if (inst.kind == instruction.OP_BITCAST && inst.operand_count >= 1
            && mem_image(c, inst.ty)
            && !ir_type.is_vector(?c.m.types, inst.operands[0].ty)) {
            slots_free(c, slots);
            ret R.err[bool, str]("scalarize: a bit reinterpret into a vector from a non-vector type is not expanded on a target without SIMD");
        }
        if (inst.kind == instruction.OP_ALLOCA || inst.kind == instruction.OP_GEP) {
            val rr: R.Result[bool, str] = retype_aux(c, inst);
            if (R.is_err[bool, str](rr)) { slots_free(c, slots); ret rr; }
        } or (produces_vector(c, inst)) {
            val vty: ir_type.IrTypeId = inst.ty;
            val ms: R.Result[value.Value, str] = make_slot(c, vty, slots, ?slot_len);
            if (R.is_err[value.Value, str](ms)) { slots_free(c, slots); ret R.err[bool, str](R.unwrap_err[value.Value, str](ms)); }
            c.pval[iid]     = R.unwrap_ok[value.Value, str](ms);
            c.pval_set[iid] = true;
        } or (inst.kind == instruction.OP_PHI && mem_image(c, inst.ty)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        } or (inst.kind == instruction.OP_CALL && mem_image(c, inst.ty)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        } or (is_vector_bitcast(c, inst)) {
            # a `:~` between two vector types is a pure reinterpret of the same 16
            # bytes, so in the pointer representation it is a no-op: source and
            # result denote one slot. Retyping it to ptr (exactly as a vector phi /
            # call result is retyped) turns it into a pointer-to-pointer bitcast the
            # backend already lowers, and `rewrite_ops` rewrites its operand to the
            # source slot in the fill pass.
            #
            # Retyping rather than aliasing `pval` straight to the operand is
            # deliberate: the pre-pass runs in instruction-id order, and a bitcast
            # whose operand is a loop-carried phi would read that phi before it was
            # mapped. Keeping the instruction defers the operand rewrite to the fill
            # pass, by which point every mapping is settled (#2654).
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        }
        iid = iid + 1;
    }

    # fill pass: rewrite each block's body, expanding operators and copying loads /
    # stores. BODIES ONLY - the phi value operands and the terminator are left to the
    # whole-function substitution below.
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        val rf: R.Result[bool, str] = fill_block(c, blk, bi == 0, slots, slot_len, i8_ty);
        if (R.is_err[bool, str](rf)) { slots_free(c, slots); ret rf; }
        bi = bi + 1;
    }

    # WHOLE-FUNCTION operand substitution, for the same reason the gap-operator stage
    # needs one (#2749, #2917). A lane read's replacement load is not mapped until its
    # own block is filled, and a use is not confined to a block already walked: the
    # merge phi of an `if` that assigns a lane sits at a LOWER block index than the
    # block computing the lane, and a loop header's phi names a value the latch
    # defines. Rewriting a block's phis while later blocks are still unfilled left
    # those operands naming an instruction this pass had dropped, and MIR phi
    # destruction then emitted no copy at all on that edge - a silent wrong answer on
    # rv64, where the merge register was read undefined.
    rewrite_uses(c, fn);

    slots_free(c, slots);
    ret R.ok[bool, str](true);
}

# free the pre-pass slot-id scratch array
fun slots_free(c: *Ctx, slots: *id.InstructionId) {
    if (slots != nil && c.n > 0) {
        A.deallocate[id.InstructionId](c.m.alloc, slots, c.n::usize);
    }
}

# rebuild one block's body, expanding vector operators into per-lane scalar sequences
fun fill_block(c: *Ctx, blk: *ir.Block, is_entry: bool, slots: *id.InstructionId, slot_len: u32, i8_ty: ir_type.IrTypeId) R.Result[bool, str] {
    # snapshot the old body ids: the fill re-appends into a cleared body, and emits
    # fresh instructions between them, so the original order is preserved.
    val old_len: u32 = blk.instr_count;
    var old: *id.InstructionId = nil;
    if (old_len > 0) {
        val ro: R.Result[*id.InstructionId, str] = A.allocate[id.InstructionId](c.m.alloc, old_len::usize);
        if (R.is_err[*id.InstructionId, str](ro)) { ret R.err[bool, str](R.unwrap_err[*id.InstructionId, str](ro)); }
        old = R.unwrap_ok[*id.InstructionId, str](ro);
        var i: u32 = 0;
        for (i < old_len) { old[i] = blk.instructions[i]; i = i + 1; }
    }
    blk.instr_count = 0;

    # the entry block's alloca slots dominate every use, so they lead the body.
    if (is_entry) {
        var s: u32 = 0;
        for (s < slot_len) {
            val ra: R.Result[bool, str] = ir.block_append_instr(c.m, blk, slots[s]);
            if (R.is_err[bool, str](ra)) { body_free(c, old, old_len); ret ra; }
            s = s + 1;
        }
    }

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur: id.InstructionId = old[oi];
        val rr: R.Result[bool, str] = fill_one(c, blk, cur, i8_ty);
        if (R.is_err[bool, str](rr)) { body_free(c, old, old_len); ret rr; }
        oi = oi + 1;
    }

    body_free(c, old, old_len);
    ret R.ok[bool, str](true);
}

# free the snapshot body-id array
fun body_free(c: *Ctx, old: *id.InstructionId, old_len: u32) {
    if (old != nil && old_len > 0) {
        A.deallocate[id.InstructionId](c.m.alloc, old, old_len::usize);
    }
}

# expand a lane READ on a scalarized target: a gep + scalar load out of the source
# vector's slot (#2236)
#
# The lane's secrecy follows the same welded-storage rule as every other scalarized
# lane read: a lane of a secret vector is a secret scalar.
fun expand_lane_read_scalarized(c: *Ctx, blk: *ir.Block, cur: id.InstructionId) R.Result[bool, str] {
    val ip: *instruction.Instruction = ?c.fn.instrs[cur::u32];
    val src_ty: ir_type.IrTypeId = ip.operands[0].ty;
    val elem:   ir_type.IrTypeId = ip.ty;
    val loc:    source.SrcLoc    = ip.loc;
    val secret: bool             = ip.operands[0].secret;

    if (ip.operands[1].kind != value.VAL_CONST_INT) {
        ret R.err[bool, str]("scalarize: vector lane index is not a constant");
    }
    val k: u32 = ip.operands[1].data.int_lit::u32;
    val base: value.Value = resolve(c, ip.operands[0]);

    var vi: VInfo;
    val rv: R.Result[bool, str] = vec_info(c.m, src_ty, ?vi);
    if (R.is_err[bool, str](rv)) { ret rv; }
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }

    val rp: R.Result[value.Value, str] = lane_ptr(c, blk, base, R.unwrap_ok[ir_type.IrTypeId, str](ra), k, loc);
    if (R.is_err[value.Value, str](rp)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rp)); }
    val rl: R.Result[value.Value, str] = emit_load(c, blk, R.unwrap_ok[value.Value, str](rp), elem, loc);
    if (R.is_err[value.Value, str](rl)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rl)); }

    c.pval[cur::u32]     = lane_secret(c, R.unwrap_ok[value.Value, str](rl), secret);
    c.pval_set[cur::u32] = true;
    ret R.ok[bool, str](true);
}

# expand a lane WRITE on a scalarized target: copy the source vector into the
# result's slot, then store the one lane (#2236)
#
# The copy keeps the opcode functional - the source vector's slot is untouched -
# which is what lets the IR opcode compose in SSA with no aliasing story.
fun expand_lane_write_scalarized(c: *Ctx, blk: *ir.Block, cur: id.InstructionId) R.Result[bool, str] {
    val ip: *instruction.Instruction = ?c.fn.instrs[cur::u32];
    val vty: ir_type.IrTypeId = ip.ty;
    val loc: source.SrcLoc    = ip.loc;

    if (ip.operands[1].kind != value.VAL_CONST_INT) {
        ret R.err[bool, str]("scalarize: vector lane index is not a constant");
    }
    val k: u32 = ip.operands[1].data.int_lit::u32;
    val dst: value.Value = c.pval[cur::u32];
    val src: value.Value = resolve(c, ip.operands[0]);
    val lane_val: value.Value = resolve(c, ip.operands[2]);

    var vi: VInfo;
    val rv: R.Result[bool, str] = vec_info(c.m, vty, ?vi);
    if (R.is_err[bool, str](rv)) { ret rv; }
    val rc: R.Result[bool, str] = copy_vector(c, blk, dst, src, vi, loc);
    if (R.is_err[bool, str](rc)) { ret rc; }

    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }
    val rp: R.Result[value.Value, str] = lane_ptr(c, blk, dst, R.unwrap_ok[ir_type.IrTypeId, str](ra), k, loc);
    if (R.is_err[value.Value, str](rp)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rp)); }
    ret emit_store(c, blk, lane_val, R.unwrap_ok[value.Value, str](rp), loc);
}

# process one original body instruction: expand a vector operator, copy a vector
# load / store, or keep and operand-rewrite anything else
fun fill_one(c: *Ctx, blk: *ir.Block, cur: id.InstructionId, i8_ty: ir_type.IrTypeId) R.Result[bool, str] {
    val fn: *ir.Function = c.fn;

    # copy out everything read from the instruction: emitting fresh instructions can
    # reallocate the pool and invalidate this pointer.
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val kind: instruction.InstrKind = ip.kind;
    val ty:   ir_type.IrTypeId = ip.ty;
    val loc:  source.SrcLoc = ip.loc;
    val is_vec_ty: bool = mem_image(c, ty);

    # a vector arithmetic / unary / comparison operator, a `:^` declassify, or a
    # whole-vector load. a vector OP_DECLASSIFY expands per-lane like a unary op (each
    # lane is an identity declassify), so a vector `:^` scalarizes instead of reaching
    # the v128 guard on a no-SIMD target (#1646).
    if (is_vec_ty && (is_binary_op(kind) || is_unary_op(kind) || is_compare_op(kind)
        || kind == instruction.OP_DECLASSIFY || kind == instruction.OP_LOAD)) {
        val dst: value.Value = c.pval[cur::u32];
        if (is_compare_op(kind)) {
            val op0: value.Value = resolve(c, ip.operands[0]);
            val op1: value.Value = resolve(c, ip.operands[1]);
            val op0ty: ir_type.IrTypeId = ip.operands[0].ty;
            var opi: VInfo;
            val re: R.Result[bool, str] = vec_info(c.m, op0ty, ?opi);
            if (R.is_err[bool, str](re)) { ret re; }
            var mi: VInfo;
            val rm: R.Result[bool, str] = vec_info(c.m, ty, ?mi);
            if (R.is_err[bool, str](rm)) { ret rm; }
            ret expand_compare(c, blk, kind, dst, op0, op1, opi, mi, i8_ty, loc);
        }
        var vi: VInfo;
        val rv: R.Result[bool, str] = vec_info(c.m, ty, ?vi);
        if (R.is_err[bool, str](rv)) { ret rv; }
        if (kind == instruction.OP_LOAD) {
            val src: value.Value = resolve(c, ip.operands[0]);
            ret copy_vector(c, blk, dst, src, vi, loc);
        }
        if (is_unary_op(kind) || kind == instruction.OP_DECLASSIFY) {
            val a: value.Value = resolve(c, ip.operands[0]);
            ret expand_unary(c, blk, kind, dst, a, ip.operands[0].secret, vi, loc);
        }
        val a: value.Value = resolve(c, ip.operands[0]);
        val b: value.Value = resolve(c, ip.operands[1]);
        # pass the ORIGINAL operands' secrecy (resolve turns a secret vector into a public
        # slot pointer, dropping the bit) so a lane read of a secret operand is tainted and
        # a scalarized secret multiply trips the MIR gate (#1646).
        ret expand_binary(c, blk, kind, dst, a, b, ip.operands[0].secret, ip.operands[1].secret, vi, loc);
    }

    # lane access (#2236). the scalarizer already gives every vector value a slot, so a
    # lane read is a gep + scalar load out of the source's slot and a lane write is a
    # whole-vector copy into the result's slot followed by one lane store. handling it
    # here rather than pre-expanding it means a scalarized target reserves ONE slot per
    # vector, not one from each pass.
    if (kind == instruction.OP_VEC_EXTRACT && mem_image(c, ip.operands[0].ty)) {
        ret expand_lane_read_scalarized(c, blk, cur);
    }
    if (kind == instruction.OP_VEC_INSERT && is_vec_ty) {
        ret expand_lane_write_scalarized(c, blk, cur);
    }

    # a whole-vector store: copy the source slot's 16 bytes to the destination.
    if (kind == instruction.OP_STORE && mem_image(c, ip.operands[0].ty)) {
        val srcv: value.Value = resolve(c, ip.operands[0]);
        val dstp: value.Value = resolve(c, ip.operands[1]);
        val vty:  ir_type.IrTypeId = ip.operands[0].ty;
        var vi: VInfo;
        val rv: R.Result[bool, str] = vec_info(c.m, vty, ?vi);
        if (R.is_err[bool, str](rv)) { ret rv; }
        ret copy_vector(c, blk, dstp, srcv, vi, loc);
    }

    # everything else is kept: rewrite its operands to the pointer representation and
    # re-link it into the rebuilt body in its original position.
    rewrite_ops(c, ?fn.instrs[cur::u32]);
    ret ir.block_append_instr(c.m, blk, cur);
}

# per-function state for the lane-access expansion (#2236)
#
# Wraps the shared `Ctx` so the expansion emits through the same `push` / `lane_ptr`
# / `emit_load` / `emit_store` helpers the scalarizer uses. `c.pval` carries the
# REPLACEMENT VALUE of each expanded lane op (the scalar a read became, the reloaded
# vector a write became), so `rewrite_ops` redirects later uses exactly as it does
# for the full pass. `c.pcount` is held at 0: this pass never retypes a parameter, so
# `resolve`'s parameter arm must stay inert.
# ---
# c:         the shared rewrite context (pval carries lane-op replacements)
# slot:      per instruction id, the stack slot holding that vector value
# slot_set:  whether slot[iid] is meaningful
# store_at:  whether a `store <result>, slot[iid]` follows instruction iid; false for
#            a lane write, whose own expansion stores into its result slot
# slot_alloca: per instruction id, the alloca instruction backing slot[iid]; linked
#            into the body at the definition it homes
# pslot:     per parameter index, the stack slot holding that vector parameter
# pslot_set: whether pslot[p] is meaningful
# pallocas:  parameter slot alloca ids, prepended to the entry block (a parameter has
#            no defining instruction to sit beside)
# palloca_len: number of parameter slot allocas
# pn:        parameter count (bounds pslot / pslot_set / pallocas)
rec LaneCtx {
    c:           Ctx;
    slot:        *value.Value;
    slot_set:    *bool;
    store_at:    *bool;
    slot_alloca: *id.InstructionId;
    pslot:       *value.Value;
    pslot_set:   *bool;
    pallocas:    *id.InstructionId;
    palloca_len: u32;
    pn:          u32;
}

# create the stack slot a lane expansion addresses a vector through
#
# Unlike `make_slot`, the slot is typed by the VECTOR, not by its `[lanes]elem` view:
# a vector aligns to 16 and an array of its lanes only to the lane element, so the
# array shape would hand the frame a 16-byte object with 4-byte alignment. The lane
# GEPs still walk the array view - only the storage's size and alignment come from
# the vector. On a SIMD-incapable target `scalarize.run`'s `retype_aux` retypes this
# alloca to the array form afterwards, exactly as it does every other vector slot.
#
# The alloca is created in the pool but not linked: the caller places it, because
# unlike the scalarizer's entry-block slots these are placed AT THE DEFINITION they
# home. An alloca lowers to a static frame reservation plus an address
# materialization, so a def-site placement dominates every use exactly as an entry
# placement does, while keeping the address's live range to the span that uses it -
# hoisting them all to the entry made every slot pointer live at once and cost
# callee-saved spills on a function with several lane-read vectors.
fun make_lane_slot(c: *Ctx, vty: ir_type.IrTypeId, out_id: *id.InstructionId) R.Result[value.Value, str] {
    var ops: [1]value.Value;
    ops[0] = value.const_int(1, c.idx_ty);
    val ri: R.Result[id.InstructionId, str] = new_instr(c.m, c.fn, instruction.OP_ALLOCA, c.ptr_ty, vty, ?ops[0], 1, source.loc(source.FILE_NIL, 0));
    if (R.is_err[id.InstructionId, str](ri)) { ret R.err[value.Value, str](R.unwrap_err[id.InstructionId, str](ri)); }
    val iid: id.InstructionId = R.unwrap_ok[id.InstructionId, str](ri);
    @out_id = iid;
    ret R.ok[value.Value, str](value.instr(iid, c.ptr_ty));
}

# whether a function contains any lane access at all
fun has_lane_op(fn: *ir.Function) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val k: instruction.InstrKind = fn.instrs[i].kind;
        if (k == instruction.OP_VEC_EXTRACT || k == instruction.OP_VEC_INSERT) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the constant lane index of a lane op, or an error when it is not a constant
fun lane_index_of(inst: *instruction.Instruction) R.Result[u32, str] {
    if (inst.operands[1].kind != value.VAL_CONST_INT) {
        ret R.err[u32, str]("scalarize: vector lane index is not a constant");
    }
    ret R.ok[u32, str](inst.operands[1].data.int_lit::u32);
}

# reserve the stack slot a lane READ will address `v` through, if it has none yet
#
# A value already carrying a slot - a lane write's result, or an earlier read's
# source - is reused, so N reads of one vector share one slot and one store, which is
# both the shape the pre-#2236 lowering produced and the one that avoids re-spilling
# the vector per lane.
# ---
# lc: the lane-expansion state
# v:  the vector value a lane is being read out of
# ret: ok(true) once a slot exists for `v`, or an error
fun reserve_read_slot(lc: *LaneCtx, v: value.Value) R.Result[bool, str] {
    if (v.kind == value.VAL_INSTR) {
        val j: u32 = v.data.instr::u32;
        if (j >= lc.c.n) { ret R.err[bool, str]("scalarize: lane read of an out-of-range value"); }
        if (lc.slot_set[j]) { ret R.ok[bool, str](true); }
        val ms: R.Result[value.Value, str] = make_lane_slot(?lc.c, v.ty, ?lc.slot_alloca[j]);
        if (R.is_err[value.Value, str](ms)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](ms)); }
        lc.slot[j]     = R.unwrap_ok[value.Value, str](ms);
        lc.slot_set[j] = true;
        lc.store_at[j] = true;
        ret R.ok[bool, str](true);
    }
    if (v.kind == value.VAL_PARAM) {
        val p: u32 = v.data.param_ix;
        if (p >= lc.pn) { ret R.err[bool, str]("scalarize: lane read of an out-of-range parameter"); }
        if (lc.pslot_set[p]) { ret R.ok[bool, str](true); }
        val ms: R.Result[value.Value, str] = make_lane_slot(?lc.c, v.ty, ?lc.pallocas[lc.palloca_len]);
        if (R.is_err[value.Value, str](ms)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](ms)); }
        lc.palloca_len  = lc.palloca_len + 1;
        lc.pslot[p]     = R.unwrap_ok[value.Value, str](ms);
        lc.pslot_set[p] = true;
        ret R.ok[bool, str](true);
    }
    ret R.err[bool, str]("scalarize: lane read of a value with no stack home");
}

# the slot holding vector value `v` (reserved by `reserve_read_slot`)
fun slot_of(lc: *LaneCtx, v: value.Value) R.Result[value.Value, str] {
    if (v.kind == value.VAL_INSTR) {
        val j: u32 = v.data.instr::u32;
        if (j < lc.c.n && lc.slot_set[j]) { ret R.ok[value.Value, str](lc.slot[j]); }
    }
    if (v.kind == value.VAL_PARAM) {
        val p: u32 = v.data.param_ix;
        if (p < lc.pn && lc.pslot_set[p]) { ret R.ok[value.Value, str](lc.pslot[p]); }
    }
    ret R.err[value.Value, str]("scalarize: lane read has no reserved slot");
}

# expand one lane READ into `gep` + scalar `load` out of the vector's stack slot
fun expand_lane_read(lc: *LaneCtx, blk: *ir.Block, cur: id.InstructionId) R.Result[bool, str] {
    val fn: *ir.Function = lc.c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val src:  value.Value      = ip.operands[0];
    val elem: ir_type.IrTypeId = ip.ty;
    val loc:  source.SrcLoc    = ip.loc;

    val rk: R.Result[u32, str] = lane_index_of(ip);
    if (R.is_err[u32, str](rk)) { ret R.err[bool, str](R.unwrap_err[u32, str](rk)); }
    val k: u32 = R.unwrap_ok[u32, str](rk);

    var vi: VInfo;
    val vr: R.Result[bool, str] = vec_info(lc.c.m, src.ty, ?vi);
    if (R.is_err[bool, str](vr)) { ret vr; }
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?lc.c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }

    val rb: R.Result[value.Value, str] = slot_of(lc, src);
    if (R.is_err[value.Value, str](rb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rb)); }

    val rp: R.Result[value.Value, str] = lane_ptr(?lc.c, blk, R.unwrap_ok[value.Value, str](rb),
        R.unwrap_ok[ir_type.IrTypeId, str](ra), k, loc);
    if (R.is_err[value.Value, str](rp)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rp)); }

    val rl: R.Result[value.Value, str] = emit_load(?lc.c, blk, R.unwrap_ok[value.Value, str](rp), elem, loc);
    if (R.is_err[value.Value, str](rl)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rl)); }

    # every lane of a secret vector is secret, the same welded-storage rule the
    # scalarizer's per-lane reads follow (#1646).
    lc.c.pval[cur::u32]     = lane_secret(?lc.c, R.unwrap_ok[value.Value, str](rl), src.secret);
    lc.c.pval_set[cur::u32] = true;
    ret R.ok[bool, str](true);
}

# expand one lane WRITE into a whole-vector store, a lane store, and a reload
fun expand_lane_write(lc: *LaneCtx, blk: *ir.Block, cur: id.InstructionId) R.Result[bool, str] {
    val fn: *ir.Function = lc.c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val vty: ir_type.IrTypeId = ip.ty;
    val loc: source.SrcLoc    = ip.loc;
    val src: value.Value      = resolve(?lc.c, ip.operands[0]);
    val lane_val: value.Value = resolve(?lc.c, ip.operands[2]);

    val rk: R.Result[u32, str] = lane_index_of(ip);
    if (R.is_err[u32, str](rk)) { ret R.err[bool, str](R.unwrap_err[u32, str](rk)); }
    val k: u32 = R.unwrap_ok[u32, str](rk);

    var vi: VInfo;
    val vr: R.Result[bool, str] = vec_info(lc.c.m, vty, ?vi);
    if (R.is_err[bool, str](vr)) { ret vr; }
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?lc.c.m.types, vi.elem, vi.lanes);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ra)); }
    val arr: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    val slot: value.Value = lc.slot[cur::u32];

    val rs: R.Result[bool, str] = emit_store(?lc.c, blk, src, slot, loc);
    if (R.is_err[bool, str](rs)) { ret rs; }

    val rp: R.Result[value.Value, str] = lane_ptr(?lc.c, blk, slot, arr, k, loc);
    if (R.is_err[value.Value, str](rp)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rp)); }

    val rs2: R.Result[bool, str] = emit_store(?lc.c, blk, lane_val, R.unwrap_ok[value.Value, str](rp), loc);
    if (R.is_err[bool, str](rs2)) { ret rs2; }

    val rl: R.Result[value.Value, str] = emit_load(?lc.c, blk, slot, vty, loc);
    if (R.is_err[value.Value, str](rl)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rl)); }

    lc.c.pval[cur::u32]     = R.unwrap_ok[value.Value, str](rl);
    lc.c.pval_set[cur::u32] = true;
    ret R.ok[bool, str](true);
}

# reserve every slot the function's lane ops need, in instruction-id order
#
# A lane WRITE takes its own result slot (its expansion stores the source vector into
# it, so it must not share a slot with the source); a lane READ borrows whatever slot
# already holds its source, or reserves one whose store is placed right after the
# source's definition.
fun reserve_lane_slots(lc: *LaneCtx) R.Result[bool, str] {
    val fn: *ir.Function = lc.c.fn;
    var iid: u32 = 0;
    for (iid < lc.c.n) {
        val k: instruction.InstrKind = fn.instrs[iid].kind;
        if (k == instruction.OP_VEC_INSERT) {
            val ms: R.Result[value.Value, str] = make_lane_slot(?lc.c, fn.instrs[iid].ty, ?lc.slot_alloca[iid]);
            if (R.is_err[value.Value, str](ms)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](ms)); }
            lc.slot[iid]     = R.unwrap_ok[value.Value, str](ms);
            lc.slot_set[iid] = true;
        }
        or (k == instruction.OP_VEC_EXTRACT) {
            val rr: R.Result[bool, str] = reserve_read_slot(lc, fn.instrs[iid].operands[0]);
            if (R.is_err[bool, str](rr)) { ret rr; }
        }
        iid = iid + 1;
    }
    ret R.ok[bool, str](true);
}

# rebuild one block, expanding its lane ops and placing the reserved slots' stores
fun expand_lane_block(lc: *LaneCtx, blk: *ir.Block, is_entry: bool) R.Result[bool, str] {
    val fn: *ir.Function = lc.c.fn;

    val old_len: u32 = blk.instr_count;
    var old: *id.InstructionId = nil;
    if (old_len > 0) {
        val ro: R.Result[*id.InstructionId, str] = A.allocate[id.InstructionId](lc.c.m.alloc, old_len::usize);
        if (R.is_err[*id.InstructionId, str](ro)) { ret R.err[bool, str](R.unwrap_err[*id.InstructionId, str](ro)); }
        old = R.unwrap_ok[*id.InstructionId, str](ro);
        var i: u32 = 0;
        for (i < old_len) { old[i] = blk.instructions[i]; i = i + 1; }
    }
    blk.instr_count = 0;

    if (is_entry) {
        # a parameter has no defining instruction to sit beside, so its slot and home
        # store lead the body, dominating every lane read.
        var s: u32 = 0;
        for (s < lc.palloca_len) {
            val rap: R.Result[bool, str] = ir.block_append_instr(lc.c.m, blk, lc.pallocas[s]);
            if (R.is_err[bool, str](rap)) { body_free(?lc.c, old, old_len); ret rap; }
            s = s + 1;
        }
        var p: u32 = 0;
        for (p < lc.pn) {
            if (lc.pslot_set[p]) {
                val rsp: R.Result[bool, str] = emit_store(?lc.c, blk,
                    value.param(p, fn.params[p].ty), lc.pslot[p], source.loc(source.FILE_NIL, 0));
                if (R.is_err[bool, str](rsp)) { body_free(?lc.c, old, old_len); ret rsp; }
            }
            p = p + 1;
        }
    }

    # a phi executes at block entry, so a phi-defined vector's slot and store lead the
    # body rather than following an instruction in it.
    var ph: u32 = 0;
    for (ph < blk.phi_count) {
        val pid: u32 = blk.phis[ph]::u32;
        if (pid < lc.c.n && lc.store_at[pid]) {
            val rap: R.Result[bool, str] = ir.block_append_instr(lc.c.m, blk, lc.slot_alloca[pid]);
            if (R.is_err[bool, str](rap)) { body_free(?lc.c, old, old_len); ret rap; }
            val rsp: R.Result[bool, str] = emit_store(?lc.c, blk,
                value.instr(pid::id.InstructionId, fn.instrs[pid].ty), lc.slot[pid], fn.instrs[pid].loc);
            if (R.is_err[bool, str](rsp)) { body_free(?lc.c, old, old_len); ret rsp; }
        }
        ph = ph + 1;
    }

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur: id.InstructionId = old[oi];
        val kind: instruction.InstrKind = fn.instrs[cur::u32].kind;
        var rr: R.Result[bool, str] = R.ok[bool, str](true);
        if (kind == instruction.OP_VEC_EXTRACT) {
            rr = expand_lane_read(lc, blk, cur);
        }
        or (kind == instruction.OP_VEC_INSERT) {
            # the result slot leads its own expansion, which stores the source vector
            # into it immediately.
            rr = ir.block_append_instr(lc.c.m, blk, lc.slot_alloca[cur::u32]);
            if (!R.is_err[bool, str](rr)) { rr = expand_lane_write(lc, blk, cur); }
        }
        or {
            rr = ir.block_append_instr(lc.c.m, blk, cur);
            if (!R.is_err[bool, str](rr) && cur::u32 < lc.c.n && lc.store_at[cur::u32]) {
                rr = ir.block_append_instr(lc.c.m, blk, lc.slot_alloca[cur::u32]);
                if (!R.is_err[bool, str](rr)) {
                    rr = emit_store(?lc.c, blk,
                        value.instr(cur, fn.instrs[cur::u32].ty), lc.slot[cur::u32], fn.instrs[cur::u32].loc);
                }
            }
        }
        if (R.is_err[bool, str](rr)) { body_free(?lc.c, old, old_len); ret rr; }
        oi = oi + 1;
    }

    body_free(?lc.c, old, old_len);
    ret R.ok[bool, str](true);
}

# free a LaneCtx's owned scratch arrays
fun lane_ctx_free(m: *ir.Module, lc: *LaneCtx) {
    if (lc.slot != nil && lc.c.n > 0)      { A.deallocate[value.Value](m.alloc, lc.slot, lc.c.n::usize); }
    if (lc.slot_set != nil && lc.c.n > 0)  { A.deallocate[bool](m.alloc, lc.slot_set, lc.c.n::usize); }
    if (lc.store_at != nil && lc.c.n > 0)  { A.deallocate[bool](m.alloc, lc.store_at, lc.c.n::usize); }
    if (lc.slot_alloca != nil && lc.c.n > 0) { A.deallocate[id.InstructionId](m.alloc, lc.slot_alloca, lc.c.n::usize); }
    if (lc.pslot != nil && lc.pn > 0)      { A.deallocate[value.Value](m.alloc, lc.pslot, lc.pn::usize); }
    if (lc.pslot_set != nil && lc.pn > 0)  { A.deallocate[bool](m.alloc, lc.pslot_set, lc.pn::usize); }
    if (lc.pallocas != nil && lc.pn > 0)   { A.deallocate[id.InstructionId](m.alloc, lc.pallocas, lc.pn::usize); }
    lc.slot = nil; lc.slot_set = nil; lc.store_at = nil; lc.slot_alloca = nil;
    lc.pslot = nil; lc.pslot_set = nil; lc.pallocas = nil;
    ctx_free(m, ?lc.c);
}

# expand one function's lane ops; the function is untouched when it has none
fun expand_lane_function(m: *ir.Module, fn: *ir.Function, tgt: *target.Target,
                         void_ty: ir_type.IrTypeId,
                         ptr_ty: ir_type.IrTypeId, idx_ty: ir_type.IrTypeId) R.Result[bool, str] {
    if (!has_lane_op(fn)) { ret R.ok[bool, str](true); }

    var lc: LaneCtx;
    lc.c.m       = m;
    lc.c.tgt     = tgt;
    lc.c.fn      = fn;
    lc.c.lane_buf = nil;
    lc.c.lane_cap = 0;
    lc.c.n       = fn.instr_len;
    lc.c.pcount  = 0;          # this pass never retypes a parameter; keep resolve's param arm inert
    lc.c.is_vp   = nil;
    lc.c.void_ty = void_ty;
    lc.c.ptr_ty  = ptr_ty;
    lc.c.idx_ty  = idx_ty;
    lc.pn        = fn.param_count;
    lc.palloca_len = 0;

    val rpv: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, lc.c.n::usize);
    if (R.is_err[*value.Value, str](rpv)) { ret R.err[bool, str](R.unwrap_err[*value.Value, str](rpv)); }
    lc.c.pval = R.unwrap_ok[*value.Value, str](rpv);
    val rps: R.Result[*bool, str] = A.zallocate[bool](m.alloc, lc.c.n::usize);
    if (R.is_err[*bool, str](rps)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*bool, str](rps)); }
    lc.c.pval_set = R.unwrap_ok[*bool, str](rps);

    val rsl: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, lc.c.n::usize);
    if (R.is_err[*value.Value, str](rsl)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*value.Value, str](rsl)); }
    lc.slot = R.unwrap_ok[*value.Value, str](rsl);
    val rss: R.Result[*bool, str] = A.zallocate[bool](m.alloc, lc.c.n::usize);
    if (R.is_err[*bool, str](rss)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*bool, str](rss)); }
    lc.slot_set = R.unwrap_ok[*bool, str](rss);
    val rsa: R.Result[*bool, str] = A.zallocate[bool](m.alloc, lc.c.n::usize);
    if (R.is_err[*bool, str](rsa)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*bool, str](rsa)); }
    lc.store_at = R.unwrap_ok[*bool, str](rsa);
    val ral: R.Result[*id.InstructionId, str] = A.allocate[id.InstructionId](m.alloc, lc.c.n::usize);
    if (R.is_err[*id.InstructionId, str](ral)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*id.InstructionId, str](ral)); }
    lc.slot_alloca = R.unwrap_ok[*id.InstructionId, str](ral);

    if (lc.pn > 0) {
        val rpl: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, lc.pn::usize);
        if (R.is_err[*value.Value, str](rpl)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*value.Value, str](rpl)); }
        lc.pslot = R.unwrap_ok[*value.Value, str](rpl);
        val rpss: R.Result[*bool, str] = A.zallocate[bool](m.alloc, lc.pn::usize);
        if (R.is_err[*bool, str](rpss)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*bool, str](rpss)); }
        lc.pslot_set = R.unwrap_ok[*bool, str](rpss);
        val rpa: R.Result[*id.InstructionId, str] = A.allocate[id.InstructionId](m.alloc, lc.pn::usize);
        if (R.is_err[*id.InstructionId, str](rpa)) { lane_ctx_free(m, ?lc); ret R.err[bool, str](R.unwrap_err[*id.InstructionId, str](rpa)); }
        lc.pallocas = R.unwrap_ok[*id.InstructionId, str](rpa);
    }

    val rr: R.Result[bool, str] = reserve_lane_slots(?lc);
    if (R.is_err[bool, str](rr)) { lane_ctx_free(m, ?lc); ret rr; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val rb: R.Result[bool, str] = expand_lane_block(?lc, ?fn.blocks[bi], bi == 0);
        if (R.is_err[bool, str](rb)) { lane_ctx_free(m, ?lc); ret rb; }
        bi = bi + 1;
    }
    rewrite_uses(?lc.c, fn);

    lane_ctx_free(m, ?lc);
    ret R.ok[bool, str](true);
}

# rewrite every vector lane access in `m` to the vector's memory image, for a target
# that KEEPS vectors but whose ISA cannot read or write a lane in a register (#2236)
#
# Restores exactly the shape lane access had before the IR gained OP_VEC_EXTRACT /
# OP_VEC_INSERT: one stack slot per vector value, a whole-vector store into it, and a
# scalar load or store at the lane's offset.
#
# Two targets need nothing from this pass, for opposite reasons. One that selects
# lane access natively (`has_lane_ops`) keeps the opcodes all the way to its isel. One
# with no vector unit at all (`has_v128 == false`) has `run` below turn EVERY vector
# value into a stack slot anyway, and expands lane access against those same slots -
# so pre-expanding here would reserve a second slot per vector on top of the
# scalarizer's, which is real stack and real address arithmetic for nothing.
# ---
# m:   the module to legalize in place
# tgt: the target, consulted for the lane-access and SIMD capability facts
# ret: ok(true) on success, or an allocation / internal error
pub fun expand_lane_ops(m: *ir.Module, tgt: *target.Target) R.Result[bool, str] {
    if (tgt.model.has_lane_ops) { ret R.ok[bool, str](true); }
    if (!tgt.model.has_v128)    { ret R.ok[bool, str](true); }

    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rv)); }
    val void_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rp)); }
    val ptr_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, tgt.isa.pointer_width * 8);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ri)); }
    val idx_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0) {
            val rf: R.Result[bool, str] = expand_lane_function(m, fn, tgt, void_ty, ptr_ty, idx_ty);
            if (R.is_err[bool, str](rf)) { ret rf; }
        }
        fi = fi + 1;
    }
    ret R.ok[bool, str](true);
}

# whether `fn` holds any operator this target has no packed form for
fun has_gap_op(m: *ir.Module, fn: *ir.Function, tgt: *target.Target) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (is_operator(m, inst) && !vecform.realizes_packed(m, tgt, inst)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# rewrite one gap operator into per-lane scalar work, leaving its operands and its
# result as ordinary vector VALUES
#
# `%c = op <N x T> %a, %b` becomes N lane reads of each operand, N scalar `op`s, and
# an insert chain that assembles the result. The chain is seeded with `%a` rather
# than a zero vector because a vector-typed constant is not an expressible value
# (#2700) - and the seed's lanes are all overwritten, since the chain writes every
# lane, so which vector seeds it cannot affect the result.
#
# Built from `OP_VEC_EXTRACT` / `OP_VEC_INSERT` rather than from stack traffic on
# purpose: both are already legal on every target and already have a realization
# there. A target that reads and writes a lane in a register (`has_lane_ops`, NEON's
# UMOV / INS) keeps them to its isel; one that cannot has `expand_lane_ops` rewrite
# them to the vector's memory image immediately after this. So this pass needs no
# memory machinery of its own and inherits both lowerings for free.
fun expand_gap_op(c: *Ctx, tgt: *target.Target, blk: *ir.Block, cur: id.InstructionId) R.Result[bool, str] {
    val fn: *ir.Function = c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val kind: instruction.InstrKind = ip.kind;
    val loc:  source.SrcLoc = ip.loc;
    val vty:  ir_type.IrTypeId = ip.ty;

    if (is_compare_op(kind)) { ret expand_gap_compare(c, tgt, blk, cur); }
    if (!is_binary_op(kind) && !is_unary_op(kind)) {
        ret R.err[bool, str]("scalarize: gap operator is not a lane-wise arithmetic or bitwise op");
    }

    var vi: VInfo;
    val rvi: R.Result[bool, str] = vec_info(c.m, vty, ?vi);
    if (R.is_err[bool, str](rvi)) { ret rvi; }

    val unary: bool = is_unary_op(kind);
    if (ip.operand_count < 1)             { ret R.err[bool, str]("scalarize: gap operator missing operands"); }
    if (!unary && ip.operand_count < 2)   { ret R.err[bool, str]("scalarize: gap operator missing operands"); }

    val a: value.Value = resolve(c, ip.operands[0]);
    var b: value.Value = a;
    if (!unary) { b = resolve(c, ip.operands[1]); }
    val a_secret: bool = ip.operands[0].secret;
    var b_secret: bool = false;
    if (!unary) { b_secret = ip.operands[1].secret; }

    # every lane's scalar result, computed before any of them is inserted, so the
    # insert chain is a straight assembly rather than interleaved with the arithmetic.
    val rlb: R.Result[*value.Value, str] = lane_scratch(c, vi.lanes);
    if (R.is_err[*value.Value, str](rlb)) { ret R.err[bool, str](R.unwrap_err[*value.Value, str](rlb)); }
    val lanes: *value.Value = R.unwrap_ok[*value.Value, str](rlb);

    var k: u32 = 0;
    for (k < vi.lanes) {
        val ra: R.Result[value.Value, str] = emit_lane_read(c, blk, a, vi.elem, k, loc);
        if (R.is_err[value.Value, str](ra)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](ra)); }
        val av: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](ra), a_secret);

        var rr: R.Result[value.Value, str] = R.ok[value.Value, str](av);
        if (unary) {
            rr = emit_unop(c, blk, kind, vi.elem, av, loc);
        }
        or {
            val rb: R.Result[value.Value, str] = emit_lane_read(c, blk, b, vi.elem, k, loc);
            if (R.is_err[value.Value, str](rb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rb)); }
            val bv: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](rb), b_secret);
            rr = emit_binop(c, blk, kind, vi.elem, av, bv, loc);
        }
        if (R.is_err[value.Value, str](rr)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rr)); }
        lanes[k] = lane_secret(c, R.unwrap_ok[value.Value, str](rr), a_secret || b_secret);
        k = k + 1;
    }

    var acc: value.Value = a;
    var j: u32 = 0;
    for (j < vi.lanes) {
        val ri: R.Result[value.Value, str] = emit_lane_write(c, blk, acc, vty, j, lanes[j], loc);
        if (R.is_err[value.Value, str](ri)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](ri)); }
        acc = R.unwrap_ok[value.Value, str](ri);
        j = j + 1;
    }

    # every later use of the operator's result names the assembled vector instead.
    c.pval[cur::u32]     = acc;
    c.pval_set[cur::u32] = true;
    ret R.ok[bool, str](true);
}

# rewrite a gapped lane-wise COMPARE into per-lane scalar compares assembling mach's
# same-shape mask, as VALUES rather than through storage
#
# The mask contract is the one CMPPS / FCMEQ implement and the whole-module scalarizer
# already reproduces: a true lane is all-ones at the mask lane width, a false lane all
# zeros. Per lane that is a scalar compare to a 0/1 boolean, a widening to the mask
# lane width, and `0 - z`, which is all-ones in two's complement.
#
# WHY THIS COULD NOT BE LEFT UNWRITTEN (#2749). It was a defined error, on the ground
# that no ISA declares a packed-form gap on a compare - true while a gap could only be
# a missing OPCODE. A lane-count ceiling makes a compare gapped for a reason that has
# nothing to do with the opcode: SPIR-V has `OpSLessThan` at every lane width and
# still cannot type sixteen components, so `i8x16 < i8x16` arrives here.
#
# TWO ASSEMBLIES, and the choice is the same capability and the same reason as a
# vector literal's (`me.lower.expr.lower_vector_lit`). A compare's result is a
# DIFFERENT IR type from its operands whenever the lanes are float - `f32x4 < f32x4`
# is `u32x4` - so the insert chain the arithmetic path uses cannot seed from an
# operand there, and a vector-typed zero constant is not an expressible value (#2700).
# A target that builds a whole vector from its lanes gets `OP_VEC_BUILD`; one that
# does not gets the insert chain, which is well-typed exactly when the mask type IS
# the operand type - and it is, for every INTEGER-lane compare, because an IR integer
# carries no signedness and `u8x16` and `i8x16` are one IR type. That leaves one
# combination unwritten, a float-lane compare gap on a target with no whole-vector
# build, which no target has: it is a defined error rather than a wrong mask, exactly
# as this whole function was before.
fun expand_gap_compare(c: *Ctx, tgt: *target.Target, blk: *ir.Block, cur: id.InstructionId) R.Result[bool, str] {
    val fn: *ir.Function = c.fn;
    val ip: *instruction.Instruction = ?fn.instrs[cur::u32];
    val kind: instruction.InstrKind = ip.kind;
    val loc:  source.SrcLoc = ip.loc;
    val mask_ty: ir_type.IrTypeId = ip.ty;

    if (ip.operand_count < 2) { ret R.err[bool, str]("scalarize: gap compare missing operands"); }
    val op_ty: ir_type.IrTypeId = ip.operands[0].ty;

    var opi: VInfo;
    val ro: R.Result[bool, str] = vec_info(c.m, op_ty, ?opi);
    if (R.is_err[bool, str](ro)) { ret ro; }
    var mi: VInfo;
    val rm: R.Result[bool, str] = vec_info(c.m, mask_ty, ?mi);
    if (R.is_err[bool, str](rm)) { ret rm; }
    if (opi.lanes != mi.lanes) {
        ret R.err[bool, str]("scalarize: gap compare mask has a different lane count from its operands");
    }

    val ri8: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?c.m.types, 8);
    if (R.is_err[ir_type.IrTypeId, str](ri8)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ri8)); }
    val i8_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri8);

    # a signed ordering compare of a sub-word lane sign-extends both operands first,
    # for the same reason the storage expansion does (#2077): a target whose sub-word
    # reads zero-extend would otherwise compare a negative lane as a large unsigned
    # bit pattern and answer `-1 < 0` false.
    val need_sext: bool = (kind == instruction.OP_CMP_LT_S || kind == instruction.OP_CMP_LE_S) && opi.bits < 32;
    var ext_ty: ir_type.IrTypeId = ir_type.IRT_NIL;
    if (need_sext) {
        val rx: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?c.m.types, 32);
        if (R.is_err[ir_type.IrTypeId, str](rx)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rx)); }
        ext_ty = R.unwrap_ok[ir_type.IrTypeId, str](rx);
    }

    val a: value.Value = resolve(c, ip.operands[0]);
    val b: value.Value = resolve(c, ip.operands[1]);
    val secret: bool = ip.operands[0].secret || ip.operands[1].secret;

    val rlb: R.Result[*value.Value, str] = lane_scratch(c, opi.lanes);
    if (R.is_err[*value.Value, str](rlb)) { ret R.err[bool, str](R.unwrap_err[*value.Value, str](rlb)); }
    val lanes: *value.Value = R.unwrap_ok[*value.Value, str](rlb);

    var k: u32 = 0;
    for (k < opi.lanes) {
        val ra: R.Result[value.Value, str] = emit_lane_read(c, blk, a, opi.elem, k, loc);
        if (R.is_err[value.Value, str](ra)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](ra)); }
        var la: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](ra), ip.operands[0].secret);
        val rb: R.Result[value.Value, str] = emit_lane_read(c, blk, b, opi.elem, k, loc);
        if (R.is_err[value.Value, str](rb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rb)); }
        var lb: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](rb), ip.operands[1].secret);

        if (need_sext) {
            val sa: R.Result[value.Value, str] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, la, loc);
            if (R.is_err[value.Value, str](sa)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](sa)); }
            la = lane_secret(c, R.unwrap_ok[value.Value, str](sa), ip.operands[0].secret);
            val sb: R.Result[value.Value, str] = emit_unop(c, blk, instruction.OP_SEXT, ext_ty, lb, loc);
            if (R.is_err[value.Value, str](sb)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](sb)); }
            lb = lane_secret(c, R.unwrap_ok[value.Value, str](sb), ip.operands[1].secret);
        }

        val cmp: R.Result[value.Value, str] = emit_binop(c, blk, kind, i8_ty, la, lb, loc);
        if (R.is_err[value.Value, str](cmp)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](cmp)); }
        var wide: value.Value = lane_secret(c, R.unwrap_ok[value.Value, str](cmp), secret);

        if (mi.bits != 8) {
            val z: R.Result[value.Value, str] = emit_unop(c, blk, instruction.OP_ZEXT, mi.elem, wide, loc);
            if (R.is_err[value.Value, str](z)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](z)); }
            wide = lane_secret(c, R.unwrap_ok[value.Value, str](z), secret);
        }

        val neg: R.Result[value.Value, str] = emit_binop(c, blk, instruction.OP_SUB, mi.elem,
                                                         value.const_int(0, mi.elem), wide, loc);
        if (R.is_err[value.Value, str](neg)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](neg)); }
        lanes[k] = lane_secret(c, R.unwrap_ok[value.Value, str](neg), secret);
        k = k + 1;
    }

    var acc: value.Value;
    if (tgt.model.has_vec_build) {
        val rv: R.Result[value.Value, str] = push(c, blk, instruction.OP_VEC_BUILD, mask_ty, mask_ty,
                                                  ?lanes[0], opi.lanes, loc);
        if (R.is_err[value.Value, str](rv)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rv)); }
        acc = R.unwrap_ok[value.Value, str](rv);
    }
    or {
        if (mask_ty != op_ty) {
            ret R.err[bool, str]("scalarize: no per-lane expansion for a gapped float-lane vector compare on a target that cannot build a vector from its lanes");
        }
        acc = a;
        var j: u32 = 0;
        for (j < opi.lanes) {
            val rw: R.Result[value.Value, str] = emit_lane_write(c, blk, acc, mask_ty, j, lanes[j], loc);
            if (R.is_err[value.Value, str](rw)) { ret R.err[bool, str](R.unwrap_err[value.Value, str](rw)); }
            acc = R.unwrap_ok[value.Value, str](rw);
            j = j + 1;
        }
    }

    c.pval[cur::u32]     = acc;
    c.pval_set[cur::u32] = true;
    ret R.ok[bool, str](true);
}

# a lane read `vec_extract vec, k` yielding the scalar element
fun emit_lane_read(c: *Ctx, blk: *ir.Block, vec: value.Value, elem_ty: ir_type.IrTypeId, k: u32, loc: source.SrcLoc) R.Result[value.Value, str] {
    var ops: [2]value.Value;
    ops[0] = vec;
    ops[1] = value.const_int(k::u64, c.idx_ty);
    ret push(c, blk, instruction.OP_VEC_EXTRACT, elem_ty, vec.ty, ?ops[0], 2, loc);
}

# a lane write `vec_insert vec, k, v` yielding the whole vector with lane k replaced
fun emit_lane_write(c: *Ctx, blk: *ir.Block, vec: value.Value, vty: ir_type.IrTypeId, k: u32, v: value.Value, loc: source.SrcLoc) R.Result[value.Value, str] {
    var ops: [3]value.Value;
    ops[0] = vec;
    ops[1] = value.const_int(k::u64, c.idx_ty);
    ops[2] = v;
    ret push(c, blk, instruction.OP_VEC_INSERT, vty, vty, ?ops[0], 3, loc);
}

# rebuild one block, expanding its gap operators in place
#
# BODIES ONLY. Operand substitution is a WHOLE-FUNCTION step (`rewrite_gap_uses`)
# because a use can precede its definition in block order - a loop header's phi names
# a value the latch produces - so rewriting a block's operands while later blocks are
# still unexpanded leaves that phi naming an instruction this pass has just dropped
# (#2749). That was a silent wrong ANSWER on x86-64, not a crash: a loop-carried
# `i32x4 * i32x4` accumulator came out holding the multiplier, because the phi's back
# edge still named the deleted multiply and MIR lowering copied an undefined vreg.
fun expand_gap_block(c: *Ctx, tgt: *target.Target, blk: *ir.Block) R.Result[bool, str] {
    val fn: *ir.Function = c.fn;

    val old_len: u32 = blk.instr_count;
    var old: *id.InstructionId = nil;
    if (old_len > 0) {
        val ro: R.Result[*id.InstructionId, str] = A.allocate[id.InstructionId](c.m.alloc, old_len::usize);
        if (R.is_err[*id.InstructionId, str](ro)) { ret R.err[bool, str](R.unwrap_err[*id.InstructionId, str](ro)); }
        old = R.unwrap_ok[*id.InstructionId, str](ro);
        var i: u32 = 0;
        for (i < old_len) { old[i] = blk.instructions[i]; i = i + 1; }
    }
    blk.instr_count = 0;

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur: id.InstructionId = old[oi];
        val inst: *instruction.Instruction = ?fn.instrs[cur::u32];
        var rr: R.Result[bool, str] = R.ok[bool, str](true);
        if (is_operator(c.m, inst) && !vecform.realizes_packed(c.m, tgt, inst)) {
            rr = expand_gap_op(c, tgt, blk, cur);
        }
        or {
            rr = ir.block_append_instr(c.m, blk, cur);
        }
        if (R.is_err[bool, str](rr)) { body_free(c, old, old_len); ret rr; }
        oi = oi + 1;
    }

    body_free(c, old, old_len);
    ret R.ok[bool, str](true);
}

# point every surviving use in `fn` at the value that replaced its producer
#
# THE SUBSTITUTION IS WHOLE-FUNCTION, not per block, and that is the point (#2749).
# An expansion replaces one instruction's result with an assembled vector, and the
# uses of that result are not confined to blocks already walked: a loop header's phi
# names the value the LATCH defines, so its operand is a forward reference no block
# order can remove - the phi genuinely precedes its own operand.
#
# Both vector expansions got this wrong, and neither failed loudly. A loop-carried
# `i32x4 * i32x4` accumulator on x86-64 came out holding the MULTIPLIER: the phi's
# back edge still named the deleted multiply, and MIR lowering turned the phi into a
# copy from a vreg nothing defines. Every straight-line vector test passed.
#
# The instructions an expansion emitted itself are already correct - it resolves each
# operand as it builds them - so re-resolving them here is a no-op: nothing replaces a
# replacement.
fun rewrite_uses(c: *Ctx, fn: *ir.Function) {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            rewrite_ops(c, ?fn.instrs[blk.phis[p]::u32]);
            p = p + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            rewrite_ops(c, ?fn.instrs[blk.instructions[ii]::u32]);
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL) { rewrite_ops(c, ?fn.instrs[blk.terminator::u32]); }
        bi = bi + 1;
    }
}

# expand one function's gap operators; the function is untouched when it has none
fun expand_gap_function(m: *ir.Module, fn: *ir.Function, tgt: *target.Target,
                        void_ty: ir_type.IrTypeId, ptr_ty: ir_type.IrTypeId, idx_ty: ir_type.IrTypeId) R.Result[bool, str] {
    if (!has_gap_op(m, fn, tgt)) { ret R.ok[bool, str](true); }

    var c: Ctx;
    c.m        = m;
    c.tgt      = tgt;
    c.fn       = fn;
    c.n        = fn.instr_len;
    c.lane_buf = nil;
    c.lane_cap = 0;
    c.pcount  = 0;      # no parameter is retyped here; keep resolve's param arm inert
    c.is_vp   = nil;
    c.void_ty = void_ty;
    c.ptr_ty  = ptr_ty;
    c.idx_ty  = idx_ty;

    val rpv: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, c.n::usize);
    if (R.is_err[*value.Value, str](rpv)) { ret R.err[bool, str](R.unwrap_err[*value.Value, str](rpv)); }
    c.pval = R.unwrap_ok[*value.Value, str](rpv);
    val rps: R.Result[*bool, str] = A.zallocate[bool](m.alloc, c.n::usize);
    if (R.is_err[*bool, str](rps)) { ctx_free(m, ?c); ret R.err[bool, str](R.unwrap_err[*bool, str](rps)); }
    c.pval_set = R.unwrap_ok[*bool, str](rps);

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val rb: R.Result[bool, str] = expand_gap_block(?c, tgt, ?fn.blocks[bi]);
        if (R.is_err[bool, str](rb)) { ctx_free(m, ?c); ret rb; }
        bi = bi + 1;
    }
    rewrite_uses(?c, fn);

    ctx_free(m, ?c);
    ret R.ok[bool, str](true);
}

# realize the lane-wise operators `tgt` has no packed form for as per-lane scalar
# work, on a target that DOES have a vector unit (#2726)
#
# The per-OPERATION half of the realization model. `run` below is the per-TARGET half
# and applies when there is no vector unit at all; this one applies when there is a
# vector unit but the specific operation has no packed word at the specific lane
# width - SSE2 packing a 16-bit lane multiply (PMULLW) but no 32-bit one (PMULLD is
# SSE4.1), NEON packing .16b / .8h / .4s but having no 64-bit lane arrangement.
#
# The distinction that makes this different from `run`: VECTOR VALUES SURVIVE. Only
# the gap operator becomes per-lane work, so `i32x4 + i32x4` still selects one packed
# instruction next to an `i32x4 * i32x4` that does not, and nothing that already had
# a packed form pays for the one that did not.
#
# Which operators those are comes from `vecform.realizes_packed`, the same authority
# the `simd = "require"` diagnostic reads, so the build error and the transformation
# cannot describe different sets.
# ---
# m:   the module to legalize in place
# tgt: the target whose packed forms decide each operator's realization
# ret: ok(true) on success, or an allocation / internal error
pub fun expand_gap_ops(m: *ir.Module, tgt: *target.Target) R.Result[bool, str] {
    if (!tgt.model.has_v128) { ret R.ok[bool, str](true); }

    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rv)); }
    val void_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rp)); }
    val ptr_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, tgt.isa.pointer_width * 8);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ri)); }
    val idx_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0) {
            val rf: R.Result[bool, str] = expand_gap_function(m, fn, tgt, void_ty, ptr_ty, idx_ty);
            if (R.is_err[bool, str](rf)) { ret rf; }
        }
        fi = fi + 1;
    }
    ret R.ok[bool, str](true);
}

# whether `fn` mentions a vector value this target carries as a memory image
#
# Every place a type can reach the rewrite is checked - a result, an operand, an
# alloca or gep's aggregate type, and a parameter - because skipping a function on a
# narrower question would leave exactly one of those forms behind for the back end to
# meet as a vector it cannot place.
fun function_has_mem_image(m: *ir.Module, fn: *ir.Function, tgt: *target.Target) bool {
    var p: u32 = 0;
    for (p < fn.param_count) {
        if (!vecform.holds_in_register(m, tgt, fn.params[p].ty)) { ret true; }
        p = p + 1;
    }
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (!vecform.holds_in_register(m, tgt, inst.ty))     { ret true; }
        if (!vecform.holds_in_register(m, tgt, inst.aux_ty)) { ret true; }
        var o: u32 = 0;
        for (o < inst.operand_count) {
            if (!vecform.holds_in_register(m, tgt, inst.operands[o].ty)) { ret true; }
            o = o + 1;
        }
        i = i + 1;
    }
    ret false;
}

# whether any function in `m` mentions a vector value this target carries as a memory
# image, so the placement stage has work to do
fun has_mem_image_value(m: *ir.Module, tgt: *target.Target) bool {
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0) {
            if (function_has_mem_image(m, fn, tgt)) { ret true; }
        }
        fi = fi + 1;
    }
    ret false;
}

# give every vector value `tgt` cannot hold in a vector register its memory image:
# a stack slot, per-lane accesses, and per-lane scalar operators
#
# THE PLACEMENT STAGE. It runs on every target and claims values rather than
# functions or targets: `mem_image` decides, so a target with no vector unit has
# every vector claimed (rv64gc, mos6502 - the pass's original all-or-nothing job,
# unchanged) and a target with one has only the shapes too wide for it claimed
# (`f32x8` on x86-64 and aarch64, #2727). A register-resident vector is not touched,
# so `i32x4 + i32x4` next door still selects one packed instruction.
#
# WHY PLACEMENT COMES FIRST, ahead of the gap and lane expansions in the pipeline.
# Those two rewrite operators and lane access on a value that STAYS a vector, so
# reaching an over-width shape first they expand it against a value no register
# holds, and this stage then takes the result apart again into the memory image it
# was always going to be. The lanes come out right either way - measured on all three
# legs - and the cost does not: an `i32x8` add is 169 instructions this way round and
# 871 the other. `me.pipeline` carries the numbers.
#
# Records the number of vector operators scalarized on `m.vector_ops_scalarized` from
# the shared `detect` walk (the same operator set the pass expands), which the build
# path reads to surface the one-shot scalarization note. `detect` is the shared seam
# the profile lever (#2017) turns into a `require`-mode error, so the note and that
# error name the identical operators by construction.
# ---
# m:   the module to legalize in place
# tgt: the target whose vector register width decides which values are claimed
# ret: ok(true) on success, or an allocation / internal error
pub fun run(m: *ir.Module, tgt: *target.Target) R.Result[bool, str] {
    if (!has_mem_image_value(m, tgt)) { ret R.ok[bool, str](true); }

    # record the operator count for the note from the same read-only walk the require
    # lever consumes, before any expansion mutates the IR.
    var first: ScalarizeSite;
    m.vector_ops_scalarized = detect(m, tgt, ?first);

    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rp)); }
    val ptr_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);

    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](rv)); }
    val void_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    # gep lane indices are machine-word integers; the pointer width matches the target.
    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, tgt.isa.pointer_width * 8);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](ri)); }
    val idx_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);

    val r8: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 8);
    if (R.is_err[ir_type.IrTypeId, str](r8)) { ret R.err[bool, str](R.unwrap_err[ir_type.IrTypeId, str](r8)); }
    val i8_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](r8);

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        # a function with nothing claimed keeps its body untouched rather than being
        # rebuilt instruction for instruction, so a target with a vector unit pays
        # only in the functions that actually name an over-width shape.
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.instr_len > 0
            && function_has_mem_image(m, fn, tgt)) {
            var c: Ctx;
            c.m        = m;
            c.tgt      = tgt;
            c.fn       = fn;
            c.n        = fn.instr_len;
            c.lane_buf = nil;
            c.lane_cap = 0;
            c.pcount  = fn.param_count;
            c.void_ty = void_ty;
            c.ptr_ty  = ptr_ty;
            c.idx_ty  = idx_ty;

            val rpv: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, c.n::usize);
            if (R.is_err[*value.Value, str](rpv)) { ret R.err[bool, str](R.unwrap_err[*value.Value, str](rpv)); }
            c.pval = R.unwrap_ok[*value.Value, str](rpv);
            val rps: R.Result[*bool, str] = A.allocate[bool](m.alloc, c.n::usize);
            if (R.is_err[*bool, str](rps)) { A.deallocate[value.Value](m.alloc, c.pval, c.n::usize); ret R.err[bool, str](R.unwrap_err[*bool, str](rps)); }
            c.pval_set = R.unwrap_ok[*bool, str](rps);

            var iid: u32 = 0;
            for (iid < c.n) { c.pval_set[iid] = false; iid = iid + 1; }

            c.is_vp = nil;
            if (c.pcount > 0) {
                val rvp: R.Result[*bool, str] = A.allocate[bool](m.alloc, c.pcount::usize);
                if (R.is_err[*bool, str](rvp)) { ctx_free(m, ?c); ret R.err[bool, str](R.unwrap_err[*bool, str](rvp)); }
                c.is_vp = R.unwrap_ok[*bool, str](rvp);
                var p: u32 = 0;
                for (p < c.pcount) {
                    c.is_vp[p] = mem_image(?c, fn.params[p].ty);
                    # a vector parameter is byref (memory class) on a scalarized target:
                    # its register holds a pointer, so retype the parameter value to
                    # `ptr` and its vreg lands in the GP bank. the signature (fn.sig)
                    # keeps the vector type for ABI classification.
                    if (c.is_vp[p]) { fn.params[p] = value.retype(fn.params[p], ptr_ty); }
                    p = p + 1;
                }
            }

            val rf: R.Result[bool, str] = scalarize_function(?c, i8_ty);
            ctx_free(m, ?c);
            if (R.is_err[bool, str](rf)) { ret rf; }
        }
        fi = fi + 1;
    }

    ret R.ok[bool, str](true);
}

# free a Ctx's owned scratch arrays
fun ctx_free(m: *ir.Module, c: *Ctx) {
    if (c.lane_buf != nil && c.lane_cap > 0) {
        A.deallocate[value.Value](m.alloc, c.lane_buf, c.lane_cap::usize);
        c.lane_buf = nil;
        c.lane_cap = 0;
    }
    if (c.pval != nil && c.n > 0)     { A.deallocate[value.Value](m.alloc, c.pval, c.n::usize); }
    if (c.pval_set != nil && c.n > 0) { A.deallocate[bool](m.alloc, c.pval_set, c.n::usize); }
    if (c.is_vp != nil && c.pcount > 0) { A.deallocate[bool](m.alloc, c.is_vp, c.pcount::usize); }
    c.pval = nil;
    c.pval_set = nil;
    c.is_vp = nil;
}

# detect counts only the lane-wise vector OPERATORS (a vector add and a vector mul
# here), not the scalar add sharing the same opcode, and names the first in program
# order -- the shared currency the note count and the require lever (#2017) both read,
# so they can never drift. arch-independent: it inspects IR, executing no vector code
test "mach.lang.me.pass.scalarize.detect:counts_only_vector_operators" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val res_f: R.Result[ir_type.IrTypeId, str] = ir_type.intern_float(?m.types, 32);
    if (R.is_err[ir_type.IrTypeId, str](res_f)) { ir.dnit(?m); ret 1; }
    val f32: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_f);
    val res_v: R.Result[ir_type.IrTypeId, str] = ir_type.intern_vector(?m.types, f32, 4);
    if (R.is_err[ir_type.IrTypeId, str](res_v)) { ir.dnit(?m); ret 1; }
    val vec: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_v);
    val res_i: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 32);
    if (R.is_err[ir_type.IrTypeId, str](res_i)) { ir.dnit(?m); ret 1; }
    val i32: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_blk)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_blk));

    val pv0: value.Value = value.param(0, vec);
    val pv1: value.Value = value.param(1, vec);
    val ps:  value.Value = value.param(2, i32);

    # a scalar add shares the OP_ADD opcode but is not a vector operator.
    if (R.is_err[value.Value, str](builder.emit_add(?bld, ps, ps))) { ir.dnit(?m); ret 1; }
    # two lane-wise vector operators.
    if (R.is_err[value.Value, str](builder.emit_add(?bld, pv0, pv1))) { ir.dnit(?m); ret 1; }
    if (R.is_err[value.Value, str](builder.emit_mul(?bld, pv0, pv1))) { ir.dnit(?m); ret 1; }

    var reg: target.TargetRegistry = target.registry_init();
    if (R.is_err[bool, str](target.register_all(?reg))) { ir.dnit(?m); ret 1; }
    val rt: R.Result[target.Target, str] = target.select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (R.is_err[target.Target, str](rt)) { ir.dnit(?m); ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](rt);

    var site: ScalarizeSite;
    val n: u32 = detect(?m, ?tgt, ?site);
    if (n != 2)                              { ir.dnit(?m); ret 1; }
    if (site.op != instruction.OP_ADD)       { ir.dnit(?m); ret 1; }
    if (site.lane_bits != 32)                { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

# build a one-function module holding a single lane-wise vector binary operator of
# `kind` over `lanes` lanes of `elem_bits`-wide integer, and return it
#
# Shared by the realization tests below so they all describe the same IR and differ
# only in the target they hand it to - which is the whole point, since the claim under
# test is that the TARGET decides the realization and nothing else does.
fun vec_binop_module(alloc: *A.Allocator, kind: instruction.InstrKind, elem_bits: u32, lanes: u32, out: *ir.Module) bool {
    val res_m: R.Result[ir.Module, str] = ir.init(alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret false; }
    @out = R.unwrap_ok[ir.Module, str](res_m);

    val res_e: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?out.types, elem_bits);
    if (R.is_err[ir_type.IrTypeId, str](res_e)) { ret false; }
    val elem: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_e);
    val res_v: R.Result[ir_type.IrTypeId, str] = ir_type.intern_vector(?out.types, elem, lanes);
    if (R.is_err[ir_type.IrTypeId, str](res_v)) { ret false; }
    val vec: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_v);

    val res_fn: R.Result[u32, str] = ir.function_add(out, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret false; }
    val fn: *ir.Function = ?out.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(out);
    builder.set_function(?bld, fn);
    val res_blk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_blk)) { ret false; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_blk));

    val pv0: value.Value = value.param(0, vec);
    val pv1: value.Value = value.param(1, vec);
    if (kind == instruction.OP_MUL) {
        if (R.is_err[value.Value, str](builder.emit_mul(?bld, pv0, pv1))) { ret false; }
        ret true;
    }
    if (R.is_err[value.Value, str](builder.emit_add(?bld, pv0, pv1))) { ret false; }
    ret true;
}

# select one of the three shipping machine targets by isa name
fun test_target(reg: *target.TargetRegistry, isa_name: str, out: *target.Target) bool {
    var abi: str = "sysv64";
    if (str_equals(isa_name, "aarch64")) { abi = "aapcs64"; }
    if (str_equals(isa_name, "riscv64")) { abi = "lp64d"; }
    val rt: R.Result[target.Target, str] = target.select_of(reg, isa_name, "linux", abi, "");
    if (R.is_err[target.Target, str](rt)) { ret false; }
    @out = R.unwrap_ok[target.Target, str](rt);
    ret true;
}

# THE AGREEMENT TEST (#2726): the `simd = "require"` diagnostic and the expansion
# that actually runs read one authority, so they cannot describe different operators
#
# Asserting the gap table against itself would prove nothing - a table always agrees
# with itself. What is asserted here is a relation between two INDEPENDENT
# observations of the same module: how many operators `detect` says will scalarize
# (the number the build error is raised from) and how many operators survive
# `expand_gap_ops` (what the compiler actually did). They must be N and 0. If the
# diagnostic over-reported, the expansion would leave the extra operator alone and
# the post-count would be 0 while a build under `require` had been refused for
# nothing; if it under-reported, an operator would reach the backend with no packed
# form to select it.
#
# The same `i32x4 * i32x4` is handed to all three targets, so the only variable is
# the target - which is the contract: legality is target-independent, realization is
# not.
test "mach.lang.me.pass.scalarize:require_and_expansion_read_one_authority" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    if (R.is_err[bool, str](target.register_all(?reg))) { ret 1; }

    # i32x4 multiply: no packed form on x86-64 (PMULLD is SSE4.1) or riscv64 (no
    # vector unit); NEON packs it as MUL.4s.
    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_MUL, 32, 4) != 1) { ret 1; }
    if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_MUL, 32, 4) != 1) { ret 2; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_MUL, 32, 4) != 0) { ret 3; }

    # i64x2 multiply: no target has a packed 64-bit lane integer multiply, so all
    # three scalarize it. This is the shape the aarch64 encoder's backstop covers.
    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_MUL, 64, 2) != 1) { ret 4; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_MUL, 64, 2) != 1) { ret 5; }
    if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_MUL, 64, 2) != 1) { ret 6; }

    # i16x8 multiply packs on both capable targets (PMULLW / MUL.8h) and scalarizes
    # only where there is no vector unit, so the gap is a real per-op fact and not a
    # blanket refusal of integer multiply.
    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_MUL, 16, 8) != 0) { ret 7; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_MUL, 16, 8) != 0) { ret 8; }
    if (gap_agreement(?alloc, ?reg, "riscv64", instruction.OP_MUL, 16, 8) != 1) { ret 9; }

    # i32x4 ADD packs on both capable targets, so the multiply above is not being
    # scalarized for being a vector op - it is being scalarized for being THIS op at
    # THIS lane width.
    if (gap_agreement(?alloc, ?reg, "x86_64", instruction.OP_ADD, 32, 4) != 0)  { ret 10; }
    if (gap_agreement(?alloc, ?reg, "aarch64", instruction.OP_ADD, 32, 4) != 0) { ret 11; }

    ret 0;
}

# the number of operators `detect` reports for one module on one target, checked
# against what `expand_gap_ops` actually leaves behind
#
# Returns the reported count, or a large sentinel when the two observations disagree
# or the setup fails - so a broken setup can never read as agreement.
fun gap_agreement(alloc: *A.Allocator, reg: *target.TargetRegistry, isa_name: str,
                  kind: instruction.InstrKind, elem_bits: u32, lanes: u32) u32 {
    var tgt: target.Target;
    if (!test_target(reg, isa_name, ?tgt)) { ret 0xFFFFFFFF; }
    var m: ir.Module;
    if (!vec_binop_module(alloc, kind, elem_bits, lanes, ?m)) { ret 0xFFFFFFFF; }

    var site: ScalarizeSite;
    val before: u32 = detect(?m, ?tgt, ?site);

    # only the capable targets run this stage; an incapable one is `run`'s whole-module
    # job, so the surviving-operator check does not apply to it.
    if (tgt.model.has_v128) {
        if (R.is_err[bool, str](expand_gap_ops(?m, ?tgt))) { ir.dnit(?m); ret 0xFFFFFFFF; }
        var after: ScalarizeSite;
        if (detect(?m, ?tgt, ?after) != 0) { ir.dnit(?m); ret 0xFFFFFFFF; }
    }

    ir.dnit(?m);
    ret before;
}

# build a one-function module holding a single lane-wise vector compare of `kind`
# over `elem_bits`-wide, `lanes`-lane integer vectors, scalarize it for `tgt`, and
# return the number of OP_SEXT instructions the expansion emitted
#
# The pass emits OP_SEXT only to sign-extend a narrow signed ordering compare's
# operands (#2077), so the count discriminates the fixed signed sub-word path (two
# extends per lane) from equality / unsigned / register-width lanes (none). Returns
# a large sentinel on any construction error so a failed setup never reads as a pass.
fun sext_count(tgt: *target.Target, kind: instruction.InstrKind, elem_bits: u32, lanes: u32) u32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 0xFFFFFFFF; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val res_e: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, elem_bits);
    if (R.is_err[ir_type.IrTypeId, str](res_e)) { ir.dnit(?m); ret 0xFFFFFFFF; }
    val elem: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_e);
    val res_v: R.Result[ir_type.IrTypeId, str] = ir_type.intern_vector(?m.types, elem, lanes);
    if (R.is_err[ir_type.IrTypeId, str](res_v)) { ir.dnit(?m); ret 0xFFFFFFFF; }
    val vec: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_v);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ir.dnit(?m); ret 0xFFFFFFFF; }
    val fidx: u32 = R.unwrap_ok[u32, str](res_fn);
    val fn: *ir.Function = ?m.functions[fidx];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_blk)) { ir.dnit(?m); ret 0xFFFFFFFF; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_blk));

    # two vector operands and a same-shape mask result; the operand element width is
    # what selects the sign-extension, so the mask type reuses the operand vector.
    val pv0: value.Value = value.param(0, vec);
    val pv1: value.Value = value.param(1, vec);
    if (R.is_err[value.Value, str](builder.emit_vcompare(?bld, kind, pv0, pv1, vec))) { ir.dnit(?m); ret 0xFFFFFFFF; }

    if (R.is_err[bool, str](run(?m, tgt))) { ir.dnit(?m); ret 0xFFFFFFFF; }

    val fnc: *ir.Function = ?m.functions[fidx];
    var count: u32 = 0;
    var i: u32 = 0;
    for (i < fnc.instr_len) {
        if (fnc.instrs[i].kind == instruction.OP_SEXT) { count = count + 1; }
        i = i + 1;
    }
    ir.dnit(?m);
    ret count;
}

# a signed sub-word ordering compare sign-extends both operands per lane so rv64's
# 64-bit `slt` reads a negative i8 / i16 lane correctly; equality, unsigned relations,
# and register-width lanes read the loaded lane directly (#2077). the OP_SEXT count is
# the discriminator: the sign-straddling case (`-1 < 0`) is correct only with these,
# and the small values the bug tolerates would not exercise the difference
test "mach.lang.me.pass.scalarize.expand_compare:sign_extends_narrow_signed_lanes" {
    var reg: target.TargetRegistry = target.registry_init();
    if (R.is_err[bool, str](target.register_all(?reg))) { ret 1; }
    val rt: R.Result[target.Target, str] = target.select_of(?reg, "riscv64", "linux", "lp64d", "");
    if (R.is_err[target.Target, str](rt)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](rt);

    # signed narrow ordering compares sign-extend both operands per lane: 8 i16 lanes
    # -> 16 sexts, 16 i8 lanes -> 32.
    if (sext_count(?tgt, instruction.OP_CMP_LT_S, 16, 8) != 16)  { ret 1; }
    if (sext_count(?tgt, instruction.OP_CMP_LE_S, 8, 16) != 32)  { ret 1; }

    # equality, unsigned relations, and register-width (i32) signed lanes emit none.
    if (sext_count(?tgt, instruction.OP_CMP_EQ, 16, 8) != 0)     { ret 1; }
    if (sext_count(?tgt, instruction.OP_CMP_LT_U, 16, 8) != 0)   { ret 1; }
    if (sext_count(?tgt, instruction.OP_CMP_LT_S, 32, 4) != 0)   { ret 1; }

    ret 0;
}
