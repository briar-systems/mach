# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module) res[bool, fail.Fail] {
    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, ?workspace);
}

pub fun run_in(m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var work: scratch.Function = scratch.Function{module: m, body: fn};
            val value_changed_r: res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, value_dce);
            if (sel value_changed_r.err) { ret value_changed_r; }
            if (value_changed_r.ok) { changed = true; }
            val reach_changed_r: res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, reachability_dce);
            if (sel reach_changed_r.err) { ret reach_changed_r; }
            if (reach_changed_r.ok) { changed = true; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

rec DceMarks {
    dead: *bool;
    ilen: u32;
}

fun dce_marked(c: *DceMarks, iid: id.InstructionId) bool {
    if (iid::u32 >= c.ilen) { ret false; }
    ret c.dead[iid::u32];
}

fun value_dce(request: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = request.module;
    val fn: *ir.Function = request.body;
    val ilen: u32 = fn.instr_len;
    if (ilen == 0) { ret res[bool, fail.Fail].ok{false}; }

    val res_live: res[*bool, A.Error] = A.allocate[bool](alloc, ilen::usize);
    if (sel res_live.err) {
        ret res[bool, fail.Fail].err{fail.refused(res_live.err)};
    }
    val live: *bool = res_live.ok;

    val res_dead: res[*bool, A.Error] = A.allocate[bool](alloc, ilen::usize);
    if (sel res_dead.err) {
        A.deallocate[bool](alloc, live, ilen::usize);
        ret res[bool, fail.Fail].err{fail.refused(res_dead.err)};
    }
    val dead: *bool = res_dead.ok;

    val res_work: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](alloc, ilen::usize);
    if (sel res_work.err) {
        A.deallocate[bool](alloc, live, ilen::usize);
        A.deallocate[bool](alloc, dead, ilen::usize);
        ret res[bool, fail.Fail].err{fail.refused(res_work.err)};
    }
    val work: *id.InstructionId = res_work.ok;

    var i: u32 = 0;
    for (i < ilen) {
        live[i] = false;
        dead[i] = false;
        i = i + 1;
    }

    var wlen: u32 = 0;
    i = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];

        var ii: u32 = 0;
        for (ii < blk.phi_count) {
            classify_listed(fn, blk.phis[ii], live, dead, work, ?wlen, ilen);
            ii = ii + 1;
        }

        ii = 0;
        for (ii < blk.instr_count) {
            classify_listed(fn, blk.instructions[ii], live, dead, work, ?wlen, ilen);
            ii = ii + 1;
        }

        if (blk.terminator != id.INSTR_NIL) {
            classify_listed(fn, blk.terminator, live, dead, work, ?wlen, ilen);
        }

        i = i + 1;
    }

    for (wlen > 0) {
        wlen = wlen - 1;
        val did:  u32                      = work[wlen]::u32;
        val inst: *instruction.Instruction = ?fn.instrs[did];

        var lc: LiveWalk;
        lc.live = live;
        lc.dead = dead;
        lc.work = work;
        lc.wlen = wlen;
        lc.ilen = ilen;
        refs.visit_operands[LiveWalk](inst, ?lc, mark_operand_use);
        wlen = lc.wlen;
    }

    var marks: DceMarks;
    marks.dead = dead;
    marks.ilen = ilen;
    val erased_r: res[bool, fail.Fail] =
        mutate.erase_marked[DceMarks](m, fn, ?marks, dce_marked);

    A.deallocate[bool](alloc, live, ilen::usize);
    A.deallocate[bool](alloc, dead, ilen::usize);
    A.deallocate[id.InstructionId](alloc, work, ilen::usize);
    ret erased_r;
}

fun is_removable_when_unused(inst: *instruction.Instruction) bool {
    ret effect.discardable(inst);
}

fun classify_listed(fn: *ir.Function, iid: id.InstructionId, live: *bool, dead: *bool, work: *id.InstructionId, wlen: *u32, ilen: u32) {
    val idx: u32 = iid::u32;
    if (idx >= ilen) { ret; }

    val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_inst.none) { ret; }
    val inst: *instruction.Instruction = opt_inst.some;

    if (is_removable_when_unused(inst)) {
        dead[idx] = true;
        ret;
    }
    if (live[idx] == false) {
        live[idx]   = true;
        work[@wlen] = iid;
        @wlen       = @wlen + 1;
    }
}

rec LiveWalk {
    live: *bool;
    dead: *bool;
    work: *id.InstructionId;
    wlen: u32;
    ilen: u32;
}

fun mark_operand_use(c: *LiveWalk, r: *refs.Ref) bool {
    if (r.role != refs.REF_VALUE_USE)      { ret true; }
    if (r.value.kind != value.VAL_INSTR)   { ret true; }
    val def_id: u32 = r.value.data.instr::u32;
    if (def_id >= c.ilen)                  { ret true; }
    c.dead[def_id] = false;
    if (c.live[def_id] == false) {
        c.live[def_id] = true;
        c.work[c.wlen] = def_id::id.InstructionId;
        c.wlen         = c.wlen + 1;
    }
    ret true;
}

fun reachability_dce(request: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    ret reachability.prune(request.module, request.body, alloc);
}

test "mach.lang.me.pass.dce.run:unused_phi_removed" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fi: u32 = res_fn.ok;
    val fn: *ir.Function = ?m.functions[fi];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: id.BlockId = res_entry.ok;

    val res_join: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_join.err) { ret 1; }
    val join: id.BlockId = res_join.ok;

    builder.set_block(?bld, entry);
    val res_br: err[fail.Fail] = builder.emit_br(?bld, join);
    if (sel res_br.err) { ret 1; }

    builder.set_block(?bld, join);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel res_phi.err) { ret 1; }
    val phi: value.Value = res_phi.ok;

    val res_incoming: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, value.const_int(5, i64t));
    if (sel res_incoming.err) { ret 1; }
    val res_ret: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(9, i64t));
    if (sel res_ret.err) { ret 1; }

    val res_run: res[bool, fail.Fail] = run(?m);
    if (sel res_run.err) { ret 1; }

    if ((?fn.blocks[join::u32]).phi_count != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:unused_integer_division_and_remainder_are_retained" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: id.BlockId = res_entry.ok;
    builder.set_block(?bld, entry);

    val lhs: value.Value = value.param(0, i64t);
    val rhs: value.Value = value.param(1, i64t);
    val r_267: res[value.Value, fail.Fail] = builder.emit_div_s(?bld, lhs, rhs);
    if (sel r_267.err) { ret 1; }
    val r_268: res[value.Value, fail.Fail] = builder.emit_div_u(?bld, lhs, rhs);
    if (sel r_268.err) { ret 1; }
    val r_269: res[value.Value, fail.Fail] = builder.emit_rem_s(?bld, lhs, rhs);
    if (sel r_269.err) { ret 1; }
    val r_270: res[value.Value, fail.Fail] = builder.emit_rem_u(?bld, lhs, rhs);
    if (sel r_270.err) { ret 1; }
    val r_271: res[value.Value, fail.Fail] = builder.emit_add(?bld, lhs, rhs);
    if (sel r_271.err) { ret 1; }
    val r_272: err[fail.Fail] = builder.emit_ret(?bld, lhs);
    if (sel r_272.err) { ret 1; }

    val r_274: res[bool, fail.Fail] = run(?m);
    if (sel r_274.err) { ret 1; }
    val block: *ir.Block = ?fn.blocks[entry::u32];
    if (block.instr_count != 4) { ret 1; }
    if (fn.instrs[block.instructions[0]::u32].kind != instruction.OP_DIV_S) { ret 1; }
    if (fn.instrs[block.instructions[1]::u32].kind != instruction.OP_DIV_U) { ret 1; }
    if (fn.instrs[block.instructions[2]::u32].kind != instruction.OP_REM_S) { ret 1; }
    if (fn.instrs[block.instructions[3]::u32].kind != instruction.OP_REM_U) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:unused_store_is_retained_until_rem_132_adds_dead_store_elimination" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: id.BlockId = res_entry.ok;
    builder.set_block(?bld, entry);

    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val p: value.Value = res_alloca.ok;

    val r_309: err[fail.Fail] = builder.emit_store(?bld, value.const_int(7, i64t), p);
    if (sel r_309.err) { ret 1; }
    val r_310: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(0, i64t));
    if (sel r_310.err) { ret 1; }

    val r_312: res[bool, fail.Fail] = run(?m);
    if (sel r_312.err) { ret 1; }
    val block: *ir.Block = ?fn.blocks[entry::u32];
    if (block.instr_count != 2) { ret 1; }
    if (fn.instrs[block.instructions[0]::u32].kind != instruction.OP_ALLOCA) { ret 1; }
    if (fn.instrs[block.instructions[1]::u32].kind != instruction.OP_STORE)  { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:dead_phi_cycle_removed" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rb0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb3: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb4: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb5: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 1; }
    if (sel rb1.err) { ret 1; }
    if (sel rb2.err) { ret 1; }
    if (sel rb3.err) { ret 1; }
    if (sel rb4.err) { ret 1; }
    if (sel rb5.err) { ret 1; }
    val entry:  id.BlockId = rb0.ok;
    val header: id.BlockId = rb1.ok;
    val body:   id.BlockId = rb2.ok;
    val then_b: id.BlockId = rb3.ok;
    val latch:  id.BlockId = rb4.ok;
    val exit_b: id.BlockId = rb5.ok;

    builder.set_block(?bld, header);
    val res_ph: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel res_ph.err) { ret 1; }
    val phi_h: value.Value = res_ph.ok;

    builder.set_block(?bld, latch);
    val res_pm: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel res_pm.err) { ret 1; }
    val phi_m: value.Value = res_pm.ok;

    val cond: value.Value = value.param(0, i64t);

    builder.set_block(?bld, entry);
    val r_371: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_371.err) { ret 1; }
    builder.set_block(?bld, header);
    val r_373: err[fail.Fail] = builder.emit_cbr(?bld, cond, body, exit_b);
    if (sel r_373.err) { ret 1; }
    builder.set_block(?bld, body);
    val r_375: err[fail.Fail] = builder.emit_cbr(?bld, cond, then_b, latch);
    if (sel r_375.err) { ret 1; }
    builder.set_block(?bld, then_b);
    val r_377: err[fail.Fail] = builder.emit_br(?bld, latch);
    if (sel r_377.err) { ret 1; }
    builder.set_block(?bld, latch);
    val r_379: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_379.err) { ret 1; }
    builder.set_block(?bld, exit_b);
    val r_381: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(0, i64t));
    if (sel r_381.err) { ret 1; }

    val r_383: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_h, entry, value.const_int(0, i64t));
    if (sel r_383.err) { ret 1; }
    val r_384: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_h, latch, phi_m);
    if (sel r_384.err) { ret 1; }
    val r_385: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_m, then_b, value.const_int(7, i64t));
    if (sel r_385.err) { ret 1; }
    val r_386: err[fail.Fail] = builder.phi_add_incoming(?bld, phi_m, body, phi_h);
    if (sel r_386.err) { ret 1; }

    val r_388: res[bool, fail.Fail] = run(?m);
    if (sel r_388.err) { ret 1; }

    if ((?fn.blocks[header::u32]).phi_count != 0) { ret 1; }
    if ((?fn.blocks[latch::u32]).phi_count != 0)  { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:dead_block_and_phi_pruned" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fi: u32 = res_fn.ok;
    val fn: *ir.Function = ?m.functions[fi];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: id.BlockId = res_entry.ok;

    val res_live: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_live.err) { ret 1; }
    val b_live: id.BlockId = res_live.ok;

    val res_dead: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_dead.err) { ret 1; }
    val b_dead: id.BlockId = res_dead.ok;

    builder.set_block(?bld, entry);
    val r_428: err[fail.Fail] = builder.emit_br(?bld, b_live);
    if (sel r_428.err) { ret 1; }

    builder.set_block(?bld, b_live);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel res_phi.err) { ret 1; }
    val phi: value.Value = res_phi.ok;
    val r_434: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, value.const_int(10, i64t));
    if (sel r_434.err) { ret 1; }
    val r_435: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, b_dead, value.const_int(20, i64t));
    if (sel r_435.err) { ret 1; }
    val r_436: err[fail.Fail] = builder.emit_ret(?bld, phi);
    if (sel r_436.err) { ret 1; }

    builder.set_block(?bld, b_dead);
    val r_439: err[fail.Fail] = builder.emit_br(?bld, b_live);
    if (sel r_439.err) { ret 1; }

    val r_441: res[bool, fail.Fail] = run(?m);
    if (sel r_441.err) { ret 1; }

    if (fn.block_count != 2) { ret 1; }
    val phi_id: id.InstructionId = fn.blocks[1].phis[0];
    val phi_inst: *instruction.Instruction = ?fn.instrs[phi_id];
    if (phi_inst.operand_count != 2) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:salvages_metadata_free_dbg_value" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    builder.set_block(?bld, res_entry.ok);

    val p0: value.Value = value.param(0, i64t);
    val p1: value.Value = value.param(1, i64t);

    val res_x: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_x.err) { ret 1; }
    val x: value.Value = res_x.ok;

    val r_479: err[fail.Fail] = builder.emit_dbg_value(?bld, x, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0);
    if (sel r_479.err) { ret 1; }
    val r_480: err[fail.Fail] = builder.emit_ret(?bld, p0);
    if (sel r_480.err) { ret 1; }

    map.clear[id.InstructionId, ir.DbgVar](?fn.dbg_vars);

    val r_484: res[bool, fail.Fail] = run(?m);
    if (sel r_484.err) { ret 1; }

    var found: bool = false;
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val ins: *instruction.Instruction = ?fn.instrs[i];
        if (ins.kind == instruction.OP_DBG_VALUE) {
            found = true;
            if (ins.operands[0].kind != value.VAL_CONST_NULL) { ret 1; }
        }
        i = i + 1;
    }
    if (found == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:reports_no_change_when_every_instruction_is_live" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    builder.set_block(?bld, res_entry.ok);

    val p0: value.Value = value.param(0, i64t);
    val p1: value.Value = value.param(1, i64t);

    val res_x: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_x.err) { ret 1; }
    val x: value.Value = res_x.ok;

    val r_529: err[fail.Fail] = builder.emit_ret(?bld, x);
    if (sel r_529.err) { ret 1; }

    val res_run: res[bool, fail.Fail] = run(?m);
    if (sel res_run.err) { ret 1; }
    if (res_run.ok != false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:reports_change_when_a_dead_phi_is_removed" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fi: u32 = res_fn.ok;
    val fn: *ir.Function = ?m.functions[fi];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: id.BlockId = res_entry.ok;

    val res_join: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_join.err) { ret 1; }
    val join: id.BlockId = res_join.ok;

    builder.set_block(?bld, entry);
    val res_br: err[fail.Fail] = builder.emit_br(?bld, join);
    if (sel res_br.err) { ret 1; }

    builder.set_block(?bld, join);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel res_phi.err) { ret 1; }
    val phi: value.Value = res_phi.ok;

    val res_incoming: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, value.const_int(5, i64t));
    if (sel res_incoming.err) { ret 1; }
    val res_ret: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(9, i64t));
    if (sel res_ret.err) { ret 1; }

    val res_run: res[bool, fail.Fail] = run(?m);
    if (sel res_run.err) { ret 1; }
    if (res_run.ok != true) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:reports_change_when_an_unreachable_block_is_pruned" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    builder.set_block(?bld, res_entry.ok);
    val r_607: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(1, i64t));
    if (sel r_607.err) { ret 1; }

    val res_dead: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_dead.err) { ret 1; }
    builder.set_block(?bld, res_dead.ok);
    val r_612: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(2, i64t));
    if (sel r_612.err) { ret 1; }

    val res_run: res[bool, fail.Fail] = run(?m);
    if (sel res_run.err) { ret 1; }
    if (res_run.ok != true) { ret 1; }
    if (fn.block_count != 1) { ret 1; }
    ret 0;
}
