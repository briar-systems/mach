use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use std.collections.map;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.refs;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use semtype: mach.lang.type;

val BLOCK_GONE: u32 = 0xFFFFFFFF;

pub fun run(m: *ir.Module) R.Result[bool, str] {
    var changed: bool = false;
    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var work: scratch.Function = scratch.Function{module: m, body: fn};
            val value_changed_r: R.Result[bool, str] = scratch.run[scratch.Function](m.alloc, ?work, value_dce);
            if (R.is_err[bool, str](value_changed_r)) { ret value_changed_r; }
            if (R.unwrap_ok[bool, str](value_changed_r)) { changed = true; }
            val reach_changed_r: R.Result[bool, str] = scratch.run[scratch.Function](m.alloc, ?work, reachability_dce);
            if (R.is_err[bool, str](reach_changed_r)) { ret reach_changed_r; }
            if (R.unwrap_ok[bool, str](reach_changed_r)) { changed = true; }
        }
        i = i + 1;
    }
    ret R.ok[bool, str](changed);
}

rec DceMarks {
    dead: *bool;
    ilen: u32;
}

fun dce_marked(c: *DceMarks, iid: id.InstructionId) bool {
    if (iid::u32 >= c.ilen) { ret false; }
    ret c.dead[iid::u32];
}

fun value_dce(request: *scratch.Function, alloc: *A.Allocator) R.Result[bool, str] {
    val m: *ir.Module = request.module;
    val fn: *ir.Function = request.body;
    val ilen: u32 = fn.instr_len;
    if (ilen == 0) { ret R.ok[bool, str](false); }

    val res_live: R.Result[*bool, str] = A.allocate[bool](alloc, ilen::usize);
    if (R.is_err[*bool, str](res_live)) {
        ret R.err[bool, str](R.unwrap_err[*bool, str](res_live));
    }
    val live: *bool = R.unwrap_ok[*bool, str](res_live);

    val res_dead: R.Result[*bool, str] = A.allocate[bool](alloc, ilen::usize);
    if (R.is_err[*bool, str](res_dead)) {
        A.deallocate[bool](alloc, live, ilen::usize);
        ret R.err[bool, str](R.unwrap_err[*bool, str](res_dead));
    }
    val dead: *bool = R.unwrap_ok[*bool, str](res_dead);

    val res_work: R.Result[*id.InstructionId, str] = A.allocate[id.InstructionId](alloc, ilen::usize);
    if (R.is_err[*id.InstructionId, str](res_work)) {
        A.deallocate[bool](alloc, live, ilen::usize);
        A.deallocate[bool](alloc, dead, ilen::usize);
        ret R.err[bool, str](R.unwrap_err[*id.InstructionId, str](res_work));
    }
    val work: *id.InstructionId = R.unwrap_ok[*id.InstructionId, str](res_work);

    var i: u32 = 0;
    for (i < ilen) {
        live[i] = false;
        dead[i] = false;
        i = i + 1;
    }

    var wlen: u32 = 0;
    i = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];

        var ii: u32 = 0;
        for (ii < blk.phi_count) {
            classify_listed(fn, blk.phis[ii], live, dead, work, ?wlen, ilen);
            ii = ii + 1;
        }

        ii = 0;
        for (ii < blk.instr_count) {
            classify_listed(fn, blk.instructions[ii], live, dead, work, ?wlen, ilen);
            ii = ii + 1;
        }

        if (blk.terminator != id.INSTR_NIL) {
            classify_listed(fn, blk.terminator, live, dead, work, ?wlen, ilen);
        }

        i = i + 1;
    }

    for (wlen > 0) {
        wlen = wlen - 1;
        val did:  u32                      = work[wlen]::u32;
        val inst: *instruction.Instruction = ?fn.instrs[did];

        var lc: LiveWalk;
        lc.live = live;
        lc.dead = dead;
        lc.work = work;
        lc.wlen = wlen;
        lc.ilen = ilen;
        refs.visit_operands[LiveWalk](inst, ?lc, mark_operand_use);
        wlen = lc.wlen;
    }

    var marks: DceMarks;
    marks.dead = dead;
    marks.ilen = ilen;
    val erased_r: R.Result[bool, str] =
        mutate.erase_marked[DceMarks](m, fn, ?marks, dce_marked);

    A.deallocate[bool](alloc, live, ilen::usize);
    A.deallocate[bool](alloc, dead, ilen::usize);
    A.deallocate[id.InstructionId](alloc, work, ilen::usize);
    ret erased_r;
}

fun is_removable_when_unused(inst: *instruction.Instruction) bool {
    ret effect.discardable(inst);
}

fun classify_listed(fn: *ir.Function, iid: id.InstructionId, live: *bool, dead: *bool, work: *id.InstructionId, wlen: *u32, ilen: u32) {
    val idx: u32 = iid::u32;
    if (idx >= ilen) { ret; }

    val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (O.is_none[*instruction.Instruction](opt_inst)) { ret; }
    val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);

    if (is_removable_when_unused(inst)) {
        dead[idx] = true;
        ret;
    }
    if (live[idx] == false) {
        live[idx]   = true;
        work[@wlen] = iid;
        @wlen       = @wlen + 1;
    }
}

rec LiveWalk {
    live: *bool;
    dead: *bool;
    work: *id.InstructionId;
    wlen: u32;
    ilen: u32;
}

fun mark_operand_use(c: *LiveWalk, r: *refs.Ref) bool {
    if (r.role != refs.REF_VALUE_USE)      { ret true; }
    if (r.value.kind != value.VAL_INSTR)   { ret true; }
    val def_id: u32 = r.value.data.instr::u32;
    if (def_id >= c.ilen)                  { ret true; }
    c.dead[def_id] = false;
    if (c.live[def_id] == false) {
        c.live[def_id] = true;
        c.work[c.wlen] = def_id::id.InstructionId;
        c.wlen         = c.wlen + 1;
    }
    ret true;
}

fun reachability_dce(request: *scratch.Function, alloc: *A.Allocator) R.Result[bool, str] {
    val m: *ir.Module = request.module;
    val fn: *ir.Function = request.body;
    val n: u32 = fn.block_count;
    if (n == 0) { ret R.ok[bool, str](false); }

    val res_reach: R.Result[*bool, str] = A.allocate[bool](alloc, n::usize);
    if (R.is_err[*bool, str](res_reach)) {
        ret R.err[bool, str](R.unwrap_err[*bool, str](res_reach));
    }
    val reach: *bool = R.unwrap_ok[*bool, str](res_reach);

    val res_queue: R.Result[*id.BlockId, str] = A.allocate[id.BlockId](alloc, n::usize);
    if (R.is_err[*id.BlockId, str](res_queue)) {
        A.deallocate[bool](alloc, reach, n::usize);
        ret R.err[bool, str](R.unwrap_err[*id.BlockId, str](res_queue));
    }
    val queue: *id.BlockId = R.unwrap_ok[*id.BlockId, str](res_queue);

    var i: u32 = 0;
    for (i < n) {
        reach[i] = false;
        i = i + 1;
    }

    var qhead: u32 = 0;
    var qtail: u32 = 0;
    reach[0]     = true;
    queue[qtail] = 0::id.BlockId;
    qtail        = qtail + 1;
    for (qhead < qtail) {
        val bid: id.BlockId = queue[qhead];
        qhead = qhead + 1;

        var s0: id.BlockId = id.BLOCK_NIL;
        var s1: id.BlockId = id.BLOCK_NIL;
        val sn: u32 = ir.block_successors(fn, ?fn.blocks[bid::u32], ?s0, ?s1);

        if (sn >= 1 && s0 != id.BLOCK_NIL && s0::u32 < n && reach[s0::u32] == false) {
            reach[s0::u32] = true;
            queue[qtail]   = s0;
            qtail          = qtail + 1;
        }
        if (sn >= 2 && s1 != id.BLOCK_NIL && s1::u32 < n && reach[s1::u32] == false) {
            reach[s1::u32] = true;
            queue[qtail]   = s1;
            qtail          = qtail + 1;
        }
    }

    var all_reach: bool = true;
    i = 0;
    for (i < n) {
        if (reach[i] == false) {
            all_reach = false;
            brk;
        }
        i = i + 1;
    }
    if (all_reach) {
        A.deallocate[bool](alloc, reach, n::usize);
        A.deallocate[id.BlockId](alloc, queue, n::usize);
        ret R.ok[bool, str](false);
    }

    val res_remap: R.Result[*u32, str] = A.allocate[u32](alloc, n::usize);
    if (R.is_err[*u32, str](res_remap)) {
        A.deallocate[bool](alloc, reach, n::usize);
        A.deallocate[id.BlockId](alloc, queue, n::usize);
        ret R.err[bool, str](R.unwrap_err[*u32, str](res_remap));
    }
    val remap: *u32 = R.unwrap_ok[*u32, str](res_remap);

    var next: u32 = 0;
    i = 0;
    for (i < n) {
        if (reach[i]) {
            remap[i] = next;
            next     = next + 1;
        }
        or {
            remap[i] = BLOCK_GONE;
        }
        i = i + 1;
    }

    i = 0;
    for (i < n) {
        if (reach[i] == false) {
            block_arrays_free(m, ?fn.blocks[i]);
        }
        i = i + 1;
    }

    var w: u32 = 0;
    var r: u32 = 0;
    for (r < n) {
        if (reach[r]) {
            if (w != r) { fn.blocks[w] = fn.blocks[r]; }
            var blk: *ir.Block = ?fn.blocks[w];
            blk.id         = w::id.BlockId;
            blk.pred_count = remap_preds(blk.preds, blk.pred_count, remap);
            w = w + 1;
        }
        r = r + 1;
    }
    fn.block_count = w;

    i = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        remap_terminator(fn, blk, remap);
        prune_phis(fn, blk, remap);
        i = i + 1;
    }

    A.deallocate[bool](alloc, reach, n::usize);
    A.deallocate[id.BlockId](alloc, queue, n::usize);
    A.deallocate[u32](alloc, remap, n::usize);
    ret R.ok[bool, str](true);
}

fun block_arrays_free(m: *ir.Module, blk: *ir.Block) {
    if (blk.instructions != nil && blk.instr_cap > 0) {
        A.deallocate[id.InstructionId](m.alloc, blk.instructions, blk.instr_cap::usize);
    }
    if (blk.phis != nil && blk.phi_cap > 0) {
        A.deallocate[id.InstructionId](m.alloc, blk.phis, blk.phi_cap::usize);
    }
    if (blk.preds != nil && blk.pred_cap > 0) {
        A.deallocate[id.BlockId](m.alloc, blk.preds, blk.pred_cap::usize);
    }
}

fun remap_preds(preds: *id.BlockId, len: u32, remap: *u32) u32 {
    var w: u32 = 0;
    var r: u32 = 0;
    for (r < len) {
        val old: u32 = preds[r]::u32;
        if (remap[old] != BLOCK_GONE) {
            preds[w] = remap[old]::id.BlockId;
            w = w + 1;
        }
        r = r + 1;
    }
    ret w;
}

fun remap_terminator(fn: *ir.Function, blk: *ir.Block, remap: *u32) {
    if (blk.terminator == id.INSTR_NIL) { ret; }
    val opt_term: O.Option[*instruction.Instruction] = ir.instruction_get(fn, blk.terminator);
    if (O.is_none[*instruction.Instruction](opt_term)) { ret; }
    val term: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_term);

    var o: u32 = 0;
    for (o < term.operand_count) {
        if (refs.operand_is_block(term.kind, o)) {
            val old: u32 = term.operands[o].data.int_lit::u32;
            if (remap[old] != BLOCK_GONE) { term.operands[o].data.int_lit = remap[old]::u64; }
        }
        o = o + 1;
    }
}

fun prune_phis(fn: *ir.Function, blk: *ir.Block, remap: *u32) {
    var i: u32 = 0;
    for (i < blk.phi_count) {
        val opt_phi: O.Option[*instruction.Instruction] = ir.instruction_get(fn, blk.phis[i]);
        if (O.is_some[*instruction.Instruction](opt_phi)) {
            val phi: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_phi);
            if (phi.kind == instruction.OP_PHI) {
                var w: u32 = 0;
                var r: u32 = 0;
                for (r + 1 < phi.operand_count) {
                    val old: u32 = phi.operands[r].data.int_lit::u32;
                    if (remap[old] != BLOCK_GONE) {
                        phi.operands[w]              = phi.operands[r];
                        phi.operands[w].data.int_lit = remap[old]::u64;
                        phi.operands[w + 1]          = phi.operands[r + 1];
                        w = w + 2;
                    }
                    r = r + 2;
                }
                phi.operand_count = w;
            }
        }
        i = i + 1;
    }
}

test "mach.lang.me.pass.dce.run:unused_phi_removed" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fi: u32 = R.unwrap_ok[u32, str](res_fn);
    val fn: *ir.Function = ?m.functions[fi];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_entry: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_entry)) { ret 1; }
    val entry: id.BlockId = R.unwrap_ok[id.BlockId, str](res_entry);

    val res_join: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_join)) { ret 1; }
    val join: id.BlockId = R.unwrap_ok[id.BlockId, str](res_join);

    builder.set_block(?bld, entry);
    val res_br: R.Result[R.Void, str] = builder.emit_br(?bld, join);
    if (R.is_err[R.Void, str](res_br)) { ret 1; }

    builder.set_block(?bld, join);
    val res_phi: R.Result[value.Value, str] = builder.emit_phi(?bld, i64t);
    if (R.is_err[value.Value, str](res_phi)) { ret 1; }
    val phi: value.Value = R.unwrap_ok[value.Value, str](res_phi);

    val res_incoming: R.Result[R.Void, str] = builder.phi_add_incoming(?bld, phi, entry, value.const_int(5, i64t));
    if (R.is_err[R.Void, str](res_incoming)) { ret 1; }
    val res_ret: R.Result[R.Void, str] = builder.emit_ret(?bld, value.const_int(9, i64t));
    if (R.is_err[R.Void, str](res_ret)) { ret 1; }

    val res_run: R.Result[bool, str] = run(?m);
    if (R.is_err[bool, str](res_run)) { ret 1; }

    if ((?fn.blocks[join::u32]).phi_count != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:unused_integer_division_and_remainder_are_retained" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);
    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);
    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_entry)) { ret 1; }
    val entry: id.BlockId = R.unwrap_ok[id.BlockId, str](res_entry);
    builder.set_block(?bld, entry);

    val lhs: value.Value = value.param(0, i64t);
    val rhs: value.Value = value.param(1, i64t);
    if (R.is_err[value.Value, str](builder.emit_div_s(?bld, lhs, rhs))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_div_u(?bld, lhs, rhs))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_rem_s(?bld, lhs, rhs))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_rem_u(?bld, lhs, rhs))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_add(?bld, lhs, rhs)))   { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, lhs)))              { ret 1; }

    if (R.is_err[bool, str](run(?m))) { ret 1; }
    val block: *ir.Block = ?fn.blocks[entry::u32];
    if (block.instr_count != 4) { ret 1; }
    if (fn.instrs[block.instructions[0]::u32].kind != instruction.OP_DIV_S) { ret 1; }
    if (fn.instrs[block.instructions[1]::u32].kind != instruction.OP_DIV_U) { ret 1; }
    if (fn.instrs[block.instructions[2]::u32].kind != instruction.OP_REM_S) { ret 1; }
    if (fn.instrs[block.instructions[3]::u32].kind != instruction.OP_REM_U) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:unused_store_is_retained_until_rem_132_adds_dead_store_elimination" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);
    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);
    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_entry)) { ret 1; }
    val entry: id.BlockId = R.unwrap_ok[id.BlockId, str](res_entry);
    builder.set_block(?bld, entry);

    val res_alloca: R.Result[value.Value, str] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](res_alloca)) { ret 1; }
    val p: value.Value = R.unwrap_ok[value.Value, str](res_alloca);

    if (R.is_err[R.Void, str](builder.emit_store(?bld, value.const_int(7, i64t), p))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.const_int(0, i64t))))      { ret 1; }

    if (R.is_err[bool, str](run(?m))) { ret 1; }
    val block: *ir.Block = ?fn.blocks[entry::u32];
    if (block.instr_count != 2) { ret 1; }
    if (fn.instrs[block.instructions[0]::u32].kind != instruction.OP_ALLOCA) { ret 1; }
    if (fn.instrs[block.instructions[1]::u32].kind != instruction.OP_STORE)  { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:dead_phi_cycle_removed" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rb0: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb1: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb2: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb3: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb4: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb5: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rb0) || R.is_err[id.BlockId, str](rb1) || R.is_err[id.BlockId, str](rb2)) { ret 1; }
    if (R.is_err[id.BlockId, str](rb3) || R.is_err[id.BlockId, str](rb4) || R.is_err[id.BlockId, str](rb5)) { ret 1; }
    val entry:  id.BlockId = R.unwrap_ok[id.BlockId, str](rb0);
    val header: id.BlockId = R.unwrap_ok[id.BlockId, str](rb1);
    val body:   id.BlockId = R.unwrap_ok[id.BlockId, str](rb2);
    val then_b: id.BlockId = R.unwrap_ok[id.BlockId, str](rb3);
    val latch:  id.BlockId = R.unwrap_ok[id.BlockId, str](rb4);
    val exit_b: id.BlockId = R.unwrap_ok[id.BlockId, str](rb5);

    builder.set_block(?bld, header);
    val res_ph: R.Result[value.Value, str] = builder.emit_phi(?bld, i64t);
    if (R.is_err[value.Value, str](res_ph)) { ret 1; }
    val phi_h: value.Value = R.unwrap_ok[value.Value, str](res_ph);

    builder.set_block(?bld, latch);
    val res_pm: R.Result[value.Value, str] = builder.emit_phi(?bld, i64t);
    if (R.is_err[value.Value, str](res_pm)) { ret 1; }
    val phi_m: value.Value = R.unwrap_ok[value.Value, str](res_pm);

    val cond: value.Value = value.param(0, i64t);

    builder.set_block(?bld, entry);
    if (R.is_err[R.Void, str](builder.emit_br(?bld, header)))              { ret 1; }
    builder.set_block(?bld, header);
    if (R.is_err[R.Void, str](builder.emit_cbr(?bld, cond, body, exit_b))) { ret 1; }
    builder.set_block(?bld, body);
    if (R.is_err[R.Void, str](builder.emit_cbr(?bld, cond, then_b, latch))) { ret 1; }
    builder.set_block(?bld, then_b);
    if (R.is_err[R.Void, str](builder.emit_br(?bld, latch)))               { ret 1; }
    builder.set_block(?bld, latch);
    if (R.is_err[R.Void, str](builder.emit_br(?bld, header)))              { ret 1; }
    builder.set_block(?bld, exit_b);
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.const_int(0, i64t)))) { ret 1; }

    if (R.is_err[R.Void, str](builder.phi_add_incoming(?bld, phi_h, entry, value.const_int(0, i64t)))) { ret 1; }
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?bld, phi_h, latch, phi_m)))                    { ret 1; }
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?bld, phi_m, then_b, value.const_int(7, i64t)))) { ret 1; }
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?bld, phi_m, body, phi_h)))                      { ret 1; }

    if (R.is_err[bool, str](run(?m))) { ret 1; }

    if ((?fn.blocks[header::u32]).phi_count != 0) { ret 1; }
    if ((?fn.blocks[latch::u32]).phi_count != 0)  { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:dead_block_and_phi_pruned" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fi: u32 = R.unwrap_ok[u32, str](res_fn);
    val fn: *ir.Function = ?m.functions[fi];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_entry: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_entry)) { ret 1; }
    val entry: id.BlockId = R.unwrap_ok[id.BlockId, str](res_entry);

    val res_live: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_live)) { ret 1; }
    val b_live: id.BlockId = R.unwrap_ok[id.BlockId, str](res_live);

    val res_dead: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_dead)) { ret 1; }
    val b_dead: id.BlockId = R.unwrap_ok[id.BlockId, str](res_dead);

    builder.set_block(?bld, entry);
    if (R.is_err[R.Void, str](builder.emit_br(?bld, b_live))) { ret 1; }

    builder.set_block(?bld, b_live);
    val res_phi: R.Result[value.Value, str] = builder.emit_phi(?bld, i64t);
    if (R.is_err[value.Value, str](res_phi)) { ret 1; }
    val phi: value.Value = R.unwrap_ok[value.Value, str](res_phi);
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?bld, phi, entry, value.const_int(10, i64t))))  { ret 1; }
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?bld, phi, b_dead, value.const_int(20, i64t)))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, phi)))                                            { ret 1; }

    builder.set_block(?bld, b_dead);
    if (R.is_err[R.Void, str](builder.emit_br(?bld, b_live))) { ret 1; }

    if (R.is_err[bool, str](run(?m))) { ret 1; }

    if (fn.block_count != 2) { ret 1; }
    val phi_id: id.InstructionId = fn.blocks[1].phis[0];
    val phi_inst: *instruction.Instruction = ?fn.instrs[phi_id];
    if (phi_inst.operand_count != 2) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:salvages_metadata_free_dbg_value" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_entry)) { ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_entry));

    val p0: value.Value = value.param(0, i64t);
    val p1: value.Value = value.param(1, i64t);

    val res_x: R.Result[value.Value, str] = builder.emit_add(?bld, p0, p1);
    if (R.is_err[value.Value, str](res_x)) { ret 1; }
    val x: value.Value = R.unwrap_ok[value.Value, str](res_x);

    if (R.is_err[R.Void, str](builder.emit_dbg_value(?bld, x, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, p0))) { ret 1; }

    map.clear[id.InstructionId, ir.DbgVar](?fn.dbg_vars);

    if (R.is_err[bool, str](run(?m))) { ret 1; }

    var found: bool = false;
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val ins: *instruction.Instruction = ?fn.instrs[i];
        if (ins.kind == instruction.OP_DBG_VALUE) {
            found = true;
            if (ins.operands[0].kind != value.VAL_CONST_NULL) { ret 1; }
        }
        i = i + 1;
    }
    if (found == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.dce.run:reports_no_change_when_every_instruction_is_live" {
