use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.float;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module) res[bool, fail.Fail] {
    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, ?workspace);
}

pub fun run_in(m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var i: u32 = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var work: scratch.Function = scratch.Function{module: m, body: fn};
            val changed_r: res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, fold_function);
            if (sel changed_r.err) { ret changed_r; }
            if (changed_r.ok) { changed = true; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun fold_function(request: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = request.module;
    val fn: *ir.Function = request.body;
    val ilen: u32 = fn.instr_len;
    if (ilen == 0) { ret res[bool, fail.Fail].ok{false}; }

    var rw: mutate.Rewrite;
    val res_init: err[fail.Fail] = mutate.rewrite_init(?rw, alloc, ilen);
    if (sel res_init.err) { ret res[bool, fail.Fail].err{res_init.err}; }

    val folded_r: res[bool, fail.Fail] = fold_to_fixpoint(m, fn, ?rw);
    if (sel folded_r.err) { mutate.rewrite_dnit(?rw, alloc); ret folded_r; }
    mutate.rewrite_apply(fn, ?rw);
    val branches_changed_r: res[bool, fail.Fail] = simplify_branches(m, fn, ?rw);

    mutate.rewrite_dnit(?rw, alloc);
    if (sel branches_changed_r.err) { ret branches_changed_r; }
    ret res[bool, fail.Fail].ok{folded_r.ok || branches_changed_r.ok};
}

fun fold_to_fixpoint(m: *ir.Module, fn: *ir.Function, rw: *mutate.Rewrite) res[bool, fail.Fail] {
    var changed: bool = true;
    var any: bool = false;
    for (changed) {
        changed = false;
        var i: u32 = 0;
        for (i < rw.len) {
            if (mutate.rewrite_has(rw, i) == false) {
                val inst: *instruction.Instruction = ?fn.instrs[i];
                var out: value.Value;
                val folded: res[bool, fail.Fail] = try_fold(m, inst, i, rw, ?out);
                if (sel folded.err) { ret folded; }
                if (folded.ok) {
                    mutate.replace_value(rw, i, out);
                    changed = true;
                    any     = true;
                }
            }
            i = i + 1;
        }
    }
    ret res[bool, fail.Fail].ok{any};
}

fun try_fold(m: *ir.Module, inst: *instruction.Instruction, self_id: u32,
             rw: *mutate.Rewrite, out: *value.Value) res[bool, fail.Fail] {
    val k: instruction.InstrKind = inst.kind;

    if (k == instruction.OP_PHI) {
        ret res[bool, fail.Fail].ok{fold_phi(inst, self_id, rw, out)};
    }

    if ((is_int_binary(k) || is_float_binary(k)) && inst.operand_count == 2) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        val b: value.Value = mutate.rewrite_resolve(rw, inst.operands[1]);
        if (a.kind == value.VAL_CONST_INT && b.kind == value.VAL_CONST_INT && is_int_binary(k)) {
            ret fold_int_binary(m, k, a, b, inst.ty, out);
        }
        if (a.kind == value.VAL_CONST_FLOAT && b.kind == value.VAL_CONST_FLOAT && is_float_binary(k)) {
            ret fold_float_binary(m, k, a, b, inst.ty, out);
        }
        ret res[bool, fail.Fail].ok{false};
    }

    if ((k == instruction.OP_NEG || k == instruction.OP_NOT) && inst.operand_count == 1) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        if (a.kind == value.VAL_CONST_INT) {
            val bits: u32 = int_bits(m, inst.ty);
            if (bits == 0) { ret res[bool, fail.Fail].ok{false}; }
            var r: u64 = 0;
            if (k == instruction.OP_NEG) { r = mask(0 - a.data.int_lit, bits); }
            or                           { r = mask(~a.data.int_lit, bits); }
            @out = value.const_int(r, inst.ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a.kind == value.VAL_CONST_FLOAT && k == instruction.OP_NEG && is_f64(m, inst.ty)) {
            @out = value.const_float(float.f64_neg(a.data.float_lit), inst.ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }

    if (k == instruction.OP_FP_TRUNC && inst.operand_count == 1) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        if (a.kind != value.VAL_CONST_FLOAT) { ret res[bool, fail.Fail].ok{false}; }
        val w: float.FloatWidth = float_width(m, inst.ty);
        if (w == float.FLOAT_W_NONE) { ret res[bool, fail.Fail].ok{false}; }
        @out = value.const_float(float.round_at(a.data.float_lit, w), inst.ty);
        ret res[bool, fail.Fail].ok{true};
    }

    if ((k == instruction.OP_TRUNC || k == instruction.OP_SEXT || k == instruction.OP_ZEXT) && inst.operand_count == 1) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        if (a.kind != value.VAL_CONST_INT) { ret res[bool, fail.Fail].ok{false}; }
        val src_bits: u32 = int_bits(m, a.ty);
        val dst_bits: u32 = int_bits(m, inst.ty);
        if (src_bits == 0 || dst_bits == 0) { ret res[bool, fail.Fail].ok{false}; }
        var r: u64 = 0;
        if (k == instruction.OP_TRUNC) { r = mask(a.data.int_lit, dst_bits); }
        or (k == instruction.OP_ZEXT)  { r = mask(mask(a.data.int_lit, src_bits), dst_bits); }
        or                             { r = mask(sext(a.data.int_lit, src_bits), dst_bits); }
        @out = value.const_int(r, inst.ty);
        ret res[bool, fail.Fail].ok{true};
    }

    ret res[bool, fail.Fail].ok{false};
}

fun fold_phi(inst: *instruction.Instruction, self_id: u32,
             rw: *mutate.Rewrite, out: *value.Value) bool {
    var have:   bool = false;
    var common: value.Value;
    var i: u32 = 1;
    for (i < inst.operand_count) {
        val v: value.Value = mutate.rewrite_resolve(rw, inst.operands[i]);
        val is_self: bool  = v.kind == value.VAL_INSTR && v.data.instr::u32 == self_id;
        if (is_self == false) {
            if (have == false) {
                common = v;
                have   = true;
            }
            or {
                if (values_equal(common, v) == false) { ret false; }
            }
        }
        i = i + 2;
    }
    if (have == false) { ret false; }
    @out = common;
    ret true;
}

fun values_equal(a: value.Value, b: value.Value) bool {
    if (a.kind != b.kind)                { ret false; }
    if (a.kind == value.VAL_INSTR)       { ret a.data.instr == b.data.instr; }
    if (a.kind == value.VAL_PARAM)       { ret a.data.param_ix == b.data.param_ix; }
    if (a.kind == value.VAL_CONST_INT)   { ret a.data.int_lit == b.data.int_lit; }
    if (a.kind == value.VAL_CONST_NULL)  { ret true; }
    if (a.kind == value.VAL_CONST_FLOAT) { ret float.f64_bits(a.data.float_lit) == float.f64_bits(b.data.float_lit); }
    if (a.kind == value.VAL_GLOBAL)      { ret a.data.global_ix == b.data.global_ix; }
    if (a.kind == value.VAL_FN)          { ret a.data.fn_ix == b.data.fn_ix; }
    ret false;
}

fun is_int_binary(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_FOLD_INT | opdesc.EFF_COMPARE);
}


fun is_float_binary(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_FOLD_FLOAT | opdesc.EFF_COMPARE);
}


fun fold_int_binary(m: *ir.Module, k: instruction.InstrKind, a: value.Value, b: value.Value,
                    res_ty: type.IrTypeId, out: *value.Value) res[bool, fail.Fail] {
    if (is_compare(k)) {
        val w: u32 = int_bits(m, a.ty);
        if (w == 0) { ret res[bool, fail.Fail].ok{false}; }
        val cmp: opt[bool] = eval_int_compare(k, a.data.int_lit, b.data.int_lit, w);
        if (sel cmp.none) { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the integer compare fold")}; }
        var rv: u64 = 0;
        if (cmp.some) { rv = 1; }
        @out = value.const_int(rv, res_ty);
        ret res[bool, fail.Fail].ok{true};
    }

    val bits: u32 = int_bits(m, res_ty);
    if (bits == 0) { ret res[bool, fail.Fail].ok{false}; }

    val x: u64 = mask(a.data.int_lit, bits);
    val y: u64 = mask(b.data.int_lit, bits);
    var r: u64 = 0;

    if (k == instruction.OP_ADD) { r = mask(x + y, bits); }
    or (k == instruction.OP_SUB) { r = mask(x - y, bits); }
    or (k == instruction.OP_MUL) { r = mask(x * y, bits); }
    or (k == instruction.OP_AND) { r = x & y; }
    or (k == instruction.OP_OR)  { r = x | y; }
    or (k == instruction.OP_XOR) { r = x ^ y; }
    or (k == instruction.OP_DIV_U) {
        if (y == 0) { ret res[bool, fail.Fail].ok{false}; }
        r = x / y;
    }
    or (k == instruction.OP_REM_U) {
        if (y == 0) { ret res[bool, fail.Fail].ok{false}; }
        r = x % y;
    }
    or (k == instruction.OP_DIV_S) {
        if (y == 0) { ret res[bool, fail.Fail].ok{false}; }
        val sa: i64 = sext(x, bits)::i64;
        val sb: i64 = sext(y, bits)::i64;
        if (div_overflows(sa, sb, bits)) { ret res[bool, fail.Fail].ok{false}; }
        r = mask((sa / sb)::u64, bits);
    }
    or (k == instruction.OP_REM_S) {
        if (y == 0) { ret res[bool, fail.Fail].ok{false}; }
        val sa: i64 = sext(x, bits)::i64;
        val sb: i64 = sext(y, bits)::i64;
        if (div_overflows(sa, sb, bits)) { ret res[bool, fail.Fail].ok{false}; }
        r = mask((sa % sb)::u64, bits);
    }
    or (k == instruction.OP_SHL || k == instruction.OP_SHR_S || k == instruction.OP_SHR_U) {
        val count: u64 = b.data.int_lit;
        if (count >= bits::u64) { ret res[bool, fail.Fail].ok{false}; }
        r = fold_shift(k, x, count, bits);
    }
    or { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the integer arithmetic fold")}; }

    @out = value.const_int(r, res_ty);
    ret res[bool, fail.Fail].ok{true};
}

fun fold_shift(k: instruction.InstrKind, v: u64, count: u64, bits: u32) u64 {
    if (k == instruction.OP_SHL) {
        val shifted: u64 = v << count;
        ret mask(shifted, bits);
    }
    if (k == instruction.OP_SHR_U) {
        val low: u64 = mask(v, bits);
        ret low >> count;
    }
    val se: i64 = sext(v, bits)::i64;
    val sr: u64 = (se >> count)::u64;
    ret mask(sr, bits);
}

fun div_overflows(sa: i64, sb: i64, bits: u32) bool {
    if (sb != 0 - 1) { ret false; }
    var opbits: u32 = bits;
    if (opbits < 32) { opbits = 32; }
    val opmin: i64 = sext(1::u64 << (opbits - 1)::u64, opbits)::i64;
    ret sa == opmin;
}

# the verdict of a compare opcode on two constants; absent for an opcode
# outside the compare set, which the caller reports as an unknown member
fun eval_int_compare(k: instruction.InstrKind, a: u64, b: u64, bits: u32) opt[bool] {
    val x: u64 = mask(a, bits);
    val y: u64 = mask(b, bits);
    if (k == instruction.OP_CMP_EQ)   { ret opt[bool].some{x == y}; }
    if (k == instruction.OP_CMP_NE)   { ret opt[bool].some{x != y}; }
    if (k == instruction.OP_CMP_LT_U) { ret opt[bool].some{x < y}; }
    if (k == instruction.OP_CMP_LE_U) { ret opt[bool].some{x <= y}; }
    val sx: i64 = sext(x, bits)::i64;
    val sy: i64 = sext(y, bits)::i64;
    if (k == instruction.OP_CMP_LT_S) { ret opt[bool].some{sx < sy}; }
    if (k == instruction.OP_CMP_LE_S) { ret opt[bool].some{sx <= sy}; }
    ret opt[bool].none{};
}

fun fold_float_binary(m: *ir.Module, k: instruction.InstrKind, a: value.Value, b: value.Value,
                      res_ty: type.IrTypeId, out: *value.Value) res[bool, fail.Fail] {
    if (is_compare(k)) {
        if (is_f64(m, a.ty) == false) { ret res[bool, fail.Fail].ok{false}; }
        val cmp: opt[bool] = eval_float_compare(k, a.data.float_lit, b.data.float_lit);
        if (sel cmp.none) { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the float compare fold")}; }
        var rv: u64 = 0;
        if (cmp.some) { rv = 1; }
        @out = value.const_int(rv, res_ty);
        ret res[bool, fail.Fail].ok{true};
    }

    if (is_f64(m, res_ty) == false) { ret res[bool, fail.Fail].ok{false}; }
    val x: f64 = a.data.float_lit;
    val y: f64 = b.data.float_lit;
    var r: f64 = 0.0;
    if (k == instruction.OP_ADD) { r = x + y; }
    or (k == instruction.OP_SUB) { r = x - y; }
    or (k == instruction.OP_MUL) { r = x * y; }
    or { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the float arithmetic fold")}; }
    @out = value.const_float(r, res_ty);
    ret res[bool, fail.Fail].ok{true};
}

fun eval_float_compare(k: instruction.InstrKind, a: f64, b: f64) opt[bool] {
    if (k == instruction.OP_CMP_EQ)                                   { ret opt[bool].some{a == b}; }
    if (k == instruction.OP_CMP_NE)                                   { ret opt[bool].some{a != b}; }
    if (k == instruction.OP_CMP_LT_S || k == instruction.OP_CMP_LT_U) { ret opt[bool].some{a < b}; }
    if (k == instruction.OP_CMP_LE_S || k == instruction.OP_CMP_LE_U) { ret opt[bool].some{a <= b}; }
    ret opt[bool].none{};
}

fun is_compare(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}


fun mask(v: u64, bits: u32) u64 {
    if (bits >= 64) { ret v; }
    val lo_mask: u64 = (1::u64 << bits::u64) - 1;
    ret v & lo_mask;
}

fun sext(v: u64, bits: u32) u64 {
    if (bits >= 64) { ret v; }
    val lo:   u64 = mask(v, bits);
    val sign: u64 = 1::u64 << (bits - 1)::u64;
    if ((lo & sign) != 0) {
        ret lo | (~((1::u64 << bits::u64) - 1));
    }
    ret lo;
}

fun int_bits(m: *ir.Module, tid: type.IrTypeId) u32 {
    val opt_ty: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_ty.none) { ret 0; }
    val t: *type.IrType = opt_ty.some;
    if (t.kind != type.IRT_INT) { ret 0; }
    ret t.data.bits;
}

fun float_width(m: *ir.Module, tid: type.IrTypeId) float.FloatWidth {
    val opt_ty: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_ty.none) { ret float.FLOAT_W_NONE; }
    val t: *type.IrType = opt_ty.some;
    if (t.kind != type.IRT_FLOAT) { ret float.FLOAT_W_NONE; }
    if (t.data.bits == 32) { ret float.FLOAT_W_32; }
    if (t.data.bits == 64) { ret float.FLOAT_W_64; }
    ret float.FLOAT_W_NONE;
}

fun is_f64(m: *ir.Module, tid: type.IrTypeId) bool {
    val opt_ty: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_ty.none) { ret false; }
    val t: *type.IrType = opt_ty.some;
    if (t.kind != type.IRT_FLOAT) { ret false; }
    ret t.data.bits == 64;
}

fun simplify_branches(m: *ir.Module, fn: *ir.Function, rw: *mutate.Rewrite) res[bool, fail.Fail] {
    var rewrote: bool = false;
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        if (blk.terminator != id.INSTR_NIL) {
            val opt_term: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.terminator);
            if (sel opt_term.some) {
                val term: *instruction.Instruction = opt_term.some;
                if (term.kind == instruction.OP_CBR && term.operand_count == 3) {
                    val cond: value.Value = mutate.rewrite_resolve(rw, term.operands[0]);
                    if (cond.kind == value.VAL_CONST_INT) {
                        var taken: value.Value = term.operands[2];
                        if (cond.data.int_lit != 0) { taken = term.operands[1]; }
                        term.kind          = instruction.OP_BR;
                        term.operands[0]   = taken;
                        term.operand_count = 1;
                        rewrote = true;
                    }
                }
            }
        }
        i = i + 1;
    }

    if (rewrote == false) { ret res[bool, fail.Fail].ok{false}; }

    val res_preds: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel res_preds.err) { ret res[bool, fail.Fail].err{res_preds.err}; }
    prune_dead_phi_incomings(fn);
    ret res[bool, fail.Fail].ok{true};
}

fun prune_dead_phi_incomings(fn: *ir.Function) {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.phi_count) {
            val opt_phi: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.phis[ii]);
            if (sel opt_phi.some) {
                val phi: *instruction.Instruction = opt_phi.some;
                if (phi.kind == instruction.OP_PHI) {
                    var w: u32 = 0;
                    var r: u32 = 0;
                    for (r + 1 < phi.operand_count) {
                        val src: id.BlockId = ir.block_target(phi.operands[r]);
                        if (block_is_pred(blk, src)) {
                            phi.operands[w]     = phi.operands[r];
                            phi.operands[w + 1] = phi.operands[r + 1];
                            w = w + 2;
                        }
                        r = r + 2;
                    }
                    phi.operand_count = w;
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun block_is_pred(blk: *ir.Block, pred: id.BlockId) bool {
    var i: u32 = 0;
    for (i < blk.pred_count) {
        if (blk.preds[i] == pred) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun build_const_phi(phi: *instruction.Instruction, ops: *value.Value, vals: *value.Value,
                    n: u32, ty: type.IrTypeId) {
    var i: u32 = 0;
    for (i < n) {
        ops[i * 2]     = value.const_int(0, ty);
        ops[i * 2 + 1] = vals[i];
        i = i + 1;
    }
    phi.kind          = instruction.OP_PHI;
    phi.ty            = ty;
    phi.operands      = ops;
    phi.operand_count = n * 2;
    phi.operand_cap   = n * 2;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;
}

# a fold outcome in a test: an internal failure is a defect the test reports as
# not folded, which every caller asserts against
fun t_folded(r: res[bool, fail.Fail]) bool {
    if (sel r.err) { ret false; }
    ret r.ok;
}

# declined to fold, as opposed to failed
fun t_unfolded(r: res[bool, fail.Fail]) bool {
    if (sel r.err) { ret false; }
    ret !r.ok;
}

test "mach.lang.me.pass.constfold.fold_int_binary:int_min_div_neg1_i64" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    val a: value.Value = value.const_int(0x8000000000000000, ty);
    val b: value.Value = value.const_int(0xFFFFFFFFFFFFFFFF, ty);
    var out: value.Value;
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_S, a, b, ty, ?out))) { ret 1; }
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_REM_S, a, b, ty, ?out))) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_int_binary:int_min_div_neg1_i32" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    val a: value.Value = value.const_int(0x80000000, ty);
    val b: value.Value = value.const_int(0xFFFFFFFF, ty);
    var out: value.Value;
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_S, a, b, ty, ?out))) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_int_binary:div_by_zero_and_signed" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    var out: value.Value;
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_S, value.const_int(7, ty), value.const_int(0, ty), ty, ?out)))           { ret 1; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_DIV_S, value.const_int(20, ty), value.const_int(4, ty), ty, ?out))) { ret 1; }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 5)                                                      { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_int_binary:shift_in_range_only" {
    var alloc: A.Allocator;
