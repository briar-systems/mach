use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.float;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.wide;

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module) res[bool, fail.Fail] {
    var workspace:   scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, ?workspace);
}

pub fun run_in(m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var i:       u32  = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var work:      scratch.Function     = scratch.Function{module: m, body: fn};
            val changed_r: res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, fold_function);
            if (sel changed_r.err) { ret changed_r; }
            if (changed_r.ok)      { changed = true; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun fold_function(request: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:    *ir.Module   = request.module;
    val fn:   *ir.Function = request.body;
    val ilen: u32          = fn.instr_len;
    if (ilen == 0) { ret res[bool, fail.Fail].ok{false}; }

    var rw:       mutate.Rewrite;
    val res_init: err[fail.Fail] = mutate.rewrite_init(?rw, alloc, ilen);
    if (sel res_init.err) { ret res[bool, fail.Fail].err{res_init.err}; }

    val folded_r: res[bool, fail.Fail] = fold_to_fixpoint(m, fn, ?rw);
    if (sel folded_r.err) {
        mutate.rewrite_dnit(?rw, alloc);
        ret folded_r;
    }
    mutate.rewrite_apply(fn, ?rw);
    val branches_changed_r: res[bool, fail.Fail] = simplify_branches(m, fn, ?rw);

    mutate.rewrite_dnit(?rw, alloc);
    if (sel branches_changed_r.err) { ret branches_changed_r; }
    ret res[bool, fail.Fail].ok{folded_r.ok || branches_changed_r.ok};
}

fun fold_to_fixpoint(m: *ir.Module, fn: *ir.Function, rw: *mutate.Rewrite) res[bool, fail.Fail] {
    var changed: bool = true;
    var any:     bool = false;
    for (changed) {
        changed = false;
        var i: u32 = 0;
        for (i < rw.len) {
            if (mutate.rewrite_has(rw, i) == false) {
                val inst:   *instruction.Instruction = ?fn.instrs[i];
                var out:    value.Value;
                val folded: res[bool, fail.Fail]     = try_fold(m, inst, i, rw, ?out);
                if (sel folded.err) { ret folded; }
                if (folded.ok) {
                    mutate.replace_value(rw, i, out);
                    changed = true;
                    any     = true;
                }
            }
            i = i + 1;
        }
    }
    ret res[bool, fail.Fail].ok{any};
}

fun try_fold(m: *ir.Module, inst: *instruction.Instruction, self_id: u32,
    rw: *mutate.Rewrite, out: *value.Value) res[bool, fail.Fail] {
    val k: instruction.InstrKind = inst.kind;

    if (k == instruction.OP_PHI) {
        ret res[bool, fail.Fail].ok{fold_phi(inst, self_id, rw, out)};
    }

    if (is_widening_mul(k) && inst.operand_count == 2) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        val b: value.Value = mutate.rewrite_resolve(rw, inst.operands[1]);
        if (a.kind == value.VAL_CONST_INT && b.kind == value.VAL_CONST_INT) {
            ret res[bool, fail.Fail].ok{fold_mul_wide(m, k, a, b, inst.ty, out)};
        }
        ret res[bool, fail.Fail].ok{false};
    }

    if ((is_int_binary(k) || is_float_binary(k)) && inst.operand_count == 2) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        val b: value.Value = mutate.rewrite_resolve(rw, inst.operands[1]);
        if (a.kind == value.VAL_CONST_INT && b.kind == value.VAL_CONST_INT && is_int_binary(k)) {
            ret fold_int_binary(m, k, a, b, inst.ty, out);
        }
        if (a.kind == value.VAL_CONST_FLOAT && b.kind == value.VAL_CONST_FLOAT && is_float_binary(k)) {
            ret fold_float_binary(m, k, a, b, inst.ty, out);
        }
        ret res[bool, fail.Fail].ok{false};
    }

    if ((k == instruction.OP_NEG || k == instruction.OP_NOT) && inst.operand_count == 1) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        if (a.kind == value.VAL_CONST_INT) {
            val bits: u32 = int_bits(m, inst.ty);
            if (bits == 0) { ret res[bool, fail.Fail].ok{false}; }
            var r: wide.Wide = value.int_of(?a);
            if (k == instruction.OP_NEG) { r = wide.neg(r); }
            or                           { r = wide.not(r); }
            @out = value.const_int_wide(wide.trunc(r, bits), inst.ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a.kind == value.VAL_CONST_FLOAT && k == instruction.OP_NEG && is_f64(m, inst.ty)) {
            @out = value.const_float(float.f64_neg(a.data.float_lit), inst.ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }

    if (k == instruction.OP_FP_TRUNC && inst.operand_count == 1) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        if (a.kind != value.VAL_CONST_FLOAT) { ret res[bool, fail.Fail].ok{false}; }
        val w: float.FloatWidth = float_width(m, inst.ty);
        if (w == float.FLOAT_W_NONE) { ret res[bool, fail.Fail].ok{false}; }
        @out = value.const_float(float.round_at(a.data.float_lit, w), inst.ty);
        ret res[bool, fail.Fail].ok{true};
    }

    if ((k == instruction.OP_TRUNC || k == instruction.OP_SEXT || k == instruction.OP_ZEXT) && inst.operand_count == 1) {
        val a: value.Value = mutate.rewrite_resolve(rw, inst.operands[0]);
        if (a.kind != value.VAL_CONST_INT) { ret res[bool, fail.Fail].ok{false}; }
        val src_bits: u32 = int_bits(m, a.ty);
        val dst_bits: u32 = int_bits(m, inst.ty);
        if (src_bits == 0 || dst_bits == 0) { ret res[bool, fail.Fail].ok{false}; }
        var r: wide.Wide = value.int_of(?a);
        if (k == instruction.OP_ZEXT) { r = wide.trunc(r, src_bits); }
        or (k == instruction.OP_SEXT) { r = wide.sext(r, src_bits); }
        @out = value.const_int_wide(wide.trunc(r, dst_bits), inst.ty);
        ret res[bool, fail.Fail].ok{true};
    }

    ret res[bool, fail.Fail].ok{false};
}

fun fold_phi(inst: *instruction.Instruction, self_id: u32,
    rw: *mutate.Rewrite, out: *value.Value) bool {
    var have:   bool = false;
    var common: value.Value;
    var i:      u32  = 1;
    for (i < inst.operand_count) {
        val v:       value.Value = mutate.rewrite_resolve(rw, inst.operands[i]);
        val is_self: bool        = v.kind == value.VAL_INSTR && v.data.instr::u32 == self_id;
        if (is_self == false) {
            if (have == false) {
                common = v;
                have   = true;
            }
            or {
                if (values_equal(common, v) == false) { ret false; }
            }
        }
        i = i + 2;
    }
    if (have == false) { ret false; }
    @out = common;
    ret true;
}

fun values_equal(a: value.Value, b: value.Value) bool {
    if (a.kind != b.kind)                { ret false; }
    if (a.kind == value.VAL_INSTR)       { ret a.data.instr == b.data.instr; }
    if (a.kind == value.VAL_PARAM)       { ret a.data.param_ix == b.data.param_ix; }
    if (a.kind == value.VAL_CONST_INT)   { ret wide.eq(value.int_of(?a), value.int_of(?b)); }
    if (a.kind == value.VAL_CONST_NULL)  { ret true; }
    if (a.kind == value.VAL_CONST_FLOAT) { ret float.f64_bits(a.data.float_lit) == float.f64_bits(b.data.float_lit); }
    if (a.kind == value.VAL_GLOBAL)      { ret a.data.global_ix == b.data.global_ix; }
    if (a.kind == value.VAL_FN)          { ret a.data.fn_ix == b.data.fn_ix; }
    ret false;
}

fun is_int_binary(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_FOLD_INT | opdesc.EFF_COMPARE);
}

fun is_float_binary(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_FOLD_FLOAT | opdesc.EFF_COMPARE);
}

fun is_widening_mul(k: instruction.InstrKind) bool {
    ret k == instruction.OP_MUL_WIDE_S || k == instruction.OP_MUL_WIDE_U ||
        k == instruction.OP_MUL_HIGH_S || k == instruction.OP_MUL_HIGH_U;
}

# the exact product of two operand-width constants: the full 2w bits for a
# widening multiply, the upper w for a high multiply. two w-bit factors fit
# the 128-bit carrier only up to w == 64; a wider operand is left to the
# machine (#3511)
fun fold_mul_wide(m: *ir.Module, k: instruction.InstrKind, a: value.Value, b: value.Value,
    res_ty: type.IrTypeId, out: *value.Value) bool {
    val w:        u32 = int_bits(m, a.ty);
    val res_bits: u32 = int_bits(m, res_ty);
    if (w == 0 || w > 64 || res_bits == 0) { ret false; }
    val signed: bool      = k == instruction.OP_MUL_WIDE_S || k == instruction.OP_MUL_HIGH_S;
    var x:      wide.Wide = wide.trunc(value.int_of(?a), w);
    var y:      wide.Wide = wide.trunc(value.int_of(?b), w);
    if (signed) {
        x = wide.sext(x, w);
        y = wide.sext(y, w);
    }
    val p: wide.Wide = wide.mul(x, y);
    if (k == instruction.OP_MUL_WIDE_S || k == instruction.OP_MUL_WIDE_U) {
        @out = value.const_int_wide(wide.trunc(p, res_bits), res_ty);
        ret true;
    }
    var high: wide.Wide = wide.shr_u(p, w);
    if (signed) { high = wide.shr_s(p, w); }
    @out = value.const_int_wide(wide.trunc(high, res_bits), res_ty);
    ret true;
}

fun fold_int_binary(m: *ir.Module, k: instruction.InstrKind, a: value.Value, b: value.Value,
    res_ty: type.IrTypeId, out: *value.Value) res[bool, fail.Fail] {
    if (is_compare(k)) {
        val w: u32 = int_bits(m, a.ty);
        if (w == 0) { ret res[bool, fail.Fail].ok{false}; }
        val cmp: opt[bool] = eval_int_compare(k, value.int_of(?a), value.int_of(?b), w);
        if (sel cmp.none) { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the integer compare fold")}; }
        var rv: u64 = 0;
        if (cmp.some) { rv = 1; }
        @out = value.const_int(rv, res_ty);
        ret res[bool, fail.Fail].ok{true};
    }

    val bits: u32 = int_bits(m, res_ty);
    if (bits == 0) { ret res[bool, fail.Fail].ok{false}; }

    val bw:     wide.Wide = value.int_of(?b);
    val folded: IntFold   = eval_int_arith(k, wide.trunc(value.int_of(?a), bits), wide.trunc(bw, bits), bw, bits);
    if (sel folded.unknown) { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the integer arithmetic fold")}; }
    if (sel folded.value) {
        @out = value.const_int_wide(folded.value, res_ty);
        ret res[bool, fail.Fail].ok{true};
    }
    ret res[bool, fail.Fail].ok{false};
}

# the outcome of folding one integer arithmetic opcode over two constants:
# the value, declined when the fold would trap or overflow, or unknown for an
# opcode outside the integer arithmetic set, which the caller reports
tag IntFold: u8 {
    value: wide.Wide;
    declined;
    unknown;
}

# x and y arrive truncated to `bits`; raw_y is the untruncated right operand,
# which a shift reads as its count
fun eval_int_arith(k: instruction.InstrKind, x: wide.Wide, y: wide.Wide, raw_y: wide.Wide, bits: u32) IntFold {
    if (k == instruction.OP_ADD) { ret IntFold.value{wide.trunc(wide.add(x, y), bits)}; }
    if (k == instruction.OP_SUB) { ret IntFold.value{wide.trunc(wide.sub(x, y), bits)}; }
    if (k == instruction.OP_MUL) { ret IntFold.value{wide.trunc(wide.mul(x, y), bits)}; }
    if (k == instruction.OP_AND) { ret IntFold.value{wide.and(x, y)}; }
    if (k == instruction.OP_OR)  { ret IntFold.value{wide.or (x, y)}; }
    if (k == instruction.OP_XOR) { ret IntFold.value{wide.xor(x, y)}; }
    if (k == instruction.OP_DIV_U || k == instruction.OP_REM_U) {
        var q: wide.Wide;
        var r: wide.Wide;
        if (!wide.divmod_u(x, y, ?q, ?r)) { ret IntFold.declined{}; }
        if (k == instruction.OP_DIV_U)    { ret IntFold.value{q}; }
        ret IntFold.value{r};
    }
    if (k == instruction.OP_DIV_S || k == instruction.OP_REM_S) {
        val sa: wide.Wide = wide.sext(x, bits);
        val sb: wide.Wide = wide.sext(y, bits);
        if (div_overflows(sa, sb, bits)) { ret IntFold.declined{}; }
        var q: wide.Wide;
        var r: wide.Wide;
        if (!wide.divmod_s(sa, sb, ?q, ?r)) { ret IntFold.declined{}; }
        if (k == instruction.OP_DIV_S)      { ret IntFold.value{wide.trunc(q, bits)}; }
        ret IntFold.value{wide.trunc(r, bits)};
    }
    if (k == instruction.OP_SHL || k == instruction.OP_SHR_S || k == instruction.OP_SHR_U) {
        if (raw_y.hi != 0 || raw_y.lo >= bits::u64) { ret IntFold.declined{}; }
        ret IntFold.value{fold_shift(k, x, raw_y.lo::u32, bits)};
    }
    ret IntFold.unknown{};
}

fun fold_shift(k: instruction.InstrKind, v: wide.Wide, count: u32, bits: u32) wide.Wide {
    if (k == instruction.OP_SHL)   { ret wide.trunc(wide.shl(v, count), bits); }
    if (k == instruction.OP_SHR_U) { ret wide.shr_u(wide.trunc(v, bits), count); }
    ret wide.trunc(wide.shr_s(wide.sext(v, bits), count), bits);
}

# MIN / -1 traps on the machine, which computes a divide narrower than 32
# bits at 32, where no narrow MIN is the operand's
fun div_overflows(sa: wide.Wide, sb: wide.Wide, bits: u32) bool {
    if (!wide.eq(sb, wide.from_i64(-1))) { ret false; }
    var opbits: u32 = bits;
    if (opbits < 32) { opbits = 32; }
    val opmin: wide.Wide = wide.sext(wide.shl(wide.from_u64(1), opbits - 1), opbits);
    ret wide.eq(sa, opmin);
}

# the verdict of a compare opcode on two constants; absent for an opcode
# outside the compare set, which the caller reports as an unknown member
fun eval_int_compare(k: instruction.InstrKind, a: wide.Wide, b: wide.Wide, bits: u32) opt[bool] {
    val x: wide.Wide = wide.trunc(a, bits);
    val y: wide.Wide = wide.trunc(b, bits);
    if (k == instruction.OP_CMP_EQ)   { ret opt[bool].some{wide.eq(x, y)}; }
    if (k == instruction.OP_CMP_NE)   { ret opt[bool].some{!wide.eq(x, y)}; }
    if (k == instruction.OP_CMP_LT_U) { ret opt[bool].some{wide.lt_u(x, y)}; }
    if (k == instruction.OP_CMP_LE_U) { ret opt[bool].some{!wide.lt_u(y, x)}; }
    val sx: wide.Wide = wide.sext(x, bits);
    val sy: wide.Wide = wide.sext(y, bits);
    if (k == instruction.OP_CMP_LT_S) { ret opt[bool].some{wide.lt_s(sx, sy)}; }
    if (k == instruction.OP_CMP_LE_S) { ret opt[bool].some{!wide.lt_s(sy, sx)}; }
    ret opt[bool].none{};
}

fun fold_float_binary(m: *ir.Module, k: instruction.InstrKind, a: value.Value, b: value.Value,
    res_ty: type.IrTypeId, out: *value.Value) res[bool, fail.Fail] {
    if (is_compare(k)) {
        if (is_f64(m, a.ty) == false) { ret res[bool, fail.Fail].ok{false}; }
        val cmp: opt[bool] = eval_float_compare(k, a.data.float_lit, b.data.float_lit);
        if (sel cmp.none) { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the float compare fold")}; }
        var rv: u64 = 0;
        if (cmp.some) { rv = 1; }
        @out = value.const_int(rv, res_ty);
        ret res[bool, fail.Fail].ok{true};
    }

    if (is_f64(m, res_ty) == false) { ret res[bool, fail.Fail].ok{false}; }
    val r: opt[f64] = eval_float_arith(k, a.data.float_lit, b.data.float_lit);
    if (sel r.none) { ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the float arithmetic fold")}; }
    @out = value.const_float(r.some, res_ty);
    ret res[bool, fail.Fail].ok{true};
}

# absent for an opcode outside the float arithmetic set, which the caller reports
fun eval_float_arith(k: instruction.InstrKind, x: f64, y: f64) opt[f64] {
    if (k == instruction.OP_ADD) { ret opt[f64].some{x + y}; }
    if (k == instruction.OP_SUB) { ret opt[f64].some{x - y}; }
    if (k == instruction.OP_MUL) { ret opt[f64].some{x * y}; }
    ret opt[f64].none{};
}

fun eval_float_compare(k: instruction.InstrKind, a: f64, b: f64) opt[bool] {
    if (k == instruction.OP_CMP_EQ)                                   { ret opt[bool].some{a == b}; }
    if (k == instruction.OP_CMP_NE)                                   { ret opt[bool].some{a != b}; }
    if (k == instruction.OP_CMP_LT_S || k == instruction.OP_CMP_LT_U) { ret opt[bool].some{a < b}; }
    if (k == instruction.OP_CMP_LE_S || k == instruction.OP_CMP_LE_U) { ret opt[bool].some{a <= b}; }
    ret opt[bool].none{};
}

fun is_compare(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}

# the width of an integer type the fold carries, 0 for any other type and for
# an integer wider than the 128-bit constant
fun int_bits(m: *ir.Module, tid: type.IrTypeId) u32 {
    val opt_ty: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_ty.none) { ret 0; }
    val t: *type.IrType = opt_ty.some;
    if (t.kind != type.IRT_INT) { ret 0; }
    if (t.data.bits > 128)      { ret 0; }
    ret t.data.bits;
}

fun float_width(m: *ir.Module, tid: type.IrTypeId) float.FloatWidth {
    val opt_ty: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_ty.none) { ret float.FLOAT_W_NONE; }
    val t: *type.IrType = opt_ty.some;
    if (t.kind != type.IRT_FLOAT) { ret float.FLOAT_W_NONE; }
    if (t.data.bits == 32)        { ret float.FLOAT_W_32; }
    if (t.data.bits == 64)        { ret float.FLOAT_W_64; }
    ret float.FLOAT_W_NONE;
}

fun is_f64(m: *ir.Module, tid: type.IrTypeId) bool {
    val opt_ty: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_ty.none) { ret false; }
    val t: *type.IrType = opt_ty.some;
    if (t.kind != type.IRT_FLOAT) { ret false; }
    ret t.data.bits == 64;
}

fun simplify_branches(m: *ir.Module, fn: *ir.Function, rw: *mutate.Rewrite) res[bool, fail.Fail] {
    var rewrote: bool = false;
    var i:       u32  = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        if (blk.terminator != id.INSTR_NIL) {
            val opt_term: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.terminator);
            if (sel opt_term.some) {
                val term: *instruction.Instruction = opt_term.some;
                if (term.kind == instruction.OP_CBR && term.operand_count == 3) {
                    val cond: value.Value = mutate.rewrite_resolve(rw, term.operands[0]);
                    if (cond.kind == value.VAL_CONST_INT) {
                        var taken: value.Value = term.operands[2];
                        if (!wide.is_zero(value.int_of(?cond))) { taken = term.operands[1]; }
                        term.kind          = instruction.OP_BR;
                        term.operands[0]   = taken;
                        term.operand_count = 1;
                        rewrote            = true;
                    }
                }
            }
        }
        i = i + 1;
    }

    if (rewrote == false) { ret res[bool, fail.Fail].ok{false}; }

    val res_preds: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel res_preds.err) { ret res[bool, fail.Fail].err{res_preds.err}; }
    prune_dead_phi_incomings(fn);
    ret res[bool, fail.Fail].ok{true};
}

fun prune_dead_phi_incomings(fn: *ir.Function) {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii:  u32       = 0;
        for (ii < blk.phi_count) {
            val opt_phi: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.phis[ii]);
            if (sel opt_phi.some) {
                val phi: *instruction.Instruction = opt_phi.some;
                if (phi.kind == instruction.OP_PHI) {
                    var w: u32 = 0;
                    var r: u32 = 0;
                    for (r + 1 < phi.operand_count) {
                        val src: id.BlockId = ir.block_target(phi.operands[r]);
                        if (block_is_pred(blk, src)) {
                            phi.operands[w]     = phi.operands[r];
                            phi.operands[w + 1] = phi.operands[r + 1];
                            w                   = w + 2;
                        }
                        r = r + 2;
                    }
                    phi.operand_count = w;
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun block_is_pred(blk: *ir.Block, pred: id.BlockId) bool {
    var i: u32 = 0;
    for (i < blk.pred_count) {
        if (blk.preds[i] == pred) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun build_const_phi(phi: *instruction.Instruction, ops: *value.Value, vals: *value.Value,
    n: u32, ty: type.IrTypeId) {
    var i: u32 = 0;
    for (i < n) {
        ops[i * 2]     = value.const_int(0, ty);
        ops[i * 2 + 1] = vals[i];
        i              = i + 1;
    }
    phi.kind          = instruction.OP_PHI;
    phi.ty            = ty;
    phi.operands      = ops;
    phi.operand_count = n * 2;
    phi.operand_cap   = n * 2;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;
}

# a fold outcome in a test: an internal failure is a defect the test reports as
# not folded, which every caller asserts against
fun t_folded(r: res[bool, fail.Fail]) bool {
    if (sel r.err) { ret false; }
    ret r.ok;
}

# declined to fold, as opposed to failed
fun t_unfolded(r: res[bool, fail.Fail]) bool {
    if (sel r.err) { ret false; }
    ret !r.ok;
}

fun t_is(out: value.Value, lo: u64, hi: u64) bool {
    ret out.kind == value.VAL_CONST_INT && wide.eq(value.int_of(?out), wide.make(lo, hi));
}

# a 128-bit fold carries both limbs through every arm: the carry out of the
# low limb, a product and a quotient wider than a limb, a shift across the
# limb boundary, and an ordered compare decided by the high limb (#3511)
test "mach.lang.me.pass.constfold.fold_int_binary:folds_at_128_bits" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    fin { ir.dnit(?m); }
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 128);
    if (sel res_ty.err) { ret 1; }
    val ty:     type.IrTypeId                 = res_ty.ok;
    val res_u8: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    if (sel res_u8.err) { ret 1; }
    val u8ty: type.IrTypeId = res_u8.ok;

    val ones: u64         = 0xFFFFFFFFFFFFFFFF;
    val big:  value.Value = value.const_int_wide(wide.make(ones, 0x0123456789ABCDEF), ty);
    val one:  value.Value = value.const_int(1, ty);
    val two:  value.Value = value.const_int(2, ty);
    val neg1: value.Value = value.const_int_wide(wide.make(ones, ones), ty);
    var out:  value.Value;

    if (!t_folded(fold_int_binary(?m, instruction.OP_ADD, big, one, ty, ?out)))                                         { ret 2; }
    if (!t_is(out, 0, 0x0123456789ABCDF0))                                                                              { ret 3; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_SUB, one, two, ty, ?out)))                                         { ret 4; }
    if (!t_is(out, ones, ones))                                                                                         { ret 5; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_MUL, big, two, ty, ?out)))                                         { ret 6; }
    if (!t_is(out, ones - 1, 0x02468ACF13579BDF))                                                                       { ret 7; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_DIV_U, big, two, ty, ?out)))                                       { ret 8; }
    if (!t_is(out, ones, 0x0123456789ABCDEF >> 1))                                                                      { ret 9; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_REM_U, big, two, ty, ?out)))                                       { ret 10; }
    if (!t_is(out, 1, 0))                                                                                               { ret 11; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_DIV_S, big, neg1, ty, ?out)))                                      { ret 12; }
    if (!t_is(out, 1, 0xFEDCBA9876543210))                                                                              { ret 13; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_REM_S, neg1, two, ty, ?out)))                                      { ret 14; }
    if (!t_is(out, ones, ones))                                                                                         { ret 15; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_SHL, one, value.const_int(100, ty), ty, ?out)))                    { ret 16; }
    if (!t_is(out, 0, 1::u64 << 36))                                                                                    { ret 17; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_SHR_U, big, value.const_int(64, ty), ty, ?out)))                   { ret 18; }
    if (!t_is(out, 0x0123456789ABCDEF, 0))                                                                              { ret 19; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_SHR_S, neg1, value.const_int(127, ty), ty, ?out)))                 { ret 20; }
    if (!t_is(out, ones, ones))                                                                                         { ret 21; }
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_SHL, one, value.const_int(128, ty), ty, ?out)))                  { ret 22; }
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_SHL, one, value.const_int_wide(wide.make(1, 1), ty), ty, ?out))) { ret 23; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_AND, big, neg1, ty, ?out)))                                        { ret 24; }
    if (!t_is(out, ones, 0x0123456789ABCDEF))                                                                           { ret 25; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_XOR, big, neg1, ty, ?out)))                                        { ret 26; }
    if (!t_is(out, 0, ~(0x0123456789ABCDEF::u64)))                                                                      { ret 27; }

    # lo equal, hi decides: unsigned big > one, signed neg1 < one, big > neg1 signed is false
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LT_U, one, big, u8ty, ?out)))  { ret 28; }
    if (!t_is(out, 1, 0))                                                               { ret 29; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LT_S, neg1, one, u8ty, ?out))) { ret 30; }
    if (!t_is(out, 1, 0))                                                               { ret 31; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LT_S, big, neg1, u8ty, ?out))) { ret 32; }
    if (!t_is(out, 0, 0))                                                               { ret 33; }
    val same_lo: value.Value = value.const_int_wide(wide.make(ones, 7), ty);
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_EQ, big, same_lo, u8ty, ?out)))   { ret 34; }
    if (!t_is(out, 0, 0))                                                                  { ret 35; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LE_U, big, same_lo, u8ty, ?out))) { ret 36; }
    if (!t_is(out, 0, 0))                                                                  { ret 37; }

    # MIN / -1 at 128 bits is declined like every other width
    val min: value.Value = value.const_int_wide(wide.make(0, 1::u64 << 63), ty);
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_S, min, neg1, ty, ?out)))                   { ret 38; }
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_U, min, value.const_int(0, ty), ty, ?out))) { ret 39; }

    # the low limbs order one way and the high limbs the other
    val tall_one: value.Value = value.const_int_wide(wide.make(1, 5), ty);
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LT_U, tall_one, two, u8ty, ?out))) { ret 40; }
    if (!t_is(out, 0, 0))                                                                   { ret 41; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LE_U, tall_one, two, u8ty, ?out))) { ret 42; }
    if (!t_is(out, 0, 0))                                                                   { ret 43; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LT_S, tall_one, two, u8ty, ?out))) { ret 44; }
    if (!t_is(out, 0, 0))                                                                   { ret 45; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_CMP_LE_S, two, tall_one, u8ty, ?out))) { ret 46; }
    if (!t_is(out, 1, 0))                                                                   { ret 47; }
    ret 0;
}

# a narrower constant keeps its truncation: the high limb of a u64 result is
# always zero and an i8 wraps at 8 bits
test "mach.lang.me.pass.constfold.fold_int_binary:narrow_results_carry_no_high_limb" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    fin { ir.dnit(?m); }
    val res_64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_64.err) { ret 1; }
    val res_8: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    if (sel res_8.err) { ret 1; }
    val u64ty: type.IrTypeId = res_64.ok;
    val i8ty:  type.IrTypeId = res_8.ok;
    var out:   value.Value;

    val ones: u64 = 0xFFFFFFFFFFFFFFFF;
    if (!t_folded(fold_int_binary(?m, instruction.OP_ADD, value.const_int(ones, u64ty), value.const_int(1, u64ty), u64ty, ?out)))    { ret 2; }
    if (!t_is(out, 0, 0))                                                                                                            { ret 3; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_MUL, value.const_int(ones, u64ty), value.const_int(ones, u64ty), u64ty, ?out))) { ret 4; }
    if (!t_is(out, 1, 0))                                                                                                            { ret 5; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_ADD, value.const_int(0x7F, i8ty), value.const_int(1, i8ty), i8ty, ?out)))       { ret 6; }
    if (!t_is(out, 0x80, 0))                                                                                                         { ret 7; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_SHR_S, value.const_int(0x80, i8ty), value.const_int(7, i8ty), i8ty, ?out)))     { ret 8; }
    if (!t_is(out, 0xFF, 0))                                                                                                         { ret 9; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_DIV_S, value.const_int(0x80, i8ty), value.const_int(0xFF, i8ty), i8ty, ?out)))  { ret 10; }
    if (!t_is(out, 0x80, 0))                                                                                                         { ret 11; }
    ret 0;
}

# the exact 128-bit product of two 64-bit constants and its high half, in
# both signednesses, agree with the wide module's dedicated forms (#3511)
test "mach.lang.me.pass.constfold.fold_mul_wide:exact_product_and_high_half" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    fin { ir.dnit(?m); }
    val res_64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_64.err) { ret 1; }
    val res_128: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 128);
    if (sel res_128.err) { ret 1; }
    val res_32: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_32.err) { ret 1; }
    val i64ty:  type.IrTypeId = res_64.ok;
    val i128ty: type.IrTypeId = res_128.ok;
    val i32ty:  type.IrTypeId = res_32.ok;
    var out:    value.Value;

    val ones: u64         = 0xFFFFFFFFFFFFFFFF;
    val a:    value.Value = value.const_int(0x0123456789ABCDEF, i64ty);
    val b:    value.Value = value.const_int(0xFEDCBA9876543210, i64ty);
    val neg1: value.Value = value.const_int(ones, i64ty);
    val two:  value.Value = value.const_int(2, i64ty);

    val pu: wide.Wide = wide.mul_u64(0x0123456789ABCDEF, 0xFEDCBA9876543210);
    if (!fold_mul_wide(?m, instruction.OP_MUL_WIDE_U, a, b, i128ty, ?out)) { ret 2; }
    if (!t_is(out, pu.lo, pu.hi))                                          { ret 3; }
    if (pu.hi == 0)                                                        { ret 4; }
    if (!fold_mul_wide(?m, instruction.OP_MUL_HIGH_U, a, b, i64ty, ?out))  { ret 5; }
    if (!t_is(out, pu.hi, 0))                                              { ret 6; }

    if (!fold_mul_wide(?m, instruction.OP_MUL_WIDE_U, neg1, neg1, i128ty, ?out)) { ret 7; }
    if (!t_is(out, 1, ones - 1))                                                 { ret 8; }
    if (!fold_mul_wide(?m, instruction.OP_MUL_WIDE_S, neg1, neg1, i128ty, ?out)) { ret 9; }
    if (!t_is(out, 1, 0))                                                        { ret 10; }
    if (!fold_mul_wide(?m, instruction.OP_MUL_WIDE_S, neg1, two, i128ty, ?out))  { ret 11; }
    if (!t_is(out, ones - 1, ones))                                              { ret 12; }

    val bu: u64 = 0xFEDCBA9876543210;
    val hs: i64 = wide.mul_high_s64(0x0123456789ABCDEF, bu:~i64);
    if (!fold_mul_wide(?m, instruction.OP_MUL_HIGH_S, a, b, i64ty, ?out))      { ret 13; }
    if (!t_is(out, hs:~u64, 0))                                                { ret 14; }
    if (!fold_mul_wide(?m, instruction.OP_MUL_HIGH_S, neg1, two, i64ty, ?out)) { ret 15; }
    if (!t_is(out, ones, 0))                                                   { ret 16; }
    if (!fold_mul_wide(?m, instruction.OP_MUL_HIGH_U, neg1, two, i64ty, ?out)) { ret 17; }
    if (!t_is(out, 1, 0))                                                      { ret 18; }

    # a 32-bit operand product fills 64 bits, and its operands are read at 32
    val a32: value.Value = value.const_int(0xFFFFFFFF, i32ty);
    if (!fold_mul_wide(?m, instruction.OP_MUL_WIDE_U, a32, a32, i64ty, ?out)) { ret 19; }
    if (!t_is(out, 0xFFFFFFFE00000001, 0))                                    { ret 20; }
    if (!fold_mul_wide(?m, instruction.OP_MUL_WIDE_S, a32, a32, i64ty, ?out)) { ret 21; }
    if (!t_is(out, 1, 0))                                                     { ret 22; }
    if (!fold_mul_wide(?m, instruction.OP_MUL_HIGH_S, a32, a32, i32ty, ?out)) { ret 23; }
    if (!t_is(out, 0, 0))                                                     { ret 24; }

    # a 128-bit operand has no 256-bit carrier
    val w: value.Value = value.const_int(3, i128ty);
    if (fold_mul_wide(?m, instruction.OP_MUL_HIGH_U, w, w, i128ty, ?out)) { ret 25; }

    var rw:     mutate.Rewrite;
    val r_init: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_init.err) { ret 1; }
    fin { mutate.rewrite_dnit(?rw, ?alloc); }
    var ops: [2]value.Value;
    ops[0] = a;
    ops[1] = b;
    var inst: instruction.Instruction;
    inst.kind          = instruction.OP_MUL_WIDE_U;
    inst.ty            = i128ty;
    inst.operands      = ?ops[0];
    inst.operand_count = 2;
    inst.operand_cap   = 2;
    inst.flags         = 0;
    inst.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?inst, 0, ?rw, ?out))) { ret 26; }
    if (!t_is(out, pu.lo, pu.hi))                     { ret 27; }
    ret 0;
}

# a unary fold and a conversion carry both limbs (#3511)
test "mach.lang.me.pass.constfold.try_fold:wide_unary_and_conversions" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    fin { ir.dnit(?m); }
    val res_64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_64.err) { ret 1; }
    val res_128: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 128);
    if (sel res_128.err) { ret 1; }
    val i64ty:  type.IrTypeId  = res_64.ok;
    val i128ty: type.IrTypeId  = res_128.ok;
    var rw:     mutate.Rewrite;
    val r_init: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_init.err) { ret 1; }
    fin { mutate.rewrite_dnit(?rw, ?alloc); }
    var out: value.Value;

    val ones: u64         = 0xFFFFFFFFFFFFFFFF;
    var op:   value.Value = value.const_int(ones, i64ty);
    var inst: instruction.Instruction;
    inst.operands      = ?op;
    inst.operand_count = 1;
    inst.operand_cap   = 1;
    inst.flags         = 0;
    inst.aux_ty        = type.IRT_NIL;

    inst.kind = instruction.OP_SEXT;
    inst.ty   = i128ty;
    if (!t_folded(try_fold(?m, ?inst, 0, ?rw, ?out))) { ret 2; }
    if (!t_is(out, ones, ones))                       { ret 3; }
    inst.kind = instruction.OP_ZEXT;
    if (!t_folded(try_fold(?m, ?inst, 0, ?rw, ?out))) { ret 4; }
    if (!t_is(out, ones, 0))                          { ret 5; }

    op        = value.const_int_wide(wide.make(5, 9), i128ty);
    inst.kind = instruction.OP_TRUNC;
    inst.ty   = i64ty;
    if (!t_folded(try_fold(?m, ?inst, 0, ?rw, ?out))) { ret 6; }
    if (!t_is(out, 5, 0))                             { ret 7; }

    inst.kind = instruction.OP_NEG;
    inst.ty   = i128ty;
    if (!t_folded(try_fold(?m, ?inst, 0, ?rw, ?out))) { ret 8; }
    if (!t_is(out, ones - 4, ones - 9))               { ret 9; }
    inst.kind = instruction.OP_NOT;
    if (!t_folded(try_fold(?m, ?inst, 0, ?rw, ?out))) { ret 10; }
    if (!t_is(out, ~(5::u64), ~(9::u64)))             { ret 11; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_int_binary:int_min_div_neg1_i64" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:      ir.Module                     = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    val a:   value.Value = value.const_int(0x8000000000000000, ty);
    val b:   value.Value = value.const_int(0xFFFFFFFFFFFFFFFF, ty);
    var out: value.Value;
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_S, a, b, ty, ?out))) { ret 1; }
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_REM_S, a, b, ty, ?out))) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_int_binary:int_min_div_neg1_i32" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:      ir.Module                     = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    val a:   value.Value = value.const_int(0x80000000, ty);
    val b:   value.Value = value.const_int(0xFFFFFFFF, ty);
    var out: value.Value;
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_S, a, b, ty, ?out))) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_int_binary:div_by_zero_and_signed" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:      ir.Module                     = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    var out: value.Value;
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_DIV_S, value.const_int(7, ty), value.const_int(0, ty), ty, ?out))) { ret 1; }
    if (!t_folded(fold_int_binary(?m, instruction.OP_DIV_S, value.const_int(20, ty), value.const_int(4, ty), ty, ?out)))  { ret 1; }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 5)                                                         { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_int_binary:shift_in_range_only" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:      ir.Module                     = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    var out: value.Value;
    if (!t_folded(fold_int_binary(?m, instruction.OP_SHL, value.const_int(8, ty), value.const_int(2, ty), ty, ?out)))    { ret 1; }
    if (out.data.int_lit != 32)                                                                                          { ret 1; }
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_SHL, value.const_int(8, ty), value.const_int(40, ty), ty, ?out))) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.try_fold:int_conversions" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:      ir.Module                     = res_module.ok;
    val res_i8: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    if (sel res_i8.err) { ret 1; }
    val i8ty:    type.IrTypeId                 = res_i8.ok;
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64ty: type.IrTypeId = res_i64.ok;

    var rw:    mutate.Rewrite;
    val r_539: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_539.err) { ret 1; }
    var out: value.Value;

    var sext_op:   value.Value = value.const_int(0xFF, i8ty);
    var sext_inst: instruction.Instruction;
    sext_inst.kind          = instruction.OP_SEXT;
    sext_inst.ty            = i64ty;
    sext_inst.operands      = ?sext_op;
    sext_inst.operand_count = 1;
    sext_inst.operand_cap   = 1;
    sext_inst.flags         = 0;
    sext_inst.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?sext_inst, 0, ?rw, ?out))) { ret 1; }
    if (out.kind != value.VAL_CONST_INT)                   { ret 1; }
    if (out.data.int_lit != 0xFFFFFFFFFFFFFFFF)            { ret 1; }

    var zext_inst: instruction.Instruction;
    zext_inst.kind          = instruction.OP_ZEXT;
    zext_inst.ty            = i64ty;
    zext_inst.operands      = ?sext_op;
    zext_inst.operand_count = 1;
    zext_inst.operand_cap   = 1;
    zext_inst.flags         = 0;
    zext_inst.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?zext_inst, 0, ?rw, ?out))) { ret 1; }
    if (out.data.int_lit != 0xFF)                          { ret 1; }

    var trunc_op:   value.Value = value.const_int(0x1FF, i64ty);
    var trunc_inst: instruction.Instruction;
    trunc_inst.kind          = instruction.OP_TRUNC;
    trunc_inst.ty            = i8ty;
    trunc_inst.operands      = ?trunc_op;
    trunc_inst.operand_count = 1;
    trunc_inst.operand_cap   = 1;
    trunc_inst.flags         = 0;
    trunc_inst.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?trunc_inst, 0, ?rw, ?out))) { ret 1; }
    if (out.data.int_lit != 0xFF)                           { ret 1; }

    mutate.rewrite_dnit(?rw, ?alloc);
    ret 0;
}

test "mach.lang.me.pass.constfold.try_fold:float_narrowing" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:       ir.Module                     = res_module.ok;
    val res_f32: res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 32);
    if (sel res_f32.err) { ret 1; }
    val f32ty:   type.IrTypeId                 = res_f32.ok;
    val res_f64: res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 64);
    if (sel res_f64.err) { ret 1; }
    val f64ty: type.IrTypeId = res_f64.ok;

    var rw:    mutate.Rewrite;
    val r_596: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_596.err) { ret 1; }
    var out: value.Value;

    var src: value.Value = value.const_float(0.1, f64ty);
    var tr:  instruction.Instruction;
    tr.kind          = instruction.OP_FP_TRUNC;
    tr.ty            = f32ty;
    tr.operands      = ?src;
    tr.operand_count = 1;
    tr.operand_cap   = 1;
    tr.flags         = 0;
    tr.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?tr, 0, ?rw, ?out)))                                   { ret 1; }
    if (out.kind != value.VAL_CONST_FLOAT)                                            { ret 1; }
    if (out.ty != f32ty)                                                              { ret 1; }
    if (float.f64_bits(out.data.float_lit) != float.f32_bits_to_f64_bits(0x3DCCCCCD)) { ret 1; }
    if (float.f64_to_f32_bits(float.f64_bits(out.data.float_lit)) != 0x3DCCCCCD)      { ret 1; }

    var nc:  value.Value             = value.instr(7, f64ty);
    var tr2: instruction.Instruction = tr;
    tr2.operands = ?nc;
    if (!t_unfolded(try_fold(?m, ?tr2, 0, ?rw, ?out))) { ret 1; }

    var fsrc: value.Value = value.const_float(0.1, f32ty);
    var ex:   instruction.Instruction;
    ex.kind          = instruction.OP_FP_EXT;
    ex.ty            = f64ty;
    ex.operands      = ?fsrc;
    ex.operand_count = 1;
    ex.operand_cap   = 1;
    ex.flags         = 0;
    ex.aux_ty        = type.IRT_NIL;
    if (!t_unfolded(try_fold(?m, ?ex, 0, ?rw, ?out))) { ret 1; }

    mutate.rewrite_dnit(?rw, ?alloc);
    ret 0;
}

test "mach.lang.me.pass.constfold.simplify_branches:prune_stale_phi_incoming" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:       ir.Module                     = res_module.ok;
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64ty:    type.IrTypeId                 = res_i64.ok;
    val res_void: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel res_void.err) { ret 1; }
    val voidty:  type.IrTypeId                 = res_void.ok;
    val res_sig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel res_sig.err) { ret 1; }
    val sigty:  type.IrTypeId       = res_sig.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sigty, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[0];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_b0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_b0.err) { ret 1; }
    val entry:  id.BlockId                 = res_b0.ok;
    val res_b1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_b1.err) { ret 1; }
    val b_then: id.BlockId                 = res_b1.ok;
    val res_b2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_b2.err) { ret 1; }
    val b_else: id.BlockId = res_b2.ok;

    builder.set_block(?bld, entry);
    val r_667: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int(1, i64ty), b_then, b_else);
    if (sel r_667.err) { ret 1; }

    builder.set_block(?bld, b_then);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64ty);
    if (sel res_phi.err) { ret 1; }
    val phi:   value.Value    = res_phi.ok;
    val r_673: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, b_else, value.const_int(0, i64ty));
    if (sel r_673.err) { ret 1; }
    val r_674: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_674.err) { ret 1; }

    builder.set_block(?bld, b_else);
    val r_677: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_677.err) { ret 1; }

    val r_679: res[bool, fail.Fail] = run(?m);
    if (sel r_679.err) { ret 1; }

    val phi_id:   id.InstructionId         = phi.data.instr;
    val phi_inst: *instruction.Instruction = ?fn.instrs[phi_id];
    if (phi_inst.operand_count != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_phi:collapse_and_distinct" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:      ir.Module                     = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    var rw:    mutate.Rewrite;
    val r_698: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_698.err) { ret 1; }
    var out: value.Value;

    var v1: [1]value.Value;
    v1[0] = value.const_int(7, ty);
    var ops1: [2]value.Value;
    var phi1: instruction.Instruction;
    build_const_phi(?phi1, ?ops1[0], ?v1[0], 1, ty);
    if (fold_phi(?phi1, 0xFFFFFFFF, ?rw, ?out) == false)          { ret 1; }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 7) { ret 1; }

    var v2: [2]value.Value;
    v2[0] = value.const_int(9, ty);
    v2[1] = value.const_int(9, ty);
    var ops2: [4]value.Value;
    var phi2: instruction.Instruction;
    build_const_phi(?phi2, ?ops2[0], ?v2[0], 2, ty);
    if (fold_phi(?phi2, 0xFFFFFFFF, ?rw, ?out) == false) { ret 1; }
    if (out.data.int_lit != 9)                           { ret 1; }

    v2[1] = value.const_int(5, ty);
    build_const_phi(?phi2, ?ops2[0], ?v2[0], 2, ty);
    if (fold_phi(?phi2, 0xFFFFFFFF, ?rw, ?out)) { ret 1; }

    mutate.rewrite_dnit(?rw, ?alloc);
    ret 0;
}

test "mach.lang.me.pass.constfold.run:reports_no_change_when_nothing_folds" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_entry.ok);

    val p0:      value.Value                 = value.param(0, i32t);
    val p1:      value.Value                 = value.param(1, i32t);
    val res_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_751: err[fail.Fail] = builder.emit_ret(?bld, res_add.ok);
    if (sel r_751.err) {
        ir.dnit(?m);
        ret 1;
    }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) {
        ir.dnit(?m);
        ret 1;
    }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

