test "mach.lang.me.pass.constfold.run:reports_change_when_a_constant_branch_simplifies" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_e: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val res_t: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val res_f: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_e.err) {
        ir.dnit(?m);
        ret 1;
    }
    if (sel res_t.err) {
        ir.dnit(?m);
        ret 1;
    }
    if (sel res_f.err) {
        ir.dnit(?m);
        ret 1;
    }
    val eb: id.BlockId = res_e.ok;
    val tb: id.BlockId = res_t.ok;
    val fb: id.BlockId = res_f.ok;

    builder.set_block(?bld, eb);
    val r_824: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int(1, i32t), tb, fb);
    if (sel r_824.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, tb);
    val r_827: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(1, i32t));
    if (sel r_827.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, fb);
    val r_830: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(0, i32t));
    if (sel r_830.err) {
        ir.dnit(?m);
        ret 1;
    }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) {
        ir.dnit(?m);
        ret 1;
    }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != true) { ret 1; }
    ret 0;
}

# the fail-at-N fixture: a constant sum feeding a constant branch whose dead
# arm carries a phi incoming that the fold prunes
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t:   type.IrTypeId       = res_i64.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 2; }
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[res_fn.ok]);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 3; }
    val res_then: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_then.err) { ret 3; }
    val res_else: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_else.err) { ret 3; }
    val res_join: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_join.err) { ret 3; }
    val entry:  id.BlockId  = res_entry.ok;
    val b_then: id.BlockId  = res_then.ok;
    val b_else: id.BlockId  = res_else.ok;
    val b_join: id.BlockId  = res_join.ok;
    val p0:     value.Value = value.param(0, i64t);
    builder.set_block(?bld, entry);
    val res_sum: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.const_int(2, i64t), value.const_int(3, i64t));
    if (sel res_sum.err) { ret 4; }
    val res_cond: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?bld, res_sum.ok, value.const_int(5, i64t));
    if (sel res_cond.err) { ret 5; }
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?bld, res_cond.ok, b_then, b_else);
    if (sel r_cbr.err) { ret 6; }
    builder.set_block(?bld, b_then);
    val res_t: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, res_sum.ok);
    if (sel res_t.err) { ret 7; }
    val r_bt: err[fail.Fail] = builder.emit_br(?bld, b_join);
    if (sel r_bt.err) { ret 8; }
    builder.set_block(?bld, b_else);
    val res_e: res[value.Value, fail.Fail] = builder.emit_sub(?bld, p0, res_sum.ok);
    if (sel res_e.err) { ret 9; }
    val r_be: err[fail.Fail] = builder.emit_br(?bld, b_join);
    if (sel r_be.err) { ret 10; }
    builder.set_block(?bld, b_join);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel res_phi.err) { ret 11; }
    val r_in0: err[fail.Fail] = builder.phi_add_incoming(?bld, res_phi.ok, b_then, res_t.ok);
    if (sel r_in0.err) { ret 12; }
    val r_in1: err[fail.Fail] = builder.phi_add_incoming(?bld, res_phi.ok, b_else, res_e.ok);
    if (sel r_in1.err) { ret 12; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, res_phi.ok);
    if (sel r_ret.err) { ret 13; }
    ret 0;
}

fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val r: res[bool, fail.Fail] = run_in(m, workspace);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the rewrite table is scratch and precedes the fold; the branch fold rewrites
# the terminators before it rebuilds the predecessor lists, and that rebuild
# allocates from the module, so a refusal there leaves the branches folded
# with the predecessor lists and phi incomings not yet reconciled
fun probe_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    val fn:   *ir.Function             = ?m.functions[0];
    val term: *instruction.Instruction = ?fn.instrs[fn.blocks[0].terminator];
    ret term.kind == instruction.OP_BR && me_testing.listed(m) == me_testing.listed(a.control);
}

test "mach.lang.me.pass.constfold.run_in:refusal_at_every_ordinal_leaves_the_input_or_folded_branches" {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: nil, control: nil, context: nil};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}

# a branch on a constant whose only set bits are in the high limb takes the
# true arm (#3511)
test "mach.lang.me.pass.constfold.simplify_branches:condition_truthiness_reads_both_limbs" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    fin { ir.dnit(?m); }
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 128);
    if (sel ri.err) { ret 1; }
    val ty:   type.IrTypeId       = ri.ok;
    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) { ret 1; }
    val fn:  *ir.Function    = ?m.functions[r_fn.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_e: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_e.err) { ret 1; }
    val res_t: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_t.err) { ret 1; }
    val res_f: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_f.err) { ret 1; }
    builder.set_block(?bld, res_e.ok);
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int_wide(wide.make(0, 1), ty), res_t.ok, res_f.ok);
    if (sel r_cbr.err) { ret 1; }
    builder.set_block(?bld, res_t.ok);
    val r_t: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(1, ty));
    if (sel r_t.err) { ret 1; }
    builder.set_block(?bld, res_f.ok);
    val r_f: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(0, ty));
    if (sel r_f.err) { ret 1; }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) { ret 2; }
    if (!rr.ok)     { ret 2; }
    val entry: *ir.Block                     = ?fn.blocks[res_e.ok::u32];
    val term:  opt[*instruction.Instruction] = ir.instruction_get(fn, entry.terminator);
    if (sel term.none)                                      { ret 3; }
    if (term.some.kind != instruction.OP_BR)                { ret 4; }
    if (ir.block_target(term.some.operands[0]) != res_t.ok) { ret 5; }
    ret 0;
}
