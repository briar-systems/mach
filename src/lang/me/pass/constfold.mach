    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    var out: value.Value;
    if (!t_folded(fold_int_binary(?m, instruction.OP_SHL, value.const_int(8, ty), value.const_int(2, ty), ty, ?out))) { ret 1; }
    if (out.data.int_lit != 32)                                                                                     { ret 1; }
    if (!t_unfolded(fold_int_binary(?m, instruction.OP_SHL, value.const_int(8, ty), value.const_int(40, ty), ty, ?out)))         { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.try_fold:int_conversions" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_i8: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    if (sel res_i8.err) { ret 1; }
    val i8ty: type.IrTypeId = res_i8.ok;
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64ty: type.IrTypeId = res_i64.ok;

    var rw: mutate.Rewrite;
    val r_539: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_539.err) { ret 1; }
    var out: value.Value;

    var sext_op: value.Value = value.const_int(0xFF, i8ty);
    var sext_inst: instruction.Instruction;
    sext_inst.kind          = instruction.OP_SEXT;
    sext_inst.ty            = i64ty;
    sext_inst.operands      = ?sext_op;
    sext_inst.operand_count = 1;
    sext_inst.operand_cap   = 1;
    sext_inst.flags         = 0;
    sext_inst.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?sext_inst, 0, ?rw, ?out))) { ret 1; }
    if (out.kind != value.VAL_CONST_INT)                 { ret 1; }
    if (out.data.int_lit != 0xFFFFFFFFFFFFFFFF)          { ret 1; }

    var zext_inst: instruction.Instruction;
    zext_inst.kind          = instruction.OP_ZEXT;
    zext_inst.ty            = i64ty;
    zext_inst.operands      = ?sext_op;
    zext_inst.operand_count = 1;
    zext_inst.operand_cap   = 1;
    zext_inst.flags         = 0;
    zext_inst.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?zext_inst, 0, ?rw, ?out))) { ret 1; }
    if (out.data.int_lit != 0xFF)                        { ret 1; }

    var trunc_op: value.Value = value.const_int(0x1FF, i64ty);
    var trunc_inst: instruction.Instruction;
    trunc_inst.kind          = instruction.OP_TRUNC;
    trunc_inst.ty            = i8ty;
    trunc_inst.operands      = ?trunc_op;
    trunc_inst.operand_count = 1;
    trunc_inst.operand_cap   = 1;
    trunc_inst.flags         = 0;
    trunc_inst.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?trunc_inst, 0, ?rw, ?out))) { ret 1; }
    if (out.data.int_lit != 0xFF)                         { ret 1; }

    mutate.rewrite_dnit(?rw, ?alloc);
    ret 0;
}

test "mach.lang.me.pass.constfold.try_fold:float_narrowing" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_f32: res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 32);
    if (sel res_f32.err) { ret 1; }
    val f32ty: type.IrTypeId = res_f32.ok;
    val res_f64: res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 64);
    if (sel res_f64.err) { ret 1; }
    val f64ty: type.IrTypeId = res_f64.ok;

    var rw: mutate.Rewrite;
    val r_596: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_596.err) { ret 1; }
    var out: value.Value;

    var src: value.Value = value.const_float(0.1, f64ty);
    var tr: instruction.Instruction;
    tr.kind          = instruction.OP_FP_TRUNC;
    tr.ty            = f32ty;
    tr.operands      = ?src;
    tr.operand_count = 1;
    tr.operand_cap   = 1;
    tr.flags         = 0;
    tr.aux_ty        = type.IRT_NIL;
    if (!t_folded(try_fold(?m, ?tr, 0, ?rw, ?out)))                              { ret 1; }
    if (out.kind != value.VAL_CONST_FLOAT)                                     { ret 1; }
    if (out.ty != f32ty)                                                       { ret 1; }
    if (float.f64_bits(out.data.float_lit) != float.f32_bits_to_f64_bits(0x3DCCCCCD)) { ret 1; }
    if (float.f64_to_f32_bits(float.f64_bits(out.data.float_lit)) != 0x3DCCCCCD) { ret 1; }

    var nc: value.Value = value.instr(7, f64ty);
    var tr2: instruction.Instruction = tr;
    tr2.operands = ?nc;
    if (!t_unfolded(try_fold(?m, ?tr2, 0, ?rw, ?out)))                                      { ret 1; }

    var fsrc: value.Value = value.const_float(0.1, f32ty);
    var ex: instruction.Instruction;
    ex.kind          = instruction.OP_FP_EXT;
    ex.ty            = f64ty;
    ex.operands      = ?fsrc;
    ex.operand_count = 1;
    ex.operand_cap   = 1;
    ex.flags         = 0;
    ex.aux_ty        = type.IRT_NIL;
    if (!t_unfolded(try_fold(?m, ?ex, 0, ?rw, ?out)))                                       { ret 1; }

    mutate.rewrite_dnit(?rw, ?alloc);
    ret 0;
}

test "mach.lang.me.pass.constfold.simplify_branches:prune_stale_phi_incoming" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64ty: type.IrTypeId = res_i64.ok;
    val res_void: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel res_void.err) { ret 1; }
    val voidty: type.IrTypeId = res_void.ok;
    val res_sig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel res_sig.err) { ret 1; }
    val sigty: type.IrTypeId = res_sig.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sigty, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[0];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val res_b0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_b0.err) { ret 1; }
    val entry: id.BlockId = res_b0.ok;
    val res_b1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_b1.err) { ret 1; }
    val b_then: id.BlockId = res_b1.ok;
    val res_b2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_b2.err) { ret 1; }
    val b_else: id.BlockId = res_b2.ok;

    builder.set_block(?bld, entry);
    val r_667: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int(1, i64ty), b_then, b_else);
    if (sel r_667.err) { ret 1; }

    builder.set_block(?bld, b_then);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64ty);
    if (sel res_phi.err) { ret 1; }
    val phi: value.Value = res_phi.ok;
    val r_673: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, b_else, value.const_int(0, i64ty));
    if (sel r_673.err) { ret 1; }
    val r_674: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_674.err) { ret 1; }

    builder.set_block(?bld, b_else);
    val r_677: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_677.err) { ret 1; }

    val r_679: res[bool, fail.Fail] = run(?m);
    if (sel r_679.err) { ret 1; }

    val phi_id: id.InstructionId = phi.data.instr;
    val phi_inst: *instruction.Instruction = ?fn.instrs[phi_id];
    if (phi_inst.operand_count != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.constfold.fold_phi:collapse_and_distinct" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    var rw: mutate.Rewrite;
    val r_698: err[fail.Fail] = mutate.rewrite_init(?rw, ?alloc, 1);
    if (sel r_698.err) { ret 1; }
    var out: value.Value;

    var v1: [1]value.Value;
    v1[0] = value.const_int(7, ty);
    var ops1: [2]value.Value;
    var phi1: instruction.Instruction;
    build_const_phi(?phi1, ?ops1[0], ?v1[0], 1, ty);
    if (fold_phi(?phi1, 0xFFFFFFFF, ?rw, ?out) == false)         { ret 1; }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 7) { ret 1; }

    var v2: [2]value.Value;
    v2[0] = value.const_int(9, ty);
    v2[1] = value.const_int(9, ty);
    var ops2: [4]value.Value;
    var phi2: instruction.Instruction;
    build_const_phi(?phi2, ?ops2[0], ?v2[0], 2, ty);
    if (fold_phi(?phi2, 0xFFFFFFFF, ?rw, ?out) == false) { ret 1; }
    if (out.data.int_lit != 9)                           { ret 1; }

    v2[1] = value.const_int(5, ty);
    build_const_phi(?phi2, ?ops2[0], ?v2[0], 2, ty);
    if (fold_phi(?phi2, 0xFFFFFFFF, ?rw, ?out)) { ret 1; }

    mutate.rewrite_dnit(?rw, ?alloc);
    ret 0;
}

test "mach.lang.me.pass.constfold.run:reports_no_change_when_nothing_folds" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i32t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_entry.ok);

    val p0: value.Value = value.param(0, i32t);
    val p1: value.Value = value.param(1, i32t);
    val res_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add.err) { ir.dnit(?m); ret 1; }
    val r_751: err[fail.Fail] = builder.emit_ret(?bld, res_add.ok);
    if (sel r_751.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) { ir.dnit(?m); ret 1; }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

