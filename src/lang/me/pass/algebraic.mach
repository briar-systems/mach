use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module) res[bool, fail.Fail] {
    var workspace:   scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, ?workspace);
}

pub fun run_in(m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var i:       u32  = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var work:      scratch.Function     = scratch.Function{module: m, body: fn};
            val changed_r: res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, simplify_function);
            if (sel changed_r.err) {
                ret changed_r;
            }
            if (changed_r.ok) { changed = true; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun simplify_function(request: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:    *ir.Module   = request.module;
    val fn:   *ir.Function = request.body;
    val ilen: u32          = fn.instr_len;
    if (ilen == 0) {
        ret res[bool, fail.Fail].ok{false};
    }

    var st:       mutate.Rewrite;
    val res_init: err[fail.Fail] = mutate.rewrite_init(?st, alloc, ilen);
    if (sel res_init.err) {
        ret res[bool, fail.Fail].err{res_init.err};
    }

    val any: res[bool, fail.Fail] = simplify_to_fixpoint(m, fn, ?st);
    if (sel any.ok) { mutate.rewrite_apply(fn, ?st); }

    mutate.rewrite_dnit(?st, alloc);
    ret any;
}

fun simplify_to_fixpoint(m: *ir.Module, fn: *ir.Function, st: *mutate.Rewrite) res[bool, fail.Fail] {
    var changed: bool = true;
    var any:     bool = false;
    for (changed) {
        changed = false;
        var i: u32 = 0;
        for (i < st.len) {
            if (mutate.rewrite_has(st, i) == false) {
                val inst:       *instruction.Instruction = ?fn.instrs[i];
                var out:        value.Value;
                val simplified: res[bool, fail.Fail]     = simplify_instruction(m, fn, inst, st, ?out);
                if (sel simplified.err) { ret simplified; }
                if (simplified.ok) {
                    mutate.replace_value(st, i, out);
                    changed = true;
                    any     = true;
                }
            }
            i = i + 1;
        }
    }
    ret res[bool, fail.Fail].ok{any};
}

fun simplify_instruction(m: *ir.Module, fn: *ir.Function, inst: *instruction.Instruction,
    st: *mutate.Rewrite, out: *value.Value) res[bool, fail.Fail] {
    val k: instruction.InstrKind = inst.kind;

    if ((k == instruction.OP_NEG || k == instruction.OP_NOT) && inst.operand_count == 1) {
        if (is_int(m, inst.ty) == false) {
            ret res[bool, fail.Fail].ok{false};
        }
        val a: value.Value = mutate.rewrite_resolve(st, inst.operands[0]);
        if (a.kind != value.VAL_INSTR) {
            ret res[bool, fail.Fail].ok{false};
        }
        val opt_inner: opt[*instruction.Instruction] = ir.instruction_get(fn, a.data.instr);
        if (sel opt_inner.none) {
            ret res[bool, fail.Fail].ok{false};
        }
        val inner: *instruction.Instruction = opt_inner.some;
        if (inner.kind == k && inner.operand_count == 1 && is_int(m, inner.ty)) {
            val src: value.Value = mutate.rewrite_resolve(st, inner.operands[0]);
            @out = value.retype(src, inst.ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }

    if (is_simplifiable_binary(k) && inst.operand_count == 2) {
        if (is_int(m, inst.ty) == false) {
            ret res[bool, fail.Fail].ok{false};
        }
        val a: value.Value = mutate.rewrite_resolve(st, inst.operands[0]);
        val b: value.Value = mutate.rewrite_resolve(st, inst.operands[1]);
        ret simplify_binary(m, k, a, b, inst.ty, out);
    }

    ret res[bool, fail.Fail].ok{false};
}

fun is_simplifiable_binary(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_FOLD_INT);
}

# the algebraic identities of the integer-folding opcodes; every EFF_FOLD_INT
# opcode has an arm and any other is an internal failure naming the tag
fun simplify_binary(m: *ir.Module, k: instruction.InstrKind, a: value.Value, b: value.Value,
    res_ty: type.IrTypeId, out: *value.Value) res[bool, fail.Fail] {
    val bits: u32 = int_bits(m, res_ty);
    if (bits == 0) {
        ret res[bool, fail.Fail].ok{false};
    }

    val a_zero: bool = is_int_zero(a);
    val b_zero: bool = is_int_zero(b);
    val a_one:  bool = is_int_one(a);
    val b_one:  bool = is_int_one(b);
    val a_ones: bool = is_int_all_ones(a, bits);
    val b_ones: bool = is_int_all_ones(b, bits);
    val same:   bool = is_same_value(a, b);

    if (k == instruction.OP_ADD) {
        if (b_zero) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_zero) {
            @out = value.retype(b, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_SUB) {
        if (b_zero) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (same) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_MUL) {
        if (b_one) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_one) {
            @out = value.retype(b, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (b_zero) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_zero) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_DIV_S || k == instruction.OP_DIV_U) {
        if (b_one) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_REM_S || k == instruction.OP_REM_U) {
        if (b_one) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_AND) {
        if (same) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (b_zero) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_zero) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (b_ones) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_ones) {
            @out = value.retype(b, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_OR) {
        if (same) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (b_zero) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_zero) {
            @out = value.retype(b, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (b_ones) {
            @out = value.const_int(all_ones(bits), res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_ones) {
            @out = value.const_int(all_ones(bits), res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_XOR) {
        if (same) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (b_zero) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_zero) {
            @out = value.retype(b, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    if (k == instruction.OP_SHL || k == instruction.OP_SHR_S || k == instruction.OP_SHR_U) {
        if (b_zero) {
            @out = value.retype(a, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        if (a_zero) {
            @out = value.const_int(0, res_ty);
            ret res[bool, fail.Fail].ok{true};
        }
        ret res[bool, fail.Fail].ok{false};
    }
    ret res[bool, fail.Fail].err{opdesc.unknown_kind(m.alloc, k, "the algebraic simplifier")};
}

fun is_int_zero(v: value.Value) bool {
    ret v.kind == value.VAL_CONST_INT && v.data.int_lit == 0;
}

fun is_int_one(v: value.Value) bool {
    ret v.kind == value.VAL_CONST_INT && v.data.int_lit == 1;
}

fun is_int_all_ones(v: value.Value, bits: u32) bool {
    if (v.kind != value.VAL_CONST_INT) {
        ret false;
    }
    ret mask(v.data.int_lit, bits) == all_ones(bits);
}

fun all_ones(bits: u32) u64 {
    if (bits >= 64) {
        ret 0xFFFFFFFFFFFFFFFF;
    }
    ret (1::u64 << bits::u64) - 1;
}

fun mask(v: u64, bits: u32) u64 {
    if (bits >= 64) {
        ret v;
    }
    val m: u64 = (1::u64 << bits::u64) - 1;
    ret v & m;
}

fun is_same_value(a: value.Value, b: value.Value) bool {
    if (a.kind != b.kind) {
        ret false;
    }
    if (a.kind == value.VAL_INSTR) {
        ret a.data.instr == b.data.instr;
    }
    if (a.kind == value.VAL_PARAM) {
        ret a.data.param_ix == b.data.param_ix;
    }
    ret false;
}

fun is_int(m: *ir.Module, tid: type.IrTypeId) bool {
    ret int_bits(m, tid) != 0;
}

fun int_bits(m: *ir.Module, tid: type.IrTypeId) u32 {
    val opt_t: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_t.none) {
        ret 0;
    }
    val t: *type.IrType = opt_t.some;
    if (t.kind != type.IRT_INT) {
        ret 0;
    }
    ret t.data.bits;
}

test "mach.lang.me.pass.algebraic.simplify_binary:identities" {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) {
        ret 1;
    }
    var m: ir.Module = res_module.ok;

    val res_i32: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_i32.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32ty: type.IrTypeId = res_i32.ok;

    val p0:   value.Value = value.param(0, i32ty);
    val zero: value.Value = value.const_int(0, i32ty);
    val ones: value.Value = value.const_int(0xFFFFFFFF, i32ty);
    var out:  value.Value;

    if (!t_simplified(simplify_binary(?m, instruction.OP_SUB, p0, p0, i32ty, ?out))) {
        ir.dnit(?m);
        ret 1;
    }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 0) {
        ir.dnit(?m);
        ret 1;
    }

    if (!t_simplified(simplify_binary(?m, instruction.OP_AND, p0, ones, i32ty, ?out))) {
        ir.dnit(?m);
        ret 1;
    }
    if (out.kind != value.VAL_PARAM || out.data.param_ix != 0) {
        ir.dnit(?m);
        ret 1;
    }

    if (!t_simplified(simplify_binary(?m, instruction.OP_OR, p0, ones, i32ty, ?out))) {
        ir.dnit(?m);
        ret 1;
    }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 0xFFFFFFFF) {
        ir.dnit(?m);
        ret 1;
    }

    if (!t_simplified(simplify_binary(?m, instruction.OP_XOR, p0, p0, i32ty, ?out))) {
        ir.dnit(?m);
        ret 1;
    }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 0) {
        ir.dnit(?m);
        ret 1;
    }

    if (!t_simplified(simplify_binary(?m, instruction.OP_MUL, p0, zero, i32ty, ?out))) {
        ir.dnit(?m);
        ret 1;
    }
    if (out.kind != value.VAL_CONST_INT || out.data.int_lit != 0) {
        ir.dnit(?m);
        ret 1;
    }

    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.pass.algebraic.run:reports_no_change_when_nothing_simplifies" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_entry.ok);

    val p0:      value.Value                 = value.param(0, i32t);
    val p1:      value.Value                 = value.param(1, i32t);
    val res_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, p1);
    if (sel res_add.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_355: err[fail.Fail] = builder.emit_ret(?bld, res_add.ok);
    if (sel r_355.err) {
        ir.dnit(?m);
        ret 1;
    }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) {
        ir.dnit(?m);
        ret 1;
    }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.algebraic.run:reports_change_when_a_self_xor_simplifies" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_entry.ok);

    val p0:      value.Value                 = value.param(0, i32t);
    val res_xor: res[value.Value, fail.Fail] = builder.emit_xor(?bld, p0, p0);
    if (sel res_xor.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_389: err[fail.Fail] = builder.emit_ret(?bld, res_xor.ok);
    if (sel r_389.err) {
        ir.dnit(?m);
        ret 1;
    }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) {
        ir.dnit(?m);
        ret 1;
    }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != true) { ret 1; }
    ret 0;
}

# the fail-at-N fixture: a self xor, an add of zero on it and a multiply by one
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t:   type.IrTypeId       = res_i64.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 2; }
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[res_fn.ok]);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ret 3; }
    builder.set_block(?bld, res_blk.ok);
    val p0:    value.Value                 = value.param(0, i64t);
    val res_x: res[value.Value, fail.Fail] = builder.emit_xor(?bld, p0, p0);
    if (sel res_x.err) { ret 4; }
    val res_y: res[value.Value, fail.Fail] = builder.emit_add(?bld, res_x.ok, value.const_int(0, i64t));
    if (sel res_y.err) { ret 5; }
    val res_z: res[value.Value, fail.Fail] = builder.emit_mul(?bld, res_y.ok, value.const_int(1, i64t));
    if (sel res_z.err) { ret 6; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, res_z.ok);
    if (sel r_ret.err) { ret 7; }
    ret 0;
}

fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val r: res[bool, fail.Fail] = run_in(m, workspace);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the rewrite table is the only allocation, scratch, before the rewrite is
# applied, so a refusal leaves the input unchanged
test "mach.lang.me.pass.algebraic.run_in:refusal_at_every_ordinal_leaves_the_input_unchanged" {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: nil, target: nil, control: nil, context: nil};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}

test "mach.lang.me.pass.algebraic.simplify_binary:is_total_over_the_fold_int_rows" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m:       ir.Module                     = res_module.ok;
    val res_i32: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_i32.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32ty: type.IrTypeId = res_i32.ok;
    val p0:    value.Value   = value.param(0, i32ty);
    val zero:  value.Value   = value.const_int(0, i32ty);
    var out:   value.Value;

    # every EFF_FOLD_INT row reaches an arm; every other opcode is refused by name
    var code: i32   = 0;
    var i:    usize = 0;
    for (i < opdesc.IR_OP_DESCRIPTOR_COUNT) {
        val k: instruction.InstrKind = i::instruction.InstrKind;
        i = i + 1;
        val r: res[bool, fail.Fail] = simplify_binary(?m, k, p0, zero, i32ty, ?out);
        if (is_simplifiable_binary(k)) {
            if (sel r.err) {
                code = 2;
                brk;
            }
        }
        or {
            if (sel r.ok) {
                code = 3;
                brk;
            }
            if (!str_contains(fail.describe(r.err), "unknown InstrKind tag")) {
                code = 4;
                brk;
            }
        }
    }
    ir.dnit(?m);
    ret code;
}

# simplified, as opposed to declined or failed
fun t_simplified(r: res[bool, fail.Fail]) bool {
    if (sel r.err) { ret false; }
    ret r.ok;
}
