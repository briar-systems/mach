use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.allocator.page;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.reachability;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.ir.verify;
use mach.lang.source;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.target.resolved;
use semtype: mach.lang.type;

val NONE_U32: u32 = 0xFFFFFFFF;

rec State {
    alloc:        *A.Allocator;
    m:            *ir.Module;
    fn:           *ir.Function;
    block_count:  u32;

    rpo:          *id.BlockId;
    rpo_len:      u32;
    rpo_index:    *u32;
    idom:         *u32;

    df:           *id.BlockId;
    df_start:     *u32;
    df_len:       *u32;
    df_total:     u32;

    pool_len:     u32;
    instr_block:  *id.BlockId;
    alloca_of:    *u32;

    cand_cap:     u32;
    alloca_ids:   *id.InstructionId;
    alloca_ty:    *type.IrTypeId;
    alloca_count: u32;

    store_start:  *u32;
    store_len:    *u32;
    store_blocks: *id.BlockId;
    store_total:  u32;

    phi_alloca:     *id.InstructionId;
    phi_alloca_cap: u32;
}

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module) res[bool, fail.Fail] {
    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, ?workspace);
}

pub fun run_in(m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var f: u32 = 0;
    for (f < m.function_len) {
        val fn: *ir.Function = ?m.functions[f];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && !effect.function_has_volatile(fn)) {
            var work: scratch.Function = scratch.Function{module: m, body: fn};
            val changed_r: res[bool, fail.Fail] = scratch.run[scratch.Function, bool](workspace, m.alloc, ?work, promote_function);
            if (sel changed_r.err) { ret changed_r; }
            if (changed_r.ok) { changed = true; }
        }
        f = f + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun promote_function(request: *scratch.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = request.module;
    val fn: *ir.Function = request.body;
    val pruned: res[bool, fail.Fail] = reachability.prune(m, fn, alloc);
    if (sel pruned.err) { ret pruned; }
    var st: State;
    state_init(?st, m, fn, alloc);

    if (fn.block_count == 0) { ret res[bool, fail.Fail].ok{false}; }

    val res_collect: err[fail.Fail] = collect_promotable(?st);
    if (sel res_collect.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_collect.err}; }
    if (st.alloca_count == 0)             { state_dnit(?st); ret pruned; }

    val res_phi: err[fail.Fail] = phi_table_init(?st);
    if (sel res_phi.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_phi.err}; }

    val res_dom: err[fail.Fail] = compute_dominance(?st);
    if (sel res_dom.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_dom.err}; }

    val res_insert: err[fail.Fail] = insert_phis(?st);
    if (sel res_insert.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_insert.err}; }

    val res_rename: err[fail.Fail] = rename(?st);
    if (sel res_rename.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_rename.err}; }

    val res_births: err[fail.Fail] = emit_phi_dbg_births(?st);
    if (sel res_births.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_births.err}; }

    state_dnit(?st);
    ret res[bool, fail.Fail].ok{true};
}

fun state_init(st: *State, m: *ir.Module, fn: *ir.Function, alloc: *A.Allocator) {
    st.alloc       = alloc;
    st.m           = m;
    st.fn          = fn;
    st.block_count = fn.block_count;

    st.rpo       = nil;
    st.rpo_len   = 0;
    st.rpo_index = nil;
    st.idom      = nil;

    st.df       = nil;
    st.df_start = nil;
    st.df_len   = nil;
    st.df_total = 0;

    st.pool_len    = 0;
    st.instr_block = nil;
    st.alloca_of   = nil;

    st.cand_cap     = 0;
    st.alloca_ids   = nil;
    st.alloca_ty    = nil;
    st.alloca_count = 0;

    st.store_start  = nil;
    st.store_len    = nil;
    st.store_blocks = nil;
    st.store_total  = 0;

    st.phi_alloca     = nil;
    st.phi_alloca_cap = 0;
}

fun state_dnit(st: *State) {
    if (st.rpo != nil)          { A.deallocate[id.BlockId](st.alloc, st.rpo, st.block_count::usize); }
    if (st.rpo_index != nil)    { A.deallocate[u32](st.alloc, st.rpo_index, st.block_count::usize); }
    if (st.idom != nil)         { A.deallocate[u32](st.alloc, st.idom, st.block_count::usize); }
    if (st.df != nil)           { A.deallocate[id.BlockId](st.alloc, st.df, st.df_total::usize); }
    if (st.df_start != nil)     { A.deallocate[u32](st.alloc, st.df_start, st.block_count::usize); }
    if (st.df_len != nil)       { A.deallocate[u32](st.alloc, st.df_len, st.block_count::usize); }
    if (st.instr_block != nil)  { A.deallocate[id.BlockId](st.alloc, st.instr_block, st.pool_len::usize); }
    if (st.alloca_of != nil)    { A.deallocate[u32](st.alloc, st.alloca_of, st.pool_len::usize); }
    if (st.alloca_ids != nil)   { A.deallocate[id.InstructionId](st.alloc, st.alloca_ids, st.cand_cap::usize); }
    if (st.alloca_ty != nil)    { A.deallocate[type.IrTypeId](st.alloc, st.alloca_ty, st.cand_cap::usize); }
    if (st.store_start != nil)  { A.deallocate[u32](st.alloc, st.store_start, st.alloca_count::usize); }
    if (st.store_len != nil)    { A.deallocate[u32](st.alloc, st.store_len, st.alloca_count::usize); }
    if (st.store_blocks != nil) { A.deallocate[id.BlockId](st.alloc, st.store_blocks, st.store_total::usize); }
    if (st.phi_alloca != nil)   { A.deallocate[id.InstructionId](st.alloc, st.phi_alloca, st.phi_alloca_cap::usize); }
}

fun phi_table_init(st: *State) err[fail.Fail] {
    val phi_cap: u32 = st.fn.instr_len + st.block_count * st.alloca_count;

    val res_phi: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](st.alloc, phi_cap::usize);
    if (sel res_phi.err) {
        ret err[fail.Fail].err{fail.refused(res_phi.err)};
    }
    st.phi_alloca     = res_phi.ok;
    st.phi_alloca_cap = phi_cap;

    var i: u32 = 0;
    for (i < phi_cap) { st.phi_alloca[i] = id.INSTR_NIL; i = i + 1; }
    ret err[fail.Fail].ok{};
}

fun collect_promotable(st: *State) err[fail.Fail] {
    val fn: *ir.Function = st.fn;
    val ilen: u32 = fn.instr_len;
    if (ilen == 0) { ret err[fail.Fail].ok{}; }
    st.pool_len = ilen;

    val res_alloca_ids: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](st.alloc, ilen::usize);
    if (sel res_alloca_ids.err) {
        ret err[fail.Fail].err{fail.refused(res_alloca_ids.err)};
    }
    st.alloca_ids = res_alloca_ids.ok;
    # the capacity is recorded with the first array it sizes, so a refusal of
    # the second releases the first at its true extent
    st.cand_cap   = ilen;

    val res_alloca_ty: res[*type.IrTypeId, A.Error] = A.allocate[type.IrTypeId](st.alloc, ilen::usize);
    if (sel res_alloca_ty.err) {
        ret err[fail.Fail].err{fail.refused(res_alloca_ty.err)};
    }
    st.alloca_ty = res_alloca_ty.ok;

    val res_instr_block: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, ilen::usize);
    if (sel res_instr_block.err) {
        ret err[fail.Fail].err{fail.refused(res_instr_block.err)};
    }
    st.instr_block = res_instr_block.ok;

    val res_alloca_of: res[*u32, A.Error] = A.allocate[u32](st.alloc, ilen::usize);
    if (sel res_alloca_of.err) {
        ret err[fail.Fail].err{fail.refused(res_alloca_of.err)};
    }
    st.alloca_of = res_alloca_of.ok;

    var i: u32 = 0;
    for (i < ilen) {
        st.instr_block[i] = id.BLOCK_NIL;
        st.alloca_of[i]   = NONE_U32;
        i = i + 1;
    }
    map_instr_blocks(st);

    var ii: u32 = 0;
    for (ii < ilen) {
        if (fn.instrs[ii].kind == instruction.OP_ALLOCA && st.instr_block[ii] != id.BLOCK_NIL) {
            st.alloca_of[ii] = st.alloca_count;
            st.alloca_ids[st.alloca_count] = ii::id.InstructionId;
            st.alloca_ty[st.alloca_count]  = type.IRT_NIL;
            st.alloca_count = st.alloca_count + 1;
        }
        ii = ii + 1;
    }
    if (st.alloca_count == 0) { ret err[fail.Fail].ok{}; }

    val cand_n: u32 = st.alloca_count;
    val res_escaped: res[*bool, A.Error] = A.allocate[bool](st.alloc, cand_n::usize);
    if (sel res_escaped.err) { ret err[fail.Fail].err{fail.refused(res_escaped.err)}; }
    val escaped: *bool = res_escaped.ok;

    val res_loaded: res[*bool, A.Error] = A.allocate[bool](st.alloc, cand_n::usize);
    if (sel res_loaded.err) {
        A.deallocate[bool](st.alloc, escaped, cand_n::usize);
        ret err[fail.Fail].err{fail.refused(res_loaded.err)};
    }
    val loaded: *bool = res_loaded.ok;

    var e: u32 = 0;
    for (e < cand_n) { escaped[e] = false; loaded[e] = false; e = e + 1; }

    classify_escapes(st, escaped, loaded);
    compact_promotable(st, escaped, loaded);
    A.deallocate[bool](st.alloc, escaped, cand_n::usize);
    A.deallocate[bool](st.alloc, loaded, cand_n::usize);
    if (st.alloca_count == 0) { ret err[fail.Fail].ok{}; }

    ret collect_store_blocks(st);
}

fun classify_escapes(st: *State, escaped: *bool, loaded: *bool) {
    val fn: *ir.Function = st.fn;
    var c: u32 = 0;
    for (c < st.pool_len) {
        if (st.instr_block[c] != id.BLOCK_NIL) {
            val inst: *instruction.Instruction = ?fn.instrs[c];
            if (inst.kind == instruction.OP_ASM) {
                mark_asm_binds_escaped(st, c::id.InstructionId, escaped);
            }
            if (inst.kind != instruction.OP_DBG_VALUE) {
                var o: u32 = 0;
                for (o < inst.operand_count) {
                    val op: value.Value = inst.operands[o];
                    if (op.kind == value.VAL_INSTR && op.data.instr::u32 < st.pool_len) {
                        val ai: u32 = st.alloca_of[op.data.instr::u32];
                        if (ai != NONE_U32) {
                            val ok_load:  bool = inst.kind == instruction.OP_LOAD  && o == 0;
                            val ok_store: bool = inst.kind == instruction.OP_STORE && o == 1;
                            if (ok_load == false && ok_store == false) {
                                escaped[ai] = true;
                            } or {
                                if (ok_load) { loaded[ai] = true; }
                                if (st.alloca_ty[ai] == type.IRT_NIL) {
                                    if (ok_load) { st.alloca_ty[ai] = inst.ty; }
                                    or           { st.alloca_ty[ai] = inst.operands[0].ty; }
                                }
                            }
                        }
                    }
                    o = o + 1;
                }
            }
        }
        c = c + 1;
    }
}

fun compact_promotable(st: *State, escaped: *bool, loaded: *bool) {
    val cand_n: u32 = st.alloca_count;
    var w: u32 = 0;
    var r: u32 = 0;
    for (r < cand_n) {
        val aid: id.InstructionId = st.alloca_ids[r];
        val agg_read: bool = loaded[r] && type.is_aggregate(?st.m.types, st.alloca_ty[r]);
        if (escaped[r] == false && agg_read == false) {
            st.alloca_ids[w]       = aid;
            st.alloca_ty[w]        = st.alloca_ty[r];
            st.alloca_of[aid::u32] = w;
            w = w + 1;
        } or {
            st.alloca_of[aid::u32] = NONE_U32;
        }
        r = r + 1;
    }
    st.alloca_count = w;
}

fun map_instr_blocks(st: *State) {
    val fn: *ir.Function = st.fn;
    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[b];
        var pi: u32 = 0;
        for (pi < blk.phi_count) {
            val pid: id.InstructionId = blk.phis[pi];
            if (pid::u32 < st.pool_len) { st.instr_block[pid::u32] = b::id.BlockId; }
            pi = pi + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            if (iid::u32 < st.pool_len) { st.instr_block[iid::u32] = b::id.BlockId; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL && blk.terminator::u32 < st.pool_len) {
            st.instr_block[blk.terminator::u32] = b::id.BlockId;
        }
        b = b + 1;
    }
}

fun mark_asm_binds_escaped(st: *State, asm_id: id.InstructionId, escaped: *bool) {
    var key: id.InstructionId = asm_id;
    val res_asm: opt[*ir.IrAsm] = map.get[id.InstructionId, ir.IrAsm](?st.fn.asm_blocks, ?key);
    if (sel res_asm.none) { ret; }
    val payload: *ir.IrAsm = res_asm.some;
    var b: u32 = 0;
    for (b < payload.bind_count) {
        val bid: id.InstructionId = payload.binds[b].instr;
        if (bid::u32 < st.pool_len && st.alloca_of[bid::u32] != NONE_U32) {
            escaped[st.alloca_of[bid::u32]] = true;
        }
        b = b + 1;
    }
}

fun collect_store_blocks(st: *State) err[fail.Fail] {
    val na: u32 = st.alloca_count;

    val res_start: res[*u32, A.Error] = A.allocate[u32](st.alloc, na::usize);
    if (sel res_start.err) { ret err[fail.Fail].err{fail.refused(res_start.err)}; }
    st.store_start = res_start.ok;

    val res_len: res[*u32, A.Error] = A.allocate[u32](st.alloc, na::usize);
    if (sel res_len.err) { ret err[fail.Fail].err{fail.refused(res_len.err)}; }
    st.store_len = res_len.ok;

    var a: u32 = 0;
    for (a < na) { st.store_len[a] = 0; st.store_start[a] = 0; a = a + 1; }

    var i: u32 = 0;
    for (i < st.pool_len) {
        val ai: u32 = store_alloca_index(st, i);
        if (ai != NONE_U32) { st.store_len[ai] = st.store_len[ai] + 1; }
        i = i + 1;
    }

    var total: u32 = 0;
    var p: u32 = 0;
    for (p < na) {
        st.store_start[p] = total;
        total = total + st.store_len[p];
        p = p + 1;
    }
    var alloc_n: u32 = total;
    if (alloc_n == 0) { alloc_n = 1; }
    st.store_total = alloc_n;

    val res_blocks: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, alloc_n::usize);
    if (sel res_blocks.err) { ret err[fail.Fail].err{fail.refused(res_blocks.err)}; }
    st.store_blocks = res_blocks.ok;

    var f: u32 = 0;
    for (f < na) { st.store_len[f] = 0; f = f + 1; }
    var j: u32 = 0;
    for (j < st.pool_len) {
        val ai: u32 = store_alloca_index(st, j);
        if (ai != NONE_U32) {
            st.store_blocks[st.store_start[ai] + st.store_len[ai]] = st.instr_block[j];
            st.store_len[ai] = st.store_len[ai] + 1;
        }
        j = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun store_alloca_index(st: *State, i: u32) u32 {
    if (st.instr_block[i] == id.BLOCK_NIL) { ret NONE_U32; }
    val inst: *instruction.Instruction = ?st.fn.instrs[i];
    if (inst.kind != instruction.OP_STORE) { ret NONE_U32; }
    if (inst.operand_count < 2)            { ret NONE_U32; }
    val ptr: value.Value = inst.operands[1];
    if (ptr.kind != value.VAL_INSTR)        { ret NONE_U32; }
    if (ptr.data.instr::u32 >= st.pool_len) { ret NONE_U32; }
    ret st.alloca_of[ptr.data.instr::u32];
}

fun compute_dominance(st: *State) err[fail.Fail] {
    val n: u32 = st.block_count;

    val res_rpo: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, n::usize);
    if (sel res_rpo.err) { ret err[fail.Fail].err{fail.refused(res_rpo.err)}; }
    st.rpo = res_rpo.ok;

    val res_index: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_index.err) { ret err[fail.Fail].err{fail.refused(res_index.err)}; }
    st.rpo_index = res_index.ok;

    val res_idom: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_idom.err) { ret err[fail.Fail].err{fail.refused(res_idom.err)}; }
    st.idom = res_idom.ok;

    var b: u32 = 0;
    for (b < n) {
        st.rpo_index[b] = NONE_U32;
        st.idom[b]      = NONE_U32;
        b = b + 1;
    }

    val res_rpo_build: err[fail.Fail] = build_rpo(st);
    if (sel res_rpo_build.err) { ret res_rpo_build; }

    val res_idom_build: err[fail.Fail] = build_idom(st);
    if (sel res_idom_build.err) { ret res_idom_build; }

    ret build_frontiers(st);
}

fun build_rpo(st: *State) err[fail.Fail] {
    val n: u32 = st.block_count;

    val res_visited: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel res_visited.err) { ret err[fail.Fail].err{fail.refused(res_visited.err)}; }
    val visited: *bool = res_visited.ok;

    val res_stk_block: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_stk_block.err) {
        A.deallocate[bool](st.alloc, visited, n::usize);
        ret err[fail.Fail].err{fail.refused(res_stk_block.err)};
    }
    val stk_block: *u32 = res_stk_block.ok;

    val res_stk_succ: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_stk_succ.err) {
        A.deallocate[bool](st.alloc, visited, n::usize);
        A.deallocate[u32](st.alloc, stk_block, n::usize);
        ret err[fail.Fail].err{fail.refused(res_stk_succ.err)};
    }
    val stk_succ: *u32 = res_stk_succ.ok;

    val post: *id.BlockId = st.rpo;
    var post_len: u32 = 0;

    var i: u32 = 0;
    for (i < n) { visited[i] = false; i = i + 1; }

    stk_block[0] = 0;
    stk_succ[0]  = 0;
    visited[0]   = true;
    var sp: u32 = 1;

    for (sp > 0) {
        val top: u32 = sp - 1;
        val bid: u32 = stk_block[top];
        val si:  u32 = stk_succ[top];

        var succ0: id.BlockId = id.BLOCK_NIL;
        var succ1: id.BlockId = id.BLOCK_NIL;
        val succ_n: u32 = block_successors(st, bid::id.BlockId, ?succ0, ?succ1);

        if (si < succ_n) {
            stk_succ[top] = si + 1;
            var next: id.BlockId = succ0;
            if (si == 1) { next = succ1; }
            if (next != id.BLOCK_NIL && next::u32 < n) {
                if (visited[next::u32] == false) {
                    visited[next::u32] = true;
                    stk_block[sp] = next::u32;
                    stk_succ[sp]  = 0;
                    sp = sp + 1;
                }
            }
        } or {
            post[post_len] = bid::id.BlockId;
            post_len = post_len + 1;
            sp = sp - 1;
        }
    }

    st.rpo_len = post_len;
    var a: u32 = 0;
    val z: u32 = post_len;
    for (a < z / 2) {
        val tmp: id.BlockId = post[a];
        post[a]         = post[z - 1 - a];
        post[z - 1 - a] = tmp;
        a = a + 1;
    }
    var p: u32 = 0;
    for (p < post_len) {
        st.rpo_index[post[p]::u32] = p;
        p = p + 1;
    }

    A.deallocate[bool](st.alloc, visited, n::usize);
    A.deallocate[u32](st.alloc, stk_block, n::usize);
    A.deallocate[u32](st.alloc, stk_succ, n::usize);
    ret err[fail.Fail].ok{};
}

fun block_successors(st: *State, bid: id.BlockId, out0: *id.BlockId, out1: *id.BlockId) u32 {
    ret ir.block_successors(st.fn, ?st.fn.blocks[bid::u32], out0, out1);
}

fun build_idom(st: *State) err[fail.Fail] {
    val entry: u32 = 0;
    st.idom[entry] = entry;

    var changed: bool = true;
    for (changed) {
        changed = false;
        var r: u32 = 0;
        for (r < st.rpo_len) {
            val b: u32 = st.rpo[r]::u32;
            if (b == entry) { r = r + 1; cnt; }

            var new_idom: u32 = NONE_U32;
            val blk: *ir.Block = ?st.fn.blocks[b];
            var pi: u32 = 0;
            for (pi < blk.pred_count) {
                val pp: u32 = blk.preds[pi]::u32;
                if (pp < st.block_count && st.rpo_index[pp] != NONE_U32 && st.idom[pp] != NONE_U32) {
                    if (new_idom == NONE_U32) {
                        new_idom = pp;
                    } or {
                        new_idom = intersect(st, pp, new_idom);
                    }
                }
                pi = pi + 1;
            }
            if (new_idom != NONE_U32 && st.idom[b] != new_idom) {
                st.idom[b] = new_idom;
                changed = true;
            }
            r = r + 1;
        }
    }
    ret err[fail.Fail].ok{};
}

fun intersect(st: *State, b1: u32, b2: u32) u32 {
    var f1: u32 = b1;
    var f2: u32 = b2;
    for (f1 != f2) {
        for (st.rpo_index[f1] > st.rpo_index[f2]) {
            f1 = st.idom[f1];
        }
        for (st.rpo_index[f2] > st.rpo_index[f1]) {
            f2 = st.idom[f2];
        }
    }
    ret f1;
}

fun build_frontiers(st: *State) err[fail.Fail] {
    val n: u32 = st.block_count;

    val res_start: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_start.err) { ret err[fail.Fail].err{fail.refused(res_start.err)}; }
    st.df_start = res_start.ok;

    val res_len: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_len.err) { ret err[fail.Fail].err{fail.refused(res_len.err)}; }
    st.df_len = res_len.ok;

    var b: u32 = 0;
    for (b < n) { st.df_len[b] = 0; st.df_start[b] = 0; b = b + 1; }

    count_frontiers(st);

    var total: u32 = 0;
    var c: u32 = 0;
    for (c < n) {
        st.df_start[c] = total;
        total = total + st.df_len[c];
        c = c + 1;
    }

    var alloc_n: u32 = total;
    if (alloc_n == 0) { alloc_n = 1; }
    st.df_total = alloc_n;

    val res_df: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, alloc_n::usize);
    if (sel res_df.err) { ret err[fail.Fail].err{fail.refused(res_df.err)}; }
    st.df = res_df.ok;

    var z: u32 = 0;
    for (z < n) { st.df_len[z] = 0; z = z + 1; }
    fill_frontiers(st);
    ret err[fail.Fail].ok{};
}

fun count_frontiers(st: *State) {
    var b: u32 = 0;
    for (b < st.block_count) {
        if (st.rpo_index[b] != NONE_U32) {
            val blk: *ir.Block = ?st.fn.blocks[b];
            if (blk.pred_count >= 2) {
                var pi: u32 = 0;
                for (pi < blk.pred_count) {
                    var runner: u32 = blk.preds[pi]::u32;
                    if (runner < st.block_count && st.rpo_index[runner] != NONE_U32) {
                        for (runner != st.idom[b]) {
                            st.df_len[runner] = st.df_len[runner] + 1;
                            runner = st.idom[runner];
                            if (runner == NONE_U32) { brk; }
                        }
                    }
                    pi = pi + 1;
                }
            }
        }
        b = b + 1;
    }
}

fun fill_frontiers(st: *State) {
    var b: u32 = 0;
    for (b < st.block_count) {
        if (st.rpo_index[b] != NONE_U32) {
            val blk: *ir.Block = ?st.fn.blocks[b];
            if (blk.pred_count >= 2) {
                var pi: u32 = 0;
                for (pi < blk.pred_count) {
                    var runner: u32 = blk.preds[pi]::u32;
                    if (runner < st.block_count && st.rpo_index[runner] != NONE_U32) {
                        for (runner != st.idom[b]) {
                            frontier_add(st, runner, b::id.BlockId);
                            runner = st.idom[runner];
                            if (runner == NONE_U32) { brk; }
                        }
                    }
                    pi = pi + 1;
                }
            }
        }
        b = b + 1;
    }
}

fun frontier_add(st: *State, node: u32, target: id.BlockId) {
    val start: u32 = st.df_start[node];
    val len:   u32 = st.df_len[node];
    var k: u32 = 0;
    for (k < len) {
        if (st.df[start + k] == target) { ret; }
        k = k + 1;
    }
    st.df[start + len] = target;
    st.df_len[node] = len + 1;
}

fun insert_phis(st: *State) err[fail.Fail] {
    val n: u32 = st.block_count;

    val res_has_phi: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel res_has_phi.err) { ret err[fail.Fail].err{fail.refused(res_has_phi.err)}; }
    val has_phi: *bool = res_has_phi.ok;

    val res_on_work: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel res_on_work.err) {
        A.deallocate[bool](st.alloc, has_phi, n::usize);
        ret err[fail.Fail].err{fail.refused(res_on_work.err)};
    }
    val on_work: *bool = res_on_work.ok;

    val res_work: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, n::usize);
    if (sel res_work.err) {
        A.deallocate[bool](st.alloc, has_phi, n::usize);
        A.deallocate[bool](st.alloc, on_work, n::usize);
        ret err[fail.Fail].err{fail.refused(res_work.err)};
    }
    val work: *id.BlockId = res_work.ok;

    var err_msg: str = nil;
    var a: u32 = 0;
    for (a < st.alloca_count && err_msg == nil) {
        val alloca_id: id.InstructionId = st.alloca_ids[a];
        if (type.is_aggregate(?st.m.types, st.alloca_ty[a])) { a = a + 1; cnt; }
        var i: u32 = 0;
        for (i < n) { has_phi[i] = false; on_work[i] = false; i = i + 1; }

        var wlen: u32 = 0;
        val sstart: u32 = st.store_start[a];
        val slen:   u32 = st.store_len[a];
        var s: u32 = 0;
        for (s < slen) {
            val bb: u32 = st.store_blocks[sstart + s]::u32;
            if (bb < n && on_work[bb] == false) {
                on_work[bb] = true;
                work[wlen] = bb::id.BlockId;
                wlen = wlen + 1;
            }
            s = s + 1;
        }

        for (wlen > 0 && err_msg == nil) {
            wlen = wlen - 1;
            val x: u32 = work[wlen]::u32;
            on_work[x] = false;
            val fstart: u32 = st.df_start[x];
            val flen:   u32 = st.df_len[x];
            var k: u32 = 0;
            for (k < flen) {
                val y: u32 = st.df[fstart + k]::u32;
                if (has_phi[y] == false) {
                    has_phi[y] = true;
                    val res_place: err[fail.Fail] = place_phi(st, y::id.BlockId, alloca_id);
                    if (sel res_place.err) { err_msg = fail.describe(res_place.err); }
                    if (on_work[y] == false) {
                        on_work[y] = true;
                        work[wlen] = y::id.BlockId;
                        wlen = wlen + 1;
                    }
                }
                k = k + 1;
            }
        }
        a = a + 1;
    }

    A.deallocate[bool](st.alloc, has_phi, n::usize);
    A.deallocate[bool](st.alloc, on_work, n::usize);
    A.deallocate[id.BlockId](st.alloc, work, n::usize);
    if (err_msg != nil) { ret err[fail.Fail].err{fail.message(err_msg)}; }
    ret err[fail.Fail].ok{};
}

fun place_phi(st: *State, bid: id.BlockId, alloca_id: id.InstructionId) err[fail.Fail] {
    val ai: u32 = alloca_index(st, alloca_id);
    if (ai == NONE_U32) {
        ret err[fail.Fail].err{fail.message("mem2reg: phi placed for a non-promotable alloca")};
    }

    var phi: instruction.Instruction;
    phi.kind          = instruction.OP_PHI;
    phi.ty            = st.alloca_ty[ai];
    phi.operands      = nil;
    phi.operand_count = 0;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;
    phi.loc           = source.loc_nil();
    phi.secret        = false;

    val res_id: res[id.InstructionId, fail.Fail] = ir.instruction_add(st.m, st.fn, phi);
    if (sel res_id.err) {
        ret err[fail.Fail].err{res_id.err};
    }
    val phi_id: id.InstructionId = res_id.ok;

    if (phi_id::u32 < st.phi_alloca_cap) {
        st.phi_alloca[phi_id::u32] = alloca_id;
    } or {
        ret err[fail.Fail].err{fail.message("mem2reg: phi id exceeds phi_alloca capacity")};
    }

    val blk: *ir.Block = ?st.fn.blocks[bid::u32];
    ret ir.block_append_phi(st.m, blk, phi_id);
}

fun emit_phi_dbg_births(st: *State) err[fail.Fail] {
    val res_void: res[type.IrTypeId, fail.Fail] = type.intern_void(?st.m.types);
    if (sel res_void.err) { ret err[fail.Fail].err{res_void.err}; }
    val void_ty: type.IrTypeId = res_void.ok;

    var bi: u32 = 0;
    for (bi < st.block_count) {
        val blk: *ir.Block = ?st.fn.blocks[bi];
        val pc: u32 = blk.phi_count;
        var pi: u32 = 0;
        for (pi < pc) {
            val phi_id: id.InstructionId = blk.phis[pi];
            pi = pi + 1;

            if (phi_id::u32 >= st.phi_alloca_cap) { cnt; }
            val alloca_id: id.InstructionId = st.phi_alloca[phi_id::u32];
            if (alloca_id == id.INSTR_NIL) { cnt; }

            val opt_dv: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(st.fn, alloca_id);
            if (sel opt_dv.none) { cnt; }
            var dv: ir.DbgVar = @opt_dv.some;

            val opt_phi: opt[*instruction.Instruction] = ir.instruction_get(st.fn, phi_id);
            if (sel opt_phi.none) { cnt; }
            val phi_ty: type.IrTypeId = opt_phi.some.ty;

            val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 1::usize);
            if (sel res_ops.err) { ret err[fail.Fail].err{fail.refused(res_ops.err)}; }
            val ops: *value.Value = res_ops.ok;
            ops[0] = value.instr(phi_id, phi_ty);

            var inst: instruction.Instruction;
            inst.kind          = instruction.OP_DBG_VALUE;
            inst.ty            = void_ty;
            inst.operands      = ops;
            inst.operand_count = 1;
            inst.operand_cap   = 1;
            inst.flags         = 0;
            inst.aux_ty        = type.IRT_NIL;
            inst.loc           = source.loc_nil();
            inst.secret        = false;

            val res_id: res[id.InstructionId, fail.Fail] = ir.instruction_add(st.m, st.fn, inst);
            if (sel res_id.err) {
                A.deallocate[value.Value](st.m.alloc, ops, 1::usize);
                ret err[fail.Fail].err{res_id.err};
            }
            val dbg_id: id.InstructionId = res_id.ok;

            val res_rec: res[bool, A.Error] = map.insert[id.InstructionId, ir.DbgVar](?st.fn.dbg_vars, dbg_id, dv);
            if (sel res_rec.err) { ret err[fail.Fail].err{fail.refused(res_rec.err)}; }

            val res_pre: err[fail.Fail] = ir.block_prepend_instr(st.m, ?st.fn.blocks[bi], dbg_id);
            if (sel res_pre.err) { ret res_pre; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

rec RenameCtx {
    st:      *State;
    rw:      mutate.Rewrite;
    cur:     *value.Value;
    defined: *bool;
    cap:     u32;
}

fun rename(st: *State) err[fail.Fail] {
    val na: u32 = st.alloca_count;
    val ilen: u32 = st.fn.instr_len;

    var rc: RenameCtx;
    rc.st      = st;
    rc.cur     = nil;
    rc.defined = nil;
    rc.cap     = 0;

    val res_init: err[fail.Fail] = rename_ctx_init(?rc, na, ilen);
    if (sel res_init.err) { ret res_init; }

    val res_walk: err[fail.Fail] = rename_walk(?rc);
    var res_strip: err[fail.Fail] = err[fail.Fail].ok{};
    if (sel res_walk.ok) {
        mutate.rewrite_apply(st.fn, ?rc.rw);
        res_strip = strip_promoted(st);
    }

    rename_ctx_dnit(?rc);
    if (sel res_walk.err) { ret res_walk; }
    ret res_strip;
}

fun rename_ctx_init(rc: *RenameCtx, na: u32, ilen: u32) err[fail.Fail] {
    val a: *A.Allocator = rc.st.alloc;

    val res_rw: err[fail.Fail] = mutate.rewrite_init(?rc.rw, a, ilen);
    if (sel res_rw.err) { ret res_rw; }

    val res_cur: res[*value.Value, A.Error] = A.allocate[value.Value](a, na::usize);
    if (sel res_cur.err) {
        rename_ctx_dnit(rc);
        ret err[fail.Fail].err{fail.refused(res_cur.err)};
    }
    rc.cur = res_cur.ok;
    rc.cap = na;

    val res_defined: res[*bool, A.Error] = A.allocate[bool](a, na::usize);
    if (sel res_defined.err) {
        rename_ctx_dnit(rc);
        ret err[fail.Fail].err{fail.refused(res_defined.err)};
    }
    rc.defined = res_defined.ok;

    var ai: u32 = 0;
    for (ai < na) { rc.defined[ai] = false; ai = ai + 1; }
    ret err[fail.Fail].ok{};
}

fun rename_ctx_dnit(rc: *RenameCtx) {
    val a: *A.Allocator = rc.st.alloc;
    mutate.rewrite_dnit(?rc.rw, a);
    if (rc.cur != nil)     { A.deallocate[value.Value](a, rc.cur, rc.cap::usize); }
    if (rc.defined != nil) { A.deallocate[bool](a, rc.defined, rc.cap::usize); }
    rc.cur     = nil;
    rc.defined = nil;
    rc.cap     = 0;
}

fun alloca_index(st: *State, alloca_id: id.InstructionId) u32 {
    if (alloca_id == id.INSTR_NIL)     { ret NONE_U32; }
    if (alloca_id::u32 >= st.pool_len) { ret NONE_U32; }
    ret st.alloca_of[alloca_id::u32];
}

fun rename_walk(rc: *RenameCtx) err[fail.Fail] {
    val st: *State = rc.st;
    val n: u32 = st.block_count;
    val na: u32 = st.alloca_count;

    val res_child_start: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_child_start.err) { ret err[fail.Fail].err{fail.refused(res_child_start.err)}; }
    val child_start: *u32 = res_child_start.ok;

    val res_child_len: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_child_len.err) {
        A.deallocate[u32](st.alloc, child_start, n::usize);
        ret err[fail.Fail].err{fail.refused(res_child_len.err)};
    }
    val child_len: *u32 = res_child_len.ok;

    val res_children: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, n::usize);
    if (sel res_children.err) {
        A.deallocate[u32](st.alloc, child_start, n::usize);
        A.deallocate[u32](st.alloc, child_len, n::usize);
        ret err[fail.Fail].err{fail.refused(res_children.err)};
    }
    val children: *id.BlockId = res_children.ok;

    build_dom_children(st, child_start, child_len, children);

    var snap_n: u32 = n * na;
    if (snap_n == 0) { snap_n = 1; }
    val res_save_cur: res[*value.Value, A.Error] = A.allocate[value.Value](st.alloc, snap_n::usize);
    if (sel res_save_cur.err) {
        A.deallocate[u32](st.alloc, child_start, n::usize);
        A.deallocate[u32](st.alloc, child_len, n::usize);
        A.deallocate[id.BlockId](st.alloc, children, n::usize);
        ret err[fail.Fail].err{fail.refused(res_save_cur.err)};
    }
    val save_cur: *value.Value = res_save_cur.ok;

    val res_save_def: res[*bool, A.Error] = A.allocate[bool](st.alloc, snap_n::usize);
    if (sel res_save_def.err) {
        A.deallocate[value.Value](st.alloc, save_cur, snap_n::usize);
        A.deallocate[u32](st.alloc, child_start, n::usize);
        A.deallocate[u32](st.alloc, child_len, n::usize);
        A.deallocate[id.BlockId](st.alloc, children, n::usize);
        ret err[fail.Fail].err{fail.refused(res_save_def.err)};
    }
    val save_def: *bool = res_save_def.ok;

    val res_frame_block: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_frame_block.err) {
        A.deallocate[value.Value](st.alloc, save_cur, snap_n::usize);
        A.deallocate[bool](st.alloc, save_def, snap_n::usize);
        A.deallocate[u32](st.alloc, child_start, n::usize);
        A.deallocate[u32](st.alloc, child_len, n::usize);
        A.deallocate[id.BlockId](st.alloc, children, n::usize);
        ret err[fail.Fail].err{fail.refused(res_frame_block.err)};
    }
    val frame_block: *u32 = res_frame_block.ok;

    val res_frame_child: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel res_frame_child.err) {
        A.deallocate[u32](st.alloc, frame_block, n::usize);
        A.deallocate[value.Value](st.alloc, save_cur, snap_n::usize);
        A.deallocate[bool](st.alloc, save_def, snap_n::usize);
        A.deallocate[u32](st.alloc, child_start, n::usize);
        A.deallocate[u32](st.alloc, child_len, n::usize);
        A.deallocate[id.BlockId](st.alloc, children, n::usize);
        ret err[fail.Fail].err{fail.refused(res_frame_child.err)};
    }
    val frame_child: *u32 = res_frame_child.ok;

    var err_msg: str = nil;
    snapshot(rc, save_cur, save_def, 0);
    val res_entry: err[fail.Fail] = rename_enter_block(rc, 0::id.BlockId);
    if (sel res_entry.err) { err_msg = fail.describe(res_entry.err); }
    frame_block[0] = 0;
    frame_child[0] = 0;
    var sp: u32 = 1;

    for (sp > 0 && err_msg == nil) {
        val top: u32 = sp - 1;
        val b: u32 = frame_block[top];
        val ci: u32 = frame_child[top];
        val cstart: u32 = child_start[b];
        val clen:   u32 = child_len[b];
        if (ci < clen) {
            frame_child[top] = ci + 1;
            val child: u32 = children[cstart + ci]::u32;
            snapshot(rc, save_cur, save_def, sp);
            val res_child: err[fail.Fail] = rename_enter_block(rc, child::id.BlockId);
            if (sel res_child.err) { err_msg = fail.describe(res_child.err); }
            frame_block[sp] = child;
            frame_child[sp] = 0;
            sp = sp + 1;
        } or {
            restore(rc, save_cur, save_def, top);
            sp = sp - 1;
        }
    }

    A.deallocate[u32](st.alloc, frame_block, n::usize);
    A.deallocate[u32](st.alloc, frame_child, n::usize);
    A.deallocate[value.Value](st.alloc, save_cur, snap_n::usize);
    A.deallocate[bool](st.alloc, save_def, snap_n::usize);
    A.deallocate[u32](st.alloc, child_start, n::usize);
    A.deallocate[u32](st.alloc, child_len, n::usize);
    A.deallocate[id.BlockId](st.alloc, children, n::usize);

    if (err_msg != nil) { ret err[fail.Fail].err{fail.message(err_msg)}; }
    ret err[fail.Fail].ok{};
}

fun snapshot(rc: *RenameCtx, save_cur: *value.Value, save_def: *bool, d: u32) {
    val na: u32 = rc.st.alloca_count;
    var a: u32 = 0;
    for (a < na) {
        save_cur[d * na + a] = rc.cur[a];
        save_def[d * na + a] = rc.defined[a];
        a = a + 1;
    }
}

fun restore(rc: *RenameCtx, save_cur: *value.Value, save_def: *bool, d: u32) {
    val na: u32 = rc.st.alloca_count;
    var a: u32 = 0;
    for (a < na) {
        rc.cur[a]     = save_cur[d * na + a];
        rc.defined[a] = save_def[d * na + a];
        a = a + 1;
    }
}

fun build_dom_children(st: *State, child_start: *u32, child_len: *u32, children: *id.BlockId) {
    val n: u32 = st.block_count;
    var b: u32 = 0;
    for (b < n) { child_len[b] = 0; child_start[b] = 0; b = b + 1; }

    var c: u32 = 0;
    for (c < n) {
        if (c != 0 && st.rpo_index[c] != NONE_U32 && st.idom[c] != NONE_U32) {
            val p: u32 = st.idom[c];
            child_len[p] = child_len[p] + 1;
        }
        c = c + 1;
    }
    var total: u32 = 0;
    var k: u32 = 0;
    for (k < n) { child_start[k] = total; total = total + child_len[k]; k = k + 1; }
    var z: u32 = 0;
    for (z < n) { child_len[z] = 0; z = z + 1; }
    var d: u32 = 0;
    for (d < n) {
        if (d != 0 && st.rpo_index[d] != NONE_U32 && st.idom[d] != NONE_U32) {
            val p: u32 = st.idom[d];
            children[child_start[p] + child_len[p]] = d::id.BlockId;
            child_len[p] = child_len[p] + 1;
        }
        d = d + 1;
    }
}

fun rename_enter_block(rc: *RenameCtx, bid: id.BlockId) err[fail.Fail] {
    val st: *State = rc.st;
    val blk: *ir.Block = ?st.fn.blocks[bid::u32];

    var pi: u32 = 0;
    for (pi < blk.phi_count) {
        val phi_id: id.InstructionId = blk.phis[pi];
        val ai: u32 = phi_alloca_index(rc, phi_id);
        if (ai != NONE_U32) {
            val opt_phi: opt[*instruction.Instruction] = ir.instruction_get(st.fn, phi_id);
            if (sel opt_phi.some) {
                val phi: *instruction.Instruction = opt_phi.some;
                rc.cur[ai]     = value.instr(phi_id, phi.ty);
                rc.defined[ai] = true;
            }
        }
        pi = pi + 1;
    }

    var ii: u32 = 0;
    for (ii < blk.instr_count) {
        val iid: id.InstructionId = blk.instructions[ii];
        val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(st.fn, iid);
        if (sel opt_inst.some) {
            val inst: *instruction.Instruction = opt_inst.some;
            if (inst.kind == instruction.OP_LOAD && inst.operand_count >= 1) {
                val ptr: value.Value = inst.operands[0];
                if (ptr.kind == value.VAL_INSTR) {
                    val ai: u32 = alloca_index(st, ptr.data.instr);
                    if (ai != NONE_U32 && iid::u32 < rc.rw.len) {
                        if (rc.defined[ai]) {
                            mutate.replace_value(?rc.rw, iid, rc.cur[ai]);
                        } or {
                            mutate.replace_value(?rc.rw, iid, value.const_null(inst.ty));
                        }
                    }
                }
            } or (inst.kind == instruction.OP_STORE && inst.operand_count >= 2) {
                val ptr: value.Value = inst.operands[1];
                if (ptr.kind == value.VAL_INSTR) {
                    val ai: u32 = alloca_index(st, ptr.data.instr);
                    if (ai != NONE_U32) {
                        rc.cur[ai]     = mutate.rewrite_resolve(?rc.rw, inst.operands[0]);
                        rc.defined[ai] = true;
                    }
                }
            }
        }
        ii = ii + 1;
    }

    var succ0: id.BlockId = id.BLOCK_NIL;
    var succ1: id.BlockId = id.BLOCK_NIL;
    val sn: u32 = block_successors(st, bid, ?succ0, ?succ1);
    if (sn >= 1) {
        val res_first: err[fail.Fail] = add_phi_incomings(rc, bid, succ0);
        if (sel res_first.err) { ret res_first; }
    }
    if (sn >= 2 && succ1 != succ0) {
        val res_second: err[fail.Fail] = add_phi_incomings(rc, bid, succ1);
        if (sel res_second.err) { ret res_second; }
    }
    ret err[fail.Fail].ok{};
}

fun phi_alloca_index(rc: *RenameCtx, phi_id: id.InstructionId) u32 {
    if (phi_id::u32 >= rc.st.phi_alloca_cap) { ret NONE_U32; }
    val alloca_id: id.InstructionId = rc.st.phi_alloca[phi_id::u32];
    if (alloca_id == id.INSTR_NIL) { ret NONE_U32; }
    ret alloca_index(rc.st, alloca_id);
}

fun add_phi_incomings(rc: *RenameCtx, pred: id.BlockId, succ: id.BlockId) err[fail.Fail] {
    val st: *State = rc.st;
    if (succ::u32 >= st.block_count) { ret err[fail.Fail].ok{}; }
    val blk: *ir.Block = ?st.fn.blocks[succ::u32];
    var pi: u32 = 0;
    for (pi < blk.phi_count) {
        val phi_id: id.InstructionId = blk.phis[pi];
        val ai: u32 = phi_alloca_index(rc, phi_id);
        if (ai != NONE_U32) {
            val opt_phi: opt[*instruction.Instruction] = ir.instruction_get(st.fn, phi_id);
            if (sel opt_phi.some) {
                val phi: *instruction.Instruction = opt_phi.some;
                var incoming: value.Value;
                if (rc.defined[ai]) {
                    incoming = rc.cur[ai];
                } or {
                    incoming = value.const_null(phi.ty);
                }
                val res_push: err[fail.Fail] = ir.phi_append_incoming(st.m, phi, pred, incoming);
                if (sel res_push.err) { ret res_push; }
            }
        }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun strip_promoted(st: *State) err[fail.Fail] {
    val changed_r: res[bool, fail.Fail] = mutate.erase_marked[State](st.m, st.fn, st.alloc, st, strip_test);
    if (sel changed_r.err) { ret err[fail.Fail].err{changed_r.err}; }
    ret err[fail.Fail].ok{};
}

fun strip_test(st: *State, iid: id.InstructionId) bool {
    ret is_promoted_memop(st, iid);
}

fun is_promoted_memop(st: *State, iid: id.InstructionId) bool {
    val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(st.fn, iid);
    if (sel opt_inst.none) { ret false; }
    val inst: *instruction.Instruction = opt_inst.some;
    if (inst.kind == instruction.OP_ALLOCA) {
        ret alloca_index(st, iid) != NONE_U32;
    }
    if (inst.kind == instruction.OP_LOAD && inst.operand_count >= 1) {
        val ptr: value.Value = inst.operands[0];
        if (ptr.kind == value.VAL_INSTR) {
            ret alloca_index(st, ptr.data.instr) != NONE_U32;
        }
    }
    if (inst.kind == instruction.OP_STORE && inst.operand_count >= 2) {
        val ptr: value.Value = inst.operands[1];
        if (ptr.kind == value.VAL_INSTR) {
            ret alloca_index(st, ptr.data.instr) != NONE_U32;
        }
    }
    ret false;
}

fun live_alloca_count(fn: *ir.Function, blk: *ir.Block) u32 {
    var n: u32 = 0;
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ix]);
        if (sel opt_inst.some) {
            if (opt_inst.some.kind == instruction.OP_ALLOCA) { n = n + 1; }
        }
        ix = ix + 1;
    }
    ret n;
}

fun unlink_block_instr(blk: *ir.Block, iid: id.InstructionId) {
    var w: u32 = 0;
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        if (blk.instructions[ix] != iid) {
            blk.instructions[w] = blk.instructions[ix];
            w = w + 1;
        }
        ix = ix + 1;
    }
    blk.instr_count = w;
}

test "mach.lang.me.pass.mem2reg.run:promote_after_escaping_call_removed" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;
    val res_void: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel res_void.err) { ret 1; }
    val voidt: type.IrTypeId = res_void.ok;
    val res_ptr: res[type.IrTypeId, fail.Fail] = type.intern_ptr(?m.types);
    if (sel res_ptr.err) { ret 1; }
    val ptrt: type.IrTypeId = res_ptr.ok;

    val res_callee: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_callee.err) { ret 1; }
    val callee_ix: u32 = res_callee.ok;

    val res_caller: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_caller.err) { ret 1; }
    val caller_ix: u32 = res_caller.ok;
    val fn: *ir.Function = ?m.functions[caller_ix];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ret 1; }
    val entry: id.BlockId = res_entry.ok;
    builder.set_block(?bld, entry);

    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val p: value.Value = res_alloca.ok;

    val r_1281: err[fail.Fail] = builder.emit_store(?bld, value.const_int(0, i64t), p);
    if (sel r_1281.err) { ret 1; }

    var args: [1]value.Value;
    args[0] = p;
    val callee_val: value.Value = value.fn(callee_ix, ptrt);
    val res_call: res[value.Value, fail.Fail] = builder.emit_call(?bld, callee_val, ?args[0], 1, voidt);
    if (sel res_call.err) { ret 1; }
    val call_v: value.Value = res_call.ok;
    val call_id: id.InstructionId = call_v.data.instr;

    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, p, i64t);
    if (sel res_load.err)                                                 { ret 1; }
    val r_1293: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel r_1293.err) { ret 1; }

    val entry_blk: *ir.Block = ?fn.blocks[entry::u32];

    val r_1297: res[bool, fail.Fail] = run(?m);
    if (sel r_1297.err) { ret 1; }
    if (live_alloca_count(fn, entry_blk) != 1) { ret 1; }

    unlink_block_instr(entry_blk, call_id);

    val r_1302: res[bool, fail.Fail] = run(?m);
    if (sel r_1302.err) { ret 1; }
    if (live_alloca_count(fn, entry_blk) != 0) { ret 1; }
    ret 0;
}

