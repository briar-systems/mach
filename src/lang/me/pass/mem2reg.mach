test "mach.lang.me.pass.mem2reg.run:phi_dbg_birth" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    fin { ir.dnit(?m); }

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val rb0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb3: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 1; }
    if (sel rb1.err) { ret 1; }
    if (sel rb2.err) { ret 1; }
    if (sel rb3.err) { ret 1; }
    val entry: id.BlockId = rb0.ok;
    val bb1:   id.BlockId = rb1.ok;
    val bb2:   id.BlockId = rb2.ok;
    val merge: id.BlockId = rb3.ok;

    builder.set_block(?bld, entry);
    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val x: value.Value = res_alloca.ok;
    var dv: ir.DbgVar;
    dv.name     = 7::intern.StrId;
    dv.ty       = i64t;
    dv.ty_sem   = semtype.TYPE_NIL;
    dv.is_param = false;
    dv.scope    = 0;
    val r_1388: err[fail.Fail] = ir.record_alloca_dbg_var(fn, x.data.instr, dv);
    if (sel r_1388.err) { ret 1; }
    val r_1389: err[fail.Fail] = builder.emit_cbr(?bld, value.const_int(1, i64t), bb1, bb2);
    if (sel r_1389.err) { ret 1; }

    builder.set_block(?bld, bb1);
    val r_1392: err[fail.Fail] = builder.emit_store(?bld, value.const_int(10, i64t), x);
    if (sel r_1392.err) { ret 1; }
    val r_1393: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_1393.err) { ret 1; }

    builder.set_block(?bld, bb2);
    val r_1396: err[fail.Fail] = builder.emit_store(?bld, value.const_int(20, i64t), x);
    if (sel r_1396.err) { ret 1; }
    val r_1397: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_1397.err) { ret 1; }

    builder.set_block(?bld, merge);
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, x, i64t);
    if (sel res_load.err) { ret 1; }
    val r_1402: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel r_1402.err) { ret 1; }

    val r_1404: res[bool, fail.Fail] = run(?m);
    if (sel r_1404.err) { ret 1; }

    val mblk: *ir.Block = ?fn.blocks[merge::u32];
    if (mblk.phi_count < 1) { ret 1; }
    val phi_id: id.InstructionId = mblk.phis[0];

    var found: bool = false;
    var i: u32 = 0;
    for (i < mblk.instr_count) {
        val iid: id.InstructionId = mblk.instructions[i];
        val oi: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
        if (sel oi.some) {
            val inst: *instruction.Instruction = oi.some;
            if (inst.kind == instruction.OP_DBG_VALUE && inst.operand_count >= 1) {
                val op: value.Value = inst.operands[0];
                if (op.kind == value.VAL_INSTR && op.data.instr == phi_id) {
                    val odv: opt[*ir.DbgVar] = ir.dbg_var_get(fn, iid);
                    if (sel odv.some && odv.some.name == 7::intern.StrId) { found = true; }
                }
            }
        }
        i = i + 1;
    }
    if (!found) { ret 1; }
    ret 0;
}

fun agg_address_violations(m: *ir.Module) i64 {
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1434: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1434.err) { ret -1; }
    val tr: res[resolved.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { ret -1; }
    var tgt: resolved.Target = tr.ok;

    val res_rep: res[verify.VerifyReport, fail.Fail] =
        verify.verify_module_ext(m, m.alloc, verify.opts(?tgt, false, true));
    if (sel res_rep.err) { ret -1; }
    var rep: verify.VerifyReport = res_rep.ok;
    var n: i64 = 0;
    var i: u32 = 0;
    for (i < rep.len) {
        if (rep.violations[i].check == verify.VC_AGG_ADDRESS) { n = n + 1; }
        i = i + 1;
    }
    verify.dnit_report(?rep);
    ret n;
}

test "mach.lang.me.pass.mem2reg.run:aggregate_slot_takes_no_phi" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    var i64t: type.IrTypeId = res_i64.ok;

    var fields: [2]type.IrTypeId;
    fields[0] = i64t;
    fields[1] = i64t;
    val res_st: res[type.IrTypeId, fail.Fail] = type.intern_struct(?m.types, ?fields[0], 2, 0, false);
    if (sel res_st.err) { ret 1; }
    val stty: type.IrTypeId = res_st.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rb0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb3: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 1; }
    if (sel rb1.err) { ret 1; }
    if (sel rb2.err) { ret 1; }
    if (sel rb3.err) { ret 1; }
    val entry: id.BlockId = rb0.ok;
    val arm:   id.BlockId = rb1.ok;
    val skip:  id.BlockId = rb2.ok;
    val merge: id.BlockId = rb3.ok;

    builder.set_block(?bld, entry);
    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, stty, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 1; }
    val s: value.Value = res_alloca.ok;
    val r_1495: err[fail.Fail] = builder.emit_cbr(?bld, value.param(0, i64t), arm, skip);
    if (sel r_1495.err) { ret 1; }

    builder.set_block(?bld, arm);
    val r_1498: err[fail.Fail] = builder.emit_store(?bld, value.param(1, stty), s);
    if (sel r_1498.err) { ret 1; }
    val r_1499: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_1499.err) { ret 1; }

    builder.set_block(?bld, skip);
    val r_1502: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_1502.err) { ret 1; }

    builder.set_block(?bld, merge);
    val r_1505: err[fail.Fail] = builder.emit_ret(?bld, value.param(0, i64t));
    if (sel r_1505.err) { ret 1; }

    val r_1507: res[bool, fail.Fail] = run(?m);
    if (sel r_1507.err) { ret 1; }

    if (live_alloca_count(fn, ?fn.blocks[entry::u32]) != 0) { ret 1; }
    var b: u32 = 0;
    for (b < fn.block_count) {
        if ((?fn.blocks[b]).phi_count != 0) { ret 1; }
        b = b + 1;
    }
    if (agg_address_violations(?m) != 0) { ret 1; }
    ret 0;
}

