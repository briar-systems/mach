test "mach.lang.me.pass.mem2reg.run:reports_no_change_when_no_alloca_is_promotable" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_entry.ok);
    val r_1582: err[fail.Fail] = builder.emit_ret(?bld, value.param(0, i64t));
    if (sel r_1582.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) { ir.dnit(?m); ret 1; }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.mem2reg.run:reports_change_when_an_alloca_is_promoted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_entry.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_entry.ok);

    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ir.dnit(?m); ret 1; }
    val p: value.Value = res_alloca.ok;
    val r_1616: err[fail.Fail] = builder.emit_store(?bld, value.const_int(7, i64t), p);
    if (sel r_1616.err) { ir.dnit(?m); ret 1; }
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, p, i64t);
    if (sel res_load.err) { ir.dnit(?m); ret 1; }
    val r_1619: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel r_1619.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m);
    if (sel rr.err) { ir.dnit(?m); ret 1; }
    val changed: bool = rr.ok;
    ir.dnit(?m);
    if (changed != true) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.mem2reg.rename_ctx_dnit:idempotent_and_partial_construction_frees_its_own_extent" {
    var failing: T.Testing;
    val r_1631: err[A.Error] = T.make(?failing);
    if (sel r_1631.err) { ret 1; }
    var st: State;
    st.alloc = T.allocator_of(?failing);
    var rc: RenameCtx;
    rc.st = ?st; rc.cur = nil; rc.defined = nil; rc.cap = 0;

    val r_1637: err[fail.Fail] = rename_ctx_init(?rc, 3, 4);
    if (sel r_1637.err) { T.dnit(?failing); ret 1; }
    if (rc.cap != 3 || rc.cur == nil || rc.defined == nil)  { T.dnit(?failing); ret 1; }
    rename_ctx_dnit(?rc);
    rename_ctx_dnit(?rc);
    if (T.live_count(?failing) != 0 || T.double_free_count(?failing) != 0) { T.dnit(?failing); ret 1; }
    val total: usize = T.total_count(?failing);
    T.dnit(?failing);
    if (total == 0) { ret 1; }

    var ordinal: usize = 1;
    for (ordinal <= total) {
        var f: T.Testing;
        val r_1649: err[A.Error] = T.make(?f);
        if (sel r_1649.err) { ret 1; }
        T.fail_at_ordinal(?f, ordinal);
        var pst: State;
        pst.alloc = T.allocator_of(?f);
        var prc: RenameCtx;
        prc.st = ?pst; prc.cur = nil; prc.defined = nil; prc.cap = 0;
        val r: err[fail.Fail] = rename_ctx_init(?prc, 3, 4);
        if (sel r.ok) { rename_ctx_dnit(?prc); }
        or (prc.cur != nil || prc.defined != nil || prc.cap != 0) { T.dnit(?f); ret 1; }
        if (T.live_count(?f) != 0 || T.double_free_count(?f) != 0) { T.dnit(?f); ret 1; }
        T.dnit(?f);
        ordinal = ordinal + 1;
    }
    ret 0;
}

fun t_unreachable_promotion(promote: bool) i32 {
    var alloc: A.Allocator;
    val r_1667: err[A.Error] = page.make(?alloc);
    if (sel r_1667.err) { ret 1; }
    val initialized: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel initialized.err) { ret 2; }
    var m: ir.Module = initialized.ok;
    fin { ir.dnit(?m); }
    val integer: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel integer.err) { ret 3; }
    val i64t: type.IrTypeId = integer.ok;
    val signature: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (sel signature.err) { ret 4; }
    val added: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL,
        signature.ok, 0);
    if (sel added.err) { ret 5; }
    val fn: *ir.Function = ?m.functions[added.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val first: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val dead: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val last: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel first.err) { ret 6; }
    if (sel dead.err) { ret 6; }
    if (sel last.err) { ret 6; }
    val entry: id.BlockId = first.ok;
    val removed: id.BlockId = dead.ok;
    val merge: id.BlockId = last.ok;
    builder.set_block(?bld, entry);
    var slot: value.Value = value.const_null(i64t);
    if (promote) {
        val allocated: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
        if (sel allocated.err) { ret 7; }
        slot = allocated.ok;
        val r_1698: err[fail.Fail] = builder.emit_store(?bld, value.const_int(7, i64t), slot);
        if (sel r_1698.err) { ret 8; }
    }
    val r_1700: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_1700.err) { ret 9; }
    builder.set_block(?bld, removed);
    var dead_value: value.Value = value.const_int(9, i64t);
    if (promote) {
        val loaded: res[value.Value, fail.Fail] = builder.emit_load(?bld, slot, i64t);
        if (sel loaded.err) { ret 10; }
        val sum: res[value.Value, fail.Fail] = builder.emit_add(?bld,
            loaded.ok, value.const_int(2, i64t));
        if (sel sum.err) { ret 11; }
        dead_value = sum.ok;
    }
    val r_1711: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_1711.err) { ret 12; }
    builder.set_block(?bld, merge);
    val joined: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel joined.err) { ret 13; }
    val phi: value.Value = joined.ok;
    val r_1716: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, entry, value.const_int(7, i64t));
    if (sel r_1716.err) { ret 14; }
    val r_1717: err[fail.Fail] = builder.phi_add_incoming(?bld, phi, removed, dead_value);
    if (sel r_1717.err) { ret 14; }
    var live_value: value.Value = value.const_int(7, i64t);
    if (promote) {
        val loaded: res[value.Value, fail.Fail] = builder.emit_load(?bld, slot, i64t);
        if (sel loaded.err) { ret 15; }
        live_value = loaded.ok;
    }
    val total: res[value.Value, fail.Fail] = builder.emit_add(?bld, phi, live_value);
    if (sel total.err) { ret 16; }
    val r_1726: err[fail.Fail] = builder.emit_ret(?bld, total.ok);
    if (sel r_1726.err) { ret 17; }
    val before: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(nil, false, false));
    if (sel before.err) { ret 18; }
    var initial: verify.VerifyReport = before.ok;
    val initial_count: u32 = initial.len;
    verify.dnit_report(?initial);
    if (initial_count != 0) { ret 19; }

    val changed: res[bool, fail.Fail] = run(?m);
    if (sel changed.err) { ret 20; }
    val checked: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(nil, true, false));
    if (sel checked.err) { ret 21; }
    var report: verify.VerifyReport = checked.ok;
    val violations: u32 = report.len;
    verify.dnit_report(?report);
    if (violations != 0) { ret 22; }
    if (!changed.ok) { ret 23; }
    if (fn.block_count != 2 || fn.blocks[1].id != 1::id.BlockId) { ret 24; }
    if (fn.blocks[1].pred_count != 1 || fn.blocks[1].preds[0] != entry) { ret 25; }
    val branch: *instruction.Instruction = ?fn.instrs[fn.blocks[0].terminator];
    if (branch.kind != instruction.OP_BR || branch.operands[0].data.int_lit != 1) { ret 26; }
    val incoming: *instruction.Instruction = ?fn.instrs[phi.data.instr];
    if (incoming.operand_count != 2 || incoming.operands[0].data.int_lit != 0
        || incoming.operands[1].kind != value.VAL_CONST_INT || incoming.operands[1].data.int_lit != 7) { ret 27; }
    val sum: *instruction.Instruction = ?fn.instrs[total.ok.data.instr];
    if (sum.operands[0].kind != value.VAL_INSTR || sum.operands[0].data.instr != phi.data.instr
        || sum.operands[1].kind != value.VAL_CONST_INT || sum.operands[1].data.int_lit != 7) { ret 28; }
    if (live_alloca_count(fn, ?fn.blocks[0]) != 0) { ret 29; }
    val repeated: res[bool, fail.Fail] = run(?m);
    if (sel repeated.err) { ret 30; }
    if (repeated.ok) { ret 30; }
    ret 0;
}

test "mach.lang.me.pass.mem2reg.run:unreachable_load_consumers_are_pruned_before_promotion" {
    ret t_unreachable_promotion(true);
}

test "mach.lang.me.pass.mem2reg.run:unreachable_only_change_repairs_phi_and_predecessor_ids" {
    ret t_unreachable_promotion(false);
}

# the fail-at-N fixture: a slot with a debug variable stored in both arms of a
# diamond and loaded at the join, plus an unreachable block the prune removes
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 2; }
    val fn: *ir.Function = ?m.functions[res_fn.ok];
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, fn);
    val rb0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb3: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb4: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 3; }
    if (sel rb1.err) { ret 3; }
    if (sel rb2.err) { ret 3; }
    if (sel rb3.err) { ret 3; }
    if (sel rb4.err) { ret 3; }
    val entry: id.BlockId = rb0.ok;
    val bb1: id.BlockId = rb1.ok;
    val bb2: id.BlockId = rb2.ok;
    val merge: id.BlockId = rb3.ok;
    val orphan: id.BlockId = rb4.ok;
    val p0: value.Value = value.param(0, i64t);

    builder.set_block(?bld, entry);
    val res_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_alloca.err) { ret 4; }
    val x: value.Value = res_alloca.ok;
    var dv: ir.DbgVar;
    dv.name     = 7::intern.StrId;
    dv.ty       = i64t;
    dv.ty_sem   = semtype.TYPE_NIL;
    dv.is_param = false;
    dv.scope    = 0;
    val r_dv: err[fail.Fail] = ir.record_alloca_dbg_var(fn, x.data.instr, dv);
    if (sel r_dv.err) { ret 5; }
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?bld, p0, bb1, bb2);
    if (sel r_cbr.err) { ret 6; }
    builder.set_block(?bld, bb1);
    val r_s1: err[fail.Fail] = builder.emit_store(?bld, value.const_int(10, i64t), x);
    if (sel r_s1.err) { ret 7; }
    val r_b1: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_b1.err) { ret 8; }
    builder.set_block(?bld, bb2);
    val r_s2: err[fail.Fail] = builder.emit_store(?bld, value.const_int(20, i64t), x);
    if (sel r_s2.err) { ret 9; }
    val r_b2: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_b2.err) { ret 10; }
    builder.set_block(?bld, merge);
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, x, i64t);
    if (sel res_load.err) { ret 11; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, res_load.ok);
    if (sel r_ret.err) { ret 12; }
    builder.set_block(?bld, orphan);
    val r_orphan: err[fail.Fail] = builder.emit_br(?bld, merge);
    if (sel r_orphan.err) { ret 13; }
    ret 0;
}

fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val r: res[bool, fail.Fail] = run_in(m, workspace);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the prune and every analysis phase (candidates, dominance, frontiers, phi
# placement work lists) are scratch and precede their mutation; phi placement,
# renaming (incoming appends) and the debug births allocate from the module as
# they rewrite, so a refusal there leaves a partially promoted function: the
# unreachable block is gone, no block was added, and every phi still holds
# whole (block, value) pairs
fun probe_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    val fn: *ir.Function = ?m.functions[0];
    if (fn.block_count != a.control.functions[0].block_count - 1) { ret false; }
    var b: u32 = 0;
    for (b < fn.block_count) {
        var p: u32 = 0;
        for (p < fn.blocks[b].phi_count) {
            if (fn.instrs[fn.blocks[b].phis[p]].operand_count % 2 != 0) { ret false; }
            p = p + 1;
        }
        b = b + 1;
    }
    ret true;
}

test "mach.lang.me.pass.mem2reg.run_in:refusal_at_every_ordinal_leaves_the_input_or_whole_phi_pairs" {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: nil, control: nil, context: nil};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}
