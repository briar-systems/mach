        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(a_fn, blk.instructions[ii]);
            if (sel oi.some) {
                val ins: *instruction.Instruction = oi.some;
                if (ins.kind == instruction.OP_CALL) { a_remaining = a_remaining + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    val b_fn: *ir.Function = ?m.functions[b_ix];
    var b_remaining: u32 = 0;
    bi = 0;
    for (bi < b_fn.block_count) {
        val blk: *ir.Block = ?b_fn.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(b_fn, blk.instructions[ii]);
            if (sel oi.some) {
                val ins: *instruction.Instruction = oi.some;
                if (ins.kind == instruction.OP_CALL) { b_remaining = b_remaining + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    A.deallocate[u32](?alloc, pads, pad_count::usize);
    ir.dnit(?m);

    if (a_remaining != 1) { ret 1; }
    if (b_remaining != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.stamp_inline_metadata:carries_alloca_debug_metadata_into_the_caller" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    val rp: res[type.IrTypeId, fail.Fail] = type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: type.IrTypeId = rp.ok;
    val rs0: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, type.IRT_NIL, nil, 0, false);
    if (sel rs0.err) { ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = rs0.ok;

    val r_callee: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (sel r_callee.err) { ir.dnit(?m); ret 1; }
    val callee_ix: u32 = r_callee.ok;
    val r_caller: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (sel r_caller.err) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = r_caller.ok;

    var bld: builder.Builder = builder.init(?m);

    builder.set_function(?bld, ?m.functions[callee_ix]);
    val rcb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rcb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, rcb.ok);
    val r_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel r_alloca.err) { ir.dnit(?m); ret 1; }
    val alloca_id: id.InstructionId = r_alloca.ok.data.instr;
    val r_2804: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_2804.err) { ir.dnit(?m); ret 1; }

    val callee_fn: *ir.Function = ?m.functions[callee_ix];
    var dv: ir.DbgVar;
    dv.name     = 8181::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 2;
    val r_2812: err[fail.Fail] = ir.record_alloca_dbg_var(callee_fn, alloca_id, dv);
    if (sel r_2812.err) { ir.dnit(?m); ret 1; }

    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rlb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rlb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, rlb.ok);
    val rcall: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(callee_ix, sig0), nil, 0, type.IRT_NIL);
    if (sel rcall.err) { ir.dnit(?m); ret 1; }
    val r_2820: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_2820.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m, nil, nil);
    if (sel rr.err) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var found: bool = false;
    var bad: i32 = 0;
    var i: u32 = 0;
    for (i < caller_fn.block_count) {
        val blk: *ir.Block = ?caller_fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(caller_fn, blk.instructions[ii]);
            if (sel oi.some) {
                val ins: *instruction.Instruction = oi.some;
                if (ins.kind == instruction.OP_ALLOCA) {
                    found = true;
                    val opt_dv: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(caller_fn, blk.instructions[ii]);
                    if (sel opt_dv.none) { bad = 1; }
                    or (sel opt_dv.some) {
                        val cdv: *ir.DbgVar = opt_dv.some;
                        if (cdv.name != 8181::intern.StrId) { bad = 2; }
                        if (cdv.scope != 2)                  { bad = 3; }
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ir.dnit(?m);

    if (!found) { ret 4; }
    ret bad;
}

# a callee of `adds` chained adds plus its return, called once from each of `callers`
# functions carrying `caller_flags`; the callee index is returned and every caller follows it
fun t_fanned_callee(m: *ir.Module, callee_flags: u32, adds: u32, callers: u32, caller_flags: *u32) res[u32, fail.Fail] {
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ret res[u32, fail.Fail].err{ri.err}; }
    val i64t: type.IrTypeId = ri.ok;
    var pi: type.IrTypeId = i64t;
    val rs: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (sel rs.err) { ret res[u32, fail.Fail].err{rs.err}; }
    val sig: type.IrTypeId = rs.ok;
    val rs0: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (sel rs0.err) { ret res[u32, fail.Fail].err{rs0.err}; }
    val sig0: type.IrTypeId = rs0.ok;

    val r_callee: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, sig, callee_flags);
    if (sel r_callee.err) { ret r_callee; }
    val callee_ix: u32 = r_callee.ok;
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[callee_ix]);
    val rcb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rcb.err) { ret res[u32, fail.Fail].err{rcb.err}; }
    builder.set_block(?bld, rcb.ok);
    var acc: value.Value = value.param(0, i64t);
    var k: u32 = 0;
    for (k < adds) {
        val r_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, acc, value.const_int((k + 1)::u64, i64t));
        if (sel r_add.err) { ret res[u32, fail.Fail].err{r_add.err}; }
        acc = r_add.ok;
        k = k + 1;
    }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, acc);
    if (sel r_ret.err) { ret res[u32, fail.Fail].err{r_ret.err}; }

    var c: u32 = 0;
    for (c < callers) {
        val r_caller: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, sig0, caller_flags[c]);
        if (sel r_caller.err) { ret r_caller; }
        builder.set_function(?bld, ?m.functions[r_caller.ok]);
        val rlb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
        if (sel rlb.err) { ret res[u32, fail.Fail].err{rlb.err}; }
        builder.set_block(?bld, rlb.ok);
        var arg: value.Value = value.const_int(7, i64t);
        val rcall: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(callee_ix, sig), ?arg, 1, i64t);
        if (sel rcall.err) { ret res[u32, fail.Fail].err{rcall.err}; }
        val rr: err[fail.Fail] = builder.emit_ret(?bld, rcall.ok);
        if (sel rr.err) { ret res[u32, fail.Fail].err{rr.err}; }
        c = c + 1;
    }
    ret res[u32, fail.Fail].ok{callee_ix};
}

fun t_calls_to(fn: *ir.Function, callee_ix: u32) u32 {
    var calls: u32 = 0;
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
            if (sel oi.some) {
                val ins: *instruction.Instruction = oi.some;
                if (ins.kind == instruction.OP_CALL && callee_index(ins) == callee_ix) { calls = calls + 1; }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret calls;
}

# the size bar is INLINE_INSTR_THRESHOLD live instructions: a two-caller helper one under
# it loses both calls, one at it keeps both. mutation control: `<` to `<=` in should_inline
# inlines the 25-instruction body and fails the second half.
test "mach.lang.me.pass.inline.run:helper_at_the_size_bar_keeps_its_call" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var flags: [2]u32 = [2]u32{ 0, 0 };
    var adds: u32 = INLINE_INSTR_THRESHOLD - 2;
    for (adds <= INLINE_INSTR_THRESHOLD - 1) {
        val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
        if (sel res_m.err) { ret 1; }
        var m: ir.Module = res_m.ok;
        val built: res[u32, fail.Fail] = t_fanned_callee(?m, 0, adds, 2, ?flags[0]);
        if (sel built.err) { ir.dnit(?m); ret 2; }
        val callee_ix: u32 = built.ok;
        if (body.live_instructions(?m.functions[callee_ix]) != adds + 1) { ir.dnit(?m); ret 3; }
        val rr: res[bool, fail.Fail] = run(?m, nil, nil);
        if (sel rr.err) { ir.dnit(?m); ret 4; }
        val calls: u32 = t_calls_to(?m.functions[callee_ix + 1], callee_ix) + t_calls_to(?m.functions[callee_ix + 2], callee_ix);
        ir.dnit(?m);
        var expected: u32 = 2;
        if (adds + 1 < INLINE_INSTR_THRESHOLD) { expected = 0; }
        if (calls != expected) { ret 5; }
        adds = adds + 1;
    }
    ret 0;
}

# an #[oblivious] body is validated for constant time inside its own function; inlining it
# into a function that is not #[oblivious] would move those instructions out of every
# validation, so the public caller keeps its call and the oblivious caller loses it.
# mutation control: dropping the FN_FLAG_OBLIVIOUS line in should_inline inlines both.
test "mach.lang.me.pass.inline.run:oblivious_callee_inlines_only_into_an_oblivious_caller" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    var flags: [2]u32 = [2]u32{ 0, ir.FN_FLAG_OBLIVIOUS };
    val built: res[u32, fail.Fail] = t_fanned_callee(?m, ir.FN_FLAG_OBLIVIOUS | ir.FN_FLAG_INLINE, 2, 2, ?flags[0]);
    if (sel built.err) { ir.dnit(?m); ret 2; }
    val callee_ix: u32 = built.ok;
    val rr: res[bool, fail.Fail] = run(?m, nil, nil);
    if (sel rr.err) { ir.dnit(?m); ret 3; }
    val public_calls: u32 = t_calls_to(?m.functions[callee_ix + 1], callee_ix);
    val oblivious_calls: u32 = t_calls_to(?m.functions[callee_ix + 2], callee_ix);
    ir.dnit(?m);
    if (public_calls != 1)    { ret 4; }
    if (oblivious_calls != 0) { ret 5; }
    ret 0;
}

# the fail-at-N fixture: a small callee inlined into its single caller, and
# a self-recursive function whose direct self-calls are peeled
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    var pi: type.IrTypeId = i64t;
    val rs: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (sel rs.err) { ret 2; }
    val sig: type.IrTypeId = rs.ok;
    val rs0: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (sel rs0.err) { ret 3; }
    val sig0: type.IrTypeId = rs0.ok;
    val r_callee: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, sig, 0);
    if (sel r_callee.err) { ret 4; }
    val callee_ix: u32 = r_callee.ok;
    val r_caller: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, sig0, 0);
    if (sel r_caller.err) { ret 5; }
    val caller_ix: u32 = r_caller.ok;
    val r_fib: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, sig, 0);
    if (sel r_fib.err) { ret 6; }
    val fib_ix: u32 = r_fib.ok;
    var bld: builder.Builder = builder.init(m);

    builder.set_function(?bld, ?m.functions[callee_ix]);
    val rcb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rcb.err) { ret 7; }
    builder.set_block(?bld, rcb.ok);
    val res_double: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.param(0, i64t), value.param(0, i64t));
    if (sel res_double.err) { ret 8; }
    val r_cret: err[fail.Fail] = builder.emit_ret(?bld, res_double.ok);
    if (sel r_cret.err) { ret 9; }

    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rlb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rlb.err) { ret 10; }
    builder.set_block(?bld, rlb.ok);
    var arg: value.Value = value.const_int(7, i64t);
    val rcall: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(callee_ix, sig), ?arg, 1, i64t);
    if (sel rcall.err) { ret 11; }
    val res_after: res[value.Value, fail.Fail] = builder.emit_add(?bld, rcall.ok, value.const_int(1, i64t));
    if (sel res_after.err) { ret 12; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, res_after.ok);
    if (sel r_ret.err) { ret 13; }

    builder.set_function(?bld, ?m.functions[fib_ix]);
    val rb0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ret 14; }
    if (sel rb1.err) { ret 14; }
    if (sel rb2.err) { ret 14; }
    builder.set_block(?bld, rb0.ok);
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (sel rc.err) { ret 15; }
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, rb1.ok, rb2.ok);
    if (sel r_cbr.err) { ret 16; }
    builder.set_block(?bld, rb1.ok);
    val r_base: err[fail.Fail] = builder.emit_ret(?bld, value.param(0, i64t));
    if (sel r_base.err) { ret 17; }
    builder.set_block(?bld, rb2.ok);
    val rn1: res[value.Value, fail.Fail] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(1, i64t));
    if (sel rn1.err) { ret 18; }
    var a1: value.Value = rn1.ok;
    val ra: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a1, 1, i64t);
    if (sel ra.err) { ret 19; }
    val rsum: res[value.Value, fail.Fail] = builder.emit_add(?bld, ra.ok, value.param(0, i64t));
    if (sel rsum.err) { ret 20; }
    val r_fret: err[fail.Fail] = builder.emit_ret(?bld, rsum.ok);
    if (sel r_fret.err) { ret 21; }
    ret 0;
}

fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val r: res[bool, fail.Fail] = run_in(m, a.target, nil, nil, workspace);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the analysis is scratch and precedes any clone; a clone allocates from the
# module as it goes (blocks, cloned instructions, the split of the call
# block, metadata), so a refusal there leaves the callers completed before it
# inlined, the interrupted caller with its call in place or its clone
# unreachable, and every callee unchanged; no function is lost
fun probe_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    if (m.function_len != a.control.function_len) { ret false; }
    ret equal.function_equal(?m.functions[0], ?a.control.functions[0]);
}

test "mach.lang.me.pass.inline.run_in:refusal_at_every_ordinal_leaves_the_input_or_the_callee_untouched" {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: nil, control: nil, context: nil};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}

# the cross-module seam: the importer declares the provider's function as
# external and calls it; the body is acquired into a store over the probe,
# attached for the pass, and detached after
rec CrossModule {
    provider: *ir.Module;
}

fun cross_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    var pi: type.IrTypeId = i64t;
    val rs: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (sel rs.err) { ret 2; }
    val sig: type.IrTypeId = rs.ok;
    val rs0: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (sel rs0.err) { ret 3; }
    val r_decl: res[u32, fail.Fail] = ir.function_add(m, 2, sig, ir.FN_FLAG_EXTERN);
    if (sel r_decl.err) { ret 4; }
    val r_name: err[fail.Fail] = ir.function_register(m, 2, r_decl.ok);
    if (sel r_name.err) { ret 4; }
    m.functions[r_decl.ok].body_module = 1;
    val r_main: res[u32, fail.Fail] = ir.function_add(m, 3, rs0.ok, 0);
    if (sel r_main.err) { ret 5; }
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[r_main.ok]);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) { ret 6; }
    builder.set_block(?bld, rb.ok);
    var arg: value.Value = value.const_int(21, i64t);
    val rcall: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(r_decl.ok, sig), ?arg, 1, i64t);
    if (sel rcall.err) { ret 7; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, rcall.ok);
    if (sel r_ret.err) { ret 8; }
    ret 0;
}

fun cross_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val cross: *CrossModule = a.context::*CrossModule;
    var store: body.Available;
    val opened: err[fail.Fail] = body.available_init_over(?store, m.name, m.alloc);
    if (sel opened.err) { ret err[fail.Fail].err{opened.err}; }
    fin { body.available_dnit(?store, m); }
    val acquired: err[fail.Fail] = body.acquire(?store, m, cross.provider, 2, a.target, ?workspace.alloc);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val attached: err[fail.Fail] = body.attach(?store, m);
    if (sel attached.err) { ret err[fail.Fail].err{attached.err}; }
    fin { body.detach(?store, m); }
    val inlined: res[bool, fail.Fail] = run_in(m, a.target, ?store, nil, workspace);
    if (sel inlined.err) { ret err[fail.Fail].err{inlined.err}; }
    if (!inlined.ok) { ret err[fail.Fail].err{fail.message("cross-module body was not inlined")}; }
    ret err[fail.Fail].ok{};
}

# the acquisition touches only the store, so a refusal there leaves the
# importer unchanged; a refusal in the pass leaves the external declaration
# as it was once the store detaches, and the importer with its call or its
# clone as the same-module contract says
fun cross_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    if (m.function_len != a.control.function_len) { ret false; }
    ret equal.function_equal(?m.functions[0], ?a.control.functions[0]);
}

test "mach.lang.me.pass.inline.run_in:cross_module_body_refusal_at_every_ordinal_leaves_the_importer_or_its_declaration" {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    val initialized: res[ir.Module, fail.Fail] = ir.init(?owner, 1);
    if (sel initialized.err) { ret 2; }
    var provider: ir.Module = initialized.ok;
    fin { ir.dnit(?provider); }
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?provider.types, 64);
    if (sel ri.err) { ret 3; }
    var pi: type.IrTypeId = ri.ok;
    val rs: res[type.IrTypeId, fail.Fail] = type.intern_fn(?provider.types, ri.ok, ?pi, 1, false);
    if (sel rs.err) { ret 4; }
    val added: res[u32, fail.Fail] = ir.function_add(?provider, 2, rs.ok, ir.FN_FLAG_INLINE | ir.FN_FLAG_PUB);
    if (sel added.err) { ret 5; }
    val named: err[fail.Fail] = ir.function_register(?provider, 2, added.ok);
    if (sel named.err) { ret 5; }
    var bld: builder.Builder = builder.init(?provider);
    builder.set_function(?bld, ?provider.functions[added.ok]);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) { ret 6; }
    builder.set_block(?bld, rb.ok);
    val doubled: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.param(0, ri.ok), value.param(0, ri.ok));
    if (sel doubled.err) { ret 7; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, doubled.ok);
    if (sel r_ret.err) { ret 8; }
    var tgt: target.Target;
    var cross: CrossModule = CrossModule{provider: ?provider};
    var a: me_testing.Attempt = me_testing.Attempt{build: cross_build, transform: cross_transform,
        contract: cross_contract, target: ?tgt, control: nil, context: (?cross)::ptr};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 9; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}
