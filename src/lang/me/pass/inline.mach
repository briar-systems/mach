use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.refs;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;
use mach.lang.target;
use semtype: mach.lang.type;

val INLINE_INSTR_THRESHOLD: u32 = 25;

val INLINE_BUDGET: u32 = 1024;

val PEEL_BUDGET: u32 = 1024;

val INLINE_SMALL_CALLEE_FANOUT_CAP: u32 = 16;

val PEEL_LEVELS: u32 = 2;

val PEEL_FRONTIER_CAP: u32 = 256;

pub rec InlineBudget {
    inline_exhausted: bool;
    peel_exhausted:   bool;
}

rec InlineFacts {
    address_taken: *bool;
    exposed:       *bool;
    len:           u32;
}

fun inline_facts_free(m: *ir.Module, facts: *InlineFacts) {
    if (facts.address_taken != nil && facts.len > 0) {
        A.deallocate[bool](m.alloc, facts.address_taken, facts.len::usize);
    }
    if (facts.exposed != nil && facts.len > 0) {
        A.deallocate[bool](m.alloc, facts.exposed, facts.len::usize);
    }
}

fun mark_value_address_taken(v: *value.Value, facts: *InlineFacts) {
    if (v.kind == value.VAL_FN && v.data.fn_ix < facts.len) {
        facts.address_taken[v.data.fn_ix] = true;
    }
}

fun build_inline_facts(m: *ir.Module) R.Result[InlineFacts, str] {
    var facts: InlineFacts;
    facts.len = m.function_len;

    val res_at: R.Result[*bool, str] = A.allocate[bool](m.alloc, m.function_len::usize);
    if (R.is_err[*bool, str](res_at)) { ret R.err[InlineFacts, str](R.unwrap_err[*bool, str](res_at)); }
    facts.address_taken = R.unwrap_ok[*bool, str](res_at);

    val res_ex: R.Result[*bool, str] = A.allocate[bool](m.alloc, m.function_len::usize);
    if (R.is_err[*bool, str](res_ex)) {
        A.deallocate[bool](m.alloc, facts.address_taken, m.function_len::usize);
        ret R.err[InlineFacts, str](R.unwrap_err[*bool, str](res_ex));
    }
    facts.exposed = R.unwrap_ok[*bool, str](res_ex);

    var i: u32 = 0;
    for (i < m.function_len) {
        facts.address_taken[i] = false;
        val fn: *ir.Function = ?m.functions[i];
        facts.exposed[i] = (fn.flags & (ir.FN_FLAG_PUB | ir.FN_FLAG_WEAK)) != 0;
        i = i + 1;
    }

    i = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        var bi: u32 = 0;
        for (bi < fn.block_count) {
            val blk: *ir.Block = ?fn.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
                if (O.is_some[*instruction.Instruction](opt_inst)) {
                    val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);
                    var oi: u32 = 0;
                    for (oi < inst.operand_count) {
                        if (inst.kind == instruction.OP_CALL && oi == 0) { oi = oi + 1; cnt; }
                        mark_value_address_taken(?inst.operands[oi], ?facts);
                        oi = oi + 1;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        i = i + 1;
    }

    var gi: u32 = 0;
    for (gi < m.global_len) {
        val g: *ir.Global = ?m.globals[gi];
        mark_value_address_taken(?g.init, ?facts);
        if (g.init.kind == value.VAL_CONST_AGG) {
            var ri: u32 = 0;
            for (ri < g.init.data.agg.reloc_count) {
                val r: *value.AggReloc = ?g.init.data.agg.relocs[ri];
                if (r.is_fn) {
                    val opt_ix: O.Option[u32] = ir.function_lookup(m, r.symbol);
                    if (O.is_some[u32](opt_ix)) {
                        val ix: u32 = O.unwrap[u32](opt_ix);
                        if (ix < facts.len) { facts.address_taken[ix] = true; }
                    }
                }
                ri = ri + 1;
            }
        }
        gi = gi + 1;
    }

    ret R.ok[InlineFacts, str](facts);
}

pub fun run(m: *ir.Module, tgt: *target.Target, out_report: *InlineBudget) R.Result[bool, str] {
    if (out_report != nil) {
        out_report.inline_exhausted = false;
        out_report.peel_exhausted   = false;
    }
    if (m.function_len == 0) { ret R.ok[bool, str](false); }

    val res_recursive: R.Result[*bool, str] = A.allocate[bool](m.alloc, m.function_len::usize);
    if (R.is_err[*bool, str](res_recursive)) {
        ret R.err[bool, str](R.unwrap_err[*bool, str](res_recursive));
    }
    val recursive: *bool = R.unwrap_ok[*bool, str](res_recursive);
    val res_mark: R.Result[R.Void, str] = mark_recursive(m, recursive);
    if (R.is_err[R.Void, str](res_mark)) {
        A.deallocate[bool](m.alloc, recursive, m.function_len::usize);
        ret R.err[bool, str](R.unwrap_err[R.Void, str](res_mark));
    }

    val res_counts: R.Result[*u32, str] = A.allocate[u32](m.alloc, m.function_len::usize);
    if (R.is_err[*u32, str](res_counts)) {
        A.deallocate[bool](m.alloc, recursive, m.function_len::usize);
        ret R.err[bool, str](R.unwrap_err[*u32, str](res_counts));
    }
    val counts: *u32 = R.unwrap_ok[*u32, str](res_counts);
    build_call_counts(m, counts);

    val res_facts: R.Result[InlineFacts, str] = build_inline_facts(m);
    if (R.is_err[InlineFacts, str](res_facts)) {
        A.deallocate[u32](m.alloc, counts, m.function_len::usize);
        A.deallocate[bool](m.alloc, recursive, m.function_len::usize);
        ret R.err[bool, str](R.unwrap_err[InlineFacts, str](res_facts));
    }
    var facts: InlineFacts = R.unwrap_ok[InlineFacts, str](res_facts);

    val res_dup: R.Result[*u32, str] = A.allocate[u32](m.alloc, m.function_len::usize);
    if (R.is_err[*u32, str](res_dup)) {
        inline_facts_free(m, ?facts);
        A.deallocate[u32](m.alloc, counts, m.function_len::usize);
        A.deallocate[bool](m.alloc, recursive, m.function_len::usize);
        ret R.err[bool, str](R.unwrap_err[*u32, str](res_dup));
    }
    val dup_count: *u32 = R.unwrap_ok[*u32, str](res_dup);
    var di: u32 = 0;
    for (di < m.function_len) { dup_count[di] = 0; di = di + 1; }

    var any_inlined: bool = false;
    var any_exhausted: bool = false;
    var i: u32 = 0;
    for (i < m.function_len) {
        val caller: *ir.Function = ?m.functions[i];
        if ((caller.flags & ir.FN_FLAG_EXTERN) == 0) {
            var budget: u32 = INLINE_BUDGET;
            var progress: bool = true;
            for (progress && budget > 0) {
                val inlined_r: R.Result[bool, str] = inline_one_in_fn(m, recursive, counts, ?facts, dup_count, caller);
                if (R.is_err[bool, str](inlined_r)) {
                    A.deallocate[u32](m.alloc, dup_count, m.function_len::usize);
                    inline_facts_free(m, ?facts);
                    A.deallocate[u32](m.alloc, counts, m.function_len::usize);
                    A.deallocate[bool](m.alloc, recursive, m.function_len::usize);
                    ret inlined_r;
                }
                progress = R.unwrap_ok[bool, str](inlined_r);
                if (progress) { budget = budget - 1; any_inlined = true; }
            }
            if (budget == 0) { any_exhausted = true; }
        }
        i = i + 1;
    }
    if (out_report != nil && any_exhausted) { out_report.inline_exhausted = true; }

    A.deallocate[u32](m.alloc, dup_count, m.function_len::usize);
    inline_facts_free(m, ?facts);
    A.deallocate[u32](m.alloc, counts, m.function_len::usize);
    A.deallocate[bool](m.alloc, recursive, m.function_len::usize);

    var peel_exhausted: bool = false;
    val peeled_r: R.Result[bool, str] = peel_all(m, ?peel_exhausted);
    if (out_report != nil && peel_exhausted) { out_report.peel_exhausted = true; }
    if (R.is_err[bool, str](peeled_r)) { ret peeled_r; }
    ret R.ok[bool, str](any_inlined || R.unwrap_ok[bool, str](peeled_r));
}

fun inline_one_in_fn(m: *ir.Module, recursive: *bool, counts: *u32, facts: *InlineFacts, dup_count: *u32, caller: *ir.Function) R.Result[bool, str] {
    var i: u32 = 0;
    for (i < caller.block_count) {
        val blk: *ir.Block = ?caller.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(caller, iid);
            if (O.is_some[*instruction.Instruction](opt_inst)) {
                val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1) {
                    val callee_ix: u32 = callee_index(inst);
                    if (callee_ix != 0xFFFFFFFF && callee_ix < m.function_len) {
                        val callee: *ir.Function = ?m.functions[callee_ix];
                        if (should_inline(recursive, counts, facts, dup_count, callee_ix, callee)) {
                            val res_inline: R.Result[R.Void, str] =
                                do_inline(m, counts, caller, i, ii, iid, callee_ix, callee);
                            if (R.is_err[R.Void, str](res_inline)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_inline)); }
                            dup_count[callee_ix] = dup_count[callee_ix] + 1;
                            ret R.ok[bool, str](true);
                        }
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret R.ok[bool, str](false);
}

fun callee_index(call: *instruction.Instruction) u32 {
    val callee: value.Value = call.operands[0];
    if (callee.kind == value.VAL_FN) { ret callee.data.fn_ix; }
    ret 0xFFFFFFFF;
}

fun should_inline(recursive: *bool, counts: *u32, facts: *InlineFacts, dup_count: *u32, callee_ix: u32, callee: *ir.Function) bool {
    if ((callee.flags & ir.FN_FLAG_EXTERN) != 0)             { ret false; }
    if ((callee.flags & ir.FN_FLAG_SCALAR) != 0)             { ret false; }
    if ((callee.flags & ir.FN_FLAG_NOINLINE) != 0)           { ret false; }
    if ((callee.flags & ir.FN_FLAG_NAKED) != 0)              { ret false; }
    if (recursive[callee_ix])                                { ret false; }
    if (callee.block_count == 0)                             { ret false; }
    if ((callee.flags & ir.FN_FLAG_INLINE) != 0)             { ret true; }

    val single_caller: bool = counts[callee_ix] == 1
        && !facts.address_taken[callee_ix]
        && !facts.exposed[callee_ix];
    if (single_caller) { ret true; }

    if (callee_instr_count(callee) < INLINE_INSTR_THRESHOLD
        && dup_count[callee_ix] < INLINE_SMALL_CALLEE_FANOUT_CAP) { ret true; }
    ret false;
}

fun callee_instr_count(callee: *ir.Function) u32 {
    var total: u32 = 0;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val blk: *ir.Block = ?callee.blocks[i];
        total = total + blk.phi_count;
        var k: u32 = 0;
        for (k < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(callee, blk.instructions[k]);
            if (O.is_some[*instruction.Instruction](oi) && O.unwrap[*instruction.Instruction](oi).kind != instruction.OP_DBG_VALUE) { total = total + 1; }
            k = k + 1;
        }
        if (blk.terminator != id.INSTR_NIL) { total = total + 1; }
        i = i + 1;
    }
    ret total;
}

fun build_call_counts(m: *ir.Module, counts: *u32) {
    var i: u32 = 0;
    for (i < m.function_len) {
        counts[i] = 0;
        i = i + 1;
    }
    i = 0;
    for (i < m.function_len) {
        add_fn_call_counts(m, ?m.functions[i], counts);
        i = i + 1;
    }
}

fun add_fn_call_counts(m: *ir.Module, fn: *ir.Function, counts: *u32) {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](opt_inst)) {
                val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1) {
                    val callee_ix: u32 = callee_index(inst);
                    if (callee_ix != 0xFFFFFFFF && callee_ix < m.function_len) {
                        counts[callee_ix] = counts[callee_ix] + 1;
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun mark_recursive(m: *ir.Module, recursive: *bool) R.Result[R.Void, str] {
    val n: u32 = m.function_len;
    val res_visited: R.Result[*bool, str] = A.allocate[bool](m.alloc, n::usize);
    if (R.is_err[*bool, str](res_visited)) {
        ret R.err[R.Void, str](R.unwrap_err[*bool, str](res_visited));
    }
    val visited: *bool = R.unwrap_ok[*bool, str](res_visited);
    val res_queue: R.Result[*u32, str] = A.allocate[u32](m.alloc, n::usize);
    if (R.is_err[*u32, str](res_queue)) {
        A.deallocate[bool](m.alloc, visited, n::usize);
        ret R.err[R.Void, str](R.unwrap_err[*u32, str](res_queue));
    }
    val queue: *u32 = R.unwrap_ok[*u32, str](res_queue);

    var i: u32 = 0;
    for (i < n) {
        recursive[i] = reaches_self(m, i, visited, queue, n);
        i = i + 1;
    }

    A.deallocate[bool](m.alloc, visited, n::usize);
    A.deallocate[u32](m.alloc, queue, n::usize);
    ret R.ok_void[str]();
}

fun reaches_self(m: *ir.Module, start: u32, visited: *bool, queue: *u32, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        visited[i] = false;
        i = i + 1;
    }

    var qt: u32 = 0;
    if (scan_callees(m, start, start, visited, queue, ?qt)) { ret true; }
    var qh: u32 = 0;
    for (qh < qt) {
        val fn_ix: u32 = queue[qh];
        qh = qh + 1;
        if (scan_callees(m, fn_ix, start, visited, queue, ?qt)) { ret true; }
    }
    ret false;
}

fun scan_callees(m: *ir.Module, fn_ix: u32, target_ix: u32, visited: *bool, queue: *u32, qt: *u32) bool {
    val fn: *ir.Function = ?m.functions[fn_ix];
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](opt_inst)) {
                val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1) {
                    val callee_ix: u32 = callee_index(inst);
                    if (callee_ix != 0xFFFFFFFF && callee_ix < m.function_len) {
                        if (callee_ix == target_ix) { ret true; }
                        if (visited[callee_ix] == false) {
                            visited[callee_ix] = true;
                            queue[@qt] = callee_ix;
                            @qt = @qt + 1;
                        }
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret false;
}

rec InlineCtx {
    m:         *ir.Module;
    caller:    *ir.Function;
    callee:    *ir.Function;
    block_map: *u32;
    instr_map: *u32;
    args:      *value.Value;
    arg_count: u32;
    entry_blk: id.BlockId;
    cont_blk:  id.BlockId;
    ret_type:  type.IrTypeId;
}

fun do_inline(
    m: *ir.Module,
    counts: *u32,
    caller: *ir.Function,
    call_bi: u32,
    call_ii: u32,
    call_id: id.InstructionId,
    callee_ix: u32,
    callee: *ir.Function
) R.Result[R.Void, str] {
    val res_body: R.Result[R.Void, str] =
        inline_body(m, caller, call_bi, call_ii, call_id, callee, 0xFFFFFFFF, nil, 0, nil);
    if (R.is_err[R.Void, str](res_body)) { ret res_body; }

    counts[callee_ix] = counts[callee_ix] - 1;
    add_fn_call_counts(m, callee, counts);
    ret res_body;
}

fun inline_body(
    m: *ir.Module,
    caller: *ir.Function,
    call_bi: u32,
    call_ii: u32,
    call_id: id.InstructionId,
    callee: *ir.Function,
    harvest_ix: u32,
    harvest_out: *u32,
    harvest_cap: u32,
    harvest_count: *u32
) R.Result[R.Void, str] {
    val opt_call: O.Option[*instruction.Instruction] = ir.instruction_get(caller, call_id);
    if (O.is_none[*instruction.Instruction](opt_call)) {
        ret R.err[R.Void, str]("inline: call id out of range");
    }
    val call: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_call);
    val ret_type: type.IrTypeId = call.ty;

    val call_loc: source.SrcLoc = call.loc;
    val parent_site: u32 = ir.instr_inline_site_of(caller, call_id);

    val arg_count: u32 = call.operand_count - 1;
    var args: *value.Value = nil;
    if (arg_count > 0) {
        val res_args: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, arg_count::usize);
        if (R.is_err[*value.Value, str](res_args)) {
            ret R.err[R.Void, str](R.unwrap_err[*value.Value, str](res_args));
        }
        args = R.unwrap_ok[*value.Value, str](res_args);
        var i: u32 = 0;
        for (i < arg_count) {
            args[i] = call.operands[i + 1];
            i = i + 1;
        }
    }

    var cx: InlineCtx;
    cx.m         = m;
    cx.caller    = caller;
    cx.callee    = callee;
    cx.block_map = nil;
    cx.instr_map = nil;
    cx.args      = args;
    cx.arg_count = arg_count;
    cx.entry_blk = id.BLOCK_NIL;
    cx.cont_blk  = id.BLOCK_NIL;
    cx.ret_type  = ret_type;

    val res_run: R.Result[R.Void, str] = run_inline(?cx, call_bi, call_ii, call_id);

    var res_meta: R.Result[R.Void, str] = R.ok_void[str]();
    if (!R.is_err[R.Void, str](res_run)) {
        res_meta = stamp_inline_metadata(m, ?cx, call_loc, parent_site);
    }

    if (!R.is_err[R.Void, str](res_run) && harvest_ix != 0xFFFFFFFF && harvest_out != nil) {
        harvest_self_calls(?cx, harvest_ix, harvest_out, harvest_cap, harvest_count);
    }

    if (cx.block_map != nil) {
        A.deallocate[u32](m.alloc, cx.block_map, callee.block_count::usize);
    }
    if (cx.instr_map != nil) {
        A.deallocate[u32](m.alloc, cx.instr_map, callee.instr_len::usize);
    }
    if (args != nil) {
        A.deallocate[value.Value](m.alloc, args, arg_count::usize);
    }

    if (R.is_err[R.Void, str](res_run)) { ret res_run; }
    if (R.is_err[R.Void, str](res_meta)) { ret res_meta; }
    ret res_run;
}

fun harvest_self_calls(cx: *InlineCtx, self_ix: u32, out: *u32, cap: u32, count: *u32) {
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val blk: *ir.Block = ?callee.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(callee, iid);
            if (O.is_some[*instruction.Instruction](opt_inst)) {
                val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1 && callee_index(inst) == self_ix) {
                    if (@count < cap) {
                        out[@count] = cx.instr_map[iid::u32];
                        @count = @count + 1;
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun peel_all(m: *ir.Module, out_exhausted: *bool) R.Result[bool, str] {
    if (out_exhausted != nil) { @out_exhausted = false; }
    var changed: bool = false;
    var f_ix: u32 = 0;
    for (f_ix < m.function_len) {
        val fn: *ir.Function = ?m.functions[f_ix];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && peel_eligible(fn, f_ix)) {
            var budget: u32 = PEEL_BUDGET;
            val peeled_r: R.Result[bool, str] = peel_function(m, f_ix, fn, ?budget);
            if (R.is_err[bool, str](peeled_r)) { ret peeled_r; }
            if (R.unwrap_ok[bool, str](peeled_r)) { changed = true; }
            if (budget == 0 && out_exhausted != nil) { @out_exhausted = true; }
        }
        f_ix = f_ix + 1;
    }
    ret R.ok[bool, str](changed);
}

fun peel_eligible(fn: *ir.Function, f_ix: u32) bool {
    if (fn.block_count == 0)                              { ret false; }
    if (callee_instr_count(fn) >= INLINE_INSTR_THRESHOLD) { ret false; }
    ret has_direct_self_call(fn, f_ix);
}

fun has_direct_self_call(fn: *ir.Function, f_ix: u32) bool {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](opt_inst)) {
                val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1 && callee_index(inst) == f_ix) { ret true; }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun collect_self_calls(fn: *ir.Function, f_ix: u32, out: *u32, cap: u32) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val opt_inst: O.Option[*instruction.Instruction] = ir.instruction_get(fn, iid);
            if (O.is_some[*instruction.Instruction](opt_inst)) {
                val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_inst);
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1 && callee_index(inst) == f_ix) {
                    if (n < cap) { out[n] = iid::u32; n = n + 1; }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret n;
}

fun locate_call(fn: *ir.Function, call_id: id.InstructionId, out_bi: *u32, out_ii: *u32) bool {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (blk.instructions[ii] == call_id) {
                @out_bi = i;
                @out_ii = ii;
                ret true;
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun build_snapshot(m: *ir.Module, fn: *ir.Function, snap: *ir.Function) R.Result[R.Void, str] {
    @snap = ir.function_new(m.alloc, fn.name, fn.sig, fn.flags);

    var i: u32 = 0;
    for (i < fn.instr_len) {
        val rc: R.Result[id.InstructionId, str] = mutate.clone_instruction(m, snap, ?fn.instrs[i]);
        if (R.is_err[id.InstructionId, str](rc)) { ret R.err[R.Void, str](R.unwrap_err[id.InstructionId, str](rc)); }
        val rd: R.Result[R.Void, str] = ir.clone_dbg_metadata(m, fn, snap, i::id.InstructionId, i::id.InstructionId);
        if (R.is_err[R.Void, str](rd)) { ret rd; }
        val ra: R.Result[R.Void, str] = ir.clone_asm_payload(m, fn, snap, i::id.InstructionId, i::id.InstructionId, nil, 0);
        if (R.is_err[R.Void, str](ra)) { ret ra; }
        i = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val rb: R.Result[id.BlockId, str] = ir.block_add(m, snap);
        if (R.is_err[id.BlockId, str](rb)) { ret R.err[R.Void, str](R.unwrap_err[id.BlockId, str](rb)); }
        val src: *ir.Block = ?fn.blocks[i];
        val dst: *ir.Block = ?snap.blocks[i];
        var p: u32 = 0;
        for (p < src.phi_count) {
            val rp: R.Result[R.Void, str] = ir.block_append_phi(m, dst, src.phis[p]);
            if (R.is_err[R.Void, str](rp)) { ret rp; }
            p = p + 1;
        }
        var b: u32 = 0;
        for (b < src.instr_count) {
            val ri: R.Result[R.Void, str] = ir.block_append_instr(m, dst, src.instructions[b]);
            if (R.is_err[R.Void, str](ri)) { ret ri; }
            b = b + 1;
        }
        dst.terminator = src.terminator;
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun peel_function(m: *ir.Module, f_ix: u32, fn: *ir.Function, budget: *u32) R.Result[bool, str] {
    var snap: ir.Function;
    val res_snap: R.Result[R.Void, str] = build_snapshot(m, fn, ?snap);
    if (R.is_err[R.Void, str](res_snap)) { ir.function_dnit(m, ?snap); ret R.err[bool, str](R.unwrap_err[R.Void, str](res_snap)); }

    val res_cur: R.Result[*u32, str] = A.allocate[u32](m.alloc, PEEL_FRONTIER_CAP::usize);
    if (R.is_err[*u32, str](res_cur)) { ir.function_dnit(m, ?snap); ret R.err[bool, str](R.unwrap_err[*u32, str](res_cur)); }
    var cur: *u32 = R.unwrap_ok[*u32, str](res_cur);
    val res_nxt: R.Result[*u32, str] = A.allocate[u32](m.alloc, PEEL_FRONTIER_CAP::usize);
    if (R.is_err[*u32, str](res_nxt)) {
        A.deallocate[u32](m.alloc, cur, PEEL_FRONTIER_CAP::usize);
        ir.function_dnit(m, ?snap);
        ret R.err[bool, str](R.unwrap_err[*u32, str](res_nxt));
    }
    var nxt: *u32 = R.unwrap_ok[*u32, str](res_nxt);

    var cur_n: u32 = collect_self_calls(fn, f_ix, cur, PEEL_FRONTIER_CAP);

    var err: R.Result[bool, str] = R.ok[bool, str](true);
    var did_peel: bool = false;
    var level: u32 = 0;
    for (level < PEEL_LEVELS && cur_n > 0 && @budget > 0) {
        if (callee_instr_count(fn) >= INLINE_INSTR_THRESHOLD * (level + 2)) { brk; }

        var nxt_n: u32 = 0;
        var k: u32 = 0;
        for (k < cur_n && @budget > 0) {
            val call_id: id.InstructionId = cur[k]::id.InstructionId;
            var bi: u32 = 0;
            var ii: u32 = 0;
            if (locate_call(fn, call_id, ?bi, ?ii)) {
                val r: R.Result[R.Void, str] =
                    inline_body(m, fn, bi, ii, call_id, ?snap, f_ix, nxt, PEEL_FRONTIER_CAP, ?nxt_n);
                if (R.is_err[R.Void, str](r)) { err = R.err[bool, str](R.unwrap_err[R.Void, str](r)); brk; }
                @budget   = @budget - 1;
                did_peel  = true;
            } or {
                err = R.err[bool, str]("inline: peel self-call site not found");
                brk;
            }
            k = k + 1;
        }
        if (R.is_err[bool, str](err)) { brk; }

        val tmp: *u32 = cur;
        cur   = nxt;
        nxt   = tmp;
        cur_n = nxt_n;
        level = level + 1;
    }

    A.deallocate[u32](m.alloc, cur, PEEL_FRONTIER_CAP::usize);
    A.deallocate[u32](m.alloc, nxt, PEEL_FRONTIER_CAP::usize);
    ir.function_dnit(m, ?snap);
    if (R.is_err[bool, str](err)) { ret err; }
    ret R.ok[bool, str](did_peel);
}

fun stamp_inline_metadata(m: *ir.Module, cx: *InlineCtx, call_loc: source.SrcLoc, parent_site: u32) R.Result[R.Void, str] {
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;

    val rtop: R.Result[u32, str] = ir.inline_site_add(m, caller, callee.name, call_loc, parent_site);
    if (R.is_err[u32, str](rtop)) { ret R.err[R.Void, str](R.unwrap_err[u32, str](rtop)); }
    val top: u32 = R.unwrap_ok[u32, str](rtop);

    var site_map: *u32 = nil;
    val nsite: u32 = callee.inline_site_len;
    if (nsite > 0) {
        val rsm: R.Result[*u32, str] = A.allocate[u32](m.alloc, (nsite + 1)::usize);
        if (R.is_err[*u32, str](rsm)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](rsm)); }
        site_map = R.unwrap_ok[*u32, str](rsm);
        site_map[0] = top;
        var k: u32 = 1;
        for (k <= nsite) {
            val cs: *ir.InlineSite = ?callee.inline_sites[k - 1];
            val rp: R.Result[u32, str] = ir.inline_site_add(m, caller, cs.callee, cs.call_loc, site_map[cs.parent]);
            if (R.is_err[u32, str](rp)) { A.deallocate[u32](m.alloc, site_map, (nsite + 1)::usize); ret R.err[R.Void, str](R.unwrap_err[u32, str](rp)); }
            site_map[k] = R.unwrap_ok[u32, str](rp);
            k = k + 1;
        }
    }

    var i: u32 = 0;
    for (i < callee.instr_len) {
        val cloned_iid: id.InstructionId = cx.instr_map[i]::id.InstructionId;
        var caller_site: u32 = top;
        if (nsite > 0) {
            caller_site = site_map[ir.instr_inline_site_of(callee, i::id.InstructionId)];
        }
        val rs: R.Result[R.Void, str] = ir.instr_inline_site_set(caller, cloned_iid, caller_site);
        if (R.is_err[R.Void, str](rs)) { if (site_map != nil) { A.deallocate[u32](m.alloc, site_map, (nsite + 1)::usize); } ret rs; }
        val rc: R.Result[R.Void, str] = ir.clone_dbg_metadata(m, callee, caller, i::id.InstructionId, cloned_iid);
        if (R.is_err[R.Void, str](rc)) { if (site_map != nil) { A.deallocate[u32](m.alloc, site_map, (nsite + 1)::usize); } ret rc; }
        val ra: R.Result[R.Void, str] = ir.clone_asm_payload(m, callee, caller, i::id.InstructionId, cloned_iid,
                                                          cx.instr_map, callee.instr_len);
        if (R.is_err[R.Void, str](ra)) { if (site_map != nil) { A.deallocate[u32](m.alloc, site_map, (nsite + 1)::usize); } ret ra; }
        val rl: R.Result[R.Void, str] = ir.clone_alloca_dbg_var(callee, caller, i::id.InstructionId, cloned_iid);
        if (R.is_err[R.Void, str](rl)) { if (site_map != nil) { A.deallocate[u32](m.alloc, site_map, (nsite + 1)::usize); } ret rl; }
        i = i + 1;
    }
    if (site_map != nil) { A.deallocate[u32](m.alloc, site_map, (nsite + 1)::usize); }
    ret R.ok_void[str]();
}

fun run_inline(cx: *InlineCtx, call_bi: u32, call_ii: u32, call_id: id.InstructionId) R.Result[R.Void, str] {
    val m: *ir.Module = cx.m;
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;

    if (callee.block_count > 0) {
        val res_block_map: R.Result[*u32, str] = A.allocate[u32](m.alloc, callee.block_count::usize);
        if (R.is_err[*u32, str](res_block_map)) {
            ret R.err[R.Void, str](R.unwrap_err[*u32, str](res_block_map));
        }
        cx.block_map = R.unwrap_ok[*u32, str](res_block_map);
    }
    if (callee.instr_len > 0) {
        val res_instr_map: R.Result[*u32, str] = A.allocate[u32](m.alloc, callee.instr_len::usize);
        if (R.is_err[*u32, str](res_instr_map)) {
            ret R.err[R.Void, str](R.unwrap_err[*u32, str](res_instr_map));
        }
        cx.instr_map = R.unwrap_ok[*u32, str](res_instr_map);
    }

    var i: u32 = 0;
    for (i < callee.block_count) {
        val res_block: R.Result[id.BlockId, str] = ir.block_add(m, caller);
        if (R.is_err[id.BlockId, str](res_block)) {
            ret R.err[R.Void, str](R.unwrap_err[id.BlockId, str](res_block));
        }
        cx.block_map[i] = R.unwrap_ok[id.BlockId, str](res_block)::u32;
        i = i + 1;
    }
    cx.entry_blk = cx.block_map[0]::id.BlockId;

    val res_cont: R.Result[id.BlockId, str] = ir.block_add(m, caller);
    if (R.is_err[id.BlockId, str](res_cont)) {
        ret R.err[R.Void, str](R.unwrap_err[id.BlockId, str](res_cont));
    }
    cx.cont_blk = R.unwrap_ok[id.BlockId, str](res_cont);

    val res_clone: R.Result[R.Void, str] = clone_instructions(cx);
    if (R.is_err[R.Void, str](res_clone)) { ret res_clone; }

    val res_populate: R.Result[R.Void, str] = populate_blocks(cx);
    if (R.is_err[R.Void, str](res_populate)) { ret res_populate; }

    remap_clone_operands(cx);

    val res_split: R.Result[R.Void, str] = split_call_block(cx, call_bi, call_ii);
    if (R.is_err[R.Void, str](res_split)) { ret res_split; }

    val res_returns: R.Result[R.Void, str] = finish_returns(cx, call_id);
    if (R.is_err[R.Void, str](res_returns)) { ret res_returns; }

    ret ir.preds_rebuild(m, caller);
}

fun clone_instructions(cx: *InlineCtx) R.Result[R.Void, str] {
    val m: *ir.Module = cx.m;
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.instr_len) {
        val src: *instruction.Instruction = ?callee.instrs[i];
        val res_id: R.Result[id.InstructionId, str] = mutate.clone_instruction(m, cx.caller, src);
        if (R.is_err[id.InstructionId, str](res_id)) {
            ret R.err[R.Void, str](R.unwrap_err[id.InstructionId, str](res_id));
        }
        cx.instr_map[i] = R.unwrap_ok[id.InstructionId, str](res_id)::u32;
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun populate_blocks(cx: *InlineCtx) R.Result[R.Void, str] {
    val m: *ir.Module = cx.m;
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val src: *ir.Block = ?callee.blocks[i];
        val dst_id: id.BlockId = cx.block_map[i]::id.BlockId;
        val dst: *ir.Block = ?cx.caller.blocks[dst_id::u32];

        var ii: u32 = 0;
        for (ii < src.phi_count) {
            val new_iid: id.InstructionId = cx.instr_map[src.phis[ii]::u32]::id.InstructionId;
            val res_phi: R.Result[R.Void, str] = ir.block_append_phi(m, dst, new_iid);
            if (R.is_err[R.Void, str](res_phi)) { ret res_phi; }
            ii = ii + 1;
        }
        ii = 0;
        for (ii < src.instr_count) {
            val new_iid: id.InstructionId = cx.instr_map[src.instructions[ii]::u32]::id.InstructionId;
            val res_instr: R.Result[R.Void, str] = ir.block_append_instr(m, dst, new_iid);
            if (R.is_err[R.Void, str](res_instr)) { ret res_instr; }
            ii = ii + 1;
        }
        if (src.terminator != id.INSTR_NIL) {
            val new_term: id.InstructionId = cx.instr_map[src.terminator::u32]::id.InstructionId;
            dst.terminator = new_term;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun remap_clone_operands(cx: *InlineCtx) {
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.instr_len) {
        val clone_id: id.InstructionId = cx.instr_map[i]::id.InstructionId;
        val opt_clone: O.Option[*instruction.Instruction] = ir.instruction_get(cx.caller, clone_id);
        if (O.is_none[*instruction.Instruction](opt_clone)) {
            i = i + 1;
            cnt;
        }
        val clone: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_clone);
        var ii: u32 = 0;
        for (ii < clone.operand_count) {
            if (operand_is_block(clone.kind, ii)) {
                val callee_bid: u32 = clone.operands[ii].data.int_lit::u32;
                if (callee_bid < callee.block_count) {
                    clone.operands[ii].data.int_lit = cx.block_map[callee_bid]::u64;
                }
            } or {
                val op: value.Value = clone.operands[ii];
                if (op.kind == value.VAL_PARAM) {
                    val param_ix: u32 = op.data.param_ix;
                    if (param_ix < cx.arg_count) {
                        clone.operands[ii] = mutate.substitute_for_use(cx.args[param_ix], op);
                    }
                } or (op.kind == value.VAL_INSTR) {
                    val callee_iid: u32 = op.data.instr::u32;
                    if (callee_iid < callee.instr_len) {
                        clone.operands[ii].data.instr = cx.instr_map[callee_iid]::id.InstructionId;
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun operand_is_block(k: instruction.InstrKind, o: u32) bool {
    ret refs.operand_is_block(k, o);
}


fun split_call_block(cx: *InlineCtx, call_bi: u32, call_ii: u32) R.Result[R.Void, str] {
    val m: *ir.Module = cx.m;
    val caller: *ir.Function = cx.caller;
    val blk: *ir.Block = ?caller.blocks[call_bi];
    val cont: *ir.Block = ?caller.blocks[cx.cont_blk::u32];

    var i: u32 = call_ii + 1;
    for (i < blk.instr_count) {
        val moved: id.InstructionId = blk.instructions[i];
        val res_move: R.Result[R.Void, str] = ir.block_append_instr(m, cont, moved);
        if (R.is_err[R.Void, str](res_move)) { ret res_move; }
        i = i + 1;
    }
    cont.terminator = blk.terminator;

    rekey_successor_phis(caller, cont, call_bi::id.BlockId, cx.cont_blk);

    blk.instr_count = call_ii;

    val res_br: R.Result[id.InstructionId, str] = emit_br(cx, cx.entry_blk);
    if (R.is_err[id.InstructionId, str](res_br)) {
        ret R.err[R.Void, str](R.unwrap_err[id.InstructionId, str](res_br));
    }
    blk.terminator = R.unwrap_ok[id.InstructionId, str](res_br);

    ret R.ok_void[str]();
}

fun rekey_successor_phis(caller: *ir.Function, cont: *ir.Block, old_blk: id.BlockId, new_blk: id.BlockId) {
    var s0: id.BlockId = id.BLOCK_NIL;
    var s1: id.BlockId = id.BLOCK_NIL;
    val sn: u32 = ir.block_successors(caller, cont, ?s0, ?s1);
    if (sn >= 1)             { rekey_block_phis(caller, s0, old_blk, new_blk); }
    if (sn >= 2 && s1 != s0) { rekey_block_phis(caller, s1, old_blk, new_blk); }
}

fun rekey_block_phis(caller: *ir.Function, bid: id.BlockId, old_blk: id.BlockId, new_blk: id.BlockId) {
    if (bid::u32 >= caller.block_count) { ret; }
    val blk: *ir.Block = ?caller.blocks[bid::u32];
    var i: u32 = 0;
    for (i < blk.phi_count) {
        val opt_phi: O.Option[*instruction.Instruction] = ir.instruction_get(caller, blk.phis[i]);
        if (O.is_some[*instruction.Instruction](opt_phi)) {
            val phi: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_phi);
            if (phi.kind == instruction.OP_PHI) {
                var ii: u32 = 0;
                for (ii + 1 < phi.operand_count) {
                    if (ir.block_target(phi.operands[ii]) == old_blk) {
                        phi.operands[ii].data.int_lit = new_blk::u64;
                    }
                    ii = ii + 2;
                }
            }
        }
        i = i + 1;
    }
}

fun emit_br(cx: *InlineCtx, target_blk: id.BlockId) R.Result[id.InstructionId, str] {
    val m: *ir.Module = cx.m;
    val res_target: R.Result[value.Value, str] = ir.block_target_make(m, target_blk);
    if (R.is_err[value.Value, str](res_target)) {
        ret R.err[id.InstructionId, str](R.unwrap_err[value.Value, str](res_target));
    }
    val res_ops: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, 1::usize);
    if (R.is_err[*value.Value, str](res_ops)) {
        ret R.err[id.InstructionId, str](R.unwrap_err[*value.Value, str](res_ops));
    }
    val ops: *value.Value = R.unwrap_ok[*value.Value, str](res_ops);
    ops[0] = R.unwrap_ok[value.Value, str](res_target);
    val res_void: R.Result[type.IrTypeId, str] = void_ty(m);
    if (R.is_err[type.IrTypeId, str](res_void)) {
        A.deallocate[value.Value](m.alloc, ops, 1::usize);
        ret R.err[id.InstructionId, str](R.unwrap_err[type.IrTypeId, str](res_void));
    }
    var br: instruction.Instruction;
    br.kind          = instruction.OP_BR;
    br.ty            = R.unwrap_ok[type.IrTypeId, str](res_void);
    br.operands      = ops;
    br.operand_count = 1;
    br.flags         = 0;
    br.aux_ty        = type.IRT_NIL;
    br.loc           = source.loc_nil();
    br.secret        = false;
    val res_id: R.Result[id.InstructionId, str] = ir.instruction_add(m, cx.caller, br);
    if (R.is_err[id.InstructionId, str](res_id)) {
        A.deallocate[value.Value](m.alloc, ops, 1::usize);
        ret res_id;
    }
    ret res_id;
}

fun finish_returns(cx: *InlineCtx, call_id: id.InstructionId) R.Result[R.Void, str] {
    val m: *ir.Module = cx.m;
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;
    val res_void: R.Result[type.IrTypeId, str] = void_ty(m);
    if (R.is_err[type.IrTypeId, str](res_void)) {
        ret R.err[R.Void, str](R.unwrap_err[type.IrTypeId, str](res_void));
    }
    val returns_value: bool = cx.ret_type != R.unwrap_ok[type.IrTypeId, str](res_void);

    val value_rets: u32 = count_value_returns(cx, returns_value);
    var phi_id: id.InstructionId = id.INSTR_NIL;
    if (returns_value && value_rets >= 2) {
        var phi: instruction.Instruction;
        phi.kind          = instruction.OP_PHI;
        phi.ty            = cx.ret_type;
        phi.operands      = nil;
        phi.operand_count = 0;
        phi.flags         = 0;
        phi.aux_ty        = type.IRT_NIL;
        phi.loc           = source.loc_nil();
        phi.secret        = false;
        val res_phi: R.Result[id.InstructionId, str] = ir.instruction_add(m, caller, phi);
        if (R.is_err[id.InstructionId, str](res_phi)) {
            ret R.err[R.Void, str](R.unwrap_err[id.InstructionId, str](res_phi));
        }
        phi_id = R.unwrap_ok[id.InstructionId, str](res_phi);
    }

    var single_val: value.Value;
    var have_single: bool = false;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val clone_bid: id.BlockId = cx.block_map[i]::id.BlockId;
        val blk: *ir.Block = ?caller.blocks[clone_bid::u32];
        if (blk.terminator != id.INSTR_NIL) {
            val opt_term: O.Option[*instruction.Instruction] = ir.instruction_get(caller, blk.terminator);
            if (O.is_some[*instruction.Instruction](opt_term)) {
                val term: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_term);
                if (term.kind == instruction.OP_RET) {
                    if (returns_value && term.operand_count >= 1) {
                        if (value_rets == 1) {
                            single_val  = term.operands[0];
                            have_single = true;
                        } or {
                            val res_phi_append: R.Result[R.Void, str] = phi_append(cx, phi_id, clone_bid, term.operands[0]);
                            if (R.is_err[R.Void, str](res_phi_append)) { ret res_phi_append; }
                        }
                    }
                    val res_convert: R.Result[R.Void, str] = convert_ret_to_br(cx, term);
                    if (R.is_err[R.Void, str](res_convert)) { ret res_convert; }
                }
            }
        }
        i = i + 1;
    }

    if (returns_value && value_rets == 1 && have_single) {
        mutate.replace_uses(caller, call_id, single_val);
    } or (returns_value && value_rets >= 2) {
        val cont: *ir.Block = ?caller.blocks[cx.cont_blk::u32];
        val res_append_phi: R.Result[R.Void, str] = ir.block_append_phi(m, cont, phi_id);
        if (R.is_err[R.Void, str](res_append_phi)) { ret res_append_phi; }
        val replacement: value.Value = value.instr(phi_id, cx.ret_type);
        mutate.replace_uses(caller, call_id, replacement);
    }

    ret R.ok_void[str]();
}

fun count_value_returns(cx: *InlineCtx, returns_value: bool) u32 {
    if (returns_value == false) { ret 0; }
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val clone_bid: id.BlockId = cx.block_map[i]::id.BlockId;
        val blk: *ir.Block = ?caller.blocks[clone_bid::u32];
        if (blk.terminator != id.INSTR_NIL) {
            val opt_term: O.Option[*instruction.Instruction] = ir.instruction_get(caller, blk.terminator);
            if (O.is_some[*instruction.Instruction](opt_term)) {
                val term: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_term);
                if (term.kind == instruction.OP_RET && term.operand_count >= 1) {
                    n = n + 1;
                }
            }
        }
        i = i + 1;
    }
    ret n;
}

fun convert_ret_to_br(cx: *InlineCtx, term: *instruction.Instruction) R.Result[R.Void, str] {
    val m: *ir.Module = cx.m;
    val res_target: R.Result[value.Value, str] = ir.block_target_make(m, cx.cont_blk);
    if (R.is_err[value.Value, str](res_target)) {
        ret R.err[R.Void, str](R.unwrap_err[value.Value, str](res_target));
    }
    val res_void: R.Result[type.IrTypeId, str] = void_ty(m);
    if (R.is_err[type.IrTypeId, str](res_void)) {
        ret R.err[R.Void, str](R.unwrap_err[type.IrTypeId, str](res_void));
    }
    val res_ops: R.Result[ir.OperandArray, str] = ir.operands_alloc(m, 1);
    if (R.is_err[ir.OperandArray, str](res_ops)) {
        ret R.err[R.Void, str](R.unwrap_err[ir.OperandArray, str](res_ops));
    }
    val arr: ir.OperandArray = R.unwrap_ok[ir.OperandArray, str](res_ops);
    arr.ops[0] = R.unwrap_ok[value.Value, str](res_target);
    term.kind = instruction.OP_BR;
    term.ty   = R.unwrap_ok[type.IrTypeId, str](res_void);
    ir.instr_replace_operands(m, term, arr);
    ret R.ok_void[str]();
}

fun phi_append(cx: *InlineCtx, phi_id: id.InstructionId, pred: id.BlockId, v: value.Value) R.Result[R.Void, str] {
    val opt_phi: O.Option[*instruction.Instruction] = ir.instruction_get(cx.caller, phi_id);
    if (O.is_none[*instruction.Instruction](opt_phi)) {
        ret R.err[R.Void, str]("inline: phi id out of range");
    }
    ret ir.phi_append_incoming(cx.m, O.unwrap[*instruction.Instruction](opt_phi), pred, v);
}

fun void_ty(m: *ir.Module) R.Result[type.IrTypeId, str] {
    ret type.intern_void(?m.types);
}

test "mach.lang.me.pass.inline.mark_recursive:direct_self_call" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    val res_void: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](res_void)) { ir.dnit(?m); ret 1; }
    val voidty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_void);
    val res_sig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, voidty, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](res_sig)) { ir.dnit(?m); ret 1; }
    val sigty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_sig);
    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sigty, 0);
    if (R.is_err[u32, str](res_fn)) { ir.dnit(?m); ret 1; }

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[0]);

    val res_block: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_block)) { ir.dnit(?m); ret 1; }
    val b0: id.BlockId = R.unwrap_ok[id.BlockId, str](res_block);
    builder.set_block(?bld, b0);

    val callee: value.Value = value.fn(0, sigty);
    val res_call: R.Result[value.Value, str] = builder.emit_call(?bld, callee, nil, 0, voidty);
    if (R.is_err[value.Value, str](res_call))             { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val res_recursive: R.Result[*bool, str] = A.allocate[bool](m.alloc, 1::usize);
    if (R.is_err[*bool, str](res_recursive)) { ir.dnit(?m); ret 1; }
    val recursive: *bool = R.unwrap_ok[*bool, str](res_recursive);
    recursive[0] = false;
    val res_mark: R.Result[R.Void, str] = mark_recursive(?m, recursive);
    if (R.is_err[R.Void, str](res_mark)) {
        A.deallocate[bool](m.alloc, recursive, 1::usize);
        ir.dnit(?m);
        ret 1;
    }

    val is_recursive: bool = recursive[0];
    A.deallocate[bool](m.alloc, recursive, 1::usize);
    ir.dnit(?m);
    if (is_recursive == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.callee_instr_count:dbg_value_blind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);

    val nadd: u32 = 19;
    val kdbg: u32 = 6;

    var bld: builder.Builder = builder.init(?m);

    val res_c: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_c)) { ir.dnit(?m); ret 1; }
    val fn_clean: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_c)];
    builder.set_function(?bld, fn_clean);
    val res_cb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_cb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_cb));
    var ca: value.Value = value.const_int(1, i64t);
    var i: u32 = 0;
    for (i < nadd) {
        val r: R.Result[value.Value, str] = builder.emit_add(?bld, ca, value.const_int(1, i64t));
        if (R.is_err[value.Value, str](r)) { ir.dnit(?m); ret 1; }
        ca = R.unwrap_ok[value.Value, str](r);
        i = i + 1;
    }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val res_l: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_l)) { ir.dnit(?m); ret 1; }
    val fn_laden: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_l)];
    builder.set_function(?bld, fn_laden);
    val res_lb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_lb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_lb));
    var la: value.Value = value.const_int(1, i64t);
    var track: value.Value = la;
    var j: u32 = 0;
    for (j < nadd) {
        val r: R.Result[value.Value, str] = builder.emit_add(?bld, la, value.const_int(1, i64t));
        if (R.is_err[value.Value, str](r)) { ir.dnit(?m); ret 1; }
        la = R.unwrap_ok[value.Value, str](r);
        track = la;
        j = j + 1;
    }
    var d: u32 = 0;
    for (d < kdbg) {
        if (R.is_err[R.Void, str](builder.emit_dbg_value(?bld, track, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0))) { ir.dnit(?m); ret 1; }
        d = d + 1;
    }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val clean: u32 = callee_instr_count(fn_clean);
    val laden: u32 = callee_instr_count(fn_laden);
    ir.dnit(?m);

    if (clean != laden)                        { ret 1; }
    if (!(clean < INLINE_INSTR_THRESHOLD))     { ret 1; }
    if (clean + kdbg < INLINE_INSTR_THRESHOLD) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:preserves_aggregate_param_operand_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val rv: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rv);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    val rp: R.Result[type.IrTypeId, str] = type.intern_ptr(?m.types);
    if (R.is_err[type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rp);
    var fields: [3]type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: R.Result[type.IrTypeId, str] = type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (R.is_err[type.IrTypeId, str](ra)) { ir.dnit(?m); ret 1; }
    val aggt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ra);

    val rsig_a: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, voidty, ?aggt, 1, false);
    if (R.is_err[type.IrTypeId, str](rsig_a)) { ir.dnit(?m); ret 1; }
    val sig_agg: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig_a);
    var pptr: type.IrTypeId = ptrt;
    val rsig_p: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, voidty, ?pptr, 1, false);
    if (R.is_err[type.IrTypeId, str](rsig_p)) { ir.dnit(?m); ret 1; }
    val sig_ptr: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig_p);

    val r_sink: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_agg, ir.FN_FLAG_EXTERN);
    if (R.is_err[u32, str](r_sink)) { ir.dnit(?m); ret 1; }
    val sink_ix: u32 = R.unwrap_ok[u32, str](r_sink);

    var bld: builder.Builder = builder.init(?m);

    val r_f: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_agg, 0);
    if (R.is_err[u32, str](r_f)) { ir.dnit(?m); ret 1; }
    val f_ix: u32 = R.unwrap_ok[u32, str](r_f);
    builder.set_function(?bld, ?m.functions[f_ix]);
    val rfb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rfb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rfb));
    var f_arg: value.Value = value.param(0, aggt);
    val rfc: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(sink_ix, sig_agg), ?f_arg, 1, voidty);
    if (R.is_err[value.Value, str](rfc)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val r_c: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_ptr, 0);
    if (R.is_err[u32, str](r_c)) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = R.unwrap_ok[u32, str](r_c);
    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rcb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rcb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rcb));
    var c_arg: value.Value = value.param(0, ptrt);
    val rcc: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(f_ix, sig_agg), ?c_arg, 1, voidty);
    if (R.is_err[value.Value, str](rcc)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val r_run: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](r_run)) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var bad: i32 = 1;
    var i: u32 = 0;
    for (i < caller_fn.instr_len) {
        val oi: O.Option[*instruction.Instruction] = ir.instruction_get(caller_fn, i::id.InstructionId);
        if (O.is_some[*instruction.Instruction](oi)) {
            val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
            if (ins.kind == instruction.OP_CALL && ins.operand_count >= 2 &&
                ins.operands[1].kind == value.VAL_PARAM) {
                if (ins.operands[1].ty == aggt) { bad = 0; }
                or { bad = 2; }
            }
        }
        i = i + 1;
    }
    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.pass.inline.run:preserves_secret_param_operand" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val rv: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rv);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    val rp: R.Result[type.IrTypeId, str] = type.intern_ptr(?m.types);
    if (R.is_err[type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rp);
    var fields: [3]type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: R.Result[type.IrTypeId, str] = type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (R.is_err[type.IrTypeId, str](ra)) { ir.dnit(?m); ret 1; }
    val aggt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ra);

    val rsig_a: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, voidty, ?aggt, 1, false);
    if (R.is_err[type.IrTypeId, str](rsig_a)) { ir.dnit(?m); ret 1; }
    val sig_agg: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig_a);
    var pptr: type.IrTypeId = ptrt;
    val rsig_p: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, voidty, ?pptr, 1, false);
    if (R.is_err[type.IrTypeId, str](rsig_p)) { ir.dnit(?m); ret 1; }
    val sig_ptr: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig_p);

    val r_sink: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_agg, ir.FN_FLAG_EXTERN);
    if (R.is_err[u32, str](r_sink)) { ir.dnit(?m); ret 1; }
    val sink_ix: u32 = R.unwrap_ok[u32, str](r_sink);

    var bld: builder.Builder = builder.init(?m);

    val r_f: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_agg, 0);
    if (R.is_err[u32, str](r_f)) { ir.dnit(?m); ret 1; }
    val f_ix: u32 = R.unwrap_ok[u32, str](r_f);
    builder.set_function(?bld, ?m.functions[f_ix]);
    val rfb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rfb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rfb));
    var f_arg: value.Value = value.param(0, aggt);
    f_arg.secret = true;
    val rfc: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(sink_ix, sig_agg), ?f_arg, 1, voidty);
    if (R.is_err[value.Value, str](rfc)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val r_c: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_ptr, 0);
    if (R.is_err[u32, str](r_c)) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = R.unwrap_ok[u32, str](r_c);
    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rcb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rcb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rcb));
    var c_arg: value.Value = value.param(0, ptrt);
    val rcc: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(f_ix, sig_agg), ?c_arg, 1, voidty);
    if (R.is_err[value.Value, str](rcc)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val r_run: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](r_run)) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var bad: i32 = 1;
    var i: u32 = 0;
    for (i < caller_fn.instr_len) {
        val oi: O.Option[*instruction.Instruction] = ir.instruction_get(caller_fn, i::id.InstructionId);
        if (O.is_some[*instruction.Instruction](oi)) {
            val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
            if (ins.kind == instruction.OP_CALL && ins.operand_count >= 2 &&
                ins.operands[1].kind == value.VAL_PARAM) {
                if (ins.operands[1].ty == aggt && ins.operands[1].secret) { bad = 0; }
                or { bad = 2; }
            }
        }
        i = i + 1;
    }
    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.pass.inline.run:preserves_aggregate_result_operand_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val rv: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rv);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    val rp: R.Result[type.IrTypeId, str] = type.intern_ptr(?m.types);
    if (R.is_err[type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rp);
    var fields: [3]type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: R.Result[type.IrTypeId, str] = type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (R.is_err[type.IrTypeId, str](ra)) { ir.dnit(?m); ret 1; }
    val aggt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ra);

    var pptr: type.IrTypeId = ptrt;
    val rsig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, ptrt, ?pptr, 1, false);
    if (R.is_err[type.IrTypeId, str](rsig)) { ir.dnit(?m); ret 1; }
    val sig_make: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig);

    var bld: builder.Builder = builder.init(?m);

    val r_make: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_make, 0);
    if (R.is_err[u32, str](r_make)) { ir.dnit(?m); ret 1; }
    val make_ix: u32 = R.unwrap_ok[u32, str](r_make);
    builder.set_function(?bld, ?m.functions[make_ix]);
    val rmb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rmb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rmb));
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, ptrt)))) { ir.dnit(?m); ret 1; }

    val r_c: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_make, 0);
    if (R.is_err[u32, str](r_c)) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = R.unwrap_ok[u32, str](r_c);
    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rcb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rcb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rcb));
    val r_slot: R.Result[value.Value, str] = builder.emit_alloca(?bld, aggt, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](r_slot)) { ir.dnit(?m); ret 1; }
    val slot: value.Value = R.unwrap_ok[value.Value, str](r_slot);
    var c_arg: value.Value = value.param(0, ptrt);
    val r_call: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(make_ix, sig_make), ?c_arg, 1, ptrt);
    if (R.is_err[value.Value, str](r_call)) { ir.dnit(?m); ret 1; }
    val c: value.Value = R.unwrap_ok[value.Value, str](r_call);
    if (R.is_err[R.Void, str](builder.emit_store(?bld, value.retype(c, aggt), slot))) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val r_run: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](r_run)) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var bad: i32 = 1;
    var i: u32 = 0;
    for (i < caller_fn.instr_len) {
        val oi: O.Option[*instruction.Instruction] = ir.instruction_get(caller_fn, i::id.InstructionId);
        if (O.is_some[*instruction.Instruction](oi)) {
            val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
            if (ins.kind == instruction.OP_STORE && ins.operand_count >= 2) {
                if (ins.operands[0].ty == aggt) { bad = 0; }
                or { bad = 2; }
            }
        }
        i = i + 1;
    }
    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.pass.inline.run:preserves_aggregate_result_operand_type_phi" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    val rp: R.Result[type.IrTypeId, str] = type.intern_ptr(?m.types);
    if (R.is_err[type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rp);
    var fields: [3]type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: R.Result[type.IrTypeId, str] = type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (R.is_err[type.IrTypeId, str](ra)) { ir.dnit(?m); ret 1; }
    val aggt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ra);

    var psig: [3]type.IrTypeId;
    psig[0] = i64t; psig[1] = ptrt; psig[2] = ptrt;
    val rsig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, ptrt, ?psig[0], 3, false);
    if (R.is_err[type.IrTypeId, str](rsig)) { ir.dnit(?m); ret 1; }
    val sig_pick: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig);

    var bld: builder.Builder = builder.init(?m);

    val r_pick: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_pick, 0);
    if (R.is_err[u32, str](r_pick)) { ir.dnit(?m); ret 1; }
    val pick_ix: u32 = R.unwrap_ok[u32, str](r_pick);
    builder.set_function(?bld, ?m.functions[pick_ix]);
    val rb0: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb1: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb2: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rb0) || R.is_err[id.BlockId, str](rb1) || R.is_err[id.BlockId, str](rb2)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rb0));
    if (R.is_err[R.Void, str](builder.emit_cbr(?bld, value.param(0, i64t), R.unwrap_ok[id.BlockId, str](rb1), R.unwrap_ok[id.BlockId, str](rb2)))) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rb1));
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(1, ptrt)))) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rb2));
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(2, ptrt)))) { ir.dnit(?m); ret 1; }

    val r_c: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig_pick, 0);
    if (R.is_err[u32, str](r_c)) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = R.unwrap_ok[u32, str](r_c);
    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rcb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rcb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rcb));
    val r_slot: R.Result[value.Value, str] = builder.emit_alloca(?bld, aggt, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](r_slot)) { ir.dnit(?m); ret 1; }
    val slot: value.Value = R.unwrap_ok[value.Value, str](r_slot);
    var args: [3]value.Value;
    args[0] = value.param(0, i64t);
    args[1] = value.param(1, ptrt);
    args[2] = value.param(2, ptrt);
    val r_call: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(pick_ix, sig_pick), ?args[0], 3, ptrt);
    if (R.is_err[value.Value, str](r_call)) { ir.dnit(?m); ret 1; }
    val c: value.Value = R.unwrap_ok[value.Value, str](r_call);
    if (R.is_err[R.Void, str](builder.emit_store(?bld, value.retype(c, aggt), slot))) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val r_run: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](r_run)) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var bad: i32 = 1;
    var i: u32 = 0;
    for (i < caller_fn.instr_len) {
        val oi: O.Option[*instruction.Instruction] = ir.instruction_get(caller_fn, i::id.InstructionId);
        if (O.is_some[*instruction.Instruction](oi)) {
            val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
            if (ins.kind == instruction.OP_STORE && ins.operand_count >= 2) {
                if (ins.operands[0].kind != value.VAL_INSTR) { bad = 3; }
                or {
                    val oref: O.Option[*instruction.Instruction] = ir.instruction_get(caller_fn, ins.operands[0].data.instr);
                    if (O.is_none[*instruction.Instruction](oref)) { bad = 4; }
                    or (O.unwrap[*instruction.Instruction](oref).kind != instruction.OP_PHI) { bad = 5; }
                    or (ins.operands[0].ty != aggt) { bad = 2; }
                    or { bad = 0; }
                }
            }
        }
        i = i + 1;
    }
    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.pass.inline.run:peels_direct_self_recursion" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var pi: type.IrTypeId = i64t;
    val rs: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (R.is_err[type.IrTypeId, str](rs)) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs);

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); ret 1; }
    val fib_ix: u32 = R.unwrap_ok[u32, str](rf);

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[fib_ix]);
    val rb0: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb1: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb2: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rb0) || R.is_err[id.BlockId, str](rb1) || R.is_err[id.BlockId, str](rb2)) { ir.dnit(?m); ret 1; }
    val b0: id.BlockId = R.unwrap_ok[id.BlockId, str](rb0);
    val b1: id.BlockId = R.unwrap_ok[id.BlockId, str](rb1);
    val b2: id.BlockId = R.unwrap_ok[id.BlockId, str](rb2);

    builder.set_block(?bld, b0);
    val rc: R.Result[value.Value, str] = builder.emit_cmp_lt_s(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (R.is_err[value.Value, str](rc)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_cbr(?bld, R.unwrap_ok[value.Value, str](rc), b1, b2))) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, b1);
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, i64t)))) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, b2);
    val rn1: R.Result[value.Value, str] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(1, i64t));
    if (R.is_err[value.Value, str](rn1)) { ir.dnit(?m); ret 1; }
    var a1: value.Value = R.unwrap_ok[value.Value, str](rn1);
    val ra: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a1, 1, i64t);
    if (R.is_err[value.Value, str](ra)) { ir.dnit(?m); ret 1; }
    val rn2: R.Result[value.Value, str] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (R.is_err[value.Value, str](rn2)) { ir.dnit(?m); ret 1; }
    var a2: value.Value = R.unwrap_ok[value.Value, str](rn2);
    val rb: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a2, 1, i64t);
    if (R.is_err[value.Value, str](rb)) { ir.dnit(?m); ret 1; }
    val rsum: R.Result[value.Value, str] = builder.emit_add(?bld, R.unwrap_ok[value.Value, str](ra), R.unwrap_ok[value.Value, str](rb));
    if (R.is_err[value.Value, str](rsum)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, R.unwrap_ok[value.Value, str](rsum)))) { ir.dnit(?m); ret 1; }

    val rr: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](rr)) { ir.dnit(?m); ret 1; }

    val fib_fn: *ir.Function = ?m.functions[fib_ix];
    var selfcalls: u32 = 0;
    var i: u32 = 0;
    for (i < fib_fn.block_count) {
        val blk: *ir.Block = ?fib_fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(fib_fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](oi)) {
                val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                if (ins.kind == instruction.OP_CALL && ins.operand_count >= 1 &&
                    ins.operands[0].kind == value.VAL_FN && ins.operands[0].data.fn_ix == fib_ix) {
                    selfcalls = selfcalls + 1;
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ir.dnit(?m);

    var expected: u32 = 1;
    var e: u32 = 0;
    for (e < PEEL_LEVELS + 1) { expected = expected * 2; e = e + 1; }
    if (selfcalls != expected) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:mutual_recursion_not_peeled" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var pi: type.IrTypeId = i64t;
    val rs: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (R.is_err[type.IrTypeId, str](rs)) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs);

    val rf0: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](rf0)) { ir.dnit(?m); ret 1; }
    val f0: u32 = R.unwrap_ok[u32, str](rf0);
    val rf1: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](rf1)) { ir.dnit(?m); ret 1; }
    val f1: u32 = R.unwrap_ok[u32, str](rf1);

    var bld: builder.Builder = builder.init(?m);

    builder.set_function(?bld, ?m.functions[f0]);
    val r0b: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](r0b)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](r0b));
    var a0: value.Value = value.param(0, i64t);
    val rc0: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(f1, sig), ?a0, 1, i64t);
    if (R.is_err[value.Value, str](rc0)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, R.unwrap_ok[value.Value, str](rc0)))) { ir.dnit(?m); ret 1; }

    builder.set_function(?bld, ?m.functions[f1]);
    val r1b: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](r1b)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](r1b));
    var a1: value.Value = value.param(0, i64t);
    val rc1: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(f0, sig), ?a1, 1, i64t);
    if (R.is_err[value.Value, str](rc1)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, R.unwrap_ok[value.Value, str](rc1)))) { ir.dnit(?m); ret 1; }

    val rr: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](rr)) { ir.dnit(?m); ret 1; }

    var f0_to_f1: u32 = 0;
    var f0_to_f0: u32 = 0;
    var f1_to_f0: u32 = 0;
    var f1_to_f1: u32 = 0;
    var fi: u32 = 0;
    for (fi < 2) {
        val fn: *ir.Function = ?m.functions[fi];
        var i: u32 = 0;
        for (i < fn.block_count) {
            val blk: *ir.Block = ?fn.blocks[i];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val oi: O.Option[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
                if (O.is_some[*instruction.Instruction](oi)) {
                    val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                    if (ins.kind == instruction.OP_CALL && ins.operand_count >= 1 && ins.operands[0].kind == value.VAL_FN) {
                        val cix: u32 = ins.operands[0].data.fn_ix;
                        if (fi == f0 && cix == f1) { f0_to_f1 = f0_to_f1 + 1; }
                        if (fi == f0 && cix == f0) { f0_to_f0 = f0_to_f0 + 1; }
                        if (fi == f1 && cix == f0) { f1_to_f0 = f1_to_f0 + 1; }
                        if (fi == f1 && cix == f1) { f1_to_f1 = f1_to_f1 + 1; }
                    }
                }
                ii = ii + 1;
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    ir.dnit(?m);

    if (f0_to_f1 != 1 || f0_to_f0 != 0) { ret 1; }
    if (f1_to_f0 != 1 || f1_to_f1 != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:small_single_use_callee_inlines_by_default" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var pi: type.IrTypeId = i64t;
    val rs: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (R.is_err[type.IrTypeId, str](rs)) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs);
    val rs0: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rs0)) { ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs0);

    val r_callee: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](r_callee)) { ir.dnit(?m); ret 1; }
    val callee_ix: u32 = R.unwrap_ok[u32, str](r_callee);
    val r_caller: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_caller)) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = R.unwrap_ok[u32, str](r_caller);

    var bld: builder.Builder = builder.init(?m);

