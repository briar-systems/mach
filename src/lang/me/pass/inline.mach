    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var pi: type.IrTypeId = i64t;
    val rs: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (R.is_err[type.IrTypeId, str](rs)) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs);
    val rs0: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rs0)) { ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs0);

    val r_callee: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](r_callee)) { ir.dnit(?m); ret 1; }
    val callee_ix: u32 = R.unwrap_ok[u32, str](r_callee);
    val r_caller: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_caller)) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = R.unwrap_ok[u32, str](r_caller);

    var bld: builder.Builder = builder.init(?m);

    builder.set_function(?bld, ?m.functions[callee_ix]);
    val rcb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rcb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rcb));
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, i64t)))) { ir.dnit(?m); ret 1; }

    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rlb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rlb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rlb));
    var arg: value.Value = value.const_int(7, i64t);
    val rcall: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(callee_ix, sig), ?arg, 1, i64t);
    if (R.is_err[value.Value, str](rcall)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, R.unwrap_ok[value.Value, str](rcall)))) { ir.dnit(?m); ret 1; }

    val rr: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](rr)) { ir.dnit(?m); ret 1; }
    val changed: bool = R.unwrap_ok[bool, str](rr);
    ir.dnit(?m);
    if (changed != true) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:a_later_function_is_not_starved_by_an_earlier_functions_exhaustion" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var pi: type.IrTypeId = i64t;
    val rs: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (R.is_err[type.IrTypeId, str](rs)) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs);
    val rs0: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rs0)) { ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs0);

    val pad_count: u32 = INLINE_BUDGET + 1;
    val res_pads: R.Result[*u32, str] = A.allocate[u32](?alloc, pad_count::usize);
    if (R.is_err[*u32, str](res_pads)) { ir.dnit(?m); ret 1; }
    val pads: *u32 = R.unwrap_ok[*u32, str](res_pads);

    var bld: builder.Builder = builder.init(?m);

    var k: u32 = 0;
    for (k < pad_count) {
        val r_pad: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
        if (R.is_err[u32, str](r_pad)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        val pad_ix: u32 = R.unwrap_ok[u32, str](r_pad);
        pads[k] = pad_ix;

        builder.set_function(?bld, ?m.functions[pad_ix]);
        val rpb: R.Result[id.BlockId, str] = builder.new_block(?bld);
        if (R.is_err[id.BlockId, str](rpb)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rpb));
        if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, i64t)))) {
            A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
        }
        k = k + 1;
    }

    val r_a: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_a)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val a_ix: u32 = R.unwrap_ok[u32, str](r_a);

    builder.set_function(?bld, ?m.functions[a_ix]);
    val rab: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rab)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rab));
    k = 0;
    for (k < pad_count) {
        var arg: value.Value = value.const_int(k::u64, i64t);
        val rcall: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(pads[k], sig), ?arg, 1, i64t);
        if (R.is_err[value.Value, str](rcall)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        k = k + 1;
    }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.const_int(0, i64t)))) {
        A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
    }

    val r_q: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](r_q)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val q_ix: u32 = R.unwrap_ok[u32, str](r_q);
    builder.set_function(?bld, ?m.functions[q_ix]);
    val rqb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rqb)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rqb));
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, i64t)))) {
        A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
    }

    val r_b: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_b)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val b_ix: u32 = R.unwrap_ok[u32, str](r_b);
    builder.set_function(?bld, ?m.functions[b_ix]);
    val rbb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rbb)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rbb));
    var qarg: value.Value = value.const_int(9, i64t);
    val rqcall: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(q_ix, sig), ?qarg, 1, i64t);
    if (R.is_err[value.Value, str](rqcall)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, R.unwrap_ok[value.Value, str](rqcall)))) {
        A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
    }

    val rr: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](rr)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }

    val a_fn: *ir.Function = ?m.functions[a_ix];
    var a_remaining: u32 = 0;
    var bi: u32 = 0;
    for (bi < a_fn.block_count) {
        val blk: *ir.Block = ?a_fn.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(a_fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](oi)) {
                val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                if (ins.kind == instruction.OP_CALL) { a_remaining = a_remaining + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    val b_fn: *ir.Function = ?m.functions[b_ix];
    var b_remaining: u32 = 0;
    bi = 0;
    for (bi < b_fn.block_count) {
        val blk: *ir.Block = ?b_fn.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(b_fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](oi)) {
                val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                if (ins.kind == instruction.OP_CALL) { b_remaining = b_remaining + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    A.deallocate[u32](?alloc, pads, pad_count::usize);
    ir.dnit(?m);

    if (a_remaining != 1) { ret 1; }
    if (b_remaining != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.stamp_inline_metadata:carries_alloca_debug_metadata_into_the_caller" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    val rp: R.Result[type.IrTypeId, str] = type.intern_ptr(?m.types);
    if (R.is_err[type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rp);
    val rs0: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, type.IRT_NIL, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rs0)) { ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs0);

    val r_callee: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_callee)) { ir.dnit(?m); ret 1; }
    val callee_ix: u32 = R.unwrap_ok[u32, str](r_callee);
    val r_caller: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_caller)) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = R.unwrap_ok[u32, str](r_caller);

    var bld: builder.Builder = builder.init(?m);

    builder.set_function(?bld, ?m.functions[callee_ix]);
    val rcb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rcb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rcb));
    val r_alloca: R.Result[value.Value, str] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](r_alloca)) { ir.dnit(?m); ret 1; }
    val alloca_id: id.InstructionId = R.unwrap_ok[value.Value, str](r_alloca).data.instr;
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val callee_fn: *ir.Function = ?m.functions[callee_ix];
    var dv: ir.DbgVar;
    dv.name     = 8181::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 2;
    if (R.is_err[R.Void, str](ir.record_alloca_dbg_var(callee_fn, alloca_id, dv))) { ir.dnit(?m); ret 1; }

    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rlb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rlb)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rlb));
    val rcall: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(callee_ix, sig0), nil, 0, type.IRT_NIL);
    if (R.is_err[value.Value, str](rcall)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val rr: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](rr)) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var found: bool = false;
    var bad: i32 = 0;
    var i: u32 = 0;
    for (i < caller_fn.block_count) {
        val blk: *ir.Block = ?caller_fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(caller_fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](oi)) {
                val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                if (ins.kind == instruction.OP_ALLOCA) {
                    found = true;
                    val opt_dv: O.Option[*ir.DbgVar] = ir.alloca_dbg_var_get(caller_fn, blk.instructions[ii]);
                    if (O.is_none[*ir.DbgVar](opt_dv)) { bad = 1; }
                    or {
                        val cdv: *ir.DbgVar = O.unwrap[*ir.DbgVar](opt_dv);
                        if (cdv.name != 8181::intern.StrId) { bad = 2; }
                        if (cdv.scope != 2)                  { bad = 3; }
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ir.dnit(?m);

    if (!found) { ret 4; }
    ret bad;
}
