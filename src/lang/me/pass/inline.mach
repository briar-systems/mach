    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val rn2: res[value.Value, fail.Fail] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (sel rn2.err) { ir.dnit(?m); ret 1; }
    var a2: value.Value = rn2.ok;
    val rb: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a2, 1, i64t);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val rsum: res[value.Value, fail.Fail] = builder.emit_add(?bld, ra.ok, rb.ok);
    if (sel rsum.err) { ir.dnit(?m); ret 1; }
    val r_2414: err[fail.Fail] = builder.emit_ret(?bld, rsum.ok);
    if (sel r_2414.err) { ir.dnit(?m); ret 1; }

    val pad_count: u32 = INLINE_BUDGET + 1;
    val res_pads: res[*u32, A.Error] = A.allocate[u32](?alloc, pad_count::usize);
