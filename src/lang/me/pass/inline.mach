    val rb0: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb0.err) { ir.dnit(?m); ret 1; }
    if (sel rb1.err) { ir.dnit(?m); ret 1; }
    if (sel rb2.err) { ir.dnit(?m); ret 1; }
    val b0: id.BlockId = rb0.ok;
    val b1: id.BlockId = rb1.ok;
    val b2: id.BlockId = rb2.ok;

    builder.set_block(?bld, b0);
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val r_1690: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, b1, b2);
    if (sel r_1690.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, b1);
    val r_1693: err[fail.Fail] = builder.emit_ret(?bld, value.param(0, i64t));
    if (sel r_1693.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, b2);
    val rn1: res[value.Value, fail.Fail] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(1, i64t));
    if (sel rn1.err) { ir.dnit(?m); ret 1; }
    var a1: value.Value = rn1.ok;
    val ra: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a1, 1, i64t);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val rn2: res[value.Value, fail.Fail] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (sel rn2.err) { ir.dnit(?m); ret 1; }
    var a2: value.Value = rn2.ok;
    val rb: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a2, 1, i64t);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val rsum: res[value.Value, fail.Fail] = builder.emit_add(?bld, ra.ok, rb.ok);
    if (sel rsum.err) { ir.dnit(?m); ret 1; }
    val r_1708: err[fail.Fail] = builder.emit_ret(?bld, rsum.ok);
    if (sel r_1708.err) { ir.dnit(?m); ret 1; }

    val original_instrs: u32 = m.functions[fib_ix].instr_len;
    var blocked_flags: [3]u32 = [3]u32{ ir.FN_FLAG_NOINLINE, ir.FN_FLAG_SCALAR, ir.FN_FLAG_NAKED };
    var flag_ix: u32 = 0;
    for (flag_ix < 3) {
        m.functions[fib_ix].flags = blocked_flags[flag_ix];
        val blocked: res[bool, fail.Fail] = run(?m, nil, nil);
        if (sel blocked.err) { ir.dnit(?m); ret 1; }
        if (blocked.ok) { ir.dnit(?m); ret 1; }
        if (m.functions[fib_ix].instr_len != original_instrs) { ir.dnit(?m); ret 1; }
        if (m.functions[fib_ix].block_count != 3) { ir.dnit(?m); ret 1; }
        flag_ix = flag_ix + 1;
    }
    m.functions[fib_ix].flags = 0;

    val rr: res[bool, fail.Fail] = run(?m, nil, nil);
    if (sel rr.err) { ir.dnit(?m); ret 1; }

    val fib_fn: *ir.Function = ?m.functions[fib_ix];
    var selfcalls: u32 = 0;
    var i: u32 = 0;
    for (i < fib_fn.block_count) {
        val blk: *ir.Block = ?fib_fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(fib_fn, blk.instructions[ii]);
            if (sel oi.some) {
                val ins: *instruction.Instruction = oi.some;
                if (ins.kind == instruction.OP_CALL && ins.operand_count >= 1 &&
                    ins.operands[0].kind == value.VAL_FN && ins.operands[0].data.fn_ix == fib_ix) {
                    selfcalls = selfcalls + 1;
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ir.dnit(?m);

    var expected: u32 = 1;
    var e: u32 = 0;
    for (e < PEEL_LEVELS + 1) { expected = expected * 2; e = e + 1; }
    if (selfcalls != expected) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:mutual_recursion_not_peeled" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    var pi: type.IrTypeId = i64t;
    val rs: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (sel rs.err) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = rs.ok;

    val rf0: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf0.err) { ir.dnit(?m); ret 1; }
    val f0: u32 = rf0.ok;
    val rf1: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf1.err) { ir.dnit(?m); ret 1; }
    val f1: u32 = rf1.ok;

    var bld: builder.Builder = builder.init(?m);

    builder.set_function(?bld, ?m.functions[f0]);
    val r0b: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel r0b.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, r0b.ok);
    var a0: value.Value = value.param(0, i64t);
    val rc0: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(f1, sig), ?a0, 1, i64t);
    if (sel rc0.err) { ir.dnit(?m); ret 1; }
    val r_1786: err[fail.Fail] = builder.emit_ret(?bld, rc0.ok);
    if (sel r_1786.err) { ir.dnit(?m); ret 1; }

    builder.set_function(?bld, ?m.functions[f1]);
    val r1b: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel r1b.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, r1b.ok);
    var a1: value.Value = value.param(0, i64t);
    val rc1: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(f0, sig), ?a1, 1, i64t);
    if (sel rc1.err) { ir.dnit(?m); ret 1; }
    val r_1795: err[fail.Fail] = builder.emit_ret(?bld, rc1.ok);
    if (sel r_1795.err) { ir.dnit(?m); ret 1; }

    val rr: res[bool, fail.Fail] = run(?m, nil, nil);
    if (sel rr.err) { ir.dnit(?m); ret 1; }

    var f0_to_f1: u32 = 0;
    var f0_to_f0: u32 = 0;
    var f1_to_f0: u32 = 0;
    var f1_to_f1: u32 = 0;
    var fi: u32 = 0;
    for (fi < 2) {
        val fn: *ir.Function = ?m.functions[fi];
        var i: u32 = 0;
        for (i < fn.block_count) {
            val blk: *ir.Block = ?fn.blocks[i];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val oi: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
                if (sel oi.some) {
                    val ins: *instruction.Instruction = oi.some;
                    if (ins.kind == instruction.OP_CALL && ins.operand_count >= 1 && ins.operands[0].kind == value.VAL_FN) {
                        val cix: u32 = ins.operands[0].data.fn_ix;
                        if (fi == f0 && cix == f1) { f0_to_f1 = f0_to_f1 + 1; }
                        if (fi == f0 && cix == f0) { f0_to_f0 = f0_to_f0 + 1; }
                        if (fi == f1 && cix == f0) { f1_to_f0 = f1_to_f0 + 1; }
                        if (fi == f1 && cix == f1) { f1_to_f1 = f1_to_f1 + 1; }
                    }
                }
                ii = ii + 1;
            }
            i = i + 1;
        }
        fi = fi + 1;
    }
    ir.dnit(?m);

    if (f0_to_f1 != 1 || f0_to_f0 != 0) { ret 1; }
    if (f1_to_f0 != 1 || f1_to_f1 != 0) { ret 1; }
    ret 0;
}

