use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.body;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.refs;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;
use mach.lang.target;
use semtype: mach.lang.type;

val INLINE_INSTR_THRESHOLD: u32 = body.SMALL_INSTRUCTIONS;

val INLINE_BUDGET: u32 = body.MAX_INSTRUCTIONS;

val INLINE_SMALL_CALLEE_FANOUT_CAP: u32 = 16;

val PEEL_LEVELS: u32 = 2;

val PEEL_FRONTIER_CAP: u32 = 256;

pub rec InlineBudget {
    inline_exhausted: bool;
    peel_exhausted:   bool;
}

rec InlineFacts {
    address_taken: *bool;
    exposed:       *bool;
    len:           u32;
}

fun inline_facts_free(scratch: *A.Allocator, facts: *InlineFacts) {
    if (facts.address_taken != nil && facts.len > 0) {
        A.deallocate[bool](scratch, facts.address_taken, facts.len::usize);
    }
    if (facts.exposed != nil && facts.len > 0) {
        A.deallocate[bool](scratch, facts.exposed, facts.len::usize);
    }
}

fun mark_value_address_taken(v: *value.Value, facts: *InlineFacts) {
    if (v.kind == value.VAL_FN && v.data.fn_ix < facts.len) {
        facts.address_taken[v.data.fn_ix] = true;
    }
}

fun build_inline_facts(m: *ir.Module, scratch: *A.Allocator) res[InlineFacts, fail.Fail] {
    var facts: InlineFacts;
    facts.len = m.function_len;

    val res_at: res[*bool, A.Error] = A.allocate[bool](scratch, m.function_len::usize);
    if (sel res_at.err) { ret res[InlineFacts, fail.Fail].err{fail.refused(res_at.err)}; }
    facts.address_taken = res_at.ok;

    val res_ex: res[*bool, A.Error] = A.allocate[bool](scratch, m.function_len::usize);
    if (sel res_ex.err) {
        A.deallocate[bool](scratch, facts.address_taken, m.function_len::usize);
        ret res[InlineFacts, fail.Fail].err{fail.refused(res_ex.err)};
    }
    facts.exposed = res_ex.ok;

    var i: u32 = 0;
    for (i < m.function_len) {
        facts.address_taken[i] = false;
        val fn: *ir.Function = ?m.functions[i];
        facts.exposed[i] = (fn.flags & (ir.FN_FLAG_PUB | ir.FN_FLAG_WEAK)) != 0;
        i = i + 1;
    }

    i = 0;
    for (i < m.function_len) {
        val fn: *ir.Function = ?m.functions[i];
        var bi: u32 = 0;
        for (bi < fn.block_count) {
            val blk: *ir.Block = ?fn.blocks[bi];
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
                if (sel opt_inst.some) {
                    val inst: *instruction.Instruction = opt_inst.some;
                    var oi: u32 = 0;
                    for (oi < inst.operand_count) {
                        if (inst.kind == instruction.OP_CALL && oi == 0) { oi = oi + 1; cnt; }
                        mark_value_address_taken(?inst.operands[oi], ?facts);
                        oi = oi + 1;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        i = i + 1;
    }

    var gi: u32 = 0;
    for (gi < m.global_len) {
        val g: *ir.Global = ?m.globals[gi];
        mark_value_address_taken(?g.init, ?facts);
        if (g.init.kind == value.VAL_CONST_AGG) {
            var ri: u32 = 0;
            for (ri < g.init.data.agg.reloc_count) {
                val r: *value.AggReloc = ?g.init.data.agg.relocs[ri];
                if (r.is_fn) {
                    val opt_ix: opt[u32] = ir.function_lookup(m, r.symbol);
                    if (sel opt_ix.some) {
                        val ix: u32 = opt_ix.some;
                        if (ix < facts.len) { facts.address_taken[ix] = true; }
                    }
                }
                ri = ri + 1;
            }
        }
        gi = gi + 1;
    }

    ret res[InlineFacts, fail.Fail].ok{facts};
}

pub fun run(m: *ir.Module, tgt: *target.Target, out_report: *InlineBudget) res[bool, fail.Fail] {
    ret run_available(m, tgt, nil, out_report);
}

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run_available(m: *ir.Module, tgt: *target.Target, available: *body.Available, out_report: *InlineBudget) res[bool, fail.Fail] {
    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, tgt, available, out_report, ?workspace);
}

rec InlineWork {
    module:    *ir.Module;
    target:    *target.Target;
    available: *body.Available;
    report:    *InlineBudget;
}

# the analysis (recursion marks, call counts, address-taken facts, duplication
# counts, the per-call remap tables and the peel frontier) is scratch for the
# whole module; the clone itself, its metadata and the peel snapshot are the
# module's
pub fun run_in(m: *ir.Module, tgt: *target.Target, available: *body.Available, out_report: *InlineBudget, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    if (out_report != nil) {
        out_report.inline_exhausted = false;
        out_report.peel_exhausted   = false;
    }
    if (m.function_len == 0) { ret res[bool, fail.Fail].ok{false}; }
    var work: InlineWork = InlineWork{module: m, target: tgt, available: available, report: out_report};
    ret scratch.run[InlineWork, bool](workspace, m.alloc, ?work, inline_module);
}

fun inline_module(work: *InlineWork, scratch_alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = work.module;
    val available: *body.Available = work.available;
    val out_report: *InlineBudget = work.report;

    val res_recursive: res[*bool, A.Error] = A.allocate[bool](scratch_alloc, m.function_len::usize);
    if (sel res_recursive.err) {
        ret res[bool, fail.Fail].err{fail.refused(res_recursive.err)};
    }
    val recursive: *bool = res_recursive.ok;
    val res_mark: err[fail.Fail] = mark_recursive(m, recursive, scratch_alloc);
    if (sel res_mark.err) {
        A.deallocate[bool](scratch_alloc, recursive, m.function_len::usize);
        ret res[bool, fail.Fail].err{res_mark.err};
    }

    val res_counts: res[*u32, A.Error] = A.allocate[u32](scratch_alloc, m.function_len::usize);
    if (sel res_counts.err) {
        A.deallocate[bool](scratch_alloc, recursive, m.function_len::usize);
        ret res[bool, fail.Fail].err{fail.refused(res_counts.err)};
    }
    val counts: *u32 = res_counts.ok;
    build_call_counts(m, counts);

    val res_facts: res[InlineFacts, fail.Fail] = build_inline_facts(m, scratch_alloc);
    if (sel res_facts.err) {
        A.deallocate[u32](scratch_alloc, counts, m.function_len::usize);
        A.deallocate[bool](scratch_alloc, recursive, m.function_len::usize);
        ret res[bool, fail.Fail].err{res_facts.err};
    }
    var facts: InlineFacts = res_facts.ok;

    val res_dup: res[*u32, A.Error] = A.allocate[u32](scratch_alloc, m.function_len::usize);
    if (sel res_dup.err) {
        inline_facts_free(scratch_alloc, ?facts);
        A.deallocate[u32](scratch_alloc, counts, m.function_len::usize);
        A.deallocate[bool](scratch_alloc, recursive, m.function_len::usize);
        ret res[bool, fail.Fail].err{fail.refused(res_dup.err)};
    }
    val dup_count: *u32 = res_dup.ok;
    var di: u32 = 0;
    for (di < m.function_len) { dup_count[di] = 0; di = di + 1; }

    var any_inlined: bool = false;
    var any_exhausted: bool = false;
    var i: u32 = 0;
    for (i < m.function_len) {
        val caller: *ir.Function = ?m.functions[i];
        if ((caller.flags & ir.FN_FLAG_EXTERN) == 0) {
            var budget: body.Budget;
            var progress: bool = true;
            for (progress && budget.instructions < INLINE_BUDGET) {
                val inlined_r: res[bool, fail.Fail] = inline_one_in_fn(m, scratch_alloc, recursive, counts, ?facts, dup_count, caller, available, ?budget, ?any_exhausted);
                if (sel inlined_r.err) {
                    A.deallocate[u32](scratch_alloc, dup_count, m.function_len::usize);
                    inline_facts_free(scratch_alloc, ?facts);
                    A.deallocate[u32](scratch_alloc, counts, m.function_len::usize);
                    A.deallocate[bool](scratch_alloc, recursive, m.function_len::usize);
                    ret inlined_r;
                }
                progress = inlined_r.ok;
                if (progress) { any_inlined = true; }
            }
            if (budget.instructions == INLINE_BUDGET) { any_exhausted = true; }
        }
        i = i + 1;
    }
    if (out_report != nil && any_exhausted) { out_report.inline_exhausted = true; }

    A.deallocate[u32](scratch_alloc, dup_count, m.function_len::usize);
    inline_facts_free(scratch_alloc, ?facts);
    A.deallocate[u32](scratch_alloc, counts, m.function_len::usize);
    A.deallocate[bool](scratch_alloc, recursive, m.function_len::usize);

    var peel_exhausted: bool = false;
    val peeled_r: res[bool, fail.Fail] = peel_all(m, scratch_alloc, ?peel_exhausted);
    if (out_report != nil && peel_exhausted) { out_report.peel_exhausted = true; }
    if (sel peeled_r.err) { ret peeled_r; }
    ret res[bool, fail.Fail].ok{any_inlined || peeled_r.ok};
}

fun inline_one_in_fn(m: *ir.Module, scratch_alloc: *A.Allocator, recursive: *bool, counts: *u32, facts: *InlineFacts, dup_count: *u32, caller: *ir.Function, available: *body.Available, budget: *body.Budget, exhausted: *bool) res[bool, fail.Fail] {
    var i: u32 = 0;
    for (i < caller.block_count) {
        val blk: *ir.Block = ?caller.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(caller, iid);
            if (sel opt_inst.some) {
                val inst: *instruction.Instruction = opt_inst.some;
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1) {
                    val callee_ix: u32 = callee_index(inst);
                    if (callee_ix != 0xFFFFFFFF && callee_ix < m.function_len) {
                        val callee: *ir.Function = ?m.functions[callee_ix];
                        if (should_inline(recursive, counts, facts, dup_count, caller, callee_ix, callee, available)) {
                            var cost: body.Budget;
                            if (!body.growth_cost(callee, ?cost) || !body.charge(budget, cost.instructions, cost.bytes)) {
                                @exhausted = true; ii = ii + 1; cnt;
                            }
                            val res_inline: err[fail.Fail] =
                                do_inline(m, scratch_alloc, counts, caller, i, ii, iid, callee_ix, callee);
                            if (sel res_inline.err) { ret res[bool, fail.Fail].err{res_inline.err}; }
                            dup_count[callee_ix] = dup_count[callee_ix] + 1;
                            ret res[bool, fail.Fail].ok{true};
                        }
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

fun callee_index(call: *instruction.Instruction) u32 {
    val callee: value.Value = call.operands[0];
    if (callee.kind == value.VAL_FN) { ret callee.data.fn_ix; }
    ret 0xFFFFFFFF;
}

fun should_inline(recursive: *bool, counts: *u32, facts: *InlineFacts, dup_count: *u32, caller: *ir.Function, callee_ix: u32, callee: *ir.Function, available: *body.Available) bool {
    if ((callee.flags & ir.FN_FLAG_EXTERN) != 0 && !body.contains(available, callee_ix)) { ret false; }
    if ((callee.flags & ir.FN_FLAG_SCALAR) != 0)             { ret false; }
    if ((callee.flags & ir.FN_FLAG_NOINLINE) != 0)           { ret false; }
    if ((callee.flags & ir.FN_FLAG_NAKED) != 0)              { ret false; }
    # constant-time validation runs per #[oblivious] function, so its instructions stay inside one
    if ((callee.flags & ir.FN_FLAG_OBLIVIOUS) != 0 && (caller.flags & ir.FN_FLAG_OBLIVIOUS) == 0) { ret false; }
    if (recursive[callee_ix])                                { ret false; }
    if (callee.block_count == 0)                             { ret false; }
    if ((callee.flags & ir.FN_FLAG_INLINE) != 0)             { ret true; }

    val single_caller: bool = counts[callee_ix] == 1
        && !facts.address_taken[callee_ix]
        && !facts.exposed[callee_ix] && !body.contains(available, callee_ix);
    if (single_caller) { ret true; }

    if (callee_instr_count(callee) < INLINE_INSTR_THRESHOLD
        && dup_count[callee_ix] < INLINE_SMALL_CALLEE_FANOUT_CAP) { ret true; }
    ret false;
}

fun callee_instr_count(callee: *ir.Function) u32 {
    ret body.live_instructions(callee);
}

fun build_call_counts(m: *ir.Module, counts: *u32) {
    var i: u32 = 0;
    for (i < m.function_len) {
        counts[i] = 0;
        i = i + 1;
    }
    i = 0;
    for (i < m.function_len) {
        add_fn_call_counts(m, ?m.functions[i], counts);
        i = i + 1;
    }
}

fun add_fn_call_counts(m: *ir.Module, fn: *ir.Function, counts: *u32) {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
            if (sel opt_inst.some) {
                val inst: *instruction.Instruction = opt_inst.some;
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1) {
                    val callee_ix: u32 = callee_index(inst);
                    if (callee_ix != 0xFFFFFFFF && callee_ix < m.function_len) {
                        counts[callee_ix] = counts[callee_ix] + 1;
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

rec CallVisit {
    index: u32;
    low: u32;
    block: u32;
    instr: u32;
    active: bool;
    self_call: bool;
}

fun next_callee(m: *ir.Module, fn_ix: u32, visit: *CallVisit) u32 {
    val fn: *ir.Function = ?m.functions[fn_ix];
    for (visit.block < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[visit.block];
        for (visit.instr < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[visit.instr]);
            visit.instr = visit.instr + 1;
            if (sel oi.none) { cnt; }
            val ins: *instruction.Instruction = oi.some;
            if (ins.kind != instruction.OP_CALL || ins.operand_count == 0) { cnt; }
            val callee: u32 = callee_index(ins);
            if (callee < m.function_len) { ret callee; }
        }
        visit.block = visit.block + 1;
        visit.instr = 0;
    }
    ret 0xFFFFFFFF;
}

# the visit state is `scratch`; `recursive` is the caller's
pub fun mark_recursive(m: *ir.Module, recursive: *bool, scratch_alloc: *A.Allocator) err[fail.Fail] {
    val n: u32 = m.function_len;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val rv: res[*CallVisit, A.Error] = A.allocate[CallVisit](scratch_alloc, n::usize);
    if (sel rv.err) { ret err[fail.Fail].err{fail.refused(rv.err)}; }
    val visits: *CallVisit = rv.ok;
    fin { A.deallocate[CallVisit](scratch_alloc, visits, n::usize); }
    val rd: res[*u32, A.Error] = A.allocate[u32](scratch_alloc, n::usize);
    if (sel rd.err) { ret err[fail.Fail].err{fail.refused(rd.err)}; }
    val dfs: *u32 = rd.ok;
    fin { A.deallocate[u32](scratch_alloc, dfs, n::usize); }
    val rs: res[*u32, A.Error] = A.allocate[u32](scratch_alloc, n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    val stack: *u32 = rs.ok;
    fin { A.deallocate[u32](scratch_alloc, stack, n::usize); }

    var i: u32 = 0;
    for (i < n) {
        visits[i] = CallVisit{ index: 0xFFFFFFFF };
        recursive[i] = false;
        i = i + 1;
    }
    var serial: u32 = 0;
    var stack_len: u32 = 0;
    var root: u32 = 0;
    for (root < n) {
        if (visits[root].index != 0xFFFFFFFF) { root = root + 1; cnt; }
        visits[root].index = serial;
        visits[root].low = serial;
        visits[root].active = true;
        serial = serial + 1;
        stack[stack_len] = root;
        stack_len = stack_len + 1;
        dfs[0] = root;
        var depth: u32 = 1;
        for (depth > 0) {
            val current: u32 = dfs[depth - 1];
            val visit: *CallVisit = ?visits[current];
            val child: u32 = next_callee(m, current, visit);
            if (child != 0xFFFFFFFF) {
                if (child == current) { visit.self_call = true; }
                if (visits[child].index == 0xFFFFFFFF) {
                    visits[child].index = serial;
                    visits[child].low = serial;
                    visits[child].active = true;
                    serial = serial + 1;
                    stack[stack_len] = child;
                    stack_len = stack_len + 1;
                    dfs[depth] = child;
                    depth = depth + 1;
                } or (visits[child].active && visits[child].index < visit.low) {
                    visit.low = visits[child].index;
                }
                cnt;
            }
            if (visit.low == visit.index) {
                val end: u32 = stack_len;
                var member: u32 = 0xFFFFFFFF;
                for (member != current) {
                    stack_len = stack_len - 1;
                    member = stack[stack_len];
                    visits[member].active = false;
                }
                val cycle: bool = end - stack_len > 1 || visit.self_call;
                var k: u32 = stack_len;
                for (k < end) { recursive[stack[k]] = cycle; k = k + 1; }
            }
            depth = depth - 1;
            if (depth > 0 && visit.low < visits[dfs[depth - 1]].low) {
                visits[dfs[depth - 1]].low = visit.low;
            }
        }
        root = root + 1;
    }
    ret err[fail.Fail].ok{};
}

rec InlineCtx {
    m:         *ir.Module;
    scratch:   *A.Allocator;
    caller:    *ir.Function;
    callee:    *ir.Function;
    block_map: *u32;
    instr_map: *u32;
    args:      *value.Value;
    arg_count: u32;
    entry_blk: id.BlockId;
    cont_blk:  id.BlockId;
    ret_type:  type.IrTypeId;
}

fun do_inline(
    m: *ir.Module,
    scratch_alloc: *A.Allocator,
    counts: *u32,
    caller: *ir.Function,
    call_bi: u32,
    call_ii: u32,
    call_id: id.InstructionId,
    callee_ix: u32,
    callee: *ir.Function
) err[fail.Fail] {
    val res_body: err[fail.Fail] =
        inline_body(m, scratch_alloc, caller, call_bi, call_ii, call_id, callee, 0xFFFFFFFF, nil, 0, nil);
    if (sel res_body.err) { ret res_body; }

    counts[callee_ix] = counts[callee_ix] - 1;
    add_fn_call_counts(m, callee, counts);
    ret res_body;
}

fun inline_body(
    m: *ir.Module,
    scratch_alloc: *A.Allocator,
    caller: *ir.Function,
    call_bi: u32,
    call_ii: u32,
    call_id: id.InstructionId,
    callee: *ir.Function,
    harvest_ix: u32,
    harvest_out: *u32,
    harvest_cap: u32,
    harvest_count: *u32
) err[fail.Fail] {
    val opt_call: opt[*instruction.Instruction] = ir.instruction_get(caller, call_id);
    if (sel opt_call.none) {
        ret err[fail.Fail].err{fail.message("inline: call id out of range")};
    }
    val call: *instruction.Instruction = opt_call.some;
    val ret_type: type.IrTypeId = call.ty;

    val call_loc: source.SrcLoc = call.loc;
    val parent_site: u32 = ir.instr_inline_site_of(caller, call_id);

    val arg_count: u32 = call.operand_count - 1;
    var args: *value.Value = nil;
    if (arg_count > 0) {
        val res_args: res[*value.Value, A.Error] = A.allocate[value.Value](scratch_alloc, arg_count::usize);
        if (sel res_args.err) {
            ret err[fail.Fail].err{fail.refused(res_args.err)};
        }
        args = res_args.ok;
        var i: u32 = 0;
        for (i < arg_count) {
            args[i] = call.operands[i + 1];
            i = i + 1;
        }
    }

    var cx: InlineCtx;
    cx.m         = m;
    cx.scratch   = scratch_alloc;
    cx.caller    = caller;
    cx.callee    = callee;
    cx.block_map = nil;
    cx.instr_map = nil;
    cx.args      = args;
    cx.arg_count = arg_count;
    cx.entry_blk = id.BLOCK_NIL;
    cx.cont_blk  = id.BLOCK_NIL;
    cx.ret_type  = ret_type;

    val res_run: err[fail.Fail] = run_inline(?cx, call_bi, call_ii, call_id);

    var res_meta: err[fail.Fail] = err[fail.Fail].ok{};
    if (!sel res_run.err) {
        res_meta = stamp_inline_metadata(m, ?cx, call_loc, parent_site);
    }

    if (!sel res_run.err && harvest_ix != 0xFFFFFFFF && harvest_out != nil) {
        harvest_self_calls(?cx, harvest_ix, harvest_out, harvest_cap, harvest_count);
    }

    if (cx.block_map != nil) {
        A.deallocate[u32](scratch_alloc, cx.block_map, callee.block_count::usize);
    }
    if (cx.instr_map != nil) {
        A.deallocate[u32](scratch_alloc, cx.instr_map, callee.instr_len::usize);
    }
    if (args != nil) {
        A.deallocate[value.Value](scratch_alloc, args, arg_count::usize);
    }

    if (sel res_run.err) { ret res_run; }
    if (sel res_meta.err) { ret res_meta; }
    ret res_run;
}

fun harvest_self_calls(cx: *InlineCtx, self_ix: u32, out: *u32, cap: u32, count: *u32) {
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val blk: *ir.Block = ?callee.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(callee, iid);
            if (sel opt_inst.some) {
                val inst: *instruction.Instruction = opt_inst.some;
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1 && callee_index(inst) == self_ix) {
                    if (@count < cap) {
                        out[@count] = cx.instr_map[iid::u32];
                        @count = @count + 1;
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun peel_all(m: *ir.Module, scratch_alloc: *A.Allocator, out_exhausted: *bool) res[bool, fail.Fail] {
    if (out_exhausted != nil) { @out_exhausted = false; }
    var changed: bool = false;
    var f_ix: u32 = 0;
    for (f_ix < m.function_len) {
        val fn: *ir.Function = ?m.functions[f_ix];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && peel_eligible(fn, f_ix)) {
            var budget: body.Budget;
            var exhausted: bool = false;
            val peeled_r: res[bool, fail.Fail] = peel_function(m, scratch_alloc, f_ix, fn, ?budget, ?exhausted);
            if (sel peeled_r.err) { ret peeled_r; }
            if (peeled_r.ok) { changed = true; }
            if (exhausted && out_exhausted != nil) { @out_exhausted = true; }
        }
        f_ix = f_ix + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun peel_eligible(fn: *ir.Function, f_ix: u32) bool {
    if ((fn.flags & (ir.FN_FLAG_NOINLINE | ir.FN_FLAG_SCALAR | ir.FN_FLAG_NAKED)) != 0) { ret false; }
    if (fn.block_count == 0)                              { ret false; }
    if (callee_instr_count(fn) >= INLINE_INSTR_THRESHOLD) { ret false; }
    ret has_direct_self_call(fn, f_ix);
}

fun has_direct_self_call(fn: *ir.Function, f_ix: u32) bool {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[ii]);
            if (sel opt_inst.some) {
                val inst: *instruction.Instruction = opt_inst.some;
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1 && callee_index(inst) == f_ix) { ret true; }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun collect_self_calls(fn: *ir.Function, f_ix: u32, out: *u32, cap: u32) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val opt_inst: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
            if (sel opt_inst.some) {
                val inst: *instruction.Instruction = opt_inst.some;
                if (inst.kind == instruction.OP_CALL && inst.operand_count >= 1 && callee_index(inst) == f_ix) {
                    if (n < cap) { out[n] = iid::u32; n = n + 1; }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret n;
}

fun locate_call(fn: *ir.Function, call_id: id.InstructionId, out_bi: *u32, out_ii: *u32) bool {
    var i: u32 = 0;
    for (i < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (blk.instructions[ii] == call_id) {
                @out_bi = i;
                @out_ii = ii;
                ret true;
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun build_snapshot(m: *ir.Module, fn: *ir.Function, snap: *ir.Function) err[fail.Fail] {
    @snap = ir.function_new(m.alloc, fn.name, fn.sig, fn.flags);
    snap.body_module = fn.body_module;

    var i: u32 = 0;
    for (i < fn.instr_len) {
        val rc: res[id.InstructionId, fail.Fail] = mutate.clone_instruction(m, snap, ?fn.instrs[i]);
        if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
        val rd: err[fail.Fail] = ir.clone_dbg_metadata(m, fn, snap, i::id.InstructionId, i::id.InstructionId);
        if (sel rd.err) { ret rd; }
        val ra: err[fail.Fail] = ir.clone_asm_payload(m, fn, snap, i::id.InstructionId, i::id.InstructionId, nil, 0);
        if (sel ra.err) { ret ra; }
        i = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val rb: res[id.BlockId, fail.Fail] = ir.block_add(m, snap);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        val src: *ir.Block = ?fn.blocks[i];
        val dst: *ir.Block = ?snap.blocks[i];
        var p: u32 = 0;
        for (p < src.phi_count) {
            val rp: err[fail.Fail] = ir.block_append_phi(m, dst, src.phis[p]);
            if (sel rp.err) { ret rp; }
            p = p + 1;
        }
        var b: u32 = 0;
        for (b < src.instr_count) {
            val ri: err[fail.Fail] = ir.block_append_instr(m, dst, src.instructions[b]);
            if (sel ri.err) { ret ri; }
            b = b + 1;
        }
        dst.terminator = src.terminator;
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the snapshot is a function of the module and is released before the return;
# the frontier is scratch
fun peel_function(m: *ir.Module, scratch_alloc: *A.Allocator, f_ix: u32, fn: *ir.Function, budget: *body.Budget, exhausted: *bool) res[bool, fail.Fail] {
    var snap: ir.Function;
    val res_snap: err[fail.Fail] = build_snapshot(m, fn, ?snap);
    if (sel res_snap.err) { ir.function_dnit(m, ?snap); ret res[bool, fail.Fail].err{res_snap.err}; }

    val res_cur: res[*u32, A.Error] = A.allocate[u32](scratch_alloc, PEEL_FRONTIER_CAP::usize);
    if (sel res_cur.err) { ir.function_dnit(m, ?snap); ret res[bool, fail.Fail].err{fail.refused(res_cur.err)}; }
    var cur: *u32 = res_cur.ok;
    val res_nxt: res[*u32, A.Error] = A.allocate[u32](scratch_alloc, PEEL_FRONTIER_CAP::usize);
    if (sel res_nxt.err) {
        A.deallocate[u32](scratch_alloc, cur, PEEL_FRONTIER_CAP::usize);
        ir.function_dnit(m, ?snap);
        ret res[bool, fail.Fail].err{fail.refused(res_nxt.err)};
    }
    var nxt: *u32 = res_nxt.ok;

    var cur_n: u32 = collect_self_calls(fn, f_ix, cur, PEEL_FRONTIER_CAP);

    var err_: res[bool, fail.Fail] = res[bool, fail.Fail].ok{true};
    var did_peel: bool = false;
    var level: u32 = 0;
    for (level < PEEL_LEVELS && cur_n > 0 && !@exhausted) {
        if (callee_instr_count(fn) >= INLINE_INSTR_THRESHOLD * (level + 2)) { brk; }

        var nxt_n: u32 = 0;
        var k: u32 = 0;
        for (k < cur_n && !@exhausted) {
            val call_id: id.InstructionId = cur[k]::id.InstructionId;
            var bi: u32 = 0;
            var ii: u32 = 0;
            if (locate_call(fn, call_id, ?bi, ?ii)) {
                var cost: body.Budget;
                if (!body.growth_cost(?snap, ?cost) || !body.charge(budget, cost.instructions, cost.bytes)) {
                    @exhausted = true; brk;
                }
                val r: err[fail.Fail] =
                    inline_body(m, scratch_alloc, fn, bi, ii, call_id, ?snap, f_ix, nxt, PEEL_FRONTIER_CAP, ?nxt_n);
                if (sel r.err) { err_ = res[bool, fail.Fail].err{r.err}; brk; }
                did_peel  = true;
            } or {
                err_ = res[bool, fail.Fail].err{fail.message("inline: peel self-call site not found")};
                brk;
            }
            k = k + 1;
        }
        if (sel err_.err) { brk; }

        val tmp: *u32 = cur;
        cur   = nxt;
        nxt   = tmp;
        cur_n = nxt_n;
        level = level + 1;
    }

    A.deallocate[u32](scratch_alloc, cur, PEEL_FRONTIER_CAP::usize);
    A.deallocate[u32](scratch_alloc, nxt, PEEL_FRONTIER_CAP::usize);
    ir.function_dnit(m, ?snap);
    if (sel err_.err) { ret err_; }
    ret res[bool, fail.Fail].ok{did_peel};
}

fun stamp_inline_metadata(m: *ir.Module, cx: *InlineCtx, call_loc: source.SrcLoc, parent_site: u32) err[fail.Fail] {
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;

    val rtop: res[u32, fail.Fail] = ir.inline_site_add(m, caller, callee.name, call_loc, parent_site);
    if (sel rtop.err) { ret err[fail.Fail].err{rtop.err}; }
    val top: u32 = rtop.ok;

    var site_map: *u32 = nil;
    val nsite: u32 = callee.inline_site_len;
    if (nsite > 0) {
        val rsm: res[*u32, A.Error] = A.allocate[u32](cx.scratch, (nsite + 1)::usize);
        if (sel rsm.err) { ret err[fail.Fail].err{fail.refused(rsm.err)}; }
        site_map = rsm.ok;
        site_map[0] = top;
        var k: u32 = 1;
        for (k <= nsite) {
            val cs: *ir.InlineSite = ?callee.inline_sites[k - 1];
            val rp: res[u32, fail.Fail] = ir.inline_site_add(m, caller, cs.callee, cs.call_loc, site_map[cs.parent]);
            if (sel rp.err) { A.deallocate[u32](cx.scratch, site_map, (nsite + 1)::usize); ret err[fail.Fail].err{rp.err}; }
            site_map[k] = rp.ok;
            k = k + 1;
        }
    }

    var i: u32 = 0;
    for (i < callee.instr_len) {
        val cloned_iid: id.InstructionId = cx.instr_map[i]::id.InstructionId;
        var caller_site: u32 = top;
        if (nsite > 0) {
            caller_site = site_map[ir.instr_inline_site_of(callee, i::id.InstructionId)];
        }
        val rs: err[fail.Fail] = ir.instr_inline_site_set(caller, cloned_iid, caller_site);
        if (sel rs.err) { if (site_map != nil) { A.deallocate[u32](cx.scratch, site_map, (nsite + 1)::usize); } ret rs; }
        val rc: err[fail.Fail] = ir.clone_dbg_metadata(m, callee, caller, i::id.InstructionId, cloned_iid);
        if (sel rc.err) { if (site_map != nil) { A.deallocate[u32](cx.scratch, site_map, (nsite + 1)::usize); } ret rc; }
        val ra: err[fail.Fail] = ir.clone_asm_payload(m, callee, caller, i::id.InstructionId, cloned_iid,
                                                          cx.instr_map, callee.instr_len);
        if (sel ra.err) { if (site_map != nil) { A.deallocate[u32](cx.scratch, site_map, (nsite + 1)::usize); } ret ra; }
        val rl: err[fail.Fail] = ir.clone_alloca_dbg_var(callee, caller, i::id.InstructionId, cloned_iid);
        if (sel rl.err) { if (site_map != nil) { A.deallocate[u32](cx.scratch, site_map, (nsite + 1)::usize); } ret rl; }
        i = i + 1;
    }
    if (site_map != nil) { A.deallocate[u32](cx.scratch, site_map, (nsite + 1)::usize); }
    ret err[fail.Fail].ok{};
}

fun run_inline(cx: *InlineCtx, call_bi: u32, call_ii: u32, call_id: id.InstructionId) err[fail.Fail] {
    val m: *ir.Module = cx.m;
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;

    if (callee.block_count > 0) {
        val res_block_map: res[*u32, A.Error] = A.allocate[u32](cx.scratch, callee.block_count::usize);
        if (sel res_block_map.err) {
            ret err[fail.Fail].err{fail.refused(res_block_map.err)};
        }
        cx.block_map = res_block_map.ok;
    }
    if (callee.instr_len > 0) {
        val res_instr_map: res[*u32, A.Error] = A.allocate[u32](cx.scratch, callee.instr_len::usize);
        if (sel res_instr_map.err) {
            ret err[fail.Fail].err{fail.refused(res_instr_map.err)};
        }
        cx.instr_map = res_instr_map.ok;
    }

    var i: u32 = 0;
    for (i < callee.block_count) {
        val res_block: res[id.BlockId, fail.Fail] = ir.block_add(m, caller);
        if (sel res_block.err) {
            ret err[fail.Fail].err{res_block.err};
        }
        cx.block_map[i] = res_block.ok::u32;
        i = i + 1;
    }
    cx.entry_blk = cx.block_map[0]::id.BlockId;

    val res_cont: res[id.BlockId, fail.Fail] = ir.block_add(m, caller);
    if (sel res_cont.err) {
        ret err[fail.Fail].err{res_cont.err};
    }
    cx.cont_blk = res_cont.ok;

    val res_clone: err[fail.Fail] = clone_instructions(cx);
    if (sel res_clone.err) { ret res_clone; }

    val res_populate: err[fail.Fail] = populate_blocks(cx);
    if (sel res_populate.err) { ret res_populate; }

    remap_clone_operands(cx);

    val res_split: err[fail.Fail] = split_call_block(cx, call_bi, call_ii);
    if (sel res_split.err) { ret res_split; }

    val res_returns: err[fail.Fail] = finish_returns(cx, call_id);
    if (sel res_returns.err) { ret res_returns; }

    ret ir.preds_rebuild(m, caller);
}

fun clone_instructions(cx: *InlineCtx) err[fail.Fail] {
    val m: *ir.Module = cx.m;
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.instr_len) {
        val src: *instruction.Instruction = ?callee.instrs[i];
        val res_id: res[id.InstructionId, fail.Fail] = mutate.clone_instruction(m, cx.caller, src);
        if (sel res_id.err) {
            ret err[fail.Fail].err{res_id.err};
        }
        cx.instr_map[i] = res_id.ok::u32;
        if ((callee.flags & ir.FN_FLAG_EXTERN) != 0) {
            val cloned: *instruction.Instruction = ?cx.caller.instrs[cx.instr_map[i]];
            var oi: u32 = 0;
            for (oi < cloned.operand_count) {
                val owned: res[value.Value, fail.Fail] = body.own_constant(m.alloc, cloned.operands[oi]);
                if (sel owned.err) { ret err[fail.Fail].err{owned.err}; }
                cloned.operands[oi] = owned.ok; oi = oi + 1;
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun populate_blocks(cx: *InlineCtx) err[fail.Fail] {
    val m: *ir.Module = cx.m;
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val src: *ir.Block = ?callee.blocks[i];
        val dst_id: id.BlockId = cx.block_map[i]::id.BlockId;
        val dst: *ir.Block = ?cx.caller.blocks[dst_id::u32];

        var ii: u32 = 0;
        for (ii < src.phi_count) {
            val new_iid: id.InstructionId = cx.instr_map[src.phis[ii]::u32]::id.InstructionId;
            val res_phi: err[fail.Fail] = ir.block_append_phi(m, dst, new_iid);
            if (sel res_phi.err) { ret res_phi; }
            ii = ii + 1;
        }
        ii = 0;
        for (ii < src.instr_count) {
            val new_iid: id.InstructionId = cx.instr_map[src.instructions[ii]::u32]::id.InstructionId;
            val res_instr: err[fail.Fail] = ir.block_append_instr(m, dst, new_iid);
            if (sel res_instr.err) { ret res_instr; }
            ii = ii + 1;
        }
        if (src.terminator != id.INSTR_NIL) {
            val new_term: id.InstructionId = cx.instr_map[src.terminator::u32]::id.InstructionId;
            dst.terminator = new_term;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun remap_clone_operands(cx: *InlineCtx) {
    val callee: *ir.Function = cx.callee;
    var i: u32 = 0;
    for (i < callee.instr_len) {
        val clone_id: id.InstructionId = cx.instr_map[i]::id.InstructionId;
        val opt_clone: opt[*instruction.Instruction] = ir.instruction_get(cx.caller, clone_id);
        if (sel opt_clone.none) {
            i = i + 1;
            cnt;
        }
        val clone: *instruction.Instruction = opt_clone.some;
        var ii: u32 = 0;
        for (ii < clone.operand_count) {
            if (operand_is_block(clone.kind, ii)) {
                val callee_bid: u32 = clone.operands[ii].data.int_lit::u32;
                if (callee_bid < callee.block_count) {
                    clone.operands[ii].data.int_lit = cx.block_map[callee_bid]::u64;
                }
            } or {
                val op: value.Value = clone.operands[ii];
                if (op.kind == value.VAL_PARAM) {
                    val param_ix: u32 = op.data.param_ix;
                    if (param_ix < cx.arg_count) {
                        clone.operands[ii] = mutate.substitute_for_use(cx.args[param_ix], op);
                    }
                } or (op.kind == value.VAL_INSTR) {
                    val callee_iid: u32 = op.data.instr::u32;
                    if (callee_iid < callee.instr_len) {
                        clone.operands[ii].data.instr = cx.instr_map[callee_iid]::id.InstructionId;
                    }
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

fun operand_is_block(k: instruction.InstrKind, o: u32) bool {
    ret refs.operand_is_block(k, o);
}


fun split_call_block(cx: *InlineCtx, call_bi: u32, call_ii: u32) err[fail.Fail] {
    val m: *ir.Module = cx.m;
    val caller: *ir.Function = cx.caller;
    val blk: *ir.Block = ?caller.blocks[call_bi];
    val cont: *ir.Block = ?caller.blocks[cx.cont_blk::u32];

    var i: u32 = call_ii + 1;
    for (i < blk.instr_count) {
        val moved: id.InstructionId = blk.instructions[i];
        val res_move: err[fail.Fail] = ir.block_append_instr(m, cont, moved);
        if (sel res_move.err) { ret res_move; }
        i = i + 1;
    }
    cont.terminator = blk.terminator;

    rekey_successor_phis(caller, cont, call_bi::id.BlockId, cx.cont_blk);

    blk.instr_count = call_ii;

    val res_br: res[id.InstructionId, fail.Fail] = emit_br(cx, cx.entry_blk);
    if (sel res_br.err) {
        ret err[fail.Fail].err{res_br.err};
    }
    blk.terminator = res_br.ok;

    ret err[fail.Fail].ok{};
}

fun rekey_successor_phis(caller: *ir.Function, cont: *ir.Block, old_blk: id.BlockId, new_blk: id.BlockId) {
    var s0: id.BlockId = id.BLOCK_NIL;
    var s1: id.BlockId = id.BLOCK_NIL;
    val sn: u32 = ir.block_successors(caller, cont, ?s0, ?s1);
    if (sn >= 1)             { rekey_block_phis(caller, s0, old_blk, new_blk); }
    if (sn >= 2 && s1 != s0) { rekey_block_phis(caller, s1, old_blk, new_blk); }
}

fun rekey_block_phis(caller: *ir.Function, bid: id.BlockId, old_blk: id.BlockId, new_blk: id.BlockId) {
    if (bid::u32 >= caller.block_count) { ret; }
    val blk: *ir.Block = ?caller.blocks[bid::u32];
    var i: u32 = 0;
    for (i < blk.phi_count) {
        val opt_phi: opt[*instruction.Instruction] = ir.instruction_get(caller, blk.phis[i]);
        if (sel opt_phi.some) {
            val phi: *instruction.Instruction = opt_phi.some;
            if (phi.kind == instruction.OP_PHI) {
                var ii: u32 = 0;
                for (ii + 1 < phi.operand_count) {
                    if (ir.block_target(phi.operands[ii]) == old_blk) {
                        phi.operands[ii].data.int_lit = new_blk::u64;
                    }
                    ii = ii + 2;
                }
            }
        }
        i = i + 1;
    }
}

fun emit_br(cx: *InlineCtx, target_blk: id.BlockId) res[id.InstructionId, fail.Fail] {
    val m: *ir.Module = cx.m;
    val res_target: res[value.Value, fail.Fail] = ir.block_target_make(m, target_blk);
    if (sel res_target.err) {
        ret res[id.InstructionId, fail.Fail].err{res_target.err};
    }
    val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, 1::usize);
    if (sel res_ops.err) {
        ret res[id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *value.Value = res_ops.ok;
    ops[0] = res_target.ok;
    val res_void: res[type.IrTypeId, fail.Fail] = void_ty(m);
    if (sel res_void.err) {
        A.deallocate[value.Value](m.alloc, ops, 1::usize);
        ret res[id.InstructionId, fail.Fail].err{res_void.err};
    }
    var br: instruction.Instruction;
    br.kind          = instruction.OP_BR;
    br.ty            = res_void.ok;
    br.operands      = ops;
    br.operand_count = 1;
    br.operand_cap   = 1;
    br.flags         = 0;
    br.aux_ty        = type.IRT_NIL;
    br.loc           = source.loc_nil();
    br.secret        = false;
    val res_id: res[id.InstructionId, fail.Fail] = ir.instruction_add(m, cx.caller, br);
    if (sel res_id.err) {
        A.deallocate[value.Value](m.alloc, ops, 1::usize);
        ret res_id;
    }
    ret res_id;
}

fun finish_returns(cx: *InlineCtx, call_id: id.InstructionId) err[fail.Fail] {
    val m: *ir.Module = cx.m;
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;
    val res_void: res[type.IrTypeId, fail.Fail] = void_ty(m);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val returns_value: bool = cx.ret_type != res_void.ok;

    val value_rets: u32 = count_value_returns(cx, returns_value);
    var phi_id: id.InstructionId = id.INSTR_NIL;
    if (returns_value && value_rets >= 2) {
        var phi: instruction.Instruction;
        phi.kind          = instruction.OP_PHI;
        phi.ty            = cx.ret_type;
        phi.operands      = nil;
        phi.operand_count = 0;
        phi.flags         = 0;
        phi.aux_ty        = type.IRT_NIL;
        phi.loc           = source.loc_nil();
        phi.secret        = false;
        val res_phi: res[id.InstructionId, fail.Fail] = ir.instruction_add(m, caller, phi);
        if (sel res_phi.err) {
            ret err[fail.Fail].err{res_phi.err};
        }
        phi_id = res_phi.ok;
    }

    var single_val: value.Value;
    var have_single: bool = false;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val clone_bid: id.BlockId = cx.block_map[i]::id.BlockId;
        val blk: *ir.Block = ?caller.blocks[clone_bid::u32];
        if (blk.terminator != id.INSTR_NIL) {
            val opt_term: opt[*instruction.Instruction] = ir.instruction_get(caller, blk.terminator);
            if (sel opt_term.some) {
                val term: *instruction.Instruction = opt_term.some;
                if (term.kind == instruction.OP_RET) {
                    if (returns_value && term.operand_count >= 1) {
                        if (value_rets == 1) {
                            single_val  = term.operands[0];
                            have_single = true;
                        } or {
                            val res_phi_append: err[fail.Fail] = phi_append(cx, phi_id, clone_bid, term.operands[0]);
                            if (sel res_phi_append.err) { ret res_phi_append; }
                        }
                    }
                    val res_convert: err[fail.Fail] = convert_ret_to_br(cx, term);
                    if (sel res_convert.err) { ret res_convert; }
                }
            }
        }
        i = i + 1;
    }

    if (returns_value && value_rets == 1 && have_single) {
        mutate.replace_uses(caller, call_id, single_val);
    } or (returns_value && value_rets >= 2) {
        val cont: *ir.Block = ?caller.blocks[cx.cont_blk::u32];
        val res_append_phi: err[fail.Fail] = ir.block_append_phi(m, cont, phi_id);
        if (sel res_append_phi.err) { ret res_append_phi; }
        val replacement: value.Value = value.instr(phi_id, cx.ret_type);
        mutate.replace_uses(caller, call_id, replacement);
    }

    ret err[fail.Fail].ok{};
}

fun count_value_returns(cx: *InlineCtx, returns_value: bool) u32 {
    if (returns_value == false) { ret 0; }
    val caller: *ir.Function = cx.caller;
    val callee: *ir.Function = cx.callee;
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < callee.block_count) {
        val clone_bid: id.BlockId = cx.block_map[i]::id.BlockId;
        val blk: *ir.Block = ?caller.blocks[clone_bid::u32];
        if (blk.terminator != id.INSTR_NIL) {
            val opt_term: opt[*instruction.Instruction] = ir.instruction_get(caller, blk.terminator);
            if (sel opt_term.some) {
                val term: *instruction.Instruction = opt_term.some;
                if (term.kind == instruction.OP_RET && term.operand_count >= 1) {
                    n = n + 1;
                }
            }
        }
        i = i + 1;
    }
    ret n;
}

fun convert_ret_to_br(cx: *InlineCtx, term: *instruction.Instruction) err[fail.Fail] {
    val m: *ir.Module = cx.m;
    val res_target: res[value.Value, fail.Fail] = ir.block_target_make(m, cx.cont_blk);
    if (sel res_target.err) {
        ret err[fail.Fail].err{res_target.err};
    }
    val res_void: res[type.IrTypeId, fail.Fail] = void_ty(m);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val res_ops: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(m, 1);
    if (sel res_ops.err) {
        ret err[fail.Fail].err{res_ops.err};
    }
    val arr: ir.OperandArray = res_ops.ok;
    arr.ops[0] = res_target.ok;
    term.kind = instruction.OP_BR;
    term.ty   = res_void.ok;
    ir.instr_replace_operands(m, term, arr);
    ret err[fail.Fail].ok{};
}

fun phi_append(cx: *InlineCtx, phi_id: id.InstructionId, pred: id.BlockId, v: value.Value) err[fail.Fail] {
    val opt_phi: opt[*instruction.Instruction] = ir.instruction_get(cx.caller, phi_id);
    if (sel opt_phi.none) {
        ret err[fail.Fail].err{fail.message("inline: phi id out of range")};
    }
    ret ir.phi_append_incoming(cx.m, opt_phi.some, pred, v);
}

fun void_ty(m: *ir.Module) res[type.IrTypeId, fail.Fail] {
    ret type.intern_void(?m.types);
}

test "mach.lang.me.pass.inline.mark_recursive:direct_self_call" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;

    val res_void: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel res_void.err) { ir.dnit(?m); ret 1; }
    val voidty: type.IrTypeId = res_void.ok;
    val res_sig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel res_sig.err) { ir.dnit(?m); ret 1; }
    val sigty: type.IrTypeId = res_sig.ok;
    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sigty, 0);
    if (sel res_fn.err) { ir.dnit(?m); ret 1; }

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[0]);

    val res_block: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_block.err) { ir.dnit(?m); ret 1; }
    val b0: id.BlockId = res_block.ok;
    builder.set_block(?bld, b0);

    val callee: value.Value = value.fn(0, sigty);
    val res_call: res[value.Value, fail.Fail] = builder.emit_call(?bld, callee, nil, 0, voidty);
    if (sel res_call.err)             { ir.dnit(?m); ret 1; }
    val r_1189: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1189.err) { ir.dnit(?m); ret 1; }

    val res_recursive: res[*bool, A.Error] = A.allocate[bool](m.alloc, 1::usize);
    if (sel res_recursive.err) { ir.dnit(?m); ret 1; }
    val recursive: *bool = res_recursive.ok;
    recursive[0] = false;
    val res_mark: err[fail.Fail] = mark_recursive(?m, recursive, ?alloc);
    if (sel res_mark.err) {
        A.deallocate[bool](m.alloc, recursive, 1::usize);
        ir.dnit(?m);
        ret 1;
    }

    val is_recursive: bool = recursive[0];
    A.deallocate[bool](m.alloc, recursive, 1::usize);
    ir.dnit(?m);
    if (is_recursive == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.mark_recursive:cycles_exclude_callers_and_completed_components" {
    var alloc: A.Allocator;
    val r_1211: err[A.Error] = page.make(?alloc);
    if (sel r_1211.err) { ret 1; }
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    fin { ir.dnit(?m); }
    val rv: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel rv.err) { ret 1; }
    val vt: type.IrTypeId = rv.ok;
    val rs: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, vt, nil, 0, false);
    if (sel rs.err) { ret 1; }
    val sig: type.IrTypeId = rs.ok;
    var i: u32 = 0;
    for (i < 64) {
        val r_1224: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
        if (sel r_1224.err) { ret 1; }
        i = i + 1;
    }
    var b: builder.Builder = builder.init(?m);
    i = 0;
    for (i < 64) {
        builder.set_function(?b, ?m.functions[i]);
        val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel rb.err) { ret 1; }
        builder.set_block(?b, rb.ok);
        var callee: u32 = 0xFFFFFFFF;
        if (i < 29) { callee = i + 1; }
        if (i == 12) { callee = 9; }
        if (i == 30) { callee = 31; }
        if (i == 31 || i == 33) { callee = 30; }
        if (i == 32) { callee = 32; }
        if (callee != 0xFFFFFFFF) {
            val r_1241: res[value.Value, fail.Fail] = builder.emit_call(?b, value.fn(callee, sig), nil, 0, vt);
            if (sel r_1241.err) { ret 1; }
        }
        val r_1243: err[fail.Fail] = builder.emit_ret_void(?b);
        if (sel r_1243.err) { ret 1; }
        i = i + 1;
    }
    var recursive: [64]bool;
    val r_1247: err[fail.Fail] = mark_recursive(?m, ?recursive[0], ?alloc);
    if (sel r_1247.err) { ret 1; }
    i = 0;
    for (i < 64) {
        val expected: bool = (i >= 9 && i <= 12) || (i >= 30 && i <= 32);
        if (recursive[i] != expected) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

test "mach.lang.me.pass.inline.callee_instr_count:dbg_value_blind" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = res_i64.ok;

    val nadd: u32 = 19;
    val kdbg: u32 = 6;

    var bld: builder.Builder = builder.init(?m);

    val res_c: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_c.err) { ir.dnit(?m); ret 1; }
    val fn_clean: *ir.Function = ?m.functions[res_c.ok];
    builder.set_function(?bld, fn_clean);
    val res_cb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_cb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_cb.ok);
    var ca: value.Value = value.const_int(1, i64t);
    var i: u32 = 0;
    for (i < nadd) {
        val r: res[value.Value, fail.Fail] = builder.emit_add(?bld, ca, value.const_int(1, i64t));
        if (sel r.err) { ir.dnit(?m); ret 1; }
        ca = r.ok;
        i = i + 1;
    }
    val r_1288: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1288.err) { ir.dnit(?m); ret 1; }

    val res_l: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_l.err) { ir.dnit(?m); ret 1; }
    val fn_laden: *ir.Function = ?m.functions[res_l.ok];
    builder.set_function(?bld, fn_laden);
    val res_lb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_lb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, res_lb.ok);
    var la: value.Value = value.const_int(1, i64t);
    var track: value.Value = la;
    var j: u32 = 0;
    for (j < nadd) {
        val r: res[value.Value, fail.Fail] = builder.emit_add(?bld, la, value.const_int(1, i64t));
        if (sel r.err) { ir.dnit(?m); ret 1; }
        la = r.ok;
        track = la;
        j = j + 1;
    }
    var d: u32 = 0;
    for (d < kdbg) {
        val r_1309: err[fail.Fail] = builder.emit_dbg_value(?bld, track, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0);
        if (sel r_1309.err) { ir.dnit(?m); ret 1; }
        d = d + 1;
    }
    val r_1312: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1312.err) { ir.dnit(?m); ret 1; }

    val clean: u32 = callee_instr_count(fn_clean);
    val laden: u32 = callee_instr_count(fn_laden);
    ir.dnit(?m);

    if (clean != laden)                        { ret 1; }
    if (!(clean < INLINE_INSTR_THRESHOLD))     { ret 1; }
    if (clean + kdbg < INLINE_INSTR_THRESHOLD) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:preserves_aggregate_param_operand_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val rv: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidty: type.IrTypeId = rv.ok;
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    val rp: res[type.IrTypeId, fail.Fail] = type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: type.IrTypeId = rp.ok;
    var fields: [3]type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: res[type.IrTypeId, fail.Fail] = type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val aggt: type.IrTypeId = ra.ok;

    val rsig_a: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, voidty, ?aggt, 1, false);
    if (sel rsig_a.err) { ir.dnit(?m); ret 1; }
    val sig_agg: type.IrTypeId = rsig_a.ok;
    var pptr: type.IrTypeId = ptrt;
    val rsig_p: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, voidty, ?pptr, 1, false);
    if (sel rsig_p.err) { ir.dnit(?m); ret 1; }
    val sig_ptr: type.IrTypeId = rsig_p.ok;

    val r_sink: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig_agg, ir.FN_FLAG_EXTERN);
    if (sel r_sink.err) { ir.dnit(?m); ret 1; }
    val sink_ix: u32 = r_sink.ok;

    var bld: builder.Builder = builder.init(?m);

    val r_f: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig_agg, 0);
    if (sel r_f.err) { ir.dnit(?m); ret 1; }
    val f_ix: u32 = r_f.ok;
    builder.set_function(?bld, ?m.functions[f_ix]);
    val rfb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rfb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, rfb.ok);
    var f_arg: value.Value = value.param(0, aggt);
    val rfc: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(sink_ix, sig_agg), ?f_arg, 1, voidty);
    if (sel rfc.err) { ir.dnit(?m); ret 1; }
    val r_1370: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1370.err) { ir.dnit(?m); ret 1; }

    val r_c: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig_ptr, 0);
    if (sel r_c.err) { ir.dnit(?m); ret 1; }
    val caller_ix: u32 = r_c.ok;
    builder.set_function(?bld, ?m.functions[caller_ix]);
    val rcb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rcb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, rcb.ok);
    var c_arg: value.Value = value.param(0, ptrt);
    val rcc: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(f_ix, sig_agg), ?c_arg, 1, voidty);
    if (sel rcc.err) { ir.dnit(?m); ret 1; }
    val r_1382: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1382.err) { ir.dnit(?m); ret 1; }

    val r_run: res[bool, fail.Fail] = run(?m, nil, nil);
    if (sel r_run.err) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var bad: i32 = 1;
    var i: u32 = 0;
    for (i < caller_fn.instr_len) {
        val oi: opt[*instruction.Instruction] = ir.instruction_get(caller_fn, i::id.InstructionId);
        if (sel oi.some) {
            val ins: *instruction.Instruction = oi.some;
            if (ins.kind == instruction.OP_CALL && ins.operand_count >= 2 &&
                ins.operands[1].kind == value.VAL_PARAM) {
                if (ins.operands[1].ty == aggt) { bad = 0; }
                or { bad = 2; }
            }
        }
        i = i + 1;
    }
    ir.dnit(?m);
    ret bad;
}

