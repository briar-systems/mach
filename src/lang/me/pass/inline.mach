test "mach.lang.me.pass.inline.run:exhausted_inline_budget_is_a_distinct_reported_state" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    var pi: type.IrTypeId = i64t;
    val rs: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (sel rs.err) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = rs.ok;
    val rs0: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (sel rs0.err) { ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = rs0.ok;

    val pad_count: u32 = INLINE_BUDGET + 1;

    val res_pads: res[*u32, A.Error] = A.allocate[u32](?alloc, pad_count::usize);
    if (sel res_pads.err) { ir.dnit(?m); ret 1; }
    val pads: *u32 = res_pads.ok;

    var bld: builder.Builder = builder.init(?m);

    var k: u32 = 0;
    for (k < pad_count) {
        val r_pad: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
        if (sel r_pad.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        val pad_ix: u32 = r_pad.ok;
        pads[k] = pad_ix;

        builder.set_function(?bld, ?m.functions[pad_ix]);
        val rpb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
        if (sel rpb.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        builder.set_block(?bld, rpb.ok);
        val r_2307: err[fail.Fail] = builder.emit_ret(?bld, value.param(0, i64t));
        if (sel r_2307.err) {
            A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
        }
        k = k + 1;
    }

    val r_main: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (sel r_main.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val main_ix: u32 = r_main.ok;

    builder.set_function(?bld, ?m.functions[main_ix]);
    val rmb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rmb.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    builder.set_block(?bld, rmb.ok);

    k = 0;
    for (k < pad_count) {
        var arg: value.Value = value.const_int(k::u64, i64t);
        val rc: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(pads[k], sig), ?arg, 1, i64t);
        if (sel rc.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        k = k + 1;
    }
    val r_2329: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(0, i64t));
    if (sel r_2329.err) {
        A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
    }

    var report: InlineBudget;
    val rr: res[bool, fail.Fail] = run(?m, nil, ?report);
    if (sel rr.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }

    val main_fn: *ir.Function = ?m.functions[main_ix];
    var remaining_calls: u32 = 0;
    var bi: u32 = 0;
    for (bi < main_fn.block_count) {
        val blk: *ir.Block = ?main_fn.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(main_fn, blk.instructions[ii]);
            if (sel oi.some) {
                val ins: *instruction.Instruction = oi.some;
                if (ins.kind == instruction.OP_CALL) { remaining_calls = remaining_calls + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    A.deallocate[u32](?alloc, pads, pad_count::usize);
    ir.dnit(?m);

    if (report.inline_exhausted != true) { ret 1; }
    if (remaining_calls != 1) { ret 1; }
    ret 0;
}

