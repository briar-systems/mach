        val r_2432: err[fail.Fail] = builder.emit_ret(?bld, value.param(0, i64t));
        if (sel r_2432.err) {
            A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
        }
        k = k + 1;
    }

    val rs0: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (sel rs0.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = rs0.ok;
    val r_main: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (sel r_main.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val main_ix: u32 = r_main.ok;

    builder.set_function(?bld, ?m.functions[main_ix]);
    val rmb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rmb.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    builder.set_block(?bld, rmb.ok);

    k = 0;
    for (k < pad_count) {
        var arg: value.Value = value.const_int(k::u64, i64t);
        val rcall: res[value.Value, fail.Fail] = builder.emit_call(?bld, value.fn(pads[k], sig), ?arg, 1, i64t);
        if (sel rcall.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        k = k + 1;
    }
    val r_2457: err[fail.Fail] = builder.emit_ret(?bld, value.const_int(0, i64t));
    if (sel r_2457.err) {
        A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
    }

    var report: InlineBudget;
    val rr: res[bool, fail.Fail] = run(?m, nil, ?report);
    if (sel rr.err) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }

    val fib_fn: *ir.Function = ?m.functions[fib_ix];
    var selfcalls: u32 = 0;
    var i: u32 = 0;
    for (i < fib_fn.block_count) {
        val blk: *ir.Block = ?fib_fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: opt[*instruction.Instruction] = ir.instruction_get(fib_fn, blk.instructions[ii]);
            if (sel oi.some) {
                val ins: *instruction.Instruction = oi.some;
                if (ins.kind == instruction.OP_CALL && ins.operand_count >= 1 &&
                    ins.operands[0].kind == value.VAL_FN && ins.operands[0].data.fn_ix == fib_ix) {
                    selfcalls = selfcalls + 1;
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }

    A.deallocate[u32](?alloc, pads, pad_count::usize);
    ir.dnit(?m);

    var expected: u32 = 1;
    var e: u32 = 0;
    for (e < PEEL_LEVELS + 1) { expected = expected * 2; e = e + 1; }

    if (report.inline_exhausted != true) { ret 1; }
    if (report.peel_exhausted != false) { ret 1; }
    if (selfcalls != expected) { ret 1; }
    ret 0;
}

