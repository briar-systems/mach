        var arg: value.Value = value.const_int(k::u64, i64t);
        val rcall: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(callee_ix, sig), ?arg, 1, i64t);
        if (R.is_err[value.Value, str](rcall)) { ir.dnit(?m); ret 1; }
        val r_acc: R.Result[value.Value, str] = builder.emit_add(?bld, acc, R.unwrap_ok[value.Value, str](rcall));
        if (R.is_err[value.Value, str](r_acc)) { ir.dnit(?m); ret 1; }
        acc = R.unwrap_ok[value.Value, str](r_acc);
        k = k + 1;
    }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, acc))) { ir.dnit(?m); ret 1; }

    val rr: R.Result[bool, str] = run(?m, nil, nil);
    if (R.is_err[bool, str](rr)) { ir.dnit(?m); ret 1; }

    val caller_fn: *ir.Function = ?m.functions[caller_ix];
    var calls: u32 = 0;
    var i: u32 = 0;
    for (i < caller_fn.block_count) {
        val blk: *ir.Block = ?caller_fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(caller_fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](oi)) {
                val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                if (ins.kind == instruction.OP_CALL && callee_index(ins) == callee_ix) { calls = calls + 1; }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
    ir.dnit(?m);

    if (calls < call_site_count - INLINE_SMALL_CALLEE_FANOUT_CAP) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:exhausted_inline_budget_is_a_distinct_reported_state" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var pi: type.IrTypeId = i64t;
    val rs: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (R.is_err[type.IrTypeId, str](rs)) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs);
    val rs0: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rs0)) { ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs0);

    val pad_count: u32 = INLINE_BUDGET + 1;

    val res_pads: R.Result[*u32, str] = A.allocate[u32](?alloc, pad_count::usize);
    if (R.is_err[*u32, str](res_pads)) { ir.dnit(?m); ret 1; }
    val pads: *u32 = R.unwrap_ok[*u32, str](res_pads);

    var bld: builder.Builder = builder.init(?m);

    var k: u32 = 0;
    for (k < pad_count) {
        val r_pad: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
        if (R.is_err[u32, str](r_pad)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        val pad_ix: u32 = R.unwrap_ok[u32, str](r_pad);
        pads[k] = pad_ix;

        builder.set_function(?bld, ?m.functions[pad_ix]);
        val rpb: R.Result[id.BlockId, str] = builder.new_block(?bld);
        if (R.is_err[id.BlockId, str](rpb)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rpb));
        if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, i64t)))) {
            A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
        }
        k = k + 1;
    }

    val r_main: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_main)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val main_ix: u32 = R.unwrap_ok[u32, str](r_main);

    builder.set_function(?bld, ?m.functions[main_ix]);
    val rmb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rmb)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rmb));

    k = 0;
    for (k < pad_count) {
        var arg: value.Value = value.const_int(k::u64, i64t);
        val rc: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(pads[k], sig), ?arg, 1, i64t);
        if (R.is_err[value.Value, str](rc)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        k = k + 1;
    }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.const_int(0, i64t)))) {
        A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
    }

    var report: InlineBudget;
    val rr: R.Result[bool, str] = run(?m, nil, ?report);
    if (R.is_err[bool, str](rr)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }

    val main_fn: *ir.Function = ?m.functions[main_ix];
    var remaining_calls: u32 = 0;
    var bi: u32 = 0;
    for (bi < main_fn.block_count) {
        val blk: *ir.Block = ?main_fn.blocks[bi];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(main_fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](oi)) {
                val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                if (ins.kind == instruction.OP_CALL) { remaining_calls = remaining_calls + 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    A.deallocate[u32](?alloc, pads, pad_count::usize);
    ir.dnit(?m);

    if (report.inline_exhausted != true) { ret 1; }
    if (remaining_calls != 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.pass.inline.run:peel_budget_survives_inline_budget_exhaustion" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var pi: type.IrTypeId = i64t;
    val rs: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?pi, 1, false);
    if (R.is_err[type.IrTypeId, str](rs)) { ir.dnit(?m); ret 1; }
    val sig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs);

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); ret 1; }
    val fib_ix: u32 = R.unwrap_ok[u32, str](rf);

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[fib_ix]);
    val rb0: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb1: R.Result[id.BlockId, str] = builder.new_block(?bld);
    val rb2: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rb0) || R.is_err[id.BlockId, str](rb1) || R.is_err[id.BlockId, str](rb2)) { ir.dnit(?m); ret 1; }
    val b0: id.BlockId = R.unwrap_ok[id.BlockId, str](rb0);
    val b1: id.BlockId = R.unwrap_ok[id.BlockId, str](rb1);
    val b2: id.BlockId = R.unwrap_ok[id.BlockId, str](rb2);

    builder.set_block(?bld, b0);
    val rc: R.Result[value.Value, str] = builder.emit_cmp_lt_s(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (R.is_err[value.Value, str](rc)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_cbr(?bld, R.unwrap_ok[value.Value, str](rc), b1, b2))) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, b1);
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, i64t)))) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, b2);
    val rn1: R.Result[value.Value, str] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(1, i64t));
    if (R.is_err[value.Value, str](rn1)) { ir.dnit(?m); ret 1; }
    var a1: value.Value = R.unwrap_ok[value.Value, str](rn1);
    val ra: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a1, 1, i64t);
    if (R.is_err[value.Value, str](ra)) { ir.dnit(?m); ret 1; }
    val rn2: R.Result[value.Value, str] = builder.emit_sub(?bld, value.param(0, i64t), value.const_int(2, i64t));
    if (R.is_err[value.Value, str](rn2)) { ir.dnit(?m); ret 1; }
    var a2: value.Value = R.unwrap_ok[value.Value, str](rn2);
    val rb: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(fib_ix, sig), ?a2, 1, i64t);
    if (R.is_err[value.Value, str](rb)) { ir.dnit(?m); ret 1; }
    val rsum: R.Result[value.Value, str] = builder.emit_add(?bld, R.unwrap_ok[value.Value, str](ra), R.unwrap_ok[value.Value, str](rb));
    if (R.is_err[value.Value, str](rsum)) { ir.dnit(?m); ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, R.unwrap_ok[value.Value, str](rsum)))) { ir.dnit(?m); ret 1; }

    val pad_count: u32 = INLINE_BUDGET + 1;
    val res_pads: R.Result[*u32, str] = A.allocate[u32](?alloc, pad_count::usize);
    if (R.is_err[*u32, str](res_pads)) { ir.dnit(?m); ret 1; }
    val pads: *u32 = R.unwrap_ok[*u32, str](res_pads);

    var k: u32 = 0;
    for (k < pad_count) {
        val r_pad: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
        if (R.is_err[u32, str](r_pad)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        val pad_ix: u32 = R.unwrap_ok[u32, str](r_pad);
        pads[k] = pad_ix;

        builder.set_function(?bld, ?m.functions[pad_ix]);
        val rpb: R.Result[id.BlockId, str] = builder.new_block(?bld);
        if (R.is_err[id.BlockId, str](rpb)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rpb));
        if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.param(0, i64t)))) {
            A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
        }
        k = k + 1;
    }

    val rs0: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rs0)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val sig0: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rs0);
    val r_main: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig0, 0);
    if (R.is_err[u32, str](r_main)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    val main_ix: u32 = R.unwrap_ok[u32, str](r_main);

    builder.set_function(?bld, ?m.functions[main_ix]);
    val rmb: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rmb)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rmb));

    k = 0;
    for (k < pad_count) {
        var arg: value.Value = value.const_int(k::u64, i64t);
        val rcall: R.Result[value.Value, str] = builder.emit_call(?bld, value.fn(pads[k], sig), ?arg, 1, i64t);
        if (R.is_err[value.Value, str](rcall)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }
        k = k + 1;
    }
    if (R.is_err[R.Void, str](builder.emit_ret(?bld, value.const_int(0, i64t)))) {
        A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1;
    }

    var report: InlineBudget;
    val rr: R.Result[bool, str] = run(?m, nil, ?report);
    if (R.is_err[bool, str](rr)) { A.deallocate[u32](?alloc, pads, pad_count::usize); ir.dnit(?m); ret 1; }

    val fib_fn: *ir.Function = ?m.functions[fib_ix];
    var selfcalls: u32 = 0;
    var i: u32 = 0;
    for (i < fib_fn.block_count) {
        val blk: *ir.Block = ?fib_fn.blocks[i];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val oi: O.Option[*instruction.Instruction] = ir.instruction_get(fib_fn, blk.instructions[ii]);
            if (O.is_some[*instruction.Instruction](oi)) {
                val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);
                if (ins.kind == instruction.OP_CALL && ins.operand_count >= 1 &&
                    ins.operands[0].kind == value.VAL_FN && ins.operands[0].data.fn_ix == fib_ix) {
                    selfcalls = selfcalls + 1;
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }

    A.deallocate[u32](?alloc, pads, pad_count::usize);
    ir.dnit(?m);

    var expected: u32 = 1;
    var e: u32 = 0;
    for (e < PEEL_LEVELS + 1) { expected = expected * 2; e = e + 1; }

    if (report.inline_exhausted != true) { ret 1; }
    if (report.peel_exhausted != false) { ret 1; }
    if (selfcalls != expected) { ret 1; }
    ret 0;
}

