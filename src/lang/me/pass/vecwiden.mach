use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.refs;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.scratch;
use mach.lang.me.vecform;
use mach.lang.target;
use mach.lang.wide;

# rewrites a vector literal whose lanes are the same-kind extensions of one
# source vector's consecutive lanes into the lane-halving extension of that
# source: `i32x4{v[0]::i32, .., v[3]::i32}` over an `i16x8` becomes one
# `vec_widen_s` of `v`'s low half, and lanes 4..7 its high half (#3738). a
# machine target lowers a vector literal to a stack slot written lane by lane
# and read back whole, so the shape recognized here is that slot: every use
# of the slot is one of N lane stores through a gep and exactly one whole
# load, and every stored value is the extension of the source's lane at the
# literal's position. the load becomes the widen op, the slot and its stores
# go, and the extractions and extensions it leaves unread go with a later
# dce. the rewrite happens only where the target's catalog packs the cell, so
# a target without a packed row keeps the lane path unchanged
pub fun run(m: *ir.Module, tgt: *target.Target, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    if (!tgt.model.has_v128) { ret res[bool, fail.Fail].ok{false}; }
    var changed: bool = false;
    var fi:      u32  = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            var work: Work = Work{m: m, tgt: tgt, fn: fn};
            val r: res[bool, fail.Fail] = scratch.run[Work, bool](workspace, m.alloc, ?work, fuse_function);
            if (sel r.err) { ret r; }
            if (r.ok)      { changed = true; }
        }
        fi = fi + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

rec Work {
    m:   *ir.Module;
    tgt: *target.Target;
    fn:  *ir.Function;
}

# the per-function scratch: every listed instruction's value-use count, the
# block each listed instruction sits in, and the erase marks
rec Scan {
    uses:  *u32;
    block: *u32;
    order: *u32;
    dead:  *bool;
    ilen:  u32;
}

val NO_BLOCK: u32 = 0xFFFFFFFF;

fun count_use(sc: *Scan, r: *refs.Ref) bool {
    if (r.role != refs.REF_VALUE_USE)            { ret true; }
    if (r.value.kind != value.VAL_INSTR)         { ret true; }
    if (r.value.data.instr::u32 >= sc.ilen)      { ret true; }
    sc.uses[r.value.data.instr::u32] = sc.uses[r.value.data.instr::u32] + 1;
    ret true;
}

fun scan(fn: *ir.Function, sc: *Scan) {
    var i: u32 = 0;
    for (i < sc.ilen) {
        sc.uses[i]  = 0;
        sc.block[i] = NO_BLOCK;
        sc.order[i] = 0;
        sc.dead[i]  = false;
        i = i + 1;
    }
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var pi:  u32       = 0;
        for (pi < blk.phi_count) {
            val iid: u32 = blk.phis[pi]::u32;
            if (iid < sc.ilen) { sc.block[iid] = bi; }
            refs.visit_operands[Scan](?fn.instrs[iid], sc, count_use);
            pi = pi + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: u32 = blk.instructions[ii]::u32;
            if (iid < sc.ilen) {
                sc.block[iid] = bi;
                sc.order[iid] = ii;
            }
            refs.visit_operands[Scan](?fn.instrs[iid], sc, count_use);
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun fuse_function(w: *Work, alloc: *A.Allocator) res[bool, fail.Fail] {
    val fn:   *ir.Function = w.fn;
    val ilen: u32          = fn.instr_len;
    if (ilen == 0) { ret res[bool, fail.Fail].ok{false}; }
    val ru: res[*u32, A.Error]  = A.allocate[u32](alloc, ilen::usize);
    if (sel ru.err) { ret res[bool, fail.Fail].err{fail.refused(ru.err)}; }
    val rb: res[*u32, A.Error]  = A.allocate[u32](alloc, ilen::usize);
    if (sel rb.err) { ret res[bool, fail.Fail].err{fail.refused(rb.err)}; }
    val ro: res[*u32, A.Error]  = A.allocate[u32](alloc, ilen::usize);
    if (sel ro.err) { ret res[bool, fail.Fail].err{fail.refused(ro.err)}; }
    val rd: res[*bool, A.Error] = A.allocate[bool](alloc, ilen::usize);
    if (sel rd.err) { ret res[bool, fail.Fail].err{fail.refused(rd.err)}; }
    var sc: Scan = Scan{uses: ru.ok, block: rb.ok, order: ro.ok, dead: rd.ok, ilen: ilen};
    scan(fn, ?sc);

    var changed: bool = false;
    var bi:      u32  = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            if (fn.instrs[iid::u32].kind == instruction.OP_ALLOCA) {
                val r: res[bool, fail.Fail] = fuse_slot(w, ?sc, iid);
                if (sel r.err) { ret r; }
                if (r.ok)      { changed = true; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if (!changed) { ret res[bool, fail.Fail].ok{false}; }
    val erased: res[bool, fail.Fail] = mutate.erase_marked[Scan](w.m, fn, alloc, ?sc, is_dead);
    if (sel erased.err) { ret erased; }
    ret res[bool, fail.Fail].ok{true};
}

fun is_dead(sc: *Scan, iid: id.InstructionId) bool {
    if (iid::u32 >= sc.ilen) { ret false; }
    ret sc.dead[iid::u32];
}

# the lane count and lane bits of an integer vector type, 0 lanes otherwise
fun int_lanes(m: *ir.Module, ty: ir_type.IrTypeId, bits: *u32) u32 {
    val vo: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (sel vo.none)                            { ret 0; }
    if (vo.some.kind != ir_type.IRT_VECTOR)     { ret 0; }
    val eo: opt[*ir_type.IrType] = ir_type.get(?m.types, vo.some.data.vector_.element);
    if (sel eo.none)                            { ret 0; }
    if (eo.some.kind != ir_type.IRT_INT)        { ret 0; }
    @bits = eo.some.data.bits;
    ret vo.some.data.vector_.lanes;
}

fun const_index(v: *value.Value, want: u64) bool {
    if (v.kind != value.VAL_CONST_INT) { ret false; }
    ret wide.eq(value.int_of(v), wide.from_u64(want));
}

fun instr_of(fn: *ir.Function, v: *value.Value, sc: *Scan) opt[*instruction.Instruction] {
    if (v.kind != value.VAL_INSTR)        { ret opt[*instruction.Instruction].none{}; }
    if (v.data.instr::u32 >= sc.ilen)     { ret opt[*instruction.Instruction].none{}; }
    if (sc.block[v.data.instr::u32] == NO_BLOCK) { ret opt[*instruction.Instruction].none{}; }
    ret opt[*instruction.Instruction].some{?fn.instrs[v.data.instr::u32]};
}

# the one listed instruction that reads `iid`, absent unless exactly one does
fun single_user(fn: *ir.Function, sc: *Scan, iid: id.InstructionId, blk: u32) opt[id.InstructionId] {
    if (sc.uses[iid::u32] != 1) { ret opt[id.InstructionId].none{}; }
    val b:  *ir.Block = ?fn.blocks[blk];
    var ii: u32       = 0;
    for (ii < b.instr_count) {
        val cand: *instruction.Instruction = ?fn.instrs[b.instructions[ii]::u32];
        var o: u32 = 0;
        for (o < cand.operand_count) {
            if (cand.operands[o].kind == value.VAL_INSTR && cand.operands[o].data.instr == iid
                && refs.operand_is_value_use(cand.kind, o)) {
                ret opt[id.InstructionId].some{b.instructions[ii]};
            }
            o = o + 1;
        }
        ii = ii + 1;
    }
    ret opt[id.InstructionId].none{};
}

# the extension kind, source vector and lane index a stored lane value is,
# absent for any other value
fun lane_source(m: *ir.Module, fn: *ir.Function, sc: *Scan, v: *value.Value,
    ext: *instruction.InstrKind, src: *value.Value, lane: *u64) bool {
    val eo: opt[*instruction.Instruction] = instr_of(fn, v, sc);
    if (sel eo.none) { ret false; }
    val e: *instruction.Instruction = eo.some;
    if (e.kind != instruction.OP_SEXT && e.kind != instruction.OP_ZEXT) { ret false; }
    if (e.operand_count != 1)                                             { ret false; }
    val xo: opt[*instruction.Instruction] = instr_of(fn, ?e.operands[0], sc);
    if (sel xo.none) { ret false; }
    val x: *instruction.Instruction = xo.some;
    if (x.kind != instruction.OP_VEC_EXTRACT || x.operand_count != 2) { ret false; }
    if (x.operands[1].kind != value.VAL_CONST_INT)                     { ret false; }
    val lw: wide.Wide = value.int_of(?x.operands[1]);
    if (!wide.eq(lw, wide.from_u64(x.operands[1].data.int_lit)))       { ret false; }
    @ext  = e.kind;
    @src  = x.operands[0];
    @lane = x.operands[1].data.int_lit;
    ret true;
}

fun same_value(a: *value.Value, b: *value.Value) bool {
    if (a.kind != b.kind || a.ty != b.ty) { ret false; }
    if (a.kind == value.VAL_INSTR)        { ret a.data.instr == b.data.instr; }
    if (a.kind == value.VAL_PARAM)        { ret a.data.param_ix == b.data.param_ix; }
    ret false;
}

val MAX_LANES: u32 = 16;

fun fuse_slot(w: *Work, sc: *Scan, slot_id: id.InstructionId) res[bool, fail.Fail] {
    val m:    *ir.Module              = w.m;
    val fn:   *ir.Function            = w.fn;
    val slot: *instruction.Instruction = ?fn.instrs[slot_id::u32];
    var lane_bits: u32 = 0;
    val lanes: u32 = int_lanes(m, slot.aux_ty, ?lane_bits);
    if (lanes < 2 || lanes > MAX_LANES)     { ret res[bool, fail.Fail].ok{false}; }
    if (sc.uses[slot_id::u32] != lanes + 1) { ret res[bool, fail.Fail].ok{false}; }
    val blk: u32 = sc.block[slot_id::u32];
    if (blk == NO_BLOCK)                    { ret res[bool, fail.Fail].ok{false}; }

    # every use of the slot: N geps at distinct lanes, each the address of one
    # store, and one whole load after the last store
    var seen:  [MAX_LANES]bool;
    var geps:  [MAX_LANES]id.InstructionId;
    var stores: [MAX_LANES]id.InstructionId;
    var k: u32 = 0;
    for (k < lanes) { seen[k] = false; k = k + 1; }
    var load_id:   id.InstructionId = id.INSTR_NIL;
    var last_store: u32 = 0;
    var ext:  instruction.InstrKind = instruction.OP_UNREACHABLE;
    var src:  value.Value;
    var base: u64 = 0;
    var have_src: bool = false;
    val b:  *ir.Block = ?fn.blocks[blk];
    var ii: u32       = 0;
    for (ii < b.instr_count) {
        val uid: id.InstructionId          = b.instructions[ii];
        val u:   *instruction.Instruction = ?fn.instrs[uid::u32];
        var reads_slot: bool = false;
        var o: u32 = 0;
        for (o < u.operand_count) {
            if (u.operands[o].kind == value.VAL_INSTR && u.operands[o].data.instr == slot_id) { reads_slot = true; }
            o = o + 1;
        }
        if (reads_slot) {
            if (u.kind == instruction.OP_LOAD) {
                if (u.operand_count != 1 || u.ty != slot.aux_ty) { ret res[bool, fail.Fail].ok{false}; }
                if (load_id != id.INSTR_NIL)               { ret res[bool, fail.Fail].ok{false}; }
                load_id = uid;
            }
            or (u.kind == instruction.OP_GEP) {
                if (u.operand_count != 3 || !const_index(?u.operands[1], 0)) { ret res[bool, fail.Fail].ok{false}; }
                if (u.operands[2].kind != value.VAL_CONST_INT)               { ret res[bool, fail.Fail].ok{false}; }
                val lane_w: u64 = u.operands[2].data.int_lit;
                if (lane_w >= lanes::u64 || seen[lane_w::u32])               { ret res[bool, fail.Fail].ok{false}; }
                val so: opt[id.InstructionId] = single_user(fn, sc, uid, blk);
                if (sel so.none) { ret res[bool, fail.Fail].ok{false}; }
                val st: *instruction.Instruction = ?fn.instrs[so.some::u32];
                if (st.kind != instruction.OP_STORE || st.operand_count != 2) { ret res[bool, fail.Fail].ok{false}; }
                if (st.operands[1].kind != value.VAL_INSTR || st.operands[1].data.instr != uid) { ret res[bool, fail.Fail].ok{false}; }
                var e:  instruction.InstrKind = instruction.OP_UNREACHABLE;
                var s:  value.Value;
                var ln: u64 = 0;
                if (!lane_source(m, fn, sc, ?st.operands[0], ?e, ?s, ?ln)) { ret res[bool, fail.Fail].ok{false}; }
                if (!have_src) {
                    ext      = e;
                    src      = s;
                    have_src = true;
                    if (ln < lane_w)  { ret res[bool, fail.Fail].ok{false}; }
                    base = ln - lane_w;
                }
                or {
                    if (e != ext || !same_value(?s, ?src)) { ret res[bool, fail.Fail].ok{false}; }
                    if (ln != base + lane_w)               { ret res[bool, fail.Fail].ok{false}; }
                }
                seen[lane_w::u32]   = true;
                geps[lane_w::u32]   = uid;
                stores[lane_w::u32] = so.some;
                if (sc.order[so.some::u32] > last_store) { last_store = sc.order[so.some::u32]; }
            }
            or { ret res[bool, fail.Fail].ok{false}; }
        }
        ii = ii + 1;
    }
    if (!have_src || load_id == id.INSTR_NIL) { ret res[bool, fail.Fail].ok{false}; }
    k = 0;
    for (k < lanes) { if (!seen[k]) { ret res[bool, fail.Fail].ok{false}; } k = k + 1; }
    if (sc.order[load_id::u32] < last_store)        { ret res[bool, fail.Fail].ok{false}; }

    # the source has twice the lanes at half the width, and the literal takes
    # one of its halves
    var src_bits: u32 = 0;
    val src_lanes: u32 = int_lanes(m, src.ty, ?src_bits);
    if (src_lanes != lanes * 2 || src_bits * 2 != lane_bits)    { ret res[bool, fail.Fail].ok{false}; }
    if (base != 0 && base != lanes::u64)                        { ret res[bool, fail.Fail].ok{false}; }
    val kind: opt[instruction.InstrKind] = vecform.widen_half_of(ext);
    if (sel kind.none)                                          { ret res[bool, fail.Fail].ok{false}; }
    if (!vecform.widen_half_packs(m, w.tgt, kind.some, slot.aux_ty, src.ty)) { ret res[bool, fail.Fail].ok{false}; }

    val arr: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(m, 2);
    if (sel arr.err) { ret res[bool, fail.Fail].err{arr.err}; }
    arr.ok.ops[0] = src;
    arr.ok.ops[1] = value.const_int(base, src.ty);
    val load: *instruction.Instruction = ?fn.instrs[load_id::u32];
    ir.instr_replace_operands(m, load, arr.ok);
    load.kind   = kind.some;
    load.aux_ty = ir_type.IRT_NIL;
    sc.dead[slot_id::u32] = true;
    k = 0;
    for (k < lanes) {
        sc.dead[geps[k]::u32]   = true;
        sc.dead[stores[k]::u32] = true;
        k = k + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}
