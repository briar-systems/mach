# the debug types of one ir module: what a debug model says each source type a
# variable, function or global names is. lowering builds the table beside the ir
# types it lowers, so a debug producer reads it and never the front end's types.
# an aggregate names the ir type it is laid out as, and every size and offset a
# producer states comes from that one layout
use mach.lang.fail;
use mach.lang.growth;
use mach.lang.intern;
use ir_type: mach.lang.me.ir.type;

use A: std.allocator;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

# a type's slot in its module's table
pub rec TypeId {
    index: u32;
}

# the type nothing describes: a variable or pointee a debug model leaves untyped
pub val TYPE_NIL: TypeId = TypeId{index: 0xFFFFFFFF};

pub fun id(index: u32) TypeId {
    var t: TypeId;
    t.index = index;
    ret t;
}

pub fun index(t: TypeId) u32 {
    ret t.index;
}

pub fun same(left: TypeId, right: TypeId) bool {
    ret left.index == right.index;
}

pub fun is_nil(t: TypeId) bool {
    ret t.index == TYPE_NIL.index;
}

pub def Kind: u8;
# a scalar, by name, encoding and width
pub val KIND_BASE: Kind = 0;
# `elem` is the pointee, TYPE_NIL for an address of no described type
pub val KIND_POINTER: Kind = 1;
# `count` elements of `elem`
pub val KIND_ARRAY: Kind = 2;
# `count` lanes of the base `elem`
pub val KIND_VECTOR: Kind = 3;
# the members are the fields in declaration order, member i at field i of `layout`
pub val KIND_STRUCT: Kind = 4;
pub val KIND_UNION:  Kind = 5;
# the members are the cases in code order, a payloadless one typed TYPE_NIL, each
# payload at the payload offset of `layout`
pub val KIND_TAG: Kind = 6;

pub def Encoding: u8;
pub val ENCODING_SIGNED:   Encoding = 0;
pub val ENCODING_UNSIGNED: Encoding = 1;
pub val ENCODING_FLOAT:    Encoding = 2;
# an address, as wide as the target's pointers
pub val ENCODING_ADDRESS: Encoding = 3;

pub rec Type {
    kind: Kind;
    # a base's spelling or a nominal's declared name, nil for an aggregate with none
    name:     intern.StrId;
    encoding: Encoding;
    # a base's width, 0 for an address
    bits:  u32;
    elem:  TypeId;
    count: u32;
    # the ir type an aggregate is laid out as, in its module's type table
    layout:       ir_type.IrTypeId;
    member_start: u32;
    member_count: u32;
}

pub rec Member {
    name: intern.StrId;
    ty:   TypeId;
}

pub rec Table {
    alloc:      *A.Allocator;
    types:      *Type;
    len:        u32;
    cap:        u32;
    members:    *Member;
    member_len: u32;
    member_cap: u32;
}

pub fun init(a: *A.Allocator) Table {
    var t: Table;
    t.alloc      = a;
    t.types      = nil;
    t.len        = 0;
    t.cap        = 0;
    t.members    = nil;
    t.member_len = 0;
    t.member_cap = 0;
    ret t;
}

pub fun dnit(t: *Table) {
    if (t.types != nil && t.cap > 0)          { A.deallocate[Type](t.alloc, t.types, t.cap::usize); }
    if (t.members != nil && t.member_cap > 0) { A.deallocate[Member](t.alloc, t.members, t.member_cap::usize); }
    t.types      = nil;
    t.len        = 0;
    t.cap        = 0;
    t.members    = nil;
    t.member_len = 0;
    t.member_cap = 0;
}

# a type with no members, its kind and name set and every other field empty
pub fun blank(kind: Kind, name: intern.StrId) Type {
    var ty: Type;
    ty.kind         = kind;
    ty.name         = name;
    ty.encoding     = ENCODING_UNSIGNED;
    ty.bits         = 0;
    ty.elem         = TYPE_NIL;
    ty.count        = 0;
    ty.layout       = ir_type.IRT_NIL;
    ty.member_start = 0;
    ty.member_count = 0;
    ret ty;
}

pub fun add(t: *Table, ty: Type) res[TypeId, fail.Fail] {
    val grown: err[A.Error] = growth.reserve[Type](t.alloc, ?t.types, ?t.cap, t.len::usize + 1);
    if (sel grown.err) { ret res[TypeId, fail.Fail].err{fail.refused(grown.err)}; }
    t.types[t.len] = ty;
    t.len          = t.len + 1;
    ret res[TypeId, fail.Fail].ok{id(t.len - 1)};
}

pub fun get(t: *Table, ty: TypeId) opt[*Type] {
    if (ty.index >= t.len) { ret opt[*Type].none{}; }
    ret opt[*Type].some{?t.types[ty.index]};
}

# gives `ty` `count` untyped, unnamed members, contiguous so each is member_at an
# offset from the first, and returns where they start
pub fun members_add(t: *Table, ty: TypeId, count: u32) res[u32, fail.Fail] {
    if (ty.index >= t.len) { ret res[u32, fail.Fail].err{fail.message("ir.debug: members added to a type out of range")}; }
    val grown: err[A.Error] = growth.reserve[Member](t.alloc, ?t.members, ?t.member_cap, t.member_len::usize + count::usize);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    val start: u32 = t.member_len;
    var i:     u32 = 0;
    for (i < count) {
        t.members[start + i].name = intern.STR_NIL;
        t.members[start + i].ty   = TYPE_NIL;
        i                         = i + 1;
    }
    t.member_len                   = start + count;
    t.types[ty.index].member_start = start;
    t.types[ty.index].member_count = count;
    ret res[u32, fail.Fail].ok{start};
}

# member `i` of `ty`, nil when it has fewer
pub fun member_at(t: *Table, ty: *Type, i: u32) *Member {
    if (i >= ty.member_count) { ret nil; }
    ret ?t.members[ty.member_start + i];
}
