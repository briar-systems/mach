use mach.lang.intern;
use me_ir:          mach.lang.me.ir;
use ir_debug:       mach.lang.me.ir.debug;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use ir_type:        mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lang_source: mach.lang.source;
use mach.lang.wide;
use std.collections.map;
use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

pub fun content_equal(a: *me_ir.Module, b: *me_ir.Module) bool {
    if (!intern.str_same(a.name, b.name) || a.function_len != b.function_len || a.global_len != b.global_len
        || a.types.len != b.types.len) { ret false; }
    if (sel a.init_fn.some != sel b.init_fn.some) { ret false; }
    if (sel a.init_fn.some) {
        if (sel b.init_fn.some) {
            if (a.init_fn.some != b.init_fn.some) { ret false; }
        }
    }
    if (!map_equal[intern.StrId, u32](?a.fn_by_name, ?b.fn_by_name, number_equal)
        || !map_equal[intern.StrId, u32](?a.global_by_name, ?b.global_by_name, number_equal)) { ret false; }
    var i: u32 = 0;
    for (i < a.types.len) {
        if (!ir_type.content_equal(?a.types.types[i], ?b.types.types[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.function_len) {
        if (!function_equal(?a.functions[i], ?b.functions[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.global_len) {
        if (!global_equal(?a.globals[i], ?b.globals[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun values_equal(a: *value.Value, b: *value.Value, n: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (!value_equal(?a[i], ?b[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun value_equal(a: *value.Value, b: *value.Value) bool {
    if (a.kind != b.kind || !ir_type.same(a.ty, b.ty) || a.secret != b.secret) { ret false; }
    if (a.kind == value.VAL_INSTR)                                             { ret ir_id.instruction_same(a.data.instr, b.data.instr); }
    if (a.kind == value.VAL_PARAM)                                             { ret a.data.param_ix == b.data.param_ix; }
    if (a.kind == value.VAL_CONST_INT)                                         { ret wide.eq(value.int_of(a), value.int_of(b)); }
    if (a.kind == value.VAL_CONST_FLOAT)                                       { ret a.data.float_lit:~u64 == b.data.float_lit:~u64; }
    if (a.kind == value.VAL_CONST_NULL)                                        { ret true; }
    if (a.kind == value.VAL_GLOBAL)                                            { ret a.data.global_ix == b.data.global_ix; }
    if (a.kind == value.VAL_FN)                                                { ret a.data.fn_ix == b.data.fn_ix; }
    if (a.kind == value.VAL_CONST_BYTES) {
        ret a.data.bytes.len == b.data.bytes.len && memory.equal[u8](a.data.bytes.ptr, b.data.bytes.ptr, a.data.bytes.len::usize);
    }
    if (a.kind == value.VAL_CONST_AGG) {
        val x: *value.ValueAgg = ?a.data.agg;
        val y: *value.ValueAgg = ?b.data.agg;
        if (x.len != y.len || x.reloc_count != y.reloc_count || !memory.equal[u8](x.bytes, y.bytes, x.len::usize)) { ret false; }
        var i: u32 = 0;
        for (i < x.reloc_count) {
            val p: *value.AggReloc = ?x.relocs[i];
            val q: *value.AggReloc = ?y.relocs[i];
            if (p.offset != q.offset || !intern.str_same(p.symbol, q.symbol) || p.addend != q.addend || p.is_fn != q.is_fn) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret false;
}

fun map_equal[K, T](a: *map.Map[K, T], b: *map.Map[K, T], equal: fun(*T, *T) bool) bool {
    if (a.len != b.len) { ret false; }
    var it: map.Iter = map.iter[K, T](a);
    var e:  map.Entry[K, T];
    for (map.next[K, T](a, ?it, ?e)) {
        val found: opt[*T] = map.get[K, T](b, e.key);
        if (sel found.none)              { ret false; }
        if (!equal(e.value, found.some)) { ret false; }
    }
    ret true;
}

fun dbg_expr_id_equal(a: *me_ir.DbgExprId, b: *me_ir.DbgExprId) bool {
    ret me_ir.dbg_expr_same(@a, @b);
}

fun number_equal(a: *u32, b: *u32) bool {
    ret @a == @b;
}

fun global_equal(a: *me_ir.Global, b: *me_ir.Global) bool {
    if (!intern.str_same(a.name, b.name))                     { ret false; }
    if (!ir_type.same(a.ty, b.ty))                            { ret false; }
    if (a.is_mut != b.is_mut)                                 { ret false; }
    if (a.is_pub != b.is_pub)                                 { ret false; }
    if (a.is_extern != b.is_extern)                           { ret false; }
    if (a.is_import != b.is_import)                           { ret false; }
    if (a.is_local != b.is_local)                             { ret false; }
    if (a.is_embed != b.is_embed)                             { ret false; }
    if (a.align != b.align)                                   { ret false; }
    if (!intern.str_same(a.section, b.section))               { ret false; }
    if (a.iface != b.iface)                                   { ret false; }
    if (a.iface_a != b.iface_a)                               { ret false; }
    if (a.iface_b != b.iface_b)                               { ret false; }
    if (a.iface_flags != b.iface_flags)                       { ret false; }
    if (!intern.str_same(a.disp, b.disp))                     { ret false; }
    if (!ir_debug.same(a.debug_type, b.debug_type))           { ret false; }
    if (!lang_source.location_equals(a.decl_loc, b.decl_loc)) { ret false; }
    ret value_equal(?a.init, ?b.init);
}

fun debug_var_equal(a: *me_ir.DbgVar, b: *me_ir.DbgVar) bool {
    if (!intern.str_same(a.name, b.name))           { ret false; }
    if (!ir_type.same(a.ty, b.ty))                  { ret false; }
    if (!ir_debug.same(a.debug_type, b.debug_type)) { ret false; }
    if (a.is_param != b.is_param)                   { ret false; }
    if (a.scope != b.scope)                         { ret false; }
    ret true;
}

fun asm_equal(a: *me_ir.IrAsm, b: *me_ir.IrAsm) bool {
    if (!intern.str_same(a.isa, b.isa))   { ret false; }
    if (!intern.str_same(a.body, b.body)) { ret false; }
    if (a.bind_count != b.bind_count)     { ret false; }
    var i: u32 = 0;
    for (i < a.bind_count) {
        if (!intern.str_same(a.binds[i].name, b.binds[i].name) || !ir_id.instruction_same(a.binds[i].instr, b.binds[i].instr) || a.binds[i].secrecy.value != b.binds[i].secrecy.value || a.binds[i].secrecy.pointee != b.binds[i].secrecy.pointee) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun instruction_equal(a: *ir_instruction.Instruction, b: *ir_instruction.Instruction) bool {
    if (a.kind != b.kind)                             { ret false; }
    if (!ir_type.same(a.ty, b.ty))                    { ret false; }
    if (a.operand_count != b.operand_count)           { ret false; }
    if (a.flags != b.flags)                           { ret false; }
    if (!ir_type.same(a.aux_ty, b.aux_ty))            { ret false; }
    if (!ir_type.ext_list_same(a.arg_ext, b.arg_ext)) { ret false; }
    if (!lang_source.location_equals(a.loc, b.loc))   { ret false; }
    if (a.secret != b.secret)                         { ret false; }
    ret values_equal(a.operands, b.operands, a.operand_count);
}

fun block_equal(a: *me_ir.Block, b: *me_ir.Block) bool {
    if (!ir_id.block_same(a.id, b.id))                       { ret false; }
    if (a.instr_count != b.instr_count)                      { ret false; }
    if (a.phi_count != b.phi_count)                          { ret false; }
    if (!ir_id.instruction_same(a.terminator, b.terminator)) { ret false; }
    if (a.pred_count != b.pred_count)                        { ret false; }
    ret memory.equal[ir_id.InstructionId](a.instructions, b.instructions, a.instr_count::usize)
        && memory.equal[ir_id.InstructionId](a.phis, b.phis, a.phi_count::usize)
        && memory.equal[ir_id.BlockId](a.preds, b.preds, a.pred_count::usize);
}

pub fun function_equal(a: *me_ir.Function, b: *me_ir.Function) bool {
    if (!intern.str_same(a.name, b.name))                     { ret false; }
    if (!ir_type.same(a.sig, b.sig))                          { ret false; }
    if (!ir_type.ext_list_same(a.param_ext, b.param_ext))     { ret false; }
    if (a.param_count != b.param_count)                       { ret false; }
    if (a.block_count != b.block_count)                       { ret false; }
    if (a.instr_len != b.instr_len)                           { ret false; }
    if (a.flags != b.flags)                                   { ret false; }
    if (a.is_import != b.is_import)                           { ret false; }
    if (a.line != b.line)                                     { ret false; }
    if (!intern.str_same(a.section, b.section))               { ret false; }
    if (a.align != b.align)                                   { ret false; }
    if (a.stage != b.stage)                                   { ret false; }
    if (a.wg_x != b.wg_x)                                     { ret false; }
    if (a.wg_y != b.wg_y)                                     { ret false; }
    if (a.wg_z != b.wg_z)                                     { ret false; }
    if (!intern.str_same(a.wg_spec[0], b.wg_spec[0]))         { ret false; }
    if (!intern.str_same(a.wg_spec[1], b.wg_spec[1]))         { ret false; }
    if (!intern.str_same(a.wg_spec[2], b.wg_spec[2]))         { ret false; }
    if (a.op_set != b.op_set)                                 { ret false; }
    if (a.op_code != b.op_code)                               { ret false; }
    if (a.extensions != b.extensions)                         { ret false; }
    if (!intern.str_same(a.disp, b.disp))                     { ret false; }
    if (!ir_debug.same(a.ret_debug_type, b.ret_debug_type))   { ret false; }
    if (!lang_source.location_equals(a.decl_loc, b.decl_loc)) { ret false; }
    if (a.dbg_expr_len != b.dbg_expr_len)                     { ret false; }
    if (a.inline_site_len != b.inline_site_len)               { ret false; }
    if (!values_equal(a.params, b.params, a.param_count))     { ret false; }
    if (!map_equal[ir_id.InstructionId, me_ir.IrAsm](?a.asm_blocks, ?b.asm_blocks, asm_equal)
        || !map_equal[ir_id.InstructionId, me_ir.DbgVar](?a.dbg_vars, ?b.dbg_vars, debug_var_equal)
        || !map_equal[ir_id.InstructionId, me_ir.DbgVar](?a.alloca_dbg_vars, ?b.alloca_dbg_vars, debug_var_equal)
        || !map_equal[ir_id.InstructionId, me_ir.DbgExprId](?a.dbg_expr_ids, ?b.dbg_expr_ids, dbg_expr_id_equal)
        || !map_equal[ir_id.InstructionId, u32](?a.instr_inline_site, ?b.instr_inline_site, number_equal)) { ret false; }
    var i: u32 = 0;
    for (i < a.block_count) {
        if (!block_equal(?a.blocks[i], ?b.blocks[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.instr_len) {
        if (!instruction_equal(?a.instrs[i], ?b.instrs[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.dbg_expr_len) {
        val x: *me_ir.DbgExpr = ?a.dbg_exprs[i];
        val y: *me_ir.DbgExpr = ?b.dbg_exprs[i];
        if (x.op_count != y.op_count) { ret false; }
        var j: u32 = 0;
        for (j < x.op_count) {
            if (x.ops[j].op != y.ops[j].op || x.ops[j].arg != y.ops[j].arg) { ret false; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < a.inline_site_len) {
        val x: *me_ir.InlineSite = ?a.inline_sites[i];
        val y: *me_ir.InlineSite = ?b.inline_sites[i];
        if (!intern.str_same(x.callee, y.callee) || !lang_source.location_equals(x.call_loc, y.call_loc) || x.parent != y.parent) { ret false; }
        i = i + 1;
    }
    ret true;
}

test value_equal__owned_bytes_relocations_and_float_bits_are_observable {
    var xbytes: [2]u8       = [2]u8{1, 2};
    var ybytes: [2]u8       = [2]u8{1, 2};
    var x:      value.Value = value.const_bytes(?xbytes[0], 2, ir_type.id(1));
    var y:      value.Value = value.const_bytes(?ybytes[0], 2, ir_type.id(1));
    if (!value_equal(?x, ?y)) { ret 1; }
    ybytes[1] = 3;
    if (value_equal(?x, ?y)) { ret 2; }
    ybytes[1] = 2;
    var xr: value.AggReloc = value.AggReloc{symbol: intern.str_id(7), addend: 4};
    var yr: value.AggReloc = xr;
    x = value.const_agg(?xbytes[0], 2, ?xr, 1, 1, ir_type.id(1));
    y = value.const_agg(?ybytes[0], 2, ?yr, 1, 8, ir_type.id(1));
    if (!value_equal(?x, ?y)) { ret 3; }
    yr.addend = 5;
    if (value_equal(?x, ?y)) { ret 4; }
    val nan: u64 = 0x7ff8000000000001;
    x = value.const_float(nan:~f64, ir_type.id(2));
    y = value.const_float(nan:~f64, ir_type.id(2));
    if (!value_equal(?x, ?y)) { ret 5; }
    val negative_zero: u64 = 0x8000000000000000;
    x = value.const_float(0.0, ir_type.id(2));
    y = value.const_float(negative_zero:~f64, ir_type.id(2));
    if (value_equal(?x, ?y)) { ret 6; }
    ret 0;
}

test instruction_equal__source_and_secrecy_are_observable {
    var x: ir_instruction.Instruction = ir_instruction.Instruction{kind: ir_instruction.OP_RET, loc: lang_source.location(lang_source.file_id(3), lang_source.span(11, 2))};
    var y: ir_instruction.Instruction = x;
    if (!instruction_equal(?x, ?y)) { ret 1; }
    y.loc.span.offset = 12;
    if (instruction_equal(?x, ?y)) { ret 2; }
    y              = x;
    y.loc.span.len = 3;
    if (instruction_equal(?x, ?y)) { ret 4; }
    y        = x;
    y.secret = true;
    if (instruction_equal(?x, ?y)) { ret 3; }
    ret 0;
}

# an integer constant is its 128 bits: one limb equal is not equality
test value_equal__integer_constants_compare_both_limbs {
    var x: value.Value = value.const_int_wide(wide.make(5, 1), ir_type.id(2));
    var y: value.Value = value.const_int_wide(wide.make(5, 1), ir_type.id(2));
    if (!value_equal(?x, ?y)) { ret 1; }
    y = value.const_int_wide(wide.make(5, 2), ir_type.id(2));
    if (value_equal(?x, ?y)) { ret 2; }
    y = value.const_int_wide(wide.make(6, 1), ir_type.id(2));
    if (value_equal(?x, ?y)) { ret 3; }
    ret 0;
}
