test agg_value_is_address_producing__return_phi {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val agr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?env.m.types, env.i64ty, 4);
    if (sel agr.err) { ret 1; }
    val aggty: ir_type.IrTypeId = agr.ok;

    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    val b3: ir_id.BlockId = t_block(?env);
    if (b0 != 0 || b1 != 1 || b2 != 2 || b3 != 3) { ret 1; }

    builder.set_block(?env.bld, b0);
    val a0r: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, aggty, t_ci(?env, 1));
    if (sel a0r.err) { ret 1; }
    val a0:     value.Value    = a0r.ok;
    val r_1971: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_1971.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val a1r: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, aggty, t_ci(?env, 1));
    if (sel a1r.err) { ret 1; }
    val a1:     value.Value    = a1r.ok;
    val r_1977: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1977.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val a2r: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, aggty, t_ci(?env, 1));
    if (sel a2r.err) { ret 1; }
    val a2:     value.Value    = a2r.ok;
    val r_1983: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1983.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val pr: res[value.Value, fail.Fail] = builder.emit_phi(?env.bld, aggty);
    if (sel pr.err) { ret 1; }
    val phi:    value.Value    = pr.ok;
    val r_1989: err[fail.Fail] = builder.phi_add_incoming(?env.bld, phi, b1, value.retype(a1, aggty));
    if (sel r_1989.err) { ret 1; }
    val r_1990: err[fail.Fail] = builder.phi_add_incoming(?env.bld, phi, b2, value.retype(a2, aggty));
    if (sel r_1990.err) { ret 1; }
    val r_1991: err[fail.Fail] = builder.emit_store(?env.bld, value.retype(phi, aggty), a0);
    if (sel r_1991.err) { ret 1; }
    val r_1992: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1992.err) { ret 1; }

    if (t_count(?env, false, true, VC_AGG_ADDRESS) != 0) { ret 1; }
    ret 0;
}

test check_type_agree__vector_ops_and_mask_compare {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }

    val ef: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?env.m.types, 32);
    if (sel ef.err) { ret 1; }
    val vr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, ef.ok, 4);
    if (sel vr.err) { ret 1; }
    val vecty: ir_type.IrTypeId = vr.ok;

    val ei: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 32);
    if (sel ei.err) { ret 1; }
    val mr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, ei.ok, 4);
    if (sel mr.err) { ret 1; }
    val maskty: ir_type.IrTypeId = mr.ok;

    builder.set_block(?env.bld, b0);

    val ar: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, vecty, t_ci(?env, 1));
    if (sel ar.err) { ret 1; }
    val slot: value.Value = ar.ok;

    val lr: res[value.Value, fail.Fail] = builder.emit_load(?env.bld, slot, vecty);
    if (sel lr.err) { ret 1; }
    val v: value.Value = lr.ok;

    val r_2027: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, v);
    if (sel r_2027.err) { ret 1; }
    val r_2028: res[value.Value, fail.Fail] = builder.emit_vcompare(?env.bld, ir_instruction.OP_CMP_EQ, v, v, maskty);
    if (sel r_2028.err) { ret 1; }
    val r_2029: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2029.err) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }
    ret 0;
}

test check_type_agree__widening_multiply_doubles_its_integer_lanes {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }

    val e16: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 16);
    val e32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 32);
    val f32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?env.m.types, 32);
    if (sel e16.err) { ret 1; }
    if (sel e32.err) { ret 1; }
    if (sel f32.err) { ret 1; }
    val n4: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, e16.ok, 4);
    val w4: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, e32.ok, 4);
    val w8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, e32.ok, 8);
    val f4: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, f32.ok, 4);
    if (sel n4.err) { ret 1; }
    if (sel w4.err) { ret 1; }
    if (sel w8.err) { ret 1; }
    if (sel f4.err) { ret 1; }

    builder.set_block(?env.bld, b0);
    val ar: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, n4.ok, t_ci(?env, 1));
    if (sel ar.err) { ret 1; }
    val lr: res[value.Value, fail.Fail] = builder.emit_load(?env.bld, ar.ok, n4.ok);
    if (sel lr.err) { ret 1; }
    val pr: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, lr.ok, lr.ok);
    if (sel pr.err) { ret 1; }
    val done: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel done.err) { ret 1; }

    val p: *ir_instruction.Instruction = ?env.m.functions[0].instrs[pr.ok.data.instr];
    p.kind = ir_instruction.OP_MUL_WIDE_S;
    p.ty   = w4.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) != 0) { ret 2; }
    p.kind = ir_instruction.OP_MUL_WIDE_U;
    if (t_count(?env, true, true, VC_TYPE_AGREE) != 0) { ret 3; }
    p.ty = n4.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) < 1) { ret 4; }
    p.ty = w8.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) < 1) { ret 5; }
    p.ty = f4.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) < 1) { ret 6; }
    ret 0;
}

test check_type_agree__scalar_widening_and_high_multiply_shapes {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }

    val i64r:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 64);
    val i128r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 128);
    val i32r:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 32);
    val f64r:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?env.m.types, 64);
    if (sel i64r.err)  { ret 1; }
    if (sel i128r.err) { ret 1; }
    if (sel i32r.err)  { ret 1; }
    if (sel f64r.err)  { ret 1; }

    builder.set_block(?env.bld, b0);
    val pr: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, t_ci(?env, 3), t_ci(?env, 5));
    if (sel pr.err) { ret 1; }
    val done: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel done.err) { ret 1; }

    val p: *ir_instruction.Instruction = ?env.m.functions[0].instrs[pr.ok.data.instr];
    p.kind = ir_instruction.OP_MUL_WIDE_U;
    p.ty   = i128r.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) != 0) { ret 2; }
    p.kind = ir_instruction.OP_MUL_WIDE_S;
    if (t_count(?env, true, true, VC_TYPE_AGREE) != 0) { ret 3; }
    p.ty = i64r.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) < 1) { ret 4; }
    p.ty = i32r.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) < 1) { ret 5; }
    p.ty = f64r.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) < 1) { ret 6; }

    p.kind = ir_instruction.OP_MUL_HIGH_U;
    p.ty   = i64r.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) != 0) { ret 7; }
    p.kind = ir_instruction.OP_MUL_HIGH_S;
    if (t_count(?env, true, true, VC_TYPE_AGREE) != 0) { ret 8; }
    p.ty = i128r.ok;
    if (t_count(?env, true, true, VC_TYPE_AGREE) < 1) { ret 9; }
    ret 0;
}

test check_call_arg_types__aggregate_arg_pointer_mistype {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    val agr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?env.m.types, env.i64ty, 4);
    if (sel agr.err) { ret 1; }
    val aggty: ir_type.IrTypeId                 = agr.ok;
    val pr:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?env.m.types);
    if (sel pr.err) { ret 1; }
    val ptrty: ir_type.IrTypeId = pr.ok;

    var pbuf: ir_type.IrTypeId                 = aggty;
    val sr:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?env.m.types, env.i64ty, ?pbuf, 1, false);
    if (sel sr.err) { ret 1; }
    val calleesig: ir_type.IrTypeId    = sr.ok;
    val cfr:       res[u32, fail.Fail] = me_ir.function_add(?env.m, intern.STR_NIL, calleesig, me_ir.FN_FLAG_EXTERN);
    if (sel cfr.err) { ret 1; }
    val cidx: u32 = cfr.ok;

    var abuf:  value.Value                 = value.param(0, aggty);
    val callr: res[value.Value, fail.Fail] = builder.emit_call(?env.bld, value.fn(cidx, calleesig), ?abuf, 1, env.i64ty);
    if (sel callr.err) { ret 1; }
    val callv:  value.Value    = callr.ok;
    val r_2062: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2062.err) { ret 1; }

    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) != 0) { ret 1; }

    val cid: ir_id.InstructionId = callv.data.instr;
    env.m.functions[0].instrs[cid].operands[1].ty = ptrty;

    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) < 1) { ret 1; }
    ret 0;
}

test check_call_arg_types__vector_param_accepts_by_address_arg {
    var env: TEnv;
