test "mach.lang.me.ir.verify.agg_value_is_address_producing:return_phi" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val agr: R.Result[type.IrTypeId, str] = type.intern_array(?env.m.types, env.i64ty, 4);
    if (R.is_err[type.IrTypeId, str](agr)) { ret 1; }
    val aggty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](agr);

    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b0 != 0 || b1 != 1 || b2 != 2 || b3 != 3) { ret 1; }

    builder.set_block(?env.bld, b0);
    val a0r: R.Result[value.Value, str] = builder.emit_alloca(?env.bld, aggty, t_ci(?env, 1));
    if (R.is_err[value.Value, str](a0r)) { ret 1; }
    val a0: value.Value = R.unwrap_ok[value.Value, str](a0r);
    if (R.is_err[R.Void, str](builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2))) { ret 1; }

    builder.set_block(?env.bld, b1);
    val a1r: R.Result[value.Value, str] = builder.emit_alloca(?env.bld, aggty, t_ci(?env, 1));
    if (R.is_err[value.Value, str](a1r)) { ret 1; }
    val a1: value.Value = R.unwrap_ok[value.Value, str](a1r);
    if (R.is_err[R.Void, str](builder.emit_br(?env.bld, b3))) { ret 1; }

    builder.set_block(?env.bld, b2);
    val a2r: R.Result[value.Value, str] = builder.emit_alloca(?env.bld, aggty, t_ci(?env, 1));
    if (R.is_err[value.Value, str](a2r)) { ret 1; }
    val a2: value.Value = R.unwrap_ok[value.Value, str](a2r);
    if (R.is_err[R.Void, str](builder.emit_br(?env.bld, b3))) { ret 1; }

    builder.set_block(?env.bld, b3);
    val pr: R.Result[value.Value, str] = builder.emit_phi(?env.bld, aggty);
    if (R.is_err[value.Value, str](pr)) { ret 1; }
    val phi: value.Value = R.unwrap_ok[value.Value, str](pr);
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?env.bld, phi, b1, value.retype(a1, aggty)))) { ret 1; }
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?env.bld, phi, b2, value.retype(a2, aggty)))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_store(?env.bld, value.retype(phi, aggty), a0)))           { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld)))                                      { ret 1; }

    if (t_count(?env, false, true, VC_AGG_ADDRESS) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_type_agree:vector_ops_and_mask_compare" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }

    val ef: R.Result[type.IrTypeId, str] = type.intern_float(?env.m.types, 32);
    if (R.is_err[type.IrTypeId, str](ef)) { ret 1; }
    val vr: R.Result[type.IrTypeId, str] = type.intern_vector(?env.m.types, R.unwrap_ok[type.IrTypeId, str](ef), 4);
    if (R.is_err[type.IrTypeId, str](vr)) { ret 1; }
    val vecty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](vr);

    val ei: R.Result[type.IrTypeId, str] = type.intern_int(?env.m.types, 32);
    if (R.is_err[type.IrTypeId, str](ei)) { ret 1; }
    val mr: R.Result[type.IrTypeId, str] = type.intern_vector(?env.m.types, R.unwrap_ok[type.IrTypeId, str](ei), 4);
    if (R.is_err[type.IrTypeId, str](mr)) { ret 1; }
    val maskty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](mr);

    builder.set_block(?env.bld, b0);

    val ar: R.Result[value.Value, str] = builder.emit_alloca(?env.bld, vecty, t_ci(?env, 1));
    if (R.is_err[value.Value, str](ar)) { ret 1; }
    val slot: value.Value = R.unwrap_ok[value.Value, str](ar);

    val lr: R.Result[value.Value, str] = builder.emit_load(?env.bld, slot, vecty);
    if (R.is_err[value.Value, str](lr)) { ret 1; }
    val v: value.Value = R.unwrap_ok[value.Value, str](lr);

    if (R.is_err[value.Value, str](builder.emit_add(?env.bld, v, v))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_vcompare(?env.bld, instruction.OP_CMP_EQ, v, v, maskty))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld))) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_call_arg_types:aggregate_arg_pointer_mistype" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    val agr: R.Result[type.IrTypeId, str] = type.intern_array(?env.m.types, env.i64ty, 4);
    if (R.is_err[type.IrTypeId, str](agr)) { ret 1; }
    val aggty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](agr);
    val pr: R.Result[type.IrTypeId, str] = type.intern_ptr(?env.m.types);
    if (R.is_err[type.IrTypeId, str](pr)) { ret 1; }
    val ptrty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](pr);

    var pbuf: type.IrTypeId = aggty;
    val sr: R.Result[type.IrTypeId, str] = type.intern_fn(?env.m.types, env.i64ty, ?pbuf, 1, false);
    if (R.is_err[type.IrTypeId, str](sr)) { ret 1; }
    val calleesig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](sr);
    val cfr: R.Result[u32, str] = ir.function_add(?env.m, intern.STR_NIL, calleesig, ir.FN_FLAG_EXTERN);
    if (R.is_err[u32, str](cfr)) { ret 1; }
    val cidx: u32 = R.unwrap_ok[u32, str](cfr);

    var abuf: value.Value = value.param(0, aggty);
    val callr: R.Result[value.Value, str] = builder.emit_call(?env.bld, value.fn(cidx, calleesig), ?abuf, 1, env.i64ty);
    if (R.is_err[value.Value, str](callr)) { ret 1; }
    val callv: value.Value = R.unwrap_ok[value.Value, str](callr);
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld))) { ret 1; }

    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) != 0) { ret 1; }

    val cid: id.InstructionId = callv.data.instr;
    env.m.functions[0].instrs[cid].operands[1].ty = ptrty;

    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) < 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_call_arg_types:vector_param_accepts_by_address_arg" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    val ei: R.Result[type.IrTypeId, str] = type.intern_int(?env.m.types, 32);
    if (R.is_err[type.IrTypeId, str](ei)) { ret 1; }
    val vr: R.Result[type.IrTypeId, str] = type.intern_vector(?env.m.types, R.unwrap_ok[type.IrTypeId, str](ei), 4);
    if (R.is_err[type.IrTypeId, str](vr)) { ret 1; }
    val vecty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](vr);
    val pr: R.Result[type.IrTypeId, str] = type.intern_ptr(?env.m.types);
    if (R.is_err[type.IrTypeId, str](pr)) { ret 1; }
    val ptrty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](pr);

    var pbuf: type.IrTypeId = vecty;
    val sr: R.Result[type.IrTypeId, str] = type.intern_fn(?env.m.types, env.i64ty, ?pbuf, 1, false);
    if (R.is_err[type.IrTypeId, str](sr)) { ret 1; }
    val calleesig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](sr);
    val cfr: R.Result[u32, str] = ir.function_add(?env.m, intern.STR_NIL, calleesig, ir.FN_FLAG_EXTERN);
    if (R.is_err[u32, str](cfr)) { ret 1; }
    val cidx: u32 = R.unwrap_ok[u32, str](cfr);

    var abuf: value.Value = value.param(0, vecty);
    val callr: R.Result[value.Value, str] = builder.emit_call(?env.bld, value.fn(cidx, calleesig), ?abuf, 1, env.i64ty);
    if (R.is_err[value.Value, str](callr)) { ret 1; }
    val callv: value.Value = R.unwrap_ok[value.Value, str](callr);
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld))) { ret 1; }
    val cid: id.InstructionId = callv.data.instr;

    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) != 0) { ret 1; }

    env.m.functions[0].instrs[cid].operands[1].ty = ptrty;
    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) != 0) { ret 1; }

    env.m.functions[0].instrs[cid].operands[1].ty = env.i64ty;
    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) < 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.describe_located:names_module_function_and_position" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }

    var itn: intern.Interner = intern.init(?env.alloc);
    var smap: source.SourceMap = source.init(?env.alloc);

    val res_fid: R.Result[source.FileId, str] = source.add(?smap, "./src/probe.mach", "ab\ncde\nf");
    if (R.is_err[source.FileId, str](res_fid)) { ret 1; }
    val fid: source.FileId = R.unwrap_ok[source.FileId, str](res_fid);

    val res_mod: R.Result[intern.StrId, str] = intern.intern(?itn, "probe.mod");
    if (R.is_err[intern.StrId, str](res_mod)) { ret 1; }
    env.m.name = R.unwrap_ok[intern.StrId, str](res_mod);

    val res_fn: R.Result[intern.StrId, str] = intern.intern(?itn, "offender");
    if (R.is_err[intern.StrId, str](res_fn)) { ret 1; }
    env.m.functions[0].disp = R.unwrap_ok[intern.StrId, str](res_fn);

    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    builder.set_loc(?env.bld, source.loc(fid, 4));
    if (R.is_err[R.Void, str](builder.emit_store(?env.bld, t_ci(?env, 1), t_ci(?env, 0)))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld)))                            { ret 1; }

    val rr: R.Result[VerifyReport, str] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, false, true));
    if (R.is_err[VerifyReport, str](rr)) { ret 1; }
    var rep: VerifyReport = R.unwrap_ok[VerifyReport, str](rr);
    if (rep.len == 0) { dnit_report(?rep); ret 1; }

    val msg: str = describe_located(?env.m, ?rep.violations[0], ?itn, ?smap, ?env.alloc);
    dnit_report(?rep);

    var code: i32 = 0;
    if (!str_contains(msg, "type agreement"))         { code = 1; }
    if (!str_contains(msg, "probe.mod.offender"))     { code = 1; }
    if (!str_contains(msg, "./src/probe.mach"))       { code = 1; }
    if (!str_contains(msg, "2:2"))                    { code = 1; }
    if (str_contains(msg, "no source location"))      { code = 1; }

    source.dnit(?smap);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.me.ir.verify.describe_located:spanless_says_so" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }

    var itn: intern.Interner = intern.init(?env.alloc);
    var smap: source.SourceMap = source.init(?env.alloc);

    val res_mod: R.Result[intern.StrId, str] = intern.intern(?itn, "probe.mod");
    if (R.is_err[intern.StrId, str](res_mod)) { ret 1; }
    env.m.name = R.unwrap_ok[intern.StrId, str](res_mod);

    val res_fn: R.Result[intern.StrId, str] = intern.intern(?itn, "offender");
    if (R.is_err[intern.StrId, str](res_fn)) { ret 1; }
    env.m.functions[0].disp = R.unwrap_ok[intern.StrId, str](res_fn);

    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }

    val rr: R.Result[VerifyReport, str] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, false, false));
    if (R.is_err[VerifyReport, str](rr)) { ret 1; }
    var rep: VerifyReport = R.unwrap_ok[VerifyReport, str](rr);
    if (rep.len == 0) { dnit_report(?rep); ret 1; }
    if (rep.violations[0].instr != id.INSTR_NIL) { dnit_report(?rep); ret 1; }

    val msg: str = describe_located(?env.m, ?rep.violations[0], ?itn, ?smap, ?env.alloc);
    dnit_report(?rep);

    var code: i32 = 0;
    if (!str_contains(msg, "terminator presence"))                              { code = 1; }
    if (!str_contains(msg, "probe.mod.offender"))                               { code = 1; }
    if (!str_contains(msg, "no source location available for this check"))      { code = 1; }

    source.dnit(?smap);
    intern.dnit(?itn);
    ret code;
}

fun t_drop(env: *TEnv, b: id.BlockId, iid: id.InstructionId) bool {
    val fn: *ir.Function = ?env.m.functions[0];
    if (b::u32 >= fn.block_count) { ret false; }
    val blk: *ir.Block = ?fn.blocks[b::u32];
    var i: u32 = 0;
    for (i < blk.instr_count) {
        if (blk.instructions[i] == iid) {
            var j: u32 = i;
            for (j + 1 < blk.instr_count) { blk.instructions[j] = blk.instructions[j + 1]; j = j + 1; }
            blk.instr_count = blk.instr_count - 1;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.me.ir.verify.check_operand_defs:dropped_def" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val dv: R.Result[value.Value, str] = builder.emit_add(?env.bld, c, c);
    if (R.is_err[value.Value, str](dv)) { ret 1; }
    val d: value.Value = R.unwrap_ok[value.Value, str](dv);
    if (R.is_err[value.Value, str](builder.emit_add(?env.bld, d, c))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld)))         { ret 1; }

    if (t_total(?env, false, false) != 0) { ret 1; }

    if (!t_drop(?env, b0, d.data.instr)) { ret 1; }
    if (t_count(?env, false, false, VC_DANGLING_OPERAND) != 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_operand_defs:dropped_phi_incoming" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    if (R.is_err[R.Void, str](builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2))) { ret 1; }

    builder.set_block(?env.bld, b1);
    val lv: R.Result[value.Value, str] = builder.emit_add(?env.bld, c, c);
    if (R.is_err[value.Value, str](lv)) { ret 1; }
    val l: value.Value = R.unwrap_ok[value.Value, str](lv);
    if (R.is_err[R.Void, str](builder.emit_br(?env.bld, b3))) { ret 1; }

    builder.set_block(?env.bld, b2);
    val rv: R.Result[value.Value, str] = builder.emit_add(?env.bld, c, c);
    if (R.is_err[value.Value, str](rv)) { ret 1; }
    val rt: value.Value = R.unwrap_ok[value.Value, str](rv);
    if (R.is_err[R.Void, str](builder.emit_br(?env.bld, b3))) { ret 1; }

    builder.set_block(?env.bld, b3);
    val pv: R.Result[value.Value, str] = builder.emit_phi(?env.bld, env.i64ty);
    if (R.is_err[value.Value, str](pv)) { ret 1; }
    val p: value.Value = R.unwrap_ok[value.Value, str](pv);
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?env.bld, p, b1, l)))  { ret 1; }
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?env.bld, p, b2, rt))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_add(?env.bld, p, c))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld)))         { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }

    if (!t_drop(?env, b2, rt.data.instr)) { ret 1; }
    if (t_count(?env, false, false, VC_DANGLING_OPERAND) != 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_dominance:phi_incoming_not_live_out_of_pred" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    if (R.is_err[R.Void, str](builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2))) { ret 1; }

    builder.set_block(?env.bld, b1);
    if (R.is_err[R.Void, str](builder.emit_br(?env.bld, b3))) { ret 1; }

    builder.set_block(?env.bld, b2);
    val rv: R.Result[value.Value, str] = builder.emit_add(?env.bld, c, c);
    if (R.is_err[value.Value, str](rv)) { ret 1; }
    val rt: value.Value = R.unwrap_ok[value.Value, str](rv);
    if (R.is_err[R.Void, str](builder.emit_br(?env.bld, b3))) { ret 1; }

    builder.set_block(?env.bld, b3);
    val pv: R.Result[value.Value, str] = builder.emit_phi(?env.bld, env.i64ty);
    if (R.is_err[value.Value, str](pv)) { ret 1; }
    val p: value.Value = R.unwrap_ok[value.Value, str](pv);
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?env.bld, p, b1, rt))) { ret 1; }
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?env.bld, p, b2, rt))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_add(?env.bld, p, c))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld)))         { ret 1; }

    if (t_count(?env, true, false, VC_DANGLING_OPERAND) != 0) { ret 1; }
    if (t_count(?env, true, false, VC_DOMINANCE) != 1)        { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_dominance:phi_incoming_defined_in_pred" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    if (b1 != 1) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val dv: R.Result[value.Value, str] = builder.emit_add(?env.bld, c, c);
    if (R.is_err[value.Value, str](dv)) { ret 1; }
    val d: value.Value = R.unwrap_ok[value.Value, str](dv);
    if (R.is_err[R.Void, str](builder.emit_br(?env.bld, b1))) { ret 1; }

    builder.set_block(?env.bld, b1);
    val pv: R.Result[value.Value, str] = builder.emit_phi(?env.bld, env.i64ty);
    if (R.is_err[value.Value, str](pv)) { ret 1; }
    val p: value.Value = R.unwrap_ok[value.Value, str](pv);
    if (R.is_err[R.Void, str](builder.phi_add_incoming(?env.bld, p, b0, d))) { ret 1; }
    if (R.is_err[value.Value, str](builder.emit_add(?env.bld, p, c))) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld)))         { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify:volatile_flag_requires_memory_access" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val entry: id.BlockId = t_block(?env);
    if (entry == id.BLOCK_NIL) { ret 1; }
    builder.set_block(?env.bld, entry);

    val sum: R.Result[value.Value, str] = builder.emit_add(?env.bld, t_ci(?env, 1), t_ci(?env, 2));
    if (R.is_err[value.Value, str](sum)) { ret 1; }
    val add: value.Value = R.unwrap_ok[value.Value, str](sum);
    env.m.functions[0].instrs[add.data.instr].flags = instruction.INSTR_FLAG_VOLATILE;
    if (R.is_err[R.Void, str](builder.emit_ret_void(?env.bld))) { ret 1; }

    if (t_count(?env, false, false, VC_VOLATILE_FORM) != 1) { ret 1; }
    env.m.functions[0].instrs[add.data.instr].flags = 0;
    if (t_count(?env, false, false, VC_VOLATILE_FORM) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify:rejects_an_instruction_whose_opcode_has_no_descriptor" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    fin { ir.dnit(?m); }

    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 32);
    if (R.is_err[type.IrTypeId, str](ri)) { ret 1; }
    val i32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);

    val rfa: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, i32t, 0);
    if (R.is_err[u32, str](rfa)) { ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rfa)];
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](rb)) { ret 1; }
    builder.set_block(?b, R.unwrap_ok[id.BlockId, str](rb));
    val ra: R.Result[value.Value, str] = builder.emit_add(?b, value.const_int(1, i32t), value.const_int(2, i32t));
    if (R.is_err[value.Value, str](ra)) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?b, R.unwrap_ok[value.Value, str](ra)))) { ret 1; }

    if (t_first_check(?m, ?alloc) != VC_NONE_SEEN) { ret 1; }

    fn.instrs[R.unwrap_ok[value.Value, str](ra).data.instr::u32].kind = 200::instruction.InstrKind;
    if (t_first_check(?m, ?alloc) != VC_OPCODE_KNOWN) { ret 1; }
    ret 0;
}

val VC_NONE_SEEN: VerifyCheck = 255;

fun t_first_check(m: *ir.Module, alloc: *A.Allocator) VerifyCheck {
    val rr: R.Result[VerifyReport, str] = verify_module_ext(m, alloc, opts(nil, false, false));
    if (R.is_err[VerifyReport, str](rr)) { ret VC_NONE_SEEN; }
    var rep: VerifyReport = R.unwrap_ok[VerifyReport, str](rr);
    if (rep.len == 0) { dnit_report(?rep); ret VC_NONE_SEEN; }
    val c: VerifyCheck = rep.violations[0].check;
    dnit_report(?rep);
    ret c;
}
