    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) != 0) { ret 1; }

    env.m.functions[0].instrs[cid].operands[1].ty = env.i64ty;
    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) < 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.describe_located:names_module_function_and_position" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    fin { ir.dnit(?env.m); }

    var itn: intern.Interner = intern.init(?env.alloc);
    fin { intern.dnit(?itn); }
    var smap: source.SourceMap = source.init(?env.alloc);
    fin { source.dnit(?smap); }

    val res_fid: R.Result[source.FileId, str] = source.add(?smap, "./src/probe.mach", "ab\ncde\nf");
    if (R.is_err[source.FileId, str](res_fid)) { ret 1; }
    val fid: source.FileId = R.unwrap_ok[source.FileId, str](res_fid);

    val res_mod: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "probe.mod");
    if (sel res_mod.err) { ret 1; }
    env.m.name = res_mod.ok;

    val res_fn: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "offender");
    if (sel res_fn.err) { ret 1; }
    env.m.functions[0].disp = res_fn.ok;

    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    builder.set_loc(?env.bld, source.loc(fid, 4));
    val r_2143: err[fail.Fail] = builder.emit_store(?env.bld, t_ci(?env, 1), t_ci(?env, 0));
    if (sel r_2143.err) { ret 1; }
    val r_2144: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2144.err) { ret 1; }

    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, false, true));
    if (sel rr.err) { ret 1; }
    var rep: VerifyReport = rr.ok;
    fin { dnit_report(?rep); }
    if (rep.len == 0) { ret 1; }

    val described: res[str, fail.Fail] = describe_located(?env.m, ?rep.violations[0], ?itn, ?smap, ?env.alloc);
    if (sel described.err) { ret 2; }
    val msg: str = described.ok;
    fin { str_free(?env.alloc, msg); }

    var code: i32 = 0;
    if (!str_contains(msg, "type agreement"))         { code = 1; }
    if (!str_contains(msg, "probe.mod.offender"))     { code = 1; }
    if (!str_contains(msg, "./src/probe.mach"))       { code = 1; }
    if (!str_contains(msg, "2:2"))                    { code = 1; }
    if (str_contains(msg, "no source location"))      { code = 1; }

    if (code != 0) { ret code; }
    ret t_describe_refusals(?env.m, ?rep.violations[0], ?itn, ?smap, "probe.mod.offender");
}

test "mach.lang.me.ir.verify.describe_located:spanless_says_so" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    fin { ir.dnit(?env.m); }

    var itn: intern.Interner = intern.init(?env.alloc);
    fin { intern.dnit(?itn); }
    var smap: source.SourceMap = source.init(?env.alloc);
    fin { source.dnit(?smap); }

    val res_mod: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "probe.mod");
    if (sel res_mod.err) { ret 1; }
    env.m.name = res_mod.ok;

    val res_fn: res[intern.StrId, A.Error] = intern.intern_typed(?itn, "offender");
    if (sel res_fn.err) { ret 1; }
    env.m.functions[0].disp = res_fn.ok;

    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }

    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, false, false));
    if (sel rr.err) { ret 1; }
    var rep: VerifyReport = rr.ok;
    fin { dnit_report(?rep); }
    if (rep.len == 0) { ret 1; }
    if (rep.violations[0].instr != id.INSTR_NIL) { ret 1; }

    val described: res[str, fail.Fail] = describe_located(?env.m, ?rep.violations[0], ?itn, ?smap, ?env.alloc);
    if (sel described.err) { ret 2; }
    val msg: str = described.ok;
    fin { str_free(?env.alloc, msg); }

    var code: i32 = 0;
    if (!str_contains(msg, "terminator presence"))                              { code = 1; }
    if (!str_contains(msg, "probe.mod.offender"))                               { code = 1; }
    if (!str_contains(msg, "no source location available for this check"))      { code = 1; }

    if (code != 0) { ret code; }
    ret t_describe_refusals(?env.m, ?rep.violations[0], ?itn, ?smap, "probe.mod.offender");
}

fun t_drop(env: *TEnv, b: id.BlockId, iid: id.InstructionId) bool {
    val fn: *ir.Function = ?env.m.functions[0];
    if (b::u32 >= fn.block_count) { ret false; }
    val blk: *ir.Block = ?fn.blocks[b::u32];
    var i: u32 = 0;
    for (i < blk.instr_count) {
        if (blk.instructions[i] == iid) {
            var j: u32 = i;
            for (j + 1 < blk.instr_count) { blk.instructions[j] = blk.instructions[j + 1]; j = j + 1; }
            blk.instr_count = blk.instr_count - 1;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

