# a select takes an i8 condition and two choices of its own integer or
# pointer type; a wider condition or a choice of another type is refused
test check_type_agree__select_shape {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    val i8r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 8);
    if (sel i8r.err) { ret 1; }
    val i32r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 32);
    if (sel i32r.err) { ret 1; }

    builder.set_block(?env.bld, b0);
    val cond: value.Value                 = value.const_int(1, i8r.ok);
    val good: res[value.Value, fail.Fail] = builder.emit_select(?env.bld, cond, t_ci(?env, 1), t_ci(?env, 2));
    if (sel good.err) { ret 1; }
    val r_ret: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_ret.err)                   { ret 1; }
    if (t_total(?env, false, true) != 0) { ret 2; }

    val sel_i: *ir_instruction.Instruction = ?env.m.functions[0].instrs[good.ok.data.instr::u32];
    sel_i.operands[0] = t_ci(?env, 1);
    if (t_count(?env, false, true, VC_TYPE_AGREE) != 1) { ret 3; }
    sel_i.operands[0] = cond;
    sel_i.operands[2] = value.const_int(2, i32r.ok);
    if (t_count(?env, false, true, VC_TYPE_AGREE) != 1) { ret 4; }
    ret 0;
}

