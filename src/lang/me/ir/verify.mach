    if (sel r_2027.err) { ret 1; }
    val r_2028: res[value.Value, fail.Fail] = builder.emit_vcompare(?env.bld, instruction.OP_CMP_EQ, v, v, maskty);
    if (sel r_2028.err) { ret 1; }
    val r_2029: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2029.err) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_call_arg_types:aggregate_arg_pointer_mistype" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    val agr: res[type.IrTypeId, fail.Fail] = type.intern_array(?env.m.types, env.i64ty, 4);
    if (sel agr.err) { ret 1; }
    val aggty: type.IrTypeId = agr.ok;
    val pr: res[type.IrTypeId, fail.Fail] = type.intern_ptr(?env.m.types);
    if (sel pr.err) { ret 1; }
    val ptrty: type.IrTypeId = pr.ok;

    var pbuf: type.IrTypeId = aggty;
    val sr: res[type.IrTypeId, fail.Fail] = type.intern_fn(?env.m.types, env.i64ty, ?pbuf, 1, false);
    if (sel sr.err) { ret 1; }
    val calleesig: type.IrTypeId = sr.ok;
    val cfr: res[u32, fail.Fail] = ir.function_add(?env.m, intern.STR_NIL, calleesig, ir.FN_FLAG_EXTERN);
    if (sel cfr.err) { ret 1; }
    val cidx: u32 = cfr.ok;

    var abuf: value.Value = value.param(0, aggty);
    val callr: res[value.Value, fail.Fail] = builder.emit_call(?env.bld, value.fn(cidx, calleesig), ?abuf, 1, env.i64ty);
    if (sel callr.err) { ret 1; }
    val callv: value.Value = callr.ok;
    val r_2062: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2062.err) { ret 1; }

    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) != 0) { ret 1; }

    val cid: id.InstructionId = callv.data.instr;
    env.m.functions[0].instrs[cid].operands[1].ty = ptrty;

    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) < 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_call_arg_types:vector_param_accepts_by_address_arg" {
    var env: TEnv;
