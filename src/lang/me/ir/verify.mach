    val ei: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 32);
    if (sel ei.err) { ret 1; }
    val vr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, ei.ok, 4);
