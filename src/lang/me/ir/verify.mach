test "mach.lang.me.ir.verify.check_convert_width:aggregate_bitcast_must_keep_size" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }

    var fields: [2]type.IrTypeId;
    fields[0] = env.i64ty;
    fields[1] = env.i64ty;
    val big_r: res[type.IrTypeId, fail.Fail] = type.intern_struct(?env.m.types, ?fields[0], 2, 0, false);
    if (sel big_r.err) { ret 1; }
    val big: type.IrTypeId = big_r.ok;
    val small_r: res[type.IrTypeId, fail.Fail] = type.intern_struct(?env.m.types, ?env.i64ty, 1, 0, false);
    if (sel small_r.err) { ret 1; }
    val small: type.IrTypeId = small_r.ok;

    val b0: id.BlockId = t_block(?env);
    builder.set_block(?env.bld, b0);
    val slot_r: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, big, t_ci(?env, 1));
    if (sel slot_r.err) { ret 1; }
    val agg: value.Value = value.retype(slot_r.ok, big);
    val bad: res[value.Value, fail.Fail] = builder.emit_bitcast(?env.bld, agg, small);
    if (sel bad.err) { ret 1; }
    val r_1721: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1721.err) { ret 1; }

    if (t_count(?env, false, false, VC_CONVERT_WIDTH) != 1) { ret 1; }
    if (t_count(?env, false, true,  VC_CONVERT_WIDTH) != 1) { ret 1; }
    if (t_count(?env, false, false, VC_BITCAST_CLASS) != 0) { ret 1; }

    var ok_env: TEnv;
    fin { target.registry_dnit(?ok_env.registry); }
    if (!t_env(?ok_env)) { ret 1; }
    var ofields: [2]type.IrTypeId;
    ofields[0] = ok_env.i64ty;
    ofields[1] = ok_env.i64ty;
    val ost_r: res[type.IrTypeId, fail.Fail] = type.intern_struct(?ok_env.m.types, ?ofields[0], 2, 0, false);
    if (sel ost_r.err) { ret 1; }
    val ost: type.IrTypeId = ost_r.ok;
    val oar_r: res[type.IrTypeId, fail.Fail] = type.intern_array(?ok_env.m.types, ok_env.i64ty, 2);
    if (sel oar_r.err) { ret 1; }
    val oar: type.IrTypeId = oar_r.ok;

    val ob0: id.BlockId = t_block(?ok_env);
    builder.set_block(?ok_env.bld, ob0);
    val oslot_r: res[value.Value, fail.Fail] = builder.emit_alloca(?ok_env.bld, ost, t_ci(?ok_env, 1));
    if (sel oslot_r.err) { ret 1; }
    val oagg: value.Value = value.retype(oslot_r.ok, ost);
    val good: res[value.Value, fail.Fail] = builder.emit_bitcast(?ok_env.bld, oagg, oar);
    if (sel good.err) { ret 1; }

    val pr: res[type.IrTypeId, fail.Fail] = type.intern_ptr(?ok_env.m.types);
    if (sel pr.err) { ret 1; }
    val pty: type.IrTypeId = pr.ok;
    val pbc: res[value.Value, fail.Fail] = builder.emit_bitcast(?ok_env.bld, value.const_null(pty), pty);
    if (sel pbc.err) { ret 1; }
    val r_1753: err[fail.Fail] = builder.emit_ret_void(?ok_env.bld);
    if (sel r_1753.err) { ret 1; }

    if (t_count(?ok_env, false, false, VC_CONVERT_WIDTH) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_convert_width:direction_per_opcode" {
    var bad: i32 = 0;
    if (t_convert(instruction.OP_TRUNC, 8,  32) != 1) { bad = 1; }
    if (t_convert(instruction.OP_SEXT,  32, 8)  != 1) { bad = 1; }
    if (t_convert(instruction.OP_ZEXT,  32, 8)  != 1) { bad = 1; }
    if (t_convert(instruction.OP_TRUNC, 32, 32) != 1) { bad = 1; }
    if (t_convert(instruction.OP_SEXT,  32, 32) != 1) { bad = 1; }
    if (t_convert(instruction.OP_ZEXT,  32, 32) != 1) { bad = 1; }

    if (t_convert(instruction.OP_TRUNC, 32, 8)  != 0) { bad = 1; }
    if (t_convert(instruction.OP_SEXT,  8,  32) != 0) { bad = 1; }
    if (t_convert(instruction.OP_ZEXT,  8,  32) != 0) { bad = 1; }
    ret bad;
}

fun t_convert(k: instruction.InstrKind, from: u32, to: u32) i64 {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret -1; }

    val fr: res[type.IrTypeId, fail.Fail] = type.intern_int(?env.m.types, from);
    if (sel fr.err) { ret -1; }
    val fty: type.IrTypeId = fr.ok;
    val tr: res[type.IrTypeId, fail.Fail] = type.intern_int(?env.m.types, to);
    if (sel tr.err) { ret -1; }
    val tty: type.IrTypeId = tr.ok;

    val b0: id.BlockId = t_block(?env);
    builder.set_block(?env.bld, b0);
    val src: value.Value = value.const_int(1, fty);

    var e: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].err{fail.message("unset")};
    if (k == instruction.OP_SEXT) { e = builder.emit_sext(?env.bld, src, tty); }
    or (k == instruction.OP_ZEXT) { e = builder.emit_zext(?env.bld, src, tty); }
    or                            { e = builder.emit_trunc(?env.bld, src, tty); }
    if (sel e.err) { ret -1; }
    val r_1795: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1795.err) { ret -1; }

    ret t_count(?env, false, false, VC_CONVERT_WIDTH);
}

