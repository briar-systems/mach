use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use A: std.allocator;

use T:          std.allocator.testing;
use std_format: std.format;
use std.text.string.str_dup;
use std.text.string.str_free;
use std.types.string.str_equals;

use mach.lang.fail;
use mach.lang.intern;
use mach.lang.layout;
use me_ir: mach.lang.me.ir;
use mach.lang.me.ir.builder;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lang_source: mach.lang.source;
use lang_target: mach.lang.target;
use mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;
use mach.lang.type;
use mach.lang.wide;

def VerifyCheck: u8;

val VC_SSA:             VerifyCheck = 0;
val VC_TERM_PRESENCE:   VerifyCheck = 1;
val VC_TERM_UNIQUE:     VerifyCheck = 2;
val VC_SUCC_EXISTS:     VerifyCheck = 3;
val VC_PRED_CONSISTENT: VerifyCheck = 4;
val VC_PHI_COVERAGE:    VerifyCheck = 5;
val VC_OPERAND_TYPE:    VerifyCheck = 6;
val VC_CONST_TYPE:      VerifyCheck = 7;
val VC_DOMINANCE:       VerifyCheck = 8;
val VC_REACHABILITY:    VerifyCheck = 9;

pub val VC_AGG_ADDRESS: VerifyCheck = 10;

val VC_TYPE_RESOLVE: VerifyCheck = 11;

val VC_DANGLING_ID: VerifyCheck = 12;

val VC_TYPE_AGREE: VerifyCheck = 13;

val VC_CALL_ARG_TYPE: VerifyCheck = 14;

val VC_BITCAST_CLASS: VerifyCheck = 15;

val VC_CONVERT_WIDTH: VerifyCheck = 16;

val VC_DANGLING_OPERAND: VerifyCheck = 17;

val VC_VOLATILE_FORM: VerifyCheck = 18;

val VC_OPCODE_KNOWN: VerifyCheck = 19;
val VC_VALUE_KNOWN:  VerifyCheck = 20;

val VC_BOUNDED_FORM: VerifyCheck = 21;

pub rec Violation {
    function: u32;
    block:    ir_id.BlockId;
    instr:    ir_id.InstructionId;
    check:    VerifyCheck;
    tag:      u32;
}

pub rec VerifyReport {
    alloc:      *A.Allocator;
    violations: *Violation;
    len:        u32;
    cap:        u32;
}

val VIOLATION_SEED_CAP: u32 = 8;

rec VerifyOpts {
    tgt:  *resolved.Target;
    full: bool;
    repr: bool;
}

pub fun opts(tgt: *resolved.Target, full: bool, repr: bool) VerifyOpts {
    var o: VerifyOpts;
    o.tgt  = tgt;
    o.full = full;
    o.repr = repr;
    ret o;
}

pub fun verify_module_ext(m: *me_ir.Module, alloc: *A.Allocator, o: VerifyOpts) res[VerifyReport, fail.Fail] {
    var r: VerifyReport;
    r.alloc      = alloc;
    r.violations = nil;
    r.len        = 0;
    r.cap        = 0;

    if (m == nil) { ret res[VerifyReport, fail.Fail].ok{r}; }

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val res_fn: err[fail.Fail] = verify_function(m, ?m.functions[fi], fi, ?r, o);
        if (sel res_fn.err) {
            dnit_report(?r);
            ret res[VerifyReport, fail.Fail].err{res_fn.err};
        }
        fi = fi + 1;
    }
    ret res[VerifyReport, fail.Fail].ok{r};
}

pub fun dnit_report(r: *VerifyReport) {
    if (r == nil) { ret; }
    if (r.violations != nil && r.cap > 0) {
        A.deallocate[Violation](r.alloc, r.violations, r.cap::usize);
    }
    r.violations = nil;
    r.len        = 0;
    r.cap        = 0;
}

# the text of a check; absent for a tag outside the catalog
pub fun describe(check: VerifyCheck) opt[str] {
    if (check == VC_SSA)              { ret opt[str].some{"ssa: value defined more than once"}; }
    if (check == VC_TERM_PRESENCE)    { ret opt[str].some{"terminator presence: block has no terminator"}; }
    if (check == VC_TERM_UNIQUE)      { ret opt[str].some{"terminator uniqueness: terminator in block body"}; }
    if (check == VC_SUCC_EXISTS)      { ret opt[str].some{"successor existence: terminator targets a missing block"}; }
    if (check == VC_PRED_CONSISTENT)  { ret opt[str].some{"predecessor consistency: preds do not match incoming edges"}; }
    if (check == VC_PHI_COVERAGE)     { ret opt[str].some{"phi coverage: phi does not cover every predecessor"}; }
    if (check == VC_OPERAND_TYPE)     { ret opt[str].some{"operand typing: wrong operand arity for opcode"}; }
    if (check == VC_CONST_TYPE)       { ret opt[str].some{"constant typing: constant carries an incompatible type"}; }
    if (check == VC_DOMINANCE)        { ret opt[str].some{"dominance: operand definition does not dominate its use"}; }
    if (check == VC_REACHABILITY)     { ret opt[str].some{"reachability: block is unreachable"}; }
    if (check == VC_AGG_ADDRESS)      { ret opt[str].some{"aggregate representation: aggregate-typed operand is not address-producing"}; }
    if (check == VC_BITCAST_CLASS)    { ret opt[str].some{"bitcast crosses the value / address representation classes without materializing it"}; }
    if (check == VC_TYPE_RESOLVE)     { ret opt[str].some{"type resolution: operand or aux type does not resolve"}; }
    if (check == VC_DANGLING_ID)      { ret opt[str].some{"dangling id: a block list names an out-of-range instruction id"}; }
    if (check == VC_TYPE_AGREE)       { ret opt[str].some{"type agreement: operand types violate the opcode's typing contract"}; }
    if (check == VC_CALL_ARG_TYPE)    { ret opt[str].some{"call argument typing: a call argument's type disagrees with the callee's declared parameter"}; }
    if (check == VC_DANGLING_OPERAND) { ret opt[str].some{"dangling operand: an operand names an instruction no block list of this function holds"}; }
    if (check == VC_CONVERT_WIDTH)    { ret opt[str].some{"conversion width: a conversion's result width contradicts its opcode (a bitcast must keep the width, a truncation must narrow, an extension must widen)"}; }
    if (check == VC_VOLATILE_FORM)    { ret opt[str].some{"volatile form: the volatile flag is valid only on memory accesses"}; }
    if (check == VC_OPCODE_KNOWN)     { ret opt[str].some{"opcode: the instruction carries an InstrKind tag outside the catalog"}; }
    if (check == VC_VALUE_KNOWN)      { ret opt[str].some{"operand: an operand carries a ValueKind tag outside the catalog"}; }
    if (check == VC_BOUNDED_FORM)     { ret opt[str].some{"bounded form: the count-bounded flag is valid only on a shift"}; }
    ret opt[str].none{};
}

pub fun violation_loc(m: *me_ir.Module, v: *Violation) lang_source.SrcLoc {
    if (m == nil || v == nil)         { ret lang_source.loc_nil(); }
    if (v.function >= m.function_len) { ret lang_source.loc_nil(); }
    val fn: *me_ir.Function = ?m.functions[v.function];
    if (v.instr == ir_id.INSTR_NIL)   { ret lang_source.loc_nil(); }
    if (v.instr::u32 >= fn.instr_len) { ret lang_source.loc_nil(); }
    ret fn.instrs[v.instr].loc;
}

fun violation_scope(m: *me_ir.Module, v: *Violation, itn: *intern.Interner, alloc: *A.Allocator) res[str, fail.Fail] {
    if (itn == nil) { ret res[str, fail.Fail].err{fail.message("verification interner is absent")}; }
    var mod: str      = "<unknown module>";
    val om:  opt[str] = intern.lookup(itn, m.name);
    if (sel om.some) { mod = om.some; }

    var fname: str = "<unknown function>";
    if (v.function < m.function_len) {
        val fn: *me_ir.Function = ?m.functions[v.function];
        var nm: intern.StrId    = fn.disp;
        if (nm == intern.STR_NIL) { nm = fn.name; }
        val of: opt[str] = intern.lookup(itn, nm);
        if (sel of.some) { fname = of.some; }
    }

    val r_183: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}.{}", mod, fname);
    if (sel r_183.err) { ret res[str, fail.Fail].err{fail.format_refused(r_183.err)}; }
    ret res[str, fail.Fail].ok{r_183.ok};
}

fun violation_where(l: lang_source.SrcLoc, srcmap: *lang_source.SourceMap, alloc: *A.Allocator) res[opt[str], fail.Fail] {
    if (!lang_source.loc_is_valid(l) || srcmap == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val of: opt[*lang_source.SourceFile] = lang_source.get(srcmap, l.file);
    if (sel of.none) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val f:         *lang_source.SourceFile          = of.some;
    val p:         lang_source.Position             = lang_source.position(f, l.offset);
    val formatted: res[str, std_format.FormatError] = std_format.sprint(alloc, "{}:{}:{}", f.path, p.line, p.col);
    if (sel formatted.err) { ret res[opt[str], fail.Fail].err{fail.format_refused(formatted.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{formatted.ok}};
}

fun catalog_named(r: res[str, std_format.FormatError]) res[str, fail.Fail] {
    if (sel r.err) { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

# successful text is caller-owned, and allocation failures never produce partial descriptions
pub fun describe_located(m: *me_ir.Module, v: *Violation, itn: *intern.Interner,
    srcmap: *lang_source.SourceMap, alloc: *A.Allocator) res[str, fail.Fail] {
    if (v == nil) { ret res[str, fail.Fail].err{fail.message("verification violation is absent")}; }
    var named: res[str, fail.Fail];
    if (v.check == VC_OPCODE_KNOWN) { named = catalog_named(fail.catalog_text(alloc, fail.unknown_member("InstrKind", v.tag))); }
    or (v.check == VC_VALUE_KNOWN)  { named = catalog_named(fail.catalog_text(alloc, fail.unknown_member("ValueKind", v.tag))); }
    or {
        val text: opt[str] = describe(v.check);
        if (sel text.some) {
            val duplicated: res[str, A.Error] = str_dup(alloc, text.some);
            if (sel duplicated.err) { ret res[str, fail.Fail].err{fail.refused(duplicated.err)}; }
            named = res[str, fail.Fail].ok{duplicated.ok};
        }
        or { named = catalog_named(fail.catalog_text(alloc, fail.unknown_member("VerifyCheck", v.check::u32))); }
    }
    if (sel named.err) { ret named; }
    if (m == nil)      { ret named; }
    val what: str = named.ok;
    fin { str_free(alloc, what); }

    val scoped: res[str, fail.Fail] = violation_scope(m, v, itn, alloc);
    if (sel scoped.err) { ret scoped; }
    val scope: str = scoped.ok;
    fin { str_free(alloc, scope); }
    val located: res[opt[str], fail.Fail] = violation_where(violation_loc(m, v), srcmap, alloc);
    if (sel located.err) { ret res[str, fail.Fail].err{located.err}; }
    val where: opt[str] = located.ok;
    if (sel where.some) {
        val position: str = where.some;
        fin { str_free(alloc, position); }
        val r_227: res[str, std_format.FormatError] = std_format.sprint(alloc, "{} (in {}, at {})", what, scope, position);
        if (sel r_227.err) { ret res[str, fail.Fail].err{fail.format_refused(r_227.err)}; }
        ret res[str, fail.Fail].ok{r_227.ok};
    }
    val r_229: res[str, std_format.FormatError] = std_format.sprint(alloc, "{} (in {}; no source location available for this check)", what, scope);
    if (sel r_229.err) { ret res[str, fail.Fail].err{fail.format_refused(r_229.err)}; }
    ret res[str, fail.Fail].ok{r_229.ok};
}

fun verify_function(m: *me_ir.Module, fn: *me_ir.Function, fi: u32, r: *VerifyReport, o: VerifyOpts) err[fail.Fail] {
    if ((fn.flags & me_ir.FN_FLAG_EXTERN) != 0) { ret err[fail.Fail].ok{}; }
    if (fn.block_count == 0)                    { ret err[fail.Fail].ok{}; }

    val res_defs: err[fail.Fail] = check_definitions(fn, fi, r);
    if (sel res_defs.err) { ret res_defs; }

    val res_lists: err[fail.Fail] = check_block_lists(fn, fi, r);
    if (sel res_lists.err) { ret res_lists; }

    val res_ops: err[fail.Fail] = check_operand_defs(fn, fi, r);
    if (sel res_ops.err) { ret res_ops; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];

        val res_term: err[fail.Fail] = check_terminator_presence(fn, blk, fi, r);
        if (sel res_term.err) { ret res_term; }
        val res_uniq: err[fail.Fail] = check_terminator_unique(fn, blk, fi, r);
        if (sel res_uniq.err) { ret res_uniq; }
        val res_succ: err[fail.Fail] = check_successors(fn, blk, fi, r);
        if (sel res_succ.err) { ret res_succ; }
        val res_arity: err[fail.Fail] = check_arity_and_consts(m, fn, blk, fi, r, o);
        if (sel res_arity.err) { ret res_arity; }
        bi = bi + 1;
    }

    val res_preds: err[fail.Fail] = check_pred_consistency(fn, fi, r);
    if (sel res_preds.err) { ret res_preds; }
    val res_phis: err[fail.Fail] = check_phi_coverage(fn, fi, r);
    if (sel res_phis.err) { ret res_phis; }

    if (o.full) {
        val res_reach: err[fail.Fail] = check_reachability(fn, fi, r);
        if (sel res_reach.err) { ret res_reach; }
        val res_dom: err[fail.Fail] = check_dominance(fn, fi, r);
        if (sel res_dom.err) { ret res_dom; }
    }

    ret err[fail.Fail].ok{};
}

fun check_definitions(fn: *me_ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (fn.instr_len == 0) { ret err[fail.Fail].ok{}; }
    val res_seen: res[*u8, A.Error] = A.allocate[u8](r.alloc, fn.instr_len::usize);
    if (sel res_seen.err) { ret err[fail.Fail].err{fail.refused(res_seen.err)}; }
    val seen: *u8 = res_seen.ok;
    var i:    u32 = 0;
    for (i < fn.instr_len) {
        seen[i] = 0;
        i       = i + 1;
    }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            val rr: err[fail.Fail] = mark_def(seen, blk.phis[p], fn, bi, fi, r);
            if (sel rr.err) {
                A.deallocate[u8](r.alloc, seen, fn.instr_len::usize);
                ret rr;
            }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val rr: err[fail.Fail] = mark_def(seen, blk.instructions[ix], fn, bi, fi, r);
            if (sel rr.err) {
                A.deallocate[u8](r.alloc, seen, fn.instr_len::usize);
                ret rr;
            }
            ix = ix + 1;
        }
        if (blk.terminator != ir_id.INSTR_NIL) {
            val rr: err[fail.Fail] = mark_def(seen, blk.terminator, fn, bi, fi, r);
            if (sel rr.err) {
                A.deallocate[u8](r.alloc, seen, fn.instr_len::usize);
                ret rr;
            }
        }
        bi = bi + 1;
    }
    A.deallocate[u8](r.alloc, seen, fn.instr_len::usize);
    ret err[fail.Fail].ok{};
}

fun mark_def(seen: *u8, iid: ir_id.InstructionId, fn: *me_ir.Function, bi: u32, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (iid >= fn.instr_len) { ret err[fail.Fail].ok{}; }
    if (seen[iid] != 0) {
        ret push(r, fi, bi::ir_id.BlockId, iid, VC_SSA);
    }
    seen[iid] = 1;
    ret err[fail.Fail].ok{};
}

fun check_block_lists(fn: *me_ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            val rr: err[fail.Fail] = check_listed_id(fn, blk.phis[p], fi, blk.id, r);
            if (sel rr.err) { ret rr; }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val rr: err[fail.Fail] = check_listed_id(fn, blk.instructions[ix], fi, blk.id, r);
            if (sel rr.err) { ret rr; }
            ix = ix + 1;
        }
        if (blk.terminator != ir_id.INSTR_NIL) {
            val rr: err[fail.Fail] = check_listed_id(fn, blk.terminator, fi, blk.id, r);
            if (sel rr.err) { ret rr; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_listed_id(fn: *me_ir.Function, iid: ir_id.InstructionId, fi: u32, bid: ir_id.BlockId, r: *VerifyReport) err[fail.Fail] {
    if (iid == ir_id.INSTR_NIL || iid >= fn.instr_len) {
        ret push(r, fi, bid, iid, VC_DANGLING_ID);
    }
    ret err[fail.Fail].ok{};
}

fun check_operand_defs(fn: *me_ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (fn.instr_len == 0) { ret err[fail.Fail].ok{}; }
    val res_live: res[*u8, A.Error] = A.allocate[u8](r.alloc, fn.instr_len::usize);
    if (sel res_live.err) { ret err[fail.Fail].err{fail.refused(res_live.err)}; }
    val live: *u8 = res_live.ok;
    var i:    u32 = 0;
    for (i < fn.instr_len) {
        live[i] = 0;
        i       = i + 1;
    }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            if (blk.phis[p] < fn.instr_len) { live[blk.phis[p]] = 1; }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            if (blk.instructions[ix] < fn.instr_len) { live[blk.instructions[ix]] = 1; }
            ix = ix + 1;
        }
        if (blk.terminator != ir_id.INSTR_NIL && blk.terminator < fn.instr_len) {
            live[blk.terminator] = 1;
        }
        bi = bi + 1;
    }

    var cb: u32 = 0;
    for (cb < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[cb];
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            val rr: err[fail.Fail] = check_uses_live(fn, live, blk.phis[p], fi, blk.id, r);
            if (sel rr.err) {
                A.deallocate[u8](r.alloc, live, fn.instr_len::usize);
                ret rr;
            }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val rr: err[fail.Fail] = check_uses_live(fn, live, blk.instructions[ix], fi, blk.id, r);
            if (sel rr.err) {
                A.deallocate[u8](r.alloc, live, fn.instr_len::usize);
                ret rr;
            }
            ix = ix + 1;
        }
        if (blk.terminator != ir_id.INSTR_NIL) {
            val rr: err[fail.Fail] = check_uses_live(fn, live, blk.terminator, fi, blk.id, r);
            if (sel rr.err) {
                A.deallocate[u8](r.alloc, live, fn.instr_len::usize);
                ret rr;
            }
        }
        cb = cb + 1;
    }

    A.deallocate[u8](r.alloc, live, fn.instr_len::usize);
    ret err[fail.Fail].ok{};
}

fun check_uses_live(fn: *me_ir.Function, live: *u8, iid: ir_id.InstructionId, fi: u32, bid: ir_id.BlockId, r: *VerifyReport) err[fail.Fail] {
    if (iid >= fn.instr_len) { ret err[fail.Fail].ok{}; }
    val ins: *ir_instruction.Instruction = ?fn.instrs[iid];
    var oi:  u32                         = 0;
    for (oi < ins.operand_count) {
        val op: *value.Value = ?ins.operands[oi];
        if (op.kind == value.VAL_INSTR) {
            val def_id: ir_id.InstructionId = op.data.instr;
            if (def_id >= fn.instr_len || live[def_id] == 0) {
                val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_DANGLING_OPERAND);
                if (sel rr.err) { ret rr; }
            }
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_terminator_presence(fn: *me_ir.Function, blk: *me_ir.Block, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (blk.terminator == ir_id.INSTR_NIL) {
        ret push(r, fi, blk.id, ir_id.INSTR_NIL, VC_TERM_PRESENCE);
    }
    if (blk.terminator >= fn.instr_len) {
        ret push(r, fi, blk.id, blk.terminator, VC_TERM_PRESENCE);
    }
    val t: *ir_instruction.Instruction = ?fn.instrs[blk.terminator];
    if (!opdesc.is_terminator(t.kind)) {
        ret push(r, fi, blk.id, blk.terminator, VC_TERM_PRESENCE);
    }
    ret err[fail.Fail].ok{};
}

fun check_terminator_unique(fn: *me_ir.Function, blk: *me_ir.Block, fi: u32, r: *VerifyReport) err[fail.Fail] {
    var p: u32 = 0;
    for (p < blk.phi_count) {
        val iid: ir_id.InstructionId = blk.phis[p];
        if (iid < fn.instr_len) {
            val ins: *ir_instruction.Instruction = ?fn.instrs[iid];
            if (opdesc.is_terminator(ins.kind)) {
                val rr: err[fail.Fail] = push(r, fi, blk.id, iid, VC_TERM_UNIQUE);
                if (sel rr.err) { ret rr; }
            }
        }
        p = p + 1;
    }
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        val iid: ir_id.InstructionId = blk.instructions[ix];
        if (iid < fn.instr_len) {
            val ins: *ir_instruction.Instruction = ?fn.instrs[iid];
            if (opdesc.is_terminator(ins.kind)) {
                val rr: err[fail.Fail] = push(r, fi, blk.id, iid, VC_TERM_UNIQUE);
                if (sel rr.err) { ret rr; }
            }
        }
        ix = ix + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_successors(fn: *me_ir.Function, blk: *me_ir.Block, fi: u32, r: *VerifyReport) err[fail.Fail] {
    var s0: ir_id.BlockId = ir_id.BLOCK_NIL;
    var s1: ir_id.BlockId = ir_id.BLOCK_NIL;
    val sc: u32           = me_ir.block_successors(fn, blk, ?s0, ?s1);

    if (sc >= 1 && s0 >= fn.block_count) {
        val rr: err[fail.Fail] = push(r, fi, blk.id, blk.terminator, VC_SUCC_EXISTS);
        if (sel rr.err) { ret rr; }
    }
    if (sc >= 2 && s1 >= fn.block_count) {
        val rr: err[fail.Fail] = push(r, fi, blk.id, blk.terminator, VC_SUCC_EXISTS);
        if (sel rr.err) { ret rr; }
    }
    ret err[fail.Fail].ok{};
}

fun check_arity_and_consts(m: *me_ir.Module, fn: *me_ir.Function, blk: *me_ir.Block, fi: u32, r: *VerifyReport, o: VerifyOpts) err[fail.Fail] {
    var p: u32 = 0;
    for (p < blk.phi_count) {
        val rr: err[fail.Fail] = check_one_instr(m, fn, blk.phis[p], fi, blk.id, r, o);
        if (sel rr.err) { ret rr; }
        p = p + 1;
    }
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        val rr: err[fail.Fail] = check_one_instr(m, fn, blk.instructions[ix], fi, blk.id, r, o);
        if (sel rr.err) { ret rr; }
        ix = ix + 1;
    }
    if (blk.terminator != ir_id.INSTR_NIL) {
        val rr: err[fail.Fail] = check_one_instr(m, fn, blk.terminator, fi, blk.id, r, o);
        if (sel rr.err) { ret rr; }
    }
    ret err[fail.Fail].ok{};
}

fun check_one_instr(m: *me_ir.Module, fn: *me_ir.Function, iid: ir_id.InstructionId, fi: u32, bid: ir_id.BlockId, r: *VerifyReport, o: VerifyOpts) err[fail.Fail] {
    if (iid >= fn.instr_len) { ret err[fail.Fail].ok{}; }
    val ins: *ir_instruction.Instruction = ?fn.instrs[iid];

    val r_502: res[*opdesc.IrOpDescriptor, fail.Fail] = opdesc.describe(ins.kind);
    if (sel r_502.err) {
        val rk: err[fail.Fail] = push(r, fi, bid, iid, VC_OPCODE_KNOWN);
        if (sel rk.err) { ret rk; }
        r.violations[r.len - 1].tag = ins.kind::u32;
        ret err[fail.Fail].ok{};
    }

    if ((ins.flags & ir_instruction.INSTR_FLAG_VOLATILE) != 0
        && !opdesc.accepts_volatile(ins.kind)) {
        val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_VOLATILE_FORM);
        if (sel rr.err) { ret rr; }
    }

    if ((ins.flags & ir_instruction.INSTR_FLAG_COUNT_BOUNDED) != 0 && ins.kind != ir_instruction.OP_SHL
        && ins.kind != ir_instruction.OP_SHR_U && ins.kind != ir_instruction.OP_SHR_S) {
        val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_BOUNDED_FORM);
        if (sel rr.err) { ret rr; }
    }

    if (!arity_ok(ins.kind, ins.operand_count)) {
        val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_OPERAND_TYPE);
        if (sel rr.err) { ret rr; }
    }

    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val op: *value.Value = ?ins.operands[oi];
        if (op.kind > value.VAL_CONST_AGG) {
            val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_VALUE_KNOWN);
            if (sel rr.err) { ret rr; }
            r.violations[r.len - 1].tag = op.kind::u32;
            ret err[fail.Fail].ok{};
        }
        if (!const_type_ok(m, op) && !(ins.kind == ir_instruction.OP_CONST && zero_int_vector(m, op))) {
            val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_CONST_TYPE);
            if (sel rr.err) { ret rr; }
        }
        if (o.repr) {
            if (op.ty != ir_type.IRT_NIL) {
                val ot: opt[*ir_type.IrType] = ir_type.get(?m.types, op.ty);
                if (!sel ot.some || !ir_type.reference_valid(?m.types, op.ty)) {
                    val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_TYPE_RESOLVE);
                    if (sel rr.err) { ret rr; }
                }
            }
            val dbg_unavailable: bool = ins.kind == ir_instruction.OP_DBG_VALUE
                && op.kind == value.VAL_CONST_NULL;
            if (ir_type.is_aggregate(?m.types, op.ty) && !dbg_unavailable
                && !agg_value_is_address_producing(fn, op)) {
                val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_AGG_ADDRESS);
                if (sel rr.err) { ret rr; }
            }
        }
        oi = oi + 1;
    }
    if (o.repr) {
        val res_aux: err[fail.Fail] = check_aux_resolve(m, ins, fi, bid, iid, r);
        if (sel res_aux.err) { ret res_aux; }
        val res_agree: err[fail.Fail] = check_type_agree(m, ins, fi, bid, iid, r);
        if (sel res_agree.err) { ret res_agree; }
    }
    val res_bc: err[fail.Fail] = check_bitcast_class(m, ins, fi, bid, iid, r);
    if (sel res_bc.err) { ret res_bc; }
    val res_call: err[fail.Fail] = check_call_arg_types(m, ins, fi, bid, iid, r);
    if (sel res_call.err) { ret res_call; }
    val res_cw: err[fail.Fail] = check_convert_width(m, ins, fi, bid, iid, r, o.tgt);
    if (sel res_cw.err) { ret res_cw; }
    ret err[fail.Fail].ok{};
}

fun vector_lanes_of(m: *me_ir.Module, ty: ir_type.IrTypeId) u32 {
    val o: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (sel o.none)                        { ret 0; }
    if (o.some.kind != ir_type.IRT_VECTOR) { ret 0; }
    ret o.some.data.vector_.lanes;
}

fun check_convert_width(m: *me_ir.Module, ins: *ir_instruction.Instruction, fi: u32, bid: ir_id.BlockId, iid: ir_id.InstructionId, r: *VerifyReport, tgt: *resolved.Target) err[fail.Fail] {
    val k:       ir_instruction.InstrKind = ins.kind;
    val narrows: bool                     = k == ir_instruction.OP_TRUNC || k == ir_instruction.OP_FP_TRUNC;
    val widens:  bool                     = k == ir_instruction.OP_SEXT || k == ir_instruction.OP_ZEXT
        || k == ir_instruction.OP_FP_EXT;
    val keeps:   bool = k == ir_instruction.OP_BITCAST;
    val convert: bool = opdesc.vec_class(k) == opdesc.VCLASS_CONVERT;
    if (!narrows && !widens && !keeps && !convert) { ret err[fail.Fail].ok{}; }
    if (ins.operand_count < 1)                     { ret err[fail.Fail].ok{}; }

    val src: ir_type.IrTypeId = (?ins.operands[0]).ty;
    var sw:  u32              = 0;
    var dw:  u32              = 0;
    # a conversion is lane-wise: both sides are vectors of one lane count, and
    # the direction is judged per lane
    if (convert && (ir_type.is_vector(?m.types, src) || ir_type.is_vector(?m.types, ins.ty))) {
        val sl: u32 = vector_lanes_of(m, src);
        val dl: u32 = vector_lanes_of(m, ins.ty);
        if (sl == 0 || dl == 0 || sl != dl) { ret push(r, fi, bid, iid, VC_CONVERT_WIDTH); }
        sw = ir_type.bit_width(?m.types, src) / sl;
        dw = ir_type.bit_width(?m.types, ins.ty) / dl;
    }
    or {
        sw = ir_type.bit_width(?m.types, src);
        dw = ir_type.bit_width(?m.types, ins.ty);
    }
    if (!narrows && !widens && !keeps) { ret err[fail.Fail].ok{}; }
    if (keeps && ir_type.is_aggregate(?m.types, src) && ir_type.is_aggregate(?m.types, ins.ty)) {
        val machine: layout.Machine = resolved.layout_machine(tgt);
        if (ir_type.byte_size_for_machine(?m.types, src, machine)
            == ir_type.byte_size_for_machine(?m.types, ins.ty, machine)) {
            ret err[fail.Fail].ok{};
        }
        ret push(r, fi, bid, iid, VC_CONVERT_WIDTH);
    }

    if (sw == 0 || dw == 0) { ret err[fail.Fail].ok{}; }

    if (narrows && dw < sw) { ret err[fail.Fail].ok{}; }
    if (widens && dw > sw)  { ret err[fail.Fail].ok{}; }
    if (keeps && dw == sw)  { ret err[fail.Fail].ok{}; }
    ret push(r, fi, bid, iid, VC_CONVERT_WIDTH);
}

fun check_aux_resolve(m: *me_ir.Module, ins: *ir_instruction.Instruction, fi: u32, bid: ir_id.BlockId, iid: ir_id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (!opdesc.has(ins.kind, opdesc.EFF_USES_AUX_TYPE))             { ret err[fail.Fail].ok{}; }
    if (ins.kind == ir_instruction.OP_GEP && ins.operand_count <= 1) { ret err[fail.Fail].ok{}; }
    val ty: ir_type.IrTypeId = ins.aux_ty;

    val at: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (!sel at.some)                           { ret push(r, fi, bid, iid, VC_TYPE_RESOLVE); }
    if (!ir_type.reference_valid(?m.types, ty)) { ret push(r, fi, bid, iid, VC_TYPE_RESOLVE); }
    ret err[fail.Fail].ok{};
}

fun check_type_agree(m: *me_ir.Module, ins: *ir_instruction.Instruction, fi: u32, bid: ir_id.BlockId, iid: ir_id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    val k: ir_instruction.InstrKind = ins.kind;

    if (is_binary_agree(k) && ins.operand_count == 2) {
        val t0: ir_type.IrTypeId = ins.operands[0].ty;
        val t1: ir_type.IrTypeId = ins.operands[1].ty;
        if (t0 != t1 && !(is_pointerish(m, t0) && is_pointerish(m, t1))) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (ins.operand_count >= 1 && ir_type.is_vector(?m.types, ins.operands[0].ty)) {
        val vt: ir_type.IrTypeId = ins.operands[0].ty;
        if (is_vector_compare(k)) {
            if (ins.operand_count == 2 && ins.operands[1].ty != vt) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
            if (!vector_mask_shape_ok(m, vt, ins.ty))               { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        }
        or (is_vector_sameshape(k)) {
            if (ins.operand_count == 2 && ins.operands[1].ty != vt) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
            if (ins.ty != vt)                                       { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        }
        or (opdesc.lower_route(k) == opdesc.LOWER_SHIFT) {
            if (ins.operand_count != 2 || !vector_shift_count_ok(m, vt, ins.operands[1].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
            if (ins.ty != vt)                                                                { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        }
    }
    if (opdesc.vec_class(k) == opdesc.VCLASS_WIDEN) {
        if (ins.operand_count == 3) {
            if (!widen_half_mul_shape_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        }
        or (ins.operand_count != 2 || !widen_shape_ok(m, ins.operands[0].ty, ins.ty)) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (opdesc.vec_class(k) == opdesc.VCLASS_CONCAT) {
        if (!concat_shape_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (opdesc.vec_class(k) == opdesc.VCLASS_WIDEN_HALF) {
        if (ins.operand_count != 2 || !widen_half_shape_ok(m, ins)) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (opdesc.vec_class(k) == opdesc.VCLASS_WIDEN_SUM) {
        if (ins.operand_count != 1 || !widen_sum_shape_ok(m, ins)) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (opdesc.vec_class(k) == opdesc.VCLASS_RANGE) {
        if (ins.operand_count != 2 || !range_shape_ok(m, ins)) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (k == ir_instruction.OP_MUL_HIGH_S || k == ir_instruction.OP_MUL_HIGH_U) {
        if (ins.operand_count != 2 || !mul_high_shape_ok(m, ins.operands[0].ty, ins.ty)) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (k == ir_instruction.OP_VEC_SIGN_MASK) {
        if (ins.operand_count != 1 || !sign_mask_shape_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_MASK_LT_U) {
        if (ins.operand_count != 2 || !scalar_int(m, ins.operands[0].ty) || !scalar_int(m, ins.ty)) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (k == ir_instruction.OP_SELECT) {
        if (ins.operand_count != 3 || !select_shape_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_CONST) {
        if (!const_shape_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_VEC_EXTRACT && ins.operand_count == 2) {
        if (!vector_lane_op_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_VEC_INSERT && ins.operand_count == 3) {
        if (!vector_lane_op_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_VEC_BUILD) {
        if (!vector_build_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_LOAD && ins.operand_count >= 1) {
        if (!is_address_typed(m, ins.operands[0].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_STORE && ins.operand_count >= 2) {
        if (!is_address_typed(m, ins.operands[1].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_GEP && ins.operand_count >= 1) {
        if (!is_address_typed(m, ins.operands[0].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_MEMZERO && ins.operand_count >= 1) {
        if (!is_address_typed(m, ins.operands[0].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_BR && ins.operand_count >= 1) {
        if (ins.operands[0].kind != value.VAL_CONST_INT) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == ir_instruction.OP_CBR && ins.operand_count >= 3) {
        if (!type_has_kind(m, ins.operands[0].ty, ir_type.IRT_INT)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        if (ins.operands[1].kind != value.VAL_CONST_INT)            { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        if (ins.operands[2].kind != value.VAL_CONST_INT)            { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    ret err[fail.Fail].ok{};
}

fun check_bitcast_class(m: *me_ir.Module, ins: *ir_instruction.Instruction, fi: u32, bid: ir_id.BlockId, iid: ir_id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind != ir_instruction.OP_BITCAST) { ret err[fail.Fail].ok{}; }
    if (ins.operand_count < 1)                 { ret err[fail.Fail].ok{}; }
    val src: ir_type.IrTypeId = (?ins.operands[0]).ty;
    if (src == ir_type.IRT_NIL || ins.ty == ir_type.IRT_NIL) { ret err[fail.Fail].ok{}; }
    if (ir_type.is_aggregate(?m.types, src) == ir_type.is_aggregate(?m.types, ins.ty)) {
        ret err[fail.Fail].ok{};
    }
    ret push(r, fi, bid, iid, VC_BITCAST_CLASS);
}

fun check_call_arg_types(m: *me_ir.Module, ins: *ir_instruction.Instruction, fi: u32, bid: ir_id.BlockId, iid: ir_id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind != ir_instruction.OP_CALL) { ret err[fail.Fail].ok{}; }
    if (ins.operand_count == 0)             { ret err[fail.Fail].ok{}; }

    val ot: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.aux_ty);
    if (!sel ot.some) { ret err[fail.Fail].ok{}; }
    val sig: *ir_type.IrType = ot.some;
    if (sig.kind != ir_type.IRT_FN) { ret err[fail.Fail].ok{}; }

    val pc: u32 = sig.data.fn.param_count;
    var i:  u32 = 0;
    for (i < pc) {
        val argix: u32 = i + 1;
        if (argix >= ins.operand_count) { ret err[fail.Fail].ok{}; }
        if (!call_arg_type_ok(m, sig.data.fn.params[i], ins.operands[argix].ty)) {
            val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_CALL_ARG_TYPE);
            if (sel rr.err) { ret rr; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun call_arg_type_ok(m: *me_ir.Module, p: ir_type.IrTypeId, q: ir_type.IrTypeId) bool {
    if (p == q)                                       { ret true; }
    if (p == ir_type.IRT_NIL || q == ir_type.IRT_NIL) { ret true; }
    if (ir_type.is_vector(?m.types, p))               { ret is_pointerish(m, q) || ir_type.is_aggregate(?m.types, q); }
    if (ir_type.is_aggregate(?m.types, p))            { ret ir_type.is_aggregate(?m.types, q); }
    if (is_pointerish(m, p) && is_pointerish(m, q))   { ret true; }
    ret false;
}

fun is_binary_agree(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_OPERANDS_AGREE);
}

fun is_vector_compare(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}

fun is_vector_sameshape(k: ir_instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_VEC_SAMESHAPE);
}

# a vector shift counts by lanes of its own shape or by one uniform count of
# its lane type (#3740)
fun vector_shift_count_ok(m: *me_ir.Module, vt: ir_type.IrTypeId, count_ty: ir_type.IrTypeId) bool {
    if (count_ty == vt) { ret true; }
    val ov: opt[*ir_type.IrType] = ir_type.get(?m.types, vt);
    if (sel ov.none) { ret false; }
    ret ov.some.kind == ir_type.IRT_VECTOR && ov.some.data.vector_.element == count_ty;
}

fun vector_mask_shape_ok(m: *me_ir.Module, vt: ir_type.IrTypeId, result_ty: ir_type.IrTypeId) bool {
    val ov:  opt[*ir_type.IrType] = ir_type.get(?m.types, vt);
    val orr: opt[*ir_type.IrType] = ir_type.get(?m.types, result_ty);
    if (!sel ov.some)  { ret false; }
    if (!sel orr.some) { ret false; }
    val v:  *ir_type.IrType = ov.some;
    val rr: *ir_type.IrType = orr.some;
    if (v.kind != ir_type.IRT_VECTOR || rr.kind != ir_type.IRT_VECTOR) { ret false; }
    if (v.data.vector_.lanes != rr.data.vector_.lanes)                 { ret false; }

    val ove: opt[*ir_type.IrType] = ir_type.get(?m.types, v.data.vector_.element);
    val ore: opt[*ir_type.IrType] = ir_type.get(?m.types, rr.data.vector_.element);
    if (!sel ove.some) { ret false; }
    if (!sel ore.some) { ret false; }
    val re: *ir_type.IrType = ore.some;
    if (re.kind != ir_type.IRT_INT) { ret false; }
    ret ove.some.data.bits == re.data.bits;
}

# a widening multiply takes integer lanes to integer lanes twice as wide, lane for lane
# a widening multiply doubles its integer width: lane-wise over two vectors
# of one lane count, or over two scalar integers (#3511)
fun widen_shape_ok(m: *me_ir.Module, vt: ir_type.IrTypeId, result_ty: ir_type.IrTypeId) bool {
    val ov:  opt[*ir_type.IrType] = ir_type.get(?m.types, vt);
    val orr: opt[*ir_type.IrType] = ir_type.get(?m.types, result_ty);
    if (!sel ov.some)  { ret false; }
    if (!sel orr.some) { ret false; }
    val v:  *ir_type.IrType = ov.some;
    val rr: *ir_type.IrType = orr.some;
    if (v.kind == ir_type.IRT_INT && rr.kind == ir_type.IRT_INT)       { ret rr.data.bits == v.data.bits * 2; }
    if (v.kind != ir_type.IRT_VECTOR || rr.kind != ir_type.IRT_VECTOR) { ret false; }
    if (v.data.vector_.lanes != rr.data.vector_.lanes)                 { ret false; }
    val ove: opt[*ir_type.IrType] = ir_type.get(?m.types, v.data.vector_.element);
    val ore: opt[*ir_type.IrType] = ir_type.get(?m.types, rr.data.vector_.element);
    if (!sel ove.some) { ret false; }
    if (!sel ore.some) { ret false; }
    val ve: *ir_type.IrType = ove.some;
    val re: *ir_type.IrType = ore.some;
    if (ve.kind != ir_type.IRT_INT || re.kind != ir_type.IRT_INT) { ret false; }
    ret re.data.bits == ve.data.bits * 2;
}

# a widening group sum takes an integer vector of n lanes of w bits to one of
# n * w / W lanes of W bits, W a wider multiple of w (#4161)
fun widen_sum_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    val ov:  opt[*ir_type.IrType] = ir_type.get(?m.types, ins.operands[0].ty);
    val orr: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel ov.some)  { ret false; }
    if (!sel orr.some) { ret false; }
    val v:  *ir_type.IrType = ov.some;
    val rr: *ir_type.IrType = orr.some;
    if (v.kind != ir_type.IRT_VECTOR || rr.kind != ir_type.IRT_VECTOR) { ret false; }
    val ove: opt[*ir_type.IrType] = ir_type.get(?m.types, v.data.vector_.element);
    val ore: opt[*ir_type.IrType] = ir_type.get(?m.types, rr.data.vector_.element);
    if (!sel ove.some) { ret false; }
    if (!sel ore.some) { ret false; }
    val ve: *ir_type.IrType = ove.some;
    val re: *ir_type.IrType = ore.some;
    if (ve.kind != ir_type.IRT_INT || re.kind != ir_type.IRT_INT) { ret false; }
    if (ve.data.bits == 0 || re.data.bits <= ve.data.bits)        { ret false; }
    if (re.data.bits % ve.data.bits != 0)                         { ret false; }
    ret v.data.vector_.lanes == rr.data.vector_.lanes * (re.data.bits / ve.data.bits);
}

# a lane sign mask keeps its integer vector's type (#4198)
fun sign_mask_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    if (ins.operands[0].ty != ins.ty) { ret false; }
    val ov: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel ov.some)                       { ret false; }
    if (ov.some.kind != ir_type.IRT_VECTOR) { ret false; }
    val oe: opt[*ir_type.IrType] = ir_type.get(?m.types, ov.some.data.vector_.element);
    ret sel oe.some && oe.some.kind == ir_type.IRT_INT;
}

# a lane-halving extension takes an integer vector of 2N lanes to N lanes
# twice as wide, from its low half (base 0) or its high half (base N) (#3738)
fun widen_half_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    val ov:  opt[*ir_type.IrType] = ir_type.get(?m.types, ins.operands[0].ty);
    val orr: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel ov.some)  { ret false; }
    if (!sel orr.some) { ret false; }
    val v:  *ir_type.IrType = ov.some;
    val rr: *ir_type.IrType = orr.some;
    if (v.kind != ir_type.IRT_VECTOR || rr.kind != ir_type.IRT_VECTOR) { ret false; }
    if (v.data.vector_.lanes != rr.data.vector_.lanes * 2)             { ret false; }
    val ove: opt[*ir_type.IrType] = ir_type.get(?m.types, v.data.vector_.element);
    val ore: opt[*ir_type.IrType] = ir_type.get(?m.types, rr.data.vector_.element);
    if (!sel ove.some) { ret false; }
    if (!sel ore.some) { ret false; }
    val ve: *ir_type.IrType = ove.some;
    val re: *ir_type.IrType = ore.some;
    if (ve.kind != ir_type.IRT_INT || re.kind != ir_type.IRT_INT) { ret false; }
    if (re.data.bits != ve.data.bits * 2)                         { ret false; }
    if (ins.operands[1].kind != value.VAL_CONST_INT)              { ret false; }
    val base: u64 = ins.operands[1].data.int_lit;
    ret base == 0 || base == rr.data.vector_.lanes::u64;
}

# the widening multiply of one half: two 2n-lane integer vectors of one type,
# the constant 0 or n, and n lanes twice as wide (#3589)
fun widen_half_mul_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    if (ins.operands[0].ty != ins.operands[1].ty) { ret false; }
    val ov:  opt[*ir_type.IrType] = ir_type.get(?m.types, ins.operands[0].ty);
    val orr: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel ov.some)  { ret false; }
    if (!sel orr.some) { ret false; }
    val v:  *ir_type.IrType = ov.some;
    val rr: *ir_type.IrType = orr.some;
    if (v.kind != ir_type.IRT_VECTOR || rr.kind != ir_type.IRT_VECTOR) { ret false; }
    if (v.data.vector_.lanes != rr.data.vector_.lanes * 2)             { ret false; }
    val ove: opt[*ir_type.IrType] = ir_type.get(?m.types, v.data.vector_.element);
    val ore: opt[*ir_type.IrType] = ir_type.get(?m.types, rr.data.vector_.element);
    if (!sel ove.some)                                                        { ret false; }
    if (!sel ore.some)                                                        { ret false; }
    if (ove.some.kind != ir_type.IRT_INT || ore.some.kind != ir_type.IRT_INT) { ret false; }
    if (ore.some.data.bits != ove.some.data.bits * 2)                         { ret false; }
    if (ins.operands[2].kind != value.VAL_CONST_INT)                          { ret false; }
    val base: u64 = ins.operands[2].data.int_lit;
    ret base == 0 || base == rr.data.vector_.lanes::u64;
}

# a lane join takes vectors of the result's element type whose lanes sum to
# the result's (#3589)
fun concat_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    if (ins.operand_count < 2) { ret false; }
    val orr: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel orr.some) { ret false; }
    val rr: *ir_type.IrType = orr.some;
    if (rr.kind != ir_type.IRT_VECTOR) { ret false; }
    var lanes: u32 = 0;
    var i:     u32 = 0;
    for (i < ins.operand_count) {
        val ov: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.operands[i].ty);
        if (!sel ov.some) { ret false; }
        val v: *ir_type.IrType = ov.some;
        if (v.kind != ir_type.IRT_VECTOR || v.data.vector_.element != rr.data.vector_.element) { ret false; }
        lanes = lanes + v.data.vector_.lanes;
        i     = i + 1;
    }
    ret lanes == rr.data.vector_.lanes;
}

# a lane range takes n of a vector's lanes, of its element type, from a
# constant first lane that leaves all n inside the vector (#3864)
fun range_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    val ov:  opt[*ir_type.IrType] = ir_type.get(?m.types, ins.operands[0].ty);
    val orr: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel ov.some)  { ret false; }
    if (!sel orr.some) { ret false; }
    val v:  *ir_type.IrType = ov.some;
    val rr: *ir_type.IrType = orr.some;
    if (v.kind != ir_type.IRT_VECTOR || rr.kind != ir_type.IRT_VECTOR) { ret false; }
    if (v.data.vector_.element != rr.data.vector_.element)             { ret false; }
    val n: u32 = rr.data.vector_.lanes;
    if (n == 0 || n > v.data.vector_.lanes)          { ret false; }
    if (ins.operands[1].kind != value.VAL_CONST_INT) { ret false; }
    ret ins.operands[1].data.int_lit <= (v.data.vector_.lanes - n)::u64;
}

# a materialized constant is one integer or float constant of its own scalar type
fun const_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    if (ins.operand_count != 1)       { ret false; }
    if (ins.operands[0].ty != ins.ty) { ret false; }
    val ot: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel ot.some)                                  { ret false; }
    if (zero_int_vector(m, ?ins.operands[0]))          { ret true; }
    if (ins.operands[0].kind == value.VAL_CONST_INT)   { ret ot.some.kind == ir_type.IRT_INT; }
    if (ins.operands[0].kind == value.VAL_CONST_FLOAT) { ret ot.some.kind == ir_type.IRT_FLOAT; }
    ret false;
}

# the zero integer vector a `const` alone may hold (#4198)
fun zero_int_vector(m: *me_ir.Module, v: *value.Value) bool {
    if (v.kind != value.VAL_CONST_INT || !wide.is_zero(value.int_of(v))) { ret false; }
    val ov: opt[*ir_type.IrType] = ir_type.get(?m.types, v.ty);
    if (!sel ov.some)                       { ret false; }
    if (ov.some.kind != ir_type.IRT_VECTOR) { ret false; }
    val oe: opt[*ir_type.IrType] = ir_type.get(?m.types, ov.some.data.vector_.element);
    ret sel oe.some && oe.some.kind == ir_type.IRT_INT;
}

# a high-half multiply keeps its scalar integer width
fun scalar_int(m: *me_ir.Module, ty: ir_type.IrTypeId) bool {
    val ot: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (!sel ot.some) { ret false; }
    ret ot.some.kind == ir_type.IRT_INT;
}

# an i8 condition, and two choices of the result's own scalar integer or
# pointer type; pointer types agree as they do for a binary operation
fun select_shape_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    if (!scalar_int(m, ins.operands[0].ty))                   { ret false; }
    if (ir_type.bit_width(?m.types, ins.operands[0].ty) != 8) { ret false; }
    val pointer: bool = type_has_kind(m, ins.ty, ir_type.IRT_PTR);
    if (!pointer && !scalar_int(m, ins.ty)) { ret false; }
    var i: u32 = 1;
    for (i < 3) {
        val t: ir_type.IrTypeId = ins.operands[i].ty;
        if (t != ins.ty && !(pointer && type_has_kind(m, t, ir_type.IRT_PTR))) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an integer, or an integer vector taken lane by lane (#4119), of the result's type
fun mul_high_shape_ok(m: *me_ir.Module, vt: ir_type.IrTypeId, result_ty: ir_type.IrTypeId) bool {
    if (vt != result_ty) { ret false; }
    val ov: opt[*ir_type.IrType] = ir_type.get(?m.types, vt);
    if (!sel ov.some) { ret false; }
    if (ov.some.kind == ir_type.IRT_VECTOR) {
        val oe: opt[*ir_type.IrType] = ir_type.get(?m.types, ov.some.data.vector_.element);
        ret sel oe.some && oe.some.kind == ir_type.IRT_INT;
    }
    ret ov.some.kind == ir_type.IRT_INT;
}

fun vector_lane_op_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    val vt: ir_type.IrTypeId     = ins.operands[0].ty;
    val ov: opt[*ir_type.IrType] = ir_type.get(?m.types, vt);
    if (!sel ov.some) { ret false; }
    val v: *ir_type.IrType = ov.some;
    if (v.kind != ir_type.IRT_VECTOR) { ret false; }

    if (ins.operands[1].kind != value.VAL_CONST_INT)               { ret false; }
    if (ins.operands[1].data.int_lit >= v.data.vector_.lanes::u64) { ret false; }

    if (ins.kind == ir_instruction.OP_VEC_EXTRACT) {
        ret ins.ty == v.data.vector_.element;
    }
    if (ins.operands[2].ty != v.data.vector_.element) { ret false; }
    ret ins.ty == vt;
}

fun vector_build_ok(m: *me_ir.Module, ins: *ir_instruction.Instruction) bool {
    val ov: opt[*ir_type.IrType] = ir_type.get(?m.types, ins.ty);
    if (!sel ov.some) { ret false; }
    val v: *ir_type.IrType = ov.some;
    if (v.kind != ir_type.IRT_VECTOR) { ret false; }

    if (ins.operand_count != v.data.vector_.lanes) { ret false; }

    var i: u32 = 0;
    for (i < ins.operand_count) {
        if (ins.operands[i].ty != v.data.vector_.element) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun type_has_kind(m: *me_ir.Module, ty: ir_type.IrTypeId, k: ir_type.IrTypeKind) bool {
    val ot: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (!sel ot.some)                           { ret false; }
    if (!ir_type.reference_valid(?m.types, ty)) { ret false; }
    ret ot.some.kind == k;
}

fun is_address_typed(m: *me_ir.Module, ty: ir_type.IrTypeId) bool {
    if (type_has_kind(m, ty, ir_type.IRT_PTR)) { ret true; }
    ret ir_type.is_aggregate(?m.types, ty);
}

fun is_pointerish(m: *me_ir.Module, ty: ir_type.IrTypeId) bool {
    if (type_has_kind(m, ty, ir_type.IRT_FN)) { ret true; }
    ret is_address_typed(m, ty);
}

fun agg_value_is_address_producing(fn: *me_ir.Function, op: *value.Value) bool {
    if (op.kind == value.VAL_GLOBAL) { ret true; }
    if (op.kind == value.VAL_PARAM)  { ret true; }
    if (op.kind == value.VAL_INSTR) {
        val did: ir_id.InstructionId = op.data.instr;
        if (did >= fn.instr_len) { ret false; }
        ret opdesc.has((?fn.instrs[did]).kind, opdesc.EFF_MAY_BE_ADDRESS);
    }
    ret false;
}

# every block's declared predecessor list must equal, as a multiset, the
# blocks whose terminators target it; one successor sweep groups the actual
# edges by target so each block is settled by its own two lists
fun check_pred_consistency(fn: *me_ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val scratch_len: usize              = (n::usize) * 4 + 1;
    val res_scratch: res[*u32, A.Error] = A.allocate[u32](r.alloc, scratch_len);
    if (sel res_scratch.err) { ret err[fail.Fail].err{fail.refused(res_scratch.err)}; }
    val count:      *u32 = res_scratch.ok;
    val edge_start: *u32 = ?res_scratch.ok[n::usize];
    val edges:      *u32 = ?res_scratch.ok[(n::usize) * 2 + 1];
    fin { A.deallocate[u32](r.alloc, res_scratch.ok, scratch_len); }
    var z: usize = 0;
    for (z < scratch_len) {
        count[z] = 0;
        z        = z + 1;
    }

    var s: u32 = 0;
    for (s < n) {
        var s0: ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1: ir_id.BlockId = ir_id.BLOCK_NIL;
        val sc: u32           = me_ir.block_successors(fn, ?fn.blocks[s], ?s0, ?s1);
        if (sc >= 1 && s0::u32 < n) { edge_start[s0::u32 + 1] = edge_start[s0::u32 + 1] + 1; }
        if (sc >= 2 && s1::u32 < n) { edge_start[s1::u32 + 1] = edge_start[s1::u32 + 1] + 1; }
        s = s + 1;
    }
    var t: u32 = 0;
    for (t < n) {
        edge_start[t + 1] = edge_start[t + 1] + edge_start[t];
        t                 = t + 1;
    }
    s = 0;
    for (s < n) {
        var s0: ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1: ir_id.BlockId = ir_id.BLOCK_NIL;
        val sc: u32           = me_ir.block_successors(fn, ?fn.blocks[s], ?s0, ?s1);
        if (sc >= 1 && s0::u32 < n) {
            edges[edge_start[s0::u32]] = s;
            edge_start[s0::u32]        = edge_start[s0::u32] + 1;
        }
        if (sc >= 2 && s1::u32 < n) {
            edges[edge_start[s1::u32]] = s;
            edge_start[s1::u32]        = edge_start[s1::u32] + 1;
        }
        s = s + 1;
    }
    t = n;
    for (t > 0) {
        edge_start[t] = edge_start[t - 1];
        t             = t - 1;
    }
    edge_start[0] = 0;

    var ti: u32 = 0;
    for (ti < n) {
        val blk: *me_ir.Block = ?fn.blocks[ti];
        var bad: bool         = false;
        var pi:  u32          = 0;
        for (pi < blk.pred_count) {
            val p: ir_id.BlockId = blk.preds[pi];
            if (p < n) { count[p] = count[p] + 1; }
            or         { bad = true; }
            pi = pi + 1;
        }
        var e: u32 = edge_start[ti];
        for (e < edge_start[ti + 1]) {
            count[edges[e]] = count[edges[e]] - 1;
            e               = e + 1;
        }
        pi = 0;
        for (pi < blk.pred_count) {
            val p: ir_id.BlockId = blk.preds[pi];
            if (p < n) {
                if (count[p] != 0) { bad = true; }
                count[p] = 0;
            }
            pi = pi + 1;
        }
        e = edge_start[ti];
        for (e < edge_start[ti + 1]) {
            if (count[edges[e]] != 0) { bad = true; }
            count[edges[e]] = 0;
            e               = e + 1;
        }
        if (bad) {
            val rr: err[fail.Fail] = push(r, fi, ti::ir_id.BlockId, ir_id.INSTR_NIL, VC_PRED_CONSISTENT);
            if (sel rr.err) { ret rr; }
        }
        ti = ti + 1;
    }
    ret err[fail.Fail].ok{};
}

# a phi's incoming blocks must equal its block's predecessor list as a
# multiset; the balance array is settled and cleared through the two lists
# themselves, so a phi costs its own operands and predecessors, not a block
# sweep
fun check_phi_coverage(fn: *me_ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_count: res[*u32, A.Error] = A.allocate[u32](r.alloc, n::usize);
    if (sel res_count.err) { ret err[fail.Fail].err{fail.refused(res_count.err)}; }
    val count: *u32 = res_count.ok;
    fin { A.deallocate[u32](r.alloc, count, n::usize); }
    var z: u32 = 0;
    for (z < n) {
        count[z] = 0;
        z        = z + 1;
    }

    var bi: u32 = 0;
    for (bi < n) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            val iid: ir_id.InstructionId = blk.phis[p];
            if (iid < fn.instr_len) {
                val ins: *ir_instruction.Instruction = ?fn.instrs[iid];
                var bad: bool                        = false;
                if ((ins.operand_count % 2) != 0) { bad = true; }
                var o: u32 = 0;
                for (o + 1 < ins.operand_count) {
                    val src: ir_id.BlockId = me_ir.block_target(ins.operands[o]);
                    if (src < n) { count[src] = count[src] + 1; }
                    or           { bad = true; }
                    o = o + 2;
                }
                var pp: u32 = 0;
                for (pp < blk.pred_count) {
                    val pb: ir_id.BlockId = blk.preds[pp];
                    if (pb < n) { count[pb] = count[pb] - 1; }
                    pp = pp + 1;
                }
                o = 0;
                for (o + 1 < ins.operand_count) {
                    val src: ir_id.BlockId = me_ir.block_target(ins.operands[o]);
                    if (src < n) {
                        if (count[src] != 0) { bad = true; }
                        count[src] = 0;
                    }
                    o = o + 2;
                }
                pp = 0;
                for (pp < blk.pred_count) {
                    val pb: ir_id.BlockId = blk.preds[pp];
                    if (pb < n) {
                        if (count[pb] != 0) { bad = true; }
                        count[pb] = 0;
                    }
                    pp = pp + 1;
                }
                if (bad) {
                    val rr: err[fail.Fail] = push(r, fi, blk.id, iid, VC_PHI_COVERAGE);
                    if (sel rr.err) { ret rr; }
                }
            }
            p = p + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_reachability(fn: *me_ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_visited: res[*u8, A.Error] = A.allocate[u8](r.alloc, n::usize);
    if (sel res_visited.err) { ret err[fail.Fail].err{fail.refused(res_visited.err)}; }
    val visited:   *u8                = res_visited.ok;
    val res_stack: res[*u32, A.Error] = A.allocate[u32](r.alloc, n::usize);
    if (sel res_stack.err) {
        A.deallocate[u8](r.alloc, visited, n::usize);
        ret err[fail.Fail].err{fail.refused(res_stack.err)};
    }
    val stack: *u32 = res_stack.ok;

    var i: u32 = 0;
    for (i < n) {
        visited[i] = 0;
        i          = i + 1;
    }
    var sp: u32 = 0;
    visited[0] = 1;
    stack[sp]  = 0;
    sp         = sp + 1;
    for (sp > 0) {
        sp = sp - 1;
        val b:  u32           = stack[sp];
        var s0: ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1: ir_id.BlockId = ir_id.BLOCK_NIL;
        val sc: u32           = me_ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        if (sc >= 1 && s0 < n && visited[s0] == 0) {
            visited[s0] = 1;
            stack[sp]   = s0;
            sp          = sp + 1;
        }
        if (sc >= 2 && s1 < n && visited[s1] == 0) {
            visited[s1] = 1;
            stack[sp]   = s1;
            sp          = sp + 1;
        }
    }

    var bi: u32 = 1;
    for (bi < n) {
        if (visited[bi] == 0) {
            val rr: err[fail.Fail] = push(r, fi, bi::ir_id.BlockId, ir_id.INSTR_NIL, VC_REACHABILITY);
            if (sel rr.err) {
                A.deallocate[u8](r.alloc, visited, n::usize);
                A.deallocate[u32](r.alloc, stack, n::usize);
                ret rr;
            }
        }
        bi = bi + 1;
    }
    A.deallocate[u8](r.alloc, visited, n::usize);
    A.deallocate[u32](r.alloc, stack, n::usize);
    ret err[fail.Fail].ok{};
}

val DEF_BLOCK_NIL: u32 = 0xFFFFFFFF;
val RPO_NIL:       u32 = 0xFFFFFFFF;

rec DomScratch {
    rpo_num:   *u32;
    post:      *u32;
    succ_ix:   *u32;
    stack:     *u32;
    idom:      *u32;
    def_block: *u32;
    def_ord:   *u32;
    n:         u32;
    il:        u32;
}

fun check_dominance(fn: *me_ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    var sc:        DomScratch;
    val opt_alloc: err[fail.Fail] = dom_scratch_alloc(r.alloc, n, fn.instr_len, ?sc);
    if (sel opt_alloc.err) { ret err[fail.Fail].err{opt_alloc.err}; }

    compute_rpo(fn, ?sc);
    compute_idom(fn, ?sc);
    index_definitions(fn, sc.def_block, sc.def_ord);

    var bi: u32 = 0;
    for (bi < n) {
        val blk:       *me_ir.Block = ?fn.blocks[bi];
        val reachable: bool         = sc.rpo_num[bi] != RPO_NIL;
        var p:         u32          = 0;
        for (p < blk.phi_count) {
            val phi_id: ir_id.InstructionId = blk.phis[p];
            if (phi_id < fn.instr_len) {
                val ins: *ir_instruction.Instruction = ?fn.instrs[phi_id];
                val rr:  err[fail.Fail]              = check_phi_incomings_dominate(fn, ins, ?sc, fi, blk.id, phi_id, r);
                if (sel rr.err) {
                    dom_scratch_free(r.alloc, ?sc);
                    ret rr;
                }
            }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val use_id: ir_id.InstructionId = blk.instructions[ix];
            if (use_id < fn.instr_len) {
                val ins: *ir_instruction.Instruction = ?fn.instrs[use_id];
                val rr:  err[fail.Fail]              = check_operands_dominate(fn, ins, bi, sc.def_ord[use_id], ?sc, reachable, fi, blk.id, use_id, r);
                if (sel rr.err) {
                    dom_scratch_free(r.alloc, ?sc);
                    ret rr;
                }
            }
            ix = ix + 1;
        }
        if (blk.terminator != ir_id.INSTR_NIL && blk.terminator < fn.instr_len) {
            val ins: *ir_instruction.Instruction = ?fn.instrs[blk.terminator];
            val rr:  err[fail.Fail]              = check_operands_dominate(fn, ins, bi, sc.def_ord[blk.terminator], ?sc, reachable, fi, blk.id, blk.terminator, r);
            if (sel rr.err) {
                dom_scratch_free(r.alloc, ?sc);
                ret rr;
            }
        }
        bi = bi + 1;
    }

    dom_scratch_free(r.alloc, ?sc);
    ret err[fail.Fail].ok{};
}

fun dom_scratch_alloc(alloc: *A.Allocator, n: u32, il: u32, sc: *DomScratch) err[fail.Fail] {
    sc.n         = n;
    sc.il        = il;
    sc.rpo_num   = nil;
    sc.post      = nil;
    sc.succ_ix   = nil;
    sc.stack     = nil;
    sc.idom      = nil;
    sc.def_block = nil;
    sc.def_ord   = nil;

    val a1: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a1.err) { ret err[fail.Fail].err{fail.refused(a1.err)}; }
    sc.rpo_num = a1.ok;
    val a2: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a2.err) {
        dom_scratch_free(alloc, sc);
        ret err[fail.Fail].err{fail.refused(a2.err)};
    }
    sc.post = a2.ok;
    val a3: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a3.err) {
        dom_scratch_free(alloc, sc);
        ret err[fail.Fail].err{fail.refused(a3.err)};
    }
    sc.succ_ix = a3.ok;
    val a4: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a4.err) {
        dom_scratch_free(alloc, sc);
        ret err[fail.Fail].err{fail.refused(a4.err)};
    }
    sc.stack = a4.ok;
    val a5: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a5.err) {
        dom_scratch_free(alloc, sc);
        ret err[fail.Fail].err{fail.refused(a5.err)};
    }
    sc.idom = a5.ok;
    val a6: res[*u32, A.Error] = A.allocate[u32](alloc, il::usize);
    if (sel a6.err) {
        dom_scratch_free(alloc, sc);
        ret err[fail.Fail].err{fail.refused(a6.err)};
    }
    sc.def_block = a6.ok;
    val a7: res[*u32, A.Error] = A.allocate[u32](alloc, il::usize);
    if (sel a7.err) {
        dom_scratch_free(alloc, sc);
        ret err[fail.Fail].err{fail.refused(a7.err)};
    }
    sc.def_ord = a7.ok;
    ret err[fail.Fail].ok{};
}

fun dom_scratch_free(alloc: *A.Allocator, sc: *DomScratch) {
    if (sc.rpo_num != nil)   { A.deallocate[u32](alloc, sc.rpo_num, sc.n::usize); }
    if (sc.post != nil)      { A.deallocate[u32](alloc, sc.post, sc.n::usize); }
    if (sc.succ_ix != nil)   { A.deallocate[u32](alloc, sc.succ_ix, sc.n::usize); }
    if (sc.stack != nil)     { A.deallocate[u32](alloc, sc.stack, sc.n::usize); }
    if (sc.idom != nil)      { A.deallocate[u32](alloc, sc.idom, sc.n::usize); }
    if (sc.def_block != nil) { A.deallocate[u32](alloc, sc.def_block, sc.il::usize); }
    if (sc.def_ord != nil)   { A.deallocate[u32](alloc, sc.def_ord, sc.il::usize); }
    sc.rpo_num   = nil;
    sc.post      = nil;
    sc.succ_ix   = nil;
    sc.stack     = nil;
    sc.idom      = nil;
    sc.def_block = nil;
    sc.def_ord   = nil;
}

fun compute_rpo(fn: *me_ir.Function, sc: *DomScratch) {
    val n: u32 = sc.n;
    var i: u32 = 0;
    for (i < n) {
        sc.rpo_num[i] = RPO_NIL;
        sc.succ_ix[i] = 0;
        i             = i + 1;
    }

    var pc:         u32 = 0;
    var sp:         u32 = 0;
    val DISCOVERED: u32 = 0xFFFFFFFE;
    sc.rpo_num[0] = DISCOVERED;
    sc.stack[sp]  = 0;
    sp            = sp + 1;
    for (sp > 0) {
        val b:        u32           = sc.stack[sp - 1];
        var s0:       ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1:       ir_id.BlockId = ir_id.BLOCK_NIL;
        val cnt:      u32           = me_ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        var advanced: bool          = false;
        for (sc.succ_ix[b] < cnt && !advanced) {
            val k: u32 = sc.succ_ix[b];
            sc.succ_ix[b] = k + 1;
            var t: ir_id.BlockId = s0;
            if (k == 1) { t = s1; }
            if (t < n && sc.rpo_num[t] == RPO_NIL) {
                sc.rpo_num[t] = DISCOVERED;
                sc.stack[sp]  = t;
                sp            = sp + 1;
                advanced      = true;
            }
        }
        if (!advanced) {
            sp          = sp - 1;
            sc.post[pc] = b;
            pc          = pc + 1;
        }
    }

    var j: u32 = 0;
    for (j < pc) {
        sc.rpo_num[sc.post[j]] = pc - 1 - j;
        j                      = j + 1;
    }
    sc.stack[0] = pc;
}

fun compute_idom(fn: *me_ir.Function, sc: *DomScratch) {
    val n:  u32 = sc.n;
    val pc: u32 = sc.stack[0];
    var i:  u32 = 0;
    for (i < n) {
        sc.idom[i] = ir_id.BLOCK_NIL;
        i          = i + 1;
    }
    if (pc == 0) { ret; }
    sc.idom[0] = 0;

    var changed: bool = true;
    for (changed) {
        changed = false;
        var ri: u32 = 1;
        for (ri < pc) {
            val b:        u32          = sc.post[pc - 1 - ri];
            val blk:      *me_ir.Block = ?fn.blocks[b];
            var new_idom: u32          = ir_id.BLOCK_NIL;
            var pi:       u32          = 0;
            for (pi < blk.pred_count) {
                val p: ir_id.BlockId = blk.preds[pi];
                if (p < n && sc.rpo_num[p] != RPO_NIL && sc.idom[p] != ir_id.BLOCK_NIL) {
                    if (new_idom == ir_id.BLOCK_NIL) { new_idom = p; }
                    or                               { new_idom = idom_intersect(sc, p, new_idom); }
                }
                pi = pi + 1;
            }
            if (new_idom != ir_id.BLOCK_NIL && sc.idom[b] != new_idom) {
                sc.idom[b] = new_idom;
                changed    = true;
            }
            ri = ri + 1;
        }
    }
}

fun idom_intersect(sc: *DomScratch, a: u32, b: u32) u32 {
    var x:     u32 = a;
    var y:     u32 = b;
    var steps: u32 = 0;
    val cap:   u32 = 2 * sc.n + 2;
    for (x != y && steps <= cap) {
        for (x != y && sc.rpo_num[x] > sc.rpo_num[y]) {
            x     = sc.idom[x];
            steps = steps + 1;
        }
        for (x != y && sc.rpo_num[y] > sc.rpo_num[x]) {
            y     = sc.idom[y];
            steps = steps + 1;
        }
        steps = steps + 1;
    }
    ret x;
}

fun index_definitions(fn: *me_ir.Function, def_block: *u32, def_ord: *u32) {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        def_block[i] = DEF_BLOCK_NIL;
        def_ord[i]   = 0;
        i            = i + 1;
    }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var ord: u32          = 0;
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            val iid: ir_id.InstructionId = blk.phis[p];
            if (iid < fn.instr_len) {
                def_block[iid] = bi;
                def_ord[iid]   = ord;
            }
            ord = ord + 1;
            p   = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val iid: ir_id.InstructionId = blk.instructions[ix];
            if (iid < fn.instr_len) {
                def_block[iid] = bi;
                def_ord[iid]   = ord;
            }
            ord = ord + 1;
            ix  = ix + 1;
        }
        if (blk.terminator != ir_id.INSTR_NIL && blk.terminator < fn.instr_len) {
            def_block[blk.terminator] = bi;
            def_ord[blk.terminator]   = ord;
        }
        bi = bi + 1;
    }
}

fun check_operands_dominate(fn: *me_ir.Function, ins: *ir_instruction.Instruction, use_block: u32, use_ord: u32, sc: *DomScratch, use_reachable: bool, fi: u32, bid: ir_id.BlockId, use_id: ir_id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind == ir_instruction.OP_PHI) { ret err[fail.Fail].ok{}; }
    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val op: *value.Value = ?ins.operands[oi];
        if (op.kind == value.VAL_INSTR) {
            val def_id: ir_id.InstructionId = op.data.instr;
            if (def_id < fn.instr_len) {
                val db: u32 = sc.def_block[def_id];
                if (db != DEF_BLOCK_NIL && use_reachable
                    && !def_dominates_use(sc, db, sc.def_ord[def_id], use_block, use_ord)) {
                    val rr: err[fail.Fail] = push(r, fi, bid, use_id, VC_DOMINANCE);
                    if (sel rr.err) { ret rr; }
                }
            }
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_phi_incomings_dominate(fn: *me_ir.Function, ins: *ir_instruction.Instruction, sc: *DomScratch, fi: u32, bid: ir_id.BlockId, use_id: ir_id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind != ir_instruction.OP_PHI) { ret err[fail.Fail].ok{}; }
    var k: u32 = 0;
    for (k + 1 < ins.operand_count) {
        val pred: ir_id.BlockId = me_ir.block_target(ins.operands[k]);
        val op:   *value.Value  = ?ins.operands[k + 1];
        if (op.kind == value.VAL_INSTR && pred < sc.n && sc.rpo_num[pred] != RPO_NIL) {
            val def_id: ir_id.InstructionId = op.data.instr;
            if (def_id < fn.instr_len) {
                val db: u32 = sc.def_block[def_id];
                if (db != DEF_BLOCK_NIL && db != pred::u32 && !block_dominates(sc, db, pred::u32)) {
                    val rr: err[fail.Fail] = push(r, fi, bid, use_id, VC_DOMINANCE);
                    if (sel rr.err) { ret rr; }
                }
            }
        }
        k = k + 2;
    }
    ret err[fail.Fail].ok{};
}

fun def_dominates_use(sc: *DomScratch, def_block: u32, def_ord: u32, use_block: u32, use_ord: u32) bool {
    if (def_block == use_block) { ret def_ord < use_ord; }
    ret block_dominates(sc, def_block, use_block);
}

fun block_dominates(sc: *DomScratch, a: u32, b: u32) bool {
    if (sc.rpo_num[a] == RPO_NIL) { ret false; }
    var x:     u32 = b;
    var steps: u32 = 0;
    for (x != 0 && steps <= sc.n) {
        x = sc.idom[x];
        if (x == a) { ret true; }
        steps = steps + 1;
    }
    ret false;
}

fun arity_ok(k: ir_instruction.InstrKind, operand_count: u32) bool {
    ret opdesc.arity_ok(k, operand_count);
}

fun const_type_ok(m: *me_ir.Module, v: *value.Value) bool {
    if (v.kind == value.VAL_CONST_FLOAT) {
        ret type_kind_is(m, v.ty, ir_type.IRT_FLOAT);
    }
    if (v.kind == value.VAL_CONST_INT) {
        if (type_kind_is(m, v.ty, ir_type.IRT_INT)) { ret true; }
        ret type_kind_is(m, v.ty, ir_type.IRT_PTR);
    }
    ret true;
}

fun type_kind_is(m: *me_ir.Module, tid: ir_type.IrTypeId, kind: ir_type.IrTypeKind) bool {
    val got: opt[*ir_type.IrType] = ir_type.get(?m.types, tid);
    if (sel got.some) {
        val ty: *ir_type.IrType = got.some;
        ret ty.kind == kind;
    }
    ret true;
}

fun push(r: *VerifyReport, function: u32, block: ir_id.BlockId, iid: ir_id.InstructionId, check: VerifyCheck) err[fail.Fail] {
    if (r.len == r.cap) {
        var new_cap: u32 = r.cap * 2;
        if (r.cap == 0) { new_cap = VIOLATION_SEED_CAP; }
        if (r.violations == nil) {
            val ar: res[*Violation, A.Error] = A.allocate[Violation](r.alloc, new_cap::usize);
            if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
            r.violations = ar.ok;
        }
        or {
            val ar: res[*Violation, A.Error] = A.reallocate[Violation](r.alloc, r.violations, r.cap::usize, new_cap::usize);
            if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
            r.violations = ar.ok;
        }
        r.cap = new_cap;
    }
    var v: Violation;
    v.function          = function;
    v.block             = block;
    v.instr             = iid;
    v.check             = check;
    v.tag               = 0;
    r.violations[r.len] = v;
    r.len               = r.len + 1;
    ret err[fail.Fail].ok{};
}

#[testing]
rec TEnv {
    alloc:    A.Allocator;
    registry: lang_target.TargetRegistry;
    m:        me_ir.Module;
    bld:      builder.Builder;
    i64ty:    ir_type.IrTypeId;
    tgt:      resolved.Target;
}

#[testing]
fun t_env(env: *TEnv) bool {
    page.make(?env.alloc);

    env.registry = lang_target.registry_init();
    val r_1289: err[fail.Fail] = lang_target.register_all(?env.registry, target_testing.debug_descriptor);
    if (sel r_1289.err) { ret false; }
    val tr: res[resolved.Target, fail.Fail] = lang_target.select(?env.registry, "x86_64", "linux", "sysv64");
    if (sel tr.err) {
        lang_target.registry_dnit(?env.registry);
        ret false;
    }
    env.tgt = tr.ok;

    val mr: res[me_ir.Module, fail.Fail] = me_ir.init(?env.alloc, intern.STR_NIL);
    if (sel mr.err) { ret false; }
    env.m = mr.ok;

    val it: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 64);
    if (sel it.err) { ret false; }
    env.i64ty = it.ok;

    val vt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?env.m.types);
    if (sel vt.err) { ret false; }
    val voidty: ir_type.IrTypeId = vt.ok;

    val sr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?env.m.types, voidty, nil, 0, false);
    if (sel sr.err) { ret false; }
    val sig: ir_type.IrTypeId = sr.ok;

    val fr: res[u32, fail.Fail] = me_ir.function_add(?env.m, intern.STR_NIL, sig, 0);
    if (sel fr.err) { ret false; }

    env.bld = builder.init(?env.m);
    builder.set_function(?env.bld, ?env.m.functions[0]);
    ret true;
}

#[testing]
fun t_block(env: *TEnv) ir_id.BlockId {
    val r: res[ir_id.BlockId, fail.Fail] = builder.new_block(?env.bld);
    if (sel r.err) { ret ir_id.BLOCK_NIL; }
    ret r.ok;
}

#[testing]
fun t_ci(env: *TEnv, n: u64) value.Value {
    ret value.const_int(n, env.i64ty);
}

#[testing]
fun t_count(env: *TEnv, full: bool, repr: bool, check: VerifyCheck) i64 {
    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, full, repr));
    if (sel rr.err) { ret -1; }
    var rep: VerifyReport = rr.ok;
    var c:   i64          = 0;
    var i:   u32          = 0;
    for (i < rep.len) {
        if (rep.violations[i].check == check) { c = c + 1; }
        i = i + 1;
    }
    dnit_report(?rep);
    ret c;
}

#[testing]
fun t_total(env: *TEnv, full: bool, repr: bool) i64 {
    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, full, repr));
    if (sel rr.err) { ret -1; }
    var rep: VerifyReport = rr.ok;
    val c:   i64          = rep.len::i64;
    dnit_report(?rep);
    ret c;
}

test check_dominance__diamond_arm_def {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    val b3: ir_id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val r_1393: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_1393.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel av.err) { ret 1; }
    val v:      value.Value    = av.ok;
    val r_1399: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1399.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val r_1402: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1402.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val r_1405: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, c);
    if (sel r_1405.err) { ret 1; }
    val r_1406: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1406.err) { ret 1; }

    if (t_count(?env, true, false, VC_DOMINANCE) < 1) { ret 1; }
    ret 0;
}

test check_dominance__irreducible_entry_def {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    if (b2 != 2) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel av.err) { ret 1; }
    val v:      value.Value    = av.ok;
    val r_1488: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_1488.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val r_1491: err[fail.Fail] = builder.emit_br(?env.bld, b2);
    if (sel r_1491.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val r_1494: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, c);
    if (sel r_1494.err) { ret 1; }
    val r_1495: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_1495.err) { ret 1; }

    if (t_count(?env, true, false, VC_DOMINANCE) != 0) { ret 1; }
    ret 0;
}

test check_dominance__irreducible_cross_edge {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    if (b2 != 2) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val r_1512: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_1512.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel av.err) { ret 1; }
    val v:      value.Value    = av.ok;
    val r_1518: err[fail.Fail] = builder.emit_br(?env.bld, b2);
    if (sel r_1518.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val r_1521: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, c);
    if (sel r_1521.err) { ret 1; }
    val r_1522: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_1522.err) { ret 1; }

    if (t_count(?env, true, false, VC_DOMINANCE) < 1) { ret 1; }
    ret 0;
}

test check_reachability__dead_cycle {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    if (b2 != 2) { ret 1; }

    builder.set_block(?env.bld, b0);
    val r_1538: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1538.err) { ret 1; }
    builder.set_block(?env.bld, b1);
    val r_1540: err[fail.Fail] = builder.emit_br(?env.bld, b2);
    if (sel r_1540.err) { ret 1; }
    builder.set_block(?env.bld, b2);
    val r_1542: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_1542.err) { ret 1; }

    if (t_count(?env, true, false, VC_REACHABILITY) < 2) { ret 1; }
    ret 0;
}

test check_block_lists__dangling_terminator {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);
    val r_1555: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1555.err) { ret 1; }

    env.m.functions[0].blocks[0].terminator = env.m.functions[0].instr_len + 100;
    if (t_count(?env, false, false, VC_DANGLING_ID) < 1) { ret 1; }
    ret 0;
}

test check_pred_consistency__wrong_member {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    val b3: ir_id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }

    builder.set_block(?env.bld, b0);
    val r_1573: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_1573.err) { ret 1; }
    builder.set_block(?env.bld, b1);
    val r_1575: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1575.err) { ret 1; }
    builder.set_block(?env.bld, b2);
    val r_1577: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1577.err) { ret 1; }
    builder.set_block(?env.bld, b3);
    val r_1579: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1579.err) { ret 1; }

    env.m.functions[0].blocks[3].preds[1] = 1::ir_id.BlockId;
    if (t_count(?env, false, false, VC_PRED_CONSISTENT) < 1) { ret 1; }
    ret 0;
}

# a declared predecessor that targets nothing balances on the edge side, so
# only the declared side of the multiset check can see it
test check_pred_consistency__declared_pred_without_an_edge {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    val b3: ir_id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }

    builder.set_block(?env.bld, b0);
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_cbr.err) { ret 1; }
    builder.set_block(?env.bld, b1);
    val r_br1: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_br1.err) { ret 1; }
    builder.set_block(?env.bld, b2);
    val r_br2: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_br2.err) { ret 1; }
    builder.set_block(?env.bld, b3);
    val r_ret: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_ret.err)                                        { ret 1; }
    if (t_count(?env, false, false, VC_PRED_CONSISTENT) != 0) { ret 1; }

    val r_extra: err[fail.Fail] = me_ir.block_append_pred(?env.m, ?env.m.functions[0].blocks[3], b0);
    if (sel r_extra.err)                                     { ret 1; }
    if (t_count(?env, false, false, VC_PRED_CONSISTENT) < 1) { ret 1; }
    ret 0;
}

