test "mach.lang.me.ir.verify.check_pred_consistency:same_target_cbr" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    if (b1 != 1) { ret 1; }

    builder.set_block(?env.bld, b0);
    val r_1891: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b1);
    if (sel r_1891.err) { ret 1; }
    builder.set_block(?env.bld, b1);
    val r_1893: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1893.err) { ret 1; }

    val r_1895: err[fail.Fail] = ir.preds_rebuild(?env.m, ?env.m.functions[0]);
    if (sel r_1895.err) { ret 1; }
    if (t_count(?env, false, false, VC_PRED_CONSISTENT) != 0)               { ret 1; }
    if (env.m.functions[0].blocks[1].pred_count != 2)                       { ret 1; }
    ret 0;
}

