test check_type_agree__binary_mismatch {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    val i32r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 32);
    if (sel i32r.err) { ret 1; }
    val i32ty: ir_type.IrTypeId = i32r.ok;

    builder.set_block(?env.bld, b0);
    val r_1912: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, t_ci(?env, 0), value.const_int(0, i32ty));
    if (sel r_1912.err) { ret 1; }
    val r_1913: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1913.err) { ret 1; }

    if (t_count(?env, false, true, VC_TYPE_AGREE) < 1)   { ret 1; }
    if (t_count(?env, false, false, VC_TYPE_AGREE) != 0) { ret 1; }
    ret 0;
}

