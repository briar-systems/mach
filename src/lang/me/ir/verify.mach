    val r_2280: err[fail.Fail] = builder.phi_add_incoming(?env.bld, p, b1, l);
    if (sel r_2280.err) { ret 1; }
    val r_2281: err[fail.Fail] = builder.phi_add_incoming(?env.bld, p, b2, rt);
    if (sel r_2281.err) { ret 1; }
    val r_2282: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, p, c);
    if (sel r_2282.err) { ret 1; }
    val r_2283: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2283.err) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }

    if (!t_drop(?env, b2, rt.data.instr)) { ret 1; }
    if (t_count(?env, false, false, VC_DANGLING_OPERAND) != 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_dominance:phi_incoming_not_live_out_of_pred" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val r_2304: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_2304.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val r_2307: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_2307.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val rv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel rv.err) { ret 1; }
    val rt: value.Value = rv.ok;
    val r_2313: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_2313.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val pv: res[value.Value, fail.Fail] = builder.emit_phi(?env.bld, env.i64ty);
    if (sel pv.err) { ret 1; }
    val p: value.Value = pv.ok;
    val r_2319: err[fail.Fail] = builder.phi_add_incoming(?env.bld, p, b1, rt);
    if (sel r_2319.err) { ret 1; }
    val r_2320: err[fail.Fail] = builder.phi_add_incoming(?env.bld, p, b2, rt);
    if (sel r_2320.err) { ret 1; }
    val r_2321: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, p, c);
    if (sel r_2321.err) { ret 1; }
    val r_2322: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2322.err) { ret 1; }

    if (t_count(?env, true, false, VC_DANGLING_OPERAND) != 0) { ret 1; }
    if (t_count(?env, true, false, VC_DOMINANCE) != 1)        { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_dominance:phi_incoming_defined_in_pred" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    if (b1 != 1) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val dv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel dv.err) { ret 1; }
    val d: value.Value = dv.ok;
    val r_2342: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_2342.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val pv: res[value.Value, fail.Fail] = builder.emit_phi(?env.bld, env.i64ty);
    if (sel pv.err) { ret 1; }
    val p: value.Value = pv.ok;
    val r_2348: err[fail.Fail] = builder.phi_add_incoming(?env.bld, p, b0, d);
    if (sel r_2348.err) { ret 1; }
    val r_2349: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, p, c);
    if (sel r_2349.err) { ret 1; }
    val r_2350: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2350.err) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify:volatile_flag_requires_memory_access" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val entry: id.BlockId = t_block(?env);
    if (entry == id.BLOCK_NIL) { ret 1; }
    builder.set_block(?env.bld, entry);

    val sum: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, t_ci(?env, 1), t_ci(?env, 2));
    if (sel sum.err) { ret 1; }
    val add: value.Value = sum.ok;
    env.m.functions[0].instrs[add.data.instr].flags = instruction.INSTR_FLAG_VOLATILE;
    val r_2368: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2368.err) { ret 1; }

    if (t_count(?env, false, false, VC_VOLATILE_FORM) != 1) { ret 1; }
    env.m.functions[0].instrs[add.data.instr].flags = 0;
    if (t_count(?env, false, false, VC_VOLATILE_FORM) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify:rejects_an_instruction_whose_opcode_has_no_descriptor" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    fin { ir.dnit(?m); }

    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel ri.err) { ret 1; }
    val i32t: type.IrTypeId = ri.ok;

    val rfa: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, i32t, 0);
    if (sel rfa.err) { ret 1; }
    val fn: *ir.Function = ?m.functions[rfa.ok];
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ret 1; }
    builder.set_block(?b, rb.ok);
    val ra: res[value.Value, fail.Fail] = builder.emit_add(?b, value.const_int(1, i32t), value.const_int(2, i32t));
    if (sel ra.err) { ret 1; }
    val r_2398: err[fail.Fail] = builder.emit_ret(?b, ra.ok);
    if (sel r_2398.err) { ret 1; }

    if (t_first_check(?m, ?alloc) != VC_NONE_SEEN) { ret 1; }

    fn.instrs[ra.ok.data.instr::u32].kind = 200::instruction.InstrKind;
    if (t_first_check(?m, ?alloc) != VC_OPCODE_KNOWN) { ret 1; }
    ret 0;
}

val VC_NONE_SEEN: VerifyCheck = 255;

fun t_first_check(m: *ir.Module, alloc: *A.Allocator) VerifyCheck {
    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(m, alloc, opts(nil, false, false));
    if (sel rr.err) { ret VC_NONE_SEEN; }
    var rep: VerifyReport = rr.ok;
    if (rep.len == 0) { dnit_report(?rep); ret VC_NONE_SEEN; }
    val c: VerifyCheck = rep.violations[0].check;
    dnit_report(?rep);
    ret c;
}

test "mach.lang.me.ir.verify:unknown_operand_kinds_are_rejected_with_their_numeric_tag" {
    var env: TEnv;
    if (!t_env(?env)) { ret 1; }
    fin { ir.dnit(?env.m); target.registry_dnit(?env.registry); }
    val entry: id.BlockId = t_block(?env);
    if (entry == id.BLOCK_NIL) { ret 2; }
    builder.set_block(?env.bld, entry);
    val added: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, t_ci(?env, 1), t_ci(?env, 2));
    if (sel added.err) { ret 3; }
    val r_2428: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2428.err) { ret 3; }
    val iid: id.InstructionId = added.ok.data.instr;
    val operand: *value.Value = ?env.m.functions[0].instrs[iid].operands[0];
    if (t_total(?env, false, false) != 0) { ret 4; }
    val unknown: [3]u8 = [3]u8{9, 200, 255};
    var i: usize = 0;
    for (i < 3) {
        operand.kind = unknown[i];
        val checked: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(nil, false, false));
        operand.kind = value.VAL_CONST_INT;
        if (sel checked.err) { ret 5; }
        var report: VerifyReport = checked.ok;
        fin { dnit_report(?report); }
        if (report.len != 1 || report.violations[0].check != VC_VALUE_KNOWN || report.violations[0].tag != unknown[i]::u32) { ret 6; }
        if (i == 1) {
            if (t_describe_refusals(nil, ?report.violations[0], nil, nil, "unknown ValueKind tag 200") != 0) { ret 7; }
        }
        i = i + 1;
    }
    if (t_total(?env, false, false) != 0) { ret 8; }
    ret 0;
}

fun t_describe_attempt(m: *ir.Module, v: *Violation, itn: *intern.Interner,
                       srcmap: *source.SourceMap, expected: str, ordinal: usize, attempts: *usize) i32 {
    var testing: T.Testing;
    val r_2454: err[A.Error] = T.make(?testing);
    if (sel r_2454.err) { ret 1; }
    fin { T.dnit(?testing); }
    T.fail_at_ordinal(?testing, ordinal);
    val alloc: *A.Allocator = T.allocator_of(?testing);
    val described: res[str, fail.Fail] = describe_located(m, v, itn, srcmap, alloc);
    @attempts = T.attempt_count(?testing);
    var code: i32 = 0;
    if (sel described.ok) {
        val text: str = described.ok;
        if (ordinal != 0 || !str_contains(text, expected)) { code = 2; }
        str_free(alloc, text);
    }
    or (sel described.err) {
        if (ordinal == 0 || !str_equals(fail.describe(described.err), "out of memory")) { code = 3; }
    }
    if (T.leaked(?testing) || T.double_free_count(?testing) != 0 || T.tracking_exhausted(?testing)) { code = 4; }
    ret code;
}

fun t_describe_refusals(m: *ir.Module, v: *Violation, itn: *intern.Interner,
                        srcmap: *source.SourceMap, expected: str) i32 {
    var attempts: usize = 0;
    val baseline: i32 = t_describe_attempt(m, v, itn, srcmap, expected, 0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 10; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused: usize = 0;
        val code: i32 = t_describe_attempt(m, v, itn, srcmap, expected, ordinal, ?refused);
        if (code != 0) { ret 10 + code; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
