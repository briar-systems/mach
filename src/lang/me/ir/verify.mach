    val r_2262: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_2262.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val lv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel lv.err) { ret 1; }
    val l: value.Value = lv.ok;
    val r_2268: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_2268.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val rv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel rv.err) { ret 1; }
