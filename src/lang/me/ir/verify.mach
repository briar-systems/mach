use target_testing: mach.lang.target.testing;
use mach.lang.target.resolved;

pub def VerifyCheck: u8;

pub val VC_SSA:             VerifyCheck = 0;
pub val VC_TERM_PRESENCE:   VerifyCheck = 1;
pub val VC_TERM_UNIQUE:     VerifyCheck = 2;
pub val VC_SUCC_EXISTS:     VerifyCheck = 3;
pub val VC_PRED_CONSISTENT: VerifyCheck = 4;
pub val VC_PHI_COVERAGE:    VerifyCheck = 5;
pub val VC_OPERAND_TYPE:    VerifyCheck = 6;
pub val VC_CONST_TYPE:      VerifyCheck = 7;
pub val VC_DOMINANCE:       VerifyCheck = 8;
pub val VC_REACHABILITY:    VerifyCheck = 9;

pub val VC_AGG_ADDRESS:     VerifyCheck = 10;

pub val VC_TYPE_RESOLVE:    VerifyCheck = 11;

pub val VC_DANGLING_ID:     VerifyCheck = 12;

pub val VC_TYPE_AGREE:      VerifyCheck = 13;

pub val VC_CALL_ARG_TYPE:   VerifyCheck = 14;

pub val VC_BITCAST_CLASS:   VerifyCheck = 15;

pub val VC_CONVERT_WIDTH:   VerifyCheck = 16;

pub val VC_DANGLING_OPERAND: VerifyCheck = 17;

pub val VC_VOLATILE_FORM: VerifyCheck = 18;

pub val VC_OPCODE_KNOWN: VerifyCheck = 19;
pub val VC_VALUE_KNOWN: VerifyCheck = 20;

pub rec Violation {
    function: u32;
    block:    id.BlockId;
    instr:    id.InstructionId;
    check:    VerifyCheck;
    tag:      u32;
}

pub rec VerifyReport {
    alloc:      *A.Allocator;
    violations: *Violation;
    len:        u32;
    cap:        u32;
}

val VIOLATION_SEED_CAP: u32 = 8;

pub rec VerifyOpts {
    tgt:  *resolved.Target;
    full: bool;
    repr: bool;
}

pub fun opts(tgt: *resolved.Target, full: bool, repr: bool) VerifyOpts {
    var o: VerifyOpts;
    o.tgt  = tgt;
    o.full = full;
    o.repr = repr;
    ret o;
}

pub fun verify_module_ext(m: *ir.Module, alloc: *A.Allocator, o: VerifyOpts) res[VerifyReport, fail.Fail] {
    var r: VerifyReport;
    r.alloc      = alloc;
    r.violations = nil;
    r.len        = 0;
    r.cap        = 0;

    if (m == nil) { ret res[VerifyReport, fail.Fail].ok{r}; }

    var fi: u32 = 0;
    for (fi < m.function_len) {
        val res_fn: err[fail.Fail] = verify_function(m, ?m.functions[fi], fi, ?r, o);
        if (sel res_fn.err) {
            dnit_report(?r);
            ret res[VerifyReport, fail.Fail].err{res_fn.err};
        }
        fi = fi + 1;
    }
    ret res[VerifyReport, fail.Fail].ok{r};
}

pub fun dnit_report(r: *VerifyReport) {
    if (r == nil) { ret; }
    if (r.violations != nil && r.cap > 0) {
        A.deallocate[Violation](r.alloc, r.violations, r.cap::usize);
    }
    r.violations = nil;
    r.len        = 0;
    r.cap        = 0;
}

pub fun describe(check: VerifyCheck) str {
    if (check == VC_SSA)             { ret "ssa: value defined more than once"; }
    if (check == VC_TERM_PRESENCE)   { ret "terminator presence: block has no terminator"; }
    if (check == VC_TERM_UNIQUE)     { ret "terminator uniqueness: terminator in block body"; }
    if (check == VC_SUCC_EXISTS)     { ret "successor existence: terminator targets a missing block"; }
    if (check == VC_PRED_CONSISTENT) { ret "predecessor consistency: preds do not match incoming edges"; }
    if (check == VC_PHI_COVERAGE)    { ret "phi coverage: phi does not cover every predecessor"; }
    if (check == VC_OPERAND_TYPE)    { ret "operand typing: wrong operand arity for opcode"; }
    if (check == VC_CONST_TYPE)      { ret "constant typing: constant carries an incompatible type"; }
    if (check == VC_DOMINANCE)       { ret "dominance: operand definition does not dominate its use"; }
    if (check == VC_REACHABILITY)    { ret "reachability: block is unreachable"; }
    if (check == VC_AGG_ADDRESS)     { ret "aggregate representation: aggregate-typed operand is not address-producing"; }
    if (check == VC_BITCAST_CLASS)   { ret "bitcast crosses the value / address representation classes without materializing it"; }
    if (check == VC_TYPE_RESOLVE)    { ret "type resolution: operand or aux type does not resolve"; }
    if (check == VC_DANGLING_ID)     { ret "dangling id: a block list names an out-of-range instruction id"; }
    if (check == VC_TYPE_AGREE)      { ret "type agreement: operand types violate the opcode's typing contract"; }
    if (check == VC_CALL_ARG_TYPE)   { ret "call argument typing: a call argument's type disagrees with the callee's declared parameter"; }
    if (check == VC_DANGLING_OPERAND) { ret "dangling operand: an operand names an instruction no block list of this function holds"; }
    if (check == VC_CONVERT_WIDTH)   { ret "conversion width: a conversion's result width contradicts its opcode (a bitcast must keep the width, a truncation must narrow, an extension must widen)"; }
    if (check == VC_VOLATILE_FORM)   { ret "volatile form: the volatile flag is valid only on memory accesses"; }
    if (check == VC_OPCODE_KNOWN)    { ret "opcode: the instruction carries an InstrKind tag outside the catalog"; }
    if (check == VC_VALUE_KNOWN)     { ret "operand: an operand carries a ValueKind tag outside the catalog"; }
    ret "unknown verification check";
}

pub fun violation_loc(m: *ir.Module, v: *Violation) source.SrcLoc {
    if (m == nil || v == nil)              { ret source.loc_nil(); }
    if (v.function >= m.function_len)      { ret source.loc_nil(); }
    val fn: *ir.Function = ?m.functions[v.function];
    if (v.instr == id.INSTR_NIL)           { ret source.loc_nil(); }
    if (v.instr::u32 >= fn.instr_len)      { ret source.loc_nil(); }
    ret fn.instrs[v.instr].loc;
}

fun violation_scope(m: *ir.Module, v: *Violation, itn: *intern.Interner, alloc: *A.Allocator) res[str, fail.Fail] {
    if (itn == nil) { ret res[str, fail.Fail].err{fail.message("verification interner is absent")}; }
    var mod: str = "<unknown module>";
    val om: opt[str] = intern.lookup_typed(itn, m.name);
    if (sel om.some) { mod = om.some; }

    var fname: str = "<unknown function>";
    if (v.function < m.function_len) {
        val fn: *ir.Function = ?m.functions[v.function];
        var nm: intern.StrId = fn.disp;
        if (nm == intern.STR_NIL) { nm = fn.name; }
        val of: opt[str] = intern.lookup_typed(itn, nm);
        if (sel of.some) { fname = of.some; }
    }

    val r_183: res[str, format.FormatError] = format.sprint(alloc, "{}.{}", mod, fname);
    if (sel r_183.err) { ret res[str, fail.Fail].err{fail.format_refused(r_183.err)}; }
    ret res[str, fail.Fail].ok{r_183.ok};
}

fun violation_where(l: source.SrcLoc, srcmap: *source.SourceMap, alloc: *A.Allocator) res[opt[str], fail.Fail] {
    if (!source.loc_is_valid(l) || srcmap == nil) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val of: O.Option[*source.SourceFile] = source.get(srcmap, l.file);
    if (O.is_none[*source.SourceFile](of)) { ret res[opt[str], fail.Fail].ok{opt[str].none{}}; }
    val f: *source.SourceFile = O.unwrap[*source.SourceFile](of);
    val p: source.Position = source.position(f, l.offset);
    val formatted: res[str, format.FormatError] = format.sprint(alloc, "{}:{}:{}", f.path, p.line, p.col);
    if (sel formatted.err) { ret res[opt[str], fail.Fail].err{fail.format_refused(formatted.err)}; }
    ret res[opt[str], fail.Fail].ok{opt[str].some{formatted.ok}};
}

fun catalog_named(r: res[str, format.FormatError]) res[str, fail.Fail] {
    if (sel r.err) { ret res[str, fail.Fail].err{fail.format_refused(r.err)}; }
    ret res[str, fail.Fail].ok{r.ok};
}

# successful text is caller-owned, and allocation failures never produce partial descriptions
pub fun describe_located(m: *ir.Module, v: *Violation, itn: *intern.Interner,
                         srcmap: *source.SourceMap, alloc: *A.Allocator) res[str, fail.Fail] {
    if (v == nil) { ret res[str, fail.Fail].err{fail.message("verification violation is absent")}; }
    var named: res[str, fail.Fail];
    if (v.check == VC_OPCODE_KNOWN) { named = catalog_named(fail.catalog_text(alloc, fail.unknown_member("InstrKind", v.tag))); }
    or (v.check == VC_VALUE_KNOWN) { named = catalog_named(fail.catalog_text(alloc, fail.unknown_member("ValueKind", v.tag))); }
    or {
        val duplicated: res[str, A.Error] = str_dup(alloc, describe(v.check));
        if (sel duplicated.err) { ret res[str, fail.Fail].err{fail.refused(duplicated.err)}; }
        named = res[str, fail.Fail].ok{duplicated.ok};
    }
    if (sel named.err) { ret named; }
    if (m == nil) { ret named; }
    val what: str = named.ok;
    fin { str_free(alloc, what); }

    val scoped: res[str, fail.Fail] = violation_scope(m, v, itn, alloc);
    if (sel scoped.err) { ret scoped; }
    val scope: str = scoped.ok;
    fin { str_free(alloc, scope); }
    val located: res[opt[str], fail.Fail] = violation_where(violation_loc(m, v), srcmap, alloc);
    if (sel located.err) { ret res[str, fail.Fail].err{located.err}; }
    val where: opt[str] = located.ok;
    if (sel where.some) {
        val position: str = where.some;
        fin { str_free(alloc, position); }
        val r_227: res[str, format.FormatError] = format.sprint(alloc, "{} (in {}, at {})", what, scope, position);
        if (sel r_227.err) { ret res[str, fail.Fail].err{fail.format_refused(r_227.err)}; }
        ret res[str, fail.Fail].ok{r_227.ok};
    }
    val r_229: res[str, format.FormatError] = format.sprint(alloc, "{} (in {}; no source location available for this check)", what, scope);
    if (sel r_229.err) { ret res[str, fail.Fail].err{fail.format_refused(r_229.err)}; }
    ret res[str, fail.Fail].ok{r_229.ok};
}

fun verify_function(m: *ir.Module, fn: *ir.Function, fi: u32, r: *VerifyReport, o: VerifyOpts) err[fail.Fail] {
    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0) { ret err[fail.Fail].ok{}; }
    if (fn.block_count == 0)                 { ret err[fail.Fail].ok{}; }

    val res_defs: err[fail.Fail] = check_definitions(fn, fi, r);
    if (sel res_defs.err) { ret res_defs; }

    val res_lists: err[fail.Fail] = check_block_lists(fn, fi, r);
    if (sel res_lists.err) { ret res_lists; }

    val res_ops: err[fail.Fail] = check_operand_defs(fn, fi, r);
    if (sel res_ops.err) { ret res_ops; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];

        val res_term: err[fail.Fail] = check_terminator_presence(fn, blk, fi, r);
        if (sel res_term.err) { ret res_term; }
        val res_uniq: err[fail.Fail] = check_terminator_unique(fn, blk, fi, r);
        if (sel res_uniq.err) { ret res_uniq; }
        val res_succ: err[fail.Fail] = check_successors(fn, blk, fi, r);
        if (sel res_succ.err) { ret res_succ; }
        val res_arity: err[fail.Fail] = check_arity_and_consts(m, fn, blk, fi, r, o);
        if (sel res_arity.err) { ret res_arity; }
        bi = bi + 1;
    }

    val res_preds: err[fail.Fail] = check_pred_consistency(fn, fi, r);
    if (sel res_preds.err) { ret res_preds; }
    val res_phis: err[fail.Fail] = check_phi_coverage(fn, fi, r);
    if (sel res_phis.err) { ret res_phis; }

    if (o.full) {
        val res_reach: err[fail.Fail] = check_reachability(fn, fi, r);
        if (sel res_reach.err) { ret res_reach; }
        val res_dom: err[fail.Fail] = check_dominance(fn, fi, r);
        if (sel res_dom.err) { ret res_dom; }
    }

    ret err[fail.Fail].ok{};
}

fun check_definitions(fn: *ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (fn.instr_len == 0) { ret err[fail.Fail].ok{}; }
    val res_seen: res[*u8, A.Error] = A.allocate[u8](r.alloc, fn.instr_len::usize);
    if (sel res_seen.err) { ret err[fail.Fail].err{fail.refused(res_seen.err)}; }
    val seen: *u8 = res_seen.ok;
    var i: u32 = 0;
    for (i < fn.instr_len) { seen[i] = 0; i = i + 1; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            val rr: err[fail.Fail] = mark_def(seen, blk.phis[p], fn, bi, fi, r);
            if (sel rr.err) { A.deallocate[u8](r.alloc, seen, fn.instr_len::usize); ret rr; }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val rr: err[fail.Fail] = mark_def(seen, blk.instructions[ix], fn, bi, fi, r);
            if (sel rr.err) { A.deallocate[u8](r.alloc, seen, fn.instr_len::usize); ret rr; }
            ix = ix + 1;
        }
        if (blk.terminator != id.INSTR_NIL) {
            val rr: err[fail.Fail] = mark_def(seen, blk.terminator, fn, bi, fi, r);
            if (sel rr.err) { A.deallocate[u8](r.alloc, seen, fn.instr_len::usize); ret rr; }
        }
        bi = bi + 1;
    }
    A.deallocate[u8](r.alloc, seen, fn.instr_len::usize);
    ret err[fail.Fail].ok{};
}

fun mark_def(seen: *u8, iid: id.InstructionId, fn: *ir.Function, bi: u32, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (iid >= fn.instr_len) { ret err[fail.Fail].ok{}; }
    if (seen[iid] != 0) {
        ret push(r, fi, bi::id.BlockId, iid, VC_SSA);
    }
    seen[iid] = 1;
    ret err[fail.Fail].ok{};
}

fun check_block_lists(fn: *ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            val rr: err[fail.Fail] = check_listed_id(fn, blk.phis[p], fi, blk.id, r);
            if (sel rr.err) { ret rr; }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val rr: err[fail.Fail] = check_listed_id(fn, blk.instructions[ix], fi, blk.id, r);
            if (sel rr.err) { ret rr; }
            ix = ix + 1;
        }
        if (blk.terminator != id.INSTR_NIL) {
            val rr: err[fail.Fail] = check_listed_id(fn, blk.terminator, fi, blk.id, r);
            if (sel rr.err) { ret rr; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_listed_id(fn: *ir.Function, iid: id.InstructionId, fi: u32, bid: id.BlockId, r: *VerifyReport) err[fail.Fail] {
    if (iid == id.INSTR_NIL || iid >= fn.instr_len) {
        ret push(r, fi, bid, iid, VC_DANGLING_ID);
    }
    ret err[fail.Fail].ok{};
}

fun check_operand_defs(fn: *ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (fn.instr_len == 0) { ret err[fail.Fail].ok{}; }
    val res_live: res[*u8, A.Error] = A.allocate[u8](r.alloc, fn.instr_len::usize);
    if (sel res_live.err) { ret err[fail.Fail].err{fail.refused(res_live.err)}; }
    val live: *u8 = res_live.ok;
    var i: u32 = 0;
    for (i < fn.instr_len) { live[i] = 0; i = i + 1; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            if (blk.phis[p] < fn.instr_len) { live[blk.phis[p]] = 1; }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            if (blk.instructions[ix] < fn.instr_len) { live[blk.instructions[ix]] = 1; }
            ix = ix + 1;
        }
        if (blk.terminator != id.INSTR_NIL && blk.terminator < fn.instr_len) {
            live[blk.terminator] = 1;
        }
        bi = bi + 1;
    }

    var cb: u32 = 0;
    for (cb < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[cb];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            val rr: err[fail.Fail] = check_uses_live(fn, live, blk.phis[p], fi, blk.id, r);
            if (sel rr.err) { A.deallocate[u8](r.alloc, live, fn.instr_len::usize); ret rr; }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val rr: err[fail.Fail] = check_uses_live(fn, live, blk.instructions[ix], fi, blk.id, r);
            if (sel rr.err) { A.deallocate[u8](r.alloc, live, fn.instr_len::usize); ret rr; }
            ix = ix + 1;
        }
        if (blk.terminator != id.INSTR_NIL) {
            val rr: err[fail.Fail] = check_uses_live(fn, live, blk.terminator, fi, blk.id, r);
            if (sel rr.err) { A.deallocate[u8](r.alloc, live, fn.instr_len::usize); ret rr; }
        }
        cb = cb + 1;
    }

    A.deallocate[u8](r.alloc, live, fn.instr_len::usize);
    ret err[fail.Fail].ok{};
}

fun check_uses_live(fn: *ir.Function, live: *u8, iid: id.InstructionId, fi: u32, bid: id.BlockId, r: *VerifyReport) err[fail.Fail] {
    if (iid >= fn.instr_len) { ret err[fail.Fail].ok{}; }
    val ins: *instruction.Instruction = ?fn.instrs[iid];
    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val op: *value.Value = ?ins.operands[oi];
        if (op.kind == value.VAL_INSTR) {
            val def_id: id.InstructionId = op.data.instr;
            if (def_id >= fn.instr_len || live[def_id] == 0) {
                val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_DANGLING_OPERAND);
                if (sel rr.err) { ret rr; }
            }
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_terminator_presence(fn: *ir.Function, blk: *ir.Block, fi: u32, r: *VerifyReport) err[fail.Fail] {
    if (blk.terminator == id.INSTR_NIL) {
        ret push(r, fi, blk.id, id.INSTR_NIL, VC_TERM_PRESENCE);
    }
    if (blk.terminator >= fn.instr_len) {
        ret push(r, fi, blk.id, blk.terminator, VC_TERM_PRESENCE);
    }
    val t: *instruction.Instruction = ?fn.instrs[blk.terminator];
    if (!opdesc.is_terminator(t.kind)) {
        ret push(r, fi, blk.id, blk.terminator, VC_TERM_PRESENCE);
    }
    ret err[fail.Fail].ok{};
}

fun check_terminator_unique(fn: *ir.Function, blk: *ir.Block, fi: u32, r: *VerifyReport) err[fail.Fail] {
    var p: u32 = 0;
    for (p < blk.phi_count) {
        val iid: id.InstructionId = blk.phis[p];
        if (iid < fn.instr_len) {
            val ins: *instruction.Instruction = ?fn.instrs[iid];
            if (opdesc.is_terminator(ins.kind)) {
                val rr: err[fail.Fail] = push(r, fi, blk.id, iid, VC_TERM_UNIQUE);
                if (sel rr.err) { ret rr; }
            }
        }
        p = p + 1;
    }
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        val iid: id.InstructionId = blk.instructions[ix];
        if (iid < fn.instr_len) {
            val ins: *instruction.Instruction = ?fn.instrs[iid];
            if (opdesc.is_terminator(ins.kind)) {
                val rr: err[fail.Fail] = push(r, fi, blk.id, iid, VC_TERM_UNIQUE);
                if (sel rr.err) { ret rr; }
            }
        }
        ix = ix + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_successors(fn: *ir.Function, blk: *ir.Block, fi: u32, r: *VerifyReport) err[fail.Fail] {
    var s0: id.BlockId = id.BLOCK_NIL;
    var s1: id.BlockId = id.BLOCK_NIL;
    val sc: u32 = ir.block_successors(fn, blk, ?s0, ?s1);

    if (sc >= 1 && s0 >= fn.block_count) {
        val rr: err[fail.Fail] = push(r, fi, blk.id, blk.terminator, VC_SUCC_EXISTS);
        if (sel rr.err) { ret rr; }
    }
    if (sc >= 2 && s1 >= fn.block_count) {
        val rr: err[fail.Fail] = push(r, fi, blk.id, blk.terminator, VC_SUCC_EXISTS);
        if (sel rr.err) { ret rr; }
    }
    ret err[fail.Fail].ok{};
}

fun check_arity_and_consts(m: *ir.Module, fn: *ir.Function, blk: *ir.Block, fi: u32, r: *VerifyReport, o: VerifyOpts) err[fail.Fail] {
    var p: u32 = 0;
    for (p < blk.phi_count) {
        val rr: err[fail.Fail] = check_one_instr(m, fn, blk.phis[p], fi, blk.id, r, o);
        if (sel rr.err) { ret rr; }
        p = p + 1;
    }
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        val rr: err[fail.Fail] = check_one_instr(m, fn, blk.instructions[ix], fi, blk.id, r, o);
        if (sel rr.err) { ret rr; }
        ix = ix + 1;
    }
    if (blk.terminator != id.INSTR_NIL) {
        val rr: err[fail.Fail] = check_one_instr(m, fn, blk.terminator, fi, blk.id, r, o);
        if (sel rr.err) { ret rr; }
    }
    ret err[fail.Fail].ok{};
}

fun check_one_instr(m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, fi: u32, bid: id.BlockId, r: *VerifyReport, o: VerifyOpts) err[fail.Fail] {
    if (iid >= fn.instr_len) { ret err[fail.Fail].ok{}; }
    val ins: *instruction.Instruction = ?fn.instrs[iid];

    val r_502: res[*opdesc.IrOpDescriptor, fail.Fail] = opdesc.describe(ins.kind);
    if (sel r_502.err) {
        val rk: err[fail.Fail] = push(r, fi, bid, iid, VC_OPCODE_KNOWN);
        if (sel rk.err) { ret rk; }
        r.violations[r.len - 1].tag = ins.kind::u32;
        ret err[fail.Fail].ok{};
    }

    if ((ins.flags & instruction.INSTR_FLAG_VOLATILE) != 0
        && !opdesc.accepts_volatile(ins.kind)) {
        val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_VOLATILE_FORM);
        if (sel rr.err) { ret rr; }
    }

    if (!arity_ok(ins.kind, ins.operand_count)) {
        val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_OPERAND_TYPE);
        if (sel rr.err) { ret rr; }
    }

    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val op: *value.Value = ?ins.operands[oi];
        if (op.kind > value.VAL_CONST_AGG) {
            val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_VALUE_KNOWN);
            if (sel rr.err) { ret rr; }
            r.violations[r.len - 1].tag = op.kind::u32;
            ret err[fail.Fail].ok{};
        }
        if (!const_type_ok(m, op)) {
            val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_CONST_TYPE);
            if (sel rr.err) { ret rr; }
        }
        if (o.repr) {
            if (op.ty != type.IRT_NIL) {
                val ot: opt[*type.IrType] = type.get(?m.types, op.ty);
                if (!sel ot.some || !type.reference_valid(?m.types, op.ty)) {
                    val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_TYPE_RESOLVE);
                    if (sel rr.err) { ret rr; }
                }
            }
            val dbg_unavailable: bool = ins.kind == instruction.OP_DBG_VALUE
                && op.kind == value.VAL_CONST_NULL;
            if (type.is_aggregate(?m.types, op.ty) && !dbg_unavailable
                && !agg_value_is_address_producing(fn, op)) {
                val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_AGG_ADDRESS);
                if (sel rr.err) { ret rr; }
            }
        }
        oi = oi + 1;
    }
    if (o.repr) {
        val res_aux: err[fail.Fail] = check_aux_resolve(m, ins, fi, bid, iid, r);
        if (sel res_aux.err) { ret res_aux; }
        val res_agree: err[fail.Fail] = check_type_agree(m, ins, fi, bid, iid, r);
        if (sel res_agree.err) { ret res_agree; }
    }
    val res_bc: err[fail.Fail] = check_bitcast_class(m, ins, fi, bid, iid, r);
    if (sel res_bc.err) { ret res_bc; }
    val res_call: err[fail.Fail] = check_call_arg_types(m, ins, fi, bid, iid, r);
    if (sel res_call.err) { ret res_call; }
    val res_cw: err[fail.Fail] = check_convert_width(m, ins, fi, bid, iid, r, o.tgt);
    if (sel res_cw.err) { ret res_cw; }
    ret err[fail.Fail].ok{};
}

fun check_convert_width(m: *ir.Module, ins: *instruction.Instruction, fi: u32, bid: id.BlockId, iid: id.InstructionId, r: *VerifyReport, tgt: *resolved.Target) err[fail.Fail] {
    val k: instruction.InstrKind = ins.kind;
    val narrows: bool = k == instruction.OP_TRUNC || k == instruction.OP_FP_TRUNC;
    val widens:  bool = k == instruction.OP_SEXT  || k == instruction.OP_ZEXT
                     || k == instruction.OP_FP_EXT;
    val keeps:   bool = k == instruction.OP_BITCAST;
    if (!narrows && !widens && !keeps) { ret err[fail.Fail].ok{}; }
    if (ins.operand_count < 1)         { ret err[fail.Fail].ok{}; }

    val src: type.IrTypeId = (?ins.operands[0]).ty;
    if (keeps && type.is_aggregate(?m.types, src) && type.is_aggregate(?m.types, ins.ty)) {
        val machine: layout.Machine = resolved.layout_machine(tgt);
        if (type.byte_size_for_machine(?m.types, src, machine)
            == type.byte_size_for_machine(?m.types, ins.ty, machine)) {
            ret err[fail.Fail].ok{};
        }
        ret push(r, fi, bid, iid, VC_CONVERT_WIDTH);
    }

    val sw: u32 = type.bit_width(?m.types, src);
    val dw: u32 = type.bit_width(?m.types, ins.ty);
    if (sw == 0 || dw == 0) { ret err[fail.Fail].ok{}; }

    if (narrows && dw < sw) { ret err[fail.Fail].ok{}; }
    if (widens  && dw > sw) { ret err[fail.Fail].ok{}; }
    if (keeps   && dw == sw) { ret err[fail.Fail].ok{}; }
    ret push(r, fi, bid, iid, VC_CONVERT_WIDTH);
}

fun check_aux_resolve(m: *ir.Module, ins: *instruction.Instruction, fi: u32, bid: id.BlockId, iid: id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (!opdesc.has(ins.kind, opdesc.EFF_USES_AUX_TYPE))            { ret err[fail.Fail].ok{}; }
    if (ins.kind == instruction.OP_GEP && ins.operand_count <= 1)   { ret err[fail.Fail].ok{}; }
    val ty: type.IrTypeId = ins.aux_ty;

    val at: opt[*type.IrType] = type.get(?m.types, ty);
    if (!sel at.some) { ret push(r, fi, bid, iid, VC_TYPE_RESOLVE); }
    if (!type.reference_valid(?m.types, ty)) { ret push(r, fi, bid, iid, VC_TYPE_RESOLVE); }
    ret err[fail.Fail].ok{};
}

fun check_type_agree(m: *ir.Module, ins: *instruction.Instruction, fi: u32, bid: id.BlockId, iid: id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    val k: instruction.InstrKind = ins.kind;

    if (is_binary_agree(k) && ins.operand_count == 2) {
        val t0: type.IrTypeId = ins.operands[0].ty;
        val t1: type.IrTypeId = ins.operands[1].ty;
        if (t0 != t1 && !(is_pointerish(m, t0) && is_pointerish(m, t1))) {
            ret push(r, fi, bid, iid, VC_TYPE_AGREE);
        }
    }
    if (ins.operand_count >= 1 && type.is_vector(?m.types, ins.operands[0].ty)) {
        val vt: type.IrTypeId = ins.operands[0].ty;
        if (is_vector_compare(k)) {
            if (ins.operand_count == 2 && ins.operands[1].ty != vt)  { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
            if (!vector_mask_shape_ok(m, vt, ins.ty))                { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        }
        or (is_vector_sameshape(k)) {
            if (ins.operand_count == 2 && ins.operands[1].ty != vt)  { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
            if (ins.ty != vt)                                        { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        }
    }
    if (k == instruction.OP_VEC_EXTRACT && ins.operand_count == 2) {
        if (!vector_lane_op_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_VEC_INSERT && ins.operand_count == 3) {
        if (!vector_lane_op_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_VEC_BUILD) {
        if (!vector_build_ok(m, ins)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_LOAD && ins.operand_count >= 1) {
        if (!is_address_typed(m, ins.operands[0].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_STORE && ins.operand_count >= 2) {
        if (!is_address_typed(m, ins.operands[1].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_GEP && ins.operand_count >= 1) {
        if (!is_address_typed(m, ins.operands[0].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_MEMZERO && ins.operand_count >= 1) {
        if (!is_address_typed(m, ins.operands[0].ty)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_BR && ins.operand_count >= 1) {
        if (ins.operands[0].kind != value.VAL_CONST_INT) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    if (k == instruction.OP_CBR && ins.operand_count >= 3) {
        if (!type_has_kind(m, ins.operands[0].ty, type.IRT_INT)) { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        if (ins.operands[1].kind != value.VAL_CONST_INT)         { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
        if (ins.operands[2].kind != value.VAL_CONST_INT)         { ret push(r, fi, bid, iid, VC_TYPE_AGREE); }
    }
    ret err[fail.Fail].ok{};
}

fun check_bitcast_class(m: *ir.Module, ins: *instruction.Instruction, fi: u32, bid: id.BlockId, iid: id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind != instruction.OP_BITCAST) { ret err[fail.Fail].ok{}; }
    if (ins.operand_count < 1)              { ret err[fail.Fail].ok{}; }
    val src: type.IrTypeId = (?ins.operands[0]).ty;
    if (src == type.IRT_NIL || ins.ty == type.IRT_NIL) { ret err[fail.Fail].ok{}; }
    if (type.is_aggregate(?m.types, src) == type.is_aggregate(?m.types, ins.ty)) {
        ret err[fail.Fail].ok{};
    }
    ret push(r, fi, bid, iid, VC_BITCAST_CLASS);
}

fun check_call_arg_types(m: *ir.Module, ins: *instruction.Instruction, fi: u32, bid: id.BlockId, iid: id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind != instruction.OP_CALL) { ret err[fail.Fail].ok{}; }
    if (ins.operand_count == 0)          { ret err[fail.Fail].ok{}; }

    val ot: opt[*type.IrType] = type.get(?m.types, ins.aux_ty);
    if (!sel ot.some)    { ret err[fail.Fail].ok{}; }
    val sig: *type.IrType = ot.some;
    if (sig.kind != type.IRT_FN)         { ret err[fail.Fail].ok{}; }

    val pc: u32 = sig.data.fn.param_count;
    var i: u32 = 0;
    for (i < pc) {
        val argix: u32 = i + 1;
        if (argix >= ins.operand_count) { ret err[fail.Fail].ok{}; }
        if (!call_arg_type_ok(m, sig.data.fn.params[i], ins.operands[argix].ty)) {
            val rr: err[fail.Fail] = push(r, fi, bid, iid, VC_CALL_ARG_TYPE);
            if (sel rr.err) { ret rr; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun call_arg_type_ok(m: *ir.Module, p: type.IrTypeId, q: type.IrTypeId) bool {
    if (p == q)                                 { ret true; }
    if (p == type.IRT_NIL || q == type.IRT_NIL) { ret true; }
    if (type.is_vector(?m.types, p))            { ret is_pointerish(m, q) || type.is_aggregate(?m.types, q); }
    if (type.is_aggregate(?m.types, p))         { ret type.is_aggregate(?m.types, q); }
    if (is_pointerish(m, p) && is_pointerish(m, q)) { ret true; }
    ret false;
}

fun is_binary_agree(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_OPERANDS_AGREE);
}


fun is_vector_compare(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}


fun is_vector_sameshape(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_VEC_SAMESHAPE);
}


fun vector_mask_shape_ok(m: *ir.Module, vt: type.IrTypeId, result_ty: type.IrTypeId) bool {
    val ov: opt[*type.IrType] = type.get(?m.types, vt);
    val orr: opt[*type.IrType] = type.get(?m.types, result_ty);
    if (!sel ov.some) { ret false; }
    if (!sel orr.some) { ret false; }
    val v:  *type.IrType = ov.some;
    val rr: *type.IrType = orr.some;
    if (v.kind != type.IRT_VECTOR || rr.kind != type.IRT_VECTOR)  { ret false; }
    if (v.data.vector_.lanes != rr.data.vector_.lanes)            { ret false; }

    val ove: opt[*type.IrType] = type.get(?m.types, v.data.vector_.element);
    val ore: opt[*type.IrType] = type.get(?m.types, rr.data.vector_.element);
    if (!sel ove.some) { ret false; }
    if (!sel ore.some) { ret false; }
    val re: *type.IrType = ore.some;
    if (re.kind != type.IRT_INT) { ret false; }
    ret ove.some.data.bits == re.data.bits;
}

fun vector_lane_op_ok(m: *ir.Module, ins: *instruction.Instruction) bool {
    val vt: type.IrTypeId = ins.operands[0].ty;
    val ov: opt[*type.IrType] = type.get(?m.types, vt);
    if (!sel ov.some) { ret false; }
    val v: *type.IrType = ov.some;
    if (v.kind != type.IRT_VECTOR) { ret false; }

    if (ins.operands[1].kind != value.VAL_CONST_INT)            { ret false; }
    if (ins.operands[1].data.int_lit >= v.data.vector_.lanes::u64) { ret false; }

    if (ins.kind == instruction.OP_VEC_EXTRACT) {
        ret ins.ty == v.data.vector_.element;
    }
    if (ins.operands[2].ty != v.data.vector_.element) { ret false; }
    ret ins.ty == vt;
}

fun vector_build_ok(m: *ir.Module, ins: *instruction.Instruction) bool {
    val ov: opt[*type.IrType] = type.get(?m.types, ins.ty);
    if (!sel ov.some) { ret false; }
    val v: *type.IrType = ov.some;
    if (v.kind != type.IRT_VECTOR) { ret false; }

    if (ins.operand_count != v.data.vector_.lanes) { ret false; }

    var i: u32 = 0;
    for (i < ins.operand_count) {
        if (ins.operands[i].ty != v.data.vector_.element) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun type_has_kind(m: *ir.Module, ty: type.IrTypeId, k: type.IrTypeKind) bool {
    val ot: opt[*type.IrType] = type.get(?m.types, ty);
    if (!sel ot.some) { ret false; }
    if (!type.reference_valid(?m.types, ty)) { ret false; }
    ret ot.some.kind == k;
}

fun is_address_typed(m: *ir.Module, ty: type.IrTypeId) bool {
    if (type_has_kind(m, ty, type.IRT_PTR)) { ret true; }
    ret type.is_aggregate(?m.types, ty);
}

fun is_pointerish(m: *ir.Module, ty: type.IrTypeId) bool {
    if (type_has_kind(m, ty, type.IRT_FN)) { ret true; }
    ret is_address_typed(m, ty);
}

fun agg_value_is_address_producing(fn: *ir.Function, op: *value.Value) bool {
    if (op.kind == value.VAL_GLOBAL) { ret true; }
    if (op.kind == value.VAL_PARAM)  { ret true; }
    if (op.kind == value.VAL_INSTR) {
        val did: id.InstructionId = op.data.instr;
        if (did >= fn.instr_len) { ret false; }
        ret opdesc.has((?fn.instrs[did]).kind, opdesc.EFF_MAY_BE_ADDRESS);
    }
    ret false;
}

fun check_pred_consistency(fn: *ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_count: res[*u32, A.Error] = A.allocate[u32](r.alloc, n::usize);
    if (sel res_count.err) { ret err[fail.Fail].err{fail.refused(res_count.err)}; }
    val count: *u32 = res_count.ok;

    var ti: u32 = 0;
    for (ti < n) {
        var z: u32 = 0;
        for (z < n) { count[z] = 0; z = z + 1; }

        val blk: *ir.Block = ?fn.blocks[ti];
        var bad: bool = false;
        var pi: u32 = 0;
        for (pi < blk.pred_count) {
            val p: id.BlockId = blk.preds[pi];
            if (p < n) {
                count[p] = count[p] + 1;
            }
            or {
                bad = true;
            }
            pi = pi + 1;
        }
        var s: u32 = 0;
        for (s < n) {
            var s0: id.BlockId = id.BLOCK_NIL;
            var s1: id.BlockId = id.BLOCK_NIL;
            val sc: u32 = ir.block_successors(fn, ?fn.blocks[s], ?s0, ?s1);
            if (sc >= 1 && s0 == ti::id.BlockId) { count[s] = count[s] - 1; }
            if (sc >= 2 && s1 == ti::id.BlockId) { count[s] = count[s] - 1; }
            s = s + 1;
        }
        if (!bad) {
            var k: u32 = 0;
            for (k < n) {
                if (count[k] != 0) { bad = true; }
                k = k + 1;
            }
        }
        if (bad) {
            val rr: err[fail.Fail] = push(r, fi, ti::id.BlockId, id.INSTR_NIL, VC_PRED_CONSISTENT);
            if (sel rr.err) { A.deallocate[u32](r.alloc, count, n::usize); ret rr; }
        }
        ti = ti + 1;
    }
    A.deallocate[u32](r.alloc, count, n::usize);
    ret err[fail.Fail].ok{};
}

fun check_phi_coverage(fn: *ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_count: res[*u32, A.Error] = A.allocate[u32](r.alloc, n::usize);
    if (sel res_count.err) { ret err[fail.Fail].err{fail.refused(res_count.err)}; }
    val count: *u32 = res_count.ok;

    var bi: u32 = 0;
    for (bi < n) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            val iid: id.InstructionId = blk.phis[p];
            if (iid < fn.instr_len) {
                val ins: *instruction.Instruction = ?fn.instrs[iid];
                var z: u32 = 0;
                for (z < n) { count[z] = 0; z = z + 1; }
                var bad: bool = false;
                if ((ins.operand_count % 2) != 0) { bad = true; }
                var o: u32 = 0;
                for (o + 1 < ins.operand_count) {
                    val src: id.BlockId = ir.block_target(ins.operands[o]);
                    if (src < n) {
                        count[src] = count[src] + 1;
                    }
                    or {
                        bad = true;
                    }
                    o = o + 2;
                }
                var pp: u32 = 0;
                for (pp < blk.pred_count) {
                    val pb: id.BlockId = blk.preds[pp];
                    if (pb < n) { count[pb] = count[pb] - 1; }
                    pp = pp + 1;
                }
                if (!bad) {
                    var k: u32 = 0;
                    for (k < n) {
                        if (count[k] != 0) { bad = true; }
                        k = k + 1;
                    }
                }
                if (bad) {
                    val rr: err[fail.Fail] = push(r, fi, blk.id, iid, VC_PHI_COVERAGE);
                    if (sel rr.err) { A.deallocate[u32](r.alloc, count, n::usize); ret rr; }
                }
            }
            p = p + 1;
        }
        bi = bi + 1;
    }
    A.deallocate[u32](r.alloc, count, n::usize);
    ret err[fail.Fail].ok{};
}

fun check_reachability(fn: *ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }
    val res_visited: res[*u8, A.Error] = A.allocate[u8](r.alloc, n::usize);
    if (sel res_visited.err) { ret err[fail.Fail].err{fail.refused(res_visited.err)}; }
    val visited: *u8 = res_visited.ok;
    val res_stack: res[*u32, A.Error] = A.allocate[u32](r.alloc, n::usize);
    if (sel res_stack.err) { A.deallocate[u8](r.alloc, visited, n::usize); ret err[fail.Fail].err{fail.refused(res_stack.err)}; }
    val stack: *u32 = res_stack.ok;

    var i: u32 = 0;
    for (i < n) { visited[i] = 0; i = i + 1; }
    var sp: u32 = 0;
    visited[0] = 1;
    stack[sp] = 0; sp = sp + 1;
    for (sp > 0) {
        sp = sp - 1;
        val b: u32 = stack[sp];
        var s0: id.BlockId = id.BLOCK_NIL;
        var s1: id.BlockId = id.BLOCK_NIL;
        val sc: u32 = ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        if (sc >= 1 && s0 < n && visited[s0] == 0) { visited[s0] = 1; stack[sp] = s0; sp = sp + 1; }
        if (sc >= 2 && s1 < n && visited[s1] == 0) { visited[s1] = 1; stack[sp] = s1; sp = sp + 1; }
    }

    var bi: u32 = 1;
    for (bi < n) {
        if (visited[bi] == 0) {
            val rr: err[fail.Fail] = push(r, fi, bi::id.BlockId, id.INSTR_NIL, VC_REACHABILITY);
            if (sel rr.err) { A.deallocate[u8](r.alloc, visited, n::usize); A.deallocate[u32](r.alloc, stack, n::usize); ret rr; }
        }
        bi = bi + 1;
    }
    A.deallocate[u8](r.alloc, visited, n::usize);
    A.deallocate[u32](r.alloc, stack, n::usize);
    ret err[fail.Fail].ok{};
}

val DEF_BLOCK_NIL: u32 = 0xFFFFFFFF;
val RPO_NIL: u32 = 0xFFFFFFFF;

rec DomScratch {
    rpo_num:   *u32;
    post:      *u32;
    succ_ix:   *u32;
    stack:     *u32;
    idom:      *u32;
    def_block: *u32;
    def_ord:   *u32;
    n:         u32;
    il:        u32;
}

fun check_dominance(fn: *ir.Function, fi: u32, r: *VerifyReport) err[fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    var sc: DomScratch;
    val opt_alloc: err[fail.Fail] = dom_scratch_alloc(r.alloc, n, fn.instr_len, ?sc);
    if (sel opt_alloc.err) { ret err[fail.Fail].err{opt_alloc.err}; }

    compute_rpo(fn, ?sc);
    compute_idom(fn, ?sc);
    index_definitions(fn, sc.def_block, sc.def_ord);

    var bi: u32 = 0;
    for (bi < n) {
        val blk: *ir.Block = ?fn.blocks[bi];
        val reachable: bool = sc.rpo_num[bi] != RPO_NIL;
        var p: u32 = 0;
        for (p < blk.phi_count) {
            val phi_id: id.InstructionId = blk.phis[p];
            if (phi_id < fn.instr_len) {
                val ins: *instruction.Instruction = ?fn.instrs[phi_id];
                val rr: err[fail.Fail] = check_phi_incomings_dominate(fn, ins, ?sc, fi, blk.id, phi_id, r);
                if (sel rr.err) { dom_scratch_free(r.alloc, ?sc); ret rr; }
            }
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val use_id: id.InstructionId = blk.instructions[ix];
            if (use_id < fn.instr_len) {
                val ins: *instruction.Instruction = ?fn.instrs[use_id];
                val rr: err[fail.Fail] = check_operands_dominate(fn, ins, bi, sc.def_ord[use_id], ?sc, reachable, fi, blk.id, use_id, r);
                if (sel rr.err) { dom_scratch_free(r.alloc, ?sc); ret rr; }
            }
            ix = ix + 1;
        }
        if (blk.terminator != id.INSTR_NIL && blk.terminator < fn.instr_len) {
            val ins: *instruction.Instruction = ?fn.instrs[blk.terminator];
            val rr: err[fail.Fail] = check_operands_dominate(fn, ins, bi, sc.def_ord[blk.terminator], ?sc, reachable, fi, blk.id, blk.terminator, r);
            if (sel rr.err) { dom_scratch_free(r.alloc, ?sc); ret rr; }
        }
        bi = bi + 1;
    }

    dom_scratch_free(r.alloc, ?sc);
    ret err[fail.Fail].ok{};
}

fun dom_scratch_alloc(alloc: *A.Allocator, n: u32, il: u32, sc: *DomScratch) err[fail.Fail] {
    sc.n  = n;
    sc.il = il;
    sc.rpo_num = nil; sc.post = nil; sc.succ_ix = nil; sc.stack = nil;
    sc.idom = nil; sc.def_block = nil; sc.def_ord = nil;

    val a1: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a1.err) { ret err[fail.Fail].err{fail.refused(a1.err)}; }
    sc.rpo_num = a1.ok;
    val a2: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a2.err) { dom_scratch_free(alloc, sc); ret err[fail.Fail].err{fail.refused(a2.err)}; }
    sc.post = a2.ok;
    val a3: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a3.err) { dom_scratch_free(alloc, sc); ret err[fail.Fail].err{fail.refused(a3.err)}; }
    sc.succ_ix = a3.ok;
    val a4: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a4.err) { dom_scratch_free(alloc, sc); ret err[fail.Fail].err{fail.refused(a4.err)}; }
    sc.stack = a4.ok;
    val a5: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel a5.err) { dom_scratch_free(alloc, sc); ret err[fail.Fail].err{fail.refused(a5.err)}; }
    sc.idom = a5.ok;
    val a6: res[*u32, A.Error] = A.allocate[u32](alloc, il::usize);
    if (sel a6.err) { dom_scratch_free(alloc, sc); ret err[fail.Fail].err{fail.refused(a6.err)}; }
    sc.def_block = a6.ok;
    val a7: res[*u32, A.Error] = A.allocate[u32](alloc, il::usize);
    if (sel a7.err) { dom_scratch_free(alloc, sc); ret err[fail.Fail].err{fail.refused(a7.err)}; }
    sc.def_ord = a7.ok;
    ret err[fail.Fail].ok{};
}

fun dom_scratch_free(alloc: *A.Allocator, sc: *DomScratch) {
    if (sc.rpo_num != nil)   { A.deallocate[u32](alloc, sc.rpo_num, sc.n::usize); }
    if (sc.post != nil)      { A.deallocate[u32](alloc, sc.post, sc.n::usize); }
    if (sc.succ_ix != nil)   { A.deallocate[u32](alloc, sc.succ_ix, sc.n::usize); }
    if (sc.stack != nil)     { A.deallocate[u32](alloc, sc.stack, sc.n::usize); }
    if (sc.idom != nil)      { A.deallocate[u32](alloc, sc.idom, sc.n::usize); }
    if (sc.def_block != nil) { A.deallocate[u32](alloc, sc.def_block, sc.il::usize); }
    if (sc.def_ord != nil)   { A.deallocate[u32](alloc, sc.def_ord, sc.il::usize); }
    sc.rpo_num = nil; sc.post = nil; sc.succ_ix = nil; sc.stack = nil;
    sc.idom = nil; sc.def_block = nil; sc.def_ord = nil;
}

fun compute_rpo(fn: *ir.Function, sc: *DomScratch) {
    val n: u32 = sc.n;
    var i: u32 = 0;
    for (i < n) { sc.rpo_num[i] = RPO_NIL; sc.succ_ix[i] = 0; i = i + 1; }

    var pc: u32 = 0;
    var sp: u32 = 0;
    val DISCOVERED: u32 = 0xFFFFFFFE;
    sc.rpo_num[0] = DISCOVERED;
    sc.stack[sp]  = 0; sp = sp + 1;
    for (sp > 0) {
        val b: u32 = sc.stack[sp - 1];
        var s0: id.BlockId = id.BLOCK_NIL;
        var s1: id.BlockId = id.BLOCK_NIL;
        val cnt: u32 = ir.block_successors(fn, ?fn.blocks[b], ?s0, ?s1);
        var advanced: bool = false;
        for (sc.succ_ix[b] < cnt && !advanced) {
            val k: u32 = sc.succ_ix[b];
            sc.succ_ix[b] = k + 1;
            var t: id.BlockId = s0;
            if (k == 1) { t = s1; }
            if (t < n && sc.rpo_num[t] == RPO_NIL) {
                sc.rpo_num[t] = DISCOVERED;
                sc.stack[sp]  = t; sp = sp + 1;
                advanced = true;
            }
        }
        if (!advanced) {
            sp = sp - 1;
            sc.post[pc] = b; pc = pc + 1;
        }
    }

    var j: u32 = 0;
    for (j < pc) {
        sc.rpo_num[sc.post[j]] = pc - 1 - j;
        j = j + 1;
    }
    sc.stack[0] = pc;
}

fun compute_idom(fn: *ir.Function, sc: *DomScratch) {
    val n: u32 = sc.n;
    val pc: u32 = sc.stack[0];
    var i: u32 = 0;
    for (i < n) { sc.idom[i] = id.BLOCK_NIL; i = i + 1; }
    if (pc == 0) { ret; }
    sc.idom[0] = 0;

    var changed: bool = true;
    for (changed) {
        changed = false;
        var ri: u32 = 1;
        for (ri < pc) {
            val b: u32 = sc.post[pc - 1 - ri];
            val blk: *ir.Block = ?fn.blocks[b];
            var new_idom: u32 = id.BLOCK_NIL;
            var pi: u32 = 0;
            for (pi < blk.pred_count) {
                val p: id.BlockId = blk.preds[pi];
                if (p < n && sc.rpo_num[p] != RPO_NIL && sc.idom[p] != id.BLOCK_NIL) {
                    if (new_idom == id.BLOCK_NIL) { new_idom = p; }
                    or                            { new_idom = idom_intersect(sc, p, new_idom); }
                }
                pi = pi + 1;
            }
            if (new_idom != id.BLOCK_NIL && sc.idom[b] != new_idom) {
                sc.idom[b] = new_idom;
                changed = true;
            }
            ri = ri + 1;
        }
    }
}

fun idom_intersect(sc: *DomScratch, a: u32, b: u32) u32 {
    var x: u32 = a;
    var y: u32 = b;
    var steps: u32 = 0;
    val cap: u32 = 2 * sc.n + 2;
    for (x != y && steps <= cap) {
        for (x != y && sc.rpo_num[x] > sc.rpo_num[y]) { x = sc.idom[x]; steps = steps + 1; }
        for (x != y && sc.rpo_num[y] > sc.rpo_num[x]) { y = sc.idom[y]; steps = steps + 1; }
        steps = steps + 1;
    }
    ret x;
}

fun index_definitions(fn: *ir.Function, def_block: *u32, def_ord: *u32) {
    var i: u32 = 0;
    for (i < fn.instr_len) { def_block[i] = DEF_BLOCK_NIL; def_ord[i] = 0; i = i + 1; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var ord: u32 = 0;
        var p: u32 = 0;
        for (p < blk.phi_count) {
            val iid: id.InstructionId = blk.phis[p];
            if (iid < fn.instr_len) { def_block[iid] = bi; def_ord[iid] = ord; }
            ord = ord + 1;
            p = p + 1;
        }
        var ix: u32 = 0;
        for (ix < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ix];
            if (iid < fn.instr_len) { def_block[iid] = bi; def_ord[iid] = ord; }
            ord = ord + 1;
            ix = ix + 1;
        }
        if (blk.terminator != id.INSTR_NIL && blk.terminator < fn.instr_len) {
            def_block[blk.terminator] = bi;
            def_ord[blk.terminator]   = ord;
        }
        bi = bi + 1;
    }
}

fun check_operands_dominate(fn: *ir.Function, ins: *instruction.Instruction, use_block: u32, use_ord: u32, sc: *DomScratch, use_reachable: bool, fi: u32, bid: id.BlockId, use_id: id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind == instruction.OP_PHI) { ret err[fail.Fail].ok{}; }
    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val op: *value.Value = ?ins.operands[oi];
        if (op.kind == value.VAL_INSTR) {
            val def_id: id.InstructionId = op.data.instr;
            if (def_id < fn.instr_len) {
                val db: u32 = sc.def_block[def_id];
                if (db != DEF_BLOCK_NIL && use_reachable
                    && !def_dominates_use(sc, db, sc.def_ord[def_id], use_block, use_ord)) {
                    val rr: err[fail.Fail] = push(r, fi, bid, use_id, VC_DOMINANCE);
                    if (sel rr.err) { ret rr; }
                }
            }
        }
        oi = oi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun check_phi_incomings_dominate(fn: *ir.Function, ins: *instruction.Instruction, sc: *DomScratch, fi: u32, bid: id.BlockId, use_id: id.InstructionId, r: *VerifyReport) err[fail.Fail] {
    if (ins.kind != instruction.OP_PHI) { ret err[fail.Fail].ok{}; }
    var k: u32 = 0;
    for (k + 1 < ins.operand_count) {
        val pred: id.BlockId = ir.block_target(ins.operands[k]);
        val op: *value.Value = ?ins.operands[k + 1];
        if (op.kind == value.VAL_INSTR && pred < sc.n && sc.rpo_num[pred] != RPO_NIL) {
            val def_id: id.InstructionId = op.data.instr;
            if (def_id < fn.instr_len) {
                val db: u32 = sc.def_block[def_id];
                if (db != DEF_BLOCK_NIL && db != pred::u32 && !block_dominates(sc, db, pred::u32)) {
                    val rr: err[fail.Fail] = push(r, fi, bid, use_id, VC_DOMINANCE);
                    if (sel rr.err) { ret rr; }
                }
            }
        }
        k = k + 2;
    }
    ret err[fail.Fail].ok{};
}

fun def_dominates_use(sc: *DomScratch, def_block: u32, def_ord: u32, use_block: u32, use_ord: u32) bool {
    if (def_block == use_block) { ret def_ord < use_ord; }
    ret block_dominates(sc, def_block, use_block);
}

fun block_dominates(sc: *DomScratch, a: u32, b: u32) bool {
    if (sc.rpo_num[a] == RPO_NIL) { ret false; }
    var x: u32 = b;
    var steps: u32 = 0;
    for (x != 0 && steps <= sc.n) {
        x = sc.idom[x];
        if (x == a) { ret true; }
        steps = steps + 1;
    }
    ret false;
}

fun arity_ok(k: instruction.InstrKind, operand_count: u32) bool {
    ret opdesc.arity_ok(k, operand_count);
}


fun const_type_ok(m: *ir.Module, v: *value.Value) bool {
    if (v.kind == value.VAL_CONST_FLOAT) {
        ret type_kind_is(m, v.ty, type.IRT_FLOAT);
    }
    if (v.kind == value.VAL_CONST_INT) {
        if (type_kind_is(m, v.ty, type.IRT_INT)) { ret true; }
        ret type_kind_is(m, v.ty, type.IRT_PTR);
    }
    ret true;
}

fun type_kind_is(m: *ir.Module, tid: type.IrTypeId, kind: type.IrTypeKind) bool {
    val got: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel got.some) {
        val ty: *type.IrType = got.some;
        ret ty.kind == kind;
    }
    ret true;
}

fun push(r: *VerifyReport, function: u32, block: id.BlockId, iid: id.InstructionId, check: VerifyCheck) err[fail.Fail] {
    if (r.len == r.cap) {
        var new_cap: u32 = r.cap * 2;
        if (r.cap == 0) { new_cap = VIOLATION_SEED_CAP; }
        if (r.violations == nil) {
            val ar: res[*Violation, A.Error] = A.allocate[Violation](r.alloc, new_cap::usize);
            if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
            r.violations = ar.ok;
        }
        or {
            val ar: res[*Violation, A.Error] = A.reallocate[Violation](r.alloc, r.violations, r.cap::usize, new_cap::usize);
            if (sel ar.err) { ret err[fail.Fail].err{fail.refused(ar.err)}; }
            r.violations = ar.ok;
        }
        r.cap = new_cap;
    }
    var v: Violation;
    v.function = function;
    v.block    = block;
    v.instr    = iid;
    v.check    = check;
    v.tag      = 0;
    r.violations[r.len] = v;
    r.len = r.len + 1;
    ret err[fail.Fail].ok{};
}

rec TEnv {
    alloc: A.Allocator;
    registry: target.TargetRegistry;
    m:     ir.Module;
    bld:   builder.Builder;
    i64ty: type.IrTypeId;
    tgt:   resolved.Target;
}

fun t_env(env: *TEnv) bool {
    page.make(?env.alloc);

    env.registry = target.registry_init();
    val r_1289: err[fail.Fail] = target.register_all(?env.registry, target_testing.debug_descriptor);
    if (sel r_1289.err) { ret false; }
    val tr: res[resolved.Target, fail.Fail] = target.select(?env.registry, "x86_64", "linux", "sysv64");
    if (sel tr.err) { target.registry_dnit(?env.registry); ret false; }
    env.tgt = tr.ok;

    val mr: res[ir.Module, fail.Fail] = ir.init(?env.alloc, intern.STR_NIL);
    if (sel mr.err) { ret false; }
    env.m = mr.ok;

    val it: res[type.IrTypeId, fail.Fail] = type.intern_int(?env.m.types, 64);
    if (sel it.err) { ret false; }
    env.i64ty = it.ok;

    val vt: res[type.IrTypeId, fail.Fail] = type.intern_void(?env.m.types);
    if (sel vt.err) { ret false; }
    val voidty: type.IrTypeId = vt.ok;

    val sr: res[type.IrTypeId, fail.Fail] = type.intern_fn(?env.m.types, voidty, nil, 0, false);
    if (sel sr.err) { ret false; }
    val sig: type.IrTypeId = sr.ok;

    val fr: res[u32, fail.Fail] = ir.function_add(?env.m, intern.STR_NIL, sig, 0);
    if (sel fr.err) { ret false; }

    env.bld = builder.init(?env.m);
    builder.set_function(?env.bld, ?env.m.functions[0]);
    ret true;
}

fun t_block(env: *TEnv) id.BlockId {
    val r: res[id.BlockId, fail.Fail] = builder.new_block(?env.bld);
    if (sel r.err) { ret id.BLOCK_NIL; }
    ret r.ok;
}

fun t_ci(env: *TEnv, n: u64) value.Value {
    ret value.const_int(n, env.i64ty);
}

fun t_count(env: *TEnv, full: bool, repr: bool, check: VerifyCheck) i64 {
    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, full, repr));
    if (sel rr.err) { ret -1; }
    var rep: VerifyReport = rr.ok;
    var c: i64 = 0;
    var i: u32 = 0;
    for (i < rep.len) {
        if (rep.violations[i].check == check) { c = c + 1; }
        i = i + 1;
    }
    dnit_report(?rep);
    ret c;
}

fun t_total(env: *TEnv, full: bool, repr: bool) i64 {
    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, full, repr));
    if (sel rr.err) { ret -1; }
    var rep: VerifyReport = rr.ok;
    val c: i64 = rep.len::i64;
    dnit_report(?rep);
    ret c;
}

test "mach.lang.me.ir.verify.check_dominance:diamond_entry_def" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel av.err) { ret 1; }
    val v: value.Value = av.ok;
    val r_1366: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_1366.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val r_1369: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1369.err) { ret 1; }
    builder.set_block(?env.bld, b2);
    val r_1371: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1371.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val r_1374: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, c);
    if (sel r_1374.err) { ret 1; }
    val r_1375: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1375.err) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_dominance:diamond_arm_def" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val r_1393: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_1393.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel av.err) { ret 1; }
    val v: value.Value = av.ok;
    val r_1399: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1399.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val r_1402: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_1402.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val r_1405: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, c);
    if (sel r_1405.err) { ret 1; }
    val r_1406: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1406.err) { ret 1; }

    if (t_count(?env, true, false, VC_DOMINANCE) < 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_dominance:loop_header_def" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val r_1424: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_1424.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel av.err) { ret 1; }
    val v: value.Value = av.ok;
    val r_1430: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b2, b3);
    if (sel r_1430.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val r_1433: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, c);
    if (sel r_1433.err) { ret 1; }
    val r_1434: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_1434.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val r_1437: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1437.err) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.verify.check_dominance:loop_body_def_after" {
    var env: TEnv;
    fin { target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: id.BlockId = t_block(?env);
    val b1: id.BlockId = t_block(?env);
    val b2: id.BlockId = t_block(?env);
    val b3: id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val r_1455: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_1455.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val r_1458: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b2, b3);
    if (sel r_1458.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val av: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel av.err) { ret 1; }
    val v: value.Value = av.ok;
    val r_1464: err[fail.Fail] = builder.emit_br(?env.bld, b1);
    if (sel r_1464.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val r_1467: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, v, c);
    if (sel r_1467.err) { ret 1; }
    val r_1468: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1468.err) { ret 1; }

    if (t_count(?env, true, false, VC_DOMINANCE) < 1) { ret 1; }
    ret 0;
}

