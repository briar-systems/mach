    val ei: res[type.IrTypeId, fail.Fail] = type.intern_int(?env.m.types, 32);
    if (sel ei.err) { ret 1; }
    val mr: res[type.IrTypeId, fail.Fail] = type.intern_vector(?env.m.types, ei.ok, 4);
