test check_volatile_form__requires_memory_access {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val entry: ir_id.BlockId = t_block(?env);
    if (entry == ir_id.BLOCK_NIL) { ret 1; }
    builder.set_block(?env.bld, entry);

    val sum: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, t_ci(?env, 1), t_ci(?env, 2));
    if (sel sum.err) { ret 1; }
    val add: value.Value = sum.ok;
    env.m.functions[0].instrs[add.data.instr].flags = ir_instruction.INSTR_FLAG_VOLATILE;
    val r_2368: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2368.err) { ret 1; }

    if (t_count(?env, false, false, VC_VOLATILE_FORM) != 1) { ret 1; }
    env.m.functions[0].instrs[add.data.instr].flags = 0;
    if (t_count(?env, false, false, VC_VOLATILE_FORM) != 0) { ret 1; }
    ret 0;
}

test check_bounded_form__requires_a_shift {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val entry: ir_id.BlockId = t_block(?env);
    if (entry == ir_id.BLOCK_NIL) { ret 1; }
    builder.set_block(?env.bld, entry);

    val sum: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, t_ci(?env, 1), t_ci(?env, 2));
    if (sel sum.err) { ret 1; }
    val shifted: res[value.Value, fail.Fail] = builder.emit_shl(?env.bld, sum.ok, t_ci(?env, 3));
    if (sel shifted.err) { ret 1; }
    val r_ret: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_ret.err) { ret 1; }

    env.m.functions[0].instrs[shifted.ok.data.instr].flags = ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
    if (t_count(?env, false, false, VC_BOUNDED_FORM) != 0) { ret 2; }
    env.m.functions[0].instrs[sum.ok.data.instr].flags = ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
    if (t_count(?env, false, false, VC_BOUNDED_FORM) != 1) { ret 3; }
    ret 0;
}

test check_opcode_known__no_descriptor {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: me_ir.Module = rm.ok;
    fin { me_ir.dnit(?m); }

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel ri.err) { ret 1; }
    val i32t: ir_type.IrTypeId = ri.ok;

    val rfa: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, i32t, 0);
    if (sel rfa.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[rfa.ok];
    var b:  builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[ir_id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ret 1; }
    builder.set_block(?b, rb.ok);
    val ra: res[value.Value, fail.Fail] = builder.emit_add(?b, value.const_int(1, i32t), value.const_int(2, i32t));
    if (sel ra.err) { ret 1; }
    val r_2398: err[fail.Fail] = builder.emit_ret(?b, ra.ok);
    if (sel r_2398.err) { ret 1; }

    if (t_first_check(?m, ?alloc) != VC_NONE_SEEN) { ret 1; }

    fn.instrs[ra.ok.data.instr::u32].kind = 200::ir_instruction.InstrKind;
    if (t_first_check(?m, ?alloc) != VC_OPCODE_KNOWN) { ret 1; }
    ret 0;
}

#[testing]
val VC_NONE_SEEN: VerifyCheck = 255;

#[testing]
fun t_first_check(m: *me_ir.Module, alloc: *A.Allocator) VerifyCheck {
    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(m, alloc, opts(nil, false, false));
    if (sel rr.err) { ret VC_NONE_SEEN; }
    var rep: VerifyReport = rr.ok;
    if (rep.len == 0) {
        dnit_report(?rep);
        ret VC_NONE_SEEN;
    }
    val c: VerifyCheck = rep.violations[0].check;
    dnit_report(?rep);
    ret c;
}

test check_value_known__numeric_tag {
    var env: TEnv;
    if (!t_env(?env)) { ret 1; }
    fin {
        me_ir.dnit(?env.m);
        lang_target.registry_dnit(?env.registry);
    }
    val entry: ir_id.BlockId = t_block(?env);
    if (entry == ir_id.BLOCK_NIL) { ret 2; }
    builder.set_block(?env.bld, entry);
    val added: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, t_ci(?env, 1), t_ci(?env, 2));
    if (sel added.err) { ret 3; }
    val r_2428: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2428.err) { ret 3; }
    val iid:     ir_id.InstructionId = added.ok.data.instr;
    val operand: *value.Value        = ?env.m.functions[0].instrs[iid].operands[0];
    if (t_total(?env, false, false) != 0) { ret 4; }
    val unknown: [3]u8 = [3]u8{9, 200, 255};
    var i:       usize = 0;
    for (i < 3) {
        operand.kind = unknown[i];
        val checked: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(nil, false, false));
        operand.kind = value.VAL_CONST_INT;
        if (sel checked.err) { ret 5; }
        var report: VerifyReport = checked.ok;
        fin { dnit_report(?report); }
        if (report.len != 1 || report.violations[0].check != VC_VALUE_KNOWN || report.violations[0].tag != unknown[i]::u32) { ret 6; }
        if (i == 1) {
            if (t_describe_refusals(nil, ?report.violations[0], nil, nil, "unknown ValueKind tag 200") != 0) { ret 7; }
        }
        i = i + 1;
    }
    if (t_total(?env, false, false) != 0) { ret 8; }
    ret 0;
}

#[testing]
fun t_describe_attempt(m: *me_ir.Module, v: *Violation, itn: *intern.Interner,
    srcmap: *lang_source.SourceMap, expected: str, ordinal: usize, attempts: *usize) i32 {
    var testing: T.Testing;
    val r_2454:  err[A.Error] = T.make(?testing);
    if (sel r_2454.err) { ret 1; }
    fin { T.dnit(?testing); }
    T.fail_at_ordinal(?testing, ordinal);
    val alloc:     *A.Allocator        = T.allocator_of(?testing);
    val described: res[str, fail.Fail] = describe_located(m, v, itn, srcmap, alloc);
    @attempts = T.attempt_count(?testing);
    var code: i32 = 0;
    if (sel described.ok) {
        val text: str = described.ok;
        if (ordinal != 0 || !str_contains(text, expected)) { code = 2; }
        str_free(alloc, text);
    }
    or (sel described.err) {
        if (ordinal == 0 || !str_equals(fail.describe(described.err), "out of memory")) { code = 3; }
    }
    if (T.leaked(?testing) || T.double_free_count(?testing) != 0 || T.tracking_exhausted(?testing)) { code = 4; }
    ret code;
}

#[testing]
fun t_describe_refusals(m: *me_ir.Module, v: *Violation, itn: *intern.Interner,
    srcmap: *lang_source.SourceMap, expected: str) i32 {
    var attempts: usize = 0;
    val baseline: i32   = t_describe_attempt(m, v, itn, srcmap, expected, 0, ?attempts);
    if (baseline != 0 || attempts == 0) { ret 10; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var refused: usize = 0;
        val code:    i32   = t_describe_attempt(m, v, itn, srcmap, expected, ordinal, ?refused);
        if (code != 0) { ret 10 + code; }
        ordinal = ordinal + 1;
    }
    ret 0;
}
