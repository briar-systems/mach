test check_bitcast_class__same_class_accepted {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }

    val ar_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?env.m.types, env.i64ty, 1);
    if (sel ar_r.err) { ret 1; }
    val arrty: ir_type.IrTypeId                 = ar_r.ok;
    val ar2_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?env.m.types, env.i64ty, 1);
    if (sel ar2_r.err) { ret 1; }
    val arrty2: ir_type.IrTypeId = ar2_r.ok;

    val b0: ir_id.BlockId = t_block(?env);
    builder.set_block(?env.bld, b0);

    val v1: res[value.Value, fail.Fail] = builder.emit_bitcast(?env.bld, t_ci(?env, 7), env.i64ty);
    if (sel v1.err) { ret 1; }

    val slot_r: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, arrty, t_ci(?env, 1));
    if (sel slot_r.err) { ret 1; }
    val agg: value.Value                 = value.retype(slot_r.ok, arrty);
    val v2:  res[value.Value, fail.Fail] = builder.emit_bitcast(?env.bld, agg, arrty2);
    if (sel v2.err) { ret 1; }

    val r_1655: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1655.err) { ret 1; }

    if (t_count(?env, false, false, VC_BITCAST_CLASS) != 0) { ret 1; }
    ret 0;
}

test check_convert_width__bitcast_must_keep_width {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }

    val i8r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 8);
    if (sel i8r.err) { ret 1; }
    val i8ty: ir_type.IrTypeId                 = i8r.ok;
    val i32r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, 32);
    if (sel i32r.err) { ret 1; }
    val i32ty: ir_type.IrTypeId = i32r.ok;

    val b0: ir_id.BlockId = t_block(?env);
    builder.set_block(?env.bld, b0);

    val narrow: value.Value                 = value.const_int(1, i8ty);
    val bad:    res[value.Value, fail.Fail] = builder.emit_bitcast(?env.bld, narrow, i32ty);
    if (sel bad.err) { ret 1; }
    val r_1679: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1679.err) { ret 1; }

    if (t_count(?env, false, false, VC_CONVERT_WIDTH) != 1) { ret 1; }
    if (t_count(?env, false, true, VC_CONVERT_WIDTH) != 1)  { ret 1; }

    var ok_env: TEnv;
    fin { lang_target.registry_dnit(?ok_env.registry); }
    if (!t_env(?ok_env)) { ret 1; }
    val o32r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ok_env.m.types, 32);
    if (sel o32r.err) { ret 1; }
    val o32ty: ir_type.IrTypeId = o32r.ok;
    val ob0:   ir_id.BlockId    = t_block(?ok_env);
    builder.set_block(?ok_env.bld, ob0);
    val good: res[value.Value, fail.Fail] = builder.emit_bitcast(?ok_env.bld, value.const_int(1, o32ty), o32ty);
    if (sel good.err) { ret 1; }
    val r_1694: err[fail.Fail] = builder.emit_ret_void(?ok_env.bld);
    if (sel r_1694.err)                                        { ret 1; }
    if (t_count(?ok_env, false, false, VC_CONVERT_WIDTH) != 0) { ret 1; }
    ret 0;
}

test check_convert_width__aggregate_bitcast_must_keep_size {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }

    var fields: [2]ir_type.IrTypeId;
    fields[0] = env.i64ty;
    fields[1] = env.i64ty;
    val big_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?env.m.types, ?fields[0], 2, 0, false);
    if (sel big_r.err) { ret 1; }
    val big:     ir_type.IrTypeId                 = big_r.ok;
    val small_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?env.m.types, ?env.i64ty, 1, 0, false);
    if (sel small_r.err) { ret 1; }
    val small: ir_type.IrTypeId = small_r.ok;

    val b0: ir_id.BlockId = t_block(?env);
    builder.set_block(?env.bld, b0);
    val slot_r: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, big, t_ci(?env, 1));
    if (sel slot_r.err) { ret 1; }
    val agg: value.Value                 = value.retype(slot_r.ok, big);
    val bad: res[value.Value, fail.Fail] = builder.emit_bitcast(?env.bld, agg, small);
    if (sel bad.err) { ret 1; }
    val r_1721: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1721.err) { ret 1; }

    if (t_count(?env, false, false, VC_CONVERT_WIDTH) != 1) { ret 1; }
    if (t_count(?env, false, true, VC_CONVERT_WIDTH) != 1)  { ret 1; }
    if (t_count(?env, false, false, VC_BITCAST_CLASS) != 0) { ret 1; }

    var ok_env: TEnv;
    fin { lang_target.registry_dnit(?ok_env.registry); }
    if (!t_env(?ok_env)) { ret 1; }
    var ofields: [2]ir_type.IrTypeId;
    ofields[0] = ok_env.i64ty;
    ofields[1] = ok_env.i64ty;
    val ost_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?ok_env.m.types, ?ofields[0], 2, 0, false);
    if (sel ost_r.err) { ret 1; }
    val ost:   ir_type.IrTypeId                 = ost_r.ok;
    val oar_r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?ok_env.m.types, ok_env.i64ty, 2);
    if (sel oar_r.err) { ret 1; }
    val oar: ir_type.IrTypeId = oar_r.ok;

    val ob0: ir_id.BlockId = t_block(?ok_env);
    builder.set_block(?ok_env.bld, ob0);
    val oslot_r: res[value.Value, fail.Fail] = builder.emit_alloca(?ok_env.bld, ost, t_ci(?ok_env, 1));
    if (sel oslot_r.err) { ret 1; }
    val oagg: value.Value                 = value.retype(oslot_r.ok, ost);
    val good: res[value.Value, fail.Fail] = builder.emit_bitcast(?ok_env.bld, oagg, oar);
    if (sel good.err) { ret 1; }

    val pr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ok_env.m.types);
    if (sel pr.err) { ret 1; }
    val pty: ir_type.IrTypeId            = pr.ok;
    val pbc: res[value.Value, fail.Fail] = builder.emit_bitcast(?ok_env.bld, value.const_null(pty), pty);
    if (sel pbc.err) { ret 1; }
    val r_1753: err[fail.Fail] = builder.emit_ret_void(?ok_env.bld);
    if (sel r_1753.err) { ret 1; }

    if (t_count(?ok_env, false, false, VC_CONVERT_WIDTH) != 0) { ret 1; }
    ret 0;
}

test check_convert_width__direction_per_opcode {
    var bad: i32 = 0;
    if (t_convert(ir_instruction.OP_TRUNC, 8, 32) != 1)  { bad = 1; }
    if (t_convert(ir_instruction.OP_SEXT, 32, 8) != 1)   { bad = 1; }
    if (t_convert(ir_instruction.OP_ZEXT, 32, 8) != 1)   { bad = 1; }
    if (t_convert(ir_instruction.OP_TRUNC, 32, 32) != 1) { bad = 1; }
    if (t_convert(ir_instruction.OP_SEXT, 32, 32) != 1)  { bad = 1; }
    if (t_convert(ir_instruction.OP_ZEXT, 32, 32) != 1)  { bad = 1; }

    if (t_convert(ir_instruction.OP_TRUNC, 32, 8) != 0) { bad = 1; }
    if (t_convert(ir_instruction.OP_SEXT, 8, 32) != 0)  { bad = 1; }
    if (t_convert(ir_instruction.OP_ZEXT, 8, 32) != 0)  { bad = 1; }
    ret bad;
}

#[testing]
fun t_convert(k: ir_instruction.InstrKind, from: u32, to: u32) i64 {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret -1; }

    val fr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, from);
    if (sel fr.err) { ret -1; }
    val fty: ir_type.IrTypeId                 = fr.ok;
    val tr:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, to);
    if (sel tr.err) { ret -1; }
    val tty: ir_type.IrTypeId = tr.ok;

    val b0: ir_id.BlockId = t_block(?env);
    builder.set_block(?env.bld, b0);
    val src: value.Value = value.const_int(1, fty);

    var e: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].err{fail.message("unset")};
    if (k == ir_instruction.OP_SEXT) { e = builder.emit_sext(?env.bld, src, tty); }
    or (k == ir_instruction.OP_ZEXT) { e = builder.emit_zext(?env.bld, src, tty); }
    or                               { e = builder.emit_trunc(?env.bld, src, tty); }
    if (sel e.err)                   { ret -1; }
    val r_1795: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1795.err) { ret -1; }

    ret t_count(?env, false, false, VC_CONVERT_WIDTH);
}

# a lane-wise conversion judged per lane, with both sides vectors of one lane count
#[testing]
fun t_convert_vec(k: ir_instruction.InstrKind, from_bits: u32, from_lanes: u32, to_bits: u32, to_lanes: u32) i64 {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret -1; }

    val fe: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, from_bits);
    if (sel fe.err) { ret -1; }
    val te: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?env.m.types, to_bits);
    if (sel te.err) { ret -1; }
    var fty: ir_type.IrTypeId = fe.ok;
    if (from_lanes > 0) {
        val fv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, fe.ok, from_lanes);
        if (sel fv.err) { ret -1; }
        fty = fv.ok;
    }
    var tty: ir_type.IrTypeId = te.ok;
    if (to_lanes > 0) {
        val tv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?env.m.types, te.ok, to_lanes);
        if (sel tv.err) { ret -1; }
        tty = tv.ok;
    }

    val b0: ir_id.BlockId = t_block(?env);
    builder.set_block(?env.bld, b0);
    val slot: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, fty, t_ci(?env, 1));
    if (sel slot.err) { ret -1; }
    val src: res[value.Value, fail.Fail] = builder.emit_load(?env.bld, slot.ok, fty);
    if (sel src.err) { ret -1; }

    var e: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].err{fail.message("unset")};
    if (k == ir_instruction.OP_SEXT) { e = builder.emit_sext(?env.bld, src.ok, tty); }
    or                               { e = builder.emit_trunc(?env.bld, src.ok, tty); }
    if (sel e.err)                   { ret -1; }
    val r: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r.err) { ret -1; }

    ret t_count(?env, false, false, VC_CONVERT_WIDTH);
}

test check_convert_width__vector_conversions_are_judged_per_lane {
    if (t_convert_vec(ir_instruction.OP_SEXT, 8, 4, 32, 4) != 0)  { ret 1; }
    if (t_convert_vec(ir_instruction.OP_TRUNC, 64, 2, 8, 2) != 0) { ret 2; }
    if (t_convert_vec(ir_instruction.OP_SEXT, 32, 4, 8, 4) != 1)  { ret 3; }
    # the total width moves the right way, but the lane counts differ or one side is a scalar
    if (t_convert_vec(ir_instruction.OP_SEXT, 8, 4, 16, 8) != 1)  { ret 4; }
    if (t_convert_vec(ir_instruction.OP_TRUNC, 64, 0, 8, 4) != 1) { ret 5; }
    if (t_convert_vec(ir_instruction.OP_SEXT, 8, 2, 64, 0) != 1)  { ret 6; }
    ret 0;
}

