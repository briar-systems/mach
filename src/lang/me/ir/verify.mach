    env.m.functions[0].instrs[cid].operands[1].ty = env.i64ty;
    if (t_count(?env, false, false, VC_CALL_ARG_TYPE) < 1) { ret 1; }
    ret 0;
}

test describe_located__names_module_function_and_position {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    fin { me_ir.dnit(?env.m); }

    var itn: intern.Interner = intern.init(?env.alloc);
    fin { intern.dnit(?itn); }
    var smap: lang_source.SourceMap = lang_source.init(?env.alloc);
    fin { lang_source.dnit(?smap); }

    val res_fid: res[lang_source.FileId, fail.Fail] = lang_source.add(?smap, "./src/probe.mach", "ab\ncde\nf");
    if (sel res_fid.err) { ret 1; }
    val fid: lang_source.FileId = res_fid.ok;

    val res_mod: res[intern.StrId, A.Error] = intern.intern(?itn, "probe.mod");
    if (sel res_mod.err) { ret 1; }
    env.m.name = res_mod.ok;

    val res_fn: res[intern.StrId, A.Error] = intern.intern(?itn, "offender");
    if (sel res_fn.err) { ret 1; }
    env.m.functions[0].disp = res_fn.ok;

    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    builder.set_loc(?env.bld, lang_source.loc(fid, 4));
    val r_2143: err[fail.Fail] = builder.emit_store(?env.bld, t_ci(?env, 1), t_ci(?env, 0));
    if (sel r_2143.err) { ret 1; }
    val r_2144: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2144.err) { ret 1; }

    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, false, true));
    if (sel rr.err) { ret 1; }
    var rep: VerifyReport = rr.ok;
    fin { dnit_report(?rep); }
    if (rep.len == 0) { ret 1; }

    val described: res[str, fail.Fail] = describe_located(?env.m, ?rep.violations[0], ?itn, ?smap, ?env.alloc);
    if (sel described.err) { ret 2; }
    val msg: str = described.ok;
    fin { str_free(?env.alloc, msg); }

    var code: i32 = 0;
    if (!str_contains(msg, "type agreement"))     { code = 1; }
    if (!str_contains(msg, "probe.mod.offender")) { code = 1; }
    if (!str_contains(msg, "./src/probe.mach"))   { code = 1; }
    if (!str_contains(msg, "2:2"))                { code = 1; }
    if (str_contains(msg, "no source location"))  { code = 1; }

    if (code != 0) { ret code; }
    ret t_describe_refusals(?env.m, ?rep.violations[0], ?itn, ?smap, "probe.mod.offender");
}

test describe_located__spanless_says_so {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    fin { me_ir.dnit(?env.m); }

    var itn: intern.Interner = intern.init(?env.alloc);
    fin { intern.dnit(?itn); }
    var smap: lang_source.SourceMap = lang_source.init(?env.alloc);
    fin { lang_source.dnit(?smap); }

    val res_mod: res[intern.StrId, A.Error] = intern.intern(?itn, "probe.mod");
    if (sel res_mod.err) { ret 1; }
    env.m.name = res_mod.ok;

    val res_fn: res[intern.StrId, A.Error] = intern.intern(?itn, "offender");
    if (sel res_fn.err) { ret 1; }
    env.m.functions[0].disp = res_fn.ok;

    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }

    val rr: res[VerifyReport, fail.Fail] = verify_module_ext(?env.m, ?env.alloc, opts(?env.tgt, false, false));
    if (sel rr.err) { ret 1; }
    var rep: VerifyReport = rr.ok;
    fin { dnit_report(?rep); }
    if (rep.len == 0)                               { ret 1; }
    if (rep.violations[0].instr != ir_id.INSTR_NIL) { ret 1; }

    val described: res[str, fail.Fail] = describe_located(?env.m, ?rep.violations[0], ?itn, ?smap, ?env.alloc);
    if (sel described.err) { ret 2; }
    val msg: str = described.ok;
    fin { str_free(?env.alloc, msg); }

    var code: i32 = 0;
    if (!str_contains(msg, "terminator presence"))                         { code = 1; }
    if (!str_contains(msg, "probe.mod.offender"))                          { code = 1; }
    if (!str_contains(msg, "no source location available for this check")) { code = 1; }

    if (code != 0) { ret code; }
    ret t_describe_refusals(?env.m, ?rep.violations[0], ?itn, ?smap, "probe.mod.offender");
}

#[testing]
fun t_drop(env: *TEnv, b: ir_id.BlockId, iid: ir_id.InstructionId) bool {
    val fn: *me_ir.Function = ?env.m.functions[0];
    if (b::u32 >= fn.block_count) { ret false; }
    val blk: *me_ir.Block = ?fn.blocks[b::u32];
    var i:   u32          = 0;
    for (i < blk.instr_count) {
        if (blk.instructions[i] == iid) {
            var j: u32 = i;
            for (j + 1 < blk.instr_count) {
                blk.instructions[j] = blk.instructions[j + 1];
                j                   = j + 1;
            }
            blk.instr_count = blk.instr_count - 1;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

test check_operand_defs__dropped_def {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val dv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel dv.err) { ret 1; }
    val d:      value.Value                 = dv.ok;
    val r_2240: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, d, c);
    if (sel r_2240.err) { ret 1; }
    val r_2241: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2241.err) { ret 1; }

    if (t_total(?env, false, false) != 0) { ret 1; }

    if (!t_drop(?env, b0, d.data.instr))                       { ret 1; }
    if (t_count(?env, false, false, VC_DANGLING_OPERAND) != 1) { ret 1; }
    ret 0;
}

test check_operand_defs__dropped_phi_incoming {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }
    val b0: ir_id.BlockId = t_block(?env);
    val b1: ir_id.BlockId = t_block(?env);
    val b2: ir_id.BlockId = t_block(?env);
    val b3: ir_id.BlockId = t_block(?env);
    if (b3 != 3) { ret 1; }
    val c: value.Value = t_ci(?env, 0);

    builder.set_block(?env.bld, b0);
    val r_2262: err[fail.Fail] = builder.emit_cbr(?env.bld, t_ci(?env, 1), b1, b2);
    if (sel r_2262.err) { ret 1; }

    builder.set_block(?env.bld, b1);
    val lv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel lv.err) { ret 1; }
    val l:      value.Value    = lv.ok;
    val r_2268: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_2268.err) { ret 1; }

    builder.set_block(?env.bld, b2);
    val rv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c, c);
    if (sel rv.err) { ret 1; }
    val rt:     value.Value    = rv.ok;
    val r_2274: err[fail.Fail] = builder.emit_br(?env.bld, b3);
    if (sel r_2274.err) { ret 1; }

    builder.set_block(?env.bld, b3);
    val pv: res[value.Value, fail.Fail] = builder.emit_phi(?env.bld, env.i64ty);
    if (sel pv.err) { ret 1; }
    val p:      value.Value    = pv.ok;
    val r_2280: err[fail.Fail] = builder.phi_add_incoming(?env.bld, p, b1, l);
    if (sel r_2280.err) { ret 1; }
    val r_2281: err[fail.Fail] = builder.phi_add_incoming(?env.bld, p, b2, rt);
    if (sel r_2281.err) { ret 1; }
    val r_2282: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, p, c);
    if (sel r_2282.err) { ret 1; }
    val r_2283: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_2283.err) { ret 1; }

    if (t_total(?env, true, false) != 0) { ret 1; }

    if (!t_drop(?env, b2, rt.data.instr))                      { ret 1; }
    if (t_count(?env, false, false, VC_DANGLING_OPERAND) != 1) { ret 1; }
    ret 0;
}

