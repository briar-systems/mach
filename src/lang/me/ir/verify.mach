    val vecty: ir_type.IrTypeId                 = vr.ok;
    val pr:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?env.m.types);
    if (sel pr.err) { ret 1; }
    val ptrty: ir_type.IrTypeId = pr.ok;

    var pbuf: ir_type.IrTypeId                 = vecty;
    val sr:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?env.m.types, env.i64ty, ?pbuf, 1, false);
    if (sel sr.err) { ret 1; }
    val calleesig: ir_type.IrTypeId    = sr.ok;
    val cfr:       res[u32, fail.Fail] = me_ir.function_add(?env.m, intern.STR_NIL, calleesig, me_ir.FN_FLAG_EXTERN);
