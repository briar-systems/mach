test agg_value_is_address_producing__add_result {
    var env: TEnv;
    fin { lang_target.registry_dnit(?env.registry); }
    if (!t_env(?env)) { ret 1; }

    val sr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?env.m.types, ?env.i64ty, 1, 0, false);
    if (sel sr.err) { ret 1; }
    val stty: ir_type.IrTypeId = sr.ok;

    val b0: ir_id.BlockId = t_block(?env);
    if (b0 != 0) { ret 1; }
    builder.set_block(?env.bld, b0);

    val ar: res[value.Value, fail.Fail] = builder.emit_alloca(?env.bld, stty, t_ci(?env, 1));
    if (sel ar.err) { ret 1; }
    val aptr: value.Value = ar.ok;

    val c0:   value.Value                 = t_ci(?env, 0);
    val addv: res[value.Value, fail.Fail] = builder.emit_add(?env.bld, c0, c0);
    if (sel addv.err) { ret 1; }
    val add_val: value.Value = addv.ok;

    val struct_add: value.Value = value.retype(add_val, stty);

    val r_1847: err[fail.Fail] = builder.emit_store(?env.bld, struct_add, aptr);
    if (sel r_1847.err) { ret 1; }
    val r_1848: err[fail.Fail] = builder.emit_ret_void(?env.bld);
    if (sel r_1848.err) { ret 1; }

    if (t_count(?env, false, true, VC_AGG_ADDRESS) < 1)   { ret 1; }
    if (t_count(?env, false, false, VC_AGG_ADDRESS) != 0) { ret 1; }
    ret 0;
}

