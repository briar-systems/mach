val UNKNOWN_DESCRIPTOR: IrOpDescriptor = IrOpDescriptor{
    op: 0, name: "<?op>", class_name: "computation",
    effects: EFF_READS_MEMORY | EFF_WRITES_MEMORY | EFF_MAY_CALL | EFF_MAY_TRAP | EFF_ORDERED,
    arity_kind: ARITY_ANY, arity: 0, fixed_count: 0,
    roles: [OP_MAX_FIXED_OPERANDS]OperandRole{ ROLE_NONE, ROLE_NONE, ROLE_NONE },
    tail_role: ROLE_VALUE, tail_role_alt: ROLE_NONE,
    result: RESULT_NONE,
    vec_op: IVEC_NONE, vec_class: VCLASS_NONE,
    ct_class: CTC_NONE, lower_route: LOWER_GENERIC,
};

pub fun is_known(k: instruction.InstrKind) bool {
    ret k::usize < IR_OP_DESCRIPTOR_COUNT;
}

pub fun describe(k: instruction.InstrKind) R.Result[*IrOpDescriptor, str] {
    if (!is_known(k)) {
        ret R.err[*IrOpDescriptor, str]("ir: instruction opcode has no descriptor");
    }
    ret R.ok[*IrOpDescriptor, str](?IR_OP_DESCRIPTORS[k::usize]);
}

pub fun desc(k: instruction.InstrKind) *IrOpDescriptor {
    if (!is_known(k)) { ret ?UNKNOWN_DESCRIPTOR; }
    ret ?IR_OP_DESCRIPTORS[k::usize];
}

pub fun effects(k: instruction.InstrKind) IrEffects {
    ret desc(k).effects;
}

pub fun has(k: instruction.InstrKind, mask: IrEffects) bool {
    ret (desc(k).effects & mask) != 0;
}

pub fun name(k: instruction.InstrKind) str {
    ret desc(k).name;
}

pub fun class_name(k: instruction.InstrKind) str {
    ret desc(k).class_name;
}

pub fun vec_op(k: instruction.InstrKind) IrVecOp {
    ret desc(k).vec_op;
}

pub fun vec_class(k: instruction.InstrKind) VecClass {
    ret desc(k).vec_class;
}

pub fun ct_class(k: instruction.InstrKind) CtClass {
    ret desc(k).ct_class;
}

pub fun lower_route(k: instruction.InstrKind) LowerRoute {
    ret desc(k).lower_route;
}

pub fun result_typing(k: instruction.InstrKind) ResultTyping {
    ret desc(k).result;
}

pub fun operand_role(k: instruction.InstrKind, index: u32) OperandRole {
    val d: *IrOpDescriptor = desc(k);
    if (index < d.fixed_count) { ret d.roles[index::usize]; }
    if (d.tail_role == ROLE_NONE) { ret ROLE_NONE; }
    if (d.tail_role_alt == ROLE_NONE) { ret d.tail_role; }
    if (((index - d.fixed_count) % 2) == 0) { ret d.tail_role; }
    ret d.tail_role_alt;
}

pub fun is_terminator(k: instruction.InstrKind) bool {
    ret has(k, EFF_TERMINATOR);
}

pub fun may_trap(k: instruction.InstrKind) bool {
    ret has(k, EFF_MAY_TRAP);
}

pub fun transfers_secrecy(k: instruction.InstrKind) bool {
    ret has(k, EFF_SECRET_MOVE);
}

pub fun produces_value(k: instruction.InstrKind) bool {
    ret has(k, EFF_HAS_RESULT);
}

pub fun accepts_volatile(k: instruction.InstrKind) bool {
    ret has(k, EFF_VOLATILE_OK);
}

pub fun arity_ok(k: instruction.InstrKind, operand_count: u32) bool {
    val d: *IrOpDescriptor = desc(k);
    if (!is_known(k))                { ret false; }
    if (d.arity_kind == ARITY_EXACT) { ret operand_count == d.arity; }
    if (d.arity_kind == ARITY_AT_LEAST) { ret operand_count >= d.arity; }
    if (d.arity_kind == ARITY_AT_MOST)  { ret operand_count <= d.arity; }
    if (d.arity_kind == ARITY_PAIRS)    { ret (operand_count % 2) == 0; }
    ret true;
}

test "mach.lang.me.ir.opdesc:every_opcode_has_exactly_one_descriptor" {
    var i: usize = 0;
    for (i < IR_OP_DESCRIPTOR_COUNT) {
        if (IR_OP_DESCRIPTORS[i].op::usize != i) { ret 1; }
        var j: usize = i + 1;
        for (j < IR_OP_DESCRIPTOR_COUNT) {
            if (IR_OP_DESCRIPTORS[i].op == IR_OP_DESCRIPTORS[j].op) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    if (IR_OP_DESCRIPTOR_COUNT != instruction.OP_VEC_BUILD::usize + 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc.describe:an_unknown_opcode_is_a_typed_internal_error" {
    if (R.is_err[*IrOpDescriptor, str](describe(instruction.OP_ADD)))         { ret 1; }
    if (R.is_err[*IrOpDescriptor, str](describe(instruction.OP_VEC_BUILD)))   { ret 1; }
    if (R.is_ok[*IrOpDescriptor, str](describe(50::instruction.InstrKind)))   { ret 1; }
    if (R.is_ok[*IrOpDescriptor, str](describe(255::instruction.InstrKind)))  { ret 1; }
    if (is_known(255::instruction.InstrKind)) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc.desc:an_unknown_opcode_gets_the_conservative_descriptor" {
    val u: *IrOpDescriptor = desc(255::instruction.InstrKind);
    if ((u.effects & EFF_DISCARDABLE) != 0)  { ret 1; }
    if ((u.effects & EFF_SPECULATABLE) != 0) { ret 1; }
    if ((u.effects & EFF_MOVABLE) != 0)      { ret 1; }
    if ((u.effects & EFF_CSE_SAFE) != 0)     { ret 1; }
    if ((u.effects & EFF_MAY_TRAP) == 0)     { ret 1; }
    if ((u.effects & EFF_MAY_CALL) == 0)     { ret 1; }
    if ((u.effects & EFF_WRITES_MEMORY) == 0) { ret 1; }
    if (arity_ok(255::instruction.InstrKind, 0)) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc:effect_bits_are_internally_consistent" {
    var i: usize = 0;
    for (i < IR_OP_DESCRIPTOR_COUNT) {
        val d: *IrOpDescriptor = ?IR_OP_DESCRIPTORS[i];
        val e: IrEffects = d.effects;
        i = i + 1;

        if ((e & EFF_DISCARDABLE) != 0 && (e & EFF_WRITES_MEMORY) != 0) { ret 1; }
        if ((e & EFF_DISCARDABLE) != 0 && (e & EFF_READS_MEMORY) != 0)  { ret 1; }
        if ((e & EFF_DISCARDABLE) != 0 && (e & EFF_MAY_CALL) != 0)      { ret 1; }
        if ((e & EFF_DISCARDABLE) != 0 && (e & EFF_MAY_TRAP) != 0)      { ret 1; }
        if ((e & EFF_DISCARDABLE) != 0 && (e & EFF_TERMINATOR) != 0)    { ret 1; }

        if ((e & EFF_SPECULATABLE) != 0 && (e & EFF_DISCARDABLE) == 0)  { ret 1; }
        if ((e & EFF_MOVABLE) != 0 && (e & EFF_DISCARDABLE) == 0)       { ret 1; }
        if ((e & EFF_CSE_SAFE) != 0 && (e & EFF_DISCARDABLE) == 0)      { ret 1; }
        if ((e & EFF_CMP_UNSIGNED) != 0 && (e & EFF_COMPARE) == 0)      { ret 1; }
        if ((e & EFF_MAY_BE_ADDRESS) != 0 && (e & EFF_HAS_RESULT) == 0)  { ret 1; }
        if (d.result == RESULT_ADDRESS && (e & EFF_MAY_BE_ADDRESS) == 0) { ret 1; }
        if ((e & EFF_TERMINATOR) != 0 && (e & EFF_HAS_RESULT) != 0)     { ret 1; }
        if ((e & EFF_VOLATILE_OK) != 0
            && (e & EFF_READS_MEMORY) == 0 && (e & EFF_WRITES_MEMORY) == 0) { ret 1; }
        if ((e & EFF_MAY_CALL) != 0 && (e & EFF_ORDERED) == 0)          { ret 1; }
        if ((e & EFF_CMP_ORDERED) != 0 && (e & EFF_COMPARE) == 0)       { ret 1; }
        if ((e & EFF_REDUCE_INT) != 0 && (e & EFF_FOLD_INT) == 0)       { ret 1; }
        if ((e & EFF_REDUCE_FLOAT) != 0 && (e & EFF_FOLD_FLOAT) == 0)   { ret 1; }

        if (d.result == RESULT_NONE && (e & EFF_HAS_RESULT) != 0)       { ret 1; }
        if (d.result != RESULT_NONE && (e & EFF_HAS_RESULT) == 0)       { ret 1; }
        if (d.result == RESULT_MASK && (e & EFF_COMPARE) == 0)          { ret 1; }

        if (d.fixed_count::usize > OP_MAX_FIXED_OPERANDS)               { ret 1; }
        if (d.tail_role_alt != ROLE_NONE && d.tail_role == ROLE_NONE)   { ret 1; }
    }
    ret 0;
}

test "mach.lang.me.ir.opdesc.operand_role:names_every_slot_of_a_variadic_shape" {
    if (operand_role(instruction.OP_CALL, 0) != ROLE_CALLEE)   { ret 1; }
    if (operand_role(instruction.OP_CALL, 1) != ROLE_CALL_ARG) { ret 1; }
    if (operand_role(instruction.OP_CALL, 7) != ROLE_CALL_ARG) { ret 1; }

    if (operand_role(instruction.OP_PHI, 0) != ROLE_PHI_EDGE)  { ret 1; }
    if (operand_role(instruction.OP_PHI, 1) != ROLE_PHI_VALUE) { ret 1; }
    if (operand_role(instruction.OP_PHI, 2) != ROLE_PHI_EDGE)  { ret 1; }
    if (operand_role(instruction.OP_PHI, 3) != ROLE_PHI_VALUE) { ret 1; }

    if (operand_role(instruction.OP_GEP, 0) != ROLE_ADDRESS)   { ret 1; }
    if (operand_role(instruction.OP_GEP, 3) != ROLE_INDEX)     { ret 1; }

    if (operand_role(instruction.OP_STORE, 0) != ROLE_STORED)  { ret 1; }
    if (operand_role(instruction.OP_STORE, 1) != ROLE_ADDRESS) { ret 1; }

    if (operand_role(instruction.OP_CBR, 0) != ROLE_CONDITION) { ret 1; }
    if (operand_role(instruction.OP_CBR, 1) != ROLE_CFG_EDGE)  { ret 1; }
    if (operand_role(instruction.OP_CBR, 2) != ROLE_CFG_EDGE)  { ret 1; }

    if (operand_role(instruction.OP_ASM, 0) != ROLE_ASM_BIND)  { ret 1; }
    if (operand_role(instruction.OP_DBG_VALUE, 0) != ROLE_DEBUG) { ret 1; }
    if (operand_role(instruction.OP_VEC_BUILD, 2) != ROLE_LANE) { ret 1; }
    if (operand_role(instruction.OP_UNREACHABLE, 0) != ROLE_NONE) { ret 1; }
    if (operand_role(instruction.OP_ADD, 2) != ROLE_NONE)      { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc:is_terminator" {
    if (!is_terminator(instruction.OP_BR))          { ret 1; }
    if (!is_terminator(instruction.OP_CBR))         { ret 1; }
    if (!is_terminator(instruction.OP_RET))         { ret 1; }
    if (!is_terminator(instruction.OP_UNREACHABLE)) { ret 1; }

    if (is_terminator(instruction.OP_ADD))  { ret 1; }
    if (is_terminator(instruction.OP_CALL)) { ret 1; }
    if (is_terminator(instruction.OP_PHI))  { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc:discardable_excludes_memory_and_trapping_operations" {
    if (!has(instruction.OP_ADD, EFF_DISCARDABLE))     { ret 1; }
    if (!has(instruction.OP_CMP_EQ, EFF_DISCARDABLE))  { ret 1; }
    if (!has(instruction.OP_GEP, EFF_DISCARDABLE))     { ret 1; }
    if (!has(instruction.OP_EXTRACT, EFF_DISCARDABLE)) { ret 1; }
    if (!has(instruction.OP_BITCAST, EFF_DISCARDABLE)) { ret 1; }

    if (has(instruction.OP_STORE, EFF_DISCARDABLE))   { ret 1; }
    if (has(instruction.OP_LOAD, EFF_DISCARDABLE))    { ret 1; }
    if (has(instruction.OP_MEMZERO, EFF_DISCARDABLE)) { ret 1; }
    if (has(instruction.OP_CALL, EFF_DISCARDABLE))    { ret 1; }
    if (has(instruction.OP_ALLOCA, EFF_DISCARDABLE))  { ret 1; }
    if (has(instruction.OP_ASM, EFF_DISCARDABLE))     { ret 1; }
    if (has(instruction.OP_BR, EFF_DISCARDABLE))      { ret 1; }
    if (has(instruction.OP_DIV_S, EFF_DISCARDABLE))   { ret 1; }
    if (has(instruction.OP_DIV_U, EFF_DISCARDABLE))   { ret 1; }
    if (has(instruction.OP_REM_S, EFF_DISCARDABLE))   { ret 1; }
    if (has(instruction.OP_REM_U, EFF_DISCARDABLE))   { ret 1; }
    if (has(255::instruction.InstrKind, EFF_DISCARDABLE)) { ret 1; }

    if (!has(instruction.OP_PHI, EFF_DISCARDABLE))  { ret 1; }
    if (has(instruction.OP_PHI, EFF_CSE_SAFE))      { ret 1; }
    if (has(instruction.OP_PHI, EFF_MOVABLE))       { ret 1; }
    if (has(instruction.OP_PHI, EFF_SPECULATABLE))  { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc:asm_is_at_least_as_conservative_as_call" {
    if (has(instruction.OP_ASM, EFF_DISCARDABLE) != has(instruction.OP_CALL, EFF_DISCARDABLE)) { ret 1; }
    if (has(instruction.OP_ASM, EFF_DISCARDABLE))  { ret 1; }
    if (has(instruction.OP_ASM, EFF_CSE_SAFE))     { ret 1; }
    if (has(instruction.OP_ASM, EFF_MOVABLE))      { ret 1; }
    if (has(instruction.OP_ASM, EFF_SPECULATABLE)) { ret 1; }

    if (is_terminator(instruction.OP_ASM) != is_terminator(instruction.OP_CALL)) { ret 1; }
    if (transfers_secrecy(instruction.OP_ASM) != transfers_secrecy(instruction.OP_CALL)) { ret 1; }

    if (!has(instruction.OP_ASM, EFF_MAY_CALL))      { ret 1; }
    if (!has(instruction.OP_ASM, EFF_READS_MEMORY))  { ret 1; }
    if (!has(instruction.OP_ASM, EFF_WRITES_MEMORY)) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc:transfers_secrecy" {
    if (!transfers_secrecy(instruction.OP_LOAD))       { ret 1; }
    if (!transfers_secrecy(instruction.OP_STORE))      { ret 1; }
    if (!transfers_secrecy(instruction.OP_GEP))        { ret 1; }
    if (!transfers_secrecy(instruction.OP_EXTRACT))    { ret 1; }
    if (!transfers_secrecy(instruction.OP_INSERT))     { ret 1; }
    if (!transfers_secrecy(instruction.OP_PHI))        { ret 1; }
    if (!transfers_secrecy(instruction.OP_CALL))       { ret 1; }
    if (!transfers_secrecy(instruction.OP_RET))        { ret 1; }
    if (!transfers_secrecy(instruction.OP_MEMZERO))    { ret 1; }
    if (!transfers_secrecy(instruction.OP_DECLASSIFY)) { ret 1; }
    if (!transfers_secrecy(instruction.OP_TRUNC))      { ret 1; }
    if (!transfers_secrecy(instruction.OP_SEXT))       { ret 1; }
    if (!transfers_secrecy(instruction.OP_ZEXT))       { ret 1; }
    if (!transfers_secrecy(instruction.OP_BITCAST))    { ret 1; }

    if (transfers_secrecy(instruction.OP_ADD))      { ret 1; }
    if (transfers_secrecy(instruction.OP_SUB))      { ret 1; }
    if (transfers_secrecy(instruction.OP_MUL))      { ret 1; }
    if (transfers_secrecy(instruction.OP_AND))      { ret 1; }
    if (transfers_secrecy(instruction.OP_OR))       { ret 1; }
    if (transfers_secrecy(instruction.OP_XOR))      { ret 1; }
    if (transfers_secrecy(instruction.OP_NOT))      { ret 1; }
    if (transfers_secrecy(instruction.OP_NEG))      { ret 1; }
    if (transfers_secrecy(instruction.OP_SHL))      { ret 1; }
    if (transfers_secrecy(instruction.OP_SHR_U))    { ret 1; }
    if (transfers_secrecy(instruction.OP_CMP_EQ))   { ret 1; }
    if (transfers_secrecy(instruction.OP_CMP_LT_S)) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.opdesc.may_trap:classifies_traps_and_unknowns_conservatively" {
    if (may_trap(instruction.OP_ADD))    { ret 1; }
    if (!may_trap(instruction.OP_DIV_S)) { ret 1; }
    if (!may_trap(instruction.OP_DIV_U)) { ret 1; }
    if (!may_trap(instruction.OP_REM_S)) { ret 1; }
    if (!may_trap(instruction.OP_REM_U)) { ret 1; }
    if (!may_trap(255::instruction.InstrKind)) { ret 1; }
    ret 0;
}
