use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use mach.lang.me.ir;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.value;
use mach.lang.wide;

pub fun is_volatile(inst: *instruction.Instruction) bool {
    if (inst == nil) { ret false; }
    ret (inst.flags & instruction.INSTR_FLAG_VOLATILE) != 0;
}

pub fun discardable(inst: *instruction.Instruction) bool {
    if (inst == nil || is_volatile(inst))              { ret false; }
    if (opdesc.has(inst.kind, opdesc.EFF_DISCARDABLE)) { ret true; }
    ret division_cannot_trap(inst);
}

# a division or remainder is kept for its trap alone, so one whose divisor is
# a constant that is neither zero nor the overflowing minus one is as
# discardable as any other arithmetic
pub fun division_cannot_trap(inst: *instruction.Instruction) bool {
    val k: instruction.InstrKind = inst.kind;
    if (k != instruction.OP_DIV_S && k != instruction.OP_DIV_U && k != instruction.OP_REM_S && k != instruction.OP_REM_U) {
        ret false;
    }
    if (inst.operand_count != 2) { ret false; }
    val d: value.Value = inst.operands[1];
    if (d.kind != value.VAL_CONST_INT)  { ret false; }
    if (wide.is_zero(value.int_of(?d))) { ret false; }
    if (k == instruction.OP_DIV_S || k == instruction.OP_REM_S) {
        ret d.data.int_lit != 0xFFFFFFFFFFFFFFFF && d.data.int_lit != 0xFFFFFFFF && d.data.int_lit != 0xFFFF && d.data.int_lit != 0xFF;
    }
    ret true;
}

pub fun cse_safe(inst: *instruction.Instruction) bool {
    if (inst == nil || is_volatile(inst)) { ret false; }
    ret opdesc.has(inst.kind, opdesc.EFF_CSE_SAFE);
}

pub fun movable(inst: *instruction.Instruction) bool {
    if (inst == nil || is_volatile(inst)) { ret false; }
    ret opdesc.has(inst.kind, opdesc.EFF_MOVABLE);
}

pub fun speculatable(inst: *instruction.Instruction) bool {
    if (inst == nil || is_volatile(inst)) { ret false; }
    ret opdesc.has(inst.kind, opdesc.EFF_SPECULATABLE);
}

pub fun function_has_volatile(fn: *ir.Function) bool {
    if (fn == nil) { ret false; }
    var i: u32 = 0;
    for (i < fn.instr_len) {
        if (is_volatile(?fn.instrs[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

test discardable__requires_a_pure_nonvolatile_operation {
    var add: instruction.Instruction;
    add.kind  = instruction.OP_ADD;
    add.flags = 0;
    if (!discardable(?add) || !cse_safe(?add) || !movable(?add) || !speculatable(?add)) { ret 1; }

    add.flags = instruction.INSTR_FLAG_VOLATILE;
    if (discardable(?add) || cse_safe(?add) || movable(?add) || speculatable(?add)) { ret 1; }

    var div: instruction.Instruction;
    div.kind  = instruction.OP_DIV_U;
    div.flags = 0;
    if (discardable(?div) || cse_safe(?div) || movable(?div) || speculatable(?div)) { ret 1; }

    var unknown: instruction.Instruction;
    unknown.kind  = 255::instruction.InstrKind;
    unknown.flags = 0;
    if (discardable(?unknown) || cse_safe(?unknown) || movable(?unknown) || speculatable(?unknown)) { ret 1; }
    ret 0;
}

# a constant divisor is read in both limbs: zero in the low limb alone is not
# the zero divisor that traps (#3511)
test division_cannot_trap__divisor_is_read_in_both_limbs {
    var ops: [2]value.Value;
    ops[0] = value.param(0, 0);
    ops[1] = value.const_int_wide(wide.make(0, 1), 0);
    var div: instruction.Instruction;
    div.kind          = instruction.OP_DIV_U;
    div.flags         = 0;
    div.operands      = ?ops[0];
    div.operand_count = 2;
    if (!division_cannot_trap(?div)) { ret 1; }
    ops[1] = value.const_int(0, 0);
    if (division_cannot_trap(?div)) { ret 2; }
    ops[1] = value.const_int(3, 0);
    if (!division_cannot_trap(?div)) { ret 3; }
    ret 0;
}
