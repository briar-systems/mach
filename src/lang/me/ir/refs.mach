use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.value;

pub def RefRole: u8;

pub val REF_VALUE_USE:     RefRole = 0;
pub val REF_CFG_EDGE:      RefRole = 1;
pub val REF_PHI_EDGE:      RefRole = 2;
pub val REF_ASM_BIND:      RefRole = 3;
pub val REF_DEBUG_USE:     RefRole = 4;
pub val REF_INLINE_PARENT: RefRole = 5;
pub val REF_GLOBAL:        RefRole = 6;
pub val REF_FUNCTION:      RefRole = 7;
pub val REF_METADATA:      RefRole = 8;

pub def MetaKind: u8;

pub val META_NONE:            MetaKind = 0;
pub val META_ASM:             MetaKind = 1;
pub val META_DBG_VAR:         MetaKind = 2;
pub val META_ALLOCA_DBG_VAR:  MetaKind = 3;
pub val META_DBG_EXPR:        MetaKind = 4;
pub val META_INLINE_SITE:     MetaKind = 5;

pub val META_KIND_COUNT: u32 = 6;

pub val SLOT_NONE: u32 = 0xFFFFFFFF;

pub rec Ref {
    role:         RefRole;
    operand_role: opdesc.OperandRole;
    slot:         u32;
    value:        value.Value;
    block:        id.BlockId;
    instr:        id.InstructionId;
    name:         intern.StrId;
    meta:         MetaKind;
    site:         u32;
}

pub fun operand_is_block(k: instruction.InstrKind, o: u32) bool {
    val r: opdesc.OperandRole = opdesc.operand_role(k, o);
    ret r == opdesc.ROLE_CFG_EDGE || r == opdesc.ROLE_PHI_EDGE;
}

pub fun operand_is_value_use(k: instruction.InstrKind, o: u32) bool {
    val r: opdesc.OperandRole = opdesc.operand_role(k, o);
    if (r == opdesc.ROLE_CFG_EDGE || r == opdesc.ROLE_PHI_EDGE) { ret false; }
    if (r == opdesc.ROLE_DEBUG)                                 { ret false; }
    ret true;
}

fun ref_nil() Ref {
    var r: Ref;
    r.role         = REF_VALUE_USE;
    r.operand_role = opdesc.ROLE_NONE;
    r.slot         = SLOT_NONE;
    r.value        = value.const_null(0::u32);
    r.block        = id.BLOCK_NIL;
    r.instr        = id.INSTR_NIL;
    r.name         = intern.STR_NIL;
    r.meta         = META_NONE;
    r.site         = 0;
    ret r;
}

fun operand_ref(inst: *instruction.Instruction, o: u32) Ref {
    var r: Ref = ref_nil();
    val role: opdesc.OperandRole = opdesc.operand_role(inst.kind, o);
    val v: value.Value = inst.operands[o];
    r.operand_role = role;
    r.slot         = o;
    r.value        = v;

    if (role == opdesc.ROLE_CFG_EDGE) {
        r.role  = REF_CFG_EDGE;
        r.block = ir.block_target(v);
        ret r;
    }
    if (role == opdesc.ROLE_PHI_EDGE) {
        r.role  = REF_PHI_EDGE;
        r.block = ir.block_target(v);
        ret r;
    }
    if (role == opdesc.ROLE_DEBUG) {
        r.role = REF_DEBUG_USE;
        ret r;
    }
    if (v.kind == value.VAL_GLOBAL) {
        r.role = REF_GLOBAL;
        ret r;
    }
    if (v.kind == value.VAL_FN) {
        r.role = REF_FUNCTION;
        ret r;
    }
    r.role = REF_VALUE_USE;
    if (v.kind == value.VAL_INSTR) { r.instr = v.data.instr; }
    ret r;
}

fun meta_ref(kind: MetaKind, name: intern.StrId, site: u32) Ref {
    var r: Ref = ref_nil();
    r.role = REF_METADATA;
    r.meta = kind;
    r.name = name;
    r.site = site;
    ret r;
}

pub fun visit_operands[T](inst: *instruction.Instruction, ctx: *T, f: fun(*T, *Ref) bool) bool {
    if (inst == nil || f == nil) { ret true; }
    var o: u32 = 0;
    for (o < inst.operand_count) {
        var r: Ref = operand_ref(inst, o);
        if (!f(ctx, ?r)) { ret false; }
        o = o + 1;
    }
    ret true;
}

pub fun visit[T](fn: *ir.Function, iid: id.InstructionId, ctx: *T, f: fun(*T, *Ref) bool) bool {
    if (fn == nil || f == nil)  { ret true; }
    val gi: O.Option[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (O.is_none[*instruction.Instruction](gi)) { ret true; }
    val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](gi);

    if (!visit_operands[T](inst, ctx, f)) { ret false; }

    val oasm: O.Option[*ir.IrAsm] = ir.asm_get(fn, iid);
    if (O.is_some[*ir.IrAsm](oasm)) {
        var am: Ref = meta_ref(META_ASM, O.unwrap[*ir.IrAsm](oasm).body, 0);
        if (!f(ctx, ?am)) { ret false; }
        val asm: *ir.IrAsm = O.unwrap[*ir.IrAsm](oasm);
        var b: u32 = 0;
        for (b < asm.bind_count) {
            var br: Ref = ref_nil();
            br.role  = REF_ASM_BIND;
            br.instr = asm.binds[b].instr;
            br.name  = asm.binds[b].name;
            br.slot  = b;
            if (!f(ctx, ?br)) { ret false; }
            b = b + 1;
        }
    }

    val odv: O.Option[*ir.DbgVar] = ir.dbg_var_get(fn, iid);
    if (O.is_some[*ir.DbgVar](odv)) {
        var dm: Ref = meta_ref(META_DBG_VAR, O.unwrap[*ir.DbgVar](odv).name, 0);
        if (!f(ctx, ?dm)) { ret false; }
    }

    val oav: O.Option[*ir.DbgVar] = ir.alloca_dbg_var_get(fn, iid);
    if (O.is_some[*ir.DbgVar](oav)) {
        var av: Ref = meta_ref(META_ALLOCA_DBG_VAR, O.unwrap[*ir.DbgVar](oav).name, 0);
        if (!f(ctx, ?av)) { ret false; }
    }

    val eid: ir.DbgExprId = ir.dbg_expr_id(fn, iid);
    if (eid != ir.DBG_EXPR_IDENTITY) {
        var em: Ref = meta_ref(META_DBG_EXPR, intern.STR_NIL, eid::u32);
        if (!f(ctx, ?em)) { ret false; }
    }

    val site: u32 = ir.instr_inline_site_of(fn, iid);
    if (site != 0) {
        var im: Ref = ref_nil();
        im.role = REF_INLINE_PARENT;
        im.meta = META_INLINE_SITE;
        im.site = site;
        if (!f(ctx, ?im)) { ret false; }
    }
    ret true;
}

rec Tally {
    n_value:  u32;
    n_cfg:    u32;
    n_phi:    u32;
    n_debug:  u32;
    n_global: u32;
    n_fn:     u32;
    n_bind:   u32;
    n_meta:   u32;
    first_block: id.BlockId;
    last_block:  id.BlockId;
}

fun tally(c: *Tally, r: *Ref) bool {
    if (r.role == REF_VALUE_USE)     { c.n_value  = c.n_value + 1; }
    if (r.role == REF_CFG_EDGE)      { c.n_cfg    = c.n_cfg + 1; }
    if (r.role == REF_PHI_EDGE)      { c.n_phi    = c.n_phi + 1; }
    if (r.role == REF_DEBUG_USE)     { c.n_debug  = c.n_debug + 1; }
    if (r.role == REF_GLOBAL)        { c.n_global = c.n_global + 1; }
    if (r.role == REF_FUNCTION)      { c.n_fn     = c.n_fn + 1; }
    if (r.role == REF_ASM_BIND)      { c.n_bind   = c.n_bind + 1; }
    if (r.role == REF_METADATA)      { c.n_meta   = c.n_meta + 1; }
    if (r.block != id.BLOCK_NIL) {
        if (c.first_block == id.BLOCK_NIL) { c.first_block = r.block; }
        c.last_block = r.block;
    }
    ret true;
}

fun tally_of(inst: *instruction.Instruction) Tally {
    var t: Tally;
    t.n_value  = 0;
    t.n_cfg    = 0;
    t.n_phi    = 0;
    t.n_debug  = 0;
    t.n_global = 0;
    t.n_fn     = 0;
    t.n_bind   = 0;
    t.n_meta   = 0;
    t.first_block = id.BLOCK_NIL;
    t.last_block  = id.BLOCK_NIL;
    visit_operands[Tally](inst, ?t, tally);
    ret t;
}

fun t_instr(kind: instruction.InstrKind, ops: *value.Value, n: u32) instruction.Instruction {
    var i: instruction.Instruction;
    i.kind          = kind;
    i.ty            = 0::u32;
    i.operands      = ops;
    i.operand_count = n;
    i.operand_cap   = n;
    i.flags         = 0;
    i.secret        = false;
    ret i;
}

test "mach.lang.me.ir.refs.visit_operands:names_cfg_and_phi_edges_apart_from_value_uses" {
    var ops: [4]value.Value;

    ops[0] = value.const_int(3, 0::u32);
    var br: instruction.Instruction = t_instr(instruction.OP_BR, ?ops[0], 1);
    var tb: Tally = tally_of(?br);
    if (tb.n_cfg != 1 || tb.n_value != 0)  { ret 1; }
    if (tb.first_block != 3::id.BlockId)   { ret 1; }

    ops[0] = value.instr(9::id.InstructionId, 0::u32);
    ops[1] = value.const_int(5, 0::u32);
    ops[2] = value.const_int(6, 0::u32);
    var cbr: instruction.Instruction = t_instr(instruction.OP_CBR, ?ops[0], 3);
    var tc: Tally = tally_of(?cbr);
    if (tc.n_cfg != 2 || tc.n_value != 1)  { ret 1; }
    if (tc.first_block != 5::id.BlockId)   { ret 1; }
    if (tc.last_block != 6::id.BlockId)    { ret 1; }

    ops[0] = value.const_int(1, 0::u32);
    ops[1] = value.instr(4::id.InstructionId, 0::u32);
    ops[2] = value.const_int(2, 0::u32);
    ops[3] = value.instr(7::id.InstructionId, 0::u32);
    var phi: instruction.Instruction = t_instr(instruction.OP_PHI, ?ops[0], 4);
    var tp: Tally = tally_of(?phi);
    if (tp.n_phi != 2 || tp.n_value != 2)  { ret 1; }
    if (tp.first_block != 1::id.BlockId)   { ret 1; }
    if (tp.last_block != 2::id.BlockId)    { ret 1; }

    ops[0] = value.instr(2::id.InstructionId, 0::u32);
    var dbg: instruction.Instruction = t_instr(instruction.OP_DBG_VALUE, ?ops[0], 1);
    var td: Tally = tally_of(?dbg);
    if (td.n_debug != 1 || td.n_value != 0) { ret 1; }

    ops[0] = value.fn(0, 0::u32);
    ops[1] = value.global(1, 0::u32);
    var call: instruction.Instruction = t_instr(instruction.OP_CALL, ?ops[0], 2);
    var tf: Tally = tally_of(?call);
    if (tf.n_fn != 1 || tf.n_global != 1 || tf.n_value != 0) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.refs:role_queries_match_the_hand_written_switches_they_replace" {
    var k: u32 = 0;
    for (k < opdesc.IR_OP_DESCRIPTOR_COUNT::u32) {
        val op: instruction.InstrKind = k::instruction.InstrKind;
        k = k + 1;

        var o: u32 = 0;
        for (o < 8) {
            if (!arity_admits(op, o)) { o = o + 1; cnt; }

            var want_block: bool = false;
            if (op == instruction.OP_BR)  { want_block = o == 0; }
            if (op == instruction.OP_CBR) { want_block = o == 1 || o == 2; }
            if (op == instruction.OP_PHI) { want_block = (o % 2) == 0; }
            if (operand_is_block(op, o) != want_block) { ret 1; }

            var want_use: bool = true;
            if (op == instruction.OP_BR)        { want_use = false; }
            if (op == instruction.OP_CBR)       { want_use = o == 0; }
            if (op == instruction.OP_PHI)       { want_use = (o % 2) == 1; }
            if (op == instruction.OP_DBG_VALUE) { want_use = false; }
            if (operand_is_value_use(op, o) != want_use) { ret 1; }
            o = o + 1;
        }
    }

    if (operand_is_block(instruction.OP_BR, 4))         { ret 1; }
    if (!operand_is_value_use(instruction.OP_BR, 4))    { ret 1; }
    if (!operand_is_value_use(instruction.OP_ADD, 4))   { ret 1; }
    if (operand_is_block(255::instruction.InstrKind, 0)) { ret 1; }
    ret 0;
}

fun arity_admits(k: instruction.InstrKind, o: u32) bool {
    ret arity_ok_for_slot(k, o + 1);
}

fun arity_ok_for_slot(k: instruction.InstrKind, count: u32) bool {
    ret opdesc.arity_ok(k, count) || opdesc.arity_ok(k, count + 1);
}
