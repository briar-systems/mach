    val odv: opt[*ir.DbgVar] = ir.dbg_var_get(fn, iid);
    val oav: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(fn, iid);
    val odex: opt[*ir.DbgExpr] = ir.dbg_expr_get(fn, eid);
    val osite: opt[*ir.InlineSite] = ir.inline_site_get(fn, site_id);
    if (sel oa.none) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
