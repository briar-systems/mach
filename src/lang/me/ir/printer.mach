fun test_error_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    ret res[usize, writer.WriteError].err{writer.native_failure(0, io_error.make(io_error.IO, io_error.OP_WRITE))};
}

#[testing]
fun test_stall_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    ret res[usize, writer.WriteError].ok{0};
}

# the module both form tests render: a secret instruction over a secret
# operand, a pure one, an instruction with no position, one positioned in a
# second file, and vector and aggregate result types
#[testing]
rec FormFixture {
    alloc:   A.Allocator;
    itn:     intern.Interner;
    sources: source.SourceMap;
    m:       ir.Module;
    mul_ops: [2]value.Value;
    ret_ops: [1]value.Value;
    ok:      bool;
}

#[testing]
val FIXTURE_HOME_TEXT: str = "fun f(x: i64) i64 {\n    ret x * x;\n}\n";
#[testing]
val FIXTURE_OTHER_TEXT: str = "val k: i64 = 7;\n";

#[testing]
fun fixture_dnit(f: *FormFixture) {
    ir.dnit(?f.m);
    source.dnit(?f.sources);
    intern.dnit(?f.itn);
}

#[testing]
fun fixture_instr(k: instruction.InstrKind, ty: type.IrTypeId, loc: source.SrcLoc,
    secret: bool, ops: *value.Value, op_count: u32) instruction.Instruction {
    var ins: instruction.Instruction = test_instruction(k, ty);
    ins.loc           = loc;
    ins.secret        = secret;
    ins.operands      = ops;
    ins.operand_count = op_count;
    ret ins;
}

#[testing]
fun fixture_make(f: *FormFixture) {
    f.ok = false;
    page.make(?f.alloc);
    f.itn     = intern.init(?f.alloc);
    f.sources = source.init(?f.alloc);

    val rmod: res[intern.StrId, A.Error] = intern.intern(?f.itn, "demo.forms");
    val rfn:  res[intern.StrId, A.Error] = intern.intern(?f.itn, "demo.forms.f");
    if (sel rmod.err) { ret; }
    if (sel rfn.err)  { ret; }

    val rhome:  res[source.FileId, fail.Fail] = source.load(?f.sources, ?f.itn, "home.mach", FIXTURE_HOME_TEXT);
    val rother: res[source.FileId, fail.Fail] = source.load(?f.sources, ?f.itn, "other.mach", FIXTURE_OTHER_TEXT);
    if (sel rhome.err)  { ret; }
    if (sel rother.err) { ret; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?f.alloc, rmod.ok);
    if (sel rm.err) { ret; }
    f.m = rm.ok;

    val ri64: res[type.IrTypeId, fail.Fail] = type.intern_int(?f.m.types, 64);
    val ri32: res[type.IrTypeId, fail.Fail] = type.intern_int(?f.m.types, 32);
    val rf32: res[type.IrTypeId, fail.Fail] = type.intern_float(?f.m.types, 32);
    if (sel ri64.err) { ret; }
    if (sel ri32.err) { ret; }
    if (sel rf32.err) { ret; }
    val i64t: type.IrTypeId = ri64.ok;

    val rvec: res[type.IrTypeId, fail.Fail] = type.intern_vector(?f.m.types, ri32.ok, 4);
    if (sel rvec.err) { ret; }
    var fields: [2]type.IrTypeId;
    fields[0] = i64t;
    fields[1] = rf32.ok;
    val rrec: res[type.IrTypeId, fail.Fail] = type.intern_struct(?f.m.types, ?fields[0], 2, 8, false);
    if (sel rrec.err) { ret; }

    var params: [1]type.IrTypeId;
    params[0] = i64t;
    val rsig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?f.m.types, i64t, ?params[0], 1, false);
    if (sel rsig.err) { ret; }

    val rfun: res[u32, fail.Fail] = ir.function_add(?f.m, rfn.ok, rsig.ok, ir.FN_FLAG_PUB | ir.FN_FLAG_INLINE);
    if (sel rfun.err) { ret; }
    val fn: *ir.Function = ?f.m.functions[rfun.ok];

    val rblk: res[id.BlockId, fail.Fail] = ir.block_add(?f.m, fn);
    if (sel rblk.err) { ret; }
    val blk: *ir.Block = ?fn.blocks[rblk.ok::u32];

    var secret_param: value.Value = value.param(0, i64t);
    secret_param.secret = true;
    f.mul_ops[0]        = secret_param;
    f.mul_ops[1]        = value.param(0, i64t);

    # `ret x * x` on line 2, column 10 of home.mach
    val mul_ins: instruction.Instruction = fixture_instr(instruction.OP_MUL, i64t,
        source.loc(rhome.ok, 29), true, ?f.mul_ops[0], 2);
    val rmul: res[id.InstructionId, fail.Fail] = ir.instruction_add(?f.m, fn, mul_ins);
    if (sel rmul.err) { ret; }

    val vec_ins: instruction.Instruction = fixture_instr(instruction.OP_ADD, rvec.ok,
        source.loc_nil(), false, nil, 0);
    val rvec_i: res[id.InstructionId, fail.Fail] = ir.instruction_add(?f.m, fn, vec_ins);
    if (sel rvec_i.err) { ret; }

    # column 5 of other.mach, a file this function's body does not live in
    val rec_ins: instruction.Instruction = fixture_instr(instruction.OP_LOAD, rrec.ok,
        source.loc(rother.ok, 4), false, nil, 0);
    val rrec_i: res[id.InstructionId, fail.Fail] = ir.instruction_add(?f.m, fn, rec_ins);
    if (sel rrec_i.err) { ret; }

    f.ret_ops[0] = value.instr(rmul.ok, i64t);
    val ret_ins: instruction.Instruction = fixture_instr(instruction.OP_RET, type.IRT_NIL,
        source.loc(rhome.ok, 24), false, ?f.ret_ops[0], 1);
    val rret: res[id.InstructionId, fail.Fail] = ir.instruction_add(?f.m, fn, ret_ins);
    if (sel rret.err) { ret; }

    val ramul: err[fail.Fail] = ir.block_append_instr(?f.m, blk, rmul.ok);
    if (sel ramul.err) { ret; }
    val ravec: err[fail.Fail] = ir.block_append_instr(?f.m, blk, rvec_i.ok);
    if (sel ravec.err) { ret; }
    val rarec: err[fail.Fail] = ir.block_append_instr(?f.m, blk, rrec_i.ok);
    if (sel rarec.err) { ret; }
    blk.terminator = rret.ok;
    f.ok           = true;
}

#[testing]
fun fixture_render(f: *FormFixture, form: IrForm, dst: *u8) bool {
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;
    ret capture_form_into(?w, ?f.m, ?f.itn, ?f.sources,
        ir_context("post-codegen", "linux-x86_64", "x86_64", "linux", "sysv64", "elf"), form, dst);
}

# a byte-for-byte comparison of rendered text against a golden written one row
# per line; the result names the line that differs rather than the whole file
#[testing]
fun rendered_line_mismatch(text: str, lines: *str, n: usize) usize {
    var off: usize = 0;
    var i:   usize = 0;
    for (i < n) {
        val want: str   = lines[i];
        val len:  usize = str_len(want);
        var k:    usize = 0;
        for (k < len) {
            if (text[off + k] != want[k]) { ret i + 1; }
            k = k + 1;
        }
        if (text[off + len] != '\n') { ret i + 1; }
        off = off + len + 1;
        i   = i + 1;
    }
    if (str_len(text) != off) { ret n + 1; }
    ret 0;
}

#[testing]
val DEBUG_GOLDEN_N: usize = 19;

# captured from the ir-debug dump before `--emit-ir=<form>` existed. The dump is
# what the not_indistinguishable tests read, so the readable form may not move
# it by a byte
#[testing]
val DEBUG_GOLDEN: [DEBUG_GOLDEN_N]str = [DEBUG_GOLDEN_N]str{
    "ir-debug stage=\"post-codegen\" target=\"linux-x86_64\" isa=\"x86_64\" os=\"linux\" abi=\"sysv64\" of=\"elf\"",
    "module \"demo.forms\" {",
    "  state [init_fn=none vector_ops_scalarized=0]",
    "  types {",
    "    !0 = i64",
    "    !1 = i32",
    "    !2 = f32",
    "    !3 = !1x4",
    "    !4 = {!0, !2}[align=8 packed=false]",
    "    !5 = fn(!0) -> !0",
    "  }",
    "  fn @\"demo.forms.f\"(): !0 [pub inline flags=5 sig=!5 line=0 section=<name#4294967295> stage=0 wg=1x1x1 op=0:4294967295 disp=<name#4294967295> ret_sem=4294967295] {",
    "    block bb0 [preds=]:",
    "      %0 = mul.secret !0 ~%p0 {kind=1 ty=!0 secret=true}, %p0 {kind=1 ty=!0 secret=false} ; state{ty=!0, aux=!nil, kind=2, operands=2, flags=0, loc=1:29, secret=true, pure=true, may_trap=false, volatile=false, inline=0, dbg_expr=0}",
    "      %1 = add !3 ; state{ty=!3, aux=!nil, kind=0, operands=0, flags=0, loc=0:0, secret=false, pure=true, may_trap=false, volatile=false, inline=0, dbg_expr=0}",
    "      %2 = load !4 ; state{ty=!4, aux=!nil, kind=32, operands=0, flags=0, loc=2:4, secret=false, pure=false, may_trap=false, volatile=false, inline=0, dbg_expr=0}",
    "      ret %0 {kind=0 ty=!0 secret=false} ; state{ty=!nil, aux=!nil, kind=41, operands=1, flags=0, loc=1:24, secret=false, pure=false, may_trap=false, volatile=false, inline=0, dbg_expr=0}",
    "  }",
    "}",
};

#[testing]
val LISTING_GOLDEN_N: usize = 10;

#[testing]
val LISTING_GOLDEN: [LISTING_GOLDEN_N]str = [LISTING_GOLDEN_N]str{
    "ir-listing stage=\"post-codegen\" target=\"linux-x86_64\" isa=\"x86_64\" os=\"linux\" abi=\"sysv64\" of=\"elf\"",
    "module demo.forms {",
    "  fun @demo.forms.f() i64 [pub inline] {            ; home.mach",
    "    bb0:",
    "      %0 = mul.secret.pure i64 ~%p0, %p0            ; 2:10",
    "      %1 = add.pure i32x4",
    "      %2 = load rec{i64, f32}                       ; other.mach:1:5",
    "      ret %0                                        ; 2:5",
    "  }",
    "}",
};

test write_ir__debug_form_is_byte_for_byte_unchanged {
    var f: FormFixture;
    fixture_make(?f);
    if (!f.ok) {
        fixture_dnit(?f);
        ret 1;
    }
    var text:     [32768]u8;
    val rendered: bool = fixture_render(?f, IR_FORM_DEBUG, ?text[0]);
    fixture_dnit(?f);
    if (!rendered)                                                                      { ret 1; }
    if (rendered_line_mismatch((?text[0])::str, ?DEBUG_GOLDEN[0], DEBUG_GOLDEN_N) != 0) { ret 1; }
    ret 0;
}

# the listing prints the instruction and its position and nothing else: a
# secret operand keeps its `~`, a pure instruction says so, an instruction with
# no position carries no comment, one positioned in another file names it, and
# a vector or aggregate type is spelled the way the language spells it
test write_ir__listing_form_shape {
    var f: FormFixture;
    fixture_make(?f);
    if (!f.ok) {
        fixture_dnit(?f);
        ret 1;
    }
    var text:     [32768]u8;
    val rendered: bool = fixture_render(?f, IR_FORM_LISTING, ?text[0]);
    fixture_dnit(?f);
    if (!rendered)                                                                          { ret 1; }
    if (rendered_line_mismatch((?text[0])::str, ?LISTING_GOLDEN[0], LISTING_GOLDEN_N) != 0) { ret 1; }
    ret 0;
}

test ir_forms__rows_are_distinct_and_documented {
    var i: usize = 0;
    for (i < IR_FORM_N) {
        val spec: *IrFormSpec = ?IR_FORMS[i];
        if (str_empty(spec.name))                                       { ret 1; }
        if (str_empty(spec.doc))                                        { ret 1; }
        if (spec.fingerprint_tag == 0)                                  { ret 1; }
        if (!str_contains(IR_FORM_HELP, spec.name))                     { ret 1; }
        if (!str_contains(IR_FORM_ERROR, spec.name))                    { ret 1; }
        if (ir_form_fingerprint_tag(spec.form) != spec.fingerprint_tag) { ret 1; }
        if (!str_equals(ir_form_name(spec.form), spec.name))            { ret 1; }
        val parsed: opt[IrForm] = ir_form_from_name(spec.name);
        if (sel parsed.none)          { ret 1; }
        if (parsed.some != spec.form) { ret 1; }

        var j: usize = 0;
        for (j < i) {
            val prior: *IrFormSpec = ?IR_FORMS[j];
            if (prior.form == spec.form)                       { ret 1; }
            if (prior.fingerprint_tag == spec.fingerprint_tag) { ret 1; }
            if (str_equals(prior.name, spec.name))             { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    # exactly one form is the contract tooling reads, and it is the listing; a
    # third row has to say which side it is on
    var stable: usize = 0;
    i = 0;
    for (i < IR_FORM_N) {
        if (IR_FORMS[i].stable) {
            if (IR_FORMS[i].form != IR_FORM_LISTING) { ret 1; }
            stable = stable + 1;
        }
        i = i + 1;
    }
    if (stable != 1)                       { ret 1; }
    if (IR_FORM_DEBUG != IR_FORMS[0].form) { ret 1; }
    val unknown: opt[IrForm] = ir_form_from_name("nonesuch");
    if (sel unknown.some) { ret 1; }
    val empty: opt[IrForm] = ir_form_from_name("");
    if (sel empty.some)                            { ret 1; }
    if (ir_form_fingerprint_tag(200::IrForm) != 0) { ret 1; }
    ret 0;
}

test print_global__linkage_and_alignment_are_not_indistinguishable {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m:  ir.Module                     = res_m.ok;
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: type.IrTypeId = ri.ok;

    var itn: intern.Interner = intern.init(?alloc);

    var g: *ir.Global = ?m.globals[0];
    g.name        = intern.STR_NIL;
    g.ty          = i64t;
    g.init        = value.const_int(0, i64t);
    g.is_mut      = false;
    g.is_pub      = false;
    g.is_extern   = false;
    g.is_import   = false;
    g.is_local    = false;
    g.is_embed    = false;
    g.align       = 8;
    g.section     = intern.STR_NIL;
    g.iface       = ir.IFACE_NONE;
    g.iface_a     = 0;
    g.iface_b     = 0;
    g.iface_flags = 0;
    g.disp        = intern.STR_NIL;
    g.ty_sem      = semtype.TYPE_NIL;

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;

    capture_reset();
    val r_1633: err[fail.Fail] = print_global(?w, ?m, g, ?itn);
    if (sel r_1633.err) {
        ir.dnit(?m);
        ret 1;
    }
    capture_into(?buf_a[0]);

    g.is_pub    = true;
    g.is_extern = true;
    g.align     = 16;
    capture_reset();
    val r_1640: err[fail.Fail] = print_global(?w, ?m, g, ?itn);
    if (sel r_1640.err) {
        ir.dnit(?m);
        ret 1;
    }
    capture_into(?buf_b[0]);

    ir.dnit(?m);
    val a_text: str = (?buf_a[0])::str;
    val b_text: str = (?buf_b[0])::str;
    if (str_equals(a_text, b_text))                                                      { ret 1; }
    if (str_contains(a_text, "pub") || str_contains(a_text, "extern"))                   { ret 1; }
    if (str_contains(b_text, "pub") == false || str_contains(b_text, "extern") == false) { ret 1; }
    if (str_contains(a_text, "align=8") == false)                                        { ret 1; }
    if (str_contains(b_text, "align=16") == false)                                       { ret 1; }
    ret 0;
}

test print_function__flags_are_not_indistinguishable {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m:   ir.Module           = res_m.ok;
    val r_a: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_a.err) {
        ir.dnit(?m);
        ret 1;
    }
    val a_ix: u32                 = r_a.ok;
    var itn:  intern.Interner     = intern.init(?alloc);
    val r_b:  res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, ir.FN_FLAG_INLINE | ir.FN_FLAG_NOINLINE);
    if (sel r_b.err) {
        ir.dnit(?m);
        ret 1;
    }
    val b_ix: u32          = r_b.ok;
    val a_fn: *ir.Function = ?m.functions[a_ix];
    val b_fn: *ir.Function = ?m.functions[b_ix];
    a_fn.flags       = 0;
    a_fn.block_count = 0;
    b_fn.block_count = 0;

    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;
    var buf_c: [256]u8;

    capture_reset();
    val r_1682: err[fail.Fail] = print_function(?w, ?m, a_fn, ?itn);
    if (sel r_1682.err) {
        ir.dnit(?m);
        ret 1;
    }
    capture_into(?buf_a[0]);

    capture_reset();
    val r_1686: err[fail.Fail] = print_function(?w, ?m, b_fn, ?itn);
    if (sel r_1686.err) {
        ir.dnit(?m);
        ret 1;
    }
    capture_into(?buf_b[0]);

    a_fn.is_import = true;
    capture_reset();
    val r_1691: err[fail.Fail] = print_function(?w, ?m, a_fn, ?itn);
    if (sel r_1691.err) {
        ir.dnit(?m);
        ret 1;
    }
    capture_into(?buf_c[0]);

    ir.dnit(?m);
    val a_text: str = (?buf_a[0])::str;
    val b_text: str = (?buf_b[0])::str;
    val c_text: str = (?buf_c[0])::str;
    if (str_equals(a_text, b_text))                                                           { ret 1; }
    if (str_equals(a_text, c_text))                                                           { ret 1; }
    if (str_contains(a_text, "inline") || str_contains(a_text, "noinline"))                   { ret 1; }
    if (str_contains(b_text, "inline") == false || str_contains(b_text, "noinline") == false) { ret 1; }
    if (str_contains(a_text, "import"))                                                       { ret 1; }
    if (str_contains(c_text, "import") == false)                                              { ret 1; }
    ret 0;
}

test irwriter__names_and_context_strings_are_escaped {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner            = intern.init(?alloc);
    val rn:  res[intern.StrId, A.Error] = intern.intern(?itn, "a\"b\\c\nd\te");
    if (sel rn.err) {
        intern.dnit(?itn);
        ret 1;
    }
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, rn.ok);
    if (sel rm.err) {
        intern.dnit(?itn);
        ret 1;
    }
    var m:  ir.Module           = rm.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(?m, rn.ok, type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        intern.dnit(?itn);
        ret 1;
    }

    var control: [3]u8;
    control[0] = 'q';
    control[1] = 1;
    control[2] = 0;
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;
    val context:  IrContext = ir_context((?control[0])::str, "t", "i", "o", "a", "f");
    var text_buf: [32768]u8;
    if (!capture_debug_into(?w, ?m, ?itn, context, ?text_buf[0])) {
        ir.dnit(?m);
        intern.dnit(?itn);
        ret 1;
    }
    val rendered: str = (?text_buf[0])::str;
    var bad:      i32 = 0;
    if (!str_contains(rendered, "stage=\"q\\x01\""))        { bad = 1; }
    if (!str_contains(rendered, "\"a\\\"b\\\\c\\nd\\te\"")) { bad = 1; }
    ir.dnit(?m);
    intern.dnit(?itn);
    ret bad;
}

test irwriter__writer_errors_are_propagated {
    val context: IrContext = ir_context("s", "t", "i", "o", "a", "f");
    var failed:  writer.Writer;
    failed.ctx     = nil;
    failed.f_write = test_error_write;
    var d:  IrWriter       = ir_writer(?failed, nil, nil, nil, context, IR_FORM_DEBUG);
    val rf: err[fail.Fail] = write_debug(?d);
    if (!sel rf.err)                                                                                   { ret 1; }
    if (!str_equals(fail.describe(rf.err), os.message(io_error.make(io_error.IO, io_error.OP_WRITE)))) { ret 1; }

    var stalled: writer.Writer;
    stalled.ctx     = nil;
    stalled.f_write = test_stall_write;
    d               = ir_writer(?stalled, nil, nil, nil, context, IR_FORM_DEBUG);
    val stalled_r: err[fail.Fail] = write_debug(?d);
    if (!sel stalled_r.err)                                       { ret 1; }
    if (!str_equals(fail.describe(stalled_r.err), "short write")) { ret 1; }
    ret 0;
}

test print_type__tag {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    fin { ir.dnit(?m); }

    val ir_void: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    val ir_i64:  res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ir_void.err) { ret 2; }
    if (sel ir_i64.err)  { ret 2; }
    var cases: [2]type.IrTypeId;
    cases[0] = ir_void.ok;
    cases[1] = ir_i64.ok;

    val r_tag: res[type.IrTypeId, fail.Fail] = type.intern_tag(?m.types, ?cases[0], 2, 1, 8, false);
    if (sel r_tag.err) { ret 3; }
    val tagty: type.IrTypeId = r_tag.ok;

    test_sink_len = 0;
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;

    val r_2040: err[fail.Fail] = print_type(?w, ?m, tagty);
    if (sel r_2040.err) { ret 4; }
    test_sink_buf[test_sink_len] = 0;
    val printed: str = (?test_sink_buf[0])::str;
    if (!str_contains(printed, "tag{") || !str_contains(printed, "align=8") || !str_contains(printed, "packed=false")) { ret 5; }
    ret 0;
}
