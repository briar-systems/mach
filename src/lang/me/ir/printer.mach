use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.canonical.res;
use io_error: std.io.error;
use os: std.system.os;
use std.allocator.page;
use std.collections.map;
use std.format;
use std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.float;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;
use semtype: mach.lang.type;

pub rec IrDebugContext {
    stage:  str;
    target: str;
    isa:    str;
    os:     str;
    abi:    str;
    of:     str;
}

pub rec IrDebugWriter {
    out:      *writer.Writer;
    m:        *ir.Module;
    interner: *intern.Interner;
    context:  IrDebugContext;
}

pub fun debug_context(stage: str, target_name: str, isa_name: str, os_name: str,
                      abi_name: str, of_name: str) IrDebugContext {
    var c: IrDebugContext;
    c.stage  = stage;
    c.target = target_name;
    c.isa    = isa_name;
    c.os     = os_name;
    c.abi    = abi_name;
    c.of     = of_name;
    ret c;
}

pub fun debug_writer(out: *writer.Writer, m: *ir.Module, interner: *intern.Interner,
                     context: IrDebugContext) IrDebugWriter {
    var d: IrDebugWriter;
    d.out      = out;
    d.m        = m;
    d.interner = interner;
    d.context  = context;
    ret d;
}

pub fun write_debug(d: *IrDebugWriter) err[fail.Fail] {
    val out: *writer.Writer = d.out;
    val res_head: err[fail.Fail] = emit_str(out, "ir-debug stage=");
    if (sel res_head.err) { ret res_head; }
    val res_stage: err[fail.Fail] = emit_quoted(out, d.context.stage);
    if (sel res_stage.err) { ret res_stage; }
    val res_target: err[fail.Fail] = emit_str(out, " target=");
    if (sel res_target.err) { ret res_target; }
    val res_target_name: err[fail.Fail] = emit_quoted(out, d.context.target);
    if (sel res_target_name.err) { ret res_target_name; }
    val res_isa: err[fail.Fail] = emit_str(out, " isa=");
    if (sel res_isa.err) { ret res_isa; }
    val res_isa_name: err[fail.Fail] = emit_quoted(out, d.context.isa);
    if (sel res_isa_name.err) { ret res_isa_name; }
    val res_os: err[fail.Fail] = emit_str(out, " os=");
    if (sel res_os.err) { ret res_os; }
    val res_os_name: err[fail.Fail] = emit_quoted(out, d.context.os);
    if (sel res_os_name.err) { ret res_os_name; }
    val res_abi: err[fail.Fail] = emit_str(out, " abi=");
    if (sel res_abi.err) { ret res_abi; }
    val res_abi_name: err[fail.Fail] = emit_quoted(out, d.context.abi);
    if (sel res_abi_name.err) { ret res_abi_name; }
    val res_of: err[fail.Fail] = emit_str(out, " of=");
    if (sel res_of.err) { ret res_of; }
    val res_of_name: err[fail.Fail] = emit_quoted(out, d.context.of);
    if (sel res_of_name.err) { ret res_of_name; }
    val res_line: err[fail.Fail] = emit_str(out, "\n");
    if (sel res_line.err) { ret res_line; }
    ret write_module_body(out, d.m, d.interner);
}

fun write_module_body(out: *writer.Writer, m: *ir.Module, interner: *intern.Interner) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, "module ");
    if (sel res_open.err) { ret res_open; }
    val res_name: err[fail.Fail] = emit_name(out, interner, m.name);
    if (sel res_name.err) { ret res_name; }
    val res_brace: err[fail.Fail] = emit_str(out, " {\n");
    if (sel res_brace.err) { ret res_brace; }

    val res_state: err[fail.Fail] = print_module_state(out, m);
    if (sel res_state.err) { ret res_state; }
    val res_types: err[fail.Fail] = print_type_table(out, m);
    if (sel res_types.err) { ret res_types; }

    var i: u32 = 0;
    for (i < m.global_len) {
        val res_global: err[fail.Fail] = print_global(out, m, ?m.globals[i], interner);
        if (sel res_global.err) { ret res_global; }
        i = i + 1;
    }
    if (m.global_len > 0) {
        val res_gap: err[fail.Fail] = emit_str(out, "\n");
        if (sel res_gap.err) { ret res_gap; }
    }

    i = 0;
    for (i < m.function_len) {
        val res_fn: err[fail.Fail] = print_function(out, m, ?m.functions[i], interner);
        if (sel res_fn.err) { ret res_fn; }
        if (i + 1 < m.function_len) {
            val res_gap: err[fail.Fail] = emit_str(out, "\n");
            if (sel res_gap.err) { ret res_gap; }
        }
        i = i + 1;
    }

    ret emit_str(out, "}\n");
}

fun print_module_state(out: *writer.Writer, m: *ir.Module) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, "  state [init_fn=");
    if (sel res_open.err) { ret res_open; }
    if (sel m.init_fn.some) {
        val res_sigil: err[fail.Fail] = emit_str(out, "@");
        if (sel res_sigil.err) { ret res_sigil; }
        val res_init: err[fail.Fail] = emit_u64(out, m.init_fn.some::u64);
        if (sel res_init.err) { ret res_init; }
    }
    or {
        val res_none: err[fail.Fail] = emit_str(out, "none");
        if (sel res_none.err) { ret res_none; }
    }
    val res_vec: err[fail.Fail] = emit_str(out, " vector_ops_scalarized=");
    if (sel res_vec.err) { ret res_vec; }
    val res_count: err[fail.Fail] = emit_u64(out, m.vector_ops_scalarized::u64);
    if (sel res_count.err) { ret res_count; }
    ret emit_str(out, "]\n");
}

fun print_type_ref(out: *writer.Writer, tid: type.IrTypeId) err[fail.Fail] {
    if (tid == type.IRT_NIL) { ret emit_str(out, "!nil"); }
    val res_sigil: err[fail.Fail] = emit_str(out, "!");
    if (sel res_sigil.err) { ret res_sigil; }
    ret emit_u64(out, tid::u64);
}

fun print_type_table(out: *writer.Writer, m: *ir.Module) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, "  types {\n");
    if (sel res_open.err) { ret res_open; }
    var i: u32 = 0;
    for (i < m.types.len) {
        val res_indent: err[fail.Fail] = emit_str(out, "    !");
        if (sel res_indent.err) { ret res_indent; }
        val res_id: err[fail.Fail] = emit_u64(out, i::u64);
        if (sel res_id.err) { ret res_id; }
        val res_eq: err[fail.Fail] = emit_str(out, " = ");
        if (sel res_eq.err) { ret res_eq; }
        val res_ty: err[fail.Fail] = print_type(out, m, i::type.IrTypeId);
        if (sel res_ty.err) { ret res_ty; }
        val res_line: err[fail.Fail] = emit_str(out, "\n");
        if (sel res_line.err) { ret res_line; }
        i = i + 1;
    }
    ret emit_str(out, "  }\n");
}

pub fun print_global(out: *writer.Writer, m: *ir.Module, g: *ir.Global, interner: *intern.Interner) err[fail.Fail] {
    var head: str = "  val @";
    if (g.is_mut) { head = "  var @"; }
    val res_head: err[fail.Fail] = emit_str(out, head);
    if (sel res_head.err) { ret res_head; }
    val res_name: err[fail.Fail] = emit_name(out, interner, g.name);
    if (sel res_name.err) { ret res_name; }
    val res_colon: err[fail.Fail] = emit_str(out, ": ");
    if (sel res_colon.err) { ret res_colon; }
    val res_ty: err[fail.Fail] = print_type_ref(out, g.ty);
    if (sel res_ty.err) { ret res_ty; }
    val res_eq: err[fail.Fail] = emit_str(out, " = ");
    if (sel res_eq.err) { ret res_eq; }
    val res_val: err[fail.Fail] = print_operand(out, m, ?g.init, interner);
    if (sel res_val.err) { ret res_val; }
    val res_link: err[fail.Fail] = print_global_linkage(out, g, interner);
    if (sel res_link.err) { ret res_link; }
    ret emit_str(out, "\n");
}

fun print_global_linkage(out: *writer.Writer, g: *ir.Global, interner: *intern.Interner) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, " [");
    if (sel res_open.err) { ret res_open; }
    var first: bool = true;
    if (g.is_pub) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "pub");
        if (sel res_.err) { ret res_; }
    }
    if (g.is_extern) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "extern");
        if (sel res_.err) { ret res_; }
    }
    if (g.is_import) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "import");
        if (sel res_.err) { ret res_; }
    }
    if (g.is_local) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "local");
        if (sel res_.err) { ret res_; }
    }
    if (g.is_embed) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "embed");
        if (sel res_.err) { ret res_; }
    }
    val res_word: err[fail.Fail] = print_linkage_word(out, ?first, "align=");
    if (sel res_word.err) { ret res_word; }
    val res_align: err[fail.Fail] = emit_u64(out, g.align::u64);
    if (sel res_align.err) { ret res_align; }
    val res_section: err[fail.Fail] = emit_str(out, " section=");
    if (sel res_section.err) { ret res_section; }
    val res_section_name: err[fail.Fail] = emit_name(out, interner, g.section);
    if (sel res_section_name.err) { ret res_section_name; }
    val res_iface: err[fail.Fail] = emit_str(out, " iface=");
    if (sel res_iface.err) { ret res_iface; }
    val res_iface_value: err[fail.Fail] = emit_u64(out, g.iface::u64);
    if (sel res_iface_value.err) { ret res_iface_value; }
    val res_iface_a: err[fail.Fail] = emit_str(out, ":");
    if (sel res_iface_a.err) { ret res_iface_a; }
    val res_a: err[fail.Fail] = emit_u64(out, g.iface_a::u64);
    if (sel res_a.err) { ret res_a; }
    val res_iface_b: err[fail.Fail] = emit_str(out, ":");
    if (sel res_iface_b.err) { ret res_iface_b; }
    val res_b: err[fail.Fail] = emit_u64(out, g.iface_b::u64);
    if (sel res_b.err) { ret res_b; }
    val res_iface_flags: err[fail.Fail] = emit_str(out, ":");
    if (sel res_iface_flags.err) { ret res_iface_flags; }
    val res_iflags: err[fail.Fail] = emit_u64(out, g.iface_flags::u64);
    if (sel res_iflags.err) { ret res_iflags; }
    ret emit_str(out, "]");
}

fun print_linkage_word(out: *writer.Writer, first: *bool, word: str) err[fail.Fail] {
    if (!@first) {
        val res_sep: err[fail.Fail] = emit_str(out, " ");
        if (sel res_sep.err) { ret res_sep; }
    }
    @first = false;
    ret emit_str(out, word);
}

fun print_function_flags(out: *writer.Writer, fn: *ir.Function, interner: *intern.Interner) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, " [");
    if (sel res_open.err) { ret res_open; }
    var first: bool = true;
    if ((fn.flags & ir.FN_FLAG_PUB) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "pub");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "extern");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_INLINE) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "inline");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_NORETURN) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "noreturn");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_TEST) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "test");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_WEAK) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "weak");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_OBLIVIOUS) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "oblivious");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_SCALAR) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "scalar");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_NOINLINE) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "noinline");
        if (sel res_.err) { ret res_; }
    }
    if ((fn.flags & ir.FN_FLAG_NAKED) != 0) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "naked");
        if (sel res_.err) { ret res_; }
    }
    if (fn.is_import) {
        val res_: err[fail.Fail] = print_linkage_word(out, ?first, "import");
        if (sel res_.err) { ret res_; }
    }
    val res_raw: err[fail.Fail] = print_linkage_word(out, ?first, "flags=");
    if (sel res_raw.err) { ret res_raw; }
    val res_flags: err[fail.Fail] = emit_u64(out, fn.flags::u64);
    if (sel res_flags.err) { ret res_flags; }
    val res_sig: err[fail.Fail] = emit_str(out, " sig=");
    if (sel res_sig.err) { ret res_sig; }
    val res_sig_ty: err[fail.Fail] = print_type_ref(out, fn.sig);
    if (sel res_sig_ty.err) { ret res_sig_ty; }
    val res_label: err[fail.Fail] = emit_str(out, " label=");
    if (sel res_label.err) { ret res_label; }
    val res_label_name: err[fail.Fail] = emit_name(out, interner, fn.label);
    if (sel res_label_name.err) { ret res_label_name; }
    val res_line: err[fail.Fail] = emit_str(out, " line=");
    if (sel res_line.err) { ret res_line; }
    val res_line_value: err[fail.Fail] = emit_u64(out, fn.line::u64);
    if (sel res_line_value.err) { ret res_line_value; }
    val res_section: err[fail.Fail] = emit_str(out, " section=");
    if (sel res_section.err) { ret res_section; }
    val res_section_name: err[fail.Fail] = emit_name(out, interner, fn.section);
    if (sel res_section_name.err) { ret res_section_name; }
    val res_stage: err[fail.Fail] = emit_str(out, " stage=");
    if (sel res_stage.err) { ret res_stage; }
    val res_stage_value: err[fail.Fail] = emit_u64(out, fn.stage::u64);
    if (sel res_stage_value.err) { ret res_stage_value; }
    val res_wg: err[fail.Fail] = emit_str(out, " wg=");
    if (sel res_wg.err) { ret res_wg; }
    val res_wgx: err[fail.Fail] = emit_u64(out, fn.wg_x::u64);
    if (sel res_wgx.err) { ret res_wgx; }
    val res_wgx_sep: err[fail.Fail] = emit_str(out, "x");
    if (sel res_wgx_sep.err) { ret res_wgx_sep; }
    val res_wgy: err[fail.Fail] = emit_u64(out, fn.wg_y::u64);
    if (sel res_wgy.err) { ret res_wgy; }
    val res_wgy_sep: err[fail.Fail] = emit_str(out, "x");
    if (sel res_wgy_sep.err) { ret res_wgy_sep; }
    val res_wgz: err[fail.Fail] = emit_u64(out, fn.wg_z::u64);
    if (sel res_wgz.err) { ret res_wgz; }
    val res_op: err[fail.Fail] = emit_str(out, " op=");
    if (sel res_op.err) { ret res_op; }
    val res_op_set: err[fail.Fail] = emit_u64(out, fn.op_set::u64);
    if (sel res_op_set.err) { ret res_op_set; }
    val res_op_sep: err[fail.Fail] = emit_str(out, ":");
    if (sel res_op_sep.err) { ret res_op_sep; }
    val res_op_code: err[fail.Fail] = emit_u64(out, fn.op_code::u64);
    if (sel res_op_code.err) { ret res_op_code; }
    val res_disp: err[fail.Fail] = emit_str(out, " disp=");
    if (sel res_disp.err) { ret res_disp; }
    val res_disp_name: err[fail.Fail] = emit_name(out, interner, fn.disp);
    if (sel res_disp_name.err) { ret res_disp_name; }
    val res_ret_sem: err[fail.Fail] = emit_str(out, " ret_sem=");
    if (sel res_ret_sem.err) { ret res_ret_sem; }
    val res_ret_sem_value: err[fail.Fail] = emit_u64(out, fn.ret_sem::u64);
    if (sel res_ret_sem_value.err) { ret res_ret_sem_value; }
    ret emit_str(out, "]");
}

pub fun print_function(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, interner: *intern.Interner) err[fail.Fail] {
    val res_head: err[fail.Fail] = emit_str(out, "  fn @");
    if (sel res_head.err) { ret res_head; }
    val res_name: err[fail.Fail] = emit_name(out, interner, fn.name);
    if (sel res_name.err) { ret res_name; }
    val res_open: err[fail.Fail] = emit_str(out, "(");
    if (sel res_open.err) { ret res_open; }

    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0) {
        val res_sig: err[fail.Fail] = print_signature_params(out, m, fn.sig);
        if (sel res_sig.err) { ret res_sig; }
    }
    or {
        var i: u32 = 0;
        for (i < fn.param_count) {
            if (i > 0) {
                val res_sep: err[fail.Fail] = emit_str(out, ", ");
                if (sel res_sep.err) { ret res_sep; }
            }
            val res_param: err[fail.Fail] = print_operand(out, m, ?fn.params[i], interner);
            if (sel res_param.err) { ret res_param; }
            i = i + 1;
        }
    }

    val res_close: err[fail.Fail] = emit_str(out, "): ");
    if (sel res_close.err) { ret res_close; }
    val res_ret: err[fail.Fail] = print_signature_ret(out, m, fn.sig);
    if (sel res_ret.err) { ret res_ret; }
    val res_flags: err[fail.Fail] = print_function_flags(out, fn, interner);
    if (sel res_flags.err) { ret res_flags; }

    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0) {
        ret emit_str(out, "\n");
    }

    val res_brace: err[fail.Fail] = emit_str(out, " {\n");
    if (sel res_brace.err) { ret res_brace; }

    var i: u32 = 0;
    for (i < fn.block_count) {
        val res_block: err[fail.Fail] = print_block(out, m, fn, ?fn.blocks[i], interner);
        if (sel res_block.err) { ret res_block; }
        i = i + 1;
    }

    val res_unattached: err[fail.Fail] = print_unattached_instructions(out, m, fn, interner);
    if (sel res_unattached.err) { ret res_unattached; }
    val res_metadata: err[fail.Fail] = print_function_metadata(out, fn, interner);
    if (sel res_metadata.err) { ret res_metadata; }

    ret emit_str(out, "  }\n");
}

pub fun print_block(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, blk: *ir.Block, interner: *intern.Interner) err[fail.Fail] {
    val res_label: err[fail.Fail] = emit_str(out, "    block bb");
    if (sel res_label.err) { ret res_label; }
    val res_id: err[fail.Fail] = emit_u64(out, blk.id::u64);
    if (sel res_id.err) { ret res_id; }
    val res_preds: err[fail.Fail] = emit_str(out, " [preds=");
    if (sel res_preds.err) { ret res_preds; }
    var pi: u32 = 0;
    for (pi < blk.pred_count) {
        if (pi > 0) {
            val res_sep: err[fail.Fail] = emit_str(out, ",");
            if (sel res_sep.err) { ret res_sep; }
        }
        val res_bb: err[fail.Fail] = emit_str(out, "bb");
        if (sel res_bb.err) { ret res_bb; }
        val res_pred: err[fail.Fail] = emit_u64(out, blk.preds[pi]::u64);
        if (sel res_pred.err) { ret res_pred; }
        pi = pi + 1;
    }
    val res_colon: err[fail.Fail] = emit_str(out, "]:\n");
    if (sel res_colon.err) { ret res_colon; }

    var i: u32 = 0;
    for (i < blk.phi_count) {
        val res_phi: err[fail.Fail] = print_instruction_id(out, m, fn, blk.phis[i], interner);
        if (sel res_phi.err) { ret res_phi; }
        i = i + 1;
    }

    i = 0;
    for (i < blk.instr_count) {
        val res_instr: err[fail.Fail] = print_instruction_id(out, m, fn, blk.instructions[i], interner);
        if (sel res_instr.err) { ret res_instr; }
        i = i + 1;
    }

    if (blk.terminator != id.INSTR_NIL) {
        ret print_instruction_id(out, m, fn, blk.terminator, interner);
    }
    ret err[fail.Fail].ok{};
}

pub fun print_instruction(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, ins: *instruction.Instruction, iid: id.InstructionId, interner: *intern.Interner) err[fail.Fail] {
    val res_indent: err[fail.Fail] = emit_str(out, "      ");
    if (sel res_indent.err) { ret res_indent; }

    val has_result: bool = produces_value(ins.kind);
    if (has_result) {
        val res_marker: err[fail.Fail] = emit_str(out, "%");
        if (sel res_marker.err) { ret res_marker; }
        val res_id: err[fail.Fail] = emit_u64(out, iid::u64);
        if (sel res_id.err) { ret res_id; }
        val res_eq: err[fail.Fail] = emit_str(out, " = ");
        if (sel res_eq.err) { ret res_eq; }
    }

    val res_op: err[fail.Fail] = emit_str(out, opcode_name(ins.kind));
    if (sel res_op.err) { ret res_op; }
    val res_flags: err[fail.Fail] = print_flag_suffixes(out, ins.flags, ins.secret);
    if (sel res_flags.err) { ret res_flags; }

    if (has_result) {
        val res_space: err[fail.Fail] = emit_str(out, " ");
        if (sel res_space.err) { ret res_space; }
        var result_ty: type.IrTypeId = ins.ty;
        if (ins.kind == instruction.OP_ALLOCA) { result_ty = ins.aux_ty; }
        val res_ty: err[fail.Fail] = print_type_ref(out, result_ty);
        if (sel res_ty.err) { ret res_ty; }
    }

    if (ins.kind == instruction.OP_PHI) {
        val res_phi: err[fail.Fail] = print_phi_operands(out, m, fn, ins, interner);
        if (sel res_phi.err) { ret res_phi; }
    }
    or {
        val res_operands: err[fail.Fail] = print_operands(out, m, fn, ins, interner);
        if (sel res_operands.err) { ret res_operands; }
    }

    val res_state: err[fail.Fail] = emit_str(out, " ; state{ty=");
    if (sel res_state.err) { ret res_state; }
    val res_state_ty: err[fail.Fail] = print_type_ref(out, ins.ty);
    if (sel res_state_ty.err) { ret res_state_ty; }
    val res_aux: err[fail.Fail] = emit_str(out, ", aux=");
    if (sel res_aux.err) { ret res_aux; }
    val res_aux_ty: err[fail.Fail] = print_type_ref(out, ins.aux_ty);
    if (sel res_aux_ty.err) { ret res_aux_ty; }
    val res_kind: err[fail.Fail] = emit_str(out, ", kind=");
    if (sel res_kind.err) { ret res_kind; }
    val res_kind_value: err[fail.Fail] = emit_u64(out, ins.kind::u64);
    if (sel res_kind_value.err) { ret res_kind_value; }
    val res_operand_count: err[fail.Fail] = emit_str(out, ", operands=");
    if (sel res_operand_count.err) { ret res_operand_count; }
    val res_operand_count_value: err[fail.Fail] = emit_u64(out, ins.operand_count::u64);
    if (sel res_operand_count_value.err) { ret res_operand_count_value; }
    val res_raw_flags: err[fail.Fail] = emit_str(out, ", flags=");
    if (sel res_raw_flags.err) { ret res_raw_flags; }
    val res_flag_value: err[fail.Fail] = emit_u64(out, ins.flags::u64);
    if (sel res_flag_value.err) { ret res_flag_value; }
    val res_loc: err[fail.Fail] = emit_str(out, ", loc=");
    if (sel res_loc.err) { ret res_loc; }
    val res_file: err[fail.Fail] = emit_u64(out, ins.loc.file::u64);
    if (sel res_file.err) { ret res_file; }
    val res_loc_sep: err[fail.Fail] = emit_str(out, ":");
    if (sel res_loc_sep.err) { ret res_loc_sep; }
    val res_offset: err[fail.Fail] = emit_u64(out, ins.loc.offset::u64);
    if (sel res_offset.err) { ret res_offset; }
    val res_secret: err[fail.Fail] = emit_str(out, ", secret=");
    if (sel res_secret.err) { ret res_secret; }
    val res_secret_value: err[fail.Fail] = print_bool(out, ins.secret);
    if (sel res_secret_value.err) { ret res_secret_value; }
    val res_pure: err[fail.Fail] = emit_str(out, ", pure=");
    if (sel res_pure.err) { ret res_pure; }
    val res_pure_value: err[fail.Fail] = print_bool(out, opdesc.has(ins.kind, opdesc.EFF_DISCARDABLE));
    if (sel res_pure_value.err) { ret res_pure_value; }
    val res_trap: err[fail.Fail] = emit_str(out, ", may_trap=");
    if (sel res_trap.err) { ret res_trap; }
    val res_trap_value: err[fail.Fail] = print_bool(out, opdesc.may_trap(ins.kind));
    if (sel res_trap_value.err) { ret res_trap_value; }
    val res_volatile: err[fail.Fail] = emit_str(out, ", volatile=");
    if (sel res_volatile.err) { ret res_volatile; }
    val res_volatile_value: err[fail.Fail] = print_bool(out, effect.is_volatile(ins));
    if (sel res_volatile_value.err) { ret res_volatile_value; }
    val res_inline: err[fail.Fail] = emit_str(out, ", inline=");
    if (sel res_inline.err) { ret res_inline; }
    val res_inline_value: err[fail.Fail] = emit_u64(out, ir.instr_inline_site_of(fn, iid)::u64);
    if (sel res_inline_value.err) { ret res_inline_value; }
    val res_metadata: err[fail.Fail] = print_instruction_metadata(out, fn, iid, interner);
    if (sel res_metadata.err) { ret res_metadata; }
    val res_state_close: err[fail.Fail] = emit_str(out, "}");
    if (sel res_state_close.err) { ret res_state_close; }

    ret emit_str(out, "\n");
}

fun print_dbg_expr_payload(out: *writer.Writer, dex: *ir.DbgExpr) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, "[");
    if (sel res_open.err) { ret res_open; }
    var i: u32 = 0;
    for (i < dex.op_count) {
        if (i > 0) {
            val res_comma: err[fail.Fail] = emit_str(out, ", ");
            if (sel res_comma.err) { ret res_comma; }
        }
        val res_op: err[fail.Fail] = emit_str(out, "{op=");
        if (sel res_op.err) { ret res_op; }
        val res_op_value: err[fail.Fail] = emit_u64(out, dex.ops[i].op::u64);
        if (sel res_op_value.err) { ret res_op_value; }
        val res_arg: err[fail.Fail] = emit_str(out, " arg=");
        if (sel res_arg.err) { ret res_arg; }
        val res_arg_value: err[fail.Fail] = emit_u64(out, dex.ops[i].arg);
        if (sel res_arg_value.err) { ret res_arg_value; }
        val res_close: err[fail.Fail] = emit_str(out, "}");
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret emit_str(out, "]");
}

fun print_bool(out: *writer.Writer, v: bool) err[fail.Fail] {
    if (v) { ret emit_str(out, "true"); }
    ret emit_str(out, "false");
}

fun print_loc(out: *writer.Writer, loc: source.SrcLoc) err[fail.Fail] {
    val res_file: err[fail.Fail] = emit_u64(out, loc.file::u64);
    if (sel res_file.err) { ret res_file; }
    val res_sep: err[fail.Fail] = emit_str(out, ":");
    if (sel res_sep.err) { ret res_sep; }
    ret emit_u64(out, loc.offset::u64);
}

fun print_dbg_var(out: *writer.Writer, dv: *ir.DbgVar, interner: *intern.Interner) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, "{name=");
    if (sel res_open.err) { ret res_open; }
    val res_name: err[fail.Fail] = emit_name(out, interner, dv.name);
    if (sel res_name.err) { ret res_name; }
    val res_ty: err[fail.Fail] = emit_str(out, " ty=");
    if (sel res_ty.err) { ret res_ty; }
    val res_ty_value: err[fail.Fail] = print_type_ref(out, dv.ty);
    if (sel res_ty_value.err) { ret res_ty_value; }
    val res_sem: err[fail.Fail] = emit_str(out, " sem=");
    if (sel res_sem.err) { ret res_sem; }
    val res_sem_value: err[fail.Fail] = emit_u64(out, dv.ty_sem::u64);
    if (sel res_sem_value.err) { ret res_sem_value; }
    val res_param: err[fail.Fail] = emit_str(out, " param=");
    if (sel res_param.err) { ret res_param; }
    val res_param_value: err[fail.Fail] = print_bool(out, dv.is_param);
    if (sel res_param_value.err) { ret res_param_value; }
    val res_scope: err[fail.Fail] = emit_str(out, " scope=");
    if (sel res_scope.err) { ret res_scope; }
    val res_scope_value: err[fail.Fail] = emit_u64(out, dv.scope::u64);
    if (sel res_scope_value.err) { ret res_scope_value; }
    ret emit_str(out, "}");
}

fun asm_get(fn: *ir.Function, iid: id.InstructionId) opt[*ir.IrAsm] {
    var key: id.InstructionId = iid;
    val res_: opt[*ir.IrAsm] = map.get[id.InstructionId, ir.IrAsm](?fn.asm_blocks, ?key);
    if (sel res_.none) { ret opt[*ir.IrAsm].none{}; }
    ret opt[*ir.IrAsm].some{res_.some};
}

fun print_asm(out: *writer.Writer, a: *ir.IrAsm, interner: *intern.Interner) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, "{isa=");
    if (sel res_open.err) { ret res_open; }
    val res_isa: err[fail.Fail] = emit_name(out, interner, a.isa);
    if (sel res_isa.err) { ret res_isa; }
    val res_body: err[fail.Fail] = emit_str(out, " body=");
    if (sel res_body.err) { ret res_body; }
    val res_body_value: err[fail.Fail] = emit_name(out, interner, a.body);
    if (sel res_body_value.err) { ret res_body_value; }
    val res_binds: err[fail.Fail] = emit_str(out, " binds=[");
    if (sel res_binds.err) { ret res_binds; }
    var i: u32 = 0;
    for (i < a.bind_count) {
        if (i > 0) {
            val res_sep: err[fail.Fail] = emit_str(out, ", ");
            if (sel res_sep.err) { ret res_sep; }
        }
        val res_bind_open: err[fail.Fail] = emit_str(out, "{name=");
        if (sel res_bind_open.err) { ret res_bind_open; }
        val res_name: err[fail.Fail] = emit_name(out, interner, a.binds[i].name);
        if (sel res_name.err) { ret res_name; }
        val res_instr: err[fail.Fail] = emit_str(out, " instr=%");
        if (sel res_instr.err) { ret res_instr; }
        val res_instr_value: err[fail.Fail] = emit_u64(out, a.binds[i].instr::u64);
        if (sel res_instr_value.err) { ret res_instr_value; }
        val res_secret: err[fail.Fail] = emit_str(out, " secret=");
        if (sel res_secret.err) { ret res_secret; }
        val res_secret_value: err[fail.Fail] = print_bool(out, a.binds[i].secret);
        if (sel res_secret_value.err) { ret res_secret_value; }
        val res_bind_close: err[fail.Fail] = emit_str(out, "}");
        if (sel res_bind_close.err) { ret res_bind_close; }
        i = i + 1;
    }
    ret emit_str(out, "]}");
}

fun print_instruction_metadata(out: *writer.Writer, fn: *ir.Function,
                               iid: id.InstructionId, interner: *intern.Interner) err[fail.Fail] {
    val oa: opt[*ir.IrAsm] = asm_get(fn, iid);
    if (sel oa.some) {
        val res_tag: err[fail.Fail] = emit_str(out, ", asm=");
        if (sel res_tag.err) { ret res_tag; }
        val res_value: err[fail.Fail] = print_asm(out, oa.some, interner);
        if (sel res_value.err) { ret res_value; }
    }
    val odv: opt[*ir.DbgVar] = ir.dbg_var_get(fn, iid);
    if (sel odv.some) {
        val res_tag: err[fail.Fail] = emit_str(out, ", dbg_var=");
        if (sel res_tag.err) { ret res_tag; }
        val res_value: err[fail.Fail] = print_dbg_var(out, odv.some, interner);
        if (sel res_value.err) { ret res_value; }
    }
    val oav: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(fn, iid);
    if (sel oav.some) {
        val res_tag: err[fail.Fail] = emit_str(out, ", alloca_dbg_var=");
        if (sel res_tag.err) { ret res_tag; }
        val res_value: err[fail.Fail] = print_dbg_var(out, oav.some, interner);
        if (sel res_value.err) { ret res_value; }
    }
    val eid: ir.DbgExprId = ir.dbg_expr_id(fn, iid);
    val res_expr: err[fail.Fail] = emit_str(out, ", dbg_expr=");
    if (sel res_expr.err) { ret res_expr; }
    val res_expr_id: err[fail.Fail] = emit_u64(out, eid::u64);
    if (sel res_expr_id.err) { ret res_expr_id; }
    ret err[fail.Fail].ok{};
}

fun instruction_is_listed(fn: *ir.Function, iid: id.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var i: u32 = 0;
        for (i < blk.phi_count) {
            if (blk.phis[i] == iid) { ret true; }
            i = i + 1;
        }
        i = 0;
        for (i < blk.instr_count) {
            if (blk.instructions[i] == iid) { ret true; }
            i = i + 1;
        }
        if (blk.terminator == iid) { ret true; }
        bi = bi + 1;
    }
    ret false;
}

fun print_unattached_instructions(out: *writer.Writer, m: *ir.Module, fn: *ir.Function,
                                  interner: *intern.Interner) err[fail.Fail] {
    var opened: bool = false;
    var i: u32 = 0;
    for (i < fn.instr_len) {
        if (!instruction_is_listed(fn, i::id.InstructionId)) {
            if (!opened) {
                val res_open: err[fail.Fail] = emit_str(out, "    unattached {\n");
                if (sel res_open.err) { ret res_open; }
                opened = true;
            }
            val res_instr: err[fail.Fail] = print_instruction(out, m, fn, ?fn.instrs[i], i::id.InstructionId, interner);
            if (sel res_instr.err) { ret res_instr; }
        }
        i = i + 1;
    }
    if (opened) { ret emit_str(out, "    }\n"); }
    ret err[fail.Fail].ok{};
}

fun print_function_metadata(out: *writer.Writer, fn: *ir.Function,
                            interner: *intern.Interner) err[fail.Fail] {
    if (fn.dbg_expr_len > 0) {
        val res_open: err[fail.Fail] = emit_str(out, "    dbg_exprs {\n");
        if (sel res_open.err) { ret res_open; }
        var i: u32 = 0;
        for (i < fn.dbg_expr_len) {
            val res_indent: err[fail.Fail] = emit_str(out, "      #");
            if (sel res_indent.err) { ret res_indent; }
            val res_id: err[fail.Fail] = emit_u64(out, (i + 1)::u64);
            if (sel res_id.err) { ret res_id; }
            val res_eq: err[fail.Fail] = emit_str(out, " = ");
            if (sel res_eq.err) { ret res_eq; }
            val res_expr: err[fail.Fail] = print_dbg_expr_payload(out, ?fn.dbg_exprs[i]);
            if (sel res_expr.err) { ret res_expr; }
            val res_line: err[fail.Fail] = emit_str(out, "\n");
            if (sel res_line.err) { ret res_line; }
            i = i + 1;
        }
        val res_close: err[fail.Fail] = emit_str(out, "    }\n");
        if (sel res_close.err) { ret res_close; }
    }
    if (fn.inline_site_len > 0) {
        val res_open: err[fail.Fail] = emit_str(out, "    inline_sites {\n");
        if (sel res_open.err) { ret res_open; }
        var i: u32 = 0;
        for (i < fn.inline_site_len) {
            val site: *ir.InlineSite = ?fn.inline_sites[i];
            val res_indent: err[fail.Fail] = emit_str(out, "      #");
            if (sel res_indent.err) { ret res_indent; }
            val res_id: err[fail.Fail] = emit_u64(out, (i + 1)::u64);
            if (sel res_id.err) { ret res_id; }
            val res_callee: err[fail.Fail] = emit_str(out, " = {callee=");
            if (sel res_callee.err) { ret res_callee; }
            val res_callee_name: err[fail.Fail] = emit_name(out, interner, site.callee);
            if (sel res_callee_name.err) { ret res_callee_name; }
            val res_loc: err[fail.Fail] = emit_str(out, " loc=");
            if (sel res_loc.err) { ret res_loc; }
            val res_loc_value: err[fail.Fail] = print_loc(out, site.call_loc);
            if (sel res_loc_value.err) { ret res_loc_value; }
            val res_parent: err[fail.Fail] = emit_str(out, " parent=");
            if (sel res_parent.err) { ret res_parent; }
            val res_parent_value: err[fail.Fail] = emit_u64(out, site.parent::u64);
            if (sel res_parent_value.err) { ret res_parent_value; }
            val res_close: err[fail.Fail] = emit_str(out, "}\n");
            if (sel res_close.err) { ret res_close; }
            i = i + 1;
        }
        val res_close: err[fail.Fail] = emit_str(out, "    }\n");
        if (sel res_close.err) { ret res_close; }
    }
    ret err[fail.Fail].ok{};
}

pub fun print_value(out: *writer.Writer, m: *ir.Module, v: *value.Value, interner: *intern.Interner) err[fail.Fail] {
    if (v.secret) {
        val res_secret: err[fail.Fail] = emit_str(out, "~");
        if (sel res_secret.err) { ret res_secret; }
    }
    val res_payload: err[fail.Fail] = print_value_payload(out, m, v, interner);
    if (sel res_payload.err) { ret res_payload; }
    ret print_value_state(out, v);
}

fun print_value_state(out: *writer.Writer, v: *value.Value) err[fail.Fail] {
    val res_kind: err[fail.Fail] = emit_str(out, " {kind=");
    if (sel res_kind.err) { ret res_kind; }
    val res_kind_value: err[fail.Fail] = emit_u64(out, v.kind::u64);
    if (sel res_kind_value.err) { ret res_kind_value; }
    val res_ty: err[fail.Fail] = emit_str(out, " ty=");
    if (sel res_ty.err) { ret res_ty; }
    val res_ty_value: err[fail.Fail] = print_type_ref(out, v.ty);
    if (sel res_ty_value.err) { ret res_ty_value; }
    val res_secret: err[fail.Fail] = emit_str(out, " secret=");
    if (sel res_secret.err) { ret res_secret; }
    val res_secret_value: err[fail.Fail] = print_bool(out, v.secret);
    if (sel res_secret_value.err) { ret res_secret_value; }
    ret emit_str(out, "}");
}

fun print_value_payload(out: *writer.Writer, m: *ir.Module, v: *value.Value, interner: *intern.Interner) err[fail.Fail] {
    if (v.kind == value.VAL_INSTR) {
        val res_marker: err[fail.Fail] = emit_str(out, "%");
        if (sel res_marker.err) { ret res_marker; }
        ret emit_u64(out, v.data.instr::u64);
    }
    if (v.kind == value.VAL_PARAM) {
        val res_marker: err[fail.Fail] = emit_str(out, "%p");
        if (sel res_marker.err) { ret res_marker; }
        ret emit_u64(out, v.data.param_ix::u64);
    }
    if (v.kind == value.VAL_CONST_INT) {
        ret emit_u64(out, v.data.int_lit);
    }
    if (v.kind == value.VAL_CONST_FLOAT) {
        val res_tag: err[fail.Fail] = emit_str(out, "f");
        if (sel res_tag.err) { ret res_tag; }
        val res_float: err[fail.Fail] = emit_f64(out, v.data.float_lit);
        if (sel res_float.err) { ret res_float; }
        val res_bits: err[fail.Fail] = emit_str(out, ":0x");
        if (sel res_bits.err) { ret res_bits; }
        ret emit_hex_u64(out, float.f64_bits(v.data.float_lit));
    }
    if (v.kind == value.VAL_CONST_NULL) {
        ret emit_str(out, "null");
    }
    if (v.kind == value.VAL_CONST_BYTES) {
        val res_open: err[fail.Fail] = emit_str(out, "bytes[0x");
        if (sel res_open.err) { ret res_open; }
        val res_bytes: err[fail.Fail] = emit_bytes_hex(out, v.data.bytes.ptr, v.data.bytes.len);
        if (sel res_bytes.err) { ret res_bytes; }
        ret emit_str(out, "]");
    }
    if (v.kind == value.VAL_GLOBAL) {
        val res_sigil: err[fail.Fail] = emit_str(out, "@");
        if (sel res_sigil.err) { ret res_sigil; }
        if (v.data.global_ix < m.global_len) {
            val res_name: err[fail.Fail] = emit_name(out, interner, m.globals[v.data.global_ix].name);
            if (sel res_name.err) { ret res_name; }
        }
        or {
            val res_index: err[fail.Fail] = emit_u64(out, v.data.global_ix::u64);
            if (sel res_index.err) { ret res_index; }
        }
        val res_index_open: err[fail.Fail] = emit_str(out, "[global=");
        if (sel res_index_open.err) { ret res_index_open; }
        val res_index: err[fail.Fail] = emit_u64(out, v.data.global_ix::u64);
        if (sel res_index.err) { ret res_index; }
        ret emit_str(out, "]");
    }
    if (v.kind == value.VAL_FN) {
        val res_sigil: err[fail.Fail] = emit_str(out, "@");
        if (sel res_sigil.err) { ret res_sigil; }
        if (v.data.fn_ix < m.function_len) {
            val res_name: err[fail.Fail] = emit_name(out, interner, m.functions[v.data.fn_ix].name);
            if (sel res_name.err) { ret res_name; }
        }
        or {
            val res_index: err[fail.Fail] = emit_u64(out, v.data.fn_ix::u64);
            if (sel res_index.err) { ret res_index; }
        }
        val res_index_open: err[fail.Fail] = emit_str(out, "[fn=");
        if (sel res_index_open.err) { ret res_index_open; }
        val res_index: err[fail.Fail] = emit_u64(out, v.data.fn_ix::u64);
        if (sel res_index.err) { ret res_index; }
        ret emit_str(out, "]");
    }
    if (v.kind == value.VAL_CONST_AGG) {
        val res_open: err[fail.Fail] = emit_str(out, "agg{bytes=0x");
        if (sel res_open.err) { ret res_open; }
        val res_bytes: err[fail.Fail] = emit_bytes_hex(out, v.data.agg.bytes, v.data.agg.len);
        if (sel res_bytes.err) { ret res_bytes; }
        val res_relocs: err[fail.Fail] = emit_str(out, ", relocs=[");
        if (sel res_relocs.err) { ret res_relocs; }
        var i: u32 = 0;
        for (i < v.data.agg.reloc_count) {
            if (i > 0) {
                val res_sep: err[fail.Fail] = emit_str(out, ", ");
                if (sel res_sep.err) { ret res_sep; }
            }
            val reloc: *value.AggReloc = ?v.data.agg.relocs[i];
            val res_reloc_open: err[fail.Fail] = emit_str(out, "{offset=");
            if (sel res_reloc_open.err) { ret res_reloc_open; }
            val res_offset: err[fail.Fail] = emit_u64(out, reloc.offset::u64);
            if (sel res_offset.err) { ret res_offset; }
            val res_symbol: err[fail.Fail] = emit_str(out, ", symbol=");
            if (sel res_symbol.err) { ret res_symbol; }
            val res_name: err[fail.Fail] = emit_name(out, interner, reloc.symbol);
            if (sel res_name.err) { ret res_name; }
            val res_addend: err[fail.Fail] = emit_str(out, ", addend=");
            if (sel res_addend.err) { ret res_addend; }
            val res_addend_value: err[fail.Fail] = emit_i64(out, reloc.addend);
            if (sel res_addend_value.err) { ret res_addend_value; }
            var fn_text: str = "false";
            if (reloc.is_fn) { fn_text = "true"; }
            val res_fn: err[fail.Fail] = emit_str(out, ", fn=");
            if (sel res_fn.err) { ret res_fn; }
            val res_fn_value: err[fail.Fail] = emit_str(out, fn_text);
            if (sel res_fn_value.err) { ret res_fn_value; }
            val res_reloc_close: err[fail.Fail] = emit_str(out, "}");
            if (sel res_reloc_close.err) { ret res_reloc_close; }
            i = i + 1;
        }
        ret emit_str(out, "]}");
    }
    val res_open: err[fail.Fail] = emit_str(out, "<?value:");
    if (sel res_open.err) { ret res_open; }
    val res_kind: err[fail.Fail] = emit_u64(out, v.kind::u64);
    if (sel res_kind.err) { ret res_kind; }
    ret emit_str(out, ">");
}

pub fun print_type(out: *writer.Writer, m: *ir.Module, tid: type.IrTypeId) err[fail.Fail] {
    val opt_type: opt[*type.IrType] = type.get(?m.types, tid);
    if (sel opt_type.none) {
        val res_open: err[fail.Fail] = emit_str(out, "<?type:");
        if (sel res_open.err) { ret res_open; }
        val res_id: err[fail.Fail] = emit_u64(out, tid::u64);
        if (sel res_id.err) { ret res_id; }
        ret emit_str(out, ">");
    }
    val t: *type.IrType = opt_type.some;

    if (t.kind == type.IRT_VOID) { ret emit_str(out, "void"); }
    if (t.kind == type.IRT_INT) {
        val res_tag: err[fail.Fail] = emit_str(out, "i");
        if (sel res_tag.err) { ret res_tag; }
        ret emit_u64(out, t.data.bits::u64);
    }
    if (t.kind == type.IRT_FLOAT) {
        val res_tag: err[fail.Fail] = emit_str(out, "f");
        if (sel res_tag.err) { ret res_tag; }
        ret emit_u64(out, t.data.bits::u64);
    }
    if (t.kind == type.IRT_PTR) {
        val prefix: err[fail.Fail] = emit_str(out, "ptr");
        if (sel prefix.err) { ret prefix; }
        if (t.data.pointee == type.IRT_NIL) { ret prefix; }
        val space: err[fail.Fail] = emit_str(out, " ");
        if (sel space.err) { ret space; }
        ret print_type_ref(out, t.data.pointee);
    }
    if (t.kind == type.IRT_ARRAY) {
        val res_open: err[fail.Fail] = emit_str(out, "[");
        if (sel res_open.err) { ret res_open; }
        val res_len: err[fail.Fail] = emit_u64(out, type.array_count(?m.types, tid)::u64);
        if (sel res_len.err) { ret res_len; }
        val res_close: err[fail.Fail] = emit_str(out, "]");
        if (sel res_close.err) { ret res_close; }
        ret print_type_ref(out, t.data.array_.element);
    }
    if (t.kind == type.IRT_VECTOR) {
        val res_elem: err[fail.Fail] = print_type_ref(out, t.data.vector_.element);
        if (sel res_elem.err) { ret res_elem; }
        val res_x: err[fail.Fail] = emit_str(out, "x");
        if (sel res_x.err) { ret res_x; }
        ret emit_u64(out, t.data.vector_.lanes::u64);
    }
    if (t.kind == type.IRT_HANDLE) {
        val res_open: err[fail.Fail] = emit_str(out, "handle<");
        if (sel res_open.err) { ret res_open; }
        val res_ctor: err[fail.Fail] = emit_u64(out, t.data.handle_.ctor::u64);
        if (sel res_ctor.err) { ret res_ctor; }
        var wi: u32 = 0;
        for (wi < t.data.handle_.count) {
            val rs: err[fail.Fail] = emit_str(out, " ");
            if (sel rs.err) { ret rs; }
            val rw: err[fail.Fail] = print_type_ref(out, t.data.handle_.operands[wi]);
            if (sel rw.err) { ret rw; }
            wi = wi + 1;
        }
        ret emit_str(out, ">");
    }
    if (t.kind == type.IRT_STRUCT || t.kind == type.IRT_UNION) {
        var open: str = "{";
        if (t.kind == type.IRT_UNION) { open = "uni{"; }
        val res_open: err[fail.Fail] = emit_str(out, open);
        if (sel res_open.err) { ret res_open; }
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            if (i > 0) {
                val res_sep: err[fail.Fail] = emit_str(out, ", ");
                if (sel res_sep.err) { ret res_sep; }
            }
            val res_field: err[fail.Fail] = print_type_ref(out, t.data.struct_.fields[i]);
            if (sel res_field.err) { ret res_field; }
            i = i + 1;
        }
        val res_close: err[fail.Fail] = emit_str(out, "}[align=");
        if (sel res_close.err) { ret res_close; }
        val res_align: err[fail.Fail] = emit_u64(out, t.data.struct_.align::u64);
        if (sel res_align.err) { ret res_align; }
        var packed: str = "false";
        if (t.data.struct_.packed) { packed = "true"; }
        val res_packed: err[fail.Fail] = emit_str(out, " packed=");
        if (sel res_packed.err) { ret res_packed; }
        val res_packed_value: err[fail.Fail] = emit_str(out, packed);
        if (sel res_packed_value.err) { ret res_packed_value; }
        ret emit_str(out, "]");
    }
    if (t.kind == type.IRT_TAG) {
        val res_open: err[fail.Fail] = emit_str(out, "tag{");
        if (sel res_open.err) { ret res_open; }
        var i: u32 = 0;
        for (i < t.data.tag_.case_count) {
            if (i > 0) {
                val res_sep: err[fail.Fail] = emit_str(out, ", ");
                if (sel res_sep.err) { ret res_sep; }
            }
            val res_case: err[fail.Fail] = print_type_ref(out, t.data.tag_.cases[i]);
            if (sel res_case.err) { ret res_case; }
            i = i + 1;
        }
        val res_close: err[fail.Fail] = emit_str(out, "}[align=");
        if (sel res_close.err) { ret res_close; }
        val res_align: err[fail.Fail] = emit_u64(out, t.data.tag_.align::u64);
        if (sel res_align.err) { ret res_align; }
        var packed: str = "false";
        if (t.data.tag_.packed) { packed = "true"; }
        val res_packed: err[fail.Fail] = emit_str(out, " packed=");
        if (sel res_packed.err) { ret res_packed; }
        val res_packed_value: err[fail.Fail] = emit_str(out, packed);
        if (sel res_packed_value.err) { ret res_packed_value; }
        ret emit_str(out, "]");
    }
    if (t.kind == type.IRT_FN) {
        val res_open: err[fail.Fail] = emit_str(out, "fn(");
        if (sel res_open.err) { ret res_open; }
        var i: u32 = 0;
        for (i < t.data.fn.param_count) {
            if (i > 0) {
                val res_sep: err[fail.Fail] = emit_str(out, ", ");
                if (sel res_sep.err) { ret res_sep; }
            }
            val res_param: err[fail.Fail] = print_type_ref(out, t.data.fn.params[i]);
            if (sel res_param.err) { ret res_param; }
            i = i + 1;
        }
        if (t.data.fn.variadic) {
            if (t.data.fn.param_count > 0) {
                val res_sep: err[fail.Fail] = emit_str(out, ", ");
                if (sel res_sep.err) { ret res_sep; }
            }
            val res_variadic: err[fail.Fail] = emit_str(out, "...");
            if (sel res_variadic.err) { ret res_variadic; }
        }
        val res_arrow: err[fail.Fail] = emit_str(out, ") -> ");
        if (sel res_arrow.err) { ret res_arrow; }
        ret print_type_ref(out, t.data.fn.ret_type);
    }
    val res_unknown: err[fail.Fail] = emit_str(out, "<?type:kind=");
    if (sel res_unknown.err) { ret res_unknown; }
    val res_kind: err[fail.Fail] = emit_u64(out, t.kind::u64);
    if (sel res_kind.err) { ret res_kind; }
    ret emit_str(out, ">");
}

fun print_instruction_id(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, interner: *intern.Interner) err[fail.Fail] {
    val opt_ins: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_ins.some) {
        ret print_instruction(out, m, fn, opt_ins.some, iid, interner);
    }
    val res_open: err[fail.Fail] = emit_str(out, "      <dangling %");
    if (sel res_open.err) { ret res_open; }
    val res_id: err[fail.Fail] = emit_u64(out, iid::u64);
    if (sel res_id.err) { ret res_id; }
    ret emit_str(out, ">\n");
}

fun print_operands(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, ins: *instruction.Instruction, interner: *intern.Interner) err[fail.Fail] {
    if (ins.operand_count == 0) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < ins.operand_count) {
        if (i == 0) {
            val res_space: err[fail.Fail] = emit_str(out, " ");
            if (sel res_space.err) { ret res_space; }
        }
        or {
            val res_sep: err[fail.Fail] = emit_str(out, ", ");
            if (sel res_sep.err) { ret res_sep; }
        }
        val op: *value.Value = ?ins.operands[i];
        val is_target: bool = ins.kind == instruction.OP_BR || (ins.kind == instruction.OP_CBR && i >= 1);
        if (is_target && op.kind == value.VAL_CONST_INT) {
            val res_bb: err[fail.Fail] = emit_str(out, "bb");
            if (sel res_bb.err) { ret res_bb; }
            val res_id: err[fail.Fail] = emit_u64(out, op.data.int_lit);
            if (sel res_id.err) { ret res_id; }
            val res_state: err[fail.Fail] = print_value_state(out, op);
            if (sel res_state.err) { ret res_state; }
        }
        or {
            val res_op: err[fail.Fail] = print_operand(out, m, op, interner);
            if (sel res_op.err) { ret res_op; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun print_operand(out: *writer.Writer, m: *ir.Module, v: *value.Value, interner: *intern.Interner) err[fail.Fail] {
    ret print_value(out, m, v, interner);
}

fun print_phi_operands(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, ins: *instruction.Instruction, interner: *intern.Interner) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, " [");
    if (sel res_open.err) { ret res_open; }

    var i: u32 = 0;
    for (i + 1 < ins.operand_count) {
        if (i > 0) {
            val res_sep: err[fail.Fail] = emit_str(out, ", ");
            if (sel res_sep.err) { ret res_sep; }
        }
        val blk_op: *value.Value = ?ins.operands[i];
        val res_bb: err[fail.Fail] = emit_str(out, "bb");
        if (sel res_bb.err) { ret res_bb; }
        val res_id: err[fail.Fail] = emit_u64(out, blk_op.data.int_lit);
        if (sel res_id.err) { ret res_id; }
        val res_blk_state: err[fail.Fail] = print_value_state(out, blk_op);
        if (sel res_blk_state.err) { ret res_blk_state; }
        val res_space: err[fail.Fail] = emit_str(out, " ");
        if (sel res_space.err) { ret res_space; }
        val res_val: err[fail.Fail] = print_operand(out, m, ?ins.operands[i + 1], interner);
        if (sel res_val.err) { ret res_val; }
        i = i + 2;
    }
    ret emit_str(out, "]");
}

fun print_signature_params(out: *writer.Writer, m: *ir.Module, sig: type.IrTypeId) err[fail.Fail] {
    val opt_type: opt[*type.IrType] = type.get(?m.types, sig);
    if (sel opt_type.none) { ret err[fail.Fail].ok{}; }
    val t: *type.IrType = opt_type.some;
    if (t.kind != type.IRT_FN) { ret err[fail.Fail].ok{}; }

    var i: u32 = 0;
    for (i < t.data.fn.param_count) {
        if (i > 0) {
            val res_sep: err[fail.Fail] = emit_str(out, ", ");
            if (sel res_sep.err) { ret res_sep; }
        }
        val res_ty: err[fail.Fail] = print_type_ref(out, t.data.fn.params[i]);
        if (sel res_ty.err) { ret res_ty; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun print_signature_ret(out: *writer.Writer, m: *ir.Module, sig: type.IrTypeId) err[fail.Fail] {
    val opt_type: opt[*type.IrType] = type.get(?m.types, sig);
    if (sel opt_type.some) {
        val t: *type.IrType = opt_type.some;
        if (t.kind == type.IRT_FN) {
            ret print_type_ref(out, t.data.fn.ret_type);
        }
    }
    ret emit_str(out, "void");
}

fun print_flag_suffixes(out: *writer.Writer, flags: u16, secret: bool) err[fail.Fail] {
    if ((flags & instruction.INSTR_FLAG_NSW) != 0) {
        val res_: err[fail.Fail] = emit_str(out, ".nsw");
        if (sel res_.err) { ret res_; }
    }
    if ((flags & instruction.INSTR_FLAG_NUW) != 0) {
        val res_: err[fail.Fail] = emit_str(out, ".nuw");
        if (sel res_.err) { ret res_; }
    }
    if ((flags & instruction.INSTR_FLAG_EXACT) != 0) {
        val res_: err[fail.Fail] = emit_str(out, ".exact");
        if (sel res_.err) { ret res_; }
    }
    if ((flags & instruction.INSTR_FLAG_VOLATILE) != 0) {
        val res_: err[fail.Fail] = emit_str(out, ".volatile");
        if (sel res_.err) { ret res_; }
    }
    if (secret) {
        val res_: err[fail.Fail] = emit_str(out, ".secret");
        if (sel res_.err) { ret res_; }
    }
    ret err[fail.Fail].ok{};
}

fun produces_value(k: instruction.InstrKind) bool {
    ret opdesc.produces_value(k);
}

fun opcode_name(k: instruction.InstrKind) str {
    ret opdesc.name(k);
}


fun emit_str(out: *writer.Writer, s: str) err[fail.Fail] {
    val res_: res[usize, writer.WriteError] = format.write_str(out, s);
    if (sel res_.err) { ret err[fail.Fail].err{fail.write_refused(res_.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_u64(out: *writer.Writer, n: u64) err[fail.Fail] {
    val res_: res[usize, writer.WriteError] = format.write_u64(out, n);
    if (sel res_.err) { ret err[fail.Fail].err{fail.write_refused(res_.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_i64(out: *writer.Writer, n: i64) err[fail.Fail] {
    val res_: res[usize, writer.WriteError] = format.write_i64(out, n);
    if (sel res_.err) { ret err[fail.Fail].err{fail.write_refused(res_.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_hex_u64(out: *writer.Writer, n: u64) err[fail.Fail] {
    val res_: res[usize, writer.WriteError] = format.write_hex_u64(out, n, false);
    if (sel res_.err) { ret err[fail.Fail].err{fail.write_refused(res_.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_bytes_hex(out: *writer.Writer, bytes: *u8, len: u32) err[fail.Fail] {
    if (bytes == nil && len > 0) { ret emit_str(out, "<nil>"); }
    val digits: str = "0123456789abcdef";
    var pair: [3]u8;
    pair[2] = 0;
    var i: u32 = 0;
    for (i < len) {
        pair[0] = digits[(bytes[i] >> 4)::usize];
        pair[1] = digits[(bytes[i] & 0x0F)::usize];
        val res_: err[fail.Fail] = emit_str(out, (?pair[0])::str);
        if (sel res_.err) { ret res_; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_f64(out: *writer.Writer, f: f64) err[fail.Fail] {
    val bits: u64 = float.f64_bits(f);
    if (((bits >> 52) & 0x7FF) == 0x7FF && (bits & 0xFFFFFFFFFFFFF) != 0) {
        ret emit_str(out, "nan");
    }
    val res_: res[usize, writer.WriteError] = format.write_f64(out, f);
    if (sel res_.err) { ret err[fail.Fail].err{fail.write_refused(res_.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_escaped(out: *writer.Writer, s: str) err[fail.Fail] {
    val digits: str = "0123456789abcdef";
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val b: u8 = s[i];
        var fixed: str = nil;
        if (b == '"')      { fixed = "\\\""; }
        or (b == '\\')    { fixed = "\\\\"; }
        or (b == '\n')    { fixed = "\\n"; }
        or (b == '\r')    { fixed = "\\r"; }
        or (b == '\t')    { fixed = "\\t"; }
        if (fixed != nil) {
            val res_fixed: err[fail.Fail] = emit_str(out, fixed);
            if (sel res_fixed.err) { ret res_fixed; }
        }
        or (b >= 0x20 && b <= 0x7E) {
            var one: [2]u8;
            one[0] = b;
            one[1] = 0;
            val res_one: err[fail.Fail] = emit_str(out, (?one[0])::str);
            if (sel res_one.err) { ret res_one; }
        }
        or {
            var hex: [5]u8;
            hex[0] = '\\';
            hex[1] = 'x';
            hex[2] = digits[(b >> 4)::usize];
            hex[3] = digits[(b & 0x0F)::usize];
            hex[4] = 0;
            val res_hex: err[fail.Fail] = emit_str(out, (?hex[0])::str);
            if (sel res_hex.err) { ret res_hex; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun emit_quoted(out: *writer.Writer, s: str) err[fail.Fail] {
    val res_open: err[fail.Fail] = emit_str(out, "\"");
    if (sel res_open.err) { ret res_open; }
    val res_value: err[fail.Fail] = emit_escaped(out, s);
    if (sel res_value.err) { ret res_value; }
    ret emit_str(out, "\"");
}

fun emit_name(out: *writer.Writer, interner: *intern.Interner, name_id: intern.StrId) err[fail.Fail] {
    val opt_name: O.Option[str] = intern.lookup(interner, name_id);
    if (O.is_some[str](opt_name)) {
        ret emit_quoted(out, O.unwrap[str](opt_name));
    }
    val res_open: err[fail.Fail] = emit_str(out, "<name#");
    if (sel res_open.err) { ret res_open; }
    val res_id: err[fail.Fail] = emit_u64(out, name_id::u64);
    if (sel res_id.err) { ret res_id; }
    ret emit_str(out, ">");
}

var test_sink_buf: [32768]u8;
var test_sink_len: usize = 0;

fun test_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    var i: usize = 0;
    for (i < len) {
        if (test_sink_len < 32767) {
            test_sink_buf[test_sink_len] = buf[i];
            test_sink_len = test_sink_len + 1;
        }
        i = i + 1;
    }
    ret res[usize, writer.WriteError].ok{len};
}

fun float_renders_as(m: *ir.Module, f: f64, ty: type.IrTypeId, want: str) i32 {
    test_sink_len = 0;
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;
    var v: value.Value = value.const_float(f, ty);
    val r_1337: err[fail.Fail] = print_value(?w, m, ?v, nil);
    if (sel r_1337.err) { ret 1; }
    test_sink_buf[test_sink_len] = 0;
    if (!str_equals((?test_sink_buf[0])::str, want)) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_value:float_rendering" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: ir.Module = res_module.ok;
    val res_ty: res[type.IrTypeId, fail.Fail] = type.intern_float(?m.types, 64);
    if (sel res_ty.err) { ret 1; }
    val ty: type.IrTypeId = res_ty.ok;

    val pos_inf: f64 = float.bits_f64(0x7FF0000000000000);
    val neg_inf: f64 = float.f64_neg(pos_inf);
    val two_63:  f64 = float.bits_f64(0x43E0000000000000);
    val denorm:  f64 = float.bits_f64(1);
    val qnan:    f64 = float.bits_f64(0x7FF8000000000000);
    val pnan:    f64 = float.bits_f64(0x7FF8000000000001);

    var bad: i32 = 0;
    bad = bad | float_renders_as(?m, -0.0, ty, "f-0:0x8000000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 0.0, ty, "f0:0x0 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 1.5, ty, "f1.5:0x3ff8000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 1.75, ty, "f1.75:0x3ffc000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, -1.5, ty, "f-1.5:0xbff8000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 2.5, ty, "f2.5:0x4004000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, pos_inf, ty, "finf:0x7ff0000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, neg_inf, ty, "f-inf:0xfff0000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, two_63, ty, "f9.223372036854776e18:0x43e0000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, denorm, ty, "f5e-324:0x1 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, qnan, ty, "fnan:0x7ff8000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, pnan, ty, "fnan:0x7ff8000000000001 {kind=3 ty=!0 secret=false}");
    ret bad;
}

fun capture_reset() {
    test_sink_len = 0;
}

fun capture_into(dst: *u8) {
    var i: usize = 0;
    for (i < test_sink_len) { dst[i] = test_sink_buf[i]; i = i + 1; }
    dst[test_sink_len] = 0;
}

fun capture_value_into(w: *writer.Writer, m: *ir.Module, v: *value.Value,
                       itn: *intern.Interner, dst: *u8) bool {
    capture_reset();
    val r_1389: err[fail.Fail] = print_value(w, m, v, itn);
    if (sel r_1389.err) { ret false; }
    capture_into(dst);
    ret true;
}

fun capture_debug_into(w: *writer.Writer, m: *ir.Module, itn: *intern.Interner,
                       context: IrDebugContext, dst: *u8) bool {
    capture_reset();
    var d: IrDebugWriter = debug_writer(w, m, itn, context);
    val r_1398: err[fail.Fail] = write_debug(?d);
    if (sel r_1398.err) { ret false; }
    capture_into(dst);
    ret true;
}

fun debug_differs(w: *writer.Writer, m: *ir.Module, itn: *intern.Interner,
                  context: IrDebugContext, baseline: str) bool {
    var candidate: [32768]u8;
    if (!capture_debug_into(w, m, itn, context, ?candidate[0])) { ret false; }
    ret !str_equals(baseline, (?candidate[0])::str);
}

fun test_instruction(k: instruction.InstrKind, ty: type.IrTypeId) instruction.Instruction {
    var ins: instruction.Instruction;
    ins.kind = k;
    ins.ty = ty;
    ins.operands = nil;
    ins.operand_count = 0;
    ins.operand_cap = 0;
    ins.flags = 0;
    ins.aux_ty = type.IRT_NIL;
    ins.loc = source.loc_nil();
    ins.secret = false;
    ret ins;
}

fun test_error_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    ret res[usize, writer.WriteError].err{writer.native_failure(0, io_error.from_code(os.EIO, io_error.OP_WRITE))};
}

fun test_stall_write(ctx: ptr, buf: *u8, len: usize) res[usize, writer.WriteError] {
    ret res[usize, writer.WriteError].ok{0};
}

test "mach.lang.me.ir.printer.print_value:constant_payload_fields_are_independently_distinct" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    var itn: intern.Interner = intern.init(?alloc);
    val rsa: R.Result[intern.StrId, str] = intern.intern(?itn, "symbol_a");
    val rsb: R.Result[intern.StrId, str] = intern.intern(?itn, "symbol_b");
    if (R.is_err[intern.StrId, str](rsa)) { intern.dnit(?itn); ir.dnit(?m); ret 1; }
    if (R.is_err[intern.StrId, str](rsb)) { intern.dnit(?itn); ir.dnit(?m); ret 1; }

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;
    var bytes_a: [2]u8;
    bytes_a[0] = 0x12; bytes_a[1] = 0x34;
    var bytes_b: [2]u8 = bytes_a;
    bytes_b[1] = 0x35;
    var base_reloc: value.AggReloc;
    base_reloc.offset = 4;
    base_reloc.symbol = R.unwrap_ok[intern.StrId, str](rsa);
    base_reloc.addend = -2;
    base_reloc.is_fn = false;

    var base: value.Value = value.const_agg(?bytes_a[0], 2, ?base_reloc, 1, 1, i64t);
    var changed_bytes: value.Value = value.const_agg(?bytes_b[0], 2, ?base_reloc, 1, 1, i64t);
    var changed_reloc: value.AggReloc = base_reloc;
    var candidate: value.Value;
    var base_text: [256]u8;
    var candidate_text: [256]u8;
    if (!capture_value_into(?w, ?m, ?base, ?itn, ?base_text[0])) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    if (!capture_value_into(?w, ?m, ?changed_bytes, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }

    changed_reloc.offset = 5;
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    changed_reloc = base_reloc;
    changed_reloc.symbol = R.unwrap_ok[intern.StrId, str](rsb);
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    changed_reloc = base_reloc;
    changed_reloc.addend = -3;
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    changed_reloc = base_reloc;
    changed_reloc.is_fn = true;
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }

    intern.dnit(?itn);
    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.printer.print_value:secret_operand_is_not_indistinguishable_from_a_plain_one" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;

    var plain: value.Value = value.const_int(9, i64t);
    var secret: value.Value = value.const_int(9, i64t);
    secret.secret = true;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;

    capture_reset();
    val r_1529: err[fail.Fail] = print_value(?w, ?m, ?plain, nil);
    if (sel r_1529.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    capture_reset();
    val r_1533: err[fail.Fail] = print_value(?w, ?m, ?secret, nil);
    if (sel r_1533.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    ir.dnit(?m);
    val plain_text:  str = (?buf_a[0])::str;
    val secret_text: str = (?buf_b[0])::str;
    if (str_equals(plain_text, secret_text)) { ret 1; }
    if (str_contains(plain_text, "~")) { ret 1; }
    if (str_contains(secret_text, "~") == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_instruction:secret_result_is_not_indistinguishable_from_a_plain_one" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;
    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var plain: instruction.Instruction;
    plain.kind          = instruction.OP_NEG;
    plain.ty             = i64t;
    plain.operands       = nil;
    plain.operand_count = 0;
    plain.operand_cap   = 0;
    plain.flags          = 0;
    plain.aux_ty         = type.IRT_NIL;
    plain.loc            = source.loc_nil();
    plain.secret         = false;

    var secret: instruction.Instruction = plain;
    secret.secret = true;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;

    capture_reset();
    val r_1580: err[fail.Fail] = print_instruction(?w, ?m, fn, ?plain, 0::id.InstructionId, nil);
    if (sel r_1580.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    capture_reset();
    val r_1584: err[fail.Fail] = print_instruction(?w, ?m, fn, ?secret, 0::id.InstructionId, nil);
    if (sel r_1584.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    ir.dnit(?m);
    val plain_text:  str = (?buf_a[0])::str;
    val secret_text: str = (?buf_b[0])::str;
    if (str_equals(plain_text, secret_text)) { ret 1; }
    if (str_contains(secret_text, ".secret") == false) { ret 1; }
    if (str_contains(plain_text, ".secret")) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_global:linkage_and_alignment_are_not_indistinguishable" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    val ri: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = ri.ok;

    var itn: intern.Interner = intern.init(?alloc);

    var g: *ir.Global = ?m.globals[0];
    g.name      = intern.STR_NIL;
    g.ty        = i64t;
    g.init      = value.const_int(0, i64t);
    g.is_mut    = false;
    g.is_pub    = false;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = false;
    g.is_embed  = false;
    g.align     = 8;
    g.section   = intern.STR_NIL;
    g.iface     = ir.IFACE_NONE;
    g.iface_a   = 0;
    g.iface_b   = 0;
    g.iface_flags = 0;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;

    capture_reset();
    val r_1633: err[fail.Fail] = print_global(?w, ?m, g, ?itn);
    if (sel r_1633.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    g.is_pub = true;
    g.is_extern = true;
    g.align = 16;
    capture_reset();
    val r_1640: err[fail.Fail] = print_global(?w, ?m, g, ?itn);
    if (sel r_1640.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    ir.dnit(?m);
    val a_text: str = (?buf_a[0])::str;
    val b_text: str = (?buf_b[0])::str;
    if (str_equals(a_text, b_text)) { ret 1; }
    if (str_contains(a_text, "pub") || str_contains(a_text, "extern")) { ret 1; }
    if (str_contains(b_text, "pub") == false || str_contains(b_text, "extern") == false) { ret 1; }
    if (str_contains(a_text, "align=8") == false) { ret 1; }
    if (str_contains(b_text, "align=16") == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_function:flags_are_not_indistinguishable" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    val r_a: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel r_a.err) { ir.dnit(?m); ret 1; }
    val a_ix: u32 = r_a.ok;
    var itn: intern.Interner = intern.init(?alloc);
    val r_b: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, ir.FN_FLAG_INLINE | ir.FN_FLAG_NOINLINE);
    if (sel r_b.err) { ir.dnit(?m); ret 1; }
    val b_ix: u32 = r_b.ok;
    val a_fn: *ir.Function = ?m.functions[a_ix];
    val b_fn: *ir.Function = ?m.functions[b_ix];
    a_fn.flags = 0;
    a_fn.block_count = 0;
    b_fn.block_count = 0;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;
    var buf_c: [256]u8;

    capture_reset();
    val r_1682: err[fail.Fail] = print_function(?w, ?m, a_fn, ?itn);
    if (sel r_1682.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    capture_reset();
    val r_1686: err[fail.Fail] = print_function(?w, ?m, b_fn, ?itn);
    if (sel r_1686.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    a_fn.is_import = true;
    capture_reset();
    val r_1691: err[fail.Fail] = print_function(?w, ?m, a_fn, ?itn);
    if (sel r_1691.err) { ir.dnit(?m); ret 1; }
    capture_into(?buf_c[0]);

    ir.dnit(?m);
    val a_text: str = (?buf_a[0])::str;
    val b_text: str = (?buf_b[0])::str;
    val c_text: str = (?buf_c[0])::str;
    if (str_equals(a_text, b_text)) { ret 1; }
    if (str_equals(a_text, c_text)) { ret 1; }
    if (str_contains(a_text, "inline") || str_contains(a_text, "noinline")) { ret 1; }
    if (str_contains(b_text, "inline") == false || str_contains(b_text, "noinline") == false) { ret 1; }
    if (str_contains(a_text, "import")) { ret 1; }
    if (str_contains(c_text, "import") == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.IrDebugWriter:context_state_and_output_are_deterministic" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    val rn: R.Result[intern.StrId, str] = intern.intern(?itn, "pkg.module");
    if (R.is_err[intern.StrId, str](rn)) { intern.dnit(?itn); ret 1; }
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, R.unwrap_ok[intern.StrId, str](rn));
    if (sel rm.err) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = rm.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(?m, R.unwrap_ok[intern.StrId, str](rn), type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;
    val context: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                 "linux", "sysv64", "elf");
    var first: [32768]u8;
    var second: [32768]u8;
    if (!capture_debug_into(?w, ?m, ?itn, context, ?first[0])
        || !capture_debug_into(?w, ?m, ?itn, context, ?second[0])) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val baseline: str = (?first[0])::str;
    if (!str_equals(baseline, (?second[0])::str)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (!str_contains(baseline, "ir-debug stage=\"post-codegen\" target=\"native\" isa=\"x86_64\" os=\"linux\" abi=\"sysv64\" of=\"elf\"")) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val stage_changed: IrDebugContext = debug_context("post-lower", "native", "x86_64",
                                                       "linux", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, stage_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val target_changed: IrDebugContext = debug_context("post-codegen", "cross", "x86_64",
                                                        "linux", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, target_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val isa_changed: IrDebugContext = debug_context("post-codegen", "native", "aarch64",
                                                     "linux", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, isa_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val os_changed: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                    "windows", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, os_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val abi_changed: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                     "linux", "win64", "elf");
    if (!debug_differs(?w, ?m, ?itn, abi_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val of_changed: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                    "linux", "sysv64", "coff");
    if (!debug_differs(?w, ?m, ?itn, of_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    m.init_fn = opt[u32].some{0};
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    m.init_fn = opt[u32].none{};
    m.vector_ops_scalarized = 1;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret 0;
}

test "mach.lang.me.ir.printer.IrDebugWriter:names_and_context_strings_are_escaped" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    val rn: R.Result[intern.StrId, str] = intern.intern(?itn, "a\"b\\c\nd\te");
    if (R.is_err[intern.StrId, str](rn)) { intern.dnit(?itn); ret 1; }
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, R.unwrap_ok[intern.StrId, str](rn));
    if (sel rm.err) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = rm.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(?m, R.unwrap_ok[intern.StrId, str](rn), type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var control: [3]u8;
    control[0] = 'q';
    control[1] = 1;
    control[2] = 0;
    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;
    val context: IrDebugContext = debug_context((?control[0])::str, "t", "i", "o", "a", "f");
    var text_buf: [32768]u8;
    if (!capture_debug_into(?w, ?m, ?itn, context, ?text_buf[0])) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val rendered: str = (?text_buf[0])::str;
    var bad: i32 = 0;
    if (!str_contains(rendered, "stage=\"q\\x01\"")) { bad = 1; }
    if (!str_contains(rendered, "\"a\\\"b\\\\c\\nd\\te\"")) { bad = 1; }
    ir.dnit(?m);
    intern.dnit(?itn);
    ret bad;
}

test "mach.lang.me.ir.printer.IrDebugWriter:writer_errors_are_propagated" {
    val context: IrDebugContext = debug_context("s", "t", "i", "o", "a", "f");
    var failed: writer.Writer;
    failed.ctx = nil;
    failed.f_write = test_error_write;
    var d: IrDebugWriter = debug_writer(?failed, nil, nil, context);
    val rf: err[fail.Fail] = write_debug(?d);
    if (!sel rf.err) { ret 1; }
    if (!str_equals(fail.describe(rf.err), os.message(os.EIO))) { ret 1; }

    var stalled: writer.Writer;
    stalled.ctx = nil;
    stalled.f_write = test_stall_write;
    d = debug_writer(?stalled, nil, nil, context);
    val stalled_r: err[fail.Fail] = write_debug(?d);
    if (!sel stalled_r.err) { ret 1; }
    if (!str_equals(fail.describe(stalled_r.err), "short write")) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.IrDebugWriter:metadata_fields_are_independently_distinct" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    val rfn_name: R.Result[intern.StrId, str] = intern.intern(?itn, "fn");
    val risa: R.Result[intern.StrId, str] = intern.intern(?itn, "x86_64");
    val rbody: R.Result[intern.StrId, str] = intern.intern(?itn, "mov \"quoted\"");
    val rvar: R.Result[intern.StrId, str] = intern.intern(?itn, "local");
