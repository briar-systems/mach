    val ap: *ir.IrAsm = oa.some;
    val dv: *ir.DbgVar = odv.some;
    val av: *ir.DbgVar = oav.some;
    val dex: *ir.DbgExpr = odex.some;
    val site: *ir.InlineSite = osite.some;

    ap.isa = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    ap.isa = isa_name;
    ap.body = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
