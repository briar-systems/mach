    if (sel rasm_iid.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (sel rother_iid.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val iid: id.InstructionId = rasm_iid.ok;
