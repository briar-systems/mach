use std.allocator.page;
use std.collections.map;
use std.format;
use std.io.writer;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.float;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;
use semtype: mach.lang.type;

pub rec IrDebugContext {
    stage:  str;
    target: str;
    isa:    str;
    os:     str;
    abi:    str;
    of:     str;
}

pub rec IrDebugWriter {
    out:      *writer.Writer;
    m:        *ir.Module;
    interner: *intern.Interner;
    context:  IrDebugContext;
}

pub fun debug_context(stage: str, target_name: str, isa_name: str, os_name: str,
                      abi_name: str, of_name: str) IrDebugContext {
    var c: IrDebugContext;
    c.stage  = stage;
    c.target = target_name;
    c.isa    = isa_name;
    c.os     = os_name;
    c.abi    = abi_name;
    c.of     = of_name;
    ret c;
}

pub fun debug_writer(out: *writer.Writer, m: *ir.Module, interner: *intern.Interner,
                     context: IrDebugContext) IrDebugWriter {
    var d: IrDebugWriter;
    d.out      = out;
    d.m        = m;
    d.interner = interner;
    d.context  = context;
    ret d;
}

pub fun write_debug(d: *IrDebugWriter) R.Result[R.Void, str] {
    val out: *writer.Writer = d.out;
    val res_head: R.Result[R.Void, str] = emit_str(out, "ir-debug stage=");
    if (R.is_err[R.Void, str](res_head)) { ret res_head; }
    val res_stage: R.Result[R.Void, str] = emit_quoted(out, d.context.stage);
    if (R.is_err[R.Void, str](res_stage)) { ret res_stage; }
    val res_target: R.Result[R.Void, str] = emit_str(out, " target=");
    if (R.is_err[R.Void, str](res_target)) { ret res_target; }
    val res_target_name: R.Result[R.Void, str] = emit_quoted(out, d.context.target);
    if (R.is_err[R.Void, str](res_target_name)) { ret res_target_name; }
    val res_isa: R.Result[R.Void, str] = emit_str(out, " isa=");
    if (R.is_err[R.Void, str](res_isa)) { ret res_isa; }
    val res_isa_name: R.Result[R.Void, str] = emit_quoted(out, d.context.isa);
    if (R.is_err[R.Void, str](res_isa_name)) { ret res_isa_name; }
    val res_os: R.Result[R.Void, str] = emit_str(out, " os=");
    if (R.is_err[R.Void, str](res_os)) { ret res_os; }
    val res_os_name: R.Result[R.Void, str] = emit_quoted(out, d.context.os);
    if (R.is_err[R.Void, str](res_os_name)) { ret res_os_name; }
    val res_abi: R.Result[R.Void, str] = emit_str(out, " abi=");
    if (R.is_err[R.Void, str](res_abi)) { ret res_abi; }
    val res_abi_name: R.Result[R.Void, str] = emit_quoted(out, d.context.abi);
    if (R.is_err[R.Void, str](res_abi_name)) { ret res_abi_name; }
    val res_of: R.Result[R.Void, str] = emit_str(out, " of=");
    if (R.is_err[R.Void, str](res_of)) { ret res_of; }
    val res_of_name: R.Result[R.Void, str] = emit_quoted(out, d.context.of);
    if (R.is_err[R.Void, str](res_of_name)) { ret res_of_name; }
    val res_line: R.Result[R.Void, str] = emit_str(out, "\n");
    if (R.is_err[R.Void, str](res_line)) { ret res_line; }
    ret write_module_body(out, d.m, d.interner);
}

fun write_module_body(out: *writer.Writer, m: *ir.Module, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, "module ");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    val res_name: R.Result[R.Void, str] = emit_name(out, interner, m.name);
    if (R.is_err[R.Void, str](res_name)) { ret res_name; }
    val res_brace: R.Result[R.Void, str] = emit_str(out, " {\n");
    if (R.is_err[R.Void, str](res_brace)) { ret res_brace; }

    val res_state: R.Result[R.Void, str] = print_module_state(out, m);
    if (R.is_err[R.Void, str](res_state)) { ret res_state; }
    val res_types: R.Result[R.Void, str] = print_type_table(out, m);
    if (R.is_err[R.Void, str](res_types)) { ret res_types; }

    var i: u32 = 0;
    for (i < m.global_len) {
        val res_global: R.Result[R.Void, str] = print_global(out, m, ?m.globals[i], interner);
        if (R.is_err[R.Void, str](res_global)) { ret res_global; }
        i = i + 1;
    }
    if (m.global_len > 0) {
        val res_gap: R.Result[R.Void, str] = emit_str(out, "\n");
        if (R.is_err[R.Void, str](res_gap)) { ret res_gap; }
    }

    i = 0;
    for (i < m.function_len) {
        val res_fn: R.Result[R.Void, str] = print_function(out, m, ?m.functions[i], interner);
        if (R.is_err[R.Void, str](res_fn)) { ret res_fn; }
        if (i + 1 < m.function_len) {
            val res_gap: R.Result[R.Void, str] = emit_str(out, "\n");
            if (R.is_err[R.Void, str](res_gap)) { ret res_gap; }
        }
        i = i + 1;
    }

    ret emit_str(out, "}\n");
}

fun print_module_state(out: *writer.Writer, m: *ir.Module) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, "  state [init_fn=");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    if (O.is_some[u32](m.init_fn)) {
        val res_sigil: R.Result[R.Void, str] = emit_str(out, "@");
        if (R.is_err[R.Void, str](res_sigil)) { ret res_sigil; }
        val res_init: R.Result[R.Void, str] = emit_u64(out, O.unwrap[u32](m.init_fn)::u64);
        if (R.is_err[R.Void, str](res_init)) { ret res_init; }
    }
    or {
        val res_none: R.Result[R.Void, str] = emit_str(out, "none");
        if (R.is_err[R.Void, str](res_none)) { ret res_none; }
    }
    val res_vec: R.Result[R.Void, str] = emit_str(out, " vector_ops_scalarized=");
    if (R.is_err[R.Void, str](res_vec)) { ret res_vec; }
    val res_count: R.Result[R.Void, str] = emit_u64(out, m.vector_ops_scalarized::u64);
    if (R.is_err[R.Void, str](res_count)) { ret res_count; }
    ret emit_str(out, "]\n");
}

fun print_type_ref(out: *writer.Writer, tid: type.IrTypeId) R.Result[R.Void, str] {
    if (tid == type.IRT_NIL) { ret emit_str(out, "!nil"); }
    val res_sigil: R.Result[R.Void, str] = emit_str(out, "!");
    if (R.is_err[R.Void, str](res_sigil)) { ret res_sigil; }
    ret emit_u64(out, tid::u64);
}

fun print_type_table(out: *writer.Writer, m: *ir.Module) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, "  types {\n");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    var i: u32 = 0;
    for (i < m.types.len) {
        val res_indent: R.Result[R.Void, str] = emit_str(out, "    !");
        if (R.is_err[R.Void, str](res_indent)) { ret res_indent; }
        val res_id: R.Result[R.Void, str] = emit_u64(out, i::u64);
        if (R.is_err[R.Void, str](res_id)) { ret res_id; }
        val res_eq: R.Result[R.Void, str] = emit_str(out, " = ");
        if (R.is_err[R.Void, str](res_eq)) { ret res_eq; }
        val res_ty: R.Result[R.Void, str] = print_type(out, m, i::type.IrTypeId);
        if (R.is_err[R.Void, str](res_ty)) { ret res_ty; }
        val res_line: R.Result[R.Void, str] = emit_str(out, "\n");
        if (R.is_err[R.Void, str](res_line)) { ret res_line; }
        i = i + 1;
    }
    ret emit_str(out, "  }\n");
}

pub fun print_global(out: *writer.Writer, m: *ir.Module, g: *ir.Global, interner: *intern.Interner) R.Result[R.Void, str] {
    var head: str = "  val @";
    if (g.is_mut) { head = "  var @"; }
    val res_head: R.Result[R.Void, str] = emit_str(out, head);
    if (R.is_err[R.Void, str](res_head)) { ret res_head; }
    val res_name: R.Result[R.Void, str] = emit_name(out, interner, g.name);
    if (R.is_err[R.Void, str](res_name)) { ret res_name; }
    val res_colon: R.Result[R.Void, str] = emit_str(out, ": ");
    if (R.is_err[R.Void, str](res_colon)) { ret res_colon; }
    val res_ty: R.Result[R.Void, str] = print_type_ref(out, g.ty);
    if (R.is_err[R.Void, str](res_ty)) { ret res_ty; }
    val res_eq: R.Result[R.Void, str] = emit_str(out, " = ");
    if (R.is_err[R.Void, str](res_eq)) { ret res_eq; }
    val res_val: R.Result[R.Void, str] = print_operand(out, m, ?g.init, interner);
    if (R.is_err[R.Void, str](res_val)) { ret res_val; }
    val res_link: R.Result[R.Void, str] = print_global_linkage(out, g, interner);
    if (R.is_err[R.Void, str](res_link)) { ret res_link; }
    ret emit_str(out, "\n");
}

fun print_global_linkage(out: *writer.Writer, g: *ir.Global, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, " [");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    var first: bool = true;
    if (g.is_pub) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "pub");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if (g.is_extern) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "extern");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if (g.is_import) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "import");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if (g.is_local) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "local");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if (g.is_embed) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "embed");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    val res_word: R.Result[R.Void, str] = print_linkage_word(out, ?first, "align=");
    if (R.is_err[R.Void, str](res_word)) { ret res_word; }
    val res_align: R.Result[R.Void, str] = emit_u64(out, g.align::u64);
    if (R.is_err[R.Void, str](res_align)) { ret res_align; }
    val res_section: R.Result[R.Void, str] = emit_str(out, " section=");
    if (R.is_err[R.Void, str](res_section)) { ret res_section; }
    val res_section_name: R.Result[R.Void, str] = emit_name(out, interner, g.section);
    if (R.is_err[R.Void, str](res_section_name)) { ret res_section_name; }
    val res_iface: R.Result[R.Void, str] = emit_str(out, " iface=");
    if (R.is_err[R.Void, str](res_iface)) { ret res_iface; }
    val res_iface_value: R.Result[R.Void, str] = emit_u64(out, g.iface::u64);
    if (R.is_err[R.Void, str](res_iface_value)) { ret res_iface_value; }
    val res_iface_a: R.Result[R.Void, str] = emit_str(out, ":");
    if (R.is_err[R.Void, str](res_iface_a)) { ret res_iface_a; }
    val res_a: R.Result[R.Void, str] = emit_u64(out, g.iface_a::u64);
    if (R.is_err[R.Void, str](res_a)) { ret res_a; }
    val res_iface_b: R.Result[R.Void, str] = emit_str(out, ":");
    if (R.is_err[R.Void, str](res_iface_b)) { ret res_iface_b; }
    val res_b: R.Result[R.Void, str] = emit_u64(out, g.iface_b::u64);
    if (R.is_err[R.Void, str](res_b)) { ret res_b; }
    val res_iface_flags: R.Result[R.Void, str] = emit_str(out, ":");
    if (R.is_err[R.Void, str](res_iface_flags)) { ret res_iface_flags; }
    val res_iflags: R.Result[R.Void, str] = emit_u64(out, g.iface_flags::u64);
    if (R.is_err[R.Void, str](res_iflags)) { ret res_iflags; }
    ret emit_str(out, "]");
}

fun print_linkage_word(out: *writer.Writer, first: *bool, word: str) R.Result[R.Void, str] {
    if (!@first) {
        val res_sep: R.Result[R.Void, str] = emit_str(out, " ");
        if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
    }
    @first = false;
    ret emit_str(out, word);
}

fun print_function_flags(out: *writer.Writer, fn: *ir.Function, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, " [");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    var first: bool = true;
    if ((fn.flags & ir.FN_FLAG_PUB) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "pub");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "extern");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_INLINE) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "inline");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_NORETURN) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "noreturn");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_TEST) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "test");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_WEAK) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "weak");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_OBLIVIOUS) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "oblivious");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_SCALAR) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "scalar");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_NOINLINE) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "noinline");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((fn.flags & ir.FN_FLAG_NAKED) != 0) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "naked");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if (fn.is_import) {
        val res: R.Result[R.Void, str] = print_linkage_word(out, ?first, "import");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    val res_raw: R.Result[R.Void, str] = print_linkage_word(out, ?first, "flags=");
    if (R.is_err[R.Void, str](res_raw)) { ret res_raw; }
    val res_flags: R.Result[R.Void, str] = emit_u64(out, fn.flags::u64);
    if (R.is_err[R.Void, str](res_flags)) { ret res_flags; }
    val res_sig: R.Result[R.Void, str] = emit_str(out, " sig=");
    if (R.is_err[R.Void, str](res_sig)) { ret res_sig; }
    val res_sig_ty: R.Result[R.Void, str] = print_type_ref(out, fn.sig);
    if (R.is_err[R.Void, str](res_sig_ty)) { ret res_sig_ty; }
    val res_label: R.Result[R.Void, str] = emit_str(out, " label=");
    if (R.is_err[R.Void, str](res_label)) { ret res_label; }
    val res_label_name: R.Result[R.Void, str] = emit_name(out, interner, fn.label);
    if (R.is_err[R.Void, str](res_label_name)) { ret res_label_name; }
    val res_line: R.Result[R.Void, str] = emit_str(out, " line=");
    if (R.is_err[R.Void, str](res_line)) { ret res_line; }
    val res_line_value: R.Result[R.Void, str] = emit_u64(out, fn.line::u64);
    if (R.is_err[R.Void, str](res_line_value)) { ret res_line_value; }
    val res_section: R.Result[R.Void, str] = emit_str(out, " section=");
    if (R.is_err[R.Void, str](res_section)) { ret res_section; }
    val res_section_name: R.Result[R.Void, str] = emit_name(out, interner, fn.section);
    if (R.is_err[R.Void, str](res_section_name)) { ret res_section_name; }
    val res_stage: R.Result[R.Void, str] = emit_str(out, " stage=");
    if (R.is_err[R.Void, str](res_stage)) { ret res_stage; }
    val res_stage_value: R.Result[R.Void, str] = emit_u64(out, fn.stage::u64);
    if (R.is_err[R.Void, str](res_stage_value)) { ret res_stage_value; }
    val res_wg: R.Result[R.Void, str] = emit_str(out, " wg=");
    if (R.is_err[R.Void, str](res_wg)) { ret res_wg; }
    val res_wgx: R.Result[R.Void, str] = emit_u64(out, fn.wg_x::u64);
    if (R.is_err[R.Void, str](res_wgx)) { ret res_wgx; }
    val res_wgx_sep: R.Result[R.Void, str] = emit_str(out, "x");
    if (R.is_err[R.Void, str](res_wgx_sep)) { ret res_wgx_sep; }
    val res_wgy: R.Result[R.Void, str] = emit_u64(out, fn.wg_y::u64);
    if (R.is_err[R.Void, str](res_wgy)) { ret res_wgy; }
    val res_wgy_sep: R.Result[R.Void, str] = emit_str(out, "x");
    if (R.is_err[R.Void, str](res_wgy_sep)) { ret res_wgy_sep; }
    val res_wgz: R.Result[R.Void, str] = emit_u64(out, fn.wg_z::u64);
    if (R.is_err[R.Void, str](res_wgz)) { ret res_wgz; }
    val res_op: R.Result[R.Void, str] = emit_str(out, " op=");
    if (R.is_err[R.Void, str](res_op)) { ret res_op; }
    val res_op_set: R.Result[R.Void, str] = emit_u64(out, fn.op_set::u64);
    if (R.is_err[R.Void, str](res_op_set)) { ret res_op_set; }
    val res_op_sep: R.Result[R.Void, str] = emit_str(out, ":");
    if (R.is_err[R.Void, str](res_op_sep)) { ret res_op_sep; }
    val res_op_code: R.Result[R.Void, str] = emit_u64(out, fn.op_code::u64);
    if (R.is_err[R.Void, str](res_op_code)) { ret res_op_code; }
    val res_disp: R.Result[R.Void, str] = emit_str(out, " disp=");
    if (R.is_err[R.Void, str](res_disp)) { ret res_disp; }
    val res_disp_name: R.Result[R.Void, str] = emit_name(out, interner, fn.disp);
    if (R.is_err[R.Void, str](res_disp_name)) { ret res_disp_name; }
    val res_ret_sem: R.Result[R.Void, str] = emit_str(out, " ret_sem=");
    if (R.is_err[R.Void, str](res_ret_sem)) { ret res_ret_sem; }
    val res_ret_sem_value: R.Result[R.Void, str] = emit_u64(out, fn.ret_sem::u64);
    if (R.is_err[R.Void, str](res_ret_sem_value)) { ret res_ret_sem_value; }
    ret emit_str(out, "]");
}

pub fun print_function(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_head: R.Result[R.Void, str] = emit_str(out, "  fn @");
    if (R.is_err[R.Void, str](res_head)) { ret res_head; }
    val res_name: R.Result[R.Void, str] = emit_name(out, interner, fn.name);
    if (R.is_err[R.Void, str](res_name)) { ret res_name; }
    val res_open: R.Result[R.Void, str] = emit_str(out, "(");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }

    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0) {
        val res_sig: R.Result[R.Void, str] = print_signature_params(out, m, fn.sig);
        if (R.is_err[R.Void, str](res_sig)) { ret res_sig; }
    }
    or {
        var i: u32 = 0;
        for (i < fn.param_count) {
            if (i > 0) {
                val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
                if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
            }
            val res_param: R.Result[R.Void, str] = print_operand(out, m, ?fn.params[i], interner);
            if (R.is_err[R.Void, str](res_param)) { ret res_param; }
            i = i + 1;
        }
    }

    val res_close: R.Result[R.Void, str] = emit_str(out, "): ");
    if (R.is_err[R.Void, str](res_close)) { ret res_close; }
    val res_ret: R.Result[R.Void, str] = print_signature_ret(out, m, fn.sig);
    if (R.is_err[R.Void, str](res_ret)) { ret res_ret; }
    val res_flags: R.Result[R.Void, str] = print_function_flags(out, fn, interner);
    if (R.is_err[R.Void, str](res_flags)) { ret res_flags; }

    if ((fn.flags & ir.FN_FLAG_EXTERN) != 0) {
        ret emit_str(out, "\n");
    }

    val res_brace: R.Result[R.Void, str] = emit_str(out, " {\n");
    if (R.is_err[R.Void, str](res_brace)) { ret res_brace; }

    var i: u32 = 0;
    for (i < fn.block_count) {
        val res_block: R.Result[R.Void, str] = print_block(out, m, fn, ?fn.blocks[i], interner);
        if (R.is_err[R.Void, str](res_block)) { ret res_block; }
        i = i + 1;
    }

    val res_unattached: R.Result[R.Void, str] = print_unattached_instructions(out, m, fn, interner);
    if (R.is_err[R.Void, str](res_unattached)) { ret res_unattached; }
    val res_metadata: R.Result[R.Void, str] = print_function_metadata(out, fn, interner);
    if (R.is_err[R.Void, str](res_metadata)) { ret res_metadata; }

    ret emit_str(out, "  }\n");
}

pub fun print_block(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, blk: *ir.Block, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_label: R.Result[R.Void, str] = emit_str(out, "    block bb");
    if (R.is_err[R.Void, str](res_label)) { ret res_label; }
    val res_id: R.Result[R.Void, str] = emit_u64(out, blk.id::u64);
    if (R.is_err[R.Void, str](res_id)) { ret res_id; }
    val res_preds: R.Result[R.Void, str] = emit_str(out, " [preds=");
    if (R.is_err[R.Void, str](res_preds)) { ret res_preds; }
    var pi: u32 = 0;
    for (pi < blk.pred_count) {
        if (pi > 0) {
            val res_sep: R.Result[R.Void, str] = emit_str(out, ",");
            if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
        }
        val res_bb: R.Result[R.Void, str] = emit_str(out, "bb");
        if (R.is_err[R.Void, str](res_bb)) { ret res_bb; }
        val res_pred: R.Result[R.Void, str] = emit_u64(out, blk.preds[pi]::u64);
        if (R.is_err[R.Void, str](res_pred)) { ret res_pred; }
        pi = pi + 1;
    }
    val res_colon: R.Result[R.Void, str] = emit_str(out, "]:\n");
    if (R.is_err[R.Void, str](res_colon)) { ret res_colon; }

    var i: u32 = 0;
    for (i < blk.phi_count) {
        val res_phi: R.Result[R.Void, str] = print_instruction_id(out, m, fn, blk.phis[i], interner);
        if (R.is_err[R.Void, str](res_phi)) { ret res_phi; }
        i = i + 1;
    }

    i = 0;
    for (i < blk.instr_count) {
        val res_instr: R.Result[R.Void, str] = print_instruction_id(out, m, fn, blk.instructions[i], interner);
        if (R.is_err[R.Void, str](res_instr)) { ret res_instr; }
        i = i + 1;
    }

    if (blk.terminator != id.INSTR_NIL) {
        ret print_instruction_id(out, m, fn, blk.terminator, interner);
    }
    ret R.ok_void[str]();
}

pub fun print_instruction(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, ins: *instruction.Instruction, iid: id.InstructionId, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_indent: R.Result[R.Void, str] = emit_str(out, "      ");
    if (R.is_err[R.Void, str](res_indent)) { ret res_indent; }

    val has_result: bool = produces_value(ins.kind);
    if (has_result) {
        val res_marker: R.Result[R.Void, str] = emit_str(out, "%");
        if (R.is_err[R.Void, str](res_marker)) { ret res_marker; }
        val res_id: R.Result[R.Void, str] = emit_u64(out, iid::u64);
        if (R.is_err[R.Void, str](res_id)) { ret res_id; }
        val res_eq: R.Result[R.Void, str] = emit_str(out, " = ");
        if (R.is_err[R.Void, str](res_eq)) { ret res_eq; }
    }

    val res_op: R.Result[R.Void, str] = emit_str(out, opcode_name(ins.kind));
    if (R.is_err[R.Void, str](res_op)) { ret res_op; }
    val res_flags: R.Result[R.Void, str] = print_flag_suffixes(out, ins.flags, ins.secret);
    if (R.is_err[R.Void, str](res_flags)) { ret res_flags; }

    if (has_result) {
        val res_space: R.Result[R.Void, str] = emit_str(out, " ");
        if (R.is_err[R.Void, str](res_space)) { ret res_space; }
        var result_ty: type.IrTypeId = ins.ty;
        if (ins.kind == instruction.OP_ALLOCA) { result_ty = ins.aux_ty; }
        val res_ty: R.Result[R.Void, str] = print_type_ref(out, result_ty);
        if (R.is_err[R.Void, str](res_ty)) { ret res_ty; }
    }

    if (ins.kind == instruction.OP_PHI) {
        val res_phi: R.Result[R.Void, str] = print_phi_operands(out, m, fn, ins, interner);
        if (R.is_err[R.Void, str](res_phi)) { ret res_phi; }
    }
    or {
        val res_operands: R.Result[R.Void, str] = print_operands(out, m, fn, ins, interner);
        if (R.is_err[R.Void, str](res_operands)) { ret res_operands; }
    }

    val res_state: R.Result[R.Void, str] = emit_str(out, " ; state{ty=");
    if (R.is_err[R.Void, str](res_state)) { ret res_state; }
    val res_state_ty: R.Result[R.Void, str] = print_type_ref(out, ins.ty);
    if (R.is_err[R.Void, str](res_state_ty)) { ret res_state_ty; }
    val res_aux: R.Result[R.Void, str] = emit_str(out, ", aux=");
    if (R.is_err[R.Void, str](res_aux)) { ret res_aux; }
    val res_aux_ty: R.Result[R.Void, str] = print_type_ref(out, ins.aux_ty);
    if (R.is_err[R.Void, str](res_aux_ty)) { ret res_aux_ty; }
    val res_kind: R.Result[R.Void, str] = emit_str(out, ", kind=");
    if (R.is_err[R.Void, str](res_kind)) { ret res_kind; }
    val res_kind_value: R.Result[R.Void, str] = emit_u64(out, ins.kind::u64);
    if (R.is_err[R.Void, str](res_kind_value)) { ret res_kind_value; }
    val res_operand_count: R.Result[R.Void, str] = emit_str(out, ", operands=");
    if (R.is_err[R.Void, str](res_operand_count)) { ret res_operand_count; }
    val res_operand_count_value: R.Result[R.Void, str] = emit_u64(out, ins.operand_count::u64);
    if (R.is_err[R.Void, str](res_operand_count_value)) { ret res_operand_count_value; }
    val res_raw_flags: R.Result[R.Void, str] = emit_str(out, ", flags=");
    if (R.is_err[R.Void, str](res_raw_flags)) { ret res_raw_flags; }
    val res_flag_value: R.Result[R.Void, str] = emit_u64(out, ins.flags::u64);
    if (R.is_err[R.Void, str](res_flag_value)) { ret res_flag_value; }
    val res_loc: R.Result[R.Void, str] = emit_str(out, ", loc=");
    if (R.is_err[R.Void, str](res_loc)) { ret res_loc; }
    val res_file: R.Result[R.Void, str] = emit_u64(out, ins.loc.file::u64);
    if (R.is_err[R.Void, str](res_file)) { ret res_file; }
    val res_loc_sep: R.Result[R.Void, str] = emit_str(out, ":");
    if (R.is_err[R.Void, str](res_loc_sep)) { ret res_loc_sep; }
    val res_offset: R.Result[R.Void, str] = emit_u64(out, ins.loc.offset::u64);
    if (R.is_err[R.Void, str](res_offset)) { ret res_offset; }
    val res_secret: R.Result[R.Void, str] = emit_str(out, ", secret=");
    if (R.is_err[R.Void, str](res_secret)) { ret res_secret; }
    val res_secret_value: R.Result[R.Void, str] = print_bool(out, ins.secret);
    if (R.is_err[R.Void, str](res_secret_value)) { ret res_secret_value; }
    val res_pure: R.Result[R.Void, str] = emit_str(out, ", pure=");
    if (R.is_err[R.Void, str](res_pure)) { ret res_pure; }
    val res_pure_value: R.Result[R.Void, str] = print_bool(out, opdesc.has(ins.kind, opdesc.EFF_DISCARDABLE));
    if (R.is_err[R.Void, str](res_pure_value)) { ret res_pure_value; }
    val res_trap: R.Result[R.Void, str] = emit_str(out, ", may_trap=");
    if (R.is_err[R.Void, str](res_trap)) { ret res_trap; }
    val res_trap_value: R.Result[R.Void, str] = print_bool(out, opdesc.may_trap(ins.kind));
    if (R.is_err[R.Void, str](res_trap_value)) { ret res_trap_value; }
    val res_volatile: R.Result[R.Void, str] = emit_str(out, ", volatile=");
    if (R.is_err[R.Void, str](res_volatile)) { ret res_volatile; }
    val res_volatile_value: R.Result[R.Void, str] = print_bool(out, effect.is_volatile(ins));
    if (R.is_err[R.Void, str](res_volatile_value)) { ret res_volatile_value; }
    val res_inline: R.Result[R.Void, str] = emit_str(out, ", inline=");
    if (R.is_err[R.Void, str](res_inline)) { ret res_inline; }
    val res_inline_value: R.Result[R.Void, str] = emit_u64(out, ir.instr_inline_site_of(fn, iid)::u64);
    if (R.is_err[R.Void, str](res_inline_value)) { ret res_inline_value; }
    val res_metadata: R.Result[R.Void, str] = print_instruction_metadata(out, fn, iid, interner);
    if (R.is_err[R.Void, str](res_metadata)) { ret res_metadata; }
    val res_state_close: R.Result[R.Void, str] = emit_str(out, "}");
    if (R.is_err[R.Void, str](res_state_close)) { ret res_state_close; }

    ret emit_str(out, "\n");
}

fun print_dbg_expr_payload(out: *writer.Writer, dex: *ir.DbgExpr) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, "[");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    var i: u32 = 0;
    for (i < dex.op_count) {
        if (i > 0) {
            val res_comma: R.Result[R.Void, str] = emit_str(out, ", ");
            if (R.is_err[R.Void, str](res_comma)) { ret res_comma; }
        }
        val res_op: R.Result[R.Void, str] = emit_str(out, "{op=");
        if (R.is_err[R.Void, str](res_op)) { ret res_op; }
        val res_op_value: R.Result[R.Void, str] = emit_u64(out, dex.ops[i].op::u64);
        if (R.is_err[R.Void, str](res_op_value)) { ret res_op_value; }
        val res_arg: R.Result[R.Void, str] = emit_str(out, " arg=");
        if (R.is_err[R.Void, str](res_arg)) { ret res_arg; }
        val res_arg_value: R.Result[R.Void, str] = emit_u64(out, dex.ops[i].arg);
        if (R.is_err[R.Void, str](res_arg_value)) { ret res_arg_value; }
        val res_close: R.Result[R.Void, str] = emit_str(out, "}");
        if (R.is_err[R.Void, str](res_close)) { ret res_close; }
        i = i + 1;
    }
    ret emit_str(out, "]");
}

fun print_bool(out: *writer.Writer, v: bool) R.Result[R.Void, str] {
    if (v) { ret emit_str(out, "true"); }
    ret emit_str(out, "false");
}

fun print_loc(out: *writer.Writer, loc: source.SrcLoc) R.Result[R.Void, str] {
    val res_file: R.Result[R.Void, str] = emit_u64(out, loc.file::u64);
    if (R.is_err[R.Void, str](res_file)) { ret res_file; }
    val res_sep: R.Result[R.Void, str] = emit_str(out, ":");
    if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
    ret emit_u64(out, loc.offset::u64);
}

fun print_dbg_var(out: *writer.Writer, dv: *ir.DbgVar, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, "{name=");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    val res_name: R.Result[R.Void, str] = emit_name(out, interner, dv.name);
    if (R.is_err[R.Void, str](res_name)) { ret res_name; }
    val res_ty: R.Result[R.Void, str] = emit_str(out, " ty=");
    if (R.is_err[R.Void, str](res_ty)) { ret res_ty; }
    val res_ty_value: R.Result[R.Void, str] = print_type_ref(out, dv.ty);
    if (R.is_err[R.Void, str](res_ty_value)) { ret res_ty_value; }
    val res_sem: R.Result[R.Void, str] = emit_str(out, " sem=");
    if (R.is_err[R.Void, str](res_sem)) { ret res_sem; }
    val res_sem_value: R.Result[R.Void, str] = emit_u64(out, dv.ty_sem::u64);
    if (R.is_err[R.Void, str](res_sem_value)) { ret res_sem_value; }
    val res_param: R.Result[R.Void, str] = emit_str(out, " param=");
    if (R.is_err[R.Void, str](res_param)) { ret res_param; }
    val res_param_value: R.Result[R.Void, str] = print_bool(out, dv.is_param);
    if (R.is_err[R.Void, str](res_param_value)) { ret res_param_value; }
    val res_scope: R.Result[R.Void, str] = emit_str(out, " scope=");
    if (R.is_err[R.Void, str](res_scope)) { ret res_scope; }
    val res_scope_value: R.Result[R.Void, str] = emit_u64(out, dv.scope::u64);
    if (R.is_err[R.Void, str](res_scope_value)) { ret res_scope_value; }
    ret emit_str(out, "}");
}

fun asm_get(fn: *ir.Function, iid: id.InstructionId) O.Option[*ir.IrAsm] {
    var key: id.InstructionId = iid;
    val res: R.Result[*ir.IrAsm, str] = map.get[id.InstructionId, ir.IrAsm](?fn.asm_blocks, ?key);
    if (R.is_err[*ir.IrAsm, str](res)) { ret O.none[*ir.IrAsm](); }
    ret O.some[*ir.IrAsm](R.unwrap_ok[*ir.IrAsm, str](res));
}

fun print_asm(out: *writer.Writer, a: *ir.IrAsm, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, "{isa=");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    val res_isa: R.Result[R.Void, str] = emit_name(out, interner, a.isa);
    if (R.is_err[R.Void, str](res_isa)) { ret res_isa; }
    val res_body: R.Result[R.Void, str] = emit_str(out, " body=");
    if (R.is_err[R.Void, str](res_body)) { ret res_body; }
    val res_body_value: R.Result[R.Void, str] = emit_name(out, interner, a.body);
    if (R.is_err[R.Void, str](res_body_value)) { ret res_body_value; }
    val res_binds: R.Result[R.Void, str] = emit_str(out, " binds=[");
    if (R.is_err[R.Void, str](res_binds)) { ret res_binds; }
    var i: u32 = 0;
    for (i < a.bind_count) {
        if (i > 0) {
            val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
            if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
        }
        val res_bind_open: R.Result[R.Void, str] = emit_str(out, "{name=");
        if (R.is_err[R.Void, str](res_bind_open)) { ret res_bind_open; }
        val res_name: R.Result[R.Void, str] = emit_name(out, interner, a.binds[i].name);
        if (R.is_err[R.Void, str](res_name)) { ret res_name; }
        val res_instr: R.Result[R.Void, str] = emit_str(out, " instr=%");
        if (R.is_err[R.Void, str](res_instr)) { ret res_instr; }
        val res_instr_value: R.Result[R.Void, str] = emit_u64(out, a.binds[i].instr::u64);
        if (R.is_err[R.Void, str](res_instr_value)) { ret res_instr_value; }
        val res_secret: R.Result[R.Void, str] = emit_str(out, " secret=");
        if (R.is_err[R.Void, str](res_secret)) { ret res_secret; }
        val res_secret_value: R.Result[R.Void, str] = print_bool(out, a.binds[i].secret);
        if (R.is_err[R.Void, str](res_secret_value)) { ret res_secret_value; }
        val res_bind_close: R.Result[R.Void, str] = emit_str(out, "}");
        if (R.is_err[R.Void, str](res_bind_close)) { ret res_bind_close; }
        i = i + 1;
    }
    ret emit_str(out, "]}");
}

fun print_instruction_metadata(out: *writer.Writer, fn: *ir.Function,
                               iid: id.InstructionId, interner: *intern.Interner) R.Result[R.Void, str] {
    val oa: O.Option[*ir.IrAsm] = asm_get(fn, iid);
    if (O.is_some[*ir.IrAsm](oa)) {
        val res_tag: R.Result[R.Void, str] = emit_str(out, ", asm=");
        if (R.is_err[R.Void, str](res_tag)) { ret res_tag; }
        val res_value: R.Result[R.Void, str] = print_asm(out, O.unwrap[*ir.IrAsm](oa), interner);
        if (R.is_err[R.Void, str](res_value)) { ret res_value; }
    }
    val odv: O.Option[*ir.DbgVar] = ir.dbg_var_get(fn, iid);
    if (O.is_some[*ir.DbgVar](odv)) {
        val res_tag: R.Result[R.Void, str] = emit_str(out, ", dbg_var=");
        if (R.is_err[R.Void, str](res_tag)) { ret res_tag; }
        val res_value: R.Result[R.Void, str] = print_dbg_var(out, O.unwrap[*ir.DbgVar](odv), interner);
        if (R.is_err[R.Void, str](res_value)) { ret res_value; }
    }
    val oav: O.Option[*ir.DbgVar] = ir.alloca_dbg_var_get(fn, iid);
    if (O.is_some[*ir.DbgVar](oav)) {
        val res_tag: R.Result[R.Void, str] = emit_str(out, ", alloca_dbg_var=");
        if (R.is_err[R.Void, str](res_tag)) { ret res_tag; }
        val res_value: R.Result[R.Void, str] = print_dbg_var(out, O.unwrap[*ir.DbgVar](oav), interner);
        if (R.is_err[R.Void, str](res_value)) { ret res_value; }
    }
    val eid: ir.DbgExprId = ir.dbg_expr_id(fn, iid);
    val res_expr: R.Result[R.Void, str] = emit_str(out, ", dbg_expr=");
    if (R.is_err[R.Void, str](res_expr)) { ret res_expr; }
    val res_expr_id: R.Result[R.Void, str] = emit_u64(out, eid::u64);
    if (R.is_err[R.Void, str](res_expr_id)) { ret res_expr_id; }
    ret R.ok_void[str]();
}

fun instruction_is_listed(fn: *ir.Function, iid: id.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var i: u32 = 0;
        for (i < blk.phi_count) {
            if (blk.phis[i] == iid) { ret true; }
            i = i + 1;
        }
        i = 0;
        for (i < blk.instr_count) {
            if (blk.instructions[i] == iid) { ret true; }
            i = i + 1;
        }
        if (blk.terminator == iid) { ret true; }
        bi = bi + 1;
    }
    ret false;
}

fun print_unattached_instructions(out: *writer.Writer, m: *ir.Module, fn: *ir.Function,
                                  interner: *intern.Interner) R.Result[R.Void, str] {
    var opened: bool = false;
    var i: u32 = 0;
    for (i < fn.instr_len) {
        if (!instruction_is_listed(fn, i::id.InstructionId)) {
            if (!opened) {
                val res_open: R.Result[R.Void, str] = emit_str(out, "    unattached {\n");
                if (R.is_err[R.Void, str](res_open)) { ret res_open; }
                opened = true;
            }
            val res_instr: R.Result[R.Void, str] = print_instruction(out, m, fn, ?fn.instrs[i], i::id.InstructionId, interner);
            if (R.is_err[R.Void, str](res_instr)) { ret res_instr; }
        }
        i = i + 1;
    }
    if (opened) { ret emit_str(out, "    }\n"); }
    ret R.ok_void[str]();
}

fun print_function_metadata(out: *writer.Writer, fn: *ir.Function,
                            interner: *intern.Interner) R.Result[R.Void, str] {
    if (fn.dbg_expr_len > 0) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "    dbg_exprs {\n");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        var i: u32 = 0;
        for (i < fn.dbg_expr_len) {
            val res_indent: R.Result[R.Void, str] = emit_str(out, "      #");
            if (R.is_err[R.Void, str](res_indent)) { ret res_indent; }
            val res_id: R.Result[R.Void, str] = emit_u64(out, (i + 1)::u64);
            if (R.is_err[R.Void, str](res_id)) { ret res_id; }
            val res_eq: R.Result[R.Void, str] = emit_str(out, " = ");
            if (R.is_err[R.Void, str](res_eq)) { ret res_eq; }
            val res_expr: R.Result[R.Void, str] = print_dbg_expr_payload(out, ?fn.dbg_exprs[i]);
            if (R.is_err[R.Void, str](res_expr)) { ret res_expr; }
            val res_line: R.Result[R.Void, str] = emit_str(out, "\n");
            if (R.is_err[R.Void, str](res_line)) { ret res_line; }
            i = i + 1;
        }
        val res_close: R.Result[R.Void, str] = emit_str(out, "    }\n");
        if (R.is_err[R.Void, str](res_close)) { ret res_close; }
    }
    if (fn.inline_site_len > 0) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "    inline_sites {\n");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        var i: u32 = 0;
        for (i < fn.inline_site_len) {
            val site: *ir.InlineSite = ?fn.inline_sites[i];
            val res_indent: R.Result[R.Void, str] = emit_str(out, "      #");
            if (R.is_err[R.Void, str](res_indent)) { ret res_indent; }
            val res_id: R.Result[R.Void, str] = emit_u64(out, (i + 1)::u64);
            if (R.is_err[R.Void, str](res_id)) { ret res_id; }
            val res_callee: R.Result[R.Void, str] = emit_str(out, " = {callee=");
            if (R.is_err[R.Void, str](res_callee)) { ret res_callee; }
            val res_callee_name: R.Result[R.Void, str] = emit_name(out, interner, site.callee);
            if (R.is_err[R.Void, str](res_callee_name)) { ret res_callee_name; }
            val res_loc: R.Result[R.Void, str] = emit_str(out, " loc=");
            if (R.is_err[R.Void, str](res_loc)) { ret res_loc; }
            val res_loc_value: R.Result[R.Void, str] = print_loc(out, site.call_loc);
            if (R.is_err[R.Void, str](res_loc_value)) { ret res_loc_value; }
            val res_parent: R.Result[R.Void, str] = emit_str(out, " parent=");
            if (R.is_err[R.Void, str](res_parent)) { ret res_parent; }
            val res_parent_value: R.Result[R.Void, str] = emit_u64(out, site.parent::u64);
            if (R.is_err[R.Void, str](res_parent_value)) { ret res_parent_value; }
            val res_close: R.Result[R.Void, str] = emit_str(out, "}\n");
            if (R.is_err[R.Void, str](res_close)) { ret res_close; }
            i = i + 1;
        }
        val res_close: R.Result[R.Void, str] = emit_str(out, "    }\n");
        if (R.is_err[R.Void, str](res_close)) { ret res_close; }
    }
    ret R.ok_void[str]();
}

pub fun print_value(out: *writer.Writer, m: *ir.Module, v: *value.Value, interner: *intern.Interner) R.Result[R.Void, str] {
    if (v.secret) {
        val res_secret: R.Result[R.Void, str] = emit_str(out, "~");
        if (R.is_err[R.Void, str](res_secret)) { ret res_secret; }
    }
    val res_payload: R.Result[R.Void, str] = print_value_payload(out, m, v, interner);
    if (R.is_err[R.Void, str](res_payload)) { ret res_payload; }
    ret print_value_state(out, v);
}

fun print_value_state(out: *writer.Writer, v: *value.Value) R.Result[R.Void, str] {
    val res_kind: R.Result[R.Void, str] = emit_str(out, " {kind=");
    if (R.is_err[R.Void, str](res_kind)) { ret res_kind; }
    val res_kind_value: R.Result[R.Void, str] = emit_u64(out, v.kind::u64);
    if (R.is_err[R.Void, str](res_kind_value)) { ret res_kind_value; }
    val res_ty: R.Result[R.Void, str] = emit_str(out, " ty=");
    if (R.is_err[R.Void, str](res_ty)) { ret res_ty; }
    val res_ty_value: R.Result[R.Void, str] = print_type_ref(out, v.ty);
    if (R.is_err[R.Void, str](res_ty_value)) { ret res_ty_value; }
    val res_secret: R.Result[R.Void, str] = emit_str(out, " secret=");
    if (R.is_err[R.Void, str](res_secret)) { ret res_secret; }
    val res_secret_value: R.Result[R.Void, str] = print_bool(out, v.secret);
    if (R.is_err[R.Void, str](res_secret_value)) { ret res_secret_value; }
    ret emit_str(out, "}");
}

fun print_value_payload(out: *writer.Writer, m: *ir.Module, v: *value.Value, interner: *intern.Interner) R.Result[R.Void, str] {
    if (v.kind == value.VAL_INSTR) {
        val res_marker: R.Result[R.Void, str] = emit_str(out, "%");
        if (R.is_err[R.Void, str](res_marker)) { ret res_marker; }
        ret emit_u64(out, v.data.instr::u64);
    }
    if (v.kind == value.VAL_PARAM) {
        val res_marker: R.Result[R.Void, str] = emit_str(out, "%p");
        if (R.is_err[R.Void, str](res_marker)) { ret res_marker; }
        ret emit_u64(out, v.data.param_ix::u64);
    }
    if (v.kind == value.VAL_CONST_INT) {
        ret emit_u64(out, v.data.int_lit);
    }
    if (v.kind == value.VAL_CONST_FLOAT) {
        val res_tag: R.Result[R.Void, str] = emit_str(out, "f");
        if (R.is_err[R.Void, str](res_tag)) { ret res_tag; }
        val res_float: R.Result[R.Void, str] = emit_f64(out, v.data.float_lit);
        if (R.is_err[R.Void, str](res_float)) { ret res_float; }
        val res_bits: R.Result[R.Void, str] = emit_str(out, ":0x");
        if (R.is_err[R.Void, str](res_bits)) { ret res_bits; }
        ret emit_hex_u64(out, float.f64_bits(v.data.float_lit));
    }
    if (v.kind == value.VAL_CONST_NULL) {
        ret emit_str(out, "null");
    }
    if (v.kind == value.VAL_CONST_BYTES) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "bytes[0x");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        val res_bytes: R.Result[R.Void, str] = emit_bytes_hex(out, v.data.bytes.ptr, v.data.bytes.len);
        if (R.is_err[R.Void, str](res_bytes)) { ret res_bytes; }
        ret emit_str(out, "]");
    }
    if (v.kind == value.VAL_GLOBAL) {
        val res_sigil: R.Result[R.Void, str] = emit_str(out, "@");
        if (R.is_err[R.Void, str](res_sigil)) { ret res_sigil; }
        if (v.data.global_ix < m.global_len) {
            val res_name: R.Result[R.Void, str] = emit_name(out, interner, m.globals[v.data.global_ix].name);
            if (R.is_err[R.Void, str](res_name)) { ret res_name; }
        }
        or {
            val res_index: R.Result[R.Void, str] = emit_u64(out, v.data.global_ix::u64);
            if (R.is_err[R.Void, str](res_index)) { ret res_index; }
        }
        val res_index_open: R.Result[R.Void, str] = emit_str(out, "[global=");
        if (R.is_err[R.Void, str](res_index_open)) { ret res_index_open; }
        val res_index: R.Result[R.Void, str] = emit_u64(out, v.data.global_ix::u64);
        if (R.is_err[R.Void, str](res_index)) { ret res_index; }
        ret emit_str(out, "]");
    }
    if (v.kind == value.VAL_FN) {
        val res_sigil: R.Result[R.Void, str] = emit_str(out, "@");
        if (R.is_err[R.Void, str](res_sigil)) { ret res_sigil; }
        if (v.data.fn_ix < m.function_len) {
            val res_name: R.Result[R.Void, str] = emit_name(out, interner, m.functions[v.data.fn_ix].name);
            if (R.is_err[R.Void, str](res_name)) { ret res_name; }
        }
        or {
            val res_index: R.Result[R.Void, str] = emit_u64(out, v.data.fn_ix::u64);
            if (R.is_err[R.Void, str](res_index)) { ret res_index; }
        }
        val res_index_open: R.Result[R.Void, str] = emit_str(out, "[fn=");
        if (R.is_err[R.Void, str](res_index_open)) { ret res_index_open; }
        val res_index: R.Result[R.Void, str] = emit_u64(out, v.data.fn_ix::u64);
        if (R.is_err[R.Void, str](res_index)) { ret res_index; }
        ret emit_str(out, "]");
    }
    if (v.kind == value.VAL_CONST_AGG) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "agg{bytes=0x");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        val res_bytes: R.Result[R.Void, str] = emit_bytes_hex(out, v.data.agg.bytes, v.data.agg.len);
        if (R.is_err[R.Void, str](res_bytes)) { ret res_bytes; }
        val res_relocs: R.Result[R.Void, str] = emit_str(out, ", relocs=[");
        if (R.is_err[R.Void, str](res_relocs)) { ret res_relocs; }
        var i: u32 = 0;
        for (i < v.data.agg.reloc_count) {
            if (i > 0) {
                val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
                if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
            }
            val reloc: *value.AggReloc = ?v.data.agg.relocs[i];
            val res_reloc_open: R.Result[R.Void, str] = emit_str(out, "{offset=");
            if (R.is_err[R.Void, str](res_reloc_open)) { ret res_reloc_open; }
            val res_offset: R.Result[R.Void, str] = emit_u64(out, reloc.offset::u64);
            if (R.is_err[R.Void, str](res_offset)) { ret res_offset; }
            val res_symbol: R.Result[R.Void, str] = emit_str(out, ", symbol=");
            if (R.is_err[R.Void, str](res_symbol)) { ret res_symbol; }
            val res_name: R.Result[R.Void, str] = emit_name(out, interner, reloc.symbol);
            if (R.is_err[R.Void, str](res_name)) { ret res_name; }
            val res_addend: R.Result[R.Void, str] = emit_str(out, ", addend=");
            if (R.is_err[R.Void, str](res_addend)) { ret res_addend; }
            val res_addend_value: R.Result[R.Void, str] = emit_i64(out, reloc.addend);
            if (R.is_err[R.Void, str](res_addend_value)) { ret res_addend_value; }
            var fn_text: str = "false";
            if (reloc.is_fn) { fn_text = "true"; }
            val res_fn: R.Result[R.Void, str] = emit_str(out, ", fn=");
            if (R.is_err[R.Void, str](res_fn)) { ret res_fn; }
            val res_fn_value: R.Result[R.Void, str] = emit_str(out, fn_text);
            if (R.is_err[R.Void, str](res_fn_value)) { ret res_fn_value; }
            val res_reloc_close: R.Result[R.Void, str] = emit_str(out, "}");
            if (R.is_err[R.Void, str](res_reloc_close)) { ret res_reloc_close; }
            i = i + 1;
        }
        ret emit_str(out, "]}");
    }
    val res_open: R.Result[R.Void, str] = emit_str(out, "<?value:");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    val res_kind: R.Result[R.Void, str] = emit_u64(out, v.kind::u64);
    if (R.is_err[R.Void, str](res_kind)) { ret res_kind; }
    ret emit_str(out, ">");
}

pub fun print_type(out: *writer.Writer, m: *ir.Module, tid: type.IrTypeId) R.Result[R.Void, str] {
    val opt_type: O.Option[*type.IrType] = type.get(?m.types, tid);
    if (O.is_none[*type.IrType](opt_type)) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "<?type:");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        val res_id: R.Result[R.Void, str] = emit_u64(out, tid::u64);
        if (R.is_err[R.Void, str](res_id)) { ret res_id; }
        ret emit_str(out, ">");
    }
    val t: *type.IrType = O.unwrap[*type.IrType](opt_type);

    if (t.kind == type.IRT_VOID) { ret emit_str(out, "void"); }
    if (t.kind == type.IRT_INT) {
        val res_tag: R.Result[R.Void, str] = emit_str(out, "i");
        if (R.is_err[R.Void, str](res_tag)) { ret res_tag; }
        ret emit_u64(out, t.data.bits::u64);
    }
    if (t.kind == type.IRT_FLOAT) {
        val res_tag: R.Result[R.Void, str] = emit_str(out, "f");
        if (R.is_err[R.Void, str](res_tag)) { ret res_tag; }
        ret emit_u64(out, t.data.bits::u64);
    }
    if (t.kind == type.IRT_PTR) { ret emit_str(out, "ptr"); }
    if (t.kind == type.IRT_ARRAY) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "[");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        val res_len: R.Result[R.Void, str] = emit_u64(out, type.array_count(?m.types, tid)::u64);
        if (R.is_err[R.Void, str](res_len)) { ret res_len; }
        val res_close: R.Result[R.Void, str] = emit_str(out, "]");
        if (R.is_err[R.Void, str](res_close)) { ret res_close; }
        ret print_type_ref(out, t.data.array_.element);
    }
    if (t.kind == type.IRT_VECTOR) {
        val res_elem: R.Result[R.Void, str] = print_type_ref(out, t.data.vector_.element);
        if (R.is_err[R.Void, str](res_elem)) { ret res_elem; }
        val res_x: R.Result[R.Void, str] = emit_str(out, "x");
        if (R.is_err[R.Void, str](res_x)) { ret res_x; }
        ret emit_u64(out, t.data.vector_.lanes::u64);
    }
    if (t.kind == type.IRT_HANDLE) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "handle<");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        val res_ctor: R.Result[R.Void, str] = emit_u64(out, t.data.handle_.ctor::u64);
        if (R.is_err[R.Void, str](res_ctor)) { ret res_ctor; }
        var wi: u32 = 0;
        for (wi < t.data.handle_.count) {
            val rs: R.Result[R.Void, str] = emit_str(out, " ");
            if (R.is_err[R.Void, str](rs)) { ret rs; }
            val rw: R.Result[R.Void, str] = print_type_ref(out, t.data.handle_.operands[wi]);
            if (R.is_err[R.Void, str](rw)) { ret rw; }
            wi = wi + 1;
        }
        ret emit_str(out, ">");
    }
    if (t.kind == type.IRT_STRUCT || t.kind == type.IRT_UNION) {
        var open: str = "{";
        if (t.kind == type.IRT_UNION) { open = "uni{"; }
        val res_open: R.Result[R.Void, str] = emit_str(out, open);
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        var i: u32 = 0;
        for (i < t.data.struct_.field_count) {
            if (i > 0) {
                val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
                if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
            }
            val res_field: R.Result[R.Void, str] = print_type_ref(out, t.data.struct_.fields[i]);
            if (R.is_err[R.Void, str](res_field)) { ret res_field; }
            i = i + 1;
        }
        val res_close: R.Result[R.Void, str] = emit_str(out, "}[align=");
        if (R.is_err[R.Void, str](res_close)) { ret res_close; }
        val res_align: R.Result[R.Void, str] = emit_u64(out, t.data.struct_.align::u64);
        if (R.is_err[R.Void, str](res_align)) { ret res_align; }
        var packed: str = "false";
        if (t.data.struct_.packed) { packed = "true"; }
        val res_packed: R.Result[R.Void, str] = emit_str(out, " packed=");
        if (R.is_err[R.Void, str](res_packed)) { ret res_packed; }
        val res_packed_value: R.Result[R.Void, str] = emit_str(out, packed);
        if (R.is_err[R.Void, str](res_packed_value)) { ret res_packed_value; }
        ret emit_str(out, "]");
    }
    if (t.kind == type.IRT_FN) {
        val res_open: R.Result[R.Void, str] = emit_str(out, "fn(");
        if (R.is_err[R.Void, str](res_open)) { ret res_open; }
        var i: u32 = 0;
        for (i < t.data.fn.param_count) {
            if (i > 0) {
                val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
                if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
            }
            val res_param: R.Result[R.Void, str] = print_type_ref(out, t.data.fn.params[i]);
            if (R.is_err[R.Void, str](res_param)) { ret res_param; }
            i = i + 1;
        }
        if (t.data.fn.variadic) {
            if (t.data.fn.param_count > 0) {
                val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
                if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
            }
            val res_variadic: R.Result[R.Void, str] = emit_str(out, "...");
            if (R.is_err[R.Void, str](res_variadic)) { ret res_variadic; }
        }
        val res_arrow: R.Result[R.Void, str] = emit_str(out, ") -> ");
        if (R.is_err[R.Void, str](res_arrow)) { ret res_arrow; }
        ret print_type_ref(out, t.data.fn.ret_type);
    }
    val res_unknown: R.Result[R.Void, str] = emit_str(out, "<?type:kind=");
    if (R.is_err[R.Void, str](res_unknown)) { ret res_unknown; }
    val res_kind: R.Result[R.Void, str] = emit_u64(out, t.kind::u64);
    if (R.is_err[R.Void, str](res_kind)) { ret res_kind; }
    ret emit_str(out, ">");
}

fun print_instruction_id(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, interner: *intern.Interner) R.Result[R.Void, str] {
    val opt_ins: O.Option[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (O.is_some[*instruction.Instruction](opt_ins)) {
        ret print_instruction(out, m, fn, O.unwrap[*instruction.Instruction](opt_ins), iid, interner);
    }
    val res_open: R.Result[R.Void, str] = emit_str(out, "      <dangling %");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    val res_id: R.Result[R.Void, str] = emit_u64(out, iid::u64);
    if (R.is_err[R.Void, str](res_id)) { ret res_id; }
    ret emit_str(out, ">\n");
}

fun print_operands(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, ins: *instruction.Instruction, interner: *intern.Interner) R.Result[R.Void, str] {
    if (ins.operand_count == 0) { ret R.ok_void[str](); }

    var i: u32 = 0;
    for (i < ins.operand_count) {
        if (i == 0) {
            val res_space: R.Result[R.Void, str] = emit_str(out, " ");
            if (R.is_err[R.Void, str](res_space)) { ret res_space; }
        }
        or {
            val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
            if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
        }
        val op: *value.Value = ?ins.operands[i];
        val is_target: bool = ins.kind == instruction.OP_BR || (ins.kind == instruction.OP_CBR && i >= 1);
        if (is_target && op.kind == value.VAL_CONST_INT) {
            val res_bb: R.Result[R.Void, str] = emit_str(out, "bb");
            if (R.is_err[R.Void, str](res_bb)) { ret res_bb; }
            val res_id: R.Result[R.Void, str] = emit_u64(out, op.data.int_lit);
            if (R.is_err[R.Void, str](res_id)) { ret res_id; }
            val res_state: R.Result[R.Void, str] = print_value_state(out, op);
            if (R.is_err[R.Void, str](res_state)) { ret res_state; }
        }
        or {
            val res_op: R.Result[R.Void, str] = print_operand(out, m, op, interner);
            if (R.is_err[R.Void, str](res_op)) { ret res_op; }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun print_operand(out: *writer.Writer, m: *ir.Module, v: *value.Value, interner: *intern.Interner) R.Result[R.Void, str] {
    ret print_value(out, m, v, interner);
}

fun print_phi_operands(out: *writer.Writer, m: *ir.Module, fn: *ir.Function, ins: *instruction.Instruction, interner: *intern.Interner) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, " [");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }

    var i: u32 = 0;
    for (i + 1 < ins.operand_count) {
        if (i > 0) {
            val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
            if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
        }
        val blk_op: *value.Value = ?ins.operands[i];
        val res_bb: R.Result[R.Void, str] = emit_str(out, "bb");
        if (R.is_err[R.Void, str](res_bb)) { ret res_bb; }
        val res_id: R.Result[R.Void, str] = emit_u64(out, blk_op.data.int_lit);
        if (R.is_err[R.Void, str](res_id)) { ret res_id; }
        val res_blk_state: R.Result[R.Void, str] = print_value_state(out, blk_op);
        if (R.is_err[R.Void, str](res_blk_state)) { ret res_blk_state; }
        val res_space: R.Result[R.Void, str] = emit_str(out, " ");
        if (R.is_err[R.Void, str](res_space)) { ret res_space; }
        val res_val: R.Result[R.Void, str] = print_operand(out, m, ?ins.operands[i + 1], interner);
        if (R.is_err[R.Void, str](res_val)) { ret res_val; }
        i = i + 2;
    }
    ret emit_str(out, "]");
}

fun print_signature_params(out: *writer.Writer, m: *ir.Module, sig: type.IrTypeId) R.Result[R.Void, str] {
    val opt_type: O.Option[*type.IrType] = type.get(?m.types, sig);
    if (O.is_none[*type.IrType](opt_type)) { ret R.ok_void[str](); }
    val t: *type.IrType = O.unwrap[*type.IrType](opt_type);
    if (t.kind != type.IRT_FN) { ret R.ok_void[str](); }

    var i: u32 = 0;
    for (i < t.data.fn.param_count) {
        if (i > 0) {
            val res_sep: R.Result[R.Void, str] = emit_str(out, ", ");
            if (R.is_err[R.Void, str](res_sep)) { ret res_sep; }
        }
        val res_ty: R.Result[R.Void, str] = print_type_ref(out, t.data.fn.params[i]);
        if (R.is_err[R.Void, str](res_ty)) { ret res_ty; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun print_signature_ret(out: *writer.Writer, m: *ir.Module, sig: type.IrTypeId) R.Result[R.Void, str] {
    val opt_type: O.Option[*type.IrType] = type.get(?m.types, sig);
    if (O.is_some[*type.IrType](opt_type)) {
        val t: *type.IrType = O.unwrap[*type.IrType](opt_type);
        if (t.kind == type.IRT_FN) {
            ret print_type_ref(out, t.data.fn.ret_type);
        }
    }
    ret emit_str(out, "void");
}

fun print_flag_suffixes(out: *writer.Writer, flags: u16, secret: bool) R.Result[R.Void, str] {
    if ((flags & instruction.INSTR_FLAG_NSW) != 0) {
        val res: R.Result[R.Void, str] = emit_str(out, ".nsw");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((flags & instruction.INSTR_FLAG_NUW) != 0) {
        val res: R.Result[R.Void, str] = emit_str(out, ".nuw");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((flags & instruction.INSTR_FLAG_EXACT) != 0) {
        val res: R.Result[R.Void, str] = emit_str(out, ".exact");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if ((flags & instruction.INSTR_FLAG_VOLATILE) != 0) {
        val res: R.Result[R.Void, str] = emit_str(out, ".volatile");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    if (secret) {
        val res: R.Result[R.Void, str] = emit_str(out, ".secret");
        if (R.is_err[R.Void, str](res)) { ret res; }
    }
    ret R.ok_void[str]();
}

fun produces_value(k: instruction.InstrKind) bool {
    ret opdesc.produces_value(k);
}

fun opcode_name(k: instruction.InstrKind) str {
    ret opdesc.name(k);
}


fun emit_str(out: *writer.Writer, s: str) R.Result[R.Void, str] {
    val res: R.Result[usize, str] = format.write_str(out, s);
    if (R.is_err[usize, str](res)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](res)); }
    ret R.ok_void[str]();
}

fun emit_u64(out: *writer.Writer, n: u64) R.Result[R.Void, str] {
    val res: R.Result[usize, str] = format.write_u64(out, n);
    if (R.is_err[usize, str](res)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](res)); }
    ret R.ok_void[str]();
}

fun emit_i64(out: *writer.Writer, n: i64) R.Result[R.Void, str] {
    val res: R.Result[usize, str] = format.write_i64(out, n);
    if (R.is_err[usize, str](res)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](res)); }
    ret R.ok_void[str]();
}

fun emit_hex_u64(out: *writer.Writer, n: u64) R.Result[R.Void, str] {
    val res: R.Result[usize, str] = format.write_hex_u64(out, n, false);
    if (R.is_err[usize, str](res)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](res)); }
    ret R.ok_void[str]();
}

fun emit_bytes_hex(out: *writer.Writer, bytes: *u8, len: u32) R.Result[R.Void, str] {
    if (bytes == nil && len > 0) { ret emit_str(out, "<nil>"); }
    val digits: str = "0123456789abcdef";
    var pair: [3]u8;
    pair[2] = 0;
    var i: u32 = 0;
    for (i < len) {
        pair[0] = digits[(bytes[i] >> 4)::usize];
        pair[1] = digits[(bytes[i] & 0x0F)::usize];
        val res: R.Result[R.Void, str] = emit_str(out, (?pair[0])::str);
        if (R.is_err[R.Void, str](res)) { ret res; }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun emit_f64(out: *writer.Writer, f: f64) R.Result[R.Void, str] {
    val bits: u64 = float.f64_bits(f);
    if (((bits >> 52) & 0x7FF) == 0x7FF && (bits & 0xFFFFFFFFFFFFF) != 0) {
        ret emit_str(out, "nan");
    }
    val res: R.Result[usize, str] = format.write_f64(out, f);
    if (R.is_err[usize, str](res)) { ret R.err[R.Void, str](R.unwrap_err[usize, str](res)); }
    ret R.ok_void[str]();
}

fun emit_escaped(out: *writer.Writer, s: str) R.Result[R.Void, str] {
    val digits: str = "0123456789abcdef";
    val n: usize = str_len(s);
    var i: usize = 0;
    for (i < n) {
        val b: u8 = s[i];
        var fixed: str = nil;
        if (b == '"')      { fixed = "\\\""; }
        or (b == '\\')    { fixed = "\\\\"; }
        or (b == '\n')    { fixed = "\\n"; }
        or (b == '\r')    { fixed = "\\r"; }
        or (b == '\t')    { fixed = "\\t"; }
        if (fixed != nil) {
            val res_fixed: R.Result[R.Void, str] = emit_str(out, fixed);
            if (R.is_err[R.Void, str](res_fixed)) { ret res_fixed; }
        }
        or (b >= 0x20 && b <= 0x7E) {
            var one: [2]u8;
            one[0] = b;
            one[1] = 0;
            val res_one: R.Result[R.Void, str] = emit_str(out, (?one[0])::str);
            if (R.is_err[R.Void, str](res_one)) { ret res_one; }
        }
        or {
            var hex: [5]u8;
            hex[0] = '\\';
            hex[1] = 'x';
            hex[2] = digits[(b >> 4)::usize];
            hex[3] = digits[(b & 0x0F)::usize];
            hex[4] = 0;
            val res_hex: R.Result[R.Void, str] = emit_str(out, (?hex[0])::str);
            if (R.is_err[R.Void, str](res_hex)) { ret res_hex; }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun emit_quoted(out: *writer.Writer, s: str) R.Result[R.Void, str] {
    val res_open: R.Result[R.Void, str] = emit_str(out, "\"");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    val res_value: R.Result[R.Void, str] = emit_escaped(out, s);
    if (R.is_err[R.Void, str](res_value)) { ret res_value; }
    ret emit_str(out, "\"");
}

fun emit_name(out: *writer.Writer, interner: *intern.Interner, name_id: intern.StrId) R.Result[R.Void, str] {
    val opt_name: O.Option[str] = intern.lookup(interner, name_id);
    if (O.is_some[str](opt_name)) {
        ret emit_quoted(out, O.unwrap[str](opt_name));
    }
    val res_open: R.Result[R.Void, str] = emit_str(out, "<name#");
    if (R.is_err[R.Void, str](res_open)) { ret res_open; }
    val res_id: R.Result[R.Void, str] = emit_u64(out, name_id::u64);
    if (R.is_err[R.Void, str](res_id)) { ret res_id; }
    ret emit_str(out, ">");
}

var test_sink_buf: [32768]u8;
var test_sink_len: usize = 0;

fun test_sink_write(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    var i: usize = 0;
    for (i < len) {
        if (test_sink_len < 32767) {
            test_sink_buf[test_sink_len] = buf[i];
            test_sink_len = test_sink_len + 1;
        }
        i = i + 1;
    }
    ret R.ok[usize, str](len);
}

fun float_renders_as(m: *ir.Module, f: f64, ty: type.IrTypeId, want: str) i32 {
    test_sink_len = 0;
    var w: writer.Writer;
    w.ctx     = nil;
    w.f_write = test_sink_write;
    var v: value.Value = value.const_float(f, ty);
    if (R.is_err[R.Void, str](print_value(?w, m, ?v, nil))) { ret 1; }
    test_sink_buf[test_sink_len] = 0;
    if (!str_equals((?test_sink_buf[0])::str, want)) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_value:float_rendering" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_module: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_module)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);
    val res_ty: R.Result[type.IrTypeId, str] = type.intern_float(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_ty)) { ret 1; }
    val ty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_ty);

    val pos_inf: f64 = float.bits_f64(0x7FF0000000000000);
    val neg_inf: f64 = float.f64_neg(pos_inf);
    val two_63:  f64 = float.bits_f64(0x43E0000000000000);
    val denorm:  f64 = float.bits_f64(1);
    val qnan:    f64 = float.bits_f64(0x7FF8000000000000);
    val pnan:    f64 = float.bits_f64(0x7FF8000000000001);

    var bad: i32 = 0;
    bad = bad | float_renders_as(?m, -0.0, ty, "f-0:0x8000000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 0.0, ty, "f0:0x0 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 1.5, ty, "f1.5:0x3ff8000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 1.75, ty, "f1.75:0x3ffc000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, -1.5, ty, "f-1.5:0xbff8000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, 2.5, ty, "f2.5:0x4004000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, pos_inf, ty, "finf:0x7ff0000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, neg_inf, ty, "f-inf:0xfff0000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, two_63, ty, "f9.223372036854776e18:0x43e0000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, denorm, ty, "f5e-324:0x1 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, qnan, ty, "fnan:0x7ff8000000000000 {kind=3 ty=!0 secret=false}");
    bad = bad | float_renders_as(?m, pnan, ty, "fnan:0x7ff8000000000001 {kind=3 ty=!0 secret=false}");
    ret bad;
}

fun capture_reset() {
    test_sink_len = 0;
}

fun capture_into(dst: *u8) {
    var i: usize = 0;
    for (i < test_sink_len) { dst[i] = test_sink_buf[i]; i = i + 1; }
    dst[test_sink_len] = 0;
}

fun capture_value_into(w: *writer.Writer, m: *ir.Module, v: *value.Value,
                       itn: *intern.Interner, dst: *u8) bool {
    capture_reset();
    if (R.is_err[R.Void, str](print_value(w, m, v, itn))) { ret false; }
    capture_into(dst);
    ret true;
}

fun capture_debug_into(w: *writer.Writer, m: *ir.Module, itn: *intern.Interner,
                       context: IrDebugContext, dst: *u8) bool {
    capture_reset();
    var d: IrDebugWriter = debug_writer(w, m, itn, context);
    if (R.is_err[R.Void, str](write_debug(?d))) { ret false; }
    capture_into(dst);
    ret true;
}

fun debug_differs(w: *writer.Writer, m: *ir.Module, itn: *intern.Interner,
                  context: IrDebugContext, baseline: str) bool {
    var candidate: [32768]u8;
    if (!capture_debug_into(w, m, itn, context, ?candidate[0])) { ret false; }
    ret !str_equals(baseline, (?candidate[0])::str);
}

fun test_instruction(k: instruction.InstrKind, ty: type.IrTypeId) instruction.Instruction {
    var ins: instruction.Instruction;
    ins.kind = k;
    ins.ty = ty;
    ins.operands = nil;
    ins.operand_count = 0;
    ins.operand_cap = 0;
    ins.flags = 0;
    ins.aux_ty = type.IRT_NIL;
    ins.loc = source.loc_nil();
    ins.secret = false;
    ret ins;
}

fun test_error_write(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    ret R.err[usize, str]("writer refused");
}

fun test_stall_write(ctx: ptr, buf: *u8, len: usize) R.Result[usize, str] {
    ret R.ok[usize, str](0);
}

test "mach.lang.me.ir.printer.print_value:constant_payload_fields_are_independently_distinct" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    var itn: intern.Interner = intern.init(?alloc);
    val rsa: R.Result[intern.StrId, str] = intern.intern(?itn, "symbol_a");
    val rsb: R.Result[intern.StrId, str] = intern.intern(?itn, "symbol_b");
    if (R.is_err[intern.StrId, str](rsa) || R.is_err[intern.StrId, str](rsb)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;
    var bytes_a: [2]u8;
    bytes_a[0] = 0x12; bytes_a[1] = 0x34;
    var bytes_b: [2]u8 = bytes_a;
    bytes_b[1] = 0x35;
    var base_reloc: value.AggReloc;
    base_reloc.offset = 4;
    base_reloc.symbol = R.unwrap_ok[intern.StrId, str](rsa);
    base_reloc.addend = -2;
    base_reloc.is_fn = false;

    var base: value.Value = value.const_agg(?bytes_a[0], 2, ?base_reloc, 1, 1, i64t);
    var changed_bytes: value.Value = value.const_agg(?bytes_b[0], 2, ?base_reloc, 1, 1, i64t);
    var changed_reloc: value.AggReloc = base_reloc;
    var candidate: value.Value;
    var base_text: [256]u8;
    var candidate_text: [256]u8;
    if (!capture_value_into(?w, ?m, ?base, ?itn, ?base_text[0])) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    if (!capture_value_into(?w, ?m, ?changed_bytes, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }

    changed_reloc.offset = 5;
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    changed_reloc = base_reloc;
    changed_reloc.symbol = R.unwrap_ok[intern.StrId, str](rsb);
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    changed_reloc = base_reloc;
    changed_reloc.addend = -3;
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }
    changed_reloc = base_reloc;
    changed_reloc.is_fn = true;
    candidate = value.const_agg(?bytes_a[0], 2, ?changed_reloc, 1, 1, i64t);
    if (!capture_value_into(?w, ?m, ?candidate, ?itn, ?candidate_text[0])
        || str_equals((?base_text[0])::str, (?candidate_text[0])::str)) {
        intern.dnit(?itn); ir.dnit(?m); ret 1;
    }

    intern.dnit(?itn);
    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.printer.print_value:secret_operand_is_not_indistinguishable_from_a_plain_one" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);

    var plain: value.Value = value.const_int(9, i64t);
    var secret: value.Value = value.const_int(9, i64t);
    secret.secret = true;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;

    capture_reset();
    if (R.is_err[R.Void, str](print_value(?w, ?m, ?plain, nil))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    capture_reset();
    if (R.is_err[R.Void, str](print_value(?w, ?m, ?secret, nil))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    ir.dnit(?m);
    val plain_text:  str = (?buf_a[0])::str;
    val secret_text: str = (?buf_b[0])::str;
    if (str_equals(plain_text, secret_text)) { ret 1; }
    if (str_contains(plain_text, "~")) { ret 1; }
    if (str_contains(secret_text, "~") == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_instruction:secret_result_is_not_indistinguishable_from_a_plain_one" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](r_fn)];

    var plain: instruction.Instruction;
    plain.kind          = instruction.OP_NEG;
    plain.ty             = i64t;
    plain.operands       = nil;
    plain.operand_count = 0;
    plain.operand_cap   = 0;
    plain.flags          = 0;
    plain.aux_ty         = type.IRT_NIL;
    plain.loc            = source.loc_nil();
    plain.secret         = false;

    var secret: instruction.Instruction = plain;
    secret.secret = true;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;

    capture_reset();
    if (R.is_err[R.Void, str](print_instruction(?w, ?m, fn, ?plain, 0::id.InstructionId, nil))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    capture_reset();
    if (R.is_err[R.Void, str](print_instruction(?w, ?m, fn, ?secret, 0::id.InstructionId, nil))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    ir.dnit(?m);
    val plain_text:  str = (?buf_a[0])::str;
    val secret_text: str = (?buf_b[0])::str;
    if (str_equals(plain_text, secret_text)) { ret 1; }
    if (str_contains(secret_text, ".secret") == false) { ret 1; }
    if (str_contains(plain_text, ".secret")) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_global:linkage_and_alignment_are_not_indistinguishable" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);

    var itn: intern.Interner = intern.init(?alloc);

    var g: *ir.Global = ?m.globals[0];
    g.name      = intern.STR_NIL;
    g.ty        = i64t;
    g.init      = value.const_int(0, i64t);
    g.is_mut    = false;
    g.is_pub    = false;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = false;
    g.is_embed  = false;
    g.align     = 8;
    g.section   = intern.STR_NIL;
    g.iface     = ir.IFACE_NONE;
    g.iface_a   = 0;
    g.iface_b   = 0;
    g.iface_flags = 0;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;

    capture_reset();
    if (R.is_err[R.Void, str](print_global(?w, ?m, g, ?itn))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    g.is_pub = true;
    g.is_extern = true;
    g.align = 16;
    capture_reset();
    if (R.is_err[R.Void, str](print_global(?w, ?m, g, ?itn))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    ir.dnit(?m);
    val a_text: str = (?buf_a[0])::str;
    val b_text: str = (?buf_b[0])::str;
    if (str_equals(a_text, b_text)) { ret 1; }
    if (str_contains(a_text, "pub") || str_contains(a_text, "extern")) { ret 1; }
    if (str_contains(b_text, "pub") == false || str_contains(b_text, "extern") == false) { ret 1; }
    if (str_contains(a_text, "align=8") == false) { ret 1; }
    if (str_contains(b_text, "align=16") == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.print_function:flags_are_not_indistinguishable" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);
    val r_a: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](r_a)) { ir.dnit(?m); ret 1; }
    val a_ix: u32 = R.unwrap_ok[u32, str](r_a);
    var itn: intern.Interner = intern.init(?alloc);
    val r_b: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, type.IRT_NIL, ir.FN_FLAG_INLINE | ir.FN_FLAG_NOINLINE);
    if (R.is_err[u32, str](r_b)) { ir.dnit(?m); ret 1; }
    val b_ix: u32 = R.unwrap_ok[u32, str](r_b);
    val a_fn: *ir.Function = ?m.functions[a_ix];
    val b_fn: *ir.Function = ?m.functions[b_ix];
    a_fn.flags = 0;
    a_fn.block_count = 0;
    b_fn.block_count = 0;

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;

    var buf_a: [256]u8;
    var buf_b: [256]u8;
    var buf_c: [256]u8;

    capture_reset();
    if (R.is_err[R.Void, str](print_function(?w, ?m, a_fn, ?itn))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_a[0]);

    capture_reset();
    if (R.is_err[R.Void, str](print_function(?w, ?m, b_fn, ?itn))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_b[0]);

    a_fn.is_import = true;
    capture_reset();
    if (R.is_err[R.Void, str](print_function(?w, ?m, a_fn, ?itn))) { ir.dnit(?m); ret 1; }
    capture_into(?buf_c[0]);

    ir.dnit(?m);
    val a_text: str = (?buf_a[0])::str;
    val b_text: str = (?buf_b[0])::str;
    val c_text: str = (?buf_c[0])::str;
    if (str_equals(a_text, b_text)) { ret 1; }
    if (str_equals(a_text, c_text)) { ret 1; }
    if (str_contains(a_text, "inline") || str_contains(a_text, "noinline")) { ret 1; }
    if (str_contains(b_text, "inline") == false || str_contains(b_text, "noinline") == false) { ret 1; }
    if (str_contains(a_text, "import")) { ret 1; }
    if (str_contains(c_text, "import") == false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.IrDebugWriter:context_state_and_output_are_deterministic" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    val rn: R.Result[intern.StrId, str] = intern.intern(?itn, "pkg.module");
    if (R.is_err[intern.StrId, str](rn)) { intern.dnit(?itn); ret 1; }
    val rm: R.Result[ir.Module, str] = ir.init(?alloc, R.unwrap_ok[intern.StrId, str](rn));
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    val rf: R.Result[u32, str] = ir.function_add(?m, R.unwrap_ok[intern.StrId, str](rn), type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;
    val context: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                 "linux", "sysv64", "elf");
    var first: [32768]u8;
    var second: [32768]u8;
    if (!capture_debug_into(?w, ?m, ?itn, context, ?first[0])
        || !capture_debug_into(?w, ?m, ?itn, context, ?second[0])) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val baseline: str = (?first[0])::str;
    if (!str_equals(baseline, (?second[0])::str)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (!str_contains(baseline, "ir-debug stage=\"post-codegen\" target=\"native\" isa=\"x86_64\" os=\"linux\" abi=\"sysv64\" of=\"elf\"")) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val stage_changed: IrDebugContext = debug_context("post-lower", "native", "x86_64",
                                                       "linux", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, stage_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val target_changed: IrDebugContext = debug_context("post-codegen", "cross", "x86_64",
                                                        "linux", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, target_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val isa_changed: IrDebugContext = debug_context("post-codegen", "native", "aarch64",
                                                     "linux", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, isa_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val os_changed: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                    "windows", "sysv64", "elf");
    if (!debug_differs(?w, ?m, ?itn, os_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val abi_changed: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                     "linux", "win64", "elf");
    if (!debug_differs(?w, ?m, ?itn, abi_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val of_changed: IrDebugContext = debug_context("post-codegen", "native", "x86_64",
                                                    "linux", "sysv64", "coff");
    if (!debug_differs(?w, ?m, ?itn, of_changed, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    m.init_fn = O.some[u32](0);
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    m.init_fn = O.none[u32]();
    m.vector_ops_scalarized = 1;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret 0;
}

test "mach.lang.me.ir.printer.IrDebugWriter:names_and_context_strings_are_escaped" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    val rn: R.Result[intern.StrId, str] = intern.intern(?itn, "a\"b\\c\nd\te");
    if (R.is_err[intern.StrId, str](rn)) { intern.dnit(?itn); ret 1; }
    val rm: R.Result[ir.Module, str] = ir.init(?alloc, R.unwrap_ok[intern.StrId, str](rn));
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    val rf: R.Result[u32, str] = ir.function_add(?m, R.unwrap_ok[intern.StrId, str](rn), type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var control: [3]u8;
    control[0] = 'q';
    control[1] = 1;
    control[2] = 0;
    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;
    val context: IrDebugContext = debug_context((?control[0])::str, "t", "i", "o", "a", "f");
    var text_buf: [32768]u8;
    if (!capture_debug_into(?w, ?m, ?itn, context, ?text_buf[0])) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val rendered: str = (?text_buf[0])::str;
    var bad: i32 = 0;
    if (!str_contains(rendered, "stage=\"q\\x01\"")) { bad = 1; }
    if (!str_contains(rendered, "\"a\\\"b\\\\c\\nd\\te\"")) { bad = 1; }
    ir.dnit(?m);
    intern.dnit(?itn);
    ret bad;
}

test "mach.lang.me.ir.printer.IrDebugWriter:writer_errors_are_propagated" {
    val context: IrDebugContext = debug_context("s", "t", "i", "o", "a", "f");
    var failed: writer.Writer;
    failed.ctx = nil;
    failed.f_write = test_error_write;
    var d: IrDebugWriter = debug_writer(?failed, nil, nil, context);
    val rf: R.Result[R.Void, str] = write_debug(?d);
    if (!R.is_err[R.Void, str](rf)) { ret 1; }
    if (!str_equals(R.unwrap_err[R.Void, str](rf), "writer refused")) { ret 1; }

    var stalled: writer.Writer;
    stalled.ctx = nil;
    stalled.f_write = test_stall_write;
    d = debug_writer(?stalled, nil, nil, context);
    val stalled_r: R.Result[R.Void, str] = write_debug(?d);
    if (!R.is_err[R.Void, str](stalled_r)) { ret 1; }
    if (!str_equals(R.unwrap_err[R.Void, str](stalled_r), writer.ERR_SHORT_WRITE)) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.printer.IrDebugWriter:metadata_fields_are_independently_distinct" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    val rfn_name: R.Result[intern.StrId, str] = intern.intern(?itn, "fn");
    val risa: R.Result[intern.StrId, str] = intern.intern(?itn, "x86_64");
    val rbody: R.Result[intern.StrId, str] = intern.intern(?itn, "mov \"quoted\"");
    val rvar: R.Result[intern.StrId, str] = intern.intern(?itn, "local");
    val rcallee: R.Result[intern.StrId, str] = intern.intern(?itn, "callee");
    if (R.is_err[intern.StrId, str](rfn_name) || R.is_err[intern.StrId, str](risa)
        || R.is_err[intern.StrId, str](rbody) || R.is_err[intern.StrId, str](rvar)
        || R.is_err[intern.StrId, str](rcallee)) {
        intern.dnit(?itn); ret 1;
    }
    val fn_name: intern.StrId = R.unwrap_ok[intern.StrId, str](rfn_name);
    val isa_name: intern.StrId = R.unwrap_ok[intern.StrId, str](risa);
    val body_name: intern.StrId = R.unwrap_ok[intern.StrId, str](rbody);
    val var_name: intern.StrId = R.unwrap_ok[intern.StrId, str](rvar);
    val callee_name: intern.StrId = R.unwrap_ok[intern.StrId, str](rcallee);

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, fn_name);
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    val ri: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 32);
    val rr: R.Result[type.IrTypeId, str] = type.intern_float(?m.types, 32);
    if (R.is_err[type.IrTypeId, str](ri) || R.is_err[type.IrTypeId, str](rr)) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val ity: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](ri);
    val fty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rr);
    val rfn: R.Result[u32, str] = ir.function_add(?m, fn_name, type.IRT_NIL, 0);
    if (R.is_err[u32, str](rfn)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rfn)];
    val rasm_iid: R.Result[id.InstructionId, str] = ir.instruction_add(?m, fn, test_instruction(instruction.OP_ASM, ity));
    val rother_iid: R.Result[id.InstructionId, str] = ir.instruction_add(?m, fn, test_instruction(instruction.OP_NEG, ity));
    if (R.is_err[id.InstructionId, str](rasm_iid) || R.is_err[id.InstructionId, str](rother_iid)) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val iid: id.InstructionId = R.unwrap_ok[id.InstructionId, str](rasm_iid);
    val other_iid: id.InstructionId = R.unwrap_ok[id.InstructionId, str](rother_iid);

    var bind: ir.IrAsmBind;
    bind.name = var_name;
    bind.instr = other_iid;
    bind.secret = true;
    var asm_payload: ir.IrAsm;
    asm_payload.isa = isa_name;
    asm_payload.body = body_name;
    asm_payload.binds = ?bind;
    asm_payload.bind_count = 1;
    asm_payload.bind_cap = 0;
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.IrAsm](?fn.asm_blocks, iid, asm_payload))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }

    var dbg: ir.DbgVar;
    dbg.name = var_name;
    dbg.ty = ity;
    dbg.ty_sem = 7::semtype.TypeId;
    dbg.is_param = true;
    dbg.scope = 11;
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.DbgVar](?fn.dbg_vars, iid, dbg))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    var alloca_dbg: ir.DbgVar = dbg;
    alloca_dbg.name = callee_name;
    alloca_dbg.scope = 12;
    if (R.is_err[R.Void, str](ir.record_alloca_dbg_var(fn, iid, alloca_dbg))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }

    val reid: R.Result[ir.DbgExprId, str] = ir.dbg_expr_new(?m, fn, iid);
    if (R.is_err[ir.DbgExprId, str](reid)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val eid: ir.DbgExprId = R.unwrap_ok[ir.DbgExprId, str](reid);
    var dbg_op: ir.DbgOp;
    dbg_op.op = ir.DBG_OP_PLUS_CONST;
    dbg_op.arg = 17;
    if (R.is_err[R.Void, str](ir.dbg_expr_prepend_op(?m, fn, eid, dbg_op))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val rsite: R.Result[u32, str] = ir.inline_site_add(?m, fn, callee_name, source.loc(5, 23), 2);
    if (R.is_err[u32, str](rsite)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val site_id: u32 = R.unwrap_ok[u32, str](rsite);
    if (R.is_err[R.Void, str](ir.instr_inline_site_set(fn, iid, site_id))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }

    var w: writer.Writer;
    w.ctx = nil;
    w.f_write = test_sink_write;
    val context: IrDebugContext = debug_context("post-codegen", "native", "x86_64", "linux", "sysv64", "elf");
    var base_buf: [32768]u8;
    if (!capture_debug_into(?w, ?m, ?itn, context, ?base_buf[0])) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val baseline: str = (?base_buf[0])::str;
    if (!str_contains(baseline, "asm={") || !str_contains(baseline, "dbg_var={")
        || !str_contains(baseline, "alloca_dbg_var={") || !str_contains(baseline, "dbg_expr=1")
        || !str_contains(baseline, "inline=1") || !str_contains(baseline, "inline_sites {")
        || !str_contains(baseline, "mov \\\"quoted\\\"")) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }

    val oa: O.Option[*ir.IrAsm] = asm_get(fn, iid);
    val odv: O.Option[*ir.DbgVar] = ir.dbg_var_get(fn, iid);
    val oav: O.Option[*ir.DbgVar] = ir.alloca_dbg_var_get(fn, iid);
    val odex: O.Option[*ir.DbgExpr] = ir.dbg_expr_get(fn, eid);
    val osite: O.Option[*ir.InlineSite] = ir.inline_site_get(fn, site_id);
    if (O.is_none[*ir.IrAsm](oa) || O.is_none[*ir.DbgVar](odv) || O.is_none[*ir.DbgVar](oav)
        || O.is_none[*ir.DbgExpr](odex) || O.is_none[*ir.InlineSite](osite)) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    val ap: *ir.IrAsm = O.unwrap[*ir.IrAsm](oa);
    val dv: *ir.DbgVar = O.unwrap[*ir.DbgVar](odv);
    val av: *ir.DbgVar = O.unwrap[*ir.DbgVar](oav);
    val dex: *ir.DbgExpr = O.unwrap[*ir.DbgExpr](odex);
    val site: *ir.InlineSite = O.unwrap[*ir.InlineSite](osite);

    ap.isa = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    ap.isa = isa_name;
    ap.body = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    ap.body = body_name;
    bind.name = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    bind.name = var_name;
    bind.instr = iid;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    bind.instr = other_iid;
    bind.secret = false;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    bind.secret = true;
    ap.bind_count = 0;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    ap.bind_count = 1;

    dv.name = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dv.name = var_name;
    dv.ty = fty;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dv.ty = ity;
    dv.ty_sem = 8::semtype.TypeId;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dv.ty_sem = 7::semtype.TypeId;
    dv.is_param = false;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dv.is_param = true;
    dv.scope = 13;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dv.scope = 11;
    av.name = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    av.name = callee_name;

    dex.ops[0].op = ir.DBG_OP_MINUS_CONST;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dex.ops[0].op = ir.DBG_OP_PLUS_CONST;
    dex.ops[0].arg = 18;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dex.ops[0].arg = 17;
    dex.op_count = 0;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    dex.op_count = 1;
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.DbgExprId](?fn.dbg_expr_ids, iid, ir.DBG_EXPR_IDENTITY))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.DbgExprId](?fn.dbg_expr_ids, iid, eid))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }

    site.callee = fn_name;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    site.callee = callee_name;
    site.call_loc.file = 6;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    site.call_loc.file = 5;
    site.call_loc.offset = 24;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    site.call_loc.offset = 23;
    site.parent = 3;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    site.parent = 2;
    fn.inline_site_len = 0;
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    fn.inline_site_len = 1;
    if (R.is_err[R.Void, str](ir.instr_inline_site_set(fn, iid, 0))) {
        ir.dnit(?m); intern.dnit(?itn); ret 1;
    }
    if (!debug_differs(?w, ?m, ?itn, context, baseline)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret 0;
}
