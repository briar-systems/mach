use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std_allocator: std.allocator;

use me_ir:          mach.lang.me.ir;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.refs;

val BLOCK_GONE: u32 = 0xFFFFFFFF;

pub fun prune(m: *me_ir.Module, fn: *me_ir.Function, alloc: *std_allocator.Allocator) res[bool, fail.Fail] {
    val n: u32 = fn.block_count;
    if (n == 0) { ret res[bool, fail.Fail].ok{false}; }

    val res_reach: res[*bool, std_allocator.Error] = std_allocator.allocate[bool](alloc, n::usize);
    if (sel res_reach.err) {
        ret res[bool, fail.Fail].err{fail.refused(res_reach.err)};
    }
    val reach: *bool = res_reach.ok;

    val res_queue: res[*ir_id.BlockId, std_allocator.Error] = std_allocator.allocate[ir_id.BlockId](alloc, n::usize);
    if (sel res_queue.err) {
        std_allocator.deallocate[bool](alloc, reach, n::usize);
        ret res[bool, fail.Fail].err{fail.refused(res_queue.err)};
    }
    val queue: *ir_id.BlockId = res_queue.ok;

    var i: u32 = 0;
    for (i < n) {
        reach[i] = false;
        i        = i + 1;
    }

    var qhead: u32 = 0;
    var qtail: u32 = 0;
    reach[0]     = true;
    queue[qtail] = 0::ir_id.BlockId;
    qtail        = qtail + 1;
    for (qhead < qtail) {
        val bid: ir_id.BlockId = queue[qhead];
        qhead = qhead + 1;

        var s0: ir_id.BlockId = ir_id.BLOCK_NIL;
        var s1: ir_id.BlockId = ir_id.BLOCK_NIL;
        val sn: u32           = me_ir.block_successors(fn, ?fn.blocks[bid::u32], ?s0, ?s1);

        if (sn >= 1 && s0 != ir_id.BLOCK_NIL && s0::u32 < n && reach[s0::u32] == false) {
            reach[s0::u32] = true;
            queue[qtail]   = s0;
            qtail          = qtail + 1;
        }
        if (sn >= 2 && s1 != ir_id.BLOCK_NIL && s1::u32 < n && reach[s1::u32] == false) {
            reach[s1::u32] = true;
            queue[qtail]   = s1;
            qtail          = qtail + 1;
        }
    }

    var all_reach: bool = true;
    i = 0;
    for (i < n) {
        if (reach[i] == false) {
            all_reach = false;
            brk;
        }
        i = i + 1;
    }
    if (all_reach) {
        std_allocator.deallocate[bool](alloc, reach, n::usize);
        std_allocator.deallocate[ir_id.BlockId](alloc, queue, n::usize);
        ret res[bool, fail.Fail].ok{false};
    }

    val res_remap: res[*u32, std_allocator.Error] = std_allocator.allocate[u32](alloc, n::usize);
    if (sel res_remap.err) {
        std_allocator.deallocate[bool](alloc, reach, n::usize);
        std_allocator.deallocate[ir_id.BlockId](alloc, queue, n::usize);
        ret res[bool, fail.Fail].err{fail.refused(res_remap.err)};
    }
    val remap: *u32 = res_remap.ok;

    var next: u32 = 0;
    i = 0;
    for (i < n) {
        if (reach[i]) {
            remap[i] = next;
            next     = next + 1;
        }
        or {
            remap[i] = BLOCK_GONE;
        }
        i = i + 1;
    }

    i = 0;
    for (i < n) {
        if (reach[i] == false) {
            block_arrays_free(m, ?fn.blocks[i]);
        }
        i = i + 1;
    }

    var w: u32 = 0;
    var r: u32 = 0;
    for (r < n) {
        if (reach[r]) {
            if (w != r) { fn.blocks[w] = fn.blocks[r]; }
            var blk: *me_ir.Block = ?fn.blocks[w];
            blk.id         = w::ir_id.BlockId;
            blk.pred_count = remap_preds(blk.preds, blk.pred_count, remap);
            w              = w + 1;
        }
        r = r + 1;
    }
    fn.block_count = w;

    i = 0;
    for (i < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[i];
        remap_terminator(fn, blk, remap);
        prune_phis(fn, blk, remap);
        i = i + 1;
    }

    std_allocator.deallocate[bool](alloc, reach, n::usize);
    std_allocator.deallocate[ir_id.BlockId](alloc, queue, n::usize);
    std_allocator.deallocate[u32](alloc, remap, n::usize);
    ret res[bool, fail.Fail].ok{true};
}

fun block_arrays_free(m: *me_ir.Module, blk: *me_ir.Block) {
    if (blk.instructions != nil && blk.instr_cap > 0) {
        std_allocator.deallocate[ir_id.InstructionId](m.alloc, blk.instructions, blk.instr_cap::usize);
    }
    if (blk.phis != nil && blk.phi_cap > 0) {
        std_allocator.deallocate[ir_id.InstructionId](m.alloc, blk.phis, blk.phi_cap::usize);
    }
    if (blk.preds != nil && blk.pred_cap > 0) {
        std_allocator.deallocate[ir_id.BlockId](m.alloc, blk.preds, blk.pred_cap::usize);
    }
}

fun remap_preds(preds: *ir_id.BlockId, len: u32, remap: *u32) u32 {
    var w: u32 = 0;
    var r: u32 = 0;
    for (r < len) {
        val old: u32 = preds[r]::u32;
        if (remap[old] != BLOCK_GONE) {
            preds[w] = remap[old]::ir_id.BlockId;
            w        = w + 1;
        }
        r = r + 1;
    }
    ret w;
}

fun remap_terminator(fn: *me_ir.Function, blk: *me_ir.Block, remap: *u32) {
    if (blk.terminator == ir_id.INSTR_NIL) { ret; }
    val opt_term: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, blk.terminator);
    if (sel opt_term.none) { ret; }
    val term: *ir_instruction.Instruction = opt_term.some;

    var o: u32 = 0;
    for (o < term.operand_count) {
        if (refs.operand_is_block(term.kind, o)) {
            val old: u32 = term.operands[o].data.int_lit::u32;
            if (remap[old] != BLOCK_GONE) { term.operands[o].data.int_lit = remap[old]::u64; }
        }
        o = o + 1;
    }
}

fun prune_phis(fn: *me_ir.Function, blk: *me_ir.Block, remap: *u32) {
    var i: u32 = 0;
    for (i < blk.phi_count) {
        val opt_phi: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, blk.phis[i]);
        if (sel opt_phi.some) {
            val phi: *ir_instruction.Instruction = opt_phi.some;
            if (phi.kind == ir_instruction.OP_PHI) {
                var w: u32 = 0;
                var r: u32 = 0;
                for (r + 1 < phi.operand_count) {
                    val old: u32 = phi.operands[r].data.int_lit::u32;
                    if (remap[old] != BLOCK_GONE) {
                        phi.operands[w]              = phi.operands[r];
                        phi.operands[w].data.int_lit = remap[old]::u64;
                        phi.operands[w + 1]          = phi.operands[r + 1];
                        w                            = w + 2;
                    }
                    r = r + 2;
                }
                phi.operand_count = w;
            }
        }
        i = i + 1;
    }
}
