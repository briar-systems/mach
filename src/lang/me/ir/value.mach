use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use mach.lang.intern;
use mach.lang.me.ir.id;
use ir_type: mach.lang.me.ir.type;
use mach.lang.wide;

pub def ValueKind: u8;

pub val VAL_INSTR:       ValueKind = 0;
pub val VAL_PARAM:       ValueKind = 1;
pub val VAL_CONST_INT:   ValueKind = 2;
pub val VAL_CONST_FLOAT: ValueKind = 3;
pub val VAL_CONST_NULL:  ValueKind = 4;
pub val VAL_CONST_BYTES: ValueKind = 5;
pub val VAL_GLOBAL:      ValueKind = 6;
pub val VAL_FN:          ValueKind = 7;
pub val VAL_CONST_AGG:   ValueKind = 8;

pub rec ValueBytes {
    ptr: *u8;
    len: u32;
}

pub rec AggReloc {
    offset: u32;
    symbol: intern.StrId;
    addend: i64;
    is_fn:  bool;
}

pub rec ValueAgg {
    bytes:       *u8;
    len:         u32;
    relocs:      *AggReloc;
    reloc_count: u32;
    reloc_cap:   u32;
}

pub rec Value {
    kind:   ValueKind;
    ty:     ir_type.IrTypeId;
    secret: bool;
    data:   uni {
        instr: id.InstructionId;
        param_ix: u32;
        # the low limb of int_wide: an integer constant is 128 bits, and every
        # reader of a value up to 64 bits sees the same field it always did
        int_lit: u64;
        int_wide: wide.Wide;
        float_lit: f64;
        bytes: ValueBytes;
        global_ix: u32;
        fn_ix: u32;
        agg: ValueAgg;
    };
}

pub fun instr(instr: id.InstructionId, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind       = VAL_INSTR;
    v.secret     = false;
    v.ty         = ty;
    v.data.instr = instr;
    ret v;
}

pub fun param(index: u32, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind          = VAL_PARAM;
    v.secret        = false;
    v.ty            = ty;
    v.data.param_ix = index;
    ret v;
}

pub fun const_int(bits: u64, ty: ir_type.IrTypeId) Value {
    ret const_int_wide(wide.from_u64(bits), ty);
}

# a 128-bit integer constant; a narrower type reads its low limb (#3511)
pub fun const_int_wide(bits: wide.Wide, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind          = VAL_CONST_INT;
    v.secret        = false;
    v.ty            = ty;
    v.data.int_wide = bits;
    ret v;
}

# both limbs of an integer constant
pub fun int_of(v: *Value) wide.Wide {
    ret v.data.int_wide;
}

pub fun const_float(value: f64, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind           = VAL_CONST_FLOAT;
    v.secret         = false;
    v.ty             = ty;
    v.data.float_lit = value;
    ret v;
}

pub fun const_null(ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind          = VAL_CONST_NULL;
    v.secret        = false;
    v.ty            = ty;
    v.data.int_wide = wide.zero();
    ret v;
}

pub fun const_bytes(ptr: *u8, len: u32, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind           = VAL_CONST_BYTES;
    v.secret         = false;
    v.ty             = ty;
    v.data.bytes.ptr = ptr;
    v.data.bytes.len = len;
    ret v;
}

pub fun global(index: u32, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind           = VAL_GLOBAL;
    v.secret         = false;
    v.ty             = ty;
    v.data.global_ix = index;
    ret v;
}

pub fun fn(index: u32, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind       = VAL_FN;
    v.secret     = false;
    v.ty         = ty;
    v.data.fn_ix = index;
    ret v;
}

pub fun const_agg(bytes: *u8, len: u32, relocs: *AggReloc, reloc_count: u32, reloc_cap: u32, ty: ir_type.IrTypeId) Value {
    var v: Value;
    v.kind                 = VAL_CONST_AGG;
    v.secret               = false;
    v.ty                   = ty;
    v.data.agg.bytes       = bytes;
    v.data.agg.len         = len;
    v.data.agg.relocs      = relocs;
    v.data.agg.reloc_count = reloc_count;
    v.data.agg.reloc_cap   = reloc_cap;
    ret v;
}

pub fun retype(v: Value, ty: ir_type.IrTypeId) Value {
    var copy: Value = v;
    copy.ty = ty;
    ret copy;
}

pub fun is_constant(v: Value) bool {
    if (v.kind == VAL_CONST_INT)   { ret true; }
    if (v.kind == VAL_CONST_FLOAT) { ret true; }
    if (v.kind == VAL_CONST_NULL)  { ret true; }
    if (v.kind == VAL_CONST_BYTES) { ret true; }
    if (v.kind == VAL_CONST_AGG)   { ret true; }
    ret false;
}

# int_lit is the low limb of int_wide, so a 64-bit reader and a 128-bit
# reader see one constant (#3511)
test const_int__low_limb_aliases_int_lit {
    val v: Value = const_int(0xFFFF_FFFF_FFFF_FFF0, 0);
    if (v.data.int_lit != 0xFFFF_FFFF_FFFF_FFF0)     { ret 1; }
    if (v.data.int_wide.lo != 0xFFFF_FFFF_FFFF_FFF0) { ret 2; }
    if (v.data.int_wide.hi != 0)                     { ret 3; }
    val w: Value = const_int_wide(wide.make(7, 9), 0);
    if (w.data.int_lit != 7)                      { ret 4; }
    if (int_of(?w).hi != 9 || int_of(?w).lo != 7) { ret 5; }
    val n: Value = const_null(0);
    if (n.data.int_wide.hi != 0 || n.data.int_lit != 0) { ret 6; }
    ret 0;
}
