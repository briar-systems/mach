    val ir8: res[IrTypeId, fail.Fail] = intern_int(?tt, 8);
    if (sel ir8.err) { ret 2; }
    val i8ty: IrTypeId = ir8.ok;

    val huge_arr: res[IrTypeId, fail.Fail] = intern_array(?tt, i8ty, 4294967295);
    if (sel huge_arr.err) { ret 3; }
    val arry: IrTypeId = huge_arr.ok;

    var c: [1]IrTypeId;
    c[0] = arry;
    val r_tag: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 1, 0, false);
    if (sel r_tag.err) { ret 4; }
    val tag: IrTypeId = r_tag.ok;

    var m: layout.Machine = layout.machine(8, 0);
    val ext: layout.Extent = checked_extent_for_machine(?tt, tag, m);
    if (ext.ok || ext.cause != layout.EXTENT_SIZE_OVERFLOW) { ret 5; }
    ret 0;
}

