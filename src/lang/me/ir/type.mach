test "mach.lang.me.ir.type:logical_references_preserve_pointee_identity" {
    var alloc: A.Allocator;
    val r_1290: err[A.Error] = page.make(?alloc);
    if (sel r_1290.err) { ret 1; }
    var tt: IrTypeTable;
    val r_1292: err[fail.Fail] = init(?tt, ?alloc);
    if (sel r_1292.err) { ret 1; }
    fin { dnit(?tt); }
    val i32r: res[IrTypeId, fail.Fail] = intern_int(?tt, 32);
    val i64r: res[IrTypeId, fail.Fail] = intern_int(?tt, 64);
    val opaque: res[IrTypeId, fail.Fail] = intern_ptr(?tt);
    if (sel i32r.err) { ret 2; }
    if (sel i64r.err) { ret 2; }
    if (sel opaque.err) { ret 2; }
    val p32: res[IrTypeId, fail.Fail] = intern_reference(?tt, i32r.ok);
    val p64: res[IrTypeId, fail.Fail] = intern_reference(?tt, i64r.ok);
    if (sel p32.err) { ret 3; }
    if (sel p64.err) { ret 3; }
    val a: IrTypeId = p32.ok;
    val b: IrTypeId = p64.ok;
    if (a == b) { ret 4; }
    if (a == opaque.ok) { ret 4; }
    if (b == opaque.ok) { ret 4; }
    val again: res[IrTypeId, fail.Fail] = intern_reference(?tt, i32r.ok);
    if (sel again.err) { ret 5; }
    if (again.ok != a) { ret 5; }
    if (byte_size_for_machine(?tt, a, layout.machine(4, 0)) != 4
        || byte_align_for_machine(?tt, a, layout.machine(8, 0)) != 8) { ret 6; }
    val r_1314: res[IrTypeId, fail.Fail] = intern_reference(?tt, IRT_NIL);
    if (sel r_1314.ok) { ret 7; }
    ret 0;
}
