    if (sel ir64.err) { ret 2; }
    var cases: [2]IrTypeId;
    cases[0] = ir8.ok;
    cases[1] = ir64.ok;

    val r_alg32: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?cases[0], 2, 1, 32, false);
    val r_alg16_pkd: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?cases[0], 2, 1, 16, true);
    if (sel r_alg32.err) { ret 3; }
    if (sel r_alg16_pkd.err) { ret 3; }
    val alg32: IrTypeId = r_alg32.ok;
    val alg16_pkd: IrTypeId = r_alg16_pkd.ok;

    var m: layout.Machine = layout.machine(8, 0);
    if (byte_size_for_machine(?tt, alg32, m) != 32) { ret 4; }
    if (byte_align_for_machine(?tt, alg32, m) != 32) { ret 5; }
    if (tag_payload_offset_for_machine(?tt, alg32, m) != 8) { ret 6; }

    if (byte_size_for_machine(?tt, alg16_pkd, m) != 16) { ret 7; }
    if (byte_align_for_machine(?tt, alg16_pkd, m) != 16) { ret 8; }
    if (tag_payload_offset_for_machine(?tt, alg16_pkd, m) != 1) { ret 9; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:nested_cases_and_aggregates" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    val r_1157: err[fail.Fail] = init(?tt, ?alloc);
    if (sel r_1157.err) { ret 1; }
    fin { dnit(?tt); }

    val ir8: res[IrTypeId, fail.Fail] = intern_int(?tt, 8);
    val ir64: res[IrTypeId, fail.Fail] = intern_int(?tt, 64);
    if (sel ir8.err) { ret 2; }
    if (sel ir64.err) { ret 2; }
    val i8ty: IrTypeId = ir8.ok;
    val i64ty: IrTypeId = ir64.ok;

    var inner_c: [1]IrTypeId;
    inner_c[0] = i64ty;
    val r_inner: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?inner_c[0], 1, 1, 0, false);
    if (sel r_inner.err) { ret 3; }
    val inner: IrTypeId = r_inner.ok;

    var m: layout.Machine = layout.machine(8, 0);
    if (byte_size_for_machine(?tt, inner, m) != 16) { ret 4; }
    if (byte_align_for_machine(?tt, inner, m) != 8) { ret 5; }

    var outer_c: [1]IrTypeId;
    outer_c[0] = inner;
    val r_outer: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?outer_c[0], 1, 1, 0, true);
    if (sel r_outer.err) { ret 6; }
    val outer: IrTypeId = r_outer.ok;

    if (byte_size_for_machine(?tt, outer, m) != 17) { ret 7; }
    if (byte_align_for_machine(?tt, outer, m) != 1) { ret 8; }
    if (tag_payload_offset_for_machine(?tt, outer, m) != 1) { ret 9; }

    var st_fields: [2]IrTypeId;
    st_fields[0] = inner;
    st_fields[1] = i8ty;
    val r_st: res[IrTypeId, fail.Fail] = intern_struct(?tt, ?st_fields[0], 2, 0, false);
    if (sel r_st.err) { ret 10; }
    val stty: IrTypeId = r_st.ok;

    if (byte_size_for_machine(?tt, stty, m) != 24) { ret 11; }
    if (byte_align_for_machine(?tt, stty, m) != 8) { ret 12; }
    if (byte_offset_for_machine(?tt, stty, 0, m) != 0) { ret 13; }
    if (byte_offset_for_machine(?tt, stty, 1, m) != 16) { ret 14; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:invalid_inputs_and_unresolved_references" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    val r_1205: err[fail.Fail] = init(?tt, ?alloc);
    if (sel r_1205.err) { ret 1; }
    fin { dnit(?tt); }

    val ir32: res[IrTypeId, fail.Fail] = intern_int(?tt, 32);
    if (sel ir32.err) { ret 2; }
    val i32ty: IrTypeId = ir32.ok;

    var c: [1]IrTypeId;
    c[0] = i32ty;

    val r_1215: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 0, 1, 0, false);
    if (sel r_1215.ok) { ret 3; }
    val r_1216: res[IrTypeId, fail.Fail] = intern_tag(?tt, nil, 1, 1, 0, false);
    if (sel r_1216.ok) { ret 4; }

    c[0] = IRT_NIL;
    val r_1219: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 1, 0, false);
    if (sel r_1219.ok) { ret 5; }

    c[0] = 99999;
    val r_1222: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 1, 0, false);
    if (sel r_1222.ok) { ret 6; }

    c[0] = i32ty;
    val r_1225: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 1, 3, false);
    if (sel r_1225.ok) { ret 7; }
    val r_1226: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 1, 5, false);
    if (sel r_1226.ok) { ret 8; }
    val r_1227: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 0, 0, false);
    if (sel r_1227.ok) { ret 10; }
    val r_1228: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 3, 0, false);
    if (sel r_1228.ok) { ret 11; }
    val r_1229: res[IrTypeId, fail.Fail] = intern_tag(?tt, ?c[0], 1, 16, 0, false);
    if (sel r_1229.ok) { ret 12; }

    var m: layout.Machine = layout.machine(8, 0);
    val unk: layout.Extent = checked_extent_for_machine(?tt, 99999, m);
    if (unk.ok || unk.cause != layout.EXTENT_UNKNOWN_NODE) { ret 9; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:checked_overflow" {
    var alloc: A.Allocator;
