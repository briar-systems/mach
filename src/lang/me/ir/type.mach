use std.allocator.page;
use std.collections.map;
use std.crypto.hash.fnv1a;
use std.memory;
use std.system.panic.panic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.layout;

pub def IrTypeId: u32;

pub val IRT_NIL: IrTypeId = 0xFFFFFFFF;

pub def IrTypeKind: u8;

pub val IRT_VOID:   IrTypeKind = 0;
pub val IRT_INT:    IrTypeKind = 1;
pub val IRT_FLOAT:  IrTypeKind = 2;
pub val IRT_PTR:    IrTypeKind = 3;
pub val IRT_ARRAY:  IrTypeKind = 4;
pub val IRT_STRUCT: IrTypeKind = 5;
pub val IRT_FN:     IrTypeKind = 6;
pub val IRT_UNION:  IrTypeKind = 7;
pub val IRT_VECTOR: IrTypeKind = 8;
pub val IRT_HANDLE: IrTypeKind = 9;
pub val IRT_TAG:    IrTypeKind = 10;

pub rec IrTypeArray {
    element: IrTypeId;
    count:   u32;
}

pub rec IrTypeVector {
    element: IrTypeId;
    lanes:   u32;
}

pub rec IrTypeHandle {
    ctor:     u32;
    operands: *IrTypeId;
    count:    u32;
}

pub rec IrTypeStruct {
    fields:      *IrTypeId;
    field_count: u32;
    align:       u32;
    packed:      bool;
}

pub rec IrTypeTag {
    cases:      *IrTypeId;
    case_count: u32;
    disc_bytes: u32;
    align:      u32;
    packed:     bool;
}

pub rec IrTypeFn {
    ret_type:    IrTypeId;
    params:      *IrTypeId;
    param_count: u32;
    variadic:    bool;
}

pub rec IrType {
    kind: IrTypeKind;
    data: uni {
        bits:    u32;
        array_:  IrTypeArray;
        vector_: IrTypeVector;
        handle_: IrTypeHandle;
        struct_: IrTypeStruct;
        fn:      IrTypeFn;
        tag_:    IrTypeTag;
    };
}

pub rec IrTypeTable {
    a: *A.Allocator;

    types: *IrType;
    len:   u32;
    cap:   u32;

    dedup: map.Map[IrType, IrTypeId];
}

val INITIAL_TYPE_CAP: u32 = 32;

pub fun init(t: *IrTypeTable, a: *A.Allocator) O.Option[str] {
    t.a     = a;
    t.types = nil;
    t.len   = 0;
    t.cap   = 0;
    t.dedup = map.init[IrType, IrTypeId](a, hash_ir_type, eq_ir_type);

    val res_alloc_types: R.Result[*IrType, str] = A.allocate[IrType](a, INITIAL_TYPE_CAP::usize);
    if (R.is_err[*IrType, str](res_alloc_types)) {
        dnit(t);
        ret O.some[str](R.unwrap_err[*IrType, str](res_alloc_types));
    }
    t.types = R.unwrap_ok[*IrType, str](res_alloc_types);
    t.cap   = INITIAL_TYPE_CAP;

    ret O.none[str]();
}

pub fun dnit(t: *IrTypeTable) {
    if (t == nil) { ret; }

    var i: u32 = 0;
    for (i < t.len) {
        free_payload(t, ?t.types[i]);
        i = i + 1;
    }

    if (t.types != nil && t.cap > 0) {
        A.deallocate[IrType](t.a, t.types, t.cap::usize);
    }
    map.dnit[IrType, IrTypeId](?t.dedup);

    t.types = nil;
    t.len   = 0;
    t.cap   = 0;
}

pub fun get(t: *IrTypeTable, id: IrTypeId) O.Option[*IrType] {
    if (id >= t.len) { ret O.none[*IrType](); }
    ret O.some[*IrType](?t.types[id]);
}

pub fun reference_valid(t: *IrTypeTable, id: IrTypeId) bool {
    if (id >= t.len) { ret false; }
    val ty: *IrType = ?t.types[id];
    if (ty.kind == IRT_TAG) {
        if (ty.data.tag_.case_count == 0) { ret false; }
        var i: u32 = 0;
        for (i < ty.data.tag_.case_count) {
            val cid: IrTypeId = ty.data.tag_.cases[i];
            if (cid >= id || !reference_valid(t, cid)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret true;
}

pub fun array_count(t: *IrTypeTable, id: IrTypeId) u32 {
    if (id >= t.len) { panic("ir.type.array_count: type id out of range\n"); }
    val ir: *IrType = ?t.types[id];
    if (ir.kind != IRT_ARRAY) { panic("ir.type.array_count: type is not an array\n"); }
    ret ir.data.array_.count;
}

pub fun is_aggregate(t: *IrTypeTable, id: IrTypeId) bool {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { ret false; }
    val k: IrTypeKind = O.unwrap[*IrType](opt_get).kind;
    ret k == IRT_STRUCT || k == IRT_UNION || k == IRT_ARRAY || k == IRT_TAG;
}

pub fun is_float_scalar(t: *IrTypeTable, id: IrTypeId) bool {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { ret false; }
    ret O.unwrap[*IrType](opt_get).kind == IRT_FLOAT;
}

pub fun bit_width(t: *IrTypeTable, id: IrTypeId) u32 {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { ret 0; }
    val ir: *IrType = O.unwrap[*IrType](opt_get);
    if (ir.kind == IRT_INT || ir.kind == IRT_FLOAT) { ret ir.data.bits; }
    if (ir.kind == IRT_VECTOR) {
        val opt_el: O.Option[*IrType] = get(t, ir.data.vector_.element);
        if (O.is_none[*IrType](opt_el)) { ret 0; }
        val el: *IrType = O.unwrap[*IrType](opt_el);
        if (el.kind != IRT_INT && el.kind != IRT_FLOAT) { ret 0; }
        ret el.data.bits * ir.data.vector_.lanes;
    }
    ret 0;
}

pub fun is_vector(t: *IrTypeTable, id: IrTypeId) bool {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { ret false; }
    ret O.unwrap[*IrType](opt_get).kind == IRT_VECTOR;
}

pub fun vector_lane(t: *IrTypeTable, id: IrTypeId, out_is_float: *bool, out_elem_bytes: *u8,
                    out_lanes: *u32) bool {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { ret false; }
    val ir: *IrType = O.unwrap[*IrType](opt_get);
    if (ir.kind != IRT_VECTOR) { ret false; }

    val opt_el: O.Option[*IrType] = get(t, ir.data.vector_.element);
    if (O.is_none[*IrType](opt_el)) { ret false; }
    val el: *IrType = O.unwrap[*IrType](opt_el);
    @out_is_float   = (el.kind == IRT_FLOAT);
    @out_elem_bytes = bits_to_bytes(el.data.bits)::u8;
    @out_lanes      = ir.data.vector_.lanes;
    ret true;
}

pub fun is_tag(t: *IrTypeTable, id: IrTypeId) bool {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { ret false; }
    ret O.unwrap[*IrType](opt_get).kind == IRT_TAG;
}

pub fun tag_case_count(t: *IrTypeTable, id: IrTypeId) u32 {
    if (id >= t.len) { panic("ir.type.tag_case_count: type id out of range\n"); }
    val ir: *IrType = ?t.types[id];
    if (ir.kind != IRT_TAG) { panic("ir.type.tag_case_count: type is not a tag\n"); }
    ret ir.data.tag_.case_count;
}

pub fun tag_case_type(t: *IrTypeTable, id: IrTypeId, case_ix: u32) IrTypeId {
    if (id >= t.len) { panic("ir.type.tag_case_type: type id out of range\n"); }
    val ir: *IrType = ?t.types[id];
    if (ir.kind != IRT_TAG) { panic("ir.type.tag_case_type: type is not a tag\n"); }
    if (case_ix >= ir.data.tag_.case_count) { panic("ir.type.tag_case_type: case index out of range\n"); }
    ret ir.data.tag_.cases[case_ix];
}

pub fun tag_case_has_payload(t: *IrTypeTable, id: IrTypeId, case_ix: u32) bool {
    val ty: IrTypeId = tag_case_type(t, id, case_ix);
    if (ty >= t.len) { ret false; }
    ret t.types[ty].kind != IRT_VOID;
}

pub fun tag_discriminator_bytes(t: *IrTypeTable, id: IrTypeId) u32 {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { panic("ir.type.tag_discriminator_bytes: type id out of range\n"); }
    val ir: *IrType = O.unwrap[*IrType](opt_get);
    if (ir.kind != IRT_TAG) { panic("ir.type.tag_discriminator_bytes: type is not a tag\n"); }
    ret ir.data.tag_.disc_bytes;
}

pub fun intern_void(t: *IrTypeTable) R.Result[IrTypeId, str] {
    var ir: IrType;
    ir.kind      = IRT_VOID;
    ir.data.bits = 0;
    ret intern_inline(t, ir);
}

pub fun intern_int(t: *IrTypeTable, bits: u32) R.Result[IrTypeId, str] {
    var ir: IrType;
    ir.kind      = IRT_INT;
    ir.data.bits = bits;
    ret intern_inline(t, ir);
}

pub fun intern_float(t: *IrTypeTable, bits: u32) R.Result[IrTypeId, str] {
    var ir: IrType;
    ir.kind      = IRT_FLOAT;
    ir.data.bits = bits;
    ret intern_inline(t, ir);
}

pub fun intern_ptr(t: *IrTypeTable) R.Result[IrTypeId, str] {
    var ir: IrType;
    ir.kind      = IRT_PTR;
    ir.data.bits = 0;
    ret intern_inline(t, ir);
}

pub fun intern_array(t: *IrTypeTable, element: IrTypeId, count: u32) R.Result[IrTypeId, str] {
    var ir: IrType;
    ir.kind                = IRT_ARRAY;
    ir.data.array_.element = element;
    ir.data.array_.count   = count;
    ret intern_inline(t, ir);
}

pub fun intern_vector(t: *IrTypeTable, element: IrTypeId, lanes: u32) R.Result[IrTypeId, str] {
    var ir: IrType;
    ir.kind                 = IRT_VECTOR;
    ir.data.vector_.element = element;
    ir.data.vector_.lanes   = lanes;
    ret intern_inline(t, ir);
}

pub fun intern_handle(t: *IrTypeTable, ctor: u32, operands: *IrTypeId, count: u32) R.Result[IrTypeId, str] {
    var probe: IrType;
    probe.kind                  = IRT_HANDLE;
    probe.data.handle_.ctor     = ctor;
    probe.data.handle_.operands = operands;
    probe.data.handle_.count    = count;
    ret intern_owned(t, probe, operands, count);
}

pub fun intern_struct(t: *IrTypeTable, fields: *IrTypeId, field_count: u32, align: u32, packed: bool) R.Result[IrTypeId, str] {
    var probe: IrType;
    probe.kind                     = IRT_STRUCT;
    probe.data.struct_.fields      = fields;
    probe.data.struct_.field_count = field_count;
    probe.data.struct_.align       = align;
    probe.data.struct_.packed      = packed;
    ret intern_owned(t, probe, fields, field_count);
}

pub fun intern_union(t: *IrTypeTable, fields: *IrTypeId, field_count: u32, align: u32, packed: bool) R.Result[IrTypeId, str] {
    var probe: IrType;
    probe.kind                     = IRT_UNION;
    probe.data.struct_.fields      = fields;
    probe.data.struct_.field_count = field_count;
    probe.data.struct_.align       = align;
    probe.data.struct_.packed      = packed;
    ret intern_owned(t, probe, fields, field_count);
}

pub fun intern_fn(t: *IrTypeTable, ret_type: IrTypeId, params: *IrTypeId, param_count: u32, variadic: bool) R.Result[IrTypeId, str] {
    var probe: IrType;
    probe.kind                = IRT_FN;
    probe.data.fn.ret_type    = ret_type;
    probe.data.fn.params      = params;
    probe.data.fn.param_count = param_count;
    probe.data.fn.variadic    = variadic;
    ret intern_owned(t, probe, params, param_count);
}

pub fun intern_tag(t: *IrTypeTable, cases: *IrTypeId, case_count: u32, disc_bytes: u32, align: u32, packed: bool) R.Result[IrTypeId, str] {
    if (case_count == 0) {
        ret R.err[IrTypeId, str]("ir.type: tag requires at least one case");
    }
    if (disc_bytes != 1 && disc_bytes != 2 && disc_bytes != 4 && disc_bytes != 8) {
        ret R.err[IrTypeId, str]("ir.type: tag discriminator width must be 1, 2, 4 or 8 bytes");
    }
    if (cases == nil) {
        ret R.err[IrTypeId, str]("ir.type: tag cases array is nil");
    }
    if (align != 0 && (align & (align - 1)) != 0) {
        ret R.err[IrTypeId, str]("ir.type: tag alignment must be a power of two");
    }
    var i: u32 = 0;
    for (i < case_count) {
        val cid: IrTypeId = cases[i];
        if (cid >= t.len) {
            ret R.err[IrTypeId, str]("ir.type: tag case payload type id out of range");
        }
        if (!reference_valid(t, cid)) {
            ret R.err[IrTypeId, str]("ir.type: tag case payload type reference is invalid");
        }
        i = i + 1;
    }
    var probe: IrType;
    probe.kind                = IRT_TAG;
    probe.data.tag_.cases      = cases;
    probe.data.tag_.case_count = case_count;
    probe.data.tag_.disc_bytes = disc_bytes;
    probe.data.tag_.align      = align;
    probe.data.tag_.packed     = packed;
    ret intern_owned(t, probe, cases, case_count);
}

fun describe_node(t: *IrTypeTable, id: u32) layout.Node {
    if (id >= t.len) { ret layout.node(layout.NODE_UNKNOWN); }
    val ir: *IrType = ?t.types[id];

    if (ir.kind == IRT_VOID) { ret layout.node(layout.NODE_ZERO); }
    if (ir.kind == IRT_INT || ir.kind == IRT_FLOAT) {
        var n: layout.Node = layout.node(layout.NODE_SCALAR);
        n.bytes = bits_to_bytes(ir.data.bits);
        ret n;
    }
    if (ir.kind == IRT_PTR || ir.kind == IRT_FN || ir.kind == IRT_HANDLE) { ret layout.node(layout.NODE_POINTER); }
    if (ir.kind == IRT_VECTOR) {
        val opt_el: O.Option[*IrType] = get(t, ir.data.vector_.element);
        if (O.is_none[*IrType](opt_el)) { ret layout.node(layout.NODE_UNKNOWN); }
        var n: layout.Node = layout.node(layout.NODE_VECTOR);
        n.bytes = bits_to_bytes(O.unwrap[*IrType](opt_el).data.bits);
        n.count = ir.data.vector_.lanes;
        ret n;
    }
    if (ir.kind == IRT_ARRAY) {
        var n: layout.Node = layout.node(layout.NODE_ARRAY);
        n.child = ir.data.array_.element;
        n.count = ir.data.array_.count;
        ret n;
    }
    if (ir.kind == IRT_STRUCT || ir.kind == IRT_UNION) {
        var n: layout.Node = layout.node(layout.NODE_AGGREGATE);
        n.field_count = ir.data.struct_.field_count;
        n.decl_align  = ir.data.struct_.align;
        n.packed      = ir.data.struct_.packed;
        n.overlays    = ir.kind == IRT_UNION;
        ret n;
    }
    if (ir.kind == IRT_TAG) {
        var n: layout.Node = layout.node(layout.NODE_TAG);
        n.field_count = ir.data.tag_.case_count;
        n.bytes       = ir.data.tag_.disc_bytes;
        n.decl_align  = ir.data.tag_.align;
        n.packed      = ir.data.tag_.packed;
        ret n;
    }
    ret layout.node(layout.NODE_UNKNOWN);
}

fun describe_field(t: *IrTypeTable, id: u32, index: u32) u32 {
    if (id >= t.len) { ret IRT_NIL; }
    val ir: *IrType = ?t.types[id];
    if (ir.kind == IRT_TAG) {
        if (index >= ir.data.tag_.case_count) { ret IRT_NIL; }
        ret ir.data.tag_.cases[index];
    }
    if (ir.kind != IRT_STRUCT && ir.kind != IRT_UNION) { ret IRT_NIL; }
    if (index >= ir.data.struct_.field_count)          { ret IRT_NIL; }
    ret ir.data.struct_.fields[index];
}

fun ir_extent_for_machine(t: *IrTypeTable, id: IrTypeId, machine: layout.Machine, what: str) layout.Extent {
    val e: layout.Extent = layout.extent_of[IrTypeTable](t, describe_node, describe_field, id,
                                                         machine, layout.DEPTH_UNBOUNDED);
    if (!e.ok) { panic_cause(what, e.cause); }
    ret e;
}

fun panic_cause(what: str, cause: layout.ExtentCause) {
    var buf: [256]u8;
    var n: usize = 0;
    n = append_str(?buf[0], n, 256, what);
    n = append_str(?buf[0], n, 256, layout.cause_name(cause));
    n = append_str(?buf[0], n, 256, "\n");
    buf[n] = 0;
    panic((?buf[0])::str);
}

fun append_str(buf: *u8, n: usize, cap: usize, s: str) usize {
    var i: usize = 0;
    var o: usize = n;
    val p: *u8 = s::*u8;
    for (p[i] != 0 && o < cap - 1) {
        buf[o] = p[i];
        o = o + 1;
        i = i + 1;
    }
    ret o;
}

pub fun byte_size_for_machine(t: *IrTypeTable, id: IrTypeId, machine: layout.Machine) u32 {
    ret ir_extent_for_machine(t, id, machine, "ir.type.byte_size_for_machine: ").size;
}

pub fun byte_align_for_machine(t: *IrTypeTable, id: IrTypeId, machine: layout.Machine) u32 {
    ret ir_extent_for_machine(t, id, machine, "ir.type.byte_align_for_machine: ").align;
}

pub fun byte_offset_for_machine(t: *IrTypeTable, id: IrTypeId, field_ix: u32,
                                machine: layout.Machine) u32 {
    val e: layout.Extent = layout.field_offset_of[IrTypeTable](t, describe_node, describe_field,
                                                               id, field_ix, machine,
                                                               layout.DEPTH_UNBOUNDED);
    if (!e.ok) { panic_cause("ir.type.byte_offset_for_machine: ", e.cause); }
    ret e.size;
}

pub fun tag_payload_offset_for_machine(t: *IrTypeTable, id: IrTypeId, machine: layout.Machine) u32 {
    val opt_get: O.Option[*IrType] = get(t, id);
    if (O.is_none[*IrType](opt_get)) { panic("ir.type.tag_payload_offset_for_machine: type id out of range\n"); }
    val ir: *IrType = O.unwrap[*IrType](opt_get);
    if (ir.kind != IRT_TAG) { panic("ir.type.tag_payload_offset_for_machine: type is not a tag\n"); }
    ret byte_offset_for_machine(t, id, 0, machine);
}

pub fun checked_extent_for_machine(t: *IrTypeTable, id: IrTypeId, machine: layout.Machine) layout.Extent {
    ret layout.extent_of[IrTypeTable](t, describe_node, describe_field, id,
                                      machine, layout.DEPTH_UNBOUNDED);
}

pub fun checked_offset_for_machine(t: *IrTypeTable, id: IrTypeId, field_ix: u32,
                                   machine: layout.Machine) layout.Extent {
    ret layout.field_offset_of[IrTypeTable](t, describe_node, describe_field,
                                            id, field_ix, machine,
                                            layout.DEPTH_UNBOUNDED);
}

fun intern_inline(t: *IrTypeTable, ir: IrType) R.Result[IrTypeId, str] {
    val res_get: R.Result[*IrTypeId, str] = map.get[IrType, IrTypeId](?t.dedup, ?ir);
    if (R.is_ok[*IrTypeId, str](res_get)) {
        ret R.ok[IrTypeId, str](@R.unwrap_ok[*IrTypeId, str](res_get));
    }
    val res_append: R.Result[IrTypeId, str] = append_type(t, ir);
    if (R.is_err[IrTypeId, str](res_append)) { ret res_append; }
    val tid: IrTypeId = R.unwrap_ok[IrTypeId, str](res_append);

    val res_insert: R.Result[bool, str] = map.insert[IrType, IrTypeId](?t.dedup, ir, tid);
    if (R.is_err[bool, str](res_insert)) {
        t.len = t.len - 1;
        ret R.err[IrTypeId, str](R.unwrap_err[bool, str](res_insert));
    }
    ret R.ok[IrTypeId, str](tid);
}

fun intern_owned(t: *IrTypeTable, probe: IrType, ids: *IrTypeId, len: u32) R.Result[IrTypeId, str] {
    val res_get: R.Result[*IrTypeId, str] = map.get[IrType, IrTypeId](?t.dedup, ?probe);
    if (R.is_ok[*IrTypeId, str](res_get)) {
        ret R.ok[IrTypeId, str](@R.unwrap_ok[*IrTypeId, str](res_get));
    }

    val res_dup: R.Result[*IrTypeId, str] = dup_ids(t.a, ids, len);
    if (R.is_err[*IrTypeId, str](res_dup)) {
        ret R.err[IrTypeId, str](R.unwrap_err[*IrTypeId, str](res_dup));
    }
    val owned: *IrTypeId = R.unwrap_ok[*IrTypeId, str](res_dup);

    var ir: IrType = probe;
    if (ir.kind == IRT_FN)          { ir.data.fn.params       = owned; }
    or (ir.kind == IRT_HANDLE)      { ir.data.handle_.operands = owned; }
    or (ir.kind == IRT_TAG)         { ir.data.tag_.cases      = owned; }
    or                              { ir.data.struct_.fields  = owned; }

    val res_append: R.Result[IrTypeId, str] = append_type(t, ir);
    if (R.is_err[IrTypeId, str](res_append)) {
        A.deallocate[IrTypeId](t.a, owned, len::usize);
        ret res_append;
    }
    val tid: IrTypeId = R.unwrap_ok[IrTypeId, str](res_append);

    val res_insert: R.Result[bool, str] = map.insert[IrType, IrTypeId](?t.dedup, ir, tid);
    if (R.is_err[bool, str](res_insert)) {
        t.len = t.len - 1;
        A.deallocate[IrTypeId](t.a, owned, len::usize);
        ret R.err[IrTypeId, str](R.unwrap_err[bool, str](res_insert));
    }
    ret R.ok[IrTypeId, str](tid);
}

fun append_type(t: *IrTypeTable, ir: IrType) R.Result[IrTypeId, str] {
    if (t.len == t.cap) {
        val new_cap: u32 = t.cap * 2;
        val res_realloc: R.Result[*IrType, str] = A.reallocate[IrType](t.a, t.types, t.cap::usize, new_cap::usize);
        if (R.is_err[*IrType, str](res_realloc)) {
            ret R.err[IrTypeId, str](R.unwrap_err[*IrType, str](res_realloc));
        }
        t.types = R.unwrap_ok[*IrType, str](res_realloc);
        t.cap   = new_cap;
    }
    val tid: IrTypeId = t.len;
    t.types[t.len] = ir;
    t.len = t.len + 1;
    ret R.ok[IrTypeId, str](tid);
}

fun dup_ids(a: *A.Allocator, src: *IrTypeId, len: u32) R.Result[*IrTypeId, str] {
    if (len == 0) { ret R.ok[*IrTypeId, str](nil); }
    val res_alloc: R.Result[*IrTypeId, str] = A.allocate[IrTypeId](a, len::usize);
    if (R.is_err[*IrTypeId, str](res_alloc)) { ret res_alloc; }
    val buf: *IrTypeId = R.unwrap_ok[*IrTypeId, str](res_alloc);
    memory.copy[IrTypeId](buf, src, len::usize);
    ret R.ok[*IrTypeId, str](buf);
}

fun free_payload(t: *IrTypeTable, ir: *IrType) {
    if ((ir.kind == IRT_STRUCT || ir.kind == IRT_UNION) && ir.data.struct_.fields != nil) {
        A.deallocate[IrTypeId](t.a, ir.data.struct_.fields, ir.data.struct_.field_count::usize);
    }
    or (ir.kind == IRT_TAG && ir.data.tag_.cases != nil) {
        A.deallocate[IrTypeId](t.a, ir.data.tag_.cases, ir.data.tag_.case_count::usize);
    }
    or (ir.kind == IRT_FN && ir.data.fn.params != nil) {
        A.deallocate[IrTypeId](t.a, ir.data.fn.params, ir.data.fn.param_count::usize);
    }
    or (ir.kind == IRT_HANDLE && ir.data.handle_.operands != nil) {
        A.deallocate[IrTypeId](t.a, ir.data.handle_.operands, ir.data.handle_.count::usize);
    }
}

fun bits_to_bytes(bits: u32) u32 {
    ret (bits + 7) / 8;
}

fun hash_ir_type(p: ptr) u64 {
    val ir: *IrType = p::*IrType;
    var h: u64 = fnv1a.FNV_INIT;
    h = fnv1a.step_u8(h, ir.kind::u8);
    if (ir.kind == IRT_INT || ir.kind == IRT_FLOAT) {
        h = fnv1a.step_u32(h, ir.data.bits);
        ret h;
    }
    if (ir.kind == IRT_ARRAY) {
        h = fnv1a.step_u32(h, ir.data.array_.element);
        h = fnv1a.step_u32(h, ir.data.array_.count);
        ret h;
    }
    if (ir.kind == IRT_VECTOR) {
        h = fnv1a.step_u32(h, ir.data.vector_.element);
        h = fnv1a.step_u32(h, ir.data.vector_.lanes);
        ret h;
    }
    if (ir.kind == IRT_HANDLE) {
        h = fnv1a.step_u32(h, ir.data.handle_.ctor);
        h = fnv1a.step_u32(h, ir.data.handle_.count);
        var i: u32 = 0;
        for (i < ir.data.handle_.count) {
            h = fnv1a.step_u32(h, ir.data.handle_.operands[i]::u32);
            i = i + 1;
        }
        ret h;
    }
    if (ir.kind == IRT_STRUCT || ir.kind == IRT_UNION) {
        h = fnv1a.step_u32(h, ir.data.struct_.field_count);
        var i: u32 = 0;
        for (i < ir.data.struct_.field_count) {
            h = fnv1a.step_u32(h, ir.data.struct_.fields[i]);
            i = i + 1;
        }
        if (ir.data.struct_.align != 0) { h = fnv1a.step_u32(h, ir.data.struct_.align); }
        if (ir.data.struct_.packed)      { h = fnv1a.step_u32(h, 1); }
        ret h;
    }
    if (ir.kind == IRT_TAG) {
        h = fnv1a.step_u32(h, ir.data.tag_.case_count);
        h = fnv1a.step_u32(h, ir.data.tag_.disc_bytes);
        var i: u32 = 0;
        for (i < ir.data.tag_.case_count) {
            h = fnv1a.step_u32(h, ir.data.tag_.cases[i]);
            i = i + 1;
        }
        if (ir.data.tag_.align != 0) { h = fnv1a.step_u32(h, ir.data.tag_.align); }
        if (ir.data.tag_.packed)     { h = fnv1a.step_u32(h, 1); }
        ret h;
    }
    if (ir.kind == IRT_FN) {
        h = fnv1a.step_u32(h, ir.data.fn.ret_type);
        h = fnv1a.step_u32(h, ir.data.fn.param_count);
        h = fnv1a.step_u8(h, ir.data.fn.variadic::u8);
        var i: u32 = 0;
        for (i < ir.data.fn.param_count) {
            h = fnv1a.step_u32(h, ir.data.fn.params[i]);
            i = i + 1;
        }
        ret h;
    }
    ret h;
}

pub fun content_equal(a: *IrType, b: *IrType) bool {
    ret eq_ir_type(a::ptr, b::ptr);
}

fun eq_ir_type(pa: ptr, pb: ptr) bool {
    val a: *IrType = pa::*IrType;
    val b: *IrType = pb::*IrType;
    if (a.kind != b.kind) { ret false; }
    if (a.kind == IRT_INT || a.kind == IRT_FLOAT) {
        ret a.data.bits == b.data.bits;
    }
    if (a.kind == IRT_ARRAY) {
        ret a.data.array_.element == b.data.array_.element
            && a.data.array_.count == b.data.array_.count;
    }
    if (a.kind == IRT_VECTOR) {
        ret a.data.vector_.element == b.data.vector_.element
            && a.data.vector_.lanes == b.data.vector_.lanes;
    }
    if (a.kind == IRT_HANDLE) {
        if (a.data.handle_.ctor != b.data.handle_.ctor)   { ret false; }
        if (a.data.handle_.count != b.data.handle_.count) { ret false; }
        ret memory.equal[IrTypeId](a.data.handle_.operands, b.data.handle_.operands, a.data.handle_.count::usize);
    }
    if (a.kind == IRT_STRUCT || a.kind == IRT_UNION) {
        if (a.data.struct_.field_count != b.data.struct_.field_count) { ret false; }
        if (a.data.struct_.align != b.data.struct_.align)             { ret false; }
        if (a.data.struct_.packed != b.data.struct_.packed)           { ret false; }
        ret memory.equal[IrTypeId](a.data.struct_.fields, b.data.struct_.fields, a.data.struct_.field_count::usize);
    }
    if (a.kind == IRT_TAG) {
        if (a.data.tag_.case_count != b.data.tag_.case_count) { ret false; }
        if (a.data.tag_.disc_bytes != b.data.tag_.disc_bytes) { ret false; }
        if (a.data.tag_.align != b.data.tag_.align)           { ret false; }
        if (a.data.tag_.packed != b.data.tag_.packed)         { ret false; }
        ret memory.equal[IrTypeId](a.data.tag_.cases, b.data.tag_.cases, a.data.tag_.case_count::usize);
    }
    if (a.kind == IRT_FN) {
        if (a.data.fn.ret_type != b.data.fn.ret_type)       { ret false; }
        if (a.data.fn.param_count != b.data.fn.param_count) { ret false; }
        if (a.data.fn.variadic != b.data.fn.variadic)       { ret false; }
        ret memory.equal[IrTypeId](a.data.fn.params, b.data.fn.params, a.data.fn.param_count::usize);
    }
    ret true;
}

test "mach.lang.me.ir.type.byte_size:struct_i8_i64" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var types: IrTypeTable;
    if (O.is_some[str](init(?types, ?alloc))) { ret 1; }

    val res_i8: R.Result[IrTypeId, str] = intern_int(?types, 8);
    if (R.is_err[IrTypeId, str](res_i8)) { dnit(?types); ret 1; }
    val i8ty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_i8);

    val res_i64: R.Result[IrTypeId, str] = intern_int(?types, 64);
    if (R.is_err[IrTypeId, str](res_i64)) { dnit(?types); ret 1; }
    val i64ty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_i64);

    var fields: [2]IrTypeId;
    fields[0] = i8ty;
    fields[1] = i64ty;
    val res_struct: R.Result[IrTypeId, str] = intern_struct(?types, ?fields[0], 2, 0, false);
    if (R.is_err[IrTypeId, str](res_struct)) { dnit(?types); ret 1; }
    val stty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_struct);

    var machine: layout.Machine = layout.machine(8, 0);

    if (byte_size_for_machine(?types, stty, machine)      != 16) { dnit(?types); ret 1; }
    if (byte_align_for_machine(?types, stty, machine)     != 8)  { dnit(?types); ret 1; }
    if (byte_offset_for_machine(?types, stty, 0, machine) != 0)  { dnit(?types); ret 1; }
    if (byte_offset_for_machine(?types, stty, 1, machine) != 8)  { dnit(?types); ret 1; }

    dnit(?types);
    ret 0;
}

test "mach.lang.me.ir.type.intern_struct:align_override" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var types: IrTypeTable;
    if (O.is_some[str](init(?types, ?alloc))) { ret 1; }

    val res_i8: R.Result[IrTypeId, str] = intern_int(?types, 8);
    if (R.is_err[IrTypeId, str](res_i8)) { dnit(?types); ret 1; }
    val i8ty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_i8);

    var fields: [1]IrTypeId;
    fields[0] = i8ty;

    val res_nat: R.Result[IrTypeId, str] = intern_struct(?types, ?fields[0], 1, 0, false);
    if (R.is_err[IrTypeId, str](res_nat)) { dnit(?types); ret 1; }
    val natty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_nat);

    val res_align: R.Result[IrTypeId, str] = intern_struct(?types, ?fields[0], 1, 32, false);
    if (R.is_err[IrTypeId, str](res_align)) { dnit(?types); ret 1; }
    val algty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_align);

    var machine: layout.Machine = layout.machine(8, 0);

    if (byte_align_for_machine(?types, natty, machine) != 1)  { dnit(?types); ret 1; }
    if (byte_size_for_machine(?types, natty, machine)  != 1)  { dnit(?types); ret 1; }
    if (byte_align_for_machine(?types, algty, machine) != 32) { dnit(?types); ret 1; }
    if (byte_size_for_machine(?types, algty, machine)  != 32) { dnit(?types); ret 1; }
    if (natty == algty)                        { dnit(?types); ret 1; }

    dnit(?types);
    ret 0;
}

test "mach.lang.me.ir.type.intern_struct:packed_removes_padding" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var types: IrTypeTable;
    if (O.is_some[str](init(?types, ?alloc))) { ret 1; }

    val res_i8: R.Result[IrTypeId, str] = intern_int(?types, 8);
    if (R.is_err[IrTypeId, str](res_i8)) { dnit(?types); ret 1; }
    val res_i64: R.Result[IrTypeId, str] = intern_int(?types, 64);
    if (R.is_err[IrTypeId, str](res_i64)) { dnit(?types); ret 1; }

    var fields: [2]IrTypeId;
    fields[0] = R.unwrap_ok[IrTypeId, str](res_i8);
    fields[1] = R.unwrap_ok[IrTypeId, str](res_i64);

    val res_nat: R.Result[IrTypeId, str] = intern_struct(?types, ?fields[0], 2, 0, false);
    if (R.is_err[IrTypeId, str](res_nat)) { dnit(?types); ret 1; }
    val natty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_nat);

    val res_pkd: R.Result[IrTypeId, str] = intern_struct(?types, ?fields[0], 2, 0, true);
    if (R.is_err[IrTypeId, str](res_pkd)) { dnit(?types); ret 1; }
    val pkdty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_pkd);

    var machine: layout.Machine = layout.machine(8, 0);

    if (byte_size_for_machine(?types, natty, machine)      != 16) { dnit(?types); ret 1; }
    if (byte_align_for_machine(?types, natty, machine)     != 8)  { dnit(?types); ret 1; }
    if (byte_offset_for_machine(?types, natty, 1, machine) != 8)  { dnit(?types); ret 1; }

    if (byte_size_for_machine(?types, pkdty, machine)      != 9) { dnit(?types); ret 1; }
    if (byte_align_for_machine(?types, pkdty, machine)     != 1) { dnit(?types); ret 1; }
    if (byte_offset_for_machine(?types, pkdty, 0, machine) != 0) { dnit(?types); ret 1; }
    if (byte_offset_for_machine(?types, pkdty, 1, machine) != 1) { dnit(?types); ret 1; }

    if (natty == pkdty) { dnit(?types); ret 1; }

    dnit(?types);
    ret 0;
}

test "mach.lang.me.ir.type.intern_vector:dedup_size_align" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var types: IrTypeTable;
    if (O.is_some[str](init(?types, ?alloc))) { ret 1; }

    val res_f32: R.Result[IrTypeId, str] = intern_float(?types, 32);
    if (R.is_err[IrTypeId, str](res_f32)) { dnit(?types); ret 1; }
    val f32ty: IrTypeId = R.unwrap_ok[IrTypeId, str](res_f32);

    val r1: R.Result[IrTypeId, str] = intern_vector(?types, f32ty, 4);
    val r2: R.Result[IrTypeId, str] = intern_vector(?types, f32ty, 4);
    if (R.is_err[IrTypeId, str](r1)) { dnit(?types); ret 1; }
    if (R.is_err[IrTypeId, str](r2)) { dnit(?types); ret 1; }
    val vecty: IrTypeId = R.unwrap_ok[IrTypeId, str](r1);
    if (vecty != R.unwrap_ok[IrTypeId, str](r2)) { dnit(?types); ret 1; }

    val res_i8: R.Result[IrTypeId, str] = intern_int(?types, 8);
    if (R.is_err[IrTypeId, str](res_i8)) { dnit(?types); ret 1; }
    val r3: R.Result[IrTypeId, str] = intern_vector(?types, R.unwrap_ok[IrTypeId, str](res_i8), 16);
    if (R.is_err[IrTypeId, str](r3)) { dnit(?types); ret 1; }
    if (R.unwrap_ok[IrTypeId, str](r3) == vecty) { dnit(?types); ret 1; }

    var machine: layout.Machine = layout.machine(8, 128);

    if (byte_size_for_machine(?types, vecty, machine)  != 16) { dnit(?types); ret 1; }
    if (byte_align_for_machine(?types, vecty, machine) != 16) { dnit(?types); ret 1; }
    if (is_aggregate(?types, vecty))           { dnit(?types); ret 1; }

    val r4: R.Result[IrTypeId, str] = intern_vector(?types, f32ty, 3);
    if (R.is_err[IrTypeId, str](r4)) { dnit(?types); ret 1; }
    val v3: IrTypeId = R.unwrap_ok[IrTypeId, str](r4);
    if (byte_size_for_machine(?types, v3, machine)  != 12) { dnit(?types); ret 1; }
    if (byte_align_for_machine(?types, v3, machine) != 4)  { dnit(?types); ret 1; }
    if (is_aggregate(?types, v3))           { dnit(?types); ret 1; }

    machine.vector_bits = 256;
    if (byte_size_for_machine(?types, vecty, machine)  != 16) { dnit(?types); ret 1; }
    if (byte_align_for_machine(?types, vecty, machine) != 4)  { dnit(?types); ret 1; }

    dnit(?types);
    ret 0;
}

rec FailCtx {
    real:  *A.Allocator;
    allow: usize;
    count: usize;
}

fun fail_alloc_fn(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    val f: *FailCtx = ctx::*FailCtx;
    if (f.count >= f.allow) { ret O.none[ptr](); }
    f.count = f.count + 1;
    ret f.real.fn_allocate(f.real.ctx, size, align);
}

fun fail_realloc_fn(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val f: *FailCtx = ctx::*FailCtx;
    if (f.count >= f.allow) { ret O.none[ptr](); }
    f.count = f.count + 1;
    ret f.real.fn_reallocate(f.real.ctx, p, old_size, new_size, align);
}

fun fail_dealloc_fn(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    val f: *FailCtx = ctx::*FailCtx;
    ret f.real.fn_deallocate(f.real.ctx, p, size, align);
}

fun make_fail_allocator(out: *A.Allocator, ctx: *FailCtx, real: *A.Allocator, allow: usize) {
    ctx.real = real;
    ctx.allow = allow;
    ctx.count = 0;
    out.ctx = ctx::ptr;
    out.fn_allocate = fail_alloc_fn;
    out.fn_reallocate = fail_realloc_fn;
    out.fn_deallocate = fail_dealloc_fn;
}

test "mach.lang.me.ir.type.tag:intern_identity_and_distinctness" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val vr: R.Result[IrTypeId, str] = intern_void(?tt);
    val ir32: R.Result[IrTypeId, str] = intern_int(?tt, 32);
    val ir64: R.Result[IrTypeId, str] = intern_int(?tt, 64);
    if (R.is_err[IrTypeId, str](vr) || R.is_err[IrTypeId, str](ir32) || R.is_err[IrTypeId, str](ir64)) { ret 2; }
    val voidty: IrTypeId = R.unwrap_ok[IrTypeId, str](vr);
    val i32ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir32);
    val i64ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir64);

    var c1: [2]IrTypeId;
    c1[0] = i32ty; c1[1] = i64ty;
    var c2: [2]IrTypeId;
    c2[0] = i32ty; c2[1] = i64ty;
    var c3: [2]IrTypeId;
    c3[0] = i64ty; c3[1] = i32ty;
    var c4: [1]IrTypeId;
    c4[0] = i32ty;
    var c5: [2]IrTypeId;
    c5[0] = voidty; c5[1] = i64ty;

    val r_tag1: R.Result[IrTypeId, str] = intern_tag(?tt, ?c1[0], 2, 1, 0, false);
    val r_tag2: R.Result[IrTypeId, str] = intern_tag(?tt, ?c2[0], 2, 1, 0, false);
    val r_tag3: R.Result[IrTypeId, str] = intern_tag(?tt, ?c3[0], 2, 1, 0, false);
    val r_tag4: R.Result[IrTypeId, str] = intern_tag(?tt, ?c4[0], 1, 1, 0, false);
    val r_tag5: R.Result[IrTypeId, str] = intern_tag(?tt, ?c5[0], 2, 1, 0, false);
    val r_tag_pkd: R.Result[IrTypeId, str] = intern_tag(?tt, ?c1[0], 2, 1, 0, true);
    val r_tag_alg: R.Result[IrTypeId, str] = intern_tag(?tt, ?c1[0], 2, 1, 16, false);
    val r_tag_wide: R.Result[IrTypeId, str] = intern_tag(?tt, ?c1[0], 2, 4, 0, false);
    val r_st: R.Result[IrTypeId, str] = intern_struct(?tt, ?c1[0], 2, 0, false);

    if (R.is_err[IrTypeId, str](r_tag1) || R.is_err[IrTypeId, str](r_tag2) || R.is_err[IrTypeId, str](r_tag3)) { ret 3; }
    if (R.is_err[IrTypeId, str](r_tag4) || R.is_err[IrTypeId, str](r_tag5) || R.is_err[IrTypeId, str](r_tag_pkd)) { ret 4; }
    if (R.is_err[IrTypeId, str](r_tag_alg) || R.is_err[IrTypeId, str](r_tag_wide) || R.is_err[IrTypeId, str](r_st)) { ret 5; }

    val t1: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag1);
    val t2: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag2);
    val t3: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag3);
    val t4: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag4);
    val t5: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag5);
    val tp: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag_pkd);
    val ta: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag_alg);
    val tw: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag_wide);
    val st: IrTypeId = R.unwrap_ok[IrTypeId, str](r_st);

    if (t1 != t2) { ret 6; }
    if (t1 == t3) { ret 7; }
    if (t1 == t4) { ret 8; }
    if (t1 == t5) { ret 9; }
    if (t1 == tp) { ret 10; }
    if (t1 == ta) { ret 11; }
    if (t1 == st) { ret 12; }

    if (t1 == tw) { ret 17; }
    if (tag_discriminator_bytes(?tt, t1) != 1 || tag_discriminator_bytes(?tt, tw) != 4) { ret 18; }
    if (!is_tag(?tt, t1)) { ret 13; }
    if (!is_aggregate(?tt, t1)) { ret 14; }
    if (is_tag(?tt, st)) { ret 15; }
    if (!is_aggregate(?tt, st)) { ret 16; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:copied_array_ownership" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val vr: R.Result[IrTypeId, str] = intern_void(?tt);
    val ir32: R.Result[IrTypeId, str] = intern_int(?tt, 32);
    val ir64: R.Result[IrTypeId, str] = intern_int(?tt, 64);
    if (R.is_err[IrTypeId, str](vr) || R.is_err[IrTypeId, str](ir32) || R.is_err[IrTypeId, str](ir64)) { ret 2; }
    val voidty: IrTypeId = R.unwrap_ok[IrTypeId, str](vr);
    val i32ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir32);
    val i64ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir64);

    var cases: [2]IrTypeId;
    cases[0] = i32ty;
    cases[1] = i64ty;
    val r_tag: R.Result[IrTypeId, str] = intern_tag(?tt, ?cases[0], 2, 1, 0, false);
    if (R.is_err[IrTypeId, str](r_tag)) { ret 3; }
    val tag: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag);

    cases[0] = voidty;
    cases[1] = voidty;

    if (tag_case_type(?tt, tag, 0) != i32ty) { ret 4; }
    if (tag_case_type(?tt, tag, 1) != i64ty) { ret 5; }
    if (tag_case_count(?tt, tag) != 2) { ret 6; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:payload_absence_versus_zero_sized" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val vr: R.Result[IrTypeId, str] = intern_void(?tt);
    val sr: R.Result[IrTypeId, str] = intern_struct(?tt, nil, 0, 0, false);
    if (R.is_err[IrTypeId, str](vr) || R.is_err[IrTypeId, str](sr)) { ret 2; }
    val voidty: IrTypeId = R.unwrap_ok[IrTypeId, str](vr);
    val empty_st: IrTypeId = R.unwrap_ok[IrTypeId, str](sr);

    var m: layout.Machine = layout.machine(8, 0);
    if (byte_size_for_machine(?tt, empty_st, m) != 0) { ret 3; }
    if (byte_align_for_machine(?tt, empty_st, m) != 1) { ret 4; }

    var c_absent: [1]IrTypeId;
    c_absent[0] = voidty;
    var c_zero: [1]IrTypeId;
    c_zero[0] = empty_st;

    val r_tag_absent: R.Result[IrTypeId, str] = intern_tag(?tt, ?c_absent[0], 1, 1, 0, false);
    val r_tag_zero: R.Result[IrTypeId, str] = intern_tag(?tt, ?c_zero[0], 1, 1, 0, false);
    if (R.is_err[IrTypeId, str](r_tag_absent) || R.is_err[IrTypeId, str](r_tag_zero)) { ret 5; }

    val tag_absent: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag_absent);
    val tag_zero: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag_zero);

    if (tag_absent == tag_zero) { ret 6; }
    if (tag_case_has_payload(?tt, tag_absent, 0)) { ret 7; }
    if (!tag_case_has_payload(?tt, tag_zero, 0)) { ret 8; }

    if (byte_size_for_machine(?tt, tag_absent, m) != 1) { ret 9; }
    if (byte_align_for_machine(?tt, tag_absent, m) != 1) { ret 10; }
    if (byte_size_for_machine(?tt, tag_zero, m) != 1) { ret 11; }
    if (byte_align_for_machine(?tt, tag_zero, m) != 1) { ret 12; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:discriminator_width_boundaries" {
    if (layout.discriminator_bytes(0) != 0) { ret 1; }
    if (layout.discriminator_bytes(1) != 1) { ret 2; }
    if (layout.discriminator_bytes(256) != 1) { ret 3; }
    if (layout.discriminator_bytes(257) != 2) { ret 4; }
    if (layout.discriminator_bytes(65536) != 2) { ret 5; }
    if (layout.discriminator_bytes(65537) != 4) { ret 6; }
    if (layout.discriminator_bytes(4294967296) != 4) { ret 7; }
    if (layout.discriminator_bytes(4294967297) != 8) { ret 8; }

    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 9; }
    fin { dnit(?tt); }

    val vr: R.Result[IrTypeId, str] = intern_void(?tt);
    if (R.is_err[IrTypeId, str](vr)) { ret 10; }
    var c: [1]IrTypeId;
    c[0] = R.unwrap_ok[IrTypeId, str](vr);

    val r_tag: R.Result[IrTypeId, str] = intern_tag(?tt, ?c[0], 1, 1, 0, false);
    if (R.is_err[IrTypeId, str](r_tag)) { ret 11; }
    val tag: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag);
    if (tag_discriminator_bytes(?tt, tag) != 1) { ret 12; }
    var m: layout.Machine = layout.machine(8, 0);
    if (byte_offset_for_machine(?tt, tag, 0, m) != 1) { ret 13; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:natural_and_packed_offsets_and_pointer_widths" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val vr: R.Result[IrTypeId, str] = intern_void(?tt);
    val pr: R.Result[IrTypeId, str] = intern_ptr(?tt);
    if (R.is_err[IrTypeId, str](vr) || R.is_err[IrTypeId, str](pr)) { ret 2; }
    val voidty: IrTypeId = R.unwrap_ok[IrTypeId, str](vr);
    val ptrty: IrTypeId = R.unwrap_ok[IrTypeId, str](pr);

    var cases: [2]IrTypeId;
    cases[0] = voidty;
    cases[1] = ptrty;

    val r_nat: R.Result[IrTypeId, str] = intern_tag(?tt, ?cases[0], 2, 1, 0, false);
    val r_pkd: R.Result[IrTypeId, str] = intern_tag(?tt, ?cases[0], 2, 1, 0, true);
    if (R.is_err[IrTypeId, str](r_nat) || R.is_err[IrTypeId, str](r_pkd)) { ret 3; }
    val nat_tag: IrTypeId = R.unwrap_ok[IrTypeId, str](r_nat);
    val pkd_tag: IrTypeId = R.unwrap_ok[IrTypeId, str](r_pkd);

    var m64: layout.Machine = layout.machine(8, 0);
    if (byte_size_for_machine(?tt, nat_tag, m64) != 16) { ret 4; }
    if (byte_align_for_machine(?tt, nat_tag, m64) != 8) { ret 5; }
    if (tag_payload_offset_for_machine(?tt, nat_tag, m64) != 8) { ret 6; }
    if (byte_offset_for_machine(?tt, nat_tag, 1, m64) != 8) { ret 7; }

    if (byte_size_for_machine(?tt, pkd_tag, m64) != 9) { ret 8; }
    if (byte_align_for_machine(?tt, pkd_tag, m64) != 1) { ret 9; }
    if (tag_payload_offset_for_machine(?tt, pkd_tag, m64) != 1) { ret 10; }
    if (byte_offset_for_machine(?tt, pkd_tag, 1, m64) != 1) { ret 11; }

    var m32: layout.Machine = layout.machine(4, 0);
    if (byte_size_for_machine(?tt, nat_tag, m32) != 8) { ret 12; }
    if (byte_align_for_machine(?tt, nat_tag, m32) != 4) { ret 13; }
    if (tag_payload_offset_for_machine(?tt, nat_tag, m32) != 4) { ret 14; }

    if (byte_size_for_machine(?tt, pkd_tag, m32) != 5) { ret 15; }
    if (byte_align_for_machine(?tt, pkd_tag, m32) != 1) { ret 16; }
    if (tag_payload_offset_for_machine(?tt, pkd_tag, m32) != 1) { ret 17; }

    val oob: layout.Extent = checked_offset_for_machine(?tt, nat_tag, 2, m64);
    if (oob.ok || oob.cause != layout.EXTENT_FIELD_RANGE) { ret 18; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:explicit_alignment" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val ir8: R.Result[IrTypeId, str] = intern_int(?tt, 8);
    val ir64: R.Result[IrTypeId, str] = intern_int(?tt, 64);
    if (R.is_err[IrTypeId, str](ir8) || R.is_err[IrTypeId, str](ir64)) { ret 2; }
    var cases: [2]IrTypeId;
    cases[0] = R.unwrap_ok[IrTypeId, str](ir8);
    cases[1] = R.unwrap_ok[IrTypeId, str](ir64);

    val r_alg32: R.Result[IrTypeId, str] = intern_tag(?tt, ?cases[0], 2, 1, 32, false);
    val r_alg16_pkd: R.Result[IrTypeId, str] = intern_tag(?tt, ?cases[0], 2, 1, 16, true);
    if (R.is_err[IrTypeId, str](r_alg32) || R.is_err[IrTypeId, str](r_alg16_pkd)) { ret 3; }
    val alg32: IrTypeId = R.unwrap_ok[IrTypeId, str](r_alg32);
    val alg16_pkd: IrTypeId = R.unwrap_ok[IrTypeId, str](r_alg16_pkd);

    var m: layout.Machine = layout.machine(8, 0);
    if (byte_size_for_machine(?tt, alg32, m) != 32) { ret 4; }
    if (byte_align_for_machine(?tt, alg32, m) != 32) { ret 5; }
    if (tag_payload_offset_for_machine(?tt, alg32, m) != 8) { ret 6; }

    if (byte_size_for_machine(?tt, alg16_pkd, m) != 16) { ret 7; }
    if (byte_align_for_machine(?tt, alg16_pkd, m) != 16) { ret 8; }
    if (tag_payload_offset_for_machine(?tt, alg16_pkd, m) != 1) { ret 9; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:nested_cases_and_aggregates" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val ir8: R.Result[IrTypeId, str] = intern_int(?tt, 8);
    val ir64: R.Result[IrTypeId, str] = intern_int(?tt, 64);
    if (R.is_err[IrTypeId, str](ir8) || R.is_err[IrTypeId, str](ir64)) { ret 2; }
    val i8ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir8);
    val i64ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir64);

    var inner_c: [1]IrTypeId;
    inner_c[0] = i64ty;
    val r_inner: R.Result[IrTypeId, str] = intern_tag(?tt, ?inner_c[0], 1, 1, 0, false);
    if (R.is_err[IrTypeId, str](r_inner)) { ret 3; }
    val inner: IrTypeId = R.unwrap_ok[IrTypeId, str](r_inner);

    var m: layout.Machine = layout.machine(8, 0);
    if (byte_size_for_machine(?tt, inner, m) != 16) { ret 4; }
    if (byte_align_for_machine(?tt, inner, m) != 8) { ret 5; }

    var outer_c: [1]IrTypeId;
    outer_c[0] = inner;
    val r_outer: R.Result[IrTypeId, str] = intern_tag(?tt, ?outer_c[0], 1, 1, 0, true);
    if (R.is_err[IrTypeId, str](r_outer)) { ret 6; }
    val outer: IrTypeId = R.unwrap_ok[IrTypeId, str](r_outer);

    if (byte_size_for_machine(?tt, outer, m) != 17) { ret 7; }
    if (byte_align_for_machine(?tt, outer, m) != 1) { ret 8; }
    if (tag_payload_offset_for_machine(?tt, outer, m) != 1) { ret 9; }

    var st_fields: [2]IrTypeId;
    st_fields[0] = inner;
    st_fields[1] = i8ty;
    val r_st: R.Result[IrTypeId, str] = intern_struct(?tt, ?st_fields[0], 2, 0, false);
    if (R.is_err[IrTypeId, str](r_st)) { ret 10; }
    val stty: IrTypeId = R.unwrap_ok[IrTypeId, str](r_st);

    if (byte_size_for_machine(?tt, stty, m) != 24) { ret 11; }
    if (byte_align_for_machine(?tt, stty, m) != 8) { ret 12; }
    if (byte_offset_for_machine(?tt, stty, 0, m) != 0) { ret 13; }
    if (byte_offset_for_machine(?tt, stty, 1, m) != 16) { ret 14; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:invalid_inputs_and_unresolved_references" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val ir32: R.Result[IrTypeId, str] = intern_int(?tt, 32);
    if (R.is_err[IrTypeId, str](ir32)) { ret 2; }
    val i32ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir32);

    var c: [1]IrTypeId;
    c[0] = i32ty;

    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 0, 1, 0, false))) { ret 3; }
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, nil, 1, 1, 0, false))) { ret 4; }

    c[0] = IRT_NIL;
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 1, 1, 0, false))) { ret 5; }

    c[0] = 99999;
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 1, 1, 0, false))) { ret 6; }

    c[0] = i32ty;
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 1, 1, 3, false))) { ret 7; }
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 1, 1, 5, false))) { ret 8; }
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 1, 0, 0, false))) { ret 10; }
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 1, 3, 0, false))) { ret 11; }
    if (R.is_ok[IrTypeId, str](intern_tag(?tt, ?c[0], 1, 16, 0, false))) { ret 12; }

    var m: layout.Machine = layout.machine(8, 0);
    val unk: layout.Extent = checked_extent_for_machine(?tt, 99999, m);
    if (unk.ok || unk.cause != layout.EXTENT_UNKNOWN_NODE) { ret 9; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:checked_overflow" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?alloc))) { ret 1; }
    fin { dnit(?tt); }

    val ir8: R.Result[IrTypeId, str] = intern_int(?tt, 8);
    if (R.is_err[IrTypeId, str](ir8)) { ret 2; }
    val i8ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir8);

    val huge_arr: R.Result[IrTypeId, str] = intern_array(?tt, i8ty, 4294967295);
    if (R.is_err[IrTypeId, str](huge_arr)) { ret 3; }
    val arry: IrTypeId = R.unwrap_ok[IrTypeId, str](huge_arr);

    var c: [1]IrTypeId;
    c[0] = arry;
    val r_tag: R.Result[IrTypeId, str] = intern_tag(?tt, ?c[0], 1, 1, 0, false);
    if (R.is_err[IrTypeId, str](r_tag)) { ret 4; }
    val tag: IrTypeId = R.unwrap_ok[IrTypeId, str](r_tag);

    var m: layout.Machine = layout.machine(8, 0);
    val ext: layout.Extent = checked_extent_for_machine(?tt, tag, m);
    if (ext.ok || ext.cause != layout.EXTENT_SIZE_OVERFLOW) { ret 5; }
    ret 0;
}

test "mach.lang.me.ir.type.tag:allocation_failures" {
    var real_alloc: A.Allocator;
    page.make(?real_alloc);
    var fail_ctx: FailCtx;
    var fail_alloc: A.Allocator;
    make_fail_allocator(?fail_alloc, ?fail_ctx, ?real_alloc, 1000);

    var tt: IrTypeTable;
    if (O.is_some[str](init(?tt, ?fail_alloc))) { ret 1; }
    fin { dnit(?tt); }

    val ir32: R.Result[IrTypeId, str] = intern_int(?tt, 32);
    if (R.is_err[IrTypeId, str](ir32)) { ret 2; }
    val i32ty: IrTypeId = R.unwrap_ok[IrTypeId, str](ir32);

    fail_ctx.allow = fail_ctx.count;

    var c: [1]IrTypeId;
    c[0] = i32ty;
    val r_tag: R.Result[IrTypeId, str] = intern_tag(?tt, ?c[0], 1, 1, 0, false);
    if (!R.is_err[IrTypeId, str](r_tag)) { ret 3; }
    ret 0;
}
