# control-flow surgery every pass shares: cloning a region of blocks, listing
# clones into their blocks and pointing their operands at each other, and
# moving an edge from one block to another in a terminator or a phi

use mach.lang.fail;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use me_ir:          mach.lang.me.ir;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.refs;
use mach.lang.me.ir.value;

# a map entry for a block or instruction that has no clone
pub val NONE: u32 = 0xFFFFFFFF;

# where each source block and instruction went: indexed by the source id, the
# clone's id or NONE
pub rec CloneMap {
    block_map: *u32;
    n_blocks:  u32;
    instr_map: *u32;
    n_instrs:  u32;
}

# the position of `blk` in `blocks`, 0 when it is absent
pub fun region_index(blocks: *ir_id.BlockId, len: u32, blk: ir_id.BlockId) u32 {
    var i: u32 = 0;
    for (i < len) {
        if (ir_id.block_same(blocks[i], blk)) { ret i; }
        i = i + 1;
    }
    ret 0;
}

# the `len` blocks at `body` copied within `fn` as new blocks, each clone at the
# same position of `out_clones`: their phis, instructions and terminators,
# with every edge and value inside the region pointing at the copies; the
# clone maps are drawn from `alloc`
pub fun region_clone(m: *me_ir.Module, fn: *me_ir.Function, body: *ir_id.BlockId, len: u32, out_clones: *ir_id.BlockId, alloc: *A.Allocator) err[fail.Fail] {
    var map: CloneMap;
    map.n_blocks = fn.block_count;
    map.n_instrs = fn.instr_len;
    val rbm: res[*u32, A.Error] = A.allocate[u32](alloc, map.n_blocks::usize);
    if (sel rbm.err) { ret err[fail.Fail].err{fail.refused(rbm.err)}; }
    map.block_map = rbm.ok;
    fin { A.deallocate[u32](alloc, map.block_map, map.n_blocks::usize); }
    val rim: res[*u32, A.Error] = A.allocate[u32](alloc, map.n_instrs::usize);
    if (sel rim.err) { ret err[fail.Fail].err{fail.refused(rim.err)}; }
    map.instr_map = rim.ok;
    fin { A.deallocate[u32](alloc, map.instr_map, map.n_instrs::usize); }
    var k: u32 = 0;
    for (k < map.n_blocks) {
        map.block_map[k] = NONE;
        k                = k + 1;
    }
    k = 0;
    for (k < map.n_instrs) {
        map.instr_map[k] = NONE;
        k                = k + 1;
    }

    var bi: u32 = 0;
    for (bi < len) {
        val radd: res[ir_id.BlockId, fail.Fail] = me_ir.block_add(m, fn);
        if (sel radd.err) { ret err[fail.Fail].err{radd.err}; }
        map.block_map[ir_id.block_index(body[bi])] = ir_id.block_index(radd.ok);
        bi                                         = bi + 1;
    }

    bi = 0;
    for (bi < len) {
        val blk: *me_ir.Block = ?fn.blocks[ir_id.block_index(body[bi])];
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            val rc: err[fail.Fail] = clone_one(m, fn, ?map, blk.phis[p]);
            if (sel rc.err) { ret rc; }
            p = p + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val rc: err[fail.Fail] = clone_one(m, fn, ?map, blk.instructions[ii]);
            if (sel rc.err) { ret rc; }
            ii = ii + 1;
        }
        if (!ir_id.instruction_is_nil(blk.terminator)) {
            val rc: err[fail.Fail] = clone_one(m, fn, ?map, blk.terminator);
            if (sel rc.err) { ret rc; }
        }
        bi = bi + 1;
    }

    bi = 0;
    for (bi < len) {
        val rl: err[fail.Fail] = clones_list(m, fn, fn, ?map, body[bi]);
        if (sel rl.err) { ret rl; }
        bi = bi + 1;
    }

    var none: u32 = 0;
    clones_remap[u32](fn, ?map, ?none, value_kept);

    bi = 0;
    for (bi < len) {
        out_clones[bi] = ir_id.block(map.block_map[ir_id.block_index(body[bi])]);
        bi             = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun clone_one(m: *me_ir.Module, fn: *me_ir.Function, map: *CloneMap, src: ir_id.InstructionId) err[fail.Fail] {
    val rc: res[ir_id.InstructionId, fail.Fail] = mutate.clone_instruction_complete(m, fn, fn, src, map.instr_map, map.n_instrs);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    map.instr_map[ir_id.instruction_index(src)] = ir_id.instruction_index(rc.ok);
    ret err[fail.Fail].ok{};
}

fun value_kept(none: *u32, v: value.Value) value.Value {
    ret v;
}

# the clones of block `src` of `src_fn`'s phis, instructions and terminator
# listed in order in its clone in `dst_fn`
pub fun clones_list(m: *me_ir.Module, src_fn: *me_ir.Function, dst_fn: *me_ir.Function, map: *CloneMap, src: ir_id.BlockId) err[fail.Fail] {
    val from: *me_ir.Block = ?src_fn.blocks[ir_id.block_index(src)];
    val to:   *me_ir.Block = ?dst_fn.blocks[map.block_map[ir_id.block_index(src)]];
    var p:    u32          = 0;
    for (p < from.phi_count) {
        val rp: err[fail.Fail] = me_ir.block_append_phi(m, to, ir_id.instruction(map.instr_map[ir_id.instruction_index(from.phis[p])]));
        if (sel rp.err) { ret rp; }
        p = p + 1;
    }
    var ii: u32 = 0;
    for (ii < from.instr_count) {
        val ra: err[fail.Fail] = me_ir.block_append_instr(m, to, ir_id.instruction(map.instr_map[ir_id.instruction_index(from.instructions[ii])]));
        if (sel ra.err) { ret ra; }
        ii = ii + 1;
    }
    if (!ir_id.instruction_is_nil(from.terminator)) {
        to.terminator = ir_id.instruction(map.instr_map[ir_id.instruction_index(from.terminator)]);
    }
    ret err[fail.Fail].ok{};
}

# every clone's operands in `dst_fn` pointed at the clones: a block operand at
# its block's clone, an instruction at its clone, and any other value through
# `other`, each left as it is where the map has no clone
pub fun clones_remap[T](dst_fn: *me_ir.Function, map: *CloneMap, ctx: *T, other: fun(*T, value.Value) value.Value) {
    var s: u32 = 0;
    for (s < map.n_instrs) {
        if (map.instr_map[s] != NONE) {
            val opt_: opt[*ir_instruction.Instruction] = me_ir.instruction_get(dst_fn, ir_id.instruction(map.instr_map[s]));
            if (sel opt_.some) {
                val inst: *ir_instruction.Instruction = opt_.some;
                var o:    u32                         = 0;
                for (o < inst.operand_count) {
                    if (refs.operand_is_block(inst.kind, o)) {
                        val old: u32 = ir_id.block_index(me_ir.block_target(inst.operands[o]));
                        if (old < map.n_blocks && map.block_map[old] != NONE) {
                            me_ir.block_target_set(?inst.operands[o], ir_id.block(map.block_map[old]));
                        }
                    }
                    or (inst.operands[o].kind == value.VAL_INSTR) {
                        val old: u32 = ir_id.instruction_index(inst.operands[o].data.instr);
                        if (old < map.n_instrs && map.instr_map[old] != NONE) {
                            inst.operands[o].data.instr = ir_id.instruction(map.instr_map[old]);
                        }
                    }
                    or {
                        inst.operands[o] = other(ctx, inst.operands[o]);
                    }
                    o = o + 1;
                }
            }
        }
        s = s + 1;
    }
}

# block `blk`'s terminator branching to `to` wherever it branched to `from`
pub fun terminator_redirect(fn: *me_ir.Function, blk: ir_id.BlockId, from: ir_id.BlockId, to: ir_id.BlockId) {
    val b: *me_ir.Block = ?fn.blocks[ir_id.block_index(blk)];
    if (ir_id.instruction_is_nil(b.terminator)) { ret; }
    val opt_: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, b.terminator);
    if (sel opt_.none) { ret; }
    val term: *ir_instruction.Instruction = opt_.some;
    var o:    u32                         = 0;
    for (o < term.operand_count) {
        if (refs.operand_is_block(term.kind, o) && ir_id.block_same(me_ir.block_target(term.operands[o]), from)) {
            me_ir.block_target_set(?term.operands[o], to);
        }
        o = o + 1;
    }
}

# block `blk`'s phis taking from `to` the values they took from `from`
pub fun phi_pred_relabel(fn: *me_ir.Function, blk: ir_id.BlockId, from: ir_id.BlockId, to: ir_id.BlockId) {
    if (ir_id.block_index(blk) >= fn.block_count) { ret; }
    val b:  *me_ir.Block = ?fn.blocks[ir_id.block_index(blk)];
    var pi: u32          = 0;
    for (pi < b.phi_count) {
        val opt_: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, b.phis[pi]);
        if (sel opt_.some) {
            val phi: *ir_instruction.Instruction = opt_.some;
            var o:   u32                         = 0;
            for (o < phi.operand_count) {
                if (refs.operand_is_block(phi.kind, o) && ir_id.block_same(me_ir.block_target(phi.operands[o]), from)) {
                    me_ir.block_target_set(?phi.operands[o], to);
                }
                o = o + 1;
            }
        }
        pi = pi + 1;
    }
}
