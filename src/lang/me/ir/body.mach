use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use A: std.allocator;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.target;
use mach.lang.target.isa;

pub val MAX_INSTRUCTIONS: u32 = 1024;
pub val MAX_BYTES: usize = 262144;
pub val SMALL_INSTRUCTIONS: u32 = 25;

pub rec Budget {
    instructions: u32;
    bytes: usize;
}

pub fun charge(b: *Budget, instructions: u32, bytes: usize) bool {
    if (instructions > MAX_INSTRUCTIONS - b.instructions || bytes > MAX_BYTES - b.bytes) { ret false; }
    b.instructions = b.instructions + instructions;
    b.bytes = b.bytes + bytes;
    ret true;
}

fun candidate(fn: *ir.Function) bool {
    if ((fn.flags & (ir.FN_FLAG_EXTERN | ir.FN_FLAG_NOINLINE | ir.FN_FLAG_SCALAR | ir.FN_FLAG_NAKED)) != 0) { ret false; }
    val live: u32 = live_instructions(fn);
    if (fn.block_count == 0 || live > MAX_INSTRUCTIONS) { ret false; }
    ret (fn.flags & ir.FN_FLAG_INLINE) != 0 || live < SMALL_INSTRUCTIONS;
}

# what a body costs is a fact about the program, never about its debug annotation:
# `-g` must not move an inlining decision (#1944), so a dbg_value instruction and the
# debug variable and expression tables are not part of the body, and neither is a dead
# arena slot. this is the one reading of "counted" every cost below shares.
fun counted(fn: *ir.Function, iid: id.InstructionId) *instruction.Instruction {
    val ins: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel ins.none) { ret nil; }
    val p: *instruction.Instruction = ins.some;
    if (p.kind == instruction.OP_DBG_VALUE) { ret nil; }
    ret p;
}

pub fun live_instructions(fn: *ir.Function) u32 {
    var count: u32 = 0;
    var i: u32 = 0;
    for (i < fn.block_count) {
        val block: *ir.Block = ?fn.blocks[i];
        var j: u32 = 0;
        for (j < block.phi_count) {
            if (counted(fn, block.phis[j]) != nil) { count = count + 1; }
            j = j + 1;
        }
        j = 0;
        for (j < block.instr_count) {
            if (counted(fn, block.instructions[j]) != nil) { count = count + 1; }
            j = j + 1;
        }
        if (counted(fn, block.terminator) != nil) { count = count + 1; }
        i = i + 1;
    }
    ret count;
}

rec Copy {
    dst: *ir.Module;
    src: *ir.Module;
    target: *target.Target;
    scratch: *A.Allocator;
    types: *type.IrTypeId;
    marked: *bool;
    functions: *u32;
    globals: *u32;
}

fun copy_init(c: *Copy, dst: *ir.Module, src: *ir.Module, tgt: *target.Target, a: *A.Allocator) err[fail.Fail] {
    @c = Copy{};
    c.dst = dst; c.src = src; c.target = tgt; c.scratch = a;
    val tr: res[*type.IrTypeId, A.Error] = A.allocate[type.IrTypeId](a, src.types.len::usize);
    if (sel tr.err) { ret err[fail.Fail].err{fail.refused(tr.err)}; }
    c.types = tr.ok;
    val mr: res[*bool, A.Error] = A.allocate[bool](a, src.types.len::usize);
    if (sel mr.err) { copy_dnit(c); ret err[fail.Fail].err{fail.refused(mr.err)}; }
    c.marked = mr.ok;
    val fr: res[*u32, A.Error] = A.allocate[u32](a, src.function_len::usize);
    if (sel fr.err) { copy_dnit(c); ret err[fail.Fail].err{fail.refused(fr.err)}; }
    c.functions = fr.ok;
    val gr: res[*u32, A.Error] = A.allocate[u32](a, src.global_len::usize);
    if (sel gr.err) { copy_dnit(c); ret err[fail.Fail].err{fail.refused(gr.err)}; }
    c.globals = gr.ok;
    var i: u32 = 0;
    for (i < src.types.len) { c.types[i] = type.IRT_NIL; c.marked[i] = false; i = i + 1; }
    i = 0; for (i < src.function_len) { c.functions[i] = 0xFFFFFFFF; i = i + 1; }
    i = 0; for (i < src.global_len) { c.globals[i] = 0xFFFFFFFF; i = i + 1; }
    ret err[fail.Fail].ok{};
}

fun copy_dnit(c: *Copy) {
    if (c.types != nil) { A.deallocate[type.IrTypeId](c.scratch, c.types, c.src.types.len::usize); }
    if (c.marked != nil) { A.deallocate[bool](c.scratch, c.marked, c.src.types.len::usize); }
    if (c.functions != nil) { A.deallocate[u32](c.scratch, c.functions, c.src.function_len::usize); }
    if (c.globals != nil) { A.deallocate[u32](c.scratch, c.globals, c.src.global_len::usize); }
    c.types = nil; c.marked = nil; c.functions = nil; c.globals = nil;
}

fun mark_child(c: *Copy, parent: u32, child: type.IrTypeId) bool {
    if (child::u32 >= parent) { ret false; }
    c.marked[child::u32] = true;
    ret true;
}

fun copy_type(c: *Copy, wanted: type.IrTypeId) res[type.IrTypeId, fail.Fail] {
    if (wanted == type.IRT_NIL) { ret res[type.IrTypeId, fail.Fail].ok{wanted}; }
    if (wanted >= c.src.types.len) { ret res[type.IrTypeId, fail.Fail].err{fail.message("inline body: type id is out of range")}; }
    if (c.types[wanted] != type.IRT_NIL) { ret res[type.IrTypeId, fail.Fail].ok{c.types[wanted]}; }
    c.marked[wanted] = true;
    var i: u32 = wanted + 1;
    for (i > 0) {
        i = i - 1;
        if (!c.marked[i] || c.types[i] != type.IRT_NIL) { cnt; }
        val t: *type.IrType = ?c.src.types.types[i];
        var valid: bool = true;
        if (t.kind == type.IRT_PTR && t.data.pointee != type.IRT_NIL) { valid = mark_child(c, i, t.data.pointee); }
        or (t.kind == type.IRT_ARRAY) { valid = mark_child(c, i, t.data.array_.element); }
        or (t.kind == type.IRT_VECTOR) { valid = mark_child(c, i, t.data.vector_.element); }
        or (t.kind == type.IRT_STRUCT || t.kind == type.IRT_UNION) {
            var j: u32 = 0;
            for (j < t.data.struct_.field_count) { valid = valid && mark_child(c, i, t.data.struct_.fields[j]); j = j + 1; }
        } or (t.kind == type.IRT_TAG) {
            var j: u32 = 0;
            for (j < t.data.tag_.case_count) { valid = valid && mark_child(c, i, t.data.tag_.cases[j]); j = j + 1; }
        } or (t.kind == type.IRT_FN) {
            valid = mark_child(c, i, t.data.fn.ret_type);
            var j: u32 = 0;
            for (j < t.data.fn.param_count) { valid = valid && mark_child(c, i, t.data.fn.params[j]); j = j + 1; }
        } or (t.kind == type.IRT_HANDLE) {
            val schema: *isa.TypeDef = isa.type_def_by_tag(c.target.isa.defs, t.data.handle_.ctor);
            if (schema == nil || schema.arity != t.data.handle_.count) { ret res[type.IrTypeId, fail.Fail].err{fail.message("inline body: handle type has no matching operand schema")}; }
            var j: u32 = 0;
            for (j < schema.arity) {
                if (schema.operands[j] != isa.TYPE_OPERAND_WORD) { valid = valid && mark_child(c, i, t.data.handle_.operands[j]); }
                j = j + 1;
            }
        }
        if (!valid) { ret res[type.IrTypeId, fail.Fail].err{fail.message("inline body: type reference does not precede its owning interned type")}; }
    }
    i = 0;
    for (i <= wanted) {
        if (c.marked[i] && c.types[i] == type.IRT_NIL) {
            val made: res[type.IrTypeId, fail.Fail] = copy_type_ready(c, ?c.src.types.types[i]);
            if (sel made.err) { ret made; }
            c.types[i] = made.ok;
        }
        i = i + 1;
    }
    ret res[type.IrTypeId, fail.Fail].ok{c.types[wanted]};
}

fun copy_type_ready(c: *Copy, t: *type.IrType) res[type.IrTypeId, fail.Fail] {
    val dst: *type.IrTypeTable = ?c.dst.types;
    if (t.kind == type.IRT_VOID) { ret type.intern_void(dst); }
    if (t.kind == type.IRT_INT) { ret type.intern_int(dst, t.data.bits); }
    if (t.kind == type.IRT_FLOAT) { ret type.intern_float(dst, t.data.bits); }
    if (t.kind == type.IRT_PTR) {
        if (t.data.pointee == type.IRT_NIL) { ret type.intern_ptr(dst); }
        ret type.intern_reference(dst, c.types[t.data.pointee]);
    }
    if (t.kind == type.IRT_ARRAY) { ret type.intern_array(dst, c.types[t.data.array_.element], t.data.array_.count); }
    if (t.kind == type.IRT_VECTOR) { ret type.intern_vector(dst, c.types[t.data.vector_.element], t.data.vector_.lanes); }
    var n: u32 = 0;
    var fields: *type.IrTypeId = nil;
    if (t.kind == type.IRT_STRUCT || t.kind == type.IRT_UNION) { n = t.data.struct_.field_count; fields = t.data.struct_.fields; }
    or (t.kind == type.IRT_TAG) { n = t.data.tag_.case_count; fields = t.data.tag_.cases; }
    or (t.kind == type.IRT_FN) { n = t.data.fn.param_count; fields = t.data.fn.params; }
    or (t.kind == type.IRT_HANDLE) { n = t.data.handle_.count; fields = t.data.handle_.operands; }
    or { ret res[type.IrTypeId, fail.Fail].err{fail.message("inline body: unknown IrTypeKind")}; }
    val ar: res[*type.IrTypeId, A.Error] = A.allocate[type.IrTypeId](c.scratch, n::usize);
    if (sel ar.err) { ret res[type.IrTypeId, fail.Fail].err{fail.refused(ar.err)}; }
    val mapped: *type.IrTypeId = ar.ok;
    fin { if (mapped != nil) { A.deallocate[type.IrTypeId](c.scratch, mapped, n::usize); } }
    var schema: *isa.TypeDef = nil;
    if (t.kind == type.IRT_HANDLE) { schema = isa.type_def_by_tag(c.target.isa.defs, t.data.handle_.ctor); }
    var i: u32 = 0;
    for (i < n) {
        mapped[i] = fields[i];
        if (schema == nil || schema.operands[i] != isa.TYPE_OPERAND_WORD) { mapped[i] = c.types[fields[i]]; }
        i = i + 1;
    }
    if (t.kind == type.IRT_STRUCT) { ret type.intern_struct(dst, mapped, n, t.data.struct_.align, t.data.struct_.packed); }
    if (t.kind == type.IRT_UNION) { ret type.intern_union(dst, mapped, n, t.data.struct_.align, t.data.struct_.packed); }
    if (t.kind == type.IRT_TAG) { ret type.intern_tag(dst, mapped, n, t.data.tag_.disc_bytes, t.data.tag_.align, t.data.tag_.packed); }
    if (t.kind == type.IRT_FN) { ret type.intern_fn(dst, c.types[t.data.fn.ret_type], mapped, n, t.data.fn.variadic); }
    ret type.intern_handle(dst, t.data.handle_.ctor, mapped, n);
}

fun copy_slice[T](a: *A.Allocator, src: *T, n: u32) res[*T, fail.Fail] {
    if (n == 0) { ret res[*T, fail.Fail].ok{nil}; }
    if (src == nil) { ret res[*T, fail.Fail].err{fail.message("inline body: missing owned slice")}; }
    val r: res[*T, A.Error] = A.allocate[T](a, n::usize);
    if (sel r.err) { ret res[*T, fail.Fail].err{fail.refused(r.err)}; }
    val dst: *T = r.ok;
    var i: u32 = 0;
    for (i < n) { dst[i] = src[i]; i = i + 1; }
    if (sel r.err) { ret res[*T, fail.Fail].err{fail.refused(r.err)}; }
    ret res[*T, fail.Fail].ok{r.ok};
}

# constant payloads belong to the destination module arena
pub fun own_constant(a: *A.Allocator, original: value.Value) res[value.Value, fail.Fail] {
    var v: value.Value = original;
    if (v.kind == value.VAL_CONST_BYTES) {
        val r: res[*u8, fail.Fail] = copy_slice[u8](a, v.data.bytes.ptr, v.data.bytes.len);
        if (sel r.err) { ret res[value.Value, fail.Fail].err{r.err}; }
        v.data.bytes.ptr = r.ok;
    } or (v.kind == value.VAL_CONST_AGG) {
        val r: res[*u8, fail.Fail] = copy_slice[u8](a, v.data.agg.bytes, v.data.agg.len);
        if (sel r.err) { ret res[value.Value, fail.Fail].err{r.err}; }
        val bytes: *u8 = r.ok;
        val rr: res[*value.AggReloc, fail.Fail] = copy_slice[value.AggReloc](a, v.data.agg.relocs, v.data.agg.reloc_count);
        if (sel rr.err) {
            if (bytes != nil) { A.deallocate[u8](a, bytes, v.data.agg.len::usize); }
            ret res[value.Value, fail.Fail].err{rr.err};
        }
        v.data.agg.bytes = bytes;
        v.data.agg.relocs = rr.ok;
        v.data.agg.reloc_cap = v.data.agg.reloc_count;
    }
    ret res[value.Value, fail.Fail].ok{v};
}

fun function_header(c: *Copy, ix: u32) res[u32, fail.Fail] {
    if (ix >= c.src.function_len) { ret res[u32, fail.Fail].err{fail.message("inline body: function id is out of range")}; }
    if (c.functions[ix] != 0xFFFFFFFF) { ret res[u32, fail.Fail].ok{c.functions[ix]}; }
    val src: *ir.Function = ?c.src.functions[ix];
    val sig: res[type.IrTypeId, fail.Fail] = copy_type(c, src.sig);
    if (sel sig.err) { ret res[u32, fail.Fail].err{sig.err}; }
    val found: opt[u32] = ir.function_lookup(c.dst, src.name);
    if (sel found.some) {
        val at: u32 = found.some;
        if (c.dst.functions[at].sig != sig.ok) { ret res[u32, fail.Fail].err{fail.message("inline body: function identity has incompatible IR signatures")}; }
        var origin: intern.StrId = src.body_module;
        if (origin == intern.STR_NIL && (src.flags & ir.FN_FLAG_EXTERN) == 0) { origin = c.src.name; }
        var current: intern.StrId = c.dst.functions[at].body_module;
        if (current == intern.STR_NIL && (c.dst.functions[at].flags & ir.FN_FLAG_EXTERN) == 0) { current = c.dst.name; }
        val shared_weak: bool = (src.flags & ir.FN_FLAG_WEAK) != 0 && (c.dst.functions[at].flags & ir.FN_FLAG_WEAK) != 0;
        if (origin != intern.STR_NIL && current != intern.STR_NIL && current != origin && !shared_weak) {
            ret res[u32, fail.Fail].err{fail.message("inline body: function identity has conflicting defining modules")};
        }
        # weak specializations retain the first actual provider of their shared linkage
        if (current == intern.STR_NIL) { current = origin; }
        c.dst.functions[at].body_module = current;
        c.functions[ix] = at;
        ret res[u32, fail.Fail].ok{at};
    }
    val added: res[u32, fail.Fail] = ir.function_add(c.dst, src.name, sig.ok, src.flags | ir.FN_FLAG_EXTERN);
    if (sel added.err) { ret added; }
    val at: u32 = added.ok;
    val fn: *ir.Function = ?c.dst.functions[at];
    fn.body_module = src.body_module;
    if (fn.body_module == intern.STR_NIL && (src.flags & ir.FN_FLAG_EXTERN) == 0) { fn.body_module = c.src.name; }
    fn.is_import = src.is_import;
    fn.label = src.label; fn.line = src.line; fn.section = src.section;
    fn.stage = src.stage; fn.wg_x = src.wg_x; fn.wg_y = src.wg_y; fn.wg_z = src.wg_z;
    fn.op_set = src.op_set; fn.op_code = src.op_code; fn.disp = src.disp; fn.ret_sem = src.ret_sem;
    val registered: err[fail.Fail] = ir.function_register(c.dst, src.name, at);
    if (sel registered.err) { ret res[u32, fail.Fail].err{registered.err}; }
    c.functions[ix] = at;
    ret added;
}

fun global_header(c: *Copy, ix: u32) res[u32, fail.Fail] {
    if (ix >= c.src.global_len) { ret res[u32, fail.Fail].err{fail.message("inline body: global id is out of range")}; }
    if (c.globals[ix] != 0xFFFFFFFF) { ret res[u32, fail.Fail].ok{c.globals[ix]}; }
    val src: *ir.Global = ?c.src.globals[ix];
    if (src.is_local) { ret res[u32, fail.Fail].err{fail.message("inline body: local pool address has no cross-module symbol identity")}; }
    val ty: res[type.IrTypeId, fail.Fail] = copy_type(c, src.ty);
    if (sel ty.err) { ret res[u32, fail.Fail].err{ty.err}; }
    val found: opt[u32] = ir.global_lookup(c.dst, src.name);
    if (sel found.some) {
        val at: u32 = found.some;
        if (c.dst.globals[at].ty != ty.ok) { ret res[u32, fail.Fail].err{fail.message("inline body: global identity has incompatible IR types")}; }
        c.globals[ix] = at;
        ret res[u32, fail.Fail].ok{at};
    }
    if (c.dst.global_len == c.dst.global_cap) {
        var cap: u32 = c.dst.global_cap;
        if (cap == 0) { cap = 8; } or { cap = cap * 2; }
        val grown: res[*ir.Global, A.Error] = A.reallocate[ir.Global](c.dst.alloc, c.dst.globals, c.dst.global_cap::usize, cap::usize);
        if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
        c.dst.globals = grown.ok; c.dst.global_cap = cap;
    }
    val at: u32 = c.dst.global_len;
    var g: ir.Global = @src;
    g.ty = ty.ok;
    g.init = value.const_int(0, g.ty);
    g.is_extern = true;
    c.dst.globals[at] = g;
    c.dst.global_len = at + 1;
    val registered: err[fail.Fail] = ir.global_register(c.dst, g.name, at);
    if (sel registered.err) { ret res[u32, fail.Fail].err{registered.err}; }
    c.globals[ix] = at;
    ret res[u32, fail.Fail].ok{at};
}

fun copy_value(c: *Copy, a: *A.Allocator, original: value.Value) res[value.Value, fail.Fail] {
    var v: value.Value = original;
    val ty: res[type.IrTypeId, fail.Fail] = copy_type(c, v.ty);
    if (sel ty.err) { ret res[value.Value, fail.Fail].err{ty.err}; }
    v.ty = ty.ok;
    if (v.kind == value.VAL_FN) {
        val r: res[u32, fail.Fail] = function_header(c, v.data.fn_ix);
        if (sel r.err) { ret res[value.Value, fail.Fail].err{r.err}; }
        v.data.fn_ix = r.ok;
    } or (v.kind == value.VAL_GLOBAL) {
        val r: res[u32, fail.Fail] = global_header(c, v.data.global_ix);
        if (sel r.err) { ret res[value.Value, fail.Fail].err{r.err}; }
        v.data.global_ix = r.ok;
    } or (v.kind > value.VAL_CONST_AGG) { ret res[value.Value, fail.Fail].err{fail.message("inline body: unknown ValueKind")}; }
    ret own_constant(a, v);
}

fun copy_function(c: *Copy, ix: u32, a: *A.Allocator) res[ir.Function, fail.Fail] {
    if (ix >= c.src.function_len) { ret res[ir.Function, fail.Fail].err{fail.message("inline body: function id is out of range")}; }
    val src: *ir.Function = ?c.src.functions[ix];
    val header: res[u32, fail.Fail] = function_header(c, ix);
    if (sel header.err) { ret res[ir.Function, fail.Fail].err{header.err}; }
    val at: u32 = header.ok;
    var fn: ir.Function = ir.function_new(a, src.name, c.dst.functions[at].sig, src.flags);
    fn.body_module = src.body_module;
    if (fn.body_module == intern.STR_NIL && (src.flags & ir.FN_FLAG_EXTERN) == 0) { fn.body_module = c.src.name; }
    fn.is_import = src.is_import;
    fn.label = src.label; fn.line = src.line; fn.section = src.section;
    fn.stage = src.stage; fn.wg_x = src.wg_x; fn.wg_y = src.wg_y; fn.wg_z = src.wg_z;
    fn.op_set = src.op_set; fn.op_code = src.op_code; fn.disp = src.disp; fn.ret_sem = src.ret_sem;
    var storage: ir.Module;
    storage.alloc = a;
    var complete: bool = false;
    fin { if (!complete) { ir.function_dnit(?storage, ?fn); } }
    val params: res[*value.Value, fail.Fail] = copy_slice[value.Value](a, src.params, src.param_count);
    if (sel params.err) { ret res[ir.Function, fail.Fail].err{params.err}; }
    fn.params = params.ok; fn.param_count = src.param_count;
    var i: u32 = 0;
    for (i < fn.param_count) {
        val v: res[value.Value, fail.Fail] = copy_value(c, a, src.params[i]);
        if (sel v.err) { ret res[ir.Function, fail.Fail].err{v.err}; }
        fn.params[i] = v.ok; i = i + 1;
    }
    val br: res[*ir.Block, A.Error] = A.allocate[ir.Block](a, src.block_count::usize);
    if (sel br.err) { ret res[ir.Function, fail.Fail].err{fail.refused(br.err)}; }
    fn.blocks = br.ok; fn.block_cap = src.block_count;
    i = 0; for (i < src.block_count) { fn.blocks[i] = ir.Block{}; i = i + 1; }
    fn.block_count = src.block_count;
    i = 0;
    for (i < src.block_count) {
        val sb: *ir.Block = ?src.blocks[i];
        val db: *ir.Block = ?fn.blocks[i];
        db.id = sb.id; db.terminator = sb.terminator;
        val ins: res[*id.InstructionId, fail.Fail] = copy_slice[id.InstructionId](a, sb.instructions, sb.instr_count);
        if (sel ins.err) { ret res[ir.Function, fail.Fail].err{ins.err}; }
        db.instructions = ins.ok; db.instr_count = sb.instr_count; db.instr_cap = sb.instr_count;
        val phis: res[*id.InstructionId, fail.Fail] = copy_slice[id.InstructionId](a, sb.phis, sb.phi_count);
        if (sel phis.err) { ret res[ir.Function, fail.Fail].err{phis.err}; }
        db.phis = phis.ok; db.phi_count = sb.phi_count; db.phi_cap = sb.phi_count;
        val preds: res[*id.BlockId, fail.Fail] = copy_slice[id.BlockId](a, sb.preds, sb.pred_count);
        if (sel preds.err) { ret res[ir.Function, fail.Fail].err{preds.err}; }
        db.preds = preds.ok; db.pred_count = sb.pred_count; db.pred_cap = sb.pred_count;
        i = i + 1;
    }
    val instrs: res[*instruction.Instruction, A.Error] = A.allocate[instruction.Instruction](a, src.instr_len::usize);
    if (sel instrs.err) { ret res[ir.Function, fail.Fail].err{fail.refused(instrs.err)}; }
    fn.instrs = instrs.ok; fn.instr_cap = src.instr_len;
    i = 0;
    for (i < src.instr_len) {
        val si: *instruction.Instruction = ?src.instrs[i];
        val di: *instruction.Instruction = ?fn.instrs[i];
        @di = @si; di.operands = nil; di.operand_count = 0; di.operand_cap = 0;
        fn.instr_len = i + 1;
        val ty: res[type.IrTypeId, fail.Fail] = copy_type(c, si.ty);
        if (sel ty.err) { ret res[ir.Function, fail.Fail].err{ty.err}; }
        di.ty = ty.ok;
        val aux: res[type.IrTypeId, fail.Fail] = copy_type(c, si.aux_ty);
        if (sel aux.err) { ret res[ir.Function, fail.Fail].err{aux.err}; }
        di.aux_ty = aux.ok;
        val ops: res[*value.Value, fail.Fail] = copy_slice[value.Value](a, si.operands, si.operand_count);
        if (sel ops.err) { ret res[ir.Function, fail.Fail].err{ops.err}; }
        di.operands = ops.ok; di.operand_count = si.operand_count; di.operand_cap = si.operand_count;
        var oi: u32 = 0;
        for (oi < si.operand_count) {
            val v: res[value.Value, fail.Fail] = copy_value(c, a, si.operands[oi]);
            if (sel v.err) { ret res[ir.Function, fail.Fail].err{v.err}; }
            di.operands[oi] = v.ok; oi = oi + 1;
        }
        i = i + 1;
    }
    val sites: res[*ir.InlineSite, fail.Fail] = copy_slice[ir.InlineSite](a, src.inline_sites, src.inline_site_len);
    if (sel sites.err) { ret res[ir.Function, fail.Fail].err{sites.err}; }
    fn.inline_sites = sites.ok; fn.inline_site_len = src.inline_site_len; fn.inline_site_cap = src.inline_site_len;
    val ids: res[*u32, A.Error] = A.allocate[u32](c.scratch, src.instr_len::usize);
    if (sel ids.err) { ret res[ir.Function, fail.Fail].err{fail.refused(ids.err)}; }
    val identity: *u32 = ids.ok;
    fin { if (identity != nil) { A.deallocate[u32](c.scratch, identity, src.instr_len::usize); } }
    i = 0; for (i < src.instr_len) { identity[i] = i; i = i + 1; }
    i = 0;
    for (i < src.instr_len) {
        val iid: id.InstructionId = i::id.InstructionId;
        val dbg: err[fail.Fail] = ir.clone_dbg_metadata(?storage, src, ?fn, iid, iid);
        if (sel dbg.err) { ret res[ir.Function, fail.Fail].err{dbg.err}; }
        val adbg: err[fail.Fail] = ir.clone_alloca_dbg_var(src, ?fn, iid, iid);
        if (sel adbg.err) { ret res[ir.Function, fail.Fail].err{adbg.err}; }
        val dv: opt[*ir.DbgVar] = ir.dbg_var_get(?fn, iid);
        if (sel dv.some) {
            val ty: res[type.IrTypeId, fail.Fail] = copy_type(c, dv.some.ty);
            if (sel ty.err) { ret res[ir.Function, fail.Fail].err{ty.err}; }
            dv.some.ty = ty.ok;
        }
        val av: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(?fn, iid);
        if (sel av.some) {
            val ty: res[type.IrTypeId, fail.Fail] = copy_type(c, av.some.ty);
            if (sel ty.err) { ret res[ir.Function, fail.Fail].err{ty.err}; }
            av.some.ty = ty.ok;
        }
        val assembly: err[fail.Fail] = ir.clone_asm_payload(?storage, src, ?fn, iid, iid, identity, src.instr_len);
        if (sel assembly.err) { ret res[ir.Function, fail.Fail].err{assembly.err}; }
        val site: err[fail.Fail] = ir.clone_instr_inline_site(src, ?fn, iid, iid);
        if (sel site.err) { ret res[ir.Function, fail.Fail].err{site.err}; }
        i = i + 1;
    }
    complete = true;
    ret res[ir.Function, fail.Fail].ok{fn};
}

fun add_bytes(total: *usize, n: usize) bool {
    if (n > MAX_BYTES - @total) { ret false; }
    @total = @total + n;
    ret true;
}

fun mark_type(c: *Copy, seen: *bool, ty: type.IrTypeId) bool {
    if (ty == type.IRT_NIL) { ret true; }
    if (ty >= c.src.types.len) { ret false; }
    seen[ty] = true;
    ret true;
}

fun constant_bytes(v: *value.Value, bytes: *usize) bool {
    if (v.kind == value.VAL_CONST_BYTES) {
        ret add_bytes(bytes, v.data.bytes.len::usize);
    } or (v.kind == value.VAL_CONST_AGG) {
        ret add_bytes(bytes, v.data.agg.len::usize) && add_bytes(bytes, v.data.agg.reloc_count::usize * $size_of(value.AggReloc));
    }
    ret true;
}

fun value_cost(c: *Copy, seen: *bool, v: *value.Value, bytes: *usize) bool {
    if (!mark_type(c, seen, v.ty) || !constant_bytes(v, bytes)) { ret false; }
    if (v.kind == value.VAL_GLOBAL) {
        if (v.data.global_ix >= c.src.global_len || c.src.globals[v.data.global_ix].is_local) { ret false; }
        if (!mark_type(c, seen, c.src.globals[v.data.global_ix].ty) || !add_bytes(bytes, $size_of(ir.Global))) { ret false; }
    } or (v.kind == value.VAL_FN) {
        if (v.data.fn_ix >= c.src.function_len) { ret false; }
        if (!mark_type(c, seen, c.src.functions[v.data.fn_ix].sig) || !add_bytes(bytes, $size_of(ir.Function))) { ret false; }
    } or (v.kind == value.VAL_CONST_AGG) {
        var i: u32 = 0;
        for (i < v.data.agg.reloc_count) {
            val r: *value.AggReloc = ?v.data.agg.relocs[i];
            if (!r.is_fn) {
                var gi: u32 = 0;
                for (gi < c.src.global_len) {
                    if (c.src.globals[gi].name == r.symbol && c.src.globals[gi].is_local) { ret false; }
                    gi = gi + 1;
                }
            }
            i = i + 1;
        }
    }
    ret true;
}

# instruction_cost: one counted instruction's share of the body: its arena slot, its
# block membership, its inline-site entry, its operands and their constant payloads,
# and its assembly bindings. with a Copy the types and module-level values it names are
# marked and priced as well, which is what a cross-module import pays on top.
fun instruction_cost(fn: *ir.Function, c: *Copy, seen: *bool, iid: id.InstructionId, instructions: *u32, bytes: *usize) bool {
    val ins: *instruction.Instruction = counted(fn, iid);
    if (ins == nil) { ret true; }
    @instructions = @instructions + 1;
    if (!add_bytes(bytes, $size_of(instruction.Instruction) + $size_of(id.InstructionId)
            + $size_of(id.InstructionId) + $size_of(u32) + 1)
        || !add_bytes(bytes, ins.operand_count::usize * $size_of(value.Value))) { ret false; }
    if (c != nil && (!mark_type(c, seen, ins.ty) || !mark_type(c, seen, ins.aux_ty))) { ret false; }
    var oi: u32 = 0;
    for (oi < ins.operand_count) {
        val v: *value.Value = ?ins.operands[oi];
        if (c != nil) {
            if (!value_cost(c, seen, v, bytes)) { ret false; }
        } or (!constant_bytes(v, bytes)) { ret false; }
        oi = oi + 1;
    }
    var key: id.InstructionId = iid;
    val assembly: opt[*ir.IrAsm] = map.get[id.InstructionId, ir.IrAsm](?fn.asm_blocks, ?key);
    if (sel assembly.some && (!add_bytes(bytes, $size_of(id.InstructionId) + $size_of(ir.IrAsm) + 1) || !add_bytes(bytes, assembly.some.bind_count::usize * $size_of(ir.IrAsmBind)))) { ret false; }
    ret true;
}

# shape: the growth an inlined copy of fn adds to its host, over the counted
# instructions only, so the same body prices the same with and without `-g`. a nil
# Copy prices the in-module case; a Copy adds what a cross-module import carries.
fun shape(fn: *ir.Function, c: *Copy, seen: *bool, out: *Budget) bool {
    @out = Budget{};
    var instructions: u32 = 0;
    var bytes: usize = 0;
    if (!add_bytes(?bytes, fn.block_count::usize * $size_of(ir.Block))
        || !add_bytes(?bytes, (fn.inline_site_len::usize + 1) * $size_of(ir.InlineSite))) { ret false; }
    var i: u32 = 0;
    for (i < fn.block_count) {
        val b: *ir.Block = ?fn.blocks[i];
        if (!add_bytes(?bytes, b.pred_count::usize * $size_of(id.BlockId))) { ret false; }
        var j: u32 = 0;
        for (j < b.phi_count) {
            if (!instruction_cost(fn, c, seen, b.phis[j], ?instructions, ?bytes)) { ret false; }
            j = j + 1;
        }
        j = 0;
        for (j < b.instr_count) {
            if (!instruction_cost(fn, c, seen, b.instructions[j], ?instructions, ?bytes)) { ret false; }
            j = j + 1;
        }
        if (!instruction_cost(fn, c, seen, b.terminator, ?instructions, ?bytes)) { ret false; }
        i = i + 1;
    }
    if (instructions > MAX_INSTRUCTIONS) { ret false; }
    out.instructions = instructions;
    out.bytes = bytes;
    ret true;
}

fun measure(c: *Copy, fn: *ir.Function, out: *Budget) res[bool, fail.Fail] {
    @out = Budget{};
    if (!candidate(fn)) { ret res[bool, fail.Fail].ok{false}; }
    val ar: res[*bool, A.Error] = A.allocate[bool](c.scratch, c.src.types.len::usize);
    if (sel ar.err) { ret res[bool, fail.Fail].err{fail.refused(ar.err)}; }
    val seen: *bool = ar.ok;
    fin { if (seen != nil) { A.deallocate[bool](c.scratch, seen, c.src.types.len::usize); } }
    var i: u32 = 0;
    for (i < c.src.types.len) { seen[i] = false; i = i + 1; }
    var body_cost: Budget;
    if (!shape(fn, c, seen, ?body_cost)) { ret res[bool, fail.Fail].ok{false}; }
    var bytes: usize = body_cost.bytes;
    if (!mark_type(c, seen, fn.sig) || !add_bytes(?bytes, $size_of(ir.Function)) || !add_bytes(?bytes, fn.param_count::usize * $size_of(value.Value))) { ret res[bool, fail.Fail].ok{false}; }
    i = 0;
    for (i < fn.param_count) { if (!value_cost(c, seen, ?fn.params[i], ?bytes)) { ret res[bool, fail.Fail].ok{false}; } i = i + 1; }
    i = c.src.types.len;
    for (i > 0) {
        i = i - 1;
        if (!seen[i]) { cnt; }
        val t: *type.IrType = ?c.src.types.types[i];
        if (!add_bytes(?bytes, $size_of(type.IrType) * 3)) { ret res[bool, fail.Fail].ok{false}; }
        var fields: *type.IrTypeId = nil;
        var count: u32 = 0;
        var single: type.IrTypeId = type.IRT_NIL;
        if (t.kind == type.IRT_PTR) { single = t.data.pointee; }
        or (t.kind == type.IRT_ARRAY) { single = t.data.array_.element; }
        or (t.kind == type.IRT_VECTOR) { single = t.data.vector_.element; }
        or (t.kind == type.IRT_STRUCT || t.kind == type.IRT_UNION) { fields = t.data.struct_.fields; count = t.data.struct_.field_count; }
        or (t.kind == type.IRT_FN) { single = t.data.fn.ret_type; fields = t.data.fn.params; count = t.data.fn.param_count; }
        or (t.kind == type.IRT_HANDLE) { fields = t.data.handle_.operands; count = t.data.handle_.count; }
        if (single != type.IRT_NIL && (single >= i || !mark_type(c, seen, single))) { ret res[bool, fail.Fail].err{fail.message("inline body: invalid forward type reference")}; }
        if (!add_bytes(?bytes, count::usize * $size_of(type.IrTypeId))) { ret res[bool, fail.Fail].ok{false}; }
        var schema: *isa.TypeDef = nil;
        if (t.kind == type.IRT_HANDLE) {
            schema = isa.type_def_by_tag(c.target.isa.defs, t.data.handle_.ctor);
            if (schema == nil || schema.arity != count) { ret res[bool, fail.Fail].err{fail.message("inline body: handle schema is unavailable")}; }
        }
        var j: u32 = 0;
        for (j < count) {
            if (schema == nil || schema.operands[j] != isa.TYPE_OPERAND_WORD) {
                if (fields[j] >= i || !mark_type(c, seen, fields[j])) { ret res[bool, fail.Fail].err{fail.message("inline body: invalid forward type reference")}; }
            }
            j = j + 1;
        }
    }
    out.instructions = body_cost.instructions;
    out.bytes = bytes;
    ret res[bool, fail.Fail].ok{true};
}

pub fun extract(dst: *ir.Module, src: *ir.Module, tgt: *target.Target, scratch: *A.Allocator, recursive: *bool) err[fail.Fail] {
    var c: Copy;
    val initialized: err[fail.Fail] = copy_init(?c, dst, src, tgt, scratch);
    if (sel initialized.err) { ret initialized; }
    fin { copy_dnit(?c); }
    var budget: Budget;
    var i: u32 = 0;
    for (i < src.function_len) {
        if (recursive != nil && recursive[i]) { i = i + 1; cnt; }
        var cost: Budget;
        val eligible: res[bool, fail.Fail] = measure(?c, ?src.functions[i], ?cost);
        if (sel eligible.err) { ret err[fail.Fail].err{eligible.err}; }
        if (eligible.ok && charge(?budget, cost.instructions, cost.bytes)) {
            val fn: res[ir.Function, fail.Fail] = copy_function(?c, i, dst.alloc);
            if (sel fn.err) { ret err[fail.Fail].err{fn.err}; }
            val at: u32 = c.functions[i];
            ir.function_dnit(dst, ?dst.functions[at]);
            dst.functions[at] = fn.ok;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# one attached body: which declaration of the importer it stands in for,
# and that declaration while it does
pub rec Slot {
    index: u32;
    original: ir.Function;
}

# the store owns its storage module and its slot table explicitly and
# releases them through `alloc`; a store opened by `available_init` also
# owns the module home that allocator comes from
pub rec Available {
    home: ir.ModuleHome;
    owns_home: bool;
    alloc: *A.Allocator;
    storage: ir.Module;
    slots: *Slot;
    len: u32;
    cap: u32;
    budget: Budget;
    attached: bool;
}

pub fun available_init(a: *Available, name: intern.StrId) err[fail.Fail] {
    @a = Available{};
    val opened: err[fail.Fail] = ir.home_init(?a.home);
    if (sel opened.err) { ret err[fail.Fail].err{opened.err}; }
    a.owns_home = true;
    val initialized: err[fail.Fail] = open(a, name, ?a.home.alloc);
    if (sel initialized.err) { ir.home_dnit(?a.home); a.owns_home = false; }
    ret initialized;
}

# a store over the caller's allocator, which then sees every request the
# cross-module clone makes
pub fun available_init_over(a: *Available, name: intern.StrId, alloc: *A.Allocator) err[fail.Fail] {
    @a = Available{};
    ret open(a, name, alloc);
}

fun open(a: *Available, name: intern.StrId, alloc: *A.Allocator) err[fail.Fail] {
    a.alloc = alloc;
    val initialized: res[ir.Module, fail.Fail] = ir.init(alloc, name);
    if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
    a.storage = initialized.ok;
    ret err[fail.Fail].ok{};
}

pub fun detach(a: *Available, dst: *ir.Module) {
    if (a == nil || !a.attached) { ret; }
    var i: u32 = 0;
    for (i < a.len) { dst.functions[a.slots[i].index] = a.slots[i].original; i = i + 1; }
    a.attached = false;
}

pub fun available_dnit(a: *Available, dst: *ir.Module) {
    if (a == nil) { ret; }
    detach(a, dst);
    if (a.alloc != nil) {
        ir.dnit(?a.storage);
        if (a.slots != nil && a.cap > 0) { A.deallocate[Slot](a.alloc, a.slots, a.cap::usize); }
    }
    a.slots = nil;
    a.len = 0;
    a.cap = 0;
    a.alloc = nil;
    if (a.owns_home) { ir.home_dnit(?a.home); a.owns_home = false; }
}

pub fun attach(a: *Available, dst: *ir.Module) err[fail.Fail] {
    if (a == nil) { ret err[fail.Fail].ok{}; }
    if (a.attached) { ret err[fail.Fail].err{fail.message("inline body: available bodies already attached")}; }
    var i: u32 = 0;
    for (i < a.len) {
        val ix: u32 = a.slots[i].index;
        if (ix >= dst.function_len || (dst.functions[ix].flags & ir.FN_FLAG_EXTERN) == 0 || dst.functions[ix].block_count != 0) { ret err[fail.Fail].err{fail.message("inline body: destination is not the original external declaration")}; }
        i = i + 1;
    }
    i = 0;
    for (i < a.len) {
        val ix: u32 = a.slots[i].index;
        a.slots[i].original = dst.functions[ix];
        dst.functions[ix] = a.storage.functions[i];
        dst.functions[ix].flags = dst.functions[ix].flags | ir.FN_FLAG_EXTERN;
        i = i + 1;
    }
    a.attached = true;
    ret err[fail.Fail].ok{};
}

pub fun contains(a: *Available, ix: u32) bool {
    if (a == nil) { ret false; }
    var i: u32 = 0;
    for (i < a.len) { if (a.slots[i].index == ix) { ret true; } i = i + 1; }
    ret false;
}

pub fun acquire(a: *Available, dst: *ir.Module, provider: *ir.Module, name: intern.StrId, tgt: *target.Target, scratch: *A.Allocator) err[fail.Fail] {
    if (a.attached) { ret err[fail.Fail].err{fail.message("inline body: cannot import during inline execution")}; }
    val found: opt[u32] = ir.function_lookup(provider, name);
    if (sel found.none) { ret err[fail.Fail].ok{}; }
    val i: u32 = found.some;
    var c: Copy;
    val initialized: err[fail.Fail] = copy_init(?c, dst, provider, tgt, scratch);
    if (sel initialized.err) { ret initialized; }
    fin { copy_dnit(?c); }
    val src: *ir.Function = ?provider.functions[i];
    val existing: opt[u32] = ir.function_lookup(dst, src.name);
    if (sel existing.none) { ret err[fail.Fail].ok{}; }
    if (!candidate(src)) { ret err[fail.Fail].ok{}; }
    val ix: u32 = existing.some;
    if ((dst.functions[ix].flags & ir.FN_FLAG_EXTERN) == 0 || contains(a, ix)) { ret err[fail.Fail].ok{}; }
    var cost: Budget;
    val measured: res[bool, fail.Fail] = measure(?c, src, ?cost);
    if (sel measured.err) { ret err[fail.Fail].err{measured.err}; }
    if (!measured.ok) { ret err[fail.Fail].ok{}; }
    if (!charge(?a.budget, cost.instructions, cost.bytes)) { ret err[fail.Fail].ok{}; }
    # the slot table grows before the copy is made, so a refusal never
    # strands a copied function that no slot names
    if (a.len == a.cap) {
        var cap: u32 = 8;
        if (a.cap != 0) { cap = a.cap * 2; }
        val slots: res[*Slot, A.Error] = A.reallocate[Slot](a.alloc, a.slots, a.cap::usize, cap::usize);
        if (sel slots.err) { ret err[fail.Fail].err{fail.refused(slots.err)}; }
        a.slots = slots.ok;
        a.cap = cap;
    }
    val copied: res[ir.Function, fail.Fail] = copy_function(?c, i, a.alloc);
    if (sel copied.err) { ret err[fail.Fail].err{copied.err}; }
    var fn: ir.Function = copied.ok;
    val added: res[u32, fail.Fail] = ir.function_add(?a.storage, src.name, fn.sig, src.flags);
    if (sel added.err) { ir.function_dnit(?a.storage, ?fn); ret err[fail.Fail].err{added.err}; }
    val at: u32 = added.ok;
    ir.function_dnit(?a.storage, ?a.storage.functions[at]);
    a.storage.functions[at] = fn;
    a.slots[a.len].index = ix;
    a.len = a.len + 1;
    ret err[fail.Fail].ok{};
}

pub fun growth_cost(fn: *ir.Function, out: *Budget) bool {
    ret shape(fn, nil, nil, out);
}

use std.allocator.page;
use T: std.allocator.testing;
use mach.lang.me.ir.builder;
use semtype: mach.lang.type;
use me_testing: mach.lang.me.testing;
use mach.lang.me.scratch;

test "mach.lang.me.ir.body:owned_constants_types_and_effect_flags_survive_provider_retirement" {
    var source_home: ir.ModuleHome;
    val r_736: err[fail.Fail] = ir.home_init(?source_home);
    if (sel r_736.err) { ret 1; }
    var source_live: bool = true;
    fin { if (source_live) { ir.home_dnit(?source_home); } }
    var dest_home: ir.ModuleHome;
    val r_740: err[fail.Fail] = ir.home_init(?dest_home);
    if (sel r_740.err) { ret 2; }
    fin { ir.home_dnit(?dest_home); }
    val sr: res[ir.Module, fail.Fail] = ir.init(?source_home.alloc, 1);
    val dr: res[ir.Module, fail.Fail] = ir.init(?dest_home.alloc, 1);
    if (sel sr.err) { ret 3; }
    if (sel dr.err) { ret 3; }
    var src: ir.Module = sr.ok;
    var dst: ir.Module = dr.ok;
    val byte: res[type.IrTypeId, fail.Fail] = type.intern_int(?src.types, 8);
    if (sel byte.err) { ret 4; }
    val array: res[type.IrTypeId, fail.Fail] = type.intern_array(?src.types, byte.ok, 4);
    if (sel array.err) { ret 5; }
    val aty: type.IrTypeId = array.ok;
    val signature: res[type.IrTypeId, fail.Fail] = type.intern_fn(?src.types, aty, nil, 0, false);
    if (sel signature.err) { ret 6; }
    val added: res[u32, fail.Fail] = ir.function_add(?src, 2, signature.ok, ir.FN_FLAG_INLINE);
    if (sel added.err) { ret 7; }
    val r_757: err[fail.Fail] = ir.function_register(?src, 2, 0);
    if (sel r_757.err) { ret 7; }
    var b: builder.Builder = builder.init(?src);
    builder.set_function(?b, ?src.functions[0]);
    val block: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel block.err) { ret 8; }
    builder.set_block(?b, block.ok);
    var payload: [4]u8 = [4]u8{7, 11, 19, 23};
    var result: value.Value = value.const_agg(?payload[0], 4, nil, 0, 0, aty);
    result.secret = true;
    val r_766: err[fail.Fail] = builder.emit_ret(?b, result);
    if (sel r_766.err) { ret 9; }
    val term: id.InstructionId = src.functions[0].blocks[0].terminator;
    src.functions[0].instrs[term].secret = true;
    src.functions[0].instrs[term].flags = instruction.INSTR_FLAG_EXACT;
    var backing: A.Allocator;
    val r_771: err[A.Error] = page.make(?backing);
    if (sel r_771.err) { ret 10; }
    val r_772: res[type.IrTypeId, fail.Fail] = type.intern_float(?dst.types, 64);
    if (sel r_772.err) { ret 11; }
    var tgt: target.Target;
    val copied: err[fail.Fail] = extract(?dst, ?src, ?tgt, ?backing, nil);
    if (sel copied.err) { ret 12; }
    ir.home_dnit(?source_home);
    source_live = false;
    payload[0] = 99;
    val found: opt[u32] = ir.function_lookup(?dst, 2);
    if (sel found.none) { ret 13; }
    val fn: *ir.Function = ?dst.functions[found.some];
    val ins: *instruction.Instruction = ?fn.instrs[fn.blocks[0].terminator];
    val owned: *value.Value = ?ins.operands[0];
    if (fn.body_module != 1 || (fn.flags & ir.FN_FLAG_EXTERN) != 0 || !owned.secret || !ins.secret
        || ins.flags != instruction.INSTR_FLAG_EXACT || owned.data.agg.bytes == ?payload[0]
        || owned.data.agg.bytes[0] != 7 || owned.data.agg.bytes[3] != 23) { ret 14; }
    if (dst.types.types[owned.ty].kind != type.IRT_ARRAY || dst.types.types[owned.ty].data.array_.count != 4
        || dst.types.types[dst.types.types[owned.ty].data.array_.element].data.bits != 8) { ret 15; }
    ret 0;
}

fun scratch_attempt(src: *ir.Module, ordinal: usize, attempts: *usize) i32 {
    var testing: T.Testing;
    val r_794: err[A.Error] = T.make(?testing);
    if (sel r_794.err) { ret 1; }
    fin { T.dnit(?testing); }
    T.fail_at_ordinal(?testing, ordinal);
    var home: ir.ModuleHome;
    val r_798: err[fail.Fail] = ir.home_init(?home);
    if (sel r_798.err) { ret 2; }
    fin { ir.home_dnit(?home); }
    val made: res[ir.Module, fail.Fail] = ir.init(?home.alloc, src.name);
    if (sel made.err) { ret 3; }
    var dst: ir.Module = made.ok;
    var tgt: target.Target;
    val copied: err[fail.Fail] = extract(?dst, src, ?tgt, T.allocator_of(?testing), nil);
    @attempts = T.attempt_count(?testing);
    if ((ordinal == 0) != sel copied.ok) { ret 4; }
    if (T.leaked(?testing) || T.double_free_count(?testing) != 0 || T.tracking_exhausted(?testing)) { ret 5; }
    ret 0;
}

test "mach.lang.me.ir.body:scratch_refusal_releases_partial_remapping_and_budget_refusal_does_not_charge" {
    var home: ir.ModuleHome;
    val r_813: err[fail.Fail] = ir.home_init(?home);
    if (sel r_813.err) { ret 1; }
    fin { ir.home_dnit(?home); }
    val made: res[ir.Module, fail.Fail] = ir.init(?home.alloc, 1);
    if (sel made.err) { ret 2; }
    var src: ir.Module = made.ok;
    val vt: res[type.IrTypeId, fail.Fail] = type.intern_void(?src.types);
    if (sel vt.err) { ret 3; }
    val signature: res[type.IrTypeId, fail.Fail] = type.intern_fn(?src.types, vt.ok, nil, 0, false);
    if (sel signature.err) { ret 4; }
    val r_822: res[u32, fail.Fail] = ir.function_add(?src, 2, signature.ok, ir.FN_FLAG_INLINE);
    if (sel r_822.err) { ret 5; }
    var b: builder.Builder = builder.init(?src);
    builder.set_function(?b, ?src.functions[0]);
    val block: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel block.err) { ret 6; }
    builder.set_block(?b, block.ok);
    val r_828: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_828.err) { ret 7; }
    var attempts: usize = 0;
    if (scratch_attempt(?src, 0, ?attempts) != 0 || attempts == 0) { ret 8; }
    var ordinal: usize = 1;
    for (ordinal <= attempts) {
        var ignored: usize = 0;
        if (scratch_attempt(?src, ordinal, ?ignored) != 0) { ret 9; }
        ordinal = ordinal + 1;
    }
    var budget: Budget;
    if (!charge(?budget, MAX_INSTRUCTIONS - 1, MAX_BYTES - 1)) { ret 10; }
    if (charge(?budget, 2, 0) || charge(?budget, 0, 2)
        || budget.instructions != MAX_INSTRUCTIONS - 1 || budget.bytes != MAX_BYTES - 1) { ret 11; }
    if (!charge(?budget, 1, 1) || budget.instructions != MAX_INSTRUCTIONS || budget.bytes != MAX_BYTES) { ret 12; }
    ret 0;
}

# the same program annotated for `-g` and not: an alloca, a debug variable on it, a
# dbg_value reading it, a return. every cost a decision reads must agree, or `-g`
# moves an inlining decision and the release image stops being byte-additive (#1944).
fun annotated_pair(m: *ir.Module, i64t: type.IrTypeId, sig: type.IrTypeId) i32 {
    var b: builder.Builder = builder.init(m);
    var k: u32 = 0;
    for (k < 2) {
        val added: res[u32, fail.Fail] = ir.function_add(m, (2 + k)::intern.StrId, sig, 0);
        if (sel added.err) { ret 1; }
        val fn: *ir.Function = ?m.functions[added.ok];
        builder.set_function(?b, fn);
        val block: res[id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel block.err) { ret 2; }
        builder.set_block(?b, block.ok);
        val slot: res[value.Value, fail.Fail] = builder.emit_alloca(?b, i64t, value.const_int(1, i64t));
        if (sel slot.err) { ret 3; }
        if (k == 1) {
            var dv: ir.DbgVar;
            dv.name = 9::intern.StrId;
            dv.ty   = i64t;
            val r_865: err[fail.Fail] = ir.record_alloca_dbg_var(fn, slot.ok.data.instr, dv);
            if (sel r_865.err) { ret 4; }
            val r_866: err[fail.Fail] = builder.emit_dbg_value(?b, slot.ok, 9::intern.StrId, i64t, semtype.TYPE_NIL, false, 0);
            if (sel r_866.err) { ret 5; }
        }
        val r_868: err[fail.Fail] = builder.emit_ret_void(?b);
        if (sel r_868.err) { ret 6; }
        k = k + 1;
    }
    ret 0;
}

test "mach.lang.me.ir.body:debug_annotation_does_not_move_a_bodys_cost" {
    var home: ir.ModuleHome;
    val r_876: err[fail.Fail] = ir.home_init(?home);
    if (sel r_876.err) { ret 1; }
    fin { ir.home_dnit(?home); }
    val made: res[ir.Module, fail.Fail] = ir.init(?home.alloc, 1);
    if (sel made.err) { ret 2; }
    var src: ir.Module = made.ok;
    val vt: res[type.IrTypeId, fail.Fail] = type.intern_void(?src.types);
    val it: res[type.IrTypeId, fail.Fail] = type.intern_int(?src.types, 64);
    if (sel vt.err) { ret 3; }
    if (sel it.err) { ret 3; }
    val i64t: type.IrTypeId = it.ok;
    val signature: res[type.IrTypeId, fail.Fail] = type.intern_fn(?src.types, vt.ok, nil, 0, false);
    if (sel signature.err) { ret 4; }
    val built: i32 = annotated_pair(?src, i64t, signature.ok);
    if (built != 0) { ret 10 + built; }
    val plain: *ir.Function = ?src.functions[0];
    val annotated: *ir.Function = ?src.functions[1];
    if (annotated.instr_len == plain.instr_len || annotated.alloca_dbg_vars.cap == 0) { ret 20; }
    if (live_instructions(plain) != 2 || live_instructions(annotated) != 2 || !candidate(plain) || !candidate(annotated)) { ret 21; }
    var plain_cost: Budget;
    var annotated_cost: Budget;
    if (!growth_cost(plain, ?plain_cost) || !growth_cost(annotated, ?annotated_cost)) { ret 22; }
    if (plain_cost.instructions != 2 || annotated_cost.instructions != plain_cost.instructions
        || annotated_cost.bytes != plain_cost.bytes) { ret 23; }
    var dst_home: ir.ModuleHome;
    val r_900: err[fail.Fail] = ir.home_init(?dst_home);
    if (sel r_900.err) { ret 24; }
    fin { ir.home_dnit(?dst_home); }
    val made_dst: res[ir.Module, fail.Fail] = ir.init(?dst_home.alloc, 5);
    if (sel made_dst.err) { ret 25; }
    var dst: ir.Module = made_dst.ok;
    var backing: A.Allocator;
    val r_906: err[A.Error] = page.make(?backing);
    if (sel r_906.err) { ret 26; }
    var tgt: target.Target;
    var c: Copy;
    val r_909: err[fail.Fail] = copy_init(?c, ?dst, ?src, ?tgt, ?backing);
    if (sel r_909.err) { ret 27; }
    fin { copy_dnit(?c); }
    val plain_measured: res[bool, fail.Fail] = measure(?c, plain, ?plain_cost);
    val annotated_measured: res[bool, fail.Fail] = measure(?c, annotated, ?annotated_cost);
    if (sel plain_measured.err) { ret 28; }
    if (sel annotated_measured.err) { ret 28; }
    if (!plain_measured.ok) { ret 28; }
    if (!annotated_measured.ok) { ret 28; }
    if (annotated_cost.instructions != plain_cost.instructions || annotated_cost.bytes != plain_cost.bytes) { ret 29; }
    ret 0;
}

# the provider the product walk extracts from: an `#[inline]` function whose
# body carries an owned constant aggregate, so the copy interns types, clones
# instructions and takes ownership of bytes
fun probe_provider(m: *ir.Module) i32 {
    val vt: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel vt.err) { ret 1; }
    val i64t: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel i64t.err) { ret 2; }
    var pi: type.IrTypeId = i64t.ok;
    val signature: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t.ok, ?pi, 1, false);
    if (sel signature.err) { ret 3; }
    val added: res[u32, fail.Fail] = ir.function_add(m, 2, signature.ok, ir.FN_FLAG_INLINE | ir.FN_FLAG_PUB);
    if (sel added.err) { ret 4; }
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[added.ok]);
    val block: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel block.err) { ret 5; }
    builder.set_block(?b, block.ok);
    val doubled: res[value.Value, fail.Fail] = builder.emit_add(?b, value.param(0, i64t.ok), value.param(0, i64t.ok));
    if (sel doubled.err) { ret 6; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?b, doubled.ok);
    if (sel r_ret.err) { ret 7; }
    ret 0;
}

fun probe_build_product(a: *me_testing.Attempt, m: *ir.Module) i32 { ret 0; }

fun probe_extract(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    val provider: *ir.Module = a.context::*ir.Module;
    val copied: err[fail.Fail] = extract(m, provider, a.target, ?workspace.alloc, nil);
    if (sel copied.err) { ret res[bool, fail.Fail].err{copied.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# the product is built into a module of its own and released whole by its
# owner on a refusal, so the contract is that it stays releasable and never
# names more functions than the provider has
fun probe_product_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    val provider: *ir.Module = a.context::*ir.Module;
    ret m.function_len <= provider.function_len;
}

test "mach.lang.me.ir.body.extract:refusal_at_every_ordinal_leaves_a_releasable_partial_product" {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    val initialized: res[ir.Module, fail.Fail] = ir.init(?owner, 1);
    if (sel initialized.err) { ret 2; }
    var provider: ir.Module = initialized.ok;
    fin { ir.dnit(?provider); }
    if (probe_provider(?provider) != 0) { ret 3; }
    var tgt: target.Target;
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build_product, transform: probe_extract,
        contract: probe_product_contract, target: ?tgt, control: nil, context: (?provider)::ptr};
    ret me_testing.walk(?a);
}
