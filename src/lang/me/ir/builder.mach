pub fun emit_vec_insert(b: *Builder, vec: value.Value, lane: value.Value, value_: value.Value) R.Result[value.Value, str] {
    var ops: [3]value.Value;
    ops[0] = vec;
    ops[1] = lane;
    ops[2] = value_;
    val res_iid: R.Result[id.InstructionId, str] = emit_raw(b, instruction.OP_VEC_INSERT, vec.ty, ?ops[0], 3);
    if (R.is_err[id.InstructionId, str](res_iid)) {
