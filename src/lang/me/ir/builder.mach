use mach.lang.fail;
use std.allocator.page;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std_allocator: std.allocator;

use mach.lang.intern;
use me_ir:          mach.lang.me.ir;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lang_source: mach.lang.source;

use mach.lang.type;

pub rec Builder {
    m:     *me_ir.Module;
    fn:    *me_ir.Function;
    block: ir_id.BlockId;
    loc:   lang_source.SrcLoc;
}

pub fun init(m: *me_ir.Module) Builder {
    var b: Builder;
    b.m     = m;
    b.fn    = nil;
    b.block = ir_id.BLOCK_NIL;
    b.loc   = lang_source.loc_nil();
    ret b;
}

pub fun set_function(b: *Builder, fn: *me_ir.Function) {
    b.fn    = fn;
    b.block = ir_id.BLOCK_NIL;
    b.loc   = lang_source.loc_nil();
}

pub fun set_loc(b: *Builder, loc: lang_source.SrcLoc) {
    b.loc = loc;
}

pub fun current_loc(b: *Builder) lang_source.SrcLoc {
    ret b.loc;
}

pub fun set_block(b: *Builder, blk: ir_id.BlockId) {
    b.block = blk;
}

pub fun new_block(b: *Builder) res[ir_id.BlockId, fail.Fail] {
    if (b.fn == nil) {
        ret res[ir_id.BlockId, fail.Fail].err{fail.message("builder: new_block with no current function")};
    }
    ret me_ir.block_add(b.m, b.fn);
}

pub fun emit_add(b: *Builder, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    ret emit_binary(b, ir_instruction.OP_ADD, lhs, rhs);
}

