pub fun mark_last_secret(b: *Builder) {
    if (b.fn == nil)         { ret; }
    if (b.fn.instr_len == 0) { ret; }
    b.fn.instrs[b.fn.instr_len - 1].secret = true;
}

pub fun mark_last_volatile(b: *Builder) {
    if (b.fn == nil)         { ret; }
    if (b.fn.instr_len == 0) { ret; }
    val last: u32 = b.fn.instr_len - 1;
    b.fn.instrs[last].flags = b.fn.instrs[last].flags | ir_instruction.INSTR_FLAG_VOLATILE;
}

pub fun emit_declassify(b: *Builder, operand: value.Value) res[value.Value, fail.Fail] {
    ret emit_unary(b, ir_instruction.OP_DECLASSIFY, operand, operand.ty);
}

pub fun emit_alloca(b: *Builder, ty: ir_type.IrTypeId, count: value.Value) res[value.Value, fail.Fail] {
    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret res[value.Value, fail.Fail].err{res_ptr.err};
    }
    val ptr_ty: ir_type.IrTypeId = res_ptr.ok;

    var ops: [1]value.Value;
    ops[0] = count;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_ALLOCA, ptr_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[ir_id.instruction_index(iid)].aux_ty = ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ptr_ty)};
}

pub fun emit_load(b: *Builder, ptr: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = ptr;
    ret emit_value_instr(b, ir_instruction.OP_LOAD, ty, ?ops[0], 1);
}

pub fun emit_store(b: *Builder, value_arg: value.Value, ptr: value.Value) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [2]value.Value;
    ops[0] = value_arg;
    ops[1] = ptr;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_STORE, void_ty, ?ops[0], 2);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    if (value_arg.secret) {
        val siid: ir_id.InstructionId = res_iid.ok;
        if (siid::u32 < b.fn.instr_len) { b.fn.instrs[siid::u32].secret = true; }
    }
    ret err[fail.Fail].ok{};
}

pub fun emit_memzero(b: *Builder, ptr: value.Value, pointee_ty: ir_type.IrTypeId) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [1]value.Value;
    ops[0] = ptr;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_MEMZERO, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[ir_id.instruction_index(iid)].aux_ty = pointee_ty;
    ret err[fail.Fail].ok{};
}

pub fun emit_gep(b: *Builder, base: value.Value, src_ty: ir_type.IrTypeId, indices: *value.Value, index_count: u32) res[value.Value, fail.Fail] {
    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret res[value.Value, fail.Fail].err{res_ptr.err};
    }
    val ptr_ty: ir_type.IrTypeId = res_ptr.ok;

    val total:   u32                        = index_count + 1;
    val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](b.m.alloc, total::usize);
    if (sel res_ops.err) {
        ret res[value.Value, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *value.Value = res_ops.ok;
    ops[0] = base;
    var i: u32 = 0;
    for (i < index_count) {
        ops[1 + i] = indices[i];
        i          = i + 1;
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw_owned(b, ir_instruction.OP_GEP, ptr_ty, ops, total);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[ir_id.instruction_index(iid)].aux_ty = src_ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ptr_ty)};
}

pub fun emit_vec_extract(b: *Builder, vec: value.Value, lane: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = vec;
    ops[1] = lane;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_VEC_EXTRACT, ty, ?ops[0], 2);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[ir_id.instruction_index(iid)].aux_ty = vec.ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

pub fun emit_vec_insert(b: *Builder, vec: value.Value, lane: value.Value, value_: value.Value) res[value.Value, fail.Fail] {
    var ops: [3]value.Value;
    ops[0] = vec;
    ops[1] = lane;
    ops[2] = value_;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_VEC_INSERT, vec.ty, ?ops[0], 3);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[ir_id.instruction_index(iid)].aux_ty = vec.ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, vec.ty)};
}

# the lane-halving extension of the half of `src` whose first lane is `base`:
# a vector of half the lanes at twice the width, sign- or zero-extended
pub fun emit_vec_widen_half(b: *Builder, signed: bool, src: value.Value, base: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = src;
    ops[1] = base;
    var k: ir_instruction.InstrKind = ir_instruction.OP_VEC_WIDEN_U;
    if (signed) { k = ir_instruction.OP_VEC_WIDEN_S; }
    ret emit_value_instr(b, k, ty, ?ops[0], 2);
}

# each lane of `ty` the zero-extended sum of the lanes of `src` it covers
pub fun emit_vec_widen_sum_u(b: *Builder, src: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = src;
    ret emit_value_instr(b, ir_instruction.OP_VEC_WIDEN_SUM_U, ty, ?ops[0], 1);
}

# the `ty` lanes of `src` from constant lane `start` on
pub fun emit_vec_range(b: *Builder, src: value.Value, start: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = src;
    ops[1] = start;
    ret emit_value_instr(b, ir_instruction.OP_VEC_RANGE, ty, ?ops[0], 2);
}

# a buffer for the `n` lanes of a vector build, sized from the lane count since a
# target that builds vectors from lanes has no register ceiling on it; released
# with `lanes_release`
pub fun lanes_reserve(b: *Builder, n: u32) res[*value.Value, fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](b.m.alloc, n::usize);
    if (sel r.err) { ret res[*value.Value, fail.Fail].err{fail.refused(r.err)}; }
    ret res[*value.Value, fail.Fail].ok{r.ok};
}

pub fun lanes_release(b: *Builder, lanes: *value.Value, n: u32) {
    dealloc_ops(b, lanes, n);
}

pub fun emit_vec_build(b: *Builder, ty: ir_type.IrTypeId, lanes: *value.Value, n: u32) res[value.Value, fail.Fail] {
    val ov: opt[*ir_type.IrType] = ir_type.get(?b.m.types, ty);
    if (!sel ov.some) {
        ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build result type does not resolve")};
    }
    val v: *ir_type.IrType = ov.some;
    if (v.kind != ir_type.IRT_VECTOR) {
        ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build result type is not a vector")};
    }
    if (n != v.data.vector_.lanes) {
        ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build lane count does not match its vector type")};
    }
    var li: u32 = 0;
    for (li < n) {
        if (!ir_type.same(lanes[li].ty, v.data.vector_.element)) {
            ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build lane type is not the vector's element type")};
        }
        li = li + 1;
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_VEC_BUILD, ty, lanes, n);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[ir_id.instruction_index(iid)].aux_ty = ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

pub fun emit_phi(b: *Builder, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (b.fn == nil) { ret res[value.Value, fail.Fail].err{fail.message("builder: emit_phi with no current function")}; }
    if (b.place != PLACE_NONE && ir_id.block_index(b.block) >= b.fn.block_count) {
        ret res[value.Value, fail.Fail].err{fail.message("builder: emit_phi with invalid block cursor")};
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = pool_append(b, ir_instruction.OP_PHI, ty, nil, 0);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    if (b.place == PLACE_NONE) { ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)}; }

    val blk:     *me_ir.Block   = ?b.fn.blocks[ir_id.block_index(b.block)];
    val res_phi: err[fail.Fail] = me_ir.block_append_phi(b.m, blk, iid);
    if (sel res_phi.err) {
        ret res[value.Value, fail.Fail].err{res_phi.err};
    }
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

pub fun phi_add_incoming(b: *Builder, phi: value.Value, source: ir_id.BlockId, value_arg: value.Value) err[fail.Fail] {
    if (b.fn == nil) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming with no current function")};
    }
    if (phi.kind != value.VAL_INSTR) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming on a non-instruction value")};
    }

    val iid: ir_id.InstructionId = phi.data.instr;
    if (ir_id.instruction_index(iid) >= b.fn.instr_len) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming with stale phi id")};
    }
    val ins: *ir_instruction.Instruction = ?b.fn.instrs[ir_id.instruction_index(iid)];
    if (ins.kind != ir_instruction.OP_PHI) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming on a non-phi instruction")};
    }

    ret me_ir.phi_append_incoming(b.m, ins, source, value_arg);
}

pub fun emit_call(b: *Builder, callee: value.Value, args: *value.Value, arg_count: u32, ret_type: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val total:   u32                        = arg_count + 1;
    val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](b.m.alloc, total::usize);
    if (sel res_ops.err) {
        ret res[value.Value, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *value.Value = res_ops.ok;
    ops[0] = callee;
    var i: u32 = 0;
    for (i < arg_count) {
        ops[1 + i] = args[i];
        i          = i + 1;
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw_owned(b, ir_instruction.OP_CALL, ret_type, ops, total);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;

    # a direct call carries the extensions its callee declares; the lowering
    # of an indirect one sets them from the callee's type
    var sig: ir_type.IrTypeId  = callee.ty;
    var ext: ir_type.ExtListId = ir_type.EXT_LIST_EMPTY;
    if (callee.kind == value.VAL_FN && callee.data.fn_ix < b.m.function_len) {
        sig = b.m.functions[callee.data.fn_ix].sig;
        ext = b.m.functions[callee.data.fn_ix].param_ext;
    }
    b.fn.instrs[ir_id.instruction_index(iid)].aux_ty  = sig;
    b.fn.instrs[ir_id.instruction_index(iid)].arg_ext = ext;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ret_type)};
}

pub fun emit_br(b: *Builder, target: ir_id.BlockId) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret err[fail.Fail].err{res_ptr.err};
    }
    val block_ty: ir_type.IrTypeId = res_ptr.ok;

    var ops: [1]value.Value;
    ops[0] = value.const_int(ir_id.block_index(target)::u64, block_ty);
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, ir_instruction.OP_BR, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    ret add_pred(b, target);
}

pub fun emit_cbr(b: *Builder, cond: value.Value, then_b: ir_id.BlockId, else_b: ir_id.BlockId) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret err[fail.Fail].err{res_ptr.err};
    }
    val block_ty: ir_type.IrTypeId = res_ptr.ok;

    var ops: [3]value.Value;
    ops[0] = cond;
    ops[1] = value.const_int(ir_id.block_index(then_b)::u64, block_ty);
    ops[2] = value.const_int(ir_id.block_index(else_b)::u64, block_ty);
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, ir_instruction.OP_CBR, void_ty, ?ops[0], 3);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }

    val res_then: err[fail.Fail] = add_pred(b, then_b);
    if (sel res_then.err) {
        ret res_then;
    }
    ret add_pred(b, else_b);
}

pub fun emit_ret(b: *Builder, value_arg: value.Value) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [1]value.Value;
    ops[0] = value_arg;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, ir_instruction.OP_RET, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    ret err[fail.Fail].ok{};
}

pub fun emit_ret_void(b: *Builder) err[fail.Fail] {
    ret emit_void_terminator(b, ir_instruction.OP_RET);
}

pub fun emit_unreachable(b: *Builder) err[fail.Fail] {
    ret emit_void_terminator(b, ir_instruction.OP_UNREACHABLE);
}

pub fun emit_asm(b: *Builder, operands: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    if (operand_count == 0) {
        ret emit_raw(b, ir_instruction.OP_ASM, void_ty, nil, 0);
    }

    val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](b.m.alloc, operand_count::usize);
    if (sel res_ops.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *value.Value = res_ops.ok;
    var i:   u32          = 0;
    for (i < operand_count) {
        ops[i] = operands[i];
        i      = i + 1;
    }
    ret emit_raw_owned(b, ir_instruction.OP_ASM, void_ty, ops, operand_count);
}

pub fun emit_dbg_value(b: *Builder, val: value.Value, name: intern.StrId, ty: ir_type.IrTypeId,
    ty_sem: type.TypeId, is_param: bool, scope: u32) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [1]value.Value;
    ops[0] = val;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_DBG_VALUE, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;

    var dv: me_ir.DbgVar;
    dv.name     = name;
    dv.ty       = ty;
    dv.ty_sem   = ty_sem;
    dv.is_param = is_param;
    dv.scope    = scope;
    val inserted_r: res[bool, A.Error] = map.insert[ir_id.InstructionId, me_ir.DbgVar](?b.fn.dbg_vars, iid, dv);
    if (sel inserted_r.err) { ret err[fail.Fail].err{fail.refused(inserted_r.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_binary(b: *Builder, k: ir_instruction.InstrKind, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = lhs;
    ops[1] = rhs;
    ret emit_value_instr(b, k, lhs.ty, ?ops[0], 2);
}

fun emit_unary(b: *Builder, k: ir_instruction.InstrKind, operand: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = operand;
    ret emit_value_instr(b, k, ty, ?ops[0], 1);
}

fun emit_compare(b: *Builder, k: ir_instruction.InstrKind, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    val res_bool: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?b.m.types, 8);
    if (sel res_bool.err) {
        ret res[value.Value, fail.Fail].err{res_bool.err};
    }
    val bool_ty: ir_type.IrTypeId = res_bool.ok;

    var ops: [2]value.Value;
    ops[0] = lhs;
    ops[1] = rhs;
    ret emit_value_instr(b, k, bool_ty, ?ops[0], 2);
}

pub fun emit_vcompare(b: *Builder, k: ir_instruction.InstrKind, lhs: value.Value, rhs: value.Value, result_ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = lhs;
    ops[1] = rhs;
    ret emit_value_instr(b, k, result_ty, ?ops[0], 2);
}

fun emit_void_terminator(b: *Builder, k: ir_instruction.InstrKind) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, k, void_ty, nil, 0);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    ret err[fail.Fail].ok{};
}

fun emit_value_instr(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, ops: *value.Value, operand_count: u32) res[value.Value, fail.Fail] {
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, k, ty, ops, operand_count);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

# instruction `k` of type `ty` with auxiliary type `aux` over a copy of the
# `n` operands at `ops`, made at the insertion point with the builder's
# attributes
pub fun emit_instr(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, aux: ir_type.IrTypeId,
    ops: *value.Value, n: u32) res[ir_id.InstructionId, fail.Fail] {
    val made: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, k, ty, ops, n);
    if (sel made.ok) { b.fn.instrs[ir_id.instruction_index(made.ok)].aux_ty = aux; }
    ret made;
}

# as emit_instr, taking ownership of the `n` operands allocated at `owned`,
# which are released when the instruction cannot be made
pub fun emit_instr_owned(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, aux: ir_type.IrTypeId,
    owned: *value.Value, n: u32) res[ir_id.InstructionId, fail.Fail] {
    val made: res[ir_id.InstructionId, fail.Fail] = emit_raw_owned(b, k, ty, owned, n);
    if (sel made.ok) { b.fn.instrs[ir_id.instruction_index(made.ok)].aux_ty = aux; }
    ret made;
}

fun emit_raw(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, ops: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    if (operand_count == 0) {
        ret emit_raw_owned(b, k, ty, nil, 0);
    }
    val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](b.m.alloc, operand_count::usize);
    if (sel res_ops.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val owned: *value.Value = res_ops.ok;
    var i:     u32          = 0;
    for (i < operand_count) {
        owned[i] = ops[i];
        i        = i + 1;
    }
    ret emit_raw_owned(b, k, ty, owned, operand_count);
}

fun emit_raw_owned(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, owned: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    if (b.fn == nil) {
        dealloc_ops(b, owned, operand_count);
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: emit with no current function")};
    }
    if (b.place == PLACE_NONE) {
        ret pool_append(b, k, ty, owned, operand_count);
    }
    if (ir_id.block_index(b.block) >= b.fn.block_count) {
        dealloc_ops(b, owned, operand_count);
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: emit with invalid block cursor")};
    }
    val blk: *me_ir.Block = ?b.fn.blocks[ir_id.block_index(b.block)];
    if (b.place == PLACE_BUILD && !ir_id.instruction_is_nil(blk.terminator)) {
        dealloc_ops(b, owned, operand_count);
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: emit into an already-terminated block")};
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = pool_append(b, k, ty, owned, operand_count);
    if (sel res_iid.err) { ret res_iid; }
    val iid: ir_id.InstructionId = res_iid.ok;

    if (b.place == PLACE_AT) {
        val res_at: err[fail.Fail] = me_ir.block_insert_instr(b.m, blk, b.pos, iid);
        if (sel res_at.err) {
            ret res[ir_id.InstructionId, fail.Fail].err{res_at.err};
        }
        b.pos = b.pos + 1;
        ret res[ir_id.InstructionId, fail.Fail].ok{iid};
    }
    val res_link: err[fail.Fail] = me_ir.block_append_instr(b.m, blk, iid);
    if (sel res_link.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{res_link.err};
    }
    ret res[ir_id.InstructionId, fail.Fail].ok{iid};
}

# a terminator ends the cursor block while building, and is made unlisted
# when detached; an insertion point inside a list takes none
fun emit_terminator(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, stack_ops: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    if (b.fn == nil)         { ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: terminator with no current function")}; }
    if (b.place == PLACE_AT) { ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: terminator at an insertion point inside a block")}; }
    var blk: *me_ir.Block = nil;
    if (b.place == PLACE_BUILD) {
        if (ir_id.block_index(b.block) >= b.fn.block_count) { ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: terminator with invalid block cursor")}; }
        blk = ?b.fn.blocks[ir_id.block_index(b.block)];
        if (!ir_id.instruction_is_nil(blk.terminator)) {
            ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: block already has a terminator")};
        }
    }

    var owned: *value.Value = nil;
    if (operand_count > 0) {
        val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](b.m.alloc, operand_count::usize);
        if (sel res_ops.err) {
            ret res[ir_id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
        }
        owned = res_ops.ok;
        var i: u32 = 0;
        for (i < operand_count) {
            owned[i] = stack_ops[i];
            i        = i + 1;
        }
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = pool_append(b, k, ty, owned, operand_count);
    if (sel res_iid.err) { ret res_iid; }
    val iid: ir_id.InstructionId = res_iid.ok;
    if (blk != nil) { blk.terminator = iid; }
    ret res[ir_id.InstructionId, fail.Fail].ok{iid};
}

# the instruction made in the pool; its operands are released when it cannot be
fun pool_append(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, operands: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    var ins: ir_instruction.Instruction = ir_instruction.init(k, ty, operands, operand_count);
    ins.flags  = b.flags;
    ins.loc    = b.loc;
    ins.secret = b.secret;
    val added: res[ir_id.InstructionId, fail.Fail] = me_ir.instruction_add(b.m, b.fn, ins);
    if (sel added.err) {
        dealloc_ops(b, operands, operand_count);
        ret added;
    }
    if (b.site != 0) {
        val set: err[fail.Fail] = me_ir.instr_inline_site_set(b.fn, added.ok, b.site);
        if (sel set.err) { ret res[ir_id.InstructionId, fail.Fail].err{set.err}; }
    }
    ret added;
}

fun add_pred(b: *Builder, target: ir_id.BlockId) err[fail.Fail] {
    if (b.place == PLACE_NONE) { ret err[fail.Fail].ok{}; }
    if (ir_id.block_index(target) >= b.fn.block_count) {
        ret err[fail.Fail].err{fail.message("builder: branch to out-of-range block")};
    }
    ret me_ir.block_append_pred(b.m, ?b.fn.blocks[ir_id.block_index(target)], b.block);
}

fun dealloc_ops(b: *Builder, ops: *value.Value, operand_count: u32) {
    if (ops != nil && operand_count > 0) {
        A.deallocate[value.Value](b.m.alloc, ops, operand_count::usize);
    }
}

fun void_type(b: *Builder) res[ir_type.IrTypeId, fail.Fail] {
    ret ir_type.intern_void(?b.m.types);
}

fun ptr_type(b: *Builder) res[ir_type.IrTypeId, fail.Fail] {
    ret ir_type.intern_ptr(?b.m.types);
}

# the value of an emit in sticky mode: a failure is kept when it is the
# first, and the nil value stands in for the result, never to be used, since
# the caller reads `done` before its result
pub fun take(b: *Builder, r: res[value.Value, fail.Fail]) value.Value {
    if (sel r.err) {
        fault(b, r.err);
        ret value.const_null(ir_type.IRT_NIL);
    }
    ret r.ok;
}

# a type in sticky mode, the nil type standing in for a failure
pub fun take_type(b: *Builder, r: res[ir_type.IrTypeId, fail.Fail]) ir_type.IrTypeId {
    if (sel r.err) {
        fault(b, r.err);
        ret ir_type.IRT_NIL;
    }
    ret r.ok;
}

# records `f` unless an earlier failure is already the first
pub fun fault(b: *Builder, f: fail.Fail) {
    if (!b.failed) {
        b.failed = true;
        b.first  = f;
    }
}

# the end of a sticky run: `v`, or the run's first failure, which is cleared
pub fun done(b: *Builder, v: value.Value) res[value.Value, fail.Fail] {
    if (b.failed) {
        b.failed = false;
        ret res[value.Value, fail.Fail].err{b.first};
    }
    ret res[value.Value, fail.Fail].ok{v};
}

pub fun add(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_add(b, x, y));
}

pub fun sub(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_sub(b, x, y));
}

pub fun mul(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_mul(b, x, y));
}

pub fun band(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_and(b, x, y));
}

pub fun bor(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_or(b, x, y));
}

pub fun bxor(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_xor(b, x, y));
}

pub fun shl(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_shl(b, x, y));
}

pub fun shr_u(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_shr_u(b, x, y));
}

pub fun shr_s(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_shr_s(b, x, y));
}

pub fun eq(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_cmp_eq(b, x, y));
}

pub fun ne(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_cmp_ne(b, x, y));
}

pub fun lt_s(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_cmp_lt_s(b, x, y));
}

pub fun lt_u(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_cmp_lt_u(b, x, y));
}

pub fun le_u(b: *Builder, x: value.Value, y: value.Value) value.Value {
    ret take(b, emit_cmp_le_u(b, x, y));
}

pub fun phi(b: *Builder, ty: ir_type.IrTypeId) value.Value {
    ret take(b, emit_phi(b, ty));
}

# a branch, a conditional branch and a phi incoming in sticky mode, a failure
# kept as the run's first
pub fun br(b: *Builder, target: ir_id.BlockId) {
    keep(b, emit_br(b, target));
}

pub fun cbr(b: *Builder, cond: value.Value, then_b: ir_id.BlockId, else_b: ir_id.BlockId) {
    keep(b, emit_cbr(b, cond, then_b, else_b));
}

pub fun incoming(b: *Builder, phi_value: value.Value, source: ir_id.BlockId, value_arg: value.Value) {
    keep(b, phi_add_incoming(b, phi_value, source, value_arg));
}

fun keep(b: *Builder, r: err[fail.Fail]) {
    if (sel r.err) { fault(b, r.err); }
}

pub fun trunc(b: *Builder, x: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(b, emit_trunc(b, x, to));
}

pub fun zext(b: *Builder, x: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(b, emit_zext(b, x, to));
}

pub fun sext(b: *Builder, x: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(b, emit_sext(b, x, to));
}

pub fun bitcast(b: *Builder, x: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(b, emit_bitcast(b, x, to));
}

pub fun fp_ext(b: *Builder, x: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(b, emit_fp_ext(b, x, to));
}

pub fun ui_to_fp(b: *Builder, x: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(b, emit_ui_to_fp(b, x, to));
}

pub fun fp_to_ui(b: *Builder, x: value.Value, to: ir_type.IrTypeId) value.Value {
    ret take(b, emit_fp_to_ui(b, x, to));
}

# a direct call of function `callee` of the module
pub fun call(b: *Builder, callee: u32, args: *value.Value, count: u32, ret_ty: ir_type.IrTypeId) value.Value {
    val f: value.Value = value.fn(callee, b.m.functions[callee].sig);
    ret take(b, emit_call(b, f, args, count, ret_ty));
}

# one function in a fresh module over a page allocator, the builder set on it
# and the 64-bit integer type interned; it must not move once made
#[testing]
pub rec Function {
    alloc: A.Allocator;
    m:     me_ir.Module;
    fn:    *me_ir.Function;
    bld:   Builder;
    i64t:  ir_type.IrTypeId;
}

# make `f` in place, released with function_dnit once made; a failure
# leaves nothing to release
#[testing]
pub fun function_init(f: *Function) err[fail.Fail] {
    page.make(?f.alloc);
    val made: res[me_ir.Module, fail.Fail] = me_ir.init(?f.alloc, intern.STR_NIL);
    if (sel made.err) { ret err[fail.Fail].err{made.err}; }
    f.m   = made.ok;
    f.fn  = nil;
    f.bld = init(?f.m);
    val ty:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?f.m.types, 64);
    val added: res[u32, fail.Fail]              = me_ir.function_add(?f.m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel ty.err) {
        me_ir.dnit(?f.m);
        ret err[fail.Fail].err{ty.err};
    }
    if (sel added.err) {
        me_ir.dnit(?f.m);
        ret err[fail.Fail].err{added.err};
    }
    f.i64t = ty.ok;
    f.fn   = ?f.m.functions[added.ok];
    set_function(?f.bld, f.fn);
    ret err[fail.Fail].ok{};
}

#[testing]
pub fun function_dnit(f: *Function) {
    me_ir.dnit(?f.m);
}

# the blocks of a counted loop and its counter
#[testing]
pub rec CountedLoop {
    entry:  ir_id.BlockId;
    header: ir_id.BlockId;
    body:   ir_id.BlockId;
    exit:   ir_id.BlockId;
    iv:     value.Value;
}

# a counted loop: the entry branches to the header, whose counter starts at
# zero and continues into the body while below parameter 0, and leaves to an
# exit that returns. the builder is left in the open body, which the caller
# fills and ends with counted_loop_close
#[testing]
pub fun counted_loop_add(bld: *Builder, i64t: ir_type.IrTypeId) res[CountedLoop, fail.Fail] {
    var lp:    CountedLoop;
    val entry: res[ir_id.BlockId, fail.Fail] = new_block(bld);
    if (sel entry.err) { ret res[CountedLoop, fail.Fail].err{entry.err}; }
    val header: res[ir_id.BlockId, fail.Fail] = new_block(bld);
    if (sel header.err) { ret res[CountedLoop, fail.Fail].err{header.err}; }
    val body: res[ir_id.BlockId, fail.Fail] = new_block(bld);
    if (sel body.err) { ret res[CountedLoop, fail.Fail].err{body.err}; }
    val exit: res[ir_id.BlockId, fail.Fail] = new_block(bld);
    if (sel exit.err) { ret res[CountedLoop, fail.Fail].err{exit.err}; }
    lp.entry  = entry.ok;
    lp.header = header.ok;
    lp.body   = body.ok;
    lp.exit   = exit.ok;

    set_block(bld, lp.entry);
    val to_header: err[fail.Fail] = emit_br(bld, lp.header);
    if (sel to_header.err) { ret res[CountedLoop, fail.Fail].err{to_header.err}; }

    set_block(bld, lp.header);
    val phi: res[value.Value, fail.Fail] = emit_phi(bld, i64t);
    if (sel phi.err) { ret res[CountedLoop, fail.Fail].err{phi.err}; }
    lp.iv = phi.ok;
    val below: res[value.Value, fail.Fail] = emit_cmp_lt_s(bld, lp.iv, value.param(0, i64t));
    if (sel below.err) { ret res[CountedLoop, fail.Fail].err{below.err}; }
    val branch: err[fail.Fail] = emit_cbr(bld, below.ok, lp.body, lp.exit);
    if (sel branch.err) { ret res[CountedLoop, fail.Fail].err{branch.err}; }

    set_block(bld, lp.exit);
    val returned: err[fail.Fail] = emit_ret_void(bld);
    if (sel returned.err) { ret res[CountedLoop, fail.Fail].err{returned.err}; }
    val start: err[fail.Fail] = phi_add_incoming(bld, lp.iv, lp.entry, value.const_int(0, i64t));
    if (sel start.err) { ret res[CountedLoop, fail.Fail].err{start.err}; }

    set_block(bld, lp.body);
    ret res[CountedLoop, fail.Fail].ok{lp};
}

# step the counter by one at the end of the body and branch back to the
# header, which makes the body the latch
#[testing]
pub fun counted_loop_close(bld: *Builder, lp: *CountedLoop, i64t: ir_type.IrTypeId) err[fail.Fail] {
    set_block(bld, lp.body);
    val step: res[value.Value, fail.Fail] = emit_add(bld, lp.iv, value.const_int(1, i64t));
    if (sel step.err) { ret err[fail.Fail].err{step.err}; }
    val back: err[fail.Fail] = emit_br(bld, lp.header);
    if (sel back.err) { ret back; }
    ret phi_add_incoming(bld, lp.iv, lp.body, step.ok);
}

test pool_append__stamps_loc_cursor {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var b: Builder = init(?m);
    set_function(?b, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = new_block(?b);
    if (sel res_blk.err) { ret 1; }
    set_block(?b, res_blk.ok);

    set_loc(?b, lang_source.location(lang_source.file_id(7), lang_source.span(42, 1)));
    val res_add: res[value.Value, fail.Fail] = emit_add(?b, value.const_int(1, i64t), value.const_int(2, i64t));
    if (sel res_add.err) { ret 1; }
    val add_id: ir_id.InstructionId = res_add.ok.data.instr;
    if (!lang_source.file_same(fn.instrs[add_id::u32].loc.file, lang_source.file_id(7))) { ret 1; }
    if (fn.instrs[add_id::u32].loc.span.offset != 42)                                    { ret 1; }

    val res_fn2: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn2.err) { ret 1; }
    val fn2: *me_ir.Function = ?m.functions[res_fn2.ok];
    set_function(?b, fn2);
    if (lang_source.location_is_valid(current_loc(?b))) { ret 1; }

    me_ir.dnit(?m);
    ret 0;
}

test emit_dbg_value__records_and_rauw_moves {
    var alloc: A.Allocator;
    page.make(?alloc);

    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var b: Builder = init(?m);
    set_function(?b, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = new_block(?b);
    if (sel res_blk.err) { ret 1; }
    set_block(?b, res_blk.ok);

    val res_add: res[value.Value, fail.Fail] = emit_add(?b, value.const_int(1, i64t), value.const_int(2, i64t));
    if (sel res_add.err) { ret 1; }
    val v:    value.Value         = res_add.ok;
    val v_id: ir_id.InstructionId = v.data.instr;

    val r_796: err[fail.Fail] = emit_dbg_value(?b, v, intern.STR_NIL, i64t, type.TYPE_NIL, false, 0);
    if (sel r_796.err) { ret 1; }

    val dbg_id: u32                         = fn.instr_len - 1;
    val dbg:    *ir_instruction.Instruction = ?fn.instrs[dbg_id];
    if (dbg.kind != ir_instruction.OP_DBG_VALUE)                   { ret 1; }
    if (dbg.operand_count != 1)                                    { ret 1; }
    if (dbg.operands[0].kind != value.VAL_INSTR)                   { ret 1; }
    if (!ir_id.instruction_same(dbg.operands[0].data.instr, v_id)) { ret 1; }

    var key:   ir_id.InstructionId = dbg_id::ir_id.InstructionId;
    val r_806: opt[*me_ir.DbgVar]  = map.get[ir_id.InstructionId, me_ir.DbgVar](?fn.dbg_vars, ?key);
    if (sel r_806.none) { ret 1; }

    mutate.replace_uses(fn, v_id, value.param(0, i64t));
    val dbg2: *ir_instruction.Instruction = ?fn.instrs[dbg_id];
    if (dbg2.operands[0].kind != value.VAL_PARAM) { ret 1; }
    if (dbg2.operands[0].data.param_ix != 0)      { ret 1; }

    me_ir.dnit(?m);
    ret 0;
}

#[testing]
fun t_add(b: *Builder, v: value.Value) ir_id.InstructionId {
    val r: res[value.Value, fail.Fail] = emit_add(b, v, v);
    if (sel r.err) { ret ir_id.INSTR_NIL; }
    ret r.ok.data.instr;
}

test at__inserts_a_run_in_order_and_detach_lists_nothing {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;
    fin { me_ir.dnit(?m); }
    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val one:    value.Value         = value.const_int(1, res_i64.ok);
    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var b: Builder = init(?m);
    set_function(?b, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = new_block(?b);
    if (sel res_blk.err) { ret 1; }
    val blk: ir_id.BlockId = res_blk.ok;
    set_block(?b, blk);
    val first: ir_id.InstructionId = t_add(?b, one);
    val last:  ir_id.InstructionId = t_add(?b, one);
    val ended: err[fail.Fail]      = emit_ret_void(?b);
    if (ir_id.instruction_is_nil(first) || ir_id.instruction_is_nil(last) || sel ended.err) { ret 1; }

    # a run inserted between the two adds of a terminated block, carrying the
    # attributes of the instruction it rewrites
    val r_site: err[fail.Fail] = me_ir.instr_inline_site_set(fn, first, 5);
    if (sel r_site.err) { ret 1; }
    fn.instrs[ir_id.instruction_index(first)].secret = true;
    derive(?b, first);
    at(?b, blk, 1);
    val x: ir_id.InstructionId = t_add(?b, one);
    val y: ir_id.InstructionId = t_add(?b, one);
    if (ir_id.instruction_is_nil(x) || ir_id.instruction_is_nil(y)) { ret 2; }
    if (position(?b) != 3)                                          { ret 2; }
    val list: *ir_id.InstructionId = fn.blocks[ir_id.block_index(blk)].instructions;
    if (fn.blocks[ir_id.block_index(blk)].instr_count != 4)                                                                   { ret 3; }
    if (!ir_id.instruction_same(list[1], x) || !ir_id.instruction_same(list[2], y) || !ir_id.instruction_same(list[3], last)) { ret 3; }
    if (!fn.instrs[ir_id.instruction_index(y)].secret || me_ir.instr_inline_site_of(fn, y) != 5)                              { ret 4; }

    # a terminator has no place inside a list, and a detached one is listed nowhere
    val inside: err[fail.Fail] = emit_ret_void(?b);
    if (sel inside.ok) { ret 5; }
    detach(?b);
    plain(?b);
    val loose: ir_id.InstructionId = t_add(?b, one);
    val jump:  err[fail.Fail]      = emit_br(?b, blk);
    if (ir_id.instruction_is_nil(loose) || sel jump.err)                                                         { ret 6; }
    if (fn.blocks[ir_id.block_index(blk)].instr_count != 4 || fn.blocks[ir_id.block_index(blk)].pred_count != 0) { ret 6; }
    if (fn.instrs[ir_id.instruction_index(loose)].secret)                                                        { ret 6; }
    ret 0;
}

test done__reports_the_first_failure_of_a_sticky_run_once {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;
    fin { me_ir.dnit(?m); }
    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val one: value.Value = value.const_int(1, res_i64.ok);

    # no function: every emit fails, and the run keeps only the first
    var b: Builder = init(?m);
    fault(?b, fail.reported());
    val v: value.Value = add(?b, one, sub(?b, one, one));
    if (v.kind != value.VAL_CONST_NULL) { ret 1; }
    val r: res[value.Value, fail.Fail] = done(?b, v);
    if (sel r.ok) { ret 2; }
    val first: fail.Fail = r.err;
    if (!sel first.reported) { ret 3; }
    val again: res[value.Value, fail.Fail] = done(?b, one);
    if (sel again.err) { ret 4; }
    ret 0;
}
