pub fun mark_last_secret(b: *Builder) {
    if (b.fn == nil)         { ret; }
    if (b.fn.instr_len == 0) { ret; }
    b.fn.instrs[b.fn.instr_len - 1].secret = true;
}

pub fun mark_last_volatile(b: *Builder) {
    if (b.fn == nil)         { ret; }
    if (b.fn.instr_len == 0) { ret; }
    val last: u32 = b.fn.instr_len - 1;
    b.fn.instrs[last].flags = b.fn.instrs[last].flags | ir_instruction.INSTR_FLAG_VOLATILE;
}

pub fun emit_declassify(b: *Builder, operand: value.Value) res[value.Value, fail.Fail] {
    ret emit_unary(b, ir_instruction.OP_DECLASSIFY, operand, operand.ty);
}

pub fun emit_alloca(b: *Builder, ty: ir_type.IrTypeId, count: value.Value) res[value.Value, fail.Fail] {
    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret res[value.Value, fail.Fail].err{res_ptr.err};
    }
    val ptr_ty: ir_type.IrTypeId = res_ptr.ok;

    var ops: [1]value.Value;
    ops[0] = count;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_ALLOCA, ptr_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[iid].aux_ty = ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ptr_ty)};
}

pub fun emit_load(b: *Builder, ptr: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = ptr;
    ret emit_value_instr(b, ir_instruction.OP_LOAD, ty, ?ops[0], 1);
}

pub fun emit_store(b: *Builder, value_arg: value.Value, ptr: value.Value) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [2]value.Value;
    ops[0] = value_arg;
    ops[1] = ptr;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_STORE, void_ty, ?ops[0], 2);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    if (value_arg.secret) {
        val siid: ir_id.InstructionId = res_iid.ok;
        if (siid::u32 < b.fn.instr_len) { b.fn.instrs[siid::u32].secret = true; }
    }
    ret err[fail.Fail].ok{};
}

pub fun emit_memzero(b: *Builder, ptr: value.Value, pointee_ty: ir_type.IrTypeId) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [1]value.Value;
    ops[0] = ptr;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_MEMZERO, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[iid].aux_ty = pointee_ty;
    ret err[fail.Fail].ok{};
}

pub fun emit_gep(b: *Builder, base: value.Value, src_ty: ir_type.IrTypeId, indices: *value.Value, index_count: u32) res[value.Value, fail.Fail] {
    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret res[value.Value, fail.Fail].err{res_ptr.err};
    }
    val ptr_ty: ir_type.IrTypeId = res_ptr.ok;

    val total:   u32                                    = index_count + 1;
    val res_ops: res[*value.Value, std_allocator.Error] = std_allocator.allocate[value.Value](b.m.alloc, total::usize);
    if (sel res_ops.err) {
        ret res[value.Value, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *value.Value = res_ops.ok;
    ops[0] = base;
    var i: u32 = 0;
    for (i < index_count) {
        ops[1 + i] = indices[i];
        i          = i + 1;
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw_owned(b, ir_instruction.OP_GEP, ptr_ty, ops, total);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[iid].aux_ty = src_ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ptr_ty)};
}

pub fun emit_vec_extract(b: *Builder, vec: value.Value, lane: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = vec;
