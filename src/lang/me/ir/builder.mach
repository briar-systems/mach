    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_VEC_EXTRACT, ty, ?ops[0], 2);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[iid].aux_ty = vec.ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

pub fun emit_vec_insert(b: *Builder, vec: value.Value, lane: value.Value, value_: value.Value) res[value.Value, fail.Fail] {
    var ops: [3]value.Value;
    ops[0] = vec;
    ops[1] = lane;
    ops[2] = value_;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_VEC_INSERT, vec.ty, ?ops[0], 3);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[iid].aux_ty = vec.ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, vec.ty)};
}

# the lane-halving extension of the half of `src` whose first lane is `base`:
# a vector of half the lanes at twice the width, sign- or zero-extended
pub fun emit_vec_widen_half(b: *Builder, signed: bool, src: value.Value, base: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = src;
    ops[1] = base;
    var k: ir_instruction.InstrKind = ir_instruction.OP_VEC_WIDEN_U;
    if (signed) { k = ir_instruction.OP_VEC_WIDEN_S; }
    ret emit_value_instr(b, k, ty, ?ops[0], 2);
}

# each lane of `ty` the zero-extended sum of the lanes of `src` it covers
pub fun emit_vec_widen_sum_u(b: *Builder, src: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = src;
    ret emit_value_instr(b, ir_instruction.OP_VEC_WIDEN_SUM_U, ty, ?ops[0], 1);
}

# the `ty` lanes of `src` from constant lane `start` on
pub fun emit_vec_range(b: *Builder, src: value.Value, start: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = src;
    ops[1] = start;
    ret emit_value_instr(b, ir_instruction.OP_VEC_RANGE, ty, ?ops[0], 2);
}

# a buffer for the `n` lanes of a vector build, sized from the lane count since a
# target that builds vectors from lanes has no register ceiling on it; released
# with `lanes_release`
pub fun lanes_reserve(b: *Builder, n: u32) res[*value.Value, fail.Fail] {
    val r: res[*value.Value, std_allocator.Error] = std_allocator.allocate[value.Value](b.m.alloc, n::usize);
    if (sel r.err) { ret res[*value.Value, fail.Fail].err{fail.refused(r.err)}; }
    ret res[*value.Value, fail.Fail].ok{r.ok};
}

pub fun lanes_release(b: *Builder, lanes: *value.Value, n: u32) {
    dealloc_ops(b, lanes, n);
}

pub fun emit_vec_build(b: *Builder, ty: ir_type.IrTypeId, lanes: *value.Value, n: u32) res[value.Value, fail.Fail] {
    val ov: opt[*ir_type.IrType] = ir_type.get(?b.m.types, ty);
    if (!sel ov.some) {
        ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build result type does not resolve")};
    }
    val v: *ir_type.IrType = ov.some;
    if (v.kind != ir_type.IRT_VECTOR) {
        ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build result type is not a vector")};
    }
    if (n != v.data.vector_.lanes) {
        ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build lane count does not match its vector type")};
    }
    var li: u32 = 0;
    for (li < n) {
        if (lanes[li].ty != v.data.vector_.element) {
            ret res[value.Value, fail.Fail].err{fail.message("ir.builder: vector build lane type is not the vector's element type")};
        }
        li = li + 1;
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_VEC_BUILD, ty, lanes, n);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    b.fn.instrs[iid].aux_ty = ty;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

pub fun emit_phi(b: *Builder, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (b.fn == nil)                 { ret res[value.Value, fail.Fail].err{fail.message("builder: emit_phi with no current function")}; }
    if (b.block >= b.fn.block_count) { ret res[value.Value, fail.Fail].err{fail.message("builder: emit_phi with invalid block cursor")}; }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = pool_append(b, ir_instruction.OP_PHI, ty, nil, 0);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;

    val blk:     *me_ir.Block   = ?b.fn.blocks[b.block];
    val res_phi: err[fail.Fail] = me_ir.block_append_phi(b.m, blk, iid);
    if (sel res_phi.err) {
        ret res[value.Value, fail.Fail].err{res_phi.err};
    }
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

pub fun phi_add_incoming(b: *Builder, phi: value.Value, source: ir_id.BlockId, value_arg: value.Value) err[fail.Fail] {
    if (b.fn == nil) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming with no current function")};
    }
    if (phi.kind != value.VAL_INSTR) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming on a non-instruction value")};
    }

    val iid: ir_id.InstructionId = phi.data.instr;
    if (iid >= b.fn.instr_len) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming with stale phi id")};
    }
    val ins: *ir_instruction.Instruction = ?b.fn.instrs[iid];
    if (ins.kind != ir_instruction.OP_PHI) {
        ret err[fail.Fail].err{fail.message("builder: phi_add_incoming on a non-phi instruction")};
    }

    ret me_ir.phi_append_incoming(b.m, ins, source, value_arg);
}

pub fun emit_call(b: *Builder, callee: value.Value, args: *value.Value, arg_count: u32, ret_type: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val total:   u32                                    = arg_count + 1;
    val res_ops: res[*value.Value, std_allocator.Error] = std_allocator.allocate[value.Value](b.m.alloc, total::usize);
    if (sel res_ops.err) {
        ret res[value.Value, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *value.Value = res_ops.ok;
    ops[0] = callee;
    var i: u32 = 0;
    for (i < arg_count) {
        ops[1 + i] = args[i];
        i          = i + 1;
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw_owned(b, ir_instruction.OP_CALL, ret_type, ops, total);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;

    # a direct call carries the extensions its callee declares; the lowering
    # of an indirect one sets them from the callee's type
    var sig: ir_type.IrTypeId  = callee.ty;
    var ext: ir_type.ExtListId = ir_type.EXT_LIST_NONE;
    if (callee.kind == value.VAL_FN && callee.data.fn_ix < b.m.function_len) {
        sig = b.m.functions[callee.data.fn_ix].sig;
        ext = b.m.functions[callee.data.fn_ix].param_ext;
    }
    b.fn.instrs[iid].aux_ty  = sig;
    b.fn.instrs[iid].arg_ext = ext;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ret_type)};
}

pub fun emit_br(b: *Builder, target: ir_id.BlockId) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret err[fail.Fail].err{res_ptr.err};
    }
    val block_ty: ir_type.IrTypeId = res_ptr.ok;

    var ops: [1]value.Value;
    ops[0] = value.const_int(target::u64, block_ty);
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, ir_instruction.OP_BR, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    ret add_pred(b, target);
}

pub fun emit_cbr(b: *Builder, cond: value.Value, then_b: ir_id.BlockId, else_b: ir_id.BlockId) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ptr_type(b);
    if (sel res_ptr.err) {
        ret err[fail.Fail].err{res_ptr.err};
    }
    val block_ty: ir_type.IrTypeId = res_ptr.ok;

    var ops: [3]value.Value;
    ops[0] = cond;
    ops[1] = value.const_int(then_b::u64, block_ty);
    ops[2] = value.const_int(else_b::u64, block_ty);
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, ir_instruction.OP_CBR, void_ty, ?ops[0], 3);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }

    val res_then: err[fail.Fail] = add_pred(b, then_b);
    if (sel res_then.err) {
        ret res_then;
    }
    ret add_pred(b, else_b);
}

pub fun emit_ret(b: *Builder, value_arg: value.Value) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [1]value.Value;
    ops[0] = value_arg;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, ir_instruction.OP_RET, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    ret err[fail.Fail].ok{};
}

pub fun emit_ret_void(b: *Builder) err[fail.Fail] {
    ret emit_void_terminator(b, ir_instruction.OP_RET);
}

pub fun emit_unreachable(b: *Builder) err[fail.Fail] {
    ret emit_void_terminator(b, ir_instruction.OP_UNREACHABLE);
}

pub fun emit_asm(b: *Builder, operands: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    if (operand_count == 0) {
        ret emit_raw(b, ir_instruction.OP_ASM, void_ty, nil, 0);
    }

    val res_ops: res[*value.Value, std_allocator.Error] = std_allocator.allocate[value.Value](b.m.alloc, operand_count::usize);
    if (sel res_ops.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val ops: *value.Value = res_ops.ok;
    var i:   u32          = 0;
    for (i < operand_count) {
        ops[i] = operands[i];
        i      = i + 1;
    }
    ret emit_raw_owned(b, ir_instruction.OP_ASM, void_ty, ops, operand_count);
}

pub fun emit_dbg_value(b: *Builder, val: value.Value, name: intern.StrId, ty: ir_type.IrTypeId,
    ty_sem: type.TypeId, is_param: bool, scope: u32) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    var ops: [1]value.Value;
    ops[0] = val;
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, ir_instruction.OP_DBG_VALUE, void_ty, ?ops[0], 1);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;

    var dv: me_ir.DbgVar;
    dv.name     = name;
    dv.ty       = ty;
    dv.ty_sem   = ty_sem;
    dv.is_param = is_param;
    dv.scope    = scope;
    val inserted_r: res[bool, std_allocator.Error] = map.insert[ir_id.InstructionId, me_ir.DbgVar](?b.fn.dbg_vars, iid, dv);
    if (sel inserted_r.err) { ret err[fail.Fail].err{fail.refused(inserted_r.err)}; }
    ret err[fail.Fail].ok{};
}

fun emit_binary(b: *Builder, k: ir_instruction.InstrKind, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = lhs;
    ops[1] = rhs;
    ret emit_value_instr(b, k, lhs.ty, ?ops[0], 2);
}

fun emit_unary(b: *Builder, k: ir_instruction.InstrKind, operand: value.Value, ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = operand;
    ret emit_value_instr(b, k, ty, ?ops[0], 1);
}

fun emit_compare(b: *Builder, k: ir_instruction.InstrKind, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    val res_bool: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?b.m.types, 8);
    if (sel res_bool.err) {
        ret res[value.Value, fail.Fail].err{res_bool.err};
    }
    val bool_ty: ir_type.IrTypeId = res_bool.ok;

    var ops: [2]value.Value;
    ops[0] = lhs;
    ops[1] = rhs;
    ret emit_value_instr(b, k, bool_ty, ?ops[0], 2);
}

pub fun emit_vcompare(b: *Builder, k: ir_instruction.InstrKind, lhs: value.Value, rhs: value.Value, result_ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = lhs;
    ops[1] = rhs;
    ret emit_value_instr(b, k, result_ty, ?ops[0], 2);
}

fun emit_void_terminator(b: *Builder, k: ir_instruction.InstrKind) err[fail.Fail] {
    val res_void: res[ir_type.IrTypeId, fail.Fail] = void_type(b);
    if (sel res_void.err) {
        ret err[fail.Fail].err{res_void.err};
    }
    val void_ty: ir_type.IrTypeId = res_void.ok;

    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_terminator(b, k, void_ty, nil, 0);
    if (sel res_iid.err) {
        ret err[fail.Fail].err{res_iid.err};
    }
    ret err[fail.Fail].ok{};
}

fun emit_value_instr(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, ops: *value.Value, operand_count: u32) res[value.Value, fail.Fail] {
    val res_iid: res[ir_id.InstructionId, fail.Fail] = emit_raw(b, k, ty, ops, operand_count);
    if (sel res_iid.err) {
        ret res[value.Value, fail.Fail].err{res_iid.err};
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

fun emit_raw(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, ops: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    if (operand_count == 0) {
        ret emit_raw_owned(b, k, ty, nil, 0);
    }
    val res_ops: res[*value.Value, std_allocator.Error] = std_allocator.allocate[value.Value](b.m.alloc, operand_count::usize);
    if (sel res_ops.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
    }
    val owned: *value.Value = res_ops.ok;
    var i:     u32          = 0;
    for (i < operand_count) {
        owned[i] = ops[i];
        i        = i + 1;
    }
    ret emit_raw_owned(b, k, ty, owned, operand_count);
}

fun emit_raw_owned(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, owned: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    if (b.fn == nil) {
        dealloc_ops(b, owned, operand_count);
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: emit with no current function")};
    }
    if (b.block >= b.fn.block_count) {
        dealloc_ops(b, owned, operand_count);
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: emit with invalid block cursor")};
    }
    val blk: *me_ir.Block = ?b.fn.blocks[b.block];
    if (blk.terminator != ir_id.INSTR_NIL) {
        dealloc_ops(b, owned, operand_count);
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: emit into an already-terminated block")};
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = pool_append(b, k, ty, owned, operand_count);
    if (sel res_iid.err) {
        dealloc_ops(b, owned, operand_count);
        ret res_iid;
    }
    val iid: ir_id.InstructionId = res_iid.ok;

    val res_link: err[fail.Fail] = me_ir.block_append_instr(b.m, blk, iid);
    if (sel res_link.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{res_link.err};
    }
    ret res[ir_id.InstructionId, fail.Fail].ok{iid};
}

fun emit_terminator(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, stack_ops: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    if (b.fn == nil)                 { ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: terminator with no current function")}; }
    if (b.block >= b.fn.block_count) { ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: terminator with invalid block cursor")}; }
    val blk: *me_ir.Block = ?b.fn.blocks[b.block];
    if (blk.terminator != ir_id.INSTR_NIL) {
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("builder: block already has a terminator")};
    }

    var owned: *value.Value = nil;
    if (operand_count > 0) {
        val res_ops: res[*value.Value, std_allocator.Error] = std_allocator.allocate[value.Value](b.m.alloc, operand_count::usize);
        if (sel res_ops.err) {
            ret res[ir_id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
        }
        owned = res_ops.ok;
        var i: u32 = 0;
        for (i < operand_count) {
            owned[i] = stack_ops[i];
            i        = i + 1;
        }
    }

    val res_iid: res[ir_id.InstructionId, fail.Fail] = pool_append(b, k, ty, owned, operand_count);
    if (sel res_iid.err) {
        dealloc_ops(b, owned, operand_count);
        ret res_iid;
    }
    val iid: ir_id.InstructionId = res_iid.ok;
    blk.terminator = iid;
    ret res[ir_id.InstructionId, fail.Fail].ok{iid};
}

fun pool_append(b: *Builder, k: ir_instruction.InstrKind, ty: ir_type.IrTypeId, operands: *value.Value, operand_count: u32) res[ir_id.InstructionId, fail.Fail] {
    var ins: ir_instruction.Instruction;
    ins.kind          = k;
    ins.ty            = ty;
    ins.operands      = operands;
    ins.operand_count = operand_count;
    ins.operand_cap   = operand_count;
    ins.flags         = 0;
    ins.aux_ty        = ir_type.IRT_NIL;
    ins.loc           = b.loc;
    ins.secret        = false;
    ret me_ir.instruction_add(b.m, b.fn, ins);
}

fun add_pred(b: *Builder, target: ir_id.BlockId) err[fail.Fail] {
    if (target >= b.fn.block_count) {
        ret err[fail.Fail].err{fail.message("builder: branch to out-of-range block")};
    }
    ret me_ir.block_append_pred(b.m, ?b.fn.blocks[target], b.block);
}

fun dealloc_ops(b: *Builder, ops: *value.Value, operand_count: u32) {
    if (ops != nil && operand_count > 0) {
        std_allocator.deallocate[value.Value](b.m.alloc, ops, operand_count::usize);
    }
}

fun void_type(b: *Builder) res[ir_type.IrTypeId, fail.Fail] {
    ret ir_type.intern_void(?b.m.types);
}

fun ptr_type(b: *Builder) res[ir_type.IrTypeId, fail.Fail] {
    ret ir_type.intern_ptr(?b.m.types);
}

test pool_append__stamps_loc_cursor {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var b: Builder = init(?m);
    set_function(?b, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = new_block(?b);
    if (sel res_blk.err) { ret 1; }
    set_block(?b, res_blk.ok);

    set_loc(?b, lang_source.loc(7, 42));
    val res_add: res[value.Value, fail.Fail] = emit_add(?b, value.const_int(1, i64t), value.const_int(2, i64t));
    if (sel res_add.err) { ret 1; }
    val add_id: ir_id.InstructionId = res_add.ok.data.instr;
    if (fn.instrs[add_id::u32].loc.file != 7)    { ret 1; }
    if (fn.instrs[add_id::u32].loc.offset != 42) { ret 1; }

    val res_fn2: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn2.err) { ret 1; }
    val fn2: *me_ir.Function = ?m.functions[res_fn2.ok];
    set_function(?b, fn2);
    if (lang_source.loc_is_valid(current_loc(?b))) { ret 1; }

    me_ir.dnit(?m);
    ret 0;
}

test emit_dbg_value__records_and_rauw_moves {
    var alloc: std_allocator.Allocator;
    page.make(?alloc);

    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var b: Builder = init(?m);
    set_function(?b, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = new_block(?b);
    if (sel res_blk.err) { ret 1; }
    set_block(?b, res_blk.ok);

    val res_add: res[value.Value, fail.Fail] = emit_add(?b, value.const_int(1, i64t), value.const_int(2, i64t));
    if (sel res_add.err) { ret 1; }
    val v:    value.Value         = res_add.ok;
    val v_id: ir_id.InstructionId = v.data.instr;

    val r_796: err[fail.Fail] = emit_dbg_value(?b, v, intern.STR_NIL, i64t, type.TYPE_NIL, false, 0);
    if (sel r_796.err) { ret 1; }

    val dbg_id: u32                         = fn.instr_len - 1;
    val dbg:    *ir_instruction.Instruction = ?fn.instrs[dbg_id];
    if (dbg.kind != ir_instruction.OP_DBG_VALUE) { ret 1; }
    if (dbg.operand_count != 1)                  { ret 1; }
    if (dbg.operands[0].kind != value.VAL_INSTR) { ret 1; }
    if (dbg.operands[0].data.instr != v_id)      { ret 1; }

    var key:   ir_id.InstructionId = dbg_id::ir_id.InstructionId;
    val r_806: opt[*me_ir.DbgVar]  = map.get[ir_id.InstructionId, me_ir.DbgVar](?fn.dbg_vars, ?key);
    if (sel r_806.none) { ret 1; }

    mutate.replace_uses(fn, v_id, value.param(0, i64t));
    val dbg2: *ir_instruction.Instruction = ?fn.instrs[dbg_id];
    if (dbg2.operands[0].kind != value.VAL_PARAM) { ret 1; }
    if (dbg2.operands[0].data.param_ix != 0)      { ret 1; }

    me_ir.dnit(?m);
    ret 0;
}
