use std.types.result.res;
use std.types.option.opt;
use std.types.error.err;
use mach.lang.fail;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.collections.map;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;

pub rec Rewrite {
    vals: *value.Value;
    live: *bool;
    len:  u32;
}

pub fun rewrite_init(rw: *Rewrite, a: *A.Allocator, len: u32) err[fail.Fail] {
    val res_vals: res[*value.Value, A.Error] = A.allocate[value.Value](a, len::usize);
    if (sel res_vals.err) {
        ret err[fail.Fail].err{fail.refused(res_vals.err)};
    }
    val res_live: res[*bool, A.Error] = A.allocate[bool](a, len::usize);
    if (sel res_live.err) {
        A.deallocate[value.Value](a, res_vals.ok, len::usize);
        ret err[fail.Fail].err{fail.refused(res_live.err)};
    }

    rw.vals = res_vals.ok;
    rw.live = res_live.ok;
    rw.len  = len;

    var i: u32 = 0;
    for (i < len) { rw.live[i] = false; i = i + 1; }
    ret err[fail.Fail].ok{};
}

pub fun rewrite_dnit(rw: *Rewrite, a: *A.Allocator) {
    if (rw.vals != nil && rw.len > 0) { A.deallocate[value.Value](a, rw.vals, rw.len::usize); }
    if (rw.live != nil && rw.len > 0) { A.deallocate[bool](a, rw.live, rw.len::usize); }
    rw.vals = nil;
    rw.live = nil;
    rw.len  = 0;
}

pub fun replace_value(rw: *Rewrite, iid: id.InstructionId, v: value.Value) {
    rw.vals[iid::u32] = v;
    rw.live[iid::u32] = true;
}

pub fun rewrite_has(rw: *Rewrite, iid: id.InstructionId) bool {
    val idx: u32 = iid::u32;
    ret idx < rw.len && rw.live[idx];
}

pub fun rewrite_resolve(rw: *Rewrite, v: value.Value) value.Value {
    var cur:  value.Value = v;
    var hops: u32         = 0;
    for (cur.kind == value.VAL_INSTR && hops <= rw.len) {
        val iid: u32 = cur.data.instr::u32;
        if (iid >= rw.len || rw.live[iid] == false) { ret substitute_for_use(cur, v); }
        cur  = rw.vals[iid];
        hops = hops + 1;
    }
    ret substitute_for_use(cur, v);
}

fun carry_secret(sub: value.Value, orig: value.Value) value.Value {
    var out: value.Value = sub;
    if (orig.secret) { out.secret = true; }
    ret out;
}

pub fun substitute_for_use(sub: value.Value, use: value.Value) value.Value {
    ret carry_secret(value.retype(sub, use.ty), use);
}

pub fun rewrite_apply(fn: *ir.Function, rw: *Rewrite) {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        var ii: u32 = 0;
        for (ii < inst.operand_count) {
            val op: value.Value = inst.operands[ii];
            if (op.kind == value.VAL_INSTR) {
                val iid: u32 = op.data.instr::u32;
                if (iid < rw.len && rw.live[iid]) {
                    inst.operands[ii] = rewrite_resolve(rw, op);
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

pub fun replace_uses(fn: *ir.Function, old_id: id.InstructionId, replacement: value.Value) {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        var ii: u32 = 0;
        for (ii < inst.operand_count) {
            val op: value.Value = inst.operands[ii];
            if (op.kind == value.VAL_INSTR && op.data.instr == old_id) {
                inst.operands[ii] = substitute_for_use(replacement, op);
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

# every allocation the erasure needs happens in the salvage phase, before a
# list is compacted: a refusal leaves the function with its dead instructions
# still listed and some `dbg_value`s already rebased onto their salvage
# expression, which is a valid function, never a list mid-compaction
pub fun erase_marked[T](m: *ir.Module, fn: *ir.Function, ctx: *T,
                        test: fun(*T, id.InstructionId) bool) res[bool, fail.Fail] {
    if (ctx == nil || test == nil) {
        ret res[bool, fail.Fail].err{fail.message("instruction erasure predicate is incomplete")};
    }
    if (has_dbg_values(fn)) {
        var b: u32 = 0;
        for (b < fn.block_count) {
            val blk: *ir.Block = ?fn.blocks[b];
            var r: u32 = 0;
            for (r < blk.phi_count) {
                if (test(ctx, blk.phis[r])) {
                    val res_: err[fail.Fail] = salvage_dbg_values[T](m, fn, ctx, test, blk.phis[r]);
                    if (sel res_.err) { ret res[bool, fail.Fail].err{res_.err}; }
                }
                r = r + 1;
            }
            r = 0;
            for (r < blk.instr_count) {
                if (test(ctx, blk.instructions[r])) {
                    val res_: err[fail.Fail] = salvage_dbg_values[T](m, fn, ctx, test, blk.instructions[r]);
                    if (sel res_.err) { ret res[bool, fail.Fail].err{res_.err}; }
                }
                r = r + 1;
            }
            b = b + 1;
        }
    }

    var changed: bool = false;
    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[b];

        var w: u32 = 0;
        var r: u32 = 0;
        for (r < blk.phi_count) {
            if (test(ctx, blk.phis[r]) == false) {
                blk.phis[w] = blk.phis[r];
                w = w + 1;
            }
            r = r + 1;
        }
        if (w != blk.phi_count) { changed = true; }
        blk.phi_count = w;

        w = 0;
        r = 0;
        for (r < blk.instr_count) {
            if (test(ctx, blk.instructions[r]) == false) {
                blk.instructions[w] = blk.instructions[r];
                w = w + 1;
            }
            r = r + 1;
        }
        if (w != blk.instr_count) { changed = true; }
        blk.instr_count = w;

        b = b + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun has_dbg_values(fn: *ir.Function) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (inst.kind == instruction.OP_DBG_VALUE) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun salvage_dbg_values[T](m: *ir.Module, fn: *ir.Function, ctx: *T,
                          test: fun(*T, id.InstructionId) bool,
                          dropped: id.InstructionId) err[fail.Fail] {
    var base:        value.Value;
    var op:          ir.DbgOp;
    var recoverable: bool = false;
    salvage_decode(fn, dropped, ?base, ?op, ?recoverable);

    var base_live: bool = false;
    if (recoverable) {
        if (base.kind != value.VAL_INSTR) { base_live = true; }
        or { base_live = test(ctx, base.data.instr) == false; }
    }

    var i: u32 = 0;
    for (i < fn.instr_len) {
        val d: *instruction.Instruction = ?fn.instrs[i];
        if (d.kind == instruction.OP_DBG_VALUE && d.operand_count == 1
            && d.operands[0].kind == value.VAL_INSTR && d.operands[0].data.instr == dropped) {
            if (recoverable && base_live) {
                val res_: err[fail.Fail] = salvage_rebase(m, fn, i::id.InstructionId, d, base, op);
                if (sel res_.err) { ret res_; }
            }
            or {
                d.operands[0] = value.const_null(d.operands[0].ty);
            }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun salvage_rebase(m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, d: *instruction.Instruction, base: value.Value, op: ir.DbgOp) err[fail.Fail] {
    var eid: ir.DbgExprId = ir.dbg_expr_id(fn, iid);
    if (eid == ir.DBG_EXPR_IDENTITY) {
        val res_new: res[ir.DbgExprId, fail.Fail] = ir.dbg_expr_new(m, fn, iid);
        if (sel res_new.err) {
            ret err[fail.Fail].err{res_new.err};
        }
        eid = res_new.ok;
    }
    val res_op: err[fail.Fail] = ir.dbg_expr_prepend_op(m, fn, eid, op);
    if (sel res_op.err) { ret res_op; }
    d.operands[0] = base;
    ret err[fail.Fail].ok{};
}

fun salvage_decode(fn: *ir.Function, dropped: id.InstructionId, base: *value.Value, op: *ir.DbgOp, recoverable: *bool) {
    @recoverable = false;
    val opt_x: opt[*instruction.Instruction] = ir.instruction_get(fn, dropped);
    if (sel opt_x.none) { ret; }
    val x: *instruction.Instruction = opt_x.some;

    if (x.kind == instruction.OP_ADD && x.operand_count == 2) {
        if (x.operands[1].kind == value.VAL_CONST_INT) {
            @base = x.operands[0];
            @op = dbg_op(ir.DBG_OP_PLUS_CONST, x.operands[1].data.int_lit);
            @recoverable = true;
            ret;
        }
        if (x.operands[0].kind == value.VAL_CONST_INT) {
            @base = x.operands[1];
            @op = dbg_op(ir.DBG_OP_PLUS_CONST, x.operands[0].data.int_lit);
            @recoverable = true;
            ret;
        }
    }
    if (x.kind == instruction.OP_SUB && x.operand_count == 2 && x.operands[1].kind == value.VAL_CONST_INT) {
        @base = x.operands[0];
        @op = dbg_op(ir.DBG_OP_MINUS_CONST, x.operands[1].data.int_lit);
        @recoverable = true;
        ret;
    }
}

fun dbg_op(kind: u8, arg: u64) ir.DbgOp {
    var o: ir.DbgOp;
    o.op  = kind;
    o.arg = arg;
    ret o;
}

pub fun clone_instruction(m: *ir.Module, dst_fn: *ir.Function, src: *instruction.Instruction) res[id.InstructionId, fail.Fail] {
    var clone: instruction.Instruction;
    clone.kind          = src.kind;
    clone.ty            = src.ty;
    clone.operand_count = src.operand_count;
    clone.operand_cap   = src.operand_count;
    clone.flags         = src.flags;
    clone.aux_ty        = src.aux_ty;
    clone.loc           = src.loc;
    clone.secret        = src.secret;
    clone.operands      = nil;
    if (src.operand_count > 0) {
        val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, src.operand_count::usize);
        if (sel res_ops.err) {
            ret res[id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)};
        }
        val ops: *value.Value = res_ops.ok;
        var i: u32 = 0;
        for (i < src.operand_count) {
            ops[i] = src.operands[i];
            i = i + 1;
        }
        clone.operands = ops;
    }

    val res_id: res[id.InstructionId, fail.Fail] = ir.instruction_add(m, dst_fn, clone);
    if (sel res_id.err) {
        if (clone.operands != nil) {
            A.deallocate[value.Value](m.alloc, clone.operands, clone.operand_count::usize);
        }
        ret res_id;
    }
    ret res_id;
}

pub fun clone_instruction_complete(m: *ir.Module, src_fn: *ir.Function, dst_fn: *ir.Function, src_iid: id.InstructionId, instr_map: *u32, map_len: u32) res[id.InstructionId, fail.Fail] {
    val src: *instruction.Instruction = ?src_fn.instrs[src_iid::u32];
    val res_id: res[id.InstructionId, fail.Fail] = clone_instruction(m, dst_fn, src);
    if (sel res_id.err) { ret res_id; }
    val new_iid: id.InstructionId = res_id.ok;

    val rd: err[fail.Fail] = ir.clone_dbg_metadata(m, src_fn, dst_fn, src_iid, new_iid);
    if (sel rd.err) { ret res[id.InstructionId, fail.Fail].err{rd.err}; }
    val ra: err[fail.Fail] = ir.clone_asm_payload(m, src_fn, dst_fn, src_iid, new_iid, instr_map, map_len);
    if (sel ra.err) { ret res[id.InstructionId, fail.Fail].err{ra.err}; }
    val rl: err[fail.Fail] = ir.clone_alloca_dbg_var(src_fn, dst_fn, src_iid, new_iid);
    if (sel rl.err) { ret res[id.InstructionId, fail.Fail].err{rl.err}; }
    val rs: err[fail.Fail] = ir.clone_instr_inline_site(src_fn, dst_fn, src_iid, new_iid);
    if (sel rs.err) { ret res[id.InstructionId, fail.Fail].err{rs.err}; }
    ret res[id.InstructionId, fail.Fail].ok{new_iid};
}

fun test_instr(m: *ir.Module, fn: *ir.Function, kind: instruction.InstrKind, ty: ir_type.IrTypeId, ops: *value.Value, n: u32) res[id.InstructionId, fail.Fail] {
    var owned: *value.Value = nil;
    if (n > 0) {
        val res_ops: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, n::usize);
        if (sel res_ops.err) { ret res[id.InstructionId, fail.Fail].err{fail.refused(res_ops.err)}; }
        owned = res_ops.ok;
        var i: u32 = 0;
        for (i < n) { owned[i] = ops[i]; i = i + 1; }
    }
    var inst: instruction.Instruction;
    inst.kind          = kind;
    inst.ty            = ty;
    inst.operands      = owned;
    inst.operand_count = n;
    inst.operand_cap   = n;
    inst.flags         = 0;
    inst.aux_ty        = ir_type.IRT_NIL;
    inst.loc           = source.loc_nil();
    inst.secret        = false;
    ret ir.instruction_add(m, fn, inst);
}

test "mach.lang.me.ir.mutate.replace_uses:preserves_use_site_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;
    var fields: [3]ir_type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val aggt: ir_type.IrTypeId = ra.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_v: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (sel r_v.err) { ir.dnit(?m); ret 1; }
    val v_id: id.InstructionId = r_v.ok;
    val r_slot: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (sel r_slot.err) { ir.dnit(?m); ret 1; }
    val slot_id: id.InstructionId = r_slot.ok;

    var store_ops: [2]value.Value;
    store_ops[0] = value.instr(v_id, aggt);
    store_ops[1] = value.instr(slot_id, ptrt);
    val r_store: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_STORE, voidt, ?store_ops[0], 2);
    if (sel r_store.err) { ir.dnit(?m); ret 1; }
    val store_id: id.InstructionId = r_store.ok;

    replace_uses(fn, v_id, value.param(0, ptrt));

    val oi: opt[*instruction.Instruction] = ir.instruction_get(fn, store_id);
    if (sel oi.none) { ir.dnit(?m); ret 1; }
    val ins: *instruction.Instruction = oi.some;

    var bad: i32 = 0;
    if (ins.operands[0].kind != value.VAL_PARAM)  { bad = 3; }
    or (ins.operands[0].data.param_ix != 0)       { bad = 4; }
    or (ins.operands[0].ty != aggt)               { bad = 2; }
    if (bad == 0) {
        if (ins.operands[1].kind != value.VAL_INSTR)  { bad = 5; }
        or (ins.operands[1].data.instr != slot_id)    { bad = 6; }
        or (ins.operands[1].ty != ptrt)               { bad = 7; }
    }
    ir.dnit(?m);
    ret bad;
}

fun t_erase_none(target: *id.InstructionId, iid: id.InstructionId) bool { ret false; }

fun t_erase_target(target: *id.InstructionId, iid: id.InstructionId) bool {
    ret iid == @target;
}

test "mach.lang.me.ir.mutate.erase_marked:reports_no_change_when_nothing_is_marked" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    val res_blk: res[id.BlockId, fail.Fail] = ir.block_add(?m, fn);
    if (sel res_blk.err) { ir.dnit(?m); ret 1; }
    val bid: id.BlockId = res_blk.ok;
    val blk: *ir.Block = ?fn.blocks[bid::u32];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_ret: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_RET, i64t, ?count[0], 1);
    if (sel r_ret.err) { ir.dnit(?m); ret 1; }
    blk.terminator = r_ret.ok;

    var target: id.InstructionId = id.INSTR_NIL;
    val target_ptr: *id.InstructionId = ?target;
    val res_: res[bool, fail.Fail] =
        erase_marked[id.InstructionId](?m, fn, target_ptr, t_erase_none);
    if (sel res_.err) { ir.dnit(?m); ret 1; }
    val changed: bool = res_.ok;
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.mutate.erase_marked:reports_change_when_the_marked_instruction_is_erased" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    val res_blk: res[id.BlockId, fail.Fail] = ir.block_add(?m, fn);
    if (sel res_blk.err) { ir.dnit(?m); ret 1; }
    val bid: id.BlockId = res_blk.ok;
    val blk: *ir.Block = ?fn.blocks[bid::u32];

    var addops: [2]value.Value;
    addops[0] = value.param(0, i64t);
    addops[1] = value.param(1, i64t);
    val r_add: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ADD, i64t, ?addops[0], 2);
    if (sel r_add.err) { ir.dnit(?m); ret 1; }
    val x_id: id.InstructionId = r_add.ok;
    val r_469: err[fail.Fail] = ir.block_append_instr(?m, blk, x_id);
    if (sel r_469.err) { ir.dnit(?m); ret 1; }

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_ret: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_RET, i64t, ?count[0], 1);
    if (sel r_ret.err) { ir.dnit(?m); ret 1; }
    blk.terminator = r_ret.ok;

    val before: u32 = blk.instr_count;

    var target: id.InstructionId = x_id;
    val target_ptr: *id.InstructionId = ?target;
    val res_: res[bool, fail.Fail] =
        erase_marked[id.InstructionId](?m, fn, target_ptr, t_erase_target);
    if (sel res_.err) { ir.dnit(?m); ret 1; }
    val changed: bool = res_.ok;
    val after: u32 = blk.instr_count;
    ir.dnit(?m);
    if (changed != true) { ret 1; }
    if (after != before - 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.mutate.rewrite_apply:preserves_use_site_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;
    var fields: [3]ir_type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val aggt: ir_type.IrTypeId = ra.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_v: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (sel r_v.err) { ir.dnit(?m); ret 1; }
    val v_id: id.InstructionId = r_v.ok;
    val r_slot: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (sel r_slot.err) { ir.dnit(?m); ret 1; }
    val slot_id: id.InstructionId = r_slot.ok;

    var store_ops: [2]value.Value;
    store_ops[0] = value.instr(v_id, aggt);
    store_ops[1] = value.instr(slot_id, ptrt);
    val r_store: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_STORE, voidt, ?store_ops[0], 2);
    if (sel r_store.err) { ir.dnit(?m); ret 1; }
    val store_id: id.InstructionId = r_store.ok;

    var rw: Rewrite;
    val r_535: err[fail.Fail] = rewrite_init(?rw, ?alloc, fn.instr_len);
    if (sel r_535.err) { ir.dnit(?m); ret 1; }
    replace_value(?rw, v_id, value.param(0, ptrt));
    rewrite_apply(fn, ?rw);
    rewrite_dnit(?rw, ?alloc);

    val oi: opt[*instruction.Instruction] = ir.instruction_get(fn, store_id);
    if (sel oi.none) { ir.dnit(?m); ret 1; }
    val ins: *instruction.Instruction = oi.some;

    var bad: i32 = 0;
    if (ins.operands[0].kind != value.VAL_PARAM)  { bad = 3; }
    or (ins.operands[0].data.param_ix != 0)       { bad = 4; }
    or (ins.operands[0].ty != aggt)               { bad = 2; }
    if (bad == 0) {
        if (ins.operands[1].kind != value.VAL_INSTR)  { bad = 5; }
        or (ins.operands[1].data.instr != slot_id)    { bad = 6; }
        or (ins.operands[1].ty != ptrt)               { bad = 7; }
    }
    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.ir.mutate.clone_instruction_complete:carries_both_debug_metadata_and_asm_payload_in_one_call" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_bound: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (sel r_bound.err) { ir.dnit(?m); ret 1; }
    val bound_id: id.InstructionId = r_bound.ok;

    val r_asm: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ASM, voidt, ?count[0], 0);
    if (sel r_asm.err) { ir.dnit(?m); ret 1; }
    val asm_id: id.InstructionId = r_asm.ok;

    var dv: ir.DbgVar;
    dv.name     = 9191::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 3;
    val r_593: res[bool, A.Error] = map.insert[id.InstructionId, ir.DbgVar](?fn.dbg_vars, asm_id, dv);
    if (sel r_593.err) { ir.dnit(?m); ret 1; }

    var bind: ir.IrAsmBind;
    bind.name   = 5151::intern.StrId;
    bind.instr  = bound_id;
    bind.secret = false;
    val rb: res[*ir.IrAsmBind, A.Error] = A.allocate[ir.IrAsmBind](m.alloc, 1::usize);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val binds: *ir.IrAsmBind = rb.ok;
    binds[0] = bind;

    var asm_val: ir.IrAsm;
    asm_val.isa        = intern.STR_NIL;
    asm_val.body       = intern.STR_NIL;
    asm_val.binds      = binds;
    asm_val.bind_count = 1;
    asm_val.bind_cap   = 1;
    val r_610: res[bool, A.Error] = map.insert[id.InstructionId, ir.IrAsm](?fn.asm_blocks, asm_id, asm_val);
    if (sel r_610.err) { ir.dnit(?m); ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: res[*u32, A.Error] = A.allocate[u32](m.alloc, map_len::usize);
    if (sel res_map.err) { ir.dnit(?m); ret 1; }
    val instr_map: *u32 = res_map.ok;
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    val r_clone_bound: res[id.InstructionId, fail.Fail] = clone_instruction_complete(?m, fn, fn, bound_id, instr_map, map_len);
    if (sel r_clone_bound.err) { A.deallocate[u32](m.alloc, instr_map, map_len::usize); ir.dnit(?m); ret 1; }
    instr_map[bound_id::u32] = r_clone_bound.ok::u32;

    val r_clone_asm: res[id.InstructionId, fail.Fail] = clone_instruction_complete(?m, fn, fn, asm_id, instr_map, map_len);
    if (sel r_clone_asm.err) { A.deallocate[u32](m.alloc, instr_map, map_len::usize); ir.dnit(?m); ret 1; }
    val clone_asm_id: id.InstructionId = r_clone_asm.ok;
    val clone_bound_id: id.InstructionId = instr_map[bound_id::u32]::id.InstructionId;
    A.deallocate[u32](m.alloc, instr_map, map_len::usize);

    var bad: i32 = 0;

    val opt_clone_dv: opt[*ir.DbgVar] = ir.dbg_var_get(fn, clone_asm_id);
    if (sel opt_clone_dv.none) { bad = 1; }
    or (sel opt_clone_dv.some) {
        val cdv: *ir.DbgVar = opt_clone_dv.some;
        if (cdv.name != 9191::intern.StrId) { bad = 2; }
        if (cdv.scope != 3)                 { bad = 3; }
    }

    var key: id.InstructionId = clone_asm_id;
    val res_clone_asm_blk: opt[*ir.IrAsm] = map.get[id.InstructionId, ir.IrAsm](?fn.asm_blocks, ?key);
    if (bad == 0) {
        if (sel res_clone_asm_blk.none) { bad = 4; }
        or (sel res_clone_asm_blk.some) {
            val cab: *ir.IrAsm = res_clone_asm_blk.some;
            if (cab.bind_count != 1)                  { bad = 5; }
            or (cab.binds[0].name != 5151::intern.StrId) { bad = 6; }
            or (cab.binds[0].instr != clone_bound_id)  { bad = 7; }
        }
    }

    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.ir.mutate.clone_instruction_complete:carries_alloca_debug_metadata_to_the_clone" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[r_fn.ok];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_alloca: res[id.InstructionId, fail.Fail] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (sel r_alloca.err) { ir.dnit(?m); ret 1; }
    val alloca_id: id.InstructionId = r_alloca.ok;

    var dv: ir.DbgVar;
    dv.name     = 7373::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 5;
    val r_687: err[fail.Fail] = ir.record_alloca_dbg_var(fn, alloca_id, dv);
    if (sel r_687.err) { ir.dnit(?m); ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: res[*u32, A.Error] = A.allocate[u32](m.alloc, map_len::usize);
    if (sel res_map.err) { ir.dnit(?m); ret 1; }
    val instr_map: *u32 = res_map.ok;
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    val r_clone: res[id.InstructionId, fail.Fail] = clone_instruction_complete(?m, fn, fn, alloca_id, instr_map, map_len);
    A.deallocate[u32](m.alloc, instr_map, map_len::usize);
    if (sel r_clone.err) { ir.dnit(?m); ret 1; }
    val clone_id: id.InstructionId = r_clone.ok;

    var bad: i32 = 0;
    val opt_clone_dv: opt[*ir.DbgVar] = ir.alloca_dbg_var_get(fn, clone_id);
    if (sel opt_clone_dv.none) { bad = 1; }
    or (sel opt_clone_dv.some) {
        val cdv: *ir.DbgVar = opt_clone_dv.some;
        if (cdv.name != 7373::intern.StrId) { bad = 2; }
        if (cdv.scope != 5)                 { bad = 3; }
    }

    ir.dnit(?m);
    ret bad;
}
