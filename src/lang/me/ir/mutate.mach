use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;
use std.collections.map;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.source;

pub rec Rewrite {
    vals: *value.Value;
    live: *bool;
    len:  u32;
}

pub fun rewrite_init(rw: *Rewrite, a: *A.Allocator, len: u32) R.Result[R.Void, str] {
    val res_vals: R.Result[*value.Value, str] = A.allocate[value.Value](a, len::usize);
    if (R.is_err[*value.Value, str](res_vals)) {
        ret R.err[R.Void, str](R.unwrap_err[*value.Value, str](res_vals));
    }
    val res_live: R.Result[*bool, str] = A.allocate[bool](a, len::usize);
    if (R.is_err[*bool, str](res_live)) {
        A.deallocate[value.Value](a, R.unwrap_ok[*value.Value, str](res_vals), len::usize);
        ret R.err[R.Void, str](R.unwrap_err[*bool, str](res_live));
    }

    rw.vals = R.unwrap_ok[*value.Value, str](res_vals);
    rw.live = R.unwrap_ok[*bool, str](res_live);
    rw.len  = len;

    var i: u32 = 0;
    for (i < len) { rw.live[i] = false; i = i + 1; }
    ret R.ok_void[str]();
}

pub fun rewrite_dnit(rw: *Rewrite, a: *A.Allocator) {
    if (rw.vals != nil && rw.len > 0) { A.deallocate[value.Value](a, rw.vals, rw.len::usize); }
    if (rw.live != nil && rw.len > 0) { A.deallocate[bool](a, rw.live, rw.len::usize); }
    rw.vals = nil;
    rw.live = nil;
    rw.len  = 0;
}

pub fun replace_value(rw: *Rewrite, iid: id.InstructionId, v: value.Value) {
    rw.vals[iid::u32] = v;
    rw.live[iid::u32] = true;
}

pub fun rewrite_has(rw: *Rewrite, iid: id.InstructionId) bool {
    val idx: u32 = iid::u32;
    ret idx < rw.len && rw.live[idx];
}

pub fun rewrite_resolve(rw: *Rewrite, v: value.Value) value.Value {
    var cur:  value.Value = v;
    var hops: u32         = 0;
    for (cur.kind == value.VAL_INSTR && hops <= rw.len) {
        val iid: u32 = cur.data.instr::u32;
        if (iid >= rw.len || rw.live[iid] == false) { ret substitute_for_use(cur, v); }
        cur  = rw.vals[iid];
        hops = hops + 1;
    }
    ret substitute_for_use(cur, v);
}

fun carry_secret(sub: value.Value, orig: value.Value) value.Value {
    var out: value.Value = sub;
    if (orig.secret) { out.secret = true; }
    ret out;
}

pub fun substitute_for_use(sub: value.Value, use: value.Value) value.Value {
    ret carry_secret(value.retype(sub, use.ty), use);
}

pub fun rewrite_apply(fn: *ir.Function, rw: *Rewrite) {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        var ii: u32 = 0;
        for (ii < inst.operand_count) {
            val op: value.Value = inst.operands[ii];
            if (op.kind == value.VAL_INSTR) {
                val iid: u32 = op.data.instr::u32;
                if (iid < rw.len && rw.live[iid]) {
                    inst.operands[ii] = rewrite_resolve(rw, op);
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

pub fun replace_uses(fn: *ir.Function, old_id: id.InstructionId, replacement: value.Value) {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        var ii: u32 = 0;
        for (ii < inst.operand_count) {
            val op: value.Value = inst.operands[ii];
            if (op.kind == value.VAL_INSTR && op.data.instr == old_id) {
                inst.operands[ii] = substitute_for_use(replacement, op);
            }
            ii = ii + 1;
        }
        i = i + 1;
    }
}

pub fun erase_marked[T](m: *ir.Module, fn: *ir.Function, ctx: *T,
                        test: fun(*T, id.InstructionId) bool) R.Result[bool, str] {
    if (ctx == nil || test == nil) {
        ret R.err[bool, str]("instruction erasure predicate is incomplete");
    }
    val dbg: bool = has_dbg_values(fn);
    var changed: bool = false;

    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[b];

        var w: u32 = 0;
        var r: u32 = 0;
        for (r < blk.phi_count) {
            if (test(ctx, blk.phis[r]) == false) {
                blk.phis[w] = blk.phis[r];
                w = w + 1;
            }
            or (dbg) {
                val res: R.Result[R.Void, str] =
                    salvage_dbg_values[T](m, fn, ctx, test, blk.phis[r]);
                if (R.is_err[R.Void, str](res)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res)); }
            }
            r = r + 1;
        }
        if (w != blk.phi_count) { changed = true; }
        blk.phi_count = w;

        w = 0;
        r = 0;
        for (r < blk.instr_count) {
            if (test(ctx, blk.instructions[r]) == false) {
                blk.instructions[w] = blk.instructions[r];
                w = w + 1;
            }
            or (dbg) {
                val res: R.Result[R.Void, str] =
                    salvage_dbg_values[T](m, fn, ctx, test, blk.instructions[r]);
                if (R.is_err[R.Void, str](res)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res)); }
            }
            r = r + 1;
        }
        if (w != blk.instr_count) { changed = true; }
        blk.instr_count = w;

        b = b + 1;
    }
    ret R.ok[bool, str](changed);
}

fun has_dbg_values(fn: *ir.Function) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (inst.kind == instruction.OP_DBG_VALUE) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun salvage_dbg_values[T](m: *ir.Module, fn: *ir.Function, ctx: *T,
                          test: fun(*T, id.InstructionId) bool,
                          dropped: id.InstructionId) R.Result[R.Void, str] {
    var base:        value.Value;
    var op:          ir.DbgOp;
    var recoverable: bool = false;
    salvage_decode(fn, dropped, ?base, ?op, ?recoverable);

    var base_live: bool = false;
    if (recoverable) {
        if (base.kind != value.VAL_INSTR) { base_live = true; }
        or { base_live = test(ctx, base.data.instr) == false; }
    }

    var i: u32 = 0;
    for (i < fn.instr_len) {
        val d: *instruction.Instruction = ?fn.instrs[i];
        if (d.kind == instruction.OP_DBG_VALUE && d.operand_count == 1
            && d.operands[0].kind == value.VAL_INSTR && d.operands[0].data.instr == dropped) {
            if (recoverable && base_live) {
                val res: R.Result[R.Void, str] = salvage_rebase(m, fn, i::id.InstructionId, d, base, op);
                if (R.is_err[R.Void, str](res)) { ret res; }
            }
            or {
                d.operands[0] = value.const_null(d.operands[0].ty);
            }
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

fun salvage_rebase(m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, d: *instruction.Instruction, base: value.Value, op: ir.DbgOp) R.Result[R.Void, str] {
    var eid: ir.DbgExprId = ir.dbg_expr_id(fn, iid);
    if (eid == ir.DBG_EXPR_IDENTITY) {
        val res_new: R.Result[ir.DbgExprId, str] = ir.dbg_expr_new(m, fn, iid);
        if (R.is_err[ir.DbgExprId, str](res_new)) {
            ret R.err[R.Void, str](R.unwrap_err[ir.DbgExprId, str](res_new));
        }
        eid = R.unwrap_ok[ir.DbgExprId, str](res_new);
    }
    val res_op: R.Result[R.Void, str] = ir.dbg_expr_prepend_op(m, fn, eid, op);
    if (R.is_err[R.Void, str](res_op)) { ret res_op; }
    d.operands[0] = base;
    ret R.ok_void[str]();
}

fun salvage_decode(fn: *ir.Function, dropped: id.InstructionId, base: *value.Value, op: *ir.DbgOp, recoverable: *bool) {
    @recoverable = false;
    val opt_x: O.Option[*instruction.Instruction] = ir.instruction_get(fn, dropped);
    if (O.is_none[*instruction.Instruction](opt_x)) { ret; }
    val x: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_x);

    if (x.kind == instruction.OP_ADD && x.operand_count == 2) {
        if (x.operands[1].kind == value.VAL_CONST_INT) {
            @base = x.operands[0];
            @op = dbg_op(ir.DBG_OP_PLUS_CONST, x.operands[1].data.int_lit);
            @recoverable = true;
            ret;
        }
        if (x.operands[0].kind == value.VAL_CONST_INT) {
            @base = x.operands[1];
            @op = dbg_op(ir.DBG_OP_PLUS_CONST, x.operands[0].data.int_lit);
            @recoverable = true;
            ret;
        }
    }
    if (x.kind == instruction.OP_SUB && x.operand_count == 2 && x.operands[1].kind == value.VAL_CONST_INT) {
        @base = x.operands[0];
        @op = dbg_op(ir.DBG_OP_MINUS_CONST, x.operands[1].data.int_lit);
        @recoverable = true;
        ret;
    }
}

fun dbg_op(kind: u8, arg: u64) ir.DbgOp {
    var o: ir.DbgOp;
    o.op  = kind;
    o.arg = arg;
    ret o;
}

pub fun clone_instruction(m: *ir.Module, dst_fn: *ir.Function, src: *instruction.Instruction) R.Result[id.InstructionId, str] {
    var clone: instruction.Instruction;
    clone.kind          = src.kind;
    clone.ty            = src.ty;
    clone.operand_count = src.operand_count;
    clone.operand_cap   = src.operand_count;
    clone.flags         = src.flags;
    clone.aux_ty        = src.aux_ty;
    clone.loc           = src.loc;
    clone.secret        = src.secret;
    clone.operands      = nil;
    if (src.operand_count > 0) {
        val res_ops: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, src.operand_count::usize);
        if (R.is_err[*value.Value, str](res_ops)) {
            ret R.err[id.InstructionId, str](R.unwrap_err[*value.Value, str](res_ops));
        }
        val ops: *value.Value = R.unwrap_ok[*value.Value, str](res_ops);
        var i: u32 = 0;
        for (i < src.operand_count) {
            ops[i] = src.operands[i];
            i = i + 1;
        }
        clone.operands = ops;
    }

    val res_id: R.Result[id.InstructionId, str] = ir.instruction_add(m, dst_fn, clone);
    if (R.is_err[id.InstructionId, str](res_id)) {
        if (clone.operands != nil) {
            A.deallocate[value.Value](m.alloc, clone.operands, clone.operand_count::usize);
        }
        ret res_id;
    }
    ret res_id;
}

pub fun clone_instruction_complete(m: *ir.Module, src_fn: *ir.Function, dst_fn: *ir.Function, src_iid: id.InstructionId, instr_map: *u32, map_len: u32) R.Result[id.InstructionId, str] {
    val src: *instruction.Instruction = ?src_fn.instrs[src_iid::u32];
    val res_id: R.Result[id.InstructionId, str] = clone_instruction(m, dst_fn, src);
    if (R.is_err[id.InstructionId, str](res_id)) { ret res_id; }
    val new_iid: id.InstructionId = R.unwrap_ok[id.InstructionId, str](res_id);

    val rd: R.Result[R.Void, str] = ir.clone_dbg_metadata(m, src_fn, dst_fn, src_iid, new_iid);
    if (R.is_err[R.Void, str](rd)) { ret R.err[id.InstructionId, str](R.unwrap_err[R.Void, str](rd)); }
    val ra: R.Result[R.Void, str] = ir.clone_asm_payload(m, src_fn, dst_fn, src_iid, new_iid, instr_map, map_len);
    if (R.is_err[R.Void, str](ra)) { ret R.err[id.InstructionId, str](R.unwrap_err[R.Void, str](ra)); }
    val rl: R.Result[R.Void, str] = ir.clone_alloca_dbg_var(src_fn, dst_fn, src_iid, new_iid);
    if (R.is_err[R.Void, str](rl)) { ret R.err[id.InstructionId, str](R.unwrap_err[R.Void, str](rl)); }
    val rs: R.Result[R.Void, str] = ir.clone_instr_inline_site(src_fn, dst_fn, src_iid, new_iid);
    if (R.is_err[R.Void, str](rs)) { ret R.err[id.InstructionId, str](R.unwrap_err[R.Void, str](rs)); }
    ret R.ok[id.InstructionId, str](new_iid);
}

fun test_instr(m: *ir.Module, fn: *ir.Function, kind: instruction.InstrKind, ty: ir_type.IrTypeId, ops: *value.Value, n: u32) R.Result[id.InstructionId, str] {
    var owned: *value.Value = nil;
    if (n > 0) {
        val res_ops: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, n::usize);
        if (R.is_err[*value.Value, str](res_ops)) { ret R.err[id.InstructionId, str](R.unwrap_err[*value.Value, str](res_ops)); }
        owned = R.unwrap_ok[*value.Value, str](res_ops);
        var i: u32 = 0;
        for (i < n) { owned[i] = ops[i]; i = i + 1; }
    }
    var inst: instruction.Instruction;
    inst.kind          = kind;
    inst.ty            = ty;
    inst.operands      = owned;
    inst.operand_count = n;
    inst.operand_cap   = n;
    inst.flags         = 0;
    inst.aux_ty        = ir_type.IRT_NIL;
    inst.loc           = source.loc_nil();
    inst.secret        = false;
    ret ir.instruction_add(m, fn, inst);
}

test "mach.lang.me.ir.mutate.replace_uses:preserves_use_site_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);
    var fields: [3]ir_type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ir.dnit(?m); ret 1; }
    val aggt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](r_fn)];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_v: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_v)) { ir.dnit(?m); ret 1; }
    val v_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_v);
    val r_slot: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_slot)) { ir.dnit(?m); ret 1; }
    val slot_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_slot);

    var store_ops: [2]value.Value;
    store_ops[0] = value.instr(v_id, aggt);
    store_ops[1] = value.instr(slot_id, ptrt);
    val r_store: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_STORE, voidt, ?store_ops[0], 2);
    if (R.is_err[id.InstructionId, str](r_store)) { ir.dnit(?m); ret 1; }
    val store_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_store);

    replace_uses(fn, v_id, value.param(0, ptrt));

    val oi: O.Option[*instruction.Instruction] = ir.instruction_get(fn, store_id);
    if (O.is_none[*instruction.Instruction](oi)) { ir.dnit(?m); ret 1; }
    val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);

    var bad: i32 = 0;
    if (ins.operands[0].kind != value.VAL_PARAM)  { bad = 3; }
    or (ins.operands[0].data.param_ix != 0)       { bad = 4; }
    or (ins.operands[0].ty != aggt)               { bad = 2; }
    if (bad == 0) {
        if (ins.operands[1].kind != value.VAL_INSTR)  { bad = 5; }
        or (ins.operands[1].data.instr != slot_id)    { bad = 6; }
        or (ins.operands[1].ty != ptrt)               { bad = 7; }
    }
    ir.dnit(?m);
    ret bad;
}

fun t_erase_none(target: *id.InstructionId, iid: id.InstructionId) bool { ret false; }

fun t_erase_target(target: *id.InstructionId, iid: id.InstructionId) bool {
    ret iid == @target;
}

test "mach.lang.me.ir.mutate.erase_marked:reports_no_change_when_nothing_is_marked" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](r_fn)];

    val res_blk: R.Result[id.BlockId, str] = ir.block_add(?m, fn);
    if (R.is_err[id.BlockId, str](res_blk)) { ir.dnit(?m); ret 1; }
    val bid: id.BlockId = R.unwrap_ok[id.BlockId, str](res_blk);
    val blk: *ir.Block = ?fn.blocks[bid::u32];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_ret: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_RET, i64t, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_ret)) { ir.dnit(?m); ret 1; }
    blk.terminator = R.unwrap_ok[id.InstructionId, str](r_ret);

    var target: id.InstructionId = id.INSTR_NIL;
    val target_ptr: *id.InstructionId = ?target;
    val res: R.Result[bool, str] =
        erase_marked[id.InstructionId](?m, fn, target_ptr, t_erase_none);
    if (R.is_err[bool, str](res)) { ir.dnit(?m); ret 1; }
    val changed: bool = R.unwrap_ok[bool, str](res);
    ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.mutate.erase_marked:reports_change_when_the_marked_instruction_is_erased" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](r_fn)];

    val res_blk: R.Result[id.BlockId, str] = ir.block_add(?m, fn);
    if (R.is_err[id.BlockId, str](res_blk)) { ir.dnit(?m); ret 1; }
    val bid: id.BlockId = R.unwrap_ok[id.BlockId, str](res_blk);
    val blk: *ir.Block = ?fn.blocks[bid::u32];

    var addops: [2]value.Value;
    addops[0] = value.param(0, i64t);
    addops[1] = value.param(1, i64t);
    val r_add: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ADD, i64t, ?addops[0], 2);
    if (R.is_err[id.InstructionId, str](r_add)) { ir.dnit(?m); ret 1; }
    val x_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_add);
    if (R.is_err[R.Void, str](ir.block_append_instr(?m, blk, x_id))) { ir.dnit(?m); ret 1; }

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_ret: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_RET, i64t, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_ret)) { ir.dnit(?m); ret 1; }
    blk.terminator = R.unwrap_ok[id.InstructionId, str](r_ret);

    val before: u32 = blk.instr_count;

    var target: id.InstructionId = x_id;
    val target_ptr: *id.InstructionId = ?target;
    val res: R.Result[bool, str] =
        erase_marked[id.InstructionId](?m, fn, target_ptr, t_erase_target);
    if (R.is_err[bool, str](res)) { ir.dnit(?m); ret 1; }
    val changed: bool = R.unwrap_ok[bool, str](res);
    val after: u32 = blk.instr_count;
    ir.dnit(?m);
    if (changed != true) { ret 1; }
    if (after != before - 1) { ret 1; }
    ret 0;
}

test "mach.lang.me.ir.mutate.rewrite_apply:preserves_use_site_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);
    var fields: [3]ir_type.IrTypeId;
    fields[0] = i64t; fields[1] = i64t; fields[2] = i64t;
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_struct(?m.types, ?fields[0], 3, 8, false);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ir.dnit(?m); ret 1; }
    val aggt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](r_fn)];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_v: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_v)) { ir.dnit(?m); ret 1; }
    val v_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_v);
    val r_slot: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_slot)) { ir.dnit(?m); ret 1; }
    val slot_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_slot);

    var store_ops: [2]value.Value;
    store_ops[0] = value.instr(v_id, aggt);
    store_ops[1] = value.instr(slot_id, ptrt);
    val r_store: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_STORE, voidt, ?store_ops[0], 2);
    if (R.is_err[id.InstructionId, str](r_store)) { ir.dnit(?m); ret 1; }
    val store_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_store);

    var rw: Rewrite;
    if (R.is_err[R.Void, str](rewrite_init(?rw, ?alloc, fn.instr_len))) { ir.dnit(?m); ret 1; }
    replace_value(?rw, v_id, value.param(0, ptrt));
    rewrite_apply(fn, ?rw);
    rewrite_dnit(?rw, ?alloc);

    val oi: O.Option[*instruction.Instruction] = ir.instruction_get(fn, store_id);
    if (O.is_none[*instruction.Instruction](oi)) { ir.dnit(?m); ret 1; }
    val ins: *instruction.Instruction = O.unwrap[*instruction.Instruction](oi);

    var bad: i32 = 0;
    if (ins.operands[0].kind != value.VAL_PARAM)  { bad = 3; }
    or (ins.operands[0].data.param_ix != 0)       { bad = 4; }
    or (ins.operands[0].ty != aggt)               { bad = 2; }
    if (bad == 0) {
        if (ins.operands[1].kind != value.VAL_INSTR)  { bad = 5; }
        or (ins.operands[1].data.instr != slot_id)    { bad = 6; }
        or (ins.operands[1].ty != ptrt)               { bad = 7; }
    }
    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.ir.mutate.clone_instruction_complete:carries_both_debug_metadata_and_asm_payload_in_one_call" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](r_fn)];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_bound: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_bound)) { ir.dnit(?m); ret 1; }
    val bound_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_bound);

    val r_asm: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ASM, voidt, ?count[0], 0);
    if (R.is_err[id.InstructionId, str](r_asm)) { ir.dnit(?m); ret 1; }
    val asm_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_asm);

    var dv: ir.DbgVar;
    dv.name     = 9191::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 3;
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.DbgVar](?fn.dbg_vars, asm_id, dv))) { ir.dnit(?m); ret 1; }

    var bind: ir.IrAsmBind;
    bind.name   = 5151::intern.StrId;
    bind.instr  = bound_id;
    bind.secret = false;
    val rb: R.Result[*ir.IrAsmBind, str] = A.allocate[ir.IrAsmBind](m.alloc, 1::usize);
    if (R.is_err[*ir.IrAsmBind, str](rb)) { ir.dnit(?m); ret 1; }
    val binds: *ir.IrAsmBind = R.unwrap_ok[*ir.IrAsmBind, str](rb);
    binds[0] = bind;

    var asm_val: ir.IrAsm;
    asm_val.isa        = intern.STR_NIL;
    asm_val.body       = intern.STR_NIL;
    asm_val.binds      = binds;
    asm_val.bind_count = 1;
    asm_val.bind_cap   = 1;
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.IrAsm](?fn.asm_blocks, asm_id, asm_val))) { ir.dnit(?m); ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: R.Result[*u32, str] = A.allocate[u32](m.alloc, map_len::usize);
    if (R.is_err[*u32, str](res_map)) { ir.dnit(?m); ret 1; }
    val instr_map: *u32 = R.unwrap_ok[*u32, str](res_map);
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    val r_clone_bound: R.Result[id.InstructionId, str] = clone_instruction_complete(?m, fn, fn, bound_id, instr_map, map_len);
    if (R.is_err[id.InstructionId, str](r_clone_bound)) { A.deallocate[u32](m.alloc, instr_map, map_len::usize); ir.dnit(?m); ret 1; }
    instr_map[bound_id::u32] = R.unwrap_ok[id.InstructionId, str](r_clone_bound)::u32;

    val r_clone_asm: R.Result[id.InstructionId, str] = clone_instruction_complete(?m, fn, fn, asm_id, instr_map, map_len);
    if (R.is_err[id.InstructionId, str](r_clone_asm)) { A.deallocate[u32](m.alloc, instr_map, map_len::usize); ir.dnit(?m); ret 1; }
    val clone_asm_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_clone_asm);
    val clone_bound_id: id.InstructionId = instr_map[bound_id::u32]::id.InstructionId;
    A.deallocate[u32](m.alloc, instr_map, map_len::usize);

    var bad: i32 = 0;

    val opt_clone_dv: O.Option[*ir.DbgVar] = ir.dbg_var_get(fn, clone_asm_id);
    if (O.is_none[*ir.DbgVar](opt_clone_dv)) { bad = 1; }
    or {
        val cdv: *ir.DbgVar = O.unwrap[*ir.DbgVar](opt_clone_dv);
        if (cdv.name != 9191::intern.StrId) { bad = 2; }
        if (cdv.scope != 3)                 { bad = 3; }
    }

    var key: id.InstructionId = clone_asm_id;
    val res_clone_asm_blk: R.Result[*ir.IrAsm, str] = map.get[id.InstructionId, ir.IrAsm](?fn.asm_blocks, ?key);
    if (bad == 0) {
        if (R.is_err[*ir.IrAsm, str](res_clone_asm_blk)) { bad = 4; }
        or {
            val cab: *ir.IrAsm = R.unwrap_ok[*ir.IrAsm, str](res_clone_asm_blk);
            if (cab.bind_count != 1)                  { bad = 5; }
            or (cab.binds[0].name != 5151::intern.StrId) { bad = 6; }
            or (cab.binds[0].instr != clone_bound_id)  { bad = 7; }
        }
    }

    ir.dnit(?m);
    ret bad;
}

test "mach.lang.me.ir.mutate.clone_instruction_complete:carries_alloca_debug_metadata_to_the_clone" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](r_fn)];

    var count: [1]value.Value;
    count[0] = value.const_int(1, i64t);
    val r_alloca: R.Result[id.InstructionId, str] = test_instr(?m, fn, instruction.OP_ALLOCA, ptrt, ?count[0], 1);
    if (R.is_err[id.InstructionId, str](r_alloca)) { ir.dnit(?m); ret 1; }
    val alloca_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_alloca);

    var dv: ir.DbgVar;
    dv.name     = 7373::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 5;
    if (R.is_err[R.Void, str](ir.record_alloca_dbg_var(fn, alloca_id, dv))) { ir.dnit(?m); ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: R.Result[*u32, str] = A.allocate[u32](m.alloc, map_len::usize);
    if (R.is_err[*u32, str](res_map)) { ir.dnit(?m); ret 1; }
    val instr_map: *u32 = R.unwrap_ok[*u32, str](res_map);
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    val r_clone: R.Result[id.InstructionId, str] = clone_instruction_complete(?m, fn, fn, alloca_id, instr_map, map_len);
    A.deallocate[u32](m.alloc, instr_map, map_len::usize);
    if (R.is_err[id.InstructionId, str](r_clone)) { ir.dnit(?m); ret 1; }
    val clone_id: id.InstructionId = R.unwrap_ok[id.InstructionId, str](r_clone);

    var bad: i32 = 0;
    val opt_clone_dv: O.Option[*ir.DbgVar] = ir.alloca_dbg_var_get(fn, clone_id);
    if (O.is_none[*ir.DbgVar](opt_clone_dv)) { bad = 1; }
    or {
        val cdv: *ir.DbgVar = O.unwrap[*ir.DbgVar](opt_clone_dv);
        if (cdv.name != 7373::intern.StrId) { bad = 2; }
        if (cdv.scope != 5)                 { bad = 3; }
    }

    ir.dnit(?m);
    ret bad;
}
