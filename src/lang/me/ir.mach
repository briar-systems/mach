test "mach.lang.me.ir.phi_append_incoming:refuses_a_doubled_capacity_that_wraps_to_zero_before_reallocating" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: Module = rm.ok;

    val res_i64t: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64t.err) { dnit(?m); ret 1; }
    val i64t: type.IrTypeId = res_i64t.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { dnit(?m); ret 1; }
    val fn: *Function = ?m.functions[res_fn.ok];

    val res_b: res[id.BlockId, fail.Fail] = block_add(?m, fn);
    if (sel res_b.err) { dnit(?m); ret 1; }
    val pred: id.BlockId = res_b.ok;

    var probe: GrowCapProbe;
    probe.reallocate_calls = 0;
    var pp: *GrowCapProbe = ?probe;
    var probe_alloc: A.Allocator;
    probe_alloc.ctx           = pp::ptr;
    probe_alloc.fn_allocate   = growcap_probe_allocate;
    probe_alloc.fn_reallocate = growcap_probe_reallocate;
    probe_alloc.fn_deallocate = growcap_probe_deallocate;

    var phi: instruction.Instruction;
    phi.kind          = instruction.OP_PHI;
    phi.ty            = i64t;
    phi.operands      = nil;
    phi.operand_count = 0x7FFFFFFF;
    phi.operand_cap   = 0x80000000;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;

    val real_alloc: *A.Allocator = m.alloc;
    m.alloc = ?probe_alloc;
    val incoming: value.Value = value.const_int(0, i64t);
    val res_append: err[fail.Fail] = phi_append_incoming(?m, ?phi, pred, incoming);
    m.alloc = real_alloc;

    var bad: i32 = 0;
    if (!sel res_append.err) { bad = 1; }
    if (probe.reallocate_calls != 0)      { bad = 2; }
    if (phi.operands != nil)              { bad = 3; }

    dnit(?m);
    ret bad;
}

test "mach.lang.me.ir.FN_FLAG:every_flag_is_a_distinct_single_bit" {
    var flags: [10]u32;
    flags[0] = FN_FLAG_PUB; flags[1] = FN_FLAG_EXTERN; flags[2] = FN_FLAG_INLINE; flags[3] = FN_FLAG_NORETURN;
    flags[4] = FN_FLAG_TEST; flags[5] = FN_FLAG_WEAK; flags[6] = FN_FLAG_OBLIVIOUS; flags[7] = FN_FLAG_SCALAR;
    flags[8] = FN_FLAG_NOINLINE; flags[9] = FN_FLAG_NAKED;

    var i: u32 = 0;
    for (i < 10) {
        if (flags[i] == 0 || (flags[i] & (flags[i] - 1)) != 0) { ret 1; }
        var j: u32 = i + 1;
        for (j < 10) {
            if ((flags[i] & flags[j]) != 0) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
