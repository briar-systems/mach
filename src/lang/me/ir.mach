    fn.instr_len = 0xFFFFFFFF;
    val res_over: res[id.InstructionId, fail.Fail] = instruction_add(?m, fn, inst);
    if (!sel res_over.err) { fn.instr_len = 0; dnit(?m); ret 1; }
    if (fn.instr_len != 0xFFFFFFFF)                 { dnit(?m); ret 1; }

    fn.instr_len = 0;
    val res_ok: res[id.InstructionId, fail.Fail] = instruction_add(?m, fn, inst);
    if (sel res_ok.err) { dnit(?m); ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.phi_append_incoming:refuses_operand_count_overflow" {
    var alloc: A.Allocator;
