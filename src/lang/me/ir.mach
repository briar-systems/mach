test phi_append_incoming__refuses_operand_count_overflow {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: Module = rm.ok;

    val res_i64t: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64t.err) {
        dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId = res_i64t.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) {
        dnit(?m);
        ret 1;
    }
    val fn: *Function = ?m.functions[res_fn.ok];

    val res_b: res[ir_id.BlockId, fail.Fail] = block_add(?m, fn);
    if (sel res_b.err) {
        dnit(?m);
        ret 1;
    }
    val pred: ir_id.BlockId = res_b.ok;

    var phi: ir_instruction.Instruction = ir_instruction.init(ir_instruction.OP_PHI, i64t, nil, 0xFFFFFFFE);

    val incoming:   value.Value    = value.const_int(0, i64t);
    val res_append: err[fail.Fail] = phi_append_incoming(?m, ?phi, pred, incoming);
    if (!sel res_append.err) {
        dnit(?m);
        ret 1;
    }
    if (phi.operands != nil) {
        dnit(?m);
        ret 1;
    }

    dnit(?m);
    ret 0;
}

test fn_flag__every_flag_is_a_distinct_single_bit {
    var flags: [10]u32;
    flags[0] = FN_FLAG_PUB;
    flags[1] = FN_FLAG_EXTERN;
    flags[2] = FN_FLAG_INLINE;
    flags[3] = FN_FLAG_NORETURN;
    flags[4] = FN_FLAG_TEST;
    flags[5] = FN_FLAG_WEAK;
    flags[6] = FN_FLAG_OBLIVIOUS;
    flags[7] = FN_FLAG_SCALAR;
    flags[8] = FN_FLAG_NOINLINE;
    flags[9] = FN_FLAG_NAKED;

    var i: u32 = 0;
    for (i < 10) {
        if (flags[i] == 0 || (flags[i] & (flags[i] - 1)) != 0) { ret 1; }
        var j: u32 = i + 1;
        for (j < 10) {
            if ((flags[i] & flags[j]) != 0) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

#[testing]
fun keep_odd_blocks(seen: *u32, target: *value.Value) bool {
    @seen = @seen + 1;
    ret (ir_id.block_index(block_target(@target)) & 1) == 1;
}

test phi_incoming__del_and_keep_drop_whole_pairs {
    var ops: [8]value.Value;
    var i:   u32 = 0;
    for (i < 4) {
        ops[i * 2]     = value.const_int(i::u64, ir_type.id(0));
        ops[i * 2 + 1] = value.const_int((10 + i)::u64, ir_type.id(0));
        i              = i + 1;
    }
    var phi: ir_instruction.Instruction = ir_instruction.init(ir_instruction.OP_PHI, ir_type.id(0), ?ops[0], 8);
    phi_incoming_del(?phi, ir_id.block(2));
    if (phi.operand_count != 6)                                                               { ret 1; }
    if (!ir_id.block_same(block_target(ops[4]), ir_id.block(3)) || ops[5].data.int_lit != 13) { ret 2; }
    var seen: u32 = 0;
    phi_incoming_keep[u32](?phi, ?seen, keep_odd_blocks);
    if (seen != 3 || phi.operand_count != 4)                                                  { ret 3; }
    if (!ir_id.block_same(block_target(ops[0]), ir_id.block(1)) || ops[1].data.int_lit != 11) { ret 4; }
    if (!ir_id.block_same(block_target(ops[2]), ir_id.block(3)) || ops[3].data.int_lit != 13) { ret 4; }
    block_target_set(?ops[2], ir_id.block(7));
    phi_incoming_del_at(?phi, 0);
    if (phi.operand_count != 2 || !ir_id.block_same(block_target(ops[0]), ir_id.block(7))) { ret 5; }
    ret 0;
}

test global_add__appends_a_private_immutable_global {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: Module = res_m.ok;
    fin { dnit(?m); }
    val before: u32    = m.global_len;
    var g:      Global = global_init(intern.str_id(3), ir_type.id(0), value.const_int(0, ir_type.id(0)));
    g.align = 16;
    val added: res[u32, fail.Fail] = global_add(?m, g);
    if (sel added.err)                                    { ret 1; }
    if (added.ok != before || m.global_len != before + 1) { ret 2; }
    val got: *Global = ?m.globals[added.ok];
    if (got.is_mut || got.is_pub || got.is_extern || got.is_local || got.align != 16) { ret 3; }
    if (got.iface != IFACE_NONE)                                                      { ret 3; }
    if (lang_source.location_is_valid(got.decl_loc))                                  { ret 3; }
    ret 0;
}
