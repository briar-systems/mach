    val fn: *Function = ?m.functions[res_fn.ok];

    var inst: instruction.Instruction;
    inst.kind          = instruction.OP_ADD;
    inst.ty            = i64t;
    inst.operands      = nil;
    inst.operand_count = 0;
    inst.operand_cap   = 0;
    inst.flags         = 0;
