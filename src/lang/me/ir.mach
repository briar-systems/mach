}

pub rec ModuleHome {
    backing: A.Allocator;
    ar:      arena.Arena;
    alloc:   A.Allocator;
}

pub fun home_init(h: *ModuleHome) O.Option[str] {
    if (h == nil) { ret O.some[str]("ir: module home is nil"); }
    if (O.is_some[str](page.make(?h.backing)))             { ret O.some[str]("ir: module home backing alloc failed"); }
    if (O.is_some[str](arena.init(?h.ar, ?h.backing, 0)))  { ret O.some[str]("ir: module home arena init failed"); }
    if (O.is_some[str](arena.make(?h.alloc, ?h.ar)))       { arena.dnit(?h.ar); ret O.some[str]("ir: module home arena bind failed"); }
    ret O.none[str]();
}

pub fun home_dnit(h: *ModuleHome) {
    if (h == nil) { ret; }
    arena.dnit(?h.ar);
}

pub rec Module {
    alloc: *A.Allocator;
    name:  intern.StrId;

    functions:    *Function;
    function_len: u32;
    function_cap: u32;

    globals:    *Global;
    global_len: u32;
    global_cap: u32;

    types: type.IrTypeTable;

    init_fn: O.Option[u32];

    fn_by_name:     map.Map[intern.StrId, u32];
    global_by_name: map.Map[intern.StrId, u32];

    vector_ops_scalarized: u32;
}

val INITIAL_FN_CAP:          u32 = 8;
val INITIAL_GLOBAL_CAP:      u32 = 8;
val INITIAL_INSTR_CAP:       u32 = 64;
val INITIAL_BLOCK_LIST_CAP:  u32 = 4;
val INITIAL_PHI_OPERAND_CAP: u32 = 4;
val INITIAL_DBG_EXPR_CAP:    u32 = 4;
val INITIAL_DBG_OP_CAP:      u32 = 4;
val INITIAL_INLINE_SITE_CAP: u32 = 4;

pub fun init(a: *A.Allocator, name: intern.StrId) R.Result[Module, str] {
    var m: Module;
    m.alloc = a;
    m.name  = name;

    m.functions    = nil;
    m.function_len = 0;
    m.function_cap = 0;
    m.globals      = nil;
    m.global_len   = 0;
    m.global_cap   = 0;
    m.init_fn      = O.none[u32]();
    m.vector_ops_scalarized = 0;

    m.fn_by_name     = map.init[intern.StrId, u32](a, map.hash_u32, map.eq_u32);
    m.global_by_name = map.init[intern.StrId, u32](a, map.hash_u32, map.eq_u32);

    val opt_types: O.Option[str] = type.init(?m.types, a);
    if (O.is_some[str](opt_types)) {
        ret R.err[Module, str](O.unwrap[str](opt_types));
    }

    val res_functions: R.Result[*Function, str] = A.allocate[Function](a, INITIAL_FN_CAP::usize);
    if (R.is_err[*Function, str](res_functions)) {
        type.dnit(?m.types);
        ret R.err[Module, str](R.unwrap_err[*Function, str](res_functions));
    }
    m.functions    = R.unwrap_ok[*Function, str](res_functions);
    m.function_cap = INITIAL_FN_CAP;

    val res_globals: R.Result[*Global, str] = A.allocate[Global](a, INITIAL_GLOBAL_CAP::usize);
    if (R.is_err[*Global, str](res_globals)) {
        A.deallocate[Function](a, m.functions, m.function_cap::usize);
        type.dnit(?m.types);
        ret R.err[Module, str](R.unwrap_err[*Global, str](res_globals));
    }
    m.globals    = R.unwrap_ok[*Global, str](res_globals);
    m.global_cap = INITIAL_GLOBAL_CAP;

    ret R.ok[Module, str](m);
}

pub fun dnit(m: *Module) {
    if (m == nil) { ret; }

    var i: u32 = 0;
    for (i < m.function_len) {
        function_dnit(m, ?m.functions[i]);
        i = i + 1;
    }

    i = 0;
    for (i < m.global_len) {
        agg_value_dnit(m, ?m.globals[i].init);
        i = i + 1;
    }

    if (m.functions != nil && m.function_cap > 0) {
        A.deallocate[Function](m.alloc, m.functions, m.function_cap::usize);
    }
    if (m.globals != nil && m.global_cap > 0) {
        A.deallocate[Global](m.alloc, m.globals, m.global_cap::usize);
    }
    map.dnit[intern.StrId, u32](?m.fn_by_name);
    map.dnit[intern.StrId, u32](?m.global_by_name);
    type.dnit(?m.types);

    m.functions    = nil;
    m.function_len = 0;
    m.function_cap = 0;
    m.globals      = nil;
    m.global_len   = 0;
    m.global_cap   = 0;
    m.init_fn      = O.none[u32]();
    m.vector_ops_scalarized = 0;
    m.name         = intern.STR_NIL;
    m.alloc        = nil;
}

pub fun function_dnit(m: *Module, fn: *Function) {
    var i: u32 = 0;
    for (i < fn.block_count) {
        block_dnit(m, ?fn.blocks[i]);
        i = i + 1;
    }
    if (fn.blocks != nil && fn.block_cap > 0) {
        A.deallocate[Block](m.alloc, fn.blocks, fn.block_cap::usize);
    }
    if (fn.params != nil && fn.param_count > 0) {
        A.deallocate[value.Value](m.alloc, fn.params, fn.param_count::usize);
    }

    i = 0;
    for (i < fn.instr_len) {
        if (fn.instrs[i].kind == instruction.OP_ASM) {
            var key: id.InstructionId = i::id.InstructionId;
            val res_asm: R.Result[*IrAsm, str] = map.get[id.InstructionId, IrAsm](?fn.asm_blocks, ?key);
            if (R.is_ok[*IrAsm, str](res_asm)) {
                val asm: *IrAsm = R.unwrap_ok[*IrAsm, str](res_asm);
                if (asm.binds != nil && asm.bind_cap > 0) {
                    A.deallocate[IrAsmBind](m.alloc, asm.binds, asm.bind_cap::usize);
                }
            }
        }
        instruction_dnit(m, ?fn.instrs[i]);
        i = i + 1;
    }
    if (fn.instrs != nil && fn.instr_cap > 0) {
        A.deallocate[instruction.Instruction](m.alloc, fn.instrs, fn.instr_cap::usize);
    }
    map.dnit[id.InstructionId, IrAsm](?fn.asm_blocks);
    map.dnit[id.InstructionId, DbgVar](?fn.dbg_vars);
    map.dnit[id.InstructionId, DbgVar](?fn.alloca_dbg_vars);

    var e: u32 = 0;
    for (e < fn.dbg_expr_len) {
        val dex: *DbgExpr = ?fn.dbg_exprs[e];
        if (dex.ops != nil && dex.op_cap > 0) {
            A.deallocate[DbgOp](m.alloc, dex.ops, dex.op_cap::usize);
        }
        e = e + 1;
    }
    if (fn.dbg_exprs != nil && fn.dbg_expr_cap > 0) {
        A.deallocate[DbgExpr](m.alloc, fn.dbg_exprs, fn.dbg_expr_cap::usize);
    }
    map.dnit[id.InstructionId, DbgExprId](?fn.dbg_expr_ids);

    if (fn.inline_sites != nil && fn.inline_site_cap > 0) {
        A.deallocate[InlineSite](m.alloc, fn.inline_sites, fn.inline_site_cap::usize);
    }
    map.dnit[id.InstructionId, u32](?fn.instr_inline_site);
}

fun block_dnit(m: *Module, blk: *Block) {
    if (blk.instructions != nil && blk.instr_cap > 0) {
        A.deallocate[id.InstructionId](m.alloc, blk.instructions, blk.instr_cap::usize);
    }
    if (blk.phis != nil && blk.phi_cap > 0) {
        A.deallocate[id.InstructionId](m.alloc, blk.phis, blk.phi_cap::usize);
    }
    if (blk.preds != nil && blk.pred_cap > 0) {
        A.deallocate[id.BlockId](m.alloc, blk.preds, blk.pred_cap::usize);
    }
}

fun instruction_dnit(m: *Module, inst: *instruction.Instruction) {
    if (inst.operands != nil && inst.operand_cap > 0) {
        A.deallocate[value.Value](m.alloc, inst.operands, inst.operand_cap::usize);
    }
}

fun agg_value_dnit(m: *Module, v: *value.Value) {
    if (v.kind != value.VAL_CONST_AGG) { ret; }
    if (v.data.agg.bytes != nil && v.data.agg.len > 0) {
        A.deallocate[u8](m.alloc, v.data.agg.bytes, v.data.agg.len::usize);
    }
    if (v.data.agg.relocs != nil && v.data.agg.reloc_cap > 0) {
        A.deallocate[value.AggReloc](m.alloc, v.data.agg.relocs, v.data.agg.reloc_cap::usize);
    }
}

pub fun function_new(alloc: *A.Allocator, name: intern.StrId, sig: type.IrTypeId, flags: u32) Function {
    var f: Function;
    f.name        = name;
    f.sig         = sig;
    f.params      = nil;
    f.param_count = 0;
    f.blocks      = nil;
    f.block_count = 0;
    f.block_cap   = 0;
    f.instrs      = nil;
    f.instr_len   = 0;
    f.instr_cap   = 0;
    f.flags       = flags;
    f.is_import   = false;
    f.label       = intern.STR_NIL;
    f.line        = 0;
    f.section     = intern.STR_NIL;
    f.stage       = STAGE_NONE;
    f.wg_x        = 1;
    f.wg_y        = 1;
    f.wg_z        = 1;
    f.op_set      = definition.NO_OP_SET;
    f.op_code     = definition.NO_OPCODE;
    f.disp        = intern.STR_NIL;
    f.ret_sem     = semtype.TYPE_NIL;
    f.asm_blocks  = map.init[id.InstructionId, IrAsm](alloc, map.hash_u32, map.eq_u32);
    f.dbg_vars    = map.init[id.InstructionId, DbgVar](alloc, map.hash_u32, map.eq_u32);
    f.dbg_exprs    = nil;
    f.dbg_expr_len = 0;
    f.dbg_expr_cap = 0;
    f.dbg_expr_ids = map.init[id.InstructionId, DbgExprId](alloc, map.hash_u32, map.eq_u32);
    f.alloca_dbg_vars = map.init[id.InstructionId, DbgVar](alloc, map.hash_u32, map.eq_u32);
    f.inline_sites      = nil;
    f.inline_site_len   = 0;
    f.inline_site_cap   = 0;
    f.instr_inline_site = map.init[id.InstructionId, u32](alloc, map.hash_u32, map.eq_u32);
    ret f;
}

fun grow_cap[T](alloc: *A.Allocator, data: **T, cap: *u32, initial: u32) R.Result[R.Void, str] {
    if (@data == nil) {
        val res_alloc: R.Result[*T, str] = A.allocate[T](alloc, initial::usize);
        if (R.is_err[*T, str](res_alloc)) { ret R.err[R.Void, str](R.unwrap_err[*T, str](res_alloc)); }
        @data = R.unwrap_ok[*T, str](res_alloc);
        @cap  = initial;
        ret R.ok_void[str]();
    }
    val current: layout.CheckedCount[T] = layout.count[T]((@cap)::usize);
    val required_r: R.Result[layout.CheckedCount[T], layout.CheckCause] =
        layout.count_add[T](current, layout.count[T](1::usize));
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](required_r)) {
        ret R.err[R.Void, str]("ir: growth count overflow");
    }
    val required: layout.CheckedCount[T] = R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](required_r);
    val grown_r: R.Result[layout.CheckedCount[T], layout.CheckCause] = layout.count_grow[T](current, required);
    if (R.is_err[layout.CheckedCount[T], layout.CheckCause](grown_r)) {
        ret R.err[R.Void, str]("ir: growth count overflow");
    }
    val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
        R.unwrap_ok[layout.CheckedCount[T], layout.CheckCause](grown_r).value);
    if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
        ret R.err[R.Void, str]("ir: growth capacity exceeds the u32 limit");
    }
    val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);
    val res_realloc: R.Result[*T, str] = A.reallocate[T](alloc, @data, (@cap)::usize, new_cap::usize);
    if (R.is_err[*T, str](res_realloc)) { ret R.err[R.Void, str](R.unwrap_err[*T, str](res_realloc)); }
    @data = R.unwrap_ok[*T, str](res_realloc);
    @cap  = new_cap;
    ret R.ok_void[str]();
}

pub fun function_add(m: *Module, name: intern.StrId, sig: type.IrTypeId, flags: u32) R.Result[u32, str] {
    if (m.function_len == m.function_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[Function](m.alloc, ?m.functions, ?m.function_cap, INITIAL_FN_CAP);
        if (R.is_err[R.Void, str](grown)) { ret R.err[u32, str](R.unwrap_err[R.Void, str](grown)); }
    }
    val idx: u32 = m.function_len;
    m.functions[idx] = function_new(m.alloc, name, sig, flags);
    m.function_len   = m.function_len + 1;
    ret R.ok[u32, str](idx);
}

pub fun function_register(m: *Module, name: intern.StrId, idx: u32) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[intern.StrId, u32](?m.fn_by_name, name, idx));
}


pub fun function_lookup(m: *Module, name: intern.StrId) O.Option[u32] {
    var key: intern.StrId = name;
    val res_idx: R.Result[*u32, str] = map.get[intern.StrId, u32](?m.fn_by_name, ?key);
    if (R.is_ok[*u32, str](res_idx)) { ret O.some[u32](@R.unwrap_ok[*u32, str](res_idx)); }
    ret O.none[u32]();
}

pub fun global_register(m: *Module, name: intern.StrId, idx: u32) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[intern.StrId, u32](?m.global_by_name, name, idx));
}

pub fun global_lookup(m: *Module, name: intern.StrId) O.Option[u32] {
    var key: intern.StrId = name;
    val res_idx: R.Result[*u32, str] = map.get[intern.StrId, u32](?m.global_by_name, ?key);
    if (R.is_ok[*u32, str](res_idx)) { ret O.some[u32](@R.unwrap_ok[*u32, str](res_idx)); }
    ret O.none[u32]();
}

pub fun instruction_get(fn: *Function, i: id.InstructionId) O.Option[*instruction.Instruction] {
    if (i == id.INSTR_NIL)      { ret O.none[*instruction.Instruction](); }
    if (i::u32 >= fn.instr_len) { ret O.none[*instruction.Instruction](); }
    ret O.some[*instruction.Instruction](?fn.instrs[i::u32]);
}

rec InstructionIdDomain {
}

pub fun instruction_add(m: *Module, fn: *Function, inst: instruction.Instruction) R.Result[id.InstructionId, str] {
    if (fn.instr_len >= fn.instr_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[instruction.Instruction](m.alloc, ?fn.instrs, ?fn.instr_cap, INITIAL_INSTR_CAP);
        if (R.is_err[R.Void, str](grown)) { ret R.err[id.InstructionId, str](R.unwrap_err[R.Void, str](grown)); }
    }
    val checked_id: R.Result[layout.CheckedId[InstructionIdDomain], layout.CheckCause] =
        layout.id_below[InstructionIdDomain](fn.instr_len::usize, layout.count[InstructionIdDomain](0xFFFFFFFF::usize));
    if (R.is_err[layout.CheckedId[InstructionIdDomain], layout.CheckCause](checked_id)) {
        ret R.err[id.InstructionId, str]("ir: instruction id exhausts its 32-bit domain");
    }
    val iid: id.InstructionId = R.unwrap_ok[layout.CheckedId[InstructionIdDomain], layout.CheckCause](checked_id).value::u32;
    fn.instrs[fn.instr_len] = inst;
    fn.instr_len = fn.instr_len + 1;
    ret R.ok[id.InstructionId, str](iid);
}

pub rec OperandArray {
    ops: *value.Value;
    len: u32;
}

pub fun operands_alloc(m: *Module, n: u32) R.Result[OperandArray, str] {
    var arr: OperandArray;
    arr.ops = nil;
    arr.len = n;
    if (n == 0) { ret R.ok[OperandArray, str](arr); }

    val res: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, n::usize);
    if (R.is_err[*value.Value, str](res)) { ret R.err[OperandArray, str](R.unwrap_err[*value.Value, str](res)); }
    arr.ops = R.unwrap_ok[*value.Value, str](res);
    ret R.ok[OperandArray, str](arr);
}

pub fun instr_replace_operands(m: *Module, ins: *instruction.Instruction, arr: OperandArray) {
    if (ins.operands != nil && ins.operand_cap > 0 && ins.operands != arr.ops) {
        A.deallocate[value.Value](m.alloc, ins.operands, ins.operand_cap::usize);
    }
    ins.operands      = arr.ops;
    ins.operand_count = arr.len;
    ins.operand_cap   = arr.len;
}

pub fun phi_append_incoming(m: *Module, phi: *instruction.Instruction, pred: id.BlockId, incoming: value.Value) R.Result[R.Void, str] {
    val res_target: R.Result[value.Value, str] = block_target_make(m, pred);
    if (R.is_err[value.Value, str](res_target)) {
        ret R.err[R.Void, str](R.unwrap_err[value.Value, str](res_target));
    }

    val needed_r: R.Result[layout.CheckedCount[value.Value], layout.CheckCause] =
        layout.count_add[value.Value](layout.count[value.Value](phi.operand_count::usize),
                                       layout.count[value.Value](2::usize));
    if (R.is_err[layout.CheckedCount[value.Value], layout.CheckCause](needed_r)) {
        ret R.err[R.Void, str]("ir: phi operand count overflow");
    }
    val needed_c: layout.CheckedCount[value.Value] = R.unwrap_ok[layout.CheckedCount[value.Value], layout.CheckCause](needed_r);
    if (needed_c.value > phi.operand_cap::usize) {
        var base_cap: usize = INITIAL_PHI_OPERAND_CAP::usize;
        if (phi.operand_cap::usize > base_cap) { base_cap = phi.operand_cap::usize; }
        val grown_r: R.Result[layout.CheckedCount[value.Value], layout.CheckCause] =
            layout.count_grow[value.Value](layout.count[value.Value](base_cap), needed_c);
        if (R.is_err[layout.CheckedCount[value.Value], layout.CheckCause](grown_r)) {
            ret R.err[R.Void, str]("ir: phi operand growth capacity overflow");
        }
        val new_cap_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(
            R.unwrap_ok[layout.CheckedCount[value.Value], layout.CheckCause](grown_r).value);
        if (R.is_err[u32, layout.CheckCause](new_cap_fits)) {
            ret R.err[R.Void, str]("ir: phi operand capacity exceeds the u32 limit");
        }
        val new_cap: u32 = R.unwrap_ok[u32, layout.CheckCause](new_cap_fits);
        val res_grow: R.Result[*value.Value, str] =
            A.reallocate[value.Value](m.alloc, phi.operands, phi.operand_cap::usize, new_cap::usize);
        if (R.is_err[*value.Value, str](res_grow)) {
            ret R.err[R.Void, str](R.unwrap_err[*value.Value, str](res_grow));
        }
        phi.operands    = R.unwrap_ok[*value.Value, str](res_grow);
        phi.operand_cap = new_cap;
    }
    val needed_fits: R.Result[u32, layout.CheckCause] = layout.usize_to_u32(needed_c.value);
    if (R.is_err[u32, layout.CheckCause](needed_fits)) {
        ret R.err[R.Void, str]("ir: phi operand count exceeds the u32 limit");
    }
    val needed: u32 = R.unwrap_ok[u32, layout.CheckCause](needed_fits);
    phi.operands[phi.operand_count]     = R.unwrap_ok[value.Value, str](res_target);
    phi.operands[phi.operand_count + 1] = incoming;
    phi.operand_count = needed;
    ret R.ok_void[str]();
}

pub fun asm_get(fn: *Function, iid: id.InstructionId) O.Option[*IrAsm] {
    var key: id.InstructionId = iid;
    val res: R.Result[*IrAsm, str] = map.get[id.InstructionId, IrAsm](?fn.asm_blocks, ?key);
    if (R.is_err[*IrAsm, str](res)) { ret O.none[*IrAsm](); }
    ret O.some[*IrAsm](R.unwrap_ok[*IrAsm, str](res));
}

pub fun dbg_var_get(fn: *Function, iid: id.InstructionId) O.Option[*DbgVar] {
    var key: id.InstructionId = iid;
    val res: R.Result[*DbgVar, str] = map.get[id.InstructionId, DbgVar](?fn.dbg_vars, ?key);
    if (R.is_err[*DbgVar, str](res)) { ret O.none[*DbgVar](); }
    ret O.some[*DbgVar](R.unwrap_ok[*DbgVar, str](res));
}

pub fun record_alloca_dbg_var(fn: *Function, alloca_id: id.InstructionId, dv: DbgVar) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[id.InstructionId, DbgVar](?fn.alloca_dbg_vars, alloca_id, dv));
}

pub fun alloca_dbg_var_get(fn: *Function, alloca_id: id.InstructionId) O.Option[*DbgVar] {
    var key: id.InstructionId = alloca_id;
    val res: R.Result[*DbgVar, str] = map.get[id.InstructionId, DbgVar](?fn.alloca_dbg_vars, ?key);
    if (R.is_err[*DbgVar, str](res)) { ret O.none[*DbgVar](); }
    ret O.some[*DbgVar](R.unwrap_ok[*DbgVar, str](res));
}

pub fun clone_alloca_dbg_var(src_fn: *Function, dst_fn: *Function, src_iid: id.InstructionId, dst_iid: id.InstructionId) R.Result[R.Void, str] {
    val odv: O.Option[*DbgVar] = alloca_dbg_var_get(src_fn, src_iid);
    if (O.is_none[*DbgVar](odv)) { ret R.ok_void[str](); }
    val dv: DbgVar = @O.unwrap[*DbgVar](odv);
    ret record_alloca_dbg_var(dst_fn, dst_iid, dv);
}

pub fun dbg_value_const(fn: *Function, iid: id.InstructionId) O.Option[i64] {
    val gi: O.Option[*instruction.Instruction] = instruction_get(fn, iid);
    if (O.is_none[*instruction.Instruction](gi)) { ret O.none[i64](); }
    val inst: *instruction.Instruction = O.unwrap[*instruction.Instruction](gi);
    if (inst.operand_count == 0) { ret O.none[i64](); }
    val op: *value.Value = ?inst.operands[0];
    if (op.kind != value.VAL_CONST_INT) { ret O.none[i64](); }
    ret O.some[i64](op.data.int_lit::i64);
}

pub fun dbg_expr_id(fn: *Function, iid: id.InstructionId) DbgExprId {
    var key: id.InstructionId = iid;
    val res: R.Result[*DbgExprId, str] = map.get[id.InstructionId, DbgExprId](?fn.dbg_expr_ids, ?key);
    if (R.is_err[*DbgExprId, str](res)) { ret DBG_EXPR_IDENTITY; }
    val p: *DbgExprId = R.unwrap_ok[*DbgExprId, str](res);
    ret @p;
}

pub fun dbg_expr_get(fn: *Function, eid: DbgExprId) O.Option[*DbgExpr] {
    if (eid == DBG_EXPR_IDENTITY) { ret O.none[*DbgExpr](); }
    val idx: u32 = eid::u32 - 1;
    if (idx >= fn.dbg_expr_len)   { ret O.none[*DbgExpr](); }
    ret O.some[*DbgExpr](?fn.dbg_exprs[idx]);
}

pub fun dbg_expr_new(m: *Module, fn: *Function, iid: id.InstructionId) R.Result[DbgExprId, str] {
    if (fn.dbg_expr_len >= fn.dbg_expr_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[DbgExpr](m.alloc, ?fn.dbg_exprs, ?fn.dbg_expr_cap, INITIAL_DBG_EXPR_CAP);
        if (R.is_err[R.Void, str](grown)) { ret R.err[DbgExprId, str](R.unwrap_err[R.Void, str](grown)); }
    }
    val idx: u32 = fn.dbg_expr_len;
    fn.dbg_exprs[idx].ops      = nil;
    fn.dbg_exprs[idx].op_count = 0;
    fn.dbg_exprs[idx].op_cap   = 0;

    val eid: DbgExprId = (idx + 1)::DbgExprId;
    val res_ins: R.Result[bool, str] = map.insert[id.InstructionId, DbgExprId](?fn.dbg_expr_ids, iid, eid);
    if (R.is_err[bool, str](res_ins)) {
        ret R.err[DbgExprId, str](R.unwrap_err[bool, str](res_ins));
    }
    fn.dbg_expr_len = fn.dbg_expr_len + 1;
    ret R.ok[DbgExprId, str](eid);
}

pub fun dbg_expr_prepend_op(m: *Module, fn: *Function, eid: DbgExprId, op: DbgOp) R.Result[R.Void, str] {
    val opt: O.Option[*DbgExpr] = dbg_expr_get(fn, eid);
    if (O.is_none[*DbgExpr](opt)) { ret R.err[R.Void, str]("dbg_expr_prepend_op: invalid expression id"); }
    val dex: *DbgExpr = O.unwrap[*DbgExpr](opt);

    if (dex.op_count >= dex.op_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[DbgOp](m.alloc, ?dex.ops, ?dex.op_cap, INITIAL_DBG_OP_CAP);
        if (R.is_err[R.Void, str](grown)) { ret grown; }
    }

    var i: u32 = dex.op_count;
    for (i > 0) {
        dex.ops[i] = dex.ops[i - 1];
        i = i - 1;
    }
    dex.ops[0]   = op;
    dex.op_count = dex.op_count + 1;
    ret R.ok_void[str]();
}

pub fun inline_site_add(m: *Module, fn: *Function, callee: intern.StrId, call_loc: source.SrcLoc, parent: u32) R.Result[u32, str] {
    if (fn.inline_site_len >= fn.inline_site_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[InlineSite](m.alloc, ?fn.inline_sites, ?fn.inline_site_cap, INITIAL_INLINE_SITE_CAP);
        if (R.is_err[R.Void, str](grown)) { ret R.err[u32, str](R.unwrap_err[R.Void, str](grown)); }
    }
    val idx: u32 = fn.inline_site_len;
    fn.inline_sites[idx].callee   = callee;
    fn.inline_sites[idx].call_loc = call_loc;
    fn.inline_sites[idx].parent   = parent;
    fn.inline_site_len = fn.inline_site_len + 1;
    ret R.ok[u32, str](idx + 1);
}

pub fun inline_site_get(fn: *Function, site: u32) O.Option[*InlineSite] {
    if (site == 0 || site > fn.inline_site_len) { ret O.none[*InlineSite](); }
    ret O.some[*InlineSite](?fn.inline_sites[site - 1]);
}

pub fun instr_inline_site_set(fn: *Function, iid: id.InstructionId, site: u32) R.Result[R.Void, str] {
    ret R.void_of[bool, str](map.insert[id.InstructionId, u32](?fn.instr_inline_site, iid, site));
}

pub fun instr_inline_site_of(fn: *Function, iid: id.InstructionId) u32 {
    var key: id.InstructionId = iid;
    val res: R.Result[*u32, str] = map.get[id.InstructionId, u32](?fn.instr_inline_site, ?key);
    if (R.is_err[*u32, str](res)) { ret 0; }
    ret @R.unwrap_ok[*u32, str](res);
}

pub fun clone_instr_inline_site(src_fn: *Function, dst_fn: *Function, src_iid: id.InstructionId, dst_iid: id.InstructionId) R.Result[R.Void, str] {
    val site: u32 = instr_inline_site_of(src_fn, src_iid);
    if (site == 0) { ret R.ok_void[str](); }
    ret instr_inline_site_set(dst_fn, dst_iid, site);
}

pub fun clone_dbg_metadata(m: *Module, src_fn: *Function, dst_fn: *Function, src_iid: id.InstructionId, dst_iid: id.InstructionId) R.Result[R.Void, str] {
    val odv: O.Option[*DbgVar] = dbg_var_get(src_fn, src_iid);
    if (O.is_none[*DbgVar](odv)) { ret R.ok_void[str](); }
    var dv: DbgVar = @O.unwrap[*DbgVar](odv);

    val seid: DbgExprId = dbg_expr_id(src_fn, src_iid);
    val ose: O.Option[*DbgExpr] = dbg_expr_get(src_fn, seid);
    var n: u32 = 0;
    if (O.is_some[*DbgExpr](ose)) { n = O.unwrap[*DbgExpr](ose).op_count; }
    if (n == 0) {
        ret R.void_of[bool, str](map.insert[id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv));
    }

    val rsnap: R.Result[*DbgOp, str] = A.allocate[DbgOp](m.alloc, n::usize);
    if (R.is_err[*DbgOp, str](rsnap)) { ret R.err[R.Void, str](R.unwrap_err[*DbgOp, str](rsnap)); }
    val snap: *DbgOp = R.unwrap_ok[*DbgOp, str](rsnap);
    val se0: *DbgExpr = O.unwrap[*DbgExpr](ose);
    memory.copy[DbgOp](snap, se0.ops, n::usize);

    val ri: R.Result[bool, str] = map.insert[id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv);
    if (R.is_err[bool, str](ri)) { A.deallocate[DbgOp](m.alloc, snap, n::usize); ret R.void_of[bool, str](ri); }

    val rne: R.Result[DbgExprId, str] = dbg_expr_new(m, dst_fn, dst_iid);
    if (R.is_err[DbgExprId, str](rne)) { A.deallocate[DbgOp](m.alloc, snap, n::usize); ret R.err[R.Void, str](R.unwrap_err[DbgExprId, str](rne)); }
    val deid: DbgExprId = R.unwrap_ok[DbgExprId, str](rne);
    var j: u32 = n;
    for (j > 0) {
        val rp: R.Result[R.Void, str] = dbg_expr_prepend_op(m, dst_fn, deid, snap[j - 1]);
        if (R.is_err[R.Void, str](rp)) { A.deallocate[DbgOp](m.alloc, snap, n::usize); ret rp; }
        j = j - 1;
    }
    A.deallocate[DbgOp](m.alloc, snap, n::usize);
    ret R.ok_void[str]();
}

pub fun clone_asm_payload(m: *Module, src_fn: *Function, dst_fn: *Function,
                          src_iid: id.InstructionId, dst_iid: id.InstructionId,
                          instr_map: *u32, map_len: u32) R.Result[R.Void, str] {
    var key: id.InstructionId = src_iid;
    val res: R.Result[*IrAsm, str] = map.get[id.InstructionId, IrAsm](?src_fn.asm_blocks, ?key);
    if (R.is_err[*IrAsm, str](res)) { ret R.ok_void[str](); }
    val src: *IrAsm = R.unwrap_ok[*IrAsm, str](res);

    var dst: IrAsm;
    dst.isa        = src.isa;
    dst.body       = src.body;
    dst.binds      = nil;
    dst.bind_count = 0;
    dst.bind_cap   = 0;

    if (src.bind_count > 0) {
        val rb: R.Result[*IrAsmBind, str] = A.allocate[IrAsmBind](m.alloc, src.bind_count::usize);
        if (R.is_err[*IrAsmBind, str](rb)) { ret R.err[R.Void, str](R.unwrap_err[*IrAsmBind, str](rb)); }
        dst.binds      = R.unwrap_ok[*IrAsmBind, str](rb);
        dst.bind_cap   = src.bind_count;
        dst.bind_count = src.bind_count;

        var i: u32 = 0;
        for (i < src.bind_count) {
            dst.binds[i] = src.binds[i];
            if (instr_map != nil) {
                val old: u32 = src.binds[i].instr::u32;
                if (old >= map_len) {
                    A.deallocate[IrAsmBind](m.alloc, dst.binds, dst.bind_cap::usize);
                    ret R.err[R.Void, str]("internal compiler error: inline-asm '{name}' binding names an instruction outside the cloned callee");
                }
                dst.binds[i].instr = instr_map[old]::id.InstructionId;
            }
            i = i + 1;
        }
    }

    var existing_key: id.InstructionId = dst_iid;
    val res_existing: R.Result[*IrAsm, str] = map.get[id.InstructionId, IrAsm](?dst_fn.asm_blocks, ?existing_key);
    if (R.is_ok[*IrAsm, str](res_existing)) {
        val old: *IrAsm = R.unwrap_ok[*IrAsm, str](res_existing);
        if (old.binds != nil && old.bind_cap > 0) {
            A.deallocate[IrAsmBind](m.alloc, old.binds, old.bind_cap::usize);
        }
    }

    val ri: R.Result[bool, str] = map.insert[id.InstructionId, IrAsm](?dst_fn.asm_blocks, dst_iid, dst);
    if (R.is_err[bool, str](ri)) {
        if (dst.binds != nil) { A.deallocate[IrAsmBind](m.alloc, dst.binds, dst.bind_cap::usize); }
        ret R.void_of[bool, str](ri);
    }
    ret R.ok_void[str]();
}

rec BlockIdDomain {
}

pub fun block_add(m: *Module, fn: *Function) R.Result[id.BlockId, str] {
    if (fn.block_count >= fn.block_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[Block](m.alloc, ?fn.blocks, ?fn.block_cap, INITIAL_BLOCK_LIST_CAP);
        if (R.is_err[R.Void, str](grown)) { ret R.err[id.BlockId, str](R.unwrap_err[R.Void, str](grown)); }
    }
    val checked_id: R.Result[layout.CheckedId[BlockIdDomain], layout.CheckCause] =
        layout.id_below[BlockIdDomain](fn.block_count::usize, layout.count[BlockIdDomain](0xFFFFFFFF::usize));
    if (R.is_err[layout.CheckedId[BlockIdDomain], layout.CheckCause](checked_id)) {
        ret R.err[id.BlockId, str]("ir: block id exhausts its 32-bit domain");
    }
    val bid: id.BlockId = R.unwrap_ok[layout.CheckedId[BlockIdDomain], layout.CheckCause](checked_id).value::u32;
    var blk: *Block = ?fn.blocks[fn.block_count];
    blk.id           = bid;
    blk.instructions = nil;
    blk.instr_count  = 0;
    blk.instr_cap    = 0;
    blk.phis         = nil;
    blk.phi_count    = 0;
    blk.phi_cap      = 0;
    blk.terminator   = id.INSTR_NIL;
    blk.preds        = nil;
    blk.pred_count   = 0;
    blk.pred_cap     = 0;
    fn.block_count = fn.block_count + 1;
    ret R.ok[id.BlockId, str](bid);
}

pub fun block_append_instr(m: *Module, blk: *Block, i: id.InstructionId) R.Result[R.Void, str] {
    if (blk.instr_count >= blk.instr_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[id.InstructionId](m.alloc, ?blk.instructions, ?blk.instr_cap, INITIAL_BLOCK_LIST_CAP);
        if (R.is_err[R.Void, str](grown)) { ret grown; }
    }
    blk.instructions[blk.instr_count] = i;
    blk.instr_count = blk.instr_count + 1;
    ret R.ok_void[str]();
}

pub fun block_prepend_instr(m: *Module, blk: *Block, i: id.InstructionId) R.Result[R.Void, str] {
    if (blk.instr_count >= blk.instr_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[id.InstructionId](m.alloc, ?blk.instructions, ?blk.instr_cap, INITIAL_BLOCK_LIST_CAP);
        if (R.is_err[R.Void, str](grown)) { ret grown; }
    }
    var j: u32 = blk.instr_count;
    for (j > 0) {
        blk.instructions[j] = blk.instructions[j - 1];
        j = j - 1;
    }
    blk.instructions[0] = i;
    blk.instr_count = blk.instr_count + 1;
    ret R.ok_void[str]();
}

pub fun block_append_phi(m: *Module, blk: *Block, i: id.InstructionId) R.Result[R.Void, str] {
    if (blk.phi_count >= blk.phi_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[id.InstructionId](m.alloc, ?blk.phis, ?blk.phi_cap, INITIAL_BLOCK_LIST_CAP);
        if (R.is_err[R.Void, str](grown)) { ret grown; }
    }
    blk.phis[blk.phi_count] = i;
    blk.phi_count = blk.phi_count + 1;
    ret R.ok_void[str]();
}

pub fun block_append_pred(m: *Module, blk: *Block, pred: id.BlockId) R.Result[R.Void, str] {
    if (blk.pred_count >= blk.pred_cap) {
        val grown: R.Result[R.Void, str] = grow_cap[id.BlockId](m.alloc, ?blk.preds, ?blk.pred_cap, INITIAL_BLOCK_LIST_CAP);
        if (R.is_err[R.Void, str](grown)) { ret grown; }
    }
    blk.preds[blk.pred_count] = pred;
    blk.pred_count = blk.pred_count + 1;
    ret R.ok_void[str]();
}

pub fun block_target_make(m: *Module, block: id.BlockId) R.Result[value.Value, str] {
    val res_ptr_type: R.Result[type.IrTypeId, str] = type.intern_ptr(?m.types);
    if (R.is_err[type.IrTypeId, str](res_ptr_type)) {
        ret R.err[value.Value, str](R.unwrap_err[type.IrTypeId, str](res_ptr_type));
    }
    val ptr_type: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_ptr_type);
    ret R.ok[value.Value, str](value.const_int(block::u64, ptr_type));
}

pub fun block_target(v: value.Value) id.BlockId {
    ret v.data.int_lit::id.BlockId;
}

pub fun block_successors(fn: *Function, blk: *Block, out0: *id.BlockId, out1: *id.BlockId) u32 {
    @out0 = id.BLOCK_NIL;
    @out1 = id.BLOCK_NIL;
    if (blk.terminator == id.INSTR_NIL) { ret 0; }
    val opt_term: O.Option[*instruction.Instruction] = instruction_get(fn, blk.terminator);
    if (O.is_none[*instruction.Instruction](opt_term)) { ret 0; }
    val term: *instruction.Instruction = O.unwrap[*instruction.Instruction](opt_term);
    var n: u32 = 0;
    var o: u32 = 0;
    for (o < term.operand_count) {
        if (opdesc.operand_role(term.kind, o) == opdesc.ROLE_CFG_EDGE) {
            if (n == 0) { @out0 = block_target(term.operands[o]); }
            or (n == 1) { @out1 = block_target(term.operands[o]); }
            n = n + 1;
        }
        o = o + 1;
    }
    ret n;
}

pub fun preds_rebuild(m: *Module, fn: *Function) R.Result[R.Void, str] {
    if (fn.block_count == 0) { ret R.ok_void[str](); }

    val res_counts: R.Result[*u32, str] = A.allocate[u32](m.alloc, fn.block_count::usize);
    if (R.is_err[*u32, str](res_counts)) { ret R.err[R.Void, str](R.unwrap_err[*u32, str](res_counts)); }
    val counts: *u32 = R.unwrap_ok[*u32, str](res_counts);
    var i: u32 = 0;
    for (i < fn.block_count) { counts[i] = 0; i = i + 1; }

    i = 0;
    for (i < fn.block_count) {
        val blk: *Block = ?fn.blocks[i];
        var succ0: id.BlockId = id.BLOCK_NIL;
        var succ1: id.BlockId = id.BLOCK_NIL;
        val succ_count: u32 = block_successors(fn, blk, ?succ0, ?succ1);
        if (succ_count >= 1 && succ0::u32 < fn.block_count) { counts[succ0::u32] = counts[succ0::u32] + 1; }
        if (succ_count >= 2 && succ1::u32 < fn.block_count) { counts[succ1::u32] = counts[succ1::u32] + 1; }
        i = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val blk: *Block = ?fn.blocks[i];
        if (counts[i] > blk.pred_cap) {
            val res_grow: R.Result[*id.BlockId, str] =
                A.reallocate[id.BlockId](m.alloc, blk.preds, blk.pred_cap::usize, counts[i]::usize);
            if (R.is_err[*id.BlockId, str](res_grow)) {
                A.deallocate[u32](m.alloc, counts, fn.block_count::usize);
                ret R.err[R.Void, str](R.unwrap_err[*id.BlockId, str](res_grow));
            }
            blk.preds    = R.unwrap_ok[*id.BlockId, str](res_grow);
            blk.pred_cap = counts[i];
        }
        i = i + 1;
    }

    A.deallocate[u32](m.alloc, counts, fn.block_count::usize);

    i = 0;
    for (i < fn.block_count) {
        fn.blocks[i].pred_count = 0;
        i = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val blk: *Block = ?fn.blocks[i];
        var succ0: id.BlockId = id.BLOCK_NIL;
        var succ1: id.BlockId = id.BLOCK_NIL;
        val succ_count: u32 = block_successors(fn, blk, ?succ0, ?succ1);
        if (succ_count >= 1 && succ0::u32 < fn.block_count) {
            val t: *Block = ?fn.blocks[succ0::u32];
            t.preds[t.pred_count] = i::id.BlockId;
            t.pred_count = t.pred_count + 1;
        }
        if (succ_count >= 2 && succ1::u32 < fn.block_count) {
            val t: *Block = ?fn.blocks[succ1::u32];
            t.preds[t.pred_count] = i::id.BlockId;
            t.pred_count = t.pred_count + 1;
        }
        i = i + 1;
    }
    ret R.ok_void[str]();
}

rec TrackEntry {
    p:    ptr;
    size: usize;
    live: bool;
}

rec Tracker {
    entries:  *TrackEntry;
    cap:      u32;
    count:    u32;
    live:     u32;
    mismatch: bool;
    overflow: bool;
}

fun track_record(t: *Tracker, p: ptr, size: usize) {
    if (t.count >= t.cap) { t.overflow = true; ret; }
    t.entries[t.count].p    = p;
    t.entries[t.count].size = size;
    t.entries[t.count].live = true;
    t.count = t.count + 1;
    t.live  = t.live + 1;
}

fun track_find(t: *Tracker, p: ptr) i64 {
    var i: u32 = 0;
    for (i < t.count) {
        if (t.entries[i].live && t.entries[i].p == p) { ret i::i64; }
        i = i + 1;
    }
    ret 0 - 1;
}

fun track_is_freed(t: *Tracker, p: ptr) bool {
    var i: u32 = 0;
    for (i < t.count) {
        if (t.entries[i].p == p && t.entries[i].live == false) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun track_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    if (size == 0) { ret O.some[ptr](nil); }
    val t: *Tracker = ctx::*Tracker;
    val p: ptr = os.allocate(size);
    if (p == nil) { ret O.none[ptr](); }
    track_record(t, p, size);
    ret O.some[ptr](p);
}

fun track_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p == nil || size == 0) { ret 0; }
    val t: *Tracker = ctx::*Tracker;
    val idx: i64 = track_find(t, p);
    if (idx < 0)                          { t.mismatch = true; ret 0; }
    if (t.entries[idx::u32].size != size) { t.mismatch = true; }
    t.entries[idx::u32].live = false;
    t.live = t.live - 1;
    ret os.deallocate(p, size);
}

fun track_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    if (p == nil) { ret track_allocate(ctx, new_size, align); }
    if (new_size == 0) {
        track_deallocate(ctx, p, old_size, align);
        ret O.some[ptr](nil);
    }
    val t: *Tracker = ctx::*Tracker;
    val idx: i64 = track_find(t, p);
    if (idx < 0)                                   { t.mismatch = true; }
    or { if (t.entries[idx::u32].size != old_size) { t.mismatch = true; } }
    val np: ptr = os.reallocate(p, old_size, new_size);
    if (np == nil) { ret O.none[ptr](); }
    if (idx < 0)   { track_record(t, np, new_size); }
    or {
        t.entries[idx::u32].p    = np;
        t.entries[idx::u32].size = new_size;
    }
    ret O.some[ptr](np);
}

test "mach.lang.me.ir.dnit:frees_by_capacity_not_count" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: Tracker;
    val res_entries: R.Result[*TrackEntry, str] = A.allocate[TrackEntry](?page_alloc, 8192::usize);
    if (R.is_err[*TrackEntry, str](res_entries)) { ret 1; }
    tracker.entries  = R.unwrap_ok[*TrackEntry, str](res_entries);
    tracker.cap      = 8192;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;
    tracker.overflow = false;

    var tp: *Tracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = track_allocate;
    alloc.fn_reallocate = track_reallocate;
    alloc.fn_deallocate = track_deallocate;

    val res_module: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](res_module)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](res_module);

    val res_i64t: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64t)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64t);

    val res_fn: R.Result[u32, str] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fn: *Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    val res_ops3: R.Result[*value.Value, str] = A.allocate[value.Value](?alloc, 3::usize);
    if (R.is_err[*value.Value, str](res_ops3)) { ret 1; }
    val ops3: *value.Value = R.unwrap_ok[*value.Value, str](res_ops3);
    ops3[0] = value.const_int(0, i64t);
    ops3[1] = value.const_int(0, i64t);
    ops3[2] = value.const_int(0, i64t);
    var cbr: instruction.Instruction;
    cbr.kind          = instruction.OP_CBR;
    cbr.ty            = i64t;
    cbr.operands      = ops3;
    cbr.operand_count = 3;
    cbr.operand_cap   = 3;
    cbr.flags         = 0;
    cbr.aux_ty        = type.IRT_NIL;
    val res_cbr: R.Result[id.InstructionId, str] = instruction_add(?m, fn, cbr);
    if (R.is_err[id.InstructionId, str](res_cbr)) { ret 1; }
    fn.instrs[R.unwrap_ok[id.InstructionId, str](res_cbr)::u32].operand_count = 1;

    val res_ops4: R.Result[*value.Value, str] = A.allocate[value.Value](?alloc, 4::usize);
    if (R.is_err[*value.Value, str](res_ops4)) { ret 1; }
    val ops4: *value.Value = R.unwrap_ok[*value.Value, str](res_ops4);
    var i: u32 = 0;
    for (i < 4) { ops4[i] = value.const_int(0, i64t); i = i + 1; }
    var phi: instruction.Instruction;
    phi.kind          = instruction.OP_PHI;
    phi.ty            = i64t;
    phi.operands      = ops4;
    phi.operand_count = 4;
    phi.operand_cap   = 4;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;
    val res_phi: R.Result[id.InstructionId, str] = instruction_add(?m, fn, phi);
    if (R.is_err[id.InstructionId, str](res_phi)) { ret 1; }
    fn.instrs[R.unwrap_ok[id.InstructionId, str](res_phi)::u32].operand_count = 2;

    val res_blob: R.Result[*u8, str] = A.allocate[u8](?alloc, 16::usize);
    if (R.is_err[*u8, str](res_blob)) { ret 1; }
    val blob: *u8 = R.unwrap_ok[*u8, str](res_blob);
    val res_relocs: R.Result[*value.AggReloc, str] = A.allocate[value.AggReloc](?alloc, 4::usize);
    if (R.is_err[*value.AggReloc, str](res_relocs)) { ret 1; }
    val relocs: *value.AggReloc = R.unwrap_ok[*value.AggReloc, str](res_relocs);
    val blob_p:  ptr = blob::ptr;
    val reloc_p: ptr = relocs::ptr;

    var gl: Global;
    gl.name      = intern.STR_NIL;
    gl.ty        = i64t;
    gl.init      = value.const_agg(blob, 16, relocs, 1, 4, i64t);
    gl.is_mut    = false;
    gl.is_pub    = false;
    gl.is_extern = false;
    gl.is_import = false;
    gl.is_local  = true;
    gl.is_embed  = false;
    gl.align     = 0;
    gl.section   = intern.STR_NIL;
    gl.iface     = IFACE_NONE;
    gl.iface_a   = 0;
    gl.iface_b   = 0;
    gl.iface_flags = 0;
    m.globals[0] = gl;
    m.global_len = 1;

    dnit(?m);

    if (tracker.overflow) { ret 1; }
    if (tracker.mismatch) { ret 1; }
    if (!track_is_freed(?tracker, blob_p))  { ret 1; }
    if (!track_is_freed(?tracker, reloc_p)) { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[TrackEntry](?page_alloc, tracker.entries, 8192::usize);
    ret 0;
}

test "mach.lang.me.ir.instr_replace_operands:frees_displaced_by_capacity" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: Tracker;
    val res_entries: R.Result[*TrackEntry, str] = A.allocate[TrackEntry](?page_alloc, 8192::usize);
    if (R.is_err[*TrackEntry, str](res_entries)) { ret 1; }
    tracker.entries  = R.unwrap_ok[*TrackEntry, str](res_entries);
    tracker.cap      = 8192;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;
    tracker.overflow = false;

    var tp: *Tracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = track_allocate;
    alloc.fn_reallocate = track_reallocate;
    alloc.fn_deallocate = track_deallocate;

    val res_module: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](res_module)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](res_module);

    val res_i64t: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64t)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64t);

    val res_fn: R.Result[u32, str] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fn: *Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    val res_ops3: R.Result[OperandArray, str] = operands_alloc(?m, 3);
    if (R.is_err[OperandArray, str](res_ops3)) { ret 1; }
    val ops3: OperandArray = R.unwrap_ok[OperandArray, str](res_ops3);
    ops3.ops[0] = value.const_int(0, i64t);
    ops3.ops[1] = value.const_int(0, i64t);
    ops3.ops[2] = value.const_int(0, i64t);
    val displaced: ptr = ops3.ops::ptr;

    var cbr: instruction.Instruction;
    cbr.kind          = instruction.OP_CBR;
    cbr.ty            = i64t;
    cbr.operands      = ops3.ops;
    cbr.operand_count = 3;
    cbr.operand_cap   = 3;
    cbr.flags         = 0;
    cbr.aux_ty        = type.IRT_NIL;
    val res_cbr: R.Result[id.InstructionId, str] = instruction_add(?m, fn, cbr);
    if (R.is_err[id.InstructionId, str](res_cbr)) { ret 1; }
    val ins: *instruction.Instruction = ?fn.instrs[R.unwrap_ok[id.InstructionId, str](res_cbr)::u32];

    val res_ops1: R.Result[OperandArray, str] = operands_alloc(?m, 1);
    if (R.is_err[OperandArray, str](res_ops1)) { ret 1; }
    val ops1: OperandArray = R.unwrap_ok[OperandArray, str](res_ops1);
    ops1.ops[0] = value.const_int(7, i64t);
    instr_replace_operands(?m, ins, ops1);

    if (!track_is_freed(?tracker, displaced)) { ret 1; }
    if (tracker.mismatch)         { ret 1; }
    if (ins.operand_count != 1)   { ret 1; }
    if (ins.operand_cap != 1)     { ret 1; }
    if (ins.operands != ops1.ops) { ret 1; }

    instr_replace_operands(?m, ins, ops1);
    if (track_is_freed(?tracker, ops1.ops::ptr)) { ret 1; }
    if (ins.operands != ops1.ops) { ret 1; }
    if (ins.operand_count != 1)   { ret 1; }
    if (ins.operand_cap != 1)     { ret 1; }

    dnit(?m);

    if (tracker.overflow)  { ret 1; }
    if (tracker.mismatch)  { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[TrackEntry](?page_alloc, tracker.entries, 8192::usize);
    ret 0;
}

test "mach.lang.me.ir.instruction_add:preserves_caller_capacity_over_count" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: Tracker;
    val res_entries: R.Result[*TrackEntry, str] = A.allocate[TrackEntry](?page_alloc, 8192::usize);
    if (R.is_err[*TrackEntry, str](res_entries)) { ret 1; }
    tracker.entries  = R.unwrap_ok[*TrackEntry, str](res_entries);
    tracker.cap      = 8192;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;
    tracker.overflow = false;

    var tp: *Tracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = track_allocate;
    alloc.fn_reallocate = track_reallocate;
    alloc.fn_deallocate = track_deallocate;

    val res_module: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](res_module)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](res_module);

    val res_i64t: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64t)) { ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64t);

    val res_fn: R.Result[u32, str] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ret 1; }
    val fn: *Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    val res_ops4: R.Result[*value.Value, str] = A.allocate[value.Value](?alloc, 4::usize);
    if (R.is_err[*value.Value, str](res_ops4)) { ret 1; }
    val ops4: *value.Value = R.unwrap_ok[*value.Value, str](res_ops4);
    var i: u32 = 0;
    for (i < 4) { ops4[i] = value.const_int(0, i64t); i = i + 1; }

    var un: instruction.Instruction;
    un.kind          = instruction.OP_ADD;
    un.ty            = i64t;
    un.operands      = ops4;
    un.operand_count = 2;
    un.operand_cap   = 4;
    un.flags         = 0;
    un.aux_ty        = type.IRT_NIL;
    val res_un: R.Result[id.InstructionId, str] = instruction_add(?m, fn, un);
    if (R.is_err[id.InstructionId, str](res_un)) { ret 1; }
    val ins: *instruction.Instruction = ?fn.instrs[R.unwrap_ok[id.InstructionId, str](res_un)::u32];
    if (ins.operand_count != 2) { ret 1; }
    if (ins.operand_cap != 4)   { ret 1; }

    dnit(?m);

    if (tracker.overflow)  { ret 1; }
    if (tracker.mismatch)  { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[TrackEntry](?page_alloc, tracker.entries, 8192::usize);
    ret 0;
}

test "mach.lang.me.ir.inline_site_channel:add_get_group" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](rm)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](rm);

    val rvoid: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](rvoid)) { dnit(?m); ret 1; }
    val voidty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rvoid);
    val rsig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, voidty, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rsig)) { dnit(?m); ret 1; }
    val sigty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig);
    if (R.is_err[u32, str](function_add(?m, 100::intern.StrId, sigty, 0))) { dnit(?m); ret 1; }
    if (R.is_err[u32, str](function_add(?m, 200::intern.StrId, sigty, 0))) { dnit(?m); ret 1; }
    val caller: *Function = ?m.functions[1];

    val ra: R.Result[u32, str] = inline_site_add(?m, caller, 300::intern.StrId, source.loc_nil(), 0);
    if (R.is_err[u32, str](ra) || R.unwrap_ok[u32, str](ra) != 1) { dnit(?m); ret 1; }
    val rb: R.Result[u32, str] = inline_site_add(?m, caller, 301::intern.StrId, source.loc_nil(), 1);
    if (R.is_err[u32, str](rb) || R.unwrap_ok[u32, str](rb) != 2) { dnit(?m); ret 1; }

    val g1: O.Option[*InlineSite] = inline_site_get(caller, 1);
    if (O.is_none[*InlineSite](g1)) { dnit(?m); ret 1; }
    if (O.unwrap[*InlineSite](g1).callee != 300::intern.StrId) { dnit(?m); ret 1; }
    if (O.unwrap[*InlineSite](g1).parent != 0)                { dnit(?m); ret 1; }
    val g2: O.Option[*InlineSite] = inline_site_get(caller, 2);
    if (O.is_none[*InlineSite](g2))                           { dnit(?m); ret 1; }
    if (O.unwrap[*InlineSite](g2).parent != 1)                { dnit(?m); ret 1; }
    if (O.is_some[*InlineSite](inline_site_get(caller, 0)))   { dnit(?m); ret 1; }
    if (O.is_some[*InlineSite](inline_site_get(caller, 3)))   { dnit(?m); ret 1; }

    if (R.is_err[R.Void, str](instr_inline_site_set(caller, 7::id.InstructionId, 2))) { dnit(?m); ret 1; }
    if (instr_inline_site_of(caller, 7::id.InstructionId) != 2) { dnit(?m); ret 1; }
    if (instr_inline_site_of(caller, 8::id.InstructionId) != 0) { dnit(?m); ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.home:owns_the_whole_module" {
    var h: ModuleHome;
    if (O.is_some[str](home_init(?h))) { ret 1; }

    val rm: R.Result[Module, str] = init(?h.alloc, 42::intern.StrId);
    if (R.is_err[Module, str](rm)) { home_dnit(?h); ret 1; }
    var m: Module = R.unwrap_ok[Module, str](rm);
    if (m.alloc != ?h.alloc) { home_dnit(?h); ret 1; }

    val rvoid: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](rvoid)) { home_dnit(?h); ret 1; }
    val rsig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, R.unwrap_ok[type.IrTypeId, str](rvoid), nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rsig)) { home_dnit(?h); ret 1; }
    val sigty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig);

    var i: u32 = 0;
    for (i < 32) {
        if (R.is_err[u32, str](function_add(?m, (i + 1)::intern.StrId, sigty, 0))) { home_dnit(?h); ret 1; }
        i = i + 1;
    }
    if (m.function_len != 32) { home_dnit(?h); ret 1; }

    home_dnit(?h);
    ret 0;
}

rec GrowCapProbe {
    reallocate_calls: u32;
}

fun growcap_probe_allocate(ctx: ptr, size: usize, align: usize) O.Option[ptr] {
    ret O.none[ptr]();
}

fun growcap_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) O.Option[ptr] {
    val g: *GrowCapProbe = ctx::*GrowCapProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret O.none[ptr]();
}

fun growcap_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.me.ir.grow_cap:refuses_a_u32_capacity_that_cannot_double_before_reallocating" {
    var probe: GrowCapProbe;
    probe.reallocate_calls = 0;
    var pp: *GrowCapProbe = ?probe;
    var a: A.Allocator;
    a.ctx           = pp::ptr;
    a.fn_allocate   = growcap_probe_allocate;
    a.fn_reallocate = growcap_probe_reallocate;
    a.fn_deallocate = growcap_probe_deallocate;

    var dummy: u8;
    var data: *u8 = ?dummy;
    var cap: u32 = 0xFFFFFFFF;
    val res: R.Result[R.Void, str] = grow_cap[u8](?a, ?data, ?cap, 16);

    var bad: i32 = 0;
    if (!R.is_err[R.Void, str](res))   { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (cap != 0xFFFFFFFF)           { bad = 3; }
    ret bad;
}

test "mach.lang.me.ir.grow_cap:doubles_and_narrows_within_the_u32_domain" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var data: *u8 = nil;
    var cap: u32 = 0;
    val res1: R.Result[R.Void, str] = grow_cap[u8](?page_alloc, ?data, ?cap, 4);
    if (R.is_err[R.Void, str](res1)) { ret 1; }
    if (cap != 4)                  { ret 1; }

    val res2: R.Result[R.Void, str] = grow_cap[u8](?page_alloc, ?data, ?cap, 4);
    if (R.is_err[R.Void, str](res2)) { A.deallocate[u8](?page_alloc, data, cap::usize); ret 1; }
    if (cap != 8)                  { A.deallocate[u8](?page_alloc, data, cap::usize); ret 1; }

    A.deallocate[u8](?page_alloc, data, cap::usize);
    ret 0;
}

test "mach.lang.me.ir.block_add:refuses_a_block_count_at_the_block_nil_sentinel" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](rm)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](rm);

    val rvoid: R.Result[type.IrTypeId, str] = type.intern_void(?m.types);
    if (R.is_err[type.IrTypeId, str](rvoid)) { dnit(?m); ret 1; }
    val rsig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, R.unwrap_ok[type.IrTypeId, str](rvoid), nil, 0, false);
    if (R.is_err[type.IrTypeId, str](rsig)) { dnit(?m); ret 1; }
    val sigty: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](rsig);

    val res_fn: R.Result[u32, str] = function_add(?m, intern.STR_NIL, sigty, 0);
    if (R.is_err[u32, str](res_fn)) { dnit(?m); ret 1; }
    val fn: *Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    fn.block_count = 0xFFFFFFFF;
    val res_over: R.Result[id.BlockId, str] = block_add(?m, fn);
    if (!R.is_err[id.BlockId, str](res_over)) { fn.block_count = 0; dnit(?m); ret 1; }
    if (fn.block_count != 0xFFFFFFFF)         { dnit(?m); ret 1; }

    fn.block_count = 0;
    val res_ok: R.Result[id.BlockId, str] = block_add(?m, fn);
    if (R.is_err[id.BlockId, str](res_ok))                    { dnit(?m); ret 1; }
    if (R.unwrap_ok[id.BlockId, str](res_ok) != 0::id.BlockId) { dnit(?m); ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.instruction_add:refuses_an_instr_len_at_the_instr_nil_sentinel" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](rm)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](rm);

    val res_i64t: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64t)) { dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64t);

    val res_fn: R.Result[u32, str] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { dnit(?m); ret 1; }
    val fn: *Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var inst: instruction.Instruction;
    inst.kind          = instruction.OP_ADD;
    inst.ty            = i64t;
    inst.operands      = nil;
    inst.operand_count = 0;
    inst.operand_cap   = 0;
    inst.flags         = 0;
    inst.aux_ty        = type.IRT_NIL;

    fn.instr_len = 0xFFFFFFFF;
    val res_over: R.Result[id.InstructionId, str] = instruction_add(?m, fn, inst);
    if (!R.is_err[id.InstructionId, str](res_over)) { fn.instr_len = 0; dnit(?m); ret 1; }
    if (fn.instr_len != 0xFFFFFFFF)                 { dnit(?m); ret 1; }

    fn.instr_len = 0;
    val res_ok: R.Result[id.InstructionId, str] = instruction_add(?m, fn, inst);
    if (R.is_err[id.InstructionId, str](res_ok)) { dnit(?m); ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.phi_append_incoming:refuses_operand_count_overflow" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](rm)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](rm);

    val res_i64t: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64t)) { dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64t);

    val res_fn: R.Result[u32, str] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { dnit(?m); ret 1; }
    val fn: *Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    val res_b: R.Result[id.BlockId, str] = block_add(?m, fn);
    if (R.is_err[id.BlockId, str](res_b)) { dnit(?m); ret 1; }
    val pred: id.BlockId = R.unwrap_ok[id.BlockId, str](res_b);

    var phi: instruction.Instruction;
    phi.kind          = instruction.OP_PHI;
    phi.ty            = i64t;
    phi.operands      = nil;
    phi.operand_count = 0xFFFFFFFE;
    phi.operand_cap   = 0xFFFFFFFE;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;

    val incoming: value.Value = value.const_int(0, i64t);
    val res_append: R.Result[R.Void, str] = phi_append_incoming(?m, ?phi, pred, incoming);
    if (!R.is_err[R.Void, str](res_append)) { dnit(?m); ret 1; }
    if (phi.operands != nil)              { dnit(?m); ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.phi_append_incoming:refuses_a_doubled_capacity_that_wraps_to_zero_before_reallocating" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: R.Result[Module, str] = init(?alloc, intern.STR_NIL);
    if (R.is_err[Module, str](rm)) { ret 1; }
    var m: Module = R.unwrap_ok[Module, str](rm);

    val res_i64t: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64t)) { dnit(?m); ret 1; }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64t);

    val res_fn: R.Result[u32, str] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { dnit(?m); ret 1; }
    val fn: *Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    val res_b: R.Result[id.BlockId, str] = block_add(?m, fn);
    if (R.is_err[id.BlockId, str](res_b)) { dnit(?m); ret 1; }
    val pred: id.BlockId = R.unwrap_ok[id.BlockId, str](res_b);

    var probe: GrowCapProbe;
    probe.reallocate_calls = 0;
    var pp: *GrowCapProbe = ?probe;
    var probe_alloc: A.Allocator;
    probe_alloc.ctx           = pp::ptr;
    probe_alloc.fn_allocate   = growcap_probe_allocate;
    probe_alloc.fn_reallocate = growcap_probe_reallocate;
    probe_alloc.fn_deallocate = growcap_probe_deallocate;

    var phi: instruction.Instruction;
    phi.kind          = instruction.OP_PHI;
    phi.ty            = i64t;
    phi.operands      = nil;
    phi.operand_count = 0x7FFFFFFF;
    phi.operand_cap   = 0x80000000;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;

    val real_alloc: *A.Allocator = m.alloc;
    m.alloc = ?probe_alloc;
    val incoming: value.Value = value.const_int(0, i64t);
    val res_append: R.Result[R.Void, str] = phi_append_incoming(?m, ?phi, pred, incoming);
    m.alloc = real_alloc;

    var bad: i32 = 0;
    if (!R.is_err[R.Void, str](res_append)) { bad = 1; }
    if (probe.reallocate_calls != 0)      { bad = 2; }
    if (phi.operands != nil)              { bad = 3; }

    dnit(?m);
    ret bad;
}

test "mach.lang.me.ir.FN_FLAG:every_flag_is_a_distinct_single_bit" {
    var flags: [10]u32;
    flags[0] = FN_FLAG_PUB; flags[1] = FN_FLAG_EXTERN; flags[2] = FN_FLAG_INLINE; flags[3] = FN_FLAG_NORETURN;
    flags[4] = FN_FLAG_TEST; flags[5] = FN_FLAG_WEAK; flags[6] = FN_FLAG_OBLIVIOUS; flags[7] = FN_FLAG_SCALAR;
    flags[8] = FN_FLAG_NOINLINE; flags[9] = FN_FLAG_NAKED;

    var i: u32 = 0;
    for (i < 10) {
        if (flags[i] == 0 || (flags[i] & (flags[i] - 1)) != 0) { ret 1; }
        var j: u32 = i + 1;
        for (j < 10) {
            if ((flags[i] & flags[j]) != 0) { ret 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}
