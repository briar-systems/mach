# the declaration carried `pub`, and nothing else sets it: a synthesized
# definition is never `pub`, however visible it has to stay within a link
pub val FN_FLAG_PUB:       u32 = 0x01;
pub val FN_FLAG_EXTERN:    u32 = 0x02;
pub val FN_FLAG_INLINE:    u32 = 0x04;
pub val FN_FLAG_NORETURN:  u32 = 0x08;
pub val FN_FLAG_TEST:      u32 = 0x10;
pub val FN_FLAG_WEAK:      u32 = 0x20;
pub val FN_FLAG_OBLIVIOUS: u32 = 0x40;

pub val FN_FLAG_SCALAR: u32 = 0x80;

pub val FN_FLAG_NOINLINE: u32 = 0x100;

pub val FN_FLAG_NAKED: u32 = 0x200;

pub val STAGE_NONE:     u8 = 0;
pub val STAGE_VERTEX:   u8 = 1;
pub val STAGE_FRAGMENT: u8 = 2;
pub val STAGE_COMPUTE:  u8 = 3;

pub val IFACE_NONE:    u8 = 0;
pub val IFACE_INPUT:   u8 = 1;
pub val IFACE_OUTPUT:  u8 = 2;
pub val IFACE_BUILTIN: u8 = 3;
pub val IFACE_UNIFORM: u8 = 4;
pub val IFACE_STORAGE: u8 = 5;
pub val IFACE_SAMPLER: u8 = 6;
pub val IFACE_PUSH:    u8 = 7;
# a specialization constant: iface_a is its SpecId, the initializer its default
pub val IFACE_SPEC:   u8 = 8;
pub val IFACE_SHARED: u8 = 9;

pub val IFACE_FLAG_READONLY:  u32 = 1;
pub val IFACE_FLAG_WRITEONLY: u32 = 2;
pub val IFACE_FLAG_COHERENT:  u32 = 4;

pub val BUILTIN_POSITION:               u32 = 0;
pub val BUILTIN_VERTEX_INDEX:           u32 = 1;
pub val BUILTIN_INSTANCE_INDEX:         u32 = 2;
pub val BUILTIN_FRAG_COORD:             u32 = 3;
pub val BUILTIN_POINT_SIZE:             u32 = 4;
pub val BUILTIN_GLOBAL_INVOCATION:      u32 = 5;
pub val BUILTIN_LOCAL_INVOCATION:       u32 = 6;
pub val BUILTIN_WORKGROUP_ID:           u32 = 7;
pub val BUILTIN_NUM_WORKGROUPS:         u32 = 8;
pub val BUILTIN_LOCAL_INVOCATION_INDEX: u32 = 9;
pub val BUILTIN_SUBGROUP_SIZE:          u32 = 10;
pub val BUILTIN_SUBGROUP_INVOCATION:    u32 = 11;
pub val BUILTIN_SUBGROUP_ID:            u32 = 12;
pub val BUILTIN_NUM_SUBGROUPS:          u32 = 13;

pub rec IrAsmBind {
    name:    intern.StrId;
    instr:   ir_id.InstructionId;
    secrecy: ct.BindSecrecy;
}

pub rec IrAsm {
    isa:        intern.StrId;
    body:       intern.StrId;
    binds:      *IrAsmBind;
    bind_count: u32;
    bind_cap:   u32;
}

pub rec DbgVar {
    name:     intern.StrId;
    ty:       ir_type.IrTypeId;
    ty_sem:   type.TypeId;
    is_param: bool;
    scope:    u32;
}

pub val DBG_OP_PLUS_CONST:  u8 = 0;
pub val DBG_OP_MINUS_CONST: u8 = 1;

pub rec DbgOp {
    op:  u8;
    arg: u64;
}

# a debug expression's slot in its function's expression table
pub rec DbgExprId {
    index: u32;
}

# the empty expression, slot 0: a variable read as it is
pub val DBG_EXPR_IDENTITY: DbgExprId = DbgExprId{index: 0};

pub fun dbg_expr(index: u32) DbgExprId {
    var id: DbgExprId;
    id.index = index;
    ret id;
}

pub fun dbg_expr_index(id: DbgExprId) u32 {
    ret id.index;
}

pub fun dbg_expr_same(left: DbgExprId, right: DbgExprId) bool {
    ret left.index == right.index;
}

pub fun dbg_expr_is_identity(id: DbgExprId) bool {
    ret id.index == DBG_EXPR_IDENTITY.index;
}

pub rec DbgExpr {
    ops:      *DbgOp;
    op_count: u32;
    op_cap:   u32;
}

pub rec InlineSite {
    callee:   intern.StrId;
    call_loc: lang_source.Location;
    parent:   u32;
}

pub rec Block {
    id: ir_id.BlockId;

    instructions: *ir_id.InstructionId;
    instr_count:  u32;
    instr_cap:    u32;

    phis:      *ir_id.InstructionId;
    phi_count: u32;
    phi_cap:   u32;

    terminator: ir_id.InstructionId;

    preds:      *ir_id.BlockId;
    pred_count: u32;
    pred_cap:   u32;
}

pub rec Function {
    name: intern.StrId;
    # actual body provider, unique for strong linkage and selected for shared weak linkage
    body_module: intern.StrId;
    sig:         ir_type.IrTypeId;
    # the extension each integer parameter narrower than 64 bits declares,
    # which the signless signature does not carry
    param_ext: ir_type.ExtListId;

    params:      *value.Value;
    param_count: u32;

    blocks:      *Block;
    block_count: u32;
    block_cap:   u32;

    instrs:    *ir_instruction.Instruction;
    instr_len: u32;
    instr_cap: u32;

    flags:     u32;
    is_import: bool;
    line:      u32;
    section:   intern.StrId;
    stage:     u8;
    wg_x:      u32;
    wg_y:      u32;
    wg_z:      u32;
    # the linkage name of the `#[spec]` global a dimension names, nil for a literal one
    wg_spec: [3]intern.StrId;
    op_set:  u32;
    op_code: u32;
    # the entry alignment `#[align]` asks for, 0 for the target's own
    align: u32;
    # the extensions `#[extensions(...)]` admits in this body, beyond the target's
    extensions: u64;
    disp:       intern.StrId;
    ret_sem:    type.TypeId;
    # where the function itself is declared, which is not any instruction's location
    decl_loc: lang_source.Location;

    asm_blocks: map.Map[ir_id.InstructionId, IrAsm];
    dbg_vars:   map.Map[ir_id.InstructionId, DbgVar];

    dbg_exprs:       *DbgExpr;
    dbg_expr_len:    u32;
    dbg_expr_cap:    u32;
    dbg_expr_ids:    map.Map[ir_id.InstructionId, DbgExprId];
    alloca_dbg_vars: map.Map[ir_id.InstructionId, DbgVar];

    inline_sites:      *InlineSite;
    inline_site_len:   u32;
    inline_site_cap:   u32;
    instr_inline_site: map.Map[ir_id.InstructionId, u32];
}

pub rec Global {
    name:        intern.StrId;
    ty:          ir_type.IrTypeId;
    init:        value.Value;
    is_mut:      bool;
    is_pub:      bool;
    is_extern:   bool;
    is_import:   bool;
    is_local:    bool;
    is_embed:    bool;
    align:       u32;
    section:     intern.StrId;
    iface:       u8;
    iface_a:     u32;
    iface_b:     u32;
    iface_flags: u32;
    # the declared name and source type a debug model shows; nil for a global no declaration made
    disp:   intern.StrId;
    ty_sem: type.TypeId;
    # where the declaration names the global, which a refusal of it points at; nil for a global no declaration made
    decl_loc: lang_source.Location;
}

pub rec ModuleHome {
    # the caller's freeing allocator the arena grows from, which the module's
    # passes also take their scratch from
    backing: *A.Allocator;
    ar:      arena.Arena;
    alloc:   A.Allocator;
}

pub fun home_init(h: *ModuleHome, backing: *A.Allocator) err[fail.Fail] {
    if (h == nil) { ret err[fail.Fail].err{fail.message("ir: module home is nil")}; }
    h.backing = backing;
    val r_209: err[A.Error] = arena.init(?h.ar, backing, 0);
    if (sel r_209.err) { ret err[fail.Fail].err{fail.message("ir: module home arena init failed")}; }
    val r_210: err[A.Error] = arena.make(?h.alloc, ?h.ar);
    if (sel r_210.err) {
        arena.dnit(?h.ar);
        ret err[fail.Fail].err{fail.message("ir: module home arena bind failed")};
    }
    ret err[fail.Fail].ok{};
}

pub fun home_dnit(h: *ModuleHome) {
    if (h == nil) { ret; }
    arena.dnit(?h.ar);
}

pub rec Module {
    alloc: *A.Allocator;
    # the freeing allocator the module's passes take scratch from: `alloc`
    # unless the module's home names its own
    backing: *A.Allocator;
    name:    intern.StrId;

    functions:    *Function;
    function_len: u32;
    function_cap: u32;

    globals:    *Global;
    global_len: u32;
    global_cap: u32;

    types: ir_type.IrTypeTable;

    init_fn: opt[u32];

    fn_by_name:     map.Map[intern.StrId, u32];
    global_by_name: map.Map[intern.StrId, u32];

    # this module belongs to the root project, so its `pub` declarations are the
    # library's own export surface
    root_project: bool;

    # linkage names this module's `fwd` re-exports put on that surface, whichever
    # module defines them
    export_requests:    *intern.StrId;
    export_request_len: u32;
    export_request_cap: u32;
}

val INITIAL_FN_CAP:     u32 = 8;
val INITIAL_GLOBAL_CAP: u32 = 8;

pub fun init(a: *A.Allocator, name: intern.StrId) res[Module, fail.Fail] {
    var m: Module;
    m.alloc   = a;
    m.backing = a;
    m.name    = name;

    m.functions          = nil;
    m.function_len       = 0;
    m.function_cap       = 0;
    m.globals            = nil;
    m.global_len         = 0;
    m.global_cap         = 0;
    m.init_fn            = opt[u32].none{};
    m.root_project       = false;
    m.export_requests    = nil;
    m.export_request_len = 0;
    m.export_request_cap = 0;

    m.fn_by_name     = map.init[intern.StrId, u32](a);
    m.global_by_name = map.init[intern.StrId, u32](a);

    val opt_types: err[fail.Fail] = ir_type.init(?m.types, a);
    if (sel opt_types.err) {
        ret res[Module, fail.Fail].err{opt_types.err};
    }

    val res_functions: res[*Function, A.Error] = A.allocate[Function](a, INITIAL_FN_CAP::usize);
    if (sel res_functions.err) {
        ir_type.dnit(?m.types);
        ret res[Module, fail.Fail].err{fail.refused(res_functions.err)};
    }
    m.functions    = res_functions.ok;
    m.function_cap = INITIAL_FN_CAP;

    val res_globals: res[*Global, A.Error] = A.allocate[Global](a, INITIAL_GLOBAL_CAP::usize);
    if (sel res_globals.err) {
        A.deallocate[Function](a, m.functions, m.function_cap::usize);
        ir_type.dnit(?m.types);
        ret res[Module, fail.Fail].err{fail.refused(res_globals.err)};
    }
    m.globals    = res_globals.ok;
    m.global_cap = INITIAL_GLOBAL_CAP;

    ret res[Module, fail.Fail].ok{m};
}

pub fun dnit(m: *Module) {
    if (m == nil) { ret; }

    var i: u32 = 0;
    for (i < m.function_len) {
        function_dnit(m, ?m.functions[i]);
        i = i + 1;
    }

    i = 0;
    for (i < m.global_len) {
        agg_value_dnit(m, ?m.globals[i].init);
        i = i + 1;
    }

    if (m.functions != nil && m.function_cap > 0) {
        A.deallocate[Function](m.alloc, m.functions, m.function_cap::usize);
    }
    if (m.globals != nil && m.global_cap > 0) {
        A.deallocate[Global](m.alloc, m.globals, m.global_cap::usize);
    }
    if (m.export_requests != nil && m.export_request_cap > 0) {
        A.deallocate[intern.StrId](m.alloc, m.export_requests, m.export_request_cap::usize);
    }
    m.export_requests    = nil;
    m.export_request_len = 0;
    m.export_request_cap = 0;
    map.dnit[intern.StrId, u32](?m.fn_by_name);
    map.dnit[intern.StrId, u32](?m.global_by_name);
    ir_type.dnit(?m.types);

    m.functions    = nil;
    m.function_len = 0;
    m.function_cap = 0;
    m.globals      = nil;
    m.global_len   = 0;
    m.global_cap   = 0;
    m.init_fn      = opt[u32].none{};
    m.name         = intern.STR_NIL;
    m.alloc        = nil;
}

pub fun function_dnit(m: *Module, fn: *Function) {
    var i: u32 = 0;
    for (i < fn.block_count) {
        block_dnit(m, ?fn.blocks[i]);
        i = i + 1;
    }
    if (fn.blocks != nil && fn.block_cap > 0) {
        A.deallocate[Block](m.alloc, fn.blocks, fn.block_cap::usize);
    }
    if (fn.params != nil && fn.param_count > 0) {
        A.deallocate[value.Value](m.alloc, fn.params, fn.param_count::usize);
    }

    i = 0;
    for (i < fn.instr_len) {
        if (fn.instrs[i].kind == ir_instruction.OP_ASM) {
            var key:     ir_id.InstructionId = i::ir_id.InstructionId;
            val res_asm: opt[*IrAsm]         = map.get[ir_id.InstructionId, IrAsm](?fn.asm_blocks, ?key);
            if (sel res_asm.some) {
                val asm: *IrAsm = res_asm.some;
                if (asm.binds != nil && asm.bind_cap > 0) {
                    A.deallocate[IrAsmBind](m.alloc, asm.binds, asm.bind_cap::usize);
                }
            }
        }
        instruction_dnit(m, ?fn.instrs[i]);
        i = i + 1;
    }
    if (fn.instrs != nil && fn.instr_cap > 0) {
        A.deallocate[ir_instruction.Instruction](m.alloc, fn.instrs, fn.instr_cap::usize);
    }
    map.dnit[ir_id.InstructionId, IrAsm](?fn.asm_blocks);
    map.dnit[ir_id.InstructionId, DbgVar](?fn.dbg_vars);
    map.dnit[ir_id.InstructionId, DbgVar](?fn.alloca_dbg_vars);

    var e: u32 = 0;
    for (e < fn.dbg_expr_len) {
        val dex: *DbgExpr = ?fn.dbg_exprs[e];
        if (dex.ops != nil && dex.op_cap > 0) {
            A.deallocate[DbgOp](m.alloc, dex.ops, dex.op_cap::usize);
        }
        e = e + 1;
    }
    if (fn.dbg_exprs != nil && fn.dbg_expr_cap > 0) {
        A.deallocate[DbgExpr](m.alloc, fn.dbg_exprs, fn.dbg_expr_cap::usize);
    }
    map.dnit[ir_id.InstructionId, DbgExprId](?fn.dbg_expr_ids);

    if (fn.inline_sites != nil && fn.inline_site_cap > 0) {
        A.deallocate[InlineSite](m.alloc, fn.inline_sites, fn.inline_site_cap::usize);
    }
    map.dnit[ir_id.InstructionId, u32](?fn.instr_inline_site);
}

# releases the block's instruction, phi and predecessor lists
pub fun block_dnit(m: *Module, blk: *Block) {
    if (blk.instructions != nil && blk.instr_cap > 0) {
        A.deallocate[ir_id.InstructionId](m.alloc, blk.instructions, blk.instr_cap::usize);
    }
    if (blk.phis != nil && blk.phi_cap > 0) {
        A.deallocate[ir_id.InstructionId](m.alloc, blk.phis, blk.phi_cap::usize);
    }
    if (blk.preds != nil && blk.pred_cap > 0) {
        A.deallocate[ir_id.BlockId](m.alloc, blk.preds, blk.pred_cap::usize);
    }
}

fun instruction_dnit(m: *Module, inst: *ir_instruction.Instruction) {
    if (inst.operands != nil && inst.operand_cap > 0) {
        A.deallocate[value.Value](m.alloc, inst.operands, inst.operand_cap::usize);
    }
}

fun agg_value_dnit(m: *Module, v: *value.Value) {
    if (v.kind != value.VAL_CONST_AGG) { ret; }
    if (v.data.agg.bytes != nil && v.data.agg.len > 0) {
        A.deallocate[u8](m.alloc, v.data.agg.bytes, v.data.agg.len::usize);
    }
    if (v.data.agg.relocs != nil && v.data.agg.reloc_cap > 0) {
        A.deallocate[value.AggReloc](m.alloc, v.data.agg.relocs, v.data.agg.reloc_cap::usize);
    }
}

pub fun function_new(alloc: *A.Allocator, name: intern.StrId, sig: ir_type.IrTypeId, flags: u32) Function {
    var f: Function;
    f.name              = name;
    f.body_module       = intern.STR_NIL;
    f.sig               = sig;
    f.param_ext         = ir_type.EXT_LIST_EMPTY;
    f.params            = nil;
    f.param_count       = 0;
    f.blocks            = nil;
    f.block_count       = 0;
    f.block_cap         = 0;
    f.instrs            = nil;
    f.instr_len         = 0;
    f.instr_cap         = 0;
    f.flags             = flags;
    f.is_import         = false;
    f.line              = 0;
    f.section           = intern.STR_NIL;
    f.align             = 0;
    f.stage             = STAGE_NONE;
    f.wg_x              = 1;
    f.wg_y              = 1;
    f.wg_z              = 1;
    f.wg_spec[0]        = intern.STR_NIL;
    f.wg_spec[1]        = intern.STR_NIL;
    f.wg_spec[2]        = intern.STR_NIL;
    f.op_set            = definition.NO_OP_SET;
    f.op_code           = definition.NO_OPCODE;
    f.extensions        = 0;
    f.disp              = intern.STR_NIL;
    f.ret_sem           = type.TYPE_NIL;
    f.decl_loc          = lang_source.location_nil();
    f.asm_blocks        = map.init[ir_id.InstructionId, IrAsm](alloc);
    f.dbg_vars          = map.init[ir_id.InstructionId, DbgVar](alloc);
    f.dbg_exprs         = nil;
    f.dbg_expr_len      = 0;
    f.dbg_expr_cap      = 0;
    f.dbg_expr_ids      = map.init[ir_id.InstructionId, DbgExprId](alloc);
    f.alloca_dbg_vars   = map.init[ir_id.InstructionId, DbgVar](alloc);
    f.inline_sites      = nil;
    f.inline_site_len   = 0;
    f.inline_site_cap   = 0;
    f.instr_inline_site = map.init[ir_id.InstructionId, u32](alloc);
    ret f;
}

pub fun function_add(m: *Module, name: intern.StrId, sig: ir_type.IrTypeId, flags: u32) res[u32, fail.Fail] {
    if (m.function_len == m.function_cap) {
        val grown: err[A.Error] = growth.reserve[Function](m.alloc, ?m.functions, ?m.function_cap, m.function_len::usize + 1);
        if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    }
    val idx: u32 = m.function_len;
    m.functions[idx] = function_new(m.alloc, name, sig, flags);
    m.function_len   = m.function_len + 1;
    ret res[u32, fail.Fail].ok{idx};
}

# a name this module's `fwd` re-exports puts on the library's export surface;
# recording the same name twice is the common case (two modules re-exporting one
# declaration) and collapses here
pub fun export_request_add(m: *Module, name: intern.StrId) err[fail.Fail] {
    if (intern.str_is_nil(name)) { ret err[fail.Fail].ok{}; }
    var i: u32 = 0;
    for (i < m.export_request_len) {
        if (intern.str_same(m.export_requests[i], name)) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }
    if (m.export_request_len == m.export_request_cap) {
        val grown: err[A.Error] = growth.reserve[intern.StrId](m.alloc, ?m.export_requests, ?m.export_request_cap, m.export_request_len::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    m.export_requests[m.export_request_len] = name;
    m.export_request_len                    = m.export_request_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun function_register(m: *Module, name: intern.StrId, idx: u32) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[intern.StrId, u32](?m.fn_by_name, name, idx);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun function_lookup(m: *Module, name: intern.StrId) opt[u32] {
    var key:     intern.StrId = name;
    val res_idx: opt[*u32]    = map.get[intern.StrId, u32](?m.fn_by_name, ?key);
    if (sel res_idx.some) { ret opt[u32].some{@res_idx.some}; }
    ret opt[u32].none{};
}

pub fun global_register(m: *Module, name: intern.StrId, idx: u32) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[intern.StrId, u32](?m.global_by_name, name, idx);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun global_lookup(m: *Module, name: intern.StrId) opt[u32] {
    var key:     intern.StrId = name;
    val res_idx: opt[*u32]    = map.get[intern.StrId, u32](?m.global_by_name, ?key);
    if (sel res_idx.some) { ret opt[u32].some{@res_idx.some}; }
    ret opt[u32].none{};
}

# a global named `name` of type `ty` holding `init`, private, immutable and
# defined here, every other field its empty value
pub fun global_init(name: intern.StrId, ty: ir_type.IrTypeId, init_value: value.Value) Global {
    var g: Global;
    g.name        = name;
    g.ty          = ty;
    g.init        = init_value;
    g.is_mut      = false;
    g.is_pub      = false;
    g.is_extern   = false;
    g.is_import   = false;
    g.is_local    = false;
    g.is_embed    = false;
    g.align       = 0;
    g.section     = intern.STR_NIL;
    g.iface       = IFACE_NONE;
    g.iface_a     = 0;
    g.iface_b     = 0;
    g.iface_flags = 0;
    g.disp        = intern.STR_NIL;
    g.ty_sem      = type.TYPE_NIL;
    g.decl_loc    = lang_source.location_nil();
    ret g;
}

# `g` appended to the module's globals, its index; the name is not registered
pub fun global_add(m: *Module, g: Global) res[u32, fail.Fail] {
    val grown: err[A.Error] = growth.reserve[Global](m.alloc, ?m.globals, ?m.global_cap, m.global_len::usize + 1);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    val idx: u32 = m.global_len;
    m.globals[idx] = g;
    m.global_len   = idx + 1;
    ret res[u32, fail.Fail].ok{idx};
}

pub fun instruction_get(fn: *Function, i: ir_id.InstructionId) opt[*ir_instruction.Instruction] {
    if (ir_id.instruction_is_nil(i)) { ret opt[*ir_instruction.Instruction].none{}; }
    if (i::u32 >= fn.instr_len)      { ret opt[*ir_instruction.Instruction].none{}; }
    ret opt[*ir_instruction.Instruction].some{?fn.instrs[i::u32]};
}

# the constant a value is: the operand of the `const` that materializes it
#, read at the use's type and secrecy, and any other value as itself.
# a pass that reads constants reads through this, so a materialized constant
# folds and compares as the constant it holds
pub fun constant_behind(fn: *Function, v: value.Value) value.Value {
    if (v.kind != value.VAL_INSTR || v.data.instr::u32 >= fn.instr_len) { ret v; }
    val ins: *ir_instruction.Instruction = ?fn.instrs[v.data.instr::u32];
    if (ins.kind != ir_instruction.OP_CONST || ins.operand_count != 1) { ret v; }
    var c: value.Value = value.retype(ins.operands[0], v.ty);
    if (v.secret) { c.secret = true; }
    ret c;
}

rec InstructionIdDomain {}

pub fun instruction_add(m: *Module, fn: *Function, inst: ir_instruction.Instruction) res[ir_id.InstructionId, fail.Fail] {
    if (fn.instr_len >= fn.instr_cap) {
        val grown: err[A.Error] = growth.reserve[ir_instruction.Instruction](m.alloc, ?fn.instrs, ?fn.instr_cap, fn.instr_len::usize + 1);
        if (sel grown.err) { ret res[ir_id.InstructionId, fail.Fail].err{fail.refused(grown.err)}; }
    }
    val checked_id: res[lang_checked.Id[InstructionIdDomain], lang_checked.Cause] =
        lang_checked.id_below[InstructionIdDomain](fn.instr_len::usize, lang_checked.count[InstructionIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[ir_id.InstructionId, fail.Fail].err{fail.message("ir: instruction id exhausts its 32-bit domain")};
    }
    val iid: ir_id.InstructionId = ir_id.instruction(checked_id.ok.value::u32);
    fn.instrs[fn.instr_len] = inst;
    fn.instr_len            = fn.instr_len + 1;
    ret res[ir_id.InstructionId, fail.Fail].ok{iid};
}

pub rec OperandArray {
    ops: *value.Value;
    len: u32;
}

pub fun operands_alloc(m: *Module, n: u32) res[OperandArray, fail.Fail] {
    var arr: OperandArray;
    arr.ops = nil;
    arr.len = n;
    if (n == 0) { ret res[OperandArray, fail.Fail].ok{arr}; }

    val res_: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, n::usize);
    if (sel res_.err) { ret res[OperandArray, fail.Fail].err{fail.refused(res_.err)}; }
    arr.ops = res_.ok;
    ret res[OperandArray, fail.Fail].ok{arr};
}

pub fun instr_replace_operands(m: *Module, ins: *ir_instruction.Instruction, arr: OperandArray) {
    if (ins.operands != nil && ins.operand_cap > 0 && ins.operands != arr.ops) {
        A.deallocate[value.Value](m.alloc, ins.operands, ins.operand_cap::usize);
    }
    ins.operands      = arr.ops;
    ins.operand_count = arr.len;
    ins.operand_cap   = arr.len;
}

pub fun phi_append_incoming(m: *Module, phi: *ir_instruction.Instruction, pred: ir_id.BlockId, incoming: value.Value) err[fail.Fail] {
    val res_target: res[value.Value, fail.Fail] = block_target_make(m, pred);
    if (sel res_target.err) {
        ret err[fail.Fail].err{res_target.err};
    }

    val needed_r: res[lang_checked.Count[value.Value], lang_checked.Cause] =
        lang_checked.count_add[value.Value](lang_checked.count[value.Value](phi.operand_count::usize),
        lang_checked.count[value.Value](2::usize));
    if (sel needed_r.err) {
        ret err[fail.Fail].err{fail.message("ir: phi operand count overflow")};
    }
    val needed_c: lang_checked.Count[value.Value] = needed_r.ok;
    val grown:    err[A.Error]                    = growth.reserve[value.Value](m.alloc, ?phi.operands, ?phi.operand_cap, needed_c.value);
    if (sel grown.err) {
        ret err[fail.Fail].err{fail.refused(grown.err)};
    }
    val needed_fits: res[u32, lang_checked.Cause] = lang_checked.usize_to_u32(needed_c.value);
    if (sel needed_fits.err) {
        ret err[fail.Fail].err{fail.message("ir: phi operand count exceeds the u32 limit")};
    }
    val needed: u32 = needed_fits.ok;
    phi.operands[phi.operand_count]     = res_target.ok;
    phi.operands[phi.operand_count + 1] = incoming;
    phi.operand_count                   = needed;
    ret err[fail.Fail].ok{};
}

# the incoming edge from `pred` dropped from `phi`, the first when several
pub fun phi_incoming_del(phi: *ir_instruction.Instruction, pred: ir_id.BlockId) {
    var o: u32 = 0;
    for (o + 1 < phi.operand_count) {
        if (ir_id.block_same(block_target(phi.operands[o]), pred)) {
            phi_incoming_del_at(phi, o);
            ret;
        }
        o = o + 2;
    }
}

# the incoming pair whose block operand is at `at` dropped from `phi`
pub fun phi_incoming_del_at(phi: *ir_instruction.Instruction, at: u32) {
    var o: u32 = at;
    for (o + 2 < phi.operand_count) {
        phi.operands[o]     = phi.operands[o + 2];
        phi.operands[o + 1] = phi.operands[o + 3];
        o                   = o + 2;
    }
    phi.operand_count = phi.operand_count - 2;
}

# the incoming pairs of `phi` that `keep` accepts, in order; `keep` sees each
# pair's block operand and may rewrite it
pub fun phi_incoming_keep[T](phi: *ir_instruction.Instruction, ctx: *T, keep: fun(*T, *value.Value) bool) {
    var w: u32 = 0;
    var r: u32 = 0;
    for (r + 1 < phi.operand_count) {
        if (keep(ctx, ?phi.operands[r])) {
            phi.operands[w]     = phi.operands[r];
            phi.operands[w + 1] = phi.operands[r + 1];
            w                   = w + 2;
        }
        r = r + 2;
    }
    phi.operand_count = w;
}

#[testing]
pub fun asm_get(fn: *Function, iid: ir_id.InstructionId) opt[*IrAsm] {
    var key:  ir_id.InstructionId = iid;
    val res_: opt[*IrAsm]         = map.get[ir_id.InstructionId, IrAsm](?fn.asm_blocks, ?key);
    if (sel res_.none) { ret opt[*IrAsm].none{}; }
    ret opt[*IrAsm].some{res_.some};
}

pub fun dbg_var_get(fn: *Function, iid: ir_id.InstructionId) opt[*DbgVar] {
    var key:  ir_id.InstructionId = iid;
    val res_: opt[*DbgVar]        = map.get[ir_id.InstructionId, DbgVar](?fn.dbg_vars, ?key);
    if (sel res_.none) { ret opt[*DbgVar].none{}; }
    ret opt[*DbgVar].some{res_.some};
}

pub fun record_alloca_dbg_var(fn: *Function, alloca_id: ir_id.InstructionId, dv: DbgVar) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[ir_id.InstructionId, DbgVar](?fn.alloca_dbg_vars, alloca_id, dv);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun alloca_dbg_var_get(fn: *Function, alloca_id: ir_id.InstructionId) opt[*DbgVar] {
    var key:  ir_id.InstructionId = alloca_id;
    val res_: opt[*DbgVar]        = map.get[ir_id.InstructionId, DbgVar](?fn.alloca_dbg_vars, ?key);
    if (sel res_.none) { ret opt[*DbgVar].none{}; }
    ret opt[*DbgVar].some{res_.some};
}

pub fun clone_alloca_dbg_var(src_fn: *Function, dst_fn: *Function, src_iid: ir_id.InstructionId, dst_iid: ir_id.InstructionId) err[fail.Fail] {
    val odv: opt[*DbgVar] = alloca_dbg_var_get(src_fn, src_iid);
    if (sel odv.none) { ret err[fail.Fail].ok{}; }
    val dv: DbgVar = @odv.some;
    ret record_alloca_dbg_var(dst_fn, dst_iid, dv);
}

pub fun dbg_value_const(fn: *Function, iid: ir_id.InstructionId) opt[i64] {
    val gi: opt[*ir_instruction.Instruction] = instruction_get(fn, iid);
    if (sel gi.none) { ret opt[i64].none{}; }
    val inst: *ir_instruction.Instruction = gi.some;
    if (inst.operand_count == 0) { ret opt[i64].none{}; }
    val op: *value.Value = ?inst.operands[0];
    if (op.kind != value.VAL_CONST_INT) { ret opt[i64].none{}; }
    ret opt[i64].some{op.data.int_lit::i64};
}

pub fun dbg_expr_id(fn: *Function, iid: ir_id.InstructionId) DbgExprId {
    var key:  ir_id.InstructionId = iid;
    val res_: opt[*DbgExprId]     = map.get[ir_id.InstructionId, DbgExprId](?fn.dbg_expr_ids, ?key);
    if (sel res_.none) { ret DBG_EXPR_IDENTITY; }
    val p: *DbgExprId = res_.some;
    ret @p;
}

pub fun dbg_expr_get(fn: *Function, eid: DbgExprId) opt[*DbgExpr] {
    if (dbg_expr_is_identity(eid)) { ret opt[*DbgExpr].none{}; }
    val idx: u32 = eid::u32 - 1;
    if (idx >= fn.dbg_expr_len) { ret opt[*DbgExpr].none{}; }
    ret opt[*DbgExpr].some{?fn.dbg_exprs[idx]};
}

pub fun dbg_expr_new(m: *Module, fn: *Function, iid: ir_id.InstructionId) res[DbgExprId, fail.Fail] {
    if (fn.dbg_expr_len >= fn.dbg_expr_cap) {
        val grown: err[A.Error] = growth.reserve[DbgExpr](m.alloc, ?fn.dbg_exprs, ?fn.dbg_expr_cap, fn.dbg_expr_len::usize + 1);
        if (sel grown.err) { ret res[DbgExprId, fail.Fail].err{fail.refused(grown.err)}; }
    }
    val idx: u32 = fn.dbg_expr_len;
    fn.dbg_exprs[idx].ops      = nil;
    fn.dbg_exprs[idx].op_count = 0;
    fn.dbg_exprs[idx].op_cap   = 0;

    val eid:     DbgExprId          = (idx + 1)::DbgExprId;
    val res_ins: res[bool, A.Error] = map.insert[ir_id.InstructionId, DbgExprId](?fn.dbg_expr_ids, iid, eid);
    if (sel res_ins.err) {
        ret res[DbgExprId, fail.Fail].err{fail.refused(res_ins.err)};
    }
    fn.dbg_expr_len = fn.dbg_expr_len + 1;
    ret res[DbgExprId, fail.Fail].ok{eid};
}

pub fun dbg_expr_prepend_op(m: *Module, fn: *Function, eid: DbgExprId, op: DbgOp) err[fail.Fail] {
    val opt_: opt[*DbgExpr] = dbg_expr_get(fn, eid);
    if (sel opt_.none) { ret err[fail.Fail].err{fail.message("dbg_expr_prepend_op: invalid expression id")}; }
    val dex: *DbgExpr = opt_.some;

    if (dex.op_count >= dex.op_cap) {
        val grown: err[A.Error] = growth.reserve[DbgOp](m.alloc, ?dex.ops, ?dex.op_cap, dex.op_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }

    var i: u32 = dex.op_count;
    for (i > 0) {
        dex.ops[i] = dex.ops[i - 1];
        i          = i - 1;
    }
    dex.ops[0]   = op;
    dex.op_count = dex.op_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun inline_site_add(m: *Module, fn: *Function, callee: intern.StrId, call_loc: lang_source.Location, parent: u32) res[u32, fail.Fail] {
    if (fn.inline_site_len >= fn.inline_site_cap) {
        val grown: err[A.Error] = growth.reserve[InlineSite](m.alloc, ?fn.inline_sites, ?fn.inline_site_cap, fn.inline_site_len::usize + 1);
        if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }
    }
    val idx: u32 = fn.inline_site_len;
    fn.inline_sites[idx].callee   = callee;
    fn.inline_sites[idx].call_loc = call_loc;
    fn.inline_sites[idx].parent   = parent;
    fn.inline_site_len            = fn.inline_site_len + 1;
    ret res[u32, fail.Fail].ok{idx + 1};
}

#[testing]
fun inline_site_get(fn: *Function, site: u32) opt[*InlineSite] {
    if (site == 0 || site > fn.inline_site_len) { ret opt[*InlineSite].none{}; }
    ret opt[*InlineSite].some{?fn.inline_sites[site - 1]};
}

pub fun instr_inline_site_set(fn: *Function, iid: ir_id.InstructionId, site: u32) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[ir_id.InstructionId, u32](?fn.instr_inline_site, iid, site);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun instr_inline_site_of(fn: *Function, iid: ir_id.InstructionId) u32 {
    var key:  ir_id.InstructionId = iid;
    val res_: opt[*u32]           = map.get[ir_id.InstructionId, u32](?fn.instr_inline_site, ?key);
    if (sel res_.none) { ret 0; }
    ret @res_.some;
}

pub fun clone_instr_inline_site(src_fn: *Function, dst_fn: *Function, src_iid: ir_id.InstructionId, dst_iid: ir_id.InstructionId) err[fail.Fail] {
    val site: u32 = instr_inline_site_of(src_fn, src_iid);
    if (site == 0) { ret err[fail.Fail].ok{}; }
    ret instr_inline_site_set(dst_fn, dst_iid, site);
}

pub fun clone_dbg_metadata(m: *Module, src_fn: *Function, dst_fn: *Function, src_iid: ir_id.InstructionId, dst_iid: ir_id.InstructionId) err[fail.Fail] {
    val odv: opt[*DbgVar] = dbg_var_get(src_fn, src_iid);
    if (sel odv.none) { ret err[fail.Fail].ok{}; }
    var dv: DbgVar = @odv.some;

    val seid: DbgExprId     = dbg_expr_id(src_fn, src_iid);
    val ose:  opt[*DbgExpr] = dbg_expr_get(src_fn, seid);
    if (sel ose.none) {
        val inserted: res[bool, A.Error] = map.insert[ir_id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv);
        if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
        ret err[fail.Fail].ok{};
    }
    val se0: *DbgExpr = ose.some;
    val n:   u32      = se0.op_count;
    if (n == 0) {
        val inserted: res[bool, A.Error] = map.insert[ir_id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv);
        if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
        ret err[fail.Fail].ok{};
    }

    val rsnap: res[*DbgOp, A.Error] = A.allocate[DbgOp](m.alloc, n::usize);
    if (sel rsnap.err) { ret err[fail.Fail].err{fail.refused(rsnap.err)}; }
    val snap: *DbgOp = rsnap.ok;
    memory.copy[DbgOp](snap, se0.ops, n::usize);

    val ri: res[bool, A.Error] = map.insert[ir_id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv);
    if (sel ri.err) {
        A.deallocate[DbgOp](m.alloc, snap, n::usize);
        ret err[fail.Fail].err{fail.refused(ri.err)};
    }

    val rne: res[DbgExprId, fail.Fail] = dbg_expr_new(m, dst_fn, dst_iid);
    if (sel rne.err) {
        A.deallocate[DbgOp](m.alloc, snap, n::usize);
        ret err[fail.Fail].err{rne.err};
    }
    val deid: DbgExprId = rne.ok;
    var j:    u32       = n;
    for (j > 0) {
        val rp: err[fail.Fail] = dbg_expr_prepend_op(m, dst_fn, deid, snap[j - 1]);
        if (sel rp.err) {
            A.deallocate[DbgOp](m.alloc, snap, n::usize);
            ret rp;
        }
        j = j - 1;
    }
    A.deallocate[DbgOp](m.alloc, snap, n::usize);
    ret err[fail.Fail].ok{};
}

pub fun clone_asm_payload(m: *Module, src_fn: *Function, dst_fn: *Function,
    src_iid: ir_id.InstructionId, dst_iid: ir_id.InstructionId,
    instr_map: *u32, map_len: u32) err[fail.Fail] {
    var key:  ir_id.InstructionId = src_iid;
    val res_: opt[*IrAsm]         = map.get[ir_id.InstructionId, IrAsm](?src_fn.asm_blocks, ?key);
    if (sel res_.none) { ret err[fail.Fail].ok{}; }
    val src: *IrAsm = res_.some;

    var dst: IrAsm;
    dst.isa        = src.isa;
    dst.body       = src.body;
    dst.binds      = nil;
    dst.bind_count = 0;
    dst.bind_cap   = 0;

    if (src.bind_count > 0) {
        val rb: res[*IrAsmBind, A.Error] = A.allocate[IrAsmBind](m.alloc, src.bind_count::usize);
        if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
        dst.binds      = rb.ok;
        dst.bind_cap   = src.bind_count;
        dst.bind_count = src.bind_count;

        var i: u32 = 0;
        for (i < src.bind_count) {
            dst.binds[i] = src.binds[i];
            if (instr_map != nil) {
                val old: u32 = src.binds[i].instr::u32;
                if (old >= map_len) {
                    A.deallocate[IrAsmBind](m.alloc, dst.binds, dst.bind_cap::usize);
                    ret err[fail.Fail].err{fail.message("inline-asm '{name}' binding names an instruction outside the cloned callee")};
                }
                dst.binds[i].instr = instr_map[old]::ir_id.InstructionId;
            }
            i = i + 1;
        }
    }

    var existing_key: ir_id.InstructionId = dst_iid;
    val res_existing: opt[*IrAsm]         = map.get[ir_id.InstructionId, IrAsm](?dst_fn.asm_blocks, ?existing_key);
    if (sel res_existing.some) {
        val old: *IrAsm = res_existing.some;
        if (old.binds != nil && old.bind_cap > 0) {
            A.deallocate[IrAsmBind](m.alloc, old.binds, old.bind_cap::usize);
        }
    }

    val ri: res[bool, A.Error] = map.insert[ir_id.InstructionId, IrAsm](?dst_fn.asm_blocks, dst_iid, dst);
    if (sel ri.err) {
        if (dst.binds != nil) { A.deallocate[IrAsmBind](m.alloc, dst.binds, dst.bind_cap::usize); }
        if (sel ri.err)       { ret err[fail.Fail].err{fail.refused(ri.err)}; }
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].ok{};
}

rec BlockIdDomain {}

pub fun block_add(m: *Module, fn: *Function) res[ir_id.BlockId, fail.Fail] {
    if (fn.block_count >= fn.block_cap) {
        val grown: err[A.Error] = growth.reserve[Block](m.alloc, ?fn.blocks, ?fn.block_cap, fn.block_count::usize + 1);
        if (sel grown.err) { ret res[ir_id.BlockId, fail.Fail].err{fail.refused(grown.err)}; }
    }
    val checked_id: res[lang_checked.Id[BlockIdDomain], lang_checked.Cause] =
        lang_checked.id_below[BlockIdDomain](fn.block_count::usize, lang_checked.count[BlockIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[ir_id.BlockId, fail.Fail].err{fail.message("ir: block id exhausts its 32-bit domain")};
    }
    val bid: ir_id.BlockId = ir_id.block(checked_id.ok.value::u32);
    var blk: *Block        = ?fn.blocks[fn.block_count];
    blk.id           = bid;
    blk.instructions = nil;
    blk.instr_count  = 0;
    blk.instr_cap    = 0;
    blk.phis         = nil;
    blk.phi_count    = 0;
    blk.phi_cap      = 0;
    blk.terminator   = ir_id.INSTR_NIL;
    blk.preds        = nil;
    blk.pred_count   = 0;
    blk.pred_cap     = 0;
    fn.block_count   = fn.block_count + 1;
    ret res[ir_id.BlockId, fail.Fail].ok{bid};
}

pub fun block_append_instr(m: *Module, blk: *Block, i: ir_id.InstructionId) err[fail.Fail] {
    if (blk.instr_count >= blk.instr_cap) {
        val grown: err[A.Error] = growth.reserve[ir_id.InstructionId](m.alloc, ?blk.instructions, ?blk.instr_cap, blk.instr_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    blk.instructions[blk.instr_count] = i;
    blk.instr_count                   = blk.instr_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_prepend_instr(m: *Module, blk: *Block, i: ir_id.InstructionId) err[fail.Fail] {
    ret block_insert_instr(m, blk, 0, i);
}

# `i` listed at `pos` of the block, or at its end when `pos` is past it
pub fun block_insert_instr(m: *Module, blk: *Block, pos: u32, i: ir_id.InstructionId) err[fail.Fail] {
    if (blk.instr_count >= blk.instr_cap) {
        val grown: err[A.Error] = growth.reserve[ir_id.InstructionId](m.alloc, ?blk.instructions, ?blk.instr_cap, blk.instr_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    var at: u32 = pos;
    if (at > blk.instr_count) { at = blk.instr_count; }
    var j: u32 = blk.instr_count;
    for (j > at) {
        blk.instructions[j] = blk.instructions[j - 1];
        j                   = j - 1;
    }
    blk.instructions[at] = i;
    blk.instr_count      = blk.instr_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_append_phi(m: *Module, blk: *Block, i: ir_id.InstructionId) err[fail.Fail] {
    if (blk.phi_count >= blk.phi_cap) {
        val grown: err[A.Error] = growth.reserve[ir_id.InstructionId](m.alloc, ?blk.phis, ?blk.phi_cap, blk.phi_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    blk.phis[blk.phi_count] = i;
    blk.phi_count           = blk.phi_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_append_pred(m: *Module, blk: *Block, pred: ir_id.BlockId) err[fail.Fail] {
    if (blk.pred_count >= blk.pred_cap) {
        val grown: err[A.Error] = growth.reserve[ir_id.BlockId](m.alloc, ?blk.preds, ?blk.pred_cap, blk.pred_count::usize + 1);
        if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    }
    blk.preds[blk.pred_count] = pred;
    blk.pred_count            = blk.pred_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_target_make(m: *Module, block: ir_id.BlockId) res[value.Value, fail.Fail] {
    val res_ptr_type: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel res_ptr_type.err) {
        ret res[value.Value, fail.Fail].err{res_ptr_type.err};
    }
    val ptr_type: ir_type.IrTypeId = res_ptr_type.ok;
    ret res[value.Value, fail.Fail].ok{value.const_int(ir_id.block_index(block)::u64, ptr_type)};
}

pub fun block_target(v: value.Value) ir_id.BlockId {
    ret ir_id.block(v.data.int_lit::u32);
}

# the block operand `v` made to name block `b`
pub fun block_target_set(v: *value.Value, b: ir_id.BlockId) {
    v.data.int_lit = ir_id.block_index(b)::u64;
}

pub fun block_successors(fn: *Function, blk: *Block, out0: *ir_id.BlockId, out1: *ir_id.BlockId) u32 {
    @out0 = ir_id.BLOCK_NIL;
    @out1 = ir_id.BLOCK_NIL;
    if (ir_id.instruction_is_nil(blk.terminator)) { ret 0; }
    val opt_term: opt[*ir_instruction.Instruction] = instruction_get(fn, blk.terminator);
    if (sel opt_term.none) { ret 0; }
    val term: *ir_instruction.Instruction = opt_term.some;
    var n:    u32                         = 0;
    var o:    u32                         = 0;
    for (o < term.operand_count) {
        if (opdesc.operand_role(term.kind, o) == opdesc.ROLE_CFG_EDGE) {
            if (n == 0) { @out0 = block_target(term.operands[o]); }
            or (n == 1) { @out1 = block_target(term.operands[o]); }
            n = n + 1;
        }
        o = o + 1;
    }
    ret n;
}

pub fun preds_rebuild(m: *Module, fn: *Function) err[fail.Fail] {
    if (fn.block_count == 0) { ret err[fail.Fail].ok{}; }

    val res_counts: res[*u32, A.Error] = A.allocate[u32](m.alloc, fn.block_count::usize);
    if (sel res_counts.err) { ret err[fail.Fail].err{fail.refused(res_counts.err)}; }
    val counts: *u32 = res_counts.ok;
    var i:      u32  = 0;
    for (i < fn.block_count) {
        counts[i] = 0;
        i         = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val blk:        *Block        = ?fn.blocks[i];
        var succ0:      ir_id.BlockId = ir_id.BLOCK_NIL;
        var succ1:      ir_id.BlockId = ir_id.BLOCK_NIL;
        val succ_count: u32           = block_successors(fn, blk, ?succ0, ?succ1);
        if (succ_count >= 1 && succ0::u32 < fn.block_count) { counts[succ0::u32] = counts[succ0::u32] + 1; }
        if (succ_count >= 2 && succ1::u32 < fn.block_count) { counts[succ1::u32] = counts[succ1::u32] + 1; }
        i = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val blk:   *Block       = ?fn.blocks[i];
        val grown: err[A.Error] = growth.reserve[ir_id.BlockId](m.alloc, ?blk.preds, ?blk.pred_cap, counts[i]::usize);
        if (sel grown.err) {
            A.deallocate[u32](m.alloc, counts, fn.block_count::usize);
            ret err[fail.Fail].err{fail.refused(grown.err)};
        }
        i = i + 1;
    }

    A.deallocate[u32](m.alloc, counts, fn.block_count::usize);

    i = 0;
    for (i < fn.block_count) {
        fn.blocks[i].pred_count = 0;
        i                       = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val blk:        *Block        = ?fn.blocks[i];
        var succ0:      ir_id.BlockId = ir_id.BLOCK_NIL;
        var succ1:      ir_id.BlockId = ir_id.BLOCK_NIL;
        val succ_count: u32           = block_successors(fn, blk, ?succ0, ?succ1);
        if (succ_count >= 1 && succ0::u32 < fn.block_count) {
            val t: *Block = ?fn.blocks[succ0::u32];
            t.preds[t.pred_count] = i::ir_id.BlockId;
            t.pred_count          = t.pred_count + 1;
        }
        if (succ_count >= 2 && succ1::u32 < fn.block_count) {
            val t: *Block = ?fn.blocks[succ1::u32];
            t.preds[t.pred_count] = i::ir_id.BlockId;
            t.pred_count          = t.pred_count + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

test dnit__frees_by_capacity_not_count {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val alloc: *A.Allocator = T.allocator_of(?t);

    val res_module: res[Module, fail.Fail] = init(alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: Module = res_module.ok;

    val res_i64t: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64t.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64t.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *Function = ?m.functions[res_fn.ok];

    val res_ops3: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, 3::usize);
    if (sel res_ops3.err) { ret 1; }
    val ops3: *value.Value = res_ops3.ok;
    ops3[0] = value.const_int(0, i64t);
    ops3[1] = value.const_int(0, i64t);
    ops3[2] = value.const_int(0, i64t);
    var cbr:     ir_instruction.Instruction          = ir_instruction.init(ir_instruction.OP_CBR, i64t, ops3, 3);
    val res_cbr: res[ir_id.InstructionId, fail.Fail] = instruction_add(?m, fn, cbr);
    if (sel res_cbr.err) { ret 1; }
    fn.instrs[res_cbr.ok::u32].operand_count = 1;

    val res_ops4: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, 4::usize);
    if (sel res_ops4.err) { ret 1; }
    val ops4: *value.Value = res_ops4.ok;
    var i:    u32          = 0;
    for (i < 4) {
        ops4[i] = value.const_int(0, i64t);
        i       = i + 1;
    }
    var phi:     ir_instruction.Instruction          = ir_instruction.init(ir_instruction.OP_PHI, i64t, ops4, 4);
    val res_phi: res[ir_id.InstructionId, fail.Fail] = instruction_add(?m, fn, phi);
    if (sel res_phi.err) { ret 1; }
    fn.instrs[res_phi.ok::u32].operand_count = 2;

    val res_blob: res[*u8, A.Error] = A.allocate[u8](alloc, 16::usize);
    if (sel res_blob.err) { ret 1; }
    val blob:       *u8                           = res_blob.ok;
    val res_relocs: res[*value.AggReloc, A.Error] = A.allocate[value.AggReloc](alloc, 4::usize);
    if (sel res_relocs.err) { ret 1; }
    val relocs:  *value.AggReloc = res_relocs.ok;
    val blob_p:  ptr             = blob::ptr;
    val reloc_p: ptr             = relocs::ptr;

    var gl: Global;
    gl.name        = intern.STR_NIL;
    gl.ty          = i64t;
    gl.init        = value.const_agg(blob, 16, relocs, 1, 4, i64t);
    gl.is_mut      = false;
    gl.is_pub      = false;
    gl.is_extern   = false;
    gl.is_import   = false;
    gl.is_local    = true;
    gl.is_embed    = false;
    gl.align       = 0;
    gl.section     = intern.STR_NIL;
    gl.iface       = IFACE_NONE;
    gl.iface_a     = 0;
    gl.iface_b     = 0;
    gl.iface_flags = 0;
    gl.disp        = intern.STR_NIL;
    gl.ty_sem      = type.TYPE_NIL;
    gl.decl_loc    = lang_source.location_nil();
    m.globals[0]   = gl;
    m.global_len   = 1;

    dnit(?m);

    if (T.owns(?t, blob_p) || T.owns(?t, reloc_p)) { ret 1; }
    if (!T.clean(?t))                              { ret 1; }
    ret 0;
}

test instr_replace_operands__frees_displaced_by_capacity {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?t); }
    val alloc: *A.Allocator = T.allocator_of(?t);

    val res_module: res[Module, fail.Fail] = init(alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: Module = res_module.ok;

    val res_i64t: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64t.err) { ret 1; }
    val i64t: ir_type.IrTypeId = res_i64t.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *Function = ?m.functions[res_fn.ok];

    val res_ops3: res[OperandArray, fail.Fail] = operands_alloc(?m, 3);
    if (sel res_ops3.err) { ret 1; }
    val ops3: OperandArray = res_ops3.ok;
    ops3.ops[0] = value.const_int(0, i64t);
    ops3.ops[1] = value.const_int(0, i64t);
    ops3.ops[2] = value.const_int(0, i64t);
    val displaced: ptr = ops3.ops::ptr;

    var cbr:     ir_instruction.Instruction          = ir_instruction.init(ir_instruction.OP_CBR, i64t, ops3.ops, 3);
    val res_cbr: res[ir_id.InstructionId, fail.Fail] = instruction_add(?m, fn, cbr);
    if (sel res_cbr.err) { ret 1; }
    val ins: *ir_instruction.Instruction = ?fn.instrs[res_cbr.ok::u32];

    val res_ops1: res[OperandArray, fail.Fail] = operands_alloc(?m, 1);
    if (sel res_ops1.err) { ret 1; }
    val ops1: OperandArray = res_ops1.ok;
    ops1.ops[0] = value.const_int(7, i64t);
    instr_replace_operands(?m, ins, ops1);

    if (T.owns(?t, displaced))          { ret 1; }
    if (T.size_mismatch_count(?t) != 0) { ret 1; }
    if (ins.operand_count != 1)         { ret 1; }
    if (ins.operand_cap != 1)           { ret 1; }
    if (ins.operands != ops1.ops)       { ret 1; }

    instr_replace_operands(?m, ins, ops1);
    if (!T.owns(?t, ops1.ops::ptr)) { ret 1; }
    if (ins.operands != ops1.ops)   { ret 1; }
    if (ins.operand_count != 1)     { ret 1; }
    if (ins.operand_cap != 1)       { ret 1; }

    dnit(?m);

    if (!T.clean(?t)) { ret 1; }
    ret 0;
}

test inline_site_channel__add_get_group {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: Module = rm.ok;

    val rvoid: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rvoid.err) {
        dnit(?m);
        ret 1;
    }
    val voidty: ir_type.IrTypeId                 = rvoid.ok;
    val rsig:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel rsig.err) {
        dnit(?m);
        ret 1;
    }
    val sigty:  ir_type.IrTypeId    = rsig.ok;
    val r_1354: res[u32, fail.Fail] = function_add(?m, intern.str_id(100), sigty, 0);
    if (sel r_1354.err) {
        dnit(?m);
        ret 1;
    }
    val r_1355: res[u32, fail.Fail] = function_add(?m, intern.str_id(200), sigty, 0);
    if (sel r_1355.err) {
        dnit(?m);
        ret 1;
    }
    val caller: *Function = ?m.functions[1];

    val ra: res[u32, fail.Fail] = inline_site_add(?m, caller, intern.str_id(300), lang_source.location_nil(), 0);
    if (sel ra.err) {
        dnit(?m);
        ret 1;
    }
    if (ra.ok != 1) {
        dnit(?m);
        ret 1;
    }
    val rb: res[u32, fail.Fail] = inline_site_add(?m, caller, intern.str_id(301), lang_source.location_nil(), 1);
    if (sel rb.err) {
        dnit(?m);
        ret 1;
    }
    if (rb.ok != 2) {
        dnit(?m);
        ret 1;
    }

    val g1: opt[*InlineSite] = inline_site_get(caller, 1);
    if (sel g1.none) {
        dnit(?m);
        ret 1;
    }
    if (!intern.str_same(g1.some.callee, intern.str_id(300))) {
        dnit(?m);
        ret 1;
    }
    if (g1.some.parent != 0) {
        dnit(?m);
        ret 1;
    }
    val g2: opt[*InlineSite] = inline_site_get(caller, 2);
    if (sel g2.none) {
        dnit(?m);
        ret 1;
    }
    if (g2.some.parent != 1) {
        dnit(?m);
        ret 1;
    }
    val r_1372: opt[*InlineSite] = inline_site_get(caller, 0);
    if (sel r_1372.some) {
        dnit(?m);
        ret 1;
    }
    val r_1373: opt[*InlineSite] = inline_site_get(caller, 3);
    if (sel r_1373.some) {
        dnit(?m);
        ret 1;
    }

    val r_1375: err[fail.Fail] = instr_inline_site_set(caller, ir_id.instruction(7), 2);
    if (sel r_1375.err) {
        dnit(?m);
        ret 1;
    }
    if (instr_inline_site_of(caller, ir_id.instruction(7)) != 2) {
        dnit(?m);
        ret 1;
    }
    if (instr_inline_site_of(caller, ir_id.instruction(8)) != 0) {
        dnit(?m);
        ret 1;
    }

    dnit(?m);
    ret 0;
}

test block_add__refuses_a_block_count_at_the_block_nil_sentinel {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: Module = rm.ok;

    val rvoid: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rvoid.err) {
        dnit(?m);
        ret 1;
    }
    val rsig: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, rvoid.ok, nil, 0, false);
    if (sel rsig.err) {
        dnit(?m);
        ret 1;
    }
    val sigty: ir_type.IrTypeId = rsig.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, sigty, 0);
    if (sel res_fn.err) {
        dnit(?m);
        ret 1;
    }
    val fn: *Function = ?m.functions[res_fn.ok];

    fn.block_count = 0xFFFFFFFF;
    val res_over: res[ir_id.BlockId, fail.Fail] = block_add(?m, fn);
    if (!sel res_over.err) {
        fn.block_count = 0;
        dnit(?m);
        ret 1;
    }
    if (fn.block_count != 0xFFFFFFFF) {
        dnit(?m);
        ret 1;
    }

    fn.block_count = 0;
    val res_ok: res[ir_id.BlockId, fail.Fail] = block_add(?m, fn);
    if (sel res_ok.err) {
        dnit(?m);
        ret 1;
    }
    if (!ir_id.block_same(res_ok.ok, ir_id.block(0))) {
        dnit(?m);
        ret 1;
    }

    dnit(?m);
    ret 0;
}

