}

pub rec ModuleHome {
    backing: A.Allocator;
    ar:      arena.Arena;
    alloc:   A.Allocator;
}

pub fun home_init(h: *ModuleHome) err[fail.Fail] {
    if (h == nil) { ret err[fail.Fail].err{fail.message("ir: module home is nil")}; }
    val r_208: err[A.Error] = page.make(?h.backing);
    if (sel r_208.err) { ret err[fail.Fail].err{fail.message("ir: module home backing alloc failed")}; }
    val r_209: err[A.Error] = arena.init(?h.ar, ?h.backing, 0);
    if (sel r_209.err) { ret err[fail.Fail].err{fail.message("ir: module home arena init failed")}; }
    val r_210: err[A.Error] = arena.make(?h.alloc, ?h.ar);
    if (sel r_210.err) { arena.dnit(?h.ar); ret err[fail.Fail].err{fail.message("ir: module home arena bind failed")}; }
    ret err[fail.Fail].ok{};
}

pub fun home_dnit(h: *ModuleHome) {
    if (h == nil) { ret; }
    arena.dnit(?h.ar);
}

pub rec Module {
    alloc: *A.Allocator;
    name:  intern.StrId;

    functions:    *Function;
    function_len: u32;
    function_cap: u32;

    globals:    *Global;
    global_len: u32;
    global_cap: u32;

    types: type.IrTypeTable;

    init_fn: opt[u32];

    fn_by_name:     map.Map[intern.StrId, u32];
    global_by_name: map.Map[intern.StrId, u32];

    vector_ops_scalarized: u32;
}

val INITIAL_FN_CAP:          u32 = 8;
val INITIAL_GLOBAL_CAP:      u32 = 8;
val INITIAL_INSTR_CAP:       u32 = 64;
val INITIAL_BLOCK_LIST_CAP:  u32 = 4;
val INITIAL_PHI_OPERAND_CAP: u32 = 4;
val INITIAL_DBG_EXPR_CAP:    u32 = 4;
val INITIAL_DBG_OP_CAP:      u32 = 4;
val INITIAL_INLINE_SITE_CAP: u32 = 4;

pub fun init(a: *A.Allocator, name: intern.StrId) res[Module, fail.Fail] {
    var m: Module;
    m.alloc = a;
    m.name  = name;

    m.functions    = nil;
    m.function_len = 0;
    m.function_cap = 0;
    m.globals      = nil;
    m.global_len   = 0;
    m.global_cap   = 0;
    m.init_fn      = opt[u32].none{};
    m.vector_ops_scalarized = 0;

    m.fn_by_name     = map.init[intern.StrId, u32](a, map.hash_u32, map.eq_u32);
    m.global_by_name = map.init[intern.StrId, u32](a, map.hash_u32, map.eq_u32);

    val opt_types: err[fail.Fail] = type.init(?m.types, a);
    if (sel opt_types.err) {
        ret res[Module, fail.Fail].err{opt_types.err};
    }

    val res_functions: res[*Function, A.Error] = A.allocate[Function](a, INITIAL_FN_CAP::usize);
    if (sel res_functions.err) {
        type.dnit(?m.types);
        ret res[Module, fail.Fail].err{fail.refused(res_functions.err)};
    }
    m.functions    = res_functions.ok;
    m.function_cap = INITIAL_FN_CAP;

    val res_globals: res[*Global, A.Error] = A.allocate[Global](a, INITIAL_GLOBAL_CAP::usize);
    if (sel res_globals.err) {
        A.deallocate[Function](a, m.functions, m.function_cap::usize);
        type.dnit(?m.types);
        ret res[Module, fail.Fail].err{fail.refused(res_globals.err)};
    }
    m.globals    = res_globals.ok;
    m.global_cap = INITIAL_GLOBAL_CAP;

    ret res[Module, fail.Fail].ok{m};
}

pub fun dnit(m: *Module) {
    if (m == nil) { ret; }

    var i: u32 = 0;
    for (i < m.function_len) {
        function_dnit(m, ?m.functions[i]);
        i = i + 1;
    }

    i = 0;
    for (i < m.global_len) {
        agg_value_dnit(m, ?m.globals[i].init);
        i = i + 1;
    }

    if (m.functions != nil && m.function_cap > 0) {
        A.deallocate[Function](m.alloc, m.functions, m.function_cap::usize);
    }
    if (m.globals != nil && m.global_cap > 0) {
        A.deallocate[Global](m.alloc, m.globals, m.global_cap::usize);
    }
    map.dnit[intern.StrId, u32](?m.fn_by_name);
    map.dnit[intern.StrId, u32](?m.global_by_name);
    type.dnit(?m.types);

    m.functions    = nil;
    m.function_len = 0;
    m.function_cap = 0;
    m.globals      = nil;
    m.global_len   = 0;
    m.global_cap   = 0;
    m.init_fn      = opt[u32].none{};
    m.vector_ops_scalarized = 0;
    m.name         = intern.STR_NIL;
    m.alloc        = nil;
}

pub fun function_dnit(m: *Module, fn: *Function) {
    var i: u32 = 0;
    for (i < fn.block_count) {
        block_dnit(m, ?fn.blocks[i]);
        i = i + 1;
    }
    if (fn.blocks != nil && fn.block_cap > 0) {
        A.deallocate[Block](m.alloc, fn.blocks, fn.block_cap::usize);
    }
    if (fn.params != nil && fn.param_count > 0) {
        A.deallocate[value.Value](m.alloc, fn.params, fn.param_count::usize);
    }

    i = 0;
    for (i < fn.instr_len) {
        if (fn.instrs[i].kind == instruction.OP_ASM) {
            var key: id.InstructionId = i::id.InstructionId;
            val res_asm: opt[*IrAsm] = map.get[id.InstructionId, IrAsm](?fn.asm_blocks, ?key);
            if (sel res_asm.some) {
                val asm: *IrAsm = res_asm.some;
                if (asm.binds != nil && asm.bind_cap > 0) {
                    A.deallocate[IrAsmBind](m.alloc, asm.binds, asm.bind_cap::usize);
                }
            }
        }
        instruction_dnit(m, ?fn.instrs[i]);
        i = i + 1;
    }
    if (fn.instrs != nil && fn.instr_cap > 0) {
        A.deallocate[instruction.Instruction](m.alloc, fn.instrs, fn.instr_cap::usize);
    }
    map.dnit[id.InstructionId, IrAsm](?fn.asm_blocks);
    map.dnit[id.InstructionId, DbgVar](?fn.dbg_vars);
    map.dnit[id.InstructionId, DbgVar](?fn.alloca_dbg_vars);

    var e: u32 = 0;
    for (e < fn.dbg_expr_len) {
        val dex: *DbgExpr = ?fn.dbg_exprs[e];
        if (dex.ops != nil && dex.op_cap > 0) {
            A.deallocate[DbgOp](m.alloc, dex.ops, dex.op_cap::usize);
        }
        e = e + 1;
    }
    if (fn.dbg_exprs != nil && fn.dbg_expr_cap > 0) {
        A.deallocate[DbgExpr](m.alloc, fn.dbg_exprs, fn.dbg_expr_cap::usize);
    }
    map.dnit[id.InstructionId, DbgExprId](?fn.dbg_expr_ids);

    if (fn.inline_sites != nil && fn.inline_site_cap > 0) {
        A.deallocate[InlineSite](m.alloc, fn.inline_sites, fn.inline_site_cap::usize);
    }
    map.dnit[id.InstructionId, u32](?fn.instr_inline_site);
}

fun block_dnit(m: *Module, blk: *Block) {
    if (blk.instructions != nil && blk.instr_cap > 0) {
        A.deallocate[id.InstructionId](m.alloc, blk.instructions, blk.instr_cap::usize);
    }
    if (blk.phis != nil && blk.phi_cap > 0) {
        A.deallocate[id.InstructionId](m.alloc, blk.phis, blk.phi_cap::usize);
    }
    if (blk.preds != nil && blk.pred_cap > 0) {
        A.deallocate[id.BlockId](m.alloc, blk.preds, blk.pred_cap::usize);
    }
}

fun instruction_dnit(m: *Module, inst: *instruction.Instruction) {
    if (inst.operands != nil && inst.operand_cap > 0) {
        A.deallocate[value.Value](m.alloc, inst.operands, inst.operand_cap::usize);
    }
}

fun agg_value_dnit(m: *Module, v: *value.Value) {
    if (v.kind != value.VAL_CONST_AGG) { ret; }
    if (v.data.agg.bytes != nil && v.data.agg.len > 0) {
        A.deallocate[u8](m.alloc, v.data.agg.bytes, v.data.agg.len::usize);
    }
    if (v.data.agg.relocs != nil && v.data.agg.reloc_cap > 0) {
        A.deallocate[value.AggReloc](m.alloc, v.data.agg.relocs, v.data.agg.reloc_cap::usize);
    }
}

pub fun function_new(alloc: *A.Allocator, name: intern.StrId, sig: type.IrTypeId, flags: u32) Function {
    var f: Function;
    f.name        = name;
    f.body_module = intern.STR_NIL;
    f.sig         = sig;
    f.params      = nil;
    f.param_count = 0;
    f.blocks      = nil;
    f.block_count = 0;
    f.block_cap   = 0;
    f.instrs      = nil;
    f.instr_len   = 0;
    f.instr_cap   = 0;
    f.flags       = flags;
    f.is_import   = false;
    f.label       = intern.STR_NIL;
    f.line        = 0;
    f.section     = intern.STR_NIL;
    f.stage       = STAGE_NONE;
    f.wg_x        = 1;
    f.wg_y        = 1;
    f.wg_z        = 1;
    f.op_set      = definition.NO_OP_SET;
    f.op_code     = definition.NO_OPCODE;
    f.disp        = intern.STR_NIL;
    f.ret_sem     = semtype.TYPE_NIL;
    f.asm_blocks  = map.init[id.InstructionId, IrAsm](alloc, map.hash_u32, map.eq_u32);
    f.dbg_vars    = map.init[id.InstructionId, DbgVar](alloc, map.hash_u32, map.eq_u32);
    f.dbg_exprs    = nil;
    f.dbg_expr_len = 0;
    f.dbg_expr_cap = 0;
    f.dbg_expr_ids = map.init[id.InstructionId, DbgExprId](alloc, map.hash_u32, map.eq_u32);
    f.alloca_dbg_vars = map.init[id.InstructionId, DbgVar](alloc, map.hash_u32, map.eq_u32);
    f.inline_sites      = nil;
    f.inline_site_len   = 0;
    f.inline_site_cap   = 0;
    f.instr_inline_site = map.init[id.InstructionId, u32](alloc, map.hash_u32, map.eq_u32);
    ret f;
}

fun grow_cap[T](alloc: *A.Allocator, data: **T, cap: *u32, initial: u32) err[fail.Fail] {
    if (@data == nil) {
        val res_alloc: res[*T, A.Error] = A.allocate[T](alloc, initial::usize);
        if (sel res_alloc.err) { ret err[fail.Fail].err{fail.refused(res_alloc.err)}; }
        @data = res_alloc.ok;
        @cap  = initial;
        ret err[fail.Fail].ok{};
    }
    val current: layout.CheckedCount[T] = layout.count[T]((@cap)::usize);
    val required_r: res[layout.CheckedCount[T], layout.CheckCause] =
        layout.count_add[T](current, layout.count[T](1::usize));
    if (sel required_r.err) {
        ret err[fail.Fail].err{fail.message("ir: growth count overflow")};
    }
    val required: layout.CheckedCount[T] = required_r.ok;
    val grown_r: res[layout.CheckedCount[T], layout.CheckCause] = layout.count_grow[T](current, required);
    if (sel grown_r.err) {
        ret err[fail.Fail].err{fail.message("ir: growth count overflow")};
    }
    val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
        grown_r.ok.value);
    if (sel new_cap_fits.err) {
        ret err[fail.Fail].err{fail.message("ir: growth capacity exceeds the u32 limit")};
    }
    val new_cap: u32 = new_cap_fits.ok;
    val res_realloc: res[*T, A.Error] = A.reallocate[T](alloc, @data, (@cap)::usize, new_cap::usize);
    if (sel res_realloc.err) { ret err[fail.Fail].err{fail.refused(res_realloc.err)}; }
    @data = res_realloc.ok;
    @cap  = new_cap;
    ret err[fail.Fail].ok{};
}

pub fun function_add(m: *Module, name: intern.StrId, sig: type.IrTypeId, flags: u32) res[u32, fail.Fail] {
    if (m.function_len == m.function_cap) {
        val grown: err[fail.Fail] = grow_cap[Function](m.alloc, ?m.functions, ?m.function_cap, INITIAL_FN_CAP);
        if (sel grown.err) { ret res[u32, fail.Fail].err{grown.err}; }
    }
    val idx: u32 = m.function_len;
    m.functions[idx] = function_new(m.alloc, name, sig, flags);
    m.function_len   = m.function_len + 1;
    ret res[u32, fail.Fail].ok{idx};
}

pub fun function_register(m: *Module, name: intern.StrId, idx: u32) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[intern.StrId, u32](?m.fn_by_name, name, idx);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}


pub fun function_lookup(m: *Module, name: intern.StrId) opt[u32] {
    var key: intern.StrId = name;
    val res_idx: opt[*u32] = map.get[intern.StrId, u32](?m.fn_by_name, ?key);
    if (sel res_idx.some) { ret opt[u32].some{@res_idx.some}; }
    ret opt[u32].none{};
}

pub fun global_register(m: *Module, name: intern.StrId, idx: u32) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[intern.StrId, u32](?m.global_by_name, name, idx);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun global_lookup(m: *Module, name: intern.StrId) opt[u32] {
    var key: intern.StrId = name;
    val res_idx: opt[*u32] = map.get[intern.StrId, u32](?m.global_by_name, ?key);
    if (sel res_idx.some) { ret opt[u32].some{@res_idx.some}; }
    ret opt[u32].none{};
}

pub fun instruction_get(fn: *Function, i: id.InstructionId) opt[*instruction.Instruction] {
    if (i == id.INSTR_NIL)      { ret opt[*instruction.Instruction].none{}; }
    if (i::u32 >= fn.instr_len) { ret opt[*instruction.Instruction].none{}; }
    ret opt[*instruction.Instruction].some{?fn.instrs[i::u32]};
}

rec InstructionIdDomain {
}

pub fun instruction_add(m: *Module, fn: *Function, inst: instruction.Instruction) res[id.InstructionId, fail.Fail] {
    if (fn.instr_len >= fn.instr_cap) {
        val grown: err[fail.Fail] = grow_cap[instruction.Instruction](m.alloc, ?fn.instrs, ?fn.instr_cap, INITIAL_INSTR_CAP);
        if (sel grown.err) { ret res[id.InstructionId, fail.Fail].err{grown.err}; }
    }
    val checked_id: res[layout.CheckedId[InstructionIdDomain], layout.CheckCause] =
        layout.id_below[InstructionIdDomain](fn.instr_len::usize, layout.count[InstructionIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[id.InstructionId, fail.Fail].err{fail.message("ir: instruction id exhausts its 32-bit domain")};
    }
    val iid: id.InstructionId = checked_id.ok.value::u32;
    fn.instrs[fn.instr_len] = inst;
    fn.instr_len = fn.instr_len + 1;
    ret res[id.InstructionId, fail.Fail].ok{iid};
}

pub rec OperandArray {
    ops: *value.Value;
    len: u32;
}

pub fun operands_alloc(m: *Module, n: u32) res[OperandArray, fail.Fail] {
    var arr: OperandArray;
    arr.ops = nil;
    arr.len = n;
    if (n == 0) { ret res[OperandArray, fail.Fail].ok{arr}; }

    val res_: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, n::usize);
    if (sel res_.err) { ret res[OperandArray, fail.Fail].err{fail.refused(res_.err)}; }
    arr.ops = res_.ok;
    ret res[OperandArray, fail.Fail].ok{arr};
}

pub fun instr_replace_operands(m: *Module, ins: *instruction.Instruction, arr: OperandArray) {
    if (ins.operands != nil && ins.operand_cap > 0 && ins.operands != arr.ops) {
        A.deallocate[value.Value](m.alloc, ins.operands, ins.operand_cap::usize);
    }
    ins.operands      = arr.ops;
    ins.operand_count = arr.len;
    ins.operand_cap   = arr.len;
}

pub fun phi_append_incoming(m: *Module, phi: *instruction.Instruction, pred: id.BlockId, incoming: value.Value) err[fail.Fail] {
    val res_target: res[value.Value, fail.Fail] = block_target_make(m, pred);
    if (sel res_target.err) {
        ret err[fail.Fail].err{res_target.err};
    }

    val needed_r: res[layout.CheckedCount[value.Value], layout.CheckCause] =
        layout.count_add[value.Value](layout.count[value.Value](phi.operand_count::usize),
                                       layout.count[value.Value](2::usize));
    if (sel needed_r.err) {
        ret err[fail.Fail].err{fail.message("ir: phi operand count overflow")};
    }
    val needed_c: layout.CheckedCount[value.Value] = needed_r.ok;
    if (needed_c.value > phi.operand_cap::usize) {
        var base_cap: usize = INITIAL_PHI_OPERAND_CAP::usize;
        if (phi.operand_cap::usize > base_cap) { base_cap = phi.operand_cap::usize; }
        val grown_r: res[layout.CheckedCount[value.Value], layout.CheckCause] =
            layout.count_grow[value.Value](layout.count[value.Value](base_cap), needed_c);
        if (sel grown_r.err) {
            ret err[fail.Fail].err{fail.message("ir: phi operand growth capacity overflow")};
        }
        val new_cap_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(
            grown_r.ok.value);
        if (sel new_cap_fits.err) {
            ret err[fail.Fail].err{fail.message("ir: phi operand capacity exceeds the u32 limit")};
        }
        val new_cap: u32 = new_cap_fits.ok;
        val res_grow: res[*value.Value, A.Error] =
            A.reallocate[value.Value](m.alloc, phi.operands, phi.operand_cap::usize, new_cap::usize);
        if (sel res_grow.err) {
            ret err[fail.Fail].err{fail.refused(res_grow.err)};
        }
        phi.operands    = res_grow.ok;
        phi.operand_cap = new_cap;
    }
    val needed_fits: res[u32, layout.CheckCause] = layout.usize_to_u32(needed_c.value);
    if (sel needed_fits.err) {
        ret err[fail.Fail].err{fail.message("ir: phi operand count exceeds the u32 limit")};
    }
    val needed: u32 = needed_fits.ok;
    phi.operands[phi.operand_count]     = res_target.ok;
    phi.operands[phi.operand_count + 1] = incoming;
    phi.operand_count = needed;
    ret err[fail.Fail].ok{};
}

pub fun asm_get(fn: *Function, iid: id.InstructionId) opt[*IrAsm] {
    var key: id.InstructionId = iid;
    val res_: opt[*IrAsm] = map.get[id.InstructionId, IrAsm](?fn.asm_blocks, ?key);
    if (sel res_.none) { ret opt[*IrAsm].none{}; }
    ret opt[*IrAsm].some{res_.some};
}

pub fun dbg_var_get(fn: *Function, iid: id.InstructionId) opt[*DbgVar] {
    var key: id.InstructionId = iid;
    val res_: opt[*DbgVar] = map.get[id.InstructionId, DbgVar](?fn.dbg_vars, ?key);
    if (sel res_.none) { ret opt[*DbgVar].none{}; }
    ret opt[*DbgVar].some{res_.some};
}

pub fun record_alloca_dbg_var(fn: *Function, alloca_id: id.InstructionId, dv: DbgVar) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[id.InstructionId, DbgVar](?fn.alloca_dbg_vars, alloca_id, dv);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun alloca_dbg_var_get(fn: *Function, alloca_id: id.InstructionId) opt[*DbgVar] {
    var key: id.InstructionId = alloca_id;
    val res_: opt[*DbgVar] = map.get[id.InstructionId, DbgVar](?fn.alloca_dbg_vars, ?key);
    if (sel res_.none) { ret opt[*DbgVar].none{}; }
    ret opt[*DbgVar].some{res_.some};
}

pub fun clone_alloca_dbg_var(src_fn: *Function, dst_fn: *Function, src_iid: id.InstructionId, dst_iid: id.InstructionId) err[fail.Fail] {
    val odv: opt[*DbgVar] = alloca_dbg_var_get(src_fn, src_iid);
    if (sel odv.none) { ret err[fail.Fail].ok{}; }
    val dv: DbgVar = @odv.some;
    ret record_alloca_dbg_var(dst_fn, dst_iid, dv);
}

pub fun dbg_value_const(fn: *Function, iid: id.InstructionId) opt[i64] {
    val gi: opt[*instruction.Instruction] = instruction_get(fn, iid);
    if (sel gi.none) { ret opt[i64].none{}; }
    val inst: *instruction.Instruction = gi.some;
    if (inst.operand_count == 0) { ret opt[i64].none{}; }
    val op: *value.Value = ?inst.operands[0];
    if (op.kind != value.VAL_CONST_INT) { ret opt[i64].none{}; }
    ret opt[i64].some{op.data.int_lit::i64};
}

pub fun dbg_expr_id(fn: *Function, iid: id.InstructionId) DbgExprId {
    var key: id.InstructionId = iid;
    val res_: opt[*DbgExprId] = map.get[id.InstructionId, DbgExprId](?fn.dbg_expr_ids, ?key);
    if (sel res_.none) { ret DBG_EXPR_IDENTITY; }
    val p: *DbgExprId = res_.some;
    ret @p;
}

pub fun dbg_expr_get(fn: *Function, eid: DbgExprId) opt[*DbgExpr] {
    if (eid == DBG_EXPR_IDENTITY) { ret opt[*DbgExpr].none{}; }
    val idx: u32 = eid::u32 - 1;
    if (idx >= fn.dbg_expr_len)   { ret opt[*DbgExpr].none{}; }
    ret opt[*DbgExpr].some{?fn.dbg_exprs[idx]};
}

pub fun dbg_expr_new(m: *Module, fn: *Function, iid: id.InstructionId) res[DbgExprId, fail.Fail] {
    if (fn.dbg_expr_len >= fn.dbg_expr_cap) {
        val grown: err[fail.Fail] = grow_cap[DbgExpr](m.alloc, ?fn.dbg_exprs, ?fn.dbg_expr_cap, INITIAL_DBG_EXPR_CAP);
        if (sel grown.err) { ret res[DbgExprId, fail.Fail].err{grown.err}; }
    }
    val idx: u32 = fn.dbg_expr_len;
    fn.dbg_exprs[idx].ops      = nil;
    fn.dbg_exprs[idx].op_count = 0;
    fn.dbg_exprs[idx].op_cap   = 0;

    val eid: DbgExprId = (idx + 1)::DbgExprId;
    val res_ins: res[bool, A.Error] = map.insert[id.InstructionId, DbgExprId](?fn.dbg_expr_ids, iid, eid);
    if (sel res_ins.err) {
        ret res[DbgExprId, fail.Fail].err{fail.refused(res_ins.err)};
    }
    fn.dbg_expr_len = fn.dbg_expr_len + 1;
    ret res[DbgExprId, fail.Fail].ok{eid};
}

pub fun dbg_expr_prepend_op(m: *Module, fn: *Function, eid: DbgExprId, op: DbgOp) err[fail.Fail] {
    val opt_: opt[*DbgExpr] = dbg_expr_get(fn, eid);
    if (sel opt_.none) { ret err[fail.Fail].err{fail.message("dbg_expr_prepend_op: invalid expression id")}; }
    val dex: *DbgExpr = opt_.some;

    if (dex.op_count >= dex.op_cap) {
        val grown: err[fail.Fail] = grow_cap[DbgOp](m.alloc, ?dex.ops, ?dex.op_cap, INITIAL_DBG_OP_CAP);
        if (sel grown.err) { ret grown; }
    }

    var i: u32 = dex.op_count;
    for (i > 0) {
        dex.ops[i] = dex.ops[i - 1];
        i = i - 1;
    }
    dex.ops[0]   = op;
    dex.op_count = dex.op_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun inline_site_add(m: *Module, fn: *Function, callee: intern.StrId, call_loc: source.SrcLoc, parent: u32) res[u32, fail.Fail] {
    if (fn.inline_site_len >= fn.inline_site_cap) {
        val grown: err[fail.Fail] = grow_cap[InlineSite](m.alloc, ?fn.inline_sites, ?fn.inline_site_cap, INITIAL_INLINE_SITE_CAP);
        if (sel grown.err) { ret res[u32, fail.Fail].err{grown.err}; }
    }
    val idx: u32 = fn.inline_site_len;
    fn.inline_sites[idx].callee   = callee;
    fn.inline_sites[idx].call_loc = call_loc;
    fn.inline_sites[idx].parent   = parent;
    fn.inline_site_len = fn.inline_site_len + 1;
    ret res[u32, fail.Fail].ok{idx + 1};
}

pub fun inline_site_get(fn: *Function, site: u32) opt[*InlineSite] {
    if (site == 0 || site > fn.inline_site_len) { ret opt[*InlineSite].none{}; }
    ret opt[*InlineSite].some{?fn.inline_sites[site - 1]};
}

pub fun instr_inline_site_set(fn: *Function, iid: id.InstructionId, site: u32) err[fail.Fail] {
    val inserted: res[bool, A.Error] = map.insert[id.InstructionId, u32](?fn.instr_inline_site, iid, site);
    if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun instr_inline_site_of(fn: *Function, iid: id.InstructionId) u32 {
    var key: id.InstructionId = iid;
    val res_: opt[*u32] = map.get[id.InstructionId, u32](?fn.instr_inline_site, ?key);
    if (sel res_.none) { ret 0; }
    ret @res_.some;
}

pub fun clone_instr_inline_site(src_fn: *Function, dst_fn: *Function, src_iid: id.InstructionId, dst_iid: id.InstructionId) err[fail.Fail] {
    val site: u32 = instr_inline_site_of(src_fn, src_iid);
    if (site == 0) { ret err[fail.Fail].ok{}; }
    ret instr_inline_site_set(dst_fn, dst_iid, site);
}

pub fun clone_dbg_metadata(m: *Module, src_fn: *Function, dst_fn: *Function, src_iid: id.InstructionId, dst_iid: id.InstructionId) err[fail.Fail] {
    val odv: opt[*DbgVar] = dbg_var_get(src_fn, src_iid);
    if (sel odv.none) { ret err[fail.Fail].ok{}; }
    var dv: DbgVar = @odv.some;

    val seid: DbgExprId = dbg_expr_id(src_fn, src_iid);
    val ose: opt[*DbgExpr] = dbg_expr_get(src_fn, seid);
    if (sel ose.none) {
        val inserted: res[bool, A.Error] = map.insert[id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv);
        if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
        ret err[fail.Fail].ok{};
    }
    val se0: *DbgExpr = ose.some;
    val n: u32 = se0.op_count;
    if (n == 0) {
        val inserted: res[bool, A.Error] = map.insert[id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv);
        if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
        ret err[fail.Fail].ok{};
    }

    val rsnap: res[*DbgOp, A.Error] = A.allocate[DbgOp](m.alloc, n::usize);
    if (sel rsnap.err) { ret err[fail.Fail].err{fail.refused(rsnap.err)}; }
    val snap: *DbgOp = rsnap.ok;
    memory.copy[DbgOp](snap, se0.ops, n::usize);

    val ri: res[bool, A.Error] = map.insert[id.InstructionId, DbgVar](?dst_fn.dbg_vars, dst_iid, dv);
    if (sel ri.err) { A.deallocate[DbgOp](m.alloc, snap, n::usize); ret err[fail.Fail].err{fail.refused(ri.err)}; }

    val rne: res[DbgExprId, fail.Fail] = dbg_expr_new(m, dst_fn, dst_iid);
    if (sel rne.err) { A.deallocate[DbgOp](m.alloc, snap, n::usize); ret err[fail.Fail].err{rne.err}; }
    val deid: DbgExprId = rne.ok;
    var j: u32 = n;
    for (j > 0) {
        val rp: err[fail.Fail] = dbg_expr_prepend_op(m, dst_fn, deid, snap[j - 1]);
        if (sel rp.err) { A.deallocate[DbgOp](m.alloc, snap, n::usize); ret rp; }
        j = j - 1;
    }
    A.deallocate[DbgOp](m.alloc, snap, n::usize);
    ret err[fail.Fail].ok{};
}

pub fun clone_asm_payload(m: *Module, src_fn: *Function, dst_fn: *Function,
                          src_iid: id.InstructionId, dst_iid: id.InstructionId,
                          instr_map: *u32, map_len: u32) err[fail.Fail] {
    var key: id.InstructionId = src_iid;
    val res_: opt[*IrAsm] = map.get[id.InstructionId, IrAsm](?src_fn.asm_blocks, ?key);
    if (sel res_.none) { ret err[fail.Fail].ok{}; }
    val src: *IrAsm = res_.some;

    var dst: IrAsm;
    dst.isa        = src.isa;
    dst.body       = src.body;
    dst.binds      = nil;
    dst.bind_count = 0;
    dst.bind_cap   = 0;

    if (src.bind_count > 0) {
        val rb: res[*IrAsmBind, A.Error] = A.allocate[IrAsmBind](m.alloc, src.bind_count::usize);
        if (sel rb.err) { ret err[fail.Fail].err{fail.refused(rb.err)}; }
        dst.binds      = rb.ok;
        dst.bind_cap   = src.bind_count;
        dst.bind_count = src.bind_count;

        var i: u32 = 0;
        for (i < src.bind_count) {
            dst.binds[i] = src.binds[i];
            if (instr_map != nil) {
                val old: u32 = src.binds[i].instr::u32;
                if (old >= map_len) {
                    A.deallocate[IrAsmBind](m.alloc, dst.binds, dst.bind_cap::usize);
                    ret err[fail.Fail].err{fail.message("internal compiler error: inline-asm '{name}' binding names an instruction outside the cloned callee")};
                }
                dst.binds[i].instr = instr_map[old]::id.InstructionId;
            }
            i = i + 1;
        }
    }

    var existing_key: id.InstructionId = dst_iid;
    val res_existing: opt[*IrAsm] = map.get[id.InstructionId, IrAsm](?dst_fn.asm_blocks, ?existing_key);
    if (sel res_existing.some) {
        val old: *IrAsm = res_existing.some;
        if (old.binds != nil && old.bind_cap > 0) {
            A.deallocate[IrAsmBind](m.alloc, old.binds, old.bind_cap::usize);
        }
    }

    val ri: res[bool, A.Error] = map.insert[id.InstructionId, IrAsm](?dst_fn.asm_blocks, dst_iid, dst);
    if (sel ri.err) {
        if (dst.binds != nil) { A.deallocate[IrAsmBind](m.alloc, dst.binds, dst.bind_cap::usize); }
        if (sel ri.err) { ret err[fail.Fail].err{fail.refused(ri.err)}; }
        ret err[fail.Fail].ok{};
    }
    ret err[fail.Fail].ok{};
}

rec BlockIdDomain {
}

pub fun block_add(m: *Module, fn: *Function) res[id.BlockId, fail.Fail] {
    if (fn.block_count >= fn.block_cap) {
        val grown: err[fail.Fail] = grow_cap[Block](m.alloc, ?fn.blocks, ?fn.block_cap, INITIAL_BLOCK_LIST_CAP);
        if (sel grown.err) { ret res[id.BlockId, fail.Fail].err{grown.err}; }
    }
    val checked_id: res[layout.CheckedId[BlockIdDomain], layout.CheckCause] =
        layout.id_below[BlockIdDomain](fn.block_count::usize, layout.count[BlockIdDomain](0xFFFFFFFF::usize));
    if (sel checked_id.err) {
        ret res[id.BlockId, fail.Fail].err{fail.message("ir: block id exhausts its 32-bit domain")};
    }
    val bid: id.BlockId = checked_id.ok.value::u32;
    var blk: *Block = ?fn.blocks[fn.block_count];
    blk.id           = bid;
    blk.instructions = nil;
    blk.instr_count  = 0;
    blk.instr_cap    = 0;
    blk.phis         = nil;
    blk.phi_count    = 0;
    blk.phi_cap      = 0;
    blk.terminator   = id.INSTR_NIL;
    blk.preds        = nil;
    blk.pred_count   = 0;
    blk.pred_cap     = 0;
    fn.block_count = fn.block_count + 1;
    ret res[id.BlockId, fail.Fail].ok{bid};
}

pub fun block_append_instr(m: *Module, blk: *Block, i: id.InstructionId) err[fail.Fail] {
    if (blk.instr_count >= blk.instr_cap) {
        val grown: err[fail.Fail] = grow_cap[id.InstructionId](m.alloc, ?blk.instructions, ?blk.instr_cap, INITIAL_BLOCK_LIST_CAP);
        if (sel grown.err) { ret grown; }
    }
    blk.instructions[blk.instr_count] = i;
    blk.instr_count = blk.instr_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_prepend_instr(m: *Module, blk: *Block, i: id.InstructionId) err[fail.Fail] {
    if (blk.instr_count >= blk.instr_cap) {
        val grown: err[fail.Fail] = grow_cap[id.InstructionId](m.alloc, ?blk.instructions, ?blk.instr_cap, INITIAL_BLOCK_LIST_CAP);
        if (sel grown.err) { ret grown; }
    }
    var j: u32 = blk.instr_count;
    for (j > 0) {
        blk.instructions[j] = blk.instructions[j - 1];
        j = j - 1;
    }
    blk.instructions[0] = i;
    blk.instr_count = blk.instr_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_append_phi(m: *Module, blk: *Block, i: id.InstructionId) err[fail.Fail] {
    if (blk.phi_count >= blk.phi_cap) {
        val grown: err[fail.Fail] = grow_cap[id.InstructionId](m.alloc, ?blk.phis, ?blk.phi_cap, INITIAL_BLOCK_LIST_CAP);
        if (sel grown.err) { ret grown; }
    }
    blk.phis[blk.phi_count] = i;
    blk.phi_count = blk.phi_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_append_pred(m: *Module, blk: *Block, pred: id.BlockId) err[fail.Fail] {
    if (blk.pred_count >= blk.pred_cap) {
        val grown: err[fail.Fail] = grow_cap[id.BlockId](m.alloc, ?blk.preds, ?blk.pred_cap, INITIAL_BLOCK_LIST_CAP);
        if (sel grown.err) { ret grown; }
    }
    blk.preds[blk.pred_count] = pred;
    blk.pred_count = blk.pred_count + 1;
    ret err[fail.Fail].ok{};
}

pub fun block_target_make(m: *Module, block: id.BlockId) res[value.Value, fail.Fail] {
    val res_ptr_type: res[type.IrTypeId, fail.Fail] = type.intern_ptr(?m.types);
    if (sel res_ptr_type.err) {
        ret res[value.Value, fail.Fail].err{res_ptr_type.err};
    }
    val ptr_type: type.IrTypeId = res_ptr_type.ok;
    ret res[value.Value, fail.Fail].ok{value.const_int(block::u64, ptr_type)};
}

pub fun block_target(v: value.Value) id.BlockId {
    ret v.data.int_lit::id.BlockId;
}

pub fun block_successors(fn: *Function, blk: *Block, out0: *id.BlockId, out1: *id.BlockId) u32 {
    @out0 = id.BLOCK_NIL;
    @out1 = id.BLOCK_NIL;
    if (blk.terminator == id.INSTR_NIL) { ret 0; }
    val opt_term: opt[*instruction.Instruction] = instruction_get(fn, blk.terminator);
    if (sel opt_term.none) { ret 0; }
    val term: *instruction.Instruction = opt_term.some;
    var n: u32 = 0;
    var o: u32 = 0;
    for (o < term.operand_count) {
        if (opdesc.operand_role(term.kind, o) == opdesc.ROLE_CFG_EDGE) {
            if (n == 0) { @out0 = block_target(term.operands[o]); }
            or (n == 1) { @out1 = block_target(term.operands[o]); }
            n = n + 1;
        }
        o = o + 1;
    }
    ret n;
}

pub fun preds_rebuild(m: *Module, fn: *Function) err[fail.Fail] {
    if (fn.block_count == 0) { ret err[fail.Fail].ok{}; }

    val res_counts: res[*u32, A.Error] = A.allocate[u32](m.alloc, fn.block_count::usize);
    if (sel res_counts.err) { ret err[fail.Fail].err{fail.refused(res_counts.err)}; }
    val counts: *u32 = res_counts.ok;
    var i: u32 = 0;
    for (i < fn.block_count) { counts[i] = 0; i = i + 1; }

    i = 0;
    for (i < fn.block_count) {
        val blk: *Block = ?fn.blocks[i];
        var succ0: id.BlockId = id.BLOCK_NIL;
        var succ1: id.BlockId = id.BLOCK_NIL;
        val succ_count: u32 = block_successors(fn, blk, ?succ0, ?succ1);
        if (succ_count >= 1 && succ0::u32 < fn.block_count) { counts[succ0::u32] = counts[succ0::u32] + 1; }
        if (succ_count >= 2 && succ1::u32 < fn.block_count) { counts[succ1::u32] = counts[succ1::u32] + 1; }
        i = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val blk: *Block = ?fn.blocks[i];
        if (counts[i] > blk.pred_cap) {
            val res_grow: res[*id.BlockId, A.Error] =
                A.reallocate[id.BlockId](m.alloc, blk.preds, blk.pred_cap::usize, counts[i]::usize);
            if (sel res_grow.err) {
                A.deallocate[u32](m.alloc, counts, fn.block_count::usize);
                ret err[fail.Fail].err{fail.refused(res_grow.err)};
            }
            blk.preds    = res_grow.ok;
            blk.pred_cap = counts[i];
        }
        i = i + 1;
    }

    A.deallocate[u32](m.alloc, counts, fn.block_count::usize);

    i = 0;
    for (i < fn.block_count) {
        fn.blocks[i].pred_count = 0;
        i = i + 1;
    }

    i = 0;
    for (i < fn.block_count) {
        val blk: *Block = ?fn.blocks[i];
        var succ0: id.BlockId = id.BLOCK_NIL;
        var succ1: id.BlockId = id.BLOCK_NIL;
        val succ_count: u32 = block_successors(fn, blk, ?succ0, ?succ1);
        if (succ_count >= 1 && succ0::u32 < fn.block_count) {
            val t: *Block = ?fn.blocks[succ0::u32];
            t.preds[t.pred_count] = i::id.BlockId;
            t.pred_count = t.pred_count + 1;
        }
        if (succ_count >= 2 && succ1::u32 < fn.block_count) {
            val t: *Block = ?fn.blocks[succ1::u32];
            t.preds[t.pred_count] = i::id.BlockId;
            t.pred_count = t.pred_count + 1;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

rec TrackEntry {
    p:    ptr;
    size: usize;
    live: bool;
}

rec Tracker {
    entries:  *TrackEntry;
    cap:      u32;
    count:    u32;
    live:     u32;
    mismatch: bool;
    overflow: bool;
}

fun track_record(t: *Tracker, p: ptr, size: usize) {
    if (t.count >= t.cap) { t.overflow = true; ret; }
    t.entries[t.count].p    = p;
    t.entries[t.count].size = size;
    t.entries[t.count].live = true;
    t.count = t.count + 1;
    t.live  = t.live + 1;
}

fun track_find(t: *Tracker, p: ptr) i64 {
    var i: u32 = 0;
    for (i < t.count) {
        if (t.entries[i].live && t.entries[i].p == p) { ret i::i64; }
        i = i + 1;
    }
    ret 0 - 1;
}

fun track_is_freed(t: *Tracker, p: ptr) bool {
    var i: u32 = 0;
    for (i < t.count) {
        if (t.entries[i].p == p && t.entries[i].live == false) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun track_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    if (size == 0) { ret opt[ptr].some{nil}; }
    val t: *Tracker = ctx::*Tracker;
    val p: ptr = os.allocate(size);
    if (p == nil) { ret opt[ptr].none{}; }
    track_record(t, p, size);
    ret opt[ptr].some{p};
}

fun track_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    if (p == nil || size == 0) { ret 0; }
    val t: *Tracker = ctx::*Tracker;
    val idx: i64 = track_find(t, p);
    if (idx < 0)                          { t.mismatch = true; ret 0; }
    if (t.entries[idx::u32].size != size) { t.mismatch = true; }
    t.entries[idx::u32].live = false;
    t.live = t.live - 1;
    ret os.deallocate(p, size);
}

fun track_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    if (p == nil) { ret track_allocate(ctx, new_size, align); }
    if (new_size == 0) {
        track_deallocate(ctx, p, old_size, align);
        ret opt[ptr].some{nil};
    }
    val t: *Tracker = ctx::*Tracker;
    val idx: i64 = track_find(t, p);
    if (idx < 0)                                   { t.mismatch = true; }
    or { if (t.entries[idx::u32].size != old_size) { t.mismatch = true; } }
    val np: ptr = os.reallocate(p, old_size, new_size);
    if (np == nil) { ret opt[ptr].none{}; }
    if (idx < 0)   { track_record(t, np, new_size); }
    or {
        t.entries[idx::u32].p    = np;
        t.entries[idx::u32].size = new_size;
    }
    ret opt[ptr].some{np};
}

test "mach.lang.me.ir.dnit:frees_by_capacity_not_count" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: Tracker;
    val res_entries: res[*TrackEntry, A.Error] = A.allocate[TrackEntry](?page_alloc, 8192::usize);
    if (sel res_entries.err) { ret 1; }
    tracker.entries  = res_entries.ok;
    tracker.cap      = 8192;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;
    tracker.overflow = false;

    var tp: *Tracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = track_allocate;
    alloc.fn_reallocate = track_reallocate;
    alloc.fn_deallocate = track_deallocate;

    val res_module: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: Module = res_module.ok;

    val res_i64t: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64t.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64t.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *Function = ?m.functions[res_fn.ok];

    val res_ops3: res[*value.Value, A.Error] = A.allocate[value.Value](?alloc, 3::usize);
    if (sel res_ops3.err) { ret 1; }
    val ops3: *value.Value = res_ops3.ok;
    ops3[0] = value.const_int(0, i64t);
    ops3[1] = value.const_int(0, i64t);
    ops3[2] = value.const_int(0, i64t);
    var cbr: instruction.Instruction;
    cbr.kind          = instruction.OP_CBR;
    cbr.ty            = i64t;
    cbr.operands      = ops3;
    cbr.operand_count = 3;
    cbr.operand_cap   = 3;
    cbr.flags         = 0;
    cbr.aux_ty        = type.IRT_NIL;
    val res_cbr: res[id.InstructionId, fail.Fail] = instruction_add(?m, fn, cbr);
    if (sel res_cbr.err) { ret 1; }
    fn.instrs[res_cbr.ok::u32].operand_count = 1;

    val res_ops4: res[*value.Value, A.Error] = A.allocate[value.Value](?alloc, 4::usize);
    if (sel res_ops4.err) { ret 1; }
    val ops4: *value.Value = res_ops4.ok;
    var i: u32 = 0;
    for (i < 4) { ops4[i] = value.const_int(0, i64t); i = i + 1; }
    var phi: instruction.Instruction;
    phi.kind          = instruction.OP_PHI;
    phi.ty            = i64t;
    phi.operands      = ops4;
    phi.operand_count = 4;
    phi.operand_cap   = 4;
    phi.flags         = 0;
    phi.aux_ty        = type.IRT_NIL;
    val res_phi: res[id.InstructionId, fail.Fail] = instruction_add(?m, fn, phi);
    if (sel res_phi.err) { ret 1; }
    fn.instrs[res_phi.ok::u32].operand_count = 2;

    val res_blob: res[*u8, A.Error] = A.allocate[u8](?alloc, 16::usize);
    if (sel res_blob.err) { ret 1; }
    val blob: *u8 = res_blob.ok;
    val res_relocs: res[*value.AggReloc, A.Error] = A.allocate[value.AggReloc](?alloc, 4::usize);
    if (sel res_relocs.err) { ret 1; }
    val relocs: *value.AggReloc = res_relocs.ok;
    val blob_p:  ptr = blob::ptr;
    val reloc_p: ptr = relocs::ptr;

    var gl: Global;
    gl.name      = intern.STR_NIL;
    gl.ty        = i64t;
    gl.init      = value.const_agg(blob, 16, relocs, 1, 4, i64t);
    gl.is_mut    = false;
    gl.is_pub    = false;
    gl.is_extern = false;
    gl.is_import = false;
    gl.is_local  = true;
    gl.is_embed  = false;
    gl.align     = 0;
    gl.section   = intern.STR_NIL;
    gl.iface     = IFACE_NONE;
    gl.iface_a   = 0;
    gl.iface_b   = 0;
    gl.iface_flags = 0;
    m.globals[0] = gl;
    m.global_len = 1;

    dnit(?m);

    if (tracker.overflow) { ret 1; }
    if (tracker.mismatch) { ret 1; }
    if (!track_is_freed(?tracker, blob_p))  { ret 1; }
    if (!track_is_freed(?tracker, reloc_p)) { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[TrackEntry](?page_alloc, tracker.entries, 8192::usize);
    ret 0;
}

test "mach.lang.me.ir.instr_replace_operands:frees_displaced_by_capacity" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var tracker: Tracker;
    val res_entries: res[*TrackEntry, A.Error] = A.allocate[TrackEntry](?page_alloc, 8192::usize);
    if (sel res_entries.err) { ret 1; }
    tracker.entries  = res_entries.ok;
    tracker.cap      = 8192;
    tracker.count    = 0;
    tracker.live     = 0;
    tracker.mismatch = false;
    tracker.overflow = false;

    var tp: *Tracker = ?tracker;
    var alloc: A.Allocator;
    alloc.ctx           = tp::ptr;
    alloc.fn_allocate   = track_allocate;
    alloc.fn_reallocate = track_reallocate;
    alloc.fn_deallocate = track_deallocate;

    val res_module: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel res_module.err) { ret 1; }
    var m: Module = res_module.ok;

    val res_i64t: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64t.err) { ret 1; }
    val i64t: type.IrTypeId = res_i64t.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 1; }
    val fn: *Function = ?m.functions[res_fn.ok];

    val res_ops3: res[OperandArray, fail.Fail] = operands_alloc(?m, 3);
    if (sel res_ops3.err) { ret 1; }
    val ops3: OperandArray = res_ops3.ok;
    ops3.ops[0] = value.const_int(0, i64t);
    ops3.ops[1] = value.const_int(0, i64t);
    ops3.ops[2] = value.const_int(0, i64t);
    val displaced: ptr = ops3.ops::ptr;

    var cbr: instruction.Instruction;
    cbr.kind          = instruction.OP_CBR;
    cbr.ty            = i64t;
    cbr.operands      = ops3.ops;
    cbr.operand_count = 3;
    cbr.operand_cap   = 3;
    cbr.flags         = 0;
    cbr.aux_ty        = type.IRT_NIL;
    val res_cbr: res[id.InstructionId, fail.Fail] = instruction_add(?m, fn, cbr);
    if (sel res_cbr.err) { ret 1; }
    val ins: *instruction.Instruction = ?fn.instrs[res_cbr.ok::u32];

    val res_ops1: res[OperandArray, fail.Fail] = operands_alloc(?m, 1);
    if (sel res_ops1.err) { ret 1; }
    val ops1: OperandArray = res_ops1.ok;
    ops1.ops[0] = value.const_int(7, i64t);
    instr_replace_operands(?m, ins, ops1);

    if (!track_is_freed(?tracker, displaced)) { ret 1; }
    if (tracker.mismatch)         { ret 1; }
    if (ins.operand_count != 1)   { ret 1; }
    if (ins.operand_cap != 1)     { ret 1; }
    if (ins.operands != ops1.ops) { ret 1; }

    instr_replace_operands(?m, ins, ops1);
    if (track_is_freed(?tracker, ops1.ops::ptr)) { ret 1; }
    if (ins.operands != ops1.ops) { ret 1; }
    if (ins.operand_count != 1)   { ret 1; }
    if (ins.operand_cap != 1)     { ret 1; }

    dnit(?m);

    if (tracker.overflow)  { ret 1; }
    if (tracker.mismatch)  { ret 1; }
    if (tracker.live != 0) { ret 1; }

    A.deallocate[TrackEntry](?page_alloc, tracker.entries, 8192::usize);
    ret 0;
}

