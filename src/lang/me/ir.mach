test "mach.lang.me.ir.inline_site_channel:add_get_group" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: Module = rm.ok;

    val rvoid: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel rvoid.err) { dnit(?m); ret 1; }
    val voidty: type.IrTypeId = rvoid.ok;
    val rsig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, voidty, nil, 0, false);
    if (sel rsig.err) { dnit(?m); ret 1; }
    val sigty: type.IrTypeId = rsig.ok;
    val r_1354: res[u32, fail.Fail] = function_add(?m, 100::intern.StrId, sigty, 0);
    if (sel r_1354.err) { dnit(?m); ret 1; }
    val r_1355: res[u32, fail.Fail] = function_add(?m, 200::intern.StrId, sigty, 0);
    if (sel r_1355.err) { dnit(?m); ret 1; }
    val caller: *Function = ?m.functions[1];

    val ra: res[u32, fail.Fail] = inline_site_add(?m, caller, 300::intern.StrId, source.loc_nil(), 0);
    if (sel ra.err) { dnit(?m); ret 1; }
    if (ra.ok != 1) { dnit(?m); ret 1; }
    val rb: res[u32, fail.Fail] = inline_site_add(?m, caller, 301::intern.StrId, source.loc_nil(), 1);
    if (sel rb.err) { dnit(?m); ret 1; }
    if (rb.ok != 2) { dnit(?m); ret 1; }

    val g1: opt[*InlineSite] = inline_site_get(caller, 1);
    if (sel g1.none) { dnit(?m); ret 1; }
    if (g1.some.callee != 300::intern.StrId) { dnit(?m); ret 1; }
    if (g1.some.parent != 0)                { dnit(?m); ret 1; }
    val g2: opt[*InlineSite] = inline_site_get(caller, 2);
    if (sel g2.none)                           { dnit(?m); ret 1; }
    if (g2.some.parent != 1)                { dnit(?m); ret 1; }
    val r_1372: opt[*InlineSite] = inline_site_get(caller, 0);
    if (sel r_1372.some) { dnit(?m); ret 1; }
    val r_1373: opt[*InlineSite] = inline_site_get(caller, 3);
    if (sel r_1373.some) { dnit(?m); ret 1; }

    val r_1375: err[fail.Fail] = instr_inline_site_set(caller, 7::id.InstructionId, 2);
    if (sel r_1375.err) { dnit(?m); ret 1; }
    if (instr_inline_site_of(caller, 7::id.InstructionId) != 2) { dnit(?m); ret 1; }
    if (instr_inline_site_of(caller, 8::id.InstructionId) != 0) { dnit(?m); ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.home:owns_the_whole_module" {
    var h: ModuleHome;
    val r_1385: err[fail.Fail] = home_init(?h);
    if (sel r_1385.err) { ret 1; }

    val rm: res[Module, fail.Fail] = init(?h.alloc, 42::intern.StrId);
    if (sel rm.err) { home_dnit(?h); ret 1; }
    var m: Module = rm.ok;
    if (m.alloc != ?h.alloc) { home_dnit(?h); ret 1; }

    val rvoid: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel rvoid.err) { home_dnit(?h); ret 1; }
    val rsig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, rvoid.ok, nil, 0, false);
    if (sel rsig.err) { home_dnit(?h); ret 1; }
    val sigty: type.IrTypeId = rsig.ok;

    var i: u32 = 0;
    for (i < 32) {
        val r_1400: res[u32, fail.Fail] = function_add(?m, (i + 1)::intern.StrId, sigty, 0);
        if (sel r_1400.err) { home_dnit(?h); ret 1; }
        i = i + 1;
    }
    if (m.function_len != 32) { home_dnit(?h); ret 1; }

    home_dnit(?h);
    ret 0;
}

rec GrowCapProbe {
    reallocate_calls: u32;
}

fun growcap_probe_allocate(ctx: ptr, size: usize, align: usize) opt[ptr] {
    ret opt[ptr].none{};
}

fun growcap_probe_reallocate(ctx: ptr, p: ptr, old_size: usize, new_size: usize, align: usize) opt[ptr] {
    val g: *GrowCapProbe = ctx::*GrowCapProbe;
    g.reallocate_calls = g.reallocate_calls + 1;
    ret opt[ptr].none{};
}

fun growcap_probe_deallocate(ctx: ptr, p: ptr, size: usize, align: usize) i64 {
    ret 0;
}

test "mach.lang.me.ir.grow_cap:refuses_a_u32_capacity_that_cannot_double_before_reallocating" {
    var probe: GrowCapProbe;
    probe.reallocate_calls = 0;
    var pp: *GrowCapProbe = ?probe;
    var a: A.Allocator;
    a.ctx           = pp::ptr;
    a.fn_allocate   = growcap_probe_allocate;
    a.fn_reallocate = growcap_probe_reallocate;
    a.fn_deallocate = growcap_probe_deallocate;

    var dummy: u8;
    var data: *u8 = ?dummy;
    var cap: u32 = 0xFFFFFFFF;
    val res_: err[fail.Fail] = grow_cap[u8](?a, ?data, ?cap, 16);

    var bad: i32 = 0;
    if (!sel res_.err)   { bad = 1; }
    if (probe.reallocate_calls != 0) { bad = 2; }
    if (cap != 0xFFFFFFFF)           { bad = 3; }
    ret bad;
}

test "mach.lang.me.ir.grow_cap:doubles_and_narrows_within_the_u32_domain" {
    var page_alloc: A.Allocator;
    page.make(?page_alloc);

    var data: *u8 = nil;
    var cap: u32 = 0;
    val res1: err[fail.Fail] = grow_cap[u8](?page_alloc, ?data, ?cap, 4);
    if (sel res1.err) { ret 1; }
    if (cap != 4)                  { ret 1; }

    val res2: err[fail.Fail] = grow_cap[u8](?page_alloc, ?data, ?cap, 4);
    if (sel res2.err) { A.deallocate[u8](?page_alloc, data, cap::usize); ret 1; }
    if (cap != 8)                  { A.deallocate[u8](?page_alloc, data, cap::usize); ret 1; }

    A.deallocate[u8](?page_alloc, data, cap::usize);
    ret 0;
}

test "mach.lang.me.ir.block_add:refuses_a_block_count_at_the_block_nil_sentinel" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[Module, fail.Fail] = init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: Module = rm.ok;

    val rvoid: res[type.IrTypeId, fail.Fail] = type.intern_void(?m.types);
    if (sel rvoid.err) { dnit(?m); ret 1; }
    val rsig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, rvoid.ok, nil, 0, false);
    if (sel rsig.err) { dnit(?m); ret 1; }
    val sigty: type.IrTypeId = rsig.ok;

    val res_fn: res[u32, fail.Fail] = function_add(?m, intern.STR_NIL, sigty, 0);
    if (sel res_fn.err) { dnit(?m); ret 1; }
    val fn: *Function = ?m.functions[res_fn.ok];

    fn.block_count = 0xFFFFFFFF;
    val res_over: res[id.BlockId, fail.Fail] = block_add(?m, fn);
    if (!sel res_over.err) { fn.block_count = 0; dnit(?m); ret 1; }
    if (fn.block_count != 0xFFFFFFFF)         { dnit(?m); ret 1; }

    fn.block_count = 0;
    val res_ok: res[id.BlockId, fail.Fail] = block_add(?m, fn);
    if (sel res_ok.err)                    { dnit(?m); ret 1; }
    if (res_ok.ok != 0::id.BlockId) { dnit(?m); ret 1; }

    dnit(?m);
    ret 0;
}

test "mach.lang.me.ir.instruction_add:refuses_an_instr_len_at_the_instr_nil_sentinel" {
