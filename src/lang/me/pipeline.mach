    val x: value.Value = R.unwrap_ok[value.Value, str](res_load);

    val res_s: R.Result[value.Value, str] = builder.emit_mul(?bld, x, value.const_int(3, i64t));
    if (R.is_err[value.Value, str](res_s)) { ir.dnit(?m); ret 1; }
    val s: value.Value = R.unwrap_ok[value.Value, str](res_s);
    if (R.is_err[R.Void, str](builder.emit_dbg_value(?bld, s, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0))) { ir.dnit(?m); ret 1; }
    val dbg_id: id.InstructionId = (fn.instr_len - 1)::id.InstructionId;

    if (R.is_err[R.Void, str](builder.emit_ret(?bld, p0))) { ir.dnit(?m); ret 1; }

    if (R.is_err[bool, str](mem2reg.run(?m)))   { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](constfold.run(?m))) { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](dce.run(?m)))       { ir.dnit(?m); ret 1; }

    val dbg: *instruction.Instruction = ?fn.instrs[dbg_id::u32];
    if (dbg.kind != instruction.OP_DBG_VALUE)          { ir.dnit(?m); ret 1; }
    if (dbg.operand_count != 1)                        { ir.dnit(?m); ret 1; }
    if (dbg.operands[0].kind != value.VAL_CONST_NULL)  { ir.dnit(?m); ret 1; }
    if (ir.dbg_expr_id(fn, dbg_id) != ir.DBG_EXPR_IDENTITY) { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.pipeline.dbg:salvage_grows_expression_pool" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val res_i64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_i64)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_blk)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_blk));

    val p0: value.Value = value.param(0, i64t);

    var first_dbg: u32 = 0;
    var k: u64 = 1;
    for (k <= 16) {
        val res_s: R.Result[value.Value, str] = builder.emit_add(?bld, p0, value.const_int(k, i64t));
        if (R.is_err[value.Value, str](res_s)) { ir.dnit(?m); ret 1; }
        val s: value.Value = R.unwrap_ok[value.Value, str](res_s);
        if (R.is_err[R.Void, str](builder.emit_dbg_value(?bld, s, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0))) { ir.dnit(?m); ret 1; }
        if (k == 1) { first_dbg = fn.instr_len - 1; }
        k = k + 1;
    }

    if (R.is_err[R.Void, str](builder.emit_ret(?bld, p0))) { ir.dnit(?m); ret 1; }

    if (R.is_err[bool, str](mem2reg.run(?m)))   { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](constfold.run(?m))) { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](dce.run(?m)))       { ir.dnit(?m); ret 1; }

    val dbg_id: id.InstructionId = first_dbg::id.InstructionId;
    val dbg: *instruction.Instruction = ?fn.instrs[dbg_id::u32];
    if (dbg.kind != instruction.OP_DBG_VALUE)    { ir.dnit(?m); ret 1; }
    if (dbg.operands[0].kind != value.VAL_PARAM) { ir.dnit(?m); ret 1; }
    val eid: ir.DbgExprId = ir.dbg_expr_id(fn, dbg_id);
    if (eid == ir.DBG_EXPR_IDENTITY)             { ir.dnit(?m); ret 1; }
    val opt: O.Option[*ir.DbgExpr] = ir.dbg_expr_get(fn, eid);
    if (O.is_none[*ir.DbgExpr](opt))             { ir.dnit(?m); ret 1; }
    val dex: *ir.DbgExpr = O.unwrap[*ir.DbgExpr](opt);
    if (dex.op_count != 1)                       { ir.dnit(?m); ret 1; }
    if (dex.ops[0].op != ir.DBG_OP_PLUS_CONST)   { ir.dnit(?m); ret 1; }
    if (dex.ops[0].arg != 1)                     { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.pipeline.run:simd_require_gate" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var code: i32 = 0;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { intern.dnit(?itn); ret 1; }
    val trr: R.Result[resolved.Target, str] = target.select(?reg, "riscv64", "linux", "lp64d");
    if (R.is_err[resolved.Target, str](trr)) { intern.dnit(?itn); ret 1; }
    var rv: resolved.Target = R.unwrap_ok[resolved.Target, str](trr);

    val rfn: R.Result[intern.StrId, str] = intern.intern(?itn, "kernel");
    if (R.is_err[intern.StrId, str](rfn)) { intern.dnit(?itn); ret 1; }
    val kname: intern.StrId = R.unwrap_ok[intern.StrId, str](rfn);

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    val rf: R.Result[ir_type.IrTypeId, str] = ir_type.intern_float(?m.types, 32);
    if (R.is_err[ir_type.IrTypeId, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val rvt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_vector(?m.types, R.unwrap_ok[ir_type.IrTypeId, str](rf), 4);
    if (R.is_err[ir_type.IrTypeId, str](rvt)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val vec: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rvt);
    val rfa: R.Result[u32, str] = ir.function_add(?m, kname, vec, 0);
    if (R.is_err[u32, str](rfa)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rfa)];
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](rb)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    builder.set_block(?b, R.unwrap_ok[id.BlockId, str](rb));
    val radd: R.Result[value.Value, str] = builder.emit_add(?b, value.param(0, vec), value.param(1, vec));
    if (R.is_err[value.Value, str](radd)) { code = 1; }
    or { if (R.is_err[R.Void, str](builder.emit_ret(?b, R.unwrap_ok[value.Value, str](radd)))) { code = 1; } }

    var preq1: PipelineRequest;
    preq1.module            = ?m;
    preq1.target             = ?rv;
    preq1.level               = OPT_DEBUG;
    preq1.vectorize_enabled   = VectorizeEnabledOption{ v: true };
    preq1.simd_require        = SimdRequireOption{ v: true };
    preq1.float_reassoc       = FloatReassocOption{ v: false };
    preq1.interner            = ?itn;
    preq1.source_map          = nil;
    val e1: R.Result[bool, str] = run(?preq1);
    if (R.is_ok[bool, str](e1)) { code = 1; }
    or {
        val msg: str = R.unwrap_err[bool, str](e1);
        if (!str_contains(msg, "simd = \"require\"")) { code = 1; }
        if (!str_contains(msg, "add"))               { code = 1; }
        if (!str_contains(msg, "kernel"))            { code = 1; }
        if (!str_contains(msg, "riscv64"))           { code = 1; }
        if (!str_contains(msg, "4 lanes of 32 bits")) { code = 1; }
    }
    ir.dnit(?m);

    val rm2: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm2)) { intern.dnit(?itn); ret 1; }
    var m2: ir.Module = R.unwrap_ok[ir.Module, str](rm2);
    val rfa2: R.Result[u32, str] = ir.function_add(?m2, kname, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rfa2)) { ir.dnit(?m2); intern.dnit(?itn); ret 1; }
    val fn2: *ir.Function = ?m2.functions[R.unwrap_ok[u32, str](rfa2)];
    var b2: builder.Builder = builder.init(?m2);
    builder.set_function(?b2, fn2);
    val rb2: R.Result[id.BlockId, str] = builder.new_block(?b2);
    if (R.is_err[id.BlockId, str](rb2)) { ir.dnit(?m2); intern.dnit(?itn); ret 1; }
    builder.set_block(?b2, R.unwrap_ok[id.BlockId, str](rb2));
    if (R.is_err[R.Void, str](builder.emit_ret_void(?b2))) { code = 1; }
    var preq2: PipelineRequest;
    preq2.module            = ?m2;
    preq2.target             = ?rv;
    preq2.level               = OPT_DEBUG;
    preq2.vectorize_enabled   = VectorizeEnabledOption{ v: true };
    preq2.simd_require        = SimdRequireOption{ v: true };
    preq2.float_reassoc       = FloatReassocOption{ v: false };
    preq2.interner            = ?itn;
    preq2.source_map          = nil;
    if (R.is_err[bool, str](run(?preq2))) { code = 1; }
    ir.dnit(?m2);

    if (mul_require_refused(?alloc, ?itn, ?reg, "x86_64",  "sysv64") != 1) { code = 1; }
    if (mul_require_refused(?alloc, ?itn, ?reg, "riscv64", "lp64d")   != 1) { code = 1; }
    if (mul_require_refused(?alloc, ?itn, ?reg, "aarch64", "aapcs64") != 0) { code = 1; }

    intern.dnit(?itn);
    ret code;
}

fun mul_require_refused(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry, isa_name: str, abi_name: str) i32 {
    val trr: R.Result[resolved.Target, str] = target.select(reg, isa_name, "linux", abi_name);
    if (R.is_err[resolved.Target, str](trr)) { ret 2; }
    var rv: resolved.Target = R.unwrap_ok[resolved.Target, str](trr);

    val rfn: R.Result[intern.StrId, str] = intern.intern(itn, "kernel");
    if (R.is_err[intern.StrId, str](rfn)) { ret 2; }

    val rm: R.Result[ir.Module, str] = ir.init(alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 2; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 32);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 2; }
    val rvt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_vector(?m.types, R.unwrap_ok[ir_type.IrTypeId, str](ri), 4);
    if (R.is_err[ir_type.IrTypeId, str](rvt)) { ir.dnit(?m); ret 2; }
    val vec: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rvt);

    val rfa: R.Result[u32, str] = ir.function_add(?m, R.unwrap_ok[intern.StrId, str](rfn), vec, 0);
    if (R.is_err[u32, str](rfa)) { ir.dnit(?m); ret 2; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rfa)];
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](rb)) { ir.dnit(?m); ret 2; }
    builder.set_block(?b, R.unwrap_ok[id.BlockId, str](rb));

    val rmul: R.Result[value.Value, str] = builder.emit_mul(?b, value.param(0, vec), value.param(1, vec));
    if (R.is_err[value.Value, str](rmul)) { ir.dnit(?m); ret 2; }
    if (R.is_err[R.Void, str](builder.emit_ret(?b, R.unwrap_ok[value.Value, str](rmul)))) { ir.dnit(?m); ret 2; }

    var preq3: PipelineRequest;
    preq3.module            = ?m;
    preq3.target             = ?rv;
    preq3.level               = OPT_DEBUG;
    preq3.vectorize_enabled   = VectorizeEnabledOption{ v: true };
    preq3.simd_require        = SimdRequireOption{ v: true };
    preq3.float_reassoc       = FloatReassocOption{ v: false };
    preq3.interner            = itn;
    preq3.source_map          = nil;
    val changed_r: R.Result[bool, str] = run(?preq3);
    ir.dnit(?m);
    if (R.is_err[bool, str](changed_r)) { ret 1; }
    ret 0;
}

test "mach.lang.me.pipeline.run:reports_the_change_a_pass_made" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    if (R.is_err[R.Void, str](target.register_all(?reg, target_testing.debug_descriptor))) { ret 1; }
    val trr: R.Result[resolved.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[resolved.Target, str](trr)) { ret 1; }
    var rv: resolved.Target = R.unwrap_ok[resolved.Target, str](trr);

    val rfn: R.Result[intern.StrId, str] = intern.intern(?itn, "f");
    if (R.is_err[intern.StrId, str](rfn)) { ret 1; }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](rfn);

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    fin { ir.dnit(?m); }
    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 32);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ret 1; }
    val i32_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);
    val rfa: R.Result[u32, str] = ir.function_add(?m, fname, i32_ty, 0);
    if (R.is_err[u32, str](rfa)) { ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rfa)];
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](rb)) { ret 1; }
    builder.set_block(?b, R.unwrap_ok[id.BlockId, str](rb));
    val radd: R.Result[value.Value, str] = builder.emit_add(?b,
        value.const_int(2, i32_ty), value.const_int(3, i32_ty));
    if (R.is_err[value.Value, str](radd)) { ret 1; }
    if (R.is_err[R.Void, str](builder.emit_ret(?b, R.unwrap_ok[value.Value, str](radd)))) { ret 1; }

    var preq: PipelineRequest = t_ready_request();
    preq.module   = ?m;
    preq.target   = ?rv;
    preq.interner = ?itn;
    val e: R.Result[bool, str] = run(?preq);
    if (R.is_err[bool, str](e))         { ret 1; }
    if (!R.unwrap_ok[bool, str](e))     { ret 1; }

    val rm2: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm2)) { ret 1; }
    var m2: ir.Module = R.unwrap_ok[ir.Module, str](rm2);
    fin { ir.dnit(?m2); }
    val rfa2: R.Result[u32, str] = ir.function_add(?m2, fname, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rfa2)) { ret 1; }
    val fn2: *ir.Function = ?m2.functions[R.unwrap_ok[u32, str](rfa2)];
    var b2: builder.Builder = builder.init(?m2);
    builder.set_function(?b2, fn2);
    val rb2: R.Result[id.BlockId, str] = builder.new_block(?b2);
    if (R.is_err[id.BlockId, str](rb2)) { ret 1; }
    builder.set_block(?b2, R.unwrap_ok[id.BlockId, str](rb2));
    if (R.is_err[R.Void, str](builder.emit_ret_void(?b2))) { ret 1; }

    var preq2: PipelineRequest = t_ready_request();
    preq2.module   = ?m2;
    preq2.target   = ?rv;
    preq2.interner = ?itn;
    val e2: R.Result[bool, str] = run(?preq2);
    if (R.is_err[bool, str](e2))      { ret 1; }
    if (R.unwrap_ok[bool, str](e2))   { ret 1; }
    ret 0;
}

test "mach.lang.me.pipeline:simple_passes_do_not_retain_function_work_in_ir" {
    var backing: A.Allocator;
    if (O.is_some[str](page.make(?backing))) { ret 1; }
    var owner: arena.Arena;
    if (O.is_some[str](arena.init(?owner, ?backing, 0))) { ret 1; }
    fin { arena.dnit(?owner); }
    var alloc: A.Allocator;
    if (O.is_some[str](arena.make(?alloc, ?owner))) { ret 1; }
    val initialized: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](initialized)) { ret 1; }
    var module: ir.Module = R.unwrap_ok[ir.Module, str](initialized);
    fin { ir.dnit(?module); }
    val typed: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?module.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](typed)) { ret 1; }
    val ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](typed);
    val added: R.Result[u32, str] = ir.function_add(?module, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](added)) { ret 1; }
    val fn: *ir.Function = ?module.functions[R.unwrap_ok[u32, str](added)];
    var build: builder.Builder = builder.init(?module);
    builder.set_function(?build, fn);
    val block: R.Result[id.BlockId, str] = builder.new_block(?build);
    if (R.is_err[id.BlockId, str](block)) { ret 1; }
    builder.set_block(?build, R.unwrap_ok[id.BlockId, str](block));
    if (R.is_err[R.Void, str](builder.emit_ret(?build, value.const_int(42, ty)))) { ret 1; }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    if (R.is_err[R.Void, str](target.register_all(?registry, target_testing.debug_descriptor))) { ret 1; }
    val selected: R.Result[target.Target, str] = target.select(?registry, "x86_64", "linux", "sysv64");
    if (R.is_err[target.Target, str](selected)) { ret 1; }
    var tgt: target.Target = R.unwrap_ok[target.Target, str](selected);
    if (R.is_err[bool, str](sroa.run(?module, ?tgt))) { ret 2; }
    val chunk: *arena.Chunk = owner.chunk;
    val offset: usize = owner.off;
    var repeat: u32 = 0;
    for (repeat < 8) {
        if (R.is_err[bool, str](mem2reg.run(?module))) { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 3; }
        if (R.is_err[bool, str](constfold.run(?module))) { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 4; }
        if (R.is_err[bool, str](cse.run(?module))) { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 5; }
        if (R.is_err[bool, str](dce.run(?module))) { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 6; }
        if (R.is_err[bool, str](algebraic.run(?module))) { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 8; }
        var context: VerifyCtx = VerifyCtx{tgt: nil, itn: nil, srcmap: nil};
        if (R.is_err[R.Void, str](run_verify(?module, true, false, ?context))) { ret 9; }
        if (owner.chunk != chunk || owner.off != offset) { ret 10; }
        if (R.is_err[bool, str](licm.run(?module, ?tgt))) { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 11; }
        if (R.is_err[bool, str](sroa.run(?module, ?tgt))) { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 12; }
        val term: id.InstructionId = fn.blocks[0].terminator;
        if (fn.block_count != 1 || term == id.INSTR_NIL) { ret 7; }
        if (fn.instrs[term::u32].operands[0].data.int_lit != 42) { ret 7; }
        repeat = repeat + 1;
    }
    ret 0;
}
