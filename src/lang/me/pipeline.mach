use mach.lang.fail;
use std.allocator.arena;
use std.allocator.page;
use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use A: std.allocator;

use mach.lang.diagnostic;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.body;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.ir.verify;
use mach.lang.me.pass.algebraic;
use mach.lang.me.pass.constfold;
use mach.lang.me.pass.cse;
use mach.lang.me.pass.dce;
use mach.lang.me.pass.inline;
use mach.lang.me.pass.mem2reg;
use mach.lang.me.pass.scalarize;
use mach.lang.me.pass.shiftbound;
use mach.lang.me.pass.vecsplat;
use mach.lang.me.pass.wideconv;
use mach.lang.me.pass.widediv;
use mach.lang.me.pass.widenmul;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.transform.licm;
use mach.lang.me.transform.sroa;
use mach.lang.me.transform.thread;
use mach.lang.me.transform.vectorize;
use mach.lang.me.vecform;
use mach.lang.source;
use mach.lang.target;
use mach.lang.target.isa;
use mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;
use semtype:        mach.lang.type;

pub def OptLevel: u8;

pub val OPT_DEBUG:   OptLevel = 0;
pub val OPT_RELEASE: OptLevel = 1;

pub rec VectorizeEnabledOption { v: bool; }
pub rec SimdRequireOption      { v: bool; }
pub rec FloatReassocOption     { v: bool; }

# diags is the module's diagnostic store: a shape or `simd = "require"` refusal
# is a located error there, never a bare failure
pub rec PipelineRequest {
    module:            *ir.Module;
    available:         *body.Available;
    target:            *target.Target;
    level:             OptLevel;
    vectorize_enabled: VectorizeEnabledOption;
    simd_require:      SimdRequireOption;
    float_reassoc:     FloatReassocOption;
    interner:          *intern.Interner;
    source_map:        *source.SourceMap;
    # the module's diagnostic store: a shape or `simd = "require"` refusal is a
    # located error there, never a bare failure
    diags: *diagnostic.DiagnosticStore;
}

pub fun run(req: *PipelineRequest) res[bool, fail.Fail] {
    if (req.module == nil)   { ret res[bool, fail.Fail].err{fail.message("pipeline request: module is required")}; }
    if (req.target == nil)   { ret res[bool, fail.Fail].err{fail.message("pipeline request: target is required")}; }
    if (req.interner == nil) { ret res[bool, fail.Fail].err{fail.message("pipeline request: interner is required")}; }

    ret run_impl(req.module, req.target, req.level, req.vectorize_enabled.v,
        req.simd_require.v, req.float_reassoc.v, req.interner, req.source_map, req.available, req.diags);
}

fun run_impl(m: *ir.Module, tgt: *target.Target, level: OptLevel, vectorize_enabled: bool, simd_require: bool, float_reassoc: bool, itn: *intern.Interner, srcmap: *source.SourceMap, available: *body.Available, diags: *diagnostic.DiagnosticStore) res[bool, fail.Fail] {
    var vc: VerifyCtx;
    vc.tgt    = tgt;
    vc.itn    = itn;
    vc.srcmap = srcmap;

    var changed: bool = false;

    # one bounded workspace for every per-function pass in this run
    var workspace:   scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    val ws: *scratch.Workspace = ?workspace;

    val res_verify_in: err[fail.Fail] = verify_in(m, false, true, ?vc, ws);
    if (sel res_verify_in.err) { ret res[bool, fail.Fail].err{res_verify_in.err}; }

    val mem2reg_changed_r: res[bool, fail.Fail] = mem2reg.run_in(m, ws);
    if (sel mem2reg_changed_r.err) { ret mem2reg_changed_r; }
    if (mem2reg_changed_r.ok)      { changed = true; }
    val res_verify_mem2reg: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
    if (sel res_verify_mem2reg.err) { ret res[bool, fail.Fail].err{res_verify_mem2reg.err}; }

    val constfold_changed_r: res[bool, fail.Fail] = constfold.run_in(m, ws);
    if (sel constfold_changed_r.err) { ret constfold_changed_r; }
    if (constfold_changed_r.ok)      { changed = true; }
    val res_verify_constfold: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
    if (sel res_verify_constfold.err) { ret res[bool, fail.Fail].err{res_verify_constfold.err}; }

    val dce_changed_r: res[bool, fail.Fail] = dce.run_in(m, ws);
    if (sel dce_changed_r.err) { ret dce_changed_r; }
    if (dce_changed_r.ok)      { changed = true; }
    val res_verify_dce: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
    if (sel res_verify_dce.err) { ret res[bool, fail.Fail].err{res_verify_dce.err}; }

    if (level == OPT_RELEASE) {
        val inline_changed_r: res[bool, fail.Fail] = inline_available(m, tgt, available, ws);
        if (sel inline_changed_r.err) { ret inline_changed_r; }
        if (inline_changed_r.ok)      { changed = true; }
        val res_verify_inline: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
        if (sel res_verify_inline.err) { ret res[bool, fail.Fail].err{res_verify_inline.err}; }

        val mem2reg2_changed_r: res[bool, fail.Fail] = mem2reg.run_in(m, ws);
        if (sel mem2reg2_changed_r.err) { ret mem2reg2_changed_r; }
        if (mem2reg2_changed_r.ok)      { changed = true; }
        val res_verify_mem2reg2: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
        if (sel res_verify_mem2reg2.err) { ret res[bool, fail.Fail].err{res_verify_mem2reg2.err}; }

        val constfold2_changed_r: res[bool, fail.Fail] = constfold.run_in(m, ws);
        if (sel constfold2_changed_r.err) { ret constfold2_changed_r; }
        if (constfold2_changed_r.ok)      { changed = true; }
        val res_verify_constfold2: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
        if (sel res_verify_constfold2.err) { ret res[bool, fail.Fail].err{res_verify_constfold2.err}; }

        val dce_pre_changed_r: res[bool, fail.Fail] = dce.run_in(m, ws);
        if (sel dce_pre_changed_r.err) { ret dce_pre_changed_r; }
        if (dce_pre_changed_r.ok)      { changed = true; }
        val res_verify_dce_pre: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_dce_pre.err) { ret res[bool, fail.Fail].err{res_verify_dce_pre.err}; }

        val sroa_changed_r: res[bool, fail.Fail] = sroa.run_in(m, tgt, ws);
        if (sel sroa_changed_r.err) { ret sroa_changed_r; }
        if (sroa_changed_r.ok) {
            changed = true;
            val res_verify_sroa: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
            if (sel res_verify_sroa.err) { ret res[bool, fail.Fail].err{res_verify_sroa.err}; }

            val mem2reg3_changed_r: res[bool, fail.Fail] = mem2reg.run_in(m, ws);
            if (sel mem2reg3_changed_r.err) { ret mem2reg3_changed_r; }
            if (mem2reg3_changed_r.ok)      { changed = true; }
            val res_verify_mem2reg3: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
            if (sel res_verify_mem2reg3.err) { ret res[bool, fail.Fail].err{res_verify_mem2reg3.err}; }
        }

        val algebraic_changed_r: res[bool, fail.Fail] = algebraic.run_in(m, ws);
        if (sel algebraic_changed_r.err) { ret algebraic_changed_r; }
        if (algebraic_changed_r.ok)      { changed = true; }
        val res_verify_algebraic: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
        if (sel res_verify_algebraic.err) { ret res[bool, fail.Fail].err{res_verify_algebraic.err}; }

        val cse_changed_r: res[bool, fail.Fail] = cse.run_in(m, ws);
        if (sel cse_changed_r.err) { ret cse_changed_r; }
        if (cse_changed_r.ok)      { changed = true; }
        val res_verify_cse: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
        if (sel res_verify_cse.err) { ret res[bool, fail.Fail].err{res_verify_cse.err}; }

        var thread_changed_r: res[bool, fail.Fail] = res[bool, fail.Fail].ok{false};
        if (!tgt.model.structured_control_flow) { thread_changed_r = thread.run_in(m, ws); }
        if (sel thread_changed_r.err)           { ret thread_changed_r; }
        if (thread_changed_r.ok) {
            changed = true;
            # a join every predecessor threaded past is unreachable now
            val dce_thread_changed_r: res[bool, fail.Fail] = dce.run_in(m, ws);
            if (sel dce_thread_changed_r.err) { ret dce_thread_changed_r; }
            val res_verify_thread: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
            if (sel res_verify_thread.err) { ret res[bool, fail.Fail].err{res_verify_thread.err}; }
        }

        val constfold3_changed_r: res[bool, fail.Fail] = constfold.run_in(m, ws);
        if (sel constfold3_changed_r.err) { ret constfold3_changed_r; }
        if (constfold3_changed_r.ok)      { changed = true; }
        val res_verify_constfold3: err[fail.Fail] = verify_stage(m, false, ?vc, ws);
        if (sel res_verify_constfold3.err) { ret res[bool, fail.Fail].err{res_verify_constfold3.err}; }

        val dce2_changed_r: res[bool, fail.Fail] = dce.run_in(m, ws);
        if (sel dce2_changed_r.err) { ret dce2_changed_r; }
        if (dce2_changed_r.ok)      { changed = true; }
        val res_verify_dce2: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_dce2.err) { ret res[bool, fail.Fail].err{res_verify_dce2.err}; }

        # the saturation of a shift by an unproven count is ir from here, so
        # licm hoists the mask of a count the loop does not change (#3887)
        val bound_early_r: res[bool, fail.Fail] = shiftbound.run_in(m, ws);
        if (sel bound_early_r.err) { ret bound_early_r; }
        if (bound_early_r.ok) {
            changed = true;
            val res_verify_bound: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
            if (sel res_verify_bound.err) { ret res[bool, fail.Fail].err{res_verify_bound.err}; }
        }

        val licm_changed_r: res[bool, fail.Fail] = licm.run_in(m, tgt, ws);
        if (sel licm_changed_r.err) { ret licm_changed_r; }
        if (licm_changed_r.ok)      { changed = true; }
        val res_verify_licm: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_licm.err) { ret res[bool, fail.Fail].err{res_verify_licm.err}; }

        if (tgt.model.has_v128 && vectorize_enabled) {
            val vec_changed_r: res[bool, fail.Fail] = vectorize.run(m, tgt, float_reassoc, itn);
            if (sel vec_changed_r.err) { ret vec_changed_r; }
            if (vec_changed_r.ok) {
                changed = true;
                # a guard proven at compile time is a constant branch, and the
                # loop version it skips is unreachable from then on
                val constfold_vec_changed_r: res[bool, fail.Fail] = constfold.run_in(m, ws);
                if (sel constfold_vec_changed_r.err) { ret constfold_vec_changed_r; }
                val dce_vec_changed_r: res[bool, fail.Fail] = dce.run_in(m, ws);
                if (sel dce_vec_changed_r.err) { ret dce_vec_changed_r; }
                val res_verify_vec: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
                if (sel res_verify_vec.err) { ret res[bool, fail.Fail].err{res_verify_vec.err}; }
            }
        }
    }

    # a vector shift whose count is the same value in every lane of a literal
    # shifts by that one scalar, the uniform form placement reads as its own
    # cell; the literal goes when nothing else reads it (#3740)
    val vecsplat_changed_r: res[bool, fail.Fail] = vecsplat.run(m, ws);
    if (sel vecsplat_changed_r.err) { ret vecsplat_changed_r; }
    if (vecsplat_changed_r.ok) {
        changed = true;
        val res_verify_vecsplat: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_vecsplat.err) { ret res[bool, fail.Fail].err{res_verify_vecsplat.err}; }
    }

    # a widening multiply is selected at every level, before placement reads
    # each operator's declared form; an extension it leaves unread goes with dce
    val widen_changed_r: res[bool, fail.Fail] = widenmul.run(m, tgt);
    if (sel widen_changed_r.err) { ret widen_changed_r; }
    if (widen_changed_r.ok) {
        changed = true;
        val dce_widen_changed_r: res[bool, fail.Fail] = dce.run_in(m, ws);
        if (sel dce_widen_changed_r.err) { ret dce_widen_changed_r; }
        val res_verify_widen: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_widen.err) { ret res[bool, fail.Fail].err{res_verify_widen.err}; }
    }

    # a division or a float conversion wider than the machine's alu becomes a
    # call to the helper the compiler provides with the program, one per
    # operation, synthesized once
    val widediv_changed_r: res[bool, fail.Fail] = widediv.run(m, tgt, itn);
    if (sel widediv_changed_r.err) { ret widediv_changed_r; }
    val wideconv_changed_r: res[bool, fail.Fail] = wideconv.run(m, tgt, itn);
    if (sel wideconv_changed_r.err) { ret wideconv_changed_r; }
    if (widediv_changed_r.ok || wideconv_changed_r.ok) {
        changed = true;
        val res_verify_widecall: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_widecall.err) { ret res[bool, fail.Fail].err{res_verify_widecall.err}; }
    }

    val res_declared: err[fail.Fail] = declared_check(m, tgt, itn, diags);
    if (sel res_declared.err) { ret res[bool, fail.Fail].err{res_declared.err}; }

    if (simd_require) {
        val res_req: err[fail.Fail] = require_check(m, tgt, itn, diags);
        if (sel res_req.err) { ret res[bool, fail.Fail].err{res_req.err}; }
    }

    val place_changed_r: res[bool, fail.Fail] = scalarize.run_in(m, tgt, ws);
    if (sel place_changed_r.err) { ret place_changed_r; }
    if (place_changed_r.ok)      { changed = true; }
    val res_verify_place: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
    if (sel res_verify_place.err) { ret res[bool, fail.Fail].err{res_verify_place.err}; }

    if (tgt.model.has_v128 && !simd_require) {
        val gap_changed_r: res[bool, fail.Fail] = scalarize.expand_gap_ops_in(m, tgt, ws);
        if (sel gap_changed_r.err) { ret gap_changed_r; }
        if (gap_changed_r.ok)      { changed = true; }
        val res_verify_gap: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_gap.err) { ret res[bool, fail.Fail].err{res_verify_gap.err}; }
    }

    val lanes_changed_r: res[bool, fail.Fail] = scalarize.expand_lane_ops_in(m, tgt, ws);
    if (sel lanes_changed_r.err) { ret lanes_changed_r; }
    if (lanes_changed_r.ok)      { changed = true; }
    if (!tgt.model.has_lane_ops && tgt.model.has_v128) {
        val res_verify_lanes: err[fail.Fail] = verify_stage(m, true, ?vc, ws);
        if (sel res_verify_lanes.err) { ret res[bool, fail.Fail].err{res_verify_lanes.err}; }
    }

    # last, so no pass after it can move a shift away from the facts that
    # bound its count, and every scalar shift a later pass formed is saturated
    val bound_changed_r: res[bool, fail.Fail] = shiftbound.run_in(m, ws);
    if (sel bound_changed_r.err) { ret bound_changed_r; }
    if (bound_changed_r.ok)      { changed = true; }

    val res_verify_out: err[fail.Fail] = verify_in(m, true, true, ?vc, ws);
    if (sel res_verify_out.err) { ret res[bool, fail.Fail].err{res_verify_out.err}; }
    ret res[bool, fail.Fail].ok{changed};
}

# a vector operator whose shape the target's catalog does not name is refused in
# every simd mode: the outcome is a declaration, never a fallback. the refusal
# is a located error on the store, so the tally and exit status agree
fun declared_check(m: *ir.Module, tgt: *target.Target, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var site:  scalarize.ScalarizeSite;
    val count: u32 = scalarize.detect_undeclared(m, tgt, ?site);
    if (count == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{diagnostic.reject(diags, site.loc, undeclared_msg(m, tgt, itn, ?site))};
}

# the diagnostic spelling of a site's vector operation; a descriptor vector tag
# or an operation outside its catalog is named as such instead
fun site_op_name(m: *ir.Module, itn: *intern.Interner, site: *scalarize.ScalarizeSite) str {
    val op: opt[isa.VecOp] = vecform.vec_op_of(site.op, site.uniform_count);
    if (sel op.none) { ret fail.catalog_message(itn, m.alloc, fail.unknown_member("IrVecOp", opdesc.vec_op(site.op)::u32)); }
    val name: opt[str] = vecform.vec_op_name(op.some);
    if (sel name.none) { ret fail.catalog_message(itn, m.alloc, fail.unknown_member("VecOp", op.some::u32)); }
    ret name.some;
}

fun undeclared_msg(m: *ir.Module, tgt: *target.Target, itn: *intern.Interner, site: *scalarize.ScalarizeSite) str {
    val op:    str      = site_op_name(m, itn, site);
    var fname: str      = "<anonymous>";
    val on:    opt[str] = intern.lookup(itn, site.fn_name);
    if (sel on.some) { fname = on.some; }
    val rj: res[str, fail.Fail] = undeclared_text(m, tgt, op, fname, site);
    if (sel rj.err) { ret fail.describe(rj.err); }
    ret rj.ok;
}

fun undeclared_text(m: *ir.Module, tgt: *target.Target, op: str, fname: str, site: *scalarize.ScalarizeSite) res[str, fail.Fail] {
    if (site.lane_bits == 0) {
        val r_239: res[str, format.FormatError] = format.sprint(m.alloc,
            "vector {} in '{}' has a lane shape outside the retained vocabulary (8, 16, 32 or 64-bit integer lanes, 32 or 64-bit float lanes), so {} declares neither a packed form nor the scalar expansion for it",
            op, fname, tgt.isa.name);
        if (sel r_239.err) { ret res[str, fail.Fail].err{fail.format_refused(r_239.err)}; }
        ret res[str, fail.Fail].ok{r_239.ok};
    }
    val r_241: res[str, format.FormatError] = format.sprint(m.alloc,
        "vector {} on {} lanes of {} bits in '{}' has no declared form on {}: the target's catalog names neither a packed instruction nor the scalar expansion for this operation and lane shape",
        op, site.lanes, site.lane_bits, fname, tgt.isa.name);
    if (sel r_241.err) { ret res[str, fail.Fail].err{fail.format_refused(r_241.err)}; }
    ret res[str, fail.Fail].ok{r_241.ok};
}

fun require_check(m: *ir.Module, tgt: *target.Target, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var site:  scalarize.ScalarizeSite;
    val count: u32 = scalarize.detect(m, tgt, ?site);
    if (count == 0) { ret err[fail.Fail].ok{}; }
    ret err[fail.Fail].err{diagnostic.reject(diags, site.loc, require_msg(m, tgt, itn, ?site))};
}

fun require_msg(m: *ir.Module, tgt: *target.Target, itn: *intern.Interner, site: *scalarize.ScalarizeSite) str {
    val op:    str      = site_op_name(m, itn, site);
    var fname: str      = "<anonymous>";
    val on:    opt[str] = intern.lookup(itn, site.fn_name);
    if (sel on.some) { fname = on.some; }

    var why: str = "target has no packed form for this operation at this lane width";
    if (!tgt.model.has_v128) { why = "target has no 128-bit SIMD"; }
    or {
        val cap: u32 = vecform.packed_lanes(tgt, site.lane_bits);
        if (cap != 0 && site.lanes > cap) {
            why = "this shape has more lanes than one packed vector holds on this target";
        }
    }

    val rj: res[str, format.FormatError] = format.sprint(m.alloc,
        "simd = \"require\": vector {} on {} lanes of {} bits in '{}' would scalarize on {} ({}); set simd = \"scalarize\" to build with the scalar expansion",
        op, site.lanes, site.lane_bits, fname, tgt.isa.name, why);
    if (sel rj.err) { ret fail.describe(fail.format_refused(rj.err)); }
    ret rj.ok;
}

rec VerifyCtx {
    tgt:    *target.Target;
    itn:    *intern.Interner;
    srcmap: *source.SourceMap;
}

fun verify_stage(m: *ir.Module, full: bool, vc: *VerifyCtx, workspace: *scratch.Workspace) err[fail.Fail] {
    ret verify_in(m, full, true, vc, workspace);
}

rec VerifyWork {
    module:  *ir.Module;
    context: *VerifyCtx;
    full:    bool;
    repr:    bool;
}

#[testing]
fun run_verify(m: *ir.Module, full: bool, repr: bool, vc: *VerifyCtx) err[fail.Fail] {
    var workspace:   scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret err[fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret verify_in(m, full, repr, vc, ?workspace);
}

fun verify_in(m: *ir.Module, full: bool, repr: bool, vc: *VerifyCtx, workspace: *scratch.Workspace) err[fail.Fail] {
    var work: VerifyWork = VerifyWork{module: m, context: vc, full: full, repr: repr};
    ret scratch.run_unit[VerifyWork](workspace, m.alloc, ?work, verify_work);
}

fun verify_work(work: *VerifyWork, alloc: *A.Allocator) err[fail.Fail] {
    val m:          *ir.Module                          = work.module;
    val vc:         *VerifyCtx                          = work.context;
    val res_report: res[verify.VerifyReport, fail.Fail] =
        verify.verify_module_ext(m, alloc, verify.opts(vc.tgt, work.full, work.repr));
    if (sel res_report.err) {
        ret err[fail.Fail].err{res_report.err};
    }
    var report: verify.VerifyReport = res_report.ok;
    fin { verify.dnit_report(?report); }
    if (report.len == 0) { ret err[fail.Fail].ok{}; }
    val described: res[str, fail.Fail] = verify.describe_located(m, ?report.violations[0], vc.itn, vc.srcmap, alloc);
    if (sel described.err) { ret err[fail.Fail].err{described.err}; }
    ret err[fail.Fail].err{fail.message(described.ok)};
}

#[testing]
fun t_ready_request() PipelineRequest {
    var req: PipelineRequest;
    req.module            = nil;
    req.target            = nil;
    req.level             = OPT_DEBUG;
    req.vectorize_enabled = VectorizeEnabledOption{v: false};
    req.simd_require      = SimdRequireOption{v: false};
    req.float_reassoc     = FloatReassocOption{v: false};
    req.interner          = nil;
    req.source_map        = nil;
    ret req;
}

test run__rejects_a_request_missing_a_module_target_or_interner {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    fin { ir.dnit(?m); }
    var rv: target.Target;

    var req: PipelineRequest = t_ready_request();
    req.target   = ?rv;
    req.interner = ?itn;
    val no_module: res[bool, fail.Fail] = run(?req);
    if (sel no_module.ok) { ret 2; }

    req          = t_ready_request();
    req.module   = ?m;
    req.interner = ?itn;
    val no_target: res[bool, fail.Fail] = run(?req);
    if (sel no_target.ok) { ret 3; }

    req        = t_ready_request();
    req.module = ?m;
    req.target = ?rv;
    val no_interner: res[bool, fail.Fail] = run(?req);
    if (sel no_interner.ok) { ret 4; }
    ret 0;
}

test loc__survives_mem2reg_constfold_dce {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_blk.ok);

    val p0: value.Value = value.param(0, i64t);

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_slot.err) {
        ir.dnit(?m);
        ret 1;
    }
    val slot:  value.Value    = res_slot.ok;
    val r_401: err[fail.Fail] = builder.emit_store(?bld, p0, slot);
    if (sel r_401.err) {
        ir.dnit(?m);
        ret 1;
    }
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, slot, i64t);
    if (sel res_load.err) {
        ir.dnit(?m);
        ret 1;
    }
    val x: value.Value = res_load.ok;

    val res_k: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.const_int(2, i64t), value.const_int(3, i64t));
    if (sel res_k.err) {
        ir.dnit(?m);
        ret 1;
    }
    val k: value.Value = res_k.ok;

    builder.set_loc(?bld, source.loc(9, 500));
    val res_s: res[value.Value, fail.Fail] = builder.emit_add(?bld, x, k);
    if (sel res_s.err) {
        ir.dnit(?m);
        ret 1;
    }
    val s:    value.Value      = res_s.ok;
    val s_id: id.InstructionId = s.data.instr;

    val r_416: err[fail.Fail] = builder.emit_ret(?bld, s);
    if (sel r_416.err) {
        ir.dnit(?m);
        ret 1;
    }

    val r_418: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_418.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_419: res[bool, fail.Fail] = constfold.run(?m);
    if (sel r_419.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_420: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_420.err) {
        ir.dnit(?m);
        ret 1;
    }

    val surviving: *instruction.Instruction = ?fn.instrs[s_id::u32];
    if (surviving.kind != instruction.OP_ADD) {
        ir.dnit(?m);
        ret 1;
    }
    if (surviving.loc.file != 9) {
        ir.dnit(?m);
        ret 1;
    }
    if (surviving.loc.offset != 500) {
        ir.dnit(?m);
        ret 1;
    }

    if (surviving.operands[0].kind != value.VAL_PARAM) {
        ir.dnit(?m);
        ret 1;
    }
    if (surviving.operands[0].data.param_ix != 0) {
        ir.dnit(?m);
        ret 1;
    }
    if (surviving.operands[1].kind != value.VAL_CONST_INT) {
        ir.dnit(?m);
        ret 1;
    }
    if (surviving.operands[1].data.int_lit != 5) {
        ir.dnit(?m);
        ret 1;
    }

    ir.dnit(?m);
    ret 0;
}

test dbg__marks_unrecoverable_optimized_out {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_blk.ok);

    val p0: value.Value = value.param(0, i64t);

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel res_slot.err) {
        ir.dnit(?m);
        ret 1;
    }
    val slot:  value.Value    = res_slot.ok;
    val r_524: err[fail.Fail] = builder.emit_store(?bld, p0, slot);
    if (sel r_524.err) {
        ir.dnit(?m);
        ret 1;
    }
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?bld, slot, i64t);
    if (sel res_load.err) {
        ir.dnit(?m);
        ret 1;
    }
    val x: value.Value = res_load.ok;

    val res_s: res[value.Value, fail.Fail] = builder.emit_mul(?bld, x, value.const_int(3, i64t));
    if (sel res_s.err) {
        ir.dnit(?m);
        ret 1;
    }
    val s:     value.Value    = res_s.ok;
    val r_532: err[fail.Fail] = builder.emit_dbg_value(?bld, s, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0);
    if (sel r_532.err) {
        ir.dnit(?m);
        ret 1;
    }
    val dbg_id: id.InstructionId = (fn.instr_len - 1)::id.InstructionId;

    val r_535: err[fail.Fail] = builder.emit_ret(?bld, p0);
    if (sel r_535.err) {
        ir.dnit(?m);
        ret 1;
    }

    val r_537: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_537.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_538: res[bool, fail.Fail] = constfold.run(?m);
    if (sel r_538.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_539: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_539.err) {
        ir.dnit(?m);
        ret 1;
    }

    val dbg: *instruction.Instruction = ?fn.instrs[dbg_id::u32];
    if (dbg.kind != instruction.OP_DBG_VALUE) {
        ir.dnit(?m);
        ret 1;
    }
    if (dbg.operand_count != 1) {
        ir.dnit(?m);
        ret 1;
    }
    if (dbg.operands[0].kind != value.VAL_CONST_NULL) {
        ir.dnit(?m);
        ret 1;
    }
    if (ir.dbg_expr_id(fn, dbg_id) != ir.DBG_EXPR_IDENTITY) {
        ir.dnit(?m);
        ret 1;
    }

    ir.dnit(?m);
    ret 0;
}

test dbg__salvage_grows_expression_pool {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel res_i64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId = res_i64.ok;

    val res_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn: *ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_blk.ok);

    val p0: value.Value = value.param(0, i64t);

    var first_dbg: u32 = 0;
    var k:         u64 = 1;
    for (k <= 16) {
        val res_s: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, value.const_int(k, i64t));
        if (sel res_s.err) {
            ir.dnit(?m);
            ret 1;
        }
        val s:     value.Value    = res_s.ok;
        val r_580: err[fail.Fail] = builder.emit_dbg_value(?bld, s, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0);
        if (sel r_580.err) {
            ir.dnit(?m);
            ret 1;
        }
        if (k == 1) { first_dbg = fn.instr_len - 1; }
        k = k + 1;
    }

    val r_585: err[fail.Fail] = builder.emit_ret(?bld, p0);
    if (sel r_585.err) {
        ir.dnit(?m);
        ret 1;
    }

    val r_587: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_587.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_588: res[bool, fail.Fail] = constfold.run(?m);
    if (sel r_588.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_589: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_589.err) {
        ir.dnit(?m);
        ret 1;
    }

    val dbg_id: id.InstructionId         = first_dbg::id.InstructionId;
    val dbg:    *instruction.Instruction = ?fn.instrs[dbg_id::u32];
    if (dbg.kind != instruction.OP_DBG_VALUE) {
        ir.dnit(?m);
        ret 1;
    }
    if (dbg.operands[0].kind != value.VAL_PARAM) {
        ir.dnit(?m);
        ret 1;
    }
    val eid: ir.DbgExprId = ir.dbg_expr_id(fn, dbg_id);
    if (eid == ir.DBG_EXPR_IDENTITY) {
        ir.dnit(?m);
        ret 1;
    }
    val opt_: opt[*ir.DbgExpr] = ir.dbg_expr_get(fn, eid);
    if (sel opt_.none) {
        ir.dnit(?m);
        ret 1;
    }
    val dex: *ir.DbgExpr = opt_.some;
    if (dex.op_count != 1) {
        ir.dnit(?m);
        ret 1;
    }
    if (dex.ops[0].op != ir.DBG_OP_PLUS_CONST) {
        ir.dnit(?m);
        ret 1;
    }
    if (dex.ops[0].arg != 1) {
        ir.dnit(?m);
        ret 1;
    }

    ir.dnit(?m);
    ret 0;
}

test run__simd_require_gate {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn:  intern.Interner = intern.init(?alloc);
    var code: i32             = 0;

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_616: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_616.err) {
        intern.dnit(?itn);
        ret 1;
    }
    val trr: res[resolved.Target, fail.Fail] = target.select(?reg, "riscv64", "linux", "lp64d");
    if (sel trr.err) {
        intern.dnit(?itn);
        ret 1;
    }
    var rv: resolved.Target = trr.ok;

    val rfn: res[intern.StrId, A.Error] = intern.intern(?itn, "kernel");
    if (sel rfn.err) {
        intern.dnit(?itn);
        ret 1;
    }
    val kname: intern.StrId = rfn.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) {
        intern.dnit(?itn);
        ret 1;
    }
    var m:  ir.Module                        = rm.ok;
    val rf: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_float(?m.types, 32);
    if (sel rf.err) {
        ir.dnit(?m);
        intern.dnit(?itn);
        ret 1;
    }
    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, rf.ok, 4);
    if (sel rvt.err) {
        ir.dnit(?m);
        intern.dnit(?itn);
        ret 1;
    }
    val vec: ir_type.IrTypeId    = rvt.ok;
    val rfa: res[u32, fail.Fail] = ir.function_add(?m, kname, vec, 0);
    if (sel rfa.err) {
        ir.dnit(?m);
        intern.dnit(?itn);
        ret 1;
    }
    val fn: *ir.Function    = ?m.functions[rfa.ok];
    var b:  builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) {
        ir.dnit(?m);
        intern.dnit(?itn);
        ret 1;
    }
    builder.set_block(?b, rb.ok);
    val radd: res[value.Value, fail.Fail] = builder.emit_add(?b, value.param(0, vec), value.param(1, vec));
    if (sel radd.ok) {
        val rret: err[fail.Fail] = builder.emit_ret(?b, radd.ok);
        if (sel rret.err) { code = 1; }
    }
    or { code = 1; }

    var preq1: PipelineRequest;
    preq1.module            = ?m;
    preq1.target            = ?rv;
    preq1.level             = OPT_DEBUG;
    preq1.vectorize_enabled = VectorizeEnabledOption{v: true};
    preq1.simd_require      = SimdRequireOption{v: true};
    preq1.float_reassoc     = FloatReassocOption{v: false};
    preq1.interner          = ?itn;
    preq1.source_map        = nil;
    var diags1: diagnostic.DiagnosticStore = diagnostic.store_init(?alloc);
    fin { diagnostic.store_dnit(?diags1); }
    preq1.diags = ?diags1;
    val e1: res[bool, fail.Fail] = run(?preq1);
    if (sel e1.ok) { code = 1; }
    or (sel e1.err) {
        # the refusal is one located error on the store and the pass answers reported
        if (!fail.is_reported(e1.err))            { code = 1; }
        if (diagnostic.error_count(?diags1) != 1) { code = 1; }
        val d1: opt[*diagnostic.Diagnostic] = diagnostic.get(?diags1, 0);
        if (sel d1.none) { code = 1; }
        or (sel d1.some) {
            val msg: str = d1.some.message;
            if (!str_contains(msg, "simd = \"require\"")) { code = 1; }
            if (!str_contains(msg, "add"))                { code = 1; }
            if (!str_contains(msg, "kernel"))             { code = 1; }
            if (!str_contains(msg, "riscv64"))            { code = 1; }
            if (!str_contains(msg, "4 lanes of 32 bits")) { code = 1; }
        }
    }
    ir.dnit(?m);

    val rm2: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm2.err) {
        intern.dnit(?itn);
        ret 1;
    }
    var m2:   ir.Module           = rm2.ok;
    val rfa2: res[u32, fail.Fail] = ir.function_add(?m2, kname, ir_type.IRT_NIL, 0);
    if (sel rfa2.err) {
        ir.dnit(?m2);
        intern.dnit(?itn);
        ret 1;
    }
    val fn2: *ir.Function    = ?m2.functions[rfa2.ok];
    var b2:  builder.Builder = builder.init(?m2);
    builder.set_function(?b2, fn2);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?b2);
    if (sel rb2.err) {
        ir.dnit(?m2);
        intern.dnit(?itn);
        ret 1;
    }
    builder.set_block(?b2, rb2.ok);
    val r_677: err[fail.Fail] = builder.emit_ret_void(?b2);
    if (sel r_677.err) { code = 1; }
    var preq2: PipelineRequest;
    preq2.module            = ?m2;
    preq2.target            = ?rv;
    preq2.level             = OPT_DEBUG;
    preq2.vectorize_enabled = VectorizeEnabledOption{v: true};
    preq2.simd_require      = SimdRequireOption{v: true};
    preq2.float_reassoc     = FloatReassocOption{v: false};
    preq2.interner          = ?itn;
    preq2.source_map        = nil;
    val r_687: res[bool, fail.Fail] = run(?preq2);
    if (sel r_687.err) { code = 1; }
    ir.dnit(?m2);

    # x86-64 packs the 32-bit multiply through the pmuludq sequences (#3739)
    # and scalarizes the 8-bit one; NEON has no 64-bit lane multiply
    if (mul_require_refused(?alloc, ?itn, ?reg, "x86_64", "sysv64", 32) != 0)   { code = 1; }
    if (mul_require_refused(?alloc, ?itn, ?reg, "x86_64", "sysv64", 8) != 1)    { code = 1; }
    if (mul_require_refused(?alloc, ?itn, ?reg, "riscv64", "lp64d", 32) != 1)   { code = 1; }
    if (mul_require_refused(?alloc, ?itn, ?reg, "aarch64", "aapcs64", 32) != 0) { code = 1; }
    if (mul_require_refused(?alloc, ?itn, ?reg, "aarch64", "aapcs64", 64) != 1) { code = 1; }

    intern.dnit(?itn);
    ret code;
}

#[testing]
fun mul_require_refused(alloc: *A.Allocator, itn: *intern.Interner, reg: *target.TargetRegistry, isa_name: str, abi_name: str, lane_bits: u32) i32 {
    val trr: res[resolved.Target, fail.Fail] = target.select(reg, isa_name, "linux", abi_name);
    if (sel trr.err) { ret 2; }
    var rv: resolved.Target = trr.ok;

    val rfn: res[intern.StrId, A.Error] = intern.intern(itn, "kernel");
    if (sel rfn.err) { ret 2; }

    val rm: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel rm.err) { ret 2; }
    var m:  ir.Module                        = rm.ok;
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, lane_bits);
    if (sel ri.err) {
        ir.dnit(?m);
        ret 2;
    }
    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, ri.ok, 128 / lane_bits);
    if (sel rvt.err) {
        ir.dnit(?m);
        ret 2;
    }
    val vec: ir_type.IrTypeId = rvt.ok;

    val rfa: res[u32, fail.Fail] = ir.function_add(?m, rfn.ok, vec, 0);
    if (sel rfa.err) {
        ir.dnit(?m);
        ret 2;
    }
    val fn: *ir.Function    = ?m.functions[rfa.ok];
    var b:  builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) {
        ir.dnit(?m);
        ret 2;
    }
    builder.set_block(?b, rb.ok);

    val rmul: res[value.Value, fail.Fail] = builder.emit_mul(?b, value.param(0, vec), value.param(1, vec));
    if (sel rmul.err) {
        ir.dnit(?m);
        ret 2;
    }
    val r_726: err[fail.Fail] = builder.emit_ret(?b, rmul.ok);
    if (sel r_726.err) {
        ir.dnit(?m);
        ret 2;
    }

    var preq3: PipelineRequest;
    preq3.module            = ?m;
    preq3.target            = ?rv;
    preq3.level             = OPT_DEBUG;
    preq3.vectorize_enabled = VectorizeEnabledOption{v: true};
    preq3.simd_require      = SimdRequireOption{v: true};
    preq3.float_reassoc     = FloatReassocOption{v: false};
    preq3.interner          = itn;
    preq3.source_map        = nil;
    val changed_r: res[bool, fail.Fail] = run(?preq3);
    ir.dnit(?m);
    if (sel changed_r.err) { ret 1; }
    ret 0;
}

test run__undeclared_vector_shape_is_refused_in_every_simd_mode {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_750: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_750.err) { ret 1; }
    val trr: res[resolved.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel trr.err) { ret 1; }
    var rv: resolved.Target = trr.ok;

    # the 8-bit multiply is x86-64's scalar-row cell (the wider lanes pack
    # through the pmuludq sequences since #3739); dropping the scalar rows
    # leaves it undeclared in every simd mode while the packed cells stay
    if (vector_mul_outcome(?alloc, ?itn, ?rv, 8, false) != 0)  { ret 2; }
    if (vector_mul_outcome(?alloc, ?itn, ?rv, 32, false) != 0) { ret 3; }
    rv.model.scalar_form_len = 0;
    val undeclared: i32 = vector_mul_outcome(?alloc, ?itn, ?rv, 8, false);
    if (undeclared != 1)                                        { ret 4; }
    if (vector_mul_outcome(?alloc, ?itn, ?rv, 8, true) != 1)    { ret 5; }
    if (vector_mul_outcome(?alloc, ?itn, ?rv, 32, false) != 0)  { ret 6; }
    if (vector_mul_outcome(?alloc, ?itn, ?rv, 128, false) != 3) { ret 7; }
    ret 0;
}

# a uniform shift count packs on x86-64 at every lane width but the 64-bit
# arithmetic shift, and a per-lane count packs nowhere on the SSE2 baseline, so
# simd = "require" accepts the first and refuses the other two, naming the
# count's form (#3740)
test run__simd_require_judges_a_shift_by_its_count_form {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val rr: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel rr.err) { ret 1; }
    val trr: res[resolved.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel trr.err) { ret 1; }
    var rv: resolved.Target = trr.ok;

    var bits: u32 = 8;
    for (bits <= 64) {
        if (vector_shift_outcome(?alloc, ?itn, ?rv, instruction.OP_SHL, bits, true) != 0)    { ret 2; }
        if (vector_shift_outcome(?alloc, ?itn, ?rv, instruction.OP_SHR_U, bits, true) != 0)  { ret 3; }
        if (vector_shift_outcome(?alloc, ?itn, ?rv, instruction.OP_SHL, bits, false) != 1)   { ret 4; }
        if (vector_shift_outcome(?alloc, ?itn, ?rv, instruction.OP_SHR_S, bits, false) != 1) { ret 5; }
        bits = bits * 2;
    }
    if (vector_shift_outcome(?alloc, ?itn, ?rv, instruction.OP_SHR_S, 32, true) != 0) { ret 6; }
    if (vector_shift_outcome(?alloc, ?itn, ?rv, instruction.OP_SHR_S, 64, true) != 1) { ret 7; }
    ret 0;
}

# 0 when simd = "require" accepts the vector shift by a scalar count
# (`uniform`) or by a vector of lane counts, 1 when it refuses it naming the
# operation and its count form, 2 for any other outcome
#[testing]
fun vector_shift_outcome(alloc: *A.Allocator, itn: *intern.Interner, rv: *resolved.Target,
    kind: instruction.InstrKind, lane_bits: u32, uniform: bool) i32 {
    val rfn: res[intern.StrId, A.Error] = intern.intern(itn, "kernel");
    if (sel rfn.err) { ret 9; }
    val rm: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel rm.err) { ret 9; }
    var m: ir.Module = rm.ok;
    fin { ir.dnit(?m); }
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, lane_bits);
    if (sel ri.err) { ret 9; }
    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, ri.ok, 128 / lane_bits);
    if (sel rvt.err) { ret 9; }
    val vec:      ir_type.IrTypeId = rvt.ok;
    var count_ty: ir_type.IrTypeId = vec;
    if (uniform) { count_ty = ri.ok; }
    val rfa: res[u32, fail.Fail] = ir.function_add(?m, rfn.ok, vec, 0);
    if (sel rfa.err) { ret 9; }
    val fn:   *ir.Function               = ?m.functions[rfa.ok];
    val args: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, 2);
    if (sel args.err) { ret 9; }
    fn.params      = args.ok;
    fn.param_count = 2;
    fn.params[0]   = value.param(0, vec);
    fn.params[1]   = value.param(1, count_ty);
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ret 9; }
    builder.set_block(?b, rb.ok);
    var rsh: res[value.Value, fail.Fail] = builder.emit_shl(?b, value.param(0, vec), value.param(1, count_ty));
    if (kind == instruction.OP_SHR_U) { rsh = builder.emit_shr_u(?b, value.param(0, vec), value.param(1, count_ty)); }
    if (kind == instruction.OP_SHR_S) { rsh = builder.emit_shr_s(?b, value.param(0, vec), value.param(1, count_ty)); }
    if (sel rsh.err)                  { ret 9; }
    val rret: err[fail.Fail] = builder.emit_ret(?b, rsh.ok);
    if (sel rret.err) { ret 9; }
    var preq: PipelineRequest;
    preq.module            = ?m;
    preq.target            = rv;
    preq.level             = OPT_DEBUG;
    preq.vectorize_enabled = VectorizeEnabledOption{v: false};
    preq.simd_require      = SimdRequireOption{v: true};
    preq.float_reassoc     = FloatReassocOption{v: false};
    preq.interner          = itn;
    preq.source_map        = nil;
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    fin { diagnostic.store_dnit(?diags); }
    preq.diags = ?diags;
    val r: res[bool, fail.Fail] = run(?preq);
    if (sel r.ok)                                                        { ret 0; }
    if (!fail.is_reported(r.err) || diagnostic.error_count(?diags) != 1) { ret 2; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?diags, 0);
    if (sel d.none) { ret 2; }
    val msg:  str = d.some.message;
    var form: str = "by per-lane counts";
    if (uniform) { form = "by a uniform count"; }
    if (str_contains(msg, "simd = \"require\"") && str_contains(msg, form) && str_contains(msg, "shift")
        && str_contains(msg, lane_text(lane_bits))) { ret 1; }
    ret 2;
}

#[testing]
fun lane_text(lane_bits: u32) str {
    if (lane_bits == 8)  { ret "16 lanes of 8 bits"; }
    if (lane_bits == 16) { ret "8 lanes of 16 bits"; }
    if (lane_bits == 32) { ret "4 lanes of 32 bits"; }
    ret "2 lanes of 64 bits";
}

# 0 when the pipeline accepts the vector multiply, 1 when it refuses it as an
# undeclared cell, 3 when it refuses the lane shape as outside the vocabulary,
# 10 to 12 when a refusal is not one located error answered as reported
#[testing]
fun vector_mul_outcome(alloc: *A.Allocator, itn: *intern.Interner, rv: *resolved.Target, lane_bits: u32, require: bool) i32 {
    val rfn: res[intern.StrId, A.Error] = intern.intern(itn, "kernel");
    if (sel rfn.err) { ret 9; }
    val rm: res[ir.Module, fail.Fail] = ir.init(alloc, intern.STR_NIL);
    if (sel rm.err) { ret 9; }
    var m:  ir.Module                        = rm.ok;
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, lane_bits);
    if (sel ri.err) {
        ir.dnit(?m);
        ret 9;
    }
    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, ri.ok, 128 / lane_bits);
    if (sel rvt.err) {
        ir.dnit(?m);
        ret 9;
    }
    val vec: ir_type.IrTypeId    = rvt.ok;
    val rfa: res[u32, fail.Fail] = ir.function_add(?m, rfn.ok, vec, 0);
    if (sel rfa.err) {
        ir.dnit(?m);
        ret 9;
    }
    val fn:   *ir.Function               = ?m.functions[rfa.ok];
    val args: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, 2);
    if (sel args.err) {
        ir.dnit(?m);
        ret 9;
    }
    fn.params      = args.ok;
    fn.param_count = 2;
    fn.params[0]   = value.param(0, vec);
    fn.params[1]   = value.param(1, vec);
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) {
        ir.dnit(?m);
        ret 9;
    }
    builder.set_block(?b, rb.ok);
    val rmul: res[value.Value, fail.Fail] = builder.emit_mul(?b, value.param(0, vec), value.param(1, vec));
    if (sel rmul.err) {
        ir.dnit(?m);
        ret 9;
    }
    val r_795: err[fail.Fail] = builder.emit_ret(?b, rmul.ok);
    if (sel r_795.err) {
        ir.dnit(?m);
        ret 9;
    }
    var preq: PipelineRequest;
    preq.module            = ?m;
    preq.target            = rv;
    preq.level             = OPT_DEBUG;
    preq.vectorize_enabled = VectorizeEnabledOption{v: false};
    preq.simd_require      = SimdRequireOption{v: require};
    preq.float_reassoc     = FloatReassocOption{v: false};
    preq.interner          = itn;
    preq.source_map        = nil;
    var diags: diagnostic.DiagnosticStore = diagnostic.store_init(alloc);
    fin { diagnostic.store_dnit(?diags); }
    preq.diags = ?diags;
    val r: res[bool, fail.Fail] = run(?preq);
    ir.dnit(?m);
    if (sel r.ok) { ret 0; }
    # a refusal is one located error on the store, answered as reported
    if (!fail.is_reported(r.err))            { ret 10; }
    if (diagnostic.error_count(?diags) != 1) { ret 11; }
    val d: opt[*diagnostic.Diagnostic] = diagnostic.get(?diags, 0);
    if (sel d.none) { ret 12; }
    val msg: str = d.some.message;
    if (str_contains(msg, "outside the retained vocabulary") && str_contains(msg, "multiply")
        && str_contains(msg, "kernel") && str_contains(msg, "x86_64")) { ret 3; }
    if (str_contains(msg, "has no declared form on x86_64") && str_contains(msg, "multiply")
        && str_contains(msg, "kernel") && str_contains(msg, lane_text(lane_bits))) { ret 1; }
    ret 2;
}

test run__reports_the_change_a_pass_made {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    fin { intern.dnit(?itn); }

    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_824: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_824.err) { ret 1; }
    val trr: res[resolved.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel trr.err) { ret 1; }
    var rv: resolved.Target = trr.ok;

    val rfn: res[intern.StrId, A.Error] = intern.intern(?itn, "f");
    if (sel rfn.err) { ret 1; }
    val fname: intern.StrId = rfn.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    fin { ir.dnit(?m); }
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel ri.err) { ret 1; }
    val i32_ty: ir_type.IrTypeId    = ri.ok;
    val rfa:    res[u32, fail.Fail] = ir.function_add(?m, fname, i32_ty, 0);
    if (sel rfa.err) { ret 1; }
    val fn: *ir.Function    = ?m.functions[rfa.ok];
    var b:  builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ret 1; }
    builder.set_block(?b, rb.ok);
    val radd: res[value.Value, fail.Fail] = builder.emit_add(?b,
        value.const_int(2, i32_ty), value.const_int(3, i32_ty));
    if (sel radd.err) { ret 1; }
    val r_851: err[fail.Fail] = builder.emit_ret(?b, radd.ok);
    if (sel r_851.err) { ret 1; }

    var preq: PipelineRequest = t_ready_request();
    preq.module   = ?m;
    preq.target   = ?rv;
    preq.interner = ?itn;
    val e: res[bool, fail.Fail] = run(?preq);
    if (sel e.err) { ret 1; }
    if (!e.ok)     { ret 1; }

    val rm2: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm2.err) { ret 1; }
    var m2: ir.Module = rm2.ok;
    fin { ir.dnit(?m2); }
    val rfa2: res[u32, fail.Fail] = ir.function_add(?m2, fname, ir_type.IRT_NIL, 0);
    if (sel rfa2.err) { ret 1; }
    val fn2: *ir.Function    = ?m2.functions[rfa2.ok];
    var b2:  builder.Builder = builder.init(?m2);
    builder.set_function(?b2, fn2);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?b2);
    if (sel rb2.err) { ret 1; }
    builder.set_block(?b2, rb2.ok);
    val r_873: err[fail.Fail] = builder.emit_ret_void(?b2);
    if (sel r_873.err) { ret 1; }

    var preq2: PipelineRequest = t_ready_request();
    preq2.module   = ?m2;
    preq2.target   = ?rv;
    preq2.interner = ?itn;
    val e2: res[bool, fail.Fail] = run(?preq2);
    if (sel e2.err) { ret 1; }
    if (e2.ok)      { ret 1; }
    ret 0;
}

test passes__do_not_retain_function_work_in_ir {
    var backing: A.Allocator;
    val r_887:   err[A.Error] = page.make(?backing);
    if (sel r_887.err) { ret 1; }
    var owner: arena.Arena;
    val r_889: err[A.Error] = arena.init(?owner, ?backing, 0);
    if (sel r_889.err) { ret 1; }
    fin { arena.dnit(?owner); }
    var alloc: A.Allocator;
    val r_892: err[A.Error] = arena.make(?alloc, ?owner);
    if (sel r_892.err) { ret 1; }
    val initialized: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel initialized.err) { ret 1; }
    var module: ir.Module = initialized.ok;
    fin { ir.dnit(?module); }
    val typed: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?module.types, 64);
    if (sel typed.err) { ret 1; }
    val ty:    ir_type.IrTypeId    = typed.ok;
    val added: res[u32, fail.Fail] = ir.function_add(?module, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel added.err) { ret 1; }
    val fn:    *ir.Function    = ?module.functions[added.ok];
    var build: builder.Builder = builder.init(?module);
    builder.set_function(?build, fn);
    val block: res[id.BlockId, fail.Fail] = builder.new_block(?build);
    if (sel block.err) { ret 1; }
    builder.set_block(?build, block.ok);
    val r_908: err[fail.Fail] = builder.emit_ret(?build, value.const_int(42, ty));
    if (sel r_908.err) { ret 1; }
    var registry: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?registry); }
    val r_911: err[fail.Fail] = target.register_all(?registry, target_testing.debug_descriptor);
    if (sel r_911.err) { ret 1; }
    val selected: res[target.Target, fail.Fail] = target.select(?registry, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 1; }
    var tgt:   target.Target        = selected.ok;
    val r_915: res[bool, fail.Fail] = sroa.run(?module, ?tgt);
    if (sel r_915.err) { ret 2; }
    val chunk:  *arena.Chunk = owner.chunk;
    val offset: usize        = owner.off;
    var repeat: u32          = 0;
    for (repeat < 8) {
        val r_920: res[bool, fail.Fail] = mem2reg.run(?module);
        if (sel r_920.err)                               { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 3; }
        val r_922: res[bool, fail.Fail] = constfold.run(?module);
        if (sel r_922.err)                               { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 4; }
        val r_924: res[bool, fail.Fail] = cse.run(?module);
        if (sel r_924.err)                               { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 5; }
        val r_926: res[bool, fail.Fail] = dce.run(?module);
        if (sel r_926.err)                               { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 6; }
        val r_928: res[bool, fail.Fail] = algebraic.run(?module);
        if (sel r_928.err)                               { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 8; }
        var context: VerifyCtx      = VerifyCtx{tgt: nil, itn: nil, srcmap: nil};
        val r_931:   err[fail.Fail] = run_verify(?module, true, false, ?context);
        if (sel r_931.err)                               { ret 9; }
        if (owner.chunk != chunk || owner.off != offset) { ret 10; }
        val r_933: res[bool, fail.Fail] = licm.run(?module, ?tgt);
        if (sel r_933.err)                               { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 11; }
        val r_935: res[bool, fail.Fail] = sroa.run(?module, ?tgt);
        if (sel r_935.err)                               { ret 2; }
        if (owner.chunk != chunk || owner.off != offset) { ret 12; }
        val term: id.InstructionId = fn.blocks[0].terminator;
        if (fn.block_count != 1 || term == id.INSTR_NIL)         { ret 7; }
        if (fn.instrs[term::u32].operands[0].data.int_lit != 42) { ret 7; }
        repeat = repeat + 1;
    }
    ret 0;
}

fun inline_available(m: *ir.Module, tgt: *target.Target, available: *body.Available, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    val attached: err[fail.Fail] = body.attach(available, m);
    if (sel attached.err) { ret res[bool, fail.Fail].err{attached.err}; }
    fin { body.detach(available, m); }
    ret inline.run_in(m, tgt, available, nil, workspace);
}

# the fail-at-N fixture for the whole pipeline: a slot stored in both arms
# of a diamond on a constant condition and loaded at the join, which every
# release pass touches in turn
#[testing]
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 1; }
    val i64t: ir_type.IrTypeId    = ri.ok;
    val rfa:  res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rfa.err) { ret 2; }
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[rfa.ok]);
    val rb0: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    val rb1: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    val rb2: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    val rb3: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb0.err) { ret 3; }
    if (sel rb1.err) { ret 3; }
    if (sel rb2.err) { ret 3; }
    if (sel rb3.err) { ret 3; }
    builder.set_block(?b, rb0.ok);
    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?b, i64t, value.const_int(1, i64t));
    if (sel res_slot.err) { ret 4; }
    val res_cond: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, value.const_int(2, i64t), value.const_int(2, i64t));
    if (sel res_cond.err) { ret 5; }
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?b, res_cond.ok, rb1.ok, rb2.ok);
    if (sel r_cbr.err) { ret 6; }
    builder.set_block(?b, rb1.ok);
    val r_s1: err[fail.Fail] = builder.emit_store(?b, value.param(0, i64t), res_slot.ok);
    if (sel r_s1.err) { ret 7; }
    val r_b1: err[fail.Fail] = builder.emit_br(?b, rb3.ok);
    if (sel r_b1.err) { ret 8; }
    builder.set_block(?b, rb2.ok);
    val res_sum: res[value.Value, fail.Fail] = builder.emit_add(?b, value.param(0, i64t), value.param(0, i64t));
    if (sel res_sum.err) { ret 9; }
    val r_s2: err[fail.Fail] = builder.emit_store(?b, res_sum.ok, res_slot.ok);
    if (sel r_s2.err) { ret 10; }
    val r_b2: err[fail.Fail] = builder.emit_br(?b, rb3.ok);
    if (sel r_b2.err) { ret 11; }
    builder.set_block(?b, rb3.ok);
    val res_load: res[value.Value, fail.Fail] = builder.emit_load(?b, res_slot.ok, i64t);
    if (sel res_load.err) { ret 12; }
    val res_out: res[value.Value, fail.Fail] = builder.emit_xor(?b, res_load.ok, value.const_int(0, i64t));
    if (sel res_out.err) { ret 13; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?b, res_out.ok);
    if (sel r_ret.err) { ret 14; }
    ret 0;
}

#[testing]
fun probe_pipeline(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    var itn: intern.Interner = intern.init(a.context::*A.Allocator);
    fin { intern.dnit(?itn); }
    var preq: PipelineRequest = t_ready_request();
    preq.module   = m;
    preq.target   = a.target;
    preq.level    = OPT_RELEASE;
    preq.interner = ?itn;
    val r: res[bool, fail.Fail] = run(?preq);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

#[testing]
fun probe_verify(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    var context: VerifyCtx = VerifyCtx{tgt: a.target, itn: nil, srcmap: nil};
    ret verify_in(m, true, false, ?context, workspace);
}

# the pipeline is the passes in sequence, so its remainder is whichever
# pass met the refusal: the module stays releasable with its one function
#[testing]
fun probe_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    ret m.function_len == a.control.function_len;
}

#[testing]
fun probe_walk(transform: fun(*me_testing.Attempt, *ir.Module, *scratch.Workspace) err[fail.Fail],
    contract: fun(*me_testing.Attempt, *ir.Module, usize) bool) i32 {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val registered: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val selected: res[resolved.Target, fail.Fail] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (sel selected.err) { ret 3; }
    var tgt: resolved.Target    = selected.ok;
    var a:   me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: transform,
        contract: contract, target: ?tgt, control: nil, context: (?owner)::ptr};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 4; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}

test run__refusal_at_every_module_ordinal_leaves_a_releasable_module {
    ret probe_walk(probe_pipeline, probe_contract);
}

# the verifier reads the module and writes only its scratch report, so a
# refusal leaves the input unchanged
test verify_in__refusal_at_every_ordinal_leaves_the_input_unchanged {
    ret probe_walk(probe_verify, nil);
}
