use std.allocator.page;
use std.allocator.arena;
use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;
use std.types.size.usize;
use std.types.string.str_contains;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use semtype: mach.lang.type;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.ir.verify;
use mach.lang.me.pass.algebraic;
use mach.lang.me.pass.constfold;
use mach.lang.me.pass.cse;
use mach.lang.me.pass.dce;
use mach.lang.me.pass.inline;
use mach.lang.me.pass.mem2reg;
use mach.lang.me.pass.scalarize;
use mach.lang.me.transform.licm;
use mach.lang.me.transform.sroa;
use mach.lang.me.transform.vectorize;
use mach.lang.source;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.me.vecform;
use mach.lang.target.resolved;

pub def OptLevel: u8;

pub val OPT_DEBUG:   OptLevel = 0;
pub val OPT_RELEASE: OptLevel = 1;

pub rec VectorizeEnabledOption { v: bool; }
pub rec SimdRequireOption      { v: bool; }
pub rec FloatReassocOption     { v: bool; }

pub rec PipelineRequest {
    module:            *ir.Module;
    target:            *target.Target;
    level:             OptLevel;
    vectorize_enabled: VectorizeEnabledOption;
    simd_require:      SimdRequireOption;
    float_reassoc:     FloatReassocOption;
    interner:          *intern.Interner;
    source_map:        *source.SourceMap;
}

pub fun run(req: *PipelineRequest) R.Result[bool, str] {
    if (req.module == nil)   { ret R.err[bool, str]("pipeline request: module is required"); }
    if (req.target == nil)   { ret R.err[bool, str]("pipeline request: target is required"); }
    if (req.interner == nil) { ret R.err[bool, str]("pipeline request: interner is required"); }

    ret run_impl(req.module, req.target, req.level, req.vectorize_enabled.v,
                 req.simd_require.v, req.float_reassoc.v, req.interner, req.source_map);
}

fun run_impl(m: *ir.Module, tgt: *target.Target, level: OptLevel, vectorize_enabled: bool, simd_require: bool, float_reassoc: bool, itn: *intern.Interner, srcmap: *source.SourceMap) R.Result[bool, str] {
    var vc: VerifyCtx;
    vc.tgt       = tgt;
    vc.itn       = itn;
    vc.srcmap    = srcmap;

    var changed: bool = false;

    val res_verify_in: R.Result[R.Void, str] = run_verify(m, false, true, ?vc);
    if (R.is_err[R.Void, str](res_verify_in)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_in)); }

    val mem2reg_changed_r: R.Result[bool, str] = mem2reg.run(m);
    if (R.is_err[bool, str](mem2reg_changed_r)) { ret mem2reg_changed_r; }
    if (R.unwrap_ok[bool, str](mem2reg_changed_r)) { changed = true; }
    val res_verify_mem2reg: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
    if (R.is_err[R.Void, str](res_verify_mem2reg)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_mem2reg)); }

    val constfold_changed_r: R.Result[bool, str] = constfold.run(m);
    if (R.is_err[bool, str](constfold_changed_r)) { ret constfold_changed_r; }
    if (R.unwrap_ok[bool, str](constfold_changed_r)) { changed = true; }
    val res_verify_constfold: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
    if (R.is_err[R.Void, str](res_verify_constfold)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_constfold)); }

    val dce_changed_r: R.Result[bool, str] = dce.run(m);
    if (R.is_err[bool, str](dce_changed_r)) { ret dce_changed_r; }
    if (R.unwrap_ok[bool, str](dce_changed_r)) { changed = true; }
    val res_verify_dce: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
    if (R.is_err[R.Void, str](res_verify_dce)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_dce)); }

    if (level == OPT_RELEASE) {
        val inline_changed_r: R.Result[bool, str] = inline.run(m, tgt, nil);
        if (R.is_err[bool, str](inline_changed_r)) { ret inline_changed_r; }
        if (R.unwrap_ok[bool, str](inline_changed_r)) { changed = true; }
        val res_verify_inline: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
        if (R.is_err[R.Void, str](res_verify_inline)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_inline)); }

        val mem2reg2_changed_r: R.Result[bool, str] = mem2reg.run(m);
        if (R.is_err[bool, str](mem2reg2_changed_r)) { ret mem2reg2_changed_r; }
        if (R.unwrap_ok[bool, str](mem2reg2_changed_r)) { changed = true; }
        val res_verify_mem2reg2: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
        if (R.is_err[R.Void, str](res_verify_mem2reg2)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_mem2reg2)); }

        val constfold2_changed_r: R.Result[bool, str] = constfold.run(m);
        if (R.is_err[bool, str](constfold2_changed_r)) { ret constfold2_changed_r; }
        if (R.unwrap_ok[bool, str](constfold2_changed_r)) { changed = true; }
        val res_verify_constfold2: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
        if (R.is_err[R.Void, str](res_verify_constfold2)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_constfold2)); }

        val dce_pre_changed_r: R.Result[bool, str] = dce.run(m);
        if (R.is_err[bool, str](dce_pre_changed_r)) { ret dce_pre_changed_r; }
        if (R.unwrap_ok[bool, str](dce_pre_changed_r)) { changed = true; }
        val res_verify_dce_pre: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
        if (R.is_err[R.Void, str](res_verify_dce_pre)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_dce_pre)); }

        val sroa_changed_r: R.Result[bool, str] = sroa.run(m, tgt);
        if (R.is_err[bool, str](sroa_changed_r)) { ret sroa_changed_r; }
        if (R.unwrap_ok[bool, str](sroa_changed_r)) {
            changed = true;
            val res_verify_sroa: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
            if (R.is_err[R.Void, str](res_verify_sroa)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_sroa)); }

            val mem2reg3_changed_r: R.Result[bool, str] = mem2reg.run(m);
            if (R.is_err[bool, str](mem2reg3_changed_r)) { ret mem2reg3_changed_r; }
            if (R.unwrap_ok[bool, str](mem2reg3_changed_r)) { changed = true; }
            val res_verify_mem2reg3: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
            if (R.is_err[R.Void, str](res_verify_mem2reg3)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_mem2reg3)); }
        }

        val algebraic_changed_r: R.Result[bool, str] = algebraic.run(m);
        if (R.is_err[bool, str](algebraic_changed_r)) { ret algebraic_changed_r; }
        if (R.unwrap_ok[bool, str](algebraic_changed_r)) { changed = true; }
        val res_verify_algebraic: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
        if (R.is_err[R.Void, str](res_verify_algebraic)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_algebraic)); }

        val cse_changed_r: R.Result[bool, str] = cse.run(m);
        if (R.is_err[bool, str](cse_changed_r)) { ret cse_changed_r; }
        if (R.unwrap_ok[bool, str](cse_changed_r)) { changed = true; }
        val res_verify_cse: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
        if (R.is_err[R.Void, str](res_verify_cse)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_cse)); }

        val constfold3_changed_r: R.Result[bool, str] = constfold.run(m);
        if (R.is_err[bool, str](constfold3_changed_r)) { ret constfold3_changed_r; }
        if (R.unwrap_ok[bool, str](constfold3_changed_r)) { changed = true; }
        val res_verify_constfold3: R.Result[R.Void, str] = verify_stage(m, false, ?vc);
        if (R.is_err[R.Void, str](res_verify_constfold3)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_constfold3)); }

        val dce2_changed_r: R.Result[bool, str] = dce.run(m);
        if (R.is_err[bool, str](dce2_changed_r)) { ret dce2_changed_r; }
        if (R.unwrap_ok[bool, str](dce2_changed_r)) { changed = true; }
        val res_verify_dce2: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
        if (R.is_err[R.Void, str](res_verify_dce2)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_dce2)); }

        val licm_changed_r: R.Result[bool, str] = licm.run(m, tgt);
        if (R.is_err[bool, str](licm_changed_r)) { ret licm_changed_r; }
        if (R.unwrap_ok[bool, str](licm_changed_r)) { changed = true; }
        val res_verify_licm: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
        if (R.is_err[R.Void, str](res_verify_licm)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_licm)); }

        if (tgt.model.has_v128 && vectorize_enabled) {
            val vec_changed_r: R.Result[bool, str] = vectorize.run(m, tgt, float_reassoc);
            if (R.is_err[bool, str](vec_changed_r)) { ret vec_changed_r; }
            if (R.unwrap_ok[bool, str](vec_changed_r)) {
                changed = true;
                val dce_vec_changed_r: R.Result[bool, str] = dce.run(m);
                if (R.is_err[bool, str](dce_vec_changed_r)) { ret dce_vec_changed_r; }
                val res_verify_vec: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
                if (R.is_err[R.Void, str](res_verify_vec)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_vec)); }
            }
        }
    }

    if (simd_require) {
        val res_req: R.Result[R.Void, str] = require_check(m, tgt, itn);
        if (R.is_err[R.Void, str](res_req)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_req)); }
    }

    val place_changed_r: R.Result[bool, str] = scalarize.run(m, tgt);
    if (R.is_err[bool, str](place_changed_r)) { ret place_changed_r; }
    if (R.unwrap_ok[bool, str](place_changed_r)) { changed = true; }
    val res_verify_place: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
    if (R.is_err[R.Void, str](res_verify_place)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_place)); }

    if (tgt.model.has_v128 && !simd_require) {
        val gap_changed_r: R.Result[bool, str] = scalarize.expand_gap_ops(m, tgt);
        if (R.is_err[bool, str](gap_changed_r)) { ret gap_changed_r; }
        if (R.unwrap_ok[bool, str](gap_changed_r)) { changed = true; }
        val res_verify_gap: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
        if (R.is_err[R.Void, str](res_verify_gap)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_gap)); }
    }

    val lanes_changed_r: R.Result[bool, str] = scalarize.expand_lane_ops(m, tgt);
    if (R.is_err[bool, str](lanes_changed_r)) { ret lanes_changed_r; }
    if (R.unwrap_ok[bool, str](lanes_changed_r)) { changed = true; }
    if (!tgt.model.has_lane_ops && tgt.model.has_v128) {
        val res_verify_lanes: R.Result[R.Void, str] = verify_stage(m, true, ?vc);
        if (R.is_err[R.Void, str](res_verify_lanes)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_lanes)); }
    }

    val res_verify_out: R.Result[R.Void, str] = run_verify(m, true, true, ?vc);
    if (R.is_err[R.Void, str](res_verify_out)) { ret R.err[bool, str](R.unwrap_err[R.Void, str](res_verify_out)); }
    ret R.ok[bool, str](changed);
}

fun require_check(m: *ir.Module, tgt: *target.Target, itn: *intern.Interner) R.Result[R.Void, str] {
    var site: scalarize.ScalarizeSite;
    val count: u32 = scalarize.detect(m, tgt, ?site);
    if (count == 0) { ret R.ok_void[str](); }
    ret R.err[R.Void, str](require_msg(m, tgt, itn, ?site));
}

fun require_msg(m: *ir.Module, tgt: *target.Target, itn: *intern.Interner, site: *scalarize.ScalarizeSite) str {
    val op: str = vecform.vec_op_name(vecform.vec_op_of(site.op));
    var fname: str = "<anonymous>";
    val on: O.Option[str] = intern.lookup(itn, site.fn_name);
    if (O.is_some[str](on)) { fname = O.unwrap[str](on); }

    var why: str = "target has no packed form for this operation at this lane width";
    if (!tgt.model.has_v128) { why = "target has no 128-bit SIMD"; }
    or {
        val cap: u32 = vecform.packed_lanes(tgt, site.lane_bits);
        if (cap != 0 && site.lanes > cap) {
            why = "this shape has more lanes than one packed vector holds on this target";
        }
    }

    val rj: R.Result[str, str] = format.sprint(m.alloc,
        "simd = \"require\": vector {} on {} lanes of {} bits in '{}' would scalarize on {} ({}); set simd = \"scalarize\" to build with the scalar expansion",
        op, site.lanes, site.lane_bits, fname, tgt.isa.name, why);
    if (R.is_err[str, str](rj)) { ret R.unwrap_err[str, str](rj); }
    ret R.unwrap_ok[str, str](rj);
}

rec VerifyCtx {
    tgt:       *target.Target;
    itn:       *intern.Interner;
    srcmap:    *source.SourceMap;
}

fun verify_stage(m: *ir.Module, full: bool, vc: *VerifyCtx) R.Result[R.Void, str] {
    ret run_verify(m, full, true, vc);
}

rec VerifyWork {
    module: *ir.Module;
    context: *VerifyCtx;
    full: bool;
    repr: bool;
}

fun run_verify(m: *ir.Module, full: bool, repr: bool, vc: *VerifyCtx) R.Result[R.Void, str] {
    var workspace: scratch.Workspace;
    val initialized: O.Option[str] = scratch.init(?workspace);
    if (O.is_some[str](initialized)) { ret R.err[R.Void, str](O.unwrap[str](initialized)); }
    fin { scratch.dnit(?workspace); }
    var work: VerifyWork = VerifyWork{module: m, context: vc, full: full, repr: repr};
    ret scratch.run[VerifyWork, R.Void](?workspace, m.alloc, ?work, verify_work);
}

fun verify_work(work: *VerifyWork, alloc: *A.Allocator) R.Result[R.Void, str] {
    val m: *ir.Module = work.module;
    val vc: *VerifyCtx = work.context;
    val res_report: R.Result[verify.VerifyReport, str] =
        verify.verify_module_ext(m, alloc, verify.opts(vc.tgt, work.full, work.repr));
    if (R.is_err[verify.VerifyReport, str](res_report)) {
        ret R.err[R.Void, str](R.unwrap_err[verify.VerifyReport, str](res_report));
    }
    var report: verify.VerifyReport = R.unwrap_ok[verify.VerifyReport, str](res_report);
    fin { verify.dnit_report(?report); }
    if (report.len == 0) { ret R.ok_void[str](); }
    val msg: str = verify.describe_located(m, ?report.violations[0], vc.itn, vc.srcmap, alloc);
    ret R.err[R.Void, str](msg);
}

fun t_ready_request() PipelineRequest {
    var req: PipelineRequest;
    req.module            = nil;
    req.target             = nil;
    req.level               = OPT_DEBUG;
    req.vectorize_enabled   = VectorizeEnabledOption{ v: false };
    req.simd_require        = SimdRequireOption{ v: false };
    req.float_reassoc       = FloatReassocOption{ v: false };
    req.interner            = nil;
    req.source_map          = nil;
    ret req;
}

test "mach.lang.me.pipeline.run:rejects_a_request_missing_module" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    var rv: target.Target;

    var req: PipelineRequest = t_ready_request();
    req.target   = ?rv;
    req.interner = ?itn;
    if (R.is_ok[bool, str](run(?req))) { ret 1; }
    ret 0;
}

test "mach.lang.me.pipeline.run:rejects_a_request_missing_target" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    var itn: intern.Interner = intern.init(?alloc);
    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    var req: PipelineRequest = t_ready_request();
    req.module   = ?m;
    req.interner = ?itn;
    val rc: bool = R.is_ok[bool, str](run(?req));
    ir.dnit(?m);
    if (rc) { ret 1; }
    ret 0;
}

test "mach.lang.me.pipeline.run:rejects_a_request_missing_interner" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    var rv: target.Target;

    var req: PipelineRequest = t_ready_request();
    req.module = ?m;
    req.target  = ?rv;
    val rc: bool = R.is_ok[bool, str](run(?req));
    ir.dnit(?m);
    if (rc) { ret 1; }
    ret 0;
}

test "mach.lang.me.pipeline.loc:survives_mem2reg_constfold_dce" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val res_i64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_i64)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_blk)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_blk));

    val p0: value.Value = value.param(0, i64t);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](res_slot)) { ir.dnit(?m); ret 1; }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);
    if (R.is_err[R.Void, str](builder.emit_store(?bld, p0, slot))) { ir.dnit(?m); ret 1; }
    val res_load: R.Result[value.Value, str] = builder.emit_load(?bld, slot, i64t);
    if (R.is_err[value.Value, str](res_load)) { ir.dnit(?m); ret 1; }
    val x: value.Value = R.unwrap_ok[value.Value, str](res_load);

    val res_k: R.Result[value.Value, str] = builder.emit_add(?bld, value.const_int(2, i64t), value.const_int(3, i64t));
    if (R.is_err[value.Value, str](res_k)) { ir.dnit(?m); ret 1; }
    val k: value.Value = R.unwrap_ok[value.Value, str](res_k);

    builder.set_loc(?bld, source.loc(9, 500));
    val res_s: R.Result[value.Value, str] = builder.emit_add(?bld, x, k);
    if (R.is_err[value.Value, str](res_s)) { ir.dnit(?m); ret 1; }
    val s: value.Value = R.unwrap_ok[value.Value, str](res_s);
    val s_id: id.InstructionId = s.data.instr;

    if (R.is_err[R.Void, str](builder.emit_ret(?bld, s))) { ir.dnit(?m); ret 1; }

    if (R.is_err[bool, str](mem2reg.run(?m)))   { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](constfold.run(?m))) { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](dce.run(?m)))       { ir.dnit(?m); ret 1; }

    val surviving: *instruction.Instruction = ?fn.instrs[s_id::u32];
    if (surviving.kind != instruction.OP_ADD)   { ir.dnit(?m); ret 1; }
    if (surviving.loc.file != 9)                { ir.dnit(?m); ret 1; }
    if (surviving.loc.offset != 500)            { ir.dnit(?m); ret 1; }

    if (surviving.operands[0].kind != value.VAL_PARAM)     { ir.dnit(?m); ret 1; }
    if (surviving.operands[0].data.param_ix != 0)          { ir.dnit(?m); ret 1; }
    if (surviving.operands[1].kind != value.VAL_CONST_INT) { ir.dnit(?m); ret 1; }
    if (surviving.operands[1].data.int_lit != 5)           { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.pipeline.dbg:salvages_folded_add_to_expression" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val res_i64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_i64)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i64);

    val res_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](res_fn)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](res_fn)];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](res_blk)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](res_blk));

    val p0: value.Value = value.param(0, i64t);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](res_slot)) { ir.dnit(?m); ret 1; }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);
    if (R.is_err[R.Void, str](builder.emit_store(?bld, p0, slot))) { ir.dnit(?m); ret 1; }
    val res_load: R.Result[value.Value, str] = builder.emit_load(?bld, slot, i64t);
    if (R.is_err[value.Value, str](res_load)) { ir.dnit(?m); ret 1; }
    val x: value.Value = R.unwrap_ok[value.Value, str](res_load);

    val res_s: R.Result[value.Value, str] = builder.emit_add(?bld, x, value.const_int(4, i64t));
    if (R.is_err[value.Value, str](res_s)) { ir.dnit(?m); ret 1; }
    val s: value.Value = R.unwrap_ok[value.Value, str](res_s);
    if (R.is_err[R.Void, str](builder.emit_dbg_value(?bld, s, intern.STR_NIL, i64t, semtype.TYPE_NIL, false, 0))) { ir.dnit(?m); ret 1; }
    val dbg_id: id.InstructionId = (fn.instr_len - 1)::id.InstructionId;

    if (R.is_err[R.Void, str](builder.emit_ret(?bld, p0))) { ir.dnit(?m); ret 1; }

    if (R.is_err[bool, str](mem2reg.run(?m)))   { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](constfold.run(?m))) { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](dce.run(?m)))       { ir.dnit(?m); ret 1; }

    val dbg: *instruction.Instruction = ?fn.instrs[dbg_id::u32];
    if (dbg.kind != instruction.OP_DBG_VALUE)    { ir.dnit(?m); ret 1; }
    if (dbg.operand_count != 1)                  { ir.dnit(?m); ret 1; }
    if (dbg.operands[0].kind != value.VAL_PARAM) { ir.dnit(?m); ret 1; }
    if (dbg.operands[0].data.param_ix != 0)      { ir.dnit(?m); ret 1; }

    val eid: ir.DbgExprId = ir.dbg_expr_id(fn, dbg_id);
    if (eid == ir.DBG_EXPR_IDENTITY)             { ir.dnit(?m); ret 1; }
    val opt: O.Option[*ir.DbgExpr] = ir.dbg_expr_get(fn, eid);
    if (O.is_none[*ir.DbgExpr](opt))             { ir.dnit(?m); ret 1; }
    val dex: *ir.DbgExpr = O.unwrap[*ir.DbgExpr](opt);
    if (dex.op_count != 1)                       { ir.dnit(?m); ret 1; }
    if (dex.ops[0].op != ir.DBG_OP_PLUS_CONST)   { ir.dnit(?m); ret 1; }
    if (dex.ops[0].arg != 4)                     { ir.dnit(?m); ret 1; }

    ir.dnit(?m);
    ret 0;
}

test "mach.lang.me.pipeline.dbg:marks_unrecoverable_optimized_out" {
    var alloc: A.Allocator;
