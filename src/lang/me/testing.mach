# fail-at-N support for the middle-end transforms
#
# an `Attempt` is one transform under the shared probe: the fixture is built
# into a module whose allocator is the probe, the workspace hands the probe
# straight through, the probe is armed, the transform runs, and the outcome is
# held to the transform's promise. at ordinal zero the transform must succeed.
# at every other ordinal the refusal must come back as the allocation layer's
# text through the typed outcome, never a panic and never a silent success,
# and the module must honour the transform's input contract: unchanged, which
# `content_equal` against the control decides, or the stated remainder, which
# the attempt's own `contract` decides. `probe.walk` then checks that the
# module released everything on teardown.
use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.text.string.str_free;

use A: std.allocator;
use print: std.print;
use mach.lang.alloc;
use probe: mach.lang.alloc.probe;
use mach.lang.fail;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.verify;
use std.allocator.page;
use mach.lang.me.scratch;
use mach.lang.target;

pub rec Attempt {
    # builds the fixture into the module; nonzero is the fixture's own failure
    build:     fun(*Attempt, *ir.Module) i32;
    transform: fun(*Attempt, *ir.Module, *scratch.Workspace) res[bool, fail.Fail];
    # after a refusal at the given ordinal, true when the module holds the
    # transform's stated remainder; nil means the input must be unchanged
    contract:  fun(*Attempt, *ir.Module, usize) bool;
    target:    *target.Target;
    # the same fixture built over another allocator, for `unchanged`
    control:   *ir.Module;
    # the fixture's own parameters
    context:   ptr;
}

# the attempt's failure codes above the fixture's own
pub val REFUSED_AT_BASELINE: i32 = 3;
pub val SUCCEEDED_UNDER_REFUSAL: i32 = 4;
pub val WRONG_REFUSAL_TEXT: i32 = 5;
pub val INPUT_CHANGED: i32 = 6;
pub val REMAINDER_BROKEN: i32 = 7;

pub fun attempt(a: *Attempt, p: *probe.Probe) i32 {
    val owner: *A.Allocator = probe.allocator_of(p);
    val initialized: res[ir.Module, fail.Fail] = ir.init(owner, intern.STR_NIL);
    if (sel initialized.err) { ret 1; }
    var m: ir.Module = initialized.ok;
    fin { ir.dnit(?m); }
    val built: i32 = a.build(a, ?m);
    if (built != 0) { ret 100 + built; }
    var workspace: scratch.Workspace;
    val direct: err[fail.Fail] = scratch.init_direct(?workspace, owner);
    if (sel direct.err) { ret 2; }
    fin { scratch.dnit(?workspace); }
    probe.arm(p);
    val outcome: res[bool, fail.Fail] = a.transform(a, ?m, ?workspace);
    probe.clear_failure(p);
    if (p.ordinal == 0) {
        if (sel outcome.err) { ret REFUSED_AT_BASELINE; }
        ret 0;
    }
    if (sel outcome.ok) { ret SUCCEEDED_UNDER_REFUSAL; }
    val text: str = fail.describe(outcome.err);
    val expected: bool = str_equals(text, alloc.text(A.Error.exhausted{}));
    if (probe.owns(p, text::ptr)) { str_free(owner, text); }
    if (!expected) { ret WRONG_REFUSAL_TEXT; }
    if (a.contract == nil) {
        if (!equal.content_equal(?m, a.control)) { ret INPUT_CHANGED; }
    }
    or (!a.contract(a, ?m, p.ordinal)) { ret REMAINDER_BROKEN; }
    ret 0;
}

# the fixture built over a page allocator, for the unchanged comparison
pub fun control(a: *Attempt, owner: *A.Allocator, out: *ir.Module) i32 {
    val initialized: res[ir.Module, fail.Fail] = ir.init(owner, intern.STR_NIL);
    if (sel initialized.err) { ret 1; }
    @out = initialized.ok;
    val built: i32 = a.build(a, out);
    if (built != 0) { ir.dnit(out); ret 100 + built; }
    a.control = out;
    ret 0;
}

# the walk as one test outcome: the attempt's code or the walk's own, with
# the failing ordinal and the request count on stderr since an exit code
# cannot carry them
pub fun walk(a: *Attempt) i32 {
    val out: probe.Outcome = probe.walk[Attempt](a, attempt);
    if (out.code != 0) {
        print.eprintlnf("fail-at-N: code {} at ordinal {} of {} requests", out.code, out.ordinal, out.attempts);
    }
    ret out.code;
}


# the module passes the verifier with no target, fully (reachability included)
# or structurally: the remainder a refusal leaves is still a well-formed module
pub fun verifies(m: *ir.Module, full: bool) bool {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret false; }
    val checked: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(m, ?owner, verify.opts(nil, full, false));
    if (sel checked.err) { ret false; }
    var report: verify.VerifyReport = checked.ok;
    val clean: bool = report.len == 0;
    if (!clean) {
        print.eprintlnf("verify: {} (function {} block {} instr {})", verify.describe(report.violations[0].check),
            report.violations[0].function, report.violations[0].block, report.violations[0].instr);
    }
    verify.dnit_report(?report);
    ret clean;
}

# how many instructions every block of every function lists
pub fun listed(m: *ir.Module) u32 {
    var n: u32 = 0;
    var f: u32 = 0;
    for (f < m.function_len) {
        val fn: *ir.Function = ?m.functions[f];
        var b: u32 = 0;
        for (b < fn.block_count) {
            n = n + fn.blocks[b].phi_count + fn.blocks[b].instr_count;
            if (fn.blocks[b].terminator != id.INSTR_NIL) { n = n + 1; }
            b = b + 1;
        }
        f = f + 1;
    }
    ret n;
}
