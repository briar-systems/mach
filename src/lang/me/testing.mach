# fail-at-N support for the middle-end transforms
#
# an `Attempt` is one transform under the testing allocator: the fixture is
# built into a module whose allocator is the testing one, the workspace hands
# it straight through, it is armed, the transform runs, and the outcome is
# held to the transform's promise. at ordinal zero the transform must succeed.
# at every other ordinal the refusal must come back as the allocation layer's
# text through the typed outcome, never a panic and never a silent success,
# and the module must honour the transform's input contract: unchanged, which
# `content_equal` against the control decides, or the stated remainder, which
# the attempt's own `contract` decides. `T.walk` then checks that the module
# released everything on teardown.
use std.types.result.res;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use lang_alloc: mach.lang.alloc;
use mach.lang.fail;
use mach.lang.intern;
use me_ir: mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.equal;
use ir_id:   mach.lang.me.ir.id;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.ir.verify;
use mach.lang.me.scratch;
use mach.lang.target.resolved;
use A: std.allocator;
use std.allocator.page;
use T: std.allocator.testing;
use std.print;

#[testing]
pub rec Attempt {
    # builds the fixture into the module; nonzero is the fixture's own failure
    build:     fun(*Attempt, *me_ir.Module) i32;
    transform: fun(*Attempt, *me_ir.Module, *scratch.Workspace) err[fail.Fail];
    # after a refusal at the given ordinal, true when the module holds the
    # transform's stated remainder; nil means the input must be unchanged
    contract: fun(*Attempt, *me_ir.Module, usize) bool;
    target:   *resolved.Target;
    # the same fixture built over another allocator, for `unchanged`
    control: *me_ir.Module;
    # the fixture's own parameters
    context: ptr;
}

# the attempt's failure codes above the fixture's own
#[testing]
val REFUSED_AT_BASELINE:     i32 = 3;
#[testing]
val SUCCEEDED_UNDER_REFUSAL: i32 = 4;
#[testing]
val WRONG_REFUSAL_TEXT:      i32 = 5;
#[testing]
val INPUT_CHANGED:           i32 = 6;
#[testing]
val REMAINDER_BROKEN:        i32 = 7;

#[testing]
pub fun attempt(a: *Attempt, p: *T.Testing) i32 {
    val owner:       *A.Allocator                 = T.allocator_of(p);
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(owner, intern.STR_NIL);
    if (sel initialized.err) { ret 1; }
    var m: me_ir.Module = initialized.ok;
    fin { me_ir.dnit(?m); }
    val built: i32 = a.build(a, ?m);
    if (built != 0) { ret 100 + built; }
    var workspace: scratch.Workspace;
    val direct:    err[fail.Fail] = scratch.init_direct(?workspace, owner);
    if (sel direct.err) { ret 2; }
    fin { scratch.dnit(?workspace); }
    T.arm(p);
    val outcome: err[fail.Fail] = a.transform(a, ?m, ?workspace);
    T.clear_failure(p);
    if (p.ordinal == 0) {
        if (sel outcome.err) { ret REFUSED_AT_BASELINE; }
        ret 0;
    }
    if (!sel outcome.err) { ret SUCCEEDED_UNDER_REFUSAL; }
    val text:     str  = fail.describe(outcome.err);
    val expected: bool = str_equals(text, lang_alloc.text(A.Error.exhausted{}));
    if (T.owns(p, text::ptr)) { str_free(owner, text); }
    if (!expected) {
        print.eprintlnf("refusal text: {}", text);
        ret WRONG_REFUSAL_TEXT;
    }
    if (a.contract == nil) {
        if (!equal.content_equal(?m, a.control)) { ret INPUT_CHANGED; }
    }
    or (!a.contract(a, ?m, p.ordinal)) { ret REMAINDER_BROKEN; }
    ret 0;
}

# the fixture built over a page allocator, for the unchanged comparison
#[testing]
pub fun control(a: *Attempt, owner: *A.Allocator, out: *me_ir.Module) i32 {
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(owner, intern.STR_NIL);
    if (sel initialized.err) { ret 1; }
    @out = initialized.ok;
    val built: i32 = a.build(a, out);
    if (built != 0) {
        me_ir.dnit(out);
        ret 100 + built;
    }
    a.control = out;
    ret 0;
}

# the walk as one test outcome: the attempt's code or the walk's own, with
# the failing ordinal and the request count on stderr since an exit code
# cannot carry them
#[testing]
pub fun walk(a: *Attempt) i32 {
    val out: T.Outcome = T.walk[Attempt](a, attempt);
    if (out.code != 0) {
        print.eprintlnf("fail-at-N: code {} at ordinal {} of {} requests", out.code, out.ordinal, out.attempts);
    }
    ret out.code;
}

# the module passes the verifier with no target, fully (reachability included)
# or structurally: the remainder a refusal leaves is still a well-formed module
#[testing]
pub fun verifies(m: *me_ir.Module, full: bool) bool {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret false; }
    val checked: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(m, ?owner, verify.opts(nil, full, false));
    if (sel checked.err) { ret false; }
    var report: verify.VerifyReport = checked.ok;
    val clean:  bool                = report.len == 0;
    if (!clean) {
        val text: opt[str] = verify.describe(report.violations[0].check);
        var what: str      = "unknown VerifyCheck tag";
        if (sel text.some) { what = text.some; }
        print.eprintlnf("verify: {} (function {} block {} instr {})", what,
            report.violations[0].function, ir_id.block_index(report.violations[0].block), ir_id.instruction_index(report.violations[0].instr));
    }
    verify.dnit_report(?report);
    ret clean;
}

# how many instructions every block of every function lists
#[testing]
pub fun listed(m: *me_ir.Module) u32 {
    var n: u32 = 0;
    var f: u32 = 0;
    for (f < m.function_len) {
        val fn: *me_ir.Function = ?m.functions[f];
        var b:  u32             = 0;
        for (b < fn.block_count) {
            n = n + fn.blocks[b].phi_count + fn.blocks[b].instr_count;
            if (!ir_id.instruction_is_nil(fn.blocks[b].terminator)) { n = n + 1; }
            b = b + 1;
        }
        f = f + 1;
    }
    ret n;
}

# the loop of the axpy fixture: its blocks and its induction variable
#[testing]
pub rec Axpy {
    entry:  ir_id.BlockId;
    header: ir_id.BlockId;
    body:   ir_id.BlockId;
    exit:   ir_id.BlockId;
    iv:     value.Value;
}

# the signature `fun(n: i64, a, b, c: *i64)` of the axpy fixture
#[testing]
pub fun axpy_sig(m: *me_ir.Module, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, o_sig: *ir_type.IrTypeId) i32 {
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret 1; }
    var ps: [4]ir_type.IrTypeId;
    ps[0] = i64t;
    ps[1] = ptrt;
    ps[2] = ptrt;
    ps[3] = ptrt;
    val rfn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, rv.ok, ?ps[0], 4, false);
    if (sel rfn.err) { ret 1; }
    @o_sig = rfn.ok;
    ret 0;
}

# `for (i = 0; i < n; i = i + 1) { a[i] = b[i] + c[i]; }` over i64 elements in
# the current function, whose params are n, a, b and c; the bound compares
# unsigned when asked
#[testing]
pub fun axpy(m: *me_ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, unsigned: bool, out: *Axpy) i32 {
    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val rh:    res[ir_id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rh.err) { ret 1; }
    val header: ir_id.BlockId                 = rh.ok;
    val rb:     res[ir_id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rb.err) { ret 1; }
    val body: ir_id.BlockId                 = rb.ok;
    val rx:   res[ir_id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rx.err) { ret 1; }
    val exit: ir_id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);
    val b: value.Value = value.param(2, ptrt);
    val c: value.Value = value.param(3, ptrt);

    builder.set_block(bld, entry);
    val to_header: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel to_header.err) { ret 1; }

    builder.set_block(bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(bld, i64t);
    if (sel rphi.err) { ret 1; }
    val iv: value.Value = rphi.ok;
    var rc: res[value.Value, fail.Fail];
    if (unsigned)   { rc = builder.emit_cmp_lt_u(bld, iv, n); }
    or              { rc = builder.emit_cmp_lt_s(bld, iv, n); }
    if (sel rc.err) { ret 1; }
    val to_body_or_exit: err[fail.Fail] = builder.emit_cbr(bld, rc.ok, body, exit);
    if (sel to_body_or_exit.err) { ret 1; }

    builder.set_block(bld, body);
    var ixb: [1]value.Value;
    ixb[0] = iv;
    val rgb: res[value.Value, fail.Fail] = builder.emit_gep(bld, b, i64t, ?ixb[0], 1);
    if (sel rgb.err) { ret 1; }
    val rlb: res[value.Value, fail.Fail] = builder.emit_load(bld, rgb.ok, i64t);
    if (sel rlb.err) { ret 1; }
    var ixc: [1]value.Value;
    ixc[0] = iv;
    val rgc: res[value.Value, fail.Fail] = builder.emit_gep(bld, c, i64t, ?ixc[0], 1);
    if (sel rgc.err) { ret 1; }
    val rlc: res[value.Value, fail.Fail] = builder.emit_load(bld, rgc.ok, i64t);
    if (sel rlc.err) { ret 1; }
    val rs: res[value.Value, fail.Fail] = builder.emit_add(bld, rlb.ok, rlc.ok);
    if (sel rs.err) { ret 1; }
    var ixa: [1]value.Value;
    ixa[0] = iv;
    val rga: res[value.Value, fail.Fail] = builder.emit_gep(bld, a, i64t, ?ixa[0], 1);
    if (sel rga.err) { ret 1; }
    val stored_rga: err[fail.Fail] = builder.emit_store(bld, rs.ok, rga.ok);
    if (sel stored_rga.err) { ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ret 1; }
    val upd:      value.Value    = ru.ok;
    val branched: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel branched.err) { ret 1; }

    builder.set_block(bld, exit);
    val returned: err[fail.Fail] = builder.emit_ret_void(bld);
    if (sel returned.err) { ret 1; }

    val iv_from_entry: err[fail.Fail] = builder.phi_add_incoming(bld, iv, entry, value.const_int(0, i64t));
    if (sel iv_from_entry.err) { ret 1; }
    val iv_from_body: err[fail.Fail] = builder.phi_add_incoming(bld, iv, body, upd);
    if (sel iv_from_body.err) { ret 1; }

    @out = Axpy{entry: entry, header: header, body: body, exit: exit, iv: iv};
    ret 0;
}
