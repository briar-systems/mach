# the one home of the shift saturation. every scalar
# shift leaves this pass marked count-bounded, its count below its operand's
# width: a count the range analysis proves keeps the bare shift, and any other
# count is saturated here in the ir, branch-free, around the mask
# `m = mask_lt_u(count, W)`, all ones exactly when the count is in range. a
# logical shift keeps its value only under `m` and shifts by `count & (W-1)`,
# an arithmetic one shifts by `(count | ~m) & (W-1)`, which is W - 1 out of
# range and fills with the sign. `m` is 0 or all ones, so it may and the value
# before the shift as well as the result after it, and it goes into an
# adjacent single-use and with a constant wherever there is one, so a mask of
# a count the loop does not change is loop-invariant and licm hoists it with
# the and. the mark is recomputed from scratch on each run, so it never
# outlives its proof, and a count this pass saturated proves on a later run
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use A: std.allocator;

use mach.lang.me.analysis;
use mach.lang.me.analysis.loops;
use mach.lang.me.analysis.range;
use me_ir: mach.lang.me.ir;
use mach.lang.me.ir.builder;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.refs;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.pass;
use mach.lang.me.scratch;

# the pass the pipeline schedules
pub val PASS: pass.Pass = pass.Pass{name: "shiftbound", class: pass.CLASS_LEGALIZATION, run: nil, applies: nil, preserves: analysis.DOMINANCE, visit: bound_function, skips: pass.SKIP_EXTERN | pass.SKIP_EMPTY, eligible: nil, rounds: 1};

fun is_shift(k: ir_instruction.InstrKind) bool {
    ret k == ir_instruction.OP_SHL || k == ir_instruction.OP_SHR_U || k == ir_instruction.OP_SHR_S;
}

fun int_bits(types: *ir_type.IrTypeTable, ty: ir_type.IrTypeId) u32 {
    val found: opt[*ir_type.IrType] = ir_type.get(types, ty);
    if (sel found.none)                     { ret 0; }
    if (found.some.kind != ir_type.IRT_INT) { ret 0; }
    ret found.some.data.bits;
}

# the width of a scalar integer shift, 0 for anything else
fun shift_bits(types: *ir_type.IrTypeTable, ins: *ir_instruction.Instruction) u32 {
    if (!is_shift(ins.kind) || ins.operand_count != 2) { ret 0; }
    ret int_bits(types, ins.ty);
}

# a count type too narrow to hold the width holds only counts below it, and
# the width is a constant of every count type the expansion builds it in
fun count_type_bounds(types: *ir_type.IrTypeTable, ins: *ir_instruction.Instruction, bits: u32) bool {
    val cb: u32 = int_bits(types, ins.operands[1].ty);
    ret cb > 0 && cb < 64 && (bits::u64 >> cb::u64) != 0;
}

# the analysis is requested only for a function that has a shift by a count
# that is not a constant, and it is read before any instruction is added
fun bound_function(work: *pass.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:  *me_ir.Module   = work.module;
    val fn: *me_ir.Function = work.body;

    var variable: bool = false;
    var bi:       u32  = 0;
    for (bi < fn.block_count && !variable) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var ii:  u32          = 0;
        for (ii < blk.instr_count) {
            val ins: *ir_instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
            if (shift_bits(?m.types, ins) != 0 && ins.operands[1].kind != value.VAL_CONST_INT) { variable = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    var ra:       range.RangeAnalysis;
    var analyzed: bool = false;
    if (variable) {
        val ral: res[*loops.LoopAnalysis, fail.Fail] = analysis.loops_of(work.analyses, m, fn);
        if (sel ral.err) { ret res[bool, fail.Fail].err{ral.err}; }
        val ri: err[fail.Fail] = range.init(?ra, fn, ?m.types, ral.ok, alloc);
        if (sel ri.err) { ret res[bool, fail.Fail].err{ri.err}; }
        analyzed = true;
    }

    # a proven count keeps the bare shift, a constant one out of range folds
    # in place, and a variable one is left for the expansion below
    var changed: bool = false;
    var pending: u32  = 0;
    bi = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var ii:  u32          = 0;
        for (ii < blk.instr_count) {
            val ins:  *ir_instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
            val bits: u32                         = shift_bits(?m.types, ins);
            if (bits != 0) {
                val count:  value.Value = ins.operands[1];
                var proven: bool        = count_type_bounds(?m.types, ins, bits);
                if (count.kind == value.VAL_CONST_INT) { proven = proven || range.constant_range(?m.types, count).hi < bits::u64; }
                or (analyzed && !proven)               { proven = range.below(?ra, count, blk.id, bits::u64); }
                val was:      u16                      = ins.flags;
                val was_kind: ir_instruction.InstrKind = ins.kind;
                if (proven) {
                    ins.flags = ins.flags | ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
                }
                or (count.kind == value.VAL_CONST_INT) {
                    saturate_constant(?m.types, ins, bits);
                }
                or {
                    ins.flags = ins.flags & (0xFFFF - ir_instruction.INSTR_FLAG_COUNT_BOUNDED);
                    pending   = pending + 1;
                }
                if (ins.flags != was || ins.kind != was_kind) { changed = true; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    if (analyzed) {
        range.dnit(?ra);
    }
    if (pending == 0) { ret res[bool, fail.Fail].ok{changed}; }

    val er: err[fail.Fail] = expand_function(m, fn, alloc);
    if (sel er.err) { ret res[bool, fail.Fail].err{er.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# a constant count at or above the width, which a fold exposed after the
# front end refused every literal one: a logical shift is 0, an and with
# zero, and an arithmetic one shifts by W - 1
fun saturate_constant(types: *ir_type.IrTypeTable, ins: *ir_instruction.Instruction, bits: u32) {
    if (ins.kind == ir_instruction.OP_SHR_S) {
        ins.operands[1] = value.const_int((bits - 1)::u64, ins.operands[1].ty);
        ins.flags       = ins.flags | ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
        ret;
    }
    ins.kind        = ir_instruction.OP_AND;
    ins.operands[1] = value.const_int(0, ins.ty);
    ins.flags       = ins.flags & (0xFFFF - ir_instruction.INSTR_FLAG_COUNT_BOUNDED);
}

# how many times each instruction's value is read by a listed instruction,
# debug reads included, so a value moved or reassociated has no other reader,
# and the last listed instruction that reads it, its sole reader when the
# count is one. both are taken before any block is relisted
rec Uses {
    count:  *u32;
    reader: *ir_id.InstructionId;
    len:    u32;
}

fun count_uses(fn: *me_ir.Function, alloc: *A.Allocator) res[Uses, fail.Fail] {
    var uses: Uses;
    uses.len = fn.instr_len;
    val cr: res[*u32, A.Error] = A.allocate[u32](alloc, fn.instr_len::usize);
    if (sel cr.err) { ret res[Uses, fail.Fail].err{fail.refused(cr.err)}; }
    uses.count = cr.ok;
    val rr: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](alloc, fn.instr_len::usize);
    if (sel rr.err) {
        A.deallocate[u32](alloc, uses.count, uses.len::usize);
        ret res[Uses, fail.Fail].err{fail.refused(rr.err)};
    }
    uses.reader = rr.ok;
    var i: u32 = 0;
    for (i < fn.instr_len) {
        uses.count[i]  = 0;
        uses.reader[i] = ir_id.INSTR_NIL;
        i              = i + 1;
    }
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var k:   u32          = 0;
        for (k < blk.phi_count) {
            count_operands(fn, blk.phis[k], ?uses);
            k = k + 1;
        }
        k = 0;
        for (k < blk.instr_count) {
            count_operands(fn, blk.instructions[k], ?uses);
            k = k + 1;
        }
        if (!ir_id.instruction_is_nil(blk.terminator)) { count_operands(fn, blk.terminator, ?uses); }
        bi = bi + 1;
    }
    ret res[Uses, fail.Fail].ok{uses};
}

fun uses_dnit(uses: *Uses, alloc: *A.Allocator) {
    A.deallocate[u32](alloc, uses.count, uses.len::usize);
    A.deallocate[ir_id.InstructionId](alloc, uses.reader, uses.len::usize);
}

fun count_operands(fn: *me_ir.Function, iid: ir_id.InstructionId, uses: *Uses) {
    if (iid::u32 >= fn.instr_len) { ret; }
    val ins: *ir_instruction.Instruction = ?fn.instrs[iid::u32];
    var o:   u32                         = 0;
    for (o < ins.operand_count) {
        val v: value.Value = ins.operands[o];
        if (v.kind == value.VAL_INSTR && v.data.instr::u32 < fn.instr_len && !refs.operand_is_block(ins.kind, o)) {
            uses.count[v.data.instr::u32]  = uses.count[v.data.instr::u32] + 1;
            uses.reader[v.data.instr::u32] = iid;
        }
        o = o + 1;
    }
}

# each block holding an unmarked shift is relisted with the saturation of each
# one listed ahead of it. `old` is the block's former list, which the
# expansion reads while the block's own list is rebuilt
fun expand_function(m: *me_ir.Module, fn: *me_ir.Function, alloc: *A.Allocator) err[fail.Fail] {
    val ur: res[Uses, fail.Fail] = count_uses(fn, alloc);
    if (sel ur.err) { ret err[fail.Fail].err{ur.err}; }
    var uses: Uses = ur.ok;
    fin { uses_dnit(?uses, alloc); }
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        if (block_has_unmarked(m, fn, bi)) {
            val expanded: err[fail.Fail] = expand_block(m, fn, bi, ?uses, alloc);
            if (sel expanded.err) { ret expanded; }
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_block(m: *me_ir.Module, fn: *me_ir.Function, bi: u32, uses: *Uses, alloc: *A.Allocator) err[fail.Fail] {
    val n:   u32                  = fn.blocks[bi].instr_count;
    var old: *ir_id.InstructionId = nil;
    fin {
        if (old != nil) { A.deallocate[ir_id.InstructionId](alloc, old, n::usize); }
    }
    val lr: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](alloc, n::usize);
    if (sel lr.err) { ret err[fail.Fail].err{fail.refused(lr.err)}; }
    old = lr.ok;
    var k: u32 = 0;
    for (k < n) {
        old[k] = fn.blocks[bi].instructions[k];
        k      = k + 1;
    }
    fn.blocks[bi].instr_count = 0;
    k                         = 0;
    for (k < n) {
        val iid: ir_id.InstructionId = old[k];
        if (iid::u32 < uses.len && shift_bits(?m.types, ?fn.instrs[iid::u32]) != 0
            && (fn.instrs[iid::u32].flags & ir_instruction.INSTR_FLAG_COUNT_BOUNDED) == 0) {
            val ex: err[fail.Fail] = expand_shift(m, fn, bi, iid, uses);
            if (sel ex.err) { ret ex; }
        }
        val ap: err[fail.Fail] = me_ir.block_append_instr(m, ?fn.blocks[bi], iid);
        if (sel ap.err) { ret ap; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun block_has_unmarked(m: *me_ir.Module, fn: *me_ir.Function, bi: u32) bool {
    val blk: *me_ir.Block = ?fn.blocks[bi];
    var k:   u32          = 0;
    for (k < blk.instr_count) {
        val ins: *ir_instruction.Instruction = ?fn.instrs[blk.instructions[k]::u32];
        if (shift_bits(?m.types, ins) != 0 && (ins.flags & ir_instruction.INSTR_FLAG_COUNT_BOUNDED) == 0) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the new instruction `kind(a, b)` of type `ty`, listed at the end of block
# `bi`, where it reads as the shift `site` it saturates: the same source
# location and inline site. its result is secret when an operand is
fun emit(m: *me_ir.Module, fn: *me_ir.Function, bi: u32, site: ir_id.InstructionId, kind: ir_instruction.InstrKind,
    ty: ir_type.IrTypeId, a: value.Value, b: value.Value) res[value.Value, fail.Fail] {
    ret emit_n(m, fn, bi, site, kind, ty, a, b, 2);
}

fun emit_n(m: *me_ir.Module, fn: *me_ir.Function, bi: u32, site: ir_id.InstructionId, kind: ir_instruction.InstrKind,
    ty: ir_type.IrTypeId, a: value.Value, b: value.Value, n: u32) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = a;
    ops[1] = b;
    val secret: bool            = a.secret || (n > 1 && b.secret);
    var bld:    builder.Builder = builder.init(m);
    builder.set_function(?bld, fn);
    builder.derive(?bld, site);
    builder.set_secret(?bld, secret);
    builder.at_end(?bld, ir_id.block(bi));
    val added: res[ir_id.InstructionId, fail.Fail] = builder.emit_instr(?bld, kind, ty, ir_type.IRT_NIL, ?ops[0], n);
    if (sel added.err) { ret res[value.Value, fail.Fail].err{added.err}; }
    var v: value.Value = value.instr(added.ok, ty);
    v.secret = secret;
    ret res[value.Value, fail.Fail].ok{v};
}

fun unary(m: *me_ir.Module, fn: *me_ir.Function, bi: u32, site: ir_id.InstructionId, kind: ir_instruction.InstrKind,
    a: value.Value) res[value.Value, fail.Fail] {
    ret emit_n(m, fn, bi, site, kind, a.ty, a, a, 1);
}

# the operand of a scalar `and` that is its constant, or none
fun and_constant(ins: *ir_instruction.Instruction) opt[u32] {
    if (ins.kind != ir_instruction.OP_AND || ins.operand_count != 2) { ret opt[u32].none{}; }
    val c0: bool = ins.operands[0].kind == value.VAL_CONST_INT;
    val c1: bool = ins.operands[1].kind == value.VAL_CONST_INT;
    if (c1 && !c0) { ret opt[u32].some{1}; }
    if (c0 && !c1) { ret opt[u32].some{0}; }
    ret opt[u32].none{};
}

# the sole reader of `iid` when it is an and with a constant of type `ty`
fun single_and_reader(fn: *me_ir.Function, iid: ir_id.InstructionId, ty: ir_type.IrTypeId, uses: *Uses) opt[ir_id.InstructionId] {
    if (uses.count[iid::u32] != 1) { ret opt[ir_id.InstructionId].none{}; }
    val r: ir_id.InstructionId = uses.reader[iid::u32];
    if (r::u32 >= uses.len || !ir_type.same(fn.instrs[r::u32].ty, ty)) { ret opt[ir_id.InstructionId].none{}; }
    val kc: opt[u32] = and_constant(?fn.instrs[r::u32]);
    if (sel kc.none) { ret opt[ir_id.InstructionId].none{}; }
    ret opt[ir_id.InstructionId].some{r};
}

# drop `iid` from the part of block `bi` relisted so far, if it is there
fun unlist(fn: *me_ir.Function, bi: u32, iid: ir_id.InstructionId) bool {
    val blk: *me_ir.Block = ?fn.blocks[bi];
    var k:   u32          = 0;
    for (k < blk.instr_count) {
        if (ir_id.instruction_same(blk.instructions[k], iid)) {
            var j: u32 = k;
            for (j + 1 < blk.instr_count) {
                blk.instructions[j] = blk.instructions[j + 1];
                j                   = j + 1;
            }
            blk.instr_count = blk.instr_count - 1;
            ret true;
        }
        k = k + 1;
    }
    ret false;
}

fun expand_shift(m: *me_ir.Module, fn: *me_ir.Function, bi: u32, sid: ir_id.InstructionId, uses: *Uses) err[fail.Fail] {
    val kind:  ir_instruction.InstrKind = fn.instrs[sid::u32].kind;
    val ty:    ir_type.IrTypeId         = fn.instrs[sid::u32].ty;
    val v:     value.Value              = fn.instrs[sid::u32].operands[0];
    val count: value.Value              = fn.instrs[sid::u32].operands[1];
    val bits:  u32                      = int_bits(?m.types, ty);
    if (int_bits(?m.types, count.ty) == 0) {
        ret err[fail.Fail].err{fail.message("shiftbound: a scalar shift's count is not an integer")};
    }
    val width: value.Value = value.const_int(bits::u64, count.ty);
    val low:   value.Value = value.const_int((bits - 1)::u64, count.ty);

    if (kind == ir_instruction.OP_SHR_S) {
        val mr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_MASK_LT_U, count.ty, count, width);
        if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
        val nr: res[value.Value, fail.Fail] = unary(m, fn, bi, sid, ir_instruction.OP_NOT, mr.ok);
        if (sel nr.err) { ret err[fail.Fail].err{nr.err}; }
        val fr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_OR, count.ty, count, nr.ok);
        if (sel fr.err) { ret err[fail.Fail].err{fr.err}; }
        val cr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_AND, count.ty, fr.ok, low);
        if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
        fn.instrs[sid::u32].operands[1] = cr.ok;
        fn.instrs[sid::u32].flags       = fn.instrs[sid::u32].flags | ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
        ret err[fail.Fail].ok{};
    }

    val mr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_MASK_LT_U, ty, count, width);
    if (sel mr.err) { ret err[fail.Fail].err{mr.err}; }
    val cr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_AND, count.ty, count, low);
    if (sel cr.err) { ret err[fail.Fail].err{cr.err}; }
    val mask: value.Value = mr.ok;

    # the result's one reader `r & K` reads `r & (m & K)`
    val reader: opt[ir_id.InstructionId] = single_and_reader(fn, sid, ty, uses);
    if (sel reader.some) {
        val ui: u32      = reader.some::u32;
        val kc: opt[u32] = and_constant(?fn.instrs[ui]);
        if (sel kc.some) {
            val kr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_AND, ty, mask, fn.instrs[ui].operands[kc.some]);
            if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
            fn.instrs[ui].operands[kc.some] = kr.ok;
            if (kr.ok.secret) { fn.instrs[ui].secret = true; }
            fn.instrs[sid::u32].operands[1] = cr.ok;
            fn.instrs[sid::u32].flags       = fn.instrs[sid::u32].flags | ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
            ret err[fail.Fail].ok{};
        }
    }

    # the value's one reader is the shift and it is `y & K` listed ahead of
    # it in this block: it moves after the mask and reads `y & (m & K)`
    if (v.kind == value.VAL_INSTR && v.data.instr::u32 < uses.len && uses.count[v.data.instr::u32] == 1) {
        val vi: u32      = v.data.instr::u32;
        val kc: opt[u32] = and_constant(?fn.instrs[vi]);
        if (sel kc.some) {
            if (ir_type.same(fn.instrs[vi].ty, ty) && unlist(fn, bi, v.data.instr)) {
                val kr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_AND, ty, mask, fn.instrs[vi].operands[kc.some]);
                if (sel kr.err) { ret err[fail.Fail].err{kr.err}; }
                fn.instrs[vi].operands[kc.some] = kr.ok;
                if (kr.ok.secret) { fn.instrs[vi].secret = true; }
                val ap: err[fail.Fail] = me_ir.block_append_instr(m, ?fn.blocks[bi], v.data.instr);
                if (sel ap.err) { ret ap; }
                fn.instrs[sid::u32].operands[1] = cr.ok;
                fn.instrs[sid::u32].flags       = fn.instrs[sid::u32].flags | ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
                ret err[fail.Fail].ok{};
            }
        }
    }

    val vr: res[value.Value, fail.Fail] = emit(m, fn, bi, sid, ir_instruction.OP_AND, ty, v, mask);
    if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }
    fn.instrs[sid::u32].operands[0] = vr.ok;
    fn.instrs[sid::u32].operands[1] = cr.ok;
    fn.instrs[sid::u32].flags       = fn.instrs[sid::u32].flags | ir_instruction.INSTR_FLAG_COUNT_BOUNDED;
    ret err[fail.Fail].ok{};
}

use mach.lang.intern;
use mach.lang.me.ir.equal;
use me_testing: mach.lang.me.testing;
use mach.lang.target.resolved;
use std.allocator.page;

# one block of five 64-bit shifts of `p0`: by 3, by 70 logically and
# arithmetically, by `p1 & 31` and by `p1`, each returned through a sum so
# none is dead
#[testing]
fun probe_build(a: *me_testing.Attempt, m: *me_ir.Module) i32 {
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 1; }
    val i64t: ir_type.IrTypeId    = ri.ok;
    val rf:   res[u32, fail.Fail] = me_ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ret 2; }
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[rf.ok]);
    val rb: res[ir_id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ret 3; }
    builder.set_block(?b, rb.ok);
    val x:      value.Value                 = value.param(0, i64t);
    val n:      value.Value                 = value.param(1, i64t);
    val in:     value.Value                 = builder.shl(?b, x, value.const_int(3, i64t));
    val over:   value.Value                 = builder.shl(?b, x, value.const_int(70, i64t));
    val fill:   value.Value                 = builder.shr_s(?b, x, value.const_int(70, i64t));
    val masked: value.Value                 = builder.shl(?b, x, builder.band(?b, n, value.const_int(31, i64t)));
    val free:   value.Value                 = builder.shl(?b, x, n);
    val sum:    value.Value                 = builder.add(?b, builder.add(?b, builder.add(?b, in, over), builder.add(?b, fill, masked)), free);
    val built:  res[value.Value, fail.Fail] = builder.done(?b, sum);
    if (sel built.err) { ret 4; }
    val returned: err[fail.Fail] = builder.emit_ret(?b, built.ok);
    if (sel returned.err) { ret 5; }
    ret 0;
}

test run__marks_every_shift_and_saturates_only_the_unproven_count {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    val rm: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: me_ir.Module = rm.ok;
    fin { me_ir.dnit(?m); }
    if (probe_build(nil, ?m) != 0) { ret 2; }
    var tgt: resolved.Target      = resolved.described_named("x86_64");
    val ran: res[bool, fail.Fail] = pass.run_alone(?PASS, ?m, ?tgt);
    if (sel ran.err)                    { ret 3; }
    if (!ran.ok)                        { ret 4; }
    if (!me_testing.verifies(?m, true)) { ret 5; }

    val fn:     *me_ir.Function = ?m.functions[0];
    val blk:    *me_ir.Block    = ?fn.blocks[0];
    var shifts: u32             = 0;
    var masks:  u32             = 0;
    var zeroed: u32             = 0;
    var filled: u32             = 0;
    var k:      u32             = 0;
    for (k < blk.instr_count) {
        val ins: *ir_instruction.Instruction = ?fn.instrs[blk.instructions[k]::u32];
        k = k + 1;
        if (ins.kind == ir_instruction.OP_MASK_LT_U)                                                                               { masks = masks + 1; }
        if (ins.kind == ir_instruction.OP_AND && ins.operands[1].kind == value.VAL_CONST_INT && ins.operands[1].data.int_lit == 0) { zeroed = zeroed + 1; }
        if (is_shift(ins.kind)) {
            shifts = shifts + 1;
            # every shift leaves the pass with its count bounded
            if ((ins.flags & ir_instruction.INSTR_FLAG_COUNT_BOUNDED) == 0) { ret 6; }
            if (ins.kind == ir_instruction.OP_SHR_S && ins.operands[1].kind == value.VAL_CONST_INT) {
                if (ins.operands[1].data.int_lit != 63) { ret 7; }
                filled = filled + 1;
            }
        }
    }
    # the logical shift by 70 is the zero it computes, the arithmetic one
    # shifts by 63, and only the shift by `p1` is saturated around a mask
    if (zeroed != 1) { ret 8; }
    if (filled != 1) { ret 9; }
    if (shifts != 4) { ret 10; }
    if (masks != 1)  { ret 11; }
    ret 0;
}

#[testing]
fun probe_transform(a: *me_testing.Attempt, m: *me_ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    var ctx: pass.Context         = pass.context(m, a.target, workspace);
    val r:   res[bool, fail.Fail] = pass.run(?PASS, ?ctx);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the use counts and each block's former list are scratch; the saturations
# are emitted from the module as a block is relisted, so a refusal there
# leaves the function partly saturated, its block cut short, with at least as
# many instructions as before
#[testing]
fun probe_contract(a: *me_testing.Attempt, m: *me_ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    ret m.functions[0].instr_len >= a.control.functions[0].instr_len;
}

test pass__refusal_at_every_ordinal_leaves_the_input_or_a_partial_saturation {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var tgt: resolved.Target    = resolved.described_named("x86_64");
    var a:   me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: ?tgt, control: nil, context: nil};
    var control: me_ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 2; }
    fin { me_ir.dnit(?control); }
    ret me_testing.walk(?a);
}
