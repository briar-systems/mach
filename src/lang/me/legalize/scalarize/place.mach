# the expansion of a vector value held in memory: every operation on it
# becomes a load, a scalar operation and a store per lane through its stack
# home, the lanes a register cannot hold
use mach.lang.fail;
use std.allocator.arena;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.text.string.str_free;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_contains;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.intern;
use mach.lang.layout;
use mach.lang.me.analysis;
use me_ir: mach.lang.me.ir;
use mach.lang.me.ir.builder;
use ir_effect: mach.lang.me.ir.effect;
use mach.lang.me.ir.equal;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.pass;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.vecform;
use lang_source:  mach.lang.source;
use target_model: mach.lang.target.model;
use mach.lang.target.resolved;

# the types an expansion builds with
pub rec Types {
    void_ty: ir_type.IrTypeId;
    ptr_ty:  ir_type.IrTypeId;
    idx_ty:  ir_type.IrTypeId;
    i8_ty:   ir_type.IrTypeId;
}

pub rec Ctx {
    alloc:    *A.Allocator;
    m:        *me_ir.Module;
    fn:       *me_ir.Function;
    tgt:      *resolved.Target;
    pval:     *value.Value;
    pval_set: *bool;
    n:        u32;
    is_vp:    *bool;
    pcount:   u32;
    void_ty:  ir_type.IrTypeId;
    ptr_ty:   ir_type.IrTypeId;
    idx_ty:   ir_type.IrTypeId;
    lane_buf: *value.Value;
    lane_cap: u32;

    # the instructions a block lists, by id; the arena also keeps the dead ones
    # an earlier pass unlisted, and those get no stack home
    listed: *bool;

    # entry-block stack homes a lane-wise conversion or a reinterpret into a
    # memory image builds its result in, by instruction
    conv_slot:   *value.Value;
    conv_allocs: *ir_id.InstructionId;
    conv_len:    u32;

    # which instructions have a home, decided before a vector reinterpret is
    # retyped to the pointer it aliases
    homed: *bool;
}

pub fun lane_scratch(c: *Ctx, n: u32) res[*value.Value, fail.Fail] {
    if (c.lane_buf != nil && c.lane_cap >= n) { ret res[*value.Value, fail.Fail].ok{c.lane_buf}; }
    if (c.lane_buf != nil) {
        A.deallocate[value.Value](c.alloc, c.lane_buf, c.lane_cap::usize);
        c.lane_buf = nil;
        c.lane_cap = 0;
    }
    val rb: res[*value.Value, A.Error] = A.allocate[value.Value](c.alloc, n::usize);
    if (sel rb.err) { ret res[*value.Value, fail.Fail].err{fail.refused(rb.err)}; }
    c.lane_buf = rb.ok;
    c.lane_cap = n;
    ret res[*value.Value, fail.Fail].ok{c.lane_buf};
}

fun mem_image(c: *Ctx, ty: ir_type.IrTypeId) bool {
    ret !vecform.holds_in_register(c.m, c.tgt, ty);
}

pub rec VInfo {
    elem:  ir_type.IrTypeId;
    lanes: u32;
    bits:  u32;
}

pub fun is_binary_op(k: ir_instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_BINARY;
}

pub fun is_unary_op(k: ir_instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_UNARY;
}

fun is_disallowed_op(k: ir_instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_DISALLOWED;
}

pub fun is_compare_op(k: ir_instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_COMPARE;
}

pub fun is_convert_op(k: ir_instruction.InstrKind) bool {
    ret opdesc.vec_class(k) == opdesc.VCLASS_CONVERT;
}

pub fun is_operator(m: *me_ir.Module, inst: *ir_instruction.Instruction) bool {
    if (!ir_type.is_vector(?m.types, inst.ty)) { ret false; }
    ret is_binary_op(inst.kind) || is_unary_op(inst.kind) || is_compare_op(inst.kind) || is_convert_op(inst.kind);
}

# a conversion's two sides differ in width, so either one alone may lack a register home
fun convert_touches_mem_image(c: *Ctx, inst: *ir_instruction.Instruction) bool {
    if (!is_convert_op(inst.kind) || inst.operand_count < 1) { ret false; }
    if (!ir_type.is_vector(?c.m.types, inst.ty))             { ret false; }
    ret mem_image(c, inst.ty) || mem_image(c, inst.operands[0].ty);
}

# a reinterpret of a non-vector value into a memory image: the value's bytes,
# stored whole, are the image's lanes
fun reinterprets_into_image(c: *Ctx, inst: *ir_instruction.Instruction) bool {
    if (inst.kind != ir_instruction.OP_BITCAST || inst.operand_count < 1) { ret false; }
    if (!mem_image(c, inst.ty))                                           { ret false; }
    ret !ir_type.is_vector(?c.m.types, inst.operands[0].ty);
}

# a reinterpret of a memory image into a non-vector value: the image's lanes,
# copied into a home the value aligns, are read back whole
fun reinterprets_from_image(c: *Ctx, inst: *ir_instruction.Instruction) bool {
    if (inst.kind != ir_instruction.OP_BITCAST || inst.operand_count < 1) { ret false; }
    if (ir_type.is_vector(?c.m.types, inst.ty))                           { ret false; }
    val src: ir_type.IrTypeId = inst.operands[0].ty;
    ret ir_type.is_vector(?c.m.types, src) && mem_image(c, src);
}

fun needs_home(c: *Ctx, inst: *ir_instruction.Instruction) bool {
    ret convert_touches_mem_image(c, inst) || reinterprets_into_image(c, inst) || reinterprets_from_image(c, inst);
}

fun is_vector_bitcast(c: *Ctx, inst: *ir_instruction.Instruction) bool {
    if (inst.kind != ir_instruction.OP_BITCAST) { ret false; }
    if (inst.operand_count < 1)                 { ret false; }
    if (!mem_image(c, inst.ty))                 { ret false; }
    ret ir_type.is_vector(?c.m.types, inst.operands[0].ty);
}

fun produces_vector(c: *Ctx, inst: *ir_instruction.Instruction) bool {
    if (!mem_image(c, inst.ty)) { ret false; }
    ret is_binary_op(inst.kind) || is_unary_op(inst.kind) || is_compare_op(inst.kind)
        || inst.kind == ir_instruction.OP_DECLASSIFY || inst.kind == ir_instruction.OP_LOAD
        || inst.kind == ir_instruction.OP_VEC_INSERT || inst.kind == ir_instruction.OP_VEC_CONCAT;
}

pub fun vec_info(m: *me_ir.Module, vty: ir_type.IrTypeId, out: *VInfo) err[fail.Fail] {
    val opt_v: opt[*ir_type.IrType] = ir_type.get(?m.types, vty);
    if (sel opt_v.none) { ret err[fail.Fail].err{fail.message("scalarize: operand is not a resolvable IR type")}; }
    val vt: *ir_type.IrType = opt_v.some;
    if (vt.kind != ir_type.IRT_VECTOR) { ret err[fail.Fail].err{fail.message("scalarize: expected an IR vector type")}; }
    out.elem  = vt.data.vector_.element;
    out.lanes = vt.data.vector_.lanes;

    val opt_e: opt[*ir_type.IrType] = ir_type.get(?m.types, vt.data.vector_.element);
    if (sel opt_e.none) { ret err[fail.Fail].err{fail.message("scalarize: vector element type not resolvable")}; }
    out.bits = opt_e.some.data.bits;
    ret err[fail.Fail].ok{};
}

# a new instruction listed in no block, at `loc`
pub fun new_instr(m: *me_ir.Module, fn: *me_ir.Function, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId,
    aux: ir_type.IrTypeId, ops: *value.Value, opn: u32, loc: lang_source.Location) res[ir_id.InstructionId, fail.Fail] {
    var bld: builder.Builder = builder.on(m, fn);
    builder.set_loc(?bld, loc);
    ret builder.emit_instr(?bld, kind, ty, aux, ops, opn);
}

pub fun push(c: *Ctx, blk: *me_ir.Block, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId,
    aux: ir_type.IrTypeId, ops: *value.Value, opn: u32, loc: lang_source.Location) res[value.Value, fail.Fail] {
    val ri: res[ir_id.InstructionId, fail.Fail] = new_instr(c.m, c.fn, kind, ty, aux, ops, opn, loc);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    val iid: ir_id.InstructionId = ri.ok;
    val rl:  err[fail.Fail]      = me_ir.block_append_instr(c.m, blk, iid);
    if (sel rl.err) { ret res[value.Value, fail.Fail].err{rl.err}; }
    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

pub fun lane_ptr(c: *Ctx, blk: *me_ir.Block, base: value.Value, arr_ty: ir_type.IrTypeId, k: u32, loc: lang_source.Location) res[value.Value, fail.Fail] {
    var ops: [3]value.Value;
    ops[0] = base;
    ops[1] = value.const_int(0, c.idx_ty);
    ops[2] = value.const_int(k::u64, c.idx_ty);
    ret push(c, blk, ir_instruction.OP_GEP, c.ptr_ty, arr_ty, ?ops[0], 3, loc);
}

pub fun emit_load(c: *Ctx, blk: *me_ir.Block, ptr: value.Value, elem_ty: ir_type.IrTypeId, loc: lang_source.Location, flags: u16) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = ptr;
    val r: res[value.Value, fail.Fail] = push(c, blk, ir_instruction.OP_LOAD, elem_ty, ir_type.IRT_NIL, ?ops[0], 1, loc);
    if (sel r.ok) { c.fn.instrs[r.ok.data.instr::u32].flags = flags; }
    ret r;
}

pub fun emit_store(c: *Ctx, blk: *me_ir.Block, v: value.Value, ptr: value.Value, loc: lang_source.Location, flags: u16) err[fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = v;
    ops[1] = ptr;
    val r: res[value.Value, fail.Fail] = push(c, blk, ir_instruction.OP_STORE, c.void_ty, ir_type.IRT_NIL, ?ops[0], 2, loc);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    c.fn.instrs[r.ok.data.instr::u32].flags = flags;
    ret err[fail.Fail].ok{};
}

pub fun lane_secret(c: *Ctx, loaded: value.Value, src_secret: bool) value.Value {
    if (!src_secret) { ret loaded; }
    var v: value.Value = loaded;
    v.secret = true;
    ir_instruction.mark_result_secret(c.fn.instrs, c.fn.instr_len, v);
    ret v;
}

pub fun emit_binop(c: *Ctx, blk: *me_ir.Block, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, a: value.Value, b: value.Value, loc: lang_source.Location) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = a;
    ops[1] = b;
    ret push(c, blk, kind, ty, ir_type.IRT_NIL, ?ops[0], 2, loc);
}

pub fun emit_unop(c: *Ctx, blk: *me_ir.Block, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, a: value.Value, loc: lang_source.Location) res[value.Value, fail.Fail] {
    var ops: [1]value.Value;
    ops[0] = a;
    ret push(c, blk, kind, ty, ir_type.IRT_NIL, ?ops[0], 1, loc);
}

pub fun resolve(c: *Ctx, v: value.Value) value.Value {
    if (v.kind == value.VAL_INSTR) {
        val iid: u32 = v.data.instr::u32;
        if (iid < c.n && c.pval_set[iid]) { ret c.pval[iid]; }
        ret v;
    }
    if (v.kind == value.VAL_PARAM) {
        val p: u32 = v.data.param_ix;
        if (p < c.pcount && c.is_vp[p]) { ret value.param(p, c.ptr_ty); }
        ret v;
    }
    ret v;
}

fun rewrite_ops(c: *Ctx, inst: *ir_instruction.Instruction) {
    var i: u32 = 0;
    for (i < inst.operand_count) {
        inst.operands[i] = resolve(c, inst.operands[i]);
        i                = i + 1;
    }
}

# a scalar `b` is a shift's uniform count, which every lane reads as it is
fun expand_binary(c: *Ctx, blk: *me_ir.Block, kind: ir_instruction.InstrKind, dst: value.Value, a: value.Value, b: value.Value, a_secret: bool, b_secret: bool, b_scalar: bool, vi: VInfo, loc: lang_source.Location) err[fail.Fail] {
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val pa: res[value.Value, fail.Fail] = lane_ptr(c, blk, a, arr, k, loc);
        if (sel pa.err) { ret err[fail.Fail].err{pa.err}; }
        val va: res[value.Value, fail.Fail] = emit_load(c, blk, pa.ok, vi.elem, loc, 0);
        if (sel va.err) { ret err[fail.Fail].err{va.err}; }

        var vb_v: value.Value = b;
        if (!b_scalar) {
            val pb: res[value.Value, fail.Fail] = lane_ptr(c, blk, b, arr, k, loc);
            if (sel pb.err) { ret err[fail.Fail].err{pb.err}; }
            val vb: res[value.Value, fail.Fail] = emit_load(c, blk, pb.ok, vi.elem, loc, 0);
            if (sel vb.err) { ret err[fail.Fail].err{vb.err}; }
            vb_v = lane_secret(c, vb.ok, b_secret);
        }

        val va_v: value.Value                 = lane_secret(c, va.ok, a_secret);
        val vr:   res[value.Value, fail.Fail] = emit_binop(c, blk, kind, vi.elem, va_v, vb_v, loc);
        if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }

        val pr: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr, k, loc);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, vr.ok, pr.ok, loc, 0);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_unary(c: *Ctx, blk: *me_ir.Block, kind: ir_instruction.InstrKind, dst: value.Value, a: value.Value, a_secret: bool, vi: VInfo, loc: lang_source.Location) err[fail.Fail] {
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val pa: res[value.Value, fail.Fail] = lane_ptr(c, blk, a, arr, k, loc);
        if (sel pa.err) { ret err[fail.Fail].err{pa.err}; }
        val va: res[value.Value, fail.Fail] = emit_load(c, blk, pa.ok, vi.elem, loc, 0);
        if (sel va.err) { ret err[fail.Fail].err{va.err}; }

        val va_v: value.Value                 = lane_secret(c, va.ok, a_secret);
        val vr:   res[value.Value, fail.Fail] = emit_unop(c, blk, kind, vi.elem, va_v, loc);
        if (sel vr.err) { ret err[fail.Fail].err{vr.err}; }

        val pr: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr, k, loc);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, vr.ok, pr.ok, loc, 0);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# converts each lane of `src` into the stack home `slot` of the result: a side
# with a memory image is reached through it, a side held in a register
# through lane reads, and a register result is loaded back from the home
pub fun expand_convert(c: *Ctx, blk: *me_ir.Block, kind: ir_instruction.InstrKind, slot: value.Value, dst_ty: ir_type.IrTypeId,
    src: value.Value, src_ty: ir_type.IrTypeId, secret: bool, loc: lang_source.Location) res[value.Value, fail.Fail] {
    var sv: VInfo;
    val rs: err[fail.Fail] = vec_info(c.m, src_ty, ?sv);
    if (sel rs.err) { ret res[value.Value, fail.Fail].err{rs.err}; }
    var dv: VInfo;
    val rd: err[fail.Fail] = vec_info(c.m, dst_ty, ?dv);
    if (sel rd.err) { ret res[value.Value, fail.Fail].err{rd.err}; }
    if (sv.lanes != dv.lanes) {
        ret res[value.Value, fail.Fail].err{fail.message("scalarize: a lane-wise conversion changes the lane count")};
    }
    val src_mem: bool = mem_image(c, src_ty);
    val dst_mem: bool = mem_image(c, dst_ty);

    var src_arr: ir_type.IrTypeId = src_ty;
    if (src_mem) {
        val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, sv.elem, sv.lanes);
        if (sel ra.err) { ret res[value.Value, fail.Fail].err{ra.err}; }
        src_arr = ra.ok;
    }
    var dst_arr: ir_type.IrTypeId = dst_ty;
    if (dst_mem) {
        val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, dv.elem, dv.lanes);
        if (sel ra.err) { ret res[value.Value, fail.Fail].err{ra.err}; }
        dst_arr = ra.ok;
    }

    var k: u32 = 0;
    for (k < sv.lanes) {
        var lane: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].ok{src};
        if (src_mem) {
            val pa: res[value.Value, fail.Fail] = lane_ptr(c, blk, src, src_arr, k, loc);
            if (sel pa.err) { ret pa; }
            lane = emit_load(c, blk, pa.ok, sv.elem, loc, 0);
        }
        or {
            lane = emit_lane_read(c, blk, src, sv.elem, k, loc);
        }
        if (sel lane.err) { ret lane; }
        val lv: value.Value                 = lane_secret(c, lane.ok, secret);
        val cv: res[value.Value, fail.Fail] = emit_unop(c, blk, kind, dv.elem, lv, loc);
        if (sel cv.err) { ret cv; }
        val pr: res[value.Value, fail.Fail] = lane_ptr(c, blk, slot, dst_arr, k, loc);
        if (sel pr.err) { ret pr; }
        val st: err[fail.Fail] = emit_store(c, blk, lane_secret(c, cv.ok, secret), pr.ok, loc, 0);
        if (sel st.err) { ret res[value.Value, fail.Fail].err{st.err}; }
        k = k + 1;
    }
    if (dst_mem) { ret res[value.Value, fail.Fail].ok{slot}; }
    val loaded: res[value.Value, fail.Fail] = emit_load(c, blk, slot, dst_ty, loc, 0);
    if (sel loaded.err) { ret loaded; }
    ret res[value.Value, fail.Fail].ok{lane_secret(c, loaded.ok, secret)};
}

# the stack home of a conversion result: the lane array of a memory image, or
# the vector itself when the result is held in a register. a reinterpret's home
# holds the non-vector side whole and the image's lanes, so it takes whichever
# of the two types aligns it more strictly
fun make_conv_slot(c: *Ctx, iid: u32, inst: *ir_instruction.Instruction) err[fail.Fail] {
    var vty:    ir_type.IrTypeId = inst.ty;
    var scalar: ir_type.IrTypeId = ir_type.IRT_NIL;
    if (reinterprets_into_image(c, inst)) { scalar = inst.operands[0].ty; }
    if (reinterprets_from_image(c, inst)) {
        vty    = inst.operands[0].ty;
        scalar = inst.ty;
    }
    var aux: ir_type.IrTypeId = vty;
    if (mem_image(c, vty)) {
        var vi: VInfo;
        val vr: err[fail.Fail] = vec_info(c.m, vty, ?vi);
        if (sel vr.err) { ret vr; }
        val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        aux = ra.ok;
        val machine: layout.Machine = resolved.layout_machine(c.tgt);
        if (!ir_type.is_nil(scalar)
            && ir_type.byte_align_for_machine(?c.m.types, scalar, machine) > ir_type.byte_align_for_machine(?c.m.types, aux, machine)) {
            aux = scalar;
        }
    }
    var ops: [1]value.Value;
    ops[0] = value.const_int(1, c.idx_ty);
    val ri: res[ir_id.InstructionId, fail.Fail] = new_instr(c.m, c.fn, ir_instruction.OP_ALLOCA, c.ptr_ty, aux, ?ops[0], 1, lang_source.location_nil());
    if (sel ri.err) { ret err[fail.Fail].err{ri.err}; }
    c.conv_slot[iid]          = value.instr(ri.ok, c.ptr_ty);
    c.homed[iid]              = true;
    c.conv_allocs[c.conv_len] = ri.ok;
    c.conv_len                = c.conv_len + 1;
    ret err[fail.Fail].ok{};
}

# reserves a home for every conversion `wanted` selects, before any block is rebuilt
pub fun reserve_conv_slots(c: *Ctx, wanted: fun(*Ctx, *ir_instruction.Instruction) bool) err[fail.Fail] {
    var count: u32 = 0;
    var i:     u32 = 0;
    for (i < c.n) {
        if (c.listed[i] && wanted(c, ?c.fn.instrs[i])) { count = count + 1; }
        i = i + 1;
    }
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val rs: res[*value.Value, A.Error] = A.allocate[value.Value](c.alloc, c.n::usize);
    if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
    c.conv_slot = rs.ok;
    val ra: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](c.alloc, c.n::usize);
    if (sel ra.err) { ret err[fail.Fail].err{fail.refused(ra.err)}; }
    c.conv_allocs = ra.ok;
    val rh: res[*bool, A.Error] = A.zallocate[bool](c.alloc, c.n::usize);
    if (sel rh.err) { ret err[fail.Fail].err{fail.refused(rh.err)}; }
    c.homed = rh.ok;
    i       = 0;
    for (i < c.n) {
        val inst: *ir_instruction.Instruction = ?c.fn.instrs[i];
        if (c.listed[i] && wanted(c, inst)) {
            val r: err[fail.Fail] = make_conv_slot(c, i, inst);
            if (sel r.err) { ret r; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun append_conv_slots(c: *Ctx, blk: *me_ir.Block) err[fail.Fail] {
    var s: u32 = 0;
    for (s < c.conv_len) {
        val r: err[fail.Fail] = me_ir.block_append_instr(c.m, blk, c.conv_allocs[s]);
        if (sel r.err) { ret r; }
        s = s + 1;
    }
    ret err[fail.Fail].ok{};
}

fun expand_compare(c: *Ctx, blk: *me_ir.Block, kind: ir_instruction.InstrKind, dst: value.Value, a: value.Value, b: value.Value,
    op: VInfo, mask: VInfo, i8_ty: ir_type.IrTypeId, loc: lang_source.Location) err[fail.Fail] {
    val rao: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, op.elem, op.lanes);
    if (sel rao.err) { ret err[fail.Fail].err{rao.err}; }
    val arr_op: ir_type.IrTypeId                 = rao.ok;
    val ram:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, mask.elem, mask.lanes);
    if (sel ram.err) { ret err[fail.Fail].err{ram.err}; }
    val arr_mask: ir_type.IrTypeId = ram.ok;

    val need_sext: bool             = (kind == ir_instruction.OP_CMP_LT_S || kind == ir_instruction.OP_CMP_LE_S) && op.bits < 32;
    var ext_ty:    ir_type.IrTypeId = ir_type.IRT_NIL;
    if (need_sext) {
        val rx: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?c.m.types, 32);
        if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
        ext_ty = rx.ok;
    }

    var k: u32 = 0;
    for (k < op.lanes) {
        val pa: res[value.Value, fail.Fail] = lane_ptr(c, blk, a, arr_op, k, loc);
        if (sel pa.err) { ret err[fail.Fail].err{pa.err}; }
        val va: res[value.Value, fail.Fail] = emit_load(c, blk, pa.ok, op.elem, loc, 0);
        if (sel va.err) { ret err[fail.Fail].err{va.err}; }

        val pb: res[value.Value, fail.Fail] = lane_ptr(c, blk, b, arr_op, k, loc);
        if (sel pb.err) { ret err[fail.Fail].err{pb.err}; }
        val vb: res[value.Value, fail.Fail] = emit_load(c, blk, pb.ok, op.elem, loc, 0);
        if (sel vb.err) { ret err[fail.Fail].err{vb.err}; }

        var la: value.Value = va.ok;
        var lb: value.Value = vb.ok;
        if (need_sext) {
            val sa: res[value.Value, fail.Fail] = emit_unop(c, blk, ir_instruction.OP_SEXT, ext_ty, la, loc);
            if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
            la = sa.ok;
            val sb: res[value.Value, fail.Fail] = emit_unop(c, blk, ir_instruction.OP_SEXT, ext_ty, lb, loc);
            if (sel sb.err) { ret err[fail.Fail].err{sb.err}; }
            lb = sb.ok;
        }

        val cmp: res[value.Value, fail.Fail] = emit_binop(c, blk, kind, i8_ty, la, lb, loc);
        if (sel cmp.err) { ret err[fail.Fail].err{cmp.err}; }
        var wide: value.Value = cmp.ok;

        if (mask.bits != 8) {
            val z: res[value.Value, fail.Fail] = emit_unop(c, blk, ir_instruction.OP_ZEXT, mask.elem, wide, loc);
            if (sel z.err) { ret err[fail.Fail].err{z.err}; }
            wide = z.ok;
        }

        val neg: res[value.Value, fail.Fail] = emit_binop(c, blk, ir_instruction.OP_SUB, mask.elem, value.const_int(0, mask.elem), wide, loc);
        if (sel neg.err) { ret err[fail.Fail].err{neg.err}; }

        val pr: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr_mask, k, loc);
        if (sel pr.err) { ret err[fail.Fail].err{pr.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, neg.ok, pr.ok, loc, 0);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun copy_vector(c: *Ctx, blk: *me_ir.Block, dst: value.Value, src: value.Value, vi: VInfo, loc: lang_source.Location, read_flags: u16, write_flags: u16) err[fail.Fail] {
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val ps: res[value.Value, fail.Fail] = lane_ptr(c, blk, src, arr, k, loc);
        if (sel ps.err) { ret err[fail.Fail].err{ps.err}; }
        val v: res[value.Value, fail.Fail] = emit_load(c, blk, ps.ok, vi.elem, loc, read_flags);
        if (sel v.err) { ret err[fail.Fail].err{v.err}; }

        val pd: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, arr, k, loc);
        if (sel pd.err) { ret err[fail.Fail].err{pd.err}; }
        val rs: err[fail.Fail] = emit_store(c, blk, v.ok, pd.ok, loc, write_flags);
        if (sel rs.err) { ret rs; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun make_slot(c: *Ctx, vty: ir_type.IrTypeId, slots: *ir_id.InstructionId, slot_len: *u32) res[value.Value, fail.Fail] {
    var vi: VInfo;
    val vr: err[fail.Fail] = vec_info(c.m, vty, ?vi);
    if (sel vr.err) { ret res[value.Value, fail.Fail].err{vr.err}; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret res[value.Value, fail.Fail].err{ra.err}; }
    val arr: ir_type.IrTypeId = ra.ok;

    var ops: [1]value.Value;
    ops[0] = value.const_int(1, c.idx_ty);
    val ri: res[ir_id.InstructionId, fail.Fail] = new_instr(c.m, c.fn, ir_instruction.OP_ALLOCA, c.ptr_ty, arr, ?ops[0], 1, lang_source.location_nil());
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    val iid: ir_id.InstructionId = ri.ok;
    slots[@slot_len] = iid;
    @slot_len        = @slot_len + 1;
    ret res[value.Value, fail.Fail].ok{value.instr(iid, c.ptr_ty)};
}

fun retype_aux(c: *Ctx, inst: *ir_instruction.Instruction) err[fail.Fail] {
    if (ir_type.is_nil(inst.aux_ty)) { ret err[fail.Fail].ok{}; }
    if (!mem_image(c, inst.aux_ty))  { ret err[fail.Fail].ok{}; }
    var vi: VInfo;
    val vr: err[fail.Fail] = vec_info(c.m, inst.aux_ty, ?vi);
    if (sel vr.err) { ret vr; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    inst.aux_ty = ra.ok;
    ret err[fail.Fail].ok{};
}

fun scalarize_function(c: *Ctx, i8_ty: ir_type.IrTypeId) err[fail.Fail] {
    val fn: *me_ir.Function = c.fn;

    var slots:    *ir_id.InstructionId = nil;
    var slot_len: u32                  = 0;
    fin { slots_free(c, slots); }
    if (c.n > 0) {
        val rs: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](c.alloc, c.n::usize);
        if (sel rs.err) { ret err[fail.Fail].err{fail.refused(rs.err)}; }
        slots = rs.ok;
    }

    val reserved: err[fail.Fail] = reserve_conv_slots(c, needs_home);
    if (sel reserved.err) { ret reserved; }

    var iid: u32 = 0;
    for (iid < c.n) {
        if (!c.listed[iid]) {
            iid = iid + 1;
            cnt;
        }
        val inst: *ir_instruction.Instruction = ?fn.instrs[iid];
        if (mem_image(c, inst.ty) && is_disallowed_op(inst.kind)) { ret err[fail.Fail].err{fail.message("scalarize: vector operator is not in the increment-1 table (remainder / negate)")}; }
        if (inst.kind == ir_instruction.OP_ALLOCA || inst.kind == ir_instruction.OP_GEP) {
            val rr: err[fail.Fail] = retype_aux(c, inst);
            if (sel rr.err) { ret rr; }
        }
        or (convert_touches_mem_image(c, inst)) {
            if (mem_image(c, inst.ty)) {
                c.pval[iid]     = c.conv_slot[iid];
                c.pval_set[iid] = true;
            }
        }
        or (reinterprets_into_image(c, inst)) {
            c.pval[iid]     = c.conv_slot[iid];
            c.pval_set[iid] = true;
        }
        or (produces_vector(c, inst)) {
            val vty: ir_type.IrTypeId            = inst.ty;
            val ms:  res[value.Value, fail.Fail] = make_slot(c, vty, slots, ?slot_len);
            if (sel ms.err) { ret err[fail.Fail].err{ms.err}; }
            c.pval[iid]     = ms.ok;
            c.pval_set[iid] = true;
        }
        or (inst.kind == ir_instruction.OP_PHI && mem_image(c, inst.ty)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::ir_id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        }
        or (inst.kind == ir_instruction.OP_CALL && mem_image(c, inst.ty)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::ir_id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        }
        or (is_vector_bitcast(c, inst)) {
            inst.ty         = c.ptr_ty;
            c.pval[iid]     = value.instr(iid::ir_id.InstructionId, c.ptr_ty);
            c.pval_set[iid] = true;
        }
        iid = iid + 1;
    }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block   = ?fn.blocks[bi];
        val rf:  err[fail.Fail] = fill_block(c, blk, bi == 0, slots, slot_len, i8_ty);
        if (sel rf.err) { ret rf; }
        bi = bi + 1;
    }

    rewrite_uses(c, fn);

    ret err[fail.Fail].ok{};
}

fun slots_free(c: *Ctx, slots: *ir_id.InstructionId) {
    if (slots != nil && c.n > 0) {
        A.deallocate[ir_id.InstructionId](c.alloc, slots, c.n::usize);
    }
}

fun fill_block(c: *Ctx, blk: *me_ir.Block, is_entry: bool, slots: *ir_id.InstructionId, slot_len: u32, i8_ty: ir_type.IrTypeId) err[fail.Fail] {
    val old_len: u32                  = blk.instr_count;
    var old:     *ir_id.InstructionId = nil;
    fin { body_free(c, old, old_len); }
    if (old_len > 0) {
        val ro: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](c.alloc, old_len::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        old = ro.ok;
        var i: u32 = 0;
        for (i < old_len) {
            old[i] = blk.instructions[i];
            i      = i + 1;
        }
    }
    blk.instr_count = 0;

    if (is_entry) {
        var s: u32 = 0;
        for (s < slot_len) {
            val ra: err[fail.Fail] = me_ir.block_append_instr(c.m, blk, slots[s]);
            if (sel ra.err) { ret ra; }
            s = s + 1;
        }
        val rc: err[fail.Fail] = append_conv_slots(c, blk);
        if (sel rc.err) { ret rc; }
    }

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur: ir_id.InstructionId = old[oi];
        val rr:  err[fail.Fail]      = fill_one(c, blk, cur, i8_ty);
        if (sel rr.err) { ret rr; }
        oi = oi + 1;
    }

    ret err[fail.Fail].ok{};
}

pub fun body_free(c: *Ctx, old: *ir_id.InstructionId, old_len: u32) {
    if (old != nil && old_len > 0) {
        A.deallocate[ir_id.InstructionId](c.alloc, old, old_len::usize);
    }
}

fun expand_lane_read_scalarized(c: *Ctx, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val ip:     *ir_instruction.Instruction = ?c.fn.instrs[cur::u32];
    val src_ty: ir_type.IrTypeId            = ip.operands[0].ty;
    val elem:   ir_type.IrTypeId            = ip.ty;
    val loc:    lang_source.Location        = ip.loc;
    val secret: bool                        = ip.operands[0].secret;

    if (ip.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("scalarize: vector lane index is not a constant")};
    }
    val k:    u32         = ip.operands[1].data.int_lit::u32;
    val base: value.Value = resolve(c, ip.operands[0]);

    var vi: VInfo;
    val rv: err[fail.Fail] = vec_info(c.m, src_ty, ?vi);
    if (sel rv.err) { ret rv; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }

    val rp: res[value.Value, fail.Fail] = lane_ptr(c, blk, base, ra.ok, k, loc);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    val rl: res[value.Value, fail.Fail] = emit_load(c, blk, rp.ok, elem, loc, 0);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }

    c.pval[cur::u32]     = lane_secret(c, rl.ok, secret);
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun expand_lane_write_scalarized(c: *Ctx, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val ip:  *ir_instruction.Instruction = ?c.fn.instrs[cur::u32];
    val vty: ir_type.IrTypeId            = ip.ty;
    val loc: lang_source.Location        = ip.loc;

    if (ip.operands[1].kind != value.VAL_CONST_INT) {
        ret err[fail.Fail].err{fail.message("scalarize: vector lane index is not a constant")};
    }
    val k:        u32         = ip.operands[1].data.int_lit::u32;
    val dst:      value.Value = c.pval[cur::u32];
    val src:      value.Value = resolve(c, ip.operands[0]);
    val lane_val: value.Value = resolve(c, ip.operands[2]);

    var vi: VInfo;
    val rv: err[fail.Fail] = vec_info(c.m, vty, ?vi);
    if (sel rv.err) { ret rv; }
    val rc: err[fail.Fail] = copy_vector(c, blk, dst, src, vi, loc, 0, 0);
    if (sel rc.err) { ret rc; }

    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val rp: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, ra.ok, k, loc);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    ret emit_store(c, blk, lane_val, rp.ok, loc, 0);
}

# a join of register pieces into a memory image stores each piece whole at
# its first lane
fun expand_join_into_image(c: *Ctx, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val vty: ir_type.IrTypeId     = c.fn.instrs[cur::u32].ty;
    val loc: lang_source.Location = c.fn.instrs[cur::u32].loc;
    val n:   u32                  = c.fn.instrs[cur::u32].operand_count;
    val dst: value.Value          = c.pval[cur::u32];
    var vi:  VInfo;
    val rv:  err[fail.Fail]       = vec_info(c.m, vty, ?vi);
    if (sel rv.err) { ret rv; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    var at: u32 = 0;
    var i:  u32 = 0;
    for (i < n) {
        val part: value.Value    = resolve(c, c.fn.instrs[cur::u32].operands[i]);
        var pi:   VInfo;
        val rp:   err[fail.Fail] = vec_info(c.m, c.fn.instrs[cur::u32].operands[i].ty, ?pi);
        if (sel rp.err) { ret rp; }
        val ptr: res[value.Value, fail.Fail] = lane_ptr(c, blk, dst, ra.ok, at, loc);
        if (sel ptr.err) { ret err[fail.Fail].err{ptr.err}; }
        val st: err[fail.Fail] = emit_store(c, blk, part, ptr.ok, loc, 0);
        if (sel st.err) { ret st; }
        at = at + pi.lanes;
        i  = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# a register-width range of a memory image is one load of its lanes
fun expand_range_from_image(c: *Ctx, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val ty:     ir_type.IrTypeId     = c.fn.instrs[cur::u32].ty;
    val loc:    lang_source.Location = c.fn.instrs[cur::u32].loc;
    val src_ty: ir_type.IrTypeId     = c.fn.instrs[cur::u32].operands[0].ty;
    val secret: bool                 = c.fn.instrs[cur::u32].operands[0].secret;
    val first:  u32                  = c.fn.instrs[cur::u32].operands[1].data.int_lit::u32;
    val src:    value.Value          = resolve(c, c.fn.instrs[cur::u32].operands[0]);
    var vi:     VInfo;
    val rv:     err[fail.Fail]       = vec_info(c.m, src_ty, ?vi);
    if (sel rv.err) { ret rv; }
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?c.m.types, vi.elem, vi.lanes);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    var ptr: value.Value = src;
    if (first != 0) {
        val rp: res[value.Value, fail.Fail] = lane_ptr(c, blk, src, ra.ok, first, loc);
        if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
        ptr = rp.ok;
    }
    val rl: res[value.Value, fail.Fail] = emit_load(c, blk, ptr, ty, loc, 0);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    c.pval[cur::u32]     = lane_secret(c, rl.ok, secret);
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun expand_reinterpret_from_image(c: *Ctx, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val ty:     ir_type.IrTypeId     = c.fn.instrs[cur::u32].ty;
    val loc:    lang_source.Location = c.fn.instrs[cur::u32].loc;
    val secret: bool                 = c.fn.instrs[cur::u32].operands[0].secret;
    val home:   value.Value          = c.conv_slot[cur::u32];
    var vi:     VInfo;
    val rv:     err[fail.Fail]       = vec_info(c.m, c.fn.instrs[cur::u32].operands[0].ty, ?vi);
    if (sel rv.err) { ret rv; }
    val rc: err[fail.Fail] = copy_vector(c, blk, home, resolve(c, c.fn.instrs[cur::u32].operands[0]), vi, loc, 0, 0);
    if (sel rc.err) { ret rc; }
    val rl: res[value.Value, fail.Fail] = emit_load(c, blk, home, ty, loc, 0);
    if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
    c.pval[cur::u32]     = lane_secret(c, rl.ok, secret);
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun fill_one(c: *Ctx, blk: *me_ir.Block, cur: ir_id.InstructionId, i8_ty: ir_type.IrTypeId) err[fail.Fail] {
    val fn: *me_ir.Function = c.fn;

    val ip:        *ir_instruction.Instruction = ?fn.instrs[cur::u32];
    val kind:      ir_instruction.InstrKind    = ip.kind;
    val ty:        ir_type.IrTypeId            = ip.ty;
    val loc:       lang_source.Location        = ip.loc;
    val is_vec_ty: bool                        = mem_image(c, ty);

    if (convert_touches_mem_image(c, ip)) {
        val src: value.Value                 = resolve(c, ip.operands[0]);
        val rv:  res[value.Value, fail.Fail] = expand_convert(c, blk, kind, c.conv_slot[cur::u32], ty,
            src, ip.operands[0].ty, ip.operands[0].secret, loc);
        if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
        c.pval[cur::u32]     = rv.ok;
        c.pval_set[cur::u32] = true;
        ret err[fail.Fail].ok{};
    }

    if (kind == ir_instruction.OP_BITCAST && c.homed != nil && c.homed[cur::u32]) {
        if (ir_type.is_vector(?c.m.types, ip.operands[0].ty)) { ret expand_reinterpret_from_image(c, blk, cur); }
        ret emit_store(c, blk, resolve(c, ip.operands[0]), c.conv_slot[cur::u32], loc, 0);
    }

    if (is_vec_ty && (is_binary_op(kind) || is_unary_op(kind) || is_compare_op(kind)
        || kind == ir_instruction.OP_DECLASSIFY || kind == ir_instruction.OP_LOAD)) {
        val dst: value.Value = c.pval[cur::u32];
        if (is_compare_op(kind)) {
            val op0:   value.Value      = resolve(c, ip.operands[0]);
            val op1:   value.Value      = resolve(c, ip.operands[1]);
            val op0ty: ir_type.IrTypeId = ip.operands[0].ty;
            var opi:   VInfo;
            val re:    err[fail.Fail]   = vec_info(c.m, op0ty, ?opi);
            if (sel re.err) { ret re; }
            var mi: VInfo;
            val rm: err[fail.Fail] = vec_info(c.m, ty, ?mi);
            if (sel rm.err) { ret rm; }
            ret expand_compare(c, blk, kind, dst, op0, op1, opi, mi, i8_ty, loc);
        }
        var vi: VInfo;
        val rv: err[fail.Fail] = vec_info(c.m, ty, ?vi);
        if (sel rv.err) { ret rv; }
        if (kind == ir_instruction.OP_LOAD) {
            val src: value.Value = resolve(c, ip.operands[0]);
            ret copy_vector(c, blk, dst, src, vi, loc, ip.flags & ir_instruction.INSTR_FLAG_VOLATILE, 0);
        }
        if (is_unary_op(kind) || kind == ir_instruction.OP_DECLASSIFY) {
            val a: value.Value = resolve(c, ip.operands[0]);
            ret expand_unary(c, blk, kind, dst, a, ip.operands[0].secret, vi, loc);
        }
        val a: value.Value = resolve(c, ip.operands[0]);
        val b: value.Value = resolve(c, ip.operands[1]);
        ret expand_binary(c, blk, kind, dst, a, b, ip.operands[0].secret, ip.operands[1].secret,
            !ir_type.is_vector(?c.m.types, ip.operands[1].ty), vi, loc);
    }

    if (kind == ir_instruction.OP_VEC_EXTRACT && mem_image(c, ip.operands[0].ty)) {
        ret expand_lane_read_scalarized(c, blk, cur);
    }
    if (kind == ir_instruction.OP_VEC_CONCAT && is_vec_ty) {
        ret expand_join_into_image(c, blk, cur);
    }
    if (kind == ir_instruction.OP_VEC_RANGE && ip.operand_count == 2 && mem_image(c, ip.operands[0].ty) && !is_vec_ty) {
        ret expand_range_from_image(c, blk, cur);
    }
    if (kind == ir_instruction.OP_VEC_INSERT && is_vec_ty) {
        ret expand_lane_write_scalarized(c, blk, cur);
    }

    if (kind == ir_instruction.OP_STORE && mem_image(c, ip.operands[0].ty)) {
        val srcv: value.Value      = resolve(c, ip.operands[0]);
        val dstp: value.Value      = resolve(c, ip.operands[1]);
        val vty:  ir_type.IrTypeId = ip.operands[0].ty;
        var vi:   VInfo;
        val rv:   err[fail.Fail]   = vec_info(c.m, vty, ?vi);
        if (sel rv.err) { ret rv; }
        ret copy_vector(c, blk, dstp, srcv, vi, loc, 0, ip.flags & ir_instruction.INSTR_FLAG_VOLATILE);
    }

    rewrite_ops(c, ?fn.instrs[cur::u32]);
    ret me_ir.block_append_instr(c.m, blk, cur);
}

# the types a lane or gap expansion builds with
pub fun lane_types(m: *me_ir.Module, tgt: *resolved.Target) res[Types, fail.Fail] {
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret res[Types, fail.Fail].err{rv.err}; }
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret res[Types, fail.Fail].err{rp.err}; }
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, tgt.pointer_width * 8);
    if (sel ri.err) { ret res[Types, fail.Fail].err{ri.err}; }
    ret res[Types, fail.Fail].ok{Types{void_ty: rv.ok, ptr_ty: rp.ok, idx_ty: ri.ok, i8_ty: ir_type.IRT_NIL}};
}

pub fun emit_lane_read(c: *Ctx, blk: *me_ir.Block, vec: value.Value, elem_ty: ir_type.IrTypeId, k: u32, loc: lang_source.Location) res[value.Value, fail.Fail] {
    var ops: [2]value.Value;
    ops[0] = vec;
    ops[1] = value.const_int(k::u64, c.idx_ty);
    ret push(c, blk, ir_instruction.OP_VEC_EXTRACT, elem_ty, vec.ty, ?ops[0], 2, loc);
}

pub fun emit_lane_write(c: *Ctx, blk: *me_ir.Block, vec: value.Value, vty: ir_type.IrTypeId, k: u32, v: value.Value, loc: lang_source.Location) res[value.Value, fail.Fail] {
    var ops: [3]value.Value;
    ops[0] = vec;
    ops[1] = value.const_int(k::u64, c.idx_ty);
    ops[2] = v;
    ret push(c, blk, ir_instruction.OP_VEC_INSERT, vty, vty, ?ops[0], 3, loc);
}

pub fun rewrite_uses(c: *Ctx, fn: *me_ir.Function) {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[bi];
        var p:   u32          = 0;
        for (p < blk.phi_count) {
            rewrite_ops(c, ?fn.instrs[blk.phis[p]::u32]);
            p = p + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            rewrite_ops(c, ?fn.instrs[blk.instructions[ii]::u32]);
            ii = ii + 1;
        }
        if (!ir_id.instruction_is_nil(blk.terminator)) { rewrite_ops(c, ?fn.instrs[blk.terminator::u32]); }
        bi = bi + 1;
    }
}

# a parameter or a listed instruction; one this pass expanded stays in the arena unlisted
fun function_has_mem_image(m: *me_ir.Module, fn: *me_ir.Function, tgt: *resolved.Target) bool {
    var p: u32 = 0;
    for (p < fn.param_count) {
        if (!vecform.holds_in_register(m, tgt, fn.params[p].ty)) { ret true; }
        p = p + 1;
    }
    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[b];
        var i:   u32          = 0;
        for (i < blk.phi_count) {
            if (instr_has_mem_image(m, fn, tgt, blk.phis[i])) { ret true; }
            i = i + 1;
        }
        i = 0;
        for (i < blk.instr_count) {
            if (instr_has_mem_image(m, fn, tgt, blk.instructions[i])) { ret true; }
            i = i + 1;
        }
        if (!ir_id.instruction_is_nil(blk.terminator) && instr_has_mem_image(m, fn, tgt, blk.terminator)) { ret true; }
        b = b + 1;
    }
    ret false;
}

fun instr_has_mem_image(m: *me_ir.Module, fn: *me_ir.Function, tgt: *resolved.Target, iid: ir_id.InstructionId) bool {
    val found: opt[*ir_instruction.Instruction] = me_ir.instruction_get(fn, iid);
    if (sel found.none) { ret false; }
    val inst: *ir_instruction.Instruction = found.some;
    if (!vecform.holds_in_register(m, tgt, inst.ty))     { ret true; }
    if (!vecform.holds_in_register(m, tgt, inst.aux_ty)) { ret true; }
    var o: u32 = 0;
    for (o < inst.operand_count) {
        if (!vecform.holds_in_register(m, tgt, inst.operands[o].ty)) { ret true; }
        o = o + 1;
    }
    ret false;
}

# a run that owns its workspace
#[testing]
pub fun run(m: *me_ir.Module, tgt: *resolved.Target) res[bool, fail.Fail] {
    ret pass.run_alone(?PASS, m, tgt);
}

# the pass the pipeline schedules
pub val PASS: pass.Pass = pass.Pass{name: "scalarize", class: pass.CLASS_LEGALIZATION, run: nil, applies: nil, preserves: analysis.NONE, visit: scalarize_visit, skips: pass.SKIP_EXTERN | pass.SKIP_NO_INSTRS, eligible: has_mem_image, rounds: 1};

fun has_mem_image(f: *pass.Function) bool {
    ret function_has_mem_image(f.module, f.body, f.target);
}

# a function with a value in memory always changes
fun scalarize_visit(f: *pass.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:   *me_ir.Module                    = f.module;
    val tgt: *resolved.Target                 = f.target;
    val rp:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret res[bool, fail.Fail].err{rp.err}; }
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret res[bool, fail.Fail].err{rv.err}; }
    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, tgt.pointer_width * 8);
    if (sel ri.err) { ret res[bool, fail.Fail].err{ri.err}; }
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ret res[bool, fail.Fail].err{r8.err}; }
    var types:    Types          = Types{void_ty: rv.ok, ptr_ty: rp.ok, idx_ty: ri.ok, i8_ty: r8.ok};
    val expanded: err[fail.Fail] = scalarize_work(f, ?types, alloc);
    if (sel expanded.err) { ret res[bool, fail.Fail].err{expanded.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun scalarize_work(work: *pass.Function, t: *Types, alloc: *A.Allocator) err[fail.Fail] {
    val m:       *me_ir.Module    = work.module;
    val fn:      *me_ir.Function  = work.body;
    val tgt:     *resolved.Target = work.target;
    val void_ty: ir_type.IrTypeId = t.void_ty;
    val ptr_ty:  ir_type.IrTypeId = t.ptr_ty;
    val idx_ty:  ir_type.IrTypeId = t.idx_ty;
    val i8_ty:   ir_type.IrTypeId = t.i8_ty;
    var c:       Ctx;
    c.alloc    = alloc;
    c.m        = m;
    c.tgt      = tgt;
    c.fn       = fn;
    c.n        = fn.instr_len;
    c.lane_buf = nil;
    c.lane_cap = 0;
    c.pcount   = fn.param_count;
    c.void_ty  = void_ty;
    c.ptr_ty   = ptr_ty;
    c.idx_ty   = idx_ty;
    fin { ctx_free(?c); }

    val rpv: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, c.n::usize);
    if (sel rpv.err) { ret err[fail.Fail].err{fail.refused(rpv.err)}; }
    c.pval = rpv.ok;
    val rps: res[*bool, A.Error] = A.allocate[bool](alloc, c.n::usize);
    if (sel rps.err) { ret err[fail.Fail].err{fail.refused(rps.err)}; }
    c.pval_set = rps.ok;

    var iid: u32 = 0;
    for (iid < c.n) {
        c.pval_set[iid] = false;
        iid             = iid + 1;
    }

    c.is_vp = nil;
    if (c.pcount > 0) {
        val rvp: res[*bool, A.Error] = A.allocate[bool](alloc, c.pcount::usize);
        if (sel rvp.err) { ret err[fail.Fail].err{fail.refused(rvp.err)}; }
        c.is_vp = rvp.ok;
        var p: u32 = 0;
        for (p < c.pcount) {
            c.is_vp[p] = mem_image(?c, fn.params[p].ty);
            if (c.is_vp[p]) { fn.params[p] = value.retype(fn.params[p], ptr_ty); }
            p = p + 1;
        }
    }

    val rm: err[fail.Fail] = mark_listed(?c);
    if (sel rm.err) { ret rm; }

    val rf: err[fail.Fail] = scalarize_function(?c, i8_ty);
    if (sel rf.err) { ret err[fail.Fail].err{rf.err}; }
    ret err[fail.Fail].ok{};
}

pub fun mark_listed(c: *Ctx) err[fail.Fail] {
    val rl: res[*bool, A.Error] = A.zallocate[bool](c.alloc, c.n::usize);
    if (sel rl.err) { ret err[fail.Fail].err{fail.refused(rl.err)}; }
    c.listed = rl.ok;
    val fn: *me_ir.Function = c.fn;
    var b:  u32             = 0;
    for (b < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[b];
        var i:   u32          = 0;
        for (i < blk.phi_count) {
            c.listed[blk.phis[i]::u32] = true;
            i                          = i + 1;
        }
        i = 0;
        for (i < blk.instr_count) {
            c.listed[blk.instructions[i]::u32] = true;
            i                                  = i + 1;
        }
        if (!ir_id.instruction_is_nil(blk.terminator)) { c.listed[blk.terminator::u32] = true; }
        b = b + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun ctx_free(c: *Ctx) {
    if (c.lane_buf != nil && c.lane_cap > 0) {
        A.deallocate[value.Value](c.alloc, c.lane_buf, c.lane_cap::usize);
        c.lane_buf = nil;
        c.lane_cap = 0;
    }
    if (c.pval != nil && c.n > 0)        { A.deallocate[value.Value](c.alloc, c.pval, c.n::usize); }
    if (c.pval_set != nil && c.n > 0)    { A.deallocate[bool](c.alloc, c.pval_set, c.n::usize); }
    if (c.is_vp != nil && c.pcount > 0)  { A.deallocate[bool](c.alloc, c.is_vp, c.pcount::usize); }
    if (c.conv_slot != nil && c.n > 0)   { A.deallocate[value.Value](c.alloc, c.conv_slot, c.n::usize); }
    if (c.conv_allocs != nil && c.n > 0) { A.deallocate[ir_id.InstructionId](c.alloc, c.conv_allocs, c.n::usize); }
    if (c.homed != nil && c.n > 0)       { A.deallocate[bool](c.alloc, c.homed, c.n::usize); }
    if (c.listed != nil && c.n > 0)      { A.deallocate[bool](c.alloc, c.listed, c.n::usize); }
    c.pval        = nil;
    c.pval_set    = nil;
    c.is_vp       = nil;
    c.conv_slot   = nil;
    c.conv_allocs = nil;
    c.homed       = nil;
    c.conv_len    = 0;
    c.listed      = nil;
}

#[testing]
pub fun t_vec_binop_module(alloc: *A.Allocator, kind: ir_instruction.InstrKind, elem_bits: u32, lanes: u32, out: *me_ir.Module) bool {
    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(alloc, intern.STR_NIL);
    if (sel res_m.err) { ret false; }
    @out = res_m.ok;

    val res_e: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?out.types, elem_bits);
    if (sel res_e.err) { ret false; }
    val elem:  ir_type.IrTypeId                 = res_e.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?out.types, elem, lanes);
    if (sel res_v.err) { ret false; }
    val vec: ir_type.IrTypeId = res_v.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(out, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret false; }
    val fn:     *me_ir.Function            = ?out.functions[res_fn.ok];
    val params: res[*value.Value, A.Error] = A.allocate[value.Value](out.alloc, 2);
    if (sel params.err) { ret false; }
    val pv0: value.Value = value.param(0, vec);
    val pv1: value.Value = value.param(1, vec);
    fn.params      = params.ok;
    fn.param_count = 2;
    fn.params[0]   = pv0;
    fn.params[1]   = pv1;

    var bld: builder.Builder = builder.init(out);
    builder.set_function(?bld, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ret false; }
    builder.set_block(?bld, res_blk.ok);
    if (kind == ir_instruction.OP_MUL) {
        val product: res[value.Value, fail.Fail] = builder.emit_mul(?bld, pv0, pv1);
        if (sel product.err) { ret false; }
        ret true;
    }
    if (kind == ir_instruction.OP_DIV_S) {
        val quotient: res[value.Value, fail.Fail] = builder.emit_div_s(?bld, pv0, pv1);
        ret sel quotient.ok;
    }
    if (kind == ir_instruction.OP_DIV_U) {
        val quotient_pv0: res[value.Value, fail.Fail] = builder.emit_div_u(?bld, pv0, pv1);
        ret sel quotient_pv0.ok;
    }
    val sum: res[value.Value, fail.Fail] = builder.emit_add(?bld, pv0, pv1);
    if (sel sum.err) { ret false; }
    ret true;
}

#[testing]
fun sext_count(tgt: *resolved.Target, kind: ir_instruction.InstrKind, elem_bits: u32, lanes: u32) u32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 0xFFFFFFFF; }
    var m: me_ir.Module = res_m.ok;

    val res_e: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, elem_bits);
    if (sel res_e.err) {
        me_ir.dnit(?m);
        ret 0xFFFFFFFF;
    }
    val elem:  ir_type.IrTypeId                 = res_e.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem, lanes);
    if (sel res_v.err) {
        me_ir.dnit(?m);
        ret 0xFFFFFFFF;
    }
    val vec: ir_type.IrTypeId = res_v.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) {
        me_ir.dnit(?m);
        ret 0xFFFFFFFF;
    }
    val fidx: u32             = res_fn.ok;
    val fn:   *me_ir.Function = ?m.functions[fidx];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) {
        me_ir.dnit(?m);
        ret 0xFFFFFFFF;
    }
    builder.set_block(?bld, res_blk.ok);

    val pv0:      value.Value                 = value.param(0, vec);
    val pv1:      value.Value                 = value.param(1, vec);
    val compared: res[value.Value, fail.Fail] = builder.emit_vcompare(?bld, kind, pv0, pv1, vec);
    if (sel compared.err) {
        me_ir.dnit(?m);
        ret 0xFFFFFFFF;
    }

    val ran: res[bool, fail.Fail] = run(?m, tgt);
    if (sel ran.err) {
        me_ir.dnit(?m);
        ret 0xFFFFFFFF;
    }

    val fnc:   *me_ir.Function = ?m.functions[fidx];
    var count: u32             = 0;
    var i:     u32             = 0;
    for (i < fnc.instr_len) {
        if (fnc.instrs[i].kind == ir_instruction.OP_SEXT) { count = count + 1; }
        i = i + 1;
    }
    me_ir.dnit(?m);
    ret count;
}

test expand_compare__sign_extends_narrow_signed_lanes {
    var rt:  resolved.Target = resolved.described_named("riscv64");
    var tgt: resolved.Target = rt;

    if (sext_count(?tgt, ir_instruction.OP_CMP_LT_S, 16, 8) != 16) { ret 1; }
    if (sext_count(?tgt, ir_instruction.OP_CMP_LE_S, 8, 16) != 32) { ret 1; }

    if (sext_count(?tgt, ir_instruction.OP_CMP_EQ, 16, 8) != 0)   { ret 1; }
    if (sext_count(?tgt, ir_instruction.OP_CMP_LT_U, 16, 8) != 0) { ret 1; }
    if (sext_count(?tgt, ir_instruction.OP_CMP_LT_S, 32, 4) != 0) { ret 1; }

    ret 0;
}

test run__reports_no_change_with_no_vector_values {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tgt: resolved.Target = resolved.described_named("riscv64");

    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;

    val res_i: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel res_i.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val i32t: ir_type.IrTypeId = res_i.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_blk.ok);
    val ps:      value.Value                 = value.param(0, i32t);
    val res_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, ps, ps);
    if (sel res_add.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val returned: err[fail.Fail] = builder.emit_ret(?bld, res_add.ok);
    if (sel returned.err) {
        me_ir.dnit(?m);
        ret 1;
    }

    val rr: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rr.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val changed: bool = rr.ok;
    me_ir.dnit(?m);
    if (changed != false) { ret 1; }
    ret 0;
}

test run__reports_change_once_when_a_vector_op_is_scalarized {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tgt: resolved.Target = resolved.described_named("riscv64");

    var m: me_ir.Module;
    if (!t_vec_binop_module(?alloc, ir_instruction.OP_MUL, 32, 4, ?m)) { ret 1; }

    val rr: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rr.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val again: res[bool, fail.Fail] = run(?m, ?tgt);
    me_ir.dnit(?m);
    if (rr.ok != true) { ret 1; }
    if (sel again.err) { ret 2; }
    if (again.ok)      { ret 3; }
    ret 0;
}

test resolve__deliberately_retypes_to_the_slot_pointer_not_the_use_site_type {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[me_ir.Module, fail.Fail] = me_ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: me_ir.Module = res_m.ok;

    val res_e: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel res_e.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val elem:  ir_type.IrTypeId                 = res_e.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem, 4);
    if (sel res_v.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val vec:   ir_type.IrTypeId                 = res_v.ok;
    val res_p: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel res_p.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId = res_p.ok;

    val res_fn: res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val fn: *me_ir.Function = ?m.functions[res_fn.ok];

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);
    val res_blk: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, res_blk.ok);

    val pv:    value.Value                 = value.param(0, vec);
    val r_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, pv, pv);
    if (sel r_add.err) {
        me_ir.dnit(?m);
        ret 1;
    }
    val add_id: u32 = r_add.ok.data.instr::u32;

    var pval:     [1]value.Value;
    var pval_set: [1]bool;
    pval[0]     = value.instr(add_id::ir_id.InstructionId, ptrt);
    pval_set[0] = true;

    var c: Ctx;
    c.pval     = ?pval[0];
    c.pval_set = ?pval_set[0];
    c.n        = 1;
    c.is_vp    = nil;
    c.pcount   = 0;
    c.ptr_ty   = ptrt;

    val use_site: value.Value = value.instr(add_id::ir_id.InstructionId, vec);
    val out:      value.Value = resolve(?c, use_site);

    var bad: i32 = 0;
    if (!ir_type.same(out.ty, ptrt)) { bad = 1; }
    if (ir_type.same(out.ty, vec))   { bad = 2; }

    me_ir.dnit(?m);
    ret bad;
}

#[testing]
rec Rejected {
    f: pass.Function;
    t: Types;
}

#[testing]
fun rejected_work(r: *Rejected, alloc: *A.Allocator) err[fail.Fail] {
    ret scalarize_work(?r.f, ?r.t, alloc);
}

test scalarize_work__rejected_work_does_not_retain_maps_in_ir {
    var backing: A.Allocator;
    val made:    err[A.Error] = page.make(?backing);
    if (sel made.err) { ret 1; }
    var owner:  arena.Arena;
    val opened: err[A.Error] = arena.init(?owner, ?backing, 0);
    if (sel opened.err) { ret 1; }
    fin { arena.dnit(?owner); }
    var alloc:      A.Allocator;
    val made_owner: err[A.Error] = arena.make(?alloc, ?owner);
    if (sel made_owner.err) { ret 1; }
    var module: me_ir.Module;
    if (!t_vec_binop_module(?alloc, ir_instruction.OP_ADD, 32, 4, ?module)) { ret 1; }
    fin { me_ir.dnit(?module); }
    val fn: *me_ir.Function = ?module.functions[0];
    fn.instrs[0].kind = ir_instruction.OP_REM_S;
    var tgt:  resolved.Target = resolved.described_named("riscv64");
    var work: Rejected        = Rejected{
        f: pass.Function{context: nil, module: ?module, target: ?tgt, body: fn, index: 0, analyses: nil},
        t: Types{void_ty: ir_type.IRT_NIL, ptr_ty: ir_type.IRT_NIL, idx_ty: ir_type.IRT_NIL, i8_ty: ir_type.IRT_NIL}
    };
    val chunk:            *arena.Chunk   = owner.chunk;
    val offset:           usize          = owner.off;
    var workspace:        scratch.Workspace;
    val opened_workspace: err[fail.Fail] = scratch.init(?workspace, ?backing);
    if (sel opened_workspace.err) { ret 1; }
    val rejected: err[fail.Fail] = scratch.run_unit[Rejected](?workspace, ?backing, ?work, rejected_work);
    scratch.dnit(?workspace);
    if (sel rejected.ok) { ret 2; }
    val reason: str = fail.describe(rejected.err);
    fin { str_free(?backing, reason); }
    if (!str_contains(reason, "vector operator is not"))                   { ret 3; }
    if (owner.chunk != chunk || owner.off != offset)                       { ret 4; }
    if (fn.instr_len != 1 || fn.instrs[0].kind != ir_instruction.OP_REM_S) { ret 5; }
    ret 0;
}

test new_instr__failure_releases_untransferred_operands {
    var tracking: T.Testing;
    val made:     err[A.Error] = T.make(?tracking);
    if (sel made.err) { ret 1; }
    fin { T.dnit(?tracking); }
    val initialized: res[me_ir.Module, fail.Fail] = me_ir.init(?tracking.a, intern.STR_NIL);
    if (sel initialized.err) { ret 1; }
    var module: me_ir.Module = initialized.ok;
    fin { me_ir.dnit(?module); }
    var fn: me_ir.Function = me_ir.function_new(?tracking.a, intern.STR_NIL, ir_type.IRT_NIL, 0);
    fin { me_ir.function_dnit(?module, ?fn); }
    val live: usize = tracking.live;
    tracking.fail_at = tracking.attempts + 2;
    var operands: [1]value.Value;
    operands[0] = value.const_int(7, ir_type.IRT_NIL);
    val inserted: res[ir_id.InstructionId, fail.Fail] = new_instr(?module, ?fn, ir_instruction.OP_RET,
        ir_type.IRT_NIL, ir_type.IRT_NIL, ?operands[0], 1, lang_source.location_nil());
    if (sel inserted.ok)                                            { ret 2; }
    if (tracking.live != live || tracking.double_frees != 0)        { ret 3; }
    if (tracking.attempts != tracking.fail_at || fn.instr_len != 0) { ret 4; }
    ret 0;
}

# the fail-at-N fixture: two 4 x i32 vector parameters multiplied (a gap on
# x86-64), divided (a gap everywhere), one lane extracted (a lane op x86-64
# lacks) and returned
#[testing]
fun probe_build(a: *me_testing.Attempt, m: *me_ir.Module) i32 {
    val res_e: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel res_e.err) { ret 1; }
    val elem:  ir_type.IrTypeId                 = res_e.ok;
    val res_v: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem, 4);
    if (sel res_v.err) { ret 2; }
    val vec:    ir_type.IrTypeId    = res_v.ok;
    val res_fn: res[u32, fail.Fail] = me_ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel res_fn.err) { ret 3; }
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[res_fn.ok]);
    val res_blk: res[ir_id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel res_blk.err) { ret 4; }
    builder.set_block(?bld, res_blk.ok);
    val pv0:     value.Value                 = value.param(0, vec);
    val pv1:     value.Value                 = value.param(1, vec);
    val res_mul: res[value.Value, fail.Fail] = builder.emit_mul(?bld, pv0, pv1);
    if (sel res_mul.err) { ret 5; }
    val res_div: res[value.Value, fail.Fail] = builder.emit_div_s(?bld, res_mul.ok, pv1);
    if (sel res_div.err) { ret 6; }
    val res_lane: res[value.Value, fail.Fail] = builder.emit_vec_extract(?bld, res_div.ok, value.const_int(1, elem), elem);
    if (sel res_lane.err) { ret 7; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?bld, res_lane.ok);
    if (sel r_ret.err) { ret 8; }
    ret 0;
}

#[testing]
fun probe_run(a: *me_testing.Attempt, m: *me_ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    var ctx: pass.Context         = pass.context(m, a.target, workspace);
    val r:   res[bool, fail.Fail] = pass.run(?PASS, ?ctx);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the per-function maps are scratch and precede the rewrite; each expansion
# emits its replacement instructions from the module as it goes, so a refusal
# there leaves the function partly expanded, with at least as many
# instructions as before and the original operators still present until the
# erasure that ends the function
#[testing]
fun probe_contract(a: *me_testing.Attempt, m: *me_ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    ret m.functions[0].instr_len >= a.control.functions[0].instr_len;
}

#[testing]
pub fun probe_walk(isa_name: str, transform: fun(*me_testing.Attempt, *me_ir.Module, *scratch.Workspace) err[fail.Fail]) i32 {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var tgt: resolved.Target    = resolved.described_named(isa_name);
    var a:   me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: transform,
        contract: probe_contract, target: ?tgt, control: nil, context: nil};
    var control: me_ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 4; }
    fin { me_ir.dnit(?control); }
    ret me_testing.walk(?a);
}

test pass__refusal_at_every_ordinal_leaves_the_input_or_a_partial_expansion {
    ret probe_walk("riscv64", probe_run);
}
