# the vector operations a target with 128-bit vectors packs no instruction
# for, each expanded to scalar lanes of the register value
use mach.lang.fail;
use std.allocator.arena;
use std.allocator.page;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use T: std.allocator.testing;

use mach.lang.intern;
use mach.lang.layout;
use mach.lang.me.analysis;
use me_ir: mach.lang.me.ir;
use mach.lang.me.ir.builder;
use ir_effect: mach.lang.me.ir.effect;
use mach.lang.me.ir.equal;
use ir_id:          mach.lang.me.ir.id;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use scalarize_lanes: mach.lang.me.legalize.scalarize.lanes;
use mach.lang.me.legalize.scalarize.place;
use mach.lang.me.legalize.scalarize.sites;
use mach.lang.me.pass;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.vecform;
use lang_source:  mach.lang.source;
use target_model: mach.lang.target.model;
use mach.lang.target.resolved;

fun has_gap_op(m: *me_ir.Module, fn: *me_ir.Function, tgt: *resolved.Target) bool {
    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *me_ir.Block = ?fn.blocks[b];
        var i:   u32          = 0;
        for (i < blk.instr_count) {
            val inst: *ir_instruction.Instruction = ?fn.instrs[blk.instructions[i]::u32];
            if (place.is_operator(m, inst) && !vecform.realizes_packed(m, tgt, inst)) { ret true; }
            i = i + 1;
        }
        b = b + 1;
    }
    ret false;
}

fun expand_gap_op(c: *place.Ctx, tgt: *resolved.Target, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val fn:   *me_ir.Function             = c.fn;
    val ip:   *ir_instruction.Instruction = ?fn.instrs[cur::u32];
    val kind: ir_instruction.InstrKind    = ip.kind;
    val loc:  lang_source.Location        = ip.loc;
    val vty:  ir_type.IrTypeId            = ip.ty;

    if (place.is_compare_op(kind)) { ret expand_gap_compare(c, tgt, blk, cur); }
    if (place.is_convert_op(kind)) { ret expand_gap_convert(c, tgt, blk, cur); }
    if (!place.is_binary_op(kind) && !place.is_unary_op(kind)) {
        ret err[fail.Fail].err{fail.message("scalarize: gap operator is not a lane-wise arithmetic or bitwise op")};
    }

    var vi:  place.VInfo;
    val rvi: err[fail.Fail] = place.vec_info(c.m, vty, ?vi);
    if (sel rvi.err) { ret rvi; }

    val unary: bool = place.is_unary_op(kind);
    if (ip.operand_count < 1)           { ret err[fail.Fail].err{fail.message("scalarize: gap operator missing operands")}; }
    if (!unary && ip.operand_count < 2) { ret err[fail.Fail].err{fail.message("scalarize: gap operator missing operands")}; }

    val a: value.Value = place.resolve(c, ip.operands[0]);
    var b: value.Value = a;
    if (!unary) { b = place.resolve(c, ip.operands[1]); }
    val a_secret: bool = ip.operands[0].secret;
    var b_secret: bool = false;
    if (!unary) { b_secret = ip.operands[1].secret; }
    # a shift's uniform count is one scalar every lane reads as it is
    val b_scalar: bool = !unary && !ir_type.is_vector(?c.m.types, ip.operands[1].ty);

    val rlb: res[*value.Value, fail.Fail] = place.lane_scratch(c, vi.lanes);
    if (sel rlb.err) { ret err[fail.Fail].err{rlb.err}; }
    val lanes: *value.Value = rlb.ok;

    var k: u32 = 0;
    for (k < vi.lanes) {
        val ra: res[value.Value, fail.Fail] = place.emit_lane_read(c, blk, a, vi.elem, k, loc);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        val av: value.Value = place.lane_secret(c, ra.ok, a_secret);

        var rr: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].ok{av};
        if (unary) {
            rr = place.emit_unop(c, blk, kind, vi.elem, av, loc);
        }
        or (b_scalar) {
            rr = place.emit_binop(c, blk, kind, vi.elem, av, b, loc);
        }
        or {
            val rb: res[value.Value, fail.Fail] = place.emit_lane_read(c, blk, b, vi.elem, k, loc);
            if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
            val bv: value.Value = place.lane_secret(c, rb.ok, b_secret);
            rr = place.emit_binop(c, blk, kind, vi.elem, av, bv, loc);
        }
        if (sel rr.err) { ret err[fail.Fail].err{rr.err}; }
        lanes[k] = place.lane_secret(c, rr.ok, a_secret || b_secret);
        k        = k + 1;
    }

    var acc: value.Value = a;
    var j:   u32         = 0;
    for (j < vi.lanes) {
        val ri: res[value.Value, fail.Fail] = place.emit_lane_write(c, blk, acc, vty, j, lanes[j], loc);
        if (sel ri.err) { ret err[fail.Fail].err{ri.err}; }
        acc = ri.ok;
        j   = j + 1;
    }

    c.pval[cur::u32]     = acc;
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun gap_convert(c: *place.Ctx, inst: *ir_instruction.Instruction) bool {
    if (!place.is_convert_op(inst.kind) || c.tgt.model.has_vec_build) { ret false; }
    ret place.is_operator(c.m, inst) && !vecform.realizes_packed(c.m, c.tgt, inst);
}

# a target that builds a vector from its lanes takes the converted lanes
# directly; any other converts into the entry-block home reserved for it
fun expand_gap_convert(c: *place.Ctx, tgt: *resolved.Target, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val ip:   *ir_instruction.Instruction = ?c.fn.instrs[cur::u32];
    val kind: ir_instruction.InstrKind    = ip.kind;
    val loc:  lang_source.Location        = ip.loc;
    val vty:  ir_type.IrTypeId            = ip.ty;
    if (ip.operand_count < 1) { ret err[fail.Fail].err{fail.message("scalarize: gap conversion missing its operand")}; }
    val src:    value.Value = place.resolve(c, ip.operands[0]);
    val secret: bool        = ip.operands[0].secret;

    if (!tgt.model.has_vec_build) {
        val rv: res[value.Value, fail.Fail] = place.expand_convert(c, blk, kind, c.conv_slot[cur::u32], vty,
            src, ip.operands[0].ty, secret, loc);
        if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
        c.pval[cur::u32]     = rv.ok;
        c.pval_set[cur::u32] = true;
        ret err[fail.Fail].ok{};
    }

    var sv: place.VInfo;
    val rs: err[fail.Fail] = place.vec_info(c.m, ip.operands[0].ty, ?sv);
    if (sel rs.err) { ret rs; }
    var dv: place.VInfo;
    val rd: err[fail.Fail] = place.vec_info(c.m, vty, ?dv);
    if (sel rd.err) { ret rd; }
    if (sv.lanes != dv.lanes) {
        ret err[fail.Fail].err{fail.message("scalarize: a lane-wise conversion changes the lane count")};
    }
    val rlb: res[*value.Value, fail.Fail] = place.lane_scratch(c, sv.lanes);
    if (sel rlb.err) { ret err[fail.Fail].err{rlb.err}; }
    val lanes: *value.Value = rlb.ok;
    var k:     u32          = 0;
    for (k < sv.lanes) {
        val ra: res[value.Value, fail.Fail] = place.emit_lane_read(c, blk, src, sv.elem, k, loc);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        val cv: res[value.Value, fail.Fail] = place.emit_unop(c, blk, kind, dv.elem, place.lane_secret(c, ra.ok, secret), loc);
        if (sel cv.err) { ret err[fail.Fail].err{cv.err}; }
        lanes[k] = place.lane_secret(c, cv.ok, secret);
        k        = k + 1;
    }
    val rv: res[value.Value, fail.Fail] = place.push(c, blk, ir_instruction.OP_VEC_BUILD, vty, vty, ?lanes[0], sv.lanes, loc);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    c.pval[cur::u32]     = place.lane_secret(c, rv.ok, secret);
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun expand_gap_compare(c: *place.Ctx, tgt: *resolved.Target, blk: *me_ir.Block, cur: ir_id.InstructionId) err[fail.Fail] {
    val fn:      *me_ir.Function             = c.fn;
    val ip:      *ir_instruction.Instruction = ?fn.instrs[cur::u32];
    val kind:    ir_instruction.InstrKind    = ip.kind;
    val loc:     lang_source.Location        = ip.loc;
    val mask_ty: ir_type.IrTypeId            = ip.ty;

    if (ip.operand_count < 2) { ret err[fail.Fail].err{fail.message("scalarize: gap compare missing operands")}; }
    val op_ty: ir_type.IrTypeId = ip.operands[0].ty;

    var opi: place.VInfo;
    val ro:  err[fail.Fail] = place.vec_info(c.m, op_ty, ?opi);
    if (sel ro.err) { ret ro; }
    var mi: place.VInfo;
    val rm: err[fail.Fail] = place.vec_info(c.m, mask_ty, ?mi);
    if (sel rm.err) { ret rm; }
    if (opi.lanes != mi.lanes) {
        ret err[fail.Fail].err{fail.message("scalarize: gap compare mask has a different lane count from its operands")};
    }

    val ri8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?c.m.types, 8);
    if (sel ri8.err) { ret err[fail.Fail].err{ri8.err}; }
    val i8_ty: ir_type.IrTypeId = ri8.ok;

    val need_sext: bool             = (kind == ir_instruction.OP_CMP_LT_S || kind == ir_instruction.OP_CMP_LE_S) && opi.bits < 32;
    var ext_ty:    ir_type.IrTypeId = ir_type.IRT_NIL;
    if (need_sext) {
        val rx: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?c.m.types, 32);
        if (sel rx.err) { ret err[fail.Fail].err{rx.err}; }
        ext_ty = rx.ok;
    }

    val a:      value.Value = place.resolve(c, ip.operands[0]);
    val b:      value.Value = place.resolve(c, ip.operands[1]);
    val secret: bool        = ip.operands[0].secret || ip.operands[1].secret;

    val rlb: res[*value.Value, fail.Fail] = place.lane_scratch(c, opi.lanes);
    if (sel rlb.err) { ret err[fail.Fail].err{rlb.err}; }
    val lanes: *value.Value = rlb.ok;

    var k: u32 = 0;
    for (k < opi.lanes) {
        val ra: res[value.Value, fail.Fail] = place.emit_lane_read(c, blk, a, opi.elem, k, loc);
        if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
        var la: value.Value                 = place.lane_secret(c, ra.ok, ip.operands[0].secret);
        val rb: res[value.Value, fail.Fail] = place.emit_lane_read(c, blk, b, opi.elem, k, loc);
        if (sel rb.err) { ret err[fail.Fail].err{rb.err}; }
        var lb: value.Value = place.lane_secret(c, rb.ok, ip.operands[1].secret);

        if (need_sext) {
            val sa: res[value.Value, fail.Fail] = place.emit_unop(c, blk, ir_instruction.OP_SEXT, ext_ty, la, loc);
            if (sel sa.err) { ret err[fail.Fail].err{sa.err}; }
            la = place.lane_secret(c, sa.ok, ip.operands[0].secret);
            val sb: res[value.Value, fail.Fail] = place.emit_unop(c, blk, ir_instruction.OP_SEXT, ext_ty, lb, loc);
            if (sel sb.err) { ret err[fail.Fail].err{sb.err}; }
            lb = place.lane_secret(c, sb.ok, ip.operands[1].secret);
        }

        val cmp: res[value.Value, fail.Fail] = place.emit_binop(c, blk, kind, i8_ty, la, lb, loc);
        if (sel cmp.err) { ret err[fail.Fail].err{cmp.err}; }
        var wide: value.Value = place.lane_secret(c, cmp.ok, secret);

        if (mi.bits != 8) {
            val z: res[value.Value, fail.Fail] = place.emit_unop(c, blk, ir_instruction.OP_ZEXT, mi.elem, wide, loc);
            if (sel z.err) { ret err[fail.Fail].err{z.err}; }
            wide = place.lane_secret(c, z.ok, secret);
        }

        val neg: res[value.Value, fail.Fail] = place.emit_binop(c, blk, ir_instruction.OP_SUB, mi.elem,
            value.const_int(0, mi.elem), wide, loc);
        if (sel neg.err) { ret err[fail.Fail].err{neg.err}; }
        lanes[k] = place.lane_secret(c, neg.ok, secret);
        k        = k + 1;
    }

    var acc: value.Value;
    if (tgt.model.has_vec_build) {
        val rv: res[value.Value, fail.Fail] = place.push(c, blk, ir_instruction.OP_VEC_BUILD, mask_ty, mask_ty,
            ?lanes[0], opi.lanes, loc);
        if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
        acc = rv.ok;
    }
    or {
        if (!ir_type.same(mask_ty, op_ty)) {
            ret err[fail.Fail].err{fail.message("scalarize: no per-lane expansion for a gapped float-lane vector compare on a target that cannot build a vector from its lanes")};
        }
        acc = a;
        var j: u32 = 0;
        for (j < opi.lanes) {
            val rw: res[value.Value, fail.Fail] = place.emit_lane_write(c, blk, acc, mask_ty, j, lanes[j], loc);
            if (sel rw.err) { ret err[fail.Fail].err{rw.err}; }
            acc = rw.ok;
            j   = j + 1;
        }
    }

    c.pval[cur::u32]     = acc;
    c.pval_set[cur::u32] = true;
    ret err[fail.Fail].ok{};
}

fun expand_gap_block(c: *place.Ctx, tgt: *resolved.Target, blk: *me_ir.Block, is_entry: bool) err[fail.Fail] {
    val fn: *me_ir.Function = c.fn;

    val old_len: u32                  = blk.instr_count;
    var old:     *ir_id.InstructionId = nil;
    fin { place.body_free(c, old, old_len); }
    if (old_len > 0) {
        val ro: res[*ir_id.InstructionId, A.Error] = A.allocate[ir_id.InstructionId](c.alloc, old_len::usize);
        if (sel ro.err) { ret err[fail.Fail].err{fail.refused(ro.err)}; }
        old = ro.ok;
        var i: u32 = 0;
        for (i < old_len) {
            old[i] = blk.instructions[i];
            i      = i + 1;
        }
    }
    blk.instr_count = 0;

    if (is_entry) {
        val rc: err[fail.Fail] = place.append_conv_slots(c, blk);
        if (sel rc.err) { ret rc; }
    }

    var oi: u32 = 0;
    for (oi < old_len) {
        val cur:  ir_id.InstructionId         = old[oi];
        val inst: *ir_instruction.Instruction = ?fn.instrs[cur::u32];
        var rr:   err[fail.Fail]              = err[fail.Fail].ok{};
        if (place.is_operator(c.m, inst) && !vecform.realizes_packed(c.m, tgt, inst)) {
            rr = expand_gap_op(c, tgt, blk, cur);
        }
        or {
            rr = me_ir.block_append_instr(c.m, blk, cur);
        }
        if (sel rr.err) { ret rr; }
        oi = oi + 1;
    }

    ret err[fail.Fail].ok{};
}

fun gap_work(work: *pass.Function, t: *place.Types, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m:       *me_ir.Module    = work.module;
    val fn:      *me_ir.Function  = work.body;
    val tgt:     *resolved.Target = work.target;
    val void_ty: ir_type.IrTypeId = t.void_ty;
    val ptr_ty:  ir_type.IrTypeId = t.ptr_ty;
    val idx_ty:  ir_type.IrTypeId = t.idx_ty;
    if (!has_gap_op(m, fn, tgt)) { ret res[bool, fail.Fail].ok{false}; }

    var c: place.Ctx;
    c.alloc    = alloc;
    c.m        = m;
    c.tgt      = tgt;
    c.fn       = fn;
    c.n        = fn.instr_len;
    c.lane_buf = nil;
    c.lane_cap = 0;
    c.pcount   = 0;
    c.is_vp    = nil;
    c.void_ty  = void_ty;
    c.ptr_ty   = ptr_ty;
    c.idx_ty   = idx_ty;
    fin { place.ctx_free(?c); }

    val rpv: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, c.n::usize);
    if (sel rpv.err) { ret res[bool, fail.Fail].err{fail.refused(rpv.err)}; }
    c.pval = rpv.ok;
    val rps: res[*bool, A.Error] = A.zallocate[bool](alloc, c.n::usize);
    if (sel rps.err) { ret res[bool, fail.Fail].err{fail.refused(rps.err)}; }
    c.pval_set = rps.ok;
    val rm: err[fail.Fail] = place.mark_listed(?c);
    if (sel rm.err) { ret res[bool, fail.Fail].err{rm.err}; }

    val reserved: err[fail.Fail] = place.reserve_conv_slots(?c, gap_convert);
    if (sel reserved.err) { ret res[bool, fail.Fail].err{reserved.err}; }

    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val rb: err[fail.Fail] = expand_gap_block(?c, tgt, ?fn.blocks[bi], bi == 0);
        if (sel rb.err) { ret res[bool, fail.Fail].err{rb.err}; }
        bi = bi + 1;
    }
    place.rewrite_uses(?c, fn);

    ret res[bool, fail.Fail].ok{true};
}

# a run that owns its workspace
#[testing]
fun run(m: *me_ir.Module, tgt: *resolved.Target) res[bool, fail.Fail] {
    ret pass.run_alone(?PASS, m, tgt);
}

# the gap expansion the pipeline schedules
pub val PASS: pass.Pass = pass.Pass{name: "scalarize-gaps", class: pass.CLASS_LEGALIZATION, run: nil, applies: gaps_apply, preserves: analysis.NONE, visit: gaps_visit, skips: pass.SKIP_EXTERN | pass.SKIP_NO_INSTRS, eligible: nil, rounds: 1};

# a target with 128-bit vectors expands its gaps unless `simd = "require"` refuses them
fun gaps_apply(ctx: *pass.Context) bool {
    ret ctx.target.model.has_v128 && !ctx.simd_require;
}

fun gaps_visit(f: *pass.Function, alloc: *A.Allocator) res[bool, fail.Fail] {
    val t: res[place.Types, fail.Fail] = place.lane_types(f.module, f.target);
    if (sel t.err) { ret res[bool, fail.Fail].err{t.err}; }
    var types: place.Types = t.ok;
    ret gap_work(f, ?types, alloc);
}

test detect__agrees_with_expansion_on_every_cell {
    var alloc: A.Allocator;
    page.make(?alloc);

    # x86-64 packs the 32- and 64-bit multiplies through the pmuludq
    # sequences and scalarizes only the 8-bit one
    if (gap_agreement(?alloc, "x86_64", ir_instruction.OP_MUL, 32, 4) != 0)  { ret 1; }
    if (gap_agreement(?alloc, "riscv64", ir_instruction.OP_MUL, 32, 4) != 1) { ret 2; }
    if (gap_agreement(?alloc, "aarch64", ir_instruction.OP_MUL, 32, 4) != 0) { ret 3; }

    if (gap_agreement(?alloc, "x86_64", ir_instruction.OP_MUL, 64, 2) != 0)  { ret 4; }
    if (gap_agreement(?alloc, "aarch64", ir_instruction.OP_MUL, 64, 2) != 1) { ret 5; }
    if (gap_agreement(?alloc, "riscv64", ir_instruction.OP_MUL, 64, 2) != 1) { ret 6; }

    if (gap_agreement(?alloc, "x86_64", ir_instruction.OP_MUL, 16, 8) != 0)  { ret 7; }
    if (gap_agreement(?alloc, "aarch64", ir_instruction.OP_MUL, 16, 8) != 0) { ret 8; }
    if (gap_agreement(?alloc, "riscv64", ir_instruction.OP_MUL, 16, 8) != 1) { ret 9; }

    if (gap_agreement(?alloc, "x86_64", ir_instruction.OP_MUL, 8, 16) != 1)  { ret 18; }
    if (gap_agreement(?alloc, "aarch64", ir_instruction.OP_MUL, 8, 16) != 0) { ret 19; }

    if (gap_agreement(?alloc, "x86_64", ir_instruction.OP_ADD, 32, 4) != 0)  { ret 10; }
    if (gap_agreement(?alloc, "aarch64", ir_instruction.OP_ADD, 32, 4) != 0) { ret 11; }

    # division packs nowhere, whatever the lane width
    if (gap_agreement(?alloc, "x86_64", ir_instruction.OP_DIV_S, 8, 16) != 1)  { ret 12; }
    if (gap_agreement(?alloc, "x86_64", ir_instruction.OP_DIV_U, 32, 4) != 1)  { ret 13; }
    if (gap_agreement(?alloc, "aarch64", ir_instruction.OP_DIV_S, 64, 2) != 1) { ret 14; }
    if (gap_agreement(?alloc, "aarch64", ir_instruction.OP_DIV_U, 16, 8) != 1) { ret 15; }
    if (gap_agreement(?alloc, "riscv64", ir_instruction.OP_DIV_S, 32, 4) != 1) { ret 16; }
    ret 0;
}

#[testing]
fun gap_agreement(alloc: *A.Allocator, isa_name: str,
    kind: ir_instruction.InstrKind, elem_bits: u32, lanes: u32) u32 {
    var tgt: resolved.Target = resolved.described_named(isa_name);
    var m:   me_ir.Module;
    if (!place.t_vec_binop_module(alloc, kind, elem_bits, lanes, ?m)) { ret 0xFFFFFFFF; }

    var site:   sites.Site;
    val before: u32 = sites.detect(?m, ?tgt, ?site);

    if (tgt.model.has_v128) {
        val ran: res[bool, fail.Fail] = run(?m, ?tgt);
        if (sel ran.err) {
            me_ir.dnit(?m);
            ret 0xFFFFFFFF;
        }
        var after: sites.Site;
        if (sites.detect(?m, ?tgt, ?after) != 0) {
            me_ir.dnit(?m);
            ret 0xFFFFFFFF;
        }
    }

    me_ir.dnit(?m);
    ret before;
}

#[testing]
fun t_external_parameter(fn: *me_ir.Function, v: value.Value) u32 {
    var current: value.Value = v;
    var left:    u32         = fn.instr_len;
    for (left > 0 && current.kind == value.VAL_INSTR) {
        val ix: u32 = current.data.instr::u32;
        if (ix >= fn.instr_len || fn.instrs[ix].kind != ir_instruction.OP_GEP) { ret 0; }
        current = fn.instrs[ix].operands[0];
        left    = left - 1;
    }
    if (current.kind == value.VAL_PARAM) { ret current.data.param_ix + 1; }
    ret 0;
}

#[testing]
fun t_volatile_division(alloc: *A.Allocator, arch: str) i32 {
    var tgt: resolved.Target              = resolved.described_named(arch);
    val mr:  res[me_ir.Module, fail.Fail] = me_ir.init(alloc, intern.STR_NIL);
    if (sel mr.err) { ret 2; }
    var m: me_ir.Module = mr.ok;
    fin { me_ir.dnit(?m); }
    val pr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    val er: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    val vr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel pr.err) { ret 3; }
    if (sel er.err) { ret 3; }
    if (sel vr.err) { ret 3; }
    val pt:   ir_type.IrTypeId                 = pr.ok;
    val elem: ir_type.IrTypeId                 = er.ok;
    val vty:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem, 4);
    if (sel vty.err) { ret 4; }
    val vec: ir_type.IrTypeId    = vty.ok;
    val fr:  res[u32, fail.Fail] = me_ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel fr.err) { ret 5; }
    val fn:   *me_ir.Function            = ?m.functions[fr.ok];
    val args: res[*value.Value, A.Error] = A.allocate[value.Value](alloc, 4);
    if (sel args.err) { ret 6; }
    fn.params      = args.ok;
    fn.param_count = 4;
    var i: u32 = 0;
    for (i < 4) {
        fn.params[i] = value.param(i, pt);
        i            = i + 1;
    }
    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val br: res[ir_id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel br.err) { ret 7; }
    val bid: ir_id.BlockId = br.ok;
    builder.set_block(?b, bid);
    val blk: *me_ir.Block = ?fn.blocks[bid::u32];
    var c:   place.Ctx    = place.Ctx{alloc: alloc, m: ?m, fn: fn, ptr_ty: pt,
        void_ty: vr.ok};
    val loc:    lang_source.Location        = lang_source.location_nil();
    val scalar: res[value.Value, fail.Fail] = place.emit_load(?c, blk, value.param(3, pt), elem, loc, ir_instruction.INSTR_FLAG_VOLATILE);
    val lhs:    res[value.Value, fail.Fail] = place.emit_load(?c, blk, value.param(0, pt), vec, loc, ir_instruction.INSTR_FLAG_VOLATILE);
    val rhs:    res[value.Value, fail.Fail] = place.emit_load(?c, blk, value.param(1, pt), vec, loc, ir_instruction.INSTR_FLAG_VOLATILE);
    if (sel scalar.err) { ret 8; }
    if (sel lhs.err)    { ret 8; }
    if (sel rhs.err)    { ret 8; }
    val q: res[value.Value, fail.Fail] = place.emit_binop(?c, blk, ir_instruction.OP_DIV_S, vec,
        lhs.ok, rhs.ok, loc);
    if (sel q.err) { ret 9; }
    val stored: err[fail.Fail] = place.emit_store(?c, blk, q.ok, value.param(2, pt), loc, ir_instruction.INSTR_FLAG_VOLATILE);
    if (sel stored.err) { ret 10; }
    val stored_c: err[fail.Fail] = place.emit_store(?c, blk, scalar.ok, value.param(3, pt), loc, ir_instruction.INSTR_FLAG_VOLATILE);
    if (sel stored_c.err) { ret 11; }
    val returned: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel returned.err) { ret 12; }
    var site: sites.Site;
    if (sites.detect(?m, ?tgt, ?site) != 1 || site.op != ir_instruction.OP_DIV_S) { ret 13; }
    val ran: res[bool, fail.Fail] = place.run(?m, ?tgt);
    if (sel ran.err) { ret 14; }
    val gaps_expanded: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel gaps_expanded.err) { ret 14; }
    val lanes_expanded: res[bool, fail.Fail] = scalarize_lanes.run(?m, ?tgt);
    if (sel lanes_expanded.err) { ret 14; }
    val body:      *me_ir.Function = ?m.functions[0];
    val block:     *me_ir.Block    = ?body.blocks[bid::u32];
    var counts:    [4]u32          = [4]u32{0, 0, 0, 0};
    var divisions: u32             = 0;
    var phase:     u32             = 0;
    var accesses:  u32             = 1;
    if (!tgt.model.has_v128) { accesses = 4; }
    i = 0;
    for (i < block.instr_count) {
        val inst: *ir_instruction.Instruction = ?body.instrs[block.instructions[i]::u32];
        if (inst.kind == ir_instruction.OP_DIV_S || inst.kind == ir_instruction.OP_DIV_U) {
            if (inst.kind != ir_instruction.OP_DIV_S || !ir_type.same(inst.ty, elem) || !ir_type.same(inst.operands[0].ty, elem)
                || !ir_type.same(inst.operands[1].ty, elem) || counts[0] != accesses || counts[1] != accesses || counts[2] != 0) { ret 15; }
            divisions = divisions + 1;
        }
        if (inst.kind == ir_instruction.OP_LOAD || inst.kind == ir_instruction.OP_STORE) {
            var pointer:     value.Value      = inst.operands[0];
            var memory_type: ir_type.IrTypeId = inst.ty;
            if (inst.kind == ir_instruction.OP_STORE) {
                pointer     = inst.operands[1];
                memory_type = inst.operands[0].ty;
            }
            val owner: u32 = t_external_parameter(body, pointer);
            if (owner == 0) {
                if (ir_effect.is_volatile(inst)) { ret 16; }
            }
            or {
                if (owner > 4 || !ir_effect.is_volatile(inst)) { ret 17; }
                counts[owner - 1] = counts[owner - 1] + 1;
                if (owner == 4) {
                    if (!ir_type.same(memory_type, elem))                                       { ret 18; }
                    if (counts[3] == 1 && (phase != 0 || inst.kind != ir_instruction.OP_LOAD))  { ret 19; }
                    if (counts[3] == 2 && (phase != 3 || inst.kind != ir_instruction.OP_STORE)) { ret 20; }
                }
                or {
                    if (counts[3] != 1 || owner < phase) { ret 21; }
                    phase = owner;
                    val want_store: bool = owner == 3;
                    if ((inst.kind == ir_instruction.OP_STORE) != want_store) { ret 22; }
                    if (want_store && divisions != 4)                         { ret 23; }
                    if (accesses == 1 && !ir_type.same(memory_type, vec))     { ret 24; }
                    if (accesses == 4 && !ir_type.same(memory_type, elem))    { ret 25; }
                }
            }
        }
        i = i + 1;
    }
    if (divisions != 4 || counts[0] != accesses || counts[1] != accesses
        || counts[2] != accesses || counts[3] != 2) { ret 26; }
    ret 0;
}

test run__division_preserves_external_volatile_accesses {
    var alloc: A.Allocator;
    val made:  err[A.Error] = page.make(?alloc);
    if (sel made.err) { ret 1; }
    # a 128-bit vector target expands the gap, one without scalarizes it
    val x64: i32 = t_volatile_division(?alloc, "x86_64");
    if (x64 != 0) { ret x64; }
    ret t_volatile_division(?alloc, "riscv64");
}

#[testing]
fun probe_gaps(a: *me_testing.Attempt, m: *me_ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    var ctx: pass.Context         = pass.context(m, a.target, workspace);
    val r:   res[bool, fail.Fail] = pass.run(?PASS, ?ctx);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

test gaps__refusal_at_every_ordinal_leaves_the_input_or_a_partial_expansion {
    ret place.probe_walk("x86_64", probe_gaps);
}
