# the scalar expansion of the vector operations a target cannot execute
# packed: a value held in memory, a lane access without lane operations, and
# an operation with no packed instruction
fwd mach.lang.me.legalize.scalarize.place.PASS;
fwd GAPS:  mach.lang.me.legalize.scalarize.gaps.PASS;
fwd LANES: mach.lang.me.legalize.scalarize.lanes.PASS;
fwd mach.lang.me.legalize.scalarize.sites.Site;
fwd mach.lang.me.legalize.scalarize.sites.list;
fwd mach.lang.me.legalize.scalarize.sites.detect_undeclared;
