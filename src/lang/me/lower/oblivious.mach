# mach's oblivious rule: a function that computes on a secret declares `#[oblivious]`. one that
# only moves, stores or converts a secret may omit it. which opcodes move a value rather than
# compute on it is mach's reading of mirl's rows
use std.types.bool.bool;
use std.types.string.str;

use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;

fun is(code: Opcode, row: Opcode) bool {
    ret code.index == row.index;
}

# whether `code` moves or converts its operands rather than computing on them
pub fun moves(code: Opcode) bool {
    ret is(code, opcode.LOAD) || is(code, opcode.STORE) || is(code, opcode.ALLOCA) || is(code, opcode.PTR_ADD)
        || is(code, opcode.PTR_MEMBER) || is(code, opcode.PTR_INDEX) || is(code, opcode.FUNC_ADDR)
        || is(code, opcode.CALL) || is(code, opcode.CALL_PLACED) || is(code, opcode.RET) || is(code, opcode.RET_PLACED)
        || is(code, opcode.BR) || is(code, opcode.EXT_U) || is(code, opcode.EXT_S) || is(code, opcode.TRUNC)
        || is(code, opcode.BITCAST) || is(code, opcode.PTRTOINT) || is(code, opcode.INTTOPTR)
        || is(code, opcode.EXTRACT) || is(code, opcode.INSERT) || is(code, opcode.VEXTRACT) || is(code, opcode.VINSERT)
        || is(code, opcode.VSPLAT) || is(code, opcode.VBUILD) || is(code, opcode.VSHUFFLE)
        || is(code, opcode.MEM_COPY) || is(code, opcode.MEM_FILL) || is(code, opcode.DECLASSIFY)
        || is(code, opcode.ATOMIC_LOAD) || is(code, opcode.ATOMIC_STORE);
}

# what a diagnostic calls the computation `code` performs
pub fun class_name(code: Opcode) str {
    if (is(code, opcode.EQ) || is(code, opcode.NE) || is(code, opcode.LT_S) || is(code, opcode.LE_S) || is(code, opcode.GT_S)
        || is(code, opcode.GE_S) || is(code, opcode.LT_U) || is(code, opcode.LE_U) || is(code, opcode.GT_U) || is(code, opcode.GE_U)
        || is(code, opcode.FEQ_O) || is(code, opcode.FNE_O) || is(code, opcode.FLT_O) || is(code, opcode.FLE_O) || is(code, opcode.FGT_O)
        || is(code, opcode.FGE_O) || is(code, opcode.FORD) || is(code, opcode.FEQ_U) || is(code, opcode.FNE_U) || is(code, opcode.FLT_U)
        || is(code, opcode.FLE_U) || is(code, opcode.FGT_U) || is(code, opcode.FGE_U) || is(code, opcode.FUNO)) { ret "comparison"; }
    if (is(code, opcode.AND) || is(code, opcode.OR) || is(code, opcode.XOR) || is(code, opcode.NOT)) { ret "bitwise operation"; }
    if (is(code, opcode.SHL) || is(code, opcode.SHR_U) || is(code, opcode.SHR_S))                    { ret "shift"; }
    if (is(code, opcode.SELECT))                                                                     { ret "selection"; }
    if (is(code, opcode.ADD) || is(code, opcode.SUB) || is(code, opcode.MUL) || is(code, opcode.DIV_S) || is(code, opcode.DIV_U)
        || is(code, opcode.REM_S) || is(code, opcode.REM_U) || is(code, opcode.NEG) || is(code, opcode.FADD) || is(code, opcode.FSUB)
        || is(code, opcode.FMUL) || is(code, opcode.FDIV) || is(code, opcode.FREM) || is(code, opcode.FNEG)) { ret "arithmetic operation"; }
    ret "computation";
}
