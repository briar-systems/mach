pub fun lower_decl(ctx: *context.LowerContext, did: id.DeclId) R.Result[R.Void, fail.Fail] {
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(ctx.scope.a, did);
    if (O.is_none[*decl.Decl](opt_decl)) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: declaration id out of range"));
    }
    val d: *decl.Decl    = O.unwrap[*decl.Decl](opt_decl);
    val k: decl.DeclKind = d.kind;

    if (k == decl.DECL_KIND_FUN)         { ret lower_fun(ctx, did, d, false); }
    if (k == decl.DECL_KIND_TEST) {
        if (!ctx.test_mode) { ret R.ok_void[fail.Fail](); }
        ret lower_test(ctx, did, d);
    }
    if (k == decl.DECL_KIND_VAL)         { ret lower_global(ctx, did, d, false); }
    if (k == decl.DECL_KIND_VAR)         { ret lower_global(ctx, did, d, true); }
    if (k == decl.DECL_KIND_COMPTIME_IF) { ret lower_comptime_if(ctx, d); }

    if (k == decl.DECL_KIND_ERROR) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: error declaration reached the middle end"));
    }

    ret R.ok_void[fail.Fail]();
}

pub fun lower_fun(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, is_test: bool) R.Result[R.Void, fail.Fail] {
    if (d.data.fun_.generics_len > 0)   { ret R.ok_void[fail.Fail](); }
    if (fun_has_comptime_param(ctx, d)) { ret R.ok_void[fail.Fail](); }
    if (fun_has_pack_param(ctx, d))     { ret R.ok_void[fail.Fail](); }

    val res_sig: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_sig)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_sig)); }
    val sig: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_sig);

    val res_bare: R.Result[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (R.is_err[intern.StrId, fail.Fail](res_bare)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_bare)); }
    val bare: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_bare);

    val res_name: R.Result[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, fun_export_of(ctx, did));
    if (R.is_err[intern.StrId, fail.Fail](res_name)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_name)); }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_name);

    var flags: u32 = 0;
    if ((d.flags & decl.DECL_FLAG_PUB) != 0) { flags = flags | ir.FN_FLAG_PUB; }
    if ((d.flags & decl.DECL_FLAG_EXT) != 0 || d.data.fun_.body == id.STMT_NIL) {
        flags = flags | ir.FN_FLAG_EXTERN;
    }
    if (is_test)                              { flags = flags | ir.FN_FLAG_TEST; }
    if (decl_has_decorator(ctx, d, "inline")) { flags = flags | ir.FN_FLAG_INLINE; }
    if (decl_has_decorator(ctx, d, "noinline")) { flags = flags | ir.FN_FLAG_NOINLINE; }
    if (decl_has_decorator(ctx, d, "oblivious")) { flags = flags | ir.FN_FLAG_OBLIVIOUS; }
    if (decl_has_decorator(ctx, d, "scalar")) { flags = flags | ir.FN_FLAG_SCALAR; }
    if (decl_has_decorator(ctx, d, "naked")) { flags = flags | ir.FN_FLAG_NAKED; }

    val res_ret_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.function_return_ir(ctx, did);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ret_ir)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ret_ir)); }
    val ret_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ret_ir);

    val res_idx: R.Result[u32, fail.Fail] = append_function(ctx, name, sig, flags, d.data.fun_.params_len);
    if (R.is_err[u32, fail.Fail](res_idx)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_idx)); }
    val fn_index: u32 = R.unwrap_ok[u32, fail.Fail](res_idx);

    ctx.m.functions[fn_index].section = decl_section_of(ctx, d);
    ctx.m.functions[fn_index].stage = decl_stage_of(ctx, d);
    ctx.m.functions[fn_index].wg_x  = decl_workgroup_dim(ctx, d, 0);
    ctx.m.functions[fn_index].wg_y  = decl_workgroup_dim(ctx, d, 1);
    ctx.m.functions[fn_index].wg_z  = decl_workgroup_dim(ctx, d, 2);
    ctx.m.functions[fn_index].op_set =
        context.decl_target_op(ctx.scope.a, context.module_source(ctx), d, ctx.tgt.isa.defs,
                               ?ctx.m.functions[fn_index].op_code);

    ctx.m.functions[fn_index].is_import = (d.flags & decl.DECL_FLAG_EXT) != 0;

    publish_function_debug(ctx, fn_index, bare, context.decl_ret_sem(ctx, did));

    if ((flags & ir.FN_FLAG_EXTERN) != 0) { ret R.ok_void[fail.Fail](); }

    ret emit_function_body(ctx, did, d, fn_index, ret_ir, context.decl_ret_sem(ctx, did));
}

pub fun lower_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, name: intern.StrId) R.Result[R.Void, fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, context.decl_ret_sem(ctx, did));
}

pub fun lower_value_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, name: intern.StrId) R.Result[R.Void, fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, context.decl_ret_sem(ctx, did));
}

pub fun lower_pack_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl,
                            name: intern.StrId, types: *type.TypeId, type_len: u32) R.Result[R.Void, fail.Fail] {
    if (d.data.fun_.body == id.STMT_NIL) { ret R.ok_void[fail.Fail](); }

    val fixed_count: u32 = d.data.fun_.params_len - 1;

    val res_ret_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.function_return_ir(ctx, did);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ret_ir)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ret_ir)); }
    val ret_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ret_ir);

    val res_sig: R.Result[ir_type.IrTypeId, fail.Fail] = context.pack_instance_sig(ctx, d, fixed_count, types, type_len, ret_ir);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_sig)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_sig)); }
    val sig: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_sig);

    val res_bare: R.Result[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (R.is_err[intern.StrId, fail.Fail](res_bare)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_bare)); }
    val bare: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_bare);

    var flags: u32 = ir.FN_FLAG_PUB | ir.FN_FLAG_WEAK;
    if (decl_has_decorator(ctx, d, "inline")) { flags = flags | ir.FN_FLAG_INLINE; }
    if (decl_has_decorator(ctx, d, "noinline")) { flags = flags | ir.FN_FLAG_NOINLINE; }
    if (decl_has_decorator(ctx, d, "oblivious")) { flags = flags | ir.FN_FLAG_OBLIVIOUS; }
    if (decl_has_decorator(ctx, d, "scalar")) { flags = flags | ir.FN_FLAG_SCALAR; }
    if (decl_has_decorator(ctx, d, "naked")) { flags = flags | ir.FN_FLAG_NAKED; }
    val res_idx: R.Result[u32, fail.Fail] = append_function(ctx, name, sig, flags, fixed_count + type_len);
    if (R.is_err[u32, fail.Fail](res_idx)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_idx)); }
    val fn_index: u32 = R.unwrap_ok[u32, fail.Fail](res_idx);

    publish_function_debug(ctx, fn_index, bare, context.decl_ret_sem(ctx, did));

    context.begin_function(ctx, fn_index, ret_ir);

    ctx.pack_types    = types;
    ctx.pack_len      = type_len;
    ctx.pack_ret_type = context.decl_ret_sem(ctx, did);

    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_entry)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_entry))); }
    builder.set_block(?ctx.builder, R.unwrap_ok[ir.BlockId, str](res_entry));

    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, d.span.offset));

    val res_params: R.Result[R.Void, fail.Fail] = lower_pack_params(ctx, did, d, fn_index, fixed_count, types, type_len);
    if (R.is_err[R.Void, fail.Fail](res_params)) { clear_pack_state(ctx); ret res_params; }

    val res_encl: R.Result[R.Void, fail.Fail] = reinfer_instance_typing(ctx, d, ctx.pack_ret_type);
    if (R.is_err[R.Void, fail.Fail](res_encl)) { clear_pack_state(ctx); ret res_encl; }

    val res_body: R.Result[R.Void, fail.Fail] = stmt.lower_stmt(ctx, d.data.fun_.body);
    if (R.is_err[R.Void, fail.Fail](res_body)) { clear_pack_state(ctx); ret res_body; }

    val res_close: R.Result[R.Void, fail.Fail] = close_function(ctx, ret_ir);
    clear_pack_state(ctx);
    ret res_close;
}

fun reinfer_instance_typing(ctx: *context.LowerContext, d: *decl.Decl, fn_ret: type.TypeId) R.Result[R.Void, fail.Fail] {
    if (ctx.scope.subst == nil || ctx.scope.subst_len == 0) { ret R.ok_void[fail.Fail](); }

    val res_deps: R.Result[sema.SemaDeps, str] = sema.collect_module_deps(ctx.s);
    if (R.is_err[sema.SemaDeps, str](res_deps)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[sema.SemaDeps, str](res_deps)));
    }
    var deps: sema.SemaDeps = R.unwrap_ok[sema.SemaDeps, str](res_deps);

    val res: R.Result[R.Void, fail.Fail] = sema.reinfer_instance_body(ctx.s, ctx.scope.a, ctx.scope.rr, ?deps, ctx.scope.ctx,
        ctx.scope.own_module, ctx.scope.sema_result, fn_ret, d.data.fun_.body,
        ctx.scope.subst, ctx.scope.subst_len);
    sema.free_module_deps(ctx.s, ?deps);
    if (R.is_err[R.Void, fail.Fail](res)) { ret res; }
    ret R.ok_void[fail.Fail]();
}

pub fun fun_has_comptime_param(ctx: *context.LowerContext, d: *decl.Decl) bool {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_name_len && ctx.scope.a.typed_names[pool_ix].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun fun_has_pack_param(ctx: *context.LowerContext, d: *decl.Decl) bool {
    val n: u32 = d.data.fun_.params_len;
    if (n == 0) { ret false; }
    val pool_ix: u32 = d.data.fun_.params_start + (n - 1);
    if (pool_ix::usize >= ctx.scope.a.typed_name_len) { ret false; }
    val tn: *decl.TypedName = ?ctx.scope.a.typed_names[pool_ix];
    val pt: type.TypeId     = context.type_resolved_of(ctx, tn.ty);
    val opt_type: O.Option[*type.Type] = type.get(?ctx.s.types, pt);
    if (O.is_none[*type.Type](opt_type)) { ret false; }
    ret O.unwrap[*type.Type](opt_type).kind == type.TYPE_PACK;
}

pub fun lower_global(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, is_mut: bool) R.Result[R.Void, fail.Fail] {
    val res_gty: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_gty)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_gty)); }
    val gty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_gty);

    val res_bare: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, context.module_source(ctx), d.data.bind.name);
    if (R.is_err[intern.StrId, str](res_bare)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_bare))); }
    val bare: intern.StrId = R.unwrap_ok[intern.StrId, str](res_bare);

    val res_name: R.Result[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, global_export_of(ctx, did));
    if (R.is_err[intern.StrId, fail.Fail](res_name)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_name)); }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_name);

    var is_embed: bool = false;
    var init_val: value.Value = value.const_int(0, gty);
    if (decl_has_decorator(ctx, d, "embed")) {
        val er: R.Result[*embed.EmbedFile, fail.Fail] = embed_file_of(ctx, d);
        if (R.is_err[*embed.EmbedFile, fail.Fail](er)) {
            ret R.err[R.Void, fail.Fail](R.unwrap_err[*embed.EmbedFile, fail.Fail](er));
        }
        val e: *embed.EmbedFile = R.unwrap_ok[*embed.EmbedFile, fail.Fail](er);
        init_val = value.const_bytes(e.bytes, e.len, gty);
        is_embed = true;
    }
    or (d.data.bind.init != id.EXPR_NIL) {
        val res_fold: R.Result[value.Value, fail.Fail] = fold_global_init(ctx, d.data.bind.init, gty, bare);
        if (R.is_err[value.Value, fail.Fail](res_fold)) {
            val fold_err: str = R.unwrap_err[value.Value, fail.Fail](res_fold).message;
            if (is_internal_err(fold_err)) {
                val res_diag: R.Result[R.Void, fail.Fail] = diag_named(ctx, d.data.bind.name, bare,
                    "global initialiser of `", "` must be a constant expression",
                    "a global initialiser must be a constant expression");
                if (R.is_err[R.Void, fail.Fail](res_diag)) { ret res_diag; }
            }
            or {
                val res_diag2: R.Result[R.Void, str] =
                    diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, d.data.bind.name, fold_err);
                if (R.is_err[R.Void, str](res_diag2)) { ret fail.lift[R.Void](res_diag2); }
            }
        }
        or {
            init_val = R.unwrap_ok[value.Value, fail.Fail](res_fold);
        }
    }

    val res_align: R.Result[u32, fail.Fail] = global_align_of(ctx, d);
    if (R.is_err[u32, fail.Fail](res_align)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_align)); }

    if ((d.flags & decl.DECL_FLAG_EXT) != 0) {
        var gx: ir.Global;
        gx.name      = name;
        gx.ty        = gty;
        gx.init      = value.const_int(0, gty);
        gx.is_mut    = is_mut;
        gx.is_pub    = false;
        gx.is_extern = true;
        gx.is_import = true;
        gx.is_local  = false;
        gx.is_embed  = false;
        gx.align     = R.unwrap_ok[u32, fail.Fail](res_align);
        gx.section   = intern.STR_NIL;
        gx.iface     = ir.IFACE_NONE;
        gx.iface_a   = 0;
        gx.iface_b   = 0;
        gx.iface_flags = 0;
        val res_ext: R.Result[u32, fail.Fail] = append_global(ctx, gx);
        if (R.is_err[u32, fail.Fail](res_ext)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_ext)); }
        ret R.ok_void[fail.Fail]();
    }

    var g: ir.Global;
    g.name      = name;
    g.ty        = gty;
    g.init      = init_val;
    g.is_mut    = is_mut;
    g.is_pub    = (d.flags & decl.DECL_FLAG_PUB) != 0;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = false;
    g.is_embed  = is_embed;
    g.align     = R.unwrap_ok[u32, fail.Fail](res_align);
    g.section   = decl_section_of(ctx, d);
    g.iface     = ir.IFACE_NONE;
    g.iface_a   = 0;
    g.iface_b   = 0;
    g.iface_flags = 0;
    fill_iface_role(ctx, d, ?g);

    val res_idx: R.Result[u32, fail.Fail] = append_global(ctx, g);
    if (R.is_err[u32, fail.Fail](res_idx)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_idx)); }
    ret R.ok_void[fail.Fail]();
}

fun lower_weak_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, name: intern.StrId, ret_sem: type.TypeId) R.Result[R.Void, fail.Fail] {
    if (d.data.fun_.body == id.STMT_NIL) { ret R.ok_void[fail.Fail](); }

    val res_sig: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_sig)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_sig)); }
    val sig: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_sig);

    val res_ret_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.function_return_ir(ctx, did);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ret_ir)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ret_ir)); }
    val ret_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ret_ir);

    val res_bare: R.Result[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (R.is_err[intern.StrId, fail.Fail](res_bare)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_bare)); }
    val bare: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_bare);

    var flags: u32 = ir.FN_FLAG_PUB | ir.FN_FLAG_WEAK;
    if (decl_has_decorator(ctx, d, "inline")) { flags = flags | ir.FN_FLAG_INLINE; }
    if (decl_has_decorator(ctx, d, "noinline")) { flags = flags | ir.FN_FLAG_NOINLINE; }
    if (decl_has_decorator(ctx, d, "oblivious")) { flags = flags | ir.FN_FLAG_OBLIVIOUS; }
    if (decl_has_decorator(ctx, d, "scalar")) { flags = flags | ir.FN_FLAG_SCALAR; }
    if (decl_has_decorator(ctx, d, "naked")) { flags = flags | ir.FN_FLAG_NAKED; }
    val res_idx: R.Result[u32, fail.Fail] = append_function(ctx, name, sig, flags, d.data.fun_.params_len);
    if (R.is_err[u32, fail.Fail](res_idx)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_idx)); }
    val fn_index: u32 = R.unwrap_ok[u32, fail.Fail](res_idx);

    publish_function_debug(ctx, fn_index, bare, ret_sem);

    val res_ty: R.Result[R.Void, fail.Fail] = reinfer_instance_typing(ctx, d, context.decl_ret_sem(ctx, did));
    if (R.is_err[R.Void, fail.Fail](res_ty)) { ret res_ty; }

    ret emit_function_body(ctx, did, d, fn_index, ret_ir, ret_sem);
}

fun function_bare_name(ctx: *context.LowerContext, d: *decl.Decl) R.Result[intern.StrId, fail.Fail] {
    ret fail.lift[intern.StrId](intern.intern_span(?ctx.s.interner, context.module_source(ctx), d.data.fun_.name));
}

fun publish_function_debug(ctx: *context.LowerContext, fn_index: u32,
                           bare: intern.StrId, ret_sem: type.TypeId) {
    ctx.m.functions[fn_index].disp    = bare;
    ctx.m.functions[fn_index].ret_sem = ret_sem;
}

fun emit_function_body(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, fn_index: u32, ret_ir: ir_type.IrTypeId, ret_sem: type.TypeId) R.Result[R.Void, fail.Fail] {
    context.begin_function(ctx, fn_index, ret_ir);
    ctx.fn_ret_sem = ret_sem;
    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_entry)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_entry))); }
    builder.set_block(?ctx.builder, R.unwrap_ok[ir.BlockId, str](res_entry));

    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, d.span.offset));

    val res_params: R.Result[R.Void, fail.Fail] = lower_params(ctx, did, d, fn_index);
    if (R.is_err[R.Void, fail.Fail](res_params)) { ret res_params; }

    if (d.data.fun_.body != id.STMT_NIL) {
        val res_body: R.Result[R.Void, fail.Fail] = stmt.lower_stmt(ctx, d.data.fun_.body);
        if (R.is_err[R.Void, fail.Fail](res_body)) { ret res_body; }
    }

    ret close_function(ctx, ret_ir);
}

fun clear_pack_state(ctx: *context.LowerContext) {
    if (ctx.pack_slots != nil && ctx.pack_len > 0) {
        A.deallocate[value.Value](ctx.s.alloc, ctx.pack_slots, ctx.pack_len::usize);
    }
    ctx.pack_slots    = nil;
    ctx.pack_types    = nil;
    ctx.pack_len      = 0;
    ctx.pack_ret_type = type.TYPE_NIL;
}

fun lower_pack_params(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, fn_index: u32,
                      fixed_count: u32, types: *type.TypeId, type_len: u32) R.Result[R.Void, fail.Fail] {
    val res_xty: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_xty)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_xty))); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_xty);

    val total: u32 = fixed_count + type_len;
    var params: *value.Value = nil;
    if (total > 0) {
        val res_params: R.Result[*value.Value, str] = A.allocate[value.Value](ctx.s.alloc, total::usize);
        if (R.is_err[*value.Value, str](res_params)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*value.Value, str](res_params))); }
        params = R.unwrap_ok[*value.Value, str](res_params);
    }

    var slots: *value.Value = nil;
    if (type_len > 0) {
        val res_slots: R.Result[*value.Value, str] = A.allocate[value.Value](ctx.s.alloc, type_len::usize);
        if (R.is_err[*value.Value, str](res_slots)) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, total::usize); }
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*value.Value, str](res_slots)));
        }
        slots = R.unwrap_ok[*value.Value, str](res_slots);
    }

    var i: u32 = 0;
    for (i < total) {
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < ctx.scope.a.typed_name_len) {
                p_sem = context.type_resolved_of(ctx, ctx.scope.a.typed_names[pool_ix].ty);
            }
        }
        or {
            p_sem = types[i - fixed_count];
        }

        val res_slot: R.Result[value.Value, fail.Fail] = emit_pack_param(ctx, params, i, p_sem, xty);
        if (R.is_err[value.Value, fail.Fail](res_slot)) {
            free_pack_param_bufs(ctx, params, total, slots, type_len);
            ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_slot));
        }
        val slot: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_slot);

        if (i < fixed_count) {
            val sid: resolve.SymbolId = param_symbol(ctx, did, i);
            if (sid != resolve.SYMBOL_NIL) {
                val res_bind: R.Result[R.Void, fail.Fail] = context.bind_local(ctx, sid, slot, context.type_carries_secret(ctx, p_sem));
                if (R.is_err[R.Void, fail.Fail](res_bind)) {
                    free_pack_param_bufs(ctx, params, total, slots, type_len);
                    ret res_bind;
                }
            }
        }
        or {
            slots[i - fixed_count] = slot;
        }
        i = i + 1;
    }

    ctx.m.functions[fn_index].params      = params;
    ctx.m.functions[fn_index].param_count = total;
    ctx.pack_slots = slots;
    ret R.ok_void[fail.Fail]();
}

fun emit_pack_param(ctx: *context.LowerContext, params: *value.Value, w: u32, p_sem: type.TypeId, xty: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    val res_p_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, p_sem);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_p_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_p_ir)); }
    val p_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_p_ir);

    var pval: value.Value = value.param(w, p_ir);
    if (context.type_is_secret(ctx, p_sem)) { pval.secret = true; }

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, p_ir, value.const_int(1, xty));
    if (R.is_err[value.Value, str](res_slot)) { ret fail.lift[value.Value](res_slot); }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, pval, slot);
    if (R.is_err[R.Void, str](res_store)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store))); }
    if (expr.type_is_volatile_record(ctx, p_sem)) { builder.mark_last_volatile(?ctx.builder); }

    params[w] = pval;
    ret R.ok[value.Value, fail.Fail](slot);
}

fun free_pack_param_bufs(ctx: *context.LowerContext, params: *value.Value, total: u32, slots: *value.Value, type_len: u32) {
    if (params != nil && total > 0)   { A.deallocate[value.Value](ctx.s.alloc, params, total::usize); }
    if (slots != nil && type_len > 0) { A.deallocate[value.Value](ctx.s.alloc, slots, type_len::usize); }
}

fun is_internal_err(msg: str) bool {
    val p: str = "lower:";
    val n: usize = str_len(p);
    if (str_len(msg) < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (msg[i] != p[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun diag_named(ctx: *context.LowerContext, span: token.Span, name_id: intern.StrId, prefix: str, suffix: str, fallback: str) R.Result[R.Void, fail.Fail] {
    val opt_name: O.Option[str] = intern.lookup(?ctx.s.interner, name_id);
    if (O.is_none[str](opt_name)) {
        ret fail.lift[R.Void](diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, span, fallback));
    }
    val name: str = O.unwrap[str](opt_name);

    val res_msg: R.Result[str, str] = str_join(ctx.s.alloc, prefix, name, suffix);
    if (R.is_err[str, str](res_msg)) {
        ret fail.lift[R.Void](diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, span, fallback));
    }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    val res_emit: R.Result[R.Void, str] = diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, span, buf);
    A.deallocate[u8](ctx.s.alloc, buf::*u8, str_len(buf) + 1);
    ret fail.lift[R.Void](res_emit);
}


fun lower_test(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl) R.Result[R.Void, fail.Fail] {
    val res_i32: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 32);
    if (R.is_err[ir_type.IrTypeId, str](res_i32)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_i32))); }
    val ret_type: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i32);

    val res_sig: R.Result[ir_type.IrTypeId, str] = ir_type.intern_fn(?ctx.m.types, ret_type, nil, 0, false);
    if (R.is_err[ir_type.IrTypeId, str](res_sig)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_sig))); }
    val sig: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_sig);

    val res_bare: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, context.module_source(ctx), d.data.test_.label);
    if (R.is_err[intern.StrId, str](res_bare)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_bare))); }
    val bare: intern.StrId = R.unwrap_ok[intern.StrId, str](res_bare);

    val res_name: R.Result[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, O.none[intern.StrId]());
    if (R.is_err[intern.StrId, fail.Fail](res_name)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_name)); }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_name);

    if (O.is_some[u32](ir.function_lookup(ctx.m, name))) {
        ret diag_named(ctx, d.data.test_.label, bare,
            "duplicate test label ", " in this module",
            "duplicate test label in this module");
    }

    val res_idx: R.Result[u32, fail.Fail] = append_function(ctx, name, sig, ir.FN_FLAG_TEST, 0);
    if (R.is_err[u32, fail.Fail](res_idx)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_idx)); }
    val fn_index: u32 = R.unwrap_ok[u32, fail.Fail](res_idx);

    var label_span: token.Span = d.data.test_.label;
    if (label_span.len >= 2::usize) {
        label_span.offset = label_span.offset + 1::usize;
        label_span.len    = label_span.len - 2::usize;
    }
    val res_disp: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, context.module_source(ctx), label_span);
    if (R.is_err[intern.StrId, str](res_disp)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_disp))); }
    ctx.m.functions[fn_index].label = R.unwrap_ok[intern.StrId, str](res_disp);

    val opt_sf: O.Option[*source.SourceFile] = source.get(?ctx.s.sources, ctx.scope.a.file_id);
    if (O.is_some[*source.SourceFile](opt_sf)) {
        val pos: source.Position = source.position(O.unwrap[*source.SourceFile](opt_sf), d.data.test_.label.offset);
        ctx.m.functions[fn_index].line = pos.line::u32;
    }

    ret emit_test_body(ctx, d, fn_index, ret_type);
}

fun emit_test_body(ctx: *context.LowerContext, d: *decl.Decl, fn_index: u32, ret_type: ir_type.IrTypeId) R.Result[R.Void, fail.Fail] {
    context.begin_function(ctx, fn_index, ret_type);
    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_entry)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_entry))); }
    builder.set_block(?ctx.builder, R.unwrap_ok[ir.BlockId, str](res_entry));

    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, d.span.offset));

    if (d.data.test_.body != id.STMT_NIL) {
        val res_body: R.Result[R.Void, fail.Fail] = stmt.lower_stmt(ctx, d.data.test_.body);
        if (R.is_err[R.Void, fail.Fail](res_body)) { ret res_body; }
    }

    ret close_function(ctx, ret_type);
}

fun lower_params(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, fn_index: u32) R.Result[R.Void, fail.Fail] {
    val count: u32 = d.data.fun_.params_len;

    val res_ity: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?ctx.m.types);
    if (R.is_err[ir_type.IrTypeId, str](res_ity)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_ity))); }
    val ity: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_ity);

    val res_xty: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_xty)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_xty))); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_xty);

    var rt_count: u32 = 0;
    var pi: u32 = 0;
    for (pi < count) {
        val pool_ix: u32 = d.data.fun_.params_start + pi;
        if (pool_ix::usize >= ctx.scope.a.typed_name_len || !ctx.scope.a.typed_names[pool_ix].comptime) {
            rt_count = rt_count + 1;
        }
        pi = pi + 1;
    }

    var params: *value.Value = nil;
    if (rt_count > 0) {
        val res_params: R.Result[*value.Value, str] = A.allocate[value.Value](ctx.s.alloc, rt_count::usize);
        if (R.is_err[*value.Value, str](res_params)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*value.Value, str](res_params))); }
        params = R.unwrap_ok[*value.Value, str](res_params);
    }

    var w: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_name_len && ctx.scope.a.typed_names[pool_ix].comptime) {
            i = i + 1;
            cnt;
        }
        var p_ir:  ir_type.IrTypeId = ity;
        var p_sem: type.TypeId      = type.TYPE_NIL;
        if (pool_ix::usize < ctx.scope.a.typed_name_len) {
            val tn: *decl.TypedName = ?ctx.scope.a.typed_names[pool_ix];
            p_sem = context.type_resolved_of(ctx, tn.ty);
            val res_p_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, p_sem);
            if (R.is_err[ir_type.IrTypeId, fail.Fail](res_p_ir)) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_p_ir));
            }
            p_ir = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_p_ir);
        }
        var pval: value.Value = value.param(w, p_ir);
        if (context.type_is_secret(ctx, p_sem)) { pval.secret = true; }
        params[w] = pval;

        val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, p_ir, value.const_int(1, xty));
        if (R.is_err[value.Value, str](res_slot)) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_slot)));
        }
        val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);
        val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, pval, slot);
        if (R.is_err[R.Void, str](res_store)) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
            ret fail.lift[R.Void](res_store);
        }
        if (expr.type_is_volatile_record(ctx, p_sem)) { builder.mark_last_volatile(?ctx.builder); }

        val sid: resolve.SymbolId = param_symbol(ctx, did, i);
        if (sid != resolve.SYMBOL_NIL) {
            val res_bind: R.Result[R.Void, fail.Fail] = context.bind_local(ctx, sid, slot, context.type_carries_secret(ctx, p_sem));
            if (R.is_err[R.Void, fail.Fail](res_bind)) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret res_bind;
            }
        }

        if (ctx.debug && pool_ix::usize < ctx.scope.a.typed_name_len) {
            val p_sem: type.TypeId = context.type_resolved_of(ctx, ctx.scope.a.typed_names[pool_ix].ty);
            val res_dbg: R.Result[R.Void, fail.Fail] = context.emit_dbg_birth(ctx, ctx.scope.a.typed_names[pool_ix].name, p_ir, p_sem, true, pval, O.none[value.Value]());
            if (R.is_err[R.Void, fail.Fail](res_dbg)) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret res_dbg;
            }
        }

        w = w + 1;
        i = i + 1;
    }

    ctx.m.functions[fn_index].params      = params;
    ctx.m.functions[fn_index].param_count = rt_count;
    ret R.ok_void[fail.Fail]();
}

fun close_function(ctx: *context.LowerContext, ret_ir: ir_type.IrTypeId) R.Result[R.Void, fail.Fail] {
    if (!context.block_terminated(ctx) && !cursor_block_unreachable(ctx)) {
        val res_term: R.Result[R.Void, fail.Fail] = emit_default_terminator(ctx, ret_ir);
        if (R.is_err[R.Void, fail.Fail](res_term)) { ret res_term; }
    }
    ret terminate_orphan_blocks(ctx);
}

fun cursor_block_unreachable(ctx: *context.LowerContext) bool {
    if (ctx.builder.fn == nil) { ret false; }
    val fn: *ir.Function = ctx.builder.fn;
    val b: ir.BlockId = ctx.builder.block;
    if (b == ir.BLOCK_NIL)   { ret false; }
    if (b >= fn.block_count) { ret false; }
    if (b == 0)              { ret false; }
    ret fn.blocks[b].pred_count == 0;
}

fun emit_default_terminator(ctx: *context.LowerContext, ret_ir: ir_type.IrTypeId) R.Result[R.Void, fail.Fail] {
    if ((ctx.m.functions[ctx.fn_index].flags & ir.FN_FLAG_NORETURN) != 0) {
        ret fail.lift[R.Void](builder.emit_unreachable(?ctx.builder));
    }
    if (context.is_void_ir(ctx, ret_ir)) {
        ret fail.lift[R.Void](builder.emit_ret_void(?ctx.builder));
    }

    val res_zero: R.Result[value.Value, fail.Fail] = default_return_value(ctx, ret_ir);
    if (R.is_err[value.Value, fail.Fail](res_zero)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_zero));
    }
    ret fail.lift[R.Void](builder.emit_ret(?ctx.builder, R.unwrap_ok[value.Value, fail.Fail](res_zero)));
}

fun default_return_value(ctx: *context.LowerContext, ret_ir: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    if (ir_type.is_float_scalar(?ctx.m.types, ret_ir)) {
        ret R.ok[value.Value, fail.Fail](value.const_float(0.0, ret_ir));
    }
    if (!ir_type.is_aggregate(?ctx.m.types, ret_ir)) {
        ret R.ok[value.Value, fail.Fail](value.const_int(0, ret_ir));
    }

    val res_count_ty: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_count_ty)) {
        ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_count_ty)));
    }
    val count_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_count_ty);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, ret_ir, value.const_int(1, count_ty));
    if (R.is_err[value.Value, str](res_slot)) { ret fail.lift[value.Value](res_slot); }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    val res_mz: R.Result[R.Void, str] = builder.emit_memzero(?ctx.builder, slot, ret_ir);
    if (R.is_err[R.Void, str](res_mz)) {
        ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_mz)));
    }
    ret R.ok[value.Value, fail.Fail](slot);
}

fun terminate_orphan_blocks(ctx: *context.LowerContext) R.Result[R.Void, fail.Fail] {
    if (ctx.builder.fn == nil) { ret R.ok_void[fail.Fail](); }
    val fn: *ir.Function = ctx.builder.fn;
    var i: u32 = 0;
    for (i < fn.block_count) {
        if (fn.blocks[i].terminator == ir.INSTR_NIL) {
            builder.set_block(?ctx.builder, i::ir.BlockId);
            val res_unreachable: R.Result[R.Void, str] = builder.emit_unreachable(?ctx.builder);
            if (R.is_err[R.Void, str](res_unreachable)) { ret fail.lift[R.Void](res_unreachable); }
        }
        i = i + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun fold_global_init(ctx: *context.LowerContext, eid: id.ExprId, gty: ir_type.IrTypeId, name: intern.StrId) R.Result[value.Value, fail.Fail] {
    if (is_null_init(ctx, eid)) { ret R.ok[value.Value, fail.Fail](value.const_null(gty)); }

    val res_agg: R.Result[O.Option[value.Value], fail.Fail] = constagg.try_const_aggregate(ctx, eid, gty);
    if (R.is_err[O.Option[value.Value], fail.Fail](res_agg)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[O.Option[value.Value], fail.Fail](res_agg)); }
    val opt_agg: O.Option[value.Value] = R.unwrap_ok[O.Option[value.Value], fail.Fail](res_agg);
    if (O.is_some[value.Value](opt_agg)) { ret R.ok[value.Value, fail.Fail](O.unwrap[value.Value](opt_agg)); }

    val opt_ct: O.Option[comptime.CTValue] = try_comptime(ctx, eid);
    if (O.is_some[comptime.CTValue](opt_ct)) {
        val cv: comptime.CTValue = O.unwrap[comptime.CTValue](opt_ct);
        if (name != intern.STR_NIL && O.is_none[comptime.NamedConst](comptime.lookup(ctx.scope.ctx, name))) {
            val res_bind: R.Result[R.Void, str] = comptime.bind(ctx.scope.ctx, name, cv);
            if (R.is_err[R.Void, str](res_bind)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_bind))); }
        }
        ret expr.const_value_of_init(ctx, eid, cv);
    }

    val opt_init: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*aexpr.Expr](opt_init)) { ret R.err[value.Value, fail.Fail](fail.message("lower: global initialiser expression out of range")); }
    val ie: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_init);

    val opt_cast: O.Option[R.Result[value.Value, fail.Fail]] = expr.try_lower_comptime_cast(ctx, eid, ie);
    if (O.is_some[R.Result[value.Value, fail.Fail]](opt_cast)) { ret O.unwrap[R.Result[value.Value, fail.Fail]](opt_cast); }

    if (ie.kind == aexpr.EXPR_KIND_CALL) {
        val opt_intr: O.Option[R.Result[value.Value, fail.Fail]] = expr.try_lower_comptime_intrinsic(ctx, eid, ie);
        if (O.is_some[R.Result[value.Value, fail.Fail]](opt_intr)) { ret O.unwrap[R.Result[value.Value, fail.Fail]](opt_intr); }
    }

    ret R.err[value.Value, fail.Fail](fail.message("lower: a global initialiser must be a constant expression"));
}

fun is_null_init(ctx: *context.LowerContext, eid: id.ExprId) bool {
    var cur: id.ExprId = eid;
    for (true) {
        val opt_expr: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, cur);
        if (O.is_none[*aexpr.Expr](opt_expr)) { ret false; }
        val e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_expr);
        if (e.kind == aexpr.EXPR_KIND_LIT_NIL) { ret true; }
        if (e.kind != aexpr.EXPR_KIND_CAST)    { ret false; }
        cur = e.data.cast.value;
    }
    ret false;
}

fun lower_comptime_if(ctx: *context.LowerContext, d: *decl.Decl) R.Result[R.Void, fail.Fail] {
    val txt: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branch_len) {
            ret R.err[R.Void, fail.Fail](fail.message("lower: comptime branch index out of range"));
        }
        val branch: *decl.ComptimeBranch = ?ctx.scope.a.comptime_branches[branch_ix];

        var active: bool = false;
        if (branch.cond == id.EXPR_NIL) {
            active = true;
        }
        or {
            val active_r: R.Result[bool, fail.Fail] = context.gate_is_active(ctx, txt, branch.cond, comptime.GATE_SCOPE_DECL, true);
            if (R.is_err[bool, fail.Fail](active_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[bool, fail.Fail](active_r)); }
            active = R.unwrap_ok[bool, fail.Fail](active_r);
        }

        if (active) {
            var ii: u32 = 0;
            for (ii < branch.body_len) {
                val pool_ix: u32 = branch.body_start + ii;
                if (pool_ix::usize >= ctx.scope.a.decl_id_len) {
                    ret R.err[R.Void, fail.Fail](fail.message("lower: comptime decl body index out of range"));
                }
                val res_decl: R.Result[R.Void, fail.Fail] = lower_decl(ctx, ctx.scope.a.decl_ids[pool_ix]);
                if (R.is_err[R.Void, fail.Fail](res_decl)) { ret res_decl; }
                ii = ii + 1;
            }
            ret R.ok_void[fail.Fail]();
        }
        i = i + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun decl_has_decorator(ctx: *context.LowerContext, d: *decl.Decl, name: str) bool {
    val src: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?ctx.scope.a.decorators[d.decorators_start + i];
        if (str_region_equals(src, dec.name.offset, dec.name.len, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun fill_iface_role(ctx: *context.LowerContext, d: *decl.Decl, g: *ir.Global) {
    if (decl_has_decorator(ctx, d, "input")) {
        g.iface   = ir.IFACE_INPUT;
        g.iface_a = decorator_uint(ctx, d, "input", 0, 0);
        ret;
    }
    if (decl_has_decorator(ctx, d, "output")) {
        g.iface   = ir.IFACE_OUTPUT;
        g.iface_a = decorator_uint(ctx, d, "output", 0, 0);
        ret;
    }
    if (decl_has_decorator(ctx, d, "builtin")) {
        g.iface   = ir.IFACE_BUILTIN;
        g.iface_a = decl_builtin_of(ctx, d);
        ret;
    }
    if (decl_has_decorator(ctx, d, "uniform")) {
        g.iface   = ir.IFACE_UNIFORM;
        g.iface_a = decorator_uint(ctx, d, "uniform", 0, 0);
        g.iface_b = decorator_uint(ctx, d, "uniform", 1, 0);
        ret;
    }
    if (decl_has_decorator(ctx, d, "storage")) {
        g.iface   = ir.IFACE_STORAGE;
        g.iface_a = decorator_uint(ctx, d, "storage", 0, 0);
        g.iface_b = decorator_uint(ctx, d, "storage", 1, 0);
        g.iface_flags = decl_storage_flags(ctx, d);
        ret;
    }
    if (decl_has_decorator(ctx, d, "sampler")) {
        g.iface   = ir.IFACE_SAMPLER;
        g.iface_a = decorator_uint(ctx, d, "sampler", 0, 0);
        g.iface_b = decorator_uint(ctx, d, "sampler", 1, 0);
    }
}

fun decl_storage_flags(ctx: *context.LowerContext, d: *decl.Decl) u32 {
    val src: str = context.module_source(ctx);
    var flags: u32 = 0;
    var ord: u32 = 2;
    for (true) {
        val opt_arg: O.Option[id.ExprId] = decorator_arg_eid(ctx, d, "storage", ord);
        if (O.is_none[id.ExprId](opt_arg)) { ret flags; }
        val opt_val: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, O.unwrap[id.ExprId](opt_arg));
        if (O.is_none[*aexpr.Expr](opt_val)) { ret flags; }
        val ve: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_val);
        if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret flags; }
        val off: usize = ve.span.offset + 1::usize;
        val len: usize = ve.span.len - 2::usize;
        if (str_region_equals(src, off, len, "readonly")) { flags = flags | ir.IFACE_FLAG_READONLY; }
        ord = ord + 1;
    }
    ret flags;
}

fun decl_builtin_of(ctx: *context.LowerContext, d: *decl.Decl) u32 {
    val opt_arg: O.Option[id.ExprId] = decorator_arg_eid(ctx, d, "builtin", 0);
    if (O.is_none[id.ExprId](opt_arg)) { ret ir.BUILTIN_POSITION; }
    val opt_val: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, O.unwrap[id.ExprId](opt_arg));
    if (O.is_none[*aexpr.Expr](opt_val)) { ret ir.BUILTIN_POSITION; }
    val ve: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_val);
    if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret ir.BUILTIN_POSITION; }
    val src: str = context.module_source(ctx);
    val off: usize = ve.span.offset + 1::usize;
    val len: usize = ve.span.len - 2::usize;
    if (str_region_equals(src, off, len, "position"))          { ret ir.BUILTIN_POSITION; }
    if (str_region_equals(src, off, len, "vertex_index"))      { ret ir.BUILTIN_VERTEX_INDEX; }
    if (str_region_equals(src, off, len, "instance_index"))    { ret ir.BUILTIN_INSTANCE_INDEX; }
    if (str_region_equals(src, off, len, "frag_coord"))        { ret ir.BUILTIN_FRAG_COORD; }
    if (str_region_equals(src, off, len, "point_size"))        { ret ir.BUILTIN_POINT_SIZE; }
    if (str_region_equals(src, off, len, "global_invocation")) { ret ir.BUILTIN_GLOBAL_INVOCATION; }
    if (str_region_equals(src, off, len, "local_invocation"))  { ret ir.BUILTIN_LOCAL_INVOCATION; }
    if (str_region_equals(src, off, len, "workgroup_id"))      { ret ir.BUILTIN_WORKGROUP_ID; }
    ret ir.BUILTIN_POSITION;
}

fun decorator_uint(ctx: *context.LowerContext, d: *decl.Decl, name: str, ord: u32, dflt: u32) u32 {
    val opt_arg: O.Option[id.ExprId] = decorator_arg_eid(ctx, d, name, ord);
    if (O.is_none[id.ExprId](opt_arg)) { ret dflt; }
    val res_u64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_u64)) { ret dflt; }
    val u64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_u64);
    val res_fold: R.Result[value.Value, fail.Fail] = fold_global_init(ctx, O.unwrap[id.ExprId](opt_arg), u64t, intern.STR_NIL);
    if (R.is_err[value.Value, fail.Fail](res_fold)) { ret dflt; }
    val v: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_fold);
    if (v.kind != value.VAL_CONST_INT) { ret dflt; }
    if (v.data.int_lit > 0xFFFFFFFF) { ret dflt; }
    ret v.data.int_lit::u32;
}

fun decl_stage_of(ctx: *context.LowerContext, d: *decl.Decl) u8 {
    val opt_arg: O.Option[id.ExprId] = decorator_arg_eid(ctx, d, "stage", 0);
    if (O.is_none[id.ExprId](opt_arg)) { ret ir.STAGE_NONE; }
    val opt_val: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, O.unwrap[id.ExprId](opt_arg));
    if (O.is_none[*aexpr.Expr](opt_val)) { ret ir.STAGE_NONE; }
    val ve: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_val);
    if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret ir.STAGE_NONE; }
    val src: str = context.module_source(ctx);
    val off: usize = ve.span.offset + 1::usize;
    val len: usize = ve.span.len - 2::usize;
    if (str_region_equals(src, off, len, "vertex"))   { ret ir.STAGE_VERTEX; }
    if (str_region_equals(src, off, len, "fragment")) { ret ir.STAGE_FRAGMENT; }
    if (str_region_equals(src, off, len, "compute"))  { ret ir.STAGE_COMPUTE; }
    ret ir.STAGE_NONE;
}

fun decl_workgroup_dim(ctx: *context.LowerContext, d: *decl.Decl, ord: u32) u32 {
    val opt_arg: O.Option[id.ExprId] = decorator_arg_eid(ctx, d, "workgroup", ord);
    if (O.is_none[id.ExprId](opt_arg)) { ret 1; }
    val res_u64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_u64)) { ret 1; }
    val u64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_u64);
    val res_fold: R.Result[value.Value, fail.Fail] = fold_global_init(ctx, O.unwrap[id.ExprId](opt_arg), u64t, intern.STR_NIL);
    if (R.is_err[value.Value, fail.Fail](res_fold)) { ret 1; }
    val v: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_fold);
    if (v.kind != value.VAL_CONST_INT) { ret 1; }
    if (v.data.int_lit == 0 || v.data.int_lit > 0xFFFFFFFF) { ret 1; }
    ret v.data.int_lit::u32;
}

fun decl_section_of(ctx: *context.LowerContext, d: *decl.Decl) intern.StrId {
    val opt_arg: O.Option[id.ExprId] = decorator_arg_eid(ctx, d, "section", 0);
    if (O.is_none[id.ExprId](opt_arg)) { ret intern.STR_NIL; }
    val opt_val: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, O.unwrap[id.ExprId](opt_arg));
    if (O.is_none[*aexpr.Expr](opt_val)) { ret intern.STR_NIL; }
    val ve: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_val);
    if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret intern.STR_NIL; }

    var inner: token.Span = ve.span;
    inner.offset = inner.offset + 1::usize;
    inner.len    = inner.len - 2::usize;

    val res_section: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, context.module_source(ctx), inner);
    if (R.is_err[intern.StrId, str](res_section)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](res_section);
}

fun embed_file_of(ctx: *context.LowerContext, d: *decl.Decl) R.Result[*embed.EmbedFile, fail.Fail] {
    val opt_dec: O.Option[*decl.Decorator] = decorator_named(ctx, d, "embed");
    if (O.is_none[*decl.Decorator](opt_dec)) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed declaration lost its decorator before lowering"));
    }

    val opt_span: O.Option[token.Span] = embed.path_arg_span(ctx.scope.a, O.unwrap[*decl.Decorator](opt_dec));
    if (O.is_none[token.Span](opt_span)) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed declaration has a malformed path after sema"));
    }

    val opt_file: O.Option[*source.SourceFile] = source.get(?ctx.s.sources, ctx.scope.a.file_id);
    if (O.is_none[*source.SourceFile](opt_file)) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed declaration's source file is unavailable during lowering"));
    }
    val f: *source.SourceFile = O.unwrap[*source.SourceFile](opt_file);
    if (f.path == nil) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed declaration's source file has no on-disk path during lowering"));
    }

    val ir: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, context.module_source(ctx), O.unwrap[token.Span](opt_span));
    if (R.is_err[intern.StrId, str](ir)) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](ir)));
    }
    val opt_arg: O.Option[str] = intern.lookup(?ctx.s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_none[str](opt_arg)) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed path disappeared from the interner during lowering"));
    }

    val pr: R.Result[str, manifest.TemplateError] = embed.resolve_arg(ctx.s.alloc, ?ctx.s.embeds, f.path, O.unwrap[str](opt_arg));
    if (R.is_err[str, manifest.TemplateError](pr)) {
        val e: manifest.TemplateError = R.unwrap_err[str, manifest.TemplateError](pr);
        if (e.kind == fail.INTERNAL) { ret R.err[*embed.EmbedFile, fail.Fail](fail.message(e.message)); }
        manifest.template_error_dnit(ctx.s.alloc, e);
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed path became invalid after successful sema"));
    }
    val resolved: str = R.unwrap_ok[str, manifest.TemplateError](pr);

    val pid_r: R.Result[intern.StrId, str] = intern.intern(?ctx.s.interner, resolved);
    str_free(ctx.s.alloc, resolved);
    if (R.is_err[intern.StrId, str](pid_r)) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](pid_r)));
    }

    val opt_e: O.Option[*embed.EmbedFile] = embed.get(?ctx.s.embeds, R.unwrap_ok[intern.StrId, str](pid_r));
    if (O.is_none[*embed.EmbedFile](opt_e)) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed cache entry is unavailable during lowering"));
    }
    val e: *embed.EmbedFile = O.unwrap[*embed.EmbedFile](opt_e);
    if (e.status != embed.EMBED_OK) {
        ret R.err[*embed.EmbedFile, fail.Fail](fail.message("embed cache entry changed after successful sema"));
    }
    ret R.ok[*embed.EmbedFile, fail.Fail](e);
}

fun decorator_named(ctx: *context.LowerContext, d: *decl.Decl, name: str) O.Option[*decl.Decorator] {
    val src: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?ctx.scope.a.decorators[d.decorators_start + i];
        if (str_region_equals(src, dec.name.offset, dec.name.len, name)) { ret O.some[*decl.Decorator](dec); }
        i = i + 1;
    }
    ret O.none[*decl.Decorator]();
}

fun decorator_arg_eid(ctx: *context.LowerContext, d: *decl.Decl, name: str, ord: u32) O.Option[id.ExprId] {
    val src: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?ctx.scope.a.decorators[d.decorators_start + i];
        if (str_region_equals(src, dec.name.offset, dec.name.len, name)) {
            if (ord >= dec.args_len) { ret O.none[id.ExprId](); }
            ret O.some[id.ExprId](ctx.scope.a.expr_ids[dec.args_start + ord]);
        }
        i = i + 1;
    }
    ret O.none[id.ExprId]();
}

fun global_align_of(ctx: *context.LowerContext, d: *decl.Decl) R.Result[u32, fail.Fail] {
    val opt_arg: O.Option[id.ExprId] = decorator_arg_eid(ctx, d, "align", 0);
    if (O.is_none[id.ExprId](opt_arg)) { ret R.ok[u32, fail.Fail](0); }
    val arg: id.ExprId = O.unwrap[id.ExprId](opt_arg);

    val res_u64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_u64)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_u64))); }
    val u64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_u64);

    val res_fold: R.Result[value.Value, fail.Fail] = fold_global_init(ctx, arg, u64t, intern.STR_NIL);
    if (R.is_err[value.Value, fail.Fail](res_fold)) {
        val res_diag: R.Result[R.Void, str] = diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, d.data.bind.name, "`align` decorator requires a compile-time constant argument");
        if (R.is_err[R.Void, str](res_diag)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_diag))); }
        ret R.ok[u32, fail.Fail](0);
    }
    val v: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_fold);
    if (v.kind != value.VAL_CONST_INT) {
        val res_diag: R.Result[R.Void, str] = diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, d.data.bind.name, "`align` decorator requires an integer argument");
        if (R.is_err[R.Void, str](res_diag)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_diag))); }
        ret R.ok[u32, fail.Fail](0);
    }

    val n: u64 = v.data.int_lit;
    if (n == 0 || (n & (n - 1)) != 0) {
        val res_diag: R.Result[R.Void, str] = diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, d.data.bind.name, "`align` value must be a non-zero power of two");
        if (R.is_err[R.Void, str](res_diag)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_diag))); }
        ret R.ok[u32, fail.Fail](0);
    }
    if (n > 0xFFFFFFFF) {
        val res_diag: R.Result[R.Void, str] = diagnostic.error(?ctx.s.diags, ctx.scope.a.file_id, d.data.bind.name, "`align` value exceeds the maximum alignment");
        if (R.is_err[R.Void, str](res_diag)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_diag))); }
        ret R.ok[u32, fail.Fail](0);
    }
    ret R.ok[u32, fail.Fail](n::u32);
}

fun append_function(ctx: *context.LowerContext, name: intern.StrId, sig: ir_type.IrTypeId, flags: u32, param_hint: u32) R.Result[u32, fail.Fail] {
    val m: *ir.Module = ctx.m;

    val existing: O.Option[u32] = ir.function_lookup(m, name);
    if (O.is_some[u32](existing)) {
        val ei: u32 = O.unwrap[u32](existing);
        if ((m.functions[ei].flags & ir.FN_FLAG_EXTERN) != 0) {
            m.functions[ei].sig   = sig;
            m.functions[ei].flags = flags;
            ret R.ok[u32, fail.Fail](ei);
        }
    }

    if (m.function_len == m.function_cap) {
        val new_cap: u32 = m.function_cap * 2;
        val res_grow: R.Result[*ir.Function, str] = A.reallocate[ir.Function](m.alloc, m.functions, m.function_cap::usize, new_cap::usize);
        if (R.is_err[*ir.Function, str](res_grow)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[*ir.Function, str](res_grow))); }
        m.functions    = R.unwrap_ok[*ir.Function, str](res_grow);
        m.function_cap = new_cap;
    }

    val idx: u32 = m.function_len;
    m.functions[idx] = ir.function_new(m.alloc, name, sig, flags);
    m.function_len   = m.function_len + 1;
    val res_reg: R.Result[R.Void, str] = ir.function_register(m, name, idx);
    if (R.is_err[R.Void, str](res_reg)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_reg))); }
    ret R.ok[u32, fail.Fail](idx);
}

fun append_global(ctx: *context.LowerContext, g: ir.Global) R.Result[u32, fail.Fail] {
    val m: *ir.Module = ctx.m;
    if (m.global_len == m.global_cap) {
        val new_cap: u32 = m.global_cap * 2;
        val res_grow: R.Result[*ir.Global, str] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, new_cap::usize);
        if (R.is_err[*ir.Global, str](res_grow)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[*ir.Global, str](res_grow))); }
        m.globals    = R.unwrap_ok[*ir.Global, str](res_grow);
        m.global_cap = new_cap;
    }
    val idx: u32 = m.global_len;
    m.globals[idx] = g;
    m.global_len   = m.global_len + 1;
    val res_reg: R.Result[R.Void, str] = ir.global_register(m, g.name, idx);
    if (R.is_err[R.Void, str](res_reg)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_reg))); }
    ret R.ok[u32, fail.Fail](idx);
}

fun param_symbol(ctx: *context.LowerContext, fun_did: id.DeclId, index: u32) resolve.SymbolId {
    ret resolve.param_symbol(ctx.scope.rr, fun_did, index);
}

fun try_comptime(ctx: *context.LowerContext, eid: id.ExprId) O.Option[comptime.CTValue] {
    val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner,
                                     context.expr_float_width(ctx, eid));
    if (R.is_ok[comptime.CTValue, comptime.EvalFail](res_eval)) {
        ret O.some[comptime.CTValue](R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval));
    }
    ret O.none[comptime.CTValue]();
}

fun fun_export_of(ctx: *context.LowerContext, did: id.DeclId) O.Option[intern.StrId] {
    ret session.export_name(ctx.s, ctx.scope.own_module, did::u32);
}

fun global_export_of(ctx: *context.LowerContext, did: id.DeclId) O.Option[intern.StrId] {
    ret session.export_name(ctx.s, ctx.scope.own_module, did::u32);
}
