use target_model:      mach.lang.target.model;
use mach.lang.type;

pub fun lower_decl(ctx: *lower_context.LowerContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(ctx.scope.a, did);
    if (sel opt_decl.none) {
        ret err[fail.Fail].err{fail.message("lower: declaration id out of range")};
    }
    val d: *ast_decl.Decl    = opt_decl.some;
    val k: ast_decl.DeclKind = d.kind;

    # a `#[testing]` declaration is checked in every build and emitted only in the test object
    val testing:     bool = resolve.declaration_testing(ctx.scope.a, did);
    val test_object: bool = ctx.normal_object != nil;
    if (!test_object && testing)     { ret err[fail.Fail].ok{}; }
    if (k == ast_decl.DECL_KIND_FUN) { ret lower_fun(ctx, did, d); }
    if (k == ast_decl.DECL_KIND_TEST) {
        if (!test_object) { ret err[fail.Fail].ok{}; }
        ret lower_test(ctx, did, d);
    }
    if (k == ast_decl.DECL_KIND_VAL)         { ret lower_global(ctx, did, d, false); }
    if (k == ast_decl.DECL_KIND_VAR)         { ret lower_global(ctx, did, d, true); }
    if (k == ast_decl.DECL_KIND_COMPTIME_IF) { ret lower_comptime_if(ctx, d); }
    # the normal object carries the export surface
    if (k == ast_decl.DECL_KIND_FWD && !test_object) { ret lower_fwd(ctx, did); }

    if (k == ast_decl.DECL_KIND_ERROR) {
        ret err[fail.Fail].err{fail.message("lower: error declaration reached the middle end")};
    }

    ret err[fail.Fail].ok{};
}

# a `fwd` in a root-project module puts the re-exported declaration on the
# library's export surface. the object records the linkage name and the link
# exports whichever module defines it, so a re-export reaches a dependency's
# definition without that dependency knowing anything about this library
fun lower_fwd(ctx: *lower_context.LowerContext, did: ast_id.DeclId) err[fail.Fail] {
    if (!ctx.m.root_project)                                    { ret err[fail.Fail].ok{}; }
    if (ctx.scope.rr == nil || ctx.scope.rr.decl_symbol == nil) { ret err[fail.Fail].ok{}; }
    if (did::u32 >= ctx.scope.rr.decl_count)                    { ret err[fail.Fail].ok{}; }

    val sid:     resolve.SymbolId     = ctx.scope.rr.decl_symbol[ast_id.decl_index(did)];
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret err[fail.Fail].ok{}; }

    var walk:   ReexportWalk   = ReexportWalk{visited: nil, len: 0};
    val opened: err[fail.Fail] = reexport_walk_open(ctx, ?walk);
    if (sel opened.err) { ret opened; }
    fin { reexport_walk_close(ctx, ?walk); }
    val sym: *resolve.Symbol = opt_sym.some;
    ret record_reexport(ctx, fe_sema.interface.Exported{
        kind:          sym.kind, name: sym.name, canon: sym.canon, origin: sym.origin_stable, module: sym.slot_stable,
        generic_arity: sym.generic_arity, has_comptime_params: sym.has_comptime_params, has_pack_param: sym.has_pack_param
    }, ?walk, ReexportSite{did: did, direct: true});
}

# the `fwd` a re-export descends from: direct when the declaration names the
# symbol itself, and the module's whole surface otherwise
rec ReexportSite {
    did:    ast_id.DeclId;
    direct: bool;
}

# the modules a single `fwd` has already drawn names from, so a pair of modules
# re-exporting each other terminates
rec ReexportWalk {
    visited: *bool;
    len:     u32;
}

fun reexport_walk_open(ctx: *lower_context.LowerContext, walk: *ReexportWalk) err[fail.Fail] {
    val count: u32 = session.module_count(ctx.s);
    walk.len     = count;
    walk.visited = nil;
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*bool, A.Error] = A.zallocate[bool](ctx.s.alloc, count::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    walk.visited = allocated.ok;
    ret err[fail.Fail].ok{};
}

fun reexport_walk_close(ctx: *lower_context.LowerContext, walk: *ReexportWalk) {
    if (walk.visited != nil && walk.len > 0) {
        A.deallocate[bool](ctx.s.alloc, walk.visited, walk.len::usize);
    }
    walk.visited = nil;
    walk.len     = 0;
}

fun record_reexport(ctx: *lower_context.LowerContext, e: fe_sema.interface.Exported, walk: *ReexportWalk, site: ReexportSite) err[fail.Fail] {
    if (e.kind == resolve.SYM_USE) { ret record_reexport_module(ctx, session.module_id_for_stable(ctx.s, e.module), walk, site); }
    ret record_reexport_symbol(ctx, e, site);
}

# `fwd` of a module re-exports that module's whole public surface, nested module
# aliases included
fun record_reexport_module(ctx: *lower_context.LowerContext, mid: session.ModuleId, walk: *ReexportWalk, site: ReexportSite) err[fail.Fail] {
    if (module.is_nil(mid))                          { ret err[fail.Fail].ok{}; }
    if (walk.visited == nil || mid::u32 >= walk.len) { ret err[fail.Fail].ok{}; }
    if (walk.visited[mid::u32])                      { ret err[fail.Fail].ok{}; }
    walk.visited[mid::u32] = true;

    val acquired: res[*fe_sema.interface.Interface, fail.Fail] = lower_context.interface_of(ctx, mid);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val iface: *fe_sema.interface.Interface = acquired.ok;
    var i:     u32                          = 0;
    for (i < fe_sema.interface.exported_count(iface)) {
        val recorded: err[fail.Fail] = record_reexport(ctx, @fe_sema.interface.exported_at(iface, i), walk, ReexportSite{did: site.did, direct: false});
        if (sel recorded.err) { ret recorded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun record_reexport_symbol(ctx: *lower_context.LowerContext, e: fe_sema.interface.Exported, site: ReexportSite) err[fail.Fail] {
    # a type carries no linkage symbol, and a generic, comptime-parameter or pack
    # declaration has instances instead of one definition
    if (e.kind != resolve.SYM_FUN && e.kind != resolve.SYM_VAL && e.kind != resolve.SYM_VAR) {
        ret err[fail.Fail].ok{};
    }
    if (e.generic_arity > 0 || e.has_comptime_params || e.has_pack_param) {
        ret warn_reexport_has_instances(ctx, e.name, instanced_what(e.has_pack_param, e.has_comptime_params), site);
    }

    val origin: session.ModuleId                       = session.module_id_for_stable(ctx.s, e.origin);
    val found:  res[lower_context.Declared, fail.Fail] = lower_context.declared_named(ctx, origin, e.kind, e.canon);
    if (sel found.err) { ret err[fail.Fail].err{found.err}; }
    val iface: *fe_sema.interface.Interface   = found.ok.iface;
    val d:     *fe_sema.interface.Declaration = found.ok.declaration;
    if (fe_sema.interface.declaration_has_instances(iface, d)) {
        val pack: bool = (d.flags & fe_sema.interface.DECLARATION_PACK) != 0;
        ret warn_reexport_has_instances(ctx, e.name, instanced_what(pack, fe_sema.interface.declaration_has_comptime_param(iface, d)), site);
    }

    # an `ext` declaration names an import: the linked image never defines it
    if ((d.flags & fe_sema.interface.DECLARATION_EXT) != 0) { ret err[fail.Fail].ok{}; }

    val fqn:    intern.StrId                 = session.module_fqn(ctx.s, origin);
    val export: intern.StrId                 = session.export_name(ctx.s, origin, d.decl::u32);
    val named:  res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, fqn, e.canon, export);
    if (sel named.err) { ret err[fail.Fail].err{named.err}; }
    ret me_ir.export_request_add(ctx.m, named.ok);
}

fun instanced_what(pack: bool, comptime_params: bool) str {
    if (pack)            { ret "pack"; }
    if (comptime_params) { ret "comptime-parameter"; }
    ret "generic";
}

# a `fwd` that names a generic, comptime-parameter or pack declaration puts
# nothing on a shared library's surface: its instances are mangled with their
# arguments and materialized wherever they are used, so there is no one symbol
# to export. the author asked for a symbol and gets none, which is worth saying
# at the `fwd`. a `fwd` of a module asked for the module's exportable surface,
# and an executable or static library has no export surface at stake
fun warn_reexport_has_instances(ctx: *lower_context.LowerContext, symbol: intern.StrId, what: str, site: ReexportSite) err[fail.Fail] {
    if (!ctx.shared_artifact || !site.direct) { ret err[fail.Fail].ok{}; }
    val opt_d: opt[*ast_decl.Decl] = ast.get_decl(ctx.scope.a, site.did);
    if (sel opt_d.none) { ret err[fail.Fail].ok{}; }

    val opt_name: opt[str] = intern.get(?ctx.s.interner, symbol);
    var name:     str      = "";
    if (sel opt_name.some) { name = opt_name.some; }

    val msg_r: res[str, types_string.StrError] = str_join(ctx.s.alloc, "`fwd` of the ", what, " declaration `", name,
        "` exports nothing from a shared library: its instances have no single symbol; export a `pub` non-generic wrapper around the instantiation you want instead");
    if (sel msg_r.err) { ret err[fail.Fail].err{fail.str_refused(msg_r.err)}; }
    fin { str_free(ctx.s.alloc, msg_r.ok); }
    diagnostic.record(ctx.diags, diagnostic_kind.FWD_INSTANCES, ctx.scope.a.file_id, opt_d.some.span, msg_r.ok);
    ret err[fail.Fail].ok{};
}

fun lower_fun(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    if (d.data.fun_.generics_len > 0)   { ret err[fail.Fail].ok{}; }
    if (fun_has_comptime_param(ctx, d)) { ret err[fail.Fail].ok{}; }
    if (fun_has_pack_param(ctx, d))     { ret err[fail.Fail].ok{}; }

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.lower_fn_sig(ctx, did);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = res_sig.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, fun_export_of(ctx, did));
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    val own: opt[*fe_sema.interface.Declaration] = fe_sema.interface.declaration_at(ctx.scope.iface, did);
    if (sel own.none) { ret err[fail.Fail].err{fail.message("lower: a function has no declaration in its module's interface")}; }
    var op_code: u32 = 0;
    val op_set:  u32 = lower_context.declared_op(ctx, lower_context.Declared{iface: ctx.scope.iface, declaration: own.some}, ?op_code);

    var flags: u32 = 0;
    if ((d.flags & ast_decl.DECL_FLAG_PUB) != 0) { flags = flags | me_ir.FN_FLAG_PUB; }
    # an instruction on the selected target has no body there: lowering one would let
    # the optimizer inline it in place of the instruction
    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.stmt_is_nil(d.data.fun_.body) || op_set != target_definition.NO_OP_SET) {
        flags = flags | me_ir.FN_FLAG_EXTERN;
    }
    val declared: bool = lower_context.normal_defines(ctx, name);
    if (declared) { flags = flags | me_ir.FN_FLAG_EXTERN; }
    flags = flags | decorator_fn_flags(ctx, d);

    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = lower_context.function_return_ir(ctx, did);
    if (sel res_ret_ir.err) { ret err[fail.Fail].err{res_ret_ir.err}; }
    val ret_ir: ir_type.IrTypeId = res_ret_ir.ok;

    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, flags, d.data.fun_.params_len);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    val exts: res[u64, fail.Fail] = decl_extensions(ctx, d);
    if (sel exts.err) { ret err[fail.Fail].err{exts.err}; }
    ctx.m.functions[fn_index].extensions = exts.ok;
    ctx.m.functions[fn_index].section    = decl_section_of(ctx, d);
    ctx.m.functions[fn_index].stage      = decl_stage_of(ctx, d);
    ctx.m.functions[fn_index].wg_x       = decl_workgroup_dim(ctx, d, 0);
    ctx.m.functions[fn_index].wg_y       = decl_workgroup_dim(ctx, d, 1);
    ctx.m.functions[fn_index].wg_z       = decl_workgroup_dim(ctx, d, 2);
    var wi: u32 = 0;
    for (wi < 3) {
        ctx.m.functions[fn_index].wg_spec[wi] = decl_workgroup_spec(ctx, d, wi);
        wi                                    = wi + 1;
    }
    ctx.m.functions[fn_index].op_set = op_set;
    if (op_set != target_definition.NO_OP_SET) { ctx.m.functions[fn_index].op_code = op_code; }

    val res_align: res[u32, fail.Fail] = decl_align_of(ctx, d, d.data.fun_.name);
    if (sel res_align.err) { ret err[fail.Fail].err{res_align.err}; }
    ctx.m.functions[fn_index].align = res_align.ok;

    ctx.m.functions[fn_index].is_import = (d.flags & ast_decl.DECL_FLAG_EXT) != 0;

    publish_function_debug(ctx, fn_index, d, bare, lower_context.decl_ret_sem(ctx, did));

    # the normal object's definition is this module's body, which release inlining may import
    if (declared)                            { ctx.m.functions[fn_index].body_module = ctx.scope.fqn; }
    if ((flags & me_ir.FN_FLAG_EXTERN) != 0) { ret err[fail.Fail].ok{}; }

    ret emit_function_body(ctx, did, d, fn_index, ret_ir, lower_context.decl_ret_sem(ctx, did));
}

pub fun lower_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId) err[fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, lower_context.decl_ret_sem(ctx, did));
}

pub fun lower_value_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId) err[fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, lower_context.decl_ret_sem(ctx, did));
}

pub fun lower_pack_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl,
    name: intern.StrId, types: *type.TypeId, type_len: u32) err[fail.Fail] {
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    val fixed_count: u32 = d.data.fun_.params_len - 1;

    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = lower_context.function_return_ir(ctx, did);
    if (sel res_ret_ir.err) { ret err[fail.Fail].err{res_ret_ir.err}; }
    val ret_ir: ir_type.IrTypeId = res_ret_ir.ok;

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.pack_instance_sig(ctx, lower_context.decl_type_of(ctx, did), types, type_len);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = res_sig.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    if (lower_context.normal_defines(ctx, name)) { ret declare_instance(ctx, name, sig, fixed_count + type_len); }

    # weak so each instantiating module's copy coalesces; not a `pub` declaration
    var flags: u32 = me_ir.FN_FLAG_WEAK;
    flags = flags | decorator_fn_flags(ctx, d);
    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, flags, fixed_count + type_len);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32                 = res_idx.ok;
    val exts:     res[u64, fail.Fail] = decl_extensions(ctx, d);
    if (sel exts.err) { ret err[fail.Fail].err{exts.err}; }
    ctx.m.functions[fn_index].extensions = exts.ok;

    publish_function_debug(ctx, fn_index, d, bare, lower_context.decl_ret_sem(ctx, did));

    lower_context.begin_function(ctx, fn_index, ret_ir);

    ctx.pack_types    = types;
    ctx.pack_len      = type_len;
    ctx.pack_ret_type = lower_context.decl_ret_sem(ctx, did);

    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: res[me_ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_entry.err) { ret err[fail.Fail].err{res_entry.err}; }
    builder.set_block(?ctx.builder, res_entry.ok);

    builder.set_loc(?ctx.builder, ctx.m.functions[fn_index].decl_loc);

    val res_params: err[fail.Fail] = lower_pack_params(ctx, did, d, fn_index, fixed_count, types, type_len);
    if (sel res_params.err) {
        clear_pack_state(ctx);
        ret res_params;
    }

    val res_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.fun_.body);
    if (sel res_body.err) {
        clear_pack_state(ctx);
        ret res_body;
    }

    val res_close: err[fail.Fail] = close_function(ctx, ret_ir);
    clear_pack_state(ctx);
    ret res_close;
}

fun fun_has_comptime_param(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_names.len && ctx.scope.a.typed_names.data[pool_ix].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun fun_has_pack_param(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    val n: u32 = d.data.fun_.params_len;
    if (n == 0) { ret false; }
    val pool_ix: u32 = d.data.fun_.params_start + (n - 1);
    if (pool_ix::usize >= ctx.scope.a.typed_names.len) { ret false; }
    val tn:       *ast_decl.TypedName = ?ctx.scope.a.typed_names.data[pool_ix];
    val pt:       type.TypeId         = lower_context.type_resolved_of(ctx, tn.ty);
    val opt_type: opt[*type.Type]     = type.get(?ctx.s.types, pt);
    if (sel opt_type.none) { ret false; }
    ret opt_type.some.kind == type.TYPE_PACK;
}

fun lower_global(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, is_mut: bool) err[fail.Fail] {
    val res_gty: res[ir_type.IrTypeId, fail.Fail] = lower_context.lower_type(ctx, lower_context.decl_type_of(ctx, did));
    if (sel res_gty.err) { ret err[fail.Fail].err{res_gty.err}; }
    val gty: ir_type.IrTypeId = res_gty.ok;

    val res_bare: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.bind.name.offset, d.data.bind.name.len);
    if (sel res_bare.err) { ret err[fail.Fail].err{fail.refused(res_bare.err)}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, global_export_of(ctx, did));
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    # the normal object defines it: a test that reads it declares it where it does
    if (lower_context.normal_defines(ctx, name)) { ret err[fail.Fail].ok{}; }

    var is_embed: bool        = false;
    var init_val: value.Value = value.const_int(0, gty);
    if (decorator.has(ctx.scope.a, d, decorator.EMBED)) {
        val er: res[*session_embed.EmbedFile, fail.Fail] = embed_file_of(ctx, d);
        if (sel er.err) {
            ret err[fail.Fail].err{er.err};
        }
        val e:       *session_embed.EmbedFile = er.ok;
        val bytes_r: res[*u8, fail.Fail]      = copy_embed_bytes(ctx.m.alloc, e.bytes, e.len);
        if (sel bytes_r.err) { ret err[fail.Fail].err{bytes_r.err}; }
        init_val = value.const_bytes(bytes_r.ok, e.len, gty);
        is_embed = true;
    }
    or (!ast_id.expr_is_nil(d.data.bind.init)) {
        val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, d.data.bind.init, gty, bare);
        if (sel res_fold.err) {
            ret err[fail.Fail].err{res_fold.err};
        }
        init_val = res_fold.ok;
    }

    val res_align: res[u32, fail.Fail] = decl_align_of(ctx, d, d.data.bind.name);
    if (sel res_align.err) { ret err[fail.Fail].err{res_align.err}; }

    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        var gx: me_ir.Global;
        gx.name        = name;
        gx.ty          = gty;
        gx.init        = value.const_int(0, gty);
        gx.is_mut      = is_mut;
        gx.is_pub      = false;
        gx.is_extern   = true;
        gx.is_import   = true;
        gx.is_local    = false;
        gx.is_embed    = false;
        gx.align       = res_align.ok;
        gx.section     = intern.STR_NIL;
        gx.iface       = me_ir.IFACE_NONE;
        gx.iface_a     = 0;
        gx.iface_b     = 0;
        gx.iface_flags = 0;
        gx.disp        = bare;
        gx.ty_sem      = lower_context.decl_type_of(ctx, did);
        gx.decl_loc    = lang_source.location(ctx.scope.a.file_id, d.data.bind.name);
        val res_ext: res[u32, fail.Fail] = append_global(ctx, gx);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        ret err[fail.Fail].ok{};
    }

    var g: me_ir.Global;
    g.name        = name;
    g.ty          = gty;
    g.init        = init_val;
    g.is_mut      = is_mut;
    g.is_pub      = (d.flags & ast_decl.DECL_FLAG_PUB) != 0;
    g.is_extern   = false;
    g.is_import   = false;
    g.is_local    = false;
    g.is_embed    = is_embed;
    g.align       = res_align.ok;
    g.section     = decl_section_of(ctx, d);
    g.iface       = me_ir.IFACE_NONE;
    g.iface_a     = 0;
    g.iface_b     = 0;
    g.iface_flags = 0;
    g.disp        = bare;
    g.ty_sem      = lower_context.decl_type_of(ctx, did);
    g.decl_loc    = lang_source.location(ctx.scope.a.file_id, d.data.bind.name);
    fill_iface_role(ctx, d, ?g);

    val res_idx: res[u32, fail.Fail] = append_global(ctx, g);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret err[fail.Fail].ok{};
}

fun copy_embed_bytes(alloc: *A.Allocator, bytes: *u8, len: u32) res[*u8, fail.Fail] {
    if (len == 0) { ret res[*u8, fail.Fail].ok{nil}; }
    val copied: res[*u8, A.Error] = A.allocate[u8](alloc, len::usize);
    if (sel copied.err) { ret res[*u8, fail.Fail].err{fail.refused(copied.err)}; }
    val out: *u8 = copied.ok;
    var i:   u32 = 0;
    for (i < len) {
        out[i] = bytes[i];
        i      = i + 1;
    }
    ret res[*u8, fail.Fail].ok{out};
}

fun lower_weak_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId, ret_sem: type.TypeId) err[fail.Fail] {
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.lower_fn_sig(ctx, did);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = res_sig.ok;

    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = lower_context.function_return_ir(ctx, did);
    if (sel res_ret_ir.err) { ret err[fail.Fail].err{res_ret_ir.err}; }
    val ret_ir: ir_type.IrTypeId = res_ret_ir.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    if (lower_context.normal_defines(ctx, name)) { ret declare_instance(ctx, name, sig, d.data.fun_.params_len); }

    # weak so each instantiating module's copy coalesces; not a `pub` declaration
    var flags: u32 = me_ir.FN_FLAG_WEAK;
    flags = flags | decorator_fn_flags(ctx, d);
    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, flags, d.data.fun_.params_len);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32                 = res_idx.ok;
    val exts:     res[u64, fail.Fail] = decl_extensions(ctx, d);
    if (sel exts.err) { ret err[fail.Fail].err{exts.err}; }
    ctx.m.functions[fn_index].extensions = exts.ok;
    val res_align: res[u32, fail.Fail] = decl_align_of(ctx, d, d.data.fun_.name);
    if (sel res_align.err) { ret err[fail.Fail].err{res_align.err}; }
    ctx.m.functions[fn_index].align = res_align.ok;

    publish_function_debug(ctx, fn_index, d, bare, ret_sem);

    ret emit_function_body(ctx, did, d, fn_index, ret_ir, ret_sem);
}

# an instance the normal object already defines is declared in the test object, never lowered
# again. it stays weak: every instantiating module's copy is one shared definition
fun declare_instance(ctx: *lower_context.LowerContext, name: intern.StrId, sig: lower_context.FnSig, param_hint: u32) err[fail.Fail] {
    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, me_ir.FN_FLAG_WEAK | me_ir.FN_FLAG_EXTERN, param_hint);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret err[fail.Fail].ok{};
}

fun function_bare_name(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[intern.StrId, fail.Fail] {
    val r_353: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.fun_.name.offset, d.data.fun_.name.len);
    if (sel r_353.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_353.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_353.ok};
}

fun publish_function_debug(ctx: *lower_context.LowerContext, fn_index: u32, d: *ast_decl.Decl,
    bare: intern.StrId, ret_sem: type.TypeId) {
    ctx.m.functions[fn_index].disp     = bare;
    ctx.m.functions[fn_index].ret_sem  = ret_sem;
    ctx.m.functions[fn_index].decl_loc = lang_source.location(ctx.scope.a.file_id, d.data.fun_.name);
}

fun emit_function_body(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, fn_index: u32, ret_ir: ir_type.IrTypeId, ret_sem: type.TypeId) err[fail.Fail] {
    lower_context.begin_function(ctx, fn_index, ret_ir);
    ctx.fn_ret_sem = ret_sem;
    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: res[me_ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_entry.err) { ret err[fail.Fail].err{res_entry.err}; }
    builder.set_block(?ctx.builder, res_entry.ok);

    builder.set_loc(?ctx.builder, ctx.m.functions[fn_index].decl_loc);

    val res_params: err[fail.Fail] = lower_params(ctx, did, d, fn_index);
    if (sel res_params.err) { ret res_params; }

    if (!ast_id.stmt_is_nil(d.data.fun_.body)) {
        val res_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.fun_.body);
        if (sel res_body.err) { ret res_body; }
    }

    ret close_function(ctx, ret_ir);
}

fun clear_pack_state(ctx: *lower_context.LowerContext) {
    if (ctx.pack_slots != nil && ctx.pack_len > 0) {
        A.deallocate[value.Value](ctx.s.alloc, ctx.pack_slots, ctx.pack_len::usize);
    }
    ctx.pack_slots    = nil;
    ctx.pack_types    = nil;
    ctx.pack_len      = 0;
    ctx.pack_ret_type = type.TYPE_NIL;
}

fun lower_pack_params(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, fn_index: u32,
    fixed_count: u32, types: *type.TypeId, type_len: u32) err[fail.Fail] {
    val res_xty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_xty.err) { ret err[fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    val total:  u32          = fixed_count + type_len;
    var params: *value.Value = nil;
    if (total > 0) {
        val res_params: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, total::usize);
        if (sel res_params.err) { ret err[fail.Fail].err{fail.refused(res_params.err)}; }
        params = res_params.ok;
    }

    var slots: *value.Value = nil;
    if (type_len > 0) {
        val res_slots: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, type_len::usize);
        if (sel res_slots.err) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, total::usize); }
            ret err[fail.Fail].err{fail.refused(res_slots.err)};
        }
        slots = res_slots.ok;
    }

    var i: u32 = 0;
    for (i < total) {
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < ctx.scope.a.typed_names.len) {
                p_sem = lower_context.type_resolved_of(ctx, ctx.scope.a.typed_names.data[pool_ix].ty);
            }
        }
        or {
            p_sem = types[i - fixed_count];
        }

        val res_slot: res[value.Value, fail.Fail] = emit_pack_param(ctx, params, i, p_sem, xty);
        if (sel res_slot.err) {
            free_pack_param_bufs(ctx, params, total, slots, type_len);
            ret err[fail.Fail].err{res_slot.err};
        }
        val slot: value.Value = res_slot.ok;

        if (i < fixed_count) {
            val sid: resolve.SymbolId = param_symbol(ctx, did, i);
            if (!resolve.symbol_is_nil(sid)) {
                val res_bind: err[fail.Fail] = lower_context.bind_local(ctx, sid, slot, lower_context.bind_secrecy_of(ctx, p_sem));
                if (sel res_bind.err) {
                    free_pack_param_bufs(ctx, params, total, slots, type_len);
                    ret res_bind;
                }
            }
        }
        or {
            slots[i - fixed_count] = slot;
        }
        i = i + 1;
    }

    ctx.m.functions[fn_index].params      = params;
    ctx.m.functions[fn_index].param_count = total;
    ctx.pack_slots                        = slots;
    ret err[fail.Fail].ok{};
}

# the home a parameter's name binds to, always an address. an aggregate arrives as
# memory the caller copied and the callee owns for the call, so its home is the
# incoming memory itself; a parameter in a register gets a slot and an entry store
fun param_home(ctx: *lower_context.LowerContext, pval: value.Value, p_ir: ir_type.IrTypeId, p_sem: type.TypeId,
    xty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (ir_type.is_aggregate(?ctx.m.types, p_ir)) {
        val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ctx.m.types);
        if (sel res_ptr.err) { ret res[value.Value, fail.Fail].err{res_ptr.err}; }
        ret res[value.Value, fail.Fail].ok{value.retype(pval, res_ptr.ok)};
    }

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, p_ir, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, pval, slot);
    if (sel res_store.err)                              { ret res[value.Value, fail.Fail].err{res_store.err}; }
    if (lower_expr.type_is_volatile_record(ctx, p_sem)) { builder.mark_last_volatile(?ctx.builder); }
    ret res[value.Value, fail.Fail].ok{slot};
}

fun emit_pack_param(ctx: *lower_context.LowerContext, params: *value.Value, w: u32, p_sem: type.TypeId, xty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val res_p_ir: res[ir_type.IrTypeId, fail.Fail] = lower_context.lower_type(ctx, p_sem);
    if (sel res_p_ir.err) { ret res[value.Value, fail.Fail].err{res_p_ir.err}; }
    val p_ir: ir_type.IrTypeId = res_p_ir.ok;

    var pval: value.Value = value.param(w, p_ir);
    if (lower_context.type_contains_secret(ctx, p_sem)) { pval.secret = true; }

    val res_home: res[value.Value, fail.Fail] = param_home(ctx, pval, p_ir, p_sem, xty);
    if (sel res_home.err) { ret res_home; }

    params[w] = pval;
    ret res_home;
}

fun free_pack_param_bufs(ctx: *lower_context.LowerContext, params: *value.Value, total: u32, slots: *value.Value, type_len: u32) {
    if (params != nil && total > 0)   { A.deallocate[value.Value](ctx.s.alloc, params, total::usize); }
    if (slots != nil && type_len > 0) { A.deallocate[value.Value](ctx.s.alloc, slots, type_len::usize); }
}

fun diag_named(ctx: *lower_context.LowerContext, k: diagnostic_kind.Kind, span: lang_source.Span, name_id: intern.StrId, prefix: str, suffix: str, fallback: str) err[fail.Fail] {
    fail.reject(?ctx.status);
    val opt_name: opt[str] = intern.get(?ctx.s.interner, name_id);
    if (sel opt_name.none) {
        ret diagnostic.report(ctx.diags, k, ctx.scope.a.file_id, span, fallback);
    }
    val name: str = opt_name.some;

    val res_msg: res[str, types_string.StrError] = str_join(ctx.s.alloc, prefix, name, suffix);
    if (sel res_msg.err) {
        ret err[fail.Fail].err{fail.str_refused(res_msg.err)};
    }
    val buf: str = res_msg.ok;

    val res_emit: err[fail.Fail] = diagnostic.report(ctx.diags, k, ctx.scope.a.file_id, span, buf);
    A.deallocate[u8](ctx.s.alloc, buf::*u8, str_len(buf) + 1);
    ret res_emit;
}

fun lower_test(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    val res_i32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 32);
    if (sel res_i32.err) { ret err[fail.Fail].err{res_i32.err}; }
    val ret_type: ir_type.IrTypeId = res_i32.ok;

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?ctx.m.types, ret_type, nil, 0, false);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    var sig: lower_context.FnSig;
    sig.sig = res_sig.ok;
    sig.ext = ir_type.EXT_LIST_EMPTY;

    val res_ident: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.test_.name.offset, d.data.test_.name.len);
    if (sel res_ident.err) { ret err[fail.Fail].err{fail.refused(res_ident.err)}; }
    val ident: intern.StrId = res_ident.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.test_name(ctx.s, ctx.scope.fqn, ident);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    val existing: opt[u32] = me_ir.function_lookup(ctx.m, name);
    if (sel existing.some) {
        ret diag_named(ctx, diagnostic_kind.TEST_DUPLICATE, d.data.test_.name, ident,
            "duplicate test `", "` in this module",
            "duplicate test in this module");
    }

    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, me_ir.FN_FLAG_TEST, 0);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    ctx.m.functions[fn_index].decl_loc = lang_source.location(ctx.scope.a.file_id, d.data.test_.name);

    val opt_sf: opt[*lang_source.SourceFile] = lang_source.get(?ctx.s.sources, ctx.scope.a.file_id);
    if (sel opt_sf.some) {
        val pos: lang_source.Position = lang_source.position(opt_sf.some, d.data.test_.name.offset);
        ctx.m.functions[fn_index].line = pos.line::u32;
    }

    ret emit_test_body(ctx, d, fn_index, ret_type);
}

fun emit_test_body(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, fn_index: u32, ret_type: ir_type.IrTypeId) err[fail.Fail] {
    lower_context.begin_function(ctx, fn_index, ret_type);
    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: res[me_ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_entry.err) { ret err[fail.Fail].err{res_entry.err}; }
    builder.set_block(?ctx.builder, res_entry.ok);

    builder.set_loc(?ctx.builder, ctx.m.functions[fn_index].decl_loc);

    if (!ast_id.stmt_is_nil(d.data.test_.body)) {
        val res_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.test_.body);
        if (sel res_body.err) { ret res_body; }
    }

    ret close_function(ctx, ret_type);
}

fun lower_params(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, fn_index: u32) err[fail.Fail] {
    val count: u32 = d.data.fun_.params_len;

    val res_ity: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ctx.m.types);
    if (sel res_ity.err) { ret err[fail.Fail].err{res_ity.err}; }
    val ity: ir_type.IrTypeId = res_ity.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_xty.err) { ret err[fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    var rt_count: u32 = 0;
    var pi:       u32 = 0;
    for (pi < count) {
        val pool_ix: u32 = d.data.fun_.params_start + pi;
        if (pool_ix::usize >= ctx.scope.a.typed_names.len || !ctx.scope.a.typed_names.data[pool_ix].comptime) {
            rt_count = rt_count + 1;
        }
        pi = pi + 1;
    }

    var params: *value.Value = nil;
    if (rt_count > 0) {
        val res_params: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, rt_count::usize);
        if (sel res_params.err) { ret err[fail.Fail].err{fail.refused(res_params.err)}; }
        params = res_params.ok;
    }

    var w: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_names.len && ctx.scope.a.typed_names.data[pool_ix].comptime) {
            i = i + 1;
            cnt;
        }
        var p_ir:  ir_type.IrTypeId = ity;
        var p_sem: type.TypeId      = type.TYPE_NIL;
        if (pool_ix::usize < ctx.scope.a.typed_names.len) {
            val tn: *ast_decl.TypedName = ?ctx.scope.a.typed_names.data[pool_ix];
            p_sem = lower_context.type_resolved_of(ctx, tn.ty);
            val res_p_ir: res[ir_type.IrTypeId, fail.Fail] = lower_context.lower_type(ctx, p_sem);
            if (sel res_p_ir.err) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret err[fail.Fail].err{res_p_ir.err};
            }
            p_ir = res_p_ir.ok;
        }
        var pval: value.Value = value.param(w, p_ir);
        if (lower_context.type_contains_secret(ctx, p_sem)) { pval.secret = true; }
        params[w] = pval;

        val res_home: res[value.Value, fail.Fail] = param_home(ctx, pval, p_ir, p_sem, xty);
        if (sel res_home.err) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
            ret err[fail.Fail].err{res_home.err};
        }
        val slot: value.Value = res_home.ok;

        val sid: resolve.SymbolId = param_symbol(ctx, did, i);
        if (!resolve.symbol_is_nil(sid)) {
            val res_bind: err[fail.Fail] = lower_context.bind_local(ctx, sid, slot, lower_context.bind_secrecy_of(ctx, p_sem));
            if (sel res_bind.err) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret res_bind;
            }
        }

        if (ctx.debug && pool_ix::usize < ctx.scope.a.typed_names.len) {
            val p_sem:   type.TypeId    = lower_context.type_resolved_of(ctx, ctx.scope.a.typed_names.data[pool_ix].ty);
            val res_dbg: err[fail.Fail] = lower_context.emit_dbg_birth(ctx, ctx.scope.a.typed_names.data[pool_ix].name, p_ir, p_sem, true, pval, opt[value.Value].none{});
            if (sel res_dbg.err) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret res_dbg;
            }
        }

        w = w + 1;
        i = i + 1;
    }

    ctx.m.functions[fn_index].params      = params;
    ctx.m.functions[fn_index].param_count = rt_count;
    ret err[fail.Fail].ok{};
}

fun close_function(ctx: *lower_context.LowerContext, ret_ir: ir_type.IrTypeId) err[fail.Fail] {
    if (!lower_context.block_terminated(ctx) && !cursor_block_unreachable(ctx)) {
        val res_term: err[fail.Fail] = emit_default_terminator(ctx, ret_ir);
        if (sel res_term.err) { ret res_term; }
    }
    ret terminate_orphan_blocks(ctx);
}

fun cursor_block_unreachable(ctx: *lower_context.LowerContext) bool {
    if (ctx.builder.fn == nil) { ret false; }
    val fn: *me_ir.Function = ctx.builder.fn;
    val b:  me_ir.BlockId   = ctx.builder.block;
    if (ir_id.block_is_nil(b))                  { ret false; }
    if (ir_id.block_index(b) >= fn.block_count) { ret false; }
    if (ir_id.block_same(b, ir_id.block(0)))    { ret false; }
    ret fn.blocks[ir_id.block_index(b)].pred_count == 0;
}

fun emit_default_terminator(ctx: *lower_context.LowerContext, ret_ir: ir_type.IrTypeId) err[fail.Fail] {
    if ((ctx.m.functions[ctx.fn_index].flags & me_ir.FN_FLAG_NORETURN) != 0) {
        ret builder.emit_unreachable(?ctx.builder);
    }
    if (lower_context.is_void_ir(ctx, ret_ir)) {
        ret builder.emit_ret_void(?ctx.builder);
    }

    val res_zero: res[value.Value, fail.Fail] = default_return_value(ctx, ret_ir);
    if (sel res_zero.err) {
        ret err[fail.Fail].err{res_zero.err};
    }
    ret builder.emit_ret(?ctx.builder, res_zero.ok);
}

fun default_return_value(ctx: *lower_context.LowerContext, ret_ir: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (ir_type.is_float_scalar(?ctx.m.types, ret_ir)) {
        ret res[value.Value, fail.Fail].ok{value.const_float(0.0, ret_ir)};
    }
    if (!ir_type.is_aggregate(?ctx.m.types, ret_ir)) {
        ret res[value.Value, fail.Fail].ok{value.const_int(0, ret_ir)};
    }

    val res_count_ty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_count_ty.err) {
        ret res[value.Value, fail.Fail].err{res_count_ty.err};
    }
    val count_ty: ir_type.IrTypeId = res_count_ty.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, ret_ir, value.const_int(1, count_ty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, ret_ir);
    if (sel res_mz.err) {
        ret res[value.Value, fail.Fail].err{res_mz.err};
    }
    ret res[value.Value, fail.Fail].ok{slot};
}

fun terminate_orphan_blocks(ctx: *lower_context.LowerContext) err[fail.Fail] {
    if (ctx.builder.fn == nil) { ret err[fail.Fail].ok{}; }
    val fn: *me_ir.Function = ctx.builder.fn;
    var i:  u32             = 0;
    for (i < fn.block_count) {
        if (ir_id.instruction_is_nil(fn.blocks[i].terminator)) {
            builder.set_block(?ctx.builder, i::me_ir.BlockId);
            val res_unreachable: err[fail.Fail] = builder.emit_unreachable(?ctx.builder);
            if (sel res_unreachable.err) { ret res_unreachable; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the constant a global's initialiser binds, folded exactly as its lowering folds it
fun fold_global_init(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, gty: ir_type.IrTypeId, name: intern.StrId) res[value.Value, fail.Fail] {
    val folded: res[value.Value, fail.Fail] = fold_global_value(ctx, eid, gty, name);
    if (sel ctx.status.kind.internal) { ret res[value.Value, fail.Fail].err{fail.phase_failure(ctx.status)}; }
    if (sel folded.err) {
        val failure: fail.Fail = folded.err;
        if (sel failure.reported) {
            if (sel ctx.status.kind.accepted) { fail.reject(?ctx.status); }
        }
        or { fail.internal(?ctx.status, fail.describe(failure)); }
    }
    ret folded;
}

fun fold_global_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, gty: ir_type.IrTypeId, name: intern.StrId) res[value.Value, fail.Fail] {
    if (is_null_init(ctx, eid)) { ret res[value.Value, fail.Fail].ok{value.const_null(gty)}; }

    val res_agg: res[opt[value.Value], fail.Fail] = constagg.try_const_aggregate(ctx, eid, gty);
    if (sel res_agg.err) { ret res[value.Value, fail.Fail].err{res_agg.err}; }
    val opt_agg: opt[value.Value] = res_agg.ok;
    if (sel opt_agg.some) { ret res[value.Value, fail.Fail].ok{opt_agg.some}; }

    val evaluated: res[comptime.CTValue, comptime.EvalFail] = try_comptime(ctx, eid);
    if (sel evaluated.ok) {
        ret lower_expr.const_value_of_init(ctx, eid, evaluated.ok);
    }

    val eval_failure: comptime.EvalFail = evaluated.err;
    if (eval_failure.kind == comptime.EVAL_FAIL_INTERNAL) {
        ret res[value.Value, fail.Fail].err{fail.message(eval_failure.message)};
    }

    val opt_init: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel opt_init.err) { ret res[value.Value, fail.Fail].err{opt_init.err}; }
    var ie_value: ast_expr.Expr  = opt_init.ok;
    val ie:       *ast_expr.Expr = ?ie_value;

    if (ie.kind == ast_expr.EXPR_KIND_CALL) {
        val opt_intr: opt[res[value.Value, fail.Fail]] = lower_expr.try_lower_comptime_intrinsic(ctx, eid, ie);
        if (sel opt_intr.some) { ret opt_intr.some; }
    }

    if (eval_failure.kind == comptime.EVAL_FAIL_REJECTED) {
        fail.reject(?ctx.status);
        val reported: err[fail.Fail] = diagnostic.report(ctx.diags, eval_failure.diag, ctx.scope.a.file_id, ie.span, eval_failure.message);
        if (sel reported.err) { ret res[value.Value, fail.Fail].err{reported.err}; }
    }
    or (eval_failure.kind == comptime.EVAL_FAIL_UNBOUND || eval_failure.kind == comptime.EVAL_FAIL_NEEDS_MEMBER
        || eval_failure.kind == comptime.EVAL_FAIL_NEEDS_TYPES || eval_failure.kind == comptime.EVAL_FAIL_NEEDS_LAYOUT) {
        val reported: err[fail.Fail] = diag_named(ctx, diagnostic_kind.GLOBAL_INIT_NOT_CONSTANT, ie.span, name,
            "global initialiser of `", "` must be a constant expression", "a global initialiser must be a constant expression");
        if (sel reported.err) { ret res[value.Value, fail.Fail].err{reported.err}; }
    }
    or { ret res[value.Value, fail.Fail].err{fail.message("lower: invalid comptime evaluation failure kind")}; }
    ret res[value.Value, fail.Fail].err{fail.reported()};
}

fun is_null_init(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = eid;
    for (true) {
        val opt_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, cur);
        if (sel opt_expr.err) { ret false; }
        var e_value: ast_expr.Expr  = opt_expr.ok;
        val e:       *ast_expr.Expr = ?e_value;
        if (e.kind == ast_expr.EXPR_KIND_LIT_NIL) { ret true; }
        if (e.kind != ast_expr.EXPR_KIND_CAST)    { ret false; }
        cur = e.data.cast.value;
    }
    ret false;
}

fun lower_comptime_if(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) err[fail.Fail] {
    val txt: str = lower_context.module_source(ctx);
    var i:   u32 = 0;
    for (i < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branches.len) {
            ret err[fail.Fail].err{fail.message("lower: comptime branch index out of range")};
        }
        val branch: *ast_decl.ComptimeBranch = ?ctx.scope.a.comptime_branches.data[branch_ix];

        var active: bool = false;
        if (ast_id.expr_is_nil(branch.cond)) {
            active = true;
        }
        or {
            val active_r: res[bool, fail.Fail] = lower_context.gate_is_active(ctx, txt, branch.cond, comptime_gate.GATE_SCOPE_DECL, true);
            if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
            active = active_r.ok;
        }

        if (active) {
            var ii: u32 = 0;
            for (ii < branch.body_len) {
                val pool_ix: u32 = branch.body_start + ii;
                if (pool_ix::usize >= ctx.scope.a.decl_ids.len) {
                    ret err[fail.Fail].err{fail.message("lower: comptime decl body index out of range")};
                }
                val res_decl: err[fail.Fail] = lower_decl(ctx, ctx.scope.a.decl_ids.data[pool_ix]);
                if (sel res_decl.err) { ret res_decl; }
                ii = ii + 1;
            }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# the function flags a declaration's decorators set
rec FnFlagRow {
    id:   decorator.Id;
    flag: u32;
}

val FN_FLAG_ROWS_N: usize                     = 5;
val FN_FLAG_ROWS:   [FN_FLAG_ROWS_N]FnFlagRow = [FN_FLAG_ROWS_N]FnFlagRow{
    FnFlagRow{id: decorator.INLINE, flag: me_ir.FN_FLAG_INLINE},
    FnFlagRow{id: decorator.NOINLINE, flag: me_ir.FN_FLAG_NOINLINE},
    FnFlagRow{id: decorator.OBLIVIOUS, flag: me_ir.FN_FLAG_OBLIVIOUS},
    FnFlagRow{id: decorator.SCALAR, flag: me_ir.FN_FLAG_SCALAR},
    FnFlagRow{id: decorator.NAKED, flag: me_ir.FN_FLAG_NAKED},
};

fun decorator_fn_flags(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) u32 {
    var flags: u32   = 0;
    var i:     usize = 0;
    for (i < FN_FLAG_ROWS_N) {
        if (decorator.has(ctx.scope.a, d, FN_FLAG_ROWS[i].id)) { flags = flags | FN_FLAG_ROWS[i].flag; }
        i = i + 1;
    }
    ret flags;
}

fun fill_iface_role(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, g: *me_ir.Global) {
    if (decorator.has(ctx.scope.a, d, decorator.INPUT)) {
        g.iface   = me_ir.IFACE_INPUT;
        g.iface_a = decorator_uint(ctx, d, decorator.INPUT, 0, 0);
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.OUTPUT)) {
        g.iface   = me_ir.IFACE_OUTPUT;
        g.iface_a = decorator_uint(ctx, d, decorator.OUTPUT, 0, 0);
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.BUILTIN)) {
        g.iface   = me_ir.IFACE_BUILTIN;
        g.iface_a = decl_builtin_of(ctx, d);
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.UNIFORM)) {
        g.iface   = me_ir.IFACE_UNIFORM;
        g.iface_a = decorator_uint(ctx, d, decorator.UNIFORM, 0, 0);
        g.iface_b = decorator_uint(ctx, d, decorator.UNIFORM, 1, 0);
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.STORAGE)) {
        g.iface       = me_ir.IFACE_STORAGE;
        g.iface_a     = decorator_uint(ctx, d, decorator.STORAGE, 0, 0);
        g.iface_b     = decorator_uint(ctx, d, decorator.STORAGE, 1, 0);
        g.iface_flags = decl_storage_flags(ctx, d);
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.PUSH)) {
        g.iface       = me_ir.IFACE_PUSH;
        g.iface_flags = me_ir.IFACE_FLAG_READONLY;
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.SAMPLER)) {
        g.iface   = me_ir.IFACE_SAMPLER;
        g.iface_a = decorator_uint(ctx, d, decorator.SAMPLER, 0, 0);
        g.iface_b = decorator_uint(ctx, d, decorator.SAMPLER, 1, 0);
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.SPEC)) {
        g.iface       = me_ir.IFACE_SPEC;
        g.iface_a     = decorator_uint(ctx, d, decorator.SPEC, 0, 0);
        g.iface_flags = me_ir.IFACE_FLAG_READONLY;
        ret;
    }
    if (decorator.has(ctx.scope.a, d, decorator.SHARED)) { g.iface = me_ir.IFACE_SHARED; }
}

fun decl_storage_flags(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) u32 {
    val dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.STORAGE);
    if (sel dec.none) { ret 0; }
    var flags: u32 = 0;
    var ord:   u32 = 2;
    for (ord < dec.some.args_len) {
        val qual: opt[str] = decorator.string_of(?ctx.s.interner, ctx.scope.ctx, ctx.scope.a, dec.some, ord);
        if (sel qual.some) { flags = flags | storage_qual_flag(qual.some); }
        ord = ord + 1;
    }
    ret flags;
}

fun storage_qual_flag(q: str) u32 {
    if (str_equals(q, "readonly"))  { ret me_ir.IFACE_FLAG_READONLY; }
    if (str_equals(q, "writeonly")) { ret me_ir.IFACE_FLAG_WRITEONLY; }
    if (str_equals(q, "coherent"))  { ret me_ir.IFACE_FLAG_COHERENT; }
    ret 0;
}

fun decl_builtin_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) u32 {
    val v: opt[str] = decorator_string(ctx, d, decorator.BUILTIN, 0);
    if (sel v.none) { ret me_ir.BUILTIN_POSITION; }
    val b: str = v.some;
    if (str_equals(b, "position"))               { ret me_ir.BUILTIN_POSITION; }
    if (str_equals(b, "vertex_index"))           { ret me_ir.BUILTIN_VERTEX_INDEX; }
    if (str_equals(b, "instance_index"))         { ret me_ir.BUILTIN_INSTANCE_INDEX; }
    if (str_equals(b, "frag_coord"))             { ret me_ir.BUILTIN_FRAG_COORD; }
    if (str_equals(b, "point_size"))             { ret me_ir.BUILTIN_POINT_SIZE; }
    if (str_equals(b, "global_invocation"))      { ret me_ir.BUILTIN_GLOBAL_INVOCATION; }
    if (str_equals(b, "local_invocation"))       { ret me_ir.BUILTIN_LOCAL_INVOCATION; }
    if (str_equals(b, "workgroup_id"))           { ret me_ir.BUILTIN_WORKGROUP_ID; }
    if (str_equals(b, "num_workgroups"))         { ret me_ir.BUILTIN_NUM_WORKGROUPS; }
    if (str_equals(b, "local_invocation_index")) { ret me_ir.BUILTIN_LOCAL_INVOCATION_INDEX; }
    if (str_equals(b, "subgroup_size"))          { ret me_ir.BUILTIN_SUBGROUP_SIZE; }
    if (str_equals(b, "subgroup_invocation"))    { ret me_ir.BUILTIN_SUBGROUP_INVOCATION; }
    if (str_equals(b, "subgroup_id"))            { ret me_ir.BUILTIN_SUBGROUP_ID; }
    if (str_equals(b, "num_subgroups"))          { ret me_ir.BUILTIN_NUM_SUBGROUPS; }
    ret me_ir.BUILTIN_POSITION;
}

# the string argument `ord` of the declaration's decorator `id` evaluated to
fun decorator_string(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, id: decorator.Id, ord: u32) opt[str] {
    val dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, id);
    if (sel dec.none) { ret opt[str].none{}; }
    ret decorator.string_of(?ctx.s.interner, ctx.scope.ctx, ctx.scope.a, dec.some, ord);
}

fun decorator_uint(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, id: decorator.Id, ord: u32, dflt: u32) u32 {
    val opt_arg: opt[ast_id.ExprId] = decorator_arg_eid(ctx, d, id, ord);
    if (sel opt_arg.none) { ret dflt; }
    val res_u64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret dflt; }
    val u64t:     ir_type.IrTypeId            = res_u64.ok;
    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, opt_arg.some, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret dflt; }
    val v: value.Value = res_fold.ok;
    if (v.kind != value.VAL_CONST_INT) { ret dflt; }
    if (v.data.int_lit > 0xFFFFFFFF)   { ret dflt; }
    ret v.data.int_lit::u32;
}

fun decl_stage_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) u8 {
    val v: opt[str] = decorator_string(ctx, d, decorator.STAGE, 0);
    if (sel v.none)                     { ret me_ir.STAGE_NONE; }
    if (str_equals(v.some, "vertex"))   { ret me_ir.STAGE_VERTEX; }
    if (str_equals(v.some, "fragment")) { ret me_ir.STAGE_FRAGMENT; }
    if (str_equals(v.some, "compute"))  { ret me_ir.STAGE_COMPUTE; }
    ret me_ir.STAGE_NONE;
}

fun decl_workgroup_dim(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, ord: u32) u32 {
    val opt_arg: opt[ast_id.ExprId] = decorator_arg_eid(ctx, d, decorator.WORKGROUP, ord);
    if (sel opt_arg.none)                                     { ret 1; }
    if (!intern.str_is_nil(decl_workgroup_spec(ctx, d, ord))) { ret spec_default(ctx, opt_arg.some); }
    val res_u64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret 1; }
    val u64t:     ir_type.IrTypeId            = res_u64.ok;
    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, opt_arg.some, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret 1; }
    val v: value.Value = res_fold.ok;
    if (v.kind != value.VAL_CONST_INT)                      { ret 1; }
    if (v.data.int_lit == 0 || v.data.int_lit > 0xFFFFFFFF) { ret 1; }
    ret v.data.int_lit::u32;
}

# the default the `#[spec]` var `arg` names declares, which sizes the workgroup until the host
# supplies another; read from its declaration, since a var binds no constant
fun spec_default(ctx: *lower_context.LowerContext, arg: ast_id.ExprId) u32 {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, lower_context.expr_symbol_of(ctx, arg));
    if (sel opt_sym.none) { ret 1; }
    val found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, opt_sym.some);
    if (sel found.err) { ret 1; }
    val d: *fe_sema.interface.Declaration = found.ok.declaration;
    if (d.kind != resolve.SYM_VAR || d.value == fe_sema.interface.NONE) { ret 1; }
    val v: res[comptime.CTValue, comptime.EvalFail] = comptime_deep.value(?found.ok.iface.values, ?ctx.s.interner, d.value);
    if (!sel v.ok) { ret 1; }
    val n: opt[u64] = comptime.ct_int_u64(v.ok);
    if (!sel n.some)                        { ret 1; }
    if (n.some == 0 || n.some > 0xFFFFFFFF) { ret 1; }
    ret n.some::u32;
}

# the linkage name of the module `var` a workgroup dimension names, nil for a constant
# dimension. sema admits only a `#[spec]` var there, and the back end holds it to that
fun decl_workgroup_spec(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, ord: u32) intern.StrId {
    val opt_arg: opt[ast_id.ExprId] = decorator_arg_eid(ctx, d, decorator.WORKGROUP, ord);
    if (sel opt_arg.none) { ret intern.STR_NIL; }
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, lower_context.expr_symbol_of(ctx, opt_arg.some));
    if (sel opt_sym.none) { ret intern.STR_NIL; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAR && !(sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_VAR)) {
        ret intern.STR_NIL;
    }
    val name: intern.StrId = lower_expr.symbol_linkage_name(ctx, opt_arg.some);
    if (intern.str_is_nil(name)) { ret intern.STR_NIL; }
    ret name;
}

fun decl_section_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) intern.StrId {
    val dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.SECTION);
    if (sel dec.none) { ret intern.STR_NIL; }
    ret decorator.string_id(ctx.scope.ctx, ctx.scope.a, dec.some, 0);
}

fun embed_file_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[*session_embed.EmbedFile, fail.Fail] {
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.EMBED);
    if (sel opt_dec.none) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed declaration lost its decorator before lowering")};
    }

    if (opt_dec.some.args_len == 0) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed declaration has a malformed path after sema")};
    }
    val file: intern.StrId = comptime.decorator_embed_file(ctx.scope.ctx, ctx.scope.a.expr_ids.data[opt_dec.some.args_start]);
    if (intern.str_is_nil(file)) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed path became invalid after successful sema")};
    }

    val opt_e: opt[*session_embed.EmbedFile] = session_embed.get(?ctx.s.embeds, file);
    if (sel opt_e.none) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry is unavailable during lowering")};
    }
    val e: *session_embed.EmbedFile = opt_e.some;
    if (e.status != session_embed.EMBED_OK) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry changed after successful sema")};
    }
    ret res[*session_embed.EmbedFile, fail.Fail].ok{e};
}

# the extensions a function's `#[extensions(...)]` admits in its body, as bits of
# the target isa's vocabulary closed over what they imply; a name only another
# isa declares admits nothing here, and one only a target selects is refused
fun decl_extensions(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[u64, fail.Fail] {
    val found: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.EXTENSIONS);
    if (sel found.none) { ret res[u64, fail.Fail].ok{0}; }
    val dec:  *ast_decl.Decorator = found.some;
    val src:  str                 = lower_context.module_source(ctx);
    var bits: u64                 = 0;
    var i:    u32                 = 0;
    for (i < dec.args_len) {
        val e_opt: opt[*ast_expr.Expr] = ast.get_expr(ctx.scope.a, ctx.scope.a.expr_ids.data[dec.args_start + i]);
        val bare:  res[u64, fail.Fail] = res[u64, fail.Fail].err{fail.message("`extensions` decorator arguments are bare extension names")};
        if (!sel e_opt.some) { ret bare; }
        val e: *ast_expr.Expr = e_opt.some;
        if (e.kind != ast_expr.EXPR_KIND_IDENT) { ret bare; }
        val span:  lang_source.Span                = e.data.ident.tok;
        val name:  str                             = (src::usize + span.offset::usize)::str;
        val found: target_model.DecoratorExtension = target_model.decorator_extension(?ctx.tgt.vocabulary, target_model.extension_view(?ctx.tgt.model), name, span.len::usize);
        if (!found.known) {
            ret res[u64, fail.Fail].err{fail.message("`extensions` decorator names an extension no instruction set declares")};
        }
        if (found.target_only != nil) {
            ret res[u64, fail.Fail].err{fail.message("`extensions` decorator names an extension only a target selects")};
        }
        bits = bits | found.bit;
        i    = i + 1;
    }
    ret res[u64, fail.Fail].ok{target_model.extension_close(?ctx.tgt.model, bits)};
}

fun decorator_arg_eid(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, id: decorator.Id, ord: u32) opt[ast_id.ExprId] {
    val dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, id);
    if (sel dec.none) { ret opt[ast_id.ExprId].none{}; }
    val found: *ast_decl.Decorator = dec.some;
    if (ord >= found.args_len) { ret opt[ast_id.ExprId].none{}; }
    ret opt[ast_id.ExprId].some{ctx.scope.a.expr_ids.data[found.args_start + ord]};
}

# the value of a declaration's `#[align]`, 0 without one; a refusal is located
# at `at`, the declaration's name
fun decl_align_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, at: lang_source.Span) res[u32, fail.Fail] {
    val opt_arg: opt[ast_id.ExprId] = decorator_arg_eid(ctx, d, decorator.ALIGN, 0);
    if (sel opt_arg.none) { ret res[u32, fail.Fail].ok{0}; }
    val arg: ast_id.ExprId = opt_arg.some;

    val res_u64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret res[u32, fail.Fail].err{res_u64.err}; }
    val u64t: ir_type.IrTypeId = res_u64.ok;

    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, arg, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret res[u32, fail.Fail].err{res_fold.err}; }
    val v: value.Value = res_fold.ok;
    if (v.kind != value.VAL_CONST_INT) {
        fail.reject(?ctx.status);
        val res_diag: err[fail.Fail] = diagnostic.report(ctx.diags, diagnostic_kind.DECORATOR_ALIGN, ctx.scope.a.file_id, at, "`align` decorator requires an integer argument");
        if (sel res_diag.err) { ret res[u32, fail.Fail].err{res_diag.err}; }
        ret res[u32, fail.Fail].err{fail.reported()};
    }

    val n: u64 = v.data.int_lit;
    if (n == 0 || (n & (n - 1)) != 0) {
        fail.reject(?ctx.status);
        val res_diag: err[fail.Fail] = diagnostic.report(ctx.diags, diagnostic_kind.DECORATOR_ALIGN, ctx.scope.a.file_id, at, "`align` value must be a non-zero power of two");
        if (sel res_diag.err) { ret res[u32, fail.Fail].err{res_diag.err}; }
        ret res[u32, fail.Fail].err{fail.reported()};
    }
    if (n > 0xFFFFFFFF) {
        fail.reject(?ctx.status);
        val res_diag: err[fail.Fail] = diagnostic.report(ctx.diags, diagnostic_kind.DECORATOR_ALIGN, ctx.scope.a.file_id, at, "`align` value exceeds the maximum alignment");
        if (sel res_diag.err) { ret res[u32, fail.Fail].err{res_diag.err}; }
        ret res[u32, fail.Fail].err{fail.reported()};
    }
    ret res[u32, fail.Fail].ok{n::u32};
}

fun append_function(ctx: *lower_context.LowerContext, name: intern.StrId, sig: lower_context.FnSig, flags: u32, param_hint: u32) res[u32, fail.Fail] {
    val m: *me_ir.Module = ctx.m;

    val existing: opt[u32] = me_ir.function_lookup(m, name);
    if (sel existing.some) {
        val ei: u32 = existing.some;
        if ((m.functions[ei].flags & me_ir.FN_FLAG_EXTERN) != 0) {
            m.functions[ei].sig       = sig.sig;
            m.functions[ei].param_ext = sig.ext;
            m.functions[ei].flags     = flags;
            ret res[u32, fail.Fail].ok{ei};
        }
    }

    val grown: err[A.Error] = growth.reserve[me_ir.Function](m.alloc, ?m.functions, ?m.function_cap, m.function_len::usize + 1);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }

    val idx: u32 = m.function_len;
    m.functions[idx]           = me_ir.function_new(m.alloc, name, sig.sig, flags);
    m.functions[idx].param_ext = sig.ext;
    m.function_len             = m.function_len + 1;
    val res_reg: err[fail.Fail] = me_ir.function_register(m, name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }
    ret res[u32, fail.Fail].ok{idx};
}

fun append_global(ctx: *lower_context.LowerContext, g: me_ir.Global) res[u32, fail.Fail] {
    val m:     *me_ir.Module       = ctx.m;
    val added: res[u32, fail.Fail] = me_ir.global_add(m, g);
    if (sel added.err) { ret added; }
    val idx:     u32            = added.ok;
    val res_reg: err[fail.Fail] = me_ir.global_register(m, g.name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }
    ret res[u32, fail.Fail].ok{idx};
}

fun param_symbol(ctx: *lower_context.LowerContext, fun_did: ast_id.DeclId, index: u32) resolve.SymbolId {
    ret resolve.param_symbol(ctx.scope.rr, fun_did, index);
}

fun try_comptime(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[comptime.CTValue, comptime.EvalFail] {
    val r_1162: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        lower_context.module_source(ctx), eid, ?ctx.s.interner, lower_context.expr_float_width(ctx, eid));
    if (sel r_1162.err) { ret res[comptime.CTValue, comptime.EvalFail].err{r_1162.err}; }
    ret res[comptime.CTValue, comptime.EvalFail].ok{r_1162.ok};
}

fun fun_export_of(ctx: *lower_context.LowerContext, did: ast_id.DeclId) intern.StrId {
    val r_1166: intern.StrId = session.export_name(ctx.s, ctx.scope.own_module, did::u32);
    if (!intern.str_is_nil(r_1166)) { ret r_1166; }
    ret intern.STR_NIL;
}

fun global_export_of(ctx: *lower_context.LowerContext, did: ast_id.DeclId) intern.StrId {
    val r_1170: intern.StrId = session.export_name(ctx.s, ctx.scope.own_module, did::u32);
    if (!intern.str_is_nil(r_1170)) { ret r_1170; }
    ret intern.STR_NIL;
}
