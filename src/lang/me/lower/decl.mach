pub fun lower_decl(ctx: *lower_context.LowerContext, did: ast_id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(ctx.scope.a, did);
    if (sel opt_decl.none) {
        ret err[fail.Fail].err{fail.message("lower: declaration id out of range")};
    }
    val d: *ast_decl.Decl    = opt_decl.some;
    val k: ast_decl.DeclKind = d.kind;
    if (stack.exhausted()) { ret err[fail.Fail].err{lower_context.refuse_nesting(ctx, d.span)}; }

    # a `#[testing]` declaration is checked in every build and emitted only in the test object
    val testing:     bool = resolve.declaration_testing(ctx.scope.a, did);
    val test_object: bool = ctx.normal_object != nil;
    if (!test_object && testing)     { ret err[fail.Fail].ok{}; }
    if (k == ast_decl.DECL_KIND_FUN) { ret lower_fun(ctx, did, d); }
    if (k == ast_decl.DECL_KIND_TEST) {
        if (!test_object) { ret err[fail.Fail].ok{}; }
        ret lower_test(ctx, did, d);
    }
    if (k == ast_decl.DECL_KIND_VAL)         { ret lower_global(ctx, did, d, false); }
    if (k == ast_decl.DECL_KIND_VAR)         { ret lower_global(ctx, did, d, true); }
    if (k == ast_decl.DECL_KIND_COMPTIME_IF) { ret lower_comptime_if(ctx, d); }
    # the normal object carries the export surface
    if (k == ast_decl.DECL_KIND_FWD && !test_object) { ret lower_fwd(ctx, did); }

    if (k == ast_decl.DECL_KIND_ERROR) {
        ret err[fail.Fail].err{fail.message("lower: error declaration reached the middle end")};
    }

    ret err[fail.Fail].ok{};
}

# a `fwd` in a root-project module puts the re-exported declaration on the
# library's export surface. the object records the linkage name and the link
# exports whichever module defines it, so a re-export reaches a dependency's
# definition without that dependency knowing anything about this library
fun lower_fwd(ctx: *lower_context.LowerContext, did: ast_id.DeclId) err[fail.Fail] {
    if (!ctx.unit.root_project)                                 { ret err[fail.Fail].ok{}; }
    if (ctx.scope.rr == nil || ctx.scope.rr.decl_symbol == nil) { ret err[fail.Fail].ok{}; }
    if (did::u32 >= ctx.scope.rr.decl_count)                    { ret err[fail.Fail].ok{}; }

    val sid:     resolve.SymbolId     = ctx.scope.rr.decl_symbol[ast_id.decl_index(did)];
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret err[fail.Fail].ok{}; }

    var walk:   ReexportWalk   = ReexportWalk{visited: nil, len: 0};
    val opened: err[fail.Fail] = reexport_walk_open(ctx, ?walk);
    if (sel opened.err) { ret opened; }
    fin { reexport_walk_close(ctx, ?walk); }
    val sym: *resolve.Symbol = opt_sym.some;
    ret record_reexport(ctx, fe_sema.interface.Exported{
        kind:          sym.kind, name: sym.name, canon: sym.canon, origin: sym.origin, module: resolve.use_stable(sym),
        generic_arity: sym.generic_arity, has_comptime_params: sym.has_comptime_params, has_pack_param: sym.has_pack_param
    }, ?walk, ReexportSite{did: did, direct: true});
}

# the `fwd` a re-export descends from: direct when the declaration names the
# symbol itself, and the module's whole surface otherwise
rec ReexportSite {
    did:    ast_id.DeclId;
    direct: bool;
}

# the modules a single `fwd` has already drawn names from, so a pair of modules
# re-exporting each other terminates
rec ReexportWalk {
    visited: *bool;
    len:     u32;
}

fun reexport_walk_open(ctx: *lower_context.LowerContext, walk: *ReexportWalk) err[fail.Fail] {
    val count: u32 = session.module_count(ctx.s);
    walk.len     = count;
    walk.visited = nil;
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val allocated: res[*bool, A.Error] = A.zallocate[bool](ctx.s.alloc, count::usize);
    if (sel allocated.err) { ret err[fail.Fail].err{fail.refused(allocated.err)}; }
    walk.visited = allocated.ok;
    ret err[fail.Fail].ok{};
}

fun reexport_walk_close(ctx: *lower_context.LowerContext, walk: *ReexportWalk) {
    if (walk.visited != nil && walk.len > 0) {
        A.deallocate[bool](ctx.s.alloc, walk.visited, walk.len::usize);
    }
    walk.visited = nil;
    walk.len     = 0;
}

fun record_reexport(ctx: *lower_context.LowerContext, e: fe_sema.interface.Exported, walk: *ReexportWalk, site: ReexportSite) err[fail.Fail] {
    if (e.kind == resolve.SYM_USE) { ret record_reexport_module(ctx, session.module_id_for_stable(ctx.s, e.module), walk, site); }
    ret record_reexport_symbol(ctx, e, site);
}

# `fwd` of a module re-exports that module's whole public surface, nested module
# aliases included
fun record_reexport_module(ctx: *lower_context.LowerContext, mid: session.ModuleId, walk: *ReexportWalk, site: ReexportSite) err[fail.Fail] {
    if (module.is_nil(mid))                          { ret err[fail.Fail].ok{}; }
    if (walk.visited == nil || mid::u32 >= walk.len) { ret err[fail.Fail].ok{}; }
    if (walk.visited[mid::u32])                      { ret err[fail.Fail].ok{}; }
    walk.visited[mid::u32] = true;

    val acquired: res[*fe_sema.interface.Interface, fail.Fail] = lower_context.interface_of(ctx, mid);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val iface: *fe_sema.interface.Interface = acquired.ok;
    var i:     u32                          = 0;
    for (i < fe_sema.interface.exported_count(iface)) {
        val recorded: err[fail.Fail] = record_reexport(ctx, @fe_sema.interface.exported_at(iface, i), walk, ReexportSite{did: site.did, direct: false});
        if (sel recorded.err) { ret recorded; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun record_reexport_symbol(ctx: *lower_context.LowerContext, e: fe_sema.interface.Exported, site: ReexportSite) err[fail.Fail] {
    # a type carries no linkage symbol, and a generic, comptime-parameter or pack
    # declaration has instances instead of one definition
    if (e.kind != resolve.SYM_FUN && e.kind != resolve.SYM_VAL && e.kind != resolve.SYM_VAR) {
        ret err[fail.Fail].ok{};
    }
    if (e.generic_arity > 0 || e.has_comptime_params || e.has_pack_param) {
        ret warn_reexport_has_instances(ctx, e.name, instanced_what(e.has_pack_param, e.has_comptime_params), site);
    }

    val origin: session.ModuleId                       = session.module_id_for_stable(ctx.s, e.origin);
    val found:  res[lower_context.Declared, fail.Fail] = lower_context.declared_named(ctx, origin, e.kind, e.canon);
    if (sel found.err) { ret err[fail.Fail].err{found.err}; }
    val iface: *fe_sema.interface.Interface   = found.ok.iface;
    val d:     *fe_sema.interface.Declaration = found.ok.declaration;
    if (fe_sema.interface.declaration_has_instances(iface, d)) {
        val pack: bool = (d.flags & fe_sema.interface.DECLARATION_PACK) != 0;
        ret warn_reexport_has_instances(ctx, e.name, instanced_what(pack, fe_sema.interface.declaration_has_comptime_param(iface, d)), site);
    }

    # an `ext` declaration names an import: the linked image never defines it
    if ((d.flags & fe_sema.interface.DECLARATION_EXT) != 0) { ret err[fail.Fail].ok{}; }

    val fqn:    intern.StrId                 = session.module_fqn(ctx.s, origin);
    val export: intern.StrId                 = linkage.export_name(ctx.linkage, origin, d.decl::u32);
    val named:  res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, fqn, e.canon, export);
    if (sel named.err) { ret err[fail.Fail].err{named.err}; }
    ret lower_context.export_add(ctx, named.ok);
}

fun instanced_what(pack: bool, comptime_params: bool) str {
    if (pack)            { ret "pack"; }
    if (comptime_params) { ret "comptime-parameter"; }
    ret "generic";
}

# a `fwd` that names a generic, comptime-parameter or pack declaration puts
# nothing on a shared library's surface: its instances are mangled with their
# arguments and materialized wherever they are used, so there is no one symbol
# to export. the author asked for a symbol and gets none, which is worth saying
# at the `fwd`. a `fwd` of a module asked for the module's exportable surface,
# and an executable or static library has no export surface at stake
fun warn_reexport_has_instances(ctx: *lower_context.LowerContext, symbol: intern.StrId, what: str, site: ReexportSite) err[fail.Fail] {
    if (!ctx.shared_artifact || !site.direct) { ret err[fail.Fail].ok{}; }
    val opt_d: opt[*ast_decl.Decl] = ast.get_decl(ctx.scope.a, site.did);
    if (sel opt_d.none) { ret err[fail.Fail].ok{}; }

    val opt_name: opt[str] = intern.get(?ctx.s.interner, symbol);
    var name:     str      = "";
    if (sel opt_name.some) { name = opt_name.some; }

    val msg_r: res[str, types_string.StrError] = str_join(ctx.s.alloc, "`fwd` of the ", what, " declaration `", name,
        "` exports nothing from a shared library: its instances have no single symbol; export a `pub` non-generic wrapper around the instantiation you want instead");
    if (sel msg_r.err) { ret err[fail.Fail].err{fail.str_refused(msg_r.err)}; }
    fin { str_free(ctx.s.alloc, msg_r.ok); }
    diagnostic.record(ctx.diags, diagnostic_kind.FWD_INSTANCES, ctx.scope.a.file_id, opt_d.some.span, msg_r.ok);
    ret err[fail.Fail].ok{};
}

# how far a definition of this module is seen: every module of the image may call it, and
# a `pub` one of the root project is the library's surface
fun defined_linkage(ctx: *lower_context.LowerContext, pub_decl: bool) Linkage {
    if (pub_decl && ctx.unit.root_project) { ret Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}; }
    ret Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN};
}

# an instance every instantiating module defines, of which the link keeps one
fun weak_linkage() Linkage {
    ret Linkage{binding: ?symbol.WEAKLY, visibility: ?symbol.HIDDEN};
}

# a function attribute mirl gives no function: refused where the decorator is written
fun refuse_function_decorator(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, id: decorator.Id, what: str) err[fail.Fail] {
    val dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, id);
    if (sel dec.none) { ret err[fail.Fail].ok{}; }
    fail.reject(?ctx.status);
    val loc: lang_source.Location = lang_source.location(ctx.scope.a.file_id, d.span);
    ret err[fail.Fail].err{diagnostic.reject(ctx.diags, diagnostic_kind.DECORATOR_ARGUMENT, loc, what)};
}

# the decorators of a function no mirl function states yet
fun refuse_unplaced_function(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) err[fail.Fail] {
    val sec: err[fail.Fail] = refuse_function_decorator(ctx, d, decorator.SECTION, "`#[section]` on a function waits for mirl to place a function in a section");
    if (sel sec.err) { ret sec; }
    val al: err[fail.Fail] = refuse_function_decorator(ctx, d, decorator.ALIGN, "`#[align]` on a function waits for mirl to align a function's entry");
    if (sel al.err) { ret al; }
    ret refuse_function_decorator(ctx, d, decorator.NAKED, "`#[naked]` waits for inline assembly in mirl");
}

fun lower_fun(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    if (d.data.fun_.generics_len > 0)   { ret err[fail.Fail].ok{}; }
    if (fun_has_comptime_param(ctx, d)) { ret err[fail.Fail].ok{}; }
    if (fun_has_pack_param(ctx, d))     { ret err[fail.Fail].ok{}; }

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.lower_fn_sig(ctx, did);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = res_sig.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, fun_export_of(ctx, did));
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    val own: opt[*fe_sema.interface.Declaration] = fe_sema.interface.declaration_at(ctx.scope.iface, did);
    if (sel own.none) { ret err[fail.Fail].err{fail.message("lower: a function has no declaration in its module's interface")}; }
    var op_code: u32 = 0;
    val op_set:  u32 = lower_context.declared_op(ctx, lower_context.Declared{iface: ctx.scope.iface, declaration: own.some}, ?op_code);

    # an instruction on the selected target has no body there, and a body the normal object
    # defines is declared in the test object
    var declared_only: bool = (d.flags & ast_decl.DECL_FLAG_EXT) != 0 || ast_id.stmt_is_nil(d.data.fun_.body) || op_set != target_definition.NO_OP_SET;
    if (lower_context.normal_defines(ctx, name)) { declared_only = true; }
    if (declared_only) {
        val declared: res[u32, fail.Fail] = lower_context.ensure_extern_function(ctx, name, sig);
        if (sel declared.err) { ret err[fail.Fail].err{declared.err}; }
        ret err[fail.Fail].ok{};
    }

    val refused: err[fail.Fail] = refuse_unplaced_function(ctx, d);
    if (sel refused.err) { ret refused; }

    val res_idx: res[u32, fail.Fail] = define_function(ctx, name, sig, defined_linkage(ctx, (d.flags & ast_decl.DECL_FLAG_PUB) != 0), oblivious(ctx, d));
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret emit_function_body(ctx, did, d, res_idx.ok, sig, lower_context.decl_ret_sem(ctx, did), lang_source.location(ctx.scope.a.file_id, d.data.fun_.name));
}

# a function constant time: its secrets never steer its timing
fun oblivious(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    ret decorator.has(ctx.scope.a, d, decorator.OBLIVIOUS);
}

pub fun lower_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId) err[fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, lower_context.decl_ret_sem(ctx, did));
}

pub fun lower_value_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId) err[fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, lower_context.decl_ret_sem(ctx, did));
}

pub fun lower_pack_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl,
    name: intern.StrId, types: *type.TypeId, type_len: u32) err[fail.Fail] {
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    val fixed_count: u32 = d.data.fun_.params_len - 1;

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.pack_instance_sig(ctx, lower_context.decl_type_of(ctx, did), types, type_len);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = res_sig.ok;

    if (lower_context.normal_defines(ctx, name)) { ret declare_instance(ctx, name, sig); }

    val refused: err[fail.Fail] = refuse_unplaced_function(ctx, d);
    if (sel refused.err) { ret refused; }

    val res_idx: res[u32, fail.Fail] = define_function(ctx, name, sig, weak_linkage(), oblivious(ctx, d));
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    val ret_sem: type.TypeId    = lower_context.decl_ret_sem(ctx, did);
    val entered: err[fail.Fail] = enter_function(ctx, fn_index, sig, ret_sem, lang_source.location(ctx.scope.a.file_id, d.data.fun_.name));
    if (sel entered.err) { ret entered; }

    ctx.pack_types    = types;
    ctx.pack_len      = type_len;
    ctx.pack_ret_type = ret_sem;

    val res_params: err[fail.Fail] = lower_pack_params(ctx, did, d, fixed_count, types, type_len);
    if (sel res_params.err) {
        clear_pack_state(ctx);
        ret res_params;
    }

    val res_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.fun_.body);
    if (sel res_body.err) {
        clear_pack_state(ctx);
        ret res_body;
    }

    val res_close: err[fail.Fail] = close_function(ctx);
    clear_pack_state(ctx);
    ret res_close;
}

fun fun_has_comptime_param(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_names.len && ctx.scope.a.typed_names.data[pool_ix].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun fun_has_pack_param(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    val n: u32 = d.data.fun_.params_len;
    if (n == 0) { ret false; }
    val pool_ix: u32 = d.data.fun_.params_start + (n - 1);
    if (pool_ix::usize >= ctx.scope.a.typed_names.len) { ret false; }
    val tn:       *ast_decl.TypedName = ?ctx.scope.a.typed_names.data[pool_ix];
    val pt:       type.TypeId         = lower_context.type_resolved_of(ctx, tn.ty);
    val opt_type: opt[*type.Type]     = type.get(?ctx.s.types, pt);
    if (sel opt_type.none) { ret false; }
    ret opt_type.some.kind == type.TYPE_PACK;
}

# a global's section: the named one `#[section]` gives it, of the kind its mutability needs
fun global_section(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, is_mut: bool) opt[Section] {
    val named: intern.StrId = decl_section_of(ctx, d);
    if (intern.str_is_nil(named)) { ret opt[Section].none{}; }
    val text: str                = intern.text(?ctx.s.interner, named);
    var kind: *mink_section.Kind = ?mink_section.RODATA;
    if (is_mut) { kind = ?mink_section.DATA; }
    ret opt[Section].some{Section{name: View{data: text, len: str_len(text)}, kind: kind}};
}

fun lower_global(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, is_mut: bool) err[fail.Fail] {
    val sem:     type.TypeId          = lower_context.decl_type_of(ctx, did);
    val res_gty: res[Type, fail.Fail] = lower_context.lower_type(ctx, sem);
    if (sel res_gty.err) { ret err[fail.Fail].err{res_gty.err}; }
    val gty: Type = res_gty.ok;

    val res_bare: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.bind.name.offset, d.data.bind.name.len);
    if (sel res_bare.err) { ret err[fail.Fail].err{fail.refused(res_bare.err)}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, global_export_of(ctx, did));
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    # the normal object defines it: a test that reads it declares it where it does
    if (lower_context.normal_defines(ctx, name)) { ret err[fail.Fail].ok{}; }

    if ((d.flags & ast_decl.DECL_FLAG_EXT) != 0) {
        val declared: res[u32, fail.Fail] = lower_context.ensure_extern_global(ctx, name, gty);
        if (sel declared.err) { ret err[fail.Fail].err{declared.err}; }
        ret err[fail.Fail].ok{};
    }

    var init_val: value.Value = value.const_null(gty);
    if (decorator.has(ctx.scope.a, d, decorator.EMBED)) {
        val er: res[*session_embed.EmbedFile, fail.Fail] = embed_file_of(ctx, d);
        if (sel er.err) { ret err[fail.Fail].err{er.err}; }
        val bytes: res[value.Value, fail.Fail] = constnode.bytes_constant(ctx, er.ok.bytes, er.ok.len::u64);
        if (sel bytes.err) { ret err[fail.Fail].err{bytes.err}; }
        init_val = bytes.ok;
    }
    or (!ast_id.expr_is_nil(d.data.bind.init)) {
        val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, did, d.data.bind.init, gty, bare);
        if (sel res_fold.err) { ret err[fail.Fail].err{res_fold.err}; }
        init_val = res_fold.ok;
    }

    val res_align: res[u32, fail.Fail] = decl_align_of(ctx, d);
    if (sel res_align.err) { ret err[fail.Fail].err{res_align.err}; }
    var align: u64 = res_align.ok::u64;
    if (align == 0) { align = lower_context.storage_align(ctx, sem, gty); }

    val initial: id.Constant    = builder.constant_of(?ctx.builder, init_val);
    val built:   err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel built.err) { ret built; }

    var g: GlobalData;
    g.name      = View{data: intern.text(?ctx.s.interner, name), len: str_len(intern.text(?ctx.s.interner, name))};
    g.type      = init_val.ty;
    g.initial   = opt[id.Constant].some{initial};
    g.alignment = opt[u64].some{align};
    g.section   = global_section(ctx, d, is_mut);
    g.tls       = opt[mirl_global.Tls].none{};
    g.linkage   = defined_linkage(ctx, (d.flags & ast_decl.DECL_FLAG_PUB) != 0);
    g.constant  = !is_mut;
    val res_idx: res[u32, fail.Fail] = lower_context.define_global(ctx, g);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret err[fail.Fail].ok{};
}

fun lower_weak_instance(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, name: intern.StrId, ret_sem: type.TypeId) err[fail.Fail] {
    if (ast_id.stmt_is_nil(d.data.fun_.body)) { ret err[fail.Fail].ok{}; }

    val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.lower_fn_sig(ctx, did);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = res_sig.ok;

    if (lower_context.normal_defines(ctx, name)) { ret declare_instance(ctx, name, sig); }

    val refused: err[fail.Fail] = refuse_unplaced_function(ctx, d);
    if (sel refused.err) { ret refused; }

    # weak so each instantiating module's copy coalesces; not a `pub` declaration
    val res_idx: res[u32, fail.Fail] = define_function(ctx, name, sig, weak_linkage(), oblivious(ctx, d));
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret emit_function_body(ctx, did, d, res_idx.ok, sig, ret_sem, lang_source.location(ctx.scope.a.file_id, d.data.fun_.name));
}

# an instance the normal object already defines is declared in the test object, never lowered
# again: every instantiating module's copy is one shared definition
fun declare_instance(ctx: *lower_context.LowerContext, name: intern.StrId, sig: lower_context.FnSig) err[fail.Fail] {
    val res_idx: res[u32, fail.Fail] = lower_context.ensure_extern_function(ctx, name, sig);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret err[fail.Fail].ok{};
}

fun function_bare_name(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[intern.StrId, fail.Fail] {
    val r_353: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.fun_.name.offset, d.data.fun_.name.len);
    if (sel r_353.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_353.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_353.ok};
}

# the module's definition of the function `name`, which a reference earlier in the module
# may have declared
fun define_function(ctx: *lower_context.LowerContext, name: intern.StrId, sig: lower_context.FnSig, linkage_of: Linkage, constant_time: bool) res[u32, fail.Fail] {
    val text: str = intern.text(?ctx.s.interner, name);
    ret lower_context.define_function(ctx, FunctionData{name: View{data: text, len: str_len(text)}, signature: sig.sig, linkage: linkage_of, constant_time: constant_time},
        lower_context.FnInfo{name: name, line: 0, test: false, noreturn: false, defined: true});
}

# start building function `fn_index`: its entry takes its signature's parameters
fun enter_function(ctx: *lower_context.LowerContext, fn_index: u32, sig: lower_context.FnSig, ret_sem: type.TypeId, at: lang_source.Location) err[fail.Fail] {
    val t:       *types.Table                    = ?ctx.m.types;
    val n:       u32                             = irt.param_count(t, sig.sig);
    var params:  collections_vector.Vector[Type] = collections_vector.init[Type](ctx.s.alloc);
    var secrets: collections_vector.Vector[bool] = collections_vector.init[bool](ctx.s.alloc);
    fin {
        collections_vector.dnit[Type](?params);
        collections_vector.dnit[bool](?secrets);
    }
    var i: u32 = 0;
    for (i < n) {
        val p: res[usize, A.Error] = collections_vector.push[Type](?params, irt.param_of(t, sig.sig, i));
        if (sel p.err) { ret err[fail.Fail].err{fail.refused(p.err)}; }
        val q: res[usize, A.Error] = collections_vector.push[bool](?secrets, false);
        if (sel q.err) { ret err[fail.Fail].err{fail.refused(q.err)}; }
        i = i + 1;
    }
    lower_context.begin_function(ctx, fn_index, irt.result_of(t, sig.sig));
    ctx.fn_ret_sem = ret_sem;
    ctx.fn_shown   = at.span;
    builder.enter(?ctx.builder, id.Function{index: fn_index}, params.data, secrets.data, n);
    builder.set_loc(?ctx.builder, at);
    ret lower_context.builder_state(ctx);
}

fun emit_function_body(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl, fn_index: u32, sig: lower_context.FnSig, ret_sem: type.TypeId, at: lang_source.Location) err[fail.Fail] {
    val entered: err[fail.Fail] = enter_function(ctx, fn_index, sig, ret_sem, at);
    if (sel entered.err) { ret entered; }

    val res_params: err[fail.Fail] = lower_params(ctx, did, d);
    if (sel res_params.err) { ret res_params; }

    if (!ast_id.stmt_is_nil(d.data.fun_.body)) {
        val res_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.fun_.body);
        if (sel res_body.err) { ret res_body; }
    }

    ret close_function(ctx);
}

fun clear_pack_state(ctx: *lower_context.LowerContext) {
    if (ctx.pack_slots != nil && ctx.pack_len > 0) {
        A.deallocate[value.Value](ctx.s.alloc, ctx.pack_slots, ctx.pack_len::usize);
    }
    ctx.pack_slots    = nil;
    ctx.pack_types    = nil;
    ctx.pack_len      = 0;
    ctx.pack_ret_type = type.TYPE_NIL;
}

fun lower_pack_params(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl,
    fixed_count: u32, types_of: *type.TypeId, type_len: u32) err[fail.Fail] {
    val total:  u32          = fixed_count + type_len;
    var slots:  *value.Value = nil;
    var handed: bool         = false;
    fin {
        if (!handed && slots != nil) { A.deallocate[value.Value](ctx.s.alloc, slots, type_len::usize); }
    }
    if (type_len > 0) {
        val res_slots: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, type_len::usize);
        if (sel res_slots.err) { ret err[fail.Fail].err{fail.refused(res_slots.err)}; }
        slots = res_slots.ok;
    }

    var i: u32 = 0;
    for (i < total) {
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < ctx.scope.a.typed_names.len) {
                p_sem = lower_context.type_resolved_of(ctx, ctx.scope.a.typed_names.data[pool_ix].ty);
            }
        }
        or { p_sem = types_of[i - fixed_count]; }

        val res_home: res[Home, fail.Fail] = param_home(ctx, i, p_sem);
        if (sel res_home.err) { ret err[fail.Fail].err{res_home.err}; }

        if (i < fixed_count) {
            val sid: resolve.SymbolId = param_symbol(ctx, did, i);
            if (!resolve.symbol_is_nil(sid)) {
                val res_bind: err[fail.Fail] = lower_context.bind_local(ctx, sid, res_home.ok.slot);
                if (sel res_bind.err) { ret res_bind; }
            }
        }
        or { slots[i - fixed_count] = res_home.ok.slot; }
        i = i + 1;
    }

    ctx.pack_slots = slots;
    handed         = true;
    ret err[fail.Fail].ok{};
}

# where a parameter lives in the body: the slot its name binds to, always an address, and the
# value it arrived as
rec Home {
    slot:    value.Value;
    arrived: value.Value;
}

# the home a parameter's name binds to. an aggregate arrives in a slot of its own; a
# parameter in a register gets a slot and an entry store
fun param_home(ctx: *lower_context.LowerContext, w: u32, p_sem: type.TypeId) res[Home, fail.Fail] {
    val res_p_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, p_sem);
    if (sel res_p_ir.err) { ret res[Home, fail.Fail].err{res_p_ir.err}; }
    val p_ir: Type = res_p_ir.ok;

    val got: res[value.Value, fail.Fail] = builder.param(?ctx.builder, w, p_ir);
    if (sel got.err) { ret res[Home, fail.Fail].err{got.err}; }
    var pval: value.Value = got.ok;
    if (lower_context.type_contains_secret(ctx, p_sem)) { pval.secret = true; }

    if (irt.is_aggregate(?ctx.m.types, p_ir)) {
        ret res[Home, fail.Fail].ok{Home{slot: value.retype(pval, lower_context.ptr_or_none(ctx)), arrived: pval}};
    }
    val res_slot: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, p_sem, p_ir);
    if (sel res_slot.err) { ret res[Home, fail.Fail].err{res_slot.err}; }
    val res_store: err[fail.Fail] = builder.emit_store_marked(?ctx.builder, pval, res_slot.ok, lower_expr.type_is_volatile_record(ctx, p_sem));
    if (sel res_store.err) { ret res[Home, fail.Fail].err{res_store.err}; }
    ret res[Home, fail.Fail].ok{Home{slot: res_slot.ok, arrived: pval}};
}

fun lower_test(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    val res_i32: res[Type, fail.Fail] = irt.int(?ctx.m.types, 32);
    if (sel res_i32.err) { ret err[fail.Fail].err{res_i32.err}; }
    var result:     Type                 = res_i32.ok;
    var result_ext: types.Extension      = types.Extension.sext{};
    val res_sig:    res[Type, fail.Fail] = irt.signature(?ctx.m.types, nil, nil, 0, ?result, ?result_ext, 1);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: lower_context.FnSig = lower_context.FnSig{sig: res_sig.ok};

    val res_ident: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), d.data.test_.name.offset, d.data.test_.name.len);
    if (sel res_ident.err) { ret err[fail.Fail].err{fail.refused(res_ident.err)}; }
    val ident: intern.StrId = res_ident.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.test_name(ctx.s, ctx.scope.fqn, ident);
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    val twice: opt[u32] = lower_context.function_named(ctx, name);
    if (sel twice.some) { ret err[fail.Fail].err{fail.message("lower: a test name sema accepted is emitted twice")}; }

    var line:   u32                          = 0;
    val opt_sf: opt[*lang_source.SourceFile] = lang_source.get(?ctx.s.sources, ctx.scope.a.file_id);
    if (sel opt_sf.some) { line = lang_source.position(opt_sf.some, d.data.test_.name.offset).line::u32; }

    val text:    str                 = intern.text(?ctx.s.interner, name);
    val res_idx: res[u32, fail.Fail] = lower_context.define_function(ctx,
        FunctionData{name: View{data: text, len: str_len(text)}, signature: sig.sig, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN}, constant_time: false},
        lower_context.FnInfo{name: name, line: line, test: true, noreturn: false, defined: true});
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }

    val entered: err[fail.Fail] = enter_function(ctx, res_idx.ok, sig, type.TYPE_NIL, lang_source.location(ctx.scope.a.file_id, d.data.test_.name));
    if (sel entered.err) { ret entered; }
    if (!ast_id.stmt_is_nil(d.data.test_.body)) {
        val res_body: err[fail.Fail] = lower_stmt.lower_stmt(ctx, d.data.test_.body);
        if (sel res_body.err) { ret res_body; }
    }
    ret close_function(ctx);
}

fun lower_params(ctx: *lower_context.LowerContext, did: ast_id.DeclId, d: *ast_decl.Decl) err[fail.Fail] {
    val count: u32 = d.data.fun_.params_len;
    var w:     u32 = 0;
    var i:     u32 = 0;
    for (i < count) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_names.len && ctx.scope.a.typed_names.data[pool_ix].comptime) {
            i = i + 1;
            cnt;
        }
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (pool_ix::usize < ctx.scope.a.typed_names.len) { p_sem = lower_context.type_resolved_of(ctx, ctx.scope.a.typed_names.data[pool_ix].ty); }

        val res_home: res[Home, fail.Fail] = param_home(ctx, w, p_sem);
        if (sel res_home.err) { ret err[fail.Fail].err{res_home.err}; }

        val sid: resolve.SymbolId = param_symbol(ctx, did, i);
        if (!resolve.symbol_is_nil(sid)) {
            val res_bind: err[fail.Fail] = lower_context.bind_local(ctx, sid, res_home.ok.slot);
            if (sel res_bind.err) { ret res_bind; }
        }

        if (ctx.debug && pool_ix::usize < ctx.scope.a.typed_names.len) {
            val res_dbg: err[fail.Fail] = lower_context.emit_dbg_birth(ctx, ctx.scope.a.typed_names.data[pool_ix].name, p_sem,
                opt[u32].some{w}, res_home.ok.arrived, opt[value.Value].some{res_home.ok.slot});
            if (sel res_dbg.err) { ret res_dbg; }
        }

        w = w + 1;
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# end the function: the block it falls off the end of returns zero, every other block left
# open is unreachable, and the builder's first refusal is the function's
fun close_function(ctx: *lower_context.LowerContext) err[fail.Fail] {
    if (!lower_context.block_terminated(ctx)) {
        val res_term: err[fail.Fail] = emit_default_terminator(ctx);
        if (sel res_term.err) { ret res_term; }
    }
    val sealed: err[fail.Fail] = builder.seal(?ctx.builder);
    var state:  err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel sealed.err && !sel state.err) { state = sealed; }
    val computed: opt[builder.Computed] = ctx.builder.computed;
    builder.leave(?ctx.builder);
    if (sel state.err)     { ret state; }
    if (sel computed.none) { ret state; }
    ret report_not_oblivious(ctx, computed.some);
}

# a function that computes on a secret without declaring `#[oblivious]` is refused at its
# first such computation; an instance is named by the instantiation as well
fun report_not_oblivious(ctx: *lower_context.LowerContext, at: builder.Computed) err[fail.Fail] {
    val node:  *FunctionData              = ?ctx.m.functions.data[ctx.fn_index].data;
    val shown: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), ctx.fn_shown.offset, ctx.fn_shown.len);
    if (sel shown.err) { ret err[fail.Fail].err{fail.refused(shown.err)}; }
    val name: str                              = intern.text(?ctx.s.interner, shown.ok);
    val mr:   res[str, std_format.FormatError] = std_format.sprint(ctx.s.alloc,
        "`{}` performs a constant-time {} on a secret value but is not declared `#[oblivious]`",
        name, lower_oblivious.class_name(at.code));
    if (sel mr.err) { ret err[fail.Fail].err{fail.format_refused(mr.err)}; }
    val msg: str                                          = mr.ok;
    val br:  res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(ctx.s.alloc, diagnostic_kind.SECRET_NOT_OBLIVIOUS, at.loc.file, at.loc.span, msg);
    A.deallocate[u8](ctx.s.alloc, msg::*u8, str_len(msg) + 1);
    if (sel br.err) { ret err[fail.Fail].err{br.err}; }
    var b:    diagnostic.DiagnosticBuilder = br.ok;
    var info: opt[*lower_context.FnInfo]   = opt[*lower_context.FnInfo].none{};
    if (node.linkage.binding == ?symbol.WEAKLY) { info = lower_context.fn_info(ctx.unit, ctx.fn_index); }
    if (sel info.some) {
        val nr: res[str, std_format.FormatError] = std_format.sprint(ctx.s.alloc, "in the instantiation `{}`", intern.text(?ctx.s.interner, info.some.name));
        if (sel nr.err) {
            diagnostic.builder_dnit(?b);
            ret err[fail.Fail].err{fail.format_refused(nr.err)};
        }
        val noted: err[fail.Fail] = diagnostic.attach_note(?b, nr.ok);
        A.deallocate[u8](ctx.s.alloc, nr.ok::*u8, str_len(nr.ok) + 1);
        if (sel noted.err) {
            diagnostic.builder_dnit(?b);
            ret noted;
        }
    }
    val helped: err[fail.Fail] = diagnostic.attach_help(?b,
        "annotate the function with `#[oblivious]` to declare its constant-time contract; only a function that merely moves or stores secrets may omit it");
    if (sel helped.err) {
        diagnostic.builder_dnit(?b);
        ret helped;
    }
    val committed: err[fail.Fail] = diagnostic.commit(?b, ctx.diags);
    if (sel committed.err) {
        diagnostic.builder_dnit(?b);
        ret committed;
    }
    # the rest of the module is still lowered, so every such function is named
    fail.reject(?ctx.status);
    ret err[fail.Fail].ok{};
}

fun emit_default_terminator(ctx: *lower_context.LowerContext) err[fail.Fail] {
    val info: opt[*lower_context.FnInfo] = lower_context.fn_info(ctx.unit, ctx.fn_index);
    if (sel info.some && info.some.noreturn) { ret builder.emit_unreachable(?ctx.builder); }
    if (irt.is_none(ctx.ret_type))           { ret builder.emit_ret_void(?ctx.builder); }

    val res_zero: res[value.Value, fail.Fail] = default_return_value(ctx, ctx.ret_type);
    if (sel res_zero.err) { ret err[fail.Fail].err{res_zero.err}; }
    ret builder.emit_ret(?ctx.builder, res_zero.ok);
}

fun default_return_value(ctx: *lower_context.LowerContext, ret_ir: Type) res[value.Value, fail.Fail] {
    if (!irt.is_aggregate(?ctx.m.types, ret_ir)) { ret res[value.Value, fail.Fail].ok{value.const_null(ret_ir)}; }
    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, ret_ir);
    if (sel res_slot.err) { ret res_slot; }
    val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, res_slot.ok, ret_ir);
    if (sel res_mz.err) { ret res[value.Value, fail.Fail].err{res_mz.err}; }
    ret res[value.Value, fail.Fail].ok{value.retype(res_slot.ok, ret_ir)};
}

# the constant a global's initialiser binds, folded exactly as its lowering folds it; `did` is the
# declaration whose published value lays it out, DECL_NIL for a decorator argument, which has none
fun fold_global_init(ctx: *lower_context.LowerContext, did: ast_id.DeclId, eid: ast_id.ExprId, gty: Type, name: intern.StrId) res[value.Value, fail.Fail] {
    val folded: res[value.Value, fail.Fail] = fold_global_value(ctx, did, eid, gty, name);
    if (sel ctx.status.kind.internal) { ret res[value.Value, fail.Fail].err{fail.phase_failure(ctx.status)}; }
    if (sel folded.err) {
        val failure: fail.Fail = folded.err;
        if (sel failure.reported) {
            if (sel ctx.status.kind.accepted) { fail.reject(?ctx.status); }
        }
        or { fail.internal(?ctx.status, fail.describe(failure)); }
    }
    ret folded;
}

fun fold_global_value(ctx: *lower_context.LowerContext, did: ast_id.DeclId, eid: ast_id.ExprId, gty: Type, name: intern.StrId) res[value.Value, fail.Fail] {
    if (is_null_init(ctx, eid)) { ret res[value.Value, fail.Fail].ok{value.const_null(gty)}; }

    val laid: res[opt[value.Value], fail.Fail] = published_layout(ctx, did, gty);
    if (sel laid.err)     { ret res[value.Value, fail.Fail].err{laid.err}; }
    if (sel laid.ok.some) { ret res[value.Value, fail.Fail].ok{laid.ok.some}; }

    val scalar: opt[comptime.CTValue] = published_scalar(ctx, did);
    if (sel scalar.some) { ret lower_expr.const_value_of_init(ctx, eid, scalar.some); }

    val evaluated: res[comptime.CTValue, comptime.EvalFail] = try_comptime(ctx, eid);
    if (sel evaluated.ok) {
        ret lower_expr.const_value_of_init(ctx, eid, evaluated.ok);
    }

    val eval_failure: comptime.EvalFail = evaluated.err;
    if (eval_failure.kind == comptime.EVAL_FAIL_INTERNAL) {
        ret res[value.Value, fail.Fail].err{fail.message(eval_failure.message)};
    }

    val opt_init: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel opt_init.err) { ret res[value.Value, fail.Fail].err{opt_init.err}; }
    var ie_value: ast_expr.Expr  = opt_init.ok;
    val ie:       *ast_expr.Expr = ?ie_value;

    if (ie.kind == ast_expr.EXPR_KIND_CALL) {
        val opt_intr: opt[res[value.Value, fail.Fail]] = lower_expr.try_lower_comptime_intrinsic(ctx, eid, ie);
        if (sel opt_intr.some) { ret opt_intr.some; }
    }

    if (eval_failure.kind == comptime.EVAL_FAIL_REJECTED) {
        fail.reject(?ctx.status);
        val reported: err[fail.Fail] = diagnostic.report(ctx.diags, eval_failure.diag, ctx.scope.a.file_id, ie.span, eval_failure.message);
        if (sel reported.err) { ret res[value.Value, fail.Fail].err{reported.err}; }
    }
    or (comptime.not_constant(eval_failure.kind)) {
        fail.reject(?ctx.status);
        val reported: err[fail.Fail] = comptime.init_not_constant_report(ctx.s.alloc, ctx.diags, ctx.scope.a.file_id, ie.span, intern.get(?ctx.s.interner, name));
        if (sel reported.err) { ret res[value.Value, fail.Fail].err{reported.err}; }
    }
    or { ret res[value.Value, fail.Fail].err{fail.message("lower: invalid comptime evaluation failure kind")}; }
    ret res[value.Value, fail.Fail].err{fail.reported()};
}

# the scalar value the module's interface publishes for the global `did`, none for a global it
# publishes no scalar for
fun published_scalar(ctx: *lower_context.LowerContext, did: ast_id.DeclId) opt[comptime.CTValue] {
    val found: opt[*fe_sema.interface.Declaration] = fe_sema.interface.declaration_at(ctx.scope.iface, did);
    if (sel found.none)                             { ret opt[comptime.CTValue].none{}; }
    if (found.some.value == fe_sema.interface.NONE) { ret opt[comptime.CTValue].none{}; }
    val n: *comptime_deep.Node = comptime_deep.node_at(?ctx.scope.iface.values, found.some.value);
    if (n.kind != comptime_deep.NODE_SCALAR || n.value.kind == comptime.CT_KIND_STR) { ret opt[comptime.CTValue].none{}; }
    ret opt[comptime.CTValue].some{n.value};
}

# the bytes of a global whose published value is an aggregate or an address, laid out from that
# value; none for a scalar, which folds as its published value, and for no declaration
fun published_layout(ctx: *lower_context.LowerContext, did: ast_id.DeclId, gty: Type) res[opt[value.Value], fail.Fail] {
    val none:  res[opt[value.Value], fail.Fail]    = res[opt[value.Value], fail.Fail].ok{opt[value.Value].none{}};
    val found: opt[*fe_sema.interface.Declaration] = fe_sema.interface.declaration_at(ctx.scope.iface, did);
    if (sel found.none)                             { ret none; }
    if (found.some.value == fe_sema.interface.NONE) { ret none; }
    val store: *comptime_deep.Store = ?ctx.scope.iface.values;
    val node:  u32                  = found.some.value;
    val n:     *comptime_deep.Node  = comptime_deep.node_at(store, node);
    var laid:  bool                 = n.kind == comptime_deep.NODE_LITERAL || n.kind == comptime_deep.NODE_ARRAY || n.kind == comptime_deep.NODE_ADDRESS;
    if (n.kind == comptime_deep.NODE_SCALAR && n.value.kind == comptime.CT_KIND_STR)                                    { laid = true; }
    if (n.kind == comptime_deep.NODE_REFUSED && (irt.is_aggregate(?ctx.m.types, gty) || irt.is_ptr(?ctx.m.types, gty))) { laid = true; }
    if (!laid)                                                                                                          { ret none; }
    val refused: opt[u32] = comptime_deep.refused_within(store, node);
    if (sel refused.some) {
        val r: comptime_deep.Refusal = comptime_deep.node_at(store, refused.some).refusal;
        fail.reject(?ctx.status);
        val reported: err[fail.Fail] = diagnostic.report(ctx.diags, r.diag, r.at.file, r.at.span, intern.text(?ctx.s.interner, r.message));
        if (sel reported.err) { ret res[opt[value.Value], fail.Fail].err{reported.err}; }
        ret res[opt[value.Value], fail.Fail].err{fail.reported()};
    }
    val agg: res[value.Value, fail.Fail] = constnode.aggregate(ctx, store, node, gty);
    if (sel agg.err) { ret res[opt[value.Value], fail.Fail].err{agg.err}; }
    ret res[opt[value.Value], fail.Fail].ok{opt[value.Value].some{agg.ok}};
}

fun is_null_init(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = eid;
    for (true) {
        val opt_expr: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, cur);
        if (sel opt_expr.err) { ret false; }
        var e_value: ast_expr.Expr  = opt_expr.ok;
        val e:       *ast_expr.Expr = ?e_value;
        if (e.kind == ast_expr.EXPR_KIND_LIT_NIL) { ret true; }
        if (e.kind != ast_expr.EXPR_KIND_CAST)    { ret false; }
        cur = e.data.cast.value;
    }
    ret false;
}

fun lower_comptime_if(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) err[fail.Fail] {
    var i: u32 = 0;
    for (i < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branches.len) {
            ret err[fail.Fail].err{fail.message("lower: comptime branch index out of range")};
        }
        val branch: *ast_decl.ComptimeBranch = ?ctx.scope.a.comptime_branches.data[branch_ix];

        var active: bool = false;
        if (ast_id.expr_is_nil(branch.cond)) {
            active = true;
        }
        or {
            # a gate that declares is decided with the module, one over code alone as sema types it
            val state: comptime.GateState = comptime.gate_state(ctx.scope.ctx, branch.cond);
            if (state == comptime.GATE_STATE_TRUE || state == comptime.GATE_STATE_FALSE) { active = state == comptime.GATE_STATE_TRUE; }
            or {
                val verdict: opt[bool] = lower_context.gate_of(ctx, branch.cond);
                if (sel verdict.none) { ret err[fail.Fail].err{fail.message("lower: a module-level gate reached lowering undecided")}; }
                active = verdict.some;
            }
        }

        if (active) {
            var ii: u32 = 0;
            for (ii < branch.body_len) {
                val pool_ix: u32 = branch.body_start + ii;
                if (pool_ix::usize >= ctx.scope.a.decl_ids.len) {
                    ret err[fail.Fail].err{fail.message("lower: comptime decl body index out of range")};
                }
                val res_decl: err[fail.Fail] = lower_decl(ctx, ctx.scope.a.decl_ids.data[pool_ix]);
                if (sel res_decl.err) { ret res_decl; }
                ii = ii + 1;
            }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun decl_section_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) intern.StrId {
    val dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.SECTION);
    if (sel dec.none) { ret intern.STR_NIL; }
    ret decorator.string_id(ctx.scope.ctx, ctx.scope.a, dec.some, 0);
}

fun embed_file_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[*session_embed.EmbedFile, fail.Fail] {
    val opt_dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, decorator.EMBED);
    if (sel opt_dec.none) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed declaration lost its decorator before lowering")};
    }

    if (opt_dec.some.args_len == 0) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed declaration has a malformed path after sema")};
    }
    val file: intern.StrId = comptime.decorator_embed_file(ctx.scope.ctx, ctx.scope.a.expr_ids.data[opt_dec.some.args_start]);
    if (intern.str_is_nil(file)) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed path became invalid after successful sema")};
    }

    val opt_e: opt[*session_embed.EmbedFile] = session_embed.get(?ctx.s.embeds, file);
    if (sel opt_e.none) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry is unavailable during lowering")};
    }
    val e: *session_embed.EmbedFile = opt_e.some;
    if (e.status != session_embed.EMBED_OK) {
        ret res[*session_embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry changed after successful sema")};
    }
    ret res[*session_embed.EmbedFile, fail.Fail].ok{e};
}

fun decorator_arg_eid(ctx: *lower_context.LowerContext, d: *ast_decl.Decl, id: decorator.Id, ord: u32) opt[ast_id.ExprId] {
    val dec: opt[*ast_decl.Decorator] = decorator.get(ctx.scope.a, d, id);
    if (sel dec.none) { ret opt[ast_id.ExprId].none{}; }
    val found: *ast_decl.Decorator = dec.some;
    if (ord >= found.args_len) { ret opt[ast_id.ExprId].none{}; }
    ret opt[ast_id.ExprId].some{ctx.scope.a.expr_ids.data[found.args_start + ord]};
}

# the value of a declaration's `#[align]`, 0 without one
fun decl_align_of(ctx: *lower_context.LowerContext, d: *ast_decl.Decl) res[u32, fail.Fail] {
    val opt_arg: opt[ast_id.ExprId] = decorator_arg_eid(ctx, d, decorator.ALIGN, 0);
    if (sel opt_arg.none) { ret res[u32, fail.Fail].ok{0}; }
    val arg: ast_id.ExprId = opt_arg.some;

    val res_u64: res[Type, fail.Fail] = irt.int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret res[u32, fail.Fail].err{res_u64.err}; }
    val u64t: Type = res_u64.ok;

    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, ast_id.DECL_NIL, arg, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret res[u32, fail.Fail].err{res_fold.err}; }
    val v: value.Value = res_fold.ok;
    # sema decided the value is a power of two that fits
    if (v.kind != value.VAL_INT) { ret res[u32, fail.Fail].err{fail.message("lower: an `align` sema accepted did not fold to an integer")}; }
    val n: u64 = value.int_lit(v);
    if (n == 0 || (n & (n - 1)) != 0 || n > 0xFFFFFFFF) { ret res[u32, fail.Fail].err{fail.message("lower: an `align` sema accepted is not a power of two that fits")}; }
    ret res[u32, fail.Fail].ok{n::u32};
}

fun param_symbol(ctx: *lower_context.LowerContext, fun_did: ast_id.DeclId, index: u32) resolve.SymbolId {
    ret resolve.param_symbol(ctx.scope.rr, fun_did, index);
}

fun try_comptime(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[comptime.CTValue, comptime.EvalFail] {
    val r_1162: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        lower_context.module_source(ctx), eid, ?ctx.s.interner, lower_context.expr_float_width(ctx, eid));
    if (sel r_1162.err) { ret res[comptime.CTValue, comptime.EvalFail].err{r_1162.err}; }
    ret res[comptime.CTValue, comptime.EvalFail].ok{r_1162.ok};
}

fun fun_export_of(ctx: *lower_context.LowerContext, did: ast_id.DeclId) intern.StrId {
    val r_1166: intern.StrId = linkage.export_name(ctx.linkage, ctx.scope.own_module, did::u32);
    if (!intern.str_is_nil(r_1166)) { ret r_1166; }
    ret intern.STR_NIL;
}

fun global_export_of(ctx: *lower_context.LowerContext, did: ast_id.DeclId) intern.StrId {
    val r_1170: intern.StrId = linkage.export_name(ctx.linkage, ctx.scope.own_module, did::u32);
    if (!intern.str_is_nil(r_1170)) { ret r_1170; }
    ret intern.STR_NIL;
}
