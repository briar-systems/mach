pub fun lower_decl(ctx: *context.LowerContext, did: id.DeclId) err[fail.Fail] {
    val opt_decl: opt[*decl.Decl] = ast.get_decl_typed(ctx.scope.a, did);
    if (sel opt_decl.none) {
        ret err[fail.Fail].err{fail.message("lower: declaration id out of range")};
    }
    val d: *decl.Decl    = opt_decl.some;
    val k: decl.DeclKind = d.kind;

    if (k == decl.DECL_KIND_FUN)         { ret lower_fun(ctx, did, d, false); }
    if (k == decl.DECL_KIND_TEST) {
        if (!ctx.test_mode) { ret err[fail.Fail].ok{}; }
        ret lower_test(ctx, did, d);
    }
    if (k == decl.DECL_KIND_VAL)         { ret lower_global(ctx, did, d, false); }
    if (k == decl.DECL_KIND_VAR)         { ret lower_global(ctx, did, d, true); }
    if (k == decl.DECL_KIND_COMPTIME_IF) { ret lower_comptime_if(ctx, d); }

    if (k == decl.DECL_KIND_ERROR) {
        ret err[fail.Fail].err{fail.message("lower: error declaration reached the middle end")};
    }

    ret err[fail.Fail].ok{};
}

pub fun lower_fun(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, is_test: bool) err[fail.Fail] {
    if (d.data.fun_.generics_len > 0)   { ret err[fail.Fail].ok{}; }
    if (fun_has_comptime_param(ctx, d)) { ret err[fail.Fail].ok{}; }
    if (fun_has_pack_param(ctx, d))     { ret err[fail.Fail].ok{}; }

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: ir_type.IrTypeId = res_sig.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, fun_export_of(ctx, did));
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    var flags: u32 = 0;
    if ((d.flags & decl.DECL_FLAG_PUB) != 0) { flags = flags | ir.FN_FLAG_PUB; }
    if ((d.flags & decl.DECL_FLAG_EXT) != 0 || d.data.fun_.body == id.STMT_NIL) {
        flags = flags | ir.FN_FLAG_EXTERN;
    }
    if (is_test)                              { flags = flags | ir.FN_FLAG_TEST; }
    if (decl_has_decorator(ctx, d, "inline")) { flags = flags | ir.FN_FLAG_INLINE; }
    if (decl_has_decorator(ctx, d, "noinline")) { flags = flags | ir.FN_FLAG_NOINLINE; }
    if (decl_has_decorator(ctx, d, "oblivious")) { flags = flags | ir.FN_FLAG_OBLIVIOUS; }
    if (decl_has_decorator(ctx, d, "scalar")) { flags = flags | ir.FN_FLAG_SCALAR; }
    if (decl_has_decorator(ctx, d, "naked")) { flags = flags | ir.FN_FLAG_NAKED; }

    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = context.function_return_ir(ctx, did);
    if (sel res_ret_ir.err) { ret err[fail.Fail].err{res_ret_ir.err}; }
    val ret_ir: ir_type.IrTypeId = res_ret_ir.ok;

    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, flags, d.data.fun_.params_len);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    ctx.m.functions[fn_index].section = decl_section_of(ctx, d);
    ctx.m.functions[fn_index].stage = decl_stage_of(ctx, d);
    ctx.m.functions[fn_index].wg_x  = decl_workgroup_dim(ctx, d, 0);
    ctx.m.functions[fn_index].wg_y  = decl_workgroup_dim(ctx, d, 1);
    ctx.m.functions[fn_index].wg_z  = decl_workgroup_dim(ctx, d, 2);
    ctx.m.functions[fn_index].op_set =
        context.decl_target_op(ctx.scope.a, context.module_source(ctx), d, ctx.tgt.isa.defs,
                               ?ctx.m.functions[fn_index].op_code);

    ctx.m.functions[fn_index].is_import = (d.flags & decl.DECL_FLAG_EXT) != 0;

    publish_function_debug(ctx, fn_index, bare, context.decl_ret_sem(ctx, did));

    if ((flags & ir.FN_FLAG_EXTERN) != 0) { ret err[fail.Fail].ok{}; }

    ret emit_function_body(ctx, did, d, fn_index, ret_ir, context.decl_ret_sem(ctx, did));
}

pub fun lower_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, name: intern.StrId) err[fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, context.decl_ret_sem(ctx, did));
}

pub fun lower_value_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, name: intern.StrId) err[fail.Fail] {
    ret lower_weak_instance(ctx, did, d, name, context.decl_ret_sem(ctx, did));
}

pub fun lower_pack_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl,
                            name: intern.StrId, types: *type.TypeId, type_len: u32) err[fail.Fail] {
    if (d.data.fun_.body == id.STMT_NIL) { ret err[fail.Fail].ok{}; }

    val fixed_count: u32 = d.data.fun_.params_len - 1;

    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = context.function_return_ir(ctx, did);
    if (sel res_ret_ir.err) { ret err[fail.Fail].err{res_ret_ir.err}; }
    val ret_ir: ir_type.IrTypeId = res_ret_ir.ok;

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = context.pack_instance_sig(ctx, d, fixed_count, types, type_len, ret_ir);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: ir_type.IrTypeId = res_sig.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    var flags: u32 = ir.FN_FLAG_PUB | ir.FN_FLAG_WEAK;
    if (decl_has_decorator(ctx, d, "inline")) { flags = flags | ir.FN_FLAG_INLINE; }
    if (decl_has_decorator(ctx, d, "noinline")) { flags = flags | ir.FN_FLAG_NOINLINE; }
    if (decl_has_decorator(ctx, d, "oblivious")) { flags = flags | ir.FN_FLAG_OBLIVIOUS; }
    if (decl_has_decorator(ctx, d, "scalar")) { flags = flags | ir.FN_FLAG_SCALAR; }
    if (decl_has_decorator(ctx, d, "naked")) { flags = flags | ir.FN_FLAG_NAKED; }
    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, flags, fixed_count + type_len);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    publish_function_debug(ctx, fn_index, bare, context.decl_ret_sem(ctx, did));

    context.begin_function(ctx, fn_index, ret_ir);

    ctx.pack_types    = types;
    ctx.pack_len      = type_len;
    ctx.pack_ret_type = context.decl_ret_sem(ctx, did);

    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_entry.err) { ret err[fail.Fail].err{res_entry.err}; }
    builder.set_block(?ctx.builder, res_entry.ok);

    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, d.span.offset));

    val res_params: err[fail.Fail] = lower_pack_params(ctx, did, d, fn_index, fixed_count, types, type_len);
    if (sel res_params.err) { clear_pack_state(ctx); ret res_params; }

    val res_encl: err[fail.Fail] = reinfer_instance_typing(ctx, d, ctx.pack_ret_type);
    if (sel res_encl.err) { clear_pack_state(ctx); ret res_encl; }

    val res_body: err[fail.Fail] = stmt.lower_stmt(ctx, d.data.fun_.body);
    if (sel res_body.err) { clear_pack_state(ctx); ret res_body; }

    val res_close: err[fail.Fail] = close_function(ctx, ret_ir);
    clear_pack_state(ctx);
    ret res_close;
}

fun reinfer_instance_typing(ctx: *context.LowerContext, d: *decl.Decl, fn_ret: type.TypeId) err[fail.Fail] {
    if (ctx.scope.subst == nil || ctx.scope.subst_len == 0) { ret err[fail.Fail].ok{}; }

    val res_: err[fail.Fail] = sema.reinfer_instance_body_typed(ctx.s, ctx.scope.a, ctx.scope.rr, ctx.deps, ctx.scope.ctx,
        ctx.scope.own_module, ctx.scope.sema_result, fn_ret, d.data.fun_.body,
        ctx.scope.subst, ctx.scope.subst_len, ctx.diags);
    if (sel res_.err) { ret res_; }
    ret err[fail.Fail].ok{};
}

pub fun fun_has_comptime_param(ctx: *context.LowerContext, d: *decl.Decl) bool {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_name_len && ctx.scope.a.typed_names[pool_ix].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

pub fun fun_has_pack_param(ctx: *context.LowerContext, d: *decl.Decl) bool {
    val n: u32 = d.data.fun_.params_len;
    if (n == 0) { ret false; }
    val pool_ix: u32 = d.data.fun_.params_start + (n - 1);
    if (pool_ix::usize >= ctx.scope.a.typed_name_len) { ret false; }
    val tn: *decl.TypedName = ?ctx.scope.a.typed_names[pool_ix];
    val pt: type.TypeId     = context.type_resolved_of(ctx, tn.ty);
    val opt_type: opt[*type.Type] = type.get_typed(?ctx.s.types, pt);
    if (sel opt_type.none) { ret false; }
    ret opt_type.some.kind == type.TYPE_PACK;
}

pub fun lower_global(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, is_mut: bool) err[fail.Fail] {
    val res_gty: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (sel res_gty.err) { ret err[fail.Fail].err{res_gty.err}; }
    val gty: ir_type.IrTypeId = res_gty.ok;

    val res_bare: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, context.module_source(ctx), d.data.bind.name);
    if (sel res_bare.err) { ret err[fail.Fail].err{fail.refused(res_bare.err)}; }
    val bare: intern.StrId = res_bare.ok;

    # a case-literal `val` is a constant tag for the gates this phase decides, bound over its literal
    # with its checked type exactly as name resolution and type checking bound it
    val r_230: opt[comptime.NamedConst] = comptime.lookup_typed(ctx.scope.ctx, bare);
    if (!is_mut && d.data.bind.init != id.EXPR_NIL && comptime.is_case_literal(ctx.scope.a, d.data.bind.init) && sel r_230.none) {
        val res_bind: err[fail.Fail] = comptime.bind_typed(ctx.scope.ctx, bare,
            comptime.const_elem_value(d.data.bind.init::u32, context.decl_type_of(ctx, did)::u32));
        if (sel res_bind.err) { ret err[fail.Fail].err{res_bind.err}; }
    }

    val res_name: res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, global_export_of(ctx, did));
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    var is_embed: bool = false;
    var init_val: value.Value = value.const_int(0, gty);
    if (decl_has_decorator(ctx, d, "embed")) {
        val er: res[*embed.EmbedFile, fail.Fail] = embed_file_of(ctx, d);
        if (sel er.err) {
            ret err[fail.Fail].err{er.err};
        }
        val e: *embed.EmbedFile = er.ok;
        val bytes_r: res[*u8, fail.Fail] = copy_embed_bytes(ctx.m.alloc, e.bytes, e.len);
        if (sel bytes_r.err) { ret fail.discard[*u8](bytes_r); }
        init_val = value.const_bytes(bytes_r.ok, e.len, gty);
        is_embed = true;
    }
    or (d.data.bind.init != id.EXPR_NIL) {
        val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, d.data.bind.init, gty, bare);
        if (sel res_fold.err) {
            ret err[fail.Fail].err{res_fold.err};
        }
        init_val = res_fold.ok;
    }

    val res_align: res[u32, fail.Fail] = global_align_of(ctx, d);
    if (sel res_align.err) { ret err[fail.Fail].err{res_align.err}; }

    if ((d.flags & decl.DECL_FLAG_EXT) != 0) {
        var gx: ir.Global;
        gx.name      = name;
        gx.ty        = gty;
        gx.init      = value.const_int(0, gty);
        gx.is_mut    = is_mut;
        gx.is_pub    = false;
        gx.is_extern = true;
        gx.is_import = true;
        gx.is_local  = false;
        gx.is_embed  = false;
        gx.align     = res_align.ok;
        gx.section   = intern.STR_NIL;
        gx.iface     = ir.IFACE_NONE;
        gx.iface_a   = 0;
        gx.iface_b   = 0;
        gx.iface_flags = 0;
        val res_ext: res[u32, fail.Fail] = append_global(ctx, gx);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        ret err[fail.Fail].ok{};
    }

    var g: ir.Global;
    g.name      = name;
    g.ty        = gty;
    g.init      = init_val;
    g.is_mut    = is_mut;
    g.is_pub    = (d.flags & decl.DECL_FLAG_PUB) != 0;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = false;
    g.is_embed  = is_embed;
    g.align     = res_align.ok;
    g.section   = decl_section_of(ctx, d);
    g.iface     = ir.IFACE_NONE;
    g.iface_a   = 0;
    g.iface_b   = 0;
    g.iface_flags = 0;
    fill_iface_role(ctx, d, ?g);

    val res_idx: res[u32, fail.Fail] = append_global(ctx, g);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    ret err[fail.Fail].ok{};
}

fun copy_embed_bytes(alloc: *A.Allocator, bytes: *u8, len: u32) res[*u8, fail.Fail] {
    if (len == 0) { ret res[*u8, fail.Fail].ok{nil}; }
    val copied: res[*u8, A.Error] = A.allocate[u8](alloc, len::usize);
    if (sel copied.err) { ret res[*u8, fail.Fail].err{fail.refused(copied.err)}; }
    val out: *u8 = copied.ok;
    var i: u32 = 0;
    for (i < len) { out[i] = bytes[i]; i = i + 1; }
    ret res[*u8, fail.Fail].ok{out};
}

fun lower_weak_instance(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, name: intern.StrId, ret_sem: type.TypeId) err[fail.Fail] {
    if (d.data.fun_.body == id.STMT_NIL) { ret err[fail.Fail].ok{}; }

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: ir_type.IrTypeId = res_sig.ok;

    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = context.function_return_ir(ctx, did);
    if (sel res_ret_ir.err) { ret err[fail.Fail].err{res_ret_ir.err}; }
    val ret_ir: ir_type.IrTypeId = res_ret_ir.ok;

    val res_bare: res[intern.StrId, fail.Fail] = function_bare_name(ctx, d);
    if (sel res_bare.err) { ret err[fail.Fail].err{res_bare.err}; }
    val bare: intern.StrId = res_bare.ok;

    var flags: u32 = ir.FN_FLAG_PUB | ir.FN_FLAG_WEAK;
    if (decl_has_decorator(ctx, d, "inline")) { flags = flags | ir.FN_FLAG_INLINE; }
    if (decl_has_decorator(ctx, d, "noinline")) { flags = flags | ir.FN_FLAG_NOINLINE; }
    if (decl_has_decorator(ctx, d, "oblivious")) { flags = flags | ir.FN_FLAG_OBLIVIOUS; }
    if (decl_has_decorator(ctx, d, "scalar")) { flags = flags | ir.FN_FLAG_SCALAR; }
    if (decl_has_decorator(ctx, d, "naked")) { flags = flags | ir.FN_FLAG_NAKED; }
    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, flags, d.data.fun_.params_len);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    publish_function_debug(ctx, fn_index, bare, ret_sem);

    val res_ty: err[fail.Fail] = reinfer_instance_typing(ctx, d, context.decl_ret_sem(ctx, did));
    if (sel res_ty.err) { ret res_ty; }

    ret emit_function_body(ctx, did, d, fn_index, ret_ir, ret_sem);
}

fun function_bare_name(ctx: *context.LowerContext, d: *decl.Decl) res[intern.StrId, fail.Fail] {
    val r_70583: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, context.module_source(ctx), d.data.fun_.name);
    if (sel r_70583.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_70583.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_70583.ok};
}

fun publish_function_debug(ctx: *context.LowerContext, fn_index: u32,
                           bare: intern.StrId, ret_sem: type.TypeId) {
    ctx.m.functions[fn_index].disp    = bare;
    ctx.m.functions[fn_index].ret_sem = ret_sem;
}

fun emit_function_body(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, fn_index: u32, ret_ir: ir_type.IrTypeId, ret_sem: type.TypeId) err[fail.Fail] {
    context.begin_function(ctx, fn_index, ret_ir);
    ctx.fn_ret_sem = ret_sem;
    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_entry.err) { ret err[fail.Fail].err{res_entry.err}; }
    builder.set_block(?ctx.builder, res_entry.ok);

    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, d.span.offset));

    val res_params: err[fail.Fail] = lower_params(ctx, did, d, fn_index);
    if (sel res_params.err) { ret res_params; }

    if (d.data.fun_.body != id.STMT_NIL) {
        val res_body: err[fail.Fail] = stmt.lower_stmt(ctx, d.data.fun_.body);
        if (sel res_body.err) { ret res_body; }
    }

    ret close_function(ctx, ret_ir);
}

fun clear_pack_state(ctx: *context.LowerContext) {
    if (ctx.pack_slots != nil && ctx.pack_len > 0) {
        A.deallocate[value.Value](ctx.s.alloc, ctx.pack_slots, ctx.pack_len::usize);
    }
    ctx.pack_slots    = nil;
    ctx.pack_types    = nil;
    ctx.pack_len      = 0;
    ctx.pack_ret_type = type.TYPE_NIL;
}

fun lower_pack_params(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, fn_index: u32,
                      fixed_count: u32, types: *type.TypeId, type_len: u32) err[fail.Fail] {
    val res_xty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_xty.err) { ret err[fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    val total: u32 = fixed_count + type_len;
    var params: *value.Value = nil;
    if (total > 0) {
        val res_params: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, total::usize);
        if (sel res_params.err) { ret err[fail.Fail].err{fail.refused(res_params.err)}; }
        params = res_params.ok;
    }

    var slots: *value.Value = nil;
    if (type_len > 0) {
        val res_slots: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, type_len::usize);
        if (sel res_slots.err) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, total::usize); }
            ret err[fail.Fail].err{fail.refused(res_slots.err)};
        }
        slots = res_slots.ok;
    }

    var i: u32 = 0;
    for (i < total) {
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < ctx.scope.a.typed_name_len) {
                p_sem = context.type_resolved_of(ctx, ctx.scope.a.typed_names[pool_ix].ty);
            }
        }
        or {
            p_sem = types[i - fixed_count];
        }

        val res_slot: res[value.Value, fail.Fail] = emit_pack_param(ctx, params, i, p_sem, xty);
        if (sel res_slot.err) {
            free_pack_param_bufs(ctx, params, total, slots, type_len);
            ret err[fail.Fail].err{res_slot.err};
        }
        val slot: value.Value = res_slot.ok;

        if (i < fixed_count) {
            val sid: resolve.SymbolId = param_symbol(ctx, did, i);
            if (sid != resolve.SYMBOL_NIL) {
                val res_bind: err[fail.Fail] = context.bind_local(ctx, sid, slot, context.type_carries_secret(ctx, p_sem));
                if (sel res_bind.err) {
                    free_pack_param_bufs(ctx, params, total, slots, type_len);
                    ret res_bind;
                }
            }
        }
        or {
            slots[i - fixed_count] = slot;
        }
        i = i + 1;
    }

    ctx.m.functions[fn_index].params      = params;
    ctx.m.functions[fn_index].param_count = total;
    ctx.pack_slots = slots;
    ret err[fail.Fail].ok{};
}

fun emit_pack_param(ctx: *context.LowerContext, params: *value.Value, w: u32, p_sem: type.TypeId, xty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val res_p_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, p_sem);
    if (sel res_p_ir.err) { ret res[value.Value, fail.Fail].err{res_p_ir.err}; }
    val p_ir: ir_type.IrTypeId = res_p_ir.ok;

    var pval: value.Value = value.param(w, p_ir);
    if (context.type_contains_secret(ctx, p_sem)) { pval.secret = true; }

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, p_ir, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, pval, slot);
    if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
    if (expr.type_is_volatile_record(ctx, p_sem)) { builder.mark_last_volatile(?ctx.builder); }

    params[w] = pval;
    ret res[value.Value, fail.Fail].ok{slot};
}

fun free_pack_param_bufs(ctx: *context.LowerContext, params: *value.Value, total: u32, slots: *value.Value, type_len: u32) {
    if (params != nil && total > 0)   { A.deallocate[value.Value](ctx.s.alloc, params, total::usize); }
    if (slots != nil && type_len > 0) { A.deallocate[value.Value](ctx.s.alloc, slots, type_len::usize); }
}

fun diag_named(ctx: *context.LowerContext, span: token.Span, name_id: intern.StrId, prefix: str, suffix: str, fallback: str) err[fail.Fail] {
    fail.reject(?ctx.status);
    val opt_name: opt[str] = intern.lookup_typed(?ctx.s.interner, name_id);
    if (sel opt_name.none) {
        ret fail.lift_err(diagnostic.error(ctx.diags, ctx.scope.a.file_id, span, fallback));
    }
    val name: str = opt_name.some;

    val res_msg: res[str, string.StrError] = str_join(ctx.s.alloc, prefix, name, suffix);
    if (sel res_msg.err) {
        ret err[fail.Fail].err{fail.str_refused(res_msg.err)};
    }
    val buf: str = res_msg.ok;

    val res_emit: R.Result[R.Void, str] = diagnostic.error(ctx.diags, ctx.scope.a.file_id, span, buf);
    A.deallocate[u8](ctx.s.alloc, buf::*u8, str_len(buf) + 1);
    ret fail.lift_err(res_emit);
}


fun lower_test(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl) err[fail.Fail] {
    val res_i32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 32);
    if (sel res_i32.err) { ret err[fail.Fail].err{res_i32.err}; }
    val ret_type: ir_type.IrTypeId = res_i32.ok;

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?ctx.m.types, ret_type, nil, 0, false);
    if (sel res_sig.err) { ret err[fail.Fail].err{res_sig.err}; }
    val sig: ir_type.IrTypeId = res_sig.ok;

    val res_bare: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, context.module_source(ctx), d.data.test_.label);
    if (sel res_bare.err) { ret err[fail.Fail].err{fail.refused(res_bare.err)}; }
    val bare: intern.StrId = res_bare.ok;

    val res_name: res[intern.StrId, fail.Fail] = mangle.linkage_name(ctx.s, ctx.scope.fqn, bare, opt[intern.StrId].none{});
    if (sel res_name.err) { ret err[fail.Fail].err{res_name.err}; }
    val name: intern.StrId = res_name.ok;

    val r_522: opt[u32] = ir.function_lookup(ctx.m, name);
    if (sel r_522.some) {
        ret diag_named(ctx, d.data.test_.label, bare,
            "duplicate test label ", " in this module",
            "duplicate test label in this module");
    }

    val res_idx: res[u32, fail.Fail] = append_function(ctx, name, sig, ir.FN_FLAG_TEST, 0);
    if (sel res_idx.err) { ret err[fail.Fail].err{res_idx.err}; }
    val fn_index: u32 = res_idx.ok;

    var label_span: token.Span = d.data.test_.label;
    if (label_span.len >= 2::usize) {
        label_span.offset = label_span.offset + 1::usize;
        label_span.len    = label_span.len - 2::usize;
    }
    val res_disp: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, context.module_source(ctx), label_span);
    if (sel res_disp.err) { ret err[fail.Fail].err{fail.refused(res_disp.err)}; }
    ctx.m.functions[fn_index].label = res_disp.ok;

    val opt_sf: O.Option[*source.SourceFile] = source.get(?ctx.s.sources, ctx.scope.a.file_id);
    if (O.is_some[*source.SourceFile](opt_sf)) {
        val pos: source.Position = source.position(O.unwrap[*source.SourceFile](opt_sf), d.data.test_.label.offset);
        ctx.m.functions[fn_index].line = pos.line::u32;
    }

    ret emit_test_body(ctx, d, fn_index, ret_type);
}

fun emit_test_body(ctx: *context.LowerContext, d: *decl.Decl, fn_index: u32, ret_type: ir_type.IrTypeId) err[fail.Fail] {
    context.begin_function(ctx, fn_index, ret_type);
    builder.set_function(?ctx.builder, ?ctx.m.functions[fn_index]);

    val res_entry: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_entry.err) { ret err[fail.Fail].err{res_entry.err}; }
    builder.set_block(?ctx.builder, res_entry.ok);

    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, d.span.offset));

    if (d.data.test_.body != id.STMT_NIL) {
        val res_body: err[fail.Fail] = stmt.lower_stmt(ctx, d.data.test_.body);
        if (sel res_body.err) { ret res_body; }
    }

    ret close_function(ctx, ret_type);
}

fun lower_params(ctx: *context.LowerContext, did: id.DeclId, d: *decl.Decl, fn_index: u32) err[fail.Fail] {
    val count: u32 = d.data.fun_.params_len;

    val res_ity: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ctx.m.types);
    if (sel res_ity.err) { ret err[fail.Fail].err{res_ity.err}; }
    val ity: ir_type.IrTypeId = res_ity.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_xty.err) { ret err[fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    var rt_count: u32 = 0;
    var pi: u32 = 0;
    for (pi < count) {
        val pool_ix: u32 = d.data.fun_.params_start + pi;
        if (pool_ix::usize >= ctx.scope.a.typed_name_len || !ctx.scope.a.typed_names[pool_ix].comptime) {
            rt_count = rt_count + 1;
        }
        pi = pi + 1;
    }

    var params: *value.Value = nil;
    if (rt_count > 0) {
        val res_params: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, rt_count::usize);
        if (sel res_params.err) { ret err[fail.Fail].err{fail.refused(res_params.err)}; }
        params = res_params.ok;
    }

    var w: u32 = 0;
    var i: u32 = 0;
    for (i < count) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize < ctx.scope.a.typed_name_len && ctx.scope.a.typed_names[pool_ix].comptime) {
            i = i + 1;
            cnt;
        }
        var p_ir:  ir_type.IrTypeId = ity;
        var p_sem: type.TypeId      = type.TYPE_NIL;
        if (pool_ix::usize < ctx.scope.a.typed_name_len) {
            val tn: *decl.TypedName = ?ctx.scope.a.typed_names[pool_ix];
            p_sem = context.type_resolved_of(ctx, tn.ty);
            val res_p_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, p_sem);
            if (sel res_p_ir.err) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret err[fail.Fail].err{res_p_ir.err};
            }
            p_ir = res_p_ir.ok;
        }
        var pval: value.Value = value.param(w, p_ir);
        if (context.type_contains_secret(ctx, p_sem)) { pval.secret = true; }
        params[w] = pval;

        val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, p_ir, value.const_int(1, xty));
        if (sel res_slot.err) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
            ret err[fail.Fail].err{res_slot.err};
        }
        val slot: value.Value = res_slot.ok;
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, pval, slot);
        if (sel res_store.err) {
            if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
            ret res_store;
        }
        if (expr.type_is_volatile_record(ctx, p_sem)) { builder.mark_last_volatile(?ctx.builder); }

        val sid: resolve.SymbolId = param_symbol(ctx, did, i);
        if (sid != resolve.SYMBOL_NIL) {
            val res_bind: err[fail.Fail] = context.bind_local(ctx, sid, slot, context.type_carries_secret(ctx, p_sem));
            if (sel res_bind.err) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret res_bind;
            }
        }

        if (ctx.debug && pool_ix::usize < ctx.scope.a.typed_name_len) {
            val p_sem: type.TypeId = context.type_resolved_of(ctx, ctx.scope.a.typed_names[pool_ix].ty);
            val res_dbg: err[fail.Fail] = context.emit_dbg_birth(ctx, ctx.scope.a.typed_names[pool_ix].name, p_ir, p_sem, true, pval, opt[value.Value].none{});
            if (sel res_dbg.err) {
                if (params != nil) { A.deallocate[value.Value](ctx.s.alloc, params, rt_count::usize); }
                ret res_dbg;
            }
        }

        w = w + 1;
        i = i + 1;
    }

    ctx.m.functions[fn_index].params      = params;
    ctx.m.functions[fn_index].param_count = rt_count;
    ret err[fail.Fail].ok{};
}

fun close_function(ctx: *context.LowerContext, ret_ir: ir_type.IrTypeId) err[fail.Fail] {
    if (!context.block_terminated(ctx) && !cursor_block_unreachable(ctx)) {
        val res_term: err[fail.Fail] = emit_default_terminator(ctx, ret_ir);
        if (sel res_term.err) { ret res_term; }
    }
    ret terminate_orphan_blocks(ctx);
}

fun cursor_block_unreachable(ctx: *context.LowerContext) bool {
    if (ctx.builder.fn == nil) { ret false; }
    val fn: *ir.Function = ctx.builder.fn;
    val b: ir.BlockId = ctx.builder.block;
    if (b == ir.BLOCK_NIL)   { ret false; }
    if (b >= fn.block_count) { ret false; }
    if (b == 0)              { ret false; }
    ret fn.blocks[b].pred_count == 0;
}

fun emit_default_terminator(ctx: *context.LowerContext, ret_ir: ir_type.IrTypeId) err[fail.Fail] {
    if ((ctx.m.functions[ctx.fn_index].flags & ir.FN_FLAG_NORETURN) != 0) {
        ret builder.emit_unreachable(?ctx.builder);
    }
    if (context.is_void_ir(ctx, ret_ir)) {
        ret builder.emit_ret_void(?ctx.builder);
    }

    val res_zero: res[value.Value, fail.Fail] = default_return_value(ctx, ret_ir);
    if (sel res_zero.err) {
        ret err[fail.Fail].err{res_zero.err};
    }
    ret builder.emit_ret(?ctx.builder, res_zero.ok);
}

fun default_return_value(ctx: *context.LowerContext, ret_ir: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (ir_type.is_float_scalar(?ctx.m.types, ret_ir)) {
        ret res[value.Value, fail.Fail].ok{value.const_float(0.0, ret_ir)};
    }
    if (!ir_type.is_aggregate(?ctx.m.types, ret_ir)) {
        ret res[value.Value, fail.Fail].ok{value.const_int(0, ret_ir)};
    }

    val res_count_ty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_count_ty.err) {
        ret res[value.Value, fail.Fail].err{res_count_ty.err};
    }
    val count_ty: ir_type.IrTypeId = res_count_ty.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, ret_ir, value.const_int(1, count_ty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, ret_ir);
    if (sel res_mz.err) {
        ret res[value.Value, fail.Fail].err{res_mz.err};
    }
    ret res[value.Value, fail.Fail].ok{slot};
}

fun terminate_orphan_blocks(ctx: *context.LowerContext) err[fail.Fail] {
    if (ctx.builder.fn == nil) { ret err[fail.Fail].ok{}; }
    val fn: *ir.Function = ctx.builder.fn;
    var i: u32 = 0;
    for (i < fn.block_count) {
        if (fn.blocks[i].terminator == ir.INSTR_NIL) {
            builder.set_block(?ctx.builder, i::ir.BlockId);
            val res_unreachable: err[fail.Fail] = builder.emit_unreachable(?ctx.builder);
            if (sel res_unreachable.err) { ret res_unreachable; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun fold_global_init(ctx: *context.LowerContext, eid: id.ExprId, gty: ir_type.IrTypeId, name: intern.StrId) res[value.Value, fail.Fail] {
    val folded: res[value.Value, fail.Fail] = fold_global_value(ctx, eid, gty, name);
    if (sel ctx.status.kind.internal) { ret res[value.Value, fail.Fail].err{fail.phase_failure(ctx.status)}; }
    if (sel folded.err) {
        val failure: fail.Fail = folded.err;
        if (sel failure.reported) { if (sel ctx.status.kind.accepted) { fail.reject(?ctx.status); } }
        or { fail.internal(?ctx.status, fail.describe(failure)); }
    }
    ret folded;
}

fun fold_global_value(ctx: *context.LowerContext, eid: id.ExprId, gty: ir_type.IrTypeId, name: intern.StrId) res[value.Value, fail.Fail] {
    if (is_null_init(ctx, eid)) { ret res[value.Value, fail.Fail].ok{value.const_null(gty)}; }

    val res_agg: res[opt[value.Value], fail.Fail] = constagg.try_const_aggregate(ctx, eid, gty);
    if (sel res_agg.err) { ret res[value.Value, fail.Fail].err{res_agg.err}; }
    val opt_agg: opt[value.Value] = res_agg.ok;
    if (sel opt_agg.some) { ret res[value.Value, fail.Fail].ok{opt_agg.some}; }

    val evaluated: res[comptime.CTValue, comptime.EvalFail] = try_comptime(ctx, eid);
    if (sel evaluated.ok) {
        val cv: comptime.CTValue = evaluated.ok;
        val converted: res[value.Value, fail.Fail] = expr.const_value_of_init(ctx, eid, cv);
        if (sel converted.err) { ret converted; }
        val r_755: opt[comptime.NamedConst] = comptime.lookup_typed(ctx.scope.ctx, name);
        if (name != intern.STR_NIL && sel r_755.none) {
            val res_bind: err[fail.Fail] = comptime.bind_typed(ctx.scope.ctx, name, cv);
            if (sel res_bind.err) { ret res[value.Value, fail.Fail].err{res_bind.err}; }
        }
        ret converted;
    }

    val eval_failure: comptime.EvalFail = evaluated.err;
    if (eval_failure.kind == comptime.EVAL_FAIL_INTERNAL) {
        ret res[value.Value, fail.Fail].err{fail.message(eval_failure.message)};
    }

    val opt_init: res[aexpr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel opt_init.err) { ret res[value.Value, fail.Fail].err{opt_init.err}; }
    var ie_value: aexpr.Expr = opt_init.ok;
    val ie: *aexpr.Expr = ?ie_value;

    if (ie.kind == aexpr.EXPR_KIND_CALL) {
        val opt_intr: opt[res[value.Value, fail.Fail]] = expr.try_lower_comptime_intrinsic(ctx, eid, ie);
        if (sel opt_intr.some) { ret opt_intr.some; }
    }

    if (eval_failure.kind == comptime.EVAL_FAIL_REJECTED) {
        fail.reject(?ctx.status);
        val reported: R.Result[R.Void, str] = diagnostic.error(ctx.diags, ctx.scope.a.file_id, ie.span, eval_failure.message);
        if (R.is_err[R.Void, str](reported)) { ret res[value.Value, fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](reported))}; }
    }
    or (eval_failure.kind == comptime.EVAL_FAIL_UNBOUND || eval_failure.kind == comptime.EVAL_FAIL_NEEDS_MEMBER
        || eval_failure.kind == comptime.EVAL_FAIL_NEEDS_TYPES || eval_failure.kind == comptime.EVAL_FAIL_NEEDS_LAYOUT) {
        val reported: err[fail.Fail] = diag_named(ctx, ie.span, name,
            "global initialiser of `", "` must be a constant expression", "a global initialiser must be a constant expression");
        if (sel reported.err) { ret res[value.Value, fail.Fail].err{reported.err}; }
    }
    or { ret res[value.Value, fail.Fail].err{fail.message("lower: invalid comptime evaluation failure kind")}; }
    ret res[value.Value, fail.Fail].err{fail.reported()};
}

fun is_null_init(ctx: *context.LowerContext, eid: id.ExprId) bool {
    var cur: id.ExprId = eid;
    for (true) {
        val opt_expr: res[aexpr.Expr, fail.Fail] = context.expression(ctx, cur);
        if (sel opt_expr.err) { ret false; }
        var e_value: aexpr.Expr = opt_expr.ok;
        val e: *aexpr.Expr = ?e_value;
        if (e.kind == aexpr.EXPR_KIND_LIT_NIL) { ret true; }
        if (e.kind != aexpr.EXPR_KIND_CAST)    { ret false; }
        cur = e.data.cast.value;
    }
    ret false;
}

fun lower_comptime_if(ctx: *context.LowerContext, d: *decl.Decl) err[fail.Fail] {
    val txt: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.data.comptime_if.branches_len) {
        val branch_ix: u32 = d.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branch_len) {
            ret err[fail.Fail].err{fail.message("lower: comptime branch index out of range")};
        }
        val branch: *decl.ComptimeBranch = ?ctx.scope.a.comptime_branches[branch_ix];

        var active: bool = false;
        if (branch.cond == id.EXPR_NIL) {
            active = true;
        }
        or {
            val active_r: res[bool, fail.Fail] = context.gate_is_active(ctx, txt, branch.cond, comptime.GATE_SCOPE_DECL, true);
            if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
            active = active_r.ok;
        }

        if (active) {
            var ii: u32 = 0;
            for (ii < branch.body_len) {
                val pool_ix: u32 = branch.body_start + ii;
                if (pool_ix::usize >= ctx.scope.a.decl_id_len) {
                    ret err[fail.Fail].err{fail.message("lower: comptime decl body index out of range")};
                }
                val res_decl: err[fail.Fail] = lower_decl(ctx, ctx.scope.a.decl_ids[pool_ix]);
                if (sel res_decl.err) { ret res_decl; }
                ii = ii + 1;
            }
            ret err[fail.Fail].ok{};
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun decl_has_decorator(ctx: *context.LowerContext, d: *decl.Decl, name: str) bool {
    val src: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?ctx.scope.a.decorators[d.decorators_start + i];
        if (str_region_equals(src, dec.name.offset, dec.name.len, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun fill_iface_role(ctx: *context.LowerContext, d: *decl.Decl, g: *ir.Global) {
    if (decl_has_decorator(ctx, d, "input")) {
        g.iface   = ir.IFACE_INPUT;
        g.iface_a = decorator_uint(ctx, d, "input", 0, 0);
        ret;
    }
    if (decl_has_decorator(ctx, d, "output")) {
        g.iface   = ir.IFACE_OUTPUT;
        g.iface_a = decorator_uint(ctx, d, "output", 0, 0);
        ret;
    }
    if (decl_has_decorator(ctx, d, "builtin")) {
        g.iface   = ir.IFACE_BUILTIN;
        g.iface_a = decl_builtin_of(ctx, d);
        ret;
    }
    if (decl_has_decorator(ctx, d, "uniform")) {
        g.iface   = ir.IFACE_UNIFORM;
        g.iface_a = decorator_uint(ctx, d, "uniform", 0, 0);
        g.iface_b = decorator_uint(ctx, d, "uniform", 1, 0);
        ret;
    }
    if (decl_has_decorator(ctx, d, "storage")) {
        g.iface   = ir.IFACE_STORAGE;
        g.iface_a = decorator_uint(ctx, d, "storage", 0, 0);
        g.iface_b = decorator_uint(ctx, d, "storage", 1, 0);
        g.iface_flags = decl_storage_flags(ctx, d);
        ret;
    }
    if (decl_has_decorator(ctx, d, "sampler")) {
        g.iface   = ir.IFACE_SAMPLER;
        g.iface_a = decorator_uint(ctx, d, "sampler", 0, 0);
        g.iface_b = decorator_uint(ctx, d, "sampler", 1, 0);
    }
}

fun decl_storage_flags(ctx: *context.LowerContext, d: *decl.Decl) u32 {
    val src: str = context.module_source(ctx);
    var flags: u32 = 0;
    var ord: u32 = 2;
    for (true) {
        val opt_arg: opt[id.ExprId] = decorator_arg_eid(ctx, d, "storage", ord);
        if (sel opt_arg.none) { ret flags; }
        val opt_val: res[aexpr.Expr, fail.Fail] = context.expression(ctx, opt_arg.some);
        if (sel opt_val.err) { ret flags; }
        var ve_value: aexpr.Expr = opt_val.ok;
        val ve: *aexpr.Expr = ?ve_value;
        if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret flags; }
        val off: usize = ve.span.offset + 1::usize;
        val len: usize = ve.span.len - 2::usize;
        if (str_region_equals(src, off, len, "readonly")) { flags = flags | ir.IFACE_FLAG_READONLY; }
        ord = ord + 1;
    }
    ret flags;
}

fun decl_builtin_of(ctx: *context.LowerContext, d: *decl.Decl) u32 {
    val opt_arg: opt[id.ExprId] = decorator_arg_eid(ctx, d, "builtin", 0);
    if (sel opt_arg.none) { ret ir.BUILTIN_POSITION; }
    val opt_val: res[aexpr.Expr, fail.Fail] = context.expression(ctx, opt_arg.some);
    if (sel opt_val.err) { ret ir.BUILTIN_POSITION; }
    var ve_value: aexpr.Expr = opt_val.ok;
    val ve: *aexpr.Expr = ?ve_value;
    if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret ir.BUILTIN_POSITION; }
    val src: str = context.module_source(ctx);
    val off: usize = ve.span.offset + 1::usize;
    val len: usize = ve.span.len - 2::usize;
    if (str_region_equals(src, off, len, "position"))          { ret ir.BUILTIN_POSITION; }
    if (str_region_equals(src, off, len, "vertex_index"))      { ret ir.BUILTIN_VERTEX_INDEX; }
    if (str_region_equals(src, off, len, "instance_index"))    { ret ir.BUILTIN_INSTANCE_INDEX; }
    if (str_region_equals(src, off, len, "frag_coord"))        { ret ir.BUILTIN_FRAG_COORD; }
    if (str_region_equals(src, off, len, "point_size"))        { ret ir.BUILTIN_POINT_SIZE; }
    if (str_region_equals(src, off, len, "global_invocation")) { ret ir.BUILTIN_GLOBAL_INVOCATION; }
    if (str_region_equals(src, off, len, "local_invocation"))  { ret ir.BUILTIN_LOCAL_INVOCATION; }
    if (str_region_equals(src, off, len, "workgroup_id"))      { ret ir.BUILTIN_WORKGROUP_ID; }
    ret ir.BUILTIN_POSITION;
}

fun decorator_uint(ctx: *context.LowerContext, d: *decl.Decl, name: str, ord: u32, dflt: u32) u32 {
    val opt_arg: opt[id.ExprId] = decorator_arg_eid(ctx, d, name, ord);
    if (sel opt_arg.none) { ret dflt; }
    val res_u64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret dflt; }
    val u64t: ir_type.IrTypeId = res_u64.ok;
    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, opt_arg.some, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret dflt; }
    val v: value.Value = res_fold.ok;
    if (v.kind != value.VAL_CONST_INT) { ret dflt; }
    if (v.data.int_lit > 0xFFFFFFFF) { ret dflt; }
    ret v.data.int_lit::u32;
}

fun decl_stage_of(ctx: *context.LowerContext, d: *decl.Decl) u8 {
    val opt_arg: opt[id.ExprId] = decorator_arg_eid(ctx, d, "stage", 0);
    if (sel opt_arg.none) { ret ir.STAGE_NONE; }
    val opt_val: res[aexpr.Expr, fail.Fail] = context.expression(ctx, opt_arg.some);
    if (sel opt_val.err) { ret ir.STAGE_NONE; }
    var ve_value: aexpr.Expr = opt_val.ok;
    val ve: *aexpr.Expr = ?ve_value;
    if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret ir.STAGE_NONE; }
    val src: str = context.module_source(ctx);
    val off: usize = ve.span.offset + 1::usize;
    val len: usize = ve.span.len - 2::usize;
    if (str_region_equals(src, off, len, "vertex"))   { ret ir.STAGE_VERTEX; }
    if (str_region_equals(src, off, len, "fragment")) { ret ir.STAGE_FRAGMENT; }
    if (str_region_equals(src, off, len, "compute"))  { ret ir.STAGE_COMPUTE; }
    ret ir.STAGE_NONE;
}

fun decl_workgroup_dim(ctx: *context.LowerContext, d: *decl.Decl, ord: u32) u32 {
    val opt_arg: opt[id.ExprId] = decorator_arg_eid(ctx, d, "workgroup", ord);
    if (sel opt_arg.none) { ret 1; }
    val res_u64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret 1; }
    val u64t: ir_type.IrTypeId = res_u64.ok;
    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, opt_arg.some, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret 1; }
    val v: value.Value = res_fold.ok;
    if (v.kind != value.VAL_CONST_INT) { ret 1; }
    if (v.data.int_lit == 0 || v.data.int_lit > 0xFFFFFFFF) { ret 1; }
    ret v.data.int_lit::u32;
}

fun decl_section_of(ctx: *context.LowerContext, d: *decl.Decl) intern.StrId {
    val opt_arg: opt[id.ExprId] = decorator_arg_eid(ctx, d, "section", 0);
    if (sel opt_arg.none) { ret intern.STR_NIL; }
    val opt_val: res[aexpr.Expr, fail.Fail] = context.expression(ctx, opt_arg.some);
    if (sel opt_val.err) { ret intern.STR_NIL; }
    var ve_value: aexpr.Expr = opt_val.ok;
    val ve: *aexpr.Expr = ?ve_value;
    if (ve.kind != aexpr.EXPR_KIND_LIT_STR || ve.span.len < 2::usize) { ret intern.STR_NIL; }

    var inner: token.Span = ve.span;
    inner.offset = inner.offset + 1::usize;
    inner.len    = inner.len - 2::usize;

    val res_section: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, context.module_source(ctx), inner);
    if (sel res_section.err) { ret intern.STR_NIL; }
    ret res_section.ok;
}

fun embed_file_of(ctx: *context.LowerContext, d: *decl.Decl) res[*embed.EmbedFile, fail.Fail] {
    val opt_dec: opt[*decl.Decorator] = decorator_named(ctx, d, "embed");
    if (sel opt_dec.none) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed declaration lost its decorator before lowering")};
    }

    val opt_span: O.Option[token.Span] = embed.path_arg_span(ctx.scope.a, opt_dec.some);
    if (O.is_none[token.Span](opt_span)) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed declaration has a malformed path after sema")};
    }

    val opt_file: O.Option[*source.SourceFile] = source.get(?ctx.s.sources, ctx.scope.a.file_id);
    if (O.is_none[*source.SourceFile](opt_file)) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed declaration's source file is unavailable during lowering")};
    }
    val f: *source.SourceFile = O.unwrap[*source.SourceFile](opt_file);
    if (f.path == nil) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed declaration's source file has no on-disk path during lowering")};
    }

    val ir: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, context.module_source(ctx), O.unwrap[token.Span](opt_span));
    if (sel ir.err) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.refused(ir.err)};
    }
    val opt_arg: opt[str] = intern.lookup_typed(?ctx.s.interner, ir.ok);
    if (sel opt_arg.none) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed path disappeared from the interner during lowering")};
    }

    val pr: R.Result[str, manifest.TemplateError] = embed.resolve_arg(ctx.s.alloc, ?ctx.s.embeds, f.path, opt_arg.some);
    if (R.is_err[str, manifest.TemplateError](pr)) {
        val e: manifest.TemplateError = R.unwrap_err[str, manifest.TemplateError](pr);
        if (sel e.internal) { ret res[*embed.EmbedFile, fail.Fail].err{fail.message(e.internal)}; }
        manifest.template_error_dnit(ctx.s.alloc, e);
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed path became invalid after successful sema")};
    }
    val resolved: str = R.unwrap_ok[str, manifest.TemplateError](pr);

    val pid_r: res[intern.StrId, A.Error] = intern.intern_typed(?ctx.s.interner, resolved);
    str_free(ctx.s.alloc, resolved);
    if (sel pid_r.err) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.refused(pid_r.err)};
    }

    val opt_e: O.Option[*embed.EmbedFile] = embed.get(?ctx.s.embeds, pid_r.ok);
    if (O.is_none[*embed.EmbedFile](opt_e)) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry is unavailable during lowering")};
    }
    val e: *embed.EmbedFile = O.unwrap[*embed.EmbedFile](opt_e);
    if (e.status != embed.EMBED_OK) {
        ret res[*embed.EmbedFile, fail.Fail].err{fail.message("embed cache entry changed after successful sema")};
    }
    ret res[*embed.EmbedFile, fail.Fail].ok{e};
}

fun decorator_named(ctx: *context.LowerContext, d: *decl.Decl, name: str) opt[*decl.Decorator] {
    val src: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?ctx.scope.a.decorators[d.decorators_start + i];
        if (str_region_equals(src, dec.name.offset, dec.name.len, name)) { ret opt[*decl.Decorator].some{dec}; }
        i = i + 1;
    }
    ret opt[*decl.Decorator].none{};
}

fun decorator_arg_eid(ctx: *context.LowerContext, d: *decl.Decl, name: str, ord: u32) opt[id.ExprId] {
    val src: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?ctx.scope.a.decorators[d.decorators_start + i];
        if (str_region_equals(src, dec.name.offset, dec.name.len, name)) {
            if (ord >= dec.args_len) { ret opt[id.ExprId].none{}; }
            ret opt[id.ExprId].some{ctx.scope.a.expr_ids[dec.args_start + ord]};
        }
        i = i + 1;
    }
    ret opt[id.ExprId].none{};
}

fun global_align_of(ctx: *context.LowerContext, d: *decl.Decl) res[u32, fail.Fail] {
    val opt_arg: opt[id.ExprId] = decorator_arg_eid(ctx, d, "align", 0);
    if (sel opt_arg.none) { ret res[u32, fail.Fail].ok{0}; }
    val arg: id.ExprId = opt_arg.some;

    val res_u64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_u64.err) { ret res[u32, fail.Fail].err{res_u64.err}; }
    val u64t: ir_type.IrTypeId = res_u64.ok;

    val res_fold: res[value.Value, fail.Fail] = fold_global_init(ctx, arg, u64t, intern.STR_NIL);
    if (sel res_fold.err) { ret res[u32, fail.Fail].err{res_fold.err}; }
    val v: value.Value = res_fold.ok;
    if (v.kind != value.VAL_CONST_INT) {
        fail.reject(?ctx.status);
        val res_diag: R.Result[R.Void, str] = diagnostic.error(ctx.diags, ctx.scope.a.file_id, d.data.bind.name, "`align` decorator requires an integer argument");
        if (R.is_err[R.Void, str](res_diag)) { ret res[u32, fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](res_diag))}; }
        ret res[u32, fail.Fail].err{fail.reported()};
    }

    val n: u64 = v.data.int_lit;
    if (n == 0 || (n & (n - 1)) != 0) {
        fail.reject(?ctx.status);
        val res_diag: R.Result[R.Void, str] = diagnostic.error(ctx.diags, ctx.scope.a.file_id, d.data.bind.name, "`align` value must be a non-zero power of two");
        if (R.is_err[R.Void, str](res_diag)) { ret res[u32, fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](res_diag))}; }
        ret res[u32, fail.Fail].err{fail.reported()};
    }
    if (n > 0xFFFFFFFF) {
        fail.reject(?ctx.status);
        val res_diag: R.Result[R.Void, str] = diagnostic.error(ctx.diags, ctx.scope.a.file_id, d.data.bind.name, "`align` value exceeds the maximum alignment");
        if (R.is_err[R.Void, str](res_diag)) { ret res[u32, fail.Fail].err{fail.message(R.unwrap_err[R.Void, str](res_diag))}; }
        ret res[u32, fail.Fail].err{fail.reported()};
    }
    ret res[u32, fail.Fail].ok{n::u32};
}

fun append_function(ctx: *context.LowerContext, name: intern.StrId, sig: ir_type.IrTypeId, flags: u32, param_hint: u32) res[u32, fail.Fail] {
    val m: *ir.Module = ctx.m;

    val existing: opt[u32] = ir.function_lookup(m, name);
    if (sel existing.some) {
        val ei: u32 = existing.some;
        if ((m.functions[ei].flags & ir.FN_FLAG_EXTERN) != 0) {
            m.functions[ei].sig   = sig;
            m.functions[ei].flags = flags;
            ret res[u32, fail.Fail].ok{ei};
        }
    }

    if (m.function_len == m.function_cap) {
        val new_cap: u32 = m.function_cap * 2;
        val res_grow: res[*ir.Function, A.Error] = A.reallocate[ir.Function](m.alloc, m.functions, m.function_cap::usize, new_cap::usize);
        if (sel res_grow.err) { ret res[u32, fail.Fail].err{fail.refused(res_grow.err)}; }
        m.functions    = res_grow.ok;
        m.function_cap = new_cap;
    }

    val idx: u32 = m.function_len;
    m.functions[idx] = ir.function_new(m.alloc, name, sig, flags);
    m.function_len   = m.function_len + 1;
    val res_reg: err[fail.Fail] = ir.function_register(m, name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }
    ret res[u32, fail.Fail].ok{idx};
}

fun append_global(ctx: *context.LowerContext, g: ir.Global) res[u32, fail.Fail] {
    val m: *ir.Module = ctx.m;
    if (m.global_len == m.global_cap) {
        val new_cap: u32 = m.global_cap * 2;
        val res_grow: res[*ir.Global, A.Error] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, new_cap::usize);
        if (sel res_grow.err) { ret res[u32, fail.Fail].err{fail.refused(res_grow.err)}; }
        m.globals    = res_grow.ok;
        m.global_cap = new_cap;
    }
    val idx: u32 = m.global_len;
    m.globals[idx] = g;
    m.global_len   = m.global_len + 1;
    val res_reg: err[fail.Fail] = ir.global_register(m, g.name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }
    ret res[u32, fail.Fail].ok{idx};
}

fun param_symbol(ctx: *context.LowerContext, fun_did: id.DeclId, index: u32) resolve.SymbolId {
    ret resolve.param_symbol(ctx.scope.rr, fun_did, index);
}

fun try_comptime(ctx: *context.LowerContext, eid: id.ExprId) res[comptime.CTValue, comptime.EvalFail] {
    val r_51848: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        context.module_source(ctx), eid, ?ctx.s.interner, context.expr_float_width(ctx, eid));
    if (R.is_err[comptime.CTValue, comptime.EvalFail](r_51848)) { ret res[comptime.CTValue, comptime.EvalFail].err{R.unwrap_err[comptime.CTValue, comptime.EvalFail](r_51848)}; }
    ret res[comptime.CTValue, comptime.EvalFail].ok{R.unwrap_ok[comptime.CTValue, comptime.EvalFail](r_51848)};
}

fun fun_export_of(ctx: *context.LowerContext, did: id.DeclId) opt[intern.StrId] {
    val r_7764: O.Option[intern.StrId] = session.export_name(ctx.s, ctx.scope.own_module, did::u32);
    if (O.is_some[intern.StrId](r_7764)) { ret opt[intern.StrId].some{O.unwrap[intern.StrId](r_7764)}; }
    ret opt[intern.StrId].none{};
}

fun global_export_of(ctx: *context.LowerContext, did: id.DeclId) opt[intern.StrId] {
    val r_7764: O.Option[intern.StrId] = session.export_name(ctx.s, ctx.scope.own_module, did::u32);
    if (O.is_some[intern.StrId](r_7764)) { ret opt[intern.StrId].some{O.unwrap[intern.StrId](r_7764)}; }
    ret opt[intern.StrId].none{};
}
