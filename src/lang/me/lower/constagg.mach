use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.ast;
use aexpr: mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.float;
use mach.lang.intern;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lower: mach.lang.me.lower.context;
use mach.lang.me.lower.expr;
use mach.lang.fail;
use mach.lang.type;
use resolved_target: mach.lang.target.resolved;

def FoldResult: u8;
val FOLD_OK:       FoldResult = 0;
val FOLD_FALLBACK: FoldResult = 1;

val RELOC_SEED_CAP: u32 = 4;

rec RelocBuf {
    relocs: *value.AggReloc;
    len:    u32;
    cap:    u32;
}

fun reloc_buf_make() RelocBuf {
    var rb: RelocBuf;
    rb.relocs = nil;
    rb.len    = 0;
    rb.cap    = 0;
    ret rb;
}

fun reloc_push(ctx: *lower.LowerContext, rb: *RelocBuf, r: value.AggReloc) O.Option[str] {
    if (rb.len == rb.cap) {
        var new_cap: u32 = RELOC_SEED_CAP;
        if (rb.cap > 0) { new_cap = rb.cap * 2; }
        if (rb.relocs == nil) {
            val res_alloc: R.Result[*value.AggReloc, str] = A.allocate[value.AggReloc](ctx.m.alloc, new_cap::usize);
            if (R.is_err[*value.AggReloc, str](res_alloc)) { ret O.some[str](R.unwrap_err[*value.AggReloc, str](res_alloc)); }
            rb.relocs = R.unwrap_ok[*value.AggReloc, str](res_alloc);
        }
        or {
            val res_alloc: R.Result[*value.AggReloc, str] = A.reallocate[value.AggReloc](ctx.m.alloc, rb.relocs, rb.cap::usize, new_cap::usize);
            if (R.is_err[*value.AggReloc, str](res_alloc)) { ret O.some[str](R.unwrap_err[*value.AggReloc, str](res_alloc)); }
            rb.relocs = R.unwrap_ok[*value.AggReloc, str](res_alloc);
        }
        rb.cap = new_cap;
    }
    rb.relocs[rb.len] = r;
    rb.len = rb.len + 1;
    ret O.none[str]();
}

pub fun try_const_aggregate(ctx: *lower.LowerContext, eid: id.ExprId, gty: ir_type.IrTypeId) R.Result[O.Option[value.Value], fail.Fail] {
    val opt_e: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*aexpr.Expr](opt_e)) { ret R.ok[O.Option[value.Value], fail.Fail](O.none[value.Value]()); }
    val e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_e);

    var is_agg: bool = e.kind == aexpr.EXPR_KIND_STRUCT_LIT || e.kind == aexpr.EXPR_KIND_ARRAY_LIT;
    if (ir_is_ptr_or_fn(ctx, gty) && is_const_addr_init(ctx, eid, e)) { is_agg = true; }
    if (!is_agg) {
        ret R.ok[O.Option[value.Value], fail.Fail](O.none[value.Value]());
    }

    val size: u32 = ir_type.byte_size_for_machine(?ctx.m.types, gty, resolved_target.layout_machine(ctx.tgt));
    if (size == 0) { ret R.ok[O.Option[value.Value], fail.Fail](O.none[value.Value]()); }

    val saved_globals: u32 = ctx.m.global_len;

    val res_blob: R.Result[*u8, str] = A.zallocate[u8](ctx.m.alloc, size::usize);
    if (R.is_err[*u8, str](res_blob)) {
        ctx.m.global_len = saved_globals;
        ret R.err[O.Option[value.Value], fail.Fail](fail.message(R.unwrap_err[*u8, str](res_blob)));
    }
    val blob: *u8 = R.unwrap_ok[*u8, str](res_blob);

    var rb: RelocBuf = reloc_buf_make();

    val res_place: R.Result[FoldResult, fail.Fail] = place(ctx, eid, gty, blob, 0, ?rb);
    if (R.is_err[FoldResult, fail.Fail](res_place)) {
        ctx.m.global_len = saved_globals;
        ret R.err[O.Option[value.Value], fail.Fail](R.unwrap_err[FoldResult, fail.Fail](res_place));
    }
    if (R.unwrap_ok[FoldResult, fail.Fail](res_place) == FOLD_FALLBACK) {
        ctx.m.global_len = saved_globals;
        ret R.ok[O.Option[value.Value], fail.Fail](O.none[value.Value]());
    }

    ret R.ok[O.Option[value.Value], fail.Fail](O.some[value.Value](value.const_agg(blob, size, rb.relocs, rb.len, rb.cap, gty)));
}

fun place(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32, rb: *RelocBuf) R.Result[FoldResult, fail.Fail] {
    val opt_t: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (O.is_none[*ir_type.IrType](opt_t)) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: leaf has unknown IR type")); }
    val t: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_t);

    if (t.kind == ir_type.IRT_STRUCT || t.kind == ir_type.IRT_UNION) {
        ret place_struct(ctx, eid, ity, blob, base, rb);
    }
    if (t.kind == ir_type.IRT_ARRAY) { ret place_array(ctx, eid, ity, blob, base, rb); }
    if (t.kind == ir_type.IRT_PTR)   { ret place_ptr(ctx, eid, blob, base, rb); }
    if (t.kind == ir_type.IRT_FN)    { ret place_fn(ctx, eid, blob, base, rb); }
    ret place_scalar(ctx, eid, ity, blob, base);
}

fun place_struct(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32, rb: *RelocBuf) R.Result[FoldResult, fail.Fail] {
    val opt_e: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*aexpr.Expr](opt_e)) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: struct leaf expr out of range")); }
    val e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_e);
    if (e.kind != aexpr.EXPR_KIND_STRUCT_LIT) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }

    val rec_ty: type.TypeId = lower.expr_type_of(ctx, eid);
    val opt_t: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (O.is_none[*ir_type.IrType](opt_t)) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: struct leaf has unknown IR type")); }
    val t: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_t);

    var i: u32 = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_init_len) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: struct field index out of range")); }
        val fi: *aexpr.FieldInit = ?ctx.scope.a.field_inits[pool_ix];
        val field_ix: u32 = expr.field_index_in_type(ctx, rec_ty, fi.name);
        if (field_ix >= t.data.struct_.field_count) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: struct field index exceeds IR field count")); }
        val fty: ir_type.IrTypeId = t.data.struct_.fields[field_ix];
        val foff: u32 = ir_type.byte_offset_for_machine(?ctx.m.types, ity, field_ix, resolved_target.layout_machine(ctx.tgt));
        val res_place: R.Result[FoldResult, fail.Fail] = place(ctx, fi.value, fty, blob, base + foff, rb);
        if (R.is_err[FoldResult, fail.Fail](res_place))                     { ret res_place; }
        if (R.unwrap_ok[FoldResult, fail.Fail](res_place) == FOLD_FALLBACK) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
        i = i + 1;
    }
    ret R.ok[FoldResult, fail.Fail](FOLD_OK);
}

fun place_array(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32, rb: *RelocBuf) R.Result[FoldResult, fail.Fail] {
    val opt_e: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*aexpr.Expr](opt_e)) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: array leaf expr out of range")); }
    val e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_e);
    if (e.kind != aexpr.EXPR_KIND_ARRAY_LIT) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }

    val opt_t: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (O.is_none[*ir_type.IrType](opt_t)) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: array leaf has unknown IR type")); }
    val t: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_t);
    val ety: ir_type.IrTypeId = t.data.array_.element;
    val stride: u32 = ir_type.byte_size_for_machine(?ctx.m.types, ety, resolved_target.layout_machine(ctx.tgt));
    val arr_len: u32 = ir_type.array_count(?ctx.m.types, ity);

    var i: u32 = 0;
    for (i < e.data.array_lit.elems_len) {
        if (i >= arr_len) { ret R.ok[FoldResult, fail.Fail](FOLD_OK); }
        val pool_ix: u32 = e.data.array_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: array element index out of range")); }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
        val res_place: R.Result[FoldResult, fail.Fail] = place(ctx, elem_eid, ety, blob, base + i * stride, rb);
        if (R.is_err[FoldResult, fail.Fail](res_place))                     { ret res_place; }
        if (R.unwrap_ok[FoldResult, fail.Fail](res_place) == FOLD_FALLBACK) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
        i = i + 1;
    }
    ret R.ok[FoldResult, fail.Fail](FOLD_OK);
}

fun place_ptr(ctx: *lower.LowerContext, eid: id.ExprId, blob: *u8, base: u32, rb: *RelocBuf) R.Result[FoldResult, fail.Fail] {
    val opt_e: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*aexpr.Expr](opt_e)) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: pointer leaf expr out of range")); }
    val e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_e);

    if (e.kind == aexpr.EXPR_KIND_LIT_NIL) { ret R.ok[FoldResult, fail.Fail](FOLD_OK); }

    if (e.kind == aexpr.EXPR_KIND_LIT_STR) {
        val res_gv: R.Result[value.Value, fail.Fail] = expr.lower_lit_str(ctx, e);
        if (R.is_err[value.Value, fail.Fail](res_gv)) { ret R.err[FoldResult, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_gv)); }
        val gv: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_gv);
        if (gv.kind != value.VAL_GLOBAL || gv.data.global_ix >= ctx.m.global_len) {
            ret R.err[FoldResult, fail.Fail](fail.message("constagg: string leaf did not lower to a global"));
        }
        ret push_sym_reloc(ctx, rb, base, ctx.m.globals[gv.data.global_ix].name, 0, false);
    }

    if (e.kind == aexpr.EXPR_KIND_UNARY && e.data.unary.op == aexpr.UN_ADDR) {
        ret place_addr_of(ctx, e.data.unary.operand, blob, base, rb);
    }

    if ((e.kind == aexpr.EXPR_KIND_IDENT || e.kind == aexpr.EXPR_KIND_MEMBER) && expr.references_function(ctx, eid)) {
        ret place_fn(ctx, eid, blob, base, rb);
    }

    val res_ctval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), eid, ?ctx.s.interner);
    if (!R.is_err[comptime.CTValue, comptime.EvalFail](res_ctval)) {
        val ctval: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_ctval);
        if (ctval.kind == comptime.CT_KIND_STR) {
            val res_gv: R.Result[value.Value, fail.Fail] = expr.const_value_of(ctx, eid, ctval);
            if (R.is_err[value.Value, fail.Fail](res_gv)) { ret R.err[FoldResult, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_gv)); }
            val gv: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_gv);
            if (gv.kind != value.VAL_GLOBAL || gv.data.global_ix >= ctx.m.global_len) {
                ret R.err[FoldResult, fail.Fail](fail.message("constagg: const string leaf did not lower to a global"));
            }
            ret push_sym_reloc(ctx, rb, base, ctx.m.globals[gv.data.global_ix].name, 0, false);
        }
    }

    ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK);
}

fun place_fn(ctx: *lower.LowerContext, eid: id.ExprId, blob: *u8, base: u32, rb: *RelocBuf) R.Result[FoldResult, fail.Fail] {
    val opt_e: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_some[*aexpr.Expr](opt_e) && O.unwrap[*aexpr.Expr](opt_e).kind == aexpr.EXPR_KIND_LIT_NIL) {
        ret R.ok[FoldResult, fail.Fail](FOLD_OK);
    }

    val opt_name: O.Option[intern.StrId] = expr.symbol_linkage_name(ctx, eid);
    if (O.is_some[intern.StrId](opt_name)) {
        ret push_sym_reloc(ctx, rb, base, O.unwrap[intern.StrId](opt_name), 0, true);
    }
    ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK);
}

fun place_addr_of(ctx: *lower.LowerContext, operand: id.ExprId, blob: *u8, base: u32, rb: *RelocBuf) R.Result[FoldResult, fail.Fail] {
    var cur: id.ExprId = operand;
    var addend: i64 = 0;

    for (true) {
        val opt_name: O.Option[intern.StrId] = expr.symbol_linkage_name(ctx, cur);
        if (O.is_some[intern.StrId](opt_name)) {
            ret push_sym_reloc(ctx, rb, base, O.unwrap[intern.StrId](opt_name), addend, expr.references_function(ctx, cur));
        }

        val opt_ce: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, cur);
        if (O.is_none[*aexpr.Expr](opt_ce)) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
        val ce: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_ce);

        if (ce.kind == aexpr.EXPR_KIND_INDEX) {
            val res_off: R.Result[O.Option[i64], fail.Fail] = index_elem_offset(ctx, ce);
            if (R.is_err[O.Option[i64], fail.Fail](res_off)) { ret R.err[FoldResult, fail.Fail](R.unwrap_err[O.Option[i64], fail.Fail](res_off)); }
            val opt_off: O.Option[i64] = R.unwrap_ok[O.Option[i64], fail.Fail](res_off);
            if (O.is_none[i64](opt_off)) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
            addend = addend + O.unwrap[i64](opt_off);
            cur = ce.data.index.object;
            cnt;
        }

        if (ce.kind != aexpr.EXPR_KIND_MEMBER) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }

        val obj_ty: type.TypeId = lower.expr_type_of(ctx, ce.data.member.object);
        val res_obj_ir: R.Result[ir_type.IrTypeId, fail.Fail] = lower.lower_type(ctx, obj_ty);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_obj_ir)) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
        val obj_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_obj_ir);
        val field_ix: u32 = expr.field_index_in_type(ctx, obj_ty, ce.data.member.name);
        addend = addend + ir_type.byte_offset_for_machine(?ctx.m.types, obj_ir, field_ix, resolved_target.layout_machine(ctx.tgt))::i64;
        cur = ce.data.member.object;
    }
    ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK);
}

fun index_elem_offset(ctx: *lower.LowerContext, ce: *aexpr.Expr) R.Result[O.Option[i64], fail.Fail] {
    val res_idx: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), ce.data.index.index, ?ctx.s.interner);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_idx))                { ret R.ok[O.Option[i64], fail.Fail](O.none[i64]()); }
    val idxv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_idx);
    if (idxv.kind != comptime.CT_KIND_INT)                       { ret R.ok[O.Option[i64], fail.Fail](O.none[i64]()); }
    if (!idxv.int_unsigned && idxv.data.i < 0)                   { ret R.ok[O.Option[i64], fail.Fail](O.none[i64]()); }
    val index: i64 = idxv.data.i;

    val obj_ty: type.TypeId = lower.expr_type_of(ctx, ce.data.index.object);
    val res_obj_ir: R.Result[ir_type.IrTypeId, fail.Fail] = lower.lower_type(ctx, obj_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_obj_ir))             { ret R.ok[O.Option[i64], fail.Fail](O.none[i64]()); }
    val obj_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_obj_ir);
    val opt_t: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, obj_ir);
    if (O.is_none[*ir_type.IrType](opt_t))                       { ret R.ok[O.Option[i64], fail.Fail](O.none[i64]()); }
    val t: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_t);
    if (t.kind != ir_type.IRT_ARRAY)                            { ret R.ok[O.Option[i64], fail.Fail](O.none[i64]()); }
    val stride: u32 = ir_type.byte_size_for_machine(?ctx.m.types, t.data.array_.element, resolved_target.layout_machine(ctx.tgt));
    ret R.ok[O.Option[i64], fail.Fail](O.some[i64](index * stride::i64));
}

fun push_sym_reloc(ctx: *lower.LowerContext, rb: *RelocBuf, off: u32, symbol: intern.StrId, addend: i64, is_fn: bool) R.Result[FoldResult, fail.Fail] {
    var r: value.AggReloc;
    r.offset = off;
    r.symbol = symbol;
    r.addend = addend;
    r.is_fn  = is_fn;
    val opt_push: O.Option[str] = reloc_push(ctx, rb, r);
    if (O.is_some[str](opt_push)) { ret R.err[FoldResult, fail.Fail](fail.message(O.unwrap[str](opt_push))); }
    ret R.ok[FoldResult, fail.Fail](FOLD_OK);
}

fun place_scalar(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32) R.Result[FoldResult, fail.Fail] {
    val size: u32 = ir_type.byte_size_for_machine(?ctx.m.types, ity, resolved_target.layout_machine(ctx.tgt));
    if (size == 0 || size > 8) { ret R.err[FoldResult, fail.Fail](fail.message("constagg: scalar leaf has unsupported size")); }

    val opt_ie: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_some[*aexpr.Expr](opt_ie)) {
        val ie: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_ie);
        if (ie.kind == aexpr.EXPR_KIND_CALL) {
            val opt_intr: O.Option[R.Result[value.Value, fail.Fail]] = expr.try_lower_comptime_intrinsic(ctx, eid, ie);
            if (O.is_some[R.Result[value.Value, fail.Fail]](opt_intr)) {
                val res_intr: R.Result[value.Value, fail.Fail] = O.unwrap[R.Result[value.Value, fail.Fail]](opt_intr);
                if (R.is_err[value.Value, fail.Fail](res_intr)) { ret R.err[FoldResult, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_intr)); }
                val intr_val: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_intr);
                if (intr_val.kind != value.VAL_CONST_INT) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
                write_bits(blob, base, intr_val.data.int_lit, size);
                ret R.ok[FoldResult, fail.Fail](FOLD_OK);
            }
            ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK);
        }
    }

    val res_ctval: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate_at_float_width[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), eid, ?ctx.s.interner,
                                     lower.expr_float_width(ctx, eid));
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_ctval)) {
        ret place_cast_leaf(ctx, eid, blob, base, size);
    }
    val ctval: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_ctval);

    var bits: u64 = 0;
    if (ctval.kind == comptime.CT_KIND_INT) { bits = ctval.data.i::u64; }
    or (ctval.kind == comptime.CT_KIND_FLOAT) {
        if (size == 8) { bits = float.f64_bits(ctval.data.f); }
        or (size == 4) { bits = float.f64_to_f32_bits(float.f64_bits(ctval.data.f))::u64; }
        or             { ret R.err[FoldResult, fail.Fail](fail.message("constagg: unsupported float leaf width")); }
    }
    or {
        ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK);
    }

    write_bits(blob, base, bits, size);
    ret R.ok[FoldResult, fail.Fail](FOLD_OK);
}

fun place_cast_leaf(ctx: *lower.LowerContext, eid: id.ExprId, blob: *u8, base: u32, size: u32) R.Result[FoldResult, fail.Fail] {
    val opt_e: O.Option[*aexpr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*aexpr.Expr](opt_e)) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
    val e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_e);

    val opt_cast: O.Option[R.Result[value.Value, fail.Fail]] = expr.try_lower_comptime_cast(ctx, eid, e);
    if (O.is_none[R.Result[value.Value, fail.Fail]](opt_cast)) { ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK); }
    val res_cast: R.Result[value.Value, fail.Fail] = O.unwrap[R.Result[value.Value, fail.Fail]](opt_cast);
    if (R.is_err[value.Value, fail.Fail](res_cast)) { ret R.err[FoldResult, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_cast)); }
    val cv: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_cast);

    if (cv.kind == value.VAL_CONST_INT) {
        write_bits(blob, base, cv.data.int_lit, size);
        ret R.ok[FoldResult, fail.Fail](FOLD_OK);
    }
    if (cv.kind == value.VAL_CONST_FLOAT) {
        var fbits: u64 = 0;
        if (size == 8) { fbits = float.f64_bits(cv.data.float_lit); }
        or (size == 4) { fbits = float.f64_to_f32_bits(float.f64_bits(cv.data.float_lit))::u64; }
        or             { ret R.err[FoldResult, fail.Fail](fail.message("constagg: unsupported float cast-leaf width")); }
        write_bits(blob, base, fbits, size);
        ret R.ok[FoldResult, fail.Fail](FOLD_OK);
    }
    ret R.ok[FoldResult, fail.Fail](FOLD_FALLBACK);
}

fun write_bits(blob: *u8, base: u32, bits: u64, size: u32) {
    var i: u32 = 0;
    for (i < size) {
        blob[base + i] = (bits >> (i::u64 * 8::u64))::u8;
        i = i + 1;
    }
}

fun ir_is_ptr_or_fn(ctx: *lower.LowerContext, ity: ir_type.IrTypeId) bool {
    val opt_t: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (O.is_none[*ir_type.IrType](opt_t)) { ret false; }
    val k: ir_type.IrTypeKind = O.unwrap[*ir_type.IrType](opt_t).kind;
    ret k == ir_type.IRT_PTR || k == ir_type.IRT_FN;
}

fun is_const_addr_init(ctx: *lower.LowerContext, eid: id.ExprId, e: *aexpr.Expr) bool {
    if (e.kind == aexpr.EXPR_KIND_LIT_STR)                                                                           { ret true; }
    if (e.kind == aexpr.EXPR_KIND_UNARY && e.data.unary.op == aexpr.UN_ADDR)                                         { ret true; }
    if ((e.kind == aexpr.EXPR_KIND_IDENT || e.kind == aexpr.EXPR_KIND_MEMBER) && expr.references_function(ctx, eid)) { ret true; }
    ret folds_to_const_str(ctx, eid);
}

fun folds_to_const_str(ctx: *lower.LowerContext, eid: id.ExprId) bool {
    val res_ctval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), eid, ?ctx.s.interner);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_ctval)) { ret false; }
    ret R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_ctval).kind == comptime.CT_KIND_STR;
}

rec ConstAggInner {
    x: u32;
    y: u64;
}

rec ConstAggProbe {
    a:     u32;
    b:     u64;
    c:     u8;
    inner: ConstAggInner;
    arr:   [3]u32;
}

val constagg_probe_static: ConstAggProbe = ConstAggProbe{a: 7};

val constagg_probe_ct_arr: [1]ConstAggProbe = [1]ConstAggProbe{ConstAggProbe{a: 7}};

fun constagg_probe_dirty() u64 {
    var junk: [24]u64;
    var i: u32 = 0;
    for (i < 24) { junk[i] = 0xAAAAAAAAAAAAAAAA; i = i + 1; }
    ret junk[0];
}

fun constagg_probe_runtime() ConstAggProbe {
    ret ConstAggProbe{a: 7};
}

test "mach.lang.me.lower.constagg:static_and_runtime_agree_on_omitted_fields" {
    var bad: i32 = 0;

    if (constagg_probe_dirty() != 0xAAAAAAAAAAAAAAAA) { bad = bad + 1; }

    val r: ConstAggProbe = constagg_probe_runtime();

    if (r.a != 7)                                  { bad = bad + 2; }
    if (constagg_probe_static.a != 7)              { bad = bad + 4; }

    if (r.b != 0)                                  { bad = bad + 8; }
    if (r.c != 0)                                  { bad = bad + 16; }
    if (r.inner.x != 0 || r.inner.y != 0)          { bad = bad + 32; }
    if (r.arr[0] != 0 || r.arr[1] != 0 || r.arr[2] != 0) { bad = bad + 64; }

    if (constagg_probe_static.b != r.b)                     { bad = bad + 128; }
    if (constagg_probe_static.c != r.c)                     { bad = bad + 256; }
    val st: ConstAggProbe = constagg_probe_static;
    if (st.inner.x != r.inner.x)                            { bad = bad + 512; }
    if (st.inner.y != r.inner.y)                            { bad = bad + 1024; }
    if (st.arr[0] != r.arr[0])                              { bad = bad + 2048; }
    if (st.arr[2] != r.arr[2])                              { bad = bad + 4096; }

    ret bad;
}

test "mach.lang.me.lower.constagg:comptime_constant_and_runtime_agree_on_omitted_fields" {
    var bad: i32 = 0;
    $each item in constagg_probe_ct_arr {
        $if (item.b == 0 && item.c == 0) {
            val r: ConstAggProbe = constagg_probe_runtime();
            if (r.b != 0)                     { bad = bad + 1; }
            if (r.c != 0)                     { bad = bad + 2; }
            if (r.inner.y != 0)               { bad = bad + 4; }
            if (constagg_probe_static.b != 0) { bad = bad + 8; }
        }
        $or {
            bad = bad + 32;
        }
    }
    ret bad;
}
