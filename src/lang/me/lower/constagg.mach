use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use aexpr: mach.lang.fe.ast.expr;
use mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.fe.token;
use mach.lang.float;
use mach.lang.intern;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lower: mach.lang.me.lower.context;
use mach.lang.me.lower.expr;
use mach.lang.fail;
use mach.lang.type;
use resolved_target: mach.lang.target.resolved;

def FoldResult: u8;
val FOLD_OK:       FoldResult = 0;
val FOLD_FALLBACK: FoldResult = 1;

val RELOC_SEED_CAP: u32 = 4;

rec RelocBuf {
    relocs: *value.AggReloc;
    len:    u32;
    cap:    u32;
}

fun reloc_buf_make() RelocBuf {
    var rb: RelocBuf;
    rb.relocs = nil;
    rb.len    = 0;
    rb.cap    = 0;
    ret rb;
}

fun reloc_push(ctx: *lower.LowerContext, rb: *RelocBuf, r: value.AggReloc) err[fail.Fail] {
    if (rb.len == rb.cap) {
        var new_cap: u32 = RELOC_SEED_CAP;
        if (rb.cap > 0) { new_cap = rb.cap * 2; }
        if (rb.relocs == nil) {
            val res_alloc: res[*value.AggReloc, A.Error] = A.allocate[value.AggReloc](ctx.m.alloc, new_cap::usize);
            if (sel res_alloc.err) { ret err[fail.Fail].err{fail.refused(res_alloc.err)}; }
            rb.relocs = res_alloc.ok;
        }
        or {
            val res_alloc: res[*value.AggReloc, A.Error] = A.reallocate[value.AggReloc](ctx.m.alloc, rb.relocs, rb.cap::usize, new_cap::usize);
            if (sel res_alloc.err) { ret err[fail.Fail].err{fail.refused(res_alloc.err)}; }
            rb.relocs = res_alloc.ok;
        }
        rb.cap = new_cap;
    }
    rb.relocs[rb.len] = r;
    rb.len = rb.len + 1;
    ret err[fail.Fail].ok{};
}

pub fun try_const_aggregate(ctx: *lower.LowerContext, init_eid: id.ExprId, gty: ir_type.IrTypeId) res[opt[value.Value], fail.Fail] {
    # an initializer that names a constant aggregate folds the literal it names
    val literal: opt[id.ExprId] = expr.constant_literal_expr(ctx, init_eid);
    var eid: id.ExprId = init_eid;
    if (sel literal.some) { eid = literal.some; }
    val opt_e: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_e.err) { ret res[opt[value.Value], fail.Fail].err{opt_e.err}; }
    var e_value: aexpr.Expr = opt_e.ok;
    val e: *aexpr.Expr = ?e_value;

    var is_agg: bool = e.kind == aexpr.EXPR_KIND_STRUCT_LIT || e.kind == aexpr.EXPR_KIND_ARRAY_LIT;
    if (e.kind == aexpr.EXPR_KIND_STRUCT_LIT && ir_type.is_tag(?ctx.m.types, gty)) { is_agg = true; }
    if (ir_is_ptr_or_fn(ctx, gty) && is_const_addr_init(ctx, eid, e)) { is_agg = true; }
    if (!is_agg) {
        ret res[opt[value.Value], fail.Fail].ok{opt[value.Value].none{}};
    }

    val size: u32 = ir_type.byte_size_for_machine(?ctx.m.types, gty, resolved_target.layout_machine(ctx.tgt));
    if (size == 0) { ret res[opt[value.Value], fail.Fail].ok{opt[value.Value].none{}}; }

    val saved_globals: u32 = ctx.m.global_len;

    val res_blob: res[*u8, A.Error] = A.zallocate[u8](ctx.m.alloc, size::usize);
    if (sel res_blob.err) {
        ctx.m.global_len = saved_globals;
        ret res[opt[value.Value], fail.Fail].err{fail.refused(res_blob.err)};
    }
    val blob: *u8 = res_blob.ok;

    var rb: RelocBuf = reloc_buf_make();

    val res_place: res[FoldResult, fail.Fail] = place(ctx, eid, gty, blob, 0, ?rb);
    if (sel res_place.err) {
        ctx.m.global_len = saved_globals;
        ret res[opt[value.Value], fail.Fail].err{res_place.err};
    }
    if (res_place.ok == FOLD_FALLBACK) {
        ctx.m.global_len = saved_globals;
        ret res[opt[value.Value], fail.Fail].ok{opt[value.Value].none{}};
    }

    ret res[opt[value.Value], fail.Fail].ok{opt[value.Value].some{value.const_agg(blob, size, rb.relocs, rb.len, rb.cap, gty)}};
}

fun place(ctx: *lower.LowerContext, leaf_eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32, rb: *RelocBuf) res[FoldResult, fail.Fail] {
    val literal: opt[id.ExprId] = expr.constant_literal_expr(ctx, leaf_eid);
    var eid: id.ExprId = leaf_eid;
    if (sel literal.some) { eid = literal.some; }
    val opt_t: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (sel opt_t.none) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: leaf has unknown IR type")}; }
    val t: *ir_type.IrType = opt_t.some;

    if (t.kind == ir_type.IRT_TAG) { ret place_tag(ctx, eid, ity, blob, base, rb); }
    if (t.kind == ir_type.IRT_STRUCT || t.kind == ir_type.IRT_UNION) {
        ret place_struct(ctx, eid, ity, blob, base, rb);
    }
    if (t.kind == ir_type.IRT_ARRAY) { ret place_array(ctx, eid, ity, blob, base, rb); }
    if (t.kind == ir_type.IRT_PTR)   { ret place_ptr(ctx, eid, blob, base, rb); }
    if (t.kind == ir_type.IRT_FN)    { ret place_fn(ctx, eid, blob, base, rb); }
    ret place_scalar(ctx, eid, ity, blob, base);
}

# a static tag holds its case code at offset zero and its payload at the common payload offset
fun place_tag(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32, rb: *RelocBuf) res[FoldResult, fail.Fail] {
    val opt_e: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_e.err) { ret res[FoldResult, fail.Fail].err{opt_e.err}; }
    var e_value: aexpr.Expr = opt_e.ok;
    val e: *aexpr.Expr = ?e_value;
    if (e.kind != aexpr.EXPR_KIND_STRUCT_LIT) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }

    val tag_ty: type.TypeId = lower.expr_type_of(ctx, eid);
    val res_case: res[opt[u32], fail.Fail] = expr.literal_head_case_index(ctx, e.data.struct_lit.ty, tag_ty);
    if (sel res_case.err) { ret res[FoldResult, fail.Fail].err{res_case.err}; }
    val r_135: opt[u32] = res_case.ok;
    if (sel r_135.none) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
    val case_ix_r: opt[u32] = res_case.ok;
    if (sel case_ix_r.none) { ret res[FoldResult, fail.Fail].err{fail.message("place_tag: a required element is absent")}; }
    val case_ix: u32 = case_ix_r.some;

    val opt_t: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (sel opt_t.none) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: tag leaf has unknown IR type")}; }
    val t: *ir_type.IrType = opt_t.some;

    if (case_ix >= t.data.tag_.case_count) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: tag case index exceeds IR case count")}; }

    write_bits(blob, base, case_ix::u64, ir_type.tag_discriminator_bytes(?ctx.m.types, ity));

    if (e.data.struct_lit.elems_len == 0) { ret res[FoldResult, fail.Fail].ok{FOLD_OK}; }
    if (e.data.struct_lit.elems_len != 1) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
    val pool_ix: u32 = e.data.struct_lit.elems_start;
    if (pool_ix::usize >= ctx.scope.a.expr_id_len) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: tag payload index out of range")}; }
    val payload_off: u32 = ir_type.byte_offset_for_machine(?ctx.m.types, ity, case_ix, resolved_target.layout_machine(ctx.tgt));
    ret place(ctx, ctx.scope.a.expr_ids[pool_ix], t.data.tag_.cases[case_ix], blob, base + payload_off, rb);
}

fun place_struct(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32, rb: *RelocBuf) res[FoldResult, fail.Fail] {
    val opt_e: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_e.err) { ret res[FoldResult, fail.Fail].err{opt_e.err}; }
    var e_value: aexpr.Expr = opt_e.ok;
    val e: *aexpr.Expr = ?e_value;
    if (e.kind != aexpr.EXPR_KIND_STRUCT_LIT) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }

    val rec_ty: type.TypeId = lower.expr_type_of(ctx, eid);
    val opt_t: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (sel opt_t.none) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: struct leaf has unknown IR type")}; }
    val t: *ir_type.IrType = opt_t.some;

    var i: u32 = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_init_len) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: struct field index out of range")}; }
        val fi: *aexpr.FieldInit = ?ctx.scope.a.field_inits[pool_ix];
        val field_ix: u32 = expr.field_index_in_type(ctx, rec_ty, fi.name);
        if (field_ix >= t.data.struct_.field_count) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: struct field index exceeds IR field count")}; }
        val fty: ir_type.IrTypeId = t.data.struct_.fields[field_ix];
        val foff: u32 = ir_type.byte_offset_for_machine(?ctx.m.types, ity, field_ix, resolved_target.layout_machine(ctx.tgt));
        val res_place: res[FoldResult, fail.Fail] = place(ctx, fi.value, fty, blob, base + foff, rb);
        if (sel res_place.err)                     { ret res_place; }
        if (res_place.ok == FOLD_FALLBACK) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
        i = i + 1;
    }
    ret res[FoldResult, fail.Fail].ok{FOLD_OK};
}

fun place_array(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32, rb: *RelocBuf) res[FoldResult, fail.Fail] {
    val opt_e: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_e.err) { ret res[FoldResult, fail.Fail].err{opt_e.err}; }
    var e_value: aexpr.Expr = opt_e.ok;
    val e: *aexpr.Expr = ?e_value;
    if (e.kind != aexpr.EXPR_KIND_ARRAY_LIT) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }

    val opt_t: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (sel opt_t.none) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: array leaf has unknown IR type")}; }
    val t: *ir_type.IrType = opt_t.some;
    val ety: ir_type.IrTypeId = t.data.array_.element;
    val stride: u32 = ir_type.byte_size_for_machine(?ctx.m.types, ety, resolved_target.layout_machine(ctx.tgt));
    val arr_len: u32 = ir_type.array_count(?ctx.m.types, ity);

    var i: u32 = 0;
    for (i < e.data.array_lit.elems_len) {
        if (i >= arr_len) { ret res[FoldResult, fail.Fail].ok{FOLD_OK}; }
        val pool_ix: u32 = e.data.array_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: array element index out of range")}; }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
        val res_place: res[FoldResult, fail.Fail] = place(ctx, elem_eid, ety, blob, base + i * stride, rb);
        if (sel res_place.err)                     { ret res_place; }
        if (res_place.ok == FOLD_FALLBACK) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
        i = i + 1;
    }
    ret res[FoldResult, fail.Fail].ok{FOLD_OK};
}

fun place_ptr(ctx: *lower.LowerContext, eid: id.ExprId, blob: *u8, base: u32, rb: *RelocBuf) res[FoldResult, fail.Fail] {
    val opt_e: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_e.err) { ret res[FoldResult, fail.Fail].err{opt_e.err}; }
    var e_value: aexpr.Expr = opt_e.ok;
    val e: *aexpr.Expr = ?e_value;

    if (e.kind == aexpr.EXPR_KIND_LIT_NIL) { ret res[FoldResult, fail.Fail].ok{FOLD_OK}; }

    if (e.kind == aexpr.EXPR_KIND_LIT_STR) {
        val res_gv: res[value.Value, fail.Fail] = expr.lower_lit_str(ctx, e);
        if (sel res_gv.err) { ret res[FoldResult, fail.Fail].err{res_gv.err}; }
        val gv: value.Value = res_gv.ok;
        if (gv.kind != value.VAL_GLOBAL || gv.data.global_ix >= ctx.m.global_len) {
            ret res[FoldResult, fail.Fail].err{fail.message("constagg: string leaf did not lower to a global")};
        }
        ret push_sym_reloc(ctx, rb, base, ctx.m.globals[gv.data.global_ix].name, 0, false);
    }

    if (e.kind == aexpr.EXPR_KIND_UNARY && e.data.unary.op == aexpr.UN_ADDR) {
        ret place_addr_of(ctx, e.data.unary.operand, blob, base, rb);
    }

    if ((e.kind == aexpr.EXPR_KIND_IDENT || e.kind == aexpr.EXPR_KIND_MEMBER) && expr.references_function(ctx, eid)) {
        ret place_fn(ctx, eid, blob, base, rb);
    }

    val res_ctval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), eid, ?ctx.s.interner);
    lower.record_eval_result(ctx, res_ctval);
    if (sel res_ctval.ok) {
        val ctval: comptime.CTValue = res_ctval.ok;
        if (ctval.kind == comptime.CT_KIND_STR) {
            val res_gv: res[value.Value, fail.Fail] = expr.const_value_of(ctx, eid, ctval);
            if (sel res_gv.err) { ret res[FoldResult, fail.Fail].err{res_gv.err}; }
            val gv: value.Value = res_gv.ok;
            if (gv.kind != value.VAL_GLOBAL || gv.data.global_ix >= ctx.m.global_len) {
                ret res[FoldResult, fail.Fail].err{fail.message("constagg: const string leaf did not lower to a global")};
            }
            ret push_sym_reloc(ctx, rb, base, ctx.m.globals[gv.data.global_ix].name, 0, false);
        }
    }

    ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK};
}

fun place_fn(ctx: *lower.LowerContext, eid: id.ExprId, blob: *u8, base: u32, rb: *RelocBuf) res[FoldResult, fail.Fail] {
    val opt_e: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_e.err) { ret res[FoldResult, fail.Fail].err{opt_e.err}; }
    if (opt_e.ok.kind == aexpr.EXPR_KIND_LIT_NIL) {
        ret res[FoldResult, fail.Fail].ok{FOLD_OK};
    }

    val opt_name: opt[intern.StrId] = expr.symbol_linkage_name(ctx, eid);
    if (sel opt_name.some) {
        ret push_sym_reloc(ctx, rb, base, opt_name.some, 0, true);
    }
    ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK};
}

fun place_addr_of(ctx: *lower.LowerContext, operand: id.ExprId, blob: *u8, base: u32, rb: *RelocBuf) res[FoldResult, fail.Fail] {
    var cur: id.ExprId = operand;
    var addend: i64 = 0;

    for (true) {
        val opt_name: opt[intern.StrId] = expr.symbol_linkage_name(ctx, cur);
        if (sel opt_name.some) {
            ret push_sym_reloc(ctx, rb, base, opt_name.some, addend, expr.references_function(ctx, cur));
        }

        val opt_ce: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, cur);
        if (sel opt_ce.err) { ret res[FoldResult, fail.Fail].err{opt_ce.err}; }
        var ce_value: aexpr.Expr = opt_ce.ok;
        val ce: *aexpr.Expr = ?ce_value;

        if (ce.kind == aexpr.EXPR_KIND_INDEX) {
            val res_off: res[opt[i64], fail.Fail] = index_elem_offset(ctx, ce);
            if (sel res_off.err) { ret res[FoldResult, fail.Fail].err{res_off.err}; }
            val opt_off: opt[i64] = res_off.ok;
            if (sel opt_off.none) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
            addend = addend + opt_off.some;
            cur = ce.data.index.object;
            cnt;
        }

        if (ce.kind != aexpr.EXPR_KIND_MEMBER) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }

        val obj_ty: type.TypeId = lower.expr_type_of(ctx, ce.data.member.object);
        val res_obj_ir: res[ir_type.IrTypeId, fail.Fail] = lower.lower_type(ctx, obj_ty);
        if (sel res_obj_ir.err) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
        val obj_ir: ir_type.IrTypeId = res_obj_ir.ok;
        val field_ix: u32 = expr.field_index_in_type(ctx, obj_ty, ce.data.member.name);
        addend = addend + ir_type.byte_offset_for_machine(?ctx.m.types, obj_ir, field_ix, resolved_target.layout_machine(ctx.tgt))::i64;
        cur = ce.data.member.object;
    }
    ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK};
}

fun index_elem_offset(ctx: *lower.LowerContext, ce: *aexpr.Expr) res[opt[i64], fail.Fail] {
    val res_idx: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), ce.data.index.index, ?ctx.s.interner);
    lower.record_eval_result(ctx, res_idx);
    if (sel res_idx.err)                { ret res[opt[i64], fail.Fail].ok{opt[i64].none{}}; }
    val idxv: comptime.CTValue = res_idx.ok;
    if (idxv.kind != comptime.CT_KIND_INT)                       { ret res[opt[i64], fail.Fail].ok{opt[i64].none{}}; }
    if (!idxv.int_unsigned && idxv.data.i < 0)                   { ret res[opt[i64], fail.Fail].ok{opt[i64].none{}}; }
    val index: i64 = idxv.data.i;

    val obj_ty: type.TypeId = lower.expr_type_of(ctx, ce.data.index.object);
    val res_obj_ir: res[ir_type.IrTypeId, fail.Fail] = lower.lower_type(ctx, obj_ty);
    if (sel res_obj_ir.err)             { ret res[opt[i64], fail.Fail].ok{opt[i64].none{}}; }
    val obj_ir: ir_type.IrTypeId = res_obj_ir.ok;
    val opt_t: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, obj_ir);
    if (sel opt_t.none)                       { ret res[opt[i64], fail.Fail].ok{opt[i64].none{}}; }
    val t: *ir_type.IrType = opt_t.some;
    if (t.kind != ir_type.IRT_ARRAY)                            { ret res[opt[i64], fail.Fail].ok{opt[i64].none{}}; }
    val stride: u32 = ir_type.byte_size_for_machine(?ctx.m.types, t.data.array_.element, resolved_target.layout_machine(ctx.tgt));
    ret res[opt[i64], fail.Fail].ok{opt[i64].some{index * stride::i64}};
}

fun push_sym_reloc(ctx: *lower.LowerContext, rb: *RelocBuf, off: u32, symbol: intern.StrId, addend: i64, is_fn: bool) res[FoldResult, fail.Fail] {
    var r: value.AggReloc;
    r.offset = off;
    r.symbol = symbol;
    r.addend = addend;
    r.is_fn  = is_fn;
    val opt_push: err[fail.Fail] = reloc_push(ctx, rb, r);
    if (sel opt_push.err) { ret res[FoldResult, fail.Fail].err{opt_push.err}; }
    ret res[FoldResult, fail.Fail].ok{FOLD_OK};
}

fun place_scalar(ctx: *lower.LowerContext, eid: id.ExprId, ity: ir_type.IrTypeId, blob: *u8, base: u32) res[FoldResult, fail.Fail] {
    val size: u32 = ir_type.byte_size_for_machine(?ctx.m.types, ity, resolved_target.layout_machine(ctx.tgt));
    if (size == 0 || size > 8) { ret res[FoldResult, fail.Fail].err{fail.message("constagg: scalar leaf has unsupported size")}; }

    val opt_ie: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_ie.err) { ret res[FoldResult, fail.Fail].err{opt_ie.err}; }
    var ie_value: aexpr.Expr = opt_ie.ok;
    val ie: *aexpr.Expr = ?ie_value;
    if (ie.kind == aexpr.EXPR_KIND_CALL) {
        val opt_intr: opt[res[value.Value, fail.Fail]] = expr.try_lower_comptime_intrinsic(ctx, eid, ie);
        if (sel opt_intr.some) {
            val res_intr: res[value.Value, fail.Fail] = opt_intr.some;
            if (sel res_intr.err) { ret res[FoldResult, fail.Fail].err{res_intr.err}; }
            val intr_val: value.Value = res_intr.ok;
            if (intr_val.kind != value.VAL_CONST_INT) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
            write_bits(blob, base, intr_val.data.int_lit, size);
            ret res[FoldResult, fail.Fail].ok{FOLD_OK};
        }
        ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK};
    }

    val res_ctval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), eid, ?ctx.s.interner,
                                     lower.expr_float_width(ctx, eid));
    lower.record_eval_result(ctx, res_ctval);
    if (sel res_ctval.err) {
        ret place_cast_leaf(ctx, eid, blob, base, size);
    }
    val ctval: comptime.CTValue = res_ctval.ok;

    var bits: u64 = 0;
    if (ctval.kind == comptime.CT_KIND_INT) { bits = ctval.data.i::u64; }
    or (ctval.kind == comptime.CT_KIND_FLOAT) {
        if (size == 8) { bits = float.f64_bits(ctval.data.f); }
        or (size == 4) { bits = float.f64_to_f32_bits(float.f64_bits(ctval.data.f))::u64; }
        or             { ret res[FoldResult, fail.Fail].err{fail.message("constagg: unsupported float leaf width")}; }
    }
    or {
        ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK};
    }

    write_bits(blob, base, bits, size);
    ret res[FoldResult, fail.Fail].ok{FOLD_OK};
}

fun place_cast_leaf(ctx: *lower.LowerContext, eid: id.ExprId, blob: *u8, base: u32, size: u32) res[FoldResult, fail.Fail] {
    val opt_e: res[aexpr.Expr, fail.Fail] = lower.expression(ctx, eid);
    if (sel opt_e.err) { ret res[FoldResult, fail.Fail].err{opt_e.err}; }
    var e_value: aexpr.Expr = opt_e.ok;
    val e: *aexpr.Expr = ?e_value;

    val opt_cast: opt[res[value.Value, fail.Fail]] = expr.try_lower_comptime_cast(ctx, eid, e);
    if (sel opt_cast.none) { ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK}; }
    val res_cast: res[value.Value, fail.Fail] = opt_cast.some;
    if (sel res_cast.err) { ret res[FoldResult, fail.Fail].err{res_cast.err}; }
    val cv: value.Value = res_cast.ok;

    if (cv.kind == value.VAL_CONST_INT) {
        write_bits(blob, base, cv.data.int_lit, size);
        ret res[FoldResult, fail.Fail].ok{FOLD_OK};
    }
    if (cv.kind == value.VAL_CONST_FLOAT) {
        var fbits: u64 = 0;
        if (size == 8) { fbits = float.f64_bits(cv.data.float_lit); }
        or (size == 4) { fbits = float.f64_to_f32_bits(float.f64_bits(cv.data.float_lit))::u64; }
        or             { ret res[FoldResult, fail.Fail].err{fail.message("constagg: unsupported float cast-leaf width")}; }
        write_bits(blob, base, fbits, size);
        ret res[FoldResult, fail.Fail].ok{FOLD_OK};
    }
    ret res[FoldResult, fail.Fail].ok{FOLD_FALLBACK};
}

fun write_bits(blob: *u8, base: u32, bits: u64, size: u32) {
    var i: u32 = 0;
    for (i < size) {
        blob[base + i] = (bits >> (i::u64 * 8::u64))::u8;
        i = i + 1;
    }
}

fun ir_is_ptr_or_fn(ctx: *lower.LowerContext, ity: ir_type.IrTypeId) bool {
    val opt_t: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (sel opt_t.none) { ret false; }
    val k: ir_type.IrTypeKind = opt_t.some.kind;
    ret k == ir_type.IRT_PTR || k == ir_type.IRT_FN;
}

fun is_const_addr_init(ctx: *lower.LowerContext, eid: id.ExprId, e: *aexpr.Expr) bool {
    if (e.kind == aexpr.EXPR_KIND_LIT_STR)                                                                           { ret true; }
    if (e.kind == aexpr.EXPR_KIND_UNARY && e.data.unary.op == aexpr.UN_ADDR)                                         { ret true; }
    if ((e.kind == aexpr.EXPR_KIND_IDENT || e.kind == aexpr.EXPR_KIND_MEMBER) && expr.references_function(ctx, eid)) { ret true; }
    ret folds_to_const_str(ctx, eid);
}

fun folds_to_const_str(ctx: *lower.LowerContext, eid: id.ExprId) bool {
    val res_ctval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower.module_source(ctx), eid, ?ctx.s.interner);
    lower.record_eval_result(ctx, res_ctval);
    if (sel res_ctval.err) { ret false; }
    ret res_ctval.ok.kind == comptime.CT_KIND_STR;
}

rec ConstAggInner {
    x: u32;
    y: u64;
}

rec ConstAggProbe {
    a:     u32;
    b:     u64;
    c:     u8;
    inner: ConstAggInner;
    arr:   [3]u32;
}

val constagg_probe_static: ConstAggProbe = ConstAggProbe{a: 7};

val constagg_probe_ct_arr: [1]ConstAggProbe = [1]ConstAggProbe{ConstAggProbe{a: 7}};

fun constagg_probe_dirty() u64 {
    var junk: [24]u64;
    var i: u32 = 0;
    for (i < 24) { junk[i] = 0xAAAAAAAAAAAAAAAA; i = i + 1; }
    ret junk[0];
}

fun constagg_probe_runtime() ConstAggProbe {
    ret ConstAggProbe{a: 7};
}

test "mach.lang.me.lower.constagg:static_and_runtime_agree_on_omitted_fields" {
    var bad: i32 = 0;

    if (constagg_probe_dirty() != 0xAAAAAAAAAAAAAAAA) { bad = bad + 1; }

    val r: ConstAggProbe = constagg_probe_runtime();

    if (r.a != 7)                                  { bad = bad + 2; }
    if (constagg_probe_static.a != 7)              { bad = bad + 4; }

    if (r.b != 0)                                  { bad = bad + 8; }
    if (r.c != 0)                                  { bad = bad + 16; }
    if (r.inner.x != 0 || r.inner.y != 0)          { bad = bad + 32; }
    if (r.arr[0] != 0 || r.arr[1] != 0 || r.arr[2] != 0) { bad = bad + 64; }

    if (constagg_probe_static.b != r.b)                     { bad = bad + 128; }
    if (constagg_probe_static.c != r.c)                     { bad = bad + 256; }
    val st: ConstAggProbe = constagg_probe_static;
    if (st.inner.x != r.inner.x)                            { bad = bad + 512; }
    if (st.inner.y != r.inner.y)                            { bad = bad + 1024; }
    if (st.arr[0] != r.arr[0])                              { bad = bad + 2048; }
    if (st.arr[2] != r.arr[2])                              { bad = bad + 4096; }

    ret bad;
}

test "mach.lang.me.lower.constagg:comptime_constant_and_runtime_agree_on_omitted_fields" {
    var bad: i32 = 0;
    $each item in constagg_probe_ct_arr {
        $if (item.b == 0 && item.c == 0) {
            val r: ConstAggProbe = constagg_probe_runtime();
            if (r.b != 0)                     { bad = bad + 1; }
            if (r.c != 0)                     { bad = bad + 2; }
            if (r.inner.y != 0)               { bad = bad + 4; }
            if (constagg_probe_static.b != 0) { bad = bad + 8; }
        }
        $or {
            bad = bad + 32;
        }
    }
    ret bad;
}
