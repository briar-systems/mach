pub fun lower_rvalue(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val opt_e: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel opt_e.err) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: expression id out of range")};
    }
    var e_value: expr.Expr = opt_e.ok;
    val e: *expr.Expr = ?e_value;

    val saved_loc: source.SrcLoc = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, e.span.offset));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val res_: res[value.Value, fail.Fail] = lower_rvalue_kind(ctx, eid, e);
    if (sel res_.err) { ret res_; }
    ret res[value.Value, fail.Fail].ok{stamp_secret(ctx, eid, res_.ok)};
}

fun lower_rvalue_kind(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_LIT_INT)        { ret lower_lit_int(ctx, eid, e); }
    if (k == expr.EXPR_KIND_LIT_FLOAT)      { ret lower_lit_float(ctx, eid, e); }
    if (k == expr.EXPR_KIND_LIT_CHAR)       { ret lower_lit_char(ctx, eid, e); }
    if (k == expr.EXPR_KIND_LIT_STR)        { ret lower_lit_str(ctx, e); }
    if (k == expr.EXPR_KIND_LIT_NIL)        { ret lower_lit_nil(ctx, eid); }
    if (k == expr.EXPR_KIND_IDENT)          { ret lower_ident_rvalue(ctx, eid); }
    if (k == expr.EXPR_KIND_MEMBER)         { ret lower_member_rvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_PROJECT)        { ret lower_project_rvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_INDEX)          { ret lower_index_rvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_GENERIC_INSTANCE) { ret lower_generic_instance(ctx, eid, e); }
    if (k == expr.EXPR_KIND_CALL)           { ret lower_call(ctx, eid, e); }
    if (k == expr.EXPR_KIND_BINARY)         { ret lower_binary(ctx, eid, e); }
    if (k == expr.EXPR_KIND_UNARY)          { ret lower_unary(ctx, eid, e); }
    if (k == expr.EXPR_KIND_CAST)           { ret lower_cast(ctx, eid, e); }
    if (k == expr.EXPR_KIND_STRIP)          { ret lower_strip(ctx, e); }
    if (k == expr.EXPR_KIND_COMPTIME_IDENT) { ret lower_comptime_path(ctx, eid); }
    if (k == expr.EXPR_KIND_ARRAY_LIT)      { ret lower_array_lit(ctx, eid, e); }
    if (k == expr.EXPR_KIND_STRUCT_LIT)     { ret lower_struct_lit(ctx, eid, e); }
    if (k == expr.EXPR_KIND_VECTOR_LIT)     { ret lower_vector_lit(ctx, eid, e); }
    if (k == expr.EXPR_KIND_SEL)            { ret lower_sel(ctx, eid, e); }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported expression kind in rvalue position")};
}

fun stamp_secret(ctx: *context.LowerContext, eid: id.ExprId, v: value.Value) value.Value {
    var sec: bool = context.expr_is_secret(ctx, eid);
    if (!sec) { sec = compare_operand_secret(ctx, eid); }
    var out: value.Value = v;
    out.secret = sec;
    if (sec) {
        val fn: *ir.Function = ctx.builder.fn;
        instruction.mark_result_secret(fn.instrs, fn.instr_len, v);
    }
    ret out;
}

fun compare_operand_secret(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val e_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel e_opt.err) { ret false; }
    var e_value: expr.Expr = e_opt.ok;
    val e: *expr.Expr = ?e_value;
    if (e.kind != expr.EXPR_KIND_BINARY)     { ret false; }
    if (!is_compare_binop(e.data.binary.op)) { ret false; }
    ret context.expr_is_secret(ctx, e.data.binary.lhs) || context.expr_is_secret(ctx, e.data.binary.rhs);
}

pub fun lower_lvalue(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val opt_e: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel opt_e.err) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: lvalue id out of range")};
    }
    var e_value: expr.Expr = opt_e.ok;
    val e: *expr.Expr = ?e_value;

    val saved_loc: source.SrcLoc = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, e.span.offset));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val k: expr.ExprKind = ast.expr_place_kind(e);

    if (k == expr.EXPR_KIND_IDENT)   { ret lower_ident_lvalue(ctx, eid); }
    if (k == expr.EXPR_KIND_MEMBER)  { ret lower_member_lvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_PROJECT) { ret lower_project_lvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_INDEX)   { ret lower_index_lvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_UNARY) { ret lower_rvalue(ctx, e.data.unary.operand); }

    if (k == expr.EXPR_KIND_CALL) {
        val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        if (is_aggregate_ir(ctx, res_ir.ok)) {
            ret lower_rvalue(ctx, eid);
        }
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: expression is not an lvalue")};
}

fun lower_lit_int(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_int(e.data.lit_int.value, res_ir.ok)};
}

fun lower_lit_float(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_float(e.data.lit_float.value, res_ir.ok)};
}

fun lower_lit_char(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_int(e.data.lit_char::u64, res_ir.ok)};
}

pub fun lower_lit_str(ctx: *context.LowerContext, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ctx.m.types);
    if (sel res_ptr.err) { ret res[value.Value, fail.Fail].err{res_ptr.err}; }
    val pty: ir_type.IrTypeId = res_ptr.ok;

    val txt: str = context.module_source(ctx);
    var inner: View = view(nil, 0);
    if (e.span.len >= 2::usize) {
        inner = view(?txt[e.span.offset + 1::usize], e.span.len - 2::usize);
    }

    val res_sid: res[intern.StrId, fail.Fail] = intern_str_lit(ctx, inner);
    if (sel res_sid.err) {
        diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, e.span, fail.describe(res_sid.err));
        ret res[value.Value, fail.Fail].err{fail.reported()};
    }
    val opt_bytes: opt[str] = intern.lookup(?ctx.s.interner, res_sid.ok);
    if (sel opt_bytes.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: string literal lookup failed")}; }
    val bytes: str = opt_bytes.some;

    val blob: value.Value = value.const_bytes(bytes::*u8, (str_len(bytes) + 1::usize)::u32, pty);
    ret context.add_rodata_bytes(ctx, blob, pty);
}

fun intern_str_lit(ctx: *context.LowerContext, inner: View) res[intern.StrId, fail.Fail] {
    if (inner.len == 0 || !lit_has_escape(inner)) {
        val r_186: res[intern.StrId, A.Error] = intern.intern_bytes(?ctx.s.interner, inner.data::str, inner.len);
        if (sel r_186.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_186.err)}; }
        ret res[intern.StrId, fail.Fail].ok{r_186.ok};
    }

    val res_buf: res[*u8, A.Error] = A.allocate[u8](ctx.s.alloc, inner.len);
    if (sel res_buf.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8 = res_buf.ok;

    var read:  usize = 0;
    var write: usize = 0;
    for (read < inner.len) {
        val c: u8 = inner.data[read];
        if (c != '\\') {
            buf[write] = c;
            read  = read + 1;
            write = write + 1;
            cnt;
        }
        var consumed: usize = 0;
        val res_esc: res[u8, fail.Fail] = lit_decode_escape((?inner.data[read])::*u8, inner.len - read, ?consumed);
        if (sel res_esc.err) {
            A.deallocate[u8](ctx.s.alloc, buf, inner.len);
            ret res[intern.StrId, fail.Fail].err{res_esc.err};
        }
        buf[write] = res_esc.ok;
        read  = read + consumed;
        write = write + 1;
    }

    val res_id: res[intern.StrId, A.Error] = intern.intern_bytes(?ctx.s.interner, buf::str, write);
    A.deallocate[u8](ctx.s.alloc, buf, inner.len);
    if (sel res_id.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_id.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_id.ok};
}

fun lit_has_escape(s: View) bool {
    var i: usize = 0;
    for (i < s.len) {
        if (s.data[i] == '\\') { ret true; }
        i = i + 1;
    }
    ret false;
}

fun lit_decode_escape(p: *u8, len: usize, out_consumed: *usize) res[u8, fail.Fail] {
    if (len < 2) { ret res[u8, fail.Fail].err{fail.message("lower: incomplete escape sequence in string literal")}; }
    val c: u8 = p[1];

    if (c == 'n')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{10}; }
    if (c == 't')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{9}; }
    if (c == 'r')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{13}; }
    if (c == '\\') { @out_consumed = 2; ret res[u8, fail.Fail].ok{92}; }
    if (c == '\'') { @out_consumed = 2; ret res[u8, fail.Fail].ok{39}; }
    if (c == '"')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{34}; }
    if (c == '0')  { @out_consumed = 2; ret res[u8, fail.Fail].ok{0}; }
    if (c == 'x') {
        if (len < 4) { ret res[u8, fail.Fail].err{fail.message("lower: incomplete \\x escape in string literal")}; }
        val hi: i64 = lit_hex_digit(p[2]);
        val lo: i64 = lit_hex_digit(p[3]);
        if (hi < 0 || lo < 0) { ret res[u8, fail.Fail].err{fail.message("lower: invalid \\x escape in string literal")}; }
        @out_consumed = 4;
        ret res[u8, fail.Fail].ok{(hi * 16 + lo)::u8};
    }
    ret res[u8, fail.Fail].err{fail.message("lower: unknown escape sequence in string literal")};
}

fun lit_hex_digit(c: u8) i64 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i64; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i64 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i64 + 10; }
    ret -1;
}

fun lower_lit_nil(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_null(res_ir.ok)};
}

fun lower_ident_rvalue(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);

    val opt_cv: opt[comptime.CTValue] = comptime_param_value(ctx, sid);
    if (sel opt_cv.some) {
        ret const_value_of(ctx, eid, opt_cv.some);
    }

    val opt_ord: opt[u32] = pack_elem_ordinal(ctx, sid);
    if (sel opt_ord.some) {
        ret load_pack_elem(ctx, eid, opt_ord.some);
    }

    val opt_elem: opt[id.ExprId] = const_elem_expr(ctx, sid);
    if (sel opt_elem.some) {
        ret lower_rvalue(ctx, opt_elem.some);
    }

    val opt_direct: opt[comptime.CTValue] = comptime_each_direct_value(ctx, sid);
    if (sel opt_direct.some) {
        ret const_value_of(ctx, eid, opt_direct.some);
    }

    val opt_local: opt[value.Value] = context.lookup_local(ctx, sid);
    if (sel opt_local.some) {
        val slot: value.Value = opt_local.some;
        if (slot.kind == value.VAL_PARAM) {
            if (is_aggregate_ir(ctx, slot.ty)) { ret snapshot_aggregate(ctx, slot, context.expr_type_of(ctx, eid), false); }
            ret res[value.Value, fail.Fail].ok{slot};
        }
        val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        ret rvalue_at(ctx, slot, res_ir.ok, context.expr_type_of(ctx, eid), false);
    }
    ret symbol_reference(ctx, eid, sid);
}

fun pack_elem_ordinal(ctx: *context.LowerContext, sid: resolve.SymbolId) opt[u32] {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[u32].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret opt[u32].none{}; }
    if (sym.decl != id.DECL_NIL)                                                     { ret opt[u32].none{}; }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[u32].none{}; }
    val cval: comptime.CTValue = opt_nc.some.value;
    if (cval.kind != comptime.CT_KIND_PACK_ELEM) { ret opt[u32].none{}; }
    ret opt[u32].some{cval.data.pelem.index};
}

fun const_elem_expr(ctx: *context.LowerContext, sid: resolve.SymbolId) opt[id.ExprId] {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[id.ExprId].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret opt[id.ExprId].none{}; }
    if (sym.decl != id.DECL_NIL)                                                     { ret opt[id.ExprId].none{}; }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[id.ExprId].none{}; }
    val cval: comptime.CTValue = opt_nc.some.value;
    if (cval.kind != comptime.CT_KIND_CONST_ELEM) { ret opt[id.ExprId].none{}; }
    ret opt[id.ExprId].some{cval.data.celem.elem::id.ExprId};
}

fun comptime_each_direct_value(ctx: *context.LowerContext, sid: resolve.SymbolId) opt[comptime.CTValue] {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[comptime.CTValue].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret opt[comptime.CTValue].none{}; }
    if (sym.decl != id.DECL_NIL)                                                     { ret opt[comptime.CTValue].none{}; }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[comptime.CTValue].none{}; }
    val cval: comptime.CTValue = opt_nc.some.value;
    if (cval.kind == comptime.CT_KIND_CONST_ELEM) { ret opt[comptime.CTValue].none{}; }
    if (cval.kind == comptime.CT_KIND_PACK_ELEM)  { ret opt[comptime.CTValue].none{}; }
    ret opt[comptime.CTValue].some{cval};
}

# the initializer a member names inside a constant literal; for a case literal the single payload
# when the member is the case it holds, with `unselected` raised when it is another case
fun const_elem_field_expr(ctx: *context.LowerContext, elem_eid: id.ExprId, member_span: token.Span,
                          owner_ty: type.TypeId, unselected: *bool) id.ExprId {
    val el_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, elem_eid);
    if (sel el_opt.err) { ret id.EXPR_NIL; }
    var el_value: expr.Expr = el_opt.ok;
    val el: *expr.Expr = ?el_value;
    if (el.kind != expr.EXPR_KIND_STRUCT_LIT) { ret id.EXPR_NIL; }

    val src: str = context.module_source(ctx);
    val tag_ty: type.TypeId = type.strip_secret(?ctx.s.types, owner_ty);
    if (type.is_tag(?ctx.s.types, tag_ty)) {
        val res_head: res[opt[u32], fail.Fail] = literal_head_case_index(ctx, el.data.struct_lit.ty, tag_ty);
        if (sel res_head.err) { ret id.EXPR_NIL; }
        val head: opt[u32] = res_head.ok;
        if (sel head.none) { ret id.EXPR_NIL; }
        if (head.some != field_index_in_type(ctx, tag_ty, member_span)) { @unselected = true; ret id.EXPR_NIL; }
        if (el.data.struct_lit.elems_len != 1 || el.data.struct_lit.elems_start::usize >= ctx.scope.a.expr_id_len) { ret id.EXPR_NIL; }
        ret ctx.scope.a.expr_ids[el.data.struct_lit.elems_start];
    }

    val mname_r: res[intern.StrId, A.Error] = intern.intern_span(?ctx.s.interner, src, member_span);
    if (sel mname_r.err) { ret id.EXPR_NIL; }
    val mname: intern.StrId = mname_r.ok;

    var i: u32 = 0;
    for (i < el.data.struct_lit.fields_len) {
        val pool_ix: usize = (el.data.struct_lit.fields_start + i)::usize;
        if (pool_ix >= ctx.scope.a.field_init_len) { ret id.EXPR_NIL; }
        val fi: *expr.FieldInit = ?ctx.scope.a.field_inits[pool_ix];
        val fname_r: res[intern.StrId, A.Error] = intern.intern_span(?ctx.s.interner, src, fi.name);
        if (sel fname_r.err) { ret id.EXPR_NIL; }
        if (fname_r.ok == mname) { ret fi.value; }
        i = i + 1;
    }
    ret id.EXPR_NIL;
}

fun load_pack_elem(ctx: *context.LowerContext, eid: id.ExprId, ord: u32) res[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: pack element ordinal out of range")};
    }
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, ctx.pack_slots[ord], res_ir.ok, context.expr_type_of(ctx, eid), false);
}

fun is_spread_expr(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val opt_e: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel opt_e.err) { ret false; }
    ret opt_e.ok.kind == expr.EXPR_KIND_SPREAD;
}

fun call_has_spread(ctx: *context.LowerContext, e: *expr.Expr) bool {
    var i: u32 = 0;
    for (i < e.data.call.args_len) {
        val pool_ix: u32 = e.data.call.args_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len)          { ret false; }
        if (is_spread_expr(ctx, ctx.scope.a.expr_ids[pool_ix])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun load_pack_slot(ctx: *context.LowerContext, slot_ix: u32) res[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || slot_ix >= ctx.pack_len) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: pack slot index out of range")};
    }
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, ctx.pack_types[slot_ix]);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, ctx.pack_slots[slot_ix], res_ir.ok, ctx.pack_types[slot_ix], false);
}

fun comptime_param_value(ctx: *context.LowerContext, sid: resolve.SymbolId) opt[comptime.CTValue] {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[comptime.CTValue].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_PARAM || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) {
        ret opt[comptime.CTValue].none{};
    }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[comptime.CTValue].none{}; }
    ret opt[comptime.CTValue].some{opt_nc.some.value};
}

fun reference_linkage_name(ctx: *context.LowerContext, sym: *resolve.Symbol) res[intern.StrId, fail.Fail] {
    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    var export: opt[intern.StrId] = opt[intern.StrId].none{};
    if (sym.kind == resolve.SYM_IMPORTED || sym.decl != id.DECL_NIL) {
        val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
        if (sel acquired.err) { ret res[intern.StrId, fail.Fail].err{acquired.err}; }
        val current: scx.DefinedSymbol = acquired.ok;
        export = session.export_name(ctx.s, current.symbol.origin, current.symbol.decl::u32);
    }
    ret mangle.linkage_name(ctx.s, fqn, sym.canon, export);
}

pub fun symbol_linkage_name(ctx: *context.LowerContext, eid: id.ExprId) opt[intern.StrId] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[intern.StrId].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;

    val is_addressable: bool = sym.kind == resolve.SYM_FUN
        || sym.kind == resolve.SYM_VAL
        || sym.kind == resolve.SYM_VAR
        || sym.kind == resolve.SYM_IMPORTED;
    if (!is_addressable) { ret opt[intern.StrId].none{}; }

    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (sel res_ln.err) { ret opt[intern.StrId].none{}; }
    ret opt[intern.StrId].some{res_ln.ok};
}

fun symbol_reference(ctx: *context.LowerContext, eid: id.ExprId, sid: resolve.SymbolId) res[value.Value, fail.Fail] {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret report_expr(ctx, eid, "unresolved identifier");
    }
    val sym: *resolve.Symbol = opt_sym.some;

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val vty: ir_type.IrTypeId = res_ir.ok;

    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (sel res_ln.err) { ret res[value.Value, fail.Fail].err{res_ln.err}; }
    val link: intern.StrId = res_ln.ok;

    if (names_function(ctx, sym)) {
        val res_fn: res[value.Value, fail.Fail] = fn_reference(ctx, link, vty, references_import_function(ctx, sym));
        if (sel res_fn.err) { ret res_fn; }
        stamp_spirv_op(ctx, sym, res_fn.ok);
        val res_ci: err[fail.Fail] = stamp_body_provider(ctx, sym, res_fn.ok);
        if (sel res_ci.err) { ret res[value.Value, fail.Fail].err{res_ci.err}; }
        ret res_fn;
    }

    val res_cv: res[opt[comptime.CTValue], fail.Fail] = module_const_value(ctx, sym);
    if (sel res_cv.err) {
        ret res[value.Value, fail.Fail].err{res_cv.err};
    }
    val opt_cv: opt[comptime.CTValue] = res_cv.ok;
    if (sel opt_cv.some) {
        ret const_value_of(ctx, eid, opt_cv.some);
    }

    val opt_gi: opt[u32] = find_global(ctx, link);
    if (sel opt_gi.some) {
        ret emit_global_rvalue(ctx, eid, opt_gi.some, vty);
    }

    val res_xg: res[u32, fail.Fail] = context.ensure_extern_global(ctx, link, vty, references_import_data(ctx, sym));
    if (sel res_xg.err) { ret res[value.Value, fail.Fail].err{res_xg.err}; }
    ret emit_global_rvalue(ctx, eid, res_xg.ok, vty);
}

fun module_const_value(ctx: *context.LowerContext, sym: *resolve.Symbol) res[opt[comptime.CTValue], fail.Fail] {
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret res[opt[comptime.CTValue], fail.Fail].err{acquired.err}; }
    val current: scx.DefinedSymbol = acquired.ok;
    val oa: *ast.Ast = current.definition.parsed.a;
    if (oa == nil) { ret res[opt[comptime.CTValue], fail.Fail].err{fail.message("lower: module-level reference: origin module AST unavailable (invariant violated)")}; }
    val opt_d: opt[*decl.Decl] = ast.get_decl(oa, current.symbol.decl);
    if (sel opt_d.none) { ret res[opt[comptime.CTValue], fail.Fail].err{fail.message("lower: module-level reference: decl id out of range in origin AST (invariant violated)")}; }
    if (opt_d.some.kind != decl.DECL_KIND_VAL) { ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].none{}}; }

    val dctx: *comptime.ComptimeCtx = current.definition.ctx;
    if (dctx == nil) { ret res[opt[comptime.CTValue], fail.Fail].err{fail.message("lower: module-level reference: declaring module comptime context unavailable (invariant violated)")}; }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(dctx, current.symbol.canon);
    if (sel opt_nc.none) { ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].none{}}; }

    val named: comptime.NamedConst = opt_nc.some;
    if (named.gated && ctx.scope.env.union_build) {
        val msg: str = context.gated_lower_member_const_message(ctx, sym.name, session.module_fqn(ctx.s, sym.origin));
        var zero_span: token.Span;
        zero_span.offset = 0;
        zero_span.len    = 0;
        ret res[opt[comptime.CTValue], fail.Fail].err{context.report_gate(ctx, zero_span, msg)};
    }
    val v: comptime.CTValue = named.value;
    if (!const_has_no_identity(v)) { ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].none{}}; }
    ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].some{v}};
}

fun const_has_no_identity(v: comptime.CTValue) bool {
    ret v.kind == comptime.CT_KIND_INT
     || v.kind == comptime.CT_KIND_FLOAT;
}

pub fun references_function(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val tid: type.TypeId = context.expr_type_of(ctx, eid);
    val opt_t: opt[*type.Type] = type.get(?ctx.s.types, tid);
    if (sel opt_t.none) { ret false; }
    ret opt_t.some.kind == type.TYPE_FUN;
}

fun references_import_data(ctx: *context.LowerContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret false; }
    val current: scx.DefinedSymbol = acquired.ok;
    val origin_ast: *ast.Ast = current.definition.parsed.a;
    if (origin_ast == nil) { ret false; }
    val opt_d: opt[*decl.Decl] = ast.get_decl(origin_ast, current.symbol.decl);
    if (sel opt_d.none) { ret false; }
    val d: *decl.Decl = opt_d.some;
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) { ret false; }
    ret (d.flags & decl.DECL_FLAG_EXT) != 0;
}

fun stamp_spirv_op(ctx: *context.LowerContext, sym: *resolve.Symbol, v: value.Value) {
    if (v.kind != value.VAL_FN || v.data.fn_ix >= ctx.m.function_len) { ret; }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret; }
    val current: scx.DefinedSymbol = acquired.ok;
    val origin_ast: *ast.Ast = current.definition.parsed.a;
    if (origin_ast == nil) { ret; }
    val opt_d: opt[*decl.Decl] = ast.get_decl(origin_ast, current.symbol.decl);
    if (sel opt_d.none) { ret; }
    val fi: u32 = v.data.fn_ix;
    val set_v: u32 = context.decl_target_op(origin_ast, context.ast_source(ctx, origin_ast),
                                            opt_d.some, ctx.tgt.isa.defs,
                                            ?ctx.m.functions[fi].op_code);
    if (set_v != isa.NO_OP_SET) { ctx.m.functions[fi].op_set = set_v; }
}

fun references_import_function(ctx: *context.LowerContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret false; }
    val current: scx.DefinedSymbol = acquired.ok;
    val origin_ast: *ast.Ast = current.definition.parsed.a;
    if (origin_ast == nil) { ret false; }
    val opt_d: opt[*decl.Decl] = ast.get_decl(origin_ast, current.symbol.decl);
    if (sel opt_d.none) { ret false; }
    val d: *decl.Decl = opt_d.some;
    if (d.kind != decl.DECL_KIND_FUN) { ret false; }
    ret (d.flags & decl.DECL_FLAG_EXT) != 0;
}

fun stamp_body_provider(ctx: *context.LowerContext, sym: *resolve.Symbol, v: value.Value) err[fail.Fail] {
    if (v.kind != value.VAL_FN || v.data.fn_ix >= ctx.m.function_len) {
        ret err[fail.Fail].err{fail.message("lower: function reference has no IR function identity")};
    }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val current: scx.DefinedSymbol = acquired.ok;
    val parsed: *ast.Ast = current.definition.parsed.a;
    val declaration: opt[*decl.Decl] = ast.get_decl(parsed, current.symbol.decl);
    if (sel declaration.none) { ret err[fail.Fail].err{fail.message("lower: function definition has no current declaration")}; }
    val d: *decl.Decl = declaration.some;
    if (d.kind != decl.DECL_KIND_FUN) { ret err[fail.Fail].err{fail.message("lower: function reference acquired a non-function declaration")}; }
    if ((d.flags & decl.DECL_FLAG_EXT) != 0 || d.data.fun_.body == id.STMT_NIL) { ret err[fail.Fail].ok{}; }
    val origin: intern.StrId = session.module_fqn(ctx.s, current.symbol.origin);
    if (origin == intern.STR_NIL) { ret err[fail.Fail].err{fail.message("lower: function body has no stable module identity")}; }
    val fn: *ir.Function = ?ctx.m.functions[v.data.fn_ix];
    if (fn.body_module != intern.STR_NIL && fn.body_module != origin) {
        ret err[fail.Fail].err{fail.message("lower: one function linkage names conflicting body providers")};
    }
    fn.body_module = origin;
    ret err[fail.Fail].ok{};
}

fun names_function(ctx: *context.LowerContext, sym: *resolve.Symbol) bool {
    ret sym.kind == resolve.SYM_FUN
        || (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_FUN);
}

fun symbol_lvalue(ctx: *context.LowerContext, eid: id.ExprId, sid: resolve.SymbolId) res[value.Value, fail.Fail] {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret report_expr(ctx, eid, "unresolved identifier");
    }
    val sym: *resolve.Symbol = opt_sym.some;

    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (sel res_ln.err) { ret res[value.Value, fail.Fail].err{res_ln.err}; }
    val link: intern.StrId = res_ln.ok;

    val opt_gi: opt[u32] = find_global(ctx, link);
    if (sel opt_gi.some) {
        ret global_pointer(ctx, opt_gi.some);
    }

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val vty: ir_type.IrTypeId = res_ir.ok;
    val res_xg: res[u32, fail.Fail] = context.ensure_extern_global(ctx, link, vty, references_import_data(ctx, sym));
    if (sel res_xg.err) { ret res[value.Value, fail.Fail].err{res_xg.err}; }
    ret global_pointer(ctx, res_xg.ok);
}

fun lower_ident_lvalue(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);

    val opt_cv: opt[comptime.CTValue] = comptime_param_value(ctx, sid);
    if (sel opt_cv.some) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: cannot take the address of a comptime parameter")};
    }

    val opt_ord: opt[u32] = pack_elem_ordinal(ctx, sid);
    if (sel opt_ord.some) {
        val ord: u32 = opt_ord.some;
        if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: pack element ordinal out of range")};
        }
        ret res[value.Value, fail.Fail].ok{ctx.pack_slots[ord]};
    }

    val opt_celem: opt[id.ExprId] = const_elem_expr(ctx, sid);
    if (sel opt_celem.some) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: cannot take the address of a `$each` constant array element")};
    }

    val opt_local: opt[value.Value] = context.lookup_local(ctx, sid);
    if (sel opt_local.some) {
        ret res[value.Value, fail.Fail].ok{opt_local.some};
    }
    ret symbol_lvalue(ctx, eid, sid);
}

fun try_lower_const_elem_member(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) opt[res[value.Value, fail.Fail]] {
    val opt_elem: opt[id.ExprId] = const_elem_leaf_expr(ctx, e.data.member.object);
    if (sel opt_elem.none)                             { ret opt[res[value.Value, fail.Fail]].none{}; }

    var unselected: bool = false;
    val field_eid: id.ExprId = const_elem_field_expr(ctx, opt_elem.some, e.data.member.name,
        context.expr_type_of(ctx, e.data.member.object), ?unselected);
    # a payload the constant does not hold is reachable only under a `sel` that folded false, so
    # the dead read yields a zero of its type instead of storage that does not exist
    if (unselected)                                                 { ret opt[res[value.Value, fail.Fail]].some{dead_zero_value(ctx, eid)}; }
    if (field_eid == id.EXPR_NIL)                                   { ret opt[res[value.Value, fail.Fail]].none{}; }
    ret opt[res[value.Value, fail.Fail]].some{lower_rvalue(ctx, field_eid)};
}

# the literal expression a member path over a constant element reaches: the element itself for the
# binding, or the nested literal a field or selected payload holds
fun const_elem_leaf_expr(ctx: *context.LowerContext, eid: id.ExprId) opt[id.ExprId] {
    val e_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel e_opt.err) { ret opt[id.ExprId].none{}; }
    val e: expr.Expr = e_opt.ok;
    if (e.kind == expr.EXPR_KIND_IDENT) { ret const_elem_expr(ctx, context.expr_symbol_of(ctx, eid)); }
    if (e.kind != expr.EXPR_KIND_MEMBER) { ret opt[id.ExprId].none{}; }
    val inner: opt[id.ExprId] = const_elem_leaf_expr(ctx, e.data.member.object);
    if (sel inner.none) { ret opt[id.ExprId].none{}; }
    var unselected: bool = false;
    val leaf: id.ExprId = const_elem_field_expr(ctx, inner.some, e.data.member.name,
        context.expr_type_of(ctx, e.data.member.object), ?unselected);
    if (leaf == id.EXPR_NIL) { ret opt[id.ExprId].none{}; }
    ret opt[id.ExprId].some{leaf};
}

# the literal a constant-valued expression stands for, when it stands for one: a `$each` element or
# a module `val` initialized with an aggregate literal, a member path into such a literal, or an
# identity cast of one. a static initializer spelled over such a name folds the literal it names
pub fun constant_literal_expr(ctx: *context.LowerContext, eid: id.ExprId) opt[id.ExprId] {
    ret constant_literal_within(ctx, eid, 0);
}

# a constant may name another constant; the chain is finite in a checked program, and the bound
# only keeps a malformed one from recursing forever
val CONSTANT_LITERAL_DEPTH: u32 = 64;

fun constant_literal_within(ctx: *context.LowerContext, eid: id.ExprId, depth: u32) opt[id.ExprId] {
    if (depth >= CONSTANT_LITERAL_DEPTH) { ret opt[id.ExprId].none{}; }
    val e_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel e_opt.err) { ret opt[id.ExprId].none{}; }
    val e: expr.Expr = e_opt.ok;
    if (e.kind == expr.EXPR_KIND_CAST) {
        val from: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, e.data.cast.value));
        val to: type.TypeId   = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, eid));
        if (from != to || from == type.TYPE_NIL || from == type.TYPE_ERROR) { ret opt[id.ExprId].none{}; }
        ret constant_literal_within(ctx, e.data.cast.value, depth + 1);
    }
    if (e.kind == expr.EXPR_KIND_IDENT) {
        val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
        val each_elem: opt[id.ExprId] = const_elem_expr(ctx, sid);
        if (sel each_elem.some) { ret each_elem; }
        ret module_constant_literal(ctx, sid, depth + 1);
    }
    if (e.kind == expr.EXPR_KIND_MEMBER) {
        val inner: opt[id.ExprId] = constant_literal_within(ctx, e.data.member.object, depth + 1);
        if (sel inner.none) { ret opt[id.ExprId].none{}; }
        var unselected: bool = false;
        val leaf: id.ExprId = const_elem_field_expr(ctx, inner.some, e.data.member.name,
            context.expr_type_of(ctx, e.data.member.object), ?unselected);
        if (leaf == id.EXPR_NIL) { ret opt[id.ExprId].none{}; }
        ret literal_or_named(ctx, leaf, depth + 1);
    }
    if (e.kind == expr.EXPR_KIND_INDEX) {
        val inner: opt[id.ExprId] = constant_literal_within(ctx, e.data.index.object, depth + 1);
        if (sel inner.none) { ret opt[id.ExprId].none{}; }
        val arr_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, inner.some);
        if (sel arr_opt.err) { ret opt[id.ExprId].none{}; }
        if (arr_opt.ok.kind != expr.EXPR_KIND_ARRAY_LIT) { ret opt[id.ExprId].none{}; }
        val arr: expr.Expr = arr_opt.ok;
        val ix_r: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps,
            ctx.scope.a, context.module_source(ctx), e.data.index.index, ?ctx.s.interner);
        context.record_eval_result(ctx, ix_r);
        if (sel ix_r.err) { ret opt[id.ExprId].none{}; }
        val ix: comptime.CTValue = ix_r.ok;
        if (ix.kind != comptime.CT_KIND_INT || comptime.ct_is_negative(ix)) { ret opt[id.ExprId].none{}; }
        val n: u64 = ix.data.i:~u64;
        if (n >= arr.data.array_lit.elems_len::u64 || (arr.data.array_lit.elems_start::u64 + n) >= ctx.scope.a.expr_id_len::u64) { ret opt[id.ExprId].none{}; }
        ret literal_or_named(ctx, ctx.scope.a.expr_ids[arr.data.array_lit.elems_start::u64 + n], depth + 1);
    }
    ret opt[id.ExprId].none{};
}

# a leaf reached inside a literal may itself name a constant; the literal it names wins, otherwise
# the leaf is the expression to fold
fun literal_or_named(ctx: *context.LowerContext, leaf: id.ExprId, depth: u32) opt[id.ExprId] {
    val deeper: opt[id.ExprId] = constant_literal_within(ctx, leaf, depth);
    if (sel deeper.some) { ret deeper; }
    ret opt[id.ExprId].some{leaf};
}

# a module `val` names the aggregate literal its initializer is, or the one its initializer names
fun module_constant_literal(ctx: *context.LowerContext, sid: resolve.SymbolId, depth: u32) opt[id.ExprId] {
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[id.ExprId].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_MODULE) == 0 || sym.origin != ctx.scope.own_module) { ret opt[id.ExprId].none{}; }
    if (sym.decl == id.DECL_NIL) { ret opt[id.ExprId].none{}; }
    val d_opt: opt[*decl.Decl] = ast.get_decl(ctx.scope.a, sym.decl);
    if (sel d_opt.none) { ret opt[id.ExprId].none{}; }
    if (d_opt.some.kind != decl.DECL_KIND_VAL) { ret opt[id.ExprId].none{}; }
    val init: id.ExprId = d_opt.some.data.bind.init;
    if (init == id.EXPR_NIL) { ret opt[id.ExprId].none{}; }
    val i_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, init);
    if (sel i_opt.err) { ret opt[id.ExprId].none{}; }
    val k: expr.ExprKind = i_opt.ok.kind;
    if (k == expr.EXPR_KIND_STRUCT_LIT || k == expr.EXPR_KIND_ARRAY_LIT) { ret opt[id.ExprId].some{init}; }
    ret constant_literal_within(ctx, init, depth);
}

# whether a place is spelled over a constant element, which has no storage to address
fun place_roots_in_const_elem(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val e_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel e_opt.err) { ret false; }
    val e: expr.Expr = e_opt.ok;
    if (e.kind == expr.EXPR_KIND_IDENT) {
        val elem: opt[id.ExprId] = const_elem_expr(ctx, context.expr_symbol_of(ctx, eid));
        ret sel elem.some;
    }
    if (e.kind == expr.EXPR_KIND_MEMBER) { ret place_roots_in_const_elem(ctx, e.data.member.object); }
    ret false;
}

# evaluates an expression at compile time and materializes its scalar value
fun lower_comptime_value(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val r: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps,
        ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner);
    context.record_eval_result(ctx, r);
    if (sel r.err) {
        val f: comptime.EvalFail = r.err;
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { ret res[value.Value, fail.Fail].err{fail.message(f.message)}; }
        ret report_expr(ctx, eid, f.message);
    }
    ret const_value_of_init(ctx, eid, r.ok);
}

# a zero of an expression's type for a read the constant folding proved dead
fun dead_zero_value(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ity: ir_type.IrTypeId = res_ir.ok;
    if (ir_type.is_aggregate(?ctx.m.types, ity)) {
        val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
        if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
        val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, ity, value.const_int(1, res_xty.ok));
        if (sel res_slot.err) { ret res_slot; }
        val slot: value.Value = res_slot.ok;
        val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, ity);
        if (sel res_mz.err) { ret res[value.Value, fail.Fail].err{res_mz.err}; }
        ret res[value.Value, fail.Fail].ok{value.retype(slot, ity)};
    }
    val opt_ty: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, ity);
    if (sel opt_ty.some && opt_ty.some.kind == ir_type.IRT_FLOAT) {
        ret res[value.Value, fail.Fail].ok{value.const_float(0.0, ity)};
    }
    ret res[value.Value, fail.Fail].ok{value.const_int(0, ity)};
}

fun try_lower_field_member(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) opt[res[value.Value, fail.Fail]] {
    val src_text: str = context.module_source(ctx);
    val res_obj: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, e.data.member.object, ?ctx.s.interner);
    context.record_eval_result(ctx, res_obj);
    if (sel res_obj.err)                                     { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (!comptime.is_descriptor(res_obj.ok)) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_member: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, eid, ?ctx.s.interner);

    context.record_eval_result(ctx, res_member);
    if (sel res_member.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message(res_member.err.message)}}; }
    val v: comptime.CTValue = res_member.ok;
    if (v.kind == comptime.CT_KIND_INT) {
        val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}}; }
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int(v.data.i:~u64, res_ir.ok)}};
    }
    if (v.kind == comptime.CT_KIND_STR) {
        val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ctx.m.types);
        if (sel res_ptr.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ptr.err}}; }
        val pty: ir_type.IrTypeId = res_ptr.ok;
        val opt_bytes: opt[str] = intern.lookup(?ctx.s.interner, v.data.s);
        if (sel opt_bytes.none) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: field name lookup failed")}}; }
        val bytes: str = opt_bytes.some;
        val blob: value.Value = value.const_bytes(bytes::*u8, (str_len(bytes) + 1::usize)::u32, pty);
        ret opt[res[value.Value, fail.Fail]].some{context.add_rodata_bytes(ctx, blob, pty)};
    }
    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: unsupported field descriptor member in value position")}};
}

fun try_lower_pack_len(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) opt[res[value.Value, fail.Fail]] {
    val obj_ty: type.TypeId = context.expr_type_of(ctx, e.data.member.object);
    val opt_t: opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
    if (sel opt_t.none)                       { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (opt_t.some.kind != type.TYPE_PACK) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}};
    }
    val ity: ir_type.IrTypeId = res_ir.ok;
    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int(ctx.pack_len::u64, ity)}};
}

fun lower_member_rvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val opt_celem: opt[res[value.Value, fail.Fail]] = try_lower_const_elem_member(ctx, eid, e);
    if (sel opt_celem.some) { ret opt_celem.some; }

    val opt_pack_len: opt[res[value.Value, fail.Fail]] = try_lower_pack_len(ctx, eid, e);
    if (sel opt_pack_len.some) { ret opt_pack_len.some; }

    val opt_field: opt[res[value.Value, fail.Fail]] = try_lower_field_member(ctx, eid, e);
    if (sel opt_field.some) { ret opt_field.some; }

    val qsid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    if (qsid != resolve.SYMBOL_NIL) {
        ret symbol_reference(ctx, eid, qsid);
    }

    if (comptime.is_comptime_path(ctx.scope.a, eid)) {
        ret lower_comptime_path(ctx, eid);
    }

    val res_ptr: res[value.Value, fail.Fail] = lower_member_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, context.expr_type_of(ctx, eid), field_access_is_volatile(ctx, e.data.member.object));
}

fun lower_member_lvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val qsid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    if (qsid != resolve.SYMBOL_NIL) {
        ret symbol_lvalue(ctx, eid, qsid);
    }

    var rec_ty: type.TypeId;
    val res_base: res[value.Value, fail.Fail] = member_receiver(ctx, eid, e.data.member.object,
        "field access on untyped pointer; cast to a typed pointer (*T) first", ?rec_ty);
    if (sel res_base.err) { ret res_base; }

    val field_ix: u32 = field_index_in_type(ctx, rec_ty, e.data.member.name);
    val base: value.Value = res_base.ok;
    if (ctx.checks && type.is_tag(?ctx.s.types, rec_ty)) {
        val res_check: err[fail.Fail] = emit_case_check(ctx, base, rec_ty, field_ix);
        if (sel res_check.err) { ret res[value.Value, fail.Fail].err{res_check.err}; }
    }
    ret field_gep(ctx, base, rec_ty, field_ix);
}

# a guarded payload access in the debug profile traps when the discriminator no longer selects its case
fun emit_case_check(ctx: *context.LowerContext, base: value.Value, tag_ty: type.TypeId, case_ix: u32) err[fail.Fail] {
    val res_tag_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret err[fail.Fail].err{res_tag_ir.err}; }
    val tag_ir: ir_type.IrTypeId = res_tag_ir.ok;

    val res_disc: res[ir_type.IrTypeId, fail.Fail] =
        ir_type.intern_int(?ctx.m.types, ir_type.tag_discriminator_bytes(?ctx.m.types, tag_ir) * 8);
    if (sel res_disc.err) { ret err[fail.Fail].err{res_disc.err}; }
    val disc_ir: ir_type.IrTypeId = res_disc.ok;

    val res_code: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, base, disc_ir);
    if (sel res_code.err) { ret err[fail.Fail].err{res_code.err}; }
    val res_ok: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?ctx.builder,
        res_code.ok, value.const_int(case_ix::u64, disc_ir));
    if (sel res_ok.err) { ret err[fail.Fail].err{res_ok.err}; }

    val res_cont: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_cont.err) { ret err[fail.Fail].err{res_cont.err}; }
    val res_trap: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_trap.err) { ret err[fail.Fail].err{res_trap.err}; }
    val cont: ir.BlockId = res_cont.ok;
    val trap: ir.BlockId = res_trap.ok;

    val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, res_ok.ok, cont, trap);
    if (sel res_cbr.err) { ret res_cbr; }
    builder.set_block(?ctx.builder, trap);
    val res_unreachable: err[fail.Fail] = builder.emit_unreachable(?ctx.builder);
    if (sel res_unreachable.err) { ret res_unreachable; }
    builder.set_block(?ctx.builder, cont);
    ret err[fail.Fail].ok{};
}

fun project_field_index(ctx: *context.LowerContext, field_eid: id.ExprId) res[u32, fail.Fail] {
    val res_field: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), field_eid, ?ctx.s.interner);
    context.record_eval_result(ctx, res_field);
    if (sel res_field.err) { ret res[u32, fail.Fail].err{fail.message(res_field.err.message)}; }
    val fv: comptime.CTValue = res_field.ok;
    if (!comptime.is_descriptor(fv)) {
        ret res[u32, fail.Fail].err{fail.message("lower: `v.[f]` field operand is not a comptime field descriptor")};
    }
    ret res[u32, fail.Fail].ok{fv.data.fld.index};
}

fun lower_project_rvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_ptr: res[value.Value, fail.Fail] = lower_project_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, context.expr_type_of(ctx, eid), field_access_is_volatile(ctx, e.data.project.object));
}

fun lower_project_lvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_fix: res[u32, fail.Fail] = project_field_index(ctx, e.data.project.field);
    if (sel res_fix.err) { ret res[value.Value, fail.Fail].err{res_fix.err}; }
    val field_ix: u32 = res_fix.ok;

    var rec_ty: type.TypeId;
    val res_base: res[value.Value, fail.Fail] = member_receiver(ctx, eid, e.data.project.object,
        "field projection on untyped pointer; cast to a typed pointer (*T) first", ?rec_ty);
    if (sel res_base.err) { ret res_base; }

    val base: value.Value = res_base.ok;
    if (ctx.checks && type.is_tag(?ctx.s.types, rec_ty)) {
        val res_check: err[fail.Fail] = emit_case_check(ctx, base, rec_ty, field_ix);
        if (sel res_check.err) { ret res[value.Value, fail.Fail].err{res_check.err}; }
    }
    ret field_gep(ctx, base, rec_ty, field_ix);
}

fun vector_lane_of(ctx: *context.LowerContext, e: *expr.Expr) opt[res[u64, fail.Fail]] {
    val obj_ty: type.TypeId = context.expr_type_of(ctx, e.data.index.object);
    if (!type.is_vector(?ctx.s.types, obj_ty)) { ret opt[res[u64, fail.Fail]].none{}; }

    val cr: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        context.module_source(ctx), e.data.index.index, ?ctx.s.interner);

    context.record_eval_result(ctx, cr);
    if (sel cr.err) {
        ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].err{fail.message("lower: vector lane index is not a comptime constant")}};
    }
    val cv: comptime.CTValue = cr.ok;
    if (cv.kind != comptime.CT_KIND_INT || comptime.ct_is_negative(cv)) {
        ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].err{fail.message("lower: vector lane index is not a non-negative integer constant")}};
    }
    ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].ok{cv.data.i:~u64}};
}

fun lower_index_rvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val opt_lane: opt[res[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (sel opt_lane.some) {
        ret lower_vector_lane_read(ctx, eid, e, opt_lane.some);
    }
    val res_ptr: res[value.Value, fail.Fail] = lower_index_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, context.expr_type_of(ctx, eid), false);
}

fun lower_vector_lane_read(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr,
                           lane: res[u64, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel lane.err) { ret res[value.Value, fail.Fail].err{lane.err}; }

    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (sel res_vec.err) { ret res_vec; }

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }

    ret builder.emit_vec_extract(?ctx.builder,
        res_vec.ok,
        value.const_int(lane.ok, res_xty.ok),
        res_ir.ok);
}

fun lower_index_lvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, e.data.index.object));
    val is_ptr: bool        = is_pointer_type(ctx, obj_ty);

    var base: value.Value;
    if (is_ptr) {
        val res_base: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
        if (sel res_base.err) { ret res_base; }
        base = res_base.ok;
    } or {
        val res_base: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
        if (sel res_base.err) { ret res_base; }
        base = res_base.ok;
    }

    val res_ix: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.index);
    if (sel res_ix.err) { ret res_ix; }
    var ix: value.Value = res_ix.ok;

    val res_widen: res[value.Value, fail.Fail] = widen_index(ctx, ix, context.expr_type_of(ctx, e.data.index.index));
    if (sel res_widen.err) { ret res_widen; }
    ix = res_widen.ok;

    if (is_ptr) {
        val opt_pt: opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: index base has no pointer type")}; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type.TYPE_POINTER) {
            ret report_expr(ctx, eid, "index on untyped pointer; use a typed pointer (*T) to index");
        }
        val res_elem_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, pt.data.pointer.base);
        if (sel res_elem_ir.err) { ret res[value.Value, fail.Fail].err{res_elem_ir.err}; }
        var idx1: [1]value.Value;
        idx1[0] = ix;
        ret builder.emit_gep(?ctx.builder, base, res_elem_ir.ok, ?idx1[0], 1);
    }

    val res_obj_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, obj_ty);
    if (sel res_obj_ir.err) { ret res[value.Value, fail.Fail].err{res_obj_ir.err}; }
    var arr_ir: ir_type.IrTypeId = res_obj_ir.ok;

    if (type.is_vector(?ctx.s.types, obj_ty)) {
        val opt_v: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, arr_ir);
        if (sel opt_v.some) {
            val vt: *ir_type.IrType = opt_v.some;
            if (vt.kind == ir_type.IRT_VECTOR) {
                val elem:  ir_type.IrTypeId = vt.data.vector_.element;
                val lanes: u32              = vt.data.vector_.lanes;
                val res_arr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?ctx.m.types, elem, lanes);
                if (sel res_arr.err) { ret res[value.Value, fail.Fail].err{res_arr.err}; }
                arr_ir = res_arr.ok;
            }
        }
    }

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    var idx: [2]value.Value;
    idx[0] = value.const_int(0, xty);
    idx[1] = ix;
    ret builder.emit_gep(?ctx.builder, base, arr_ir, ?idx[0], 2);
}

fun interned_literal(ctx: *context.LowerContext, text: str) intern.StrId {
    val res_str: res[intern.StrId, A.Error] = intern.intern(?ctx.s.interner, text);
    if (sel res_str.err) { ret intern.STR_NIL; }
    ret res_str.ok;
}

pub fun try_lower_comptime_intrinsic(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) opt[res[value.Value, fail.Fail]] {
    val opt_ce: res[expr.Expr, fail.Fail] = context.expression(ctx, e.data.call.callee);
    if (sel opt_ce.err) { ret opt[res[value.Value, fail.Fail]].none{}; }
    var ce_value: expr.Expr = opt_ce.ok;
    val ce: *expr.Expr = ?ce_value;
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val ns: token.Span = comptime.comptime_ident_name(ce.span);
    if (ns.len == 0) { ret opt[res[value.Value, fail.Fail]].none{}; }
    val res_name: res[intern.StrId, A.Error] = intern.intern_span(?ctx.s.interner, context.module_source(ctx), ns);
    if (sel res_name.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.refused(res_name.err)}};
    }
    val name: intern.StrId = res_name.ok;

    if (name == interned_literal(ctx, "type_name")) {
        val tv: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner);
        context.record_eval_result(ctx, tv);
        if (sel tv.err) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message(tv.err.message)}};
        }
        ret opt[res[value.Value, fail.Fail]].some{const_value_of(ctx, eid, tv.ok)};
    }

    val is_size:   bool = name == interned_literal(ctx, "size_of");
    val is_align:  bool = name == interned_literal(ctx, "align_of");
    val is_offset: bool = name == interned_literal(ctx, "offset_of");
    val is_len:    bool = name == interned_literal(ctx, "length_of");
    if (!is_size && !is_align && !is_offset && !is_len) { ret opt[res[value.Value, fail.Fail]].none{}; }

    var arity: u32 = 1;
    if (is_offset) { arity = 2; }
    if (e.data.call.args_len < arity ||
        e.data.call.args_start::usize + e.data.call.args_len::usize > ctx.scope.a.expr_id_len) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: comptime intrinsic argument index out of range")}};
    }
    val arg0_eid: id.ExprId   = ctx.scope.a.expr_ids[e.data.call.args_start];
    val op_ty:    type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, arg0_eid));
    val res_op_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, op_ty);
    if (sel res_op_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_op_ir.err}};
    }
    val op_ir: ir_type.IrTypeId = res_op_ir.ok;

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}};
    }
    val rt: ir_type.IrTypeId = res_ir.ok;

    var n: u32 = 0;
    if (is_size)  { n = ir_type.byte_size_for_machine(?ctx.m.types, op_ir, resolved_target.layout_machine(ctx.tgt)); }
    if (is_align) { n = ir_type.byte_align_for_machine(?ctx.m.types, op_ir, resolved_target.layout_machine(ctx.tgt)); }
    if (is_len) {
        val c_opt: opt[u32] = type.element_count(?ctx.s.types, op_ty);
        if (sel c_opt.none) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: $length_of operand has no element count")}};
        }
        n = c_opt.some;
    }
    if (is_offset) {
        val f_eid: id.ExprId = ctx.scope.a.expr_ids[e.data.call.args_start + 1];
        val opt_f: res[expr.Expr, fail.Fail] = context.expression(ctx, f_eid);
        if (sel opt_f.err) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: offset_of field argument out of range")}};
        }
        val field_ix: u32 = field_index_in_type(ctx, op_ty, opt_f.ok.span);
        n = ir_type.byte_offset_for_machine(?ctx.m.types, op_ir, field_ix, resolved_target.layout_machine(ctx.tgt));
    }

    val dst_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, eid));
    val opt_dst: opt[*type.Type] = type.get(?ctx.s.types, dst_ty);
    if (sel opt_dst.some) {
        val d: type.PrimDesc = type.prim_desc(opt_dst.some.kind);
        if (d.class == type.PRIM_CLASS_INT) {
            var max: u64 = 0;
            if (d.signed) { max = (1::u64 << (d.bits - 1)::usize) - 1; }
            or            { max = ~(0::u64) >> (64 - d.bits)::usize; }
            if (n::u64 > max) {
                ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{context.report_gate(ctx, e.span, "a layout measurement does not fit the type it is assigned to; widen the binding or cast the measurement")}};
            }
        }
    }

    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int(n::u64, rt)}};
}

pub fun try_lower_comptime_cast(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) opt[res[value.Value, fail.Fail]] {
    if (e.kind != expr.EXPR_KIND_CAST) { ret opt[res[value.Value, fail.Fail]].none{}; }
    val opt_folded: opt[res[comptime.CTValue, comptime.EvalFail]] = fold_const_scalar(ctx, eid);
    if (sel opt_folded.none) { ret opt[res[value.Value, fail.Fail]].none{}; }
    val res_cv: res[comptime.CTValue, comptime.EvalFail] = opt_folded.some;
    if (sel res_cv.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message(res_cv.err.message)}};
    }
    ret opt[res[value.Value, fail.Fail]].some{const_value_of(ctx, eid, res_cv.ok)};
}

fun fold_const_scalar(ctx: *context.LowerContext, eid: id.ExprId) opt[res[comptime.CTValue, comptime.EvalFail]] {
    val evaluated: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner,
            context.expr_float_width(ctx, eid));
    context.record_eval_result(ctx, evaluated);
    if (sel evaluated.err && evaluated.err.kind != comptime.EVAL_FAIL_INTERNAL) {
        ret opt[res[comptime.CTValue, comptime.EvalFail]].none{};
    }
    ret opt[res[comptime.CTValue, comptime.EvalFail]].some{evaluated};
}

fun lower_call(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val opt_intr: opt[res[value.Value, fail.Fail]] = try_lower_comptime_intrinsic(ctx, eid, e);
    if (sel opt_intr.some) { ret opt_intr.some; }

    val res_callee: res[value.Value, fail.Fail] = lower_callee(ctx, eid, e);
    if (sel res_callee.err) { ret res_callee; }
    val callee: value.Value = res_callee.ok;

    val opt_cf: opt[*decl.DeclFun] = callee_decl_fun(ctx, e.data.call.callee);
    var has_ct:  bool          = false;
    var cf_decl: *decl.DeclFun = nil;
    var cf_ast:  *ast.Ast      = nil;
    if (sel opt_cf.some) {
        cf_decl = opt_cf.some;
        if (decl_fun_has_comptime_param(ctx, e.data.call.callee, cf_decl)) {
            has_ct = true;
            cf_ast = callee_ast(ctx, e.data.call.callee);
        }
    }

    val argc:       u32  = e.data.call.args_len;
    val has_spread: bool = call_has_spread(ctx, e);
    var rtc:        u32  = argc;
    if (has_ct)     { rtc = runtime_arg_count(ctx, cf_ast, cf_decl, argc); }
    if (has_spread) { rtc = (argc - 1) + ctx.pack_len; }

    var args: *value.Value = nil;
    if (rtc > 0) {
        val res_args: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, rtc::usize);
        if (sel res_args.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_args.err)}; }
        args = res_args.ok;

        var dst: u32 = 0;
        var i:   u32 = 0;
        for (i < argc) {
            if (has_ct && arg_is_comptime(ctx, cf_ast, cf_decl, i)) { i = i + 1; cnt; }
            val pool_ix: u32 = e.data.call.args_start + i;
            if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
                A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize);
                ret res[value.Value, fail.Fail].err{fail.message("lower: call argument index out of range")};
            }
            val arg_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
            if (has_spread && is_spread_expr(ctx, arg_eid)) {
                var ii: u32 = 0;
                for (ii < ctx.pack_len) {
                    val res_slot: res[value.Value, fail.Fail] = load_pack_slot(ctx, ii);
                    if (sel res_slot.err) {
                        A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize);
                        ret res_slot;
                    }
                    args[dst] = res_slot.ok;
                    dst = dst + 1;
                    ii  = ii + 1;
                }
                i = i + 1;
                cnt;
            }
            val res_arg: res[value.Value, fail.Fail] = lower_rvalue(ctx, arg_eid);
            if (sel res_arg.err) {
                A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize);
                ret res_arg;
            }
            args[dst] = res_arg.ok;
            # an aggregate argument whose bytes may hold a secret rides secret carriers, whatever its outer secrecy
            if (context.type_contains_secret(ctx, context.expr_type_of(ctx, arg_eid))) { args[dst].secret = true; }
            dst = dst + 1;
            i   = i + 1;
        }
    }
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) {
        if (args != nil) { A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize); }
        ret res[value.Value, fail.Fail].err{res_ir.err};
    }
    val rt: ir_type.IrTypeId = res_ir.ok;

    val res_call: res[value.Value, fail.Fail] = builder.emit_call(?ctx.builder, callee, args, rtc, rt);
    if (args != nil) { A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize); }
    if (sel res_call.err) { ret res_call; }
    var out: value.Value = res_call.ok;
    if (!out.secret && context.type_contains_secret(ctx, context.expr_type_of(ctx, eid))) {
        out.secret = true;
        instruction.mark_result_secret(ctx.builder.fn.instrs, ctx.builder.fn.instr_len, out);
    }
    ret res[value.Value, fail.Fail].ok{out};
}

fun runtime_arg_count(ctx: *context.LowerContext, a: *ast.Ast, f: *decl.DeclFun, argc: u32) u32 {
    if (a == nil) { ret argc; }
    var len: u32 = 0;
    var i:   u32 = 0;
    for (i < argc) {
        if (!arg_is_comptime(ctx, a, f, i)) { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

fun arg_is_comptime(ctx: *context.LowerContext, a: *ast.Ast, f: *decl.DeclFun, ord: u32) bool {
    if (a == nil)            { ret false; }
    if (ord >= f.params_len) { ret false; }
    ret a.typed_names[f.params_start + ord].comptime;
}

fun lower_callee(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val opt_cf: opt[*decl.DeclFun] = callee_decl_fun(ctx, e.data.call.callee);
    if (sel opt_cf.some) {
        val f: *decl.DeclFun = opt_cf.some;
        if (decl_fun_has_comptime_param(ctx, e.data.call.callee, f)) {
            if (f.generics_len > 0) {
                ret res[value.Value, fail.Fail].err{fail.message("lower: comptime value parameters on a generic function are not supported")};
            }
            ret lower_value_callee(ctx, eid, e, f);
        }
        if (decl_fun_has_pack_param(ctx, e.data.call.callee, f)) {
            ret lower_pack_callee(ctx, eid, e, f);
        }
    }
    if (e.data.call.type_args_len == 0) {
        ret lower_rvalue(ctx, e.data.call.callee);
    }
    ret lower_generic_instance(ctx, eid, e);
}

fun callee_decl_fun(ctx: *context.LowerContext, callee: id.ExprId) opt[*decl.DeclFun] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, callee);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[*decl.DeclFun].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED) { ret opt[*decl.DeclFun].none{}; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret opt[*decl.DeclFun].none{}; }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret opt[*decl.DeclFun].none{}; }
    val current: scx.DefinedSymbol = acquired.ok;
    val origin_ast: *ast.Ast = current.definition.parsed.a;
    val opt_d: opt[*decl.Decl] = ast.get_decl(origin_ast, current.symbol.decl);
    if (sel opt_d.none) { ret opt[*decl.DeclFun].none{}; }
    val d: *decl.Decl = opt_d.some;
    if (d.kind != decl.DECL_KIND_FUN) { ret opt[*decl.DeclFun].none{}; }
    ret opt[*decl.DeclFun].some{?d.data.fun_};
}

fun decl_fun_has_comptime_param(ctx: *context.LowerContext, callee: id.ExprId, f: *decl.DeclFun) bool {
    val origin_ast: *ast.Ast = callee_ast(ctx, callee);
    if (origin_ast == nil) { ret false; }
    var i: u32 = 0;
    for (i < f.params_len) {
        if (origin_ast.typed_names[f.params_start + i].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun decl_fun_has_pack_param(ctx: *context.LowerContext, callee: id.ExprId, f: *decl.DeclFun) bool {
    val origin_ast: *ast.Ast = callee_ast(ctx, callee);
    if (origin_ast == nil) { ret false; }
    if (f.params_len == 0) { ret false; }
    val tn: *decl.TypedName = ?origin_ast.typed_names[f.params_start + (f.params_len - 1)];
    val opt_t: opt[*atype.Type] = ast.get_type(origin_ast, tn.ty);
    if (sel opt_t.none) { ret false; }
    ret opt_t.some.kind == atype.TYPE_KIND_PACK;
}

fun callee_ast(ctx: *context.LowerContext, callee: id.ExprId) *ast.Ast {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, callee);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret nil; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.origin == ctx.scope.own_module) { ret ctx.scope.a; }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret nil; }
    ret acquired.ok.definition.parsed.a;
}

fun lower_value_callee(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr, f: *decl.DeclFun) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, e.data.call.callee);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: unresolved comptime-param call target")};
    }
    val sym: *resolve.Symbol = opt_sym.some;
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret res[value.Value, fail.Fail].err{acquired.err}; }
    val current: scx.DefinedSymbol = acquired.ok;
    val origin_ast: *ast.Ast = callee_ast(ctx, e.data.call.callee);
    if (origin_ast == nil) { ret res[value.Value, fail.Fail].err{fail.message("lower: comptime-param callee AST unavailable")}; }

    var ct_len: u32 = 0;
    var i:      u32 = 0;
    for (i < f.params_len) {
        if (origin_ast.typed_names[f.params_start + i].comptime) { ct_len = ct_len + 1; }
        i = i + 1;
    }
    if (ct_len == 0) { ret res[value.Value, fail.Fail].err{fail.message("lower: comptime-param call has no comptime parameters")}; }

    val res_vals: res[*comptime.CTValue, A.Error] = A.allocate[comptime.CTValue](ctx.s.alloc, ct_len::usize);
    if (sel res_vals.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_vals.err)}; }
    val vals: *comptime.CTValue = res_vals.ok;
    val res_names: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](ctx.s.alloc, ct_len::usize);
    if (sel res_names.err) {
        A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
        ret res[value.Value, fail.Fail].err{fail.refused(res_names.err)};
    }
    val names: *intern.StrId = res_names.ok;

    var dst: u32 = 0;
    var ii:  u32 = 0;
    for (ii < f.params_len) {
        val tn: *decl.TypedName = ?origin_ast.typed_names[f.params_start + ii];
        if (tn.comptime) {
            if (ii >= e.data.call.args_len) {
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret res[value.Value, fail.Fail].err{fail.message("lower: comptime-param call argument index out of range")};
            }
            val arg_eid: id.ExprId = ctx.scope.a.expr_ids[e.data.call.args_start + ii];
            val opt_fv: opt[comptime.CTValue] = fold_comptime_arg(ctx, arg_eid);
            if (sel opt_fv.none) {
                val arg_span: token.Span = expr_span_of(ctx, arg_eid);
                diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, arg_span, "comptime argument is not a compile-time constant");
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret res[value.Value, fail.Fail].err{fail.reported()};
            }
            vals[dst] = opt_fv.some;

            val opt_src: opt[*source.SourceFile] = source.get(?ctx.s.sources, origin_ast.file_id);
            if (sel opt_src.none) {
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret res[value.Value, fail.Fail].err{fail.message("lower: comptime-param callee origin module source unavailable")};
            }
            val origin_text: str = opt_src.some.text;
            val res_name: res[intern.StrId, A.Error] = intern.intern_span(?ctx.s.interner, origin_text, tn.name);
            if (sel res_name.err) {
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret res[value.Value, fail.Fail].err{fail.refused(res_name.err)};
            }
            names[dst] = res_name.ok;
            dst = dst + 1;
        }
        ii = ii + 1;
    }

    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    val res_link: res[intern.StrId, fail.Fail] = mangle.value_instance_name(ctx.s, fqn, sym.canon, vals, ct_len);
    if (sel res_link.err) {
        A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
        A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
        ret res[value.Value, fail.Fail].err{res_link.err};
    }
    val link: intern.StrId = res_link.ok;

    val res_enq: err[fail.Fail] = context.enqueue_value_instance(ctx, current.symbol.decl, sym.origin, vals, names, ct_len, link);
    A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
    A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
    if (sel res_enq.err) { ret res[value.Value, fail.Fail].err{res_enq.err}; }

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = context.instance_ref_sig(ctx, current.symbol.decl, sym.origin, nil, 0);
    if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
    ret fn_reference(ctx, link, res_sig.ok, false);
}

fun fold_comptime_arg(ctx: *context.LowerContext, eid: id.ExprId) opt[comptime.CTValue] {
    val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner,
                                     context.expr_float_width(ctx, eid));
    context.record_eval_result(ctx, res_eval);
    if (sel res_eval.ok) {
        ret opt[comptime.CTValue].some{res_eval.ok};
    }

    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[comptime.CTValue].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL && sym.kind != resolve.SYM_IMPORTED) { ret opt[comptime.CTValue].none{}; }

    val dctx: *comptime.ComptimeCtx = context.declaring_comptime_ctx(ctx, sym);
    if (dctx == nil) { ret opt[comptime.CTValue].none{}; }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(dctx, sym.canon);
    if (sel opt_nc.none) { ret opt[comptime.CTValue].none{}; }
    val named: comptime.NamedConst = opt_nc.some;
    if (named.gated && ctx.scope.env.union_build) {
        val msg: str = context.gated_lower_member_const_message(ctx, sym.name, session.module_fqn(ctx.s, sym.origin));
        context.report_gate(ctx, expr_span_of(ctx, eid), msg);
        ret opt[comptime.CTValue].none{};
    }
    ret opt[comptime.CTValue].some{named.value};
}

fun expr_span_of(ctx: *context.LowerContext, eid: id.ExprId) token.Span {
    val opt_e: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel opt_e.ok) { ret opt_e.ok.span; }
    var s: token.Span;
    s.offset = 0;
    s.len    = 0;
    ret s;
}

fun report_expr(ctx: *context.LowerContext, eid: id.ExprId, message: str) res[value.Value, fail.Fail] {
    diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, expr_span_of(ctx, eid), message);
    ret res[value.Value, fail.Fail].err{fail.reported()};
}

fun field_type_arg_of(ctx: *context.LowerContext, tid: id.TypeId) opt[type.TypeId] {
    val t_opt: opt[*atype.Type] = ast.get_type(ctx.scope.a, tid);
    if (sel t_opt.none) { ret opt[type.TypeId].none{}; }
    val t: *atype.Type = t_opt.some;

    if (t.kind == atype.TYPE_KIND_POINTEE_OF) {
        val inner: opt[type.TypeId] = field_type_arg_of(ctx, t.data.pointee_of.inner);
        if (sel inner.none) { ret opt[type.TypeId].none{}; }
        ret opt[type.TypeId].some{pointee_or_error(ctx, inner.some)};
    }

    if (t.kind != atype.TYPE_KIND_FIELD_TYPE) { ret opt[type.TypeId].none{}; }

    val r: res[intern.StrId, A.Error] =
        intern.intern_span(?ctx.s.interner, context.module_source(ctx), t.data.field_type.var_name);
    if (sel r.err) { fail.internal(?ctx.status, fail.describe(fail.refused(r.err))); ret opt[type.TypeId].none{}; }
    val gr: res[opt[u32], comptime.EvalFail] = comptime.field_type_of_binding[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, r.ok);
    if (sel gr.err) {
        val f: comptime.EvalFail = gr.err;
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?ctx.status, f.message); }
        ret opt[type.TypeId].none{};
    }
    val got: opt[u32] = gr.ok;
    if (sel got.none) { ret opt[type.TypeId].none{}; }
    ret opt[type.TypeId].some{got.some::type.TypeId};
}

fun pointee_or_error(ctx: *context.LowerContext, t: type.TypeId) type.TypeId {
    if (type.is_secret(?ctx.s.types, t)) { ret type.TYPE_ERROR; }
    val ty_opt: opt[*type.Type] = type.get(?ctx.s.types, t);
    if (sel ty_opt.none) { ret type.TYPE_ERROR; }
    val ty: *type.Type = ty_opt.some;
    if (ty.kind != type.TYPE_POINTER) { ret type.TYPE_ERROR; }
    ret ty.data.pointer.base;
}

fun collect_call_type_args(ctx: *context.LowerContext, e: *expr.Expr, argc: u32) res[*type.TypeId, fail.Fail] {
    if (argc == 0) { ret res[*type.TypeId, fail.Fail].ok{nil}; }

    val res_args: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](ctx.s.alloc, argc::usize);
    if (sel res_args.err) { ret res[*type.TypeId, fail.Fail].err{fail.refused(res_args.err)}; }
    val args: *type.TypeId = res_args.ok;

    var i: u32 = 0;
    for (i < argc) {
        val pool_ix: u32 = e.data.call.type_args_start + i;
        if (pool_ix::usize >= ctx.scope.a.type_id_len) {
            A.deallocate[type.TypeId](ctx.s.alloc, args, argc::usize);
            ret res[*type.TypeId, fail.Fail].err{fail.message("lower: call type-argument index out of range")};
        }
        var at: type.TypeId = type.TYPE_ERROR;
        val ft: opt[type.TypeId] = field_type_arg_of(ctx, ctx.scope.a.type_ids[pool_ix]);
        if (sel ft.some) {
            at = ft.some;
        }
        if (sel ft.none) {
            at = context.type_resolved_of(ctx, ctx.scope.a.type_ids[pool_ix]);
        }
        if (ctx.scope.subst != nil && ctx.scope.subst_len > 0) {
            at = context.recover_type(ctx, generics.substitute(ctx.s, at, ctx.scope.subst, ctx.scope.subst_len));
        }
        args[i] = at;
        i = i + 1;
    }
    ret res[*type.TypeId, fail.Fail].ok{args};
}

fun lower_generic_instance(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, e.data.call.callee);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: unresolved generic call target")};
    }
    val sym: *resolve.Symbol = opt_sym.some;
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret res[value.Value, fail.Fail].err{acquired.err}; }
    val current: scx.DefinedSymbol = acquired.ok;

    val argc: u32 = e.data.call.type_args_len;
    val res_args: res[*type.TypeId, fail.Fail] = collect_call_type_args(ctx, e, argc);
    if (sel res_args.err) { ret res[value.Value, fail.Fail].err{res_args.err}; }
    val args: *type.TypeId = res_args.ok;

    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    val res_link: res[intern.StrId, fail.Fail] = mangle.instance_name(ctx.s, fqn, sym.canon, args, argc);
    if (sel res_link.err) {
        free_type_args(ctx, args, argc);
        ret res[value.Value, fail.Fail].err{res_link.err};
    }
    val link: intern.StrId = res_link.ok;

    val res_enq: err[fail.Fail] = context.enqueue_instance(ctx, current.symbol.decl, sym.origin, args, argc, link, sym.name);
    if (sel res_enq.err) {
        free_type_args(ctx, args, argc);
        ret res[value.Value, fail.Fail].err{res_enq.err};
    }

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = context.instance_ref_sig(ctx, current.symbol.decl, sym.origin, args, argc);
    free_type_args(ctx, args, argc);
    if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
    ret fn_reference(ctx, link, res_sig.ok, false);
}

fun lower_pack_callee(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr, f: *decl.DeclFun) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, e.data.call.callee);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: unresolved pack-tailed call target")};
    }
    val sym: *resolve.Symbol = opt_sym.some;
    val acquired: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel acquired.err) { ret res[value.Value, fail.Fail].err{acquired.err}; }
    val current: scx.DefinedSymbol = acquired.ok;

    val argc: u32 = e.data.call.type_args_len;
    val res_args: res[*type.TypeId, fail.Fail] = collect_call_type_args(ctx, e, argc);
    if (sel res_args.err) { ret res[value.Value, fail.Fail].err{res_args.err}; }
    val args: *type.TypeId = res_args.ok;

    val fixed_len:  u32         = f.params_len - 1;
    var elem_len:   u32         = 0;
    var types:      *type.TypeId = nil;
    var owns_types: bool        = false;

    if (call_has_spread(ctx, e)) {
        elem_len = ctx.pack_len;
        types    = ctx.pack_types;
    } or {
        if (e.data.call.args_len < fixed_len) {
            free_type_args(ctx, args, argc);
            ret res[value.Value, fail.Fail].err{fail.message("lower: pack-tailed call has fewer arguments than fixed parameters")};
        }
        elem_len = e.data.call.args_len - fixed_len;
        if (elem_len > 0) {
            val res_types: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](ctx.s.alloc, elem_len::usize);
            if (sel res_types.err) {
                free_type_args(ctx, args, argc);
                ret res[value.Value, fail.Fail].err{fail.refused(res_types.err)};
            }
            types      = res_types.ok;
            owns_types = true;

            var i: u32 = 0;
            for (i < elem_len) {
                val pool_ix: u32 = e.data.call.args_start + fixed_len + i;
                if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
                    A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize);
                    free_type_args(ctx, args, argc);
                    ret res[value.Value, fail.Fail].err{fail.message("lower: pack-tailed call argument index out of range")};
                }
                val arg_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
                var et: type.TypeId = context.expr_type_of(ctx, arg_eid);
                if (ctx.scope.subst != nil && ctx.scope.subst_len > 0) {
                    et = context.recover_type(ctx, generics.substitute(ctx.s, et, ctx.scope.subst, ctx.scope.subst_len));
                }
                types[i] = et;
                i = i + 1;
            }
        }
    }

    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    val res_link: res[intern.StrId, fail.Fail] = mangle.pack_instance_name(ctx.s, fqn, sym.canon, args, argc, types, elem_len);
    if (sel res_link.err) {
        if (owns_types && types != nil) { A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize); }
        free_type_args(ctx, args, argc);
        ret res[value.Value, fail.Fail].err{res_link.err};
    }
    val link: intern.StrId = res_link.ok;

    val res_enq: err[fail.Fail] = context.enqueue_pack_instance(ctx, current.symbol.decl, sym.origin, args, argc, types, elem_len, link);
    if (sel res_enq.err) {
        if (owns_types && types != nil) { A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize); }
        free_type_args(ctx, args, argc);
        ret res[value.Value, fail.Fail].err{res_enq.err};
    }

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = context.pack_instance_ref_sig(ctx, current.symbol.decl, sym.origin, args, argc, types, elem_len);
    if (owns_types && types != nil)   { A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize); }
    free_type_args(ctx, args, argc);
    if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
    ret fn_reference(ctx, link, res_sig.ok, false);
}

fun free_type_args(ctx: *context.LowerContext, args: *type.TypeId, argc: u32) {
    if (args != nil && argc > 0) { A.deallocate[type.TypeId](ctx.s.alloc, args, argc::usize); }
}

fun lower_binary(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val op: expr.BinOp = e.data.binary.op;

    if (op == expr.BIN_ASSIGN)                   { ret lower_assign(ctx, e); }
    if (op == expr.BIN_AND || op == expr.BIN_OR) { ret lower_logical(ctx, e); }

    val res_lhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    var lhs: value.Value = res_lhs.ok;

    val res_rhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret res_rhs; }
    var rhs: value.Value = res_rhs.ok;

    val lty:    type.TypeId = context.expr_type_of(ctx, e.data.binary.lhs);
    val rty:    type.TypeId = context.expr_type_of(ctx, e.data.binary.rhs);
    val signed: bool        = is_signed_type(ctx, lty);

    if (type.is_vector(?ctx.s.types, lty)) {
        ret lower_vector_binary(ctx, op, lhs, rhs, lty);
    }

    if (is_compare_binop(op)) { ret lower_cmp(ctx, op, lhs, lty, rhs, rty); }

    if (op == expr.BIN_ADD) { ret builder.emit_add(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_SUB) { ret builder.emit_sub(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_MUL) { ret builder.emit_mul(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_DIV) {
        if (signed) { ret builder.emit_div_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_div_u(?ctx.builder, lhs, rhs);
    }
    if (op == expr.BIN_MOD) {
        if (is_float_type(ctx, lty)) { ret lower_float_rem(ctx, lhs, rhs); }
        if (signed)                  { ret builder.emit_rem_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_rem_u(?ctx.builder, lhs, rhs);
    }
    if (op == expr.BIN_BIT_AND) { ret builder.emit_and(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_BIT_OR)  { ret builder.emit_or(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_BIT_XOR) { ret builder.emit_xor(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_SHL)     { ret builder.emit_shl(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_SHR) {
        if (signed) { ret builder.emit_shr_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_shr_u(?ctx.builder, lhs, rhs);
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported binary operator")};
}

fun lower_vector_binary(ctx: *context.LowerContext, op: expr.BinOp, lhs: value.Value, rhs: value.Value, lty: type.TypeId) res[value.Value, fail.Fail] {
    if (is_compare_binop(op)) { ret lower_vector_compare(ctx, op, lhs, rhs, vector_lane_signed(ctx, lty)); }

    if (op == expr.BIN_ADD)     { ret builder.emit_add(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_SUB)     { ret builder.emit_sub(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_MUL)     { ret builder.emit_mul(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_DIV) {
        if (vector_lane_signed(ctx, lty)) { ret builder.emit_div_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_div_u(?ctx.builder, lhs, rhs);
    }
    if (op == expr.BIN_BIT_AND) { ret builder.emit_and(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_BIT_OR)  { ret builder.emit_or(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_BIT_XOR) { ret builder.emit_xor(?ctx.builder, lhs, rhs); }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported vector binary operator")};
}

fun lower_vector_compare(ctx: *context.LowerContext, op: expr.BinOp, lhs: value.Value, rhs: value.Value, signed: bool) res[value.Value, fail.Fail] {
    val res_mask: res[ir_type.IrTypeId, fail.Fail] = vector_mask_ir(ctx, lhs.ty);
    if (sel res_mask.err) { ret res[value.Value, fail.Fail].err{res_mask.err}; }
    val mask: ir_type.IrTypeId = res_mask.ok;

    if (op == expr.BIN_EQ)  { ret builder.emit_vcompare(?ctx.builder, instruction.OP_CMP_EQ, lhs, rhs, mask); }
    if (op == expr.BIN_NEQ) { ret builder.emit_vcompare(?ctx.builder, instruction.OP_CMP_NE, lhs, rhs, mask); }
    if (op == expr.BIN_LT)  { ret builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), lhs, rhs, mask); }
    if (op == expr.BIN_LEQ) { ret builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), lhs, rhs, mask); }
    if (op == expr.BIN_GT)  { ret builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), rhs, lhs, mask); }
    if (op == expr.BIN_GEQ) { ret builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), rhs, lhs, mask); }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported vector comparison operator")};
}

fun vec_cmp_lt(signed: bool) instruction.InstrKind {
    if (signed) { ret instruction.OP_CMP_LT_S; }
    ret instruction.OP_CMP_LT_U;
}

fun vec_cmp_le(signed: bool) instruction.InstrKind {
    if (signed) { ret instruction.OP_CMP_LE_S; }
    ret instruction.OP_CMP_LE_U;
}

fun vector_lane_signed(ctx: *context.LowerContext, lty: type.TypeId) bool {
    val base: type.TypeId = type.strip_secret(?ctx.s.types, lty);
    ret type.prim_desc(type.vector_element(?ctx.s.types, base)).signed;
}

fun vector_mask_ir(ctx: *context.LowerContext, vec_ir: ir_type.IrTypeId) res[ir_type.IrTypeId, fail.Fail] {
    val opt_v: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, vec_ir);
    if (sel opt_v.none) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: vector compare operand is not an IR vector")}; }
    val vt: *ir_type.IrType = opt_v.some;
    if (vt.kind != ir_type.IRT_VECTOR) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: vector compare operand is not an IR vector")}; }

    val opt_e: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, vt.data.vector_.element);
    if (sel opt_e.none) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: vector element type not resolvable")}; }
    val lane_bits: u32 = opt_e.some.data.bits;
    val lanes:     u32 = vt.data.vector_.lanes;

    val res_elem: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, lane_bits);
    if (sel res_elem.err) { ret res_elem; }
    ret ir_type.intern_vector(?ctx.m.types, res_elem.ok, lanes);
}

fun float_rem_narrow(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_i64.err) { ret res[value.Value, fail.Fail].err{res_i64.err}; }
    val i64ty: ir_type.IrTypeId = res_i64.ok;

    val res_q: res[value.Value, fail.Fail] = builder.emit_div_u(?ctx.builder, lhs, rhs);
    if (sel res_q.err) { ret res_q; }
    val q: value.Value = res_q.ok;

    val res_qi: res[value.Value, fail.Fail] = builder.emit_fp_to_si(?ctx.builder, q, i64ty);
    if (sel res_qi.err) { ret res_qi; }
    val qi: value.Value = res_qi.ok;

    val res_qf: res[value.Value, fail.Fail] = builder.emit_si_to_fp(?ctx.builder, qi, lhs.ty);
    if (sel res_qf.err) { ret res_qf; }
    val qf: value.Value = res_qf.ok;

    val res_prod: res[value.Value, fail.Fail] = builder.emit_mul(?ctx.builder, qf, rhs);
    if (sel res_prod.err) { ret res_prod; }
    val prod: value.Value = res_prod.ok;

    ret builder.emit_sub(?ctx.builder, lhs, prod);
}

fun float_abs(ctx: *context.LowerContext, v: value.Value, zero: value.Value) res[value.Value, fail.Fail] {
    val res_neg: res[value.Value, fail.Fail] = builder.emit_cmp_lt_u(?ctx.builder, v, zero);
    if (sel res_neg.err) { ret res_neg; }
    val is_neg: value.Value = res_neg.ok;

    val res_bneg: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bneg.err) { ret res[value.Value, fail.Fail].err{res_bneg.err}; }
    val blk_neg: ir.BlockId = res_bneg.ok;

    val res_bpos: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bpos.err) { ret res[value.Value, fail.Fail].err{res_bpos.err}; }
    val blk_pos: ir.BlockId = res_bpos.ok;

    val res_bmerge: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bmerge.err) { ret res[value.Value, fail.Fail].err{res_bmerge.err}; }
    val blk_merge: ir.BlockId = res_bmerge.ok;

    val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, is_neg, blk_neg, blk_pos);
    if (sel res_cbr.err) { ret res[value.Value, fail.Fail].err{res_cbr.err}; }

    builder.set_block(?ctx.builder, blk_neg);
    val res_negated: res[value.Value, fail.Fail] = builder.emit_sub(?ctx.builder, zero, v);
    if (sel res_negated.err) { ret res_negated; }
    val negated: value.Value = res_negated.ok;
    val res_br1: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_merge);
    if (sel res_br1.err) { ret res[value.Value, fail.Fail].err{res_br1.err}; }

    builder.set_block(?ctx.builder, blk_pos);
    val res_br2: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_merge);
    if (sel res_br2.err) { ret res[value.Value, fail.Fail].err{res_br2.err}; }

    builder.set_block(?ctx.builder, blk_merge);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, v.ty);
    if (sel res_phi.err) { ret res_phi; }
    val phi: value.Value = res_phi.ok;
    val res_in1: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, phi, blk_neg, negated);
    if (sel res_in1.err) { ret res[value.Value, fail.Fail].err{res_in1.err}; }
    val res_in2: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, phi, blk_pos, v);
    if (sel res_in2.err) { ret res[value.Value, fail.Fail].err{res_in2.err}; }

    ret res[value.Value, fail.Fail].ok{phi};
}

fun float_rem_reduce(ctx: *context.LowerContext, x0: value.Value, y: value.Value, two: value.Value) res[value.Value, fail.Fail] {
    val fty: ir_type.IrTypeId = x0.ty;

    val res_xhalf: res[value.Value, fail.Fail] = builder.emit_div_u(?ctx.builder, x0, two);
    if (sel res_xhalf.err) { ret res_xhalf; }
    val x_half: value.Value = res_xhalf.ok;

    val blk_entry: ir.BlockId = ctx.builder.block;

    val res_l1h: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l1h.err) { ret res[value.Value, fail.Fail].err{res_l1h.err}; }
    val l1_head: ir.BlockId = res_l1h.ok;

    val res_l1b: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l1b.err) { ret res[value.Value, fail.Fail].err{res_l1b.err}; }
    val l1_body: ir.BlockId = res_l1b.ok;

    val res_l1e: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l1e.err) { ret res[value.Value, fail.Fail].err{res_l1e.err}; }
    val l1_exit: ir.BlockId = res_l1e.ok;

    val res_enter1: err[fail.Fail] = builder.emit_br(?ctx.builder, l1_head);
    if (sel res_enter1.err) { ret res[value.Value, fail.Fail].err{res_enter1.err}; }

    builder.set_block(?ctx.builder, l1_head);
    val res_ykphi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, fty);
    if (sel res_ykphi.err) { ret res_ykphi; }
    val yk_phi1: value.Value = res_ykphi.ok;
    val res_c1: res[value.Value, fail.Fail] = builder.emit_cmp_le_u(?ctx.builder, yk_phi1, x_half);
    if (sel res_c1.err) { ret res_c1; }
    val res_cbr1: err[fail.Fail] = builder.emit_cbr(?ctx.builder, res_c1.ok, l1_body, l1_exit);
    if (sel res_cbr1.err) { ret res[value.Value, fail.Fail].err{res_cbr1.err}; }

    builder.set_block(?ctx.builder, l1_body);
    val res_ykn: res[value.Value, fail.Fail] = builder.emit_mul(?ctx.builder, yk_phi1, two);
    if (sel res_ykn.err) { ret res_ykn; }
    val yk_next1: value.Value = res_ykn.ok;
    val res_back1: err[fail.Fail] = builder.emit_br(?ctx.builder, l1_head);
    if (sel res_back1.err) { ret res[value.Value, fail.Fail].err{res_back1.err}; }

    val res_i1a: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, yk_phi1, blk_entry, y);
    if (sel res_i1a.err) { ret res[value.Value, fail.Fail].err{res_i1a.err}; }
    val res_i1b: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, yk_phi1, l1_body, yk_next1);
    if (sel res_i1b.err) { ret res[value.Value, fail.Fail].err{res_i1b.err}; }

    builder.set_block(?ctx.builder, l1_exit);

    val res_l2h: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l2h.err) { ret res[value.Value, fail.Fail].err{res_l2h.err}; }
    val l2_head: ir.BlockId = res_l2h.ok;

    val res_l2s: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l2s.err) { ret res[value.Value, fail.Fail].err{res_l2s.err}; }
    val l2_sub: ir.BlockId = res_l2s.ok;

    val res_l2n: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l2n.err) { ret res[value.Value, fail.Fail].err{res_l2n.err}; }
    val l2_nosub: ir.BlockId = res_l2n.ok;

    val res_l2m: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l2m.err) { ret res[value.Value, fail.Fail].err{res_l2m.err}; }
    val l2_merge: ir.BlockId = res_l2m.ok;

    val res_l2e: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l2e.err) { ret res[value.Value, fail.Fail].err{res_l2e.err}; }
    val l2_exit: ir.BlockId = res_l2e.ok;

    val res_l2g: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_l2g.err) { ret res[value.Value, fail.Fail].err{res_l2g.err}; }
    val l2_sub_gate: ir.BlockId = res_l2g.ok;

    val res_enter2: err[fail.Fail] = builder.emit_br(?ctx.builder, l2_head);
    if (sel res_enter2.err) { ret res[value.Value, fail.Fail].err{res_enter2.err}; }

    builder.set_block(?ctx.builder, l2_head);
    val res_xphi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, fty);
    if (sel res_xphi.err) { ret res_xphi; }
    val x_phi: value.Value = res_xphi.ok;
    val res_ykphi2: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, fty);
    if (sel res_ykphi2.err) { ret res_ykphi2; }
    val yk_phi2: value.Value = res_ykphi2.ok;
    val res_c2: res[value.Value, fail.Fail] = builder.emit_cmp_le_u(?ctx.builder, y, yk_phi2);
    if (sel res_c2.err) { ret res_c2; }
    val res_cbr2: err[fail.Fail] = builder.emit_cbr(?ctx.builder, res_c2.ok, l2_sub_gate, l2_exit);
    if (sel res_cbr2.err) { ret res[value.Value, fail.Fail].err{res_cbr2.err}; }

    builder.set_block(?ctx.builder, l2_sub_gate);
    val res_c3: res[value.Value, fail.Fail] = builder.emit_cmp_le_u(?ctx.builder, yk_phi2, x_phi);
    if (sel res_c3.err) { ret res_c3; }
    val res_cbr3: err[fail.Fail] = builder.emit_cbr(?ctx.builder, res_c3.ok, l2_sub, l2_nosub);
    if (sel res_cbr3.err) { ret res[value.Value, fail.Fail].err{res_cbr3.err}; }

    builder.set_block(?ctx.builder, l2_sub);
    val res_xsub: res[value.Value, fail.Fail] = builder.emit_sub(?ctx.builder, x_phi, yk_phi2);
    if (sel res_xsub.err) { ret res_xsub; }
    val x_subbed: value.Value = res_xsub.ok;
    val res_brs: err[fail.Fail] = builder.emit_br(?ctx.builder, l2_merge);
    if (sel res_brs.err) { ret res[value.Value, fail.Fail].err{res_brs.err}; }

    builder.set_block(?ctx.builder, l2_nosub);
    val res_brn2: err[fail.Fail] = builder.emit_br(?ctx.builder, l2_merge);
    if (sel res_brn2.err) { ret res[value.Value, fail.Fail].err{res_brn2.err}; }

    builder.set_block(?ctx.builder, l2_merge);
    val res_xnphi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, fty);
    if (sel res_xnphi.err) { ret res_xnphi; }
    val x_next: value.Value = res_xnphi.ok;
    val res_i3a: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, x_next, l2_sub, x_subbed);
    if (sel res_i3a.err) { ret res[value.Value, fail.Fail].err{res_i3a.err}; }
    val res_i3b: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, x_next, l2_nosub, x_phi);
    if (sel res_i3b.err) { ret res[value.Value, fail.Fail].err{res_i3b.err}; }

    val res_yknext2: res[value.Value, fail.Fail] = builder.emit_div_u(?ctx.builder, yk_phi2, two);
    if (sel res_yknext2.err) { ret res_yknext2; }
    val yk_next2: value.Value = res_yknext2.ok;
    val res_back2: err[fail.Fail] = builder.emit_br(?ctx.builder, l2_head);
    if (sel res_back2.err) { ret res[value.Value, fail.Fail].err{res_back2.err}; }

    val res_i2a: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, x_phi, l1_exit, x0);
    if (sel res_i2a.err) { ret res[value.Value, fail.Fail].err{res_i2a.err}; }
    val res_i2b: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, x_phi, l2_merge, x_next);
    if (sel res_i2b.err) { ret res[value.Value, fail.Fail].err{res_i2b.err}; }
    val res_i2c: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, yk_phi2, l1_exit, yk_phi1);
    if (sel res_i2c.err) { ret res[value.Value, fail.Fail].err{res_i2c.err}; }
    val res_i2d: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, yk_phi2, l2_merge, yk_next2);
    if (sel res_i2d.err) { ret res[value.Value, fail.Fail].err{res_i2d.err}; }

    builder.set_block(?ctx.builder, l2_exit);
    ret res[value.Value, fail.Fail].ok{x_phi};
}

fun float_rem_general(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value, zero: value.Value, two: value.Value) res[value.Value, fail.Fail] {
    val res_aneg: res[value.Value, fail.Fail] = builder.emit_cmp_lt_u(?ctx.builder, lhs, zero);
    if (sel res_aneg.err) { ret res_aneg; }
    val a_neg: value.Value = res_aneg.ok;

    val res_x0: res[value.Value, fail.Fail] = float_abs(ctx, lhs, zero);
    if (sel res_x0.err) { ret res_x0; }
    val x0: value.Value = res_x0.ok;

    val res_y: res[value.Value, fail.Fail] = float_abs(ctx, rhs, zero);
    if (sel res_y.err) { ret res_y; }
    val y: value.Value = res_y.ok;

    val res_reduced: res[value.Value, fail.Fail] = float_rem_reduce(ctx, x0, y, two);
    if (sel res_reduced.err) { ret res_reduced; }
    val reduced: value.Value = res_reduced.ok;

    val res_bneg: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bneg.err) { ret res[value.Value, fail.Fail].err{res_bneg.err}; }
    val blk_neg: ir.BlockId = res_bneg.ok;

    val res_bpos: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bpos.err) { ret res[value.Value, fail.Fail].err{res_bpos.err}; }
    val blk_pos: ir.BlockId = res_bpos.ok;

    val res_bmerge: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bmerge.err) { ret res[value.Value, fail.Fail].err{res_bmerge.err}; }
    val blk_merge: ir.BlockId = res_bmerge.ok;

    val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, a_neg, blk_neg, blk_pos);
    if (sel res_cbr.err) { ret res[value.Value, fail.Fail].err{res_cbr.err}; }

    builder.set_block(?ctx.builder, blk_neg);
    val res_negr: res[value.Value, fail.Fail] = builder.emit_neg(?ctx.builder, reduced);
    if (sel res_negr.err) { ret res_negr; }
    val neg_reduced: value.Value = res_negr.ok;
    val res_br1: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_merge);
    if (sel res_br1.err) { ret res[value.Value, fail.Fail].err{res_br1.err}; }

    builder.set_block(?ctx.builder, blk_pos);
    val res_br2: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_merge);
    if (sel res_br2.err) { ret res[value.Value, fail.Fail].err{res_br2.err}; }

    builder.set_block(?ctx.builder, blk_merge);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, lhs.ty);
    if (sel res_phi.err) { ret res_phi; }
    val phi: value.Value = res_phi.ok;
    val res_in1: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, phi, blk_neg, neg_reduced);
    if (sel res_in1.err) { ret res[value.Value, fail.Fail].err{res_in1.err}; }
    val res_in2: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, phi, blk_pos, reduced);
    if (sel res_in2.err) { ret res[value.Value, fail.Fail].err{res_in2.err}; }

    ret res[value.Value, fail.Fail].ok{phi};
}

fun float_rem_needs_narrow(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value, zero: value.Value, two: value.Value) res[value.Value, fail.Fail] {
    val res_bzero: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?ctx.builder, rhs, zero);
    if (sel res_bzero.err) { ret res_bzero; }
    val b_zero: value.Value = res_bzero.ok;
    val blk_entry: ir.BlockId = ctx.builder.block;

    val res_check: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_check.err) { ret res[value.Value, fail.Fail].err{res_check.err}; }
    val blk_check: ir.BlockId = res_check.ok;
    val res_nonzero: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_nonzero.err) { ret res[value.Value, fail.Fail].err{res_nonzero.err}; }
    val blk_nonzero: ir.BlockId = res_nonzero.ok;
    val res_inner: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_inner.err) { ret res[value.Value, fail.Fail].err{res_inner.err}; }
    val blk_inner: ir.BlockId = res_inner.ok;
    val res_outer: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_outer.err) { ret res[value.Value, fail.Fail].err{res_outer.err}; }
    val blk_outer: ir.BlockId = res_outer.ok;

    val res_cbr0: err[fail.Fail] = builder.emit_cbr(?ctx.builder, b_zero, blk_outer, blk_check);
    if (sel res_cbr0.err) { ret res[value.Value, fail.Fail].err{res_cbr0.err}; }
    builder.set_block(?ctx.builder, blk_check);
    val res_a2: res[value.Value, fail.Fail] = builder.emit_mul(?ctx.builder, lhs, two);
    if (sel res_a2.err) { ret res_a2; }
    val a2: value.Value = res_a2.ok;
    val res_eqa2: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?ctx.builder, lhs, a2);
    if (sel res_eqa2.err) { ret res_eqa2; }
    val a_eq_2a: value.Value = res_eqa2.ok;
    val res_cbr1: err[fail.Fail] = builder.emit_cbr(?ctx.builder, a_eq_2a, blk_nonzero, blk_inner);
    if (sel res_cbr1.err) { ret res[value.Value, fail.Fail].err{res_cbr1.err}; }

    builder.set_block(?ctx.builder, blk_nonzero);
    val res_ne: res[value.Value, fail.Fail] = builder.emit_cmp_ne(?ctx.builder, lhs, zero);
    if (sel res_ne.err) { ret res_ne; }
    val a_ne_zero: value.Value = res_ne.ok;
    val res_br_inner: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_inner);
    if (sel res_br_inner.err) { ret res[value.Value, fail.Fail].err{res_br_inner.err}; }

    builder.set_block(?ctx.builder, blk_inner);
    val res_iphi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, b_zero.ty);
    if (sel res_iphi.err) { ret res_iphi; }
    val inner: value.Value = res_iphi.ok;
    val res_i0: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, inner, blk_check, a_eq_2a);
    if (sel res_i0.err) { ret res[value.Value, fail.Fail].err{res_i0.err}; }
    val res_i1: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, inner, blk_nonzero, a_ne_zero);
    if (sel res_i1.err) { ret res[value.Value, fail.Fail].err{res_i1.err}; }
    val res_br_outer: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_outer);
    if (sel res_br_outer.err) { ret res[value.Value, fail.Fail].err{res_br_outer.err}; }

    builder.set_block(?ctx.builder, blk_outer);
    val res_ophi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, b_zero.ty);
    if (sel res_ophi.err) { ret res_ophi; }
    val outer: value.Value = res_ophi.ok;
    val res_o0: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, outer, blk_entry, b_zero);
    if (sel res_o0.err) { ret res[value.Value, fail.Fail].err{res_o0.err}; }
    val res_o1: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, outer, blk_inner, inner);
    if (sel res_o1.err) { ret res[value.Value, fail.Fail].err{res_o1.err}; }
    ret res[value.Value, fail.Fail].ok{outer};
}

fun lower_float_rem(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    val zero: value.Value = value.const_float(0.0, lhs.ty);
    val two: value.Value = value.const_float(2.0, lhs.ty);
    val res_narrow_needed: res[value.Value, fail.Fail] = float_rem_needs_narrow(ctx, lhs, rhs, zero, two);
    if (sel res_narrow_needed.err) { ret res_narrow_needed; }
    val narrow_needed: value.Value = res_narrow_needed.ok;

    val res_bn: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bn.err) { ret res[value.Value, fail.Fail].err{res_bn.err}; }
    val blk_narrow: ir.BlockId = res_bn.ok;
    val res_bg: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bg.err) { ret res[value.Value, fail.Fail].err{res_bg.err}; }
    val blk_general: ir.BlockId = res_bg.ok;
    val res_bj: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_bj.err) { ret res[value.Value, fail.Fail].err{res_bj.err}; }
    val blk_join: ir.BlockId = res_bj.ok;
    val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, narrow_needed, blk_narrow, blk_general);
    if (sel res_cbr.err) { ret res[value.Value, fail.Fail].err{res_cbr.err}; }

    builder.set_block(?ctx.builder, blk_narrow);
    val res_narrow: res[value.Value, fail.Fail] = float_rem_narrow(ctx, lhs, rhs);
    if (sel res_narrow.err) { ret res_narrow; }
    val narrow_result: value.Value = res_narrow.ok;
    val narrow_end: ir.BlockId = ctx.builder.block;
    val res_brn: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_join);
    if (sel res_brn.err) { ret res[value.Value, fail.Fail].err{res_brn.err}; }

    builder.set_block(?ctx.builder, blk_general);
    val res_general: res[value.Value, fail.Fail] = float_rem_general(ctx, lhs, rhs, zero, two);
    if (sel res_general.err) { ret res_general; }
    val general_result: value.Value = res_general.ok;
    val general_end: ir.BlockId = ctx.builder.block;
    val res_brg: err[fail.Fail] = builder.emit_br(?ctx.builder, blk_join);
    if (sel res_brg.err) { ret res[value.Value, fail.Fail].err{res_brg.err}; }

    builder.set_block(?ctx.builder, blk_join);
    val res_phi: res[value.Value, fail.Fail] = builder.emit_phi(?ctx.builder, lhs.ty);
    if (sel res_phi.err) { ret res_phi; }
    val phi: value.Value = res_phi.ok;
    val res_in1: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, phi, narrow_end, narrow_result);
    if (sel res_in1.err) { ret res[value.Value, fail.Fail].err{res_in1.err}; }
    val res_in2: err[fail.Fail] = builder.phi_add_incoming(?ctx.builder, phi, general_end, general_result);
    if (sel res_in2.err) { ret res[value.Value, fail.Fail].err{res_in2.err}; }

    ret res[value.Value, fail.Fail].ok{phi};
}

fun is_compare_binop(op: expr.BinOp) bool {
    ret op == expr.BIN_EQ  || op == expr.BIN_NEQ ||
        op == expr.BIN_LT  || op == expr.BIN_LEQ ||
        op == expr.BIN_GT  || op == expr.BIN_GEQ;
}

fun lower_cmp(ctx: *context.LowerContext, op: expr.BinOp, lhs: value.Value, lty: type.TypeId, rhs: value.Value, rty: type.TypeId) res[value.Value, fail.Fail] {
    if (is_float_type(ctx, lty) || is_float_type(ctx, rty)) {
        var fl: value.Value = lhs;
        var fr: value.Value = rhs;
        val res_unify: err[fail.Fail] = unify_float_compare_widths(ctx, ?fl, lty, ?fr, rty);
        if (sel res_unify.err) { ret res[value.Value, fail.Fail].err{res_unify.err}; }
        ret emit_cmp_int(ctx, op, false, fl, fr);
    }

    val ls: bool = is_signed_type(ctx, lty);
    val rs: bool = is_signed_type(ctx, rty);

    if (ls == rs) {
        var sl: value.Value = lhs;
        var sr: value.Value = rhs;
        val res_unify: err[fail.Fail] = unify_int_compare_widths(ctx, ?sl, lty, ?sr, rty);
        if (sel res_unify.err) { ret res[value.Value, fail.Fail].err{res_unify.err}; }
        ret emit_cmp_int(ctx, op, ls, sl, sr);
    }

    var s_val:    value.Value = lhs;
    var s_ty:     type.TypeId = lty;
    var u_val:    value.Value = rhs;
    var u_ty:     type.TypeId = rty;
    var s_is_lhs: bool        = true;
    if (!ls) {
        s_val    = rhs;
        s_ty     = rty;
        u_val    = lhs;
        u_ty     = lty;
        s_is_lhs = false;
    }

    val res_i64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_i64.err) { ret res[value.Value, fail.Fail].err{res_i64.err}; }
    val ty64: ir_type.IrTypeId = res_i64.ok;

    val res_s64: res[value.Value, fail.Fail] = widen_signed_to_i64(ctx, s_val, s_ty, ty64);
    if (sel res_s64.err) { ret res_s64; }
    val s64: value.Value = res_s64.ok;

    if (scalar_bits(ctx, u_ty) < 64) {
        val res_u64: res[value.Value, fail.Fail] = builder.emit_zext(?ctx.builder, u_val, ty64);
        if (sel res_u64.err) { ret res_u64; }
        val u64v: value.Value = res_u64.ok;
        if (s_is_lhs) { ret emit_cmp_int(ctx, op, true, s64, u64v); }
        ret emit_cmp_int(ctx, op, true, u64v, s64);
    }

    ret lower_cmp_signed_u64(ctx, op, s64, u_val, s_is_lhs, ty64);
}

fun emit_cmp_int(ctx: *context.LowerContext, op: expr.BinOp, signed: bool, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    if (op == expr.BIN_EQ)  { ret builder.emit_cmp_eq(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_NEQ) { ret builder.emit_cmp_ne(?ctx.builder, lhs, rhs); }
    if (op == expr.BIN_LT) {
        if (signed) { ret builder.emit_cmp_lt_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_cmp_lt_u(?ctx.builder, lhs, rhs);
    }
    if (op == expr.BIN_LEQ) {
        if (signed) { ret builder.emit_cmp_le_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_cmp_le_u(?ctx.builder, lhs, rhs);
    }
    if (op == expr.BIN_GT) {
        if (signed) { ret builder.emit_cmp_lt_s(?ctx.builder, rhs, lhs); }
        ret builder.emit_cmp_lt_u(?ctx.builder, rhs, lhs);
    }
    if (op == expr.BIN_GEQ) {
        if (signed) { ret builder.emit_cmp_le_s(?ctx.builder, rhs, lhs); }
        ret builder.emit_cmp_le_u(?ctx.builder, rhs, lhs);
    }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comparison operator")};
}

fun widen_signed_to_i64(ctx: *context.LowerContext, v: value.Value, vty: type.TypeId, ty64: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (scalar_bits(ctx, vty) >= 64) { ret res[value.Value, fail.Fail].ok{v}; }
    ret builder.emit_sext(?ctx.builder, v, ty64);
}

fun lower_cmp_signed_u64(ctx: *context.LowerContext, op: expr.BinOp, s64: value.Value, u: value.Value, s_is_lhs: bool, ty64: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var nop: expr.BinOp = op;
    if (!s_is_lhs) { nop = swap_cmp_op(op); }
    val zero: value.Value = value.const_int(0, ty64);

    if (nop == expr.BIN_LT) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
                        builder.emit_cmp_lt_u(?ctx.builder, s64, u));
    }
    if (nop == expr.BIN_LEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
                        builder.emit_cmp_le_u(?ctx.builder, s64, u));
    }
    if (nop == expr.BIN_GT) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
                         builder.emit_cmp_lt_u(?ctx.builder, u, s64));
    }
    if (nop == expr.BIN_GEQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
                         builder.emit_cmp_le_u(?ctx.builder, u, s64));
    }
    if (nop == expr.BIN_EQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
                         builder.emit_cmp_eq(?ctx.builder, s64, u));
    }
    if (nop == expr.BIN_NEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
                        builder.emit_cmp_ne(?ctx.builder, s64, u));
    }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comparison operator")};
}

fun swap_cmp_op(op: expr.BinOp) expr.BinOp {
    if (op == expr.BIN_LT)  { ret expr.BIN_GT; }
    if (op == expr.BIN_LEQ) { ret expr.BIN_GEQ; }
    if (op == expr.BIN_GT)  { ret expr.BIN_LT; }
    if (op == expr.BIN_GEQ) { ret expr.BIN_LEQ; }
    ret op;
}

fun cmp_or(ctx: *context.LowerContext, a: res[value.Value, fail.Fail], b: res[value.Value, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel a.err) { ret a; }
    if (sel b.err) { ret b; }
    ret builder.emit_or(?ctx.builder, a.ok, b.ok);
}

fun cmp_and(ctx: *context.LowerContext, a: res[value.Value, fail.Fail], b: res[value.Value, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel a.err) { ret a; }
    if (sel b.err) { ret b; }
    ret builder.emit_and(?ctx.builder, a.ok, b.ok);
}

fun unify_float_compare_widths(ctx: *context.LowerContext, lhs: *value.Value, lty: type.TypeId, rhs: *value.Value, rty: type.TypeId) err[fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == rw) { ret err[fail.Fail].ok{}; }
    if (lw < rw) {
        val res_ext: res[value.Value, fail.Fail] = builder.emit_fp_ext(?ctx.builder, @lhs, rhs.ty);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        @lhs = res_ext.ok;
        ret err[fail.Fail].ok{};
    }
    val res_ext: res[value.Value, fail.Fail] = builder.emit_fp_ext(?ctx.builder, @rhs, lhs.ty);
    if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
    @rhs = res_ext.ok;
    ret err[fail.Fail].ok{};
}

fun unify_int_compare_widths(ctx: *context.LowerContext, lhs: *value.Value, lty: type.TypeId, rhs: *value.Value, rty: type.TypeId) err[fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == 0 || rw == 0 || lw == rw) { ret err[fail.Fail].ok{}; }
    if (lw < rw) {
        val res_ext: res[value.Value, fail.Fail] = extend_int_value(ctx, @lhs, lty, rhs.ty);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        @lhs = res_ext.ok;
        ret err[fail.Fail].ok{};
    }
    val res_ext: res[value.Value, fail.Fail] = extend_int_value(ctx, @rhs, rty, lhs.ty);
    if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
    @rhs = res_ext.ok;
    ret err[fail.Fail].ok{};
}

fun extend_int_value(ctx: *context.LowerContext, v: value.Value, from: type.TypeId, to: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (is_signed_type(ctx, from)) { ret builder.emit_sext(?ctx.builder, v, to); }
    ret builder.emit_zext(?ctx.builder, v, to);
}

fun lower_assign(ctx: *context.LowerContext, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_rhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret res_rhs; }
    val rhs: value.Value = res_rhs.ok;

    val wrote_r: res[bool, fail.Fail] = lower_vector_lane_write(ctx, e.data.binary.lhs, rhs);
    if (sel wrote_r.err) { ret res[value.Value, fail.Fail].err{wrote_r.err}; }
    if (wrote_r.ok) { ret assign_epilogue(ctx, e, rhs); }

    val res_lhs: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val ptr: value.Value = res_lhs.ok;

    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, rhs, ptr);
    if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
    if (lvalue_is_volatile_field(ctx, e.data.binary.lhs)
        || value_is_volatile_record(ctx, e.data.binary.rhs)
        || value_is_volatile_record(ctx, e.data.binary.lhs)) { builder.mark_last_volatile(?ctx.builder); }

    ret assign_epilogue(ctx, e, rhs);
}

fun assign_epilogue(ctx: *context.LowerContext, e: *expr.Expr, rhs: value.Value) res[value.Value, fail.Fail] {
    if (context.type_is_secret(ctx, context.expr_type_of(ctx, e.data.binary.lhs))) {
        builder.mark_last_secret(?ctx.builder);
    }

    if (ctx.debug) {
        val opt_lhs: res[expr.Expr, fail.Fail] = context.expression(ctx, e.data.binary.lhs);
        if (sel opt_lhs.ok) {
            var lhs_e_value: expr.Expr = opt_lhs.ok;
            val lhs_e: *expr.Expr = ?lhs_e_value;
            if (lhs_e.kind == expr.EXPR_KIND_IDENT) {
                val lhs_sem: type.TypeId = context.expr_type_of(ctx, e.data.binary.lhs);
                val res_dbg: err[fail.Fail] = context.emit_dbg_birth(ctx, lhs_e.span, rhs.ty, lhs_sem, false, rhs, opt[value.Value].none{});
                if (sel res_dbg.err) {
                    ret res[value.Value, fail.Fail].err{res_dbg.err};
                }
            }
        }
    }
    ret res[value.Value, fail.Fail].ok{rhs};
}

fun lower_vector_lane_write(ctx: *context.LowerContext, lhs: id.ExprId, rhs: value.Value) res[bool, fail.Fail] {
    val opt_e: res[expr.Expr, fail.Fail] = context.expression(ctx, lhs);
    if (sel opt_e.err) { ret res[bool, fail.Fail].ok{false}; }
    var e_value: expr.Expr = opt_e.ok;
    val e: *expr.Expr = ?e_value;
    if (e.kind != expr.EXPR_KIND_INDEX) { ret res[bool, fail.Fail].ok{false}; }

    val opt_lane: opt[res[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (sel opt_lane.none) { ret res[bool, fail.Fail].ok{false}; }
    val lane_r: res[u64, fail.Fail] = opt_lane.some;
    if (sel lane_r.err) { ret res[bool, fail.Fail].err{lane_r.err}; }

    val res_slot: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
    if (sel res_slot.err) { ret res[bool, fail.Fail].err{res_slot.err}; }
    val slot: value.Value = res_slot.ok;

    val res_vty: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.expr_type_of(ctx, e.data.index.object));
    if (sel res_vty.err) { ret res[bool, fail.Fail].err{res_vty.err}; }
    val vty: ir_type.IrTypeId = res_vty.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[bool, fail.Fail].err{res_xty.err}; }

    val res_old: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, slot, vty);
    if (sel res_old.err) { ret res[bool, fail.Fail].err{res_old.err}; }

    val res_new: res[value.Value, fail.Fail] = builder.emit_vec_insert(?ctx.builder,
        res_old.ok,
        value.const_int(lane_r.ok, res_xty.ok),
        rhs);
    if (sel res_new.err) { ret res[bool, fail.Fail].err{res_new.err}; }

    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_new.ok, slot);
    if (sel res_store.err) { ret res[bool, fail.Fail].err{res_store.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun lower_logical(ctx: *context.LowerContext, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_i8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 8);
    if (sel res_i8.err) { ret res[value.Value, fail.Fail].err{res_i8.err}; }
    val i8: ir_type.IrTypeId = res_i8.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, i8, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_lhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val res_lhs_condition: res[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.lhs, res_lhs.ok);
    if (sel res_lhs_condition.err) { ret res_lhs_condition; }
    val lhs: value.Value = res_lhs_condition.ok;
    val res_store_lhs: err[fail.Fail] = builder.emit_store(?ctx.builder, lhs, slot);
    if (sel res_store_lhs.err) { ret res[value.Value, fail.Fail].err{res_store_lhs.err}; }

    val res_rhs_block: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_rhs_block.err) { ret res[value.Value, fail.Fail].err{res_rhs_block.err}; }
    val rhs_block: ir.BlockId = res_rhs_block.ok;

    val res_join: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_join.err) { ret res[value.Value, fail.Fail].err{res_join.err}; }
    val join: ir.BlockId = res_join.ok;

    var res_cbr: err[fail.Fail] = err[fail.Fail].ok{};
    if (e.data.binary.op == expr.BIN_AND) {
        res_cbr = builder.emit_cbr(?ctx.builder, lhs, rhs_block, join);
    } or {
        res_cbr = builder.emit_cbr(?ctx.builder, lhs, join, rhs_block);
    }
    if (sel res_cbr.err) { ret res[value.Value, fail.Fail].err{res_cbr.err}; }

    builder.set_block(?ctx.builder, rhs_block);
    val res_rhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret res_rhs; }
    val res_rhs_condition: res[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.rhs, res_rhs.ok);
    if (sel res_rhs_condition.err) { ret res_rhs_condition; }
    val res_store_rhs: err[fail.Fail] = builder.emit_store(?ctx.builder, res_rhs_condition.ok, slot);
    if (sel res_store_rhs.err) { ret res[value.Value, fail.Fail].err{res_store_rhs.err}; }
    val res_br: err[fail.Fail] = builder.emit_br(?ctx.builder, join);
    if (sel res_br.err) { ret res[value.Value, fail.Fail].err{res_br.err}; }

    builder.set_block(?ctx.builder, join);
    ret builder.emit_load(?ctx.builder, slot, i8);
}

fun address_operand_names_function(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val e_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel e_opt.err) { ret false; }
    var e_value: expr.Expr = e_opt.ok;
    val e: *expr.Expr = ?e_value;
    if (e.kind == expr.EXPR_KIND_GENERIC_INSTANCE) { ret true; }
    if (e.kind != expr.EXPR_KIND_IDENT && e.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    val sym_opt: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel sym_opt.none) { ret false; }
    ret names_function(ctx, sym_opt.some);
}

fun lower_unary(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val op: expr.UnOp = e.data.unary.op;

    if (op == expr.UN_ADDR) {
        if (address_operand_names_function(ctx, e.data.unary.operand)) {
            ret lower_rvalue(ctx, e.data.unary.operand);
        }
        ret lower_lvalue(ctx, e.data.unary.operand);
    }
    if (op == expr.UN_DEREF) {
        val res_ptr: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
        if (sel res_ptr.err) { ret res_ptr; }
        val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, context.expr_type_of(ctx, eid), false);
    }

    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
    if (sel res_v.err) { ret res_v; }
    val v: value.Value = res_v.ok;

    if (op == expr.UN_NEG)     { ret builder.emit_neg(?ctx.builder, v); }
    if (op == expr.UN_BIT_NOT) { ret builder.emit_not(?ctx.builder, v); }
    if (op == expr.UN_NOT) { ret builder.emit_cmp_ne(?ctx.builder, v, value.const_int(1, v.ty)); }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported unary operator")};
}

pub fun condition_value(ctx: *context.LowerContext, eid: id.ExprId, v: value.Value) res[value.Value, fail.Fail] {
    val e_opt: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel e_opt.ok) {
        var e_value: expr.Expr = e_opt.ok;
        val e: *expr.Expr = ?e_value;
        if (e.kind == expr.EXPR_KIND_BINARY && (is_compare_binop(e.data.binary.op) || e.data.binary.op == expr.BIN_AND || e.data.binary.op == expr.BIN_OR)) { ret res[value.Value, fail.Fail].ok{v}; }
        if (e.kind == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_NOT) {
            ret res[value.Value, fail.Fail].ok{v};
        }
        # a runtime `sel` is already the discriminator compare; a folded one stays a constant
        if (e.kind == expr.EXPR_KIND_SEL && v.kind != value.VAL_CONST_INT) {
            ret res[value.Value, fail.Fail].ok{v};
        }
    }
    ret builder.emit_cmp_eq(?ctx.builder, v, value.const_int(1, v.ty));
}

fun lower_cast(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.cast.value);
    if (sel res_v.err) { ret res_v; }
    val v: value.Value = res_v.ok;

    val from_ty: type.TypeId = context.expr_type_of(ctx, e.data.cast.value);
    val to_ty:   type.TypeId = context.type_resolved_of(ctx, e.data.cast.ty);

    val res_dst: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, to_ty);
    if (sel res_dst.err) { ret res[value.Value, fail.Fail].err{res_dst.err}; }
    val dst: ir_type.IrTypeId = res_dst.ok;

    if (e.data.cast.reinterpret || !type.is_numeric(?ctx.s.types, from_ty) || !type.is_numeric(?ctx.s.types, to_ty)) {
        ret lower_reinterpret(ctx, v, from_ty, dst);
    }

    val from_float:  bool = is_float_type(ctx, from_ty);
    val to_float:    bool = is_float_type(ctx, to_ty);
    val from_signed: bool = is_signed_type(ctx, from_ty);
    val to_signed:   bool = is_signed_type(ctx, to_ty);
    val from_bits:   u32  = scalar_bits(ctx, from_ty);
    val to_bits:     u32  = scalar_bits(ctx, to_ty);

    if (from_float && to_float) {
        if (to_bits < from_bits) { ret builder.emit_fp_trunc(?ctx.builder, v, dst); }
        if (to_bits > from_bits) { ret builder.emit_fp_ext(?ctx.builder, v, dst); }
        ret emit_retype(ctx, v, dst);
    }
    if (from_float && !to_float) {
        if (to_signed) { ret builder.emit_fp_to_si(?ctx.builder, v, dst); }
        ret builder.emit_fp_to_ui(?ctx.builder, v, dst);
    }
    if (!from_float && to_float) {
        if (from_signed) { ret builder.emit_si_to_fp(?ctx.builder, v, dst); }
        ret builder.emit_ui_to_fp(?ctx.builder, v, dst);
    }

    if (to_bits < from_bits) { ret builder.emit_trunc(?ctx.builder, v, dst); }
    if (to_bits > from_bits) {
        if (from_signed) { ret builder.emit_sext(?ctx.builder, v, dst); }
        ret builder.emit_zext(?ctx.builder, v, dst);
    }
    ret emit_retype(ctx, v, dst);
}

fun emit_retype(ctx: *context.LowerContext, v: value.Value, dst: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (v.ty == dst) { ret res[value.Value, fail.Fail].ok{v}; }
    ret builder.emit_bitcast(?ctx.builder, v, dst);
}

fun lower_reinterpret(ctx: *context.LowerContext, v: value.Value, from_ty: type.TypeId, dst: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val res_src: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, from_ty);
    if (sel res_src.err) { ret res[value.Value, fail.Fail].err{res_src.err}; }
    val src: ir_type.IrTypeId = res_src.ok;

    val src_agg: bool = is_aggregate_ir(ctx, src);
    val dst_agg: bool = is_aggregate_ir(ctx, dst);
    if (src_agg == dst_agg) { ret emit_retype(ctx, v, dst); }

    if (src_agg) {
        val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ctx.m.types);
        if (sel res_ptr.err) { ret res[value.Value, fail.Fail].err{res_ptr.err}; }
        ret builder.emit_load(?ctx.builder, value.retype(v, res_ptr.ok), dst);
    }

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, dst, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, v, slot);
    if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, dst)};
}

fun lower_strip(ctx: *context.LowerContext, e: *expr.Expr) res[value.Value, fail.Fail] {
    val res_inner: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.strip.value);
    if (sel res_inner.err) { ret res_inner; }
    ret builder.emit_declassify(?ctx.builder, res_inner.ok);
}

fun lower_comptime_path(ctx: *context.LowerContext, eid: id.ExprId) res[value.Value, fail.Fail] {
    val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner,
                                     context.expr_float_width(ctx, eid));
    context.record_eval_result(ctx, res_eval);
    if (sel res_eval.err) { ret res[value.Value, fail.Fail].err{fail.message(res_eval.err.message)}; }
    ret const_value_of(ctx, eid, res_eval.ok);
}

fun lower_array_lit(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val arr_ty: type.TypeId = context.expr_type_of(ctx, eid);
    val res_arr_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, arr_ty);
    if (sel res_arr_ir.err) { ret res[value.Value, fail.Fail].err{res_arr_ir.err}; }
    val arr_ir: ir_type.IrTypeId = res_arr_ir.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, arr_ir, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    var i: u32 = 0;
    for (i < e.data.array_lit.elems_len) {
        val pool_ix: u32 = e.data.array_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: array literal element index out of range")};
        }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
        val res_elem: res[value.Value, fail.Fail] = lower_rvalue(ctx, elem_eid);
        if (sel res_elem.err) { ret res_elem; }

        var idx: [2]value.Value;
        idx[0] = value.const_int(0, xty);
        idx[1] = value.const_int(i::u64, xty);
        val res_gep: res[value.Value, fail.Fail] = builder.emit_gep(?ctx.builder, slot, arr_ir, ?idx[0], 2);
        if (sel res_gep.err) { ret res_gep; }
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_elem.ok, res_gep.ok);
        if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
        i = i + 1;
    }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, arr_ir)};
}

fun lower_vector_lit(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val vec_ty: type.TypeId = context.expr_type_of(ctx, eid);
    val res_vec_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, vec_ty);
    if (sel res_vec_ir.err) { ret res[value.Value, fail.Fail].err{res_vec_ir.err}; }
    val vec_ir: ir_type.IrTypeId = res_vec_ir.ok;

    val opt_vt: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, vec_ir);
    if (sel opt_vt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: vector literal type is not an IR vector")}; }
    val vt: *ir_type.IrType = opt_vt.some;
    if (vt.kind != ir_type.IRT_VECTOR) { ret res[value.Value, fail.Fail].err{fail.message("lower: vector literal type is not an IR vector")}; }
    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    if (ctx.tgt != nil && ctx.tgt.model.has_vec_build) {
        if (e.data.vector_lit.elems_len > 16) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: vector literal has more lanes than any 128-bit vector")};
        }
        var lanes: [16]value.Value;
        var li: u32 = 0;
        for (li < e.data.vector_lit.elems_len) {
            val lpool_ix: u32 = e.data.vector_lit.elems_start + li;
            if (lpool_ix::usize >= ctx.scope.a.expr_id_len) {
                ret res[value.Value, fail.Fail].err{fail.message("lower: vector literal element index out of range")};
            }
            val lres: res[value.Value, fail.Fail] = lower_rvalue(ctx, ctx.scope.a.expr_ids[lpool_ix]);
            if (sel lres.err) { ret lres; }
            lanes[li] = lres.ok;
            li = li + 1;
        }
        ret builder.emit_vec_build(?ctx.builder, vec_ir, ?lanes[0], e.data.vector_lit.elems_len);
    }

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, vec_ir, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    var i: u32 = 0;
    for (i < e.data.vector_lit.elems_len) {
        val pool_ix: u32 = e.data.vector_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: vector literal element index out of range")};
        }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
        val res_elem: res[value.Value, fail.Fail] = lower_rvalue(ctx, elem_eid);
        if (sel res_elem.err) { ret res_elem; }

        var idx: [2]value.Value;
        idx[0] = value.const_int(0, xty);
        idx[1] = value.const_int(i::u64, xty);
        val res_gep: res[value.Value, fail.Fail] = builder.emit_gep(?ctx.builder, slot, vec_ir, ?idx[0], 2);
        if (sel res_gep.err) { ret res_gep; }
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_elem.ok, res_gep.ok);
        if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
        i = i + 1;
    }

    ret builder.emit_load(?ctx.builder, slot, vec_ir);
}

# `sel` loads the discriminator and compares it with the case code; it never reads a payload.
# a pointer place tests its pointee through the pointer value, like a member access does
fun lower_sel(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val place_eid: id.ExprId = e.data.sel.place;
    # a constant element has no storage: the test is decided at compile time and materialized
    if (place_roots_in_const_elem(ctx, place_eid)) { ret lower_comptime_value(ctx, eid); }
    var tag_ty: type.TypeId;
    val res_addr: res[value.Value, fail.Fail] = member_receiver(ctx, eid, place_eid,
        "`sel` through an untyped pointer; cast to a typed pointer (*T) first", ?tag_ty);
    if (sel res_addr.err) { ret res_addr; }

    val res_tag_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret res[value.Value, fail.Fail].err{res_tag_ir.err}; }
    val tag_ir: ir_type.IrTypeId = res_tag_ir.ok;

    val res_disc: res[ir_type.IrTypeId, fail.Fail] =
        ir_type.intern_int(?ctx.m.types, ir_type.tag_discriminator_bytes(?ctx.m.types, tag_ir) * 8);
    if (sel res_disc.err) { ret res[value.Value, fail.Fail].err{res_disc.err}; }
    val disc_ir: ir_type.IrTypeId = res_disc.ok;

    val res_code: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, res_addr.ok, disc_ir);
    if (sel res_code.err) { ret res_code; }

    var case_ix: u32 = 0;
    if (e.data.sel.case_desc != id.EXPR_NIL) {
        val res_ix: res[u32, fail.Fail] = case_descriptor_index(ctx, e.data.sel.case_desc);
        if (sel res_ix.err) { ret res[value.Value, fail.Fail].err{res_ix.err}; }
        case_ix = res_ix.ok;
    }
    or { case_ix = field_index_in_type(ctx, tag_ty, e.data.sel.case_name); }
    ret builder.emit_cmp_eq(?ctx.builder,
        res_code.ok, value.const_int(case_ix::u64, disc_ir));
}

# the case ordinal a comptime case descriptor names; type checking already tied it to this tag
pub fun case_descriptor_index(ctx: *context.LowerContext, desc_eid: id.ExprId) res[u32, fail.Fail] {
    val res_desc: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), desc_eid, ?ctx.s.interner);
    context.record_eval_result(ctx, res_desc);
    if (sel res_desc.err) { ret res[u32, fail.Fail].err{fail.message(res_desc.err.message)}; }
    val dv: comptime.CTValue = res_desc.ok;
    if (dv.kind != comptime.CT_KIND_CASE) {
        ret res[u32, fail.Fail].err{fail.message("lower: a bracketed case operand is not a comptime case descriptor")};
    }
    ret res[u32, fail.Fail].ok{dv.data.fld.index};
}

pub fun literal_head_case(ctx: *context.LowerContext, tid: id.TypeId) token.Span {
    var absent: token.Span;
    absent.offset = 0;
    absent.len    = 0;
    val t_opt: opt[*atype.Type] = ast.get_type(ctx.scope.a, tid);
    if (sel t_opt.none) { ret absent; }
    val t: *atype.Type = t_opt.some;
    if (t.kind != atype.TYPE_KIND_NAMED) { ret absent; }
    ret t.data.named.case_name;
}

pub fun literal_head_case_desc(ctx: *context.LowerContext, tid: id.TypeId) id.ExprId {
    val t_opt: opt[*atype.Type] = ast.get_type(ctx.scope.a, tid);
    if (sel t_opt.none) { ret id.EXPR_NIL; }
    val t: *atype.Type = t_opt.some;
    if (t.kind != atype.TYPE_KIND_NAMED) { ret id.EXPR_NIL; }
    ret t.data.named.case_desc;
}

# the case a literal head selects, by name or through a descriptor; none when the head names a plain type
pub fun literal_head_case_index(ctx: *context.LowerContext, tid: id.TypeId, tag_ty: type.TypeId) res[opt[u32], fail.Fail] {
    val desc: id.ExprId = literal_head_case_desc(ctx, tid);
    if (desc != id.EXPR_NIL) {
        val res_ix: res[u32, fail.Fail] = case_descriptor_index(ctx, desc);
        if (sel res_ix.err) { ret res[opt[u32], fail.Fail].err{res_ix.err}; }
        ret res[opt[u32], fail.Fail].ok{opt[u32].some{res_ix.ok}};
    }
    val case_span: token.Span = literal_head_case(ctx, tid);
    if (case_span.len == 0) { ret res[opt[u32], fail.Fail].ok{opt[u32].none{}}; }
    ret res[opt[u32], fail.Fail].ok{opt[u32].some{field_index_in_type(ctx, tag_ty, case_span)}};
}

# a construction zeroes the whole object, writes the case code at offset zero and stores the payload
fun lower_tag_case_lit(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr,
                       tag_ty: type.TypeId, case_ix: u32) res[value.Value, fail.Fail] {
    val res_tag_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret res[value.Value, fail.Fail].err{res_tag_ir.err}; }
    val tag_ir: ir_type.IrTypeId = res_tag_ir.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    val res_disc: res[ir_type.IrTypeId, fail.Fail] =
        ir_type.intern_int(?ctx.m.types, ir_type.tag_discriminator_bytes(?ctx.m.types, tag_ir) * 8);
    if (sel res_disc.err) { ret res[value.Value, fail.Fail].err{res_disc.err}; }
    val disc_ir: ir_type.IrTypeId = res_disc.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, tag_ir, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, tag_ir);
    if (sel res_mz.err) { ret res[value.Value, fail.Fail].err{res_mz.err}; }

    if (e.data.struct_lit.elems_len == 1) {
        val res_payload: res[value.Value, fail.Fail] = lower_rvalue(ctx, ctx.scope.a.expr_ids[e.data.struct_lit.elems_start]);
        if (sel res_payload.err) { ret res_payload; }
        var idx: [2]value.Value;
        idx[0] = value.const_int(0, xty);
        idx[1] = value.const_int(case_ix::u64, xty);
        val res_gep: res[value.Value, fail.Fail] = builder.emit_gep(?ctx.builder, slot, tag_ir, ?idx[0], 2);
        if (sel res_gep.err) { ret res_gep; }
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder,
            res_payload.ok, res_gep.ok);
        if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
    }

    val res_code: err[fail.Fail] = builder.emit_store(?ctx.builder, value.const_int(case_ix::u64, disc_ir), slot);
    if (sel res_code.err) { ret res[value.Value, fail.Fail].err{res_code.err}; }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, tag_ir)};
}

fun lower_struct_lit(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) res[value.Value, fail.Fail] {
    val rec_ty: type.TypeId = context.expr_type_of(ctx, eid);
    val res_case: res[opt[u32], fail.Fail] = literal_head_case_index(ctx, e.data.struct_lit.ty, rec_ty);
    if (sel res_case.err) { ret res[value.Value, fail.Fail].err{res_case.err}; }
    val r_2844: opt[u32] = res_case.ok;
    if (sel r_2844.some) {
        val r_2845_r: opt[u32] = res_case.ok;
        if (sel r_2845_r.none) { ret res[value.Value, fail.Fail].err{fail.message("lower_struct_lit: a required element is absent")}; }
        ret lower_tag_case_lit(ctx, eid, e, rec_ty, r_2845_r.some);
    }
    if (type.is_vector(?ctx.s.types, rec_ty)) {
        var vector: expr.Expr = @e;
        vector.kind = expr.EXPR_KIND_VECTOR_LIT;
        vector.data.vector_lit = expr.ExprVectorLit{ ty: e.data.struct_lit.ty,
            elems_start: e.data.struct_lit.elems_start, elems_len: e.data.struct_lit.elems_len };
        ret lower_vector_lit(ctx, eid, ?vector);
    }
    val res_rec_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, rec_ty);
    if (sel res_rec_ir.err) { ret res[value.Value, fail.Fail].err{res_rec_ir.err}; }
    val rec_ir: ir_type.IrTypeId = res_rec_ir.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, rec_ir, value.const_int(1, xty));
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    if (e.data.struct_lit.fields_len < type.field_count(?ctx.s.types, rec_ty)) {
        val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, rec_ir);
        if (sel res_mz.err) { ret res[value.Value, fail.Fail].err{res_mz.err}; }
    }

    var i: u32 = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_init_len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: struct literal field index out of range")};
        }
        val fi: *expr.FieldInit = ?ctx.scope.a.field_inits[pool_ix];
        val field_ix: u32 = field_index_in_type(ctx, rec_ty, fi.name);
        val res_field: res[value.Value, fail.Fail] = lower_rvalue(ctx, fi.value);
        if (sel res_field.err) { ret res_field; }

        var idx: [2]value.Value;
        idx[0] = value.const_int(0, xty);
        idx[1] = value.const_int(field_ix::u64, xty);
        val res_gep: res[value.Value, fail.Fail] = builder.emit_gep(?ctx.builder, slot, rec_ir, ?idx[0], 2);
        if (sel res_gep.err) { ret res_gep; }
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_field.ok, res_gep.ok);
        if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
        i = i + 1;
    }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, rec_ir)};
}

pub fun const_value_of(ctx: *context.LowerContext, eid: id.ExprId, v: comptime.CTValue) res[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, true);
}

pub fun const_value_of_init(ctx: *context.LowerContext, eid: id.ExprId, v: comptime.CTValue) res[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, false);
}

fun materialize_const_value(ctx: *context.LowerContext, eid: id.ExprId, v: comptime.CTValue, expr_pos: bool) res[value.Value, fail.Fail] {
    val res_ir: res[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ty_id: ir_type.IrTypeId = res_ir.ok;

    if (v.kind == comptime.CT_KIND_INT) { ret res[value.Value, fail.Fail].ok{value.const_int(v.data.i::u64, ty_id)}; }
    if (v.kind == comptime.CT_KIND_FLOAT) { ret res[value.Value, fail.Fail].ok{value.const_float(v.data.f, ty_id)}; }
    if (v.kind == comptime.CT_KIND_STR) {
        val opt_txt: opt[str] = intern.lookup(?ctx.s.interner, v.data.s);
        if (sel opt_txt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: comptime string lookup failed")}; }
        val s: str = opt_txt.some;
        val blob: value.Value = value.const_bytes(s::*u8, (str_len(s) + 1::usize)::u32, ty_id);
        if (expr_pos) { ret context.add_rodata_bytes(ctx, blob, ty_id); }
        ret res[value.Value, fail.Fail].ok{blob};
    }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comptime value kind")};
}

fun snapshot_aggregate(ctx: *context.LowerContext, source_value: value.Value, sem_ty: type.TypeId, vol: bool) res[value.Value, fail.Fail] {
    val count_ty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel count_ty.err) { ret res[value.Value, fail.Fail].err{count_ty.err}; }
    val allocated: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, source_value.ty,
        value.const_int(1, count_ty.ok));
    if (sel allocated.err) { ret allocated; }
    val slot: value.Value = allocated.ok;
    var captured: value.Value = source_value;
    captured.secret = context.type_carries_secret(ctx, sem_ty);
    val copied: err[fail.Fail] = builder.emit_store(?ctx.builder, captured, slot);
    if (sel copied.err) { ret res[value.Value, fail.Fail].err{copied.err}; }
    if (vol || type_is_volatile_record(ctx, sem_ty)) { builder.mark_last_volatile(?ctx.builder); }
    # the value owns its bytes before later expressions can mutate its source
    var result: value.Value = value.retype(slot, source_value.ty);
    result.secret = captured.secret;
    ret res[value.Value, fail.Fail].ok{result};
}

fun rvalue_at(ctx: *context.LowerContext, ptr: value.Value, ity: ir_type.IrTypeId, sem_ty: type.TypeId, vol: bool) res[value.Value, fail.Fail] {
    if (is_aggregate_ir(ctx, ity)) { ret snapshot_aggregate(ctx, value.retype(ptr, ity), sem_ty, vol); }
    val res_: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, ptr, ity);
    if (vol && sel res_.ok) { builder.mark_last_volatile(?ctx.builder); }
    ret res_;
}

fun global_pointer(ctx: *context.LowerContext, global_ix: u32) res[value.Value, fail.Fail] {
    val res_ptr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?ctx.m.types);
    if (sel res_ptr.err) { ret res[value.Value, fail.Fail].err{res_ptr.err}; }
    ret res[value.Value, fail.Fail].ok{value.global(global_ix, res_ptr.ok)};
}

fun emit_global_rvalue(ctx: *context.LowerContext, eid: id.ExprId, global_ix: u32, vty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val res_gptr: res[value.Value, fail.Fail] = global_pointer(ctx, global_ix);
    if (sel res_gptr.err) { ret res_gptr; }
    val gptr: value.Value = res_gptr.ok;
    ret rvalue_at(ctx, gptr, vty, context.expr_type_of(ctx, eid), value_is_volatile_record(ctx, eid));
}

fun fn_reference(ctx: *context.LowerContext, link: intern.StrId, vty: ir_type.IrTypeId, is_import: bool) res[value.Value, fail.Fail] {
    val opt_fi: opt[u32] = find_function(ctx, link);
    if (sel opt_fi.some) {
        ret res[value.Value, fail.Fail].ok{value.fn(opt_fi.some, vty)};
    }
    val res_xfn: res[u32, fail.Fail] = context.ensure_extern_function(ctx, link, vty, is_import);
    if (sel res_xfn.err) { ret res[value.Value, fail.Fail].err{res_xfn.err}; }
    ret res[value.Value, fail.Fail].ok{value.fn(res_xfn.ok, vty)};
}

fun member_receiver(ctx: *context.LowerContext, eid: id.ExprId, obj_eid: id.ExprId, untyped_ptr_msg: str, out_rec_ty: *type.TypeId) res[value.Value, fail.Fail] {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: receiver base has no pointer type")}; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type.TYPE_POINTER) {
            ret report_expr(ctx, eid, untyped_ptr_msg);
        }
        @out_rec_ty = type.strip_secret(?ctx.s.types, pt.data.pointer.base);
        ret lower_rvalue(ctx, obj_eid);
    }
    @out_rec_ty = obj_ty;
    ret lower_lvalue(ctx, obj_eid);
}

fun field_access_rec_ty(ctx: *context.LowerContext, obj_eid: id.ExprId) type.TypeId {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret type.TYPE_ERROR; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type.TYPE_POINTER) { ret type.TYPE_ERROR; }
        ret type.strip_secret(?ctx.s.types, pt.data.pointer.base);
    }
    ret obj_ty;
}

pub fun type_is_volatile_record(ctx: *context.LowerContext, sem_ty: type.TypeId) bool {
    val t: type.TypeId = type.strip_secret(?ctx.s.types, sem_ty);
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }
    val nom: type.TypeId = type.aggregate_nominal(?ctx.s.types, t);
    if (nom == type.TYPE_ERROR) { ret false; }
    ret session.type_is_volatile(ctx.s, nom::u32);
}

pub fun value_is_volatile_record(ctx: *context.LowerContext, eid: id.ExprId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    ret type_is_volatile_record(ctx, context.expr_type_of(ctx, eid));
}

fun field_access_is_volatile(ctx: *context.LowerContext, obj_eid: id.ExprId) bool {
    val rec_ty: type.TypeId = field_access_rec_ty(ctx, obj_eid);
    if (rec_ty == type.TYPE_NIL || rec_ty == type.TYPE_ERROR) { ret false; }
    val nom: type.TypeId = type.aggregate_nominal(?ctx.s.types, rec_ty);
    if (nom == type.TYPE_ERROR) { ret false; }
    ret session.type_is_volatile(ctx.s, nom::u32);
}

fun lvalue_is_volatile_field(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val opt_e: res[expr.Expr, fail.Fail] = context.expression(ctx, eid);
    if (sel opt_e.err) { ret false; }
    var e_value: expr.Expr = opt_e.ok;
    val e: *expr.Expr = ?e_value;
    if (e.kind == expr.EXPR_KIND_MEMBER)  { ret field_access_is_volatile(ctx, e.data.member.object); }
    if (e.kind == expr.EXPR_KIND_PROJECT) { ret field_access_is_volatile(ctx, e.data.project.object); }
    ret false;
}

fun field_gep(ctx: *context.LowerContext, base: value.Value, rec_ty: type.TypeId, field_ix: u32) res[value.Value, fail.Fail] {
    val res_rec_ir: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, rec_ty);
    if (sel res_rec_ir.err) { ret res[value.Value, fail.Fail].err{res_rec_ir.err}; }
    val rec_ir: ir_type.IrTypeId = res_rec_ir.ok;

    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;

    var idx: [2]value.Value;
    idx[0] = value.const_int(0, xty);
    idx[1] = value.const_int(field_ix::u64, xty);
    ret builder.emit_gep(?ctx.builder, base, rec_ir, ?idx[0], 2);
}

fun ir_type_of_expr(ctx: *context.LowerContext, eid: id.ExprId) res[ir_type.IrTypeId, fail.Fail] {
    ret context.lower_type(ctx, context.expr_type_of(ctx, eid));
}

fun index_bits(ctx: *context.LowerContext) u32 {
    ret ctx.tgt.model.index_width;
}

fun index_type(ctx: *context.LowerContext) res[ir_type.IrTypeId, fail.Fail] {
    ret ir_type.intern_int(?ctx.m.types, index_bits(ctx));
}

fun widen_index(ctx: *context.LowerContext, v: value.Value, sem_ty: type.TypeId) res[value.Value, fail.Fail] {
    val res_xty: res[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (sel res_xty.err) { ret res[value.Value, fail.Fail].err{res_xty.err}; }
    val xty: ir_type.IrTypeId = res_xty.ok;
    if (scalar_bits(ctx, sem_ty) >= index_bits(ctx)) { ret res[value.Value, fail.Fail].ok{v}; }
    if (is_signed_type(ctx, sem_ty))    { ret builder.emit_sext(?ctx.builder, v, xty); }
    ret builder.emit_zext(?ctx.builder, v, xty);
}

fun repr_kind(ctx: *context.LowerContext, tid: type.TypeId) opt[type.TypeKind] {
    val base: type.TypeId = type.strip_secret(?ctx.s.types, tid);
    val opt_t: opt[*type.Type] = type.get(?ctx.s.types, base);
    if (sel opt_t.none) { ret opt[type.TypeKind].none{}; }
    ret opt[type.TypeKind].some{opt_t.some.kind};
}

fun scalar_bits(ctx: *context.LowerContext, tid: type.TypeId) u32 {
    val ok: opt[type.TypeKind] = repr_kind(ctx, tid);
    if (sel ok.none) { ret 0; }
    val k: type.TypeKind = ok.some;
    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) { ret d.bits; }
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER || k == type.TYPE_FUN) { ret ctx.tgt.isa.pointer_width * 8; }
    ret 0;
}

fun is_signed_type(ctx: *context.LowerContext, tid: type.TypeId) bool {
    val ok: opt[type.TypeKind] = repr_kind(ctx, tid);
    if (sel ok.none) { ret false; }
    ret type.prim_desc(ok.some).signed;
}

fun is_float_type(ctx: *context.LowerContext, tid: type.TypeId) bool {
    val ok: opt[type.TypeKind] = repr_kind(ctx, tid);
    if (sel ok.none) { ret false; }
    ret type.prim_desc(ok.some).class == type.PRIM_CLASS_FLOAT;
}

fun is_pointer_type(ctx: *context.LowerContext, tid: type.TypeId) bool {
    val opt_t: opt[*type.Type] = type.get(?ctx.s.types, tid);
    if (sel opt_t.none) { ret false; }
    val k: type.TypeKind = opt_t.some.kind;
    ret k == type.TYPE_PTR || k == type.TYPE_POINTER;
}

fun is_aggregate_ir(ctx: *context.LowerContext, ity: ir_type.IrTypeId) bool {
    ret ir_type.is_aggregate(?ctx.m.types, ity);
}

pub fun field_index_in_type(ctx: *context.LowerContext, rec_ty: type.TypeId, name: token.Span) u32 {
    val src_text: str = context.module_source(ctx);
    val res_want: res[intern.StrId, A.Error] = intern.intern_span(?ctx.s.interner, src_text, name);
    if (sel res_want.err) { ret 0; }
    val want: intern.StrId = res_want.ok;

    val fields_len: u32 = type.field_count(?ctx.s.types, rec_ty);
    var i: u32 = 0;
    for (i < fields_len) {
        val opt_fe: opt[*type.FieldEntry] = type.field_at(?ctx.s.types, rec_ty, i);
        if (sel opt_fe.some) {
            if (sel opt_fe.none) { ret i; }
            if (opt_fe.some.name == want) { ret i; }
        }
        i = i + 1;
    }

    val res_name: res[str, string.StrError] = str_copy_slice(ctx.s.alloc, src_text, name.offset, name.len);
    if (sel res_name.err) {
        diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, name, "no such field on the receiver type");
        ret 0;
    }
    val fname: str = res_name.ok;
    val res_msg: res[str, string.StrError] = str_join(ctx.s.alloc, "no field '", fname, "' on the receiver type");
    str_free(ctx.s.alloc, fname);
    if (sel res_msg.err) {
        diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, name, "no such field on the receiver type");
        ret 0;
    }
    val msg: str = res_msg.ok;
    diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, name, msg);
    str_free(ctx.s.alloc, msg);
    ret 0;
}

fun find_function(ctx: *context.LowerContext, name: intern.StrId) opt[u32] {
    ret ir.function_lookup(ctx.m, name);
}

fun find_global(ctx: *context.LowerContext, name: intern.StrId) opt[u32] {
    ret ir.global_lookup(ctx.m, name);
}

rec StructLitProbe {
    a: u32;
    b: u32;
    c: u32;
    d: u32;
}

rec StructLitProbeInner {
    x: u32;
    y: u32;
}

rec StructLitProbeOuter {
    tag:   u32;
    inner: StructLitProbeInner;
    arr:   [3]u32;
}

val struct_lit_probe_static: StructLitProbe = StructLitProbe{a: 42};

val struct_lit_probe_ct_arr: [1]StructLitProbe = [1]StructLitProbe{StructLitProbe{a: 5}};

fun struct_lit_probe_dirty() u32 {
    var junk: [16]u32;
    var i: u32 = 0;
    for (i < 16) { junk[i] = 0xAAAAAAAA; i = i + 1; }
    ret junk[0];
}

fun struct_lit_probe_partial() StructLitProbe {
    ret StructLitProbe{a: 7};
}

fun struct_lit_probe_full() StructLitProbe {
    ret StructLitProbe{a: 1, b: 2, c: 3, d: 4};
}

fun struct_lit_probe_outer_partial() StructLitProbeOuter {
    ret StructLitProbeOuter{tag: 3};
}

fun struct_lit_probe_outer_nested_partial() StructLitProbeOuter {
    ret StructLitProbeOuter{tag: 9, inner: StructLitProbeInner{x: 5}, arr: [3]u32{1, 2, 3}};
}

fun struct_lit_probe_runtime_y() u32 {
    val r: StructLitProbe = StructLitProbe{a: 5};
    ret r.b;
}

test "mach.lang.me.lower.expr.struct_lit:partial_literal_zeroes_omitted_fields_over_dirty_stack" {
    var bad: i32 = 0;

    val dirty_check: u32 = struct_lit_probe_dirty();
    if (dirty_check != 0xAAAAAAAA) { bad = bad + 1; }

    val r: StructLitProbe = struct_lit_probe_partial();
    if (r.a != 7) { bad = bad + 2; }
    if (r.b != 0) { bad = bad + 4; }
    if (r.c != 0) { bad = bad + 8; }
    if (r.d != 0) { bad = bad + 16; }

    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:full_literal_unchanged" {
    var bad: i32 = 0;
    val r: StructLitProbe = struct_lit_probe_full();
    if (r.a != 1) { bad = bad + 1; }
    if (r.b != 2) { bad = bad + 2; }
    if (r.c != 3) { bad = bad + 4; }
    if (r.d != 4) { bad = bad + 8; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:partial_literal_zeroes_nested_aggregate_region" {
    var bad: i32 = 0;
    val o: StructLitProbeOuter = struct_lit_probe_outer_partial();
    if (o.tag != 3)     { bad = bad + 1; }
    if (o.inner.x != 0) { bad = bad + 2; }
    if (o.inner.y != 0) { bad = bad + 4; }
    if (o.arr[0] != 0)  { bad = bad + 8; }
    if (o.arr[1] != 0)  { bad = bad + 16; }
    if (o.arr[2] != 0)  { bad = bad + 32; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:partial_literal_nested_inside_full_literal" {
    var bad: i32 = 0;
    val o: StructLitProbeOuter = struct_lit_probe_outer_nested_partial();
    if (o.tag != 9)      { bad = bad + 1; }
    if (o.inner.x != 5)  { bad = bad + 2; }
    if (o.inner.y != 0)  { bad = bad + 4; }
    if (o.arr[0] != 1)   { bad = bad + 8; }
    if (o.arr[1] != 2)   { bad = bad + 16; }
    if (o.arr[2] != 3)   { bad = bad + 32; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:constagg_static_partial_matches_runtime" {
    var bad: i32 = 0;
    if (struct_lit_probe_static.a != 42) { bad = bad + 1; }
    if (struct_lit_probe_static.b != 0)  { bad = bad + 2; }
    if (struct_lit_probe_static.c != 0)  { bad = bad + 4; }
    if (struct_lit_probe_static.d != 0)  { bad = bad + 8; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:comptime_and_runtime_agree_on_omitted_field" {
    var bad: i32 = 0;
    $each item in struct_lit_probe_ct_arr {
        $if (item.b == 0) {
            if (struct_lit_probe_runtime_y() != 0) { bad = bad + 1; }
        }
        $or {
            bad = bad + 2;
        }
    }
    ret bad;
}

uni StructLitProbeUnion {
    small: u8;
    big:   u64;
}

val struct_lit_probe_union_static: StructLitProbeUnion = StructLitProbeUnion{small: 1};

fun struct_lit_probe_union_dirty() u64 {
    var junk: [16]u64;
    var i: u32 = 0;
    for (i < 16) { junk[i] = 0xAAAAAAAAAAAAAAAA; i = i + 1; }
    ret junk[0];
}

fun struct_lit_probe_union_partial() StructLitProbeUnion {
    ret StructLitProbeUnion{small: 1};
}

test "mach.lang.me.lower.expr.struct_lit:partial_union_literal_zeroes_tail_bytes_over_dirty_stack" {
    var bad: i32 = 0;

    val dirty_check: u64 = struct_lit_probe_union_dirty();
    if (dirty_check != 0xAAAAAAAAAAAAAAAA) { bad = bad + 1; }

    val u: StructLitProbeUnion = struct_lit_probe_union_partial();
    if (u.small != 1)      { bad = bad + 2; }
    if ((u.big >> 8) != 0) { bad = bad + 4; }

    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:union_literal_static_and_runtime_agree" {
    var bad: i32 = 0;

    val u: StructLitProbeUnion = StructLitProbeUnion{small: 1};
    if (u.small != struct_lit_probe_union_static.small)           { bad = bad + 1; }
    if ((u.big >> 8) != (struct_lit_probe_union_static.big >> 8)) { bad = bad + 2; }
    if ((struct_lit_probe_union_static.big >> 8) != 0)            { bad = bad + 4; }

    ret bad;
}

val convert_const_probe_u64:        u64 = 18446744073709551615;
val convert_const_probe_u64_as_f64: f64 = convert_const_probe_u64::f64;

fun convert_const_probe_u64_to_f64_runtime(x: u64) f64 {
    ret x::f64;
}

val convert_const_probe_f64_high:   f64 = 9223372036854775808.0;
val convert_const_probe_f64_as_u64: u64 = convert_const_probe_f64_high::u64;

fun convert_const_probe_f64_to_u64_runtime(x: f64) u64 {
    ret x::u64;
}

test "mach.lang.me.lower.expr.convert_const_scalar:unsigned_conversions_agree_with_runtime" {
    var bad: i32 = 0;

    if (convert_const_probe_u64_as_f64 != convert_const_probe_u64_to_f64_runtime(convert_const_probe_u64)) { bad = bad + 1; }
    if (convert_const_probe_u64_as_f64 <= 0.0)                                                              { bad = bad + 2; }

    if (convert_const_probe_f64_as_u64 != convert_const_probe_f64_to_u64_runtime(convert_const_probe_f64_high)) { bad = bad + 4; }
    if (convert_const_probe_f64_as_u64 != 9223372036854775808)                                                   { bad = bad + 8; }

    ret bad;
}

fun t_pointer_float(value: ptr) f64 { ret value::f64; }
fun t_float_pointer(value: f64) ptr { ret value::ptr; }

test "mach.lang.me.lower.expr.convert_const_scalar:nonnumeric_casts_preserve_bits" {
    val bits: u64 = 0x3FF0000000000000;
    if (t_pointer_float(bits::ptr) != 1.0) { ret 1; }
    if (t_float_pointer(1.0)::u64 != bits) { ret 2; }
    ret 0;
}

val reinterpret_probe_f64:      f64 = 5.0;
val reinterpret_probe_f64_bits: u64 = reinterpret_probe_f64:~u64;

fun reinterpret_probe_f64_runtime(f: f64) u64 {
    ret f:~u64;
}

val reinterpret_probe_f32:      f32 = 5.0;
val reinterpret_probe_f32_bits: u32 = reinterpret_probe_f32:~u32;

fun reinterpret_probe_f32_runtime(f: f32) u32 {
    ret f:~u32;
}

test "mach.lang.me.lower.expr.convert_const_scalar:reinterpret_agrees_with_runtime" {
    var bad: i32 = 0;

    if (reinterpret_probe_f64_bits != reinterpret_probe_f64_runtime(reinterpret_probe_f64)) { bad = bad + 1; }
    if (reinterpret_probe_f64_bits != 0x4014000000000000)                                    { bad = bad + 2; }

    if (reinterpret_probe_f32_bits != reinterpret_probe_f32_runtime(reinterpret_probe_f32)) { bad = bad + 4; }
    if (reinterpret_probe_f32_bits != 0x40A00000)                                             { bad = bad + 8; }

    ret bad;
}
