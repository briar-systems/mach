pub fun lower_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel opt_e.err) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: expression id out of range")};
    }
    var e_value: ast_expr.Expr  = opt_e.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (stack.exhausted()) { ret res[value.Value, fail.Fail].err{lower_context.refuse_nesting(ctx, e.span)}; }

    val saved_loc: lang_source.Location = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, lang_source.location(ctx.scope.a.file_id, e.span));
    fin { builder.set_loc(?ctx.builder, saved_loc); }
    # only the armed argument's own read may borrow, never a read nested inside it
    val saved_borrow: bool = ctx.borrow_now;
    ctx.borrow_now = ctx.borrow_armed && ast_id.expr_same(eid, ctx.borrow_eid);
    fin { ctx.borrow_now = saved_borrow; }

    val res_: res[value.Value, fail.Fail] = lower_rvalue_kind(ctx, eid, e);
    if (sel res_.err) { ret res_; }
    ret stamp_secret(ctx, eid, res_.ok);
}

fun lower_rvalue_kind(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val k: ast_expr.ExprKind = e.kind;

    if (k == ast_expr.EXPR_KIND_LIT_INT)          { ret lower_lit_int(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_LIT_FLOAT)        { ret lower_lit_float(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_LIT_CHAR)         { ret lower_lit_char(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_LIT_STR)          { ret lower_lit_str(ctx, e); }
    if (k == ast_expr.EXPR_KIND_LIT_NIL)          { ret lower_lit_nil(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_IDENT)            { ret lower_ident_rvalue(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_MEMBER)           { ret lower_member_rvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_PROJECT)          { ret lower_project_rvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_INDEX)            { ret lower_index_rvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_GENERIC_INSTANCE) { ret lower_instance_reference(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_CALL)             { ret lower_call(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_BINARY)           { ret lower_binary(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_UNARY)            { ret lower_unary(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_CAST)             { ret lower_cast(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_STRIP)            { ret lower_strip(ctx, e); }
    if (k == ast_expr.EXPR_KIND_COMPTIME_IDENT)   { ret lower_comptime_path(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT)        { ret lower_array_lit(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT)       { ret lower_struct_lit(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT)       { ret lower_vector_lit(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_SEL)              { ret lower_sel(ctx, eid, e); }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported expression kind in rvalue position")};
}

# a value of a secret type is secret: one built from public operands, or a constant, is
# classified where it is made. an aggregate is its storage's address, which is public
fun stamp_secret(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: value.Value) res[value.Value, fail.Fail] {
    var sec: bool = lower_context.expr_is_secret(ctx, eid);
    if (!sec)                                 { sec = compare_operand_secret(ctx, eid); }
    if (!sec || v.secret || value.is_none(v)) { ret res[value.Value, fail.Fail].ok{v}; }
    if (irt.is_aggregate(?ctx.m.types, v.ty)) {
        var out: value.Value = v;
        out.secret = true;
        ret res[value.Value, fail.Fail].ok{out};
    }
    ret builder.emit_classify(?ctx.builder, v);
}

fun compare_operand_secret(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val e_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel e_opt.err) { ret false; }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (e.kind != ast_expr.EXPR_KIND_BINARY) { ret false; }
    if (!is_compare_binop(e.data.binary.op)) { ret false; }
    ret lower_context.expr_is_secret(ctx, e.data.binary.lhs) || lower_context.expr_is_secret(ctx, e.data.binary.rhs);
}

fun lower_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel opt_e.err) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: lvalue id out of range")};
    }
    var e_value: ast_expr.Expr  = opt_e.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (stack.exhausted()) { ret res[value.Value, fail.Fail].err{lower_context.refuse_nesting(ctx, e.span)}; }

    val saved_loc: lang_source.Location = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, lang_source.location(ctx.scope.a.file_id, e.span));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val k: ast_expr.ExprKind = ast.expr_place_kind(e);

    if (k == ast_expr.EXPR_KIND_IDENT)   { ret lower_ident_lvalue(ctx, eid); }
    if (k == ast_expr.EXPR_KIND_MEMBER)  { ret lower_member_lvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_PROJECT) { ret lower_project_lvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_INDEX)   { ret lower_index_lvalue(ctx, eid, e); }
    if (k == ast_expr.EXPR_KIND_UNARY)   { ret lower_rvalue(ctx, e.data.unary.operand); }

    if (k == ast_expr.EXPR_KIND_CALL) {
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        if (is_aggregate_ir(ctx, res_ir.ok)) {
            ret lower_rvalue(ctx, eid);
        }
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: expression is not an lvalue")};
}

fun lower_lit_int(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_int_wide(e.data.lit_int.value, res_ir.ok)};
}

fun lower_lit_float(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val lit: res[float.Rounded, fail.Fail] = fe_literal.float_at(lower_context.module_source(ctx), e.data.lit_float.tok, lower_context.expr_float_width(ctx, eid));
    if (sel lit.err) { ret res[value.Value, fail.Fail].err{lit.err}; }
    ret res[value.Value, fail.Fail].ok{float_constant(ctx, lit.ok.value, res_ir.ok)};
}

fun float_constant(ctx: *lower_context.LowerContext, f: f64, ty: Type) value.Value {
    ret value.const_float(f, ty);
}

fun lower_lit_char(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_int(e.data.lit_char.value::u64, res_ir.ok)};
}

fun lower_lit_str(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val inner:   View                       = ast.lit_str_value(ctx.scope.a, e);
    val res_sid: res[intern.StrId, A.Error] = intern.bytes_add(?ctx.s.interner, inner.data::str, inner.len);
    if (sel res_sid.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_sid.err)}; }
    ret constnode.string_global(ctx, res_sid.ok);
}

fun lower_lit_nil(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret res[value.Value, fail.Fail].ok{value.const_null(res_ir.ok)};
}

fun lower_ident_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);

    val opt_cv: opt[comptime.CTValue] = comptime_param_value(ctx, sid);
    if (sel opt_cv.some) {
        ret const_value_of(ctx, eid, opt_cv.some);
    }

    val opt_ord: opt[u32] = pack_elem_ordinal(ctx, sid);
    if (sel opt_ord.some) {
        ret load_pack_elem(ctx, eid, opt_ord.some);
    }

    val opt_elem: opt[comptime.CTValue] = each_element(ctx, sid);
    if (sel opt_elem.some) {
        ret element_value(ctx, eid, opt_elem.some);
    }

    val opt_local: opt[value.Value] = lower_context.lookup_local(ctx, sid);
    if (sel opt_local.some) {
        val slot:   value.Value          = opt_local.some;
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        ret rvalue_at(ctx, slot, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
    }
    ret symbol_reference(ctx, eid, sid);
}

fun pack_elem_ordinal(ctx: *lower_context.LowerContext, sid: resolve.SymbolId) opt[u32] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[u32].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret opt[u32].none{}; }
    if (!ast_id.decl_is_nil(sym.decl))                                               { ret opt[u32].none{}; }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[u32].none{}; }
    val cval: comptime.CTValue = opt_nc.some.value;
    if (cval.kind != comptime.CT_KIND_PACK_ELEM) { ret opt[u32].none{}; }
    ret opt[u32].some{cval.data.pelem.index};
}

# the element of a constant array a `$each` loop variable names
fun each_element(ctx: *lower_context.LowerContext, sid: resolve.SymbolId) opt[comptime.CTValue] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[comptime.CTValue].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret opt[comptime.CTValue].none{}; }
    if (!ast_id.decl_is_nil(sym.decl))                                               { ret opt[comptime.CTValue].none{}; }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none)                                 { ret opt[comptime.CTValue].none{}; }
    if (opt_nc.some.value.kind != comptime.CT_KIND_NODE) { ret opt[comptime.CTValue].none{}; }
    ret opt[comptime.CTValue].some{opt_nc.some.value};
}

# the part of a `$each` element `eid` reads: a constant where the array's published value holds
# it whole, a scalar's or an aggregate's of constant bytes of its own, and otherwise a read of
# the array itself, where the element is stored
fun element_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, element: comptime.CTValue) res[value.Value, fail.Fail] {
    val store_r: res[*comptime_deep.Store, fail.Fail] = lower_context.constant_store(ctx, element.data.node.module);
    if (sel store_r.err) { ret res[value.Value, fail.Fail].err{store_r.err}; }
    val store:   *comptime_deep.Store = store_r.ok;
    val refused: opt[u32]             = comptime_deep.refused_within(store, element.data.node.node);
    if (sel refused.some) {
        val res_at: res[value.Value, fail.Fail] = element_address(ctx, eid);
        if (sel res_at.err) { ret res_at; }
        val res_load_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_load_ir.err) { ret res[value.Value, fail.Fail].err{res_load_ir.err}; }
        ret rvalue_at(ctx, res_at.ok, res_load_ir.ok, lower_context.expr_type_of(ctx, eid), false);
    }
    val n: *comptime_deep.Node = comptime_deep.node_at(store, element.data.node.node);
    if (n.kind == comptime_deep.NODE_SCALAR) { ret const_value_of(ctx, eid, n.value); }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ity:     Type                        = res_ir.ok;
    val res_agg: res[value.Value, fail.Fail] = constnode.aggregate(ctx, store, element.data.node.node, ity);
    if (sel res_agg.err) { ret res_agg; }
    val res_global: res[value.Value, fail.Fail] = lower_context.constant_global(ctx, res_agg.ok);
    if (sel res_global.err) { ret res_global; }
    ret rvalue_at(ctx, res_global.ok, ity, lower_context.expr_type_of(ctx, eid), false);
}

fun load_pack_elem(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, ord: u32) res[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: pack element ordinal out of range")};
    }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, ctx.pack_slots[ord], res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun is_spread_expr(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel opt_e.err) { ret false; }
    ret opt_e.ok.kind == ast_expr.EXPR_KIND_SPREAD;
}

fun call_has_spread(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) bool {
    var i: u32 = 0;
    for (i < e.data.call.args_len) {
        val pool_ix: u32 = e.data.call.args_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_ids.len)              { ret false; }
        if (is_spread_expr(ctx, ctx.scope.a.expr_ids.data[pool_ix])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun load_pack_slot(ctx: *lower_context.LowerContext, slot_ix: u32) res[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || slot_ix >= ctx.pack_len) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: pack slot index out of range")};
    }
    val res_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, ctx.pack_types[slot_ix]);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, ctx.pack_slots[slot_ix], res_ir.ok, ctx.pack_types[slot_ix], type_is_volatile_record(ctx, ctx.pack_types[slot_ix]));
}

fun comptime_param_value(ctx: *lower_context.LowerContext, sid: resolve.SymbolId) opt[comptime.CTValue] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[comptime.CTValue].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_PARAM || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) {
        ret opt[comptime.CTValue].none{};
    }
    val opt_nc: opt[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (sel opt_nc.none) { ret opt[comptime.CTValue].none{}; }
    ret opt[comptime.CTValue].some{opt_nc.some.value};
}

fun reference_linkage_name(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) res[intern.StrId, fail.Fail] {
    if (sym.kind == resolve.SYM_IMPORTED || !ast_id.decl_is_nil(sym.decl)) {
        val found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
        if (sel found.err) { ret res[intern.StrId, fail.Fail].err{found.err}; }
        ret mangle.declaration_linkage_name(ctx.linkage, ctx.s, resolve.origin_of(ctx.s, sym), sym.canon, ast_id.decl_index(found.ok.declaration.decl));
    }
    ret mangle.linkage_name(ctx.s, session.module_fqn(ctx.s, resolve.origin_of(ctx.s, sym)), sym.canon, intern.STR_NIL);
}

# the linkage name of the module-level binding `eid` names, nil when it names a binding with
# none
pub fun symbol_linkage_name(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[intern.StrId, fail.Fail] {
    val sid:     resolve.SymbolId     = lower_context.expr_symbol_of(ctx, eid);
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    val sym: *resolve.Symbol = opt_sym.some;

    # a binding has a linkage name only at module level
    val is_addressable: bool = sym.kind == resolve.SYM_FUN
        || ((sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_VAR) && (sym.flags & resolve.SYM_FLAG_MODULE) != 0)
        || sym.kind == resolve.SYM_IMPORTED;
    if (!is_addressable) { ret res[intern.StrId, fail.Fail].ok{intern.STR_NIL}; }
    ret reference_linkage_name(ctx, sym);
}

fun symbol_reference(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, sid: resolve.SymbolId) res[value.Value, fail.Fail] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: an identifier resolve bound names no symbol")};
    }
    val sym: *resolve.Symbol = opt_sym.some;

    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (sel res_ln.err) { ret res[value.Value, fail.Fail].err{res_ln.err}; }
    val link: intern.StrId = res_ln.ok;

    if (names_function(ctx, sym)) {
        val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.fn_sig_of_type(ctx, lower_context.expr_type_of(ctx, eid));
        if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
        ret fn_reference(ctx, link, res_sig.ok);
    }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val vty: Type = res_ir.ok;

    val res_cv: res[opt[comptime.CTValue], fail.Fail] = module_const_value(ctx, sym);
    if (sel res_cv.err) {
        ret res[value.Value, fail.Fail].err{res_cv.err};
    }
    val opt_cv: opt[comptime.CTValue] = res_cv.ok;
    if (sel opt_cv.some) {
        ret const_value_of(ctx, eid, opt_cv.some);
    }

    val opt_gi: opt[u32] = find_global(ctx, link);
    if (sel opt_gi.some) {
        ret emit_global_rvalue(ctx, eid, opt_gi.some, vty);
    }

    val res_xg: res[u32, fail.Fail] = lower_context.ensure_extern_global(ctx, link, vty);
    if (sel res_xg.err) { ret res[value.Value, fail.Fail].err{res_xg.err}; }
    ret emit_global_rvalue(ctx, eid, res_xg.ok, vty);
}

fun module_const_value(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) res[opt[comptime.CTValue], fail.Fail] {
    val found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
    if (sel found.err) { ret res[opt[comptime.CTValue], fail.Fail].err{found.err}; }
    val scalar: opt[comptime.CTValue] = lower_context.declared_scalar(ctx, found.ok);
    if (sel scalar.none) { ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].none{}}; }

    if (found.ok.declaration.gated && ctx.scope.env.build.union_build) {
        val msg_r: res[str, fail.Fail] = lower_context.gated_lower_member_const_message(ctx, sym.name, session.module_fqn(ctx.s, resolve.origin_of(ctx.s, sym)));
        if (sel msg_r.err) { ret res[opt[comptime.CTValue], fail.Fail].err{msg_r.err}; }
        val msg:       str = msg_r.ok;
        var zero_span: lang_source.Span;
        zero_span.offset = 0;
        zero_span.len    = 0;
        ret res[opt[comptime.CTValue], fail.Fail].err{lower_context.report_gate(ctx, diagnostic_kind.CONST_TUPLE_DEPENDENT, zero_span, msg)};
    }
    if (!const_has_no_identity(scalar.some)) { ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].none{}}; }
    ret res[opt[comptime.CTValue], fail.Fail].ok{scalar};
}

fun const_has_no_identity(v: comptime.CTValue) bool {
    ret v.kind == comptime.CT_KIND_INT
        || v.kind == comptime.CT_KIND_FLOAT;
}

fun names_function(ctx: *lower_context.LowerContext, sym: *resolve.Symbol) bool {
    ret sym.kind == resolve.SYM_FUN
        || (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_FUN);
}

fun symbol_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, sid: resolve.SymbolId) res[value.Value, fail.Fail] {
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: an identifier resolve bound names no symbol")};
    }
    val sym: *resolve.Symbol = opt_sym.some;

    val res_ln: res[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (sel res_ln.err) { ret res[value.Value, fail.Fail].err{res_ln.err}; }
    val link: intern.StrId = res_ln.ok;

    val opt_gi: opt[u32] = find_global(ctx, link);
    if (sel opt_gi.some) {
        ret global_pointer(ctx, opt_gi.some);
    }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val res_xg: res[u32, fail.Fail] = lower_context.ensure_extern_global(ctx, link, res_ir.ok);
    if (sel res_xg.err) { ret res[value.Value, fail.Fail].err{res_xg.err}; }
    ret global_pointer(ctx, res_xg.ok);
}

fun lower_ident_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);

    val opt_cv: opt[comptime.CTValue] = comptime_param_value(ctx, sid);
    if (sel opt_cv.some) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: cannot take the address of a comptime parameter")};
    }

    val opt_ord: opt[u32] = pack_elem_ordinal(ctx, sid);
    if (sel opt_ord.some) {
        val ord: u32 = opt_ord.some;
        if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: pack element ordinal out of range")};
        }
        ret res[value.Value, fail.Fail].ok{ctx.pack_slots[ord]};
    }

    val opt_elem: opt[comptime.CTValue] = each_element(ctx, sid);
    if (sel opt_elem.some) {
        ret res[value.Value, fail.Fail].err{fail.message("lower: cannot take the address of a `$each` constant array element")};
    }

    val opt_local: opt[value.Value] = lower_context.lookup_local(ctx, sid);
    if (sel opt_local.some) {
        ret res[value.Value, fail.Fail].ok{opt_local.some};
    }
    ret symbol_lvalue(ctx, eid, sid);
}

# where the part of a `$each` element `eid` reads is stored: its element of the array, and the
# field or payload a member names in it
fun element_address(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel e_opt.err) { ret res[value.Value, fail.Fail].err{e_opt.err}; }
    val e: ast_expr.Expr = e_opt.ok;
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) {
        val res_base: res[value.Value, fail.Fail] = element_address(ctx, e.data.member.object);
        if (sel res_base.err) { ret res_base; }
        val rec_ty: type.TypeId = type.strip_secret(?ctx.s.types, lower_context.expr_type_of(ctx, e.data.member.object));
        ret field_gep(ctx, res_base.ok, rec_ty, field_index_in_type(ctx, rec_ty, e.data.member.name));
    }
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, lower_context.expr_symbol_of(ctx, eid));
    if (sel opt_sym.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: a `$each` element read names no loop variable")}; }
    val found: opt[lower_context.EachElement] = lower_context.each_element_of(ctx, opt_sym.some.name);
    if (sel found.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: a `$each` loop variable is read outside its statement")}; }
    val element:  lower_context.EachElement   = found.some;
    val res_base: res[value.Value, fail.Fail] = lower_lvalue(ctx, element.array);
    if (sel res_base.err) { ret res_base; }
    val res_arr: res[Type, fail.Fail] = lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, element.array));
    if (sel res_arr.err) { ret res[value.Value, fail.Fail].err{res_arr.err}; }
    ret builder.emit_element(?ctx.builder, res_base.ok, res_arr.ok, value.const_int(element.index::u64, builder.index_type(?ctx.builder)));
}

fun try_lower_element_member(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) opt[res[value.Value, fail.Fail]] {
    var zero: bool                                  = false;
    val leaf: res[opt[comptime.CTValue], fail.Fail] = element_leaf(ctx, eid, ?zero);
    if (sel leaf.err)     { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{leaf.err}}; }
    if (zero)             { ret opt[res[value.Value, fail.Fail]].some{dead_zero_value(ctx, eid)}; }
    if (sel leaf.ok.none) { ret opt[res[value.Value, fail.Fail]].none{}; }
    ret opt[res[value.Value, fail.Fail]].some{element_value(ctx, eid, leaf.ok.some)};
}

# the part of a `$each` element a member path reaches: the element itself for the binding, or the
# field or selected payload a member names; `zero` is raised for a path that reads a zero: a
# field the literal leaves out, or a payload of a case the element does not hold, which only a
# `sel` that folded false reaches; none is a path the element does not answer
fun element_leaf(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, zero: *bool) res[opt[comptime.CTValue], fail.Fail] {
    val none:  res[opt[comptime.CTValue], fail.Fail] = res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].none{}};
    val e_opt: res[ast_expr.Expr, fail.Fail]         = lower_context.expression(ctx, eid);
    if (sel e_opt.err) { ret none; }
    val e: ast_expr.Expr = e_opt.ok;
    if (e.kind == ast_expr.EXPR_KIND_IDENT)  { ret res[opt[comptime.CTValue], fail.Fail].ok{each_element(ctx, lower_context.expr_symbol_of(ctx, eid))}; }
    if (e.kind != ast_expr.EXPR_KIND_MEMBER) { ret none; }
    val inner: res[opt[comptime.CTValue], fail.Fail] = element_leaf(ctx, e.data.member.object, zero);
    if (sel inner.err)     { ret inner; }
    if (sel inner.ok.none) { ret none; }
    val object:  comptime.CTValue                     = inner.ok.some;
    val store_r: res[*comptime_deep.Store, fail.Fail] = lower_context.constant_store(ctx, object.data.node.module);
    if (sel store_r.err) { ret res[opt[comptime.CTValue], fail.Fail].err{store_r.err}; }
    val name_r: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, lower_context.module_source(ctx), e.data.member.name.offset, e.data.member.name.len);
    if (sel name_r.err) { ret res[opt[comptime.CTValue], fail.Fail].err{fail.refused(name_r.err)}; }
    val p: comptime_deep.Projection = comptime_deep.project(store_r.ok, object.data.node.node, name_r.ok);
    if (p.kind == comptime_deep.PROJECT_UNSELECTED || p.kind == comptime_deep.PROJECT_OMITTED) {
        @zero = true;
        ret none;
    }
    if (p.kind != comptime_deep.PROJECT_MEMBER) { ret none; }
    ret res[opt[comptime.CTValue], fail.Fail].ok{opt[comptime.CTValue].some{comptime.node_ref(object.data.node.module, p.node,
        type.index(lower_context.expr_type_of(ctx, eid)))}};
}

# whether a place is spelled over a `$each` element, which has no storage to address
fun place_roots_in_const_elem(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val e_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel e_opt.err) { ret false; }
    val e: ast_expr.Expr = e_opt.ok;
    if (e.kind == ast_expr.EXPR_KIND_IDENT) {
        val elem: opt[comptime.CTValue] = each_element(ctx, lower_context.expr_symbol_of(ctx, eid));
        ret sel elem.some;
    }
    if (e.kind == ast_expr.EXPR_KIND_MEMBER) { ret place_roots_in_const_elem(ctx, e.data.member.object); }
    ret false;
}

# evaluates an expression at compile time and materializes its scalar value
fun lower_comptime_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val r: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps,
        ctx.scope.a, lower_context.module_source(ctx), eid, ?ctx.s.interner);
    lower_context.record_eval_result(ctx, r);
    if (sel r.err) {
        val f: comptime.EvalFail = r.err;
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { ret res[value.Value, fail.Fail].err{fail.message(f.message)}; }
        ret report_expr(ctx, f.diag, eid, f.message);
    }
    ret const_value_of_init(ctx, eid, r.ok);
}

# a zero of an expression's type, for a read the constant folding proved dead or a field a
# constant leaves out
fun dead_zero_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ity: Type = res_ir.ok;
    if (irt.is_aggregate(?ctx.m.types, ity)) {
        val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, ity);
        if (sel res_slot.err) { ret res_slot; }
        val slot:   value.Value    = res_slot.ok;
        val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, ity);
        if (sel res_mz.err) { ret res[value.Value, fail.Fail].err{res_mz.err}; }
        ret res[value.Value, fail.Fail].ok{value.retype(slot, ity)};
    }
    ret res[value.Value, fail.Fail].ok{value.const_null(ity)};
}

fun try_lower_field_member(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    val src_text: str                                      = lower_context.module_source(ctx);
    val res_obj:  res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, e.data.member.object, ?ctx.s.interner);
    lower_context.record_eval_result(ctx, res_obj);
    if (sel res_obj.err)                     { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (!comptime.is_descriptor(res_obj.ok)) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_member: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, eid, ?ctx.s.interner);

    lower_context.record_eval_result(ctx, res_member);
    if (sel res_member.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message(res_member.err.message)}}; }
    val v: comptime.CTValue = res_member.ok;
    if (v.kind == comptime.CT_KIND_INT) {
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}}; }
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int_wide(v.data.w, res_ir.ok)}};
    }
    if (v.kind == comptime.CT_KIND_STR) { ret opt[res[value.Value, fail.Fail]].some{constnode.string_global(ctx, v.data.s)}; }
    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: unsupported field descriptor member in value position")}};
}

fun try_lower_pack_len(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    val obj_ty: type.TypeId     = lower_context.expr_type_of(ctx, e.data.member.object);
    val opt_t:  opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
    if (sel opt_t.none)                    { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (opt_t.some.kind != type.TYPE_PACK) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}};
    }
    val ity: Type = res_ir.ok;
    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int(ctx.pack_len::u64, ity)}};
}

fun lower_member_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val opt_elem: opt[res[value.Value, fail.Fail]] = try_lower_element_member(ctx, eid);
    if (sel opt_elem.some) { ret opt_elem.some; }

    val opt_pack_len: opt[res[value.Value, fail.Fail]] = try_lower_pack_len(ctx, eid, e);
    if (sel opt_pack_len.some) { ret opt_pack_len.some; }

    val opt_field: opt[res[value.Value, fail.Fail]] = try_lower_field_member(ctx, eid, e);
    if (sel opt_field.some) { ret opt_field.some; }

    val qsid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);
    if (!resolve.symbol_is_nil(qsid)) {
        ret symbol_reference(ctx, eid, qsid);
    }

    if (intrinsic.is_comptime_path(ctx.scope.a, eid)) {
        ret lower_comptime_path(ctx, eid);
    }

    val res_ptr: res[value.Value, fail.Fail] = lower_member_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun lower_member_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val qsid: resolve.SymbolId = lower_context.expr_symbol_of(ctx, eid);
    if (!resolve.symbol_is_nil(qsid)) {
        ret symbol_lvalue(ctx, eid, qsid);
    }

    var rec_ty:   type.TypeId;
    val res_base: res[value.Value, fail.Fail] = member_receiver(ctx, e.data.member.object, ?rec_ty);
    if (sel res_base.err) { ret res_base; }

    val field_ix: u32         = field_index_in_type(ctx, rec_ty, e.data.member.name);
    val base:     value.Value = res_base.ok;
    if (ctx.checks && type.is_tag(?ctx.s.types, rec_ty)) {
        val res_check: err[fail.Fail] = emit_case_check(ctx, base, rec_ty, field_ix);
        if (sel res_check.err) { ret res[value.Value, fail.Fail].err{res_check.err}; }
    }
    ret field_gep(ctx, base, rec_ty, field_ix);
}

# the address of a tag's discriminator, the first member of the structure it lowers to
fun disc_gep(ctx: *lower_context.LowerContext, base: value.Value, tag_ir: Type) res[value.Value, fail.Fail] {
    ret builder.emit_member(?ctx.builder, base, tag_ir, lower_context.TAG_DISCRIMINANT);
}

# the integer a tag's discriminator is held in
fun disc_type(ctx: *lower_context.LowerContext, tag_ir: Type) Type {
    ret irt.member(?ctx.m.types, tag_ir, lower_context.TAG_DISCRIMINANT);
}

# a guarded payload access in the debug profile traps when the discriminator no longer selects its case
fun emit_case_check(ctx: *lower_context.LowerContext, base: value.Value, tag_ty: type.TypeId, case_ix: u32) err[fail.Fail] {
    val res_tag_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret err[fail.Fail].err{res_tag_ir.err}; }
    val tag_ir:  Type = res_tag_ir.ok;
    val disc_ir: Type = disc_type(ctx, tag_ir);

    val res_dp: res[value.Value, fail.Fail] = disc_gep(ctx, base, tag_ir);
    if (sel res_dp.err) { ret err[fail.Fail].err{res_dp.err}; }
    val res_code: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, res_dp.ok, disc_ir);
    if (sel res_code.err) { ret err[fail.Fail].err{res_code.err}; }
    val res_ok: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?ctx.builder, res_code.ok, value.const_int(case_ix::u64, disc_ir));
    if (sel res_ok.err) { ret err[fail.Fail].err{res_ok.err}; }

    val res_cont: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_cont.err) { ret err[fail.Fail].err{res_cont.err}; }
    val res_trap: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_trap.err) { ret err[fail.Fail].err{res_trap.err}; }
    val cont: id.Block = res_cont.ok;
    val trap: id.Block = res_trap.ok;

    val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, res_ok.ok, cont, trap);
    if (sel res_cbr.err) { ret res_cbr; }
    builder.set_block(?ctx.builder, trap);
    val res_unreachable: err[fail.Fail] = builder.emit_unreachable(?ctx.builder);
    if (sel res_unreachable.err) { ret res_unreachable; }
    builder.set_block(?ctx.builder, cont);
    ret err[fail.Fail].ok{};
}

fun project_field_index(ctx: *lower_context.LowerContext, field_eid: ast_id.ExprId) res[u32, fail.Fail] {
    val res_field: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), field_eid, ?ctx.s.interner);
    lower_context.record_eval_result(ctx, res_field);
    if (sel res_field.err) { ret res[u32, fail.Fail].err{fail.message(res_field.err.message)}; }
    val fv: comptime.CTValue = res_field.ok;
    if (!comptime.is_descriptor(fv)) {
        ret res[u32, fail.Fail].err{fail.message("lower: `v.[f]` field operand is not a comptime field descriptor")};
    }
    ret res[u32, fail.Fail].ok{fv.data.fld.index};
}

fun lower_project_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_ptr: res[value.Value, fail.Fail] = lower_project_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun lower_project_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_fix: res[u32, fail.Fail] = project_field_index(ctx, e.data.project.field);
    if (sel res_fix.err) { ret res[value.Value, fail.Fail].err{res_fix.err}; }
    val field_ix: u32 = res_fix.ok;

    var rec_ty:   type.TypeId;
    val res_base: res[value.Value, fail.Fail] = member_receiver(ctx, e.data.project.object, ?rec_ty);
    if (sel res_base.err) { ret res_base; }

    val base: value.Value = res_base.ok;
    if (ctx.checks && type.is_tag(?ctx.s.types, rec_ty)) {
        val res_check: err[fail.Fail] = emit_case_check(ctx, base, rec_ty, field_ix);
        if (sel res_check.err) { ret res[value.Value, fail.Fail].err{res_check.err}; }
    }
    ret field_gep(ctx, base, rec_ty, field_ix);
}

fun vector_lane_of(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) opt[res[u64, fail.Fail]] {
    val obj_ty: type.TypeId = lower_context.expr_type_of(ctx, e.data.index.object);
    if (!type.is_vector(?ctx.s.types, obj_ty)) { ret opt[res[u64, fail.Fail]].none{}; }
    if (ast_expr.is_range(?e.data.index))      { ret opt[res[u64, fail.Fail]].none{}; }

    val cr: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        lower_context.module_source(ctx), e.data.index.index, ?ctx.s.interner);

    lower_context.record_eval_result(ctx, cr);
    if (sel cr.err) {
        ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].err{fail.message("lower: vector lane index is not a comptime constant")}};
    }
    val cv:     comptime.CTValue = cr.ok;
    val lane_o: opt[u64]         = comptime.ct_int_u64(cv);
    var lane:   u64              = 0;
    if (sel lane_o.some) { lane = lane_o.some; }
    if (!sel lane_o.some) {
        ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].err{fail.message("lower: vector lane index is not a non-negative integer constant")}};
    }
    ret opt[res[u64, fail.Fail]].some{res[u64, fail.Fail].ok{lane}};
}

fun lower_index_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    if (is_vector_range(ctx, e)) { ret lower_vector_range_read(ctx, eid, e); }
    val opt_lane: opt[res[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (sel opt_lane.some) {
        ret lower_vector_lane_read(ctx, eid, e, opt_lane.some);
    }
    val res_ptr: res[value.Value, fail.Fail] = lower_index_lvalue(ctx, eid, e);
    if (sel res_ptr.err) { ret res_ptr; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun lower_vector_lane_read(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr,
    lane: res[u64, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel lane.err) { ret res[value.Value, fail.Fail].err{lane.err}; }

    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (sel res_vec.err) { ret res_vec; }

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }

    ret builder.emit_vec_extract(?ctx.builder, res_vec.ok, value.const_int(lane.ok, builder.index_type(?ctx.builder)), res_ir.ok);
}

fun is_vector_range(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) bool {
    if (e.kind != ast_expr.EXPR_KIND_INDEX || !ast_expr.is_range(?e.data.index)) { ret false; }
    ret type.is_vector(?ctx.s.types, lower_context.expr_type_of(ctx, e.data.index.object));
}

# the first lane of a vector range, which sema holds to a comptime constant
fun vector_range_start(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[u64, fail.Fail] {
    val cr: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        lower_context.module_source(ctx), e.data.index.index, ?ctx.s.interner);
    lower_context.record_eval_result(ctx, cr);
    if (sel cr.err) { ret res[u64, fail.Fail].err{fail.message("lower: vector range start is not a comptime constant")}; }
    val start_o: opt[u64] = comptime.ct_int_u64(cr.ok);
    var start:   u64      = 0;
    if (sel start_o.some) { start = start_o.some; }
    if (!sel start_o.some) {
        ret res[u64, fail.Fail].err{fail.message("lower: vector range start is not a non-negative integer constant")};
    }
    ret res[u64, fail.Fail].ok{start};
}

# `v[start, n]` is the vector of lanes `start` to `start + n - 1` of `v`
fun lower_vector_range_read(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val start: res[u64, fail.Fail] = vector_range_start(ctx, e);
    if (sel start.err) { ret res[value.Value, fail.Fail].err{start.err}; }
    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (sel res_vec.err) { ret res_vec; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    ret extract_lanes(ctx, res_vec.ok, start.ok, res_ir.ok, opt[bool].none{});
}

# the vector of type `ty` whose lanes are `vec`'s from lane `start` on, each
# extended to `ty`'s lane type under `extend`'s signedness when it is present:
# the range is one shuffle, and the extension one lane-wise conversion
fun extract_lanes(ctx: *lower_context.LowerContext, vec: value.Value, start: u64, ty: Type, extend: opt[bool]) res[value.Value, fail.Fail] {
    val t:     *types.Table = builder.types_of(?ctx.builder);
    val lanes: u32          = irt.lanes(t, ty);
    var range: Type         = ty;
    if (sel extend.some) {
        val rt: res[Type, fail.Fail] = irt.vector(t, irt.element(t, vec.ty), lanes);
        if (sel rt.err) { ret res[value.Value, fail.Fail].err{rt.err}; }
        range = rt.ok;
    }
    var picks: collections_vector.Vector[u32] = collections_vector.init[u32](ctx.s.alloc);
    fin { collections_vector.dnit[u32](?picks); }
    var k: u32 = 0;
    for (k < lanes) {
        val pushed: res[usize, A.Error] = collections_vector.push[u32](?picks, (start + k::u64)::u32);
        if (sel pushed.err) { ret res[value.Value, fail.Fail].err{fail.refused(pushed.err)}; }
        k = k + 1;
    }
    val r: res[value.Value, fail.Fail] = builder.emit_shuffle(?ctx.builder, range, vec, vec, picks.data, lanes);
    if (sel r.err)       { ret r; }
    if (sel extend.none) { ret r; }
    if (extend.some)     { ret builder.emit_sext(?ctx.builder, r.ok, ty); }
    ret builder.emit_zext(?ctx.builder, r.ok, ty);
}

fun lower_index_lvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, lower_context.expr_type_of(ctx, e.data.index.object));
    val is_ptr: bool        = is_pointer_type(ctx, obj_ty);

    var base: value.Value;
    if (is_ptr) {
        val res_base: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
        if (sel res_base.err) { ret res_base; }
        base = res_base.ok;
    }
    or {
        val res_base: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
        if (sel res_base.err) { ret res_base; }
        base = res_base.ok;
    }

    val res_ix: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.index);
    if (sel res_ix.err) { ret res_ix; }
    val res_widen: res[value.Value, fail.Fail] = widen_index(ctx, res_ix.ok, lower_context.expr_type_of(ctx, e.data.index.index));
    if (sel res_widen.err) { ret res_widen; }
    val ix: value.Value = res_widen.ok;

    if (is_ptr) {
        val opt_pt: opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: index base has no pointer type")}; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type.TYPE_POINTER) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: an index sema accepted reads through an untyped pointer")};
        }
        val res_elem_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, pt.data.pointer.base);
        if (sel res_elem_ir.err) { ret res[value.Value, fail.Fail].err{res_elem_ir.err}; }
        ret builder.emit_step(?ctx.builder, base, res_elem_ir.ok, ix);
    }

    val res_obj_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, obj_ty);
    if (sel res_obj_ir.err) { ret res[value.Value, fail.Fail].err{res_obj_ir.err}; }
    ret builder.emit_element(?ctx.builder, base, res_obj_ir.ok, ix);
}

pub fun try_lower_comptime_intrinsic(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    if (intrinsic.is_path_call(ctx.scope.a, eid)) {
        ret opt[res[value.Value, fail.Fail]].some{lower_comptime_path(ctx, eid)};
    }
    val opt_ce: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, e.data.call.callee);
    if (sel opt_ce.err) { ret opt[res[value.Value, fail.Fail]].none{}; }
    var ce_value: ast_expr.Expr  = opt_ce.ok;
    val ce:       *ast_expr.Expr = ?ce_value;
    if (ce.kind != ast_expr.EXPR_KIND_COMPTIME_IDENT) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val id_of: intrinsic.Id = intrinsic.ident_intrinsic(lower_context.module_source(ctx), ce.data.comptime_ident.tok);
    if (id_of == intrinsic.TYPE_NAME || id_of == intrinsic.TYPE_ID) {
        val tv: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), eid, ?ctx.s.interner);
        lower_context.record_eval_result(ctx, tv);
        if (sel tv.err) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message(tv.err.message)}};
        }
        ret opt[res[value.Value, fail.Fail]].some{const_value_of(ctx, eid, tv.ok)};
    }
    if (!intrinsic.in_class(id_of, intrinsic.CLASS_LAYOUT)) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val arity: u32 = intrinsic.row(id_of).args;
    if (e.data.call.args_len < arity ||
        e.data.call.args_start::usize + e.data.call.args_len::usize > ctx.scope.a.expr_ids.len) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: comptime intrinsic argument index out of range")}};
    }
    val arg0_eid:  ast_id.ExprId        = ctx.scope.a.expr_ids.data[e.data.call.args_start];
    val op_ty:     type.TypeId          = type.strip_secret(?ctx.s.types, lower_context.expr_type_of(ctx, arg0_eid));
    val res_op_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, op_ty);
    if (sel res_op_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_op_ir.err}};
    }
    val op_ir: Type = res_op_ir.ok;

    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) {
        ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_ir.err}};
    }
    val rt: Type = res_ir.ok;

    var n: u64 = 0;
    if (id_of == intrinsic.SIZE_OF)  { n = builder.size_of(?ctx.builder, op_ir); }
    if (id_of == intrinsic.ALIGN_OF) { n = lower_context.storage_align(ctx, op_ty, op_ir); }
    if (id_of == intrinsic.LENGTH_OF) {
        val c_opt: opt[u32] = type.element_count(?ctx.s.types, op_ty);
        if (sel c_opt.none) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: $length_of operand has no element count")}};
        }
        n = c_opt.some::u64;
    }
    if (id_of == intrinsic.OFFSET_OF) {
        val f_eid: ast_id.ExprId                 = ctx.scope.a.expr_ids.data[e.data.call.args_start + 1];
        val opt_f: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, f_eid);
        if (sel opt_f.err) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: offset_of field argument out of range")}};
        }
        if (opt_f.ok.kind != ast_expr.EXPR_KIND_IDENT) {
            ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: offset_of field argument is not a bare identifier")}};
        }
        val field_ix: u32                 = field_index_in_type(ctx, op_ty, opt_f.ok.data.ident.tok);
        val at:       res[u64, fail.Fail] = lower_context.member_offset(ctx, op_ty, op_ir, field_ix);
        if (sel at.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{at.err}}; }
        n = at.ok;
    }
    val measured: err[fail.Fail] = lower_context.builder_state(ctx);
    if (sel measured.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{measured.err}}; }

    val dst_ty:  type.TypeId     = type.strip_secret(?ctx.s.types, lower_context.expr_type_of(ctx, eid));
    val opt_dst: opt[*type.Type] = type.get(?ctx.s.types, dst_ty);
    if (sel opt_dst.some) {
        val d: type.PrimDesc = type.prim_desc(opt_dst.some.kind);
        if (d.class == type.PRIM_CLASS_INT) {
            var max: u64 = 0;
            if (d.signed) { max = (1::u64 << (d.bits - 1)::usize) - 1; }
            or            { max = ~(0::u64) >> (64 - d.bits)::usize; }
            # sema refused a measurement its destination cannot hold
            if (n > max) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{fail.message("lower: a layout measurement sema admitted does not fit its type")}}; }
        }
    }

    ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].ok{value.const_int(n, rt)}};
}

fun lower_call(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val opt_intr: opt[res[value.Value, fail.Fail]] = try_lower_comptime_intrinsic(ctx, eid, e);
    if (sel opt_intr.some) { ret opt_intr.some; }

    val res_callee: res[value.Value, fail.Fail] = lower_callee(ctx, eid, e);
    if (sel res_callee.err) { ret res_callee; }
    val callee: value.Value = res_callee.ok;

    # a direct call is made through its callee's signature, an indirect one through the
    # function type it calls
    var sig: Type = callee.sig;
    if (callee.kind != value.VAL_FN) {
        val res_sig: res[lower_context.FnSig, fail.Fail] = lower_context.fn_sig_of_type(ctx, lower_context.expr_type_of(ctx, e.data.call.callee));
        if (sel res_sig.err) { ret res[value.Value, fail.Fail].err{res_sig.err}; }
        sig = res_sig.ok.sig;
    }

    # the callee's comptime parameters take no argument at run time
    val opt_cf: opt[lower_context.Declared] = callee_declared(ctx, e.data.call.callee);
    var cf:     lower_context.Declared      = lower_context.Declared{iface: nil, declaration: nil};
    var has_ct: bool                        = false;
    if (sel opt_cf.some) {
        cf     = opt_cf.some;
        has_ct = fe_sema.interface.declaration_has_comptime_param(cf.iface, cf.declaration);
    }

    val argc:       u32  = e.data.call.args_len;
    val has_spread: bool = call_has_spread(ctx, e);
    var rtc:        u32  = argc;
    if (has_ct)     { rtc = runtime_arg_count(cf, argc); }
    if (has_spread) { rtc = (argc - 1) + ctx.pack_len; }

    var args: *value.Value = nil;
    fin {
        if (args != nil) { A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize); }
    }
    if (rtc > 0) {
        val res_args: res[*value.Value, A.Error] = A.allocate[value.Value](ctx.s.alloc, rtc::usize);
        if (sel res_args.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_args.err)}; }
        args = res_args.ok;

        var dst: u32 = 0;
        var i:   u32 = 0;
        for (i < argc) {
            if (has_ct && arg_is_comptime(cf, i)) {
                i = i + 1;
                cnt;
            }
            val pool_ix: u32 = e.data.call.args_start + i;
            if (pool_ix::usize >= ctx.scope.a.expr_ids.len) {
                ret res[value.Value, fail.Fail].err{fail.message("lower: call argument index out of range")};
            }
            val arg_eid: ast_id.ExprId = ctx.scope.a.expr_ids.data[pool_ix];
            if (has_spread && is_spread_expr(ctx, arg_eid)) {
                var ii: u32 = 0;
                for (ii < ctx.pack_len) {
                    val res_slot: res[value.Value, fail.Fail] = load_pack_slot(ctx, ii);
                    if (sel res_slot.err) { ret res_slot; }
                    args[dst] = res_slot.ok;
                    dst       = dst + 1;
                    ii        = ii + 1;
                }
                i = i + 1;
                cnt;
            }
            val saved_armed: bool          = ctx.borrow_armed;
            val saved_eid:   ast_id.ExprId = ctx.borrow_eid;
            val saved_hit:   bool          = ctx.borrow_hit;
            ctx.borrow_armed = arg_may_borrow(ctx, e, i, arg_eid, has_ct, cf);
            ctx.borrow_eid   = arg_eid;
            ctx.borrow_hit   = false;
            val res_arg: res[value.Value, fail.Fail] = lower_rvalue(ctx, arg_eid);
            ctx.borrow_armed = saved_armed;
            ctx.borrow_eid   = saved_eid;
            ctx.borrow_hit   = saved_hit;
            if (sel res_arg.err) { ret res_arg; }
            args[dst] = res_arg.ok;
            dst       = dst + 1;
            i         = i + 1;
        }
    }

    # a call whose result holds a secret gives a secret result
    builder.set_secret(?ctx.builder, lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, eid)));
    val res_call: res[value.Value, fail.Fail] = builder.emit_call(?ctx.builder, callee, sig, args, rtc);
    builder.set_secret(?ctx.builder, false);
    ret res_call;
}

# whether call argument `ord` may be read in place: an aggregate place with no secret, read
# where no later argument can write anything, so the call's whole read of it still sees the
# value the argument had when it was evaluated
fun arg_may_borrow(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, ord: u32, arg_eid: ast_id.ExprId,
    has_ct: bool, cf: lower_context.Declared) bool {
    val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, arg_eid);
    if (sel opt_e.err) { ret false; }
    val k: ast_expr.ExprKind = opt_e.ok.kind;
    if (k != ast_expr.EXPR_KIND_IDENT && k != ast_expr.EXPR_KIND_MEMBER && k != ast_expr.EXPR_KIND_PROJECT
        && k != ast_expr.EXPR_KIND_INDEX && k != ast_expr.EXPR_KIND_UNARY) { ret false; }
    if (k == ast_expr.EXPR_KIND_UNARY && opt_e.ok.data.unary.op != ast_expr.UN_DEREF)      { ret false; }
    if (lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, arg_eid))) { ret false; }
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, arg_eid);
    if (sel res_ir.err)                    { ret false; }
    if (!is_aggregate_ir(ctx, res_ir.ok))  { ret false; }
    if (!expr_write_free(ctx, arg_eid, 0)) { ret false; }
    var j: u32 = ord + 1;
    for (j < e.data.call.args_len) {
        if (!(has_ct && arg_is_comptime(cf, j))) {
            val pool_ix: u32 = e.data.call.args_start + j;
            if (pool_ix::usize >= ctx.scope.a.expr_ids.len)                   { ret false; }
            if (!expr_write_free(ctx, ctx.scope.a.expr_ids.data[pool_ix], 0)) { ret false; }
        }
        j = j + 1;
    }
    ret true;
}

val WRITE_FREE_DEPTH: u32 = 32;

# whether evaluating `eid` can write no memory: a call, an assignment, or an address that
# escapes may, and anything unrecognized is taken to
fun expr_write_free(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, depth: u32) bool {
    if (ast_id.expr_is_nil(eid))  { ret true; }
    if (depth > WRITE_FREE_DEPTH) { ret false; }
    val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel opt_e.err) { ret false; }
    var e_value: ast_expr.Expr     = opt_e.ok;
    val e:       *ast_expr.Expr    = ?e_value;
    val k:       ast_expr.ExprKind = e.kind;
    val d:       u32               = depth + 1;
    if (k == ast_expr.EXPR_KIND_LIT_INT || k == ast_expr.EXPR_KIND_LIT_FLOAT || k == ast_expr.EXPR_KIND_LIT_CHAR
        || k == ast_expr.EXPR_KIND_LIT_STR || k == ast_expr.EXPR_KIND_LIT_NIL || k == ast_expr.EXPR_KIND_IDENT
        || k == ast_expr.EXPR_KIND_COMPTIME_IDENT || k == ast_expr.EXPR_KIND_TYPE_REF) { ret true; }
    if (k == ast_expr.EXPR_KIND_BINARY) {
        if (e.data.binary.op == ast_expr.BIN_ASSIGN) { ret false; }
        ret expr_write_free(ctx, e.data.binary.lhs, d) && expr_write_free(ctx, e.data.binary.rhs, d);
    }
    if (k == ast_expr.EXPR_KIND_UNARY) {
        if (e.data.unary.op == ast_expr.UN_ADDR) { ret false; }
        ret expr_write_free(ctx, e.data.unary.operand, d);
    }
    if (k == ast_expr.EXPR_KIND_INDEX) {
        ret expr_write_free(ctx, e.data.index.object, d) && expr_write_free(ctx, e.data.index.index, d)
            && expr_write_free(ctx, e.data.index.count, d);
    }
    if (k == ast_expr.EXPR_KIND_MEMBER)     { ret expr_write_free(ctx, e.data.member.object, d); }
    if (k == ast_expr.EXPR_KIND_PROJECT)    { ret expr_write_free(ctx, e.data.project.object, d) && expr_write_free(ctx, e.data.project.field, d); }
    if (k == ast_expr.EXPR_KIND_CAST)       { ret expr_write_free(ctx, e.data.cast.value, d); }
    if (k == ast_expr.EXPR_KIND_STRIP)      { ret expr_write_free(ctx, e.data.strip.value, d); }
    if (k == ast_expr.EXPR_KIND_SEL)        { ret expr_write_free(ctx, e.data.sel.place, d) && expr_write_free(ctx, e.data.sel.case_desc, d); }
    if (k == ast_expr.EXPR_KIND_ARRAY_LIT)  { ret pool_write_free(ctx, e.data.array_lit.elems_start, e.data.array_lit.elems_len, d); }
    if (k == ast_expr.EXPR_KIND_VECTOR_LIT) { ret pool_write_free(ctx, e.data.vector_lit.elems_start, e.data.vector_lit.elems_len, d); }
    if (k == ast_expr.EXPR_KIND_STRUCT_LIT) {
        if (!pool_write_free(ctx, e.data.struct_lit.elems_start, e.data.struct_lit.elems_len, d)) { ret false; }
        var i: u32 = 0;
        for (i < e.data.struct_lit.fields_len) {
            val pool_ix: u32 = e.data.struct_lit.fields_start + i;
            if (pool_ix::usize >= ctx.scope.a.field_inits.len)                         { ret false; }
            if (!expr_write_free(ctx, ctx.scope.a.field_inits.data[pool_ix].value, d)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret false;
}

fun pool_write_free(ctx: *lower_context.LowerContext, start: u32, len: u32, depth: u32) bool {
    var i: u32 = 0;
    for (i < len) {
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_ids.len)                       { ret false; }
        if (!expr_write_free(ctx, ctx.scope.a.expr_ids.data[pool_ix], depth)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun runtime_arg_count(cf: lower_context.Declared, argc: u32) u32 {
    var len: u32 = 0;
    var i:   u32 = 0;
    for (i < argc) {
        if (!arg_is_comptime(cf, i)) { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

fun arg_is_comptime(cf: lower_context.Declared, ord: u32) bool {
    if (cf.declaration == nil) { ret false; }
    val p: opt[fe_sema.interface.Param] = fe_sema.interface.param_at(cf.iface, cf.declaration, ord);
    ret sel p.some && p.some.comptime;
}

fun lower_callee(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val opt_cf: opt[lower_context.Declared] = callee_declared(ctx, e.data.call.callee);
    if (sel opt_cf.some) {
        val cf: lower_context.Declared = opt_cf.some;
        if (fe_sema.interface.declaration_has_comptime_param(cf.iface, cf.declaration)) {
            if (cf.declaration.generics > 0) {
                ret res[value.Value, fail.Fail].err{fail.message("lower: comptime value parameters on a generic function are not supported")};
            }
            ret lower_instance_reference(ctx, eid);
        }
        if ((cf.declaration.flags & fe_sema.interface.DECLARATION_PACK) != 0) { ret lower_instance_reference(ctx, eid); }
    }
    if (e.data.call.type_args_len == 0) {
        ret lower_rvalue(ctx, e.data.call.callee);
    }
    ret lower_instance_reference(ctx, eid);
}

# the function a call's callee names, as its module's interface describes it
fun callee_declared(ctx: *lower_context.LowerContext, callee: ast_id.ExprId) opt[lower_context.Declared] {
    val sid:     resolve.SymbolId     = lower_context.expr_symbol_of(ctx, callee);
    val opt_sym: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret opt[lower_context.Declared].none{}; }
    val sym: *resolve.Symbol = opt_sym.some;
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED)            { ret opt[lower_context.Declared].none{}; }
    if (sym.kind == resolve.SYM_IMPORTED && sym.definition_kind != resolve.SYM_FUN) { ret opt[lower_context.Declared].none{}; }
    val found: res[lower_context.Declared, fail.Fail] = lower_context.declared(ctx, sym);
    if (sel found.err)                                { ret opt[lower_context.Declared].none{}; }
    if (found.ok.declaration.kind != resolve.SYM_FUN) { ret opt[lower_context.Declared].none{}; }
    ret opt[lower_context.Declared].some{found.ok};
}

# where expression `eid` is written; an expression its syntax lacks records an internal failure
# and has the empty span
pub fun expr_span_of(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) lang_source.Span {
    val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel opt_e.ok)  { ret opt_e.ok.span; }
    if (sel opt_e.err) { fail.internal(?ctx.status, fail.describe(opt_e.err)); }
    var s: lang_source.Span;
    s.offset = 0;
    s.len    = 0;
    ret s;
}

fun report_expr(ctx: *lower_context.LowerContext, k: diagnostic_kind.Kind, eid: ast_id.ExprId, message: str) res[value.Value, fail.Fail] {
    diagnostic.record(ctx.diags, k, ctx.scope.a.file_id, expr_span_of(ctx, eid), message);
    ret res[value.Value, fail.Fail].err{fail.reported()};
}

# a reference to the instance sema decided `eid` names, by its symbol and signature
fun lower_instance_reference(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val found: res[*fe_sema.instance.Instance, fail.Fail] = lower_context.instance_of_call(ctx, eid);
    if (sel found.err) { ret res[value.Value, fail.Fail].err{found.err}; }
    val item: *fe_sema.instance.Instance = found.ok;

    val link: res[intern.StrId, fail.Fail] = lower_context.instance_link_name(ctx, item);
    if (sel link.err) { ret res[value.Value, fail.Fail].err{link.err}; }

    val sig: res[lower_context.FnSig, fail.Fail] = lower_context.instance_ref_sig(ctx, item);
    if (sel sig.err) { ret res[value.Value, fail.Fail].err{sig.err}; }
    ret fn_reference(ctx, link.ok, sig.ok);
}

fun lower_binary(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val op: ast_expr.BinOp = e.data.binary.op;

    if (op == ast_expr.BIN_ASSIGN)                       { ret lower_assign(ctx, eid, e); }
    if (op == ast_expr.BIN_AND || op == ast_expr.BIN_OR) { ret lower_logical(ctx, e); }

    val res_lhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val lhs: value.Value = res_lhs.ok;

    val res_rhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret res_rhs; }
    val rhs: value.Value = res_rhs.ok;

    val lty:    type.TypeId = lower_context.expr_type_of(ctx, e.data.binary.lhs);
    val rty:    type.TypeId = lower_context.expr_type_of(ctx, e.data.binary.rhs);
    val signed: bool        = is_signed_type(ctx, lty);

    if (type.is_vector(?ctx.s.types, lty)) {
        ret lower_vector_binary(ctx, op, lhs, rhs, lty);
    }

    if (is_compare_binop(op)) { ret lower_cmp(ctx, op, lhs, lty, rhs, rty); }

    if (op == ast_expr.BIN_ADD) { ret builder.emit_add(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SUB) { ret builder.emit_sub(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_MUL) { ret builder.emit_mul(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_DIV) {
        if (signed) { ret builder.emit_div_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_div_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_MOD) {
        if (signed) { ret builder.emit_rem_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_rem_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_BIT_AND) { ret builder.emit_and(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_OR)  { ret builder.emit_or(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_XOR) { ret builder.emit_xor(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHL)     { ret builder.emit_shl(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHR) {
        if (signed) { ret builder.emit_shr_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_shr_u(?ctx.builder, lhs, rhs);
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported binary operator")};
}

fun lower_vector_binary(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, lhs: value.Value, rhs: value.Value, lty: type.TypeId) res[value.Value, fail.Fail] {
    if (is_compare_binop(op)) { ret lower_vector_compare(ctx, op, lhs, rhs, vector_lane_signed(ctx, lty)); }

    if (op == ast_expr.BIN_ADD) { ret builder.emit_add(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SUB) { ret builder.emit_sub(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_MUL) { ret builder.emit_mul(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_DIV) {
        if (vector_lane_signed(ctx, lty)) { ret builder.emit_div_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_div_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_BIT_AND) { ret builder.emit_and(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_OR)  { ret builder.emit_or(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_BIT_XOR) { ret builder.emit_xor(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHL)     { ret builder.emit_shl(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_SHR) {
        if (vector_lane_signed(ctx, lty)) { ret builder.emit_shr_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_shr_u(?ctx.builder, lhs, rhs);
    }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported vector binary operator")};
}

fun lower_vector_compare(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, lhs: value.Value, rhs: value.Value, signed: bool) res[value.Value, fail.Fail] {
    val res_mask: res[Type, fail.Fail] = vector_mask_ir(ctx, lhs.ty);
    if (sel res_mask.err) { ret res[value.Value, fail.Fail].err{res_mask.err}; }
    val mask: Type = res_mask.ok;

    if (op == ast_expr.BIN_EQ)  { ret builder.emit_vcompare(?ctx.builder, opcode.EQ, opcode.FEQ_O, lhs, rhs, mask); }
    if (op == ast_expr.BIN_NEQ) { ret builder.emit_vcompare(?ctx.builder, opcode.NE, opcode.FNE_U, lhs, rhs, mask); }
    if (op == ast_expr.BIN_LT)  { ret builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), opcode.FLT_O, lhs, rhs, mask); }
    if (op == ast_expr.BIN_LEQ) { ret builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), opcode.FLE_O, lhs, rhs, mask); }
    if (op == ast_expr.BIN_GT)  { ret builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), opcode.FLT_O, rhs, lhs, mask); }
    if (op == ast_expr.BIN_GEQ) { ret builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), opcode.FLE_O, rhs, lhs, mask); }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported vector comparison operator")};
}

fun vec_cmp_lt(signed: bool) Opcode {
    if (signed) { ret opcode.LT_S; }
    ret opcode.LT_U;
}

fun vec_cmp_le(signed: bool) Opcode {
    if (signed) { ret opcode.LE_S; }
    ret opcode.LE_U;
}

fun vector_lane_signed(ctx: *lower_context.LowerContext, lty: type.TypeId) bool {
    val base: type.TypeId = type.strip_secret(?ctx.s.types, lty);
    ret type.prim_desc(type.vector_element(?ctx.s.types, base)).signed;
}

# the mask a comparison of `vec_ir` vectors gives: an integer lane as wide as each of theirs
fun vector_mask_ir(ctx: *lower_context.LowerContext, vec_ir: Type) res[Type, fail.Fail] {
    val t: *types.Table = builder.types_of(?ctx.builder);
    if (!irt.is_vector(t, vec_ir)) { ret res[Type, fail.Fail].err{fail.message("lower: vector compare operand is not a vector")}; }
    val lane: Type = irt.element(t, vec_ir);
    var bits: u32  = irt.int_width(t, lane);
    if (irt.is_float(t, lane)) { bits = irt.float_width(t, lane); }
    val res_elem: res[Type, fail.Fail] = irt.int(t, bits);
    if (sel res_elem.err) { ret res_elem; }
    ret irt.vector(t, res_elem.ok, irt.lanes(t, vec_ir));
}

fun is_compare_binop(op: ast_expr.BinOp) bool {
    ret op == ast_expr.BIN_EQ || op == ast_expr.BIN_NEQ ||
        op == ast_expr.BIN_LT || op == ast_expr.BIN_LEQ ||
        op == ast_expr.BIN_GT || op == ast_expr.BIN_GEQ;
}

fun lower_cmp(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, lhs: value.Value, lty: type.TypeId, rhs: value.Value, rty: type.TypeId) res[value.Value, fail.Fail] {
    if (is_float_type(ctx, lty) || is_float_type(ctx, rty)) {
        var fl:        value.Value    = lhs;
        var fr:        value.Value    = rhs;
        val res_unify: err[fail.Fail] = unify_float_compare_widths(ctx, ?fl, lty, ?fr, rty);
        if (sel res_unify.err) { ret res[value.Value, fail.Fail].err{res_unify.err}; }
        ret emit_cmp_int(ctx, op, false, fl, fr);
    }

    val ls: bool = is_signed_type(ctx, lty);
    val rs: bool = is_signed_type(ctx, rty);

    if (ls == rs) {
        var sl:        value.Value    = lhs;
        var sr:        value.Value    = rhs;
        val res_unify: err[fail.Fail] = unify_int_compare_widths(ctx, ?sl, lty, ?sr, rty);
        if (sel res_unify.err) { ret res[value.Value, fail.Fail].err{res_unify.err}; }
        ret emit_cmp_int(ctx, op, ls, sl, sr);
    }

    var s_val:    value.Value = lhs;
    var s_ty:     type.TypeId = lty;
    var u_val:    value.Value = rhs;
    var u_ty:     type.TypeId = rty;
    var s_is_lhs: bool        = true;
    if (!ls) {
        s_val    = rhs;
        s_ty     = rty;
        u_val    = lhs;
        u_ty     = lty;
        s_is_lhs = false;
    }

    # a mixed-sign compare runs at the register width, or at the wider operand's
    # width when one is wider than a register (u128 against i64, i128 against u128)
    var w: u32 = 64;
    if (scalar_bits(ctx, s_ty) > w) { w = scalar_bits(ctx, s_ty); }
    if (scalar_bits(ctx, u_ty) > w) { w = scalar_bits(ctx, u_ty); }

    val res_tyw: res[Type, fail.Fail] = irt.int(?ctx.m.types, w);
    if (sel res_tyw.err) { ret res[value.Value, fail.Fail].err{res_tyw.err}; }
    val tyw: Type = res_tyw.ok;

    val res_sw: res[value.Value, fail.Fail] = widen_signed_to(ctx, s_val, s_ty, tyw, w);
    if (sel res_sw.err) { ret res_sw; }
    val sw: value.Value = res_sw.ok;

    if (scalar_bits(ctx, u_ty) < w) {
        val res_uw: res[value.Value, fail.Fail] = builder.emit_zext(?ctx.builder, u_val, tyw);
        if (sel res_uw.err) { ret res_uw; }
        val uw: value.Value = res_uw.ok;
        if (s_is_lhs) { ret emit_cmp_int(ctx, op, true, sw, uw); }
        ret emit_cmp_int(ctx, op, true, uw, sw);
    }

    ret lower_cmp_signed_wide(ctx, op, sw, u_val, s_is_lhs, tyw);
}

fun emit_cmp_int(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, signed: bool, lhs: value.Value, rhs: value.Value) res[value.Value, fail.Fail] {
    if (op == ast_expr.BIN_EQ)  { ret builder.emit_cmp_eq(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_NEQ) { ret builder.emit_cmp_ne(?ctx.builder, lhs, rhs); }
    if (op == ast_expr.BIN_LT) {
        if (signed) { ret builder.emit_cmp_lt_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_cmp_lt_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_LEQ) {
        if (signed) { ret builder.emit_cmp_le_s(?ctx.builder, lhs, rhs); }
        ret builder.emit_cmp_le_u(?ctx.builder, lhs, rhs);
    }
    if (op == ast_expr.BIN_GT) {
        if (signed) { ret builder.emit_cmp_lt_s(?ctx.builder, rhs, lhs); }
        ret builder.emit_cmp_lt_u(?ctx.builder, rhs, lhs);
    }
    if (op == ast_expr.BIN_GEQ) {
        if (signed) { ret builder.emit_cmp_le_s(?ctx.builder, rhs, lhs); }
        ret builder.emit_cmp_le_u(?ctx.builder, rhs, lhs);
    }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comparison operator")};
}

fun widen_signed_to(ctx: *lower_context.LowerContext, v: value.Value, vty: type.TypeId, tyw: Type, w: u32) res[value.Value, fail.Fail] {
    if (scalar_bits(ctx, vty) >= w) { ret res[value.Value, fail.Fail].ok{v}; }
    ret builder.emit_sext(?ctx.builder, v, tyw);
}

fun lower_cmp_signed_wide(ctx: *lower_context.LowerContext, op: ast_expr.BinOp, s64: value.Value, u: value.Value, s_is_lhs: bool, ty64: Type) res[value.Value, fail.Fail] {
    var nop: ast_expr.BinOp = op;
    if (!s_is_lhs) { nop = swap_cmp_op(op); }
    val zero: value.Value = value.const_int(0, ty64);

    if (nop == ast_expr.BIN_LT) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
            builder.emit_cmp_lt_u(?ctx.builder, s64, u));
    }
    if (nop == ast_expr.BIN_LEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
            builder.emit_cmp_le_u(?ctx.builder, s64, u));
    }
    if (nop == ast_expr.BIN_GT) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
            builder.emit_cmp_lt_u(?ctx.builder, u, s64));
    }
    if (nop == ast_expr.BIN_GEQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
            builder.emit_cmp_le_u(?ctx.builder, u, s64));
    }
    if (nop == ast_expr.BIN_EQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
            builder.emit_cmp_eq(?ctx.builder, s64, u));
    }
    if (nop == ast_expr.BIN_NEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
            builder.emit_cmp_ne(?ctx.builder, s64, u));
    }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comparison operator")};
}

fun swap_cmp_op(op: ast_expr.BinOp) ast_expr.BinOp {
    if (op == ast_expr.BIN_LT)  { ret ast_expr.BIN_GT; }
    if (op == ast_expr.BIN_LEQ) { ret ast_expr.BIN_GEQ; }
    if (op == ast_expr.BIN_GT)  { ret ast_expr.BIN_LT; }
    if (op == ast_expr.BIN_GEQ) { ret ast_expr.BIN_LEQ; }
    ret op;
}

fun cmp_or(ctx: *lower_context.LowerContext, a: res[value.Value, fail.Fail], b: res[value.Value, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel a.err) { ret a; }
    if (sel b.err) { ret b; }
    ret builder.emit_or(?ctx.builder, a.ok, b.ok);
}

fun cmp_and(ctx: *lower_context.LowerContext, a: res[value.Value, fail.Fail], b: res[value.Value, fail.Fail]) res[value.Value, fail.Fail] {
    if (sel a.err) { ret a; }
    if (sel b.err) { ret b; }
    ret builder.emit_and(?ctx.builder, a.ok, b.ok);
}

fun unify_float_compare_widths(ctx: *lower_context.LowerContext, lhs: *value.Value, lty: type.TypeId, rhs: *value.Value, rty: type.TypeId) err[fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == rw) { ret err[fail.Fail].ok{}; }
    if (lw < rw) {
        val res_ext: res[value.Value, fail.Fail] = builder.emit_fp_ext(?ctx.builder, @lhs, rhs.ty);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        @lhs = res_ext.ok;
        ret err[fail.Fail].ok{};
    }
    val res_ext: res[value.Value, fail.Fail] = builder.emit_fp_ext(?ctx.builder, @rhs, lhs.ty);
    if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
    @rhs = res_ext.ok;
    ret err[fail.Fail].ok{};
}

fun unify_int_compare_widths(ctx: *lower_context.LowerContext, lhs: *value.Value, lty: type.TypeId, rhs: *value.Value, rty: type.TypeId) err[fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == 0 || rw == 0 || lw == rw) { ret err[fail.Fail].ok{}; }
    if (lw < rw) {
        val res_ext: res[value.Value, fail.Fail] = extend_int_value(ctx, @lhs, lty, rhs.ty);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        @lhs = res_ext.ok;
        ret err[fail.Fail].ok{};
    }
    val res_ext: res[value.Value, fail.Fail] = extend_int_value(ctx, @rhs, rty, lhs.ty);
    if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
    @rhs = res_ext.ok;
    ret err[fail.Fail].ok{};
}

fun extend_int_value(ctx: *lower_context.LowerContext, v: value.Value, from: type.TypeId, to: Type) res[value.Value, fail.Fail] {
    if (is_signed_type(ctx, from)) { ret builder.emit_sext(?ctx.builder, v, to); }
    ret builder.emit_zext(?ctx.builder, v, to);
}

fun lower_assign(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val stored: opt[res[value.Value, fail.Fail]] = lower_vector_store(ctx, e);
    if (sel stored.some) { ret stored.some; }

    # the snapshot is only needed when the value is used again or the destination's address
    # expression can write memory
    var borrowed: bool                        = false;
    val res_rhs:  res[value.Value, fail.Fail] = lower_stored_rvalue(ctx, e.data.binary.rhs,
        ast_id.expr_same(eid, ctx.discard_eid) && expr_write_free(ctx, e.data.binary.lhs, 0), ?borrowed);
    if (sel res_rhs.err) { ret res_rhs; }
    val rhs: value.Value = res_rhs.ok;

    val wrote_r: res[bool, fail.Fail] = lower_vector_lane_write(ctx, e.data.binary.lhs, rhs);
    if (sel wrote_r.err) { ret res[value.Value, fail.Fail].err{wrote_r.err}; }
    if (wrote_r.ok)      { ret assign_epilogue(ctx, e, rhs); }

    val res_lhs: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val ptr: value.Value = res_lhs.ok;

    val res_store: err[fail.Fail] = builder.emit_store_marked(?ctx.builder, rhs, ptr, access_is_volatile(ctx, e.data.binary.lhs));
    if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }

    # a borrowed source may change later, and the destination holds the value it wrote
    if (borrowed) { ret assign_epilogue(ctx, e, value.retype(ptr, rhs.ty)); }
    ret assign_epilogue(ctx, e, rhs);
}

# the value a store consumes. when `in_place` holds, nothing writes memory between this read
# and the store, so an aggregate place is read where it lies and the store copies from it:
# the aggregate copy is overlap-safe, so no snapshot sits between them
pub fun lower_stored_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, in_place: bool, borrowed: *bool) res[value.Value, fail.Fail] {
    val saved_armed: bool          = ctx.borrow_armed;
    val saved_eid:   ast_id.ExprId = ctx.borrow_eid;
    val saved_hit:   bool          = ctx.borrow_hit;
    ctx.borrow_armed = in_place;
    ctx.borrow_eid   = eid;
    ctx.borrow_hit   = false;
    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, eid);
    @borrowed        = ctx.borrow_hit;
    ctx.borrow_armed = saved_armed;
    ctx.borrow_eid   = saved_eid;
    ctx.borrow_hit   = saved_hit;
    if (sel res_v.err) { ret res_v; }
    var v: value.Value = res_v.ok;
    # the store reads the source itself, so it carries the secrecy the snapshot copy did
    if (@borrowed && lower_context.type_carries_secret(ctx, lower_context.expr_type_of(ctx, eid))) { v.secret = true; }
    ret res[value.Value, fail.Fail].ok{v};
}

# `place = v::[N]T` stores the vector where the array lives: one vector store,
# with no array value in between. the assignment's value is the place it wrote
fun lower_vector_store(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) opt[res[value.Value, fail.Fail]] {
    val rhs_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, e.data.binary.rhs);
    if (sel rhs_opt.err) { ret opt[res[value.Value, fail.Fail]].none{}; }
    val rhs: ast_expr.Expr = rhs_opt.ok;
    if (rhs.kind != ast_expr.EXPR_KIND_CAST || rhs.data.cast.reinterpret) { ret opt[res[value.Value, fail.Fail]].none{}; }
    val to_ty: type.TypeId = lower_context.expr_type_of(ctx, e.data.binary.rhs);
    if (!is_array_type(ctx, to_ty))                                                          { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (!type.is_vector(?ctx.s.types, lower_context.expr_type_of(ctx, rhs.data.cast.value))) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val res_arr: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_arr.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_arr.err}}; }
    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, rhs.data.cast.value);
    if (sel res_vec.err) { ret opt[res[value.Value, fail.Fail]].some{res_vec}; }
    val res_lhs: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret opt[res[value.Value, fail.Fail]].some{res_lhs}; }

    val res_store: err[fail.Fail] = builder.emit_store_marked(?ctx.builder, res_vec.ok, res_lhs.ok, access_is_volatile(ctx, e.data.binary.lhs));
    if (sel res_store.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_store.err}}; }
    ret opt[res[value.Value, fail.Fail]].some{assign_epilogue(ctx, e, value.retype(res_lhs.ok, res_arr.ok))};
}

fun assign_epilogue(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, rhs: value.Value) res[value.Value, fail.Fail] {
    if (ctx.debug) {
        val opt_lhs: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, e.data.binary.lhs);
        if (sel opt_lhs.ok) {
            var lhs_e_value: ast_expr.Expr  = opt_lhs.ok;
            val lhs_e:       *ast_expr.Expr = ?lhs_e_value;
            if (lhs_e.kind == ast_expr.EXPR_KIND_IDENT) {
                val lhs_sem: type.TypeId    = lower_context.expr_type_of(ctx, e.data.binary.lhs);
                val res_dbg: err[fail.Fail] = lower_context.emit_dbg_birth(ctx, lhs_e.data.ident.tok, lhs_sem, opt[u32].none{}, rhs, opt[value.Value].none{});
                if (sel res_dbg.err) {
                    ret res[value.Value, fail.Fail].err{res_dbg.err};
                }
            }
        }
    }
    ret res[value.Value, fail.Fail].ok{rhs};
}

fun lower_vector_lane_write(ctx: *lower_context.LowerContext, lhs: ast_id.ExprId, rhs: value.Value) res[bool, fail.Fail] {
    val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, lhs);
    if (sel opt_e.err) { ret res[bool, fail.Fail].ok{false}; }
    var e_value: ast_expr.Expr  = opt_e.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (e.kind != ast_expr.EXPR_KIND_INDEX) { ret res[bool, fail.Fail].ok{false}; }
    if (is_vector_range(ctx, e))            { ret lower_vector_range_write(ctx, e, rhs); }

    val opt_lane: opt[res[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (sel opt_lane.none) { ret res[bool, fail.Fail].ok{false}; }
    val lane_r: res[u64, fail.Fail] = opt_lane.some;
    if (sel lane_r.err) { ret res[bool, fail.Fail].err{lane_r.err}; }

    val res_slot: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
    if (sel res_slot.err) { ret res[bool, fail.Fail].err{res_slot.err}; }
    val slot: value.Value = res_slot.ok;

    val res_vty: res[Type, fail.Fail] = lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, e.data.index.object));
    if (sel res_vty.err) { ret res[bool, fail.Fail].err{res_vty.err}; }

    val res_old: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, slot, res_vty.ok);
    if (sel res_old.err) { ret res[bool, fail.Fail].err{res_old.err}; }

    val res_new: res[value.Value, fail.Fail] = builder.emit_vec_insert(?ctx.builder, res_old.ok, value.const_int(lane_r.ok, builder.index_type(?ctx.builder)), rhs);
    if (sel res_new.err) { ret res[bool, fail.Fail].err{res_new.err}; }

    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_new.ok, slot);
    if (sel res_store.err) { ret res[bool, fail.Fail].err{res_store.err}; }
    ret res[bool, fail.Fail].ok{true};
}

# `v[start, n] = x` replaces lanes `start` to `start + n - 1` of `v` with `x`'s
fun lower_vector_range_write(ctx: *lower_context.LowerContext, e: *ast_expr.Expr, rhs: value.Value) res[bool, fail.Fail] {
    val start: res[u64, fail.Fail] = vector_range_start(ctx, e);
    if (sel start.err) { ret res[bool, fail.Fail].err{start.err}; }

    val res_slot: res[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
    if (sel res_slot.err) { ret res[bool, fail.Fail].err{res_slot.err}; }
    val slot: value.Value = res_slot.ok;

    val res_vty: res[Type, fail.Fail] = lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, e.data.index.object));
    if (sel res_vty.err) { ret res[bool, fail.Fail].err{res_vty.err}; }
    val t:     *types.Table = builder.types_of(?ctx.builder);
    val elem:  Type         = irt.element(t, rhs.ty);
    val lanes: u32          = irt.lanes(t, rhs.ty);
    val xty:   Type         = builder.index_type(?ctx.builder);

    val res_old: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, slot, res_vty.ok);
    if (sel res_old.err) { ret res[bool, fail.Fail].err{res_old.err}; }
    var cur: value.Value = res_old.ok;
    var k:   u32         = 0;
    for (k < lanes) {
        val x: res[value.Value, fail.Fail] = builder.emit_vec_extract(?ctx.builder, rhs, value.const_int(k::u64, xty), elem);
        if (sel x.err) { ret res[bool, fail.Fail].err{x.err}; }
        val ins: res[value.Value, fail.Fail] = builder.emit_vec_insert(?ctx.builder, cur, value.const_int(start.ok + k::u64, xty), x.ok);
        if (sel ins.err) { ret res[bool, fail.Fail].err{ins.err}; }
        cur = ins.ok;
        k   = k + 1;
    }
    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, cur, slot);
    if (sel res_store.err) { ret res[bool, fail.Fail].err{res_store.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun lower_logical(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_i8: res[Type, fail.Fail] = irt.int(?ctx.m.types, 8);
    if (sel res_i8.err) { ret res[value.Value, fail.Fail].err{res_i8.err}; }
    val i8: Type = res_i8.ok;

    val res_lhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (sel res_lhs.err) { ret res_lhs; }
    val res_lhs_condition: res[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.lhs, res_lhs.ok);
    if (sel res_lhs_condition.err) { ret res_lhs_condition; }
    var lhs: [1]value.Value = [1]value.Value{res_lhs_condition.ok};

    val res_rhs_block: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_rhs_block.err) { ret res[value.Value, fail.Fail].err{res_rhs_block.err}; }
    val rhs_block: id.Block = res_rhs_block.ok;

    # the join takes the operand that decided the result, the left's when it short-circuits
    var joined: [1]Type  = [1]Type{i8};
    var secret: [1]bool  = [1]bool{lhs[0].secret};
    val join:   id.Block = builder.new_block_with(?ctx.builder, ?joined[0], ?secret[0], 1);

    val res_short: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_short.err) { ret res[value.Value, fail.Fail].err{res_short.err}; }
    val short: id.Block = res_short.ok;

    var res_cbr: err[fail.Fail] = err[fail.Fail].ok{};
    if (e.data.binary.op == ast_expr.BIN_AND) { res_cbr = builder.emit_cbr(?ctx.builder, lhs[0], rhs_block, short); }
    or                                        { res_cbr = builder.emit_cbr(?ctx.builder, lhs[0], short, rhs_block); }
    if (sel res_cbr.err)                      { ret res[value.Value, fail.Fail].err{res_cbr.err}; }

    builder.set_block(?ctx.builder, short);
    val res_skip: err[fail.Fail] = builder.emit_br_args(?ctx.builder, join, ?lhs[0], 1);
    if (sel res_skip.err) { ret res[value.Value, fail.Fail].err{res_skip.err}; }

    builder.set_block(?ctx.builder, rhs_block);
    val res_rhs: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (sel res_rhs.err) { ret res_rhs; }
    val res_rhs_condition: res[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.rhs, res_rhs.ok);
    if (sel res_rhs_condition.err) { ret res_rhs_condition; }
    var rhs:    [1]value.Value = [1]value.Value{res_rhs_condition.ok};
    val res_br: err[fail.Fail] = builder.emit_br_args(?ctx.builder, join, ?rhs[0], 1);
    if (sel res_br.err) { ret res[value.Value, fail.Fail].err{res_br.err}; }

    builder.set_block(?ctx.builder, join);
    ret res[value.Value, fail.Fail].ok{builder.block_param(?ctx.builder, join, 0, i8)};
}

fun address_operand_names_function(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    val e_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel e_opt.err) { ret false; }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (e.kind == ast_expr.EXPR_KIND_GENERIC_INSTANCE)                             { ret true; }
    if (e.kind != ast_expr.EXPR_KIND_IDENT && e.kind != ast_expr.EXPR_KIND_MEMBER) { ret false; }
    val sid:     resolve.SymbolId     = lower_context.expr_symbol_of(ctx, eid);
    val sym_opt: opt[*resolve.Symbol] = lower_context.symbol_of(ctx, sid);
    if (sel sym_opt.none) { ret false; }
    ret names_function(ctx, sym_opt.some);
}

fun lower_unary(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val op: ast_expr.UnOp = e.data.unary.op;

    if (op == ast_expr.UN_ADDR) {
        if (address_operand_names_function(ctx, e.data.unary.operand)) {
            ret lower_rvalue(ctx, e.data.unary.operand);
        }
        ret lower_lvalue(ctx, e.data.unary.operand);
    }
    if (op == ast_expr.UN_DEREF) {
        val res_ptr: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
        if (sel res_ptr.err) { ret res_ptr; }
        val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
        ret rvalue_at(ctx, res_ptr.ok, res_ir.ok, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
    }

    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
    if (sel res_v.err) { ret res_v; }
    val v: value.Value = res_v.ok;

    if (op == ast_expr.UN_NEG)     { ret builder.emit_neg(?ctx.builder, v); }
    if (op == ast_expr.UN_BIT_NOT) { ret builder.emit_not(?ctx.builder, v); }
    if (op == ast_expr.UN_NOT)     { ret builder.emit_cmp_ne(?ctx.builder, v, value.const_int(1, v.ty)); }

    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported unary operator")};
}

pub fun condition_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: value.Value) res[value.Value, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel e_opt.ok) {
        var e_value: ast_expr.Expr  = e_opt.ok;
        val e:       *ast_expr.Expr = ?e_value;
        if (e.kind == ast_expr.EXPR_KIND_BINARY && (is_compare_binop(e.data.binary.op) || e.data.binary.op == ast_expr.BIN_AND || e.data.binary.op == ast_expr.BIN_OR)) { ret res[value.Value, fail.Fail].ok{v}; }
        if (e.kind == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_NOT) {
            ret res[value.Value, fail.Fail].ok{v};
        }
        # a runtime `sel` is already the discriminator compare; a folded one stays a constant
        if (e.kind == ast_expr.EXPR_KIND_SEL && v.kind != value.VAL_INT) {
            ret res[value.Value, fail.Fail].ok{v};
        }
    }
    ret builder.emit_cmp_eq(?ctx.builder, v, value.const_int(1, v.ty));
}

fun lower_cast(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val from_ty: type.TypeId = lower_context.expr_type_of(ctx, e.data.cast.value);
    val to_ty:   type.TypeId = lower_context.type_resolved_of(ctx, e.data.cast.ty);
    if (!e.data.cast.reinterpret) {
        val shaped: opt[res[value.Value, fail.Fail]] = lower_cast_shape(ctx, e.data.cast.value, from_ty, to_ty);
        if (sel shaped.some) { ret shaped.some; }
    }

    val res_v: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.cast.value);
    if (sel res_v.err) { ret res_v; }
    val v: value.Value = res_v.ok;

    val res_dst: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_dst.err) { ret res[value.Value, fail.Fail].err{res_dst.err}; }
    val dst: Type = res_dst.ok;

    # a vector converts lane by lane, so the rule is chosen from the lane types
    var from_rule: type.TypeId = from_ty;
    var to_rule:   type.TypeId = to_ty;
    val lanewise:  bool        = !e.data.cast.reinterpret && type.is_vector(?ctx.s.types, from_ty) && type.is_vector(?ctx.s.types, to_ty);
    if (lanewise) {
        val lf: opt[type.TypeId] = type.prim(?ctx.s.types, type.vector_element(?ctx.s.types, from_ty));
        val lt: opt[type.TypeId] = type.prim(?ctx.s.types, type.vector_element(?ctx.s.types, to_ty));
        if (sel lf.some) { from_rule = lf.some; }
        or               { ret res[value.Value, fail.Fail].err{fail.message("lower: vector cast lane type is not a primitive")}; }
        if (sel lt.some) { to_rule = lt.some; }
        or               { ret res[value.Value, fail.Fail].err{fail.message("lower: vector cast lane type is not a primitive")}; }
    }

    if (e.data.cast.reinterpret || !type.is_numeric(?ctx.s.types, from_rule) || !type.is_numeric(?ctx.s.types, to_rule)) {
        ret lower_reinterpret(ctx, v, from_ty, dst);
    }

    val from_float:  bool = is_float_type(ctx, from_rule);
    val to_float:    bool = is_float_type(ctx, to_rule);
    val from_signed: bool = is_signed_type(ctx, from_rule);
    val to_signed:   bool = is_signed_type(ctx, to_rule);
    val from_bits:   u32  = scalar_bits(ctx, from_rule);
    val to_bits:     u32  = scalar_bits(ctx, to_rule);

    if (from_float && to_float) {
        if (to_bits < from_bits) { ret builder.emit_fp_trunc(?ctx.builder, v, dst); }
        if (to_bits > from_bits) { ret builder.emit_fp_ext(?ctx.builder, v, dst); }
        ret emit_retype(ctx, v, dst);
    }
    if (from_float && !to_float) {
        if (to_signed) { ret builder.emit_fp_to_si(?ctx.builder, v, dst); }
        ret builder.emit_fp_to_ui(?ctx.builder, v, dst);
    }
    if (!from_float && to_float) {
        if (from_signed) { ret builder.emit_si_to_fp(?ctx.builder, v, dst); }
        ret builder.emit_ui_to_fp(?ctx.builder, v, dst);
    }

    if (to_bits < from_bits) { ret builder.emit_trunc(?ctx.builder, v, dst); }
    if (to_bits > from_bits) {
        if (from_signed) { ret builder.emit_sext(?ctx.builder, v, dst); }
        ret builder.emit_zext(?ctx.builder, v, dst);
    }
    ret emit_retype(ctx, v, dst);
}

# the conversions whose operand's shape is their lowering: an array in memory
# read as a vector is one vector load, and a range of a vector widened lane by
# lane extends straight from the vector
fun lower_cast_shape(ctx: *lower_context.LowerContext, operand: ast_id.ExprId, from_ty: type.TypeId, to_ty: type.TypeId) opt[res[value.Value, fail.Fail]] {
    if (!type.is_vector(?ctx.s.types, to_ty)) { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (is_array_type(ctx, from_ty)) {
        ret opt[res[value.Value, fail.Fail]].some{lower_array_as_vector(ctx, operand, to_ty)};
    }
    if (type.is_vector(?ctx.s.types, from_ty)) { ret lower_range_cast(ctx, operand, from_ty, to_ty); }
    ret opt[res[value.Value, fail.Fail]].none{};
}

fun lower_array_as_vector(ctx: *lower_context.LowerContext, operand: ast_id.ExprId, to_ty: type.TypeId) res[value.Value, fail.Fail] {
    val res_dst: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_dst.err) { ret res[value.Value, fail.Fail].err{res_dst.err}; }
    val res_ptr: res[value.Value, fail.Fail] = array_address(ctx, operand);
    if (sel res_ptr.err) { ret res_ptr; }
    ret builder.emit_load_marked(?ctx.builder, value.retype(res_ptr.ok, builder.ptr_type(?ctx.builder)), res_dst.ok, access_is_volatile(ctx, operand));
}

# where an array operand's elements are: a place is read where it lives, and
# any other array value is already a pointer to its own bytes
fun array_address(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, eid);
    if (sel e_opt.err) { ret res[value.Value, fail.Fail].err{e_opt.err}; }
    var e_value: ast_expr.Expr     = e_opt.ok;
    val k:       ast_expr.ExprKind = ast.expr_place_kind(?e_value);
    if (k != ast_expr.EXPR_KIND_ERROR && k != ast_expr.EXPR_KIND_CALL && !place_roots_in_const_elem(ctx, eid)) {
        ret lower_lvalue(ctx, eid);
    }
    ret lower_rvalue(ctx, eid);
}

# `v[a, n]::T` over an integer vector, where each lane of `T` is wider: the range is
# extracted and each lane extended straight from `v`
fun lower_range_cast(ctx: *lower_context.LowerContext, operand: ast_id.ExprId, from_ty: type.TypeId, to_ty: type.TypeId) opt[res[value.Value, fail.Fail]] {
    val e_opt: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, operand);
    if (sel e_opt.err) { ret opt[res[value.Value, fail.Fail]].none{}; }
    var e_value: ast_expr.Expr  = e_opt.ok;
    val e:       *ast_expr.Expr = ?e_value;
    if (!is_vector_range(ctx, e)) { ret opt[res[value.Value, fail.Fail]].none{}; }

    val lf: opt[type.TypeId] = type.prim(?ctx.s.types, type.vector_element(?ctx.s.types, from_ty));
    val lt: opt[type.TypeId] = type.prim(?ctx.s.types, type.vector_element(?ctx.s.types, to_ty));
    if (sel lf.none)                                                { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (sel lt.none)                                                { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (is_float_type(ctx, lf.some) || is_float_type(ctx, lt.some)) { ret opt[res[value.Value, fail.Fail]].none{}; }
    if (scalar_bits(ctx, lt.some) <= scalar_bits(ctx, lf.some))     { ret opt[res[value.Value, fail.Fail]].none{}; }

    val start: res[u64, fail.Fail] = vector_range_start(ctx, e);
    if (sel start.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{start.err}}; }
    val res_dst: res[Type, fail.Fail] = lower_context.lower_type(ctx, to_ty);
    if (sel res_dst.err) { ret opt[res[value.Value, fail.Fail]].some{res[value.Value, fail.Fail].err{res_dst.err}}; }
    val res_vec: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (sel res_vec.err) { ret opt[res[value.Value, fail.Fail]].some{res_vec}; }
    ret opt[res[value.Value, fail.Fail]].some{extract_lanes(ctx, res_vec.ok, start.ok, res_dst.ok, opt[bool].some{is_signed_type(ctx, lf.some)})};
}

fun emit_retype(ctx: *lower_context.LowerContext, v: value.Value, dst: Type) res[value.Value, fail.Fail] {
    if (irt.same(v.ty, dst)) { ret res[value.Value, fail.Fail].ok{v}; }
    ret builder.emit_bitcast(?ctx.builder, v, dst);
}

fun lower_reinterpret(ctx: *lower_context.LowerContext, v: value.Value, from_ty: type.TypeId, dst: Type) res[value.Value, fail.Fail] {
    val res_src: res[Type, fail.Fail] = lower_context.lower_type(ctx, from_ty);
    if (sel res_src.err) { ret res[value.Value, fail.Fail].err{res_src.err}; }
    val src: Type = res_src.ok;

    val src_agg: bool = is_aggregate_ir(ctx, src);
    val dst_agg: bool = is_aggregate_ir(ctx, dst);
    if (src_agg == dst_agg) { ret emit_retype(ctx, v, dst); }

    if (src_agg) {
        val res_ptr: res[Type, fail.Fail] = irt.ptr(?ctx.m.types);
        if (sel res_ptr.err) { ret res[value.Value, fail.Fail].err{res_ptr.err}; }
        ret builder.emit_load(?ctx.builder, value.retype(v, res_ptr.ok), dst);
    }

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, dst);
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, v, slot);
    if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, dst)};
}

fun lower_strip(ctx: *lower_context.LowerContext, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val res_inner: res[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.strip.value);
    if (sel res_inner.err) { ret res_inner; }
    ret builder.emit_declassify(?ctx.builder, res_inner.ok);
}

fun lower_comptime_path(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[value.Value, fail.Fail] {
    val res_eval: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), eid, ?ctx.s.interner,
        lower_context.expr_float_width(ctx, eid));
    lower_context.record_eval_result(ctx, res_eval);
    if (sel res_eval.err) { ret res[value.Value, fail.Fail].err{fail.message(res_eval.err.message)}; }
    ret const_value_of(ctx, eid, res_eval.ok);
}

fun lower_array_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val arr_ty:     type.TypeId          = lower_context.expr_type_of(ctx, eid);
    val res_arr_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, arr_ty);
    if (sel res_arr_ir.err) { ret res[value.Value, fail.Fail].err{res_arr_ir.err}; }
    val arr_ir: Type = res_arr_ir.ok;
    val xty:    Type = builder.index_type(?ctx.builder);

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, arr_ir);
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    var i: u32 = 0;
    for (i < e.data.array_lit.elems_len) {
        val pool_ix: u32 = e.data.array_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_ids.len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: array literal element index out of range")};
        }
        val elem_eid: ast_id.ExprId               = ctx.scope.a.expr_ids.data[pool_ix];
        val res_elem: res[value.Value, fail.Fail] = lower_rvalue(ctx, elem_eid);
        if (sel res_elem.err) { ret res_elem; }

        val res_at: res[value.Value, fail.Fail] = builder.emit_element(?ctx.builder, slot, arr_ir, value.const_int(i::u64, xty));
        if (sel res_at.err) { ret res_at; }
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_elem.ok, res_at.ok);
        if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
        i = i + 1;
    }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, arr_ir)};
}

fun lower_vector_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val vec_ty:     type.TypeId          = lower_context.expr_type_of(ctx, eid);
    val res_vec_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, vec_ty);
    if (sel res_vec_ir.err) { ret res[value.Value, fail.Fail].err{res_vec_ir.err}; }
    val vec_ir: Type = res_vec_ir.ok;

    val n:     u32                                    = e.data.vector_lit.elems_len;
    var lanes: collections_vector.Vector[value.Value] = collections_vector.init[value.Value](ctx.s.alloc);
    fin { collections_vector.dnit[value.Value](?lanes); }
    var li: u32 = 0;
    for (li < n) {
        val lpool_ix: u32 = e.data.vector_lit.elems_start + li;
        if (lpool_ix::usize >= ctx.scope.a.expr_ids.len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: vector literal element index out of range")};
        }
        val lres: res[value.Value, fail.Fail] = lower_rvalue(ctx, ctx.scope.a.expr_ids.data[lpool_ix]);
        if (sel lres.err) { ret lres; }
        val pushed: res[usize, A.Error] = collections_vector.push[value.Value](?lanes, lres.ok);
        if (sel pushed.err) { ret res[value.Value, fail.Fail].err{fail.refused(pushed.err)}; }
        li = li + 1;
    }
    ret builder.emit_vec_build(?ctx.builder, vec_ir, lanes.data, n);
}

# `sel` loads the discriminator and compares it with the case code; it never reads a payload.
# a pointer place tests its pointee through the pointer value, like a member access does
fun lower_sel(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val place_eid: ast_id.ExprId = e.data.sel.place;
    # a constant element has no storage: the test is decided at compile time and materialized
    if (place_roots_in_const_elem(ctx, place_eid)) { ret lower_comptime_value(ctx, eid); }
    var tag_ty:   type.TypeId;
    val res_addr: res[value.Value, fail.Fail] = member_receiver(ctx, place_eid, ?tag_ty);
    if (sel res_addr.err) { ret res_addr; }

    val res_tag_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret res[value.Value, fail.Fail].err{res_tag_ir.err}; }
    val tag_ir:  Type = res_tag_ir.ok;
    val disc_ir: Type = disc_type(ctx, tag_ir);

    val res_dp: res[value.Value, fail.Fail] = disc_gep(ctx, res_addr.ok, tag_ir);
    if (sel res_dp.err) { ret res_dp; }
    val res_code: res[value.Value, fail.Fail] = builder.emit_load(?ctx.builder, res_dp.ok, disc_ir);
    if (sel res_code.err) { ret res_code; }

    var case_ix: u32 = 0;
    if (!ast_id.expr_is_nil(e.data.sel.case_desc)) {
        val res_ix: res[u32, fail.Fail] = case_descriptor_index(ctx, e.data.sel.case_desc);
        if (sel res_ix.err) { ret res[value.Value, fail.Fail].err{res_ix.err}; }
        case_ix = res_ix.ok;
    }
    or { case_ix = field_index_in_type(ctx, tag_ty, e.data.sel.case_name); }
    ret builder.emit_cmp_eq(?ctx.builder, res_code.ok, value.const_int(case_ix::u64, disc_ir));
}

# the case ordinal a comptime case descriptor names; type checking already tied it to this tag
fun case_descriptor_index(ctx: *lower_context.LowerContext, desc_eid: ast_id.ExprId) res[u32, fail.Fail] {
    val res_desc: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[lower_context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, lower_context.module_source(ctx), desc_eid, ?ctx.s.interner);
    lower_context.record_eval_result(ctx, res_desc);
    if (sel res_desc.err) { ret res[u32, fail.Fail].err{fail.message(res_desc.err.message)}; }
    val dv: comptime.CTValue = res_desc.ok;
    if (dv.kind != comptime.CT_KIND_CASE) {
        ret res[u32, fail.Fail].err{fail.message("lower: a bracketed case operand is not a comptime case descriptor")};
    }
    ret res[u32, fail.Fail].ok{dv.data.fld.index};
}

fun literal_head_case(ctx: *lower_context.LowerContext, tid: ast_id.TypeId) lang_source.Span {
    var absent: lang_source.Span;
    absent.offset = 0;
    absent.len    = 0;
    val t_r: res[ast_type.Type, fail.Fail] = lower_context.type_node(ctx, tid);
    if (sel t_r.err)                             { ret absent; }
    if (t_r.ok.kind != ast_type.TYPE_KIND_NAMED) { ret absent; }
    ret t_r.ok.data.named.case_name;
}

fun literal_head_case_desc(ctx: *lower_context.LowerContext, tid: ast_id.TypeId) ast_id.ExprId {
    val t_r: res[ast_type.Type, fail.Fail] = lower_context.type_node(ctx, tid);
    if (sel t_r.err)                             { ret ast_id.EXPR_NIL; }
    if (t_r.ok.kind != ast_type.TYPE_KIND_NAMED) { ret ast_id.EXPR_NIL; }
    ret t_r.ok.data.named.case_desc;
}

# the case a literal head selects, by name or through a descriptor; none when the head names a plain type
fun literal_head_case_index(ctx: *lower_context.LowerContext, tid: ast_id.TypeId, tag_ty: type.TypeId) res[opt[u32], fail.Fail] {
    val desc: ast_id.ExprId = literal_head_case_desc(ctx, tid);
    if (!ast_id.expr_is_nil(desc)) {
        val res_ix: res[u32, fail.Fail] = case_descriptor_index(ctx, desc);
        if (sel res_ix.err) { ret res[opt[u32], fail.Fail].err{res_ix.err}; }
        ret res[opt[u32], fail.Fail].ok{opt[u32].some{res_ix.ok}};
    }
    val case_span: lang_source.Span = literal_head_case(ctx, tid);
    if (case_span.len == 0) { ret res[opt[u32], fail.Fail].ok{opt[u32].none{}}; }
    ret res[opt[u32], fail.Fail].ok{opt[u32].some{field_index_in_type(ctx, tag_ty, case_span)}};
}

# a construction zeroes the whole object, writes the case code to the discriminant and stores
# the payload in its member of the payload union
fun lower_tag_case_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr,
    tag_ty: type.TypeId, case_ix: u32) res[value.Value, fail.Fail] {
    val res_tag_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, tag_ty);
    if (sel res_tag_ir.err) { ret res[value.Value, fail.Fail].err{res_tag_ir.err}; }
    val tag_ir:  Type = res_tag_ir.ok;
    val disc_ir: Type = disc_type(ctx, tag_ir);

    val res_slot: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, tag_ty, tag_ir);
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, tag_ir);
    if (sel res_mz.err) { ret res[value.Value, fail.Fail].err{res_mz.err}; }

    if (e.data.struct_lit.elems_len == 1) {
        val res_payload: res[value.Value, fail.Fail] = lower_rvalue(ctx, ctx.scope.a.expr_ids.data[e.data.struct_lit.elems_start]);
        if (sel res_payload.err) { ret res_payload; }
        val res_at: res[value.Value, fail.Fail] = field_gep(ctx, slot, tag_ty, case_ix);
        if (sel res_at.err) { ret res_at; }
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_payload.ok, res_at.ok);
        if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
    }

    val res_dp: res[value.Value, fail.Fail] = disc_gep(ctx, slot, tag_ir);
    if (sel res_dp.err) { ret res_dp; }
    val res_code: err[fail.Fail] = builder.emit_store(?ctx.builder, value.const_int(case_ix::u64, disc_ir), res_dp.ok);
    if (sel res_code.err) { ret res[value.Value, fail.Fail].err{res_code.err}; }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, tag_ir)};
}

fun lower_struct_lit(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, e: *ast_expr.Expr) res[value.Value, fail.Fail] {
    val rec_ty:   type.TypeId              = lower_context.expr_type_of(ctx, eid);
    val res_case: res[opt[u32], fail.Fail] = literal_head_case_index(ctx, e.data.struct_lit.ty, rec_ty);
    if (sel res_case.err) { ret res[value.Value, fail.Fail].err{res_case.err}; }
    val head: opt[u32] = res_case.ok;
    if (sel head.some) { ret lower_tag_case_lit(ctx, eid, e, rec_ty, head.some); }
    if (type.is_vector(?ctx.s.types, rec_ty)) {
        var vector: ast_expr.Expr = @e;
        vector.kind            = ast_expr.EXPR_KIND_VECTOR_LIT;
        vector.data.vector_lit = ast_expr.ExprVectorLit{ty: e.data.struct_lit.ty,
            elems_start: e.data.struct_lit.elems_start, elems_len: e.data.struct_lit.elems_len};
        ret lower_vector_lit(ctx, eid, ?vector);
    }
    val res_rec_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, rec_ty);
    if (sel res_rec_ir.err) { ret res[value.Value, fail.Fail].err{res_rec_ir.err}; }
    val rec_ir: Type = res_rec_ir.ok;

    val res_slot: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, rec_ty, rec_ir);
    if (sel res_slot.err) { ret res_slot; }
    val slot: value.Value = res_slot.ok;

    if (e.data.struct_lit.fields_len < type.field_count(?ctx.s.types, rec_ty)) {
        val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, rec_ir);
        if (sel res_mz.err) { ret res[value.Value, fail.Fail].err{res_mz.err}; }
    }

    var i: u32 = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_inits.len) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: struct literal field index out of range")};
        }
        val fi:        *ast_expr.FieldInit         = ?ctx.scope.a.field_inits.data[pool_ix];
        val field_ix:  u32                         = field_index_in_type(ctx, rec_ty, fi.name);
        val res_field: res[value.Value, fail.Fail] = lower_rvalue(ctx, fi.value);
        if (sel res_field.err) { ret res_field; }

        val res_at: res[value.Value, fail.Fail] = field_gep(ctx, slot, rec_ty, field_ix);
        if (sel res_at.err) { ret res_at; }
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, res_field.ok, res_at.ok);
        if (sel res_store.err) { ret res[value.Value, fail.Fail].err{res_store.err}; }
        i = i + 1;
    }

    ret res[value.Value, fail.Fail].ok{value.retype(slot, rec_ir)};
}

fun const_value_of(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: comptime.CTValue) res[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, true);
}

pub fun const_value_of_init(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: comptime.CTValue) res[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, false);
}

# a comptime scalar as a value of the expression's type; a string is the address of a global
# holding its bytes, which a global's initialiser names as a constant address
fun materialize_const_value(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, v: comptime.CTValue, expr_pos: bool) res[value.Value, fail.Fail] {
    val res_ir: res[Type, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (sel res_ir.err) { ret res[value.Value, fail.Fail].err{res_ir.err}; }
    val ty_id: Type = res_ir.ok;

    if (v.kind == comptime.CT_KIND_INT)   { ret res[value.Value, fail.Fail].ok{value.const_int_wide(v.data.w, ty_id)}; }
    if (v.kind == comptime.CT_KIND_FLOAT) { ret res[value.Value, fail.Fail].ok{float_constant(ctx, v.data.f, ty_id)}; }
    if (v.kind == comptime.CT_KIND_STR)   { ret constnode.string_global(ctx, v.data.s); }
    ret res[value.Value, fail.Fail].err{fail.message("lower: unsupported comptime value kind")};
}

fun snapshot_aggregate(ctx: *lower_context.LowerContext, source_value: value.Value, sem_ty: type.TypeId, vol: bool) res[value.Value, fail.Fail] {
    val allocated: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, sem_ty, source_value.ty);
    if (sel allocated.err) { ret allocated; }
    val slot:   value.Value    = allocated.ok;
    val copied: err[fail.Fail] = builder.emit_store_marked(?ctx.builder, source_value, slot, vol || type_is_volatile_record(ctx, sem_ty));
    if (sel copied.err) { ret res[value.Value, fail.Fail].err{copied.err}; }
    # the value owns its bytes before later expressions can mutate its source
    var result: value.Value = value.retype(slot, source_value.ty);
    result.secret = lower_context.type_carries_secret(ctx, sem_ty);
    ret res[value.Value, fail.Fail].ok{result};
}

# the value of `sem_ty` stored at `ptr`: a read of a secret is marked so, and its result
# is secret
fun rvalue_at(ctx: *lower_context.LowerContext, ptr: value.Value, ity: Type, sem_ty: type.TypeId, vol: bool) res[value.Value, fail.Fail] {
    if (is_aggregate_ir(ctx, ity)) {
        # a call argument nothing later can write is read in place: the call's own whole
        # read is then the only copy
        if (ctx.borrow_now && !vol && !type_is_volatile_record(ctx, sem_ty)) {
            ctx.borrow_now = false;
            ctx.borrow_hit = true;
            ret res[value.Value, fail.Fail].ok{value.retype(ptr, ity)};
        }
        ret snapshot_aggregate(ctx, value.retype(ptr, ity), sem_ty, vol);
    }
    builder.set_secret(?ctx.builder, lower_context.type_carries_secret(ctx, sem_ty));
    val res_: res[value.Value, fail.Fail] = builder.emit_load_marked(?ctx.builder, ptr, ity, vol);
    builder.set_secret(?ctx.builder, false);
    ret res_;
}

fun global_pointer(ctx: *lower_context.LowerContext, global_ix: u32) res[value.Value, fail.Fail] {
    ret res[value.Value, fail.Fail].ok{value.global(global_ix, builder.ptr_type(?ctx.builder))};
}

fun emit_global_rvalue(ctx: *lower_context.LowerContext, eid: ast_id.ExprId, global_ix: u32, vty: Type) res[value.Value, fail.Fail] {
    val res_gptr: res[value.Value, fail.Fail] = global_pointer(ctx, global_ix);
    if (sel res_gptr.err) { ret res_gptr; }
    val gptr: value.Value = res_gptr.ok;
    ret rvalue_at(ctx, gptr, vty, lower_context.expr_type_of(ctx, eid), access_is_volatile(ctx, eid));
}

fun fn_reference(ctx: *lower_context.LowerContext, link: intern.StrId, sig: lower_context.FnSig) res[value.Value, fail.Fail] {
    val res_xfn: res[u32, fail.Fail] = lower_context.ensure_extern_function(ctx, link, sig);
    if (sel res_xfn.err) { ret res[value.Value, fail.Fail].err{res_xfn.err}; }
    ret res[value.Value, fail.Fail].ok{value.fn(res_xfn.ok, builder.ptr_type(?ctx.builder), sig.sig)};
}

fun member_receiver(ctx: *lower_context.LowerContext, obj_eid: ast_id.ExprId, out_rec_ty: *type.TypeId) res[value.Value, fail.Fail] {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, lower_context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret res[value.Value, fail.Fail].err{fail.message("lower: receiver base has no pointer type")}; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type.TYPE_POINTER) {
            ret res[value.Value, fail.Fail].err{fail.message("lower: a member sema accepted reads through an untyped pointer")};
        }
        @out_rec_ty = type.strip_secret(?ctx.s.types, pt.data.pointer.base);
        ret lower_rvalue(ctx, obj_eid);
    }
    @out_rec_ty = obj_ty;
    ret lower_lvalue(ctx, obj_eid);
}

fun field_access_rec_ty(ctx: *lower_context.LowerContext, obj_eid: ast_id.ExprId) type.TypeId {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, lower_context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: opt[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (sel opt_pt.none) { ret type.TYPE_ERROR; }
        val pt: *type.Type = opt_pt.some;
        if (pt.kind != type.TYPE_POINTER) { ret type.TYPE_ERROR; }
        ret type.strip_secret(?ctx.s.types, pt.data.pointer.base);
    }
    ret obj_ty;
}

pub fun type_is_volatile_record(ctx: *lower_context.LowerContext, sem_ty: type.TypeId) bool {
    val t: type.TypeId = type.strip_secret(?ctx.s.types, sem_ty);
    if (type.is_nil(t) || type.is_error(t)) { ret false; }
    val nom: type.TypeId = type.aggregate_nominal(?ctx.s.types, t);
    if (type.is_error(nom)) { ret false; }
    ret type.decoration_of(?ctx.s.types, nom).volatile_;
}

# volatility is a property of the storage an access is rooted in. the chain of
# member, projection and index steps is walked to the object it reads or writes,
# and any volatile nominal along it, the node's own type included, marks the
# access; an indirection ends the chain at its pointee, so a pointer field of a
# volatile record reaches ordinary storage and a raw scalar pointer is never
# volatile. one predicate for every access form, load and store alike
fun access_is_volatile(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) bool {
    var cur: ast_id.ExprId = eid;
    for (!ast_id.expr_is_nil(cur)) {
        if (type_is_volatile_record(ctx, lower_context.expr_type_of(ctx, cur))) { ret true; }
        val opt_e: res[ast_expr.Expr, fail.Fail] = lower_context.expression(ctx, cur);
        if (sel opt_e.err) { ret false; }
        var e_value: ast_expr.Expr  = opt_e.ok;
        val e:       *ast_expr.Expr = ?e_value;
        var obj:     ast_id.ExprId  = ast_id.EXPR_NIL;
        if (e.kind == ast_expr.EXPR_KIND_MEMBER)  { obj = e.data.member.object; }
        or (e.kind == ast_expr.EXPR_KIND_PROJECT) { obj = e.data.project.object; }
        or (e.kind == ast_expr.EXPR_KIND_INDEX)   { obj = e.data.index.object; }
        or (e.kind == ast_expr.EXPR_KIND_UNARY && e.data.unary.op == ast_expr.UN_DEREF) {
            ret type_is_volatile_record(ctx, field_access_rec_ty(ctx, e.data.unary.operand));
        }
        or { ret false; }
        if (is_pointer_type(ctx, type.strip_secret(?ctx.s.types, lower_context.expr_type_of(ctx, obj)))) {
            ret type_is_volatile_record(ctx, field_access_rec_ty(ctx, obj));
        }
        cur = obj;
    }
    ret false;
}

# the address of member `field_ix` of the record, union or tag `rec_ty` at `base`: a tag's
# case is its member of the payload union
fun field_gep(ctx: *lower_context.LowerContext, base: value.Value, rec_ty: type.TypeId, field_ix: u32) res[value.Value, fail.Fail] {
    val res_rec_ir: res[Type, fail.Fail] = lower_context.lower_type(ctx, rec_ty);
    if (sel res_rec_ir.err) { ret res[value.Value, fail.Fail].err{res_rec_ir.err}; }
    val rec_ir: Type = res_rec_ir.ok;
    if (!type.is_tag(?ctx.s.types, type.strip_secret(?ctx.s.types, lower_context.substitute_type(ctx, rec_ty)))) {
        ret builder.emit_member(?ctx.builder, base, rec_ir, field_ix);
    }
    val payloads: res[value.Value, fail.Fail] = builder.emit_member(?ctx.builder, base, rec_ir, lower_context.TAG_PAYLOAD);
    if (sel payloads.err) { ret payloads; }
    val union_ir: Type = irt.member(?ctx.m.types, rec_ir, lower_context.TAG_PAYLOAD);
    ret builder.emit_member(?ctx.builder, payloads.ok, union_ir, lower_context.tag_payload_member(ctx, rec_ty, field_ix));
}

fun ir_type_of_expr(ctx: *lower_context.LowerContext, eid: ast_id.ExprId) res[Type, fail.Fail] {
    ret lower_context.lower_type(ctx, lower_context.expr_type_of(ctx, eid));
}

fun widen_index(ctx: *lower_context.LowerContext, v: value.Value, sem_ty: type.TypeId) res[value.Value, fail.Fail] {
    val xty: Type = builder.index_type(?ctx.builder);
    if (scalar_bits(ctx, sem_ty) >= irt.int_width(?ctx.m.types, xty)) { ret res[value.Value, fail.Fail].ok{v}; }
    if (is_signed_type(ctx, sem_ty))                                  { ret builder.emit_sext(?ctx.builder, v, xty); }
    ret builder.emit_zext(?ctx.builder, v, xty);
}

fun repr_kind(ctx: *lower_context.LowerContext, tid: type.TypeId) opt[type.TypeKind] {
    val base:  type.TypeId     = type.strip_secret(?ctx.s.types, tid);
    val opt_t: opt[*type.Type] = type.get(?ctx.s.types, base);
    if (sel opt_t.none) { ret opt[type.TypeKind].none{}; }
    ret opt[type.TypeKind].some{opt_t.some.kind};
}

fun scalar_bits(ctx: *lower_context.LowerContext, tid: type.TypeId) u32 {
    val ok: opt[type.TypeKind] = repr_kind(ctx, tid);
    if (sel ok.none) { ret 0; }
    val k: type.TypeKind = ok.some;
    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) { ret d.bits; }
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER || k == type.TYPE_FUN) { ret ctx.tgt.pointer_width * 8; }
    ret 0;
}

fun is_signed_type(ctx: *lower_context.LowerContext, tid: type.TypeId) bool {
    val ok: opt[type.TypeKind] = repr_kind(ctx, tid);
    if (sel ok.none) { ret false; }
    ret type.prim_desc(ok.some).signed;
}

fun is_float_type(ctx: *lower_context.LowerContext, tid: type.TypeId) bool {
    val ok: opt[type.TypeKind] = repr_kind(ctx, tid);
    if (sel ok.none) { ret false; }
    ret type.prim_desc(ok.some).class == type.PRIM_CLASS_FLOAT;
}

fun is_array_type(ctx: *lower_context.LowerContext, tid: type.TypeId) bool {
    val opt_t: opt[*type.Type] = type.get(?ctx.s.types, type.strip_secret(?ctx.s.types, tid));
    if (sel opt_t.none) { ret false; }
    ret opt_t.some.kind == type.TYPE_ARRAY;
}

fun is_pointer_type(ctx: *lower_context.LowerContext, tid: type.TypeId) bool {
    val opt_t: opt[*type.Type] = type.get(?ctx.s.types, tid);
    if (sel opt_t.none) { ret false; }
    val k: type.TypeKind = opt_t.some.kind;
    ret k == type.TYPE_PTR || k == type.TYPE_POINTER;
}

fun is_aggregate_ir(ctx: *lower_context.LowerContext, ity: Type) bool {
    ret irt.is_aggregate(?ctx.m.types, ity);
}

# the index of the member `name` names in `rec_ty`; a name sema bound that names no member, or
# one that cannot be interned, records an internal failure and answers 0
fun field_index_in_type(ctx: *lower_context.LowerContext, rec_ty: type.TypeId, name: lang_source.Span) u32 {
    val src_text: str                        = lower_context.module_source(ctx);
    val res_want: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, src_text, name.offset, name.len);
    if (sel res_want.err) {
        fail.internal(?ctx.status, fail.describe(fail.refused(res_want.err)));
        ret 0;
    }
    val want: intern.StrId = res_want.ok;

    val fields_len: u32 = type.field_count(?ctx.s.types, rec_ty);
    var i:          u32 = 0;
    for (i < fields_len) {
        val opt_fe: opt[*type.FieldEntry] = type.field_at(?ctx.s.types, rec_ty, i);
        if (sel opt_fe.some) {
            if (intern.str_same(opt_fe.some.name, want)) { ret i; }
        }
        i = i + 1;
    }

    fail.internal(?ctx.status, "lower: a member name sema bound names no member of its type");
    ret 0;
}

fun find_global(ctx: *lower_context.LowerContext, name: intern.StrId) opt[u32] {
    ret lower_context.global_named(ctx, name);
}

#[testing]
rec StructLitProbe {
    a: u32;
    b: u32;
    c: u32;
    d: u32;
}

#[testing]
rec StructLitProbeInner {
    x: u32;
    y: u32;
}

#[testing]
rec StructLitProbeOuter {
    tag:   u32;
    inner: StructLitProbeInner;
    arr:   [3]u32;
}

#[testing]
val struct_lit_probe_ct_arr: [1]StructLitProbe = [1]StructLitProbe{StructLitProbe{a: 5}};

#[noinline]
#[testing]
fun struct_lit_probe_outer_partial() StructLitProbeOuter {
    ret StructLitProbeOuter{tag: 3};
}

#[testing]
fun struct_lit_probe_outer_nested_partial() StructLitProbeOuter {
    ret StructLitProbeOuter{tag: 9, inner: StructLitProbeInner{x: 5}, arr: [3]u32{1, 2, 3}};
}

#[testing]
fun struct_lit_probe_runtime_y() u32 {
    val r: StructLitProbe = StructLitProbe{a: 5};
    ret r.b;
}

test struct_lit__partial_literal_zeroes_nested_aggregate_region {
    var bad: i32                 = 0;
    val o:   StructLitProbeOuter = struct_lit_probe_outer_partial();
    if (o.tag != 3)     { bad = bad + 1; }
    if (o.inner.x != 0) { bad = bad + 2; }
    if (o.inner.y != 0) { bad = bad + 4; }
    if (o.arr[0] != 0)  { bad = bad + 8; }
    if (o.arr[1] != 0)  { bad = bad + 16; }
    if (o.arr[2] != 0)  { bad = bad + 32; }
    ret bad;
}

test struct_lit__partial_literal_nested_inside_full_literal {
    var bad: i32                 = 0;
    val o:   StructLitProbeOuter = struct_lit_probe_outer_nested_partial();
    if (o.tag != 9)     { bad = bad + 1; }
    if (o.inner.x != 5) { bad = bad + 2; }
    if (o.inner.y != 0) { bad = bad + 4; }
    if (o.arr[0] != 1)  { bad = bad + 8; }
    if (o.arr[1] != 2)  { bad = bad + 16; }
    if (o.arr[2] != 3)  { bad = bad + 32; }
    ret bad;
}

test struct_lit__comptime_and_runtime_agree_on_omitted_field {
    var bad: i32 = 0;
    $each item in struct_lit_probe_ct_arr {
        $if (item.b == 0) {
            if (struct_lit_probe_runtime_y() != 0) { bad = bad + 1; }
        }
        $or {
            bad = bad + 2;
        }
    }
    ret bad;
}

#[testing]
rec StructLitOmitInner {
    x: u32;
    y: u64;
}

#[testing]
rec StructLitOmitProbe {
    tag:    u64;
    count:  u64;
    ptr:    *u8;
    inner:  StructLitOmitInner;
    key:    ^u64;
    secret: ^[8]u8;
    welded: *^u8;
}

#[testing]
val struct_lit_omit_static: StructLitOmitProbe = StructLitOmitProbe{tag: 7};

#[noinline]
#[testing]
fun struct_lit_omit_dirty(round: u64) u64 {
    var junk: [64]u64;
    var i:    u32 = 0;
    for (i < 64) {
        junk[i] = 0xAAAAAAAAAAAAAAAA ^ (round & 1);
        i       = i + 1;
    }
    ret junk[(round & 63)::u32];
}

#[noinline]
#[testing]
fun struct_lit_omit_runtime(tag: u64) StructLitOmitProbe {
    ret StructLitOmitProbe{tag: tag};
}

#[noinline]
#[testing]
fun struct_lit_omit_constant() StructLitOmitProbe {
    ret StructLitOmitProbe{tag: 7};
}

# a bitmask below 64 of the omitted fields that are not zero, plus 1 when the named tag is wrong
#[testing]
fun struct_lit_omit_residue(r: *StructLitOmitProbe, tag: u64) i32 {
    var bad: i32 = 0;
    if (r.tag != tag)    { bad = bad | 1; }
    if (r.count != 0)    { bad = bad | 2; }
    if (r.ptr != nil)    { bad = bad | 4; }
    if (r.inner.x != 0)  { bad = bad | 8; }
    if (r.inner.y != 0)  { bad = bad | 8; }
    if (r.key:>u64 != 0) { bad = bad | 16; }
    if (r.welded != nil) { bad = bad | 32; }
    val secret: [8]u8 = r.secret:>[8]u8;
    var i:      u32   = 0;
    for (i < 8) {
        if (secret[i] != 0) { bad = bad | 16; }
        i = i + 1;
    }
    ret bad;
}

test struct_lit__omitted_fields_zero_including_welded_over_dirty_stack {
    var round: u64 = 0;
    # both parities of the dirt pattern
    for (round < 2) {
        if ((struct_lit_omit_dirty(round) & 0xFFFFFFFFFFFFFFFE) != 0xAAAAAAAAAAAAAAAA) { ret 255; }
        var runtime:     StructLitOmitProbe = struct_lit_omit_runtime(round + 1);
        val bad_runtime: i32                = struct_lit_omit_residue(?runtime, round + 1);
        if (bad_runtime != 0) { ret bad_runtime; }

        if ((struct_lit_omit_dirty(round) & 0xFFFFFFFFFFFFFFFE) != 0xAAAAAAAAAAAAAAAA) { ret 255; }
        var constant:     StructLitOmitProbe = struct_lit_omit_constant();
        val bad_constant: i32                = struct_lit_omit_residue(?constant, 7);
        if (bad_constant != 0) { ret 64 + bad_constant; }

        if ((struct_lit_omit_dirty(round) & 0xFFFFFFFFFFFFFFFE) != 0xAAAAAAAAAAAAAAAA) { ret 255; }
        var global:     StructLitOmitProbe = struct_lit_omit_static;
        val bad_global: i32                = struct_lit_omit_residue(?global, 7);
        if (bad_global != 0) { ret 128 + bad_global; }
        round = round + 1;
    }
    ret 0;
}

#[testing]
uni StructLitProbeUnion {
    small: u8;
    big:   u64;
}

#[testing]
val struct_lit_probe_union_static: StructLitProbeUnion = StructLitProbeUnion{small: 1};

#[noinline]
#[testing]
fun struct_lit_probe_union_dirty() u64 {
    var junk: [16]u64;
    var i:    u32 = 0;
    for (i < 16) {
        junk[i] = 0xAAAAAAAAAAAAAAAA;
        i       = i + 1;
    }
    ret junk[0];
}

#[noinline]
#[testing]
fun struct_lit_probe_union_partial() StructLitProbeUnion {
    ret StructLitProbeUnion{small: 1};
}

test struct_lit__partial_union_literal_zeroes_tail_bytes_over_dirty_stack {
    var bad: i32 = 0;

    val dirty_check: u64 = struct_lit_probe_union_dirty();
    if (dirty_check != 0xAAAAAAAAAAAAAAAA) { bad = bad + 1; }

    val u: StructLitProbeUnion = struct_lit_probe_union_partial();
    if (u.small != 1)                                  { bad = bad + 2; }
    if ((u.big >> 8) != 0)                             { bad = bad + 4; }
    if ((struct_lit_probe_union_static.big >> 8) != 0) { bad = bad + 8; }

    ret bad;
}

#[testing]
val convert_const_probe_u64:        u64 = 18446744073709551615;
#[testing]
val convert_const_probe_u64_as_f64: f64 = convert_const_probe_u64::f64;

#[testing]
fun convert_const_probe_u64_to_f64_runtime(x: u64) f64 {
    ret x::f64;
}

#[testing]
val convert_const_probe_f64_high:   f64 = 9223372036854775808.0;
#[testing]
val convert_const_probe_f64_as_u64: u64 = convert_const_probe_f64_high::u64;

#[testing]
fun convert_const_probe_f64_to_u64_runtime(x: f64) u64 {
    ret x::u64;
}

test convert_const_scalar__unsigned_conversions_agree_with_runtime {
    var bad: i32 = 0;

    if (convert_const_probe_u64_as_f64 != convert_const_probe_u64_to_f64_runtime(convert_const_probe_u64)) { bad = bad + 1; }
    if (convert_const_probe_u64_as_f64 <= 0.0)                                                             { bad = bad + 2; }

    if (convert_const_probe_f64_as_u64 != convert_const_probe_f64_to_u64_runtime(convert_const_probe_f64_high)) { bad = bad + 4; }
    if (convert_const_probe_f64_as_u64 != 9223372036854775808)                                                  { bad = bad + 8; }

    ret bad;
}

#[testing]
fun t_pointer_float(value: ptr) f64 {
    ret value::f64;
}

#[testing]
fun t_float_pointer(value: f64) ptr {
    ret value::ptr;
}

test convert_const_scalar__nonnumeric_casts_preserve_bits {
    val bits: u64 = 0x3FF0000000000000;
    if (t_pointer_float(bits::ptr) != 1.0) { ret 1; }
    if (t_float_pointer(1.0)::u64 != bits) { ret 2; }
    ret 0;
}

#[testing]
val reinterpret_probe_f64:      f64 = 5.0;
#[testing]
val reinterpret_probe_f64_bits: u64 = reinterpret_probe_f64:~u64;

#[testing]
fun reinterpret_probe_f64_runtime(f: f64) u64 {
    ret f:~u64;
}

#[testing]
val reinterpret_probe_f32:      f32 = 5.0;
#[testing]
val reinterpret_probe_f32_bits: u32 = reinterpret_probe_f32:~u32;

#[testing]
fun reinterpret_probe_f32_runtime(f: f32) u32 {
    ret f:~u32;
}

test convert_const_scalar__reinterpret_agrees_with_runtime {
    var bad: i32 = 0;

    if (reinterpret_probe_f64_bits != reinterpret_probe_f64_runtime(reinterpret_probe_f64)) { bad = bad + 1; }
    if (reinterpret_probe_f64_bits != 0x4014000000000000)                                   { bad = bad + 2; }

    if (reinterpret_probe_f32_bits != reinterpret_probe_f32_runtime(reinterpret_probe_f32)) { bad = bad + 4; }
    if (reinterpret_probe_f32_bits != 0x40A00000)                                           { bad = bad + 8; }

    ret bad;
}

#[testing]
val lit_str_probe_const: *u8 = "ab\0foo\0x"::*u8;

# a string literal is every byte it spells, embedded NULs included, then a NUL
test lit_str__keeps_every_byte_after_an_embedded_nul {
    val want:    [9]u8 = [9]u8{97, 98, 0, 102, 111, 111, 0, 120, 0};
    val runtime: *u8   = "ab\0foo\0x"::*u8;
    var bad:     i32   = 0;
    var i:       usize = 0;
    for (i < 9) {
        if (runtime[i] != want[i])             { bad = bad | 1; }
        if (lit_str_probe_const[i] != want[i]) { bad = bad | 2; }
        i = i + 1;
    }
    ret bad;
}
