use mach.lang.type;

pub fun lower_rvalue(ctx: *context.LowerContext, eid: id.ExprId) R.Result[value.Value, fail.Fail] {
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*expr.Expr](opt_e)) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: expression id out of range"));
    }
    val e: *expr.Expr    = O.unwrap[*expr.Expr](opt_e);

    val saved_loc: source.SrcLoc = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, e.span.offset));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val res: R.Result[value.Value, fail.Fail] = lower_rvalue_kind(ctx, eid, e);
    if (R.is_err[value.Value, fail.Fail](res)) { ret res; }
    ret R.ok[value.Value, fail.Fail](stamp_secret(ctx, eid, R.unwrap_ok[value.Value, fail.Fail](res)));
}

fun lower_rvalue_kind(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val k: expr.ExprKind = e.kind;

    if (k == expr.EXPR_KIND_LIT_INT)        { ret lower_lit_int(ctx, eid, e); }
    if (k == expr.EXPR_KIND_LIT_FLOAT)      { ret lower_lit_float(ctx, eid, e); }
    if (k == expr.EXPR_KIND_LIT_CHAR)       { ret lower_lit_char(ctx, eid, e); }
    if (k == expr.EXPR_KIND_LIT_STR)        { ret lower_lit_str(ctx, e); }
    if (k == expr.EXPR_KIND_LIT_NIL)        { ret lower_lit_nil(ctx, eid); }
    if (k == expr.EXPR_KIND_IDENT)          { ret lower_ident_rvalue(ctx, eid); }
    if (k == expr.EXPR_KIND_MEMBER)         { ret lower_member_rvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_PROJECT)        { ret lower_project_rvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_INDEX)          { ret lower_index_rvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_GENERIC_INSTANCE) { ret lower_generic_instance(ctx, eid, e); }
    if (k == expr.EXPR_KIND_CALL)           { ret lower_call(ctx, eid, e); }
    if (k == expr.EXPR_KIND_BINARY)         { ret lower_binary(ctx, eid, e); }
    if (k == expr.EXPR_KIND_UNARY)          { ret lower_unary(ctx, eid, e); }
    if (k == expr.EXPR_KIND_CAST)           { ret lower_cast(ctx, eid, e); }
    if (k == expr.EXPR_KIND_STRIP)          { ret lower_strip(ctx, e); }
    if (k == expr.EXPR_KIND_COMPTIME_IDENT) { ret lower_comptime_path(ctx, eid); }
    if (k == expr.EXPR_KIND_ARRAY_LIT)      { ret lower_array_lit(ctx, eid, e); }
    if (k == expr.EXPR_KIND_STRUCT_LIT)     { ret lower_struct_lit(ctx, eid, e); }
    if (k == expr.EXPR_KIND_VECTOR_LIT)     { ret lower_vector_lit(ctx, eid, e); }

    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported expression kind in rvalue position"));
}

fun stamp_secret(ctx: *context.LowerContext, eid: id.ExprId, v: value.Value) value.Value {
    var sec: bool = context.expr_is_secret(ctx, eid);
    if (!sec) { sec = compare_operand_secret(ctx, eid); }
    var out: value.Value = v;
    out.secret = sec;
    if (sec) {
        val fn: *ir.Function = ctx.builder.fn;
        instruction.mark_result_secret(fn.instrs, fn.instr_len, v);
    }
    ret out;
}

fun compare_operand_secret(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (e.kind != expr.EXPR_KIND_BINARY)     { ret false; }
    if (!is_compare_binop(e.data.binary.op)) { ret false; }
    ret context.expr_is_secret(ctx, e.data.binary.lhs) || context.expr_is_secret(ctx, e.data.binary.rhs);
}

pub fun lower_lvalue(ctx: *context.LowerContext, eid: id.ExprId) R.Result[value.Value, fail.Fail] {
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*expr.Expr](opt_e)) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: lvalue id out of range"));
    }
    val e: *expr.Expr    = O.unwrap[*expr.Expr](opt_e);

    val saved_loc: source.SrcLoc = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, e.span.offset));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val k: expr.ExprKind = ast.expr_place_kind(e);

    if (k == expr.EXPR_KIND_IDENT)   { ret lower_ident_lvalue(ctx, eid); }
    if (k == expr.EXPR_KIND_MEMBER)  { ret lower_member_lvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_PROJECT) { ret lower_project_lvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_INDEX)   { ret lower_index_lvalue(ctx, eid, e); }
    if (k == expr.EXPR_KIND_UNARY) { ret lower_rvalue(ctx, e.data.unary.operand); }

    if (k == expr.EXPR_KIND_CALL) {
        val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
        if (is_aggregate_ir(ctx, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir))) {
            ret lower_rvalue(ctx, eid);
        }
    }

    ret R.err[value.Value, fail.Fail](fail.message("lower: expression is not an lvalue"));
}

fun lower_lit_int(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret R.ok[value.Value, fail.Fail](value.const_int(e.data.lit_int.value, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir)));
}

fun lower_lit_float(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret R.ok[value.Value, fail.Fail](value.const_float(e.data.lit_float.value, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir)));
}

fun lower_lit_char(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret R.ok[value.Value, fail.Fail](value.const_int(e.data.lit_char::u64, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir)));
}

pub fun lower_lit_str(ctx: *context.LowerContext, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_ptr: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?ctx.m.types);
    if (R.is_err[ir_type.IrTypeId, str](res_ptr)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_ptr))); }
    val pty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_ptr);

    val txt: str = context.module_source(ctx);
    var inner: View = view(nil, 0);
    if (e.span.len >= 2::usize) {
        inner = view(?txt[e.span.offset + 1::usize], e.span.len - 2::usize);
    }

    val res_sid: R.Result[intern.StrId, fail.Fail] = intern_str_lit(ctx, inner);
    if (R.is_err[intern.StrId, fail.Fail](res_sid)) {
        diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, e.span, R.unwrap_err[intern.StrId, fail.Fail](res_sid).message);
        ret R.err[value.Value, fail.Fail](fail.reported());
    }
    val opt_bytes: O.Option[str] = intern.lookup(?ctx.s.interner, R.unwrap_ok[intern.StrId, fail.Fail](res_sid));
    if (O.is_none[str](opt_bytes)) { ret R.err[value.Value, fail.Fail](fail.message("lower: string literal lookup failed")); }
    val bytes: str = O.unwrap[str](opt_bytes);

    val blob: value.Value = value.const_bytes(bytes::*u8, (str_len(bytes) + 1::usize)::u32, pty);
    ret context.add_rodata_bytes(ctx, blob, pty);
}

fun intern_str_lit(ctx: *context.LowerContext, inner: View) R.Result[intern.StrId, fail.Fail] {
    if (inner.len == 0 || !lit_has_escape(inner)) {
        ret fail.lift[intern.StrId](intern.intern_bytes(?ctx.s.interner, inner.data::str, inner.len));
    }

    val res_buf: R.Result[*u8, str] = A.allocate[u8](ctx.s.alloc, inner.len);
    if (R.is_err[*u8, str](res_buf)) { ret R.err[intern.StrId, fail.Fail](fail.message(R.unwrap_err[*u8, str](res_buf))); }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var read:  usize = 0;
    var write: usize = 0;
    for (read < inner.len) {
        val c: u8 = inner.data[read];
        if (c != '\\') {
            buf[write] = c;
            read  = read + 1;
            write = write + 1;
            cnt;
        }
        var consumed: usize = 0;
        val res_esc: R.Result[u8, fail.Fail] = lit_decode_escape((?inner.data[read])::*u8, inner.len - read, ?consumed);
        if (R.is_err[u8, fail.Fail](res_esc)) {
            A.deallocate[u8](ctx.s.alloc, buf, inner.len);
            ret R.err[intern.StrId, fail.Fail](R.unwrap_err[u8, fail.Fail](res_esc));
        }
        buf[write] = R.unwrap_ok[u8, fail.Fail](res_esc);
        read  = read + consumed;
        write = write + 1;
    }

    val res_id: R.Result[intern.StrId, str] = intern.intern_bytes(?ctx.s.interner, buf::str, write);
    A.deallocate[u8](ctx.s.alloc, buf, inner.len);
    ret fail.lift[intern.StrId](res_id);
}

fun lit_has_escape(s: View) bool {
    var i: usize = 0;
    for (i < s.len) {
        if (s.data[i] == '\\') { ret true; }
        i = i + 1;
    }
    ret false;
}

fun lit_decode_escape(p: *u8, len: usize, out_consumed: *usize) R.Result[u8, fail.Fail] {
    if (len < 2) { ret R.err[u8, fail.Fail](fail.message("lower: incomplete escape sequence in string literal")); }
    val c: u8 = p[1];

    if (c == 'n')  { @out_consumed = 2; ret R.ok[u8, fail.Fail](10); }
    if (c == 't')  { @out_consumed = 2; ret R.ok[u8, fail.Fail](9); }
    if (c == 'r')  { @out_consumed = 2; ret R.ok[u8, fail.Fail](13); }
    if (c == '\\') { @out_consumed = 2; ret R.ok[u8, fail.Fail](92); }
    if (c == '\'') { @out_consumed = 2; ret R.ok[u8, fail.Fail](39); }
    if (c == '"')  { @out_consumed = 2; ret R.ok[u8, fail.Fail](34); }
    if (c == '0')  { @out_consumed = 2; ret R.ok[u8, fail.Fail](0); }
    if (c == 'x') {
        if (len < 4) { ret R.err[u8, fail.Fail](fail.message("lower: incomplete \\x escape in string literal")); }
        val hi: i64 = lit_hex_digit(p[2]);
        val lo: i64 = lit_hex_digit(p[3]);
        if (hi < 0 || lo < 0) { ret R.err[u8, fail.Fail](fail.message("lower: invalid \\x escape in string literal")); }
        @out_consumed = 4;
        ret R.ok[u8, fail.Fail]((hi * 16 + lo)::u8);
    }
    ret R.err[u8, fail.Fail](fail.message("lower: unknown escape sequence in string literal"));
}

fun lit_hex_digit(c: u8) i64 {
    if (c >= '0' && c <= '9') { ret (c - '0')::i64; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::i64 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::i64 + 10; }
    ret -1;
}

fun lower_lit_nil(ctx: *context.LowerContext, eid: id.ExprId) R.Result[value.Value, fail.Fail] {
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret R.ok[value.Value, fail.Fail](value.const_null(R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir)));
}

fun lower_ident_rvalue(ctx: *context.LowerContext, eid: id.ExprId) R.Result[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);

    val opt_cv: O.Option[comptime.CTValue] = comptime_param_value(ctx, sid);
    if (O.is_some[comptime.CTValue](opt_cv)) {
        ret const_value_of(ctx, eid, O.unwrap[comptime.CTValue](opt_cv));
    }

    val opt_ord: O.Option[u32] = pack_elem_ordinal(ctx, sid);
    if (O.is_some[u32](opt_ord)) {
        ret load_pack_elem(ctx, eid, O.unwrap[u32](opt_ord));
    }

    val opt_elem: O.Option[id.ExprId] = const_elem_expr(ctx, sid);
    if (O.is_some[id.ExprId](opt_elem)) {
        ret lower_rvalue(ctx, O.unwrap[id.ExprId](opt_elem));
    }

    val opt_direct: O.Option[comptime.CTValue] = comptime_each_direct_value(ctx, sid);
    if (O.is_some[comptime.CTValue](opt_direct)) {
        ret const_value_of(ctx, eid, O.unwrap[comptime.CTValue](opt_direct));
    }

    val opt_local: O.Option[value.Value] = context.lookup_local(ctx, sid);
    if (O.is_some[value.Value](opt_local)) {
        val slot: value.Value = O.unwrap[value.Value](opt_local);
        if (slot.kind == value.VAL_PARAM) {
            ret R.ok[value.Value, fail.Fail](slot);
        }
        val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
        ret rvalue_at(ctx, slot, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir), false);
    }
    ret symbol_reference(ctx, eid, sid);
}

fun pack_elem_ordinal(ctx: *context.LowerContext, sid: resolve.SymbolId) O.Option[u32] {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret O.none[u32](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret O.none[u32](); }
    if (sym.decl != id.DECL_NIL)                                                     { ret O.none[u32](); }
    val opt_nc: O.Option[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (O.is_none[comptime.NamedConst](opt_nc)) { ret O.none[u32](); }
    val cval: comptime.CTValue = O.unwrap[comptime.NamedConst](opt_nc).value;
    if (cval.kind != comptime.CT_KIND_PACK_ELEM) { ret O.none[u32](); }
    ret O.some[u32](cval.data.pelem.index);
}

fun const_elem_expr(ctx: *context.LowerContext, sid: resolve.SymbolId) O.Option[id.ExprId] {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret O.none[id.ExprId](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret O.none[id.ExprId](); }
    if (sym.decl != id.DECL_NIL)                                                     { ret O.none[id.ExprId](); }
    val opt_nc: O.Option[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (O.is_none[comptime.NamedConst](opt_nc)) { ret O.none[id.ExprId](); }
    val cval: comptime.CTValue = O.unwrap[comptime.NamedConst](opt_nc).value;
    if (cval.kind != comptime.CT_KIND_CONST_ELEM) { ret O.none[id.ExprId](); }
    ret O.some[id.ExprId](cval.data.celem.elem::id.ExprId);
}

fun comptime_each_direct_value(ctx: *context.LowerContext, sid: resolve.SymbolId) O.Option[comptime.CTValue] {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret O.none[comptime.CTValue](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.kind != resolve.SYM_VAL || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) { ret O.none[comptime.CTValue](); }
    if (sym.decl != id.DECL_NIL)                                                     { ret O.none[comptime.CTValue](); }
    val opt_nc: O.Option[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (O.is_none[comptime.NamedConst](opt_nc)) { ret O.none[comptime.CTValue](); }
    val cval: comptime.CTValue = O.unwrap[comptime.NamedConst](opt_nc).value;
    if (cval.kind == comptime.CT_KIND_CONST_ELEM) { ret O.none[comptime.CTValue](); }
    if (cval.kind == comptime.CT_KIND_PACK_ELEM)  { ret O.none[comptime.CTValue](); }
    ret O.some[comptime.CTValue](cval);
}

fun const_elem_field_expr(ctx: *context.LowerContext, elem_eid: id.ExprId, member_span: token.Span) id.ExprId {
    val el_opt: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, elem_eid);
    if (O.is_none[*expr.Expr](el_opt)) { ret id.EXPR_NIL; }
    val el: *expr.Expr = O.unwrap[*expr.Expr](el_opt);
    if (el.kind != expr.EXPR_KIND_STRUCT_LIT) { ret id.EXPR_NIL; }

    val src: str = context.module_source(ctx);
    val mname_r: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, src, member_span);
    if (R.is_err[intern.StrId, str](mname_r)) { ret id.EXPR_NIL; }
    val mname: intern.StrId = R.unwrap_ok[intern.StrId, str](mname_r);

    var i: u32 = 0;
    for (i < el.data.struct_lit.fields_len) {
        val pool_ix: usize = (el.data.struct_lit.fields_start + i)::usize;
        if (pool_ix >= ctx.scope.a.field_init_len) { ret id.EXPR_NIL; }
        val fi: *expr.FieldInit = ?ctx.scope.a.field_inits[pool_ix];
        val fname_r: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, src, fi.name);
        if (R.is_err[intern.StrId, str](fname_r)) { ret id.EXPR_NIL; }
        if (R.unwrap_ok[intern.StrId, str](fname_r) == mname) { ret fi.value; }
        i = i + 1;
    }
    ret id.EXPR_NIL;
}

fun load_pack_elem(ctx: *context.LowerContext, eid: id.ExprId, ord: u32) R.Result[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: pack element ordinal out of range"));
    }
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret rvalue_at(ctx, ctx.pack_slots[ord], R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir), false);
}

fun is_spread_expr(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*expr.Expr](opt_e)) { ret false; }
    ret O.unwrap[*expr.Expr](opt_e).kind == expr.EXPR_KIND_SPREAD;
}

fun call_has_spread(ctx: *context.LowerContext, e: *expr.Expr) bool {
    var i: u32 = 0;
    for (i < e.data.call.args_len) {
        val pool_ix: u32 = e.data.call.args_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len)          { ret false; }
        if (is_spread_expr(ctx, ctx.scope.a.expr_ids[pool_ix])) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun load_pack_slot(ctx: *context.LowerContext, slot_ix: u32) R.Result[value.Value, fail.Fail] {
    if (ctx.pack_slots == nil || slot_ix >= ctx.pack_len) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: pack slot index out of range"));
    }
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, ctx.pack_types[slot_ix]);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret rvalue_at(ctx, ctx.pack_slots[slot_ix], R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir), false);
}

fun comptime_param_value(ctx: *context.LowerContext, sid: resolve.SymbolId) O.Option[comptime.CTValue] {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret O.none[comptime.CTValue](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.kind != resolve.SYM_PARAM || (sym.flags & resolve.SYM_FLAG_COMPTIME) == 0) {
        ret O.none[comptime.CTValue]();
    }
    val opt_nc: O.Option[comptime.NamedConst] = comptime.lookup(ctx.scope.ctx, sym.name);
    if (O.is_none[comptime.NamedConst](opt_nc)) { ret O.none[comptime.CTValue](); }
    ret O.some[comptime.CTValue](O.unwrap[comptime.NamedConst](opt_nc).value);
}

fun reference_linkage_name(ctx: *context.LowerContext, sym: *resolve.Symbol) R.Result[intern.StrId, fail.Fail] {
    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    var export: O.Option[intern.StrId] = O.none[intern.StrId]();
    if (sym.decl != id.DECL_NIL) {
        export = session.export_name(ctx.s, sym.origin, sym.decl::u32);
    }
    ret mangle.linkage_name(ctx.s, fqn, sym.canon, export);
}

pub fun symbol_linkage_name(ctx: *context.LowerContext, eid: id.ExprId) O.Option[intern.StrId] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret O.none[intern.StrId](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);

    val is_addressable: bool = sym.kind == resolve.SYM_FUN
        || sym.kind == resolve.SYM_VAL
        || sym.kind == resolve.SYM_VAR
        || sym.kind == resolve.SYM_IMPORTED;
    if (!is_addressable) { ret O.none[intern.StrId](); }

    val res_ln: R.Result[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (R.is_err[intern.StrId, fail.Fail](res_ln)) { ret O.none[intern.StrId](); }
    ret O.some[intern.StrId](R.unwrap_ok[intern.StrId, fail.Fail](res_ln));
}

fun symbol_reference(ctx: *context.LowerContext, eid: id.ExprId, sid: resolve.SymbolId) R.Result[value.Value, fail.Fail] {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) {
        ret report_expr(ctx, eid, "unresolved identifier");
    }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);

    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    val vty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);

    val res_ln: R.Result[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (R.is_err[intern.StrId, fail.Fail](res_ln)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_ln)); }
    val link: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_ln);

    if (names_function(ctx, sym)) {
        val res_fn: R.Result[value.Value, fail.Fail] = fn_reference(ctx, link, vty, references_import_function(ctx, sym));
        if (R.is_err[value.Value, fail.Fail](res_fn)) { ret res_fn; }
        stamp_spirv_op(ctx, sym, R.unwrap_ok[value.Value, fail.Fail](res_fn));
        val res_ci: R.Result[R.Void, fail.Fail] = enqueue_inline_import(ctx, sym, link);
        if (R.is_err[R.Void, fail.Fail](res_ci)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_ci)); }
        ret res_fn;
    }

    val res_cv: R.Result[O.Option[comptime.CTValue], fail.Fail] = module_const_value(ctx, sym);
    if (R.is_err[O.Option[comptime.CTValue], fail.Fail](res_cv)) {
        ret R.err[value.Value, fail.Fail](R.unwrap_err[O.Option[comptime.CTValue], fail.Fail](res_cv));
    }
    val opt_cv: O.Option[comptime.CTValue] = R.unwrap_ok[O.Option[comptime.CTValue], fail.Fail](res_cv);
    if (O.is_some[comptime.CTValue](opt_cv)) {
        ret const_value_of(ctx, eid, O.unwrap[comptime.CTValue](opt_cv));
    }

    val opt_gi: O.Option[u32] = find_global(ctx, link);
    if (O.is_some[u32](opt_gi)) {
        ret emit_global_rvalue(ctx, O.unwrap[u32](opt_gi), vty);
    }

    val res_xg: R.Result[u32, fail.Fail] = context.ensure_extern_global(ctx, link, vty, references_import_data(ctx, sym));
    if (R.is_err[u32, fail.Fail](res_xg)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[u32, fail.Fail](res_xg)); }
    ret emit_global_rvalue(ctx, R.unwrap_ok[u32, fail.Fail](res_xg), vty);
}

fun module_const_value(ctx: *context.LowerContext, sym: *resolve.Symbol) R.Result[O.Option[comptime.CTValue], fail.Fail] {
    val oa: *ast.Ast = session.module_ast(ctx.s, sym.origin);
    if (oa == nil) { ret R.err[O.Option[comptime.CTValue], fail.Fail](fail.message("lower: module-level reference: origin module AST unavailable (invariant violated)")); }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(oa, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret R.err[O.Option[comptime.CTValue], fail.Fail](fail.message("lower: module-level reference: decl id out of range in origin AST (invariant violated)")); }
    if (O.unwrap[*decl.Decl](opt_d).kind != decl.DECL_KIND_VAL) { ret R.ok[O.Option[comptime.CTValue], fail.Fail](O.none[comptime.CTValue]()); }

    val dctx: *comptime.ComptimeCtx = context.declaring_comptime_ctx(ctx, sym);
    if (dctx == nil) { ret R.err[O.Option[comptime.CTValue], fail.Fail](fail.message("lower: module-level reference: declaring module comptime context unavailable (invariant violated)")); }
    val opt_nc: O.Option[comptime.NamedConst] = comptime.lookup(dctx, sym.name);
    if (O.is_none[comptime.NamedConst](opt_nc)) { ret R.ok[O.Option[comptime.CTValue], fail.Fail](O.none[comptime.CTValue]()); }

    val named: comptime.NamedConst = O.unwrap[comptime.NamedConst](opt_nc);
    if (named.gated && ctx.scope.env.union_build) {
        val msg: str = context.gated_lower_member_const_message(ctx, sym.name, session.module_fqn(ctx.s, sym.origin));
        var zero_span: token.Span;
        zero_span.offset = 0;
        zero_span.len    = 0;
        ret R.err[O.Option[comptime.CTValue], fail.Fail](context.report_gate(ctx, zero_span, msg));
    }
    val v: comptime.CTValue = named.value;
    if (!const_has_no_identity(v)) { ret R.ok[O.Option[comptime.CTValue], fail.Fail](O.none[comptime.CTValue]()); }
    ret R.ok[O.Option[comptime.CTValue], fail.Fail](O.some[comptime.CTValue](v));
}

fun const_has_no_identity(v: comptime.CTValue) bool {
    ret v.kind == comptime.CT_KIND_INT
     || v.kind == comptime.CT_KIND_FLOAT;
}

pub fun references_function(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val tid: type.TypeId = context.expr_type_of(ctx, eid);
    val opt_t: O.Option[*type.Type] = type.get(?ctx.s.types, tid);
    if (O.is_none[*type.Type](opt_t)) { ret false; }
    ret O.unwrap[*type.Type](opt_t).kind == type.TYPE_FUN;
}

fun references_import_data(ctx: *context.LowerContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    val origin_ast: *ast.Ast = session.module_ast(ctx.s, sym.origin);
    if (origin_ast == nil) { ret false; }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_d);
    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) { ret false; }
    ret (d.flags & decl.DECL_FLAG_EXT) != 0;
}

fun stamp_spirv_op(ctx: *context.LowerContext, sym: *resolve.Symbol, v: value.Value) {
    if (v.kind != value.VAL_FN || v.data.fn_ix >= ctx.m.function_len) { ret; }
    val origin_ast: *ast.Ast = session.module_ast(ctx.s, sym.origin);
    if (origin_ast == nil) { ret; }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret; }
    val fi: u32 = v.data.fn_ix;
    val set_v: u32 = context.decl_target_op(origin_ast, context.ast_source(ctx, origin_ast),
                                            O.unwrap[*decl.Decl](opt_d), ctx.tgt.isa.defs,
                                            ?ctx.m.functions[fi].op_code);
    if (set_v != isa.NO_OP_SET) { ctx.m.functions[fi].op_set = set_v; }
}

fun references_import_function(ctx: *context.LowerContext, sym: *resolve.Symbol) bool {
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    val origin_ast: *ast.Ast = session.module_ast(ctx.s, sym.origin);
    if (origin_ast == nil) { ret false; }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret false; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_d);
    if (d.kind != decl.DECL_KIND_FUN) { ret false; }
    ret (d.flags & decl.DECL_FLAG_EXT) != 0;
}

fun enqueue_inline_import(ctx: *context.LowerContext, sym: *resolve.Symbol, link: intern.StrId) R.Result[R.Void, fail.Fail] {
    if (sym.kind != resolve.SYM_IMPORTED) { ret R.ok_void[fail.Fail](); }
    val origin_ast: *ast.Ast = session.module_ast(ctx.s, sym.origin);
    if (origin_ast == nil) { ret R.ok_void[fail.Fail](); }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret R.ok_void[fail.Fail](); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_d);
    if (d.kind != decl.DECL_KIND_FUN)             { ret R.ok_void[fail.Fail](); }
    if ((d.flags & decl.DECL_FLAG_EXT) != 0)      { ret R.ok_void[fail.Fail](); }
    if (d.data.fun_.body == id.STMT_NIL)          { ret R.ok_void[fail.Fail](); }
    if (d.data.fun_.generics_len > 0)             { ret R.ok_void[fail.Fail](); }
    if (fun_decl_is_template(origin_ast, d))      { ret R.ok_void[fail.Fail](); }
    if (!decl_has_origin_decorator(ctx, origin_ast, d, "inline")) { ret R.ok_void[fail.Fail](); }

    ret context.enqueue_instance(ctx, sym.decl, sym.origin, nil, 0, link, sym.name);
}

fun fun_decl_is_template(a: *ast.Ast, d: *decl.Decl) bool {
    var i: u32 = 0;
    for (i < d.data.fun_.params_len) {
        val pool_ix: u32 = d.data.fun_.params_start + i;
        if (pool_ix::usize >= a.typed_name_len) { ret true; }
        val tn: *decl.TypedName = ?a.typed_names[pool_ix];
        if (tn.comptime) { ret true; }
        val opt_t: O.Option[*atype.Type] = ast.get_type(a, tn.ty);
        if (O.is_some[*atype.Type](opt_t)
            && O.unwrap[*atype.Type](opt_t).kind == atype.TYPE_KIND_PACK) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun decl_has_origin_decorator(ctx: *context.LowerContext, a: *ast.Ast, d: *decl.Decl, name: str) bool {
    val src: str = context.ast_source(ctx, a);
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *decl.Decorator = ?a.decorators[d.decorators_start + i];
        if (str_region_equals(src, dec.name.offset, dec.name.len, name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun names_function(ctx: *context.LowerContext, sym: *resolve.Symbol) bool {
    if (sym.kind == resolve.SYM_FUN) { ret true; }
    if (sym.kind == resolve.SYM_VAL || sym.kind == resolve.SYM_VAR
        || sym.kind == resolve.SYM_PARAM) { ret false; }
    if (sym.kind != resolve.SYM_IMPORTED) { ret false; }
    val origin_ast: *ast.Ast = session.module_ast(ctx.s, sym.origin);
    if (origin_ast == nil) { ret false; }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret false; }
    ret O.unwrap[*decl.Decl](opt_d).kind == decl.DECL_KIND_FUN;
}

fun symbol_lvalue(ctx: *context.LowerContext, eid: id.ExprId, sid: resolve.SymbolId) R.Result[value.Value, fail.Fail] {
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) {
        ret report_expr(ctx, eid, "unresolved identifier");
    }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);

    val res_ln: R.Result[intern.StrId, fail.Fail] = reference_linkage_name(ctx, sym);
    if (R.is_err[intern.StrId, fail.Fail](res_ln)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_ln)); }
    val link: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_ln);

    val opt_gi: O.Option[u32] = find_global(ctx, link);
    if (O.is_some[u32](opt_gi)) {
        ret global_pointer(ctx, O.unwrap[u32](opt_gi));
    }

    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    val vty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);
    val res_xg: R.Result[u32, fail.Fail] = context.ensure_extern_global(ctx, link, vty, references_import_data(ctx, sym));
    if (R.is_err[u32, fail.Fail](res_xg)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[u32, fail.Fail](res_xg)); }
    ret global_pointer(ctx, R.unwrap_ok[u32, fail.Fail](res_xg));
}

fun lower_ident_lvalue(ctx: *context.LowerContext, eid: id.ExprId) R.Result[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);

    val opt_cv: O.Option[comptime.CTValue] = comptime_param_value(ctx, sid);
    if (O.is_some[comptime.CTValue](opt_cv)) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: cannot take the address of a comptime parameter"));
    }

    val opt_ord: O.Option[u32] = pack_elem_ordinal(ctx, sid);
    if (O.is_some[u32](opt_ord)) {
        val ord: u32 = O.unwrap[u32](opt_ord);
        if (ctx.pack_slots == nil || ord >= ctx.pack_len) {
            ret R.err[value.Value, fail.Fail](fail.message("lower: pack element ordinal out of range"));
        }
        ret R.ok[value.Value, fail.Fail](ctx.pack_slots[ord]);
    }

    val opt_celem: O.Option[id.ExprId] = const_elem_expr(ctx, sid);
    if (O.is_some[id.ExprId](opt_celem)) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: cannot take the address of a `$each` constant array element"));
    }

    val opt_local: O.Option[value.Value] = context.lookup_local(ctx, sid);
    if (O.is_some[value.Value](opt_local)) {
        ret R.ok[value.Value, fail.Fail](O.unwrap[value.Value](opt_local));
    }
    ret symbol_lvalue(ctx, eid, sid);
}

fun try_lower_const_elem_member(ctx: *context.LowerContext, e: *expr.Expr) O.Option[R.Result[value.Value, fail.Fail]] {
    val obj_opt: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, e.data.member.object);
    if (O.is_none[*expr.Expr](obj_opt))                             { ret O.none[R.Result[value.Value, fail.Fail]](); }
    if (O.unwrap[*expr.Expr](obj_opt).kind != expr.EXPR_KIND_IDENT) { ret O.none[R.Result[value.Value, fail.Fail]](); }

    val osid: resolve.SymbolId = context.expr_symbol_of(ctx, e.data.member.object);
    val opt_elem: O.Option[id.ExprId] = const_elem_expr(ctx, osid);
    if (O.is_none[id.ExprId](opt_elem))                             { ret O.none[R.Result[value.Value, fail.Fail]](); }

    val field_eid: id.ExprId = const_elem_field_expr(ctx, O.unwrap[id.ExprId](opt_elem), e.data.member.name);
    if (field_eid == id.EXPR_NIL)                                   { ret O.none[R.Result[value.Value, fail.Fail]](); }
    ret O.some[R.Result[value.Value, fail.Fail]](lower_rvalue(ctx, field_eid));
}

fun try_lower_field_member(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) O.Option[R.Result[value.Value, fail.Fail]] {
    val src_text: str = context.module_source(ctx);
    val res_obj: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, e.data.member.object, ?ctx.s.interner);
    context.record_eval_result(ctx, res_obj);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_obj))                                   { ret O.none[R.Result[value.Value, fail.Fail]](); }
    if (R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_obj).kind != comptime.CT_KIND_FIELD) { ret O.none[R.Result[value.Value, fail.Fail]](); }

    val res_member: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, src_text, eid, ?ctx.s.interner);

    context.record_eval_result(ctx, res_member);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_member)) { ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_member).message))); }
    val v: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_member);
    if (v.kind == comptime.CT_KIND_INT) {
        val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir))); }
        ret O.some[R.Result[value.Value, fail.Fail]](R.ok[value.Value, fail.Fail](value.const_int(v.data.i:~u64, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir))));
    }
    if (v.kind == comptime.CT_KIND_STR) {
        val res_ptr: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?ctx.m.types);
        if (R.is_err[ir_type.IrTypeId, str](res_ptr)) { ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_ptr)))); }
        val pty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_ptr);
        val opt_bytes: O.Option[str] = intern.lookup(?ctx.s.interner, v.data.s);
        if (O.is_none[str](opt_bytes)) { ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message("lower: field name lookup failed"))); }
        val bytes: str = O.unwrap[str](opt_bytes);
        val blob: value.Value = value.const_bytes(bytes::*u8, (str_len(bytes) + 1::usize)::u32, pty);
        ret O.some[R.Result[value.Value, fail.Fail]](context.add_rodata_bytes(ctx, blob, pty));
    }
    ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message("lower: unsupported field descriptor member in value position")));
}

fun try_lower_pack_len(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) O.Option[R.Result[value.Value, fail.Fail]] {
    val obj_ty: type.TypeId = context.expr_type_of(ctx, e.data.member.object);
    val opt_t: O.Option[*type.Type] = type.get(?ctx.s.types, obj_ty);
    if (O.is_none[*type.Type](opt_t))                       { ret O.none[R.Result[value.Value, fail.Fail]](); }
    if (O.unwrap[*type.Type](opt_t).kind != type.TYPE_PACK) { ret O.none[R.Result[value.Value, fail.Fail]](); }

    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) {
        ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)));
    }
    val ity: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);
    ret O.some[R.Result[value.Value, fail.Fail]](R.ok[value.Value, fail.Fail](value.const_int(ctx.pack_len::u64, ity)));
}

fun lower_member_rvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val opt_celem: O.Option[R.Result[value.Value, fail.Fail]] = try_lower_const_elem_member(ctx, e);
    if (O.is_some[R.Result[value.Value, fail.Fail]](opt_celem)) { ret O.unwrap[R.Result[value.Value, fail.Fail]](opt_celem); }

    val opt_pack_len: O.Option[R.Result[value.Value, fail.Fail]] = try_lower_pack_len(ctx, eid, e);
    if (O.is_some[R.Result[value.Value, fail.Fail]](opt_pack_len)) { ret O.unwrap[R.Result[value.Value, fail.Fail]](opt_pack_len); }

    val opt_field: O.Option[R.Result[value.Value, fail.Fail]] = try_lower_field_member(ctx, eid, e);
    if (O.is_some[R.Result[value.Value, fail.Fail]](opt_field)) { ret O.unwrap[R.Result[value.Value, fail.Fail]](opt_field); }

    val qsid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    if (qsid != resolve.SYMBOL_NIL) {
        ret symbol_reference(ctx, eid, qsid);
    }

    if (comptime.is_comptime_path(ctx.scope.a, eid)) {
        ret lower_comptime_path(ctx, eid);
    }

    val res_ptr: R.Result[value.Value, fail.Fail] = lower_member_lvalue(ctx, eid, e);
    if (R.is_err[value.Value, fail.Fail](res_ptr)) { ret res_ptr; }
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret rvalue_at(ctx, R.unwrap_ok[value.Value, fail.Fail](res_ptr), R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir), field_access_is_volatile(ctx, e.data.member.object));
}

fun lower_member_lvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val qsid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    if (qsid != resolve.SYMBOL_NIL) {
        ret symbol_lvalue(ctx, eid, qsid);
    }

    var rec_ty: type.TypeId;
    val res_base: R.Result[value.Value, fail.Fail] = member_receiver(ctx, eid, e.data.member.object,
        "field access on untyped pointer; cast to a typed pointer (*T) first", ?rec_ty);
    if (R.is_err[value.Value, fail.Fail](res_base)) { ret res_base; }

    val field_ix: u32 = field_index_in_type(ctx, rec_ty, e.data.member.name);
    ret field_gep(ctx, R.unwrap_ok[value.Value, fail.Fail](res_base), rec_ty, field_ix);
}

fun project_field_index(ctx: *context.LowerContext, field_eid: id.ExprId) R.Result[u32, fail.Fail] {
    val res_field: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), field_eid, ?ctx.s.interner);
    context.record_eval_result(ctx, res_field);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_field)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_field).message)); }
    val fv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_field);
    if (fv.kind != comptime.CT_KIND_FIELD) {
        ret R.err[u32, fail.Fail](fail.message("lower: `v.[f]` field operand is not a comptime field descriptor"));
    }
    ret R.ok[u32, fail.Fail](fv.data.fld.index);
}

fun lower_project_rvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_ptr: R.Result[value.Value, fail.Fail] = lower_project_lvalue(ctx, eid, e);
    if (R.is_err[value.Value, fail.Fail](res_ptr)) { ret res_ptr; }
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret rvalue_at(ctx, R.unwrap_ok[value.Value, fail.Fail](res_ptr), R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir), field_access_is_volatile(ctx, e.data.project.object));
}

fun lower_project_lvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_fix: R.Result[u32, fail.Fail] = project_field_index(ctx, e.data.project.field);
    if (R.is_err[u32, fail.Fail](res_fix)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[u32, fail.Fail](res_fix)); }
    val field_ix: u32 = R.unwrap_ok[u32, fail.Fail](res_fix);

    var rec_ty: type.TypeId;
    val res_base: R.Result[value.Value, fail.Fail] = member_receiver(ctx, eid, e.data.project.object,
        "field projection on untyped pointer; cast to a typed pointer (*T) first", ?rec_ty);
    if (R.is_err[value.Value, fail.Fail](res_base)) { ret res_base; }

    ret field_gep(ctx, R.unwrap_ok[value.Value, fail.Fail](res_base), rec_ty, field_ix);
}

fun vector_lane_of(ctx: *context.LowerContext, e: *expr.Expr) O.Option[R.Result[u64, fail.Fail]] {
    val obj_ty: type.TypeId = context.expr_type_of(ctx, e.data.index.object);
    if (!type.is_vector(?ctx.s.types, obj_ty)) { ret O.none[R.Result[u64, fail.Fail]](); }

    val cr: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a,
        context.module_source(ctx), e.data.index.index, ?ctx.s.interner);

    context.record_eval_result(ctx, cr);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](cr)) {
        ret O.some[R.Result[u64, fail.Fail]](R.err[u64, fail.Fail](fail.message("lower: vector lane index is not a comptime constant")));
    }
    val cv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](cr);
    if (cv.kind != comptime.CT_KIND_INT || comptime.ct_is_negative(cv)) {
        ret O.some[R.Result[u64, fail.Fail]](R.err[u64, fail.Fail](fail.message("lower: vector lane index is not a non-negative integer constant")));
    }
    ret O.some[R.Result[u64, fail.Fail]](R.ok[u64, fail.Fail](cv.data.i:~u64));
}

fun lower_index_rvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val opt_lane: O.Option[R.Result[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (O.is_some[R.Result[u64, fail.Fail]](opt_lane)) {
        ret lower_vector_lane_read(ctx, eid, e, O.unwrap[R.Result[u64, fail.Fail]](opt_lane));
    }
    val res_ptr: R.Result[value.Value, fail.Fail] = lower_index_lvalue(ctx, eid, e);
    if (R.is_err[value.Value, fail.Fail](res_ptr)) { ret res_ptr; }
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    ret rvalue_at(ctx, R.unwrap_ok[value.Value, fail.Fail](res_ptr), R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir), false);
}

fun lower_vector_lane_read(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr,
                           lane: R.Result[u64, fail.Fail]) R.Result[value.Value, fail.Fail] {
    if (R.is_err[u64, fail.Fail](lane)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[u64, fail.Fail](lane)); }

    val res_vec: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
    if (R.is_err[value.Value, fail.Fail](res_vec)) { ret res_vec; }

    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }

    ret fail.lift[value.Value](builder.emit_vec_extract(?ctx.builder,
        R.unwrap_ok[value.Value, fail.Fail](res_vec),
        value.const_int(R.unwrap_ok[u64, fail.Fail](lane), R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty)),
        R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir)));
}

fun lower_index_lvalue(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, e.data.index.object));
    val is_ptr: bool        = is_pointer_type(ctx, obj_ty);

    var base: value.Value;
    if (is_ptr) {
        val res_base: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.object);
        if (R.is_err[value.Value, fail.Fail](res_base)) { ret res_base; }
        base = R.unwrap_ok[value.Value, fail.Fail](res_base);
    } or {
        val res_base: R.Result[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
        if (R.is_err[value.Value, fail.Fail](res_base)) { ret res_base; }
        base = R.unwrap_ok[value.Value, fail.Fail](res_base);
    }

    val res_ix: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.index.index);
    if (R.is_err[value.Value, fail.Fail](res_ix)) { ret res_ix; }
    var ix: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_ix);

    val res_widen: R.Result[value.Value, fail.Fail] = widen_index(ctx, ix, context.expr_type_of(ctx, e.data.index.index));
    if (R.is_err[value.Value, fail.Fail](res_widen)) { ret res_widen; }
    ix = R.unwrap_ok[value.Value, fail.Fail](res_widen);

    if (is_ptr) {
        val opt_pt: O.Option[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (O.is_none[*type.Type](opt_pt)) { ret R.err[value.Value, fail.Fail](fail.message("lower: index base has no pointer type")); }
        val pt: *type.Type = O.unwrap[*type.Type](opt_pt);
        if (pt.kind != type.TYPE_POINTER) {
            ret report_expr(ctx, eid, "index on untyped pointer; use a typed pointer (*T) to index");
        }
        val res_elem_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, pt.data.pointer.base);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_elem_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_elem_ir)); }
        var idx1: [1]value.Value;
        idx1[0] = ix;
        ret fail.lift[value.Value](builder.emit_gep(?ctx.builder, base, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_elem_ir), ?idx1[0], 1));
    }

    val res_obj_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, obj_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_obj_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_obj_ir)); }
    var arr_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_obj_ir);

    if (type.is_vector(?ctx.s.types, obj_ty)) {
        val opt_v: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, arr_ir);
        if (O.is_some[*ir_type.IrType](opt_v)) {
            val vt: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_v);
            if (vt.kind == ir_type.IRT_VECTOR) {
                val elem:  ir_type.IrTypeId = vt.data.vector_.element;
                val lanes: u32              = vt.data.vector_.lanes;
                val res_arr: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?ctx.m.types, elem, lanes);
                if (R.is_err[ir_type.IrTypeId, str](res_arr)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_arr))); }
                arr_ir = R.unwrap_ok[ir_type.IrTypeId, str](res_arr);
            }
        }
    }

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);

    var idx: [2]value.Value;
    idx[0] = value.const_int(0, xty);
    idx[1] = ix;
    ret fail.lift[value.Value](builder.emit_gep(?ctx.builder, base, arr_ir, ?idx[0], 2));
}

fun interned_literal(ctx: *context.LowerContext, text: str) intern.StrId {
    val res_str: R.Result[intern.StrId, str] = intern.intern(?ctx.s.interner, text);
    if (R.is_err[intern.StrId, str](res_str)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](res_str);
}

pub fun try_lower_comptime_intrinsic(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) O.Option[R.Result[value.Value, fail.Fail]] {
    val opt_ce: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, e.data.call.callee);
    if (O.is_none[*expr.Expr](opt_ce)) { ret O.none[R.Result[value.Value, fail.Fail]](); }
    val ce: *expr.Expr = O.unwrap[*expr.Expr](opt_ce);
    if (ce.kind != expr.EXPR_KIND_COMPTIME_IDENT) { ret O.none[R.Result[value.Value, fail.Fail]](); }

    val ns: token.Span = comptime.comptime_ident_name(ce.span);
    if (ns.len == 0) { ret O.none[R.Result[value.Value, fail.Fail]](); }
    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, context.module_source(ctx), ns);
    if (R.is_err[intern.StrId, str](res_name)) {
        ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name))));
    }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    if (name == interned_literal(ctx, "type_name")) {
        val tv: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner);
        context.record_eval_result(ctx, tv);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](tv)) {
            ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[comptime.CTValue, comptime.EvalFail](tv).message)));
        }
        ret O.some[R.Result[value.Value, fail.Fail]](const_value_of(ctx, eid, R.unwrap_ok[comptime.CTValue, comptime.EvalFail](tv)));
    }

    val is_size:   bool = name == interned_literal(ctx, "size_of");
    val is_align:  bool = name == interned_literal(ctx, "align_of");
    val is_offset: bool = name == interned_literal(ctx, "offset_of");
    val is_len:    bool = name == interned_literal(ctx, "length_of");
    if (!is_size && !is_align && !is_offset && !is_len) { ret O.none[R.Result[value.Value, fail.Fail]](); }

    var arity: u32 = 1;
    if (is_offset) { arity = 2; }
    if (e.data.call.args_len < arity ||
        e.data.call.args_start::usize + e.data.call.args_len::usize > ctx.scope.a.expr_id_len) {
        ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message("lower: comptime intrinsic argument index out of range")));
    }
    val arg0_eid: id.ExprId   = ctx.scope.a.expr_ids[e.data.call.args_start];
    val op_ty:    type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, arg0_eid));
    val res_op_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, op_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_op_ir)) {
        ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_op_ir)));
    }
    val op_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_op_ir);

    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) {
        ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)));
    }
    val rt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);

    var n: u32 = 0;
    if (is_size)  { n = ir_type.byte_size_for_machine(?ctx.m.types, op_ir, resolved_target.layout_machine(ctx.tgt)); }
    if (is_align) { n = ir_type.byte_align_for_machine(?ctx.m.types, op_ir, resolved_target.layout_machine(ctx.tgt)); }
    if (is_len) {
        val c_opt: O.Option[u32] = type.element_count(?ctx.s.types, op_ty);
        if (O.is_none[u32](c_opt)) {
            ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message("lower: $length_of operand has no element count")));
        }
        n = O.unwrap[u32](c_opt);
    }
    if (is_offset) {
        val f_eid: id.ExprId = ctx.scope.a.expr_ids[e.data.call.args_start + 1];
        val opt_f: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, f_eid);
        if (O.is_none[*expr.Expr](opt_f)) {
            ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message("lower: offset_of field argument out of range")));
        }
        val field_ix: u32 = field_index_in_type(ctx, op_ty, O.unwrap[*expr.Expr](opt_f).span);
        n = ir_type.byte_offset_for_machine(?ctx.m.types, op_ir, field_ix, resolved_target.layout_machine(ctx.tgt));
    }

    val dst_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, eid));
    val opt_dst: O.Option[*type.Type] = type.get(?ctx.s.types, dst_ty);
    if (O.is_some[*type.Type](opt_dst)) {
        val d: type.PrimDesc = type.prim_desc(O.unwrap[*type.Type](opt_dst).kind);
        if (d.class == type.PRIM_CLASS_INT) {
            var max: u64 = 0;
            if (d.signed) { max = (1::u64 << (d.bits - 1)::usize) - 1; }
            or            { max = ~(0::u64) >> (64 - d.bits)::usize; }
            if (n::u64 > max) {
                ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message("a layout measurement does not fit the type it is assigned to; widen the binding or cast the measurement")));
            }
        }
    }

    ret O.some[R.Result[value.Value, fail.Fail]](R.ok[value.Value, fail.Fail](value.const_int(n::u64, rt)));
}

pub fun try_lower_comptime_cast(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) O.Option[R.Result[value.Value, fail.Fail]] {
    if (e.kind != expr.EXPR_KIND_CAST) { ret O.none[R.Result[value.Value, fail.Fail]](); }
    val opt_folded: O.Option[R.Result[comptime.CTValue, comptime.EvalFail]] = fold_const_scalar(ctx, eid);
    if (O.is_none[R.Result[comptime.CTValue, comptime.EvalFail]](opt_folded)) { ret O.none[R.Result[value.Value, fail.Fail]](); }
    val res_cv: R.Result[comptime.CTValue, comptime.EvalFail] = O.unwrap[R.Result[comptime.CTValue, comptime.EvalFail]](opt_folded);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_cv)) {
        ret O.some[R.Result[value.Value, fail.Fail]](R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_cv).message)));
    }
    ret O.some[R.Result[value.Value, fail.Fail]](const_value_of(ctx, eid, R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_cv)));
}

fun fold_const_scalar(ctx: *context.LowerContext, eid: id.ExprId) O.Option[R.Result[comptime.CTValue, comptime.EvalFail]] {
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*expr.Expr](opt_e)) { ret O.none[R.Result[comptime.CTValue, comptime.EvalFail]](); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](opt_e);

    if (e.kind != expr.EXPR_KIND_CAST) {
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] =
            comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner,
                                         context.expr_float_width(ctx, eid));
        context.record_eval_result(ctx, res_eval);
        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) { ret O.none[R.Result[comptime.CTValue, comptime.EvalFail]](); }
        ret O.some[R.Result[comptime.CTValue, comptime.EvalFail]](R.ok[comptime.CTValue, comptime.EvalFail](R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval)));
    }

    val opt_op: O.Option[R.Result[comptime.CTValue, comptime.EvalFail]] = fold_const_scalar(ctx, e.data.cast.value);
    if (O.is_none[R.Result[comptime.CTValue, comptime.EvalFail]](opt_op)) { ret O.none[R.Result[comptime.CTValue, comptime.EvalFail]](); }
    val res_op: R.Result[comptime.CTValue, comptime.EvalFail] = O.unwrap[R.Result[comptime.CTValue, comptime.EvalFail]](opt_op);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_op)) { ret O.some[R.Result[comptime.CTValue, comptime.EvalFail]](res_op); }
    val opv: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_op);

    val from_ty: type.TypeId = context.expr_type_of(ctx, e.data.cast.value);
    val to_ty:   type.TypeId = context.type_resolved_of(ctx, e.data.cast.ty);
    ret O.some[R.Result[comptime.CTValue, comptime.EvalFail]](convert_const_scalar(ctx, opv, from_ty, to_ty, e.data.cast.reinterpret));
}

fun convert_const_scalar(
    ctx:         *context.LowerContext,
    v:           comptime.CTValue,
    from_ty:     type.TypeId,
    to_ty:       type.TypeId,
    reinterpret: bool
) R.Result[comptime.CTValue, comptime.EvalFail] {
    val from_float: bool = is_float_type(ctx, from_ty);
    val to_float:   bool = is_float_type(ctx, to_ty);
    val to_signed:  bool = is_signed_type(ctx, to_ty);
    val to_bits:    u32  = scalar_bits(ctx, to_ty);

    if (reinterpret) { ret reinterpret_const_scalar(ctx, v, from_ty, from_float, to_bits, to_signed, to_float); }

    val to_fw: float.FloatWidth = context.float_width_of_type(ctx, to_ty);

    if (from_float && to_float) { ret float_ct(v.data.f, to_fw); }
    if (from_float && !to_float) {
        if (to_signed) { ret int_ct(rerepresent_int(v.data.f::i64, to_bits, to_signed), !to_signed); }
        ret int_ct(rerepresent_int((v.data.f::u64):~i64, to_bits, to_signed), !to_signed);
    }
    if (!from_float && to_float) {
        if (is_signed_type(ctx, from_ty)) { ret float_ct(v.data.i::f64, to_fw); }
        ret float_ct((v.data.i:~u64)::f64, to_fw);
    }

    ret int_ct(rerepresent_int(v.data.i, to_bits, to_signed), !to_signed);
}

fun reinterpret_const_scalar(
    ctx:        *context.LowerContext,
    v:          comptime.CTValue,
    from_ty:    type.TypeId,
    from_float: bool,
    to_bits:    u32,
    to_signed:  bool,
    to_float:   bool
) R.Result[comptime.CTValue, comptime.EvalFail] {
    if (from_float == to_float) { ret R.ok[comptime.CTValue, comptime.EvalFail](v); }

    val from_bits: u32 = scalar_bits(ctx, from_ty);

    if (from_float && !to_float) {
        if (from_bits <= 32) {
            val bits32: u32 = (v.data.f::f32):~u32;
            ret int_ct(rerepresent_int(bits32::i64, to_bits, to_signed), !to_signed);
        }
        ret int_ct(rerepresent_int(v.data.f:~i64, to_bits, to_signed), !to_signed);
    }

    if (to_bits <= 32) {
        val bits32: u32 = (v.data.i:~u64)::u32;
        val f32v:   f32 = bits32:~f32;
        ret float_ct(f32v::f64, float.FLOAT_W_32);
    }
    ret float_ct(v.data.i:~f64, float.FLOAT_W_64);
}

fun rerepresent_int(x: i64, to_bits: u32, to_signed: bool) i64 {
    if (to_bits == 0 || to_bits >= 64) { ret x; }
    val shift:  u64 = (64 - to_bits)::u64;
    val masked: u64 = (x::u64 << shift) >> shift;
    if (!to_signed) { ret masked::i64; }
    ret (masked::i64 << shift) >> shift;
}

fun int_ct(i: i64, unsigned: bool) R.Result[comptime.CTValue, comptime.EvalFail] {
    var v: comptime.CTValue;
    v.kind         = comptime.CT_KIND_INT;
    v.int_unsigned = unsigned;
    v.int_width    = 0;
    v.data.i       = i;
    ret R.ok[comptime.CTValue, comptime.EvalFail](v);
}

fun float_ct(f: f64, w: float.FloatWidth) R.Result[comptime.CTValue, comptime.EvalFail] {
    ret R.ok[comptime.CTValue, comptime.EvalFail](comptime.ct_float(f, w));
}

fun lower_call(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val opt_intr: O.Option[R.Result[value.Value, fail.Fail]] = try_lower_comptime_intrinsic(ctx, eid, e);
    if (O.is_some[R.Result[value.Value, fail.Fail]](opt_intr)) { ret O.unwrap[R.Result[value.Value, fail.Fail]](opt_intr); }

    val res_callee: R.Result[value.Value, fail.Fail] = lower_callee(ctx, eid, e);
    if (R.is_err[value.Value, fail.Fail](res_callee)) { ret res_callee; }
    val callee: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_callee);

    val opt_cf: O.Option[*decl.DeclFun] = callee_decl_fun(ctx, e.data.call.callee);
    var has_ct:  bool          = false;
    var cf_decl: *decl.DeclFun = nil;
    var cf_ast:  *ast.Ast      = nil;
    if (O.is_some[*decl.DeclFun](opt_cf)) {
        cf_decl = O.unwrap[*decl.DeclFun](opt_cf);
        if (decl_fun_has_comptime_param(ctx, e.data.call.callee, cf_decl)) {
            has_ct = true;
            cf_ast = callee_ast(ctx, e.data.call.callee);
        }
    }

    val argc:       u32  = e.data.call.args_len;
    val has_spread: bool = call_has_spread(ctx, e);
    var rtc:        u32  = argc;
    if (has_ct)     { rtc = runtime_arg_count(ctx, cf_ast, cf_decl, argc); }
    if (has_spread) { rtc = (argc - 1) + ctx.pack_len; }

    var args: *value.Value = nil;
    if (rtc > 0) {
        val res_args: R.Result[*value.Value, str] = A.allocate[value.Value](ctx.s.alloc, rtc::usize);
        if (R.is_err[*value.Value, str](res_args)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[*value.Value, str](res_args))); }
        args = R.unwrap_ok[*value.Value, str](res_args);

        var dst: u32 = 0;
        var i:   u32 = 0;
        for (i < argc) {
            if (has_ct && arg_is_comptime(ctx, cf_ast, cf_decl, i)) { i = i + 1; cnt; }
            val pool_ix: u32 = e.data.call.args_start + i;
            if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
                A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize);
                ret R.err[value.Value, fail.Fail](fail.message("lower: call argument index out of range"));
            }
            val arg_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
            if (has_spread && is_spread_expr(ctx, arg_eid)) {
                var ii: u32 = 0;
                for (ii < ctx.pack_len) {
                    val res_slot: R.Result[value.Value, fail.Fail] = load_pack_slot(ctx, ii);
                    if (R.is_err[value.Value, fail.Fail](res_slot)) {
                        A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize);
                        ret res_slot;
                    }
                    args[dst] = R.unwrap_ok[value.Value, fail.Fail](res_slot);
                    dst = dst + 1;
                    ii  = ii + 1;
                }
                i = i + 1;
                cnt;
            }
            val res_arg: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, arg_eid);
            if (R.is_err[value.Value, fail.Fail](res_arg)) {
                A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize);
                ret res_arg;
            }
            args[dst] = R.unwrap_ok[value.Value, fail.Fail](res_arg);
            dst = dst + 1;
            i   = i + 1;
        }
    }
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) {
        if (args != nil) { A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize); }
        ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir));
    }
    val rt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);

    val res_call: R.Result[value.Value, str] = builder.emit_call(?ctx.builder, callee, args, rtc, rt);
    if (args != nil) { A.deallocate[value.Value](ctx.s.alloc, args, rtc::usize); }
    ret fail.lift[value.Value](res_call);
}

fun runtime_arg_count(ctx: *context.LowerContext, a: *ast.Ast, f: *decl.DeclFun, argc: u32) u32 {
    if (a == nil) { ret argc; }
    var len: u32 = 0;
    var i:   u32 = 0;
    for (i < argc) {
        if (!arg_is_comptime(ctx, a, f, i)) { len = len + 1; }
        i = i + 1;
    }
    ret len;
}

fun arg_is_comptime(ctx: *context.LowerContext, a: *ast.Ast, f: *decl.DeclFun, ord: u32) bool {
    if (a == nil)            { ret false; }
    if (ord >= f.params_len) { ret false; }
    ret a.typed_names[f.params_start + ord].comptime;
}

fun lower_callee(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val opt_cf: O.Option[*decl.DeclFun] = callee_decl_fun(ctx, e.data.call.callee);
    if (O.is_some[*decl.DeclFun](opt_cf)) {
        val f: *decl.DeclFun = O.unwrap[*decl.DeclFun](opt_cf);
        if (decl_fun_has_comptime_param(ctx, e.data.call.callee, f)) {
            if (f.generics_len > 0) {
                ret R.err[value.Value, fail.Fail](fail.message("lower: comptime value parameters on a generic function are not supported"));
            }
            ret lower_value_callee(ctx, eid, e, f);
        }
        if (decl_fun_has_pack_param(ctx, e.data.call.callee, f)) {
            ret lower_pack_callee(ctx, eid, e, f);
        }
    }
    if (e.data.call.type_args_len == 0) {
        ret lower_rvalue(ctx, e.data.call.callee);
    }
    ret lower_generic_instance(ctx, eid, e);
}

fun callee_decl_fun(ctx: *context.LowerContext, callee: id.ExprId) O.Option[*decl.DeclFun] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, callee);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret O.none[*decl.DeclFun](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.kind != resolve.SYM_FUN && sym.kind != resolve.SYM_IMPORTED) { ret O.none[*decl.DeclFun](); }
    if (sym.decl == id.DECL_NIL)                                         { ret O.none[*decl.DeclFun](); }

    var origin_ast: *ast.Ast = ctx.scope.a;
    if (sym.origin != ctx.scope.own_module) {
        origin_ast = session.module_ast(ctx.s, sym.origin);
        if (origin_ast == nil) { ret O.none[*decl.DeclFun](); }
    }
    val opt_d: O.Option[*decl.Decl] = ast.get_decl(origin_ast, sym.decl);
    if (O.is_none[*decl.Decl](opt_d)) { ret O.none[*decl.DeclFun](); }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_d);
    if (d.kind != decl.DECL_KIND_FUN) { ret O.none[*decl.DeclFun](); }
    ret O.some[*decl.DeclFun](?d.data.fun_);
}

fun decl_fun_has_comptime_param(ctx: *context.LowerContext, callee: id.ExprId, f: *decl.DeclFun) bool {
    val origin_ast: *ast.Ast = callee_ast(ctx, callee);
    if (origin_ast == nil) { ret false; }
    var i: u32 = 0;
    for (i < f.params_len) {
        if (origin_ast.typed_names[f.params_start + i].comptime) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun decl_fun_has_pack_param(ctx: *context.LowerContext, callee: id.ExprId, f: *decl.DeclFun) bool {
    val origin_ast: *ast.Ast = callee_ast(ctx, callee);
    if (origin_ast == nil) { ret false; }
    if (f.params_len == 0) { ret false; }
    val tn: *decl.TypedName = ?origin_ast.typed_names[f.params_start + (f.params_len - 1)];
    val opt_t: O.Option[*atype.Type] = ast.get_type(origin_ast, tn.ty);
    if (O.is_none[*atype.Type](opt_t)) { ret false; }
    ret O.unwrap[*atype.Type](opt_t).kind == atype.TYPE_KIND_PACK;
}

fun callee_ast(ctx: *context.LowerContext, callee: id.ExprId) *ast.Ast {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, callee);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret nil; }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.origin == ctx.scope.own_module) { ret ctx.scope.a; }
    ret session.module_ast(ctx.s, sym.origin);
}

fun lower_value_callee(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr, f: *decl.DeclFun) R.Result[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, e.data.call.callee);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: unresolved comptime-param call target"));
    }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    val origin_ast: *ast.Ast = callee_ast(ctx, e.data.call.callee);
    if (origin_ast == nil) { ret R.err[value.Value, fail.Fail](fail.message("lower: comptime-param callee AST unavailable")); }

    var ct_len: u32 = 0;
    var i:      u32 = 0;
    for (i < f.params_len) {
        if (origin_ast.typed_names[f.params_start + i].comptime) { ct_len = ct_len + 1; }
        i = i + 1;
    }
    if (ct_len == 0) { ret R.err[value.Value, fail.Fail](fail.message("lower: comptime-param call has no comptime parameters")); }

    val res_vals: R.Result[*comptime.CTValue, str] = A.allocate[comptime.CTValue](ctx.s.alloc, ct_len::usize);
    if (R.is_err[*comptime.CTValue, str](res_vals)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[*comptime.CTValue, str](res_vals))); }
    val vals: *comptime.CTValue = R.unwrap_ok[*comptime.CTValue, str](res_vals);
    val res_names: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](ctx.s.alloc, ct_len::usize);
    if (R.is_err[*intern.StrId, str](res_names)) {
        A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
        ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[*intern.StrId, str](res_names)));
    }
    val names: *intern.StrId = R.unwrap_ok[*intern.StrId, str](res_names);

    var dst: u32 = 0;
    var ii:  u32 = 0;
    for (ii < f.params_len) {
        val tn: *decl.TypedName = ?origin_ast.typed_names[f.params_start + ii];
        if (tn.comptime) {
            if (ii >= e.data.call.args_len) {
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret R.err[value.Value, fail.Fail](fail.message("lower: comptime-param call argument index out of range"));
            }
            val arg_eid: id.ExprId = ctx.scope.a.expr_ids[e.data.call.args_start + ii];
            val opt_fv: O.Option[comptime.CTValue] = fold_comptime_arg(ctx, arg_eid);
            if (O.is_none[comptime.CTValue](opt_fv)) {
                val arg_span: token.Span = expr_span_of(ctx, arg_eid);
                diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, arg_span, "comptime argument is not a compile-time constant");
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret R.err[value.Value, fail.Fail](fail.reported());
            }
            vals[dst] = O.unwrap[comptime.CTValue](opt_fv);

            val opt_src: O.Option[*source.SourceFile] = source.get(?ctx.s.sources, origin_ast.file_id);
            if (O.is_none[*source.SourceFile](opt_src)) {
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret R.err[value.Value, fail.Fail](fail.message("lower: comptime-param callee origin module source unavailable"));
            }
            val origin_text: str = O.unwrap[*source.SourceFile](opt_src).text;
            val res_name: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, origin_text, tn.name);
            if (R.is_err[intern.StrId, str](res_name)) {
                A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
                A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
                ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name)));
            }
            names[dst] = R.unwrap_ok[intern.StrId, str](res_name);
            dst = dst + 1;
        }
        ii = ii + 1;
    }

    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    val res_link: R.Result[intern.StrId, fail.Fail] = mangle.value_instance_name(ctx.s, fqn, sym.canon, vals, ct_len);
    if (R.is_err[intern.StrId, fail.Fail](res_link)) {
        A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
        A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
        ret R.err[value.Value, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_link));
    }
    val link: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_link);

    val res_enq: R.Result[R.Void, fail.Fail] = context.enqueue_value_instance(ctx, sym.decl, sym.origin, vals, names, ct_len, link);
    A.deallocate[comptime.CTValue](ctx.s.alloc, vals, ct_len::usize);
    A.deallocate[intern.StrId](ctx.s.alloc, names, ct_len::usize);
    if (R.is_err[R.Void, fail.Fail](res_enq)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_enq)); }

    val res_sig: R.Result[ir_type.IrTypeId, fail.Fail] = context.instance_ref_sig(ctx, sym.decl, sym.origin, nil, 0);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_sig)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_sig)); }
    ret fn_reference(ctx, link, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_sig), false);
}

fun fold_comptime_arg(ctx: *context.LowerContext, eid: id.ExprId) O.Option[comptime.CTValue] {
    val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner,
                                     context.expr_float_width(ctx, eid));
    context.record_eval_result(ctx, res_eval);
    if (R.is_ok[comptime.CTValue, comptime.EvalFail](res_eval)) {
        ret O.some[comptime.CTValue](R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval));
    }

    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret O.none[comptime.CTValue](); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);
    if (sym.kind != resolve.SYM_VAL && sym.kind != resolve.SYM_IMPORTED) { ret O.none[comptime.CTValue](); }

    val dctx: *comptime.ComptimeCtx = context.declaring_comptime_ctx(ctx, sym);
    if (dctx == nil) { ret O.none[comptime.CTValue](); }
    val opt_nc: O.Option[comptime.NamedConst] = comptime.lookup(dctx, sym.name);
    if (O.is_none[comptime.NamedConst](opt_nc)) { ret O.none[comptime.CTValue](); }
    val named: comptime.NamedConst = O.unwrap[comptime.NamedConst](opt_nc);
    if (named.gated && ctx.scope.env.union_build) {
        val msg: str = context.gated_lower_member_const_message(ctx, sym.name, session.module_fqn(ctx.s, sym.origin));
        context.report_gate(ctx, expr_span_of(ctx, eid), msg);
        ret O.none[comptime.CTValue]();
    }
    ret O.some[comptime.CTValue](named.value);
}

fun expr_span_of(ctx: *context.LowerContext, eid: id.ExprId) token.Span {
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_some[*expr.Expr](opt_e)) { ret O.unwrap[*expr.Expr](opt_e).span; }
    var s: token.Span;
    s.offset = 0;
    s.len    = 0;
    ret s;
}

fun report_expr(ctx: *context.LowerContext, eid: id.ExprId, message: str) R.Result[value.Value, fail.Fail] {
    diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, expr_span_of(ctx, eid), message);
    ret R.err[value.Value, fail.Fail](fail.reported());
}

fun field_type_arg_of(ctx: *context.LowerContext, tid: id.TypeId) O.Option[type.TypeId] {
    val t_opt: O.Option[*atype.Type] = ast.get_type(ctx.scope.a, tid);
    if (O.is_none[*atype.Type](t_opt)) { ret O.none[type.TypeId](); }
    val t: *atype.Type = O.unwrap[*atype.Type](t_opt);

    if (t.kind == atype.TYPE_KIND_POINTEE_OF) {
        val inner: O.Option[type.TypeId] = field_type_arg_of(ctx, t.data.pointee_of.inner);
        if (O.is_none[type.TypeId](inner)) { ret O.none[type.TypeId](); }
        ret O.some[type.TypeId](pointee_or_error(ctx, O.unwrap[type.TypeId](inner)));
    }

    if (t.kind != atype.TYPE_KIND_FIELD_TYPE) { ret O.none[type.TypeId](); }

    val r: R.Result[intern.StrId, str] =
        intern.intern_span(?ctx.s.interner, context.module_source(ctx), t.data.field_type.var_name);
    if (R.is_err[intern.StrId, str](r)) { fail.internal(?ctx.status, R.unwrap_err[intern.StrId, str](r)); ret O.none[type.TypeId](); }
    val gr: R.Result[O.Option[u32], comptime.EvalFail] = comptime.field_type_of_binding[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, R.unwrap_ok[intern.StrId, str](r));
    if (R.is_err[O.Option[u32], comptime.EvalFail](gr)) {
        val f: comptime.EvalFail = R.unwrap_err[O.Option[u32], comptime.EvalFail](gr);
        if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?ctx.status, f.message); }
        ret O.none[type.TypeId]();
    }
    val got: O.Option[u32] = R.unwrap_ok[O.Option[u32], comptime.EvalFail](gr);
    if (O.is_none[u32](got)) { ret O.none[type.TypeId](); }
    ret O.some[type.TypeId](O.unwrap[u32](got)::type.TypeId);
}

fun pointee_or_error(ctx: *context.LowerContext, t: type.TypeId) type.TypeId {
    if (type.is_secret(?ctx.s.types, t)) { ret type.TYPE_ERROR; }
    val ty_opt: O.Option[*type.Type] = type.get(?ctx.s.types, t);
    if (O.is_none[*type.Type](ty_opt)) { ret type.TYPE_ERROR; }
    val ty: *type.Type = O.unwrap[*type.Type](ty_opt);
    if (ty.kind != type.TYPE_POINTER) { ret type.TYPE_ERROR; }
    ret ty.data.pointer.base;
}

fun collect_call_type_args(ctx: *context.LowerContext, e: *expr.Expr, argc: u32) R.Result[*type.TypeId, fail.Fail] {
    if (argc == 0) { ret R.ok[*type.TypeId, fail.Fail](nil); }

    val res_args: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](ctx.s.alloc, argc::usize);
    if (R.is_err[*type.TypeId, str](res_args)) { ret fail.lift[*type.TypeId](res_args); }
    val args: *type.TypeId = R.unwrap_ok[*type.TypeId, str](res_args);

    var i: u32 = 0;
    for (i < argc) {
        val pool_ix: u32 = e.data.call.type_args_start + i;
        if (pool_ix::usize >= ctx.scope.a.type_id_len) {
            A.deallocate[type.TypeId](ctx.s.alloc, args, argc::usize);
            ret R.err[*type.TypeId, fail.Fail](fail.message("lower: call type-argument index out of range"));
        }
        var at: type.TypeId = type.TYPE_ERROR;
        val ft: O.Option[type.TypeId] = field_type_arg_of(ctx, ctx.scope.a.type_ids[pool_ix]);
        if (O.is_some[type.TypeId](ft)) {
            at = O.unwrap[type.TypeId](ft);
        }
        or {
            at = context.type_resolved_of(ctx, ctx.scope.a.type_ids[pool_ix]);
        }
        if (ctx.scope.subst != nil && ctx.scope.subst_len > 0) {
            at = context.recover_type(ctx, generics.substitute(ctx.s, at, ctx.scope.subst, ctx.scope.subst_len));
        }
        args[i] = at;
        i = i + 1;
    }
    ret R.ok[*type.TypeId, fail.Fail](args);
}

fun lower_generic_instance(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, e.data.call.callee);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: unresolved generic call target"));
    }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);

    val argc: u32 = e.data.call.type_args_len;
    val res_args: R.Result[*type.TypeId, fail.Fail] = collect_call_type_args(ctx, e, argc);
    if (R.is_err[*type.TypeId, fail.Fail](res_args)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[*type.TypeId, fail.Fail](res_args)); }
    val args: *type.TypeId = R.unwrap_ok[*type.TypeId, fail.Fail](res_args);

    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    val res_link: R.Result[intern.StrId, fail.Fail] = mangle.instance_name(ctx.s, fqn, sym.canon, args, argc);
    if (R.is_err[intern.StrId, fail.Fail](res_link)) {
        free_type_args(ctx, args, argc);
        ret R.err[value.Value, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_link));
    }
    val link: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_link);

    val res_enq: R.Result[R.Void, fail.Fail] = context.enqueue_instance(ctx, sym.decl, sym.origin, args, argc, link, sym.name);
    if (R.is_err[R.Void, fail.Fail](res_enq)) {
        free_type_args(ctx, args, argc);
        ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_enq));
    }

    val res_sig: R.Result[ir_type.IrTypeId, fail.Fail] = context.instance_ref_sig(ctx, sym.decl, sym.origin, args, argc);
    free_type_args(ctx, args, argc);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_sig)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_sig)); }
    ret fn_reference(ctx, link, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_sig), false);
}

fun lower_pack_callee(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr, f: *decl.DeclFun) R.Result[value.Value, fail.Fail] {
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, e.data.call.callee);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) {
        ret R.err[value.Value, fail.Fail](fail.message("lower: unresolved pack-tailed call target"));
    }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);

    val argc: u32 = e.data.call.type_args_len;
    val res_args: R.Result[*type.TypeId, fail.Fail] = collect_call_type_args(ctx, e, argc);
    if (R.is_err[*type.TypeId, fail.Fail](res_args)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[*type.TypeId, fail.Fail](res_args)); }
    val args: *type.TypeId = R.unwrap_ok[*type.TypeId, fail.Fail](res_args);

    val fixed_len:  u32         = f.params_len - 1;
    var elem_len:   u32         = 0;
    var types:      *type.TypeId = nil;
    var owns_types: bool        = false;

    if (call_has_spread(ctx, e)) {
        elem_len = ctx.pack_len;
        types    = ctx.pack_types;
    } or {
        if (e.data.call.args_len < fixed_len) {
            free_type_args(ctx, args, argc);
            ret R.err[value.Value, fail.Fail](fail.message("lower: pack-tailed call has fewer arguments than fixed parameters"));
        }
        elem_len = e.data.call.args_len - fixed_len;
        if (elem_len > 0) {
            val res_types: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](ctx.s.alloc, elem_len::usize);
            if (R.is_err[*type.TypeId, str](res_types)) {
                free_type_args(ctx, args, argc);
                ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[*type.TypeId, str](res_types)));
            }
            types      = R.unwrap_ok[*type.TypeId, str](res_types);
            owns_types = true;

            var i: u32 = 0;
            for (i < elem_len) {
                val pool_ix: u32 = e.data.call.args_start + fixed_len + i;
                if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
                    A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize);
                    free_type_args(ctx, args, argc);
                    ret R.err[value.Value, fail.Fail](fail.message("lower: pack-tailed call argument index out of range"));
                }
                val arg_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
                var et: type.TypeId = context.expr_type_of(ctx, arg_eid);
                if (ctx.scope.subst != nil && ctx.scope.subst_len > 0) {
                    et = context.recover_type(ctx, generics.substitute(ctx.s, et, ctx.scope.subst, ctx.scope.subst_len));
                }
                types[i] = et;
                i = i + 1;
            }
        }
    }

    val fqn: intern.StrId = session.module_fqn(ctx.s, sym.origin);
    val res_link: R.Result[intern.StrId, fail.Fail] = mangle.pack_instance_name(ctx.s, fqn, sym.canon, args, argc, types, elem_len);
    if (R.is_err[intern.StrId, fail.Fail](res_link)) {
        if (owns_types && types != nil) { A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize); }
        free_type_args(ctx, args, argc);
        ret R.err[value.Value, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_link));
    }
    val link: intern.StrId = R.unwrap_ok[intern.StrId, fail.Fail](res_link);

    val res_enq: R.Result[R.Void, fail.Fail] = context.enqueue_pack_instance(ctx, sym.decl, sym.origin, args, argc, types, elem_len, link);
    if (R.is_err[R.Void, fail.Fail](res_enq)) {
        if (owns_types && types != nil) { A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize); }
        free_type_args(ctx, args, argc);
        ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_enq));
    }

    val res_sig: R.Result[ir_type.IrTypeId, fail.Fail] = context.pack_instance_ref_sig(ctx, sym.decl, sym.origin, args, argc, types, elem_len);
    if (owns_types && types != nil)   { A.deallocate[type.TypeId](ctx.s.alloc, types, elem_len::usize); }
    free_type_args(ctx, args, argc);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_sig)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_sig)); }
    ret fn_reference(ctx, link, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_sig), false);
}

fun free_type_args(ctx: *context.LowerContext, args: *type.TypeId, argc: u32) {
    if (args != nil && argc > 0) { A.deallocate[type.TypeId](ctx.s.alloc, args, argc::usize); }
}

fun lower_binary(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val op: expr.BinOp = e.data.binary.op;

    if (op == expr.BIN_ASSIGN)                   { ret lower_assign(ctx, e); }
    if (op == expr.BIN_AND || op == expr.BIN_OR) { ret lower_logical(ctx, e); }

    val res_lhs: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (R.is_err[value.Value, fail.Fail](res_lhs)) { ret res_lhs; }
    var lhs: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_lhs);

    val res_rhs: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (R.is_err[value.Value, fail.Fail](res_rhs)) { ret res_rhs; }
    var rhs: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_rhs);

    val lty:    type.TypeId = context.expr_type_of(ctx, e.data.binary.lhs);
    val rty:    type.TypeId = context.expr_type_of(ctx, e.data.binary.rhs);
    val signed: bool        = is_signed_type(ctx, lty);

    if (type.is_vector(?ctx.s.types, lty)) {
        ret lower_vector_binary(ctx, op, lhs, rhs, lty);
    }

    if (is_compare_binop(op)) { ret lower_cmp(ctx, op, lhs, lty, rhs, rty); }

    if (op == expr.BIN_ADD) { ret fail.lift[value.Value](builder.emit_add(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_SUB) { ret fail.lift[value.Value](builder.emit_sub(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_MUL) { ret fail.lift[value.Value](builder.emit_mul(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_DIV) {
        if (signed) { ret fail.lift[value.Value](builder.emit_div_s(?ctx.builder, lhs, rhs)); }
        ret fail.lift[value.Value](builder.emit_div_u(?ctx.builder, lhs, rhs));
    }
    if (op == expr.BIN_MOD) {
        if (is_float_type(ctx, lty)) { ret lower_float_rem(ctx, lhs, rhs); }
        if (signed)                  { ret fail.lift[value.Value](builder.emit_rem_s(?ctx.builder, lhs, rhs)); }
        ret fail.lift[value.Value](builder.emit_rem_u(?ctx.builder, lhs, rhs));
    }
    if (op == expr.BIN_BIT_AND) { ret fail.lift[value.Value](builder.emit_and(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_BIT_OR)  { ret fail.lift[value.Value](builder.emit_or(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_BIT_XOR) { ret fail.lift[value.Value](builder.emit_xor(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_SHL)     { ret fail.lift[value.Value](builder.emit_shl(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_SHR) {
        if (signed) { ret fail.lift[value.Value](builder.emit_shr_s(?ctx.builder, lhs, rhs)); }
        ret fail.lift[value.Value](builder.emit_shr_u(?ctx.builder, lhs, rhs));
    }

    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported binary operator"));
}

fun lower_vector_binary(ctx: *context.LowerContext, op: expr.BinOp, lhs: value.Value, rhs: value.Value, lty: type.TypeId) R.Result[value.Value, fail.Fail] {
    if (is_compare_binop(op)) { ret lower_vector_compare(ctx, op, lhs, rhs, vector_lane_signed(ctx, lty)); }

    if (op == expr.BIN_ADD)     { ret fail.lift[value.Value](builder.emit_add(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_SUB)     { ret fail.lift[value.Value](builder.emit_sub(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_MUL)     { ret fail.lift[value.Value](builder.emit_mul(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_DIV)     { ret fail.lift[value.Value](builder.emit_div_u(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_BIT_AND) { ret fail.lift[value.Value](builder.emit_and(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_BIT_OR)  { ret fail.lift[value.Value](builder.emit_or(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_BIT_XOR) { ret fail.lift[value.Value](builder.emit_xor(?ctx.builder, lhs, rhs)); }

    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported vector binary operator"));
}

fun lower_vector_compare(ctx: *context.LowerContext, op: expr.BinOp, lhs: value.Value, rhs: value.Value, signed: bool) R.Result[value.Value, fail.Fail] {
    val res_mask: R.Result[ir_type.IrTypeId, fail.Fail] = vector_mask_ir(ctx, lhs.ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_mask)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_mask)); }
    val mask: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_mask);

    if (op == expr.BIN_EQ)  { ret fail.lift[value.Value](builder.emit_vcompare(?ctx.builder, instruction.OP_CMP_EQ, lhs, rhs, mask)); }
    if (op == expr.BIN_NEQ) { ret fail.lift[value.Value](builder.emit_vcompare(?ctx.builder, instruction.OP_CMP_NE, lhs, rhs, mask)); }
    if (op == expr.BIN_LT)  { ret fail.lift[value.Value](builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), lhs, rhs, mask)); }
    if (op == expr.BIN_LEQ) { ret fail.lift[value.Value](builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), lhs, rhs, mask)); }
    if (op == expr.BIN_GT)  { ret fail.lift[value.Value](builder.emit_vcompare(?ctx.builder, vec_cmp_lt(signed), rhs, lhs, mask)); }
    if (op == expr.BIN_GEQ) { ret fail.lift[value.Value](builder.emit_vcompare(?ctx.builder, vec_cmp_le(signed), rhs, lhs, mask)); }
    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported vector comparison operator"));
}

fun vec_cmp_lt(signed: bool) instruction.InstrKind {
    if (signed) { ret instruction.OP_CMP_LT_S; }
    ret instruction.OP_CMP_LT_U;
}

fun vec_cmp_le(signed: bool) instruction.InstrKind {
    if (signed) { ret instruction.OP_CMP_LE_S; }
    ret instruction.OP_CMP_LE_U;
}

fun vector_lane_signed(ctx: *context.LowerContext, lty: type.TypeId) bool {
    val base: type.TypeId = type.strip_secret(?ctx.s.types, lty);
    ret type.prim_desc(type.vector_element(?ctx.s.types, base)).signed;
}

fun vector_mask_ir(ctx: *context.LowerContext, vec_ir: ir_type.IrTypeId) R.Result[ir_type.IrTypeId, fail.Fail] {
    val opt_v: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, vec_ir);
    if (O.is_none[*ir_type.IrType](opt_v)) { ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("lower: vector compare operand is not an IR vector")); }
    val vt: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_v);
    if (vt.kind != ir_type.IRT_VECTOR) { ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("lower: vector compare operand is not an IR vector")); }

    val opt_e: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, vt.data.vector_.element);
    if (O.is_none[*ir_type.IrType](opt_e)) { ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("lower: vector element type not resolvable")); }
    val lane_bits: u32 = O.unwrap[*ir_type.IrType](opt_e).data.bits;
    val lanes:     u32 = vt.data.vector_.lanes;

    val res_elem: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, lane_bits);
    if (R.is_err[ir_type.IrTypeId, str](res_elem)) { ret fail.lift[ir_type.IrTypeId](res_elem); }
    ret fail.lift[ir_type.IrTypeId](ir_type.intern_vector(?ctx.m.types, R.unwrap_ok[ir_type.IrTypeId, str](res_elem), lanes));
}

fun float_rem_narrow(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value) R.Result[value.Value, fail.Fail] {
    val res_i64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_i64)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_i64))); }
    val i64ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i64);

    val res_q: R.Result[value.Value, str] = builder.emit_div_u(?ctx.builder, lhs, rhs);
    if (R.is_err[value.Value, str](res_q)) { ret fail.lift[value.Value](res_q); }
    val q: value.Value = R.unwrap_ok[value.Value, str](res_q);

    val res_qi: R.Result[value.Value, str] = builder.emit_fp_to_si(?ctx.builder, q, i64ty);
    if (R.is_err[value.Value, str](res_qi)) { ret fail.lift[value.Value](res_qi); }
    val qi: value.Value = R.unwrap_ok[value.Value, str](res_qi);

    val res_qf: R.Result[value.Value, str] = builder.emit_si_to_fp(?ctx.builder, qi, lhs.ty);
    if (R.is_err[value.Value, str](res_qf)) { ret fail.lift[value.Value](res_qf); }
    val qf: value.Value = R.unwrap_ok[value.Value, str](res_qf);

    val res_prod: R.Result[value.Value, str] = builder.emit_mul(?ctx.builder, qf, rhs);
    if (R.is_err[value.Value, str](res_prod)) { ret fail.lift[value.Value](res_prod); }
    val prod: value.Value = R.unwrap_ok[value.Value, str](res_prod);

    ret fail.lift[value.Value](builder.emit_sub(?ctx.builder, lhs, prod));
}

fun float_abs(ctx: *context.LowerContext, v: value.Value, zero: value.Value) R.Result[value.Value, fail.Fail] {
    val res_neg: R.Result[value.Value, str] = builder.emit_cmp_lt_u(?ctx.builder, v, zero);
    if (R.is_err[value.Value, str](res_neg)) { ret fail.lift[value.Value](res_neg); }
    val is_neg: value.Value = R.unwrap_ok[value.Value, str](res_neg);

    val res_bneg: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bneg)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bneg))); }
    val blk_neg: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bneg);

    val res_bpos: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bpos)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bpos))); }
    val blk_pos: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bpos);

    val res_bmerge: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bmerge)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bmerge))); }
    val blk_merge: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bmerge);

    val res_cbr: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, is_neg, blk_neg, blk_pos);
    if (R.is_err[R.Void, str](res_cbr)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr))); }

    builder.set_block(?ctx.builder, blk_neg);
    val res_negated: R.Result[value.Value, str] = builder.emit_sub(?ctx.builder, zero, v);
    if (R.is_err[value.Value, str](res_negated)) { ret fail.lift[value.Value](res_negated); }
    val negated: value.Value = R.unwrap_ok[value.Value, str](res_negated);
    val res_br1: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_merge);
    if (R.is_err[R.Void, str](res_br1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_br1))); }

    builder.set_block(?ctx.builder, blk_pos);
    val res_br2: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_merge);
    if (R.is_err[R.Void, str](res_br2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_br2))); }

    builder.set_block(?ctx.builder, blk_merge);
    val res_phi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, v.ty);
    if (R.is_err[value.Value, str](res_phi)) { ret fail.lift[value.Value](res_phi); }
    val phi: value.Value = R.unwrap_ok[value.Value, str](res_phi);
    val res_in1: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, phi, blk_neg, negated);
    if (R.is_err[R.Void, str](res_in1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_in1))); }
    val res_in2: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, phi, blk_pos, v);
    if (R.is_err[R.Void, str](res_in2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_in2))); }

    ret R.ok[value.Value, fail.Fail](phi);
}

fun float_rem_reduce(ctx: *context.LowerContext, x0: value.Value, y: value.Value, two: value.Value) R.Result[value.Value, fail.Fail] {
    val fty: ir_type.IrTypeId = x0.ty;

    val res_xhalf: R.Result[value.Value, str] = builder.emit_div_u(?ctx.builder, x0, two);
    if (R.is_err[value.Value, str](res_xhalf)) { ret fail.lift[value.Value](res_xhalf); }
    val x_half: value.Value = R.unwrap_ok[value.Value, str](res_xhalf);

    val blk_entry: ir.BlockId = ctx.builder.block;

    val res_l1h: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l1h)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l1h))); }
    val l1_head: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l1h);

    val res_l1b: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l1b)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l1b))); }
    val l1_body: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l1b);

    val res_l1e: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l1e)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l1e))); }
    val l1_exit: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l1e);

    val res_enter1: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, l1_head);
    if (R.is_err[R.Void, str](res_enter1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_enter1))); }

    builder.set_block(?ctx.builder, l1_head);
    val res_ykphi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, fty);
    if (R.is_err[value.Value, str](res_ykphi)) { ret fail.lift[value.Value](res_ykphi); }
    val yk_phi1: value.Value = R.unwrap_ok[value.Value, str](res_ykphi);
    val res_c1: R.Result[value.Value, str] = builder.emit_cmp_le_u(?ctx.builder, yk_phi1, x_half);
    if (R.is_err[value.Value, str](res_c1)) { ret fail.lift[value.Value](res_c1); }
    val res_cbr1: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, R.unwrap_ok[value.Value, str](res_c1), l1_body, l1_exit);
    if (R.is_err[R.Void, str](res_cbr1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr1))); }

    builder.set_block(?ctx.builder, l1_body);
    val res_ykn: R.Result[value.Value, str] = builder.emit_mul(?ctx.builder, yk_phi1, two);
    if (R.is_err[value.Value, str](res_ykn)) { ret fail.lift[value.Value](res_ykn); }
    val yk_next1: value.Value = R.unwrap_ok[value.Value, str](res_ykn);
    val res_back1: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, l1_head);
    if (R.is_err[R.Void, str](res_back1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_back1))); }

    val res_i1a: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, yk_phi1, blk_entry, y);
    if (R.is_err[R.Void, str](res_i1a)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i1a))); }
    val res_i1b: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, yk_phi1, l1_body, yk_next1);
    if (R.is_err[R.Void, str](res_i1b)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i1b))); }

    builder.set_block(?ctx.builder, l1_exit);

    val res_l2h: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l2h)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l2h))); }
    val l2_head: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l2h);

    val res_l2s: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l2s)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l2s))); }
    val l2_sub: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l2s);

    val res_l2n: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l2n)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l2n))); }
    val l2_nosub: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l2n);

    val res_l2m: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l2m)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l2m))); }
    val l2_merge: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l2m);

    val res_l2e: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l2e)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l2e))); }
    val l2_exit: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l2e);

    val res_l2g: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_l2g)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_l2g))); }
    val l2_sub_gate: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_l2g);

    val res_enter2: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, l2_head);
    if (R.is_err[R.Void, str](res_enter2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_enter2))); }

    builder.set_block(?ctx.builder, l2_head);
    val res_xphi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, fty);
    if (R.is_err[value.Value, str](res_xphi)) { ret fail.lift[value.Value](res_xphi); }
    val x_phi: value.Value = R.unwrap_ok[value.Value, str](res_xphi);
    val res_ykphi2: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, fty);
    if (R.is_err[value.Value, str](res_ykphi2)) { ret fail.lift[value.Value](res_ykphi2); }
    val yk_phi2: value.Value = R.unwrap_ok[value.Value, str](res_ykphi2);
    val res_c2: R.Result[value.Value, str] = builder.emit_cmp_le_u(?ctx.builder, y, yk_phi2);
    if (R.is_err[value.Value, str](res_c2)) { ret fail.lift[value.Value](res_c2); }
    val res_cbr2: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, R.unwrap_ok[value.Value, str](res_c2), l2_sub_gate, l2_exit);
    if (R.is_err[R.Void, str](res_cbr2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr2))); }

    builder.set_block(?ctx.builder, l2_sub_gate);
    val res_c3: R.Result[value.Value, str] = builder.emit_cmp_le_u(?ctx.builder, yk_phi2, x_phi);
    if (R.is_err[value.Value, str](res_c3)) { ret fail.lift[value.Value](res_c3); }
    val res_cbr3: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, R.unwrap_ok[value.Value, str](res_c3), l2_sub, l2_nosub);
    if (R.is_err[R.Void, str](res_cbr3)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr3))); }

    builder.set_block(?ctx.builder, l2_sub);
    val res_xsub: R.Result[value.Value, str] = builder.emit_sub(?ctx.builder, x_phi, yk_phi2);
    if (R.is_err[value.Value, str](res_xsub)) { ret fail.lift[value.Value](res_xsub); }
    val x_subbed: value.Value = R.unwrap_ok[value.Value, str](res_xsub);
    val res_brs: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, l2_merge);
    if (R.is_err[R.Void, str](res_brs)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_brs))); }

    builder.set_block(?ctx.builder, l2_nosub);
    val res_brn2: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, l2_merge);
    if (R.is_err[R.Void, str](res_brn2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_brn2))); }

    builder.set_block(?ctx.builder, l2_merge);
    val res_xnphi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, fty);
    if (R.is_err[value.Value, str](res_xnphi)) { ret fail.lift[value.Value](res_xnphi); }
    val x_next: value.Value = R.unwrap_ok[value.Value, str](res_xnphi);
    val res_i3a: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, x_next, l2_sub, x_subbed);
    if (R.is_err[R.Void, str](res_i3a)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i3a))); }
    val res_i3b: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, x_next, l2_nosub, x_phi);
    if (R.is_err[R.Void, str](res_i3b)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i3b))); }

    val res_yknext2: R.Result[value.Value, str] = builder.emit_div_u(?ctx.builder, yk_phi2, two);
    if (R.is_err[value.Value, str](res_yknext2)) { ret fail.lift[value.Value](res_yknext2); }
    val yk_next2: value.Value = R.unwrap_ok[value.Value, str](res_yknext2);
    val res_back2: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, l2_head);
    if (R.is_err[R.Void, str](res_back2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_back2))); }

    val res_i2a: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, x_phi, l1_exit, x0);
    if (R.is_err[R.Void, str](res_i2a)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i2a))); }
    val res_i2b: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, x_phi, l2_merge, x_next);
    if (R.is_err[R.Void, str](res_i2b)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i2b))); }
    val res_i2c: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, yk_phi2, l1_exit, yk_phi1);
    if (R.is_err[R.Void, str](res_i2c)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i2c))); }
    val res_i2d: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, yk_phi2, l2_merge, yk_next2);
    if (R.is_err[R.Void, str](res_i2d)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i2d))); }

    builder.set_block(?ctx.builder, l2_exit);
    ret R.ok[value.Value, fail.Fail](x_phi);
}

fun float_rem_general(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value, zero: value.Value, two: value.Value) R.Result[value.Value, fail.Fail] {
    val res_aneg: R.Result[value.Value, str] = builder.emit_cmp_lt_u(?ctx.builder, lhs, zero);
    if (R.is_err[value.Value, str](res_aneg)) { ret fail.lift[value.Value](res_aneg); }
    val a_neg: value.Value = R.unwrap_ok[value.Value, str](res_aneg);

    val res_x0: R.Result[value.Value, fail.Fail] = float_abs(ctx, lhs, zero);
    if (R.is_err[value.Value, fail.Fail](res_x0)) { ret res_x0; }
    val x0: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_x0);

    val res_y: R.Result[value.Value, fail.Fail] = float_abs(ctx, rhs, zero);
    if (R.is_err[value.Value, fail.Fail](res_y)) { ret res_y; }
    val y: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_y);

    val res_reduced: R.Result[value.Value, fail.Fail] = float_rem_reduce(ctx, x0, y, two);
    if (R.is_err[value.Value, fail.Fail](res_reduced)) { ret res_reduced; }
    val reduced: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_reduced);

    val res_bneg: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bneg)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bneg))); }
    val blk_neg: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bneg);

    val res_bpos: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bpos)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bpos))); }
    val blk_pos: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bpos);

    val res_bmerge: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bmerge)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bmerge))); }
    val blk_merge: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bmerge);

    val res_cbr: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, a_neg, blk_neg, blk_pos);
    if (R.is_err[R.Void, str](res_cbr)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr))); }

    builder.set_block(?ctx.builder, blk_neg);
    val res_negr: R.Result[value.Value, str] = builder.emit_neg(?ctx.builder, reduced);
    if (R.is_err[value.Value, str](res_negr)) { ret fail.lift[value.Value](res_negr); }
    val neg_reduced: value.Value = R.unwrap_ok[value.Value, str](res_negr);
    val res_br1: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_merge);
    if (R.is_err[R.Void, str](res_br1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_br1))); }

    builder.set_block(?ctx.builder, blk_pos);
    val res_br2: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_merge);
    if (R.is_err[R.Void, str](res_br2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_br2))); }

    builder.set_block(?ctx.builder, blk_merge);
    val res_phi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, lhs.ty);
    if (R.is_err[value.Value, str](res_phi)) { ret fail.lift[value.Value](res_phi); }
    val phi: value.Value = R.unwrap_ok[value.Value, str](res_phi);
    val res_in1: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, phi, blk_neg, neg_reduced);
    if (R.is_err[R.Void, str](res_in1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_in1))); }
    val res_in2: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, phi, blk_pos, reduced);
    if (R.is_err[R.Void, str](res_in2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_in2))); }

    ret R.ok[value.Value, fail.Fail](phi);
}

fun float_rem_needs_narrow(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value, zero: value.Value, two: value.Value) R.Result[value.Value, fail.Fail] {
    val res_bzero: R.Result[value.Value, str] = builder.emit_cmp_eq(?ctx.builder, rhs, zero);
    if (R.is_err[value.Value, str](res_bzero)) { ret fail.lift[value.Value](res_bzero); }
    val b_zero: value.Value = R.unwrap_ok[value.Value, str](res_bzero);
    val blk_entry: ir.BlockId = ctx.builder.block;

    val res_check: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_check)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_check))); }
    val blk_check: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_check);
    val res_nonzero: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_nonzero)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_nonzero))); }
    val blk_nonzero: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_nonzero);
    val res_inner: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_inner)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_inner))); }
    val blk_inner: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_inner);
    val res_outer: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_outer)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_outer))); }
    val blk_outer: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_outer);

    val res_cbr0: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, b_zero, blk_outer, blk_check);
    if (R.is_err[R.Void, str](res_cbr0)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr0))); }
    builder.set_block(?ctx.builder, blk_check);
    val res_a2: R.Result[value.Value, str] = builder.emit_mul(?ctx.builder, lhs, two);
    if (R.is_err[value.Value, str](res_a2)) { ret fail.lift[value.Value](res_a2); }
    val a2: value.Value = R.unwrap_ok[value.Value, str](res_a2);
    val res_eqa2: R.Result[value.Value, str] = builder.emit_cmp_eq(?ctx.builder, lhs, a2);
    if (R.is_err[value.Value, str](res_eqa2)) { ret fail.lift[value.Value](res_eqa2); }
    val a_eq_2a: value.Value = R.unwrap_ok[value.Value, str](res_eqa2);
    val res_cbr1: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, a_eq_2a, blk_nonzero, blk_inner);
    if (R.is_err[R.Void, str](res_cbr1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr1))); }

    builder.set_block(?ctx.builder, blk_nonzero);
    val res_ne: R.Result[value.Value, str] = builder.emit_cmp_ne(?ctx.builder, lhs, zero);
    if (R.is_err[value.Value, str](res_ne)) { ret fail.lift[value.Value](res_ne); }
    val a_ne_zero: value.Value = R.unwrap_ok[value.Value, str](res_ne);
    val res_br_inner: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_inner);
    if (R.is_err[R.Void, str](res_br_inner)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_br_inner))); }

    builder.set_block(?ctx.builder, blk_inner);
    val res_iphi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, b_zero.ty);
    if (R.is_err[value.Value, str](res_iphi)) { ret fail.lift[value.Value](res_iphi); }
    val inner: value.Value = R.unwrap_ok[value.Value, str](res_iphi);
    val res_i0: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, inner, blk_check, a_eq_2a);
    if (R.is_err[R.Void, str](res_i0)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i0))); }
    val res_i1: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, inner, blk_nonzero, a_ne_zero);
    if (R.is_err[R.Void, str](res_i1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_i1))); }
    val res_br_outer: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_outer);
    if (R.is_err[R.Void, str](res_br_outer)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_br_outer))); }

    builder.set_block(?ctx.builder, blk_outer);
    val res_ophi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, b_zero.ty);
    if (R.is_err[value.Value, str](res_ophi)) { ret fail.lift[value.Value](res_ophi); }
    val outer: value.Value = R.unwrap_ok[value.Value, str](res_ophi);
    val res_o0: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, outer, blk_entry, b_zero);
    if (R.is_err[R.Void, str](res_o0)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_o0))); }
    val res_o1: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, outer, blk_inner, inner);
    if (R.is_err[R.Void, str](res_o1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_o1))); }
    ret R.ok[value.Value, fail.Fail](outer);
}

fun lower_float_rem(ctx: *context.LowerContext, lhs: value.Value, rhs: value.Value) R.Result[value.Value, fail.Fail] {
    val zero: value.Value = value.const_float(0.0, lhs.ty);
    val two: value.Value = value.const_float(2.0, lhs.ty);
    val res_narrow_needed: R.Result[value.Value, fail.Fail] = float_rem_needs_narrow(ctx, lhs, rhs, zero, two);
    if (R.is_err[value.Value, fail.Fail](res_narrow_needed)) { ret res_narrow_needed; }
    val narrow_needed: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_narrow_needed);

    val res_bn: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bn)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bn))); }
    val blk_narrow: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bn);
    val res_bg: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bg)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bg))); }
    val blk_general: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bg);
    val res_bj: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_bj)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_bj))); }
    val blk_join: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_bj);
    val res_cbr: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, narrow_needed, blk_narrow, blk_general);
    if (R.is_err[R.Void, str](res_cbr)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_cbr))); }

    builder.set_block(?ctx.builder, blk_narrow);
    val res_narrow: R.Result[value.Value, fail.Fail] = float_rem_narrow(ctx, lhs, rhs);
    if (R.is_err[value.Value, fail.Fail](res_narrow)) { ret res_narrow; }
    val narrow_result: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_narrow);
    val narrow_end: ir.BlockId = ctx.builder.block;
    val res_brn: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_join);
    if (R.is_err[R.Void, str](res_brn)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_brn))); }

    builder.set_block(?ctx.builder, blk_general);
    val res_general: R.Result[value.Value, fail.Fail] = float_rem_general(ctx, lhs, rhs, zero, two);
    if (R.is_err[value.Value, fail.Fail](res_general)) { ret res_general; }
    val general_result: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_general);
    val general_end: ir.BlockId = ctx.builder.block;
    val res_brg: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, blk_join);
    if (R.is_err[R.Void, str](res_brg)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_brg))); }

    builder.set_block(?ctx.builder, blk_join);
    val res_phi: R.Result[value.Value, str] = builder.emit_phi(?ctx.builder, lhs.ty);
    if (R.is_err[value.Value, str](res_phi)) { ret fail.lift[value.Value](res_phi); }
    val phi: value.Value = R.unwrap_ok[value.Value, str](res_phi);
    val res_in1: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, phi, narrow_end, narrow_result);
    if (R.is_err[R.Void, str](res_in1)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_in1))); }
    val res_in2: R.Result[R.Void, str] = builder.phi_add_incoming(?ctx.builder, phi, general_end, general_result);
    if (R.is_err[R.Void, str](res_in2)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_in2))); }

    ret R.ok[value.Value, fail.Fail](phi);
}

fun is_compare_binop(op: expr.BinOp) bool {
    ret op == expr.BIN_EQ  || op == expr.BIN_NEQ ||
        op == expr.BIN_LT  || op == expr.BIN_LEQ ||
        op == expr.BIN_GT  || op == expr.BIN_GEQ;
}

fun lower_cmp(ctx: *context.LowerContext, op: expr.BinOp, lhs: value.Value, lty: type.TypeId, rhs: value.Value, rty: type.TypeId) R.Result[value.Value, fail.Fail] {
    if (is_float_type(ctx, lty) || is_float_type(ctx, rty)) {
        var fl: value.Value = lhs;
        var fr: value.Value = rhs;
        val res_unify: R.Result[R.Void, fail.Fail] = unify_float_compare_widths(ctx, ?fl, lty, ?fr, rty);
        if (R.is_err[R.Void, fail.Fail](res_unify)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_unify)); }
        ret emit_cmp_int(ctx, op, false, fl, fr);
    }

    val ls: bool = is_signed_type(ctx, lty);
    val rs: bool = is_signed_type(ctx, rty);

    if (ls == rs) {
        var sl: value.Value = lhs;
        var sr: value.Value = rhs;
        val res_unify: R.Result[R.Void, fail.Fail] = unify_int_compare_widths(ctx, ?sl, lty, ?sr, rty);
        if (R.is_err[R.Void, fail.Fail](res_unify)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_unify)); }
        ret emit_cmp_int(ctx, op, ls, sl, sr);
    }

    var s_val:    value.Value = lhs;
    var s_ty:     type.TypeId = lty;
    var u_val:    value.Value = rhs;
    var u_ty:     type.TypeId = rty;
    var s_is_lhs: bool        = true;
    if (!ls) {
        s_val    = rhs;
        s_ty     = rty;
        u_val    = lhs;
        u_ty     = lty;
        s_is_lhs = false;
    }

    val res_i64: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_i64)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_i64))); }
    val ty64: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i64);

    val res_s64: R.Result[value.Value, fail.Fail] = widen_signed_to_i64(ctx, s_val, s_ty, ty64);
    if (R.is_err[value.Value, fail.Fail](res_s64)) { ret res_s64; }
    val s64: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_s64);

    if (scalar_bits(ctx, u_ty) < 64) {
        val res_u64: R.Result[value.Value, str] = builder.emit_zext(?ctx.builder, u_val, ty64);
        if (R.is_err[value.Value, str](res_u64)) { ret fail.lift[value.Value](res_u64); }
        val u64v: value.Value = R.unwrap_ok[value.Value, str](res_u64);
        if (s_is_lhs) { ret emit_cmp_int(ctx, op, true, s64, u64v); }
        ret emit_cmp_int(ctx, op, true, u64v, s64);
    }

    ret lower_cmp_signed_u64(ctx, op, s64, u_val, s_is_lhs, ty64);
}

fun emit_cmp_int(ctx: *context.LowerContext, op: expr.BinOp, signed: bool, lhs: value.Value, rhs: value.Value) R.Result[value.Value, fail.Fail] {
    if (op == expr.BIN_EQ)  { ret fail.lift[value.Value](builder.emit_cmp_eq(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_NEQ) { ret fail.lift[value.Value](builder.emit_cmp_ne(?ctx.builder, lhs, rhs)); }
    if (op == expr.BIN_LT) {
        if (signed) { ret fail.lift[value.Value](builder.emit_cmp_lt_s(?ctx.builder, lhs, rhs)); }
        ret fail.lift[value.Value](builder.emit_cmp_lt_u(?ctx.builder, lhs, rhs));
    }
    if (op == expr.BIN_LEQ) {
        if (signed) { ret fail.lift[value.Value](builder.emit_cmp_le_s(?ctx.builder, lhs, rhs)); }
        ret fail.lift[value.Value](builder.emit_cmp_le_u(?ctx.builder, lhs, rhs));
    }
    if (op == expr.BIN_GT) {
        if (signed) { ret fail.lift[value.Value](builder.emit_cmp_lt_s(?ctx.builder, rhs, lhs)); }
        ret fail.lift[value.Value](builder.emit_cmp_lt_u(?ctx.builder, rhs, lhs));
    }
    if (op == expr.BIN_GEQ) {
        if (signed) { ret fail.lift[value.Value](builder.emit_cmp_le_s(?ctx.builder, rhs, lhs)); }
        ret fail.lift[value.Value](builder.emit_cmp_le_u(?ctx.builder, rhs, lhs));
    }
    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported comparison operator"));
}

fun widen_signed_to_i64(ctx: *context.LowerContext, v: value.Value, vty: type.TypeId, ty64: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    if (scalar_bits(ctx, vty) >= 64) { ret R.ok[value.Value, fail.Fail](v); }
    ret fail.lift[value.Value](builder.emit_sext(?ctx.builder, v, ty64));
}

fun lower_cmp_signed_u64(ctx: *context.LowerContext, op: expr.BinOp, s64: value.Value, u: value.Value, s_is_lhs: bool, ty64: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    var nop: expr.BinOp = op;
    if (!s_is_lhs) { nop = swap_cmp_op(op); }
    val zero: value.Value = value.const_int(0, ty64);

    if (nop == expr.BIN_LT) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
                        builder.emit_cmp_lt_u(?ctx.builder, s64, u));
    }
    if (nop == expr.BIN_LEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
                        builder.emit_cmp_le_u(?ctx.builder, s64, u));
    }
    if (nop == expr.BIN_GT) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
                         builder.emit_cmp_lt_u(?ctx.builder, u, s64));
    }
    if (nop == expr.BIN_GEQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
                         builder.emit_cmp_le_u(?ctx.builder, u, s64));
    }
    if (nop == expr.BIN_EQ) {
        ret cmp_and(ctx, builder.emit_cmp_le_s(?ctx.builder, zero, s64),
                         builder.emit_cmp_eq(?ctx.builder, s64, u));
    }
    if (nop == expr.BIN_NEQ) {
        ret cmp_or(ctx, builder.emit_cmp_lt_s(?ctx.builder, s64, zero),
                        builder.emit_cmp_ne(?ctx.builder, s64, u));
    }
    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported comparison operator"));
}

fun swap_cmp_op(op: expr.BinOp) expr.BinOp {
    if (op == expr.BIN_LT)  { ret expr.BIN_GT; }
    if (op == expr.BIN_LEQ) { ret expr.BIN_GEQ; }
    if (op == expr.BIN_GT)  { ret expr.BIN_LT; }
    if (op == expr.BIN_GEQ) { ret expr.BIN_LEQ; }
    ret op;
}

fun cmp_or(ctx: *context.LowerContext, a: R.Result[value.Value, str], b: R.Result[value.Value, str]) R.Result[value.Value, fail.Fail] {
    if (R.is_err[value.Value, str](a)) { ret fail.lift[value.Value](a); }
    if (R.is_err[value.Value, str](b)) { ret fail.lift[value.Value](b); }
    ret fail.lift[value.Value](builder.emit_or(?ctx.builder, R.unwrap_ok[value.Value, str](a), R.unwrap_ok[value.Value, str](b)));
}

fun cmp_and(ctx: *context.LowerContext, a: R.Result[value.Value, str], b: R.Result[value.Value, str]) R.Result[value.Value, fail.Fail] {
    if (R.is_err[value.Value, str](a)) { ret fail.lift[value.Value](a); }
    if (R.is_err[value.Value, str](b)) { ret fail.lift[value.Value](b); }
    ret fail.lift[value.Value](builder.emit_and(?ctx.builder, R.unwrap_ok[value.Value, str](a), R.unwrap_ok[value.Value, str](b)));
}

fun unify_float_compare_widths(ctx: *context.LowerContext, lhs: *value.Value, lty: type.TypeId, rhs: *value.Value, rty: type.TypeId) R.Result[R.Void, fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == rw) { ret R.ok_void[fail.Fail](); }
    if (lw < rw) {
        val res_ext: R.Result[value.Value, str] = builder.emit_fp_ext(?ctx.builder, @lhs, rhs.ty);
        if (R.is_err[value.Value, str](res_ext)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_ext))); }
        @lhs = R.unwrap_ok[value.Value, str](res_ext);
        ret R.ok_void[fail.Fail]();
    }
    val res_ext: R.Result[value.Value, str] = builder.emit_fp_ext(?ctx.builder, @rhs, lhs.ty);
    if (R.is_err[value.Value, str](res_ext)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_ext))); }
    @rhs = R.unwrap_ok[value.Value, str](res_ext);
    ret R.ok_void[fail.Fail]();
}

fun unify_int_compare_widths(ctx: *context.LowerContext, lhs: *value.Value, lty: type.TypeId, rhs: *value.Value, rty: type.TypeId) R.Result[R.Void, fail.Fail] {
    val lw: u32 = scalar_bits(ctx, lty);
    val rw: u32 = scalar_bits(ctx, rty);
    if (lw == 0 || rw == 0 || lw == rw) { ret R.ok_void[fail.Fail](); }
    if (lw < rw) {
        val res_ext: R.Result[value.Value, fail.Fail] = extend_int_value(ctx, @lhs, lty, rhs.ty);
        if (R.is_err[value.Value, fail.Fail](res_ext)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_ext)); }
        @lhs = R.unwrap_ok[value.Value, fail.Fail](res_ext);
        ret R.ok_void[fail.Fail]();
    }
    val res_ext: R.Result[value.Value, fail.Fail] = extend_int_value(ctx, @rhs, rty, lhs.ty);
    if (R.is_err[value.Value, fail.Fail](res_ext)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_ext)); }
    @rhs = R.unwrap_ok[value.Value, fail.Fail](res_ext);
    ret R.ok_void[fail.Fail]();
}

fun extend_int_value(ctx: *context.LowerContext, v: value.Value, from: type.TypeId, to: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    if (is_signed_type(ctx, from)) { ret fail.lift[value.Value](builder.emit_sext(?ctx.builder, v, to)); }
    ret fail.lift[value.Value](builder.emit_zext(?ctx.builder, v, to));
}

fun lower_assign(ctx: *context.LowerContext, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_rhs: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (R.is_err[value.Value, fail.Fail](res_rhs)) { ret res_rhs; }
    val rhs: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_rhs);

    val wrote_r: R.Result[bool, fail.Fail] = lower_vector_lane_write(ctx, e.data.binary.lhs, rhs);
    if (R.is_err[bool, fail.Fail](wrote_r)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[bool, fail.Fail](wrote_r)); }
    if (R.unwrap_ok[bool, fail.Fail](wrote_r)) { ret assign_epilogue(ctx, e, rhs); }

    val res_lhs: R.Result[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.binary.lhs);
    if (R.is_err[value.Value, fail.Fail](res_lhs)) { ret res_lhs; }
    val ptr: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_lhs);

    val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, rhs, ptr);
    if (R.is_err[R.Void, str](res_store)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store))); }
    if (lvalue_is_volatile_field(ctx, e.data.binary.lhs)
        || value_is_volatile_record(ctx, e.data.binary.rhs)
        || value_is_volatile_record(ctx, e.data.binary.lhs)) { builder.mark_last_volatile(?ctx.builder); }

    ret assign_epilogue(ctx, e, rhs);
}

fun assign_epilogue(ctx: *context.LowerContext, e: *expr.Expr, rhs: value.Value) R.Result[value.Value, fail.Fail] {
    if (context.type_is_secret(ctx, context.expr_type_of(ctx, e.data.binary.lhs))) {
        builder.mark_last_secret(?ctx.builder);
    }

    if (ctx.debug) {
        val opt_lhs: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, e.data.binary.lhs);
        if (O.is_some[*expr.Expr](opt_lhs)) {
            val lhs_e: *expr.Expr = O.unwrap[*expr.Expr](opt_lhs);
            if (lhs_e.kind == expr.EXPR_KIND_IDENT) {
                val lhs_sem: type.TypeId = context.expr_type_of(ctx, e.data.binary.lhs);
                val res_dbg: R.Result[R.Void, fail.Fail] = context.emit_dbg_birth(ctx, lhs_e.span, rhs.ty, lhs_sem, false, rhs, O.none[value.Value]());
                if (R.is_err[R.Void, fail.Fail](res_dbg)) {
                    ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_dbg));
                }
            }
        }
    }
    ret R.ok[value.Value, fail.Fail](rhs);
}

fun lower_vector_lane_write(ctx: *context.LowerContext, lhs: id.ExprId, rhs: value.Value) R.Result[bool, fail.Fail] {
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, lhs);
    if (O.is_none[*expr.Expr](opt_e)) { ret R.ok[bool, fail.Fail](false); }
    val e: *expr.Expr = O.unwrap[*expr.Expr](opt_e);
    if (e.kind != expr.EXPR_KIND_INDEX) { ret R.ok[bool, fail.Fail](false); }

    val opt_lane: O.Option[R.Result[u64, fail.Fail]] = vector_lane_of(ctx, e);
    if (O.is_none[R.Result[u64, fail.Fail]](opt_lane)) { ret R.ok[bool, fail.Fail](false); }
    val lane_r: R.Result[u64, fail.Fail] = O.unwrap[R.Result[u64, fail.Fail]](opt_lane);
    if (R.is_err[u64, fail.Fail](lane_r)) { ret R.err[bool, fail.Fail](R.unwrap_err[u64, fail.Fail](lane_r)); }

    val res_slot: R.Result[value.Value, fail.Fail] = lower_lvalue(ctx, e.data.index.object);
    if (R.is_err[value.Value, fail.Fail](res_slot)) { ret R.err[bool, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_slot)); }
    val slot: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_slot);

    val res_vty: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.expr_type_of(ctx, e.data.index.object));
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_vty)) { ret R.err[bool, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_vty)); }
    val vty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_vty);

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[bool, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }

    val res_old: R.Result[value.Value, str] = builder.emit_load(?ctx.builder, slot, vty);
    if (R.is_err[value.Value, str](res_old)) { ret R.err[bool, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_old))); }

    val res_new: R.Result[value.Value, str] = builder.emit_vec_insert(?ctx.builder,
        R.unwrap_ok[value.Value, str](res_old),
        value.const_int(R.unwrap_ok[u64, fail.Fail](lane_r), R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty)),
        rhs);
    if (R.is_err[value.Value, str](res_new)) { ret R.err[bool, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_new))); }

    val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, R.unwrap_ok[value.Value, str](res_new), slot);
    if (R.is_err[R.Void, str](res_store)) { ret R.err[bool, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store))); }
    ret R.ok[bool, fail.Fail](true);
}

fun lower_logical(ctx: *context.LowerContext, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_i8: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 8);
    if (R.is_err[ir_type.IrTypeId, str](res_i8)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_i8))); }
    val i8: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_i8);

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, i8, value.const_int(1, xty));
    if (R.is_err[value.Value, str](res_slot)) { ret fail.lift[value.Value](res_slot); }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    val res_lhs: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.lhs);
    if (R.is_err[value.Value, fail.Fail](res_lhs)) { ret res_lhs; }
    val res_lhs_condition: R.Result[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.lhs, R.unwrap_ok[value.Value, fail.Fail](res_lhs));
    if (R.is_err[value.Value, fail.Fail](res_lhs_condition)) { ret res_lhs_condition; }
    val lhs: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_lhs_condition);
    val res_store_lhs: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, lhs, slot);
    if (R.is_err[R.Void, str](res_store_lhs)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store_lhs))); }

    val res_rhs_block: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_rhs_block)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_rhs_block))); }
    val rhs_block: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_rhs_block);

    val res_join: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_join)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_join))); }
    val join: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_join);

    var res_cbr: R.Result[R.Void, fail.Fail] = R.ok_void[fail.Fail]();
    if (e.data.binary.op == expr.BIN_AND) {
        res_cbr = fail.lift[R.Void](builder.emit_cbr(?ctx.builder, lhs, rhs_block, join));
    } or {
        res_cbr = fail.lift[R.Void](builder.emit_cbr(?ctx.builder, lhs, join, rhs_block));
    }
    if (R.is_err[R.Void, fail.Fail](res_cbr)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_cbr)); }

    builder.set_block(?ctx.builder, rhs_block);
    val res_rhs: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.binary.rhs);
    if (R.is_err[value.Value, fail.Fail](res_rhs)) { ret res_rhs; }
    val res_rhs_condition: R.Result[value.Value, fail.Fail] = condition_value(ctx, e.data.binary.rhs, R.unwrap_ok[value.Value, fail.Fail](res_rhs));
    if (R.is_err[value.Value, fail.Fail](res_rhs_condition)) { ret res_rhs_condition; }
    val res_store_rhs: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, R.unwrap_ok[value.Value, fail.Fail](res_rhs_condition), slot);
    if (R.is_err[R.Void, str](res_store_rhs)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store_rhs))); }
    val res_br: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, join);
    if (R.is_err[R.Void, str](res_br)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_br))); }

    builder.set_block(?ctx.builder, join);
    ret fail.lift[value.Value](builder.emit_load(?ctx.builder, slot, i8));
}

fun address_operand_names_function(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*expr.Expr](e_opt)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
    if (e.kind == expr.EXPR_KIND_GENERIC_INSTANCE) { ret true; }
    if (e.kind != expr.EXPR_KIND_IDENT && e.kind != expr.EXPR_KIND_MEMBER) { ret false; }
    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, eid);
    val sym_opt: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](sym_opt)) { ret false; }
    ret names_function(ctx, O.unwrap[*resolve.Symbol](sym_opt));
}

fun lower_unary(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val op: expr.UnOp = e.data.unary.op;

    if (op == expr.UN_ADDR) {
        if (address_operand_names_function(ctx, e.data.unary.operand)) {
            ret lower_rvalue(ctx, e.data.unary.operand);
        }
        ret lower_lvalue(ctx, e.data.unary.operand);
    }
    if (op == expr.UN_DEREF) {
        val res_ptr: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
        if (R.is_err[value.Value, fail.Fail](res_ptr)) { ret res_ptr; }
        val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
        ret rvalue_at(ctx, R.unwrap_ok[value.Value, fail.Fail](res_ptr), R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir), false);
    }

    val res_v: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.unary.operand);
    if (R.is_err[value.Value, fail.Fail](res_v)) { ret res_v; }
    val v: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_v);

    if (op == expr.UN_NEG)     { ret fail.lift[value.Value](builder.emit_neg(?ctx.builder, v)); }
    if (op == expr.UN_BIT_NOT) { ret fail.lift[value.Value](builder.emit_not(?ctx.builder, v)); }
    if (op == expr.UN_NOT) { ret fail.lift[value.Value](builder.emit_cmp_ne(?ctx.builder, v, value.const_int(1, v.ty))); }

    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported unary operator"));
}

pub fun condition_value(ctx: *context.LowerContext, eid: id.ExprId, v: value.Value) R.Result[value.Value, fail.Fail] {
    val e_opt: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_some[*expr.Expr](e_opt)) {
        val e: *expr.Expr = O.unwrap[*expr.Expr](e_opt);
        if (e.kind == expr.EXPR_KIND_BINARY
         && (is_compare_binop(e.data.binary.op)
          || e.data.binary.op == expr.BIN_AND
          || e.data.binary.op == expr.BIN_OR)) { ret R.ok[value.Value, fail.Fail](v); }
        if (e.kind == expr.EXPR_KIND_UNARY && e.data.unary.op == expr.UN_NOT) {
            ret R.ok[value.Value, fail.Fail](v);
        }
    }
    ret fail.lift[value.Value](builder.emit_cmp_eq(?ctx.builder, v, value.const_int(1, v.ty)));
}

fun lower_cast(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_v: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.cast.value);
    if (R.is_err[value.Value, fail.Fail](res_v)) { ret res_v; }
    val v: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_v);

    val from_ty: type.TypeId = context.expr_type_of(ctx, e.data.cast.value);
    val to_ty:   type.TypeId = context.type_resolved_of(ctx, e.data.cast.ty);

    val res_dst: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, to_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_dst)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_dst)); }
    val dst: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_dst);

    if (e.data.cast.reinterpret) { ret lower_reinterpret(ctx, v, from_ty, dst); }

    val from_float:  bool = is_float_type(ctx, from_ty);
    val to_float:    bool = is_float_type(ctx, to_ty);
    val from_signed: bool = is_signed_type(ctx, from_ty);
    val to_signed:   bool = is_signed_type(ctx, to_ty);
    val from_bits:   u32  = scalar_bits(ctx, from_ty);
    val to_bits:     u32  = scalar_bits(ctx, to_ty);

    if (from_float && to_float) {
        if (to_bits < from_bits) { ret fail.lift[value.Value](builder.emit_fp_trunc(?ctx.builder, v, dst)); }
        if (to_bits > from_bits) { ret fail.lift[value.Value](builder.emit_fp_ext(?ctx.builder, v, dst)); }
        ret emit_retype(ctx, v, dst);
    }
    if (from_float && !to_float) {
        if (to_signed) { ret fail.lift[value.Value](builder.emit_fp_to_si(?ctx.builder, v, dst)); }
        ret fail.lift[value.Value](builder.emit_fp_to_ui(?ctx.builder, v, dst));
    }
    if (!from_float && to_float) {
        if (from_signed) { ret fail.lift[value.Value](builder.emit_si_to_fp(?ctx.builder, v, dst)); }
        ret fail.lift[value.Value](builder.emit_ui_to_fp(?ctx.builder, v, dst));
    }

    if (to_bits < from_bits) { ret fail.lift[value.Value](builder.emit_trunc(?ctx.builder, v, dst)); }
    if (to_bits > from_bits) {
        if (from_signed) { ret fail.lift[value.Value](builder.emit_sext(?ctx.builder, v, dst)); }
        ret fail.lift[value.Value](builder.emit_zext(?ctx.builder, v, dst));
    }
    ret emit_retype(ctx, v, dst);
}

fun emit_retype(ctx: *context.LowerContext, v: value.Value, dst: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    if (v.ty == dst) { ret R.ok[value.Value, fail.Fail](v); }
    ret fail.lift[value.Value](builder.emit_bitcast(?ctx.builder, v, dst));
}

fun lower_reinterpret(ctx: *context.LowerContext, v: value.Value, from_ty: type.TypeId, dst: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    val res_src: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, from_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_src)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_src)); }
    val src: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_src);

    val src_agg: bool = is_aggregate_ir(ctx, src);
    val dst_agg: bool = is_aggregate_ir(ctx, dst);
    if (src_agg == dst_agg) { ret emit_retype(ctx, v, dst); }

    if (src_agg) {
        val res_ptr: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?ctx.m.types);
        if (R.is_err[ir_type.IrTypeId, str](res_ptr)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_ptr))); }
        ret fail.lift[value.Value](builder.emit_load(?ctx.builder, value.retype(v, R.unwrap_ok[ir_type.IrTypeId, str](res_ptr)), dst));
    }

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, dst, value.const_int(1, xty));
    if (R.is_err[value.Value, str](res_slot)) { ret fail.lift[value.Value](res_slot); }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, v, slot);
    if (R.is_err[R.Void, str](res_store)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store))); }

    ret R.ok[value.Value, fail.Fail](value.retype(slot, dst));
}

fun lower_strip(ctx: *context.LowerContext, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val res_inner: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, e.data.strip.value);
    if (R.is_err[value.Value, fail.Fail](res_inner)) { ret res_inner; }
    ret fail.lift[value.Value](builder.emit_declassify(?ctx.builder, R.unwrap_ok[value.Value, fail.Fail](res_inner)));
}

fun lower_comptime_path(ctx: *context.LowerContext, eid: id.ExprId) R.Result[value.Value, fail.Fail] {
    val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] =
        comptime.evaluate_at_float_width[context.LowerContext](ctx.scope.ctx, ctx, ctx.caps, ctx.scope.a, context.module_source(ctx), eid, ?ctx.s.interner,
                                     context.expr_float_width(ctx, eid));
    context.record_eval_result(ctx, res_eval);
    if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message)); }
    ret const_value_of(ctx, eid, R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval));
}

fun lower_array_lit(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val arr_ty: type.TypeId = context.expr_type_of(ctx, eid);
    val res_arr_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, arr_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_arr_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_arr_ir)); }
    val arr_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_arr_ir);

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, arr_ir, value.const_int(1, xty));
    if (R.is_err[value.Value, str](res_slot)) { ret fail.lift[value.Value](res_slot); }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    var i: u32 = 0;
    for (i < e.data.array_lit.elems_len) {
        val pool_ix: u32 = e.data.array_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
            ret R.err[value.Value, fail.Fail](fail.message("lower: array literal element index out of range"));
        }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
        val res_elem: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, elem_eid);
        if (R.is_err[value.Value, fail.Fail](res_elem)) { ret res_elem; }

        var idx: [2]value.Value;
        idx[0] = value.const_int(0, xty);
        idx[1] = value.const_int(i::u64, xty);
        val res_gep: R.Result[value.Value, str] = builder.emit_gep(?ctx.builder, slot, arr_ir, ?idx[0], 2);
        if (R.is_err[value.Value, str](res_gep)) { ret fail.lift[value.Value](res_gep); }
        val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, R.unwrap_ok[value.Value, fail.Fail](res_elem), R.unwrap_ok[value.Value, str](res_gep));
        if (R.is_err[R.Void, str](res_store)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store))); }
        i = i + 1;
    }

    ret R.ok[value.Value, fail.Fail](value.retype(slot, arr_ir));
}

fun lower_vector_lit(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val vec_ty: type.TypeId = context.expr_type_of(ctx, eid);
    val res_vec_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, vec_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_vec_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_vec_ir)); }
    val vec_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_vec_ir);

    val opt_vt: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, vec_ir);
    if (O.is_none[*ir_type.IrType](opt_vt)) { ret R.err[value.Value, fail.Fail](fail.message("lower: vector literal type is not an IR vector")); }
    val vt: *ir_type.IrType = O.unwrap[*ir_type.IrType](opt_vt);
    if (vt.kind != ir_type.IRT_VECTOR) { ret R.err[value.Value, fail.Fail](fail.message("lower: vector literal type is not an IR vector")); }
    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);

    if (ctx.tgt != nil && ctx.tgt.model.has_vec_build) {
        if (e.data.vector_lit.elems_len > 16) {
            ret R.err[value.Value, fail.Fail](fail.message("lower: vector literal has more lanes than any 128-bit vector"));
        }
        var lanes: [16]value.Value;
        var li: u32 = 0;
        for (li < e.data.vector_lit.elems_len) {
            val lpool_ix: u32 = e.data.vector_lit.elems_start + li;
            if (lpool_ix::usize >= ctx.scope.a.expr_id_len) {
                ret R.err[value.Value, fail.Fail](fail.message("lower: vector literal element index out of range"));
            }
            val lres: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, ctx.scope.a.expr_ids[lpool_ix]);
            if (R.is_err[value.Value, fail.Fail](lres)) { ret lres; }
            lanes[li] = R.unwrap_ok[value.Value, fail.Fail](lres);
            li = li + 1;
        }
        ret fail.lift[value.Value](builder.emit_vec_build(?ctx.builder, vec_ir, ?lanes[0], e.data.vector_lit.elems_len));
    }

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, vec_ir, value.const_int(1, xty));
    if (R.is_err[value.Value, str](res_slot)) { ret fail.lift[value.Value](res_slot); }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    var i: u32 = 0;
    for (i < e.data.vector_lit.elems_len) {
        val pool_ix: u32 = e.data.vector_lit.elems_start + i;
        if (pool_ix::usize >= ctx.scope.a.expr_id_len) {
            ret R.err[value.Value, fail.Fail](fail.message("lower: vector literal element index out of range"));
        }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[pool_ix];
        val res_elem: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, elem_eid);
        if (R.is_err[value.Value, fail.Fail](res_elem)) { ret res_elem; }

        var idx: [2]value.Value;
        idx[0] = value.const_int(0, xty);
        idx[1] = value.const_int(i::u64, xty);
        val res_gep: R.Result[value.Value, str] = builder.emit_gep(?ctx.builder, slot, vec_ir, ?idx[0], 2);
        if (R.is_err[value.Value, str](res_gep)) { ret fail.lift[value.Value](res_gep); }
        val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, R.unwrap_ok[value.Value, fail.Fail](res_elem), R.unwrap_ok[value.Value, str](res_gep));
        if (R.is_err[R.Void, str](res_store)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store))); }
        i = i + 1;
    }

    ret fail.lift[value.Value](builder.emit_load(?ctx.builder, slot, vec_ir));
}

fun lower_struct_lit(ctx: *context.LowerContext, eid: id.ExprId, e: *expr.Expr) R.Result[value.Value, fail.Fail] {
    val rec_ty: type.TypeId = context.expr_type_of(ctx, eid);
    val res_rec_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, rec_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_rec_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_rec_ir)); }
    val rec_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_rec_ir);

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, rec_ir, value.const_int(1, xty));
    if (R.is_err[value.Value, str](res_slot)) { ret fail.lift[value.Value](res_slot); }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    if (e.data.struct_lit.fields_len < type.field_count(?ctx.s.types, rec_ty)) {
        val res_mz: R.Result[R.Void, str] = builder.emit_memzero(?ctx.builder, slot, rec_ir);
        if (R.is_err[R.Void, str](res_mz)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_mz))); }
    }

    var i: u32 = 0;
    for (i < e.data.struct_lit.fields_len) {
        val pool_ix: u32 = e.data.struct_lit.fields_start + i;
        if (pool_ix::usize >= ctx.scope.a.field_init_len) {
            ret R.err[value.Value, fail.Fail](fail.message("lower: struct literal field index out of range"));
        }
        val fi: *expr.FieldInit = ?ctx.scope.a.field_inits[pool_ix];
        val field_ix: u32 = field_index_in_type(ctx, rec_ty, fi.name);
        val res_field: R.Result[value.Value, fail.Fail] = lower_rvalue(ctx, fi.value);
        if (R.is_err[value.Value, fail.Fail](res_field)) { ret res_field; }

        var idx: [2]value.Value;
        idx[0] = value.const_int(0, xty);
        idx[1] = value.const_int(field_ix::u64, xty);
        val res_gep: R.Result[value.Value, str] = builder.emit_gep(?ctx.builder, slot, rec_ir, ?idx[0], 2);
        if (R.is_err[value.Value, str](res_gep)) { ret fail.lift[value.Value](res_gep); }
        val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, R.unwrap_ok[value.Value, fail.Fail](res_field), R.unwrap_ok[value.Value, str](res_gep));
        if (R.is_err[R.Void, str](res_store)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_store))); }
        i = i + 1;
    }

    ret R.ok[value.Value, fail.Fail](value.retype(slot, rec_ir));
}

pub fun const_value_of(ctx: *context.LowerContext, eid: id.ExprId, v: comptime.CTValue) R.Result[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, true);
}

pub fun const_value_of_init(ctx: *context.LowerContext, eid: id.ExprId, v: comptime.CTValue) R.Result[value.Value, fail.Fail] {
    ret materialize_const_value(ctx, eid, v, false);
}

fun materialize_const_value(ctx: *context.LowerContext, eid: id.ExprId, v: comptime.CTValue, expr_pos: bool) R.Result[value.Value, fail.Fail] {
    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = ir_type_of_expr(ctx, eid);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir)); }
    val ty_id: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);

    if (v.kind == comptime.CT_KIND_INT) { ret R.ok[value.Value, fail.Fail](value.const_int(v.data.i::u64, ty_id)); }
    if (v.kind == comptime.CT_KIND_FLOAT) { ret R.ok[value.Value, fail.Fail](value.const_float(v.data.f, ty_id)); }
    if (v.kind == comptime.CT_KIND_STR) {
        val opt_txt: O.Option[str] = intern.lookup(?ctx.s.interner, v.data.s);
        if (O.is_none[str](opt_txt)) { ret R.err[value.Value, fail.Fail](fail.message("lower: comptime string lookup failed")); }
        val s: str = O.unwrap[str](opt_txt);
        val blob: value.Value = value.const_bytes(s::*u8, (str_len(s) + 1::usize)::u32, ty_id);
        if (expr_pos) { ret context.add_rodata_bytes(ctx, blob, ty_id); }
        ret R.ok[value.Value, fail.Fail](blob);
    }
    ret R.err[value.Value, fail.Fail](fail.message("lower: unsupported comptime value kind"));
}

fun rvalue_at(ctx: *context.LowerContext, ptr: value.Value, ity: ir_type.IrTypeId, vol: bool) R.Result[value.Value, fail.Fail] {
    if (is_aggregate_ir(ctx, ity)) { ret R.ok[value.Value, fail.Fail](value.retype(ptr, ity)); }
    val res: R.Result[value.Value, str] = builder.emit_load(?ctx.builder, ptr, ity);
    if (vol && R.is_ok[value.Value, str](res)) { builder.mark_last_volatile(?ctx.builder); }
    ret fail.lift[value.Value](res);
}

fun global_pointer(ctx: *context.LowerContext, global_ix: u32) R.Result[value.Value, fail.Fail] {
    val res_ptr: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?ctx.m.types);
    if (R.is_err[ir_type.IrTypeId, str](res_ptr)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_ptr))); }
    ret R.ok[value.Value, fail.Fail](value.global(global_ix, R.unwrap_ok[ir_type.IrTypeId, str](res_ptr)));
}

fun emit_global_rvalue(ctx: *context.LowerContext, global_ix: u32, vty: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    val res_gptr: R.Result[value.Value, fail.Fail] = global_pointer(ctx, global_ix);
    if (R.is_err[value.Value, fail.Fail](res_gptr)) { ret res_gptr; }
    val gptr: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_gptr);
    if (is_aggregate_ir(ctx, vty)) { ret R.ok[value.Value, fail.Fail](value.retype(gptr, vty)); }
    ret fail.lift[value.Value](builder.emit_load(?ctx.builder, gptr, vty));
}

fun fn_reference(ctx: *context.LowerContext, link: intern.StrId, vty: ir_type.IrTypeId, is_import: bool) R.Result[value.Value, fail.Fail] {
    val opt_fi: O.Option[u32] = find_function(ctx, link);
    if (O.is_some[u32](opt_fi)) {
        ret R.ok[value.Value, fail.Fail](value.fn(O.unwrap[u32](opt_fi), vty));
    }
    val res_xfn: R.Result[u32, fail.Fail] = context.ensure_extern_function(ctx, link, vty, is_import);
    if (R.is_err[u32, fail.Fail](res_xfn)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[u32, fail.Fail](res_xfn)); }
    ret R.ok[value.Value, fail.Fail](value.fn(R.unwrap_ok[u32, fail.Fail](res_xfn), vty));
}

fun member_receiver(ctx: *context.LowerContext, eid: id.ExprId, obj_eid: id.ExprId, untyped_ptr_msg: str, out_rec_ty: *type.TypeId) R.Result[value.Value, fail.Fail] {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: O.Option[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (O.is_none[*type.Type](opt_pt)) { ret R.err[value.Value, fail.Fail](fail.message("lower: receiver base has no pointer type")); }
        val pt: *type.Type = O.unwrap[*type.Type](opt_pt);
        if (pt.kind != type.TYPE_POINTER) {
            ret report_expr(ctx, eid, untyped_ptr_msg);
        }
        @out_rec_ty = type.strip_secret(?ctx.s.types, pt.data.pointer.base);
        ret lower_rvalue(ctx, obj_eid);
    }
    @out_rec_ty = obj_ty;
    ret lower_lvalue(ctx, obj_eid);
}

fun field_access_rec_ty(ctx: *context.LowerContext, obj_eid: id.ExprId) type.TypeId {
    val obj_ty: type.TypeId = type.strip_secret(?ctx.s.types, context.expr_type_of(ctx, obj_eid));
    if (is_pointer_type(ctx, obj_ty)) {
        val opt_pt: O.Option[*type.Type] = type.get(?ctx.s.types, obj_ty);
        if (O.is_none[*type.Type](opt_pt)) { ret type.TYPE_ERROR; }
        val pt: *type.Type = O.unwrap[*type.Type](opt_pt);
        if (pt.kind != type.TYPE_POINTER) { ret type.TYPE_ERROR; }
        ret type.strip_secret(?ctx.s.types, pt.data.pointer.base);
    }
    ret obj_ty;
}

pub fun type_is_volatile_record(ctx: *context.LowerContext, sem_ty: type.TypeId) bool {
    val t: type.TypeId = type.strip_secret(?ctx.s.types, sem_ty);
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret false; }
    val nom: type.TypeId = type.aggregate_nominal(?ctx.s.types, t);
    if (nom == type.TYPE_ERROR) { ret false; }
    ret session.type_is_volatile(ctx.s, nom::u32);
}

pub fun value_is_volatile_record(ctx: *context.LowerContext, eid: id.ExprId) bool {
    if (eid == id.EXPR_NIL) { ret false; }
    ret type_is_volatile_record(ctx, context.expr_type_of(ctx, eid));
}

fun field_access_is_volatile(ctx: *context.LowerContext, obj_eid: id.ExprId) bool {
    val rec_ty: type.TypeId = field_access_rec_ty(ctx, obj_eid);
    if (rec_ty == type.TYPE_NIL || rec_ty == type.TYPE_ERROR) { ret false; }
    val nom: type.TypeId = type.aggregate_nominal(?ctx.s.types, rec_ty);
    if (nom == type.TYPE_ERROR) { ret false; }
    ret session.type_is_volatile(ctx.s, nom::u32);
}

fun lvalue_is_volatile_field(ctx: *context.LowerContext, eid: id.ExprId) bool {
    val opt_e: O.Option[*expr.Expr] = ast.get_expr(ctx.scope.a, eid);
    if (O.is_none[*expr.Expr](opt_e)) { ret false; }
    val e: *expr.Expr = O.unwrap[*expr.Expr](opt_e);
    if (e.kind == expr.EXPR_KIND_MEMBER)  { ret field_access_is_volatile(ctx, e.data.member.object); }
    if (e.kind == expr.EXPR_KIND_PROJECT) { ret field_access_is_volatile(ctx, e.data.project.object); }
    ret false;
}

fun field_gep(ctx: *context.LowerContext, base: value.Value, rec_ty: type.TypeId, field_ix: u32) R.Result[value.Value, fail.Fail] {
    val res_rec_ir: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, rec_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_rec_ir)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_rec_ir)); }
    val rec_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_rec_ir);

    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);

    var idx: [2]value.Value;
    idx[0] = value.const_int(0, xty);
    idx[1] = value.const_int(field_ix::u64, xty);
    ret fail.lift[value.Value](builder.emit_gep(?ctx.builder, base, rec_ir, ?idx[0], 2));
}

fun ir_type_of_expr(ctx: *context.LowerContext, eid: id.ExprId) R.Result[ir_type.IrTypeId, fail.Fail] {
    ret context.lower_type(ctx, context.expr_type_of(ctx, eid));
}

fun index_bits(ctx: *context.LowerContext) u32 {
    ret ctx.tgt.model.index_width;
}

fun index_type(ctx: *context.LowerContext) R.Result[ir_type.IrTypeId, fail.Fail] {
    ret fail.lift[ir_type.IrTypeId](ir_type.intern_int(?ctx.m.types, index_bits(ctx)));
}

fun widen_index(ctx: *context.LowerContext, v: value.Value, sem_ty: type.TypeId) R.Result[value.Value, fail.Fail] {
    val res_xty: R.Result[ir_type.IrTypeId, fail.Fail] = index_type(ctx);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_xty)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_xty)); }
    val xty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_xty);
    if (scalar_bits(ctx, sem_ty) >= index_bits(ctx)) { ret R.ok[value.Value, fail.Fail](v); }
    if (is_signed_type(ctx, sem_ty))    { ret fail.lift[value.Value](builder.emit_sext(?ctx.builder, v, xty)); }
    ret fail.lift[value.Value](builder.emit_zext(?ctx.builder, v, xty));
}

fun repr_kind(ctx: *context.LowerContext, tid: type.TypeId) O.Option[type.TypeKind] {
    val base: type.TypeId = type.strip_secret(?ctx.s.types, tid);
    val opt_t: O.Option[*type.Type] = type.get(?ctx.s.types, base);
    if (O.is_none[*type.Type](opt_t)) { ret O.none[type.TypeKind](); }
    ret O.some[type.TypeKind](O.unwrap[*type.Type](opt_t).kind);
}

fun scalar_bits(ctx: *context.LowerContext, tid: type.TypeId) u32 {
    val ok: O.Option[type.TypeKind] = repr_kind(ctx, tid);
    if (O.is_none[type.TypeKind](ok)) { ret 0; }
    val k: type.TypeKind = O.unwrap[type.TypeKind](ok);
    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT || d.class == type.PRIM_CLASS_FLOAT) { ret d.bits; }
    if (k == type.TYPE_PTR || k == type.TYPE_POINTER || k == type.TYPE_FUN) { ret ctx.tgt.isa.pointer_width * 8; }
    ret 0;
}

fun is_signed_type(ctx: *context.LowerContext, tid: type.TypeId) bool {
    val ok: O.Option[type.TypeKind] = repr_kind(ctx, tid);
    if (O.is_none[type.TypeKind](ok)) { ret false; }
    ret type.prim_desc(O.unwrap[type.TypeKind](ok)).signed;
}

fun is_float_type(ctx: *context.LowerContext, tid: type.TypeId) bool {
    val ok: O.Option[type.TypeKind] = repr_kind(ctx, tid);
    if (O.is_none[type.TypeKind](ok)) { ret false; }
    ret type.prim_desc(O.unwrap[type.TypeKind](ok)).class == type.PRIM_CLASS_FLOAT;
}

fun is_pointer_type(ctx: *context.LowerContext, tid: type.TypeId) bool {
    val opt_t: O.Option[*type.Type] = type.get(?ctx.s.types, tid);
    if (O.is_none[*type.Type](opt_t)) { ret false; }
    val k: type.TypeKind = O.unwrap[*type.Type](opt_t).kind;
    ret k == type.TYPE_PTR || k == type.TYPE_POINTER;
}

fun is_aggregate_ir(ctx: *context.LowerContext, ity: ir_type.IrTypeId) bool {
    ret ir_type.is_aggregate(?ctx.m.types, ity);
}

pub fun field_index_in_type(ctx: *context.LowerContext, rec_ty: type.TypeId, name: token.Span) u32 {
    val src_text: str = context.module_source(ctx);
    val res_want: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, src_text, name);
    if (R.is_err[intern.StrId, str](res_want)) { ret 0; }
    val want: intern.StrId = R.unwrap_ok[intern.StrId, str](res_want);

    val fields_len: u32 = type.field_count(?ctx.s.types, rec_ty);
    var i: u32 = 0;
    for (i < fields_len) {
        val opt_fe: O.Option[*type.FieldEntry] = type.field_at(?ctx.s.types, rec_ty, i);
        if (O.is_some[*type.FieldEntry](opt_fe)) {
            if (O.unwrap[*type.FieldEntry](opt_fe).name == want) { ret i; }
        }
        i = i + 1;
    }

    val res_name: R.Result[str, str] = str_copy_slice(ctx.s.alloc, src_text, name.offset, name.len);
    if (R.is_err[str, str](res_name)) {
        diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, name, "no such field on the receiver type");
        ret 0;
    }
    val fname: str = R.unwrap_ok[str, str](res_name);
    val res_msg: R.Result[str, str] = str_join(ctx.s.alloc, "no field '", fname, "' on the receiver type");
    str_free(ctx.s.alloc, fname);
    if (R.is_err[str, str](res_msg)) {
        diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, name, "no such field on the receiver type");
        ret 0;
    }
    val msg: str = R.unwrap_ok[str, str](res_msg);
    diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, name, msg);
    str_free(ctx.s.alloc, msg);
    ret 0;
}

fun find_function(ctx: *context.LowerContext, name: intern.StrId) O.Option[u32] {
    ret ir.function_lookup(ctx.m, name);
}

fun find_global(ctx: *context.LowerContext, name: intern.StrId) O.Option[u32] {
    ret ir.global_lookup(ctx.m, name);
}

rec StructLitProbe {
    a: u32;
    b: u32;
    c: u32;
    d: u32;
}

rec StructLitProbeInner {
    x: u32;
    y: u32;
}

rec StructLitProbeOuter {
    tag:   u32;
    inner: StructLitProbeInner;
    arr:   [3]u32;
}

val struct_lit_probe_static: StructLitProbe = StructLitProbe{a: 42};

val struct_lit_probe_ct_arr: [1]StructLitProbe = [1]StructLitProbe{StructLitProbe{a: 5}};

fun struct_lit_probe_dirty() u32 {
    var junk: [16]u32;
    var i: u32 = 0;
    for (i < 16) { junk[i] = 0xAAAAAAAA; i = i + 1; }
    ret junk[0];
}

fun struct_lit_probe_partial() StructLitProbe {
    ret StructLitProbe{a: 7};
}

fun struct_lit_probe_full() StructLitProbe {
    ret StructLitProbe{a: 1, b: 2, c: 3, d: 4};
}

fun struct_lit_probe_outer_partial() StructLitProbeOuter {
    ret StructLitProbeOuter{tag: 3};
}

fun struct_lit_probe_outer_nested_partial() StructLitProbeOuter {
    ret StructLitProbeOuter{tag: 9, inner: StructLitProbeInner{x: 5}, arr: [3]u32{1, 2, 3}};
}

fun struct_lit_probe_runtime_y() u32 {
    val r: StructLitProbe = StructLitProbe{a: 5};
    ret r.b;
}

test "mach.lang.me.lower.expr.struct_lit:partial_literal_zeroes_omitted_fields_over_dirty_stack" {
    var bad: i32 = 0;

    val dirty_check: u32 = struct_lit_probe_dirty();
    if (dirty_check != 0xAAAAAAAA) { bad = bad + 1; }

    val r: StructLitProbe = struct_lit_probe_partial();
    if (r.a != 7) { bad = bad + 2; }
    if (r.b != 0) { bad = bad + 4; }
    if (r.c != 0) { bad = bad + 8; }
    if (r.d != 0) { bad = bad + 16; }

    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:full_literal_unchanged" {
    var bad: i32 = 0;
    val r: StructLitProbe = struct_lit_probe_full();
    if (r.a != 1) { bad = bad + 1; }
    if (r.b != 2) { bad = bad + 2; }
    if (r.c != 3) { bad = bad + 4; }
    if (r.d != 4) { bad = bad + 8; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:partial_literal_zeroes_nested_aggregate_region" {
    var bad: i32 = 0;
    val o: StructLitProbeOuter = struct_lit_probe_outer_partial();
    if (o.tag != 3)     { bad = bad + 1; }
    if (o.inner.x != 0) { bad = bad + 2; }
    if (o.inner.y != 0) { bad = bad + 4; }
    if (o.arr[0] != 0)  { bad = bad + 8; }
    if (o.arr[1] != 0)  { bad = bad + 16; }
    if (o.arr[2] != 0)  { bad = bad + 32; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:partial_literal_nested_inside_full_literal" {
    var bad: i32 = 0;
    val o: StructLitProbeOuter = struct_lit_probe_outer_nested_partial();
    if (o.tag != 9)      { bad = bad + 1; }
    if (o.inner.x != 5)  { bad = bad + 2; }
    if (o.inner.y != 0)  { bad = bad + 4; }
    if (o.arr[0] != 1)   { bad = bad + 8; }
    if (o.arr[1] != 2)   { bad = bad + 16; }
    if (o.arr[2] != 3)   { bad = bad + 32; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:constagg_static_partial_matches_runtime" {
    var bad: i32 = 0;
    if (struct_lit_probe_static.a != 42) { bad = bad + 1; }
    if (struct_lit_probe_static.b != 0)  { bad = bad + 2; }
    if (struct_lit_probe_static.c != 0)  { bad = bad + 4; }
    if (struct_lit_probe_static.d != 0)  { bad = bad + 8; }
    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:comptime_and_runtime_agree_on_omitted_field" {
    var bad: i32 = 0;
    $each item in struct_lit_probe_ct_arr {
        $if (item.b == 0) {
            if (struct_lit_probe_runtime_y() != 0) { bad = bad + 1; }
        }
        $or {
            bad = bad + 2;
        }
    }
    ret bad;
}

uni StructLitProbeUnion {
    small: u8;
    big:   u64;
}

val struct_lit_probe_union_static: StructLitProbeUnion = StructLitProbeUnion{small: 1};

fun struct_lit_probe_union_dirty() u64 {
    var junk: [16]u64;
    var i: u32 = 0;
    for (i < 16) { junk[i] = 0xAAAAAAAAAAAAAAAA; i = i + 1; }
    ret junk[0];
}

fun struct_lit_probe_union_partial() StructLitProbeUnion {
    ret StructLitProbeUnion{small: 1};
}

test "mach.lang.me.lower.expr.struct_lit:partial_union_literal_zeroes_tail_bytes_over_dirty_stack" {
    var bad: i32 = 0;

    val dirty_check: u64 = struct_lit_probe_union_dirty();
    if (dirty_check != 0xAAAAAAAAAAAAAAAA) { bad = bad + 1; }

    val u: StructLitProbeUnion = struct_lit_probe_union_partial();
    if (u.small != 1)      { bad = bad + 2; }
    if ((u.big >> 8) != 0) { bad = bad + 4; }

    ret bad;
}

test "mach.lang.me.lower.expr.struct_lit:union_literal_static_and_runtime_agree" {
    var bad: i32 = 0;

    val u: StructLitProbeUnion = StructLitProbeUnion{small: 1};
    if (u.small != struct_lit_probe_union_static.small)           { bad = bad + 1; }
    if ((u.big >> 8) != (struct_lit_probe_union_static.big >> 8)) { bad = bad + 2; }
    if ((struct_lit_probe_union_static.big >> 8) != 0)            { bad = bad + 4; }

    ret bad;
}

test "mach.lang.me.lower.expr.int_ct:records_destination_signedness" {
    var bad: i32 = 0;

    val u: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](int_ct(-1, true));
    if (!u.int_unsigned)                        { bad = bad + 1; }
    if (u.kind != comptime.CT_KIND_INT)         { bad = bad + 2; }

    val s: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](int_ct(-1, false));
    if (s.int_unsigned)                         { bad = bad + 4; }

    if (u.data.i != s.data.i)                   { bad = bad + 8; }

    if (rerepresent_int(300, 8, false) != 44)   { bad = bad + 16; }
    if (rerepresent_int(300, 8, true) != 44)    { bad = bad + 32; }
    if (rerepresent_int(-1, 8, false) != 255)   { bad = bad + 64; }
    if (rerepresent_int(-1, 8, true) != -1)     { bad = bad + 128; }

    ret bad;
}

val convert_const_probe_u64:        u64 = 18446744073709551615;
val convert_const_probe_u64_as_f64: f64 = convert_const_probe_u64::f64;

fun convert_const_probe_u64_to_f64_runtime(x: u64) f64 {
    ret x::f64;
}

val convert_const_probe_f64_high:   f64 = 9223372036854775808.0;
val convert_const_probe_f64_as_u64: u64 = convert_const_probe_f64_high::u64;

fun convert_const_probe_f64_to_u64_runtime(x: f64) u64 {
    ret x::u64;
}

test "mach.lang.me.lower.expr.convert_const_scalar:unsigned_conversions_agree_with_runtime" {
    var bad: i32 = 0;

    if (convert_const_probe_u64_as_f64 != convert_const_probe_u64_to_f64_runtime(convert_const_probe_u64)) { bad = bad + 1; }
    if (convert_const_probe_u64_as_f64 <= 0.0)                                                              { bad = bad + 2; }

    if (convert_const_probe_f64_as_u64 != convert_const_probe_f64_to_u64_runtime(convert_const_probe_f64_high)) { bad = bad + 4; }
    if (convert_const_probe_f64_as_u64 != 9223372036854775808)                                                   { bad = bad + 8; }

    ret bad;
}

val reinterpret_probe_f64:      f64 = 5.0;
val reinterpret_probe_f64_bits: u64 = reinterpret_probe_f64:~u64;

fun reinterpret_probe_f64_runtime(f: f64) u64 {
    ret f:~u64;
}

val reinterpret_probe_f32:      f32 = 5.0;
val reinterpret_probe_f32_bits: u32 = reinterpret_probe_f32:~u32;

fun reinterpret_probe_f32_runtime(f: f32) u32 {
    ret f:~u32;
}

test "mach.lang.me.lower.expr.convert_const_scalar:reinterpret_agrees_with_runtime" {
    var bad: i32 = 0;

    if (reinterpret_probe_f64_bits != reinterpret_probe_f64_runtime(reinterpret_probe_f64)) { bad = bad + 1; }
    if (reinterpret_probe_f64_bits != 0x4014000000000000)                                    { bad = bad + 2; }

    if (reinterpret_probe_f32_bits != reinterpret_probe_f32_runtime(reinterpret_probe_f32)) { bad = bad + 4; }
    if (reinterpret_probe_f32_bits != 0x40A00000)                                             { bad = bad + 8; }

    ret bad;
}
