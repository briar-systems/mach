rec Pair { first: i64; second: i64; }
rec Nested { item: Pair; }
uni Overlay { item: Pair; bytes: [16]u8; }

var global_pair: Pair;

fun take_pair(item: Pair, effect: i64) i64 { ret item.first + item.second + effect; }
fun take_array(item: [3]i64, effect: i64) i64 { ret item[0] + item[1] + item[2] + effect; }
fun take_overlay(item: Overlay, effect: i64) i64 { ret item.item.first + item.item.second + effect; }

fun mutate(item: *Pair) i64 {
    item.first = 99;
    item.second = 100;
    ret 0;
}

fun mutate_array(item: *[3]i64) i64 {
    @item = [3]i64{99, 100, 101};
    ret 0;
}

fun observe(item: *Pair, order: *i64) *Pair {
    @order = @order * 10 + 1;
    ret item;
}

fun mutate_ordered(item: *Pair, order: *i64) i64 {
    @order = @order * 10 + 2;
    ret mutate(item);
}

fun destination(out: *Pair, source: *Pair, order: *i64) *Pair {
    mutate_ordered(source, order);
    ret out;
}

fun return_before_cleanup(item: *Pair) Pair {
    fin { mutate(item); }
    ret @item;
}

test "mach.lang.me.lower.aggregate_value:call_captures_before_later_argument" {
    var item: Pair = Pair{first: 7, second: 8};
    var order: i64 = 0;
    val actual: i64 = take_pair(@observe(?item, ?order), mutate_ordered(?item, ?order));
    if (order != 12 || item.first != 99 || item.second != 100) { ret 1; }
    if (actual != 15) { ret 2; }
    ret 0;
}

test "mach.lang.me.lower.aggregate_value:local_and_global_reads_own_their_bytes" {
    var item: Pair = Pair{first: 7, second: 8};
    val local: i64 = take_pair(item, mutate(?item));
    if (local != 15 || item.first != 99) { ret 3; }
    global_pair = Pair{first: 7, second: 8};
    val global: i64 = take_pair(global_pair, mutate(?global_pair));
    if (global != 15 || global_pair.first != 99) { ret 4; }
    ret 0;
}

test "mach.lang.me.lower.aggregate_value:field_and_index_reads_own_their_bytes" {
    var outer: Nested = Nested{item: Pair{first: 7, second: 8}};
    val field: i64 = take_pair(outer.item, mutate(?outer.item));
    if (field != 15 || outer.item.first != 99) { ret 5; }
    var items: [1]Pair = [1]Pair{Pair{first: 7, second: 8}};
    val indexed: i64 = take_pair(items[0], mutate(?items[0]));
    if (indexed != 15 || items[0].first != 99) { ret 6; }
    ret 0;
}

test "mach.lang.me.lower.aggregate_value:arrays_and_unions_capture_before_calls" {
    var items: [3]i64 = [3]i64{7, 8, 9};
    val array: i64 = take_array(items, mutate_array(?items));
    if (array != 24 || items[0] != 99) { ret 7; }
    var item: Overlay = Overlay{item: Pair{first: 7, second: 8}};
    val overlay: i64 = take_overlay(item, mutate(?item.item));
    if (overlay != 15 || item.item.first != 99) { ret 8; }
    ret 0;
}

test "mach.lang.me.lower.aggregate_value:assignment_captures_rhs_before_destination" {
    var source: Pair = Pair{first: 7, second: 8};
    var out: Pair;
    var order: i64 = 0;
    @destination(?out, ?source, ?order) = @observe(?source, ?order);
    if (order != 12 || source.first != 99 || source.second != 100) { ret 9; }
    if (out.first != 7 || out.second != 8) { ret 10; }
    ret 0;
}

test "mach.lang.me.lower.aggregate_value:return_captures_before_fin" {
    var source: Pair = Pair{first: 7, second: 8};
    val result: Pair = return_before_cleanup(?source);
    if (source.first != 99 || source.second != 100) { ret 11; }
    if (result.first != 7 || result.second != 8) { ret 12; }
    ret 0;
}
