use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.types.string;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use R: std.types.result;

use mach.lang.diagnostic;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.comptime;
use mach.lang.fe.resolve;
use mach.lang.fe.sema;
use scx: mach.lang.fe.sema.context;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.lower.context;
use mach.lang.me.lower.expr;
use mach.lang.fail;
use mach.lang.session;
use mach.lang.source;
use mach.lang.type;

val ASM_BIND_INIT_CAP: u32 = 4;

pub fun lower_stmt(ctx: *context.LowerContext, sid: id.StmtId) err[fail.Fail] {
    val opt_stmt: opt[*stmt.Stmt] = ast.get_stmt_typed(ctx.scope.a, sid);
    if (sel opt_stmt.none) {
        ret err[fail.Fail].err{fail.message("lower: statement id out of range")};
    }
    val s: *stmt.Stmt     = opt_stmt.some;

    val saved_loc: source.SrcLoc = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, s.span.offset));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val k: stmt.StmtKind  = s.kind;

    if (k == stmt.STMT_KIND_EXPR)          { ret lower_expr_stmt(ctx, s); }
    if (k == stmt.STMT_KIND_BLOCK)         { ret lower_block(ctx, s); }
    if (k == stmt.STMT_KIND_IF)            { ret lower_if(ctx, s); }
    if (k == stmt.STMT_KIND_FOR)           { ret lower_for(ctx, s); }
    if (k == stmt.STMT_KIND_RET)           { ret lower_ret(ctx, s); }
    if (k == stmt.STMT_KIND_BRK)           { ret lower_brk(ctx); }
    if (k == stmt.STMT_KIND_CNT)           { ret lower_cnt(ctx); }
    if (k == stmt.STMT_KIND_FIN)           { ret lower_fin(ctx, s); }
    if (k == stmt.STMT_KIND_DECL)          { ret lower_decl_stmt(ctx, s); }
    if (k == stmt.STMT_KIND_ASM)           { ret lower_asm(ctx, s); }
    if (k == stmt.STMT_KIND_COMPTIME_IF)   { ret lower_comptime_if(ctx, s); }
    if (k == stmt.STMT_KIND_COMPTIME_EACH) { ret lower_comptime_each(ctx, s); }

    if (k == stmt.STMT_KIND_COMPTIME_ATTR) { ret err[fail.Fail].ok{}; }

    if (k == stmt.STMT_KIND_ERROR) {
        ret err[fail.Fail].err{fail.message("lower: error statement reached the middle end")};
    }

    ret err[fail.Fail].err{fail.message("lower: unsupported statement kind")};
}

pub fun lower_stmt_list(ctx: *context.LowerContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        if (context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= ctx.scope.a.stmt_id_len) {
            ret err[fail.Fail].err{fail.message("lower: statement list index out of range")};
        }
        val res_stmt: err[fail.Fail] = lower_stmt(ctx, ctx.scope.a.stmt_ids[pool_ix]);
        if (sel res_stmt.err) { ret res_stmt; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_expr_stmt(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val res_value: res[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.expr.expr);
    if (sel res_value.err) {
        ret err[fail.Fail].err{res_value.err};
    }
    ret err[fail.Fail].ok{};
}

fun lower_block(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val mark: u32 = context.fin_count(ctx);
    val res_body: err[fail.Fail] = lower_stmt_list(ctx, s.data.block.stmts_start, s.data.block.stmts_len);
    if (sel res_body.err) {
        context.pop_fins_to(ctx, mark);
        ret res_body;
    }
    if (!context.block_terminated(ctx)) {
        val res_fins: err[fail.Fail] = replay_fins_from(ctx, mark);
        if (sel res_fins.err) {
            context.pop_fins_to(ctx, mark);
            ret res_fins;
        }
    }
    context.pop_fins_to(ctx, mark);
    ret err[fail.Fail].ok{};
}

fun lower_if(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val res_cond: res[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.if_.cond);
    if (sel res_cond.err) {
        ret err[fail.Fail].err{res_cond.err};
    }
    val res_condition: res[value.Value, fail.Fail] = expr.condition_value(ctx, s.data.if_.cond, res_cond.ok);
    if (sel res_condition.err) {
        ret err[fail.Fail].err{res_condition.err};
    }
    val cond: value.Value = res_condition.ok;

    val res_then: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_then.err) {
        ret err[fail.Fail].err{res_then.err};
    }
    val then_b: ir.BlockId = res_then.ok;

    val res_else: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_else.err) {
        ret err[fail.Fail].err{res_else.err};
    }
    val else_b: ir.BlockId = res_else.ok;

    val res_merge: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_merge.err) {
        ret err[fail.Fail].err{res_merge.err};
    }
    val merge_b: ir.BlockId = res_merge.ok;

    val has_else: bool = s.data.if_.else_block != id.STMT_NIL;

    val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, cond, then_b, else_b);
    if (sel res_cbr.err) { ret res_cbr; }

    builder.set_block(?ctx.builder, then_b);
    val res_then_body: err[fail.Fail] = lower_stmt(ctx, s.data.if_.then_block);
    if (sel res_then_body.err) { ret res_then_body; }
    if (!context.block_terminated(ctx)) {
        val res_br: err[fail.Fail] = builder.emit_br(?ctx.builder, merge_b);
        if (sel res_br.err) { ret res_br; }
    }

    builder.set_block(?ctx.builder, else_b);
    if (has_else) {
        val res_else_body: err[fail.Fail] = lower_stmt(ctx, s.data.if_.else_block);
        if (sel res_else_body.err) { ret res_else_body; }
    }
    if (!context.block_terminated(ctx)) {
        val res_br: err[fail.Fail] = builder.emit_br(?ctx.builder, merge_b);
        if (sel res_br.err) { ret res_br; }
    }

    builder.set_block(?ctx.builder, merge_b);
    ret err[fail.Fail].ok{};
}

fun lower_for(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val res_header: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_header.err) {
        ret err[fail.Fail].err{res_header.err};
    }
    val header: ir.BlockId = res_header.ok;

    val res_body: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_body.err) {
        ret err[fail.Fail].err{res_body.err};
    }
    val body: ir.BlockId = res_body.ok;

    val res_exit: res[ir.BlockId, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_exit.err) {
        ret err[fail.Fail].err{res_exit.err};
    }
    val exit: ir.BlockId = res_exit.ok;

    val res_enter: err[fail.Fail] = builder.emit_br(?ctx.builder, header);
    if (sel res_enter.err) { ret res_enter; }

    builder.set_block(?ctx.builder, header);
    if (s.data.for_.cond == id.EXPR_NIL) {
        val res_br: err[fail.Fail] = builder.emit_br(?ctx.builder, body);
        if (sel res_br.err) { ret res_br; }
    } or {
        val res_cond: res[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.for_.cond);
        if (sel res_cond.err) {
            ret err[fail.Fail].err{res_cond.err};
        }
        val res_condition: res[value.Value, fail.Fail] = expr.condition_value(ctx, s.data.for_.cond, res_cond.ok);
        if (sel res_condition.err) {
            ret err[fail.Fail].err{res_condition.err};
        }
        val cond: value.Value = res_condition.ok;
        val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, cond, body, exit);
        if (sel res_cbr.err) { ret res_cbr; }
    }

    val res_push: err[fail.Fail] = context.push_loop(ctx, header, exit);
    if (sel res_push.err) { ret res_push; }

    builder.set_block(?ctx.builder, body);
    val res_body_stmt: err[fail.Fail] = lower_stmt(ctx, s.data.for_.body);
    if (sel res_body_stmt.err) {
        context.pop_loop(ctx);
        ret res_body_stmt;
    }
    if (!context.block_terminated(ctx)) {
        val res_back: err[fail.Fail] = builder.emit_br(?ctx.builder, header);
        if (sel res_back.err) {
            context.pop_loop(ctx);
            ret res_back;
        }
    }

    context.pop_loop(ctx);

    builder.set_block(?ctx.builder, exit);
    ret err[fail.Fail].ok{};
}

fun lower_ret(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    if (s.data.ret_.value != id.EXPR_NIL) {
        val res_value: res[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.ret_.value);
        if (sel res_value.err) {
            ret err[fail.Fail].err{res_value.err};
        }
        var v: value.Value = res_value.ok;
        if (context.type_contains_secret(ctx, context.expr_type_of(ctx, s.data.ret_.value))) { v.secret = true; }

        val res_fins: err[fail.Fail] = replay_fins_from(ctx, 0);
        if (sel res_fins.err) { ret res_fins; }
        if (context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
        ret builder.emit_ret(?ctx.builder, v);
    }

    val res_fins: err[fail.Fail] = replay_fins_from(ctx, 0);
    if (sel res_fins.err) { ret res_fins; }
    if (context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }

    if (context.is_void_ir(ctx, ctx.ret_type)) {
        ret builder.emit_ret_void(?ctx.builder);
    }
    ret builder.emit_ret(?ctx.builder, zero_const(ctx, ctx.ret_type));
}

fun lower_brk(ctx: *context.LowerContext) err[fail.Fail] {
    val lf: *context.LoopFrame = context.current_loop(ctx);
    if (lf == nil) { ret err[fail.Fail].err{fail.message("lower: brk outside a loop")}; }

    val exit:  ir.BlockId = lf.exit;
    val floor: u32        = lf.fin_depth;
    val res_fins: err[fail.Fail] = replay_fins_from(ctx, floor);
    if (sel res_fins.err) { ret res_fins; }
    if (context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
    ret builder.emit_br(?ctx.builder, exit);
}

fun lower_cnt(ctx: *context.LowerContext) err[fail.Fail] {
    val lf: *context.LoopFrame = context.current_loop(ctx);
    if (lf == nil) { ret err[fail.Fail].err{fail.message("lower: cnt outside a loop")}; }

    val header: ir.BlockId = lf.header;
    val floor:  u32        = lf.fin_depth;
    val res_fins: err[fail.Fail] = replay_fins_from(ctx, floor);
    if (sel res_fins.err) { ret res_fins; }
    if (context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
    ret builder.emit_br(?ctx.builder, header);
}

fun lower_fin(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    ret context.push_fin(ctx, s.data.fin_.body);
}

fun replay_fins_from(ctx: *context.LowerContext, floor: u32) err[fail.Fail] {
    var i: u32 = context.fin_count(ctx);
    for (i > floor) {
        i = i - 1;
        if (context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
        val body: id.StmtId = context.fin_at(ctx, i);
        if (body != id.STMT_NIL) {
            val res_body: err[fail.Fail] = lower_stmt(ctx, body);
            if (sel res_body.err) { ret res_body; }
        }
    }
    ret err[fail.Fail].ok{};
}

fun lower_decl_stmt(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val did: id.DeclId = s.data.decl.decl;
    val opt_decl: opt[*decl.Decl] = ast.get_decl_typed(ctx.scope.a, did);
    if (sel opt_decl.none) {
        ret err[fail.Fail].err{fail.message("lower: local decl id out of range")};
    }
    val d: *decl.Decl = opt_decl.some;

    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) {
        ret err[fail.Fail].ok{};
    }

    val res_slot_ty: res[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (sel res_slot_ty.err) {
        ret err[fail.Fail].err{res_slot_ty.err};
    }
    val slot_ty: ir_type.IrTypeId = res_slot_ty.ok;

    val storage_ty: ir_type.IrTypeId = slot_ty;

    val res_count_ty: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?ctx.m.types, 64);
    if (sel res_count_ty.err) {
        ret err[fail.Fail].err{res_count_ty.err};
    }
    val count_ty: ir_type.IrTypeId = res_count_ty.ok;

    val res_slot: res[value.Value, fail.Fail] = builder.emit_alloca(?ctx.builder, storage_ty, value.const_int(1, count_ty));
    if (sel res_slot.err) {
        ret err[fail.Fail].err{res_slot.err};
    }
    val slot: value.Value = res_slot.ok;

    val sym: resolve.SymbolId = decl_symbol_of(ctx, did);
    val local_secret: bool = context.type_carries_secret(ctx, context.decl_type_of(ctx, did));
    val res_bind: err[fail.Fail] = context.bind_local(ctx, sym, slot, local_secret);
    if (sel res_bind.err) { ret res_bind; }

    var birth_val: value.Value;

    if (d.data.bind.init != id.EXPR_NIL) {
        val res_init: res[value.Value, fail.Fail] = expr.lower_rvalue(ctx, d.data.bind.init);
        if (sel res_init.err) {
            ret err[fail.Fail].err{res_init.err};
        }
        val init: value.Value = res_init.ok;
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, init, slot);
        if (sel res_store.err) { ret res_store; }
        if (context.type_is_secret(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_secret(?ctx.builder); }
        if (expr.value_is_volatile_record(ctx, d.data.bind.init)
            || expr.type_is_volatile_record(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_volatile(?ctx.builder); }
        birth_val = init;
    }
    or (ir_type.is_aggregate(?ctx.m.types, storage_ty) || ir_type.is_vector(?ctx.m.types, storage_ty)) {
        val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, storage_ty);
        if (sel res_mz.err) { ret res_mz; }
        if (context.type_is_secret(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_secret(?ctx.builder); }
        birth_val = slot;
    }
    or {
        val zc: value.Value = zero_const(ctx, slot_ty);
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, zc, slot);
        if (sel res_store.err) { ret res_store; }
        if (context.type_is_secret(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_secret(?ctx.builder); }
        birth_val = zc;
    }

    if (ctx.debug) {
        ret context.emit_dbg_birth(ctx, d.data.bind.name, slot_ty, context.decl_type_of(ctx, did), false, birth_val, opt[value.Value].some{slot});
    }
    ret err[fail.Fail].ok{};
}

fun lower_asm(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val txt: str = context.module_source(ctx);

    val res_isa: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, txt, s.data.asm_.isa);
    if (sel res_isa.err) {
        ret err[fail.Fail].err{fail.refused(res_isa.err)};
    }
    val isa_id: intern.StrId = res_isa.ok;

    val span: token.Span = s.data.asm_.body;
    val res_strip: res[str, fail.Fail] = strip_asm_comments(ctx.s.alloc, txt, span.offset, span.len);
    if (sel res_strip.err) {
        ret err[fail.Fail].err{res_strip.err};
    }
    val stripped: str = res_strip.ok;

    val body_returns: bool = asm_body_returns(ctx, stripped);

    val res_body: res[intern.StrId, A.Error] = intern.intern_bytes_typed(?ctx.s.interner, stripped, str_len(stripped));
    A.deallocate[u8](ctx.s.alloc, stripped::*u8, span.len + 1);
    if (sel res_body.err) {
        ret err[fail.Fail].err{fail.refused(res_body.err)};
    }
    val body_id: intern.StrId = res_body.ok;

    var payload: ir.IrAsm;
    payload.isa        = isa_id;
    payload.body       = body_id;
    payload.binds      = nil;
    payload.bind_count = 0;
    payload.bind_cap   = 0;

    val res_binds: err[fail.Fail] = collect_asm_binds(ctx, body_id, s.data.asm_.body, ?payload);
    if (sel res_binds.err) {
        asm_payload_free(ctx, ?payload);
        ret res_binds;
    }

    val res_emit: res[ir.InstructionId, fail.Fail] = builder.emit_asm(?ctx.builder, nil, 0);
    if (sel res_emit.err) {
        asm_payload_free(ctx, ?payload);
        ret err[fail.Fail].err{res_emit.err};
    }
    val asm_iid: ir.InstructionId = res_emit.ok;

    val res_put: res[bool, A.Error] = map.insert[ir.InstructionId, ir.IrAsm](?ctx.builder.fn.asm_blocks, asm_iid, payload);
    if (sel res_put.err) {
        asm_payload_free(ctx, ?payload);
        ret fail.discard_refused[bool](res_put);
    }

    if (!body_returns) { ret builder.emit_unreachable(?ctx.builder); }
    ret err[fail.Fail].ok{};
}

fun asm_body_returns(ctx: *context.LowerContext, body: str) bool {
    if (ctx.tgt == nil)                { ret true; }
    if (ctx.tgt.arch == nil)           { ret true; }
    if (!ctx.tgt.arch.has_assembly) { ret true; }
    ret ctx.tgt.arch.assembly.returns(body);
}

fun lower_comptime_if(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val txt: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < s.data.comptime_if.branches_len) {
        val branch_ix: u32 = s.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branch_len) {
            ret err[fail.Fail].err{fail.message("lower: comptime branch index out of range")};
        }
        val branch: *decl.ComptimeBranch = ?ctx.scope.a.comptime_branches[branch_ix];

        var active: bool = false;
        if (branch.cond == id.EXPR_NIL) {
            active = true;
        } or {
            val active_r: res[bool, fail.Fail] = context.gate_is_active(ctx, txt, branch.cond, comptime.GATE_SCOPE_INSTANCE, false);
            if (sel active_r.err) { ret err[fail.Fail].err{active_r.err}; }
            active = active_r.ok;
        }

        if (active) {
            ret lower_stmt_list(ctx, branch.body_start, branch.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_comptime_each(ctx: *context.LowerContext, s: *stmt.Stmt) err[fail.Fail] {
    val ce: *stmt.StmtComptimeEach = ?s.data.comptime_each;
    val src: str = context.module_source(ctx);

    if (is_pack_type(ctx, context.expr_type_of(ctx, ce.seq))) {
        ret lower_pack_each(ctx, ce);
    }

    val over_cases: bool = comptime.is_cases_call(ctx.scope.a, src, ce.seq);
    if (!comptime.is_fields_call(ctx.scope.a, src, ce.seq) && !over_cases) {
        if (is_array_type(ctx, context.expr_type_of(ctx, ce.seq))) {
            ret lower_const_array_each(ctx, ce);
        }
        ret err[fail.Fail].err{fail.message("lower: a `$each` sequence must be `$fields(T)`, `$cases(T)`, a variadic pack, or a constant array `val`")};
    }
    val targ: id.ExprId = comptime.fields_type_arg(ctx.scope.a, ce.seq);
    if (targ == id.EXPR_NIL) {
        ret err[fail.Fail].err{fail.message("lower: a descriptor sequence is missing its type argument")};
    }

    val raw_owner: type.TypeId = context.expr_type_of(ctx, targ);
    val deferred: bool = is_generic_param_type(ctx, raw_owner);
    var owner: type.TypeId = raw_owner;
    if (deferred) {
        if (ctx.scope.subst == nil || ctx.scope.subst_len == 0) {
            ret err[fail.Fail].ok{};
        }
        owner = context.substitute_type(ctx, raw_owner);
        if (over_cases && (type.is_secret(?ctx.s.types, owner) || !type.is_tag(?ctx.s.types, owner))) {
            diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, s.span,
                "$cases(T): type argument instantiated as a type that is not a public tag");
            ret err[fail.Fail].err{fail.reported()};
        }
        if (!over_cases && !is_fields_record_type(ctx, owner)) {
            diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, s.span,
                "$fields(T): type argument instantiated as a non-record type");
            ret err[fail.Fail].err{fail.reported()};
        }
    }

    val res_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, src, ce.var_name);
    if (sel res_name.err) {
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val fname: intern.StrId = res_name.ok;

    val n: u32 = type.field_count(?ctx.s.types, owner);
    var i: u32 = 0;
    for (i < n) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open_typed(ctx.scope.ctx);
        if (sel mark_r.err) {
            ret err[fail.Fail].err{mark_r.err};
        }
        val mark: comptime.FrameMark = mark_r.ok;
        var desc: comptime.CTValue = comptime.field_value(owner::u32, i);
        if (over_cases) { desc = comptime.case_value(owner::u32, i); }
        val res_bind: err[fail.Fail] = comptime.bind_typed(ctx.scope.ctx, fname, desc);
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }

        val res_reinfer: err[fail.Fail] = sema.reinfer_pack_each_body_typed(ctx.s, ctx.scope.a, ctx.scope.rr, ctx.deps, ctx.scope.ctx,
            ctx.scope.own_module, ctx.scope.sema_result, ctx.fn_ret_sem, ce.body_start, ce.body_len,
            ctx.scope.subst, ctx.scope.subst_len, ctx.ct_insts, ctx.diags);
        if (sel res_reinfer.err) {
            val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_reinfer;
        }

        val res_body: err[fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
        if (sel res_body.err) {
            ret res_body;
        }
        if (sel res_close.err) {
            ret res_close;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_pack_each(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach) err[fail.Fail] {
    val src: str = context.module_source(ctx);
    val res_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, src, ce.var_name);
    if (sel res_name.err) {
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val fname: intern.StrId = res_name.ok;

    var i: u32 = 0;
    for (i < ctx.pack_len) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open_typed(ctx.scope.ctx);
        if (sel mark_r.err) {
            ret err[fail.Fail].err{mark_r.err};
        }
        val mark: comptime.FrameMark = mark_r.ok;
        val desc: comptime.CTValue = comptime.pack_elem_value(i, ctx.pack_types[i]::u32);
        val res_bind: err[fail.Fail] = comptime.bind_typed(ctx.scope.ctx, fname, desc);
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }

        val res_reinfer: err[fail.Fail] = sema.reinfer_pack_each_body_typed(ctx.s, ctx.scope.a, ctx.scope.rr, ctx.deps, ctx.scope.ctx,
            ctx.scope.own_module, ctx.scope.sema_result, ctx.pack_ret_type, ce.body_start, ce.body_len,
            ctx.scope.subst, ctx.scope.subst_len, ctx.ct_insts, ctx.diags);
        if (sel res_reinfer.err) {
            val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_reinfer;
        }

        val res_body: err[fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
        if (sel res_body.err) {
            ret res_body;
        }
        if (sel res_close.err) {
            ret res_close;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_const_array_each(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach) err[fail.Fail] {
    val seq_ty: type.TypeId = context.expr_type_of(ctx, ce.seq);
    val opt_arr: opt[*type.Type] = type.get_typed(?ctx.s.types, seq_ty);
    if (sel opt_arr.none) { ret err[fail.Fail].err{fail.message("lower: `$each` array sequence has no type")}; }
    val arr: *type.Type = opt_arr.some;
    val elem_ty: type.TypeId = arr.data.array.base;
    val count:   u32         = arr.data.array.count;

    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, ce.seq);
    val opt_sym: opt[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (sel opt_sym.none) { ret err[fail.Fail].err{fail.message("lower: `$each` array sequence is unresolved")}; }
    val sym: *resolve.Symbol = opt_sym.some;

    if (sym.origin == ctx.scope.own_module) {
        ret lower_const_array_each_local(ctx, ce, sym, elem_ty, count);
    }
    ret lower_const_array_each_imported(ctx, ce, sym, elem_ty, count);
}

fun lower_const_array_each_local(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach,
                                 sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) err[fail.Fail] {
    val src: str = context.module_source(ctx);

    val opt_info: opt[comptime.ArrayLitInfo] = comptime.decl_array_lit_typed(ctx.scope.a, sym.decl);
    if (sel opt_info.none) { ret err[fail.Fail].err{fail.message("lower: `$each` array sequence has no array-literal initializer")}; }
    val info: comptime.ArrayLitInfo = opt_info.some;

    val res_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, src, ce.var_name);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    var i: u32 = 0;
    for (i < count) {
        if ((info.elems_start + i)::usize >= ctx.scope.a.expr_id_len) {
            ret err[fail.Fail].err{fail.message("lower: `$each` array element index out of range")};
        }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[info.elems_start + i];
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open_typed(ctx.scope.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark: comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail] = comptime.bind_typed(ctx.scope.ctx, fname, comptime.const_elem_value(elem_eid::u32, elem_ty::u32));
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }
        val res_body:  err[fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_const_array_each_imported(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach,
                                    sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) err[fail.Fail] {
    val acquired: res[context.ModuleScope, fail.Fail] = context.origin_scope(ctx, sym.origin);
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val osc: context.ModuleScope = acquired.ok;
    val selected: res[scx.DefinedSymbol, fail.Fail] = context.symbol_definition(ctx, sym);
    if (sel selected.err) { ret err[fail.Fail].err{selected.err}; }
    val current: scx.DefinedSymbol = selected.ok;
    val oa: *ast.Ast = osc.a;
    val octx: *comptime.ComptimeCtx = osc.ctx;

    val od_opt: opt[*decl.Decl] = ast.get_decl_typed(oa, current.symbol.decl);
    if (sel od_opt.none) { ret err[fail.Fail].err{fail.message("lower: `$each` array sequence is unresolved")}; }
    if (od_opt.some.kind != decl.DECL_KIND_VAL) {
        ret err[fail.Fail].err{fail.message("lower: `$each` array sequence must name an immutable `val`")};
    }

    val opt_info: opt[comptime.ArrayLitInfo] = comptime.decl_array_lit_typed(oa, current.symbol.decl);
    if (sel opt_info.none) { ret err[fail.Fail].err{fail.message("lower: `$each` array sequence has no array-literal initializer")}; }
    val info: comptime.ArrayLitInfo = opt_info.some;

    val src: str = context.module_source(ctx);
    val res_name: res[intern.StrId, A.Error] = intern.intern_span_typed(?ctx.s.interner, src, ce.var_name);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    val o_source: str = context.ast_source(ctx, oa);

    var out_err: str = nil;
    var i: u32 = 0;
    for (i < count) {
        if ((info.elems_start + i)::usize >= oa.expr_id_len) {
            out_err = "lower: `$each` array element index out of range";
            brk;
        }
        val elem_eid: id.ExprId = oa.expr_ids[info.elems_start + i];

        val mark_o: res[context.ScopeMark, fail.Fail] = context.scope_enter(ctx, osc);
        if (sel mark_o.err) {
            out_err = fail.describe(mark_o.err);
            brk;
        }
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](octx, ctx, ctx.caps, oa, o_source, elem_eid, ?ctx.s.interner);
        context.record_eval_result(ctx, res_eval);
        val leave_o: err[fail.Fail] = context.scope_leave(ctx, mark_o.ok);
        if (sel leave_o.err) {
            out_err = fail.describe(leave_o.err);
            brk;
        }

        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            out_err = R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message;
            brk;
        }
        var ev: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval);

        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open_typed(ctx.scope.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark: comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail] = comptime.bind_typed(ctx.scope.ctx, fname, ev);
        if (sel res_bind.err) {
            val res_close_err: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
            if (sel res_close_err.err) {
                out_err = fail.describe(res_close_err.err);
                brk;
            }
            out_err = fail.describe(res_bind.err);
            brk;
        }
        val res_body:  err[fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: err[fail.Fail] = comptime.frame_close_typed(ctx.scope.ctx, mark);
        if (sel res_body.err) {
            out_err = fail.describe(res_body.err);
            brk;
        }
        if (sel res_close.err) {
            out_err = fail.describe(res_close.err);
            brk;
        }
        i = i + 1;
    }

    if (out_err != nil) { ret err[fail.Fail].err{fail.message(out_err)}; }
    ret err[fail.Fail].ok{};
}

fun strip_asm_comments(a: *A.Allocator, src: str, offset: usize, len: usize) res[str, fail.Fail] {
    val res_buf: res[*u8, A.Error] = A.allocate[u8](a, len + 1);
    if (sel res_buf.err) {
        ret res[str, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val out: *u8 = res_buf.ok;

    var i: usize = 0;
    var o: usize = 0;
    for (i < len) {
        val c: u8 = src[offset + i];
        if (c == '#'::char) {
            for (i < len && src[offset + i] != '\n'::char) { i = i + 1; }
            cnt;
        }
        out[o] = c;
        o = o + 1;
        i = i + 1;
    }
    out[o] = 0;
    ret res[str, fail.Fail].ok{out::str};
}

fun collect_asm_binds(ctx: *context.LowerContext, body_id: intern.StrId, body_span: token.Span, payload: *ir.IrAsm) err[fail.Fail] {
    val opt_body: opt[str] = intern.lookup_typed(?ctx.s.interner, body_id);
    if (sel opt_body.none) {
        ret err[fail.Fail].err{fail.message("lower: inline-asm body interning failed")};
    }
    val body: str = opt_body.some;

    var i: usize = 0;
    for (body[i] != 0) {
        if (body[i] != '{'::char) { i = i + 1; cnt; }

        val name_start: usize = i + 1;
        var j: usize = name_start;
        for (body[j] != 0 && body[j] != '}'::char) { j = j + 1; }
        if (body[j] == 0) {
            ret report_asm(ctx, body_span, "unterminated '{' in inline asm body");
        }
        val name_len: usize = j - name_start;
        if (name_len == 0) {
            ret report_asm(ctx, body_span, "empty '{}' in asm body; write '{name}' to reference a local");
        }

        val res_name: res[intern.StrId, A.Error] = intern.intern_bytes_typed(?ctx.s.interner, (body::usize + name_start)::str, name_len);
        if (sel res_name.err) {
            ret err[fail.Fail].err{fail.refused(res_name.err)};
        }
        val name_id: intern.StrId = res_name.ok;

        val res_add: err[fail.Fail] = add_asm_bind(ctx, body_span, payload, name_id);
        if (sel res_add.err) { ret res_add; }

        i = j + 1;
    }
    ret err[fail.Fail].ok{};
}

fun add_asm_bind(ctx: *context.LowerContext, body_span: token.Span, payload: *ir.IrAsm, name_id: intern.StrId) err[fail.Fail] {
    var i: u32 = 0;
    for (i < payload.bind_count) {
        if (payload.binds[i].name == name_id) { ret err[fail.Fail].ok{}; }
        i = i + 1;
    }

    val opt_local: opt[context.LocalBinding] = context.lookup_local_name(ctx, name_id);
    if (sel opt_local.none) {
        ret report_asm_named(ctx, body_span, "unknown local '", name_id, "' in inline asm; only stack-allocated variables in scope can be referenced");
    }
    val lb: context.LocalBinding = opt_local.some;
    val v: value.Value = lb.value;
    if (v.kind != value.VAL_INSTR) {
        ret report_asm_named(ctx, body_span, "'", name_id, "' is not stack-allocated and cannot be used in inline asm");
    }

    if (payload.bind_count == payload.bind_cap) {
        val new_cap: u32 = grow_bind_cap(payload.bind_cap);
        var nb: *ir.IrAsmBind = nil;
        if (payload.binds == nil) {
            val res_alloc: res[*ir.IrAsmBind, A.Error] = A.allocate[ir.IrAsmBind](ctx.m.alloc, new_cap::usize);
            if (sel res_alloc.err) {
                ret err[fail.Fail].err{fail.refused(res_alloc.err)};
            }
            nb = res_alloc.ok;
        } or {
            val res_grow: res[*ir.IrAsmBind, A.Error] = A.reallocate[ir.IrAsmBind](ctx.m.alloc, payload.binds, payload.bind_cap::usize, new_cap::usize);
            if (sel res_grow.err) {
                ret err[fail.Fail].err{fail.refused(res_grow.err)};
            }
            nb = res_grow.ok;
        }
        payload.binds    = nb;
        payload.bind_cap = new_cap;
    }

    payload.binds[payload.bind_count].name   = name_id;
    payload.binds[payload.bind_count].instr  = v.data.instr;
    payload.binds[payload.bind_count].secret = lb.secret;
    payload.bind_count = payload.bind_count + 1;
    ret err[fail.Fail].ok{};
}

fun asm_payload_free(ctx: *context.LowerContext, payload: *ir.IrAsm) {
    if (payload.binds == nil) { ret; }
    A.deallocate[ir.IrAsmBind](ctx.m.alloc, payload.binds, payload.bind_cap::usize);
}

fun grow_bind_cap(cap: u32) u32 {
    if (cap == 0) { ret ASM_BIND_INIT_CAP; }
    ret cap * 2;
}

fun report_asm(ctx: *context.LowerContext, span: token.Span, message: str) err[fail.Fail] {
    diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, span, message);
    ret err[fail.Fail].err{fail.reported()};
}


fun report_asm_named(ctx: *context.LowerContext, span: token.Span, prefix: str, name_id: intern.StrId, suffix: str) err[fail.Fail] {
    val opt_name: opt[str] = intern.lookup_typed(?ctx.s.interner, name_id);
    if (sel opt_name.none) { ret report_asm(ctx, span, prefix); }
    val name: str = opt_name.some;

    val res_msg: res[str, string.StrError] = str_join(ctx.s.alloc, prefix, name, suffix);
    if (sel res_msg.err) { ret report_asm(ctx, span, prefix); }
    val buf: str = res_msg.ok;

    diagnostic.record_error(ctx.diags, ctx.scope.a.file_id, span, buf);
    A.deallocate[u8](ctx.s.alloc, buf::*u8, str_len(buf) + 1);
    ret err[fail.Fail].err{fail.reported()};
}

fun zero_const(ctx: *context.LowerContext, tid: ir_type.IrTypeId) value.Value {
    val opt_ty: opt[*ir_type.IrType] = ir_type.get(?ctx.m.types, tid);
    if (sel opt_ty.some) {
        if (opt_ty.some.kind == ir_type.IRT_FLOAT) {
            ret value.const_float(0.0, tid);
        }
    }
    ret value.const_int(0, tid);
}

fun is_pack_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get_typed(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    ret opt_ty.some.kind == type.TYPE_PACK;
}

fun is_array_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get_typed(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    ret opt_ty.some.kind == type.TYPE_ARRAY;
}

fun is_generic_param_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get_typed(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    ret opt_ty.some.kind == type.TYPE_GENERIC_PARAM;
}

fun is_fields_record_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get_typed(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    val k: type.TypeKind = opt_ty.some.kind;
    if (k == type.TYPE_REC)                                                                            { ret true; }
    val r_899: opt[*type.FieldTable] = type.field_table_for_typed(?ctx.s.types, t);
    if (k == type.TYPE_INSTANCE && sel r_899.some) { ret true; }
    ret false;
}

fun decl_symbol_of(ctx: *context.LowerContext, did: id.DeclId) resolve.SymbolId {
    if (did == id.DECL_NIL)              { ret resolve.SYMBOL_NIL; }
    if (did::usize >= ctx.scope.rr.decl_count) { ret resolve.SYMBOL_NIL; }
    ret ctx.scope.rr.decl_symbol[did];
}
