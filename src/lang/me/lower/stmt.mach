use mach.lang.growth;
use std.collections.map;
use std.collections.slice.Slice;
use collections_vector: std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use types_string: std.types.string;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use fe_asm: mach.lang.fe.asm;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_id:   mach.lang.fe.ast.id;
use ast_stmt: mach.lang.fe.ast.stmt;
use mach.lang.fe.comptime;
use comptime_deep: mach.lang.fe.comptime.deep;
use comptime_gate: mach.lang.fe.comptime.gate;
use mach.lang.fe.comptime.intrinsic;
use mach.lang.fe.resolve;
use mach.lang.intern;
use mach.lang.me.lower.builder;
use lower_context: mach.lang.me.lower.context;
use lower_expr:    mach.lang.me.lower.expr;
use mach.lang.me.lower.irt;
use mach.lang.me.lower.value;
use lang_source: mach.lang.source;
use mach.lang.stack;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.type;
use masc_operand:  masc.core.operand;
use masc_inline:   masc.inline.inline;
use mirl_assembly: mirl.ir.assembly;
use mirl.ir.id;
use mirl.ir.type.Type;

pub fun lower_stmt(ctx: *lower_context.LowerContext, sid: ast_id.StmtId) err[fail.Fail] {
    val opt_stmt: opt[*ast_stmt.Stmt] = ast.get_stmt(ctx.scope.a, sid);
    if (sel opt_stmt.none) {
        ret err[fail.Fail].err{fail.message("lower: statement id out of range")};
    }
    val s: *ast_stmt.Stmt = opt_stmt.some;
    if (stack.exhausted()) { ret err[fail.Fail].err{lower_context.refuse_nesting(ctx, s.span)}; }

    val saved_loc: lang_source.Location = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, lang_source.location(ctx.scope.a.file_id, s.span));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val k: ast_stmt.StmtKind = s.kind;

    if (k == ast_stmt.STMT_KIND_EXPR)          { ret lower_expr_stmt(ctx, s); }
    if (k == ast_stmt.STMT_KIND_BLOCK)         { ret lower_block(ctx, s); }
    if (k == ast_stmt.STMT_KIND_IF)            { ret lower_if(ctx, s); }
    if (k == ast_stmt.STMT_KIND_FOR)           { ret lower_for(ctx, s); }
    if (k == ast_stmt.STMT_KIND_RET)           { ret lower_ret(ctx, s); }
    if (k == ast_stmt.STMT_KIND_BRK)           { ret lower_brk(ctx); }
    if (k == ast_stmt.STMT_KIND_CNT)           { ret lower_cnt(ctx); }
    if (k == ast_stmt.STMT_KIND_FIN)           { ret lower_fin(ctx, s); }
    if (k == ast_stmt.STMT_KIND_DECL)          { ret lower_decl_stmt(ctx, s); }
    if (k == ast_stmt.STMT_KIND_ASM)           { ret lower_asm(ctx, sid, s); }
    if (k == ast_stmt.STMT_KIND_COMPTIME_IF)   { ret lower_comptime_if(ctx, s); }
    if (k == ast_stmt.STMT_KIND_COMPTIME_EACH) { ret lower_comptime_each(ctx, sid, s); }

    if (k == ast_stmt.STMT_KIND_COMPTIME_DIRECTIVE) { ret err[fail.Fail].ok{}; }

    if (k == ast_stmt.STMT_KIND_ERROR) {
        ret err[fail.Fail].err{fail.message("lower: error statement reached the middle end")};
    }

    ret err[fail.Fail].err{fail.message("lower: unsupported statement kind")};
}

fun lower_stmt_list(ctx: *lower_context.LowerContext, start: u32, len: u32) err[fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        if (lower_context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= ctx.scope.a.stmt_ids.len) {
            ret err[fail.Fail].err{fail.message("lower: statement list index out of range")};
        }
        val res_stmt: err[fail.Fail] = lower_stmt(ctx, ctx.scope.a.stmt_ids.data[pool_ix]);
        if (sel res_stmt.err) { ret res_stmt; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_expr_stmt(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    val saved_discard: ast_id.ExprId = ctx.discard_eid;
    ctx.discard_eid = s.data.expr.expr;
    val res_value: res[value.Value, fail.Fail] = lower_expr.lower_rvalue(ctx, s.data.expr.expr);
    ctx.discard_eid = saved_discard;
    if (sel res_value.err) {
        ret err[fail.Fail].err{res_value.err};
    }
    ret err[fail.Fail].ok{};
}

fun lower_block(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    val mark:     u32            = lower_context.fin_count(ctx);
    val res_body: err[fail.Fail] = lower_stmt_list(ctx, s.data.block.stmts_start, s.data.block.stmts_len);
    if (sel res_body.err) {
        lower_context.pop_fins_to(ctx, mark);
        ret res_body;
    }
    if (!lower_context.block_terminated(ctx)) {
        val res_fins: err[fail.Fail] = replay_fins_from(ctx, mark);
        if (sel res_fins.err) {
            lower_context.pop_fins_to(ctx, mark);
            ret res_fins;
        }
    }
    lower_context.pop_fins_to(ctx, mark);
    ret err[fail.Fail].ok{};
}

fun lower_if(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    val res_cond: res[value.Value, fail.Fail] = lower_expr.lower_rvalue(ctx, s.data.if_.cond);
    if (sel res_cond.err) {
        ret err[fail.Fail].err{res_cond.err};
    }
    val res_condition: res[value.Value, fail.Fail] = lower_expr.condition_value(ctx, s.data.if_.cond, res_cond.ok);
    if (sel res_condition.err) {
        ret err[fail.Fail].err{res_condition.err};
    }
    val cond: value.Value = res_condition.ok;

    val res_then: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_then.err) {
        ret err[fail.Fail].err{res_then.err};
    }
    val then_b: id.Block = res_then.ok;

    val res_else: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_else.err) {
        ret err[fail.Fail].err{res_else.err};
    }
    val else_b: id.Block = res_else.ok;

    val res_merge: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_merge.err) {
        ret err[fail.Fail].err{res_merge.err};
    }
    val merge_b: id.Block = res_merge.ok;

    val has_else: bool = !ast_id.stmt_is_nil(s.data.if_.else_block);

    val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, cond, then_b, else_b);
    if (sel res_cbr.err) { ret res_cbr; }

    builder.set_block(?ctx.builder, then_b);
    val res_then_body: err[fail.Fail] = lower_stmt(ctx, s.data.if_.then_block);
    if (sel res_then_body.err) { ret res_then_body; }
    if (!lower_context.block_terminated(ctx)) {
        val res_br: err[fail.Fail] = builder.emit_br(?ctx.builder, merge_b);
        if (sel res_br.err) { ret res_br; }
    }

    builder.set_block(?ctx.builder, else_b);
    if (has_else) {
        val res_else_body: err[fail.Fail] = lower_stmt(ctx, s.data.if_.else_block);
        if (sel res_else_body.err) { ret res_else_body; }
    }
    if (!lower_context.block_terminated(ctx)) {
        val res_br: err[fail.Fail] = builder.emit_br(?ctx.builder, merge_b);
        if (sel res_br.err) { ret res_br; }
    }

    builder.set_block(?ctx.builder, merge_b);
    ret err[fail.Fail].ok{};
}

fun lower_for(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    val res_header: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_header.err) {
        ret err[fail.Fail].err{res_header.err};
    }
    val header: id.Block = res_header.ok;

    val res_body: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_body.err) {
        ret err[fail.Fail].err{res_body.err};
    }
    val body: id.Block = res_body.ok;

    val res_exit: res[id.Block, fail.Fail] = builder.new_block(?ctx.builder);
    if (sel res_exit.err) {
        ret err[fail.Fail].err{res_exit.err};
    }
    val exit: id.Block = res_exit.ok;

    val res_enter: err[fail.Fail] = builder.emit_br(?ctx.builder, header);
    if (sel res_enter.err) { ret res_enter; }

    builder.set_block(?ctx.builder, header);
    if (ast_id.expr_is_nil(s.data.for_.cond)) {
        val res_br: err[fail.Fail] = builder.emit_br(?ctx.builder, body);
        if (sel res_br.err) { ret res_br; }
    }
    or {
        val res_cond: res[value.Value, fail.Fail] = lower_expr.lower_rvalue(ctx, s.data.for_.cond);
        if (sel res_cond.err) {
            ret err[fail.Fail].err{res_cond.err};
        }
        val res_condition: res[value.Value, fail.Fail] = lower_expr.condition_value(ctx, s.data.for_.cond, res_cond.ok);
        if (sel res_condition.err) {
            ret err[fail.Fail].err{res_condition.err};
        }
        val cond:    value.Value    = res_condition.ok;
        val res_cbr: err[fail.Fail] = builder.emit_cbr(?ctx.builder, cond, body, exit);
        if (sel res_cbr.err) { ret res_cbr; }
    }

    val res_push: err[fail.Fail] = lower_context.push_loop(ctx, header, exit);
    if (sel res_push.err) { ret res_push; }

    builder.set_block(?ctx.builder, body);
    val res_body_stmt: err[fail.Fail] = lower_stmt(ctx, s.data.for_.body);
    if (sel res_body_stmt.err) {
        lower_context.pop_loop(ctx);
        ret res_body_stmt;
    }
    if (!lower_context.block_terminated(ctx)) {
        val res_back: err[fail.Fail] = builder.emit_br(?ctx.builder, header);
        if (sel res_back.err) {
            lower_context.pop_loop(ctx);
            ret res_back;
        }
    }

    lower_context.pop_loop(ctx);

    builder.set_block(?ctx.builder, exit);
    ret err[fail.Fail].ok{};
}

fun lower_ret(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    if (!ast_id.expr_is_nil(s.data.ret_.value)) {
        val res_value: res[value.Value, fail.Fail] = lower_expr.lower_rvalue(ctx, s.data.ret_.value);
        if (sel res_value.err) {
            ret err[fail.Fail].err{res_value.err};
        }
        var v: value.Value = res_value.ok;
        if (lower_context.type_contains_secret(ctx, lower_context.expr_type_of(ctx, s.data.ret_.value))) { v.secret = true; }

        val res_fins: err[fail.Fail] = replay_fins_from(ctx, 0);
        if (sel res_fins.err)                    { ret res_fins; }
        if (lower_context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
        ret builder.emit_ret(?ctx.builder, v);
    }

    val res_fins: err[fail.Fail] = replay_fins_from(ctx, 0);
    if (sel res_fins.err)                    { ret res_fins; }
    if (lower_context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }

    if (lower_context.is_void_ir(ctx, ctx.ret_type)) {
        ret builder.emit_ret_void(?ctx.builder);
    }
    ret builder.emit_ret(?ctx.builder, zero_const(ctx, ctx.ret_type));
}

fun lower_brk(ctx: *lower_context.LowerContext) err[fail.Fail] {
    val lf: *lower_context.LoopFrame = lower_context.current_loop(ctx);
    if (lf == nil) { ret err[fail.Fail].err{fail.message("lower: brk outside a loop")}; }

    val exit:     id.Block       = lf.exit;
    val floor:    u32            = lf.fin_depth;
    val res_fins: err[fail.Fail] = replay_fins_from(ctx, floor);
    if (sel res_fins.err)                    { ret res_fins; }
    if (lower_context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
    ret builder.emit_br(?ctx.builder, exit);
}

fun lower_cnt(ctx: *lower_context.LowerContext) err[fail.Fail] {
    val lf: *lower_context.LoopFrame = lower_context.current_loop(ctx);
    if (lf == nil) { ret err[fail.Fail].err{fail.message("lower: cnt outside a loop")}; }

    val header:   id.Block       = lf.header;
    val floor:    u32            = lf.fin_depth;
    val res_fins: err[fail.Fail] = replay_fins_from(ctx, floor);
    if (sel res_fins.err)                    { ret res_fins; }
    if (lower_context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
    ret builder.emit_br(?ctx.builder, header);
}

fun lower_fin(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    ret lower_context.push_fin(ctx, s.data.fin_.body);
}

fun replay_fins_from(ctx: *lower_context.LowerContext, floor: u32) err[fail.Fail] {
    var i: u32 = lower_context.fin_count(ctx);
    for (i > floor) {
        i = i - 1;
        if (lower_context.block_terminated(ctx)) { ret err[fail.Fail].ok{}; }
        val body: ast_id.StmtId = lower_context.fin_at(ctx, i);
        if (!ast_id.stmt_is_nil(body)) {
            val res_body: err[fail.Fail] = lower_stmt(ctx, body);
            if (sel res_body.err) { ret res_body; }
        }
    }
    ret err[fail.Fail].ok{};
}

fun lower_decl_stmt(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    val did:      ast_id.DeclId       = s.data.decl.decl;
    val opt_decl: opt[*ast_decl.Decl] = ast.get_decl(ctx.scope.a, did);
    if (sel opt_decl.none) {
        ret err[fail.Fail].err{fail.message("lower: local decl id out of range")};
    }
    val d: *ast_decl.Decl = opt_decl.some;

    if (d.kind != ast_decl.DECL_KIND_VAL && d.kind != ast_decl.DECL_KIND_VAR) {
        ret err[fail.Fail].ok{};
    }

    val res_slot_ty: res[Type, fail.Fail] = lower_context.lower_type(ctx, lower_context.decl_type_of(ctx, did));
    if (sel res_slot_ty.err) {
        ret err[fail.Fail].err{res_slot_ty.err};
    }
    val slot_ty:    Type = res_slot_ty.ok;
    var storage_ty: Type = slot_ty;

    # a pointer is held at the class of the storage its initializer points into
    var early: opt[value.Value] = opt[value.Value].none{};
    if (irt.is_ptr(?ctx.m.types, slot_ty) && !ast_id.expr_is_nil(d.data.bind.init)) {
        var borrowed_ptr: bool                        = false;
        val res_first:    res[value.Value, fail.Fail] = lower_expr.lower_stored_rvalue(ctx, d.data.bind.init, true, ?borrowed_ptr);
        if (sel res_first.err) { ret err[fail.Fail].err{res_first.err}; }
        early = opt[value.Value].some{res_first.ok};
        if (irt.is_ptr(?ctx.m.types, res_first.ok.ty)) { storage_ty = res_first.ok.ty; }
    }

    val res_slot: res[value.Value, fail.Fail] = lower_context.slot_for(ctx, lower_context.decl_type_of(ctx, did), storage_ty);
    if (sel res_slot.err) {
        ret err[fail.Fail].err{res_slot.err};
    }
    val slot: value.Value = res_slot.ok;

    val sym:      resolve.SymbolId = decl_symbol_of(ctx, did);
    val res_bind: err[fail.Fail]   = lower_context.bind_local(ctx, sym, slot);
    if (sel res_bind.err) { ret res_bind; }

    var birth_val: value.Value;

    if (!ast_id.expr_is_nil(d.data.bind.init)) {
        # the slot is fresh storage and the store follows the read directly, so an aggregate
        # initializer is copied from its source with no snapshot
        var init: value.Value = value.none();
        if (sel early.some) { init = early.some; }
        or {
            var borrowed: bool                        = false;
            val res_init: res[value.Value, fail.Fail] = lower_expr.lower_stored_rvalue(ctx, d.data.bind.init, true, ?borrowed);
            if (sel res_init.err) {
                ret err[fail.Fail].err{res_init.err};
            }
            init = res_init.ok;
        }
        val res_store: err[fail.Fail] = builder.emit_store_marked(?ctx.builder, init, slot, lower_expr.type_is_volatile_record(ctx, lower_context.decl_type_of(ctx, did)));
        if (sel res_store.err) { ret res_store; }
        birth_val = init;
        # an aggregate lives in its own slot, never in the source or a temporary it came from
        if (irt.is_aggregate(?ctx.m.types, storage_ty)) { birth_val = slot; }
    }
    or (irt.is_aggregate(?ctx.m.types, storage_ty) || irt.is_vector(?ctx.m.types, storage_ty)) {
        val res_mz: err[fail.Fail] = builder.emit_memzero(?ctx.builder, slot, storage_ty);
        if (sel res_mz.err) { ret res_mz; }
        birth_val = slot;
    }
    or {
        val zc:        value.Value    = zero_const(ctx, slot_ty);
        val res_store: err[fail.Fail] = builder.emit_store(?ctx.builder, zc, slot);
        if (sel res_store.err) { ret res_store; }
        birth_val = zc;
    }

    if (ctx.debug) {
        ret lower_context.emit_dbg_birth(ctx, d.data.bind.name, lower_context.decl_type_of(ctx, did), opt[u32].none{}, birth_val, opt[value.Value].some{slot});
    }
    ret err[fail.Fail].ok{};
}

# an asm block, handed to mirl as an inline assembly item: its text with its comments blanked,
# so every offset is the source's, and each `{name}` a memory operand the block reads and
# writes, bound to the local's slot. the block may reach any memory through its registers
fun lower_asm(ctx: *lower_context.LowerContext, sid: ast_id.StmtId, s: *ast_stmt.Stmt) err[fail.Fail] {
    val txt:       str                 = lower_context.module_source(ctx);
    val span:      lang_source.Span    = s.data.asm_.body;
    val res_strip: res[str, fail.Fail] = fe_asm.comments_strip(ctx.s.alloc, txt, span);
    if (sel res_strip.err) { ret err[fail.Fail].err{res_strip.err}; }
    val stripped: str = res_strip.ok;
    fin { A.deallocate[u8](ctx.s.alloc, stripped::*u8, span.len + 1); }

    var binds: collections_vector.Vector[resolve.AsmBind] = collections_vector.init[resolve.AsmBind](ctx.s.alloc);
    fin { collections_vector.dnit[resolve.AsmBind](?binds); }
    val got: err[fail.Fail] = resolve.asm_binds_at(ctx.scope.rr, sid, ?binds);
    if (sel got.err) { ret got; }
    if (binds.len > mirl_assembly.MOST_OPERANDS::usize) {
        fail.reject(?ctx.status);
        val loc: lang_source.Location = lang_source.location(ctx.scope.a.file_id, s.span);
        ret err[fail.Fail].err{diagnostic.reject(ctx.diags, diagnostic_kind.ASM_OPERAND, loc, "an asm block binds more than 30 locals")};
    }

    var operands: collections_vector.Vector[mirl_assembly.Operand] = collections_vector.init[mirl_assembly.Operand](ctx.s.alloc);
    fin { collections_vector.dnit[mirl_assembly.Operand](?operands); }
    var values: collections_vector.Vector[value.Value] = collections_vector.init[value.Value](ctx.s.alloc);
    fin { collections_vector.dnit[value.Value](?values); }
    var i: usize = 0;
    for (i < binds.len) {
        val b:    *resolve.AsmBind = ?binds.data[i];
        val slot: opt[value.Value] = lower_context.lookup_local(ctx, b.symbol);
        if (sel slot.none) { ret err[fail.Fail].err{fail.message("lower: an asm block names a local lowering never bound")}; }
        val name: str                   = intern.text(?ctx.s.interner, b.name);
        val op:   mirl_assembly.Operand = mirl_assembly.Operand{
            name:       View{data: name::*u8, len: str_len(name)},
            role:       masc_operand.READ_WRITE,
            constraint: masc_inline.Constraint.memory{},
            ty:         builder.ptr_type(?ctx.builder)
        };
        val pushed: res[usize, A.Error] = collections_vector.push[mirl_assembly.Operand](?operands, op);
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        val held: res[usize, A.Error] = collections_vector.push[value.Value](?values, slot.some);
        if (sel held.err) { ret err[fail.Fail].err{fail.refused(held.err)}; }
        i = i + 1;
    }
    var block: mirl_assembly.Assembly = mirl_assembly.Assembly{
        text:     View{data: stripped::*u8, len: span.len},
        operands: Slice[mirl_assembly.Operand]{data: operands.data, size: operands.len},
        reads:    true,
        writes:   true
    };
    ret builder.emit_asm(?ctx.builder, ?block, values.data, values.len::u32);
}

fun lower_comptime_if(ctx: *lower_context.LowerContext, s: *ast_stmt.Stmt) err[fail.Fail] {
    var i: u32 = 0;
    for (i < s.data.comptime_if.branches_len) {
        val branch_ix: u32 = s.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branches.len) {
            ret err[fail.Fail].err{fail.message("lower: comptime branch index out of range")};
        }
        val branch: *ast_decl.ComptimeBranch = ?ctx.scope.a.comptime_branches.data[branch_ix];

        var active: bool = false;
        if (ast_id.expr_is_nil(branch.cond)) {
            active = true;
        }
        or {
            val verdict: opt[bool] = lower_context.gate_of(ctx, branch.cond);
            if (sel verdict.none) { ret err[fail.Fail].err{fail.message("lower: sema gave a statement gate no verdict in this frame")}; }
            active = verdict.some;
        }

        if (active) {
            ret lower_stmt_list(ctx, branch.body_start, branch.body_len);
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# one iteration of the `$each` at `sid`, read through the frame sema typed it in
fun lower_each_body(ctx: *lower_context.LowerContext, sid: ast_id.StmtId, index: u32, ce: *ast_stmt.StmtComptimeEach) err[fail.Fail] {
    val frame: res[u32, fail.Fail] = lower_context.iteration_frame(ctx, sid, index);
    if (sel frame.err) { ret err[fail.Fail].err{frame.err}; }
    val saved: u32 = ctx.scope.frame;
    ctx.scope.frame = frame.ok;
    val r: err[fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
    ctx.scope.frame = saved;
    ret r;
}

fun lower_comptime_each(ctx: *lower_context.LowerContext, sid: ast_id.StmtId, s: *ast_stmt.Stmt) err[fail.Fail] {
    val ce:  *ast_stmt.StmtComptimeEach = ?s.data.comptime_each;
    val src: str                        = lower_context.module_source(ctx);

    if (is_pack_type(ctx, lower_context.expr_type_of(ctx, ce.seq))) {
        ret lower_pack_each(ctx, sid, ce);
    }

    val over_cases: bool = intrinsic.is_cases_call(ctx.scope.a, src, ce.seq);
    if (!intrinsic.is_fields_call(ctx.scope.a, src, ce.seq) && !over_cases) {
        if (is_array_type(ctx, lower_context.expr_type_of(ctx, ce.seq))) {
            ret lower_const_array_each(ctx, sid, ce);
        }
        ret err[fail.Fail].err{fail.message("lower: a `$each` sequence must be `$fields(T)`, `$cases(T)`, a variadic pack, or a constant array `val`")};
    }
    val targ: ast_id.ExprId = intrinsic.fields_type_arg(ctx.scope.a, ce.seq);
    if (ast_id.expr_is_nil(targ)) {
        ret err[fail.Fail].err{fail.message("lower: a descriptor sequence is missing its type argument")};
    }

    val raw_owner: type.TypeId = lower_context.expr_type_of(ctx, targ);
    val deferred:  bool        = is_generic_param_type(ctx, raw_owner);
    var owner:     type.TypeId = raw_owner;
    if (deferred) {
        if (ctx.scope.subst == nil || ctx.scope.subst_len == 0) {
            ret err[fail.Fail].ok{};
        }
        owner = lower_context.substitute_type(ctx, raw_owner);
        # sema refused an instance whose argument is no public tag or no record
        if (over_cases && (type.is_secret(?ctx.s.types, owner) || !type.is_tag(?ctx.s.types, owner))) {
            ret err[fail.Fail].err{fail.message("lower: a `$cases` sema accepted names no public tag in this instance")};
        }
        if (!over_cases && !is_fields_record_type(ctx, owner)) {
            ret err[fail.Fail].err{fail.message("lower: a `$fields` sema accepted names no record in this instance")};
        }
    }

    val res_name: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, src, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) {
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val fname: intern.StrId = res_name.ok;

    val n: u32 = type.field_count(?ctx.s.types, owner);
    var i: u32 = 0;
    for (i < n) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(ctx.scope.ctx);
        if (sel mark_r.err) {
            ret err[fail.Fail].err{mark_r.err};
        }
        val mark: comptime.FrameMark = mark_r.ok;
        var desc: comptime.CTValue   = comptime.field_value(owner::u32, i);
        if (over_cases) { desc = comptime.case_value(owner::u32, i); }
        val res_bind: err[fail.Fail] = comptime.bind(ctx.scope.ctx, fname, desc);
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close(ctx.scope.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }

        val res_body:  err[fail.Fail] = lower_each_body(ctx, sid, i, ce);
        val res_close: err[fail.Fail] = comptime.frame_close(ctx.scope.ctx, mark);
        if (sel res_body.err) {
            ret res_body;
        }
        if (sel res_close.err) {
            ret res_close;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun lower_pack_each(ctx: *lower_context.LowerContext, sid: ast_id.StmtId, ce: *ast_stmt.StmtComptimeEach) err[fail.Fail] {
    val src:      str                        = lower_context.module_source(ctx);
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, src, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) {
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val fname: intern.StrId = res_name.ok;

    var i: u32 = 0;
    for (i < ctx.pack_len) {
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(ctx.scope.ctx);
        if (sel mark_r.err) {
            ret err[fail.Fail].err{mark_r.err};
        }
        val mark:     comptime.FrameMark = mark_r.ok;
        val desc:     comptime.CTValue   = comptime.pack_elem_value(i, ctx.pack_types[i]::u32);
        val res_bind: err[fail.Fail]     = comptime.bind(ctx.scope.ctx, fname, desc);
        if (sel res_bind.err) {
            val res_close: err[fail.Fail] = comptime.frame_close(ctx.scope.ctx, mark);
            if (sel res_close.err) { ret res_close; }
            ret res_bind;
        }

        val res_body:  err[fail.Fail] = lower_each_body(ctx, sid, i, ce);
        val res_close: err[fail.Fail] = comptime.frame_close(ctx.scope.ctx, mark);
        if (sel res_body.err) {
            ret res_body;
        }
        if (sel res_close.err) {
            ret res_close;
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# an `$each` over a constant array, lowered once per element of the array's published value,
# which sema recorded for the statement in the frame; the loop variable folds where the value
# holds the element, and reads the array where it does not
fun lower_const_array_each(ctx: *lower_context.LowerContext, sid: ast_id.StmtId, ce: *ast_stmt.StmtComptimeEach) err[fail.Fail] {
    val seq_ty:  type.TypeId     = lower_context.expr_type_of(ctx, ce.seq);
    val opt_arr: opt[*type.Type] = type.get(?ctx.s.types, seq_ty);
    if (sel opt_arr.none) { ret err[fail.Fail].err{fail.message("lower: `$each` array sequence has no type")}; }
    val elem_ty: type.TypeId = opt_arr.some.data.array.base;
    val count:   u32         = opt_arr.some.data.array.count;

    val recorded: res[comptime.CTValue, fail.Fail] = lower_context.each_array(ctx, sid);
    if (sel recorded.err) { ret err[fail.Fail].err{recorded.err}; }
    val array:   comptime.CTValue                     = recorded.ok;
    val store_r: res[*comptime_deep.Store, fail.Fail] = lower_context.constant_store(ctx, array.data.node.module);
    if (sel store_r.err) { ret err[fail.Fail].err{store_r.err}; }
    val store: *comptime_deep.Store = store_r.ok;

    val src:      str                        = lower_context.module_source(ctx);
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?ctx.s.interner, src, ce.var_name.offset, ce.var_name.len);
    if (sel res_name.err) { ret err[fail.Fail].err{fail.refused(res_name.err)}; }
    val fname: intern.StrId = res_name.ok;

    var i: u32 = 0;
    for (i < count) {
        val elem: opt[comptime_deep.Member] = comptime_deep.member_at(store, comptime_deep.node_at(store, array.data.node.node), i);
        if (sel elem.none) { ret err[fail.Fail].err{fail.message("lower: `$each` array element index out of range")}; }
        val mark_r: res[comptime.FrameMark, fail.Fail] = comptime.frame_open(ctx.scope.ctx);
        if (sel mark_r.err) { ret err[fail.Fail].err{mark_r.err}; }
        val mark:     comptime.FrameMark = mark_r.ok;
        val res_bind: err[fail.Fail]     = comptime.bind(ctx.scope.ctx, fname, comptime.node_ref(array.data.node.module, elem.some.node, type.index(elem_ty)));
        var res_body: err[fail.Fail]     = res_bind;
        if (sel res_bind.ok) {
            val pushed: res[usize, A.Error] = collections_vector.push[lower_context.EachElement](?ctx.elements,
                lower_context.EachElement{name: fname, array: ce.seq, index: i});
            if (sel pushed.err) { res_body = err[fail.Fail].err{fail.refused(pushed.err)}; }
            or {
                res_body = lower_each_body(ctx, sid, i, ce);
                collections_vector.pop[lower_context.EachElement](?ctx.elements);
            }
        }
        val res_close: err[fail.Fail] = comptime.frame_close(ctx.scope.ctx, mark);
        if (sel res_body.err)  { ret res_body; }
        if (sel res_close.err) { ret res_close; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun zero_const(ctx: *lower_context.LowerContext, tid: Type) value.Value {
    ret value.const_null(tid);
}

fun is_pack_type(ctx: *lower_context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    ret opt_ty.some.kind == type.TYPE_PACK;
}

fun is_array_type(ctx: *lower_context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    ret opt_ty.some.kind == type.TYPE_ARRAY;
}

fun is_generic_param_type(ctx: *lower_context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    ret opt_ty.some.kind == type.TYPE_GENERIC_PARAM;
}

fun is_fields_record_type(ctx: *lower_context.LowerContext, t: type.TypeId) bool {
    val opt_ty: opt[*type.Type] = type.get(?ctx.s.types, t);
    if (sel opt_ty.none) { ret false; }
    val k: type.TypeKind = opt_ty.some.kind;
    if (k == type.TYPE_REC) { ret true; }
    val r_899: opt[*type.FieldTable] = type.field_table_for(?ctx.s.types, t);
    if (k == type.TYPE_INSTANCE && sel r_899.some) { ret true; }
    ret false;
}

fun decl_symbol_of(ctx: *lower_context.LowerContext, did: ast_id.DeclId) resolve.SymbolId {
    if (ast_id.decl_is_nil(did))                                  { ret resolve.SYMBOL_NIL; }
    if (ast_id.decl_index(did)::usize >= ctx.scope.rr.decl_count) { ret resolve.SYMBOL_NIL; }
    ret ctx.scope.rr.decl_symbol[ast_id.decl_index(did)];
}
