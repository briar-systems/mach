use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_join;
use std.types.string.str_len;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.diagnostic;
use mach.lang.fe.ast;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.id;
use mach.lang.fe.ast.stmt;
use mach.lang.fe.comptime;
use mach.lang.fe.resolve;
use mach.lang.fe.sema;
use mach.lang.fe.token;
use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.lower.context;
use mach.lang.me.lower.expr;
use mach.lang.fail;
use mach.lang.session;
use mach.lang.source;
use mach.lang.type;

val ASM_BIND_INIT_CAP: u32 = 4;

pub fun lower_stmt(ctx: *context.LowerContext, sid: id.StmtId) R.Result[R.Void, fail.Fail] {
    val opt_stmt: O.Option[*stmt.Stmt] = ast.get_stmt(ctx.scope.a, sid);
    if (O.is_none[*stmt.Stmt](opt_stmt)) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: statement id out of range"));
    }
    val s: *stmt.Stmt     = O.unwrap[*stmt.Stmt](opt_stmt);

    val saved_loc: source.SrcLoc = builder.current_loc(?ctx.builder);
    builder.set_loc(?ctx.builder, source.loc(ctx.scope.a.file_id, s.span.offset));
    fin { builder.set_loc(?ctx.builder, saved_loc); }

    val k: stmt.StmtKind  = s.kind;

    if (k == stmt.STMT_KIND_EXPR)          { ret lower_expr_stmt(ctx, s); }
    if (k == stmt.STMT_KIND_BLOCK)         { ret lower_block(ctx, s); }
    if (k == stmt.STMT_KIND_IF)            { ret lower_if(ctx, s); }
    if (k == stmt.STMT_KIND_FOR)           { ret lower_for(ctx, s); }
    if (k == stmt.STMT_KIND_RET)           { ret lower_ret(ctx, s); }
    if (k == stmt.STMT_KIND_BRK)           { ret lower_brk(ctx); }
    if (k == stmt.STMT_KIND_CNT)           { ret lower_cnt(ctx); }
    if (k == stmt.STMT_KIND_FIN)           { ret lower_fin(ctx, s); }
    if (k == stmt.STMT_KIND_DECL)          { ret lower_decl_stmt(ctx, s); }
    if (k == stmt.STMT_KIND_ASM)           { ret lower_asm(ctx, s); }
    if (k == stmt.STMT_KIND_COMPTIME_IF)   { ret lower_comptime_if(ctx, s); }
    if (k == stmt.STMT_KIND_COMPTIME_EACH) { ret lower_comptime_each(ctx, s); }

    if (k == stmt.STMT_KIND_COMPTIME_ATTR) { ret R.ok_void[fail.Fail](); }

    if (k == stmt.STMT_KIND_ERROR) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: error statement reached the middle end"));
    }

    ret R.err[R.Void, fail.Fail](fail.message("lower: unsupported statement kind"));
}

pub fun lower_stmt_list(ctx: *context.LowerContext, start: u32, len: u32) R.Result[R.Void, fail.Fail] {
    var i: u32 = 0;
    for (i < len) {
        if (context.block_terminated(ctx)) { ret R.ok_void[fail.Fail](); }
        val pool_ix: u32 = start + i;
        if (pool_ix::usize >= ctx.scope.a.stmt_id_len) {
            ret R.err[R.Void, fail.Fail](fail.message("lower: statement list index out of range"));
        }
        val res_stmt: R.Result[R.Void, fail.Fail] = lower_stmt(ctx, ctx.scope.a.stmt_ids[pool_ix]);
        if (R.is_err[R.Void, fail.Fail](res_stmt)) { ret res_stmt; }
        i = i + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun lower_expr_stmt(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val res_value: R.Result[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.expr.expr);
    if (R.is_err[value.Value, fail.Fail](res_value)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_value));
    }
    ret R.ok_void[fail.Fail]();
}

fun lower_block(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val mark: u32 = context.fin_count(ctx);
    val res_body: R.Result[R.Void, fail.Fail] = lower_stmt_list(ctx, s.data.block.stmts_start, s.data.block.stmts_len);
    if (R.is_err[R.Void, fail.Fail](res_body)) {
        context.pop_fins_to(ctx, mark);
        ret res_body;
    }
    if (!context.block_terminated(ctx)) {
        val res_fins: R.Result[R.Void, fail.Fail] = replay_fins_from(ctx, mark);
        if (R.is_err[R.Void, fail.Fail](res_fins)) {
            context.pop_fins_to(ctx, mark);
            ret res_fins;
        }
    }
    context.pop_fins_to(ctx, mark);
    ret R.ok_void[fail.Fail]();
}

fun lower_if(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val res_cond: R.Result[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.if_.cond);
    if (R.is_err[value.Value, fail.Fail](res_cond)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_cond));
    }
    val res_condition: R.Result[value.Value, fail.Fail] = expr.condition_value(ctx, s.data.if_.cond, R.unwrap_ok[value.Value, fail.Fail](res_cond));
    if (R.is_err[value.Value, fail.Fail](res_condition)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_condition));
    }
    val cond: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_condition);

    val res_then: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_then)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_then)));
    }
    val then_b: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_then);

    val res_else: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_else)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_else)));
    }
    val else_b: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_else);

    val res_merge: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_merge)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_merge)));
    }
    val merge_b: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_merge);

    val has_else: bool = s.data.if_.else_block != id.STMT_NIL;

    val res_cbr: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, cond, then_b, else_b);
    if (R.is_err[R.Void, str](res_cbr)) { ret fail.lift[R.Void](res_cbr); }

    builder.set_block(?ctx.builder, then_b);
    val res_then_body: R.Result[R.Void, fail.Fail] = lower_stmt(ctx, s.data.if_.then_block);
    if (R.is_err[R.Void, fail.Fail](res_then_body)) { ret res_then_body; }
    if (!context.block_terminated(ctx)) {
        val res_br: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, merge_b);
        if (R.is_err[R.Void, str](res_br)) { ret fail.lift[R.Void](res_br); }
    }

    builder.set_block(?ctx.builder, else_b);
    if (has_else) {
        val res_else_body: R.Result[R.Void, fail.Fail] = lower_stmt(ctx, s.data.if_.else_block);
        if (R.is_err[R.Void, fail.Fail](res_else_body)) { ret res_else_body; }
    }
    if (!context.block_terminated(ctx)) {
        val res_br: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, merge_b);
        if (R.is_err[R.Void, str](res_br)) { ret fail.lift[R.Void](res_br); }
    }

    builder.set_block(?ctx.builder, merge_b);
    ret R.ok_void[fail.Fail]();
}

fun lower_for(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val res_header: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_header)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_header)));
    }
    val header: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_header);

    val res_body: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_body)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_body)));
    }
    val body: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_body);

    val res_exit: R.Result[ir.BlockId, str] = builder.new_block(?ctx.builder);
    if (R.is_err[ir.BlockId, str](res_exit)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.BlockId, str](res_exit)));
    }
    val exit: ir.BlockId = R.unwrap_ok[ir.BlockId, str](res_exit);

    val res_enter: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, header);
    if (R.is_err[R.Void, str](res_enter)) { ret fail.lift[R.Void](res_enter); }

    builder.set_block(?ctx.builder, header);
    if (s.data.for_.cond == id.EXPR_NIL) {
        val res_br: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, body);
        if (R.is_err[R.Void, str](res_br)) { ret fail.lift[R.Void](res_br); }
    } or {
        val res_cond: R.Result[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.for_.cond);
        if (R.is_err[value.Value, fail.Fail](res_cond)) {
            ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_cond));
        }
        val res_condition: R.Result[value.Value, fail.Fail] = expr.condition_value(ctx, s.data.for_.cond, R.unwrap_ok[value.Value, fail.Fail](res_cond));
        if (R.is_err[value.Value, fail.Fail](res_condition)) {
            ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_condition));
        }
        val cond: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_condition);
        val res_cbr: R.Result[R.Void, str] = builder.emit_cbr(?ctx.builder, cond, body, exit);
        if (R.is_err[R.Void, str](res_cbr)) { ret fail.lift[R.Void](res_cbr); }
    }

    val res_push: R.Result[R.Void, fail.Fail] = context.push_loop(ctx, header, exit);
    if (R.is_err[R.Void, fail.Fail](res_push)) { ret res_push; }

    builder.set_block(?ctx.builder, body);
    val res_body_stmt: R.Result[R.Void, fail.Fail] = lower_stmt(ctx, s.data.for_.body);
    if (R.is_err[R.Void, fail.Fail](res_body_stmt)) {
        context.pop_loop(ctx);
        ret res_body_stmt;
    }
    if (!context.block_terminated(ctx)) {
        val res_back: R.Result[R.Void, str] = builder.emit_br(?ctx.builder, header);
        if (R.is_err[R.Void, str](res_back)) {
            context.pop_loop(ctx);
            ret fail.lift[R.Void](res_back);
        }
    }

    context.pop_loop(ctx);

    builder.set_block(?ctx.builder, exit);
    ret R.ok_void[fail.Fail]();
}

fun lower_ret(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    if (s.data.ret_.value != id.EXPR_NIL) {
        val res_value: R.Result[value.Value, fail.Fail] = expr.lower_rvalue(ctx, s.data.ret_.value);
        if (R.is_err[value.Value, fail.Fail](res_value)) {
            ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_value));
        }
        val v: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_value);

        val res_fins: R.Result[R.Void, fail.Fail] = replay_fins_from(ctx, 0);
        if (R.is_err[R.Void, fail.Fail](res_fins)) { ret res_fins; }
        if (context.block_terminated(ctx)) { ret R.ok_void[fail.Fail](); }
        ret fail.lift[R.Void](builder.emit_ret(?ctx.builder, v));
    }

    val res_fins: R.Result[R.Void, fail.Fail] = replay_fins_from(ctx, 0);
    if (R.is_err[R.Void, fail.Fail](res_fins)) { ret res_fins; }
    if (context.block_terminated(ctx)) { ret R.ok_void[fail.Fail](); }

    if (context.is_void_ir(ctx, ctx.ret_type)) {
        ret fail.lift[R.Void](builder.emit_ret_void(?ctx.builder));
    }
    ret fail.lift[R.Void](builder.emit_ret(?ctx.builder, zero_const(ctx, ctx.ret_type)));
}

fun lower_brk(ctx: *context.LowerContext) R.Result[R.Void, fail.Fail] {
    val lf: *context.LoopFrame = context.current_loop(ctx);
    if (lf == nil) { ret R.err[R.Void, fail.Fail](fail.message("lower: brk outside a loop")); }

    val exit:  ir.BlockId = lf.exit;
    val floor: u32        = lf.fin_depth;
    val res_fins: R.Result[R.Void, fail.Fail] = replay_fins_from(ctx, floor);
    if (R.is_err[R.Void, fail.Fail](res_fins)) { ret res_fins; }
    if (context.block_terminated(ctx)) { ret R.ok_void[fail.Fail](); }
    ret fail.lift[R.Void](builder.emit_br(?ctx.builder, exit));
}

fun lower_cnt(ctx: *context.LowerContext) R.Result[R.Void, fail.Fail] {
    val lf: *context.LoopFrame = context.current_loop(ctx);
    if (lf == nil) { ret R.err[R.Void, fail.Fail](fail.message("lower: cnt outside a loop")); }

    val header: ir.BlockId = lf.header;
    val floor:  u32        = lf.fin_depth;
    val res_fins: R.Result[R.Void, fail.Fail] = replay_fins_from(ctx, floor);
    if (R.is_err[R.Void, fail.Fail](res_fins)) { ret res_fins; }
    if (context.block_terminated(ctx)) { ret R.ok_void[fail.Fail](); }
    ret fail.lift[R.Void](builder.emit_br(?ctx.builder, header));
}

fun lower_fin(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    ret context.push_fin(ctx, s.data.fin_.body);
}

fun replay_fins_from(ctx: *context.LowerContext, floor: u32) R.Result[R.Void, fail.Fail] {
    var i: u32 = context.fin_count(ctx);
    for (i > floor) {
        i = i - 1;
        if (context.block_terminated(ctx)) { ret R.ok_void[fail.Fail](); }
        val body: id.StmtId = context.fin_at(ctx, i);
        if (body != id.STMT_NIL) {
            val res_body: R.Result[R.Void, fail.Fail] = lower_stmt(ctx, body);
            if (R.is_err[R.Void, fail.Fail](res_body)) { ret res_body; }
        }
    }
    ret R.ok_void[fail.Fail]();
}

fun lower_decl_stmt(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val did: id.DeclId = s.data.decl.decl;
    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(ctx.scope.a, did);
    if (O.is_none[*decl.Decl](opt_decl)) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: local decl id out of range"));
    }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);

    if (d.kind != decl.DECL_KIND_VAL && d.kind != decl.DECL_KIND_VAR) {
        ret R.ok_void[fail.Fail]();
    }

    val res_slot_ty: R.Result[ir_type.IrTypeId, fail.Fail] = context.lower_type(ctx, context.decl_type_of(ctx, did));
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_slot_ty)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_slot_ty));
    }
    val slot_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_slot_ty);

    val storage_ty: ir_type.IrTypeId = slot_ty;

    val res_count_ty: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?ctx.m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](res_count_ty)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir_type.IrTypeId, str](res_count_ty)));
    }
    val count_ty: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](res_count_ty);

    val res_slot: R.Result[value.Value, str] = builder.emit_alloca(?ctx.builder, storage_ty, value.const_int(1, count_ty));
    if (R.is_err[value.Value, str](res_slot)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_slot)));
    }
    val slot: value.Value = R.unwrap_ok[value.Value, str](res_slot);

    val sym: resolve.SymbolId = decl_symbol_of(ctx, did);
    val local_secret: bool = context.type_carries_secret(ctx, context.decl_type_of(ctx, did));
    val res_bind: R.Result[R.Void, fail.Fail] = context.bind_local(ctx, sym, slot, local_secret);
    if (R.is_err[R.Void, fail.Fail](res_bind)) { ret res_bind; }

    var birth_val: value.Value;

    if (d.data.bind.init != id.EXPR_NIL) {
        val res_init: R.Result[value.Value, fail.Fail] = expr.lower_rvalue(ctx, d.data.bind.init);
        if (R.is_err[value.Value, fail.Fail](res_init)) {
            ret R.err[R.Void, fail.Fail](R.unwrap_err[value.Value, fail.Fail](res_init));
        }
        val init: value.Value = R.unwrap_ok[value.Value, fail.Fail](res_init);
        val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, init, slot);
        if (R.is_err[R.Void, str](res_store)) { ret fail.lift[R.Void](res_store); }
        if (context.type_is_secret(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_secret(?ctx.builder); }
        if (expr.value_is_volatile_record(ctx, d.data.bind.init)
            || expr.type_is_volatile_record(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_volatile(?ctx.builder); }
        birth_val = init;
    }
    or (ir_type.is_aggregate(?ctx.m.types, storage_ty) || ir_type.is_vector(?ctx.m.types, storage_ty)) {
        val res_mz: R.Result[R.Void, str] = builder.emit_memzero(?ctx.builder, slot, storage_ty);
        if (R.is_err[R.Void, str](res_mz)) { ret fail.lift[R.Void](res_mz); }
        if (context.type_is_secret(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_secret(?ctx.builder); }
        birth_val = slot;
    }
    or {
        val zc: value.Value = zero_const(ctx, slot_ty);
        val res_store: R.Result[R.Void, str] = builder.emit_store(?ctx.builder, zc, slot);
        if (R.is_err[R.Void, str](res_store)) { ret fail.lift[R.Void](res_store); }
        if (context.type_is_secret(ctx, context.decl_type_of(ctx, did))) { builder.mark_last_secret(?ctx.builder); }
        birth_val = zc;
    }

    if (ctx.debug) {
        ret context.emit_dbg_birth(ctx, d.data.bind.name, slot_ty, context.decl_type_of(ctx, did), false, birth_val, O.some[value.Value](slot));
    }
    ret R.ok_void[fail.Fail]();
}

fun lower_asm(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val txt: str = context.module_source(ctx);

    val res_isa: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, txt, s.data.asm_.isa);
    if (R.is_err[intern.StrId, str](res_isa)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_isa)));
    }
    val isa_id: intern.StrId = R.unwrap_ok[intern.StrId, str](res_isa);

    val span: token.Span = s.data.asm_.body;
    val res_strip: R.Result[str, fail.Fail] = strip_asm_comments(ctx.s.alloc, txt, span.offset, span.len);
    if (R.is_err[str, fail.Fail](res_strip)) {
        ret R.err[R.Void, fail.Fail](R.unwrap_err[str, fail.Fail](res_strip));
    }
    val stripped: str = R.unwrap_ok[str, fail.Fail](res_strip);

    val body_returns: bool = asm_body_returns(ctx, stripped);

    val res_body: R.Result[intern.StrId, str] = intern.intern_bytes(?ctx.s.interner, stripped, str_len(stripped));
    A.deallocate[u8](ctx.s.alloc, stripped::*u8, span.len + 1);
    if (R.is_err[intern.StrId, str](res_body)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_body)));
    }
    val body_id: intern.StrId = R.unwrap_ok[intern.StrId, str](res_body);

    var payload: ir.IrAsm;
    payload.isa        = isa_id;
    payload.body       = body_id;
    payload.binds      = nil;
    payload.bind_count = 0;
    payload.bind_cap   = 0;

    val res_binds: R.Result[R.Void, fail.Fail] = collect_asm_binds(ctx, body_id, s.data.asm_.body, ?payload);
    if (R.is_err[R.Void, fail.Fail](res_binds)) {
        asm_payload_free(ctx, ?payload);
        ret res_binds;
    }

    val res_emit: R.Result[ir.InstructionId, str] = builder.emit_asm(?ctx.builder, nil, 0);
    if (R.is_err[ir.InstructionId, str](res_emit)) {
        asm_payload_free(ctx, ?payload);
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[ir.InstructionId, str](res_emit)));
    }
    val asm_iid: ir.InstructionId = R.unwrap_ok[ir.InstructionId, str](res_emit);

    val res_put: R.Result[bool, str] = map.insert[ir.InstructionId, ir.IrAsm](?ctx.builder.fn.asm_blocks, asm_iid, payload);
    if (R.is_err[bool, str](res_put)) {
        asm_payload_free(ctx, ?payload);
        ret fail.lift[R.Void](R.void_of[bool, str](res_put));
    }

    if (!body_returns) { ret fail.lift[R.Void](builder.emit_unreachable(?ctx.builder)); }
    ret R.ok_void[fail.Fail]();
}

fun asm_body_returns(ctx: *context.LowerContext, body: str) bool {
    if (ctx.tgt == nil)                { ret true; }
    if (ctx.tgt.arch == nil)           { ret true; }
    if (!ctx.tgt.arch.has_assembly) { ret true; }
    ret ctx.tgt.arch.assembly.returns(body);
}

fun lower_comptime_if(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val txt: str = context.module_source(ctx);
    var i: u32 = 0;
    for (i < s.data.comptime_if.branches_len) {
        val branch_ix: u32 = s.data.comptime_if.branches_start + i;
        if (branch_ix::usize >= ctx.scope.a.comptime_branch_len) {
            ret R.err[R.Void, fail.Fail](fail.message("lower: comptime branch index out of range"));
        }
        val branch: *decl.ComptimeBranch = ?ctx.scope.a.comptime_branches[branch_ix];

        var active: bool = false;
        if (branch.cond == id.EXPR_NIL) {
            active = true;
        } or {
            val active_r: R.Result[bool, fail.Fail] = context.gate_is_active(ctx, txt, branch.cond, comptime.GATE_SCOPE_INSTANCE, false);
            if (R.is_err[bool, fail.Fail](active_r)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[bool, fail.Fail](active_r)); }
            active = R.unwrap_ok[bool, fail.Fail](active_r);
        }

        if (active) {
            ret lower_stmt_list(ctx, branch.body_start, branch.body_len);
        }
        i = i + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun lower_comptime_each(ctx: *context.LowerContext, s: *stmt.Stmt) R.Result[R.Void, fail.Fail] {
    val ce: *stmt.StmtComptimeEach = ?s.data.comptime_each;
    val src: str = context.module_source(ctx);

    if (is_pack_type(ctx, context.expr_type_of(ctx, ce.seq))) {
        ret lower_pack_each(ctx, ce);
    }

    if (!comptime.is_fields_call(ctx.scope.a, src, ce.seq)) {
        if (is_array_type(ctx, context.expr_type_of(ctx, ce.seq))) {
            ret lower_const_array_each(ctx, ce);
        }
        ret R.err[R.Void, fail.Fail](fail.message("lower: a `$each` sequence must be `$fields(T)`, a variadic pack, or a constant array `val`"));
    }
    val targ: id.ExprId = comptime.fields_type_arg(ctx.scope.a, ce.seq);
    if (targ == id.EXPR_NIL) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: `$fields` is missing its type argument"));
    }

    val raw_owner: type.TypeId = context.expr_type_of(ctx, targ);
    val deferred: bool = is_generic_param_type(ctx, raw_owner);
    var owner: type.TypeId = raw_owner;
    if (deferred) {
        if (ctx.scope.subst == nil || ctx.scope.subst_len == 0) {
            ret R.ok_void[fail.Fail]();
        }
        owner = context.substitute_type(ctx, raw_owner);
        if (!is_fields_record_type(ctx, owner)) {
            diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, s.span,
                "$fields(T): type argument instantiated as a non-record type");
            ret R.err[R.Void, fail.Fail](fail.reported());
        }
    }

    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, src, ce.var_name);
    if (R.is_err[intern.StrId, str](res_name)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name)));
    }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    var deps: sema.SemaDeps;
    val res_deps: R.Result[sema.SemaDeps, str] = sema.collect_module_deps(ctx.s);
    if (R.is_err[sema.SemaDeps, str](res_deps)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[sema.SemaDeps, str](res_deps)));
    }
    deps = R.unwrap_ok[sema.SemaDeps, str](res_deps);

    val n: u32 = type.field_count(?ctx.s.types, owner);
    var i: u32 = 0;
    for (i < n) {
        val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(ctx.scope.ctx);
        if (R.is_err[comptime.FrameMark, str](mark_r)) {
            sema.free_module_deps(ctx.s, ?deps);
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.FrameMark, str](mark_r)));
        }
        val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);
        val res_bind: R.Result[R.Void, str] = comptime.bind(ctx.scope.ctx, fname, comptime.field_value(owner::u32, i));
        if (R.is_err[R.Void, str](res_bind)) {
            val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
            sema.free_module_deps(ctx.s, ?deps);
            if (R.is_err[R.Void, str](res_close)) { ret fail.lift[R.Void](res_close); }
            ret fail.lift[R.Void](res_bind);
        }

        val res_reinfer: R.Result[R.Void, str] = sema.reinfer_pack_each_body(ctx.s, ctx.scope.a, ctx.scope.rr, ?deps, ctx.scope.ctx,
            ctx.scope.own_module, ctx.scope.sema_result, ctx.fn_ret_sem, ce.body_start, ce.body_len,
            ctx.scope.subst, ctx.scope.subst_len, ctx.ct_insts);
        if (R.is_err[R.Void, str](res_reinfer)) {
            val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
            sema.free_module_deps(ctx.s, ?deps);
            if (R.is_err[R.Void, str](res_close)) { ret fail.lift[R.Void](res_close); }
            ret fail.lift[R.Void](res_reinfer);
        }

        val res_body: R.Result[R.Void, fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
        if (R.is_err[R.Void, fail.Fail](res_body)) {
            sema.free_module_deps(ctx.s, ?deps);
            ret res_body;
        }
        if (R.is_err[R.Void, str](res_close)) {
            sema.free_module_deps(ctx.s, ?deps);
            ret fail.lift[R.Void](res_close);
        }
        i = i + 1;
    }
    sema.free_module_deps(ctx.s, ?deps);
    ret R.ok_void[fail.Fail]();
}

fun lower_pack_each(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach) R.Result[R.Void, fail.Fail] {
    val src: str = context.module_source(ctx);
    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, src, ce.var_name);
    if (R.is_err[intern.StrId, str](res_name)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name)));
    }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    val res_deps: R.Result[sema.SemaDeps, str] = sema.collect_module_deps(ctx.s);
    if (R.is_err[sema.SemaDeps, str](res_deps)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[sema.SemaDeps, str](res_deps)));
    }
    var deps: sema.SemaDeps = R.unwrap_ok[sema.SemaDeps, str](res_deps);

    var i: u32 = 0;
    for (i < ctx.pack_len) {
        val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(ctx.scope.ctx);
        if (R.is_err[comptime.FrameMark, str](mark_r)) {
            sema.free_module_deps(ctx.s, ?deps);
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.FrameMark, str](mark_r)));
        }
        val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);
        val desc: comptime.CTValue = comptime.pack_elem_value(i, ctx.pack_types[i]::u32);
        val res_bind: R.Result[R.Void, str] = comptime.bind(ctx.scope.ctx, fname, desc);
        if (R.is_err[R.Void, str](res_bind)) {
            val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
            sema.free_module_deps(ctx.s, ?deps);
            if (R.is_err[R.Void, str](res_close)) { ret fail.lift[R.Void](res_close); }
            ret fail.lift[R.Void](res_bind);
        }

        val res_reinfer: R.Result[R.Void, str] = sema.reinfer_pack_each_body(ctx.s, ctx.scope.a, ctx.scope.rr, ?deps, ctx.scope.ctx,
            ctx.scope.own_module, ctx.scope.sema_result, ctx.pack_ret_type, ce.body_start, ce.body_len,
            ctx.scope.subst, ctx.scope.subst_len, ctx.ct_insts);
        if (R.is_err[R.Void, str](res_reinfer)) {
            val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
            sema.free_module_deps(ctx.s, ?deps);
            if (R.is_err[R.Void, str](res_close)) { ret fail.lift[R.Void](res_close); }
            ret fail.lift[R.Void](res_reinfer);
        }

        val res_body: R.Result[R.Void, fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
        if (R.is_err[R.Void, fail.Fail](res_body)) {
            sema.free_module_deps(ctx.s, ?deps);
            ret res_body;
        }
        if (R.is_err[R.Void, str](res_close)) {
            sema.free_module_deps(ctx.s, ?deps);
            ret fail.lift[R.Void](res_close);
        }
        i = i + 1;
    }
    sema.free_module_deps(ctx.s, ?deps);
    ret R.ok_void[fail.Fail]();
}

fun lower_const_array_each(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach) R.Result[R.Void, fail.Fail] {
    val seq_ty: type.TypeId = context.expr_type_of(ctx, ce.seq);
    val opt_arr: O.Option[*type.Type] = type.get(?ctx.s.types, seq_ty);
    if (O.is_none[*type.Type](opt_arr)) { ret R.err[R.Void, fail.Fail](fail.message("lower: `$each` array sequence has no type")); }
    val arr: *type.Type = O.unwrap[*type.Type](opt_arr);
    val elem_ty: type.TypeId = arr.data.array.base;
    val count:   u32         = arr.data.array.count;

    val sid: resolve.SymbolId = context.expr_symbol_of(ctx, ce.seq);
    val opt_sym: O.Option[*resolve.Symbol] = context.symbol_of(ctx, sid);
    if (O.is_none[*resolve.Symbol](opt_sym)) { ret R.err[R.Void, fail.Fail](fail.message("lower: `$each` array sequence is unresolved")); }
    val sym: *resolve.Symbol = O.unwrap[*resolve.Symbol](opt_sym);

    if (sym.origin == ctx.scope.own_module) {
        ret lower_const_array_each_local(ctx, ce, sym, elem_ty, count);
    }
    ret lower_const_array_each_imported(ctx, ce, sym, elem_ty, count);
}

fun lower_const_array_each_local(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach,
                                 sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) R.Result[R.Void, fail.Fail] {
    val src: str = context.module_source(ctx);

    val opt_info: O.Option[comptime.ArrayLitInfo] = comptime.decl_array_lit(ctx.scope.a, sym.decl);
    if (O.is_none[comptime.ArrayLitInfo](opt_info)) { ret R.err[R.Void, fail.Fail](fail.message("lower: `$each` array sequence has no array-literal initializer")); }
    val info: comptime.ArrayLitInfo = O.unwrap[comptime.ArrayLitInfo](opt_info);

    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, src, ce.var_name);
    if (R.is_err[intern.StrId, str](res_name)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name))); }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    var i: u32 = 0;
    for (i < count) {
        if ((info.elems_start + i)::usize >= ctx.scope.a.expr_id_len) {
            ret R.err[R.Void, fail.Fail](fail.message("lower: `$each` array element index out of range"));
        }
        val elem_eid: id.ExprId = ctx.scope.a.expr_ids[info.elems_start + i];
        val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(ctx.scope.ctx);
        if (R.is_err[comptime.FrameMark, str](mark_r)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.FrameMark, str](mark_r))); }
        val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);
        val res_bind: R.Result[R.Void, str] = comptime.bind(ctx.scope.ctx, fname, comptime.const_elem_value(elem_eid::u32, elem_ty::u32));
        if (R.is_err[R.Void, str](res_bind)) {
            val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
            if (R.is_err[R.Void, str](res_close)) { ret fail.lift[R.Void](res_close); }
            ret fail.lift[R.Void](res_bind);
        }
        val res_body:  R.Result[R.Void, fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
        if (R.is_err[R.Void, fail.Fail](res_body))  { ret res_body; }
        if (R.is_err[R.Void, str](res_close)) { ret fail.lift[R.Void](res_close); }
        i = i + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun lower_const_array_each_imported(ctx: *context.LowerContext, ce: *stmt.StmtComptimeEach,
                                    sym: *resolve.Symbol, elem_ty: type.TypeId, count: u32) R.Result[R.Void, fail.Fail] {
    val sc_o: O.Option[context.ModuleScope] = context.origin_scope(ctx.s, sym.origin);
    if (O.is_none[context.ModuleScope](sc_o)) {
        ret R.err[R.Void, fail.Fail](fail.message("internal: `$each` imported array origin module snapshot unavailable (dependency-ordering invariant violated)"));
    }
    val osc: context.ModuleScope = O.unwrap[context.ModuleScope](sc_o);
    val oa: *ast.Ast = osc.a;
    val octx: *comptime.ComptimeCtx = osc.ctx;

    val od_opt: O.Option[*decl.Decl] = ast.get_decl(oa, sym.decl);
    if (O.is_none[*decl.Decl](od_opt)) { ret R.err[R.Void, fail.Fail](fail.message("lower: `$each` array sequence is unresolved")); }
    if (O.unwrap[*decl.Decl](od_opt).kind != decl.DECL_KIND_VAL) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: `$each` array sequence must name an immutable `val`"));
    }

    val opt_info: O.Option[comptime.ArrayLitInfo] = comptime.decl_array_lit(oa, sym.decl);
    if (O.is_none[comptime.ArrayLitInfo](opt_info)) { ret R.err[R.Void, fail.Fail](fail.message("lower: `$each` array sequence has no array-literal initializer")); }
    val info: comptime.ArrayLitInfo = O.unwrap[comptime.ArrayLitInfo](opt_info);

    val src: str = context.module_source(ctx);
    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?ctx.s.interner, src, ce.var_name);
    if (R.is_err[intern.StrId, str](res_name)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name))); }
    val fname: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

    val o_source: str = context.ast_source(ctx, oa);

    var out_err: str = nil;
    var i: u32 = 0;
    for (i < count) {
        if ((info.elems_start + i)::usize >= oa.expr_id_len) {
            out_err = "lower: `$each` array element index out of range";
            brk;
        }
        val elem_eid: id.ExprId = oa.expr_ids[info.elems_start + i];

        val mark_o: R.Result[context.ScopeMark, fail.Fail] = context.scope_enter(ctx, osc);
        if (R.is_err[context.ScopeMark, fail.Fail](mark_o)) {
            out_err = R.unwrap_err[context.ScopeMark, fail.Fail](mark_o).message;
            brk;
        }
        val res_eval: R.Result[comptime.CTValue, comptime.EvalFail] = comptime.evaluate[context.LowerContext](octx, ctx, ctx.caps, oa, o_source, elem_eid, ?ctx.s.interner);
        val leave_o: R.Result[R.Void, fail.Fail] = context.scope_leave(ctx, R.unwrap_ok[context.ScopeMark, fail.Fail](mark_o));
        if (R.is_err[R.Void, fail.Fail](leave_o)) {
            out_err = R.unwrap_err[R.Void, fail.Fail](leave_o).message;
            brk;
        }

        if (R.is_err[comptime.CTValue, comptime.EvalFail](res_eval)) {
            out_err = R.unwrap_err[comptime.CTValue, comptime.EvalFail](res_eval).message;
            brk;
        }
        var ev: comptime.CTValue = R.unwrap_ok[comptime.CTValue, comptime.EvalFail](res_eval);

        val mark_r: R.Result[comptime.FrameMark, str] = comptime.frame_open(ctx.scope.ctx);
        if (R.is_err[comptime.FrameMark, str](mark_r)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.FrameMark, str](mark_r))); }
        val mark: comptime.FrameMark = R.unwrap_ok[comptime.FrameMark, str](mark_r);
        val res_bind: R.Result[R.Void, str] = comptime.bind(ctx.scope.ctx, fname, ev);
        if (R.is_err[R.Void, str](res_bind)) {
            val res_close_err: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
            if (R.is_err[R.Void, str](res_close_err)) {
                out_err = R.unwrap_err[R.Void, str](res_close_err);
                brk;
            }
            out_err = R.unwrap_err[R.Void, str](res_bind);
            brk;
        }
        val res_body:  R.Result[R.Void, fail.Fail] = lower_stmt_list(ctx, ce.body_start, ce.body_len);
        val res_close: R.Result[R.Void, str] = comptime.frame_close(ctx.scope.ctx, mark);
        if (R.is_err[R.Void, fail.Fail](res_body)) {
            out_err = R.unwrap_err[R.Void, fail.Fail](res_body).message;
            brk;
        }
        if (R.is_err[R.Void, str](res_close)) {
            out_err = R.unwrap_err[R.Void, str](res_close);
            brk;
        }
        i = i + 1;
    }

    if (out_err != nil) { ret R.err[R.Void, fail.Fail](fail.message(out_err)); }
    ret R.ok_void[fail.Fail]();
}

fun strip_asm_comments(a: *A.Allocator, src: str, offset: usize, len: usize) R.Result[str, fail.Fail] {
    val res_buf: R.Result[*u8, str] = A.allocate[u8](a, len + 1);
    if (R.is_err[*u8, str](res_buf)) {
        ret R.err[str, fail.Fail](fail.message(R.unwrap_err[*u8, str](res_buf)));
    }
    val out: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var i: usize = 0;
    var o: usize = 0;
    for (i < len) {
        val c: u8 = src[offset + i];
        if (c == '#'::char) {
            for (i < len && src[offset + i] != '\n'::char) { i = i + 1; }
            cnt;
        }
        out[o] = c;
        o = o + 1;
        i = i + 1;
    }
    out[o] = 0;
    ret R.ok[str, fail.Fail](out::str);
}

fun collect_asm_binds(ctx: *context.LowerContext, body_id: intern.StrId, body_span: token.Span, payload: *ir.IrAsm) R.Result[R.Void, fail.Fail] {
    val opt_body: O.Option[str] = intern.lookup(?ctx.s.interner, body_id);
    if (O.is_none[str](opt_body)) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: inline-asm body interning failed"));
    }
    val body: str = O.unwrap[str](opt_body);

    var i: usize = 0;
    for (body[i] != 0) {
        if (body[i] != '{'::char) { i = i + 1; cnt; }

        val name_start: usize = i + 1;
        var j: usize = name_start;
        for (body[j] != 0 && body[j] != '}'::char) { j = j + 1; }
        if (body[j] == 0) {
            ret report_asm(ctx, body_span, "unterminated '{' in inline asm body");
        }
        val name_len: usize = j - name_start;
        if (name_len == 0) {
            ret report_asm(ctx, body_span, "empty '{}' in asm body; write '{name}' to reference a local");
        }

        val res_name: R.Result[intern.StrId, str] = intern.intern_bytes(?ctx.s.interner, (body::usize + name_start)::str, name_len);
        if (R.is_err[intern.StrId, str](res_name)) {
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name)));
        }
        val name_id: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);

        val res_add: R.Result[R.Void, fail.Fail] = add_asm_bind(ctx, body_span, payload, name_id);
        if (R.is_err[R.Void, fail.Fail](res_add)) { ret res_add; }

        i = j + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun add_asm_bind(ctx: *context.LowerContext, body_span: token.Span, payload: *ir.IrAsm, name_id: intern.StrId) R.Result[R.Void, fail.Fail] {
    var i: u32 = 0;
    for (i < payload.bind_count) {
        if (payload.binds[i].name == name_id) { ret R.ok_void[fail.Fail](); }
        i = i + 1;
    }

    val opt_local: O.Option[context.LocalBinding] = context.lookup_local_name(ctx, name_id);
    if (O.is_none[context.LocalBinding](opt_local)) {
        ret report_asm_named(ctx, body_span, "unknown local '", name_id, "' in inline asm; only stack-allocated variables in scope can be referenced");
    }
    val lb: context.LocalBinding = O.unwrap[context.LocalBinding](opt_local);
    val v: value.Value = lb.value;
    if (v.kind != value.VAL_INSTR) {
        ret report_asm_named(ctx, body_span, "'", name_id, "' is not stack-allocated and cannot be used in inline asm");
    }

    if (payload.bind_count == payload.bind_cap) {
        val new_cap: u32 = grow_bind_cap(payload.bind_cap);
        var nb: *ir.IrAsmBind = nil;
        if (payload.binds == nil) {
            val res_alloc: R.Result[*ir.IrAsmBind, str] = A.allocate[ir.IrAsmBind](ctx.m.alloc, new_cap::usize);
            if (R.is_err[*ir.IrAsmBind, str](res_alloc)) {
                ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*ir.IrAsmBind, str](res_alloc)));
            }
            nb = R.unwrap_ok[*ir.IrAsmBind, str](res_alloc);
        } or {
            val res_grow: R.Result[*ir.IrAsmBind, str] = A.reallocate[ir.IrAsmBind](ctx.m.alloc, payload.binds, payload.bind_cap::usize, new_cap::usize);
            if (R.is_err[*ir.IrAsmBind, str](res_grow)) {
                ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*ir.IrAsmBind, str](res_grow)));
            }
            nb = R.unwrap_ok[*ir.IrAsmBind, str](res_grow);
        }
        payload.binds    = nb;
        payload.bind_cap = new_cap;
    }

    payload.binds[payload.bind_count].name   = name_id;
    payload.binds[payload.bind_count].instr  = v.data.instr;
    payload.binds[payload.bind_count].secret = lb.secret;
    payload.bind_count = payload.bind_count + 1;
    ret R.ok_void[fail.Fail]();
}

fun asm_payload_free(ctx: *context.LowerContext, payload: *ir.IrAsm) {
    if (payload.binds == nil) { ret; }
    A.deallocate[ir.IrAsmBind](ctx.m.alloc, payload.binds, payload.bind_cap::usize);
}

fun grow_bind_cap(cap: u32) u32 {
    if (cap == 0) { ret ASM_BIND_INIT_CAP; }
    ret cap * 2;
}

fun report_asm(ctx: *context.LowerContext, span: token.Span, message: str) R.Result[R.Void, fail.Fail] {
    diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, span, message);
    ret R.err[R.Void, fail.Fail](fail.reported());
}


fun report_asm_named(ctx: *context.LowerContext, span: token.Span, prefix: str, name_id: intern.StrId, suffix: str) R.Result[R.Void, fail.Fail] {
    val opt_name: O.Option[str] = intern.lookup(?ctx.s.interner, name_id);
    if (O.is_none[str](opt_name)) { ret report_asm(ctx, span, prefix); }
    val name: str = O.unwrap[str](opt_name);

    val res_msg: R.Result[str, str] = str_join(ctx.s.alloc, prefix, name, suffix);
    if (R.is_err[str, str](res_msg)) { ret report_asm(ctx, span, prefix); }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    diagnostic.record_error(?ctx.s.diags, ctx.scope.a.file_id, span, buf);
    A.deallocate[u8](ctx.s.alloc, buf::*u8, str_len(buf) + 1);
    ret R.err[R.Void, fail.Fail](fail.reported());
}

fun zero_const(ctx: *context.LowerContext, tid: ir_type.IrTypeId) value.Value {
    val opt_ty: O.Option[*ir_type.IrType] = ir_type.get(?ctx.m.types, tid);
    if (O.is_some[*ir_type.IrType](opt_ty)) {
        if (O.unwrap[*ir_type.IrType](opt_ty).kind == ir_type.IRT_FLOAT) {
            ret value.const_float(0.0, tid);
        }
    }
    ret value.const_int(0, tid);
}

fun is_pack_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: O.Option[*type.Type] = type.get(?ctx.s.types, t);
    if (O.is_none[*type.Type](opt_ty)) { ret false; }
    ret O.unwrap[*type.Type](opt_ty).kind == type.TYPE_PACK;
}

fun is_array_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: O.Option[*type.Type] = type.get(?ctx.s.types, t);
    if (O.is_none[*type.Type](opt_ty)) { ret false; }
    ret O.unwrap[*type.Type](opt_ty).kind == type.TYPE_ARRAY;
}

fun is_generic_param_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: O.Option[*type.Type] = type.get(?ctx.s.types, t);
    if (O.is_none[*type.Type](opt_ty)) { ret false; }
    ret O.unwrap[*type.Type](opt_ty).kind == type.TYPE_GENERIC_PARAM;
}

fun is_fields_record_type(ctx: *context.LowerContext, t: type.TypeId) bool {
    val opt_ty: O.Option[*type.Type] = type.get(?ctx.s.types, t);
    if (O.is_none[*type.Type](opt_ty)) { ret false; }
    val k: type.TypeKind = O.unwrap[*type.Type](opt_ty).kind;
    if (k == type.TYPE_REC)                                                                            { ret true; }
    if (k == type.TYPE_INSTANCE && O.is_some[*type.FieldTable](type.field_table_for(?ctx.s.types, t))) { ret true; }
    ret false;
}

fun decl_symbol_of(ctx: *context.LowerContext, did: id.DeclId) resolve.SymbolId {
    if (did == id.DECL_NIL)              { ret resolve.SYMBOL_NIL; }
    if (did::usize >= ctx.scope.rr.decl_count) { ret resolve.SYMBOL_NIL; }
    ret ctx.scope.rr.decl_symbol[did];
}
