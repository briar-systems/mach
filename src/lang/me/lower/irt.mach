# the mirl types lowering builds: interned in the module's type table, laid out by the
# target's data layout and never by mach
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;

use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl_target: mirl.target;

use mach.lang.fail;

# no type: what a function that gives nothing returns
pub val NONE: Type = Type{index: 0xFFFFFFFF};

pub fun is_none(t: Type) bool {
    ret t.index == NONE.index;
}

pub fun same(a: Type, b: Type) bool {
    ret a.index == b.index;
}

fun refused(e: types.Error) fail.Fail {
    if (sel e.alloc)    { ret fail.refused(e.alloc); }
    if (sel e.width)    { ret fail.message("lower: mirl's type table refused an integer width"); }
    if (sel e.extended) { ret fail.message("lower: mirl's type table refused an extension on a type that is not an integer"); }
    ret fail.message("lower: mirl's type table refused a type lowering built");
}

fun interned(t: *types.Table, s: types.Shape) res[Type, fail.Fail] {
    val r: res[Type, types.Error] = types.intern(t, s);
    if (sel r.err) { ret res[Type, fail.Fail].err{refused(r.err)}; }
    ret res[Type, fail.Fail].ok{r.ok};
}

# a signless integer of `bits`, rounded up to a width mirl holds
pub fun int(t: *types.Table, bits: u32) res[Type, fail.Fail] {
    var w: u32 = 1;
    if (bits > 1) {
        w = 8;
        for (w < bits) { w = w * 2; }
    }
    ret interned(t, types.Shape.integer{types.Integer{width: w}});
}

pub fun float(t: *types.Table, bits: u32) res[Type, fail.Fail] {
    var f: types.Format = types.BINARY64;
    if (bits == 16) { f = types.BINARY16; }
    or (bits == 32) { f = types.BINARY32; }
    or (bits != 64) { ret res[Type, fail.Fail].err{fail.message("lower: a float width mirl has no format for")}; }
    ret interned(t, types.Shape.float{types.Float{format: f}});
}

pub fun ptr(t: *types.Table) res[Type, fail.Fail] {
    ret interned(t, types.Shape.pointer{types.Pointer{space: types.DEFAULT_SPACE}});
}

pub fun ptr_in(t: *types.Table, space: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.pointer{types.Pointer{space: space}});
}

pub fun vector(t: *types.Table, element: Type, lanes: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.vector{types.Vector{lanes: lanes, element: element}});
}

pub fun array(t: *types.Table, element: Type, count: u64) res[Type, fail.Fail] {
    ret interned(t, types.Shape.array{types.Array{count: count, element: element, stride: opt[u64].none{}}});
}

pub fun structure(t: *types.Table, members: *Type, n: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: members, size: n::usize}, offsets: opt[Slice[u64]].none{}}});
}

# a structure whose members stand at the offsets mach states, as a packed record's do
pub fun structure_at(t: *types.Table, members: *Type, offsets: *u64, n: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.structure{types.Structure{members: Slice[Type]{data: members, size: n::usize}, offsets: opt[Slice[u64]].some{Slice[u64]{data: offsets, size: n::usize}}}});
}

pub fun union_of(t: *types.Table, members: *Type, n: u32) res[Type, fail.Fail] {
    ret interned(t, types.Shape.union{types.Union{members: Slice[Type]{data: members, size: n::usize}}});
}

pub fun handle(t: *types.Table, kind: View) res[Type, fail.Fail] {
    ret interned(t, types.Shape.handle{types.Handle{kind: kind}});
}

# a signature: its parameters and results, each narrow integer with its extension
pub fun signature(t: *types.Table, params: *Type, param_ext: *types.Extension, pn: u32, results: *Type, result_ext: *types.Extension, rn: u32) res[Type, fail.Fail] {
    var f: types.Function;
    f.params     = Slice[Type]{data: params, size: pn::usize};
    f.results    = Slice[Type]{data: results, size: rn::usize};
    f.param_ext  = Slice[types.Extension]{data: param_ext, size: pn::usize};
    f.result_ext = Slice[types.Extension]{data: result_ext, size: rn::usize};
    f.convention = View{data: nil, len: 0};
    if (pn == 0) { f.param_ext = Slice[types.Extension]{data: nil, size: 0}; }
    if (rn == 0) { f.result_ext = Slice[types.Extension]{data: nil, size: 0}; }
    ret interned(t, types.Shape.function{f});
}

# the signature `sig` with its `n` parameters of the types at `params`, its results,
# extensions and convention kept
pub fun restated(t: *types.Table, sig: Type, params: *Type, n: u32) res[Type, fail.Fail] {
    val s: opt[types.Shape] = shape(t, sig);
    if (sel s.some) {
        val k: types.Shape = s.some;
        if (sel k.function) {
            var f: types.Function = k.function;
            if (f.params.size != n::usize) { ret res[Type, fail.Fail].err{fail.message("lower: a signature restated at another parameter count")}; }
            f.params = Slice[Type]{data: params, size: n::usize};
            ret interned(t, types.Shape.function{f});
        }
    }
    ret res[Type, fail.Fail].err{fail.message("lower: a signature restated of a type that is no function")};
}

pub fun shape(t: *types.Table, ty: Type) opt[types.Shape] {
    if (is_none(ty)) { ret opt[types.Shape].none{}; }
    val s: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel s.err) { ret opt[types.Shape].none{}; }
    ret opt[types.Shape].some{s.ok};
}

pub fun is_int(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.integer;
}

# an integer's width, 0 for any other type
pub fun int_width(t: *types.Table, ty: Type) u32 {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        if (sel s.some.integer) { ret s.some.integer.width; }
    }
    ret 0;
}

pub fun is_float(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.float;
}

# a float's width, 0 for any other type
pub fun float_width(t: *types.Table, ty: Type) u32 {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        if (sel s.some.float) {
            val r: opt[types.Row] = types.row(s.some.float.format);
            if (sel r.some) { ret r.some.width; }
        }
    }
    ret 0;
}

# the address space a pointer type points into, the default space for any other type
pub fun space_of(t: *types.Table, ty: Type) u32 {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        val k: types.Shape = s.some;
        if (sel k.pointer) { ret k.pointer.space; }
    }
    ret types.DEFAULT_SPACE;
}

pub fun is_ptr(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.pointer;
}

pub fun is_vector(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.vector;
}

pub fun is_function(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.function;
}

pub fun is_handle(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.handle;
}

pub fun is_struct(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.structure;
}

pub fun is_array(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.array;
}

pub fun is_union(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    ret sel s.some && sel s.some.union;
}

# a structure, union or array: what lowering holds in storage and passes by its address
pub fun is_aggregate(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.none) { ret false; }
    ret sel s.some.structure || sel s.some.union || sel s.some.array;
}

# a float or a vector of floats
pub fun is_float_like(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.none)        { ret false; }
    if (sel s.some.float)  { ret true; }
    if (sel s.some.vector) { ret is_float(t, s.some.vector.element); }
    ret false;
}

# a pointer or a vector of pointers
pub fun is_ptr_like(t: *types.Table, ty: Type) bool {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.none)         { ret false; }
    if (sel s.some.pointer) { ret true; }
    if (sel s.some.vector)  { ret is_ptr(t, s.some.vector.element); }
    ret false;
}

# a vector's lane count, 0 for any other type
pub fun lanes(t: *types.Table, ty: Type) u32 {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        if (sel s.some.vector) { ret s.some.vector.lanes; }
    }
    ret 0;
}

# the element of a vector or an array, the type itself for a scalar
pub fun element(t: *types.Table, ty: Type) Type {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        if (sel s.some.vector) { ret s.some.vector.element; }
        if (sel s.some.array)  { ret s.some.array.element; }
    }
    ret ty;
}

# an array's element count, 0 for any other type
pub fun count(t: *types.Table, ty: Type) u64 {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        if (sel s.some.array) { ret s.some.array.count; }
    }
    ret 0;
}

# a structure's or union's member count, 0 for any other type
pub fun member_count(t: *types.Table, ty: Type) u32 {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        if (sel s.some.structure) { ret s.some.structure.members.size::u32; }
        if (sel s.some.union)     { ret s.some.union.members.size::u32; }
    }
    ret 0;
}

# member `i` of a structure or union, an array's element, NONE past the members
pub fun member(t: *types.Table, ty: Type, i: u32) Type {
    val s: opt[types.Shape] = shape(t, ty);
    if (sel s.some) {
        if (sel s.some.structure) {
            if (i::usize < s.some.structure.members.size) { ret s.some.structure.members.data[i]; }
        }
        if (sel s.some.union) {
            if (i::usize < s.some.union.members.size) { ret s.some.union.members.data[i]; }
        }
        if (sel s.some.array) { ret s.some.array.element; }
    }
    ret NONE;
}

# a signature's first result, NONE when it gives none
pub fun result_of(t: *types.Table, sig: Type) Type {
    val s: opt[types.Shape] = shape(t, sig);
    if (sel s.some) {
        if (sel s.some.function) {
            if (s.some.function.results.size > 0) { ret s.some.function.results.data[0]; }
        }
    }
    ret NONE;
}

# a signature's parameter count
pub fun param_count(t: *types.Table, sig: Type) u32 {
    val s: opt[types.Shape] = shape(t, sig);
    if (sel s.some) {
        if (sel s.some.function) { ret s.some.function.params.size::u32; }
    }
    ret 0;
}

# whether a signature takes a pointer
pub fun takes_pointer(t: *types.Table, sig: Type) bool {
    var i: u32 = 0;
    for (i < param_count(t, sig)) {
        if (is_ptr(t, param_of(t, sig, i))) { ret true; }
        i = i + 1;
    }
    ret false;
}

# parameter `i` of a signature, NONE past them
pub fun param_of(t: *types.Table, sig: Type, i: u32) Type {
    val s: opt[types.Shape] = shape(t, sig);
    if (sel s.some) {
        if (sel s.some.function) {
            if (i::usize < s.some.function.params.size) { ret s.some.function.params.data[i]; }
        }
    }
    ret NONE;
}

# why the target's data layout gave no extent to a type lowering built, by mirl's refusal
fun laid(e: mirl_target.Error) fail.Fail {
    if (sel e.space)      { ret fail.message("lower: the target's data layout has no row for the address space of a pointer lowering built"); }
    if (sel e.unsized)    { ret fail.message("lower: the target's data layout gives a type lowering built no representation in memory"); }
    if (sel e.unmodelled) { ret fail.message("lower: the build's addressing model gives a pointer lowering built no representation in memory"); }
    if (sel e.ruled)      { ret fail.message("lower: the rules of the address space a type lowering built is asked in do not lay it out"); }
    if (sel e.stride)     { ret fail.message("lower: an array lowering built states a stride its alignment does not divide"); }
    if (sel e.overflow)   { ret fail.message("lower: a type lowering built is larger than 64 bits of bytes"); }
    if (sel e.unstated)   { ret fail.message("lower: the target leaves a fact of its data layout unstated"); }
    if (sel e.types)      { ret fail.message("lower: the type table refused a read of a type lowering built"); }
    ret fail.message("lower: the target's data layout gives no extent to a type lowering built");
}

# the size in bytes the target's data layout gives `ty`
pub fun size(l: *mirl_target.Layout, ty: Type) res[u64, fail.Fail] {
    val r: res[u64, mirl_target.Error] = mirl_target.size(l, ty, types.DEFAULT_SPACE);
    if (sel r.err) { ret res[u64, fail.Fail].err{laid(r.err)}; }
    ret res[u64, fail.Fail].ok{r.ok};
}

# the alignment in bytes the target's data layout gives `ty`
pub fun align(l: *mirl_target.Layout, ty: Type) res[u64, fail.Fail] {
    val r: res[u64, mirl_target.Error] = mirl_target.align(l, ty, types.DEFAULT_SPACE);
    if (sel r.err) { ret res[u64, fail.Fail].err{laid(r.err)}; }
    ret res[u64, fail.Fail].ok{r.ok};
}

# the byte offset of member `i` of a structure or union
pub fun offset(l: *mirl_target.Layout, ty: Type, i: u32) res[u64, fail.Fail] {
    val r: res[u64, mirl_target.Error] = mirl_target.offset(l, ty, types.DEFAULT_SPACE, i);
    if (sel r.err) { ret res[u64, fail.Fail].err{laid(r.err)}; }
    ret res[u64, fail.Fail].ok{r.ok};
}

# the bytes from one element of the array `ty` to the next
pub fun stride(l: *mirl_target.Layout, ty: Type) res[u64, fail.Fail] {
    val r: res[u64, mirl_target.Error] = mirl_target.stride(l, ty, types.DEFAULT_SPACE);
    if (sel r.err) { ret res[u64, fail.Fail].err{laid(r.err)}; }
    ret res[u64, fail.Fail].ok{r.ok};
}
