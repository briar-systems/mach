use std.types.canonical.res;
use std.types.canonical.err;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.session;
use mach.lang.fail;

pub rec Test {
    linkage: intern.StrId;
    label:   intern.StrId;
    line:    u32;
    mod_idx: u32;
}

pub rec Collected {
    tests: *Test;
    count: u32;
    cap:   u32;
}

val INITIAL_TESTS_CAP: u32 = 8;

pub fun collected_init() Collected {
    var c: Collected;
    c.tests = nil;
    c.count = 0;
    c.cap   = 0;
    ret c;
}

# the test declarations of one lowered module, in function order
pub fun collect_module(s: *session.Session, c: *Collected, mod: *ir.Module, mod_idx: u32) err[fail.Fail] {
    var ii: u32 = 0;
    for (ii < mod.function_len) {
        val fn: *ir.Function = ?mod.functions[ii];
        if ((fn.flags & ir.FN_FLAG_TEST) != 0) {
            var t: Test;
            t.linkage = fn.name;
            t.label   = fn.label;
            t.line    = fn.line;
            t.mod_idx = mod_idx;
            val res_push: err[fail.Fail] = push(s, c, t);
            if (sel res_push.err) { ret res_push; }
        }
        ii = ii + 1;
    }
    ret err[fail.Fail].ok{};
}

pub fun collect(s: *session.Session, modules: *ir.Module, count: u32) res[Collected, fail.Fail] {
    var c: Collected = collected_init();
    var i: u32 = 0;
    for (i < count) {
        val res_module: err[fail.Fail] = collect_module(s, ?c, ?modules[i], i);
        if (sel res_module.err) {
            free(s, ?c);
            ret res[Collected, fail.Fail].err{res_module.err};
        }
        i = i + 1;
    }
    ret res[Collected, fail.Fail].ok{c};
}

pub fun free(s: *session.Session, c: *Collected) {
    if (c == nil) { ret; }

    if (c.tests != nil && c.cap > 0) {
        A.deallocate[Test](s.alloc, c.tests, c.cap::usize);
    }
    c.tests = nil;
    c.count = 0;
    c.cap   = 0;
}

pub fun main_linkage_id(s: *session.Session) res[intern.StrId, fail.Fail] {
    val r_79: res[intern.StrId, A.Error] = intern.intern(?s.interner, "main");
    if (sel r_79.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_79.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_79.ok};
}

pub fun neutralize_main(main_id: intern.StrId, mod: *ir.Module) {
    var ii: u32 = 0;
    for (ii < mod.function_len) {
        val fn: *ir.Function = ?mod.functions[ii];
        if (fn.name == main_id && (fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            fn.flags       = fn.flags | ir.FN_FLAG_EXTERN;
            fn.block_count = 0;
        }
        ii = ii + 1;
    }
}

pub fun synthesize_dispatcher(s: *session.Session, tests: *Test, count: u32) res[ir.Module, fail.Fail] {
    if (count == 0) { ret res[ir.Module, fail.Fail].err{fail.message("test dispatcher: no tests to dispatch")}; }

    val res_name: res[intern.StrId, A.Error] = intern.intern(?s.interner, "__mach_test_dispatch");
    if (sel res_name.err) {
        ret res[ir.Module, fail.Fail].err{fail.refused(res_name.err)};
    }

    val res_module: res[ir.Module, fail.Fail] = ir.init(s.alloc, res_name.ok);
    if (sel res_module.err) {
        ret res[ir.Module, fail.Fail].err{res_module.err};
    }
    var m: ir.Module = res_module.ok;

    val res_build: err[fail.Fail] = build_dispatcher(s, ?m, tests, count);
    if (sel res_build.err) {
        ir.dnit(?m);
        ret res[ir.Module, fail.Fail].err{res_build.err};
    }

    ret res[ir.Module, fail.Fail].ok{m};
}

pub fun push(s: *session.Session, c: *Collected, t: Test) err[fail.Fail] {
    if (c.count == c.cap) {
        var new_cap: u32 = c.cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_TESTS_CAP; }

        if (c.tests == nil) {
            val res_alloc: res[*Test, A.Error] = A.allocate[Test](s.alloc, new_cap::usize);
            if (sel res_alloc.err) {
                ret err[fail.Fail].err{fail.refused(res_alloc.err)};
            }
            c.tests = res_alloc.ok;
        }
        or {
            val res_realloc: res[*Test, A.Error] = A.reallocate[Test](s.alloc, c.tests, c.cap::usize, new_cap::usize);
            if (sel res_realloc.err) {
                ret err[fail.Fail].err{fail.refused(res_realloc.err)};
            }
            c.tests = res_realloc.ok;
        }

        c.cap = new_cap;
    }

    c.tests[c.count] = t;
    c.count = c.count + 1;

    ret err[fail.Fail].ok{};
}

fun build_dispatcher(s: *session.Session, m: *ir.Module, tests: *Test, count: u32) err[fail.Fail] {
    val res_i8: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 8);
    if (sel res_i8.err) { ret err[fail.Fail].err{res_i8.err}; }
    val i8t: type.IrTypeId = res_i8.ok;

    val res_i32: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 32);
    if (sel res_i32.err) { ret err[fail.Fail].err{res_i32.err}; }
    val i32t: type.IrTypeId = res_i32.ok;

    val res_i64: res[type.IrTypeId, fail.Fail] = type.intern_int(?m.types, 64);
    if (sel res_i64.err) { ret err[fail.Fail].err{res_i64.err}; }
    val i64t: type.IrTypeId = res_i64.ok;

    val res_ptr: res[type.IrTypeId, fail.Fail] = type.intern_ptr(?m.types);
    if (sel res_ptr.err) { ret err[fail.Fail].err{res_ptr.err}; }
    val ptrt: type.IrTypeId = res_ptr.ok;

    val res_tsig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i32t, nil, 0, false);
    if (sel res_tsig.err) { ret err[fail.Fail].err{res_tsig.err}; }
    val tsig: type.IrTypeId = res_tsig.ok;

    var main_params: [2]type.IrTypeId;
    main_params[0] = i64t;
    main_params[1] = ptrt;
    val res_msig: res[type.IrTypeId, fail.Fail] = type.intern_fn(?m.types, i64t, ?main_params[0], 2, false);
    if (sel res_msig.err) { ret err[fail.Fail].err{res_msig.err}; }
    val msig: type.IrTypeId = res_msig.ok;

    val res_callees: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, count::usize);
    if (sel res_callees.err) { ret err[fail.Fail].err{fail.refused(res_callees.err)}; }
    val callees: *value.Value = res_callees.ok;

    var k: u32 = 0;
    for (k < count) {
        val res_ext: res[u32, fail.Fail] = append_function(m, tests[k].linkage, tsig, ir.FN_FLAG_EXTERN);
        if (sel res_ext.err) { ret err[fail.Fail].err{res_ext.err}; }
        callees[k] = value.fn(res_ext.ok, tsig);
        k = k + 1;
    }

    val res_main: res[intern.StrId, A.Error] = intern.intern(?s.interner, "main");
    if (sel res_main.err) { ret err[fail.Fail].err{fail.refused(res_main.err)}; }
    val res_main_idx: res[u32, fail.Fail] = append_function(m, res_main.ok, msig, ir.FN_FLAG_PUB);
    if (sel res_main_idx.err) { ret err[fail.Fail].err{res_main_idx.err}; }
    val main_idx: u32 = res_main_idx.ok;

    val res_params: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, 2);
    if (sel res_params.err) { ret err[fail.Fail].err{fail.refused(res_params.err)}; }
    val params: *value.Value = res_params.ok;
    params[0] = value.param(0, i64t);
    params[1] = value.param(1, ptrt);
    m.functions[main_idx].params      = params;
    m.functions[main_idx].param_count = 2;

    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[main_idx]);

    val res_entry: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel res_entry.err) { ret err[fail.Fail].err{res_entry.err}; }
    val b_entry: id.BlockId = res_entry.ok;

    val res_bad: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel res_bad.err) { ret err[fail.Fail].err{res_bad.err}; }
    val b_bad: id.BlockId = res_bad.ok;

    val res_getarg: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel res_getarg.err) { ret err[fail.Fail].err{res_getarg.err}; }
    val b_getarg: id.BlockId = res_getarg.ok;

    val res_head: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel res_head.err) { ret err[fail.Fail].err{res_head.err}; }
    val b_head: id.BlockId = res_head.ok;

    val res_low: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel res_low.err) { ret err[fail.Fail].err{res_low.err}; }
    val b_low_ok: id.BlockId = res_low.ok;

    val res_body: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel res_body.err) { ret err[fail.Fail].err{res_body.err}; }
    val b_body: id.BlockId = res_body.ok;

    val res_dblocks: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, count::usize);
    if (sel res_dblocks.err) { ret err[fail.Fail].err{fail.refused(res_dblocks.err)}; }
    val dblocks: *id.BlockId = res_dblocks.ok;

    val res_cblocks: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, count::usize);
    if (sel res_cblocks.err) { ret err[fail.Fail].err{fail.refused(res_cblocks.err)}; }
    val cblocks: *id.BlockId = res_cblocks.ok;

    k = 0;
    for (k < count) {
        val res_d: res[id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel res_d.err) { ret err[fail.Fail].err{res_d.err}; }
        dblocks[k] = res_d.ok;

        val res_c: res[id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel res_c.err) { ret err[fail.Fail].err{res_c.err}; }
        cblocks[k] = res_c.ok;
        k = k + 1;
    }

    val argc: value.Value = value.param(0, i64t);
    val argv: value.Value = value.param(1, ptrt);

    builder.set_block(?b, b_entry);
    val res_lt2: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?b, argc, value.const_int(2, i64t));
    if (sel res_lt2.err) { ret err[fail.Fail].err{res_lt2.err}; }
    val res_cbr0: err[fail.Fail] = builder.emit_cbr(?b, res_lt2.ok, b_bad, b_getarg);
    if (sel res_cbr0.err) { ret res_cbr0; }

    builder.set_block(?b, b_bad);
    val res_ret2: err[fail.Fail] = builder.emit_ret(?b, value.const_int(2, i64t));
    if (sel res_ret2.err) { ret res_ret2; }

    builder.set_block(?b, b_getarg);
    var one_idx: [1]value.Value;
    one_idx[0] = value.const_int(1, i64t);
    val res_gep1: res[value.Value, fail.Fail] = builder.emit_gep(?b, argv, ptrt, ?one_idx[0], 1);
    if (sel res_gep1.err) { ret err[fail.Fail].err{res_gep1.err}; }
    val res_arg: res[value.Value, fail.Fail] = builder.emit_load(?b, res_gep1.ok, ptrt);
    if (sel res_arg.err) { ret err[fail.Fail].err{res_arg.err}; }
    val arg: value.Value = res_arg.ok;
    val res_c0: res[value.Value, fail.Fail] = builder.emit_load(?b, arg, i8t);
    if (sel res_c0.err) { ret err[fail.Fail].err{res_c0.err}; }
    val res_c0z: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, res_c0.ok, value.const_int(0, i8t));
    if (sel res_c0z.err) { ret err[fail.Fail].err{res_c0z.err}; }
    val res_cbr1: err[fail.Fail] = builder.emit_cbr(?b, res_c0z.ok, b_bad, b_head);
    if (sel res_cbr1.err) { ret res_cbr1; }

    builder.set_block(?b, b_head);
    val res_pphi: res[value.Value, fail.Fail] = builder.emit_phi(?b, ptrt);
    if (sel res_pphi.err) { ret err[fail.Fail].err{res_pphi.err}; }
    val p_phi: value.Value = res_pphi.ok;
    val res_aphi: res[value.Value, fail.Fail] = builder.emit_phi(?b, i64t);
    if (sel res_aphi.err) { ret err[fail.Fail].err{res_aphi.err}; }
    val acc_phi: value.Value = res_aphi.ok;

    val res_c: res[value.Value, fail.Fail] = builder.emit_load(?b, p_phi, i8t);
    if (sel res_c.err) { ret err[fail.Fail].err{res_c.err}; }
    val c: value.Value = res_c.ok;
    val res_end: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, c, value.const_int(0, i8t));
    if (sel res_end.err) { ret err[fail.Fail].err{res_end.err}; }
    val res_cbr2: err[fail.Fail] = builder.emit_cbr(?b, res_end.ok, dblocks[0], b_low_ok);
    if (sel res_cbr2.err) { ret res_cbr2; }

    builder.set_block(?b, b_low_ok);
    val res_lt0: res[value.Value, fail.Fail] = builder.emit_cmp_lt_u(?b, c, value.const_int(48, i8t));
    if (sel res_lt0.err) { ret err[fail.Fail].err{res_lt0.err}; }
    val res_cbr3: err[fail.Fail] = builder.emit_cbr(?b, res_lt0.ok, b_bad, b_body);
    if (sel res_cbr3.err) { ret res_cbr3; }

    builder.set_block(?b, b_body);
    val res_gt9: res[value.Value, fail.Fail] = builder.emit_cmp_lt_u(?b, value.const_int(57, i8t), c);
    if (sel res_gt9.err) { ret err[fail.Fail].err{res_gt9.err}; }

    val res_step: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel res_step.err) { ret err[fail.Fail].err{res_step.err}; }
    val b_step: id.BlockId = res_step.ok;
    val res_cbr4: err[fail.Fail] = builder.emit_cbr(?b, res_gt9.ok, b_bad, b_step);
    if (sel res_cbr4.err) { ret res_cbr4; }

    builder.set_block(?b, b_step);
    val res_cz: res[value.Value, fail.Fail] = builder.emit_zext(?b, c, i64t);
    if (sel res_cz.err) { ret err[fail.Fail].err{res_cz.err}; }
    val res_dig: res[value.Value, fail.Fail] = builder.emit_sub(?b, res_cz.ok, value.const_int(48, i64t));
    if (sel res_dig.err) { ret err[fail.Fail].err{res_dig.err}; }
    val res_m10: res[value.Value, fail.Fail] = builder.emit_mul(?b, acc_phi, value.const_int(10, i64t));
    if (sel res_m10.err) { ret err[fail.Fail].err{res_m10.err}; }
    val res_acc: res[value.Value, fail.Fail] = builder.emit_add(?b, res_m10.ok, res_dig.ok);
    if (sel res_acc.err) { ret err[fail.Fail].err{res_acc.err}; }
    val acc_next: value.Value = res_acc.ok;
    val res_pn: res[value.Value, fail.Fail] = builder.emit_gep(?b, p_phi, i8t, ?one_idx[0], 1);
    if (sel res_pn.err) { ret err[fail.Fail].err{res_pn.err}; }
    val p_next: value.Value = res_pn.ok;
    val res_br: err[fail.Fail] = builder.emit_br(?b, b_head);
    if (sel res_br.err) { ret res_br; }

    val res_in1: err[fail.Fail] = builder.phi_add_incoming(?b, p_phi, b_getarg, arg);
    if (sel res_in1.err) { ret res_in1; }
    val res_in2: err[fail.Fail] = builder.phi_add_incoming(?b, p_phi, b_step, p_next);
    if (sel res_in2.err) { ret res_in2; }
    val res_in3: err[fail.Fail] = builder.phi_add_incoming(?b, acc_phi, b_getarg, value.const_int(0, i64t));
    if (sel res_in3.err) { ret res_in3; }
    val res_in4: err[fail.Fail] = builder.phi_add_incoming(?b, acc_phi, b_step, acc_next);
    if (sel res_in4.err) { ret res_in4; }

    k = 0;
    for (k < count) {
        builder.set_block(?b, dblocks[k]);
        val res_eq: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, acc_phi, value.const_int(k::u64, i64t));
        if (sel res_eq.err) { ret err[fail.Fail].err{res_eq.err}; }
        var miss: id.BlockId = b_bad;
        if (k + 1 < count) { miss = dblocks[k + 1]; }
        val res_cbrk: err[fail.Fail] = builder.emit_cbr(?b, res_eq.ok, cblocks[k], miss);
        if (sel res_cbrk.err) { ret res_cbrk; }

        builder.set_block(?b, cblocks[k]);
        val res_call: res[value.Value, fail.Fail] = builder.emit_call(?b, callees[k], nil, 0, i32t);
        if (sel res_call.err) { ret err[fail.Fail].err{res_call.err}; }
        val res_r64: res[value.Value, fail.Fail] = builder.emit_sext(?b, res_call.ok, i64t);
        if (sel res_r64.err) { ret err[fail.Fail].err{res_r64.err}; }
        val res_retk: err[fail.Fail] = builder.emit_ret(?b, res_r64.ok);
        if (sel res_retk.err) { ret res_retk; }
        k = k + 1;
    }

    ret err[fail.Fail].ok{};
}

fun append_function(m: *ir.Module, name: intern.StrId, sig: type.IrTypeId, flags: u32) res[u32, fail.Fail] {
    val res_add: res[u32, fail.Fail] = ir.function_add(m, name, sig, flags);
    if (sel res_add.err) {
        ret res[u32, fail.Fail].err{res_add.err};
    }
    val idx: u32 = res_add.ok;

    val res_reg: err[fail.Fail] = ir.function_register(m, name, idx);
    if (sel res_reg.err) {
        ret res[u32, fail.Fail].err{res_reg.err};
    }

    ret res[u32, fail.Fail].ok{idx};
}
