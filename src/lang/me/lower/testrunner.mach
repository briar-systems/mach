use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.id;
use mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.session;
use mach.lang.fail;

pub rec Test {
    linkage: intern.StrId;
    label:   intern.StrId;
    line:    u32;
    mod_idx: u32;
}

pub rec Collected {
    tests: *Test;
    count: u32;
    cap:   u32;
}

val INITIAL_TESTS_CAP: u32 = 8;

pub fun collect(s: *session.Session, modules: *ir.Module, count: u32) R.Result[Collected, fail.Fail] {
    var c: Collected;
    c.tests = nil;
    c.count = 0;
    c.cap   = 0;

    var i: u32 = 0;
    for (i < count) {
        val mod: *ir.Module = ?modules[i];
        var ii: u32 = 0;
        for (ii < mod.function_len) {
            val fn: *ir.Function = ?mod.functions[ii];
            if ((fn.flags & ir.FN_FLAG_TEST) != 0) {
                var t: Test;
                t.linkage = fn.name;
                t.label   = fn.label;
                t.line    = fn.line;
                t.mod_idx = i;

                val res_push: R.Result[R.Void, fail.Fail] = push_test(s, ?c, t);
                if (R.is_err[R.Void, fail.Fail](res_push)) {
                    free(s, ?c);
                    ret R.err[Collected, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_push));
                }
            }
            ii = ii + 1;
        }
        i = i + 1;
    }

    ret R.ok[Collected, fail.Fail](c);
}

pub fun free(s: *session.Session, c: *Collected) {
    if (c == nil) { ret; }

    if (c.tests != nil && c.cap > 0) {
        A.deallocate[Test](s.alloc, c.tests, c.cap::usize);
    }
    c.tests = nil;
    c.count = 0;
    c.cap   = 0;
}

pub fun main_linkage_id(s: *session.Session) R.Result[intern.StrId, fail.Fail] {
    ret fail.lift[intern.StrId](intern.intern(?s.interner, "main"));
}

pub fun neutralize_main(main_id: intern.StrId, mod: *ir.Module) {
    var ii: u32 = 0;
    for (ii < mod.function_len) {
        val fn: *ir.Function = ?mod.functions[ii];
        if (fn.name == main_id && (fn.flags & ir.FN_FLAG_EXTERN) == 0) {
            fn.flags       = fn.flags | ir.FN_FLAG_EXTERN;
            fn.block_count = 0;
        }
        ii = ii + 1;
    }
}

pub fun synthesize_dispatcher(s: *session.Session, tests: *Test, count: u32) R.Result[ir.Module, fail.Fail] {
    if (count == 0) { ret R.err[ir.Module, fail.Fail](fail.message("test dispatcher: no tests to dispatch")); }

    val res_name: R.Result[intern.StrId, str] = intern.intern(?s.interner, "__mach_test_dispatch");
    if (R.is_err[intern.StrId, str](res_name)) {
        ret R.err[ir.Module, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name)));
    }

    val res_module: R.Result[ir.Module, str] = ir.init(s.alloc, R.unwrap_ok[intern.StrId, str](res_name));
    if (R.is_err[ir.Module, str](res_module)) {
        ret R.err[ir.Module, fail.Fail](fail.message(R.unwrap_err[ir.Module, str](res_module)));
    }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_module);

    val res_build: R.Result[R.Void, fail.Fail] = build_dispatcher(s, ?m, tests, count);
    if (R.is_err[R.Void, fail.Fail](res_build)) {
        ir.dnit(?m);
        ret R.err[ir.Module, fail.Fail](R.unwrap_err[R.Void, fail.Fail](res_build));
    }

    ret R.ok[ir.Module, fail.Fail](m);
}

fun push_test(s: *session.Session, c: *Collected, t: Test) R.Result[R.Void, fail.Fail] {
    if (c.count == c.cap) {
        var new_cap: u32 = c.cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_TESTS_CAP; }

        if (c.tests == nil) {
            val res_alloc: R.Result[*Test, str] = A.allocate[Test](s.alloc, new_cap::usize);
            if (R.is_err[*Test, str](res_alloc)) {
                ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*Test, str](res_alloc)));
            }
            c.tests = R.unwrap_ok[*Test, str](res_alloc);
        }
        or {
            val res_realloc: R.Result[*Test, str] = A.reallocate[Test](s.alloc, c.tests, c.cap::usize, new_cap::usize);
            if (R.is_err[*Test, str](res_realloc)) {
                ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*Test, str](res_realloc)));
            }
            c.tests = R.unwrap_ok[*Test, str](res_realloc);
        }

        c.cap = new_cap;
    }

    c.tests[c.count] = t;
    c.count = c.count + 1;

    ret R.ok_void[fail.Fail]();
}

fun build_dispatcher(s: *session.Session, m: *ir.Module, tests: *Test, count: u32) R.Result[R.Void, fail.Fail] {
    val res_i8: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 8);
    if (R.is_err[type.IrTypeId, str](res_i8)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[type.IrTypeId, str](res_i8))); }
    val i8t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i8);

    val res_i32: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 32);
    if (R.is_err[type.IrTypeId, str](res_i32)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[type.IrTypeId, str](res_i32))); }
    val i32t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i32);

    val res_i64: R.Result[type.IrTypeId, str] = type.intern_int(?m.types, 64);
    if (R.is_err[type.IrTypeId, str](res_i64)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[type.IrTypeId, str](res_i64))); }
    val i64t: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_i64);

    val res_ptr: R.Result[type.IrTypeId, str] = type.intern_ptr(?m.types);
    if (R.is_err[type.IrTypeId, str](res_ptr)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[type.IrTypeId, str](res_ptr))); }
    val ptrt: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_ptr);

    val res_tsig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i32t, nil, 0, false);
    if (R.is_err[type.IrTypeId, str](res_tsig)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[type.IrTypeId, str](res_tsig))); }
    val tsig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_tsig);

    var main_params: [2]type.IrTypeId;
    main_params[0] = i64t;
    main_params[1] = ptrt;
    val res_msig: R.Result[type.IrTypeId, str] = type.intern_fn(?m.types, i64t, ?main_params[0], 2, false);
    if (R.is_err[type.IrTypeId, str](res_msig)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[type.IrTypeId, str](res_msig))); }
    val msig: type.IrTypeId = R.unwrap_ok[type.IrTypeId, str](res_msig);

    val res_callees: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, count::usize);
    if (R.is_err[*value.Value, str](res_callees)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*value.Value, str](res_callees))); }
    val callees: *value.Value = R.unwrap_ok[*value.Value, str](res_callees);

    var k: u32 = 0;
    for (k < count) {
        val res_ext: R.Result[u32, fail.Fail] = append_function(m, tests[k].linkage, tsig, ir.FN_FLAG_EXTERN);
        if (R.is_err[u32, fail.Fail](res_ext)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_ext)); }
        callees[k] = value.fn(R.unwrap_ok[u32, fail.Fail](res_ext), tsig);
        k = k + 1;
    }

    val res_main: R.Result[intern.StrId, str] = intern.intern(?s.interner, "main");
    if (R.is_err[intern.StrId, str](res_main)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_main))); }
    val res_main_idx: R.Result[u32, fail.Fail] = append_function(m, R.unwrap_ok[intern.StrId, str](res_main), msig, ir.FN_FLAG_PUB);
    if (R.is_err[u32, fail.Fail](res_main_idx)) { ret R.err[R.Void, fail.Fail](R.unwrap_err[u32, fail.Fail](res_main_idx)); }
    val main_idx: u32 = R.unwrap_ok[u32, fail.Fail](res_main_idx);

    val res_params: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, 2);
    if (R.is_err[*value.Value, str](res_params)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*value.Value, str](res_params))); }
    val params: *value.Value = R.unwrap_ok[*value.Value, str](res_params);
    params[0] = value.param(0, i64t);
    params[1] = value.param(1, ptrt);
    m.functions[main_idx].params      = params;
    m.functions[main_idx].param_count = 2;

    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[main_idx]);

    val res_entry: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](res_entry)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_entry))); }
    val b_entry: id.BlockId = R.unwrap_ok[id.BlockId, str](res_entry);

    val res_bad: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](res_bad)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_bad))); }
    val b_bad: id.BlockId = R.unwrap_ok[id.BlockId, str](res_bad);

    val res_getarg: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](res_getarg)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_getarg))); }
    val b_getarg: id.BlockId = R.unwrap_ok[id.BlockId, str](res_getarg);

    val res_head: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](res_head)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_head))); }
    val b_head: id.BlockId = R.unwrap_ok[id.BlockId, str](res_head);

    val res_low: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](res_low)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_low))); }
    val b_low_ok: id.BlockId = R.unwrap_ok[id.BlockId, str](res_low);

    val res_body: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](res_body)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_body))); }
    val b_body: id.BlockId = R.unwrap_ok[id.BlockId, str](res_body);

    val res_dblocks: R.Result[*id.BlockId, str] = A.allocate[id.BlockId](m.alloc, count::usize);
    if (R.is_err[*id.BlockId, str](res_dblocks)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*id.BlockId, str](res_dblocks))); }
    val dblocks: *id.BlockId = R.unwrap_ok[*id.BlockId, str](res_dblocks);

    val res_cblocks: R.Result[*id.BlockId, str] = A.allocate[id.BlockId](m.alloc, count::usize);
    if (R.is_err[*id.BlockId, str](res_cblocks)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*id.BlockId, str](res_cblocks))); }
    val cblocks: *id.BlockId = R.unwrap_ok[*id.BlockId, str](res_cblocks);

    k = 0;
    for (k < count) {
        val res_d: R.Result[id.BlockId, str] = builder.new_block(?b);
        if (R.is_err[id.BlockId, str](res_d)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_d))); }
        dblocks[k] = R.unwrap_ok[id.BlockId, str](res_d);

        val res_c: R.Result[id.BlockId, str] = builder.new_block(?b);
        if (R.is_err[id.BlockId, str](res_c)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_c))); }
        cblocks[k] = R.unwrap_ok[id.BlockId, str](res_c);
        k = k + 1;
    }

    val argc: value.Value = value.param(0, i64t);
    val argv: value.Value = value.param(1, ptrt);

    builder.set_block(?b, b_entry);
    val res_lt2: R.Result[value.Value, str] = builder.emit_cmp_lt_s(?b, argc, value.const_int(2, i64t));
    if (R.is_err[value.Value, str](res_lt2)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_lt2))); }
    val res_cbr0: R.Result[R.Void, str] = builder.emit_cbr(?b, R.unwrap_ok[value.Value, str](res_lt2), b_bad, b_getarg);
    if (R.is_err[R.Void, str](res_cbr0)) { ret fail.lift[R.Void](res_cbr0); }

    builder.set_block(?b, b_bad);
    val res_ret2: R.Result[R.Void, str] = builder.emit_ret(?b, value.const_int(2, i64t));
    if (R.is_err[R.Void, str](res_ret2)) { ret fail.lift[R.Void](res_ret2); }

    builder.set_block(?b, b_getarg);
    var one_idx: [1]value.Value;
    one_idx[0] = value.const_int(1, i64t);
    val res_gep1: R.Result[value.Value, str] = builder.emit_gep(?b, argv, ptrt, ?one_idx[0], 1);
    if (R.is_err[value.Value, str](res_gep1)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_gep1))); }
    val res_arg: R.Result[value.Value, str] = builder.emit_load(?b, R.unwrap_ok[value.Value, str](res_gep1), ptrt);
    if (R.is_err[value.Value, str](res_arg)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_arg))); }
    val arg: value.Value = R.unwrap_ok[value.Value, str](res_arg);
    val res_c0: R.Result[value.Value, str] = builder.emit_load(?b, arg, i8t);
    if (R.is_err[value.Value, str](res_c0)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_c0))); }
    val res_c0z: R.Result[value.Value, str] = builder.emit_cmp_eq(?b, R.unwrap_ok[value.Value, str](res_c0), value.const_int(0, i8t));
    if (R.is_err[value.Value, str](res_c0z)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_c0z))); }
    val res_cbr1: R.Result[R.Void, str] = builder.emit_cbr(?b, R.unwrap_ok[value.Value, str](res_c0z), b_bad, b_head);
    if (R.is_err[R.Void, str](res_cbr1)) { ret fail.lift[R.Void](res_cbr1); }

    builder.set_block(?b, b_head);
    val res_pphi: R.Result[value.Value, str] = builder.emit_phi(?b, ptrt);
    if (R.is_err[value.Value, str](res_pphi)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_pphi))); }
    val p_phi: value.Value = R.unwrap_ok[value.Value, str](res_pphi);
    val res_aphi: R.Result[value.Value, str] = builder.emit_phi(?b, i64t);
    if (R.is_err[value.Value, str](res_aphi)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_aphi))); }
    val acc_phi: value.Value = R.unwrap_ok[value.Value, str](res_aphi);

    val res_c: R.Result[value.Value, str] = builder.emit_load(?b, p_phi, i8t);
    if (R.is_err[value.Value, str](res_c)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_c))); }
    val c: value.Value = R.unwrap_ok[value.Value, str](res_c);
    val res_end: R.Result[value.Value, str] = builder.emit_cmp_eq(?b, c, value.const_int(0, i8t));
    if (R.is_err[value.Value, str](res_end)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_end))); }
    val res_cbr2: R.Result[R.Void, str] = builder.emit_cbr(?b, R.unwrap_ok[value.Value, str](res_end), dblocks[0], b_low_ok);
    if (R.is_err[R.Void, str](res_cbr2)) { ret fail.lift[R.Void](res_cbr2); }

    builder.set_block(?b, b_low_ok);
    val res_lt0: R.Result[value.Value, str] = builder.emit_cmp_lt_u(?b, c, value.const_int(48, i8t));
    if (R.is_err[value.Value, str](res_lt0)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_lt0))); }
    val res_cbr3: R.Result[R.Void, str] = builder.emit_cbr(?b, R.unwrap_ok[value.Value, str](res_lt0), b_bad, b_body);
    if (R.is_err[R.Void, str](res_cbr3)) { ret fail.lift[R.Void](res_cbr3); }

    builder.set_block(?b, b_body);
    val res_gt9: R.Result[value.Value, str] = builder.emit_cmp_lt_u(?b, value.const_int(57, i8t), c);
    if (R.is_err[value.Value, str](res_gt9)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_gt9))); }

    val res_step: R.Result[id.BlockId, str] = builder.new_block(?b);
    if (R.is_err[id.BlockId, str](res_step)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[id.BlockId, str](res_step))); }
    val b_step: id.BlockId = R.unwrap_ok[id.BlockId, str](res_step);
    val res_cbr4: R.Result[R.Void, str] = builder.emit_cbr(?b, R.unwrap_ok[value.Value, str](res_gt9), b_bad, b_step);
    if (R.is_err[R.Void, str](res_cbr4)) { ret fail.lift[R.Void](res_cbr4); }

    builder.set_block(?b, b_step);
    val res_cz: R.Result[value.Value, str] = builder.emit_zext(?b, c, i64t);
    if (R.is_err[value.Value, str](res_cz)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_cz))); }
    val res_dig: R.Result[value.Value, str] = builder.emit_sub(?b, R.unwrap_ok[value.Value, str](res_cz), value.const_int(48, i64t));
    if (R.is_err[value.Value, str](res_dig)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_dig))); }
    val res_m10: R.Result[value.Value, str] = builder.emit_mul(?b, acc_phi, value.const_int(10, i64t));
    if (R.is_err[value.Value, str](res_m10)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_m10))); }
    val res_acc: R.Result[value.Value, str] = builder.emit_add(?b, R.unwrap_ok[value.Value, str](res_m10), R.unwrap_ok[value.Value, str](res_dig));
    if (R.is_err[value.Value, str](res_acc)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_acc))); }
    val acc_next: value.Value = R.unwrap_ok[value.Value, str](res_acc);
    val res_pn: R.Result[value.Value, str] = builder.emit_gep(?b, p_phi, i8t, ?one_idx[0], 1);
    if (R.is_err[value.Value, str](res_pn)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_pn))); }
    val p_next: value.Value = R.unwrap_ok[value.Value, str](res_pn);
    val res_br: R.Result[R.Void, str] = builder.emit_br(?b, b_head);
    if (R.is_err[R.Void, str](res_br)) { ret fail.lift[R.Void](res_br); }

    val res_in1: R.Result[R.Void, str] = builder.phi_add_incoming(?b, p_phi, b_getarg, arg);
    if (R.is_err[R.Void, str](res_in1)) { ret fail.lift[R.Void](res_in1); }
    val res_in2: R.Result[R.Void, str] = builder.phi_add_incoming(?b, p_phi, b_step, p_next);
    if (R.is_err[R.Void, str](res_in2)) { ret fail.lift[R.Void](res_in2); }
    val res_in3: R.Result[R.Void, str] = builder.phi_add_incoming(?b, acc_phi, b_getarg, value.const_int(0, i64t));
    if (R.is_err[R.Void, str](res_in3)) { ret fail.lift[R.Void](res_in3); }
    val res_in4: R.Result[R.Void, str] = builder.phi_add_incoming(?b, acc_phi, b_step, acc_next);
    if (R.is_err[R.Void, str](res_in4)) { ret fail.lift[R.Void](res_in4); }

    k = 0;
    for (k < count) {
        builder.set_block(?b, dblocks[k]);
        val res_eq: R.Result[value.Value, str] = builder.emit_cmp_eq(?b, acc_phi, value.const_int(k::u64, i64t));
        if (R.is_err[value.Value, str](res_eq)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_eq))); }
        var miss: id.BlockId = b_bad;
        if (k + 1 < count) { miss = dblocks[k + 1]; }
        val res_cbrk: R.Result[R.Void, str] = builder.emit_cbr(?b, R.unwrap_ok[value.Value, str](res_eq), cblocks[k], miss);
        if (R.is_err[R.Void, str](res_cbrk)) { ret fail.lift[R.Void](res_cbrk); }

        builder.set_block(?b, cblocks[k]);
        val res_call: R.Result[value.Value, str] = builder.emit_call(?b, callees[k], nil, 0, i32t);
        if (R.is_err[value.Value, str](res_call)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_call))); }
        val res_r64: R.Result[value.Value, str] = builder.emit_sext(?b, R.unwrap_ok[value.Value, str](res_call), i64t);
        if (R.is_err[value.Value, str](res_r64)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[value.Value, str](res_r64))); }
        val res_retk: R.Result[R.Void, str] = builder.emit_ret(?b, R.unwrap_ok[value.Value, str](res_r64));
        if (R.is_err[R.Void, str](res_retk)) { ret fail.lift[R.Void](res_retk); }
        k = k + 1;
    }

    ret R.ok_void[fail.Fail]();
}

fun append_function(m: *ir.Module, name: intern.StrId, sig: type.IrTypeId, flags: u32) R.Result[u32, fail.Fail] {
    val res_add: R.Result[u32, str] = ir.function_add(m, name, sig, flags);
    if (R.is_err[u32, str](res_add)) {
        ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[u32, str](res_add)));
    }
    val idx: u32 = R.unwrap_ok[u32, str](res_add);

    val res_reg: R.Result[R.Void, str] = ir.function_register(m, name, idx);
    if (R.is_err[R.Void, str](res_reg)) {
        ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_reg)));
    }

    ret R.ok[u32, fail.Fail](idx);
}
