use mach.lang.growth;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl:   mach.lang.fe.ast.decl;
use ast_id:     mach.lang.fe.ast.id;
use ast_module: mach.lang.fe.ast.module;
use mach.lang.fe.resolve;
use mach.lang.intern;
use mach.lang.me.lower.builder;
use lower_context: mach.lang.me.lower.context;
use mach.lang.me.lower.irt;
use mach.lang.me.lower.value;
use mach.lang.session;

use mink.model.symbol;
use mirl.ir.function.FunctionData;
use mirl.ir.id;
use mirl.ir.linkage.Linkage;
use mirl_module: mirl.ir.module;
use types:       mirl.ir.type;
use mirl.ir.type.Type;
use collections_vector: std.collections.vector;
use std.types.string.str_len;
use std.types.view.View;

# name: the qualified name `<module path>#<identifier>`, which is also the test's symbol
pub rec Test {
    name:    intern.StrId;
    line:    u32;
    mod_idx: u32;
}

pub rec Collected {
    tests: *Test;
    count: u32;
    cap:   u32;
}

pub fun collected_init() Collected {
    var c: Collected;
    c.tests = nil;
    c.count = 0;
    c.cap   = 0;
    ret c;
}

# the test declarations of one lowered module, in function order
pub fun collect_module(s: *session.Session, c: *Collected, unit: *lower_context.Unit, mod_idx: u32) err[fail.Fail] {
    var ii: usize = 0;
    for (ii < unit.fns.len) {
        val info: *lower_context.FnInfo = ?unit.fns.data[ii];
        if (info.test) {
            var t: Test;
            t.name    = info.name;
            t.line    = info.line;
            t.mod_idx = mod_idx;
            val res_push: err[fail.Fail] = push(s, c, t);
            if (sel res_push.err) { ret res_push; }
        }
        ii = ii + 1;
    }
    ret err[fail.Fail].ok{};
}

# release a collection; a nil collection holds nothing
pub fun free(s: *session.Session, c: *Collected) {
    if (c == nil) { ret; }

    if (c.tests != nil && c.cap > 0) {
        A.deallocate[Test](s.alloc, c.tests, c.cap::usize);
    }
    c.tests = nil;
    c.count = 0;
    c.cap   = 0;
}

# the dispatcher's entry: the name the runtime's start routine calls
pub val MAIN_LINKAGE: str = "main";

# the module has a test object: its source declares a test or a `#[testing]`
# declaration, in any comptime branch. the declaration lists of the module and of
# every branch of a declaring chain are the only lists the declaration pool holds,
# so one pass over the pool reads every branch at any depth without descending
pub fun declares_tests(a: *ast.Ast) bool {
    var i: usize = 0;
    for (i < a.decl_ids.len) {
        val did:  ast_id.DeclId       = a.decl_ids.data[i];
        val node: opt[*ast_decl.Decl] = ast.get_decl(a, did);
        if (sel node.some) {
            if (node.some.kind == ast_decl.DECL_KIND_TEST) { ret true; }
            if (resolve.declaration_testing(a, did))       { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# the status a test result outside 0..255 exits with: the process exit code is
# eight bits on posix, so a wider result is folded to this value rather than
# truncated, and it can never read as a pass
val TEST_STATUS_WIDE: u64 = 255;

# synthesize the test dispatcher module: a `main(argc, argv)` that parses argv[1]
# as a decimal test index, calls that test, and exits with its result folded to the
# status protocol. a result in 0..255 is the exit code as is; any other result
# exits `TEST_STATUS_WIDE`; a missing or malformed index, or one past `count`,
# exits 2
# ---
# s:       the session whose interner names the dispatcher and `main`
# machine: the target the dispatcher is built for
# tests:   the collected tests in dispatch order, indexed by argv[1]
# count:   how many tests there are, at least one
# ret:     the dispatcher's mirl module, owned by the caller, or why it could not be built
pub fun synthesize_dispatcher(s: *session.Session, machine: *lower_context.Machine, tests: *Test, count: u32) res[mirl_module.Module, fail.Fail] {
    if (count == 0) { ret res[mirl_module.Module, fail.Fail].err{fail.message("test dispatcher: no tests to dispatch")}; }

    val made: res[mirl_module.Module, fail.Fail] = lower_context.module_init(s.alloc, machine);
    if (sel made.err) { ret made; }
    var m: mirl_module.Module = made.ok;

    val res_build: err[fail.Fail] = build_dispatcher(s, machine, ?m, tests, count);
    if (sel res_build.err) {
        mirl_module.dnit(?m);
        ret res[mirl_module.Module, fail.Fail].err{res_build.err};
    }
    ret res[mirl_module.Module, fail.Fail].ok{m};
}

pub fun push(s: *session.Session, c: *Collected, t: Test) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[Test](s.alloc, ?c.tests, ?c.cap, c.count::usize + 1);
    if (sel grown.err) {
        ret err[fail.Fail].err{fail.refused(grown.err)};
    }

    c.tests[c.count] = t;
    c.count          = c.count + 1;

    ret err[fail.Fail].ok{};
}

fun view_of(s: *session.Session, name: intern.StrId) View {
    val text: str = intern.text(?s.interner, name);
    ret View{data: text, len: str_len(text)};
}

fun build_dispatcher(s: *session.Session, machine: *lower_context.Machine, m: *mirl_module.Module, tests: *Test, count: u32) err[fail.Fail] {
    val t: *types.Table    = ?m.types;
    var b: builder.Builder = builder.init(m, s.alloc, machine.target, machine.ctx, machine.slots, ?s.sources, false);
    fin { builder.dnit(?b); }

    val i8t:  Type = builder.int_type(?b, 8);
    val i32t: Type = builder.int_type(?b, 32);
    val i64t: Type = builder.int_type(?b, 64);
    val ptrt: Type = builder.ptr_type(?b);

    var test_result: Type                 = i32t;
    var test_ext:    types.Extension      = types.Extension.sext{};
    val res_tsig:    res[Type, fail.Fail] = irt.signature(t, nil, nil, 0, ?test_result, ?test_ext, 1);
    if (sel res_tsig.err) { ret err[fail.Fail].err{res_tsig.err}; }
    val tsig: Type = res_tsig.ok;

    var main_params: [2]Type              = [2]Type{i64t, ptrt};
    var main_ext:    [2]types.Extension   = [2]types.Extension{types.Extension.none{}, types.Extension.none{}};
    var main_result: Type                 = i64t;
    var main_rext:   types.Extension      = types.Extension.none{};
    val res_msig:    res[Type, fail.Fail] = irt.signature(t, ?main_params[0], ?main_ext[0], 2, ?main_result, ?main_rext, 1);
    if (sel res_msig.err) { ret err[fail.Fail].err{res_msig.err}; }
    val msig: Type = res_msig.ok;

    val global:  Linkage                                = Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT};
    var callees: collections_vector.Vector[value.Value] = collections_vector.init[value.Value](s.alloc);
    fin { collections_vector.dnit[value.Value](?callees); }
    var k: u32 = 0;
    for (k < count) {
        val f: res[id.Function, fail.Fail] = add(m, FunctionData{name: view_of(s, tests[k].name), signature: tsig, linkage: global, constant_time: false});
        if (sel f.err) { ret err[fail.Fail].err{f.err}; }
        val pushed: res[usize, A.Error] = collections_vector.push[value.Value](?callees, value.fn(f.ok.index, ptrt, tsig));
        if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        k = k + 1;
    }

    val res_main: res[intern.StrId, A.Error] = intern.add(?s.interner, MAIN_LINKAGE);
    if (sel res_main.err) { ret err[fail.Fail].err{fail.refused(res_main.err)}; }
    val main_f: res[id.Function, fail.Fail] = add(m, FunctionData{name: view_of(s, res_main.ok), signature: msig, linkage: global, constant_time: false});
    if (sel main_f.err) { ret err[fail.Fail].err{main_f.err}; }

    val b_entry: id.Block    = builder.enter(?b, main_f.ok, ?main_params[0], nil, 2);
    val argc:    value.Value = builder.block_param(?b, b_entry, 0, i64t);
    val argv:    value.Value = builder.block_param(?b, b_entry, 1, ptrt);

    # the digit loop carries the character pointer and the index read so far
    var loop_tys: [2]Type  = [2]Type{ptrt, i64t};
    val b_bad:    id.Block = builder.new_block_with(?b, nil, nil, 0);
    val b_getarg: id.Block = builder.new_block_with(?b, nil, nil, 0);
    val b_head:   id.Block = builder.new_block_with(?b, ?loop_tys[0], nil, 2);
    val b_low_ok: id.Block = builder.new_block_with(?b, nil, nil, 0);
    val b_body:   id.Block = builder.new_block_with(?b, nil, nil, 0);
    val b_step:   id.Block = builder.new_block_with(?b, nil, nil, 0);
    val b_wide:   id.Block = builder.new_block_with(?b, nil, nil, 0);
    val b_found:  id.Block = builder.new_block_with(?b, nil, nil, 0);

    builder.cbr(?b, builder.lt_s(?b, argc, value.const_int(2, i64t)), b_bad, b_getarg);

    builder.set_block(?b, b_bad);
    builder.take_err(?b, builder.emit_ret(?b, value.const_int(2, i64t)));

    builder.set_block(?b, b_getarg);
    val slot1: value.Value = builder.take(?b, builder.emit_step(?b, argv, ptrt, value.const_int(1, i64t)));
    val arg:   value.Value = builder.take(?b, builder.emit_load(?b, slot1, ptrt));
    val c0:    value.Value = builder.take(?b, builder.emit_load(?b, arg, i8t));
    val start: id.Block    = builder.new_block_with(?b, nil, nil, 0);
    builder.cbr(?b, builder.eq(?b, c0, value.const_int(0, i8t)), b_bad, start);
    builder.set_block(?b, start);
    var first: [2]value.Value = [2]value.Value{arg, value.const_int(0, i64t)};
    builder.take_err(?b, builder.emit_br_args(?b, b_head, ?first[0], 2));

    builder.set_block(?b, b_head);
    val p:   value.Value = builder.block_param(?b, b_head, 0, ptrt);
    val acc: value.Value = builder.block_param(?b, b_head, 1, i64t);
    val c:   value.Value = builder.take(?b, builder.emit_load(?b, p, i8t));
    builder.cbr(?b, builder.eq(?b, c, value.const_int(0, i8t)), b_found, b_low_ok);

    builder.set_block(?b, b_low_ok);
    builder.cbr(?b, builder.lt_u(?b, c, value.const_int(48, i8t)), b_bad, b_body);

    builder.set_block(?b, b_body);
    builder.cbr(?b, builder.lt_u(?b, value.const_int(57, i8t), c), b_bad, b_step);

    builder.set_block(?b, b_step);
    val digit: value.Value    = builder.sub(?b, builder.zext(?b, c, i64t), value.const_int(48, i64t));
    var next:  [2]value.Value = [2]value.Value{
        builder.take(?b, builder.emit_step(?b, p, i8t, value.const_int(1, i64t))),
        builder.add(?b, builder.mul(?b, acc, value.const_int(10, i64t)), digit)
    };
    builder.take_err(?b, builder.emit_br_args(?b, b_head, ?next[0], 2));

    # one case per test; any other index is malformed
    builder.set_block(?b, b_found);
    var cases:   collections_vector.Vector[u64]      = collections_vector.init[u64](s.alloc);
    var targets: collections_vector.Vector[id.Block] = collections_vector.init[id.Block](s.alloc);
    fin {
        collections_vector.dnit[u64](?cases);
        collections_vector.dnit[id.Block](?targets);
    }
    k = 0;
    for (k < count) {
        val pc: res[usize, A.Error] = collections_vector.push[u64](?cases, k::u64);
        if (sel pc.err) { ret err[fail.Fail].err{fail.refused(pc.err)}; }
        val pt: res[usize, A.Error] = collections_vector.push[id.Block](?targets, builder.new_block_with(?b, nil, nil, 0));
        if (sel pt.err) { ret err[fail.Fail].err{fail.refused(pt.err)}; }
        k = k + 1;
    }
    builder.take_err(?b, builder.emit_switch(?b, acc, b_bad, cases.data, targets.data, count));

    k = 0;
    for (k < count) {
        builder.set_block(?b, targets.data[k]);
        val result: value.Value = builder.take(?b, builder.emit_call(?b, callees.data[k], tsig, nil, 0));
        # an unsigned compare puts every negative result past 255 as well
        val narrow: id.Block = builder.new_block_with(?b, nil, nil, 0);
        builder.cbr(?b, builder.lt_u(?b, value.const_int(TEST_STATUS_WIDE, i32t), result), b_wide, narrow);
        builder.set_block(?b, narrow);
        builder.take_err(?b, builder.emit_ret(?b, builder.sext(?b, result, i64t)));
        k = k + 1;
    }

    builder.set_block(?b, b_wide);
    builder.take_err(?b, builder.emit_ret(?b, value.const_int(TEST_STATUS_WIDE, i64t)));
    builder.leave(?b);
    ret builder.done(?b);
}

# add a function to the dispatcher's module
fun add(m: *mirl_module.Module, data: FunctionData) res[id.Function, fail.Fail] {
    val made: res[id.Function, mirl_module.Error] = mirl_module.add_function(m, data);
    if (sel made.err) { ret res[id.Function, fail.Fail].err{fail.message("test dispatcher: mirl refused a function")}; }
    ret res[id.Function, fail.Fail].ok{made.ok};
}
