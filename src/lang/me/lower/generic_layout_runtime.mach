use mach.lang.fail;
use std.types.bool.bool;
use std.types.size.usize;

#[testing]
rec AnonInGeneric[T, E] {
    tag: bool;
    v:   uni { a: T; b: E; };
}

#[testing]
rec AnonInPlain {
    tag: bool;
    v:   uni { a: u32; b: u32; };
}

#[testing]
rec NestedPlain {
    tag: bool;
    v:   uni { a: u16; b: u32; };
}

#[testing]
uni NamedGeneric[T, E] { a: T; b: E; }

#[testing]
uni NamedPlain { a: u32; b: u32; }

#[testing]
rec NamedInGeneric[T] {
    tag: bool;
    v:   NamedGeneric[T, u32];
}

#[testing]
rec RecGeneric[T, E] { a: T; b: E; }

#[testing]
def AnonU32: AnonInGeneric[u32, u32];
#[testing]
def NamedU32: NamedGeneric[u32, u32];
#[testing]
def NamedU64: NamedGeneric[u64, u32];
#[testing]
def NestedU16: NamedInGeneric[u16];
#[testing]
def RecU32: RecGeneric[u32, u32];

#[testing]
fun delta(lo: usize, hi: usize) usize {
    if (hi >= lo) { ret hi - lo; }
    ret lo - hi;
}

test anon_in_generic__aliases {
    var g: AnonU32;
    g.v.b = 2;
    g.v.a = 1;
    if (delta((?g.v.a)::usize, (?g.v.b)::usize) != 0) { ret 1; }
    if (g.v.b != 1)                                   { ret 2; }

    var p: AnonInPlain;
    p.v.b = 2;
    p.v.a = 1;
    if (delta((?p.v.a)::usize, (?p.v.b)::usize) != 0) { ret 3; }
    if (p.v.b != 1)                                   { ret 4; }

    if ($size_of(AnonU32) != $size_of(AnonInPlain)) { ret 5; }
    ret 0;
}

test named_generic__aliases {
    var g: NamedU32;
    g.b = 2;
    g.a = 1;
    if (delta((?g.a)::usize, (?g.b)::usize) != 0) { ret 1; }
    if (g.b != 1)                                 { ret 2; }

    var p: NamedPlain;
    p.b = 2;
    p.a = 1;
    if (delta((?p.a)::usize, (?p.b)::usize) != 0) { ret 3; }
    if (p.b != 1)                                 { ret 4; }

    if ($size_of(NamedU32) != $size_of(NamedPlain)) { ret 5; }

    # a second instantiation lays out its own members
    var wide: NamedU64;
    wide.b = 2;
    wide.a = 1;
    if (delta((?wide.a)::usize, (?wide.b)::usize) != 0) { ret 6; }
    if (wide.b != 1)                                    { ret 7; }
    if ($size_of(NamedU64) != 8)                        { ret 8; }
    ret 0;
}

test named_in_generic__aliases {
    var g: NestedU16;
    g.v.b = 2;
    g.v.a = 1;
    if (delta((?g.v.a)::usize, (?g.v.b)::usize) != 0) { ret 1; }
    if (g.v.b != 1)                                   { ret 2; }
    if ($size_of(NestedU16) != $size_of(NestedPlain)) { ret 3; }
    ret 0;
}

test generic_record__does_not_alias {
    var r: RecU32;
    r.b = 2;
    r.a = 1;
    if (delta((?r.a)::usize, (?r.b)::usize) == 0) { ret 1; }
    if (r.b != 2)                                 { ret 2; }
    if (r.a != 1)                                 { ret 3; }
    ret 0;
}
