# a shader declaration's decorators as the attributes of the target family that reads them
#
# a stage, its entry name and its workgroup size attach to the function, and an interface
# variable's storage class, descriptor set and binding, location, built-in and memory
# qualifiers to the global, each the number spir-v gives it, read from masc's grammar by
# its spir-v name. only a target whose family's schema is spir-v's takes them, so a machine
# target compiles a staged function as any other

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use mach.lang.fe.ast;
use ast_decl: mach.lang.fe.ast.decl;
use ast_id:   mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use comptime_deep: mach.lang.fe.comptime.deep;
use mach.lang.fe.decorator;
use mach.lang.fe.resolve;
use fe_sema: mach.lang.fe.sema;
use mach.lang.intern;
use mach.lang.me.lower.builder;
use lower_context: mach.lang.me.lower.context;
use mach.lang.me.lower.value;
use lang_source:       mach.lang.source;
use target_definition: mach.lang.target.definition;

use mo: masc.core.operand;
use masc.isa.spirv.gen_operand;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.id;
use mirl_module: mirl.ir.module;
use mirl.ir.type.Type;
use mirl.target.capability.Attributes;
use mirl.target.capability.Schema;
use spirv_schema: mirl.target.spirv.schema;

# the schema the target's family reads shader attributes by, none for a target that takes
# none of them
fun schema_of(lc: *lower_context.LowerContext) opt[*Schema] {
    val at: Attributes = lc.builder.target.caps.attributes;
    if (sel at.schema) {
        if (str_equals(at.schema.family, spirv_schema.FAMILY)) { ret opt[*Schema].some{at.schema}; }
    }
    ret opt[*Schema].none{};
}

# whether the target reads shader attributes
pub fun attaching(lc: *lower_context.LowerContext) bool {
    val schema: opt[*Schema] = schema_of(lc);
    ret sel schema.some;
}

# the value of the member of a spir-v enumeration spelled `name`, none for a spelling the
# grammar has no member of
fun member(members: *mo.Enumerant, count: usize, name: str) opt[u64] {
    var i: usize = 0;
    for (i < count) {
        if (str_equals(members[i].name, name)) { ret opt[u64].some{members[i].value::u64}; }
        i = i + 1;
    }
    ret opt[u64].none{};
}

fun storage_class(name: str) opt[u64] {
    ret member(?gen_operand.STORAGECLASS_MEMBERS[0], $length_of(gen_operand.STORAGECLASS_MEMBERS), name);
}

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun attach(lc: *lower_context.LowerContext, s: id.Symbol, family: str, name: str, datum: Datum) err[fail.Fail] {
    val made: err[mirl_module.Error] = mirl_module.attach(lc.m, s, Attribute{family: view_of(family), name: view_of(name), datum: datum});
    if (sel made.err) { ret err[fail.Fail].err{fail.message("lower: mirl refused a shader attribute")}; }
    ret err[fail.Fail].ok{};
}

fun attach_integer(lc: *lower_context.LowerContext, s: id.Symbol, family: str, name: str, n: u64) err[fail.Fail] {
    ret attach(lc, s, family, name, Datum.integer{n});
}

# a refusal of the source where `span` is written in the module being lowered
fun refused(lc: *lower_context.LowerContext, span: lang_source.Span, k: diagnostic_kind.Kind, message: str) err[fail.Fail] {
    fail.reject(?lc.status);
    val loc: lang_source.Location = lang_source.location(lc.scope.a.file_id, span);
    ret err[fail.Fail].err{diagnostic.reject(lc.diags, k, loc, message)};
}

# argument `ord` of a decorator, nil past its arguments
fun argument(lc: *lower_context.LowerContext, dec: *ast_decl.Decorator, ord: u32) ast_id.ExprId {
    if (ord >= dec.args_len) { ret ast_id.EXPR_NIL; }
    ret lc.scope.a.expr_ids.data[dec.args_start + ord];
}

# the integer a decorator argument folds to, which sema admitted as one
fun integer_of(lc: *lower_context.LowerContext, eid: ast_id.ExprId) res[u64, fail.Fail] {
    val folded: res[comptime.CTValue, comptime.EvalFail] = comptime.evaluate_at_float_width[lower_context.LowerContext](lc.scope.ctx, lc, lc.caps, lc.scope.a,
        lower_context.module_source(lc), eid, ?lc.s.interner, lower_context.expr_float_width(lc, eid));
    if (!sel folded.ok) { ret res[u64, fail.Fail].err{fail.message("lower: a shader decorator argument sema admitted did not fold")}; }
    val n: opt[u64] = comptime.ct_int_u64(folded.ok);
    if (sel n.none) { ret res[u64, fail.Fail].err{fail.message("lower: a shader decorator argument sema admitted as an integer is not one")}; }
    ret res[u64, fail.Fail].ok{n.some};
}

fun string_of(lc: *lower_context.LowerContext, dec: *ast_decl.Decorator, ord: u32) opt[str] {
    ret decorator.string_of(?lc.s.interner, lc.scope.ctx, lc.scope.a, dec, ord);
}

# the spir-v built-in a `#[builtin]` name stands for, and whether a stage writes it
rec Builtin {
    name:   str;
    spirv:  str;
    output: bool;
}

val BUILTIN_COUNT: usize                  = 14;
val BUILTINS:      [BUILTIN_COUNT]Builtin = [BUILTIN_COUNT]Builtin{
    Builtin{name: "position", spirv: "Position", output: true},
    Builtin{name: "vertex_index", spirv: "VertexIndex", output: false},
    Builtin{name: "instance_index", spirv: "InstanceIndex", output: false},
    Builtin{name: "frag_coord", spirv: "FragCoord", output: false},
    Builtin{name: "point_size", spirv: "PointSize", output: true},
    Builtin{name: "global_invocation", spirv: "GlobalInvocationId", output: false},
    Builtin{name: "local_invocation", spirv: "LocalInvocationId", output: false},
    Builtin{name: "workgroup_id", spirv: "WorkgroupId", output: false},
    Builtin{name: "num_workgroups", spirv: "NumWorkgroups", output: false},
    Builtin{name: "local_invocation_index", spirv: "LocalInvocationIndex", output: false},
    Builtin{name: "subgroup_size", spirv: "SubgroupSize", output: false},
    Builtin{name: "subgroup_invocation", spirv: "SubgroupLocalInvocationId", output: false},
    Builtin{name: "subgroup_id", spirv: "SubgroupId", output: false},
    Builtin{name: "num_subgroups", spirv: "NumSubgroups", output: false},
};

fun builtin_of(name: str) opt[*Builtin] {
    var i: usize = 0;
    for (i < BUILTIN_COUNT) {
        if (str_equals(BUILTINS[i].name, name)) { ret opt[*Builtin].some{?BUILTINS[i]}; }
        i = i + 1;
    }
    ret opt[*Builtin].none{};
}

# the spir-v storage class a decorated global lives in, none for one with no shader role
fun class_name(lc: *lower_context.LowerContext, d: *ast_decl.Decl) opt[str] {
    val a: *ast.Ast = lc.scope.a;
    if (decorator.has(a, d, decorator.INPUT))   { ret opt[str].some{"Input"}; }
    if (decorator.has(a, d, decorator.OUTPUT))  { ret opt[str].some{"Output"}; }
    if (decorator.has(a, d, decorator.UNIFORM)) { ret opt[str].some{"Uniform"}; }
    if (decorator.has(a, d, decorator.STORAGE)) { ret opt[str].some{"StorageBuffer"}; }
    if (decorator.has(a, d, decorator.SAMPLER)) { ret opt[str].some{"UniformConstant"}; }
    if (decorator.has(a, d, decorator.PUSH))    { ret opt[str].some{"PushConstant"}; }
    if (decorator.has(a, d, decorator.SHARED))  { ret opt[str].some{"Workgroup"}; }
    val b: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.BUILTIN);
    if (sel b.some) {
        val named: opt[str] = string_of(lc, b.some, 0);
        if (sel named.some) {
            val row: opt[*Builtin] = builtin_of(named.some);
            if (sel row.some) {
                if (row.some.output) { ret opt[str].some{"Output"}; }
                ret opt[str].some{"Input"};
            }
        }
    }
    ret opt[str].none{};
}

# whether a global of the declaration `d` holds the initial value it is written with: the
# host, the pipeline or the previous stage supplies an interface variable's
pub fun initialized(lc: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    if (!attaching(lc)) { ret true; }
    val class: opt[str] = class_name(lc, d);
    if (sel class.none) { ret true; }
    ret str_equals(class.some, "Output") || str_equals(class.some, "Workgroup");
}

# whether the declaration `d` is a `#[spec]` var on a target that states specialization
# constants, which defines no global there: each read of it is the constant
pub fun specialized(lc: *lower_context.LowerContext, d: *ast_decl.Decl) bool {
    ret attaching(lc) && decorator.has(lc.scope.a, d, decorator.SPEC);
}

# a `#[spec]` var as its specialization constant: the id the host sets it by and the
# default its initializer gives
pub rec SpecVar {
    id:      u32;
    default: comptime.CTValue;
}

# the `#[spec]` var `sym` names on a target that states specialization constants, read in
# the scope it is written in, none for any other binding or target
pub fun spec_var(lc: *lower_context.LowerContext, sym: *resolve.Symbol) res[opt[SpecVar], fail.Fail] {
    val module_var: bool = sym.kind == resolve.SYM_VAR && (sym.flags & resolve.SYM_FLAG_MODULE) != 0;
    val imported:   bool = sym.kind == resolve.SYM_IMPORTED && sym.definition_kind == resolve.SYM_VAR;
    if (!attaching(lc) || !(module_var || imported)) { ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].none{}}; }
    val found: res[lower_context.Declared, fail.Fail] = lower_context.declared(lc, sym);
    if (sel found.err)                   { ret res[opt[SpecVar], fail.Fail].err{found.err}; }
    if (!lower_context.foreign(lc, sym)) { ret spec_of_declared(lc, found.ok); }
    val acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, resolve.origin_of(lc.s, sym));
    if (sel acquired.err) { ret res[opt[SpecVar], fail.Fail].err{acquired.err}; }
    val mark: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, acquired.ok);
    if (sel mark.err) { ret res[opt[SpecVar], fail.Fail].err{mark.err}; }
    val made: res[opt[SpecVar], fail.Fail] = spec_of_declared(lc, found.ok);
    val left: err[fail.Fail]               = lower_context.scope_leave(lc, mark.ok);
    if (sel made.err) { ret made; }
    if (sel left.err) { ret res[opt[SpecVar], fail.Fail].err{left.err}; }
    ret made;
}

# the specialization constant of the declaration `found`, read in the scope in effect, which
# is the one it is written in
fun spec_of_declared(lc: *lower_context.LowerContext, found: lower_context.Declared) res[opt[SpecVar], fail.Fail] {
    val d: opt[*ast_decl.Decl] = ast.get_decl(lc.scope.a, found.declaration.decl);
    if (sel d.none) { ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].none{}}; }
    val dec: opt[*ast_decl.Decorator] = decorator.get(lc.scope.a, d.some, decorator.SPEC);
    if (sel dec.none) { ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].none{}}; }
    val n: res[u64, fail.Fail] = integer_of(lc, argument(lc, dec.some, 0));
    if (sel n.err)                                         { ret res[opt[SpecVar], fail.Fail].err{n.err}; }
    if (n.ok > 0xFFFF_FFFF)                                { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[spec]` id sema admitted is wider than 32 bits")}; }
    if (found.declaration.value == fe_sema.interface.NONE) { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[spec]` var declares no default")}; }
    val v: res[comptime.CTValue, comptime.EvalFail] = comptime_deep.value(?found.iface.values, ?lc.s.interner, found.declaration.value);
    if (!sel v.ok)                                                                { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[spec]` var's default does not read back")}; }
    if (v.ok.kind != comptime.CT_KIND_INT && v.ok.kind != comptime.CT_KIND_FLOAT) { ret res[opt[SpecVar], fail.Fail].err{fail.message("lower: a `#[spec]` var's default is neither an integer nor a float")}; }
    ret res[opt[SpecVar], fail.Fail].ok{opt[SpecVar].some{SpecVar{id: n.ok::u32, default: v.ok}}};
}

# an `#[op]` function of spir-v's core set is refused where its decorator is written, since
# mirl's catalog holds no core op yet
pub fun refuse_core_op(lc: *lower_context.LowerContext, d: *ast_decl.Decl, op: *target_definition.Op) err[fail.Fail] {
    if (!core_op(op)) { ret err[fail.Fail].ok{}; }
    val dec: opt[*ast_decl.Decorator] = decorator.get(lc.scope.a, d, decorator.OP);
    if (sel dec.none) { ret err[fail.Fail].ok{}; }
    ret refused(lc, dec.some.name, diagnostic_kind.DECORATOR_ARGUMENT, CORE_OP_REFUSED);
}

# whether an operation is of spir-v's core set, which mirl's catalog holds no op of yet
pub fun core_op(op: *target_definition.Op) bool {
    ret str_equals(op.set, "core");
}

pub val CORE_OP_REFUSED: str = "an `#[op]` of spir-v's core set waits for mirl's catalog to hold the core ops (mirl#436)";

# the attributes of global `gix` its declaration `d` states, read in the scope `d` is
# written in. a global that already carries attributes keeps them
pub fun global_attributes(lc: *lower_context.LowerContext, d: *ast_decl.Decl, gix: u32) err[fail.Fail] {
    val schema: opt[*Schema] = schema_of(lc);
    if (sel schema.none) { ret err[fail.Fail].ok{}; }
    val family: str = schema.some.family;
    if (lc.m.globals.data[gix::usize].attributes.len != 0) { ret err[fail.Fail].ok{}; }
    val class_n: opt[str] = class_name(lc, d);
    if (sel class_n.none) { ret err[fail.Fail].ok{}; }
    val class: opt[u64] = storage_class(class_n.some);
    if (sel class.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no storage class a shader role names")}; }
    val s:      id.Symbol      = id.Symbol.global{id.Global{index: gix}};
    val stored: err[fail.Fail] = attach_integer(lc, s, family, "storage", class.some);
    if (sel stored.err) { ret stored; }

    val a:        *ast.Ast                 = lc.scope.a;
    var resource: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.UNIFORM);
    if (!decorator.has(a, d, decorator.UNIFORM))                                            { resource = decorator.get(a, d, decorator.STORAGE); }
    if (!decorator.has(a, d, decorator.UNIFORM) && !decorator.has(a, d, decorator.STORAGE)) { resource = decorator.get(a, d, decorator.SAMPLER); }
    if (sel resource.some) {
        val set: res[u64, fail.Fail] = integer_of(lc, argument(lc, resource.some, 0));
        if (sel set.err) { ret err[fail.Fail].err{set.err}; }
        val binding: res[u64, fail.Fail] = integer_of(lc, argument(lc, resource.some, 1));
        if (sel binding.err) { ret err[fail.Fail].err{binding.err}; }
        val put_set: err[fail.Fail] = attach_integer(lc, s, family, "set", set.ok);
        if (sel put_set.err) { ret put_set; }
        val put_binding: err[fail.Fail] = attach_integer(lc, s, family, "binding", binding.ok);
        if (sel put_binding.err) { ret put_binding; }
    }
    var located: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.INPUT);
    if (!decorator.has(a, d, decorator.INPUT)) { located = decorator.get(a, d, decorator.OUTPUT); }
    if (sel located.some) {
        val at: res[u64, fail.Fail] = integer_of(lc, argument(lc, located.some, 0));
        if (sel at.err) { ret err[fail.Fail].err{at.err}; }
        val put: err[fail.Fail] = attach_integer(lc, s, family, "location", at.ok);
        if (sel put.err) { ret put; }
    }
    val b: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.BUILTIN);
    if (sel b.some) {
        val named: opt[str] = string_of(lc, b.some, 0);
        if (sel named.none) { ret err[fail.Fail].err{fail.message("lower: a `#[builtin]` sema admitted names no built-in")}; }
        val row: opt[*Builtin] = builtin_of(named.some);
        if (sel row.none) { ret err[fail.Fail].err{fail.message("lower: a `#[builtin]` sema admitted names no built-in")}; }
        val n: opt[u64] = member(?gen_operand.BUILTIN_MEMBERS[0], $length_of(gen_operand.BUILTIN_MEMBERS), row.some.spirv);
        if (sel n.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no built-in a `#[builtin]` names")}; }
        val put: err[fail.Fail] = attach_integer(lc, s, family, "builtin", n.some);
        if (sel put.err) { ret put; }
    }
    val st: opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.STORAGE);
    if (sel st.some) { ret qualifiers(lc, s, family, st.some); }
    ret err[fail.Fail].ok{};
}

# a `#[storage]` binding's memory qualifiers as the decorations of its variable
fun qualifiers(lc: *lower_context.LowerContext, s: id.Symbol, family: str, dec: *ast_decl.Decorator) err[fail.Fail] {
    var held: [3]u64;
    var n:    usize = 0;
    var ord:  u32   = 2;
    for (ord < dec.args_len && n < 3) {
        val q: opt[str] = string_of(lc, dec, ord);
        ord = ord + 1;
        if (sel q.none) { cnt; }
        var spelled: str = nil;
        if (str_equals(q.some, "readonly"))  { spelled = "NonWritable"; }
        or (str_equals(q.some, "writeonly")) { spelled = "NonReadable"; }
        or (str_equals(q.some, "coherent"))  { spelled = "Coherent"; }
        if (spelled == nil)                  { cnt; }
        val v: opt[u64] = member(?gen_operand.DECORATION_MEMBERS[0], $length_of(gen_operand.DECORATION_MEMBERS), spelled);
        if (sel v.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no decoration a `#[storage]` qualifier names")}; }
        held[n] = v.some;
        n       = n + 1;
    }
    if (n == 0) { ret err[fail.Fail].ok{}; }
    ret attach(lc, s, family, "decorate", Datum.integers{Slice[u64]{data: ?held[0], size: n}});
}

# the attributes of the global `gix` declared here for another module's declaration of
# `sym`, read in the scope it is written in
pub fun extern_global_attributes(lc: *lower_context.LowerContext, sym: *resolve.Symbol, gix: u32) err[fail.Fail] {
    if (!attaching(lc))                                    { ret err[fail.Fail].ok{}; }
    if (lc.m.globals.data[gix::usize].attributes.len != 0) { ret err[fail.Fail].ok{}; }
    val found: res[lower_context.Declared, fail.Fail] = lower_context.declared(lc, sym);
    if (sel found.err) { ret err[fail.Fail].err{found.err}; }
    val acquired: res[lower_context.ModuleScope, fail.Fail] = lower_context.origin_scope(lc, resolve.origin_of(lc.s, sym));
    if (sel acquired.err) { ret err[fail.Fail].err{acquired.err}; }
    val mark: res[lower_context.ScopeMark, fail.Fail] = lower_context.scope_enter(lc, acquired.ok);
    if (sel mark.err) { ret err[fail.Fail].err{mark.err}; }
    var made: err[fail.Fail]      = err[fail.Fail].ok{};
    val d:    opt[*ast_decl.Decl] = ast.get_decl(lc.scope.a, found.ok.declaration.decl);
    if (sel d.some) { made = global_attributes(lc, d.some, gix); }
    val left: err[fail.Fail] = lower_context.scope_leave(lc, mark.ok);
    if (sel made.err) { ret made; }
    ret left;
}

# the spir-v execution model a `#[stage]` names
fun stage_name(name: str) opt[str] {
    if (str_equals(name, "vertex"))   { ret opt[str].some{"Vertex"}; }
    if (str_equals(name, "fragment")) { ret opt[str].some{"Fragment"}; }
    if (str_equals(name, "compute"))  { ret opt[str].some{"GLCompute"}; }
    ret opt[str].none{};
}

# the entry point function `fix` is: its stage, the bare source name a pipeline finds it
# by, and a compute stage's workgroup size, one in each dimension it does not state
pub fun function_attributes(lc: *lower_context.LowerContext, d: *ast_decl.Decl, fix: u32, bare: intern.StrId) err[fail.Fail] {
    val schema: opt[*Schema] = schema_of(lc);
    if (sel schema.none) { ret err[fail.Fail].ok{}; }
    val family: str                      = schema.some.family;
    val a:      *ast.Ast                 = lc.scope.a;
    val dec:    opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.STAGE);
    if (sel dec.none) { ret err[fail.Fail].ok{}; }
    val named: opt[str] = string_of(lc, dec.some, 0);
    if (sel named.none) { ret err[fail.Fail].err{fail.message("lower: a `#[stage]` sema admitted names no stage")}; }
    val model: opt[str] = stage_name(named.some);
    if (sel model.none) { ret err[fail.Fail].err{fail.message("lower: a `#[stage]` sema admitted names no stage")}; }
    val n: opt[u64] = member(?gen_operand.EXECUTIONMODEL_MEMBERS[0], $length_of(gen_operand.EXECUTIONMODEL_MEMBERS), model.some);
    if (sel n.none) { ret err[fail.Fail].err{fail.message("lower: masc's grammar has no execution model a `#[stage]` names")}; }
    val s:      id.Symbol      = id.Symbol.function{id.Function{index: fix}};
    val staged: err[fail.Fail] = attach_integer(lc, s, family, "stage", n.some);
    if (sel staged.err) { ret staged; }
    val entry: err[fail.Fail] = attach(lc, s, family, "entry", Datum.text{view_of(intern.text(?lc.s.interner, bare))});
    if (sel entry.err)                        { ret entry; }
    if (!str_equals(model.some, "GLCompute")) { ret err[fail.Fail].ok{}; }

    var size:      [3]u64                   = [3]u64{1, 1, 1};
    var specs:     [6]u64;
    var spec_size: usize                    = 0;
    val wg:        opt[*ast_decl.Decorator] = decorator.get(a, d, decorator.WORKGROUP);
    if (sel wg.some) {
        var k: u32 = 0;
        for (k < 3 && k < wg.some.args_len) {
            val arg: ast_id.ExprId = argument(lc, wg.some, k);
            k = k + 1;
            val sym: opt[*resolve.Symbol] = lower_context.symbol_of(lc, lower_context.expr_symbol_of(lc, arg));
            if (sel sym.some) {
                val spec: res[opt[SpecVar], fail.Fail] = spec_var(lc, sym.some);
                if (sel spec.err) { ret err[fail.Fail].err{spec.err}; }
                if (sel spec.ok.some) {
                    val sized: res[u64, fail.Fail] = workgroup_spec(lc, arg, spec.ok.some);
                    if (sel sized.err) { ret err[fail.Fail].err{sized.err}; }
                    size[k - 1]          = sized.ok;
                    specs[spec_size]     = (k - 1)::u64;
                    specs[spec_size + 1] = spec.ok.some.id::u64;
                    spec_size            = spec_size + 2;
                    cnt;
                }
            }
            val dim: res[u64, fail.Fail] = integer_of(lc, arg);
            if (sel dim.err) { ret err[fail.Fail].err{dim.err}; }
            size[k - 1] = dim.ok;
        }
    }
    val sized: err[fail.Fail] = attach(lc, s, family, "workgroup", Datum.integers{Slice[u64]{data: ?size[0], size: 3}});
    if (sel sized.err)  { ret sized; }
    if (spec_size == 0) { ret err[fail.Fail].ok{}; }
    ret attach(lc, s, family, "workgroup_spec", Datum.integers{Slice[u64]{data: ?specs[0], size: spec_size}});
}

# the default size of a workgroup dimension the `#[spec]` var `spec` sizes, named at `arg`,
# whose constant the module states so the dimension names one of its constants
fun workgroup_spec(lc: *lower_context.LowerContext, arg: ast_id.ExprId, spec: SpecVar) res[u64, fail.Fail] {
    val n: opt[u64] = comptime.ct_int_u64(spec.default);
    if (sel n.none) { ret res[u64, fail.Fail].err{fail.message("lower: a workgroup `#[spec]` var's default is not an integer")}; }
    val ty: res[Type, fail.Fail] = lower_context.lower_type(lc, lower_context.expr_type_of(lc, arg));
    if (sel ty.err) { ret res[u64, fail.Fail].err{ty.err}; }
    val stated: value.Value    = builder.spec_constant(?lc.builder, spec.id, value.const_int(n.some, ty.ok));
    val built:  err[fail.Fail] = lower_context.builder_state(lc);
    if (sel built.err) { ret res[u64, fail.Fail].err{built.err}; }
    ret res[u64, fail.Fail].ok{n.some};
}
