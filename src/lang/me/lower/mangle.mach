use std_format: std.format;
use std.memory;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use lang_catalog: mach.lang.catalog;
use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.fail;
use comptime_value: mach.lang.fe.comptime.value;
use mach.lang.fe.sema.typename;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.linkage;
use mach.lang.module;
use mach.lang.session;
use mach.lang.stack;
use mach.lang.type;
use type_kind: mach.lang.type.kind;
use type_prim: mach.lang.type.prim;
use mach.lang.wide;

val PACK_MARK: str = "pack";

pub fun linkage_name(
    s: *session.Session,
    fqn: intern.StrId,
    bare: intern.StrId,
    export: intern.StrId) res[intern.StrId, fail.Fail] {
    if (!intern.str_is_nil(export)) {
        ret res[intern.StrId, fail.Fail].ok{export};
    }
    ret mangle(s, fqn, bare, nil, 0);
}

# the linkage name of the declaration `decl` of module `mid`, whose canonical name is `canon`,
# exported under the name `l` declares for it, made once and kept in `l`
pub fun declaration_linkage_name(l: *linkage.Linkage, s: *session.Session, mid: module.ModuleId, canon: intern.StrId, decl: u32) res[intern.StrId, fail.Fail] {
    val known: intern.StrId = linkage.name(l, mid, decl);
    if (!intern.str_is_nil(known)) { ret res[intern.StrId, fail.Fail].ok{known}; }
    val named: res[intern.StrId, fail.Fail] = linkage_name(s, module.module_fqn(?s.modules, mid), canon, linkage.export_name(l, mid, decl));
    if (sel named.err) { ret named; }
    val kept: err[fail.Fail] = linkage.register_name(l, mid, decl, named.ok);
    if (sel kept.err) { ret res[intern.StrId, fail.Fail].err{kept.err}; }
    ret named;
}

# a test's qualified name and symbol, `<module path>#<identifier>`: `#` is in no
# identifier or module path, so it names no other symbol
pub fun test_name(s: *session.Session, fqn: intern.StrId, ident: intern.StrId) res[intern.StrId, fail.Fail] {
    val path_r: res[str, fail.Fail] = module_path_of(s, fqn);
    if (sel path_r.err) { ret res[intern.StrId, fail.Fail].err{path_r.err}; }
    val path:   str                 = path_r.ok;
    val name_r: res[str, fail.Fail] = bare_name_get(s, ident);
    if (sel name_r.err) { ret res[intern.StrId, fail.Fail].err{name_r.err}; }
    val total:   usize             = base_len(path, name_r.ok);
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, total);
    if (sel res_buf.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *u8   = res_buf.ok;
    var k:   usize = write_str(buf, 0, path);
    buf[k] = '#';
    k      = write_str(buf, k + 1, name_r.ok);
    ret mangle_finish(s, buf, k, total);
}

pub fun instance_name(
    s: *session.Session,
    fqn: intern.StrId,
    bare: intern.StrId,
    args: *type_kind.TypeId,
    arg_count: u32) res[intern.StrId, fail.Fail] {
    ret mangle(s, fqn, bare, args, arg_count);
}

pub fun value_instance_name(
    s: *session.Session,
    fqn: intern.StrId,
    bare: intern.StrId,
    vals: *comptime_value.CTValue,
    val_len: u32) res[intern.StrId, fail.Fail] {
    val path_r: res[str, fail.Fail] = module_path_of(s, fqn);
    if (sel path_r.err) { ret res[intern.StrId, fail.Fail].err{path_r.err}; }
    val path: str = path_r.ok;

    val res_name: res[str, fail.Fail] = bare_name_get(s, bare);
    if (sel res_name.err) {
        ret res[intern.StrId, fail.Fail].err{res_name.err};
    }
    val name: str = res_name.ok;

    var suffix_len: usize = 0;
    var i:          u32   = 0;
    for (i < val_len) {
        val rv: res[usize, fail.Fail] = encoded_value_len(s, ?vals[i]);
        if (sel rv.err) { ret res[intern.StrId, fail.Fail].err{rv.err}; }
        suffix_len = suffix_len + 1 + rv.ok;
        i          = i + 1;
    }

    val total:   usize             = base_len(path, name) + suffix_len;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, total);
    if (sel res_buf.err) {
        ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;

    var k: usize = base_write(buf, path, name);
    i = 0;
    for (i < val_len) {
        buf[k] = '$';
        k      = k + 1;
        val wv: res[usize, fail.Fail] = write_encoded_value(s, buf, k, ?vals[i]);
        if (sel wv.err) { ret res[intern.StrId, fail.Fail].err{wv.err}; }
        k = wv.ok;
        i = i + 1;
    }

    ret mangle_finish(s, buf, k, total);
}

pub fun pack_instance_name(
    s: *session.Session,
    fqn: intern.StrId,
    bare: intern.StrId,
    args: *type_kind.TypeId,
    arg_len: u32,
    types: *type_kind.TypeId,
    type_len: u32) res[intern.StrId, fail.Fail] {
    val path_r: res[str, fail.Fail] = module_path_of(s, fqn);
    if (sel path_r.err) { ret res[intern.StrId, fail.Fail].err{path_r.err}; }
    val path: str = path_r.ok;

    val res_name: res[str, fail.Fail] = bare_name_get(s, bare);
    if (sel res_name.err) {
        ret res[intern.StrId, fail.Fail].err{res_name.err};
    }
    val name: str = res_name.ok;

    val ra: res[usize, fail.Fail] = arg_list_len(s, args, arg_len);
    if (sel ra.err) { ret res[intern.StrId, fail.Fail].err{ra.err}; }
    val rt: res[usize, fail.Fail] = arg_list_len(s, types, type_len);
    if (sel rt.err) { ret res[intern.StrId, fail.Fail].err{rt.err}; }

    val total: usize = base_len(path, name)
        + ra.ok
        + 1 + str_len(PACK_MARK)
        + rt.ok;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, total);
    if (sel res_buf.err) {
        ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;

    var k:  usize                 = base_write(buf, path, name);
    val wa: res[usize, fail.Fail] = write_arg_list(s, buf, k, args, arg_len);
    if (sel wa.err) { ret res[intern.StrId, fail.Fail].err{wa.err}; }
    k = wa.ok;

    buf[k] = '$';
    k      = k + 1;
    k      = write_str(buf, k, PACK_MARK);

    val wt: res[usize, fail.Fail] = write_arg_list(s, buf, k, types, type_len);
    if (sel wt.err) { ret res[intern.StrId, fail.Fail].err{wt.err}; }
    k = wt.ok;

    ret mangle_finish(s, buf, k, total);
}

fun mangle(
    s: *session.Session,
    fqn: intern.StrId,
    bare: intern.StrId,
    args: *type_kind.TypeId,
    arg_count: u32) res[intern.StrId, fail.Fail] {
    val path_r: res[str, fail.Fail] = module_path_of(s, fqn);
    if (sel path_r.err) { ret res[intern.StrId, fail.Fail].err{path_r.err}; }
    val path: str = path_r.ok;

    val res_name: res[str, fail.Fail] = bare_name_get(s, bare);
    if (sel res_name.err) {
        ret res[intern.StrId, fail.Fail].err{res_name.err};
    }
    val name: str = res_name.ok;

    val ra: res[usize, fail.Fail] = arg_list_len(s, args, arg_count);
    if (sel ra.err) { ret res[intern.StrId, fail.Fail].err{ra.err}; }

    val total:   usize             = base_len(path, name) + ra.ok;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, total);
    if (sel res_buf.err) {
        ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;

    var k:  usize                 = base_write(buf, path, name);
    val wa: res[usize, fail.Fail] = write_arg_list(s, buf, k, args, arg_count);
    if (sel wa.err) { ret res[intern.StrId, fail.Fail].err{wa.err}; }
    k = wa.ok;

    ret mangle_finish(s, buf, k, total);
}

fun arg_list_len(s: *session.Session, ids: *type_kind.TypeId, n: u32) res[usize, fail.Fail] {
    var total: usize = 0;
    var i:     u32   = 0;
    for (i < n) {
        val r: res[usize, fail.Fail] = encoded_type_len(s, ids[i], 1);
        if (sel r.err) { ret r; }
        total = total + 1 + r.ok;
        i     = i + 1;
    }
    ret res[usize, fail.Fail].ok{total};
}

fun write_arg_list(s: *session.Session, buf: *u8, k: usize, ids: *type_kind.TypeId, n: u32) res[usize, fail.Fail] {
    var w: usize = k;
    var i: u32   = 0;
    for (i < n) {
        buf[w] = '$';
        w      = w + 1;
        val r: res[usize, fail.Fail] = write_encoded_type(s, buf, w, ids[i], 1);
        if (sel r.err) { ret r; }
        w = r.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

# the module path a symbol is mangled under; the root module's empty path is
# spelled `main`
fun module_path_of(s: *session.Session, fqn: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(fqn)) { ret res[str, fail.Fail].err{fail.message("mangle: symbol has no module path")}; }
    val path: str = intern.text(?s.interner, fqn);
    if (str_len(path) == 0) { ret res[str, fail.Fail].ok{"main"}; }
    ret res[str, fail.Fail].ok{path};
}

fun bare_name_get(s: *session.Session, id: intern.StrId) res[str, fail.Fail] {
    val opt_name: opt[str] = intern.get(?s.interner, id);
    if (sel opt_name.none) {
        ret res[str, fail.Fail].err{fail.message("mangle: bare name not interned")};
    }
    ret res[str, fail.Fail].ok{opt_name.some};
}

fun param_at(s: *session.Session, idx: u32) type_kind.TypeId {
    val opt_: opt[type_kind.TypeId] = type.get_param(?s.types, idx);
    if (sel opt_.some) { ret opt_.some; }
    ret type_kind.TYPE_NIL;
}

fun base_len(path: str, name: str) usize {
    ret str_len(path) + 1 + str_len(name);
}

fun base_write(buf: *u8, path: str, name: str) usize {
    var k: usize = write_str(buf, 0, path);
    buf[k] = '.';
    k      = k + 1;
    ret write_str(buf, k, name);
}

fun mangle_finish(s: *session.Session, buf: *u8, k: usize, total: usize) res[intern.StrId, fail.Fail] {
    val res_id: res[intern.StrId, A.Error] = intern.bytes_add(?s.interner, buf::str, k);
    A.deallocate[u8](s.alloc, buf, total);
    if (sel res_id.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_id.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_id.ok};
}

fun encoded_value_len(s: *session.Session, v: *comptime_value.CTValue) res[usize, fail.Fail] {
    if (v.kind == comptime_value.CT_KIND_INT) {
        var digits: [wide.FORMAT_CAP]u8;
        ret res[usize, fail.Fail].ok{str_len(encoded_int(v, ?digits[0]))};
    }
    if (v.kind == comptime_value.CT_KIND_FLOAT) { ret res[usize, fail.Fail].ok{2 + 16}; }
    if (v.kind == comptime_value.CT_KIND_STR) {
        ret res[usize, fail.Fail].ok{2 + escaped_len(intern.text(?s.interner, v.data.s))};
    }
    ret res[usize, fail.Fail].err{unencodable_value(s, v.kind)};
}

fun write_encoded_value(s: *session.Session, buf: *u8, k: usize, v: *comptime_value.CTValue) res[usize, fail.Fail] {
    if (v.kind == comptime_value.CT_KIND_INT) {
        var digits: [wide.FORMAT_CAP]u8;
        ret res[usize, fail.Fail].ok{write_str(buf, k, encoded_int(v, ?digits[0]))};
    }
    if (v.kind == comptime_value.CT_KIND_FLOAT) {
        buf[k]     = 'f';
        buf[k + 1] = 'x';
        ret res[usize, fail.Fail].ok{write_hex_u64(buf, k + 2, float.f64_bits(v.data.f))};
    }
    if (v.kind == comptime_value.CT_KIND_STR) {
        ret res[usize, fail.Fail].ok{write_escaped(buf, k, intern.text(?s.interner, v.data.s))};
    }
    ret res[usize, fail.Fail].err{unencodable_value(s, v.kind)};
}

# a comptime integer in a symbol: its decimal magnitude, `n` marking a negative
fun encoded_int(v: *comptime_value.CTValue, digits: *u8) str {
    if (!comptime_value.ct_is_negative(@v)) { ret wide.text_u(v.data.w, digits); }
    digits[0] = 'n';
    wide.text_u(wide.neg(v.data.w), ?digits[1]);
    ret digits::str;
}

fun escaped_len(text: str) usize {
    val n:     usize = str_len(text);
    var total: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (text[i] == '\\' || text[i] == '"') { total = total + 1; }
        total = total + 1;
        i     = i + 1;
    }
    ret total;
}

fun write_escaped(buf: *u8, k: usize, text: str) usize {
    val n: usize = str_len(text);
    var w: usize = k;
    buf[w] = '"';
    w      = w + 1;
    var i: usize = 0;
    for (i < n) {
        if (text[i] == '\\' || text[i] == '"') {
            buf[w] = '\\';
            w      = w + 1;
        }
        buf[w] = text[i];
        w      = w + 1;
        i      = i + 1;
    }
    buf[w] = '"';
    w      = w + 1;
    ret w;
}

# why a declared comptime value kind cannot key a value instance, absent for a
# kind outside the catalog
fun unencodable_value_msg(kind: comptime_value.CTKind) opt[str] {
    if (kind == comptime_value.CT_KIND_TYPE)       { ret opt[str].some{"mangle: a comptime TYPE value cannot key a value instance"}; }
    if (kind == comptime_value.CT_KIND_FIELD)      { ret opt[str].some{"mangle: a comptime FIELD value cannot key a value instance"}; }
    if (kind == comptime_value.CT_KIND_CASE)       { ret opt[str].some{"mangle: a comptime CASE value cannot key a value instance"}; }
    if (kind == comptime_value.CT_KIND_PACK_ELEM)  { ret opt[str].some{"mangle: a comptime PACK_ELEM value cannot key a value instance"}; }
    if (kind == comptime_value.CT_KIND_CONST_ELEM) { ret opt[str].some{"mangle: a comptime CONST_ELEM value cannot key a value instance"}; }
    if (kind == comptime_value.CT_KIND_INT || kind == comptime_value.CT_KIND_FLOAT || kind == comptime_value.CT_KIND_STR) {
        ret opt[str].some{"mangle: unfolded comptime value cannot key a value instance"};
    }
    ret opt[str].none{};
}

fun unencodable_value(s: *session.Session, kind: comptime_value.CTKind) fail.Fail {
    val why: opt[str] = unencodable_value_msg(kind);
    if (sel why.none) {
        ret fail.message_of(lang_catalog.catalog_interned(?s.interner, s.alloc, lang_catalog.unknown_member("CTKind", kind::u32)));
    }
    ret fail.message(why.some);
}

fun write_hex_u64(buf: *u8, k: usize, n: u64) usize {
    var w:     usize = k;
    var shift: i32   = 60;
    for (shift >= 0) {
        val nib: u64 = (n >> shift::u64) & 0xF;
        if (nib < 10) { buf[w] = nib::u8 + '0'; }
        or            { buf[w] = (nib - 10)::u8 + 'a'; }
        w     = w + 1;
        shift = shift - 4;
    }
    ret w;
}

fun encoded_type_len(s: *session.Session, tid: type_kind.TypeId, depth: usize) res[usize, fail.Fail] {
    if (type_kind.is_nil(tid) || type_kind.is_error(tid)) { ret res[usize, fail.Fail].err{unencodable_type(s, tid)}; }
    if (stack.exhausted())                                { ret res[usize, fail.Fail].err{nesting()}; }
    val opt_t: opt[*type.Type] = type.get(?s.types, tid);
    if (sel opt_t.none) { ret res[usize, fail.Fail].err{unencodable_type(s, tid)}; }
    val t:    *type.Type         = opt_t.some;
    val kind: type_kind.TypeKind = t.kind;

    if (type_prim.is_prim(kind)) { ret res[usize, fail.Fail].ok{type_prim.prim_spelling_len(kind)}; }

    if (kind == type_kind.TYPE_POINTER) { ret modifier_len(s, 1, t.data.pointer.base, depth); }
    if (kind == type_kind.TYPE_SECRET)  { ret modifier_len(s, 3, t.data.secret.base, depth); }
    if (kind == type_kind.TYPE_ARRAY) {
        ret modifier_len(s, 3 + decimal_len(t.data.array.count::u64), t.data.array.base, depth);
    }
    if (kind == type_kind.TYPE_REC || kind == type_kind.TYPE_UNI || kind == type_kind.TYPE_TAG) {
        ret nominal_len(s, ?t.data.nominal);
    }
    if (kind == type_kind.TYPE_INSTANCE) { ret instance_enc_len(s, t, depth); }
    if (kind == type_kind.TYPE_FUN)      { ret fun_enc_len(s, t, depth); }
    if (kind == type_kind.TYPE_HANDLE)   { ret handle_enc_len(s, t, depth); }
    if (kind == type_kind.TYPE_VECTOR)   { ret vector_enc_len(t); }
    if (kind == type_kind.TYPE_ABI)      { ret abi_enc_len(t); }
    val never: opt[str] = never_an_argument_msg(kind);
    if (sel never.some) { ret res[usize, fail.Fail].err{fail.message(never.some)}; }
    ret res[usize, fail.Fail].err{unencodable_type(s, tid)};
}

fun modifier_len(s: *session.Session, head: usize, base: type_kind.TypeId, depth: usize) res[usize, fail.Fail] {
    val r: res[usize, fail.Fail] = encoded_type_len(s, base, depth);
    if (sel r.err) { ret r; }
    ret res[usize, fail.Fail].ok{head + depth + r.ok};
}

# the encodings recurse as deep as a type nests, so each asks for stack before it descends;
# a type has no place of its own, so the lowering asking reports this where it stands
fun nesting() fail.Fail {
    ret fail.user(diagnostic_kind.SYNTAX_NESTING_DEPTH, "a type nests deeper than name mangling descends; the stack has no room left to go deeper");
}

# the failure naming a type that has no mangling encoding, or the failure that
# stopped its text being made
fun unencodable_type(s: *session.Session, tid: type_kind.TypeId) fail.Fail {
    if (type_kind.is_nil(tid))   { ret fail.message("mangle: nil type has no mangling encoding"); }
    if (type_kind.is_error(tid)) { ret fail.message("mangle: error type has no mangling encoding"); }
    val rs: res[str, fail.Fail] = typename.type_to_str(s, tid);
    if (sel rs.err) { ret rs.err; }
    val spelling: str                 = rs.ok;
    val made:     res[str, fail.Fail] = diagnostic.format_intern(?s.interner, s.alloc, "mangle: type `{}` has no mangling encoding", spelling);
    typename.type_str_free(s, spelling);
    ret fail.message_of(made);
}

fun write_encoded_type(s: *session.Session, buf: *u8, k: usize, tid: type_kind.TypeId, depth: usize) res[usize, fail.Fail] {
    if (type_kind.is_nil(tid) || type_kind.is_error(tid)) { ret res[usize, fail.Fail].err{unencodable_type(s, tid)}; }
    if (stack.exhausted())                                { ret res[usize, fail.Fail].err{nesting()}; }
    val opt_t: opt[*type.Type] = type.get(?s.types, tid);
    if (sel opt_t.none) { ret res[usize, fail.Fail].err{unencodable_type(s, tid)}; }
    val t:    *type.Type         = opt_t.some;
    val kind: type_kind.TypeKind = t.kind;

    if (type_prim.is_prim(kind)) { ret res[usize, fail.Fail].ok{write_str(buf, k, type_prim.prim_name(kind))}; }

    if (kind == type_kind.TYPE_POINTER) {
        ret write_modifier(s, buf, k, "p", t.data.pointer.base, depth);
    }
    if (kind == type_kind.TYPE_SECRET) {
        ret write_modifier(s, buf, k, "sec", t.data.secret.base, depth);
    }
    if (kind == type_kind.TYPE_ARRAY) {
        var w: usize = write_str(buf, k, "arr");
        w = write_decimal(buf, w, t.data.array.count::u64);
        w = write_dollars(buf, w, depth);
        ret write_encoded_type(s, buf, w, t.data.array.base, depth);
    }
    if (kind == type_kind.TYPE_REC || kind == type_kind.TYPE_UNI || kind == type_kind.TYPE_TAG) {
        ret write_nominal(s, buf, k, ?t.data.nominal);
    }
    if (kind == type_kind.TYPE_INSTANCE) { ret write_instance_enc(s, buf, k, t, depth); }
    if (kind == type_kind.TYPE_FUN)      { ret write_fun_enc(s, buf, k, t, depth); }
    if (kind == type_kind.TYPE_HANDLE)   { ret write_handle_enc(s, buf, k, t, depth); }
    if (kind == type_kind.TYPE_VECTOR)   { ret write_vector_enc(buf, k, t); }
    if (kind == type_kind.TYPE_ABI)      { ret write_abi_enc(buf, k, t); }
    val never: opt[str] = never_an_argument_msg(kind);
    if (sel never.some) { ret res[usize, fail.Fail].err{fail.message(never.some)}; }
    ret res[usize, fail.Fail].err{unencodable_type(s, tid)};
}

fun write_modifier(s: *session.Session, buf: *u8, k: usize, head: str, base: type_kind.TypeId, depth: usize) res[usize, fail.Fail] {
    var w: usize = write_str(buf, k, head);
    w = write_dollars(buf, w, depth);
    ret write_encoded_type(s, buf, w, base, depth);
}

fun write_dollars(buf: *u8, k: usize, n: usize) usize {
    var w: usize = k;
    var i: usize = 0;
    for (i < n) {
        buf[w] = '$';
        w      = w + 1;
        i      = i + 1;
    }
    ret w;
}

fun nominal_path(s: *session.Session, nominal: *type.TypeNominal) res[str, fail.Fail] {
    val mid: module.ModuleId = module.module_id_for_stable(?s.modules, nominal.owner.module);
    if (module.is_nil(mid)) { ret res[str, fail.Fail].err{fail.message("mangle: nominal module is not acquired in the current operation")}; }
    val fqn:  intern.StrId = module.module_fqn(?s.modules, mid);
    val path: opt[str]     = intern.get(?s.interner, fqn);
    if (sel path.none) { ret res[str, fail.Fail].err{fail.message("mangle: nominal module has no canonical name")}; }
    ret res[str, fail.Fail].ok{path.some};
}

fun nominal_len(s: *session.Session, nominal: *type.TypeNominal) res[usize, fail.Fail] {
    val path: res[str, fail.Fail] = nominal_path(s, nominal);
    if (sel path.err) { ret res[usize, fail.Fail].err{path.err}; }
    var size: usize = str_len(path.ok) + 1 + str_len(intern.text(?s.interner, nominal.name));
    if (nominal.incarnation != 0) {
        val recipe: opt[str] = intern.get(?s.interner, nominal.syntax);
        if (sel recipe.none) { ret res[usize, fail.Fail].err{fail.message("mangle: anonymous type has no canonical recipe")}; }
        size = size + 1 + str_len(recipe.some);
    }
    ret res[usize, fail.Fail].ok{size};
}

fun write_nominal(s: *session.Session, buf: *u8, k: usize, nominal: *type.TypeNominal) res[usize, fail.Fail] {
    val path: res[str, fail.Fail] = nominal_path(s, nominal);
    if (sel path.err) { ret res[usize, fail.Fail].err{path.err}; }
    var w: usize = write_str(buf, k, path.ok);
    buf[w] = '.';
    w      = w + 1;
    w      = write_str(buf, w, intern.text(?s.interner, nominal.name));
    if (nominal.incarnation != 0) {
        val recipe: opt[str] = intern.get(?s.interner, nominal.syntax);
        if (sel recipe.none) { ret res[usize, fail.Fail].err{fail.message("mangle: anonymous type has no canonical recipe")}; }
        buf[w] = '$';
        w      = w + 1;
        w      = write_str(buf, w, recipe.some);
    }
    ret res[usize, fail.Fail].ok{w};
}

fun instance_nominal(s: *session.Session, t: *type.Type) res[*type.TypeNominal, fail.Fail] {
    val found: opt[*type.Type] = type.get(?s.types, t.data.instance.nominal);
    if (sel found.none) { ret res[*type.TypeNominal, fail.Fail].err{fail.message("mangle: generic instance has no nominal type")}; }
    val nominal: *type.Type = found.some;
    if (nominal.kind != type_kind.TYPE_REC && nominal.kind != type_kind.TYPE_UNI && nominal.kind != type_kind.TYPE_TAG) {
        ret res[*type.TypeNominal, fail.Fail].err{fail.message("mangle: generic instance nominal has the wrong kind")};
    }
    ret res[*type.TypeNominal, fail.Fail].ok{?nominal.data.nominal};
}

fun instance_enc_len(s: *session.Session, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val nominal: res[*type.TypeNominal, fail.Fail] = instance_nominal(s, t);
    if (sel nominal.err) { ret res[usize, fail.Fail].err{nominal.err}; }
    val size: res[usize, fail.Fail] = nominal_len(s, nominal.ok);
    if (sel size.err) { ret size; }
    var total:  usize = size.ok;
    val astart: u32   = t.data.instance.args_start;
    val alen:   u32   = t.data.instance.args_len;
    var i:      u32   = 0;
    for (i < alen) {
        val ra: res[usize, fail.Fail] = encoded_type_len(s, param_at(s, astart + i), depth + 1);
        if (sel ra.err) { ret ra; }
        total = total + depth + 1 + ra.ok;
        i     = i + 1;
    }
    ret res[usize, fail.Fail].ok{total};
}

fun write_instance_enc(s: *session.Session, buf: *u8, k: usize, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val nominal: res[*type.TypeNominal, fail.Fail] = instance_nominal(s, t);
    if (sel nominal.err) { ret res[usize, fail.Fail].err{nominal.err}; }
    val written: res[usize, fail.Fail] = write_nominal(s, buf, k, nominal.ok);
    if (sel written.err) { ret written; }
    var w:      usize = written.ok;
    val astart: u32   = t.data.instance.args_start;
    val alen:   u32   = t.data.instance.args_len;
    var i:      u32   = 0;
    for (i < alen) {
        w = write_dollars(buf, w, depth + 1);
        val ra: res[usize, fail.Fail] = write_encoded_type(s, buf, w, param_at(s, astart + i), depth + 1);
        if (sel ra.err) { ret ra; }
        w = ra.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

fun fun_enc_len(s: *session.Session, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val rr: res[usize, fail.Fail] = encoded_type_len(s, t.data.fn.ret_type, depth + 1);
    if (sel rr.err) { ret rr; }
    var total:  usize = str_len(fun_head(t)) + depth + 1 + rr.ok;
    val pstart: u32   = t.data.fn.params_start;
    val plen:   u32   = t.data.fn.params_len;
    var i:      u32   = 0;
    for (i < plen) {
        val rp: res[usize, fail.Fail] = encoded_type_len(s, param_at(s, pstart + i), depth + 1);
        if (sel rp.err) { ret rp; }
        total = total + depth + 1 + rp.ok;
        i     = i + 1;
    }
    ret res[usize, fail.Fail].ok{total};
}

# a c-variadic function type is another type than the one without the tail, so it has its own head
fun fun_head(t: *type.Type) str {
    if (t.data.fn.c_variadic) { ret "fnv"; }
    ret "fn";
}

fun write_fun_enc(s: *session.Session, buf: *u8, k: usize, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    var w: usize = write_str(buf, k, fun_head(t));
    w = write_dollars(buf, w, depth + 1);
    val rr: res[usize, fail.Fail] = write_encoded_type(s, buf, w, t.data.fn.ret_type, depth + 1);
    if (sel rr.err) { ret rr; }
    w = rr.ok;
    val pstart: u32 = t.data.fn.params_start;
    val plen:   u32 = t.data.fn.params_len;
    var i:      u32 = 0;
    for (i < plen) {
        w = write_dollars(buf, w, depth + 1);
        val rp: res[usize, fail.Fail] = write_encoded_type(s, buf, w, param_at(s, pstart + i), depth + 1);
        if (sel rp.err) { ret rp; }
        w = rp.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

# a handle minted by no constructor is named as a nominal is, by module and name
fun inert_handle_path(s: *session.Session, h: type.TypeHandle) res[str, fail.Fail] {
    if (h.ctor != type.NO_HANDLE_CTOR) { ret res[str, fail.Fail].err{fail.message("mangle: a handle minted by a constructor no owner states")}; }
    if (h.ops_len != 3)                { ret res[str, fail.Fail].err{fail.message("mangle: inert handle has no declaration identity")}; }
    val stable: module.StableModuleId = s.types.handle_ops[h.ops_start]::module.StableModuleId;
    val mid:    module.ModuleId       = module.module_id_for_stable(?s.modules, stable);
    if (module.is_nil(mid)) { ret res[str, fail.Fail].err{fail.message("mangle: handle module is not acquired in the current operation")}; }
    val path: opt[str] = intern.get(?s.interner, module.module_fqn(?s.modules, mid));
    if (sel path.none) { ret res[str, fail.Fail].err{fail.message("mangle: handle module has no canonical name")}; }
    ret res[str, fail.Fail].ok{path.some};
}

fun handle_enc_len(s: *session.Session, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val h: type.TypeHandle = t.data.handle;
    if (h.ctor != type.NO_HANDLE_CTOR) { ret minted_enc_len(s, h, depth); }
    val path: res[str, fail.Fail] = inert_handle_path(s, h);
    if (sel path.err) { ret res[usize, fail.Fail].err{path.err}; }
    val name: intern.StrId = s.types.handle_ops[h.ops_start + 2]::intern.StrId;
    ret res[usize, fail.Fail].ok{str_len(path.ok) + 1 + str_len(intern.text(?s.interner, name))};
}

fun write_handle_enc(s: *session.Session, buf: *u8, k: usize, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val h: type.TypeHandle = t.data.handle;
    if (h.ctor != type.NO_HANDLE_CTOR) { ret write_minted_enc(s, buf, k, h, depth); }
    val path: res[str, fail.Fail] = inert_handle_path(s, h);
    if (sel path.err) { ret res[usize, fail.Fail].err{path.err}; }
    var w: usize = write_str(buf, k, path.ok);
    buf[w] = '.';
    val name: intern.StrId = s.types.handle_ops[h.ops_start + 2]::intern.StrId;
    ret res[usize, fail.Fail].ok{write_str(buf, w + 1, intern.text(?s.interner, name))};
}

# a minted handle is spelled by its kind, then each operand, a type as an argument is
# a name as written and a word in decimal: `spirv.image$f32$2D$0$0$0$1$Unknown`
fun minted_enc_len(s: *session.Session, h: type.TypeHandle, depth: usize) res[usize, fail.Fail] {
    var total: usize = str_len(intern.text(?s.interner, h.ctor::intern.StrId));
    var i:     u32   = 0;
    for (i + 1 < h.ops_len) {
        val part: u32 = s.types.handle_ops[h.ops_start + i];
        val held: u32 = s.types.handle_ops[h.ops_start + i + 1];
        i     = i + 2;
        total = total + depth + 1;
        if (part == type.HANDLE_PART_TYPE) {
            val r: res[usize, fail.Fail] = encoded_type_len(s, type_kind.id(held), depth + 1);
            if (sel r.err) { ret r; }
            total = total + r.ok;
        }
        or (part == type.HANDLE_PART_NAME) { total = total + str_len(intern.text(?s.interner, held::intern.StrId)); }
        or                                 { total = total + decimal_len(held::u64); }
    }
    ret res[usize, fail.Fail].ok{total};
}

fun write_minted_enc(s: *session.Session, buf: *u8, k: usize, h: type.TypeHandle, depth: usize) res[usize, fail.Fail] {
    var w: usize = write_str(buf, k, intern.text(?s.interner, h.ctor::intern.StrId));
    var i: u32   = 0;
    for (i + 1 < h.ops_len) {
        val part: u32 = s.types.handle_ops[h.ops_start + i];
        val held: u32 = s.types.handle_ops[h.ops_start + i + 1];
        i = i + 2;
        w = write_dollars(buf, w, depth + 1);
        if (part == type.HANDLE_PART_TYPE) {
            val r: res[usize, fail.Fail] = write_encoded_type(s, buf, w, type_kind.id(held), depth + 1);
            if (sel r.err) { ret r; }
            w = r.ok;
        }
        or (part == type.HANDLE_PART_NAME) { w = write_str(buf, w, intern.text(?s.interner, held::intern.StrId)); }
        or                                 { w = write_decimal(buf, w, held::u64); }
    }
    ret res[usize, fail.Fail].ok{w};
}

# a vector is spelled as in source, its element then `x` then its lane count: `f32x4`
fun vector_enc_len(t: *type.Type) res[usize, fail.Fail] {
    val element: type_kind.TypeKind = t.data.vector.element;
    if (!type_prim.is_prim(element)) { ret res[usize, fail.Fail].err{fail.message("mangle: vector element is not a primitive")}; }
    ret res[usize, fail.Fail].ok{type_prim.prim_spelling_len(element) + 1 + decimal_len(t.data.vector.lanes::u64)};
}

fun write_vector_enc(buf: *u8, k: usize, t: *type.Type) res[usize, fail.Fail] {
    val element: type_kind.TypeKind = t.data.vector.element;
    if (!type_prim.is_prim(element)) { ret res[usize, fail.Fail].err{fail.message("mangle: vector element is not a primitive")}; }
    var w: usize = write_str(buf, k, type_prim.prim_name(element));
    buf[w] = 'x';
    ret res[usize, fail.Fail].ok{write_decimal(buf, w + 1, t.data.vector.lanes::u64)};
}

# an ABI type is the C type its tag stands for, as the type interner keys it,
# never the name of the `def` that bound it: `abi_va_list`
val ABI_MARK: str = "abi_";

fun abi_c_name(t: *type.Type) res[str, fail.Fail] {
    val name: opt[str] = type.abi_type_c_name(t.data.abi.tag);
    if (sel name.none) { ret res[str, fail.Fail].err{fail.message("mangle: ABI type tag names no C type")}; }
    ret res[str, fail.Fail].ok{name.some};
}

fun abi_enc_len(t: *type.Type) res[usize, fail.Fail] {
    val name: res[str, fail.Fail] = abi_c_name(t);
    if (sel name.err) { ret res[usize, fail.Fail].err{name.err}; }
    ret res[usize, fail.Fail].ok{str_len(ABI_MARK) + str_len(name.ok)};
}

fun write_abi_enc(buf: *u8, k: usize, t: *type.Type) res[usize, fail.Fail] {
    val name: res[str, fail.Fail] = abi_c_name(t);
    if (sel name.err) { ret res[usize, fail.Fail].err{name.err}; }
    ret res[usize, fail.Fail].ok{write_str(buf, write_str(buf, k, ABI_MARK), name.ok)};
}

# a kind sema never lets reach a type argument, so meeting one here is a defect
# upstream; absent for every other kind
fun never_an_argument_msg(kind: type_kind.TypeKind) opt[str] {
    if (kind == type_kind.TYPE_GENERIC_PARAM) { ret opt[str].some{"mangle: a generic parameter is substituted before an instance is named"}; }
    if (kind == type_kind.TYPE_PACK)          { ret opt[str].some{"mangle: a pack is expanded into its element types before an instance is named"}; }
    if (kind == type_kind.TYPE_CASE_SELECTOR) { ret opt[str].some{"mangle: a case selector is neither a value nor a type spelling, so it is never a type argument"}; }
    ret opt[str].none{};
}

def KindMangling: u8;

val KIND_ENCODED:           KindMangling = 0;
val KIND_NEVER_AN_ARGUMENT: KindMangling = 1;
val KIND_UNCLASSIFIED:      KindMangling = 2;

# how a kind takes part in a symbol: every declared kind is encoded or is never
# a type argument, which the completeness test holds to
fun kind_mangling(kind: type_kind.TypeKind) KindMangling {
    if (type_prim.is_prim(kind)) { ret KIND_ENCODED; }
    if (kind == type_kind.TYPE_POINTER || kind == type_kind.TYPE_SECRET || kind == type_kind.TYPE_ARRAY
        || kind == type_kind.TYPE_REC || kind == type_kind.TYPE_UNI || kind == type_kind.TYPE_TAG
        || kind == type_kind.TYPE_INSTANCE || kind == type_kind.TYPE_FUN || kind == type_kind.TYPE_HANDLE
        || kind == type_kind.TYPE_VECTOR || kind == type_kind.TYPE_ABI) {
        ret KIND_ENCODED;
    }
    val never: opt[str] = never_an_argument_msg(kind);
    if (sel never.some) { ret KIND_NEVER_AN_ARGUMENT; }
    ret KIND_UNCLASSIFIED;
}

fun write_str(buf: *u8, k: usize, text: str) usize {
    val n: usize = str_len(text);
    memory.raw_copy((buf::usize + k)::ptr, text::ptr, n);
    ret k + n;
}

fun decimal_len(n: u64) usize {
    var digits: [std_format.DECIMAL_MAX]u8;
    ret std_format.put_u64(?digits[0], n);
}

fun write_decimal(buf: *u8, k: usize, n: u64) usize {
    ret k + std_format.put_u64(?buf[k], n);
}
