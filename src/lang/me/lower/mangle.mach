use std.allocator.page;
use std.format;
use std.memory;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.fe.ast;
use mach.lang.fe.sema.typename;
use mach.lang.fe.ast.decl;
use mach.lang.fe.ast.id;
use mach.lang.fe.comptime;
use mach.lang.fe.token;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.source;
use mach.lang.type;
use mach.lang.fail;

val PACK_MARK: str = "pack";

pub fun linkage_name(
    s:      *session.Session,
    fqn:    intern.StrId,
    bare:   intern.StrId,
    export: O.Option[intern.StrId]
) R.Result[intern.StrId, fail.Fail] {
    if (O.is_some[intern.StrId](export)) {
        ret R.ok[intern.StrId, fail.Fail](O.unwrap[intern.StrId](export));
    }
    ret mangle(s, fqn, bare, nil, 0);
}

pub fun instance_name(
    s:         *session.Session,
    fqn:       intern.StrId,
    bare:      intern.StrId,
    args:      *type.TypeId,
    arg_count: u32
) R.Result[intern.StrId, fail.Fail] {
    ret mangle(s, fqn, bare, args, arg_count);
}

pub fun value_instance_name(
    s:       *session.Session,
    fqn:     intern.StrId,
    bare:    intern.StrId,
    vals:    *comptime.CTValue,
    val_len: u32
) R.Result[intern.StrId, fail.Fail] {
    val path: str = module_path_get(s, fqn);

    val res_name: R.Result[str, fail.Fail] = bare_name_get(s, bare);
    if (R.is_err[str, fail.Fail](res_name)) {
        ret R.err[intern.StrId, fail.Fail](R.unwrap_err[str, fail.Fail](res_name));
    }
    val name: str = R.unwrap_ok[str, fail.Fail](res_name);

    var suffix_len: usize = 0;
    var i: u32 = 0;
    for (i < val_len) {
        val rv: R.Result[usize, fail.Fail] = encoded_value_len(s, ?vals[i]);
        if (R.is_err[usize, fail.Fail](rv)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](rv)); }
        suffix_len = suffix_len + 1 + R.unwrap_ok[usize, fail.Fail](rv);
        i = i + 1;
    }

    val total: usize = base_len(path, name) + suffix_len;
    val res_buf: R.Result[*u8, str] = A.allocate[u8](s.alloc, total);
    if (R.is_err[*u8, str](res_buf)) {
        ret R.err[intern.StrId, fail.Fail](fail.message(R.unwrap_err[*u8, str](res_buf)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var k: usize = base_write(buf, path, name);
    i = 0;
    for (i < val_len) {
        buf[k] = '$'; k = k + 1;
        val wv: R.Result[usize, fail.Fail] = write_encoded_value(s, buf, k, ?vals[i]);
        if (R.is_err[usize, fail.Fail](wv)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](wv)); }
        k = R.unwrap_ok[usize, fail.Fail](wv);
        i = i + 1;
    }

    ret mangle_finish(s, buf, k, total);
}

pub fun pack_instance_name(
    s:        *session.Session,
    fqn:      intern.StrId,
    bare:     intern.StrId,
    args:     *type.TypeId,
    arg_len:  u32,
    types:    *type.TypeId,
    type_len: u32
) R.Result[intern.StrId, fail.Fail] {
    val path: str = module_path_get(s, fqn);

    val res_name: R.Result[str, fail.Fail] = bare_name_get(s, bare);
    if (R.is_err[str, fail.Fail](res_name)) {
        ret R.err[intern.StrId, fail.Fail](R.unwrap_err[str, fail.Fail](res_name));
    }
    val name: str = R.unwrap_ok[str, fail.Fail](res_name);

    val ra: R.Result[usize, fail.Fail] = arg_list_len(s, args, arg_len);
    if (R.is_err[usize, fail.Fail](ra)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](ra)); }
    val rt: R.Result[usize, fail.Fail] = arg_list_len(s, types, type_len);
    if (R.is_err[usize, fail.Fail](rt)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](rt)); }

    val total: usize = base_len(path, name)
                     + R.unwrap_ok[usize, fail.Fail](ra)
                     + 1 + str_len(PACK_MARK)
                     + R.unwrap_ok[usize, fail.Fail](rt);
    val res_buf: R.Result[*u8, str] = A.allocate[u8](s.alloc, total);
    if (R.is_err[*u8, str](res_buf)) {
        ret R.err[intern.StrId, fail.Fail](fail.message(R.unwrap_err[*u8, str](res_buf)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var k: usize = base_write(buf, path, name);
    val wa: R.Result[usize, fail.Fail] = write_arg_list(s, buf, k, args, arg_len);
    if (R.is_err[usize, fail.Fail](wa)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](wa)); }
    k = R.unwrap_ok[usize, fail.Fail](wa);

    buf[k] = '$'; k = k + 1;
    k = write_str(buf, k, PACK_MARK);

    val wt: R.Result[usize, fail.Fail] = write_arg_list(s, buf, k, types, type_len);
    if (R.is_err[usize, fail.Fail](wt)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](wt)); }
    k = R.unwrap_ok[usize, fail.Fail](wt);

    ret mangle_finish(s, buf, k, total);
}

fun mangle(
    s:         *session.Session,
    fqn:       intern.StrId,
    bare:      intern.StrId,
    args:      *type.TypeId,
    arg_count: u32
) R.Result[intern.StrId, fail.Fail] {
    val path: str = module_path_get(s, fqn);

    val res_name: R.Result[str, fail.Fail] = bare_name_get(s, bare);
    if (R.is_err[str, fail.Fail](res_name)) {
        ret R.err[intern.StrId, fail.Fail](R.unwrap_err[str, fail.Fail](res_name));
    }
    val name: str = R.unwrap_ok[str, fail.Fail](res_name);

    val ra: R.Result[usize, fail.Fail] = arg_list_len(s, args, arg_count);
    if (R.is_err[usize, fail.Fail](ra)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](ra)); }

    val total: usize = base_len(path, name) + R.unwrap_ok[usize, fail.Fail](ra);
    val res_buf: R.Result[*u8, str] = A.allocate[u8](s.alloc, total);
    if (R.is_err[*u8, str](res_buf)) {
        ret R.err[intern.StrId, fail.Fail](fail.message(R.unwrap_err[*u8, str](res_buf)));
    }
    val buf: *u8 = R.unwrap_ok[*u8, str](res_buf);

    var k: usize = base_write(buf, path, name);
    val wa: R.Result[usize, fail.Fail] = write_arg_list(s, buf, k, args, arg_count);
    if (R.is_err[usize, fail.Fail](wa)) { ret R.err[intern.StrId, fail.Fail](R.unwrap_err[usize, fail.Fail](wa)); }
    k = R.unwrap_ok[usize, fail.Fail](wa);

    ret mangle_finish(s, buf, k, total);
}

fun arg_list_len(s: *session.Session, ids: *type.TypeId, n: u32) R.Result[usize, fail.Fail] {
    var total: usize = 0;
    var i: u32 = 0;
    for (i < n) {
        val r: R.Result[usize, fail.Fail] = encoded_type_len(s, ids[i], 1);
        if (R.is_err[usize, fail.Fail](r)) { ret r; }
        total = total + 1 + R.unwrap_ok[usize, fail.Fail](r);
        i = i + 1;
    }
    ret R.ok[usize, fail.Fail](total);
}

fun write_arg_list(s: *session.Session, buf: *u8, k: usize, ids: *type.TypeId, n: u32) R.Result[usize, fail.Fail] {
    var w: usize = k;
    var i: u32 = 0;
    for (i < n) {
        buf[w] = '$'; w = w + 1;
        val r: R.Result[usize, fail.Fail] = write_encoded_type(s, buf, w, ids[i], 1);
        if (R.is_err[usize, fail.Fail](r)) { ret r; }
        w = R.unwrap_ok[usize, fail.Fail](r);
        i = i + 1;
    }
    ret R.ok[usize, fail.Fail](w);
}

fun module_path_get(s: *session.Session, fqn: intern.StrId) str {
    val opt_path: O.Option[str] = intern.lookup(?s.interner, fqn);
    if (O.is_some[str](opt_path)) {
        val path: str = O.unwrap[str](opt_path);
        if (str_len(path) > 0) { ret path; }
    }
    ret "main";
}

fun bare_name_get(s: *session.Session, id: intern.StrId) R.Result[str, fail.Fail] {
    val opt_name: O.Option[str] = intern.lookup(?s.interner, id);
    if (O.is_none[str](opt_name)) {
        ret R.err[str, fail.Fail](fail.message("mangle: bare name not interned"));
    }
    ret R.ok[str, fail.Fail](O.unwrap[str](opt_name));
}

fun interned_or_empty(s: *session.Session, id: intern.StrId) str {
    val opt: O.Option[str] = intern.lookup(?s.interner, id);
    if (O.is_some[str](opt)) { ret O.unwrap[str](opt); }
    ret "";
}

fun param_at(s: *session.Session, idx: u32) type.TypeId {
    val opt: O.Option[type.TypeId] = type.get_param(?s.types, idx);
    if (O.is_some[type.TypeId](opt)) { ret O.unwrap[type.TypeId](opt); }
    ret type.TYPE_NIL;
}

fun base_len(path: str, name: str) usize {
    ret str_len(path) + 1 + str_len(name);
}

fun base_write(buf: *u8, path: str, name: str) usize {
    var k: usize = write_str(buf, 0, path);
    buf[k] = '.'; k = k + 1;
    ret write_str(buf, k, name);
}

fun mangle_finish(s: *session.Session, buf: *u8, k: usize, total: usize) R.Result[intern.StrId, fail.Fail] {
    val res_id: R.Result[intern.StrId, str] = intern.intern_bytes(?s.interner, buf::str, k);
    A.deallocate[u8](s.alloc, buf, total);
    ret fail.lift[intern.StrId](res_id);
}

fun encoded_value_len(s: *session.Session, v: *comptime.CTValue) R.Result[usize, fail.Fail] {
    if (v.kind == comptime.CT_KIND_INT) {
        if (v.data.i < 0) { ret R.ok[usize, fail.Fail](1 + decimal_len(negate_u64(v.data.i))); }
        ret R.ok[usize, fail.Fail](decimal_len(v.data.i::u64));
    }
    if (v.kind == comptime.CT_KIND_FLOAT) { ret R.ok[usize, fail.Fail](2 + 16); }
    if (v.kind == comptime.CT_KIND_STR) {
        ret R.ok[usize, fail.Fail](2 + escaped_len(interned_or_empty(s, v.data.s)));
    }
    ret R.err[usize, fail.Fail](fail.message(unencodable_value_msg(v.kind)));
}

fun write_encoded_value(s: *session.Session, buf: *u8, k: usize, v: *comptime.CTValue) R.Result[usize, fail.Fail] {
    if (v.kind == comptime.CT_KIND_INT) {
        if (v.data.i < 0) {
            buf[k] = 'n';
            ret R.ok[usize, fail.Fail](write_decimal(buf, k + 1, negate_u64(v.data.i)));
        }
        ret R.ok[usize, fail.Fail](write_decimal(buf, k, v.data.i::u64));
    }
    if (v.kind == comptime.CT_KIND_FLOAT) {
        buf[k] = 'f'; buf[k + 1] = 'x';
        ret R.ok[usize, fail.Fail](write_hex_u64(buf, k + 2, float.f64_bits(v.data.f)));
    }
    if (v.kind == comptime.CT_KIND_STR) {
        ret R.ok[usize, fail.Fail](write_escaped(buf, k, interned_or_empty(s, v.data.s)));
    }
    ret R.err[usize, fail.Fail](fail.message(unencodable_value_msg(v.kind)));
}

fun negate_u64(x: i64) u64 {
    ret (~(x::u64)) + 1;
}

fun escaped_len(text: str) usize {
    val n: usize = str_len(text);
    var total: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (text[i] == '\\' || text[i] == '"') { total = total + 1; }
        total = total + 1;
        i = i + 1;
    }
    ret total;
}

fun write_escaped(buf: *u8, k: usize, text: str) usize {
    val n: usize = str_len(text);
    var w: usize = k;
    buf[w] = '"'; w = w + 1;
    var i: usize = 0;
    for (i < n) {
        if (text[i] == '\\' || text[i] == '"') { buf[w] = '\\'; w = w + 1; }
        buf[w] = text[i]; w = w + 1;
        i = i + 1;
    }
    buf[w] = '"'; w = w + 1;
    ret w;
}

fun unencodable_value_msg(kind: comptime.CTKind) str {
    if (kind == comptime.CT_KIND_TYPE)       { ret "mangle: a comptime TYPE value cannot key a value instance"; }
    if (kind == comptime.CT_KIND_FIELD)      { ret "mangle: a comptime FIELD value cannot key a value instance"; }
    if (kind == comptime.CT_KIND_PACK_ELEM)  { ret "mangle: a comptime PACK_ELEM value cannot key a value instance"; }
    if (kind == comptime.CT_KIND_CONST_ELEM) { ret "mangle: a comptime CONST_ELEM value cannot key a value instance"; }
    ret "mangle: unfolded comptime value cannot key a value instance";
}

fun write_hex_u64(buf: *u8, k: usize, n: u64) usize {
    var w: usize = k;
    var shift: i32 = 60;
    for (shift >= 0) {
        val nib: u64 = (n >> shift::u64) & 0xF;
        if (nib < 10) { buf[w] = nib::u8 + '0'; }
        or            { buf[w] = (nib - 10)::u8 + 'a'; }
        w = w + 1;
        shift = shift - 4;
    }
    ret w;
}

fun encoded_type_len(s: *session.Session, tid: type.TypeId, depth: usize) R.Result[usize, fail.Fail] {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret R.err[usize, fail.Fail](fail.message(unencodable_type_msg(s, tid))); }
    val opt_t: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_t)) { ret R.err[usize, fail.Fail](fail.message(unencodable_type_msg(s, tid))); }
    val t: *type.Type = O.unwrap[*type.Type](opt_t);
    val kind: type.TypeKind = t.kind;

    if (kind::u32 < type.PRIM_COUNT) { ret R.ok[usize, fail.Fail](type.prim_spelling_len(kind)); }

    if (kind == type.TYPE_POINTER) { ret modifier_len(s, 1, t.data.pointer.base, depth); }
    if (kind == type.TYPE_SECRET)  { ret modifier_len(s, 3, t.data.secret.base, depth); }
    if (kind == type.TYPE_ARRAY) {
        ret modifier_len(s, 3 + decimal_len(t.data.array.count::u64), t.data.array.base, depth);
    }
    if (kind == type.TYPE_REC || kind == type.TYPE_UNI) {
        ret R.ok[usize, fail.Fail](nominal_len(s, t.data.nominal.origin, t.data.nominal.name));
    }
    if (kind == type.TYPE_INSTANCE) { ret instance_enc_len(s, t, depth); }
    if (kind == type.TYPE_FUN)      { ret fun_enc_len(s, t, depth); }
    ret R.err[usize, fail.Fail](fail.message(unencodable_type_msg(s, tid)));
}

fun modifier_len(s: *session.Session, head: usize, base: type.TypeId, depth: usize) R.Result[usize, fail.Fail] {
    val r: R.Result[usize, fail.Fail] = encoded_type_len(s, base, depth);
    if (R.is_err[usize, fail.Fail](r)) { ret r; }
    ret R.ok[usize, fail.Fail](head + depth + R.unwrap_ok[usize, fail.Fail](r));
}

fun unencodable_type_msg(s: *session.Session, tid: type.TypeId) str {
    val fallback: str = "mangle: type has no mangling encoding";
    if (tid == type.TYPE_NIL)   { ret "mangle: nil type has no mangling encoding"; }
    if (tid == type.TYPE_ERROR) { ret "mangle: error type has no mangling encoding"; }

    val rs: R.Result[str, str] = typename.type_to_str(s, tid);
    if (R.is_err[str, str](rs)) { ret fallback; }
    val spelling: str = R.unwrap_ok[str, str](rs);

    val rm: R.Result[str, str] = format.sprint(s.alloc, "mangle: type `{}` has no mangling encoding", spelling);
    typename.type_str_free(s, spelling);
    if (R.is_err[str, str](rm)) { ret fallback; }
    val owned: str = R.unwrap_ok[str, str](rm);

    val id_r: R.Result[intern.StrId, str] = intern.intern(?s.interner, owned);
    typename.type_str_free(s, owned);
    if (R.is_err[intern.StrId, str](id_r)) { ret fallback; }
    val text: O.Option[str] = intern.lookup(?s.interner, R.unwrap_ok[intern.StrId, str](id_r));
    if (O.is_none[str](text)) { ret fallback; }
    ret O.unwrap[str](text);
}

fun write_encoded_type(s: *session.Session, buf: *u8, k: usize, tid: type.TypeId, depth: usize) R.Result[usize, fail.Fail] {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret R.err[usize, fail.Fail](fail.message(unencodable_type_msg(s, tid))); }
    val opt_t: O.Option[*type.Type] = type.get(?s.types, tid);
    if (O.is_none[*type.Type](opt_t)) { ret R.err[usize, fail.Fail](fail.message(unencodable_type_msg(s, tid))); }
    val t: *type.Type = O.unwrap[*type.Type](opt_t);
    val kind: type.TypeKind = t.kind;

    if (kind::u32 < type.PRIM_COUNT) { ret R.ok[usize, fail.Fail](write_str(buf, k, type.prim_name(kind))); }

    if (kind == type.TYPE_POINTER) {
        ret write_modifier(s, buf, k, "p", t.data.pointer.base, depth);
    }
    if (kind == type.TYPE_SECRET) {
        ret write_modifier(s, buf, k, "sec", t.data.secret.base, depth);
    }
    if (kind == type.TYPE_ARRAY) {
        var w: usize = write_str(buf, k, "arr");
        w = write_decimal(buf, w, t.data.array.count::u64);
        w = write_dollars(buf, w, depth);
        ret write_encoded_type(s, buf, w, t.data.array.base, depth);
    }
    if (kind == type.TYPE_REC || kind == type.TYPE_UNI) {
        ret R.ok[usize, fail.Fail](write_nominal(s, buf, k, t.data.nominal.origin, t.data.nominal.name));
    }
    if (kind == type.TYPE_INSTANCE) { ret write_instance_enc(s, buf, k, t, depth); }
    if (kind == type.TYPE_FUN)      { ret write_fun_enc(s, buf, k, t, depth); }
    ret R.err[usize, fail.Fail](fail.message(unencodable_type_msg(s, tid)));
}

fun write_modifier(s: *session.Session, buf: *u8, k: usize, head: str, base: type.TypeId, depth: usize) R.Result[usize, fail.Fail] {
    var w: usize = write_str(buf, k, head);
    w = write_dollars(buf, w, depth);
    ret write_encoded_type(s, buf, w, base, depth);
}

fun write_dollars(buf: *u8, k: usize, n: usize) usize {
    var w: usize = k;
    var i: usize = 0;
    for (i < n) {
        buf[w] = '$';
        w = w + 1;
        i = i + 1;
    }
    ret w;
}

fun nominal_len(s: *session.Session, origin: session.ModuleId, name: intern.StrId) usize {
    val path: str = module_path_get(s, session.module_fqn(s, origin));
    ret str_len(path) + 1 + str_len(interned_or_empty(s, name));
}

fun write_nominal(s: *session.Session, buf: *u8, k: usize, origin: session.ModuleId, name: intern.StrId) usize {
    val path: str = module_path_get(s, session.module_fqn(s, origin));
    var w: usize = write_str(buf, k, path);
    buf[w] = '.'; w = w + 1;
    ret write_str(buf, w, interned_or_empty(s, name));
}

fun instance_enc_len(s: *session.Session, t: *type.Type, depth: usize) R.Result[usize, fail.Fail] {
    val origin: session.ModuleId = t.data.instance.target_origin;
    val gname:  intern.StrId     = generic_decl_name(s, origin, t.data.instance.target_decl);

    var total: usize = nominal_len(s, origin, gname);
    val astart: u32 = t.data.instance.args_start;
    val alen:   u32 = t.data.instance.args_len;
    var i: u32 = 0;
    for (i < alen) {
        val ra: R.Result[usize, fail.Fail] = encoded_type_len(s, param_at(s, astart + i), depth + 1);
        if (R.is_err[usize, fail.Fail](ra)) { ret ra; }
        total = total + depth + 1 + R.unwrap_ok[usize, fail.Fail](ra);
        i = i + 1;
    }
    ret R.ok[usize, fail.Fail](total);
}

fun write_instance_enc(s: *session.Session, buf: *u8, k: usize, t: *type.Type, depth: usize) R.Result[usize, fail.Fail] {
    val origin: session.ModuleId = t.data.instance.target_origin;
    val gname:  intern.StrId     = generic_decl_name(s, origin, t.data.instance.target_decl);

    var w: usize = write_nominal(s, buf, k, origin, gname);
    val astart: u32 = t.data.instance.args_start;
    val alen:   u32 = t.data.instance.args_len;
    var i: u32 = 0;
    for (i < alen) {
        w = write_dollars(buf, w, depth + 1);
        val ra: R.Result[usize, fail.Fail] = write_encoded_type(s, buf, w, param_at(s, astart + i), depth + 1);
        if (R.is_err[usize, fail.Fail](ra)) { ret ra; }
        w = R.unwrap_ok[usize, fail.Fail](ra);
        i = i + 1;
    }
    ret R.ok[usize, fail.Fail](w);
}

fun generic_decl_name(s: *session.Session, origin: session.ModuleId, gdecl: id.DeclId) intern.StrId {
    val ga: *ast.Ast = session.module_ast(s, origin);
    if (ga == nil) { ret intern.STR_NIL; }

    val opt_decl: O.Option[*decl.Decl] = ast.get_decl(ga, gdecl);
    if (O.is_none[*decl.Decl](opt_decl)) { ret intern.STR_NIL; }
    val d: *decl.Decl = O.unwrap[*decl.Decl](opt_decl);

    var nspan: token.Span;
    if (d.kind == decl.DECL_KIND_REC) { nspan = d.data.rec_.name; }
    or (d.kind == decl.DECL_KIND_UNI) { nspan = d.data.uni_.name; }
    or (d.kind == decl.DECL_KIND_FUN) { nspan = d.data.fun_.name; }
    or { ret intern.STR_NIL; }

    val opt_src: O.Option[*source.SourceFile] = source.get(?s.sources, ga.file_id);
    if (O.is_none[*source.SourceFile](opt_src)) { ret intern.STR_NIL; }
    val text: str = O.unwrap[*source.SourceFile](opt_src).text;

    val res_id: R.Result[intern.StrId, str] = intern.intern_span(?s.interner, text, nspan);
    if (R.is_err[intern.StrId, str](res_id)) { ret intern.STR_NIL; }
    ret R.unwrap_ok[intern.StrId, str](res_id);
}

fun fun_enc_len(s: *session.Session, t: *type.Type, depth: usize) R.Result[usize, fail.Fail] {
    val rr: R.Result[usize, fail.Fail] = encoded_type_len(s, t.data.fn.ret_type, depth + 1);
    if (R.is_err[usize, fail.Fail](rr)) { ret rr; }
    var total: usize = 2 + depth + 1 + R.unwrap_ok[usize, fail.Fail](rr);
    val pstart: u32 = t.data.fn.params_start;
    val plen:   u32 = t.data.fn.params_len;
    var i: u32 = 0;
    for (i < plen) {
        val rp: R.Result[usize, fail.Fail] = encoded_type_len(s, param_at(s, pstart + i), depth + 1);
        if (R.is_err[usize, fail.Fail](rp)) { ret rp; }
        total = total + depth + 1 + R.unwrap_ok[usize, fail.Fail](rp);
        i = i + 1;
    }
    ret R.ok[usize, fail.Fail](total);
}

fun write_fun_enc(s: *session.Session, buf: *u8, k: usize, t: *type.Type, depth: usize) R.Result[usize, fail.Fail] {
    var w: usize = write_str(buf, k, "fn");
    w = write_dollars(buf, w, depth + 1);
    val rr: R.Result[usize, fail.Fail] = write_encoded_type(s, buf, w, t.data.fn.ret_type, depth + 1);
    if (R.is_err[usize, fail.Fail](rr)) { ret rr; }
    w = R.unwrap_ok[usize, fail.Fail](rr);
    val pstart: u32 = t.data.fn.params_start;
    val plen:   u32 = t.data.fn.params_len;
    var i: u32 = 0;
    for (i < plen) {
        w = write_dollars(buf, w, depth + 1);
        val rp: R.Result[usize, fail.Fail] = write_encoded_type(s, buf, w, param_at(s, pstart + i), depth + 1);
        if (R.is_err[usize, fail.Fail](rp)) { ret rp; }
        w = R.unwrap_ok[usize, fail.Fail](rp);
        i = i + 1;
    }
    ret R.ok[usize, fail.Fail](w);
}

fun write_str(buf: *u8, k: usize, text: str) usize {
    val n: usize = str_len(text);
    memory.raw_copy((buf::usize + k)::ptr, text::ptr, n);
    ret k + n;
}

fun decimal_len(n: u64) usize {
    if (n == 0) { ret 1; }
    var len: usize = 0;
    var v: u64 = n;
    for (v > 0) {
        len = len + 1;
        v = v / 10;
    }
    ret len;
}

fun write_decimal(buf: *u8, k: usize, n: u64) usize {
    if (n == 0) { buf[k] = '0'; ret k + 1; }
    var tmp: [24]u8;
    var len: usize = 0;
    var v: u64 = n;
    for (v > 0) {
        tmp[len] = (v % 10)::u8 + '0';
        v = v / 10;
        len = len + 1;
    }
    var w: usize = k;
    var i: usize = 0;
    for (i < len) {
        buf[w] = tmp[len - 1 - i];
        w = w + 1;
        i = i + 1;
    }
    ret w;
}

test "mach.lang.me.lower.mangle.unencodable_value_msg" {
    val t: str = unencodable_value_msg(comptime.CT_KIND_TYPE);
    val f: str = unencodable_value_msg(comptime.CT_KIND_FIELD);
    val p: str = unencodable_value_msg(comptime.CT_KIND_PACK_ELEM);
    val c: str = unencodable_value_msg(comptime.CT_KIND_CONST_ELEM);

    if (str_equals(t, f)) { ret 1; }
    if (str_equals(t, p)) { ret 1; }
    if (str_equals(t, c)) { ret 1; }
    if (str_equals(f, p)) { ret 1; }
    if (str_equals(f, c)) { ret 1; }
    if (str_equals(p, c)) { ret 1; }

    val u: str = unencodable_value_msg(comptime.CT_KIND_INT);
    if (str_equals(u, t)) { ret 1; }
    if (str_equals(u, f)) { ret 1; }
    if (str_equals(u, p)) { ret 1; }
    if (str_equals(u, c)) { ret 1; }
    ret 0;
}

test "mach.lang.me.lower.mangle.negate_u64" {
    if (negate_u64(-1) != 1)                     { ret 1; }
    if (negate_u64(-9) != 9)                     { ret 1; }
    if (negate_u64(-2147483648) != 2147483648)   { ret 1; }
    val min: i64 = -9223372036854775807 - 1;
    if (negate_u64(min) != (1::u64 << 63::u64))  { ret 1; }
    if (decimal_len(negate_u64(min)) != 19)      { ret 1; }
    ret 0;
}

test "mach.lang.me.lower.mangle.escaped_string" {
    var buf: [64]u8;

    if (escaped_len("abc") != 3)     { ret 1; }
    if (escaped_len("a\"b") != 4)    { ret 1; }
    if (escaped_len("a\\b") != 4)    { ret 1; }
    if (escaped_len("\"\\") != 4)    { ret 1; }

    if (write_escaped(?buf[0], 0, "abc") != 2 + escaped_len("abc"))    { ret 1; }
    if (write_escaped(?buf[0], 0, "a\"b") != 2 + escaped_len("a\"b"))  { ret 1; }
    if (write_escaped(?buf[0], 0, "a\\b") != 2 + escaped_len("a\\b"))  { ret 1; }

    val n: usize = write_escaped(?buf[0], 0, "a\"b");
    buf[n] = 0;
    if (!str_equals((?buf[0])::str, "\"a\\\"b\"")) { ret 1; }
    ret 0;
}

test "mach.lang.me.lower.mangle.encoded_type:agrees_with_prim_catalog" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var buf: [8]u8;
    var code: i32 = 0;
    var k: u32 = 0;
    for (k < type.PRIM_COUNT) {
        val kind: type.TypeKind = k::type.TypeKind;
        val expect: str = type.prim_name(kind);
        val expect_len: usize = type.prim_spelling_len(kind);

        val rl: R.Result[usize, fail.Fail] = encoded_type_len(?s, k::type.TypeId, 0);
        if (R.is_err[usize, fail.Fail](rl))                    { code = 1; }
        or {
            if (R.unwrap_ok[usize, fail.Fail](rl) != expect_len) { code = 1; }
        }

        val rw: R.Result[usize, fail.Fail] = write_encoded_type(?s, ?buf[0], 0, k::type.TypeId, 0);
        if (R.is_err[usize, fail.Fail](rw)) { code = 1; }
        or {
            val w: usize = R.unwrap_ok[usize, fail.Fail](rw);
            buf[w] = 0;
            if (!str_equals((?buf[0])::str, expect)) { code = 1; }
        }
        k = k + 1;
    }
    ret code;
}
