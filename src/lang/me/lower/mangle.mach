use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use std.allocator.page;
use std.format;
use std.memory;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.string.str_equals;

use A: std.allocator;
use R: std.types.result;

use mach.lang.fe.sema.typename;
use mach.lang.fe.comptime;
use mach.lang.float;
use mach.lang.intern;
use mach.lang.session;
use mach.lang.type;
use mach.lang.fail;

val PACK_MARK: str = "pack";

pub fun linkage_name(
    s:      *session.Session,
    fqn:    intern.StrId,
    bare:   intern.StrId,
    export: opt[intern.StrId]
) res[intern.StrId, fail.Fail] {
    if (sel export.some) {
        ret res[intern.StrId, fail.Fail].ok{export.some};
    }
    ret mangle(s, fqn, bare, nil, 0);
}

pub fun instance_name(
    s:         *session.Session,
    fqn:       intern.StrId,
    bare:      intern.StrId,
    args:      *type.TypeId,
    arg_count: u32
) res[intern.StrId, fail.Fail] {
    ret mangle(s, fqn, bare, args, arg_count);
}

pub fun value_instance_name(
    s:       *session.Session,
    fqn:     intern.StrId,
    bare:    intern.StrId,
    vals:    *comptime.CTValue,
    val_len: u32
) res[intern.StrId, fail.Fail] {
    val path: str = module_path_get(s, fqn);

    val res_name: res[str, fail.Fail] = bare_name_get(s, bare);
    if (sel res_name.err) {
        ret res[intern.StrId, fail.Fail].err{res_name.err};
    }
    val name: str = res_name.ok;

    var suffix_len: usize = 0;
    var i: u32 = 0;
    for (i < val_len) {
        val rv: res[usize, fail.Fail] = encoded_value_len(s, ?vals[i]);
        if (sel rv.err) { ret res[intern.StrId, fail.Fail].err{rv.err}; }
        suffix_len = suffix_len + 1 + rv.ok;
        i = i + 1;
    }

    val total: usize = base_len(path, name) + suffix_len;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, total);
    if (sel res_buf.err) {
        ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;

    var k: usize = base_write(buf, path, name);
    i = 0;
    for (i < val_len) {
        buf[k] = '$'; k = k + 1;
        val wv: res[usize, fail.Fail] = write_encoded_value(s, buf, k, ?vals[i]);
        if (sel wv.err) { ret res[intern.StrId, fail.Fail].err{wv.err}; }
        k = wv.ok;
        i = i + 1;
    }

    ret mangle_finish(s, buf, k, total);
}

pub fun pack_instance_name(
    s:        *session.Session,
    fqn:      intern.StrId,
    bare:     intern.StrId,
    args:     *type.TypeId,
    arg_len:  u32,
    types:    *type.TypeId,
    type_len: u32
) res[intern.StrId, fail.Fail] {
    val path: str = module_path_get(s, fqn);

    val res_name: res[str, fail.Fail] = bare_name_get(s, bare);
    if (sel res_name.err) {
        ret res[intern.StrId, fail.Fail].err{res_name.err};
    }
    val name: str = res_name.ok;

    val ra: res[usize, fail.Fail] = arg_list_len(s, args, arg_len);
    if (sel ra.err) { ret res[intern.StrId, fail.Fail].err{ra.err}; }
    val rt: res[usize, fail.Fail] = arg_list_len(s, types, type_len);
    if (sel rt.err) { ret res[intern.StrId, fail.Fail].err{rt.err}; }

    val total: usize = base_len(path, name)
                     + ra.ok
                     + 1 + str_len(PACK_MARK)
                     + rt.ok;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, total);
    if (sel res_buf.err) {
        ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;

    var k: usize = base_write(buf, path, name);
    val wa: res[usize, fail.Fail] = write_arg_list(s, buf, k, args, arg_len);
    if (sel wa.err) { ret res[intern.StrId, fail.Fail].err{wa.err}; }
    k = wa.ok;

    buf[k] = '$'; k = k + 1;
    k = write_str(buf, k, PACK_MARK);

    val wt: res[usize, fail.Fail] = write_arg_list(s, buf, k, types, type_len);
    if (sel wt.err) { ret res[intern.StrId, fail.Fail].err{wt.err}; }
    k = wt.ok;

    ret mangle_finish(s, buf, k, total);
}

fun mangle(
    s:         *session.Session,
    fqn:       intern.StrId,
    bare:      intern.StrId,
    args:      *type.TypeId,
    arg_count: u32
) res[intern.StrId, fail.Fail] {
    val path: str = module_path_get(s, fqn);

    val res_name: res[str, fail.Fail] = bare_name_get(s, bare);
    if (sel res_name.err) {
        ret res[intern.StrId, fail.Fail].err{res_name.err};
    }
    val name: str = res_name.ok;

    val ra: res[usize, fail.Fail] = arg_list_len(s, args, arg_count);
    if (sel ra.err) { ret res[intern.StrId, fail.Fail].err{ra.err}; }

    val total: usize = base_len(path, name) + ra.ok;
    val res_buf: res[*u8, A.Error] = A.allocate[u8](s.alloc, total);
    if (sel res_buf.err) {
        ret res[intern.StrId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *u8 = res_buf.ok;

    var k: usize = base_write(buf, path, name);
    val wa: res[usize, fail.Fail] = write_arg_list(s, buf, k, args, arg_count);
    if (sel wa.err) { ret res[intern.StrId, fail.Fail].err{wa.err}; }
    k = wa.ok;

    ret mangle_finish(s, buf, k, total);
}

fun arg_list_len(s: *session.Session, ids: *type.TypeId, n: u32) res[usize, fail.Fail] {
    var total: usize = 0;
    var i: u32 = 0;
    for (i < n) {
        val r: res[usize, fail.Fail] = encoded_type_len(s, ids[i], 1);
        if (sel r.err) { ret r; }
        total = total + 1 + r.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{total};
}

fun write_arg_list(s: *session.Session, buf: *u8, k: usize, ids: *type.TypeId, n: u32) res[usize, fail.Fail] {
    var w: usize = k;
    var i: u32 = 0;
    for (i < n) {
        buf[w] = '$'; w = w + 1;
        val r: res[usize, fail.Fail] = write_encoded_type(s, buf, w, ids[i], 1);
        if (sel r.err) { ret r; }
        w = r.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

fun module_path_get(s: *session.Session, fqn: intern.StrId) str {
    val opt_path: opt[str] = intern.lookup_typed(?s.interner, fqn);
    if (sel opt_path.some) {
        val path: str = opt_path.some;
        if (str_len(path) > 0) { ret path; }
    }
    ret "main";
}

fun bare_name_get(s: *session.Session, id: intern.StrId) res[str, fail.Fail] {
    val opt_name: opt[str] = intern.lookup_typed(?s.interner, id);
    if (sel opt_name.none) {
        ret res[str, fail.Fail].err{fail.message("mangle: bare name not interned")};
    }
    ret res[str, fail.Fail].ok{opt_name.some};
}

fun interned_or_empty(s: *session.Session, id: intern.StrId) str {
    val opt_: opt[str] = intern.lookup_typed(?s.interner, id);
    if (sel opt_.some) { ret opt_.some; }
    ret "";
}

fun param_at(s: *session.Session, idx: u32) type.TypeId {
    val opt_: opt[type.TypeId] = type.get_param_typed(?s.types, idx);
    if (sel opt_.some) { ret opt_.some; }
    ret type.TYPE_NIL;
}

fun base_len(path: str, name: str) usize {
    ret str_len(path) + 1 + str_len(name);
}

fun base_write(buf: *u8, path: str, name: str) usize {
    var k: usize = write_str(buf, 0, path);
    buf[k] = '.'; k = k + 1;
    ret write_str(buf, k, name);
}

fun mangle_finish(s: *session.Session, buf: *u8, k: usize, total: usize) res[intern.StrId, fail.Fail] {
    val res_id: res[intern.StrId, A.Error] = intern.intern_bytes_typed(?s.interner, buf::str, k);
    A.deallocate[u8](s.alloc, buf, total);
    if (sel res_id.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(res_id.err)}; }
    ret res[intern.StrId, fail.Fail].ok{res_id.ok};
}

fun encoded_value_len(s: *session.Session, v: *comptime.CTValue) res[usize, fail.Fail] {
    if (v.kind == comptime.CT_KIND_INT) {
        if (v.data.i < 0) { ret res[usize, fail.Fail].ok{1 + decimal_len(negate_u64(v.data.i))}; }
        ret res[usize, fail.Fail].ok{decimal_len(v.data.i::u64)};
    }
    if (v.kind == comptime.CT_KIND_FLOAT) { ret res[usize, fail.Fail].ok{2 + 16}; }
    if (v.kind == comptime.CT_KIND_STR) {
        ret res[usize, fail.Fail].ok{2 + escaped_len(interned_or_empty(s, v.data.s))};
    }
    ret res[usize, fail.Fail].err{unencodable_value(s, v.kind)};
}

fun write_encoded_value(s: *session.Session, buf: *u8, k: usize, v: *comptime.CTValue) res[usize, fail.Fail] {
    if (v.kind == comptime.CT_KIND_INT) {
        if (v.data.i < 0) {
            buf[k] = 'n';
            ret res[usize, fail.Fail].ok{write_decimal(buf, k + 1, negate_u64(v.data.i))};
        }
        ret res[usize, fail.Fail].ok{write_decimal(buf, k, v.data.i::u64)};
    }
    if (v.kind == comptime.CT_KIND_FLOAT) {
        buf[k] = 'f'; buf[k + 1] = 'x';
        ret res[usize, fail.Fail].ok{write_hex_u64(buf, k + 2, float.f64_bits(v.data.f))};
    }
    if (v.kind == comptime.CT_KIND_STR) {
        ret res[usize, fail.Fail].ok{write_escaped(buf, k, interned_or_empty(s, v.data.s))};
    }
    ret res[usize, fail.Fail].err{unencodable_value(s, v.kind)};
}

fun negate_u64(x: i64) u64 {
    ret (~(x::u64)) + 1;
}

fun escaped_len(text: str) usize {
    val n: usize = str_len(text);
    var total: usize = 0;
    var i: usize = 0;
    for (i < n) {
        if (text[i] == '\\' || text[i] == '"') { total = total + 1; }
        total = total + 1;
        i = i + 1;
    }
    ret total;
}

fun write_escaped(buf: *u8, k: usize, text: str) usize {
    val n: usize = str_len(text);
    var w: usize = k;
    buf[w] = '"'; w = w + 1;
    var i: usize = 0;
    for (i < n) {
        if (text[i] == '\\' || text[i] == '"') { buf[w] = '\\'; w = w + 1; }
        buf[w] = text[i]; w = w + 1;
        i = i + 1;
    }
    buf[w] = '"'; w = w + 1;
    ret w;
}

# why a declared comptime value kind cannot key a value instance, absent for a
# kind outside the catalog
fun unencodable_value_msg(kind: comptime.CTKind) opt[str] {
    if (kind == comptime.CT_KIND_TYPE)       { ret opt[str].some{"mangle: a comptime TYPE value cannot key a value instance"}; }
    if (kind == comptime.CT_KIND_FIELD)      { ret opt[str].some{"mangle: a comptime FIELD value cannot key a value instance"}; }
    if (kind == comptime.CT_KIND_CASE)       { ret opt[str].some{"mangle: a comptime CASE value cannot key a value instance"}; }
    if (kind == comptime.CT_KIND_PACK_ELEM)  { ret opt[str].some{"mangle: a comptime PACK_ELEM value cannot key a value instance"}; }
    if (kind == comptime.CT_KIND_CONST_ELEM) { ret opt[str].some{"mangle: a comptime CONST_ELEM value cannot key a value instance"}; }
    if (kind == comptime.CT_KIND_INT || kind == comptime.CT_KIND_FLOAT || kind == comptime.CT_KIND_STR) {
        ret opt[str].some{"mangle: unfolded comptime value cannot key a value instance"};
    }
    ret opt[str].none{};
}

fun unencodable_value(s: *session.Session, kind: comptime.CTKind) fail.Fail {
    val why: opt[str] = unencodable_value_msg(kind);
    if (sel why.none) {
        ret fail.message(fail.catalog_message(?s.interner, s.alloc, fail.unknown_member("CTKind", kind::u32)));
    }
    ret fail.message(why.some);
}

fun write_hex_u64(buf: *u8, k: usize, n: u64) usize {
    var w: usize = k;
    var shift: i32 = 60;
    for (shift >= 0) {
        val nib: u64 = (n >> shift::u64) & 0xF;
        if (nib < 10) { buf[w] = nib::u8 + '0'; }
        or            { buf[w] = (nib - 10)::u8 + 'a'; }
        w = w + 1;
        shift = shift - 4;
    }
    ret w;
}

fun encoded_type_len(s: *session.Session, tid: type.TypeId, depth: usize) res[usize, fail.Fail] {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret res[usize, fail.Fail].err{fail.message(unencodable_type_msg(s, tid))}; }
    val opt_t: opt[*type.Type] = type.get_typed(?s.types, tid);
    if (sel opt_t.none) { ret res[usize, fail.Fail].err{fail.message(unencodable_type_msg(s, tid))}; }
    val t: *type.Type = opt_t.some;
    val kind: type.TypeKind = t.kind;

    if (kind::u32 < type.PRIM_COUNT) { ret res[usize, fail.Fail].ok{type.prim_spelling_len(kind)}; }

    if (kind == type.TYPE_POINTER) { ret modifier_len(s, 1, t.data.pointer.base, depth); }
    if (kind == type.TYPE_SECRET)  { ret modifier_len(s, 3, t.data.secret.base, depth); }
    if (kind == type.TYPE_ARRAY) {
        ret modifier_len(s, 3 + decimal_len(t.data.array.count::u64), t.data.array.base, depth);
    }
    if (kind == type.TYPE_REC || kind == type.TYPE_UNI || kind == type.TYPE_TAG) {
        ret nominal_len(s, ?t.data.nominal);
    }
    if (kind == type.TYPE_INSTANCE) { ret instance_enc_len(s, t, depth); }
    if (kind == type.TYPE_FUN)      { ret fun_enc_len(s, t, depth); }
    ret res[usize, fail.Fail].err{fail.message(unencodable_type_msg(s, tid))};
}

fun modifier_len(s: *session.Session, head: usize, base: type.TypeId, depth: usize) res[usize, fail.Fail] {
    val r: res[usize, fail.Fail] = encoded_type_len(s, base, depth);
    if (sel r.err) { ret r; }
    ret res[usize, fail.Fail].ok{head + depth + r.ok};
}

fun unencodable_type_msg(s: *session.Session, tid: type.TypeId) str {
    val fallback: str = "mangle: type has no mangling encoding";
    if (tid == type.TYPE_NIL)   { ret "mangle: nil type has no mangling encoding"; }
    if (tid == type.TYPE_ERROR) { ret "mangle: error type has no mangling encoding"; }

    val rs: res[str, fail.Fail] = typename.type_to_str_typed(s, tid);
    if (sel rs.err) { ret fallback; }
    val spelling: str = rs.ok;

    val rm: res[str, format.FormatError] = format.sprint(s.alloc, "mangle: type `{}` has no mangling encoding", spelling);
    typename.type_str_free(s, spelling);
    if (sel rm.err) { ret fallback; }
    val owned: str = rm.ok;

    val id_r: res[intern.StrId, A.Error] = intern.intern_typed(?s.interner, owned);
    typename.type_str_free(s, owned);
    if (sel id_r.err) { ret fallback; }
    val text: opt[str] = intern.lookup_typed(?s.interner, id_r.ok);
    if (sel text.none) { ret fallback; }
    ret text.some;
}

fun write_encoded_type(s: *session.Session, buf: *u8, k: usize, tid: type.TypeId, depth: usize) res[usize, fail.Fail] {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret res[usize, fail.Fail].err{fail.message(unencodable_type_msg(s, tid))}; }
    val opt_t: opt[*type.Type] = type.get_typed(?s.types, tid);
    if (sel opt_t.none) { ret res[usize, fail.Fail].err{fail.message(unencodable_type_msg(s, tid))}; }
    val t: *type.Type = opt_t.some;
    val kind: type.TypeKind = t.kind;

    if (kind::u32 < type.PRIM_COUNT) { ret res[usize, fail.Fail].ok{write_str(buf, k, type.prim_name(kind))}; }

    if (kind == type.TYPE_POINTER) {
        ret write_modifier(s, buf, k, "p", t.data.pointer.base, depth);
    }
    if (kind == type.TYPE_SECRET) {
        ret write_modifier(s, buf, k, "sec", t.data.secret.base, depth);
    }
    if (kind == type.TYPE_ARRAY) {
        var w: usize = write_str(buf, k, "arr");
        w = write_decimal(buf, w, t.data.array.count::u64);
        w = write_dollars(buf, w, depth);
        ret write_encoded_type(s, buf, w, t.data.array.base, depth);
    }
    if (kind == type.TYPE_REC || kind == type.TYPE_UNI || kind == type.TYPE_TAG) {
        ret write_nominal(s, buf, k, ?t.data.nominal);
    }
    if (kind == type.TYPE_INSTANCE) { ret write_instance_enc(s, buf, k, t, depth); }
    if (kind == type.TYPE_FUN)      { ret write_fun_enc(s, buf, k, t, depth); }
    ret res[usize, fail.Fail].err{fail.message(unencodable_type_msg(s, tid))};
}

fun write_modifier(s: *session.Session, buf: *u8, k: usize, head: str, base: type.TypeId, depth: usize) res[usize, fail.Fail] {
    var w: usize = write_str(buf, k, head);
    w = write_dollars(buf, w, depth);
    ret write_encoded_type(s, buf, w, base, depth);
}

fun write_dollars(buf: *u8, k: usize, n: usize) usize {
    var w: usize = k;
    var i: usize = 0;
    for (i < n) {
        buf[w] = '$';
        w = w + 1;
        i = i + 1;
    }
    ret w;
}

fun nominal_path(s: *session.Session, nominal: *type.TypeNominal) res[str, fail.Fail] {
    val mid: session.ModuleId = session.module_id_for_stable(s, nominal.owner.module);
    if (mid == session.MODULE_NIL) { ret res[str, fail.Fail].err{fail.message("mangle: nominal module is not acquired in the current operation")}; }
    val fqn: intern.StrId = session.module_fqn(s, mid);
    val path: opt[str] = intern.lookup_typed(?s.interner, fqn);
    if (sel path.none) { ret res[str, fail.Fail].err{fail.message("mangle: nominal module has no canonical name")}; }
    ret res[str, fail.Fail].ok{path.some};
}

fun nominal_len(s: *session.Session, nominal: *type.TypeNominal) res[usize, fail.Fail] {
    val path: res[str, fail.Fail] = nominal_path(s, nominal);
    if (sel path.err) { ret res[usize, fail.Fail].err{path.err}; }
    var size: usize = str_len(path.ok) + 1 + str_len(interned_or_empty(s, nominal.name));
    if (nominal.incarnation != 0) {
        val recipe: opt[str] = intern.lookup_typed(?s.interner, nominal.syntax);
        if (sel recipe.none) { ret res[usize, fail.Fail].err{fail.message("mangle: anonymous type has no canonical recipe")}; }
        size = size + 1 + str_len(recipe.some);
    }
    ret res[usize, fail.Fail].ok{size};
}

fun write_nominal(s: *session.Session, buf: *u8, k: usize, nominal: *type.TypeNominal) res[usize, fail.Fail] {
    val path: res[str, fail.Fail] = nominal_path(s, nominal);
    if (sel path.err) { ret res[usize, fail.Fail].err{path.err}; }
    var w: usize = write_str(buf, k, path.ok);
    buf[w] = '.'; w = w + 1;
    w = write_str(buf, w, interned_or_empty(s, nominal.name));
    if (nominal.incarnation != 0) {
        val recipe: opt[str] = intern.lookup_typed(?s.interner, nominal.syntax);
        if (sel recipe.none) { ret res[usize, fail.Fail].err{fail.message("mangle: anonymous type has no canonical recipe")}; }
        buf[w] = '$'; w = w + 1;
        w = write_str(buf, w, recipe.some);
    }
    ret res[usize, fail.Fail].ok{w};
}

fun instance_nominal(s: *session.Session, t: *type.Type) res[*type.TypeNominal, fail.Fail] {
    val found: opt[*type.Type] = type.get_typed(?s.types, t.data.instance.nominal);
    if (sel found.none) { ret res[*type.TypeNominal, fail.Fail].err{fail.message("mangle: generic instance has no nominal type")}; }
    val nominal: *type.Type = found.some;
    if (nominal.kind != type.TYPE_REC && nominal.kind != type.TYPE_UNI && nominal.kind != type.TYPE_TAG) {
        ret res[*type.TypeNominal, fail.Fail].err{fail.message("mangle: generic instance nominal has the wrong kind")};
    }
    ret res[*type.TypeNominal, fail.Fail].ok{?nominal.data.nominal};
}

fun instance_enc_len(s: *session.Session, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val nominal: res[*type.TypeNominal, fail.Fail] = instance_nominal(s, t);
    if (sel nominal.err) { ret res[usize, fail.Fail].err{nominal.err}; }
    val size: res[usize, fail.Fail] = nominal_len(s, nominal.ok);
    if (sel size.err) { ret size; }
    var total: usize = size.ok;
    val astart: u32 = t.data.instance.args_start;
    val alen:   u32 = t.data.instance.args_len;
    var i: u32 = 0;
    for (i < alen) {
        val ra: res[usize, fail.Fail] = encoded_type_len(s, param_at(s, astart + i), depth + 1);
        if (sel ra.err) { ret ra; }
        total = total + depth + 1 + ra.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{total};
}

fun write_instance_enc(s: *session.Session, buf: *u8, k: usize, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val nominal: res[*type.TypeNominal, fail.Fail] = instance_nominal(s, t);
    if (sel nominal.err) { ret res[usize, fail.Fail].err{nominal.err}; }
    val written: res[usize, fail.Fail] = write_nominal(s, buf, k, nominal.ok);
    if (sel written.err) { ret written; }
    var w: usize = written.ok;
    val astart: u32 = t.data.instance.args_start;
    val alen:   u32 = t.data.instance.args_len;
    var i: u32 = 0;
    for (i < alen) {
        w = write_dollars(buf, w, depth + 1);
        val ra: res[usize, fail.Fail] = write_encoded_type(s, buf, w, param_at(s, astart + i), depth + 1);
        if (sel ra.err) { ret ra; }
        w = ra.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

fun fun_enc_len(s: *session.Session, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    val rr: res[usize, fail.Fail] = encoded_type_len(s, t.data.fn.ret_type, depth + 1);
    if (sel rr.err) { ret rr; }
    var total: usize = 2 + depth + 1 + rr.ok;
    val pstart: u32 = t.data.fn.params_start;
    val plen:   u32 = t.data.fn.params_len;
    var i: u32 = 0;
    for (i < plen) {
        val rp: res[usize, fail.Fail] = encoded_type_len(s, param_at(s, pstart + i), depth + 1);
        if (sel rp.err) { ret rp; }
        total = total + depth + 1 + rp.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{total};
}

fun write_fun_enc(s: *session.Session, buf: *u8, k: usize, t: *type.Type, depth: usize) res[usize, fail.Fail] {
    var w: usize = write_str(buf, k, "fn");
    w = write_dollars(buf, w, depth + 1);
    val rr: res[usize, fail.Fail] = write_encoded_type(s, buf, w, t.data.fn.ret_type, depth + 1);
    if (sel rr.err) { ret rr; }
    w = rr.ok;
    val pstart: u32 = t.data.fn.params_start;
    val plen:   u32 = t.data.fn.params_len;
    var i: u32 = 0;
    for (i < plen) {
        w = write_dollars(buf, w, depth + 1);
        val rp: res[usize, fail.Fail] = write_encoded_type(s, buf, w, param_at(s, pstart + i), depth + 1);
        if (sel rp.err) { ret rp; }
        w = rp.ok;
        i = i + 1;
    }
    ret res[usize, fail.Fail].ok{w};
}

fun write_str(buf: *u8, k: usize, text: str) usize {
    val n: usize = str_len(text);
    memory.raw_copy((buf::usize + k)::ptr, text::ptr, n);
    ret k + n;
}

fun decimal_len(n: u64) usize {
    if (n == 0) { ret 1; }
    var len: usize = 0;
    var v: u64 = n;
    for (v > 0) {
        len = len + 1;
        v = v / 10;
    }
    ret len;
}

fun write_decimal(buf: *u8, k: usize, n: u64) usize {
    if (n == 0) { buf[k] = '0'; ret k + 1; }
    var tmp: [24]u8;
    var len: usize = 0;
    var v: u64 = n;
    for (v > 0) {
        tmp[len] = (v % 10)::u8 + '0';
        v = v / 10;
        len = len + 1;
    }
    var w: usize = k;
    var i: usize = 0;
    for (i < len) {
        buf[w] = tmp[len - 1 - i];
        w = w + 1;
        i = i + 1;
    }
    ret w;
}

test "mach.lang.me.lower.mangle.unencodable_value_msg" {
    val t_r: opt[str] = unencodable_value_msg(comptime.CT_KIND_TYPE);
    if (sel t_r.none) { ret 1; }
    val t: str = t_r.some;
    val f_r: opt[str] = unencodable_value_msg(comptime.CT_KIND_FIELD);
    if (sel f_r.none) { ret 1; }
    val f: str = f_r.some;
    val p_r: opt[str] = unencodable_value_msg(comptime.CT_KIND_PACK_ELEM);
    if (sel p_r.none) { ret 1; }
    val p: str = p_r.some;
    val c_r: opt[str] = unencodable_value_msg(comptime.CT_KIND_CONST_ELEM);
    if (sel c_r.none) { ret 1; }
    val c: str = c_r.some;
    val r_590: opt[str] = unencodable_value_msg(255::comptime.CTKind);
    if (sel r_590.some) { ret 2; }

    if (str_equals(t, f)) { ret 1; }
    if (str_equals(t, p)) { ret 1; }
    if (str_equals(t, c)) { ret 1; }
    if (str_equals(f, p)) { ret 1; }
    if (str_equals(f, c)) { ret 1; }
    if (str_equals(p, c)) { ret 1; }

    val u_r: opt[str] = unencodable_value_msg(comptime.CT_KIND_INT);
    if (sel u_r.none) { ret 1; }
    val u: str = u_r.some;
    if (str_equals(u, t)) { ret 1; }
    if (str_equals(u, f)) { ret 1; }
    if (str_equals(u, p)) { ret 1; }
    if (str_equals(u, c)) { ret 1; }
    ret 0;
}

test "mach.lang.me.lower.mangle.negate_u64" {
    if (negate_u64(-1) != 1)                     { ret 1; }
    if (negate_u64(-9) != 9)                     { ret 1; }
    if (negate_u64(-2147483648) != 2147483648)   { ret 1; }
    val min: i64 = -9223372036854775807 - 1;
    if (negate_u64(min) != (1::u64 << 63::u64))  { ret 1; }
    if (decimal_len(negate_u64(min)) != 19)      { ret 1; }
    ret 0;
}

test "mach.lang.me.lower.mangle.escaped_string" {
    var buf: [64]u8;

    if (escaped_len("abc") != 3)     { ret 1; }
    if (escaped_len("a\"b") != 4)    { ret 1; }
    if (escaped_len("a\\b") != 4)    { ret 1; }
    if (escaped_len("\"\\") != 4)    { ret 1; }

    if (write_escaped(?buf[0], 0, "abc") != 2 + escaped_len("abc"))    { ret 1; }
    if (write_escaped(?buf[0], 0, "a\"b") != 2 + escaped_len("a\"b"))  { ret 1; }
    if (write_escaped(?buf[0], 0, "a\\b") != 2 + escaped_len("a\\b"))  { ret 1; }

    val n: usize = write_escaped(?buf[0], 0, "a\"b");
    buf[n] = 0;
    if (!str_equals((?buf[0])::str, "\"a\\\"b\"")) { ret 1; }
    ret 0;
}

test "mach.lang.me.lower.mangle.encoded_type:agrees_with_prim_catalog" {
    var alloc: A.Allocator;
    val r_637: err[A.Error] = page.make(?alloc);
    if (sel r_637.err) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var buf: [8]u8;
    var code: i32 = 0;
    var k: u32 = 0;
    for (k < type.PRIM_COUNT) {
        val kind: type.TypeKind = k::type.TypeKind;
        val expect: str = type.prim_name(kind);
        val expect_len: usize = type.prim_spelling_len(kind);

        val rl: res[usize, fail.Fail] = encoded_type_len(?s, k::type.TypeId, 0);
        if (sel rl.err)                    { code = 1; }
        or (sel rl.ok) {
            if (rl.ok != expect_len) { code = 1; }
        }

        val rw: res[usize, fail.Fail] = write_encoded_type(?s, ?buf[0], 0, k::type.TypeId, 0);
        if (sel rw.err) { code = 1; }
        or (sel rw.ok) {
            val w: usize = rw.ok;
            buf[w] = 0;
            if (!str_equals((?buf[0])::str, expect)) { code = 1; }
        }
        k = k + 1;
    }
    ret code;
}
