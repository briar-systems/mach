val INITIAL_STACK_CAP: u32 = 8;

pub rec LoopFrame {
    header:    id.Block;
    exit:      id.Block;
    fin_depth: u32;
}

# the target lowering builds for: the tuple its modules are named for, the target mirl
# assembled from it, and the context the build's selection opened, none for a target with
# no baseline
pub rec Machine {
    tuple:  mirl_module.Tuple;
    target: *mirl_target.Target;
    ctx:    opt[*core_state.Context];
}

# the machine of a target the owners assembled, borrowing it
pub fun machine_of(x: *target_owner.Assembled) Machine {
    var ctx: opt[*core_state.Context] = opt[*core_state.Context].none{};
    if (x.based) { ctx = opt[*core_state.Context].some{?x.basis.context}; }
    ret Machine{tuple: x.tuple, target: ?x.target, ctx: ctx};
}

# what the driver reads of a lowered module beside its mirl module: its name and, for
# each function of the module by index, what mach declared it as
# ---
# test:     a test, run by the dispatcher under `name`
# noreturn: it never returns, so falling off its end is unreachable
# defined:  the module gives it a body
pub rec FnInfo {
    name:     intern.StrId;
    line:     u32;
    test:     bool;
    noreturn: bool;
    defined:  bool;
}

# a lowered module: the mirl module, the facts mach keeps of its functions, and the
# allocator both live in
# ---
# exports: the linkage names a root-project `fwd` puts on a shared library's surface,
#          which another module of the image defines
pub rec Unit {
    name:         intern.StrId;
    m:            mirl_module.Module;
    fns:          collections_vector.Vector[FnInfo];
    exports:      collections_vector.Vector[intern.StrId];
    root_project: bool;
    # compiling rewrites the module in place, so a unit compiles once
    compiled: bool;
}

# an empty unit named `name`, its module built for the machine's target
pub fun unit_init(a: *A.Allocator, machine: *Machine, name: intern.StrId, root_project: bool) res[Unit, fail.Fail] {
    val made: res[mirl_module.Module, mirl_module.Error] = mirl_module.init(a, machine.tuple);
    if (sel made.err) { ret res[Unit, fail.Fail].err{fail.message("lower: mirl refused the target tuple")}; }
    var u: Unit;
    u.name = name;
    u.m    = made.ok;
    mirl_module.state_language(?u.m, ?mirl_language.MACH);
    u.fns          = collections_vector.init[FnInfo](a);
    u.exports      = collections_vector.init[intern.StrId](a);
    u.root_project = root_project;
    u.compiled     = false;
    ret res[Unit, fail.Fail].ok{u};
}

# release a unit's module and facts
pub fun unit_dnit(u: *Unit) {
    mirl_module.dnit(?u.m);
    collections_vector.dnit[FnInfo](?u.fns);
    collections_vector.dnit[intern.StrId](?u.exports);
}

# the facts of function `f` of a unit, none past its functions
pub fun fn_info(u: *Unit, f: u32) opt[*FnInfo] {
    if (f::usize >= u.fns.len) { ret opt[*FnInfo].none{}; }
    ret opt[*FnInfo].some{?u.fns.data[f]};
}

# a module's test object holds its tests and `#[testing]` declarations beside its
# normal object, which it never changes. every definition the normal object already
# holds is declared in the test object instead, so each symbol has one definition
# ---
# defined: the global symbols the normal object defines
pub rec NormalObject {
    defined: map.Map[intern.StrId, bool];
}

# lowering the test object, which declares `name` because the normal object defines it
pub fun normal_defines(lc: *LowerContext, name: intern.StrId) bool {
    if (lc.normal_object == nil) { ret false; }
    val found: opt[*bool] = map.get[intern.StrId, bool](?lc.normal_object.defined, ?name);
    ret sel found.some;
}

pub rec ModuleScope {
    a:           *ast.Ast;
    source:      str;
    fqn:         intern.StrId;
    own_module:  session.ModuleId;
    typing:      fe_sema.template.Typing;
    iface:       *fe_sema.interface.Interface;
    rr:          *resolve.ResolveResult;
    env:         comptime.ComptimeEnv;
    ctx:         *comptime.ComptimeCtx;
    subst:       *type.TypeId;
    subst_len:   u32;
    subst_owner: type.GenericOwner;
    # the typing frame of the lowering module's instance set its code is read through:
    # the module's own typing, an instance's, or one of their iterations; NONE for another
    # module's code read outside an instance
    frame: u32;
}

rec ForeignScope {
    origin: session.ModuleId;
    ctx:    *comptime.ComptimeCtx;
}

# the element of a constant array a `$each` loop variable names: the array's expression and the
# element's index in it, where the element is stored
pub rec EachElement {
    name:  intern.StrId;
    array: ast_id.ExprId;
    index: u32;
}

pub rec ScopeMark {
    owner:      ptr;
    depth:      u32;
    generation: u64;
    parent:     u64;
}

pub rec LowerRequest {
    # the declarations' export names, the project's
    linkage:    *linkage.Linkage;
    interfaces: fe_sema.interface.Reader;
    instances:  *fe_sema.instance.Set;
    diags:      *diagnostic.DiagnosticStore;
    s:          *session.Session;
    tgt:        *resolved.Target;
    machine:    *Machine;
    malloc:     *A.Allocator;
    module:     ModuleScope;
    # nil when lowering the module's normal object; when lowering its test object, what
    # the normal object defines
    normal_object: *NormalObject;
    # the artifact this lowering feeds is a shared library, so a `fwd` that
    # exports nothing is worth a warning
    shared_artifact: bool;
    debug:           bool;
    checks:          bool;
}

pub rec LowerContext {
    interfaces: fe_sema.interface.Reader;
    # the scopes another module's templates are lowered in, one per module, which this
    # lowering owns and binds in
    foreign:          collections_vector.Vector[ForeignScope];
    diags:            *diagnostic.DiagnosticStore;
    status:           fail.PhaseStatus;
    s:                *session.Session;
    linkage:          *linkage.Linkage;
    tgt:              *resolved.Target;
    machine:          *Machine;
    scope:            ModuleScope;
    scopes:           *ModuleScope;
    scope_len:        u32;
    scope_cap:        u32;
    scope_generation: u64;
    scope_top:        u64;
    caps:             comptime.PhaseCapabilities[LowerContext];
    shared_artifact:  bool;
    debug:            bool;
    # debug-profile runtime checks: the release pipeline emits none
    checks:  bool;
    unit:    *Unit;
    m:       *mirl_module.Module;
    builder: builder.Builder;
    locals:  map.Map[resolve.SymbolId, value.Value];

    fn_index:   u32;
    ret_type:   Type;
    fn_ret_sem: type.TypeId;
    # the source name of the function being built, which diagnostics name it by
    fn_shown: lang_source.Span;

    # the module's debug types by the substituted source type each describes
    debug_types: map.Map[type.TypeId, mirl_debug.Type];
    # whether each type holds a secret in its own storage, asked once per type: 1 when
    # it does, 2 when it does not
    held: map.Map[type.TypeId, u8];
    # the pointees the debug types name by key, described once every other type is
    debug_pointees: collections_vector.Vector[DebugPointee];

    loops:    *LoopFrame;
    loop_len: u32;
    loop_cap: u32;

    fins:    *ast_id.StmtId;
    fin_len: u32;
    fin_cap: u32;

    # the instances the lowering module's sema discovered, with their typing
    instances: *fe_sema.instance.Set;
    # the `$each` elements the statements being lowered bind, innermost last
    elements: collections_vector.Vector[EachElement];
    # the scratch store of the zeros an element literal's omitted fields hold, one tree per type
    # for the context's life
    zeros: comptime_deep.Store;

    pack_slots:    *value.Value;
    pack_types:    *type.TypeId;
    pack_len:      u32;
    pack_ret_type: type.TypeId;

    normal_object: *NormalObject;

    # while armed, the call argument whose aggregate read may use its source in place;
    # borrow_now says the read being lowered is that one, borrow_hit that it did
    borrow_armed: bool;
    borrow_eid:   ast_id.ExprId;
    borrow_now:   bool;
    borrow_hit:   bool;
    # the expression statement being lowered, whose value nothing reads
    discard_eid: ast_id.ExprId;
}

fun scope_nil() ModuleScope {
    var sc: ModuleScope;
    sc.a          = nil;
    sc.source     = nil;
    sc.fqn        = intern.STR_NIL;
    sc.own_module = module.id(0);
    sc.typing     = fe_sema.template.Typing{};
    sc.iface      = nil;
    sc.rr         = nil;
    sc.ctx        = nil;
    sc.subst      = nil;
    sc.subst_len  = 0;
    sc.frame      = fe_sema.instance.NONE;
    ret sc;
}

pub fun module_scope(
    s: *session.Session,
    own_module: session.ModuleId,
    a: *ast.Ast,
    fqn: intern.StrId,
    sema_result: *fe_sema.SemaResult,
    rr: *resolve.ResolveResult,
    ctx: *comptime.ComptimeCtx) res[ModuleScope, fail.Fail] {
    if (s == nil)           { ret res[ModuleScope, fail.Fail].err{fail.message("lower: a module scope requires a session")}; }
    if (a == nil)           { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no parsed AST")}; }
    if (sema_result == nil) { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no semantic result")}; }
    if (rr == nil)          { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no name-resolution result")}; }
    if (ctx == nil)         { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no comptime context")}; }
    if (rr.expr_count::usize != a.exprs.len || sema_result.expr_count::usize != a.exprs.len
        || rr.decl_count::usize != a.decls.len || sema_result.decl_count::usize != a.decls.len) {
        ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope pieces were made from another syntax tree")};
    }
    if (!intern.str_same(session.module_fqn(s, own_module), fqn)) {
        ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope name belongs to another module")};
    }

    val source: res[str, fail.Fail] = ast_source(s, a);
    if (sel source.err) { ret res[ModuleScope, fail.Fail].err{source.err}; }

    var sc: ModuleScope = scope_nil();
    sc.a          = a;
    sc.source     = source.ok;
    sc.fqn        = fqn;
    sc.own_module = own_module;
    sc.typing     = fe_sema.template.Typing{expr_type: sema_result.expr_type, type_resolved_ty: sema_result.type_resolved_ty,
        decl_type: sema_result.decl_type, expr_count: sema_result.expr_count, type_count: sema_result.type_count, decl_count: sema_result.decl_count};
    sc.iface = ?sema_result.interface;
    sc.rr    = rr;
    sc.env   = comptime.environment(ctx);
    sc.ctx   = ctx;
    ret res[ModuleScope, fail.Fail].ok{sc};
}

# the scope another module's template is read in: the copy its interface publishes, with a
# comptime scope over its constants that this lowering owns, so what an instance binds stays here
pub fun origin_scope(lc: *LowerContext, origin: session.ModuleId) res[ModuleScope, fail.Fail] {
    if (module.same(origin, lc.scope.own_module)) { ret res[ModuleScope, fail.Fail].ok{lc.scope}; }
    val acquired: res[*fe_sema.interface.Interface, fail.Fail] = interface_of(lc, origin);
    if (sel acquired.err) { ret res[ModuleScope, fail.Fail].err{acquired.err}; }
    val iface: *fe_sema.interface.Interface    = acquired.ok;
    val found: opt[*fe_sema.template.Template] = fe_sema.interface.template_of(iface);
    if (sel found.none) { ret res[ModuleScope, fail.Fail].err{fail.message("lower: an instance's module publishes no template")}; }
    val t:      *fe_sema.template.Template            = found.some;
    val scoped: res[*comptime.ComptimeCtx, fail.Fail] = foreign_ctx(lc, origin, t);
    if (sel scoped.err) { ret res[ModuleScope, fail.Fail].err{scoped.err}; }

    var sc: ModuleScope = scope_nil();
    sc.a          = ?t.a;
    sc.source     = t.source;
    sc.fqn        = session.module_fqn(lc.s, origin);
    sc.own_module = origin;
    sc.typing     = t.typing;
    sc.iface      = iface;
    sc.rr         = ?t.rr;
    sc.env        = t.env;
    sc.ctx        = scoped.ok;
    ret res[ModuleScope, fail.Fail].ok{sc};
}

fun foreign_ctx(lc: *LowerContext, origin: session.ModuleId, t: *fe_sema.template.Template) res[*comptime.ComptimeCtx, fail.Fail] {
    var i: usize = 0;
    for (i < lc.foreign.len) {
        if (module.same(lc.foreign.data[i].origin, origin)) { ret res[*comptime.ComptimeCtx, fail.Fail].ok{lc.foreign.data[i].ctx}; }
        i = i + 1;
    }
    val made: res[*comptime.ComptimeCtx, A.Error] = A.allocate[comptime.ComptimeCtx](lc.s.alloc, 1);
    if (sel made.err) { ret res[*comptime.ComptimeCtx, fail.Fail].err{fail.refused(made.err)}; }
    var c:    *comptime.ComptimeCtx = made.ok;
    var kept: bool                  = false;
    fin {
        if (!kept) {
            comptime.dnit(c);
            A.deallocate[comptime.ComptimeCtx](lc.s.alloc, c, 1);
        }
    }
    @c = comptime.lowering_over(t.env, ?t.load, ?t.resolved, ?t.typed, lc.s.alloc);
    val gates: err[fail.Fail] = comptime.prepare_gates(c, t.a.exprs.len::u32);
    if (sel gates.err) { ret res[*comptime.ComptimeCtx, fail.Fail].err{gates.err}; }
    val pushed: res[usize, A.Error] = collections_vector.push[ForeignScope](?lc.foreign, ForeignScope{origin: origin, ctx: c});
    if (sel pushed.err) { ret res[*comptime.ComptimeCtx, fail.Fail].err{fail.refused(pushed.err)}; }
    kept = true;
    ret res[*comptime.ComptimeCtx, fail.Fail].ok{c};
}

pub fun request(
    s: *session.Session,
    l: *linkage.Linkage,
    tgt: *resolved.Target,
    machine: *Machine,
    malloc: *A.Allocator,
    a: *ast.Ast,
    fqn: intern.StrId,
    own_module: session.ModuleId,
    sema_result: *fe_sema.SemaResult,
    rr: *resolve.ResolveResult,
    ctx: *comptime.ComptimeCtx,
    normal_object: *NormalObject,
    shared_artifact: bool,
    debug: bool,
    checks: bool,
    diags: *diagnostic.DiagnosticStore,
    interfaces: fe_sema.interface.Reader) res[LowerRequest, fail.Fail] {
    if (l == nil)       { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires the project's linkage")}; }
    if (tgt == nil)     { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires a resolved target")}; }
    if (machine == nil) { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires the target mirl assembled")}; }
    if (malloc == nil)  { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires an allocator")}; }

    if (interfaces.read == nil) { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires a reader of imported interfaces")}; }
    if (diags == nil)           { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires a diagnostic store")}; }
    val sr: res[ModuleScope, fail.Fail] = module_scope(s, own_module, a, fqn, sema_result, rr, ctx);
    if (sel sr.err) { ret res[LowerRequest, fail.Fail].err{sr.err}; }

    var req: LowerRequest;
    req.s               = s;
    req.linkage         = l;
    req.interfaces      = interfaces;
    req.instances       = ?sema_result.instances;
    req.diags           = diags;
    req.tgt             = tgt;
    req.machine         = machine;
    req.malloc          = malloc;
    req.module          = sr.ok;
    req.module.frame    = fe_sema.instance.FRAME_TEMPLATE;
    req.normal_object   = normal_object;
    req.shared_artifact = shared_artifact;
    req.debug           = debug;
    req.checks          = checks;
    ret res[LowerRequest, fail.Fail].ok{req};
}

pub fun scope_enter(lc: *LowerContext, next: ModuleScope) res[ScopeMark, fail.Fail] {
    if (lc == nil) { ret res[ScopeMark, fail.Fail].err{fail.message("lower: scope_enter requires a context")}; }
    if (lc.scope_generation == 0xFFFFFFFFFFFFFFFF) {
        ret res[ScopeMark, fail.Fail].err{fail.message("lower: module scope generation exhausted")};
    }
    val grown: err[A.Error] = growth.reserve[ModuleScope](lc.s.alloc, ?lc.scopes, ?lc.scope_cap, lc.scope_len::usize + 1);
    if (sel grown.err) { ret res[ScopeMark, fail.Fail].err{fail.refused(grown.err)}; }

    lc.scopes[lc.scope_len] = lc.scope;
    lc.scope_len            = lc.scope_len + 1;

    var mark: ScopeMark;
    mark.owner      = lc::ptr;
    mark.depth      = lc.scope_len;
    mark.generation = lc.scope_generation + 1;
    mark.parent     = lc.scope_top;

    lc.scope_generation = mark.generation;
    lc.scope_top        = mark.generation;
    lc.scope            = next;
    ret res[ScopeMark, fail.Fail].ok{mark};
}

pub fun scope_leave(lc: *LowerContext, mark: ScopeMark) err[fail.Fail] {
    if (lc == nil || mark.owner != lc::ptr) {
        ret err[fail.Fail].err{fail.message("lower: scope_leave mark belongs to another context")};
    }
    if (mark.generation == 0 || mark.generation != lc.scope_top || mark.depth != lc.scope_len) {
        ret err[fail.Fail].err{fail.message("lower: scope_leave mark is stale or out of order")};
    }
    lc.scope_len = lc.scope_len - 1;
    lc.scope     = lc.scopes[lc.scope_len];
    lc.scope_top = mark.parent;
    ret err[fail.Fail].ok{};
}

pub fun init_context(lc: *LowerContext, req: *LowerRequest, unit: *Unit) err[fail.Fail] {
    if (req == nil) { ret err[fail.Fail].err{fail.message("lower: init_context requires a lowering request")}; }
    val s: *session.Session = req.s;
    lc.status           = fail.accepted();
    lc.s                = s;
    lc.linkage          = req.linkage;
    lc.interfaces       = req.interfaces;
    lc.foreign          = collections_vector.init[ForeignScope](s.alloc);
    lc.diags            = req.diags;
    lc.tgt              = req.tgt;
    lc.machine          = req.machine;
    lc.scope            = req.module;
    lc.scopes           = nil;
    lc.scope_len        = 0;
    lc.scope_cap        = 0;
    lc.scope_generation = 0;
    lc.scope_top        = 0;
    lc.normal_object    = req.normal_object;
    lc.shared_artifact  = req.shared_artifact;
    lc.debug            = req.debug;
    lc.checks           = req.checks;
    lc.unit             = unit;
    lc.m                = ?unit.m;
    unit.root_project   = session.module_is_root_project(s, req.module.own_module);
    lc.builder          = builder.init(?unit.m, s.alloc, req.machine.target, req.machine.ctx, ?s.sources, req.debug);

    val caps_r: res[comptime.PhaseCapabilities[LowerContext], fail.Fail] = comptime.lowering_capabilities[LowerContext](
        resolve_module_member_const, constant_store_capability,
        resolve_type_comparison_operand,
        type_store, field_offset, zero_capability,
        resolve_type_query,
        resolve_layout_intrinsic,
        resolve_scalar_cast, resolve_scalar_value,
        comptime_ident_is_runtime, comptime_expression, comptime_head);
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    lc.caps = caps_r.ok;

    lc.locals = map.init[resolve.SymbolId, value.Value](s.alloc);
    var built: bool = false;
    fin {
        if (!built) {
            map.dnit[resolve.SymbolId, value.Value](?lc.locals);
            builder.dnit(?lc.builder);
        }
    }

    lc.fn_index   = 0;
    lc.ret_type   = irt.NONE;
    lc.fn_ret_sem = type.TYPE_NIL;

    val res_loops: res[*LoopFrame, A.Error] = A.allocate[LoopFrame](s.alloc, INITIAL_STACK_CAP::usize);
    if (sel res_loops.err) { ret err[fail.Fail].err{fail.refused(res_loops.err)}; }
    lc.loops    = res_loops.ok;
    lc.loop_len = 0;
    lc.loop_cap = INITIAL_STACK_CAP;

    val res_fins: res[*ast_id.StmtId, A.Error] = A.allocate[ast_id.StmtId](s.alloc, INITIAL_STACK_CAP::usize);
    if (sel res_fins.err) {
        A.deallocate[LoopFrame](s.alloc, lc.loops, lc.loop_cap::usize);
        ret err[fail.Fail].err{fail.refused(res_fins.err)};
    }
    lc.fins         = res_fins.ok;
    lc.fin_len      = 0;
    lc.fin_cap      = INITIAL_STACK_CAP;
    lc.borrow_armed = false;
    lc.borrow_eid   = ast_id.EXPR_NIL;
    lc.borrow_now   = false;
    lc.borrow_hit   = false;
    lc.discard_eid  = ast_id.EXPR_NIL;

    lc.instances = req.instances;
    lc.elements  = collections_vector.init[EachElement](s.alloc);
    lc.zeros     = comptime_deep.init(s.alloc);

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;

    lc.debug_types    = map.init[type.TypeId, mirl_debug.Type](s.alloc);
    lc.held           = map.init[type.TypeId, u8](s.alloc);
    lc.debug_pointees = collections_vector.init[DebugPointee](s.alloc);

    built = true;
    ret err[fail.Fail].ok{};
}

# release a lowering context; a nil context holds nothing
pub fun dnit_context(lc: *LowerContext) {
    if (lc == nil) { ret; }
    map.dnit[resolve.SymbolId, value.Value](?lc.locals);
    builder.dnit(?lc.builder);

    if (lc.loops != nil && lc.loop_cap > 0) {
        A.deallocate[LoopFrame](lc.s.alloc, lc.loops, lc.loop_cap::usize);
    }
    if (lc.fins != nil && lc.fin_cap > 0) {
        A.deallocate[ast_id.StmtId](lc.s.alloc, lc.fins, lc.fin_cap::usize);
    }
    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](lc.s.alloc, lc.scopes, lc.scope_cap::usize);
    }
    var fi: usize = 0;
    for (fi < lc.foreign.len) {
        comptime.dnit(lc.foreign.data[fi].ctx);
        A.deallocate[comptime.ComptimeCtx](lc.s.alloc, lc.foreign.data[fi].ctx, 1);
        fi = fi + 1;
    }
    collections_vector.dnit[ForeignScope](?lc.foreign);
    lc.scope     = scope_nil();
    lc.scopes    = nil;
    lc.scope_len = 0;
    lc.scope_cap = 0;
    lc.scope_top = 0;

    lc.loops        = nil;
    lc.loop_len     = 0;
    lc.loop_cap     = 0;
    lc.fins         = nil;
    lc.fin_len      = 0;
    lc.fin_cap      = 0;
    lc.borrow_armed = false;
    lc.borrow_eid   = ast_id.EXPR_NIL;
    lc.borrow_now   = false;
    lc.borrow_hit   = false;
    lc.discard_eid  = ast_id.EXPR_NIL;

    lc.instances = nil;
    collections_vector.dnit[EachElement](?lc.elements);
    comptime_deep.dnit(?lc.zeros);

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;

    map.dnit[type.TypeId, mirl_debug.Type](?lc.debug_types);
    map.dnit[type.TypeId, u8](?lc.held);
    collections_vector.dnit[DebugPointee](?lc.debug_pointees);
}

# the element the innermost `$each` loop variable `name` names
pub fun each_element_of(lc: *LowerContext, name: intern.StrId) opt[EachElement] {
    var i: usize = lc.elements.len;
    for (i > 0) {
        i = i - 1;
        if (intern.str_same(lc.elements.data[i].name, name)) { ret opt[EachElement].some{lc.elements.data[i]}; }
    }
    ret opt[EachElement].none{};
}

# the interface of the module `origin`: the one the lowering module published, or an import's
pub fun interface_of(lc: *LowerContext, origin: session.ModuleId) res[*fe_sema.interface.Interface, fail.Fail] {
    if (module.same(origin, lc.scope.own_module)) { ret res[*fe_sema.interface.Interface, fail.Fail].ok{lc.scope.iface}; }
    if (lc.interfaces.read == nil) {
        val reason: fail.Fail = fail.message("lower: an imported interface requires a reader of interfaces");
        fail.internal(?lc.status, fail.describe(reason));
        ret res[*fe_sema.interface.Interface, fail.Fail].err{reason};
    }
    val acquired: res[*fe_sema.interface.Interface, fail.Fail] = lc.interfaces.read(lc.interfaces.ctx, origin);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?lc.status); }
        or                       { fail.internal(?lc.status, fail.describe(reason)); }
    }
    ret acquired;
}

# a module-level declaration as the interface of its module describes it
pub rec Declared {
    iface:       *fe_sema.interface.Interface;
    declaration: *fe_sema.interface.Declaration;
}

# whether `sym` names a binding a module other than the one in scope declares
pub fun foreign(lc: *LowerContext, sym: *resolve.Symbol) bool {
    ret resolve.foreign_to(lc.s, sym, lc.scope.own_module);
}

# the declaration `sym` names: one of the module in scope by its id, or another module's by
# its kind and canonical name
pub fun declared(lc: *LowerContext, sym: *resolve.Symbol) res[Declared, fail.Fail] {
    if (foreign(lc, sym)) { ret declared_named(lc, resolve.origin_of(lc.s, sym), sym.definition_kind, sym.canon); }
    val iface: *fe_sema.interface.Interface        = lc.scope.iface;
    val own:   opt[*fe_sema.interface.Declaration] = fe_sema.interface.declaration_at(iface, sym.decl);
    if (sel own.none) {
        val reason: fail.Fail = fail.message("lower: symbol has no declaration in its module's interface");
        fail.internal(?lc.status, fail.describe(reason));
        ret res[Declared, fail.Fail].err{reason};
    }
    ret res[Declared, fail.Fail].ok{Declared{iface: iface, declaration: own.some}};
}

# the store of constant values the module with stable id `module_index` publishes in its interface
pub fun constant_store(lc: *LowerContext, module_index: u32) res[*comptime_deep.Store, fail.Fail] {
    val acquired: res[*fe_sema.interface.Interface, fail.Fail] = interface_of(lc, session.module_id_for_stable(lc.s, module.stable_id(module_index)));
    if (sel acquired.err) { ret res[*comptime_deep.Store, fail.Fail].err{acquired.err}; }
    ret res[*comptime_deep.Store, fail.Fail].ok{?acquired.ok.values};
}

fun constant_store_capability(lc: *LowerContext, module_index: u32) res[*comptime_deep.Store, comptime.EvalFail] {
    if (module_index == comptime_deep.SCRATCH_MODULE) { ret res[*comptime_deep.Store, comptime.EvalFail].ok{?lc.zeros}; }
    val store: res[*comptime_deep.Store, fail.Fail] = constant_store(lc, module_index);
    if (sel store.err) {
        ret res[*comptime_deep.Store, comptime.EvalFail].err{comptime.eval_from_fail(store.err, diagnostic_kind.COMPTIME_NOT_CONSTANT,
            "the module that publishes this constant was rejected")};
    }
    ret res[*comptime_deep.Store, comptime.EvalFail].ok{store.ok};
}

# the zero of the type `ty`, which layouts lowering reads are always ready for
fun zero_capability(lc: *LowerContext, ty: u32) res[comptime.CTValue, comptime.EvalFail] {
    val node: res[u32, fail.Fail] = comptime_deep.zero_node(?lc.zeros, ?lc.s.types, lc.tgt.pointer_width, ty::type.TypeId);
    if (sel node.err) {
        ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_from_refusal(node.err, diagnostic_kind.COMPTIME_NOT_CONSTANT, comptime_deep.ZERO_UNKNOWN_MSG)};
    }
    ret comptime_deep.read(?lc.zeros, ?lc.s.interner, comptime_deep.SCRATCH_MODULE, node.ok);
}

# the one declaration of `kind` the module `origin` defines under `canon`
pub fun declared_named(lc: *LowerContext, origin: session.ModuleId, kind: resolve.SymKind, canon: intern.StrId) res[Declared, fail.Fail] {
    val acquired: res[*fe_sema.interface.Interface, fail.Fail] = interface_of(lc, origin);
    if (sel acquired.err) { ret res[Declared, fail.Fail].err{acquired.err}; }
    val found: res[*fe_sema.interface.Declaration, fail.Fail] = fe_sema.interface.declaration_for(acquired.ok, kind, canon);
    if (sel found.err) {
        fail.internal(?lc.status, fail.describe(found.err));
        ret res[Declared, fail.Fail].err{found.err};
    }
    ret res[Declared, fail.Fail].ok{Declared{iface: acquired.ok, declaration: found.ok}};
}

# the scalar a module `val` holds, none when it holds no constant or an aggregate
pub fun declared_scalar(lc: *LowerContext, d: Declared) opt[comptime.CTValue] {
    if (d.declaration.kind != resolve.SYM_VAL || d.declaration.value == fe_sema.interface.NONE) { ret opt[comptime.CTValue].none{}; }
    val n: *comptime_deep.Node = comptime_deep.node_at(?d.iface.values, d.declaration.value);
    if (n.kind != comptime_deep.NODE_SCALAR) { ret opt[comptime.CTValue].none{}; }
    ret opt[comptime.CTValue].some{n.value};
}

pub fun gated_lower_member_const_message(lc: *LowerContext, name: intern.StrId, dep_fqn: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(dep_fqn)) { ret res[str, fail.Fail].err{fail.message("lower: a tuple-dependent constant's module has no stable name")}; }
    ret fail.format_intern(?lc.s.interner, lc.s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        intern.text(?lc.s.interner, name), intern.text(?lc.s.interner, dep_fqn));
}

pub fun report_gate(lc: *LowerContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str) fail.Fail {
    fail.reject(?lc.status);
    val r: err[fail.Fail] = diagnostic.report(lc.diags, k, lc.scope.a.file_id, span, message);
    if (sel r.err) { fail.internal(?lc.status, fail.describe(r.err)); }
    ret fail.phase_failure(lc.status);
}

# the lowering recurses as deep as the input nests, on frames far larger than the checks
# before it, so each walk asks for stack before it descends and refuses the node it stands on
pub fun refuse_nesting(lc: *LowerContext, span: lang_source.Span) fail.Fail {
    ret report_gate(lc, diagnostic_kind.SYNTAX_NESTING_DEPTH, span, NESTING_MSG);
}

# the same refusal of a walk over a type, which has no place of its own, at the node the
# lowering stands on
pub fun refuse_type_nesting(lc: *LowerContext) fail.Fail {
    ret report_here(lc, diagnostic_kind.SYNTAX_NESTING_DEPTH, NESTING_MSG);
}

# a failure a walk with no place of its own returned: a refusal of the input is reported under
# its own kind at the node the lowering stands on; any other failure is the lowering's own
pub fun refuse(lc: *LowerContext, f: fail.Fail) fail.Fail {
    val k: diagnostic_kind.Kind = fail.kind_of(f);
    if (k == diagnostic_kind.NONE || k == diagnostic_kind.COMPILER_INTERNAL) { ret f; }
    ret report_here(lc, k, fail.describe(f));
}

fun report_here(lc: *LowerContext, k: diagnostic_kind.Kind, message: str) fail.Fail {
    val at: lang_source.Location = builder.current_loc(?lc.builder);
    fail.reject(?lc.status);
    val r: err[fail.Fail] = diagnostic.report(lc.diags, k, at.file, at.span, message);
    if (sel r.err) { fail.internal(?lc.status, fail.describe(r.err)); }
    ret fail.phase_failure(lc.status);
}

val NESTING_MSG: str = "input nests deeper than lowering descends; the stack has no room left to go deeper";

pub fun record_eval_result(lc: *LowerContext, r: res[comptime.CTValue, comptime.EvalFail]) {
    if (sel r.ok) { ret; }
    val f: comptime.EvalFail = r.err;
    if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?lc.status, f.message); }
}

# the type node `tid` as name resolution read it, a literal head it split naming the type by its
# path's prefix and the case by the last segment
pub fun type_node(lc: *LowerContext, tid: ast_id.TypeId) res[ast_type.Type, fail.Fail] {
    val result: res[ast_type.Type, fail.Fail] = resolve.type_node(lc.scope.rr, lc.scope.a, lc.scope.source, tid);
    if (sel result.err) { fail.internal(?lc.status, fail.describe(result.err)); }
    ret result;
}

fun comptime_head(lc: *LowerContext, a: *ast.Ast, tid: ast_id.TypeId) res[ast_type.Type, comptime.EvalFail] {
    if (lc == nil || lc.scope.a != a) { ret res[ast_type.Type, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "lowering type belongs to a different parsed owner")}; }
    val result: res[ast_type.Type, fail.Fail] = resolve.type_node(lc.scope.rr, a, lc.scope.source, tid);
    if (sel result.err) {
        ret res[ast_type.Type, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(result.err))};
    }
    ret res[ast_type.Type, comptime.EvalFail].ok{result.ok};
}

pub fun expression(lc: *LowerContext, eid: ast_id.ExprId) res[ast_expr.Expr, fail.Fail] {
    val result: res[ast_expr.Expr, fail.Fail] = resolve.expression(lc.scope.rr, lc.scope.a, eid);
    if (sel result.err) {
        fail.internal(?lc.status, fail.describe(result.err));
        ret result;
    }
    if (result.ok.kind == ast_expr.EXPR_KIND_ERROR) {
        val message: str = "lowering cannot consume a rejected expression";
        fail.internal(?lc.status, message);
        ret res[ast_expr.Expr, fail.Fail].err{fail.message(message)};
    }
    ret result;
}

fun comptime_expression(lc: *LowerContext, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime.EvalFail] {
    if (lc == nil || lc.scope.a != a) { ret res[ast_expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "lowering expression belongs to a different parsed owner")}; }
    val result: res[ast_expr.Expr, fail.Fail] = expression(lc, eid);
    if (sel result.err) {
        ret res[ast_expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(result.err))};
    }
    ret res[ast_expr.Expr, comptime.EvalFail].ok{result.ok};
}

# a lowering capability; a nil context, which the capability check refuses before any call,
# answers as an evaluation with no lowering would
pub fun resolve_module_member_const(lc: *LowerContext, eid: ast_id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val rr: *resolve.ResolveResult = lc.scope.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sid: resolve.SymbolId = rr.expr_resolved[ast_id.expr_index(eid)];
    if (resolve.symbol_is_nil(sid) || sid::u32 >= rr.symbol_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sym: *resolve.Symbol = ?rr.symbols[resolve.symbol_index(sid)];
    if (!foreign(lc, sym) || sym.definition_kind != resolve.SYM_VAL) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val found: res[Declared, fail.Fail] = declared(lc, sym);
    if (sel found.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val scalar: opt[comptime.CTValue] = declared_scalar(lc, found.ok);
    if (sel scalar.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    if (found.ok.declaration.gated && lc.scope.env.build.union_build) {
        val msg_r: res[str, fail.Fail] = gated_lower_member_const_message(lc, sym.name, session.module_fqn(lc.s, resolve.origin_of(lc.s, sym)));
        if (sel msg_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(msg_r.err, diagnostic_kind.CONST_TUPLE_DEPENDENT, "")}; }
        val msg:   str                           = msg_r.ok;
        val e_opt: res[ast_expr.Expr, fail.Fail] = expression(lc, eid);
        var span:  lang_source.Span;
        span.offset = 0;
        span.len    = 0;
        if (sel e_opt.ok) { span = e_opt.ok.span; }
        val f: fail.Fail = report_gate(lc, diagnostic_kind.CONST_TUPLE_DEPENDENT, span, msg);
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(f, diagnostic_kind.CONST_TUPLE_DEPENDENT, msg)};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{scalar};
}

# a lowering capability; a nil context, which the capability check refuses before any call,
# answers as an evaluation with no lowering would
pub fun comptime_ident_is_runtime(lc: *LowerContext, eid: ast_id.ExprId) bool {
    if (lc == nil) { ret false; }
    ret resolve.expr_is_runtime(lc.scope.rr, eid);
}

fun resolve_scalar_value(lc: *LowerContext, eid: ast_id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val ty: type.TypeId = expr_type_of(lc, eid);
    ret comptime.cast_scalar(?lc.s.types, ?lc.s.interner, lc.tgt.pointer_width, lc.tgt.nans, lc.tgt.arch_id, value, ty, ty, false);
}

fun resolve_scalar_cast(lc: *LowerContext, eid: ast_id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val expression_r: res[ast_expr.Expr, fail.Fail] = expression(lc, eid);
    if (sel expression_r.err) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(expression_r.err))}; }
    val node: ast_expr.Expr = expression_r.ok;
    if (node.kind != ast_expr.EXPR_KIND_CAST) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "lowering cast capability requires a cast expression")}; }
    ret comptime.cast_scalar(?lc.s.types, ?lc.s.interner, lc.tgt.pointer_width, lc.tgt.nans, lc.tgt.arch_id, value,
        expr_type_of(lc, node.data.cast.value), type_resolved_of(lc, node.data.cast.ty), node.data.cast.reinterpret);
}

# a lowering capability; a nil context, which the capability check refuses before any call,
# answers as an evaluation with no lowering would
pub fun resolve_type_comparison_operand(lc: *LowerContext, eid: ast_id.ExprId) res[opt[u32], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    val t: type.TypeId = expr_type_of(lc, eid);
    if (type.is_nil(t) || type.is_error(t)) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    val open: res[bool, fail.Fail] = type.mentions_generic_param(?lc.s.types, t);
    if (sel open.err) { ret res[opt[u32], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(open.err))}; }
    if (open.ok) {
        ret res[opt[u32], comptime.EvalFail].err{comptime.eval_error(
            comptime.EVAL_FAIL_NEEDS_INSTANCE, diagnostic_kind.COMPTIME_NEEDS_INSTANCE, comptime.COMPTIME_TYPE_NEEDS_INSTANCE_MSG)};
    }
    ret res[opt[u32], comptime.EvalFail].ok{opt[u32].some{t::u32}};
}

# a lowering capability; a nil context, which the capability check refuses before any call,
# answers as an evaluation with no lowering would
pub fun resolve_type_query(lc: *LowerContext, tid: u32, which: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    ret sema_declared.answer_type_query(lc.s, tid, which);
}

# a lowering capability; a nil context, which the capability check refuses before any call,
# answers as an evaluation with no lowering would
pub fun resolve_layout_intrinsic(lc: *LowerContext, eid: u32) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val e:         ast_id.ExprId = eid::ast_id.ExprId;
    val src:       str           = module_source(lc);
    val is_size:   bool          = intrinsic.is_size_of_call(lc.scope.a, src, e);
    val is_align:  bool          = intrinsic.is_align_of_call(lc.scope.a, src, e);
    val is_len:    bool          = intrinsic.is_length_of_call(lc.scope.a, src, e);
    val is_offset: bool          = intrinsic.is_offset_of_call(lc.scope.a, src, e);
    val is_id:     bool          = intrinsic.is_type_id_call(lc.scope.a, src, e);
    if (!is_size && !is_align && !is_len && !is_offset && !is_id) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }

    val arg: ast_id.ExprId = intrinsic.layout_intrinsic_type_arg(lc.scope.a, e);
    if (ast_id.expr_is_nil(arg)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, "a layout intrinsic takes one type argument")};
    }
    if (is_id) { ret resolve_type_id(lc, substitute_type(lc, expr_type_of(lc, arg))); }
    val op_ty: type.TypeId = type.strip_secret(?lc.s.types, expr_type_of(lc, arg));

    if (is_len) {
        val n_opt: opt[u32] = type.element_count(?lc.s.types, substitute_type(lc, op_ty));
        if (sel n_opt.none) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_LENGTH_OF, "`$length_of` expects a fixed array or a vector")};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(n_opt.some::u64)}};
    }

    val res_ir: res[Type, fail.Fail] = lower_type(lc, op_ty);
    if (sel res_ir.err) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(res_ir.err, diagnostic_kind.LAYOUT_UNAVAILABLE, "layout lowering was rejected")};
    }
    val op_ir: Type = res_ir.ok;

    var n: res[u64, fail.Fail] = irt.size(?lc.builder.layout, op_ir);
    if (is_align) { n = irt.align(?lc.builder.layout, op_ir); }
    if (is_offset) {
        # type checking already tied the member to a field or payload case of the operand type
        val member: opt[u32] = offset_of_member_index(lc, e, substitute_type(lc, op_ty));
        if (sel member.none) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_OFFSET_OF, "`$offset_of` names a member the operand type does not have")};
        }
        n = member_offset(lc, substitute_type(lc, op_ty), op_ir, member.some);
    }
    if (sel n.err) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(n.err, diagnostic_kind.LAYOUT_UNAVAILABLE, "the target lays the type out nowhere")};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(n.ok)}};
}

# the byte offset of field or case `index` of the source type `tid`, lowered as `ir`: a
# record's field, a union's member at zero, or a tag case's payload
pub fun member_offset(lc: *LowerContext, tid: type.TypeId, ir: Type, index: u32) res[u64, fail.Fail] {
    if (type.is_tag(?lc.s.types, type.strip_secret(?lc.s.types, tid))) {
        if (irt.member_count(?lc.m.types, ir) < 2) { ret res[u64, fail.Fail].ok{0}; }
        ret irt.offset(?lc.builder.layout, ir, TAG_PAYLOAD);
    }
    if (irt.is_union(?lc.m.types, ir)) { ret res[u64, fail.Fail].ok{0}; }
    ret irt.offset(?lc.builder.layout, ir, index);
}

# the identity keeps `^`: a secret is a different type from its base
fun resolve_type_id(lc: *LowerContext, tid: type.TypeId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (type.is_nil(tid) || type.is_error(tid)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val open: res[bool, fail.Fail] = type.mentions_generic_param(?lc.s.types, tid);
    if (sel open.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(open.err))}; }
    if (open.ok) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(
            comptime.EVAL_FAIL_NEEDS_INSTANCE, diagnostic_kind.COMPTIME_NEEDS_INSTANCE, comptime.COMPTIME_TYPE_NEEDS_INSTANCE_MSG)};
    }
    val r: res[u64, fail.Fail] = recipe.identity(lc.s, lc.scope.env.target.defs, tid);
    if (sel r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(r.err, diagnostic_kind.COMPTIME_TYPE_ID, "`$type_id` has no identity for this type")}; }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(r.ok)}};
}

fun offset_of_member_index(lc: *LowerContext, call_eid: ast_id.ExprId, owner: type.TypeId) opt[u32] {
    val c_opt: res[ast_expr.Expr, fail.Fail] = expression(lc, call_eid);
    if (sel c_opt.err) { ret opt[u32].none{}; }
    val c: ast_expr.Expr = c_opt.ok;
    if (c.kind != ast_expr.EXPR_KIND_CALL || c.data.call.args_len < 2) { ret opt[u32].none{}; }
    val m_opt: res[ast_expr.Expr, fail.Fail] = expression(lc, lc.scope.a.expr_ids.data[c.data.call.args_start + 1]);
    if (sel m_opt.err)                             { ret opt[u32].none{}; }
    if (m_opt.ok.kind != ast_expr.EXPR_KIND_IDENT) { ret opt[u32].none{}; }
    val r_name: res[intern.StrId, A.Error] = intern.range_add(?lc.s.interner, module_source(lc), m_opt.ok.data.ident.tok.offset, m_opt.ok.data.ident.tok.len);
    if (sel r_name.err) { ret opt[u32].none{}; }
    val name: intern.StrId = r_name.ok;
    val n:    u32          = type.field_count(?lc.s.types, owner);
    var i:    u32          = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(?lc.s.types, owner, i);
        if (sel fa.some && intern.str_same(fa.some.name, name)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# a field descriptor's offset, from the layout lowering gives the owning type
pub fun field_offset(lc: *LowerContext, owner: u32, index: u32) res[opt[comptime.CTValue], comptime.EvalFail] {
    val res_ir: res[Type, fail.Fail] = lower_type(lc, owner::type.TypeId);
    if (sel res_ir.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(res_ir.err, diagnostic_kind.LAYOUT_UNAVAILABLE, "layout lowering was rejected")}; }
    val off: res[u64, fail.Fail] = member_offset(lc, owner::type.TypeId, res_ir.ok, index);
    if (sel off.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(off.err, diagnostic_kind.LAYOUT_UNAVAILABLE, "the target lays the type out nowhere")}; }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(off.ok)}};
}

# the type store a comptime evaluation during lowering reads
pub fun type_store(lc: *LowerContext) *type.TypeInterner {
    ret ?lc.s.types;
}

# a pointer's debug type whose pointee waits for the module's other debug types
rec DebugPointee {
    key: str;
    ty:  type.TypeId;
}

pub fun begin_function(lc: *LowerContext, fn_index: u32, ret_type: Type) {
    map.clear[resolve.SymbolId, value.Value](?lc.locals);
    lc.loop_len   = 0;
    lc.fin_len    = 0;
    lc.fn_index   = fn_index;
    lc.ret_type   = ret_type;
    lc.fn_ret_sem = type.TYPE_NIL;
    lc.fn_shown   = lang_source.Span{offset: 0, len: 0};

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;
}

pub fun bind_local(lc: *LowerContext, sym: resolve.SymbolId, v: value.Value) err[fail.Fail] {
    val res_bind: res[bool, A.Error] = map.insert[resolve.SymbolId, value.Value](?lc.locals, sym, v);
    if (sel res_bind.err) { ret err[fail.Fail].err{fail.refused(res_bind.err)}; }
    ret err[fail.Fail].ok{};
}

pub fun lookup_local(lc: *LowerContext, sym: resolve.SymbolId) opt[value.Value] {
    val res_get: opt[*value.Value] = map.get[resolve.SymbolId, value.Value](?lc.locals, ?sym);
    if (sel res_get.some) { ret opt[value.Value].some{@res_get.some}; }
    ret opt[value.Value].none{};
}

pub fun push_loop(lc: *LowerContext, header: id.Block, exit: id.Block) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[LoopFrame](lc.s.alloc, ?lc.loops, ?lc.loop_cap, lc.loop_len::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    var f: LoopFrame;
    f.header              = header;
    f.exit                = exit;
    f.fin_depth           = lc.fin_len;
    lc.loops[lc.loop_len] = f;
    lc.loop_len           = lc.loop_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun pop_loop(lc: *LowerContext) {
    if (lc.loop_len > 0) { lc.loop_len = lc.loop_len - 1; }
}

pub fun current_loop(lc: *LowerContext) *LoopFrame {
    if (lc.loop_len == 0) { ret nil; }
    ret ?lc.loops[lc.loop_len - 1];
}

pub fun push_fin(lc: *LowerContext, body: ast_id.StmtId) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[ast_id.StmtId](lc.s.alloc, ?lc.fins, ?lc.fin_cap, lc.fin_len::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    lc.fins[lc.fin_len] = body;
    lc.fin_len          = lc.fin_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun fin_count(lc: *LowerContext) u32 {
    ret lc.fin_len;
}

pub fun fin_at(lc: *LowerContext, i: u32) ast_id.StmtId {
    if (i >= lc.fin_len) { ret ast_id.STMT_NIL; }
    ret lc.fins[i];
}

pub fun pop_fins_to(lc: *LowerContext, mark: u32) {
    if (mark < lc.fin_len) { lc.fin_len = mark; }
}

# a tag lowers to a structure of its discriminant and, when a case holds a payload, the
# union of the payloads, which every payload starts at
pub val TAG_DISCRIMINANT: u32 = 0;
pub val TAG_PAYLOAD:      u32 = 1;

# the pointer type, which every address is held in
pub fun ptr_or_none(lc: *LowerContext) Type {
    ret builder.ptr_type(?lc.builder);
}

# the byte type, which a global another module defines is declared as when only its
# address is taken
pub fun byte_type(lc: *LowerContext) Type {
    ret builder.int_type(?lc.builder, 8);
}

# the first refusal the builder met, which every builder call after it skips
pub fun builder_state(lc: *LowerContext) err[fail.Fail] {
    if (!builder.failed(?lc.builder)) { ret err[fail.Fail].ok{}; }
    ret builder.done(?lc.builder);
}

pub fun int_type(lc: *LowerContext, bits: u32) res[Type, fail.Fail] {
    ret irt.int(?lc.m.types, bits);
}

pub fun ptr_type(lc: *LowerContext) res[Type, fail.Fail] {
    ret irt.ptr(?lc.m.types);
}

# the mirl type a value of the source type `tid` is held in
pub fun lower_type(lc: *LowerContext, tid: type.TypeId) res[Type, fail.Fail] {
    if (type.is_nil(tid))  { ret res[Type, fail.Fail].ok{irt.NONE}; }
    if (stack.exhausted()) { ret res[Type, fail.Fail].err{refuse_type_nesting(lc)}; }

    val rtid: type.TypeId = substitute_type(lc, tid);

    val fields: err[fail.Fail] = subst.ensure_fields(lc.s, rtid);
    if (sel fields.err)              { ret res[Type, fail.Fail].err{refuse(lc, fields.err)}; }
    if (sel lc.status.kind.internal) { ret res[Type, fail.Fail].err{fail.phase_failure(lc.status)}; }

    val t_opt: opt[*type.Type] = type.get(?lc.s.types, rtid);
    if (sel t_opt.none) { ret res[Type, fail.Fail].ok{irt.NONE}; }
    val t: *type.Type    = t_opt.some;
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_SECRET) { ret lower_type(lc, t.data.secret.base); }

    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT)   { ret irt.int(?lc.m.types, d.bits); }
    if (d.class == type.PRIM_CLASS_FLOAT) { ret irt.float(?lc.m.types, d.bits); }
    if (d.class == type.PRIM_CLASS_PTR)   { ret irt.ptr(?lc.m.types); }
    if (k == type.TYPE_POINTER)           { ret irt.ptr(?lc.m.types); }
    if (k == type.TYPE_FUN)               { ret irt.ptr(?lc.m.types); }

    if (k == type.TYPE_ARRAY) {
        val res_base: res[Type, fail.Fail] = lower_type(lc, t.data.array.base);
        if (sel res_base.err) { ret res_base; }
        ret irt.array(?lc.m.types, res_base.ok, t.data.array.count::u64);
    }

    if (k == type.TYPE_VECTOR) {
        val ed:   type.PrimDesc        = type.prim_desc(t.data.vector.element);
        var lane: res[Type, fail.Fail] = irt.int(?lc.m.types, ed.bits);
        if (ed.class == type.PRIM_CLASS_FLOAT) { lane = irt.float(?lc.m.types, ed.bits); }
        if (sel lane.err)                      { ret lane; }
        ret irt.vector(?lc.m.types, lane.ok, t.data.vector.lanes);
    }

    if (k == type.TYPE_HANDLE) { ret lower_handle_type(lc, t); }
    if (k == type.TYPE_ABI)    { ret lower_abi_type(lc, t); }

    if (k == type.TYPE_TAG || ((k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE)
        && type.is_tag(?lc.s.types, rtid))) {
        ret lower_tag(lc, rtid);
    }

    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE) {
        ret lower_nominal(lc, rtid, type.is_union(?lc.s.types, rtid));
    }

    ret irt.ptr(?lc.m.types);
}

# an opaque abi type: its size in elements as wide as its alignment, so the target lays it
# out at both
fun lower_abi_type(lc: *LowerContext, t: *type.Type) res[Type, fail.Fail] {
    var unit: u32 = t.data.abi.align;
    if (unit == 0 || unit > 16) { unit = 1; }
    for (unit > 1 && t.data.abi.size % unit != 0) { unit = unit / 2; }
    val elem: res[Type, fail.Fail] = irt.int(?lc.m.types, unit * 8);
    if (sel elem.err) { ret elem; }
    val arr: res[Type, fail.Fail] = irt.array(?lc.m.types, elem.ok, (t.data.abi.size / unit)::u64);
    if (sel arr.err) { ret arr; }
    var field: Type = arr.ok;
    ret irt.structure(?lc.m.types, ?field, 1);
}

# a target handle, named by its family and the constructor the target's definition table
# gives it
fun lower_handle_type(lc: *LowerContext, t: *type.Type) res[Type, fail.Fail] {
    val td: *target_definition.Type = target_definition.type_by_tag(lc.tgt.defs, t.data.handle.ctor);
    if (td == nil) { ret res[Type, fail.Fail].err{fail.message("lower: a handle type names a constructor the target does not define")}; }
    val kind: res[str, fail.Fail] = fail.format(lc.s.alloc, "spirv.{}", td.name);
    if (sel kind.err) { ret res[Type, fail.Fail].err{kind.err}; }
    val made: res[Type, fail.Fail] = irt.handle(?lc.m.types, View{data: kind.ok, len: str_len(kind.ok)});
    A.deallocate[char](lc.s.alloc, kind.ok, str_len(kind.ok) + 1);
    ret made;
}

# the cases of a tag that hold a payload, in case order, as the payload union's members
fun tag_payloads(lc: *LowerContext, tid: type.TypeId, out: *collections_vector.Vector[Type]) err[fail.Fail] {
    val cases_len: u32 = type.field_count(?lc.s.types, tid);
    var i:         u32 = 0;
    for (i < cases_len) {
        val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (sel fe_opt.none) { ret err[fail.Fail].err{fail.message("lower: the case table of a tag is missing an in-range case")}; }
        if (!type.is_nil(fe_opt.some.ty)) {
            val res_case: res[Type, fail.Fail] = lower_type(lc, fe_opt.some.ty);
            if (sel res_case.err) { ret err[fail.Fail].err{res_case.err}; }
            val pushed: res[usize, A.Error] = collections_vector.push[Type](out, res_case.ok);
            if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
        }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

# whether case `i` of the tag `tid` holds a payload
pub fun tag_case_has_payload(lc: *LowerContext, tid: type.TypeId, i: u32) bool {
    val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, type.strip_secret(?lc.s.types, substitute_type(lc, tid)), i);
    if (sel fe_opt.none) { ret false; }
    ret !type.is_nil(fe_opt.some.ty);
}

# the member of the payload union case `i` of the tag `tid` is laid out as
pub fun tag_payload_member(lc: *LowerContext, tid: type.TypeId, i: u32) u32 {
    val base: type.TypeId = type.strip_secret(?lc.s.types, substitute_type(lc, tid));
    var n:    u32         = 0;
    var c:    u32         = 0;
    for (c < i) {
        val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, base, c);
        if (sel fe_opt.some && !type.is_nil(fe_opt.some.ty)) { n = n + 1; }
        c = c + 1;
    }
    ret n;
}

# the integer a tag's discriminant is held in
pub fun tag_disc_type(lc: *LowerContext, tid: type.TypeId) res[Type, fail.Fail] {
    val disc_bytes: u32 = type.tag_discriminator_bytes(?lc.s.types, type.strip_secret(?lc.s.types, substitute_type(lc, tid)));
    if (disc_bytes == 0) { ret res[Type, fail.Fail].err{fail.message("lower: a tag has no declared discriminator type")}; }
    ret irt.int(?lc.m.types, disc_bytes * 8);
}

fun lower_tag(lc: *LowerContext, tid: type.TypeId) res[Type, fail.Fail] {
    val disc: res[Type, fail.Fail] = tag_disc_type(lc, tid);
    if (sel disc.err)                            { ret disc; }
    if (type.field_count(?lc.s.types, tid) == 0) { ret res[Type, fail.Fail].err{fail.message("lower: a tag has no cases")}; }

    var payloads: collections_vector.Vector[Type] = collections_vector.init[Type](lc.s.alloc);
    fin { collections_vector.dnit[Type](?payloads); }
    val walked: err[fail.Fail] = tag_payloads(lc, tid, ?payloads);
    if (sel walked.err) { ret res[Type, fail.Fail].err{walked.err}; }

    var members: [2]Type;
    members[0] = disc.ok;
    if (payloads.len == 0) { ret irt.structure(?lc.m.types, ?members[0], 1); }
    val u: res[Type, fail.Fail] = irt.union_of(?lc.m.types, payloads.data, payloads.len::u32);
    if (sel u.err) { ret u; }
    members[1] = u.ok;
    ret irt.structure(?lc.m.types, ?members[0], 2);
}

# a record or union: its fields in order, a packed record's at the offsets that pack them
fun lower_nominal(lc: *LowerContext, tid: type.TypeId, is_union: bool) res[Type, fail.Fail] {
    val dec:        type.Decoration = type.decoration_of(?lc.s.types, tid);
    val fields_len: u32             = type.field_count(?lc.s.types, tid);
    if (fields_len == 0) { ret irt.structure(?lc.m.types, nil, 0); }

    val res_buf: res[*Type, A.Error] = A.allocate[Type](lc.s.alloc, fields_len::usize);
    if (sel res_buf.err) { ret res[Type, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *Type = res_buf.ok;
    fin { A.deallocate[Type](lc.s.alloc, buf, fields_len::usize); }

    var i: u32 = 0;
    for (i < fields_len) {
        val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (sel fe_opt.none) { ret res[Type, fail.Fail].err{fail.message("lower: the field table of a nominal type is missing an in-range field")}; }
        val res_field: res[Type, fail.Fail] = lower_type(lc, fe_opt.some.ty);
        if (sel res_field.err) { ret res_field; }
        buf[i] = res_field.ok;
        i      = i + 1;
    }

    if (is_union)    { ret irt.union_of(?lc.m.types, buf, fields_len); }
    if (!dec.packed) { ret irt.structure(?lc.m.types, buf, fields_len); }

    val res_off: res[*u64, A.Error] = A.allocate[u64](lc.s.alloc, fields_len::usize);
    if (sel res_off.err) { ret res[Type, fail.Fail].err{fail.refused(res_off.err)}; }
    val offsets: *u64 = res_off.ok;
    fin { A.deallocate[u64](lc.s.alloc, offsets, fields_len::usize); }
    var at: u64 = 0;
    i = 0;
    for (i < fields_len) {
        offsets[i] = at;
        val n: res[u64, fail.Fail] = irt.size(?lc.builder.layout, buf[i]);
        if (sel n.err) { ret res[Type, fail.Fail].err{n.err}; }
        at = at + n.ok;
        i  = i + 1;
    }
    ret irt.structure_at(?lc.m.types, buf, offsets, fields_len);
}

# the alignment a value of the source type `tid`, held in `ir`, is stored at: a decorated
# record's, else the target's
pub fun storage_align(lc: *LowerContext, tid: type.TypeId, ir: Type) u64 {
    val base: type.TypeId     = type.strip_secret(?lc.s.types, substitute_type(lc, tid));
    val t:    opt[*type.Type] = type.get(?lc.s.types, base);
    if (sel t.some) {
        val k: type.TypeKind = t.some.kind;
        if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG || k == type.TYPE_INSTANCE) {
            val dec: type.Decoration = type.decoration_of(?lc.s.types, base);
            if (dec.align != 0) { ret dec.align::u64; }
            if (dec.packed)     { ret 1; }
        }
    }
    ret builder.align_of(?lc.builder, ir);
}

# a stack slot for a value of the source type `tid`, held in `ir`
pub fun slot_for(lc: *LowerContext, tid: type.TypeId, ir: Type) res[value.Value, fail.Fail] {
    ret builder.alloca_aligned(?lc.builder, ir, storage_align(lc, tid, ir));
}

# the debug type a debug record names for source type `tid`, as substituted for the code
# being lowered; none when this lowering keeps no debug information
pub fun debug_type_of(lc: *LowerContext, tid: type.TypeId) res[opt[mirl_debug.Type], fail.Fail] {
    val none: res[opt[mirl_debug.Type], fail.Fail] = res[opt[mirl_debug.Type], fail.Fail].ok{opt[mirl_debug.Type].none{}};
    if (!lc.debug) { ret none; }
    val rtid: type.TypeId = type.strip_secret(?lc.s.types, substitute_type(lc, tid));
    if (type.is_nil(rtid) || type.is_error(rtid)) { ret none; }
    val made: res[mirl_debug.Type, fail.Fail] = debug_describe(lc, rtid);
    if (sel made.err) { ret res[opt[mirl_debug.Type], fail.Fail].err{made.err}; }
    ret res[opt[mirl_debug.Type], fail.Fail].ok{opt[mirl_debug.Type].some{made.ok}};
}

# the key a source type is described under in every module: its identity
fun debug_key(lc: *LowerContext, tid: type.TypeId) res[str, fail.Fail] {
    val ident: res[u64, fail.Fail] = recipe.identity(lc.s, lc.tgt.defs, tid);
    if (sel ident.err) { ret res[str, fail.Fail].err{ident.err}; }
    val text: res[str, fail.Fail] = fail.format(lc.s.alloc, "mach.{}", ident.ok);
    if (sel text.err) { ret text; }
    val kept: res[intern.StrId, A.Error] = intern.add(?lc.s.interner, text.ok);
    A.deallocate[char](lc.s.alloc, text.ok, str_len(text.ok) + 1);
    if (sel kept.err) { ret res[str, fail.Fail].err{fail.refused(kept.err)}; }
    ret res[str, fail.Fail].ok{intern.text(?lc.s.interner, kept.ok)};
}

fun view_of(s: str) View {
    if (s == nil) { ret View{data: nil, len: 0}; }
    ret View{data: s, len: str_len(s)};
}

fun debug_failed(e: mirl_debug.Error) fail.Fail {
    if (sel e.alloc) { ret fail.refused(e.alloc); }
    ret fail.message("lower: mirl's debug table refused a type lowering described");
}

fun declare_debug(lc: *LowerContext, tid: type.TypeId, e: mirl_debug.Entry) res[mirl_debug.Declared, fail.Fail] {
    val got: res[mirl_debug.Declared, mirl_debug.Error] = mirl_debug.declare(?lc.m.debug, ?lc.m.types, e);
    if (sel got.err) { ret res[mirl_debug.Declared, fail.Fail].err{debug_failed(got.err)}; }
    var ty: mirl_debug.Type = mirl_debug.Type{index: 0};
    if (sel got.ok.fresh) { ty = got.ok.fresh; }
    or                    { ty = got.ok.known; }
    val keyed: res[bool, A.Error] = map.insert[type.TypeId, mirl_debug.Type](?lc.debug_types, tid, ty);
    if (sel keyed.err) { ret res[mirl_debug.Declared, fail.Fail].err{fail.refused(keyed.err)}; }
    ret res[mirl_debug.Declared, fail.Fail].ok{got.ok};
}

fun define_debug(lc: *LowerContext, ty: mirl_debug.Type, shape: mirl_debug.Shape) err[fail.Fail] {
    val got: err[mirl_debug.Error] = mirl_debug.define(?lc.m.debug, ?lc.m.types, ty, shape);
    if (sel got.err) { ret err[fail.Fail].err{debug_failed(got.err)}; }
    ret err[fail.Fail].ok{};
}

# a described type's source name, its spelling as a program writes it: an instance with
# its arguments, so a debugger shows the instance it is
fun debug_name(lc: *LowerContext, t: *type.Type, tid: type.TypeId) res[View, fail.Fail] {
    val k: type.TypeKind = t.kind;
    if (k == type.TYPE_INSTANCE || k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_TAG) {
        val named: res[str, fail.Fail] = typename.type_to_str(lc.s, tid);
        if (sel named.err) { ret res[View, fail.Fail].err{named.err}; }
        val kept: res[intern.StrId, A.Error] = intern.add(?lc.s.interner, named.ok);
        typename.type_str_free(lc.s, named.ok);
        if (sel kept.err) { ret res[View, fail.Fail].err{fail.refused(kept.err)}; }
        ret res[View, fail.Fail].ok{view_of(intern.text(?lc.s.interner, kept.ok))};
    }
    ret res[View, fail.Fail].ok{view_of(type.prim_name(k))};
}

# describe the source type `tid` in the module's debug table, once
fun debug_describe(lc: *LowerContext, tid: type.TypeId) res[mirl_debug.Type, fail.Fail] {
    val found: opt[*mirl_debug.Type] = map.get[type.TypeId, mirl_debug.Type](?lc.debug_types, ?tid);
    if (sel found.some)    { ret res[mirl_debug.Type, fail.Fail].ok{@found.some}; }
    if (stack.exhausted()) { ret res[mirl_debug.Type, fail.Fail].err{refuse_type_nesting(lc)}; }

    val to: opt[*type.Type] = type.get(?lc.s.types, tid);
    if (sel to.none) { ret res[mirl_debug.Type, fail.Fail].err{fail.message("lower: a described type is not in the type table")}; }
    val t: *type.Type    = to.some;
    val k: type.TypeKind = t.kind;

    val key: res[str, fail.Fail] = debug_key(lc, tid);
    if (sel key.err) { ret res[mirl_debug.Type, fail.Fail].err{key.err}; }
    val name: res[View, fail.Fail] = debug_name(lc, t, tid);
    if (sel name.err) { ret res[mirl_debug.Type, fail.Fail].err{name.err}; }
    val layout: res[Type, fail.Fail] = lower_type(lc, tid);
    if (sel layout.err) { ret res[mirl_debug.Type, fail.Fail].err{layout.err}; }

    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class != type.PRIM_CLASS_NONE || k == type.TYPE_FUN) {
        var enc:   mirl_debug.Encoding = mirl_debug.Encoding.unsigned{};
        var width: u32                 = d.bits;
        if (d.class == type.PRIM_CLASS_FLOAT) { enc = mirl_debug.Encoding.float{}; }
        or (d.class == type.PRIM_CLASS_PTR || k == type.TYPE_FUN) {
            enc   = mirl_debug.Encoding.address{};
            width = (builder.size_of(?lc.builder, layout.ok) * 8)::u32;
        }
        or (d.signed)   { enc = mirl_debug.Encoding.signed{}; }
        if (width == 0) { width = 8; }
        val made: res[mirl_debug.Declared, fail.Fail] = declare_debug(lc, tid, mirl_debug.Entry{key: view_of(key.ok), name: name.ok,
            head: mirl_debug.Head.base{mirl_debug.Base{encoding: enc, width: width}}});
        if (sel made.err) { ret res[mirl_debug.Type, fail.Fail].err{made.err}; }
        ret res[mirl_debug.Type, fail.Fail].ok{declared_type(made.ok)};
    }

    if (k == type.TYPE_POINTER) {
        val pointee: type.TypeId         = type.strip_secret(?lc.s.types, t.data.pointer.base);
        val pkey:    res[str, fail.Fail] = debug_key(lc, pointee);
        if (sel pkey.err) { ret res[mirl_debug.Type, fail.Fail].err{pkey.err}; }
        val made: res[mirl_debug.Declared, fail.Fail] = declare_debug(lc, tid, mirl_debug.Entry{key: view_of(key.ok), name: view_of(nil),
            head: mirl_debug.Head.pointer{view_of(pkey.ok)}});
        if (sel made.err) { ret res[mirl_debug.Type, fail.Fail].err{made.err}; }
        val waiting: err[fail.Fail] = debug_pointee_note(lc, pkey.ok, pointee);
        if (sel waiting.err) { ret res[mirl_debug.Type, fail.Fail].err{waiting.err}; }
        ret res[mirl_debug.Type, fail.Fail].ok{declared_type(made.ok)};
    }

    if (k == type.TYPE_ARRAY || k == type.TYPE_VECTOR) {
        var elem_tid: type.TypeId = t.data.array.base;
        var count:    u64         = t.data.array.count::u64;
        if (k == type.TYPE_VECTOR) {
            val lane: opt[type.TypeId] = type.prim(?lc.s.types, t.data.vector.element);
            if (sel lane.none) { ret res[mirl_debug.Type, fail.Fail].err{fail.message("lower: a vector's lane type is no primitive")}; }
            elem_tid = lane.some;
            count    = t.data.vector.lanes::u64;
        }
        val made: res[mirl_debug.Declared, fail.Fail] = declare_debug(lc, tid, mirl_debug.Entry{key: view_of(key.ok), name: view_of(nil), head: mirl_debug.Head.array{}});
        if (sel made.err)      { ret res[mirl_debug.Type, fail.Fail].err{made.err}; }
        if (sel made.ok.known) { ret res[mirl_debug.Type, fail.Fail].ok{made.ok.known}; }
        val elem: res[mirl_debug.Type, fail.Fail] = debug_describe(lc, type.strip_secret(?lc.s.types, elem_tid));
        if (sel elem.err) { ret elem; }
        val defined: err[fail.Fail] = define_debug(lc, made.ok.fresh, mirl_debug.Shape.array{mirl_debug.Array{element: elem.ok, count: count}});
        if (sel defined.err) { ret res[mirl_debug.Type, fail.Fail].err{defined.err}; }
        ret res[mirl_debug.Type, fail.Fail].ok{made.ok.fresh};
    }

    if (k != type.TYPE_REC && k != type.TYPE_UNI && k != type.TYPE_TAG && k != type.TYPE_INSTANCE) {
        val made: res[mirl_debug.Declared, fail.Fail] = declare_debug(lc, tid, mirl_debug.Entry{key: view_of(key.ok), name: name.ok,
            head: mirl_debug.Head.base{mirl_debug.Base{encoding: mirl_debug.Encoding.unsigned{}, width: 8}}});
        if (sel made.err) { ret res[mirl_debug.Type, fail.Fail].err{made.err}; }
        ret res[mirl_debug.Type, fail.Fail].ok{declared_type(made.ok)};
    }

    val is_tag:   bool            = type.is_tag(?lc.s.types, tid);
    val is_union: bool            = !is_tag && type.is_union(?lc.s.types, tid);
    var head:     mirl_debug.Head = mirl_debug.Head.structure{layout.ok};
    if (is_tag)   { head = mirl_debug.Head.tagged{layout.ok}; }
    or (is_union) { head = mirl_debug.Head.union{layout.ok}; }
    val made: res[mirl_debug.Declared, fail.Fail] = declare_debug(lc, tid, mirl_debug.Entry{key: view_of(key.ok), name: name.ok, head: head});
    if (sel made.err)      { ret res[mirl_debug.Type, fail.Fail].err{made.err}; }
    if (sel made.ok.known) { ret res[mirl_debug.Type, fail.Fail].ok{made.ok.known}; }
    val self: mirl_debug.Type = made.ok.fresh;

    val n: u32 = type.field_count(?lc.s.types, tid);
    if (is_tag) {
        var cases: collections_vector.Vector[mirl_debug.Case] = collections_vector.init[mirl_debug.Case](lc.s.alloc);
        fin { collections_vector.dnit[mirl_debug.Case](?cases); }
        val disc_tid: type.TypeId                     = type.tag_discriminator(?lc.s.types, tid);
        val disc:     res[mirl_debug.Type, fail.Fail] = debug_describe(lc, disc_tid);
        if (sel disc.err) { ret disc; }
        var i: u32 = 0;
        for (i < n) {
            val fe: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
            if (sel fe.none) { ret res[mirl_debug.Type, fail.Fail].err{fail.message("lower: the case table of a described tag is missing an in-range case")}; }
            var payload: opt[mirl_debug.Member] = opt[mirl_debug.Member].none{};
            if (!type.is_nil(fe.some.ty)) {
                val pt: res[mirl_debug.Type, fail.Fail] = debug_describe(lc, type.strip_secret(?lc.s.types, fe.some.ty));
                if (sel pt.err) { ret pt; }
                payload = opt[mirl_debug.Member].some{mirl_debug.Member{name: view_of(intern.text(?lc.s.interner, fe.some.name)), type: pt.ok, field: tag_payload_member(lc, tid, i)}};
            }
            val pushed: res[usize, A.Error] = collections_vector.push[mirl_debug.Case](?cases, mirl_debug.Case{name: view_of(intern.text(?lc.s.interner, fe.some.name)), value: i::u64, payload: payload});
            if (sel pushed.err) { ret res[mirl_debug.Type, fail.Fail].err{fail.refused(pushed.err)}; }
            i = i + 1;
        }
        val shape: mirl_debug.Shape = mirl_debug.Shape.tagged{mirl_debug.Tagged{
            discriminant: mirl_debug.Member{name: view_of("tag"), type: disc.ok, field: TAG_DISCRIMINANT},
            payload:      TAG_PAYLOAD,
            cases:        Slice[mirl_debug.Case]{data: cases.data, size: cases.len},
        }};
        val defined: err[fail.Fail] = define_debug(lc, self, shape);
        if (sel defined.err) { ret res[mirl_debug.Type, fail.Fail].err{defined.err}; }
        ret res[mirl_debug.Type, fail.Fail].ok{self};
    }

    var members: collections_vector.Vector[mirl_debug.Member] = collections_vector.init[mirl_debug.Member](lc.s.alloc);
    fin { collections_vector.dnit[mirl_debug.Member](?members); }
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (sel fe.none) { ret res[mirl_debug.Type, fail.Fail].err{fail.message("lower: the field table of a described type is missing an in-range field")}; }
        val ft: res[mirl_debug.Type, fail.Fail] = debug_describe(lc, type.strip_secret(?lc.s.types, fe.some.ty));
        if (sel ft.err) { ret ft; }
        val pushed: res[usize, A.Error] = collections_vector.push[mirl_debug.Member](?members, mirl_debug.Member{name: view_of(intern.text(?lc.s.interner, fe.some.name)), type: ft.ok, field: i});
        if (sel pushed.err) { ret res[mirl_debug.Type, fail.Fail].err{fail.refused(pushed.err)}; }
        i = i + 1;
    }
    var shape: mirl_debug.Shape = mirl_debug.Shape.structure{Slice[mirl_debug.Member]{data: members.data, size: members.len}};
    if (is_union) { shape = mirl_debug.Shape.union{Slice[mirl_debug.Member]{data: members.data, size: members.len}}; }
    val defined: err[fail.Fail] = define_debug(lc, self, shape);
    if (sel defined.err) { ret res[mirl_debug.Type, fail.Fail].err{defined.err}; }
    ret res[mirl_debug.Type, fail.Fail].ok{self};
}

fun declared_type(d: mirl_debug.Declared) mirl_debug.Type {
    if (sel d.fresh) { ret d.fresh; }
    ret d.known;
}

# a pointer names its pointee by key, which is described once the module's types are
fun debug_pointee_note(lc: *LowerContext, key: str, pointee: type.TypeId) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[DebugPointee](?lc.debug_pointees, DebugPointee{key: key, ty: pointee});
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# describe every pointee left waiting, then link the table. an instance of an expansive
# generic the module describes no value of stays undescribed past its pointer, since such
# a generic has unboundedly many instances behind its pointers, and is described opaque
pub fun debug_types_finish(lc: *LowerContext) err[fail.Fail] {
    if (!lc.debug) { ret err[fail.Fail].ok{}; }
    var i: usize = 0;
    for (i < lc.debug_pointees.len) {
        val waiting: DebugPointee         = lc.debug_pointees.data[i];
        val bounded: res[bool, fail.Fail] = debug_pointee_bounded(lc, waiting.ty);
        if (sel bounded.err) { ret err[fail.Fail].err{bounded.err}; }
        if (bounded.ok) {
            val described: res[mirl_debug.Type, fail.Fail] = debug_describe(lc, waiting.ty);
            if (sel described.err) { ret err[fail.Fail].err{described.err}; }
        }
        i = i + 1;
    }
    for (true) {
        val open: opt[View] = mirl_debug.pending(?lc.m.debug);
        if (sel open.none) { brk; }
        val opaque: res[mirl_debug.Declared, mirl_debug.Error] = mirl_debug.declare(?lc.m.debug, ?lc.m.types,
            mirl_debug.Entry{key: open.some, name: view_of(nil), head: mirl_debug.Head.base{mirl_debug.Base{encoding: mirl_debug.Encoding.unsigned{}, width: 8}}});
        if (sel opaque.err) { ret err[fail.Fail].err{debug_failed(opaque.err)}; }
    }
    val linked: err[mirl_debug.Error] = mirl_debug.finish(?lc.m.debug);
    if (sel linked.err) { ret err[fail.Fail].err{debug_failed(linked.err)}; }
    ret err[fail.Fail].ok{};
}

# whether every expansive instance `tid` holds by value is one this module describes
fun debug_pointee_bounded(lc: *LowerContext, tid: type.TypeId) res[bool, fail.Fail] {
    val base: type.TypeId     = type.strip_secret(?lc.s.types, tid);
    val to:   opt[*type.Type] = type.get(?lc.s.types, base);
    if (sel to.none) { ret res[bool, fail.Fail].ok{true}; }
    val k: type.TypeKind = to.some.kind;
    if (k == type.TYPE_ARRAY)                                                                      { ret debug_pointee_bounded(lc, to.some.data.array.base); }
    if (k != type.TYPE_REC && k != type.TYPE_UNI && k != type.TYPE_TAG && k != type.TYPE_INSTANCE) { ret res[bool, fail.Fail].ok{true}; }
    if (k == type.TYPE_INSTANCE) {
        val described: opt[*mirl_debug.Type] = map.get[type.TypeId, mirl_debug.Type](?lc.debug_types, ?base);
        if (sel described.some) { ret res[bool, fail.Fail].ok{true}; }
        val unbounded: res[bool, fail.Fail] = expansive.instance_is(?lc.s.types, ?lc.s.type_facts, base);
        if (sel unbounded.err) { ret res[bool, fail.Fail].err{refuse(lc, unbounded.err)}; }
        if (unbounded.ok)      { ret res[bool, fail.Fail].ok{false}; }
        val fields: err[fail.Fail] = subst.ensure_fields(lc.s, base);
        if (sel fields.err) { ret res[bool, fail.Fail].err{refuse(lc, fields.err)}; }
    }
    val n: u32 = type.field_count(?lc.s.types, base);
    var i: u32 = 0;
    for (i < n) {
        val fe: opt[*type.FieldEntry] = type.field_at(?lc.s.types, base, i);
        if (sel fe.some) {
            val held: res[bool, fail.Fail] = debug_pointee_bounded(lc, fe.some.ty);
            if (sel held.err) { ret held; }
            if (!held.ok)     { ret held; }
        }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{true};
}

# whether the block being built already ends
pub fun block_terminated(lc: *LowerContext) bool {
    ret builder.terminated(?lc.builder);
}

pub fun is_void_ir(lc: *LowerContext, tid: Type) bool {
    ret irt.is_none(tid);
}

# an expression's type inside an instance's scope is the instance's, never the template's:
# sema records the template's and every type decision here is made against this instance
# an expression's type as the frame the code is read through decided it, else the template's
# under the instance's substitution
pub fun expr_type_of(lc: *LowerContext, eid: ast_id.ExprId) type.TypeId {
    if (ast_id.expr_is_nil(eid))                               { ret type.TYPE_NIL; }
    if (ast_id.expr_index(eid)::usize >= lc.scope.a.exprs.len) { ret type.TYPE_NIL; }
    if (lc.scope.frame != fe_sema.instance.NONE && lc.instances != nil) {
        val framed: opt[type.TypeId] = fe_sema.instance.expr_type_at(lc.instances, lc.scope.frame, eid);
        if (sel framed.some) { ret framed.some; }
    }
    ret substitute_type(lc, lc.scope.typing.expr_type[ast_id.expr_index(eid)]);
}

pub fun expr_float_width(lc: *LowerContext, eid: ast_id.ExprId) float.FloatWidth {
    ret float_width_of_type(lc, expr_type_of(lc, eid));
}

fun float_width_of_type(lc: *LowerContext, tid: type.TypeId) float.FloatWidth {
    if (type.is_nil(tid)) { ret float.FLOAT_W_NONE; }
    val ct:    type.TypeId     = type.strip_secret(?lc.s.types, substitute_type(lc, tid));
    val opt_t: opt[*type.Type] = type.get(?lc.s.types, ct);
    if (sel opt_t.none) { ret float.FLOAT_W_NONE; }
    ret type.float_width_of(opt_t.some.kind);
}

pub fun expr_is_secret(lc: *LowerContext, eid: ast_id.ExprId) bool {
    ret type_is_secret(lc, expr_type_of(lc, eid));
}

pub fun type_is_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (type.is_nil(tid)) { ret false; }
    ret type.is_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun type_contains_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (type.is_nil(tid) || type.is_error(tid)) { ret false; }
    ret held_secret(lc, substitute_type(lc, tid));
}

# whether a value of `tid` holds a secret in its own storage, asked of the type once; a
# walk that cannot answer fails the lowering and reads as secret
fun held_secret(lc: *LowerContext, tid: type.TypeId) bool {
    val known: opt[*u8] = map.get[type.TypeId, u8](?lc.held, ?tid);
    if (sel known.some) { ret @known.some == 1; }
    val held: res[bool, fail.Fail] = type.contains_secret(?lc.s.types, tid);
    if (sel held.err) {
        fail.internal(?lc.status, fail.describe(held.err));
        ret true;
    }
    var mark: u8 = 2;
    if (held.ok) { mark = 1; }
    val kept: res[bool, A.Error] = map.insert[type.TypeId, u8](?lc.held, tid, mark);
    if (sel kept.err) { fail.internal(?lc.status, "lower: the secrecy memo could not grow"); }
    ret held.ok;
}

pub fun type_carries_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (type.is_nil(tid)) { ret false; }
    ret type.carries_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun substitute_type(lc: *LowerContext, tid: type.TypeId) type.TypeId {
    if (lc.scope.subst == nil || lc.scope.subst_len == 0) { ret tid; }
    ret recover_type(lc, subst.substitute(lc.s, tid, ?lc.scope.subst_owner, lc.scope.subst, lc.scope.subst_len));
}

pub fun type_resolved_of(lc: *LowerContext, tid: ast_id.TypeId) type.TypeId {
    if (ast_id.type_is_nil(tid))                               { ret type.TYPE_NIL; }
    if (ast_id.type_index(tid)::usize >= lc.scope.a.types.len) { ret type.TYPE_NIL; }
    ret substitute_type(lc, lc.scope.typing.type_resolved_ty[ast_id.type_index(tid)]);
}

pub fun decl_type_of(lc: *LowerContext, did: ast_id.DeclId) type.TypeId {
    if (ast_id.decl_is_nil(did))                               { ret type.TYPE_NIL; }
    if (ast_id.decl_index(did)::usize >= lc.scope.a.decls.len) { ret type.TYPE_NIL; }
    if (lc.scope.frame != fe_sema.instance.NONE && lc.instances != nil) {
        val framed: opt[type.TypeId] = fe_sema.instance.decl_type_at(lc.instances, lc.scope.frame, did);
        if (sel framed.some) { ret framed.some; }
    }
    ret substitute_type(lc, lc.scope.typing.decl_type[ast_id.decl_index(did)]);
}

# the instance sema decided the call or generic reference `eid` names, in the frame the
# code is read through
pub fun instance_of_call(lc: *LowerContext, eid: ast_id.ExprId) res[*fe_sema.instance.Instance, fail.Fail] {
    if (lc.scope.frame == fe_sema.instance.NONE || lc.instances == nil) {
        ret res[*fe_sema.instance.Instance, fail.Fail].err{fail.message("lower: an instantiating call read outside any typing frame")};
    }
    val id: opt[u32] = fe_sema.instance.call_at(lc.instances, lc.scope.frame, eid);
    if (sel id.none) { ret res[*fe_sema.instance.Instance, fail.Fail].err{fail.message("lower: sema recorded no instance for an instantiating call")}; }
    ret res[*fe_sema.instance.Instance, fail.Fail].ok{fe_sema.instance.at(lc.instances, id.some)};
}

# the symbol an instance is emitted and referenced under
pub fun instance_link_name(lc: *LowerContext, item: *fe_sema.instance.Instance) res[intern.StrId, fail.Fail] {
    val fqn:   intern.StrId                 = session.module_fqn(lc.s, item.origin);
    var named: res[intern.StrId, fail.Fail] = res[intern.StrId, fail.Fail].err{fail.message("lower: an instance has no name")};
    if (item.kind == fe_sema.instance.KIND_VALUE) { named = mangle.value_instance_name(lc.s, fqn, item.canon, item.values, item.value_len); }
    or (item.kind == fe_sema.instance.KIND_PACK) {
        named = mangle.pack_instance_name(lc.s, lc.scope.env.target.defs, fqn, item.canon, item.args, item.arg_len, item.pack, item.pack_len);
    }
    or                 { named = mangle.instance_name(lc.s, lc.scope.env.target.defs, fqn, item.canon, item.args, item.arg_len); }
    if (sel named.err) { ret res[intern.StrId, fail.Fail].err{refuse(lc, named.err)}; }
    ret named;
}

# the verdict sema gave a statement gate in the frame the code is read through
pub fun gate_of(lc: *LowerContext, cond: ast_id.ExprId) opt[bool] {
    if (lc.scope.frame == fe_sema.instance.NONE || lc.instances == nil) { ret opt[bool].none{}; }
    ret fe_sema.instance.gate_at(lc.instances, lc.scope.frame, cond);
}

# the published value of the array sema typed the `$each` at `stmt` over, in the frame the code
# is read through
pub fun each_array(lc: *LowerContext, stmt: ast_id.StmtId) res[comptime.CTValue, fail.Fail] {
    if (lc.scope.frame == fe_sema.instance.NONE || lc.instances == nil) {
        ret res[comptime.CTValue, fail.Fail].err{fail.message("lower: a `$each` over an array read outside any typing frame")};
    }
    val found: opt[comptime.CTValue] = fe_sema.instance.each_at(lc.instances, lc.scope.frame, stmt);
    if (sel found.none) { ret res[comptime.CTValue, fail.Fail].err{fail.message("lower: sema recorded no array for a `$each`")}; }
    ret res[comptime.CTValue, fail.Fail].ok{found.some};
}

# the frame of iteration `index` of the `$each` at `stmt` under the current frame
pub fun iteration_frame(lc: *LowerContext, stmt: ast_id.StmtId, index: u32) res[u32, fail.Fail] {
    if (lc.scope.frame == fe_sema.instance.NONE || lc.instances == nil) { ret res[u32, fail.Fail].ok{fe_sema.instance.NONE}; }
    val f: opt[u32] = fe_sema.instance.iteration_at(lc.instances, lc.scope.frame, stmt, index);
    if (sel f.none) { ret res[u32, fail.Fail].err{fail.message("lower: sema typed no frame for an `$each` iteration")}; }
    ret res[u32, fail.Fail].ok{f.some};
}

pub fun decl_ret_sem(lc: *LowerContext, did: ast_id.DeclId) type.TypeId {
    val fn_ty: type.TypeId     = decl_type_of(lc, did);
    val to:    opt[*type.Type] = type.get(?lc.s.types, fn_ty);
    if (sel to.none) { ret type.TYPE_NIL; }
    val t: *type.Type = to.some;
    if (t.kind != type.TYPE_FUN) { ret type.TYPE_NIL; }
    ret t.data.fn.ret_type;
}

pub fun function_return_ir(lc: *LowerContext, did: ast_id.DeclId) res[Type, fail.Fail] {
    val sem:      type.TypeId     = decl_type_of(lc, did);
    val opt_type: opt[*type.Type] = type.get(?lc.s.types, sem);
    if (sel opt_type.none) { ret res[Type, fail.Fail].ok{irt.NONE}; }
    val t: *type.Type = opt_type.some;
    if (t.kind != type.TYPE_FUN) { ret res[Type, fail.Fail].ok{irt.NONE}; }
    ret lower_type(lc, t.data.fn.ret_type);
}

# a function's signature: its parameters and result, each narrow integer stating the
# extension its source type's signedness gives it
pub rec FnSig {
    sig: Type;
}

# the signature of the function `did` declares
pub fun lower_fn_sig(lc: *LowerContext, did: ast_id.DeclId) res[FnSig, fail.Fail] {
    ret fn_sig_of_type(lc, decl_type_of(lc, did));
}

# the signature a value of the source function type `tid` is called through
pub fun fn_sig_of_type(lc: *LowerContext, tid: type.TypeId) res[FnSig, fail.Fail] {
    val t_opt: opt[*type.Type] = type.get(?lc.s.types, type.strip_secret(?lc.s.types, substitute_type(lc, tid)));
    if (sel t_opt.none) { ret res[FnSig, fail.Fail].err{fail.message("lower: a signature asked of a type that is no function")}; }
    val fn: *type.Type = t_opt.some;
    if (fn.kind != type.TYPE_FUN) { ret res[FnSig, fail.Fail].err{fail.message("lower: a signature asked of a type that is no function")}; }
    ret signature_of(lc, fn.data.fn.ret_type, fn, fn.data.fn.params_len, nil, 0);
}

# the extension a convention gives an integer narrower than a register: its declared
# signedness. a bool is a byte read unsigned
pub fun ext_of(lc: *LowerContext, sem: type.TypeId) types.Extension {
    val t_opt: opt[*type.Type] = type.get(?lc.s.types, type.strip_secret(?lc.s.types, substitute_type(lc, sem)));
    if (sel t_opt.none) { ret types.Extension.none{}; }
    val d: type.PrimDesc = type.prim_desc(t_opt.some.kind);
    if (d.class != type.PRIM_CLASS_INT || d.bits >= 64) { ret types.Extension.none{}; }
    if (d.signed)                                       { ret types.Extension.sext{}; }
    ret types.Extension.zext{};
}

# a signature of `fixed` parameters of the function type `fn` and then the `extra` types a
# pack expands to, returning `ret_sem`
fun signature_of(lc: *LowerContext, ret_sem: type.TypeId, fn: *type.Type, fixed: u32, extra: *type.TypeId, extra_len: u32) res[FnSig, fail.Fail] {
    val total:  u32                                        = fixed + extra_len;
    var params: collections_vector.Vector[Type]            = collections_vector.init[Type](lc.s.alloc);
    var exts:   collections_vector.Vector[types.Extension] = collections_vector.init[types.Extension](lc.s.alloc);
    fin {
        collections_vector.dnit[Type](?params);
        collections_vector.dnit[types.Extension](?exts);
    }
    var i: u32 = 0;
    for (i < total) {
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed) {
            val po: opt[type.TypeId] = type.get_param(?lc.s.types, fn.data.fn.params_start + i);
            if (sel po.some) { p_sem = po.some; }
        }
        or { p_sem = extra[i - fixed]; }
        val res_param: res[Type, fail.Fail] = lower_type(lc, p_sem);
        if (sel res_param.err) { ret res[FnSig, fail.Fail].err{res_param.err}; }
        val pushed: res[usize, A.Error] = collections_vector.push[Type](?params, res_param.ok);
        if (sel pushed.err) { ret res[FnSig, fail.Fail].err{fail.refused(pushed.err)}; }
        val extended: res[usize, A.Error] = collections_vector.push[types.Extension](?exts, ext_of(lc, p_sem));
        if (sel extended.err) { ret res[FnSig, fail.Fail].err{fail.refused(extended.err)}; }
        i = i + 1;
    }
    val res_ret: res[Type, fail.Fail] = lower_type(lc, ret_sem);
    if (sel res_ret.err) { ret res[FnSig, fail.Fail].err{res_ret.err}; }
    var result:     Type            = res_ret.ok;
    var result_ext: types.Extension = ext_of(lc, ret_sem);
    var rn:         u32             = 1;
    if (irt.is_none(result)) { rn = 0; }
    val sig: res[Type, fail.Fail] = irt.signature(?lc.m.types, params.data, exts.data, total, ?result, ?result_ext, rn);
    if (sel sig.err) { ret res[FnSig, fail.Fail].err{sig.err}; }
    ret res[FnSig, fail.Fail].ok{FnSig{sig: sig.ok}};
}

# the signature of a pack instance of the function typed `fn_ty`: its fixed parameters, then
# one per element of the pack
pub fun pack_instance_sig(lc: *LowerContext, fn_ty: type.TypeId, elems: *type.TypeId, elem_len: u32) res[FnSig, fail.Fail] {
    val t_opt: opt[*type.Type] = type.get(?lc.s.types, type.strip_secret(?lc.s.types, substitute_type(lc, fn_ty)));
    if (sel t_opt.none) { ret res[FnSig, fail.Fail].err{fail.message("lower: a pack instance's signature is not a function with a pack")}; }
    val fn: *type.Type = t_opt.some;
    if (fn.kind != type.TYPE_FUN || fn.data.fn.params_len == 0) {
        ret res[FnSig, fail.Fail].err{fail.message("lower: a pack instance's signature is not a function with a pack")};
    }
    ret signature_of(lc, fn.data.fn.ret_type, fn, fn.data.fn.params_len - 1, elems, elem_len);
}

# the signature an instance is referenced under: the one sema settled when it asked for it
pub fun instance_ref_sig(lc: *LowerContext, item: *fe_sema.instance.Instance) res[FnSig, fail.Fail] {
    if (item.kind == fe_sema.instance.KIND_PACK) { ret pack_instance_sig(lc, item.sig, item.pack, item.pack_len); }
    ret fn_sig_of_type(lc, item.sig);
}

pub fun expr_symbol_of(lc: *LowerContext, eid: ast_id.ExprId) resolve.SymbolId {
    if (ast_id.expr_is_nil(eid))                                 { ret resolve.SYMBOL_NIL; }
    if (ast_id.expr_index(eid)::usize >= lc.scope.rr.expr_count) { ret resolve.SYMBOL_NIL; }
    val sid: resolve.SymbolId = lc.scope.rr.expr_resolved[ast_id.expr_index(eid)];
    if (resolve.symbol_is_rejected(sid)) {
        fail.reject(?lc.status);
        ret resolve.SYMBOL_NIL;
    }
    ret sid;
}

# the source of the module in scope, read when the scope was made
pub fun module_source(lc: *LowerContext) str {
    ret lc.scope.source;
}

# the source text `a` was parsed from
fun ast_source(s: *session.Session, a: *ast.Ast) res[str, fail.Fail] {
    val sf: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel sf.none) { ret res[str, fail.Fail].err{fail.message("lower: a parsed module's source is not registered")}; }
    ret res[str, fail.Fail].ok{sf.some.text};
}

# the operation of the selected target an `#[op]` function stands for, NO_OP_SET for any other
pub fun declared_op(lc: *LowerContext, d: Declared, out_op: *u32) u32 {
    if (intern.str_is_nil(d.declaration.op_set)) { ret target_definition.NO_OP_SET; }
    val set_s: str                   = intern.text(?lc.s.interner, d.declaration.op_set);
    val nam_s: str                   = intern.text(?lc.s.interner, d.declaration.op_name);
    val od:    *target_definition.Op = target_definition.op_of_region(lc.tgt.defs, set_s, 0, str_len(set_s), nam_s, 0, str_len(nam_s));
    if (od == nil) { ret target_definition.NO_OP_SET; }
    @out_op = od.opcode;
    ret od.set_tag;
}

# a source variable named at `name_span` begins: one held in a stack slot is bound to the
# slot, which describes it wherever it lives, and any other, a parameter, to its value
# from here on
pub fun emit_dbg_birth(lc: *LowerContext, name_span: lang_source.Span, ty_sem: type.TypeId, param: opt[u32], val_v: value.Value,
    slot: opt[value.Value]) err[fail.Fail] {
    val debug_type: res[opt[mirl_debug.Type], fail.Fail] = debug_type_of(lc, substitute_type(lc, ty_sem));
    if (sel debug_type.err)     { ret err[fail.Fail].err{debug_type.err}; }
    if (sel debug_type.ok.none) { ret err[fail.Fail].ok{}; }
    val declared: opt[mirl_debug.Location] = builder.location_of(?lc.builder, lang_source.location(lc.scope.a.file_id, name_span));
    if (sel declared.none) { ret err[fail.Fail].ok{}; }
    val name:  View                                      = View{data: (?lc.scope.source[name_span.offset])::str, len: name_span.len};
    val bound: res[mirl_debug.Binding, mirl_debug.Error] = mirl_debug.bind(?lc.m.debug,
        mirl_debug.Variable{name: name, type: debug_type.ok.some, declared: declared.some, parameter: param});
    if (sel bound.err) { ret err[fail.Fail].err{debug_failed(bound.err)}; }
    if (sel slot.some) { ret builder.bind_storage(?lc.builder, slot.some, bound.ok); }
    builder.bind_value(?lc.builder, bound.ok, val_v);
    ret builder.after_err_pub(?lc.builder);
}

pub fun symbol_of(lc: *LowerContext, sid: resolve.SymbolId) opt[*resolve.Symbol] {
    if (resolve.symbol_is_nil(sid))                            { ret opt[*resolve.Symbol].none{}; }
    if (resolve.symbol_index(sid) >= lc.scope.rr.symbol_count) { ret opt[*resolve.Symbol].none{}; }
    ret opt[*resolve.Symbol].some{?lc.scope.rr.symbols[resolve.symbol_index(sid)]};
}

fun view_text(lc: *LowerContext, name: intern.StrId) View {
    ret view_of(intern.text(?lc.s.interner, name));
}

# the linkage of a symbol another module defines, or a definition every module sees
pub fun external_linkage() Linkage {
    ret Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT};
}

# add a function to the module with what mach declares of it
pub fun add_function(lc: *LowerContext, data: FunctionData, info: FnInfo) res[u32, fail.Fail] {
    val f: id.Function = mbuild.function(?lc.builder.mb, data);
    if (builder.failed(?lc.builder)) {
        val why: err[fail.Fail] = builder.done(?lc.builder);
        if (sel why.err) { ret res[u32, fail.Fail].err{why.err}; }
    }
    for (lc.unit.fns.len < f.index::usize) {
        val gap: res[usize, A.Error] = collections_vector.push[FnInfo](?lc.unit.fns, FnInfo{name: intern.STR_NIL, line: 0, test: false, noreturn: false, defined: false});
        if (sel gap.err) { ret res[u32, fail.Fail].err{fail.refused(gap.err)}; }
    }
    val pushed: res[usize, A.Error] = collections_vector.push[FnInfo](?lc.unit.fns, info);
    if (sel pushed.err) { ret res[u32, fail.Fail].err{fail.refused(pushed.err)}; }
    ret res[u32, fail.Fail].ok{f.index};
}

# the function of the module named `name`, none when no function is
pub fun function_named(lc: *LowerContext, name: intern.StrId) opt[u32] {
    val found: opt[id.Symbol] = mirl_module.find(lc.m, view_text(lc, name));
    if (sel found.some) {
        if (sel found.some.function) { ret opt[u32].some{found.some.function.index}; }
    }
    ret opt[u32].none{};
}

# the global of the module named `name`, none when no global is
pub fun global_named(lc: *LowerContext, name: intern.StrId) opt[u32] {
    val found: opt[id.Symbol] = mirl_module.find(lc.m, view_text(lc, name));
    if (sel found.some) {
        if (sel found.some.global) { ret opt[u32].some{found.some.global.index}; }
    }
    ret opt[u32].none{};
}

# put `name` on the shared library's export surface
pub fun export_add(lc: *LowerContext, name: intern.StrId) err[fail.Fail] {
    val pushed: res[usize, A.Error] = collections_vector.push[intern.StrId](?lc.unit.exports, name);
    if (sel pushed.err) { ret err[fail.Fail].err{fail.refused(pushed.err)}; }
    ret err[fail.Fail].ok{};
}

# the module's definition of a function: a reference earlier in the module declared it,
# and the definition takes the declaration's place
pub fun define_function(lc: *LowerContext, data: FunctionData, info: FnInfo) res[u32, fail.Fail] {
    val existing: opt[u32] = function_named(lc, info.name);
    if (sel existing.none) { ret add_function(lc, data, info); }
    val f: u32 = existing.some;
    if (lc.unit.fns.data[f].defined) { ret res[u32, fail.Fail].err{fail.message("lower: a function is defined twice in one module")}; }
    val node: *mirl_function.Node = ?lc.m.functions.data[f];
    node.data.signature     = data.signature;
    node.data.linkage       = data.linkage;
    node.data.constant_time = data.constant_time;
    lc.unit.fns.data[f]     = info;
    ret res[u32, fail.Fail].ok{f};
}

# the module's definition of a global, in place of a declaration a reference made
pub fun define_global(lc: *LowerContext, g: GlobalData) res[u32, fail.Fail] {
    val found: opt[id.Symbol] = mirl_module.find(lc.m, g.name);
    if (sel found.none)         { ret add_global(lc, g); }
    if (!sel found.some.global) { ret res[u32, fail.Fail].err{fail.message("lower: a global shares its symbol with a function of the module")}; }
    val at:   u32               = found.some.global.index;
    val node: *mirl_global.Node = ?lc.m.globals.data[at];
    if (sel node.data.initial.some) { ret res[u32, fail.Fail].err{fail.message("lower: a global is defined twice in one module")}; }
    node.data.type      = g.type;
    node.data.alignment = g.alignment;
    node.data.tls       = g.tls;
    node.data.linkage   = g.linkage;
    node.data.constant  = g.constant;
    if (sel g.section.some) {
        val named: res[View, A.Error] = mirl_slice.copy_view(lc.m.a, g.section.some.name);
        if (sel named.err) { ret res[u32, fail.Fail].err{fail.refused(named.err)}; }
        node.data.section = opt[Section].some{Section{name: named.ok, kind: g.section.some.kind}};
    }
    if (sel g.initial.some) {
        val given: err[mirl_module.Error] = mirl_module.initialize(lc.m, id.Global{index: at}, g.initial.some);
        if (sel given.err) { ret res[u32, fail.Fail].err{fail.message("lower: mirl refused a global's initial value")}; }
    }
    ret res[u32, fail.Fail].ok{at};
}

# the module's function `name`, declared here when another module defines it
pub fun ensure_extern_function(lc: *LowerContext, name: intern.StrId, sig: FnSig) res[u32, fail.Fail] {
    val existing: opt[u32] = function_named(lc, name);
    if (sel existing.some) { ret res[u32, fail.Fail].ok{existing.some}; }
    val shared: opt[u32] = global_named(lc, name);
    if (sel shared.some) {
        ret res[u32, fail.Fail].err{fail.message("lower: a function shares its symbol with a global of the module")};
    }
    ret add_function(lc, FunctionData{name: view_text(lc, name), signature: sig.sig, linkage: external_linkage(), constant_time: false},
        FnInfo{name: name, line: 0, test: false, noreturn: false, defined: false});
}

# the module's global `name` of `ty`, declared here when another module defines it
pub fun ensure_extern_global(lc: *LowerContext, name: intern.StrId, ty: Type) res[u32, fail.Fail] {
    val existing: opt[u32] = global_named(lc, name);
    if (sel existing.some) { ret res[u32, fail.Fail].ok{existing.some}; }
    var g: GlobalData;
    g.name      = view_text(lc, name);
    g.type      = ty;
    g.initial   = opt[id.Constant].none{};
    g.alignment = opt[u64].none{};
    g.section   = opt[Section].none{};
    g.tls       = opt[mirl_global.Tls].none{};
    g.linkage   = external_linkage();
    g.constant  = false;
    ret add_global(lc, g);
}

pub fun add_global(lc: *LowerContext, g: GlobalData) res[u32, fail.Fail] {
    val made: id.Global = mbuild.global(?lc.builder.mb, g);
    if (builder.failed(?lc.builder)) {
        val why: err[fail.Fail] = builder.done(?lc.builder);
        if (sel why.err) { ret res[u32, fail.Fail].err{why.err}; }
    }
    ret res[u32, fail.Fail].ok{made.index};
}

# a read-only global of the module's own holding the constant `v`, whose address is the value
pub fun constant_global(lc: *LowerContext, v: value.Value) res[value.Value, fail.Fail] {
    val res_name: res[intern.StrId, fail.Fail] = anon_global_name(lc, lc.m.globals.len::u32);
    if (sel res_name.err) { ret res[value.Value, fail.Fail].err{res_name.err}; }
    val c:     id.Constant    = builder.constant_of(?lc.builder, v);
    val built: err[fail.Fail] = builder_state(lc);
    if (sel built.err) { ret res[value.Value, fail.Fail].err{built.err}; }
    var g: GlobalData;
    g.name      = view_text(lc, res_name.ok);
    g.type      = v.ty;
    g.initial   = opt[id.Constant].some{c};
    g.alignment = opt[u64].none{};
    g.section   = opt[Section].none{};
    g.tls       = opt[mirl_global.Tls].none{};
    g.linkage   = Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT};
    g.constant  = true;
    val added: res[u32, fail.Fail] = add_global(lc, g);
    if (sel added.err) { ret res[value.Value, fail.Fail].err{added.err}; }
    ret res[value.Value, fail.Fail].ok{value.global(added.ok, builder.ptr_type(?lc.builder))};
}

fun anon_global_name(lc: *LowerContext, n: u32) res[intern.StrId, fail.Fail] {
    var buf: [16]u8;
    buf[0] = '.';
    buf[1] = 'L';
    buf[2] = 'c';
    buf[3] = '.';
    var len: usize = 4;
    var d:   u32   = 0;
    for (d < 8) {
        val shift: u32 = (7 - d) * 4;
        val nib:   u32 = (n >> shift) & 0xF;
        var c:     u8  = nib::u8 + 0x30;
        if (nib > 9) { c = nib::u8 - 10 + 0x61; }
        buf[len] = c;
        len      = len + 1;
        d        = d + 1;
    }
    val r_1824: res[intern.StrId, A.Error] = intern.bytes_add(?lc.s.interner, (?buf[0])::str, len);
    if (sel r_1824.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_1824.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_1824.ok};
}

test scope_leave__refuses_a_stale_or_out_of_order_mark {
    var alloc:  A.Allocator;
    val r_1891: err[A.Error] = page.make(?alloc);
    if (sel r_1891.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var lc: LowerContext;
    lc.status           = fail.accepted();
    lc.s                = ?s;
    lc.diags            = ?s.diags;
    lc.scopes           = nil;
    lc.scope_len        = 0;
    lc.scope_cap        = 0;
    lc.scope_generation = 0;
    lc.scope_top        = 0;

    var home: ModuleScope = scope_nil();
    home.fqn = intern.str_id(11);
    lc.scope = home;

    var first: ModuleScope = scope_nil();
    first.fqn = intern.str_id(22);
    var second: ModuleScope = scope_nil();
    second.fqn = intern.str_id(33);

    var code: i32 = 0;

    val m1r: res[ScopeMark, fail.Fail] = scope_enter(?lc, first);
    if (sel m1r.err) { ret 1; }
    val m1: ScopeMark = m1r.ok;
    if (!intern.str_same(lc.scope.fqn, intern.str_id(22))) { code = 1; }

    val m2r: res[ScopeMark, fail.Fail] = scope_enter(?lc, second);
    if (sel m2r.err) { ret 1; }
    val m2: ScopeMark = m2r.ok;
    if (!intern.str_same(lc.scope.fqn, intern.str_id(33))) { code = 1; }

    val r_1927: err[fail.Fail] = scope_leave(?lc, m1);
    if (sel r_1927.ok)                                     { code = 1; }
    if (!intern.str_same(lc.scope.fqn, intern.str_id(33))) { code = 1; }
    if (lc.scope_len != 2)                                 { code = 1; }

    val r_1931: err[fail.Fail] = scope_leave(?lc, m2);
    if (sel r_1931.err)                                    { code = 1; }
    if (!intern.str_same(lc.scope.fqn, intern.str_id(22))) { code = 1; }

    val r_1934: err[fail.Fail] = scope_leave(?lc, m2);
    if (sel r_1934.ok) { code = 1; }

    val r_1936: err[fail.Fail] = scope_leave(?lc, m1);
    if (sel r_1936.err)                                    { code = 1; }
    if (!intern.str_same(lc.scope.fqn, intern.str_id(11))) { code = 1; }
    if (lc.scope_len != 0)                                 { code = 1; }

    var other: LowerContext;
    other.status = fail.accepted();
    other.s      = ?s;
    val r_1943: err[fail.Fail] = scope_leave(?other, m1);
    if (sel r_1943.ok) { code = 1; }

    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](?alloc, lc.scopes, lc.scope_cap::usize);
    }
    ret code;
}

#[testing]
fun fixture_interface(raw: ptr, origin: session.ModuleId) res[*fe_sema.interface.Interface, fail.Fail] {
    ret res[*fe_sema.interface.Interface, fail.Fail].err{fail.message("fixture reads no interface")};
}

#[testing]
rec ScopeFixture {
    expr: ast_expr.Expr;
    decl: ast_decl.Decl;
    a1:   ast.Ast;
    a2:   ast.Ast;
    sm1:  fe_sema.SemaResult;
    sm2:  fe_sema.SemaResult;
    rr1:  resolve.ResolveResult;
    rr2:  resolve.ResolveResult;
    cc1:  comptime.ComptimeCtx;
    mid:  session.ModuleId;
    fqn:  intern.StrId;
}

# one module's tree, resolution and typing of one expression and one declaration, beside a tree
# and products of none
#[testing]
fun scope_fixture(s: *session.Session, f: *ScopeFixture) bool {
    val file: res[lang_source.FileId, lang_source.Error] = lang_source.add(?s.sources, "m.mach", "");
    if (sel file.err) { ret false; }
    f.a1.incarnation = 1;
    f.a1.file_id     = file.ok;
    f.a1.exprs       = ast.table_over[ast_expr.Expr](?f.expr, 1);
    f.a1.decls       = ast.table_over[ast_decl.Decl](?f.decl, 1);
    f.rr1.status     = fail.accepted();
    f.rr1.expr_count = 1;
    f.rr1.decl_count = 1;
    f.sm1.status     = fail.accepted();
    f.sm1.expr_count = 1;
    f.sm1.decl_count = 1;
    f.mid            = module.id(0);
    f.fqn            = intern.str_id(7);
    val ri: err[fail.Fail] = session.register_module_identity(s, f.mid, f.fqn, module.stable_id(5));
    ret sel ri.ok;
}

test module_scope__refuses_a_piece_that_belongs_to_another_module {
    var alloc:  A.Allocator;
    val r_1961: err[A.Error] = page.make(?alloc);
    if (sel r_1961.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var f: ScopeFixture;
    if (!scope_fixture(?s, ?f)) { ret 1; }

    var code: i32 = 0;

    f.cc1.env.target.pointer_width = 99;
    val good: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a1, f.fqn, ?f.sm1, ?f.rr1, ?f.cc1);
    if (sel good.err) { ret 1; }
    val sc: ModuleScope = good.ok;
    if (sc.env.target.pointer_width != 99) { code = 1; }
    f.cc1.env.target.pointer_width = 12;
    if (sc.env.target.pointer_width != 99) { code = 1; }
    if (sc.iface != ?f.sm1.interface)      { code = 1; }

    val r_2008: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a2, f.fqn, ?f.sm1, ?f.rr1, ?f.cc1);
    if (sel r_2008.ok) { code = 1; }
    val r_2009: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a1, intern.str_id(8), ?f.sm1, ?f.rr1, ?f.cc1);
    if (sel r_2009.ok) { code = 1; }
    val r_2010: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a1, f.fqn, ?f.sm2, ?f.rr1, ?f.cc1);
    if (sel r_2010.ok) { code = 1; }
    val r_2011: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a1, f.fqn, ?f.sm1, ?f.rr2, ?f.cc1);
    if (sel r_2011.ok) { code = 1; }
    val r_2013: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, nil, f.fqn, ?f.sm1, ?f.rr1, ?f.cc1);
    if (sel r_2013.ok) { code = 1; }
    val r_2014: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a1, f.fqn, nil, ?f.rr1, ?f.cc1);
    if (sel r_2014.ok) { code = 1; }
    val r_2015: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a1, f.fqn, ?f.sm1, nil, ?f.cc1);
    if (sel r_2015.ok) { code = 1; }
    val r_2016: res[ModuleScope, fail.Fail] = module_scope(?s, f.mid, ?f.a1, f.fqn, ?f.sm1, ?f.rr1, nil);
    if (sel r_2016.ok) { code = 1; }
    val r_2017: res[ModuleScope, fail.Fail] = module_scope(?s, module.id(1), ?f.a1, f.fqn, ?f.sm1, ?f.rr1, ?f.cc1);
    if (sel r_2017.ok) { code = 1; }

    ret code;
}

test request__refuses_a_module_product_that_does_not_correspond {
    var alloc:  A.Allocator;
    val r_2024: err[A.Error] = page.make(?alloc);
    if (sel r_2024.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }
    var f: ScopeFixture;
    if (!scope_fixture(?s, ?f)) { ret 1; }
    var tgt:     resolved.Target = resolved.Target{};
    var machine: Machine;
    machine.target = nil;
    machine.ctx    = opt[*core_state.Context].none{};
    var l: linkage.Linkage = linkage.init(?alloc);
    fin { linkage.dnit(?l); }
    val reader: fe_sema.interface.Reader = fe_sema.interface.Reader{ctx: nil, read: fixture_interface};
    val unread: fe_sema.interface.Reader = fe_sema.interface.Reader{ctx: nil, read: nil};

    var code: i32 = 0;

    val good: res[LowerRequest, fail.Fail] = request(?s, ?l, ?tgt, ?machine, ?alloc, ?f.a1, f.fqn, f.mid, ?f.sm1, ?f.rr1, ?f.cc1, nil, false, false, true, ?s.diags, reader);
    if (sel good.err) { ret 1; }
    val req: LowerRequest = good.ok;
    if (req.module.a != ?f.a1 || !module.same(req.module.own_module, f.mid)) { code = 1; }
    if (req.instances != ?f.sm1.instances)                                   { code = 1; }

    val r_2066: res[LowerRequest, fail.Fail] = request(?s, ?l, nil, ?machine, ?alloc, ?f.a1, f.fqn, f.mid, ?f.sm1, ?f.rr1, ?f.cc1, nil, false, false, true, ?s.diags, reader);
    if (sel r_2066.ok) { code = 1; }
    val r_2067: res[LowerRequest, fail.Fail] = request(?s, ?l, ?tgt, ?machine, nil, ?f.a1, f.fqn, f.mid, ?f.sm1, ?f.rr1, ?f.cc1, nil, false, false, true, ?s.diags, reader);
    if (sel r_2067.ok) { code = 1; }
    val r_2068: res[LowerRequest, fail.Fail] = request(?s, ?l, ?tgt, ?machine, ?alloc, ?f.a2, f.fqn, f.mid, ?f.sm1, ?f.rr1, ?f.cc1, nil, false, false, true, ?s.diags, reader);
    if (sel r_2068.ok) { code = 1; }
    val r_2069: res[LowerRequest, fail.Fail] = request(?s, ?l, ?tgt, ?machine, ?alloc, ?f.a1, f.fqn, f.mid, ?f.sm1, ?f.rr1, ?f.cc1, nil, false, false, true, ?s.diags, unread);
    if (sel r_2069.ok) { code = 1; }
    val no_store: res[LowerRequest, fail.Fail] = request(?s, ?l, ?tgt, ?machine, ?alloc, ?f.a1, f.fqn, f.mid, ?f.sm1, ?f.rr1, ?f.cc1, nil, false, false, true, nil, reader);
    if (sel no_store.ok) { code = 1; }

    ret code;
}

# a type a query answered; a refusal of the input is reported at the node the lowering stands
# on, and any other failure is the lowering's own
fun recover_type(lc: *LowerContext, r: res[type.TypeId, fail.Fail]) type.TypeId {
    if (sel r.err) {
        val f: fail.Fail = refuse(lc, r.err);
        if (fail.is_message(f)) { fail.internal(?lc.status, fail.describe(f)); }
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}
