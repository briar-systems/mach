val INITIAL_STACK_CAP: u32 = 8;

pub val MAX_VALUE_INSTANCES: u32 = 4096;

pub val MAX_PACK_INSTANCES: u32 = 8192;

pub val INSTANCE_NONE: u32 = 4294967295;

pub val MAX_INSTANCE_DEPTH: u32 = 32;

pub val MAX_INSTANCES: u32 = 8192;

val CHAIN_LINKS: u32 = 5;

pub rec LoopFrame {
    header:    ir.BlockId;
    exit:      ir.BlockId;
    fin_depth: u32;
}

pub rec Instance {
    decl:    id.DeclId;
    origin:  session.ModuleId;
    args:    *type.TypeId;
    arg_len: u32;
    name:    intern.StrId;
    bare:    intern.StrId;
    depth:   u32;
    parent:  u32;
}

pub rec ValueInstance {
    decl:    id.DeclId;
    origin:  session.ModuleId;
    vals:    *comptime.CTValue;
    val_len: u32;
    names:   *intern.StrId;
    name:    intern.StrId;
}

pub rec PackInstance {
    decl:     id.DeclId;
    origin:   session.ModuleId;
    args:     *type.TypeId;
    arg_len:  u32;
    types:    *type.TypeId;
    type_len: u32;
    name:     intern.StrId;
}

pub rec ModuleScope {
    a:            *ast.Ast;
    fqn:          intern.StrId;
    own_module:   session.ModuleId;
    sema_result:  *sema.SemaResult;
    rr:           *resolve.ResolveResult;
    env:          comptime.ComptimeEnv;
    ctx:          *comptime.ComptimeCtx;
    subst:        *type.TypeId;
    subst_len:    u32;
    inst_current: u32;
}

pub rec ScopeMark {
    owner:      ptr;
    depth:      u32;
    generation: u64;
    parent:     u64;
}

pub rec LowerRequest {
    deps: *sema.SemaDeps;
    diags: *diagnostic.DiagnosticStore;
    s:         *session.Session;
    tgt:       *target.Target;
    malloc:    *A.Allocator;
    module:    ModuleScope;
    test_mode: bool;
    debug:     bool;
    checks:    bool;
}

rec LogicalTypePath {
    ty: type.TypeId;
    previous: *LogicalTypePath;
}

pub rec LowerContext {
    logical_type_path: *LogicalTypePath;
    deps: *sema.SemaDeps;
    diags: *diagnostic.DiagnosticStore;
    status: fail.PhaseStatus;
    s:           *session.Session;
    tgt:         *target.Target;
    scope:       ModuleScope;
    scopes:      *ModuleScope;
    scope_len:   u32;
    scope_cap:   u32;
    scope_generation: u64;
    scope_top:        u64;
    caps:        comptime.PhaseCapabilities[LowerContext];
    debug:       bool;
    # debug-profile runtime checks: the release pipeline emits none
    checks:      bool;
    m:           *ir.Module;
    builder:     builder.Builder;
    locals:      map.Map[resolve.SymbolId, value.Value];
    local_names: map.Map[intern.StrId, LocalBinding];

    fn_index:   u32;
    ret_type:   ir_type.IrTypeId;
    fn_ret_sem: type.TypeId;

    loops:    *LoopFrame;
    loop_len: u32;
    loop_cap: u32;

    fins:    *id.StmtId;
    fin_len: u32;
    fin_cap: u32;

    insts:        *Instance;
    inst_len:     u32;
    inst_cap:     u32;
    inst_drained: u32;
    inst_by_name: map.Map[intern.StrId, u32];

    vinsts:        *ValueInstance;
    vinst_len:     u32;
    vinst_cap:     u32;
    vinst_drained: u32;
    vinst_by_name: map.Map[intern.StrId, u32];

    pinsts:        *PackInstance;
    pinst_len:     u32;
    pinst_cap:     u32;
    pinst_drained: u32;
    pinst_by_name: map.Map[intern.StrId, u32];

    pack_slots:    *value.Value;
    pack_types:    *type.TypeId;
    pack_len:      u32;
    pack_ret_type: type.TypeId;

    ct_insts: *sema.InstWorklist;

    test_mode: bool;
}

pub fun scope_nil() ModuleScope {
    var sc: ModuleScope;
    sc.a            = nil;
    sc.fqn          = intern.STR_NIL;
    sc.own_module   = 0::session.ModuleId;
    sc.sema_result  = nil;
    sc.rr           = nil;
    sc.ctx          = nil;
    sc.subst        = nil;
    sc.subst_len    = 0;
    sc.inst_current = INSTANCE_NONE;
    ret sc;
}

pub fun module_scope(
    s:           *session.Session,
    own_module:  session.ModuleId,
    a:           *ast.Ast,
    fqn:         intern.StrId,
    sema_result: *sema.SemaResult,
    rr:          *resolve.ResolveResult,
    ctx:         *comptime.ComptimeCtx,
    definitions: *scx.DefinitionReader
) res[ModuleScope, fail.Fail] {
    if (s == nil)   { ret res[ModuleScope, fail.Fail].err{fail.message("lower: a module scope requires a session")}; }
    if (a == nil)   { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no parsed AST")}; }
    if (sema_result == nil) { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no semantic result")}; }
    if (rr == nil)  { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no name-resolution result")}; }
    if (ctx == nil) { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no comptime context")}; }

    val acquired: res[scx.Definition, fail.Fail] = scx.acquire_definition(definitions, own_module, scx.DEFINITION_TYPED);
    if (sel acquired.err) { ret res[ModuleScope, fail.Fail].err{acquired.err}; }
    val current: scx.Definition = acquired.ok;
    if (current.parsed.a != a || current.sr != sema_result || current.rr != rr || current.ctx != ctx) {
        ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope does not match its acquired definition")};
    }
    if (session.module_fqn(s, own_module) != fqn) {
        ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope name belongs to another module")};
    }

    var sc: ModuleScope = scope_nil();
    sc.a           = a;
    sc.fqn         = fqn;
    sc.own_module  = own_module;
    sc.sema_result = sema_result;
    sc.rr          = rr;
    sc.env         = comptime.environment(ctx);
    sc.ctx         = ctx;
    ret res[ModuleScope, fail.Fail].ok{sc};
}

pub fun origin_scope(lc: *LowerContext, origin: session.ModuleId) res[ModuleScope, fail.Fail] {
    if (origin == lc.scope.own_module) { ret res[ModuleScope, fail.Fail].ok{lc.scope}; }
    if (lc.deps == nil) { ret res[ModuleScope, fail.Fail].err{fail.message("lower: foreign definition requires scoped dependencies")}; }
    val acquired: res[scx.Definition, fail.Fail] = scx.acquire_definition(?lc.deps.definitions, origin, scx.DEFINITION_TYPED);
    if (sel acquired.err) { ret res[ModuleScope, fail.Fail].err{acquired.err}; }
    val current: scx.Definition = acquired.ok;
    ret module_scope(lc.s, origin, current.parsed.a, session.module_fqn(lc.s, origin), current.sr, current.rr, current.ctx, ?lc.deps.definitions);
}

pub fun request(
    s:           *session.Session,
    tgt:         *target.Target,
    malloc:      *A.Allocator,
    a:           *ast.Ast,
    fqn:         intern.StrId,
    own_module:  session.ModuleId,
    sema_result: *sema.SemaResult,
    rr:          *resolve.ResolveResult,
    ctx:         *comptime.ComptimeCtx,
    test_mode:   bool,
    debug:       bool,
    checks:      bool,
    diags:       *diagnostic.DiagnosticStore,
    deps:        *sema.SemaDeps
) res[LowerRequest, fail.Fail] {
    if (tgt == nil)    { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires a resolved target")}; }
    if (malloc == nil) { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires an allocator")}; }

    if (deps == nil) { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires scoped dependencies")}; }
    val sr: res[ModuleScope, fail.Fail] = module_scope(s, own_module, a, fqn, sema_result, rr, ctx, ?deps.definitions);
    if (sel sr.err) { ret res[LowerRequest, fail.Fail].err{sr.err}; }

    var req: LowerRequest;
    req.s         = s;
    req.deps      = deps;
    req.diags     = diags;
    req.tgt       = tgt;
    req.malloc    = malloc;
    req.module    = sr.ok;
    req.test_mode = test_mode;
    req.debug     = debug;
    req.checks    = checks;
    ret res[LowerRequest, fail.Fail].ok{req};
}

pub fun scope_enter(lc: *LowerContext, next: ModuleScope) res[ScopeMark, fail.Fail] {
    if (lc == nil) { ret res[ScopeMark, fail.Fail].err{fail.message("lower: scope_enter requires a context")}; }
    if (lc.scope_generation == 0xFFFFFFFFFFFFFFFF) {
        ret res[ScopeMark, fail.Fail].err{fail.message("lower: module scope generation exhausted")};
    }
    if (lc.scope_len == lc.scope_cap) {
        var new_cap: u32 = lc.scope_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        val gr: res[*ModuleScope, A.Error] = A.reallocate[ModuleScope](lc.s.alloc, lc.scopes, lc.scope_cap::usize, new_cap::usize);
        if (sel gr.err) { ret res[ScopeMark, fail.Fail].err{fail.refused(gr.err)}; }
        lc.scopes    = gr.ok;
        lc.scope_cap = new_cap;
    }

    lc.scopes[lc.scope_len] = lc.scope;
    lc.scope_len = lc.scope_len + 1;

    var mark: ScopeMark;
    mark.owner      = lc::ptr;
    mark.depth      = lc.scope_len;
    mark.generation = lc.scope_generation + 1;
    mark.parent     = lc.scope_top;

    lc.scope_generation = mark.generation;
    lc.scope_top        = mark.generation;
    lc.scope            = next;
    ret res[ScopeMark, fail.Fail].ok{mark};
}

pub fun scope_leave(lc: *LowerContext, mark: ScopeMark) err[fail.Fail] {
    if (lc == nil || mark.owner != lc::ptr) {
        ret err[fail.Fail].err{fail.message("lower: scope_leave mark belongs to another context")};
    }
    if (mark.generation == 0 || mark.generation != lc.scope_top || mark.depth != lc.scope_len) {
        ret err[fail.Fail].err{fail.message("lower: scope_leave mark is stale or out of order")};
    }
    lc.scope_len = lc.scope_len - 1;
    lc.scope     = lc.scopes[lc.scope_len];
    lc.scope_top = mark.parent;
    ret err[fail.Fail].ok{};
}

pub fun init_context(lc: *LowerContext, req: *LowerRequest, m: *ir.Module) err[fail.Fail] {
    if (req == nil) { ret err[fail.Fail].err{fail.message("lower: init_context requires a lowering request")}; }
    val s: *session.Session = req.s;
    lc.status      = fail.accepted();
    lc.logical_type_path = nil;
    lc.s           = s;
    lc.deps        = req.deps;
    lc.diags       = req.diags;
    lc.tgt         = req.tgt;
    lc.scope       = req.module;
    lc.scopes      = nil;
    lc.scope_len   = 0;
    lc.scope_cap   = 0;
    lc.scope_generation = 0;
    lc.scope_top        = 0;
    lc.test_mode   = req.test_mode;
    lc.debug       = req.debug;
    lc.checks      = req.checks;
    lc.m           = m;
    lc.builder     = builder.init(m);

    val caps_r: res[comptime.PhaseCapabilities[LowerContext], fail.Fail] = comptime.lowering_capabilities[LowerContext](
        resolve_module_member_const,
        resolve_type_comparison_operand,
        resolve_field_member,
        resolve_type_query,
        resolve_layout_intrinsic,
        resolve_scalar_cast, resolve_scalar_value,
        comptime_ident_is_runtime, comptime_expression
    );
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    lc.caps = caps_r.ok;

    lc.locals      = map.init[resolve.SymbolId, value.Value](s.alloc, map.hash_u32, map.eq_u32);
    lc.local_names = map.init[intern.StrId, LocalBinding](s.alloc, map.hash_u32, map.eq_u32);

    lc.fn_index   = 0;
    lc.ret_type   = ir_type.IRT_NIL;
    lc.fn_ret_sem = type.TYPE_NIL;

    val res_loops: res[*LoopFrame, A.Error] = A.allocate[LoopFrame](s.alloc, INITIAL_STACK_CAP::usize);
    if (sel res_loops.err) {
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret err[fail.Fail].err{fail.refused(res_loops.err)};
    }
    lc.loops    = res_loops.ok;
    lc.loop_len = 0;
    lc.loop_cap = INITIAL_STACK_CAP;

    val res_fins: res[*id.StmtId, A.Error] = A.allocate[id.StmtId](s.alloc, INITIAL_STACK_CAP::usize);
    if (sel res_fins.err) {
        A.deallocate[LoopFrame](s.alloc, lc.loops, lc.loop_cap::usize);
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret err[fail.Fail].err{fail.refused(res_fins.err)};
    }
    lc.fins    = res_fins.ok;
    lc.fin_len = 0;
    lc.fin_cap = INITIAL_STACK_CAP;

    lc.insts        = nil;
    lc.inst_len     = 0;
    lc.inst_cap     = 0;
    lc.inst_drained = 0;
    lc.inst_by_name = map.init[intern.StrId, u32](s.alloc, map.hash_u32, map.eq_u32);

    lc.vinsts        = nil;
    lc.vinst_len     = 0;
    lc.vinst_cap     = 0;
    lc.vinst_drained = 0;
    lc.vinst_by_name = map.init[intern.StrId, u32](s.alloc, map.hash_u32, map.eq_u32);

    lc.pinsts        = nil;
    lc.pinst_len     = 0;
    lc.pinst_cap     = 0;
    lc.pinst_drained = 0;
    lc.pinst_by_name = map.init[intern.StrId, u32](s.alloc, map.hash_u32, map.eq_u32);

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;

    val res_ct: res[*sema.InstWorklist, fail.Fail] = sema.inst_worklist_new(s.alloc);
    if (sel res_ct.err) {
        A.deallocate[id.StmtId](s.alloc, lc.fins, lc.fin_cap::usize);
        A.deallocate[LoopFrame](s.alloc, lc.loops, lc.loop_cap::usize);
        map.dnit[intern.StrId, u32](?lc.pinst_by_name);
        map.dnit[intern.StrId, u32](?lc.vinst_by_name);
        map.dnit[intern.StrId, u32](?lc.inst_by_name);
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret err[fail.Fail].err{res_ct.err};
    }
    lc.ct_insts = res_ct.ok;

    ret err[fail.Fail].ok{};
}

pub fun dnit_context(lc: *LowerContext) {
    if (lc == nil) { ret; }
    map.dnit[intern.StrId, LocalBinding](?lc.local_names);
    map.dnit[resolve.SymbolId, value.Value](?lc.locals);
    map.dnit[intern.StrId, u32](?lc.inst_by_name);
    map.dnit[intern.StrId, u32](?lc.vinst_by_name);
    map.dnit[intern.StrId, u32](?lc.pinst_by_name);

    if (lc.loops != nil && lc.loop_cap > 0) {
        A.deallocate[LoopFrame](lc.s.alloc, lc.loops, lc.loop_cap::usize);
    }
    if (lc.fins != nil && lc.fin_cap > 0) {
        A.deallocate[id.StmtId](lc.s.alloc, lc.fins, lc.fin_cap::usize);
    }
    if (lc.insts != nil && lc.inst_cap > 0) {
        var i: u32 = 0;
        for (i < lc.inst_len) {
            if (lc.insts[i].args != nil && lc.insts[i].arg_len > 0) {
                A.deallocate[type.TypeId](lc.s.alloc, lc.insts[i].args, lc.insts[i].arg_len::usize);
            }
            i = i + 1;
        }
        A.deallocate[Instance](lc.s.alloc, lc.insts, lc.inst_cap::usize);
    }
    if (lc.vinsts != nil && lc.vinst_cap > 0) {
        var i: u32 = 0;
        for (i < lc.vinst_len) {
            if (lc.vinsts[i].vals != nil && lc.vinsts[i].val_len > 0) {
                A.deallocate[comptime.CTValue](lc.s.alloc, lc.vinsts[i].vals, lc.vinsts[i].val_len::usize);
            }
            if (lc.vinsts[i].names != nil && lc.vinsts[i].val_len > 0) {
                A.deallocate[intern.StrId](lc.s.alloc, lc.vinsts[i].names, lc.vinsts[i].val_len::usize);
            }
            i = i + 1;
        }
        A.deallocate[ValueInstance](lc.s.alloc, lc.vinsts, lc.vinst_cap::usize);
    }
    if (lc.pinsts != nil && lc.pinst_cap > 0) {
        var i: u32 = 0;
        for (i < lc.pinst_len) {
            if (lc.pinsts[i].args != nil && lc.pinsts[i].arg_len > 0) {
                A.deallocate[type.TypeId](lc.s.alloc, lc.pinsts[i].args, lc.pinsts[i].arg_len::usize);
            }
            if (lc.pinsts[i].types != nil && lc.pinsts[i].type_len > 0) {
                A.deallocate[type.TypeId](lc.s.alloc, lc.pinsts[i].types, lc.pinsts[i].type_len::usize);
            }
            i = i + 1;
        }
        A.deallocate[PackInstance](lc.s.alloc, lc.pinsts, lc.pinst_cap::usize);
    }
    sema.inst_worklist_free(lc.ct_insts);
    lc.ct_insts = nil;

    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](lc.s.alloc, lc.scopes, lc.scope_cap::usize);
    }
    lc.scope     = scope_nil();
    lc.scopes    = nil;
    lc.scope_len = 0;
    lc.scope_cap = 0;
    lc.scope_top = 0;

    lc.loops    = nil;
    lc.loop_len = 0;
    lc.loop_cap = 0;
    lc.fins     = nil;
    lc.fin_len  = 0;
    lc.fin_cap  = 0;

    lc.insts        = nil;
    lc.inst_len     = 0;
    lc.inst_cap     = 0;
    lc.inst_drained = 0;

    lc.vinsts        = nil;
    lc.vinst_len     = 0;
    lc.vinst_cap     = 0;
    lc.vinst_drained = 0;

    lc.pinsts        = nil;
    lc.pinst_len     = 0;
    lc.pinst_cap     = 0;
    lc.pinst_drained = 0;

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;
}

pub fun symbol_definition(lc: *LowerContext, sym: *resolve.Symbol) res[scx.DefinedSymbol, fail.Fail] {
    if (sym.origin == lc.scope.own_module) {
        if (sym.decl == id.DECL_NIL || sym.decl >= lc.scope.a.decl_len::u32) {
            val reason: fail.Fail = fail.message("lower: symbol has no declaration in its active owner");
            fail.internal(?lc.status, fail.describe(reason));
            ret res[scx.DefinedSymbol, fail.Fail].err{reason};
        }
        val parsed: resolve.ParsedDefinition = resolve.ParsedDefinition{
            a: lc.scope.a, owner: resolve.type_owner(lc.s, sym.origin, lc.scope.a.file_id), incarnation: lc.scope.a.incarnation
        };
        ret res[scx.DefinedSymbol, fail.Fail].ok{scx.DefinedSymbol{
            definition: scx.Definition{ parsed: parsed, origin: sym.origin, rr: lc.scope.rr,
                sr: lc.scope.sema_result, ctx: lc.scope.ctx }, symbol: @sym
        }};
    }
    if (lc.deps == nil) {
        val reason: fail.Fail = fail.message("lower: foreign symbol requires scoped dependencies");
        fail.internal(?lc.status, fail.describe(reason));
        ret res[scx.DefinedSymbol, fail.Fail].err{reason};
    }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = scx.acquire_symbol(?lc.deps.definitions, sym, scx.DEFINITION_TYPED);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?lc.status); }
        or { fail.internal(?lc.status, fail.describe(reason)); }
    }
    ret acquired;
}

pub fun declaring_comptime_ctx(lc: *LowerContext, sym: *resolve.Symbol) *comptime.ComptimeCtx {
    if (sym.origin == lc.scope.own_module) { ret lc.scope.ctx; }
    val acquired: res[scx.DefinedSymbol, fail.Fail] = symbol_definition(lc, sym);
    if (sel acquired.err) { ret nil; }
    ret acquired.ok.definition.ctx;
}

pub fun gated_lower_member_const_message(lc: *LowerContext, name: intern.StrId, dep_fqn: intern.StrId) str {
    val fallback: str = "tuple-dependent public constants are not yet supported in union builds";
    val no: opt[str] = intern.lookup(?lc.s.interner, name);
    val fo: opt[str] = intern.lookup(?lc.s.interner, dep_fqn);
    if (sel no.none) { ret fallback; }
    if (sel fo.none) { ret fallback; }

    val res_msg: res[str, format.FormatError] = format.sprint(lc.s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        no.some, fo.some);
    if (sel res_msg.err) { fail.internal(?lc.status, fail.describe(fail.format_refused(res_msg.err))); ret fallback; }
    val buf: str = res_msg.ok;

    val ir: res[intern.StrId, A.Error] = intern.intern(?lc.s.interner, buf);
    str_free(lc.s.alloc, buf);
    if (sel ir.err) { fail.internal(?lc.status, fail.describe(fail.refused(ir.err))); ret fallback; }

    val nm: opt[str] = intern.lookup(?lc.s.interner, ir.ok);
    if (sel nm.some) { ret nm.some; }
    ret fallback;
}

pub fun report_gate(lc: *LowerContext, span: token.Span, message: str) fail.Fail {
    fail.reject(?lc.status);
    val r: res[bool, fail.Fail] = diagnostic.gate_error(lc.diags,
        ?lc.s.interner, lc.scope.a.file_id, span, message);
    if (sel r.err) { fail.internal(?lc.status, fail.describe(r.err)); }
    ret fail.phase_failure(lc.status);
}

pub fun record_eval_result(lc: *LowerContext, r: res[comptime.CTValue, comptime.EvalFail]) {
    if (sel r.ok) { ret; }
    val f: comptime.EvalFail = r.err;
    if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?lc.status, f.message); }
}

pub fun expression(lc: *LowerContext, eid: id.ExprId) res[aexpr.Expr, fail.Fail] {
    val result: res[aexpr.Expr, fail.Fail] = resolve.expression(lc.scope.rr, lc.scope.a, eid);
    if (sel result.err) {
        fail.internal(?lc.status, fail.describe(result.err));
        ret result;
    }
    if (result.ok.kind == aexpr.EXPR_KIND_ERROR) {
        val message: str = "lowering cannot consume a rejected expression";
        fail.internal(?lc.status, message);
        ret res[aexpr.Expr, fail.Fail].err{fail.message(message)};
    }
    ret result;
}

fun comptime_expression(lc: *LowerContext, a: *ast.Ast, eid: id.ExprId) res[aexpr.Expr, comptime.EvalFail] {
    if (lc == nil || lc.scope.a != a) { ret res[aexpr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "lowering expression belongs to a different parsed owner")}; }
    val result: res[aexpr.Expr, fail.Fail] = expression(lc, eid);
    if (sel result.err) {
        ret res[aexpr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.describe(result.err))};
    }
    ret res[aexpr.Expr, comptime.EvalFail].ok{result.ok};
}

pub fun resolve_module_member_const(lc: *LowerContext, eid: id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val rr: *resolve.ResolveResult = lc.scope.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sid: resolve.SymbolId = rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid::u32 >= rr.symbol_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_IMPORTED) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val octx: *comptime.ComptimeCtx = declaring_comptime_ctx(lc, sym);
    if (octx == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val nc: opt[comptime.NamedConst] = comptime.lookup(octx, sym.name);
    if (sel nc.none) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val named: comptime.NamedConst = nc.some;
    if (named.gated && lc.scope.env.union_build) {
        val msg: str = gated_lower_member_const_message(lc, sym.name, session.module_fqn(lc.s, sym.origin));
        val e_opt: res[aexpr.Expr, fail.Fail] = expression(lc, eid);
        var span: token.Span;
        span.offset = 0;
        span.len    = 0;
        if (sel e_opt.ok) { span = e_opt.ok.span; }
        val f: fail.Fail = report_gate(lc, span, msg);
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(f, msg)};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{named.value}};
}

pub fun comptime_ident_is_runtime(lc: *LowerContext, eid: id.ExprId) bool {
    if (lc == nil || eid == id.EXPR_NIL) { ret false; }
    val rr: *resolve.ResolveResult = lc.scope.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid::u32 >= rr.symbol_count) { ret false; }
    ret resolve.symbol_is_runtime(?rr.symbols[sid]);
}

fun resolve_scalar_value(lc: *LowerContext, eid: id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val ty: type.TypeId = expr_type_of(lc, eid);
    ret comptime.cast_scalar(?lc.s.types, lc.tgt.isa.pointer_width, value, ty, ty, false);
}

fun resolve_scalar_cast(lc: *LowerContext, eid: id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val expression_r: res[aexpr.Expr, fail.Fail] = expression(lc, eid);
    if (sel expression_r.err) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, fail.describe(expression_r.err))}; }
    val node: aexpr.Expr = expression_r.ok;
    if (node.kind != aexpr.EXPR_KIND_CAST) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, "lowering cast capability requires a cast expression")}; }
    ret comptime.cast_scalar(?lc.s.types, lc.tgt.isa.pointer_width, value,
        expr_type_of(lc, node.data.cast.value), type_resolved_of(lc, node.data.cast.ty), node.data.cast.reinterpret);
}

pub fun resolve_type_comparison_operand(lc: *LowerContext, eid: id.ExprId) res[opt[u32], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    val t: type.TypeId = expr_type_of(lc, eid);
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    ret res[opt[u32], comptime.EvalFail].ok{opt[u32].some{t::u32}};
}

pub fun resolve_type_query(lc: *LowerContext, tid: u32, which: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    ret infer.answer_type_query(lc.s, tid, which);
}

pub fun resolve_layout_intrinsic(lc: *LowerContext, eid: u32) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val e: id.ExprId = eid::id.ExprId;
    val src: str = module_source(lc);
    val is_size:   bool = comptime.is_size_of_call(lc.scope.a, src, e);
    val is_align:  bool = comptime.is_align_of_call(lc.scope.a, src, e);
    val is_len:    bool = comptime.is_length_of_call(lc.scope.a, src, e);
    val is_offset: bool = comptime.is_offset_of_call(lc.scope.a, src, e);
    if (!is_size && !is_align && !is_len && !is_offset) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }

    val arg: id.ExprId = comptime.layout_intrinsic_type_arg(lc.scope.a, e);
    if (arg == id.EXPR_NIL) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, "a layout intrinsic takes one type argument")};
    }
    val op_ty: type.TypeId = type.strip_secret(?lc.s.types, expr_type_of(lc, arg));

    if (is_len) {
        val n_opt: opt[u32] = type.element_count(?lc.s.types, substitute_type(lc, op_ty));
        if (sel n_opt.none) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, "`$length_of` expects a fixed array or a vector")};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(n_opt.some::u64)}};
    }

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, op_ty);
    if (sel res_ir.err) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(res_ir.err, "layout lowering was rejected")};
    }
    val op_ir: ir_type.IrTypeId = res_ir.ok;

    var n: u32 = ir_type.byte_size_for_machine(?lc.m.types, op_ir, target.layout_machine(lc.tgt));
    if (is_align) { n = ir_type.byte_align_for_machine(?lc.m.types, op_ir, target.layout_machine(lc.tgt)); }
    if (is_offset) {
        # type checking already tied the member to a field or payload case of the operand type
        val member: opt[u32] = offset_of_member_index(lc, e, substitute_type(lc, op_ty));
        if (sel member.none) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, "`$offset_of` names a member the operand type does not have")};
        }
        n = ir_type.byte_offset_for_machine(?lc.m.types, op_ir, member.some, target.layout_machine(lc.tgt));
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(n::u64)}};
}

fun offset_of_member_index(lc: *LowerContext, call_eid: id.ExprId, owner: type.TypeId) opt[u32] {
    val c_opt: res[aexpr.Expr, fail.Fail] = expression(lc, call_eid);
    if (sel c_opt.err) { ret opt[u32].none{}; }
    val c: aexpr.Expr = c_opt.ok;
    if (c.kind != aexpr.EXPR_KIND_CALL || c.data.call.args_len < 2) { ret opt[u32].none{}; }
    val m_opt: res[aexpr.Expr, fail.Fail] = expression(lc, lc.scope.a.expr_ids[c.data.call.args_start + 1]);
    if (sel m_opt.err) { ret opt[u32].none{}; }
    val r_name: res[intern.StrId, A.Error] = intern.intern_span(?lc.s.interner, module_source(lc), m_opt.ok.span);
    if (sel r_name.err) { ret opt[u32].none{}; }
    val name: intern.StrId = r_name.ok;
    val n: u32 = type.field_count(?lc.s.types, owner);
    var i: u32 = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(?lc.s.types, owner, i);
        if (sel fa.some && fa.some.name == name) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

pub fun resolve_field_member(lc: *LowerContext, owner: u32, index: u32, pick: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val owner_ty: type.TypeId = owner::type.TypeId;

    if (pick == comptime.FIELD_SEL_ZERO_BY_NAME) {
        ret resolve_omitted_field_zero(lc, owner_ty, index::intern.StrId);
    }
    if (pick == comptime.FIELD_SEL_TYPE_BY_NAME) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{scx.field_type_by_name(?lc.s.types, owner_ty, index::intern.StrId)};
    }

    val fa: opt[*type.FieldEntry] = type.field_at(?lc.s.types, owner_ty, index);
    if (sel fa.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val fe: *type.FieldEntry = fa.some;

    if (pick == comptime.FIELD_SEL_NAME) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_str(fe.name)}};
    }
    if (pick == comptime.FIELD_SEL_HAS_PAYLOAD) {
        var bit: u8 = 1;
        if (fe.ty == type.TYPE_NIL) { bit = 0; }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(bit)}};
    }
    if (pick == comptime.FIELD_SEL_CODE) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(index::u64)}};
    }
    if (fe.ty == type.TYPE_NIL && (pick == comptime.FIELD_SEL_TYPE || pick == comptime.FIELD_SEL_OFFSET)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, comptime.COMPTIME_CASE_NO_PAYLOAD_MSG)};
    }
    if (pick == comptime.FIELD_SEL_TYPE) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_type(fe.ty::u32)}};
    }
    if (pick != comptime.FIELD_SEL_OFFSET) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, owner_ty);
    if (sel res_ir.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(res_ir.err, "layout lowering was rejected")}; }
    val ir_id: ir_type.IrTypeId = res_ir.ok;
    val off: u32 = ir_type.byte_offset_for_machine(?lc.m.types, ir_id, index, target.layout_machine(lc.tgt));
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(off::u64)}};
}

fun resolve_omitted_field_zero(lc: *LowerContext, owner_ty: type.TypeId, name: intern.StrId) res[opt[comptime.CTValue], comptime.EvalFail] {
    val stripped: type.TypeId = type.strip_secret(?lc.s.types, owner_ty);
    val n: u32 = type.field_count(?lc.s.types, stripped);
    var i: u32 = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(?lc.s.types, stripped, i);
        if (sel fa.some) {
            val fe: *type.FieldEntry = fa.some;
            if (fe.name == name) {
                val fty: type.TypeId = type.strip_secret(?lc.s.types, fe.ty);
                val ft: opt[*type.Type] = type.get(?lc.s.types, fty);
                if (sel ft.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
                val kind: type.TypeKind = ft.some.kind;
                val pd: type.PrimDesc = type.prim_desc(kind);
                if (pd.class == type.PRIM_CLASS_INT) {
                    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_zero_int(!pd.signed, pd.bits::u8)}};
                }
                if (pd.class == type.PRIM_CLASS_FLOAT) {
                    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_float(0.0, type.float_width_of(kind))}};
                }
                ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
            }
        }
        i = i + 1;
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
}

pub fun begin_function(lc: *LowerContext, fn_index: u32, ret_type: ir_type.IrTypeId) {
    map.clear[resolve.SymbolId, value.Value](?lc.locals);
    map.clear[intern.StrId, LocalBinding](?lc.local_names);
    lc.loop_len   = 0;
    lc.fin_len    = 0;
    lc.fn_index   = fn_index;
    lc.ret_type   = ret_type;
    lc.fn_ret_sem = type.TYPE_NIL;

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;
}

pub rec LocalBinding {
    value:  value.Value;
    secret: bool;
}

pub fun bind_local(lc: *LowerContext, sym: resolve.SymbolId, v: value.Value, secret: bool) err[fail.Fail] {
    val res_bind: res[bool, A.Error] = map.insert[resolve.SymbolId, value.Value](?lc.locals, sym, v);
    if (sel res_bind.err) { ret err[fail.Fail].err{fail.refused(res_bind.err)}; }

    val opt_sym: opt[*resolve.Symbol] = symbol_of(lc, sym);
    if (sel opt_sym.some) {
        val name: intern.StrId = opt_sym.some.name;
        if (name != intern.STR_NIL) {
            var lb: LocalBinding;
            lb.value  = v;
            lb.secret = secret;
            val inserted: res[bool, A.Error] = map.insert[intern.StrId, LocalBinding](?lc.local_names, name, lb);
            if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
            ret err[fail.Fail].ok{};
        }
    }
    ret err[fail.Fail].ok{};
}

pub fun lookup_local_name(lc: *LowerContext, name: intern.StrId) opt[LocalBinding] {
    var key: intern.StrId = name;
    val res_get: opt[*LocalBinding] = map.get[intern.StrId, LocalBinding](?lc.local_names, ?key);
    if (sel res_get.some) {
        ret opt[LocalBinding].some{@res_get.some};
    }
    ret opt[LocalBinding].none{};
}

pub fun lookup_local(lc: *LowerContext, sym: resolve.SymbolId) opt[value.Value] {
    val res_get: opt[*value.Value] = map.get[resolve.SymbolId, value.Value](?lc.locals, ?sym);
    if (sel res_get.some) {
        ret opt[value.Value].some{@res_get.some};
    }
    ret opt[value.Value].none{};
}

pub fun push_loop(lc: *LowerContext, header: ir.BlockId, exit: ir.BlockId) err[fail.Fail] {
    if (lc.loop_len == lc.loop_cap) {
        val new_cap: u32 = lc.loop_cap * 2;
        val res_grow: res[*LoopFrame, A.Error] = A.reallocate[LoopFrame](lc.s.alloc, lc.loops, lc.loop_cap::usize, new_cap::usize);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
        lc.loops    = res_grow.ok;
        lc.loop_cap = new_cap;
    }
    var f: LoopFrame;
    f.header    = header;
    f.exit      = exit;
    f.fin_depth = lc.fin_len;
    lc.loops[lc.loop_len] = f;
    lc.loop_len = lc.loop_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun pop_loop(lc: *LowerContext) {
    if (lc.loop_len > 0) { lc.loop_len = lc.loop_len - 1; }
}

pub fun current_loop(lc: *LowerContext) *LoopFrame {
    if (lc.loop_len == 0) { ret nil; }
    ret ?lc.loops[lc.loop_len - 1];
}

pub fun enqueue_instance(lc: *LowerContext, decl: id.DeclId, origin: session.ModuleId,
                         args: *type.TypeId, arg_len: u32, name: intern.StrId,
                         bare: intern.StrId) err[fail.Fail] {
    var lookup_name: intern.StrId = name;
    if (map.contains[intern.StrId, u32](?lc.inst_by_name, ?lookup_name)) { ret err[fail.Fail].ok{}; }

    var depth: u32 = 0;
    if (lc.scope.inst_current != INSTANCE_NONE) { depth = lc.insts[lc.scope.inst_current].depth + 1; }

    if (depth > MAX_INSTANCE_DEPTH) {
        ret err[fail.Fail].err{fail.message(instantiation_chain_error(lc, bare, args, arg_len,
            "generic instantiation depth limit exceeded: a generic instantiates itself at a growing type argument"))};
    }
    if (lc.inst_len >= MAX_INSTANCES) {
        ret err[fail.Fail].err{fail.message(instantiation_chain_error(lc, bare, args, arg_len,
            "generic instantiation limit exceeded: one module reached the cap on distinct instances"))};
    }

    if (lc.inst_len == lc.inst_cap) {
        var new_cap: u32 = lc.inst_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        if (lc.insts == nil) {
            val res_grow: res[*Instance, A.Error] = A.allocate[Instance](lc.s.alloc, new_cap::usize);
            if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
            lc.insts = res_grow.ok;
        }
        or {
            val res_grow: res[*Instance, A.Error] = A.reallocate[Instance](lc.s.alloc, lc.insts, lc.inst_cap::usize, new_cap::usize);
            if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
            lc.insts = res_grow.ok;
        }
        lc.inst_cap = new_cap;
    }

    var args_copy: *type.TypeId = nil;
    if (arg_len > 0) {
        val res_copy: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](lc.s.alloc, arg_len::usize);
        if (sel res_copy.err) { ret err[fail.Fail].err{fail.refused(res_copy.err)}; }
        args_copy = res_copy.ok;
        memory.copy[type.TypeId](args_copy, args, arg_len::usize);
    }

    var inst: Instance;
    inst.decl    = decl;
    inst.origin  = origin;
    inst.args    = args_copy;
    inst.arg_len = arg_len;
    inst.name    = name;
    inst.bare    = bare;
    inst.depth   = depth;
    inst.parent  = lc.scope.inst_current;
    lc.insts[lc.inst_len] = inst;
    val res_index: res[bool, A.Error] = map.insert[intern.StrId, u32](?lc.inst_by_name, name, lc.inst_len);
    if (sel res_index.err) { ret err[fail.Fail].err{fail.refused(res_index.err)}; }
    lc.inst_len = lc.inst_len + 1;
    ret err[fail.Fail].ok{};
}

fun instantiation_chain_error(lc: *LowerContext, bare: intern.StrId, args: *type.TypeId,
                              arg_len: u32, headline: str) str {
    var shown: [CHAIN_LINKS]u32;
    var count: u32 = 0;
    var total: u32 = 0;
    var walk:  u32 = lc.scope.inst_current;
    for (walk != INSTANCE_NONE) {
        if (count < CHAIN_LINKS) {
            shown[count] = walk;
            count = count + 1;
        }
        total = total + 1;
        walk = lc.insts[walk].parent;
    }

    var msg: str = chain_start(lc, headline);
    if (msg == nil) { ret headline; }

    if (total > count) {
        val elided: res[str, format.FormatError] = format.sprint(lc.s.alloc, "... ({} more) -> ", (total - count)::usize);
        if (sel elided.err) { return_chain(lc, msg); ret headline; }
        msg = chain_append(lc, msg, elided.ok, true);
        if (msg == nil) { ret headline; }
    }

    var i: u32 = count;
    for (i > 0) {
        i = i - 1;
        val link: res[str, fail.Fail] = typename.instance_spelling(lc.s, lc.insts[shown[i]].bare,
                                                                  lc.insts[shown[i]].args, lc.insts[shown[i]].arg_len);
        if (sel link.err) { return_chain(lc, msg); ret headline; }
        msg = chain_append(lc, msg, link.ok, true);
        if (msg == nil) { ret headline; }
        msg = chain_append(lc, msg, " -> ", false);
        if (msg == nil) { ret headline; }
    }

    val last: res[str, fail.Fail] = typename.instance_spelling(lc.s, bare, args, arg_len);
    if (sel last.err) { return_chain(lc, msg); ret headline; }
    msg = chain_append(lc, msg, last.ok, true);
    if (msg == nil) { ret headline; }

    val id_r: res[intern.StrId, A.Error] = intern.intern(?lc.s.interner, msg);
    return_chain(lc, msg);
    if (sel id_r.err) { ret headline; }
    val text: opt[str] = intern.lookup(?lc.s.interner, id_r.ok);
    if (sel text.none) { ret headline; }
    ret text.some;
}

fun chain_start(lc: *LowerContext, headline: str) str {
    val r: res[str, format.FormatError] = format.sprint(lc.s.alloc, "{}; chain: ", headline);
    if (sel r.err) { ret nil; }
    ret r.ok;
}

fun chain_append(lc: *LowerContext, msg: str, piece: str, piece_owned: bool) str {
    val r: res[str, format.FormatError] = format.sprint(lc.s.alloc, "{}{}", msg, piece);
    return_chain(lc, msg);
    if (piece_owned) { return_chain(lc, piece); }
    if (sel r.err) { ret nil; }
    ret r.ok;
}

fun return_chain(lc: *LowerContext, owned: str) {
    typename.type_str_free(lc.s, owned);
}

pub fun enqueue_value_instance(lc: *LowerContext, decl: id.DeclId, origin: session.ModuleId,
                               vals: *comptime.CTValue, names: *intern.StrId, val_len: u32,
                               name: intern.StrId) err[fail.Fail] {
    var lookup_name: intern.StrId = name;
    if (map.contains[intern.StrId, u32](?lc.vinst_by_name, ?lookup_name)) { ret err[fail.Fail].ok{}; }

    if (lc.vinst_len >= MAX_VALUE_INSTANCES) {
        ret err[fail.Fail].err{fail.message("comptime value-parameter instantiation limit exceeded (likely unbounded comptime recursion)")};
    }

    if (lc.vinst_len == lc.vinst_cap) {
        var new_cap: u32 = lc.vinst_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        if (lc.vinsts == nil) {
            val res_grow: res[*ValueInstance, A.Error] = A.allocate[ValueInstance](lc.s.alloc, new_cap::usize);
            if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
            lc.vinsts = res_grow.ok;
        }
        or {
            val res_grow: res[*ValueInstance, A.Error] = A.reallocate[ValueInstance](lc.s.alloc, lc.vinsts, lc.vinst_cap::usize, new_cap::usize);
            if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
            lc.vinsts = res_grow.ok;
        }
        lc.vinst_cap = new_cap;
    }

    var vals_copy: *comptime.CTValue = nil;
    var names_copy: *intern.StrId = nil;
    if (val_len > 0) {
        val res_vals: res[*comptime.CTValue, A.Error] = A.allocate[comptime.CTValue](lc.s.alloc, val_len::usize);
        if (sel res_vals.err) { ret err[fail.Fail].err{fail.refused(res_vals.err)}; }
        vals_copy = res_vals.ok;
        val res_names: res[*intern.StrId, A.Error] = A.allocate[intern.StrId](lc.s.alloc, val_len::usize);
        if (sel res_names.err) {
            A.deallocate[comptime.CTValue](lc.s.alloc, vals_copy, val_len::usize);
            ret err[fail.Fail].err{fail.refused(res_names.err)};
        }
        names_copy = res_names.ok;
        memory.copy[comptime.CTValue](vals_copy, vals, val_len::usize);
        memory.copy[intern.StrId](names_copy, names, val_len::usize);
    }

    var inst: ValueInstance;
    inst.decl    = decl;
    inst.origin  = origin;
    inst.vals    = vals_copy;
    inst.val_len = val_len;
    inst.names   = names_copy;
    inst.name    = name;
    lc.vinsts[lc.vinst_len] = inst;
    val res_index: res[bool, A.Error] = map.insert[intern.StrId, u32](?lc.vinst_by_name, name, lc.vinst_len);
    if (sel res_index.err) { ret err[fail.Fail].err{fail.refused(res_index.err)}; }
    lc.vinst_len = lc.vinst_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun enqueue_pack_instance(lc: *LowerContext, decl: id.DeclId, origin: session.ModuleId,
                              args: *type.TypeId, arg_len: u32,
                              types: *type.TypeId, type_len: u32, name: intern.StrId) err[fail.Fail] {
    var lookup_name: intern.StrId = name;
    if (map.contains[intern.StrId, u32](?lc.pinst_by_name, ?lookup_name)) { ret err[fail.Fail].ok{}; }

    if (lc.pinst_len >= MAX_PACK_INSTANCES) {
        ret err[fail.Fail].err{fail.message("comptime pack instantiation limit exceeded (likely unbounded recursive pack expansion)")};
    }

    if (lc.pinst_len == lc.pinst_cap) {
        var new_cap: u32 = lc.pinst_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        if (lc.pinsts == nil) {
            val res_grow: res[*PackInstance, A.Error] = A.allocate[PackInstance](lc.s.alloc, new_cap::usize);
            if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
            lc.pinsts = res_grow.ok;
        }
        or {
            val res_grow: res[*PackInstance, A.Error] = A.reallocate[PackInstance](lc.s.alloc, lc.pinsts, lc.pinst_cap::usize, new_cap::usize);
            if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
            lc.pinsts = res_grow.ok;
        }
        lc.pinst_cap = new_cap;
    }

    var args_copy: *type.TypeId = nil;
    if (arg_len > 0) {
        val res_args: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](lc.s.alloc, arg_len::usize);
        if (sel res_args.err) { ret err[fail.Fail].err{fail.refused(res_args.err)}; }
        args_copy = res_args.ok;
        memory.copy[type.TypeId](args_copy, args, arg_len::usize);
    }

    var types_copy: *type.TypeId = nil;
    if (type_len > 0) {
        val res_copy: res[*type.TypeId, A.Error] = A.allocate[type.TypeId](lc.s.alloc, type_len::usize);
        if (sel res_copy.err) {
            if (args_copy != nil) { A.deallocate[type.TypeId](lc.s.alloc, args_copy, arg_len::usize); }
            ret err[fail.Fail].err{fail.refused(res_copy.err)};
        }
        types_copy = res_copy.ok;
        memory.copy[type.TypeId](types_copy, types, type_len::usize);
    }

    var inst: PackInstance;
    inst.decl     = decl;
    inst.origin   = origin;
    inst.args     = args_copy;
    inst.arg_len  = arg_len;
    inst.types    = types_copy;
    inst.type_len = type_len;
    inst.name     = name;
    lc.pinsts[lc.pinst_len] = inst;
    val res_index: res[bool, A.Error] = map.insert[intern.StrId, u32](?lc.pinst_by_name, name, lc.pinst_len);
    if (sel res_index.err) { ret err[fail.Fail].err{fail.refused(res_index.err)}; }
    lc.pinst_len = lc.pinst_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun push_fin(lc: *LowerContext, body: id.StmtId) err[fail.Fail] {
    if (lc.fin_len == lc.fin_cap) {
        val new_cap: u32 = lc.fin_cap * 2;
        val res_grow: res[*id.StmtId, A.Error] = A.reallocate[id.StmtId](lc.s.alloc, lc.fins, lc.fin_cap::usize, new_cap::usize);
        if (sel res_grow.err) { ret err[fail.Fail].err{fail.refused(res_grow.err)}; }
        lc.fins    = res_grow.ok;
        lc.fin_cap = new_cap;
    }
    lc.fins[lc.fin_len] = body;
    lc.fin_len = lc.fin_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun fin_count(lc: *LowerContext) u32 {
    ret lc.fin_len;
}

pub fun fin_at(lc: *LowerContext, i: u32) id.StmtId {
    if (i >= lc.fin_len) { ret id.STMT_NIL; }
    ret lc.fins[i];
}

pub fun pop_fins_to(lc: *LowerContext, mark: u32) {
    if (mark < lc.fin_len) { lc.fin_len = mark; }
}

pub fun lower_type(lc: *LowerContext, tid: type.TypeId) res[ir_type.IrTypeId, fail.Fail] {
    if (tid == type.TYPE_NIL) {
        ret ir_type.intern_void(?lc.m.types);
    }

    var rtid: type.TypeId = tid;
    if (lc.scope.subst != nil && lc.scope.subst_len > 0) {
        rtid = recover_type(lc, generics.substitute(lc.s, tid, lc.scope.subst, lc.scope.subst_len));
    }

    val previous: *LogicalTypePath = lc.logical_type_path;
    var path: LogicalTypePath;
    if (!lc.tgt.model.flat_addressing) {
        var active: *LogicalTypePath = previous;
        for (active != nil) {
            if (active.ty == rtid) {
                var span: token.Span;
                span.offset = lc.builder.loc.offset;
                span.len = 0;
                ret res[ir_type.IrTypeId, fail.Fail].err{report_gate(lc, span,
                    "recursive reference types require pointer capabilities absent from the Logical Shader environment")};
            }
            active = active.previous;
        }
        path.ty = rtid;
        path.previous = previous;
        lc.logical_type_path = ?path;
    }
    fin { lc.logical_type_path = previous; }

    val fields: err[fail.Fail] = generics.ensure_fields(lc.s, rtid);
    if (sel fields.err) { ret res[ir_type.IrTypeId, fail.Fail].err{fields.err}; }
    if (sel lc.status.kind.internal) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.phase_failure(lc.status)}; }

    val t_opt: opt[*type.Type] = type.get(?lc.s.types, rtid);
    if (sel t_opt.none) {
        ret ir_type.intern_void(?lc.m.types);
    }
    val t: *type.Type = t_opt.some;
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_SECRET) { ret lower_type(lc, t.data.secret.base); }

    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT)   { ret ir_type.intern_int(?lc.m.types, d.bits); }
    if (d.class == type.PRIM_CLASS_FLOAT) { ret ir_type.intern_float(?lc.m.types, d.bits); }
    if (d.class == type.PRIM_CLASS_PTR)   { ret ir_type.intern_ptr(?lc.m.types); }
    if (k == type.TYPE_POINTER) {
        if (lc.tgt.model.flat_addressing) { ret ir_type.intern_ptr(?lc.m.types); }
        val base: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.pointer.base);
        if (sel base.err) { ret base; }
        ret ir_type.intern_reference(?lc.m.types, base.ok);
    }

    if (k == type.TYPE_ARRAY) {
        val res_base: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.array.base);
        if (sel res_base.err) { ret res_base; }
        ret ir_type.intern_array(?lc.m.types, res_base.ok, t.data.array.count);
    }

    if (k == type.TYPE_VECTOR) {
        val ed: type.PrimDesc = type.prim_desc(t.data.vector.element);
        var res_elem: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?lc.m.types, ed.bits);
        if (ed.class == type.PRIM_CLASS_FLOAT) { res_elem = ir_type.intern_float(?lc.m.types, ed.bits); }
        if (sel res_elem.err) { ret res_elem; }
        ret ir_type.intern_vector(?lc.m.types, res_elem.ok, t.data.vector.lanes);
    }

    if (k == type.TYPE_HANDLE) {
        ret lower_handle_type(lc, rtid, t);
    }

    if (k == type.TYPE_ABI) {
        ret lower_abi_type(lc, t);
    }

    if (k == type.TYPE_TAG || ((k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE)
        && type.is_tag(?lc.s.types, rtid))) {
        ret lower_tag(lc, rtid);
    }

    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE) {
        ret lower_nominal(lc, rtid, type.is_union(?lc.s.types, rtid));
    }

    if (k == type.TYPE_FUN) {
        ret lower_function_type(lc, t);
    }

    ret ir_type.intern_ptr(?lc.m.types);
}

fun lower_abi_type(lc: *LowerContext, t: *type.Type) res[ir_type.IrTypeId, fail.Fail] {
    val r_u8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?lc.m.types, 8);
    if (sel r_u8.err) { ret r_u8; }
    val r_arr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?lc.m.types, r_u8.ok, t.data.abi.size);
    if (sel r_arr.err) { ret r_arr; }
    var field: ir_type.IrTypeId = r_arr.ok;
    ret ir_type.intern_struct(?lc.m.types, ?field, 1, t.data.abi.align, false);
}

fun lower_handle_type(lc: *LowerContext, rtid: type.TypeId, t: *type.Type) res[ir_type.IrTypeId, fail.Fail] {
    val n: u32 = t.data.handle.ops_len;
    var ops: *ir_type.IrTypeId = nil;
    if (n > 0) {
        val r_ops: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, n::usize);
        if (sel r_ops.err) {
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(r_ops.err)};
        }
        ops = r_ops.ok;
    }

    val td: *isa.TypeDef = isa.type_def_by_tag(lc.tgt.isa.defs, t.data.handle.ctor);

    var i: u32 = 0;
    for (i < n) {
        val w: u32 = type.handle_operand(?lc.s.types, rtid, i);
        ops[i] = w::ir_type.IrTypeId;
        if (td != nil && i < td.arity && td.operands[i] != isa.TYPE_OPERAND_WORD) {
            val inner: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, w::type.TypeId);
            if (sel inner.err) {
                if (ops != nil) { A.deallocate[ir_type.IrTypeId](lc.s.alloc, ops, n::usize); }
                ret inner;
            }
            ops[i] = inner.ok;
        }
        i = i + 1;
    }

    val res_: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_handle(?lc.m.types, t.data.handle.ctor, ops, n);
    if (ops != nil) { A.deallocate[ir_type.IrTypeId](lc.s.alloc, ops, n::usize); }
    ret res_;
}

# a tag lowers to its case payload types plus the declared discriminator width
fun lower_tag(lc: *LowerContext, tid: type.TypeId) res[ir_type.IrTypeId, fail.Fail] {
    var nom_align: u32 = 0;
    val ta: opt[u32] = session.type_align(lc.s, tid::u32);
    if (sel ta.some) { nom_align = ta.some; }
    val nom_packed: bool = session.type_is_packed(lc.s, tid::u32);

    val disc_bytes: u32 = type.tag_discriminator_bytes(?lc.s.types, tid);
    if (disc_bytes == 0) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: a tag has no declared discriminator type")};
    }

    val cases_len: u32 = type.field_count(?lc.s.types, tid);
    if (cases_len == 0) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: a tag has no cases")};
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, cases_len::usize);
    if (sel res_buf.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *ir_type.IrTypeId = res_buf.ok;

    var i: u32 = 0;
    for (i < cases_len) {
        val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (sel fe_opt.none) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, cases_len::usize);
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("case table for a tag is missing an in-range case")};
        }
        val res_case: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, fe_opt.some.ty);
        if (sel res_case.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, cases_len::usize);
            ret res_case;
        }
        buf[i] = res_case.ok;
        i = i + 1;
    }

    val res_tag: res[ir_type.IrTypeId, fail.Fail] =
        ir_type.intern_tag(?lc.m.types, buf, cases_len, disc_bytes, nom_align, nom_packed);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, cases_len::usize);
    ret res_tag;
}

fun lower_nominal(lc: *LowerContext, tid: type.TypeId, is_union: bool) res[ir_type.IrTypeId, fail.Fail] {
    var nom_align: u32 = 0;
    val ta: opt[u32] = session.type_align(lc.s, tid::u32);
    if (sel ta.some) { nom_align = ta.some; }

    val nom_packed: bool = session.type_is_packed(lc.s, tid::u32);

    val fields_len: u32 = type.field_count(?lc.s.types, tid);
    if (fields_len == 0) {
        ret ir_type.intern_struct(?lc.m.types, nil, 0, nom_align, nom_packed);
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, fields_len::usize);
    if (sel res_buf.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *ir_type.IrTypeId = res_buf.ok;

    var i: u32 = 0;
    for (i < fields_len) {
        val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (sel fe_opt.none) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("field table for nominal type is missing an in-range field")};
        }

        val sem: type.TypeId = fe_opt.some.ty;
        val res_field: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, sem);
        if (sel res_field.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
            ret res_field;
        }
        buf[i] = res_field.ok;
        i = i + 1;
    }

    var res_struct: res[ir_type.IrTypeId, fail.Fail];
    if (is_union) {
        res_struct = ir_type.intern_union(?lc.m.types, buf, fields_len, nom_align, nom_packed);
    }
    or {
        res_struct = ir_type.intern_struct(?lc.m.types, buf, fields_len, nom_align, nom_packed);
    }
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
    ret res_struct;
}

fun lower_function_type(lc: *LowerContext, t: *type.Type) res[ir_type.IrTypeId, fail.Fail] {
    val res_ret: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.fn.ret_type);
    if (sel res_ret.err) { ret res_ret; }
    val ir_ret: ir_type.IrTypeId = res_ret.ok;

    val c_variadic: bool = t.data.fn.c_variadic;
    val params_len: u32  = t.data.fn.params_len;
    if (params_len == 0) {
        ret ir_type.intern_fn(?lc.m.types, ir_ret, nil, 0, c_variadic);
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, params_len::usize);
    if (sel res_buf.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *ir_type.IrTypeId = res_buf.ok;

    var i: u32 = 0;
    for (i < params_len) {
        val po: opt[type.TypeId] = type.get_param(?lc.s.types, t.data.fn.params_start + i);
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (sel po.some) { p_sem = po.some; }
        val res_param: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, p_sem);
        if (sel res_param.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, params_len::usize);
            ret res_param;
        }
        buf[i] = res_param.ok;
        i = i + 1;
    }

    val res_fn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?lc.m.types, ir_ret, buf, params_len, c_variadic);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, params_len::usize);
    ret res_fn;
}

pub fun gate_is_active(lc: *LowerContext, source: str, cond: id.ExprId,
                       scope: comptime.GateScope, cache: bool) res[bool, fail.Fail] {
    val vr: res[comptime.GateVerdict, fail.Fail] = comptime.evaluate_gate[LowerContext](
        lc.scope.ctx, lc, lc.caps, lc.scope.a, source, cond, ?lc.s.interner, scope, cache, true);
    if (sel vr.err) {
        ret res[bool, fail.Fail].err{vr.err};
    }
    val v: comptime.GateVerdict = vr.ok;
    if (v.outcome == comptime.GATE_ACTIVE)         { ret res[bool, fail.Fail].ok{true}; }
    if (v.outcome == comptime.GATE_INACTIVE)       { ret res[bool, fail.Fail].ok{false}; }
    if (v.outcome == comptime.GATE_AWAITING_TYPES) { ret res[bool, fail.Fail].ok{comptime.truth(v.value)}; }
    # an evaluation the earlier phases could not settle names a place that is not a constant; that
    # is the program's fault and is reported at the condition
    if (str_len(v.message) > 0) {
        diagnostic.record_error(lc.diags, lc.scope.a.file_id, v.span, v.message);
        ret res[bool, fail.Fail].err{fail.reported()};
    }
    ret res[bool, fail.Fail].err{fail.message("lower: a comptime gate reached lowering undecided")};
}

pub fun block_terminated(lc: *LowerContext) bool {
    if (lc.builder.fn == nil) { ret false; }
    val b: ir.BlockId = lc.builder.block;
    if (b == ir.BLOCK_NIL)              { ret false; }
    if (b >= lc.builder.fn.block_count) { ret false; }
    ret lc.builder.fn.blocks[b].terminator != ir.INSTR_NIL;
}

pub fun is_void_ir(lc: *LowerContext, tid: ir_type.IrTypeId) bool {
    val opt_type: opt[*ir_type.IrType] = ir_type.get(?lc.m.types, tid);
    if (sel opt_type.none) { ret true; }
    ret opt_type.some.kind == ir_type.IRT_VOID;
}

pub fun expr_type_of(lc: *LowerContext, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL)          { ret type.TYPE_NIL; }
    if (eid::usize >= lc.scope.a.expr_len) { ret type.TYPE_NIL; }
    ret lc.scope.sema_result.expr_type[eid];
}

pub fun expr_float_width(lc: *LowerContext, eid: id.ExprId) float.FloatWidth {
    ret float_width_of_type(lc, expr_type_of(lc, eid));
}

pub fun float_width_of_type(lc: *LowerContext, tid: type.TypeId) float.FloatWidth {
    if (tid == type.TYPE_NIL) { ret float.FLOAT_W_NONE; }
    val ct: type.TypeId = type.strip_secret(?lc.s.types, substitute_type(lc, tid));
    val opt_t: opt[*type.Type] = type.get(?lc.s.types, ct);
    if (sel opt_t.none) { ret float.FLOAT_W_NONE; }
    ret type.float_width_of(opt_t.some.kind);
}

pub fun expr_is_secret(lc: *LowerContext, eid: id.ExprId) bool {
    ret type_is_secret(lc, expr_type_of(lc, eid));
}

pub fun type_is_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_NIL) { ret false; }
    ret type.is_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun type_contains_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_NIL || tid == type.TYPE_ERROR) { ret false; }
    ret type.contains_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun type_carries_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_NIL) { ret false; }
    ret type.carries_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun substitute_type(lc: *LowerContext, tid: type.TypeId) type.TypeId {
    if (lc.scope.subst == nil || lc.scope.subst_len == 0) { ret tid; }
    ret recover_type(lc, generics.substitute(lc.s, tid, lc.scope.subst, lc.scope.subst_len));
}

pub fun type_resolved_of(lc: *LowerContext, tid: id.TypeId) type.TypeId {
    if (tid == id.TYPE_NIL)          { ret type.TYPE_NIL; }
    if (tid::usize >= lc.scope.a.type_len) { ret type.TYPE_NIL; }
    ret lc.scope.sema_result.type_resolved_ty[tid];
}

pub fun decl_type_of(lc: *LowerContext, did: id.DeclId) type.TypeId {
    if (did == id.DECL_NIL)          { ret type.TYPE_NIL; }
    if (did::usize >= lc.scope.a.decl_len) { ret type.TYPE_NIL; }
    ret lc.scope.sema_result.decl_type[did];
}

pub fun decl_ret_sem(lc: *LowerContext, did: id.DeclId) type.TypeId {
    val fn_ty: type.TypeId = decl_type_of(lc, did);
    val to: opt[*type.Type] = type.get(?lc.s.types, fn_ty);
    if (sel to.none) { ret type.TYPE_NIL; }
    val t: *type.Type = to.some;
    if (t.kind != type.TYPE_FUN) { ret type.TYPE_NIL; }
    var ret_type: type.TypeId = t.data.fn.ret_type;
    if (lc.scope.subst != nil && lc.scope.subst_len > 0) {
        ret_type = recover_type(lc, generics.substitute(lc.s, ret_type, lc.scope.subst, lc.scope.subst_len));
    }
    ret ret_type;
}

pub fun function_return_ir(lc: *LowerContext, did: id.DeclId) res[ir_type.IrTypeId, fail.Fail] {
    val sem: type.TypeId = decl_type_of(lc, did);
    val opt_type: opt[*type.Type] = type.get(?lc.s.types, sem);
    if (sel opt_type.none) { ret ir_type.intern_void(?lc.m.types); }
    val t: *type.Type = opt_type.some;
    if (t.kind != type.TYPE_FUN) { ret ir_type.intern_void(?lc.m.types); }
    ret lower_type(lc, t.data.fn.ret_type);
}

pub fun pack_instance_sig(lc: *LowerContext, d: *adecl.Decl, fixed_count: u32,
                          types: *type.TypeId, type_len: u32, ret_ir: ir_type.IrTypeId) res[ir_type.IrTypeId, fail.Fail] {
    val total: u32 = fixed_count + type_len;
    if (total == 0) {
        ret ir_type.intern_fn(?lc.m.types, ret_ir, nil, 0, false);
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, total::usize);
    if (sel res_buf.err) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *ir_type.IrTypeId = res_buf.ok;

    var i: u32 = 0;
    for (i < total) {
        var elem_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < lc.scope.a.typed_name_len) {
                elem_sem = type_resolved_of(lc, lc.scope.a.typed_names[pool_ix].ty);
            }
        }
        or {
            elem_sem = types[i - fixed_count];
        }
        val res_elem: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, elem_sem);
        if (sel res_elem.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, total::usize);
            ret res_elem;
        }
        buf[i] = res_elem.ok;
        i = i + 1;
    }

    val res_fn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?lc.m.types, ret_ir, buf, total, false);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, total::usize);
    ret res_fn;
}

pub fun instance_ref_sig(lc: *LowerContext, decl_id: id.DeclId, origin: session.ModuleId,
                         args: *type.TypeId, arg_len: u32) res[ir_type.IrTypeId, fail.Fail] {
    val acquired: res[ModuleScope, fail.Fail] = origin_scope(lc, origin);
    if (sel acquired.err) { ret res[ir_type.IrTypeId, fail.Fail].err{acquired.err}; }
    var sc: ModuleScope = acquired.ok;
    sc.subst     = args;
    sc.subst_len = arg_len;

    val mark_r: res[ScopeMark, fail.Fail] = scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{mark_r.err};
    }

    val res_sig: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, decl_type_of(lc, decl_id));

    val leave: err[fail.Fail] = scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret res[ir_type.IrTypeId, fail.Fail].err{leave.err}; }
    ret res_sig;
}

pub fun pack_instance_ref_sig(lc: *LowerContext, decl_id: id.DeclId, origin: session.ModuleId,
                              args: *type.TypeId, arg_len: u32,
                              types: *type.TypeId, type_len: u32) res[ir_type.IrTypeId, fail.Fail] {
    val acquired: res[ModuleScope, fail.Fail] = origin_scope(lc, origin);
    if (sel acquired.err) { ret res[ir_type.IrTypeId, fail.Fail].err{acquired.err}; }
    var sc: ModuleScope = acquired.ok;
    val opt_d: opt[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (sel opt_d.none) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: pack-instance-reference origin declaration not found")}; }
    val d: *adecl.Decl = opt_d.some;
    if (d.kind != adecl.DECL_KIND_FUN) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: pack-instance-reference origin declaration is not a function")}; }
    sc.subst     = args;
    sc.subst_len = arg_len;

    val mark_r: res[ScopeMark, fail.Fail] = scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{mark_r.err};
    }

    var res_sig: res[ir_type.IrTypeId, fail.Fail];
    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = function_return_ir(lc, decl_id);
    if (sel res_ret_ir.err) {
        res_sig = res[ir_type.IrTypeId, fail.Fail].err{res_ret_ir.err};
    }
    or (sel res_ret_ir.ok) {
        val fixed_count: u32 = d.data.fun_.params_len - 1;
        res_sig = pack_instance_sig(lc, d, fixed_count, types, type_len, res_ret_ir.ok);
    }

    val leave: err[fail.Fail] = scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret res[ir_type.IrTypeId, fail.Fail].err{leave.err}; }
    ret res_sig;
}

pub fun expr_symbol_of(lc: *LowerContext, eid: id.ExprId) resolve.SymbolId {
    if (eid == id.EXPR_NIL)             { ret resolve.SYMBOL_NIL; }
    if (eid::usize >= lc.scope.rr.expr_count) { ret resolve.SYMBOL_NIL; }
    val sid: resolve.SymbolId = lc.scope.rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_REJECTED) {
        fail.reject(?lc.status);
        ret resolve.SYMBOL_NIL;
    }
    ret sid;
}

pub fun module_source(lc: *LowerContext) str {
    ret ast_source(lc, lc.scope.a);
}

pub fun ast_source(lc: *LowerContext, a: *ast.Ast) str {
    if (a == nil) { ret ""; }
    val sf: opt[*source.SourceFile] = source.get(?lc.s.sources, a.file_id);
    if (sel sf.none) { ret ""; }
    ret sf.some.text;
}

pub fun decl_target_op(a: *ast.Ast, src: str, d: *adecl.Decl, defs: *isa.TargetDefs, out_op: *u32) u32 {
    if (a == nil || d == nil) { ret isa.NO_OP_SET; }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *adecl.Decorator = ?a.decorators[d.decorators_start + i];
        if (!str_region_equals(src, dec.name.offset, dec.name.len, "op")) { i = i + 1; cnt; }
        if (dec.args_len != 3) { ret isa.NO_OP_SET; }
        val opt_set: opt[*aexpr.Expr] = ast.get_expr(a, a.expr_ids[dec.args_start + 1]);
        val opt_nam: opt[*aexpr.Expr] = ast.get_expr(a, a.expr_ids[dec.args_start + 2]);
        if (sel opt_set.none) { ret isa.NO_OP_SET; }
        if (sel opt_nam.none) { ret isa.NO_OP_SET; }
        val set_e: *aexpr.Expr = opt_set.some;
        val nam_e: *aexpr.Expr = opt_nam.some;
        if (set_e.span.len < 2::usize || nam_e.span.len < 2::usize) { ret isa.NO_OP_SET; }
        val od: *isa.OpDef = isa.op_def_of_region(defs,
            src, set_e.span.offset + 1::usize, set_e.span.len - 2::usize,
            src, nam_e.span.offset + 1::usize, nam_e.span.len - 2::usize);
        if (od == nil) { ret isa.NO_OP_SET; }
        @out_op = od.opcode;
        ret od.set_tag;
    }
    ret isa.NO_OP_SET;
}

pub fun emit_dbg_birth(lc: *LowerContext, name_span: token.Span, ty: ir_type.IrTypeId,
                       ty_sem: type.TypeId, is_param: bool, val_v: value.Value,
                       slot: opt[value.Value]) err[fail.Fail] {
    val res_name: res[intern.StrId, A.Error] = intern.intern_span(?lc.s.interner, module_source(lc), name_span);
    if (sel res_name.err) {
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val name: intern.StrId = res_name.ok;
    var sem: type.TypeId = ty_sem;
    if (lc.scope.subst != nil && lc.scope.subst_len > 0) {
        sem = recover_type(lc, generics.substitute(lc.s, sem, lc.scope.subst, lc.scope.subst_len));
    }
    if (sel slot.some) {
        val sv: value.Value = slot.some;
        if (sv.kind == value.VAL_INSTR) {
            var dv: ir.DbgVar;
            dv.name     = name;
            dv.ty       = ty;
            dv.ty_sem   = sem;
            dv.is_param = is_param;
            dv.scope    = 0;
            val res_link: err[fail.Fail] = ir.record_alloca_dbg_var(lc.builder.fn, sv.data.instr, dv);
            if (sel res_link.err) { ret res_link; }
        }
    }
    ret builder.emit_dbg_value(?lc.builder, val_v, name, ty, sem, is_param, 0);
}

pub fun symbol_of(lc: *LowerContext, sid: resolve.SymbolId) opt[*resolve.Symbol] {
    if (sid == resolve.SYMBOL_NIL) { ret opt[*resolve.Symbol].none{}; }
    if (sid >= lc.scope.rr.symbol_count) { ret opt[*resolve.Symbol].none{}; }
    ret opt[*resolve.Symbol].some{?lc.scope.rr.symbols[sid]};
}

pub fun ensure_extern_function(lc: *LowerContext, name: intern.StrId, sig: ir_type.IrTypeId, import_flag: bool) res[u32, fail.Fail] {
    val m: *ir.Module = lc.m;
    val existing: opt[u32] = ir.function_lookup(m, name);
    if (sel existing.some) {
        val fi: u32 = existing.some;
        if (import_flag) { m.functions[fi].is_import = true; }
        ret res[u32, fail.Fail].ok{fi};
    }

    if (m.function_len == m.function_cap) {
        val new_cap: u32 = grow_cap(m.function_cap);
        val res_grow: res[*ir.Function, A.Error] = A.reallocate[ir.Function](m.alloc, m.functions, m.function_cap::usize, new_cap::usize);
        if (sel res_grow.err) { ret res[u32, fail.Fail].err{fail.refused(res_grow.err)}; }
        m.functions    = res_grow.ok;
        m.function_cap = new_cap;
    }

    val idx: u32 = m.function_len;
    m.functions[idx] = ir.function_new(m.alloc, name, sig, ir.FN_FLAG_EXTERN);
    m.functions[idx].is_import = import_flag;
    m.function_len   = m.function_len + 1;
    val res_reg: err[fail.Fail] = ir.function_register(m, name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }

    if (lc.builder.fn != nil && lc.fn_index < m.function_len) {
        lc.builder.fn = ?m.functions[lc.fn_index];
    }
    ret res[u32, fail.Fail].ok{idx};
}

pub fun ensure_extern_global(lc: *LowerContext, name: intern.StrId, ty: ir_type.IrTypeId, import_flag: bool) res[u32, fail.Fail] {
    val m: *ir.Module = lc.m;
    val existing: opt[u32] = ir.global_lookup(m, name);
    if (sel existing.some) {
        val gi: u32 = existing.some;
        if (import_flag) { m.globals[gi].is_import = true; }
        ret res[u32, fail.Fail].ok{gi};
    }

    if (m.global_len == m.global_cap) {
        val new_cap: u32 = grow_cap(m.global_cap);
        val res_grow: res[*ir.Global, A.Error] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, new_cap::usize);
        if (sel res_grow.err) { ret res[u32, fail.Fail].err{fail.refused(res_grow.err)}; }
        m.globals    = res_grow.ok;
        m.global_cap = new_cap;
    }

    val idx: u32 = m.global_len;
    var g: ir.Global;
    g.name      = name;
    g.ty        = ty;
    g.init      = value.const_int(0, ty);
    g.is_mut    = true;
    g.is_pub    = false;
    g.is_extern = true;
    g.is_import = import_flag;
    g.is_local  = false;
    g.is_embed  = false;
    g.align     = 0;
    g.section   = intern.STR_NIL;
    m.globals[idx] = g;
    m.global_len   = m.global_len + 1;
    val res_reg: err[fail.Fail] = ir.global_register(m, name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }
    ret res[u32, fail.Fail].ok{idx};
}

pub fun add_rodata_bytes(lc: *LowerContext, init: value.Value, pty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val m: *ir.Module = lc.m;
    val res_name: res[intern.StrId, fail.Fail] = anon_global_name(lc, m.global_len);
    if (sel res_name.err) { ret res[value.Value, fail.Fail].err{res_name.err}; }

    if (m.global_len == m.global_cap) {
        val new_cap: u32 = grow_cap(m.global_cap);
        val res_grow: res[*ir.Global, A.Error] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, new_cap::usize);
        if (sel res_grow.err) { ret res[value.Value, fail.Fail].err{fail.refused(res_grow.err)}; }
        m.globals    = res_grow.ok;
        m.global_cap = new_cap;
    }

    val idx: u32 = m.global_len;
    var g: ir.Global;
    g.name      = res_name.ok;
    g.ty        = init.ty;
    g.init      = init;
    g.is_mut    = false;
    g.is_pub    = false;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = true;
    g.is_embed  = false;
    g.align     = 0;
    g.section   = intern.STR_NIL;
    m.globals[idx] = g;
    m.global_len   = m.global_len + 1;

    ret res[value.Value, fail.Fail].ok{value.global(idx, pty)};
}

fun anon_global_name(lc: *LowerContext, n: u32) res[intern.StrId, fail.Fail] {
    var buf: [16]u8;
    buf[0] = '.';
    buf[1] = 'L';
    buf[2] = 'c';
    buf[3] = '.';
    var len: usize = 4;
    var d: u32 = 0;
    for (d < 8) {
        val shift: u32 = (7 - d) * 4;
        val nib: u32 = (n >> shift) & 0xF;
        var c: u8 = nib::u8 + 0x30;
        if (nib > 9) { c = nib::u8 - 10 + 0x61; }
        buf[len] = c;
        len = len + 1;
        d = d + 1;
    }
    val r_1824: res[intern.StrId, A.Error] = intern.intern_bytes(?lc.s.interner, (?buf[0])::str, len);
    if (sel r_1824.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_1824.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_1824.ok};
}

fun grow_cap(cap: u32) u32 {
    if (cap == 0) { ret 4; }
    ret cap * 2;
}

fun enqueue_distinct_instances(lc: *LowerContext, first: u32, count: u32) err[fail.Fail] {
    var i: u32 = first;
    for (i < first + count) {
        val r: err[fail.Fail] = enqueue_instance(lc, 0::id.DeclId, 0::session.ModuleId, nil, 0, i::intern.StrId, i::intern.StrId);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[fail.Fail].ok{};
}

fun time_enqueue_fresh(count: u32) i64 {
    var alloc: A.Allocator;
    val r_1844: err[A.Error] = page.make(?alloc);
    if (sel r_1844.err) { ret -1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret -1; }
    var s: session.Session = sr.ok;

    var lc: LowerContext;
    lc.status = fail.accepted();
    lc.s            = ?s;
    lc.diags = ?s.diags;
    lc.scope        = scope_nil();
    lc.inst_len     = 0;
    lc.inst_cap     = 0;
    lc.insts        = nil;
    lc.inst_by_name = map.init[intern.StrId, u32](?alloc, map.hash_u32, map.eq_u32);

    val started: tm.Clock = tm.monotonic();
    if (sel started.err) { ret -1; }
    val ok: err[fail.Fail] = enqueue_distinct_instances(?lc, 0, count);
    val stopped: tm.Clock = tm.monotonic();
    if (sel stopped.err) { ret -1; }
    val elapsed: duration.Duration = tm.time_sub(stopped.ok, started.ok);
    if (sel ok.err) { ret -1; }

    var i: u32 = 0;
    for (i < lc.inst_len) {
        if (lc.insts[i].args != nil && lc.insts[i].arg_len > 0) {
            A.deallocate[type.TypeId](?alloc, lc.insts[i].args, lc.insts[i].arg_len::usize);
        }
        i = i + 1;
    }
    if (lc.insts != nil && lc.inst_cap > 0) { A.deallocate[Instance](?alloc, lc.insts, lc.inst_cap::usize); }
    map.dnit[intern.StrId, u32](?lc.inst_by_name);

    ret duration.duration_usec(elapsed);
}

fun time_enqueue_min(count: u32, reps: u32) i64 {
    var best: i64 = -1;
    var r: u32 = 0;
    for (r < reps) {
        val us: i64 = time_enqueue_fresh(count);
        if (us < 0) { ret -1; }
        if (best < 0 || us < best) { best = us; }
        r = r + 1;
    }
    ret best;
}

test "mach.lang.me.lower.context.scope_leave:refuses_a_stale_or_out_of_order_mark" {
    var alloc: A.Allocator;
    val r_1891: err[A.Error] = page.make(?alloc);
    if (sel r_1891.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var lc: LowerContext;
    lc.status = fail.accepted();
    lc.s                = ?s;
    lc.diags = ?s.diags;
    lc.scopes           = nil;
    lc.scope_len        = 0;
    lc.scope_cap        = 0;
    lc.scope_generation = 0;
    lc.scope_top        = 0;

    var home: ModuleScope = scope_nil();
    home.fqn = 11::intern.StrId;
    lc.scope = home;

    var first: ModuleScope = scope_nil();
    first.fqn = 22::intern.StrId;
    var second: ModuleScope = scope_nil();
    second.fqn = 33::intern.StrId;

    var code: i32 = 0;

    val m1r: res[ScopeMark, fail.Fail] = scope_enter(?lc, first);
    if (sel m1r.err) { ret 1; }
    val m1: ScopeMark = m1r.ok;
    if (lc.scope.fqn != 22::intern.StrId) { code = 1; }

    val m2r: res[ScopeMark, fail.Fail] = scope_enter(?lc, second);
    if (sel m2r.err) { ret 1; }
    val m2: ScopeMark = m2r.ok;
    if (lc.scope.fqn != 33::intern.StrId) { code = 1; }

    val r_1927: err[fail.Fail] = scope_leave(?lc, m1);
    if (sel r_1927.ok) { code = 1; }
    if (lc.scope.fqn != 33::intern.StrId) { code = 1; }
    if (lc.scope_len != 2) { code = 1; }

    val r_1931: err[fail.Fail] = scope_leave(?lc, m2);
    if (sel r_1931.err) { code = 1; }
    if (lc.scope.fqn != 22::intern.StrId) { code = 1; }

    val r_1934: err[fail.Fail] = scope_leave(?lc, m2);
    if (sel r_1934.ok) { code = 1; }

    val r_1936: err[fail.Fail] = scope_leave(?lc, m1);
    if (sel r_1936.err) { code = 1; }
    if (lc.scope.fqn != 11::intern.StrId) { code = 1; }
    if (lc.scope_len != 0) { code = 1; }

    var other: LowerContext;
    other.status = fail.accepted();
    other.s = ?s;
    val r_1943: err[fail.Fail] = scope_leave(?other, m1);
    if (sel r_1943.ok) { code = 1; }

    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](?alloc, lc.scopes, lc.scope_cap::usize);
    }
    ret code;
}

fun fixture_definition(raw: ptr, origin: session.ModuleId, phase: scx.DefinitionPhase) res[scx.Definition, fail.Fail] {
    val current: *scx.Definition = raw::*scx.Definition;
    if (current == nil || current.origin != origin) {
        ret res[scx.Definition, fail.Fail].err{fail.message("fixture definition owner differs")};
    }
    ret res[scx.Definition, fail.Fail].ok{@current};
}

test "mach.lang.me.lower.context.module_scope:refuses_a_piece_that_belongs_to_another_module" {
    var alloc: A.Allocator;
    val r_1961: err[A.Error] = page.make(?alloc);
    if (sel r_1961.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var a1:  ast.Ast;
    var a2:  ast.Ast;
    var sm1: sema.SemaResult = sema.SemaResult{};
    var sm2: sema.SemaResult = sema.SemaResult{};
    var rr1: resolve.ResolveResult;
    var rr2: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    var cc2: comptime.ComptimeCtx;

    a1.incarnation = 1;
    a1.file_id = 0::source.FileId;
    rr1.status = fail.accepted();
    sm1.status = fail.accepted();

    val mid: session.ModuleId = 0::session.ModuleId;
    val fqn: intern.StrId     = 7::intern.StrId;

    val ri: err[fail.Fail] = session.register_module_identity(?s, mid, ?a1, fqn, 5);
    if (sel ri.err) { ret 1; }
    val rp: err[fail.Fail] = session.register_module_phase(?s, mid, (?sm1)::ptr, (?rr1)::ptr, (?cc1)::ptr);
    if (sel rp.err) { ret 1; }

    var current: scx.Definition = scx.Definition{
        parsed: resolve.ParsedDefinition{ a: ?a1, owner: resolve.type_owner(?s, mid, a1.file_id), incarnation: a1.incarnation },
        origin: mid, rr: ?rr1, sr: ?sm1, ctx: ?cc1
    };
    var deps: sema.SemaDeps = sema.SemaDeps{
        definitions: scx.reader_init((?current)::ptr, fixture_definition, ?alloc)
    };
    fin { scx.reader_dnit(?deps.definitions); }

    var code: i32 = 0;

    cc1.env.pointer_width = 99;
    val good: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel good.err) { ret 1; }
    val sc: ModuleScope = good.ok;
    if (sc.env.pointer_width != 99) { code = 1; }
    cc1.env.pointer_width = 12;
    if (sc.env.pointer_width != 99) { code = 1; }

    val r_2008: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a2, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2008.ok) { code = 1; }
    val r_2009: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, 8::intern.StrId, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2009.ok) { code = 1; }
    val r_2010: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm2, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2010.ok) { code = 1; }
    val r_2011: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr2, ?cc1, ?deps.definitions);
    if (sel r_2011.ok) { code = 1; }
    val r_2012: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, ?cc2, ?deps.definitions);
    if (sel r_2012.ok) { code = 1; }
    val r_2013: res[ModuleScope, fail.Fail] = module_scope(?s, mid, nil, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2013.ok) { code = 1; }
    val r_2014: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, nil, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2014.ok) { code = 1; }
    val r_2015: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, nil, ?cc1, ?deps.definitions);
    if (sel r_2015.ok) { code = 1; }
    val r_2016: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, nil, ?deps.definitions);
    if (sel r_2016.ok) { code = 1; }
    val r_2017: res[ModuleScope, fail.Fail] = module_scope(?s, 1::session.ModuleId, ?a1, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2017.ok) { code = 1; }

    ret code;
}

test "mach.lang.me.lower.context.request:refuses_a_module_product_that_does_not_correspond" {
    var alloc: A.Allocator;
    val r_2024: err[A.Error] = page.make(?alloc);
    if (sel r_2024.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var a1:  ast.Ast;
    var a2:  ast.Ast;
    var sm1: sema.SemaResult = sema.SemaResult{};
    var rr1: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    var tgt: target.Target;

    a1.incarnation = 1;
    a1.file_id = 0::source.FileId;
    rr1.status = fail.accepted();
    sm1.status = fail.accepted();

    val mid: session.ModuleId = 0::session.ModuleId;
    val fqn: intern.StrId     = 7::intern.StrId;

    val ri: err[fail.Fail] = session.register_module_identity(?s, mid, ?a1, fqn, 5);
    if (sel ri.err) { ret 1; }
    val rp: err[fail.Fail] = session.register_module_phase(?s, mid, (?sm1)::ptr, (?rr1)::ptr, (?cc1)::ptr);
    if (sel rp.err) { ret 1; }

    var current: scx.Definition = scx.Definition{
        parsed: resolve.ParsedDefinition{ a: ?a1, owner: resolve.type_owner(?s, mid, a1.file_id), incarnation: a1.incarnation },
        origin: mid, rr: ?rr1, sr: ?sm1, ctx: ?cc1
    };
    var deps: sema.SemaDeps = sema.SemaDeps{
        definitions: scx.reader_init((?current)::ptr, fixture_definition, ?alloc)
    };
    fin { scx.reader_dnit(?deps.definitions); }

    var code: i32 = 0;

    val good: res[LowerRequest, fail.Fail] = request(?s, ?tgt, ?alloc, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, false, false, true, nil, ?deps);
    if (sel good.err) { ret 1; }
    val req: LowerRequest = good.ok;
    if (req.module.a != ?a1 || req.module.own_module != mid) { code = 1; }

    val r_2066: res[LowerRequest, fail.Fail] = request(?s, nil, ?alloc, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, false, false, true, nil, ?deps);
    if (sel r_2066.ok) { code = 1; }
    val r_2067: res[LowerRequest, fail.Fail] = request(?s, ?tgt, nil, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, false, false, true, nil, ?deps);
    if (sel r_2067.ok) { code = 1; }
    val r_2068: res[LowerRequest, fail.Fail] = request(?s, ?tgt, ?alloc, ?a2, fqn, mid, ?sm1, ?rr1, ?cc1, false, false, true, nil, ?deps);
    if (sel r_2068.ok) { code = 1; }

    ret code;
}

test "mach.lang.me.lower.context.enqueue_instance:cost_stays_near_linear_as_population_grows" {
    val small: u32 = 1500;
    val large: u32 = small * 4;

    val us_small: i64 = time_enqueue_min(small, 7);
    val us_large: i64 = time_enqueue_min(large, 7);
    if (us_small < 0 || us_large < 0) { ret 1; }

    var pa: A.Allocator;
    page.make(?pa);
    val msg: res[str, format.FormatError] = format.sprint(?pa, "us_small={} us_large={}\n", us_small, us_large);
    if (sel msg.ok) { print.eprint(msg.ok); }

    var bad: i32 = 0;
    if (us_large > us_small * 8) { bad = 1; }
    ret bad;
}

test "mach.lang.me.lower.context.enqueue_pack_instance:refuses_past_the_instance_cap" {
    var alloc: A.Allocator;
    val r_2093: err[A.Error] = page.make(?alloc);
    if (sel r_2093.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var lc: LowerContext;
    lc.status = fail.accepted();
    lc.s            = ?s;
    lc.diags = ?s.diags;
    lc.pinst_len    = 0;
    lc.pinst_cap    = 0;
    lc.pinsts       = nil;
    lc.pinst_by_name = map.init[intern.StrId, u32](?alloc, map.hash_u32, map.eq_u32);

    var code: i32 = 0;
    var i: u32 = 0;
    for (i < MAX_PACK_INSTANCES) {
        val r: err[fail.Fail] = enqueue_pack_instance(?lc, 0::id.DeclId, 0::session.ModuleId, nil, 0, nil, 0, i::intern.StrId);
        if (sel r.err) { code = 1; brk; }
        i = i + 1;
    }
    if (lc.pinst_len != MAX_PACK_INSTANCES) { code = 1; }

    val over: err[fail.Fail] = enqueue_pack_instance(?lc, 0::id.DeclId, 0::session.ModuleId, nil, 0, nil, 0, MAX_PACK_INSTANCES::intern.StrId);
    if (sel over.ok) { code = 1; }
    if (lc.pinst_len != MAX_PACK_INSTANCES) { code = 1; }

    var j: u32 = 0;
    for (j < lc.pinst_len) {
        if (lc.pinsts[j].args != nil && lc.pinsts[j].arg_len > 0) {
            A.deallocate[type.TypeId](?alloc, lc.pinsts[j].args, lc.pinsts[j].arg_len::usize);
        }
        if (lc.pinsts[j].types != nil && lc.pinsts[j].type_len > 0) {
            A.deallocate[type.TypeId](?alloc, lc.pinsts[j].types, lc.pinsts[j].type_len::usize);
        }
        j = j + 1;
    }
    if (lc.pinsts != nil && lc.pinst_cap > 0) { A.deallocate[PackInstance](?alloc, lc.pinsts, lc.pinst_cap::usize); }
    map.dnit[intern.StrId, u32](?lc.pinst_by_name);

    ret code;
}

pub fun recover_type(lc: *LowerContext, r: res[type.TypeId, fail.Fail]) type.TypeId {
    if (sel r.err) {
        fail.internal(?lc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}
