val INITIAL_STACK_CAP: u32 = 8;

pub rec LoopFrame {
    header:    me_ir.BlockId;
    exit:      me_ir.BlockId;
    fin_depth: u32;
}

# a module's test object holds its tests and `#[testing]` declarations beside its
# normal object, which it never changes. every definition the normal object already
# holds is declared in the test object instead, so each symbol has one definition
# ---
# defined: the global symbols the normal object defines
pub rec NormalObject {
    defined: map.Map[intern.StrId, bool];
}

# lowering the test object, which declares `name` because the normal object defines it
pub fun normal_defines(lc: *LowerContext, name: intern.StrId) bool {
    if (lc.normal_object == nil) { ret false; }
    val found: opt[*bool] = map.get[intern.StrId, bool](?lc.normal_object.defined, ?name);
    ret sel found.some;
}

# a lowering that emits nothing and only binds the module's constants, the way its
# normal object's lowering binds them or its test object's binds the `#[testing]` ones
# after those. a lowering that reads a module whose own lowering this session skipped
# binds them first, so a reused object never changes what a constant folds to
pub def BindSweep: u8;
pub val SWEEP_NONE:    BindSweep = 0;
pub val SWEEP_NORMAL:  BindSweep = 1;
pub val SWEEP_TESTING: BindSweep = 2;

pub rec ModuleScope {
    a:           *ast.Ast;
    source:      str;
    fqn:         intern.StrId;
    own_module:  session.ModuleId;
    sema_result: *fe_sema.SemaResult;
    rr:          *resolve.ResolveResult;
    env:         comptime.ComptimeEnv;
    ctx:         *comptime.ComptimeCtx;
    subst:       *type.TypeId;
    subst_len:   u32;
    subst_owner: type.GenericOwner;
    # the typing frame of the lowering module's instance set its code is read through:
    # the module's own typing, an instance's, or one of their iterations; NONE for another
    # module's code read outside an instance
    frame: u32;
}

pub rec ScopeMark {
    owner:      ptr;
    depth:      u32;
    generation: u64;
    parent:     u64;
}

pub rec LowerRequest {
    deps:   *fe_sema.SemaDeps;
    diags:  *diagnostic.DiagnosticStore;
    s:      *session.Session;
    tgt:    *resolved.Target;
    malloc: *A.Allocator;
    module: ModuleScope;
    # nil when lowering the module's normal object; when lowering its test object, what
    # the normal object defines
    normal_object: *NormalObject;
    # the artifact this lowering feeds is a shared library, so a `fwd` that
    # exports nothing is worth a warning
    shared_artifact: bool;
    debug:           bool;
    checks:          bool;
}

rec LogicalTypePath {
    ty:       type.TypeId;
    previous: *LogicalTypePath;
}

pub rec LowerContext {
    logical_type_path: *LogicalTypePath;
    # the function whose signature lower_fn_sig lowers, and the annotation in it
    # being lowered, which a refusal raised outside any body points at
    sig_decl:         ast_id.DeclId;
    sig_site:         lang_source.Span;
    sig_site_set:     bool;
    deps:             *fe_sema.SemaDeps;
    diags:            *diagnostic.DiagnosticStore;
    status:           fail.PhaseStatus;
    s:                *session.Session;
    tgt:              *resolved.Target;
    scope:            ModuleScope;
    scopes:           *ModuleScope;
    scope_len:        u32;
    scope_cap:        u32;
    scope_generation: u64;
    scope_top:        u64;
    caps:             comptime.PhaseCapabilities[LowerContext];
    shared_artifact:  bool;
    debug:            bool;
    # debug-profile runtime checks: the release pipeline emits none
    checks:      bool;
    m:           *me_ir.Module;
    builder:     builder.Builder;
    locals:      map.Map[resolve.SymbolId, value.Value];
    local_names: map.Map[intern.StrId, LocalBinding];

    fn_index:   u32;
    ret_type:   ir_type.IrTypeId;
    fn_ret_sem: type.TypeId;

    loops:    *LoopFrame;
    loop_len: u32;
    loop_cap: u32;

    fins:    *ast_id.StmtId;
    fin_len: u32;
    fin_cap: u32;

    # the instances the lowering module's sema discovered, with their typing
    instances: *fe_sema.instance.Set;

    pack_slots:    *value.Value;
    pack_types:    *type.TypeId;
    pack_len:      u32;
    pack_ret_type: type.TypeId;

    normal_object: *NormalObject;
    sweep:         BindSweep;

    # while armed, the call argument whose aggregate read may use its source in place;
    # borrow_now says the read being lowered is that one, borrow_hit that it did
    borrow_armed: bool;
    borrow_eid:   ast_id.ExprId;
    borrow_now:   bool;
    borrow_hit:   bool;
    # the expression statement being lowered, whose value nothing reads
    discard_eid: ast_id.ExprId;
}

fun scope_nil() ModuleScope {
    var sc: ModuleScope;
    sc.a           = nil;
    sc.source      = nil;
    sc.fqn         = intern.STR_NIL;
    sc.own_module  = module.id(0);
    sc.sema_result = nil;
    sc.rr          = nil;
    sc.ctx         = nil;
    sc.subst       = nil;
    sc.subst_len   = 0;
    sc.frame       = fe_sema.instance.NONE;
    ret sc;
}

pub fun module_scope(
    s: *session.Session,
    own_module: session.ModuleId,
    a: *ast.Ast,
    fqn: intern.StrId,
    sema_result: *fe_sema.SemaResult,
    rr: *resolve.ResolveResult,
    ctx: *comptime.ComptimeCtx,
    definitions: *fe_sema.DefinitionReader) res[ModuleScope, fail.Fail] {
    if (s == nil)           { ret res[ModuleScope, fail.Fail].err{fail.message("lower: a module scope requires a session")}; }
    if (a == nil)           { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no parsed AST")}; }
    if (sema_result == nil) { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no semantic result")}; }
    if (rr == nil)          { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no name-resolution result")}; }
    if (ctx == nil)         { ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope has no comptime context")}; }

    val acquired: res[fe_sema.Definition, fail.Fail] = fe_sema.acquire_definition(definitions, own_module, fe_sema.DEFINITION_TYPED);
    if (sel acquired.err) { ret res[ModuleScope, fail.Fail].err{acquired.err}; }
    val current: fe_sema.Definition = acquired.ok;
    if (current.parsed.a != a || current.sr != sema_result || current.rr != rr || current.ctx != ctx) {
        ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope does not match its acquired definition")};
    }
    if (!intern.str_same(session.module_fqn(s, own_module), fqn)) {
        ret res[ModuleScope, fail.Fail].err{fail.message("lower: module scope name belongs to another module")};
    }

    val source: res[str, fail.Fail] = ast_source(s, a);
    if (sel source.err) { ret res[ModuleScope, fail.Fail].err{source.err}; }

    var sc: ModuleScope = scope_nil();
    sc.a           = a;
    sc.source      = source.ok;
    sc.fqn         = fqn;
    sc.own_module  = own_module;
    sc.sema_result = sema_result;
    sc.rr          = rr;
    sc.env         = comptime.environment(ctx);
    sc.ctx         = ctx;
    ret res[ModuleScope, fail.Fail].ok{sc};
}

pub fun origin_scope(lc: *LowerContext, origin: session.ModuleId) res[ModuleScope, fail.Fail] {
    if (module.same(origin, lc.scope.own_module)) { ret res[ModuleScope, fail.Fail].ok{lc.scope}; }
    if (lc.deps == nil)                           { ret res[ModuleScope, fail.Fail].err{fail.message("lower: foreign definition requires scoped dependencies")}; }
    val acquired: res[fe_sema.Definition, fail.Fail] = fe_sema.acquire_definition(?lc.deps.definitions, origin, fe_sema.DEFINITION_TYPED);
    if (sel acquired.err) { ret res[ModuleScope, fail.Fail].err{acquired.err}; }
    val current: fe_sema.Definition = acquired.ok;
    ret module_scope(lc.s, origin, current.parsed.a, session.module_fqn(lc.s, origin), current.sr, current.rr, current.ctx, ?lc.deps.definitions);
}

pub fun request(
    s: *session.Session,
    tgt: *resolved.Target,
    malloc: *A.Allocator,
    a: *ast.Ast,
    fqn: intern.StrId,
    own_module: session.ModuleId,
    sema_result: *fe_sema.SemaResult,
    rr: *resolve.ResolveResult,
    ctx: *comptime.ComptimeCtx,
    normal_object: *NormalObject,
    shared_artifact: bool,
    debug: bool,
    checks: bool,
    diags: *diagnostic.DiagnosticStore,
    deps: *fe_sema.SemaDeps) res[LowerRequest, fail.Fail] {
    if (tgt == nil)    { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires a resolved target")}; }
    if (malloc == nil) { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires an allocator")}; }

    if (deps == nil) { ret res[LowerRequest, fail.Fail].err{fail.message("lower: a lowering request requires scoped dependencies")}; }
    val sr: res[ModuleScope, fail.Fail] = module_scope(s, own_module, a, fqn, sema_result, rr, ctx, ?deps.definitions);
    if (sel sr.err) { ret res[LowerRequest, fail.Fail].err{sr.err}; }

    var req: LowerRequest;
    req.s               = s;
    req.deps            = deps;
    req.diags           = diags;
    req.tgt             = tgt;
    req.malloc          = malloc;
    req.module          = sr.ok;
    req.module.frame    = fe_sema.instance.FRAME_TEMPLATE;
    req.normal_object   = normal_object;
    req.shared_artifact = shared_artifact;
    req.debug           = debug;
    req.checks          = checks;
    ret res[LowerRequest, fail.Fail].ok{req};
}

pub fun scope_enter(lc: *LowerContext, next: ModuleScope) res[ScopeMark, fail.Fail] {
    if (lc == nil) { ret res[ScopeMark, fail.Fail].err{fail.message("lower: scope_enter requires a context")}; }
    if (lc.scope_generation == 0xFFFFFFFFFFFFFFFF) {
        ret res[ScopeMark, fail.Fail].err{fail.message("lower: module scope generation exhausted")};
    }
    val grown: err[A.Error] = growth.reserve[ModuleScope](lc.s.alloc, ?lc.scopes, ?lc.scope_cap, lc.scope_len::usize + 1);
    if (sel grown.err) { ret res[ScopeMark, fail.Fail].err{fail.refused(grown.err)}; }

    lc.scopes[lc.scope_len] = lc.scope;
    lc.scope_len            = lc.scope_len + 1;

    var mark: ScopeMark;
    mark.owner      = lc::ptr;
    mark.depth      = lc.scope_len;
    mark.generation = lc.scope_generation + 1;
    mark.parent     = lc.scope_top;

    lc.scope_generation = mark.generation;
    lc.scope_top        = mark.generation;
    lc.scope            = next;
    ret res[ScopeMark, fail.Fail].ok{mark};
}

pub fun scope_leave(lc: *LowerContext, mark: ScopeMark) err[fail.Fail] {
    if (lc == nil || mark.owner != lc::ptr) {
        ret err[fail.Fail].err{fail.message("lower: scope_leave mark belongs to another context")};
    }
    if (mark.generation == 0 || mark.generation != lc.scope_top || mark.depth != lc.scope_len) {
        ret err[fail.Fail].err{fail.message("lower: scope_leave mark is stale or out of order")};
    }
    lc.scope_len = lc.scope_len - 1;
    lc.scope     = lc.scopes[lc.scope_len];
    lc.scope_top = mark.parent;
    ret err[fail.Fail].ok{};
}

pub fun init_context(lc: *LowerContext, req: *LowerRequest, m: *me_ir.Module) err[fail.Fail] {
    if (req == nil) { ret err[fail.Fail].err{fail.message("lower: init_context requires a lowering request")}; }
    val s: *session.Session = req.s;
    lc.status            = fail.accepted();
    lc.logical_type_path = nil;
    lc.sig_decl          = ast_id.DECL_NIL;
    lc.sig_site_set      = false;
    lc.s                 = s;
    lc.deps              = req.deps;
    lc.diags             = req.diags;
    lc.tgt               = req.tgt;
    lc.scope             = req.module;
    lc.scopes            = nil;
    lc.scope_len         = 0;
    lc.scope_cap         = 0;
    lc.scope_generation  = 0;
    lc.scope_top         = 0;
    lc.normal_object     = req.normal_object;
    lc.sweep             = SWEEP_NONE;
    lc.shared_artifact   = req.shared_artifact;
    lc.debug             = req.debug;
    lc.checks            = req.checks;
    lc.m                 = m;
    m.root_project       = session.module_is_root_project(s, req.module.own_module);
    lc.builder           = builder.init(m);

    val caps_r: res[comptime.PhaseCapabilities[LowerContext], fail.Fail] = comptime.lowering_capabilities[LowerContext](
        resolve_module_member_const,
        resolve_type_comparison_operand,
        resolve_field_member,
        resolve_type_query,
        resolve_layout_intrinsic,
        resolve_scalar_cast, resolve_scalar_value,
        comptime_ident_is_runtime, comptime_expression);
    if (sel caps_r.err) {
        ret err[fail.Fail].err{caps_r.err};
    }
    lc.caps = caps_r.ok;

    lc.locals      = map.init[resolve.SymbolId, value.Value](s.alloc);
    lc.local_names = map.init[intern.StrId, LocalBinding](s.alloc);

    lc.fn_index   = 0;
    lc.ret_type   = ir_type.IRT_NIL;
    lc.fn_ret_sem = type.TYPE_NIL;

    val res_loops: res[*LoopFrame, A.Error] = A.allocate[LoopFrame](s.alloc, INITIAL_STACK_CAP::usize);
    if (sel res_loops.err) {
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret err[fail.Fail].err{fail.refused(res_loops.err)};
    }
    lc.loops    = res_loops.ok;
    lc.loop_len = 0;
    lc.loop_cap = INITIAL_STACK_CAP;

    val res_fins: res[*ast_id.StmtId, A.Error] = A.allocate[ast_id.StmtId](s.alloc, INITIAL_STACK_CAP::usize);
    if (sel res_fins.err) {
        A.deallocate[LoopFrame](s.alloc, lc.loops, lc.loop_cap::usize);
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret err[fail.Fail].err{fail.refused(res_fins.err)};
    }
    lc.fins         = res_fins.ok;
    lc.fin_len      = 0;
    lc.fin_cap      = INITIAL_STACK_CAP;
    lc.borrow_armed = false;
    lc.borrow_eid   = ast_id.EXPR_NIL;
    lc.borrow_now   = false;
    lc.borrow_hit   = false;
    lc.discard_eid  = ast_id.EXPR_NIL;

    lc.instances = ?req.module.sema_result.instances;

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;

    ret err[fail.Fail].ok{};
}

pub fun dnit_context(lc: *LowerContext) {
    if (lc == nil) { ret; }
    map.dnit[intern.StrId, LocalBinding](?lc.local_names);
    map.dnit[resolve.SymbolId, value.Value](?lc.locals);

    if (lc.loops != nil && lc.loop_cap > 0) {
        A.deallocate[LoopFrame](lc.s.alloc, lc.loops, lc.loop_cap::usize);
    }
    if (lc.fins != nil && lc.fin_cap > 0) {
        A.deallocate[ast_id.StmtId](lc.s.alloc, lc.fins, lc.fin_cap::usize);
    }
    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](lc.s.alloc, lc.scopes, lc.scope_cap::usize);
    }
    lc.scope     = scope_nil();
    lc.scopes    = nil;
    lc.scope_len = 0;
    lc.scope_cap = 0;
    lc.scope_top = 0;

    lc.loops        = nil;
    lc.loop_len     = 0;
    lc.loop_cap     = 0;
    lc.fins         = nil;
    lc.fin_len      = 0;
    lc.fin_cap      = 0;
    lc.borrow_armed = false;
    lc.borrow_eid   = ast_id.EXPR_NIL;
    lc.borrow_now   = false;
    lc.borrow_hit   = false;
    lc.discard_eid  = ast_id.EXPR_NIL;

    lc.instances = nil;

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;
}

pub fun symbol_definition(lc: *LowerContext, sym: *resolve.Symbol) res[fe_sema.DefinedSymbol, fail.Fail] {
    if (module.same(sym.origin, lc.scope.own_module)) {
        if (ast_id.decl_is_nil(sym.decl) || ast_id.decl_index(sym.decl) >= lc.scope.a.decl_len::u32) {
            val reason: fail.Fail = fail.message("lower: symbol has no declaration in its active owner");
            fail.internal(?lc.status, fail.describe(reason));
            ret res[fe_sema.DefinedSymbol, fail.Fail].err{reason};
        }
        val parsed: resolve.ParsedDefinition = resolve.ParsedDefinition{
            a: lc.scope.a, owner: resolve.type_owner(lc.s, sym.origin, lc.scope.a.file_id), incarnation: lc.scope.a.incarnation
        };
        ret res[fe_sema.DefinedSymbol, fail.Fail].ok{fe_sema.DefinedSymbol{
            definition: fe_sema.Definition{parsed: parsed, origin: sym.origin, rr: lc.scope.rr,
                sr: lc.scope.sema_result, ctx: lc.scope.ctx, decorators: lc.scope.ctx}, symbol: @sym
        }};
    }
    if (lc.deps == nil) {
        val reason: fail.Fail = fail.message("lower: foreign symbol requires scoped dependencies");
        fail.internal(?lc.status, fail.describe(reason));
        ret res[fe_sema.DefinedSymbol, fail.Fail].err{reason};
    }
    val acquired: res[fe_sema.DefinedSymbol, fail.Fail] = fe_sema.acquire_symbol(?lc.deps.definitions, sym, fe_sema.DEFINITION_TYPED);
    if (sel acquired.err) {
        val reason: fail.Fail = acquired.err;
        if (sel reason.reported) { fail.reject(?lc.status); }
        or                       { fail.internal(?lc.status, fail.describe(reason)); }
    }
    ret acquired;
}

pub fun declaring_comptime_ctx(lc: *LowerContext, sym: *resolve.Symbol) *comptime.ComptimeCtx {
    if (module.same(sym.origin, lc.scope.own_module)) { ret lc.scope.ctx; }
    val acquired: res[fe_sema.DefinedSymbol, fail.Fail] = symbol_definition(lc, sym);
    if (sel acquired.err) { ret nil; }
    ret acquired.ok.definition.ctx;
}

pub fun gated_lower_member_const_message(lc: *LowerContext, name: intern.StrId, dep_fqn: intern.StrId) res[str, fail.Fail] {
    if (intern.str_is_nil(dep_fqn)) { ret res[str, fail.Fail].err{fail.message("lower: a tuple-dependent constant's module has no stable name")}; }
    ret fail.format_intern(?lc.s.interner, lc.s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        intern.text(?lc.s.interner, name), intern.text(?lc.s.interner, dep_fqn));
}

pub fun report_gate(lc: *LowerContext, k: diagnostic_kind.Kind, span: lang_source.Span, message: str) fail.Fail {
    fail.reject(?lc.status);
    val r: err[fail.Fail] = diagnostic.report(lc.diags, k, lc.scope.a.file_id, span, message);
    if (sel r.err) { fail.internal(?lc.status, fail.describe(r.err)); }
    ret fail.phase_failure(lc.status);
}

pub fun record_eval_result(lc: *LowerContext, r: res[comptime.CTValue, comptime.EvalFail]) {
    if (sel r.ok) { ret; }
    val f: comptime.EvalFail = r.err;
    if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?lc.status, f.message); }
}

pub fun expression(lc: *LowerContext, eid: ast_id.ExprId) res[ast_expr.Expr, fail.Fail] {
    val result: res[ast_expr.Expr, fail.Fail] = resolve.expression(lc.scope.rr, lc.scope.a, eid);
    if (sel result.err) {
        fail.internal(?lc.status, fail.describe(result.err));
        ret result;
    }
    if (result.ok.kind == ast_expr.EXPR_KIND_ERROR) {
        val message: str = "lowering cannot consume a rejected expression";
        fail.internal(?lc.status, message);
        ret res[ast_expr.Expr, fail.Fail].err{fail.message(message)};
    }
    ret result;
}

fun comptime_expression(lc: *LowerContext, a: *ast.Ast, eid: ast_id.ExprId) res[ast_expr.Expr, comptime.EvalFail] {
    if (lc == nil || lc.scope.a != a) { ret res[ast_expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "lowering expression belongs to a different parsed owner")}; }
    val result: res[ast_expr.Expr, fail.Fail] = expression(lc, eid);
    if (sel result.err) {
        ret res[ast_expr.Expr, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(result.err))};
    }
    ret res[ast_expr.Expr, comptime.EvalFail].ok{result.ok};
}

pub fun resolve_module_member_const(lc: *LowerContext, eid: ast_id.ExprId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val rr: *resolve.ResolveResult = lc.scope.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sid: resolve.SymbolId = rr.expr_resolved[ast_id.expr_index(eid)];
    if (resolve.symbol_is_nil(sid) || sid::u32 >= rr.symbol_count) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val sym: *resolve.Symbol = ?rr.symbols[resolve.symbol_index(sid)];
    if (sym.kind != resolve.SYM_IMPORTED) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val octx: *comptime.ComptimeCtx = declaring_comptime_ctx(lc, sym);
    if (octx == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val nc: opt[comptime.NamedConst] = comptime.lookup(octx, sym.name);
    if (sel nc.none) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    val named: comptime.NamedConst = nc.some;
    if (named.gated && lc.scope.env.union_build) {
        val msg_r: res[str, fail.Fail] = gated_lower_member_const_message(lc, sym.name, session.module_fqn(lc.s, sym.origin));
        if (sel msg_r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(msg_r.err, diagnostic_kind.CONST_TUPLE_DEPENDENT, "")}; }
        val msg:   str                           = msg_r.ok;
        val e_opt: res[ast_expr.Expr, fail.Fail] = expression(lc, eid);
        var span:  lang_source.Span;
        span.offset = 0;
        span.len    = 0;
        if (sel e_opt.ok) { span = e_opt.ok.span; }
        val f: fail.Fail = report_gate(lc, diagnostic_kind.CONST_TUPLE_DEPENDENT, span, msg);
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(f, diagnostic_kind.CONST_TUPLE_DEPENDENT, msg)};
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{named.value}};
}

pub fun comptime_ident_is_runtime(lc: *LowerContext, eid: ast_id.ExprId) bool {
    if (lc == nil || ast_id.expr_is_nil(eid)) { ret false; }
    val rr: *resolve.ResolveResult = lc.scope.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[ast_id.expr_index(eid)];
    if (resolve.symbol_is_nil(sid) || sid::u32 >= rr.symbol_count) { ret false; }
    ret resolve.symbol_is_runtime(?rr.symbols[resolve.symbol_index(sid)]);
}

fun resolve_scalar_value(lc: *LowerContext, eid: ast_id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val ty: type.TypeId = expr_type_of(lc, eid);
    ret comptime.cast_scalar(?lc.s.types, lc.tgt.pointer_width, lc.tgt.model.nan_rule, value, ty, ty, false);
}

fun resolve_scalar_cast(lc: *LowerContext, eid: ast_id.ExprId, value: comptime.CTValue) res[comptime.CTValue, comptime.EvalFail] {
    val expression_r: res[ast_expr.Expr, fail.Fail] = expression(lc, eid);
    if (sel expression_r.err) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, fail.describe(expression_r.err))}; }
    val node: ast_expr.Expr = expression_r.ok;
    if (node.kind != ast_expr.EXPR_KIND_CAST) { ret res[comptime.CTValue, comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_INTERNAL, diagnostic_kind.COMPILER_INTERNAL, "lowering cast capability requires a cast expression")}; }
    ret comptime.cast_scalar(?lc.s.types, lc.tgt.pointer_width, lc.tgt.model.nan_rule, value,
        expr_type_of(lc, node.data.cast.value), type_resolved_of(lc, node.data.cast.ty), node.data.cast.reinterpret);
}

pub fun resolve_type_comparison_operand(lc: *LowerContext, eid: ast_id.ExprId) res[opt[u32], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    val t: type.TypeId = expr_type_of(lc, eid);
    if (type.is_nil(t) || type.is_error(t)) { ret res[opt[u32], comptime.EvalFail].ok{opt[u32].none{}}; }
    if (type.mentions_generic_param(?lc.s.types, t)) {
        ret res[opt[u32], comptime.EvalFail].err{comptime.eval_error(
            comptime.EVAL_FAIL_NEEDS_INSTANCE, diagnostic_kind.COMPTIME_NEEDS_INSTANCE, comptime.COMPTIME_TYPE_NEEDS_INSTANCE_MSG)};
    }
    ret res[opt[u32], comptime.EvalFail].ok{opt[u32].some{t::u32}};
}

pub fun resolve_type_query(lc: *LowerContext, tid: u32, which: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    ret sema_declared.answer_type_query(lc.s, tid, which);
}

pub fun resolve_layout_intrinsic(lc: *LowerContext, eid: u32) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val e:         ast_id.ExprId = eid::ast_id.ExprId;
    val src:       str           = module_source(lc);
    val is_size:   bool          = intrinsic.is_size_of_call(lc.scope.a, src, e);
    val is_align:  bool          = intrinsic.is_align_of_call(lc.scope.a, src, e);
    val is_len:    bool          = intrinsic.is_length_of_call(lc.scope.a, src, e);
    val is_offset: bool          = intrinsic.is_offset_of_call(lc.scope.a, src, e);
    val is_id:     bool          = intrinsic.is_type_id_call(lc.scope.a, src, e);
    if (!is_size && !is_align && !is_len && !is_offset && !is_id) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }

    val arg: ast_id.ExprId = intrinsic.layout_intrinsic_type_arg(lc.scope.a, e);
    if (ast_id.expr_is_nil(arg)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_INTRINSIC_ARITY, "a layout intrinsic takes one type argument")};
    }
    if (is_id) { ret resolve_type_id(lc, substitute_type(lc, expr_type_of(lc, arg))); }
    val op_ty: type.TypeId = type.strip_secret(?lc.s.types, expr_type_of(lc, arg));

    if (is_len) {
        val n_opt: opt[u32] = type.element_count(?lc.s.types, substitute_type(lc, op_ty));
        if (sel n_opt.none) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_LENGTH_OF, "`$length_of` expects a fixed array or a vector")};
        }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(n_opt.some::u64)}};
    }

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, op_ty);
    if (sel res_ir.err) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(res_ir.err, diagnostic_kind.LAYOUT_UNAVAILABLE, "layout lowering was rejected")};
    }
    val op_ir: ir_type.IrTypeId = res_ir.ok;

    var n: u32 = ir_type.byte_size_for_machine(?lc.m.types, op_ir, resolved.layout_machine(lc.tgt));
    if (is_align) { n = ir_type.byte_align_for_machine(?lc.m.types, op_ir, resolved.layout_machine(lc.tgt)); }
    if (is_offset) {
        # type checking already tied the member to a field or payload case of the operand type
        val member: opt[u32] = offset_of_member_index(lc, e, substitute_type(lc, op_ty));
        if (sel member.none) {
            ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_OFFSET_OF, "`$offset_of` names a member the operand type does not have")};
        }
        n = ir_type.member_offset_for_machine(?lc.m.types, op_ir, member.some, resolved.layout_machine(lc.tgt));
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(n::u64)}};
}

# the identity keeps `^`: a secret is a different type from its base
fun resolve_type_id(lc: *LowerContext, tid: type.TypeId) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (type.is_nil(tid) || type.is_error(tid)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
    }
    if (type.mentions_generic_param(?lc.s.types, tid)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(
            comptime.EVAL_FAIL_NEEDS_INSTANCE, diagnostic_kind.COMPTIME_NEEDS_INSTANCE, comptime.COMPTIME_TYPE_NEEDS_INSTANCE_MSG)};
    }
    val r: res[u64, fail.Fail] = recipe.identity(lc.s, lc.scope.env.target_defs, tid);
    if (sel r.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(r.err, diagnostic_kind.COMPTIME_TYPE_ID, "`$type_id` has no identity for this type")}; }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(r.ok)}};
}

fun offset_of_member_index(lc: *LowerContext, call_eid: ast_id.ExprId, owner: type.TypeId) opt[u32] {
    val c_opt: res[ast_expr.Expr, fail.Fail] = expression(lc, call_eid);
    if (sel c_opt.err) { ret opt[u32].none{}; }
    val c: ast_expr.Expr = c_opt.ok;
    if (c.kind != ast_expr.EXPR_KIND_CALL || c.data.call.args_len < 2) { ret opt[u32].none{}; }
    val m_opt: res[ast_expr.Expr, fail.Fail] = expression(lc, lc.scope.a.expr_ids[c.data.call.args_start + 1]);
    if (sel m_opt.err)                             { ret opt[u32].none{}; }
    if (m_opt.ok.kind != ast_expr.EXPR_KIND_IDENT) { ret opt[u32].none{}; }
    val r_name: res[intern.StrId, A.Error] = intern.range_add(?lc.s.interner, module_source(lc), m_opt.ok.data.ident.tok.offset, m_opt.ok.data.ident.tok.len);
    if (sel r_name.err) { ret opt[u32].none{}; }
    val name: intern.StrId = r_name.ok;
    val n:    u32          = type.field_count(?lc.s.types, owner);
    var i:    u32          = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(?lc.s.types, owner, i);
        if (sel fa.some && intern.str_same(fa.some.name, name)) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

pub fun resolve_field_member(lc: *LowerContext, owner: u32, index: u32, pick: u8) res[opt[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val owner_ty: type.TypeId = owner::type.TypeId;

    if (pick == comptime.FIELD_SEL_ZERO_BY_NAME) {
        ret resolve_omitted_field_zero(lc, owner_ty, index::intern.StrId);
    }
    if (pick == comptime.FIELD_SEL_TYPE_BY_NAME) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{fe_sema.field_type_by_name(?lc.s.types, owner_ty, index::intern.StrId)};
    }

    val fa: opt[*type.FieldEntry] = type.field_at(?lc.s.types, owner_ty, index);
    if (sel fa.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
    val fe: *type.FieldEntry = fa.some;

    if (pick == comptime.FIELD_SEL_NAME) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_str(fe.name)}};
    }
    if (pick == comptime.FIELD_SEL_HAS_PAYLOAD) {
        var bit: u8 = 1;
        if (type.is_nil(fe.ty)) { bit = 0; }
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_u8(bit)}};
    }
    if (pick == comptime.FIELD_SEL_CODE) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(index::u64)}};
    }
    if (type.is_nil(fe.ty) && (pick == comptime.FIELD_SEL_TYPE || pick == comptime.FIELD_SEL_OFFSET)) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_error(comptime.EVAL_FAIL_REJECTED, diagnostic_kind.COMPTIME_CASE_NO_PAYLOAD, comptime.COMPTIME_CASE_NO_PAYLOAD_MSG)};
    }
    if (pick == comptime.FIELD_SEL_TYPE) {
        ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_type(fe.ty::u32)}};
    }
    if (pick != comptime.FIELD_SEL_OFFSET) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }

    val res_ir: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, owner_ty);
    if (sel res_ir.err) { ret res[opt[comptime.CTValue], comptime.EvalFail].err{comptime.eval_from_fail(res_ir.err, diagnostic_kind.LAYOUT_UNAVAILABLE, "layout lowering was rejected")}; }
    val ir_id: ir_type.IrTypeId = res_ir.ok;
    val off:   u32              = ir_type.member_offset_for_machine(?lc.m.types, ir_id, index, resolved.layout_machine(lc.tgt));
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_uint(off::u64)}};
}

fun resolve_omitted_field_zero(lc: *LowerContext, owner_ty: type.TypeId, name: intern.StrId) res[opt[comptime.CTValue], comptime.EvalFail] {
    val stripped: type.TypeId = type.strip_secret(?lc.s.types, owner_ty);
    val n:        u32         = type.field_count(?lc.s.types, stripped);
    var i:        u32         = 0;
    for (i < n) {
        val fa: opt[*type.FieldEntry] = type.field_at(?lc.s.types, stripped, i);
        if (sel fa.some) {
            val fe: *type.FieldEntry = fa.some;
            if (intern.str_same(fe.name, name)) {
                val fty: type.TypeId     = type.strip_secret(?lc.s.types, fe.ty);
                val ft:  opt[*type.Type] = type.get(?lc.s.types, fty);
                if (sel ft.none) { ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}}; }
                val kind: type.TypeKind = ft.some.kind;
                val pd:   type.PrimDesc = type.prim_desc(kind);
                if (pd.class == type.PRIM_CLASS_INT) {
                    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_zero_int(!pd.signed, pd.bits::u8)}};
                }
                if (pd.class == type.PRIM_CLASS_FLOAT) {
                    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].some{comptime.ct_float(0.0, type.float_width_of(kind))}};
                }
                ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
            }
        }
        i = i + 1;
    }
    ret res[opt[comptime.CTValue], comptime.EvalFail].ok{opt[comptime.CTValue].none{}};
}

pub fun begin_function(lc: *LowerContext, fn_index: u32, ret_type: ir_type.IrTypeId) {
    map.clear[resolve.SymbolId, value.Value](?lc.locals);
    map.clear[intern.StrId, LocalBinding](?lc.local_names);
    lc.loop_len   = 0;
    lc.fin_len    = 0;
    lc.fn_index   = fn_index;
    lc.ret_type   = ret_type;
    lc.fn_ret_sem = type.TYPE_NIL;

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;
}

pub rec LocalBinding {
    value:   value.Value;
    secrecy: ct.BindSecrecy;
}

pub fun bind_local(lc: *LowerContext, sym: resolve.SymbolId, v: value.Value, secrecy: ct.BindSecrecy) err[fail.Fail] {
    val res_bind: res[bool, A.Error] = map.insert[resolve.SymbolId, value.Value](?lc.locals, sym, v);
    if (sel res_bind.err) { ret err[fail.Fail].err{fail.refused(res_bind.err)}; }

    val opt_sym: opt[*resolve.Symbol] = symbol_of(lc, sym);
    if (sel opt_sym.some) {
        val name: intern.StrId = opt_sym.some.name;
        if (!intern.str_is_nil(name)) {
            var lb: LocalBinding;
            lb.value   = v;
            lb.secrecy = secrecy;
            val inserted: res[bool, A.Error] = map.insert[intern.StrId, LocalBinding](?lc.local_names, name, lb);
            if (sel inserted.err) { ret err[fail.Fail].err{fail.refused(inserted.err)}; }
            ret err[fail.Fail].ok{};
        }
    }
    ret err[fail.Fail].ok{};
}

pub fun lookup_local_name(lc: *LowerContext, name: intern.StrId) opt[LocalBinding] {
    var key:     intern.StrId       = name;
    val res_get: opt[*LocalBinding] = map.get[intern.StrId, LocalBinding](?lc.local_names, ?key);
    if (sel res_get.some) {
        ret opt[LocalBinding].some{@res_get.some};
    }
    ret opt[LocalBinding].none{};
}

pub fun lookup_local(lc: *LowerContext, sym: resolve.SymbolId) opt[value.Value] {
    val res_get: opt[*value.Value] = map.get[resolve.SymbolId, value.Value](?lc.locals, ?sym);
    if (sel res_get.some) {
        ret opt[value.Value].some{@res_get.some};
    }
    ret opt[value.Value].none{};
}

pub fun push_loop(lc: *LowerContext, header: me_ir.BlockId, exit: me_ir.BlockId) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[LoopFrame](lc.s.alloc, ?lc.loops, ?lc.loop_cap, lc.loop_len::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    var f: LoopFrame;
    f.header              = header;
    f.exit                = exit;
    f.fin_depth           = lc.fin_len;
    lc.loops[lc.loop_len] = f;
    lc.loop_len           = lc.loop_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun pop_loop(lc: *LowerContext) {
    if (lc.loop_len > 0) { lc.loop_len = lc.loop_len - 1; }
}

pub fun current_loop(lc: *LowerContext) *LoopFrame {
    if (lc.loop_len == 0) { ret nil; }
    ret ?lc.loops[lc.loop_len - 1];
}

pub fun push_fin(lc: *LowerContext, body: ast_id.StmtId) err[fail.Fail] {
    val grown: err[A.Error] = growth.reserve[ast_id.StmtId](lc.s.alloc, ?lc.fins, ?lc.fin_cap, lc.fin_len::usize + 1);
    if (sel grown.err) { ret err[fail.Fail].err{fail.refused(grown.err)}; }
    lc.fins[lc.fin_len] = body;
    lc.fin_len          = lc.fin_len + 1;
    ret err[fail.Fail].ok{};
}

pub fun fin_count(lc: *LowerContext) u32 {
    ret lc.fin_len;
}

pub fun fin_at(lc: *LowerContext, i: u32) ast_id.StmtId {
    if (i >= lc.fin_len) { ret ast_id.STMT_NIL; }
    ret lc.fins[i];
}

pub fun pop_fins_to(lc: *LowerContext, mark: u32) {
    if (mark < lc.fin_len) { lc.fin_len = mark; }
}

# where a refusal of a type points: the signature annotation being lowered, or
# else the code being lowered
fun type_gate_span(lc: *LowerContext) lang_source.Span {
    if (lc.sig_site_set) { ret lc.sig_site; }
    ret lc.builder.loc.span;
}

# the annotation of `lc.sig_decl` a signature component is spelled by: the
# return type for `param` RET_SITE, else that parameter's type
fun claim_sig_site(lc: *LowerContext, did: ast_id.DeclId, param: u32) {
    val d: opt[*ast_decl.Decl] = ast.get_decl(lc.scope.a, did);
    if (sel d.none)                            { ret; }
    if (d.some.kind != ast_decl.DECL_KIND_FUN) { ret; }
    val f:  *ast_decl.DeclFun = ?d.some.data.fun_;
    var at: ast_id.TypeId     = ast_id.TYPE_NIL;
    if (param == RET_SITE)    { at = f.return_type; }
    or (param < f.params_len) { at = lc.scope.a.typed_names[f.params_start + param].ty; }
    lc.sig_site     = f.name;
    lc.sig_site_set = true;
    if (ast_id.type_is_nil(at)) { ret; }
    val t: opt[*ast_type.Type] = ast.get_type(lc.scope.a, at);
    if (sel t.some) { lc.sig_site = t.some.span; }
}

val RET_SITE: u32 = 0xFFFFFFFF;

pub fun lower_type(lc: *LowerContext, tid: type.TypeId) res[ir_type.IrTypeId, fail.Fail] {
    if (type.is_nil(tid)) {
        ret ir_type.intern_void(?lc.m.types);
    }

    val rtid: type.TypeId = substitute_type(lc, tid);

    val previous: *LogicalTypePath = lc.logical_type_path;
    var path:     LogicalTypePath;
    if (!lc.tgt.model.flat_addressing) {
        # a pointer member closing a cycle of records names its record by key, which is
        # what keeps each record's type the same from wherever it is reached
        val key_r: res[u32, fail.Fail] = pointer_cycle_key(lc, previous, rtid);
        if (sel key_r.err) { ret res[ir_type.IrTypeId, fail.Fail].err{key_r.err}; }
        val key: u32 = key_r.ok;
        if (key != ir_type.REC_KEY_NONE) {
            val named: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_recref(?lc.m.types, key);
            if (sel named.err) { ret named; }
            ret ir_type.intern_reference(?lc.m.types, named.ok);
        }
        var active: *LogicalTypePath = previous;
        for (active != nil) {
            if (type.same(active.ty, rtid)) {
                ret res[ir_type.IrTypeId, fail.Fail].err{report_gate(lc, diagnostic_kind.SPIRV_RECURSIVE_TYPE, type_gate_span(lc),
                    "recursive reference types require pointer capabilities absent from the Logical Shader environment")};
            }
            active = active.previous;
        }
        path.ty              = rtid;
        path.previous        = previous;
        lc.logical_type_path = ?path;
    }
    fin { lc.logical_type_path = previous; }

    val fields: err[fail.Fail] = generics.ensure_fields(lc.s, rtid);
    if (sel fields.err)              { ret res[ir_type.IrTypeId, fail.Fail].err{fields.err}; }
    if (sel lc.status.kind.internal) { ret res[ir_type.IrTypeId, fail.Fail].err{fail.phase_failure(lc.status)}; }

    val t_opt: opt[*type.Type] = type.get(?lc.s.types, rtid);
    if (sel t_opt.none) {
        ret ir_type.intern_void(?lc.m.types);
    }
    val t: *type.Type    = t_opt.some;
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_SECRET) { ret lower_type(lc, t.data.secret.base); }

    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT) { ret ir_type.intern_int(?lc.m.types, d.bits); }
    if (d.class == type.PRIM_CLASS_FLOAT) {
        # an f16 is carried as its bits, and each operation on it is lowered by me.half
        if (d.bits == 16) { ret half.carrier(?lc.m.types); }
        ret ir_type.intern_float(?lc.m.types, d.bits);
    }
    if (d.class == type.PRIM_CLASS_PTR) { ret ir_type.intern_ptr(?lc.m.types); }
    if (k == type.TYPE_POINTER) {
        if (lc.tgt.model.flat_addressing) { ret ir_type.intern_ptr(?lc.m.types); }
        # each instance of such a generic references a fresh one, so the reference
        # types never close
        val unbounded: res[bool, fail.Fail] = generics.holds_expansive_instance(lc.s, t.data.pointer.base);
        if (sel unbounded.err) { ret res[ir_type.IrTypeId, fail.Fail].err{unbounded.err}; }
        if (unbounded.ok) {
            ret res[ir_type.IrTypeId, fail.Fail].err{report_gate(lc, diagnostic_kind.SPIRV_RECURSIVE_TYPE, type_gate_span(lc),
                "a reference into a generic whose argument grows through a pointer has unboundedly many types, which the Logical Shader environment cannot declare")};
        }
        val base: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.pointer.base);
        if (sel base.err) { ret base; }
        ret ir_type.intern_reference(?lc.m.types, base.ok);
    }

    if (k == type.TYPE_ARRAY) {
        val res_base: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.array.base);
        if (sel res_base.err) { ret res_base; }
        ret ir_type.intern_array(?lc.m.types, res_base.ok, t.data.array.count);
    }

    if (k == type.TYPE_VECTOR) {
        val ed:       type.PrimDesc                    = type.prim_desc(t.data.vector.element);
        var res_elem: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?lc.m.types, ed.bits);
        # an f16 lane is carried as its bits too, lowered by me.half lane by lane or packed
        if (ed.class == type.PRIM_CLASS_FLOAT && ed.bits == 16) { res_elem = half.carrier(?lc.m.types); }
        or (ed.class == type.PRIM_CLASS_FLOAT)                  { res_elem = ir_type.intern_float(?lc.m.types, ed.bits); }
        if (sel res_elem.err)                                   { ret res_elem; }
        ret ir_type.intern_vector(?lc.m.types, res_elem.ok, t.data.vector.lanes);
    }

    if (k == type.TYPE_HANDLE) {
        ret lower_handle_type(lc, rtid, t);
    }

    if (k == type.TYPE_ABI) {
        ret lower_abi_type(lc, t);
    }

    if (k == type.TYPE_TAG || ((k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE)
        && type.is_tag(?lc.s.types, rtid))) {
        ret lower_tag(lc, rtid);
    }

    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE) {
        ret lower_nominal(lc, rtid, type.is_union(?lc.s.types, rtid));
    }

    if (k == type.TYPE_FUN) {
        ret lower_function_type(lc, t);
    }

    ret ir_type.intern_ptr(?lc.m.types);
}

fun lower_abi_type(lc: *LowerContext, t: *type.Type) res[ir_type.IrTypeId, fail.Fail] {
    val r_u8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?lc.m.types, 8);
    if (sel r_u8.err) { ret r_u8; }
    val r_arr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?lc.m.types, r_u8.ok, t.data.abi.size);
    if (sel r_arr.err) { ret r_arr; }
    var field: ir_type.IrTypeId = r_arr.ok;
    ret ir_type.intern_struct(?lc.m.types, ?field, 1, t.data.abi.align, false);
}

fun lower_handle_type(lc: *LowerContext, rtid: type.TypeId, t: *type.Type) res[ir_type.IrTypeId, fail.Fail] {
    val n:   u32               = t.data.handle.ops_len;
    var ops: *ir_type.IrTypeId = nil;
    if (n > 0) {
        val r_ops: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, n::usize);
        if (sel r_ops.err) {
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(r_ops.err)};
        }
        ops = r_ops.ok;
    }

    val td: *target_definition.Type = target_definition.type_by_tag(lc.tgt.defs, t.data.handle.ctor);

    var i: u32 = 0;
    for (i < n) {
        val w: u32 = type.handle_operand(?lc.s.types, rtid, i);
        ops[i] = w::ir_type.IrTypeId;
        if (td != nil && i < td.arity && td.operands[i] != target_definition.TYPE_OPERAND_WORD) {
            val inner: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, w::type.TypeId);
            if (sel inner.err) {
                if (ops != nil) { A.deallocate[ir_type.IrTypeId](lc.s.alloc, ops, n::usize); }
                ret inner;
            }
            ops[i] = inner.ok;
        }
        i = i + 1;
    }

    val res_: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_handle(?lc.m.types, t.data.handle.ctor, ops, n);
    if (ops != nil) { A.deallocate[ir_type.IrTypeId](lc.s.alloc, ops, n::usize); }
    ret res_;
}

# a tag lowers to its case payload types plus the declared discriminator width
fun lower_tag(lc: *LowerContext, tid: type.TypeId) res[ir_type.IrTypeId, fail.Fail] {
    var nom_align: u32      = 0;
    val ta:        opt[u32] = session.type_align(lc.s, tid::u32);
    if (sel ta.some) { nom_align = ta.some; }
    val nom_packed: bool = session.type_is_packed(lc.s, tid::u32);

    val disc_bytes: u32 = type.tag_discriminator_bytes(?lc.s.types, tid);
    if (disc_bytes == 0) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: a tag has no declared discriminator type")};
    }

    val cases_len: u32 = type.field_count(?lc.s.types, tid);
    if (cases_len == 0) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("lower: a tag has no cases")};
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, cases_len::usize);
    if (sel res_buf.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *ir_type.IrTypeId = res_buf.ok;

    var i: u32 = 0;
    for (i < cases_len) {
        val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (sel fe_opt.none) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, cases_len::usize);
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("case table for a tag is missing an in-range case")};
        }
        val res_case: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, fe_opt.some.ty);
        if (sel res_case.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, cases_len::usize);
            ret res_case;
        }
        buf[i] = res_case.ok;
        i      = i + 1;
    }

    val res_tag: res[ir_type.IrTypeId, fail.Fail] =
        ir_type.intern_tag(?lc.m.types, buf, cases_len, disc_bytes, nom_align, nom_packed);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, cases_len::usize);
    ret res_tag;
}

fun lower_nominal(lc: *LowerContext, tid: type.TypeId, is_union: bool) res[ir_type.IrTypeId, fail.Fail] {
    var nom_align: u32      = 0;
    val ta:        opt[u32] = session.type_align(lc.s, tid::u32);
    if (sel ta.some) { nom_align = ta.some; }

    val nom_packed: bool = session.type_is_packed(lc.s, tid::u32);

    val fields_len: u32 = type.field_count(?lc.s.types, tid);
    if (fields_len == 0) {
        ret ir_type.intern_struct(?lc.m.types, nil, 0, nom_align, nom_packed);
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, fields_len::usize);
    if (sel res_buf.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *ir_type.IrTypeId = res_buf.ok;

    var i: u32 = 0;
    for (i < fields_len) {
        val fe_opt: opt[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (sel fe_opt.none) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
            ret res[ir_type.IrTypeId, fail.Fail].err{fail.message("field table for nominal type is missing an in-range field")};
        }

        val sem:       type.TypeId                      = fe_opt.some.ty;
        val res_field: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, sem);
        if (sel res_field.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
            ret res_field;
        }
        buf[i] = res_field.ok;
        i      = i + 1;
    }

    var kind: ir_type.IrTypeKind = ir_type.IRT_STRUCT;
    if (is_union) { kind = ir_type.IRT_UNION; }
    var key: u32 = ir_type.REC_KEY_NONE;
    if (!lc.tgt.model.flat_addressing) {
        val cyclic: res[bool, fail.Fail] = on_cycle(lc, tid);
        if (sel cyclic.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
            ret res[ir_type.IrTypeId, fail.Fail].err{cyclic.err};
        }
        if (cyclic.ok) { key = record_key(tid); }
    }
    val res_struct: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_record(?lc.m.types, kind, buf, fields_len, nom_align, nom_packed, key);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
    ret res_struct;
}

fun record_key(tid: type.TypeId) u32 {
    ret tid::u32 + 1;
}

fun pointer_cycle_key(lc: *LowerContext, path: *LogicalTypePath, tid: type.TypeId) res[u32, fail.Fail] {
    val pt: opt[*type.Type] = type.get(?lc.s.types, tid);
    if (sel pt.none) { ret res[u32, fail.Fail].ok{ir_type.REC_KEY_NONE}; }
    val t: *type.Type = pt.some;
    if (t.kind != type.TYPE_POINTER) { ret res[u32, fail.Fail].ok{ir_type.REC_KEY_NONE}; }
    ret cycle_key(lc, path, t.data.pointer.base);
}

# the key a pointer to `base` lowers to: the record's own when the record or union the
# pointer is a member of lies on a cycle with it, REC_KEY_NONE otherwise
fun cycle_key(lc: *LowerContext, path: *LogicalTypePath, base: type.TypeId) res[u32, fail.Fail] {
    val unkeyed: res[u32, fail.Fail] = res[u32, fail.Fail].ok{ir_type.REC_KEY_NONE};
    val bt:      opt[*type.Type]     = type.get(?lc.s.types, base);
    if (sel bt.none) { ret unkeyed; }
    val bk: type.TypeKind = bt.some.kind;
    if (bk != type.TYPE_REC && bk != type.TYPE_UNI && bk != type.TYPE_INSTANCE) { ret unkeyed; }
    if (type.is_tag(?lc.s.types, base))                                         { ret unkeyed; }
    var at: *LogicalTypePath = path;
    for (at != nil) {
        val et: opt[*type.Type] = type.get(?lc.s.types, at.ty);
        if (sel et.some) {
            val ek: type.TypeKind = et.some.kind;
            if (ek == type.TYPE_REC || ek == type.TYPE_UNI || ek == type.TYPE_INSTANCE || ek == type.TYPE_TAG) {
                var seen: collections_vector.Vector[type.TypeId] = collections_vector.init[type.TypeId](lc.s.alloc);
                fin { collections_vector.dnit[type.TypeId](?seen); }
                val reached: res[bool, fail.Fail] = reaches(lc, base, at.ty, ?seen);
                if (sel reached.err) { ret res[u32, fail.Fail].err{reached.err}; }
                if (reached.ok)      { ret res[u32, fail.Fail].ok{record_key(base)}; }
                ret unkeyed;
            }
        }
        at = at.previous;
    }
    ret unkeyed;
}

# whether `from` is `target` or holds it through a member, an element, a case or a
# pointee; `seen` holds the types the walk has entered, so a cycle is entered once
fun reaches(lc: *LowerContext, from: type.TypeId, target: type.TypeId, seen: *collections_vector.Vector[type.TypeId]) res[bool, fail.Fail] {
    if (type.same(from, target)) { ret res[bool, fail.Fail].ok{true}; }
    # a tag case without a payload holds no type
    if (type.is_nil(from)) { ret res[bool, fail.Fail].ok{false}; }
    var i: usize = 0;
    for (i < seen.len) {
        if (type.same(seen.data[i], from)) { ret res[bool, fail.Fail].ok{false}; }
        i = i + 1;
    }
    val pushed: res[usize, A.Error] = collections_vector.push[type.TypeId](seen, from);
    if (sel pushed.err) { ret res[bool, fail.Fail].err{fail.refused(pushed.err)}; }
    val t: opt[*type.Type] = type.get(?lc.s.types, from);
    if (sel t.none) { ret res[bool, fail.Fail].err{fail.message("lower: a record cycle walk reached a type the store does not hold")}; }
    val k: type.TypeKind = t.some.kind;
    if (k == type.TYPE_POINTER) {
        # each instance a growing generic references is a fresh one, so the walk
        # stops there: lowering refuses such a reference, which closes no cycle
        val unbounded: res[bool, fail.Fail] = generics.holds_expansive_instance(lc.s, t.some.data.pointer.base);
        if (sel unbounded.err) { ret res[bool, fail.Fail].err{unbounded.err}; }
        if (unbounded.ok)      { ret res[bool, fail.Fail].ok{false}; }
        ret reaches(lc, t.some.data.pointer.base, target, seen);
    }
    if (k == type.TYPE_ARRAY)  { ret reaches(lc, t.some.data.array.base, target, seen); }
    if (k == type.TYPE_SECRET) { ret reaches(lc, t.some.data.secret.base, target, seen); }
    ret members_reach(lc, from, target, seen);
}

# whether a member or case of the aggregate `from` reaches `target`
fun members_reach(lc: *LowerContext, from: type.TypeId, target: type.TypeId, seen: *collections_vector.Vector[type.TypeId]) res[bool, fail.Fail] {
    val t: opt[*type.Type] = type.get(?lc.s.types, from);
    if (sel t.none) { ret res[bool, fail.Fail].err{fail.message("lower: a record cycle walk reached a type the store does not hold")}; }
    val k: type.TypeKind = t.some.kind;
    if (k != type.TYPE_REC && k != type.TYPE_UNI && k != type.TYPE_INSTANCE && k != type.TYPE_TAG) { ret res[bool, fail.Fail].ok{false}; }
    val fe: err[fail.Fail] = generics.ensure_fields(lc.s, from);
    if (sel fe.err) { ret res[bool, fail.Fail].err{fe.err}; }
    var i: u32 = 0;
    for (i < type.field_count(?lc.s.types, from)) {
        val f: opt[*type.FieldEntry] = type.field_at(?lc.s.types, from, i);
        if (sel f.none) { ret res[bool, fail.Fail].err{fail.message("field table for nominal type is missing an in-range field")}; }
        val reached: res[bool, fail.Fail] = reaches(lc, f.some.ty, target, seen);
        if (sel reached.err) { ret reached; }
        if (reached.ok)      { ret reached; }
        i = i + 1;
    }
    ret res[bool, fail.Fail].ok{false};
}

# whether a cycle through the members of `tid` comes back to it
fun on_cycle(lc: *LowerContext, tid: type.TypeId) res[bool, fail.Fail] {
    var seen: collections_vector.Vector[type.TypeId] = collections_vector.init[type.TypeId](lc.s.alloc);
    fin { collections_vector.dnit[type.TypeId](?seen); }
    val pushed: res[usize, A.Error] = collections_vector.push[type.TypeId](?seen, tid);
    if (sel pushed.err) { ret res[bool, fail.Fail].err{fail.refused(pushed.err)}; }
    ret members_reach(lc, tid, tid, ?seen);
}

fun lower_function_type(lc: *LowerContext, t: *type.Type) res[ir_type.IrTypeId, fail.Fail] {
    # only the signature itself is claimed, never a function type inside it
    val claim: ast_id.DeclId = lc.sig_decl;
    lc.sig_decl = ast_id.DECL_NIL;
    if (!ast_id.decl_is_nil(claim)) { claim_sig_site(lc, claim, RET_SITE); }
    val res_ret: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.fn.ret_type);
    if (sel res_ret.err) { ret res_ret; }
    val ir_ret: ir_type.IrTypeId = res_ret.ok;

    val c_variadic: bool = t.data.fn.c_variadic;
    val params_len: u32  = t.data.fn.params_len;
    if (params_len == 0) {
        ret ir_type.intern_fn(?lc.m.types, ir_ret, nil, 0, c_variadic);
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, params_len::usize);
    if (sel res_buf.err) {
        ret res[ir_type.IrTypeId, fail.Fail].err{fail.refused(res_buf.err)};
    }
    val buf: *ir_type.IrTypeId = res_buf.ok;

    var i: u32 = 0;
    for (i < params_len) {
        val po:    opt[type.TypeId] = type.get_param(?lc.s.types, t.data.fn.params_start + i);
        var p_sem: type.TypeId      = type.TYPE_NIL;
        if (sel po.some)                { p_sem = po.some; }
        if (!ast_id.decl_is_nil(claim)) { claim_sig_site(lc, claim, i); }
        val res_param: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, p_sem);
        if (sel res_param.err) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, params_len::usize);
            ret res_param;
        }
        buf[i] = res_param.ok;
        i      = i + 1;
    }

    val res_fn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?lc.m.types, ir_ret, buf, params_len, c_variadic);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, params_len::usize);
    ret res_fn;
}

pub fun gate_is_active(lc: *LowerContext, source: str, cond: ast_id.ExprId,
    scope: comptime_gate.GateScope, cache: bool) res[bool, fail.Fail] {
    val vr: res[comptime_gate.GateVerdict, fail.Fail] = comptime_gate.evaluate_gate[LowerContext](
        lc.scope.ctx, lc, lc.caps, lc.scope.a, source, cond, ?lc.s.interner, scope, cache);
    if (sel vr.err) {
        ret res[bool, fail.Fail].err{vr.err};
    }
    val v: comptime_gate.GateVerdict = vr.ok;
    if (v.outcome == comptime_gate.GATE_ACTIVE)   { ret res[bool, fail.Fail].ok{true}; }
    if (v.outcome == comptime_gate.GATE_INACTIVE) { ret res[bool, fail.Fail].ok{false}; }
    # an evaluation the earlier phases could not settle names a place that is not a constant; that
    # is the program's fault and is reported at the condition
    if (str_len(v.message) > 0) {
        diagnostic.record(lc.diags, v.diag, lc.scope.a.file_id, v.span, v.message);
        ret res[bool, fail.Fail].err{fail.reported()};
    }
    ret res[bool, fail.Fail].err{fail.message("lower: a comptime gate reached lowering undecided")};
}

pub fun block_terminated(lc: *LowerContext) bool {
    if (lc.builder.fn == nil) { ret false; }
    val b: me_ir.BlockId = lc.builder.block;
    if (ir_id.block_is_nil(b))                             { ret false; }
    if (ir_id.block_index(b) >= lc.builder.fn.block_count) { ret false; }
    ret !ir_id.instruction_is_nil(lc.builder.fn.blocks[ir_id.block_index(b)].terminator);
}

pub fun is_void_ir(lc: *LowerContext, tid: ir_type.IrTypeId) bool {
    val opt_type: opt[*ir_type.IrType] = ir_type.get(?lc.m.types, tid);
    if (sel opt_type.none) { ret true; }
    ret opt_type.some.kind == ir_type.IRT_VOID;
}

# an expression's type inside an instance's scope is the instance's, never the template's:
# sema records the template's and every type decision here is made against this instance
# an expression's type as the frame the code is read through decided it, else the template's
# under the instance's substitution
pub fun expr_type_of(lc: *LowerContext, eid: ast_id.ExprId) type.TypeId {
    if (ast_id.expr_is_nil(eid))                              { ret type.TYPE_NIL; }
    if (ast_id.expr_index(eid)::usize >= lc.scope.a.expr_len) { ret type.TYPE_NIL; }
    if (lc.scope.frame != fe_sema.instance.NONE && lc.instances != nil) {
        val framed: opt[type.TypeId] = fe_sema.instance.expr_type_at(lc.instances, lc.scope.frame, eid);
        if (sel framed.some) { ret framed.some; }
    }
    ret substitute_type(lc, lc.scope.sema_result.expr_type[ast_id.expr_index(eid)]);
}

pub fun expr_float_width(lc: *LowerContext, eid: ast_id.ExprId) float.FloatWidth {
    ret float_width_of_type(lc, expr_type_of(lc, eid));
}

fun float_width_of_type(lc: *LowerContext, tid: type.TypeId) float.FloatWidth {
    if (type.is_nil(tid)) { ret float.FLOAT_W_NONE; }
    val ct:    type.TypeId     = type.strip_secret(?lc.s.types, substitute_type(lc, tid));
    val opt_t: opt[*type.Type] = type.get(?lc.s.types, ct);
    if (sel opt_t.none) { ret float.FLOAT_W_NONE; }
    ret type.float_width_of(opt_t.some.kind);
}

pub fun expr_is_secret(lc: *LowerContext, eid: ast_id.ExprId) bool {
    ret type_is_secret(lc, expr_type_of(lc, eid));
}

pub fun type_is_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (type.is_nil(tid)) { ret false; }
    ret type.is_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun type_contains_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (type.is_nil(tid) || type.is_error(tid)) { ret false; }
    ret type.contains_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun type_carries_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (type.is_nil(tid)) { ret false; }
    ret type.carries_secret(?lc.s.types, substitute_type(lc, tid));
}

# the secrecy an inline-asm binding of this type carries: its own storage (`^usize`,
# `^*T`) and, for a pointer, whether the pointee reaches a secret (`*^T`, `**^T`,
# `*rec{ k: ^u32 }`); a pointer to a secret is a public address and a secret load
pub fun bind_secrecy_of(lc: *LowerContext, tid: type.TypeId) ct.BindSecrecy {
    if (type.is_nil(tid) || type.is_error(tid)) { ret ct.bind_public(); }
    val sub:   type.TypeId     = substitute_type(lc, tid);
    val value: bool            = type.contains_secret(?lc.s.types, sub);
    val t_opt: opt[*type.Type] = type.get(?lc.s.types, sub);
    if (!sel t_opt.some) { ret ct.bind_secrecy(value, false); }
    val t: *type.Type = t_opt.some;
    if (t.kind != type.TYPE_POINTER) { ret ct.bind_secrecy(value, false); }
    val deep: res[bool, fail.Fail] = generics.contains_secret_deep(lc.s, t.data.pointer.base);
    if (sel deep.err) {
        fail.internal(?lc.status, fail.describe(deep.err));
        ret ct.bind_secrecy(value, true);
    }
    ret ct.bind_secrecy(value, deep.ok);
}

pub fun substitute_type(lc: *LowerContext, tid: type.TypeId) type.TypeId {
    if (lc.scope.subst == nil || lc.scope.subst_len == 0) { ret tid; }
    ret recover_type(lc, generics.substitute(lc.s, tid, ?lc.scope.subst_owner, lc.scope.subst, lc.scope.subst_len));
}

pub fun type_resolved_of(lc: *LowerContext, tid: ast_id.TypeId) type.TypeId {
    if (ast_id.type_is_nil(tid))                              { ret type.TYPE_NIL; }
    if (ast_id.type_index(tid)::usize >= lc.scope.a.type_len) { ret type.TYPE_NIL; }
    ret substitute_type(lc, lc.scope.sema_result.type_resolved_ty[ast_id.type_index(tid)]);
}

pub fun decl_type_of(lc: *LowerContext, did: ast_id.DeclId) type.TypeId {
    if (ast_id.decl_is_nil(did))                              { ret type.TYPE_NIL; }
    if (ast_id.decl_index(did)::usize >= lc.scope.a.decl_len) { ret type.TYPE_NIL; }
    if (lc.scope.frame != fe_sema.instance.NONE && lc.instances != nil) {
        val framed: opt[type.TypeId] = fe_sema.instance.decl_type_at(lc.instances, lc.scope.frame, did);
        if (sel framed.some) { ret framed.some; }
    }
    ret substitute_type(lc, lc.scope.sema_result.decl_type[ast_id.decl_index(did)]);
}

# the instance sema decided the call or generic reference `eid` names, in the frame the
# code is read through
pub fun instance_of_call(lc: *LowerContext, eid: ast_id.ExprId) res[*fe_sema.instance.Instance, fail.Fail] {
    if (lc.scope.frame == fe_sema.instance.NONE || lc.instances == nil) {
        ret res[*fe_sema.instance.Instance, fail.Fail].err{fail.message("lower: an instantiating call read outside any typing frame")};
    }
    val id: opt[u32] = fe_sema.instance.call_at(lc.instances, lc.scope.frame, eid);
    if (sel id.none) { ret res[*fe_sema.instance.Instance, fail.Fail].err{fail.message("lower: sema recorded no instance for an instantiating call")}; }
    ret res[*fe_sema.instance.Instance, fail.Fail].ok{fe_sema.instance.at(lc.instances, id.some)};
}

# the symbol an instance is emitted and referenced under
pub fun instance_link_name(lc: *LowerContext, item: *fe_sema.instance.Instance) res[intern.StrId, fail.Fail] {
    val fqn: intern.StrId = session.module_fqn(lc.s, item.origin);
    if (item.kind == fe_sema.instance.KIND_VALUE) { ret mangle.value_instance_name(lc.s, fqn, item.canon, item.values, item.value_len); }
    if (item.kind == fe_sema.instance.KIND_PACK) {
        ret mangle.pack_instance_name(lc.s, lc.scope.env.target_defs, fqn, item.canon, item.args, item.arg_len, item.pack, item.pack_len);
    }
    ret mangle.instance_name(lc.s, lc.scope.env.target_defs, fqn, item.canon, item.args, item.arg_len);
}

# the verdict sema gave a statement gate in the frame the code is read through
pub fun gate_of(lc: *LowerContext, cond: ast_id.ExprId) opt[bool] {
    if (lc.scope.frame == fe_sema.instance.NONE || lc.instances == nil) { ret opt[bool].none{}; }
    ret fe_sema.instance.gate_at(lc.instances, lc.scope.frame, cond);
}

# the frame of iteration `index` of the `$each` at `stmt` under the current frame
pub fun iteration_frame(lc: *LowerContext, stmt: ast_id.StmtId, index: u32) res[u32, fail.Fail] {
    if (lc.scope.frame == fe_sema.instance.NONE || lc.instances == nil) { ret res[u32, fail.Fail].ok{fe_sema.instance.NONE}; }
    val f: opt[u32] = fe_sema.instance.iteration_at(lc.instances, lc.scope.frame, stmt, index);
    if (sel f.none) { ret res[u32, fail.Fail].err{fail.message("lower: sema typed no frame for an `$each` iteration")}; }
    ret res[u32, fail.Fail].ok{f.some};
}

pub fun decl_ret_sem(lc: *LowerContext, did: ast_id.DeclId) type.TypeId {
    val fn_ty: type.TypeId     = decl_type_of(lc, did);
    val to:    opt[*type.Type] = type.get(?lc.s.types, fn_ty);
    if (sel to.none) { ret type.TYPE_NIL; }
    val t: *type.Type = to.some;
    if (t.kind != type.TYPE_FUN) { ret type.TYPE_NIL; }
    ret t.data.fn.ret_type;
}

pub fun function_return_ir(lc: *LowerContext, did: ast_id.DeclId) res[ir_type.IrTypeId, fail.Fail] {
    val sem:      type.TypeId     = decl_type_of(lc, did);
    val opt_type: opt[*type.Type] = type.get(?lc.s.types, sem);
    if (sel opt_type.none) { ret ir_type.intern_void(?lc.m.types); }
    val t: *type.Type = opt_type.some;
    if (t.kind != type.TYPE_FUN) { ret ir_type.intern_void(?lc.m.types); }
    ret lower_type(lc, t.data.fn.ret_type);
}

# a function's signature and the extension each parameter declares, which the
# signless signature does not carry
pub rec FnSig {
    sig: ir_type.IrTypeId;
    ext: ir_type.ExtListId;
}

# the signature of the semantic type `tid` and, when it is a function type,
# its parameters' extensions
pub fun lower_fn_sig(lc: *LowerContext, did: ast_id.DeclId) res[FnSig, fail.Fail] {
    val tid:       type.TypeId      = decl_type_of(lc, did);
    val prev_decl: ast_id.DeclId    = lc.sig_decl;
    val prev_site: lang_source.Span = lc.sig_site;
    val prev_set:  bool             = lc.sig_site_set;
    lc.sig_decl = did;
    val res_sig: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, tid);
    lc.sig_decl     = prev_decl;
    lc.sig_site     = prev_site;
    lc.sig_site_set = prev_set;
    if (sel res_sig.err) { ret res[FnSig, fail.Fail].err{res_sig.err}; }
    val res_ext: res[ir_type.ExtListId, fail.Fail] = fun_type_ext(lc, tid);
    if (sel res_ext.err) { ret res[FnSig, fail.Fail].err{res_ext.err}; }
    var out: FnSig;
    out.sig = res_sig.ok;
    out.ext = res_ext.ok;
    ret res[FnSig, fail.Fail].ok{out};
}

# the extensions the parameters of the semantic function type `tid` declare,
# EXT_LIST_EMPTY for any other type
pub fun fun_type_ext(lc: *LowerContext, tid: type.TypeId) res[ir_type.ExtListId, fail.Fail] {
    val t_opt: opt[*type.Type] = type.get(?lc.s.types, type.strip_secret(?lc.s.types, substitute_type(lc, tid)));
    if (sel t_opt.none)                   { ret res[ir_type.ExtListId, fail.Fail].ok{ir_type.EXT_LIST_EMPTY}; }
    if (t_opt.some.kind != type.TYPE_FUN) { ret res[ir_type.ExtListId, fail.Fail].ok{ir_type.EXT_LIST_EMPTY}; }
    val t: *type.Type = t_opt.some;
    val n: u32        = t.data.fn.params_len;
    if (n == 0) { ret res[ir_type.ExtListId, fail.Fail].ok{ir_type.EXT_LIST_EMPTY}; }

    val res_buf: res[*ir_type.IntExt, A.Error] = A.allocate[ir_type.IntExt](lc.s.alloc, n::usize);
    if (sel res_buf.err) { ret res[ir_type.ExtListId, fail.Fail].err{fail.refused(res_buf.err)}; }
    val ext: *ir_type.IntExt = res_buf.ok;
    fin { A.deallocate[ir_type.IntExt](lc.s.alloc, ext, n::usize); }
    var i: u32 = 0;
    for (i < n) {
        val po: opt[type.TypeId] = type.get_param(?lc.s.types, t.data.fn.params_start + i);
        ext[i] = ir_type.EXT_NONE;
        if (sel po.some) { ext[i] = param_int_ext(lc, po.some); }
        i = i + 1;
    }
    ret ir_type.intern_ext_list(?lc.m.types, ext, n);
}

# the extension a caller owes an integer parameter narrower than 64 bits where
# its platform asks the caller for one: its declared signedness. an f16
# travels as its bits in the slot a u16 takes, so it is zero-extended
fun param_int_ext(lc: *LowerContext, sem: type.TypeId) ir_type.IntExt {
    val t_opt: opt[*type.Type] = type.get(?lc.s.types, type.strip_secret(?lc.s.types, substitute_type(lc, sem)));
    if (sel t_opt.none) { ret ir_type.EXT_NONE; }
    val d: type.PrimDesc = type.prim_desc(t_opt.some.kind);
    if (d.class == type.PRIM_CLASS_FLOAT && d.bits == 16) { ret ir_type.EXT_ZERO; }
    if (d.class != type.PRIM_CLASS_INT || d.bits >= 64)   { ret ir_type.EXT_NONE; }
    if (d.signed)                                         { ret ir_type.EXT_SIGN; }
    ret ir_type.EXT_ZERO;
}

pub fun pack_instance_sig(lc: *LowerContext, d: *ast_decl.Decl, fixed_count: u32,
    types: *type.TypeId, type_len: u32, ret_ir: ir_type.IrTypeId) res[FnSig, fail.Fail] {
    var out: FnSig;
    out.ext = ir_type.EXT_LIST_EMPTY;
    val total: u32 = fixed_count + type_len;
    if (total == 0) {
        val res_fn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?lc.m.types, ret_ir, nil, 0, false);
        if (sel res_fn.err) { ret res[FnSig, fail.Fail].err{res_fn.err}; }
        out.sig = res_fn.ok;
        ret res[FnSig, fail.Fail].ok{out};
    }

    val res_buf: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](lc.s.alloc, total::usize);
    if (sel res_buf.err) { ret res[FnSig, fail.Fail].err{fail.refused(res_buf.err)}; }
    val buf: *ir_type.IrTypeId = res_buf.ok;
    fin { A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, total::usize); }
    val res_ext: res[*ir_type.IntExt, A.Error] = A.allocate[ir_type.IntExt](lc.s.alloc, total::usize);
    if (sel res_ext.err) { ret res[FnSig, fail.Fail].err{fail.refused(res_ext.err)}; }
    val ext: *ir_type.IntExt = res_ext.ok;
    fin { A.deallocate[ir_type.IntExt](lc.s.alloc, ext, total::usize); }

    var i: u32 = 0;
    for (i < total) {
        var elem_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < lc.scope.a.typed_name_len) {
                elem_sem = type_resolved_of(lc, lc.scope.a.typed_names[pool_ix].ty);
            }
        }
        or {
            elem_sem = types[i - fixed_count];
        }
        val res_elem: res[ir_type.IrTypeId, fail.Fail] = lower_type(lc, elem_sem);
        if (sel res_elem.err) { ret res[FnSig, fail.Fail].err{res_elem.err}; }
        buf[i] = res_elem.ok;
        ext[i] = param_int_ext(lc, elem_sem);
        i      = i + 1;
    }

    val res_fn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?lc.m.types, ret_ir, buf, total, false);
    if (sel res_fn.err) { ret res[FnSig, fail.Fail].err{res_fn.err}; }
    out.sig = res_fn.ok;
    val res_list: res[ir_type.ExtListId, fail.Fail] = ir_type.intern_ext_list(?lc.m.types, ext, total);
    if (sel res_list.err) { ret res[FnSig, fail.Fail].err{res_list.err}; }
    out.ext = res_list.ok;
    ret res[FnSig, fail.Fail].ok{out};
}

pub fun instance_ref_sig(lc: *LowerContext, decl_id: ast_id.DeclId, origin: session.ModuleId,
    args: *type.TypeId, arg_len: u32) res[FnSig, fail.Fail] {
    val acquired: res[ModuleScope, fail.Fail] = origin_scope(lc, origin);
    if (sel acquired.err) { ret res[FnSig, fail.Fail].err{acquired.err}; }
    var sc:    ModuleScope                       = acquired.ok;
    val who_r: res[type.GenericOwner, fail.Fail] = fe_sema.generic_owner_of_decl(lc.s, sc.a, origin, decl_id);
    if (sel who_r.err) { ret res[FnSig, fail.Fail].err{who_r.err}; }
    sc.subst       = args;
    sc.subst_len   = arg_len;
    sc.subst_owner = who_r.ok;

    val mark_r: res[ScopeMark, fail.Fail] = scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret res[FnSig, fail.Fail].err{mark_r.err};
    }

    val res_sig: res[FnSig, fail.Fail] = lower_fn_sig(lc, decl_id);

    val leave: err[fail.Fail] = scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret res[FnSig, fail.Fail].err{leave.err}; }
    ret res_sig;
}

pub fun pack_instance_ref_sig(lc: *LowerContext, decl_id: ast_id.DeclId, origin: session.ModuleId,
    args: *type.TypeId, arg_len: u32,
    types: *type.TypeId, type_len: u32) res[FnSig, fail.Fail] {
    val acquired: res[ModuleScope, fail.Fail] = origin_scope(lc, origin);
    if (sel acquired.err) { ret res[FnSig, fail.Fail].err{acquired.err}; }
    var sc:    ModuleScope         = acquired.ok;
    val opt_d: opt[*ast_decl.Decl] = ast.get_decl(sc.a, decl_id);
    if (sel opt_d.none) { ret res[FnSig, fail.Fail].err{fail.message("lower: pack-instance-reference origin declaration not found")}; }
    val d: *ast_decl.Decl = opt_d.some;
    if (d.kind != ast_decl.DECL_KIND_FUN) { ret res[FnSig, fail.Fail].err{fail.message("lower: pack-instance-reference origin declaration is not a function")}; }
    val who_r: res[type.GenericOwner, fail.Fail] = fe_sema.generic_owner_of_decl(lc.s, sc.a, origin, decl_id);
    if (sel who_r.err) { ret res[FnSig, fail.Fail].err{who_r.err}; }
    sc.subst       = args;
    sc.subst_len   = arg_len;
    sc.subst_owner = who_r.ok;

    val mark_r: res[ScopeMark, fail.Fail] = scope_enter(lc, sc);
    if (sel mark_r.err) {
        ret res[FnSig, fail.Fail].err{mark_r.err};
    }

    var res_sig:    res[FnSig, fail.Fail];
    val res_ret_ir: res[ir_type.IrTypeId, fail.Fail] = function_return_ir(lc, decl_id);
    if (sel res_ret_ir.err) {
        res_sig = res[FnSig, fail.Fail].err{res_ret_ir.err};
    }
    or (sel res_ret_ir.ok) {
        val fixed_count: u32 = d.data.fun_.params_len - 1;
        res_sig = pack_instance_sig(lc, d, fixed_count, types, type_len, res_ret_ir.ok);
    }

    val leave: err[fail.Fail] = scope_leave(lc, mark_r.ok);
    if (sel leave.err) { ret res[FnSig, fail.Fail].err{leave.err}; }
    ret res_sig;
}

pub fun expr_symbol_of(lc: *LowerContext, eid: ast_id.ExprId) resolve.SymbolId {
    if (ast_id.expr_is_nil(eid))                                 { ret resolve.SYMBOL_NIL; }
    if (ast_id.expr_index(eid)::usize >= lc.scope.rr.expr_count) { ret resolve.SYMBOL_NIL; }
    val sid: resolve.SymbolId = lc.scope.rr.expr_resolved[ast_id.expr_index(eid)];
    if (resolve.symbol_is_rejected(sid)) {
        fail.reject(?lc.status);
        ret resolve.SYMBOL_NIL;
    }
    ret sid;
}

# the source of the module in scope, read when the scope was made
pub fun module_source(lc: *LowerContext) str {
    ret lc.scope.source;
}

# the source text `a` was parsed from
pub fun ast_source(s: *session.Session, a: *ast.Ast) res[str, fail.Fail] {
    val sf: opt[*lang_source.SourceFile] = lang_source.get(?s.sources, a.file_id);
    if (sel sf.none) { ret res[str, fail.Fail].err{fail.message("lower: a parsed module's source is not registered")}; }
    ret res[str, fail.Fail].ok{sf.some.text};
}

pub fun decl_target_op(itn: *intern.Interner, c: *comptime.ComptimeCtx, a: *ast.Ast, d: *ast_decl.Decl, defs: *target_definition.Table, out_op: *u32) u32 {
    if (a == nil || d == nil) { ret target_definition.NO_OP_SET; }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *ast_decl.Decorator = ?a.decorators[d.decorators_start + i];
        if (dec.id != decorator.OP) {
            i = i + 1;
            cnt;
        }
        if (dec.args_len != 3) { ret target_definition.NO_OP_SET; }
        val set_s: opt[str] = decorator.string_of(itn, c, a, dec, 1);
        val nam_s: opt[str] = decorator.string_of(itn, c, a, dec, 2);
        if (sel set_s.none) { ret target_definition.NO_OP_SET; }
        if (sel nam_s.none) { ret target_definition.NO_OP_SET; }
        val od: *target_definition.Op = target_definition.op_of_region(defs,
            set_s.some, 0, str_len(set_s.some), nam_s.some, 0, str_len(nam_s.some));
        if (od == nil) { ret target_definition.NO_OP_SET; }
        @out_op = od.opcode;
        ret od.set_tag;
    }
    ret target_definition.NO_OP_SET;
}

pub fun emit_dbg_birth(lc: *LowerContext, name_span: lang_source.Span, ty: ir_type.IrTypeId,
    ty_sem: type.TypeId, is_param: bool, val_v: value.Value,
    slot: opt[value.Value]) err[fail.Fail] {
    val res_name: res[intern.StrId, A.Error] = intern.range_add(?lc.s.interner, module_source(lc), name_span.offset, name_span.len);
    if (sel res_name.err) {
        ret err[fail.Fail].err{fail.refused(res_name.err)};
    }
    val name: intern.StrId = res_name.ok;
    val sem:  type.TypeId  = substitute_type(lc, ty_sem);
    if (sel slot.some) {
        val sv: value.Value = slot.some;
        if (sv.kind == value.VAL_INSTR) {
            var dv: me_ir.DbgVar;
            dv.name     = name;
            dv.ty       = ty;
            dv.ty_sem   = sem;
            dv.is_param = is_param;
            dv.scope    = 0;
            val res_link: err[fail.Fail] = me_ir.record_alloca_dbg_var(lc.builder.fn, sv.data.instr, dv);
            if (sel res_link.err) { ret res_link; }
        }
    }
    ret builder.emit_dbg_value(?lc.builder, val_v, name, ty, sem, is_param, 0);
}

pub fun symbol_of(lc: *LowerContext, sid: resolve.SymbolId) opt[*resolve.Symbol] {
    if (resolve.symbol_is_nil(sid))                            { ret opt[*resolve.Symbol].none{}; }
    if (resolve.symbol_index(sid) >= lc.scope.rr.symbol_count) { ret opt[*resolve.Symbol].none{}; }
    ret opt[*resolve.Symbol].some{?lc.scope.rr.symbols[resolve.symbol_index(sid)]};
}

pub fun ensure_extern_function(lc: *LowerContext, name: intern.StrId, sig: FnSig, import_flag: bool) res[u32, fail.Fail] {
    val m:        *me_ir.Module = lc.m;
    val existing: opt[u32]      = me_ir.function_lookup(m, name);
    if (sel existing.some) {
        val fi: u32 = existing.some;
        if (import_flag) { m.functions[fi].is_import = true; }
        ret res[u32, fail.Fail].ok{fi};
    }

    val grown: err[A.Error] = growth.reserve[me_ir.Function](m.alloc, ?m.functions, ?m.function_cap, m.function_len::usize + 1);
    if (sel grown.err) { ret res[u32, fail.Fail].err{fail.refused(grown.err)}; }

    val idx: u32 = m.function_len;
    m.functions[idx]           = me_ir.function_new(m.alloc, name, sig.sig, me_ir.FN_FLAG_EXTERN);
    m.functions[idx].param_ext = sig.ext;
    m.functions[idx].is_import = import_flag;
    m.function_len             = m.function_len + 1;
    val res_reg: err[fail.Fail] = me_ir.function_register(m, name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }

    if (lc.builder.fn != nil && lc.fn_index < m.function_len) {
        lc.builder.fn = ?m.functions[lc.fn_index];
    }
    ret res[u32, fail.Fail].ok{idx};
}

pub fun ensure_extern_global(lc: *LowerContext, name: intern.StrId, ty: ir_type.IrTypeId, import_flag: bool) res[u32, fail.Fail] {
    val m:        *me_ir.Module = lc.m;
    val existing: opt[u32]      = me_ir.global_lookup(m, name);
    if (sel existing.some) {
        val gi: u32 = existing.some;
        if (import_flag) { m.globals[gi].is_import = true; }
        ret res[u32, fail.Fail].ok{gi};
    }

    var g: me_ir.Global = me_ir.global_init(name, ty, value.const_int(0, ty));
    g.is_mut    = true;
    g.is_extern = true;
    g.is_import = import_flag;
    val added: res[u32, fail.Fail] = me_ir.global_add(m, g);
    if (sel added.err) { ret added; }
    val idx:     u32            = added.ok;
    val res_reg: err[fail.Fail] = me_ir.global_register(m, name, idx);
    if (sel res_reg.err) { ret res[u32, fail.Fail].err{res_reg.err}; }
    ret res[u32, fail.Fail].ok{idx};
}

pub fun add_rodata_bytes(lc: *LowerContext, init: value.Value, pty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    val m:        *me_ir.Module                = lc.m;
    val res_name: res[intern.StrId, fail.Fail] = anon_global_name(lc, m.global_len);
    if (sel res_name.err) { ret res[value.Value, fail.Fail].err{res_name.err}; }

    var g: me_ir.Global = me_ir.global_init(res_name.ok, init.ty, init);
    g.is_local = true;
    val added: res[u32, fail.Fail] = me_ir.global_add(m, g);
    if (sel added.err) { ret res[value.Value, fail.Fail].err{added.err}; }
    val idx: u32 = added.ok;

    ret res[value.Value, fail.Fail].ok{value.global(idx, pty)};
}

fun anon_global_name(lc: *LowerContext, n: u32) res[intern.StrId, fail.Fail] {
    var buf: [16]u8;
    buf[0] = '.';
    buf[1] = 'L';
    buf[2] = 'c';
    buf[3] = '.';
    var len: usize = 4;
    var d:   u32   = 0;
    for (d < 8) {
        val shift: u32 = (7 - d) * 4;
        val nib:   u32 = (n >> shift) & 0xF;
        var c:     u8  = nib::u8 + 0x30;
        if (nib > 9) { c = nib::u8 - 10 + 0x61; }
        buf[len] = c;
        len      = len + 1;
        d        = d + 1;
    }
    val r_1824: res[intern.StrId, A.Error] = intern.bytes_add(?lc.s.interner, (?buf[0])::str, len);
    if (sel r_1824.err) { ret res[intern.StrId, fail.Fail].err{fail.refused(r_1824.err)}; }
    ret res[intern.StrId, fail.Fail].ok{r_1824.ok};
}

test scope_leave__refuses_a_stale_or_out_of_order_mark {
    var alloc:  A.Allocator;
    val r_1891: err[A.Error] = page.make(?alloc);
    if (sel r_1891.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;

    var lc: LowerContext;
    lc.status           = fail.accepted();
    lc.s                = ?s;
    lc.diags            = ?s.diags;
    lc.scopes           = nil;
    lc.scope_len        = 0;
    lc.scope_cap        = 0;
    lc.scope_generation = 0;
    lc.scope_top        = 0;

    var home: ModuleScope = scope_nil();
    home.fqn = intern.str_id(11);
    lc.scope = home;

    var first: ModuleScope = scope_nil();
    first.fqn = intern.str_id(22);
    var second: ModuleScope = scope_nil();
    second.fqn = intern.str_id(33);

    var code: i32 = 0;

    val m1r: res[ScopeMark, fail.Fail] = scope_enter(?lc, first);
    if (sel m1r.err) { ret 1; }
    val m1: ScopeMark = m1r.ok;
    if (!intern.str_same(lc.scope.fqn, intern.str_id(22))) { code = 1; }

    val m2r: res[ScopeMark, fail.Fail] = scope_enter(?lc, second);
    if (sel m2r.err) { ret 1; }
    val m2: ScopeMark = m2r.ok;
    if (!intern.str_same(lc.scope.fqn, intern.str_id(33))) { code = 1; }

    val r_1927: err[fail.Fail] = scope_leave(?lc, m1);
    if (sel r_1927.ok)                                     { code = 1; }
    if (!intern.str_same(lc.scope.fqn, intern.str_id(33))) { code = 1; }
    if (lc.scope_len != 2)                                 { code = 1; }

    val r_1931: err[fail.Fail] = scope_leave(?lc, m2);
    if (sel r_1931.err)                                    { code = 1; }
    if (!intern.str_same(lc.scope.fqn, intern.str_id(22))) { code = 1; }

    val r_1934: err[fail.Fail] = scope_leave(?lc, m2);
    if (sel r_1934.ok) { code = 1; }

    val r_1936: err[fail.Fail] = scope_leave(?lc, m1);
    if (sel r_1936.err)                                    { code = 1; }
    if (!intern.str_same(lc.scope.fqn, intern.str_id(11))) { code = 1; }
    if (lc.scope_len != 0)                                 { code = 1; }

    var other: LowerContext;
    other.status = fail.accepted();
    other.s      = ?s;
    val r_1943: err[fail.Fail] = scope_leave(?other, m1);
    if (sel r_1943.ok) { code = 1; }

    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](?alloc, lc.scopes, lc.scope_cap::usize);
    }
    ret code;
}

#[testing]
fun fixture_definition(raw: ptr, origin: session.ModuleId, phase: fe_sema.DefinitionPhase) res[fe_sema.Definition, fail.Fail] {
    val current: *fe_sema.Definition = raw::*fe_sema.Definition;
    if (current == nil || !module.same(current.origin, origin)) {
        ret res[fe_sema.Definition, fail.Fail].err{fail.message("fixture definition owner differs")};
    }
    ret res[fe_sema.Definition, fail.Fail].ok{@current};
}

test module_scope__refuses_a_piece_that_belongs_to_another_module {
    var alloc:  A.Allocator;
    val r_1961: err[A.Error] = page.make(?alloc);
    if (sel r_1961.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var a1:  ast.Ast;
    var a2:  ast.Ast;
    var sm1: fe_sema.SemaResult = fe_sema.SemaResult{};
    var sm2: fe_sema.SemaResult = fe_sema.SemaResult{};
    var rr1: resolve.ResolveResult;
    var rr2: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    var cc2: comptime.ComptimeCtx;

    val file: res[lang_source.FileId, lang_source.Error] = lang_source.add(?s.sources, "m.mach", "");
    if (sel file.err) { ret 1; }
    a1.incarnation = 1;
    a1.file_id     = file.ok;
    rr1.status     = fail.accepted();
    sm1.status     = fail.accepted();

    val mid: session.ModuleId = module.id(0);
    val fqn: intern.StrId     = intern.str_id(7);

    val ri: err[fail.Fail] = session.register_module_identity(?s, mid, ?a1, fqn, module.stable_id(5));
    if (sel ri.err) { ret 1; }
    val rp: err[fail.Fail] = session.register_module_phase(?s, mid, (?sm1)::ptr, (?rr1)::ptr);
    if (sel rp.err) { ret 1; }

    var current: fe_sema.Definition = fe_sema.Definition{
        parsed: resolve.ParsedDefinition{a: ?a1, owner: resolve.type_owner(?s, mid, a1.file_id), incarnation: a1.incarnation},
        origin: mid, rr: ?rr1, sr: ?sm1, ctx: ?cc1
    };
    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{
        definitions: fe_sema.reader_init((?current)::ptr, fixture_definition, ?alloc)
    };
    fin { fe_sema.reader_dnit(?deps.definitions); }

    var code: i32 = 0;

    cc1.env.pointer_width = 99;
    val good: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel good.err) { ret 1; }
    val sc: ModuleScope = good.ok;
    if (sc.env.pointer_width != 99) { code = 1; }
    cc1.env.pointer_width = 12;
    if (sc.env.pointer_width != 99) { code = 1; }

    val r_2008: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a2, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2008.ok) { code = 1; }
    val r_2009: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, intern.str_id(8), ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2009.ok) { code = 1; }
    val r_2010: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm2, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2010.ok) { code = 1; }
    val r_2011: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr2, ?cc1, ?deps.definitions);
    if (sel r_2011.ok) { code = 1; }
    val r_2012: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, ?cc2, ?deps.definitions);
    if (sel r_2012.ok) { code = 1; }
    val r_2013: res[ModuleScope, fail.Fail] = module_scope(?s, mid, nil, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2013.ok) { code = 1; }
    val r_2014: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, nil, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2014.ok) { code = 1; }
    val r_2015: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, nil, ?cc1, ?deps.definitions);
    if (sel r_2015.ok) { code = 1; }
    val r_2016: res[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, nil, ?deps.definitions);
    if (sel r_2016.ok) { code = 1; }
    val r_2017: res[ModuleScope, fail.Fail] = module_scope(?s, module.id(1), ?a1, fqn, ?sm1, ?rr1, ?cc1, ?deps.definitions);
    if (sel r_2017.ok) { code = 1; }

    ret code;
}

test request__refuses_a_module_product_that_does_not_correspond {
    var alloc:  A.Allocator;
    val r_2024: err[A.Error] = page.make(?alloc);
    if (sel r_2024.err) { ret 1; }
    val sr: res[session.Session, fail.Fail] = session.init(?alloc);
    if (sel sr.err) { ret 1; }
    var s: session.Session = sr.ok;
    fin { session.dnit(?s); }

    var a1:  ast.Ast;
    var a2:  ast.Ast;
    var sm1: fe_sema.SemaResult = fe_sema.SemaResult{};
    var rr1: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    var tgt: resolved.Target;

    val file: res[lang_source.FileId, lang_source.Error] = lang_source.add(?s.sources, "m.mach", "");
    if (sel file.err) { ret 1; }
    a1.incarnation = 1;
    a1.file_id     = file.ok;
    rr1.status     = fail.accepted();
    sm1.status     = fail.accepted();

    val mid: session.ModuleId = module.id(0);
    val fqn: intern.StrId     = intern.str_id(7);

    val ri: err[fail.Fail] = session.register_module_identity(?s, mid, ?a1, fqn, module.stable_id(5));
    if (sel ri.err) { ret 1; }
    val rp: err[fail.Fail] = session.register_module_phase(?s, mid, (?sm1)::ptr, (?rr1)::ptr);
    if (sel rp.err) { ret 1; }

    var current: fe_sema.Definition = fe_sema.Definition{
        parsed: resolve.ParsedDefinition{a: ?a1, owner: resolve.type_owner(?s, mid, a1.file_id), incarnation: a1.incarnation},
        origin: mid, rr: ?rr1, sr: ?sm1, ctx: ?cc1
    };
    var deps: fe_sema.SemaDeps = fe_sema.SemaDeps{
        definitions: fe_sema.reader_init((?current)::ptr, fixture_definition, ?alloc)
    };
    fin { fe_sema.reader_dnit(?deps.definitions); }

    var code: i32 = 0;

    val good: res[LowerRequest, fail.Fail] = request(?s, ?tgt, ?alloc, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, nil, false, false, true, nil, ?deps);
    if (sel good.err) { ret 1; }
    val req: LowerRequest = good.ok;
    if (req.module.a != ?a1 || !module.same(req.module.own_module, mid)) { code = 1; }

    val r_2066: res[LowerRequest, fail.Fail] = request(?s, nil, ?alloc, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, nil, false, false, true, nil, ?deps);
    if (sel r_2066.ok) { code = 1; }
    val r_2067: res[LowerRequest, fail.Fail] = request(?s, ?tgt, nil, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, nil, false, false, true, nil, ?deps);
    if (sel r_2067.ok) { code = 1; }
    val r_2068: res[LowerRequest, fail.Fail] = request(?s, ?tgt, ?alloc, ?a2, fqn, mid, ?sm1, ?rr1, ?cc1, nil, false, false, true, nil, ?deps);
    if (sel r_2068.ok) { code = 1; }

    ret code;
}

pub fun recover_type(lc: *LowerContext, r: res[type.TypeId, fail.Fail]) type.TypeId {
    if (sel r.err) {
        fail.internal(?lc.status, fail.describe(r.err));
        ret type.TYPE_ERROR;
    }
    ret r.ok;
}
