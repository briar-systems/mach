val INITIAL_STACK_CAP: u32 = 8;

pub val MAX_VALUE_INSTANCES: u32 = 4096;

pub val MAX_PACK_INSTANCES: u32 = 8192;

pub val INSTANCE_NONE: u32 = 4294967295;

pub val MAX_INSTANCE_DEPTH: u32 = 32;

pub val MAX_INSTANCES: u32 = 8192;

val CHAIN_LINKS: u32 = 5;

pub rec LoopFrame {
    header:    ir.BlockId;
    exit:      ir.BlockId;
    fin_depth: u32;
}

pub rec Instance {
    decl:    id.DeclId;
    origin:  session.ModuleId;
    args:    *type.TypeId;
    arg_len: u32;
    name:    intern.StrId;
    bare:    intern.StrId;
    depth:   u32;
    parent:  u32;
}

pub rec ValueInstance {
    decl:    id.DeclId;
    origin:  session.ModuleId;
    vals:    *comptime.CTValue;
    val_len: u32;
    names:   *intern.StrId;
    name:    intern.StrId;
}

pub rec PackInstance {
    decl:     id.DeclId;
    origin:   session.ModuleId;
    args:     *type.TypeId;
    arg_len:  u32;
    types:    *type.TypeId;
    type_len: u32;
    name:     intern.StrId;
}

pub rec ModuleScope {
    a:            *ast.Ast;
    fqn:          intern.StrId;
    own_module:   session.ModuleId;
    sema_result:  *sema.SemaResult;
    rr:           *resolve.ResolveResult;
    env:          comptime.ComptimeEnv;
    ctx:          *comptime.ComptimeCtx;
    subst:        *type.TypeId;
    subst_len:    u32;
    inst_current: u32;
}

pub rec ScopeMark {
    owner:      ptr;
    depth:      u32;
    generation: u64;
    parent:     u64;
}

pub rec LowerRequest {
    s:         *session.Session;
    tgt:       *target.Target;
    malloc:    *A.Allocator;
    module:    ModuleScope;
    test_mode: bool;
    debug:     bool;
}

pub rec LowerContext {
    status: fail.PhaseStatus;
    s:           *session.Session;
    tgt:         *target.Target;
    scope:       ModuleScope;
    scopes:      *ModuleScope;
    scope_len:   u32;
    scope_cap:   u32;
    scope_generation: u64;
    scope_top:        u64;
    caps:        comptime.PhaseCapabilities[LowerContext];
    debug:       bool;
    m:           *ir.Module;
    builder:     builder.Builder;
    locals:      map.Map[resolve.SymbolId, value.Value];
    local_names: map.Map[intern.StrId, LocalBinding];

    fn_index:   u32;
    ret_type:   ir_type.IrTypeId;
    fn_ret_sem: type.TypeId;

    loops:    *LoopFrame;
    loop_len: u32;
    loop_cap: u32;

    fins:    *id.StmtId;
    fin_len: u32;
    fin_cap: u32;

    insts:        *Instance;
    inst_len:     u32;
    inst_cap:     u32;
    inst_drained: u32;
    inst_by_name: map.Map[intern.StrId, u32];

    vinsts:        *ValueInstance;
    vinst_len:     u32;
    vinst_cap:     u32;
    vinst_drained: u32;
    vinst_by_name: map.Map[intern.StrId, u32];

    pinsts:        *PackInstance;
    pinst_len:     u32;
    pinst_cap:     u32;
    pinst_drained: u32;
    pinst_by_name: map.Map[intern.StrId, u32];

    pack_slots:    *value.Value;
    pack_types:    *type.TypeId;
    pack_len:      u32;
    pack_ret_type: type.TypeId;

    ct_insts: *sema.InstWorklist;

    test_mode: bool;
}

pub fun scope_nil() ModuleScope {
    var sc: ModuleScope;
    sc.a            = nil;
    sc.fqn          = intern.STR_NIL;
    sc.own_module   = 0::session.ModuleId;
    sc.sema_result  = nil;
    sc.rr           = nil;
    sc.ctx          = nil;
    sc.subst        = nil;
    sc.subst_len    = 0;
    sc.inst_current = INSTANCE_NONE;
    ret sc;
}

pub fun module_scope(
    s:           *session.Session,
    own_module:  session.ModuleId,
    a:           *ast.Ast,
    fqn:         intern.StrId,
    sema_result: *sema.SemaResult,
    rr:          *resolve.ResolveResult,
    ctx:         *comptime.ComptimeCtx
) R.Result[ModuleScope, fail.Fail] {
    if (s == nil)   { ret R.err[ModuleScope, fail.Fail](fail.message("lower: a module scope requires a session")); }
    if (a == nil)   { ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope has no parsed AST")); }
    if (sema_result == nil) { ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope has no semantic result")); }
    if (rr == nil)  { ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope has no name-resolution result")); }
    if (ctx == nil) { ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope has no comptime context")); }

    if (session.module_ast(s, own_module) != a) {
        ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope AST belongs to another module"));
    }
    if (session.module_fqn(s, own_module) != fqn) {
        ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope name belongs to another module"));
    }
    if ((session.module_sema_ptr(s, own_module))::*sema.SemaResult != sema_result) {
        ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope semantic result belongs to another module"));
    }
    if ((session.module_resolve_ptr(s, own_module))::*resolve.ResolveResult != rr) {
        ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope name-resolution result belongs to another module"));
    }
    if ((session.module_comptime_ptr(s, own_module))::*comptime.ComptimeCtx != ctx) {
        ret R.err[ModuleScope, fail.Fail](fail.message("lower: module scope comptime context belongs to another module"));
    }

    var sc: ModuleScope = scope_nil();
    sc.a           = a;
    sc.fqn         = fqn;
    sc.own_module  = own_module;
    sc.sema_result = sema_result;
    sc.rr          = rr;
    sc.env         = comptime.environment(ctx);
    sc.ctx         = ctx;
    ret R.ok[ModuleScope, fail.Fail](sc);
}

pub fun origin_scope(s: *session.Session, origin: session.ModuleId) O.Option[ModuleScope] {
    val oa: *ast.Ast = session.module_ast(s, origin);
    if (oa == nil) { ret O.none[ModuleScope](); }
    val osema: *sema.SemaResult = (session.module_sema_ptr(s, origin))::*sema.SemaResult;
    if (osema == nil) { ret O.none[ModuleScope](); }
    val orr: *resolve.ResolveResult = (session.module_resolve_ptr(s, origin))::*resolve.ResolveResult;
    if (orr == nil) { ret O.none[ModuleScope](); }
    val octx: *comptime.ComptimeCtx = (session.module_comptime_ptr(s, origin))::*comptime.ComptimeCtx;
    if (octx == nil) { ret O.none[ModuleScope](); }

    val r: R.Result[ModuleScope, fail.Fail] = module_scope(s, origin, oa, session.module_fqn(s, origin), osema, orr, octx);
    if (R.is_err[ModuleScope, fail.Fail](r)) { ret O.none[ModuleScope](); }
    ret O.some[ModuleScope](R.unwrap_ok[ModuleScope, fail.Fail](r));
}

pub fun request(
    s:           *session.Session,
    tgt:         *target.Target,
    malloc:      *A.Allocator,
    a:           *ast.Ast,
    fqn:         intern.StrId,
    own_module:  session.ModuleId,
    sema_result: *sema.SemaResult,
    rr:          *resolve.ResolveResult,
    ctx:         *comptime.ComptimeCtx,
    test_mode:   bool,
    debug:       bool
) R.Result[LowerRequest, fail.Fail] {
    if (tgt == nil)    { ret R.err[LowerRequest, fail.Fail](fail.message("lower: a lowering request requires a resolved target")); }
    if (malloc == nil) { ret R.err[LowerRequest, fail.Fail](fail.message("lower: a lowering request requires an allocator")); }

    val sr: R.Result[ModuleScope, fail.Fail] = module_scope(s, own_module, a, fqn, sema_result, rr, ctx);
    if (R.is_err[ModuleScope, fail.Fail](sr)) { ret R.err[LowerRequest, fail.Fail](R.unwrap_err[ModuleScope, fail.Fail](sr)); }

    var req: LowerRequest;
    req.s         = s;
    req.tgt       = tgt;
    req.malloc    = malloc;
    req.module    = R.unwrap_ok[ModuleScope, fail.Fail](sr);
    req.test_mode = test_mode;
    req.debug     = debug;
    ret R.ok[LowerRequest, fail.Fail](req);
}

pub fun scope_enter(lc: *LowerContext, next: ModuleScope) R.Result[ScopeMark, fail.Fail] {
    if (lc == nil) { ret R.err[ScopeMark, fail.Fail](fail.message("lower: scope_enter requires a context")); }
    if (lc.scope_generation == 0xFFFFFFFFFFFFFFFF) {
        ret R.err[ScopeMark, fail.Fail](fail.message("lower: module scope generation exhausted"));
    }
    if (lc.scope_len == lc.scope_cap) {
        var new_cap: u32 = lc.scope_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        val gr: R.Result[*ModuleScope, str] = A.reallocate[ModuleScope](lc.s.alloc, lc.scopes, lc.scope_cap::usize, new_cap::usize);
        if (R.is_err[*ModuleScope, str](gr)) { ret R.err[ScopeMark, fail.Fail](fail.message(R.unwrap_err[*ModuleScope, str](gr))); }
        lc.scopes    = R.unwrap_ok[*ModuleScope, str](gr);
        lc.scope_cap = new_cap;
    }

    lc.scopes[lc.scope_len] = lc.scope;
    lc.scope_len = lc.scope_len + 1;

    var mark: ScopeMark;
    mark.owner      = lc::ptr;
    mark.depth      = lc.scope_len;
    mark.generation = lc.scope_generation + 1;
    mark.parent     = lc.scope_top;

    lc.scope_generation = mark.generation;
    lc.scope_top        = mark.generation;
    lc.scope            = next;
    ret R.ok[ScopeMark, fail.Fail](mark);
}

pub fun scope_leave(lc: *LowerContext, mark: ScopeMark) R.Result[R.Void, fail.Fail] {
    if (lc == nil || mark.owner != lc::ptr) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: scope_leave mark belongs to another context"));
    }
    if (mark.generation == 0 || mark.generation != lc.scope_top || mark.depth != lc.scope_len) {
        ret R.err[R.Void, fail.Fail](fail.message("lower: scope_leave mark is stale or out of order"));
    }
    lc.scope_len = lc.scope_len - 1;
    lc.scope     = lc.scopes[lc.scope_len];
    lc.scope_top = mark.parent;
    ret R.ok_void[fail.Fail]();
}

pub fun init_context(lc: *LowerContext, req: *LowerRequest, m: *ir.Module) R.Result[R.Void, fail.Fail] {
    if (req == nil) { ret R.err[R.Void, fail.Fail](fail.message("lower: init_context requires a lowering request")); }
    val s: *session.Session = req.s;
    lc.status      = fail.accepted();
    lc.s           = s;
    lc.tgt         = req.tgt;
    lc.scope       = req.module;
    lc.scopes      = nil;
    lc.scope_len   = 0;
    lc.scope_cap   = 0;
    lc.scope_generation = 0;
    lc.scope_top        = 0;
    lc.test_mode   = req.test_mode;
    lc.debug       = req.debug;
    lc.m           = m;
    lc.builder     = builder.init(m);

    val caps_r: R.Result[comptime.PhaseCapabilities[LowerContext], str] = comptime.lowering_capabilities[LowerContext](
        resolve_module_member_const,
        resolve_type_comparison_operand,
        resolve_field_member,
        resolve_type_query,
        resolve_layout_intrinsic,
        comptime_ident_is_runtime
    );
    if (R.is_err[comptime.PhaseCapabilities[LowerContext], str](caps_r)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[comptime.PhaseCapabilities[LowerContext], str](caps_r)));
    }
    lc.caps = R.unwrap_ok[comptime.PhaseCapabilities[LowerContext], str](caps_r);

    lc.locals      = map.init[resolve.SymbolId, value.Value](s.alloc, map.hash_u32, map.eq_u32);
    lc.local_names = map.init[intern.StrId, LocalBinding](s.alloc, map.hash_u32, map.eq_u32);

    lc.fn_index   = 0;
    lc.ret_type   = ir_type.IRT_NIL;
    lc.fn_ret_sem = type.TYPE_NIL;

    val res_loops: R.Result[*LoopFrame, str] = A.allocate[LoopFrame](s.alloc, INITIAL_STACK_CAP::usize);
    if (R.is_err[*LoopFrame, str](res_loops)) {
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*LoopFrame, str](res_loops)));
    }
    lc.loops    = R.unwrap_ok[*LoopFrame, str](res_loops);
    lc.loop_len = 0;
    lc.loop_cap = INITIAL_STACK_CAP;

    val res_fins: R.Result[*id.StmtId, str] = A.allocate[id.StmtId](s.alloc, INITIAL_STACK_CAP::usize);
    if (R.is_err[*id.StmtId, str](res_fins)) {
        A.deallocate[LoopFrame](s.alloc, lc.loops, lc.loop_cap::usize);
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*id.StmtId, str](res_fins)));
    }
    lc.fins    = R.unwrap_ok[*id.StmtId, str](res_fins);
    lc.fin_len = 0;
    lc.fin_cap = INITIAL_STACK_CAP;

    lc.insts        = nil;
    lc.inst_len     = 0;
    lc.inst_cap     = 0;
    lc.inst_drained = 0;
    lc.inst_by_name = map.init[intern.StrId, u32](s.alloc, map.hash_u32, map.eq_u32);

    lc.vinsts        = nil;
    lc.vinst_len     = 0;
    lc.vinst_cap     = 0;
    lc.vinst_drained = 0;
    lc.vinst_by_name = map.init[intern.StrId, u32](s.alloc, map.hash_u32, map.eq_u32);

    lc.pinsts        = nil;
    lc.pinst_len     = 0;
    lc.pinst_cap     = 0;
    lc.pinst_drained = 0;
    lc.pinst_by_name = map.init[intern.StrId, u32](s.alloc, map.hash_u32, map.eq_u32);

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;

    val res_ct: R.Result[*sema.InstWorklist, str] = sema.inst_worklist_new(s.alloc);
    if (R.is_err[*sema.InstWorklist, str](res_ct)) {
        A.deallocate[id.StmtId](s.alloc, lc.fins, lc.fin_cap::usize);
        A.deallocate[LoopFrame](s.alloc, lc.loops, lc.loop_cap::usize);
        map.dnit[intern.StrId, u32](?lc.pinst_by_name);
        map.dnit[intern.StrId, u32](?lc.vinst_by_name);
        map.dnit[intern.StrId, u32](?lc.inst_by_name);
        map.dnit[intern.StrId, LocalBinding](?lc.local_names);
        map.dnit[resolve.SymbolId, value.Value](?lc.locals);
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*sema.InstWorklist, str](res_ct)));
    }
    lc.ct_insts = R.unwrap_ok[*sema.InstWorklist, str](res_ct);

    ret R.ok_void[fail.Fail]();
}

pub fun dnit_context(lc: *LowerContext) {
    if (lc == nil) { ret; }
    map.dnit[intern.StrId, LocalBinding](?lc.local_names);
    map.dnit[resolve.SymbolId, value.Value](?lc.locals);
    map.dnit[intern.StrId, u32](?lc.inst_by_name);
    map.dnit[intern.StrId, u32](?lc.vinst_by_name);
    map.dnit[intern.StrId, u32](?lc.pinst_by_name);

    if (lc.loops != nil && lc.loop_cap > 0) {
        A.deallocate[LoopFrame](lc.s.alloc, lc.loops, lc.loop_cap::usize);
    }
    if (lc.fins != nil && lc.fin_cap > 0) {
        A.deallocate[id.StmtId](lc.s.alloc, lc.fins, lc.fin_cap::usize);
    }
    if (lc.insts != nil && lc.inst_cap > 0) {
        var i: u32 = 0;
        for (i < lc.inst_len) {
            if (lc.insts[i].args != nil && lc.insts[i].arg_len > 0) {
                A.deallocate[type.TypeId](lc.s.alloc, lc.insts[i].args, lc.insts[i].arg_len::usize);
            }
            i = i + 1;
        }
        A.deallocate[Instance](lc.s.alloc, lc.insts, lc.inst_cap::usize);
    }
    if (lc.vinsts != nil && lc.vinst_cap > 0) {
        var i: u32 = 0;
        for (i < lc.vinst_len) {
            if (lc.vinsts[i].vals != nil && lc.vinsts[i].val_len > 0) {
                A.deallocate[comptime.CTValue](lc.s.alloc, lc.vinsts[i].vals, lc.vinsts[i].val_len::usize);
            }
            if (lc.vinsts[i].names != nil && lc.vinsts[i].val_len > 0) {
                A.deallocate[intern.StrId](lc.s.alloc, lc.vinsts[i].names, lc.vinsts[i].val_len::usize);
            }
            i = i + 1;
        }
        A.deallocate[ValueInstance](lc.s.alloc, lc.vinsts, lc.vinst_cap::usize);
    }
    if (lc.pinsts != nil && lc.pinst_cap > 0) {
        var i: u32 = 0;
        for (i < lc.pinst_len) {
            if (lc.pinsts[i].args != nil && lc.pinsts[i].arg_len > 0) {
                A.deallocate[type.TypeId](lc.s.alloc, lc.pinsts[i].args, lc.pinsts[i].arg_len::usize);
            }
            if (lc.pinsts[i].types != nil && lc.pinsts[i].type_len > 0) {
                A.deallocate[type.TypeId](lc.s.alloc, lc.pinsts[i].types, lc.pinsts[i].type_len::usize);
            }
            i = i + 1;
        }
        A.deallocate[PackInstance](lc.s.alloc, lc.pinsts, lc.pinst_cap::usize);
    }
    sema.inst_worklist_free(lc.ct_insts);
    lc.ct_insts = nil;

    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](lc.s.alloc, lc.scopes, lc.scope_cap::usize);
    }
    lc.scope     = scope_nil();
    lc.scopes    = nil;
    lc.scope_len = 0;
    lc.scope_cap = 0;
    lc.scope_top = 0;

    lc.loops    = nil;
    lc.loop_len = 0;
    lc.loop_cap = 0;
    lc.fins     = nil;
    lc.fin_len  = 0;
    lc.fin_cap  = 0;

    lc.insts        = nil;
    lc.inst_len     = 0;
    lc.inst_cap     = 0;
    lc.inst_drained = 0;

    lc.vinsts        = nil;
    lc.vinst_len     = 0;
    lc.vinst_cap     = 0;
    lc.vinst_drained = 0;

    lc.pinsts        = nil;
    lc.pinst_len     = 0;
    lc.pinst_cap     = 0;
    lc.pinst_drained = 0;

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;
}

pub fun declaring_comptime_ctx(lc: *LowerContext, sym: *resolve.Symbol) *comptime.ComptimeCtx {
    if (sym.origin == lc.scope.own_module) { ret lc.scope.ctx; }
    ret (session.module_comptime_ptr(lc.s, sym.origin))::*comptime.ComptimeCtx;
}

pub fun gated_lower_member_const_message(lc: *LowerContext, name: intern.StrId, dep_fqn: intern.StrId) str {
    val fallback: str = "tuple-dependent public constants are not yet supported in union builds";
    val no: O.Option[str] = intern.lookup(?lc.s.interner, name);
    val fo: O.Option[str] = intern.lookup(?lc.s.interner, dep_fqn);
    if (O.is_none[str](no) || O.is_none[str](fo)) { ret fallback; }

    val res_msg: R.Result[str, str] = format.sprint(lc.s.alloc,
        "tuple-dependent public constants are not yet supported in union builds: '{}' in module '{}' is bound under a per-target-tuple condition",
        O.unwrap[str](no), O.unwrap[str](fo));
    if (R.is_err[str, str](res_msg)) { fail.internal(?lc.status, R.unwrap_err[str, str](res_msg)); ret fallback; }
    val buf: str = R.unwrap_ok[str, str](res_msg);

    val ir: R.Result[intern.StrId, str] = intern.intern(?lc.s.interner, buf);
    str_free(lc.s.alloc, buf);
    if (R.is_err[intern.StrId, str](ir)) { fail.internal(?lc.status, R.unwrap_err[intern.StrId, str](ir)); ret fallback; }

    val nm: O.Option[str] = intern.lookup(?lc.s.interner, R.unwrap_ok[intern.StrId, str](ir));
    if (O.is_some[str](nm)) { ret O.unwrap[str](nm); }
    ret fallback;
}

pub fun report_gate(lc: *LowerContext, span: token.Span, message: str) fail.Fail {
    fail.reject(?lc.status);
    val r: R.Result[bool, str] = diagnostic.gate_error(?lc.s.gate_diags, ?lc.s.diags,
        ?lc.s.interner, lc.scope.a.file_id, span, message);
    if (R.is_err[bool, str](r)) { fail.internal(?lc.status, R.unwrap_err[bool, str](r)); }
    ret fail.phase_failure(lc.status);
}

pub fun record_eval_result(lc: *LowerContext, r: R.Result[comptime.CTValue, comptime.EvalFail]) {
    if (R.is_ok[comptime.CTValue, comptime.EvalFail](r)) { ret; }
    val f: comptime.EvalFail = R.unwrap_err[comptime.CTValue, comptime.EvalFail](r);
    if (f.kind == comptime.EVAL_FAIL_INTERNAL) { fail.internal(?lc.status, f.message); }
}

pub fun resolve_module_member_const(lc: *LowerContext, eid: id.ExprId) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    val rr: *resolve.ResolveResult = lc.scope.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val sid: resolve.SymbolId = rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid::u32 >= rr.symbol_count) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val sym: *resolve.Symbol = ?rr.symbols[sid];
    if (sym.kind != resolve.SYM_IMPORTED) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val octx: *comptime.ComptimeCtx = declaring_comptime_ctx(lc, sym);
    if (octx == nil) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    val nc: O.Option[comptime.NamedConst] = comptime.lookup(octx, sym.name);
    if (O.is_none[comptime.NamedConst](nc)) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }
    val named: comptime.NamedConst = O.unwrap[comptime.NamedConst](nc);
    if (named.gated && lc.scope.env.union_build) {
        val msg: str = gated_lower_member_const_message(lc, sym.name, session.module_fqn(lc.s, sym.origin));
        val e_opt: O.Option[*aexpr.Expr] = ast.get_expr(lc.scope.a, eid);
        var span: token.Span;
        span.offset = 0;
        span.len    = 0;
        if (O.is_some[*aexpr.Expr](e_opt)) { span = O.unwrap[*aexpr.Expr](e_opt).span; }
        val f: fail.Fail = report_gate(lc, span, msg);
        ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_from_fail(f, msg));
    }
    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](named.value));
}

pub fun comptime_ident_is_runtime(lc: *LowerContext, eid: id.ExprId) bool {
    if (lc == nil || eid == id.EXPR_NIL) { ret false; }
    val rr: *resolve.ResolveResult = lc.scope.rr;
    if (rr == nil || rr.expr_resolved == nil || eid::u32 >= rr.expr_count) { ret false; }
    val sid: resolve.SymbolId = rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_NIL || sid::u32 >= rr.symbol_count) { ret false; }
    ret resolve.symbol_is_runtime(?rr.symbols[sid]);
}

pub fun resolve_type_comparison_operand(lc: *LowerContext, eid: id.ExprId) R.Result[O.Option[u32], comptime.EvalFail] {
    if (lc == nil) { ret R.ok[O.Option[u32], comptime.EvalFail](O.none[u32]()); }
    val t: type.TypeId = expr_type_of(lc, eid);
    if (t == type.TYPE_NIL || t == type.TYPE_ERROR) { ret R.ok[O.Option[u32], comptime.EvalFail](O.none[u32]()); }
    ret R.ok[O.Option[u32], comptime.EvalFail](O.some[u32](t::u32));
}

pub fun resolve_type_query(lc: *LowerContext, tid: u32, which: u8) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    ret infer.answer_type_query(lc.s, tid, which);
}

pub fun resolve_layout_intrinsic(lc: *LowerContext, eid: u32) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    val e: id.ExprId = eid::id.ExprId;
    val src: str = module_source(lc);
    val is_size:  bool = comptime.is_size_of_call(lc.scope.a, src, e);
    val is_align: bool = comptime.is_align_of_call(lc.scope.a, src, e);
    val is_len:   bool = comptime.is_length_of_call(lc.scope.a, src, e);
    if (!is_size && !is_align && !is_len) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
    }

    val arg: id.ExprId = comptime.layout_intrinsic_type_arg(lc.scope.a, e);
    if (arg == id.EXPR_NIL) {
        ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_REJECTED, "a layout intrinsic takes one type argument"));
    }
    val op_ty: type.TypeId = type.strip_secret(?lc.s.types, expr_type_of(lc, arg));

    if (is_len) {
        val n_opt: O.Option[u32] = type.element_count(?lc.s.types, substitute_type(lc, op_ty));
        if (O.is_none[u32](n_opt)) {
            ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_error(comptime.EVAL_FAIL_REJECTED, "`$length_of` expects a fixed array or a vector"));
        }
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](
            O.some[comptime.CTValue](comptime.ct_uint(O.unwrap[u32](n_opt)::u64)));
    }

    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, op_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) {
        ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_from_fail(R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir), "layout lowering was rejected"));
    }
    val op_ir: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);

    var n: u32 = ir_type.byte_size_for_machine(?lc.m.types, op_ir, target.layout_machine(lc.tgt));
    if (is_align) { n = ir_type.byte_align_for_machine(?lc.m.types, op_ir, target.layout_machine(lc.tgt)); }
    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](comptime.ct_uint(n::u64)));
}

pub fun resolve_field_member(lc: *LowerContext, owner: u32, index: u32, sel: u8) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    if (lc == nil) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    val owner_ty: type.TypeId = owner::type.TypeId;

    if (sel == comptime.FIELD_SEL_ZERO_BY_NAME) {
        ret resolve_omitted_field_zero(lc, owner_ty, index::intern.StrId);
    }

    val fa: O.Option[*type.FieldEntry] = type.field_at(?lc.s.types, owner_ty, index);
    if (O.is_none[*type.FieldEntry](fa)) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
    val fe: *type.FieldEntry = O.unwrap[*type.FieldEntry](fa);

    if (sel == comptime.FIELD_SEL_NAME) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](comptime.ct_str(fe.name)));
    }
    if (sel == comptime.FIELD_SEL_TYPE) {
        ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](comptime.ct_type(fe.ty::u32)));
    }

    val res_ir: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, owner_ty);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ir)) { ret R.err[O.Option[comptime.CTValue], comptime.EvalFail](comptime.eval_from_fail(R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ir), "layout lowering was rejected")); }
    val ir_id: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ir);
    val off: u32 = ir_type.byte_offset_for_machine(?lc.m.types, ir_id, index, target.layout_machine(lc.tgt));
    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.some[comptime.CTValue](comptime.ct_uint(off::u64)));
}

fun resolve_omitted_field_zero(lc: *LowerContext, owner_ty: type.TypeId, name: intern.StrId) R.Result[O.Option[comptime.CTValue], comptime.EvalFail] {
    val stripped: type.TypeId = type.strip_secret(?lc.s.types, owner_ty);
    val n: u32 = type.field_count(?lc.s.types, stripped);
    var i: u32 = 0;
    for (i < n) {
        val fa: O.Option[*type.FieldEntry] = type.field_at(?lc.s.types, stripped, i);
        if (O.is_some[*type.FieldEntry](fa)) {
            val fe: *type.FieldEntry = O.unwrap[*type.FieldEntry](fa);
            if (fe.name == name) {
                val fty: type.TypeId = type.strip_secret(?lc.s.types, fe.ty);
                val ft: O.Option[*type.Type] = type.get(?lc.s.types, fty);
                if (O.is_none[*type.Type](ft)) { ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]()); }
                val kind: type.TypeKind = O.unwrap[*type.Type](ft).kind;
                val pd: type.PrimDesc = type.prim_desc(kind);
                if (pd.class == type.PRIM_CLASS_INT) {
                    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](
                        O.some[comptime.CTValue](comptime.ct_zero_int(!pd.signed, pd.bits::u8)));
                }
                if (pd.class == type.PRIM_CLASS_FLOAT) {
                    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](
                        O.some[comptime.CTValue](comptime.ct_float(0.0, type.float_width_of(kind))));
                }
                ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
            }
        }
        i = i + 1;
    }
    ret R.ok[O.Option[comptime.CTValue], comptime.EvalFail](O.none[comptime.CTValue]());
}

pub fun begin_function(lc: *LowerContext, fn_index: u32, ret_type: ir_type.IrTypeId) {
    map.clear[resolve.SymbolId, value.Value](?lc.locals);
    map.clear[intern.StrId, LocalBinding](?lc.local_names);
    lc.loop_len   = 0;
    lc.fin_len    = 0;
    lc.fn_index   = fn_index;
    lc.ret_type   = ret_type;
    lc.fn_ret_sem = type.TYPE_NIL;

    lc.pack_slots    = nil;
    lc.pack_types    = nil;
    lc.pack_len      = 0;
    lc.pack_ret_type = type.TYPE_NIL;
}

pub rec LocalBinding {
    value:  value.Value;
    secret: bool;
}

pub fun bind_local(lc: *LowerContext, sym: resolve.SymbolId, v: value.Value, secret: bool) R.Result[R.Void, fail.Fail] {
    val res_bind: R.Result[bool, str] = map.insert[resolve.SymbolId, value.Value](?lc.locals, sym, v);
    if (R.is_err[bool, str](res_bind)) { ret fail.lift[R.Void](R.void_of[bool, str](res_bind)); }

    val opt_sym: O.Option[*resolve.Symbol] = symbol_of(lc, sym);
    if (O.is_some[*resolve.Symbol](opt_sym)) {
        val name: intern.StrId = O.unwrap[*resolve.Symbol](opt_sym).name;
        if (name != intern.STR_NIL) {
            var lb: LocalBinding;
            lb.value  = v;
            lb.secret = secret;
            ret fail.lift[R.Void](R.void_of[bool, str](map.insert[intern.StrId, LocalBinding](?lc.local_names, name, lb)));
        }
    }
    ret R.ok_void[fail.Fail]();
}


pub fun lookup_local_name(lc: *LowerContext, name: intern.StrId) O.Option[LocalBinding] {
    var key: intern.StrId = name;
    val res_get: R.Result[*LocalBinding, str] = map.get[intern.StrId, LocalBinding](?lc.local_names, ?key);
    if (R.is_ok[*LocalBinding, str](res_get)) {
        ret O.some[LocalBinding](@R.unwrap_ok[*LocalBinding, str](res_get));
    }
    ret O.none[LocalBinding]();
}

pub fun lookup_local(lc: *LowerContext, sym: resolve.SymbolId) O.Option[value.Value] {
    val res_get: R.Result[*value.Value, str] = map.get[resolve.SymbolId, value.Value](?lc.locals, ?sym);
    if (R.is_ok[*value.Value, str](res_get)) {
        ret O.some[value.Value](@R.unwrap_ok[*value.Value, str](res_get));
    }
    ret O.none[value.Value]();
}

pub fun push_loop(lc: *LowerContext, header: ir.BlockId, exit: ir.BlockId) R.Result[R.Void, fail.Fail] {
    if (lc.loop_len == lc.loop_cap) {
        val new_cap: u32 = lc.loop_cap * 2;
        val res_grow: R.Result[*LoopFrame, str] = A.reallocate[LoopFrame](lc.s.alloc, lc.loops, lc.loop_cap::usize, new_cap::usize);
        if (R.is_err[*LoopFrame, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*LoopFrame, str](res_grow))); }
        lc.loops    = R.unwrap_ok[*LoopFrame, str](res_grow);
        lc.loop_cap = new_cap;
    }
    var f: LoopFrame;
    f.header    = header;
    f.exit      = exit;
    f.fin_depth = lc.fin_len;
    lc.loops[lc.loop_len] = f;
    lc.loop_len = lc.loop_len + 1;
    ret R.ok_void[fail.Fail]();
}

pub fun pop_loop(lc: *LowerContext) {
    if (lc.loop_len > 0) { lc.loop_len = lc.loop_len - 1; }
}

pub fun current_loop(lc: *LowerContext) *LoopFrame {
    if (lc.loop_len == 0) { ret nil; }
    ret ?lc.loops[lc.loop_len - 1];
}

pub fun enqueue_instance(lc: *LowerContext, decl: id.DeclId, origin: session.ModuleId,
                         args: *type.TypeId, arg_len: u32, name: intern.StrId,
                         bare: intern.StrId) R.Result[R.Void, fail.Fail] {
    var lookup_name: intern.StrId = name;
    if (map.contains[intern.StrId, u32](?lc.inst_by_name, ?lookup_name)) { ret R.ok_void[fail.Fail](); }

    var depth: u32 = 0;
    if (lc.scope.inst_current != INSTANCE_NONE) { depth = lc.insts[lc.scope.inst_current].depth + 1; }

    if (depth > MAX_INSTANCE_DEPTH) {
        ret R.err[R.Void, fail.Fail](fail.message(instantiation_chain_error(lc, bare, args, arg_len,
            "generic instantiation depth limit exceeded: a generic instantiates itself at a growing type argument")));
    }
    if (lc.inst_len >= MAX_INSTANCES) {
        ret R.err[R.Void, fail.Fail](fail.message(instantiation_chain_error(lc, bare, args, arg_len,
            "generic instantiation limit exceeded: one module reached the cap on distinct instances")));
    }

    if (lc.inst_len == lc.inst_cap) {
        var new_cap: u32 = lc.inst_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        if (lc.insts == nil) {
            val res_grow: R.Result[*Instance, str] = A.allocate[Instance](lc.s.alloc, new_cap::usize);
            if (R.is_err[*Instance, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*Instance, str](res_grow))); }
            lc.insts = R.unwrap_ok[*Instance, str](res_grow);
        }
        or {
            val res_grow: R.Result[*Instance, str] = A.reallocate[Instance](lc.s.alloc, lc.insts, lc.inst_cap::usize, new_cap::usize);
            if (R.is_err[*Instance, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*Instance, str](res_grow))); }
            lc.insts = R.unwrap_ok[*Instance, str](res_grow);
        }
        lc.inst_cap = new_cap;
    }

    var args_copy: *type.TypeId = nil;
    if (arg_len > 0) {
        val res_copy: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](lc.s.alloc, arg_len::usize);
        if (R.is_err[*type.TypeId, str](res_copy)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*type.TypeId, str](res_copy))); }
        args_copy = R.unwrap_ok[*type.TypeId, str](res_copy);
        memory.copy[type.TypeId](args_copy, args, arg_len::usize);
    }

    var inst: Instance;
    inst.decl    = decl;
    inst.origin  = origin;
    inst.args    = args_copy;
    inst.arg_len = arg_len;
    inst.name    = name;
    inst.bare    = bare;
    inst.depth   = depth;
    inst.parent  = lc.scope.inst_current;
    lc.insts[lc.inst_len] = inst;
    val res_index: R.Result[bool, str] = map.insert[intern.StrId, u32](?lc.inst_by_name, name, lc.inst_len);
    if (R.is_err[bool, str](res_index)) { ret fail.lift[R.Void](R.void_of[bool, str](res_index)); }
    lc.inst_len = lc.inst_len + 1;
    ret R.ok_void[fail.Fail]();
}

fun instantiation_chain_error(lc: *LowerContext, bare: intern.StrId, args: *type.TypeId,
                              arg_len: u32, headline: str) str {
    var shown: [CHAIN_LINKS]u32;
    var count: u32 = 0;
    var total: u32 = 0;
    var walk:  u32 = lc.scope.inst_current;
    for (walk != INSTANCE_NONE) {
        if (count < CHAIN_LINKS) {
            shown[count] = walk;
            count = count + 1;
        }
        total = total + 1;
        walk = lc.insts[walk].parent;
    }

    var msg: str = chain_start(lc, headline);
    if (msg == nil) { ret headline; }

    if (total > count) {
        val elided: R.Result[str, str] = format.sprint(lc.s.alloc, "... ({} more) -> ", (total - count)::usize);
        if (R.is_err[str, str](elided)) { return_chain(lc, msg); ret headline; }
        msg = chain_append(lc, msg, R.unwrap_ok[str, str](elided), true);
        if (msg == nil) { ret headline; }
    }

    var i: u32 = count;
    for (i > 0) {
        i = i - 1;
        val link: R.Result[str, str] = typename.instance_spelling(lc.s, lc.insts[shown[i]].bare,
                                                                  lc.insts[shown[i]].args, lc.insts[shown[i]].arg_len);
        if (R.is_err[str, str](link)) { return_chain(lc, msg); ret headline; }
        msg = chain_append(lc, msg, R.unwrap_ok[str, str](link), true);
        if (msg == nil) { ret headline; }
        msg = chain_append(lc, msg, " -> ", false);
        if (msg == nil) { ret headline; }
    }

    val last: R.Result[str, str] = typename.instance_spelling(lc.s, bare, args, arg_len);
    if (R.is_err[str, str](last)) { return_chain(lc, msg); ret headline; }
    msg = chain_append(lc, msg, R.unwrap_ok[str, str](last), true);
    if (msg == nil) { ret headline; }

    val id_r: R.Result[intern.StrId, str] = intern.intern(?lc.s.interner, msg);
    return_chain(lc, msg);
    if (R.is_err[intern.StrId, str](id_r)) { ret headline; }
    val text: O.Option[str] = intern.lookup(?lc.s.interner, R.unwrap_ok[intern.StrId, str](id_r));
    if (O.is_none[str](text)) { ret headline; }
    ret O.unwrap[str](text);
}

fun chain_start(lc: *LowerContext, headline: str) str {
    val r: R.Result[str, str] = format.sprint(lc.s.alloc, "{}; chain: ", headline);
    if (R.is_err[str, str](r)) { ret nil; }
    ret R.unwrap_ok[str, str](r);
}

fun chain_append(lc: *LowerContext, msg: str, piece: str, piece_owned: bool) str {
    val r: R.Result[str, str] = format.sprint(lc.s.alloc, "{}{}", msg, piece);
    return_chain(lc, msg);
    if (piece_owned) { return_chain(lc, piece); }
    if (R.is_err[str, str](r)) { ret nil; }
    ret R.unwrap_ok[str, str](r);
}

fun return_chain(lc: *LowerContext, owned: str) {
    typename.type_str_free(lc.s, owned);
}

pub fun enqueue_value_instance(lc: *LowerContext, decl: id.DeclId, origin: session.ModuleId,
                               vals: *comptime.CTValue, names: *intern.StrId, val_len: u32,
                               name: intern.StrId) R.Result[R.Void, fail.Fail] {
    var lookup_name: intern.StrId = name;
    if (map.contains[intern.StrId, u32](?lc.vinst_by_name, ?lookup_name)) { ret R.ok_void[fail.Fail](); }

    if (lc.vinst_len >= MAX_VALUE_INSTANCES) {
        ret R.err[R.Void, fail.Fail](fail.message("comptime value-parameter instantiation limit exceeded (likely unbounded comptime recursion)"));
    }

    if (lc.vinst_len == lc.vinst_cap) {
        var new_cap: u32 = lc.vinst_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        if (lc.vinsts == nil) {
            val res_grow: R.Result[*ValueInstance, str] = A.allocate[ValueInstance](lc.s.alloc, new_cap::usize);
            if (R.is_err[*ValueInstance, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*ValueInstance, str](res_grow))); }
            lc.vinsts = R.unwrap_ok[*ValueInstance, str](res_grow);
        }
        or {
            val res_grow: R.Result[*ValueInstance, str] = A.reallocate[ValueInstance](lc.s.alloc, lc.vinsts, lc.vinst_cap::usize, new_cap::usize);
            if (R.is_err[*ValueInstance, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*ValueInstance, str](res_grow))); }
            lc.vinsts = R.unwrap_ok[*ValueInstance, str](res_grow);
        }
        lc.vinst_cap = new_cap;
    }

    var vals_copy: *comptime.CTValue = nil;
    var names_copy: *intern.StrId = nil;
    if (val_len > 0) {
        val res_vals: R.Result[*comptime.CTValue, str] = A.allocate[comptime.CTValue](lc.s.alloc, val_len::usize);
        if (R.is_err[*comptime.CTValue, str](res_vals)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*comptime.CTValue, str](res_vals))); }
        vals_copy = R.unwrap_ok[*comptime.CTValue, str](res_vals);
        val res_names: R.Result[*intern.StrId, str] = A.allocate[intern.StrId](lc.s.alloc, val_len::usize);
        if (R.is_err[*intern.StrId, str](res_names)) {
            A.deallocate[comptime.CTValue](lc.s.alloc, vals_copy, val_len::usize);
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*intern.StrId, str](res_names)));
        }
        names_copy = R.unwrap_ok[*intern.StrId, str](res_names);
        memory.copy[comptime.CTValue](vals_copy, vals, val_len::usize);
        memory.copy[intern.StrId](names_copy, names, val_len::usize);
    }

    var inst: ValueInstance;
    inst.decl    = decl;
    inst.origin  = origin;
    inst.vals    = vals_copy;
    inst.val_len = val_len;
    inst.names   = names_copy;
    inst.name    = name;
    lc.vinsts[lc.vinst_len] = inst;
    val res_index: R.Result[bool, str] = map.insert[intern.StrId, u32](?lc.vinst_by_name, name, lc.vinst_len);
    if (R.is_err[bool, str](res_index)) { ret fail.lift[R.Void](R.void_of[bool, str](res_index)); }
    lc.vinst_len = lc.vinst_len + 1;
    ret R.ok_void[fail.Fail]();
}

pub fun enqueue_pack_instance(lc: *LowerContext, decl: id.DeclId, origin: session.ModuleId,
                              args: *type.TypeId, arg_len: u32,
                              types: *type.TypeId, type_len: u32, name: intern.StrId) R.Result[R.Void, fail.Fail] {
    var lookup_name: intern.StrId = name;
    if (map.contains[intern.StrId, u32](?lc.pinst_by_name, ?lookup_name)) { ret R.ok_void[fail.Fail](); }

    if (lc.pinst_len >= MAX_PACK_INSTANCES) {
        ret R.err[R.Void, fail.Fail](fail.message("comptime pack instantiation limit exceeded (likely unbounded recursive pack expansion)"));
    }

    if (lc.pinst_len == lc.pinst_cap) {
        var new_cap: u32 = lc.pinst_cap * 2;
        if (new_cap == 0) { new_cap = INITIAL_STACK_CAP; }
        if (lc.pinsts == nil) {
            val res_grow: R.Result[*PackInstance, str] = A.allocate[PackInstance](lc.s.alloc, new_cap::usize);
            if (R.is_err[*PackInstance, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*PackInstance, str](res_grow))); }
            lc.pinsts = R.unwrap_ok[*PackInstance, str](res_grow);
        }
        or {
            val res_grow: R.Result[*PackInstance, str] = A.reallocate[PackInstance](lc.s.alloc, lc.pinsts, lc.pinst_cap::usize, new_cap::usize);
            if (R.is_err[*PackInstance, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*PackInstance, str](res_grow))); }
            lc.pinsts = R.unwrap_ok[*PackInstance, str](res_grow);
        }
        lc.pinst_cap = new_cap;
    }

    var args_copy: *type.TypeId = nil;
    if (arg_len > 0) {
        val res_args: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](lc.s.alloc, arg_len::usize);
        if (R.is_err[*type.TypeId, str](res_args)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*type.TypeId, str](res_args))); }
        args_copy = R.unwrap_ok[*type.TypeId, str](res_args);
        memory.copy[type.TypeId](args_copy, args, arg_len::usize);
    }

    var types_copy: *type.TypeId = nil;
    if (type_len > 0) {
        val res_copy: R.Result[*type.TypeId, str] = A.allocate[type.TypeId](lc.s.alloc, type_len::usize);
        if (R.is_err[*type.TypeId, str](res_copy)) {
            if (args_copy != nil) { A.deallocate[type.TypeId](lc.s.alloc, args_copy, arg_len::usize); }
            ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*type.TypeId, str](res_copy)));
        }
        types_copy = R.unwrap_ok[*type.TypeId, str](res_copy);
        memory.copy[type.TypeId](types_copy, types, type_len::usize);
    }

    var inst: PackInstance;
    inst.decl     = decl;
    inst.origin   = origin;
    inst.args     = args_copy;
    inst.arg_len  = arg_len;
    inst.types    = types_copy;
    inst.type_len = type_len;
    inst.name     = name;
    lc.pinsts[lc.pinst_len] = inst;
    val res_index: R.Result[bool, str] = map.insert[intern.StrId, u32](?lc.pinst_by_name, name, lc.pinst_len);
    if (R.is_err[bool, str](res_index)) { ret fail.lift[R.Void](R.void_of[bool, str](res_index)); }
    lc.pinst_len = lc.pinst_len + 1;
    ret R.ok_void[fail.Fail]();
}

pub fun push_fin(lc: *LowerContext, body: id.StmtId) R.Result[R.Void, fail.Fail] {
    if (lc.fin_len == lc.fin_cap) {
        val new_cap: u32 = lc.fin_cap * 2;
        val res_grow: R.Result[*id.StmtId, str] = A.reallocate[id.StmtId](lc.s.alloc, lc.fins, lc.fin_cap::usize, new_cap::usize);
        if (R.is_err[*id.StmtId, str](res_grow)) { ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[*id.StmtId, str](res_grow))); }
        lc.fins    = R.unwrap_ok[*id.StmtId, str](res_grow);
        lc.fin_cap = new_cap;
    }
    lc.fins[lc.fin_len] = body;
    lc.fin_len = lc.fin_len + 1;
    ret R.ok_void[fail.Fail]();
}

pub fun fin_count(lc: *LowerContext) u32 {
    ret lc.fin_len;
}

pub fun fin_at(lc: *LowerContext, i: u32) id.StmtId {
    if (i >= lc.fin_len) { ret id.STMT_NIL; }
    ret lc.fins[i];
}

pub fun pop_fins_to(lc: *LowerContext, mark: u32) {
    if (mark < lc.fin_len) { lc.fin_len = mark; }
}

pub fun lower_type(lc: *LowerContext, tid: type.TypeId) R.Result[ir_type.IrTypeId, fail.Fail] {
    if (tid == type.TYPE_NIL) {
        ret fail.lift[ir_type.IrTypeId](ir_type.intern_void(?lc.m.types));
    }

    var rtid: type.TypeId = tid;
    if (lc.scope.subst != nil && lc.scope.subst_len > 0) {
        rtid = recover_type(lc, generics.substitute(lc.s, tid, lc.scope.subst, lc.scope.subst_len));
    }

    val fields: R.Result[R.Void, str] = generics.ensure_fields(lc.s, rtid);
    if (R.is_err[R.Void, str](fields)) { ret fail.lift[ir_type.IrTypeId](R.err[ir_type.IrTypeId, str](R.unwrap_err[R.Void, str](fields))); }
    if (lc.status.kind == fail.INTERNAL) { ret R.err[ir_type.IrTypeId, fail.Fail](fail.phase_failure(lc.status)); }

    val t_opt: O.Option[*type.Type] = type.get(?lc.s.types, rtid);
    if (O.is_none[*type.Type](t_opt)) {
        ret fail.lift[ir_type.IrTypeId](ir_type.intern_void(?lc.m.types));
    }
    val t: *type.Type = O.unwrap[*type.Type](t_opt);
    val k: type.TypeKind = t.kind;

    if (k == type.TYPE_SECRET) { ret lower_type(lc, t.data.secret.base); }

    val d: type.PrimDesc = type.prim_desc(k);
    if (d.class == type.PRIM_CLASS_INT)   { ret fail.lift[ir_type.IrTypeId](ir_type.intern_int(?lc.m.types, d.bits)); }
    if (d.class == type.PRIM_CLASS_FLOAT) { ret fail.lift[ir_type.IrTypeId](ir_type.intern_float(?lc.m.types, d.bits)); }
    if (d.class == type.PRIM_CLASS_PTR)   { ret fail.lift[ir_type.IrTypeId](ir_type.intern_ptr(?lc.m.types)); }
    if (k == type.TYPE_POINTER)           { ret fail.lift[ir_type.IrTypeId](ir_type.intern_ptr(?lc.m.types)); }

    if (k == type.TYPE_ARRAY) {
        val res_base: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.array.base);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_base)) { ret res_base; }
        ret fail.lift[ir_type.IrTypeId](ir_type.intern_array(?lc.m.types, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_base), t.data.array.count));
    }

    if (k == type.TYPE_VECTOR) {
        val ed: type.PrimDesc = type.prim_desc(t.data.vector.element);
        var res_elem: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?lc.m.types, ed.bits);
        if (ed.class == type.PRIM_CLASS_FLOAT) { res_elem = ir_type.intern_float(?lc.m.types, ed.bits); }
        if (R.is_err[ir_type.IrTypeId, str](res_elem)) { ret fail.lift[ir_type.IrTypeId](res_elem); }
        ret fail.lift[ir_type.IrTypeId](ir_type.intern_vector(?lc.m.types, R.unwrap_ok[ir_type.IrTypeId, str](res_elem), t.data.vector.lanes));
    }

    if (k == type.TYPE_HANDLE) {
        ret lower_handle_type(lc, rtid, t);
    }

    if (k == type.TYPE_ABI) {
        ret lower_abi_type(lc, t);
    }

    if (k == type.TYPE_REC || k == type.TYPE_UNI || k == type.TYPE_INSTANCE) {
        ret lower_nominal(lc, rtid, type.is_union(?lc.s.types, rtid));
    }

    if (k == type.TYPE_FUN) {
        ret lower_function_type(lc, t);
    }

    ret fail.lift[ir_type.IrTypeId](ir_type.intern_ptr(?lc.m.types));
}

fun lower_abi_type(lc: *LowerContext, t: *type.Type) R.Result[ir_type.IrTypeId, fail.Fail] {
    val r_u8: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?lc.m.types, 8);
    if (R.is_err[ir_type.IrTypeId, str](r_u8)) { ret fail.lift[ir_type.IrTypeId](r_u8); }
    val r_arr: R.Result[ir_type.IrTypeId, str] =
        ir_type.intern_array(?lc.m.types, R.unwrap_ok[ir_type.IrTypeId, str](r_u8), t.data.abi.size);
    if (R.is_err[ir_type.IrTypeId, str](r_arr)) { ret fail.lift[ir_type.IrTypeId](r_arr); }
    var field: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](r_arr);
    ret fail.lift[ir_type.IrTypeId](ir_type.intern_struct(?lc.m.types, ?field, 1, t.data.abi.align, false));
}

fun lower_handle_type(lc: *LowerContext, rtid: type.TypeId, t: *type.Type) R.Result[ir_type.IrTypeId, fail.Fail] {
    val n: u32 = t.data.handle.ops_len;
    var ops: *ir_type.IrTypeId = nil;
    if (n > 0) {
        val r_ops: R.Result[*ir_type.IrTypeId, str] = A.allocate[ir_type.IrTypeId](lc.s.alloc, n::usize);
        if (R.is_err[*ir_type.IrTypeId, str](r_ops)) {
            ret R.err[ir_type.IrTypeId, fail.Fail](fail.message(R.unwrap_err[*ir_type.IrTypeId, str](r_ops)));
        }
        ops = R.unwrap_ok[*ir_type.IrTypeId, str](r_ops);
    }

    val td: *isa.TypeDef = isa.type_def_by_tag(lc.tgt.isa.defs, t.data.handle.ctor);

    var i: u32 = 0;
    for (i < n) {
        val w: u32 = type.handle_operand(?lc.s.types, rtid, i);
        ops[i] = w::ir_type.IrTypeId;
        if (td != nil && i < td.arity && td.operands[i] != isa.TYPE_OPERAND_WORD) {
            val inner: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, w::type.TypeId);
            if (R.is_err[ir_type.IrTypeId, fail.Fail](inner)) {
                if (ops != nil) { A.deallocate[ir_type.IrTypeId](lc.s.alloc, ops, n::usize); }
                ret inner;
            }
            ops[i] = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](inner);
        }
        i = i + 1;
    }

    val res: R.Result[ir_type.IrTypeId, str] = ir_type.intern_handle(?lc.m.types, t.data.handle.ctor, ops, n);
    if (ops != nil) { A.deallocate[ir_type.IrTypeId](lc.s.alloc, ops, n::usize); }
    ret fail.lift[ir_type.IrTypeId](res);
}

fun lower_nominal(lc: *LowerContext, tid: type.TypeId, is_union: bool) R.Result[ir_type.IrTypeId, fail.Fail] {
    var nom_align: u32 = 0;
    val ta: O.Option[u32] = session.type_align(lc.s, tid::u32);
    if (O.is_some[u32](ta)) { nom_align = O.unwrap[u32](ta); }

    val nom_packed: bool = session.type_is_packed(lc.s, tid::u32);

    val fields_len: u32 = type.field_count(?lc.s.types, tid);
    if (fields_len == 0) {
        ret fail.lift[ir_type.IrTypeId](ir_type.intern_struct(?lc.m.types, nil, 0, nom_align, nom_packed));
    }

    val res_buf: R.Result[*ir_type.IrTypeId, str] = A.allocate[ir_type.IrTypeId](lc.s.alloc, fields_len::usize);
    if (R.is_err[*ir_type.IrTypeId, str](res_buf)) {
        ret R.err[ir_type.IrTypeId, fail.Fail](fail.message(R.unwrap_err[*ir_type.IrTypeId, str](res_buf)));
    }
    val buf: *ir_type.IrTypeId = R.unwrap_ok[*ir_type.IrTypeId, str](res_buf);

    var i: u32 = 0;
    for (i < fields_len) {
        val fe_opt: O.Option[*type.FieldEntry] = type.field_at(?lc.s.types, tid, i);
        if (O.is_none[*type.FieldEntry](fe_opt)) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
            ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("field table for nominal type is missing an in-range field"));
        }

        val sem: type.TypeId = O.unwrap[*type.FieldEntry](fe_opt).ty;
        val res_field: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, sem);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_field)) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
            ret res_field;
        }
        buf[i] = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_field);
        i = i + 1;
    }

    var res_struct: R.Result[ir_type.IrTypeId, fail.Fail];
    if (is_union) {
        res_struct = fail.lift[ir_type.IrTypeId](ir_type.intern_union(?lc.m.types, buf, fields_len, nom_align, nom_packed));
    }
    or {
        res_struct = fail.lift[ir_type.IrTypeId](ir_type.intern_struct(?lc.m.types, buf, fields_len, nom_align, nom_packed));
    }
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, fields_len::usize);
    ret res_struct;
}

fun lower_function_type(lc: *LowerContext, t: *type.Type) R.Result[ir_type.IrTypeId, fail.Fail] {
    val res_ret: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, t.data.fn.ret_type);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ret)) { ret res_ret; }
    val ir_ret: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ret);

    val c_variadic: bool = t.data.fn.c_variadic;
    val params_len: u32  = t.data.fn.params_len;
    if (params_len == 0) {
        ret fail.lift[ir_type.IrTypeId](ir_type.intern_fn(?lc.m.types, ir_ret, nil, 0, c_variadic));
    }

    val res_buf: R.Result[*ir_type.IrTypeId, str] = A.allocate[ir_type.IrTypeId](lc.s.alloc, params_len::usize);
    if (R.is_err[*ir_type.IrTypeId, str](res_buf)) {
        ret R.err[ir_type.IrTypeId, fail.Fail](fail.message(R.unwrap_err[*ir_type.IrTypeId, str](res_buf)));
    }
    val buf: *ir_type.IrTypeId = R.unwrap_ok[*ir_type.IrTypeId, str](res_buf);

    var i: u32 = 0;
    for (i < params_len) {
        val po: O.Option[type.TypeId] = type.get_param(?lc.s.types, t.data.fn.params_start + i);
        var p_sem: type.TypeId = type.TYPE_NIL;
        if (O.is_some[type.TypeId](po)) { p_sem = O.unwrap[type.TypeId](po); }
        val res_param: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, p_sem);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_param)) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, params_len::usize);
            ret res_param;
        }
        buf[i] = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_param);
        i = i + 1;
    }

    val res_fn: R.Result[ir_type.IrTypeId, str] = ir_type.intern_fn(?lc.m.types, ir_ret, buf, params_len, c_variadic);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, params_len::usize);
    ret fail.lift[ir_type.IrTypeId](res_fn);
}

pub fun gate_is_active(lc: *LowerContext, source: str, cond: id.ExprId,
                       scope: comptime.GateScope, cache: bool) R.Result[bool, fail.Fail] {
    val vr: R.Result[comptime.GateVerdict, str] = comptime.evaluate_gate[LowerContext](
        lc.scope.ctx, lc, lc.caps, lc.scope.a, source, cond, ?lc.s.interner, scope, cache, true);
    if (R.is_err[comptime.GateVerdict, str](vr)) {
        ret R.err[bool, fail.Fail](fail.message(R.unwrap_err[comptime.GateVerdict, str](vr)));
    }
    val v: comptime.GateVerdict = R.unwrap_ok[comptime.GateVerdict, str](vr);
    if (v.outcome == comptime.GATE_ACTIVE)         { ret R.ok[bool, fail.Fail](true); }
    if (v.outcome == comptime.GATE_INACTIVE)       { ret R.ok[bool, fail.Fail](false); }
    if (v.outcome == comptime.GATE_AWAITING_TYPES) { ret R.ok[bool, fail.Fail](comptime.truth(v.value)); }
    if (str_len(v.message) > 0) { ret R.err[bool, fail.Fail](fail.message(v.message)); }
    ret R.err[bool, fail.Fail](fail.message("lower: a comptime gate reached lowering undecided"));
}

pub fun block_terminated(lc: *LowerContext) bool {
    if (lc.builder.fn == nil) { ret false; }
    val b: ir.BlockId = lc.builder.block;
    if (b == ir.BLOCK_NIL)              { ret false; }
    if (b >= lc.builder.fn.block_count) { ret false; }
    ret lc.builder.fn.blocks[b].terminator != ir.INSTR_NIL;
}

pub fun is_void_ir(lc: *LowerContext, tid: ir_type.IrTypeId) bool {
    val opt_type: O.Option[*ir_type.IrType] = ir_type.get(?lc.m.types, tid);
    if (O.is_none[*ir_type.IrType](opt_type)) { ret true; }
    ret O.unwrap[*ir_type.IrType](opt_type).kind == ir_type.IRT_VOID;
}

pub fun expr_type_of(lc: *LowerContext, eid: id.ExprId) type.TypeId {
    if (eid == id.EXPR_NIL)          { ret type.TYPE_NIL; }
    if (eid::usize >= lc.scope.a.expr_len) { ret type.TYPE_NIL; }
    ret lc.scope.sema_result.expr_type[eid];
}

pub fun expr_float_width(lc: *LowerContext, eid: id.ExprId) float.FloatWidth {
    ret float_width_of_type(lc, expr_type_of(lc, eid));
}

pub fun float_width_of_type(lc: *LowerContext, tid: type.TypeId) float.FloatWidth {
    if (tid == type.TYPE_NIL) { ret float.FLOAT_W_NONE; }
    val ct: type.TypeId = type.strip_secret(?lc.s.types, substitute_type(lc, tid));
    val opt_t: O.Option[*type.Type] = type.get(?lc.s.types, ct);
    if (O.is_none[*type.Type](opt_t)) { ret float.FLOAT_W_NONE; }
    ret type.float_width_of(O.unwrap[*type.Type](opt_t).kind);
}

pub fun expr_is_secret(lc: *LowerContext, eid: id.ExprId) bool {
    ret type_is_secret(lc, expr_type_of(lc, eid));
}

pub fun type_is_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_NIL) { ret false; }
    ret type.is_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun type_carries_secret(lc: *LowerContext, tid: type.TypeId) bool {
    if (tid == type.TYPE_NIL) { ret false; }
    ret type.carries_secret(?lc.s.types, substitute_type(lc, tid));
}

pub fun substitute_type(lc: *LowerContext, tid: type.TypeId) type.TypeId {
    if (lc.scope.subst == nil || lc.scope.subst_len == 0) { ret tid; }
    ret recover_type(lc, generics.substitute(lc.s, tid, lc.scope.subst, lc.scope.subst_len));
}

pub fun type_resolved_of(lc: *LowerContext, tid: id.TypeId) type.TypeId {
    if (tid == id.TYPE_NIL)          { ret type.TYPE_NIL; }
    if (tid::usize >= lc.scope.a.type_len) { ret type.TYPE_NIL; }
    ret lc.scope.sema_result.type_resolved_ty[tid];
}

pub fun decl_type_of(lc: *LowerContext, did: id.DeclId) type.TypeId {
    if (did == id.DECL_NIL)          { ret type.TYPE_NIL; }
    if (did::usize >= lc.scope.a.decl_len) { ret type.TYPE_NIL; }
    ret lc.scope.sema_result.decl_type[did];
}

pub fun decl_ret_sem(lc: *LowerContext, did: id.DeclId) type.TypeId {
    val fn_ty: type.TypeId = decl_type_of(lc, did);
    val to: O.Option[*type.Type] = type.get(?lc.s.types, fn_ty);
    if (O.is_none[*type.Type](to)) { ret type.TYPE_NIL; }
    val t: *type.Type = O.unwrap[*type.Type](to);
    if (t.kind != type.TYPE_FUN) { ret type.TYPE_NIL; }
    var ret_type: type.TypeId = t.data.fn.ret_type;
    if (lc.scope.subst != nil && lc.scope.subst_len > 0) {
        ret_type = recover_type(lc, generics.substitute(lc.s, ret_type, lc.scope.subst, lc.scope.subst_len));
    }
    ret ret_type;
}

pub fun function_return_ir(lc: *LowerContext, did: id.DeclId) R.Result[ir_type.IrTypeId, fail.Fail] {
    val sem: type.TypeId = decl_type_of(lc, did);
    val opt_type: O.Option[*type.Type] = type.get(?lc.s.types, sem);
    if (O.is_none[*type.Type](opt_type)) { ret fail.lift[ir_type.IrTypeId](ir_type.intern_void(?lc.m.types)); }
    val t: *type.Type = O.unwrap[*type.Type](opt_type);
    if (t.kind != type.TYPE_FUN) { ret fail.lift[ir_type.IrTypeId](ir_type.intern_void(?lc.m.types)); }
    ret lower_type(lc, t.data.fn.ret_type);
}

pub fun pack_instance_sig(lc: *LowerContext, d: *adecl.Decl, fixed_count: u32,
                          types: *type.TypeId, type_len: u32, ret_ir: ir_type.IrTypeId) R.Result[ir_type.IrTypeId, fail.Fail] {
    val total: u32 = fixed_count + type_len;
    if (total == 0) {
        ret fail.lift[ir_type.IrTypeId](ir_type.intern_fn(?lc.m.types, ret_ir, nil, 0, false));
    }

    val res_buf: R.Result[*ir_type.IrTypeId, str] = A.allocate[ir_type.IrTypeId](lc.s.alloc, total::usize);
    if (R.is_err[*ir_type.IrTypeId, str](res_buf)) { ret R.err[ir_type.IrTypeId, fail.Fail](fail.message(R.unwrap_err[*ir_type.IrTypeId, str](res_buf))); }
    val buf: *ir_type.IrTypeId = R.unwrap_ok[*ir_type.IrTypeId, str](res_buf);

    var i: u32 = 0;
    for (i < total) {
        var elem_sem: type.TypeId = type.TYPE_NIL;
        if (i < fixed_count) {
            val pool_ix: u32 = d.data.fun_.params_start + i;
            if (pool_ix::usize < lc.scope.a.typed_name_len) {
                elem_sem = type_resolved_of(lc, lc.scope.a.typed_names[pool_ix].ty);
            }
        }
        or {
            elem_sem = types[i - fixed_count];
        }
        val res_elem: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, elem_sem);
        if (R.is_err[ir_type.IrTypeId, fail.Fail](res_elem)) {
            A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, total::usize);
            ret res_elem;
        }
        buf[i] = R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_elem);
        i = i + 1;
    }

    val res_fn: R.Result[ir_type.IrTypeId, str] = ir_type.intern_fn(?lc.m.types, ret_ir, buf, total, false);
    A.deallocate[ir_type.IrTypeId](lc.s.alloc, buf, total::usize);
    ret fail.lift[ir_type.IrTypeId](res_fn);
}

pub fun instance_ref_sig(lc: *LowerContext, decl_id: id.DeclId, origin: session.ModuleId,
                         args: *type.TypeId, arg_len: u32) R.Result[ir_type.IrTypeId, fail.Fail] {
    val sc_o: O.Option[ModuleScope] = origin_scope(lc.s, origin);
    if (O.is_none[ModuleScope](sc_o)) {
        ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("lower: instance-reference origin module is not registered"));
    }
    var sc: ModuleScope = O.unwrap[ModuleScope](sc_o);
    sc.subst     = args;
    sc.subst_len = arg_len;

    val mark_r: R.Result[ScopeMark, fail.Fail] = scope_enter(lc, sc);
    if (R.is_err[ScopeMark, fail.Fail](mark_r)) {
        ret R.err[ir_type.IrTypeId, fail.Fail](R.unwrap_err[ScopeMark, fail.Fail](mark_r));
    }

    val res_sig: R.Result[ir_type.IrTypeId, fail.Fail] = lower_type(lc, decl_type_of(lc, decl_id));

    val leave: R.Result[R.Void, fail.Fail] = scope_leave(lc, R.unwrap_ok[ScopeMark, fail.Fail](mark_r));
    if (R.is_err[R.Void, fail.Fail](leave)) { ret R.err[ir_type.IrTypeId, fail.Fail](R.unwrap_err[R.Void, fail.Fail](leave)); }
    ret res_sig;
}

pub fun pack_instance_ref_sig(lc: *LowerContext, decl_id: id.DeclId, origin: session.ModuleId,
                              args: *type.TypeId, arg_len: u32,
                              types: *type.TypeId, type_len: u32) R.Result[ir_type.IrTypeId, fail.Fail] {
    val sc_o: O.Option[ModuleScope] = origin_scope(lc.s, origin);
    if (O.is_none[ModuleScope](sc_o)) {
        ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("lower: pack-instance-reference origin module is not registered"));
    }
    var sc: ModuleScope = O.unwrap[ModuleScope](sc_o);
    val opt_d: O.Option[*adecl.Decl] = ast.get_decl(sc.a, decl_id);
    if (O.is_none[*adecl.Decl](opt_d)) { ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("lower: pack-instance-reference origin declaration not found")); }
    val d: *adecl.Decl = O.unwrap[*adecl.Decl](opt_d);
    if (d.kind != adecl.DECL_KIND_FUN) { ret R.err[ir_type.IrTypeId, fail.Fail](fail.message("lower: pack-instance-reference origin declaration is not a function")); }
    sc.subst     = args;
    sc.subst_len = arg_len;

    val mark_r: R.Result[ScopeMark, fail.Fail] = scope_enter(lc, sc);
    if (R.is_err[ScopeMark, fail.Fail](mark_r)) {
        ret R.err[ir_type.IrTypeId, fail.Fail](R.unwrap_err[ScopeMark, fail.Fail](mark_r));
    }

    var res_sig: R.Result[ir_type.IrTypeId, fail.Fail];
    val res_ret_ir: R.Result[ir_type.IrTypeId, fail.Fail] = function_return_ir(lc, decl_id);
    if (R.is_err[ir_type.IrTypeId, fail.Fail](res_ret_ir)) {
        res_sig = R.err[ir_type.IrTypeId, fail.Fail](R.unwrap_err[ir_type.IrTypeId, fail.Fail](res_ret_ir));
    }
    or {
        val fixed_count: u32 = d.data.fun_.params_len - 1;
        res_sig = pack_instance_sig(lc, d, fixed_count, types, type_len, R.unwrap_ok[ir_type.IrTypeId, fail.Fail](res_ret_ir));
    }

    val leave: R.Result[R.Void, fail.Fail] = scope_leave(lc, R.unwrap_ok[ScopeMark, fail.Fail](mark_r));
    if (R.is_err[R.Void, fail.Fail](leave)) { ret R.err[ir_type.IrTypeId, fail.Fail](R.unwrap_err[R.Void, fail.Fail](leave)); }
    ret res_sig;
}

pub fun expr_symbol_of(lc: *LowerContext, eid: id.ExprId) resolve.SymbolId {
    if (eid == id.EXPR_NIL)             { ret resolve.SYMBOL_NIL; }
    if (eid::usize >= lc.scope.rr.expr_count) { ret resolve.SYMBOL_NIL; }
    val sid: resolve.SymbolId = lc.scope.rr.expr_resolved[eid];
    if (sid == resolve.SYMBOL_REJECTED) {
        fail.reject(?lc.status);
        ret resolve.SYMBOL_NIL;
    }
    ret sid;
}

pub fun module_source(lc: *LowerContext) str {
    ret ast_source(lc, lc.scope.a);
}

pub fun ast_source(lc: *LowerContext, a: *ast.Ast) str {
    if (a == nil) { ret ""; }
    val sf: O.Option[*source.SourceFile] = source.get(?lc.s.sources, a.file_id);
    if (O.is_none[*source.SourceFile](sf)) { ret ""; }
    ret O.unwrap[*source.SourceFile](sf).text;
}

pub fun decl_target_op(a: *ast.Ast, src: str, d: *adecl.Decl, defs: *isa.TargetDefs, out_op: *u32) u32 {
    if (a == nil || d == nil) { ret isa.NO_OP_SET; }
    var i: u32 = 0;
    for (i < d.decorators_len) {
        val dec: *adecl.Decorator = ?a.decorators[d.decorators_start + i];
        if (!str_region_equals(src, dec.name.offset, dec.name.len, "op")) { i = i + 1; cnt; }
        if (dec.args_len != 3) { ret isa.NO_OP_SET; }
        val opt_set: O.Option[*aexpr.Expr] = ast.get_expr(a, a.expr_ids[dec.args_start + 1]);
        val opt_nam: O.Option[*aexpr.Expr] = ast.get_expr(a, a.expr_ids[dec.args_start + 2]);
        if (O.is_none[*aexpr.Expr](opt_set) || O.is_none[*aexpr.Expr](opt_nam)) { ret isa.NO_OP_SET; }
        val set_e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_set);
        val nam_e: *aexpr.Expr = O.unwrap[*aexpr.Expr](opt_nam);
        if (set_e.span.len < 2::usize || nam_e.span.len < 2::usize) { ret isa.NO_OP_SET; }
        val od: *isa.OpDef = isa.op_def_of_region(defs,
            src, set_e.span.offset + 1::usize, set_e.span.len - 2::usize,
            src, nam_e.span.offset + 1::usize, nam_e.span.len - 2::usize);
        if (od == nil) { ret isa.NO_OP_SET; }
        @out_op = od.opcode;
        ret od.set_tag;
    }
    ret isa.NO_OP_SET;
}

pub fun emit_dbg_birth(lc: *LowerContext, name_span: token.Span, ty: ir_type.IrTypeId,
                       ty_sem: type.TypeId, is_param: bool, val_v: value.Value,
                       slot: O.Option[value.Value]) R.Result[R.Void, fail.Fail] {
    val res_name: R.Result[intern.StrId, str] = intern.intern_span(?lc.s.interner, module_source(lc), name_span);
    if (R.is_err[intern.StrId, str](res_name)) {
        ret R.err[R.Void, fail.Fail](fail.message(R.unwrap_err[intern.StrId, str](res_name)));
    }
    val name: intern.StrId = R.unwrap_ok[intern.StrId, str](res_name);
    var sem: type.TypeId = ty_sem;
    if (lc.scope.subst != nil && lc.scope.subst_len > 0) {
        sem = recover_type(lc, generics.substitute(lc.s, sem, lc.scope.subst, lc.scope.subst_len));
    }
    if (O.is_some[value.Value](slot)) {
        val sv: value.Value = O.unwrap[value.Value](slot);
        if (sv.kind == value.VAL_INSTR) {
            var dv: ir.DbgVar;
            dv.name     = name;
            dv.ty       = ty;
            dv.ty_sem   = sem;
            dv.is_param = is_param;
            dv.scope    = 0;
            val res_link: R.Result[R.Void, str] = ir.record_alloca_dbg_var(lc.builder.fn, sv.data.instr, dv);
            if (R.is_err[R.Void, str](res_link)) { ret fail.lift[R.Void](res_link); }
        }
    }
    ret fail.lift[R.Void](builder.emit_dbg_value(?lc.builder, val_v, name, ty, sem, is_param, 0));
}

pub fun symbol_of(lc: *LowerContext, sid: resolve.SymbolId) O.Option[*resolve.Symbol] {
    if (sid == resolve.SYMBOL_NIL) { ret O.none[*resolve.Symbol](); }
    if (sid >= lc.scope.rr.symbol_count) { ret O.none[*resolve.Symbol](); }
    ret O.some[*resolve.Symbol](?lc.scope.rr.symbols[sid]);
}

pub fun ensure_extern_function(lc: *LowerContext, name: intern.StrId, sig: ir_type.IrTypeId, import_flag: bool) R.Result[u32, fail.Fail] {
    val m: *ir.Module = lc.m;
    val existing: O.Option[u32] = ir.function_lookup(m, name);
    if (O.is_some[u32](existing)) {
        val fi: u32 = O.unwrap[u32](existing);
        if (import_flag) { m.functions[fi].is_import = true; }
        ret R.ok[u32, fail.Fail](fi);
    }

    if (m.function_len == m.function_cap) {
        val new_cap: u32 = grow_cap(m.function_cap);
        val res_grow: R.Result[*ir.Function, str] = A.reallocate[ir.Function](m.alloc, m.functions, m.function_cap::usize, new_cap::usize);
        if (R.is_err[*ir.Function, str](res_grow)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[*ir.Function, str](res_grow))); }
        m.functions    = R.unwrap_ok[*ir.Function, str](res_grow);
        m.function_cap = new_cap;
    }

    val idx: u32 = m.function_len;
    m.functions[idx] = ir.function_new(m.alloc, name, sig, ir.FN_FLAG_EXTERN);
    m.functions[idx].is_import = import_flag;
    m.function_len   = m.function_len + 1;
    val res_reg: R.Result[R.Void, str] = ir.function_register(m, name, idx);
    if (R.is_err[R.Void, str](res_reg)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_reg))); }

    if (lc.builder.fn != nil && lc.fn_index < m.function_len) {
        lc.builder.fn = ?m.functions[lc.fn_index];
    }
    ret R.ok[u32, fail.Fail](idx);
}

pub fun ensure_extern_global(lc: *LowerContext, name: intern.StrId, ty: ir_type.IrTypeId, import_flag: bool) R.Result[u32, fail.Fail] {
    val m: *ir.Module = lc.m;
    val existing: O.Option[u32] = ir.global_lookup(m, name);
    if (O.is_some[u32](existing)) {
        val gi: u32 = O.unwrap[u32](existing);
        if (import_flag) { m.globals[gi].is_import = true; }
        ret R.ok[u32, fail.Fail](gi);
    }

    if (m.global_len == m.global_cap) {
        val new_cap: u32 = grow_cap(m.global_cap);
        val res_grow: R.Result[*ir.Global, str] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, new_cap::usize);
        if (R.is_err[*ir.Global, str](res_grow)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[*ir.Global, str](res_grow))); }
        m.globals    = R.unwrap_ok[*ir.Global, str](res_grow);
        m.global_cap = new_cap;
    }

    val idx: u32 = m.global_len;
    var g: ir.Global;
    g.name      = name;
    g.ty        = ty;
    g.init      = value.const_int(0, ty);
    g.is_mut    = true;
    g.is_pub    = false;
    g.is_extern = true;
    g.is_import = import_flag;
    g.is_local  = false;
    g.is_embed  = false;
    g.align     = 0;
    g.section   = intern.STR_NIL;
    m.globals[idx] = g;
    m.global_len   = m.global_len + 1;
    val res_reg: R.Result[R.Void, str] = ir.global_register(m, name, idx);
    if (R.is_err[R.Void, str](res_reg)) { ret R.err[u32, fail.Fail](fail.message(R.unwrap_err[R.Void, str](res_reg))); }
    ret R.ok[u32, fail.Fail](idx);
}

pub fun add_rodata_bytes(lc: *LowerContext, init: value.Value, pty: ir_type.IrTypeId) R.Result[value.Value, fail.Fail] {
    val m: *ir.Module = lc.m;
    val res_name: R.Result[intern.StrId, fail.Fail] = anon_global_name(lc, m.global_len);
    if (R.is_err[intern.StrId, fail.Fail](res_name)) { ret R.err[value.Value, fail.Fail](R.unwrap_err[intern.StrId, fail.Fail](res_name)); }

    if (m.global_len == m.global_cap) {
        val new_cap: u32 = grow_cap(m.global_cap);
        val res_grow: R.Result[*ir.Global, str] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, new_cap::usize);
        if (R.is_err[*ir.Global, str](res_grow)) { ret R.err[value.Value, fail.Fail](fail.message(R.unwrap_err[*ir.Global, str](res_grow))); }
        m.globals    = R.unwrap_ok[*ir.Global, str](res_grow);
        m.global_cap = new_cap;
    }

    val idx: u32 = m.global_len;
    var g: ir.Global;
    g.name      = R.unwrap_ok[intern.StrId, fail.Fail](res_name);
    g.ty        = init.ty;
    g.init      = init;
    g.is_mut    = false;
    g.is_pub    = false;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = true;
    g.is_embed  = false;
    g.align     = 0;
    g.section   = intern.STR_NIL;
    m.globals[idx] = g;
    m.global_len   = m.global_len + 1;

    ret R.ok[value.Value, fail.Fail](value.global(idx, pty));
}

fun anon_global_name(lc: *LowerContext, n: u32) R.Result[intern.StrId, fail.Fail] {
    var buf: [16]u8;
    buf[0] = '.';
    buf[1] = 'L';
    buf[2] = 'c';
    buf[3] = '.';
    var len: usize = 4;
    var d: u32 = 0;
    for (d < 8) {
        val shift: u32 = (7 - d) * 4;
        val nib: u32 = (n >> shift) & 0xF;
        var c: u8 = nib::u8 + 0x30;
        if (nib > 9) { c = nib::u8 - 10 + 0x61; }
        buf[len] = c;
        len = len + 1;
        d = d + 1;
    }
    ret fail.lift[intern.StrId](intern.intern_bytes(?lc.s.interner, (?buf[0])::str, len));
}

fun grow_cap(cap: u32) u32 {
    if (cap == 0) { ret 4; }
    ret cap * 2;
}

fun enqueue_distinct_instances(lc: *LowerContext, first: u32, count: u32) R.Result[R.Void, fail.Fail] {
    var i: u32 = first;
    for (i < first + count) {
        val r: R.Result[R.Void, fail.Fail] = enqueue_instance(lc, 0::id.DeclId, 0::session.ModuleId, nil, 0, i::intern.StrId, i::intern.StrId);
        if (R.is_err[R.Void, fail.Fail](r)) { ret r; }
        i = i + 1;
    }
    ret R.ok_void[fail.Fail]();
}

fun time_enqueue_fresh(count: u32) i64 {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret -1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret -1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var lc: LowerContext;
    lc.status = fail.accepted();
    lc.s            = ?s;
    lc.scope        = scope_nil();
    lc.inst_len     = 0;
    lc.inst_cap     = 0;
    lc.insts        = nil;
    lc.inst_by_name = map.init[intern.StrId, u32](?alloc, map.hash_u32, map.eq_u32);

    val start: tm.Time = tm.monotonic();
    val ok: R.Result[R.Void, fail.Fail] = enqueue_distinct_instances(?lc, 0, count);
    val elapsed: duration.Duration = tm.time_sub(tm.monotonic(), start);
    if (R.is_err[R.Void, fail.Fail](ok)) { ret -1; }

    var i: u32 = 0;
    for (i < lc.inst_len) {
        if (lc.insts[i].args != nil && lc.insts[i].arg_len > 0) {
            A.deallocate[type.TypeId](?alloc, lc.insts[i].args, lc.insts[i].arg_len::usize);
        }
        i = i + 1;
    }
    if (lc.insts != nil && lc.inst_cap > 0) { A.deallocate[Instance](?alloc, lc.insts, lc.inst_cap::usize); }
    map.dnit[intern.StrId, u32](?lc.inst_by_name);

    ret duration.duration_usec(elapsed);
}

fun time_enqueue_min(count: u32, reps: u32) i64 {
    var best: i64 = -1;
    var r: u32 = 0;
    for (r < reps) {
        val us: i64 = time_enqueue_fresh(count);
        if (us < 0) { ret -1; }
        if (best < 0 || us < best) { best = us; }
        r = r + 1;
    }
    ret best;
}

test "mach.lang.me.lower.context.scope_leave:refuses_a_stale_or_out_of_order_mark" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var lc: LowerContext;
    lc.status = fail.accepted();
    lc.s                = ?s;
    lc.scopes           = nil;
    lc.scope_len        = 0;
    lc.scope_cap        = 0;
    lc.scope_generation = 0;
    lc.scope_top        = 0;

    var home: ModuleScope = scope_nil();
    home.fqn = 11::intern.StrId;
    lc.scope = home;

    var first: ModuleScope = scope_nil();
    first.fqn = 22::intern.StrId;
    var second: ModuleScope = scope_nil();
    second.fqn = 33::intern.StrId;

    var code: i32 = 0;

    val m1r: R.Result[ScopeMark, fail.Fail] = scope_enter(?lc, first);
    if (R.is_err[ScopeMark, fail.Fail](m1r)) { ret 1; }
    val m1: ScopeMark = R.unwrap_ok[ScopeMark, fail.Fail](m1r);
    if (lc.scope.fqn != 22::intern.StrId) { code = 1; }

    val m2r: R.Result[ScopeMark, fail.Fail] = scope_enter(?lc, second);
    if (R.is_err[ScopeMark, fail.Fail](m2r)) { ret 1; }
    val m2: ScopeMark = R.unwrap_ok[ScopeMark, fail.Fail](m2r);
    if (lc.scope.fqn != 33::intern.StrId) { code = 1; }

    if (R.is_ok[R.Void, fail.Fail](scope_leave(?lc, m1))) { code = 1; }
    if (lc.scope.fqn != 33::intern.StrId) { code = 1; }
    if (lc.scope_len != 2) { code = 1; }

    if (R.is_err[R.Void, fail.Fail](scope_leave(?lc, m2))) { code = 1; }
    if (lc.scope.fqn != 22::intern.StrId) { code = 1; }

    if (R.is_ok[R.Void, fail.Fail](scope_leave(?lc, m2))) { code = 1; }

    if (R.is_err[R.Void, fail.Fail](scope_leave(?lc, m1))) { code = 1; }
    if (lc.scope.fqn != 11::intern.StrId) { code = 1; }
    if (lc.scope_len != 0) { code = 1; }

    var other: LowerContext;
    other.status = fail.accepted();
    other.s = ?s;
    if (R.is_ok[R.Void, fail.Fail](scope_leave(?other, m1))) { code = 1; }

    if (lc.scopes != nil && lc.scope_cap > 0) {
        A.deallocate[ModuleScope](?alloc, lc.scopes, lc.scope_cap::usize);
    }
    ret code;
}

test "mach.lang.me.lower.context.module_scope:refuses_a_piece_that_belongs_to_another_module" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var a1:  ast.Ast;
    var a2:  ast.Ast;
    var sm1: sema.SemaResult;
    var sm2: sema.SemaResult;
    var rr1: resolve.ResolveResult;
    var rr2: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    var cc2: comptime.ComptimeCtx;

    val mid: session.ModuleId = 0::session.ModuleId;
    val fqn: intern.StrId     = 7::intern.StrId;

    val ri: R.Result[R.Void, str] = session.register_module_identity(?s, mid, ?a1, fqn, 5);
    if (R.is_err[R.Void, str](ri)) { ret 1; }
    val rp: R.Result[R.Void, str] = session.register_module_phase(?s, mid, (?sm1)::ptr, (?rr1)::ptr, (?cc1)::ptr);
    if (R.is_err[R.Void, str](rp)) { ret 1; }

    var code: i32 = 0;

    cc1.env.pointer_width = 99;
    val good: R.Result[ModuleScope, fail.Fail] = module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, ?cc1);
    if (R.is_err[ModuleScope, fail.Fail](good)) { ret 1; }
    val sc: ModuleScope = R.unwrap_ok[ModuleScope, fail.Fail](good);
    if (sc.env.pointer_width != 99) { code = 1; }
    cc1.env.pointer_width = 12;
    if (sc.env.pointer_width != 99) { code = 1; }

    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a2, fqn, ?sm1, ?rr1, ?cc1)))               { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a1, 8::intern.StrId, ?sm1, ?rr1, ?cc1)))   { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a1, fqn, ?sm2, ?rr1, ?cc1)))               { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr2, ?cc1)))               { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, ?cc2)))               { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, nil, fqn, ?sm1, ?rr1, ?cc1)))               { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a1, fqn, nil, ?rr1, ?cc1)))                { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a1, fqn, ?sm1, nil, ?cc1)))                { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, mid, ?a1, fqn, ?sm1, ?rr1, nil)))                { code = 1; }
    if (R.is_ok[ModuleScope, fail.Fail](module_scope(?s, 1::session.ModuleId, ?a1, fqn, ?sm1, ?rr1, ?cc1))) { code = 1; }

    ret code;
}

test "mach.lang.me.lower.context.request:refuses_a_module_product_that_does_not_correspond" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var a1:  ast.Ast;
    var a2:  ast.Ast;
    var sm1: sema.SemaResult;
    var rr1: resolve.ResolveResult;
    var cc1: comptime.ComptimeCtx;
    var tgt: target.Target;

    val mid: session.ModuleId = 0::session.ModuleId;
    val fqn: intern.StrId     = 7::intern.StrId;

    val ri: R.Result[R.Void, str] = session.register_module_identity(?s, mid, ?a1, fqn, 5);
    if (R.is_err[R.Void, str](ri)) { ret 1; }
    val rp: R.Result[R.Void, str] = session.register_module_phase(?s, mid, (?sm1)::ptr, (?rr1)::ptr, (?cc1)::ptr);
    if (R.is_err[R.Void, str](rp)) { ret 1; }

    var code: i32 = 0;

    val good: R.Result[LowerRequest, fail.Fail] = request(?s, ?tgt, ?alloc, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, false, false);
    if (R.is_err[LowerRequest, fail.Fail](good)) { ret 1; }
    val req: LowerRequest = R.unwrap_ok[LowerRequest, fail.Fail](good);
    if (req.module.a != ?a1 || req.module.own_module != mid) { code = 1; }

    if (R.is_ok[LowerRequest, fail.Fail](request(?s, nil, ?alloc, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, false, false))) { code = 1; }
    if (R.is_ok[LowerRequest, fail.Fail](request(?s, ?tgt, nil, ?a1, fqn, mid, ?sm1, ?rr1, ?cc1, false, false)))   { code = 1; }
    if (R.is_ok[LowerRequest, fail.Fail](request(?s, ?tgt, ?alloc, ?a2, fqn, mid, ?sm1, ?rr1, ?cc1, false, false))) { code = 1; }

    ret code;
}

test "mach.lang.me.lower.context.enqueue_instance:cost_stays_near_linear_as_population_grows" {
    val small: u32 = 1500;
    val large: u32 = small * 4;

    val us_small: i64 = time_enqueue_min(small, 7);
    val us_large: i64 = time_enqueue_min(large, 7);
    if (us_small < 0 || us_large < 0) { ret 1; }

    var pa: A.Allocator;
    page.make(?pa);
    val msg: R.Result[str, str] = format.sprint(?pa, "us_small={} us_large={}\n", us_small, us_large);
    if (R.is_ok[str, str](msg)) { print.eprint(R.unwrap_ok[str, str](msg)); }

    var bad: i32 = 0;
    if (us_large > us_small * 8) { bad = 1; }
    ret bad;
}

test "mach.lang.me.lower.context.enqueue_pack_instance:refuses_past_the_instance_cap" {
    var alloc: A.Allocator;
    if (O.is_some[str](page.make(?alloc))) { ret 1; }
    val sr: R.Result[session.Session, str] = session.init(?alloc);
    if (R.is_err[session.Session, str](sr)) { ret 1; }
    var s: session.Session = R.unwrap_ok[session.Session, str](sr);

    var lc: LowerContext;
    lc.status = fail.accepted();
    lc.s            = ?s;
    lc.pinst_len    = 0;
    lc.pinst_cap    = 0;
    lc.pinsts       = nil;
    lc.pinst_by_name = map.init[intern.StrId, u32](?alloc, map.hash_u32, map.eq_u32);

    var code: i32 = 0;
    var i: u32 = 0;
    for (i < MAX_PACK_INSTANCES) {
        val r: R.Result[R.Void, fail.Fail] = enqueue_pack_instance(?lc, 0::id.DeclId, 0::session.ModuleId, nil, 0, nil, 0, i::intern.StrId);
        if (R.is_err[R.Void, fail.Fail](r)) { code = 1; brk; }
        i = i + 1;
    }
    if (lc.pinst_len != MAX_PACK_INSTANCES) { code = 1; }

    val over: R.Result[R.Void, fail.Fail] = enqueue_pack_instance(?lc, 0::id.DeclId, 0::session.ModuleId, nil, 0, nil, 0, MAX_PACK_INSTANCES::intern.StrId);
    if (R.is_ok[R.Void, fail.Fail](over)) { code = 1; }
    if (lc.pinst_len != MAX_PACK_INSTANCES) { code = 1; }

    var j: u32 = 0;
    for (j < lc.pinst_len) {
        if (lc.pinsts[j].args != nil && lc.pinsts[j].arg_len > 0) {
            A.deallocate[type.TypeId](?alloc, lc.pinsts[j].args, lc.pinsts[j].arg_len::usize);
        }
        if (lc.pinsts[j].types != nil && lc.pinsts[j].type_len > 0) {
            A.deallocate[type.TypeId](?alloc, lc.pinsts[j].types, lc.pinsts[j].type_len::usize);
        }
        j = j + 1;
    }
    if (lc.pinsts != nil && lc.pinst_cap > 0) { A.deallocate[PackInstance](?alloc, lc.pinsts, lc.pinst_cap::usize); }
    map.dnit[intern.StrId, u32](?lc.pinst_by_name);

    ret code;
}

pub fun recover_type(lc: *LowerContext, r: R.Result[type.TypeId, str]) type.TypeId {
    if (R.is_err[type.TypeId, str](r)) {
        fail.internal(?lc.status, R.unwrap_err[type.TypeId, str](r));
        ret type.TYPE_ERROR;
    }
    ret R.unwrap_ok[type.TypeId, str](r);
}
