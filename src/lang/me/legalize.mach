# the target-driven rewrites every build runs at every level: each turns an
# operation the target has no instruction for into ones it has, or establishes
# a property the back end relies on
fwd mach.lang.me.legalize.scalarize;
fwd mach.lang.me.legalize.shiftbound;
fwd mach.lang.me.legalize.vecsplat;
fwd mach.lang.me.legalize.vecsplit;
fwd mach.lang.me.legalize.wide;
fwd mach.lang.me.legalize.widenmul;
