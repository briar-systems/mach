use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;

use A:          std.allocator;
use std_format: std.format;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use check_scope: mach.lang.me.check.scope;
use me_ir:          mach.lang.me.ir;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use lang_source: mach.lang.source;

# a function that computes on a secret without declaring `#[oblivious]` is
# refused at the first such operation, every function named
pub fun run(s: *check_scope.Scope) err[fail.Fail] {
    val m:     *me_ir.Module = s.module;
    var clean: bool          = true;
    var fi:    u32  = 0;
    for (fi < m.function_len) {
        val fn: *me_ir.Function = ?m.functions[fi];
        fi = fi + 1;

        if ((fn.flags & me_ir.FN_FLAG_EXTERN) != 0)    { cnt; }
        if ((fn.flags & me_ir.FN_FLAG_OBLIVIOUS) != 0) { cnt; }

        val hit: opt[*ir_instruction.Instruction] = first_secret_compute(fn);
        if (sel hit.none) { cnt; }
        val inst: *ir_instruction.Instruction = hit.some;

        val rr: err[fail.Fail] = report(fn, inst, s.interner, s.diags, s.alloc);
        if (sel rr.err) { ret rr; }
        clean = false;
    }
    if (!clean) { ret err[fail.Fail].err{fail.reported()}; }
    ret err[fail.Fail].ok{};
}

fun first_secret_compute(fn: *me_ir.Function) opt[*ir_instruction.Instruction] {
    var ii: u32 = 0;
    for (ii < fn.instr_len) {
        val inst: *ir_instruction.Instruction = ?fn.instrs[ii];
        ii = ii + 1;
        if (inst.secret && !opdesc.transfers_secrecy(inst.kind)) {
            ret opt[*ir_instruction.Instruction].some{inst};
        }
    }
    ret opt[*ir_instruction.Instruction].none{};
}

fun report(fn: *me_ir.Function, inst: *ir_instruction.Instruction, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore, alloc: *A.Allocator) err[fail.Fail] {
    val name:  str = name_of(fn, itn);
    val klass: str = op_class_name(inst.kind);

    val mr: res[str, std_format.FormatError] = std_format.sprint(alloc,
        "`{}` performs a constant-time {} on a secret value but is not declared `#[oblivious]`",
        name, klass);
    if (sel mr.err) { ret err[fail.Fail].err{fail.format_refused(mr.err)}; }
    val msg: str = mr.ok;

    val br: res[diagnostic.DiagnosticBuilder, fail.Fail] = diagnostic.builder_init(alloc, diagnostic_kind.SECRET_NOT_OBLIVIOUS, inst.loc.file, inst.loc.span, msg);
    A.deallocate[u8](alloc, msg::*u8, str_len(msg) + 1);
    if (sel br.err) { ret err[fail.Fail].err{br.err}; }
    var b: diagnostic.DiagnosticBuilder = br.ok;

    if ((fn.flags & me_ir.FN_FLAG_WEAK) != 0) {
        val ir_o: opt[str] = intern.get(itn, fn.name);
        if (sel ir_o.some) {
            val nr: res[str, std_format.FormatError] = std_format.sprint(alloc, "in the instantiation `{}`", ir_o.some);
            if (sel nr.err) {
                diagnostic.builder_dnit(?b);
                ret err[fail.Fail].err{fail.format_refused(nr.err)};
            }
            val note: str            = nr.ok;
            val ar:   err[fail.Fail] = diagnostic.attach_note(?b, note);
            A.deallocate[u8](alloc, note::*u8, str_len(note) + 1);
            if (sel ar.err) {
                diagnostic.builder_dnit(?b);
                ret err[fail.Fail].err{ar.err};
            }
        }
    }

    val hr: err[fail.Fail] = diagnostic.attach_help(?b,
        "annotate the function with `#[oblivious]` to declare its constant-time contract; only a function that merely moves or stores secrets may omit it");
    if (sel hr.err) {
        diagnostic.builder_dnit(?b);
        ret err[fail.Fail].err{hr.err};
    }

    val cr: err[fail.Fail] = diagnostic.commit(?b, diags);
    if (sel cr.err) {
        diagnostic.builder_dnit(?b);
        ret err[fail.Fail].err{cr.err};
    }
    ret err[fail.Fail].ok{};
}

# the function's display name, its linkage name without one, and a function
# with neither is named as such
fun name_of(fn: *me_ir.Function, itn: *intern.Interner) str {
    if (!intern.str_is_nil(fn.disp)) { ret intern.text(itn, fn.disp); }
    if (!intern.str_is_nil(fn.name)) { ret intern.text(itn, fn.name); }
    ret "<anonymous>";
}

fun op_class_name(k: ir_instruction.InstrKind) str {
    ret opdesc.class_name(k);
}
