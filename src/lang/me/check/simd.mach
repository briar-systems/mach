# the vector checks: an operation whose shape the target does not declare, and
# an operation that falls back to scalar code
use mach.lang.fail;
use collections_vector: std.collections.vector;
use std.collections.vector.Vector;
use std_format: std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use A: std.allocator;

use mach.lang.diagnostic;
use diagnostic_kind: mach.lang.diagnostic.kind;
use mach.lang.intern;
use check_scope: mach.lang.me.check.scope;
use me_ir:       mach.lang.me.ir;
use mach.lang.me.ir.opdesc;
use me_legalize: mach.lang.me.legalize;
use mach.lang.me.vecform;
use catalog_arch: mach.lang.target.catalog.arch;
use mach.lang.target.extension;
use target_model: mach.lang.target.model;
use mach.lang.target.resolved;

# a vector operator whose shape the target's catalog does not name is refused in
# every simd mode: the outcome is a declaration, never a fallback. the refusal
# is a located error on the store, so the tally and exit status agree
pub fun declared(s: *check_scope.Scope) err[fail.Fail] {
    ret declared_check(s.module, s.target, s.interner, s.diags);
}

fun declared_check(m: *me_ir.Module, tgt: *resolved.Target, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore) err[fail.Fail] {
    var site:  me_legalize.scalarize.Site;
    val count: u32 = me_legalize.scalarize.detect_undeclared(m, tgt, ?site);
    if (count == 0) { ret err[fail.Fail].ok{}; }
    val text: res[str, fail.Fail] = undeclared_msg(m, tgt, itn, ?site);
    if (sel text.err) { ret err[fail.Fail].err{text.err}; }
    ret err[fail.Fail].err{diagnostic.reject(diags, diagnostic_kind.VECTOR_UNDECLARED_FORM, site.loc, text.ok)};
}

# the diagnostic spelling of a site's vector operation; a descriptor vector tag
# or an operation outside its catalog is named as such instead
fun site_op_name(m: *me_ir.Module, itn: *intern.Interner, site: *me_legalize.scalarize.Site) res[str, fail.Fail] {
    val op: opt[target_model.VecOp] = vecform.vec_op_of(site.op, site.uniform_count);
    if (sel op.none) { ret res[str, fail.Fail].err{fail.message_of(fail.catalog_interned(itn, m.alloc, fail.unknown_member("IrVecOp", opdesc.vec_op(site.op)::u32)))}; }
    val name: opt[str] = vecform.vec_op_name(op.some);
    if (sel name.none) { ret res[str, fail.Fail].err{fail.message_of(fail.catalog_interned(itn, m.alloc, fail.unknown_member("VecOp", op.some::u32)))}; }
    ret res[str, fail.Fail].ok{name.some};
}

# the name of the function a site is in; a function without one is named as such
fun site_fn_name(itn: *intern.Interner, site: *me_legalize.scalarize.Site) str {
    if (intern.str_is_nil(site.fn_name)) { ret "<anonymous>"; }
    ret intern.text(itn, site.fn_name);
}

fun undeclared_msg(m: *me_ir.Module, tgt: *resolved.Target, itn: *intern.Interner, site: *me_legalize.scalarize.Site) res[str, fail.Fail] {
    val op: res[str, fail.Fail] = site_op_name(m, itn, site);
    if (sel op.err) { ret op; }
    ret undeclared_text(m, tgt, op.ok, site_fn_name(itn, site), site);
}

fun undeclared_text(m: *me_ir.Module, tgt: *resolved.Target, op: str, fname: str, site: *me_legalize.scalarize.Site) res[str, fail.Fail] {
    if (site.lane_bits == 0) {
        val r_239: res[str, std_format.FormatError] = std_format.sprint(m.alloc,
            "vector {} in '{}' has a lane shape outside the retained vocabulary (8, 16, 32 or 64-bit integer lanes, 32 or 64-bit float lanes), so {} declares neither a packed form nor the scalar expansion for it",
            op, fname, catalog_arch.name_for(tgt.arch_id));
        if (sel r_239.err) { ret res[str, fail.Fail].err{fail.format_refused(r_239.err)}; }
        ret res[str, fail.Fail].ok{r_239.ok};
    }
    var lane: str = "integers";
    if (site.is_float) { lane = "floats"; }
    val r_241: res[str, std_format.FormatError] = std_format.sprint(m.alloc,
        "vector {} on {} lanes of {}-bit {} in '{}' has no declared form on {}: the target's catalog names neither a packed instruction nor the scalar expansion for this operation and lane shape",
        op, site.lanes, site.lane_bits, lane, fname, catalog_arch.name_for(tgt.arch_id));
    if (sel r_241.err) { ret res[str, fail.Fail].err{fail.format_refused(r_241.err)}; }
    ret res[str, fail.Fail].ok{r_241.ok};
}

# every operation that falls back to scalar code is named at its own site: a
# warning by default, and under `simd = "require"` an error, the same sites
# with the same text. each names the operation, its lanes and the target, and
# the extension whose declared packed row would pack it, read from the catalog
pub fun fallback(s: *check_scope.Scope) err[fail.Fail] {
    ret fallback_check(s.module, s.target, s.interner, s.diags, s.simd_require);
}

fun fallback_check(m: *me_ir.Module, tgt: *resolved.Target, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore,
    require: bool) err[fail.Fail] {
    var found: Vector[me_legalize.scalarize.Site] = collections_vector.init[me_legalize.scalarize.Site](m.alloc);
    fin { collections_vector.dnit[me_legalize.scalarize.Site](?found); }
    val listed: err[A.Error] = me_legalize.scalarize.list(m, tgt, ?found);
    if (sel listed.err) { ret err[fail.Fail].err{fail.refused(listed.err)}; }
    var refused: bool      = false;
    var first:   fail.Fail = fail.reported();
    var i:       usize     = 0;
    for (i < found.len) {
        val site: *me_legalize.scalarize.Site = ?found.data[i];
        val made: res[str, fail.Fail]         = fallback_msg(m, tgt, itn, site, require);
        if (sel made.err) { ret err[fail.Fail].err{made.err}; }
        val text: str = made.ok;
        if (require) {
            val f: fail.Fail = diagnostic.reject(diags, diagnostic_kind.VECTOR_SCALARIZE_REFUSED, site.loc, text);
            if (!refused) { first = f; }
            refused = true;
        }
        or { diagnostic.record(diags, diagnostic_kind.VECTOR_SCALARIZE, site.loc.file, site.loc.span, text); }
        i = i + 1;
    }
    if (refused) { ret err[fail.Fail].err{first}; }
    ret err[fail.Fail].ok{};
}

fun fallback_msg(m: *me_ir.Module, tgt: *resolved.Target, itn: *intern.Interner, site: *me_legalize.scalarize.Site, require: bool) res[str, fail.Fail] {
    val op_r: res[str, fail.Fail] = site_op_name(m, itn, site);
    if (sel op_r.err) { ret op_r; }
    val op:    str = op_r.ok;
    val fname: str = site_fn_name(itn, site);
    var lane:  str = "integers";
    if (site.is_float) { lane = "floats"; }

    val why: res[str, std_format.FormatError] = fallback_reason(m, tgt, site);
    if (sel why.err) { ret res[str, fail.Fail].err{fail.format_refused(why.err)}; }
    var text: res[str, std_format.FormatError];
    if (require) {
        text = std_format.sprint(m.alloc,
            "simd = \"require\": vector {} on {} lanes of {}-bit {} in '{}' would scalarize on {}: {}; set simd = \"scalarize\" to build with the scalar expansion",
            op, site.lanes, site.lane_bits, lane, fname, catalog_arch.name_for(tgt.arch_id), why.ok);
    }
    or {
        text = std_format.sprint(m.alloc, "vector {} on {} lanes of {}-bit {} in '{}' scalarizes on {}: {}",
            op, site.lanes, site.lane_bits, lane, fname, catalog_arch.name_for(tgt.arch_id), why.ok);
    }
    if (sel text.err) { ret res[str, fail.Fail].err{fail.format_refused(text.err)}; }
    ret res[str, fail.Fail].ok{text.ok};
}

# why a site has no packed form: the extensions its declared row needs, or
# that no row packs it at any extension
fun fallback_reason(m: *me_ir.Module, tgt: *resolved.Target, site: *me_legalize.scalarize.Site) res[str, std_format.FormatError] {
    if (!tgt.model.has_v128) { ret std_format.sprint(m.alloc, "{} has no 128-bit SIMD", catalog_arch.name_for(tgt.arch_id)); }
    val cap: u32 = vecform.packed_lanes(tgt, site.is_float, site.lane_bits);
    if (cap != 0 && site.lanes > cap && vecform.piece_lanes(tgt, site.is_float, site.lane_bits) == 0) {
        ret std_format.sprint(m.alloc, "the shape has more lanes than one packed vector holds, at any extension");
    }
    var ext: u64                     = 0;
    val op:  opt[target_model.VecOp] = vecform.vec_op_of(site.op, site.uniform_count);
    if (sel op.some) { ext = target_model.packing_extension(?tgt.model, op.some, site.is_float, site.lane_bits, site.from_bits); }
    if (ext == 0)    { ret std_format.sprint(m.alloc, "no packed form for it at any extension"); }
    var names: str = "";
    var k:     u32 = 0;
    for (k < tgt.model.extension_count) {
        val row: *extension.Extension = ?tgt.model.extension_table[k];
        if ((row.bit & ext) != 0) {
            var joined: res[str, std_format.FormatError];
            if (str_len(names) == 0) { joined = std_format.sprint(m.alloc, "`{}`", row.name); }
            or                       { joined = std_format.sprint(m.alloc, "{} and `{}`", names, row.name); }
            if (sel joined.err)      { ret joined; }
            names = joined.ok;
        }
        k = k + 1;
    }
    ret std_format.sprint(m.alloc, "declaring {} in the target's `extensions` packs it", names);
}
