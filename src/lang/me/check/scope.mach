# what every module check reads, and the shape each check takes
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;

use A: std.allocator;

use mach.lang.diagnostic;
use mach.lang.intern;
use me_ir: mach.lang.me.ir;
use mach.lang.target.resolved;

# what a check reads, every check the same record
pub rec Scope {
    module:   *me_ir.Module;
    target:   *resolved.Target;
    interner: *intern.Interner;
    diags:    *diagnostic.DiagnosticStore;
    # where a check formats its messages
    alloc: *A.Allocator;
    # whether a scalar fallback is refused rather than warned at
    simd_require: bool;
}

# a check over `scope.module`, failed once it has refused
pub def Check: fun(*Scope) err[fail.Fail];

# a scope over `m` for `tgt`, with `simd = "require"` off
pub fun init(m: *me_ir.Module, tgt: *resolved.Target, itn: *intern.Interner, diags: *diagnostic.DiagnosticStore, alloc: *A.Allocator) Scope {
    ret Scope{module: m, target: tgt, interner: itn, diags: diags, alloc: alloc, simd_require: false};
}
