use std.types.result.res;
use std.types.error.err;
use mach.lang.fail;
use std.allocator.arena;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str_equals;
use std.text.string.str_free;
use T: std.allocator.testing;
use std.types.string.str;
use std.text.string.str_dup;

use A: std.allocator;

use mach.lang.me.ir;

pub rec Function {
    module: *ir.Module;
    body: *ir.Function;
}

pub rec Workspace {
    region: arena.Arena;
    alloc: A.Allocator;
}

pub fun init(work: *Workspace) err[fail.Fail] {
    var backing: A.Allocator;
    val initialized: err[A.Error] = page.make(?backing);
    if (sel initialized.err) { ret err[fail.Fail].err{fail.refused(initialized.err)}; }
    ret init_with_backing(work, ?backing);
}

fun init_with_backing(work: *Workspace, backing: *A.Allocator) err[fail.Fail] {
    # retain one bounded chunk across functions and discard overflow on reset
    val initialized: err[A.Error] = arena.init(?work.region, backing, 65536::usize);
    if (sel initialized.err) { ret err[fail.Fail].err{fail.refused(initialized.err)}; }
    val bound: err[A.Error] = arena.make(?work.alloc, ?work.region);
    if (sel bound.err) { arena.dnit(?work.region); }
    if (sel bound.err) { ret err[fail.Fail].err{fail.refused(bound.err)}; }
    ret err[fail.Fail].ok{};
}

# a workspace whose requests go straight to `alloc` and are never reclaimed by
# `run`: the fail-at-N probes count every scratch request through it and hold
# the transform to releasing each one itself
pub fun init_direct(work: *Workspace, alloc: *A.Allocator) err[fail.Fail] {
    val initialized: err[A.Error] = arena.init(?work.region, alloc, 0::usize);
    if (sel initialized.err) { ret err[fail.Fail].err{fail.refused(initialized.err)}; }
    work.alloc = @alloc;
    ret err[fail.Fail].ok{};
}

pub fun dnit(work: *Workspace) {
    arena.dnit(?work.region);
}

# a failure's text belongs to the result owner before scratch is released
fun retain(owner: *A.Allocator, f: fail.Fail) fail.Fail {
    if (sel f.reported) { ret f; }
    val retained: res[str, A.Error] = str_dup(owner, f.message);
    if (sel retained.err) { ret fail.refused(retained.err); }
    ret fail.message(retained.ok);
}

# successful results must not borrow workspace storage
pub fun run[C, T](work: *Workspace, owner: *A.Allocator, context: *C, action: fun(*C, *A.Allocator) res[T, fail.Fail]) res[T, fail.Fail] {
    fin { arena.reset(?work.region); }
    val result: res[T, fail.Fail] = action(context, ?work.alloc);
    if (sel result.ok) { ret result; }
    ret res[T, fail.Fail].err{retain(owner, result.err)};
}

# the same for an action with no value
pub fun run_unit[C](work: *Workspace, owner: *A.Allocator, context: *C, action: fun(*C, *A.Allocator) err[fail.Fail]) err[fail.Fail] {
    fin { arena.reset(?work.region); }
    val result: err[fail.Fail] = action(context, ?work.alloc);
    if (sel result.ok) { ret result; }
    ret err[fail.Fail].err{retain(owner, result.err)};
}

fun run_with_backing[C, T](owner: *A.Allocator, context: *C, action: fun(*C, *A.Allocator) res[T, fail.Fail], backing: *A.Allocator) res[T, fail.Fail] {
    var work: Workspace;
    val initialized: err[fail.Fail] = init_with_backing(?work, backing);
    if (sel initialized.err) { ret res[T, fail.Fail].err{initialized.err}; }
    fin { dnit(?work); }
    ret run[C, T](?work, owner, context, action);
}

rec Probe {
    owner: *A.Allocator;
    output: *u64;
    reject: bool;
}

fun probe(p: *Probe, alloc: *A.Allocator) res[u64, fail.Fail] {
    val first: res[*u8, A.Error] = A.allocate[u8](alloc, 65536::usize);
    if (sel first.err) { ret res[u64, fail.Fail].err{fail.refused(first.err)}; }
    val second: res[*u8, A.Error] = A.allocate[u8](alloc, 262144::usize);
    if (sel second.err) { ret res[u64, fail.Fail].err{fail.refused(second.err)}; }
    if (p.reject) {
        val message: res[str, A.Error] = str_dup(alloc, "scratch diagnostic survives reclamation");
        if (sel message.err) { ret res[u64, fail.Fail].err{fail.refused(message.err)}; }
        ret res[u64, fail.Fail].err{fail.message(message.ok)};
    }
    val output: res[*u64, A.Error] = A.allocate[u64](p.owner, 1::usize);
    if (sel output.err) { ret res[u64, fail.Fail].err{fail.refused(output.err)}; }
    p.output = output.ok;
    p.output[0] = 0x0807060504030201;
    ret res[u64, fail.Fail].ok{23};
}

test "mach.lang.me.scratch:results_and_diagnostics_survive_reclamation" {
    var reject: u32 = 0;
    for (reject < 2) {
        var attempts: usize = 0;
        var ordinal: usize = 0;
        for (ordinal <= attempts) {
            var backing: T.Testing;
            val r_98: err[A.Error] = T.make(?backing);
            if (sel r_98.err) { ret 1; }
            fin { T.dnit(?backing); }
            backing.fail_at = ordinal;
            var owner: T.Testing;
            val r_102: err[A.Error] = T.make(?owner);
            if (sel r_102.err) { ret 1; }
            fin { T.dnit(?owner); }
            var context: Probe = Probe{owner: ?owner.a, output: nil, reject: reject != 0};
            val result: res[u64, fail.Fail] = run_with_backing[Probe, u64](?owner.a, ?context, probe, ?backing.a);
            if (ordinal == 0) { attempts = backing.attempts; }
            if (backing.live != 0 || backing.double_frees != 0 || backing.exhausted != 0) { ret 2; }
            if (ordinal != 0 || reject != 0) {
                if (sel result.ok) { ret 3; }
                val message: str = fail.describe(result.err);
                if (message == nil || message[0] == 0 || context.output != nil) { ret 4; }
                if (ordinal == 0 && !str_equals(message, "scratch diagnostic survives reclamation")) { ret 5; }
                if (owner.live != 0) { str_free(?owner.a, message); }
            }
            or {
                if (sel result.err) { ret 6; }
                if (result.ok != 23) { ret 6; }
                if (context.output == nil || context.output[0] != 0x0807060504030201) { ret 7; }
                A.deallocate[u64](?owner.a, context.output, 1::usize);
            }
            if (owner.live != 0 || owner.double_frees != 0 || owner.exhausted != 0) { ret 8; }
            ordinal = ordinal + 1;
        }
        if (attempts < 2) { ret 9; }
        reject = reject + 1;
    }
    ret 0;
}

fun reuse_probe(count: *u64, alloc: *A.Allocator) res[u64, fail.Fail] {
    val allocated: res[*u64, A.Error] = A.allocate[u64](alloc, 512::usize);
    if (sel allocated.err) { ret res[u64, fail.Fail].err{fail.refused(allocated.err)}; }
    val values: *u64 = allocated.ok;
    values[0] = @count;
    @count = values[0] + 1;
    ret res[u64, fail.Fail].ok{@count};
}

test "mach.lang.me.scratch:reuses_a_bounded_chunk_between_functions" {
    var backing: T.Testing;
    val r_141: err[A.Error] = T.make(?backing);
    if (sel r_141.err) { ret 1; }
    fin { T.dnit(?backing); }
    var owner: A.Allocator;
    val r_144: err[A.Error] = page.make(?owner);
    if (sel r_144.err) { ret 1; }
    var work: Workspace;
    val r_146: err[fail.Fail] = init_with_backing(?work, ?backing.a);
    if (sel r_146.err) { ret 1; }
    var count: u64 = 0;
    var good: bool = true;
    for (count < 64 && good) {
        val r_150: res[u64, fail.Fail] = run[u64, u64](?work, ?owner, ?count, reuse_probe);
        if (sel r_150.err) { good = false; }
        if (backing.live != 1 || backing.total != 1 || work.region.off != 0) { good = false; }
    }
    dnit(?work);
    if (!good || count != 64) { ret 10; }
    if (backing.live != 0 || backing.double_frees != 0 || backing.exhausted != 0) { ret 11; }
    ret 0;
}
