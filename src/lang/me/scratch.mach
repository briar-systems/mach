use std.allocator.arena;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str_equals;
use std.text.string.str_free;
use T: std.allocator.testing;
use std.types.string.str;
use std.text.string.str_dup;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.me.ir;

pub rec Function {
    module: *ir.Module;
    body: *ir.Function;
}

pub fun run[C](owner: *A.Allocator, context: *C, action: fun(*C, *A.Allocator) R.Result[bool, str]) R.Result[bool, str] {
    var backing: A.Allocator;
    val initialized: O.Option[str] = page.make(?backing);
    if (O.is_some[str](initialized)) { ret R.err[bool, str](O.unwrap[str](initialized)); }
    ret run_with_backing[C](owner, context, action, ?backing);
}

fun run_with_backing[C](owner: *A.Allocator, context: *C, action: fun(*C, *A.Allocator) R.Result[bool, str], backing: *A.Allocator) R.Result[bool, str] {
    var region: arena.Arena;
    val initialized: O.Option[str] = arena.init(?region, backing, 0);
    if (O.is_some[str](initialized)) { ret R.err[bool, str](O.unwrap[str](initialized)); }
    fin { arena.dnit(?region); }
    var alloc: A.Allocator;
    val bound: O.Option[str] = arena.make(?alloc, ?region);
    if (O.is_some[str](bound)) { ret R.err[bool, str](O.unwrap[str](bound)); }
    val result: R.Result[bool, str] = action(context, ?alloc);
    if (R.is_ok[bool, str](result)) { ret result; }
    # diagnostic storage belongs to the result owner before scratch is released
    val retained: R.Result[str, str] = str_dup(owner, R.unwrap_err[bool, str](result));
    if (R.is_err[str, str](retained)) { ret R.err[bool, str](R.unwrap_err[str, str](retained)); }
    ret R.err[bool, str](R.unwrap_ok[str, str](retained));
}

rec Probe {
    owner: *A.Allocator;
    output: *u64;
    reject: bool;
}

fun probe(p: *Probe, alloc: *A.Allocator) R.Result[bool, str] {
    val first: R.Result[*u8, str] = A.allocate[u8](alloc, 65536::usize);
    if (R.is_err[*u8, str](first)) { ret R.err[bool, str](R.unwrap_err[*u8, str](first)); }
    val second: R.Result[*u8, str] = A.allocate[u8](alloc, 262144::usize);
    if (R.is_err[*u8, str](second)) { ret R.err[bool, str](R.unwrap_err[*u8, str](second)); }
    if (p.reject) {
        val message: R.Result[str, str] = str_dup(alloc, "scratch diagnostic survives reclamation");
        if (R.is_err[str, str](message)) { ret R.err[bool, str](R.unwrap_err[str, str](message)); }
        ret R.err[bool, str](R.unwrap_ok[str, str](message));
    }
    val output: R.Result[*u64, str] = A.allocate[u64](p.owner, 1::usize);
    if (R.is_err[*u64, str](output)) { ret R.err[bool, str](R.unwrap_err[*u64, str](output)); }
    p.output = R.unwrap_ok[*u64, str](output);
    p.output[0] = 0x0807060504030201;
    ret R.ok[bool, str](true);
}

test "mach.lang.me.scratch:results_and_diagnostics_survive_reclamation" {
    var reject: u32 = 0;
    for (reject < 2) {
        var attempts: usize = 0;
        var ordinal: usize = 0;
        for (ordinal <= attempts) {
            var backing: T.Testing;
            if (O.is_some[str](T.make(?backing))) { ret 1; }
            fin { T.dnit(?backing); }
            backing.fail_at = ordinal;
            var owner: T.Testing;
            if (O.is_some[str](T.make(?owner))) { ret 1; }
            fin { T.dnit(?owner); }
            var context: Probe = Probe{owner: ?owner.a, output: nil, reject: reject != 0};
            val result: R.Result[bool, str] = run_with_backing[Probe](?owner.a, ?context, probe, ?backing.a);
            if (ordinal == 0) { attempts = backing.attempts; }
            if (backing.live != 0 || backing.double_frees != 0 || backing.exhausted != 0) { ret 2; }
            if (ordinal != 0 || reject != 0) {
                if (R.is_ok[bool, str](result)) { ret 3; }
                val message: str = R.unwrap_err[bool, str](result);
                if (message == nil || message[0] == 0 || context.output != nil) { ret 4; }
                if (ordinal == 0 && !str_equals(message, "scratch diagnostic survives reclamation")) { ret 5; }
                str_free(?owner.a, message);
            }
            or {
                if (R.is_err[bool, str](result) || !R.unwrap_ok[bool, str](result)) { ret 6; }
                if (context.output == nil || context.output[0] != 0x0807060504030201) { ret 7; }
                A.deallocate[u64](?owner.a, context.output, 1::usize);
            }
            if (owner.live != 0 || owner.double_frees != 0 || owner.exhausted != 0) { ret 8; }
            ordinal = ordinal + 1;
        }
        if (attempts < 2) { ret 9; }
        reject = reject + 1;
    }
    ret 0;
}
