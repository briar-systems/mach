use std.allocator.arena;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.string.str_equals;
use std.text.string.str_free;
use T: std.allocator.testing;
use std.types.string.str;
use std.text.string.str_dup;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.me.ir;

pub rec Function {
    module: *ir.Module;
    body: *ir.Function;
}

pub rec Workspace {
    region: arena.Arena;
    alloc: A.Allocator;
}

pub fun init(work: *Workspace) O.Option[str] {
    var backing: A.Allocator;
    val initialized: O.Option[str] = page.make(?backing);
    if (O.is_some[str](initialized)) { ret initialized; }
    ret init_with_backing(work, ?backing);
}

fun init_with_backing(work: *Workspace, backing: *A.Allocator) O.Option[str] {
    # retain one bounded chunk across functions and discard overflow on reset
    val initialized: O.Option[str] = arena.init(?work.region, backing, 65536::usize);
    if (O.is_some[str](initialized)) { ret initialized; }
    val bound: O.Option[str] = arena.make(?work.alloc, ?work.region);
    if (O.is_some[str](bound)) { arena.dnit(?work.region); }
    ret bound;
}

pub fun dnit(work: *Workspace) {
    arena.dnit(?work.region);
}

pub fun run[C](work: *Workspace, owner: *A.Allocator, context: *C, action: fun(*C, *A.Allocator) R.Result[bool, str]) R.Result[bool, str] {
    fin { arena.reset(?work.region); }
    val result: R.Result[bool, str] = action(context, ?work.alloc);
    if (R.is_ok[bool, str](result)) { ret result; }
    # diagnostic storage belongs to the result owner before scratch is released
    val retained: R.Result[str, str] = str_dup(owner, R.unwrap_err[bool, str](result));
    if (R.is_err[str, str](retained)) { ret R.err[bool, str](R.unwrap_err[str, str](retained)); }
    ret R.err[bool, str](R.unwrap_ok[str, str](retained));
}

fun run_with_backing[C](owner: *A.Allocator, context: *C, action: fun(*C, *A.Allocator) R.Result[bool, str], backing: *A.Allocator) R.Result[bool, str] {
    var work: Workspace;
    val initialized: O.Option[str] = init_with_backing(?work, backing);
    if (O.is_some[str](initialized)) { ret R.err[bool, str](O.unwrap[str](initialized)); }
    fin { dnit(?work); }
    ret run[C](?work, owner, context, action);
}

rec Probe {
    owner: *A.Allocator;
    output: *u64;
    reject: bool;
}

fun probe(p: *Probe, alloc: *A.Allocator) R.Result[bool, str] {
    val first: R.Result[*u8, str] = A.allocate[u8](alloc, 65536::usize);
    if (R.is_err[*u8, str](first)) { ret R.err[bool, str](R.unwrap_err[*u8, str](first)); }
    val second: R.Result[*u8, str] = A.allocate[u8](alloc, 262144::usize);
    if (R.is_err[*u8, str](second)) { ret R.err[bool, str](R.unwrap_err[*u8, str](second)); }
    if (p.reject) {
        val message: R.Result[str, str] = str_dup(alloc, "scratch diagnostic survives reclamation");
        if (R.is_err[str, str](message)) { ret R.err[bool, str](R.unwrap_err[str, str](message)); }
        ret R.err[bool, str](R.unwrap_ok[str, str](message));
    }
    val output: R.Result[*u64, str] = A.allocate[u64](p.owner, 1::usize);
    if (R.is_err[*u64, str](output)) { ret R.err[bool, str](R.unwrap_err[*u64, str](output)); }
    p.output = R.unwrap_ok[*u64, str](output);
    p.output[0] = 0x0807060504030201;
    ret R.ok[bool, str](true);
}

test "mach.lang.me.scratch:results_and_diagnostics_survive_reclamation" {
    var reject: u32 = 0;
    for (reject < 2) {
        var attempts: usize = 0;
        var ordinal: usize = 0;
        for (ordinal <= attempts) {
            var backing: T.Testing;
            if (O.is_some[str](T.make(?backing))) { ret 1; }
            fin { T.dnit(?backing); }
            backing.fail_at = ordinal;
            var owner: T.Testing;
            if (O.is_some[str](T.make(?owner))) { ret 1; }
            fin { T.dnit(?owner); }
            var context: Probe = Probe{owner: ?owner.a, output: nil, reject: reject != 0};
            val result: R.Result[bool, str] = run_with_backing[Probe](?owner.a, ?context, probe, ?backing.a);
            if (ordinal == 0) { attempts = backing.attempts; }
            if (backing.live != 0 || backing.double_frees != 0 || backing.exhausted != 0) { ret 2; }
            if (ordinal != 0 || reject != 0) {
                if (R.is_ok[bool, str](result)) { ret 3; }
                val message: str = R.unwrap_err[bool, str](result);
                if (message == nil || message[0] == 0 || context.output != nil) { ret 4; }
                if (ordinal == 0 && !str_equals(message, "scratch diagnostic survives reclamation")) { ret 5; }
                if (owner.live != 0) { str_free(?owner.a, message); }
            }
            or {
                if (R.is_err[bool, str](result) || !R.unwrap_ok[bool, str](result)) { ret 6; }
                if (context.output == nil || context.output[0] != 0x0807060504030201) { ret 7; }
                A.deallocate[u64](?owner.a, context.output, 1::usize);
            }
            if (owner.live != 0 || owner.double_frees != 0 || owner.exhausted != 0) { ret 8; }
            ordinal = ordinal + 1;
        }
        if (attempts < 2) { ret 9; }
        reject = reject + 1;
    }
    ret 0;
}

fun reuse_probe(count: *u64, alloc: *A.Allocator) R.Result[bool, str] {
    val allocated: R.Result[*u64, str] = A.allocate[u64](alloc, 512::usize);
    if (R.is_err[*u64, str](allocated)) { ret R.err[bool, str](R.unwrap_err[*u64, str](allocated)); }
    val values: *u64 = R.unwrap_ok[*u64, str](allocated);
    values[0] = @count;
    @count = values[0] + 1;
    ret R.ok[bool, str](true);
}

test "mach.lang.me.scratch:reuses_a_bounded_chunk_between_functions" {
    var backing: T.Testing;
    if (O.is_some[str](T.make(?backing))) { ret 1; }
    fin { T.dnit(?backing); }
    var owner: A.Allocator;
    if (O.is_some[str](page.make(?owner))) { ret 1; }
    var work: Workspace;
    if (O.is_some[str](init_with_backing(?work, ?backing.a))) { ret 1; }
    var count: u64 = 0;
    var good: bool = true;
    for (count < 64 && good) {
        if (R.is_err[bool, str](run[u64](?work, ?owner, ?count, reuse_probe))) { good = false; }
        if (backing.live != 1 || backing.total != 1 || work.region.off != 0) { good = false; }
    }
    dnit(?work);
    if (!good || count != 64) { ret 10; }
    if (backing.live != 0 || backing.double_frees != 0 || backing.exhausted != 0) { ret 11; }
    ret 0;
}
