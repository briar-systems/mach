use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use me_ir:          mach.lang.me.ir;
use ir_instruction: mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use lang_target: mach.lang.target;
use mach.lang.target.isa;

# the target-layer vector operation an instruction kind maps to, VEC_OP_NONE
# for a kind that is not a vector operator; absent for a descriptor vector tag
# outside the catalog, which the caller refuses as undeclared and names. a
# shift is keyed by its count's form as well: `uniform_count` is one scalar
# count for every lane, and otherwise the count is a vector of lane counts
pub fun vec_op_of(k: ir_instruction.InstrKind, uniform_count: bool) opt[isa.VecOp] {
    ret isa_vec_op(opdesc.vec_op(k), uniform_count);
}

# a vector shift whose count is one scalar rather than a vector of lane counts
pub fun uniform_count(m: *me_ir.Module, inst: *ir_instruction.Instruction) bool {
    if (inst.operand_count < 2) { ret false; }
    ret !ir_type.is_vector(?m.types, inst.operands[1].ty);
}

fun isa_vec_op(v: opdesc.IrVecOp, uniform_count: bool) opt[isa.VecOp] {
    if (v == opdesc.IVEC_SHL) {
        if (uniform_count) { ret opt[isa.VecOp].some{isa.VEC_OP_SHL_U}; }
        ret opt[isa.VecOp].some{isa.VEC_OP_SHL_V};
    }
    if (v == opdesc.IVEC_SHR_U) {
        if (uniform_count) { ret opt[isa.VecOp].some{isa.VEC_OP_SHR_U_U}; }
        ret opt[isa.VecOp].some{isa.VEC_OP_SHR_U_V};
    }
    if (v == opdesc.IVEC_SHR_S) {
        if (uniform_count) { ret opt[isa.VecOp].some{isa.VEC_OP_SHR_S_U}; }
        ret opt[isa.VecOp].some{isa.VEC_OP_SHR_S_V};
    }
    if (v == opdesc.IVEC_NONE)        { ret opt[isa.VecOp].some{isa.VEC_OP_NONE}; }
    if (v == opdesc.IVEC_ADD)         { ret opt[isa.VecOp].some{isa.VEC_OP_ADD}; }
    if (v == opdesc.IVEC_SUB)         { ret opt[isa.VecOp].some{isa.VEC_OP_SUB}; }
    if (v == opdesc.IVEC_MUL)         { ret opt[isa.VecOp].some{isa.VEC_OP_MUL}; }
    if (v == opdesc.IVEC_DIV)         { ret opt[isa.VecOp].some{isa.VEC_OP_DIV}; }
    if (v == opdesc.IVEC_AND)         { ret opt[isa.VecOp].some{isa.VEC_OP_AND}; }
    if (v == opdesc.IVEC_OR)          { ret opt[isa.VecOp].some{isa.VEC_OP_OR}; }
    if (v == opdesc.IVEC_XOR)         { ret opt[isa.VecOp].some{isa.VEC_OP_XOR}; }
    if (v == opdesc.IVEC_NOT)         { ret opt[isa.VecOp].some{isa.VEC_OP_NOT}; }
    if (v == opdesc.IVEC_NEG)         { ret opt[isa.VecOp].some{isa.VEC_OP_NEG}; }
    if (v == opdesc.IVEC_CMP)         { ret opt[isa.VecOp].some{isa.VEC_OP_CMP}; }
    if (v == opdesc.IVEC_TRUNC)       { ret opt[isa.VecOp].some{isa.VEC_OP_TRUNC}; }
    if (v == opdesc.IVEC_SEXT)        { ret opt[isa.VecOp].some{isa.VEC_OP_SEXT}; }
    if (v == opdesc.IVEC_ZEXT)        { ret opt[isa.VecOp].some{isa.VEC_OP_ZEXT}; }
    if (v == opdesc.IVEC_FP_TRUNC)    { ret opt[isa.VecOp].some{isa.VEC_OP_FP_TRUNC}; }
    if (v == opdesc.IVEC_FP_EXT)      { ret opt[isa.VecOp].some{isa.VEC_OP_FP_EXT}; }
    if (v == opdesc.IVEC_FP_TO_SI)    { ret opt[isa.VecOp].some{isa.VEC_OP_FP_TO_SI}; }
    if (v == opdesc.IVEC_FP_TO_UI)    { ret opt[isa.VecOp].some{isa.VEC_OP_FP_TO_UI}; }
    if (v == opdesc.IVEC_SI_TO_FP)    { ret opt[isa.VecOp].some{isa.VEC_OP_SI_TO_FP}; }
    if (v == opdesc.IVEC_UI_TO_FP)    { ret opt[isa.VecOp].some{isa.VEC_OP_UI_TO_FP}; }
    if (v == opdesc.IVEC_MUL_WIDE_S)  { ret opt[isa.VecOp].some{isa.VEC_OP_MUL_WIDE_S}; }
    if (v == opdesc.IVEC_MUL_WIDE_U)  { ret opt[isa.VecOp].some{isa.VEC_OP_MUL_WIDE_U}; }
    if (v == opdesc.IVEC_WIDEN_S)     { ret opt[isa.VecOp].some{isa.VEC_OP_WIDEN_S}; }
    if (v == opdesc.IVEC_WIDEN_U)     { ret opt[isa.VecOp].some{isa.VEC_OP_WIDEN_U}; }
    if (v == opdesc.IVEC_RANGE)       { ret opt[isa.VecOp].some{isa.VEC_OP_RANGE}; }
    if (v == opdesc.IVEC_CONCAT)      { ret opt[isa.VecOp].some{isa.VEC_OP_CONCAT}; }
    if (v == opdesc.IVEC_MUL_HIGH_S)  { ret opt[isa.VecOp].some{isa.VEC_OP_MUL_HIGH_S}; }
    if (v == opdesc.IVEC_MUL_HIGH_U)  { ret opt[isa.VecOp].some{isa.VEC_OP_MUL_HIGH_U}; }
    if (v == opdesc.IVEC_INTERLEAVE)  { ret opt[isa.VecOp].some{isa.VEC_OP_INTERLEAVE}; }
    if (v == opdesc.IVEC_WIDEN_SUM_U) { ret opt[isa.VecOp].some{isa.VEC_OP_WIDEN_SUM_U}; }
    if (v == opdesc.IVEC_SIGN_MASK)   { ret opt[isa.VecOp].some{isa.VEC_OP_SIGN_MASK}; }
    ret opt[isa.VecOp].none{};
}

fun lane_kind_from_operand(k: ir_instruction.InstrKind) bool {
    ret opdesc.result_typing(k) == opdesc.RESULT_MASK;
}

# from_bits and from_lanes are the operand's lane width and lane count, which
# only a conversion, a widening multiply, a lane-halving extension, a lane
# range or a widening group sum changes
pub rec LaneDesc {
    is_float:   bool;
    lane_bits:  u32;
    lanes:      u32;
    from_bits:  u32;
    from_lanes: u32;
}

pub fun lane_desc(m: *me_ir.Module, inst: *ir_instruction.Instruction, out: *LaneDesc) bool {
    var ty: ir_type.IrTypeId = inst.ty;
    if (lane_kind_from_operand(inst.kind)) {
        if (inst.operand_count < 1) { ret false; }
        ty = inst.operands[0].ty;
    }
    if (!read_lane(m, ty, out))    { ret false; }
    if (!changes_lanes(inst.kind)) { ret true; }
    if (inst.operand_count < 1)    { ret false; }
    var from: LaneDesc;
    if (!read_lane(m, inst.operands[0].ty, ?from)) { ret false; }
    val c: opdesc.VecClass = opdesc.vec_class(inst.kind);
    if (c == opdesc.VCLASS_WIDEN_HALF || (c == opdesc.VCLASS_WIDEN && inst.operand_count == 3)) {
        if (from.lanes != out.lanes * 2) { ret false; }
    }
    or (c == opdesc.VCLASS_RANGE) {
        if (from.lanes < out.lanes || from.is_float != out.is_float || from.lane_bits != out.lane_bits) { ret false; }
    }
    or (c == opdesc.VCLASS_WIDEN_SUM) {
        if (from.lanes * from.lane_bits != out.lanes * out.lane_bits) { ret false; }
    }
    or (from.lanes != out.lanes) { ret false; }
    out.from_bits  = from.lane_bits;
    out.from_lanes = from.lanes;
    ret true;
}

fun changes_lanes(k: ir_instruction.InstrKind) bool {
    val c: opdesc.VecClass = opdesc.vec_class(k);
    ret c == opdesc.VCLASS_CONVERT || c == opdesc.VCLASS_WIDEN || c == opdesc.VCLASS_WIDEN_HALF
        || c == opdesc.VCLASS_RANGE || c == opdesc.VCLASS_WIDEN_SUM;
}

fun read_lane(m: *me_ir.Module, ty: ir_type.IrTypeId, out: *LaneDesc) bool {
    val vector_o: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (sel vector_o.none) { ret false; }
    val vector: *ir_type.IrType = vector_o.some;
    if (vector.kind != ir_type.IRT_VECTOR || vector.data.vector_.lanes == 0) { ret false; }
    val element_o: opt[*ir_type.IrType] = ir_type.get(?m.types, vector.data.vector_.element);
    if (sel element_o.none) { ret false; }
    val element: *ir_type.IrType = element_o.some;
    val bits:    u32             = element.data.bits;
    if (element.kind == ir_type.IRT_FLOAT) {
        if (bits != 16 && bits != 32 && bits != 64) { ret false; }
    }
    or (element.kind == ir_type.IRT_INT) {
        if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret false; }
    }
    or { ret false; }
    out.is_float   = element.kind == ir_type.IRT_FLOAT;
    out.lane_bits  = bits;
    out.lanes      = vector.data.vector_.lanes;
    out.from_bits  = bits;
    out.from_lanes = vector.data.vector_.lanes;
    ret true;
}

pub fun scalar_bits(m: *me_ir.Module, ty: ir_type.IrTypeId) u32 {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (sel opt_.none) { ret 0; }
    ret opt_.some.data.bits;
}

# whether the target packs `k` over lanes of `lane_bits`; a shift is the cell
# of its count's form, one scalar for every lane when `uniform_count` and a
# count per lane otherwise
pub fun packs(tgt: *lang_target.Target, k: ir_instruction.InstrKind, is_float: bool, lane_bits: u32, uniform_count: bool) bool {
    val op: opt[isa.VecOp] = vec_op_of(k, uniform_count);
    if (sel op.none)                { ret false; }
    if (op.some == isa.VEC_OP_NONE) { ret false; }
    ret isa.packed_width(?tgt.model, op.some, is_float, lane_bits, lane_bits) != 0;
}

# a loop's lane-wise integer extension `k` from `from_bits` lanes to
# `lane_bits` lanes, packed
pub fun extends(tgt: *lang_target.Target, k: ir_instruction.InstrKind, lane_bits: u32, from_bits: u32) bool {
    if (k != ir_instruction.OP_SEXT && k != ir_instruction.OP_ZEXT) { ret false; }
    val op: opt[isa.VecOp] = vec_op_of(k, false);
    if (sel op.none) { ret false; }
    ret isa.packed_width(?tgt.model, op.some, false, lane_bits, from_bits) != 0;
}

# a lane-wise integer extension over more than one doubling is one
# instruction on the target, rather than a chain of doublings (#4161)
pub fun extends_directly(tgt: *lang_target.Target) bool {
    ret isa.extends_directly(?tgt.model);
}

pub fun packed_lanes(tgt: *lang_target.Target, is_float: bool, lane_bits: u32) u32 {
    ret isa.packed_lane_cap(?tgt.model, is_float, lane_bits);
}

# the target's declared outcome for one vector operator: packed, the scalar
# expansion, or undeclared when the catalog names neither for its lane shape
pub fun decide(m: *me_ir.Module, tgt: *lang_target.Target, inst: *ir_instruction.Instruction) isa.VectorForm {
    val op: opt[isa.VecOp] = vec_op_of(inst.kind, uniform_count(m, inst));
    if (sel op.none)                { ret isa.FORM_UNDECLARED; }
    if (op.some == isa.VEC_OP_NONE) { ret isa.FORM_UNDECLARED; }
    var d: LaneDesc;
    if (!lane_desc(m, inst, ?d)) { ret isa.FORM_UNDECLARED; }
    ret isa.vector_form(?tgt.model, op.some, d.is_float, d.lane_bits, d.from_bits);
}

# the lanes of one register-width piece a vector of `lane_bits` lanes wider
# than the register is split into (#3589): the target's declared vector width
# over the lane's kind and width, capped by its lane count. 0 where a vector
# is not split: no vector register, or a target whose vectors are values
# rather than registers (spir-v), which realizes a vector of any declared
# width whole
pub fun piece_lanes(tgt: *lang_target.Target, is_float: bool, lane_bits: u32) u32 {
    if (!tgt.model.vectors_in_registers) { ret 0; }
    ret isa.packed_lane_cap(?tgt.model, is_float, lane_bits);
}

# the side of an operation with these lanes is realized in registers: whole
# in one, or split into register-width pieces by type legalization
fun register_realized(tgt: *lang_target.Target, is_float: bool, lane_bits: u32, lanes: u32) bool {
    if (isa.fits_vector_register(?tgt.model, is_float, lane_bits, lanes)) { ret true; }
    ret lanes != 0 && piece_lanes(tgt, is_float, lane_bits) != 0;
}

# a vector the target splits at type legalization: wider than one register, of
# a lane shape the vocabulary retains, on a target that splits
pub fun splits(m: *me_ir.Module, tgt: *lang_target.Target, ty: ir_type.IrTypeId) bool {
    if (!ir_type.is_vector(?m.types, ty)) { ret false; }
    var d: LaneDesc;
    if (!read_lane(m, ty, ?d)) { ret false; }
    val cap: u32 = piece_lanes(tgt, d.is_float, d.lane_bits);
    ret cap != 0 && d.lanes > cap;
}

# packed where the catalog packs the cell and both sides are realized in
# registers, whole or as the pieces a wider vector is split into, each of which
# runs the packed instruction
pub fun realizes_packed(m: *me_ir.Module, tgt: *lang_target.Target, inst: *ir_instruction.Instruction) bool {
    if (decide(m, tgt, inst) != isa.FORM_PACKED) { ret false; }
    val op: opt[isa.VecOp] = vec_op_of(inst.kind, uniform_count(m, inst));
    if (sel op.none) { ret false; }
    var d: LaneDesc;
    if (!lane_desc(m, inst, ?d))                                   { ret false; }
    if (!register_realized(tgt, d.is_float, d.lane_bits, d.lanes)) { ret false; }
    ret register_realized(tgt, isa.from_is_float(op.some, d.is_float), d.from_bits, d.from_lanes);
}

# the widening multiply that a multiply of two lane-wise extensions of `ext`
# kind fuses into; absent for any other extension
pub fun widening_of(ext: ir_instruction.InstrKind) opt[ir_instruction.InstrKind] {
    if (ext == ir_instruction.OP_SEXT) { ret opt[ir_instruction.InstrKind].some{ir_instruction.OP_MUL_WIDE_S}; }
    if (ext == ir_instruction.OP_ZEXT) { ret opt[ir_instruction.InstrKind].some{ir_instruction.OP_MUL_WIDE_U}; }
    ret opt[ir_instruction.InstrKind].none{};
}

# whether a widening multiply of two `from_ty` vectors into `ty` is a cell the
# target packs at these lanes; the catalog is the only judge
pub fun widening_packs(m: *me_ir.Module, tgt: *lang_target.Target, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    if (opdesc.vec_class(kind) != opdesc.VCLASS_WIDEN) { ret false; }
    var operands: [2]value.Value;
    operands[0] = value.param(0, from_ty);
    operands[1] = value.param(1, from_ty);
    var probe: ir_instruction.Instruction;
    probe.kind          = kind;
    probe.ty            = ty;
    probe.operands      = ?operands[0];
    probe.operand_count = 2;
    ret realizes_packed(m, tgt, ?probe);
}

# whether the widening multiply of one half of two `from_ty` vectors into the
# `ty` of half their lanes is a cell the target packs (#3589)
pub fun widening_half_packs(m: *me_ir.Module, tgt: *lang_target.Target, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    if (opdesc.vec_class(kind) != opdesc.VCLASS_WIDEN) { ret false; }
    var operands: [3]value.Value;
    operands[0] = value.param(0, from_ty);
    operands[1] = value.param(1, from_ty);
    operands[2] = value.const_int(0, from_ty);
    var probe: ir_instruction.Instruction;
    probe.kind          = kind;
    probe.ty            = ty;
    probe.operands      = ?operands[0];
    probe.operand_count = 3;
    ret realizes_packed(m, tgt, ?probe);
}

# the high multiply that pairs with the plain multiply into the widening
# multiply `kind`; absent for any other kind
pub fun high_of(kind: ir_instruction.InstrKind) opt[ir_instruction.InstrKind] {
    if (kind == ir_instruction.OP_MUL_WIDE_S) { ret opt[ir_instruction.InstrKind].some{ir_instruction.OP_MUL_HIGH_S}; }
    if (kind == ir_instruction.OP_MUL_WIDE_U) { ret opt[ir_instruction.InstrKind].some{ir_instruction.OP_MUL_HIGH_U}; }
    ret opt[ir_instruction.InstrKind].none{};
}

# whether the target realizes the half `ty` of a widening multiply `kind` of
# two `from_ty` vectors as the plain and the high multiply of the operands,
# interleaved: every piece of the pair is a cell it packs (#4119). both halves
# of one product then read the same pair
pub fun widening_pair_packs(m: *me_ir.Module, tgt: *lang_target.Target, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    val high: opt[ir_instruction.InstrKind] = high_of(kind);
    if (sel high.none)                                                        { ret false; }
    if (!operation_packs(m, tgt, ir_instruction.OP_MUL, from_ty, from_ty, 2)) { ret false; }
    if (!operation_packs(m, tgt, high.some, from_ty, from_ty, 2))             { ret false; }
    ret widening_half_packs(m, tgt, ir_instruction.OP_VEC_INTERLEAVE, ty, from_ty);
}

# whether the target realizes the signed lane-halving extension of a
# `from_ty` vector into the `ty` of half its lanes as the vector interleaved
# with its sign mask: both are cells it packs, and an extension is not one
# instruction of its own there. both halves of one extension then read the
# same mask (#4198)
pub fun sign_interleave_packs(m: *me_ir.Module, tgt: *lang_target.Target, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    if (extends_directly(tgt))                                                          { ret false; }
    if (!operation_packs(m, tgt, ir_instruction.OP_VEC_SIGN_MASK, from_ty, from_ty, 1)) { ret false; }
    ret widening_half_packs(m, tgt, ir_instruction.OP_VEC_INTERLEAVE, ty, from_ty);
}

# whether the target realizes the unsigned lane-halving extension of a
# `from_ty` vector into the `ty` of half its lanes as the vector interleaved
# with zero: the interleave is a cell it packs, and an extension is not one
# instruction of its own there. every such half then reads one zero (#4198)
pub fun zero_interleave_packs(m: *me_ir.Module, tgt: *lang_target.Target, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    if (extends_directly(tgt)) { ret false; }
    ret widening_half_packs(m, tgt, ir_instruction.OP_VEC_INTERLEAVE, ty, from_ty);
}

# whether a lane join into `ty` is a cell the target packs (#3589)
pub fun concat_packs(m: *me_ir.Module, tgt: *lang_target.Target, ty: ir_type.IrTypeId) bool {
    var operands: [2]value.Value;
    operands[0] = value.param(0, ty);
    operands[1] = value.param(1, ty);
    var probe: ir_instruction.Instruction;
    probe.kind          = ir_instruction.OP_VEC_CONCAT;
    probe.ty            = ty;
    probe.operands      = ?operands[0];
    probe.operand_count = 2;
    ret realizes_packed(m, tgt, ?probe);
}

# whether a lane-halving extension of a `from_ty` vector into `ty` is a cell
# the target packs at these lanes; the catalog is the only judge
pub fun widen_half_packs(m: *me_ir.Module, tgt: *lang_target.Target, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    if (opdesc.vec_class(kind) != opdesc.VCLASS_WIDEN_HALF) { ret false; }
    var operands: [2]value.Value;
    operands[0] = value.param(0, from_ty);
    operands[1] = value.const_int(0, from_ty);
    var probe: ir_instruction.Instruction;
    probe.kind          = kind;
    probe.ty            = ty;
    probe.operands      = ?operands[0];
    probe.operand_count = 2;
    ret realizes_packed(m, tgt, ?probe);
}

# whether the lane-wise conversion `kind` of a `from_ty` vector into `ty` is a
# cell the target packs at these lanes; the catalog is the only judge
pub fun conversion_packs(m: *me_ir.Module, tgt: *lang_target.Target, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    if (opdesc.vec_class(kind) != opdesc.VCLASS_CONVERT) { ret false; }
    ret operation_packs(m, tgt, kind, ty, from_ty, 1);
}

# whether `kind` over `n` operands of `operand_ty` (one or two) into `ty` is a
# cell the target packs at these lanes; the catalog is the only judge
pub fun operation_packs(m: *me_ir.Module, tgt: *lang_target.Target, kind: ir_instruction.InstrKind, ty: ir_type.IrTypeId, operand_ty: ir_type.IrTypeId, n: u32) bool {
    if (n < 1 || n > 2) { ret false; }
    var operands: [2]value.Value;
    operands[0] = value.param(0, operand_ty);
    operands[1] = value.param(1, operand_ty);
    var probe: ir_instruction.Instruction;
    probe.kind          = kind;
    probe.ty            = ty;
    probe.operands      = ?operands[0];
    probe.operand_count = n;
    ret realizes_packed(m, tgt, ?probe);
}

# whether the widening group sum of a `from_ty` vector into `ty` is a cell
# the target packs, both sides whole in one register (#4161)
pub fun widen_sum_packs(m: *me_ir.Module, tgt: *lang_target.Target, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    if (splits(m, tgt, ty) || splits(m, tgt, from_ty)) { ret false; }
    ret operation_packs(m, tgt, ir_instruction.OP_VEC_WIDEN_SUM_U, ty, from_ty, 1);
}

# whether a lane range of a `from_ty` vector into `ty` is a cell the target
# packs at these lanes; the catalog is the only judge
pub fun range_packs(m: *me_ir.Module, tgt: *lang_target.Target, ty: ir_type.IrTypeId, from_ty: ir_type.IrTypeId) bool {
    var operands: [2]value.Value;
    operands[0] = value.param(0, from_ty);
    operands[1] = value.const_int(0, from_ty);
    var probe: ir_instruction.Instruction;
    probe.kind          = ir_instruction.OP_VEC_RANGE;
    probe.ty            = ty;
    probe.operands      = ?operands[0];
    probe.operand_count = 2;
    ret realizes_packed(m, tgt, ?probe);
}

pub fun holds_in_register(m: *me_ir.Module, tgt: *lang_target.Target, ty: ir_type.IrTypeId) bool {
    if (!ir_type.is_vector(?m.types, ty)) { ret true; }
    var d: LaneDesc;
    if (!read_lane(m, ty, ?d))           { ret false; }
    if (!tgt.model.vectors_in_registers) { ret true; }
    ret isa.fits_vector_register(?tgt.model, d.is_float, d.lane_bits, d.lanes);
}

# the spelling of a vector operation in a diagnostic; absent for a tag
# outside the catalog
pub fun vec_op_name(op: isa.VecOp) opt[str] {
    if (op == isa.VEC_OP_NONE)    { ret opt[str].some{"no vector operation"}; }
    if (op == isa.VEC_OP_ADD)     { ret opt[str].some{"add"}; }
    if (op == isa.VEC_OP_SUB)     { ret opt[str].some{"subtract"}; }
    if (op == isa.VEC_OP_MUL)     { ret opt[str].some{"multiply"}; }
    if (op == isa.VEC_OP_DIV)     { ret opt[str].some{"divide"}; }
    if (op == isa.VEC_OP_AND)     { ret opt[str].some{"and"}; }
    if (op == isa.VEC_OP_OR)      { ret opt[str].some{"or"}; }
    if (op == isa.VEC_OP_XOR)     { ret opt[str].some{"xor"}; }
    if (op == isa.VEC_OP_NOT)     { ret opt[str].some{"complement"}; }
    if (op == isa.VEC_OP_NEG)     { ret opt[str].some{"negate"}; }
    if (op == isa.VEC_OP_SHL_U)   { ret opt[str].some{"shift left by a uniform count"}; }
    if (op == isa.VEC_OP_SHR_U_U) { ret opt[str].some{"logical shift right by a uniform count"}; }
    if (op == isa.VEC_OP_SHR_S_U) { ret opt[str].some{"arithmetic shift right by a uniform count"}; }
    if (op == isa.VEC_OP_SHL_V)   { ret opt[str].some{"shift left by per-lane counts"}; }
    if (op == isa.VEC_OP_SHR_U_V) { ret opt[str].some{"logical shift right by per-lane counts"}; }
    if (op == isa.VEC_OP_SHR_S_V) { ret opt[str].some{"arithmetic shift right by per-lane counts"}; }
    if (op == isa.VEC_OP_CMP)     { ret opt[str].some{"compare"}; }
    if (isa.is_convert_op(op))    { ret opt[str].some{"convert"}; }
    if (isa.is_widen_op(op))      { ret opt[str].some{"widening multiply"}; }
    if (isa.is_widen_half_op(op)) { ret opt[str].some{"lane extension"}; }
    if (isa.is_range_op(op))      { ret opt[str].some{"lane range"}; }
    if (op == isa.VEC_OP_CONCAT)  { ret opt[str].some{"lane join"}; }
    if (isa.is_mul_high_op(op))   { ret opt[str].some{"high multiply"}; }
    if (isa.is_interleave_op(op)) { ret opt[str].some{"lane interleave"}; }
    if (isa.is_widen_sum_op(op))  { ret opt[str].some{"widening lane sum"}; }
    if (isa.is_sign_mask_op(op))  { ret opt[str].some{"lane sign mask"}; }
    ret opt[str].none{};
}

test vec_op_of__is_total_over_the_descriptor_vector_tags {
    var i: usize = 0;
    for (i < opdesc.IR_OP_DESCRIPTOR_COUNT) {
        val k: ir_instruction.InstrKind = i::ir_instruction.InstrKind;
        i = i + 1;
        val v:       opdesc.IrVecOp = opdesc.vec_op(k);
        val mapped:  opt[isa.VecOp] = vec_op_of(k, false);
        val uniform: opt[isa.VecOp] = vec_op_of(k, true);
        if (sel mapped.none)  { ret 1; }
        if (sel uniform.none) { ret 1; }
        if (v == opdesc.IVEC_NONE) {
            if (mapped.some != isa.VEC_OP_NONE || uniform.some != isa.VEC_OP_NONE) { ret 1; }
        }
        or {
            if (mapped.some == isa.VEC_OP_NONE || uniform.some == isa.VEC_OP_NONE) { ret 1; }
            # only a shift tells its count forms apart
            if ((mapped.some != uniform.some) != isa.is_shift_op(mapped.some)) { ret 1; }
            if (isa.is_shift_op(uniform.some) != isa.is_shift_op(mapped.some)) { ret 1; }
        }
    }
    val outside: opt[isa.VecOp] = vec_op_of(255::ir_instruction.InstrKind, false);
    if (sel outside.none)                { ret 1; }
    if (outside.some != isa.VEC_OP_NONE) { ret 1; }
    val unmapped: opt[isa.VecOp] = isa_vec_op(255::opdesc.IrVecOp, false);
    if (sel unmapped.some) { ret 1; }
    var m:    me_ir.Module;
    var tgt:  lang_target.Target;
    var inst: ir_instruction.Instruction;
    inst.kind = 255::ir_instruction.InstrKind;
    if (realizes_packed(?m, ?tgt, ?inst)) { ret 2; }
    inst.kind = ir_instruction.OP_ADD;
    if (realizes_packed(?m, ?tgt, ?inst)) { ret 3; }
    var types: [2]ir_type.IrType;
    types[0].kind                 = ir_type.IRT_INT;
    types[0].data.bits            = 16;
    types[1].kind                 = ir_type.IRT_VECTOR;
    types[1].data.vector_.element = 0;
    types[1].data.vector_.lanes   = 4;
    m.types.types                 = ?types[0];
    m.types.len                   = 2;
    inst.ty                       = 1;
    var form: isa.PackedForm = isa.PackedForm{op: isa.VEC_OP_ADD, is_float: false, lane_bits: 16, from_bits: 16};
    tgt.model.has_v128        = true;
    tgt.model.vector_bits     = 128;
    tgt.model.packed_forms    = ?form;
    tgt.model.packed_form_len = 1;
    if (!realizes_packed(?m, ?tgt, ?inst))          { ret 4; }
    if (decide(?m, ?tgt, ?inst) != isa.FORM_PACKED) { ret 4; }
    inst.kind = ir_instruction.OP_MUL;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_UNDECLARED || realizes_packed(?m, ?tgt, ?inst)) { ret 8; }
    var scalar: isa.ScalarForm = isa.ScalarForm{op: isa.VEC_OP_MUL, is_float: false, lane_bits: 16, from_bits: 16};
    tgt.model.scalar_forms    = ?scalar;
    tgt.model.scalar_form_len = 1;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_SCALAR || realizes_packed(?m, ?tgt, ?inst)) { ret 9; }
    inst.kind          = ir_instruction.OP_ADD;
    types[0].data.bits = 9;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_UNDECLARED)                     { ret 10; }
    if (realizes_packed(?m, ?tgt, ?inst) || holds_in_register(?m, ?tgt, 1)) { ret 5; }
    types[0].data.pointee = ir_type.IRT_NIL;
    types[0].kind         = ir_type.IRT_PTR;
    if (realizes_packed(?m, ?tgt, ?inst) || holds_in_register(?m, ?tgt, 1)) { ret 6; }
    types[0].kind               = ir_type.IRT_INT;
    types[0].data.bits          = 16;
    types[1].data.vector_.lanes = 0;
    if (realizes_packed(?m, ?tgt, ?inst) || holds_in_register(?m, ?tgt, 1)) { ret 7; }
    ret 0;
}

test decide__keys_a_conversion_by_its_operand_lane_width {
    var m:     me_ir.Module;
    var tgt:   lang_target.Target;
    var inst:  ir_instruction.Instruction;
    var types: [4]ir_type.IrType;
    types[0].kind                 = ir_type.IRT_INT;
    types[0].data.bits            = 8;
    types[1].kind                 = ir_type.IRT_VECTOR;
    types[1].data.vector_.element = 0;
    types[1].data.vector_.lanes   = 4;
    types[2].kind                 = ir_type.IRT_INT;
    types[2].data.bits            = 32;
    types[3].kind                 = ir_type.IRT_VECTOR;
    types[3].data.vector_.element = 2;
    types[3].data.vector_.lanes   = 4;
    m.types.types                 = ?types[0];
    m.types.len                   = 4;
    var ops: [1]value.Value;
    ops[0]             = value.param(0, 1);
    inst.kind          = ir_instruction.OP_SEXT;
    inst.ty            = 3;
    inst.operands      = ?ops[0];
    inst.operand_count = 1;
    var d: LaneDesc;
    if (!lane_desc(?m, ?inst, ?d) || d.lane_bits != 32 || d.from_bits != 8 || d.lanes != 4) { ret 1; }
    tgt.model.has_v128    = true;
    tgt.model.vector_bits = 128;
    var scalar: isa.ScalarForm = isa.ScalarForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    tgt.model.scalar_forms    = ?scalar;
    tgt.model.scalar_form_len = 1;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_SCALAR) { ret 2; }
    scalar.from_bits = 16;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_UNDECLARED) { ret 3; }
    var form: isa.PackedForm = isa.PackedForm{op: isa.VEC_OP_SEXT, is_float: false, lane_bits: 32, from_bits: 8};
    tgt.model.packed_forms    = ?form;
    tgt.model.packed_form_len = 1;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_PACKED || !realizes_packed(?m, ?tgt, ?inst)) { ret 4; }
    types[1].data.vector_.lanes = 2;
    if (lane_desc(?m, ?inst, ?d)) { ret 5; }
    ret 0;
}

# a vector splits where it has more lanes than one register of the target's
# declared width holds, into pieces of that register's lanes; a wider declared
# register holds it whole, and a target whose vectors are values splits nothing
test splits__follows_the_declared_vector_width {
    var m:     me_ir.Module;
    var tgt:   lang_target.Target;
    var types: [4]ir_type.IrType;
    types[0].kind                  = ir_type.IRT_INT;
    types[0].data.bits             = 32;
    types[1].kind                  = ir_type.IRT_VECTOR;
    types[1].data.vector_.element  = 0;
    types[1].data.vector_.lanes    = 8;
    types[2].kind                  = ir_type.IRT_VECTOR;
    types[2].data.vector_.element  = 0;
    types[2].data.vector_.lanes    = 4;
    types[3].kind                  = ir_type.IRT_VECTOR;
    types[3].data.vector_.element  = 0;
    types[3].data.vector_.lanes    = 9;
    m.types.types                  = ?types[0];
    m.types.len                    = 4;
    tgt.model.has_v128             = true;
    tgt.model.vectors_in_registers = true;
    tgt.model.max_vector_lanes     = isa.VECTOR_LANES_UNBOUNDED;
    tgt.model.vector_bits          = 128;
    if (piece_lanes(?tgt, false, 32) != 4 || piece_lanes(?tgt, false, 8) != 16) { ret 1; }
    if (!splits(?m, ?tgt, 1) || splits(?m, ?tgt, 2))                            { ret 2; }
    if (!splits(?m, ?tgt, 3) || splits(?m, ?tgt, 0))                            { ret 3; }
    tgt.model.vector_bits = 256;
    if (piece_lanes(?tgt, false, 32) != 8)          { ret 4; }
    if (splits(?m, ?tgt, 1) || splits(?m, ?tgt, 2)) { ret 5; }
    if (!splits(?m, ?tgt, 3))                       { ret 6; }
    tgt.model.vectors_in_registers = false;
    if (piece_lanes(?tgt, false, 32) != 0 || splits(?m, ?tgt, 3)) { ret 7; }
    tgt.model.vectors_in_registers = true;
    tgt.model.has_v128             = false;
    if (splits(?m, ?tgt, 1)) { ret 8; }
    ret 0;
}
