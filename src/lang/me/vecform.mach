use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use O: std.types.option;

use mach.lang.me.ir;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.target;
use mach.lang.target.isa;

pub fun vec_op_of(k: instruction.InstrKind) isa.VecOp {
    ret isa_vec_op(opdesc.vec_op(k));
}

fun isa_vec_op(v: opdesc.IrVecOp) isa.VecOp {
    if (v == opdesc.IVEC_ADD) { ret isa.VEC_OP_ADD; }
    if (v == opdesc.IVEC_SUB) { ret isa.VEC_OP_SUB; }
    if (v == opdesc.IVEC_MUL) { ret isa.VEC_OP_MUL; }
    if (v == opdesc.IVEC_DIV) { ret isa.VEC_OP_DIV; }
    if (v == opdesc.IVEC_AND) { ret isa.VEC_OP_AND; }
    if (v == opdesc.IVEC_OR)  { ret isa.VEC_OP_OR; }
    if (v == opdesc.IVEC_XOR) { ret isa.VEC_OP_XOR; }
    if (v == opdesc.IVEC_NOT) { ret isa.VEC_OP_NOT; }
    if (v == opdesc.IVEC_NEG) { ret isa.VEC_OP_NEG; }
    if (v == opdesc.IVEC_SHL) { ret isa.VEC_OP_SHL; }
    if (v == opdesc.IVEC_SHR) { ret isa.VEC_OP_SHR; }
    if (v == opdesc.IVEC_CMP) { ret isa.VEC_OP_CMP; }
    ret isa.VEC_OP_NONE;
}


fun lane_kind_from_operand(k: instruction.InstrKind) bool {
    ret opdesc.result_typing(k) == opdesc.RESULT_MASK;
}


pub rec LaneDesc {
    is_float:  bool;
    lane_bits: u32;
    lanes:     u32;
}

pub fun lane_desc(m: *ir.Module, inst: *instruction.Instruction, out: *LaneDesc) bool {
    var ty: ir_type.IrTypeId = inst.ty;
    if (lane_kind_from_operand(inst.kind)) {
        if (inst.operand_count < 1) { ret false; }
        ty = inst.operands[0].ty;
    }
    ret read_lane(m, ty, out);
}

fun read_lane(m: *ir.Module, ty: ir_type.IrTypeId, out: *LaneDesc) bool {
    val vector_o: O.Option[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (O.is_none[*ir_type.IrType](vector_o)) { ret false; }
    val vector: *ir_type.IrType = O.unwrap[*ir_type.IrType](vector_o);
    if (vector.kind != ir_type.IRT_VECTOR || vector.data.vector_.lanes == 0) { ret false; }
    val element_o: O.Option[*ir_type.IrType] = ir_type.get(?m.types, vector.data.vector_.element);
    if (O.is_none[*ir_type.IrType](element_o)) { ret false; }
    val element: *ir_type.IrType = O.unwrap[*ir_type.IrType](element_o);
    val bits: u32 = element.data.bits;
    if (element.kind == ir_type.IRT_FLOAT) {
        if (bits != 32 && bits != 64) { ret false; }
    } or (element.kind == ir_type.IRT_INT) {
        if (bits != 8 && bits != 16 && bits != 32 && bits != 64) { ret false; }
    } or { ret false; }
    out.is_float = element.kind == ir_type.IRT_FLOAT;
    out.lane_bits = bits;
    out.lanes = vector.data.vector_.lanes;
    ret true;
}

pub fun scalar_bits(m: *ir.Module, ty: ir_type.IrTypeId) u32 {
    val opt: O.Option[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (O.is_none[*ir_type.IrType](opt)) { ret 0; }
    ret O.unwrap[*ir_type.IrType](opt).data.bits;
}

pub fun packs(tgt: *target.Target, k: instruction.InstrKind, is_float: bool, lane_bits: u32) bool {
    val op: isa.VecOp = vec_op_of(k);
    if (op == isa.VEC_OP_NONE) { ret false; }
    ret isa.packed_width(?tgt.model, op, is_float, lane_bits) != 0;
}

pub fun packed_lanes(tgt: *target.Target, lane_bits: u32) u32 {
    ret isa.packed_lane_cap(?tgt.model, lane_bits);
}

# the target's declared outcome for one vector operator: packed, the scalar
# expansion, or undeclared when the catalog names neither for its lane shape
pub fun decide(m: *ir.Module, tgt: *target.Target, inst: *instruction.Instruction) isa.VectorForm {
    val op: isa.VecOp = vec_op_of(inst.kind);
    if (op == isa.VEC_OP_NONE) { ret isa.FORM_UNDECLARED; }
    var d: LaneDesc;
    if (!lane_desc(m, inst, ?d)) { ret isa.FORM_UNDECLARED; }
    ret isa.vector_form(?tgt.model, op, d.is_float, d.lane_bits);
}

pub fun realizes_packed(m: *ir.Module, tgt: *target.Target, inst: *instruction.Instruction) bool {
    if (decide(m, tgt, inst) != isa.FORM_PACKED) { ret false; }
    var d: LaneDesc;
    if (!lane_desc(m, inst, ?d)) { ret false; }
    ret isa.fits_vector_register(?tgt.model, d.lane_bits, d.lanes);
}

pub fun holds_in_register(m: *ir.Module, tgt: *target.Target, ty: ir_type.IrTypeId) bool {
    if (!ir_type.is_vector(?m.types, ty)) { ret true; }
    var d: LaneDesc;
    if (!read_lane(m, ty, ?d)) { ret false; }
    if (!tgt.model.vectors_in_registers) { ret true; }
    ret isa.fits_vector_register(?tgt.model, d.lane_bits, d.lanes);
}

pub fun vec_op_name(op: isa.VecOp) str {
    if (op == isa.VEC_OP_ADD) { ret "add"; }
    if (op == isa.VEC_OP_SUB) { ret "subtract"; }
    if (op == isa.VEC_OP_MUL) { ret "multiply"; }
    if (op == isa.VEC_OP_DIV) { ret "divide"; }
    if (op == isa.VEC_OP_AND) { ret "and"; }
    if (op == isa.VEC_OP_OR)  { ret "or"; }
    if (op == isa.VEC_OP_XOR) { ret "xor"; }
    if (op == isa.VEC_OP_NOT) { ret "complement"; }
    if (op == isa.VEC_OP_NEG) { ret "negate"; }
    if (op == isa.VEC_OP_SHL) { ret "shift"; }
    if (op == isa.VEC_OP_SHR) { ret "shift"; }
    if (op == isa.VEC_OP_CMP) { ret "compare"; }
    ret "operation";
}

test "mach.lang.me.vecform.vec_op_of:is_total_over_the_descriptor_vector_tags" {
    var i: usize = 0;
    for (i < opdesc.IR_OP_DESCRIPTOR_COUNT) {
        val k: instruction.InstrKind = i::instruction.InstrKind;
        i = i + 1;
        val v: opdesc.IrVecOp = opdesc.vec_op(k);
        if (v == opdesc.IVEC_NONE) {
            if (vec_op_of(k) != isa.VEC_OP_NONE) { ret 1; }
        } or {
            if (vec_op_of(k) == isa.VEC_OP_NONE) { ret 1; }
        }
    }
    if (vec_op_of(255::instruction.InstrKind) != isa.VEC_OP_NONE) { ret 1; }
    var m: ir.Module;
    var tgt: target.Target;
    var inst: instruction.Instruction;
    inst.kind = 255::instruction.InstrKind;
    if (realizes_packed(?m, ?tgt, ?inst)) { ret 2; }
    inst.kind = instruction.OP_ADD;
    if (realizes_packed(?m, ?tgt, ?inst)) { ret 3; }
    var types: [2]ir_type.IrType;
    types[0].kind = ir_type.IRT_INT; types[0].data.bits = 16;
    types[1].kind = ir_type.IRT_VECTOR;
    types[1].data.vector_.element = 0; types[1].data.vector_.lanes = 4;
    m.types.types = ?types[0]; m.types.len = 2;
    inst.ty = 1;
    var form: isa.PackedForm = isa.PackedForm { op: isa.VEC_OP_ADD, is_float: false, lane_bits: 16 };
    tgt.model.has_v128 = true; tgt.model.vector_bits = 128;
    tgt.model.packed_forms = ?form; tgt.model.packed_form_len = 1;
    if (!realizes_packed(?m, ?tgt, ?inst)) { ret 4; }
    if (decide(?m, ?tgt, ?inst) != isa.FORM_PACKED) { ret 4; }
    inst.kind = instruction.OP_MUL;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_UNDECLARED || realizes_packed(?m, ?tgt, ?inst)) { ret 8; }
    var scalar: isa.ScalarForm = isa.ScalarForm { op: isa.VEC_OP_MUL, is_float: false, lane_bits: 16 };
    tgt.model.scalar_forms = ?scalar; tgt.model.scalar_form_len = 1;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_SCALAR || realizes_packed(?m, ?tgt, ?inst)) { ret 9; }
    inst.kind = instruction.OP_ADD;
    types[0].data.bits = 9;
    if (decide(?m, ?tgt, ?inst) != isa.FORM_UNDECLARED) { ret 10; }
    if (realizes_packed(?m, ?tgt, ?inst) || holds_in_register(?m, ?tgt, 1)) { ret 5; }
    types[0].data.pointee = ir_type.IRT_NIL; types[0].kind = ir_type.IRT_PTR;
    if (realizes_packed(?m, ?tgt, ?inst) || holds_in_register(?m, ?tgt, 1)) { ret 6; }
    types[0].kind = ir_type.IRT_INT; types[0].data.bits = 16; types[1].data.vector_.lanes = 0;
    if (realizes_packed(?m, ?tgt, ?inst) || holds_in_register(?m, ?tgt, 1)) { ret 7; }
    ret 0;
}
