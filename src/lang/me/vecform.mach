# the mid-end's single door onto the vector realization authority (#2726)
#
# The legality of a vector type and of a vector operation are target-independent;
# only the REALIZATION is target-dependent (#2488). `isa.packed_width` is the whole
# of that target dependence, and this module is the only thing that calls it: it
# translates the mid-end's `InstrKind` vocabulary into the target layer's `VecOp`
# and answers, for one IR instruction on one target, whether it realizes as a packed
# instruction or as per-lane scalar code.
#
# WHY A MODULE AND NOT A HELPER. The rule this replaces had three homes - the
# vectorizer's admission test, sema's diagnostic, and the backend's coverage - which
# is why fixing one alone was incoherent (#2349). Sema no longer asks at all,
# because it is not a legality question. The two remaining askers are the vectorizer
# (should it form a vector op that would then be taken apart again) and the
# realization stage (packed form, or scalar expansion). Both call `realizes_packed`,
# so they cannot give different answers about the same instruction on the same
# target - not by convention but because there is one function.
#
# WHY THE QUERY IS LANE-KEYED. It carries the lane width and never the lane count or
# the vector's total width, so a vector wider than the register splits into chunks
# that each ask this same question and get this same answer (#2727). Nothing here
# has to change when the width gate goes.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.string.str;

use O: std.types.option;

use mach.lang.me.ir;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.target;
use isa: mach.lang.target.isa;

# the target-layer operation an IR opcode asks the authority about, or VEC_OP_NONE
# when the opcode is not a lane-wise operator
#
# The one translation between the two vocabularies. The comparisons collapse onto a
# single `VEC_OP_CMP` because whether a target packs a lane-wise compare does not
# vary by ordering or signedness on any ISA here - the signed and unsigned words for
# a shape either both exist or neither does.
pub fun vec_op_of(k: instruction.InstrKind) isa.VecOp {
    if (k == instruction.OP_ADD)   { ret isa.VEC_OP_ADD; }
    if (k == instruction.OP_SUB)   { ret isa.VEC_OP_SUB; }
    if (k == instruction.OP_MUL)   { ret isa.VEC_OP_MUL; }
    if (k == instruction.OP_DIV_S) { ret isa.VEC_OP_DIV; }
    if (k == instruction.OP_DIV_U) { ret isa.VEC_OP_DIV; }
    if (k == instruction.OP_AND)   { ret isa.VEC_OP_AND; }
    if (k == instruction.OP_OR)    { ret isa.VEC_OP_OR; }
    if (k == instruction.OP_XOR)   { ret isa.VEC_OP_XOR; }
    if (k == instruction.OP_NOT)   { ret isa.VEC_OP_NOT; }
    if (k == instruction.OP_NEG)   { ret isa.VEC_OP_NEG; }
    if (k == instruction.OP_SHL)   { ret isa.VEC_OP_SHL; }
    if (k == instruction.OP_SHR_S) { ret isa.VEC_OP_SHR; }
    if (k == instruction.OP_SHR_U) { ret isa.VEC_OP_SHR; }
    if (k == instruction.OP_CMP_EQ)   { ret isa.VEC_OP_CMP; }
    if (k == instruction.OP_CMP_NE)   { ret isa.VEC_OP_CMP; }
    if (k == instruction.OP_CMP_LT_S) { ret isa.VEC_OP_CMP; }
    if (k == instruction.OP_CMP_LT_U) { ret isa.VEC_OP_CMP; }
    if (k == instruction.OP_CMP_LE_S) { ret isa.VEC_OP_CMP; }
    if (k == instruction.OP_CMP_LE_U) { ret isa.VEC_OP_CMP; }
    ret isa.VEC_OP_NONE;
}

# whether an opcode's LANE KIND is read off its operands rather than its result
#
# A lane-wise comparison returns the same-shape unsigned MASK, so its result type
# says "integer lanes" even for a float compare. Asking the authority about the
# result would query the wrong lane kind, which is the sort of quiet mismatch that
# only shows up on a target where the two answers differ.
fun lane_kind_from_operand(k: instruction.InstrKind) bool {
    if (k == instruction.OP_CMP_EQ)   { ret true; }
    if (k == instruction.OP_CMP_NE)   { ret true; }
    if (k == instruction.OP_CMP_LT_S) { ret true; }
    if (k == instruction.OP_CMP_LT_U) { ret true; }
    if (k == instruction.OP_CMP_LE_S) { ret true; }
    if (k == instruction.OP_CMP_LE_U) { ret true; }
    ret false;
}

# the lane descriptor an instruction's realization is decided by
#
# ---
# is_float:  whether the lanes are floating-point
# lane_bits: the lane element width in bits
# lanes:     the lane count (carried for the caller's expansion, not for the query)
pub rec LaneDesc {
    is_float:  bool;
    lane_bits: u32;
    lanes:     u32;
}

# read the lane descriptor an instruction operates on, or false when it is not a
# lane-wise vector operator at all
pub fun lane_desc(m: *ir.Module, inst: *instruction.Instruction, out: *LaneDesc) bool {
    var ty: ir_type.IrTypeId = inst.ty;
    if (lane_kind_from_operand(inst.kind)) {
        if (inst.operand_count < 1) { ret false; }
        ty = inst.operands[0].ty;
    }
    if (!ir_type.is_vector(?m.types, ty)) { ret false; }

    var is_float:   bool = false;
    var elem_bytes: u8   = 0;
    var lanes:      u32  = 0;
    if (!ir_type.vector_lane(?m.types, ty, ?is_float, ?elem_bytes, ?lanes)) { ret false; }

    out.is_float  = is_float;
    out.lane_bits = elem_bytes::u32 * 8;
    out.lanes     = lanes;
    ret true;
}

# the bit width of a scalar IR type, or 0 when it does not resolve
#
# The vectorizer asks the authority about an operation it has not built yet, so it
# has an element type rather than a vector one to read the lane width off.
pub fun scalar_bits(m: *ir.Module, ty: ir_type.IrTypeId) u32 {
    val opt: O.Option[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (O.is_none[*ir_type.IrType](opt)) { ret 0; }
    ret O.unwrap[*ir_type.IrType](opt).data.bits;
}

# does `tgt` have a packed form for opcode `k` at `lane_bits` lanes
#
# The authority reached by a caller that holds an opcode and a lane width rather than
# a built instruction - the vectorizer, deciding whether forming a vector op is worth
# it. Same table, same answer as `realizes_packed`, so an operation the vectorizer
# forms is one the realization stage keeps packed.
pub fun packs(tgt: *target.Target, k: instruction.InstrKind, is_float: bool, lane_bits: u32) bool {
    val op: isa.VecOp = vec_op_of(k);
    if (op == isa.VEC_OP_NONE) { ret false; }
    ret isa.packed_width(?tgt.model, op, is_float, lane_bits) != 0;
}

# THE QUESTION: does `inst` realize as a packed instruction on `tgt`, or as per-lane
# scalar code
#
# False means the realization is the scalar expansion - which is a correct lowering
# on every target, never a refusal. This is what `simd = "require"` observes and
# what the expansion stage acts on, so the diagnostic and the transformation can
# never disagree about which operations scalarize.
#
# An instruction that is not a lane-wise vector operator answers true: it has no
# realization choice to make, and reporting it as a scalar shortfall would name
# operations the expansion does not touch.
pub fun realizes_packed(m: *ir.Module, tgt: *target.Target, inst: *instruction.Instruction) bool {
    val op: isa.VecOp = vec_op_of(inst.kind);
    if (op == isa.VEC_OP_NONE) { ret true; }
    var d: LaneDesc;
    if (!lane_desc(m, inst, ?d)) { ret true; }
    ret isa.packed_width(?tgt.model, op, d.is_float, d.lane_bits) != 0;
}

# a friendly name for a lane-wise operation, for the `simd = "require"` diagnostic
pub fun vec_op_name(op: isa.VecOp) str {
    if (op == isa.VEC_OP_ADD) { ret "add"; }
    if (op == isa.VEC_OP_SUB) { ret "subtract"; }
    if (op == isa.VEC_OP_MUL) { ret "multiply"; }
    if (op == isa.VEC_OP_DIV) { ret "divide"; }
    if (op == isa.VEC_OP_AND) { ret "and"; }
    if (op == isa.VEC_OP_OR)  { ret "or"; }
    if (op == isa.VEC_OP_XOR) { ret "xor"; }
    if (op == isa.VEC_OP_NOT) { ret "complement"; }
    if (op == isa.VEC_OP_NEG) { ret "negate"; }
    if (op == isa.VEC_OP_SHL) { ret "shift"; }
    if (op == isa.VEC_OP_SHR) { ret "shift"; }
    if (op == isa.VEC_OP_CMP) { ret "compare"; }
    ret "operation";
}
