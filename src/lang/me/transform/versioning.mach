test "mach.lang.me.transform.versioning:refuse_unsafe_offset_before_mutation" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val n: value.Value = value.param(0, i64t);
    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (build_axpy_ext(?m, ?bld, i64t, ptrt, n, value.const_int(0, i64t), VER_MAGNITUDE_MARGIN + 1, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    val blocks_before: u32 = fn.block_count;
    val instrs_before: u32 = fn.instr_len;

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = rd.ok;
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di);
    if (sel rv.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_UNSAFE_BOUND) { code = 1; }
    if (fn.block_count != blocks_before)     { code = 1; }
    if (fn.instr_len != instrs_before)       { code = 1; }
    version_result_dnit(?vres, ?alloc);
    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.versioning:dynamic_bound_guard_gains_magnitude_checks" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (build_axpy(?m, ?bld, i64t, ptrt, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = rd.ok;
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di);
    if (sel rv.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_OK) { code = 1; }
    or {
        if (count_op(fn, vres.guard, instruction.OP_CMP_LE_S) != 2) { code = 1; }
        if (count_op(fn, vres.guard, instruction.OP_CMP_LE_U) != 4) { code = 1; }
        if (count_op(fn, vres.guard, instruction.OP_OR)       != 2) { code = 1; }
        if (count_op(fn, vres.guard, instruction.OP_AND)      != 7) { code = 1; }
    }
    version_result_dnit(?vres, ?alloc);
    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.versioning.clone_one:carries_debug_metadata_to_the_clone" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (sel r_fn.err) { ir.dnit(?m); ret 1; }
    val fn_ix: u32 = r_fn.ok;

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[fn_ix]);
    val rblk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rblk.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, rblk.ok);

    val r_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.const_int(1, i64t), value.const_int(2, i64t));
    if (sel r_add.err) { ir.dnit(?m); ret 1; }
    val added: value.Value = r_add.ok;
    val r_1323: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1323.err) { ir.dnit(?m); ret 1; }

    val fn: *ir.Function = ?m.functions[fn_ix];
    val src_iid: id.InstructionId = added.data.instr;

    var dv: ir.DbgVar;
    dv.name     = 4242::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 7;
    val r_1333: res[bool, A.Error] = map.insert[id.InstructionId, ir.DbgVar](?fn.dbg_vars, src_iid, dv);
    if (sel r_1333.err) { ir.dnit(?m); ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: res[*u32, A.Error] = A.allocate[u32](m.alloc, map_len::usize);
    if (sel res_map.err) { ir.dnit(?m); ret 1; }
    val instr_map: *u32 = res_map.ok;
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    val res_clone: err[fail.Fail] = clone_one(?m, fn, src_iid, instr_map, map_len);
    if (sel res_clone.err) { A.deallocate[u32](m.alloc, instr_map, map_len::usize); ir.dnit(?m); ret 1; }
    val clone_iid: id.InstructionId = instr_map[src_iid::u32]::id.InstructionId;
    A.deallocate[u32](m.alloc, instr_map, map_len::usize);

    val opt_clone_dv: opt[*ir.DbgVar] = ir.dbg_var_get(fn, clone_iid);
    var bad: i32 = 0;
    if (sel opt_clone_dv.none) { bad = 1; }
    or (sel opt_clone_dv.some) {
        val cdv: *ir.DbgVar = opt_clone_dv.some;
        if (cdv.name != 4242::intern.StrId) { bad = 1; }
        if (cdv.scope != 7)                 { bad = 1; }
    }

    ir.dnit(?m);
    ret bad;
}

rec MetaSeen { mask: u32; }

fun note_meta(c: *MetaSeen, r: *refs.Ref) bool {
    if (r.role == refs.REF_METADATA)     { c.mask = c.mask | (1 << r.meta::u32); }
    if (r.role == refs.REF_INLINE_PARENT) { c.mask = c.mask | (1 << refs.META_INLINE_SITE::u32); }
    if (r.role == refs.REF_ASM_BIND)     { c.mask = c.mask | 0x80000000; }
    ret true;
}

fun meta_mask_of(fn: *ir.Function, iid: id.InstructionId) u32 {
    var c: MetaSeen;
    c.mask = 0;
    refs.visit[MetaSeen](fn, iid, ?c, note_meta);
    ret c.mask;
}

test "mach.lang.me.transform.versioning.clone_one:carries_every_metadata_kind_the_reference_visitor_reports" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel res_m.err) { ret 1; }
    var m: ir.Module = res_m.ok;
    fin { ir.dnit(?m); }

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel ri.err) { ret 1; }
    val i64t: ir_type.IrTypeId = ri.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;

    val r_fn: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (sel r_fn.err) { ret 1; }
    val fn_ix: u32 = r_fn.ok;

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[fn_ix]);
    val rblk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rblk.err) { ret 1; }
    builder.set_block(?bld, rblk.ok);

    val r_alloca: res[value.Value, fail.Fail] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (sel r_alloca.err) { ret 1; }
    val slot: value.Value = r_alloca.ok;
    val r_add: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.const_int(1, i64t), value.const_int(2, i64t));
    if (sel r_add.err) { ret 1; }
    val added: value.Value = r_add.ok;
    val r_1407: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1407.err) { ret 1; }

    val fn: *ir.Function = ?m.functions[fn_ix];
    val add_iid:    id.InstructionId = added.data.instr;
    val alloca_iid: id.InstructionId = slot.data.instr;

    var dv: ir.DbgVar;
    dv.name     = 4242::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 7;
    val r_1418: res[bool, A.Error] = map.insert[id.InstructionId, ir.DbgVar](?fn.dbg_vars, add_iid, dv);
    if (sel r_1418.err) { ret 1; }
    val r_1419: err[fail.Fail] = ir.record_alloca_dbg_var(fn, alloca_iid, dv);
    if (sel r_1419.err) { ret 1; }

    var sk: u32 = 0;
    for (sk < 4) {
        val r_1423: res[u32, fail.Fail] = ir.inline_site_add(?m, fn, 9::intern.StrId, source.loc_nil(), 0);
        if (sel r_1423.err) { ret 1; }
        sk = sk + 1;
    }
    val r_1426: err[fail.Fail] = ir.instr_inline_site_set(fn, add_iid, 3);
    if (sel r_1426.err) { ret 1; }

    val src_mask: u32 = meta_mask_of(fn, add_iid);
    if ((src_mask & (1 << refs.META_DBG_VAR::u32)) == 0)      { ret 1; }
    if ((src_mask & (1 << refs.META_INLINE_SITE::u32)) == 0)  { ret 1; }
    val src_alloca_mask: u32 = meta_mask_of(fn, alloca_iid);
    if ((src_alloca_mask & (1 << refs.META_ALLOCA_DBG_VAR::u32)) == 0) { ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: res[*u32, A.Error] = A.allocate[u32](m.alloc, map_len::usize);
    if (sel res_map.err) { ret 1; }
    val instr_map: *u32 = res_map.ok;
    fin { A.deallocate[u32](m.alloc, instr_map, map_len::usize); }
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    val r_1442: err[fail.Fail] = clone_one(?m, fn, add_iid, instr_map, map_len);
    if (sel r_1442.err) { ret 1; }
    val r_1443: err[fail.Fail] = clone_one(?m, fn, alloca_iid, instr_map, map_len);
    if (sel r_1443.err) { ret 1; }

    val add_clone:    id.InstructionId = instr_map[add_iid::u32]::id.InstructionId;
    val alloca_clone: id.InstructionId = instr_map[alloca_iid::u32]::id.InstructionId;

    if (meta_mask_of(fn, add_clone)    != src_mask)        { ret 1; }
    if (meta_mask_of(fn, alloca_clone) != src_alloca_mask) { ret 1; }
    ret 0;
}
