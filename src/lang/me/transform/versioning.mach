use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.me.ir;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.refs;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.value;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.mutate;
use mach.lang.me.analysis.loops;
use dep: mach.lang.me.analysis.dependence;

pub def VersionStatus: u8;
pub val VERSION_OK:          VersionStatus = 0;
pub val VERSION_NOT_COUNTED: VersionStatus = 1;
pub val VERSION_ILL_FORMED:  VersionStatus = 2;
pub val VERSION_DEPENDENT:   VersionStatus = 3;
pub val VERSION_LIVE_OUT:    VersionStatus = 4;
pub val VERSION_VOLATILE:    VersionStatus = 5;
pub val VERSION_UNSAFE_BOUND: VersionStatus = 6;

pub rec VersionResult {
    status:      VersionStatus;
    guard:       id.BlockId;
    merge:       id.BlockId;
    fast_header: id.BlockId;
    fast_blocks: *id.BlockId;
    fast_len:    u32;
    bound_ex:    value.Value;
}

pub val NONE_U32: u32 = 0xFFFFFFFF;

pub fun emit_alias_guard(b: *builder.Builder, d: *dep.DepInfo, init: value.Value, bound_ex: value.Value) res[value.Value, fail.Fail] {
    val m: *ir.Module = b.m;
    val ri8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel ri8.err) { ret res[value.Value, fail.Fail].err{ri8.err}; }
    val i8t: ir_type.IrTypeId = ri8.ok;

    val n: u32 = d.access_count;
    if (n == 0) { ret res[value.Value, fail.Fail].ok{value.const_int(1, i8t)}; }

    val rpart: res[*bool, A.Error] = A.allocate[bool](m.alloc, n::usize);
    if (sel rpart.err) { ret res[value.Value, fail.Fail].err{fail.refused(rpart.err)}; }
    val part: *bool = rpart.ok;
    var p: u32 = 0;
    for (p < n) { part[p] = false; p = p + 1; }
    var wi: u32 = 0;
    for (wi < n) {
        if (d.accesses[wi].is_store) {
            var oi: u32 = 0;
            for (oi < n) {
                if (oi != wi && !dep.equal(d.accesses[wi].base, d.accesses[oi].base)) {
                    part[wi] = true;
                    part[oi] = true;
                }
                oi = oi + 1;
            }
        }
        wi = wi + 1;
    }

    val rs: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, n::usize);
    if (sel rs.err) { A.deallocate[bool](m.alloc, part, n::usize); ret res[value.Value, fail.Fail].err{fail.refused(rs.err)}; }
    val starts: *value.Value = rs.ok;
    val re: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, n::usize);
    if (sel re.err) { A.deallocate[bool](m.alloc, part, n::usize); A.deallocate[value.Value](m.alloc, starts, n::usize); ret res[value.Value, fail.Fail].err{fail.refused(re.err)}; }
    val ends: *value.Value = re.ok;

    var has_pair: bool = false;
    var i: u32 = 0;
    for (i < n) { if (part[i]) { has_pair = true; } i = i + 1; }
    if (!has_pair) {
        guard_free3(m, part, starts, ends, n);
        ret res[value.Value, fail.Fail].ok{value.const_int(1, i8t)};
    }

    i = 0;
    for (i < n) {
        if (part[i]) {
            val acc: *dep.MemAccess = ?d.accesses[i];
            val rlo: res[value.Value, fail.Fail] = shift_index(b, acc.off, init);
            if (sel rlo.err) { guard_free3(m, part, starts, ends, n); ret rlo; }
            var ixs: [1]value.Value;
            ixs[0] = rlo.ok;
            val rst: res[value.Value, fail.Fail] = builder.emit_gep(b, acc.base, acc.stride_ty, ?ixs[0], 1);
            if (sel rst.err) { guard_free3(m, part, starts, ends, n); ret rst; }
            starts[i] = rst.ok;
            val rhi: res[value.Value, fail.Fail] = shift_index(b, acc.off, bound_ex);
            if (sel rhi.err) { guard_free3(m, part, starts, ends, n); ret rhi; }
            var ixe: [1]value.Value;
            ixe[0] = rhi.ok;
            val ren: res[value.Value, fail.Fail] = builder.emit_gep(b, acc.base, acc.stride_ty, ?ixe[0], 1);
            if (sel ren.err) { guard_free3(m, part, starts, ends, n); ret ren; }
            ends[i] = ren.ok;
        }
        i = i + 1;
    }

    var have_guard: bool = false;
    var guard: value.Value = value.const_int(1, i8t);
    wi = 0;
    for (wi < n) {
        if (d.accesses[wi].is_store) {
            var oi: u32 = 0;
            for (oi < n) {
                if (oi != wi && !dep.equal(d.accesses[wi].base, d.accesses[oi].base)) {
                    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_le_u(b, ends[wi], starts[oi]);
                    if (sel rc1.err) { guard_free3(m, part, starts, ends, n); ret rc1; }
                    val rc2: res[value.Value, fail.Fail] = builder.emit_cmp_le_u(b, ends[oi], starts[wi]);
                    if (sel rc2.err) { guard_free3(m, part, starts, ends, n); ret rc2; }
                    val rp: res[value.Value, fail.Fail] = builder.emit_or(b, rc1.ok, rc2.ok);
                    if (sel rp.err) { guard_free3(m, part, starts, ends, n); ret rp; }
                    val pair: value.Value = rp.ok;
                    if (!have_guard) {
                        guard = pair;
                        have_guard = true;
                    } or {
                        val ra: res[value.Value, fail.Fail] = builder.emit_and(b, guard, pair);
                        if (sel ra.err) { guard_free3(m, part, starts, ends, n); ret ra; }
                        guard = ra.ok;
                    }
                }
                oi = oi + 1;
            }
        }
        wi = wi + 1;
    }

    guard_free3(m, part, starts, ends, n);
    ret res[value.Value, fail.Fail].ok{guard};
}

fun shift_index(b: *builder.Builder, off: value.Value, ix: value.Value) res[value.Value, fail.Fail] {
    if (off.kind == value.VAL_CONST_INT && off.data.int_lit == 0) { ret res[value.Value, fail.Fail].ok{ix}; }
    ret builder.emit_add(b, off, ix);
}

fun guard_free3(m: *ir.Module, part: *bool, starts: *value.Value, ends: *value.Value, n: u32) {
    A.deallocate[bool](m.alloc, part, n::usize);
    A.deallocate[value.Value](m.alloc, starts, n::usize);
    A.deallocate[value.Value](m.alloc, ends, n::usize);
}

pub fun emit_exclusive_bound(b: *builder.Builder, counted: *loops.CountedInfo) res[value.Value, fail.Fail] {
    if (!counted.bound_inclusive) { ret res[value.Value, fail.Fail].ok{counted.bound}; }
    ret builder.emit_add(b, counted.bound, value.const_int(1, counted.bound.ty));
}

val VER_MAGNITUDE_MARGIN: u64 = 0x100000000;
val VER_U64_MAX:          u64 = 0xFFFFFFFFFFFFFFFF;
val VER_I64_SMAX:         u64 = 0x7FFFFFFFFFFFFFFF;
val VER_I64_SMIN:         u64 = 0x8000000000000000;

pub fun pred_is_unsigned(pred: instruction.InstrKind) bool {
    ret opdesc.has(pred, opdesc.EFF_CMP_UNSIGNED);
}


fun const_in_range(v: value.Value, check_lo: bool, lo: u64, hi: u64, use_signed: bool) opt[bool] {
    if (v.kind != value.VAL_CONST_INT) { ret opt[bool].none{}; }
    var ok: bool = true;
    if (use_signed) {
        val sv: i64 = v.data.int_lit:~i64;
        if (check_lo && sv < (lo:~i64)) { ok = false; }
        if (sv > (hi:~i64)) { ok = false; }
    } or {
        if (check_lo && v.data.int_lit < lo) { ok = false; }
        if (v.data.int_lit > hi) { ok = false; }
    }
    ret opt[bool].some{ok};
}

fun in_range(b: *builder.Builder, v: value.Value, check_lo: bool, lo: u64, hi: u64, use_signed: bool) res[value.Value, fail.Fail] {
    val ri8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?b.m.types, 8);
    if (sel ri8.err) { ret res[value.Value, fail.Fail].err{ri8.err}; }
    val i8t: ir_type.IrTypeId = ri8.ok;

    val cst: opt[bool] = const_in_range(v, check_lo, lo, hi, use_signed);
    if (sel cst.some) {
        var bit: u64 = 0;
        if (cst.some) { bit = 1; }
        ret res[value.Value, fail.Fail].ok{value.const_int(bit, i8t)};
    }

    val hi_v: value.Value = value.const_int(hi, v.ty);
    var rhi: res[value.Value, fail.Fail];
    if (use_signed) { rhi = builder.emit_cmp_le_s(b, v, hi_v); } or { rhi = builder.emit_cmp_le_u(b, v, hi_v); }
    if (sel rhi.err) { ret rhi; }
    if (!check_lo) { ret rhi; }

    val lo_v: value.Value = value.const_int(lo, v.ty);
    var rlo: res[value.Value, fail.Fail];
    if (use_signed) { rlo = builder.emit_cmp_le_s(b, lo_v, v); } or { rlo = builder.emit_cmp_le_u(b, lo_v, v); }
    if (sel rlo.err) { ret rlo; }
    ret builder.emit_and(b, rlo.ok, rhi.ok);
}

pub fun magnitude_safe(b: *builder.Builder, v: value.Value, is_unsigned: bool) res[value.Value, fail.Fail] {
    if (is_unsigned) { ret in_range(b, v, false, 0, VER_U64_MAX - VER_MAGNITUDE_MARGIN, false); }
    ret in_range(b, v, true, VER_I64_SMIN + VER_MAGNITUDE_MARGIN, VER_I64_SMAX - VER_MAGNITUDE_MARGIN, true);
}

pub fun offset_safe(b: *builder.Builder, off: value.Value) res[value.Value, fail.Fail] {
    ret in_range(b, off, true, 0 - VER_MAGNITUDE_MARGIN, VER_MAGNITUDE_MARGIN, true);
}

pub fun const_magnitude_safe(v: value.Value, is_unsigned: bool) opt[bool] {
    if (is_unsigned) { ret const_in_range(v, false, 0, VER_U64_MAX - VER_MAGNITUDE_MARGIN, false); }
    ret const_in_range(v, true, VER_I64_SMIN + VER_MAGNITUDE_MARGIN, VER_I64_SMAX - VER_MAGNITUDE_MARGIN, true);
}

pub fun const_offset_safe(off: value.Value) opt[bool] {
    ret const_in_range(off, true, 0 - VER_MAGNITUDE_MARGIN, VER_MAGNITUDE_MARGIN, true);
}

pub fun version_loop(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32, d: *dep.DepInfo) res[VersionResult, fail.Fail] {
    var vr: VersionResult;
    vr.status      = VERSION_OK;
    vr.guard       = id.BLOCK_NIL;
    vr.merge       = id.BLOCK_NIL;
    vr.fast_header = id.BLOCK_NIL;
    vr.fast_blocks = nil;
    vr.fast_len    = 0;
    vr.bound_ex    = value.const_null(ir_type.IRT_NIL);

    if (loop_ix >= la.loop_len) { vr.status = VERSION_NOT_COUNTED; ret res[VersionResult, fail.Fail].ok{vr}; }
    if (effect.function_has_volatile(fn)) { vr.status = VERSION_VOLATILE; ret res[VersionResult, fail.Fail].ok{vr}; }
    val lp: *loops.Loop = ?la.loops[loop_ix];
    if (!lp.is_counted) { vr.status = VERSION_NOT_COUNTED; ret res[VersionResult, fail.Fail].ok{vr}; }
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL || lp.exit == id.BLOCK_NIL || lp.exiting == id.BLOCK_NIL) {
        vr.status = VERSION_ILL_FORMED; ret res[VersionResult, fail.Fail].ok{vr};
    }
    if (d.verdict != dep.DEP_INDEPENDENT) { vr.status = VERSION_DEPENDENT; ret res[VersionResult, fail.Fail].ok{vr}; }
    if (has_live_out(fn, la, loop_ix)) { vr.status = VERSION_LIVE_OUT; ret res[VersionResult, fail.Fail].ok{vr}; }

    val is_unsigned: bool = pred_is_unsigned(lp.counted.pred);
    val cb: opt[bool] = const_magnitude_safe(lp.counted.bound, is_unsigned);
    if (sel cb.some && !cb.some) { vr.status = VERSION_UNSAFE_BOUND; ret res[VersionResult, fail.Fail].ok{vr}; }
    val ci: opt[bool] = const_magnitude_safe(lp.iv.init, is_unsigned);
    if (sel ci.some && !ci.some) { vr.status = VERSION_UNSAFE_BOUND; ret res[VersionResult, fail.Fail].ok{vr}; }
    var oi0: u32 = 0;
    for (oi0 < d.access_count) {
        val co: opt[bool] = const_offset_safe(d.accesses[oi0].off);
        if (sel co.some && !co.some) { vr.status = VERSION_UNSAFE_BOUND; ret res[VersionResult, fail.Fail].ok{vr}; }
        oi0 = oi0 + 1;
    }

    val header:    id.BlockId = lp.header;
    val preheader: id.BlockId = lp.preheader;
    val exit:      id.BlockId = lp.exit;
    val exiting:   id.BlockId = lp.exiting;
    val body_len:  u32        = lp.body_len;

    val rbb: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rbb.err) { ret res[VersionResult, fail.Fail].err{fail.refused(rbb.err)}; }
    val body: *id.BlockId = rbb.ok;
    var bi: u32 = 0;
    for (bi < body_len) { body[bi] = lp.body[bi]; bi = bi + 1; }

    val rfb: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rfb.err) { A.deallocate[id.BlockId](m.alloc, body, body_len::usize); ret res[VersionResult, fail.Fail].err{fail.refused(rfb.err)}; }
    val fast_blocks: *id.BlockId = rfb.ok;
    val rcr: err[fail.Fail] = clone_region(m, fn, body, body_len, fast_blocks);
    if (sel rcr.err) {
        A.deallocate[id.BlockId](m.alloc, body, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, fast_blocks, body_len::usize);
        ret res[VersionResult, fail.Fail].err{rcr.err};
    }

    val rg: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rg.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rg.err}; }
    val guard_bid: id.BlockId = rg.ok;
    val rmb: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rmb.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rmb.err}; }
    val merge_bid: id.BlockId = rmb.ok;

    val fast_header: id.BlockId = fast_blocks[region_index(body, body_len, header)];
    val fast_exiting: id.BlockId = fast_blocks[region_index(body, body_len, exiting)];

    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, guard_bid);
    val rbe: res[value.Value, fail.Fail] = emit_exclusive_bound(?b, ?lp.counted);
    if (sel rbe.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rbe.err}; }
    val bound_ex: value.Value = rbe.ok;

    val rbs: res[value.Value, fail.Fail] = magnitude_safe(?b, lp.counted.bound, is_unsigned);
    if (sel rbs.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rbs.err}; }
    var safe: value.Value = rbs.ok;
    val ris: res[value.Value, fail.Fail] = magnitude_safe(?b, lp.iv.init, is_unsigned);
    if (sel ris.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{ris.err}; }
    val ra1: res[value.Value, fail.Fail] = builder.emit_and(?b, safe, ris.ok);
    if (sel ra1.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{ra1.err}; }
    safe = ra1.ok;
    var oi: u32 = 0;
    for (oi < d.access_count) {
        val ros: res[value.Value, fail.Fail] = offset_safe(?b, d.accesses[oi].off);
        if (sel ros.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{ros.err}; }
        val ra2: res[value.Value, fail.Fail] = builder.emit_and(?b, safe, ros.ok);
        if (sel ra2.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{ra2.err}; }
        safe = ra2.ok;
        oi = oi + 1;
    }

    val rge: res[value.Value, fail.Fail] = emit_alias_guard(?b, d, lp.iv.init, bound_ex);
    if (sel rge.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rge.err}; }
    val ragf: res[value.Value, fail.Fail] = builder.emit_and(?b, safe, rge.ok);
    if (sel ragf.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{ragf.err}; }
    val guard_val: value.Value = ragf.ok;
    val rcbr: err[fail.Fail] = builder.emit_cbr(?b, guard_val, fast_header, header);
    if (sel rcbr.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rcbr.err}; }

    builder.set_block(?b, merge_bid);
    val rbr: err[fail.Fail] = builder.emit_br(?b, exit);
    if (sel rbr.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rbr.err}; }

    redirect_terminator(fn, preheader, header, guard_bid);

    relabel_phi_pred(fn, header, preheader, guard_bid);
    relabel_phi_pred(fn, fast_header, preheader, guard_bid);

    redirect_terminator(fn, exiting, exit, merge_bid);
    redirect_terminator(fn, fast_exiting, exit, merge_bid);
    relabel_phi_pred(fn, exit, exiting, merge_bid);

    val rpr: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel rpr.err) { free2(m, body, fast_blocks, body_len); ret res[VersionResult, fail.Fail].err{rpr.err}; }

    A.deallocate[id.BlockId](m.alloc, body, body_len::usize);

    vr.status      = VERSION_OK;
    vr.guard       = guard_bid;
    vr.merge       = merge_bid;
    vr.fast_header = fast_header;
    vr.fast_blocks = fast_blocks;
    vr.fast_len    = body_len;
    vr.bound_ex    = bound_ex;
    ret res[VersionResult, fail.Fail].ok{vr};
}

fun free2(m: *ir.Module, body: *id.BlockId, fast: *id.BlockId, len: u32) {
    A.deallocate[id.BlockId](m.alloc, body, len::usize);
    A.deallocate[id.BlockId](m.alloc, fast, len::usize);
}

pub fun region_index(blocks: *id.BlockId, len: u32, blk: id.BlockId) u32 {
    var i: u32 = 0;
    for (i < len) { if (blocks[i] == blk) { ret i; } i = i + 1; }
    ret 0;
}

pub fun clone_region(m: *ir.Module, fn: *ir.Function, body: *id.BlockId, body_len: u32, out_clones: *id.BlockId) err[fail.Fail] {
    val n_blocks: u32 = fn.block_count;
    val n_instrs: u32 = fn.instr_len;

    val rbm: res[*u32, A.Error] = A.allocate[u32](m.alloc, n_blocks::usize);
    if (sel rbm.err) { ret err[fail.Fail].err{fail.refused(rbm.err)}; }
    val block_map: *u32 = rbm.ok;
    val rim: res[*u32, A.Error] = A.allocate[u32](m.alloc, n_instrs::usize);
    if (sel rim.err) { A.deallocate[u32](m.alloc, block_map, n_blocks::usize); ret err[fail.Fail].err{fail.refused(rim.err)}; }
    val instr_map: *u32 = rim.ok;
    var k: u32 = 0;
    for (k < n_blocks) { block_map[k] = NONE_U32; k = k + 1; }
    k = 0;
    for (k < n_instrs) { instr_map[k] = NONE_U32; k = k + 1; }

    var bi: u32 = 0;
    for (bi < body_len) {
        val radd: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
        if (sel radd.err) { region_free(m, block_map, n_blocks, instr_map, n_instrs); ret err[fail.Fail].err{radd.err}; }
        block_map[body[bi]::u32] = radd.ok::u32;
        bi = bi + 1;
    }

    bi = 0;
    for (bi < body_len) {
        val blk: *ir.Block = ?fn.blocks[body[bi]::u32];
        var p: u32 = 0;
        for (p < blk.phi_count) {
            val rc: err[fail.Fail] = clone_one(m, fn, blk.phis[p], instr_map, n_instrs);
            if (sel rc.err) { region_free(m, block_map, n_blocks, instr_map, n_instrs); ret rc; }
            p = p + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val rc: err[fail.Fail] = clone_one(m, fn, blk.instructions[ii], instr_map, n_instrs);
            if (sel rc.err) { region_free(m, block_map, n_blocks, instr_map, n_instrs); ret rc; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL) {
            val rc: err[fail.Fail] = clone_one(m, fn, blk.terminator, instr_map, n_instrs);
            if (sel rc.err) { region_free(m, block_map, n_blocks, instr_map, n_instrs); ret rc; }
        }
        bi = bi + 1;
    }

    bi = 0;
    for (bi < body_len) {
        val src: *ir.Block = ?fn.blocks[body[bi]::u32];
        val dst: *ir.Block = ?fn.blocks[block_map[body[bi]::u32]];
        var p: u32 = 0;
        for (p < src.phi_count) {
            val rp: err[fail.Fail] = ir.block_append_phi(m, dst, instr_map[src.phis[p]::u32]::id.InstructionId);
            if (sel rp.err) { region_free(m, block_map, n_blocks, instr_map, n_instrs); ret rp; }
            p = p + 1;
        }
        var ii: u32 = 0;
        for (ii < src.instr_count) {
            val ra: err[fail.Fail] = ir.block_append_instr(m, dst, instr_map[src.instructions[ii]::u32]::id.InstructionId);
            if (sel ra.err) { region_free(m, block_map, n_blocks, instr_map, n_instrs); ret ra; }
            ii = ii + 1;
        }
        if (src.terminator != id.INSTR_NIL) {
            dst.terminator = instr_map[src.terminator::u32]::id.InstructionId;
        }
        bi = bi + 1;
    }

    remap_operands(fn, block_map, n_blocks, instr_map, n_instrs);

    bi = 0;
    for (bi < body_len) { out_clones[bi] = block_map[body[bi]::u32]::id.BlockId; bi = bi + 1; }
    region_free(m, block_map, n_blocks, instr_map, n_instrs);
    ret err[fail.Fail].ok{};
}

fun region_free(m: *ir.Module, block_map: *u32, n_blocks: u32, instr_map: *u32, n_instrs: u32) {
    A.deallocate[u32](m.alloc, block_map, n_blocks::usize);
    A.deallocate[u32](m.alloc, instr_map, n_instrs::usize);
}

pub fun version_result_dnit(vr: *VersionResult, alloc: *A.Allocator) {
    if (vr.fast_blocks != nil && vr.fast_len > 0) {
        A.deallocate[id.BlockId](alloc, vr.fast_blocks, vr.fast_len::usize);
        vr.fast_blocks = nil;
    }
    vr.fast_len = 0;
}

pub fun clone_one(m: *ir.Module, fn: *ir.Function, src_id: id.InstructionId, instr_map: *u32, map_len: u32) err[fail.Fail] {
    val rc: res[id.InstructionId, fail.Fail] = mutate.clone_instruction_complete(m, fn, fn, src_id, instr_map, map_len);
    if (sel rc.err) { ret err[fail.Fail].err{rc.err}; }
    instr_map[src_id::u32] = rc.ok::u32;
    ret err[fail.Fail].ok{};
}

pub fun remap_operands(fn: *ir.Function, block_map: *u32, n_blocks: u32, instr_map: *u32, n_instrs: u32) {
    var s: u32 = 0;
    for (s < n_instrs) {
        if (instr_map[s] != NONE_U32) {
            val clone_id: u32 = instr_map[s];
            val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, clone_id::id.InstructionId);
            if (sel opt_.some) {
                val inst: *instruction.Instruction = opt_.some;
                var o: u32 = 0;
                for (o < inst.operand_count) {
                    if (operand_is_block(inst.kind, o)) {
                        val old_bid: u32 = inst.operands[o].data.int_lit::u32;
                        if (old_bid < n_blocks && block_map[old_bid] != NONE_U32) {
                            inst.operands[o].data.int_lit = block_map[old_bid]::u64;
                        }
                    } or {
                        if (inst.operands[o].kind == value.VAL_INSTR) {
                            val old_iid: u32 = inst.operands[o].data.instr::u32;
                            if (old_iid < n_instrs && instr_map[old_iid] != NONE_U32) {
                                inst.operands[o].data.instr = instr_map[old_iid]::id.InstructionId;
                            }
                        }
                    }
                    o = o + 1;
                }
            }
        }
        s = s + 1;
    }
}

pub fun redirect_terminator(fn: *ir.Function, blk: id.BlockId, from: id.BlockId, to: id.BlockId) {
    val b: *ir.Block = ?fn.blocks[blk::u32];
    if (b.terminator == id.INSTR_NIL) { ret; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, b.terminator);
    if (sel opt_.none) { ret; }
    val term: *instruction.Instruction = opt_.some;
    var o: u32 = 0;
    for (o < term.operand_count) {
        if (operand_is_block(term.kind, o) && ir.block_target(term.operands[o]) == from) {
            term.operands[o].data.int_lit = to::u64;
        }
        o = o + 1;
    }
}

pub fun relabel_phi_pred(fn: *ir.Function, blk: id.BlockId, from: id.BlockId, to: id.BlockId) {
    val b: *ir.Block = ?fn.blocks[blk::u32];
    var pi: u32 = 0;
    for (pi < b.phi_count) {
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, b.phis[pi]);
        if (sel opt_.some) {
            val phi: *instruction.Instruction = opt_.some;
            var o: u32 = 0;
            for (o < phi.operand_count) {
                if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == from) {
                    phi.operands[o].data.int_lit = to::u64;
                }
                o = o + 1;
            }
        }
        pi = pi + 1;
    }
}

pub fun operand_is_block(k: instruction.InstrKind, o: u32) bool {
    ret refs.operand_is_block(k, o);
}


fun has_live_out(fn: *ir.Function, la: *loops.LoopAnalysis, loop_ix: u32) bool {
    var u: u32 = 0;
    for (u < fn.instr_len) {
        val ub: id.BlockId = la.instr_block[u];
        if (ub != id.BLOCK_NIL && !loops.loop_contains(la, loop_ix, ub)) {
            val inst: *instruction.Instruction = ?fn.instrs[u];
            var o: u32 = 0;
            for (o < inst.operand_count) {
                if (inst.operands[o].kind == value.VAL_INSTR) {
                    val defb: id.BlockId = la.instr_block[inst.operands[o].data.instr::u32];
                    if (defb != id.BLOCK_NIL && loops.loop_contains(la, loop_ix, defb)) { ret true; }
                }
                o = o + 1;
            }
        }
        u = u + 1;
    }
    ret false;
}

use std.allocator.page;
use std.collections.map;
use mach.lang.intern;
use mach.lang.me.ir.verify;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.target.resolved;
use mach.lang.source;

fun t_target(reg: *target.TargetRegistry, o_tgt: *resolved.Target) i32 {
    @reg = target.registry_init();
    val r_560: err[fail.Fail] = target.register_all(reg, target_testing.debug_descriptor);
    if (sel r_560.err) { ret 1; }
    val tr: res[resolved.Target, fail.Fail] = target.select(reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { target.registry_dnit(reg); ret 1; }
    @o_tgt = tr.ok;
    ret 0;
}

fun mk_sig(m: *ir.Module, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, o_sig: *ir_type.IrTypeId) i32 {
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret 1; }
    var ps: [4]ir_type.IrTypeId;
    ps[0] = i64t; ps[1] = ptrt; ps[2] = ptrt; ps[3] = ptrt;
    val rfn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, rv.ok, ?ps[0], 4, false);
    if (sel rfn.err) { ret 1; }
    @o_sig = rfn.ok;
    ret 0;
}

fun build_axpy(m: *ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, o_entry: *id.BlockId, o_header: *id.BlockId, o_body: *id.BlockId, o_exit: *id.BlockId, o_iv: *value.Value) i32 {
    val re: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel re.err) { ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rh.err) { ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rb.err) { ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rx.err) { ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);
    val b: value.Value = value.param(2, ptrt);
    val c: value.Value = value.param(3, ptrt);

    builder.set_block(bld, entry);
    val r_598: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_598.err) { ret 1; }

    builder.set_block(bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(bld, i64t);
    if (sel rphi.err) { ret 1; }
    val iv: value.Value = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(bld, iv, n);
    if (sel rc.err) { ret 1; }
    val r_606: err[fail.Fail] = builder.emit_cbr(bld, rc.ok, body, exit);
    if (sel r_606.err) { ret 1; }

    builder.set_block(bld, body);
    var ixb: [1]value.Value; ixb[0] = iv;
    val rgb: res[value.Value, fail.Fail] = builder.emit_gep(bld, b, i64t, ?ixb[0], 1);
    if (sel rgb.err) { ret 1; }
    val rlb: res[value.Value, fail.Fail] = builder.emit_load(bld, rgb.ok, i64t);
    if (sel rlb.err) { ret 1; }
    var ixc: [1]value.Value; ixc[0] = iv;
    val rgc: res[value.Value, fail.Fail] = builder.emit_gep(bld, c, i64t, ?ixc[0], 1);
    if (sel rgc.err) { ret 1; }
    val rlc: res[value.Value, fail.Fail] = builder.emit_load(bld, rgc.ok, i64t);
    if (sel rlc.err) { ret 1; }
    val rs: res[value.Value, fail.Fail] = builder.emit_add(bld, rlb.ok, rlc.ok);
    if (sel rs.err) { ret 1; }
    var ixa: [1]value.Value; ixa[0] = iv;
    val rga: res[value.Value, fail.Fail] = builder.emit_gep(bld, a, i64t, ?ixa[0], 1);
    if (sel rga.err) { ret 1; }
    val r_624: err[fail.Fail] = builder.emit_store(bld, rs.ok, rga.ok);
    if (sel r_624.err) { ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ret 1; }
    val upd: value.Value = ru.ok;
    val r_628: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_628.err) { ret 1; }

    builder.set_block(bld, exit);
    val r_631: err[fail.Fail] = builder.emit_ret_void(bld);
    if (sel r_631.err) { ret 1; }

    val r_633: err[fail.Fail] = builder.phi_add_incoming(bld, iv, entry, value.const_int(0, i64t));
    if (sel r_633.err) { ret 1; }
    val r_634: err[fail.Fail] = builder.phi_add_incoming(bld, iv, body, upd);
    if (sel r_634.err) { ret 1; }

    @o_entry = entry; @o_header = header; @o_body = body; @o_exit = exit; @o_iv = iv;
    ret 0;
}

fun count_op(fn: *ir.Function, bid: id.BlockId, k: instruction.InstrKind) u32 {
    val blk: *ir.Block = ?fn.blocks[bid::u32];
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < blk.instr_count) {
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[i]);
        if (sel opt_.some) {
            if (opt_.some.kind == k) { n = n + 1; }
        }
        i = i + 1;
    }
    ret n;
}

test "mach.lang.me.transform.versioning:alias_guard_shape" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (build_axpy(?m, ?bld, i64t, ptrt, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = rd.ok;

    val rg: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rg.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    val gb: id.BlockId = rg.ok;
    builder.set_block(?bld, gb);
    val init: value.Value = la.loops[0].iv.init;
    val rbex: res[value.Value, fail.Fail] = emit_exclusive_bound(?bld, ?la.loops[0].counted);
    if (sel rbex.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    val rge: res[value.Value, fail.Fail] = emit_alias_guard(?bld, ?di, init, rbex.ok);
    if (sel rge.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }

    if (count_op(fn, gb, instruction.OP_GEP) != 6)      { code = 1; }
    if (count_op(fn, gb, instruction.OP_CMP_LE_U) != 4) { code = 1; }
    if (count_op(fn, gb, instruction.OP_OR) != 2)       { code = 1; }
    if (count_op(fn, gb, instruction.OP_AND) != 1)      { code = 1; }

    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.versioning:version_verifier_clean" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (build_axpy(?m, ?bld, i64t, ptrt, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }
    val blocks_before: u32 = fn.block_count;

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = rd.ok;

    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di);
    if (sel rv.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_OK) { code = 1; }
    if (fn.block_count != blocks_before + 4) { code = 1; }

    val gblk: *ir.Block = ?fn.blocks[vres.guard::u32];
    val topt: opt[*instruction.Instruction] = ir.instruction_get(fn, gblk.terminator);
    if (sel topt.none) { code = 1; }
    or (sel topt.some) {
        val term: *instruction.Instruction = topt.some;
        if (term.kind != instruction.OP_CBR)                      { code = 1; }
        if (ir.block_target(term.operands[1]) != vres.fast_header) { code = 1; }
        if (ir.block_target(term.operands[2]) != header)          { code = 1; }
    }

    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (t_target(?reg, ?tgt) != 0) { code = 1; }
    val rvr: res[verify.VerifyReport, fail.Fail] =
        verify.verify_module_ext(?m, ?alloc, verify.opts(?tgt, true, false));
    if (sel rvr.err) { code = 1; }
    or (sel rvr.ok) {
        var rep: verify.VerifyReport = rvr.ok;
        if (rep.len != 0) { code = 1; }
        verify.dnit_report(?rep);
    }

    val ral2: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral2.err) { code = 1; }
    or (sel ral2.ok) {
        var la2: loops.LoopAnalysis = ral2.ok;
        if (la2.loop_len != 2) { code = 1; }
        loops.dnit(?la2);
    }

    version_result_dnit(?vres, ?alloc);
    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.versioning:refuse_dependent" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;
    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);
    builder.set_block(?bld, entry);
    val r_817: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_817.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val iv: value.Value = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, iv, n);
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val r_824: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, body, exit);
    if (sel r_824.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, body);
    val rim1: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(0xFFFFFFFFFFFFFFFF, i64t));
    if (sel rim1.err) { ir.dnit(?m); ret 1; }
    var ixs: [1]value.Value; ixs[0] = rim1.ok;
    val rgs: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixs[0], 1);
    if (sel rgs.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgs.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    var ixd: [1]value.Value; ixd[0] = iv;
    val rgd: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixd[0], 1);
    if (sel rgd.err) { ir.dnit(?m); ret 1; }
    val r_836: err[fail.Fail] = builder.emit_store(?bld, rl.ok, rgd.ok);
    if (sel r_836.err) { ir.dnit(?m); ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_839: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_839.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, exit);
    val r_841: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_841.err) { ir.dnit(?m); ret 1; }
    val r_842: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, value.const_int(0, i64t));
    if (sel r_842.err) { ir.dnit(?m); ret 1; }
    val r_843: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_843.err) { ir.dnit(?m); ret 1; }

    val blocks_before: u32 = fn.block_count;
    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = rd.ok;
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di);
    if (sel rv.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_DEPENDENT)   { code = 1; }
    if (fn.block_count != blocks_before)    { code = 1; }
    version_result_dnit(?vres, ?alloc);
    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.versioning:refuse_live_out" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;
    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);
    val bb: value.Value = value.param(2, ptrt);
    builder.set_block(?bld, entry);
    val r_901: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_901.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val iv: value.Value = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, iv, n);
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val r_908: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, body, exit);
    if (sel r_908.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, body);
    var ixb: [1]value.Value; ixb[0] = iv;
    val rgb: res[value.Value, fail.Fail] = builder.emit_gep(?bld, bb, i64t, ?ixb[0], 1);
    if (sel rgb.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgb.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    var ixa: [1]value.Value; ixa[0] = iv;
    val rga: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixa[0], 1);
    if (sel rga.err) { ir.dnit(?m); ret 1; }
    val r_918: err[fail.Fail] = builder.emit_store(?bld, rl.ok, rga.ok);
    if (sel r_918.err) { ir.dnit(?m); ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_921: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_921.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, exit);
    val r_923: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(0, i64t));
    if (sel r_923.err) { ir.dnit(?m); ret 1; }
    val r_924: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_924.err) { ir.dnit(?m); ret 1; }
    val r_925: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, value.const_int(0, i64t));
    if (sel r_925.err) { ir.dnit(?m); ret 1; }
    val r_926: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_926.err) { ir.dnit(?m); ret 1; }

    val blocks_before: u32 = fn.block_count;
    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = rd.ok;
    if (di.verdict != dep.DEP_INDEPENDENT) { code = 1; }
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di);
    if (sel rv.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_LIVE_OUT) { code = 1; }
    if (fn.block_count != blocks_before) { code = 1; }
    version_result_dnit(?vres, ?alloc);
    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.versioning:le_bound_exclusive" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;
    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);
    val bb: value.Value = value.param(2, ptrt);
    builder.set_block(?bld, entry);
    val r_985: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_985.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val iv: value.Value = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_le_s(?bld, iv, n);
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val r_992: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, body, exit);
    if (sel r_992.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, body);
    var ixb: [1]value.Value; ixb[0] = iv;
    val rgb: res[value.Value, fail.Fail] = builder.emit_gep(?bld, bb, i64t, ?ixb[0], 1);
    if (sel rgb.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgb.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    var ixa: [1]value.Value; ixa[0] = iv;
    val rga: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixa[0], 1);
    if (sel rga.err) { ir.dnit(?m); ret 1; }
    val r_1002: err[fail.Fail] = builder.emit_store(?bld, rl.ok, rga.ok);
    if (sel r_1002.err) { ir.dnit(?m); ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_1005: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1005.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, exit);
    val r_1007: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1007.err) { ir.dnit(?m); ret 1; }
    val r_1008: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, value.const_int(0, i64t));
    if (sel r_1008.err) { ir.dnit(?m); ret 1; }
    val r_1009: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_1009.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    if (la.loop_len != 1)                       { code = 1; }
    if (!la.loops[0].is_counted)                { code = 1; }
    if (!la.loops[0].counted.bound_inclusive)   { code = 1; }

    val rgb2: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rgb2.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    val gb: id.BlockId = rgb2.ok;
    builder.set_block(?bld, gb);
    val rex: res[value.Value, fail.Fail] = emit_exclusive_bound(?bld, ?la.loops[0].counted);
    if (sel rex.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    val bex: value.Value = rex.ok;
    if (bex.kind != value.VAL_INSTR) { code = 1; }
    or {
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, bex.data.instr);
        if (sel opt_.none) { code = 1; }
        or (sel opt_.some) {
            val add: *instruction.Instruction = opt_.some;
            if (add.kind != instruction.OP_ADD)                 { code = 1; }
            if (add.operands[0].kind != value.VAL_PARAM)        { code = 1; }
            if (add.operands[0].data.param_ix != 0)             { code = 1; }
            if (add.operands[1].kind != value.VAL_CONST_INT)    { code = 1; }
            if (add.operands[1].data.int_lit != 1)              { code = 1; }
        }
    }

    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

fun build_axpy_ext(m: *ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, bound: value.Value, init: value.Value, off_a: u64, o_entry: *id.BlockId, o_header: *id.BlockId, o_body: *id.BlockId, o_exit: *id.BlockId, o_iv: *value.Value) i32 {
    val re: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel re.err) { ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rh.err) { ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rb.err) { ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rx.err) { ret 1; }
    val exit: id.BlockId = rx.ok;

    val a: value.Value = value.param(1, ptrt);
    val b: value.Value = value.param(2, ptrt);
    val c: value.Value = value.param(3, ptrt);

    builder.set_block(bld, entry);
    val r_1064: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_1064.err) { ret 1; }

    builder.set_block(bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(bld, i64t);
    if (sel rphi.err) { ret 1; }
    val iv: value.Value = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(bld, iv, bound);
    if (sel rc.err) { ret 1; }
    val r_1072: err[fail.Fail] = builder.emit_cbr(bld, rc.ok, body, exit);
    if (sel r_1072.err) { ret 1; }

    builder.set_block(bld, body);
    var ixb: [1]value.Value; ixb[0] = iv;
    val rgb: res[value.Value, fail.Fail] = builder.emit_gep(bld, b, i64t, ?ixb[0], 1);
    if (sel rgb.err) { ret 1; }
    val rlb: res[value.Value, fail.Fail] = builder.emit_load(bld, rgb.ok, i64t);
    if (sel rlb.err) { ret 1; }
    var ixc: [1]value.Value; ixc[0] = iv;
    val rgc: res[value.Value, fail.Fail] = builder.emit_gep(bld, c, i64t, ?ixc[0], 1);
    if (sel rgc.err) { ret 1; }
    val rlc: res[value.Value, fail.Fail] = builder.emit_load(bld, rgc.ok, i64t);
    if (sel rlc.err) { ret 1; }
    val rs: res[value.Value, fail.Fail] = builder.emit_add(bld, rlb.ok, rlc.ok);
    if (sel rs.err) { ret 1; }

    var a_ix: value.Value = iv;
    if (off_a != 0) {
        val roa: res[value.Value, fail.Fail] = builder.emit_add(bld, iv, value.const_int(off_a, i64t));
        if (sel roa.err) { ret 1; }
        a_ix = roa.ok;
    }
    var ixa: [1]value.Value; ixa[0] = a_ix;
    val rga: res[value.Value, fail.Fail] = builder.emit_gep(bld, a, i64t, ?ixa[0], 1);
    if (sel rga.err) { ret 1; }
    val r_1097: err[fail.Fail] = builder.emit_store(bld, rs.ok, rga.ok);
    if (sel r_1097.err) { ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ret 1; }
    val upd: value.Value = ru.ok;
    val r_1101: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_1101.err) { ret 1; }

    builder.set_block(bld, exit);
    val r_1104: err[fail.Fail] = builder.emit_ret_void(bld);
    if (sel r_1104.err) { ret 1; }

    val r_1106: err[fail.Fail] = builder.phi_add_incoming(bld, iv, entry, init);
    if (sel r_1106.err) { ret 1; }
    val r_1107: err[fail.Fail] = builder.phi_add_incoming(bld, iv, body, upd);
    if (sel r_1107.err) { ret 1; }

    @o_entry = entry; @o_header = header; @o_body = body; @o_exit = exit; @o_iv = iv;
    ret 0;
}

test "mach.lang.me.transform.versioning:refuse_unsafe_bound_before_mutation" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val unsafe_bound: value.Value = value.const_int(VER_I64_SMAX - VER_MAGNITUDE_MARGIN + 1, i64t);
    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (build_axpy_ext(?m, ?bld, i64t, ptrt, unsafe_bound, value.const_int(0, i64t), 0, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    val blocks_before: u32 = fn.block_count;
    val instrs_before: u32 = fn.instr_len;

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (sel rd.err) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = rd.ok;
    val rv: res[VersionResult, fail.Fail] = version_loop(?m, fn, ?la, 0, ?di);
    if (sel rv.err) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    var vres: VersionResult = rv.ok;
    if (vres.status != VERSION_UNSAFE_BOUND) { code = 1; }
    if (fn.block_count != blocks_before)     { code = 1; }
    if (fn.instr_len != instrs_before)       { code = 1; }
    version_result_dnit(?vres, ?alloc);
    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

