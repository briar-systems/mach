test "mach.lang.me.transform.versioning:dynamic_bound_guard_gains_magnitude_checks" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);
    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    var sig: ir_type.IrTypeId;
    if (mk_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }
    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId; var iv: value.Value;
    if (build_axpy(?m, ?bld, i64t, ptrt, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: R.Result[loops.LoopAnalysis, str] = loops.analyze(fn, ?alloc);
    if (R.is_err[loops.LoopAnalysis, str](ral)) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = R.unwrap_ok[loops.LoopAnalysis, str](ral);
    val rd: R.Result[dep.DepInfo, str] = dep.analyze_dependence(fn, ?la, 0, ?m.types, ?alloc);
    if (R.is_err[dep.DepInfo, str](rd)) { loops.dnit(?la); ir.dnit(?m); ret 1; }
    var di: dep.DepInfo = R.unwrap_ok[dep.DepInfo, str](rd);
    val rv: R.Result[VersionResult, str] = version_loop(?m, fn, ?la, 0, ?di);
    if (R.is_err[VersionResult, str](rv)) { dep.dep_dnit(?di); loops.dnit(?la); ir.dnit(?m); ret 1; }
    var vres: VersionResult = R.unwrap_ok[VersionResult, str](rv);
    if (vres.status != VERSION_OK) { code = 1; }
    or {
        if (count_op(fn, vres.guard, instruction.OP_CMP_LE_S) != 2) { code = 1; }
        if (count_op(fn, vres.guard, instruction.OP_CMP_LE_U) != 4) { code = 1; }
        if (count_op(fn, vres.guard, instruction.OP_OR)       != 2) { code = 1; }
        if (count_op(fn, vres.guard, instruction.OP_AND)      != 7) { code = 1; }
    }
    version_result_dnit(?vres, ?alloc);
    dep.dep_dnit(?di);
    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.versioning.clone_one:carries_debug_metadata_to_the_clone" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);
    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (R.is_err[u32, str](r_fn)) { ir.dnit(?m); ret 1; }
    val fn_ix: u32 = R.unwrap_ok[u32, str](r_fn);

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[fn_ix]);
    val rblk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rblk)) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rblk));

    val r_add: R.Result[value.Value, str] = builder.emit_add(?bld, value.const_int(1, i64t), value.const_int(2, i64t));
    if (R.is_err[value.Value, str](r_add)) { ir.dnit(?m); ret 1; }
    val added: value.Value = R.unwrap_ok[value.Value, str](r_add);
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ir.dnit(?m); ret 1; }

    val fn: *ir.Function = ?m.functions[fn_ix];
    val src_iid: id.InstructionId = added.data.instr;

    var dv: ir.DbgVar;
    dv.name     = 4242::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 7;
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.DbgVar](?fn.dbg_vars, src_iid, dv))) { ir.dnit(?m); ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: R.Result[*u32, str] = A.allocate[u32](m.alloc, map_len::usize);
    if (R.is_err[*u32, str](res_map)) { ir.dnit(?m); ret 1; }
    val instr_map: *u32 = R.unwrap_ok[*u32, str](res_map);
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    val res_clone: R.Result[R.Void, str] = clone_one(?m, fn, src_iid, instr_map, map_len);
    if (R.is_err[R.Void, str](res_clone)) { A.deallocate[u32](m.alloc, instr_map, map_len::usize); ir.dnit(?m); ret 1; }
    val clone_iid: id.InstructionId = instr_map[src_iid::u32]::id.InstructionId;
    A.deallocate[u32](m.alloc, instr_map, map_len::usize);

    val opt_clone_dv: O.Option[*ir.DbgVar] = ir.dbg_var_get(fn, clone_iid);
    var bad: i32 = 0;
    if (O.is_none[*ir.DbgVar](opt_clone_dv)) { bad = 1; }
    or {
        val cdv: *ir.DbgVar = O.unwrap[*ir.DbgVar](opt_clone_dv);
        if (cdv.name != 4242::intern.StrId) { bad = 1; }
        if (cdv.scope != 7)                 { bad = 1; }
    }

    ir.dnit(?m);
    ret bad;
}

rec MetaSeen { mask: u32; }

fun note_meta(c: *MetaSeen, r: *refs.Ref) bool {
    if (r.role == refs.REF_METADATA)     { c.mask = c.mask | (1 << r.meta::u32); }
    if (r.role == refs.REF_INLINE_PARENT) { c.mask = c.mask | (1 << refs.META_INLINE_SITE::u32); }
    if (r.role == refs.REF_ASM_BIND)     { c.mask = c.mask | 0x80000000; }
    ret true;
}

fun meta_mask_of(fn: *ir.Function, iid: id.InstructionId) u32 {
    var c: MetaSeen;
    c.mask = 0;
    refs.visit[MetaSeen](fn, iid, ?c, note_meta);
    ret c.mask;
}

test "mach.lang.me.transform.versioning.clone_one:carries_every_metadata_kind_the_reference_visitor_reports" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val res_m: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](res_m)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](res_m);
    fin { ir.dnit(?m); }

    val ri: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](ri)) { ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ri);
    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ret 1; }
    val voidt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    val r_fn: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, voidt, 0);
    if (R.is_err[u32, str](r_fn)) { ret 1; }
    val fn_ix: u32 = R.unwrap_ok[u32, str](r_fn);

    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, ?m.functions[fn_ix]);
    val rblk: R.Result[id.BlockId, str] = builder.new_block(?bld);
    if (R.is_err[id.BlockId, str](rblk)) { ret 1; }
    builder.set_block(?bld, R.unwrap_ok[id.BlockId, str](rblk));

    val r_alloca: R.Result[value.Value, str] = builder.emit_alloca(?bld, i64t, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](r_alloca)) { ret 1; }
    val slot: value.Value = R.unwrap_ok[value.Value, str](r_alloca);
    val r_add: R.Result[value.Value, str] = builder.emit_add(?bld, value.const_int(1, i64t), value.const_int(2, i64t));
    if (R.is_err[value.Value, str](r_add)) { ret 1; }
    val added: value.Value = R.unwrap_ok[value.Value, str](r_add);
    if (R.is_err[R.Void, str](builder.emit_ret_void(?bld))) { ret 1; }

    val fn: *ir.Function = ?m.functions[fn_ix];
    val add_iid:    id.InstructionId = added.data.instr;
    val alloca_iid: id.InstructionId = slot.data.instr;

    var dv: ir.DbgVar;
    dv.name     = 4242::intern.StrId;
    dv.ty       = i64t;
    dv.is_param = false;
    dv.scope    = 7;
    if (R.is_err[bool, str](map.insert[id.InstructionId, ir.DbgVar](?fn.dbg_vars, add_iid, dv))) { ret 1; }
    if (R.is_err[R.Void, str](ir.record_alloca_dbg_var(fn, alloca_iid, dv))) { ret 1; }

    var sk: u32 = 0;
    for (sk < 4) {
        if (R.is_err[u32, str](ir.inline_site_add(?m, fn, 9::intern.StrId, source.loc_nil(), 0))) { ret 1; }
        sk = sk + 1;
    }
    if (R.is_err[R.Void, str](ir.instr_inline_site_set(fn, add_iid, 3))) { ret 1; }

    val src_mask: u32 = meta_mask_of(fn, add_iid);
    if ((src_mask & (1 << refs.META_DBG_VAR::u32)) == 0)      { ret 1; }
    if ((src_mask & (1 << refs.META_INLINE_SITE::u32)) == 0)  { ret 1; }
    val src_alloca_mask: u32 = meta_mask_of(fn, alloca_iid);
    if ((src_alloca_mask & (1 << refs.META_ALLOCA_DBG_VAR::u32)) == 0) { ret 1; }

    val map_len: u32 = fn.instr_len;
    val res_map: R.Result[*u32, str] = A.allocate[u32](m.alloc, map_len::usize);
    if (R.is_err[*u32, str](res_map)) { ret 1; }
    val instr_map: *u32 = R.unwrap_ok[*u32, str](res_map);
    fin { A.deallocate[u32](m.alloc, instr_map, map_len::usize); }
    var k: u32 = 0;
    for (k < map_len) { instr_map[k] = 0xFFFFFFFF; k = k + 1; }

    if (R.is_err[R.Void, str](clone_one(?m, fn, add_iid, instr_map, map_len)))    { ret 1; }
    if (R.is_err[R.Void, str](clone_one(?m, fn, alloca_iid, instr_map, map_len))) { ret 1; }

    val add_clone:    id.InstructionId = instr_map[add_iid::u32]::id.InstructionId;
    val alloca_clone: id.InstructionId = instr_map[alloca_iid::u32]::id.InstructionId;

    if (meta_mask_of(fn, add_clone)    != src_mask)        { ret 1; }
    if (meta_mask_of(fn, alloca_clone) != src_alloca_mask) { ret 1; }
    ret 0;
}
