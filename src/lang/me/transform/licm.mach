# mach.lang.me.transform.licm: loop-invariant code motion (#2204)
#
# Moves work that does not change across a loop's iterations out of the loop body
# into the loop's dedicated preheader, so it is computed once on entry instead of
# once per iteration. Two motions, both driven by the #2139 loop analysis
# (dominators, natural loops, `is_invariant`) rather than a second loop pass:
#
#   - WHOLE-INSTRUCTION HOISTING. An instruction whose every operand is invariant
#     and which is safe to execute unconditionally is relocated to the preheader.
#     This covers invariant address arithmetic, casts and ALU work, and -- under
#     the stricter load rule below -- an invariant load, including the backing
#     global of a module-scope `val` reloaded as a loop bound every iteration.
#
#   - INVARIANT GEP-PREFIX SPLITTING. `gep(@g, 0, i)` over a module-scope array is
#     not invariant (the index varies), yet its leading `@g + 0` walk is a
#     link-time constant the back end otherwise rematerializes every iteration (an
#     `lea` of the symbol before the indexed `lea`). The invariant leading index
#     prefix is split into its own preheader gep and the body gep is rebased onto
#     it, so the symbol address is materialized once. The split is exact: the
#     prefix gep replays the original walk's first k index steps from the same
#     source pointee, and the body gep restarts from the type that walk descended
#     into. Only a global base is split -- every other base is already a register
#     or a frame slot the addressing mode folds, so splitting it would cost a
#     preheader instruction and save nothing.
#
# SAFETY CONDITION. The preheader executes whenever the loop is REACHED, including
# when the loop then trips zero times, so hoisting is legal only for a computation
# that is safe to execute speculatively:
#
#   1. The loop has a DEDICATED preheader (`Loop.preheader != BLOCK_NIL`): a block
#      whose sole successor is the header. Anything placed there runs exactly once
#      per loop entry and on no other path.
#   2. Every operand is loop-invariant, so the value computed is the same one the
#      body computed. Invariance also implies each operand's definition dominates
#      the preheader, so the relocated instruction is still in SSA form.
#   3. The opcode is pure (`instruction.is_pure`: no store, call, alloca, inline
#      asm, memzero, phi, or terminator) and cannot fault. Division and remainder
#      are excluded -- a zero or INT_MIN/-1 divisor traps, and a loop that trips
#      zero times must not fault because work was hoisted out of it. Integer and
#      float arithmetic, comparisons, casts, geps, extract/insert and declassify
#      cannot fault and are hoisted. Poison-generating flags (nsw/nuw/exact) are
#      preserved rather than dropped: every USE of the hoisted value stays inside
#      the loop, so a poison value is consumed exactly where it was before.
#   4. A LOAD additionally requires that its address is UNCONDITIONALLY
#      DEREFERENCEABLE and that nothing in the loop can write it:
#        a. the address resolves, through gep / bitcast steps with only constant
#           indices, to a module-scope global at a compile-time byte offset, and
#           that offset plus the loaded type's size lies inside the global's own
#           storage. A module-scope object is mapped for the process lifetime, so
#           the load cannot trap however many times the loop trips.
#        b. the loop body contains no call and no inline asm (either may write any
#           memory), and no store or memzero whose pointer may alias that global.
#           Aliasing is decided on the pointer's root: a different named global or
#           an alloca (a distinct stack object) cannot alias it; anything else --
#           a parameter, a loaded pointer, a phi -- may, and declines the hoist.
#   5. Volatile loads and stores are never moved.
#
# The pass runs in the release pipeline only, so debug output is unchanged. It is
# safe inside an `#[oblivious]` function: every decision is made from the static IR
# shape and never from a runtime value, no control flow is introduced, nothing is
# eliminated, and a hoisted load's address is a link-time constant carrying no
# secret -- so the constant-time contract (#1646) is preserved.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use std.system.panic.panic;

use A: std.allocator;
use O: std.types.option;
use R: std.types.result;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.target;
use loops: mach.lang.me.analysis.loops;
use dep: mach.lang.me.analysis.dependence;

# hoist loop-invariant work out of every loop in every function of `m`
#
# Never changes the CFG: instructions are relocated between existing blocks and at
# most one gep per split is added, so the loop analysis computed once per function
# stays valid for the whole function (each move is reported through
# `loops.set_instr_block`). Loops are processed innermost-first, so a value lifted
# out of an inner loop is a candidate for the enclosing one in the same pass.
# ---
# m:   the module to transform in place
# tgt: the target, supplying the pointer width the object-size proofs need
# ret: ok(true) if anything moved, ok(false) if nothing did, or an allocation error
pub fun run(m: *ir.Module, tgt: *target.Target) R.Result[bool, str] {
    var changed: bool = false;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if (fn.block_count == 0 || (fn.flags & ir.FN_FLAG_EXTERN) != 0) { fi = fi + 1; cnt; }
        val rf: R.Result[bool, str] = licm_function(m, fn, tgt);
        if (R.is_err[bool, str](rf)) { ret rf; }
        if (R.unwrap_ok[bool, str](rf)) { changed = true; }
        fi = fi + 1;
    }
    ret R.ok[bool, str](changed);
}

# hoist out of one function's loops
# ---
# m:   module owning the allocator
# fn:  the function to transform in place
# tgt: the target
# ret: ok(true) if anything moved, or an allocation error
fun licm_function(m: *ir.Module, fn: *ir.Function, tgt: *target.Target) R.Result[bool, str] {
    val ral: R.Result[loops.LoopAnalysis, str] = loops.analyze(fn, m.alloc);
    if (R.is_err[loops.LoopAnalysis, str](ral)) { ret R.err[bool, str](R.unwrap_err[loops.LoopAnalysis, str](ral)); }
    var la: loops.LoopAnalysis = R.unwrap_ok[loops.LoopAnalysis, str](ral);
    if (la.loop_len == 0) { loops.dnit(?la); ret R.ok[bool, str](false); }

    val n: u32 = la.loop_len;
    val ro: R.Result[*u32, str] = A.allocate[u32](m.alloc, n::usize);
    if (R.is_err[*u32, str](ro)) { loops.dnit(?la); ret R.err[bool, str](R.unwrap_err[*u32, str](ro)); }
    val order: *u32 = R.unwrap_ok[*u32, str](ro);
    order_innermost_first(?la, order);

    var changed: bool = false;
    var oi: u32 = 0;
    for (oi < n) {
        val rl: R.Result[bool, str] = licm_loop(m, fn, ?la, order[oi], tgt);
        if (R.is_err[bool, str](rl)) {
            A.deallocate[u32](m.alloc, order, n::usize);
            loops.dnit(?la);
            ret rl;
        }
        if (R.unwrap_ok[bool, str](rl)) { changed = true; }
        oi = oi + 1;
    }

    A.deallocate[u32](m.alloc, order, n::usize);
    loops.dnit(?la);
    ret R.ok[bool, str](changed);
}

# fill `order` with loop indices sorted by descending nesting depth
#
# A selection sort taking the FIRST maximum, so equal-depth loops keep their
# analysis order and the pass is deterministic. Innermost-first matters: an
# instruction lifted into an inner loop's preheader sits in the enclosing loop's
# body, where the enclosing loop's turn can lift it again.
# ---
# la:    the analysis
# order: receives `la.loop_len` loop indices, deepest first
fun order_innermost_first(la: *loops.LoopAnalysis, order: *u32) {
    var i: u32 = 0;
    for (i < la.loop_len) { order[i] = i; i = i + 1; }

    var a: u32 = 0;
    for (a < la.loop_len) {
        var best: u32 = a;
        var b: u32 = a + 1;
        for (b < la.loop_len) {
            if (la.loops[order[b]].depth > la.loops[order[best]].depth) { best = b; }
            b = b + 1;
        }
        val t: u32 = order[a];
        order[a]    = order[best];
        order[best] = t;
        a = a + 1;
    }
}

# hoist out of one loop
#
# Body blocks are walked in reverse postorder and their instructions in program
# order, so a definition is always visited before its uses: a chain of invariant
# computations lifts in one sweep. A hoisted instruction is dropped from the body
# block's list (compacted in place through `w`) and appended to the preheader,
# which sits before the preheader's terminator because a block's terminator is not
# part of its instruction list.
# ---
# m:   module owning the allocator
# fn:  the function
# la:  the loop analysis, kept in step with every move
# lx:  index into la.loops
# tgt: the target
# ret: ok(true) if anything moved, or an allocation error
fun licm_loop(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, tgt: *target.Target) R.Result[bool, str] {
    val lp: *loops.Loop = ?la.loops[lx];
    val pre_id: id.BlockId = lp.preheader;
    if (pre_id == id.BLOCK_NIL) { ret R.ok[bool, str](false); }

    val opaque: bool = loop_has_opaque_effect(fn, la, lx);

    var changed: bool = false;
    var ri: u32 = 0;
    for (ri < la.rpo_len) {
        val b: id.BlockId = la.rpo[ri];
        ri = ri + 1;
        if (!loops.loop_contains(la, lx, b)) { cnt; }

        val blk: *ir.Block = ?fn.blocks[b::u32];
        var w: u32 = 0;
        var k: u32 = 0;
        for (k < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[k];
            k = k + 1;

            if (hoistable(m, fn, la, lx, tgt, iid, opaque)) {
                val rp: R.Result[bool, str] = ir.block_append_instr(m, ?fn.blocks[pre_id::u32], iid);
                if (R.is_err[bool, str](rp)) { ret rp; }
                val rs: R.Result[bool, str] = loops.set_instr_block(la, iid, pre_id);
                if (R.is_err[bool, str](rs)) { ret rs; }
                changed = true;
                cnt;
            }

            val rg: R.Result[bool, str] = split_invariant_gep_prefix(m, fn, la, lx, iid, pre_id);
            if (R.is_err[bool, str](rg)) { ret rg; }
            if (R.unwrap_ok[bool, str](rg)) { changed = true; }

            blk.instructions[w] = iid;
            w = w + 1;
        }
        blk.instr_count = w;
    }
    ret R.ok[bool, str](changed);
}

# true when instruction `iid` may be relocated to the loop's preheader
#
# The safety condition stated in the module header, in one place. `opaque` is the
# loop's precomputed "contains a call or inline asm" fact, which alone disqualifies
# every load in it.
# ---
# m:      the module
# fn:     the function
# la:     the loop analysis
# lx:     index into la.loops
# tgt:    the target
# iid:    candidate instruction
# opaque: true when the loop body contains a call or inline asm
# ret:    true when the instruction is invariant AND safe to execute speculatively
fun hoistable(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, tgt: *target.Target,
              iid: id.InstructionId, opaque: bool) bool {
    if (iid::u32 >= fn.instr_len) { ret false; }
    val k: instruction.InstrKind = fn.instrs[iid::u32].kind;

    if (instruction.is_terminator(k))                                     { ret false; }
    if (k == instruction.OP_PHI)                                          { ret false; }
    if ((fn.instrs[iid::u32].flags & instruction.INSTR_FLAG_VOLATILE) != 0) { ret false; }
    if (!operands_invariant(la, lx, ?fn.instrs[iid::u32]))                { ret false; }

    if (k == instruction.OP_LOAD) {
        if (opaque) { ret false; }
        ret load_is_speculable(m, fn, la, lx, tgt, iid);
    }

    if (!instruction.is_pure(k)) { ret false; }
    # a faulting divisor must keep the loop's control dependence: a zero-trip loop
    # must not raise a division fault because the divide was lifted above the test.
    if (k == instruction.OP_DIV_S || k == instruction.OP_DIV_U) { ret false; }
    if (k == instruction.OP_REM_S || k == instruction.OP_REM_U) { ret false; }
    if (k == instruction.OP_GEP) { ret gep_is_worth_hoisting(fn, iid); }
    ret true;
}

# true when hoisting a wholly-invariant gep buys more than it costs
#
# An address the back end folds ENTIRELY into its users' addressing modes costs
# nothing where it is, so hoisting it only materializes a real `lea` and pins a
# register across the whole loop -- a straight loss under any pressure. That is
# exactly a gep whose indices are all constants over a base that is already a
# register or a frame slot: every index collapses into the user's displacement.
#
# The two shapes the addressing mode cannot absorb are worth lifting:
#   - a GLOBAL base, whose symbol address has to be materialized into a register
#     before an index can be scaled against it;
#   - a RUNTIME index, which has to be scaled into a register rather than folded
#     as a constant displacement.
#
# This is the same profitability rule the prefix split applies, stated once for a
# whole gep. It is a cost judgement, never a safety one -- a gep cannot fault, so
# declining here only forgoes a win.
# ---
# fn:  the function
# iid: the wholly-invariant gep
# ret: true when the back end cannot absorb the address into its users
fun gep_is_worth_hoisting(fn: *ir.Function, iid: id.InstructionId) bool {
    if (fn.instrs[iid::u32].operand_count == 0) { ret false; }
    if (fn.instrs[iid::u32].operands[0].kind == value.VAL_GLOBAL) { ret true; }

    var i: u32 = 1;
    for (i < fn.instrs[iid::u32].operand_count) {
        if (fn.instrs[iid::u32].operands[i].kind != value.VAL_CONST_INT) { ret true; }
        i = i + 1;
    }
    ret false;
}

# true when every operand of `ins` is invariant across loop `lx`
# ---
# la:  the loop analysis
# lx:  index into la.loops
# ins: the instruction
# ret: true when no operand changes across iterations
fun operands_invariant(la: *loops.LoopAnalysis, lx: u32, ins: *instruction.Instruction) bool {
    var i: u32 = 0;
    for (i < ins.operand_count) {
        if (!loops.is_invariant(la, lx, ins.operands[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# true when the loop body contains a call or inline asm
#
# Either may read and write any memory, which makes no load in the loop provably
# invariant and no global provably unwritten.
# ---
# fn: the function
# la: the loop analysis
# lx: index into la.loops
# ret: true when an opaque memory effect is present
fun loop_has_opaque_effect(fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32) bool {
    val lp: *loops.Loop = ?la.loops[lx];
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var k: u32 = 0;
        for (k < blk.instr_count) {
            val ik: instruction.InstrKind = fn.instrs[blk.instructions[k]::u32].kind;
            if (ik == instruction.OP_CALL || ik == instruction.OP_ASM) { ret true; }
            k = k + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

# true when load `iid` may be executed unconditionally in the preheader
#
# Proves the address is a compile-time offset into a module-scope global whose
# storage covers the loaded type, then that no write in the loop can reach it.
# ---
# m:   the module
# fn:  the function
# la:  the loop analysis
# lx:  index into la.loops
# tgt: the target, supplying the sizes the containment proof needs
# iid: the load instruction
# ret: true when the load is both trap-free and unwritten across the loop
fun load_is_speculable(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32,
                       tgt: *target.Target, iid: id.InstructionId) bool {
    if (fn.instrs[iid::u32].operand_count < 1) { ret false; }

    var gix: u32 = 0;
    var off: u64 = 0;
    if (!global_const_address(m, fn, tgt, fn.instrs[iid::u32].operands[0], ?gix, ?off)) { ret false; }

    # both sizes are part of the containment proof, so an untyped load or global
    # simply leaves it unproven.
    val lty: ir_type.IrTypeId = fn.instrs[iid::u32].ty;
    val gty: ir_type.IrTypeId = m.globals[gix].ty;
    if (lty == ir_type.IRT_NIL || gty == ir_type.IRT_NIL) { ret false; }

    # the accessed bytes must lie inside the global's own storage. computed without
    # overflow so a wrapped (negative) constant index can never appear in range.
    val gsz: u64 = ir_type.byte_size(?m.types, gty, tgt)::u64;
    val lsz: u64 = ir_type.byte_size(?m.types, lty, tgt)::u64;
    if (lsz == 0)        { ret false; }
    if (off > gsz)       { ret false; }
    if (lsz > gsz - off) { ret false; }

    ret !loop_may_write_global(m, fn, la, lx, gix);
}

# resolve `p` to a module-scope global plus a compile-time byte offset
#
# Walks gep and bitcast steps back toward the pointer's root, accumulating each
# gep's constant displacement. Fails (leaving the outputs untouched) as soon as a
# step is not a gep/bitcast, or a gep carries a non-constant index -- the offset
# must be a link-time constant for the containment proof to mean anything.
# ---
# m:       the module
# fn:      the function
# tgt:     the target
# p:       the pointer value to resolve
# out_gix: receives the index into `m.globals`
# out_off: receives the byte offset from the global's base
# ret:     true when the address is a constant offset into a module-scope global
fun global_const_address(m: *ir.Module, fn: *ir.Function, tgt: *target.Target, p: value.Value,
                         out_gix: *u32, out_off: *u64) bool {
    var cur: value.Value = p;
    var off: u64 = 0;
    var steps: u32 = 0;

    for (true) {
        if (cur.kind == value.VAL_GLOBAL) {
            @out_gix = cur.data.global_ix;
            @out_off = off;
            ret cur.data.global_ix < m.global_len;
        }
        if (cur.kind != value.VAL_INSTR) { ret false; }
        val iid: id.InstructionId = cur.data.instr;
        if (iid::u32 >= fn.instr_len) { ret false; }

        val k: instruction.InstrKind = fn.instrs[iid::u32].kind;
        if (k == instruction.OP_BITCAST) {
            if (fn.instrs[iid::u32].operand_count < 1) { ret false; }
            cur = fn.instrs[iid::u32].operands[0];
        } or (k == instruction.OP_GEP) {
            var d: u64 = 0;
            if (!gep_const_disp(m, fn, tgt, iid, ?d)) { ret false; }
            off = off + d;
            cur = fn.instrs[iid::u32].operands[0];
        } or {
            ret false;
        }

        # each step moves to an operand, whose definition dominates this one, so the
        # chain is acyclic in verified SSA and cannot outrun the instruction pool.
        steps = steps + 1;
        if (steps > fn.instr_len) { panic("mach.lang.me.transform.licm: cyclic pointer definition chain\n"); }
    }
    ret false;
}

# the constant byte displacement a gep's index walk contributes
#
# Replays the back end's getelementptr model -- index 0 strides over the source
# pointee, each later index descends one aggregate level -- over constant indices
# only. A non-constant index, a missing source pointee, or a walk off a
# non-aggregate yields false.
# ---
# m:        the module
# fn:       the function
# tgt:      the target
# iid:      the gep instruction
# out_disp: receives the accumulated displacement
# ret:      true when every index is constant and the walk is well-formed
fun gep_const_disp(m: *ir.Module, fn: *ir.Function, tgt: *target.Target, iid: id.InstructionId, out_disp: *u64) bool {
    val count: u32 = fn.instrs[iid::u32].operand_count;
    if (count <= 1) { @out_disp = 0; ret true; }

    var cur: ir_type.IrTypeId = fn.instrs[iid::u32].aux_ty;
    if (cur == ir_type.IRT_NIL) { ret false; }

    var disp: u64 = 0;
    var k: u32 = 1;
    for (k < count) {
        val v: value.Value = fn.instrs[iid::u32].operands[k];
        if (v.kind != value.VAL_CONST_INT) { ret false; }

        if (k == 1) {
            # the first index strides over the source pointee without descending.
            disp = disp + v.data.int_lit * ir_type.byte_size(?m.types, cur, tgt)::u64;
        } or {
            var next: ir_type.IrTypeId = ir_type.IRT_NIL;
            var is_field: bool = false;
            if (!descend_level(m, cur, v, ?next, ?is_field)) { ret false; }
            if (is_field) {
                disp = disp + ir_type.byte_offset(?m.types, cur, v.data.int_lit::u32, tgt)::u64;
            } or {
                disp = disp + v.data.int_lit * ir_type.byte_size(?m.types, next, tgt)::u64;
            }
            cur = next;
        }
        k = k + 1;
    }

    @out_disp = disp;
    ret true;
}

# descend one aggregate level of a gep index walk
#
# An array level continues in the element type and scales the index by its size; a
# struct or union level names a field, so its index must be a constant ordinal and
# it contributes that field's fixed offset. `out_field` distinguishes the two so a
# caller accumulating a displacement picks the right rule. Anything else is not a
# level a gep may walk.
# ---
# m:         the module
# cur:       the aggregate type being descended
# v:         the index value at this level
# out_next:  receives the type one level deeper
# out_field: receives true for a struct / union field level
# ret:       true when the descent is well-formed
fun descend_level(m: *ir.Module, cur: ir_type.IrTypeId, v: value.Value,
                  out_next: *ir_type.IrTypeId, out_field: *bool) bool {
    if (cur == ir_type.IRT_NIL) { ret false; }
    val ct_opt: O.Option[*ir_type.IrType] = ir_type.get(?m.types, cur);
    if (!O.is_some[*ir_type.IrType](ct_opt)) { ret false; }
    val ct: *ir_type.IrType = O.unwrap[*ir_type.IrType](ct_opt);

    if (ct.kind == ir_type.IRT_ARRAY) {
        @out_next  = ct.data.array_.element;
        @out_field = false;
        ret true;
    }

    if (ct.kind == ir_type.IRT_STRUCT || ct.kind == ir_type.IRT_UNION) {
        if (v.kind != value.VAL_CONST_INT)                      { ret false; }
        if (v.data.int_lit >= ct.data.struct_.field_count::u64) { ret false; }
        @out_next  = ct.data.struct_.fields[v.data.int_lit::u32];
        @out_field = true;
        ret true;
    }

    ret false;
}

# true when any write in the loop body may reach global `gix`
#
# Every store and memzero in the body is tested by pointer root: a different named
# global and an alloca are distinct objects that cannot reach it; an unresolved root
# may, and forces the conservative answer.
# ---
# m:   the module
# fn:  the function
# la:  the loop analysis
# lx:  index into la.loops
# gix: index into `m.globals` of the loaded object
# ret: true when a write may alias the global
fun loop_may_write_global(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, gix: u32) bool {
    val lp: *loops.Loop = ?la.loops[lx];
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var k: u32 = 0;
        for (k < blk.instr_count) {
            val wid: id.InstructionId = blk.instructions[k];
            k = k + 1;
            val ik: instruction.InstrKind = fn.instrs[wid::u32].kind;

            var dst: value.Value;
            if (ik == instruction.OP_STORE) {
                if (fn.instrs[wid::u32].operand_count < 2) { ret true; }
                dst = fn.instrs[wid::u32].operands[1];
            } or (ik == instruction.OP_MEMZERO) {
                if (fn.instrs[wid::u32].operand_count < 1) { ret true; }
                dst = fn.instrs[wid::u32].operands[0];
            } or {
                cnt;
            }

            if (may_alias_global(m, fn, dst, gix)) { ret true; }
        }
        bi = bi + 1;
    }
    ret false;
}

# true when writing through `p` may reach global `gix`
# ---
# m:   the module
# fn:  the function
# p:   the written pointer
# gix: index into `m.globals` of the loaded object
# ret: false only when the write provably targets a different object
fun may_alias_global(m: *ir.Module, fn: *ir.Function, p: value.Value, gix: u32) bool {
    val root: value.Value = pointer_root(fn, p);

    if (root.kind == value.VAL_GLOBAL) {
        if (root.data.global_ix == gix)      { ret true; }
        if (root.data.global_ix >= m.global_len) { ret true; }
        # two globals are the same object exactly when they are the same symbol;
        # an unnamed entry cannot be told apart and stays a possible alias.
        val a: intern.StrId = m.globals[root.data.global_ix].name;
        val b: intern.StrId = m.globals[gix].name;
        if (a == intern.STR_NIL || b == intern.STR_NIL) { ret true; }
        ret a == b;
    }

    # a stack slot is a fresh object distinct from every module-scope global.
    if (root.kind == value.VAL_INSTR) {
        val iid: id.InstructionId = root.data.instr;
        if (iid::u32 < fn.instr_len && fn.instrs[iid::u32].kind == instruction.OP_ALLOCA) { ret false; }
    }

    ret true;
}

# walk a pointer back through gep and bitcast steps to its root value
#
# Unlike `global_const_address` this places no constraint on the indices: it answers
# "which object is this derived from", which is all the alias test needs.
# ---
# fn: the function
# p:  the pointer value
# ret: the root value the pointer is derived from
fun pointer_root(fn: *ir.Function, p: value.Value) value.Value {
    var cur: value.Value = p;
    var steps: u32 = 0;
    for (cur.kind == value.VAL_INSTR) {
        val iid: id.InstructionId = cur.data.instr;
        if (iid::u32 >= fn.instr_len) { ret cur; }
        val k: instruction.InstrKind = fn.instrs[iid::u32].kind;
        if (k != instruction.OP_GEP && k != instruction.OP_BITCAST) { ret cur; }
        if (fn.instrs[iid::u32].operand_count < 1) { ret cur; }
        cur = fn.instrs[iid::u32].operands[0];

        steps = steps + 1;
        if (steps > fn.instr_len) { panic("mach.lang.me.transform.licm: cyclic pointer definition chain\n"); }
    }
    ret cur;
}

# split a gep's loop-invariant leading index prefix into the preheader
#
# `gep(@g, i0..in)` whose first k indices are invariant while index k is not becomes
# `gep(gep(@g, i0..i(k-1)), ik..in)`, with the prefix gep materialized once in the
# preheader. The rewrite is exact: the prefix keeps the original source pointee so it
# replays the original walk's first k steps, and the body gep's new source pointee is
# the type that walk descended into at level k, so index k strides over exactly what
# it strode over before. A struct level cannot be the split point -- a field ordinal
# must be constant, hence invariant, hence inside the prefix.
#
# ONLY a module-scope global base is split, and that restriction is a profitability
# rule, not a safety one. An indexed gep off a symbol has no register for the back
# end to scale the index against, so it materializes the symbol address into one
# every iteration; hoisting that materialization is the whole win. Every other base
# is ALREADY a register or a frame slot the addressing mode folds directly, so
# splitting it would add a preheader instruction, lengthen a live range, and save
# nothing in the body.
# ---
# m:      the module
# fn:     the function
# la:     the loop analysis, updated with the new instruction's block
# lx:     index into la.loops
# iid:    the candidate gep
# pre_id: the loop's preheader
# ret:    ok(true) when the gep was split, or an allocation error
fun split_invariant_gep_prefix(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32,
                               iid: id.InstructionId, pre_id: id.BlockId) R.Result[bool, str] {
    if (iid::u32 >= fn.instr_len)                          { ret R.ok[bool, str](false); }
    if (fn.instrs[iid::u32].kind != instruction.OP_GEP)    { ret R.ok[bool, str](false); }
    if (fn.instrs[iid::u32].aux_ty == ir_type.IRT_NIL)     { ret R.ok[bool, str](false); }

    val count: u32 = fn.instrs[iid::u32].operand_count;
    # a base plus at least two indices: one to hoist, one to leave behind.
    if (count < 3) { ret R.ok[bool, str](false); }
    if (fn.instrs[iid::u32].operands[0].kind != value.VAL_GLOBAL) { ret R.ok[bool, str](false); }

    var k: u32 = 0;
    for (k + 1 < count) {
        if (!loops.is_invariant(la, lx, fn.instrs[iid::u32].operands[1 + k])) { brk; }
        k = k + 1;
    }
    # nothing invariant to lift, or everything is (which whole-instruction hoisting
    # already handles, and which would leave the body gep with no index at all).
    if (k == 0 || k == count - 1) { ret R.ok[bool, str](false); }

    var body_src: ir_type.IrTypeId = ir_type.IRT_NIL;
    if (!gep_level_type(m, fn, iid, k, ?body_src)) { ret R.ok[bool, str](false); }

    var prefix: id.InstructionId = find_prefix_gep(fn, ?fn.blocks[pre_id::u32], iid, k);
    if (prefix == id.INSTR_NIL) {
        val rn: R.Result[id.InstructionId, str] = emit_prefix_gep(m, fn, iid, k);
        if (R.is_err[id.InstructionId, str](rn)) { ret R.err[bool, str](R.unwrap_err[id.InstructionId, str](rn)); }
        prefix = R.unwrap_ok[id.InstructionId, str](rn);

        val rp: R.Result[bool, str] = ir.block_append_instr(m, ?fn.blocks[pre_id::u32], prefix);
        if (R.is_err[bool, str](rp)) { ret rp; }
        val rs: R.Result[bool, str] = loops.set_instr_block(la, prefix, pre_id);
        if (R.is_err[bool, str](rs)) { ret rs; }
    }

    # rebase the body gep onto the prefix, keeping only the indices from k on.
    val rest: u32 = count - 1 - k;
    val rb: R.Result[ir.OperandArray, str] = ir.operands_alloc(m, rest + 1);
    if (R.is_err[ir.OperandArray, str](rb)) { ret R.err[bool, str](R.unwrap_err[ir.OperandArray, str](rb)); }
    val arr: ir.OperandArray = R.unwrap_ok[ir.OperandArray, str](rb);

    var pv: value.Value = value.instr(prefix, fn.instrs[prefix::u32].ty);
    pv.secret = fn.instrs[prefix::u32].secret;
    arr.ops[0] = pv;
    var j: u32 = 0;
    for (j < rest) {
        arr.ops[1 + j] = fn.instrs[iid::u32].operands[1 + k + j];
        j = j + 1;
    }

    ir.instr_replace_operands(m, ?fn.instrs[iid::u32], arr);
    fn.instrs[iid::u32].aux_ty = body_src;
    ret R.ok[bool, str](true);
}

# the source pointee the body gep restarts from after `k` hoisted indices
#
# Replays the index walk's descents for levels 1..k and reports the type level k
# descends into, validating that every descended level is a gep-walkable aggregate
# and that a struct level carries a constant ordinal.
# ---
# m:      the module
# fn:     the function
# iid:    the gep instruction
# k:      number of leading indices moving to the prefix
# out_ty: receives the type level k descends into
# ret:    true when the walk is well-formed through level k
fun gep_level_type(m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, k: u32, out_ty: *ir_type.IrTypeId) bool {
    var cur: ir_type.IrTypeId = fn.instrs[iid::u32].aux_ty;
    # level 0 strides over the source pointee without descending, so a walk that
    # only hoists it restarts from that same type.
    if (k == 0) { @out_ty = cur; ret true; }

    var j: u32 = 1;
    for (j <= k) {
        var next: ir_type.IrTypeId = ir_type.IRT_NIL;
        var is_field: bool = false;
        if (!descend_level(m, cur, fn.instrs[iid::u32].operands[1 + j], ?next, ?is_field)) { ret false; }
        cur = next;
        j = j + 1;
    }
    @out_ty = cur;
    ret true;
}

# an identical prefix gep already present in the preheader, or INSTR_NIL
#
# Several arrays indexed in one loop hoist several prefixes; reusing an equal one
# keeps the preheader from accumulating duplicates that later blocks would have to
# carry. Equality is the same structural test local CSE uses: same source pointee,
# same flags, same operand list.
# ---
# fn:  the function
# pre: the preheader block
# iid: the gep being split
# k:   number of leading indices in the prefix
# ret: the matching instruction id, or INSTR_NIL
fun find_prefix_gep(fn: *ir.Function, pre: *ir.Block, iid: id.InstructionId, k: u32) id.InstructionId {
    var i: u32 = 0;
    for (i < pre.instr_count) {
        val cid: id.InstructionId = pre.instructions[i];
        i = i + 1;
        if (fn.instrs[cid::u32].kind != instruction.OP_GEP)                 { cnt; }
        if (fn.instrs[cid::u32].operand_count != k + 1)                     { cnt; }
        if (fn.instrs[cid::u32].aux_ty != fn.instrs[iid::u32].aux_ty)       { cnt; }
        if (fn.instrs[cid::u32].flags  != fn.instrs[iid::u32].flags)        { cnt; }

        var same: bool = true;
        var j: u32 = 0;
        for (j < k + 1) {
            if (!dep.equal(fn.instrs[cid::u32].operands[j], fn.instrs[iid::u32].operands[j])) { same = false; brk; }
            j = j + 1;
        }
        if (same) { ret cid; }
    }
    ret id.INSTR_NIL;
}

# build the preheader gep carrying `iid`'s base and first `k` indices
# ---
# m:   the module
# fn:  the function
# iid: the gep being split
# k:   number of leading indices in the prefix
# ret: the new instruction's id, or an allocation error
fun emit_prefix_gep(m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, k: u32) R.Result[id.InstructionId, str] {
    val ra: R.Result[*value.Value, str] = A.allocate[value.Value](m.alloc, (k + 1)::usize);
    if (R.is_err[*value.Value, str](ra)) { ret R.err[id.InstructionId, str](R.unwrap_err[*value.Value, str](ra)); }
    val ops: *value.Value = R.unwrap_ok[*value.Value, str](ra);

    var j: u32 = 0;
    for (j < k + 1) {
        ops[j] = fn.instrs[iid::u32].operands[j];
        j = j + 1;
    }

    var ni: instruction.Instruction;
    ni.kind          = instruction.OP_GEP;
    ni.ty            = fn.instrs[iid::u32].ty;
    ni.operands      = ops;
    ni.operand_count = k + 1;
    ni.operand_cap   = k + 1;
    ni.flags         = fn.instrs[iid::u32].flags;
    ni.aux_ty        = fn.instrs[iid::u32].aux_ty;
    ni.loc           = fn.instrs[iid::u32].loc;
    # the split address derives from the original, so it inherits its taint
    # monotonically rather than being re-derived downward (#1646).
    ni.secret        = fn.instrs[iid::u32].secret;

    val ri: R.Result[id.InstructionId, str] = ir.instruction_add(m, fn, ni);
    if (R.is_err[id.InstructionId, str](ri)) { A.deallocate[value.Value](m.alloc, ops, (k + 1)::usize); }
    ret ri;
}

use std.allocator.page;
use mach.lang.me.ir.builder;
use mach.lang.target.resolved;

# the x86_64-linux target the tests size objects against
fun mk_target(o: *resolved.Target) i32 {
    var reg: target.TargetRegistry = target.registry_init();
    if (R.is_err[bool, str](target.register_all(?reg))) { ret 1; }
    val tr: R.Result[resolved.Target, str] = target.select(?reg, "x86_64", "linux", "sysv64");
    if (R.is_err[resolved.Target, str](tr)) { ret 1; }
    @o = R.unwrap_ok[resolved.Target, str](tr);
    ret 0;
}

# append a named mutable module-scope global of storage type `ty`, yielding a
# VAL_GLOBAL pointer to it
fun mk_global(m: *ir.Module, itn: *intern.Interner, tag: str, ty: ir_type.IrTypeId,
              ptrt: ir_type.IrTypeId, o_val: *value.Value) i32 {
    val rn: R.Result[intern.StrId, str] = intern.intern(itn, tag);
    if (R.is_err[intern.StrId, str](rn)) { ret 1; }

    if (m.global_len == m.global_cap) {
        val cap: u32 = m.global_cap * 2 + 4;
        val rg: R.Result[*ir.Global, str] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, cap::usize);
        if (R.is_err[*ir.Global, str](rg)) { ret 1; }
        m.globals    = R.unwrap_ok[*ir.Global, str](rg);
        m.global_cap = cap;
    }

    val idx: u32 = m.global_len;
    var g: ir.Global;
    g.name      = R.unwrap_ok[intern.StrId, str](rn);
    g.ty        = ty;
    g.init      = value.const_int(0, ty);
    g.is_mut    = true;
    g.is_pub    = false;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = false;
    g.align     = 0;
    g.section   = intern.STR_NIL;
    m.globals[idx] = g;
    m.global_len   = idx + 1;

    @o_val = value.global(idx, ptrt);
    ret 0;
}

# build `entry -> header -> body -> exit` with an i64 induction variable `{0, +, 1}`
# tested `iv < param0`, leaving the builder positioned in the body for the caller to
# fill and close with `close_loop`. Returns 0 on success.
fun mk_loop(m: *ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId,
            o_entry: *id.BlockId, o_header: *id.BlockId, o_body: *id.BlockId, o_exit: *id.BlockId,
            o_iv: *value.Value) i32 {
    val re: R.Result[id.BlockId, str] = builder.new_block(bld);
    if (R.is_err[id.BlockId, str](re)) { ret 1; }
    val entry: id.BlockId = R.unwrap_ok[id.BlockId, str](re);
    val rh: R.Result[id.BlockId, str] = builder.new_block(bld);
    if (R.is_err[id.BlockId, str](rh)) { ret 1; }
    val header: id.BlockId = R.unwrap_ok[id.BlockId, str](rh);
    val rb: R.Result[id.BlockId, str] = builder.new_block(bld);
    if (R.is_err[id.BlockId, str](rb)) { ret 1; }
    val body: id.BlockId = R.unwrap_ok[id.BlockId, str](rb);
    val rx: R.Result[id.BlockId, str] = builder.new_block(bld);
    if (R.is_err[id.BlockId, str](rx)) { ret 1; }
    val exit: id.BlockId = R.unwrap_ok[id.BlockId, str](rx);

    builder.set_block(bld, entry);
    if (R.is_err[bool, str](builder.emit_br(bld, header))) { ret 1; }

    builder.set_block(bld, header);
    val rphi: R.Result[value.Value, str] = builder.emit_phi(bld, i64t);
    if (R.is_err[value.Value, str](rphi)) { ret 1; }
    val iv: value.Value = R.unwrap_ok[value.Value, str](rphi);
    val rc: R.Result[value.Value, str] = builder.emit_cmp_lt_s(bld, iv, value.param(0, i64t));
    if (R.is_err[value.Value, str](rc)) { ret 1; }
    if (R.is_err[bool, str](builder.emit_cbr(bld, R.unwrap_ok[value.Value, str](rc), body, exit))) { ret 1; }

    builder.set_block(bld, exit);
    if (R.is_err[bool, str](builder.emit_ret_void(bld))) { ret 1; }

    if (R.is_err[bool, str](builder.phi_add_incoming(bld, iv, entry, value.const_int(0, i64t)))) { ret 1; }

    @o_entry = entry; @o_header = header; @o_body = body; @o_exit = exit; @o_iv = iv;
    builder.set_block(bld, body);
    ret 0;
}

# close a body opened by `mk_loop`: step the induction variable, branch back to the
# header, and wire the latch incoming. Returns 0 on success.
fun close_loop(bld: *builder.Builder, i64t: ir_type.IrTypeId, iv: value.Value,
               header: id.BlockId, body: id.BlockId) i32 {
    val ru: R.Result[value.Value, str] = builder.emit_add(bld, iv, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](ru)) { ret 1; }
    if (R.is_err[bool, str](builder.emit_br(bld, header))) { ret 1; }
    if (R.is_err[bool, str](builder.phi_add_incoming(bld, iv, body, R.unwrap_ok[value.Value, str](ru)))) { ret 1; }
    ret 0;
}

# true when block `b` holds instruction `iid`
fun block_holds(fn: *ir.Function, b: id.BlockId, iid: id.InstructionId) bool {
    val blk: *ir.Block = ?fn.blocks[b::u32];
    var i: u32 = 0;
    for (i < blk.instr_count) {
        if (blk.instructions[i] == iid) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a load of a module-scope global that nothing in the loop writes is invariant and
# unconditionally dereferenceable, so it moves to the preheader -- the `val` bound
# reloaded every iteration in #2204. The add that consumes the induction variable
# stays put.
test "mach.lang.me.transform.licm:hoists_invariant_global_load" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);

    var g: value.Value;
    if (mk_global(?m, ?itn, "g_bound", i64t, ptrt, ?g) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rl: R.Result[value.Value, str] = builder.emit_load(?bld, g, i64t);
    if (R.is_err[value.Value, str](rl)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ld: value.Value = R.unwrap_ok[value.Value, str](rl);
    val rs: R.Result[value.Value, str] = builder.emit_add(?bld, iv, ld);
    if (R.is_err[value.Value, str](rs)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val sum: value.Value = R.unwrap_ok[value.Value, str](rs);
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    val rr: R.Result[bool, str] = run(?m, ?tgt);
    if (R.is_err[bool, str](rr))          { code = 1; }
    or { if (!R.unwrap_ok[bool, str](rr)) { code = 1; } }

    if (!block_holds(fn, entry, ld.data.instr)) { code = 1; }
    if (block_holds(fn, body, ld.data.instr))   { code = 1; }
    if (!block_holds(fn, body, sum.data.instr)) { code = 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

# a store to the SAME global inside the loop changes the loaded value across
# iterations, so the load must stay: hoisting it would read a stale value. A store
# to a DIFFERENT named global is a distinct object and does not block the hoist.
test "mach.lang.me.transform.licm:aliasing_store_blocks_load_hoist" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    var pass: u32 = 0;
    # pass 0 writes the loaded global, pass 1 writes an unrelated one.
    for (pass < 2) {
        val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
        if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
        var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

        val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
        if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);
        val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
        if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);

        var g: value.Value;
        var other: value.Value;
        if (mk_global(?m, ?itn, "g_read", i64t, ptrt, ?g) != 0)      { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        if (mk_global(?m, ?itn, "g_other", i64t, ptrt, ?other) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

        val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
        if (R.is_err[u32, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
        var bld: builder.Builder = builder.init(?m);
        builder.set_function(?bld, fn);

        var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
        var iv: value.Value;
        if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

        val rl: R.Result[value.Value, str] = builder.emit_load(?bld, g, i64t);
        if (R.is_err[value.Value, str](rl)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val ld: value.Value = R.unwrap_ok[value.Value, str](rl);
        var dst: value.Value = g;
        if (pass == 1) { dst = other; }
        if (R.is_err[bool, str](builder.emit_store(?bld, iv, dst))) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

        if (R.is_err[bool, str](run(?m, ?tgt))) { code = 1; }

        if (pass == 0) {
            if (!block_holds(fn, body, ld.data.instr)) { code = 1; }
            if (block_holds(fn, entry, ld.data.instr)) { code = 1; }
        } or {
            if (!block_holds(fn, entry, ld.data.instr)) { code = 1; }
            if (block_holds(fn, body, ld.data.instr))   { code = 1; }
        }

        ir.dnit(?m);
        pass = pass + 1;
    }

    intern.dnit(?itn);
    ret code;
}

# a call in the loop may write any memory, so no load in that loop is provably
# invariant. The pure invariant multiply beside it still hoists, so the declined
# load is the load rule speaking and not an inert pass.
test "mach.lang.me.transform.licm:call_blocks_load_hoist" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    val rv: R.Result[ir_type.IrTypeId, str] = ir_type.intern_void(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rv)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val voidt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rv);

    var g: value.Value;
    if (mk_global(?m, ?itn, "g_called", i64t, ptrt, ?g) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rcal: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, ir.FN_FLAG_EXTERN);
    if (R.is_err[u32, str](rcal)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val callee: value.Value = value.fn(R.unwrap_ok[u32, str](rcal), ptrt);

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rl: R.Result[value.Value, str] = builder.emit_load(?bld, g, i64t);
    if (R.is_err[value.Value, str](rl)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ld: value.Value = R.unwrap_ok[value.Value, str](rl);
    val rmul: R.Result[value.Value, str] = builder.emit_mul(?bld, value.param(0, i64t), value.const_int(3, i64t));
    if (R.is_err[value.Value, str](rmul)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val prod: value.Value = R.unwrap_ok[value.Value, str](rmul);
    if (R.is_err[value.Value, str](builder.emit_call(?bld, callee, nil, 0, voidt))) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    if (R.is_err[bool, str](run(?m, ?tgt))) { code = 1; }

    if (!block_holds(fn, body, ld.data.instr))    { code = 1; }
    if (block_holds(fn, entry, ld.data.instr))    { code = 1; }
    if (!block_holds(fn, entry, prod.data.instr)) { code = 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

# a divide and a remainder with wholly invariant operands are NOT hoisted: the
# preheader runs even when the loop trips zero times, and a zero divisor there
# would fault on a path the program never took. The multiply beside them IS
# hoisted, so the decline is the fault rule and not an inert pass.
test "mach.lang.me.transform.licm:divide_is_not_speculated" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    val p0: value.Value = value.param(0, i64t);
    val p1: value.Value = value.param(1, i64t);
    val rd: R.Result[value.Value, str] = builder.emit_div_s(?bld, p0, p1);
    if (R.is_err[value.Value, str](rd)) { ir.dnit(?m); ret 1; }
    val quo: value.Value = R.unwrap_ok[value.Value, str](rd);
    val rr2: R.Result[value.Value, str] = builder.emit_rem_s(?bld, p0, p1);
    if (R.is_err[value.Value, str](rr2)) { ir.dnit(?m); ret 1; }
    val rem: value.Value = R.unwrap_ok[value.Value, str](rr2);
    val rmul: R.Result[value.Value, str] = builder.emit_mul(?bld, p0, p1);
    if (R.is_err[value.Value, str](rmul)) { ir.dnit(?m); ret 1; }
    val prod: value.Value = R.unwrap_ok[value.Value, str](rmul);
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    if (R.is_err[bool, str](run(?m, ?tgt))) { code = 1; }

    if (!block_holds(fn, body, quo.data.instr))   { code = 1; }
    if (!block_holds(fn, body, rem.data.instr))   { code = 1; }
    if (!block_holds(fn, entry, prod.data.instr)) { code = 1; }

    ir.dnit(?m);
    ret code;
}

# a load through a loop-invariant POINTER PARAMETER is not hoisted: its object is
# unknown, so the address is not provably dereferenceable and a zero-trip loop must
# not fault on it. Proving dereferenceability is exactly what admits a global. The
# invariant multiply beside it IS hoisted, so the decline is the dereferenceability
# rule and not an inert pass.
test "mach.lang.me.transform.licm:unknown_pointer_load_is_not_speculated" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    val rl: R.Result[value.Value, str] = builder.emit_load(?bld, value.param(1, ptrt), i64t);
    if (R.is_err[value.Value, str](rl)) { ir.dnit(?m); ret 1; }
    val ld: value.Value = R.unwrap_ok[value.Value, str](rl);
    val rmul: R.Result[value.Value, str] = builder.emit_mul(?bld, value.param(0, i64t), value.const_int(5, i64t));
    if (R.is_err[value.Value, str](rmul)) { ir.dnit(?m); ret 1; }
    val prod: value.Value = R.unwrap_ok[value.Value, str](rmul);
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    if (R.is_err[bool, str](run(?m, ?tgt)))       { code = 1; }
    if (!block_holds(fn, body, ld.data.instr))    { code = 1; }
    if (block_holds(fn, entry, ld.data.instr))    { code = 1; }
    if (!block_holds(fn, entry, prod.data.instr)) { code = 1; }

    ir.dnit(?m);
    ret code;
}

# `gep(@arr, 0, iv)` over a module-scope array is not invariant, but its leading
# `@arr + 0` walk is: the prefix splits into a preheader gep and the body gep is
# rebased onto it with `iv` alone, restarting from the array's element type. This is
# the per-iteration `lea` of the symbol address #2204 measured.
test "mach.lang.me.transform.licm:splits_invariant_gep_prefix" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?m.types, i64t, 16);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val arrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    var arr: value.Value;
    if (mk_global(?m, ?itn, "g_arr", arrt, ptrt, ?arr) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var ix: [2]value.Value;
    ix[0] = value.const_int(0, i64t);
    ix[1] = iv;
    val rg: R.Result[value.Value, str] = builder.emit_gep(?bld, arr, arrt, ?ix[0], 2);
    if (R.is_err[value.Value, str](rg)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val gp: value.Value = R.unwrap_ok[value.Value, str](rg);
    if (R.is_err[bool, str](builder.emit_store(?bld, iv, gp))) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    if (R.is_err[bool, str](run(?m, ?tgt))) { code = 1; }

    if (!block_holds(fn, body, gp.data.instr)) { code = 1; }
    or {
        # the body gep is now a single-index walk over the element type, based on a
        # preheader gep of `@arr, 0`.
        val g: *instruction.Instruction = ?fn.instrs[gp.data.instr::u32];
        if (g.operand_count != 2)                  { code = 1; }
        or {
            if (g.aux_ty != i64t)                  { code = 1; }
            if (!dep.equal(g.operands[1], iv))     { code = 1; }
            if (g.operands[0].kind != value.VAL_INSTR) { code = 1; }
            or {
                val pid: id.InstructionId = g.operands[0].data.instr;
                if (!block_holds(fn, entry, pid))               { code = 1; }
                val p: *instruction.Instruction = ?fn.instrs[pid::u32];
                if (p.kind != instruction.OP_GEP)               { code = 1; }
                if (p.operand_count != 2)                       { code = 1; }
                or {
                    if (p.aux_ty != arrt)                       { code = 1; }
                    if (p.operands[0].kind != value.VAL_GLOBAL) { code = 1; }
                    if (p.operands[1].kind != value.VAL_CONST_INT) { code = 1; }
                    or { if (p.operands[1].data.int_lit != 0)   { code = 1; } }
                }
            }
        }
    }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

# a wholly-invariant gep whose indices are all constants over a pointer PARAMETER
# folds entirely into its users' displacements, so hoisting it would materialize a
# real `lea` and pin a register across the loop for nothing: it stays. The two
# shapes the addressing mode cannot absorb -- a global base and a runtime index --
# are hoisted in the same run, so the decline is the profitability rule and not an
# inert pass.
test "mach.lang.me.transform.licm:absorbed_gep_is_not_hoisted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);
    val rp: R.Result[ir_type.IrTypeId, str] = ir_type.intern_ptr(?m.types);
    if (R.is_err[ir_type.IrTypeId, str](rp)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rp);
    val ra: R.Result[ir_type.IrTypeId, str] = ir_type.intern_array(?m.types, i64t, 16);
    if (R.is_err[ir_type.IrTypeId, str](ra)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val arrt: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](ra);

    var g: value.Value;
    if (mk_global(?m, ?itn, "g_absorb", arrt, ptrt, ?g) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val p1: value.Value = value.param(1, ptrt);
    val k3: value.Value = value.const_int(3, i64t);
    val k0: value.Value = value.const_int(0, i64t);

    # absorbed: constant indices over a pointer parameter.
    var ax: [2]value.Value;
    ax[0] = k0; ax[1] = k3;
    val rg1: R.Result[value.Value, str] = builder.emit_gep(?bld, p1, arrt, ?ax[0], 2);
    if (R.is_err[value.Value, str](rg1)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val absorbed: value.Value = R.unwrap_ok[value.Value, str](rg1);

    # not absorbed: a global base needs its symbol address in a register.
    var bx: [2]value.Value;
    bx[0] = k0; bx[1] = k3;
    val rg2: R.Result[value.Value, str] = builder.emit_gep(?bld, g, arrt, ?bx[0], 2);
    if (R.is_err[value.Value, str](rg2)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val symbased: value.Value = R.unwrap_ok[value.Value, str](rg2);

    # not absorbed: a runtime (parameter) index has to be scaled into a register.
    var cx: [2]value.Value;
    cx[0] = k0; cx[1] = value.param(0, i64t);
    val rg3: R.Result[value.Value, str] = builder.emit_gep(?bld, p1, arrt, ?cx[0], 2);
    if (R.is_err[value.Value, str](rg3)) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val scaled: value.Value = R.unwrap_ok[value.Value, str](rg3);

    if (R.is_err[bool, str](builder.emit_store(?bld, iv, absorbed))) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (R.is_err[bool, str](builder.emit_store(?bld, iv, symbased))) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (R.is_err[bool, str](builder.emit_store(?bld, iv, scaled)))   { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    if (R.is_err[bool, str](run(?m, ?tgt))) { code = 1; }

    if (!block_holds(fn, body, absorbed.data.instr))   { code = 1; }
    if (block_holds(fn, entry, absorbed.data.instr))   { code = 1; }
    if (!block_holds(fn, entry, symbased.data.instr))  { code = 1; }
    if (!block_holds(fn, entry, scaled.data.instr))    { code = 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

# a chain of invariant computations lifts in ONE sweep: `a = p0 + 1` hoists first,
# which makes `b = a * a` invariant in turn, because the reverse-postorder walk sees
# a definition before its uses.
test "mach.lang.me.transform.licm:hoists_dependent_chain_in_one_pass" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    val p0: value.Value = value.param(0, i64t);
    val ra: R.Result[value.Value, str] = builder.emit_add(?bld, p0, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](ra)) { ir.dnit(?m); ret 1; }
    val a: value.Value = R.unwrap_ok[value.Value, str](ra);
    val rb: R.Result[value.Value, str] = builder.emit_mul(?bld, a, a);
    if (R.is_err[value.Value, str](rb)) { ir.dnit(?m); ret 1; }
    val b: value.Value = R.unwrap_ok[value.Value, str](rb);
    val rc: R.Result[value.Value, str] = builder.emit_add(?bld, b, iv);
    if (R.is_err[value.Value, str](rc)) { ir.dnit(?m); ret 1; }
    val c: value.Value = R.unwrap_ok[value.Value, str](rc);
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    if (R.is_err[bool, str](run(?m, ?tgt))) { code = 1; }

    if (!block_holds(fn, entry, a.data.instr)) { code = 1; }
    if (!block_holds(fn, entry, b.data.instr)) { code = 1; }
    # `c` consumes the induction variable, so it must stay.
    if (!block_holds(fn, body, c.data.instr))  { code = 1; }

    ir.dnit(?m);
    ret code;
}

# a loop whose header is entered from TWO out-of-loop predecessors has no dedicated
# preheader: no block runs exactly once per loop entry, so nothing is hoisted even
# though the body's multiply is wholly invariant. A well-formed second loop in the
# same function hoists its own invariant multiply, so the decline is the preheader
# requirement and not an inert pass.
test "mach.lang.me.transform.licm:no_preheader_declines" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var tgt: resolved.Target;
    if (mk_target(?tgt) != 0) { ret 1; }

    val rm: R.Result[ir.Module, str] = ir.init(?alloc, intern.STR_NIL);
    if (R.is_err[ir.Module, str](rm)) { ret 1; }
    var m: ir.Module = R.unwrap_ok[ir.Module, str](rm);

    val rt: R.Result[ir_type.IrTypeId, str] = ir_type.intern_int(?m.types, 64);
    if (R.is_err[ir_type.IrTypeId, str](rt)) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = R.unwrap_ok[ir_type.IrTypeId, str](rt);

    val rf: R.Result[u32, str] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (R.is_err[u32, str](rf)) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[R.unwrap_ok[u32, str](rf)];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    # entry branches to one of two arms, both jumping straight to the header.
    var bids: [5]id.BlockId;
    var i: u32 = 0;
    for (i < 5) {
        val rbk: R.Result[id.BlockId, str] = builder.new_block(?bld);
        if (R.is_err[id.BlockId, str](rbk)) { ir.dnit(?m); ret 1; }
        bids[i] = R.unwrap_ok[id.BlockId, str](rbk);
        i = i + 1;
    }
    val entry:  id.BlockId = bids[0];
    val arm:    id.BlockId = bids[1];
    val header: id.BlockId = bids[2];
    val body:   id.BlockId = bids[3];
    val exit:   id.BlockId = bids[4];

    val p0: value.Value = value.param(0, i64t);

    builder.set_block(?bld, entry);
    val rc0: R.Result[value.Value, str] = builder.emit_cmp_lt_s(?bld, p0, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](rc0)) { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](builder.emit_cbr(?bld, R.unwrap_ok[value.Value, str](rc0), arm, header))) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, arm);
    if (R.is_err[bool, str](builder.emit_br(?bld, header))) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val rphi: R.Result[value.Value, str] = builder.emit_phi(?bld, i64t);
    if (R.is_err[value.Value, str](rphi)) { ir.dnit(?m); ret 1; }
    val iv: value.Value = R.unwrap_ok[value.Value, str](rphi);
    val rc1: R.Result[value.Value, str] = builder.emit_cmp_lt_s(?bld, iv, p0);
    if (R.is_err[value.Value, str](rc1)) { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](builder.emit_cbr(?bld, R.unwrap_ok[value.Value, str](rc1), body, exit))) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, body);
    val rmul: R.Result[value.Value, str] = builder.emit_mul(?bld, p0, value.const_int(7, i64t));
    if (R.is_err[value.Value, str](rmul)) { ir.dnit(?m); ret 1; }
    val prod: value.Value = R.unwrap_ok[value.Value, str](rmul);
    val ru: R.Result[value.Value, str] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (R.is_err[value.Value, str](ru)) { ir.dnit(?m); ret 1; }
    val upd: value.Value = R.unwrap_ok[value.Value, str](ru);
    if (R.is_err[bool, str](builder.emit_br(?bld, header))) { ir.dnit(?m); ret 1; }

    val z: value.Value = value.const_int(0, i64t);
    if (R.is_err[bool, str](builder.phi_add_incoming(?bld, iv, entry, z)))  { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](builder.phi_add_incoming(?bld, iv, arm, z)))    { ir.dnit(?m); ret 1; }
    if (R.is_err[bool, str](builder.phi_add_incoming(?bld, iv, body, upd))) { ir.dnit(?m); ret 1; }

    # the control loop: a second, well-formed loop this one's exit falls into.
    var pre2: id.BlockId; var head2: id.BlockId; var body2: id.BlockId; var exit2: id.BlockId;
    var iv2: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?pre2, ?head2, ?body2, ?exit2, ?iv2) != 0) { ir.dnit(?m); ret 1; }
    val rm2: R.Result[value.Value, str] = builder.emit_mul(?bld, p0, value.const_int(9, i64t));
    if (R.is_err[value.Value, str](rm2)) { ir.dnit(?m); ret 1; }
    val prod2: value.Value = R.unwrap_ok[value.Value, str](rm2);
    if (close_loop(?bld, i64t, iv2, head2, body2) != 0) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, exit);
    if (R.is_err[bool, str](builder.emit_br(?bld, pre2))) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val rr: R.Result[bool, str] = run(?m, ?tgt);
    if (R.is_err[bool, str](rr))          { code = 1; }
    or { if (!R.unwrap_ok[bool, str](rr)) { code = 1; } }
    if (!block_holds(fn, body, prod.data.instr))   { code = 1; }
    if (!block_holds(fn, pre2, prod2.data.instr))  { code = 1; }

    ir.dnit(?m);
    ret code;
}
