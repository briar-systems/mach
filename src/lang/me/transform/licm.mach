use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use std.system.panic.panic;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.me.analysis.loops;
use dep: mach.lang.me.analysis.dependence;

rec FunctionWork {
    module: *ir.Module;
    body: *ir.Function;
    target: *target.Target;
}

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module, tgt: *target.Target) res[bool, fail.Fail] {
    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, tgt, ?workspace);
}

pub fun run_in(m: *ir.Module, tgt: *target.Target, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if (fn.block_count == 0 || (fn.flags & ir.FN_FLAG_EXTERN) != 0) { fi = fi + 1; cnt; }
        var work: FunctionWork = FunctionWork{module: m, body: fn, target: tgt};
        val changed_r: res[bool, fail.Fail] = scratch.run[FunctionWork, bool](workspace, m.alloc, ?work, licm_function);
        if (sel changed_r.err) { ret changed_r; }
        if (changed_r.ok) { changed = true; }
        fi = fi + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun licm_function(work: *FunctionWork, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = work.module;
    val fn: *ir.Function = work.body;
    val tgt: *target.Target = work.target;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, alloc);
    if (sel ral.err) { ret res[bool, fail.Fail].err{ral.err}; }
    var la: loops.LoopAnalysis = ral.ok;
    if (la.loop_len == 0) { loops.dnit(?la); ret res[bool, fail.Fail].ok{false}; }

    val n: u32 = la.loop_len;
    val ro: res[*u32, A.Error] = A.allocate[u32](alloc, n::usize);
    if (sel ro.err) { loops.dnit(?la); ret res[bool, fail.Fail].err{fail.refused(ro.err)}; }
    val order: *u32 = ro.ok;
    order_innermost_first(?la, order);

    var changed: bool = false;
    var oi: u32 = 0;
    for (oi < n) {
        val loop_changed_r: res[bool, fail.Fail] = licm_loop(m, fn, ?la, order[oi], tgt);
        if (sel loop_changed_r.err) {
            A.deallocate[u32](alloc, order, n::usize);
            loops.dnit(?la);
            ret loop_changed_r;
        }
        if (loop_changed_r.ok) { changed = true; }
        oi = oi + 1;
    }

    A.deallocate[u32](alloc, order, n::usize);
    loops.dnit(?la);
    ret res[bool, fail.Fail].ok{changed};
}

fun order_innermost_first(la: *loops.LoopAnalysis, order: *u32) {
    var i: u32 = 0;
    for (i < la.loop_len) { order[i] = i; i = i + 1; }

    var a: u32 = 0;
    for (a < la.loop_len) {
        var best: u32 = a;
        var b: u32 = a + 1;
        for (b < la.loop_len) {
            if (la.loops[order[b]].depth > la.loops[order[best]].depth) { best = b; }
            b = b + 1;
        }
        val t: u32 = order[a];
        order[a]    = order[best];
        order[best] = t;
        a = a + 1;
    }
}

fun licm_loop(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, tgt: *target.Target) res[bool, fail.Fail] {
    val lp: *loops.Loop = ?la.loops[lx];
    val pre_id: id.BlockId = lp.preheader;
    if (pre_id == id.BLOCK_NIL) { ret res[bool, fail.Fail].ok{false}; }

    val opaque: bool = loop_has_opaque_effect(fn, la, lx);

    var changed: bool = false;
    var ri: u32 = 0;
    for (ri < la.rpo_len) {
        val b: id.BlockId = la.rpo[ri];
        ri = ri + 1;
        if (!loops.loop_contains(la, lx, b)) { cnt; }

        val blk: *ir.Block = ?fn.blocks[b::u32];
        var w: u32 = 0;
        var k: u32 = 0;
        for (k < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[k];
            k = k + 1;

            if (hoistable(m, fn, la, lx, tgt, iid, opaque)) {
                val rp: err[fail.Fail] = ir.block_append_instr(m, ?fn.blocks[pre_id::u32], iid);
                if (sel rp.err) {
                    blk.instructions[w] = iid;
                    keep_rest(blk, w + 1, k);
                    ret res[bool, fail.Fail].err{rp.err};
                }
                val rs: err[fail.Fail] = loops.set_instr_block(la, iid, pre_id);
                if (sel rs.err) { keep_rest(blk, w, k); ret res[bool, fail.Fail].err{rs.err}; }
                changed = true;
                cnt;
            }

            val split_r: res[bool, fail.Fail] = split_invariant_gep_prefix(m, fn, la, lx, iid, pre_id);
            if (sel split_r.err) {
                blk.instructions[w] = iid;
                keep_rest(blk, w + 1, k);
                ret split_r;
            }
            if (split_r.ok) { changed = true; }

            blk.instructions[w] = iid;
            w = w + 1;
        }
        blk.instr_count = w;
    }
    ret res[bool, fail.Fail].ok{changed};
}

# a refusal mid-block finishes the compaction the hoist loop was doing, so
# the block lists each instruction once whether it was hoisted or kept
fun keep_rest(blk: *ir.Block, w: u32, k: u32) {
    var to: u32 = w;
    var from: u32 = k;
    for (from < blk.instr_count) {
        blk.instructions[to] = blk.instructions[from];
        to = to + 1;
        from = from + 1;
    }
    blk.instr_count = to;
}

fun hoistable(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, tgt: *target.Target,
              iid: id.InstructionId, opaque: bool) bool {
    if (iid::u32 >= fn.instr_len) { ret false; }
    val k: instruction.InstrKind = fn.instrs[iid::u32].kind;

    if (opdesc.is_terminator(k))                                          { ret false; }
    if (k == instruction.OP_PHI)                                          { ret false; }
    if (effect.is_volatile(?fn.instrs[iid::u32]))                           { ret false; }
    if (!operands_invariant(la, lx, ?fn.instrs[iid::u32]))                { ret false; }

    if (k == instruction.OP_LOAD) {
        if (opaque) { ret false; }
        ret load_is_speculable(m, fn, la, lx, tgt, iid);
    }

    if (!effect.movable(?fn.instrs[iid::u32]))      { ret false; }
    if (!effect.speculatable(?fn.instrs[iid::u32])) { ret false; }
    if (k == instruction.OP_GEP) { ret gep_is_worth_hoisting(fn, iid); }
    ret true;
}

fun gep_is_worth_hoisting(fn: *ir.Function, iid: id.InstructionId) bool {
    if (fn.instrs[iid::u32].operand_count == 0) { ret false; }
    if (fn.instrs[iid::u32].operands[0].kind == value.VAL_GLOBAL) { ret true; }

    var i: u32 = 1;
    for (i < fn.instrs[iid::u32].operand_count) {
        if (fn.instrs[iid::u32].operands[i].kind != value.VAL_CONST_INT) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun operands_invariant(la: *loops.LoopAnalysis, lx: u32, ins: *instruction.Instruction) bool {
    var i: u32 = 0;
    for (i < ins.operand_count) {
        if (!loops.is_invariant(la, lx, ins.operands[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun loop_has_opaque_effect(fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32) bool {
    val lp: *loops.Loop = ?la.loops[lx];
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var k: u32 = 0;
        for (k < blk.instr_count) {
            val ik: instruction.InstrKind = fn.instrs[blk.instructions[k]::u32].kind;
            if (opdesc.has(ik, opdesc.EFF_MAY_CALL)) { ret true; }
            k = k + 1;
        }
        bi = bi + 1;
    }
    ret false;
}

fun load_is_speculable(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32,
                       tgt: *target.Target, iid: id.InstructionId) bool {
    if (fn.instrs[iid::u32].operand_count < 1) { ret false; }

    var gix: u32 = 0;
    var off: u64 = 0;
    if (!global_const_address(m, fn, tgt, fn.instrs[iid::u32].operands[0], ?gix, ?off)) { ret false; }

    val lty: ir_type.IrTypeId = fn.instrs[iid::u32].ty;
    val gty: ir_type.IrTypeId = m.globals[gix].ty;
    if (lty == ir_type.IRT_NIL || gty == ir_type.IRT_NIL) { ret false; }

    val gsz: u64 = ir_type.byte_size_for_machine(?m.types, gty, resolved.layout_machine(tgt))::u64;
    val lsz: u64 = ir_type.byte_size_for_machine(?m.types, lty, resolved.layout_machine(tgt))::u64;
    if (lsz == 0)        { ret false; }
    if (off > gsz)       { ret false; }
    if (lsz > gsz - off) { ret false; }

    ret !loop_may_write_global(m, fn, la, lx, gix);
}

fun global_const_address(m: *ir.Module, fn: *ir.Function, tgt: *target.Target, p: value.Value,
                         out_gix: *u32, out_off: *u64) bool {
    var cur: value.Value = p;
    var off: u64 = 0;
    var steps: u32 = 0;

    for (true) {
        if (cur.kind == value.VAL_GLOBAL) {
            @out_gix = cur.data.global_ix;
            @out_off = off;
            ret cur.data.global_ix < m.global_len;
        }
        if (cur.kind != value.VAL_INSTR) { ret false; }
        val iid: id.InstructionId = cur.data.instr;
        if (iid::u32 >= fn.instr_len) { ret false; }

        val k: instruction.InstrKind = fn.instrs[iid::u32].kind;
        if (k == instruction.OP_BITCAST) {
            if (fn.instrs[iid::u32].operand_count < 1) { ret false; }
            cur = fn.instrs[iid::u32].operands[0];
        } or (k == instruction.OP_GEP) {
            var d: u64 = 0;
            if (!gep_const_disp(m, fn, tgt, iid, ?d)) { ret false; }
            off = off + d;
            cur = fn.instrs[iid::u32].operands[0];
        } or {
            ret false;
        }

        steps = steps + 1;
        if (steps > fn.instr_len) { panic("mach.lang.me.transform.licm: cyclic pointer definition chain\n"); }
    }
    ret false;
}

fun gep_const_disp(m: *ir.Module, fn: *ir.Function, tgt: *target.Target, iid: id.InstructionId, out_disp: *u64) bool {
    val count: u32 = fn.instrs[iid::u32].operand_count;
    if (count <= 1) { @out_disp = 0; ret true; }

    var cur: ir_type.IrTypeId = fn.instrs[iid::u32].aux_ty;
    if (cur == ir_type.IRT_NIL) { ret false; }

    var disp: u64 = 0;
    var k: u32 = 1;
    for (k < count) {
        val v: value.Value = fn.instrs[iid::u32].operands[k];
        if (v.kind != value.VAL_CONST_INT) { ret false; }

        if (k == 1) {
            disp = disp + v.data.int_lit * ir_type.byte_size_for_machine(?m.types, cur, resolved.layout_machine(tgt))::u64;
        } or {
            var next: ir_type.IrTypeId = ir_type.IRT_NIL;
            var is_field: bool = false;
            if (!descend_level(m, cur, v, ?next, ?is_field)) { ret false; }
            if (is_field) {
                disp = disp + ir_type.byte_offset_for_machine(?m.types, cur, v.data.int_lit::u32, resolved.layout_machine(tgt))::u64;
            } or {
                disp = disp + v.data.int_lit * ir_type.byte_size_for_machine(?m.types, next, resolved.layout_machine(tgt))::u64;
            }
            cur = next;
        }
        k = k + 1;
    }

    @out_disp = disp;
    ret true;
}

fun descend_level(m: *ir.Module, cur: ir_type.IrTypeId, v: value.Value,
                  out_next: *ir_type.IrTypeId, out_field: *bool) bool {
    if (cur == ir_type.IRT_NIL) { ret false; }
    val ct_opt: opt[*ir_type.IrType] = ir_type.get(?m.types, cur);
    if (!sel ct_opt.some) { ret false; }
    val ct: *ir_type.IrType = ct_opt.some;

    if (ct.kind == ir_type.IRT_ARRAY) {
        @out_next  = ct.data.array_.element;
        @out_field = false;
        ret true;
    }

    if (ct.kind == ir_type.IRT_STRUCT || ct.kind == ir_type.IRT_UNION) {
        if (v.kind != value.VAL_CONST_INT)                      { ret false; }
        if (v.data.int_lit >= ct.data.struct_.field_count::u64) { ret false; }
        @out_next  = ct.data.struct_.fields[v.data.int_lit::u32];
        @out_field = true;
        ret true;
    }

    ret false;
}

fun loop_may_write_global(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, gix: u32) bool {
    val lp: *loops.Loop = ?la.loops[lx];
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var k: u32 = 0;
        for (k < blk.instr_count) {
            val wid: id.InstructionId = blk.instructions[k];
            k = k + 1;
            val ik: instruction.InstrKind = fn.instrs[wid::u32].kind;

            var dst: value.Value;
            if (ik == instruction.OP_STORE) {
                if (fn.instrs[wid::u32].operand_count < 2) { ret true; }
                dst = fn.instrs[wid::u32].operands[1];
            } or (ik == instruction.OP_MEMZERO) {
                if (fn.instrs[wid::u32].operand_count < 1) { ret true; }
                dst = fn.instrs[wid::u32].operands[0];
            } or {
                cnt;
            }

            if (may_alias_global(m, fn, dst, gix)) { ret true; }
        }
        bi = bi + 1;
    }
    ret false;
}

fun may_alias_global(m: *ir.Module, fn: *ir.Function, p: value.Value, gix: u32) bool {
    val root: value.Value = pointer_root(fn, p);

    if (root.kind == value.VAL_GLOBAL) {
        if (root.data.global_ix == gix)      { ret true; }
        if (root.data.global_ix >= m.global_len) { ret true; }
        val a: intern.StrId = m.globals[root.data.global_ix].name;
        val b: intern.StrId = m.globals[gix].name;
        if (a == intern.STR_NIL || b == intern.STR_NIL) { ret true; }
        ret a == b;
    }

    if (root.kind == value.VAL_INSTR) {
        val iid: id.InstructionId = root.data.instr;
        if (iid::u32 < fn.instr_len && fn.instrs[iid::u32].kind == instruction.OP_ALLOCA) { ret false; }
    }

    ret true;
}

fun pointer_root(fn: *ir.Function, p: value.Value) value.Value {
    var cur: value.Value = p;
    var steps: u32 = 0;
    for (cur.kind == value.VAL_INSTR) {
        val iid: id.InstructionId = cur.data.instr;
        if (iid::u32 >= fn.instr_len) { ret cur; }
        val k: instruction.InstrKind = fn.instrs[iid::u32].kind;
        if (k != instruction.OP_GEP && k != instruction.OP_BITCAST) { ret cur; }
        if (fn.instrs[iid::u32].operand_count < 1) { ret cur; }
        cur = fn.instrs[iid::u32].operands[0];

        steps = steps + 1;
        if (steps > fn.instr_len) { panic("mach.lang.me.transform.licm: cyclic pointer definition chain\n"); }
    }
    ret cur;
}

fun split_invariant_gep_prefix(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32,
                               iid: id.InstructionId, pre_id: id.BlockId) res[bool, fail.Fail] {
    if (iid::u32 >= fn.instr_len)                          { ret res[bool, fail.Fail].ok{false}; }
    if (fn.instrs[iid::u32].kind != instruction.OP_GEP)    { ret res[bool, fail.Fail].ok{false}; }
    if (fn.instrs[iid::u32].aux_ty == ir_type.IRT_NIL)     { ret res[bool, fail.Fail].ok{false}; }

    val count: u32 = fn.instrs[iid::u32].operand_count;
    if (count < 3) { ret res[bool, fail.Fail].ok{false}; }
    if (fn.instrs[iid::u32].operands[0].kind != value.VAL_GLOBAL) { ret res[bool, fail.Fail].ok{false}; }

    var k: u32 = 0;
    for (k + 1 < count) {
        if (!loops.is_invariant(la, lx, fn.instrs[iid::u32].operands[1 + k])) { brk; }
        k = k + 1;
    }
    if (k == 0 || k == count - 1) { ret res[bool, fail.Fail].ok{false}; }

    var body_src: ir_type.IrTypeId = ir_type.IRT_NIL;
    if (!gep_level_type(m, fn, iid, k, ?body_src)) { ret res[bool, fail.Fail].ok{false}; }

    var prefix: id.InstructionId = find_prefix_gep(fn, ?fn.blocks[pre_id::u32], iid, k);
    if (prefix == id.INSTR_NIL) {
        val rn: res[id.InstructionId, fail.Fail] = emit_prefix_gep(m, fn, iid, k);
        if (sel rn.err) { ret res[bool, fail.Fail].err{rn.err}; }
        prefix = rn.ok;

        val rp: err[fail.Fail] = ir.block_append_instr(m, ?fn.blocks[pre_id::u32], prefix);
        if (sel rp.err) { ret res[bool, fail.Fail].err{rp.err}; }
        val rs: err[fail.Fail] = loops.set_instr_block(la, prefix, pre_id);
        if (sel rs.err) { ret res[bool, fail.Fail].err{rs.err}; }
    }

    val rest: u32 = count - 1 - k;
    val rb: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(m, rest + 1);
    if (sel rb.err) { ret res[bool, fail.Fail].err{rb.err}; }
    val arr: ir.OperandArray = rb.ok;

    var pv: value.Value = value.instr(prefix, fn.instrs[prefix::u32].ty);
    pv.secret = fn.instrs[prefix::u32].secret;
    arr.ops[0] = pv;
    var j: u32 = 0;
    for (j < rest) {
        arr.ops[1 + j] = fn.instrs[iid::u32].operands[1 + k + j];
        j = j + 1;
    }

    ir.instr_replace_operands(m, ?fn.instrs[iid::u32], arr);
    fn.instrs[iid::u32].aux_ty = body_src;
    ret res[bool, fail.Fail].ok{true};
}

fun gep_level_type(m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, k: u32, out_ty: *ir_type.IrTypeId) bool {
    var cur: ir_type.IrTypeId = fn.instrs[iid::u32].aux_ty;
    if (k == 0) { @out_ty = cur; ret true; }

    var j: u32 = 1;
    for (j <= k) {
        var next: ir_type.IrTypeId = ir_type.IRT_NIL;
        var is_field: bool = false;
        if (!descend_level(m, cur, fn.instrs[iid::u32].operands[1 + j], ?next, ?is_field)) { ret false; }
        cur = next;
        j = j + 1;
    }
    @out_ty = cur;
    ret true;
}

fun find_prefix_gep(fn: *ir.Function, pre: *ir.Block, iid: id.InstructionId, k: u32) id.InstructionId {
    var i: u32 = 0;
    for (i < pre.instr_count) {
        val cid: id.InstructionId = pre.instructions[i];
        i = i + 1;
        if (fn.instrs[cid::u32].kind != instruction.OP_GEP)                 { cnt; }
        if (fn.instrs[cid::u32].operand_count != k + 1)                     { cnt; }
        if (fn.instrs[cid::u32].aux_ty != fn.instrs[iid::u32].aux_ty)       { cnt; }
        if (fn.instrs[cid::u32].flags  != fn.instrs[iid::u32].flags)        { cnt; }

        var same: bool = true;
        var j: u32 = 0;
        for (j < k + 1) {
            if (!dep.equal(fn.instrs[cid::u32].operands[j], fn.instrs[iid::u32].operands[j])) { same = false; brk; }
            j = j + 1;
        }
        if (same) { ret cid; }
    }
    ret id.INSTR_NIL;
}

fun emit_prefix_gep(m: *ir.Module, fn: *ir.Function, iid: id.InstructionId, k: u32) res[id.InstructionId, fail.Fail] {
    val ra: res[*value.Value, A.Error] = A.allocate[value.Value](m.alloc, (k + 1)::usize);
    if (sel ra.err) { ret res[id.InstructionId, fail.Fail].err{fail.refused(ra.err)}; }
    val ops: *value.Value = ra.ok;

    var j: u32 = 0;
    for (j < k + 1) {
        ops[j] = fn.instrs[iid::u32].operands[j];
        j = j + 1;
    }

    var ni: instruction.Instruction;
    ni.kind          = instruction.OP_GEP;
    ni.ty            = fn.instrs[iid::u32].ty;
    ni.operands      = ops;
    ni.operand_count = k + 1;
    ni.operand_cap   = k + 1;
    ni.flags         = fn.instrs[iid::u32].flags;
    ni.aux_ty        = fn.instrs[iid::u32].aux_ty;
    ni.loc           = fn.instrs[iid::u32].loc;
    ni.secret        = fn.instrs[iid::u32].secret;

    val ri: res[id.InstructionId, fail.Fail] = ir.instruction_add(m, fn, ni);
    if (sel ri.err) { A.deallocate[value.Value](m.alloc, ops, (k + 1)::usize); }
    ret ri;
}

use std.allocator.page;
use mach.lang.me.ir.builder;
use mach.lang.target.resolved;

fun mk_target(reg: *target.TargetRegistry, o: *resolved.Target) i32 {
    @reg = target.registry_init();
    val r_504: err[fail.Fail] = target.register_all(reg, target_testing.debug_descriptor);
    if (sel r_504.err) { ret 1; }
    val tr: res[resolved.Target, fail.Fail] = target.select(reg, "x86_64", "linux", "sysv64");
    if (sel tr.err) { target.registry_dnit(reg); ret 1; }
    @o = tr.ok;
    ret 0;
}

fun mk_global(m: *ir.Module, itn: *intern.Interner, tag: str, ty: ir_type.IrTypeId,
              ptrt: ir_type.IrTypeId, o_val: *value.Value) i32 {
    val rn: res[intern.StrId, A.Error] = intern.intern(itn, tag);
    if (sel rn.err) { ret 1; }

    if (m.global_len == m.global_cap) {
        val cap: u32 = m.global_cap * 2 + 4;
        val rg: res[*ir.Global, A.Error] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, cap::usize);
        if (sel rg.err) { ret 1; }
        m.globals    = rg.ok;
        m.global_cap = cap;
    }

    val idx: u32 = m.global_len;
    var g: ir.Global;
    g.name      = rn.ok;
    g.ty        = ty;
    g.init      = value.const_int(0, ty);
    g.is_mut    = true;
    g.is_pub    = false;
    g.is_extern = false;
    g.is_import = false;
    g.is_local  = false;
    g.is_embed  = false;
    g.align     = 0;
    g.section   = intern.STR_NIL;
    m.globals[idx] = g;
    m.global_len   = idx + 1;

    @o_val = value.global(idx, ptrt);
    ret 0;
}

fun mk_loop(m: *ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId,
            o_entry: *id.BlockId, o_header: *id.BlockId, o_body: *id.BlockId, o_exit: *id.BlockId,
            o_iv: *value.Value) i32 {
    val re: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel re.err) { ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rh.err) { ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rb.err) { ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rx.err) { ret 1; }
    val exit: id.BlockId = rx.ok;

    builder.set_block(bld, entry);
    val r_561: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_561.err) { ret 1; }

    builder.set_block(bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(bld, i64t);
    if (sel rphi.err) { ret 1; }
    val iv: value.Value = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(bld, iv, value.param(0, i64t));
    if (sel rc.err) { ret 1; }
    val r_569: err[fail.Fail] = builder.emit_cbr(bld, rc.ok, body, exit);
    if (sel r_569.err) { ret 1; }

    builder.set_block(bld, exit);
    val r_572: err[fail.Fail] = builder.emit_ret_void(bld);
    if (sel r_572.err) { ret 1; }

    val r_574: err[fail.Fail] = builder.phi_add_incoming(bld, iv, entry, value.const_int(0, i64t));
    if (sel r_574.err) { ret 1; }

    @o_entry = entry; @o_header = header; @o_body = body; @o_exit = exit; @o_iv = iv;
    builder.set_block(bld, body);
    ret 0;
}

fun close_loop(bld: *builder.Builder, i64t: ir_type.IrTypeId, iv: value.Value,
               header: id.BlockId, body: id.BlockId) i32 {
    val ru: res[value.Value, fail.Fail] = builder.emit_add(bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ret 1; }
    val r_585: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_585.err) { ret 1; }
    val r_586: err[fail.Fail] = builder.phi_add_incoming(bld, iv, body, ru.ok);
    if (sel r_586.err) { ret 1; }
    ret 0;
}

fun block_holds(fn: *ir.Function, b: id.BlockId, iid: id.InstructionId) bool {
    val blk: *ir.Block = ?fn.blocks[b::u32];
    var i: u32 = 0;
    for (i < blk.instr_count) {
        if (blk.instructions[i] == iid) { ret true; }
        i = i + 1;
    }
    ret false;
}

test "mach.lang.me.transform.licm:hoists_invariant_global_load" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;

    var g: value.Value;
    if (mk_global(?m, ?itn, "g_bound", i64t, ptrt, ?g) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, g, i64t);
    if (sel rl.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ld: value.Value = rl.ok;
    val rs: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, ld);
    if (sel rs.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val sum: value.Value = rs.ok;
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    val rr: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rr.err)          { code = 1; }
    or (sel rr.ok) { if (!rr.ok) { code = 1; } }

    if (!block_holds(fn, entry, ld.data.instr)) { code = 1; }
    if (block_holds(fn, body, ld.data.instr))   { code = 1; }
    if (!block_holds(fn, body, sum.data.instr)) { code = 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.me.transform.licm:volatile_flag_blocks_hoist_of_an_otherwise_speculable_global_load" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;

    var g: value.Value;
    if (mk_global(?m, ?itn, "g_volatile", i64t, ptrt, ?g) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, g, i64t);
    if (sel rl.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ld: value.Value = rl.ok;
    val rs: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, ld);
    if (sel rs.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val sum: value.Value = rs.ok;
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    fn.instrs[ld.data.instr::u32].flags = instruction.INSTR_FLAG_VOLATILE;

    var code: i32 = 0;
    val rr: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rr.err) { code = 1; }

    if (block_holds(fn, entry, ld.data.instr)) { code = 1; }
    if (!block_holds(fn, body, ld.data.instr)) { code = 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.me.transform.licm:aliasing_store_blocks_load_hoist" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    var pass: u32 = 0;
    for (pass < 2) {
        val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
        if (sel rm.err) { intern.dnit(?itn); ret 1; }
        var m: ir.Module = rm.ok;

        val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
        if (sel rt.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val i64t: ir_type.IrTypeId = rt.ok;
        val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
        if (sel rp.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val ptrt: ir_type.IrTypeId = rp.ok;

        var g: value.Value;
        var other: value.Value;
        if (mk_global(?m, ?itn, "g_read", i64t, ptrt, ?g) != 0)      { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        if (mk_global(?m, ?itn, "g_other", i64t, ptrt, ?other) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

        val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
        if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val fn: *ir.Function = ?m.functions[rf.ok];
        var bld: builder.Builder = builder.init(?m);
        builder.set_function(?bld, fn);

        var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
        var iv: value.Value;
        if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

        val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, g, i64t);
        if (sel rl.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        val ld: value.Value = rl.ok;
        var dst: value.Value = g;
        if (pass == 1) { dst = other; }
        val r_753: err[fail.Fail] = builder.emit_store(?bld, iv, dst);
        if (sel r_753.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
        if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

        val r_756: res[bool, fail.Fail] = run(?m, ?tgt);
        if (sel r_756.err) { code = 1; }

        if (pass == 0) {
            if (!block_holds(fn, body, ld.data.instr)) { code = 1; }
            if (block_holds(fn, entry, ld.data.instr)) { code = 1; }
        } or {
            if (!block_holds(fn, entry, ld.data.instr)) { code = 1; }
            if (block_holds(fn, body, ld.data.instr))   { code = 1; }
        }

        ir.dnit(?m);
        pass = pass + 1;
    }

    intern.dnit(?itn);
    ret code;
}

test "mach.lang.me.transform.licm:call_blocks_load_hoist" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;

    var g: value.Value;
    if (mk_global(?m, ?itn, "g_called", i64t, ptrt, ?g) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rcal: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, ir.FN_FLAG_EXTERN);
    if (sel rcal.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val callee: value.Value = value.fn(rcal.ok, ptrt);

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, g, i64t);
    if (sel rl.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ld: value.Value = rl.ok;
    val rmul: res[value.Value, fail.Fail] = builder.emit_mul(?bld, value.param(0, i64t), value.const_int(3, i64t));
    if (sel rmul.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val prod: value.Value = rmul.ok;
    val r_820: res[value.Value, fail.Fail] = builder.emit_call(?bld, callee, nil, 0, voidt);
    if (sel r_820.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    val r_824: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel r_824.err) { code = 1; }

    if (!block_holds(fn, body, ld.data.instr))    { code = 1; }
    if (block_holds(fn, entry, ld.data.instr))    { code = 1; }
    if (!block_holds(fn, entry, prod.data.instr)) { code = 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.me.transform.licm:divide_is_not_speculated" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    val p0: value.Value = value.param(0, i64t);
    val p1: value.Value = value.param(1, i64t);
    val rd: res[value.Value, fail.Fail] = builder.emit_div_s(?bld, p0, p1);
    if (sel rd.err) { ir.dnit(?m); ret 1; }
    val quo: value.Value = rd.ok;
    val rr2: res[value.Value, fail.Fail] = builder.emit_rem_s(?bld, p0, p1);
    if (sel rr2.err) { ir.dnit(?m); ret 1; }
    val rem: value.Value = rr2.ok;
    val rmul: res[value.Value, fail.Fail] = builder.emit_mul(?bld, p0, p1);
    if (sel rmul.err) { ir.dnit(?m); ret 1; }
    val prod: value.Value = rmul.ok;
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val r_875: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel r_875.err) { code = 1; }

    if (!block_holds(fn, body, quo.data.instr))   { code = 1; }
    if (!block_holds(fn, body, rem.data.instr))   { code = 1; }
    if (!block_holds(fn, entry, prod.data.instr)) { code = 1; }

    ir.dnit(?m);
    ret code;
}

