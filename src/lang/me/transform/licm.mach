}

test "mach.lang.me.transform.licm:splits_invariant_gep_prefix" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, i64t, 16);
    if (sel ra.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val arrt: ir_type.IrTypeId = ra.ok;

    var arr: value.Value;
    if (mk_global(?m, ?itn, "g_arr", arrt, ptrt, ?arr) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var ix: [2]value.Value;
    ix[0] = value.const_int(0, i64t);
    ix[1] = iv;
    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, arr, arrt, ?ix[0], 2);
    if (sel rg.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val gp: value.Value = rg.ok;
    val r_974: err[fail.Fail] = builder.emit_store(?bld, iv, gp);
    if (sel r_974.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    val r_978: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel r_978.err) { code = 1; }

    if (!block_holds(fn, body, gp.data.instr)) { code = 1; }
    or {
        val g: *instruction.Instruction = ?fn.instrs[gp.data.instr::u32];
        if (g.operand_count != 2)                  { code = 1; }
        or {
            if (g.aux_ty != i64t)                  { code = 1; }
            if (!dep.equal(g.operands[1], iv))     { code = 1; }
            if (g.operands[0].kind != value.VAL_INSTR) { code = 1; }
            or {
                val pid: id.InstructionId = g.operands[0].data.instr;
                if (!block_holds(fn, entry, pid))               { code = 1; }
                val p: *instruction.Instruction = ?fn.instrs[pid::u32];
                if (p.kind != instruction.OP_GEP)               { code = 1; }
                if (p.operand_count != 2)                       { code = 1; }
                or {
                    if (p.aux_ty != arrt)                       { code = 1; }
                    if (p.operands[0].kind != value.VAL_GLOBAL) { code = 1; }
                    if (p.operands[1].kind != value.VAL_CONST_INT) { code = 1; }
                    or { if (p.operands[1].data.int_lit != 0)   { code = 1; } }
                }
            }
        }
    }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.me.transform.licm:absorbed_gep_is_not_hoisted" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var itn: intern.Interner = intern.init(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { intern.dnit(?itn); ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { intern.dnit(?itn); ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, i64t, 16);
    if (sel ra.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val arrt: ir_type.IrTypeId = ra.ok;

    var g: value.Value;
    if (mk_global(?m, ?itn, "g_absorb", arrt, ptrt, ?g) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    val p1: value.Value = value.param(1, ptrt);
    val k3: value.Value = value.const_int(3, i64t);
    val k0: value.Value = value.const_int(0, i64t);

    var ax: [2]value.Value;
    ax[0] = k0; ax[1] = k3;
    val rg1: res[value.Value, fail.Fail] = builder.emit_gep(?bld, p1, arrt, ?ax[0], 2);
    if (sel rg1.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val absorbed: value.Value = rg1.ok;

    var bx: [2]value.Value;
    bx[0] = k0; bx[1] = k3;
    val rg2: res[value.Value, fail.Fail] = builder.emit_gep(?bld, g, arrt, ?bx[0], 2);
    if (sel rg2.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val symbased: value.Value = rg2.ok;

    var cx: [2]value.Value;
    cx[0] = k0; cx[1] = value.param(0, i64t);
    val rg3: res[value.Value, fail.Fail] = builder.emit_gep(?bld, p1, arrt, ?cx[0], 2);
    if (sel rg3.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val scaled: value.Value = rg3.ok;

    val r_1067: err[fail.Fail] = builder.emit_store(?bld, iv, absorbed);
    if (sel r_1067.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val r_1068: err[fail.Fail] = builder.emit_store(?bld, iv, symbased);
    if (sel r_1068.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    val r_1069: err[fail.Fail] = builder.emit_store(?bld, iv, scaled);
    if (sel r_1069.err) { ir.dnit(?m); intern.dnit(?itn); ret 1; }
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); intern.dnit(?itn); ret 1; }

    var code: i32 = 0;
    val r_1073: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel r_1073.err) { code = 1; }

    if (!block_holds(fn, body, absorbed.data.instr))   { code = 1; }
    if (block_holds(fn, entry, absorbed.data.instr))   { code = 1; }
    if (!block_holds(fn, entry, symbased.data.instr))  { code = 1; }
    if (!block_holds(fn, entry, scaled.data.instr))    { code = 1; }

    ir.dnit(?m);
    intern.dnit(?itn);
    ret code;
}

test "mach.lang.me.transform.licm:hoists_dependent_chain_in_one_pass" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ir.dnit(?m); ret 1; }

    val p0: value.Value = value.param(0, i64t);
    val ra: res[value.Value, fail.Fail] = builder.emit_add(?bld, p0, value.const_int(1, i64t));
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val a: value.Value = ra.ok;
    val rb: res[value.Value, fail.Fail] = builder.emit_mul(?bld, a, a);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val b: value.Value = rb.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_add(?bld, b, iv);
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val c: value.Value = rc.ok;
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val r_1124: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel r_1124.err) { code = 1; }

    if (!block_holds(fn, entry, a.data.instr)) { code = 1; }
    if (!block_holds(fn, entry, b.data.instr)) { code = 1; }
    if (!block_holds(fn, body, c.data.instr))  { code = 1; }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.licm:no_preheader_declines" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var bids: [5]id.BlockId;
    var i: u32 = 0;
    for (i < 5) {
        val rbk: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
        if (sel rbk.err) { ir.dnit(?m); ret 1; }
        bids[i] = rbk.ok;
        i = i + 1;
    }
    val entry:  id.BlockId = bids[0];
    val arm:    id.BlockId = bids[1];
    val header: id.BlockId = bids[2];
    val body:   id.BlockId = bids[3];
    val exit:   id.BlockId = bids[4];

    val p0: value.Value = value.param(0, i64t);

    builder.set_block(?bld, entry);
    val rc0: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, p0, value.const_int(1, i64t));
    if (sel rc0.err) { ir.dnit(?m); ret 1; }
    val r_1175: err[fail.Fail] = builder.emit_cbr(?bld, rc0.ok, arm, header);
    if (sel r_1175.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, arm);
    val r_1178: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1178.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val iv: value.Value = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, iv, p0);
    if (sel rc1.err) { ir.dnit(?m); ret 1; }
    val r_1186: err[fail.Fail] = builder.emit_cbr(?bld, rc1.ok, body, exit);
    if (sel r_1186.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, body);
    val rmul: res[value.Value, fail.Fail] = builder.emit_mul(?bld, p0, value.const_int(7, i64t));
    if (sel rmul.err) { ir.dnit(?m); ret 1; }
    val prod: value.Value = rmul.ok;
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val upd: value.Value = ru.ok;
    val r_1195: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1195.err) { ir.dnit(?m); ret 1; }

    val z: value.Value = value.const_int(0, i64t);
    val r_1198: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, z);
    if (sel r_1198.err) { ir.dnit(?m); ret 1; }
    val r_1199: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, arm, z);
    if (sel r_1199.err) { ir.dnit(?m); ret 1; }
    val r_1200: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, upd);
    if (sel r_1200.err) { ir.dnit(?m); ret 1; }

    var pre2: id.BlockId; var head2: id.BlockId; var body2: id.BlockId; var exit2: id.BlockId;
    var iv2: value.Value;
    if (mk_loop(?m, ?bld, i64t, ?pre2, ?head2, ?body2, ?exit2, ?iv2) != 0) { ir.dnit(?m); ret 1; }
    val rm2: res[value.Value, fail.Fail] = builder.emit_mul(?bld, p0, value.const_int(9, i64t));
    if (sel rm2.err) { ir.dnit(?m); ret 1; }
    val prod2: value.Value = rm2.ok;
    if (close_loop(?bld, i64t, iv2, head2, body2) != 0) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, exit);
    val r_1211: err[fail.Fail] = builder.emit_br(?bld, pre2);
    if (sel r_1211.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val rr: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rr.err)          { code = 1; }
    or (sel rr.ok) { if (!rr.ok) { code = 1; } }
    if (!block_holds(fn, body, prod.data.instr))   { code = 1; }
    if (!block_holds(fn, pre2, prod2.data.instr))  { code = 1; }

    ir.dnit(?m);
    ret code;
}

# the fail-at-N fixture: a loop whose body loads an invariant global
# (hoisted), doubles the induction variable (kept, so the list is already
# compacting when the next allocation comes), adds them and stores through a
# gep with an invariant prefix (split, which allocates)
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    var itn: intern.Interner = intern.init(a.context::*A.Allocator);
    fin { intern.dnit(?itn); }
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret 2; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val ra: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, i64t, 16);
    if (sel ra.err) { ret 3; }
    val arrt: ir_type.IrTypeId = ra.ok;
    var g: value.Value;
    if (mk_global(m, ?itn, "g_bound", i64t, ptrt, ?g) != 0) { ret 4; }
    var arr: value.Value;
    if (mk_global(m, ?itn, "g_arr", arrt, ptrt, ?arr) != 0) { ret 5; }
    val rf: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ret 6; }
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[rf.ok]);
    var entry: id.BlockId; var header: id.BlockId; var body: id.BlockId; var exit: id.BlockId;
    var iv: value.Value;
    if (mk_loop(m, ?bld, i64t, ?entry, ?header, ?body, ?exit, ?iv) != 0) { ret 7; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, g, i64t);
    if (sel rl.err) { ret 8; }
    val rk: res[value.Value, fail.Fail] = builder.emit_mul(?bld, iv, value.const_int(2, i64t));
    if (sel rk.err) { ret 8; }
    val rs: res[value.Value, fail.Fail] = builder.emit_add(?bld, rk.ok, rl.ok);
    if (sel rs.err) { ret 9; }
    var ix: [2]value.Value;
    ix[0] = value.const_int(0, i64t);
    ix[1] = iv;
    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, arr, arrt, ?ix[0], 2);
    if (sel rg.err) { ret 10; }
    val r_store: err[fail.Fail] = builder.emit_store(?bld, rs.ok, rg.ok);
    if (sel r_store.err) { ret 11; }
    if (close_loop(?bld, i64t, iv, header, body) != 0) { ret 12; }
    ret 0;
}

fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    ret run_in(m, a.target, workspace);
}

# the loop analysis and the loop order are scratch and precede the hoist; the
# hoist grows the preheader and emits prefix geps from the module one
# instruction at a time, so a refusal there leaves some invariant instructions
# hoisted and the rest in place, every block listing each instruction once
fun probe_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    ret me_testing.listed(m) >= me_testing.listed(a.control) && me_testing.verifies(m, true);
}

test "mach.lang.me.transform.licm.run_in:refusal_at_every_ordinal_leaves_the_input_or_a_consistent_partial_hoist" {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (mk_target(?reg, ?tgt) != 0) { ret 2; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: ?tgt, control: nil, context: (?owner)::ptr};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 3; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}
