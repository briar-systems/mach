    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1590: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1590.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target = rtg.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_axpy_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);

    builder.set_block(?bld, entry);
    val r_1630: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1630.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val iv: value.Value = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, iv, n);
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val r_1637: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, body, exit);
    if (sel r_1637.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, body);
    val rim1: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(0xFFFFFFFFFFFFFFFF, i64t));
    if (sel rim1.err) { ir.dnit(?m); ret 1; }
    var ixs: [1]value.Value; ixs[0] = rim1.ok;
    val rgs: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixs[0], 1);
    if (sel rgs.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgs.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    var ixd: [1]value.Value; ixd[0] = iv;
    val rgd: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixd[0], 1);
    if (sel rgd.err) { ir.dnit(?m); ret 1; }
    val r_1649: err[fail.Fail] = builder.emit_store(?bld, rl.ok, rgd.ok);
    if (sel r_1649.err) { ir.dnit(?m); ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val r_1652: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1652.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?bld, exit);
    val r_1654: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1654.err) { ir.dnit(?m); ret 1; }
    val r_1655: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, value.const_int(0, i64t));
    if (sel r_1655.err) { ir.dnit(?m); ret 1; }
    val r_1656: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_1656.err) { ir.dnit(?m); ret 1; }

    val blocks_before: u32 = fn.block_count;
    val instrs_before: u32 = fn.instr_len;

    var code: i32 = 0;
    val rr: res[bool, fail.Fail] = run(?m, ?tgt, false);
    if (sel rr.err) { code = 1; }
    or (sel rr.ok) {
        if (rr.ok) { code = 1; }
        if (fn.block_count != blocks_before) { code = 1; }
        if (fn.instr_len != instrs_before)   { code = 1; }
    }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.vectorize:debug_only_forwarder" {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i32t: ir_type.IrTypeId = rt.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rto: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rdbg: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rreal: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rto.err) { ir.dnit(?m); ret 1; }
    if (sel rdbg.err) { ir.dnit(?m); ret 1; }
    if (sel rreal.err) { ir.dnit(?m); ret 1; }
    val to: id.BlockId = rto.ok;
    val dbg_arm: id.BlockId = rdbg.ok;
    val real_arm: id.BlockId = rreal.ok;

    builder.set_block(?bld, dbg_arm);
    val r_1701: err[fail.Fail] = builder.emit_dbg_value(?bld, value.const_int(7, i32t), intern.STR_NIL, i32t, semtype.TYPE_NIL, false, 0);
    if (sel r_1701.err) { ir.dnit(?m); ret 1; }
    val r_1702: err[fail.Fail] = builder.emit_br(?bld, to);
    if (sel r_1702.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, real_arm);
    val ra: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.const_int(1, i32t), value.const_int(2, i32t));
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val r_1707: err[fail.Fail] = builder.emit_br(?bld, to);
    if (sel r_1707.err) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    if (!empty_forwarder(fn, dbg_arm, to)) { code = 1; }
    if (empty_forwarder(fn, real_arm, to)) { code = 2; }
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.vectorize:predicated_mixed_join_declines" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1721: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1721.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target = rtg.ok;
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel rt32.err) { ir.dnit(?m); ret 1; }
    val i32t: ir_type.IrTypeId = rt32.ok;
    val rt64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt64.ok;
    val rtp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rtp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rtp.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rta: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rta.err) { ir.dnit(?m); ret 1; }
    val t_arm: id.BlockId = rta.ok;
    val rfa: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rfa.err) { ir.dnit(?m); ret 1; }
    val f_arm: id.BlockId = rfa.ok;
    val reb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel reb.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = reb.ok;
    val rlb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rlb.err) { ir.dnit(?m); ret 1; }
    val latch: id.BlockId = rlb.ok;

    val base: value.Value = value.const_null(ptrt);
    builder.set_block(?bld, entry);
    val rload: res[value.Value, fail.Fail] = builder.emit_load(?bld, base, i32t);
    if (sel rload.err) { ir.dnit(?m); ret 1; }
    val load: value.Value = rload.ok;
    val rmask: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, load, value.const_int(10, i32t));
    if (sel rmask.err) { ir.dnit(?m); ret 1; }
    val mask: value.Value = rmask.ok;

    builder.set_block(?bld, latch);
    val rp32: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i32t);
    if (sel rp32.err) { ir.dnit(?m); ret 1; }
    val phi32: value.Value = rp32.ok;
    val rp64: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rp64.err) { ir.dnit(?m); ret 1; }
    val phi64: value.Value = rp64.ok;

    val r_1775: err[fail.Fail] = builder.phi_add_incoming(?bld, phi32, t_arm, value.const_int(1, i32t));
    if (sel r_1775.err) { ir.dnit(?m); ret 1; }
    val r_1776: err[fail.Fail] = builder.phi_add_incoming(?bld, phi32, f_arm, value.const_int(2, i32t));
    if (sel r_1776.err) { ir.dnit(?m); ret 1; }
    val r_1777: err[fail.Fail] = builder.phi_add_incoming(?bld, phi64, t_arm, value.const_int(1, i64t));
    if (sel r_1777.err) { ir.dnit(?m); ret 1; }
    val r_1778: err[fail.Fail] = builder.phi_add_incoming(?bld, phi64, f_arm, value.const_int(2, i64t));
    if (sel r_1778.err) { ir.dnit(?m); ret 1; }
    val r_1779: err[fail.Fail] = builder.emit_store(?bld, phi32, base);
    if (sel r_1779.err) { ir.dnit(?m); ret 1; }
    val store_id: id.InstructionId = (fn.instr_len - 1)::id.InstructionId;

    var body: [2]id.BlockId;
    body[0] = entry;
    body[1] = latch;
    var loop_list: [1]loops.Loop;
    loop_list[0].header   = t_arm;
    loop_list[0].latch    = latch;
    loop_list[0].body     = ?body[0];
    loop_list[0].body_len = 2;
    var la: loops.LoopAnalysis;
    la.block_count = fn.block_count;
    la.instr_count = fn.instr_len;
    la.loops       = ?loop_list[0];
    la.loop_len    = 1;

    val rac: res[*dep.MemAccess, A.Error] = A.allocate[dep.MemAccess](?alloc, 2);
    if (sel rac.err) { ir.dnit(?m); ret 1; }
    val accesses: *dep.MemAccess = rac.ok;
    accesses[0].instr     = load.data.instr;
    accesses[0].gep       = id.INSTR_NIL;
    accesses[0].base      = base;
    accesses[0].off       = value.const_int(0, i64t);
    accesses[0].stride_ty = i32t;
    accesses[0].elem_ty   = i32t;
    accesses[0].bytes     = 4;
    accesses[0].is_store  = false;
    accesses[1].instr     = store_id;
    accesses[1].gep       = id.INSTR_NIL;
    accesses[1].base      = base;
    accesses[1].off       = value.const_int(0, i64t);
    accesses[1].stride_ty = i32t;
    accesses[1].elem_ty   = i32t;
    accesses[1].bytes     = 4;
    accesses[1].is_store  = true;

    var d: dep.DepInfo;
    d.alloc        = ?alloc;
    d.verdict      = dep.DEP_INDEPENDENT;
    d.accesses     = accesses;
    d.access_count = 2;
    d.access_cap   = 2;
    var shape: MapShape;
    shape.elem_ty  = i32t;
    shape.bytes    = 4;
    shape.lanes    = 4;
    shape.is_float = false;

    var code: i32 = 0;
    val rset: res[*bool, A.Error] = A.allocate[bool](?alloc, fn.instr_len::usize);
    if (sel rset.err) { dep.dep_dnit(?d); ir.dnit(?m); ret 1; }
    val vset: *bool = rset.ok;
    build_vset(?m, ?tgt, fn, ?la, 0, d.accesses, d.access_count, shape.elem_ty, shape.is_float, true, true, mask.data.instr, vset);
    if (!vset[load.data.instr::u32])  { code = 2; }
    if (!vset[mask.data.instr::u32])  { code = 3; }
    if (!vset[phi32.data.instr::u32]) { code = 4; }
    if (vset[phi64.data.instr::u32])  { code = 5; }
    val store: *instruction.Instruction = ?fn.instrs[store_id::u32];
    if (store.operand_count == 0 || store.operands[0].kind != value.VAL_INSTR
        || !vset[store.operands[0].data.instr::u32]) { code = 6; }
    A.deallocate[bool](?alloc, vset, fn.instr_len::usize);
    if (code == 0) {
        val rr: res[bool, fail.Fail] = stores_are_pure_trees(?m, ?tgt, fn, ?la, 0, ?d, ?shape, true, mask.data.instr);
        if (sel rr.err) { code = 1; }
        or (sel rr.ok && rr.ok) { code = 1; }
    }
    dep.dep_dnit(?d);
    ir.dnit(?m);
    ret code;
}
