use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.page;

use std.system.panic.panic;

use mach.lang.intern;
use semtype: mach.lang.type;
use mach.lang.me.ir;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.refs;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.value;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.mutate;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.me.vecform;
use mach.lang.me.analysis.loops;
use dep: mach.lang.me.analysis.dependence;
use ver: mach.lang.me.transform.versioning;

rec MapShape {
    elem_ty:  ir_type.IrTypeId;
    bytes:    u32;
    lanes:    u32;
    is_float: bool;
}

rec SplatSite {
    instr: id.InstructionId;
    slot:  u32;
    val:   value.Value;
}

rec SplatEntry {
    key: value.Value;
    vec: value.Value;
}

pub fun run(m: *ir.Module, tgt: *target.Target, float_reassoc: bool) res[bool, fail.Fail] {
    if (!tgt.model.has_v128) { ret res[bool, fail.Fail].ok{false}; }
    if (!tgt.model.auto_vectorize) { ret res[bool, fail.Fail].ok{false}; }

    var changed: bool = false;
    var fi: u32 = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if (fn.block_count == 0 || (fn.flags & ir.FN_FLAG_SCALAR) != 0
            || (fn.flags & ir.FN_FLAG_OBLIVIOUS) != 0 || effect.function_has_volatile(fn)) {
            fi = fi + 1;
            cnt;
        }

        val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, m.alloc);
        if (sel ral.err) { ret res[bool, fail.Fail].err{ral.err}; }
        var la: loops.LoopAnalysis = ral.ok;

        val cap: u32 = la.loop_len + 1;
        val rhh: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, cap::usize);
        if (sel rhh.err) { loops.dnit(?la); ret res[bool, fail.Fail].err{fail.refused(rhh.err)}; }
        val headers: *id.BlockId = rhh.ok;
        val rda: res[*dep.DepInfo, A.Error] = A.allocate[dep.DepInfo](m.alloc, cap::usize);
        if (sel rda.err) { A.deallocate[id.BlockId](m.alloc, headers, cap::usize); loops.dnit(?la); ret res[bool, fail.Fail].err{fail.refused(rda.err)}; }
        val deps: *dep.DepInfo = rda.ok;

        var hn: u32 = 0;
        var lx: u32 = 0;
        for (lx < la.loop_len) {
            var d: dep.DepInfo;
            val vectorizable_r: res[bool, fail.Fail] = vectorizable(m, tgt, fn, ?la, lx, ?d);
            if (sel vectorizable_r.err) {
                free_candidates(m, headers, deps, hn, cap);
                loops.dnit(?la);
                ret res[bool, fail.Fail].err{vectorizable_r.err};
            }
            if (vectorizable_r.ok) {
                headers[hn] = la.loops[lx].header;
                deps[hn] = d;
                hn = hn + 1;
            }
            lx = lx + 1;
        }
        loops.dnit(?la);

        var hi: u32 = 0;
        for (hi < hn) {
            val ra2: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, m.alloc);
            if (sel ra2.err) { free_candidates(m, headers, deps, hn, cap); ret res[bool, fail.Fail].err{ra2.err}; }
            var la2: loops.LoopAnalysis = ra2.ok;
            val lx2: u32 = find_loop_by_header(?la2, headers[hi]);
            if (lx2 != ver.NONE_U32) {
                val vectorized_r: res[bool, fail.Fail] = vectorize_one(m, tgt, fn, ?la2, lx2, ?deps[hi]);
                if (sel vectorized_r.err) { loops.dnit(?la2); free_candidates(m, headers, deps, hn, cap); ret res[bool, fail.Fail].err{vectorized_r.err}; }
                if (vectorized_r.ok) { changed = true; }
            }
            loops.dnit(?la2);
            hi = hi + 1;
        }
        free_candidates(m, headers, deps, hn, cap);

        val reduced_r: res[bool, fail.Fail] = run_reductions(m, tgt, fn, float_reassoc);
        if (sel reduced_r.err) { ret reduced_r; }
        if (reduced_r.ok) { changed = true; }
        fi = fi + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun free_candidates(m: *ir.Module, headers: *id.BlockId, deps: *dep.DepInfo, hn: u32, cap: u32) {
    var i: u32 = 0;
    for (i < hn) { dep.dep_dnit(?deps[i]); i = i + 1; }
    A.deallocate[id.BlockId](m.alloc, headers, cap::usize);
    A.deallocate[dep.DepInfo](m.alloc, deps, cap::usize);
}

fun find_loop_by_header(la: *loops.LoopAnalysis, h: id.BlockId) u32 {
    var i: u32 = 0;
    for (i < la.loop_len) {
        if (la.loops[i].header == h) { ret i; }
        i = i + 1;
    }
    ret ver.NONE_U32;
}

rec PredShape {
    ok:    bool;
    entry: id.BlockId;
    t_arm: id.BlockId;
    f_arm: id.BlockId;
    cmp:   id.InstructionId;
}

fun loop_shape_ok(fn: *ir.Function, lp: *loops.Loop, out_p: *PredShape) bool {
    out_p.ok = false;
    if (!lp.is_counted) { ret false; }
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL || lp.exiting == id.BLOCK_NIL) { ret false; }
    if (!lp.counted.iv_on_left) { ret false; }
    if (!lp.counted.continue_on_true) { ret false; }
    if (lp.iv.step.kind != value.VAL_CONST_INT || lp.iv.step.data.int_lit != 1) { ret false; }
    if (lp.latch == lp.header) { ret false; }
    if (lp.body_len == 2) { ret true; }
    ret recognize_predicated(fn, lp, out_p);
}

fun recognize_predicated(fn: *ir.Function, lp: *loops.Loop, out: *PredShape) bool {
    if (lp.body_len != 5) { ret false; }
    val hdr: *ir.Block = ?fn.blocks[lp.header::u32];
    val entry: id.BlockId = cbr_target(fn, hdr.terminator, 0);
    if (entry == id.BLOCK_NIL || entry == lp.header || entry == lp.latch) { ret false; }
    if (!body_holds(lp, entry)) { ret false; }

    val eb: *ir.Block = ?fn.blocks[entry::u32];
    if (eb.phi_count != 0) { ret false; }
    val t_arm: id.BlockId = cbr_target(fn, eb.terminator, 0);
    val f_arm: id.BlockId = cbr_target(fn, eb.terminator, 1);
    if (t_arm == id.BLOCK_NIL || f_arm == id.BLOCK_NIL || t_arm == f_arm) { ret false; }
    if (!body_holds(lp, t_arm) || !body_holds(lp, f_arm)) { ret false; }
    if (!empty_forwarder(fn, t_arm, lp.latch) || !empty_forwarder(fn, f_arm, lp.latch)) { ret false; }

    val topt: opt[*instruction.Instruction] = ir.instruction_get(fn, eb.terminator);
    if (sel topt.none) { ret false; }
    val term: *instruction.Instruction = topt.some;
    if (term.operand_count == 0 || term.operands[0].kind != value.VAL_INSTR) { ret false; }
    val cmp_id: id.InstructionId = term.operands[0].data.instr;
    if (!block_holds_instr(?fn.blocks[entry::u32], cmp_id)) { ret false; }
    val copt: opt[*instruction.Instruction] = ir.instruction_get(fn, cmp_id);
    if (sel copt.none) { ret false; }
    if (!is_mask_compare(copt.some.kind)) { ret false; }
    if (!guard_branch_only(fn, cmp_id, eb.terminator)) { ret false; }

    val lb: *ir.Block = ?fn.blocks[lp.latch::u32];
    if (lb.phi_count == 0) { ret false; }
    var pi: u32 = 0;
    for (pi < lb.phi_count) {
        if (!joins_arms(fn, lb.phis[pi], t_arm, f_arm)) { ret false; }
        pi = pi + 1;
    }

    out.ok    = true;
    out.entry = entry;
    out.t_arm = t_arm;
    out.f_arm = f_arm;
    out.cmp   = cmp_id;
    ret true;
}

fun cbr_target(fn: *ir.Function, term: id.InstructionId, k: u32) id.BlockId {
    if (term == id.INSTR_NIL) { ret id.BLOCK_NIL; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, term);
    if (sel opt_.none) { ret id.BLOCK_NIL; }
    val t: *instruction.Instruction = opt_.some;
    if (t.kind != instruction.OP_CBR || t.operand_count < 3) { ret id.BLOCK_NIL; }
    ret ir.block_target(t.operands[1 + k]);
}

fun body_holds(lp: *loops.Loop, b: id.BlockId) bool {
    var i: u32 = 0;
    for (i < lp.body_len) { if (lp.body[i] == b) { ret true; } i = i + 1; }
    ret false;
}

fun block_holds_instr(b: *ir.Block, iid: id.InstructionId) bool {
    var i: u32 = 0;
    for (i < b.instr_count) { if (b.instructions[i] == iid) { ret true; } i = i + 1; }
    ret false;
}

fun guard_branch_only(fn: *ir.Function, cmp_id: id.InstructionId, branch_id: id.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var pi: u32 = 0;
        for (pi < blk.phi_count) {
            if (!guard_use_ok(fn, blk.phis[pi], cmp_id, branch_id)) { ret false; }
            pi = pi + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (!guard_use_ok(fn, blk.instructions[ii], cmp_id, branch_id)) { ret false; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL && !guard_use_ok(fn, blk.terminator, cmp_id, branch_id)) { ret false; }
        bi = bi + 1;
    }
    ret true;
}

fun guard_use_ok(fn: *ir.Function, iid: id.InstructionId, cmp_id: id.InstructionId, branch_id: id.InstructionId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret false; }
    val inst: *instruction.Instruction = opt_.some;
    if (inst.kind == instruction.OP_DBG_VALUE) { ret true; }
    var o: u32 = 0;
    for (o < inst.operand_count) {
        if (inst.operands[o].kind == value.VAL_INSTR && inst.operands[o].data.instr == cmp_id
            && (iid != branch_id || o != 0)) { ret false; }
        o = o + 1;
    }
    ret true;
}

fun empty_forwarder(fn: *ir.Function, b: id.BlockId, to: id.BlockId) bool {
    val blk: *ir.Block = ?fn.blocks[b::u32];
    if (blk.phi_count != 0) { ret false; }
    var i: u32 = 0;
    for (i < blk.instr_count) {
        val iopt: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[i]);
        if (sel iopt.none) { ret false; }
        if (iopt.some.kind != instruction.OP_DBG_VALUE) { ret false; }
        i = i + 1;
    }
    if (blk.terminator == id.INSTR_NIL) { ret false; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.terminator);
    if (sel opt_.none) { ret false; }
    val t: *instruction.Instruction = opt_.some;
    if (t.kind != instruction.OP_BR || t.operand_count < 1) { ret false; }
    ret ir.block_target(t.operands[0]) == to;
}

fun joins_arms(fn: *ir.Function, pid: id.InstructionId, t_arm: id.BlockId, f_arm: id.BlockId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret false; }
    val phi: *instruction.Instruction = opt_.some;
    if (phi.operand_count != 4) { ret false; }
    val b0: id.BlockId = ir.block_target(phi.operands[0]);
    val b1: id.BlockId = ir.block_target(phi.operands[2]);
    if (b0 == t_arm && b1 == f_arm) { ret true; }
    if (b0 == f_arm && b1 == t_arm) { ret true; }
    ret false;
}

fun phi_value_from(fn: *ir.Function, pid: id.InstructionId, from: id.BlockId) value.Value {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret value.const_null(ir_type.IRT_NIL); }
    val phi: *instruction.Instruction = opt_.some;
    var o: u32 = 0;
    for (o < phi.operand_count) {
        if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == from && o + 1 < phi.operand_count) {
            ret phi.operands[o + 1];
        }
        o = o + 1;
    }
    ret value.const_null(ir_type.IRT_NIL);
}

fun map_shape(tgt: *target.Target, d: *dep.DepInfo, out: *MapShape) bool {
    if (d.access_count == 0) { ret false; }
    val elem_ty: ir_type.IrTypeId = d.accesses[0].elem_ty;
    val w: u32 = d.accesses[0].bytes;
    if (w == 0 || w > 8) { ret false; }
    val lanes: u32 = vecform.packed_lanes(tgt, w * 8);
    if (lanes < 2) { ret false; }
    var has_store: bool = false;
    var i: u32 = 0;
    for (i < d.access_count) {
        if (d.accesses[i].elem_ty != elem_ty) { ret false; }
        if (d.accesses[i].bytes != w)         { ret false; }
        if (d.accesses[i].is_store) { has_store = true; }
        i = i + 1;
    }
    if (!has_store) { ret false; }
    out.elem_ty  = elem_ty;
    out.bytes    = w;
    out.lanes    = lanes;
    out.is_float = false;
    ret true;
}

fun vectorizable(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, out_d: *dep.DepInfo) res[bool, fail.Fail] {
    val lp: *loops.Loop = ?la.loops[lx];
    var pred: PredShape;
    if (!loop_shape_ok(fn, lp, ?pred)) { ret res[bool, fail.Fail].ok{false}; }
    if (lp.exit == id.BLOCK_NIL) { ret res[bool, fail.Fail].ok{false}; }

    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, la, lx, ?m.types, m.alloc);
    if (sel rd.err) { ret res[bool, fail.Fail].err{rd.err}; }
    var d: dep.DepInfo = rd.ok;
    if (d.verdict != dep.DEP_INDEPENDENT) { dep.dep_dnit(?d); ret res[bool, fail.Fail].ok{false}; }

    var shape: MapShape;
    if (!map_shape(tgt, ?d, ?shape)) { dep.dep_dnit(?d); ret res[bool, fail.Fail].ok{false}; }
    shape.is_float = ir_type.is_float_scalar(?m.types, shape.elem_ty);
    if (pred.ok && shape.is_float) { dep.dep_dnit(?d); ret res[bool, fail.Fail].ok{false}; }

    var ai: u32 = 0;
    for (ai < d.access_count) {
        val ab: id.BlockId = la.instr_block[d.accesses[ai].instr::u32];
        if (ab != lp.latch && !(pred.ok && ab == pred.entry)) { dep.dep_dnit(?d); ret res[bool, fail.Fail].ok{false}; }
        ai = ai + 1;
    }

    val pure_r: res[bool, fail.Fail] = stores_are_pure_trees(m, tgt, fn, la, lx, ?d, ?shape, pred.ok, pred_mask(?pred));
    if (sel pure_r.err) { dep.dep_dnit(?d); ret pure_r; }
    if (!pure_r.ok) { dep.dep_dnit(?d); ret res[bool, fail.Fail].ok{false}; }

    @out_d = d;
    ret res[bool, fail.Fail].ok{true};
}

fun stores_are_pure_trees(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, d: *dep.DepInfo, shape: *MapShape, pred_ok: bool, mask_cmp: id.InstructionId) res[bool, fail.Fail] {
    val rset: res[*bool, A.Error] = A.allocate[bool](m.alloc, fn.instr_len::usize);
    if (sel rset.err) { ret res[bool, fail.Fail].err{fail.refused(rset.err)}; }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, la, lx, d.accesses, d.access_count, shape.elem_ty, shape.is_float, true, pred_ok, mask_cmp, vset);

    var ok: bool = true;
    var i: u32 = 0;
    for (i < d.access_count) {
        if (d.accesses[i].is_store) {
            val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, d.accesses[i].instr);
            if (sel opt_.none) { ok = false; }
            or (sel opt_.some) {
                val st: *instruction.Instruction = opt_.some;
                val v: value.Value = st.operands[0];
                if (v.kind != value.VAL_INSTR || v.data.instr::u32 >= fn.instr_len || !vset[v.data.instr::u32]) { ok = false; }
            }
        }
        i = i + 1;
    }
    if (pred_ok && !pred_joins_in_vset(fn, la, lx, vset)) { ok = false; }
    if (pred_ok && (mask_cmp == id.INSTR_NIL || mask_cmp::u32 >= fn.instr_len || !vset[mask_cmp::u32])) { ok = false; }
    A.deallocate[bool](m.alloc, vset, fn.instr_len::usize);
    ret res[bool, fail.Fail].ok{ok};
}

fun pred_joins_in_vset(fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, vset: *bool) bool {
    val lp: *loops.Loop = ?la.loops[lx];
    if (lp.latch::u32 >= fn.block_count) { ret false; }
    val latch: *ir.Block = ?fn.blocks[lp.latch::u32];
    if (latch.phi_count == 0) { ret false; }
    var i: u32 = 0;
    for (i < latch.phi_count) {
        val pid: id.InstructionId = latch.phis[i];
        if (pid::u32 >= fn.instr_len || !vset[pid::u32]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun build_vset(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, accesses: *dep.MemAccess, access_count: u32, elem_ty: ir_type.IrTypeId, is_float: bool, allow_splat: bool, admit_joins: bool, mask_cmp: id.InstructionId, vset: *bool) {
    val lane_bits: u32 = vecform.scalar_bits(m, elem_ty);
    var i: u32 = 0;
    for (i < fn.instr_len) { vset[i] = false; i = i + 1; }
    i = 0;
    for (i < access_count) {
        if (!accesses[i].is_store) { vset[accesses[i].instr::u32] = true; }
        i = i + 1;
    }
    val lp: *loops.Loop = ?la.loops[lx];
    var changed: bool = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < lp.body_len) {
            if (lp.body[bi] == lp.header) { bi = bi + 1; cnt; }
            val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
            if (admit_joins && lp.body[bi] == lp.latch) {
                var pi: u32 = 0;
                for (pi < blk.phi_count) {
                    val pid: id.InstructionId = blk.phis[pi];
                    if (vset[pid::u32] == false) {
                        val popt: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
                        if (sel popt.some) {
                            val phi: *instruction.Instruction = popt.some;
                            if (phi.ty == elem_ty && phi_incomings_vectorizable(phi, fn, la, lx, elem_ty, allow_splat, vset)) {
                                vset[pid::u32] = true;
                                changed = true;
                            }
                        }
                    }
                    pi = pi + 1;
                }
            }
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val iid: id.InstructionId = blk.instructions[ii];
                if (vset[iid::u32] == false) {
                    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
                    if (sel opt_.some) {
                        val inst: *instruction.Instruction = opt_.some;
                        var type_ok: bool = inst.ty == elem_ty;
                        if (iid == mask_cmp && is_mask_compare(inst.kind)) { type_ok = true; }
                        if (admits(tgt, inst.kind, iid, is_float, lane_bits, mask_cmp) && type_ok && operands_vectorizable(inst, fn, la, lx, elem_ty, allow_splat, vset)) {
                            vset[iid::u32] = true;
                            changed = true;
                        }
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

fun phi_incomings_vectorizable(phi: *instruction.Instruction, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, elem_ty: ir_type.IrTypeId, allow_splat: bool, vset: *bool) bool {
    if (phi.operand_count != 4) { ret false; }
    var o: u32 = 1;
    for (o < phi.operand_count) {
        val v: value.Value = phi.operands[o];
        if (v.kind == value.VAL_INSTR && v.data.instr::u32 < fn.instr_len && vset[v.data.instr::u32]) { }
        or {
            if (!allow_splat || !splattable(v, la, lx, elem_ty)) { ret false; }
        }
        o = o + 2;
    }
    ret true;
}

fun operands_vectorizable(inst: *instruction.Instruction, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, elem_ty: ir_type.IrTypeId, allow_splat: bool, vset: *bool) bool {
    if (inst.operand_count == 0) { ret false; }
    var from_set: bool = false;
    var o: u32 = 0;
    for (o < inst.operand_count) {
        val op: value.Value = inst.operands[o];
        if (op.kind == value.VAL_INSTR && op.data.instr::u32 < fn.instr_len && vset[op.data.instr::u32]) {
            from_set = true;
        } or {
            if (!allow_splat || !splattable(op, la, lx, elem_ty)) { ret false; }
        }
        o = o + 1;
    }
    ret from_set;
}

fun splattable(v: value.Value, la: *loops.LoopAnalysis, lx: u32, elem_ty: ir_type.IrTypeId) bool {
    if (v.ty != elem_ty) { ret false; }
    if (v.kind != value.VAL_CONST_INT && v.kind != value.VAL_CONST_FLOAT && v.kind != value.VAL_PARAM && v.kind != value.VAL_INSTR) { ret false; }
    ret loops.is_invariant(la, lx, v);
}

fun is_mask_compare(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}


fun pred_mask(p: *PredShape) id.InstructionId {
    if (p.ok) { ret p.cmp; }
    ret id.INSTR_NIL;
}

fun admits(tgt: *target.Target, k: instruction.InstrKind, iid: id.InstructionId, is_float: bool, lane_bits: u32, mask_cmp: id.InstructionId) bool {
    if (is_mask_compare(k)) { ret iid == mask_cmp && mask_cmp != id.INSTR_NIL; }
    ret supported_vector_op(tgt, k, is_float, lane_bits);
}

fun supported_vector_op(tgt: *target.Target, k: instruction.InstrKind, is_float: bool, lane_bits: u32) bool {
    if (!in_increment_table(k, is_float)) { ret false; }
    ret vecform.packs(tgt, k, is_float, lane_bits);
}

fun in_increment_table(k: instruction.InstrKind, is_float: bool) bool {
    if (is_float) { ret opdesc.has(k, opdesc.EFF_VEC_INCR_FLOAT); }
    ret opdesc.has(k, opdesc.EFF_VEC_INCR_INT);
}


fun vectorize_one(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, d0: *dep.DepInfo) res[bool, fail.Fail] {
    val lp0: *loops.Loop = ?la.loops[lx];
    var pred0: PredShape;
    if (!loop_shape_ok(fn, lp0, ?pred0)) { ret res[bool, fail.Fail].ok{false}; }
    if (d0.verdict != dep.DEP_INDEPENDENT) { ret res[bool, fail.Fail].ok{false}; }
    var shape: MapShape;
    if (!map_shape(tgt, d0, ?shape)) { ret res[bool, fail.Fail].ok{false}; }
    shape.is_float = ir_type.is_float_scalar(?m.types, shape.elem_ty);

    val iv_ty: ir_type.IrTypeId = lp0.iv.init.ty;
    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, shape.elem_ty, shape.lanes);
    if (sel rvt.err) { ret res[bool, fail.Fail].err{rvt.err}; }
    val vec_ty: ir_type.IrTypeId = rvt.ok;

    val rvr: res[ver.VersionResult, fail.Fail] = ver.version_loop(m, fn, la, lx, d0);
    if (sel rvr.err) { ret res[bool, fail.Fail].err{rvr.err}; }
    var vr: ver.VersionResult = rvr.ok;
    if (vr.status != ver.VERSION_OK) { ver.version_result_dnit(?vr, m.alloc); ret res[bool, fail.Fail].ok{false}; }
    val fast_header: id.BlockId = vr.fast_header;
    val merge: id.BlockId = vr.merge;
    val guard: id.BlockId = vr.guard;
    val bound_ex: value.Value = vr.bound_ex;
    ver.version_result_dnit(?vr, m.alloc);

    val rvp: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rvp.err) { ret res[bool, fail.Fail].err{rvp.err}; }
    val vpre: id.BlockId = rvp.ok;
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, vpre);
    val r_539: err[fail.Fail] = builder.emit_br(?b, fast_header);
    if (sel r_539.err) { ret res[bool, fail.Fail].err{fail.message("vectorize: preheader branch")}; }
    ver.redirect_terminator(fn, guard, fast_header, vpre);
    ver.relabel_phi_pred(fn, fast_header, guard, vpre);

    val ra: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, m.alloc);
    if (sel ra.err) { ret res[bool, fail.Fail].err{ra.err}; }
    var fla: loops.LoopAnalysis = ra.ok;
    val flx: u32 = find_loop_by_header(?fla, fast_header);
    if (flx == ver.NONE_U32) {
        loops.dnit(?fla);
        panic("mach.lang.me.transform.vectorize: versioned clone lost its loop header; the clone must reproduce the shape already proven on the unmutated original before commit\n");
    }
    val rdd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?fla, flx, ?m.types, m.alloc);
    if (sel rdd.err) { loops.dnit(?fla); ret res[bool, fail.Fail].err{rdd.err}; }
    var fd: dep.DepInfo = rdd.ok;

    val flp: *loops.Loop = ?fla.loops[flx];
    var fshape: MapShape;
    var fpred: PredShape;
    var fast_ok: bool = loop_shape_ok(fn, flp, ?fpred) && fd.verdict == dep.DEP_INDEPENDENT && map_shape(tgt, ?fd, ?fshape);
    if (fast_ok && fshape.elem_ty != shape.elem_ty) { fast_ok = false; }
    if (fast_ok && fpred.ok != pred0.ok)            { fast_ok = false; }
    if (fast_ok && fpred.ok && shape.is_float)      { fast_ok = false; }
    if (!fast_ok) {
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        panic("mach.lang.me.transform.vectorize: versioned clone failed the shape/dependence proof its unmutated original already satisfied; the pre-clone check in vectorizable() must be the sole gate, never a post-clone decline\n");
    }
    fshape.is_float = shape.is_float;

    val fast_iv_phi: id.InstructionId = flp.iv.phi;
    val fast_cmp: id.InstructionId = flp.counted.cmp;
    val iv_phi_val: value.Value = value.instr(fast_iv_phi, iv_ty);

    val body_len: u32 = flp.body_len;
    val rfb: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rfb.err) { dep.dep_dnit(?fd); loops.dnit(?fla); ret res[bool, fail.Fail].err{fail.refused(rfb.err)}; }
    val fbody: *id.BlockId = rfb.ok;
    var ci: u32 = 0;
    for (ci < body_len) { fbody[ci] = flp.body[ci]; ci = ci + 1; }

    val rrc: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rrc.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); dep.dep_dnit(?fd); loops.dnit(?fla); ret res[bool, fail.Fail].err{fail.refused(rrc.err)}; }
    val rem_blocks: *id.BlockId = rrc.ok;
    val rcl: err[fail.Fail] = ver.clone_region(m, fn, fbody, body_len, rem_blocks);
    if (sel rcl.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize); dep.dep_dnit(?fd); loops.dnit(?fla); ret res[bool, fail.Fail].err{rcl.err}; }
    val rem_header: id.BlockId = rem_blocks[ver.region_index(fbody, body_len, fast_header)];

    if (fpred.ok) {
        val rif: err[fail.Fail] = if_convert(m, fn, flp, ?fpred, fshape.elem_ty);
        if (sel rif.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize); dep.dep_dnit(?fd); loops.dnit(?fla); ret res[bool, fail.Fail].err{rif.err}; }
    }

    val rset: res[*bool, A.Error] = A.allocate[bool](m.alloc, fn.instr_len::usize);
    if (sel rset.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize); dep.dep_dnit(?fd); loops.dnit(?fla); ret res[bool, fail.Fail].err{fail.refused(rset.err)}; }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, ?fla, flx, fd.accesses, fd.access_count, fshape.elem_ty, fshape.is_float, true, false, pred_mask(?fpred), vset);
    retype_to_vector(fn, flp, vset, vec_ty);
    val rsp: err[fail.Fail] = splat_invariants(m, tgt, fn, flp, vset, vpre, fast_header, ?fshape, vec_ty);
    A.deallocate[bool](m.alloc, vset, fn.instr_len::usize);
    if (sel rsp.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize); dep.dep_dnit(?fd); loops.dnit(?fla); ret res[bool, fail.Fail].err{rsp.err}; }

    val rss: err[fail.Fail] = scale_recurrence_steps(fn, flp, shape.lanes);
    if (sel rss.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize); dep.dep_dnit(?fd); loops.dnit(?fla); ret res[bool, fail.Fail].err{rss.err}; }

    var le_kind: instruction.InstrKind = instruction.OP_CMP_LE_S;
    if (flp.counted.pred == instruction.OP_CMP_LT_U || flp.counted.pred == instruction.OP_CMP_LE_U) {
        le_kind = instruction.OP_CMP_LE_U;
    }
    val rrem: res[value.Value, fail.Fail] =
        emit_add_prepend(m, fn, fast_header, iv_phi_val, value.const_int(shape.lanes::u64, iv_ty), iv_ty, fast_cmp);
    if (sel rrem.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{rrem.err};
    }
    val iv_plus_lanes: value.Value = rrem.ok;

    val copt: opt[*instruction.Instruction] = ir.instruction_get(fn, fast_cmp);
    if (sel copt.some) {
        val cmp: *instruction.Instruction = copt.some;
        cmp.kind = le_kind;
        cmp.operands[0] = iv_plus_lanes;
        cmp.operands[1] = bound_ex;
    }

    ver.redirect_terminator(fn, fast_header, merge, rem_header);
    val rer: bool = enter_remainder_from(fn, rem_header, vpre, fast_header);

    A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
    A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
    dep.dep_dnit(?fd);
    loops.dnit(?fla);
    if (!rer) { ret res[bool, fail.Fail].err{fail.message("vectorize: remainder header phis do not mirror the vector header's")}; }

    val rpr: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel rpr.err) { ret res[bool, fail.Fail].err{rpr.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun if_convert(m: *ir.Module, fn: *ir.Function, lp: *loops.Loop, p: *PredShape, elem_ty: ir_type.IrTypeId) err[fail.Fail] {
    val latch: id.BlockId = lp.latch;

    val lb0: *ir.Block = ?fn.blocks[latch::u32];
    val np: u32 = lb0.phi_count;
    if (np == 0) { ret err[fail.Fail].err{fail.message("vectorize: predicated latch lost its join phis")}; }
    val rj: res[*SelectSite, A.Error] = A.allocate[SelectSite](m.alloc, np::usize);
    if (sel rj.err) { ret err[fail.Fail].err{fail.refused(rj.err)}; }
    val joins: *SelectSite = rj.ok;
    var i: u32 = 0;
    for (i < np) {
        joins[i].phi   = lb0.phis[i];
        joins[i].t_val = phi_value_from(fn, lb0.phis[i], p.t_arm);
        joins[i].f_val = phi_value_from(fn, lb0.phis[i], p.f_arm);
        joins[i].ty    = fn.instrs[lb0.phis[i]::u32].ty;
        i = i + 1;
    }

    fn.instrs[p.cmp::u32].ty = elem_ty;

    val term_e: id.InstructionId = fn.blocks[p.entry::u32].terminator;
    fn.blocks[p.entry::u32].terminator = id.INSTR_NIL;
    val mask: value.Value = value.instr(p.cmp, elem_ty);
    i = 0;
    for (i < np) {
        val rs: res[value.Value, fail.Fail] = emit_select(m, fn, p.entry, mask, ?joins[i]);
        if (sel rs.err) {
            fn.blocks[p.entry::u32].terminator = term_e;
            A.deallocate[SelectSite](m.alloc, joins, np::usize);
            ret err[fail.Fail].err{rs.err};
        }
        mutate.replace_uses(fn, joins[i].phi, rs.ok);
        i = i + 1;
    }
    fn.blocks[p.entry::u32].terminator = term_e;
    fn.blocks[latch::u32].phi_count = 0;
    A.deallocate[SelectSite](m.alloc, joins, np::usize);

    val eb: *ir.Block = ?fn.blocks[p.entry::u32];
    var k: u32 = eb.instr_count;
    for (k > 0) {
        k = k - 1;
        val rp: err[fail.Fail] = ir.block_prepend_instr(m, ?fn.blocks[latch::u32], eb.instructions[k]);
        if (sel rp.err) { ret rp; }
    }
    fn.blocks[p.entry::u32].instr_count = 0;

    val rmu: err[fail.Fail] = make_unconditional(m, fn, p.entry, latch);
    if (sel rmu.err) { ret rmu; }

    val rpr: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel rpr.err) { ret rpr; }
    ret err[fail.Fail].ok{};
}

fun make_unconditional(m: *ir.Module, fn: *ir.Function, blk: id.BlockId, to: id.BlockId) err[fail.Fail] {
    val b: *ir.Block = ?fn.blocks[blk::u32];
    if (b.terminator == id.INSTR_NIL) { ret err[fail.Fail].err{fail.message("vectorize: if-convert block has no terminator")}; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, b.terminator);
    if (sel opt_.none) { ret err[fail.Fail].err{fail.message("vectorize: if-convert terminator is missing")}; }
    val rt: res[value.Value, fail.Fail] = ir.block_target_make(m, to);
    if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
    val ra: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(m, 1);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val ops: ir.OperandArray = ra.ok;
    ops.ops[0] = rt.ok;
    val term: *instruction.Instruction = opt_.some;
    term.kind = instruction.OP_BR;
    ir.instr_replace_operands(m, term, ops);
    ret err[fail.Fail].ok{};
}

rec SelectSite {
    phi:   id.InstructionId;
    t_val: value.Value;
    f_val: value.Value;
    ty:    ir_type.IrTypeId;
}

fun emit_select(m: *ir.Module, fn: *ir.Function, blk: id.BlockId, mask: value.Value, s: *SelectSite) res[value.Value, fail.Fail] {
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, blk);
    val rt: res[value.Value, fail.Fail] = builder.emit_and(?b, value.retype(mask, s.ty), s.t_val);
    if (sel rt.err) { ret rt; }
    val rn: res[value.Value, fail.Fail] = builder.emit_not(?b, value.retype(mask, s.ty));
    if (sel rn.err) { ret rn; }
    val rf: res[value.Value, fail.Fail] = builder.emit_and(?b, rn.ok, s.f_val);
    if (sel rf.err) { ret rf; }
    ret builder.emit_or(?b, rt.ok, rf.ok);
}

fun emit_add_prepend(m: *ir.Module, fn: *ir.Function, blk: id.BlockId, lhs: value.Value, rhs: value.Value, ty: ir_type.IrTypeId, loc_ref: id.InstructionId) res[value.Value, fail.Fail] {
    val rops: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(m, 2);
    if (sel rops.err) { ret res[value.Value, fail.Fail].err{rops.err}; }
    val arr: ir.OperandArray = rops.ok;
    arr.ops[0] = lhs;
    arr.ops[1] = rhs;

    var ni: instruction.Instruction;
    ni.kind          = instruction.OP_ADD;
    ni.ty            = ty;
    ni.operands      = arr.ops;
    ni.operand_count = 2;
    ni.operand_cap   = 2;
    ni.flags         = 0;
    ni.aux_ty        = ir_type.IRT_NIL;
    ni.loc           = fn.instrs[loc_ref::u32].loc;
    ni.secret        = false;

    val ri: res[id.InstructionId, fail.Fail] = ir.instruction_add(m, fn, ni);
    if (sel ri.err) {
        A.deallocate[value.Value](m.alloc, arr.ops, 2::usize);
        ret res[value.Value, fail.Fail].err{ri.err};
    }
    val iid: id.InstructionId = ri.ok;

    val rp: err[fail.Fail] = ir.block_prepend_instr(m, ?fn.blocks[blk::u32], iid);
    if (sel rp.err) { ret res[value.Value, fail.Fail].err{rp.err}; }

    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

fun retype_to_vector(fn: *ir.Function, lp: *loops.Loop, vset: *bool, vec_ty: ir_type.IrTypeId) {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        if (vset[i]) { fn.instrs[i].ty = vec_ty; }
        i = i + 1;
    }
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val inst: *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
            var o: u32 = 0;
            for (o < inst.operand_count) {
                if (inst.operands[o].kind == value.VAL_INSTR && vset[inst.operands[o].data.instr::u32]) {
                    inst.operands[o] = value.retype(inst.operands[o], vec_ty);
                }
                o = o + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fun body_operand_slots(fn: *ir.Function, lp: *loops.Loop) u32 {
    var n: u32 = 0;
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            n = n + fn.instrs[blk.instructions[ii]::u32].operand_count;
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret n;
}

fun splat_invariants(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, lp: *loops.Loop, vset: *bool, vpre: id.BlockId, fast_header: id.BlockId, shape: *MapShape, vec_ty: ir_type.IrTypeId) err[fail.Fail] {
    val cap: u32 = body_operand_slots(fn, lp);
    if (cap == 0) { ret err[fail.Fail].ok{}; }
    val rss: res[*SplatSite, A.Error] = A.allocate[SplatSite](m.alloc, cap::usize);
    if (sel rss.err) { ret err[fail.Fail].err{fail.refused(rss.err)}; }
    val sites: *SplatSite = rss.ok;
    val rse: res[*SplatEntry, A.Error] = A.allocate[SplatEntry](m.alloc, cap::usize);
    if (sel rse.err) { A.deallocate[SplatSite](m.alloc, sites, cap::usize); ret err[fail.Fail].err{fail.refused(rse.err)}; }
    val cache: *SplatEntry = rse.ok;

    var n: u32 = 0;
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            val inst: *instruction.Instruction = ?fn.instrs[iid::u32];
            if (vset[iid::u32] && supported_vector_op(tgt, inst.kind, shape.is_float, vecform.scalar_bits(m, shape.elem_ty))) {
                var o: u32 = 0;
                for (o < inst.operand_count) {
                    val op: value.Value = inst.operands[o];
                    if (op.kind != value.VAL_INSTR || op.data.instr::u32 >= fn.instr_len || !vset[op.data.instr::u32]) {
                        sites[n].instr = iid;
                        sites[n].slot  = o;
                        sites[n].val   = op;
                        n = n + 1;
                    }
                    o = o + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if (n == 0) { splat_free(m, sites, cache, cap); ret err[fail.Fail].ok{}; }

    val rat: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, shape.elem_ty, shape.lanes);
    if (sel rat.err) { splat_free(m, sites, cache, cap); ret err[fail.Fail].err{rat.err}; }
    val arr_ty: ir_type.IrTypeId = rat.ok;

    val rsb: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rsb.err) { splat_free(m, sites, cache, cap); ret err[fail.Fail].err{rsb.err}; }
    val spre: id.BlockId = rsb.ok;
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, spre);
    var cn: u32 = 0;
    var i: u32 = 0;
    for (i < n) {
        if (splat_lookup(cache, cn, sites[i].val) == ver.NONE_U32) {
            val rsv: res[value.Value, fail.Fail] = emit_splat(?b, sites[i].val, arr_ty, vec_ty, shape.lanes);
            if (sel rsv.err) { splat_free(m, sites, cache, cap); ret err[fail.Fail].err{rsv.err}; }
            cache[cn].key = sites[i].val;
            cache[cn].vec = rsv.ok;
            cn = cn + 1;
        }
        i = i + 1;
    }
    val r_863: err[fail.Fail] = builder.emit_br(?b, fast_header);
    if (sel r_863.err) { splat_free(m, sites, cache, cap); ret err[fail.Fail].err{fail.message("vectorize: splat block branch")}; }
    ver.redirect_terminator(fn, vpre, fast_header, spre);
    ver.relabel_phi_pred(fn, fast_header, vpre, spre);

    i = 0;
    for (i < n) {
        val ci: u32 = splat_lookup(cache, cn, sites[i].val);
        if (ci != ver.NONE_U32) {
            val inst: *instruction.Instruction = ?fn.instrs[sites[i].instr::u32];
            inst.operands[sites[i].slot] = cache[ci].vec;
        }
        i = i + 1;
    }
    splat_free(m, sites, cache, cap);
    ret err[fail.Fail].ok{};
}

fun splat_free(m: *ir.Module, sites: *SplatSite, cache: *SplatEntry, cap: u32) {
    A.deallocate[SplatSite](m.alloc, sites, cap::usize);
    A.deallocate[SplatEntry](m.alloc, cache, cap::usize);
}

fun splat_lookup(cache: *SplatEntry, cn: u32, v: value.Value) u32 {
    var i: u32 = 0;
    for (i < cn) {
        if (dep.equal(cache[i].key, v)) { ret i; }
        i = i + 1;
    }
    ret ver.NONE_U32;
}

fun emit_splat(b: *builder.Builder, v: value.Value, arr_ty: ir_type.IrTypeId, vec_ty: ir_type.IrTypeId, lanes: u32) res[value.Value, fail.Fail] {
    val rit: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?b.m.types, 64);
    if (sel rit.err) { ret res[value.Value, fail.Fail].err{rit.err}; }
    val idx_ty: ir_type.IrTypeId = rit.ok;
    val ras: res[value.Value, fail.Fail] = builder.emit_alloca(b, arr_ty, value.const_int(1, idx_ty));
    if (sel ras.err) { ret ras; }
    val slot: value.Value = ras.ok;
    var lane: u32 = 0;
    for (lane < lanes) {
        val rg: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, lane, idx_ty);
        if (sel rg.err) { ret rg; }
        val r_905: err[fail.Fail] = builder.emit_store(b, v, rg.ok);
        if (sel r_905.err) { ret res[value.Value, fail.Fail].err{fail.message("vectorize: splat store")}; }
        lane = lane + 1;
    }
    ret builder.emit_load(b, slot, vec_ty);
}

fun latch_update(fn: *ir.Function, pid: id.InstructionId, latch: id.BlockId) id.InstructionId {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret id.INSTR_NIL; }
    val phi: *instruction.Instruction = opt_.some;
    var o: u32 = 0;
    for (o < phi.operand_count) {
        if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == latch && o + 1 < phi.operand_count) {
            if (phi.operands[o + 1].kind == value.VAL_INSTR) { ret phi.operands[o + 1].data.instr; }
            ret id.INSTR_NIL;
        }
        o = o + 1;
    }
    ret id.INSTR_NIL;
}

fun scale_recurrence_steps(fn: *ir.Function, lp: *loops.Loop, lanes: u32) err[fail.Fail] {
    val hdr: *ir.Block = ?fn.blocks[lp.header::u32];
    var pi: u32 = 0;
    for (pi < hdr.phi_count) {
        val uid: id.InstructionId = latch_update(fn, hdr.phis[pi], lp.latch);
        if (uid == id.INSTR_NIL) { ret err[fail.Fail].err{fail.message("vectorize: loop recurrence has no latch update")}; }
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, uid);
        if (sel opt_.none) { ret err[fail.Fail].err{fail.message("vectorize: loop recurrence update is missing")}; }
        val upd: *instruction.Instruction = opt_.some;
        var scaled: bool = false;
        var si: u32 = 0;
        for (si < upd.operand_count) {
            if (upd.operands[si].kind == value.VAL_CONST_INT) {
                upd.operands[si] = value.const_int(upd.operands[si].data.int_lit * lanes::u64, upd.operands[si].ty);
                scaled = true;
            }
            si = si + 1;
        }
        if (!scaled) { ret err[fail.Fail].err{fail.message("vectorize: loop recurrence has no constant step")}; }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun enter_remainder_from(fn: *ir.Function, rem_header: id.BlockId, from: id.BlockId, vec_header: id.BlockId) bool {
    val rb: *ir.Block = ?fn.blocks[rem_header::u32];
    val vb: *ir.Block = ?fn.blocks[vec_header::u32];
    if (rb.phi_count != vb.phi_count) { ret false; }
    var pi: u32 = 0;
    for (pi < rb.phi_count) {
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, rb.phis[pi]);
        if (sel opt_.none) { ret false; }
        val phi: *instruction.Instruction = opt_.some;
        val src: value.Value = value.instr(vb.phis[pi], phi.ty);
        var o: u32 = 0;
        for (o < phi.operand_count) {
            if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == from) {
                phi.operands[o].data.int_lit = vec_header::u64;
                if (o + 1 < phi.operand_count) { phi.operands[o + 1] = value.retype(src, phi.operands[o + 1].ty); }
            }
            o = o + 1;
        }
        pi = pi + 1;
    }
    ret true;
}

fun run_reductions(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, float_reassoc: bool) res[bool, fail.Fail] {
    var changed: bool = false;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, m.alloc);
    if (sel ral.err) { ret res[bool, fail.Fail].err{ral.err}; }
    var la: loops.LoopAnalysis = ral.ok;

    val cap: u32 = la.loop_len + 1;
    val rhh: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, cap::usize);
    if (sel rhh.err) { loops.dnit(?la); ret res[bool, fail.Fail].err{fail.refused(rhh.err)}; }
    val headers: *id.BlockId = rhh.ok;
    val rra: res[*dep.ReductionInfo, A.Error] = A.allocate[dep.ReductionInfo](m.alloc, cap::usize);
    if (sel rra.err) { A.deallocate[id.BlockId](m.alloc, headers, cap::usize); loops.dnit(?la); ret res[bool, fail.Fail].err{fail.refused(rra.err)}; }
    val reds: *dep.ReductionInfo = rra.ok;

    var hn: u32 = 0;
    var lx: u32 = 0;
    for (lx < la.loop_len) {
        var ri: dep.ReductionInfo;
        val candidate_r: res[bool, fail.Fail] = reduction_candidate(m, tgt, fn, ?la, lx, float_reassoc, ?ri);
        if (sel candidate_r.err) { free_reds(m, headers, reds, hn, cap); loops.dnit(?la); ret candidate_r; }
        if (candidate_r.ok) { headers[hn] = la.loops[lx].header; reds[hn] = ri; hn = hn + 1; }
        lx = lx + 1;
    }
    loops.dnit(?la);

    var hi: u32 = 0;
    for (hi < hn) {
        val ra2: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, m.alloc);
        if (sel ra2.err) { free_reds(m, headers, reds, hn, cap); ret res[bool, fail.Fail].err{ra2.err}; }
        var la2: loops.LoopAnalysis = ra2.ok;
        val lx2: u32 = find_loop_by_header(?la2, headers[hi]);
        if (lx2 != ver.NONE_U32) {
            val vectorized_r: res[bool, fail.Fail] = vectorize_reduction(m, tgt, fn, ?la2, lx2, ?reds[hi]);
            if (sel vectorized_r.err) { loops.dnit(?la2); free_reds(m, headers, reds, hn, cap); ret vectorized_r; }
            if (vectorized_r.ok) { changed = true; }
        }
        loops.dnit(?la2);
        hi = hi + 1;
    }
    free_reds(m, headers, reds, hn, cap);
    ret res[bool, fail.Fail].ok{changed};
}

fun free_reds(m: *ir.Module, headers: *id.BlockId, reds: *dep.ReductionInfo, hn: u32, cap: u32) {
    var i: u32 = 0;
    for (i < hn) { dep.reduction_dnit(?reds[i]); i = i + 1; }
    A.deallocate[id.BlockId](m.alloc, headers, cap::usize);
    A.deallocate[dep.ReductionInfo](m.alloc, reds, cap::usize);
}

fun reduction_candidate(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, float_reassoc: bool, out_ri: *dep.ReductionInfo) res[bool, fail.Fail] {
    val lp: *loops.Loop = ?la.loops[lx];
    if (!reduction_shape_ok(lp)) { ret res[bool, fail.Fail].ok{false}; }
    val rr: res[dep.ReductionInfo, fail.Fail] = dep.analyze_reduction(fn, la, lx, ?m.types, m.alloc, float_reassoc);
    if (sel rr.err) { ret res[bool, fail.Fail].err{rr.err}; }
    var ri: dep.ReductionInfo = rr.ok;
    if (!ri.ok) { dep.reduction_dnit(?ri); ret res[bool, fail.Fail].ok{false}; }
    if (!rv_is_vector_tree(m, tgt, fn, la, lx, ?ri)) { dep.reduction_dnit(?ri); ret res[bool, fail.Fail].ok{false}; }
    @out_ri = ri;
    ret res[bool, fail.Fail].ok{true};
}

fun reduction_shape_ok(lp: *loops.Loop) bool {
    if (!lp.is_counted) { ret false; }
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL || lp.exit == id.BLOCK_NIL || lp.exiting == id.BLOCK_NIL) { ret false; }
    if (!lp.counted.iv_on_left || !lp.counted.continue_on_true) { ret false; }
    if (lp.iv.step.kind != value.VAL_CONST_INT || lp.iv.step.data.int_lit != 1) { ret false; }
    if (lp.body_len != 2 || lp.latch == lp.header) { ret false; }
    ret true;
}

fun rv_is_vector_tree(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, ri: *dep.ReductionInfo) bool {
    val rset: res[*bool, A.Error] = A.allocate[bool](m.alloc, fn.instr_len::usize);
    if (sel rset.err) { ret false; }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, la, lx, ri.accesses, ri.access_count, ri.elem_ty, ri.is_float, false, false, id.INSTR_NIL, vset);
    var ok: bool = ri.rv.kind == value.VAL_INSTR && ri.rv.data.instr::u32 < fn.instr_len && vset[ri.rv.data.instr::u32];
    A.deallocate[bool](m.alloc, vset, fn.instr_len::usize);
    ret ok;
}

fun reduction_identity(op: instruction.InstrKind, elem_ty: ir_type.IrTypeId, is_float: bool) value.Value {
    if (is_float) {
        if (op == instruction.OP_MUL) { ret value.const_float(1.0, elem_ty); }
        ret value.const_float(-0.0, elem_ty);
    }
    if (op == instruction.OP_AND) { ret value.const_int(0xFFFFFFFFFFFFFFFF, elem_ty); }
    ret value.const_int(0, elem_ty);
}

fun emit_reduction_op(b: *builder.Builder, op: instruction.InstrKind, x: value.Value, y: value.Value) res[value.Value, fail.Fail] {
    if (op == instruction.OP_XOR) { ret builder.emit_xor(b, x, y); }
    if (op == instruction.OP_OR)  { ret builder.emit_or(b, x, y); }
    if (op == instruction.OP_AND) { ret builder.emit_and(b, x, y); }
    if (op == instruction.OP_MUL) { ret builder.emit_mul(b, x, y); }
    ret builder.emit_add(b, x, y);
}

fun vectorize_reduction(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, ri: *dep.ReductionInfo) res[bool, fail.Fail] {
    val lp: *loops.Loop = ?la.loops[lx];
    if (!reduction_shape_ok(lp)) { ret res[bool, fail.Fail].ok{false}; }

    val header:    id.BlockId = lp.header;
    val latch:     id.BlockId = lp.latch;
    val preheader: id.BlockId = lp.preheader;
    val exit:      id.BlockId = lp.exit;
    val iv_phi:    id.InstructionId = lp.iv.phi;
    val iv_upd:    id.InstructionId = lp.iv.update;
    val iv_ty:     ir_type.IrTypeId = lp.iv.init.ty;
    val cmp_id:    id.InstructionId = lp.counted.cmp;
    val orig_pred: instruction.InstrKind = lp.counted.pred;
    val lanes:     u32 = ri.lanes;
    val elem_ty:   ir_type.IrTypeId = ri.elem_ty;
    val is_float:  bool = ri.is_float;
    val red_op:    instruction.InstrKind = ri.op;
    val acc_phi:   id.InstructionId = ri.acc_phi;
    val acc_upd:   id.InstructionId = ri.acc_update;
    val acc_init:  value.Value = ri.acc_init;

    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, elem_ty, lanes);
    if (sel rvt.err) { ret res[bool, fail.Fail].err{rvt.err}; }
    val vec_ty: ir_type.IrTypeId = rvt.ok;
    val rat: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, elem_ty, lanes);
    if (sel rat.err) { ret res[bool, fail.Fail].err{rat.err}; }
    val arr_ty: ir_type.IrTypeId = rat.ok;
    val rot: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rot.err) { ret res[bool, fail.Fail].err{rot.err}; }
    val ord_ty: ir_type.IrTypeId = rot.ok;

    val hblk: *ir.Block = ?fn.blocks[header::u32];
    val acc_idx: u32 = phi_index(hblk, acc_phi);
    val iv_idx:  u32 = phi_index(hblk, iv_phi);

    val body_len: u32 = lp.body_len;
    val rfb: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rfb.err) { ret res[bool, fail.Fail].err{fail.refused(rfb.err)}; }
    val fbody: *id.BlockId = rfb.ok;
    var ci: u32 = 0;
    for (ci < body_len) { fbody[ci] = lp.body[ci]; ci = ci + 1; }
    val rrc: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rrc.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); ret res[bool, fail.Fail].err{fail.refused(rrc.err)}; }
    val rem: *id.BlockId = rrc.ok;
    val rcl: err[fail.Fail] = ver.clone_region(m, fn, fbody, body_len, rem);
    if (sel rcl.err) { A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize); A.deallocate[id.BlockId](m.alloc, rem, body_len::usize); ret res[bool, fail.Fail].err{rcl.err}; }
    val rem_header: id.BlockId = rem[ver.region_index(fbody, body_len, header)];
    val rblk: *ir.Block = ?fn.blocks[rem_header::u32];
    val sacc: id.InstructionId = rblk.phis[acc_idx];
    val iv_r:  id.InstructionId = rblk.phis[iv_idx];
    A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
    A.deallocate[id.BlockId](m.alloc, rem, body_len::usize);

    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);

    val rvp: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rvp.err) { ret res[bool, fail.Fail].err{rvp.err}; }
    val vpre: id.BlockId = rvp.ok;
    builder.set_block(?b, vpre);
    val rv0: res[value.Value, fail.Fail] = build_accumulator_init(?b, red_op, acc_init, elem_ty, is_float, arr_ty, vec_ty, ord_ty, lanes);
    if (sel rv0.err) { ret res[bool, fail.Fail].err{rv0.err}; }
    val vacc0: value.Value = rv0.ok;
    val rbe: res[value.Value, fail.Fail] = ver.emit_exclusive_bound(?b, ?lp.counted);
    if (sel rbe.err) { ret res[bool, fail.Fail].err{rbe.err}; }
    val bound_ex: value.Value = rbe.ok;
    val r_1137: err[fail.Fail] = builder.emit_br(?b, header);
    if (sel r_1137.err) { ret res[bool, fail.Fail].err{fail.message("reduce: preheader branch")}; }
    ver.redirect_terminator(fn, preheader, header, vpre);
    ver.relabel_phi_pred(fn, header, preheader, vpre);
    set_phi_value(fn, header, vpre, acc_phi, vacc0);

    val rrp: err[fail.Fail] = replace_out_of_loop_uses(m, fn, acc_phi, value.instr(sacc, elem_ty), lp.body, lp.body_len, fn.instr_len);
    if (sel rrp.err) { ret res[bool, fail.Fail].err{rrp.err}; }

    val rcb: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rcb.err) { ret res[bool, fail.Fail].err{rcb.err}; }
    val combine: id.BlockId = rcb.ok;
    builder.set_block(?b, combine);
    val rhc: res[value.Value, fail.Fail] = emit_horizontal_combine(?b, red_op, value.instr(acc_phi, vec_ty), elem_ty, arr_ty, vec_ty, ord_ty, lanes);
    if (sel rhc.err) { ret res[bool, fail.Fail].err{rhc.err}; }
    val s0: value.Value = rhc.ok;
    val r_1152: err[fail.Fail] = builder.emit_br(?b, rem_header);
    if (sel r_1152.err) { ret res[bool, fail.Fail].err{fail.message("reduce: combine branch")}; }

    ver.redirect_terminator(fn, header, exit, combine);
    ver.relabel_phi_pred(fn, rem_header, preheader, combine);
    set_phi_value(fn, rem_header, combine, sacc, s0);
    set_phi_value(fn, rem_header, combine, iv_r, value.instr(iv_phi, iv_ty));

    val rset: res[*bool, A.Error] = A.allocate[bool](m.alloc, fn.instr_len::usize);
    if (sel rset.err) { ret res[bool, fail.Fail].err{fail.refused(rset.err)}; }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, la, lx, ri.accesses, ri.access_count, elem_ty, is_float, false, false, id.INSTR_NIL, vset);
    vset[acc_phi::u32] = true;
    vset[acc_upd::u32] = true;
    retype_to_vector(fn, lp, vset, vec_ty);
    A.deallocate[bool](m.alloc, vset, fn.instr_len::usize);

    step_iv_by_lanes(fn, iv_upd, lanes, iv_ty);

    var le_kind: instruction.InstrKind = instruction.OP_CMP_LE_S;
    if (orig_pred == instruction.OP_CMP_LT_U || orig_pred == instruction.OP_CMP_LE_U) {
        le_kind = instruction.OP_CMP_LE_U;
    }
    val rrem: res[value.Value, fail.Fail] =
        emit_add_prepend(m, fn, header, value.instr(iv_phi, iv_ty), value.const_int(lanes::u64, iv_ty), iv_ty, cmp_id);
    if (sel rrem.err) { ret res[bool, fail.Fail].err{rrem.err}; }
    val iv_plus_lanes: value.Value = rrem.ok;

    val copt: opt[*instruction.Instruction] = ir.instruction_get(fn, cmp_id);
    if (sel copt.some) {
        val cmp: *instruction.Instruction = copt.some;
        cmp.kind = le_kind;
        cmp.operands[0] = iv_plus_lanes;
        cmp.operands[1] = bound_ex;
    }

    val rpr: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel rpr.err) { ret res[bool, fail.Fail].err{rpr.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun phi_index(blk: *ir.Block, pid: id.InstructionId) u32 {
    var i: u32 = 0;
    for (i < blk.phi_count) { if (blk.phis[i] == pid) { ret i; } i = i + 1; }
    ret 0;
}

fun step_iv_by_lanes(fn: *ir.Function, iv_upd: id.InstructionId, lanes: u32, iv_ty: ir_type.IrTypeId) {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iv_upd);
    if (sel opt_.some) {
        val upd: *instruction.Instruction = opt_.some;
        var si: u32 = 0;
        for (si < upd.operand_count) {
            if (upd.operands[si].kind == value.VAL_CONST_INT) { upd.operands[si] = value.const_int(lanes::u64, iv_ty); }
            si = si + 1;
        }
    }
}

fun build_accumulator_init(b: *builder.Builder, op: instruction.InstrKind, acc_init: value.Value, elem_ty: ir_type.IrTypeId, is_float: bool, arr_ty: ir_type.IrTypeId, vec_ty: ir_type.IrTypeId, ord_ty: ir_type.IrTypeId, lanes: u32) res[value.Value, fail.Fail] {
    val ras: res[value.Value, fail.Fail] = builder.emit_alloca(b, arr_ty, value.const_int(1, ord_ty));
    if (sel ras.err) { ret ras; }
    val slot: value.Value = ras.ok;
    val ident: value.Value = reduction_identity(op, elem_ty, is_float);
    var lane: u32 = 0;
    for (lane < lanes) {
        val rg: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, lane, ord_ty);
        if (sel rg.err) { ret rg; }
        var v: value.Value = ident;
        if (lane == 0) { v = acc_init; }
        val r_1221: err[fail.Fail] = builder.emit_store(b, v, rg.ok);
        if (sel r_1221.err) { ret res[value.Value, fail.Fail].err{fail.message("reduce: init store")}; }
        lane = lane + 1;
    }
    ret builder.emit_load(b, slot, vec_ty);
}

fun emit_horizontal_combine(b: *builder.Builder, op: instruction.InstrKind, vacc: value.Value, elem_ty: ir_type.IrTypeId, arr_ty: ir_type.IrTypeId, vec_ty: ir_type.IrTypeId, ord_ty: ir_type.IrTypeId, lanes: u32) res[value.Value, fail.Fail] {
    val ras: res[value.Value, fail.Fail] = builder.emit_alloca(b, arr_ty, value.const_int(1, ord_ty));
    if (sel ras.err) { ret ras; }
    val slot: value.Value = ras.ok;
    val r_1231: err[fail.Fail] = builder.emit_store(b, vacc, slot);
    if (sel r_1231.err) { ret res[value.Value, fail.Fail].err{fail.message("reduce: combine store")}; }
    val rg0: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, 0, ord_ty);
    if (sel rg0.err) { ret rg0; }
    val rl0: res[value.Value, fail.Fail] = builder.emit_load(b, rg0.ok, elem_ty);
    if (sel rl0.err) { ret rl0; }
    var acc: value.Value = rl0.ok;
    var lane: u32 = 1;
    for (lane < lanes) {
        val rg: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, lane, ord_ty);
        if (sel rg.err) { ret rg; }
        val rl: res[value.Value, fail.Fail] = builder.emit_load(b, rg.ok, elem_ty);
        if (sel rl.err) { ret rl; }
        val rc: res[value.Value, fail.Fail] = emit_reduction_op(b, op, acc, rl.ok);
        if (sel rc.err) { ret rc; }
        acc = rc.ok;
        lane = lane + 1;
    }
    ret res[value.Value, fail.Fail].ok{acc};
}

fun lane_gep(b: *builder.Builder, slot: value.Value, arr_ty: ir_type.IrTypeId, lane: u32, idx_ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var idx: [2]value.Value;
    idx[0] = value.const_int(0, idx_ty);
    idx[1] = value.const_int(lane::u64, idx_ty);
    ret builder.emit_gep(b, slot, arr_ty, ?idx[0], 2);
}

fun set_phi_value(fn: *ir.Function, blk: id.BlockId, from: id.BlockId, pid: id.InstructionId, val_new: value.Value) {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret; }
    val phi: *instruction.Instruction = opt_.some;
    var o: u32 = 0;
    for (o < phi.operand_count) {
        if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == from && o + 1 < phi.operand_count) {
            phi.operands[o + 1] = value.retype(val_new, phi.operands[o + 1].ty);
        }
        o = o + 1;
    }
}

fun replace_out_of_loop_uses(m: *ir.Module, fn: *ir.Function, old_id: id.InstructionId, repl: value.Value, body: *id.BlockId, body_len: u32, limit: u32) err[fail.Fail] {
    val rmask: res[*bool, A.Error] = A.allocate[bool](m.alloc, limit::usize);
    if (sel rmask.err) { ret err[fail.Fail].err{fail.refused(rmask.err)}; }
    val in_loop: *bool = rmask.ok;
    var bi: u32 = 0;
    for (bi < body_len) {
        val blk: *ir.Block = ?fn.blocks[body[bi]::u32];
        var pi: u32 = 0;
        for (pi < blk.phi_count) { if (blk.phis[pi]::u32 < limit) { in_loop[blk.phis[pi]::u32] = true; } pi = pi + 1; }
        var ii: u32 = 0;
        for (ii < blk.instr_count) { if (blk.instructions[ii]::u32 < limit) { in_loop[blk.instructions[ii]::u32] = true; } ii = ii + 1; }
        if (blk.terminator != id.INSTR_NIL && blk.terminator::u32 < limit) { in_loop[blk.terminator::u32] = true; }
        bi = bi + 1;
    }
    var i: u32 = 0;
    for (i < limit) {
        if (!in_loop[i]) {
            val inst: *instruction.Instruction = ?fn.instrs[i];
            var o: u32 = 0;
            for (o < inst.operand_count) {
                if (inst.operands[o].kind == value.VAL_INSTR && inst.operands[o].data.instr == old_id) {
                    inst.operands[o] = value.retype(repl, inst.operands[o].ty);
                }
                o = o + 1;
            }
        }
        i = i + 1;
    }
    A.deallocate[bool](m.alloc, in_loop, limit::usize);
    ret err[fail.Fail].ok{};
}

use mach.lang.me.ir.verify;

fun mk_axpy_sig(m: *ir.Module, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, o_sig: *ir_type.IrTypeId) i32 {
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret 1; }
    var ps: [4]ir_type.IrTypeId;
    ps[0] = i64t; ps[1] = ptrt; ps[2] = ptrt; ps[3] = ptrt;
    val rfn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, rv.ok, ?ps[0], 4, false);
    if (sel rfn.err) { ret 1; }
    @o_sig = rfn.ok;
    ret 0;
}

fun build_axpy_variant(m: *ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, use_unsigned: bool, o_header: *id.BlockId) i32 {
    val re: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel re.err) { ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rh.err) { ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rb.err) { ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rx.err) { ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);
    val b: value.Value = value.param(2, ptrt);
    val c: value.Value = value.param(3, ptrt);

    builder.set_block(bld, entry);
    val r_1336: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_1336.err) { ret 1; }

    builder.set_block(bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(bld, i64t);
    if (sel rphi.err) { ret 1; }
    val iv: value.Value = rphi.ok;
    var rc: res[value.Value, fail.Fail];
    if (use_unsigned) { rc = builder.emit_cmp_lt_u(bld, iv, n); } or { rc = builder.emit_cmp_lt_s(bld, iv, n); }
    if (sel rc.err) { ret 1; }
    val r_1345: err[fail.Fail] = builder.emit_cbr(bld, rc.ok, body, exit);
    if (sel r_1345.err) { ret 1; }

    builder.set_block(bld, body);
    var ixb: [1]value.Value; ixb[0] = iv;
    val rgb: res[value.Value, fail.Fail] = builder.emit_gep(bld, b, i64t, ?ixb[0], 1);
    if (sel rgb.err) { ret 1; }
    val rlb: res[value.Value, fail.Fail] = builder.emit_load(bld, rgb.ok, i64t);
    if (sel rlb.err) { ret 1; }
    var ixc: [1]value.Value; ixc[0] = iv;
    val rgc: res[value.Value, fail.Fail] = builder.emit_gep(bld, c, i64t, ?ixc[0], 1);
    if (sel rgc.err) { ret 1; }
    val rlc: res[value.Value, fail.Fail] = builder.emit_load(bld, rgc.ok, i64t);
    if (sel rlc.err) { ret 1; }
    val rs: res[value.Value, fail.Fail] = builder.emit_add(bld, rlb.ok, rlc.ok);
    if (sel rs.err) { ret 1; }
    var ixa: [1]value.Value; ixa[0] = iv;
    val rga: res[value.Value, fail.Fail] = builder.emit_gep(bld, a, i64t, ?ixa[0], 1);
    if (sel rga.err) { ret 1; }
    val r_1363: err[fail.Fail] = builder.emit_store(bld, rs.ok, rga.ok);
    if (sel r_1363.err) { ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ret 1; }
    val upd: value.Value = ru.ok;
    val r_1367: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_1367.err) { ret 1; }

    builder.set_block(bld, exit);
    val r_1370: err[fail.Fail] = builder.emit_ret_void(bld);
    if (sel r_1370.err) { ret 1; }

    val r_1372: err[fail.Fail] = builder.phi_add_incoming(bld, iv, entry, value.const_int(0, i64t));
    if (sel r_1372.err) { ret 1; }
    val r_1373: err[fail.Fail] = builder.phi_add_incoming(bld, iv, body, upd);
    if (sel r_1373.err) { ret 1; }

    @o_header = header;
    ret 0;
}

fun cmp_kind_of(fn: *ir.Function, iid: id.InstructionId) instruction.InstrKind {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret instruction.OP_CMP_LT_S; }
    ret opt_.some.kind;
}

fun operand0_is_add(fn: *ir.Function, iid: id.InstructionId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret false; }
    val inst: *instruction.Instruction = opt_.some;
    if (inst.operand_count == 0 || inst.operands[0].kind != value.VAL_INSTR) { ret false; }
    val aopt: opt[*instruction.Instruction] = ir.instruction_get(fn, inst.operands[0].data.instr);
    if (sel aopt.none) { ret false; }
    ret aopt.some.kind == instruction.OP_ADD;
}

fun find_add_fed_counted_cmp(fn: *ir.Function, out_cmp: *id.InstructionId) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val iid: id.InstructionId = i::id.InstructionId;
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
        if (sel opt_.some) {
            val inst: *instruction.Instruction = opt_.some;
            if ((inst.kind == instruction.OP_CMP_LE_S || inst.kind == instruction.OP_CMP_LE_U) && operand0_is_add(fn, iid)) {
                @out_cmp = iid;
                ret true;
            }
        }
        i = i + 1;
    }
    ret false;
}

fun run_axpy_signedness(use_unsigned: bool, want_kind: instruction.InstrKind) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1417: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1417.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target = rtg.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_axpy_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var header: id.BlockId;
    if (build_axpy_variant(?m, ?bld, i64t, ptrt, use_unsigned, ?header) != 0) { ir.dnit(?m); ret 1; }

    val changed_r: res[bool, fail.Fail] = run(?m, ?tgt, false);
    if (sel changed_r.err) { ir.dnit(?m); ret 1; }
    if (!changed_r.ok) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?alloc);
    if (sel ral.err) { ir.dnit(?m); ret 1; }
    var la: loops.LoopAnalysis = ral.ok;
    var found_cmp: id.InstructionId = id.INSTR_NIL;
    if (!find_add_fed_counted_cmp(fn, ?found_cmp)) { code = 1; }
    or {
        if (cmp_kind_of(fn, found_cmp) != want_kind) { code = 1; }
    }

    val rvr: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(?tgt, true, false));
    if (sel rvr.err) { code = 1; }
    or (sel rvr.ok) {
        var rep: verify.VerifyReport = rvr.ok;
        if (rep.len != 0) { code = 1; }
        verify.dnit_report(?rep);
    }

    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.vectorize:tail_guard_preserves_source_signedness" {
    var code: i32 = 0;
    if (run_axpy_signedness(false, instruction.OP_CMP_LE_S) != 0) { code = 1; }
    if (run_axpy_signedness(true,  instruction.OP_CMP_LE_U) != 0) { code = 1; }
    ret code;
}

fun run_reduction_signedness(use_unsigned: bool, want_kind: instruction.InstrKind) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1482: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1482.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target = rtg.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = rt.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig: ir_type.IrTypeId;
    if (mk_axpy_sig(?m, i64t, ptrt, ?sig) != 0) { ir.dnit(?m); ret 1; }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) { ir.dnit(?m); ret 1; }
    val entry: id.BlockId = re.ok;
    val rh: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) { ir.dnit(?m); ret 1; }
    val header: id.BlockId = rh.ok;
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    val body: id.BlockId = rb.ok;
    val rx: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) { ir.dnit(?m); ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);

    builder.set_block(?bld, entry);
    val r_1522: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1522.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel racc.err) { ir.dnit(?m); ret 1; }
    val acc: value.Value = racc.ok;
    val riv: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel riv.err) { ir.dnit(?m); ret 1; }
    val iv: value.Value = riv.ok;
    var rc: res[value.Value, fail.Fail];
    if (use_unsigned) { rc = builder.emit_cmp_lt_u(?bld, iv, n); } or { rc = builder.emit_cmp_lt_s(?bld, iv, n); }
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val cmp_id: id.InstructionId = rc.ok.data.instr;
    val r_1535: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, body, exit);
    if (sel r_1535.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, body);
    var ix: [1]value.Value; ix[0] = iv;
    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ix[0], 1);
    if (sel rg.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rg.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val racu: res[value.Value, fail.Fail] = builder.emit_add(?bld, acc, rl.ok);
    if (sel racu.err) { ir.dnit(?m); ret 1; }
    val acc_upd: value.Value = racu.ok;
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ir.dnit(?m); ret 1; }
    val iv_upd: value.Value = ru.ok;
    val r_1549: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1549.err) { ir.dnit(?m); ret 1; }

    builder.set_block(?bld, exit);
    val r_1552: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1552.err) { ir.dnit(?m); ret 1; }

    val r_1554: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, entry, value.const_int(0, i64t));
    if (sel r_1554.err) { ir.dnit(?m); ret 1; }
    val r_1555: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, body, acc_upd);
    if (sel r_1555.err) { ir.dnit(?m); ret 1; }
    val r_1556: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, value.const_int(0, i64t));
    if (sel r_1556.err) { ir.dnit(?m); ret 1; }
    val r_1557: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, iv_upd);
    if (sel r_1557.err) { ir.dnit(?m); ret 1; }

    val changed_r: res[bool, fail.Fail] = run(?m, ?tgt, false);
    if (sel changed_r.err) { ir.dnit(?m); ret 1; }
    if (!changed_r.ok) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    if (cmp_kind_of(fn, cmp_id) != want_kind) { code = 1; }

    val rvr: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(?tgt, true, false));
    if (sel rvr.err) { code = 1; }
    or (sel rvr.ok) {
        var rep: verify.VerifyReport = rvr.ok;
        if (rep.len != 0) { code = 1; }
        verify.dnit_report(?rep);
    }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.vectorize:reduction_tail_guard_preserves_source_signedness" {
    var code: i32 = 0;
    if (run_reduction_signedness(false, instruction.OP_CMP_LE_S) != 0) { code = 1; }
    if (run_reduction_signedness(true,  instruction.OP_CMP_LE_U) != 0) { code = 1; }
    ret code;
}

