use mach.lang.fail;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.page;

use std.system.panic.panic;

use mach.lang.intern;
use dep: mach.lang.me.analysis.dependence;
use mach.lang.me.analysis.loops;
use mach.lang.me.ir;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.mutate;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.refs;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use ver:        mach.lang.me.transform.versioning;
use mach.lang.me.vecform;
use mach.lang.target;
use mach.lang.target.resolved;
use target_testing: mach.lang.target.testing;
use semtype:        mach.lang.type;

rec MapShape {
    elem_ty:  ir_type.IrTypeId;
    bytes:    u32;
    lanes:    u32;
    is_float: bool;
}

# `to` is IRT_NIL for a splat, and for a shift's uniform count the lane type
# it is converted to, the scalar standing in for it
rec SplatSite {
    instr: id.InstructionId;
    slot:  u32;
    val:   value.Value;
    to:    ir_type.IrTypeId;
}

rec SplatEntry {
    key: value.Value;
    to:  ir_type.IrTypeId;
    vec: value.Value;
}

# `itn` names the constant globals a splat of a constant reads from; nil
# keeps every splat on the stack
pub fun run(m: *ir.Module, tgt: *target.Target, float_reassoc: bool, itn: *intern.Interner) res[bool, fail.Fail] {
    if (!tgt.model.has_v128)       { ret res[bool, fail.Fail].ok{false}; }
    if (!tgt.model.auto_vectorize) { ret res[bool, fail.Fail].ok{false}; }

    var changed: bool = false;
    var fi:      u32  = 0;
    for (fi < m.function_len) {
        val fn: *ir.Function = ?m.functions[fi];
        if (fn.block_count == 0 || (fn.flags & ir.FN_FLAG_SCALAR) != 0
            || (fn.flags & ir.FN_FLAG_OBLIVIOUS) != 0 || effect.function_has_volatile(fn)) {
            fi = fi + 1;
            cnt;
        }

        val ral: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, m.alloc);
        if (sel ral.err) { ret res[bool, fail.Fail].err{ral.err}; }
        var la: loops.LoopAnalysis = ral.ok;

        val cap: u32                       = la.loop_len + 1;
        val rhh: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, cap::usize);
        if (sel rhh.err) {
            loops.dnit(?la);
            ret res[bool, fail.Fail].err{fail.refused(rhh.err)};
        }
        val headers: *id.BlockId                = rhh.ok;
        val rda:     res[*dep.DepInfo, A.Error] = A.allocate[dep.DepInfo](m.alloc, cap::usize);
        if (sel rda.err) {
            A.deallocate[id.BlockId](m.alloc, headers, cap::usize);
            loops.dnit(?la);
            ret res[bool, fail.Fail].err{fail.refused(rda.err)};
        }
        val deps: *dep.DepInfo = rda.ok;

        var hn: u32 = 0;
        var lx: u32 = 0;
        for (lx < la.loop_len) {
            var d:              dep.DepInfo;
            val vectorizable_r: res[bool, fail.Fail] = vectorizable(m, tgt, fn, ?la, lx, ?d);
            if (sel vectorizable_r.err) {
                free_candidates(m, headers, deps, hn, cap);
                loops.dnit(?la);
                ret res[bool, fail.Fail].err{vectorizable_r.err};
            }
            if (vectorizable_r.ok) {
                headers[hn] = la.loops[lx].header;
                deps[hn]    = d;
                hn          = hn + 1;
            }
            lx = lx + 1;
        }
        loops.dnit(?la);

        var hi: u32 = 0;
        for (hi < hn) {
            val ra2: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, m.alloc);
            if (sel ra2.err) {
                free_candidates(m, headers, deps, hn, cap);
                ret res[bool, fail.Fail].err{ra2.err};
            }
            var la2: loops.LoopAnalysis = ra2.ok;
            val lx2: u32                = find_loop_by_header(?la2, headers[hi]);
            if (lx2 != ver.NONE_U32) {
                val vectorized_r: res[bool, fail.Fail] = vectorize_one(m, tgt, fn, ?la2, lx2, ?deps[hi], itn);
                if (sel vectorized_r.err) {
                    loops.dnit(?la2);
                    free_candidates(m, headers, deps, hn, cap);
                    ret res[bool, fail.Fail].err{vectorized_r.err};
                }
                if (vectorized_r.ok) { changed = true; }
            }
            loops.dnit(?la2);
            hi = hi + 1;
        }
        free_candidates(m, headers, deps, hn, cap);

        val reduced_r: res[bool, fail.Fail] = run_reductions(m, tgt, fn, float_reassoc, itn);
        if (sel reduced_r.err) { ret reduced_r; }
        if (reduced_r.ok)      { changed = true; }
        fi = fi + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun free_candidates(m: *ir.Module, headers: *id.BlockId, deps: *dep.DepInfo, hn: u32, cap: u32) {
    var i: u32 = 0;
    for (i < hn) {
        dep.dep_dnit(?deps[i]);
        i = i + 1;
    }
    A.deallocate[id.BlockId](m.alloc, headers, cap::usize);
    A.deallocate[dep.DepInfo](m.alloc, deps, cap::usize);
}

fun find_loop_by_header(la: *loops.LoopAnalysis, h: id.BlockId) u32 {
    var i: u32 = 0;
    for (i < la.loop_len) {
        if (la.loops[i].header == h) { ret i; }
        i = i + 1;
    }
    ret ver.NONE_U32;
}

rec PredShape {
    ok:    bool;
    entry: id.BlockId;
    t_arm: id.BlockId;
    f_arm: id.BlockId;
    cmp:   id.InstructionId;
}

fun loop_shape_ok(fn: *ir.Function, lp: *loops.Loop, out_p: *PredShape) bool {
    out_p.ok = false;
    if (!lp.is_counted)                                                                         { ret false; }
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL || lp.exiting == id.BLOCK_NIL) { ret false; }
    if (!lp.counted.iv_on_left)                                                                 { ret false; }
    if (!lp.counted.continue_on_true)                                                           { ret false; }
    if (lp.iv.step.kind != value.VAL_CONST_INT || lp.iv.step.data.int_lit != 1)                 { ret false; }
    if (lp.latch == lp.header)                                                                  { ret false; }
    if (lp.body_len == 2)                                                                       { ret true; }
    ret recognize_predicated(fn, lp, out_p);
}

fun recognize_predicated(fn: *ir.Function, lp: *loops.Loop, out: *PredShape) bool {
    if (lp.body_len != 5) { ret false; }
    val hdr:   *ir.Block  = ?fn.blocks[lp.header::u32];
    val entry: id.BlockId = cbr_target(fn, hdr.terminator, 0);
    if (entry == id.BLOCK_NIL || entry == lp.header || entry == lp.latch) { ret false; }
    if (!body_holds(lp, entry))                                           { ret false; }

    val eb: *ir.Block = ?fn.blocks[entry::u32];
    if (eb.phi_count != 0) { ret false; }
    val t_arm: id.BlockId = cbr_target(fn, eb.terminator, 0);
    val f_arm: id.BlockId = cbr_target(fn, eb.terminator, 1);
    if (t_arm == id.BLOCK_NIL || f_arm == id.BLOCK_NIL || t_arm == f_arm)               { ret false; }
    if (!body_holds(lp, t_arm) || !body_holds(lp, f_arm))                               { ret false; }
    if (!empty_forwarder(fn, t_arm, lp.latch) || !empty_forwarder(fn, f_arm, lp.latch)) { ret false; }

    val topt: opt[*instruction.Instruction] = ir.instruction_get(fn, eb.terminator);
    if (sel topt.none) { ret false; }
    val term: *instruction.Instruction = topt.some;
    if (term.operand_count == 0 || term.operands[0].kind != value.VAL_INSTR) { ret false; }
    val cmp_id: id.InstructionId = term.operands[0].data.instr;
    if (!block_holds_instr(?fn.blocks[entry::u32], cmp_id)) { ret false; }
    val copt: opt[*instruction.Instruction] = ir.instruction_get(fn, cmp_id);
    if (sel copt.none)                                 { ret false; }
    if (!is_mask_compare(copt.some.kind))              { ret false; }
    if (!guard_branch_only(fn, cmp_id, eb.terminator)) { ret false; }

    val lb: *ir.Block = ?fn.blocks[lp.latch::u32];
    if (lb.phi_count == 0) { ret false; }
    var pi: u32 = 0;
    for (pi < lb.phi_count) {
        if (!joins_arms(fn, lb.phis[pi], t_arm, f_arm)) { ret false; }
        pi = pi + 1;
    }

    out.ok    = true;
    out.entry = entry;
    out.t_arm = t_arm;
    out.f_arm = f_arm;
    out.cmp   = cmp_id;
    ret true;
}

fun cbr_target(fn: *ir.Function, term: id.InstructionId, k: u32) id.BlockId {
    if (term == id.INSTR_NIL) { ret id.BLOCK_NIL; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, term);
    if (sel opt_.none) { ret id.BLOCK_NIL; }
    val t: *instruction.Instruction = opt_.some;
    if (t.kind != instruction.OP_CBR || t.operand_count < 3) { ret id.BLOCK_NIL; }
    ret ir.block_target(t.operands[1 + k]);
}

fun body_holds(lp: *loops.Loop, b: id.BlockId) bool {
    var i: u32 = 0;
    for (i < lp.body_len) {
        if (lp.body[i] == b) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun block_holds_instr(b: *ir.Block, iid: id.InstructionId) bool {
    var i: u32 = 0;
    for (i < b.instr_count) {
        if (b.instructions[i] == iid) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun guard_branch_only(fn: *ir.Function, cmp_id: id.InstructionId, branch_id: id.InstructionId) bool {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var pi:  u32       = 0;
        for (pi < blk.phi_count) {
            if (!guard_use_ok(fn, blk.phis[pi], cmp_id, branch_id)) { ret false; }
            pi = pi + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (!guard_use_ok(fn, blk.instructions[ii], cmp_id, branch_id)) { ret false; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL && !guard_use_ok(fn, blk.terminator, cmp_id, branch_id)) { ret false; }
        bi = bi + 1;
    }
    ret true;
}

fun guard_use_ok(fn: *ir.Function, iid: id.InstructionId, cmp_id: id.InstructionId, branch_id: id.InstructionId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret false; }
    val inst: *instruction.Instruction = opt_.some;
    if (inst.kind == instruction.OP_DBG_VALUE) { ret true; }
    var o: u32 = 0;
    for (o < inst.operand_count) {
        if (inst.operands[o].kind == value.VAL_INSTR && inst.operands[o].data.instr == cmp_id
            && (iid != branch_id || o != 0)) { ret false; }
        o = o + 1;
    }
    ret true;
}

fun empty_forwarder(fn: *ir.Function, b: id.BlockId, to: id.BlockId) bool {
    val blk: *ir.Block = ?fn.blocks[b::u32];
    if (blk.phi_count != 0) { ret false; }
    var i: u32 = 0;
    for (i < blk.instr_count) {
        val iopt: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.instructions[i]);
        if (sel iopt.none)                              { ret false; }
        if (iopt.some.kind != instruction.OP_DBG_VALUE) { ret false; }
        i = i + 1;
    }
    if (blk.terminator == id.INSTR_NIL) { ret false; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, blk.terminator);
    if (sel opt_.none) { ret false; }
    val t: *instruction.Instruction = opt_.some;
    if (t.kind != instruction.OP_BR || t.operand_count < 1) { ret false; }
    ret ir.block_target(t.operands[0]) == to;
}

fun joins_arms(fn: *ir.Function, pid: id.InstructionId, t_arm: id.BlockId, f_arm: id.BlockId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret false; }
    val phi: *instruction.Instruction = opt_.some;
    if (phi.operand_count != 4) { ret false; }
    val b0: id.BlockId = ir.block_target(phi.operands[0]);
    val b1: id.BlockId = ir.block_target(phi.operands[2]);
    if (b0 == t_arm && b1 == f_arm) { ret true; }
    if (b0 == f_arm && b1 == t_arm) { ret true; }
    ret false;
}

fun phi_value_from(fn: *ir.Function, pid: id.InstructionId, from: id.BlockId) value.Value {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret value.const_null(ir_type.IRT_NIL); }
    val phi: *instruction.Instruction = opt_.some;
    var o:   u32                      = 0;
    for (o < phi.operand_count) {
        if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == from && o + 1 < phi.operand_count) {
            ret phi.operands[o + 1];
        }
        o = o + 1;
    }
    ret value.const_null(ir_type.IRT_NIL);
}

fun map_shape(tgt: *target.Target, d: *dep.DepInfo, out: *MapShape) bool {
    if (d.access_count == 0) { ret false; }
    val elem_ty: ir_type.IrTypeId = d.accesses[0].elem_ty;
    val w:       u32              = d.accesses[0].bytes;
    if (w == 0 || w > 8) { ret false; }
    val lanes: u32 = vecform.packed_lanes(tgt, w * 8);
    if (lanes < 2) { ret false; }
    var has_store: bool = false;
    var i:         u32  = 0;
    for (i < d.access_count) {
        if (d.accesses[i].elem_ty != elem_ty) { ret false; }
        if (d.accesses[i].bytes != w)         { ret false; }
        if (d.accesses[i].is_store)           { has_store = true; }
        i = i + 1;
    }
    if (!has_store) { ret false; }
    out.elem_ty  = elem_ty;
    out.bytes    = w;
    out.lanes    = lanes;
    out.is_float = false;
    ret true;
}

fun vectorizable(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, out_d: *dep.DepInfo) res[bool, fail.Fail] {
    val lp:   *loops.Loop = ?la.loops[lx];
    var pred: PredShape;
    if (!loop_shape_ok(fn, lp, ?pred)) { ret res[bool, fail.Fail].ok{false}; }
    if (lp.exit == id.BLOCK_NIL)       { ret res[bool, fail.Fail].ok{false}; }

    val rd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, la, lx, ?m.types, m.alloc);
    if (sel rd.err) { ret res[bool, fail.Fail].err{rd.err}; }
    var d: dep.DepInfo = rd.ok;
    if (d.verdict != dep.DEP_INDEPENDENT) {
        dep.dep_dnit(?d);
        ret res[bool, fail.Fail].ok{false};
    }

    var shape: MapShape;
    if (!map_shape(tgt, ?d, ?shape)) {
        dep.dep_dnit(?d);
        ret res[bool, fail.Fail].ok{false};
    }
    shape.is_float = ir_type.is_float_scalar(?m.types, shape.elem_ty);
    if (pred.ok && shape.is_float) {
        dep.dep_dnit(?d);
        ret res[bool, fail.Fail].ok{false};
    }

    var ai: u32 = 0;
    for (ai < d.access_count) {
        val ab: id.BlockId = la.instr_block[d.accesses[ai].instr::u32];
        if (ab != lp.latch && !(pred.ok && ab == pred.entry)) {
            dep.dep_dnit(?d);
            ret res[bool, fail.Fail].ok{false};
        }
        ai = ai + 1;
    }

    val pure_r: res[bool, fail.Fail] = stores_are_pure_trees(m, tgt, fn, la, lx, ?d, ?shape, pred.ok, pred_mask(?pred));
    if (sel pure_r.err) {
        dep.dep_dnit(?d);
        ret pure_r;
    }
    if (!pure_r.ok) {
        dep.dep_dnit(?d);
        ret res[bool, fail.Fail].ok{false};
    }

    @out_d = d;
    ret res[bool, fail.Fail].ok{true};
}

fun stores_are_pure_trees(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, d: *dep.DepInfo, shape: *MapShape, pred_ok: bool, mask_cmp: id.InstructionId) res[bool, fail.Fail] {
    val rset: res[*bool, A.Error] = A.allocate[bool](m.alloc, fn.instr_len::usize);
    if (sel rset.err) { ret res[bool, fail.Fail].err{fail.refused(rset.err)}; }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, la, lx, d.accesses, d.access_count, shape.elem_ty, shape.elem_ty, shape.is_float, true, pred_ok, mask_cmp, vset);

    var ok: bool = true;
    var i:  u32  = 0;
    for (i < d.access_count) {
        if (d.accesses[i].is_store) {
            val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, d.accesses[i].instr);
            if (sel opt_.none) { ok = false; }
            or (sel opt_.some) {
                val st: *instruction.Instruction = opt_.some;
                val v:  value.Value              = st.operands[0];
                if (v.kind != value.VAL_INSTR || v.data.instr::u32 >= fn.instr_len || !vset[v.data.instr::u32]) { ok = false; }
            }
        }
        i = i + 1;
    }
    if (pred_ok && !pred_joins_in_vset(fn, la, lx, vset))                                               { ok = false; }
    if (pred_ok && (mask_cmp == id.INSTR_NIL || mask_cmp::u32 >= fn.instr_len || !vset[mask_cmp::u32])) { ok = false; }
    A.deallocate[bool](m.alloc, vset, fn.instr_len::usize);
    ret res[bool, fail.Fail].ok{ok};
}

fun pred_joins_in_vset(fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, vset: *bool) bool {
    val lp: *loops.Loop = ?la.loops[lx];
    if (lp.latch::u32 >= fn.block_count) { ret false; }
    val latch: *ir.Block = ?fn.blocks[lp.latch::u32];
    if (latch.phi_count == 0) { ret false; }
    var i: u32 = 0;
    for (i < latch.phi_count) {
        val pid: id.InstructionId = latch.phis[i];
        if (pid::u32 >= fn.instr_len || !vset[pid::u32]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the instructions of the loop that run lane-wise: its loads, and each
# computation of the element type (or of `wide_ty`, an integer accumulator's
# wider type) the target packs whose operands are in the set or splat. a
# sign or zero extension from the element type to `wide_ty` joins when the
# target packs it, and the compare `mask_cmp` joins as the lane mask
fun build_vset(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, accesses: *dep.MemAccess, access_count: u32, elem_ty: ir_type.IrTypeId, wide_ty: ir_type.IrTypeId, is_float: bool, allow_splat: bool, admit_joins: bool, mask_cmp: id.InstructionId, vset: *bool) {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        vset[i] = false;
        i       = i + 1;
    }
    i = 0;
    for (i < access_count) {
        if (!accesses[i].is_store) { vset[accesses[i].instr::u32] = true; }
        i = i + 1;
    }
    val lp:      *loops.Loop = ?la.loops[lx];
    var changed: bool        = true;
    for (changed) {
        changed = false;
        var bi: u32 = 0;
        for (bi < lp.body_len) {
            if (lp.body[bi] == lp.header) {
                bi = bi + 1;
                cnt;
            }
            val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
            if (admit_joins && lp.body[bi] == lp.latch) {
                var pi: u32 = 0;
                for (pi < blk.phi_count) {
                    val pid: id.InstructionId = blk.phis[pi];
                    if (vset[pid::u32] == false) {
                        val popt: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
                        if (sel popt.some) {
                            val phi: *instruction.Instruction = popt.some;
                            if (phi.ty == elem_ty && phi_incomings_vectorizable(phi, fn, la, lx, elem_ty, allow_splat, vset)) {
                                vset[pid::u32] = true;
                                changed        = true;
                            }
                        }
                    }
                    pi = pi + 1;
                }
            }
            var ii: u32 = 0;
            for (ii < blk.instr_count) {
                val iid: id.InstructionId = blk.instructions[ii];
                if (vset[iid::u32] == false) {
                    val inst:  *instruction.Instruction = ?fn.instrs[iid::u32];
                    var joins: bool                     = false;
                    if (is_shift(inst.kind)) {
                        joins = !is_float && shift_lane_wise(m, tgt, fn, la, lx, inst, elem_ty, wide_ty, allow_splat, vset);
                    }
                    or {
                        joins = lane_wise(m, tgt, inst, iid, elem_ty, wide_ty, is_float, mask_cmp)
                            && operands_vectorizable(inst, fn, la, lx, operand_lane_ty(inst, elem_ty), allow_splat, vset);
                    }
                    if (joins) {
                        vset[iid::u32] = true;
                        changed        = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

# whether `inst` runs lane-wise at its own type once its operands do
fun lane_wise(m: *ir.Module, tgt: *target.Target, inst: *instruction.Instruction, iid: id.InstructionId, elem_ty: ir_type.IrTypeId, wide_ty: ir_type.IrTypeId, is_float: bool, mask_cmp: id.InstructionId) bool {
    if (is_mask_compare(inst.kind)) {
        if (iid != mask_cmp || mask_cmp == id.INSTR_NIL || inst.operand_count != 2) { ret false; }
        val cmp_ty: ir_type.IrTypeId = inst.operands[0].ty;
        ret cmp_ty == elem_ty || cmp_ty == wide_ty;
    }
    if (inst.kind == instruction.OP_SEXT || inst.kind == instruction.OP_ZEXT) {
        if (wide_ty == elem_ty || inst.ty != wide_ty || inst.operand_count != 1 || inst.operands[0].ty != elem_ty) { ret false; }
        ret vecform.extends(tgt, inst.kind, vecform.scalar_bits(m, wide_ty), vecform.scalar_bits(m, elem_ty));
    }
    # the range test a shift by a count the loop computes is saturated with
    # (#3887): at one lane width it is the unsigned compare, whose lanes are
    # all ones or zero, and it widens to that
    if (inst.kind == instruction.OP_MASK_LT_U) {
        if (is_float || inst.operand_count != 2 || inst.operands[0].ty != inst.ty) { ret false; }
        if (inst.ty != elem_ty && inst.ty != wide_ty)                              { ret false; }
        ret supported_vector_op(tgt, instruction.OP_CMP_LT_U, false, vecform.scalar_bits(m, inst.ty));
    }
    if (inst.ty != elem_ty && inst.ty != wide_ty) { ret false; }
    ret supported_vector_op(tgt, inst.kind, is_float, vecform.scalar_bits(m, inst.ty));
}

fun phi_incomings_vectorizable(phi: *instruction.Instruction, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, elem_ty: ir_type.IrTypeId, allow_splat: bool, vset: *bool) bool {
    if (phi.operand_count != 4) { ret false; }
    var o: u32 = 1;
    for (o < phi.operand_count) {
        val v: value.Value = phi.operands[o];
        if (v.kind == value.VAL_INSTR && v.data.instr::u32 < fn.instr_len && vset[v.data.instr::u32]) {}
        or {
            if (!allow_splat || !splattable(v, la, lx, elem_ty)) { ret false; }
        }
        o = o + 2;
    }
    ret true;
}

# the lane type an instruction's operands carry: a compare's own, an
# extension's element, and any other computation's result type
fun operand_lane_ty(inst: *instruction.Instruction, elem_ty: ir_type.IrTypeId) ir_type.IrTypeId {
    if (is_mask_compare(inst.kind) && inst.operand_count > 0)                 { ret inst.operands[0].ty; }
    if (inst.kind == instruction.OP_SEXT || inst.kind == instruction.OP_ZEXT) { ret elem_ty; }
    ret inst.ty;
}

fun operands_vectorizable(inst: *instruction.Instruction, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, lane_ty: ir_type.IrTypeId, allow_splat: bool, vset: *bool) bool {
    if (inst.operand_count == 0) { ret false; }
    var from_set: bool = false;
    var o:        u32  = 0;
    for (o < inst.operand_count) {
        val op: value.Value = inst.operands[o];
        if (op.kind == value.VAL_INSTR && op.data.instr::u32 < fn.instr_len && vset[op.data.instr::u32]) {
            from_set = true;
        }
        or {
            if (!allow_splat || !splattable(op, la, lx, lane_ty)) { ret false; }
        }
        o = o + 1;
    }
    ret from_set;
}

fun splattable(v: value.Value, la: *loops.LoopAnalysis, lx: u32, lane_ty: ir_type.IrTypeId) bool {
    if (v.ty != lane_ty)                                                                                                            { ret false; }
    if (v.kind != value.VAL_CONST_INT && v.kind != value.VAL_CONST_FLOAT && v.kind != value.VAL_PARAM && v.kind != value.VAL_INSTR) { ret false; }
    ret loops.is_invariant(la, lx, v);
}

fun is_mask_compare(k: instruction.InstrKind) bool {
    ret opdesc.has(k, opdesc.EFF_COMPARE);
}

fun pred_mask(p: *PredShape) id.InstructionId {
    if (p.ok) { ret p.cmp; }
    ret id.INSTR_NIL;
}

fun supported_vector_op(tgt: *target.Target, k: instruction.InstrKind, is_float: bool, lane_bits: u32) bool {
    if (!in_increment_table(k, is_float)) { ret false; }
    ret vecform.packs(tgt, k, is_float, lane_bits, false);
}

fun is_shift(k: instruction.InstrKind) bool {
    ret k == instruction.OP_SHL || k == instruction.OP_SHR_U || k == instruction.OP_SHR_S;
}

fun in_vset(fn: *ir.Function, vset: *bool, v: value.Value) bool {
    ret v.kind == value.VAL_INSTR && v.data.instr::u32 < fn.instr_len && vset[v.data.instr::u32];
}

# a shift widens by its count's form (#3853). a count the loop computes per
# element is lane-wise itself, and the shift is the per-lane form, whose count
# is that vector. a count the loop does not change stays one scalar, and the
# shift is the uniform form. the target must pack the cell of that form at the
# lane width, else the shift, and the loop with it, stays scalar. either form
# saturates each lane as the scalar shift does (#3756), so the widened loop
# answers what the scalar one does for every count
fun shift_lane_wise(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, inst: *instruction.Instruction, elem_ty: ir_type.IrTypeId, wide_ty: ir_type.IrTypeId, allow_splat: bool, vset: *bool) bool {
    if (inst.operand_count != 2 || (inst.ty != elem_ty && inst.ty != wide_ty)) { ret false; }
    if (!in_increment_table(inst.kind, false))                                 { ret false; }
    val v:     value.Value = inst.operands[0];
    val c:     value.Value = inst.operands[1];
    val bits:  u32         = vecform.scalar_bits(m, inst.ty);
    val lanes: bool        = in_vset(fn, vset, v);
    if (!lanes && !(allow_splat && splattable(v, la, lx, inst.ty))) { ret false; }
    if (in_vset(fn, vset, c)) {
        ret c.ty == inst.ty && vecform.packs(tgt, inst.kind, false, bits, false);
    }
    if (!lanes || !allow_splat || !uniform_count_ok(m, la, lx, inst, c)) { ret false; }
    ret vecform.packs(tgt, inst.kind, false, bits, true);
}

# a loop-invariant integer count the uniform form reads as one scalar of the
# lane type: of that type, or of a narrower integer type, which zero-extends
# to it by value, or of a wider one when the shift is count-bounded, whose
# count is below the width and so truncates to it by value
fun uniform_count_ok(m: *ir.Module, la: *loops.LoopAnalysis, lx: u32, inst: *instruction.Instruction, c: value.Value) bool {
    if (c.kind != value.VAL_CONST_INT && c.kind != value.VAL_PARAM && c.kind != value.VAL_INSTR) { ret false; }
    if (!loops.is_invariant(la, lx, c))                                                          { ret false; }
    if (c.ty == inst.ty)                                                                         { ret true; }
    if (!plain_int(m, c.ty) || !plain_int(m, inst.ty))                                           { ret false; }
    val cb: u32 = vecform.scalar_bits(m, c.ty);
    val lb: u32 = vecform.scalar_bits(m, inst.ty);
    ret cb < lb || (inst.flags & instruction.INSTR_FLAG_COUNT_BOUNDED) != 0;
}

fun plain_int(m: *ir.Module, ty: ir_type.IrTypeId) bool {
    val t: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (sel t.none) { ret false; }
    ret t.some.kind == ir_type.IRT_INT && ir_type.int_form(?m.types, ty) == ir_type.INT_FORM_PLAIN;
}

fun in_increment_table(k: instruction.InstrKind, is_float: bool) bool {
    if (is_float) { ret opdesc.has(k, opdesc.EFF_VEC_INCR_FLOAT); }
    ret opdesc.has(k, opdesc.EFF_VEC_INCR_INT);
}

fun vectorize_one(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, d0: *dep.DepInfo, itn: *intern.Interner) res[bool, fail.Fail] {
    val lp0:   *loops.Loop = ?la.loops[lx];
    var pred0: PredShape;
    if (!loop_shape_ok(fn, lp0, ?pred0))   { ret res[bool, fail.Fail].ok{false}; }
    if (d0.verdict != dep.DEP_INDEPENDENT) { ret res[bool, fail.Fail].ok{false}; }
    var shape: MapShape;
    if (!map_shape(tgt, d0, ?shape)) { ret res[bool, fail.Fail].ok{false}; }
    shape.is_float = ir_type.is_float_scalar(?m.types, shape.elem_ty);

    val iv_ty: ir_type.IrTypeId = lp0.iv.init.ty;

    val rvr: res[ver.VersionResult, fail.Fail] = ver.version_loop(m, fn, la, lx, d0);
    if (sel rvr.err) { ret res[bool, fail.Fail].err{rvr.err}; }
    var vr: ver.VersionResult = rvr.ok;
    if (vr.status != ver.VERSION_OK) {
        ver.version_result_dnit(?vr, m.alloc);
        ret res[bool, fail.Fail].ok{false};
    }
    val fast_header: id.BlockId  = vr.fast_header;
    val merge:       id.BlockId  = vr.merge;
    val guard:       id.BlockId  = vr.guard;
    val bound_ex:    value.Value = vr.bound_ex;
    ver.version_result_dnit(?vr, m.alloc);

    val rvp: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rvp.err) { ret res[bool, fail.Fail].err{rvp.err}; }
    val vpre: id.BlockId      = rvp.ok;
    var b:    builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, vpre);
    val rlb: res[value.Value, fail.Fail] = emit_lane_bound(?b, bound_ex, shape.lanes, iv_ty, lp0.counted.pred);
    if (sel rlb.err) { ret res[bool, fail.Fail].err{rlb.err}; }
    val lane_bound: value.Value    = rlb.ok;
    val r_539:      err[fail.Fail] = builder.emit_br(?b, fast_header);
    if (sel r_539.err) { ret res[bool, fail.Fail].err{r_539.err}; }
    ver.redirect_terminator(fn, guard, fast_header, vpre);
    ver.relabel_phi_pred(fn, fast_header, guard, vpre);

    val ra: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, m.alloc);
    if (sel ra.err) { ret res[bool, fail.Fail].err{ra.err}; }
    var fla: loops.LoopAnalysis = ra.ok;
    val flx: u32                = find_loop_by_header(?fla, fast_header);
    if (flx == ver.NONE_U32) {
        loops.dnit(?fla);
        panic("mach.lang.me.transform.vectorize: versioned clone lost its loop header; the clone must reproduce the shape already proven on the unmutated original before commit\n");
    }
    val rdd: res[dep.DepInfo, fail.Fail] = dep.analyze_dependence(fn, ?fla, flx, ?m.types, m.alloc);
    if (sel rdd.err) {
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{rdd.err};
    }
    var fd: dep.DepInfo = rdd.ok;

    val flp:     *loops.Loop = ?fla.loops[flx];
    var fshape:  MapShape;
    var fpred:   PredShape;
    var fast_ok: bool        = loop_shape_ok(fn, flp, ?fpred) && fd.verdict == dep.DEP_INDEPENDENT && map_shape(tgt, ?fd, ?fshape);
    if (fast_ok && fshape.elem_ty != shape.elem_ty) { fast_ok = false; }
    if (fast_ok && fpred.ok != pred0.ok)            { fast_ok = false; }
    if (fast_ok && fpred.ok && shape.is_float)      { fast_ok = false; }
    if (!fast_ok) {
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        panic("mach.lang.me.transform.vectorize: versioned clone failed the shape/dependence proof its unmutated original already satisfied; the pre-clone check in vectorizable() must be the sole gate, never a post-clone decline\n");
    }
    fshape.is_float = shape.is_float;

    val fast_iv_phi: id.InstructionId = flp.iv.phi;
    val fast_cmp:    id.InstructionId = flp.counted.cmp;
    val iv_phi_val:  value.Value      = value.instr(fast_iv_phi, iv_ty);

    val body_len: u32                       = flp.body_len;
    val rfb:      res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rfb.err) {
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{fail.refused(rfb.err)};
    }
    val fbody: *id.BlockId = rfb.ok;
    var ci:    u32         = 0;
    for (ci < body_len) {
        fbody[ci] = flp.body[ci];
        ci        = ci + 1;
    }

    val rrc: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rrc.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{fail.refused(rrc.err)};
    }
    val rem_blocks: *id.BlockId    = rrc.ok;
    val rcl:        err[fail.Fail] = ver.clone_region(m, fn, fbody, body_len, rem_blocks);
    if (sel rcl.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{rcl.err};
    }
    val rem_header: id.BlockId = rem_blocks[ver.region_index(fbody, body_len, fast_header)];

    if (fpred.ok) {
        val rif: err[fail.Fail] = if_convert(m, fn, flp, ?fpred, fshape.elem_ty);
        if (sel rif.err) {
            A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
            A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
            dep.dep_dnit(?fd);
            loops.dnit(?fla);
            ret res[bool, fail.Fail].err{rif.err};
        }
    }

    val rset: res[*bool, A.Error] = A.allocate[bool](m.alloc, fn.instr_len::usize);
    if (sel rset.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{fail.refused(rset.err)};
    }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, ?fla, flx, fd.accesses, fd.access_count, fshape.elem_ty, fshape.elem_ty, fshape.is_float, true, false, pred_mask(?fpred), vset);
    val vset_len: u32            = fn.instr_len;
    val rsp:      err[fail.Fail] = retype_then_splat(m, tgt, fn, flp, vset, vpre, fast_header, shape.lanes, itn);
    A.deallocate[bool](m.alloc, vset, vset_len::usize);
    if (sel rsp.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{rsp.err};
    }

    val rss: err[fail.Fail] = scale_recurrence_steps(fn, flp, shape.lanes);
    if (sel rss.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{rss.err};
    }

    val rbt: err[fail.Fail] = rewrite_lane_bound_test(m, fn, fast_header, iv_phi_val, shape.lanes, iv_ty, lane_bound, flp.counted.pred, fast_cmp);
    if (sel rbt.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
        dep.dep_dnit(?fd);
        loops.dnit(?fla);
        ret res[bool, fail.Fail].err{rbt.err};
    }

    ver.redirect_terminator(fn, fast_header, merge, rem_header);
    val rer: bool = enter_remainder_from(fn, rem_header, vpre, fast_header);

    A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
    A.deallocate[id.BlockId](m.alloc, rem_blocks, body_len::usize);
    dep.dep_dnit(?fd);
    loops.dnit(?fla);
    if (!rer) { ret res[bool, fail.Fail].err{fail.message("vectorize: remainder header phis do not mirror the vector header's")}; }

    val rpr: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel rpr.err) { ret res[bool, fail.Fail].err{rpr.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun if_convert(m: *ir.Module, fn: *ir.Function, lp: *loops.Loop, p: *PredShape, elem_ty: ir_type.IrTypeId) err[fail.Fail] {
    val latch: id.BlockId = lp.latch;

    val lb0: *ir.Block = ?fn.blocks[latch::u32];
    val np:  u32       = lb0.phi_count;
    if (np == 0) { ret err[fail.Fail].err{fail.message("vectorize: predicated latch lost its join phis")}; }
    val rj: res[*SelectSite, A.Error] = A.allocate[SelectSite](m.alloc, np::usize);
    if (sel rj.err) { ret err[fail.Fail].err{fail.refused(rj.err)}; }
    val joins: *SelectSite = rj.ok;
    var i:     u32         = 0;
    for (i < np) {
        joins[i].phi   = lb0.phis[i];
        joins[i].t_val = phi_value_from(fn, lb0.phis[i], p.t_arm);
        joins[i].f_val = phi_value_from(fn, lb0.phis[i], p.f_arm);
        joins[i].ty    = fn.instrs[lb0.phis[i]::u32].ty;
        i              = i + 1;
    }

    fn.instrs[p.cmp::u32].ty = elem_ty;

    val term_e: id.InstructionId = fn.blocks[p.entry::u32].terminator;
    fn.blocks[p.entry::u32].terminator = id.INSTR_NIL;
    val mask: value.Value = value.instr(p.cmp, elem_ty);
    i = 0;
    for (i < np) {
        val rs: res[value.Value, fail.Fail] = emit_select(m, fn, p.entry, mask, ?joins[i]);
        if (sel rs.err) {
            fn.blocks[p.entry::u32].terminator = term_e;
            A.deallocate[SelectSite](m.alloc, joins, np::usize);
            ret err[fail.Fail].err{rs.err};
        }
        mutate.replace_uses(fn, joins[i].phi, rs.ok);
        i = i + 1;
    }
    fn.blocks[p.entry::u32].terminator = term_e;
    fn.blocks[latch::u32].phi_count    = 0;
    A.deallocate[SelectSite](m.alloc, joins, np::usize);

    val eb: *ir.Block = ?fn.blocks[p.entry::u32];
    var k:  u32       = eb.instr_count;
    for (k > 0) {
        k = k - 1;
        val rp: err[fail.Fail] = ir.block_prepend_instr(m, ?fn.blocks[latch::u32], eb.instructions[k]);
        if (sel rp.err) { ret rp; }
    }
    fn.blocks[p.entry::u32].instr_count = 0;

    val rmu: err[fail.Fail] = make_unconditional(m, fn, p.entry, latch);
    if (sel rmu.err) { ret rmu; }

    val rpr: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel rpr.err) { ret rpr; }
    ret err[fail.Fail].ok{};
}

fun make_unconditional(m: *ir.Module, fn: *ir.Function, blk: id.BlockId, to: id.BlockId) err[fail.Fail] {
    val b: *ir.Block = ?fn.blocks[blk::u32];
    if (b.terminator == id.INSTR_NIL) { ret err[fail.Fail].err{fail.message("vectorize: if-convert block has no terminator")}; }
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, b.terminator);
    if (sel opt_.none) { ret err[fail.Fail].err{fail.message("vectorize: if-convert terminator is missing")}; }
    val rt: res[value.Value, fail.Fail] = ir.block_target_make(m, to);
    if (sel rt.err) { ret err[fail.Fail].err{rt.err}; }
    val ra: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(m, 1);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val ops: ir.OperandArray = ra.ok;
    ops.ops[0] = rt.ok;
    val term: *instruction.Instruction = opt_.some;
    term.kind = instruction.OP_BR;
    ir.instr_replace_operands(m, term, ops);
    ret err[fail.Fail].ok{};
}

rec SelectSite {
    phi:   id.InstructionId;
    t_val: value.Value;
    f_val: value.Value;
    ty:    ir_type.IrTypeId;
}

fun emit_select(m: *ir.Module, fn: *ir.Function, blk: id.BlockId, mask: value.Value, s: *SelectSite) res[value.Value, fail.Fail] {
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, blk);
    val rt: res[value.Value, fail.Fail] = builder.emit_and(?b, value.retype(mask, s.ty), s.t_val);
    if (sel rt.err) { ret rt; }
    val rn: res[value.Value, fail.Fail] = builder.emit_not(?b, value.retype(mask, s.ty));
    if (sel rn.err) { ret rn; }
    val rf: res[value.Value, fail.Fail] = builder.emit_and(?b, rn.ok, s.f_val);
    if (sel rf.err) { ret rf; }
    ret builder.emit_or(?b, rt.ok, rf.ok);
}

# the vector loop's exit test: a signed loop compares the induction variable
# against `bound - lanes` computed once in the preheader, an unsigned loop
# keeps `iv + lanes <= bound` in the header because the subtraction could
# wrap below zero
fun lanes_pred_unsigned(orig_pred: instruction.InstrKind) bool {
    ret orig_pred == instruction.OP_CMP_LT_U || orig_pred == instruction.OP_CMP_LE_U;
}

fun emit_lane_bound(b: *builder.Builder, bound_ex: value.Value, lanes: u32, iv_ty: ir_type.IrTypeId, orig_pred: instruction.InstrKind) res[value.Value, fail.Fail] {
    if (lanes_pred_unsigned(orig_pred)) { ret res[value.Value, fail.Fail].ok{bound_ex}; }
    ret builder.emit_sub(b, bound_ex, value.const_int(lanes::u64, iv_ty));
}

fun rewrite_lane_bound_test(m: *ir.Module, fn: *ir.Function, header: id.BlockId, iv: value.Value, lanes: u32, iv_ty: ir_type.IrTypeId, lane_bound: value.Value, orig_pred: instruction.InstrKind, cmp_id: id.InstructionId) err[fail.Fail] {
    val unsigned: bool        = lanes_pred_unsigned(orig_pred);
    var lhs:      value.Value = iv;
    if (unsigned) {
        val rl: res[value.Value, fail.Fail] = emit_binary_prepend(m, fn, header, instruction.OP_ADD, iv, value.const_int(lanes::u64, iv_ty), iv_ty, cmp_id);
        if (sel rl.err) { ret err[fail.Fail].err{rl.err}; }
        lhs = rl.ok;
    }
    val copt: opt[*instruction.Instruction] = ir.instruction_get(fn, cmp_id);
    if (sel copt.some) {
        val cmp: *instruction.Instruction = copt.some;
        if (unsigned) { cmp.kind = instruction.OP_CMP_LE_U; }
        or            { cmp.kind = instruction.OP_CMP_LE_S; }
        cmp.operands[0] = lhs;
        cmp.operands[1] = lane_bound;
    }
    ret err[fail.Fail].ok{};
}

fun emit_binary_prepend(m: *ir.Module, fn: *ir.Function, blk: id.BlockId, kind: instruction.InstrKind, lhs: value.Value, rhs: value.Value, ty: ir_type.IrTypeId, loc_ref: id.InstructionId) res[value.Value, fail.Fail] {
    val rops: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(m, 2);
    if (sel rops.err) { ret res[value.Value, fail.Fail].err{rops.err}; }
    val arr: ir.OperandArray = rops.ok;
    arr.ops[0] = lhs;
    arr.ops[1] = rhs;

    var ni: instruction.Instruction;
    ni.kind          = kind;
    ni.ty            = ty;
    ni.operands      = arr.ops;
    ni.operand_count = 2;
    ni.operand_cap   = 2;
    ni.flags         = 0;
    ni.aux_ty        = ir_type.IRT_NIL;
    ni.loc           = fn.instrs[loc_ref::u32].loc;
    ni.secret        = false;

    val ri: res[id.InstructionId, fail.Fail] = ir.instruction_add(m, fn, ni);
    if (sel ri.err) {
        A.deallocate[value.Value](m.alloc, arr.ops, 2::usize);
        ret res[value.Value, fail.Fail].err{ri.err};
    }
    val iid: id.InstructionId = ri.ok;

    val rp: err[fail.Fail] = ir.block_prepend_instr(m, ?fn.blocks[blk::u32], iid);
    if (sel rp.err) { ret res[value.Value, fail.Fail].err{rp.err}; }

    ret res[value.Value, fail.Fail].ok{value.instr(iid, ty)};
}

# each lane-wise instruction becomes a vector of `lanes` of its own scalar type,
# and every operand reading one takes the vector type
fun retype_to_vector(m: *ir.Module, fn: *ir.Function, lp: *loops.Loop, vset: *bool, lanes: u32) err[fail.Fail] {
    val n: u32 = fn.instr_len;
    var i: u32 = 0;
    for (i < n) {
        if (vset[i]) {
            val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, fn.instrs[i].ty, lanes);
            if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
            fn.instrs[i].ty = rv.ok;
            if (fn.instrs[i].kind == instruction.OP_MASK_LT_U) { fn.instrs[i].kind = instruction.OP_CMP_LT_U; }
        }
        i = i + 1;
    }
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            val inst: *instruction.Instruction = ?fn.instrs[blk.instructions[ii]::u32];
            var o:    u32                      = 0;
            for (o < inst.operand_count) {
                val op: value.Value = inst.operands[o];
                if (op.kind == value.VAL_INSTR && op.data.instr::u32 < n && vset[op.data.instr::u32]) {
                    inst.operands[o] = value.retype(op, fn.instrs[op.data.instr::u32].ty);
                }
                o = o + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun retype_then_splat(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, lp: *loops.Loop, vset: *bool, vpre: id.BlockId, header: id.BlockId, lanes: u32, itn: *intern.Interner) err[fail.Fail] {
    val rrt: err[fail.Fail] = retype_to_vector(m, fn, lp, vset, lanes);
    if (sel rrt.err) { ret rrt; }
    ret splat_invariants(m, tgt, fn, lp, vset, vpre, header, lanes, itn);
}

fun body_operand_slots(fn: *ir.Function, lp: *loops.Loop) u32 {
    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            n  = n + fn.instrs[blk.instructions[ii]::u32].operand_count;
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    ret n;
}

# each operand of a lane-wise computation that is not itself lane-wise is
# loop-invariant, and becomes one splat of `lanes` lanes of its type, built
# once in a block ahead of the loop. a shift's invariant count is the uniform
# form's one scalar instead (#3853), converted there to the lane type when it
# is of another width
fun splat_invariants(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, lp: *loops.Loop, vset: *bool, vpre: id.BlockId, fast_header: id.BlockId, lanes: u32, itn: *intern.Interner) err[fail.Fail] {
    val cap: u32 = body_operand_slots(fn, lp);
    if (cap == 0) { ret err[fail.Fail].ok{}; }
    val rss: res[*SplatSite, A.Error] = A.allocate[SplatSite](m.alloc, cap::usize);
    if (sel rss.err) { ret err[fail.Fail].err{fail.refused(rss.err)}; }
    val sites: *SplatSite                = rss.ok;
    val rse:   res[*SplatEntry, A.Error] = A.allocate[SplatEntry](m.alloc, cap::usize);
    if (sel rse.err) {
        A.deallocate[SplatSite](m.alloc, sites, cap::usize);
        ret err[fail.Fail].err{fail.refused(rse.err)};
    }
    val cache: *SplatEntry = rse.ok;

    var n:  u32 = 0;
    var bi: u32 = 0;
    for (bi < lp.body_len) {
        val blk: *ir.Block = ?fn.blocks[lp.body[bi]::u32];
        var ii:  u32       = 0;
        for (ii < blk.instr_count) {
            val iid:  id.InstructionId         = blk.instructions[ii];
            val inst: *instruction.Instruction = ?fn.instrs[iid::u32];
            if (iid::u32 < fn.instr_len && vset[iid::u32] && inst.kind != instruction.OP_LOAD) {
                var o: u32 = 0;
                for (o < inst.operand_count) {
                    val op: value.Value = inst.operands[o];
                    if (op.kind != value.VAL_INSTR || op.data.instr::u32 >= fn.instr_len || !vset[op.data.instr::u32]) {
                        var to: ir_type.IrTypeId = ir_type.IRT_NIL;
                        if (is_shift(inst.kind) && o == 1) { to = lane_type(m, inst.ty); }
                        if (to != op.ty) {
                            sites[n].instr = iid;
                            sites[n].slot  = o;
                            sites[n].val   = op;
                            sites[n].to    = to;
                            n              = n + 1;
                        }
                    }
                    o = o + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if (n == 0) {
        splat_free(m, sites, cache, cap);
        ret err[fail.Fail].ok{};
    }

    val rsb: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rsb.err) {
        splat_free(m, sites, cache, cap);
        ret err[fail.Fail].err{rsb.err};
    }
    val spre: id.BlockId      = rsb.ok;
    var b:    builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, spre);
    var cn: u32 = 0;
    var i:  u32 = 0;
    for (i < n) {
        if (splat_lookup(cache, cn, sites[i].val, sites[i].to) == ver.NONE_U32) {
            var rsv: res[value.Value, fail.Fail] = res[value.Value, fail.Fail].err{fail.message("vectorize: splat site")};
            if (sites[i].to == ir_type.IRT_NIL) { rsv = emit_lane_splat(?b, sites[i].val, lanes, tgt, itn); }
            or                                  { rsv = emit_uniform_count(?b, sites[i].val, sites[i].to); }
            if (sel rsv.err) {
                splat_free(m, sites, cache, cap);
                ret err[fail.Fail].err{rsv.err};
            }
            cache[cn].key = sites[i].val;
            cache[cn].to  = sites[i].to;
            cache[cn].vec = rsv.ok;
            cn            = cn + 1;
        }
        i = i + 1;
    }
    val r_863: err[fail.Fail] = builder.emit_br(?b, fast_header);
    if (sel r_863.err) {
        splat_free(m, sites, cache, cap);
        ret err[fail.Fail].err{fail.message("vectorize: splat block branch")};
    }
    ver.redirect_terminator(fn, vpre, fast_header, spre);
    ver.relabel_phi_pred(fn, fast_header, vpre, spre);

    i = 0;
    for (i < n) {
        val ci: u32 = splat_lookup(cache, cn, sites[i].val, sites[i].to);
        if (ci != ver.NONE_U32) {
            val inst: *instruction.Instruction = ?fn.instrs[sites[i].instr::u32];
            inst.operands[sites[i].slot] = cache[ci].vec;
        }
        i = i + 1;
    }
    splat_free(m, sites, cache, cap);
    ret err[fail.Fail].ok{};
}

fun splat_free(m: *ir.Module, sites: *SplatSite, cache: *SplatEntry, cap: u32) {
    A.deallocate[SplatSite](m.alloc, sites, cap::usize);
    A.deallocate[SplatEntry](m.alloc, cache, cap::usize);
}

fun splat_lookup(cache: *SplatEntry, cn: u32, v: value.Value, to: ir_type.IrTypeId) u32 {
    var i: u32 = 0;
    for (i < cn) {
        if (cache[i].to == to && dep.equal(cache[i].key, v)) { ret i; }
        i = i + 1;
    }
    ret ver.NONE_U32;
}

# the element type of a vector type, IRT_NIL for any other
fun lane_type(m: *ir.Module, ty: ir_type.IrTypeId) ir_type.IrTypeId {
    val t: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (sel t.none)                        { ret ir_type.IRT_NIL; }
    if (t.some.kind != ir_type.IRT_VECTOR) { ret ir_type.IRT_NIL; }
    ret t.some.data.vector_.element;
}

# a uniform count of another integer width as the lane type, which admission
# held to a narrower count or a count-bounded shift's, so its value is kept
fun emit_uniform_count(b: *builder.Builder, v: value.Value, to: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    if (vecform.scalar_bits(b.m, v.ty) < vecform.scalar_bits(b.m, to)) { ret builder.emit_zext(b, v, to); }
    ret builder.emit_trunc(b, v, to);
}

fun emit_lane_splat(b: *builder.Builder, v: value.Value, lanes: u32, tgt: *target.Target, itn: *intern.Interner) res[value.Value, fail.Fail] {
    val rat: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?b.m.types, v.ty, lanes);
    if (sel rat.err) { ret res[value.Value, fail.Fail].err{rat.err}; }
    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?b.m.types, v.ty, lanes);
    if (sel rvt.err) { ret res[value.Value, fail.Fail].err{rvt.err}; }
    ret emit_splat(b, v, rat.ok, rvt.ok, lanes, tgt, itn);
}

# a splat of a constant is one load from a read-only global holding the
# lanes; any other splat is built on the stack
fun emit_splat(b: *builder.Builder, v: value.Value, arr_ty: ir_type.IrTypeId, vec_ty: ir_type.IrTypeId, lanes: u32, tgt: *target.Target, itn: *intern.Interner) res[value.Value, fail.Fail] {
    if (itn != nil && (v.kind == value.VAL_CONST_INT || v.kind == value.VAL_CONST_FLOAT)) {
        val rc: res[value.Value, fail.Fail] = const_splat_global(b.m, v, arr_ty, lanes, tgt, itn);
        if (sel rc.err) { ret rc; }
        ret builder.emit_load(b, rc.ok, vec_ty);
    }
    val rit: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?b.m.types, 64);
    if (sel rit.err) { ret res[value.Value, fail.Fail].err{rit.err}; }
    val idx_ty: ir_type.IrTypeId            = rit.ok;
    val ras:    res[value.Value, fail.Fail] = builder.emit_alloca(b, arr_ty, value.const_int(1, idx_ty));
    if (sel ras.err) { ret ras; }
    val slot: value.Value = ras.ok;
    var lane: u32         = 0;
    for (lane < lanes) {
        val rg: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, lane, idx_ty);
        if (sel rg.err) { ret rg; }
        val r_905: err[fail.Fail] = builder.emit_store(b, v, rg.ok);
        if (sel r_905.err) { ret res[value.Value, fail.Fail].err{r_905.err}; }
        lane = lane + 1;
    }
    ret builder.emit_load(b, slot, vec_ty);
}

fun const_splat_global(m: *ir.Module, v: value.Value, arr_ty: ir_type.IrTypeId, lanes: u32, tgt: *target.Target, itn: *intern.Interner) res[value.Value, fail.Fail] {
    val elem_bytes: u32 = ir_type.byte_size_for_machine(?m.types, v.ty, resolved.layout_machine(tgt));
    if (elem_bytes == 0 || elem_bytes > 8) { ret res[value.Value, fail.Fail].err{fail.message("vectorize: splat lane width is not a scalar width")}; }
    var bits: u64 = 0;
    if (v.kind == value.VAL_CONST_INT) { bits = v.data.int_lit; }
    or (elem_bytes == 4) {
        val f: f32 = v.data.float_lit::f32;
        bits = (f:~u32)::u64;
    }
    or {
        bits = v.data.float_lit:~u64;
    }

    val total: u32               = elem_bytes * lanes;
    val rb:    res[*u8, A.Error] = A.allocate[u8](m.alloc, total::usize);
    if (sel rb.err) { ret res[value.Value, fail.Fail].err{fail.refused(rb.err)}; }
    val bytes: *u8 = rb.ok;
    var i:     u32 = 0;
    for (i < total) {
        val k: u32 = i % elem_bytes;
        bytes[i] = ((bits >> (k::u64 * 8)) & 0xFF)::u8;
        i        = i + 1;
    }

    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret res[value.Value, fail.Fail].err{rp.err}; }
    val init: value.Value = value.const_bytes(bytes, total, arr_ty);

    var name_buf: [32]u8;
    val prefix:   str   = ".Lsplat.";
    var n:        usize = 0;
    val pp:       *u8   = prefix::*u8;
    for (pp[n] != 0) {
        name_buf[n] = pp[n];
        n           = n + 1;
    }
    var idx:    u32   = m.global_len;
    var digits: [10]u8;
    var nd:     usize = 0;
    for (nd == 0 || idx > 0) {
        digits[nd] = ('0'::u32 + idx % 10)::u8;
        idx        = idx / 10;
        nd         = nd + 1;
    }
    for (nd > 0) {
        nd          = nd - 1;
        name_buf[n] = digits[nd];
        n           = n + 1;
    }
    val rn: res[intern.StrId, A.Error] = intern.intern_bytes(itn, (?name_buf[0])::str, n);
    if (sel rn.err) { ret res[value.Value, fail.Fail].err{fail.refused(rn.err)}; }

    if (m.global_len == m.global_cap) {
        var new_cap: u32 = m.global_cap * 2;
        if (new_cap == 0) { new_cap = 4; }
        val rg: res[*ir.Global, A.Error] = A.reallocate[ir.Global](m.alloc, m.globals, m.global_cap::usize, new_cap::usize);
        if (sel rg.err) { ret res[value.Value, fail.Fail].err{fail.refused(rg.err)}; }
        m.globals    = rg.ok;
        m.global_cap = new_cap;
    }
    val gix: u32 = m.global_len;
    var g:   ir.Global;
    g.name         = rn.ok;
    g.ty           = arr_ty;
    g.init         = init;
    g.is_mut       = false;
    g.is_pub       = false;
    g.is_extern    = false;
    g.is_import    = false;
    g.is_local     = true;
    g.is_embed     = false;
    g.align        = 16;
    g.section      = intern.STR_NIL;
    g.iface        = 0;
    g.iface_a      = 0;
    g.iface_b      = 0;
    g.iface_flags  = 0;
    g.disp         = intern.STR_NIL;
    g.ty_sem       = semtype.TYPE_NIL;
    m.globals[gix] = g;
    m.global_len   = gix + 1;
    ret res[value.Value, fail.Fail].ok{value.global(gix, rp.ok)};
}

fun latch_update(fn: *ir.Function, pid: id.InstructionId, latch: id.BlockId) id.InstructionId {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret id.INSTR_NIL; }
    val phi: *instruction.Instruction = opt_.some;
    var o:   u32                      = 0;
    for (o < phi.operand_count) {
        if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == latch && o + 1 < phi.operand_count) {
            if (phi.operands[o + 1].kind == value.VAL_INSTR) { ret phi.operands[o + 1].data.instr; }
            ret id.INSTR_NIL;
        }
        o = o + 1;
    }
    ret id.INSTR_NIL;
}

fun scale_recurrence_steps(fn: *ir.Function, lp: *loops.Loop, lanes: u32) err[fail.Fail] {
    val hdr: *ir.Block = ?fn.blocks[lp.header::u32];
    var pi:  u32       = 0;
    for (pi < hdr.phi_count) {
        val uid: id.InstructionId = latch_update(fn, hdr.phis[pi], lp.latch);
        if (uid == id.INSTR_NIL) { ret err[fail.Fail].err{fail.message("vectorize: loop recurrence has no latch update")}; }
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, uid);
        if (sel opt_.none) { ret err[fail.Fail].err{fail.message("vectorize: loop recurrence update is missing")}; }
        val upd:    *instruction.Instruction = opt_.some;
        var scaled: bool                     = false;
        var si:     u32                      = 0;
        for (si < upd.operand_count) {
            if (upd.operands[si].kind == value.VAL_CONST_INT) {
                upd.operands[si] = value.const_int(upd.operands[si].data.int_lit * lanes::u64, upd.operands[si].ty);
                scaled           = true;
            }
            si = si + 1;
        }
        if (!scaled) { ret err[fail.Fail].err{fail.message("vectorize: loop recurrence has no constant step")}; }
        pi = pi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun enter_remainder_from(fn: *ir.Function, rem_header: id.BlockId, from: id.BlockId, vec_header: id.BlockId) bool {
    val rb: *ir.Block = ?fn.blocks[rem_header::u32];
    val vb: *ir.Block = ?fn.blocks[vec_header::u32];
    if (rb.phi_count != vb.phi_count) { ret false; }
    var pi: u32 = 0;
    for (pi < rb.phi_count) {
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, rb.phis[pi]);
        if (sel opt_.none) { ret false; }
        val phi: *instruction.Instruction = opt_.some;
        val src: value.Value              = value.instr(vb.phis[pi], phi.ty);
        var o:   u32                      = 0;
        for (o < phi.operand_count) {
            if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == from) {
                phi.operands[o].data.int_lit = vec_header::u64;
                if (o + 1 < phi.operand_count) { phi.operands[o + 1] = value.retype(src, phi.operands[o + 1].ty); }
            }
            o = o + 1;
        }
        pi = pi + 1;
    }
    ret true;
}

fun run_reductions(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, float_reassoc: bool, itn: *intern.Interner) res[bool, fail.Fail] {
    var changed: bool                               = false;
    val ral:     res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, m.alloc);
    if (sel ral.err) { ret res[bool, fail.Fail].err{ral.err}; }
    var la: loops.LoopAnalysis = ral.ok;

    val cap: u32                       = la.loop_len + 1;
    val rhh: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, cap::usize);
    if (sel rhh.err) {
        loops.dnit(?la);
        ret res[bool, fail.Fail].err{fail.refused(rhh.err)};
    }
    val headers: *id.BlockId                      = rhh.ok;
    val rra:     res[*dep.ReductionInfo, A.Error] = A.allocate[dep.ReductionInfo](m.alloc, cap::usize);
    if (sel rra.err) {
        A.deallocate[id.BlockId](m.alloc, headers, cap::usize);
        loops.dnit(?la);
        ret res[bool, fail.Fail].err{fail.refused(rra.err)};
    }
    val reds: *dep.ReductionInfo = rra.ok;

    var hn: u32 = 0;
    var lx: u32 = 0;
    for (lx < la.loop_len) {
        var ri:          dep.ReductionInfo;
        val candidate_r: res[bool, fail.Fail] = reduction_candidate(m, tgt, fn, ?la, lx, float_reassoc, ?ri);
        if (sel candidate_r.err) {
            free_reds(m, headers, reds, hn, cap);
            loops.dnit(?la);
            ret candidate_r;
        }
        if (candidate_r.ok) {
            headers[hn] = la.loops[lx].header;
            reds[hn]    = ri;
            hn          = hn + 1;
        }
        lx = lx + 1;
    }
    loops.dnit(?la);

    var hi: u32 = 0;
    for (hi < hn) {
        val ra2: res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, m.alloc);
        if (sel ra2.err) {
            free_reds(m, headers, reds, hn, cap);
            ret res[bool, fail.Fail].err{ra2.err};
        }
        var la2: loops.LoopAnalysis = ra2.ok;
        val lx2: u32                = find_loop_by_header(?la2, headers[hi]);
        if (lx2 != ver.NONE_U32) {
            val vectorized_r: res[bool, fail.Fail] = vectorize_reduction(m, tgt, fn, ?la2, lx2, ?reds[hi], itn);
            if (sel vectorized_r.err) {
                loops.dnit(?la2);
                free_reds(m, headers, reds, hn, cap);
                ret vectorized_r;
            }
            if (vectorized_r.ok) { changed = true; }
        }
        loops.dnit(?la2);
        hi = hi + 1;
    }
    free_reds(m, headers, reds, hn, cap);
    ret res[bool, fail.Fail].ok{changed};
}

fun free_reds(m: *ir.Module, headers: *id.BlockId, reds: *dep.ReductionInfo, hn: u32, cap: u32) {
    var i: u32 = 0;
    for (i < hn) {
        dep.reduction_dnit(?reds[i]);
        i = i + 1;
    }
    A.deallocate[id.BlockId](m.alloc, headers, cap::usize);
    A.deallocate[dep.ReductionInfo](m.alloc, reds, cap::usize);
}

fun reduction_candidate(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, float_reassoc: bool, out_ri: *dep.ReductionInfo) res[bool, fail.Fail] {
    val lp: *loops.Loop = ?la.loops[lx];
    if (!reduction_shape_ok(lp)) { ret res[bool, fail.Fail].ok{false}; }
    val rr: res[dep.ReductionInfo, fail.Fail] = dep.analyze_reduction(fn, la, lx, ?m.types, m.alloc, float_reassoc);
    if (sel rr.err) { ret res[bool, fail.Fail].err{rr.err}; }
    var ri: dep.ReductionInfo = rr.ok;
    if (!ri.ok) {
        dep.reduction_dnit(?ri);
        ret res[bool, fail.Fail].ok{false};
    }
    if (!reduction_vectorizes(m, tgt, fn, la, lx, ?ri)) {
        dep.reduction_dnit(?ri);
        ret res[bool, fail.Fail].ok{false};
    }
    @out_ri = ri;
    ret res[bool, fail.Fail].ok{true};
}

# a counted loop stepping by one whose header alone exits
fun reduction_shape_ok(lp: *loops.Loop) bool {
    if (!lp.is_counted)                                                                                                    { ret false; }
    if (lp.preheader == id.BLOCK_NIL || lp.latch == id.BLOCK_NIL || lp.exit == id.BLOCK_NIL || lp.exiting == id.BLOCK_NIL) { ret false; }
    if (!lp.counted.iv_on_left || !lp.counted.continue_on_true)                                                            { ret false; }
    if (lp.iv.step.kind != value.VAL_CONST_INT || lp.iv.step.data.int_lit != 1)                                            { ret false; }
    ret lp.latch != lp.header && lp.exiting == lp.header;
}

# the target runs the update on the reduction's lanes: the value it combines
# in is lane-wise, and the operator packs at the accumulator's width. a
# predicated update also needs its compare lane-wise as the mask, the value
# lane-wise or splat, and the mask operations packed: the extension to the
# accumulator's width, the `and` with the value, and for an identity other
# than zero or an update on a failed compare the complement and `or`
fun reduction_vectorizes(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, ri: *dep.ReductionInfo) bool {
    val rset: res[*bool, A.Error] = A.allocate[bool](m.alloc, fn.instr_len::usize);
    if (sel rset.err) { ret false; }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, la, lx, ri.accesses, ri.access_count, ri.elem_ty, ri.acc_ty, ri.is_float, !ri.is_float, false, ri.pred_cmp, vset);
    val acc_bits: u32  = vecform.scalar_bits(m, ri.acc_ty);
    val rv_lanes: bool = in_set(fn, vset, ri.rv);
    var ok:       bool = supported_vector_op(tgt, ri.op, ri.is_float, acc_bits);
    if (ri.pred_join == id.INSTR_NIL) { ok = ok && rv_lanes; }
    or {
        val cmp:       *instruction.Instruction = ?fn.instrs[ri.pred_cmp::u32];
        val mask_bits: u32                      = vecform.scalar_bits(m, cmp.operands[0].ty);
        ok = ok && vset[ri.pred_cmp::u32] && supported_vector_op(tgt, cmp.kind, false, mask_bits);
        ok = ok && (rv_lanes || splattable(ri.rv, la, lx, ri.acc_ty));
        ok = ok && supported_vector_op(tgt, instruction.OP_AND, false, acc_bits);
        if (!ri.pred_on_true || !identity_is_zero(ri.op)) {
            ok = ok && supported_vector_op(tgt, instruction.OP_NOT, false, acc_bits) && supported_vector_op(tgt, instruction.OP_OR, false, acc_bits);
        }
        if (mask_bits != acc_bits) { ok = ok && vecform.extends(tgt, instruction.OP_SEXT, acc_bits, mask_bits); }
    }
    A.deallocate[bool](m.alloc, vset, fn.instr_len::usize);
    ret ok;
}

fun in_set(fn: *ir.Function, vset: *bool, v: value.Value) bool {
    ret v.kind == value.VAL_INSTR && v.data.instr::u32 < fn.instr_len && vset[v.data.instr::u32];
}

fun reduction_identity(op: instruction.InstrKind, ty: ir_type.IrTypeId, is_float: bool) value.Value {
    if (is_float) {
        if (op == instruction.OP_MUL) { ret value.const_float(1.0, ty); }
        ret value.const_float(-0.0, ty);
    }
    if (op == instruction.OP_AND) { ret value.const_int(0xFFFFFFFFFFFFFFFF, ty); }
    if (op == instruction.OP_MUL) { ret value.const_int(1, ty); }
    ret value.const_int(0, ty);
}

fun identity_is_zero(op: instruction.InstrKind) bool {
    ret op != instruction.OP_AND && op != instruction.OP_MUL;
}

fun emit_reduction_op(b: *builder.Builder, op: instruction.InstrKind, x: value.Value, y: value.Value) res[value.Value, fail.Fail] {
    if (op == instruction.OP_XOR) { ret builder.emit_xor(b, x, y); }
    if (op == instruction.OP_OR)  { ret builder.emit_or(b, x, y); }
    if (op == instruction.OP_AND) { ret builder.emit_and(b, x, y); }
    if (op == instruction.OP_MUL) { ret builder.emit_mul(b, x, y); }
    ret builder.emit_add(b, x, y);
}

# the predicated update of the vector body as a plain one, `acc op t`, where t
# is the combined value on the lanes whose mask is set and the operator's
# identity on the others. a diamond's arms move ahead of its branch first, so
# every lane runs them, which the analysis proved safe. the new update is the
# accumulator's, and `t` the value it combines in
fun unpredicate(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, ri: *dep.ReductionInfo, out_upd: *id.InstructionId, out_rv: *value.Value) err[fail.Fail] {
    var at: id.BlockId = la.instr_block[ri.pred_join::u32];
    if (ri.pred_entry != id.BLOCK_NIL) {
        at = ri.pred_entry;
        val rt: err[fail.Fail] = hoist_arm(m, fn, ri.pred_arm_t, at);
        if (sel rt.err) { ret rt; }
        val rf: err[fail.Fail] = hoist_arm(m, fn, ri.pred_arm_f, at);
        if (sel rf.err) { ret rf; }
        val ru: err[fail.Fail] = make_unconditional(m, fn, at, ri.pred_block);
        if (sel ru.err) { ret ru; }
    }
    val cmp:     *instruction.Instruction = ?fn.instrs[ri.pred_cmp::u32];
    val mask_ty: ir_type.IrTypeId         = cmp.operands[0].ty;
    cmp.ty = mask_ty;

    val term: id.InstructionId = fn.blocks[at::u32].terminator;
    fn.blocks[at::u32].terminator = id.INSTR_NIL;
    val rup: res[value.Value, fail.Fail] = emit_unpredicated(m, fn, at, ri, mask_ty, out_rv);
    fn.blocks[at::u32].terminator = term;
    if (sel rup.err) { ret err[fail.Fail].err{rup.err}; }

    mutate.replace_uses(fn, ri.pred_join, rup.ok);
    mutate.replace_uses(fn, ri.acc_update, rup.ok);
    drop_instr(fn, ri.acc_update);
    if (ri.pred_entry != id.BLOCK_NIL) { drop_phi(?fn.blocks[ri.pred_block::u32], ri.pred_join); }
    or                                 { drop_instr(fn, ri.pred_join); }
    @out_upd = rup.ok.data.instr;
    ret err[fail.Fail].ok{};
}

# `acc op t` at the end of `at`, t the masked value it stores in `out_rv`
fun emit_unpredicated(m: *ir.Module, fn: *ir.Function, at: id.BlockId, ri: *dep.ReductionInfo, mask_ty: ir_type.IrTypeId, out_rv: *value.Value) res[value.Value, fail.Fail] {
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, at);
    builder.set_loc(?b, fn.instrs[ri.pred_join::u32].loc);
    var mask: value.Value = value.instr(ri.pred_cmp, mask_ty);
    if (mask_ty != ri.acc_ty) {
        val rx: res[value.Value, fail.Fail] = builder.emit_sext(?b, mask, ri.acc_ty);
        if (sel rx.err) { ret rx; }
        mask = rx.ok;
    }
    if (!ri.pred_on_true) {
        val rn: res[value.Value, fail.Fail] = builder.emit_not(?b, mask);
        if (sel rn.err) { ret rn; }
        mask = rn.ok;
    }
    val ra: res[value.Value, fail.Fail] = builder.emit_and(?b, mask, ri.rv);
    if (sel ra.err) { ret ra; }
    var t: value.Value = ra.ok;
    if (!identity_is_zero(ri.op)) {
        val rn: res[value.Value, fail.Fail] = builder.emit_not(?b, mask);
        if (sel rn.err) { ret rn; }
        val ri_: res[value.Value, fail.Fail] = builder.emit_and(?b, rn.ok, reduction_identity(ri.op, ri.acc_ty, false));
        if (sel ri_.err) { ret ri_; }
        val ro: res[value.Value, fail.Fail] = builder.emit_or(?b, t, ri_.ok);
        if (sel ro.err) { ret ro; }
        t = ro.ok;
    }
    @out_rv = t;
    ret emit_reduction_op(?b, ri.op, value.instr(ri.acc_phi, ri.acc_ty), t);
}

fun hoist_arm(m: *ir.Module, fn: *ir.Function, arm: id.BlockId, to: id.BlockId) err[fail.Fail] {
    if (arm == id.BLOCK_NIL) { ret err[fail.Fail].ok{}; }
    val n: u32 = fn.blocks[arm::u32].instr_count;
    var k: u32 = 0;
    for (k < n) {
        val ra: err[fail.Fail] = ir.block_append_instr(m, ?fn.blocks[to::u32], fn.blocks[arm::u32].instructions[k]);
        if (sel ra.err) { ret ra; }
        k = k + 1;
    }
    fn.blocks[arm::u32].instr_count = 0;
    ret err[fail.Fail].ok{};
}

fun drop_instr(fn: *ir.Function, iid: id.InstructionId) {
    var bi: u32 = 0;
    for (bi < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[bi];
        var w:   u32       = 0;
        var r:   u32       = 0;
        for (r < blk.instr_count) {
            if (blk.instructions[r] != iid) {
                blk.instructions[w] = blk.instructions[r];
                w                   = w + 1;
            }
            r = r + 1;
        }
        blk.instr_count = w;
        bi              = bi + 1;
    }
}

fun drop_phi(blk: *ir.Block, pid: id.InstructionId) {
    var w: u32 = 0;
    var r: u32 = 0;
    for (r < blk.phi_count) {
        if (blk.phis[r] != pid) {
            blk.phis[w] = blk.phis[r];
            w           = w + 1;
        }
        r = r + 1;
    }
    blk.phi_count = w;
}

# a count accumulated in narrow lanes (#4161): the predicated update adds a
# constant `c` to an accumulator wider than the compared element, so each lane
# gains at most `c` per iteration. the lanes count at the element's width
# instead, and every `block` iterations, before any lane can wrap, they fold
# into the wide accumulator: `wide` lanes of the accumulator's type, through
# the widening group sum where the target packs it (x86-64 psadbw) and the
# lane-wise zero extension otherwise
rec NarrowCount {
    mask_ty: ir_type.IrTypeId;
    nvec_ty: ir_type.IrTypeId;
    narr_ty: ir_type.IrTypeId;
    c:       u64;
    block:   u64;
    wide:    u32;
    wvec_ty: ir_type.IrTypeId;
    warr_ty: ir_type.IrTypeId;
    group:   bool;
}

fun narrow_count(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, ri: *dep.ReductionInfo, out: *NarrowCount) res[bool, fail.Fail] {
    if (ri.is_float || ri.op != instruction.OP_ADD || ri.pred_join == id.INSTR_NIL) { ret res[bool, fail.Fail].ok{false}; }
    val rv: value.Value = ir.constant_behind(fn, ri.rv);
    if (rv.kind != value.VAL_CONST_INT) { ret res[bool, fail.Fail].ok{false}; }
    val mask_ty:   ir_type.IrTypeId = fn.instrs[ri.pred_cmp::u32].operands[0].ty;
    val mask_bits: u32              = vecform.scalar_bits(m, mask_ty);
    val acc_bits:  u32              = vecform.scalar_bits(m, ri.acc_ty);
    if (!plain_int(m, mask_ty) || mask_bits != vecform.scalar_bits(m, ri.elem_ty) || mask_bits >= acc_bits) {
        ret res[bool, fail.Fail].ok{false};
    }
    val c:   u64 = rv.data.int_lit;
    val top: u64 = (1::u64 << mask_bits::u64) - 1;
    if (c == 0 || c > top) { ret res[bool, fail.Fail].ok{false}; }
    if (!supported_vector_op(tgt, instruction.OP_ADD, false, mask_bits) || !supported_vector_op(tgt, instruction.OP_AND, false, mask_bits)) {
        ret res[bool, fail.Fail].ok{false};
    }
    if (!ri.pred_on_true && !supported_vector_op(tgt, instruction.OP_NOT, false, mask_bits)) { ret res[bool, fail.Fail].ok{false}; }
    val lanes: u32 = ri.lanes;
    if ((lanes * mask_bits) % acc_bits != 0) { ret res[bool, fail.Fail].ok{false}; }
    val rn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, mask_ty, lanes);
    if (sel rn.err) { ret res[bool, fail.Fail].err{rn.err}; }
    val rna: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, mask_ty, lanes);
    if (sel rna.err) { ret res[bool, fail.Fail].err{rna.err}; }
    var wide: u32                              = lanes * mask_bits / acc_bits;
    val rg:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, ri.acc_ty, wide);
    if (sel rg.err) { ret res[bool, fail.Fail].err{rg.err}; }
    var group: bool = vecform.widen_sum_packs(m, tgt, rg.ok, rn.ok);
    if (!group) {
        if (!vecform.extends(tgt, instruction.OP_ZEXT, acc_bits, mask_bits)) { ret res[bool, fail.Fail].ok{false}; }
        wide = lanes;
    }
    val rw: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, ri.acc_ty, wide);
    if (sel rw.err) { ret res[bool, fail.Fail].err{rw.err}; }
    val rwa: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, ri.acc_ty, wide);
    if (sel rwa.err) { ret res[bool, fail.Fail].err{rwa.err}; }
    out.mask_ty = mask_ty;
    out.nvec_ty = rn.ok;
    out.narr_ty = rna.ok;
    out.c       = c;
    out.block   = top / c;
    out.wide    = wide;
    out.wvec_ty = rw.ok;
    out.warr_ty = rwa.ok;
    out.group   = group;
    ret res[bool, fail.Fail].ok{true};
}

# the narrow lanes folded into `wide` lanes of the accumulator's type
fun emit_narrow_fold(b: *builder.Builder, nc: *NarrowCount, narrow: value.Value) res[value.Value, fail.Fail] {
    if (nc.group) { ret builder.emit_vec_widen_sum_u(b, narrow, nc.wvec_ty); }
    ret builder.emit_zext(b, narrow, nc.wvec_ty);
}

# the predicated update of a narrow count: `accn + (mask & c)` at the
# element's width, `accn` the narrow accumulator's header phi. the wide
# accumulator is no longer updated in the body; its latch value is itself
fun unpredicate_narrow(m: *ir.Module, fn: *ir.Function, la: *loops.LoopAnalysis, ri: *dep.ReductionInfo, nc: *NarrowCount, accn: value.Value, vset_out: *id.InstructionId, out_upd: *id.InstructionId) err[fail.Fail] {
    var at: id.BlockId = la.instr_block[ri.pred_join::u32];
    if (ri.pred_entry != id.BLOCK_NIL) {
        at = ri.pred_entry;
        val rt: err[fail.Fail] = hoist_arm(m, fn, ri.pred_arm_t, at);
        if (sel rt.err) { ret rt; }
        val rf: err[fail.Fail] = hoist_arm(m, fn, ri.pred_arm_f, at);
        if (sel rf.err) { ret rf; }
        val ru: err[fail.Fail] = make_unconditional(m, fn, at, ri.pred_block);
        if (sel ru.err) { ret ru; }
    }
    fn.instrs[ri.pred_cmp::u32].ty = nc.mask_ty;

    val term: id.InstructionId = fn.blocks[at::u32].terminator;
    fn.blocks[at::u32].terminator = id.INSTR_NIL;
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, at);
    builder.set_loc(?b, fn.instrs[ri.pred_join::u32].loc);
    var mask: value.Value = value.instr(ri.pred_cmp, nc.mask_ty);
    var n:    u32         = 0;
    if (!ri.pred_on_true) {
        val rn: res[value.Value, fail.Fail] = builder.emit_not(?b, mask);
        if (sel rn.err) {
            fn.blocks[at::u32].terminator = term;
            ret err[fail.Fail].err{rn.err};
        }
        mask        = rn.ok;
        vset_out[n] = mask.data.instr;
        n           = n + 1;
    }
    val ra: res[value.Value, fail.Fail] = builder.emit_and(?b, mask, value.const_int(nc.c, nc.mask_ty));
    if (sel ra.err) {
        fn.blocks[at::u32].terminator = term;
        ret err[fail.Fail].err{ra.err};
    }
    vset_out[n] = ra.ok.data.instr;
    n           = n + 1;
    val rs: res[value.Value, fail.Fail] = builder.emit_add(?b, accn, ra.ok);
    fn.blocks[at::u32].terminator = term;
    if (sel rs.err) { ret err[fail.Fail].err{rs.err}; }
    vset_out[n] = rs.ok.data.instr;

    val wide_self: value.Value = value.instr(ri.acc_phi, ri.acc_ty);
    mutate.replace_uses(fn, ri.pred_join, wide_self);
    mutate.replace_uses(fn, ri.acc_update, wide_self);
    drop_instr(fn, ri.acc_update);
    if (ri.pred_entry != id.BLOCK_NIL) { drop_phi(?fn.blocks[ri.pred_block::u32], ri.pred_join); }
    or                                 { drop_instr(fn, ri.pred_join); }
    @out_upd = rs.ok.data.instr;
    ret err[fail.Fail].ok{};
}

# the fold of the narrow lanes every `block` iterations: a counter beside the
# induction variable, and the latch taking the loop through a fold block when
# it reaches the block, which adds the narrow lanes into the wide accumulator
# and restarts them and the counter at zero
fun emit_narrow_flush(m: *ir.Module, fn: *ir.Function, nc: *NarrowCount, header: id.BlockId, latch: id.BlockId,
    iv_ty: ir_type.IrTypeId, acc_phi: id.InstructionId, accn_phi: id.InstructionId, upd: id.InstructionId, nacc0: value.Value) err[fail.Fail] {
    val wide_acc: value.Value              = value.instr(acc_phi, nc.wvec_ty);
    val ap:       *instruction.Instruction = ?fn.instrs[acc_phi::u32];
    ap.ty = nc.wvec_ty;
    # the loop is entered from the block splatting placed ahead of it
    var entry: id.BlockId = id.BLOCK_NIL;
    var o:     u32        = 0;
    for (o < ap.operand_count) {
        if (refs.operand_is_block(ap.kind, o)) {
            if (ir.block_target(ap.operands[o]) != latch) { entry = ir.block_target(ap.operands[o]); }
        }
        or (ap.operands[o].kind == value.VAL_INSTR && ap.operands[o].data.instr == acc_phi) { ap.operands[o] = wide_acc; }
        o = o + 1;
    }

    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);
    builder.set_block(?b, header);
    val rj: res[value.Value, fail.Fail] = builder.emit_phi(?b, iv_ty);
    if (sel rj.err) { ret err[fail.Fail].err{rj.err}; }
    val j: value.Value = rj.ok;

    val rfb: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rfb.err) { ret err[fail.Fail].err{rfb.err}; }
    val flush: id.BlockId = rfb.ok;

    fn.blocks[latch::u32].terminator = id.INSTR_NIL;
    builder.set_block(?b, latch);
    val rj1: res[value.Value, fail.Fail] = builder.emit_add(?b, j, value.const_int(1, iv_ty));
    if (sel rj1.err) { ret err[fail.Fail].err{rj1.err}; }
    val req: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, rj1.ok, value.const_int(nc.block, iv_ty));
    if (sel req.err) { ret err[fail.Fail].err{req.err}; }
    val rcb: err[fail.Fail] = builder.emit_cbr(?b, req.ok, flush, header);
    if (sel rcb.err) { ret rcb; }

    builder.set_block(?b, flush);
    val rw: res[value.Value, fail.Fail] = emit_narrow_fold(?b, nc, value.instr(upd, nc.nvec_ty));
    if (sel rw.err) { ret err[fail.Fail].err{rw.err}; }
    val ra: res[value.Value, fail.Fail] = builder.emit_add(?b, wide_acc, rw.ok);
    if (sel ra.err) { ret err[fail.Fail].err{ra.err}; }
    val rbr: err[fail.Fail] = builder.emit_br(?b, header);
    if (sel rbr.err) { ret rbr; }

    val zero: value.Value    = value.const_int(0, iv_ty);
    val r0:   err[fail.Fail] = builder.phi_add_incoming(?b, j, entry, zero);
    if (sel r0.err) { ret r0; }
    val r1: err[fail.Fail] = builder.phi_add_incoming(?b, j, latch, rj1.ok);
    if (sel r1.err) { ret r1; }
    val r2: err[fail.Fail] = builder.phi_add_incoming(?b, j, flush, zero);
    if (sel r2.err) { ret r2; }
    val r3: err[fail.Fail] = builder.phi_add_incoming(?b, value.instr(acc_phi, nc.wvec_ty), flush, ra.ok);
    if (sel r3.err) { ret r3; }
    val r4: err[fail.Fail] = builder.phi_add_incoming(?b, value.instr(accn_phi, nc.nvec_ty), flush, nacc0);
    if (sel r4.err) { ret r4; }
    val hblk: *ir.Block = ?fn.blocks[header::u32];
    var k:    u32       = 0;
    for (k < hblk.phi_count) {
        val pid: id.InstructionId = hblk.phis[k];
        if (pid != acc_phi && pid != accn_phi && pid != j.data.instr) {
            val r5: err[fail.Fail] = builder.phi_add_incoming(?b, value.instr(pid, fn.instrs[pid::u32].ty), flush, phi_value_from(fn, pid, latch));
            if (sel r5.err) { ret r5; }
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun vectorize_reduction(m: *ir.Module, tgt: *target.Target, fn: *ir.Function, la: *loops.LoopAnalysis, lx: u32, ri: *dep.ReductionInfo, itn: *intern.Interner) res[bool, fail.Fail] {
    val lp: *loops.Loop = ?la.loops[lx];
    if (!reduction_shape_ok(lp)) { ret res[bool, fail.Fail].ok{false}; }

    val header:    id.BlockId            = lp.header;
    val latch:     id.BlockId            = lp.latch;
    val preheader: id.BlockId            = lp.preheader;
    val exit:      id.BlockId            = lp.exit;
    val iv_phi:    id.InstructionId      = lp.iv.phi;
    val iv_upd:    id.InstructionId      = lp.iv.update;
    val iv_ty:     ir_type.IrTypeId      = lp.iv.init.ty;
    val cmp_id:    id.InstructionId      = lp.counted.cmp;
    val orig_pred: instruction.InstrKind = lp.counted.pred;
    val lanes:     u32                   = ri.lanes;
    val acc_ty:    ir_type.IrTypeId      = ri.acc_ty;
    val is_float:  bool                  = ri.is_float;
    val red_op:    instruction.InstrKind = ri.op;
    val acc_phi:   id.InstructionId      = ri.acc_phi;
    val acc_init:  value.Value           = ri.acc_init;

    val rvt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_vector(?m.types, acc_ty, lanes);
    if (sel rvt.err) { ret res[bool, fail.Fail].err{rvt.err}; }
    val vec_ty: ir_type.IrTypeId                 = rvt.ok;
    val rat:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, acc_ty, lanes);
    if (sel rat.err) { ret res[bool, fail.Fail].err{rat.err}; }
    val arr_ty: ir_type.IrTypeId                 = rat.ok;
    val rot:    res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rot.err) { ret res[bool, fail.Fail].err{rot.err}; }
    val ord_ty: ir_type.IrTypeId = rot.ok;

    var nc:  NarrowCount;
    val rnc: res[bool, fail.Fail] = narrow_count(m, tgt, fn, ri, ?nc);
    if (sel rnc.err) { ret rnc; }
    val narrow:    bool             = rnc.ok;
    var acc_vec:   ir_type.IrTypeId = vec_ty;
    var acc_arr:   ir_type.IrTypeId = arr_ty;
    var acc_lanes: u32              = lanes;
    if (narrow) {
        acc_vec   = nc.wvec_ty;
        acc_arr   = nc.warr_ty;
        acc_lanes = nc.wide;
    }

    val hblk:    *ir.Block = ?fn.blocks[header::u32];
    val acc_idx: u32       = phi_index(hblk, acc_phi);
    val iv_idx:  u32       = phi_index(hblk, iv_phi);

    val body_len: u32                       = lp.body_len;
    val rfb:      res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rfb.err) { ret res[bool, fail.Fail].err{fail.refused(rfb.err)}; }
    val fbody: *id.BlockId = rfb.ok;
    var ci:    u32         = 0;
    for (ci < body_len) {
        fbody[ci] = lp.body[ci];
        ci        = ci + 1;
    }
    val rrc: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](m.alloc, body_len::usize);
    if (sel rrc.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        ret res[bool, fail.Fail].err{fail.refused(rrc.err)};
    }
    val rem: *id.BlockId    = rrc.ok;
    val rcl: err[fail.Fail] = ver.clone_region(m, fn, fbody, body_len, rem);
    if (sel rcl.err) {
        A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
        A.deallocate[id.BlockId](m.alloc, rem, body_len::usize);
        ret res[bool, fail.Fail].err{rcl.err};
    }
    val rem_header: id.BlockId       = rem[ver.region_index(fbody, body_len, header)];
    val rblk:       *ir.Block        = ?fn.blocks[rem_header::u32];
    val sacc:       id.InstructionId = rblk.phis[acc_idx];
    val iv_r:       id.InstructionId = rblk.phis[iv_idx];
    A.deallocate[id.BlockId](m.alloc, fbody, body_len::usize);
    A.deallocate[id.BlockId](m.alloc, rem, body_len::usize);

    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, fn);

    val rvp: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rvp.err) { ret res[bool, fail.Fail].err{rvp.err}; }
    val vpre: id.BlockId = rvp.ok;
    builder.set_block(?b, vpre);
    val rv0: res[value.Value, fail.Fail] = build_accumulator_init(?b, red_op, acc_init, acc_ty, is_float, acc_arr, acc_vec, ord_ty, acc_lanes);
    if (sel rv0.err) { ret res[bool, fail.Fail].err{rv0.err}; }
    val vacc0: value.Value = rv0.ok;
    var nacc0: value.Value = vacc0;
    if (narrow) {
        val rn0: res[value.Value, fail.Fail] = build_accumulator_init(?b, instruction.OP_ADD, value.const_int(0, nc.mask_ty), nc.mask_ty, false, nc.narr_ty, nc.nvec_ty, ord_ty, lanes);
        if (sel rn0.err) { ret res[bool, fail.Fail].err{rn0.err}; }
        nacc0 = rn0.ok;
    }
    val rbe: res[value.Value, fail.Fail] = ver.emit_exclusive_bound(?b, ?lp.counted);
    if (sel rbe.err) { ret res[bool, fail.Fail].err{rbe.err}; }
    val bound_ex: value.Value                 = rbe.ok;
    val rlb:      res[value.Value, fail.Fail] = emit_lane_bound(?b, bound_ex, lanes, iv_ty, orig_pred);
    if (sel rlb.err) { ret res[bool, fail.Fail].err{rlb.err}; }
    val lane_bound: value.Value    = rlb.ok;
    val r_1137:     err[fail.Fail] = builder.emit_br(?b, header);
    if (sel r_1137.err) { ret res[bool, fail.Fail].err{r_1137.err}; }
    ver.redirect_terminator(fn, preheader, header, vpre);
    ver.relabel_phi_pred(fn, header, preheader, vpre);
    set_phi_value(fn, header, vpre, acc_phi, vacc0);

    val rrp: err[fail.Fail] = replace_out_of_loop_uses(m, fn, acc_phi, value.instr(sacc, acc_ty), lp.body, lp.body_len, fn.instr_len);
    if (sel rrp.err) { ret res[bool, fail.Fail].err{rrp.err}; }

    # the narrow accumulator, beside the wide one in the header
    var accn_phi: id.InstructionId = id.INSTR_NIL;
    if (narrow) {
        builder.set_block(?b, header);
        val rp: res[value.Value, fail.Fail] = builder.emit_phi(?b, nc.mask_ty);
        if (sel rp.err) { ret res[bool, fail.Fail].err{rp.err}; }
        accn_phi = rp.ok.data.instr;
        val ri0: err[fail.Fail] = builder.phi_add_incoming(?b, rp.ok, vpre, nacc0);
        if (sel ri0.err) { ret res[bool, fail.Fail].err{ri0.err}; }
    }

    val rcb: res[id.BlockId, fail.Fail] = ir.block_add(m, fn);
    if (sel rcb.err) { ret res[bool, fail.Fail].err{rcb.err}; }
    val combine: id.BlockId = rcb.ok;
    builder.set_block(?b, combine);
    var vfinal: value.Value = value.instr(acc_phi, acc_vec);
    if (narrow) {
        val rf: res[value.Value, fail.Fail] = emit_narrow_fold(?b, ?nc, value.instr(accn_phi, nc.nvec_ty));
        if (sel rf.err) { ret res[bool, fail.Fail].err{rf.err}; }
        val rfa: res[value.Value, fail.Fail] = builder.emit_add(?b, vfinal, rf.ok);
        if (sel rfa.err) { ret res[bool, fail.Fail].err{rfa.err}; }
        vfinal = rfa.ok;
    }
    val rhc: res[value.Value, fail.Fail] = emit_horizontal_combine(?b, red_op, vfinal, acc_ty, acc_arr, acc_vec, ord_ty, acc_lanes);
    if (sel rhc.err) { ret res[bool, fail.Fail].err{rhc.err}; }
    val s0:     value.Value    = rhc.ok;
    val r_1152: err[fail.Fail] = builder.emit_br(?b, rem_header);
    if (sel r_1152.err) { ret res[bool, fail.Fail].err{r_1152.err}; }

    ver.redirect_terminator(fn, header, exit, combine);
    ver.relabel_phi_pred(fn, rem_header, preheader, combine);
    set_phi_value(fn, rem_header, combine, sacc, s0);
    set_phi_value(fn, rem_header, combine, iv_r, value.instr(iv_phi, iv_ty));

    var acc_upd: id.InstructionId = ri.acc_update;
    var rv:      value.Value      = ri.rv;
    var nset:    [3]id.InstructionId;
    nset[0] = id.INSTR_NIL;
    nset[1] = id.INSTR_NIL;
    nset[2] = id.INSTR_NIL;
    if (narrow) {
        val rup: err[fail.Fail] = unpredicate_narrow(m, fn, la, ri, ?nc, value.instr(accn_phi, nc.mask_ty), ?nset[0], ?acc_upd);
        if (sel rup.err) { ret res[bool, fail.Fail].err{rup.err}; }
        val rl: err[fail.Fail] = ir.phi_append_incoming(m, ?fn.instrs[accn_phi::u32], latch, value.instr(acc_upd, nc.nvec_ty));
        if (sel rl.err) { ret res[bool, fail.Fail].err{rl.err}; }
    }
    or (ri.pred_join != id.INSTR_NIL) {
        val rup: err[fail.Fail] = unpredicate(m, fn, la, ri, ?acc_upd, ?rv);
        if (sel rup.err) { ret res[bool, fail.Fail].err{rup.err}; }
    }

    val vset_len: u32                 = fn.instr_len;
    val rset:     res[*bool, A.Error] = A.allocate[bool](m.alloc, vset_len::usize);
    if (sel rset.err) { ret res[bool, fail.Fail].err{fail.refused(rset.err)}; }
    val vset: *bool = rset.ok;
    build_vset(m, tgt, fn, la, lx, ri.accesses, ri.access_count, ri.elem_ty, acc_ty, is_float, !is_float, false, ri.pred_cmp, vset);
    if (narrow) {
        var ni: u32 = 0;
        for (ni < 3) {
            if (nset[ni] != id.INSTR_NIL) { vset[nset[ni]::u32] = true; }
            ni = ni + 1;
        }
        vset[accn_phi::u32] = true;
    }
    or {
        if (!in_set(fn, vset, rv)) {
            A.deallocate[bool](m.alloc, vset, vset_len::usize);
            panic("mach.lang.me.transform.vectorize: a reduction's combined value left the lane set its unmutated loop was proven to have; reduction_vectorizes() must be the sole gate\n");
        }
        vset[acc_phi::u32] = true;
    }
    vset[acc_upd::u32] = true;
    val rrt: err[fail.Fail] = retype_then_splat(m, tgt, fn, lp, vset, vpre, header, lanes, itn);
    A.deallocate[bool](m.alloc, vset, vset_len::usize);
    if (sel rrt.err) { ret res[bool, fail.Fail].err{rrt.err}; }

    step_iv_by_lanes(fn, iv_upd, lanes, iv_ty);

    val rbt: err[fail.Fail] = rewrite_lane_bound_test(m, fn, header, value.instr(iv_phi, iv_ty), lanes, iv_ty, lane_bound, orig_pred, cmp_id);
    if (sel rbt.err) { ret res[bool, fail.Fail].err{rbt.err}; }

    if (narrow) {
        val rfl: err[fail.Fail] = emit_narrow_flush(m, fn, ?nc, header, latch, iv_ty, acc_phi, accn_phi, acc_upd, nacc0);
        if (sel rfl.err) { ret res[bool, fail.Fail].err{rfl.err}; }
    }

    val rpr: err[fail.Fail] = ir.preds_rebuild(m, fn);
    if (sel rpr.err) { ret res[bool, fail.Fail].err{rpr.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun phi_index(blk: *ir.Block, pid: id.InstructionId) u32 {
    var i: u32 = 0;
    for (i < blk.phi_count) {
        if (blk.phis[i] == pid) { ret i; }
        i = i + 1;
    }
    ret 0;
}

fun step_iv_by_lanes(fn: *ir.Function, iv_upd: id.InstructionId, lanes: u32, iv_ty: ir_type.IrTypeId) {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iv_upd);
    if (sel opt_.some) {
        val upd: *instruction.Instruction = opt_.some;
        var si:  u32                      = 0;
        for (si < upd.operand_count) {
            if (upd.operands[si].kind == value.VAL_CONST_INT) { upd.operands[si] = value.const_int(lanes::u64, iv_ty); }
            si = si + 1;
        }
    }
}

fun build_accumulator_init(b: *builder.Builder, op: instruction.InstrKind, acc_init: value.Value, acc_ty: ir_type.IrTypeId, is_float: bool, arr_ty: ir_type.IrTypeId, vec_ty: ir_type.IrTypeId, ord_ty: ir_type.IrTypeId, lanes: u32) res[value.Value, fail.Fail] {
    val ras: res[value.Value, fail.Fail] = builder.emit_alloca(b, arr_ty, value.const_int(1, ord_ty));
    if (sel ras.err) { ret ras; }
    val slot:  value.Value = ras.ok;
    val ident: value.Value = reduction_identity(op, acc_ty, is_float);
    var lane:  u32         = 0;
    for (lane < lanes) {
        val rg: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, lane, ord_ty);
        if (sel rg.err) { ret rg; }
        var v: value.Value = ident;
        if (lane == 0) { v = acc_init; }
        val r_1221: err[fail.Fail] = builder.emit_store(b, v, rg.ok);
        if (sel r_1221.err) { ret res[value.Value, fail.Fail].err{r_1221.err}; }
        lane = lane + 1;
    }
    ret builder.emit_load(b, slot, vec_ty);
}

fun emit_horizontal_combine(b: *builder.Builder, op: instruction.InstrKind, vacc: value.Value, elem_ty: ir_type.IrTypeId, arr_ty: ir_type.IrTypeId, vec_ty: ir_type.IrTypeId, ord_ty: ir_type.IrTypeId, lanes: u32) res[value.Value, fail.Fail] {
    val ras: res[value.Value, fail.Fail] = builder.emit_alloca(b, arr_ty, value.const_int(1, ord_ty));
    if (sel ras.err) { ret ras; }
    val slot:   value.Value    = ras.ok;
    val r_1231: err[fail.Fail] = builder.emit_store(b, vacc, slot);
    if (sel r_1231.err) { ret res[value.Value, fail.Fail].err{r_1231.err}; }
    val rg0: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, 0, ord_ty);
    if (sel rg0.err) { ret rg0; }
    val rl0: res[value.Value, fail.Fail] = builder.emit_load(b, rg0.ok, elem_ty);
    if (sel rl0.err) { ret rl0; }
    var acc:  value.Value = rl0.ok;
    var lane: u32         = 1;
    for (lane < lanes) {
        val rg: res[value.Value, fail.Fail] = lane_gep(b, slot, arr_ty, lane, ord_ty);
        if (sel rg.err) { ret rg; }
        val rl: res[value.Value, fail.Fail] = builder.emit_load(b, rg.ok, elem_ty);
        if (sel rl.err) { ret rl; }
        val rc: res[value.Value, fail.Fail] = emit_reduction_op(b, op, acc, rl.ok);
        if (sel rc.err) { ret rc; }
        acc  = rc.ok;
        lane = lane + 1;
    }
    ret res[value.Value, fail.Fail].ok{acc};
}

fun lane_gep(b: *builder.Builder, slot: value.Value, arr_ty: ir_type.IrTypeId, lane: u32, idx_ty: ir_type.IrTypeId) res[value.Value, fail.Fail] {
    var idx: [2]value.Value;
    idx[0] = value.const_int(0, idx_ty);
    idx[1] = value.const_int(lane::u64, idx_ty);
    ret builder.emit_gep(b, slot, arr_ty, ?idx[0], 2);
}

fun set_phi_value(fn: *ir.Function, blk: id.BlockId, from: id.BlockId, pid: id.InstructionId, val_new: value.Value) {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, pid);
    if (sel opt_.none) { ret; }
    val phi: *instruction.Instruction = opt_.some;
    var o:   u32                      = 0;
    for (o < phi.operand_count) {
        if (refs.operand_is_block(phi.kind, o) && ir.block_target(phi.operands[o]) == from && o + 1 < phi.operand_count) {
            phi.operands[o + 1] = value.retype(val_new, phi.operands[o + 1].ty);
        }
        o = o + 1;
    }
}

fun replace_out_of_loop_uses(m: *ir.Module, fn: *ir.Function, old_id: id.InstructionId, repl: value.Value, body: *id.BlockId, body_len: u32, limit: u32) err[fail.Fail] {
    val rmask: res[*bool, A.Error] = A.allocate[bool](m.alloc, limit::usize);
    if (sel rmask.err) { ret err[fail.Fail].err{fail.refused(rmask.err)}; }
    val in_loop: *bool = rmask.ok;
    var bi:      u32   = 0;
    for (bi < body_len) {
        val blk: *ir.Block = ?fn.blocks[body[bi]::u32];
        var pi:  u32       = 0;
        for (pi < blk.phi_count) {
            if (blk.phis[pi]::u32 < limit) { in_loop[blk.phis[pi]::u32] = true; }
            pi = pi + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            if (blk.instructions[ii]::u32 < limit) { in_loop[blk.instructions[ii]::u32] = true; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL && blk.terminator::u32 < limit) { in_loop[blk.terminator::u32] = true; }
        bi = bi + 1;
    }
    var i: u32 = 0;
    for (i < limit) {
        if (!in_loop[i]) {
            val inst: *instruction.Instruction = ?fn.instrs[i];
            var o:    u32                      = 0;
            for (o < inst.operand_count) {
                if (inst.operands[o].kind == value.VAL_INSTR && inst.operands[o].data.instr == old_id) {
                    inst.operands[o] = value.retype(repl, inst.operands[o].ty);
                }
                o = o + 1;
            }
        }
        i = i + 1;
    }
    A.deallocate[bool](m.alloc, in_loop, limit::usize);
    ret err[fail.Fail].ok{};
}

use mach.lang.me.ir.verify;

#[testing]
fun mk_axpy_sig(m: *ir.Module, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, o_sig: *ir_type.IrTypeId) i32 {
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ret 1; }
    var ps: [4]ir_type.IrTypeId;
    ps[0] = i64t;
    ps[1] = ptrt;
    ps[2] = ptrt;
    ps[3] = ptrt;
    val rfn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_fn(?m.types, rv.ok, ?ps[0], 4, false);
    if (sel rfn.err) { ret 1; }
    @o_sig = rfn.ok;
    ret 0;
}

#[testing]
fun build_axpy_variant(m: *ir.Module, bld: *builder.Builder, i64t: ir_type.IrTypeId, ptrt: ir_type.IrTypeId, use_unsigned: bool, o_header: *id.BlockId) i32 {
    val re: res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel re.err) { ret 1; }
    val entry: id.BlockId                 = re.ok;
    val rh:    res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rh.err) { ret 1; }
    val header: id.BlockId                 = rh.ok;
    val rb:     res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rb.err) { ret 1; }
    val body: id.BlockId                 = rb.ok;
    val rx:   res[id.BlockId, fail.Fail] = builder.new_block(bld);
    if (sel rx.err) { ret 1; }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);
    val b: value.Value = value.param(2, ptrt);
    val c: value.Value = value.param(3, ptrt);

    builder.set_block(bld, entry);
    val r_1336: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_1336.err) { ret 1; }

    builder.set_block(bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(bld, i64t);
    if (sel rphi.err) { ret 1; }
    val iv: value.Value = rphi.ok;
    var rc: res[value.Value, fail.Fail];
    if (use_unsigned) { rc = builder.emit_cmp_lt_u(bld, iv, n); }
    or                { rc = builder.emit_cmp_lt_s(bld, iv, n); }
    if (sel rc.err)   { ret 1; }
    val r_1345: err[fail.Fail] = builder.emit_cbr(bld, rc.ok, body, exit);
    if (sel r_1345.err) { ret 1; }

    builder.set_block(bld, body);
    var ixb: [1]value.Value;
    ixb[0] = iv;
    val rgb: res[value.Value, fail.Fail] = builder.emit_gep(bld, b, i64t, ?ixb[0], 1);
    if (sel rgb.err) { ret 1; }
    val rlb: res[value.Value, fail.Fail] = builder.emit_load(bld, rgb.ok, i64t);
    if (sel rlb.err) { ret 1; }
    var ixc: [1]value.Value;
    ixc[0] = iv;
    val rgc: res[value.Value, fail.Fail] = builder.emit_gep(bld, c, i64t, ?ixc[0], 1);
    if (sel rgc.err) { ret 1; }
    val rlc: res[value.Value, fail.Fail] = builder.emit_load(bld, rgc.ok, i64t);
    if (sel rlc.err) { ret 1; }
    val rs: res[value.Value, fail.Fail] = builder.emit_add(bld, rlb.ok, rlc.ok);
    if (sel rs.err) { ret 1; }
    var ixa: [1]value.Value;
    ixa[0] = iv;
    val rga: res[value.Value, fail.Fail] = builder.emit_gep(bld, a, i64t, ?ixa[0], 1);
    if (sel rga.err) { ret 1; }
    val r_1363: err[fail.Fail] = builder.emit_store(bld, rs.ok, rga.ok);
    if (sel r_1363.err) { ret 1; }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(bld, iv, value.const_int(1, i64t));
    if (sel ru.err) { ret 1; }
    val upd:    value.Value    = ru.ok;
    val r_1367: err[fail.Fail] = builder.emit_br(bld, header);
    if (sel r_1367.err) { ret 1; }

    builder.set_block(bld, exit);
    val r_1370: err[fail.Fail] = builder.emit_ret_void(bld);
    if (sel r_1370.err) { ret 1; }

    val r_1372: err[fail.Fail] = builder.phi_add_incoming(bld, iv, entry, value.const_int(0, i64t));
    if (sel r_1372.err) { ret 1; }
    val r_1373: err[fail.Fail] = builder.phi_add_incoming(bld, iv, body, upd);
    if (sel r_1373.err) { ret 1; }

    @o_header = header;
    ret 0;
}

#[testing]
fun cmp_kind_of(fn: *ir.Function, iid: id.InstructionId) instruction.InstrKind {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret instruction.OP_CMP_LT_S; }
    ret opt_.some.kind;
}

#[testing]
fun operand0_is_add(fn: *ir.Function, iid: id.InstructionId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret false; }
    val inst: *instruction.Instruction = opt_.some;
    if (inst.operand_count == 0 || inst.operands[0].kind != value.VAL_INSTR) { ret false; }
    val aopt: opt[*instruction.Instruction] = ir.instruction_get(fn, inst.operands[0].data.instr);
    if (sel aopt.none) { ret false; }
    ret aopt.some.kind == instruction.OP_ADD;
}

# the vector loop's exit compare: an unsigned loop adds the lane count on the
# left, a signed loop subtracts it from the bound on the right
#[testing]
fun find_add_fed_counted_cmp(fn: *ir.Function, out_cmp: *id.InstructionId) bool {
    var i: u32 = 0;
    for (i < fn.instr_len) {
        val iid:  id.InstructionId              = i::id.InstructionId;
        val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
        if (sel opt_.some) {
            val inst: *instruction.Instruction = opt_.some;
            if ((inst.kind == instruction.OP_CMP_LE_S || inst.kind == instruction.OP_CMP_LE_U)
                && (operand0_is_add(fn, iid) || operand1_is_sub(fn, iid))) {
                @out_cmp = iid;
                ret true;
            }
        }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun operand1_is_sub(fn: *ir.Function, iid: id.InstructionId) bool {
    val opt_: opt[*instruction.Instruction] = ir.instruction_get(fn, iid);
    if (sel opt_.none) { ret false; }
    val inst: *instruction.Instruction = opt_.some;
    if (inst.operand_count < 2 || inst.operands[1].kind != value.VAL_INSTR) { ret false; }
    val opt_src: opt[*instruction.Instruction] = ir.instruction_get(fn, inst.operands[1].data.instr);
    if (sel opt_src.none) { ret false; }
    ret opt_src.some.kind == instruction.OP_SUB;
}

#[testing]
fun run_axpy_signedness(use_unsigned: bool, want_kind: instruction.InstrKind) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1417: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1417.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target = rtg.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig:  ir_type.IrTypeId;
    if (mk_axpy_sig(?m, i64t, ptrt, ?sig) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    var header: id.BlockId;
    if (build_axpy_variant(?m, ?bld, i64t, ptrt, use_unsigned, ?header) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val changed_r: res[bool, fail.Fail] = run(?m, ?tgt, false, nil);
    if (sel changed_r.err) {
        ir.dnit(?m);
        ret 1;
    }
    if (!changed_r.ok) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32                                = 0;
    val ral:  res[loops.LoopAnalysis, fail.Fail] = loops.analyze(fn, ?m.types, ?alloc);
    if (sel ral.err) {
        ir.dnit(?m);
        ret 1;
    }
    var la:        loops.LoopAnalysis = ral.ok;
    var found_cmp: id.InstructionId   = id.INSTR_NIL;
    if (!find_add_fed_counted_cmp(fn, ?found_cmp)) { code = 1; }
    or {
        if (cmp_kind_of(fn, found_cmp) != want_kind) { code = 1; }
    }

    val rvr: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(?tgt, true, false));
    if (sel rvr.err) { code = 1; }
    or (sel rvr.ok) {
        var rep: verify.VerifyReport = rvr.ok;
        if (rep.len != 0) { code = 1; }
        verify.dnit_report(?rep);
    }

    loops.dnit(?la);
    ir.dnit(?m);
    ret code;
}

test run__tail_guard_preserves_source_signedness {
    var code: i32 = 0;
    if (run_axpy_signedness(false, instruction.OP_CMP_LE_S) != 0) { code = 1; }
    if (run_axpy_signedness(true, instruction.OP_CMP_LE_U) != 0)  { code = 1; }
    ret code;
}

#[testing]
fun run_reduction_signedness(use_unsigned: bool, want_kind: instruction.InstrKind) i32 {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1482: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1482.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target = rtg.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig:  ir_type.IrTypeId;
    if (mk_axpy_sig(?m, i64t, ptrt, ?sig) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) {
        ir.dnit(?m);
        ret 1;
    }
    val entry: id.BlockId                 = re.ok;
    val rh:    res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) {
        ir.dnit(?m);
        ret 1;
    }
    val header: id.BlockId                 = rh.ok;
    val rb:     res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) {
        ir.dnit(?m);
        ret 1;
    }
    val body: id.BlockId                 = rb.ok;
    val rx:   res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) {
        ir.dnit(?m);
        ret 1;
    }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);

    builder.set_block(?bld, entry);
    val r_1522: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1522.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, header);
    val racc: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel racc.err) {
        ir.dnit(?m);
        ret 1;
    }
    val acc: value.Value                 = racc.ok;
    val riv: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel riv.err) {
        ir.dnit(?m);
        ret 1;
    }
    val iv: value.Value = riv.ok;
    var rc: res[value.Value, fail.Fail];
    if (use_unsigned) { rc = builder.emit_cmp_lt_u(?bld, iv, n); }
    or                { rc = builder.emit_cmp_lt_s(?bld, iv, n); }
    if (sel rc.err) {
        ir.dnit(?m);
        ret 1;
    }
    val cmp_id: id.InstructionId = rc.ok.data.instr;
    val r_1535: err[fail.Fail]   = builder.emit_cbr(?bld, rc.ok, body, exit);
    if (sel r_1535.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, body);
    var ix: [1]value.Value;
    ix[0] = iv;
    val rg: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ix[0], 1);
    if (sel rg.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rg.ok, i64t);
    if (sel rl.err) {
        ir.dnit(?m);
        ret 1;
    }
    val racu: res[value.Value, fail.Fail] = builder.emit_add(?bld, acc, rl.ok);
    if (sel racu.err) {
        ir.dnit(?m);
        ret 1;
    }
    val acc_upd: value.Value                 = racu.ok;
    val ru:      res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val iv_upd: value.Value    = ru.ok;
    val r_1549: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1549.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, exit);
    val r_1552: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1552.err) {
        ir.dnit(?m);
        ret 1;
    }

    val r_1554: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, entry, value.const_int(0, i64t));
    if (sel r_1554.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1555: err[fail.Fail] = builder.phi_add_incoming(?bld, acc, body, acc_upd);
    if (sel r_1555.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1556: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, value.const_int(0, i64t));
    if (sel r_1556.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1557: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, iv_upd);
    if (sel r_1557.err) {
        ir.dnit(?m);
        ret 1;
    }

    val changed_r: res[bool, fail.Fail] = run(?m, ?tgt, false, nil);
    if (sel changed_r.err) {
        ir.dnit(?m);
        ret 1;
    }
    if (!changed_r.ok) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32 = 0;
    if (cmp_kind_of(fn, cmp_id) != want_kind) { code = 1; }

    val rvr: res[verify.VerifyReport, fail.Fail] = verify.verify_module_ext(?m, ?alloc, verify.opts(?tgt, true, false));
    if (sel rvr.err) { code = 1; }
    or (sel rvr.ok) {
        var rep: verify.VerifyReport = rvr.ok;
        if (rep.len != 0) { code = 1; }
        verify.dnit_report(?rep);
    }

    ir.dnit(?m);
    ret code;
}

test run__reduction_tail_guard_preserves_source_signedness {
    var code: i32 = 0;
    if (run_reduction_signedness(false, instruction.OP_CMP_LE_S) != 0) { code = 1; }
    if (run_reduction_signedness(true, instruction.OP_CMP_LE_U) != 0)  { code = 1; }
    ret code;
}

test run__a_decline_leaves_the_function_untouched {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1590: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1590.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target = rtg.ok;

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m:  ir.Module                        = rm.ok;
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt.ok;
    val rp:   res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId = rp.ok;
    var sig:  ir_type.IrTypeId;
    if (mk_axpy_sig(?m, i64t, ptrt, ?sig) != 0) {
        ir.dnit(?m);
        ret 1;
    }

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, sig, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val re: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel re.err) {
        ir.dnit(?m);
        ret 1;
    }
    val entry: id.BlockId                 = re.ok;
    val rh:    res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rh.err) {
        ir.dnit(?m);
        ret 1;
    }
    val header: id.BlockId                 = rh.ok;
    val rb:     res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rb.err) {
        ir.dnit(?m);
        ret 1;
    }
    val body: id.BlockId                 = rb.ok;
    val rx:   res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rx.err) {
        ir.dnit(?m);
        ret 1;
    }
    val exit: id.BlockId = rx.ok;

    val n: value.Value = value.param(0, i64t);
    val a: value.Value = value.param(1, ptrt);

    builder.set_block(?bld, entry);
    val r_1630: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1630.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rphi.err) {
        ir.dnit(?m);
        ret 1;
    }
    val iv: value.Value                 = rphi.ok;
    val rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, iv, n);
    if (sel rc.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1637: err[fail.Fail] = builder.emit_cbr(?bld, rc.ok, body, exit);
    if (sel r_1637.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, body);
    val rim1: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(0xFFFFFFFFFFFFFFFF, i64t));
    if (sel rim1.err) {
        ir.dnit(?m);
        ret 1;
    }
    var ixs: [1]value.Value;
    ixs[0] = rim1.ok;
    val rgs: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixs[0], 1);
    if (sel rgs.err) {
        ir.dnit(?m);
        ret 1;
    }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bld, rgs.ok, i64t);
    if (sel rl.err) {
        ir.dnit(?m);
        ret 1;
    }
    var ixd: [1]value.Value;
    ixd[0] = iv;
    val rgd: res[value.Value, fail.Fail] = builder.emit_gep(?bld, a, i64t, ?ixd[0], 1);
    if (sel rgd.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1649: err[fail.Fail] = builder.emit_store(?bld, rl.ok, rgd.ok);
    if (sel r_1649.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ru: res[value.Value, fail.Fail] = builder.emit_add(?bld, iv, value.const_int(1, i64t));
    if (sel ru.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1652: err[fail.Fail] = builder.emit_br(?bld, header);
    if (sel r_1652.err) {
        ir.dnit(?m);
        ret 1;
    }
    builder.set_block(?bld, exit);
    val r_1654: err[fail.Fail] = builder.emit_ret_void(?bld);
    if (sel r_1654.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1655: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, entry, value.const_int(0, i64t));
    if (sel r_1655.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1656: err[fail.Fail] = builder.phi_add_incoming(?bld, iv, body, ru.ok);
    if (sel r_1656.err) {
        ir.dnit(?m);
        ret 1;
    }

    val blocks_before: u32 = fn.block_count;
    val instrs_before: u32 = fn.instr_len;

    var code: i32                  = 0;
    val rr:   res[bool, fail.Fail] = run(?m, ?tgt, false, nil);
    if (sel rr.err) { code = 1; }
    or (sel rr.ok) {
        if (rr.ok)                           { code = 1; }
        if (fn.block_count != blocks_before) { code = 1; }
        if (fn.instr_len != instrs_before)   { code = 1; }
    }

    ir.dnit(?m);
    ret code;
}

test empty_forwarder__treats_a_debug_only_block_as_empty {
    var alloc: A.Allocator;
    page.make(?alloc);
    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel rt.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32t: ir_type.IrTypeId    = rt.ok;
    val rf:   res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rto:   res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rdbg:  res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    val rreal: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rto.err) {
        ir.dnit(?m);
        ret 1;
    }
    if (sel rdbg.err) {
        ir.dnit(?m);
        ret 1;
    }
    if (sel rreal.err) {
        ir.dnit(?m);
        ret 1;
    }
    val to:       id.BlockId = rto.ok;
    val dbg_arm:  id.BlockId = rdbg.ok;
    val real_arm: id.BlockId = rreal.ok;

    builder.set_block(?bld, dbg_arm);
    val r_1701: err[fail.Fail] = builder.emit_dbg_value(?bld, value.const_int(7, i32t), intern.STR_NIL, i32t, semtype.TYPE_NIL, false, 0);
    if (sel r_1701.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1702: err[fail.Fail] = builder.emit_br(?bld, to);
    if (sel r_1702.err) {
        ir.dnit(?m);
        ret 1;
    }

    builder.set_block(?bld, real_arm);
    val ra: res[value.Value, fail.Fail] = builder.emit_add(?bld, value.const_int(1, i32t), value.const_int(2, i32t));
    if (sel ra.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1707: err[fail.Fail] = builder.emit_br(?bld, to);
    if (sel r_1707.err) {
        ir.dnit(?m);
        ret 1;
    }

    var code: i32 = 0;
    if (!empty_forwarder(fn, dbg_arm, to)) { code = 1; }
    if (empty_forwarder(fn, real_arm, to)) { code = 2; }
    ir.dnit(?m);
    ret code;
}

test run__declines_a_predicated_mixed_join {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val r_1721: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel r_1721.err) { ret 1; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 1; }
    var tgt: target.Target             = rtg.ok;
    val rm:  res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rt32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel rt32.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i32t: ir_type.IrTypeId                 = rt32.ok;
    val rt64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val i64t: ir_type.IrTypeId                 = rt64.ok;
    val rtp:  res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rtp.err) {
        ir.dnit(?m);
        ret 1;
    }
    val ptrt: ir_type.IrTypeId = rtp.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) {
        ir.dnit(?m);
        ret 1;
    }
    val fn:  *ir.Function    = ?m.functions[rf.ok];
    var bld: builder.Builder = builder.init(?m);
    builder.set_function(?bld, fn);

    val rta: res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rta.err) {
        ir.dnit(?m);
        ret 1;
    }
    val t_arm: id.BlockId                 = rta.ok;
    val rfa:   res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rfa.err) {
        ir.dnit(?m);
        ret 1;
    }
    val f_arm: id.BlockId                 = rfa.ok;
    val reb:   res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel reb.err) {
        ir.dnit(?m);
        ret 1;
    }
    val entry: id.BlockId                 = reb.ok;
    val rlb:   res[id.BlockId, fail.Fail] = builder.new_block(?bld);
    if (sel rlb.err) {
        ir.dnit(?m);
        ret 1;
    }
    val latch: id.BlockId = rlb.ok;

    val base: value.Value = value.const_null(ptrt);
    builder.set_block(?bld, entry);
    val rload: res[value.Value, fail.Fail] = builder.emit_load(?bld, base, i32t);
    if (sel rload.err) {
        ir.dnit(?m);
        ret 1;
    }
    val load:  value.Value                 = rload.ok;
    val rmask: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?bld, load, value.const_int(10, i32t));
    if (sel rmask.err) {
        ir.dnit(?m);
        ret 1;
    }
    val mask: value.Value = rmask.ok;

    builder.set_block(?bld, latch);
    val rp32: res[value.Value, fail.Fail] = builder.emit_phi(?bld, i32t);
    if (sel rp32.err) {
        ir.dnit(?m);
        ret 1;
    }
    val phi32: value.Value                 = rp32.ok;
    val rp64:  res[value.Value, fail.Fail] = builder.emit_phi(?bld, i64t);
    if (sel rp64.err) {
        ir.dnit(?m);
        ret 1;
    }
    val phi64: value.Value = rp64.ok;

    val r_1775: err[fail.Fail] = builder.phi_add_incoming(?bld, phi32, t_arm, value.const_int(1, i32t));
    if (sel r_1775.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1776: err[fail.Fail] = builder.phi_add_incoming(?bld, phi32, f_arm, value.const_int(2, i32t));
    if (sel r_1776.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1777: err[fail.Fail] = builder.phi_add_incoming(?bld, phi64, t_arm, value.const_int(1, i64t));
    if (sel r_1777.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1778: err[fail.Fail] = builder.phi_add_incoming(?bld, phi64, f_arm, value.const_int(2, i64t));
    if (sel r_1778.err) {
        ir.dnit(?m);
        ret 1;
    }
    val r_1779: err[fail.Fail] = builder.emit_store(?bld, phi32, base);
    if (sel r_1779.err) {
        ir.dnit(?m);
        ret 1;
    }
    val store_id: id.InstructionId = (fn.instr_len - 1)::id.InstructionId;

    var body: [2]id.BlockId;
    body[0] = entry;
    body[1] = latch;
    var loop_list: [1]loops.Loop;
    loop_list[0].header   = t_arm;
    loop_list[0].latch    = latch;
    loop_list[0].body     = ?body[0];
    loop_list[0].body_len = 2;
    var la: loops.LoopAnalysis;
    la.block_count = fn.block_count;
    la.instr_count = fn.instr_len;
    la.loops       = ?loop_list[0];
    la.loop_len    = 1;

    val rac: res[*dep.MemAccess, A.Error] = A.allocate[dep.MemAccess](?alloc, 2);
    if (sel rac.err) {
        ir.dnit(?m);
        ret 1;
    }
    val accesses: *dep.MemAccess = rac.ok;
    accesses[0].instr     = load.data.instr;
    accesses[0].gep       = id.INSTR_NIL;
    accesses[0].base      = base;
    accesses[0].off       = value.const_int(0, i64t);
    accesses[0].stride_ty = i32t;
    accesses[0].elem_ty   = i32t;
    accesses[0].bytes     = 4;
    accesses[0].is_store  = false;
    accesses[1].instr     = store_id;
    accesses[1].gep       = id.INSTR_NIL;
    accesses[1].base      = base;
    accesses[1].off       = value.const_int(0, i64t);
    accesses[1].stride_ty = i32t;
    accesses[1].elem_ty   = i32t;
    accesses[1].bytes     = 4;
    accesses[1].is_store  = true;

    var d: dep.DepInfo;
    d.alloc        = ?alloc;
    d.verdict      = dep.DEP_INDEPENDENT;
    d.accesses     = accesses;
    d.access_count = 2;
    d.access_cap   = 2;
    var shape: MapShape;
    shape.elem_ty  = i32t;
    shape.bytes    = 4;
    shape.lanes    = 4;
    shape.is_float = false;

    var code: i32                 = 0;
    val rset: res[*bool, A.Error] = A.allocate[bool](?alloc, fn.instr_len::usize);
    if (sel rset.err) {
        dep.dep_dnit(?d);
        ir.dnit(?m);
        ret 1;
    }
    val vset: *bool = rset.ok;
    build_vset(?m, ?tgt, fn, ?la, 0, d.accesses, d.access_count, shape.elem_ty, shape.elem_ty, shape.is_float, true, true, mask.data.instr, vset);
    if (!vset[load.data.instr::u32])  { code = 2; }
    if (!vset[mask.data.instr::u32])  { code = 3; }
    if (!vset[phi32.data.instr::u32]) { code = 4; }
    if (vset[phi64.data.instr::u32])  { code = 5; }
    val store: *instruction.Instruction = ?fn.instrs[store_id::u32];
    if (store.operand_count == 0 || store.operands[0].kind != value.VAL_INSTR
        || !vset[store.operands[0].data.instr::u32]) { code = 6; }
    A.deallocate[bool](?alloc, vset, fn.instr_len::usize);
    if (code == 0) {
        val rr: res[bool, fail.Fail] = stores_are_pure_trees(?m, ?tgt, fn, ?la, 0, ?d, ?shape, true, mask.data.instr);
        if (sel rr.err)         { code = 1; }
        or (sel rr.ok && rr.ok) { code = 1; }
    }
    dep.dep_dnit(?d);
    ir.dnit(?m);
    ret code;
}

# the fail-at-N fixture: the signed axpy loop, which versions, if-converts
# nothing, splats its invariant and vectorizes
#[testing]
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel rt.err) { ret 1; }
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ret 2; }
    var sig: ir_type.IrTypeId;
    if (mk_axpy_sig(m, rt.ok, rp.ok, ?sig) != 0) { ret 3; }
    val rf: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, sig, 0);
    if (sel rf.err) { ret 4; }
    var bld: builder.Builder = builder.init(m);
    builder.set_function(?bld, ?m.functions[rf.ok]);
    var header: id.BlockId;
    if (build_axpy_variant(m, ?bld, rt.ok, rp.ok, false, ?header) != 0) { ret 5; }
    ret 0;
}

#[testing]
fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val r: res[bool, fail.Fail] = run(m, a.target, false, nil);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the loop and dependence analyses precede any mutation; versioning clones
# the loop region and emits the guards from the module as it goes, so a
# refusal there leaves an unreachable partial clone beside the original loop
# or a partly retyped fast path; the module stays releasable, and the
# original scalar loop is never removed
#[testing]
fun probe_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    val fn: *ir.Function = ?m.functions[0];
    ret fn.block_count >= a.control.functions[0].block_count && fn.instr_len >= a.control.functions[0].instr_len;
}

test run__refusal_at_every_ordinal_leaves_the_input_or_a_partial_version {
    var owner: A.Allocator;
    val made:  err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var reg: target.TargetRegistry = target.registry_init();
    fin { target.registry_dnit(?reg); }
    val registered: err[fail.Fail] = target.register_all(?reg, target_testing.debug_descriptor);
    if (sel registered.err) { ret 2; }
    val rtg: res[target.Target, fail.Fail] = target.select_of(?reg, "x86_64", "linux", "sysv64", "");
    if (sel rtg.err) { ret 3; }
    var tgt: target.Target      = rtg.ok;
    var a:   me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: ?tgt, control: nil, context: nil};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 4; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}
