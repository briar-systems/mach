use std.types.canonical.res;
use std.types.canonical.opt;
use std.types.canonical.err;
use mach.lang.fail;
use std.allocator.page;
use std.collections.map;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;

use mach.lang.intern;
use mach.lang.me.ir;
use mach.lang.me.scratch;
use me_testing: mach.lang.me.testing;
use mach.lang.me.ir.equal;
use mach.lang.me.ir.builder;
use mach.lang.me.ir.effect;
use mach.lang.me.ir.id;
use mach.lang.me.ir.instruction;
use mach.lang.me.ir.opdesc;
use mach.lang.me.ir.refs;
use mach.lang.me.ir.mutate;
use ir_type: mach.lang.me.ir.type;
use mach.lang.me.ir.value;
use mach.lang.me.pass.dce;
use mach.lang.me.pass.mem2reg;
use mach.lang.source;
use mach.lang.target;
use target_testing: mach.lang.target.testing;
use mach.lang.target.isa;
use mach.lang.target.resolved;

val NONE_U32: u32 = 0xFFFFFFFF;

val MAX_FIELDS: u32 = 8;

val MAX_BYTES: u32 = 64;

val MAX_DEPTH: u32 = 4;

val MAX_ROUNDS: u32 = MAX_DEPTH + 1;

rec State {
    alloc: *A.Allocator;
    m:     *ir.Module;
    fn:    *ir.Function;
    tgt:   *target.Target;

    pool_len:    u32;
    instr_block: *id.BlockId;
    cand_of:     *u32;
    gep_of:      *u32;
    gep_field:   *u32;
    uni_gep:     *bool;
    erase:       *bool;

    cand_id:     *id.InstructionId;
    cand_ty:     *ir_type.IrTypeId;
    cand_phi:    *bool;
    cand_nf:     *u32;
    cand_root:   *u32;
    cand_out:    *bool;
    # one flag per candidate and field: a field's slot is secret when a typed access to that field is, or when the
    # candidate's home itself is. an aggregate-level secret operation (a store, copy or zeroing of the whole object)
    # says only that some byte of the object is secret and taints no field by itself; the typed field accesses say which
    field_secret: *bool;
    cand_home:   *id.BlockId;
    cand_local:  *bool;
    cand_slot:   *u32;
    cand_count:  u32;
    cand_cap:    u32;

    block_count: u32;
    visit:       *bool;
    queue:       *id.BlockId;

    slots:      *value.Value;
    slot_total: u32;

    ptr_ty:  ir_type.IrTypeId;
    void_ty: ir_type.IrTypeId;
    i64_ty:  ir_type.IrTypeId;
    int_ty:  [4]ir_type.IrTypeId;
}

rec FunctionWork {
    module: *ir.Module;
    body: *ir.Function;
    target: *target.Target;
}

# a run that owns its workspace; the pipeline runs `run_in` over one
pub fun run(m: *ir.Module, tgt: *target.Target) res[bool, fail.Fail] {
    var workspace: scratch.Workspace;
    val initialized: err[fail.Fail] = scratch.init(?workspace);
    if (sel initialized.err) { ret res[bool, fail.Fail].err{initialized.err}; }
    fin { scratch.dnit(?workspace); }
    ret run_in(m, tgt, ?workspace);
}

pub fun run_in(m: *ir.Module, tgt: *target.Target, workspace: *scratch.Workspace) res[bool, fail.Fail] {
    var changed: bool = false;
    var f: u32 = 0;
    for (f < m.function_len) {
        val fn: *ir.Function = ?m.functions[f];
        if ((fn.flags & ir.FN_FLAG_EXTERN) == 0 && fn.block_count > 0
            && !effect.function_has_volatile(fn)) {
            var round: u32 = 0;
            var more: bool = true;
            for (more && round < MAX_ROUNDS) {
                var work: FunctionWork = FunctionWork{module: m, body: fn, target: tgt};
                val changed_r: res[bool, fail.Fail] = scratch.run[FunctionWork, bool](workspace, m.alloc, ?work, split_function);
                if (sel changed_r.err) { ret changed_r; }
                more = changed_r.ok;
                if (more) { changed = true; }
                round = round + 1;
            }
        }
        f = f + 1;
    }
    ret res[bool, fail.Fail].ok{changed};
}

fun split_function(work: *FunctionWork, alloc: *A.Allocator) res[bool, fail.Fail] {
    val m: *ir.Module = work.module;
    val fn: *ir.Function = work.body;
    val tgt: *target.Target = work.target;
    var st: State;
    state_init(?st, m, fn, tgt, alloc);

    val res_maps: err[fail.Fail] = state_alloc(?st);
    if (sel res_maps.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_maps.err}; }
    if (st.pool_len == 0) { state_dnit(?st); ret res[bool, fail.Fail].ok{false}; }

    val res_ints: err[fail.Fail] = intern_int_widths(?st);
    if (sel res_ints.err) { state_dnit(?st); ret res[bool, fail.Fail].err{res_ints.err}; }

    map_instr_blocks(?st);
    collect_candidates(?st);
    if (st.cand_count == 0) { state_dnit(?st); ret res[bool, fail.Fail].ok{false}; }

    link_phi_partitions(?st);
    classify_references(?st);
    mark_union_member_geps(?st);
    classify_gep_uses(?st);
    check_partitions(?st);
    propagate_escapes(?st);

    val survivors: u32 = assign_slots(?st);
    if (survivors == 0) { state_dnit(?st); ret res[bool, fail.Fail].ok{false}; }

    val res_rw: err[fail.Fail] = rewrite(?st);
    state_dnit(?st);
    if (sel res_rw.err) { ret res[bool, fail.Fail].err{res_rw.err}; }
    ret res[bool, fail.Fail].ok{true};
}

fun state_init(st: *State, m: *ir.Module, fn: *ir.Function, tgt: *target.Target, alloc: *A.Allocator) {
    st.alloc = alloc;
    st.m     = m;
    st.fn    = fn;
    st.tgt   = tgt;

    st.pool_len    = fn.instr_len;
    st.instr_block = nil;
    st.cand_of     = nil;
    st.gep_of      = nil;
    st.gep_field   = nil;
    st.erase       = nil;

    st.cand_id     = nil;
    st.cand_ty     = nil;
    st.cand_phi    = nil;
    st.cand_nf     = nil;
    st.cand_root   = nil;
    st.cand_out    = nil;
    st.field_secret = nil;
    st.cand_home   = nil;
    st.cand_local  = nil;
    st.cand_slot   = nil;
    st.cand_count  = 0;
    st.cand_cap    = 0;

    st.block_count = fn.block_count;
    st.visit       = nil;
    st.queue       = nil;

    st.slots      = nil;
    st.slot_total = 0;

    st.ptr_ty  = ir_type.IRT_NIL;
    st.void_ty = ir_type.IRT_NIL;
    st.i64_ty  = ir_type.IRT_NIL;
    var w: u32 = 0;
    for (w < 4) { st.int_ty[w] = ir_type.IRT_NIL; w = w + 1; }
}

fun intern_int_widths(st: *State) err[fail.Fail] {
    var w: u32 = 0;
    for (w < 4) {
        val r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?st.m.types, 8 << w);
        if (sel r.err) { ret err[fail.Fail].err{r.err}; }
        st.int_ty[w] = r.ok;
        w = w + 1;
    }
    ret err[fail.Fail].ok{};
}

fun int_of_bytes(st: *State, bytes: u32) ir_type.IrTypeId {
    if (bytes == 1) { ret st.int_ty[0]; }
    if (bytes == 2) { ret st.int_ty[1]; }
    if (bytes == 4) { ret st.int_ty[2]; }
    if (bytes == 8) { ret st.int_ty[3]; }
    ret ir_type.IRT_NIL;
}

fun state_alloc(st: *State) err[fail.Fail] {
    val n: u32 = st.pool_len;
    if (n == 0) { ret err[fail.Fail].ok{}; }

    val r_ib: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, n::usize);
    if (sel r_ib.err) { ret err[fail.Fail].err{fail.refused(r_ib.err)}; }
    st.instr_block = r_ib.ok;

    val r_co: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel r_co.err) { ret err[fail.Fail].err{fail.refused(r_co.err)}; }
    st.cand_of = r_co.ok;

    val r_go: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel r_go.err) { ret err[fail.Fail].err{fail.refused(r_go.err)}; }
    st.gep_of = r_go.ok;

    val r_gf: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel r_gf.err) { ret err[fail.Fail].err{fail.refused(r_gf.err)}; }
    st.gep_field = r_gf.ok;

    val r_ug: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel r_ug.err) { ret err[fail.Fail].err{fail.refused(r_ug.err)}; }
    st.uni_gep = r_ug.ok;

    val r_er: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel r_er.err) { ret err[fail.Fail].err{fail.refused(r_er.err)}; }
    st.erase = r_er.ok;

    var i: u32 = 0;
    for (i < n) {
        st.instr_block[i] = id.BLOCK_NIL;
        st.cand_of[i]     = NONE_U32;
        st.gep_of[i]      = NONE_U32;
        st.gep_field[i]   = 0;
        st.uni_gep[i]     = false;
        st.erase[i]       = false;
        i = i + 1;
    }

    val r_ci: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](st.alloc, n::usize);
    if (sel r_ci.err) { ret err[fail.Fail].err{fail.refused(r_ci.err)}; }
    st.cand_id = r_ci.ok;
    # the capacity is recorded with the first candidate array, so a refusal of
    # a later one releases the earlier ones at their true extent
    st.cand_cap = n;

    val r_ct: res[*ir_type.IrTypeId, A.Error] = A.allocate[ir_type.IrTypeId](st.alloc, n::usize);
    if (sel r_ct.err) { ret err[fail.Fail].err{fail.refused(r_ct.err)}; }
    st.cand_ty = r_ct.ok;

    val r_cp: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel r_cp.err) { ret err[fail.Fail].err{fail.refused(r_cp.err)}; }
    st.cand_phi = r_cp.ok;

    val r_cn: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel r_cn.err) { ret err[fail.Fail].err{fail.refused(r_cn.err)}; }
    st.cand_nf = r_cn.ok;

    val r_cr: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel r_cr.err) { ret err[fail.Fail].err{fail.refused(r_cr.err)}; }
    st.cand_root = r_cr.ok;

    val r_cx: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel r_cx.err) { ret err[fail.Fail].err{fail.refused(r_cx.err)}; }
    st.cand_out = r_cx.ok;

    val r_cs: res[*bool, A.Error] = A.allocate[bool](st.alloc, (n * MAX_FIELDS)::usize);
    if (sel r_cs.err) { ret err[fail.Fail].err{fail.refused(r_cs.err)}; }
    st.field_secret = r_cs.ok;
    var fs: u32 = 0;
    for (fs < n * MAX_FIELDS) { st.field_secret[fs] = false; fs = fs + 1; }

    val r_ch: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, n::usize);
    if (sel r_ch.err) { ret err[fail.Fail].err{fail.refused(r_ch.err)}; }
    st.cand_home = r_ch.ok;

    val r_ck: res[*bool, A.Error] = A.allocate[bool](st.alloc, n::usize);
    if (sel r_ck.err) { ret err[fail.Fail].err{fail.refused(r_ck.err)}; }
    st.cand_local = r_ck.ok;

    val r_cl: res[*u32, A.Error] = A.allocate[u32](st.alloc, n::usize);
    if (sel r_cl.err) { ret err[fail.Fail].err{fail.refused(r_cl.err)}; }
    st.cand_slot = r_cl.ok;

    val bn: u32 = st.block_count;
    val r_vi: res[*bool, A.Error] = A.allocate[bool](st.alloc, bn::usize);
    if (sel r_vi.err) { ret err[fail.Fail].err{fail.refused(r_vi.err)}; }
    st.visit = r_vi.ok;

    val r_qu: res[*id.BlockId, A.Error] = A.allocate[id.BlockId](st.alloc, bn::usize);
    if (sel r_qu.err) { ret err[fail.Fail].err{fail.refused(r_qu.err)}; }
    st.queue = r_qu.ok;

    ret err[fail.Fail].ok{};
}

fun state_dnit(st: *State) {
    val n: u32 = st.pool_len;
    if (st.instr_block != nil) { A.deallocate[id.BlockId](st.alloc, st.instr_block, n::usize); }
    if (st.cand_of != nil)     { A.deallocate[u32](st.alloc, st.cand_of, n::usize); }
    if (st.gep_of != nil)      { A.deallocate[u32](st.alloc, st.gep_of, n::usize); }
    if (st.gep_field != nil)   { A.deallocate[u32](st.alloc, st.gep_field, n::usize); }
    if (st.uni_gep != nil)     { A.deallocate[bool](st.alloc, st.uni_gep, n::usize); }
    if (st.erase != nil)       { A.deallocate[bool](st.alloc, st.erase, n::usize); }

    val c: u32 = st.cand_cap;
    if (st.cand_id != nil)     { A.deallocate[id.InstructionId](st.alloc, st.cand_id, c::usize); }
    if (st.cand_ty != nil)     { A.deallocate[ir_type.IrTypeId](st.alloc, st.cand_ty, c::usize); }
    if (st.cand_phi != nil)    { A.deallocate[bool](st.alloc, st.cand_phi, c::usize); }
    if (st.cand_nf != nil)     { A.deallocate[u32](st.alloc, st.cand_nf, c::usize); }
    if (st.cand_root != nil)   { A.deallocate[u32](st.alloc, st.cand_root, c::usize); }
    if (st.cand_out != nil)    { A.deallocate[bool](st.alloc, st.cand_out, c::usize); }
    if (st.field_secret != nil) { A.deallocate[bool](st.alloc, st.field_secret, (c * MAX_FIELDS)::usize); }
    if (st.cand_home != nil)   { A.deallocate[id.BlockId](st.alloc, st.cand_home, c::usize); }
    if (st.cand_local != nil)  { A.deallocate[bool](st.alloc, st.cand_local, c::usize); }
    if (st.cand_slot != nil)   { A.deallocate[u32](st.alloc, st.cand_slot, c::usize); }

    val bn: u32 = st.block_count;
    if (st.visit != nil) { A.deallocate[bool](st.alloc, st.visit, bn::usize); }
    if (st.queue != nil) { A.deallocate[id.BlockId](st.alloc, st.queue, bn::usize); }

    if (st.slots != nil) { A.deallocate[value.Value](st.alloc, st.slots, st.slot_total::usize); }
}

fun map_instr_blocks(st: *State) {
    val fn: *ir.Function = st.fn;
    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[b];
        var pi: u32 = 0;
        for (pi < blk.phi_count) {
            val pid: id.InstructionId = blk.phis[pi];
            if (pid::u32 < st.pool_len) { st.instr_block[pid::u32] = b::id.BlockId; }
            pi = pi + 1;
        }
        var ii: u32 = 0;
        for (ii < blk.instr_count) {
            val iid: id.InstructionId = blk.instructions[ii];
            if (iid::u32 < st.pool_len) { st.instr_block[iid::u32] = b::id.BlockId; }
            ii = ii + 1;
        }
        if (blk.terminator != id.INSTR_NIL && blk.terminator::u32 < st.pool_len) {
            st.instr_block[blk.terminator::u32] = b::id.BlockId;
        }
        b = b + 1;
    }
}

fun agg_field_count(st: *State, ty: ir_type.IrTypeId) u32 {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?st.m.types, ty);
    if (sel opt_.none) { ret 0; }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind == ir_type.IRT_STRUCT) { ret t.data.struct_.field_count; }
    if (t.kind == ir_type.IRT_ARRAY)  { ret t.data.array_.count; }
    ret 0;
}

fun agg_field_type(st: *State, ty: ir_type.IrTypeId, k: u32) ir_type.IrTypeId {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?st.m.types, ty);
    if (sel opt_.none) { ret ir_type.IRT_NIL; }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind == ir_type.IRT_STRUCT) {
        if (k >= t.data.struct_.field_count) { ret ir_type.IRT_NIL; }
        ret t.data.struct_.fields[k];
    }
    if (t.kind == ir_type.IRT_ARRAY) {
        if (k >= t.data.array_.count) { ret ir_type.IRT_NIL; }
        ret t.data.array_.element;
    }
    ret ir_type.IRT_NIL;
}

fun splittable_ty(st: *State, ty: ir_type.IrTypeId) bool {
    ret splittable_at(st, ty, 0);
}

fun splittable_at(st: *State, ty: ir_type.IrTypeId, depth: u32) bool {
    if (depth >= MAX_DEPTH)                                      { ret false; }
    val nf: u32 = agg_field_count(st, ty);
    if (nf == 0 || nf > MAX_FIELDS)                              { ret false; }
    if (ir_type.byte_size_for_machine(?st.m.types, ty, resolved.layout_machine(st.tgt)) > MAX_BYTES)  { ret false; }
    var k: u32 = 0;
    for (k < nf) {
        val ft: ir_type.IrTypeId = agg_field_type(st, ty, k);
        if (!scalar_field(st, ft) && union_leaf_ty(st, ft) == ir_type.IRT_NIL
            && !splittable_at(st, ft, depth + 1)) { ret false; }
        k = k + 1;
    }
    ret true;
}

fun union_leaf_ty(st: *State, ty: ir_type.IrTypeId) ir_type.IrTypeId {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?st.m.types, ty);
    if (sel opt_.none) { ret ir_type.IRT_NIL; }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind != ir_type.IRT_UNION) { ret ir_type.IRT_NIL; }

    val size: u32 = ir_type.byte_size_for_machine(?st.m.types, ty, resolved.layout_machine(st.tgt));
    var pick: ir_type.IrTypeId = ir_type.IRT_NIL;
    var rank: u32 = 3;
    var narrow: bool = false;
    var k: u32 = 0;
    for (k < t.data.struct_.field_count) {
        val mt: ir_type.IrTypeId = t.data.struct_.fields[k];
        if (!scalar_field(st, mt)) { ret ir_type.IRT_NIL; }
        if (ir_type.byte_size_for_machine(?st.m.types, mt, resolved.layout_machine(st.tgt)) < size) { narrow = true; }
        or {
            if (storage_rank(st, mt) < rank) { pick = mt; rank = storage_rank(st, mt); }
        }
        k = k + 1;
    }
    if (!narrow) { ret pick; }
    if (st.tgt.model.endianness != isa.ENDIAN_LITTLE) { ret ir_type.IRT_NIL; }
    ret int_of_bytes(st, size);
}

fun storage_rank(st: *State, ft: ir_type.IrTypeId) u32 {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?st.m.types, ft);
    if (sel opt_.none) { ret 2; }
    val k: ir_type.IrTypeKind = opt_.some.kind;
    if (k == ir_type.IRT_INT) { ret 0; }
    if (k == ir_type.IRT_PTR) { ret 1; }
    ret 2;
}

fun union_member_count(st: *State, ty: ir_type.IrTypeId) u32 {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?st.m.types, ty);
    if (sel opt_.none) { ret 0; }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind != ir_type.IRT_UNION) { ret 0; }
    ret t.data.struct_.field_count;
}

fun slot_ty(st: *State, ty: ir_type.IrTypeId, k: u32) ir_type.IrTypeId {
    val ft: ir_type.IrTypeId = agg_field_type(st, ty, k);
    val ut: ir_type.IrTypeId = union_leaf_ty(st, ft);
    if (ut != ir_type.IRT_NIL) { ret ut; }
    ret ft;
}

fun scalar_field(st: *State, ft: ir_type.IrTypeId) bool {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?st.m.types, ft);
    if (sel opt_.none) { ret false; }
    val k: ir_type.IrTypeKind = opt_.some.kind;
    ret k == ir_type.IRT_INT || k == ir_type.IRT_FLOAT || k == ir_type.IRT_PTR;
}

fun collect_candidates(st: *State) {
    val fn: *ir.Function = st.fn;
    var i: u32 = 0;
    for (i < st.pool_len) {
        if (st.instr_block[i] == id.BLOCK_NIL) { i = i + 1; cnt; }
        val inst: *instruction.Instruction = ?fn.instrs[i];

        var ty: ir_type.IrTypeId = ir_type.IRT_NIL;
        var is_phi: bool = false;
        if (inst.kind == instruction.OP_ALLOCA) {
            if (inst.operand_count >= 1 && inst.operands[0].kind == value.VAL_CONST_INT
                && inst.operands[0].data.int_lit == 1) {
                ty = inst.aux_ty;
            }
        } or (inst.kind == instruction.OP_PHI) {
            ty     = inst.ty;
            is_phi = true;
        }

        if (ty != ir_type.IRT_NIL && splittable_ty(st, ty)) {
            val c: u32 = st.cand_count;
            st.cand_of[i]     = c;
            st.cand_id[c]     = i::id.InstructionId;
            st.cand_ty[c]     = ty;
            st.cand_phi[c]    = is_phi;
            st.cand_nf[c]     = agg_field_count(st, ty);
            st.cand_root[c]   = c;
            st.cand_out[c]    = false;
            taint_all(st, c, inst.secret);
            st.cand_home[c]   = st.instr_block[i];
            st.cand_local[c]  = true;
            st.cand_slot[c]   = NONE_U32;
            st.cand_count     = c + 1;
        }
        i = i + 1;
    }
}

fun find_root(st: *State, c: u32) u32 {
    var x: u32 = c;
    for (st.cand_root[x] != x) {
        st.cand_root[x] = st.cand_root[st.cand_root[x]];
        x = st.cand_root[x];
    }
    ret x;
}

fun union_roots(st: *State, a: u32, b: u32) {
    val ra: u32 = find_root(st, a);
    val rb: u32 = find_root(st, b);
    if (ra != rb) { st.cand_root[rb] = ra; }
}

fun link_phi_partitions(st: *State) {
    val fn: *ir.Function = st.fn;
    var c: u32 = 0;
    for (c < st.cand_count) {
        if (st.cand_phi[c] == false) { c = c + 1; cnt; }
        val phi: *instruction.Instruction = ?fn.instrs[st.cand_id[c]::u32];
        if (phi.operand_count == 0) { st.cand_out[c] = true; c = c + 1; cnt; }

        var o: u32 = 1;
        for (o < phi.operand_count) {
            val v: value.Value = phi.operands[o];
            var ok: bool = false;
            if (v.kind == value.VAL_INSTR && v.data.instr::u32 < st.pool_len) {
                val ic: u32 = st.cand_of[v.data.instr::u32];
                if (ic != NONE_U32 && st.cand_phi[ic] == false && st.cand_ty[ic] == st.cand_ty[c]) {
                    union_roots(st, c, ic);
                    ok = true;
                }
            }
            if (!ok) { st.cand_out[c] = true; }
            o = o + 2;
        }
        c = c + 1;
    }
}

fun is_address_value(v: value.Value) bool {
    ret v.kind == value.VAL_INSTR || v.kind == value.VAL_PARAM || v.kind == value.VAL_GLOBAL;
}

fun taint_field(st: *State, c: u32, k: u32, s: bool) {
    if (s && k < MAX_FIELDS) { st.field_secret[c * MAX_FIELDS + k] = true; }
}

# a secret home (a secret alloca, or its address used as a secret value) is secret in every field
fun taint_all(st: *State, c: u32, s: bool) {
    if (!s) { ret; }
    var k: u32 = 0;
    for (k < MAX_FIELDS) { st.field_secret[c * MAX_FIELDS + k] = true; k = k + 1; }
}

fun note_home(st: *State, c: u32, b: id.BlockId) {
    if (b == id.BLOCK_NIL) { ret; }
    if (st.cand_home[c] == id.BLOCK_NIL) { st.cand_home[c] = b; ret; }
    if (st.cand_home[c] != b)            { st.cand_local[c] = false; }
}

fun classify_references(st: *State) {
    val fn: *ir.Function = st.fn;
    var i: u32 = 0;
    for (i < st.pool_len) {
        if (st.instr_block[i] == id.BLOCK_NIL) { i = i + 1; cnt; }
        val inst: *instruction.Instruction = ?fn.instrs[i];

        if (inst.kind == instruction.OP_ASM) { mark_asm_binds(st, i::id.InstructionId); }

        if (inst.kind == instruction.OP_DBG_VALUE) { i = i + 1; cnt; }

        var o: u32 = 0;
        for (o < inst.operand_count) {
            val op: value.Value = inst.operands[o];
            if (op.kind == value.VAL_INSTR && op.data.instr::u32 < st.pool_len) {
                val c: u32 = st.cand_of[op.data.instr::u32];
                if (c != NONE_U32) {
                    taint_all(st, c, op.secret);
                    if (inst.kind != instruction.OP_PHI) { note_home(st, c, st.instr_block[i]); }
                    if (!classify_one(st, c, i::id.InstructionId, inst, o)) { st.cand_out[c] = true; }
                }
            }
            o = o + 1;
        }
        i = i + 1;
    }
}

fun classify_one(st: *State, c: u32, iid: id.InstructionId, inst: *instruction.Instruction, o: u32) bool {
    if (inst.kind == instruction.OP_GEP && o == 0) {
        if (inst.operand_count < 3)                          { ret false; }
        if (inst.operands[1].kind != value.VAL_CONST_INT)    { ret false; }
        if (inst.operands[1].data.int_lit != 0)              { ret false; }
        if (inst.operands[2].kind != value.VAL_CONST_INT)    { ret false; }
        val k: u64 = inst.operands[2].data.int_lit;
        if (k >= st.cand_nf[c]::u64)                         { ret false; }
        if (inst.operand_count > 3
            && union_leaf_ty(st, agg_field_type(st, st.cand_ty[c], k::u32)) != ir_type.IRT_NIL) { ret false; }
        st.gep_of[iid::u32]    = c;
        st.gep_field[iid::u32] = k::u32;
        ret true;
    }
    if (inst.kind == instruction.OP_MEMZERO && o == 0) { ret st.cand_phi[c] == false; }
    if (inst.kind == instruction.OP_STORE && inst.operand_count >= 2) {
        if (o == 1) {
            if (st.cand_phi[c])                                  { ret false; }
            if (inst.operands[0].ty != st.cand_ty[c])            { ret false; }
            ret is_address_value(inst.operands[0]);
        }
        if (o == 0) {
            if (inst.operands[0].ty != st.cand_ty[c])            { ret false; }
            val d: value.Value = inst.operands[1];
            if (d.kind != value.VAL_INSTR)                       { ret false; }
            if (d.data.instr::u32 >= st.pool_len)                { ret false; }
            val dc: u32 = st.cand_of[d.data.instr::u32];
            if (dc == NONE_U32 || st.cand_phi[dc])               { ret false; }
            ret st.cand_ty[dc] == st.cand_ty[c];
        }
        ret false;
    }
    if (opdesc.operand_role(inst.kind, o) == opdesc.ROLE_PHI_VALUE) {
        val pc: u32 = st.cand_of[iid::u32];
        if (pc == NONE_U32 || st.cand_phi[pc] == false) { ret false; }
        ret find_root(st, pc) == find_root(st, c);
    }
    ret false;
}

fun mark_union_member_geps(st: *State) {
    val fn: *ir.Function = st.fn;
    var i: u32 = 0;
    for (i < st.pool_len) {
        if (st.instr_block[i] == id.BLOCK_NIL) { i = i + 1; cnt; }
        if (st.gep_of[i] != NONE_U32)          { i = i + 1; cnt; }
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (inst.kind != instruction.OP_GEP || inst.operand_count != 3) { i = i + 1; cnt; }

        val base: value.Value = inst.operands[0];
        if (base.kind != value.VAL_INSTR)               { i = i + 1; cnt; }
        if (base.data.instr::u32 >= st.pool_len)        { i = i + 1; cnt; }
        val bid: u32 = base.data.instr::u32;
        if (st.gep_of[bid] == NONE_U32 || st.uni_gep[bid]) { i = i + 1; cnt; }

        val c: u32 = st.gep_of[bid];
        val k: u32 = st.gep_field[bid];
        val ft: ir_type.IrTypeId = agg_field_type(st, st.cand_ty[c], k);
        if (union_leaf_ty(st, ft) == ir_type.IRT_NIL)    { i = i + 1; cnt; }
        if (inst.aux_ty != ft)                           { i = i + 1; cnt; }
        if (inst.operands[1].kind != value.VAL_CONST_INT) { i = i + 1; cnt; }
        if (inst.operands[1].data.int_lit != 0)           { i = i + 1; cnt; }
        if (inst.operands[2].kind != value.VAL_CONST_INT) { i = i + 1; cnt; }
        if (inst.operands[2].data.int_lit >= union_member_count(st, ft)::u64) { i = i + 1; cnt; }

        st.gep_of[i]    = c;
        st.gep_field[i] = k;
        st.uni_gep[i]   = true;
        i = i + 1;
    }
}

fun mark_asm_binds(st: *State, asm_id: id.InstructionId) {
    var key: id.InstructionId = asm_id;
    val res_: opt[*ir.IrAsm] = map.get[id.InstructionId, ir.IrAsm](?st.fn.asm_blocks, ?key);
    if (sel res_.none) { ret; }
    val payload: *ir.IrAsm = res_.some;
    var b: u32 = 0;
    for (b < payload.bind_count) {
        val bid: id.InstructionId = payload.binds[b].instr;
        if (bid::u32 < st.pool_len && st.cand_of[bid::u32] != NONE_U32) {
            st.cand_out[st.cand_of[bid::u32]] = true;
        }
        b = b + 1;
    }
}

fun classify_gep_uses(st: *State) {
    val fn: *ir.Function = st.fn;
    var i: u32 = 0;
    for (i < st.pool_len) {
        if (st.instr_block[i] == id.BLOCK_NIL) { i = i + 1; cnt; }
        val inst: *instruction.Instruction = ?fn.instrs[i];
        if (inst.kind == instruction.OP_DBG_VALUE) { i = i + 1; cnt; }

        var o: u32 = 0;
        for (o < inst.operand_count) {
            val op: value.Value = inst.operands[o];
            if (op.kind == value.VAL_INSTR && op.data.instr::u32 < st.pool_len) {
                val g: u32 = st.gep_of[op.data.instr::u32];
                if (g != NONE_U32) {
                    taint_field(st, g, st.gep_field[op.data.instr::u32], op.secret || inst.secret);
                    note_home(st, g, st.instr_block[i]);
                    if (!gep_use_ok(st, g, op.data.instr, i::id.InstructionId, inst, o)) { st.cand_out[g] = true; }
                }
            }
            o = o + 1;
        }
        i = i + 1;
    }
}

fun gep_use_ok(st: *State, c: u32, gid: id.InstructionId, uid: id.InstructionId, inst: *instruction.Instruction, o: u32) bool {
    val cell: bool = union_leaf_ty(st, agg_field_type(st, st.cand_ty[c], st.gep_field[gid::u32])) != ir_type.IRT_NIL;
    if (inst.kind == instruction.OP_LOAD && o == 0) {
        if (cell) { ret union_access_ok(st, c, gid, inst.ty); }
        ret true;
    }
    if (inst.kind == instruction.OP_STORE && o == 1) {
        if (st.cand_phi[c]) { ret false; }
        if (cell) { ret union_access_ok(st, c, gid, inst.operands[0].ty); }
        ret true;
    }
    if (inst.kind == instruction.OP_GEP && o == 0) { ret gep_stays_in_field(st, c, gid, uid, inst); }
    ret false;
}

fun union_access_ok(st: *State, c: u32, gid: id.InstructionId, at: ir_type.IrTypeId) bool {
    if (!scalar_field(st, at)) { ret false; }
    val ft: ir_type.IrTypeId = agg_field_type(st, st.cand_ty[c], st.gep_field[gid::u32]);
    val cell: u32 = ir_type.byte_size_for_machine(?st.m.types, ft, resolved.layout_machine(st.tgt));
    val acc: u32  = ir_type.byte_size_for_machine(?st.m.types, at, resolved.layout_machine(st.tgt));
    if (acc > cell) { ret false; }
    if (acc == cell) { ret true; }
    if (union_leaf_ty(st, ft) != int_of_bytes(st, cell)) { ret false; }
    ret int_of_bytes(st, acc) != ir_type.IRT_NIL;
}

fun gep_stays_in_field(st: *State, c: u32, gid: id.InstructionId, uid: id.InstructionId, inst: *instruction.Instruction) bool {
    val ft: ir_type.IrTypeId = agg_field_type(st, st.cand_ty[c], st.gep_field[gid::u32]);
    if (union_leaf_ty(st, ft) != ir_type.IRT_NIL)     { ret st.uni_gep[uid::u32]; }
    if (inst.operand_count < 2)                       { ret false; }
    if (inst.operands[1].kind != value.VAL_CONST_INT) { ret false; }
    if (inst.operands[1].data.int_lit != 0)           { ret false; }
    ret inst.aux_ty == ft;
}

fun check_partitions(st: *State) {
    var c: u32 = 0;
    for (c < st.cand_count) {
        if (st.cand_phi[c] == false || st.cand_out[c]) { c = c + 1; cnt; }
        val home: id.BlockId = st.cand_home[c];
        if (home == id.BLOCK_NIL || st.cand_local[c] == false) { st.cand_out[c] = true; c = c + 1; cnt; }
        if (block_writes_partition(st, home, c)) { st.cand_out[c] = true; c = c + 1; cnt; }

        val root: u32 = find_root(st, c);
        var a: u32 = 0;
        for (a < st.cand_count) {
            if (st.cand_phi[a] || find_root(st, a) != root) { a = a + 1; cnt; }
            if (st.cand_local[a] == false || st.cand_home[a] == id.BLOCK_NIL) {
                st.cand_out[a] = true;
                a = a + 1;
                cnt;
            }
            var b: u32 = 0;
            for (b < st.cand_count) {
                if (b == a || st.cand_phi[b] || find_root(st, b) != root) { b = b + 1; cnt; }
                if (st.cand_home[b] == st.cand_home[a]) { st.cand_out[a] = true; }
                or {
                    if (reaches_between(st, st.cand_home[a], st.cand_home[b], root)) { st.cand_out[a] = true; }
                }
                b = b + 1;
            }
            a = a + 1;
        }
        c = c + 1;
    }
}

fun reaches_between(st: *State, from: id.BlockId, to: id.BlockId, root: u32) bool {
    var i: u32 = 0;
    for (i < st.block_count) { st.visit[i] = false; i = i + 1; }

    var tail: u32 = 0;
    push_successors(st, from, ?tail);

    var head: u32 = 0;
    for (head < tail) {
        val b: id.BlockId = st.queue[head];
        head = head + 1;
        if (b == to)                                 { ret true; }
        if (is_partition_phi_block(st, b, root))     { cnt; }
        push_successors(st, b, ?tail);
    }
    ret false;
}

fun push_successors(st: *State, b: id.BlockId, tail: *u32) {
    var s0: id.BlockId = id.BLOCK_NIL;
    var s1: id.BlockId = id.BLOCK_NIL;
    val n: u32 = ir.block_successors(st.fn, ?st.fn.blocks[b::u32], ?s0, ?s1);
    if (n >= 1) { push_block(st, s0, tail); }
    if (n >= 2) { push_block(st, s1, tail); }
}

fun push_block(st: *State, b: id.BlockId, tail: *u32) {
    if (b == id.BLOCK_NIL || b::u32 >= st.block_count) { ret; }
    if (st.visit[b::u32]) { ret; }
    st.visit[b::u32] = true;
    st.queue[@tail] = b;
    @tail = @tail + 1;
}

fun is_partition_phi_block(st: *State, b: id.BlockId, root: u32) bool {
    var c: u32 = 0;
    for (c < st.cand_count) {
        if (st.cand_phi[c] && find_root(st, c) == root && st.cand_home[c] == b) { ret true; }
        c = c + 1;
    }
    ret false;
}

fun block_writes_partition(st: *State, b: id.BlockId, c: u32) bool {
    val fn: *ir.Function = st.fn;
    val root: u32 = find_root(st, c);
    val blk: *ir.Block = ?fn.blocks[b::u32];
    var ix: u32 = 0;
    for (ix < blk.instr_count) {
        val iid: id.InstructionId = blk.instructions[ix];
        ix = ix + 1;
        if (iid::u32 >= st.pool_len) { cnt; }
        val inst: *instruction.Instruction = ?fn.instrs[iid::u32];

        var target: value.Value;
        if (inst.kind == instruction.OP_MEMZERO && inst.operand_count >= 1) {
            target = inst.operands[0];
        } or (inst.kind == instruction.OP_STORE && inst.operand_count >= 2) {
            target = inst.operands[1];
        } or { cnt; }

        if (target.kind != value.VAL_INSTR || target.data.instr::u32 >= st.pool_len) { cnt; }
        val ti: u32 = target.data.instr::u32;
        var owner: u32 = st.cand_of[ti];
        if (owner == NONE_U32) { owner = st.gep_of[ti]; }
        if (owner != NONE_U32 && find_root(st, owner) == root) { ret true; }
    }
    ret false;
}

fun propagate_escapes(st: *State) {
    val fn: *ir.Function = st.fn;
    var changed: bool = true;
    for (changed) {
        changed = false;

        var c: u32 = 0;
        for (c < st.cand_count) {
            if (st.cand_out[c]) { st.cand_out[find_root(st, c)] = true; }
            c = c + 1;
        }
        var d: u32 = 0;
        for (d < st.cand_count) {
            if (st.cand_out[d] == false && st.cand_out[find_root(st, d)]) {
                st.cand_out[d] = true;
                changed = true;
            }
            d = d + 1;
        }

        var i: u32 = 0;
        for (i < st.pool_len) {
            if (st.instr_block[i] == id.BLOCK_NIL) { i = i + 1; cnt; }
            val inst: *instruction.Instruction = ?fn.instrs[i];
            if (inst.kind != instruction.OP_STORE || inst.operand_count < 2) { i = i + 1; cnt; }
            val sv: value.Value = inst.operands[0];
            val dv: value.Value = inst.operands[1];
            if (sv.kind != value.VAL_INSTR || dv.kind != value.VAL_INSTR) { i = i + 1; cnt; }
            if (sv.data.instr::u32 >= st.pool_len || dv.data.instr::u32 >= st.pool_len) { i = i + 1; cnt; }
            val sc: u32 = st.cand_of[sv.data.instr::u32];
            val dc: u32 = st.cand_of[dv.data.instr::u32];
            if (sc != NONE_U32 && st.cand_out[sc] == false) {
                if (dc == NONE_U32 || st.cand_out[dc]) {
                    st.cand_out[sc] = true;
                    changed = true;
                }
            }
            i = i + 1;
        }
    }
}

fun assign_slots(st: *State) u32 {
    var total: u32 = 0;
    var live: u32 = 0;
    var c: u32 = 0;
    for (c < st.cand_count) {
        if (st.cand_out[c] == false && find_root(st, c) == c) {
            st.cand_slot[c] = total;
            total = total + st.cand_nf[c];
        }
        c = c + 1;
    }
    var d: u32 = 0;
    for (d < st.cand_count) {
        if (st.cand_out[d] == false) {
            st.cand_slot[d] = st.cand_slot[find_root(st, d)];
            live = live + 1;
        }
        d = d + 1;
    }
    st.slot_total = total;
    ret live;
}

rec Cursor {
    bid: id.BlockId;
    loc: source.SrcLoc;
}

fun rewrite(st: *State) err[fail.Fail] {
    val r_slots: res[*value.Value, A.Error] = A.allocate[value.Value](st.alloc, st.slot_total::usize);
    if (sel r_slots.err) { ret err[fail.Fail].err{fail.refused(r_slots.err)}; }
    st.slots = r_slots.ok;

    val r_types: err[fail.Fail] = intern_types(st);
    if (sel r_types.err) { ret r_types; }

    val r_alloc: err[fail.Fail] = emit_field_slots(st);
    if (sel r_alloc.err) { ret r_alloc; }

    var rw: mutate.Rewrite;
    val r_rw: err[fail.Fail] = mutate.rewrite_init(?rw, st.alloc, st.fn.instr_len);
    if (sel r_rw.err) { ret r_rw; }

    val r_body: err[fail.Fail] = rewrite_blocks(st, ?rw);
    if (sel r_body.err) { mutate.rewrite_dnit(?rw, st.alloc); ret r_body; }

    mutate.rewrite_apply(st.fn, ?rw);
    mutate.rewrite_dnit(?rw, st.alloc);

    val changed_r: res[bool, fail.Fail] = mutate.erase_marked[State](st.m, st.fn, st, erase_test);
    if (sel changed_r.err) { ret err[fail.Fail].err{changed_r.err}; }
    ret err[fail.Fail].ok{};
}

fun intern_types(st: *State) err[fail.Fail] {
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?st.m.types);
    if (sel rp.err) { ret err[fail.Fail].err{rp.err}; }
    st.ptr_ty = rp.ok;

    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?st.m.types);
    if (sel rv.err) { ret err[fail.Fail].err{rv.err}; }
    st.void_ty = rv.ok;

    val ri: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?st.m.types, 64);
    if (sel ri.err) { ret err[fail.Fail].err{ri.err}; }
    st.i64_ty = ri.ok;
    ret err[fail.Fail].ok{};
}

fun emit(st: *State, cur: *Cursor, kind: instruction.InstrKind, ty: ir_type.IrTypeId,
         ops: *value.Value, n: u32, aux_ty: ir_type.IrTypeId, secret: bool) res[id.InstructionId, fail.Fail] {
    var inst: instruction.Instruction;
    inst.kind          = kind;
    inst.ty            = ty;
    inst.operands      = ops;
    inst.operand_count = n;
    inst.operand_cap   = n;
    inst.flags         = 0;
    inst.aux_ty        = aux_ty;
    inst.loc           = cur.loc;
    inst.secret        = secret;

    val r: res[id.InstructionId, fail.Fail] = ir.instruction_add(st.m, st.fn, inst);
    if (sel r.err) {
        A.deallocate[value.Value](st.m.alloc, ops, n::usize);
        ret r;
    }
    val iid: id.InstructionId = r.ok;

    val ra: err[fail.Fail] = ir.block_append_instr(st.m, ?st.fn.blocks[cur.bid::u32], iid);
    if (sel ra.err) { ret res[id.InstructionId, fail.Fail].err{ra.err}; }
    ret res[id.InstructionId, fail.Fail].ok{iid};
}

fun emit_slot(st: *State, cur: *Cursor, ft: ir_type.IrTypeId, secret: bool) res[value.Value, fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 1::usize);
    if (sel r.err) { ret res[value.Value, fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = value.const_int(1, st.i64_ty);

    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, instruction.OP_ALLOCA, st.ptr_ty, ops, 1, ft, secret);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    var v: value.Value = value.instr(ri.ok, st.ptr_ty);
    v.secret = secret;
    ret res[value.Value, fail.Fail].ok{v};
}

fun emit_store(st: *State, cur: *Cursor, v: value.Value, ptr: value.Value, secret: bool) err[fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 2::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = v;
    ops[1] = ptr;
    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, instruction.OP_STORE, st.void_ty, ops, 2,
                                                  ir_type.IRT_NIL, secret || v.secret);
    if (sel ri.err) { ret err[fail.Fail].err{ri.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_load(st: *State, cur: *Cursor, ptr: value.Value, ty: ir_type.IrTypeId, secret: bool) res[value.Value, fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 1::usize);
    if (sel r.err) { ret res[value.Value, fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = ptr;
    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, instruction.OP_LOAD, ty, ops, 1, ir_type.IRT_NIL, secret);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    var v: value.Value = value.instr(ri.ok, ty);
    v.secret = secret;
    ret res[value.Value, fail.Fail].ok{v};
}

fun emit_bitcast(st: *State, cur: *Cursor, v: value.Value, to: ir_type.IrTypeId, secret: bool) res[value.Value, fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 1::usize);
    if (sel r.err) { ret res[value.Value, fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = v;
    val tainted: bool = secret || v.secret;
    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, instruction.OP_BITCAST, to, ops, 1, ir_type.IRT_NIL, tainted);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    var out: value.Value = value.instr(ri.ok, to);
    out.secret = tainted;
    ret res[value.Value, fail.Fail].ok{out};
}

fun emit_convert(st: *State, cur: *Cursor, kind: instruction.InstrKind, v: value.Value,
                 to: ir_type.IrTypeId, secret: bool) res[value.Value, fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 1::usize);
    if (sel r.err) { ret res[value.Value, fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = v;
    val tainted: bool = secret || v.secret;
    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, kind, to, ops, 1, ir_type.IRT_NIL, tainted);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    var out: value.Value = value.instr(ri.ok, to);
    out.secret = tainted;
    ret res[value.Value, fail.Fail].ok{out};
}

fun emit_binary(st: *State, cur: *Cursor, kind: instruction.InstrKind, a: value.Value,
                b: value.Value, secret: bool) res[value.Value, fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 2::usize);
    if (sel r.err) { ret res[value.Value, fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = a;
    ops[1] = b;
    val tainted: bool = secret || a.secret || b.secret;
    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, kind, a.ty, ops, 2, ir_type.IRT_NIL, tainted);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    var out: value.Value = value.instr(ri.ok, a.ty);
    out.secret = tainted;
    ret res[value.Value, fail.Fail].ok{out};
}

fun emit_memzero(st: *State, cur: *Cursor, ptr: value.Value, ft: ir_type.IrTypeId, secret: bool) err[fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 1::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = ptr;
    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, instruction.OP_MEMZERO, st.void_ty, ops, 1, ft, secret);
    if (sel ri.err) { ret err[fail.Fail].err{ri.err}; }
    ret err[fail.Fail].ok{};
}

fun emit_field_gep(st: *State, cur: *Cursor, base: value.Value, ty: ir_type.IrTypeId, k: u32, secret: bool) res[value.Value, fail.Fail] {
    val r: res[*value.Value, A.Error] = A.allocate[value.Value](st.m.alloc, 3::usize);
    if (sel r.err) { ret res[value.Value, fail.Fail].err{fail.refused(r.err)}; }
    val ops: *value.Value = r.ok;
    ops[0] = base;
    ops[1] = value.const_int(0, st.i64_ty);
    ops[2] = value.const_int(k::u64, st.i64_ty);
    val ri: res[id.InstructionId, fail.Fail] = emit(st, cur, instruction.OP_GEP, st.ptr_ty, ops, 3, ty, secret);
    if (sel ri.err) { ret res[value.Value, fail.Fail].err{ri.err}; }
    var v: value.Value = value.instr(ri.ok, st.ptr_ty);
    v.secret = secret;
    ret res[value.Value, fail.Fail].ok{v};
}

fun emit_field_slots(st: *State) err[fail.Fail] {
    val before: u32 = st.fn.blocks[0].instr_count;
    var cur: Cursor;
    cur.bid = 0::id.BlockId;

    var c: u32 = 0;
    for (c < st.cand_count) {
        if (st.cand_out[c] || find_root(st, c) != c) { c = c + 1; cnt; }
        cur.loc = st.fn.instrs[st.cand_id[c]::u32].loc;
        var k: u32 = 0;
        for (k < st.cand_nf[c]) {
            val ft: ir_type.IrTypeId = slot_ty(st, st.cand_ty[c], k);
            val r: res[value.Value, fail.Fail] = emit_slot(st, ?cur, ft, partition_field_secret(st, c, k));
            if (sel r.err) { ret err[fail.Fail].err{r.err}; }
            st.slots[st.cand_slot[c] + k] = r.ok;
            k = k + 1;
        }
        c = c + 1;
    }

    ret rotate_to_front(st, 0::id.BlockId, before);
}

fun partition_field_secret(st: *State, c: u32, k: u32) bool {
    if (k >= MAX_FIELDS) { ret true; }
    val root: u32 = find_root(st, c);
    var d: u32 = 0;
    for (d < st.cand_count) {
        if (st.field_secret[d * MAX_FIELDS + k] && find_root(st, d) == root) { ret true; }
        d = d + 1;
    }
    ret false;
}

fun rotate_to_front(st: *State, bid: id.BlockId, before: u32) err[fail.Fail] {
    val blk: *ir.Block = ?st.fn.blocks[bid::u32];
    if (blk.instr_count == before) { ret err[fail.Fail].ok{}; }

    val r: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](st.alloc, blk.instr_count::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val tmp: *id.InstructionId = r.ok;

    var w: u32 = 0;
    var i: u32 = before;
    for (i < blk.instr_count) { tmp[w] = blk.instructions[i]; w = w + 1; i = i + 1; }
    var j: u32 = 0;
    for (j < before) { tmp[w] = blk.instructions[j]; w = w + 1; j = j + 1; }
    var z: u32 = 0;
    for (z < blk.instr_count) { blk.instructions[z] = tmp[z]; z = z + 1; }

    A.deallocate[id.InstructionId](st.alloc, tmp, blk.instr_count::usize);
    ret err[fail.Fail].ok{};
}

fun rewrite_blocks(st: *State, rw: *mutate.Rewrite) err[fail.Fail] {
    var bi: u32 = 0;
    for (bi < st.fn.block_count) {
        val res_: err[fail.Fail] = rewrite_block(st, rw, bi::id.BlockId);
        if (sel res_.err) { ret res_; }
        bi = bi + 1;
    }
    ret err[fail.Fail].ok{};
}

fun rewrite_block(st: *State, rw: *mutate.Rewrite, bid: id.BlockId) err[fail.Fail] {
    val old_n: u32 = st.fn.blocks[bid::u32].instr_count;
    if (old_n == 0) { ret err[fail.Fail].ok{}; }

    val r_old: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](st.alloc, old_n::usize);
    if (sel r_old.err) { ret err[fail.Fail].err{fail.refused(r_old.err)}; }
    val old: *id.InstructionId = r_old.ok;
    var s: u32 = 0;
    for (s < old_n) { old[s] = st.fn.blocks[bid::u32].instructions[s]; s = s + 1; }

    val r_cnt: res[*u32, A.Error] = A.allocate[u32](st.alloc, old_n::usize);
    if (sel r_cnt.err) {
        A.deallocate[id.InstructionId](st.alloc, old, old_n::usize);
        ret err[fail.Fail].err{fail.refused(r_cnt.err)};
    }
    val added: *u32 = r_cnt.ok;

    var err_: str = nil;
    var ix: u32 = 0;
    for (ix < old_n && err_ == nil) {
        val at: u32 = st.fn.blocks[bid::u32].instr_count;
        val res_: err[fail.Fail] = rewrite_instr(st, rw, bid, old[ix]);
        if (sel res_.err) { err_ = fail.describe(res_.err); }
        or { added[ix] = st.fn.blocks[bid::u32].instr_count - at; }
        ix = ix + 1;
    }

    if (err_ == nil) {
        val res_: err[fail.Fail] = relayout_block(st, bid, old, old_n, added);
        if (sel res_.err) { err_ = fail.describe(res_.err); }
    }

    A.deallocate[id.InstructionId](st.alloc, old, old_n::usize);
    A.deallocate[u32](st.alloc, added, old_n::usize);
    if (err_ != nil) { ret err[fail.Fail].err{fail.message(err_)}; }
    ret err[fail.Fail].ok{};
}

fun relayout_block(st: *State, bid: id.BlockId, old: *id.InstructionId, old_n: u32, added: *u32) err[fail.Fail] {
    val blk: *ir.Block = ?st.fn.blocks[bid::u32];
    val total: u32 = blk.instr_count;
    if (total == old_n) { ret err[fail.Fail].ok{}; }

    val r: res[*id.InstructionId, A.Error] = A.allocate[id.InstructionId](st.alloc, total::usize);
    if (sel r.err) { ret err[fail.Fail].err{fail.refused(r.err)}; }
    val plan: *id.InstructionId = r.ok;

    var w: u32 = 0;
    var src: u32 = old_n;
    var ix: u32 = 0;
    for (ix < old_n) {
        var a: u32 = 0;
        for (a < added[ix]) { plan[w] = blk.instructions[src]; w = w + 1; src = src + 1; a = a + 1; }
        plan[w] = old[ix];
        w = w + 1;
        ix = ix + 1;
    }
    var z: u32 = 0;
    for (z < total) { blk.instructions[z] = plan[z]; z = z + 1; }

    A.deallocate[id.InstructionId](st.alloc, plan, total::usize);
    ret err[fail.Fail].ok{};
}

fun rewrite_instr(st: *State, rw: *mutate.Rewrite, bid: id.BlockId, iid: id.InstructionId) err[fail.Fail] {
    if (iid::u32 >= st.pool_len) { ret err[fail.Fail].ok{}; }
    val inst: *instruction.Instruction = ?st.fn.instrs[iid::u32];
    var cur: Cursor;
    cur.bid = bid;
    cur.loc = inst.loc;

    val g: u32 = st.gep_of[iid::u32];
    if (g != NONE_U32 && st.cand_out[g] == false) { ret retarget_gep(st, rw, iid, g); }

    if (inst.kind == instruction.OP_LOAD && inst.operand_count >= 1) {
        val ug: u32 = union_access_at(st, inst.operands[0]);
        if (ug != NONE_U32) { ret reinterpret_load(st, rw, ?cur, iid, inst, ug); }
    }

    if (inst.kind == instruction.OP_STORE && inst.operand_count >= 2) {
        val ug: u32 = union_access_at(st, inst.operands[1]);
        if (ug != NONE_U32) { ret reinterpret_store(st, ?cur, iid, inst, ug); }
    }

    if (inst.kind == instruction.OP_MEMZERO && inst.operand_count >= 1) {
        val c: u32 = candidate_at(st, inst.operands[0]);
        if (c != NONE_U32 && st.cand_out[c] == false) {
            st.erase[iid::u32] = true;
            ret expand_memzero(st, ?cur, c);
        }
        ret err[fail.Fail].ok{};
    }

    if (inst.kind == instruction.OP_STORE && inst.operand_count >= 2) {
        val dc: u32 = candidate_at(st, inst.operands[1]);
        if (dc != NONE_U32 && st.cand_out[dc] == false) {
            st.erase[iid::u32] = true;
            ret expand_copy(st, ?cur, dc, inst.operands[0]);
        }
    }
    ret err[fail.Fail].ok{};
}

fun union_access_at(st: *State, v: value.Value) u32 {
    if (v.kind != value.VAL_INSTR)        { ret NONE_U32; }
    if (v.data.instr::u32 >= st.pool_len) { ret NONE_U32; }
    val gid: u32 = v.data.instr::u32;
    val c: u32 = st.gep_of[gid];
    if (c == NONE_U32 || st.cand_out[c])  { ret NONE_U32; }
    if (union_leaf_ty(st, agg_field_type(st, st.cand_ty[c], st.gep_field[gid])) == ir_type.IRT_NIL) { ret NONE_U32; }
    ret gid;
}

fun reinterpret_load(st: *State, rw: *mutate.Rewrite, cur: *Cursor, iid: id.InstructionId,
                     inst: *instruction.Instruction, gid: u32) err[fail.Fail] {
    val c: u32 = st.gep_of[gid];
    val sty: ir_type.IrTypeId = slot_ty(st, st.cand_ty[c], st.gep_field[gid]);
    if (inst.ty == sty) { ret err[fail.Fail].ok{}; }

    val slot: value.Value = st.slots[st.cand_slot[c] + st.gep_field[gid]];
    val tainted: bool = inst.secret || partition_field_secret(st, c, st.gep_field[gid]);
    val inst_ty: ir_type.IrTypeId = inst.ty;
    val r_load: res[value.Value, fail.Fail] = emit_load(st, cur, slot, sty, tainted);
    if (sel r_load.err) { ret err[fail.Fail].err{r_load.err}; }
    var cur_v: value.Value = r_load.ok;

    val acc: u32 = ir_type.byte_size_for_machine(?st.m.types, inst_ty, resolved.layout_machine(st.tgt));
    if (acc < ir_type.byte_size_for_machine(?st.m.types, sty, resolved.layout_machine(st.tgt))) {
        val r_tr: res[value.Value, fail.Fail] = emit_convert(st, cur, instruction.OP_TRUNC, cur_v,
                                                            int_of_bytes(st, acc), tainted);
        if (sel r_tr.err) { ret err[fail.Fail].err{r_tr.err}; }
        cur_v = r_tr.ok;
    }
    if (cur_v.ty != inst_ty) {
        val r_cast: res[value.Value, fail.Fail] = emit_bitcast(st, cur, cur_v, inst_ty, tainted);
        if (sel r_cast.err) { ret err[fail.Fail].err{r_cast.err}; }
        cur_v = r_cast.ok;
    }

    mutate.replace_value(rw, iid, cur_v);
    st.erase[iid::u32] = true;
    ret err[fail.Fail].ok{};
}

fun reinterpret_store(st: *State, cur: *Cursor, iid: id.InstructionId,
                      inst: *instruction.Instruction, gid: u32) err[fail.Fail] {
    val c: u32 = st.gep_of[gid];
    val sty: ir_type.IrTypeId = slot_ty(st, st.cand_ty[c], st.gep_field[gid]);
    val v: value.Value = inst.operands[0];
    if (v.ty == sty) { ret err[fail.Fail].ok{}; }

    val slot: value.Value = st.slots[st.cand_slot[c] + st.gep_field[gid]];
    val tainted: bool = inst.secret || v.secret || partition_field_secret(st, c, st.gep_field[gid]);
    val acc: u32 = ir_type.byte_size_for_machine(?st.m.types, v.ty, resolved.layout_machine(st.tgt));
    val cell: u32 = ir_type.byte_size_for_machine(?st.m.types, sty, resolved.layout_machine(st.tgt));

    var cur_v: value.Value = v;
    if (acc < cell) {
        if (cur_v.ty != int_of_bytes(st, acc)) {
            val r_ci: res[value.Value, fail.Fail] = emit_bitcast(st, cur, cur_v, int_of_bytes(st, acc), tainted);
            if (sel r_ci.err) { ret err[fail.Fail].err{r_ci.err}; }
            cur_v = r_ci.ok;
        }
        val r_z: res[value.Value, fail.Fail] = emit_convert(st, cur, instruction.OP_ZEXT, cur_v, sty, tainted);
        if (sel r_z.err) { ret err[fail.Fail].err{r_z.err}; }
        cur_v = r_z.ok;

        val r_old: res[value.Value, fail.Fail] = emit_load(st, cur, slot, sty, tainted);
        if (sel r_old.err) { ret err[fail.Fail].err{r_old.err}; }
        val keep: value.Value = value.const_int(~((1::u64 << (acc * 8)) - 1), sty);
        val r_and: res[value.Value, fail.Fail] = emit_binary(st, cur, instruction.OP_AND,
                                                            r_old.ok, keep, tainted);
        if (sel r_and.err) { ret err[fail.Fail].err{r_and.err}; }
        val r_or: res[value.Value, fail.Fail] = emit_binary(st, cur, instruction.OP_OR,
                                                           r_and.ok, cur_v, tainted);
        if (sel r_or.err) { ret err[fail.Fail].err{r_or.err}; }
        cur_v = r_or.ok;
    }
    or {
        val r_cast: res[value.Value, fail.Fail] = emit_bitcast(st, cur, cur_v, sty, tainted);
        if (sel r_cast.err) { ret err[fail.Fail].err{r_cast.err}; }
        cur_v = r_cast.ok;
    }

    val r_store: err[fail.Fail] = emit_store(st, cur, cur_v, slot, tainted);
    if (sel r_store.err) { ret r_store; }
    st.erase[iid::u32] = true;
    ret err[fail.Fail].ok{};
}

fun candidate_at(st: *State, v: value.Value) u32 {
    if (v.kind != value.VAL_INSTR)         { ret NONE_U32; }
    if (v.data.instr::u32 >= st.pool_len)  { ret NONE_U32; }
    ret st.cand_of[v.data.instr::u32];
}

fun retarget_gep(st: *State, rw: *mutate.Rewrite, gid: id.InstructionId, c: u32) err[fail.Fail] {
    val inst: *instruction.Instruction = ?st.fn.instrs[gid::u32];
    val k: u32 = st.gep_field[gid::u32];
    val slot: value.Value = st.slots[st.cand_slot[c] + k];

    if (inst.operand_count == 3) {
        mutate.replace_value(rw, gid, slot);
        st.erase[gid::u32] = true;
        ret err[fail.Fail].ok{};
    }

    val n: u32 = inst.operand_count - 1;
    val r: res[ir.OperandArray, fail.Fail] = ir.operands_alloc(st.m, n);
    if (sel r.err)  { ret err[fail.Fail].err{r.err}; }
    val arr: ir.OperandArray = r.ok;
    arr.ops[0] = slot;
    arr.ops[1] = inst.operands[1];
    var i: u32 = 3;
    var w: u32 = 2;
    for (i < inst.operand_count) { arr.ops[w] = inst.operands[i]; w = w + 1; i = i + 1; }

    ir.instr_replace_operands(st.m, inst, arr);
    inst.aux_ty = agg_field_type(st, st.cand_ty[c], k);
    ret err[fail.Fail].ok{};
}

# zeroing writes a public constant, so each field's store carries the field's own secrecy and not the object's
fun expand_memzero(st: *State, cur: *Cursor, c: u32) err[fail.Fail] {
    var k: u32 = 0;
    for (k < st.cand_nf[c]) {
        val ft: ir_type.IrTypeId = slot_ty(st, st.cand_ty[c], k);
        val slot: value.Value = st.slots[st.cand_slot[c] + k];
        val tainted: bool = partition_field_secret(st, c, k);
        if (ir_type.is_aggregate(?st.m.types, ft)) {
            val r: err[fail.Fail] = emit_memzero(st, cur, slot, ft, tainted);
            if (sel r.err) { ret r; }
        } or {
            val r: err[fail.Fail] = emit_store(st, cur, zero_of(st, ft), slot, tainted);
            if (sel r.err) { ret r; }
        }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

# a whole-object copy is secret only in the fields whose typed accesses are: the object's own flag is the union
# over its fields and would make every public field secret
fun expand_copy(st: *State, cur: *Cursor, dst: u32, src: value.Value) err[fail.Fail] {
    val sc: u32 = candidate_at(st, src);
    var k: u32 = 0;
    for (k < st.cand_nf[dst]) {
        var tainted: bool = partition_field_secret(st, dst, k);
        var from: value.Value;
        if (sc != NONE_U32 && st.cand_out[sc] == false) {
            from = st.slots[st.cand_slot[sc] + k];
            if (partition_field_secret(st, sc, k)) { tainted = true; }
        } or {
            val r: res[value.Value, fail.Fail] = emit_field_gep(st, cur, src, st.cand_ty[dst], k, tainted);
            if (sel r.err) { ret err[fail.Fail].err{r.err}; }
            from = r.ok;
        }
        val res_: err[fail.Fail] = copy_field(st, cur, st.slots[st.cand_slot[dst] + k],
                                                  from, slot_ty(st, st.cand_ty[dst], k), tainted);
        if (sel res_.err) { ret res_; }
        k = k + 1;
    }
    ret err[fail.Fail].ok{};
}

fun copy_field(st: *State, cur: *Cursor, slot: value.Value, from: value.Value, ft: ir_type.IrTypeId, tainted: bool) err[fail.Fail] {
    if (ir_type.is_aggregate(?st.m.types, ft)) {
        ret emit_store(st, cur, value.retype(from, ft), slot, tainted);
    }
    val r_load: res[value.Value, fail.Fail] = emit_load(st, cur, from, ft, tainted);
    if (sel r_load.err) { ret err[fail.Fail].err{r_load.err}; }
    ret emit_store(st, cur, r_load.ok, slot, tainted);
}

fun zero_of(st: *State, ft: ir_type.IrTypeId) value.Value {
    if (ir_type.is_float_scalar(?st.m.types, ft)) { ret value.const_float(0.0, ft); }
    val opt_: opt[*ir_type.IrType] = ir_type.get(?st.m.types, ft);
    if (sel opt_.some) {
        if (sel opt_.none) { ret value.const_null(ft); }
        if (opt_.some.kind == ir_type.IRT_PTR) { ret value.const_null(ft); }
    }
    ret value.const_int(0, ft);
}

fun erase_test(st: *State, iid: id.InstructionId) bool {
    if (iid::u32 >= st.pool_len) { ret false; }
    if (st.erase[iid::u32])      { ret true; }
    val c: u32 = st.cand_of[iid::u32];
    ret c != NONE_U32 && st.cand_out[c] == false;
}

fun ut_target(reg: *target.TargetRegistry, out: *resolved.Target) i32 {
    @reg = target.registry_init();
    val r_1430: err[fail.Fail] = target.register_all(reg, target_testing.debug_descriptor);
    if (sel r_1430.err) { ret 1; }
    val r: res[resolved.Target, fail.Fail] = target.select(reg, "x86_64", "linux", "sysv64");
    if (sel r.err) { ret 1; }
    @out = r.ok;
    ret 0;
}

fun ut_count(fn: *ir.Function, kind: instruction.InstrKind) u32 {
    var n: u32 = 0;
    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[b];
        var i: u32 = 0;
        for (i < blk.instr_count) {
            if (fn.instrs[blk.instructions[i]::u32].kind == kind) { n = n + 1; }
            i = i + 1;
        }
        var p: u32 = 0;
        for (p < blk.phi_count) {
            if (fn.instrs[blk.phis[p]::u32].kind == kind) { n = n + 1; }
            p = p + 1;
        }
        b = b + 1;
    }
    ret n;
}

fun ut_ret_value(fn: *ir.Function) value.Value {
    var b: u32 = 0;
    for (b < fn.block_count) {
        val blk: *ir.Block = ?fn.blocks[b];
        if (blk.terminator != id.INSTR_NIL) {
            val t: *instruction.Instruction = ?fn.instrs[blk.terminator::u32];
            if (t.kind == instruction.OP_RET && t.operand_count >= 1) { ret t.operands[0]; }
        }
        b = b + 1;
    }
    ret value.const_null(ir_type.IRT_NIL);
}

fun ut_rec2(m: *ir.Module, out: *ir_type.IrTypeId) i32 {
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ret 1; }
    var fields: [2]ir_type.IrTypeId;
    fields[0] = r8.ok;
    fields[1] = r64.ok;
    val rs: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?fields[0], 2, 0, false);
    if (sel rs.err) { ret 1; }
    @out = rs.ok;
    ret 0;
}

fun ut_gep(b: *builder.Builder, m: *ir.Module, base: value.Value, ty: ir_type.IrTypeId, k: u64) res[value.Value, fail.Fail] {
    val r: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r.err) { ret res[value.Value, fail.Fail].err{r.err}; }
    val i64t: ir_type.IrTypeId = r.ok;
    var idx: [2]value.Value;
    idx[0] = value.const_int(0, i64t);
    idx[1] = value.const_int(k, i64t);
    ret builder.emit_gep(b, base, ty, ?idx[0], 2);
}

test "mach.lang.me.transform.sroa.run:splits_a_local_record_into_registers" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    var rec: ir_type.IrTypeId;
    if (ut_rec2(?m, ?rec) != 0) { ir.dnit(?m); ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?b, rb.ok);

    var code: i32 = 0;
    val ra: res[value.Value, fail.Fail] = builder.emit_alloca(?b, rec, value.const_int(1, i64t));
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val s: value.Value = ra.ok;
    val r_1529: err[fail.Fail] = builder.emit_memzero(?b, s, rec);
    if (sel r_1529.err) { code = 1; }

    val g0: res[value.Value, fail.Fail] = ut_gep(?b, ?m, s, rec, 0);
    if (sel g0.err) { ir.dnit(?m); ret 1; }
    val r_1533: err[fail.Fail] = builder.emit_store(?b, value.const_int(1, i8t), g0.ok);
    if (sel r_1533.err) { code = 1; }
    val g1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, s, rec, 1);
    if (sel g1.err) { ir.dnit(?m); ret 1; }
    val r_1536: err[fail.Fail] = builder.emit_store(?b, value.param(0, i64t), g1.ok);
    if (sel r_1536.err) { code = 1; }

    val h1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, s, rec, 1);
    if (sel h1.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, h1.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_1542: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_1542.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA)  != 1) { code = 1; }
    if (ut_count(fn, instruction.OP_MEMZERO) != 1) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)              { code = 1; }
    or (sel rs.ok) { if (!rs.ok)     { code = 1; } }
    val r_1550: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_1550.err) { code = 1; }
    val r_1551: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_1551.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA)  != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_MEMZERO) != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_LOAD)    != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_STORE)   != 0) { code = 1; }
    val rv: value.Value = ut_ret_value(fn);
    if (rv.kind != value.VAL_PARAM)  { code = 1; }
    if (rv.data.param_ix != 0)       { code = 1; }

    ir.dnit(?m);
    ret code;
}

fun ut_field_type(m: *ir.Module, ty: ir_type.IrTypeId, k: u32) ir_type.IrTypeId {
    val opt_: opt[*ir_type.IrType] = ir_type.get(?m.types, ty);
    if (sel opt_.none) { ret ir_type.IRT_NIL; }
    val t: *ir_type.IrType = opt_.some;
    if (t.kind == ir_type.IRT_ARRAY) { ret t.data.array_.element; }
    if (k >= t.data.struct_.field_count) { ret ir_type.IRT_NIL; }
    ret t.data.struct_.fields[k];
}

fun ut_build_local(m: *ir.Module, b: *builder.Builder, rec: ir_type.IrTypeId, slot: *value.Value) u32 {
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ret NONE_U32; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val ft: ir_type.IrTypeId = ut_field_type(m, rec, 1);
    if (ft == ir_type.IRT_NIL) { ret NONE_U32; }

    val rf: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ret NONE_U32; }
    val ix: u32 = rf.ok;

    builder.set_function(b, ?m.functions[ix]);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(b);
    if (sel rb.err) { ret NONE_U32; }
    builder.set_block(b, rb.ok);

    val ra: res[value.Value, fail.Fail] = builder.emit_alloca(b, rec, value.const_int(1, i64t));
    if (sel ra.err) { ret NONE_U32; }
    @slot = ra.ok;
    val r_1593: err[fail.Fail] = builder.emit_memzero(b, @slot, rec);
    if (sel r_1593.err) { ret NONE_U32; }

    val g1: res[value.Value, fail.Fail] = ut_gep(b, m, @slot, rec, 1);
    if (sel g1.err) { ret NONE_U32; }
    val r_1597: err[fail.Fail] = builder.emit_store(b, value.param(0, ft), g1.ok);
    if (sel r_1597.err) { ret NONE_U32; }
    ret ix;
}

test "mach.lang.me.transform.sroa.run:declines_each_defeating_form" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    var rec: ir_type.IrTypeId;
    if (ut_rec2(?m, ?rec) != 0) { ir.dnit(?m); ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;

    val rc: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, ir.FN_FLAG_EXTERN);
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val callee: value.Value = value.fn(rc.ok, ptrt);

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);
    var slot: value.Value;

    val f_cast: u32 = ut_build_local(?m, ?b, rec, ?slot);
    if (f_cast == NONE_U32) { ir.dnit(?m); ret 1; }
    val r_1635: res[value.Value, fail.Fail] = builder.emit_bitcast(?b, slot, ptrt);
    if (sel r_1635.err) { code = 1; }
    val r_1636: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_1636.err) { code = 1; }

    val f_var: u32 = ut_build_local(?m, ?b, rec, ?slot);
    if (f_var == NONE_U32) { ir.dnit(?m); ret 1; }
    var idx: [2]value.Value;
    idx[0] = value.const_int(0, i64t);
    idx[1] = value.param(0, i64t);
    val r_1643: res[value.Value, fail.Fail] = builder.emit_gep(?b, slot, rec, ?idx[0], 2);
    if (sel r_1643.err) { code = 1; }
    val r_1644: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_1644.err) { code = 1; }

    val f_ret: u32 = ut_build_local(?m, ?b, rec, ?slot);
    if (f_ret == NONE_U32) { ir.dnit(?m); ret 1; }
    val r_1648: err[fail.Fail] = builder.emit_ret(?b, value.retype(slot, rec));
    if (sel r_1648.err) { code = 1; }

    val f_field: u32 = ut_build_local(?m, ?b, rec, ?slot);
    if (f_field == NONE_U32) { ir.dnit(?m); ret 1; }
    val g0: res[value.Value, fail.Fail] = ut_gep(?b, ?m, slot, rec, 0);
    if (sel g0.err) { ir.dnit(?m); ret 1; }
    var args: [1]value.Value;
    args[0] = g0.ok;
    val r_1656: res[value.Value, fail.Fail] = builder.emit_call(?b, callee, ?args[0], 1, voidt);
    if (sel r_1656.err) { code = 1; }
    val r_1657: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_1657.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)         { code = 1; }
    or (sel rs.ok) { if (rs.ok) { code = 1; } }

    if (ut_count(?m.functions[f_cast],  instruction.OP_ALLOCA) != 1) { code = 1; }
    if (ut_count(?m.functions[f_var],   instruction.OP_ALLOCA) != 1) { code = 1; }
    if (ut_count(?m.functions[f_ret],   instruction.OP_ALLOCA) != 1) { code = 1; }
    if (ut_count(?m.functions[f_field], instruction.OP_ALLOCA) != 1) { code = 1; }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:declines_a_strided_field_address" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val rarr: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_array(?m.types, i8t, 2);
    if (sel rarr.err) { ir.dnit(?m); ret 1; }
    val pair: ir_type.IrTypeId = rarr.ok;

    var inner: ir_type.IrTypeId;
    if (ut_rec2(?m, ?inner) != 0) { ir.dnit(?m); ret 1; }
    var nfields: [2]ir_type.IrTypeId;
    nfields[0] = i8t;
    nfields[1] = inner;
    val rn: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?nfields[0], 2, 0, false);
    if (sel rn.err) { ir.dnit(?m); ret 1; }
    val nested: ir_type.IrTypeId = rn.ok;

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);
    var slot: value.Value;

    val f_stride: u32 = ut_build_local(?m, ?b, pair, ?slot);
    if (f_stride == NONE_U32) { ir.dnit(?m); ret 1; }
    val g0: res[value.Value, fail.Fail] = ut_gep(?b, ?m, slot, pair, 0);
    if (sel g0.err) { ir.dnit(?m); ret 1; }
    var stride: [1]value.Value;
    stride[0] = value.param(0, i64t);
    val rs1: res[value.Value, fail.Fail] = builder.emit_gep(?b, g0.ok, i8t, ?stride[0], 1);
    if (sel rs1.err) { ir.dnit(?m); ret 1; }
    val r_1715: err[fail.Fail] = builder.emit_store(?b, value.const_int(7, i8t), rs1.ok);
    if (sel r_1715.err) { code = 1; }
    val r_1716: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_1716.err) { code = 1; }

    val f_nested: u32 = ut_build_local(?m, ?b, nested, ?slot);
    if (f_nested == NONE_U32) { ir.dnit(?m); ret 1; }
    val g1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, slot, nested, 1);
    if (sel g1.err) { ir.dnit(?m); ret 1; }
    val g1x: res[value.Value, fail.Fail] = ut_gep(?b, ?m, g1.ok, inner, 1);
    if (sel g1x.err) { ir.dnit(?m); ret 1; }
    val r_1724: err[fail.Fail] = builder.emit_store(?b, value.const_int(9, i64t), g1x.ok);
    if (sel r_1724.err) { code = 1; }
    val r_1725: err[fail.Fail] = builder.emit_ret_void(?b);
    if (sel r_1725.err) { code = 1; }

    val rr: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rr.err)          { code = 1; }
    or (sel rr.ok) { if (!rr.ok) { code = 1; } }

    if (ut_count(?m.functions[f_stride], instruction.OP_ALLOCA) != 1) { code = 1; }
    if (ut_count(?m.functions[f_nested], instruction.OP_ALLOCA) != 3) { code = 1; }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:preserves_a_secret_field" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    var rec: ir_type.IrTypeId;
    if (ut_rec2(?m, ?rec) != 0) { ir.dnit(?m); ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?b, rb.ok);

    var code: i32 = 0;
    val ra: res[value.Value, fail.Fail] = builder.emit_alloca(?b, rec, value.const_int(1, i64t));
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val s: value.Value = ra.ok;
    val r_1770: err[fail.Fail] = builder.emit_memzero(?b, s, rec);
    if (sel r_1770.err) { code = 1; }

    var secret_v: value.Value = value.param(0, i64t);
    secret_v.secret = true;
    val g1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, s, rec, 1);
    if (sel g1.err) { ir.dnit(?m); ret 1; }
    val r_1776: err[fail.Fail] = builder.emit_store(?b, secret_v, g1.ok);
    if (sel r_1776.err) { code = 1; }

    val h1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, s, rec, 1);
    if (sel h1.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, h1.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    var loaded: value.Value = rl.ok;
    fn.instrs[loaded.data.instr::u32].secret = true;
    loaded.secret = true;
    val r_1785: err[fail.Fail] = builder.emit_ret(?b, loaded);
    if (sel r_1785.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)          { code = 1; }
    or (sel rs.ok) { if (!rs.ok) { code = 1; } }

    var tainted_slots: u32 = 0;
    var i: u32 = 0;
    for (i < fn.instr_len) {
        if (fn.instrs[i].kind == instruction.OP_ALLOCA && fn.instrs[i].secret) { tainted_slots = tainted_slots + 1; }
        i = i + 1;
    }
    # the field the secret was stored to is secret; the untouched public field beside it is not
    if (tainted_slots != 1) { code = 1; }

    val r_1800: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_1800.err) { code = 1; }
    val r_1801: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_1801.err) { code = 1; }
    if (ut_count(fn, instruction.OP_ALLOCA) != 0) { code = 1; }
    if (!ut_ret_value(fn).secret)                 { code = 1; }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:splits_an_aggregate_phi_partition" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    var rec: ir_type.IrTypeId;
    if (ut_rec2(?m, ?rec) != 0) { ir.dnit(?m); ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    var blocks: [4]id.BlockId;
    var n: u32 = 0;
    for (n < 4) {
        val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel rb.err) { ir.dnit(?m); ret 1; }
        blocks[n] = rb.ok;
        n = n + 1;
    }

    var code: i32 = 0;
    var arm: [2]value.Value;

    builder.set_block(?b, blocks[0]);
    val rcmp: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, value.param(0, i64t), value.const_int(0, i64t));
    if (sel rcmp.err) { ir.dnit(?m); ret 1; }
    val r_1851: err[fail.Fail] = builder.emit_cbr(?b, rcmp.ok, blocks[1], blocks[2]);
    if (sel r_1851.err) { code = 1; }

    var a: u32 = 0;
    for (a < 2) {
        builder.set_block(?b, blocks[1 + a]);
        val ra: res[value.Value, fail.Fail] = builder.emit_alloca(?b, rec, value.const_int(1, i64t));
        if (sel ra.err) { ir.dnit(?m); ret 1; }
        arm[a] = ra.ok;
        val r_1859: err[fail.Fail] = builder.emit_memzero(?b, arm[a], rec);
        if (sel r_1859.err) { code = 1; }
        val g0: res[value.Value, fail.Fail] = ut_gep(?b, ?m, arm[a], rec, 0);
        if (sel g0.err) { ir.dnit(?m); ret 1; }
        val r_1862: err[fail.Fail] = builder.emit_store(?b, value.const_int(a::u64, i8t), g0.ok);
        if (sel r_1862.err) { code = 1; }
        val g1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, arm[a], rec, 1);
        if (sel g1.err) { ir.dnit(?m); ret 1; }
        val r_1865: err[fail.Fail] = builder.emit_store(?b, value.const_int(10 + a::u64, i64t), g1.ok);
        if (sel r_1865.err) { code = 1; }
        val r_1866: err[fail.Fail] = builder.emit_br(?b, blocks[3]);
        if (sel r_1866.err) { code = 1; }
        a = a + 1;
    }

    builder.set_block(?b, blocks[3]);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?b, rec);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val phi: value.Value = rphi.ok;
    val r_1874: err[fail.Fail] = builder.phi_add_incoming(?b, phi, blocks[1], value.retype(arm[0], rec));
    if (sel r_1874.err) { code = 1; }
    val r_1875: err[fail.Fail] = builder.phi_add_incoming(?b, phi, blocks[2], value.retype(arm[1], rec));
    if (sel r_1875.err) { code = 1; }
    val hp: res[value.Value, fail.Fail] = ut_gep(?b, ?m, phi, rec, 1);
    if (sel hp.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, hp.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_1880: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_1880.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA)  != 2) { code = 1; }
    if (ut_count(fn, instruction.OP_MEMZERO) != 2) { code = 1; }
    if (ut_count(fn, instruction.OP_PHI)     != 1) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)          { code = 1; }
    or (sel rs.ok) { if (!rs.ok) { code = 1; } }
    val r_1889: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_1889.err) { code = 1; }
    val r_1890: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_1890.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA)  != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_MEMZERO) != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_LOAD)    != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_STORE)   != 0) { code = 1; }
    val rv: value.Value = ut_ret_value(fn);
    if (rv.kind != value.VAL_INSTR) { code = 1; }
    or {
        val d: *instruction.Instruction = ?fn.instrs[rv.data.instr::u32];
        if (d.kind != instruction.OP_PHI) { code = 1; }
        if (d.ty != i64t)                 { code = 1; }
    }

    ir.dnit(?m);
    ret code;
}

fun ut_tagged(m: *ir.Module, a: ir_type.IrTypeId, b: ir_type.IrTypeId, out: *ir_type.IrTypeId) i32 {
    var members: [2]ir_type.IrTypeId;
    members[0] = a;
    members[1] = b;
    val ru: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_union(?m.types, ?members[0], 2, 0, false);
    if (sel ru.err) { ret 1; }

    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ret 1; }
    var fields: [2]ir_type.IrTypeId;
    fields[0] = r8.ok;
    fields[1] = ru.ok;
    val rs: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?fields[0], 2, 0, false);
    if (sel rs.err) { ret 1; }
    @out = rs.ok;
    ret 0;
}

fun ut_member_gep(b: *builder.Builder, m: *ir.Module, base: value.Value, ty: ir_type.IrTypeId, k: u64) res[value.Value, fail.Fail] {
    val gf: res[value.Value, fail.Fail] = ut_gep(b, m, base, ty, 1);
    if (sel gf.err) { ret gf; }
    ret ut_gep(b, m, gf.ok, ut_field_type(m, ty, 1), k);
}

fun ut_open_local(m: *ir.Module, b: *builder.Builder, ty: ir_type.IrTypeId, slot: *value.Value) u32 {
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ret NONE_U32; }

    val rf: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ret NONE_U32; }
    val ix: u32 = rf.ok;

    builder.set_function(b, ?m.functions[ix]);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(b);
    if (sel rb.err) { ret NONE_U32; }
    builder.set_block(b, rb.ok);

    val ra: res[value.Value, fail.Fail] = builder.emit_alloca(b, ty, value.const_int(1, r64.ok));
    if (sel ra.err) { ret NONE_U32; }
    @slot = ra.ok;
    val r_1948: err[fail.Fail] = builder.emit_memzero(b, @slot, ty);
    if (sel r_1948.err) { ret NONE_U32; }
    ret ix;
}

fun ut_def(fn: *ir.Function, v: value.Value) *instruction.Instruction {
    if (v.kind != value.VAL_INSTR)     { ret nil; }
    if (v.data.instr >= fn.instr_len)  { ret nil; }
    ret ?fn.instrs[v.data.instr::u32];
}

test "mach.lang.me.transform.sroa.run:splits_a_tagged_union_payload_into_registers" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    var rec: ir_type.IrTypeId;
    if (ut_tagged(?m, i64t, ptrt, ?rec) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);
    var slot: value.Value;
    val ix: u32 = ut_open_local(?m, ?b, rec, ?slot);
    if (ix == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[ix];

    val gt: res[value.Value, fail.Fail] = ut_gep(?b, ?m, slot, rec, 0);
    if (sel gt.err) { ir.dnit(?m); ret 1; }
    val r_1992: err[fail.Fail] = builder.emit_store(?b, value.const_int(1, i8t), gt.ok);
    if (sel r_1992.err) { code = 1; }

    val gp: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel gp.err) { ir.dnit(?m); ret 1; }
    val r_1996: err[fail.Fail] = builder.emit_store(?b, value.param(0, i64t), gp.ok);
    if (sel r_1996.err) { code = 1; }

    val hp: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel hp.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, hp.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2002: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2002.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA) != 1) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)              { code = 1; }
    or (sel rs.ok) { if (!rs.ok)     { code = 1; } }
    val r_2009: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_2009.err) { code = 1; }
    val r_2010: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_2010.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA)  != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_MEMZERO) != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_LOAD)    != 0) { code = 1; }
    if (ut_count(fn, instruction.OP_STORE)   != 0) { code = 1; }
    val rv: value.Value = ut_ret_value(fn);
    if (rv.kind != value.VAL_PARAM) { code = 1; }
    if (rv.data.param_ix != 0)      { code = 1; }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:reinterprets_a_member_of_another_type" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;

    var rec: ir_type.IrTypeId;
    if (ut_tagged(?m, i64t, ptrt, ?rec) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);
    var slot: value.Value;
    val ix: u32 = ut_open_local(?m, ?b, rec, ?slot);
    if (ix == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[ix];

    val gp: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 1);
    if (sel gp.err) { ir.dnit(?m); ret 1; }
    val r_2055: err[fail.Fail] = builder.emit_store(?b, value.param(0, ptrt), gp.ok);
    if (sel r_2055.err) { code = 1; }

    val hp: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel hp.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, hp.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2061: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2061.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)              { code = 1; }
    val r_2065: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_2065.err) { code = 1; }
    val r_2066: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_2066.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA) != 0) { code = 1; }
    val cast: *instruction.Instruction = ut_def(fn, ut_ret_value(fn));
    if (cast == nil) { code = 1; }
    or {
        if (cast.kind != instruction.OP_BITCAST)        { code = 1; }
        if (cast.ty != i64t)                            { code = 1; }
        if (cast.operand_count != 1)                    { code = 1; }
        or {
            if (cast.operands[0].kind != value.VAL_PARAM) { code = 1; }
            if (cast.operands[0].data.param_ix != 0)      { code = 1; }
        }
    }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:a_narrow_member_preserves_its_cell" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    var rec: ir_type.IrTypeId;
    if (ut_tagged(?m, i64t, i8t, ?rec) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);
    var slot: value.Value;
    val ix: u32 = ut_open_local(?m, ?b, rec, ?slot);
    if (ix == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[ix];

    val gw: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel gw.err) { ir.dnit(?m); ret 1; }
    val r_2116: err[fail.Fail] = builder.emit_store(?b, value.param(0, i64t), gw.ok);
    if (sel r_2116.err) { code = 1; }

    val gn: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 1);
    if (sel gn.err) { ir.dnit(?m); ret 1; }
    val r_2120: err[fail.Fail] = builder.emit_store(?b, value.param(1, i8t), gn.ok);
    if (sel r_2120.err) { code = 1; }

    val hw: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel hw.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, hw.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2126: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2126.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)              { code = 1; }
    val r_2130: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_2130.err) { code = 1; }
    val r_2131: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_2131.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA) != 0) { code = 1; }

    val merge: *instruction.Instruction = ut_def(fn, ut_ret_value(fn));
    if (merge == nil) { code = 1; ir.dnit(?m); ret code; }
    if (merge.kind != instruction.OP_OR || merge.operand_count != 2) { code = 1; ir.dnit(?m); ret code; }

    val keep: *instruction.Instruction = ut_def(fn, merge.operands[0]);
    if (keep == nil) { code = 1; }
    or {
        if (keep.kind != instruction.OP_AND || keep.operand_count != 2)      { code = 1; }
        or {
            if (keep.operands[0].kind != value.VAL_PARAM)                    { code = 1; }
            if (keep.operands[0].data.param_ix != 0)                         { code = 1; }
            if (keep.operands[1].kind != value.VAL_CONST_INT)                { code = 1; }
            or { if (keep.operands[1].data.int_lit != 0xFFFFFFFFFFFFFF00)    { code = 1; } }
        }
    }

    val wide: *instruction.Instruction = ut_def(fn, merge.operands[1]);
    if (wide == nil) { code = 1; }
    or {
        if (wide.kind != instruction.OP_ZEXT || wide.ty != i64t)  { code = 1; }
        or {
            if (wide.operands[0].kind != value.VAL_PARAM)         { code = 1; }
            if (wide.operands[0].data.param_ix != 1)              { code = 1; }
        }
    }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:declines_a_narrow_access_to_a_pointer_cell" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    var rec: ir_type.IrTypeId;
    if (ut_tagged(?m, ptrt, ptrt, ?rec) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);
    var slot: value.Value;
    val ix: u32 = ut_open_local(?m, ?b, rec, ?slot);
    if (ix == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[ix];

    val gp: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel gp.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, gp.ok, i8t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2198: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2198.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)         { code = 1; }
    or (sel rs.ok) { if (rs.ok) { code = 1; } }
    if (ut_count(fn, instruction.OP_ALLOCA) != 1) { code = 1; }

    ir.dnit(?m);
    ret code;
}

fun ut_tagged_probe(m: *ir.Module, a: ir_type.IrTypeId, b: ir_type.IrTypeId, member: u64, at: ir_type.IrTypeId) u32 {
    var rec: ir_type.IrTypeId;
    if (ut_tagged(m, a, b, ?rec) != 0) { ret NONE_U32; }

    var bl: builder.Builder = builder.init(m);
    var slot: value.Value;
    val ix: u32 = ut_open_local(m, ?bl, rec, ?slot);
    if (ix == NONE_U32) { ret NONE_U32; }

    val g: res[value.Value, fail.Fail] = ut_member_gep(?bl, m, slot, rec, member);
    if (sel g.err) { ret NONE_U32; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?bl, g.ok, at);
    if (sel rl.err) { ret NONE_U32; }
    val r_2222: err[fail.Fail] = builder.emit_ret(?bl, rl.ok);
    if (sel r_2222.err) { ret NONE_U32; }
    ret ix;
}

test "mach.lang.me.transform.sroa.run:declines_four_shapes_no_cell_can_hold" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val r32: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 32);
    if (sel r32.err) { ir.dnit(?m); ret 1; }
    val i32t: ir_type.IrTypeId = r32.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    var pair_fields: [2]ir_type.IrTypeId;
    pair_fields[0] = i32t;
    pair_fields[1] = i32t;
    val rpair: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?pair_fields[0], 2, 0, false);
    if (sel rpair.err) { ir.dnit(?m); ret 1; }
    val pair: ir_type.IrTypeId = rpair.ok;

    val f_wide: u32 = ut_tagged_probe(?m, i8t, i8t, 0, i64t);
    if (f_wide == NONE_U32) { ir.dnit(?m); ret 1; }
    val f_read: u32 = ut_tagged_probe(?m, i64t, i64t, 0, pair);
    if (f_read == NONE_U32) { ir.dnit(?m); ret 1; }
    val f_ord: u32 = ut_tagged_probe(?m, i64t, i64t, 2, i64t);
    if (f_ord == NONE_U32) { ir.dnit(?m); ret 1; }
    val f_agg: u32 = ut_tagged_probe(?m, pair, i64t, 1, i64t);
    if (f_agg == NONE_U32) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)         { code = 1; }
    or (sel rs.ok) { if (rs.ok) { code = 1; } }

    if (ut_count(?m.functions[f_wide], instruction.OP_ALLOCA) != 1) { code = 1; }
    if (ut_count(?m.functions[f_read], instruction.OP_ALLOCA) != 1) { code = 1; }
    if (ut_count(?m.functions[f_ord],  instruction.OP_ALLOCA) != 1) { code = 1; }
    if (ut_count(?m.functions[f_agg],  instruction.OP_ALLOCA) != 1) { code = 1; }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:reads_a_narrow_member_by_truncation" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    var rec: ir_type.IrTypeId;
    if (ut_tagged(?m, i8t, ptrt, ?rec) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);
    var slot: value.Value;
    val ix: u32 = ut_open_local(?m, ?b, rec, ?slot);
    if (ix == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[ix];

    val gn: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel gn.err) { ir.dnit(?m); ret 1; }
    val r_2309: err[fail.Fail] = builder.emit_store(?b, value.param(0, i8t), gn.ok);
    if (sel r_2309.err) { code = 1; }

    val hn: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot, rec, 0);
    if (sel hn.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, hn.ok, i8t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2315: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2315.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)              { code = 1; }
    val r_2319: res[bool, fail.Fail] = mem2reg.run(?m);
    if (sel r_2319.err) { code = 1; }
    val r_2320: res[bool, fail.Fail] = dce.run(?m);
    if (sel r_2320.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA) != 0) { code = 1; }
    val narrow: *instruction.Instruction = ut_def(fn, ut_ret_value(fn));
    if (narrow == nil) { code = 1; }
    or {
        if (narrow.kind != instruction.OP_TRUNC) { code = 1; }
        if (narrow.ty != i8t)                    { code = 1; }
    }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:declines_a_gep_walking_past_a_union_field" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;

    var rec: ir_type.IrTypeId;
    if (ut_tagged(?m, i64t, ptrt, ?rec) != 0) { ir.dnit(?m); ret 1; }

    var code: i32 = 0;
    var b: builder.Builder = builder.init(?m);

    var slot: value.Value;
    val ix_one: u32 = ut_open_local(?m, ?b, rec, ?slot);
    if (ix_one == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn_one: *ir.Function = ?m.functions[ix_one];

    var idx: [3]value.Value;
    idx[0] = value.const_int(0, i64t);
    idx[1] = value.const_int(1, i64t);
    idx[2] = value.const_int(0, i64t);
    val gd: res[value.Value, fail.Fail] = builder.emit_gep(?b, slot, rec, ?idx[0], 3);
    if (sel gd.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, gd.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2372: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2372.err) { code = 1; }

    var slot2: value.Value;
    val ix_two: u32 = ut_open_local(?m, ?b, rec, ?slot2);
    if (ix_two == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn_two: *ir.Function = ?m.functions[ix_two];

    val gm: res[value.Value, fail.Fail] = ut_member_gep(?b, ?m, slot2, rec, 0);
    if (sel gm.err) { ir.dnit(?m); ret 1; }
    val gp: res[value.Value, fail.Fail] = ut_gep(?b, ?m, gm.ok, i64t, 0);
    if (sel gp.err) { ir.dnit(?m); ret 1; }
    val rl2: res[value.Value, fail.Fail] = builder.emit_load(?b, gp.ok, i64t);
    if (sel rl2.err) { ir.dnit(?m); ret 1; }
    val r_2385: err[fail.Fail] = builder.emit_ret(?b, rl2.ok);
    if (sel r_2385.err) { code = 1; }

    var struct_fields: [2]ir_type.IrTypeId;
    struct_fields[0] = i64t;
    struct_fields[1] = i64t;
    val rother: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_struct(?m.types, ?struct_fields[0], 2, 0, false);
    if (sel rother.err) { ir.dnit(?m); ret 1; }
    val other: ir_type.IrTypeId = rother.ok;

    var slot3: value.Value;
    val ix_three: u32 = ut_open_local(?m, ?b, rec, ?slot3);
    if (ix_three == NONE_U32) { ir.dnit(?m); ret 1; }
    val fn_three: *ir.Function = ?m.functions[ix_three];

    val gf: res[value.Value, fail.Fail] = ut_gep(?b, ?m, slot3, rec, 1);
    if (sel gf.err) { ir.dnit(?m); ret 1; }
    val go: res[value.Value, fail.Fail] = ut_gep(?b, ?m, gf.ok, other, 1);
    if (sel go.err) { ir.dnit(?m); ret 1; }
    val rl3: res[value.Value, fail.Fail] = builder.emit_load(?b, go.ok, i64t);
    if (sel rl3.err) { ir.dnit(?m); ret 1; }
    val r_2405: err[fail.Fail] = builder.emit_ret(?b, rl3.ok);
    if (sel r_2405.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)         { code = 1; }
    or (sel rs.ok) { if (rs.ok) { code = 1; } }
    if (ut_count(fn_one, instruction.OP_ALLOCA)   != 1) { code = 1; }
    if (ut_count(fn_two, instruction.OP_ALLOCA)   != 1) { code = 1; }
    if (ut_count(fn_three, instruction.OP_ALLOCA) != 1) { code = 1; }

    ir.dnit(?m);
    ret code;
}

