test "mach.lang.me.transform.sroa.run:declines_when_the_address_escapes" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    var rec: ir_type.IrTypeId;
    if (ut_rec2(?m, ?rec) != 0) { ir.dnit(?m); ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val rv: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_void(?m.types);
    if (sel rv.err) { ir.dnit(?m); ret 1; }
    val voidt: ir_type.IrTypeId = rv.ok;
    val rp: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_ptr(?m.types);
    if (sel rp.err) { ir.dnit(?m); ret 1; }
    val ptrt: ir_type.IrTypeId = rp.ok;

    val rc: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, ir.FN_FLAG_EXTERN);
    if (sel rc.err) { ir.dnit(?m); ret 1; }
    val callee_ix: u32 = rc.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ir.dnit(?m); ret 1; }
    builder.set_block(?b, rb.ok);

    var code: i32 = 0;
    val ra: res[value.Value, fail.Fail] = builder.emit_alloca(?b, rec, value.const_int(1, i64t));
    if (sel ra.err) { ir.dnit(?m); ret 1; }
    val s: value.Value = ra.ok;
    val r_2510: err[fail.Fail] = builder.emit_memzero(?b, s, rec);
    if (sel r_2510.err) { code = 1; }

    val g1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, s, rec, 1);
    if (sel g1.err) { ir.dnit(?m); ret 1; }
    val r_2514: err[fail.Fail] = builder.emit_store(?b, value.param(0, i64t), g1.ok);
    if (sel r_2514.err) { code = 1; }

    var args: [1]value.Value;
    args[0] = s;
    val r_2518: res[value.Value, fail.Fail] = builder.emit_call(?b, value.fn(callee_ix, ptrt), ?args[0], 1, voidt);
    if (sel r_2518.err) { code = 1; }

    val h1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, s, rec, 1);
    if (sel h1.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, h1.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2524: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2524.err) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err)          { code = 1; }
    or (sel rs.ok) { if (rs.ok)  { code = 1; } }

    if (ut_count(fn, instruction.OP_ALLOCA)  != 1) { code = 1; }
    if (ut_count(fn, instruction.OP_MEMZERO) != 1) { code = 1; }
    if (ut_count(fn, instruction.OP_LOAD)    != 1) { code = 1; }
    if (ut_count(fn, instruction.OP_STORE)   != 1) { code = 1; }

    ir.dnit(?m);
    ret code;
}

test "mach.lang.me.transform.sroa.run:declines_a_phi_whose_merge_writes_a_member" {
    var alloc: A.Allocator;
    page.make(?alloc);
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 1; }

    val rm: res[ir.Module, fail.Fail] = ir.init(?alloc, intern.STR_NIL);
    if (sel rm.err) { ret 1; }
    var m: ir.Module = rm.ok;

    var rec: ir_type.IrTypeId;
    if (ut_rec2(?m, ?rec) != 0) { ir.dnit(?m); ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ir.dnit(?m); ret 1; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ir.dnit(?m); ret 1; }
    val i8t: ir_type.IrTypeId = r8.ok;

    val rf: res[u32, fail.Fail] = ir.function_add(?m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ir.dnit(?m); ret 1; }
    val fn: *ir.Function = ?m.functions[rf.ok];

    var b: builder.Builder = builder.init(?m);
    builder.set_function(?b, fn);
    var blocks: [4]id.BlockId;
    var n: u32 = 0;
    for (n < 4) {
        val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
        if (sel rb.err) { ir.dnit(?m); ret 1; }
        blocks[n] = rb.ok;
        n = n + 1;
    }

    var code: i32 = 0;
    var arm: [2]value.Value;

    builder.set_block(?b, blocks[0]);
    val rcmp: res[value.Value, fail.Fail] = builder.emit_cmp_eq(?b, value.param(0, i64t), value.const_int(0, i64t));
    if (sel rcmp.err) { ir.dnit(?m); ret 1; }
    val r_2581: err[fail.Fail] = builder.emit_cbr(?b, rcmp.ok, blocks[1], blocks[2]);
    if (sel r_2581.err) { code = 1; }

    var a: u32 = 0;
    for (a < 2) {
        builder.set_block(?b, blocks[1 + a]);
        val ra: res[value.Value, fail.Fail] = builder.emit_alloca(?b, rec, value.const_int(1, i64t));
        if (sel ra.err) { ir.dnit(?m); ret 1; }
        arm[a] = ra.ok;
        val r_2589: err[fail.Fail] = builder.emit_memzero(?b, arm[a], rec);
        if (sel r_2589.err) { code = 1; }
        val g0: res[value.Value, fail.Fail] = ut_gep(?b, ?m, arm[a], rec, 0);
        if (sel g0.err) { ir.dnit(?m); ret 1; }
        val r_2592: err[fail.Fail] = builder.emit_store(?b, value.const_int(a::u64, i8t), g0.ok);
        if (sel r_2592.err) { code = 1; }
        val g1: res[value.Value, fail.Fail] = ut_gep(?b, ?m, arm[a], rec, 1);
        if (sel g1.err) { ir.dnit(?m); ret 1; }
        val r_2595: err[fail.Fail] = builder.emit_store(?b, value.const_int(10 + a::u64, i64t), g1.ok);
        if (sel r_2595.err) { code = 1; }
        val r_2596: err[fail.Fail] = builder.emit_br(?b, blocks[3]);
        if (sel r_2596.err) { code = 1; }
        a = a + 1;
    }

    builder.set_block(?b, blocks[3]);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?b, rec);
    if (sel rphi.err) { ir.dnit(?m); ret 1; }
    val phi: value.Value = rphi.ok;
    val r_2604: err[fail.Fail] = builder.phi_add_incoming(?b, phi, blocks[1], value.retype(arm[0], rec));
    if (sel r_2604.err) { code = 1; }
    val r_2605: err[fail.Fail] = builder.phi_add_incoming(?b, phi, blocks[2], value.retype(arm[1], rec));
    if (sel r_2605.err) { code = 1; }

    val gw: res[value.Value, fail.Fail] = ut_gep(?b, ?m, arm[0], rec, 1);
    if (sel gw.err) { ir.dnit(?m); ret 1; }
    val r_2609: err[fail.Fail] = builder.emit_store(?b, value.const_int(77, i64t), gw.ok);
    if (sel r_2609.err) { code = 1; }

    val hp: res[value.Value, fail.Fail] = ut_gep(?b, ?m, phi, rec, 1);
    if (sel hp.err) { ir.dnit(?m); ret 1; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, hp.ok, i64t);
    if (sel rl.err) { ir.dnit(?m); ret 1; }
    val r_2615: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_2615.err) { code = 1; }

    if (ut_count(fn, instruction.OP_ALLOCA)  != 2) { code = 1; }
    if (ut_count(fn, instruction.OP_MEMZERO) != 2) { code = 1; }

    val rs: res[bool, fail.Fail] = run(?m, ?tgt);
    if (sel rs.err) { code = 1; }

    if (ut_count(fn, instruction.OP_MEMZERO) != 2) { code = 1; }
    if (ut_count(fn, instruction.OP_ALLOCA)  != 2) { code = 1; }

    ir.dnit(?m);
    ret code;
}

# the fail-at-N fixture: a local two-field record, zeroed, both fields
# stored, one loaded back, which splits into registers
fun probe_build(a: *me_testing.Attempt, m: *ir.Module) i32 {
    var rec: ir_type.IrTypeId;
    if (ut_rec2(m, ?rec) != 0) { ret 1; }
    val r64: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 64);
    if (sel r64.err) { ret 2; }
    val i64t: ir_type.IrTypeId = r64.ok;
    val r8: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?m.types, 8);
    if (sel r8.err) { ret 3; }
    val i8t: ir_type.IrTypeId = r8.ok;
    val rf: res[u32, fail.Fail] = ir.function_add(m, intern.STR_NIL, ir_type.IRT_NIL, 0);
    if (sel rf.err) { ret 4; }
    var b: builder.Builder = builder.init(m);
    builder.set_function(?b, ?m.functions[rf.ok]);
    val rb: res[id.BlockId, fail.Fail] = builder.new_block(?b);
    if (sel rb.err) { ret 5; }
    builder.set_block(?b, rb.ok);
    val ra: res[value.Value, fail.Fail] = builder.emit_alloca(?b, rec, value.const_int(1, i64t));
    if (sel ra.err) { ret 6; }
    val s: value.Value = ra.ok;
    val r_zero: err[fail.Fail] = builder.emit_memzero(?b, s, rec);
    if (sel r_zero.err) { ret 7; }
    val g0: res[value.Value, fail.Fail] = ut_gep(?b, m, s, rec, 0);
    if (sel g0.err) { ret 8; }
    val r_s0: err[fail.Fail] = builder.emit_store(?b, value.const_int(1, i8t), g0.ok);
    if (sel r_s0.err) { ret 9; }
    val g1: res[value.Value, fail.Fail] = ut_gep(?b, m, s, rec, 1);
    if (sel g1.err) { ret 10; }
    val r_s1: err[fail.Fail] = builder.emit_store(?b, value.param(0, i64t), g1.ok);
    if (sel r_s1.err) { ret 11; }
    val h1: res[value.Value, fail.Fail] = ut_gep(?b, m, s, rec, 1);
    if (sel h1.err) { ret 12; }
    val rl: res[value.Value, fail.Fail] = builder.emit_load(?b, h1.ok, i64t);
    if (sel rl.err) { ret 13; }
    val r_ret: err[fail.Fail] = builder.emit_ret(?b, rl.ok);
    if (sel r_ret.err) { ret 14; }
    ret 0;
}

fun probe_transform(a: *me_testing.Attempt, m: *ir.Module, workspace: *scratch.Workspace) err[fail.Fail] {
    val r: res[bool, fail.Fail] = run_in(m, a.target, workspace);
    if (sel r.err) { ret err[fail.Fail].err{r.err}; }
    ret err[fail.Fail].ok{};
}

# the analysis (instruction maps, candidate tables, block queue, slots) is
# scratch and precedes the rewrite; the rewrite emits the field slots and the
# per-block replacement instructions from the module before the rewrite table
# is applied and the originals erased, so a refusal there leaves the original
# accesses in place with unused field slots and replacements beside them;
# rounds before the refusing round are applied whole. either way the module
# is well formed
fun probe_contract(a: *me_testing.Attempt, m: *ir.Module, ordinal: usize) bool {
    if (equal.content_equal(m, a.control)) { ret true; }
    ret me_testing.verifies(m, true);
}

test "mach.lang.me.transform.sroa.run_in:refusal_at_every_ordinal_leaves_the_input_or_a_well_formed_partial_split" {
    var owner: A.Allocator;
    val made: err[A.Error] = page.make(?owner);
    if (sel made.err) { ret 1; }
    var reg: target.TargetRegistry;
    fin { target.registry_dnit(?reg); }
    var tgt: resolved.Target;
    if (ut_target(?reg, ?tgt) != 0) { ret 2; }
    var a: me_testing.Attempt = me_testing.Attempt{build: probe_build, transform: probe_transform,
        contract: probe_contract, target: ?tgt, control: nil, context: nil};
    var control: ir.Module;
    if (me_testing.control(?a, ?owner, ?control) != 0) { ret 3; }
    fin { ir.dnit(?control); }
    ret me_testing.walk(?a);
}
