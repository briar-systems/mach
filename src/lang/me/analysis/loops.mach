    val r_1495: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1495.err) { ret 1; }
    builder.set_block(?f.bld, exit);
    val r_1497: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_1497.err) { ret 1; }
    val r_1498: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, entry, zero);
    if (sel r_1498.err) { ret 1; }
    val r_1499: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, body, upd);
    if (sel r_1499.err) { ret 1; }

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;
    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (lp.is_counted) { code = 1; }
    }
    dnit(?la);
    ret code;
}

test analyze__a_shared_exit_is_nil {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret 1; }
    fin { builder.function_dnit(?f); }
    val i64t: ir_type.IrTypeId = f.i64t;
    val fn:   *me_ir.Function  = f.fn;

    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret 1; }
    val entry: ir_id.BlockId                 = re.ok;
    val rp:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rp.err) { ret 1; }
    val pre: ir_id.BlockId                 = rp.ok;
    val rh:  res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rh.err) { ret 1; }
    val header: ir_id.BlockId                 = rh.ok;
    val rla:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rla.err) { ret 1; }
    val latch: ir_id.BlockId                 = rla.ok;
    val rj:    res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rj.err) { ret 1; }
    val join: ir_id.BlockId = rj.ok;

    val n:    value.Value = value.param(0, i64t);
    val zero: value.Value = value.const_int(0, i64t);
    val one:  value.Value = value.const_int(1, i64t);

    builder.set_block(?f.bld, entry);
    val rcg: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, zero, n);
    if (sel rcg.err) { ret 1; }
    val r_1617: err[fail.Fail] = builder.emit_cbr(?f.bld, rcg.ok, pre, join);
    if (sel r_1617.err) { ret 1; }
    builder.set_block(?f.bld, pre);
    val r_1619: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1619.err) { ret 1; }
    builder.set_block(?f.bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, i64t);
    if (sel rphi.err) { ret 1; }
    val phi: value.Value                 = rphi.ok;
    val rc1: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, phi, n);
    if (sel rc1.err) { ret 1; }
    val r_1626: err[fail.Fail] = builder.emit_cbr(?f.bld, rc1.ok, latch, join);
    if (sel r_1626.err) { ret 1; }
    builder.set_block(?f.bld, latch);
    val rupd: res[value.Value, fail.Fail] = builder.emit_add(?f.bld, phi, one);
    if (sel rupd.err) { ret 1; }
    val upd:    value.Value    = rupd.ok;
    val r_1631: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_1631.err) { ret 1; }
    builder.set_block(?f.bld, join);
    val r_1633: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_1633.err) { ret 1; }
    val r_1634: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, pre, zero);
    if (sel r_1634.err) { ret 1; }
    val r_1635: err[fail.Fail] = builder.phi_add_incoming(?f.bld, phi, latch, upd);
    if (sel r_1635.err) { ret 1; }

    var code: i32                          = 0;
    val ra:   res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret 1; }
    var la: LoopAnalysis = ra.ok;
    if (la.loop_len != 1) { code = 1; }
    or {
        val lp: *Loop = ?la.loops[0];
        if (!ir_id.block_is_nil(lp.exit))          { code = 1; }
        if (!ir_id.block_same(lp.preheader, pre))  { code = 1; }
        if (!ir_id.block_same(lp.exiting, header)) { code = 1; }
        if (!lp.is_counted)                        { code = 1; }
    }
    dnit(?la);
    ret code;
}

# a header loop `iv < n` (iv_left) or `n < iv` with a constant step of the
# given width; 1 when counted, 0 when not, negative on a build failure
#[testing]
fun t_step_verdict(bits: u32, step: wide.Wide, iv_left: bool) i32 {
    var f:    builder.Function;
    val made: err[fail.Fail] = builder.function_init(?f);
    if (sel made.err) { ret -1; }
    fin { builder.function_dnit(?f); }
    val rt: res[ir_type.IrTypeId, fail.Fail] = ir_type.intern_int(?f.m.types, bits);
    if (sel rt.err) { ret -1; }
    val ty: ir_type.IrTypeId              = rt.ok;
    val fn: *me_ir.Function               = f.fn;
    val re: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel re.err) { ret -1; }
    val rh: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rh.err) { ret -1; }
    val rbo: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rbo.err) { ret -1; }
    val rx: res[ir_id.BlockId, fail.Fail] = builder.new_block(?f.bld);
    if (sel rx.err) { ret -1; }
    val entry:  ir_id.BlockId = re.ok;
    val header: ir_id.BlockId = rh.ok;
    val body:   ir_id.BlockId = rbo.ok;
    val exit:   ir_id.BlockId = rx.ok;

    val n:    value.Value = value.param(0, ty);
    val zero: value.Value = value.const_int(0, ty);
    val inc:  value.Value = value.const_int_wide(step, ty);

    builder.set_block(?f.bld, entry);
    val r_br: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_br.err) { ret -1; }
    builder.set_block(?f.bld, header);
    val rphi: res[value.Value, fail.Fail] = builder.emit_phi(?f.bld, ty);
    if (sel rphi.err) { ret -1; }
    var rc: res[value.Value, fail.Fail] = builder.emit_cmp_lt_s(?f.bld, rphi.ok, n);
    if (!iv_left)   { rc = builder.emit_cmp_lt_s(?f.bld, n, rphi.ok); }
    if (sel rc.err) { ret -1; }
    val r_cbr: err[fail.Fail] = builder.emit_cbr(?f.bld, rc.ok, body, exit);
    if (sel r_cbr.err) { ret -1; }
    builder.set_block(?f.bld, body);
    val rupd: res[value.Value, fail.Fail] = builder.emit_add(?f.bld, rphi.ok, inc);
    if (sel rupd.err) { ret -1; }
    val r_back: err[fail.Fail] = builder.emit_br(?f.bld, header);
    if (sel r_back.err) { ret -1; }
    builder.set_block(?f.bld, exit);
    val r_ret: err[fail.Fail] = builder.emit_ret_void(?f.bld);
    if (sel r_ret.err) { ret -1; }
    val r_in0: err[fail.Fail] = builder.phi_add_incoming(?f.bld, rphi.ok, entry, zero);
    if (sel r_in0.err) { ret -1; }
    val r_in1: err[fail.Fail] = builder.phi_add_incoming(?f.bld, rphi.ok, body, rupd.ok);
    if (sel r_in1.err) { ret -1; }

    val ra: res[LoopAnalysis, fail.Fail] = analyze(fn, ?f.m.types, ?f.alloc);
    if (sel ra.err) { ret -1; }
    var la: LoopAnalysis = ra.ok;
    fin { dnit(?la); }
    if (la.loop_len != 1)       { ret -2; }
    if (la.loops[0].is_counted) { ret 1; }
    ret 0;
}

# the step's sign is read at the iv's width, so an i32 step of 0xFFFFFFFF is
# the negative one it spells, and an iv wider than the 64-bit trip-count
# arithmetic is never counted
test analyze__step_sign_is_read_at_the_iv_width_and_a_wide_iv_is_not_counted {
    if (t_step_verdict(64, wide.from_u64(1), true) != 1)                                    { ret 1; }
    if (t_step_verdict(64, wide.from_u64(0), true) != 0)                                    { ret 9; }
    if (t_step_verdict(64, wide.from_u64(0xFFFFFFFFFFFFFFFF), false) != 1)                  { ret 2; }
    if (t_step_verdict(64, wide.from_u64(0xFFFFFFFFFFFFFFFF), true) != 0)                   { ret 3; }
    if (t_step_verdict(32, wide.from_u64(0xFFFFFFFF), true) != 0)                           { ret 4; }
    if (t_step_verdict(32, wide.from_u64(0xFFFFFFFF), false) != 1)                          { ret 5; }
    if (t_step_verdict(8, wide.from_u64(0xFF), false) != 1)                                 { ret 6; }
    if (t_step_verdict(128, wide.from_u64(1), true) != 0)                                   { ret 7; }
    if (t_step_verdict(128, wide.make(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF), false) != 0) { ret 8; }
    ret 0;
}
